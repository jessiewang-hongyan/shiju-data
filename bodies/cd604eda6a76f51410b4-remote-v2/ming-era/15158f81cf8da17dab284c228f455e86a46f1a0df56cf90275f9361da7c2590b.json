[{"title":"次丘苏州宫词二首 其二","author":"江源","text":"莫道宫中离恨长，人间无地不炎凉。\n越罗敢忘君前赐，秦鬓新添镜里霜。\n赤凤不来愁汉燕，前鱼将弃泣龙阳。\n千金羞买相如赋，白首长门也不妨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲思十首次代内赠韵 其一","author":"江源","text":"别来谁是置书邮，恨不随君塞上游。\n玉蕊有花羞插鬓，金垒无酒可消忧。\n东风冷节人长瘦，细雨重门燕亦愁。\n底事归期尽虚语，几番临镜误梳头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲思十首次代内赠韵 其二","author":"江源","text":"年年烽燧照边邮，飞挽怜君万里游。\n锦被易寒长熨火，玉书难寄每增忧。\n小姑窥幔时嗔睡，幼女牵衣不解愁。\n颇觉别离心独苦，为谁膏栉此蓬头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲思十首次代内赠韵 其三","author":"江源","text":"计程今日到西邮，不负男儿拥节游。\n上国几时歌杕杜，北堂无地种忘忧。\n麒麟画像君应取，燕子离居妾岂愁。\n却叹南邻征戍妇，望夫山上数回头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲思十首次代内赠韵 其四","author":"江源","text":"昨来音信自边邮，又报车轮赵代游。\n远道风霜须自爱，高堂甘旨未宜忧。\n生僧乌鹊空传喜，长羡鸳鸯不识愁。\n我欲载书答君子，薄情边雁不回头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲思十首次代内赠韵 其五","author":"江源","text":"转眼光阴速置邮，天涯岁晚尚东游。\n妇人敢怠闺中职，夫子须先天下忧。\n织锦谩论新旧恨，封书聊慰别离愁。\n傍人未会侬深意，却道因风寄白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲思十首次代内赠韵 其六","author":"江源","text":"夫婿乘轺走传邮，三年两度白登游。\n独贤不辱君王命，万里无烦贱妾忧。\n薛媛诗中云鬓改，崔徽卷里翠娥愁。\n临行记得丁宁嘱，堂上春风有白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲思十首次代内赠韵 其七","author":"江源","text":"忆从旌节赴边邮，无复花时事剧游。\n紫燕黄鹂撩妾思，栉风沐雨为君忧。\n归鸿浪说能传信，谖草谁云可疗愁。\n闻道旋车新奏捷，午门争献月支头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲思十首次代内赠韵 其八","author":"江源","text":"作客频年赴远邮，又传舟棹五陵游。\n尺书不到成孤闷，小婢强前宽百忧。\n沈水香销炉鸭冷，画眉□远镜鸾愁。\n寒衣欲剪今宽窄，匹锦全封寄垄头。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲思十首次代内赠韵 其九","author":"江源","text":"嫁来曾不识南邮，昨夜分明梦远游。\n椰叶桐花江上路，瘴烟蛮雨眼中忧。\n归期有约郎应至，卜筮无凭妾更愁。\n会合几何离索久，不如双燕傍池头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲思十首次代内赠韵 其十","author":"江源","text":"欲把封书托置邮，恐郎忘却旧同游。\n年年玉枕曾伤别，处处青楼不解忧。\n蝉翼好如君薄倖，鲸波堪比妾深愁。\n相思可奈双鬓雪，更不饶人日上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客中寒食感怀","author":"江源","text":"南北相望万里天，七逢寒食益凄然。\n草心有泪悲游子，麦饭无因洒墓田。\n金部催科无暇日，粤山把菊定何年。\n门前偶遇羊城客，为我传书阿姊边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄桐庐尹何汝玉","author":"江源","text":"别离容易合并难，岂料桐江半夕欢。\n王事朝昏空鞅掌，宦涂荆棘转辛酸。\n潮回七里滩流急，霜落□山石发寒。\n寄语故人莫怀抱，庙堂今日重郎官。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次杨景昌韵二首 其一","author":"江源","text":"一自乡书荐庙堂，十年尽省愧含香。\n风云天上心徒壮，猿鹤山中梦亦长。\n窃禄未辞三鼎富，催科敢惮一官忙。\n我行蓟北君居粤，人事音书隔两乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次杨景昌韵二首 其二","author":"江源","text":"忆昨磨砻共讲堂，至今兰蕙有馀香。\n别多易觉新愁积，纸短难书旧话长。\n五鼓听鸡趍阙拜，终朝流汗在公忙。\n相思千里君知否，十度封缄寄故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次叶浩然韵四首 其一","author":"江源","text":"旅食长安春复秋，忆君高卧在林丘。\n十年尘土燕云外，两屐烟霞越岭头。\n靖节有诗思入社，仲宣无赋倦登楼。\n炎风朔雪遥相隔，消息多烦寄水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次叶浩然韵四首 其二","author":"江源","text":"莫向西风怨不平，征君高义付乡评。\n万年宇宙皆吾舍，一束诗书了此生。\n少室高居非索价，灞陵深隐岂沽名。\n自惭苦被浮名缚，安得山中共此情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次叶浩然韵四首 其三","author":"江源","text":"终日衡门掩薜萝，百年身世此中过。\n科头熟睡三竿日，抱膝长吟五噫歌。\n萧散人间真自得，荣枯身后更谁多。\n先生诗思浓如酒，倡和须寻水部何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次叶浩然韵四首 其四","author":"江源","text":"鹿门深处有柴扃，不是刘郎旧所经。\n一榻清风庭草绿，百年高隐竹书馨。\n英雄不博诗千首，世事何如酒半醒。\n此日低头拜东野，从今人仰少微星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次李商隐无题韵四首 其一","author":"江源","text":"曾向骊山访旧踪，朝元芜没不闻钟。\n请看学道人何在，始信刀圭味不浓。\n玉宇春风回病草，丹台秋月照芙蓉。\n从今悟此长生术，休上蓬莱第一重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次李商隐无题韵四首 其二","author":"江源","text":"太史遗编细读来，纷纷群议动如雷。\n谩讥阳子上书晚，更叹陈汤斩馘回。\n此日降戎真上策，清时鸣凤仗多才。\n坐看今古成何事，袖拂青萍念未灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次李商隐无题韵四首 其三","author":"江源","text":"三十深闺欲嫁难，镜中不为色催残。\n忧悬漆室心如醉，目断苍梧泪未乾。\n有约尽教金步暖，无媒宁忍翠衾寒。\n摽梅风致周南里，抚卷灯前子细看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次李商隐无题韵四首 其四","author":"江源","text":"忆昔江南泛綵舟，太平风月漫夷犹。\n严陵台上留连赋，武穆祠前感慨留。\n北固放歌山月晓，西湖濯足藕花秋。\n如今再拟经行处，只恐风波易白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复次无题四首答李时荣黄门 其一","author":"江源","text":"碧藓骎骎旧履踪，景阳无复更闻钟。\n春辞栏槛花光暗，日射交疏树影浓。\n淇水肯教遗芍药，越江空忆采芙蓉。\n芳心自是多贻阻，不道瑶台隔万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复次无题四首答李时荣黄门 其二","author":"江源","text":"深院无春燕不来，罗帏日晚但蚊雷。\n金城路远书难寄，玉枕寒生梦易回。\n归汉胡笳空写恨，伤秋纨扇独怜才。\n高楼极目相思阔，敢道芳心久已灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复次无题四首答李时荣黄门 其三","author":"江源","text":"暑去寒来会晤难，芙蓉花发石榴残。\n梦回长信金根远，人去龙沙玉箸乾。\n桂子倚云擎露重，女萝延蔓挟霜寒。\n玉颜久谢朱铅饰，只恐傍人作俗看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复次无题四首答李时荣黄门 其四","author":"江源","text":"燕代车轮蜀水舟，英雄无地不夷犹。\n归期又逐新春过，交佩曾于去日留。\n画戟清香公府夜，翠屏红烛内家秋。\n亦知夫婿封侯好，何用伤春柳陌头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬至遣怀次毕宗仁用老杜韵","author":"江源","text":"长恨流光暗里催，又逢小至客边来。\n衰颜纵酒生春色，壮志忧时未死灰。\n日影或遗南苑地，阳和不到北枝梅。\n柴桑老子何萧散，烂醉乾坤几万杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴次毕宗仁韵","author":"江源","text":"平生不解赋悲秋，万古乾坤入醉眸。\n满腹诗书糟粕子，百年身世土馒头。\n青山泉石元无恙，白发功名便合休。\n却忆故园新隐处，绕篱菘菲长春柔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠冯克明判永州先任湖州","author":"江源","text":"甘棠旧种苕溪上，别驾新乘永水涯。\n展骥可能淹半刺，捕蛇今已复千家。\n黄金台下开春宴，青草湖边醉晚霞。\n见说此州好风月，可能分此到京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过娄宪副莲塘书屋留饮赋诗次韵奉答二首 其一","author":"江源","text":"再到莲塘鬓欲丝，风光翻胜十年时。\n鸢飞鱼跃池中景，翠竹青螺画里诗。\n却恨酒杯欺量浅，不嫌山鸟叹归迟。\n尊前且了平生话，分付将军莫漫驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过娄宪副莲塘书屋留饮赋诗次韵奉答二首 其二","author":"江源","text":"促席传杯嚼藕丝，莲塘歌酒会君时。\n罗浮竹屋频年梦，关陕风烟到处诗。\n笋蕨堆盘肴亦美，唱酬刻烛句休迟。\n若为庾岭逢春早，先折梅花付驿驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次左时翊游天竺韵","author":"江源","text":"路盘山径转霏微，湿翠霜红净晚晖。\n万古东南天竺盛，十年尘土赏心违。\n鸳鸯殿后空题句，南北峰头且振衣。\n此景欲吟吟未了，落霞孤鹜又齐飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次张绣衣用和述怀韵五首 其一","author":"江源","text":"几年持斧内台行，风裁何惭白马生。\n避俗辄焚新谏草，调羹何必旧时铛。\n世情似奕成还败，气势如瓶满则倾。\n今日请君高着眼，谁荣谁辱谩教评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次张绣衣用和述怀韵五首 其二","author":"江源","text":"宦辙吴行复楚行，十年尘土谩劳生。\n胸中且敛旧兵甲，席上旋开新鼎铛。\n鼓楫东溟知水阔，振衣西华识天倾。\n生平俯仰都无愧，任你元龙细品评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次张绣衣用和述怀韵五首 其三","author":"江源","text":"舍则藏兮用则行，圣贤事业在书生。\n渡江誓击将军楫，斗勇羞扛力士铛。\n千里云山嗟独往，百年心素向谁倾。\n眼前莫道无人识，千载是非人自评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次张绣衣用和述怀韵五首 其四","author":"江源","text":"浔阳江上送君行，汉室终当召贾生。\n逐客檐头书数卷，阳关声里酒三铛。\n君应恕我疏慵久，我亦怜君气义倾。\n跃马卧龙成底事，不知今古几人评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次张绣衣用和述怀韵五首 其五","author":"江源","text":"昔燕樱桃帝里行，紫微执法慰平生。\n君恩浩荡三江水，世事低昂两足铛。\n去国梦魂仍恋阙，入郴黎庶望扶倾。\n临流珍重无他嘱，往事逢人莫漫评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴三首复次前韵 其一","author":"江源","text":"几回山轿雨中行，重九才过百恨生。\n黄菊有花簪短鬓，白衣无酒覆空铛。\n九州谁拯苍生溺，一木徒支大厦倾。\n见说庙堂夔契在，经纶安用腐儒评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴三首复次前韵 其二","author":"江源","text":"临秋一曲放歌行，笑傲乾坤过此生。\n老去逢人那按剑，狂来杯饮不须铛。\n风云忝逐群龙化，文采曾令一座倾。\n醉后题诗三百首，九京欲起大苏评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴三首复次前韵 其三","author":"江源","text":"待漏长安拂曙行，十年京国记平生。\n联诗东署公霜韵，煮茗西怜借瓦铛。\n身外功名须勇退，笑中刀剑最相倾。\n渊明亦是知几者，纲目书中看品评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次倪韵答丘苏州三首 其一","author":"江源","text":"北风猎猎雨丝丝，东阁相逢话许时。\n宾主且欢尊有绿，江山休叹我无诗。\n松筠旧隐归应早，桃柳新知乐未迟。\n今日葛溪如有约，扁舟东下又同驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次倪韵答丘苏州三首 其二","author":"江源","text":"百粤荒庐生网丝，红尘奔走许多时。\n室无拙妇长藏酒，涂遇先生数赠诗。\n南客怀归心耿耿，北风吹水棹迟迟。\n凭君寄语饶州守，岁暮天涯尚载驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次倪韵答丘苏州三首 其三","author":"江源","text":"财赋东南似蚕丝，民劳又值转输时。\n庙堂累诏曾蠲税，闾巷何人复采诗。\n行路有歌心靡靡，宽民无术意迟迟。\n素餐已负清朝禄，敢望君恩劳载驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客愁","author":"江源","text":"半萦心绪半攒眉，日日穷涂我辈随。\n冻雨打蓬孤独夜，异乡闻雁五更时。\n王侯豪侠君何畏，客邸飘零独见欺。\n试问阿谁能慰我，青州从事是心知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中口号","author":"江源","text":"急雨敲篷泊浅滩，今朝行路始知艰。\n乱流侧畔千堆石，飞鸟前头万点山。\n原北水枯芳草歇，江南冬暖弊裘闲。\n何时脱却朝衫去，散发扁舟任往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复次老杜长至韵","author":"江源","text":"鬓髯添白老将催，客邸仍看小至来。\n君子道长时复泰，黄钟气暖管飞灰。\n树头雪压还留橘，江上春先已报梅。\n邬子泊舟沽市酒，不妨微醉两三杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再到铁柱宫","author":"江源","text":"黄金台上将君命，铁柱宫中驻使幢。\n亭上未瞻□孺子，祠前先拜许旌阳。\n鸣钟聚食黄冠百，绕树将雏白鹤双。\n此地从来最幽僻，洞房三借亦何妨。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴","author":"江源","text":"了得公家刚岁暮，客涂归计尚留连。\n渚云汀树几千里，浅水长洲百丈牵。\n时镊白髭临古镜，忍看新历换流年。\n到门正值王正月，好颂椒花小酌前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游惠山寺次秦方伯韵","author":"江源","text":"见说山公不姓支，可人儒雅亦堪师。\n云霞长护占名刹，猿鹤争迎老住持。\n僧供旋享新竹笋，鹊巢还占旧松枝。\n来游此地询兴废，方伯文章即是碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次同寅陈吉夫雪诗韵四首 其一","author":"江源","text":"纷纷玉花天地明，衾绸便觉栗烈生。\n聚星堂上有佳句，暖寒会中多宿酲。\n幽人乘兴访剡曲，将军侵夜入蔡城。\n台瑞更喜勍敌柏，挺然苍翠何其清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次同寅陈吉夫雪诗韵四首 其二","author":"江源","text":"欺梅妒舞足轻明，何处寻诗兴倍生。\n白屋号寒无宿火，朱门纵酒有馀酲。\n玉龙缭绕黄金阙，银海周遭铁瓮城。\n叹我非才真强和，简斋吟骨逼人清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次同寅陈吉夫雪诗韵四首 其三","author":"江源","text":"天地光摇夺曙明，闭门僵卧叹袁生。\n蓝关逐客愁行马，金帐粗人病宿酲。\n冻合已平三叉路，花飞不到五羊城。\n西湖尚忆孤山趣，并与梅花一样清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次同寅陈吉夫雪诗韵四首 其四","author":"江源","text":"雪花如掌搅空明，陡送寒威半夜生。\n我喜万家占宿麦，谁将五斗解馀酲。\n兔园授简怜司马，驴背裁诗付管城。\n明晓起看风纪地，琼台银树不胜清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李德馨同年","author":"江源","text":"客馆张灯拟论文，我来何事不逢君。\n九江道里愁听雨，五老峰前独看云。\n联句尚怀高阁会，探花曾逐□年群。\n端阳更拟洪都约，白酒红菱角忝新。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次杜进士还朝诗","author":"江源","text":"春日传胪燕礼闱，秋风将命出金闺。\n西江文献归甄录，南国山川属品题。\n五老峰前回綵鹢，双龙阙下听朝鸡。\n临轩若问观风事，圣化于今变鲁齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次前韵送陈进士","author":"江源","text":"弱冠登瀛试粉闱，新裁宫锦籍金闺。\n纂修手笔同燕许，璀璨文章照鲁齐。\n南国观风春驻马，东华待漏晓闻鸡。\n报恩寺里重经处，细认笼纱是旧题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐用美邀赏海棠次冯佩之韵二首 其一","author":"江源","text":"紫绵一树绚明霞，清赏招邀孺子家。\n西蜀移来原有种，东风开后更无花。\n金屏绣幄红光漏，宿晕残妆烛影斜。\n定惠幸遭题品后，纷纷红紫莫争誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐用美邀赏海棠次冯佩之韵二首 其二","author":"江源","text":"坐对名花酌紫霞，不须歌吹起邻家。\n谩怜有谱传丞相，独怪无名到浣花。\n雨湿胭脂娇欲滴，月低台榭影初斜。\n化工幻出天然色，中酒佳人未足誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李宪长入觐一首","author":"江源","text":"几年持宪肃清高，马足飞尘入觐劳。\n供帐举怀歌伐木，邮亭张烛看豪曹。\n东南疲弊新封事，西北风霜旧豸袍。\n遥想玉阶三祝后，太平天子特恩褒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"羊城别意送严鸿胪还朝","author":"江源","text":"华节亭前把酒卮，丈夫忠孝足瑰奇。\n正当南粤宣恩后，又是西江便省时。\n千里浸淫无稼穑，万家村落有啼饥。\n区区离别何须赋，此去烦君为采诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒岳王墓","author":"江源","text":"阃外专征岂不知，精忠心事竟难移。\n担全天地君臣义，不计吾家父子危。\n王冢有碑镌大节，宋陵无主酹芳卮。\n拈香再拜祠前像，尚想中原报捷时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]