[{"title":"寄寿文炳族侄四小诗并谢医药 其二","author":"程敏政","text":"胗脉已能工太素，谭玄尤解守中黄。\n便将花甲从头数，何必龙宫索异方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46985,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄寿文炳族侄四小诗并谢医药 其三","author":"程敏政","text":"林下相随麋鹿群，一春多病思纷纷。\n参苓有药能投我，不废勤耕与售文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46986,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄寿文炳族侄四小诗并谢医药 其四","author":"程敏政","text":"绿槐分影到堂东，人物犹存相国风。\n胜日有期开寿燕，沙溪春酒一尊同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46987,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"八月十九日大病不寐","author":"程敏政","text":"参苓服尽十馀斤，犹是维摩病者身。\n门外生徒劳问卜，膝前儿子解忧亲。\n惯看本草都成诵，永谢新篘却爽神。\n造物眼宽容许物，可于林下不容人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46988,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病后二首 其一","author":"程敏政","text":"布袍寒褪病愔愔，入夜无端蚤虱侵。\n瘦骨元非食肉相，苦来相吮亦何心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46989,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病后二首 其二","author":"程敏政","text":"淡羹粗饭坐仍眠，百疾交攒废砚田。\n造物似教贫未已，迩来并革售文钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46990,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"抱病经岁不作诗辛亥二月一日登齐云岩试笔一首","author":"程敏政","text":"石洞谁穿薜荔封，玄云宫阙远闻钟。\n万松风奏笙簧杂，叠嶂天开锦绣重。\n久住定应凡骨换，偶来忘却病身慵。\n斜阳更骋东南望，正见黄山第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46991,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和李太守宗仁二律 其一","author":"程敏政","text":"宵旰忧勤仰圣躬，柏台花县此丹衷。\n桑村永日催吴茧，棠茇春风听郭公。\n南亩问农溪涨落，后堂延客市尘空。\n休言一日朱幡贵，四度民情达帝聪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46992,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和李太守宗仁二律 其二","author":"程敏政","text":"亭上清风酒力微，亭前雨足菜根肥。\n枳鸾自合归鹓序，花鸟何能识豸衣。\n忽转大州承霈渥，便从幽谷扫寒威。\n相期预斲苍崖石，一代龚黄定可几。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46993,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠宋逸清鍊师","author":"程敏政","text":"坦坦物外士，萧萧林下人。\n乾坤两知己，时共一壶春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46994,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梦吉字咏 其一","author":"程敏政","text":"华衮谁堪一字褒，千年惟仰傅岩高。\n人生出处从天定，学半工夫莫惮劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46995,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梦吉字咏 其二","author":"程敏政","text":"富贵宁论十八公，文章何羡笔花红。\n从来天爵高人爵，看子名香月旦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46996,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四月八日彦夫始生日南山小酌","author":"程敏政","text":"风逼南薰日渐长，祗园嘉会正开祥。\n一尊山馆聊相祝，愿子名登选佛场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46997,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题溪南吴景岑瞻翠卷 其一","author":"程敏政","text":"三十年前晚翠诗，京华无限故园思。\n而今瞻翠开新册，多病何能续旧词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46998,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题溪南吴景岑瞻翠卷 其二","author":"程敏政","text":"故家乔木翠沉沉，占得溪南十亩阴。\n何日涧觞重话旧，听君儿子诵新吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46999,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"六月八日与李推府南山小酌","author":"程敏政","text":"返照斜衔月半弓，一襟清暑爱溪风。\n人行稻垄交加处，山在林塘掩映中。\n游兴渐开知病减，酒材难致笑诗穷。\n蓬门花径淹留地，赖有平生北海公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47000,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南山夜坐时埙子初学诗忽请联句为易数字成诗","author":"程敏政","text":"凉月流辉下石门，清溪分渌过山村。\n槐庭小立嫌蛙闹，草径閒行怯虎蹲。\n病去渐惊诗满眼，兴来初爱酒盈樽。\n西堂一榻思扇枕，不用樵青扫竹根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47001,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"有怀彦夫师鲁","author":"程敏政","text":"新笋已过母，时禽多变声。\n可人期不至，明月下前楹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47002,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"族孙天保德吉名字诗","author":"程敏政","text":"三复戬谷诗，上想镐京燕。\n为德遍群黎，盛治不可见。\n云谁爱兹语，我族称世贤。\n父命期远大，宾字盍勉旃。\n勉旃亦何如，隐显各致用。\n文武思吉甫，孝友企张仲。\n力学返性善，克效孳孳功。\n帝监实伊迩，锡福冥冥中。\n珍重过庭闱，河洛有遗矩。\n慎勿惭斯名，涂人可为禹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47003,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早过车田村","author":"程敏政","text":"沙岸深穿石径幽，橘梢藤刺翠相樛。\n孤村路出荒垣近，十亩阴蟠古木稠。\n樵彴半湾松崦脚，水桩遥响竹棚头。\n息肩少狎群鸥坐，不觉凉生两袂秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47004,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对月独酌","author":"程敏政","text":"病来无酒兴，今夜忽清狂。\n却暑风何快，行空月正凉。\n鸡栖藏树稳，虫响出莎长。\n未觉吟身倦，呼奴更一觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47005,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"绩溪许生永感卷和康亚卿李太守韵二绝 其一","author":"程敏政","text":"旧田新谷屡经秋，密线轻芸迹尚留。\n三尺垄头呜咽水，潺潺流恨几时休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47006,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"绩溪许生永感卷和康亚卿李太守韵二绝 其二","author":"程敏政","text":"日诵遗书立孔墙，蓼莪诗训可曾忘。\n显扬有业君能尽，会见荒坟草亦香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47007,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和许侍御李节推登九华山诗韵二首 其一","author":"程敏政","text":"遥揖山灵感物华，翠微深处欲移家。\n千峰列戟疑无地，一涧浮春忽有花。\n世外丹青开栋宇，空中鸡犬隔烟霞。\n归装尚橐宫衣在，村酿犹堪几度赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47008,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和许侍御李节推登九华山诗韵二首 其二","author":"程敏政","text":"细从云外数奇峰，九朵芙蓉翠万重。\n月上老猿攀石葛，雨晴驯鹿卧沙茸。\n谪仙诗重天池锦，霸相身惭雪涧松。\n玉洞秘函无恙否，他时容启绿苔封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47009,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀凤堂","author":"程敏政","text":"凤山山下凤湖浔，扁揭高堂见古心。\n九奏箫韶音律远，百年梧竹庆源深。\n越公旧烈遗青史，单父閒情亦素琴。\n胜地炳灵应有待，云霄他日看祥禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47010,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"约友人游松萝山","author":"程敏政","text":"松萝山色望中青，云里炊烟鸟外亭。\n胜日与君先订约，涧觞同泛水泠泠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47011,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庭萱教曾侄联句","author":"程敏政","text":"八尺庭除手种萱，一丛开处压名园。\n露含鹄觜蜂才入，风撚龙须蝶更翻。\n傍映蜀葵堪作友，上依慈竹剩添孙。\n编篱汲水频加护，留取年年茁旧根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47012,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"促张令君所许麻油菉豆","author":"程敏政","text":"清油已尽调朱色，菉豆频思却暑汤。\n日日买薪还汲井，令君嘉意可能忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47013,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"于千户母夫人哀挽","author":"程敏政","text":"万石家成老未慵，忽惊霜涧仆高松。\n阃仪可但蘋蘩托，庭训无忘俎豆容。\n梦落海东陪鹤驭，恩从天上得鸾封。\n贤郎抆泪书遗德，留向他年说女宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47014,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"六月十八日忠孝乡保安醮事请予充首","author":"程敏政","text":"一片琅璈度曲新，社中香火会比邻。\n幡幢四绕星坛静，剑佩遥瞻帝座真。\n初向玉清充弟子，会从金马作仙人。\n踰年病起惊仍健，福酒还看酌数巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47015,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立秋前五日南山晚归涉溪作","author":"程敏政","text":"草岸凉风透葛衣，涉溪标浅傍鱼矶。\n霞明远衬青山出，月上时惊白鹭飞。\n村女井边提瓮汲，农人谷口荷锄归。\n山家屈指秋将近，不道炎官不解围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47016,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与黄司训汝彝食菱联句","author":"程敏政","text":"偶然来食泮池菱，要识胸中一味冰。\n头角峥嵘惊老眼，子孙清白爱风棱。\n登盘不受污泥染，出水偏于造化憎。\n诗咏谁能立成调，昔年供奉愧吾曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47017,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和李太守悯雨诗十绝 其一","author":"程敏政","text":"手指庭柯绿未乾，心悬民瘼古来难。\n一时悯雨传新咏，肉食何人耻宴安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47018,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和李太守悯雨诗十绝 其二","author":"程敏政","text":"暂屈渊龙起怒雷，三农忧色未全开。\n休言小雨微沾足，原自贤侯一念来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47019,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和李太守悯雨诗十绝 其三","author":"程敏政","text":"祝告频繁只自尤，精诚何待舞雩求。\n心期挽得银河水，一洗穷檐万斛愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47020,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和李太守悯雨诗十绝 其四","author":"程敏政","text":"斋心露祷倏经旬，一抚焦枯一怆神。\n闻说道中停辔日，屡将甘苦问疲民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47021,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和李太守悯雨诗十绝 其五","author":"程敏政","text":"云上东山雨脚生，耳边长误认溪声。\n谁言逐客浑閒事，一种难忘畎亩情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47022,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和李太守悯雨诗十绝 其六","author":"程敏政","text":"瓣香我欲叩苍天，处处民忧亦可怜。\n古歙未应愁地坼，三吴无计补天穿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47023,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和李太守悯雨诗十绝 其七","author":"程敏政","text":"十诗愁绝寄情深，字字分明道苦心。\n薄税轻徭眼前事，拟将方寸作甘霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47024,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和李太守悯雨诗十绝 其八","author":"程敏政","text":"东阡南陌语叮宁，旱魃何能抵福星。\n枯槁半回仍大慰，秋禾连亩翠亭亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47025,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和李太守悯雨诗十绝 其九","author":"程敏政","text":"吟筒来自雨师坛，十里澄溪路淼漫。\n一为田翁传好语，郡侯清德似刘宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47026,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和李太守悯雨诗十绝 其十","author":"程敏政","text":"眼中珠玉未为多，奈此忧民遣兴何。\n愿得天瓢一倾泻，笔端风雨共霶?。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47027,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"辛亥秋社作","author":"程敏政","text":"一丛茅屋枕潺湲，箫鼓喧阗绿树间。\n田社又叨三度饮，鬓丝新入几茎斑。\n横秋雁阵来何许，破午鸡声出近山。\n解绶正堪同击壤，不妨身载夕阳还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47028,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送徐中行进士","author":"程敏政","text":"抱病经年客过稀，閒阶重叠上苔衣。\n何缘天上青云士，来扣林间白石扉。\n山犬失惊遥吠影，沙鸥才狎便忘机。\n相逢未煖诗坛约，迢递寒江一棹归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47029,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"断石联句","author":"程敏政","text":"瘦石初来断石游，须容吾辈共仙舟。\n诗怀浩荡天留景，酒令循环客算筹。\n绝壁雨馀苍藓合，澄潭风定碧波收。\n眼前无限登临兴，十幅归帆已挂秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47030,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"分得石人峰送徐中行进士","author":"程敏政","text":"几年溪上寄行踪，天与图形水墨浓。\n面冷任教山鸟怪，衣单聊藉石苔封。\n断崖名刻摧秋雨，隔岸村居对夕舂。\n揽胜有人频驻目，恨无佳句抗尘容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47031,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题范良璧赞画说剑馀情卷 其一","author":"程敏政","text":"横槊赋诗骚将喜，赋诗退虏老兵嗔。\n不知阅武场中士，说剑馀情得几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47032,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题范良璧赞画说剑馀情卷 其二","author":"程敏政","text":"阵法休嗤次律房，茂材曾举郭汾阳。\n世间名实真须副，展卷令人忆范郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47033,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜读定山与汪循贡士诗有感二绝 其一","author":"程敏政","text":"晦翁心学在真知，知到真时圣可基。\n数墨寻行却徒尔，天人相去只毫釐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47034,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜读定山与汪循贡士诗有感二绝 其二","author":"程敏政","text":"平生老友定山君，主静工夫久不群。\n正义中仁有分别，可将经传作云云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47035,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九月五日重至万山观观主宗贵兄留宿东明楼上","author":"程敏政","text":"不到琳宫已十年，小楼吟榻尚依然。\n云拖山色横窗下，风送溪声落枕边。\n何处有方堪却老，秋来多病不成眠。\n眼中幸对纯阳子，手拨垆薰讲洞玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47036,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日将游古岩寺道中作方君时勉汪君严夫偕行","author":"程敏政","text":"冷水铺南风叶翻，遥穿一径似桃源。\n满前无暇酬天趣，个里那能著市喧。\n万叠峰峦真入画，数家鸡犬自成村。\n古岩一到心方惬，遮莫山童不奈烦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47037,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留题古岩寺时汪州守时夫汪进士仲和及二方生经纶两次候予不至先归","author":"程敏政","text":"十里虹岩走复驯，阿谁知是卧龙身。\n千年木佛聊同住，五月雷师莫漫嗔。\n圣水井头消醉渴，妙峰亭上振衣尘。\n相期两度隳游劵，却恐山灵笑俗人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47038,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次周太守石上旧韵","author":"程敏政","text":"赏缘三日订，酒禁一朝宽。\n藓蚀铭文瘦，山留菊意寒。\n古泉深注碧，斜日半流丹。\n更踏金鳌背，危亭独凭阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47039,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"瑩姬于书室中酿酒一缸予山行归见大喜以诗求酌不与","author":"程敏政","text":"晓来閒步入山房，似有新醅隔院香。\n稍学秋蛩吟几席，忽惊春漏落糟床。\n急呼东道君难免，笑对西风喜欲狂。\n德曜有言宁为子，一尊方拟寿高堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47040,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"海阳周司训教政遗思卷","author":"程敏政","text":"缅怀三代士，学以济物成。\n惓惓致泽心，岂在口耳精。\n圣涯去已远，随世图功名。\n不有奎聚贤，斯道孰主盟。\n天命凛攸畏，人穷亦堪矜。\n体用收一原，庶无沗所生。\n我从归田来，间入新安城。\n过从得周君，岭海人中英。\n尚友古贤豪，不与流俗争。\n黉宫受规约，一一知躬行。\n文章谢葩藻，材器多恢宏。\n有时奉檄往，署事花封厅。\n一挥举错间，居然得民情。\n刻覈我何有，迂阔劳讥评。\n屈指九寒暑，松桧无渝青。\n孤舟载行李，夹路闻歌声。\n惟时秋雨霁，祖道开江亭。\n屏山翠可飧，练水濯发明。\n一杯属君饮，及此天衢亨。\n达道须壮年，日月无留停。\n丈夫志有在，岂为春花荣。\n蹇予洛党裔，茕茕抱遗经。\n况生紫阳里，半世惭幽贞。\n习魔固有种，放罪容归耕。\n所愿天子圣，众彦登王庭。\n君行倘有合，凤鸟一日鸣。\n治教炳前烈，周道无欹倾。\n吾党重遗思，远大兹发萌。\n睽违意难极，斜阳下林坰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47041,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪篷为大畈汪君赋","author":"程敏政","text":"岁寒晚江一棹横，船窗虚白映沙明。\n坐惊簌簌清人骨，醉爱纷纷打竹声。\n湖上更寻疏暗句，山阴谁识去来情。\n短蓑巨笠吾能办，他日容分冷淡盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47042,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"兖山图寿汪令君","author":"程敏政","text":"兖山当户翠亭亭，解印归来七十龄。\n愿子长为林壑主，一尊同阅卫生经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47043,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄司训欲到荒园赏菊用韵奉期 其一","author":"程敏政","text":"黄花香入绿醅新，也有飘萧漉酒巾。\n只恐向来归计拙，花神能笑把杯人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47044,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄司训欲到荒园赏菊用韵奉期 其二","author":"程敏政","text":"原上秋晴天日开，可人须共菊花杯。\n丹枫翠竹清溪岸，迟子长歌缓辔来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47045,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赏菊得里字","author":"程敏政","text":"落木号空山，幽花照墟里。\n有客踏秋来，对酒胡不喜。\n正色临前轩，寒香扑书几。\n醉眼一摩挲，何如画图里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47046,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赏菊与黄伦司训张旭贡士吴显儒士联句 其一","author":"程敏政","text":"生向东篱耐得秋，乾坤高致此为优。\n芳丛挹露春常在，冷艳欺霜老未休。\n吟对清樽聊一笑，幸逢佳景获重游。\n看花琢句情何极，佳客还须尽日留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47047,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赏菊与黄伦司训张旭贡士吴显儒士联句 其二","author":"程敏政","text":"无限秋光入小园，主人邀客倒清樽。\n高当诗品饶佳色，醉吸河流是雅言。\n风月也知人意好，山林能避世情喧。\n绕丛三嗅成新约，径有青松可共存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47048,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赏菊与黄伦司训张旭贡士吴显儒士联句 其三","author":"程敏政","text":"名园霜后数枝新，觞咏还劳我辈人。\n向晚自怜秋有景，狂吟谁识句惊神。\n杯深绿醑和香饮，枝重金盘带露陈。\n踏月看花能几许，肯容桃李浪争春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47049,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赏菊与黄伦司训张旭贡士吴显儒士联句 其四","author":"程敏政","text":"老圃秋容亦自奇，晚香和露缀幽枝。\n也知天地留生意，故向冰霜挺素姿。\n醉觉南山横眼底，吟瞻北斗出天涯。\n渊明更有来朝约，杖履追陪敢后期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47050,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]