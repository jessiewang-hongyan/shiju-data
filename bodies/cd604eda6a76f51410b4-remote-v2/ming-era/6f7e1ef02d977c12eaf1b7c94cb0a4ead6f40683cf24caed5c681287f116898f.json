[{"title":"玄真院题画二首 其二","author":"张宁","text":"玄都桃树是谁裁，借问春花几度开。\n青鸟有声书欲到，不知王母可重来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7971,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清溪梅月为潘道士题","author":"张宁","text":"一溪流水漾寒沙，万树和风护玉花。\n白鹤近窗人未寝，夜深随月诵南华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7972,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画","author":"张宁","text":"缓棹轻舟入芰荷，若耶风淡水如罗。\n江南旧事休重省，落日犹闻子夜歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7973,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题张仲敷所藏古画册 其一","author":"张宁","text":"临池日日写兰亭，步月吟诗酒未醒。\n老去为嫌文字扰，却寻閒处看黄庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7974,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题张仲敷所藏古画册 其二","author":"张宁","text":"满篷落叶树头风，一雁高飞海色空。\n水净莼香鲈正美，故应张翰忆江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7975,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夷齐图","author":"张宁","text":"弟兄相逊入蛮荆，啮雪茹芝不为名。\n薇叶日蕃山日在，几人曾上首阳行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7976,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"列子陈图南二图 其一","author":"张宁","text":"列子御风风御列，庄周为蝶蝶为周。\n丹青未识荒唐论，貌作凭虚汗漫游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7977,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"列子陈图南二图 其二","author":"张宁","text":"云台观下树离离，一枕清眠梦觉时。\n却笑世间疲卧客，劳昏常自比希夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7978,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄余驿丞","author":"张宁","text":"南薰亭馆晚相延，屈指星霜又十年。\n不是重来浑忘却，黄昏舟过驿门前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7979,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"芙蓉二绝 其一","author":"张宁","text":"谁从花里见双双，一片芳心晚未降。\n隔浦相逢如欲语，不禁风雨满秋江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7980,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"芙蓉二绝 其二","author":"张宁","text":"水绕回塘晚色荒，褰衣人在水中央。\n相思道远空零落，斜倚蒹葭一夜霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7981,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画景","author":"张宁","text":"清明雨歇草萋萋，桑叶初团柳未齐。\n山客过桥门未启，隔墙花落杜鹃啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7982,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"玛瑙寺枯木竹石","author":"张宁","text":"石蹙脩篁碧筱残，风摇落木紫藤乾。\n乱山春尽醉游散，一夜月明僧舍寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7983,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宋徽宗御制瑞鹤赓和诗","author":"张宁","text":"虎啸龙吟发至和，凤仪鹤舞事如何。\n奎章彷佛赓歌意，只比当时美颂多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7984,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂花卉图","author":"张宁","text":"寒葩冷蕊索精神，一夜东风淑气匀。\n惆怅灵均幽谷伴，相随蕃卉竞先春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7985,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和阴佥宪宗孟桃源梦诗四首 其一","author":"张宁","text":"梦看桃源画里春，忽惊身是画中人。\n丹春幻象神仙远，自是清奇梦亦神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7986,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和阴佥宪宗孟桃源梦诗四首 其二","author":"张宁","text":"傅岩曾托画图传，八翼分明梦上天。\n变化升腾先有兆，从来官第号登仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7987,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和阴佥宪宗孟桃源梦诗四首 其三","author":"张宁","text":"上界群仙下土司，颠崖辛苦合通知。\n如今两浙人清逸，不负桃源入梦时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7988,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和阴佥宪宗孟桃源梦诗四首 其四","author":"张宁","text":"百折回流九锁山，桃源应只是人间。\n仙家早有迷津术，何事教人错往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7989,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雎鸠图","author":"张宁","text":"净处偕行密处藏，河洲风寂水生香。\n幽閒意态知何似，记得周南第一章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7990,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"客丝鸲鹆","author":"张宁","text":"逐絮穿花巧弄声，海棠枝嫩蜜蜂轻。\n随风却被游丝绕，飞落春机静不鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7991,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九鸶图","author":"张宁","text":"九鸶不与九思同，托物相规画史功。\n风雪满溪寒素在，也应穷处见从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7992,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"凤仙图","author":"张宁","text":"华月中天一凤过，五铢衣薄夜凉多。\n彩云未断箫声远，回首秦台路几何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7993,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"拜石图","author":"张宁","text":"鸾鹤风仪锦绣肠，眼空尘海欲飞扬。\n如何已在观瞻地，犹作山林旧楚狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7994,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪溪泛舟图","author":"张宁","text":"拂踏冰花上野航，水光沉黑树苍黄。\n平生盛有清寒兴，不是山阴访旧忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7995,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仲昭竹为湛公题","author":"张宁","text":"萧飒秋声满渭川，深沉诗思入湘渊。\n遥知一径通幽日，曾共山僧听雨眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7996,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无锡杨叔屿寿藏八景 其一 永安堂","author":"张宁","text":"马革功名瘴海秋，䲭夷身世水东流。\n千年一枕华胥梦，预买青山办乐丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7997,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无锡杨叔屿寿藏八景 其二 委和堂","author":"张宁","text":"浪说前身与后身，百年天地暂因亲。\n相逢尽是浮生客，莫道堂中是主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7998,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无锡杨叔屿寿藏八景 其三 观物斋","author":"张宁","text":"夕阳西下月东升，叶落空斋草又生。\n寒暑自更人自老，牛山何必动深情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7999,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无锡杨叔屿寿藏八景 其四 知息所","author":"张宁","text":"鸟因飞倦始知还，云本无心也出山。\n何似蚤归常不出，洞深巢隐共閒閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8000,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无锡杨叔屿寿藏八景 其五 晚翠窝","author":"张宁","text":"幽栖松竹晚阴森，过尽红芳与绿阴。\n彷佛邵家安乐地，白头无恙岁寒心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8001,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无锡杨叔屿寿藏八景 其六 白石庵","author":"张宁","text":"南山斮絮已消磨，涧底荆薪奈尔何。\n却爱四围俱白石，玉香深处保天和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8002,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无锡杨叔屿寿藏八景 其七 一沤亭","author":"张宁","text":"秋水亭空晚况微，云随片影落晴晖。\n乾坤逆旅生如寄，怪㡳忘机不复飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8003,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无锡杨叔屿寿藏八景 其八 双桂轩","author":"张宁","text":"小山双桂接玄堂，梧槚秋风共老苍。\n他日燕山访遗植，有人连袂折天香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8004,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东坡图","author":"张宁","text":"玉带金章未足奇，葛巾野服是何时。\n平生怀抱空千古，一笑逢人处处宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8005,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"武克显赠别卷二首 其一","author":"张宁","text":"十载言归人不见，独将书画上长安。\n此情直与江流远，莫说如今行路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8006,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"武克显赠别卷二首 其二","author":"张宁","text":"冠盖临岐费苦吟，太平人物盛时音。\n至今翰墨犹赓和，不尽当时赠别心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8007,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴东升生八十有三以江湖访隐卷索题为书四绝 其一","author":"张宁","text":"年高八十又三旬，犹自乘舟访隐伦。\n只恐太平无事久，江南岩穴少閒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8008,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴东升生八十有三以江湖访隐卷索题为书四绝 其二","author":"张宁","text":"琴剑图书一叶舟，平生梦想子长游。\n严陵祠宇林逋宅，碧水青山一样秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8009,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴东升生八十有三以江湖访隐卷索题为书四绝 其三","author":"张宁","text":"老健聪明似壮年，逢人都说地行仙。\n阴晴冷暖还须省，莫汎山阴雪夜船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8010,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴东升生八十有三以江湖访隐卷索题为书四绝 其四","author":"张宁","text":"弓马停行翰墨香，早来文武盛钱唐。\n会应收拾江湖趣，归卧吴山旧草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8011,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题刘武夜雨读书图","author":"张宁","text":"空斋叶落雨灯孤，除却残经百事无。\n夜半睡魔消不得，起盛檐溜浸菖蒲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8012,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即景","author":"张宁","text":"山下东风小雨催，断桥流水路盘回。\n柳阴拂地春衣湿，人自涌金门外来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8013,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游猎图二首 其一","author":"张宁","text":"金弹横捎玉勒飞，乘閒日日放鹰归。\n将军总爱非时猎，原野如今雉兔稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8014,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游猎图二首 其二","author":"张宁","text":"骏马盘回未著鞭，东门黄犬不须牵。\n贵游子弟春游蚤，不似岐阳大猎年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8015,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪蕉亭","author":"张宁","text":"寒压亭蕉叶半枯，离披残绿伴愁孤。\n凭谁唤起王摩诘，并作袁安卧雪图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8016,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"烟萝山馆","author":"张宁","text":"花霭松薰逗午烟，轻风不散碧萝悬。\n一声归鹤重门静，人在蓬壶小洞天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8017,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"孤竹","author":"张宁","text":"琐窗清晓云鬟重，今谷芳年翠袖垂。\n记得月明湘水上，倚篷无语立多时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8018,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂题七首 其一","author":"张宁","text":"高山流水古音微，弹者无人听亦稀。\n纵是相逢只如许，夕阳空抱锦囊归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8019,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂题七首 其二","author":"张宁","text":"秋水苍茫画鹢轻，横篙不动橹无声。\n济川功大须回首，莫趁长风尽力行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8020,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂题七首 其三","author":"张宁","text":"路入青云梦在山，身忙应不碍心閒。\n宦途自有幽栖处，何必林泉好解颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8021,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂题七首 其四","author":"张宁","text":"绿波芳草雨初晴，十里风光一棹轻。\n就使真从天上坐，也应不似画中清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8022,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂题七首 其五","author":"张宁","text":"雨馀石径净无尘，幽事相寻野兴新。\n世态如棋数更变，何曾重过烂柯人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8023,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂题七首 其六","author":"张宁","text":"北风吹雪满山隈，踏遍溪桥不见开。\n水月黄昏香影寂，不知何处折归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8024,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂题七首 其七","author":"张宁","text":"银海流光濯缟衣，九霄风劲快高飞。\n生来便是神仙侣，浪说千年化令威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8025,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"徐志远四景画 其一","author":"张宁","text":"坐令春水独徘徊，不见红尘拂面来。\n游客自归花自落，何须惆怅问谁栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8026,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"徐志远四景画 其二","author":"张宁","text":"绿阴亭馆晚凉多，红藕花香水不波。\n不是红南漫游客，隔溪犹唱采莲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8027,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"徐志远四景画 其三","author":"张宁","text":"东篱昨夜有微霜，白酒浮香菊又黄。\n老去閒情镇相待，满头何必遇重阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8028,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"徐志远四景画 其四","author":"张宁","text":"月光昏淡水痕微，香影如前旧植稀。\n可是孤山雪初霁，有人吟坐拥深衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8029,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戴文进捕鱼图为刘邦彦题 其一","author":"张宁","text":"深水浮篙浅碍舟，满江风雨不知休。\n如今尽结横流网，那有閒鱼上直钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8030,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戴文进捕鱼图为刘邦彦题 其二","author":"张宁","text":"斜风密雨绿蓑衣，水急船横网伴稀。\n总是得鱼归不得，不如风雨未来归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8031,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题沈履德集古梅花百咏","author":"张宁","text":"折选囊珠聚夜光，开分璞玉取琳琅。\n都将几夜金茎露，鍊作孤山百和香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8032,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖山访阴卷二绝 其一","author":"张宁","text":"大隐居城小隐山，山城未见一人閒。\n不如还访林逋宅，坐待梅开野鹤还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8033,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖山访阴卷二绝 其二","author":"张宁","text":"劳劳僧舍满湖山，葛岭无人托半閒。\n世路相逢只如许，夕阳长见酒船还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8034,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题张光弼陈东之花大经状元友社遗音卷","author":"张宁","text":"楚云吴雨越江津，飘泊西湖十载春。\n谁说林逋巢阁外，梅花落尽更无人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8035,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宋徽宗墨竹为夏宪夫题","author":"张宁","text":"龙香御气满琅玕，犹似金壶汁未乾。\n一片卿云天万里，无人为报日平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8036,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"写芭蕉题赠张仲敷","author":"张宁","text":"翩翩风影度窗纱，曾记相逢萼绿华。\n展尽翠笺无一字，太湖石畔有开花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8037,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为诸中夫题芭蕉图","author":"张宁","text":"翠袖双掀石影孤，绿珠将坠惠风扶。\n东君莫为春花恼，留作袁安卧雪图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8038,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为朱彦明题画","author":"张宁","text":"不是玄都种树人，武陵溪上已迷津。\n少年时节须回首，花落莺啼又暮春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8039,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题沈明德画蕉","author":"张宁","text":"雨山先生懒折腰，清如立石瘦如蕉。\n兴来写尽金壶汁，应是春醪宿未消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8040,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"桃源图","author":"张宁","text":"流水桃花万壑春，迷途偶遇避秦人。\n一宵风雨林峦变，惆怅无人再问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8041,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"墨竹图","author":"张宁","text":"娟娟丛绿绕流泉，万玉低迷日暮天。\n回首川南望川北，鹧鸪声乱雨如烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8042,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"罢钓图","author":"张宁","text":"月落西岩露气清，纶竿斜拂叶舟轻。\n夜深一枕芦花雪，飘尽江风梦不惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8043,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂画三首 其一","author":"张宁","text":"万壑寒阴霁雪天，灞桥驴瘦暂停鞭。\n琼楼玉观望不极，诗在暮樵归路边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8044,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂画三首 其二","author":"张宁","text":"新水桃花涨满池，大鱼吹浪小鱼随。\n丹青尽写濠梁景，不到源泉未起时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8045,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂画三首 其三","author":"张宁","text":"秋入溪山草半黄，白云红叶共苍苍。\n清商一曲无人听，独步荒林看夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8046,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"四景画为朱天锡题 其一","author":"张宁","text":"柳坞桃蹊路欲迷，故山春草自萋萋。\n隔江茆屋无人扣，门掩落花莺乱啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8047,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"四景画为朱天锡题 其二","author":"张宁","text":"山坳亭馆野仙居，南面风来暑气无。\n汲取寒泉入清漱，日长閒讲汉西都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8048,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"四景画为朱天锡题 其三","author":"张宁","text":"信宿渔舟晚未归，水光山色到秋微。\n板桥人影斜阳里，落叶无声有雁飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8049,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]