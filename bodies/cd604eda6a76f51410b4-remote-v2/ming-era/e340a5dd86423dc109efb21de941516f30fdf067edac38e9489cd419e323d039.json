[{"title":"槐野王太史原韵","author":"黄廷用","text":"由来卜筑避天街，此日幽栖意更谐。\n无客蓬蒿从满径，有时鸟雀自驯阶。\n云中歌鼓五侯第，塞上旌旗千里怀。\n闭户著书愁未得，傍人休拟草玄斋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30653,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠节推黄华南之庆远","author":"黄廷用","text":"圣朝两露方优渥，才隽如君得远行。\n杖钺百变清鸟道，停车五岭听猿声。\n前山积雾迟开郡，古木斜阳早闭城。\n从此著书消岁月，不专鞠狱使人平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30654,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"世芳楼为宫保许松皋赋 其一","author":"黄廷用","text":"城南玄圃起仙楼，楼上云齐五凤头。\n华岳平看青欲滴，洛川俯听碧长流。\n瑶花琪树祥风转，宝轴牙签瑞霭浮。\n相国传家还自别，清芬千载挹皇休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30655,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"世芳楼为宫保许松皋赋 其二","author":"黄廷用","text":"嵩丘奕奕枕河阳，银榜璇题翠雾香。\n隆栋即占符宝异，丕基应羡福图长。\n赐书万卷凌牛斗，卜世千年引凤凰。\n况有芝兰盈谢砌，春风花气袭云裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30656,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠西岩徐节推之柳州","author":"黄廷用","text":"昨捧除书下建章，尊前万里别情长。\n龙城山水皆皇土，象郡烟霞近楚疆。\n狱院昼间巢野雀，画堂人静对斜阳。\n也知圣主抡才日，不似宗元滞一乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30657,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠朱范之尹浮梁","author":"黄廷用","text":"词藻才名动玉京，君王珍重使专城。\n桑麻春两看频惬，荆棘秋风梦亦惊。\n帘外黄花增别酒，舟前白雁伴行旌。\n相思秪在西江月，独立瑶台听颂声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30658,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠张龙坪尹归安兼省觐","author":"黄廷用","text":"秋入燕城白雁飞，晓承新命下彤闱。\n弃繻关吏犹能识，题柱仙郎今始归。\n锦里霞觞开寿域，故园芳草答春晖。\n霅川花木遥相待，早向东风动客衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30659,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠鄱阳令沈文岩省觐","author":"黄廷用","text":"仙凫未下舟霄去，海上先传青鸟音。\n五代相看春色早，一堂偏受圣恩深。\n吴门芳草生新思，南国甘棠结素心。\n秪是承家知不忝，尊前聊赠越人吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30660,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠公孺袁节推之任松江","author":"黄廷用","text":"投珠献璧喜相逢，日夕徘徊在汉宫。\n白雁云间千里隔，黄花雪里一尊同。\n深愁西北干戈振，见说东南杼轴空。\n狱院枝头巢鸟雀，行看露冕向春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30661,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"得胜门外迎孝烈皇后灵","author":"黄廷用","text":"步出西郊雨乍晴，行行凝盻总含情。\n夕阳斜拂龙蛇影，层汉空闻鸟雀声。\n羽扇徘徊村树拥，罗帏迤逦野云横。\n即从享殿瞻神御，惟有香烟紫雾生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30662,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠敖兵宪入吴","author":"黄廷用","text":"三吴财赋名天下，海陆升平土物饶。\n过客近传喧鼓角，居人安得事渔樵。\n云深画舫朱旗闪，水绕辕门锦节标。\n尊俎谈兵春日暇，相思明月夜听潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30663,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次答司勋侄元日待朝之作 其一","author":"黄廷用","text":"十年骑马向金扉，灯烛通宵殿宇辉。\n拱极呼嵩齐九有，调元叶律自三微。\n蓬莱共庆联珠履，纶綍谁能缉衮衣。\n我爱仲容如玉树，上林先得早春归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30664,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次答司勋侄元日待朝之作 其二","author":"黄廷用","text":"金爵铜龙辟晓扉，星文物彩倍光辉。\n天回王律开黄道，人立瑶台望紫微。\n喜列汉官同委佩，欢传虞帝欲垂衣。\n春云细绕仙阶暖，谒圣还从宝阁归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30665,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岁暮病中次司勋侄韵 其一","author":"黄廷用","text":"明日长安又是春，花期云会逐年新。\n坐闻车马喧廛陌，喜觉庭阶隔世尘。\n岁杪琴书堪自适，天涯骨肉更谁亲。\n经旬药鼎团寒火，空想维摩问病人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30666,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岁暮病中次司勋侄韵 其二","author":"黄廷用","text":"乾坤旋转向阳春，忽见寒梅放萼新。\n玉宇璚楼腾紫气，很山雁塞净红尘。\n雪中欲访戴安道，剡曲徒思贺季真。\n病起暖风吹短鬓，五陵谁是倦游人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30667,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬至习仪朝天宫用韵 其一","author":"黄廷用","text":"斋心晓坐众星稀，行到桥西宫漏微。\n广宇风高摇佩玉，虚檐雪积晃朝衣。\n一元紫极阳初动，万汇瑶寰春欲归。\n太史共占云物瑞，叩玄童子已忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30668,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬至习仪朝天宫用韵 其二","author":"黄廷用","text":"王局琳宫车马稀，丹炉药鼎俗缘微。\n自朝真祖□金箓，为习官仪见紫衣。\n暖日尚迟欣小至，寒梅欲放坐忘归。\n云深剖竹堪烹茗，半榻谈经觉息机。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30669,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠丘州峰尹永嘉","author":"黄廷用","text":"芳尊相对谈王谢，词藻风流天下闻。\n歇马可能寻故事，看鸿争柰欲离群。\n双旌晓拂楼头月，孤棹秋浮江上云。\n遥想东瓯歌出牧，满城春色动台文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30670,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠友人作邑吴中","author":"黄廷用","text":"偶因王子识卢生，不羡邯郸一梦明。\n池上凤毛翔日色，图南鹏翼展云程。\n芳尊满对黄花瘦，尽航新浮晤水清。\n况有蠲租恩诏下，吴人从此沸歌声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30671,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠水东闵太史年兄督学三晋 其一","author":"黄廷用","text":"昔年闻喜同南省，十载仍联供奉班。\n逸兴寻春花径里，高情对月酒杯间。\n校文近幸青藜共，载笔长从玉署还。\n忽讶早秋成远别，二陵风雨隔仙寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30672,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠水东闵太史年兄督学三晋 其二","author":"黄廷用","text":"新捧天书出未央，遥占宪节度河梁。\n文章自昔推班史，时俗于今说晋阳。\n秋宇暂将金作斧，春风依旧玉为堂。\n及门俱是攀龙客，试看乘云入帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30673,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"衡守蔡白石月夜见过赋此别之","author":"黄廷用","text":"东京词藻爱中郎，乍见论心喜夜长。\n清院风声传玉漏，寒阶月色听琼章。\n明朝少别成千里，经岁相思各一方。\n郡国汀洲兰芷满，春来归雁自衡阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30674,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠太史亢水阳册封","author":"黄廷用","text":"金符玉帙下枫宸，珍重词臣作使臣。\n霄汉偏多桐叶露，江城早见棣华春。\n即从京邑过三晋，直到淮封溯八闽。\n喜及故园芳草细，相思犹有未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30675,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠兵侍苏舜泽总督宣大","author":"黄廷用","text":"秋入边城朔气寒，共看司马一登坛。\n关云乱拥黄沙起，塞雁惊飞白日残。\n行遣伍符营细柳，誓将尺剑斩楼兰。\n知君不为凌烟尽，感激君恩欲报难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30676,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日出郭用张八峰都谏韵","author":"黄廷用","text":"秋日郊墟兴转彺，马蹄随处晚花香。\n断云低映楼台湿，细雨新生枕簟凉。\n路杳八千长作客，年过四十尚为郎。\n相逢且尽杯中物，摇落天涯醉是乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30677,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠徐蒙泉主教慈溪","author":"黄廷用","text":"湖光山色名天下，文彩风流尽俊人。\n共羡高轩从赤汉，遥将飞旆出红尘。\n珠玑万斛谁相识，桃李盈门总是春。\n从此传经虚半榻，江南秋雨梦魂新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30678,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠欧湖李郡伯入觐回济南","author":"黄廷用","text":"圣主握乾符泰运，朝宗海国正同心。\n汉庭职□原分盖，虞室功多独赐金。\n放棹河流乘冻鲜，□城花色正春深。\n若看南雁回天北，有客相□□上林。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30679,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠输粟管挥使","author":"黄廷用","text":"秋风送客每伤神，况复边城警报频。\n漫尔尊□千里别，可堪兵后万家贫。\n挥金未必充边实，投笔应能净虏尘。\n从此请缨行绝域，试看汉阁尽麒麟。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30680,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠仪制林双台督学湖广","author":"黄廷用","text":"仪曹旧是蓬瀛侣，十载班联五凤楼。\n玉露新沾仙掌曙，碧天遥动使星秋。\n月明湖水全侵幌，雁掠芦花半度舟。\n回首奎文光灿烂，夜深偏照帝王州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30681,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠祝九山以户部尚书郎为德府长史 其一","author":"黄廷用","text":"君爱身閒不厌贫，故辞华省作王臣。\n东游川岳邻蓬岛，北望楼台接紫宸。\n欲访碧桃丹桂客，偏多载酒问奇人。\n浮生踪迹元尘鞅，安得冥心一悟真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30682,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠祝九山以户部尚书郎为德府长史 其二","author":"黄廷用","text":"羡尔黄金台上客，悠悠扬旆下兰台。\n曳裾暂远红尘苦，授简偏怜白雪才。\n回首花边新酒伴，同声天上少诗媒。\n那堪秋日遥相送，蓟北云飞两半来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30683,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠王挥使袭职","author":"黄廷用","text":"皇明高帝平疆宇，论列麒麟尔祖同。\n弓剑百年仍旧武，貂珰几代出元戎。\n报恩自许平生是，斩虏谁知当世雄。\n昨夜阴山传羽箭，搴旗策马向秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30684,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠见江苏谏议承恩归养","author":"黄廷用","text":"万里看云捧日馀，陈情三疏紫宸居。\n赐归喜乃秋花晚，上寿欣逢春酒初。\n午梦遥知悬魏阙，晴游时儗奉潘舆。\n王侯钟鼎应难并，况复掖垣多谏书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30685,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日饯友人出郭纪游次韵 其一","author":"黄廷用","text":"天地清秋人易老，今年今日不重回。\n斜阳归客双旌迥，隔岸渔家小艇来。\n入馔即甘鱼鲙细，传觞遥指菊花开。\n临流未许酬佳节，更上龙山百尺台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30686,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日饯友人出郭纪游次韵 其二","author":"黄廷用","text":"黄金台上秋风起，黄金台下菊花黄。\n游人来去欢重九，词客登临向夕阳。\n城郭烟霞相掩映，云空凫雁自翱翔。\n白衣送酒今何在，万古风流一羽觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30687,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日饯友人出郭纪游次韵 其三","author":"黄廷用","text":"贵第侯家能作主，高筵绮席恣淹留。\n五陵见客谁青眼，百岁逢秋自白头。\n醉泛木兰烟渚净，閒登石磴野林幽。\n遥思陶令花三径，不识花前人醉不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30688,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次宗伯张玉溪斋居 其一","author":"黄廷用","text":"清昼閒云一鸟过，东风摇飏数槐柯。\n词林喜动阳春曲，睿藻惊传瑞雪歌。\n璚宇瑶坛连紫极，琅函宝箓按玄科。\n知公心与宸衷合，寒向青黎鬓欲皤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30689,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次宗伯张玉溪斋居 其二","author":"黄廷用","text":"银汉云低仙署净，玉炉香袅道心玄。\n六花晓望清斋日，百谷春祈大有年。\n驾雾青鸾来海外，步虚白鹤舞风前。\n悬知太乙明禋夜，玉漏声残尚未眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30690,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别陈我峰之荆南分署","author":"黄廷用","text":"楼船晓傍银河曲，欲下荆门雨涨时。\n天上紫云连郢树，春馀芳草间江篱。\n西通巫峡饶王赋，南入潇湘重客思。\n自昔才人多水部，衡阳归雁可无诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30691,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿大京兆李慎庵 其一","author":"黄廷用","text":"朝端廿载同供奉，忽漫相逢觉数奇。\n更喜湘东为邵日，正当衡岳降神时。\n酒浮南极银河净，花近重阳王露滋。\n清世共归三鼎望，佳辰殊惬百年期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30692,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿大京兆李慎庵 其二","author":"黄廷用","text":"纡金拖紫宁亲日，五十春光亦少年。\n台彩连朝浮岳麓，奎文旫夜灿星躔。\n尊前上寿多罗绮，曲里长生入管弦。\n家住南山春色蔼，洞门深处即神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30693,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜饮归简郑于野","author":"黄廷用","text":"策骑深更带雪回，雪花偏上紫貂来。\n五陵传柝千山瞑，双阙鸣钟万户开。\n自笑长安多酒伴，浪传蓬苑有诗媒。\n明朝准拟今宵约，吟望相从翠柏台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30694,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题吴太医卷","author":"黄廷用","text":"王液金丹已有神，红颜不驻此芳辰。\n寻芝种药云为侣，刻启传经世所珍。\n曾入先皇宸梦异，重看今日宠阶新。\n最怜诸子堪调鼎，尊酒年年献早春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30695,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙酉同方石南侯石溪过江郎山行酒赋诗兹辛卯秋复过此二兄不可作矣凄然有感","author":"黄廷用","text":"秋深万木乱山黄，愁听猿声隔岸长。\n泉汇溪流萦绝磴，云开霞色映斜阳。\n看诗为尔增新恨，对酒凭谁发故狂。\n蕉鹿于今真幻梦，石门回首忆江郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30696,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠陈龙溪同年守通安","author":"黄廷用","text":"六月长安疏雨过，藤萝苔藓亦堪怜。\n思君欲别河桥上，几日重逢尊酒前。\n路入烟霞青树合，风回岩岫白云连。\n滇南地僻俱皇上，循吏今看剌史贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30697,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"骏马逐电赋以赠友人之官电白","author":"黄廷用","text":"霜蹄赤汗此龙媒，千里真空冀北才。\n一顾飘飘嘶远道，终看矫矫立层台。\n逐电能教氛祲去，喷珠遥映翠光开。\n燕城日望高原上，玉勒金鞭首几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30698,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庆徐相国 其一","author":"黄廷用","text":"今皇端拱垂衣日，调鼎还归济世才。\n正合岁功周一纪，欣毛相业动三台。\n渥恩特诏春宫宴，殊锡频承中使来。\n更有龙章光紫阁，分明出自帝心裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30699,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庆徐相国 其二","author":"黄廷用","text":"一品元臣十二年，论思长在圣君前。\n昌期白首情偏洽，午夜丹心梦亦悬。\n翊运中兴明日月，筹边朔漠净风烟。\n虞廷快睹夔龙在，功叙新歌入管弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30700,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠黄友国光主留都兵政","author":"黄廷用","text":"今秋胡骑犯边城，往事伤心梦亦惊。\n已已年来无此变，太平日久不言兵。\n江山万里崇周镐，戎马两都属夏卿。\n见说东南忧未已，看君远别更多情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30701,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日赠林退斋兵宪颖川","author":"黄廷用","text":"乾坤此日转初秋，万里晴沙宿雾收。\n虎豹犹须文武士，凤凰原是帝王州。\n关城直控三都壮，开府中分两辅忧。\n说剑谈诗知不倦，几时载酒上湖舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30702,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九月十二日宫允孙季泉太史尹洞山林肖泉王槐野郭东野过对菊有作资韵","author":"黄廷用","text":"城东小径傍河开，几得从容一举杯。\n偶兴忽传仙客至，留欢先遣夷人回。\n重阳白酒犹堪醉，满院黄花亦足陪。\n对烛赓吟成坐久，不知宫漏出蓬菜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30703,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠台中张榕洲巡察大梁","author":"黄廷用","text":"春来骢马驻通桥，今使河南驿树遥。\n别绪岂堪羁旅地，许身长奉圣君朝。\n风霜鹰隼声飞急，日月虹霓影动摇。\n为布阳和沾草木，恩华曾受汉家饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30704,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠谏议李一吾之任留都","author":"黄廷用","text":"北闱疏乞过南省，喜得司仍献纳存。\n两地精忠悬日月，百年魂梦绕乾坤。\n白云秋杪连青琐，芳草春深即故园。\n回首明光曾补衮，尚馀封事耀君门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30705,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳纪游 其一","author":"黄廷用","text":"天下名山尊五岳，东南我已弋登临。\n行踪岁月成陈迹，到处烟霞结素心。\n金简不逢苍水使，丹垆欲傍碧云岑。\n自敲清磬朝真祖，朱鸟飞来遗好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30706,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳纪游 其二","author":"黄廷用","text":"七十二峰峰上井，洞庭泉脉似相通。\n青龙隐伏频行雨，白鹤翱翔每驭风。\n河影若浮尘世外，日华秪在海门东。\n谁能旋转清三界，万里江山一盻中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30707,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳纪游 其三","author":"黄廷用","text":"万丈层峰生绝奇，不知谁削混濛时。\n高当南极开天柱，遥拱北辰转地维。\n封邑于今仍旧址，荒苔何处觅残碑。\n翠华隐现松杉里，漠漠九疑悬梦思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30708,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳纪游 其四","author":"黄廷用","text":"看山出郭扬芝盖，十里松阴带夕阳。\n碧落低临惟鸟道，翠微深处有仙房。\n绝怜衡岳三灯现，俯盻湘江一线长。\n独步上封寻往迹，祝融云气总茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30709,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳纪游 其五","author":"黄廷用","text":"寻真杳□珠帘洞，洞里层轩烟雾浮。\n厌听泉声鸣涧底，忽看月色挂峰头。\n起坐翻经过午夜，漫眨说法度清秋。\n朝来观海天无际，涵彩阳精烛九州。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30710,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳纪游 其六","author":"黄廷用","text":"揽衣不寐倾葵藿，兜率上人□□□。\n万壑云光疑水泛，千峰霞气觉天低。\n□□吐日侵晨见，若木何年隔海迷。\n绝顶摩崖留姓字，肯言簪弁籍金闺。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30711,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳纪游 其七","author":"黄廷用","text":"会仙桥上石粼粼，桥下瑶花无数春。\n秪为俗缘牵白日，谁能冥悟出红尘。\n壮游司马风流在，未达虞翻骨相屯。\n十载封侯元有命，懒残果是度人人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30712,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳纪游 其八","author":"黄廷用","text":"鼓瑟湘灵何不见，羽人岩下奏箫笙。\n牛行石髓遗金迹，龙起沙潭喷玉声。\n采药寻师应病暍，叩关问道不知名。\n芙蓉万朵秋云老，夹径黄花□客情。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30713,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳纪游 其九","author":"黄廷用","text":"岷山迤逦开南岳，端拱重华此帝乡。\n廿载摛文亲玉案，一朝分檄领衡阳。\n登台载酒天花舞，勒石留诗涧草香。\n芒屦閒攀危磴上，境非蜀道亦羊肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30714,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]