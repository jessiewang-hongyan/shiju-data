[{"title":"题新淦姚氏挹清轩","author":"金幼孜","text":"闭门罕人事，清意有谁知。\n山色同朝暮，泉声自四时。\n弦琴堪对酒，拄笏好题诗。\n为写山林趣，悠然动客思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4227,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岁暮祀太庙斋宿翰林奉简胡杨二学士 其一","author":"金幼孜","text":"斋宿联官署，俄惊岁又阑。\n庭虚灯火静，天迥雪光寒。\n渐老怜双鬓，无能愧一官。\n相知二十载，许国寸心丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4228,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岁暮祀太庙斋宿翰林奉简胡杨二学士 其二","author":"金幼孜","text":"吏散蚤休衙，斋居夜不哗。\n盍簪频剪烛，清坐屡供茶。\n词赋相如好，才情水部誇。\n余生今五十，已觉鬓先华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4229,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岁暮祀太庙斋宿翰林奉简胡杨二学士 其三","author":"金幼孜","text":"五城风雪暮，万里属残年。\n话旧情偏洽，论诗席屡前。\n禁钟人语静，高阁漏声传。\n未有归田计，聊歌桂树篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4230,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岁暮祀太庙斋宿翰林奉简胡杨二学士 其四","author":"金幼孜","text":"岁事秪匆匆，浮生似转蓬。\n官居白首共，报国寸心同。\n云里天香下，城边霁雪融。\n夜深寒不寐，数起候晨钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4231,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日喜雨写怀 其四","author":"金幼孜","text":"阁中暑不到，长日静无哗。\n坐对西垣树，吟看上苑花。\n临池常洗墨，汲井自烹茶。\n渐觉形容丑，年来两鬓华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4232,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日喜雨写怀 其五","author":"金幼孜","text":"昼永文书静，风清刻漏迟。\n云低双阙树，日转万年枝。\n感遇交游在，迂疏圣主知。\n不才叨翰墨，何以报恩私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4233,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日喜雨写怀 其六","author":"金幼孜","text":"兀兀坐清昼，悠然兴味嘉。\n斜风断疏雨，远树障晴霞。\n鱼跃动文藻，鸟啼惊落花。\n独怜双鬓短，笔砚老生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4234,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日喜雨写怀 其七","author":"金幼孜","text":"长日费吟咏，终年典校雠。\n宦情真落落，生事只悠悠。\n雨后荷花晚，风前麦气秋。\n禁林即仙馆，何必问瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4235,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日喜雨写怀 其八","author":"金幼孜","text":"载笔晨趍阁，庭空暑气清。\n云移窗上影，雨送树间声。\n近槛驯乌集，当筵舞燕轻。\n当时乏经术，衰飒愧吾生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4236,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日喜雨写怀 其九","author":"金幼孜","text":"自谓年非迈，谁知老见侵。\n静观天地化，洞识古人心。\n积雨生座润，微凉解郁襟。\n何时乞恩泽，归老遂投簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4237,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日喜雨写怀 其十","author":"金幼孜","text":"圣主崇儒术，新开白玉堂。\n文章陋秦汉，礼乐洽虞唐。\n制作衣冠盛，恢弘运祚昌。\n吾儒膺宠遇，献纳愧班扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4238,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠贡士杨綖赴南海训导","author":"金幼孜","text":"杨子青云彦，儒官称好才。\n远从南海去，还自日边来。\n綵服荣家庆，慈颜乐寿杯。\n题诗惭潦倒，临别重徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4239,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"扈从车驾巡边过裴村田舍与杨少傅共酌","author":"金幼孜","text":"清朝催上道，出郭听鸣笳。\n野水流冰涧，江风涨雪沙。\n清谈驻鞍马，小酌坐田家。\n扈跸惭衰迈，祇怜两鬓华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4240,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚次白河","author":"金幼孜","text":"日晚白河上，千官向此留。\n天光临御幄，云气护宸旒。\n柳外轮蹄集，山头猎火收。\n故人同寝食，夜语独绸缪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4241,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早发白河","author":"金幼孜","text":"禁营传四鼓，驱马复晨征。\n野旷风威重，天空月影清。\n冲冲杂人语，喔喔乱鸡声。\n敢惮劳行役，空惭负老成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4242,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚次峪口","author":"金幼孜","text":"逦迤从銮驭，山川记昔年。\n时巡重讲武，事岂在游畋。\n碣石东临海，居庸北枕燕。\n帝京浑咫尺，王气满中天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4243,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"营门候驾","author":"金幼孜","text":"羽林初罢猎，万骑拥霓旌。\n驰道鸣笳合，前茅列炬明。\n充庖惊满载，得隽快先声。\n久立瞻銮驭，虹光彻御营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4244,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"廿五日早奉旨同杨少傅先归京","author":"金幼孜","text":"衰年同扈跸，特诏许先归。\n出郭星垂野，渡河霜满衣。\n远村鸡乱语，斜月雁高飞。\n回首天营内，朝阳五色辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4245,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同杨少傅蹇夏二尚书过山寺","author":"金幼孜","text":"野寺浑萧索，经行驻马鞍。\n饥乌啼树杪，独犬吠云端。\n小酌僧同话，新炊客共餐。\n题诗记行迹，偶得共盘桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4246,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚同杨少傅蹇夏二尚书宿田家","author":"金幼孜","text":"马头瞻落日，寻宿过田家。\n野老欣相得，村醪不用赊。\n田园乐丰岁，耕牧足生涯。\n摇落秋将尽，因之感岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4247,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梁叔庄墨竹","author":"金幼孜","text":"别馆多幽思，萧萧玉几竿。\n玄云动苍石，飞翠拂清湍。\n雨露资涵育，冰霜慎保完。\n莫忘君子意，抚玩有馀欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4248,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为杨学士勉仁题小景","author":"金幼孜","text":"积阴生巨壑，飞翠落崔嵬。\n古木云萝暗，苍崖雪瀑开。\n幽人挥麈坐，稚子抱琴来。\n想有登临兴，看图日几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4249,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠江阴严训导","author":"金幼孜","text":"春宫方进贺，行李又言旋。\n冰雪三冬候，关河万里天。\n斯文慎自保，交谊久愈坚。\n泮水诸生在，瞻思意独悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4250,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"思亲堂为永丰邹氏赋","author":"金幼孜","text":"患难违乡里，聊兹寄一抔。\n江山馀涕泪，雨露感春秋。\n宿草寒云重，封丘晚树稠。\n昊天思罔极，南望远松楸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4251,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭子武安 其一","author":"金幼孜","text":"念尔归何处，呼天竟莫知。\n爱深难遽割，抚字独增悲。\n魂魄应常在，他生不可期。\n一朝成永诀，再见复何时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4252,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭子武安 其二","author":"金幼孜","text":"生死嗟何及，徒增父母哀。\n肝肠愁欲裂，泪眼痛难开。\n近日犹疑在，从今去不回。\n但期收尔骨，归葬故山隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4253,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭子武安 其三","author":"金幼孜","text":"尔生才四岁，风骨最堪怜。\n已解摊诗卷，还能弄简编。\n提携从我后，出入在人前。\n命也真如此，朝朝诉彼天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4254,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽邵处士","author":"金幼孜","text":"客有邵平者，风流自可人。\n江湖曾浪迹，泉石旧为邻。\n月暗梅窗夜，烟寒墓草春。\n南湖歌楚些，闻者欲伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4255,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送武安同福安柩归西江","author":"金幼孜","text":"弟兄幸同返，相送在东城。\n不尽生前意，难胜死后情。\n天涯归柩远，万里一舟轻。\n回首金台上，吞声泪若倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4256,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"内阁独坐有感偶成 其一","author":"金幼孜","text":"人事祇如此，蹉跎又一年。\n虚名徒窃禄，白首未归田。\n秉笔惭周史，临文愧马迁。\n太宗遗业在，抚卷重悽然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4257,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"内阁独坐有感偶成 其二","author":"金幼孜","text":"东阁寒初入，垂帘坐夕曛。\n乾坤双鬓老，笔砚半生勤。\n落叶飘城雪，哀鸿度塞云。\n衰迟徒感遇，忝窃愧斯文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4258,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠主事刘孟铎还庐陵省亲","author":"金幼孜","text":"京国言归省，庭闱喜具存。\n綵衣荣晚节，紫诰沭深恩。\n婉娩承甘旨，从容候凊温。\n遥知称寿处，宾客日填门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4259,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽南昌李良卿夫妇 其一","author":"金幼孜","text":"早客西江外，鼋山竟未归。\n望迷先垄远，梦与故乡违。\n鹤化悲秋月，牛眠对落晖。\n欲题高士传，抚卷重歔欷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4260,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽南昌李良卿夫妇 其二","author":"金幼孜","text":"内助资贤淑，闺闱仰德仪。\n贻家敦俭朴，阅世享期颐。\n竹暗秋风冷，萱残夕露滋。\n百年同穴意，埋石有铭词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4261,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽礼部侍郎蒋良夫","author":"金幼孜","text":"君是我同年，词林谊独全。\n南宫去几日，别馆已闻仙。\n空负严亲望，犹兴圣主怜。\n今朝归旅榇，惆怅惨风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4262,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜克超袁君至","author":"金幼孜","text":"远道逾三月，今朝抵玉京。\n相持喜不定，倾倒若为情。\n问事知乡曲，因风想弟兄。\n灯前谩酬劝，不觉过深更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4263,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽杨子恭先生 其一","author":"金幼孜","text":"先生清介士，抱道独深藏。\n傲世非关僻，潜名岂自强。\n山林成独往，鱼鸟自相忘。\n前辈风流尽，悲吟只慨慷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4264,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽杨子恭先生 其二","author":"金幼孜","text":"雅操冰同洁，高怀鹤共清。\n吟诗自可老，避世岂谋生。\n遗后铭先著，知归葬自营。\n九原去已远，无复见仪型。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4265,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"甥光烈自蔚州归喜而赋此","author":"金幼孜","text":"昨夜灯花结，今朝喜鹊声。\n忽闻行李至，忧思一时平。\n关塞聊须到，山川记此行。\n壮游真不薄，期尔早知名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4266,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽袁君南恕 其一","author":"金幼孜","text":"平生称旷达，削迹谢浮荣。\n诗酒堪娱老，田园足治生。\n看山时览眺，闭户少逢迎。\n万里闻哀讣，难胜故旧情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4267,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽袁君南恕 其二","author":"金幼孜","text":"避俗人皆弃，安贫世共遗。\n临风歌对酒，倚竹坐题诗。\n雨冷閒松榻，灯昏冷蕙帷。\n青山对马鬣，引领泪交颐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4268,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠友人还万安","author":"金幼孜","text":"旧隐五云下，翩然又赋归。\n秋风三径菊，春日北山薇。\n牛渚云连树，龙河雪满衣。\n岁华看渐暮，忍见雁南飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4269,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠福建陈学正省亲","author":"金幼孜","text":"凉风日夜起，送客不胜情。\n黄叶雨中落，断鸿云外声。\n故乡千里远，行李一身轻。\n应想趋庭日，争看彩服荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4270,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠舒城朱知县","author":"金幼孜","text":"为说舒城宰，廉声满帝乡。\n化行推单父，种德比甘棠。\n天阙风云会，瑶阶雨露香。\n丹心期补报，致治效虞唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4271,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题爱同堂卷","author":"金幼孜","text":"严亲久沦没，慈母幸康宁。\n鞠育同恩爱，悲欢异死生。\n倚门犹慰意，陟岵不胜情。\n锡类资纯孝，乡闾有令名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4272,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题萧氏虎溪卷","author":"金幼孜","text":"长溪如虎踞，卜宅自何年。\n水影通帘幕，云光照简编。\n晚凉开竹径，春暖种芝田。\n何日寻幽隐，清谈煮石泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4273,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题曾原太友琴轩","author":"金幼孜","text":"良朋不可得，雅好托桐君。\n白雪心难变，金兰谊独亲。\n高山千载意，流水四时春。\n古道今寥落，空怀大雅人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4274,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题南康马教授匡山书屋","author":"金幼孜","text":"匡山渺何许，结屋在云边。\n泉响通书幌，岚光照简编。\n涧猿听夜诵，林鹤伴朝弦。\n奋步追高躅，明当继昔贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4275,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题襄阳司训黄公器竹居","author":"金幼孜","text":"脩竹净如洗，翛翛数百竿。\n捲帘通翡翠，散帖映琅玕。\n凉月分秋色，炎风生昼寒。\n知君慕高节，独立倚云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4276,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题兰谷","author":"金幼孜","text":"种兰在幽谷，清绝少人过。\n香露侵衣润，光风拂席多。\n瑶琴无俗韵，澧浦有遗歌。\n芳室薰融久，应知德不磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4277,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠周彦奇佥宪云南","author":"金幼孜","text":"远别向滇阳，华筵酒满觞。\n骊驹方载道，白简已飞霜。\n塞外碧鸡近，云间鸟道长。\n远人今向化，努力辅藩方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4278,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题行素轩","author":"金幼孜","text":"之人安素履，守分独无营。\n风月閒中趣，琴书物外情。\n捲帘流水近，欹枕白云生。\n扰扰奔驰者，何劳身后名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4279,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠萧主事之官北京","author":"金幼孜","text":"故人膺宠命，改调理刑曹。\n恩露沾新绶，天香染旧袍。\n征帆迷雪树，去路接云涛。\n到日重回首，遥瞻魏阙高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4280,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠徐中书崇威还家","author":"金幼孜","text":"京华岁将暮，谒告独还家。\n客路霏霏雪，寒梅处处花。\n綵帘娱爱日，寿酒酌春霞。\n回首隔蓬岛，相思梦更赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4281,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠友人考满复任","author":"金幼孜","text":"三年初上考，千里独还官。\n驿路梅开尽，都门岁易残。\n棹歌江上发，山色雪中看。\n莫道卑栖久，飞腾总不难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4282,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽杜若洲 其一","author":"金幼孜","text":"驱驰二十载，宁复叹官卑。\n硕德乡人重，清名海郡知。\n沧洲存旧业，墓石有新词。\n春草年年绿，思君总是悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4283,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽杜若洲 其二","author":"金幼孜","text":"先生高世士，早岁已知名。\n白发悲游宦，遗文叹老成。\n故山秋鹤怨，宰树暮猿声。\n令子能传业，徵词为勒铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4284,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽德清屠诚","author":"金幼孜","text":"去京能几日，忽复讣音来。\n玉树伤先殒，芝兰痛遽摧。\n忆归常问事，惜别屡持杯。\n惆怅湖山外，伤心泪满腮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4285,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"孟秋时享斋宿翰林","author":"金幼孜","text":"官署清凉后，清心坐夜分。\n钟声云外下，玉漏雨中闻。\n茶熟银瓶注，香消金鸭焚。\n扬雄生事拙，白发愧能文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4286,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题南园琴趣","author":"金幼孜","text":"閒居慕恬旷，雅趣在南园。\n山水留遗韵，烟霞隔世喧。\n幽兰宜独操，大雅共谁论。\n我亦知音者，何时一过门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4287,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题清碧书舍","author":"金幼孜","text":"爱子读书处，幽怀孰与同。\n青山当户牖，绿树隐帘栊。\n濯足过秋渚，鸣琴坐涧松。\n故居回首日，总在画图中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4288,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠太仆寺丞吴鉴复任滁阳","author":"金幼孜","text":"阙下久蜚声，还官荷圣明。\n凉风生祖席，疏雨湿行旌。\n秋晚骅骝健，天高鸿雁鸣。\n滁阳山水好，图画有馀情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4289,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠郁林州判","author":"金幼孜","text":"郁林渺何许，远在海西头。\n念子有行色，离情逐宦游。\n晓云随綵旆，夜月引仙舟。\n好为宣王化，从容展壮猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4290,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠龚子谏佥宪云南","author":"金幼孜","text":"万里南云道，君行佐臬司。\n交游怜宿昔，远别系深思。\n衣绣瞻飞鹗，乘骢问碧鸡。\n遐荒宣德意，揽辔重询咨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4291,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠人游钱塘","author":"金幼孜","text":"钱塘古名胜，念子事重游。\n湖山迎画舫，海月映红楼。\n锦树千堤晓，银涛八月秋。\n几时寻贺监，一笑解吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4292,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠知县任连江","author":"金幼孜","text":"拜命出瑶京，郎官动列星。\n马嘶惊远道，鹏运起沧溟。\n越树连云白，闽山入眼青。\n到官敷善治，抚字念疲氓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4293,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题西园清兴","author":"金幼孜","text":"伊人慕清赏，旧隐在西园。\n竹影自临砌，泉声时到门。\n看云晨拄笏，乘月夜闻莺。\n一自膺名宦，幽怀孰与论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4294,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"丰乐堂为周宜民赋","author":"金幼孜","text":"海内隆平日，皇恩遍迩遐。\n大田多黍稌，比屋见桑麻。\n旆旆誇盈廪，穰穰庆满家。\n芹湖羹饭美，尚拟泛云槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4295,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"北征随驾誓师鸣銮戍","author":"金幼孜","text":"周宣驱猃狁，汉室靖楼烦。\n战伐需良将，神谋仰至尊。\n皇威开大漠，仙伏御曾氛。\n壮士心如虎，争图报国恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":4296,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]