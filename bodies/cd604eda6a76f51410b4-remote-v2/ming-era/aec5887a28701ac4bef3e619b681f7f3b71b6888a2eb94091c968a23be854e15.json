[{"title":"宫保顾公吏侍张公被命校文仆承乏礼曹知贡举予三人者弘治乙丑同年进士也孝皇赐第距今三十有四年矣顾公有诗纪遇志感余嗣和焉 其一","author":"严嵩","text":"三十年前战艺场，最荣今日共春堂。\n恩沾醴宴花明席，诏锁文闱棘绕墙。\n阅尽沙金知力健，坐阑宫烛觉宵长。\n凤池老手夔龙望，蚤见华虫补舜裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫保顾公吏侍张公被命校文仆承乏礼曹知贡举予三人者弘治乙丑同年进士也孝皇赐第距今三十有四年矣顾公有诗纪遇志感余嗣和焉 其二","author":"严嵩","text":"射策当年独擅场，偶惭疏朽亦升堂。\n亲承赐第临轩陛，谩逐看花过苑墙。\n晨镜照霜华发改，晚葵倾日赤心长。\n泰园春草年年绿，拭泪瞻天忆衮裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四月八日钦蒙于长陵殿门左召对 其一","author":"严嵩","text":"陵殿东头御幄垂，炉烟高拂午松枝。\n中官呼召黄袍坐，此是新承顾问时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四月八日钦蒙于长陵殿门左召对 其二","author":"严嵩","text":"龙幄近瞻颜咫尺，玉音亲听语分明。\n不知何幸纡皇眷，无限依依犬马情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"祗役戚园览游西山诸寺","author":"严嵩","text":"东峰西崦鸣钟近，宝刹珠林处处来。\n松径驻骖僧吹发，石溪流叶寺门开。\n始惊鸟道看难到，渐入云根兴转催。\n年去尚嗟筋力在，夕阳重上最高台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平坡寺在西山之巅境甚奇峻攀磴而陟俯视万壑予为礼侍一至今十年矣","author":"严嵩","text":"入门双树欲参天，为礼云峰一爽然。\n长向省曹迷簿领，忍令心赏负风烟。\n静闻经梵千林上，徙倚苍茫独鸟前。\n再入南宫容鬓改，山僧犹记昔游年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓宿碧云寺","author":"严嵩","text":"楼阁盘苍巘，香灯隐翠微。\n竹间泉溜发，临赏澹忘归。\n立沼窥鱼泳，俯槛见云飞。\n一向岩中宿，蓬心自觉非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"香山寺来青轩题","author":"严嵩","text":"再到层轩坐，诸峰尽若迎。\n劲风山木振，初日殿鸦鸣。\n澄廓邀殊观，高閒寄远情。\n惜无谢客赏，况乃趣王程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日南内召对","author":"严嵩","text":"重华宫中翠辇来，翔凤楼前彩仗回。\n正是传宣当九日，赐醪全胜菊花杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉敕充知大礼上册使连日召对玄极殿精一堂文华西室恭纪","author":"严嵩","text":"亲劳御笔题宗伯，幸际昌期侍圣人。\n朝发玉书传近弼，夜燔苍璧助精禋。\n圜丘扈跸天行肃，温室承颜昼接亲。\n无涯莫报乾坤赐，匪懈真忘夙夜身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书事十三绝 其一","author":"严嵩","text":"炉香拂座月窥檐，带玉袍绯列贵阉。\n为报四臣宣巳至，近前轻揭翠旃帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书事十三绝 其二","author":"严嵩","text":"南郊册礼是新仪，圣主从容得面咨。\n一一榻前亲指授，却教传与太常知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书事十三绝 其三","author":"严嵩","text":"玄极红云捧帝居，天牌新制焕金书。\n肇成大享称严配，典礼分明复古初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书事十三绝 其四","author":"严嵩","text":"丹陛前头催设位，祠官祝币列参差。\n我皇肇举无前礼，亲率诸臣演大仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书事十三绝 其五","author":"严嵩","text":"堂开精一连皇极，宝阁金题入紫烟。\n自是钧天难可到，几回身侍玉皇边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书事十三绝 其六","author":"严嵩","text":"百子螽斯望接连，皇家胤嗣本绵延。\n行从毓德宫前过，知是轩龙启瑞年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书事十三绝 其七","author":"严嵩","text":"右掖笼灯半掩门，对回玄极巳宵分。\n迟回暗记丝纶语，此语人间未遣闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书事十三绝 其八","author":"严嵩","text":"每夜烧灯频草奏，夜分直到御前开。\n中官门隙争传递，知是南宫礼疏来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书事十三绝 其九","author":"严嵩","text":"法驾前陈炬火开，千官骑从出蓬莱。\n敕使殿头先授简，拜册南郊当夜回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书事十三绝 其十","author":"严嵩","text":"星汉昭回夜景澄，灵风不动燎烟凝。\n遥望衮衣亲奠献，泰坛高处几回登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书事十三绝 其十一","author":"严嵩","text":"黄毡设幄傍丘坛，绛蜡金炉夜不寒。\n衮黼才临催入对，乐章亲制赐传观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书事十三绝 其十二","author":"严嵩","text":"春卿传诏捧云盘，日照金龙系綵竿。\n十道使华衔命出，万方雷雨布恩宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书事十三绝 其十三","author":"严嵩","text":"黄绫写颂奏金銮，缛典新成际会难。\n御笔巳批留史馆，又教抄在禁中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和少傅桂翁郊坛喜晴奉天殿捧诏 其一","author":"严嵩","text":"冬禋丽日辉晴昼，圣主精诚信格天。\n已向卿云歌舜瑞，还将华岳祝尧年。\n皇风浑噩追三代，阳德亨嘉进众贤。\n独有相臣分奠献，紫坛簪佩上炉烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和少傅桂翁郊坛喜晴奉天殿捧诏 其二","author":"严嵩","text":"奠璧南郊祀九成，肇陈琼册荐鸿名。\n万方濊泽颁皇诏，五夜精禋竭圣情。\n淑气正随葭管动，日华先上衮衣明。\n殿头鹄立知元辅，亲佐唐尧致太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和少傅桂翁郊坛喜晴奉天殿捧诏 其三","author":"严嵩","text":"大享欣瞻圣典成，惟寅愧忝秩宗名。\n诏从廷授叨馀宠，诗得缄题荷故情。\n缪随鹓鹭颜方腼，每奉琼瑶眼倍明。\n岂意陋庸遭盛际，与公亲见泰阶平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁除日省中晚归是日上手札曰谕秩宗有光禄酒馔之赐 其一","author":"严嵩","text":"楼雪宫烟暮景斜，手封仪疏未收衙。\n君王赐得辞年酒，助与椒觞夜颂花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁除日省中晚归是日上手札曰谕秩宗有光禄酒馔之赐 其二","author":"严嵩","text":"御札十行劳赐谕，秩宗三礼愧非才。\n不知何语堪闻圣，疏对晡从阁里回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕家宴喜弟侄远至","author":"严嵩","text":"京华屡见流年换，弟侄新从故里来。\n乍睹别颜应自喜，细论乡事转堪哀。\n杯浮绿蚁团栾坐，花覆银缸烂熳开。\n薄劣误承皇眷厚，沧江空问钓鱼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元旦赐长春酒并光禄酒馔","author":"严嵩","text":"宫醪玉馔连翩送，敕向天厨赐五臣。\n酒出长春名本异，赐当元日宠尤新。\n仙桃醉领东风暖，丰草恩沾湛露均。\n愿奉阳和同寿域，还歌天保答皇仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"是岁己亥予贱生六十甲子矣感遇述情而作此诗","author":"严嵩","text":"幸到六旬初度日，众中吾亦白头人。\n滥随鹓序升朝久，谩对椒花献寿新。\n樗干岂堪为巨室，草心长许奉阳春。\n楚山风树思亲泪，魏阙星霜报主身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"礼部旧无朝房予疏请命工曹特建盖异数也落成春祀斋宿奉简张蔡二寅丈 其一","author":"严嵩","text":"直庐新敞禁垣西，宫月临窗苑树齐。\n玉漏曙闻高阁报，碧梧春借上林栖。\n殊恩正荷帡幪赐，胜迹须留岁月题。\n鹓侣同心俱隽望，五云簪佩得相携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"礼部旧无朝房予疏请命工曹特建盖异数也落成春祀斋宿奉简张蔡二寅丈 其二","author":"严嵩","text":"玉楼金阁眩东西，咫尺宫城北斗齐。\n峰远雪云迷夕望，庭幽乌月伴寒栖。\n迟回省署年频改，惆怅春襟句自题。\n夙夜此身忧责在，绿尊虚负碧山携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"礼部旧无朝房予疏请命工曹特建盖异数也落成春祀斋宿奉简张蔡二寅丈 其三","author":"严嵩","text":"晓星残月在檐西，起望天街簇仗齐。\n瑶雪静含鳷鹊影，綵云深护凤凰栖。\n南宫礼乐逢昌运，上苑烟花续旧题。\n谁信烧灯催草奏，每看堂印夜中携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其一 赐大红罗飞鱼服","author":"严嵩","text":"宫罗五綵出天机，锦浪神鱼烂满衣。\n知尔乘云露头角，便从天上赤龙飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其二 赐方袋银瓢刀箸三事","author":"严嵩","text":"芙蓉为画锦为囊，刀箸银瓢揔系将。\n已是三回沾御赐，每随天仗佩恩光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其三 赐压袋银钱","author":"严嵩","text":"御帑朝分压袋钱，白金新铸倍光鲜。\n五铢永作人间宝，四字今题嘉靖年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其四 赐银镀金酒杯盛以沙金漆盘","author":"严嵩","text":"银杯捧出竞传看，色间黄金映赤盘。\n长路风尘劳圣念，宫醪引满不辞乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其五 赐御笔诗","author":"严嵩","text":"洒翰亲承御榻前，圣皇初述渡河篇。\n祗应百世藏为宝，此是南巡扈跸年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其六 赐梅苏丸","author":"严嵩","text":"炼蜜调梅细作丸，白凝霜雪尽团团。\n马上探囊时一嚼，送得清白入肺肝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其七 赐解劳汤","author":"严嵩","text":"历历山川信所遭，马前尘土满征袍。\n服劳自是微臣义，药裹深蒙赐解劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其八 赐綵装松竹梅鸾带","author":"严嵩","text":"綵装鸾带倍鲜华，面授行宫拜宠嘉。\n为勖岁寒同节操，竹青松翠间梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其九 赐画面扇并象刻寿仙缀子","author":"严嵩","text":"五明綵扇制还新，象缀银环价倍珍。\n挥爱虞薰时解愠，捧看宫月近随人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其十 赐花线绦并金厢宝石提系","author":"严嵩","text":"五纹丝线织绦长，金作绦环七宝装。\n就中独有猫睛贵，觑看中间一线光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其十一 赐磁器瓯碗十二件","author":"严嵩","text":"几年陶器尚收储，拜赐先皇旧帑馀。\n捧持但觉恩为重，宝爱深知玉不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其十二 赐御赉银","author":"严嵩","text":"书生未识籯金富，圣主多惭惠养私。\n拟作他年遗老计，买山谁道更无赀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其十三 赐马","author":"严嵩","text":"敕赐天闲玉鼻骍，便教骑在驾前行。\n过都历块还轻健，疑有风云足下生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其十四 赐笋尖","author":"严嵩","text":"解箨龙孙露玉尖，分明生就指纤纤。\n灵山异产天家赐，肉食那知此味兼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其十五 赐面衣","author":"严嵩","text":"扈跸初从江汉归，长途终日马騑騑。\n冰绡不受红尘涴，谢得君恩赐面衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其十六 赐袖香","author":"严嵩","text":"龙脑修和集异方，宫中熏奉御衣裳。\n自从分得君王赐，袍袖携归不断香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其十七 赐烟墩帽并金厢宝石帽顶一座","author":"严嵩","text":"赐来大帽号烟墩，云是唐王古制存。\n金顶宝装齐戴好，路人只拟是王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其十八 赐代衣银","author":"严嵩","text":"造膝从容奉密言，晚来冲雨出宫门。\n赐金为代衣沾湿，感德身同挟纩温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈跸南巡自出京至在途蒙恩赉诸物各恭纪一绝以志荣感其酒馔牲品等物尤多盖不能悉纪也 其十九 赐酒竹叶清真珠红二品","author":"严嵩","text":"御厨官酒出黄封，碧滟红香昔未逢。\n共道皇恩比春色，一分斟处十分浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中丞顾公寄示长沙道中诗辄次韵答之","author":"严嵩","text":"保釐风采重台臣，功在朝廷德在民。\n笔底总持三尺法，湖南遥布万家春。\n尽捐厨传无烦费，还载图书只旧贫。\n儒术由来须世用，北山猿鹤可相嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺序翁阁老新第落成","author":"严嵩","text":"京国园庐三十载，新堂今敞相臣居。\n沙堤路迥回莲炬，棨戟门高拥驷车。\n握发每延朝客坐，濡毫时答御函书。\n卑栖地接阶除近，几席追从日未虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺桂翁阁老新第落成","author":"严嵩","text":"相国新开甲第雄，平沙堤接凤池东。\n宝函龙札来天上，画栋朱甍出雾中。\n朝罢御烟携衮绣，吟馀花日上帘栊。\n麒麟抱送天应眷，看取千年社稷功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜宴别彭太史使楚","author":"严嵩","text":"别调参差弦上声，燕台岁晚送君行。\n寒星曙雪催程远，玉节金书奉使荣。\n宫锦驻轺家暂到，楚兰弭棹赋初成。\n未能便逐归骖去，猿鹤松关苦系情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日偶成","author":"严嵩","text":"不知身事竟如何，无限春心负薜萝。\n林岫鸟还知力倦，圃亭花发柰风多。\n閒搔短发从渠变，每得新诗秪自哦。\n凭仗一生忠信力，岂惊人世有风波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈子器赴政和令 其一","author":"严嵩","text":"送君闽海去，把酒意茫然。\n邑小尤堪治，才高谁为怜。\n武溪看罨画，黎岭入风烟。\n万里迟双舄，何年向日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈子器赴政和令 其二","author":"严嵩","text":"二鸟来南国，文章五色奇。\n胡然滞遐举，分飞殊路岐。\n夜歌闻白雪，春赏惜琼枝。\n荐祢惭无力，空吟饯别诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"符子太仆出守韶郡赋此以赠符子昔尝作倅于韶也 其一","author":"严嵩","text":"韶阳人吏拜旌麾，为政风流记昔时。\n新佩鱼符称剌史，重来竹马候童儿。\n花间露冕春行县，烛里摊书夜坐帷。\n若见陇头梅发处，因题佳句一相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"符子太仆出守韶郡赋此以赠符子昔尝作倅于韶也 其二","author":"严嵩","text":"过从未厌客长安，谁道新恩阻旧欢。\n他日故山还结社，清时荣路且弹冠。\n犹怜宝剑横秋水，自许青松耐岁寒。\n垂老不堪仍远别，送君惟有劝加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王太常之南京","author":"严嵩","text":"廊庙只今公望属，暂劳征旆过江东。\n旧京礼乐仙曹贵，瀛海风烟别路重。\n陵祀晓随钟阜月，郊巡时扫泰坛松。\n送君忆我曾游地，惆怅因怜雪上踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和少傅桂翁阁莲六花之作","author":"严嵩","text":"九重城隔金扉路，六萼莲开玉井花。\n羲画正符阳道泰，越妆偏助赏心嘉。\n帘虚翠盖摇波影，阁迥红香近日华。\n珍重化钧调燮在，年年芳节瑞天家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]