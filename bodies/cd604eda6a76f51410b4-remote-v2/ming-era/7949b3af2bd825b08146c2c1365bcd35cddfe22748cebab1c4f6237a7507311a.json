[{"title":"雪中登楼望湖上诸作 其十","author":"刘泰","text":"瑞应丰年不在多，黑貂裘敝奈贫何。\n老怀未减峥嵘气，独对梅花发浩歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29820,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上和士亨作 其一","author":"俞鸣玉","text":"群山凝素郁崔嵬，近水梅花冷未开。\n却喜渔舟轻似叶，放歌撑出断桥来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29821,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上和士亨作 其二","author":"俞鸣玉","text":"闻说平戎仰圣威，玉门关外马如飞。\n貔貅踏破天山雪，笳鼓声中奏凯归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29822,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上和士亨作 其三","author":"俞鸣玉","text":"朔风吹散楚江鸥，短策孤吟到水头。\n谁把一竿和水钓，冲寒不解有羊裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29823,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上和士亨作 其四","author":"俞鸣玉","text":"不叹金鱼带未悬，半生且费买书钱。\n谁知雪满南桥上，时有人维问字船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29824,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上和士亨作 其五","author":"俞鸣玉","text":"中宵映雪读离骚，坐待虚窗月影高。\n宁似五侯歌舞地，飞觞燕客醉羊羔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29825,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上和士亨作 其六","author":"俞鸣玉","text":"雪深何处吊逋仙，湖北湖南锁暮烟。\n吟得暗香疏影句，兴来都付薛涛笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29826,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上和士亨作 其一","author":"刘邦彦","text":"寒封林树玉槎芽，银海摇光眩欲花。\n清晓蹇驴湖上去，寻梅迷却路三叉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29827,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上和士亨作 其二","author":"刘邦彦","text":"凤山西下雪模糊，琪树琼林接故都。\n寒勒老梅香不放，欲搥羯鼓倩花奴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29828,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上和士亨作 其三","author":"刘邦彦","text":"小阁青灯对榻悬，敌寒沽酒不论钱。\n夜深拥被清无寐，起掉坡仙药玉船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29829,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上和士亨作 其四","author":"刘邦彦","text":"玉堂学士擅风骚，扫雪烹茶趣自高。\n留得平生忠节在，不惭金帐饮羊羔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29830,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上和士亨作 其五","author":"刘邦彦","text":"刘郎才力近来多，不数扬州水部何。\n白雪调高成绝唱，郢人从此愧赓歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29831,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上和士亨作 其一","author":"霍孟阳","text":"乾坤万里尽模糊，垒玉堆琼壮旧都。\n不减灞桥吟兴好，自裁新句付奚奴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29832,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上和士亨作 其二","author":"霍孟阳","text":"檐溜无声冻作冰，满怀清思对寒灯。\n明朝策蹇西湖去，不是寻梅定访僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29833,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上和士亨作","author":"赵廷玉","text":"同云黯黯北风多，此冷难禁奈老何。\n记得西湖年少日，水晶宫里载笙歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29834,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨晴至江渡","author":"蒋主孝","text":"西风吹归云，秋空净如洗。\n萧萧芦荻花，半落寒江水。\n江水清且深，洋洋跃文鲔。\n眼看白雁飞，能与寄书未。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29835,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨绍述","author":"蒋主孝","text":"长风捲茅屋，迟子江上舟。\n灼灼芙蓉叶，渺渺寒川流。\n子行独何之，驾言返故丘。\n门前几杨柳，不禁离别愁。\n芳筵倒玉瓯，侍儿弹箜篌。\n酒酣抗手别，白云空悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29836,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春怀故园","author":"蒋主孝","text":"春日怀故园，令我心反侧。\n路无百里遥，身有数年隔。\n青山绕白云，顷刻迷踪迹。\n而人亦如之，是为形所役。\n几何百年寿，营营无了日。\n仗剑对樽俎，斜阳无双戟。\n时歌游冶辞，共醉江南客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29837,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渔父","author":"蒋主孝","text":"朝驾沧浪舟，暮泊沧浪曲。\n得鱼即沽酒，不知荣与辱。\n芦花两岸秋，醉枕蓑衣宿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29838,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宴金粟公子山居","author":"蒋主孝","text":"我为尘网婴，青春苦无乐。\n偶乘款段马，慰子守岩壑。\n竹隐邯郸鸠，庭舞青田鹤。\n细柳垂疏篱，山花映丛薄。\n景至情复浓，黄流对君酌。\n君本豪杰才，乃置居士屩。\n呜呜吹剑首，草木怨摇落。\n不闻扬子云，识字终投阁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29839,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀古","author":"蒋主孝","text":"秋水严陵滩，秋风黄金台。\n台高几百尺，滩行几百回。\n滩行日渐远，台高日渐摧。\n秋风与秋水，蒺藜花自开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29840,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送周云鹏之汉阳","author":"蒋主孝","text":"南浦草如织，别君将奈何。\n松风杂灵籁，春冰铺碧罗。\n问君何时还，遥岑立峨峨。\n可望不可即，坐听山鸟歌。\n歌声起归思，横渡汉阳波。\n落花正无赖，白鸥江上多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29841,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"饮酒","author":"蒋主孝","text":"青晨忽不乐，开轩对芳樽。\n遂令结郁怀，分散如浮云。\n狂风飒然至，辟我三重门。\n经书悉堕地，小犬号山村。\n偃卧北窗下，悠然古意存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29842,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大堤曲","author":"蒋主孝","text":"垂柳阴阴绕堤绿，二八婵娟唱新曲。\n映水荷花眩晚霞，隔岸芙蓉障红玉。\n弹丝吹竹当路傍，使君驻马索酒尝。\n临流卷幔对君语，十二巫山春梦长。\n春梦长兮月将落，湖上东风玉跳脱。\n自矜纤手摘兰芽，红泪双双为君阁。\n背人偷整玉搔头，摇荡春情燕子楼。\n回首可怜歌舞散，彩云零落渚花秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29843,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渭城少年行","author":"蒋主孝","text":"长安道上春来早，梁苑梨花啼小鸟。\n小鸟啾啾不住声，满地落花春已老。\n可怜游子客辽西，昨日书来不敢啼。\n章台杨柳空摇翠，几阵东风叶尽低。\n东风独吹杨柳树，撩乱飞花不知处。\n花作浮萍逐浪漂，渭水秦川向东注。\n渭城楼阁盛繁华，斗鸡走马足豪奢。\n朝持金弹游戚里，夜抱閒花醉酒家。\n酒家银烛照歌舞，来报城头起更鼓。\n娟娟明月悬青天，岂识深闺别离苦。\n别离有恨将奈何，笑颜不及愁颜多。\n一曲琵琶两行泪，背看灯影颦双蛾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29844,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"车遥遥","author":"蒋主孝","text":"君有万里行，妾有长相思。\n君行不顾妾，妾思君不知。\n关山盘盘多鸟道，君行渐远车声小。\n不得随车万里行，愿身化作催归鸟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29845,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"各东西","author":"蒋主孝","text":"车轮碾土声轧轧，君游五原我三峡。\n出门不复问东西，宝剑差差露尘匣。\n江水东流月西坠，不洒长途离别泪。\n两叶浮萍大海中，知他飘泊何时会。\n壶中有酒且尽欢，莫论乾坤窄与宽。\n人生会合亦偶尔，此别何须较生死。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29846,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江南弄","author":"蒋主孝","text":"蒲芽出水鸭雏小，骄马嘶声踏芳草。\n谁家红粉两妖娆，终日当垆被花恼。\n使君伫立凝双眸，蛱蝶纷飞来陇头。\n青山不碍相思梦，春老江南人自愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29847,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"棹歌曲","author":"蒋主孝","text":"朝棹歌，暮棹歌，江头风浪夜如何。\n荷花红兮荷叶绿，棹向浔阳江上宿。\n浔阳少妇不禁愁，卧看长江水倒流。\n水底月明无处觅，恨绝鸳鸯也白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29848,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陇头吟","author":"蒋主孝","text":"洮云飞飞渡陇水，白骨疆场泣新鬼。\n闺中少妇闻笛声，旧怨新愁深骨髓。\n陌头杨柳飞白花，去年此日才离家。\n谁知渡陇不复返，儿孤母老天之涯。\n陇头之水声咽咽，路上行人心似铁。\n只听流水声，不看流水血。\n黄沙白草秋茫茫，终年眼望胡天月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29849,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜与许生酌别","author":"蒋主孝","text":"丈夫重功名，车轮不停走。\n金门欲通籍，安能事畎亩。\n长途会合亦非偶，与君且醉金陵酒。\n夕阳衰草起沧洲，更欲为君沽一斗。\n酒酣灯下看吴钩，落魄谁怜马少游。\n跨鹤不归沧海去，却教何处觅瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29850,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五王击毬图","author":"蒋主孝","text":"毬门高结春如海，紫袖垂垂剪双綵。\n薛王力倦宋王来，兴废宫前花正开。\n侍儿弄笛申王醉，更有岐王拥花睡。\n春风不动草如铺，兄弟怡怡入画图。\n黄门拥入五花帐，官奴谩鼓花奴唱。\n博山火爇水沉香，富贵从来自天降。\n迟迟春日下龙楼，花萼联辉雨气浮。\n大被渐寒歌管歇，三郎别领阿环游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29851,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春晓曲","author":"蒋主孝","text":"春风吹草成绿波，美人酌我金叵罗。\n双双乳燕掠花去，招呼不来将奈何。\n油壁轻车紫罗帐，两两鸳鸯浴相向。\n惜花御史不放衙，啾啾野鸟空惆怅。\n惆怅春云满目前，潺潺骤雨惊晓眠。\n须臾雨歇春云散，陌上游人拾翠钿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29852,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"北邙行","author":"蒋主孝","text":"请君着耳听，听我北邙歌。\n北邙山头鬼夜哭，天阴雨湿愁奈何。\n昔年罗绮丛中过，而今白骨埋山阿。\n坟头狐狸学人语，谁家子孙能作主。\n君不见张家柱磉李家碑，白日不饮将何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29853,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖中曲","author":"蒋主孝","text":"杨柳风来水波浅，盼断娇娘双泪眼。\n湖边落日唱吴歌，隔岸青山望中远。\n荷花照人生浅红，芙蓉枝上白头翁。\n声声似诉不平怨，我亦欲诉无由逢。\n团团荷叶如擎盖，夜来摘向街头卖。\n丝长柄短刺搠人，抛掷中流了愁债。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29854,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春夜别友人","author":"蒋主孝","text":"六合故人少，为君歌别筵。\n青灯照华屋，白发怨流年。\n山绕荆门路，江浮楚国天。\n明朝从此去，何日望归船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29855,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过姚氏别业","author":"蒋主孝","text":"渡水复登山，浮云似我閒。\n村花当径发，林鸟背人还。\n绿酒堪怡性，丹砂可驻颜。\n几多名利客，白首叩秦关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29856,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病起感怀","author":"蒋主孝","text":"老病复侵寻，儒冠负壮心。\n功名逃凤阙，声价售鸡林。\n知命窗前易，安贫膝上琴。\n青山空在望，白发巳盈簪。\n无命当全贵，清閒直万金。\n露花同落寞，风叶共萧森。\n瓦罐邀谁饮，村童笑我吟。\n澄江有深浅，沙鸟自浮沉。\n不用频惆怅，浮云变古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29857,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"席上","author":"蒋主孝","text":"高阁霭馀晖，双双燕子飞。\n酒斟青玉案，歌唱白铜鞮。\n眠柳惊春梦，流莺破晓迷。\n缠头双锦段，争买醉如泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29858,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"野人居","author":"蒋主孝","text":"江上葺茅庐，公然与世疏。\n独歌梁甫调，不草绝秦书。\n白鹤怀山果，青猿摘野蔬。\n萧萧双短鬓，两月一番梳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29859,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"经龙潭故里","author":"蒋主孝","text":"青山望不极，古木下斜阳。\n野水呼船渡，村醪倩客尝。\n亲朋俱旧识，富贵两相忘。\n好约诸年少，看花引兴长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29860,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早春游望","author":"蒋主孝","text":"闻道春光好，香车晓出门。\n风吹杨柳渡，霞照杏花村。\n鸟去山逾寂，鱼惊水自浑。\n谁知情与境，融会两无言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29861,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游邵氏山居","author":"蒋主孝","text":"一径入幽深，迢迢接远林。\n草堂无俗客，竹坞有鸣琴。\n欲觅吟诗伴，还期载酒寻。\n古来韬隐者，不肯屈黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29862,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小蓬莱","author":"蒋主孝","text":"我爱小蓬莱，昆明几劫灰。\n青天舞黄鹤，平地筑仙台。\n瑶草栏边长，蟠桃海上来。\n始知弦管地，回首即成哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29863,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日登雨花台晚归","author":"蒋主孝","text":"山童先放鹤，同约野人登。\n树密藏花窖，江空露石棱。\n赏心徒有酒，系日却无绳。\n兴尽归来晚，柴门唤不应。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29864,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄友","author":"蒋主孝","text":"欲掉酒船至，桐江望客星。\n梅花千树白，乳窦两峰青。\n廊庙初垂念，山灵已勒铭。\n若将踪迹比，浑似水中蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29865,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄西湖隐者","author":"蒋主孝","text":"道人脱白帽，有似华阳君。\n閒情随野鹤，尘梦逐春云。\n山色频年见，溪声尽日闻。\n寄书常不达，何事苦离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29866,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓行","author":"蒋主孝","text":"何处堪投辖，前村有杏花。\n山回残月照，路转宿云遮。\n小圃惊飞雉，长林噪乱鸦。\n春江渔父艇，垂柳野人家。\n贵贱嗟时命，荣枯感物华。\n担头挑日影，花底散蜂衙。\n老树缘芳藓，寒流绕白沙。\n朗吟成久立，往事正堪嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29867,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日游宝光寺","author":"蒋主孝","text":"清晨游古寺，红叶满秋林。\n广殿飞花雨，长廊转柳阴。\n閒情随舞鹤，诗思逐鸣琴。\n流水自更变，青山历古今。\n天空江雁下，露冷草蛩吟。\n小酌无深趣，长歌有好音。\n红尘悲俗态，白石悟禅心。\n莲座千岩迥，松关一径深。\n有家堪懊恼，无路可追寻。\n拟约重来此，斜阳下远岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29868,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋望","author":"蒋主孝","text":"岁月惊心晚，萧萧满眼秋。\n乾坤双鬓短，天地一身浮。\n有客寻遗逸，无人识故侯。\n鸟喧寒日下，山静宿云收。\n富贵独能致，蓬莱未可求。\n心閒堪作乐，身老不禁愁。\n霜信惊玄鸟，潮声起白鸥。\n渚花方靡靡，庭竹更脩脩。\n无限深秋趣，孤舟横渡头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29869,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日陪周功叙学士游朝天宫","author":"蒋主孝","text":"晓露滋瑶草，东风绽碧桃。\n致君有公辈，行乐属吾曹。\n恍惚游三岛，凄迷叹二毛。\n山深人自寂，市远性俱逃。\n占断壶中景，真成世上豪。\n水清山涧浅，苔古石床高。\n白鹤呼为仆，春云剪作袍。\n路迂三屈曲，乐奏八琅璈。\n仙境频年乐，尘寰尽日劳。\n独怜扬子宅，白首续离骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29870,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋怀","author":"蒋主孝","text":"落木西风白雁飞，阿谁中夜泣牛衣。\n栖迟泉石无身累，怅望乡关有梦归。\n痛饮不妨人共醉，閒情应与世相违。\n灯前莫舞冯驩剑，极目天涯已夕晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29871,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江汉","author":"蒋主孝","text":"江汉同流接混茫，萧萧芦荻雁南翔。\n姓名不到公卿府，泉石喜游君子乡。\n青眼昔年羞阮籍，白头今日老冯唐。\n思乡怀古浑閒事，酾酒椎牛兴自长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29872,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张别驾致仕还汉阳","author":"蒋主孝","text":"长江东走七千里，独驾□船破浪行。\n春满汉阳花半吐，云收衡岳雨初晴。\n三年作宦青霄立，一夜思乡白发生。\n今日临岐无那别，渭城那敢唱新声。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29873,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荒郊秋望","author":"蒋主孝","text":"塞垣孤雁又南翔，老去惊看岁月忙。\n云捲韝鹰擒狡兔，风追猎犬搏贪狼。\n霜前杨柳无多叶，雨后蒹葭几许长。\n日短江东聊极目，欲强筋骨走殊乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29874,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送苏正回海昌分得园字","author":"蒋主孝","text":"残雪初消涨水痕，故人南去惜离樽。\n孤舟江上难为别，芳草天涯易断魂。\n云冷关山千里道，月明砧杵几家村。\n此行正及梅花发，看尽春光到故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29875,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春江曲","author":"蒋主孝","text":"潮来江水平，潮去江水落。\n安得荡子舟，撑上沙滩阁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29876,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"买妾言","author":"蒋主孝","text":"使君自有妇，买奴将若何。\n乐府新成谱，教奴夜夜歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29877,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春晓","author":"蒋主孝","text":"春阳未出海，春风已到楼。\n忽闻啼鸟唤，忙整玉搔头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29878,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋风引","author":"蒋主孝","text":"昨夜秋风至，庭前落叶多。\n遥怜未归客，相见欲如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29879,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"少年行","author":"蒋主孝","text":"手折章台柳，眼盼梨园花。\n春风故相妒，先到阿侯家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29880,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怨词","author":"蒋主孝","text":"明月流素光，夜坐弹红桑。\n断弦弹不得，抱诉小秦郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29881,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"商妇词","author":"蒋主孝","text":"昨上九江船，今驾平原车。\n愁山复愁水，不寄一行书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29882,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寒食夜","author":"蒋主孝","text":"细柳垂秦苑，棠梨出汉宫。\n可怜寒食夜，空自怨春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29883,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春行","author":"蒋主孝","text":"江阁云笼树，溪流水泛花。\n相逢浣衣女，不敢问谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29884,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春狭词 其一","author":"蒋主孝","text":"斗鸡走犬出长楸，挟弹弯弓报宿雠。\n昨日相逢李都尉，百花丛里擘箜篌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29885,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]