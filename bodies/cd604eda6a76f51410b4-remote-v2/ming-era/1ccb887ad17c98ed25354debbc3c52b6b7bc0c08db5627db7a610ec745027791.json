[{"title":"拟吴宫行乐词五首并序 其五","author":"邓云霄","text":"茂苑花，阊门柳。\n万石钟，千日酒。\n醉杀吴儿小垂手。\n采莲夜渡消夏湾，鱼龙听曲沧波间。\n谁解浣纱裁白纻，岁岁年年呈妙舞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伤吴宫绝句","author":"邓云霄","text":"馆娃宫畔暮烟迷，响屟廊中返照西。\n莫话吴王当日事，恐惊寒鸟一时啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟竹枝词四首 其一","author":"邓云霄","text":"溪女蓬鬟日召负，担头十指尚纤纤。\n路逢年少轻调笑，连袂清歌望酒帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟竹枝词四首 其二","author":"邓云霄","text":"狂夫一去动经秋，日日祈神锦水头。\n每下鸣机逢七夕，几回肠断为牵牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23974,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟竹枝词四首 其三","author":"邓云霄","text":"剑阁连云欲插天，人心险恶更堪怜。\n凭君寄谢临邛女，又被风吹过别弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟竹枝词四首 其四","author":"邓云霄","text":"薛涛坟畔尽桃花，犹忆新笺锦作霞。\n云雨竟随巫峡散，空余明月落谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋山","author":"邓云霄","text":"秋山丛桂暗松门，黄菊西风酒一尊。\n莫问闲房幽径里，向来离合敢重论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"斋居","author":"邓云霄","text":"休沐缘多病，西园春雨馀。\n戒荤扶药饵，列菹当鲑鱼。\n喧杂非吾性，清羸合道书。\n真成香案吏，已伴玉皇居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塘上行","author":"邓云霄","text":"水落银塘净，芙蕖飒已秋。\n可怜枯叶上，乃有绿龟游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵岩琴台畔松径遇吴师因赠","author":"邓云霄","text":"琴台出石径，三月松花黄。\n好风从东来，散落皆天香。\n野老行茯苓，白石煮琼浆。\n扫花春酿熟，醉饱能休粮。\n萝薜洞门古，闭关春昼长。\n谁知灵岩畔，已到蓬山乡。\n野老竟为谁，恐是汉张良。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴门七夕三首 其一","author":"邓云霄","text":"银汉轻波漾月华，桥边灵鹊护鸾车。\n未知天上情多少，秋思人间遍万家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴门七夕三首 其二","author":"邓云霄","text":"吴门巧女世应稀，看罢双星更上机。\n绣出鸳鸯宫锦灿，为他人作嫁装衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴门七夕三首 其三","author":"邓云霄","text":"楼头乞巧夜将阑，五彩朱丝落玉盘。\n不见倡家金屈膝，何曾身傍绣床看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归兴七首并序 其一","author":"邓云霄","text":"懒性宜高枕，途危畏及秋。\n非无溟北翼，自薄陇西游。\n葛令求丹药，江生笑黑头。\n凭谁解馀意，试一问沙鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归兴七首并序 其二","author":"邓云霄","text":"尘容聊一洗，发垢正新梳。\n药里开蛛网，芸编走蠹鱼。\n调希弦可解，意到竹堪书。\n寄谢劳劳客，无烦问索居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归兴七首并序 其三","author":"邓云霄","text":"岂避弓蛇影，生憎凫胫添。\n闲看稚子戏，未怪老夫潜。\n粳稻馀三釜，蚕桑具一缣。\n谁云吏情淡，盘有水晶盐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归兴七首并序 其四","author":"邓云霄","text":"微禄不果腹，浮生堪息机。\n空囊吾已惯，丛桂旧相依。\n失路行偏远，回头未觉非。\n秋风病百草，正长北山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归兴七首并序 其五","author":"邓云霄","text":"竹林真玩世，金马伪逃名。\n达士期朝彻，高人贵夜行。\n寒蝉秋自急，凉露饮逾清。\n天下滔滔是，吾将学偶耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归兴七首并序 其六","author":"邓云霄","text":"匡坐适禅心，西风入爽襟。\n归存压舟石，不用买山金。\n溟渤万千顷，罗浮四百岑。\n冷然如可禦，汗漫托知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归兴七首并序 其七","author":"邓云霄","text":"对妇品茶谱，呼儿检药经。\n一区虚白室，半亩草玄亭。\n浊酒堪埋照，东篱笑独醒。\n放歌元自解，歌竟若为听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其一","author":"邓云霄","text":"太虚干元化，圜转固无端。\n茫茫大千界，劫火或已然。\n谁持石五色，更为补皇天。\n堂上乐方宴，杞国空忧煎。\n山中抱黄犊，归去种春田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其二","author":"邓云霄","text":"索居曾几何，夏火忽改木。\n夜露凄已白，桂枝自含绿。\n幽香好暗持，不为旁人馥。\n嗟彼园中葵，逢秋不卫足。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其三","author":"邓云霄","text":"君平既弃世，犹复在市廛。\n简圭出垢石，淤土生红莲。\n观化洞无始，不为买卜钱。\n大隐正在兹，授老垂空帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其四","author":"邓云霄","text":"鲁国尽若狂，钟鼓拜爰居。\n获麟不善保，反为尼父吁。\n皇风代沦煽，大道日丘墟。\n试问道傍者，何如沮溺愚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其五","author":"邓云霄","text":"吾爱桃源洞，幽居绝世氛。\n子孙忘晋代，衣服自秦人。\n宁知镐池壁，久遗祖龙君。\n招魂长城下，不来早问津。\n愿将鸡犬去，永与麋鹿群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其六","author":"邓云霄","text":"此亦一是非，彼亦一是非。\n人具曰予圣，乌能辨雄雌。\n所以古达人，一哂皆孩之。\n遐想鸿荒前，衣服乃毛皮。\n凿窍混沌死，吾将杜德机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其七","author":"邓云霄","text":"翩翩汉飞将，射虎真空群。\n驭下闲刁斗，连营岂薄恩。\n罢来逢醉尉，不识故将军。\n梁燕兼门雀，飘如陌上尘。\n玉壶有天地，养晦以全真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其八","author":"邓云霄","text":"精卫一何愚，衔尽西山石。\n东溟波万里，力微岂能敌。\n独怜帝女灵，芳魂或重溺。\n仲尼浮海心，李叟流沙迹。\n知不可柰何，安命甘踵息。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其九","author":"邓云霄","text":"邵平瓜已熟，五色绚田畴。\n人知瓜美好，讵识东陵侯。\n地近心偏远，路旁自悠悠。\n好扫秦坑灰，为他粪垄头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":23999,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其十","author":"邓云霄","text":"静坐心无事，幽居日觉长。\n明窗与净几，扫地更焚香。\n秋色已如此，浮云怪底忙。\n吟成聊抱膝，世路付亡羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24000,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其十一","author":"邓云霄","text":"一破名利关，觉非如不及。\n设膻游蚁聚，张烛飞蛾集。\n得嗜性所便，近死乃逾疾。\n何如五彩囊，采露华山室。\n无事风尘眼，仙童坐相失。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24001,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其十二","author":"邓云霄","text":"嗷嗷誇毗子，自谓挈瓶智。\n达者笑观场，翻同傀儡戏。\n君王怒偃师，手触歌声碎。\n谁知造化心，塞翁以为识。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其十三","author":"邓云霄","text":"我登苏台上，怀古生百忧。\n霸气已沦没，草深麋鹿游。\n锦帆落天外，孤月照长洲。\n彼美五湖子，翛然不系舟。\n功成耻受爵，亮节激千秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24003,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其十四","author":"邓云霄","text":"三五明月满，二八明月缺。\n大钧忌常盈，至人贵藏哲。\n犬出东门怨，鹤向华亭咽。\n梁鸿与德耀，赁春自埋没。\n千载阜庑下，令人想遗烈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其十五","author":"邓云霄","text":"家本罗浮下，萧然木石亲。\n扶桑东不远，勾漏亦为邻。\n学道炼金骨，三山期问津。\n岁星耻被谪，强之观国宾。\n矫矫野鹤性，饮啄惭向人。\n一迷红尘眼，五别青萝春。\n缑山倘相接，归揖云中君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其十六","author":"邓云霄","text":"陶令一以醉，柳春不复知。\n谁持千日酒，为息百年机。\n蛮触国蜗角，流血斗离披。\n蚩蚩名利间，所争亦如之。\n汉阴有遗老，岁暮可同归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感遇 其十七","author":"邓云霄","text":"傲吏坐漆园，悟得逍遥理。\n想像南华仙，似假北溟翅。\n鶤鹏息六月，天地乃一指。\n觉与蝶同蘧，梦随髅共语。\n嗟余竟内累，愧彼云中志。\n胡不瓠浮江，甘同鸱嚇鼠。\n平生大侠骨，岂是折腰具。\n拊髀友鸿蒙，据梧齐惠子。\n清风入修竹，洒尽诸苦趣。\n凉露可濯缨，不借西江水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林坦之垂之兄弟上春官二首 其一","author":"邓云霄","text":"据地酣歌笑四豪，诗情酒态忆吾曹。\n坐来夜雨衙斋冷，望去春风马首高。\n白眼未清游侠骨，朱弦宁向众人操。\n燕台重价需千里，莫问囊中金错刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林坦之垂之兄弟上春官二首 其二","author":"邓云霄","text":"旅食西风几问津，丈夫行李未全贫。\n怀来白壁聊披褐，袖有苍精岂傍人。\n痛饮且歌燕市筑，振衣休染洛京尘。\n安危异日须吾辈，折得名花不当春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夕闺怨二首 其一","author":"邓云霄","text":"永夜西风减带围，凉回谁为寄征衣。\n楼前泪迸双星落，客子蓬随一叶飞。\n袖里有书裁锦字，梦中无路到金微。\n平生幸未偷灵药，斜月何心入绛帏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24010,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夕闺怨二首 其二","author":"邓云霄","text":"露浸重帘知夜长，啼残银烛吊寒螀。\n坐深错认身为石，愁绝翻惊雨变旸。\n鸿雁天边音更杳，蘼芜山下径全荒。\n木兰誓欲从军去，不信军中气不扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24011,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偕常熟赵明府游惠山秦氏园 其一","author":"邓云霄","text":"禦去风泠泠，长廊次竹亭。\n云晴还复湿，泉酌更宜听。\n池上论茶谱，林间检鹤经。\n几年尘土梦，今日始全醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24012,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偕常熟赵明府游惠山秦氏园 其二","author":"邓云霄","text":"山灵邀上客，鸡犬类秦馀。\n洞里忘年月，人间笑簿书。\n清谈容谷答，梵呗度松虚。\n坐对沧波叟，持竿不取鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24013,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"静女诗","author":"邓云霄","text":"静女心如水，空闺淡岁华。\n晚来惟倚竹，春尽不看花。\n芳草连淇上，游人隘若耶。\n良媒元有待，耻问宋西家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24014,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋思","author":"邓云霄","text":"昨夜西池玉露清，红妆临水若为情。\n莫言秋尽芙蓉老，犹可萧萧作雨声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24015,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观刈示村中父老","author":"邓云霄","text":"田家十月竞场工，杼柚东南幸岁丰。\n片片霜镰桑柘外，村村云碓水烟中。\n黄鸡紫蟹宜新酒，伐鼓行歌拥醉翁。\n寄语吴侬莫狼戾，好将淳俭学豳风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24016,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上吟 其一","author":"邓云霄","text":"坐对蒹葭晚，遥悲水国秋。\n鱼书长不达，江上怨阳侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24017,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上吟 其二","author":"邓云霄","text":"宝雁带星霜，南来关塞长。\n杜兰零落甚，客意属沅湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上吟 其三","author":"邓云霄","text":"南天云水阔，秋望杳无端。\n谁道新霜冷，能烧枫树丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孙建侯邀饮观韩湘子传奇席上赋时","author":"邓云霄","text":"啸有孙登响凤鸾，更携秋色入琼筵。\n歌回暗觉梁尘起，星聚应占剑气连。\n风急黄花催短鬓，夜长青女下遥天。\n挥杯莫讶逡巡酒，葛令元来号稚川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜","author":"邓云霄","text":"锁印远钟歇，钩帘新月起。\n欲知吏隐心，铜瓶贮清水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日孙建侯贻诗讯余病兼约登高赋此之二首 其一","author":"邓云霄","text":"久宦逢秋懒，多愁与病兼。\n高斋闻捣药，半月食无盐。\n忍负龙山会，因耽鹤萝恬。\n新诗如七发，傲骨若为砭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日孙建侯贻诗讯余病兼约登高赋此之二首 其二","author":"邓云霄","text":"宿业应难忏，禅宗试一参。\n舄传飞阙北，人尚滞周南。\n吾破三生界，方知七不堪。\n东篱聊徙倚，犹忆菊花潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"避署小憩","author":"邓云霄","text":"沐发西园里，闲持贝叶书。\n地幽能却扇，心远似悬车。\n赤日焰偏赫，高云迥自如。\n回溪饶美竹，风至忆吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕二首 其一","author":"邓云霄","text":"今夕是何夕，开尊不厌频。\n乾坤翻阅世，儿女暗催人。\n守岁更声尽，迎年乐事新。\n谁持树柏酒，一寄岭梅春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕二首 其二","author":"邓云霄","text":"黯黯灯前语，愁来发浩歌。\n河清不待我，日落几挥戈。\n任路嗟薪积，劳生信隙过。\n丹砂灵洞閟，归思绕云萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食虎丘","author":"邓云霄","text":"正喜宦无能，春山试一登。\n野村皆禁火，此地独传灯。\n空谷闻幽鸟，流云傍定僧。\n晚归休待月，人已踏金绳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后上方寺","author":"邓云霄","text":"客驾长虹至，龙归古洞春。\n山门新霁雨，石路净纤尘。\n得句先呈佛，长歌不属人。\n所嗟山下径，来往入迷津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人有饷余潇湘八景画册者退食之暇逐景分题空同子先有此作余其为妇乎加七言以别之 其一 渔村夕照","author":"邓云霄","text":"晒网柴门返照新，桃花流水认前津。\n买鱼沽酒湘江去，远吊怀沙作赋人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人有饷余潇湘八景画册者退食之暇逐景分题空同子先有此作余其为妇乎加七言以别之 其二 山寺晚钟","author":"邓云霄","text":"绝顶高僧未易逢，禅床长被白云封。\n残钟已罢寥天远，锡杖时过紫盖峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人有饷余潇湘八景画册者退食之暇逐景分题空同子先有此作余其为妇乎加七言以别之 其三 平沙落雁","author":"邓云霄","text":"阵断衡阳暂此回，沙明水碧岸莓苔。\n相呼正喜无缯缴，又被孤城画角催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人有饷余潇湘八景画册者退食之暇逐景分题空同子先有此作余其为妇乎加七言以别之 其四 江天暮雪","author":"邓云霄","text":"蓑笠无踪失钓船，同云黯淡混江天。\n湘妃独对君山老，镜里修眉已皓然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人有饷余潇湘八景画册者退食之暇逐景分题空同子先有此作余其为妇乎加七言以别之 其五 潇湘夜雨","author":"邓云霄","text":"大王长啸起雄风，又逐行云入梦中。\n想像阳台环佩湿，令人肠断楚天东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人有饷余潇湘八景画册者退食之暇逐景分题空同子先有此作余其为妇乎加七言以别之 其六 洞庭秋月","author":"邓云霄","text":"李白曾称月下仙，烟波秋醉洞庭船。\n我来更欲骑黄鹤，直向高楼一醉眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人有饷余潇湘八景画册者退食之暇逐景分题空同子先有此作余其为妇乎加七言以别之 其七 远浦归帆","author":"邓云霄","text":"汉江游女石榴裙，一道菱歌两岸闻。\n估客归帆休怅望，闺中红粉正思君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人有饷余潇湘八景画册者退食之暇逐景分题空同子先有此作余其为妇乎加七言以别之 其八 山市晴岚","author":"邓云霄","text":"乱峰空翠晴还湿，山市岚昏近觉遥。\n正值微寒堪索醉，酒旗从此不须招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为刘恒甫年兄悼亡","author":"邓云霄","text":"客子悲秋已惘然，那堪更著悼亡篇。\n独怜窃药人犹在，颇恨鸿都术未传。\n归梦夜悬巫峡雨，孤鸿声断太湖天。\n素琴已悟无弦意，慢取鸾胶与续弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为张孟奇悼亡","author":"邓云霄","text":"怜君犹在四愁中，泪浇新秋一叶风。\n神女云妆珠佩寂，画眉人老锦屏空。\n鹊分金镜桥先断，星隔银河水未通。\n谁解招魂如宋玉，江南哀怨结青枫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]