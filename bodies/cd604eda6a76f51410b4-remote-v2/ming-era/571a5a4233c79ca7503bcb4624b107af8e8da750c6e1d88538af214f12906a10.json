.csv","pointer":50899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠金相士 其一","author":"祁顺","text":"妙相通神自古难，按图求骏总誇漫。\n孙阳解识千金骨，不向骊黄色上看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠金相士 其二","author":"祁顺","text":"身外荣枯尽是虚，懒将前定问何如。\n假饶卿相生来贵，未信初年不读书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柳上山凫","author":"祁顺","text":"野塘春水绿生漪，云淡风轻白昼迟。\n山鸟也怜幽绝景，数声啼上绿杨枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝啼鸟","author":"祁顺","text":"嶰谷风来玉韵清，一双幽鸟日和鸣。\n不须别借伦伶手，自有天然律吕声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云林图为杨地官题","author":"祁顺","text":"草堂萧洒对遥岑，松竹阴阴翠作林。\n行客不知归路晚，杖藜冲破白云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈佥宪梦祥考绩还江西绝句二首 其一","author":"祁顺","text":"两袖炉烟出禁庭，半囊行李耀青萍。\n西江民物知何限，引领京华望福星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈佥宪梦祥考绩还江西绝句二首 其二","author":"祁顺","text":"同乡情谊夙相亲，尊酒临岐语更真。\n懒把词章誇德政，使君非是为名人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊济宁","author":"祁顺","text":"烟水沧凉夜气清，砧声断续出高城。\n客边觞咏凭谁共，太白楼头空月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和林克全韵三首 其一","author":"祁顺","text":"江上凉风日透衣，窗前孤月夜流辉。\n京华故旧应相念，过却重阳人未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和林克全韵三首 其二","author":"祁顺","text":"南国佳人夜捣衣，残砧声里减容辉。\n客怀听此堪惆怅，家在都城频梦归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和林克全韵三首 其三","author":"祁顺","text":"霜风催急箧无衣，恋阙频瞻日月辉。\n同是别离君更切，登山临水送将归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李汉章由边功升俸赠以口号","author":"祁顺","text":"郎官新受大夫封，又喜荣加俸级崇。\n边塞勤劳才两载，绝胜民部十年功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻原籍新居落成寄舍弟思正十首 其一","author":"祁顺","text":"萧洒园林屋数间，小桥流水玉弯环。\n百年生计经营就，应助而兄早养闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻原籍新居落成寄舍弟思正十首 其二","author":"祁顺","text":"草堂临水不生尘，花木成林总是春。\n遥想潘舆周览处，举头常念未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖中即景二首 其一","author":"祁顺","text":"江水微茫浸小姑，庐山重叠压鄱湖。\n风帆远近天高阔，共作人间一画图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖中即景二首 其二","author":"祁顺","text":"阴云送雨日漫漫，云锦屏风不易看。\n今日乍晴看最好，万般奇态蔼林峦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安庆得风","author":"祁顺","text":"数日候风风不来，今朝江上蒲帆开。\n推蓬一笑楚天碧，五老相见高崔嵬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"廉泉亭","author":"祁顺","text":"山下流泉自古清，百年华构几经营。\n时人谩把廉名道，此水由来不为名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"麦将军墓","author":"祁顺","text":"事去人亡冢独存