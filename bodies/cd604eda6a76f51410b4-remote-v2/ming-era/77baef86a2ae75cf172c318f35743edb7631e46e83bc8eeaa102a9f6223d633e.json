[{"title":"晚晴远眺","author":"高启","text":"楚天无物不堪诗，登眺唯愁动远思。\n秋树江山人别后，夕阳楼阁雨晴时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16773,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄徐记室","author":"高启","text":"惆怅江东日暮云，我来君去苦离群。\n不知此日君思我，还似当时我忆君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16774,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄家书","author":"高启","text":"底事乡书累日修，路长唯恐有沉浮。\n还忧得到家添忆，不敢多言客里愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16775,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻人唱吴歌","author":"高启","text":"楚人不解听吴歌，我独灯前感慨多。\n记得通波亭下路，画船归去雨鸣荷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16776,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中过山","author":"高启","text":"春云晻霭涧奔浑，风雨行人过一村。\n不似家山深竹里，乳鸠啼午未开门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16777,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画","author":"高启","text":"落日青山影在沙，镜湖波净过荷花。\n云间树底参差屋，借问谁家是贺家？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16778,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"得故人书知未入京因寄","author":"高启","text":"曾约春深到凤台，君今不到只书来。\n满椷离恨床头放，一度相思一展开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16779,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题王翰林所藏画兰","author":"高启","text":"春到怀王旧渚宫，沙棠舟去水烟空。\n孤丛不有幽香发，应没江边百草中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16780,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"不见花","author":"高启","text":"看花无计作闲身，尘土余杭暗度春。\n不见花开莫惆怅，花飞还得免愁人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16781,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寒食逢杜贤良饮","author":"高启","text":"杨柳无烟江水长，邻家风雨杏饧香。\n逢君共把金陵酒，忙却今朝在异乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16782,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"风雨早朝","author":"高启","text":"漏屋鸡鸣起湿烟，蹇驴难借强朝天。\n却思春水江南岸，闲听篷声卧钓船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16783,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读韦苏州诗","author":"高启","text":"扫阁焚香昼卷帷，绿槐疏雨夏初时。\n客忧何物能消遣，一帙苏州刺史诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16784,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚过青溪","author":"高启","text":"王谢池台两岸空，水禽争哢夕阳中。\n丽华妖血流难尽，化作荷花别样红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16785,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄荃子母兔","author":"高启","text":"阳坡日暖眼迷离，芳草春眠对两儿。\n谁道姮娥曾作伴，广寒孤宿已多时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16786,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西园即事","author":"高启","text":"绿池芳草满晴波，春色都从雨里过。\n知是邻家花落尽，菜畦今日蝶来多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16787,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴别驾宅闻老妓陈氏歌","author":"高启","text":"白发相邀出后厅，莫辞为唱《雨霖铃》。\n如今人尽怜年少，谁肯同来特地听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16788,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出郭舟行避雨树下","author":"高启","text":"一片春云雨满川，渔蓑欲借苦无缘。\n多情水庙门前柳，遮我孤舟半日眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16789,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"己亥初度（时年三十四）","author":"高启","text":"风雨空斋诵蓼莪，今年初度客中过。\n人生七十寻常寿，未过还怜一半多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16790,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"二乔观兵书图","author":"高启","text":"共凭花几倚新妆，玉女《阴符》读几行。\n铜雀那能锁春色，解将奇策教周郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16791,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"期袁卿见过因出失值寄诗谢之","author":"高启","text":"非关远出负幽期，自是江边枉棹迟。\n谁道空回君恨切，未应如我到家时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16792,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿蟾公房","author":"高启","text":"一禽不鸣深树烟，明月下照高僧禅。\n独开西阁咏清夜，秋河欲堕山苍然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16793,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陌上见梅","author":"高启","text":"陌头一树带风沙，零落寒香日欲斜。\n车马纷纷谁暇看，当年只合种山家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16794,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东归至枫桥","author":"高启","text":"故人当日送登畿，此地停舟醉落晖。\n惭愧临河旧攀柳，尚留青眼看人归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16795,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江行","author":"高启","text":"家家渔网映回桥，春水初生没树腰。\n客路江南烟雨里，绿芜芳草恨迢迢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16796,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戏和徐七见寄卧闻邻槽酒声之作","author":"高启","text":"春泻邻槽入夜闻，远疑泉响隔松云。\n题诗为问醒眠客，几滴还能醉得君？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16797,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"见燕至","author":"高启","text":"初来如报社前春，好宿茅檐伴客身。\n莫入江南旧庭院，杏花风雨总无人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16798,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对梨花","author":"高启","text":"素香寂寞野亭空，不似秋千院落中。\n卧对一枝愁病酒，清明今日雨兼风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16799,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和杨余诸君在谪中忆往年西园听歌","author":"高启","text":"花落名园罢醉游，故人无复旧风流。\n吴乡莫叹无歌听，若使闻歌意更愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16800,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重过南寺寻悟公不值","author":"高启","text":"我是钧天梦觉人，忆来松下是前身。\n老僧何去袈裟在，落叶斜阳满室尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16801,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏夏冰","author":"高启","text":"寒收疑冻井，晚荐纳凉宫。\n抱洁存天质，销炎夺化工。\n气蒸金碗润，色映玉盘空。\n弱藻含犹在，纤尘隔未通。\n非山宁可倚，是水复当融。\n照夜何须月，惊秋讵待风。\n制屏应不隐，作佩定难攻。\n客貌清谁并，仙肌莹自同。\n宜涵筠簟素，愁逼桂炉红。\n愿解行人暍，分贻道路中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16802,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得履送衍上人","author":"高启","text":"稳称游方脚，新编楚岸蒲。\n滑欺峰顶石，危怯世间途。\n轻曳愁妨蚁，高飞笑化凫。\n上堂声每众，度岭影还孤。\n著处朝行道，抛时夜结趺。\n空山欲相访，落叶去踪无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16803,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"效唐人赠边将","author":"高启","text":"翩翩越骑将，负勇出山西。\n射虏夸猿臂，封侯赌马蹄。\n候烽河外暗，伏帜草中低。\n欲雪凭陵耻，须禽左谷蠡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16804,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送董湖州","author":"高启","text":"五马贵专城，花兼赤绶明。\n政条民乍识，赋籍吏初呈。\n山笼输茶至，溪船摘芰行。\n非将茗霅水，谁比使君清？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16805,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚次西陵馆","author":"高启","text":"匹马倦嘶风，萧萧逐转蓬。\n地经兵乱后，岁尽客愁中。\n晚渡随潮急，寒山旧驿空。\n可怜今夜月，相照宿江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16806,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送顾别驾之边郡","author":"高启","text":"故人虽尽别，相去独君赊。\n缘路云千堠，临边树一家。\n渡江船载马，到馆烛惊鸦。\n莫叹孤城废，春来尚有花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16807,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送僧恬归灵隐","author":"高启","text":"游方应未久，柳色变新年。\n在路逢春雪，还山访冷泉。\n钟催投寺锡，灯照泊江船。\n法意休多问，无言即是禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16808,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上寄王校书行","author":"高启","text":"寥落旧欢违，江边独掩扉。\n邻家闻暮笛，客舍试春衣。\n宿鸟归山乱，行人渡水稀。\n相思比花絮，斜日绕城飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16809,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送越将罢镇","author":"高启","text":"楚客佩吴鸿，临边最有功。\n读书围壁里，赌酒射堂中。\n旆出莎城雨，笳吹柳浦风。\n越人相感意，应与暮潮东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16810,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王稹赴大都（至正庚子作）","author":"高启","text":"王郎歌莫哀，且酌姑苏台。\n独客自伤别，诸侯谁爱才。\n关河千里去，宫阙五门开。\n未肯轻齐虏，新从下土来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16811,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送孙主簿之德清孙善琴","author":"高启","text":"山水匝秋城，君行思已清。\n道逢迎吏拜，田杂戍人耕。\n地远知边信，家贫称县名。\n应携一琴去，相和长官鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16812,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留别李侯","author":"高启","text":"梅发津亭壮，春随使节回。\n线多游子服，酒滴故人杯。\n钟送横江雨，车盘出峡雷。\n平生感知己，临别更徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16813,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄熹公","author":"高启","text":"禅居紫阁阴，欲去问安心。\n野岸随流曲，山门隐树深。\n千灯燃雨塔，一磬出风林。\n想见跏趺处，云多不可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16814,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王才归钱塘","author":"高启","text":"南归犹落魄，北上已蹉跎。\n草草官亭酒，劳劳客路歌。\n亲知今日少，山水故乡多。\n匕首空留在，酬恩竟若何？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16815,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送长洲周丞升吴县令","author":"高启","text":"青山隔苑桥，改邑去非遥。\n官食新添俸，民传旧布条。\n稻花迎午放，荷叶待秋凋。\n寂寞长洲路，空闻五瑀谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16816,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬至夜喜逢徐七","author":"高启","text":"君来同客馆，把酒夜相看。\n动是经年别，能辞尽夕欢。\n雪明窗促曙，阳复座销寒。\n世路今如此，悬知后会难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16817,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送史丞之海门史淮东人","author":"高启","text":"黄茅连雾雨，此地久荒凉。\n月出嵎夷迩，江通渤澥长。\n改官非谪宦，到邑是还乡。\n海上遥闻说，归人已裹粮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16818,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜访芑蟾二释子因宿西涧听琴","author":"高启","text":"清夜独幽寻，岩扉落叶深。\n许携陶令酒，来听颖师琴。\n人醉月沉阁，乌啼风满林。\n应留西涧水，千载写余音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16819,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"钱塘送马使君之吴中","author":"高启","text":"樟亭离席散，遥发画幡车。\n飞雉新阡麦，啼莺故苑花。\n望山登郡阁，行水到田家。\n莫道凝香句，前人独可夸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16820,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与刘将军杜文学晚登西城","author":"高启","text":"木落悲南国，城高见北辰。\n飘零犹有客，经济岂无人。\n鸟过风生翼，龙归雨在鳞。\n相期俱努力，天地正烽尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16821,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和周山人见寄寒夜客怀之作","author":"高启","text":"乱世难为客，流年易作翁。\n百忧寻岁暮，孤梦怯山空。\n门掩云峰里，灯明雪竹中。\n无因乘夜访，相慰一尊同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16822,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭临川公","author":"高启","text":"身用已时危，衰残况病欺。\n竟成黄犬叹，莫逐白鸥期。\n东阁图书散，西园草露垂。\n无因奠江上，应负十年知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16823,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"草堂夜集","author":"高启","text":"山家具鸡黍，夜与故人期。\n暂喜逢欢会，都忘在乱离。\n火寒移坐密，烛尽得诗迟。\n莫听高城角，明朝别又悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16824,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过胡博士郊居胡善筮","author":"高启","text":"头白兰陵客，幽居共一村。\n老来吟力退，贫去告身存。\n夕吹鸣梨叶，秋泉注稻根。\n时因来问筮，独叩树间门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16825,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送茅侯","author":"高启","text":"欲知难别意，孤棹去还停。\n候吏分遥迩，离人杂醉醒。\n城临秋水渡，树带夕阳亭。\n后夜看吟烛，怜君宿郡厅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16826,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孤雁","author":"高启","text":"衡阳初失伴，归路远飞单。\n度陇将书怯，排空作阵难。\n呼群云外急，吊影月中残。\n不共凫鸑宿，蒹葭夜夜寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16827,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓步园池","author":"高启","text":"发随秋叶落，心共晓云舒。\n稍改新题句，浑忘旧读书。\n林争移树鸟，池响食萍鱼。\n无限悠然意，凉天独步余。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16828,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵过建平县","author":"高启","text":"县虽三户小，地僻罢兵防。\n茶市逢山客，枫祠祭石郎。\n云埋鸣涧斧，沙胶度溪航。\n应爱青山好，经过驻旅装。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16829,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送胡铉游会稽","author":"高启","text":"山水独行遍，苕溪仍剡溪。\n衣逢新火减，舟度杂花迷。\n黄绢寻碑读，红裙赌墅携。\n清游不能共，肠断听猿啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16830,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月夜游太湖","author":"高启","text":"欲寻林屋隐，还过洞庭游。\n远水初涵夜，长天尽作秋。\n湖如青草阔，月似白莲浮。\n万壑风传笛，三更斗挂舟。\n叶应随鸟散，山欲趁波流。\n浩荡吾何适，鸱夷不可求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16831,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈则","author":"高启","text":"挟策去谁亲，侯门不礼宾。\n愁边长夜雨，梦里少年春。\n树引离乡路，花骄失意人。\n一杯歌短调，相送欲沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16832,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春送陈郎中出守醉李","author":"高启","text":"出幕方为郡，行车动画轮。\n图书归省吏，风俗问州人。\n塘水龙鳞细，城槐兔目新。\n莫言花已尽，君到自阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16833,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送杨从事从军","author":"高启","text":"南风薰燕麦，送子怅如何。\n迢递戎车役，凄凉横笛歌。\n天笼平野迥，山绕古关多。\n莫笑书生怯，能当曳落河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16834,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王员外迁崇教（崇教典僧官）","author":"高启","text":"能书晋公子，清宦称高情。\n海树朝帆远，江风夏服轻。\n官从三省去，僧出万山迎。\n谁说簪缨累，名林得按行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16835,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴中送顾生归海陵","author":"高启","text":"凉风初变柳，归兴片帆孤。\n家向三秋到，田经几岁芜。\n旧音犹带楚，新梦未离吴。\n明日江南北，相思有雁无？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16836,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"园中","author":"高启","text":"席暖林中憩，衣凉水上归。\n腐瓜虫食遍，空树鹤巢稀。\n邂逅幽寻得，参差薄愿违。\n喜无来往者，秋草没园扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16837,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"城西客舍送周著作砥","author":"高启","text":"客中寒食后，惆怅送君违。\n花隐归城旆，风吹渡水衣。\n夜窗炊黍散，春苑斗茶稀。\n谁念西斋雨，相思独掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16838,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"兵后出郭","author":"高启","text":"俯仰兴亡异，青山落照中。\n民归邻树在，兵去垒烟空。\n城角犹悲奏，江帆始远通。\n昔年荆棘露，又满阖闾宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16839,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张羽后夜坐西斋","author":"高启","text":"闲斋听钟坐，忧绪怅多端。\n鸣雁雨中急，离人江上寒。\n秋灯下木叶，夜艇隔风湍。\n别后情萧索，方知旧会欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16840,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐山人别墅","author":"高启","text":"茶香孤墅发，竹色四邻分。\n扫地侵虫字，开窗散鸟群。\n树凉池过雨，苔润石生云。\n我出无车马，偏宜访隐君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16841,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"客馆秋怀","author":"高启","text":"独卧愁空馆，墙阴野豆开。\n暑将潮气敛，秋与竹声来。\n身贱多违志，时清少弃材。\n惭非张仲蔚，门户有蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16842,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜宿周记室草堂送王才","author":"高启","text":"相别还相恋，秋宵暂对床。\n人情贫后见，客况醉中忘。\n池柳疏含吹，江云薄护霜。\n离舟待明发，愁思剧茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16843,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上雨","author":"高启","text":"冥冥众树昏，浩浩一江浑。\n急有回风韵，轻无入雾痕。\n鸟啼丛竹岭，人卧落花村。\n门巷春泥滑，谁来共酒尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16844,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送贾二进士归省","author":"高启","text":"年少擅词华，曾看手八叉。\n晨装归路雨，春酒别筵花。\n马带云过岭，人同燕到家。\n罢官趋觐好，不是谪长沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16845,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]