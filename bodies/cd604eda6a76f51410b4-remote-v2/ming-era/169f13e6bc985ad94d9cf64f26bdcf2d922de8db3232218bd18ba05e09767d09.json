[{"title":"解即觉寺事欲处以侍寮栖贤人至始知其行乞江北感而怀之作诗四首 其二","author":"释函是","text":"汝志堪谁副，予心独汝知。\n爱人徒自苦，遇事但成痴。\n不可为啼笑，宁当问信疑。\n归程须早计，莫畏晚风吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"解即觉寺事欲处以侍寮栖贤人至始知其行乞江北感而怀之作诗四首 其三","author":"释函是","text":"近有调心法，随缘一味憨。\n肝肠惟自笑，面目向人惭。\n夏雨将秋气，朝云起暮庵。\n斯文还后死，荣落不成谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"解即觉寺事欲处以侍寮栖贤人至始知其行乞江北感而怀之作诗四首 其四","author":"释函是","text":"世人心似面，岂敢爱长生。\n苦乐一身尽，悲欢百岁成。\n澄潭难见底，孤鹤不堪鸣。\n以此怀渔父，乘槎何处轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送渐侍者","author":"释函是","text":"难为慈母道，养子自应知。\n信伏丛疑日，瞋多在喜时。\n去惊秋陇早，归讶雪堂迟。\n风雨百年暂，寒山影未移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自慰","author":"释函是","text":"不到伤心处，谁当便尔休。\n嬴来方寸暇，放去百千愁。\n鹤颈终难短，凫胫未易修。\n愿从今日往，高举白云头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙申冬日来机奉母南归","author":"释函是","text":"同生惟有汝，远俗得予心。\n奉母三千里，侨居最上岑。\n随缘归岭表，重别立庭阴。\n此去应无憾，庐山面目深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43974,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"因老母南还寄酬王说作","author":"释函是","text":"佳诗劳远锡，又是一年馀。\n无意为疏节，行人落报书。\n故园应不改，深谷已成居。\n幸自归慈氏，知君待敝庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁怀阿字","author":"释函是","text":"塞雁几时发，羁人来未曾。\n归期看已过，计日尚相应。\n年迈悲穷子，薪传愧五灯。\n举头唯见月，何以慰山僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶成","author":"释函是","text":"但见寒暄易，不知何所为。\n海潮两度至，涧瀑四时垂。\n独立看云变，閒行任路岐。\n吾衰矜道贵，顿起远人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮示诸子","author":"释函是","text":"岁暮归人少，年高去日多。\n时违成荏苒，缘在莫蹉跎。\n此道非难易，论功费琢磨。\n法庭伤晚近，相对意婆和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼无方二首 其一","author":"释函是","text":"归山将一岁，哭子畏心伤。\n因悼袁高老，重添泪数行。\n死生真电火，来去怯冰汤。\n濒海无人处，春蛙聒夜塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼无方二首 其二","author":"释函是","text":"一上金仙殿，常思作殿人。\n香台频咒愿，愿汝记前身。\n海鸟千波影，山花隔岁春。\n论因无苦系，当不重迷津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻阿字还栖贤有怀","author":"释函是","text":"豫章游客至，云已返庐山。\n沙漠方辞苦，云林知就閒。\n玉渊新瀑水，石峡旧松关。\n有兴终难已，何时到此间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旋庵四十七初度","author":"释函是","text":"汝年四十七，今日是生辰。\n自托应无地，因人亦厌贫。\n一山松柏密，百口稻粱辛。\n古道知难和，同谁与认真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祝本师空老人六十初度二首 其一","author":"释函是","text":"薰风动寰海，慈日满高林。\n道在人天重，机停岁月深。\n千年松鹤骨，万壑水云心。\n赖有群生愿，罗浮花气森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祝本师空老人六十初度二首 其二","author":"释函是","text":"未遂西山志，难忘尘刹恩。\n大悲劳父母，得力愧儿孙。\n庚子春风正，珊瑚海日温。\n愿同龙象祝，岁岁法庭尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻云南报因酬汪居士是日海幢老人六十初度澹归侍坐","author":"释函是","text":"十载汪居士，相看各皓然。\n见闻成异代，悲喜但随缘。\n幸有吾师在，还生子弟怜。\n入河归寿海，吾道至今传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛丑闻雁","author":"释函是","text":"塞雁何时至，今秋不欲闻。\n天高江水渺，地阔岭云分。\n澹影寒塘静，疏林落叶纷。\n一声随泪下，缭乱不成云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀石鉴姜山","author":"释函是","text":"发棹已一月，行程计二千。\n螺川接风日，匡埠望林泉。\n幽谷危楼隐，深溪古木悬。\n三杯招隐下，怀我石梁边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀足两","author":"释函是","text":"带雨请经去，扬帆不问程。\n愿归三峡寺，知返九江城。\n霜叶留山色，风林隐涧声。\n冷情宜绝壑，吟咏寄生平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遣云中视睹者灵","author":"释函是","text":"一茗将灵几，遥空愧老憨。\n春风寒古殿，蜡炬暗新龛。\n已尽生前句，难为身后谈。\n大云烟雨旧，山鸟自諵諵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送祖印之庐山","author":"释函是","text":"匡山不可到，到者即宜家。\n我昔曾将母，君今欲学畬。\n望湖千树里，入涧一峰斜。\n深谷喜人至，烹泉话晚霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼铁机二首 其一","author":"释函是","text":"年高见少亡，事苦心弥伤。\n人固无长在，子尤未易忘。\n森森云树密，濯濯海天长。\n试问身前后，悲歌时欲狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼铁机二首 其二","author":"释函是","text":"诚求未易达，谁度他人心。\n父母忧从昔，乾坤惨自今。\n晨参疑在列，夕步似微吟。\n此恨终予世，山高共海深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿张梦回五十一初度","author":"释函是","text":"老叟归山后，梅花作蕊时。\n闻君过学易，愧我未吟诗。\n子大家声播，名逃身累遗。\n十年岩壑梦，云水正相期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞山居十二首 其一","author":"释函是","text":"忆住庐峰寺，因人每著忙。\n十年情已淡，千指计偏长。\n竹影移新月，松声到夜床。\n閒心犹有此，吟咏自相将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞山居十二首 其二","author":"释函是","text":"日落千峰失，蝉声远树微。\n月光先见水，山气静侵衣。\n绝顶重泉下，遥空一鹤飞。\n此间谁不到，扶策独行归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞山居十二首 其三","author":"释函是","text":"久住如初到，春山雨过时。\n重云笼瘦石，枯树吐新枝。\n水满河梁没，虫藏野鸟饥。\n开门观日上，来往百情移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞山居十二首 其四","author":"释函是","text":"敛想成虚咎，抬眸见佛灯。\n钟声随叶落，日色照江澄。\n牧竖歌方出，林僧归未曾。\n绕坛方一匝，足力减乌藤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞山居十二首 其五","author":"释函是","text":"启户竟何之，行行空自知。\n三休林下径，独照岛边池。\n日落云根透，风摇竹影移。\n都因心想憩，嬴得目前机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞山居十二首 其六","author":"释函是","text":"乞食叩门出，携锄候雨晴。\n啼林山鸟悦，过竹晓风清。\n入涧知云重，分畦到月生。\n生涯予自足，辛苦一身轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43999,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞山居十二首 其七","author":"释函是","text":"万事不须计，千差只目前。\n无人长自默，有月不成眠。\n山峻星辰近，溪连草木鲜。\n看云殊未已，回望一灯悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44000,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞山居十二首 其八","author":"释函是","text":"连年频舌病，今夏喜身强。\n六十又过二，山林多夕阳。\n雨来云脚白，泉落夜风长。\n老眼难成寐，晓闻松柏香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44001,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞山居十二首 其九","author":"释函是","text":"生长蓬蒿性，居山不怕穷。\n柴门开向日，石磴步乘风。\n望远高为室，谋生蚤种桐。\n心知明月外，迢递泬寥东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞山居十二首 其十","author":"释函是","text":"老去住山好，山深逸事兼。\n懒眠青竹簟，横睇白云檐。\n茶气胜春酿，香烟透夜帘。\n幽怀成独往，微月上松尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44003,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞山居十二首 其十一","author":"释函是","text":"频年无俗梦，始觉住山深。\n月落猿啼雾，烟销鸟在林。\n半开青竹牖，一畅白云吟。\n目送江帆远，焉知世上心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹霞山居十二首 其十二","author":"释函是","text":"开门见白鹤，独立门前松。\n敛翮能无忆，凝眸虚所从。\n夜泉添过雨，新月起高峰。\n摇曳复何处，幽寻信短筇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送雪木毬侍者出主会龙","author":"释函是","text":"何曾两辜负，十载菔芦禅。\n担荷良非易，撑持聊试先。\n智眼澄湘水，悲心混市廛。\n眉须应自惜，遮莫怪天然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠姜山","author":"释函是","text":"有衲学无为，千峰随杖藜。\n负薪时见苦，种药竟亡疲。\n爱友心常拙，吟诗月每移。\n肝肠从自许，不愿世人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠角子","author":"释函是","text":"閒窗爱独坐，禅暇稍吟诗。\n与世真无涉，逢人辄解颐。\n幽栖偏得性，辛苦勉从师。\n所赖惟多病，投艰或可迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪木院主入山却赠","author":"释函是","text":"湘江成久住，数月未曾閒。\n无事难离院，因人时入山。\n落帆摇鸟外，走马出林间。\n冠盖南城近，陪欢莫上关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜陆太守孝山长斋因其生日作诗四首寄之 其一","author":"释函是","text":"山中传好信，数月已长斋。\n悟物知生事，平情近道怀。\n幅巾称弟子，梵呗响庭阶。\n更忆莲池上，刍言次第谐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44010,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜陆太守孝山长斋因其生日作诗四首寄之 其二","author":"释函是","text":"公堂宁碍道，隐几忽闻雷。\n侧耳承谁力，古人今再来。\n竹声和午磬，云影落香台。\n寂寞官斋里，居然万壑回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44011,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜陆太守孝山长斋因其生日作诗四首寄之 其三","author":"释函是","text":"谁云吾道隘，太守近能禅。\n视事经坛外，观心晓箭前。\n护生先茹澹，息讼共清缘。\n多士南州遍，弦歌钟梵边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44012,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜陆太守孝山长斋因其生日作诗四首寄之 其四","author":"释函是","text":"悲心犹及物，窒欲见初生。\n寂感于何兆，形骸空有名。\n一身从隐显，万汇托生成。\n月落秋潭夜，分明雁过声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44013,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋风二首 其一","author":"释函是","text":"飕飕不可闻，霜叶落纷纷。\n送雨归深壑，催钟度远云。\n一帆天外至，众籁枕边分。\n萧索当秋意，冷然聊赠君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44014,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋风二首 其二","author":"释函是","text":"秋草吹将尽，寒香忽送来。\n轻盈衣带下，叱吸纸窗开。\n羽客归何处，幽人独上台。\n徘徊山日落，萧瑟夜猿哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44015,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋月二首 其一","author":"释函是","text":"一片寒光彻，山河影自分。\n雁翎空里映，鹤唳镜中闻。\n藉草明衣露，盈梢湿水云。\n西风吹浪起，江色白纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44016,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋月二首 其二","author":"释函是","text":"万里光如昼，谁能别一天。\n澄江沙际迥，贾客夜深眠。\n银烛照难见，涧泉清可怜。\n捲帘看独远，浩淼欲茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44017,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋灯二首 其一","author":"释函是","text":"静夜疏林透，遥山一点微。\n风高围土屋，月落上人衣。\n不共华筵醉，如怜独策归。\n寒云千嶂合，谁与待朝晞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋灯二首 其二","author":"释函是","text":"西风月未上，明灭出秋原。\n我自暗中见，人从光里昏。\n归舟摇远浦，落叶点孤村。\n掩映前林动，夜深疑有猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋雁二首 其一","author":"释函是","text":"雪消方北迈，霜动又南征。\n生自冱寒地，曾无炎热情。\n河山今古暂，云水去来轻。\n为爱空潭影，长留秋月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋雁二首 其二","author":"释函是","text":"溪关非所计，芦苇是生涯。\n自顾寒云影，谁怜明月怀。\n一泓秋水怯，几字晓天排。\n南北空沙渚，飞鸣成独谐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"看病二首 其一","author":"释函是","text":"日日忧人病，不知余病深。\n何曾增药力，空费老婆心。\n夜月虚阶步，山钟促曙襟。\n久安生老死，犹自独沉吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"看病二首 其二","author":"释函是","text":"余心不得已，静想亦奚为。\n续命非关药，劳形只是痴。\n百年同旦夕，转盼忽支离。\n独坐空长啸，人天何太迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春晴","author":"释函是","text":"春日丽如此，云开应有时。\n落花红点径，垂柳绿成丝。\n海燕频将子，山泉已满池。\n老来閒步履，安得少年知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄端州文社诸公","author":"释函是","text":"端州有莲社，闻欲入丹山。\n思见宗雷久，方惭慧远閒。\n临风裁素札，对月待春关。\n须忆身前后，茫茫去住间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送衣石下山兼订复来","author":"释函是","text":"六十又过四，千华重授衣。\n青山不可再，白首好相依。\n梅发随流去，春来逐雁归。\n相期寒食候，垂绿半开扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得澹归稍病即愈之讯时会龙拟新搆走笔寄之","author":"释函是","text":"岌岌忧予老，劳劳爱汝贤。\n尽教身外绊，何可病相缠。\n近水还成屋，临门见泊船。\n展书欢无极，此意孰相怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月下见水仙残叶","author":"释函是","text":"寒月照残叶，花疑入月中。\n似看空有色，不见雪乘风。\n香远馀兰质，冰销湿桂松。\n莫将摇落意，孤负藐山翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杜鹃花","author":"释函是","text":"千株红照日，深浅染啼痕。\n不尽湘妃泪，难招蜀帝魂。\n芳心随野阔，春色向人论。\n莫以悲欢态，年年醉石门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望石鉴归舟不至二首 其一","author":"释函是","text":"遥闻石长老，归自栖贤堂。\n知尔风尘苦，怜予海日长。\n江深连夜雨，风逆半程樯。\n出户望春树，新晴泛夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望石鉴归舟不至二首 其二","author":"释函是","text":"眼望千峰迩，心悬一夜遥。\n山禽迷野岸，春柳暗横桥。\n夕照江河阔，风灯云树摇。\n何堪更筹量，欢会在明朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何事二首 其一","author":"释函是","text":"何事独愁绪，年高犹未閒。\n坡悬筋力少，人病药囊悭。\n薄曙先钟起，深宵后月还。\n不如闻见远，甘学二乘顽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何事二首 其二","author":"释函是","text":"何事独愁绪，劳劳空自知。\n势穷那可已，心苦欲谁为。\n学道翻成累，投閒已恨迟。\n坐看山月上，遮莫夜猿悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"已许二首 其一","author":"释函是","text":"已许老来暇，忙忙六十三。\n知从今日去，复作几年憨。\n薄劣唯堪隐，愚狂不自谙。\n晓看春又尽，竹影入澄潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"已许二首 其二","author":"释函是","text":"已许逃人世，深山愧道名。\n自甘不是佛，人乃未忘情。\n柳暗藏莺密，天高见鹤清。\n幽栖堪卒岁，何苦独营营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春晴月下与诸子散步","author":"释函是","text":"共步层峰下，新晴夜月初。\n松高人影怯，云散鸟声虚。\n倚石听泉落，迎风过竹疏。\n人生如此夕，消得几踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江涨","author":"释函是","text":"江涨因春雨，群山汇巨流。\n水禽飞上树，贾客不登舟。\n稚子争持钓，村翁忙凿沟。\n茫茫烟树合，吾自倚高楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]