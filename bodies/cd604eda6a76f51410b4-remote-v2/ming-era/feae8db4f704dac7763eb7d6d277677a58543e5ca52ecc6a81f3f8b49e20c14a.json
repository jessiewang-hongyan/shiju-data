[{"title":"岊县故城夜泊","author":"郑善夫","text":"井邑萧疏角正悲，河隍犹带旧城陴。\n大江夜气繁星动，南国秋风落木迟。\n长路且须防失足，他家未肯但餔糜。\n欃枪满眼公车少，回首东山有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19807,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日饮延平萧氏庄","author":"郑善夫","text":"省郎园林秋色深，今日何日此登临。\n回溪鱼雁各自适，细路藤竹纷交侵。\n可怜风草四方动，不废瓶罂终日斟。\n满插茱萸应佳节，时危岁华容易阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19808,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答林贞孚且嘲作西湖东道主用韵","author":"郑善夫","text":"且喜郎君骑苑马，追攀无奈暮途遥。\n柴门反锁将疏阔，物态相看坐泬㵳。\n萍水幸逢长至月，兰桡漫趁浙江潮。\n西湖载酒谁能尔，斜日空闻吹洞箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19809,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"越中","author":"郑善夫","text":"不周风动越王城，天姥峰阴冰雪生。\n黄道祲氛双阙暝，沧溟波浪一鸥轻。\n西巡未返云台仗，南顾犹烦瘴海兵。\n大事安危赖元老，小臣茹草望升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19810,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"会稽寄董太史文玉","author":"郑善夫","text":"太史东归着锦衣，白鱼青笋傍庭闱。\n十年芸阁春秋定，五月钱塘燕鹢飞。\n乘兴偶过安道宅，忧时未息汉阴机。\n小舟岁暮将行李，报尔看山到会稽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19811,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汎西崦宿光福寺","author":"郑善夫","text":"西崦山前飞白鸥，东洙江上春事休。\n已无梅花刺我眼，赖有太湖消客愁。\n独爱老僧眠水寺，为寻芳芷步汀洲。\n风尘豺虎匝江汉，西望长安生隐忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19812,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同夏赤城游国清寺","author":"郑善夫","text":"侵晓布袍沿涧入，黄蒿古殿雨濛濛。\n顿能自拄苍玉杖，便拟分眠紫极宫。\n二子空筌霾草色，五峰芳树散云容。\n春来病骨一杯足，未植莲花烟火中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19813,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大风雪投宿赤城卢氏楼","author":"郑善夫","text":"朔雪边风吹岁昏，赤城今去宿谁村。\n孤城自照烟霞色，独夜难招土木䰟。\n短世客星真落落，高楼宾榻亦言言。\n天涯儿女催归思，胜子椒花非故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19814,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题金司寇芙蓉溪草堂","author":"郑善夫","text":"绵州城东涪江北，芙蓉溪水逼高寒。\n人今未向草堂卧，花更何年驷马看。\n云锦娟娟临岁暮，白鸥款款并风湍。\n汉庭近事须君子，黄发高歌承露盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19815,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"塞上","author":"郑善夫","text":"沙黄草白云色寒，汉主追兵青海湾。\n后命连催羽林骑，前军飞度玉门关。\n南郊礼乐终难废，北狩旌旗何日还。\n李牧昔时惟自守，暮年牧马到阴山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19816,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南郊改卜陪陈司马视牲","author":"郑善夫","text":"南苑春风吹暮寒，月华光涌紫芝坛。\n上卿剑履中宵出，大祀牛羊隔岁看。\n早报简书回万乘，竟何斋沐散千官。\n圜丘想像天威切，忝列鹓行夹道观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19817,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"不见","author":"郑善夫","text":"年来不见孙明复，布褐纶巾何处山。\n长日著书元自得，早时谭剑有馀閒。\n吴门霅水风尘上，麟阁云台天地间。\n未返初衣重忆女，钓竿何日共潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19818,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天宁寺送林德绪赴武当","author":"郑善夫","text":"襄阳使君今欲东，优钵花下行相逢。\n西山爽气祗自好，秣陵羽书犹未通。\n征伐乱传车驾出，沅湘亦在风尘中。\n冯良乘马如可弃，傍尔南州桂树丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19819,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓入左掖","author":"郑善夫","text":"禁城万木下萧萧，海雾阴连金水桥。\n七庙衣裳还紫气，九重宫阙自丹霄。\n喜闻行部风云阵，转忆先皇鹓鹭朝。\n海内何人忧社稷，迩来贤士困渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19820,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬日游翠微至香山晚归更酌湖上","author":"郑善夫","text":"日暮群山生彩霞，草黄湖白见天涯。\n关河北绕皇舆壮，胡陇西连狭道斜。\n共爱楼台穿锦树，兼看凫鹜乱晴沙。\n南冠未遂沧洲计，榔叶鸥群近钓槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19821,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中游报国寺","author":"郑善夫","text":"雪里经过报国寺，燕京气候欲冬深。\n楼台近引山河色，风日初含松桧林。\n并拟散愁聊出郭，那堪痛饮益沾襟。\n南巡辂马今何处，百万貔貅行路心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19822,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南宫对雪","author":"郑善夫","text":"南宫雪深朝未稀，冰厅映日还辉辉。\n天寒野鸟湿不下，风急灵鹤今何归。\n袁安闭阁自进退，扬云著书犹是非。\n束带栖栖岂余志，数年朝士俱戎衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19823,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"人日","author":"郑善夫","text":"人日堂阶春雪飞，斋居闭门生事微。\n仙家柏叶那复有，燕市椒花仍自违。\n久病坐看时序转，倦游渐觉故人稀。\n闽山越岫堪携枝，犹向风尘缁敝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19824,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送徐登州问","author":"郑善夫","text":"尔今出守东牟国，余尚依依鹓鹭群。\n宛洛竟县高士榻，琅琊真待子虚文。\n沙门瑶草秪何日，海市珠宫空暮云。\n只恐飞帆逐仙去，蓬莱迢递不相闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19825,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"漫兴","author":"郑善夫","text":"庞公拟向鹿门隐，元亮翻为孺子谋。\n千里青山妨墨绶，几年沧海弄渔舟。\n堞楼日断风沙暮，省树天回关塞秋。\n岁晚朝班终解去，偶耕随地得岩丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19826,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠夏公谨","author":"郑善夫","text":"芳洲桂树好自攀，山人未归鹓鹭班。\n天香暗结黄金粟，岁岁飞花霄汉间。\n烟霞秪弄丘园色，风雨长过龙虎山。\n草碧淮南定忆汝，云台锦石喜人还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19827,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南归过姚氏园","author":"郑善夫","text":"云霞深护芳树村，门巷阴连流水源。\n童子青衿应宾客，丈人黄发对丘园。\n池间鸂鶒回翔好，沙上蘼芜空翠繁。\n濩落新从栗里去，问予松菊旧柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19828,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汎舟游宜兴山水将入张公洞柬杭氏兄弟","author":"郑善夫","text":"寻仙直探山水窟，脱屣何须书画船。\n远岫高云行落日，平芜大泽失炎天。\n总闻蒋诩求羊径，未分嵇康服食缘。\n翠帻平生最浩荡，来游五岳顿能便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19829,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西湖过孙山人旧隐昔曾与太初用宾月下步六桥令僧人弄笛啸歌为和回首往事黯然陈迹矣","author":"郑善夫","text":"荒迷更踏西湖路，露舄云裳空六桥。\n涕泪翻悲竹林宴，笛声月色傍中宵。\n醉歌乱诧鱼龙出，此地争传麟凤标。\n今日孤山最孤寂，梅花桂树顿萧条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19830,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"读太初浔阳歌","author":"郑善夫","text":"青春寄我浔阳曲，长路思君鹦鹉洲。\n此日江湖须远志，浮云西北有高楼。\n嵇康竟少神仙分，尚子仍牵儿女忧。\n居洛何曾定踪迹，终南渭水入乡愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19831,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访遂初宿南高峰下","author":"郑善夫","text":"天末逢秋惊客心，只看商意动高林。\n修篁细叶迎风乱，翠栝繁条傍石阴。\n江上钓缗青眼底，年来净叶碧山深。\n东归喜有王摩诘，辋口柴门许独寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19832,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登御校场下望故宫","author":"郑善夫","text":"万峰云木郁苍苍，古垒仍存阅武场。\n南渡关河双眼尽，中原风物百忧傍。\n尚传草莽开黄屋，想见龙蛇绕御床。\n往事只今俱洒泪，两阶干羽意何长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19833,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"胜果寺秋怀","author":"郑善夫","text":"山寺行逢红槿花，江南风物望中赊。\n棘云萝月同秋思，鸿雁鹙鸧亦岁华。\n多病茂陵仍去国，长贫杜曲尚无家。\n白袍黄帽从吾好，归去沧洲问钓槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19834,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜偕应天彝黄宗贤宿灵岩天柱峰大雷雨作","author":"郑善夫","text":"日落风回天柱阴，峰前云木正萧森。\n古堂衾枕秋灯净，永夜雷霆山雨深。\n漠北不闻麟凤信，海滨空寄蕨薇心。\n结庐欲拟南阳卧，抱膝长歌梁甫吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19835,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雁宕山中","author":"郑善夫","text":"丹崖侧叠窥欲颓，拊石扪萝鸟道回。\n沧海客心长自远，锦溪秋色是重来。\n灵湫水激风云湿，昧谷春生鸿雁回。\n更上南山望双阙，葱葱云气护蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19836,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢安石","author":"郑善夫","text":"江左争传谢傅风，萧条犹记薜萝丛。\n东山第宅遥相问，青海音容迥不同。\n目断中原深战伐，天回淝水失英雄。\n最怜棋墅荒芜甚，独望新亭意不穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19837,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日登钓台","author":"郑善夫","text":"富春山下严陵濑，九日风光兴不违。\n白石沧波元自好，鸣鹥飞鹜早知归。\n南阳文叔求贤远，相府侯生识面稀。\n王业帝谟俱莫问，百年江海有渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19838,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨后登天游观","author":"郑善夫","text":"幽探尚爱天游观，石磴高盘松栝林。\n鹤驭虹桥今断绝，黄冠紫屐此登临。\n千峰雨过玄冥湿，列洞云回元气深。\n便欲垂纶钓鱼石，鸬鹚立满九溪浔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19839,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜访建溪归宗岩宿听泉阁","author":"郑善夫","text":"葛巾随地留芳迹，翠壁清林把烛行。\n山接幔亭多紫气，夜来蓬阁动泉声。\n名都合有沧洲胜，冬日还知桂树荣。\n白首子真终不改，看云坐石得吾生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19840,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠林中丞","author":"郑善夫","text":"矫矫中丞三辅贤，投簪沧海意犹仙。\n高冠大带回蛮俗，绿醑黄花照暮年。\n勋业不谈延庆役，儿童唯唱太康篇。\n纷纷授简梁园客，未道枚生赋独传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19841,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岁晚入凤阳山治田","author":"郑善夫","text":"幽栖已傍凤山远，长日看云意独深。\n溔溔海涛喧永夜，冥冥萝月散青林。\n田园春近存生事，雕鹗天高寄远心。\n避地休歌饭牛曲，惊风落木岁方阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19842,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黄明甫宪副欲到湖上","author":"郑善夫","text":"江鸟江花俱眼明，乘春骢马报江行。\n闭门秪分烟霞累，抚世今看意气横。\n海上梦回陈子榻，天边树绕越王城。\n便须傍竹开三径，拄杖停云望友生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19843,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新营青野堂未就简高传二子","author":"郑善夫","text":"青野经春营白扉，竟须录事草堂赀。\n萧萧桂树鹪鹩急，淼淼茭湖鸂鶒飞。\n绝塞闭门时欲暮，小山招隐意应迟。\n遗荣秪好修奇服，蕙带云冠上素衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19844,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"读维新录","author":"郑善夫","text":"日下金鸡出绛銮，皇皇天语万方看。\n喜闻圣主兴周道，竟使苍生起谢安。\n云捧翠旂含五色，草生屈轶指群奸。\n早时抱志投簪客，独向沧溟把钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19845,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"后秋兴三首 其一","author":"郑善夫","text":"御楼春雾昼漫漫，雷压霆奔霄汉间。\n涕泪翻伤以死谏，风波谁分得生还。\n山中介子终辞爵，岭表唐卿已赐环。\n北望星河今有象，几回沧海梦朝班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19846,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"后秋兴三首 其二","author":"郑善夫","text":"江湖霄汉不相闻，独拊龙泉看斗文。\n燕雀岂知鸿鹄志，凤麟终遁羽毛群。\n闭门春事生黄叶，去国秋山长白云。\n传语元丰旧迁客，好将王道辅明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19847,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"后秋兴三首 其三","author":"郑善夫","text":"龙起襄陵汉水清，风掀云揭动神京。\n一时卿相收耆旧，万国衣冠接圣明。\n恋阙重怀和氏璧，防身惊绝楚臣缨。\n致君尧舜群公在，短褐长镵意自平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19848,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卜居怀林待用司空","author":"郑善夫","text":"卜居为爱龙山好，薜荔阴连湖上村。\n海日帆樯动书牖，天风鹅鹳到柴门。\n清时定许潜夫远，散地还知静者尊。\n闻道平生谢太傅，东山卧席未教温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19849,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日湖上怀旧游","author":"郑善夫","text":"湖上群花开未休，茅堂夐结湖水头。\n青天举目鸿雁至，白日闭阁琴书幽。\n正愁鹅鸭恼邻舍，不见亲朋经某丘。\n沧江迟暮好自去，斸云弄泉销百忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19850,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青野堂石傍植菊花冬日盛开","author":"郑善夫","text":"青野堂西湖石畔，厓菊花繁明暮年。\n乾坤正色黄如此，丘壑孤怀尔最贤。\n秪许菌芝同远地，不争桃李媚阳天。\n上林冰雪愁无赖，三径时开向日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19851,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"叶六罢戍潮阳归话湖上","author":"郑善夫","text":"尔戍潮阳相见面，经年别我草堂游。\n瓦盆棋局青林在，菊蕊鸥群旧国秋。\n莫倚口谈三尺剑，要知身是一虚舟。\n芙蓉薜荔山人服，随地相携意气投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19852,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"野兴","author":"郑善夫","text":"龙首桥南湖水北，幽居细拟辋川中。\n青霞返照流孤榻，白鸟卑栖并一丛。\n弄筏取鲂随稚子，接觞争席任邻翁。\n年来混迹渔樵下，剩有铜鞮伯氏风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19853,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻执之侍御赴阙追送不及","author":"郑善夫","text":"名岩拟共花时见，渺渺芝田空复情。\n绣斧春当霄汉立，彩帆今傍斗牛行。\n南州烟水还徐稚，京洛风云逐马卿。\n日暮沧江相失后，可无献纳慰平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19854,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答黄应期太常","author":"郑善夫","text":"闻君未罢沧溟钓，余复归耕绵上田。\n江东落日淹多梦，燕市残杯空昔贤。\n怅别喜承县榻问，离群那寄卜居篇。\n越城西望无千里，乘兴还回何处船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19855,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答方思道","author":"郑善夫","text":"菖蒲龛下东林宴，当日招携意未疏。\n羡汝能骑陇雪马，嗟余真钓武溪鱼。\n药栏芝榻三年别，蓟野邢阳万里书。\n重沐清辞报丛竹，茂陵端遣卧相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19856,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林樗翁舍余草堂以诗见贻病不能候次韵作答","author":"郑善夫","text":"鳌顶峰回云雾光，少微来照浣花堂。\n十年城府新相避，三径松筠故自荒。\n问道向迷襄野北，移家今在汉阴傍。\n方山耆旧偏怜我，只道相如病更狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19857,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"钓台用孟浩然韵","author":"郑善夫","text":"钓台东接峡江流，台上平临欧冶州。\n豪客乘风时有赋，海翁无事自忘忧。\n中原目断冥鸿路，落日愁生芳杜洲。\n岁晚烟波浩无极，鸬鹚鸂鶒傍人游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19858,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登台","author":"郑善夫","text":"江草幽幽江燕回，感时频上望燕台。\n天高西北神京在，雁落东南朔气来。\n豹谷水田聊自给，龙阳橘树未应栽。\n君王近著唐尧德，岩壑全生是栎材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19859,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送欧阳崇道入觐","author":"郑善夫","text":"年来苦阅循良传，别路看君意转长。\n飒飒秋风吹岊水，娟娟菊蕊傍重阳。\n中原目尽凤麟出，南国车前乌鹊翔。\n莫学武原陈仲举，只将悬榻报君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19860,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日登高盖山忆旧游","author":"郑善夫","text":"此日经过高盖下，忽忆去年高盖峰。\n秪见黄花似往日，那堪衰鬓向秋风。\n烟霞不断重阳路，勋业犹疑三径松。\n旧国萧条岁复晏，布袍芒屩意何穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19861,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岁暮怀戴郭二苏州","author":"郑善夫","text":"经年不寄吴都赋，文藻风流孰女如。\n作客总飞青玉舄，埋名翻受锦囊书。\n中原风物回秋梦，东海龟龙款使车。\n傥及桐江旧钓侣，明时甘守越溪鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19862,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李忠定祠","author":"郑善夫","text":"千秋祠庙对樵溪，丞相愁时日向西。\n江汉已浮龙马去，风尘遗恨鹧鸪啼。\n伤心北狩谁相问，极目中原他自迷。\n三疏留君见东澈，人情天运苦难齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19863,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次夕岘江闻笛赠林德敷熙载父子","author":"郑善夫","text":"岘水桥西秋欲社，追寻仍泛月边船。\n短箫长笛悲相语，锦树沧江绝可怜。\n交游自识茅容早，子婿谁当黄干贤。\n此夜星河未堪别，眼中闽楚各风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19864,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日偕诸子游鳌峰","author":"郑善夫","text":"鳌峰天畔登临去，云木新开平远台。\n落日山城生海气，中原风物送秋哀。\n一时贤士俱倾盖，满地萍踪笑举杯。\n梁国邹枚岂吾事，竹林嵇阮是仙才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19865,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"木兰陂谒李长者祠","author":"郑善夫","text":"木兰山下谁作陂，将军滩头功已亏。\n沧海未销钱女恨，路人惟诵李侯碑。\n秋深极浦生寒水，神至灵风满素旗。\n江汉汤汤吾力薄，祠前立马意应迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19866,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠汪希周太守","author":"郑善夫","text":"忆并先朝戊巳年，雪堂文酒日联翩。\n燕关旧侣嗟谁在，闽海浮槎羡女贤。\n乡信风烟连楚粤，宦情冠剑动山川。\n郡斋今复虚悬榻，何地看云更黯然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19867,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赴白下黄田道中作","author":"郑善夫","text":"稍喜移官向白门，春湖闻接灞陵园。\n经旬肺病形容变，千里乡愁梦寐繁。\n耿耿星河涵远水，冥冥氛祲散中原。\n廿年汉署成何事，翻向青山断客䰟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19868,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"建州逢蔡霞山","author":"郑善夫","text":"鳌顶歌钟东郭宴，旧盟回望思何穷。\n音尘岂说三秋隔，鬓发知堪几度逢。\n满地江湖催汎梗，极天云雾滞冥鸿。\n休论十六年前事，愁绝关河涕泪中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19869,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]