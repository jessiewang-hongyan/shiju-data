[{"title":"送方众甫备兵永平三首 其三","author":"董其昌","text":"君才原绣虎，使节向卢龙。\n香署纡筹策，雄边倚折冲。\n风霜行汉法，旂鼓变军容。\n今日榆关势，何如百二重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆伯生归吴","author":"董其昌","text":"神皋落木后，秋水灌吴时。\n乡梦催游子，川程访楫师。\n自怜玄尚白，未遣素为缁。\n等是春明路，閒云不可羁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送范尔孚北归","author":"董其昌","text":"旅食同千里，分襟此一时。\n烟沙征路远，风雨客帆迟。\n乡梦随芳草，春愁带柳枝。\n平生任慷慨，能不洒临岐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王思延归赴嵩山","author":"董其昌","text":"遂薄凌烟事，行期面壁僧。\n缨沾太行雪，车碾浊河冰。\n物态君应见，新知我不能。\n惟馀嵩洛梦，清夜兴堪乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长安送李参戎","author":"董其昌","text":"秦山控带雄，有诏赐彤弓。\n鱼鸟閒行阵，鲸鲵敢泛风。\n板舆春草软，练甲海烟空。\n乡国吴云外，因君梦巳东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长安送客","author":"董其昌","text":"忽听出关歌，风尘宛洛多。\n雪深辞白社，冰合走黄河。\n此夜叹萍梗，何年洽薜萝。\n自今燕市隐，谁挟蒯缑过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送丹阳令工东里应召","author":"董其昌","text":"鸣琴宰帝乡，平政古循良。\n自昔劳人地，今为选佛场。\n青阳开左个，紫极御中央。\n若问神仙吏，双凫在尚方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵孟清归桐庐","author":"董其昌","text":"燕市悲歌地，周南留滞年。\n交期论世外，标格在诗前。\n不灭遗书字，高吟宝剑篇。\n严村犹汉腊，归棹雪江边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送穆仲裕中舍还东明","author":"董其昌","text":"我忘邯郸道，君为吴会游。\n能将五岳兴，更写九歌愁。\n山水琴中赏，烟云杖底收。\n归装馀一卷，得似少文不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汪子归新安送别","author":"董其昌","text":"结侣向林丘，披襟事事幽。\n清尊文字饮，高枕画图游。\n寂寞玄亭路，苍茫钓客舟。\n何当送归夜，风雨满西楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贻陈徵君仲醇二首 其一","author":"董其昌","text":"开山庄是祖，扫径仲为群。\n南郭延天籁，东林出佛云。\n琴尊无俗韵，图史见遗文。\n今日苏门啸，何须隔岭闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贻陈徵君仲醇二首 其二","author":"董其昌","text":"犹是鸿冥者，将无鹤怨文。\n焚香供宗子，贮酒待陶君。\n篱蕊酬嘉节，江枫堕落曛。\n居然成二老，长此挹清芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠曹嗣山总河三首 其一","author":"董其昌","text":"警水勤明主，匡时得上公。\n业从专钺久，恩向锡圭崇。\n清济莲花府，黄流瓠子宫。\n十年驱节地，重入指挥中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠曹嗣山总河三首 其二","author":"董其昌","text":"苍玉与朱斿，高牙控上游。\n巳分周二陕，尽护汉诸侯。\n龙颡藏弓地，鱼鳞转饷舟。\n应还补天手，一解庙堂忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠曹嗣山总河三首 其三","author":"董其昌","text":"禹功犹在眼，汉策若为纷。\n似鹊填何补，其鱼叹岂闻。\n中台今省月，宝鼎欲敲云。\n一片征南石，兼书白郑勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠沈继山司马","author":"董其昌","text":"一曲鸳湖好，非关请乞来。\n东山选丝竹，北使问楼台。\n鸿向青冥送，花因白社开。\n只愁蒿目意，黄绮亦难裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南屏净慈寺赠萧方伯九生二首 其一","author":"董其昌","text":"宦辙优昙现，禅宫慧日悬。\n棠分龙钵雨，笏柱鹫峰烟。\n鞅掌遗尘外，冥心悟劫前。\n眼看朱绂客，谁出火中莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南屏净慈寺赠萧方伯九生二首 其二","author":"董其昌","text":"言访毗耶室，淹留及下舂。\n悠然禅悦意，能继白苏踪。\n香积充莼鲙，秋声感砌蛩。\n辞官亦非病，登涉不扶筇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁仪卿自征播归","author":"董其昌","text":"间关百战后，绝域独归时。\n出塞今如此，逃虚意可知。\n垂帘谈老易，舍筏證禅支。\n留取门旂姓，长惊海外夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠嘉兴令郑太初","author":"董其昌","text":"重游湖上月，新挹灌坛风。\n驻节鸥波外，携琴雀舫中。\n嘉声三瑞后，高论九流空。\n顾我成浮客，他乡得郑公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长兴熊坛石令君席上","author":"董其昌","text":"访隐到江潭，招携过水南。\n绿蓑怀往迹，白马纵高谈。\n震泽君吞九，中牟我得三。\n宵分灵雨至，罨画半拖蓝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青溪徐明府席上","author":"董其昌","text":"啸自苏门旨，诗仍邺下才。\n琴尊閒闭阁，宾客共登台。\n霁色川原净，秋光睥睨开。\n临觞无限思，极目向蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠萧象林比部","author":"董其昌","text":"凫舄依天府，文章自选楼。\n青阳开左个，赤县最中牟。\n朔雪梅花骑，江春竹箭流。\n赐金能贳酒，湖上待羊裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠广文之淮阴","author":"董其昌","text":"帝里文儒盛，明时道术尊。\n一官成蠖屈，多士得龙门。\n吏向淮南隐，经堪濠上论。\n因君访蒙叟，或有漆园存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠方众甫之汝州","author":"董其昌","text":"羁愁不可极，复此听骊歌。\n作吏谁成傲，论才尔自多。\n遥知汝南骑，重向冀方过。\n竹马诸童子，扳迎意若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨淇园侍御巡方事竣仍视学南畿诗以为赠 其一","author":"董其昌","text":"诏墨九重温，文星执法尊。\n朱轩穷海国，绛帐启桥门。\n水镜名先著，风霜气巳吞。\n遥知拜庆日，桃李解酬恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨淇园侍御巡方事竣仍视学南畿诗以为赠 其二","author":"董其昌","text":"才子河东赋，仙郎柱后文。\n人仍依绣斧，士总附青云。\n子舍乘骢路，天闲选骥群。\n何须占剑气，知动斗牛分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吴山人逸金","author":"董其昌","text":"孤云曾不住，何事倦飞还。\n道气看眉宇，禅心问骨山。\n试琴鱼出沼，鍊剑虎当关。\n余亦逃虚者，相期白社间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画赠陈懿卜山人","author":"董其昌","text":"剑授猿公术，碑穷蝌蚪文。\n风尘违壮志，图史策闲勋。\n道广星辰聚，人豪湖海闻。\n醉乡推祭酒，勿作出山云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠戴虞周","author":"董其昌","text":"识尔垂帘日，论交澹世情。\n禁方传海上，侠骨走幽并。\n邛杖供探胜，河车事养生。\n餐霞知不远，窗外九龙横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠玉峰道人","author":"董其昌","text":"联骑向郊坰，争言礼岁星。\n君应有膻行，我得问熊经。\n石髓缘非薄，云将迹更冥。\n何年寻汗漫，吹笛楚山青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠扈芷师归蜀","author":"董其昌","text":"清标灿蕣华，幽意同枯木。\n五岳一孤筇，三峨一茆屋。\n笔带锦江锦，囊携玉山玉。\n人言蜀道难，柰此摩天鹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠衲友","author":"董其昌","text":"锡带神光雪，杯浮大士潮。\n孤踪泛江海，瞠眼向云霄。\n说法惟挥麈，逢人或过桥。\n千峰何处住，一偈肯相招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送僧","author":"董其昌","text":"苕霅一时僧，千峰兴欲乘。\n龙蛇随北学，衣钵问南能。\n初地游方惬，弥天秀益增。\n谁知碧云句，侍者续传灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35116,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠衲子","author":"董其昌","text":"却忆弥天秀，那知异地逢。\n客愁轻九辨，胜赏挟千峰。\n徙倚林中屐，淹留静夜钟。\n何年投白社，一接虎溪踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35117,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠僧","author":"董其昌","text":"香积千人供，黄梅五叶花。\n檀那无住相，功德等恒沙。\n塔影云连水，僧音梵与华。\n宗雷开社后，知尔退堂赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35118,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题百萱图寿李本宁母太夫人","author":"董其昌","text":"突兀古云根，纷敷赤棘翻。\n堂前霞綵绚，天上露华温。\n托质从玄圃，忘忧合道言。\n应持比金母，百亿化身繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35119,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿萧封翁八十","author":"董其昌","text":"星郎拜庆日，华衮玉宸前。\n解老从河上，真封比渭川。\n应知众父父，别有大年年。\n一卷循良传，何如拔宅仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35120,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿程孝廉卿虞五十","author":"董其昌","text":"蘧子知非日，平津对策年。\n掊风轻九万，奏牍富三千。\n琴写山兼水，杯中圣与贤。\n看君多道貌，班缀玉宸前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35121,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿吴彦伦五十","author":"董其昌","text":"新阳回建子，初度叶惟庚。\n卜筑逃虚意，登楼信美情。\n无吟非雪曲，有笔梦花生。\n何必贤良策，平津独晚成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35122,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏鹤田黄门自琉球奉使归致书问讯诗以答之 其一","author":"董其昌","text":"叱驭犹行路，乘槎自凿空。\n何如浮海使，绝域渺难穷。\n龙节尧封外，鲛衣禹贡同。\n壮夫能许国，在处百灵通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35123,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏鹤田黄门自琉球奉使归致书问讯诗以答之 其二","author":"董其昌","text":"左掖颁圭日，东荒析木天。\n风烟迷甲子，岁月滞丁年。\n抚剑惊波晏，投珠异域传。\n慇勤遗尺鲤，倍起陆沈怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答苏云浦侍御","author":"董其昌","text":"芳讯到江潭，青霜字字含。\n襜褕行渐远，草木味同参。\n云梦应吞九，峨眉亦有三。\n山中无绿绮，何以报双南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶桐庐潘令","author":"董其昌","text":"岂有乘轩宠，深惭负弩情。\n茱萸催令节，兰芷忆南征。\n雉乳寻常事，鸥波浩荡轻。\n使君多重客，能著钓徒名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶李伯襄太史赠端研二首 其一","author":"董其昌","text":"石室分何重，铜台价岂珍。\n久为龙尾误，今见鹆眸真。\n子墨缘非薄，君苗气复振。\n天涯捐佩意，时共宝刀亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶李伯襄太史赠端研二首 其二","author":"董其昌","text":"雕琢古云根，投将十赉存。\n泠然鸣佩响，拊处截肪温。\n不谓焚鱼馆，能同抵鹊村。\n柔翰馀习在，珍重石交敦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甫里夜泊詶许玄祐中舍","author":"董其昌","text":"谁知玄度宅，又在五湖汀。\n隐几时生白，雠书几杀青。\n鸭池春浸月，渔火夜浮星。\n自笑烟波艇，频年问此亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶项文学","author":"董其昌","text":"舞剑助书真，闻钟悟酒禅。\n閒勋邀翰墨，短发老风烟。\n稽岭觞修竹，嘉陵响暗泉。\n素心公等在，燕处得超然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题鹤林春社","author":"董其昌","text":"便欲冲霄去，能无恋主情。\n梦中愁失路，客里得同声。\n巢树经春长，归轩一水盈。\n今宵不成寐，重听九皋鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题尘隐居三首 其一","author":"董其昌","text":"高情期五岳，小隐得残山。\n嘉树成蹊径，危峰出市阛。\n微唫时倚树，爱客不开关。\n谢氏云林宅，风流此更攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题尘隐居三首 其二","author":"董其昌","text":"买山何足问，缩地长高樊。\n石秀衔空翠，苔深带雨痕。\n双梧分凤渚，一水接鸰原。\n未得长慵卧，占星到德门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题尘隐居三首 其三","author":"董其昌","text":"松菊陶公径，蓬蒿仲蔚村。\n何如朱户里，别有碧山蹲。\n卷幔云生坐，登台月可扪。\n泉声朝暮响，怪底莫寻源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题农桑绮陌册","author":"董其昌","text":"百里春申路，欣歌田畯诗。\n行车膏作雨，沃野锦为陂。\n子妇馌堪饷，曾孙稼若茨。\n谁能忧藿食，慈母更农师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得云近蓬莱","author":"董其昌","text":"韶光明北极，云气护蓬壶。\n似盖笼华阙，非烟扑御炉。\n轮囷翔碧落，缭绕亘虚无。\n端识从龙意，辉辉映六符。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"薰风自南来","author":"董其昌","text":"北窗唫啸日，凉吹不须期。\n荷气初闻处，帘钩欲动时。\n幽从林杪度，清向瑟中披。\n见说天门近，随风咏亦宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得乱山残雪后","author":"董其昌","text":"严更馀朔雪，处处点苍山。\n风磴吹花急，阴厓积素閒。\n寒光断续起，冥色有无閒。\n谁向岩之曲，翛然独闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望岱","author":"董其昌","text":"吁骇看山眼，迢遥岱色分。\n应为天下雨，不断封中云。\n汉简千秋秘，秦松万壑闻。\n何当驰匹练，高揖碧霞君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"涿鹿道中赋得陌上尘","author":"董其昌","text":"每与群动起，氤氲蒲大堤。\n随风萦柳絮，碾地扑花泥。\n不受文犀辟，相吹野马迷。\n明朝御沟近，可似濯缨溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高梁即事","author":"董其昌","text":"人天皈佛日，风土纪皇都。\n水坐疑修褉，觞行或赐酺。\n花茵调怒马，珠弹起栖凫。\n谁识逃虚者，高阳混酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丰县道中","author":"董其昌","text":"宵征不容晏，路出古徐东。\n堤树一千里，村墟十九空。\n防河薪比桂，乘遽马如龙。\n犹有蠲逋诏，年年省故丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿滕阳驿","author":"董其昌","text":"滕阳古城曲，停辔独依依。\n心壮尝轻别，病来还忆归。\n火山驱马瘦，蒲渚上鱼肥。\n何必羊肠坂，方知叱驭非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄鹄矶阻风","author":"董其昌","text":"汉浦稽天浸，商风动地号。\n何来南郭籁，怪底伍胥涛。\n捐佩情何极，搥楼兴亦豪。\n不谙山水趣，乡思若为陶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游匡山","author":"董其昌","text":"策杖与云平，濛濛空际行。\n烟江中岭尽，星斗下方横。\n不隔诸天路，差疑五岳名。\n谁知游楚客，顿使九愁轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿羊山驿","author":"董其昌","text":"莽莽平沙路，登临更一奇。\n河流消楚汉，碑石记淳熙。\n鼓角因风迥，帆樯侯月迟。\n此中留憩者，半为问津疲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35146,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过高唐","author":"董其昌","text":"高唐斋右壤，终古作津途。\n山色犹衔岱，云容不是巫。\n坡陀分麦陇，闾井半桑枢。\n歇马斜阳下，应嗟霸气徂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿谷城驿","author":"董其昌","text":"岁晏促王程，宁辞带月行。\n罡风九野吼，残雪四郊明。\n宦辙嗟车耳，兵符问谷城。\n殷勤向关吏，霜角莫频声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"祭风台怀古","author":"董其昌","text":"泽国驱朝节，清时抚霸图。\n阵云犹壁垒，燐火或菰蒲。\n龙战何年事，鸿归后夜孤。\n繇来今古意，偏自集征途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"祝英台宅","author":"董其昌","text":"徙倚荒台畔，潺湲瀑水飞。\n因看江左右，却忆华山畿。\n化碧阴厓出，为云晚岫归。\n凄其前代事，端使胜情微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西兴秋渡","author":"董其昌","text":"秋涉试褰裳，风回海气凉。\n涛飞鸥外雪，林缀菊前黄。\n司马游何惬，鸱夷迹未荒。\n山阴劳梦想，迟晚得津梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泖塔夜坐","author":"董其昌","text":"烟沙回驭日，香海逗帆初。\n雨挟涛声急，云濛树势疏。\n雨涯宁辨马，后夜忽闻鱼。\n不是毗耶室，匡床得晏如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]