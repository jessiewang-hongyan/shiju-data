[{"title":"江右闱中次答吴大参中秋韵","author":"韩宗尧","text":"隐几跏趺坐夜深，月华门外转花阴。\n三千毫末劳双眼，万里风光豁素襟。\n匣剑未须惊照耀，酒杯何必问登临。\n高邻赖有贤参在，怀我新诗是好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次曾守初太守游山庄诗韵","author":"韩宗尧","text":"乾坤忙里几人闲，荣辱升沉总不关。\n风日山中草堂静，细听黄鸟转绵蛮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"歌风台","author":"陈珙","text":"汉王昔日有遗台，寂寞荒城泗水隈。\n草木尚思仙跸至，风云犹讶翠华来。\n酣歌慷慨千年兴，创业英雄万乘才。\n读罢残碑重吊古，夕阳啼鸟使人哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正德丙寅冬万州雨雪","author":"王世亨","text":"撒盐飞絮随风度，纷纷著树应无数。\n严威寒透黑貂裘，霎时白遍东山路。\n老人终日看不足，尽道天家雨珠玉。\n世间忽见为祥瑞，斯言非诞还非俗。\n越中自古元无雪，万州更在天南绝。\n岩花开发四时春，葛衫穿过三冬月。\n昨夜家家人索衣，槟榔落尽山头枝。\n小儿向火围炉坐，百年此事真稀奇。\n沧海茫茫何恨界，双眸一望无遮碍。\n风冽天寒水更寒，死鱼人拾市中卖。\n优渥沾足闻之经，遗蝗入地麦苗生。\n疾厉不降无夭札，来朝犹得藏春冰。\n地气自北天下治，挥毫我为将来记。\n作成一本长篇歌，他年留与观风使。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蘸水凝香在东山岭耕读亭下","author":"王世亨","text":"香阁端山下，霏微四望平。\n湖光澄藻镜，塔影落孤城。\n水树连天碧，江烟入夜明。\n寻芳应有兴，一曲寄吾情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清远峡","author":"钟晓","text":"五十年来几系舟，宦途奔逐苦淹留。\n登临剩有归山志，信宿能无去国谋。\n台榭纡回参帝子，碑文斑驳识猿猴。\n乾坤老我耽佳景，此地还应续胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夷陵山行用张督学韵","author":"钟晓","text":"窃禄犹供职，行途日自忙。\n山空花自秀，节近麦初黄。\n已下忧时泪，犹为吊古伤。\n莫言且行乐，恰好傍斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"益阳行台值雨","author":"钟晓","text":"静对沉檀几篆烟，潇湘风雨正连绵。\n计程蜀道尚千里，忆别皇都已半年。\n圣节喜逢遥祝寿，恩光覃被仰瞻天。\n故人未进湖南道，聚首无因思渺然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒严子陵先生祠","author":"钟晓","text":"当年应诏即辞回，垂老青山一钓台。\n自是子陵有高节，因知光武是雄才。\n君臣义重终难泯，故旧情深两不猜。\n千古桐江江上水，至今谁不重低徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送湛内翰使交","author":"钟晓","text":"多年风采注重华，此日恭承宠命加。\n莲炬夜迎归院骑，旌旗朝上使星槎。\n尧封不尽要荒外，圣泽今覃渤海涯。\n转旆道经梅岭过，高堂翘首喜还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书屏自励兼励诸子","author":"胡澧","text":"圣道大无极，学之从何入。\n无逾曾三省，兼与颜四勿。\n勉勉七十来，全未见有得。\n爰将书之屏，再策尚存力。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将赴松潘谒江市元帝庙","author":"胡澧","text":"庙貌中天起，旌旗北斗寒。\n水光衣带远，山晚雾云残。\n古路依村市，林霏湿客冠。\n登临频送目，蜀道敢辞难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将赴叙州谒江市庙","author":"胡澧","text":"古庙龙蟠石径新，树环村店昼深深。\n明朝草遍王程急，怀土忧时别后心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄沔中陈处士","author":"钟禧","text":"沔阳有高士，栖隐在林泉。\n绿树孤村里，黄花三径边。\n功名成弃屣，诗酒度流年。\n久别无由会，相思意惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河南道中西平铺舍","author":"钟禧","text":"新春骑马出长安，千里归期思缈漫。\n在路又惊人日过，到家应有杏花看。\n倾囊沽酒邀谁饮，呵笔题诗强自宽。\n南去好山青未了，暂从此地驻征鞍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经过恨这关","author":"钟禧","text":"去时黄叶满山隈，回首阳春逐马来。\n处处石田芳草绿，家家茅屋杏花开。\n十年踪迹如萍梗，此日襟怀仗酒杯。\n力倦也须登绝顶，五云深处望蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿恨这关","author":"钟禧","text":"踪迹疏狂事远游，懒工词赋客诸侯。\n春风楚国归王灿，落日长安醉马周。\n千里霜蹄何日定，十年烽火未曾休。\n长歌更出床头剑，空有寒光射斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赤壁怀古","author":"钟禧","text":"赤壁矶头载酒过，感时怀古思如何。\n扁舟泊岸波声静，孤雁横江月色多。\n鏖战当时怜孟德，狂吟此日忆东坡。\n无人可论平生事，醉舞龙泉发浩歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和友招游西湖 其一","author":"钟禧","text":"湖光山色最宜秋，君不来招也去游。\n已辨蜀川千丈锦，为谁今日尽缠头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和友招游西湖 其二","author":"钟禧","text":"万顷西湖水贴天，芙蓉杨柳乱秋烟。\n湖边为问山多少，一个峰头住一年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次段世高掌科九日登楼韵","author":"钟渤","text":"罗浮山远白云收，南望情孤百尺楼。\n几点黄花空照景，数茎华发不胜秋。\n雁将暝色催诗句，天与清香落酒瓯。\n安得此身如蔗境，了无酸楚到心头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和道长孙吉夫饯饮三首 其一","author":"钟渤","text":"群仙下蓬莱，酌我临水居。\n飞觥温翠盖，唾玉倾荷珠。\n飘飘十里风，清香逼庭除。\n明当登长路，云树吾何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和道长孙吉夫饯饮三首 其二","author":"钟渤","text":"玉节下九关，照耀东南来。\n桑蓬志有在，萍梗胡为哉。\n爱君鸾凤姿，愧我鹪鹩材。\n茫然刷短翅，万里飞金台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和道长孙吉夫饯饮三首 其三","author":"钟渤","text":"青骐按东南，倾盖即如故。\n山城久倾圮，筹画真时措。\n愧我庸驽才，乃荷伯乐顾。\n行矣两无言，元气须调护。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送公远","author":"钟渤","text":"风起紫薇垣，浪涌黄湾水。\n迟迟曲江棹，落落南州士。\n偕计五百年，奋翼八千里。\n鹊翻今日坛，乌啄香椒子。\n清响巴山钟，洗我筝笛耳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"终慕双挽 其一","author":"钟渤","text":"黄河东奔淮水长，威襄世泽流汤汤。\n庆钟五叶兰蕙芳，千葩万卉皆文章。\n安边六策排天阊，清新诗句追盛唐。\n竹风掠地百草黄，街尘不动狡兔藏。\n殊勋懿戚先后光，不虞荆棘生门墙。\n母翁两手扶纲常，九折不挫百鍊刚。\n六阴既剥天回阳，山河永固无沧桑。\n貂蝉闪日光鹓行，翟冠夺目萱草香。\n母恩父德相颉颃，声谐琴瑟宜寿康。\n天胡不惠降大殃，彩埋双璧十景荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"终慕双挽 其二","author":"钟渤","text":"君臣殊遇无存亡，几番恩典来侯堂。\n诘之造化孰主张，英气留待孤凤凰。\n时悬金印征蛮方，清声劲节如秋霜。\n筹边匪直我武扬，笔扫群丑如驱羊。\n陟岵陟屺阻莫将，哀哀双挽诗盈箱。\n大孝终身慕不忘，虞风舜日争翱翔。\n蹇予十载官夕郎，也曾竹下倾瑶觞。\n南香一瓣十断肠，凌烟有鹤飞来双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"磐石卫看操","author":"钟渤","text":"乱石盘东海，群山护北衙。\n军声震华岛，蜃气逼人家。\n日出鱼归市，风回雁落沙。\n茫茫天宇阔，何处问乘槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜入乐清分司晓起有感","author":"钟渤","text":"夜鼓催行省，朝歌玩物华。\n清流分雁宕，叠嶂合人家。\n双塔耸山表，孤军悬水涯。\n却怜民健讼，平地浪飞花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日述怀次张掌科时行韵","author":"钟渤","text":"秋江烟冷水光寒，采采芙蓉向晚看。\n衰鬓自怜风日改，閒情容放酒杯宽。\n近瞻紫极垂玄衮，未傍青山挂皂冠。\n谁笑宦年踰五十，汉庭元有老郎官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题松泉诗卷","author":"钟渤","text":"不放轻尘上布袍，棱棱清节在东皋。\n风生徂石琴声响，玉漱寒潭齿韵高。\n老干得云生羽翼，中泠无飓少波涛。\n撑空阔下平生志，行看清朝拜宠褒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"参浙出湾次林南川韵","author":"钟渤","text":"泾水何堪逐渭流，凄凄风雨暗生愁。\n上林敢望栖南翼，青锁无因到白头。\n老眼乍惊沧海变，赤心空抱杞人忧。\n今朝且醉薇花酒，酩酊前湾上浙舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滇南奉别","author":"钟渤","text":"解组东归春尽时，君恩亲寿两相宜。\n谁人直道能全节，我马横奔幸脱羁。\n四百峰峦寻旧隐，七千里路费新诗。\n自惭未茇甘棠树，敢望渔人去后思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题王君静斋崇慕堂二首 其一","author":"钟渤","text":"台斗无光树有风，长江秋影断孤鸿。\n遗书满架香仍在，结屋依山恨未穷。\n恩贲新丘天浩荡，鸟啼寒树月朦胧。\n瞳瞳舜目悬千古，独照羹墙到眼中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题王君静斋崇慕堂二首 其二","author":"钟渤","text":"谁遣台星坠海隅，秣陵无力挽金枢。\n韶华未睹形容尽，风物无情泪眼枯。\n绕屋慈乌声共苦，照人寒月影同孤。\n无端更树坟前竹，看取他年长凤雏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"京邸思亲","author":"曾镒","text":"三月韶光五月天，莱衣罢舞七经年。\n草心寸寸春晖里，鹤发时时夜梦边。\n组绶羁身祇自苦，蓼莪兴感却谁怜。\n圣朝幸喜颁恩命，乐得双亲五福全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其一 无极","author":"李江","text":"一团太极道非殊，太极看来极本无。\n这里何曾分面目，个中奚事泥形模。\n机缄不露天难测，化育常流道本虚。\n无极老翁最珍重，又留风月属尧夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其二 阴阳有象","author":"李江","text":"天地无心运五株，浩然二气塞堪舆。\n心兮未动机先动，气也无初道有初。\n触处形形分上下，初时噩噩本空虚。\n乾坤不欲藏玄妙，故把梅花画出渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其三 太虚","author":"李江","text":"夜静星稀月半笼，曲栏人静雪生风。\n坐来所见知精蕴，妙处无言是化工。\n有梦香魂游紫府，无涯清气塞苍穹。\n香魂清气皆真实，释氏何空老氏空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其四 夜气","author":"李江","text":"漏声初动雪初晴，到此看春眼最明。\n沆瀣瀼瀼浃肌骨，鸿濛浩浩蓄真精。\n风来水面披襟坐，月到檐前索笑行。\n夜半倚栏人未睡，银河斗转已三更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其五 元气流行","author":"李江","text":"元天默默意沈沈，却把梅花露此心。\n万物有形春壳子，三更无梦夜灵襟。\n洋洋发育乾坤浃，浩浩流行宇宙深。\n遥想伏羲千古上，昏昏晓晓到于今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其六 气化成形","author":"李江","text":"谁知二气怎陶镕，万汇生生万古同。\n一个玉人坐窗外，百年老眼挂天东。\n妙中参破乾坤偈，形外浑成造化工。\n欲问梅花谁是主，梅花无语对诗翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其七 象数","author":"李江","text":"直从子丑到寅上，万物惟梅骨格殊。\n奇偶阴阳皆定位，方圆体用总成图。\n伏羲面目生前象，大禹精神手上模。\n终日相看无一语，先生闭户著何书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其八 理气","author":"李江","text":"两不相离一故神，数成理具总天真。\n于书中数为皇极，在易五爻见大人。\n画出濂溪无极境，收归康节满怀春。\n六经子史皆糟粕，得手应心是斲轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其九 虚心","author":"李江","text":"虚心原不费精神，玩味无穷万境新。\n纸帐风轻临浅水，雪窗月小不纤尘。\n灵襟动达春如海，紫府玲珑梦亦真。\n闲往闲来多岁月，形骸还假弄丸人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其十 启蒙","author":"李江","text":"运合贞元一气完，先天真到后天全。\n自从开辟成形象，便把图书与圣贤。\n严似干戈排老子，和如金玉铸颜渊。\n宇中事业皆吾分，谁道乾坤别有圈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其十一 摇化工","author":"李江","text":"何人天上运风斤，雕琢乾坤妙不痕。\n玉照光寒山色滑，琼英精彩雪容温。\n太虚借尔为形象，元气凭渠认本根。\n世上无非机且巧，空教设色衒黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其十二 巧工","author":"李江","text":"谁家剪彩缀孤标，浅色深痕天地遥。\n吟到山前诗骨瘦，梦来花下酒肠饶。\n月明暗室三更晓，风静窗虚万感消。\n欲识个中神妙处，好寻颜孟到羲尧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其十三 虚灵","author":"李江","text":"虚灵洞彻雾冥冥，空谷幽窗别有馨。\n空谷冲寒魂不寐，幽窗生雪梦初醒。\n一根妙处藏三极，万理昭然散六经。\n彷佛我来姑射下，神人飞过海天青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其十四 静养","author":"李江","text":"昔日种梅悟养生，如今丹火愧难成。\n百花头上人争羡，十客图中尔独清。\n颜子潜心忘久坐，伊川瞑目觉初晴。\n有诗多在无言处，习静千回绕树行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其十五 触处洞融","author":"李江","text":"分明触处洞融时，幽涧风轻月到迟。\n月转梢头银压蕊，风来香动玉摇枝。\n红炉点雪寒如洗，绝壑清冰影欲移。\n自觉春光多泄漏，一番生意一番奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其十六 悟道","author":"李江","text":"括尽春光满范围，何曾有意欲探奇。\n高低草木化生处，上下鸢鱼飞跃时。\n道体晓然归老眼，诚明端的是生知。\n点头底事无人问，潦倒龙钟撚断髭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其十七 趣","author":"李江","text":"分外清幽景绝奇，个中风味少人知。\n不图春色有如此，惹起诗情无了期。\n陋巷箪瓢贫自乐，舞雩沂水咏相随。\n酒杯莫道罗浮远，四百峰头入梦时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其十八 真","author":"李江","text":"传此天真本自谁，令人真个动神思。\n品题雪月归康节，点画乾坤见伏羲。\n内外兼该皆一理，始终诚实更何疑。\n些儿样子好光景，五百年来老眼迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其十九 自得","author":"李江","text":"十载蓬窗一首诗，出于情性岂乖奇。\n欲知在后在前处，正自勿忘勿助时。\n卓尔心斋春浩荡，跃如佳景月清漪。\n至今赖得程夫子，指点乾坤了不疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其二十 裕如","author":"李江","text":"疏影斜痕云里春，优游风味一佳人。\n天然不觉精神露，本色还教体段真。\n红槿牡丹淫富贵，绿窗蓬户乐清贫。\n十年虽是无人问，一朵何曾或惹尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其二十一 充实光辉","author":"李江","text":"本体由来不少亏，诚明两路却非歧。\n诗情休羡横斜影，目力何分南北枝。\n陋巷春风入襟臆，泰山气象露神思。\n请看前面何如景，江汉秋阳皓皓时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其二十二 化不可为","author":"李江","text":"九转丹成白日飞，神仙家法孰能几。\n玄天幽默无言语，大造胚胎有妙机。\n卓立地头人到少，从心年纪古来稀。\n夜深留月相陪坐，自笑诗翁愿已违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其二十三 充完","author":"李江","text":"雪后园林影若何，乾坤充塞总元和。\n形模做出有如此，心性得来原甚么。\n五岭于人增眼力，八窗是我老寒窝。\n主人不觉清贫苦，只有便宜风月多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其二十四 克复","author":"李江","text":"自怜衰老一根荄，求故图新栽者培。\n金井玉渊看里见，光风霁月坐中来。\n运斤巧匠难容力，刺绣佳人不易裁。\n却恐红炉未添火，夜来霜冷雪成堆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其二十五 正而不阿","author":"李江","text":"东阁南枝样子多，一生棱角自磋磨。\n色寒映似山中雪，形直端如铁外柯。\n独立中天焉所倚，特生孤圃更无他。\n世间松竹非无继，北面梅花当若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其二十六 和而不流","author":"李江","text":"月来频照草堂低，送客迎宾路不迷。\n恁地时光堪雅赏，个中天巧就留题。\n玉容自是人如梦，酒兴何曾醉似泥。\n蔼若展禽春共坐，一枝长傍曲栏西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其二十七 静虚","author":"李江","text":"百年老眼共乾坤，着手推开万化门。\n一气鸿蒙浑未凿，两仪混辟互为根。\n无声无臭虚中觉，不睹不闻静处存。\n遥想韦编三绝后，不知几度月黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]