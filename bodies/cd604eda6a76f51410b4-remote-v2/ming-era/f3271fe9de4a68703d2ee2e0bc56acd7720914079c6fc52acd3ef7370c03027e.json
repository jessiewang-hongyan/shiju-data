r/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17029,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春思","author":"高启","text":"愁兼杨柳一丝丝，客舍江南暮雨时。\n自入春来才思减，杏花开过不题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17030,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"入郭过南湖望报恩浮图","author":"高启","text":"雨过春波柳浪香，布帆归缓怕斜阳。\n渔人为指江城近，一塔船头看渐长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17031,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"废宅芍药","author":"高启","text":"昔年花发要人催，今日无人花自开。\n犹有园丁怜国色，时容闲客借看来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17032,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登江阁远怀徐记室与杜进士同赋","author":"高启","text":"凭阑两客怨斜曛，此日同吟只欠君。\n江阁虽高犹不见，几重山水几重云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17033,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏夜宿西园酒醒闻雨二首 其一","author":"高启","text":"飞虫绕烛梦回迟，荷叶齐鸣雨一池。\n不为素纨犹在手，定疑秋夜乍寒时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17034,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏夜宿西园酒醒闻雨二首 其二","author":"高启","text":"人睡萧萧院落空，未秋愁已怯梧桐。\n夜长犹幸西轩雨，一半听时在醉中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17035,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻笛","author":"高启","text":"横吹才听泪已流，寒灯照雨宿江头。\n凭君莫作关山曲，乱世人人易得愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17036,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"慰周著作悼亡","author":"高启","text":"笑披纱扇忆当年，只有卿卿最得怜。\n今日料应花不住，夜灯相伴室中禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17037,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山寺冒雨还西郭","author":"高启","text":"栗叶翻翻满寺秋，出门风雨未全收。\n自惭骑马非闲客，可是山僧不解留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17038,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苏李泣别图","author":"高启","text":"丁零海上节毛稀，几望南鸿近塞飞。\n泣尽白头相别泪，少卿留虏子卿归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17039,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上偶见","author":"高启","text":"阿姬不畏晚寒多，绿舫红衣柳下过。\n满浦秋衣已零落，如何犹唱采莲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17040,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过保圣寺","author":"高启","text":"隔江寒雾隐楼台，远逐钟声放艇来。\n乱后不知僧已去，几堆红叶寺门开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17041,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"王七招饮余游紫藤坞值雪失期","author":"高启","text":"孤舟山水雪晴时，看到梅花一万枝。\n东崦题诗西崦醉，等闲忘却故人期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17042,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上送客","author":"高启","text":"春风江上荡舟过，垂柳垂杨拂浪波。\n惆怅今年频送客，长条欲折已无多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17043,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"期诸友看范园杏花风雨不果","author":"高启","text":"欲寻春去怕春休，又值春阴不得游。\n寂寞西园风雨里，杏花比客更多愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17044,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"逢张架阁","author":"高启","text":"花落江南酒市春，逢君归骑带京尘。\n一杯相属成知己，何必平生是故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17045,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中春晓听鸟声","author":"高启","text":"子规啼罢百舌鸣，东窗卧听无数声。\n山空人静响更切，月落杏花天未明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17046,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与亲旧饮散出抵城西客舍赋寄","author":"高启","text":"吴王废苑草青青，一骑今朝发野亭。\n谁道别君行路远，去时人醉到时醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17047,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过山家","author":"高启","text":"流水声中响纬车，板桥春暗树无花。\n风前何处香来近，隔崦人家午焙茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17048,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"云山楼阁图","author":"高启","text":"碧树香台锦绣连，画师应见乱离前。\n如今风景那堪写，废寺空山锁暮烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17049,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"始自西山移寓江渚夜闻雨有作","author":"高启","text":"客身移宿浦云东，孤馆残灯与旧同。\n夜静空江无落叶，雨声惊不似山中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17050,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚过浦西桥","author":"高启","text":"春水何长春日短，沙鸭交眠绿莎暖。\n晚过桥西不见人，野梅零落江梅断。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17051,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"叹庭树","author":"高启","text":"偶移弱质傍庭皋，风露离离已便高。\n翻笑园中栽树者，十年犹未出蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17052,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中春望（时在围中）","author":"高启","text":"郡楼高望见江头，油壁行春事已休。\n落尽棠梨寒食雨，只应啼鸟不知愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17053,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜斋见萤火","author":"高启","text":"拂竹绿莎复点台，夜窗无月见飞来。\n旧书乱后都抛却，懒就微光更展开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17054,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上见月忆家兄","author":"高启","text":"望月思兄意转迷，孤帆应宿楚云西。\n夜深愁向湖边立，为有寒鸿相并栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17055,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"逢吴秀才复送归江上","author":"高启","text":"江上停舟问客踪，乱前相别乱余逢。\n暂时握手还分手，暮雨南陵水寺钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17056,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送刘将军","author":"高启","text":"朔风吹沙复吹雪，笑解吴钩初欲别。\n酒酣击筑和悲歌，将军出关车骑多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17057,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵春日谩兴四首奉酬外舅达翁 其一","author":"高启","text":"老去风情似乐天，恨无张态抹朱弦。\n一春酒病稀游赏，啼鸟莺花共怅然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17058,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵春日谩兴四首奉酬外舅达翁 其二","author":"高启","text":"水边帘幕远笼花，游女时时出浣纱。\n记得横塘沽酒处，画船明月载瑟琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17059,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵春日谩兴四首奉酬外舅达翁 其三","author":"高启","text":"雨多池馆草毵毵，酒色寒销旧舞衫。\n燕子似怜花落地，殷勤长带软泥衔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17060,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵春日谩兴四首奉酬外舅达翁 其四","author":"高启","text":"菖蒲叶老芷花新，地暖鸳鸯护水纹。\n不上高楼无远恨，江南春尽草如云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17061,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日怀江上二首 其一","author":"高启","text":"一川流水半村花，旧屋南邻是钓家。\n长记归篷载春醉，云笼残照雨鸣沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17062,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日怀江上二首 其二","author":"高启","text":"薪蒲正绿乳凫鸣，水没渔梁宿雨晴。\n看近清明沉种日，野人何事不归耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17063,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉仙图","author":"高启","text":"酒满长生瘿木瓢，花开仙馆宴春宵。\n飞琼何事坚辞饮，应恐清都误早朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17064,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观弈图","author":"高启","text":"错向山中立看棋，家人日暮待薪炊。\n如何一局成千载，应是仙翁下子迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17065,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]