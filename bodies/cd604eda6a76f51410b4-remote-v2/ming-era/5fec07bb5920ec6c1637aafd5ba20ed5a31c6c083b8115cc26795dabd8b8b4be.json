[{"title":"荅李于鳞","author":"王世贞","text":"鹊湖春雨暗青山，流水桃花相对閒。\n共道闭门无外事，不知清泪落人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吏部张大夫助甫 其一","author":"王世贞","text":"红罗綷䌨不胜春，昨夜承恩雨露新。\n行过桂宫休却扇，怕教愁杀尹夫人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吏部张大夫助甫 其二","author":"王世贞","text":"使者仙槎切太虚，长怜鲛室有人居。\n自将清泪酬知己，不为君王十二车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋思","author":"王世贞","text":"庭梧一叶雁初飞，无那金河信转稀。\n夜夜银灯机里尽，狂夫犹着去时衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦热 其一","author":"王世贞","text":"今年毒热不可过，中夜狂走无时閒。\n即防蒸波徙汉浦，未有寒焰烧燕山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦热 其二","author":"王世贞","text":"北窗低庳不足眠，河朔逃暑亦虚传。\n酒徒零落今已尽，即使相过无酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦热 其三","author":"王世贞","text":"故知书斋如斗大，青蝇白鸟仍相参。\n便论齮嘬不足恼，径欲点污令人堪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦热 其四","author":"王世贞","text":"交河层冰九千丈，阴山积雪一万年。\n只今大地多暍死，汝休枉妒天公权。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦热 其五","author":"王世贞","text":"青山一线接天门，天坼银河日夜奔。\n千叠火云低不度，野夫今夜梦昆崙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦热 其六","author":"王世贞","text":"欲阴不阴云脚微，安得横吹海水飞。\n共道骄龙会行雨，看他身向热沙归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦热 其七","author":"王世贞","text":"石家门前金欲流，石家别馆如深秋。\n度尽清凉台上月，玉人歌舞不教收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠张二茂才","author":"王世贞","text":"度门高枕避京尘，惊见秋风玉树新。\n最爱谢家池草句，不知君是梦中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅徐汝厚惠桑落酒","author":"王世贞","text":"几年罢郡无从事，今日逢君有索郎。\n烂醉高眠秋色里，不知清夜傍谁长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴八首 其一","author":"王世贞","text":"海内犹传何李诗，三吴少年多廋辞。\n莫将新调欺前辈，弘治中天白日垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴八首 其二","author":"王世贞","text":"冥搜碧海珊瑚老，细琢青春玉叶过。\n只自人间无白雪，不知天上有黄河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴八首 其三","author":"王世贞","text":"古人已往俱吞声，眼底辞人纵复横。\n何处衣冠无大历，即论台阁胜西京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴八首 其四","author":"王世贞","text":"北地卤莽不足传，济南拮据殊可怜。\n女曹轻薄莫相笑，回首西京落日悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴八首 其五","author":"王世贞","text":"世人魄夺宗生奇，武昌自誇节制师。\n解道孙吴祗水上，不愁难插汉旌旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴八首 其六","author":"王世贞","text":"少年书不破万卷，往往开口论千秋。\n终南二华未挂眼，枉杀昆崙天尽头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴八首 其七","author":"王世贞","text":"野夫兴就不复删，大海回风生紫澜。\n欲问济南奇绝处，蛾眉天半雪中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴八首 其八","author":"王世贞","text":"十年名挂齿牙间，驱使风云太不閒。\n此日冥心还造化，他时只好施青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅史秀才臣纪见寄","author":"王世贞","text":"一掬陵阳泪未乾，投将明月畏途看。\n还应舍放荆溪上，夜夜青天北斗寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访邵子弁是日以友人王太史聘入京不遇","author":"王世贞","text":"萧萧寒雨叩柴关，匹马冲泥去不还。\n倘遇故人留禁直，莫将诗句乞青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为冯生走笔赠别杨都督二绝 其一","author":"王世贞","text":"早闻杨仆领楼船，十万旌旗晓色鲜。\n南粤东夷俱授首，斗来金印出甘泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为冯生走笔赠别杨都督二绝 其二","author":"王世贞","text":"大江春祖甲光寒，匣里吴钩醉里弹。\n幕下三千文武士，可无书记礼冯驩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"走笔呈王使君 其一","author":"王世贞","text":"开府楼船十万师，旌旗摇曳海天移。\n风清月堕莲香夜，唯有渔舟一叶知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"走笔呈王使君 其二","author":"王世贞","text":"饱饭松风任意眠，晚凉移枕听新蝉。\n江州卤簿时时过，懒向人间乞酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李于鳞赠子与守汝南序后 其一","author":"王世贞","text":"风雨千林剑色分，中原吾党渐离群。\n莫言天上无推毂，总向青山领白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李于鳞赠子与守汝南序后 其二","author":"王世贞","text":"曾将仙籍问三山，次第安期与大还。\n惟有吴郎浑未得，至今踪迹在人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠长兴钟生","author":"王世贞","text":"千金欲尽一身轻，缓颊浮云共此生。\n醉里论交醒后失，不妨秋色卧菰城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顾尚书有示山僧偈曰着意寻空未是空僧强余和韵仍更为一转语问僧不了吾义吾偈固空了吾义吾偈又不空乎僧无语","author":"王世贞","text":"着意寻空空未得，若论空外本无空。\n从教了却真空义，干树桃花自在红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重九日登高怀故人","author":"王世贞","text":"频年摇落伴风尘，回首连枝泪满巾。\n今朝兄弟茱萸酒，却向天涯忆远人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为谢道士题兰卷","author":"王世贞","text":"离离九畹暗香来，读罢玄经手自栽。\n莫倚谢家庭内物，不知新种在蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客谈李于鳞事有感","author":"王世贞","text":"衡门秋色远京尘，畏客时时称采薪。\n莫为问奇容载酒，近来年少易窥人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张广平助甫六首 其一","author":"王世贞","text":"自甘愚谷五经春，无限天涯草色新。\n纵有除书应懒读，广平还是折腰人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张广平助甫六首 其二","author":"王世贞","text":"当年宣室受釐开，绛灌如闻也爱才。\n三辅去天今尺五，何人解放贾生回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张广平助甫六首 其三","author":"王世贞","text":"蛾眉萧飒不禁寒，青镜流年懒自看。\n大有丛台歌舞在，莫将行步怨邯郸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张广平助甫六首 其四","author":"王世贞","text":"可随桃李恨春风，曾是春风掌握中。\n千尺乔松万年雪，不知天地为谁功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张广平助甫六首 其五","author":"王世贞","text":"愁闻平子赋归田，半刺翱翔亦可怜。\n老病束书黄犊角，不烦重数好文年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张广平助甫六首 其六","author":"王世贞","text":"雨色丹枫半掩扉，交游尺素渐来稀。\n无端最是随阳鸟，只作青云一处飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题宾竹山房为李炼师作","author":"王世贞","text":"千挺琅玕秋色新，清泉白石自为邻。\n阿猷元解吾家语，但过何须问主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成 其一","author":"王世贞","text":"骨肉都卢业海中，偶然相聚便生风。\n何如学取庞居士，了却无生事事空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨都督将解镇赋二绝迎之 其一","author":"王世贞","text":"马伏波书谁不惜，杜征南传世何知。\n自从身扫鲸鲵后，湖海春风遍酒旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨都督将解镇赋二绝迎之 其二","author":"王世贞","text":"忽雷驳散紫花文，明月弓韬青海云。\n莫向灞陵愁醉尉，何人不道李将军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居杂兴十绝 其一","author":"王世贞","text":"罢翻遗刻上乌丝，且捲湘帘看奕棋。\n犹觉闲身多此事，石床眠受午风吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居杂兴十绝 其二","author":"王世贞","text":"数卷残编了不亲，科头閒作水边身。\n怪来终日无烦暑，应趁人间得意人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居杂兴十绝 其三","author":"王世贞","text":"晓风微剪绿阴稠，剥啄柴门懒应酬。\n卿自衣冠用卿法，野人经月不梳头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12296,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居杂兴十绝 其四","author":"王世贞","text":"风尘十载倦归田，始向山僧学坐禅。\n此日和禅都不管，醒时呼酒醉时眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居杂兴十绝 其五","author":"王世贞","text":"臛凫蒸饼瓮头春，且喜农家事事真。\n论雨论晴天欲暝，柳梢初破月华新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居杂兴十绝 其六","author":"王世贞","text":"断绝人间千万缘，尚留篇什伴残年。\n欲知诗思今来懒，祇乞成都减样笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居杂兴十绝 其七","author":"王世贞","text":"草屩捞虾寄此生，早潮初退晚潮平。\n真成一梦真成觉，不博区区世上名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居杂兴十绝 其八","author":"王世贞","text":"落拓隗俄醉后真，子嵩应的是前身。\n自缘耽酒慵开卷，翻道庄生不异人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居杂兴十绝 其九","author":"王世贞","text":"日脚初低树色高，晚凉微动鬓萧骚。\n乌头作风白头雨，处处欢声停桔槔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居杂兴十绝 其十","author":"王世贞","text":"池上疏星浴曙波，偶听蛩响在青萝。\n亦知残暑将为客，其柰秋风感慨多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题竹赠沈山人","author":"王世贞","text":"小径初抽碧玉枝，澹烟零雨揔相宜。\n知君欲写江湖色，懒向梁王赋夹池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病后承伴松虚白二上人以法语见示辄成三绝奉报 其一","author":"王世贞","text":"病起空庭秋色新，翛然一榻净无尘。\n欲知不二门中语，应有朝来问疾人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病后承伴松虚白二上人以法语见示辄成三绝奉报 其二","author":"王世贞","text":"病来浑似堕尼连，病去俄成自在天。\n为语报身俱是幻，不知真境在谁边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病后承伴松虚白二上人以法语见示辄成三绝奉报 其三","author":"王世贞","text":"劳师指示安心法，欲觅心安总未能。\n夜半披衣时自起，一庭残月浸觚棱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题王子裕佥宪诗画册后","author":"王世贞","text":"江东再见王摩诘，宝界山头即辋川。\n一自丹青句题后，白云秋色重苍然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘲梁伯龙","author":"王世贞","text":"吴阊白面冶游儿，争唱梁郎雪艳词。\n七尺昂藏心未保，异时翻欲傍要离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其一","author":"王世贞","text":"黄封银瓮出当筵，侧弁须防执法前。\n何似家园红友在，一瓿相藉柳风眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其二","author":"王世贞","text":"银瓶初泻玉生香，风味由来擅索郎。\n若比美人何所似，太真柔腻出兰汤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其三","author":"王世贞","text":"涓然甘露布松梢，似玉如饴味更饶。\n尚有碧霄真沆瀣，无将一滴贮天瓢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其四","author":"王世贞","text":"清心玉映五铢衣，可是朱颜有愠羝。\n为道皋兰秋月下，流苏帐底见明妃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其五","author":"王世贞","text":"屑琼为酒露为浆，超出人间色味香。\n应从帝女传遗法，不向河东羡索郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其六","author":"王世贞","text":"未应誇诩和羹手，偶向尊前压献酬。\n他日邯郸解围后，与官求作醉乡侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其七","author":"王世贞","text":"潞州城中酒价高，胭脂滴出小檀槽。\n华胥一去不易返，汉使何烦种葡萄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其八","author":"王世贞","text":"清芬一段出冰壶，为问天浆似也无。\n莫怪死抛新息印，至今犹自胜明珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其九","author":"王世贞","text":"玉露凝云在半空，银槽虚自泣秋红。\n薛家新样莲花色，好把清尊傍碧筒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其十","author":"王世贞","text":"玉缸春色暖融融，一点清泠便不同。\n肯向邯郸斗秾艳，自誇林下谢家风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其十一","author":"王世贞","text":"空传仙掌擘清霄，可似真珠写小槽。\n白露白云都不要，温柔乡里探春醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其十二","author":"王世贞","text":"欲沽春酿解春愁，烂漫华胥境里游。\n无柰平原伴愁住，令人长自忆青州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其十三","author":"王世贞","text":"甓湖酒绿如寒烟，与君瓮头三日眠。\n即使病酲不忍却，况乃去病复延年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其十四","author":"王世贞","text":"漕河两岸碧栏杆，泻出春缸琥珀寒。\n任道侬家胜崖蜜，争如橄榄有回甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其十五","author":"王世贞","text":"瓮头嘈嘈泣泪红，吸来应唤小郫筒。\n何如换取莲花柄，千载风流属郑公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其十六","author":"王世贞","text":"邮使远将亦可怜，怪来瑟缩空流涎。\n麻姑纵有丹砂术，不作人间第一泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其十七","author":"王世贞","text":"池州酒酽真如油，重碧秾甘泻不流。\n故人要我酒家去，野夫自爱千金裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]