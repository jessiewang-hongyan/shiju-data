[{"title":"元夕应制","author":"曹义","text":"壁月当天霁色明，鳌山千叠壮神京。\n金莲璀璨祥光绕，绮树氤氲瑞霭生。\n紫禁楼台回昼景，碧霄歌舞度春声。\n总知四海恩波洽，臣庶欢忻荷太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送丁永成之邵武","author":"曹义","text":"都门此日送人归，载道黄花笑客衣。\n去旆晓沾清露湿，征鸿寒逐暮云飞。\n帆经杨子烟波渺，路入樵川浦树微。\n回首沙头重惆怅，何如离会苦相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送尹仲昭之迁安教职","author":"曹义","text":"朝回紫陌曙光浮，暂出都门送旧游。\n征雁度云迎去旆，黄花对酒解离愁。\n青山落日迁安道，疋马西风蓟甸秋。\n师道由来清□□，□□□□□□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽王处士彦实之父","author":"曹义","text":"三□家世旧衣冠，林下幽怀老更宽。\n琴酒忘形消白昼，诗书课子乐馀欢。\n春风正拟龟龄迈，夜月俄惊鹤梦残。\n目断鄞江倍惆怅，松楸深锁暮云寒。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱德和就步士功韵","author":"曹义","text":"冠盖纷华似列仙，都门选别酒频传。\n联诗每愧居人后，归省争如在客先。\n千里云山游客兴，半篷风雨渡淮船。\n夕阳回首重惆怅，烟树苍茫思渺然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"澹泊轩","author":"曹义","text":"浮华不尚事遗编，澹泊名轩乐自然。\n绿笋黄齑甘雅素，紫驼翠釜厌腥膻。\n半窗梅月吟边兴，一榻松风静里天。\n料得襟怀多洒落，传家旧物秪青毡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送象州知州","author":"曹义","text":"晓承恩命出皇州，棹发通津万里秋。\n浥露芙蓉迎去旆，经霜杨柳带离愁。\n云连五岭蛮烟合，夜度三湘瘴雨收。\n悬想象州民吏待，马蹄到处莫淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望云思亲为汤主事赋","author":"曹义","text":"庭闱久别思依依，目断孤云海上飞。\n愁见晴郊山半掩，忍看秋塞雁同归。\n闲来捲幔生乡思，几度凭阑送夕晖。\n优诏会看归省日，还应膝下戏班衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送沈太参仲威","author":"曹义","text":"久联鹓簉立彤墀，忍向都门话别离。\n佐政薇垣新宠渥，列官粉署旧恩私。\n平郊日脕孤鸿远，去路霜寒匹马迟。\n别后欲知相忆切，金门待漏月明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许知县英","author":"曹义","text":"看花曾醉上林春，又喜承恩出紫宸。\n百里牛刀初小试，九天鹏翮未全伸。\n蓟门暮雪拈行旆，闽峤晴云接路尘。\n到日想知公事简，雁来莫惜宕书频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽周处士知县庸节之父","author":"曹义","text":"濂溪家世旧衣冠，养浩林泉趣自宽。\n堆架牙签闲处阅，隔帘山色醉中看。\n鹤归沧海秋风冷，猿啸清江暮雨寒。\n惆怅独遗荒冢在，松楸远带夕阳残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴惟吉知蕲州","author":"曹义","text":"挟策才看觐紫宸，买舟又见问通津。\n青年名擅才华美，玉阙恩承雨露新。\n官道雪晴梅褪粉，御河水泮柳含春。\n行旌明到黄堂日，莫惜音书寄故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人省亲归福建","author":"曹义","text":"久别家山定省违，几回目断白云飞。\n于今拜命辞青锁，指日承颜戏綵衣。\n闽峤暖云连海戍，蓟门春树蔼夕晖。\n差予亦有双亲老，送客题诗叹未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽诸处士光禄署丞仲学之父","author":"曹义","text":"寿过稀年两鬓秋，一生林壑自优游。\n赏春几醉兰亭酒，适兴频登庾亮楼。\n鹤化海天霜月冷，猿啼野墅莫云愁。\n贤郎昨夜闻哀讣，哭向东风血泪流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人归仪真","author":"曹义","text":"长乐钟声出凤楼，喜辞丹陛拜宸旒。\n几年宣力勤王事，此日承恩出帝州。\n马度卢沟霜月冷，雁投淮浦暮云收。\n遥知公暇多清兴，应赋新诗寄旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽李给事中父","author":"曹义","text":"令子清时拜好官，先生林下独盘桓。\n隔帘山色吟边见，绕径黄花醉后看。\n沧海鹤归云渺渺，南柯梦断夜漫漫。\n可怜孤冢平郊外，衰草含烟霭莫寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送史阴阳官归金困","author":"曹义","text":"几年林壑伴渔樵，一旦蜚声达九霄。\n课艺总知龟策妙，拜官争羡宠恩饶。\n归帆晓逐天风急，行色春随烟树遥。\n此去想应多得意，锦衣光映玉骢骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓟门送别图","author":"曹义","text":"千里观光上帝州，到来还念倚门愁。\n西风江渚寻归棹，落日城闉别旧游。\n数点远山官树晚，一声孤雁海天秋。\n悬知去去乡园好，称寿黄花酒正篘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送薛京兆还家祭祖","author":"曹义","text":"晓辞金阙佩锵锵，衣锦南还沐宠光。\n游宦两京清誉重，诰封三代紫泥香。\n官亭柳色侵行旆，驿路莺声送夕阳。\n此去应知多显耀，九原松柏倍苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈主事谟归省分题得任城酒楼","author":"曹义","text":"南归衣锦出神州，远过任城旧酒楼。\n粉堞澹烟迷望眼，青帘落日映行舟。\n云连画栋歌声迥，春锁虚窗鸟韵幽。\n千载谪仙名独在，莫因风月久淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度日朋旧过临为贺戏笔书怀念先妣不及禄养也","author":"曹义","text":"客边初度几相逢，岁岁年年事不同。\n绿酒樽前曾献寿，綵衣膝下困春风。\n遥思亲舍三茅下，欲报劬劳一梦中。\n珍重故人深见爱，也来称贺?飘蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张中书克巳归陕西","author":"曹义","text":"几年染翰侍明光，衣绣争看归故乡。\n路指渭城云冉冉，春回华岳树苍苍。\n科登甲第才名盛，恩及双亲雨露香。\n悬想高堂称寿日，菜衣谩舞醉霞觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王主事父归越布政暹之父","author":"曹义","text":"荣膺紫诰出彤闱，逸气飘飘兴欲飞。\n独骑晓从幽甸发，一帆春向越江归。\n交游总羡承嘉渥，闾里争看著锦衣。\n何幸老年卜曹盛，美多应积古来稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王公器回乡","author":"曹义","text":"解却名缰谢是非，归田活计莫相违。\n晓开野径宜栽竹，暖逐山童好采薇。\n醉后狂歌多得趣，客来清话自忘机。\n玉堂青琐经游遍，村落从来识者稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送户部刘主事归襄阳祭祖","author":"曹义","text":"玉陛朝辞出凤城，故乡归去几多程。\n褒膺紫诰恩波渥，贲及黄泉宰木荣。\n路指岘山凉雨歇，帆开潞渚晓风轻。\n到家莫忘朋俦好，为托鳞鸿早寄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人归无锡为郑监丞叔颙作","author":"曹义","text":"不辞千里远相过，萍水襟期喜若何。\n夜雨政宜连客榻，薰风忍听唱离歌。\n蓟门酒尽尊前兴，潞渚帆扬雨后波。\n想到家山多雅趣，五云亭上日吟哦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云萝书舍为社文会赋","author":"曹义","text":"幽居谁结傍岩溪，苍莽云萝入望迷。\n紫蔓色侵苔石净，晴阴凉度竹窗低。\n香凝白昼尘难到，门掩青山鸟自啼。\n知有堆床书万卷，几回披阅日沈西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送庄检讨存礼归省","author":"曹义","text":"天香两袖□彤墀，归路莺声促去期。\n离旆晓沾凉雨湿，征帆晴带夕阳迟。\n钟山目断云飞处，扬子潮平夜泊时。\n总羡此行多宠渥，萱花宰木共涵滋。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑司副雍言归浙东","author":"曹义","text":"英年才思竟谁同，文涌波澜气吐虹。\n疋马暂辞幽蓟北，孤舟远过浙江东。\n篷窗山色青天外，驿路莺声绿树中。\n明到焚黄向何处，玉泉峰下海潮通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吏科凌给事中归省","author":"曹义","text":"列职黄门首近臣，清时名誉动儒绅。\n九重拜命恩波渥，千里趍庭綵服新。\n心旆晓悬青琐闼，仙舟夜泊绿杨津。\n故乡紫笋茶堪爱，寄远毋忘玉署人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送医官还郑州","author":"曹义","text":"旧业荣阳事药栏，多年种德拜儒官。\n春风采术蓝田晚，夜月寻方宝箧寒。\n杏坞花阴眠熟虎，玉炉火煖转灵丹。\n昨来报政趍天阙，归路青山马上看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送御史还家","author":"曹义","text":"年少高峨獬豸冠，声名烜赫播朝端。\n封章达处天颜喜，揽辔行时吏胆寒。\n晓日九重□紫诰，香烟两袖出金銮。\n一帆归兴秋江上，红叶黄花取次看。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送阴阳官归江西","author":"曹义","text":"术妙蜚声达九天，一官初拜称青年。\n晓趍凤阙辞青琐，归去螺川买尽船。\n远浦淡烟迷落雁，西风衰柳噪残蝉。\n岐亭酒尽频回首，杳□孤帆夕照边。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王公顺归乡","author":"曹义","text":"广阳城外白云飞，送客南归对夕晖。\n别路谩斟桑落酒，高堂重著老莱衣。\n望中绿柳经霜脆，江上青山带雨微。\n明到乡园逢故旧，愿言毋惜寄书稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送牟御史出镇便道给假省亲之四川","author":"曹义","text":"几年不著老莱衣，目断乡关兴欲飞。\n凤诏忽从金阙下，豸冠喜向锦城归。\n霜寒峡迥?声切，月冷江空雁影微。\n悬想霞觞称寿罢，又持使节振天威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慈寿堂为李御史赋","author":"曹义","text":"华扁高标慈寿堂，应知阿母鬓如霜。\n娱颜晓舞斑斓服，献寿香浮绿蚁觞。\n傍砌幽萱春馥馥，映窗丛竹晚苍苍。\n锦舆遥想欢迎处，花覆晴阴日转长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送长汀陈检讨","author":"曹义","text":"紫泥晓捧出金銮，思入瓯闽路渺漫。\n孤雁声迟秋汉迥，片帆影断夕阳残。\n红兮荔雨青山湿，梦绕先茔夜月寒。\n明到蘋蘩供祀毕，音书母惜寄平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽检讨母秦性初老孺人","author":"曹义","text":"忆从王母驾云軿，一醉瑶池竟不醒。\n游子讣来魂欲断，慈乌啼处怨难听。\n熊丸香冷尘生箧，机杼声仁月万庭。\n若问平生渊懿德，请看太史墓前铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怡萱堂","author":"曹义","text":"为学婴儿喜自狂，几回啼跌傍萱堂。\n斑衣舞处生春色，寿酒称时泛蚁香。\n问寝楼头天欲曙，迎舆花底日偏长。\n从知天性来□孝，应是慈颜鬓未霜。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐知州赴郑州","author":"曹义","text":"玉殿朝辞沐宠光，又看行李向荣阳。\n双旌晓度卢沟月，疋马寒嘶驿路霜。\n黎庶棠阴怀惠泽，衣冠帝里羡才良。\n悬知竹马相迎处，老稚欢忻拥道傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦忆华亭华亭寺名在滇池中书洪益中求","author":"曹义","text":"天从飞锡到銮坡，几度华亭梦里过。\n琪树俨然窥色相，浮屠依旧枕名阿。\n香销石鼎尘留榻，云静松窗鸟自歌。\n行遍当时诵经处，觉来还记白云多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送韦检讨父还庆远","author":"曹义","text":"五十年高鬓未皤，朝天万里到銮坡。\n乌纱初著精神爽，紫诰新封宠渥多。\n令子玉堂驰美□，先生林壑养天和。\n于今祖饯都门道，芳草凄迷柰别何。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送韦进士","author":"曹义","text":"雪案萤窗几度秋，一朝身到凤池头。\n看花烂醉琼林酒，带月俄开潞渚舟。\n路指龙江云水渺，山连桂岭瘴烟收。\n锦幖夺得荣归去，应是人誇是昼游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和待诏王内悦先生留别韵","author":"曹义","text":"九重优诏许投簪，千里家山独抱琴。\n明月清风黄阁梦，青山落日故人心。\n城头片雨沾行旆，江上孤帆背夕阴。\n去去莫忘朋旧好，雁来还拟寄佳音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈州判李和之安陆州","author":"曹义","text":"多君与我最相知，十载遨游在凤池。\n待漏几同趍玉?，承恩独喜出彤墀。\n关河日落孤帆迥，驿路秋清疋马迟。\n明到莫忘词苑客，公馀还拟寄新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邓日新归韶阳省亲","author":"曹义","text":"几年联佩侍宸旒，此日分携动别愁。\n岐路一尊桑落酒，西风万里曲江舟。\n青山断处蛮烟合，红荔香时瘴雨收。\n自古韶阳多异物，肯将钟乳寄交游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送光禄李少卿归省","author":"曹义","text":"爵秩清时列九卿，才高圣主独知名。\n一朝拜命膺鸾诰，千里还家出凤城。\n路指金华烟树迥，帆经铁瓮晓风清。\n悬知明到焚黄处，春满先茔宰木荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邵郎中之浙东省亲","author":"曹义","text":"游宦京华定省违，几回望断白云飞。\n一朝恩诏九天下，千里阙河独棹归。\n雁影远横秋水阔，山光斜带夕阳微。\n悬知先垄焚黄罢，又向萱庭戏綵衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨学士子回乡","author":"曹义","text":"为省严亲上帝州，到来几度忆东瓯。\n趍庭已遂斑衣乐，在客宁忘慈母忧。\n晓日都门辞故旧，西风通潞棹归舟。\n悬知此去多清思，驿路黄花总是秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王文显之任","author":"曹义","text":"环佩翩翩下九重，匆匆别兴蓟门东。\n一尊绿酒西风外，千里青山落照中。\n京国友辞鹓鹭伴，关河帆趁蓼花风。\n到官遥想多清暇，毋惜缄书托便鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送令尹","author":"曹义","text":"都门雪积冻难消，拜命看君出御桥。\n南日渐回飞舄远，东风乍落马蹄骄。\n河阳花影春驰道，淮浦江声夜听潮。\n宦迹共嗟为客久，离歌一曲别情遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈守道之蕲州","author":"曹义","text":"荣棒除书出九重，天香两袖气如虹。\n双旌晓拂荷亭露，五马骄嘶柳岸风。\n总羡襟怀涵壁瑩，应知善政蔼春融。\n公馀不忘词林客，好写新诗寄便鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送太常魏先生之南京","author":"曹义","text":"封章交荐荷恩荣，拜秩容台列上卿。\n玉佩晓辞丹凤阙，锦帆秋过石头城。\n征鸿晴度关河迥，疏雨凉生客旆清。\n顾我交游怜最久，临岐尊酒不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王太医德斋归乡","author":"曹义","text":"几年膺荐住神京，世业岐黄术最精。\n悬市有壶尝寄迹，活人无地不知名。\n皇恩已遂归田愿，白首还寻结社盟。\n记得采芝旧游处，华阳洞口暮云平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送史太守常归休","author":"曹义","text":"宦路萧条事巳非，清时失意解缨归。\n心怀玉阙风云绕，梦入金渊浦树微。\n作郡尚存黄霸政，垑庭喜著老莱衣。\n蹇予独有离群思，京国交游日渐稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送味道父楚兰翁","author":"曹义","text":"紫诰褒封两鬓华，锦衣绚烂映乌纱。\n拜辞玉阙天初曙，祖饯都亭日又斜。\n望里关河飞画鹢，吟边官树带晴霞。\n应知明到多清趣，看竹频过处士家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王文葩归省甬东","author":"曹义","text":"东望蓬莱道路遥，白云飞处海天高。\n桥门久客归心切，枫陛初辞喜气豪。\n紫陌花阴嘶去马，红亭夕照醉香醪。\n登堂舞罢莱衣日，还拟春江钓巨鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送医官周本庸还家侄婿德贤之族兄","author":"曹义","text":"家近华阳古洞天，秘书曾受异人传。\n检方夜映壶中月，种术朝耕谷口烟。\n医国多人称妙手，随时卖药不论钱。\n年来鹗荐承恩渥，袖得香烟下日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送推官复职为邵郎中作","author":"曹义","text":"闻说黄堂谳狱平，棠阴风静颂声清。\n香凝白昼吏初散，花落闲庭鸟自鸣。\n报政喜沾新宠渥，还官又促旧前旌。\n悬知黎庶遥相待，千里征帆莫后程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周大本还江西","author":"曹义","text":"幕府才名远近传，督储来到五云边。\n尊前未尽陈遵兴，江上俄回扬子船。\n壁水论交思旧雨，薇垣寓直忆当年。\n于今惜别都门道，后夜相思月满天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄味道","author":"曹义","text":"忆自分携出帝畿，几回独立送斜晖。\n愁凝云树诗难就，目断鳞鸿兴欲飞。\n离思暗添凉雨过，清尊倦对宦情微。\n惭予亦有亲垂老，争似高堂戏綵衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赦后送人还家","author":"曹义","text":"天降丹书湿紫泥，嵩呼万里贺声齐。\n恩波已喜消春瘴，驿路行看听晓鸡。\n逸兴暗随江树迥，离情愁逐暮云低。\n到家想及清明候，花满山城莺乱啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临清楼","author":"曹义","text":"谁从溪上结危楼，楼外溪声日夜流。\n清影瑩涵云栋静，波光凉度绮窗秋。\n高凝灏气琴书润，低瞰渔舟雪浪浮。\n遥想豪吟登眺处，阑干倚遍夕阳收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]