[{"title":"漫题","author":"于慎行","text":"安东通汉节，消息久茫茫。\n事异降疏勒，名殊受越裳。\n先朝多典故，属国有彝章。\n何太苍黄甚，为谋但可伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白庄对雨","author":"于慎行","text":"山楼三日雨，御祫不胜寒。\n积水深苔径，颓墙损药栏。\n牛羊邻巷狭，凫鹭野塘宽。\n想见清溪涨，应难著钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悯雨","author":"于慎行","text":"七日复七夜，雨声檐际悬。\n遥山开复隐，野水断仍连。\n禾实真生耳，苔文漫作钱。\n为农资百亩，不是敢忧天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚霁","author":"于慎行","text":"忽看云雾敛，返照逐归鸦。\n壅水笼漂麦，分畦护种瓜。\n楼阴新见月，山气渐成霞。\n远忆辽阳戍，军声急暮笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中谢周师送酒","author":"于慎行","text":"积雨不出户，空斋自检书。\n如何陶令酒，亦到子云庐。\n闭阁青山少，开帘远树疏。\n沈冥应独醉，无计屈高车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄儿纬京师","author":"于慎行","text":"炎风吹去马，几日到长安。\n要识人间路，休怀膝下欢。\n夙宵常展卷，凉燠自加餐。\n世业馀丛桂，还从上苑看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒居","author":"于慎行","text":"野筑千林敞，閒居万事慵。\n朝廷疏记忆，里巷少过从。\n雨急萧萧柳，风疏落落松。\n传呼何太剧，海上举边烽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕溪舟初成同施还初文学王改予武元游汎","author":"于慎行","text":"为嗜城南隐，临溪理钓舟。\n适逢河鼓会，小试武陵游。\n斜日悬渔网，凉风激棹讴。\n冯君槎上汉，吾道在沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十三日诸亲溪亭汎舟二首 其一","author":"于慎行","text":"远集亭边骑，新成槛外舟。\n岁时开小会，信宿是中秋。\n倚杖迎岚气，褰裳渡石流。\n泠然尘外赏，无谢竹林游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十三日诸亲溪亭汎舟二首 其二","author":"于慎行","text":"晚凉人未醉，移席汎烟波。\n酒远杯常待，舟平岸易过。\n鸟边浮晚吹，花底度轻歌。\n早见东林月，秋光逼绛河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋同施还初文学携门下诸友汎舟南溪","author":"于慎行","text":"别馆依泉石，方舟集俊英。\n陈诗吴季子，讲业鲁诸生。\n云树空中影，笙歌水上声。\n回桡应已夜，山月好相迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋同诸友南溪望月","author":"于慎行","text":"此际秋无奈，停舟望碧岑。\n月华岩际满，夜色水边深。\n影灭银河浪，光团桂树林。\n南楼闻啸咏，谁识庾公心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日无菊","author":"于慎行","text":"山斋逢九日，怅望晚天霞。\n去岁曾飞雪，今年未见花。\n秋声风落木，寒色雨侵沙。\n幸有杯中物，犹同处士家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送武举王生北上","author":"于慎行","text":"侠少多奇节，悲歌气不平。\n偶探黄石简，欲赴白登城。\n锦瑟垆头醉，雕戈马上横。\n功成报明主，耻作鲁诸生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄吴观我太史","author":"于慎行","text":"闻道金闺侣，名山住已深。\n淹留依桂树，栖息傍祗林。\n真偈閒常讽，新诗静自吟。\n论思虚上列，悬切故交心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日寄邹南皋吏部","author":"于慎行","text":"美人南国渺，江上有枫林。\n道为谈天重，名因避地深。\n十年曾酒会，千里片鸿音。\n念尔关隆替，能忘报国心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对雪闻方子公行赋送","author":"于慎行","text":"寥寥逢岁宴，飞雪逗年华。\n霰薄初成雨，风高渐作花。\n寒光连兔苑，朔气度龙沙。\n游子今何适，关山路正赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中独酌","author":"于慎行","text":"北风一以凛，雨雪昼霏霏。\n酒畔疑花落，春前学絮飞。\n田家占岁事，海国念戎机。\n万里三韩道，征人几队归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冯用韫宗伯订约西游登岱过期未至怀望遣闷二首 其一","author":"于慎行","text":"自得高丘约，脂车已隔年。\n如何期屡易，直作信空传。\n海色云门上，秋光日观前。\n侧身凝望眼，端拟四愁篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冯用韫宗伯订约西游登岱过期未至怀望遣闷二首 其二","author":"于慎行","text":"海上碧云断，佳期谁为留。\n已看过九日，原约近中秋。\n岁晚常思会，身轻未厌游。\n迟回应有为，无处问书邮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上坤山月岩寺陈铁峰孟我疆诸君会讲处也","author":"于慎行","text":"何代标金刹，层崖半倚天。\n松门低落日，石窦泻鸣泉。\n野旷寒烟积，山高细路悬。\n因怀莲社客，惆怅讲堂前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过阳谷店山下问小洞庭遗迹是唐时东平太守苏源明宴处","author":"于慎行","text":"蚕尾峰头路，当年小洞庭。\n污邪馀水国，文物闭山灵。\n野草微茫白，川云黤惨青。\n犹疑歌舞地，笳鼓震空溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴澄阳文学还越","author":"于慎行","text":"翩翩江左彦，藻思薄云天。\n观乐重游鲁，谈经旧客燕。\n归舟鸿雁后，别酒菊花前。\n明岁长杨猎，看君赋草传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭元戎少泉侯兄八首 其一","author":"于慎行","text":"故国逢今日，元枢失旧臣。\n人间销电露，天上化星辰。\n磊落英雄气，悲凉骨肉亲。\n哀歌转难就，握管涕盈巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭元戎少泉侯兄八首 其二","author":"于慎行","text":"少年抛翰墨，笑入五陵场。\n一剑横秋色，千金去故乡。\n韬钤分禁旅，节钺奠夷荒。\n何意将军树，风残一夜霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭元戎少泉侯兄八首 其三","author":"于慎行","text":"男儿身手健，壮岁握兵符。\n试买千金骏，轻关十石弧。\n登坛名已遂，裹革志犹孤。\n回首黔中路，年年泣鹧鸪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭元戎少泉侯兄八首 其四","author":"于慎行","text":"羽书今正急，谁勒玉关铭。\n穷海缠兵气，中原落将星。\n侠场思意槩，蛮府慑威灵。\n尚欲随风雨，鞭螭下紫庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭元戎少泉侯兄八首 其五","author":"于慎行","text":"少小追游地，今来白发新。\n半生羁仕路，垂老恋交亲。\n间阔无经月，欢娱得几春。\n可怜花底醉，已作梦中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭元戎少泉侯兄八首 其六","author":"于慎行","text":"吾家门巷改，池草尽成尘。\n念我歼同气，依君岂异人。\n徵歌花坞夜，载酒竹溪春。\n旧侣无多在，相看涕泗频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭元戎少泉侯兄八首 其七","author":"于慎行","text":"朝来过旧馆，遗迹总堪嗟。\n晓月沈弓影，秋霜涩剑花。\n护羌元入塞，去病不为家。\n素业青门外，惟馀数亩瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭元戎少泉侯兄八首 其八","author":"于慎行","text":"摄提星入次，单阏鸟来旋。\n正近悬弧旦，翻成挂剑年。\n祠方同畏垒，冢得象祁连。\n汗血俱龙种，青箱事可传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日荅常心吾中丞寄问二首 其一","author":"于慎行","text":"别后渺愁予，秋来得报书。\n未过衡渚雁，早下武昌鱼。\n天地方多难，江湖有索居。\n间踪休更问，头白侣樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日荅常心吾中丞寄问二首 其二","author":"于慎行","text":"何地容高隐，江楼万竹青。\n晓猿谙报客，夜鹤解听经。\n天迥悬卿月，山深阅岁星。\n会传宣室召，莫勒草堂铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠诗僧","author":"于慎行","text":"拥锡来吴岳，诠经住鲁城。\n王孙除馆待，郡牧扫门迎。\n藻思烟霞润，风神水月清。\n谈诗吾已倦，亦欲学无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱元长北试京兆","author":"于慎行","text":"西风吹桂树，欲发上林枝。\n河畔停舟夜，花前对酒时。\n愁深谈旧事，别久见新诗。\n几日泥金到，山中有梦思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送方胥成山人南游淮上","author":"于慎行","text":"君行复几岁，今夕问归舟。\n客久黄金尽，天寒白露秋。\n寸心酬侠气，斗酒结离愁。\n莫叩淮南幕，中丞抱国忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠邬章甫道契","author":"于慎行","text":"翛然林壑秀，家学似枚皋。\n作客怀长铗，惊人试彩毫。\n旅愁沧海月，归梦广陵涛。\n努力攻骚雅，时名尔易高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中杏花","author":"于慎行","text":"春寒无可奈，愁思入韶华。\n更落瑶台雪，还添上苑花。\n凝妆聊傅粉，待晕始成霞。\n试汎山阴棹，东风满若邪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪后杏花","author":"于慎行","text":"花时惊雪落，雪后见花开。\n夜色梁园度，春香汉苑来。\n飘帘还似雨，闻笛半疑梅。\n冻涩枝头燕，依然社日回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐南龙令君南旋","author":"于慎行","text":"君行良不住，河上理兰樯。\n客梦齐山隔，乡心楚塞长。\n春归见芳草，人去思甘棠。\n日望双凫影，翩飞近尚方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠余古仙山人","author":"于慎行","text":"别久鬓如丝，金门老画师。\n相逢春雨夜，正是落花时。\n能事江湖得，浮踪岁月私。\n旧游今欲尽，君去可依谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月廿八日饮侯六山庄四首 其一","author":"于慎行","text":"问讯东山馆，名花几树开。\n不愁春色去，自有故人来。\n淑影明衣袖，香风近酒杯。\n未须尊俎具，且共倚亭台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月廿八日饮侯六山庄四首 其二","author":"于慎行","text":"地僻宜佳会，春归待主人。\n蝶惊红雨骤，莺狎录条新。\n但听歌盈耳，休辞酒入唇。\n不堪回首地，万里一风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月廿八日饮侯六山庄四首 其三","author":"于慎行","text":"少小欢游地，君家旧竹林。\n每逢春酒夜，常醉绿萝阴。\n树密云过慢，楼高月上深。\n婆娑看老态，颇识故交心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月廿八日饮侯六山庄四首 其四","author":"于慎行","text":"闻钟人未散，倚席兴偏长。\n曲按新声度，花从静夜香。\n青尊何地少，白发几人狂。\n更订明朝约，过予旧草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东园牡丹小会四首 其一","author":"于慎行","text":"老去怜交态，春归念岁华。\n还将今日酒，同对故年花。\n色染丹台露，香流玉洞霞。\n惟应栏槛小，不似五侯家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东园牡丹小会四首 其二","author":"于慎行","text":"园林刚半亩，木药满亭台。\n向日朝犹敛，迎风夜尽开。\n酒从新岁待，客是隔城来。\n俗杀平章第，朱门锁绣堆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东园牡丹小会四首 其三","author":"于慎行","text":"多少东风恨，天香正满林。\n影摇春酒艳，色傍玉楼深。\n乐曲临时制，花名按谱寻。\n清平当日调，回忆久沈吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东园牡丹小会四首 其四","author":"于慎行","text":"倾国俱名品，呈姿媚一堂。\n倚阑浑欲醉，入座转闻香。\n月下千金笑，灯前百宝装。\n夜深春更暖，忍负紫霞觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日饮表弟刘敬宇水亭四首 其一","author":"于慎行","text":"水际芙蓉馆，芳辰每见招。\n车停林外雨，人过竹边桥。\n树影侵杯动，花香入眼飘。\n坐来閒白羽，秋气已萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日饮表弟刘敬宇水亭四首 其二","author":"于慎行","text":"别业中丞旧，新塘凿更奇。\n亭深凫雁渚，树老凤凰枝。\n惜往宁多日，徵欢又一时。\n洗杯酬爱弟，偏忆渭阳诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日饮表弟刘敬宇水亭四首 其三","author":"于慎行","text":"亦有池台胜，如君结搆稀。\n横槎能作榭，蟠木可为矶。\n漫取花行酒，真愁露湿衣。\n层轩销暑气，赤日石林微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日饮表弟刘敬宇水亭四首 其四","author":"于慎行","text":"晚凉犹未倦，改席倚亭阑。\n脍鲤银丝细，调冰玉椀寒。\n笑开桃叶扇，醉岸竹皮冠。\n杯底中天月，还应勒马看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题新蔡水亭二首 其一","author":"于慎行","text":"闻道名王馆，深依上第开。\n花间分岛屿，云里出亭台。\n夏洞藏阴雪，晴流激暗雷。\n不因人境近，只拟是天台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题新蔡水亭二首 其二","author":"于慎行","text":"主君宾客盛，何处席长筵。\n门簇看花骑，池通送酒船。\n星霞垂夜彩，凫雁下秋烟。\n未觉淮山远，空吟桂树篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汎溪","author":"于慎行","text":"一曲无多路，洄沿自觉长。\n近人堤柳细，隔水岸花香。\n放鹤遵莎径，观鱼坐石梁。\n不教渔父问，此地即沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题贞白王孙赤霞馆","author":"于慎行","text":"藉甚天潢彦，才名满帝家。\n书藏东观草，馆号赤城霞。\n梦里常吞锦，毫端自吐花。\n不知银汉水，几日见浮槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五月十三日南溪会集","author":"于慎行","text":"高会南溪始，芳尊午日同。\n登亭来暮雨，敞阁受林风。\n岁月飞花好，河山醉眼中。\n莫閒青玉盏，俱是白头翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七日南溪会集","author":"于慎行","text":"七夕始迎秋，溪亭复此游。\n午凉慵举扇，夕雨罢登舟。\n倚杖窥云树，停杯待女牛。\n只怜天上夜，亦向此时愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七日夜雨","author":"于慎行","text":"佳期方待夜，雨气转氤氲。\n愁望明河影，翻成楚岫云。\n鹊梁何地驾，笙鹤会能闻。\n未悟阴晴理，休将巧拙分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中贞王孙过访少岱山房酬赠二首 其一","author":"于慎行","text":"秋气飒萧森，亭皋夕坐深。\n美人沧洲兴，过我青枫林。\n倚剑冲星气，停杯待月阴。\n小山丛桂在，端复为谁吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中贞王孙过访少岱山房酬赠二首 其二","author":"于慎行","text":"池阁三秋别，山斋七月过。\n车尘花际少，云气酒边多。\n客路搴芳草，征衣带女萝。\n一欢吾欲醉，且莫促鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寺山秋望","author":"于慎行","text":"平楚净寒烟，高丘望渺然。\n日斜虹带雨，野阔水浮天。\n绝塞南来雁，长河北去船。\n荒台题仲父，芜没几千年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山亭","author":"于慎行","text":"雨晴多物态，秋敞坐山亭。\n旧竹泠泠翠，新萝裔裔青。\n荷锄分药径，散帙闭柴扃。\n挂树双言鸟，繁辞尽日听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南溪秋汎","author":"于慎行","text":"野馆无停辙，秋塘有系舟。\n怯同俗客饮，且唤老妻游。\n蝶欲疑红树，鸥应笑白头。\n渔人休借问，此是鹿门俦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小坐","author":"于慎行","text":"小坐霜天夕，空庭竹树深。\n城笳凝暮霭，楼月敛秋阴。\n渐老消尘虑，长贫现道心。\n摩婆旧如意，懒击唾壶吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东园即事","author":"于慎行","text":"蓬门长日闭，俛仰自为欢。\n酹酒邀花饮，分鱼唤鹤餐。\n閒看秋水淡，老觉世涂宽。\n不是无萧索，人间事更难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋东园小集","author":"于慎行","text":"渐上千峰月，真销万里云。\n秋从今夜半，人是旧时群。\n桂影寒应湿，箫声静欲闻。\n相看疑白发，总似兔毫分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日登小岱山","author":"于慎行","text":"九日罢徵欢，孤尊眺岳坛。\n晚烟千室翠，落日万峰丹。\n已有鸿堪听，还无菊可餐。\n江湖回白首，愁见是长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]