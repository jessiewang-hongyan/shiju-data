明_2.csv","pointer":5347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"久雨 其二","author":"黎民表","text":"空斋长昼掩，于世颇无机。\n一雨野池溢，千山黄叶飞。\n林僧看竹少，园客负樵稀。\n试问浮生里，蘧蘧几是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"久雨 其三","author":"黎民表","text":"愁霖淹别墅，朋旧解招携。\n竹偃侵花径，栏倾碍鹤栖。\n苔生吟畔石，虫篆壁间题。\n伫待晨曦至，腰镰课秫畦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"容庵黄公挽词 其一","author":"黎民表","text":"名高鲁单父，孝掩汉黄香。\n绝学笺蝌蚪，清朝咏凤凰。\n乞身书太早，忧国鬓徒苍。\n赖有中郎笔，新镌古道旁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"容庵黄公挽词 其二","author":"黎民表","text":"省署捐华要，山樊适性灵。\n身齐漆园吏，人授济南经。\n紫气龙泉掩，玄堂马鬣扃。\n年年椒糈奠，图象在丹青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄丁戊山人","author":"黎民表","text":"高情怜博奕，几度宿芙蓉。\n琼树海云隔，瑶坛风露重。\n晨餐憩危石，旅服入深冬。\n后夜闻笙处，知从紫盖峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玲珑石","author":"黎民表","text":"险类天门凿，奇方日观悬。\n云移根尚湿，雨滴溜成穿。\n偃壑知灵草，窥窗有瑞烟。\n可怜醒酒处，树木旧平泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月兵入京师十月广州始得平安消息 其一","author":"黎民表","text":"京华愁独坐，蓬径辍相期。\n惊鸟南枝怨，飞鸿北地思。\n龙庭悲鼓角，凤野见旌旂。\n此日江湖梦，偏悬六月师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月兵入京师十月广州始得平安消息 其二","author":"黎民表","text":"插羽喧边郡，游氛薄帝京。\n士皆轻死战，将祇重横行。\n马上青娥惨，腰间宝玦明。\n生灵尔何苦，会见扫欃枪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月兵入京师十月广州始得平安消息 其三","author":"黎民表","text":"气倍临轩日，风生授钺时。\n九边森虎旅，七萃起鱼丽。\n选士皆穿札，徵兵尽死绥。\n圣谟真不战，关塞偃征旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月兵入京师十月广州始得平安消息 其四","author":"黎民表","text":"幽蓟襟喉地，边兵造次来。\n雁门无李牧，马邑有王恢。\n故垒秋阴澹，清笳落日催。\n勒铭麟阁上，应待出群才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月兵入京师十月广州始得平安消息 其五","author":"黎民表","text":"午夜闻班马，清朝遂解围。\n风尘双目短，消息万方稀。\n保障逾青海，宸居正紫微。\n柴门候远使，喜极倒裳衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同易道人过霈上人山居 其一","author":"黎民表","text":"支公禅观处，密义许相酬。\n白黑虽殊致，玄无本一流。\n经翻疏树下，茗宴曲池幽。\n为问浮生里，何人得此游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同易道人过霈上人山居 其二","author":"黎民表","text":"师曾访道去，言至伏牛山。\n残雪经行苦，深林乞食艰。\n心花晴自湛，身界老终閒。\n一衲云峰下，秋来独闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过鹤舒山人别馆","author":"黎民表","text":"却扫元非病，斋心欲断缘。\n残年惟翰墨，虚壁祗灯烟。\n夕露滋团菊，斜阳下冷蝉。\n汉庭今重武，谁好子云玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泰峰为刘处士作","author":"黎民表","text":"习静空斋里，瞻奇仰泰峰。\n白云流绝壁，黛色隐寒松。\n寺与茅檐直，门经竹崦重。\n夜来清梦觉，还得听晨钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从化山水六咏 其一 刘仙岩","author":"黎民表","text":"羽驾今何往，丹梯迹尚存。\n窌藏金粟暗，书积紫苔昏。\n秋水沦妆镜，春风掩洞门。\n空山人不见，白露湿兰荪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从化山水六咏 其二 石鼓楼山","author":"黎民表","text":"片石横江浒，危亭驾泬㵳。\n山烟初幂树，溪水欲平桥。\n游女思捐佩，佳期托采萧。\n登临意无限，猿狖响山椒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从化山水六咏 其三 曲江","author":"黎民表","text":"山色晚幽幽，清溪独放舟。\n轻风低舞蝶，急雨应鸣鸠。\n鸡犬桃花岸，人家杜若洲。\n故园春服好，应不厌经游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从化山水六咏 其四 太平寺","author":"黎民表","text":"为有云房约，来探不二门。\n雨花临近砌，山翠落前轩。\n赞佛还听偈，看心本息言。\n未能超忍辱，聊此涤烦喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从化山水六咏 其五 龙潭","author":"黎民表","text":"侧足应防险，沈竿讵测深。\n神珠浮沼面，宝剑坠潭心。\n草树涵秋碧，烟萝翳夕阴。\n欲知霖雨意，肤寸起遥岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从化山水六咏 其六 杨溪洞","author":"黎民表","text":"远岫横丹穴，危梯倚玉虚。\n长生留秘诀，清隐阅仙书。\n舄本凫飞后，羊知石起馀。\n沧桑那可测，惟见化城墟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"严何二子约予与易居士会海珠不果有诗见诒奉答","author":"黎民表","text":"灵气方予愧，真缘子独深。\n片云凝野思，明月寄遐心。\n罗网鸿飞急，烟霄鹤去沈。\n瑶台知不远，同尔一追寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]