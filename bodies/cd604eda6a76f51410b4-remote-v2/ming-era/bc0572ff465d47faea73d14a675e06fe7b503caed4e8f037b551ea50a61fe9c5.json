[{"title":"戊午交秋患臂作","author":"邓云霄","text":"凉吹惊秋至，孱躯苦病侵。\n萧条一叶下，凄恻百年心。\n壮志看孤剑，流光惜寸阴。\n闲庭聊抱膝，梁父若为吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春朝","author":"邓云霄","text":"熟眠惊鸟唤，晓立傍银塘。\n草嫩风偏软，花垂露有香。\n百年聊偃息，三径问行藏。\n春日迟迟好，人闲更觉长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春晚","author":"邓云霄","text":"随缘皆净土，至贵是闲人。\n独坐园林里，惟将蜂蝶亲。\n群花飞欲尽，百果献犹新。\n君看高车者，徒增两袖尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋莲盛开","author":"邓云霄","text":"蹉跎伤往事，抱膝厌书空。\n旧疾生多雨，馀酲析好风。\n幽怀从澹荡，老景任穷通。\n莫笑栽莲晚，秋花盛作红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"匡云上人同琴客闵谏廷集紫烟楼玩月","author":"邓云霄","text":"新月清如洗，晴光散积阴。\n楼台非色界，天地豁虚襟。\n轻露调云液，和风泛玉琴。\n金波空万里，照见西来心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四月六日立夏李伯修招同匡云上人琴客闵谏廷集署中待月向夕风雨聚对率尔成篇","author":"邓云霄","text":"征歌邀皓魄，已奏紫云回。\n怅望层阴合，俄闻暮雨来。\n银灯吹湿暗，金电划光开。\n颇似兰亭会，临阶好泛杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中元后一夕杨二尹朱三尹过西园玩月听闵谏廷琴","author":"邓云霄","text":"秋意过中元，凉开雨后樽。\n池台澄霁景，风月入清言。\n露重暑全薄，琴闲夜不喧。\n何须魏公子，飞盖亦西园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游淡岩","author":"邓云霄","text":"一峰悬地肺，四壁倚云根。\n但觉堂皇敞，都无斧凿痕。\n烟霞邀客坐，猿鸟与人言。\n可叹神工巧，难容混沌存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"麻滩险路","author":"邓云霄","text":"册子澄霜气，沿江木叶纷。\n滩牙寒喷雪，岩腹暖蒸云。\n处处逢渔父，行行入鹿群。\n谁言方外吏，尚愧北山文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿太平乡王氏虚堂","author":"邓云霄","text":"房栊青嶂里，鸡犬白云边。\n辙迹经虞帝，民风类葛天。\n衣冠淮水远，家世宝刀传。\n客借虚堂宿，秋床抱月眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"行回溪入九疑","author":"邓云霄","text":"胜情催晓发，霜气澹朝晖。\n木落露山骨，溪寒曳水衣。\n人家穿竹暗，鸟道入烟微。\n处处峰峦似，谁能辨是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒舜祠四首 其一","author":"邓云霄","text":"帝德光千古，遗踪在九疑。\n搴芳荐瑶席，酌桂礼彤墀。\n百兽犹环舞，群山相向悲。\n欲知龙蜕处，高嶂觅铜碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒舜祠四首 其二","author":"邓云霄","text":"俎豆传虞代，蘋蘩肃汉官。\n岂应迷冢墓，或恐葬衣冠。\n松韵如听乐，瑶歌似舞干。\n寄言吊古客，当作鼎湖看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒舜祠四首 其三","author":"邓云霄","text":"万里辞黄屋，千秋寄碧岑。\n莫嫌山庙冷，方称土阶心。\n木石时为偶，英皇恨转深。\n微闻松竹里，恍惚凤仪音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒舜祠四首 其四","author":"邓云霄","text":"翠辇虚驰道，玄泉不复通。\n国家同弃屣，日月见重瞳。\n山鬼幽篁里，鹧鸪秋雨中。\n峰头帝子泪，又洒在丹枫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三峰石","author":"邓云霄","text":"登眺穷殊胜，兹峰迥不群。\n烟霄离五尺，楚粤划三分。\n雨过冲雷仗，星飞避剑文。\n南天多物怪，倩汝扫魔军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日访彭贞元留题时适有饷以酒者喜曰吾留客有胆矣可想其风致云","author":"邓云霄","text":"投剌入斋中，应门无小童。\n酒添留客胆，诗不妒人穷。\n侑酌惟黄菊，承家只素风。\n怜君耽市隐，踪迹似墙东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其一 一东","author":"邓云霄","text":"青门在郭东，小筑偶然同。\n只爱山溪胜，非关木石工。\n幽栖宜地僻，简出免途穷。\n自觉悬车稳，揶揄笑阮公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其二 二冬","author":"邓云霄","text":"城池离二里，溪壑隔千重。\n叹世时歌凤，无才愧卧龙。\n偶留人下榻，睡到日高舂。\n晏起科头者，天南一老农。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其三 三江","author":"邓云霄","text":"昔曾为壮士，侠气近来降。\n学道抛金剑，忘怀倒玉缸。\n竹烟朝沐发，松月夜窥窗。\n莫道耕无偶，沙边鹤一双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其四 四支","author":"邓云霄","text":"为园曾几月，花果亦频移。\n燕入惊新主，鸥归识旧池。\n听禽徐度曲，对客细敲诗。\n何必千间厦，巢林只一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其五 五微","author":"邓云霄","text":"小楼穿象外，当夏觅秋衣。\n星宿巡檐度，云霞拂槛飞。\n龙衔真诰下，鹤驾列仙归。\n招手洞天使，何人应少微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其六 六鱼","author":"邓云霄","text":"放浪郊原外，相羊水竹居。\n垂纶聊取适，洗耳异逃虚。\n兰径呼僮扫，芝田或自锄。\n昼长开卷懒，云湿一床书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其七 七虞","author":"邓云霄","text":"荒园浮水镜，人拟小方壶。\n山岳交回护，烟波幻有无。\n客从穿竹至，酒向隔村沽。\n半醉摇渔艇，还如泛五湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其八 八齐","author":"邓云霄","text":"地远人稀到，心闲物自齐。\n醉残卯后酒，梦破午时鸡。\n得句敲青竹，微吟步绿堤。\n幽亭堪点笔，蜗篆已留题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其九 九佳","author":"邓云霄","text":"池亭粗部置，水石略安排。\n碧乳翻茶碗，丹砂贮药斋。\n看山朝更爽，弄霭夕还佳。\n徙倚高台上，雄风快入怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其十 十灰","author":"邓云霄","text":"七载赋归来，柴门静不开。\n故人频劝驾，明主解怜才。\n击水惭鹏翮，生身是鹤胎。\n琼华台畔吏，差可并三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其十一 十一真","author":"邓云霄","text":"宦拙非无命，诗成若有神。\n宫商一以叶，鱼鸟自相亲。\n白眼宜投帻，青云叹积薪。\n未须论出处，草莽固称臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其十二 十二文","author":"邓云霄","text":"自从东郭隐，已谢北山文。\n诗许山僧校，名羞女子闻。\n一竿严濑月，数亩鹿门云。\n借问鸳班客，何如鸥鹭群？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其十三 十三元","author":"邓云霄","text":"抱膝荒凉地，缘何号镜园？\n一溪斜进艇，四沼曲环轩。\n白练烟中净，青铜浪里翻。\n临流闲照胆，挥麈欲忘言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其十四 十四寒","author":"邓云霄","text":"山水绝人境，楼台逼广寒。\n且携修月斧，更整切云冠。\n桂树笼虚阙，银河澜浅澜。\n游仙别有路，指点问星官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其十五 十五删","author":"邓云霄","text":"远枉青莲驾，重瞻紫气还。\n诗名高海内，浪迹寄人间。\n击钵催联句，支颐共看山。\n细谈濠上理，身外得长闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其十六 一先","author":"邓云霄","text":"垒石置浮屋，因名书画船。\n任他风动地，只坐水中天。\n重待石帆驾，轻输莲叶仙。\n何时泛东海，一借祖龙鞭？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其十七 二萧","author":"邓云霄","text":"地近紫霞里，仙踪久寂寥。\n楼台动遐想，笙鹤似相招。\n九转虚丹室，三山透海潮。\n翛然乘兴往，岂惮业风飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其十八 三肴","author":"邓云霄","text":"有地堪藏拙，无心作解嘲。\n琴知闲里趣，水似淡中交。\n清静参禅理，盈虚玩易爻。\n怪无蝇鼠到，蔬笋在香庖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其十九 四豪","author":"邓云霄","text":"既同元亮隐，休续屈原骚。\n骨懒非缘病，名微不用逃。\n百忧缠世网，一醉解天韬。\n直任渔人入，前溪密种桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其二十 五歌","author":"邓云霄","text":"坐久潮侵户，眠多云满窝。\n懒裁穷鸟赋，厌听饭牛歌。\n火宅城中地，冰壶槛外波。\n自无经世策，敢浪说挥戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其二十一 六麻","author":"邓云霄","text":"荒圃惟栽菊，清溪亦浣花。\n藜床临水石，笔格染烟霞。\n静坐乌皮几，闲鞭白鼻䯄。\n马头尘十丈，失笑忆京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其二十二 七阳","author":"邓云霄","text":"辋川同啸咏，千古羡裴王。\n胜地输前辈，高风接后行。\n园林留上客，骚雅共平章。\n试掬池边水，澄泓泛墨香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其二十三 八庚","author":"邓云霄","text":"濯足溪头罢，还随独鹤行。\n迂疏成漫叟，礼法恕狂生。\n好鸟频催酒，清风为解酲。\n眼前多乐事，身后总浮名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其二十四 九青","author":"邓云霄","text":"楼角响风铃，秋声日夜听。\n霞红天似醉，云破月如醒。\n乍觉游仙梦，因之展道经。\n藜光谁借照，太乙老人星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其二十五 十蒸","author":"邓云霄","text":"波光碧四澄，俯槛若怀冰。\n傲骨能轻举，罡风亦可乘。\n龙车随竹杖，月路引金绳。\n近悟逍遥理，高于入定僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其二十六 十一尤","author":"邓云霄","text":"晓起望南亩，烟中听叱牛。\n笑看耕耨者，只为稻粱谋。\n作苦怜终岁，登场喜有秋。\n社觞须痛饮，满瓮足新篘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其二十七 十二侵","author":"邓云霄","text":"无营宜息踵，有客是知音。\n幽意谐山水，高谈遍古今。\n人如沮溺耦，溪比武陵深。\n得句非相促，和风起浪吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其二十八 十三覃","author":"邓云霄","text":"避喧来净土，清景澹相涵。\n山色拖空翠，天光抱蔚蓝。\n翚飞楼直上，鸟鷇手堪探。\n厌苦人间事，嵇康七不堪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其二十九 十四盐","author":"邓云霄","text":"吏隐昔难兼，归休万虑恬。\n濠鱼还自乐，崖蜜为谁甜？\n行处水窥影，坐时风入帘。\n忘言惟抱膝，适意略掀髯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李自得题咏小园上下平韵三十首 其三十 十五咸","author":"邓云霄","text":"众口自喃喃，忧讥更畏谗。\n欲平急水浪，休使满风帆。\n竹牖偏临沼，松庵合傍岩。\n黄精冬可斸，吾已制长镵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南阳吊卧龙冈","author":"邓云霄","text":"哲人高卧处，龙气尚蒸云。\n恩重隆中顾，心劳渭上军。\n奇谋存八阵，天意竟三分。\n多少英雄恨，归鸦带夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入函谷关","author":"邓云霄","text":"枯河走白沙，叠岭锁苍霞。\n谷转蟠蛇脊，崖倾斗虎牙。\n七雄消霸气，四海正为家。\n寄语鸡鸣客，从驰流水车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中滴翠轩杂咏五首 其一","author":"邓云霄","text":"关塞之官远，琴书亦与偕。\n谁栽四翠柏？\n为荫一清斋。\n宦拙世情澹，地偏幽意谐。\n浮生元偶寄，何事强安排？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中滴翠轩杂咏五首 其二","author":"邓云霄","text":"暑气晚来薄，萧萧树自鸣。\n风随微雨到，月向破云明。\n簿领闲曹少，园林野兴清。\n已能齐显晦，渐觉厌逢迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中滴翠轩杂咏五首 其三","author":"邓云霄","text":"有客仕三已，何人岁九迁？\n浮云倏过眼，司命亦无权。\n浪出非初志，微名合避贤。\n夜来牵远梦，多在海鸥边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中滴翠轩杂咏五首 其四","author":"邓云霄","text":"吏散重门闭，翛然太隐居。\n清凉饶树石，苍翠滴庭除。\n薄禄堪供酒，呼僮更种蔬。\n寄言弹铗客，此地本无鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中滴翠轩杂咏五首 其五","author":"邓云霄","text":"癖诗堪一笑，得句享千金。\n比兴皆诸景，推敲哎寸心。\n词坛谁胜负，仕路任升沉。\n试展探珠手，骊龙伏海深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端阳后一日刘觐国招酌署中三首 其一","author":"邓云霄","text":"署近过从易，情深对语真。\n虚堂不受暑，嘉树爱留人。\n渐觉愁城破，转于欢伯亲。\n杯中饶胜地，索醉敢辞频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端阳后一日刘觐国招酌署中三首 其二","author":"邓云霄","text":"报国竟无策，怀归多苦吟。\n秦城连北斗，越客奏南音。\n宦薄从薪积，时危叹陆沉。\n独醒良不易，谁识七贤心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端阳后一日刘觐国招酌署中三首 其三","author":"邓云霄","text":"隐吏容疏放，馀闲且拍浮。\n客筵罗海味，乡思绕龙舟。\n令节过蒲酒，和风度麦秋。\n相看同逆旅，休上仲宣楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘觐国馈菜酬以酒","author":"邓云霄","text":"应念庾郎贫，贻来菜甲新。\n偏怜摘鲜趣，欲作灌园人。\n添我伊蒲馔，酬君曲米春。\n西风万里客，此夕不思莼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度崤","author":"邓云霄","text":"诘曲云生石，崚嶒磴叠冰。\n往来车互击，人马气如蒸。\n古驿通三晋，高原没二陵。\n因嗟割据者，天险未须凭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度圜辕","author":"邓云霄","text":"崤函天下险，尚觉让轘辕。\n百折盘孤径，双崖锁一门。\n秃松云共袅，怪石虎同蹲。\n默忆垂堂戒，吞声未敢言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"襄阳仲宣楼","author":"邓云霄","text":"汉水暂依刘，秦川忆旧游。\n别离悲两地，词赋擅千秋。\n去国人同远，行云客共浮。\n为嫌归思急，不敢更登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度溰州兰江","author":"邓云霄","text":"兰江春水满，兰叶正初抽。\n系马绿杨树，扬帆青翰舟。\n香风吹两岸，旭日照中流。\n慷慨思公子，烟波未易求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"武陵县道旁梅花","author":"邓云霄","text":"积雪犹含冻，孤芳自弄春。\n虽当车马道，不杂往来尘。\n庾岭遥相望，桃源近接邻。\n花神劳指点，吾欲访秦人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度沧浪水","author":"邓云霄","text":"皎洁无冬春，清流一镜新。\n风恬波浩浩，岸险石粼粼。\n鼓枻逢渔父，怀沙吊楚臣。\n长缨行欲濯，凉雨未沾尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"藤江舟中怀周贵谔却寄","author":"邓云霄","text":"烟波凝望远，簿领入舟闲。\n野泊同鸥宿，乡心逐水还。\n开樽聊自劝，得句倩谁删？\n时有寻君梦，柴门莫夜关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日烟雨冥濛同谢在杭方伯陪贾侍御游全州湘山寺","author":"邓云霄","text":"金界踏苔钱，跻攀石磴悬。\n江流通楚粤，梵宇接人天。\n花落双林雨，钟敲万壑烟。\n谁能悟真果，不堕老狐禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟回再咏画山","author":"邓云霄","text":"笑领故人意，诸峰待客还。\n一官贫酌水，两岸饱看山。\n顾盼如招手，徘徊可破颜。\n夜来清入梦，鸾鹤碧云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]