[{"title":"同雪公游千顶纪事十首 其二","author":"释函可","text":"过桥即是辽阳郭，郭外行过泪已潸。\n一郡嗷嗷鸿乍集，千年杳杳鹤无还。\n才看老女孤坟草，又上前王驻跸山。\n我倦欲眠依旧土，嶙峋石壁任孤攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同雪公游千顶纪事十首 其三","author":"释函可","text":"望见叠峰刚八里，到来门径各鲜新。\n不因此地禅居壮，那识长边古佛尊。\n蓄瓜欲比蘋婆味，见树还生桃子津。\n夜半犬声何足怪，山中魑魅亦亲人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同雪公游千顶纪事十首 其四","author":"释函可","text":"经过七里泉声热，欲洗袈裟未有尘。\n前者何曾是山水，从兹无所不精神。\n松阴短短露双塔，梵宇峨峨见一人。\n却喜冻桃初摘下，石坪分啖不辞频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同雪公游千顶纪事十首 其五","author":"释函可","text":"夜来已饱深林气，晓起仍添远壑情。\n暂撇龙泉邻衲意，爱寻唐代旧钟声。\n龛云尚吐将军气，岩石还镌御史名。\n百丈悬萝千折后，门前峰涌万波生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同雪公游千顶纪事十首 其六","author":"释函可","text":"几度登山不到顶，此回到顶畏登山。\n九州细碎烟尘里，万里虚无指点间。\n云在极低那可踏，天虽至近竟难攀。\n急须携手下山去，纵对仙人无好颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同雪公游千顶纪事十首 其七","author":"释函可","text":"半日不离松雾里，牵藤穿穴各忘疲。\n才披破衲瞻新像，旋洗重苔读古碑。\n几处茆堂闻蟋蟀，千年石瓮守熊罴。\n僧头似雪心无事，手煮黄荠进白糜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同雪公游千顶纪事十首 其八","author":"释函可","text":"不借仙人九节杖，石桥几度又攀跻。\n但随虎迹过岩畔，渐听龙吟隔涧西。\n软枣必须亲手摘，老松不过与肩齐。\n淹留两日非关主，坐爱屏风近鸟啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同雪公游千顶纪事十首 其九","author":"释函可","text":"流溪认得曾游处，更欲搜寻到别峰。\n山鬼似嫌黄叶响，洞门都遣黑云封。\n龙芽颇觉僧怀苦，羊肚何妨野味浓。\n惭愧下贤贤太守，难辞林壑一重重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同雪公游千顶纪事十首 其十","author":"释函可","text":"半日浮生閒不得，况连十日遍山扉。\n解开药裹包黄栗，斫得藤条下翠薇。\n入郭愈怜山水好，逢人多与性情违。\n最嫌骢马黄金勒，依旧骑驴独自归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春日","author":"释函可","text":"不辞留滞大关东，未必长吹是朔风。\n一世心归松雾里，十年春到雪花中。\n罗浮消息应非远，粥饭因缘尚未穷。\n从此匝天多雨露，晓听雀语动虚空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元旦哭喇嘛二首 其一","author":"释函可","text":"满头白雪眼双青，方丈时时见执经。\n四海几回悲鹤梦，一枝今又丧龙庭。\n顶门有骨留金字，南塔无人失典型。\n见说国王齐下拜，浮图千古镇沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元旦哭喇嘛二首 其二","author":"释函可","text":"十年吾道塞风秋，葱岭传来恨又稠。\n叶是归根看已落，杯当沉海更无浮。\n大荒一夜霜俱白，毡帐千群泪并流。\n赤县神州心碎尽，更堪洒血极西楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苗鍊师雪中入山相访","author":"释函可","text":"煮穷塞石难充腹，几受刀圭不驻颜。\n开到黄花辞绛阙，携将白发问青山。\n渔舟尚可通源水，鹤羽何曾下世间。\n最苦十洲多少事，寻閒一宿急须还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"季三公书来并寄茶","author":"释函可","text":"自来不作长安字，一纸惊看寄塞垣。\n父子弟兄同友谊，冰霜雨露总君恩。\n十年尚忆三山月，七椀还浇五岭魂。\n大雁欲飞寒逾好，时时传语慰田园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同阿字诸子夜坐","author":"释函可","text":"流光如矢命如尘，冰作生涯鬼作邻。\n岁底又添门外雪，灯前几个岭南人。\n大家共话俱含泪，各自伤心不为贫。\n去去且将拳作枕，梦中同迓故园春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和润季兄临死诗","author":"释函可","text":"赋罢金门泪未收，阵连珠海誓无休。\n崖门一夜洪波接，柴市千年正气留。\n已把发肤还父母，更将心胆寄春秋。\n铁函闻说埋罗岳，何日敲开拄杖头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻赤公专侍在兹省亲回","author":"释函可","text":"尺书才去雪风愁，侍者重来泪更流。\n京国银盘能早献，边庭金策可迟留。\n但闻尊宿仍编履，不信头陀竟覆舟。\n我亦是人添哽咽，夜寒垄草满心头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙申除夕和栖贤辛卯除夕韵","author":"释函可","text":"只因生长在辽东，谁是无乡老此中。\n今夜尽勾积岁念，明朝须发向西风。\n哭犹有泪情非至，吟到无题诗亦穷。\n细看此来真寂寞，眼前还得几人同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁酉元旦","author":"释函可","text":"自信分明两道眉，瓣香拈起更何辞。\n死经万后生方重，春到边来远不迟。\n属国宁堪九岁待，衡阳无复五年移。\n还家自是儿孙事，谁道今年未可知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"解嘲步谦公韵","author":"释函可","text":"北郊笑指峰头老，闹遍千峰两袖书。\n但使倚闾无鹤发，何妨托钵向云墟。\n食残自觉?毵易，载酒犹闻剥啄徐。\n珍重綵衣休惜我，十年甘作雪中蛆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柱江至沈相见有诗和韵","author":"释函可","text":"黑裘未敝耻书生，匹马春风猎猎轻。\n孤管欲收寒谷泪，空囊一泻大江声。\n叔痴不负鸰原梦，僧老难忘鹤岭情。\n世上有人天有眼，千年终厌话荆卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日送阿字","author":"释函可","text":"经岁团圞泪未收，菊花重惹一番愁。\n来将白纸寻黄土，去挟新篇返旧丘。\n太乙峰头频怅望，姑苏台上莫淹留。\n而师若问寒边事，休话寒边雨雪稠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重送阿字","author":"释函可","text":"送送还牵老衲衣，故山终恨不同归。\n好从瀑水投寒句，又向梅花觅破扉。\n冰雪已多曾彻骨，蕨薇虽采未忘饥。\n关门不禁南来雁，何日凌空锡更飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入山有感示诸子","author":"释函可","text":"海角虚舟聊欲寄，深藏大壑亦空劳。\n松根盘石生难直，水势依崖声易高。\n谩说一枝能自稳，便教三窟竟何逃。\n残身久拚馀双眼，万古云霄看汝曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅未央遗集有初夏同予入循州访刘乃运兄弟诗末云令威他日归华表定在循州古树边似为予今日谶也因和其韵","author":"释函可","text":"忆昔同乘访戴船，几人同病合相怜。\n风流云散空予在，雪压尘埋又十年。\n诗卷尚留前日月，梦魂难觅旧林泉。\n何时华表重归去，唳遍累累古冢边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读未央与莂公宅师谈金轮旧事诗有感用原韵","author":"释函可","text":"人世难逢几弟兄，旧编重读不胜情。\n忠臣遗庙清珠海，古佛双林冷莞城。\n地下定知谈往昔，雪中难免恨孤茕。\n只今惟有金轮月，偏向栖贤破寺明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读未央集有先文恪神道碑感赋","author":"释函可","text":"高冢前朝草木凄，灯前雪底泣孤儿。\n良弓久没箕同尽，华表空留鹤尚羁。\n大节已昭悬日月，千秋不朽属文辞。\n遥知定有人来过，系马松根读旧碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻老人复归华首台台上林木加茂有终焉之志恭纪","author":"释函可","text":"飞云峰下即华台，五百何年去复来。\n田地荒芜应再辟，松杉苍郁旧亲栽。\n灵山一会依然在，塞外孤儿尚未回。\n三嘱龙天塞已彻，终期扑鼻岭头梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄华首旧住诸僧","author":"释函可","text":"何人同守故山隅，云散天惊岁月徂。\n豺虎几回经蹴踏，门庭犹喜未荒芜。\n灵峰不逐桑田变，大厦终凭众木扶。\n最苦杨岐旧监寺，泥床长洒雪真珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遥哭刘乃运","author":"释函可","text":"草岁论文尔汝交，柴门雨雪每来敲。\n朝云墓侧新鸳冢，白鹤峰头旧鹊巢。\n留得眉须身后惜，肯将风月死前抛。\n于今哭子全无泪，乡国都来水上泡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻谢伯子赵裕子二老友在喜赋","author":"释函可","text":"少小论交四十秋，惊闻二老足风流。\n长安市上韩康伯，衡岳峰前李邺侯。\n陵谷已移贫未改，亲朋欲尽咏难休。\n白云旧社时来往，定话冰天老比丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄陈三官","author":"释函可","text":"五色凭君写幻躯，流民一幅不堪摹。\n回头细数平生事，屈指曾经念载徂。\n气骨支撑仍是旧，皮肤脱落已全无。\n只今颊上何须问，但写长天风雪图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆暮春同阿字诸子游千山","author":"释函可","text":"到处青山尽有名，大家抖却旧乡情。\n溪边觅路花千树，驴背迎人鸟一声。\n石顶松风凭管领，峰头诗句任交横。\n于今竹杖萧萧去，又向何山踏雪行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻南塔易住持志喜","author":"释函可","text":"六年前此竖幡竿，万古荒芜手辟难。\n一喝青天砂砾净，才挥白拂水云团。\n象王行后狐踪集，良木摧时野棘攒。\n从此斩新条令出，山门依旧海风寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题作么茆屋","author":"释函可","text":"手结枯茆傍古幢，篱边流水亦淙淙。\n只愁云扰常关户，为爱山多尽著窗。\n日午拾柴煨破罐，夜深把卷对残缸。\n山中豺虎原无毒，长护烟霞不用降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜作么迎师入山","author":"释函可","text":"弟子如林汝不才，暮年犹得共徘徊。\n酬恩莫过茅三把，尽孝惟须水一杯。\n衰老久应拚谷底，是非曾不到云堆。\n况兼咫尺予同病，晓夕还同笑口开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"予去冬依證寓今冬依磬光皆手无半文喜赋","author":"释函可","text":"今年贫似去年贫，穷鬼相逢一倍亲。\n两底病肌寒有粟，窗前积雪白为银。\n半瓢薄粥分饥雀，一碟盐齑借远邻。\n处处尽忘宾与主，淡而不厌只因真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"即事","author":"释函可","text":"山中才拆此封书，忆别经今一岁馀。\n路到穷时天更远，力当尽后计偏疏。\n青衫无分常披雪，白发何人独倚闾。\n翘望章江云缥缈，春风何事更踌蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅溪雪中相访","author":"释函可","text":"惊骑瘦卫入山来，为问山僧户始开。\n万里往还君自得，十年先后事空哀。\n囊馀前代书三纸，话到深更水半杯。\n两度鹡鸰原上泪，一时和雪洒山隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中读萝石先生家书","author":"释函可","text":"柴市经过泪已湔，更挥馀泪拜遗笺。\n数行尚自如生见，一线仍存未死前。\n耿耿丹心千古后，茫茫正气万山巅。\n伯夷此日应相笑，重唱薇歌十二年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻李苗两道友有唱酬篇什虽未得读知非凡响遥有此和","author":"释函可","text":"兰沙如雾倩蓝丛，缥缈鸾歌下远空。\n玉露只垂金掌内，仙飙常发御垣东。\n人间兄弟何能及，塞外交游孰与同。\n春到定寻源水入，埙篪坐听碧云中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜闻左三哥回","author":"释函可","text":"终岁呼天恨莫通，归来如旧破囊空。\n交情已见心方歇，遗卷仍存道未穷。\n日冷北堂乌渐老，雪深大漠雁谁同。\n从今稳坐茆檐下，敝絮残毡耐朔风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠少年道者","author":"释函可","text":"少小蹁跹入紫宫，翻疑百岁貌如童。\n种桃花发上林畔，捣药声闻禁苑中。\n巫峡肯沾神女雨，洞庭曾御大王风。\n年年只见天恩阔，不信人间路或穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客有期予春初同入城者","author":"释函可","text":"一卧山中人事毕，重新细碎学威仪。\n休将白眼看林鸟，屡系长衣接涧麋。\n才话入城心便小，尝教伴雪礼何知。\n由来分卫存深意，古佛遗模苦莫辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"日暮","author":"释函可","text":"方悲岁逼夕阳低，寒满空山雪满溪。\n为忆旧居知客眼，偶怀好友得新诗。\n身閒幸不随人转，心苦全然著雾迷。\n抛却杖藜还独坐，壁灯未点暗恓恓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遥哭与然师","author":"释函可","text":"弓剑丛中识面初，半床风雨共欷歔。\n怜予不觉十年过，哭尔仍存万死馀。\n双履已传葱岭雪，空囊犹简白门书。\n何如一副无情泪，岁岁峰头湿破裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牛庄问阿字诸子信不得","author":"释函可","text":"秋风楖枥两肩横，草履狰狞布袋轻。\n沧海无踪鱼有腹，白云有路鹤无情。\n行当野雪衣偏薄，吟向寒梅句亦清。\n老梦独能追去处，依稀犹见弟和兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜云堂禅人入山相访","author":"释函可","text":"未到岁除刚数日，何人骑马入山来。\n欲从南越通消息，曾向东齐拨草莱。\n屋里无过云片片，岩前依旧雪皑皑。\n好归直为而兄道，不是宝山空自回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊戌元旦","author":"释函可","text":"一茎白发荷皇仁，况值年年帝里春。\n千顶曙光云外出，二陵王气雪边新。\n放流久已成乡土，老大无拘只病身。\n是处有山容我住，桃花翻笑洞中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"开经日遥祝檀那卢太翁太夫人双寿","author":"释函可","text":"火宅初离望转奢，何人等与白牛车。\n卢公传法灯千燄，庞老齐眉佛一家。\n曾嘱王臣山上会，新开龙藏海东涯。\n人天百万欢同祝，遥献优昙一朵花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠汤官师","author":"释函可","text":"万里相依岂偶然，选官选佛似君贤。\n薇羹屡为伯夷饿，草榻偏容普化颠。\n膏泽诸山时沃若，清风四壁本萧然。\n昼长客去无馀事，一卷金刚自岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠藏主师","author":"释函可","text":"惊传白马度关来，大法东流亦快哉。\n剖出微尘凭慧力，插将茎草仗雄才。\n竿头但进看飞凤，麈尾时挥起怒雷。\n沟壑馀生吾自分，双眸何意独君开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步沧兄见寄韵二首 其一","author":"释函可","text":"知罪从他尔独亲，怜予万里一孤身。\n平生本自无相识，世上于今有几人。\n清泪屡凭沙塞雁，衲衣犹寄玉门春。\n惊闻杖屦南中去，风雨萧萧入梦频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步沧兄见寄韵二首 其二","author":"释函可","text":"故人何处思沧茫，幸有音书未久荒。\n布帽残经情缱绻，黄沙白日泪淋浪。\n归来几见千年鹤，梦去还寻五石羊。\n门外孤松高百尺，寒霄犹得伴冰霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠天鉴师时将还孤竹省墓","author":"释函可","text":"共向高林借一枝，心期万古可谁知。\n织鞋有恨陈尊宿，玩月今同王老师。\n寒碛顿能忘患难，衰颜偏自惜分离。\n公归无复薇堪采，雪满千山足疗饥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"正修书记录成来呈","author":"释函可","text":"笑汝经年执管随，长言短句益支离。\n丰干到死还饶舌，觉范投荒亦赋诗。\n秋老野鸿书远碧，夜深山鬼哭空池。\n如何录取声前话，风静高林月落时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得张觐仲书","author":"释函可","text":"忽惊天上寄来书，火尽西园一木馀。\n苜蓿有根开绛帐，芙蓉无蒂碎香车。\n儒门淡泊思灵鹫，芸阁荒颓泣蠹鱼。\n垄草尚沾半子泪，雪中翘首几踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"枝上雪二首 其一","author":"释函可","text":"鸟宿寒枝动，晴天雪更飞。\n既沾台石冷，复上老僧衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"枝上雪二首 其二","author":"释函可","text":"叶尽枝方满，时时飘素埃。\n晚风吹未了，疑是野梅开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"残叶","author":"释函可","text":"已被晚风促，复受晓霜侵。\n亦知终不久，珍重片时心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题范宽真迹","author":"释函可","text":"岩壑层层古，全非近日山。\n山中最深处，置我于其间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同大翁看古帖","author":"释函可","text":"一笔笔模楷，一叶叶精神。\n骤喜多酬接，徐思晋代人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题大士像","author":"释函可","text":"终不得自在，即此苦何穷。\n愿取杨枝水，一洒朔庭空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"残菊二首 其一","author":"释函可","text":"残菊深秋里，无人雪一堆。\n莫嫌憔悴甚，曾见十分开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]