[{"title":"山居","author":"刘麟","text":"钟定添香坐，鸡前宿火眠。\n竞辰聊散帙，入己即逃禅。\n永日图南榻，轻风范蠡船。\n若无风雨病，不负古稀年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16775,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东闻一山二首 其一","author":"刘麟","text":"耕稼苦不饱，皇天意若何。\n渥恩忠士少，清福善人多。\n取适尊三戒，息机消百疴。\n泰道本无事，盐梅空自和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16776,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东闻一山二首 其二","author":"刘麟","text":"鸡犬下柴扉，桑榆转夕晖。\n力食知今是，酣觞过古稀。\n杪秋辞药物，中夜揽裳衣。\n道情无著处，风竹正依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16777,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏竹屏","author":"刘麟","text":"老圃无穿凿，多君自作屏。\n初萌儿女象，解箨弟兄情。\n风戛鸣珰近，烟栖翠幄横。\n老人逢细字，为尔早篝灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16778,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与吴甘泉三首 其一","author":"刘麟","text":"抱病多沉思，开怀喜奉君。\n黄花雨外夕，白发社中人。\n酒泛诸峰绿，诗传五字新。\n鸺鹠忽不语，幽赏向谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16779,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与吴甘泉三首 其二","author":"刘麟","text":"重阳不风雨，芳宴更逢君。\n采菊年年节，登高处处人。\n病与山形瘦，愁随鹤发新。\n鸣丝间清吹，向晚为谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16780,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与吴甘泉三首 其三","author":"刘麟","text":"自家五湖上，弄水辄忘归。\n落日看蓬鬓，临风浣故衣。\n食贫随自省，传病见官稀。\n舍比林和静，寒梅对掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16781,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠耿郡伯","author":"刘麟","text":"晚岁河梁别，惊尘失雁行。\n宦游多慨感，君至有辉光。\n物润班班雨，天晴夜夜霜。\n汉廷还汲黯，犹自重淮阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16782,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与李半溪二首 其一","author":"刘麟","text":"文字百年饮，衣冠千里同。\n好事竞为主，忘年耻作翁。\n欲祷言皆应，赓歌句转工。\n终筵能淑慎，监史愧无功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16783,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与李半溪二首 其二","author":"刘麟","text":"我欲占春饮，纡衡心事同。\n悬知传舍客，未卜主人翁。\n酒熟先扳醉，诗成莫问工。\n交深敢自慰，名教有微功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16784,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"飞玉台成","author":"刘麟","text":"眠云初构寝，歌凤筑层台。\n披豁三光入，虚涵万象开。\n看花能独坐，秉烛喜重来。\n真人腾日问，飞玉到山隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16785,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"凝香寝成二首 其一","author":"刘麟","text":"天上元无寝，书边旧有台。\n爽气朝朝入，翔云面面开。\n一叟披裘坐，群公驾鹤来。\n异香乘紫气，浮动碧云隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16786,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"凝香寝成二首 其二","author":"刘麟","text":"台小已成趣，豪吟客未来。\n首山当户牖，散帙出蒿莱。\n迎驹过白隙，送兔下苍隈。\n脉脉凝香卧，焉知葛与怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16787,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"霁宇","author":"刘麟","text":"旴望本无期，烟云敛尽时。\n轻风燕雀语，丽色凤凰枝。\n邺架书摊遍，谢屐去何迟。\n古初一披露，真宰不能知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16788,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"颁朔待漏","author":"刘麟","text":"一统车书又纪年，爉灯烧夜对风烟。\n番番月令迎新候，剪剪春风向晓天。\n玉律总颁皇帝朔，金莲尝赐近臣筵。\n共期膏泽为民下，莫漫心煎感岁迁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16789,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"己丑科殿试阅卷","author":"刘麟","text":"宫阙东偏紫阁西，九官分局主恩齐。\n明明抚运收才俊，穆穆临文自品题。\n手诏日中垂藻鉴，御书时暝散云霓。\n安车打伴南宫宿，中使宵传有御批。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16790,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天寿山公干二首 其一","author":"刘麟","text":"风雨驱车出禁城，侍臣辞印暂经营。\n壮游兄弟今谁健，老去君臣自有情。\n千古威灵如日近，九霄香火与云平。\n椒房七载恩多少，漫别君王向此行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16791,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天寿山公干二首 其二","author":"刘麟","text":"鹤袍病骨兼山役，祷祭虔诚欲代天。\n雨过红门千嶂出，云归玉殿九龙眠。\n诛茅辟土怜今日，短柏新松拟万年。\n圣寿无疆仙驭远，老臣垂涕洒寒泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16792,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"分献北海","author":"刘麟","text":"氤氲佳气布遥空，肃穆皇禋仰帝宫。\n夕驾鲲鹏珠斗外，夜交溟渤彩云中。\n幽都宅润归神贶，玄象无波识圣功。\n赫赫司徒时并入，曲阳飞石泰坛东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16793,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"顾华玉谪官全州二首 其一","author":"刘麟","text":"暂屈高贤论未平，召归行见圣心明。\n共怜此夜参辰散，独向殊方瘴疠生。\n衡岳长沙才子路，澧兰沅沚故人情。\n中州父老忧何剧，堕泪甘棠有颂声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16794,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"顾华玉谪官全州二首 其二","author":"刘麟","text":"远道新恩意若何，到州惟有桂婆娑。\n气还光岳完名少，天晚才贤谪宦多。\n心逐雁书回岭路，香分兰佩隔湘波。\n千年屈贾真知己，尚想摛词独酹过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16795,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"恒阳饯乔白岩二首 其一","author":"刘麟","text":"斗柄潜移忽指西，苍凉呈影众星稀。\n古云残柳知谁绿，闲苑流莺转自啼。\n日日风雷闻偃稼，汤汤霖潦惜沾衣。\n当年太华峰头路，应与图南订此归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16796,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"恒阳饯乔白岩二首 其二","author":"刘麟","text":"雨昏书剑对秋看，衢路冥冥生昼寒。\n时羡叔孙终制礼，人荣疏傅早辞官。\n交深不谓离群易，才大惟忧用世难。\n一笑浮图高处别，此中犹可望长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16797,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄李古冲太宰","author":"刘麟","text":"冂寺论文气独雄，真才端拟亮天工。\n金渊刻烛春翻蝶，苕水传觞秋转蓬。\n展氏道昭三黜后，刘桢今在九人中。\n武夷高并神仙宅，谢屐张槎好过从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16798,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿文衡山","author":"刘麟","text":"人日冲泥献寿卮，追惟旧学老吾师。\n际天丘壑聊挥翰，满目风云尽入诗。\n淇澳青青歌竹后，渭川瀰瀰得鱼时。\n仁明见说东朝出，何事商山久茹芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16799,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题许柳溪太守卷","author":"刘麟","text":"经书万卷世生香，曳履星辰总雁行。\n列戟门墙犹谨厚，一麾江汉自循良。\n天垂湛露恩难并，风继甘棠业有光。\n谁绘柳溪溪上柳，映空膏雨似郧阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16800,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日道中","author":"刘麟","text":"贱买鱼虾换酒尝，溧阳风物似丹阳。\n疏林细雨开精舍，古岸惊飙迟短航。\n满饤盘餐逢野老，久张衾枕住他乡。\n搴帷远忆西溪叟，愁见春鸿有断行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16801,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"开新社","author":"刘麟","text":"摇曳舟车上国来，欢游不许鬓丝催。\n湖心夜月思君并，岩畔春花逐我回。\n醉有狂歌书草木，閒寻往事扫莓苔。\n江城别社收耆旧，转眼湖南有弃才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16802,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卜里","author":"刘麟","text":"人日驱车向溧阳，寻幽择里静中忙。\n官无苛政民风古，国许蠲租帝泽长。\n星驾独回凫雁曲，钓台遥亘水云乡。\n鸱夷老去难匏系，虾菜閒情伴野航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16803,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送周司寇","author":"刘麟","text":"野寺淹流雪满枝，锦帆何意厌春迟。\n千年神剑知离恨，一夕寒灯长鬓丝。\n卿月乍临南极上，法星常照楚江湄。\n更携经笥翩翩去，碧草溪连处处随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16804,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦岱屏崔京山","author":"刘麟","text":"寻君不似梦君频，永夜添香养道真。\n下榻论文光烱烱，升朝对面礼循循。\n腰横卞玉轻于叶，手挽吴钩绝有神。\n一咏百篇星汉落，虚怀犹避太常人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16805,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"僧慧过访","author":"刘麟","text":"泠泠碧润转林霏，旭日诸峰散远辉。\n小立暗香常袭履，缓行空翠欲沾衣。\n高僧偶过分馀静，乡使遥传讶久违。\n门有扁舟从箬下，清酣长望两凫归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16806,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岘山社燕","author":"刘麟","text":"岘山能醉即香山，蔗境谁人识最闲。\n冉冉慈云生海屋，霏霏紫气隐禅关。\n千年好事同声应，九老真风一笑还。\n寄语元丰诸将相，有人图入会昌间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16807,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与蒋石庵","author":"刘麟","text":"病入新年较转多，光回腐草竟如何。\n尊踰九老终当避，义重三生强一过。\n露浥金茎人尽醉，春融玉烛鸟齐歌。\n雍容宫保天垂眷，八帙挥毫鬓未皤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16808,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与陆玉厓","author":"刘麟","text":"古来明哲重先几，伯玉空知往岁非。\n夜月辉辉开李酌，秋风瑟瑟洒陶衣。\n沧桑只在身前变，松菊真从梦里归。\n最忆与君为别处，烹羔送酒说渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16809,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏乔桂","author":"刘麟","text":"醉捻高枝当酒筹，少年折此比仙游。\n今抛世事死前死，不向人间求所求。\n枝叶尽除皆实地，高明渐近是吾楼。\n谁云月窟无门径，短梦能栖最上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16810,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登观海楼","author":"刘麟","text":"乘桴老去笑无功，莫以周流叹道穷。\n六街车马浮烟外，千里鸢鱼一镜中。\n揽胜欲呼今夜月，凭虚时溯古人风。\n报君此去蓬莱路，况复朝宗尽向东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16811,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"平望舟中","author":"刘麟","text":"鹰脰湖边送客归，刚谈今是又全非。\n凤凰枝上披云锦，牛斗声中赋短衣。\n韩干惯传神骏骨，严陵不下老渔矶。\n独怜殊胜僧无事，载笔牵裳过虎溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16812,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和蒋石庵司空社韵","author":"刘麟","text":"风情常系白鸥堤，时序频惊紫燕泥。\n造物无情人自改，山灵有相道盟齐。\n都将健体酬佳句，合把深杯酹此溪。\n一笑几时头转白，烦君莫负手中藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16813,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次白岩山巾韵","author":"刘麟","text":"古制新传手自裁，满头潇散看云来。\n欹如孟老元宜菊，折似林宗不受埃。\n凫履有情从此狎，鸥机惯见不相猜。\n皤然洛社群公里，黑发高簪共草莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16814,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同白岩游苍岩二首 其一","author":"刘麟","text":"直穷幽胜几人来，两壁齐云绣若堆。\n丹垩横空飞阁起，螭龙擎日梵宫回。\n僧栖石罅头颅易，花散珠林眼界开。\n方外闲居为第一，扫烟时卧说经台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16815,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同白岩游苍岩二首 其二","author":"刘麟","text":"岩阴铁?度行云，天乐真从上界闻。\n绝涧俯看云起处，危梁倒跨石中分。\n醉磨苍藓留题遍，静倚青松弥盖勤。\n五十年来方一到，可教三宿又离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16816,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻征都匀讽曹中丞","author":"刘麟","text":"都匀虽固且休征，国有吁谟不在兵。\n入井祗须怜赤子，开疆何以及苍生。\n古称干羽还能格，近用羁縻亦暂宁。\n我忆麟台赵充国，屯田千载有馀名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16817,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"恭遇册立中宫","author":"刘麟","text":"王教开端万古传，厚哉坤轴上承天。\n洽阳渭涘祥何定，丰水岐山数已先。\n荇菜入歌风穆穆，雎鸠有象兴翩翩。\n因怜至圣刑于化，须和周南第一篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16818,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"甲辰春社","author":"刘麟","text":"曳履晨征试越罗，芳园践约正春和。\n琴心迭奏临幽涧，酒意微醺上曲阿。\n张弛总关吾道在，风情未必古人多。\n尧天荡荡浑无事，击壤相将起浩歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16819,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送龙致时回金陵","author":"刘麟","text":"山馆梅开又落花，归心日日渡江沙。\n孤舟怅望平湖尽，尊酒流连春日斜。\n与子共分清涧水，几时还入白云家。\n好知学道须凝静，莫漫都城恋物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16820,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖上晚渡","author":"刘麟","text":"老兴翩翩只自由，皇天赐得五湖舟。\n花开酒美不一醉，水满月明常独游。\n处处登楼频吊古，年年垂钓尽销忧。\n有时鼾睡乘流去，夜度香山芦荻洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16821,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"投閒","author":"刘麟","text":"春船载酒随鸥去，曲曲陂塘草自生。\n棹拂浪花迷远近，窗迎云月问阴晴。\n常收药物年年健，早蜕尘缨事事轻。\n一上神楼愁更下，始知閒处有勋名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16822,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"植江莲","author":"刘麟","text":"谷口春泉一镜开，深深径路接层台。\n幽栖谢客常无事，老兴看云只自来。\n欲著方书酬白发，好将生理付青鞋。\n多君为我沉疴计，玉井芙蓉愿早偕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16823,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李民育诞日","author":"刘麟","text":"郁葱佳气抱层台，竹里宾筵取次开。\n隔座笙簧缘岸起，倚天屏障入帘来。\n逡巡送酒客拚醉，顷刻能花仙有才。\n会报赤城丹诀献，光垂南极在霞杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16824,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻京师建社二首 其一","author":"刘麟","text":"京国谁开社约新，乾坤一脉系情亲。\n尽登耆旧归仁里，莫遣风流落后尘。\n草草盘餐从古俗，班班图史总天真。\n春筵朗月通南极，常照江城鹤发人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16825,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻京师建社二首 其二","author":"刘麟","text":"古俗淳庞百好空，我来开社少人同。\n春来耕凿王民后，老去衣冠圣泽中。\n翻笑乡音咻众楚，却沽村酒似新丰。\n月明乌雀桥边路，照见柴车鹤发翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16826,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与西溪甘泉联句三首 其一","author":"刘麟","text":"幽谈不尽坐寒宵，懒性真能远市朝。\n卧向好山犹是梦，饮从邻叟不须招。\n灯前白发人俱健，身外浮名念已销。\n他日里中还结社，一溪风月醉兰苕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16827,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与西溪甘泉联句三首 其二","author":"刘麟","text":"折竹声频夜已沉，梦寒应绕玉山岑。\n溪容隔岁将移棹，草色逢春映盍簪。\n雨暗细评高士传，地深时见古人心。\n明朝更有南池约，吟对梅花思转深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16828,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与西溪甘泉联句三首 其三","author":"刘麟","text":"隔帘风絮正漫漫，点壑穿岩好醉看。\n冷色映貂秦岭上，冻云浮槛越溪寒。\n低回玉女凝妆素，偃蹇山翁得句难。\n笑索梅花转墟曲，杳然清梦落江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16829,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄白岩太宰","author":"刘麟","text":"苍岩高处少人行，宦不为家去住轻。\n病后形骸皆长物，老前丘壑有馀荣。\n即看彩鹢浮星汉，不用朱旗插斗城。\n寄语早朝钟鼓客，北窗红日正希升。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16830,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李民育别号有竹","author":"刘麟","text":"洒洒新梢正倚空，岁寒门巷几家同。\n清阴不断三湘雨，净色长含万里风。\n欲借劲枝为椽笔，更裁高节制渔筒。\n狂来直造非无为，看竹何须问主翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16831,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿张水南学士","author":"刘麟","text":"忆昔论文傍紫微，碧桐丹棘共菲菲。\n青宫进讲恩常并，玉殿含香愿不违。\n道在师儒身渐达，人归启沃事全稀。\n遥瞻寿域开天阙，却诧文星在近畿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16832,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"孙太白苕溪草堂","author":"刘麟","text":"归藏卜筑向澄潭，鸥鹭初盟亦未寒。\n砚墨洗云沉静影，钓丝垂月乱文湍。\n风前远啸应轻阮，雪里深居不愧安。\n有约过来东望剧，少微腾彩动秋峦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16833,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与吴甘泉登董㠗绝顶","author":"刘麟","text":"山当天半气全清，影入湖波觉世轻。\n足下过云应缥缈，此中看月更分明。\n狂来欲赋倾才思，醉后重登是性情。\n却向归樵时讯问，转疑深麓可逃名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16834,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画","author":"刘麟","text":"黄石赤松师授迟，梦中牵引住茅茨。\n充闾又识曾孙面，赐杖仍过八帙期。\n陶令真陶惟任酒，放翁能放不缘诗。\n含情欲问磻溪叟，断送仙凡一钓丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16835,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦得九十","author":"刘麟","text":"晨起常先夜卧迟，曾无昼寝亦无诗。\n痴顽正合玄虚妙，辛苦都非利禄时。\n天上归来无鹤伴，谷中剩住有僧知。\n百年本是囊中物，只以徇名损一期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16836,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南野堂用韵似陆柱史","author":"刘麟","text":"高谊如君迥不邻，晚于夷险见情真。\n当台持简久无与，满阁著书还几人。\n共引江湖怀往日，独分花鸟向青春。\n更嗟尧舜方图理，却使山中有逸民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16837,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别孙太初二首 其一","author":"刘麟","text":"住本无心去亦轻，江湖深处更逃名。\n水能回棹如多恨，山不留君空自清。\n细草长松收健句，夕阳朝雨对离情。\n云鸿未隔人间路，应报红颜羽翼成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16838,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日","author":"刘麟","text":"初日轻烟隐薜萝，转疑诗句在山阿。\n道人不上青峰久，黄叶忽随霜鬓多。\n独把菊杯迎物候，故偏风帽起高歌。\n川源净好能无雨，如此重阳一谩过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16839,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]