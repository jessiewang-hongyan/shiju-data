[{"title":"送李方水还临高学署 其四","author":"成鹫","text":"啼莺恰恰燕喃喃，欲别难为越俎谈。\n我纵无言君也会，十年不枉是同参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽梁祖寿 其一","author":"成鹫","text":"韦曲江边老钓翁，自怡堂上主人公。\n当初不合曾相识，直至山穷水又穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽梁祖寿 其二","author":"成鹫","text":"与君结发欲超尘，底事蹉跎各有因。\n君若果行予早决，清风明月两閒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽梁祖寿 其三","author":"成鹫","text":"身前身后为谁忙，手辟田园日就荒。\n似我为僧君不可，似君正好哭千场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽梁祖寿 其四","author":"成鹫","text":"十载参方久不归，碧山风景想依稀。\n昨宵有梦分明甚，一路缁衣送白衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽梁祖寿 其五","author":"成鹫","text":"海外归来已四年，相过有约苦无缘。\n如今未卜重来否，云散长空月在天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠岑金纪 其一","author":"成鹫","text":"热肠冷局老相知，同调非君更有谁。\n好似红炉与冰雪，相逢刚是岁寒时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠岑金纪 其二","author":"成鹫","text":"壮志销磨春复春，雄冠抛却返儒巾。\n谁知绛帐谈经者，还是当年借箸人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠岑金纪 其三","author":"成鹫","text":"少年场里老诗翁，郭外行吟草色中。\n踏上蹇驴人尽笑，风流还与据鞍同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠岑金纪 其四","author":"成鹫","text":"樽中酒尽更当沽，笑指腰间旧辘轳。\n本是虬髯老狂客，冰霜无奈上髭须。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠岑金纪 其五","author":"成鹫","text":"绛帻绯衣拥腐儒，酒阑看演铁冠图。\n壮心一夜消难得，莫怪当筵骂灌夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠岑金纪 其六","author":"成鹫","text":"古匣重缄涩不开，无端夜半作风雷。\n中间隐有龙蛇泣，白发先生赚我来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠岑金纪 其七","author":"成鹫","text":"静中日月闹中过，灯下棋声杂笑歌。\n我局未终先袖手，看君覆局更如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠岑金纪 其八","author":"成鹫","text":"退步知君已得仙，竿头须信有真禅。\n东林久作居亭主，怅望伊人六十年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蔚园弟五十一题古松图以赠","author":"成鹫","text":"虬髯落落实离离，笔墨何心作此奇。\n共道岁寒有孤干，后凋谁识是连枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送六幻师归珠崖东山 其一","author":"成鹫","text":"三月海波如掌平，东风吹送一帆轻。\n还家踏著来时路，不用旁人为指程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送六幻师归珠崖东山 其二","author":"成鹫","text":"茫茫大地总无禅，借路归家得悄然。\n昨夜铁牛奔渡海，一时还尽草鞋钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送六幻师归珠崖东山 其三","author":"成鹫","text":"浩歌归去有来由，万水千山一钵收。\n别后相思何处所，月明人在钓鱼舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送六幻师归珠崖东山 其四","author":"成鹫","text":"曾宿东山山上寺，至今犹复忆前因。\n送君好好还山去，从此居亭有主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送六幻师归珠崖东山 其五","author":"成鹫","text":"多异山中白额虎，龙池池上赤梢鱼。\n相逢为致殷勤意，别后枯禅已废书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送六幻师归珠崖东山 其六","author":"成鹫","text":"海外相随小犊儿，于今长大渐成痴。\n从师归去烦收管，耕月犁云好及时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送徒大机还珠崖","author":"成鹫","text":"当年渡海为从师，学得而翁一半痴。\n从此要归归便得，不须还问再来期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄多异山元达上人","author":"成鹫","text":"不见支公已六春，别来世事一番新。\n明明止有山中月，长照灵泉旧主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送增城王广文归海南侍养 其一","author":"成鹫","text":"始以老亲求禄养，还因亲老乞归田。\n儒官出处关名教，忠孝如斯两得全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送增城王广文归海南侍养 其二","author":"成鹫","text":"有子由来万事足，无官方信一身轻。\n三年薪俸无馀物，却道先生宦已成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送增城王广文归海南侍养 其三","author":"成鹫","text":"宦成归去复何如，重著莱衣赋遂初。\n从此北堂多胜事，不须白发倚门闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈德山 其一","author":"成鹫","text":"世外相知已十年，于今见面两无缘。\n峰回岳势潮归海，水满盘中月在天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈德山 其二","author":"成鹫","text":"造物茫茫用意深，一回写恨一沉吟。\n山僧本欲全拈出，恐退檀那正信心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈德山 其三","author":"成鹫","text":"昨日堂前客似梭，今朝门巷好张罗。\n当时不少知恩者，借问谁人报称多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈德山 其四","author":"成鹫","text":"一饭斋僧具百珍，千金布地不辞贫。\n庭前老树曾生耳，多少虚消信施人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈德山 其五","author":"成鹫","text":"万里珠崖水牯牛，故山归去几经秋。\n主人青眼空悬望，鼻孔撩天不转头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈德山 其六","author":"成鹫","text":"向平婚嫁尚绸缪，五岳先为梦里游。\n八识田中难了事，知心惟许老汤休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈德山 其七","author":"成鹫","text":"世路风波同苦海，人情轻薄似秋云。\n重来未敢还相许，直待龙华更识君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈德山 其八","author":"成鹫","text":"池上千华开九品，阶前群玉秀三枝。\n悬知鹤梦归来日，正是华堂昼锦时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈德山 其九","author":"成鹫","text":"大隐由来在市城，生前不愿见干旌。\n留将遗像虚堂挂，却遣裨官识姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈德山 其十","author":"成鹫","text":"自抱无弦未易弹，钟期去后赏音难。\n高山一曲谁知者，多少旁人侧目看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"砚沙","author":"成鹫","text":"留将片石住江心，却被波臣用意深。\n多少宦成经过此，轻舟安稳载南金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗隐溪","author":"成鹫","text":"钱塘江上古先生，姓字传来水亦清。\n漫向此中寻旧隐，世间多半是虚名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"憩庵","author":"成鹫","text":"十里遥闻下院钟，到门空见白云封。\n老僧久住情偏淡，惟有春山色最浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"百丈岭","author":"成鹫","text":"峻岭度来平似砥，下方回首曲如弓。\n行人记得开山日，踏破芒鞋成老翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九曲径","author":"成鹫","text":"莫疑吾道太孤危，渐入应知渐坦夷。\n万仞登峰无等级，曲垂方便与君期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"先觉岩","author":"成鹫","text":"觉地何曾有后先，银山铁壁任高悬。\n化城有路人难到，待我閒身来坐禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞水潭","author":"成鹫","text":"玉立云飞花满岩，天风吹雨下松杉。\n人间得此都无用，留洗青州旧布衫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云顶","author":"成鹫","text":"云外青山山外云，现前宾主倩谁分。\n自从一上孤峰去，始信见闻非见闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"菩提路","author":"成鹫","text":"菩提无路绝跻登，独往独来何处僧。\n分明踏著空王顶，更问诸方到未曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塔院","author":"成鹫","text":"顽铁精金共一炉，虚空推出古浮图。\n六窗八户无门入，谁识分身是丈夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"木人居","author":"成鹫","text":"寂寂虚堂春草深，百花开遍语幽禽。\n木人不是无情者，遗像依稀昨日心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"指月楼","author":"成鹫","text":"长与青山作比邻，溪光云影自相亲。\n楼头片月分明在，谁是当年指月人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旃檀林怀旧","author":"成鹫","text":"林下伊人旧盍簪，名山有约事清谈。\n旃檀长者今何在，月满长空水满潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新晴晚望崧台","author":"成鹫","text":"崧台旧路昔曾经，回首山川入渺溟。\n雨过停舟动高兴，白云飞去数峰青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊端水","author":"成鹫","text":"江天霁色一披襟，斗柄东回接远岑。\n漫把游心戒僮仆，春光不定是晴阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓行","author":"成鹫","text":"佳游不惮趁清晨，野鸟啼花解唤人。\n有约重来春又半，青山无恙待间身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端州道中","author":"成鹫","text":"病来两脚几蹒跚，闯入严城为爱山。\n陌上行人无旧识，相逢不用较忙閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅江楼怀古","author":"成鹫","text":"新莺啼遍旧皇州，端水无情日夜流。\n惆怅美人何处所，不堪重上阅江楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"包孝肃祠","author":"成鹫","text":"孝肃门前车马声，野棠开后百花生。\n昔人如水今如市，古道谁为掉臂行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝月台","author":"成鹫","text":"咫尺湖光远近山，花宫长在水云间。\n严城晓辟门犹闭，清磬一声人自閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沥湖","author":"成鹫","text":"隔水看山兴转遥，遍将前路问渔樵。\n沥湖雨后深如许，珍重扶筇过板桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水月宫","author":"成鹫","text":"古殿崔嵬倚洞门，门前过客尽乘轩。\n逢僧懒说山中话，笑指荒苔屐齿痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"熊开府祠","author":"成鹫","text":"马革囊尸当令终，臣心应与佛心通。\n南人尽识熊开府，不改衣冠护梵宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七星岩","author":"成鹫","text":"别通一路仰窥天，深入重崖直到泉。\n何事频来观不足，璇台云物石房烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"圆虚岩","author":"成鹫","text":"古洞云深昼不开，老僧相见却相猜。\n山门一径纤如发，借问游人何处来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海螺岩","author":"成鹫","text":"木客鸣鸣吹海螺，谷神踏踏来和歌。\n谁人凿破混沌窍，天籁无心奈若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石鼓","author":"成鹫","text":"须弥椎打虚空鼓，消息惟教风穴知。\n顽石自来能解语，希声何必问冯夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石钟","author":"成鹫","text":"高悬片石万山中，一扣一鸣空合空。\n剩有馀音风过耳，泠泠飞出老龙宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙掌岩有怀圆老师","author":"成鹫","text":"此是吾师安稳处，故山回首锁烟霞。\n昔游记得重阳日，篱菊旋抽两度花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续西园咏木芙蓉后十五韵 其一","author":"成鹫","text":"自断荣枯休问天，看朱成碧总非然。\n繁华落尽秋风里，陆地花开又一年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续西园咏木芙蓉后十五韵 其二","author":"成鹫","text":"弱叶柔柯覆板桥，涉江不用买兰桡。\n秋光过眼成朝暮，几度新花换旧条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续西园咏木芙蓉后十五韵 其三","author":"成鹫","text":"白鸟低飞定露巢，赪霞高罥缀霜梢。\n野塘秋色如春色，摇落犹堪作解嘲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续西园咏木芙蓉后十五韵 其四","author":"成鹫","text":"艳质由来不易牢，藕房零露委寒皋。\n孤标独立群芳外，相伴幽人读楚骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续西园咏木芙蓉后十五韵 其五","author":"成鹫","text":"溪上看花能几何，红颜回首白头多。\n儿童争唱莲花落，招得芗魂过别柯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续西园咏木芙蓉后十五韵 其六","author":"成鹫","text":"一度秋风一度花，疏篱隔水有渔家。\n老人独坐倚芳树，溪月和烟笼绛纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续西园咏木芙蓉后十五韵 其七","author":"成鹫","text":"叶并秋葵怯早霜，花兼朝槿度斜阳。\n与君相去溪南北，红蓼苍葭各一方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续西园咏木芙蓉后十五韵 其八","author":"成鹫","text":"晓露光团白玉京，夕阳红沁赤霞城。\n蹉跎一日成今昔，惆怅花前落叶声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续西园咏木芙蓉后十五韵 其九","author":"成鹫","text":"榴火当轩暑气蒸，梅花开日又坚冰。\n四时最好凉秋节，几树幽花伴一僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续西园咏木芙蓉后十五韵 其十","author":"成鹫","text":"携手相期共入林，百花丛里见秋心。\n孤芳静与清流合，影入澄潭何处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续西园咏木芙蓉后十五韵 其十一","author":"成鹫","text":"木未幽香近小楼，微风吹入始知秋。\n横塘一派烟如碧，惟许閒人尽日留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续西园咏木芙蓉后十五韵 其十二","author":"成鹫","text":"若木扶疏绕一亭，低枝临水水泠泠。\n花边茗椀迟佳客，不信人间有醉醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续西园咏木芙蓉后十五韵 其十三","author":"成鹫","text":"海燕归飞雁欲南，芙蓉开日正秋三。\n花间恰好斜通径，林下偏宜小结庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"续西园咏木芙蓉后十五韵 其十四","author":"成鹫","text":"绿叶丹葩接短檐，西风如剪月纤纤。\n溪翁独住秋花里，斗帐新凉睡正甜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]