[{"title":"贺郭青螺大中丞","author":"董其昌","text":"彤弓卢矢蕊珠庭，瑞霭遥连执法星。\n圯上密传书似素，台中独坐鬓犹青。\n人看剑履依三极，手握风云驭百灵。\n若向揽揆论盛事，旂常应胜佛名经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺平湖令陈杲庵奏最","author":"董其昌","text":"世家曾入史公书，循吏今看积庆馀。\n丹穴旧来能产凤，琴台谁不颂悬鱼。\n茇成棠树思如昨，植处槐庭应岂虚。\n卿月宫云相映照，何论通德表门闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺王铭韫司李满考","author":"董其昌","text":"棘木持平四国驰，颂声名彻九重知。\n共言如水心同洁，不见南山判可移。\n禹鼎即今悬照日，虞廷自远质成时。\n采风尽入輶轩记，不待甘棠蔽芾诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺湖州冯司李桢卿奏最","author":"董其昌","text":"棘木春生彩凤来，使君身立九成台。\n遥看紫气青齐接，近捧丹泥泽国开。\n大树旌功高异代，御屏书迹卜三台。\n若将墨妙论家法，翠竹苍筠未易材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺廷尉李素我得子","author":"董其昌","text":"九皋和鹤降青冥，佳气氤氲玉树庭。\n才见斗杓回子月，旋看奎下有文星。\n神光可但开仙李，天瑞居然映帝蓂。\n闻道射熊新筑馆，名家先毓海山灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺李素我再举子诗以志喜","author":"董其昌","text":"男祥重见叶长庚，无限高门意气生。\n遂有次儿肩德祖，奇哉二子类徐卿。\n金光并茁尧庭草，玉露初盈汉阙茎。\n间岁一寻汤饼会，欢歌逾遍五茸城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35296,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺施笠泽别驾得雄","author":"董其昌","text":"兰草宁论入梦劳，神光忽照德门高。\n恰逢开士摩麟顶，共向超宗识凤毛。\n合浦乍还珠在掌，明河新沐锦为袍。\n亦知廉吏归装薄，传有青编及宝刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠郑范溪大司马行边","author":"董其昌","text":"元臣节钺九天开，经略勋猷亦壮哉。\n组练秋飞辉日月，玺书朝启役风雷。\n行歌汉垒军容变，声到河湟虏气摧。\n敢以铙歌酬祖席，营平故是折冲才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金华守周斗垣为学使重临郡郡人以诗纪事为赠此诗","author":"董其昌","text":"山城忽报隼旟回，桃李临风烂熳开。\n去后正勤循吏思，登高又见大夫才。\n即今白石驱羊路，不异黄金市骏台。\n为问子衿能讲德，隐侯何似细侯来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠尹惺麓参知阅兵海上四首 其一","author":"董其昌","text":"时艰岂复诫垂堂，缓带临戎此破荒。\n幕有芙蓉开下濑，营开细柳列艅艎。\n移将壁垒从夔子，争遣芄蒲点谷王。\n元老壮猷文武宪，先声今巳至扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠尹惺麓参知阅兵海上四首 其二","author":"董其昌","text":"直驱海若作金墉，宪府秋蒐壮折冲。\n猛士何来因买骏，檄文挥去总雕龙。\n水犀练取三千甲，天堑宁论百二重。\n老我雄心犹未尽，欣逢父老睹军容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠尹惺麓参知阅兵海上四首 其三","author":"董其昌","text":"指顾风雷号令严，舟师一一应韬钤。\n居然鞭石桥初合，底事燃犀怪不潜。\n日射大荒明组练，烟消长岛晏闾阎。\n即今拊髀勤当宁，九牧何人将略兼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠尹惺麓参知阅兵海上四首 其四","author":"董其昌","text":"秀夺三峨挹锦官，主盟宁独在词坛。\n将因倚剑崆峒后，复此投醪渤澥宽。\n飞槛楼台灵气结，连营灯火落星寒。\n式微纵自嗟来暮，却喜鱼矶梦始安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠刘梦胥黄门","author":"董其昌","text":"中垒声名重夕郎，十年江海又班行。\n金锥抗疏千秋论，玉尺量才万丈光。\n辽左羽书飞赤白，甘陵龙战洒玄黄。\n忧天亦有群公疏，共道时艰倚召方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠彭嵩螺鹾台二首 其一","author":"董其昌","text":"遥传使节发江都，六月冰心在玉壶。\n巳见盐官清酌水，又从陆海远飞刍。\n殿中封事关宸告，天下军储罢癸呼。\n当宁颇存南国不，可能不上郑公图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠彭嵩螺鹾台二首 其二","author":"董其昌","text":"直声兄弟著青蒲，四海论交兴不孤。\n绣斧衔恩天北极，江山留客古东吴。\n时闻盐井詶书札，秋逼星津引舳舻。\n平准河渠兰史在，野谋何事到潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠杜完三黄门","author":"董其昌","text":"夕郎谏草气嶙峋，又捧天书拜庆频。\n千里思莼江左韵，百城负弩会稽人。\n皇华谁复歌朱萼，桥树今当记大椿。\n如此昼归真异数，好将补衮答昌辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠毛侍御","author":"董其昌","text":"九夷职贡共航梯，何事遐陬暗鼓鼙。\n铁钺有人博阃外，金闺空自梦辽西。\n天狼荐食谁当剪，老马遵途智巳迷。\n稍喜筹边公等在，东封笑指一丸泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠总漕王宪葵中丞三首 其一","author":"董其昌","text":"试辅登坛拥节旄，司徒原佩吕虔刀。\n神京汤沐资安攘，天下咽喉属挽漕。\n卿月辉辉膺异数，晨星落落几同袍。\n君家世泽随淮水，伫看文昌曳履高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠总漕王宪葵中丞三首 其二","author":"董其昌","text":"乌台计相拜新除，卢矢彤弓再命初。\n斗际一星中执法，柳营万骑上游居。\n如云舸舰驱流马，望气桥陵护玉鱼。\n重镇保釐分陕寄，壮猷元老正堪舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠总漕王宪葵中丞三首 其三","author":"董其昌","text":"天划东南宿重兵，繇来草木仰威名。\n丸消赤白三邮晏，马略骊黄九品清。\n巳见风霜行令甲，更将膏雨散呼庚。\n只今制虏无中策，谋国还应倚老成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其一","author":"董其昌","text":"岿然耆旧表江南，东麓云泉恣所探。\n广大代推风雅主，萧閒时共佛僧龛。\n空庭籁起闻吹万，月幌杯深对影三。\n辛苦山灵驱俗驾，肯容城市讶苏耽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其二","author":"董其昌","text":"文伯顽仙尽自兼，何须黄纸署名衔。\n山开窈窕藏书洞，径翳荒榛避诏岩。\n老衲或来煨榾柮，橐驼尝倩护松杉。\n虽然豪气屏除尽，閒咏荆轲木是缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其三","author":"董其昌","text":"百感中来不自拈，侧身西望北峰尖。\n论交云雨今方见，阅世阳秋晚更严。\n危语逼人何咄咄，大言是处可炎炎。\n闻君近发琅函秘，巳展红牙第几签。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其四","author":"董其昌","text":"名僧会里事瞿昙，能结孤峰白石庵。\n河泊谩夸闻道百，狙公何意赋朝三。\n清华水木如濠上，弘奖风流自汝南。\n却笑昔人高士传，不将同世一为参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其五","author":"董其昌","text":"无限离离压杞楠，树犹如此尔何堪。\n烟波狎主谁争长，山泽虽曜已战酣。\n绝域也知珍尺一，高轩奚事谬朝三。\n犹嫌住久人知处，见说游鲲欲徙南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其六","author":"董其昌","text":"玄味曾同草木参，廿年相对老江潭。\n竹林把臂今馀几，莲社过桥笑有三。\n赠我绮琴都不报，求君青李远能函。\n故人却喜彭篯在，金鼎琼文事可谙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其七","author":"董其昌","text":"当年游宿遍名蓝，紫柏禅师奉麈谈。\n受记可称千佛一，论文曾许两都三。\n应将绮语卑江左，直溯宗风自岭南。\n莫讶绳床留半席，庭前树子早同参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其八","author":"董其昌","text":"餐取峰霞坐翠岚，云根劖出小终南。\n窗悬虚室常生白，帖仿萧斋欲过蓝。\n山长旧来鸿自一，市喧还笑虎成三。\n应怜惠子能知我，雅道寥寥有荷担。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其九","author":"董其昌","text":"箬笠扁舟白马谈，浮生忽巳鬓毵毵。\n无能九土游其八，不朽千秋共此三。\n曲水竹林分左右，青山宾主列东南。\n此中但可吟风月，百尺陈楼一草庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其十","author":"董其昌","text":"端居突兀起毗岚，是处清凉现钵昙。\n漱石更兼芬润六，御风时见素云三。\n绿天剩有书经叶，碧涧疏为洗砚潭。\n身隐无文真用短，试看碑板大江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其十一","author":"董其昌","text":"洼盈轩画为谁拈，著配倪迂也自谦。\n枯木悠悠凭隐几，芙蓉片片见开帘。\n即今呼马能无应，但说犹龙好用潜。\n养鹤栽梅成底事，未曾驱役老长髯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其十二","author":"董其昌","text":"清时岂有放江潭，故里风烟不可堪。\n巳分浮家苕霅曲，忆曾对宇岘亭南。\n人间鸟道丸封一，世事桑田海阅三。\n褊性幽栖真不恶，骊珠先巳被君探。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其十三","author":"董其昌","text":"谁言司马滞周南，若比稽康更不堪。\n笔綵愧开花七七，樵青尝扫径三三。\n多君素业寻确壤，何物閒勋抵石函。\n如此盘桓成二老，北山安得有林惭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其十四","author":"董其昌","text":"徵君名姓彻宸严，谷饮岩栖宝不贪。\n称意沙鸥随上不，论才竹箭美东南。\n荡胸震泽吞能九，开径柴桑益有三。\n尽为草堂拈胜槩，留将山史作佳谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其十五","author":"董其昌","text":"颂酒深衷岂放憨，二豪何以视耽耽。\n将因巢许为师友，自与羲皇作子男。\n清浅锦机襄转七，纵横雅爵醉挥三。\n孝标虽有伤时论，未见山中此盍簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其十六","author":"董其昌","text":"钟牙缅邈别家惭，试向瑶琴古调参。\n怀友经春哦渭北，教儿当日笑城南。\n梦中蝴蝶花光湿，池里蟾蜍墨雾含。\n只鹤畸人形共影，故应待我鼎为三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其十七","author":"董其昌","text":"洗耳应停朝市谈，忧时词客未为惭。\n遥闻羽檄飞辽左，何日穹庐扫漠南。\n虎豹愁人关自九，马牛更仆语成三。\n希夷居士今如在，高枕高歌莫太憨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其十八","author":"董其昌","text":"瑶草金光向此探，我来风日正清酣。\n夷门布席恒虚左，栗里悬窗故倚南。\n竟有声名输第五，耻将禅草说登三。\n可知嘉遁能终吉，龟筴何劳季主参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其十九","author":"董其昌","text":"平生挥麈解围谈，名理尤从老境谙。\n得失浑忘闻塞上，春秋成癖北征南。\n潜虚祗用龙初九，忌满何如月出三。\n可道太玄犹寂寞，好玄今巳有桓谭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其二十","author":"董其昌","text":"十载村居傍酿墰，村农村姥得相参。\n玉壶观世龟藏六，竹简雠书豕渡三。\n只见陶公怡岭上，谁知剑客是图南。\n近来宝晋先王略，不作兰亭聚讼谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其二十一","author":"董其昌","text":"今古閒愁了不担，翛然方内有鸾骖。\n谷名子午真盈一，坐守庚申不但三。\n处士占星常斗北，诗家浥酒或箕南。\n为君署取凉心馆，若个游人肯细参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其二十二","author":"董其昌","text":"为事丹铅不种蓝，閒将草木志嵇含。\n斩新松傲秦封五，娟秀花开少室三。\n流咏须臾成洛下，徵图早晚诏江南。\n凭君醉舞回双袖，长泖驱为拾月潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其二十三","author":"董其昌","text":"忽忆驱车过楚潭，德山犹有德山庵。\n岧峣鹫岭衔天半，直截牛车见佛三。\n般若无知传教外，菩提非树本宗南。\n前身金粟维摩是，丈室相看巳罢参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其二十四","author":"董其昌","text":"渐剪茅茨渐卓庵，图书成府亦潭潭。\n词坛悬帜多奔北，古路先驱作指南。\n常有玉晨资赉十，未闻石户羡徵三。\n北来门外维舟惯，不为乘风利涉贪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其二十五","author":"董其昌","text":"别有超超上驷骖，拈来恐似老生谈。\n逍遥不必溟飞北，炳蔚端成雾隐南。\n掷地赋声如振万，先天玄理自函三。\n枕中一卷庖羲易，祗觉王何思未覃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其二十六","author":"董其昌","text":"忆昔论交自筱骖，虽更出处岂商参。\n阮家犊鼻贫骄北，先世狐书史愧南。\n岂有风流分仲二，差怜骨相共朋三。\n壮君笔力能扛鼎，不为清羸弛负担。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其二十七","author":"董其昌","text":"山叟从无对影忠，科头露坐过仍甘。\n关情空谷肠回九，绝意王门足刖三。\n草什忘忧都树北，风能解愠自来南。\n腝尘不上清虚界，酒德文心日共酣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其二十八","author":"董其昌","text":"东轩曝背语成函，一饭忘君未可甘。\n主帅穷兵真计左，胡儿牧马渐过南。\n沙场白骨高寻丈，御府朱提岂再三。\n却把国觞连太乙，九歌深意许雅参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其二十九","author":"董其昌","text":"誓比黄河开国男，酬恩当取虏头函。\n镜中鱼□频虚伍，笛里梅花漫奏三。\n美酱几时陈戏下，藁砧何在战城南。\n翻惭梁市行吟者，绝塞山川聚米谈。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈仲醇徵君东佘山居诗三十首 其三十","author":"董其昌","text":"满贮诗囊不待探，风流胜赏事偏谙。\n寄愁直欲还天上，招隐时闻过水南。\n有橘可能摛楚颂，无花大类说燕函。\n凭高辄吐惊人句，为道平生僻性耽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈留令韩有怀秦人政成者","author":"董其昌","text":"纷敷榆柳荫长堤，比屋弦歌讲德齐。\n云彩旧传飞殿角，冰壶真不愧关西。\n輶轩载笔书驯雉，乡井移风似祝鸡。\n独向空桑赛秋社，瓣香深荐首重稽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王大美直指","author":"董其昌","text":"松风谡谡度霜台，好及膺门御李来。\n怀古忆过麋鹿苑，巡方行省雁鸿哀。\n山川半入吴都赋，云梦平吞楚客才。\n秋水长天供綵笔，称诗一二柏梁裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠毛侍御孺初视漕","author":"董其昌","text":"绣斧巡方宠命新，勋名宁独挽漕论。\n能将一掬桐江水，直洗频年虏骑尘。\n塞北行闻驰赤羽，江南闾左有黄巾。\n关心圣主宵衣日，庙算繇来倚重臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠蒋山人二首 其一","author":"董其昌","text":"怪底人幽地亦幽，桃花源里蓼花洲。\n烟岚屈曲深开径，云水苍茫不系舟。\n野史故应成马走，新交未觉胜羊求。\n闻君嗔我悭书画，青李来禽肯寄不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠蒋山人二首 其二","author":"董其昌","text":"閒来倚棹吕蒙城，几度从君听鹤鸣。\n岁俭自饶千树橘，气豪宁食五侯羹。\n酒人直许中贤圣，农话惟应较雨晴。\n史笔倘修高士传，蒋家今古两元卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠洛中焦右伯文兆","author":"董其昌","text":"雄藩河朔带澶渊，右辖勋名两地传。\n菡萏风清沙际路，萑符电扫泽中烟。\n大夫雅善登高赋，游子秋停苦雨篇。\n见说圯桥多秘授，行应执契静三边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠蔡道寅","author":"董其昌","text":"翛然环堵狎烟霞，侠骨禅心度岁华。\n棐几静雠蝌蚪字，贝函潜转白牛车。\n只应竹径延求仲，共许冰壶在兵家。\n五马数传千里酒，可能长醉碧桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠巨源宗侯","author":"董其昌","text":"白门朱户惣悠悠，中有王孙静者流。\n分宝几谁谙最乐，反骚无复著牢愁。\n八公鸡犬罗丹室，六代风云入选楼。\n十载怀人向图画，何如身逐凤台游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠宗正国手","author":"董其昌","text":"纷纷龙战起名场，坐隐如君似坐忘。\n怀友每酬青玉案，教儿翻博紫罗囊。\n书雠断简潜分火，侠有停车问卖浆。\n不必仙山传局势，帝乡原是白云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李霖寰少保平播册","author":"董其昌","text":"亲从黄石授书来，盟府勋名切上台。\n主帅几谁劘虎穴，文人今有画麟台。\n旌旂陡觉风云变，图版重将混沌开。\n元老黑头真不数，金瓯还倚补天才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]