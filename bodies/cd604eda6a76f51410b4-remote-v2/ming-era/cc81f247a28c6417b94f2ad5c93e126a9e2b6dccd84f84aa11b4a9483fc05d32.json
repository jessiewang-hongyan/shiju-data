[{"title":"瞻六堂即事十首 其三","author":"罗万杰","text":"颠须从众呼应，热不因人转移。\n此意非关傲俗，由来癖性难医。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瞻六堂即事十首 其四","author":"罗万杰","text":"灌园不是逃世，荷锸堪称达生。\n喧寂都饶至理，醉醒各具深情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瞻六堂即事十首 其五","author":"罗万杰","text":"香焚一室宜静，月到中庭渐幽。\n蝶梦初生榻上，莺声忽过枝头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瞻六堂即事十首 其六","author":"罗万杰","text":"清宵静几相对，落日茅檐自閒。\n知己何如浊酒，素交那似青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瞻六堂即事十首 其七","author":"罗万杰","text":"有树偏宜水映，无花不傍栏开。\n香残偶值僧去，茗熟恰逢客来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瞻六堂即事十首 其八","author":"罗万杰","text":"阅物一双醒眼，藏身数卷奇书。\n休言世事蕉鹿，输与神仙蠹鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瞻六堂即事十首 其九","author":"罗万杰","text":"低棋屡倖先着，拙饮常推后乾。\n说甚正襟危坐，赢他袖手旁观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瞻六堂即事十首 其十","author":"罗万杰","text":"一门以内师友，十亩之间轴薖。\n讲易先求丽泽，读诗欲废蓼莪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶作","author":"罗万杰","text":"坡公借地种菜，庞老携家入山。\n休把古人比我，同床梦不相关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜坐月偶成四首 其一","author":"罗万杰","text":"炉烟细细浮几，花影离离摇窗。\n过眼浮云一点，照襟明月千江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜坐月偶成四首 其二","author":"罗万杰","text":"常依木石习静，颇爱禽鱼与偕。\n勺水幽涵雅趣，青山澹入高怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜坐月偶成四首 其三","author":"罗万杰","text":"兀坐蒲团一个，啜馀茗粥七瓯。\n竹色偏宜静夜，松声最喜清秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜坐月偶成四首 其四","author":"罗万杰","text":"托旷观以适性，聊纵目而怡颜。\n閒随罔两酬答，动与太虚往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日值雨同雪樵上人作","author":"罗万杰","text":"愁值上元雨，空山静掩扉。\n茗烟轻冉冉，香缕细霏霏。\n窥牖月光薄，照龛灯影微。\n只应禅榻上，梦与白云归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题溪云庐","author":"罗万杰","text":"白云堆里数峰阴，翠竹苍松绕涧寻。\n卜筑乘栽棣萼色，幽居时废蓼莪吟。\n溪山结侣情偏挚，屺岵兴思感独深。\n最爱练江波底月，清光照彻古人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日游七娘滩值雨","author":"罗万杰","text":"去岁山中逢人日，今年人日仍登山。\n经丘自足情兼具，寻壑偏宜静与闲。\n雨映疏篱花的皪，烟生野径石斓斑。\n坐听僧梵归来晚，屐齿冲泥趁湿还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答郭正夫招同诸公入陶社之作 其一","author":"罗万杰","text":"柴扉冷处见遗民，手揽江蓠忆楚臣。\n白社那邀采药客，青门旧识种瓜人。\n一春屡费登山屐，万事堪悲漉酒巾。\n岂是攒眉逋宿约，只防人世怪予真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚戌灯夕即事","author":"罗万杰","text":"小村风土占年华，春入垣墙处处花。\n箫鼓声寒幽客梦，秋千影静野人家。\n林烟淡淡灯馀焰，香雾霏霏月半斜。\n行乐忘敲山砦柝，醉吟惊醒树头鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕同明度上人逸老庵守岁","author":"罗万杰","text":"残年抱病隐园中，潦倒几忘岁月穷。\n窗对木兰花正白，炉添榾柮火初红。\n天寒乍觉香消雾，夜静频惊磬逐风。\n门户跏趺少俗语，辛盘聊与寺僧同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"磐湖秋色同诸禅侣夜坐","author":"罗万杰","text":"露下空山客袂凉，残荷新菊叠衰荣。\n池边宿鸟翻林影，竹里流泉杂磬声。\n是夕逢秋偏澹滟，何人对月不凄清。\n香瓯茗碗共深坐，一室萧然称野情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"语石庵即事","author":"罗万杰","text":"荜门阒寂倩云封，十载林泉不负公。\n透海穿山凭楖栗，填沟塞壑任榛蓬。\n梅依石壁留初月，竹近茅檐纳晚风。\n料得庵前一线路，几人脚底订圆通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶题 其三","author":"罗万杰","text":"树老幽人屋，云深野衲家。\n门垂彭泽柳，圃接邵陵瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瞻六堂即事","author":"罗万杰","text":"营生药灶茶灶，得意花边竹边。\n时强闲人说鬼，亦随醉客谈禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂诗 其一","author":"罗万杰","text":"万山深处一闲人，手葺蓬茅老此身。\n淡粥盈壶齑满钵，家风不改旧清贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂诗 其二","author":"罗万杰","text":"灌畦日暮荷锄归，满目蓬蒿夕照微。\n黄叶乍冲鸟语落，白云时绕磬声飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂诗 其三","author":"罗万杰","text":"吟残半偈剔残缸，突兀睡魔未肯降。\n榾柮一炉香一柱，卧听微雨打寒窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浔阳官署漫赋","author":"吴翼","text":"理官僦舍半椽楹，觅得安身便称情。\n白石斜通勾漏洞，紫泉环绕郁林城。\n每瞻乌止生忧色，肯把鸡鸣作恶声。\n罗雀当年廷尉宅，何如今日两江清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒洪公祠有感","author":"刘钦翼","text":"孤忠谁与简遗编，欲写心碑句未便。\n日落狐眠蝴蝶冢，月高猿啸杜鹃天。\n血飞断岸应成碧，气咽残潮半带烟。\n一自身名归海鹤，千秋功过夕阳前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望飞来寺","author":"洪生复","text":"闻说寺飞来，如何不飞去。\n山高涧水深，钟罢闻僧语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"伍云","text":"香生生也艳晶晶，花自亡姿月失明。\n质格本来称赵美，鬼方曾换几多城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渔舟词","author":"何士埙","text":"日高一网破浪去，日暮一笛冲烟来。\n东西南北但随意，绿蘋红蓼相徘徊。\n放歌风吹断还续，惊起鸬鹚宿。\n得鱼换酒不换钱，醉拥壶瓶酣睡足。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀人","author":"何士埙","text":"白日生新事，秋林怅故人。\n愁从天外远，望向梦中频。\n月澹斜分影，云孤冷映身。\n难忘即易识，挥泪越风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀有寄","author":"何士埙","text":"凉飙生两鬓，何事不堪怜。\n宿雨停宵月，新霜乱晓烟。\n狂无方外侣，兴怯饮中仙。\n雁影灯前落，声声搅独眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春倚","author":"何士埙","text":"春倚枝头怅旧新，那堪水石更粼粼。\n书空已悟从前事，问影偏怜此日身。\n饮涧可知麋性乐，餐霞转觉道情亲。\n泉声悬树涓涓响，崖畔谁来方隐沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢客","author":"何士埙","text":"爱閒谢客卧烟霞，罗雀门前噪晚鸦。\n久矣访泉清似雪，偶然拈卷笑当花。\n四愁平子凭谁解，八咏休文漫自誇。\n萧寂不禁雄剑去，终惭计拙话桑麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋篱采菊","author":"何士埙","text":"晚香朵朵傍栖迟，况复馀芳慰所思。\n暂学灵均长学亮，一家生事在东篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春初访僧无怀于云峰寺","author":"何士埙","text":"善接源头水，林峦顿改观。\n云浮松色嫩，雨沐石光寒。\n忽忽来真相，昭昭胜选官。\n芳辰诚访道，寸草意漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都门怀古","author":"叶著","text":"历历黄图绕帝畿，幽燕从古奠丕基。\n辽金事去千年久，剩有斜阳似旧时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"武昌怀古","author":"叶著","text":"中原盗贼正如麻，谁陷名藩事可嗟。\n凭吊兴亡无限思，扁舟江上日初斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铜雀台","author":"叶著","text":"帐中歌吹惜红妆，话到西陵欲断肠。\n莫怪分香情缱绻，铜台片瓦亦鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石井岩","author":"马光龙","text":"古刹开峰顶，庭宽不觉巍。\n江流回练曲，野稻露青肥。\n近海风偏响，深秋雨渐微。\n午钟僧饭熟，寒色欲侵衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游治平寺有感","author":"马光龙","text":"披葺蹑屐度林丘，烟雨空濛蜃气流。\n桃洞通源疑汉魏，竹林长啸愧嵇刘。\n满洲芳草巢飞鹭，数叶渔舠傍狎鸥。\n倏忽晴阴舒卷际，沧桑不尽古今愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳王邑侯招集水帘亭分赋","author":"马光龙","text":"春迟韶光媚，清朗是日逢。\n山行宛图画，修褉永和同。\n寻幽陟盘磴，石室开崆峒。\n华檐隐云雾，鳞瓦摩苍穹。\n依峰环峭壁，十柱夺天工。\n冽泉经其下，昼夜流淙淙。\n玉乳喷山骨，琼浆洒林丛。\n清飙时澹荡，明珠满碧空。\n疑自沧海上，移来水晶宫。\n胜事王右军，杖履生春风。\n指顾启群英，廓然如发蒙。\n我亦钝汉者，倾聆心不蓬。\n因之觉众妙，睇目浩无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"皇冈夕照","author":"萧远","text":"万仞高冈插碧空，翠华亭畔气菁葱。\n衡阳飞雁来秋色，荆水风帆挂落虹。\n芳草昔曾经御辇，滩声疑是奏焦桐。\n南巡帝子今何处，愁见青山夕照中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"通天塔","author":"萧远","text":"玉笋浮江影欲流，推蓬傍柳繫沧州。\n崔嵬分得青天半，睥睨全低绿树头。\n细拂苍苔摹古碣，频惊绿蚁狎忘鸥。\n倚阑云外长舒啸，天际河山带晚愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题何仙姑祠","author":"湛会谷","text":"载谒天姬读断碑，低回旧事至今疑。\n如何蜕化空遗履，尚自留题且寄诗。\n鸾过缑山笙有韵，鹤归华表语无期。\n当年赢得存仙籍，还记春冈是旧基。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"万寿寺","author":"湛会谷","text":"半夜青莲映翠微，千秋台畔凤凰飞。\n空誇白社风流在，翻惜黄金世路非。\n苦海无边翻贝叶，银河有路问支矶。\n坐高三鼓菩提月，玉笛风前折竹枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日偕潘孟骧游古仙原承示佳章次韵答和一首","author":"廖负暄","text":"清漪缕缕漾棠舟，系缆临圻访古丘。\n老桧攫云高立鹳，仙原佳气上连牛。\n岚拖瘦杖群峰寂，风入轻舆万壑秋。\n曲磴阴森探不尽，数声韵鸟唤行游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游鹤林怀古","author":"郑一岳","text":"我怀马素师，亦衲米公石。\n竹院坐忘言，坡仙如可识。\n云何天际虹，遥遥杳莫即。\n离披上干云，枝撑仍局蹐。\n泠泠虚谷声，徒然奏笙瑟。\n因之搜奇前，一日当千日。\n去日问濂溪，鹤振空山碧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游鹤林寺","author":"郑一岳","text":"路僻迂游屐，轻烟晓望迷。\n随香来法界，引翠入招提。\n古壁残碑在，飞檐偃柏齐。\n犹怜竹院影，寂寞近濂溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三诏洞谒焦处士祠","author":"郑一岳","text":"水国霞明树，专祠暮霭空。\n孤标传极北，三诏峙江东。\n鸥浴船船月，龙吟院院风。\n任山凭点□，真悔出山中。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冈州纪胜","author":"谭正国","text":"圭峰绿护翠相连，秀出冈州淑气全。\n斗石夜明仙梵迥，瀑泉朝洒雪花溅。\n钟闻马岭蕃三锡，云起龙潭润八埏。\n更羡银洲波万叠，光摇文笔写晴天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠郑抚夷兄弟平茶山寇","author":"吴士珽","text":"应嫌兵食犯民秋，自裹乾糇系马头。\n寇遁人还烟灶畔，饥童争拾异乡麰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大忠祠","author":"姚喜臣","text":"薄暮缘山麓，凄酸独对公。\n忠魂望曷极，块肉远成空。\n雀乱荒烟冷，碑危野草丰。\n邮亭暗月夜，马骨尚嘶风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和杨大山游东岩韵","author":"姚喜臣","text":"峰回翠叠对江天，木末凭阑意渺然。\n千尺阴松盘鹤盖，一声清磬起龙眠。\n道人唾落九天玉，学士毫挥万斛泉。\n高赋合推仙圣手，风骚还许俗为缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳王邑侯招集水帘亭","author":"姚喜臣","text":"岳灵抽东臂，龙虬迸其鏬。\n聱牙函寒湫，一啸悬珠泻。\n何代割云棱，翼然探奇藉。\n古甍盖碧流，细练舒虹架。\n四坐水晶盘，河道折飞斝。\n接应万峰青，顾盼烟云下。\n江左昔风流，褉修鸣琴暇。\n眷言陟山阿，蒿目怅耕稼。\n玉乳沸松涛，珠咳絪兰麝。\n摩厓恣幽寻，寒绡垂日夜。\n老佛冷空山，趺坐观不舍。\n如何新素娥，长把银钩卸。\n流览对澄江，玄晖真脍炙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙潭夜归","author":"谢宗鍹","text":"月黑闻人语，灯火荒村外。\n沿溪理轻策，归路山向背。\n苍茫屡相共，竹树森以荟。\n郁纡历已尽，依然烟霭内。\n回记所来时，潺湲声尚在。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韩山亭子","author":"谢宗鍹","text":"韩子去已久，空山今有亭。\n秋烟荒橡栗，古壁暗丹青。\n城抱江如带，天垂嶂列屏。\n双旌馀片石，啼鸟下林坰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过榕城","author":"谢宗鍹","text":"萧条兵火后，井邑数家存。\n海气兼秋阔，潮声向晚翻。\n腥风牡蛎市，细雨木棉村。\n入夜多凄警，犹闻铃柝喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过唐仁卿先生钓台台在湖山最幽处","author":"谢宗鍹","text":"山势依台曲折成，断桥深处藕陂清。\n高人所寄皆孤迥，胜地因年见废兴。\n春水苔矶枯柳卧，夕阳渔笛野烟横。\n羊裘亦是寻常事，浪有桐江身后名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游冠山","author":"谢宗鍹","text":"流泉在道石钩衣，登顿从朝至落晖。\n雨足诸峰茶笋候，烟生一派栝松围。\n青牛客礼仙坛斗，白鹿宗瞻讲院扉。\n相望莱芜隔苍莽，晚潮声送独吟归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山房月出呈黄大","author":"谢宗鍹","text":"山鸡起舞月当檐，墙隙西峰露几尖。\n岩桂时因香雾湿，风篁多得夜泉兼。\n读阑短烛鸣饥鼠，梦破凉天泣老蟾。\n险语祇应君勍敌，今宵谁更断枯髯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题郭仲常宛在堂","author":"谢宗鍹","text":"苍寒一带岛为居，清泚环湾集小渠。\n潮响暗通廊宛转，花枝争拂槛扶疏。\n难为怀在秋冬际，最赏心当月露馀。\n百尺楼头堪独卧，白云閒护满床书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别辜端敬给谏","author":"谢宗鍹","text":"大江东去悠，暮潮千里平。\n怨别柳花飞，对酒北固明。\n伊昔洽心许，早达飞华缨。\n抗怀振颓流，气与秋旻横。\n横尘暗东国，荼毒被氓萌。\n上天未悔祸，罪已轸皇情。\n献纳当有筹，如何阻孤征。\n眷阙方子牟，倦游类长卿。\n出处本殊辙，运命谁能争。\n卑伏束壮士，枥马蜷局鸣。\n坐抚方徂时，俛仰空复情。\n岐路各踌蹰，离魂今夕惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登虎丘","author":"谢宗鍹","text":"灵境隔重氛，清光纷向曙。\n坦步历修坰，旷衍无积阻。\n惠风袭轻裾，春思荡容与。\n喈喈黄鸟鸣，粲粲杂英吐。\n澄瑩剑池泉，淅沥飞松雨。\n云岩数转幽，泬寥明绀宇。\n因高见吴门，苍色霭平楚。\n全揽泽国秀，冲襟得轩举。\n霸图迹久荒，独立怆终古。\n倦客迫遐征，佳游怅难屡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"严滩","author":"谢宗鍹","text":"身非佐命材，轩冕自应辞。\n虽不事王侯，未足傲当时。\n所遗遭明盛，遂性得栖迟。\n故人作天子，屈伸从所宜。\n至尊下白屋，款曲语心期。\n借以风斯世，毋俾躁竞滋。\n竟成高尚名，一代递相师。\n能移东汉俗，各负肮脏姿。\n山林互题榜，炎精值沦夷。\n反令节义士，网罗横见羁。\n乃知开国初，风气或先之。\n隐亦有时命，幸矣桐江丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙霞岭","author":"谢宗鍹","text":"海上断鳌足，覆压九州外。\n伟哉造化力，杰起瓯越会。\n元气相磅礴，蟺蜒百里内。\n无诸昔开国，其势自雄大。\n一夫可当关，峻阻兹云最。\n严冬崖谷闭，凛冽冰霜载。\n木杪过飞泉，偪侧崩石碍。\n山魈避白日，野鼠吟晨籁。\n耸身已层岭，仆马苦疲惫。\n回视极苍茫，杉青乱烟霭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]