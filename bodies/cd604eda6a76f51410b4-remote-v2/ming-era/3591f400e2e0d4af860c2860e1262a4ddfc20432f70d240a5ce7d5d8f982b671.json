[{"title":"秋日园居漫兴 其七","author":"李孙宸","text":"性耽畜画更藏书，购尽奚囊几架馀。\n何似秋风到庭树，萧然四壁领清虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其八","author":"李孙宸","text":"文字魔缠病后身，欲将绮语忏前因。\n纵然未断情痴语，懒学金华殿里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其九","author":"李孙宸","text":"散步楼头日易西，彩云东去化晴霓。\n开怀天宇瞻高朗，忽见星河压屋低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其十","author":"李孙宸","text":"案上兼翻两藏经，教分末学听徒荧。\n倘能领悟西来意，宁碍东行紫气停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其十一","author":"李孙宸","text":"种得盘中五颖芝，千葩万蕊枉矜奇。\n秋光正好流连赏，零露凋残已不支。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其十二","author":"李孙宸","text":"莫向飘零怨早秋，衰荣天意总难谋。\n霞城云树看如洗，不碍澄空一镜收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其十三","author":"李孙宸","text":"门对清流日夜潺，风吹柴户不成关。\n井梧落尽无人到，惟见藤花点地斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其十四","author":"李孙宸","text":"灯残香烬漏声催，漫展离骚读几回。\n月出乌惊林叶响，却疑花外有人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其十五","author":"李孙宸","text":"楼上天街接汉长，交疏明月足秋光。\n从他第宅矜歌舞，自领烟霞作道场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其十六","author":"李孙宸","text":"一自逃虚远世尘，影形相问更无邻。\n道人未是耽枯寂，夜夜翻经礼列真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其十七","author":"李孙宸","text":"微禄何曾买薄田，支吾八口度流年。\n笑来未断谋生事，时有人酬谀墓钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其十八","author":"李孙宸","text":"清磬朝来扣几声，皈心趺坐理残经。\n顶巢膝灌原吾事，懒扫从教叶满庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其十九","author":"李孙宸","text":"几秋燕市忆尘踪，仆仆黄砂马上逢。\n何似小楼清梦后，满天明月在高松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居漫兴 其二十","author":"李孙宸","text":"金门一别两年馀，云路亲知问讯疏。\n却笑嵇生虚道懒，绝交何用更裁书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮杂咏十绝 其一","author":"李孙宸","text":"闻道金风长紫芝，乘秋来赴白云期。\n空山寂寂无消息，黄鹤天边何所之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮杂咏十绝 其二","author":"李孙宸","text":"蓬莱仙路铁桥通，汗漫行歌亦御风。\n呼吸每忧干帝座，不知身在世人中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮杂咏十绝 其三","author":"李孙宸","text":"葛仙祠后丹灶存，葛仙祠前黄叶繁。\n瑟瑟秋山何所见，白云明月对开尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮杂咏十绝 其四","author":"李孙宸","text":"西风几度送琅璈，响遏行云云渐高。\n怪底霓裳天阙近，不知原是羽人操。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮杂咏十绝 其五","author":"李孙宸","text":"卖酒田边卖酒家，种秫不酿酿松花。\n看山客到便供饮，白云持赠不须赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮杂咏十绝 其六","author":"李孙宸","text":"上界峰头卧赤霞，秋深明月冷蒹葭。\n天风吹落霓裳曲，散作湖边桂树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮杂咏十绝 其七","author":"李孙宸","text":"会仙桥上会群仙，黄麟白鹿守桥边。\n怪他放我冲筵几，叱去下耕芝草田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮杂咏十绝 其八","author":"李孙宸","text":"晓起山堂雨过时，羽人有约复来期。\n出门笑问采樵者，昨夜松苓长几枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮杂咏十绝 其九","author":"李孙宸","text":"杖策虽忙意自閒，半凭烟霭半登山。\n归来不闭山中户，留送鸣泉竟夜潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮杂咏十绝 其十","author":"李孙宸","text":"踏尽云霞上界开，天然奇石结楼台。\n世人不信仙家近，看我瑶京驭鹤回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出罗浮 其一","author":"李孙宸","text":"上界回看缥缈间，白云深锁洞门閒。\n清缘自笑吾真浅，强为尘缘又出山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出罗浮 其二","author":"李孙宸","text":"莫道幽栖意不深，出山未了住山心。\n不知山鸟关何事，处处留人送好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出罗浮 其三","author":"李孙宸","text":"物外烟霞世外踪，宿缘能复几回从。\n羽人莫漫怜相别，还待他时伴赤松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出罗浮 其四","author":"李孙宸","text":"仙家鸡犬隔尘寰，何物将携可出山。\n惟有瀑流山下水，相随容易到人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵山中杂咏 其一","author":"李孙宸","text":"竟日看山送夕阳，板桥归去月如霜。\n倦来一枕松间梦，不到红尘底事忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵山中杂咏 其二","author":"李孙宸","text":"十载幽期负一官，归来方觉水云宽。\n罗浮樵岭东西长，南海名山次第看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵山中杂咏 其三","author":"李孙宸","text":"不是桃源有避秦，清时何处不通津。\n人间世业山间乐，流水飞花岁岁春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵山中杂咏 其四","author":"李孙宸","text":"几处山村几处烟，鸡声只隔夕阳边。\n那能五岳迟婚嫁，便欲移家借数缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵山中杂咏 其五","author":"李孙宸","text":"四时生计堪娱老，几代居人不下山。\n今日纵堪吾共隐，悔留名姓在人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29776,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵山中杂咏 其六","author":"李孙宸","text":"山下采茶纷女郎，双鬟高挽自村妆。\n使君道左休相问，不是罗敷陌上桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29777,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵山中杂咏 其七","author":"李孙宸","text":"小妇采茶郎拾粳，笑逢山道两边行。\n收拾茶篮且归去，早携晚饭馌郎耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29778,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵山中杂咏 其八","author":"李孙宸","text":"云山叠叠水淙淙，耳目都疲应接穷。\n急伴馀生此间老，尚怜身在隙驹中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29779,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳日淩江舟中与傅贞父命酌 其一","author":"李孙宸","text":"离家尚忆岁华新，正及淩江已暮春。\n未负群贤脩褉事，开尊犹对素心人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳日淩江舟中与傅贞父命酌 其二","author":"李孙宸","text":"春意渐深三月三，故人相见又春衫。\n与君且醉淩江酒，不定风尘是去骖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳日淩江舟中与傅贞父命酌 其三","author":"李孙宸","text":"形忘肝胆话俱倾，不醉难消邂逅情。\n别后此心君自见，相思何处托鸿声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖十咏 其一 苏堤春晓","author":"李孙宸","text":"春风昨夜到雕阑，十里楼台宿雾看。\n何处春游试兰桨，玉人犹怯晓风寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖十咏 其二 段桥残雪","author":"李孙宸","text":"长堤一望雪初残，六出飞花带月寒。\n堤畔踏歌歌正好，湖光疑在郢中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖十咏 其三 花港观鱼","author":"李孙宸","text":"半亩清池古寺东，锦鳞濲水戏春风。\n即令风雨为龙去，应在经台香钵中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖十咏 其四 柳浪闻莺","author":"李孙宸","text":"柳色沿堤万缕青，晚风微月系渔船。\n画船散尽笙歌罢，留得莺簧枕畔听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖十咏 其五 平湖秋月","author":"李孙宸","text":"绿水连天月在湖，骊龙深夜弄明珠。\n清光处处供娱赏，谁托冰心问玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖十咏 其六 曲院风和","author":"李孙宸","text":"绿水溶溶泛芰荷，洛神湖上步淩波。\n晚风吹酒不成醉，妒杀香魂罥绮罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖十咏 其七 三潭印月","author":"李孙宸","text":"十里蒹葭十里秋，平湖深处隐龙湫。\n夜来吐作三珠弄，不碍寒空一镜收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖十咏 其八 两峰插云","author":"李孙宸","text":"南北高峰插汉斜，居然天外两莲花。\n月明清啸商风起，吹落峰头片片霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖十咏 其九 雷峰夕照","author":"李孙宸","text":"丹崖翠壁出浮暑，倒映湖光入画图。\n任说雨晴无不好，何如返照望西湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖十咏 其十 南屏晚钟","author":"李孙宸","text":"清歌妙舞未从容，画舫香车日日逢。\n独有南屏山上寺，僧閒时打夕阳钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与客尝龙泉井","author":"李孙宸","text":"寻幽转上碧岧峣，龙井泉香汲一瓢。\n清冷尚疑龙气在，不烦老衲试茶寮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"一片云石","author":"李孙宸","text":"一片云根分外奇，霏烟藏雾影离离。\n飞来定自阳台下，神女朝来恐未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阊门竹枝词 其一","author":"李孙宸","text":"十五吴儿学弄潮，潮去潮来惯使篙。\n只为秦淮人不喜，非关风浪怕山高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阊门竹枝词 其二","author":"李孙宸","text":"鸦青袷子鹅黄衫，门外买花门内簪。\n风光非独侬为惜，归船两两又三三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阊门竹枝词 其三","author":"李孙宸","text":"谁家游冶紫骝缰，颇似狂夫旧骕骦。\n何事阊门朝暮过，又教侬误上楼望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阊门竹枝词 其四","author":"李孙宸","text":"千钱一箧买吴丝，摐锦桃花竞巧奇。\n辛苦不辞供杼轴，近来添索解官资。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阊门竹枝词 其五","author":"李孙宸","text":"生来蟢子解穿罗，生来吴童解打歌。\n旧曲新腔随意变，枫桥日日画船过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阊门竹枝词 其六","author":"李孙宸","text":"昨夜阊门月晕重，今朝定有石尤风。\n我劝征帆好归去，风波且不到房栊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过漂母祠有感 其一","author":"李孙宸","text":"是谁一饭德王孙，怪尔真王卖腰领。\n沙头老妇圯桥公，同一机权露警省。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过漂母祠有感 其二","author":"李孙宸","text":"奇男异母遘机锋，密意都传进食中。\n报者固非哀亦假，故将一怒诳英雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漱流石为朱惟四尊人少贞徵君作","author":"李孙宸","text":"却笑当年孙子荆，枕流漱石亦深情。\n何如齿耳俱无染，只爱飞流激石声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过真定有感题壁","author":"李孙宸","text":"道旁何处折腰多，开府张筵上客过。\n不忝我曹仙作吏，皇华公署亦张罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"涉县山署两宿留待张行人 其一","author":"李孙宸","text":"皇华仆仆倦征鞍，两日青山得饱看。\n玉节夜停山上馆，捲帘犹自翠微寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"涉县山署两宿留待张行人 其二","author":"李孙宸","text":"山色垆烟昼不分，官衙无事坐氤氲。\n谁知周道倭迟客，犹得清吟弄白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"涉县山署两宿留待张行人 其三","author":"李孙宸","text":"维城原重晋诸藩，被命桐封亦主恩。\n仙侣未同元礼棹，几时星汉到张骞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"涉县山署两宿留待张行人 其四","author":"李孙宸","text":"山城驻节足清幽，不是王程敢滞留。\n回首长安同日远，未闻星使报轩輶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初入楚地韩先生有署中晓起襆被皆雪二绝见示戏赋詶之 其一","author":"李孙宸","text":"郢客阳春枉自誇，君来高咏满皇华。\n不知白云宵吟积，试看文茵六出花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初入楚地韩先生有署中晓起襆被皆雪二绝见示戏赋詶之 其二","author":"李孙宸","text":"授简梁园宴未怅，先惊白雪满明床。\n岂缘谢女同歌咏，一夜飘扬柳絮狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上元夕过赣寓城外清江寺漫兴八首 其一","author":"李孙宸","text":"兼程日日促归鞍，期及春灯故国欢。\n不道章江今夜月，西堂犹隔岭梅看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上元夕过赣寓城外清江寺漫兴八首 其二","author":"李孙宸","text":"偶逢兹郡驻乌台，走马驱车势似雷。\n无地可容过客宿，尚馀孤寺树江开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上元夕过赣寓城外清江寺漫兴八首 其三","author":"李孙宸","text":"古寺临江夜不扃，乘槎人到客为星。\n虚烦太守殷勤意，一榻还分令尹庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上元夕过赣寓城外清江寺漫兴八首 其四","author":"李孙宸","text":"十里香尘夹道逢，锦城丝管未从容。\n听来女伴春游曲，不似官衙夜宴钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上元夕过赣寓城外清江寺漫兴八首 其五","author":"李孙宸","text":"袅袅清歌静夜闻，越吟楚调总难分。\n但凭羁思能消遣，便当霓裳度彩云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上元夕过赣寓城外清江寺漫兴八首 其六","author":"李孙宸","text":"清磬数声月满天，碧云散尽夜无烟。\n山僧莫把山门闭，女伴还来拜佛前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上元夕过赣寓城外清江寺漫兴八首 其七","author":"李孙宸","text":"谁家箫管溢交衢，彻晓张灯祀紫姑。\n别有幽情歌白苧，声声遥逐彩云徂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上元夕过赣寓城外清江寺漫兴八首 其八","author":"李孙宸","text":"露卧绳床伴月孤，觉来身似在冰壶。\n仆夫喜报天将晓，又挈行装问去途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伍有开著园丁以小艇载木芙蓉数株惠植小园 其一","author":"李孙宸","text":"凿池半亩小通潮，隔岸秋光不可招。\n谁采芙蓉荡双桨，移栽红艳未辞遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伍有开著园丁以小艇载木芙蓉数株惠植小园 其二","author":"李孙宸","text":"为园营沼为栽花，几向西风见物华。\n惟有芙蓉江上好，秋光分自野人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]