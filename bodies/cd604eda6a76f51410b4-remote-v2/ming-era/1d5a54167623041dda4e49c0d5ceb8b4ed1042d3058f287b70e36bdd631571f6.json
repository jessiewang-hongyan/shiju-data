[{"title":"再用前韵寄孙先生","author":"张弼","text":"怀人独立瑁湖滨，杨柳青黄又隔春。\n泮水巳誇酬壮志，曲江犹是避芳尘。\n吴东明月长牵梦，冀北青山暂作邻。\n有约年来看花去，一杯同举酹花神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨庄","author":"张弼","text":"一庄万卷足良田，心事玄中更识玄。\n黑水满池酣笔兴，绿蕉千树染松烟。\n奚超每货专门业，韩愈常损谀墓钱。\n洙泗馀波分入砚，还期龙借洗炎天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟阁竹岗过表侄褚元慎","author":"张弼","text":"北竹岗头黄浦边，偶然相见极欢然。\n船无热酒金罍罄，盘有生梨玉枕圆。\n白首低垂怜我老，青云特达羡君贤。\n无端潮信催分手，翘首西风断雁天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"移桂遂长新叶喜而赋之","author":"张弼","text":"百年古桂此移栽，旧叶渐飞新叶催。\n春雨深滋生意复，秋风又送好香来。\n爱渠傲雪凌霜掺，媚我吟风弄月台。\n公退携琴坐清荫，小山歌罢兴悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋","author":"张弼","text":"南土中秋阴雨多，几回清赏梦中过。\n月明今夜能如此，星散同寅可奈何。\n李牧提兵应我念，韩翃得句共谁哦。\n栖栖似怕嫦娥笑，独坐周台醉叵罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈冷庵","author":"张弼","text":"冷庵先生居柏台，心如铁石真奇哉。\n寒泉出窦归金椀，秋露和云注玉杯。\n却忆寻梅办诗债，也曾立雪待师来。\n尖风急雨江南地，洗尽苍生瘴疠哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵留别","author":"张弼","text":"千里移家到北京，优游蔗境荷皇明。\n那知白首多年别，重与青云诸老盟。\n韦曲风光诗烂漫，习池酒兴字歆倾。\n而今好著金台景，遍写山川万古情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题牡丹","author":"张弼","text":"同游南浦及芳时，漫赏名花朵朵奇。\n西子睡馀成巧笑，太真浴罢晕娇姿。\n檀心香拂绯罗袂，金缕光涵白玉卮。\n闻道洛中千万树，几家能得谪仙诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽义民陆宗秀","author":"张弼","text":"积粟曾将赈一乡，旌门棹楔焕龙光。\n满期桃李春风治，遽梦松楸夜雨凉。\n花落鹃声啼别院，月明鹤影吊空堂。\n扁舟偶过平湖曲，试读穹碑足感伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答赵应文","author":"张弼","text":"独坐梅花细嚼冰，清于老鹤静于僧。\n多应北阙思诸葛，未许东吴老季鹰。\n抚景孤吟聊自遣，趋时众醉竟谁醒。\n不堪最是怀君处，四壁蛩声半夜灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠潘先生","author":"张弼","text":"青毡白发壮心违，早拂风尘赋式微。\n九鲤无灵真是梦，三鳣有兆亦何依。\n肩舆扶醉桑榆暖，口业传家菽麦肥。\n最喜扁舟时过我，金鳌阁上看晴晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答太常卿翟廷光","author":"张弼","text":"南安老守张东海，矮屋西风雪满颅。\n身世真如庄子蝶，盘餐不压季鹰鲈。\n谁闻朝报兼边报，自办诗逋与字逋。\n惭负平生诸故旧，何须重问首丘狐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄翟太常","author":"张弼","text":"报恩寺里同年会，又过莺花十四番。\n荣辱升沉浑似梦，死生契阔不须论。\n孤魂吊月音书断，老马嘶风意气存。\n寄语清卿休袖手，淡云疏雨正黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠毛用中","author":"张弼","text":"二十年前共客途，青眉如画玉肌肤。\n康庄尘净紫骝健，太华峰高苍隼孤。\n壮志定期登一甲，文名先巳动三吴。\n何时有约重相会，明月高楼醉瑁湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"不赴赵弘济灯宴","author":"张弼","text":"城西高会赏芳年，千炬华灯五夜燃。\n锦轴纵邀佳客赋，黄柑还与细君传。\n绣衣行部来畿辅，太守移封向酒泉。\n奈我扁舟卧风雨，白龙潭畔竹林前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽湖广副使溺没洞庭湖","author":"张弼","text":"昨夜俄闻精卫号，思君双泪湿青袍。\n两间正气归鱼腹，一线孤忠托凤毛。\n端什有人投角黍，清明无土奠香醪。\n扁舟重过湖南道，忍对湘流读楚骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雅乐轩","author":"张弼","text":"白羽麾开紫塞尘，小轩清乐共佳宾。\n歌残杨柳三更月，欢洽貔貅万灶春。\n鼍鼓逢逢严节奏，牺尊滟滟较奇纯。\n优游尽是君王赐，南望神都稽首频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再用徐字韵答萧廷济","author":"张弼","text":"玉河堤畔步徐徐，扑面杨花飞雪如。\n春事巳看随水逝，宦情徒自向空书。\n匡时有策心常壮，却老无丹鬓易疏。\n寄语荆溪萧进士，相思又是月明初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺侯博士升翰林捡讨","author":"张弼","text":"摊书独坐绿槐阴，忽报侯芭擢翰林。\n凤阙承恩春浩浩，虎闱谈道昼沈沈。\n诸生总是青云器，四海争传白雪吟。\n东阁丝纶应入手，未容华发满朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽许参政父母","author":"张弼","text":"黄发相看八十馀，清时同拜紫泥书。\n稻香南亩扶藜杖，花满东园驾板舆。\n仙梦同游乘翠凤，宦途闻讣解金鱼。\n道山高冢埋双璧，宿草凄迷益叹吁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆抚州太守","author":"张弼","text":"小陆文章最所奇，一麾出守大江西。\n应闻畎亩歌岐麦，无复闾阎饭糁藜。\n泮水春深看鲤化，讼庭雨歇听莺啼。\n御屏此曰题名姓，伫看青霄降紫泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早春金员外尚德李主事廷美丘主事时雍过庆寿寺夜话余适不与次韵嘲之","author":"张弼","text":"良宵无幸听云和，程史閒看对岳珂。\n纳纳乾坤人自老，悠悠今古事何多。\n春回短褐凭谁送，客厌寒毡不我过。\n从此蓬门更深掩，小斋题作独吟窝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和沈宗能哭子韵","author":"张弼","text":"十里缄书寄九龄，满椷都是断肠声。\n生来不作婴儿态，死去深悬父子情。\n亭下玄文惟是草，塾中绛帐为谁迎。\n扁舟载酒娄江上，独记当年歌濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日送周济川归姑苏兼柬奚元启","author":"张弼","text":"九日乡心正郁纡，送君况复唱吴趋。\n但将青镜照华发，孤负黄花共紫萸。\n文字纵令人激赏，功名且任鬼揶揄。\n到家为问奚元启，何事经年不寄书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桂阙秋香送陆子秋试","author":"张弼","text":"贝阙璚楼倚泬㵳，木犀香暖夜迢迢。\n灵丹曰在浑无觉，沈水炉閒不用烧。\n白帝帐前方旖旎，素娥窗外转飘飖。\n东吴小陆乘风到，带得归来满锦标。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王廷贵掌南京翰林院事","author":"张弼","text":"白玉堂中伟丈夫，独携文印向南都。\n百年礼乐归编帙，四面江山入画图。\n李白酒船乘月汎，谢安棋局扫云铺。\n八砖花影休高枕，纶阁相将属大苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋送宋近仁主事之扬州董漕","author":"张弼","text":"中秋时节景偏新，禅院空廷集缙绅。\n共赏团圆今夜月，可堪离别故乡人。\n幽并凉雨思归切，淮海停云入望频。\n闻说东南方苦潦，到时急为济斯民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送秦主事还南京兼柬王学士 其一","author":"张弼","text":"锡山诗社重南州，中有奇才秦少游。\n美价连城真赵璧，神光贯斗旧吴钩。\n春风催起乘金榜，秋日相逢倒玉瓯。\n莫说明朝分手别，天涯独客正多愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送秦主事还南京兼柬王学士 其二","author":"张弼","text":"望乡频倚仲宣楼，况复题诗送旧游。\n彩笔锦笺空写恨，红亭画舫不知愁。\n梦回落月蛩声夜，兴入西风雁影秋。\n若见玉堂王学士，为言重理钓鳌钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿邵母","author":"张弼","text":"麻姑笑坐紫鸾车，夜过东陵旧相家。\n白玉壶中倾竹叶，青云堂上醉萱花。\n九还漫鍊终须就，六甲才周未足誇。\n更报儿郎好消息，曲江骑马试乌纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张贡士","author":"张弼","text":"南薰庭院雨疏疏，漫与张翰倒一壶。\n名姓巳登天府录，行程又逐汉关符。\n阴阴杨柳啼黄鸟，款款蜻蜓点绿芜。\n好问嫦娥月中桂，高枝还肯与君无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王清夫","author":"张弼","text":"京国交游几许人，惟君于我最相亲。\n青灯每共家常语，绿酒频浇世俗尘。\n斥泽鹪鹩羞奋翼，康庄骐骥尚逡巡。\n于今巳属孙阳顾，早踏春风谒紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄太原同知姜文博二首 其一","author":"张弼","text":"太原别驾姜文博，底事平生酷好书。\n万里关山频致简，五更风雪独巾车。\n乌皮几当千金璧，白练裙轻百斛珠。\n凡笔愧非王内史，徒劳注想欲何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄太原同知姜文博二首 其二","author":"张弼","text":"璧雍襟佩玉京尘，徒步从游独我亲。\n红烛飐风诗草定，紫毫飞雨墨花新。\n梵王宫里松阴夜，郭隗台前草色春。\n翘首东吴望西晋，六千里外各伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"城西夜别吴宪副仲玉","author":"张弼","text":"少小相随雁接行，分飞云路两茫茫。\n十年君作乘骢客，一第吾惭司马郎。\n白简冰霜心独赤，青衫尘土鬓先苍。\n今宵又是城西别，秉烛相看似梦乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次游山韵","author":"张弼","text":"草玄亭下老杨雄，此日登高兴不穷。\n渺渺帆樯孤鸟外，离离城郭淡烟中。\n六朝人物嗟何在，二陆文章亦是空。\n独有断碑传姓氏，剜苔漫读两三通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得玉山蒋仲学书","author":"张弼","text":"故人书自玉山来，细认缄题手自开。\n怪问道途淹岁月，惊看笔札出风埃。\n陆云自是三吴俊，百里原非庞统才。\n后会未知何处是，再三展读几裴回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陈仲智太守","author":"张弼","text":"遥闻五马出行春，麦陇桑阴动浃旬。\n泮水紫芹云霭霭，圜扉碧草雨津津。\n轻舟健马迎新使，美酒清诗会故人。\n黄霸年来将入相，京华卜第欲为邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"双寿","author":"张弼","text":"凭阑南望凤凰台，欲向君家把酒杯。\n二老生辰先后接，九重恩诰一齐来。\n丹丘琪树连枝发，玉井青莲并蒂开。\n闻道好音相对笑，褒封将及到三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄致仕张佥宪","author":"张弼","text":"长安西第出尘楼，暮饮朝吟忆旧游。\n别去西京逾十载，可怜一日抵三秋。\n团鱼无复朝回馔，舞鹤犹存壁上榴。\n纵是回仙也头白，浮名何必绊浮沤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蒋一宁","author":"张弼","text":"长安花柳少年游，今日重来未白头。\n流水三桥通旧宅，夕阳双塔对高楼。\n姓名巳入山公启，诗句应须水部留。\n十载尘冠看拂拭，清风不愧柏台秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陆廉伯谕德","author":"张弼","text":"前书未到后书催，千字曾无一字回。\n可是云泥真隔绝，每临风月独裴回。\n退朝俗务新诗债，出郭清游旧酒醅。\n啼鸟嘤嘤在高树，可曾侧耳一听来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送江东之广东提举兼柬郑东谷","author":"张弼","text":"十年别去蜀川路，万里相逢庾岭阴。\n年齿幸同怜我老，宦途暂屈惜君深。\n莫轻南海烟岚地，总是东坡旧墨林。\n况与郑虔为伴侣，时时沈醉共高吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬松江杨别驾","author":"张弼","text":"松江别驾杨夫子，九载书劳得暂归。\n头上乌纱新白发，箧中黄卷旧朝衣。\n金门还许陈三策，玉勒应须从六飞。\n东海老生偏感德，棠阴深护旧渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和广东按察使闵朝英韵","author":"张弼","text":"携手河梁又欲分，九重天上觐明君。\n一杯梅岭今宵雨，万里金台旧日云。\n骢马还迎前柱史，白鹅却付右参军。\n此行东阁应推毂，投笔班超著战裙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜雨不寐用前韵","author":"张弼","text":"拥衾不寐夜将分，饱听秋声在此君。\n金紫深恩惭舜禹，文章虚誉笑机云。\n东南海道频劳使，西北边尘尚驻军。\n最喜甘霖苏久旱，章江新绿漾湘裙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送礼部王希曾还朝","author":"张弼","text":"万里相逢鬓巳星，孤灯夜雨话鱼城。\n客程岭外初归马，宦况江东老步兵。\n铃阁幸同今日醉，冰衙不减旧时清。\n凄凉又说明朝别，更上周台望去旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洪都别意送陈粹之佥宪三首 其一","author":"张弼","text":"遥想滕王阁上筵，送行冠盖半同年。\n珠帘细雨飞晴昼，金瓮晴虹喷碧天。\n作记何须论王勃，抗章宁肯愧梅仙。\n若持马鬣天瓢去，还念西山乞雨篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洪都别意送陈粹之佥宪三首 其二","author":"张弼","text":"千里章江西北流，凭将此语到洪州。\n官期自计九年满，民意常怀百世留。\n夜雨圜扉青草遍，春风泮水紫芹稠。\n同年若问张东海，庾岭梅花伴独游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洪都别意送陈粹之佥宪三首 其三","author":"张弼","text":"屡约行期未定期，锦囊先贮百篇诗。\n为官自笑黄金尽，养性能令白发迟。\n留抚苍生天有意，送归紫阁水无私。\n平生长剑今将试，莫使辽阳久驻师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送洪太守兼柬柳同知","author":"张弼","text":"摵摵秋声撼井梧，篝灯铃阁办诗逋。\n专城旧识洪兴祖，别驾新来柳仲涂。\n无志我甘淹皂枥，有言君可伏青蒲。\n南安岭上梅花雪，道远无由荐一壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送□廷器还松江","author":"张弼","text":"乡里故人能远过，惭予宦业竟蹉跎。\n黄金依旧青毡冷，乌帽从新白发多。\n为政未能驱孟虎，草书何用博群鹅。\n到家为说归来计，司马侨头听棹歌。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟泊泰和与桑民怿司训夜话","author":"张弼","text":"鸂?沙边夜泊舟，故人尊酒话绸缪。\n十年北海鹏风小，七日南山豹雾稠。\n甘旨关心游子恨，文章传世丈夫羞。\n袖中何物峥嵘甚，却是任公旧钓钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陈梓之","author":"张弼","text":"北往南来事几多，朱颜绿鬓近如何。\n得閒且与酒为伴，有兴莫教诗作魔。\n不信终南开捷径，自甘砥砺障颓波。\n赠行草字三千纸，只为深情不博鹅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送祁大参左迁石阡守和韵","author":"张弼","text":"随天行止乐天真，岭有舟航海有津。\n薇省衣冠殊念旧，石阡雨露顿更新。\n清诗自写陶岑兴，直道难趋卫霍亲。\n闻说郡斋幽绝好，青松绿竹四为邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送姚良甫二守之京","author":"张弼","text":"青衫同作缙云郎，漂泊东南各一方。\n旧事都成今日梦，壮怀不减少年狂。\n江潮秋色供诗料，岭海蛮烟避剑芒。\n京国故人如我问，尘缨久欲濯沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠赣州李推府","author":"张弼","text":"黄花时节故人来，奈此鱼城酒酿梅。\n话旧也须三日醉，流年不计二毛催。\n江山佳胜金鳌阁，梧竹清深舞剑台。\n嗟我与君俱是客，登高随处且裴回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢刘太守寄灵砂丹","author":"张弼","text":"去岁凄肰苦病缠，灵丹到手巳安肰。\n不愁白发三千丈，且说红颜八百年。\n凿开五岭为平地，俯弄三光飞上天。\n东海泓肰如酒盎，与君醉赋紫霞篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送梧州陈太守","author":"张弼","text":"麟图初剖守苍梧，文武兼才大丈夫。\n宪府春风瞻鸑鷟，辕门夜月扰于菟。\n致身谩取封侯印，报国先摅服远图。\n百粤两籓关隔地，几多顽矿待洪炉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠龙泉司训吴汝成","author":"张弼","text":"三间柿叶万株蕉，写尽群书更写骚。\n半世青毡甘冷淡，数茎白发任飘萧。\n韩欧门下源流远，李杜坛前勋业高。\n嗟我无端怀旧故，□泉江上水滔滔。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄刘汝深","author":"张弼","text":"屡约游山久未谐，山灵应笑事多乖。\n白云明月徒清典，短屐轻舆负好怀。\n遥忆金尊双舞剑，谁提铁笔一镵崖。\n刘郎更与桃花约，三月春风正自佳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻秋官唐君廷贵补福州守寄诗送之","author":"张弼","text":"紫宸朝罢见除书，旧友新乘五马车。\n沧海月明天荡荡，关山春到雨徐徐。\n芭蕉影转黄堂静，茉利香浮绣閤虚。\n愧我兵曹素餐吏，麟符何日换金鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游大龙山","author":"张弼","text":"故人同上大龙山，油幕高张霄汉间。\n雕没西江流潦白，雁回南岳断霞殷。\n濂溪风月还如在，铁汉音尘似可攀。\n自笑醉翁今果醉，青天亦为一开颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]