[{"title":"粤洲草堂泛舟得明字","author":"梁有誉","text":"荡漾金塘霁色明，蓼花风起木兰轻。\n共悬霄汉乘槎兴，忽动江湖击楫情。\n载酒客来凫雁起，采芳人去芰荷平。\n就中更有悠然思，满壑寒林作水声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻边报","author":"梁有誉","text":"朔气飞霜塞草凋，胡儿饮马夜过辽。\n阵临古戍多探骑，猎近平原见射雕。\n空闻蒲垒为秦地，漫说莎车属汉朝。\n遂使遐方疲战伐，将军谁是霍嫖姚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜宿清远江口","author":"梁有誉","text":"短棹依依繫晚风，壮怀离思浩无穷。\n荒村夜急菰蒲雨，远戍秋悲鼓角风。\n白雁影斜江树暗，青猿声断岭云空。\n更堪处处征输急，深篝休论战伐功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题隐居图","author":"梁有誉","text":"结茅栽树倚岩幽，避迹甘从麋鹿游。\n屋外青山通短径，门前修竹荫寒流。\n看云时隐乌皮几，对客閒披鹤氅裘。\n可是淮南招隐地，西风萧瑟桂丛秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄丁戊山人二首 其一","author":"梁有誉","text":"遥忆翛然鸾鹤姿，暂来倏去本无期。\n曹溪此日应传偈，衡岳何人共采芝。\n堪叹尚平辞累早，谁言弘景住山迟。\n他年紫气朱陵畔，知尔初成玉液时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄丁戊山人二首 其二","author":"梁有誉","text":"昔从萧寺接风流，把酒相看赋远游。\n海上十年还浪迹，山中一别复惊秋。\n野烟细绕卢敖杖，夜雪难乘剡曲舟。\n空寄诗篇慰岑寂，知君心为白云留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅华堂雅集","author":"梁有誉","text":"蓬扉散帙浑忘暑，竹坞相期迥绝凡。\n雨过橘阴团曲径，风来桂子落幽岩。\n泉声入户岚扉润，岫影当窗紫塞衔。\n潇洒不知归路晚，绕山凉籁起风杉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瑶石山房夜话 其一","author":"梁有誉","text":"窗外鸟啼黄叶堕，井边虫响绿芜寒。\n石床云满无人扫，山笥书成只独看。\n伏枥漫惭千里志，巢林犹羡一枝安。\n空将瑶草伤迟暮，江海冥冥叹羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瑶石山房夜话 其二","author":"梁有誉","text":"竹坞萧条夜漏迟，更堪剪烛话幽期。\n叶声四起催山雨，涧溜斜分到石池。\n松菊喜逢三径日，风尘忆共五陵时。\n凭阑莫奏招商曲，零落芙蓉越水湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题次唐人韵 其一","author":"梁有誉","text":"欢承恩宠冠椒风，醉倚金屏玉殿东。\n吟罢却愁鹦鹉听，书成还藉紫鸾通。\n雾拖蝉鬓匀新绿，花拂鸳裾落腻红。\n独有罗敷矜艳色，采桑南陌叹飘蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题次唐人韵 其二","author":"梁有誉","text":"未央前殿按歌来，花外轻车殷夕雷。\n豹尾喜随芸阁度，雁灯深照竹宫回。\n谏因方朔恢谐得，赋捷枚皋扈从才。\n一曲霓裳千岁乐，粉香飞作茂陵灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桐庐道中","author":"梁有誉","text":"日暮烟岚路欲迷，山樱落尽见鼯啼。\n林藏宿雨诸溪长，峡束长江万木低。\n野老移家依碧嶂，松门无路访丹梯。\n漂零却忆当年事，一曲劳歌越水西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登城上楼","author":"梁有誉","text":"木落城头风怒号，百年形胜自周遭。\n碧窗日晓沧溟阔，画栱云开象纬高。\n目断层霄无雁字，梦淹南国有渔舠。\n登临一笑成今昔，弹剑酣歌愧尔曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朝中候旨呈同事诸公","author":"梁有誉","text":"晓望铜龙辟曙辉，曳裾趋候掖垣扉。\n西山云雾开黄甸，北阙星辰护紫微。\n地迥遥瞻天仗肃，时平惊说羽书飞。\n腐儒通籍惭何补，拟献甘泉愿转违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送莫祠部督学贵州","author":"梁有誉","text":"献岁星轺出汉京，南中鸟道入云平。\n遥经迁史浮湘处，肯让文翁化蜀名。\n恋阙梦悬春署月，登高诗满夜郎城。\n莫嗟万里风烟迥，揽辔应怜报主情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送同年施钦甫宰萧山二首 其一","author":"梁有誉","text":"羡君墨绶去翩翩，茂邑风流此日传。\n绿树人家渔浦外，白云官舍凤山前。\n琴弹单父庭稀讼，花发河阳赋几篇。\n共是郑庄门下客，报恩应拟在何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送同年施钦甫宰萧山二首 其二","author":"梁有誉","text":"看花上苑春同醉，折柳都门意不胜。\n帆带夕阳过北固，舄随秋色入西陵。\n中朝共爱才华逸，百里还闻歌颂兴。\n莫谓徒劳寡奇思，知君心有玉壶冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴仁卿南归因附家信","author":"梁有誉","text":"献策名成出帝乡，高才不愧汉贤良。\n趋庭彩服生春色，过里儒冠带御香。\n粤社交游空岁月，燕台去住各烟霜。\n寒梅欲发聊持赠，消息凭君寄八行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄同年卓见可时卓宰新昌","author":"梁有誉","text":"蓟门一别怆骊歌，天姥峰南茂宰过。\n邑里花香当昼远，琴边山色入秋多。\n蜚声早重明珠价，抱病惭同片玉科。\n为问旧时王谢郡，风流文藻近如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邝和仲之任广德","author":"梁有誉","text":"公车待诏几经秋，桐汭今乘五马游。\n烽火频年堪涕泪，循良此日慰诛求。\n山连白石横朝霭，溪下丹阳急暝流。\n如此风光殊不恶，相思吾倚仲宣楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送罗山甫还润州","author":"梁有誉","text":"罗含长笑出燕都，负笈空藏五岳图。\n搔首风尘悲燕雀，浪游诗卷满江湖。\n人怜玉树秋云远，家对金陵海月孤。\n为问戴颙栖隐处，烟霞还似昔年无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五月五日雷雨时于鳞子与子相元美过访共赋","author":"梁有誉","text":"卧病长安愁毒热，雨来爽气满乾坤。\n西山雷过蛟龙斗，北极云垂海岳昏。\n万里乡心还促膝，百年风物谩开樽。\n彩丝艾叶随时俗，弹剑酣歌怆客魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻董原汉卧病作此讯之","author":"梁有誉","text":"春来愁绪日冥冥，燕峤风光自草亭。\n入塞战尘天外黑，隔城山色雨中青。\n驱驰岁月怜同病，肮脏江湖笑独醒。\n南北乱离灾不细，汉家谁问董生经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡比部文徵之留都","author":"梁有誉","text":"西都词赋见才豪，此日风尘揽佩刀。\n吴楚地当瓜步拆，东南山拥秣陵高。\n潮边春草吟骚客，城上秋云对法曹。\n六代繁华应涕泪，况堪天地战争劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜与谢山人茂秦","author":"梁有誉","text":"永夜风林怒未平，不眠乌鹊自多惊。\n清霜满树禁钟断，缺月低空邻杵鸣。\n燕赵浪游今日意，乾坤长笑古人情。\n黄尘郁郁俱无赖，拟共渔樵过此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张掖门送座主朱公旅榇还归德","author":"梁有誉","text":"丹旐遥驰睢水滨，都门恸哭起行尘。\n乾坤尚想凌云赋，烽火空伤报国身。\n季子剑留悲异日，中郎书在与何人。\n南湖烟水秋应惨，不过西州亦怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中于鳞子与子相元美过访得寒字","author":"梁有誉","text":"青尊病里罄交欢，况复风尘旅思宽。\n天地祇怜词客在，莺花懒逐世人看。\n边关鼓角春声惨，宫阙星河夜色寒。\n牢落他年垂钓者，白云犹自忆琅玕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送周一之出塞","author":"梁有誉","text":"蓟门萧瑟雁鸿秋，王粲从军事远游。\n侠客临岐赠匕首，故人把袂问刀头。\n龙沙旌闪胡尘断，鹿塞笳鸣汉月流。\n搔首乾坤俱涕泪，古来国士几封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日文德承吴子充二山人过访","author":"梁有誉","text":"燕台佳节遇重阳，词客经过共举觞。\n魏代风流颁菊蕊，汉家故事佩萸囊。\n空瞻沆瀣金茎上，漫接烟云石阙旁。\n不用登临频怅望，暮天鸣雁自成行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送崔同年掌教建昌","author":"梁有誉","text":"独骑匹马出风埃，尽道儒官得异才。\n星渚月当鸣瑟处，匡山云绕读书台。\n圭璋早为明时用，桃李还从暇日栽。\n莫道青毡长寂寞，石梁飞瀑好徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄黎惟敬","author":"梁有誉","text":"故人家傍青山曲，千树梅花数亩池。\n愧我昔为三径客，忆君今赋四愁诗。\n旅窗月照焚香处，水阁风清染翰时。\n两地幽怀不同赏，朝簪空自负归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚泊小金山禅寺","author":"梁有誉","text":"梵王宝殿郁重重，万叠烟花绕鹫峰。\n珠树独栖玄圃鹤，瑶坛长起法池龙。\n绣棂虚映江光入，残碣真看野藓封。\n直北彤云瞻望迥，江湖何用叹萍踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春病中述怀 其三","author":"梁有誉","text":"频年烽火滞天涯，隐几萧条感物华。\n万里春衣空过雁，千村寒食自飞花。\n人间谩忆冲星剑，海上虚疑贯月槎。\n自惜不才成傲吏，一辞神武即烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春病中述怀 其四","author":"梁有誉","text":"含香朝退每从容，一眺乾坤极汉封。\n三辅地形通王气，五陵春色入边烽。\n西南战檄何时息，吴楚军储此日供。\n病忆罗浮尘梦里，断云睛挂海门松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送潘尚书改调南京","author":"梁有誉","text":"曾向东山起谢公，自怜筹策几人同。\n清时心迹行藏里，白首诗篇感慨中。\n曳履汉庭虚夜月，鸣珂江左自秋风。\n悬知铜柱铭勋后，天畔还看剑气雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送同年沈仪曹之任留都","author":"梁有誉","text":"清秋分袂重踌躇，客里那堪更索居。\n蓟北风尘嗟对酒，江南鸿雁已传书。\n片云孤月三山外，衰草寒原六代馀。\n到日休文应吊古，閒成八咏意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"少峰草堂卷为商中丞作","author":"梁有誉","text":"江上孤峰紫翠深，百年天地几登临。\n秋来雨送三湘色，日落云垂七泽阴。\n橘树素封非俗累，桂丛招隐见幽心。\n勋名岂负烟霞约，兰佩空伤楚客吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"豫章遇时睿夫行人时奉使兹地","author":"梁有誉","text":"岐路苍茫惊把袂，问余何事楚天来。\n倦游客似相如病，奉使人疑博望才。\n海内风烟虚倚剑，江中秋色独登台。\n沧洲后夜瞻银汉，缥缈仙槎北斗回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王元美席上赋得怀罗浮得馀字","author":"梁有誉","text":"缥缈丹梯万仞馀，风尘回首列仙居。\n石楼积翠临沧海，铁柱飞泉落紫虚。\n鸾鹤凌霞时自度，松苓满地日堪锄。\n何当归访葛洪去，四百峰头好结庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感秋 其一","author":"梁有誉","text":"一望关河夕照孤，商声萧瑟起平芜。\n汉畿四塞称天府，周室千年纪瑞符。\n承露金茎凌缥缈，迎风琳观倚虚无。\n悲歌感慨人何在，莫向时平说霸图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感秋 其二","author":"梁有誉","text":"玉露团团凋紫兰，风尘空叹别离难。\n美人挟瑟岁云暮，客子当歌月正寒。\n塞北千金求騕袅，越南万里贡琅玕。\n夔龙勋业还今日，搔首云天愧羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感秋 其三","author":"梁有誉","text":"江湖此日复何如，谩向天南赋卜居。\n京国念归怀陆橘，乡园行乐想潘舆。\n候虫声起灯花落，社燕巢空木叶疏。\n一出碧山秋已晚，惭随时哲待公车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感秋 其四","author":"梁有誉","text":"碧纹冰簟正宜秋，卧看银河净欲流。\n鳷鹊观前清露滴，卢龙塞下暮云稠。\n临风长想苏门啸，多病徒怀杞国忧。\n诸弟故园应北望，相思知上海边楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感秋 其五","author":"梁有誉","text":"佳节聊登郭隗台，长空澹澹鸟飞来。\n客衣未授寒砧急，羽檄遥传暮角哀。\n树色依微临睥睨，云光浮动近蓬莱。\n可堪多难当摇落，却忆东篱菊又开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感秋 其六","author":"梁有誉","text":"蓟北风烟惊壮心，感时应觉二毛侵。\n功名共羡虞卿璧，世事徒怜季子金。\n战后关山生暝色，雨馀城阙澹秋阴。\n即看节候堪杯酒，徙倚聊为越客吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋去和同年胡伯贤","author":"梁有誉","text":"河汉迢迢天宇开，静闻灵籁起高台。\n千峰凉雨窗前急，万壑惊涛树杪来。\n燕塞乍飘清角断，汉宫时动暮砧哀。\n思乡越客情偏切，中夜披衣听几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋前一夕雨过黎惟敬山房","author":"梁有誉","text":"青山阒寂偶寻君，斗酒哀歌思不群。\n天上阴晴浑莫定，人间弦管转愁闻。\n梧桐声急千家雨，岩壑寒生四壁云。\n明夜月圆谁共看，露荷风竹对秋分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山馆秋日陈公载黎惟敬二子过访","author":"梁有誉","text":"高秋岳色翠嶙峋，搔首云天眺望新。\n词客共题青玉案，浮名空愧白纶巾。\n即愁魑魅窥人过，况复风烟堕泪频。\n莫向西风感摇落，浊醪相过任吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五仙观眺望","author":"梁有誉","text":"岁晏琴尊聊纵赏，况逢高阁俯长川。\n孤城海气霾寒日，万壑钟声出暝烟。\n辽鹤归来空异代，石羊化去不知年。\n沧桑自古何须问，肠断江湖落雁前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"梁有誉","text":"瑟瑟西风吹众芳，多情宋玉自悲伤。\n谁家笛弄千山月，半夜乌啼万树霜。\n岂有勋名思汗竹，敢将词赋拟长杨。\n凭阑一笑秋将晚，白石清泉兴不忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登黎氏山楼 其一","author":"梁有誉","text":"楼前山气日氛氲，偶为看山一访君。\n下榻微风吹石壁，当歌明月出江云。\n断鸿远向沙头落，孤磬低从树杪闻。\n祇道避喧非避世，他时休勒稚圭文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登黎氏山楼 其二","author":"梁有誉","text":"苔径云泉松十寻，风回众壑自龙吟。\n谢家群从多诗兴，苏岭高人发笑音。\n树色夹城春雨暗，江光吞壁夕阳沉。\n生涯卒岁浑疏豁，望逐金茎使不禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登黎氏山楼 其三","author":"梁有誉","text":"翠微丹壑倚疏楹，散帙焚香岂世情。\n吟罢独看河岳色，客来同听桂松声。\n三春帘捲城云入，半夜窗临海日明。\n拟把钓竿终远去，即凭高阁瞰东瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏与陈公载黎惟敬惟和梁思伯游北郭诸山","author":"梁有誉","text":"性癖甘从猿鸟群，出郊风物谩纷纷。\n村前花逐诸溪水，雨后人耕满壑云。\n桂树几同骚客赋，松醪遥自野僧分。\n共期结屋开青壁，为爱流泉尽岁闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登白云山顶 其一","author":"梁有誉","text":"报导春光出郭残，谩携樽酒上层峦。\n涧泉杂雨鸣山阁，空翠因风湿客冠。\n阴壑冥冥宵见日，长松落落夏生寒。\n谁知一别含香署，遮莫青峰独耐看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登白云山顶 其二","author":"梁有誉","text":"石梁天畔驾晴霓，况复风光且杖藜。\n春蔼树迷秦岭北，夕阳山满汉台西。\n数龛荒藓诸僧散，一径飞花独鸟啼。\n莫向尘寰嗟白发，好从灵峤问丹梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登白云山顶 其三","author":"梁有誉","text":"野客寻幽春暮来，悬崖曲磴断氛埃。\n天横五岭空青出，日射重溟素练开。\n阴井尚闻龙化去，古坛不见鹤飞回。\n浮云满目殊无定，莫厌登临数举杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安期岩","author":"梁有誉","text":"东南紫气动江关，玉舄飘飘遂不还。\n谩忆鹤归华表柱，更传仙在沃焦山。\n松梢花落禽衔去，石上芝生客到扳。\n今古苍茫俱莫问，何如散发弄潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山馆燕集忆梁彦国仲登二山人作此招之 其一","author":"梁有誉","text":"忆赋思玄意独深，山川萧瑟几登临。\n百年祇合持螯醉，万事何妨拥鼻吟。\n海上断云秋漠漠，天边落木岁阴阴。\n稽山庐岳风流远，此日词人可共寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山馆燕集忆梁彦国仲登二山人作此招之 其二","author":"梁有誉","text":"门巷萧条辙迹回，病馀空愧草玄才。\n竹林已喜群贤集，萝径还期二仲来。\n寒日隐山孤磬起，残霞临水暮鸿哀。\n江边岁晚梅花发，应对幽香数举杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮秋登镇海楼","author":"梁有誉","text":"丹梯袅袅虚无里，下界遥看紫翠重。\n星斗暮悬溟海树，烟霞秋断越山钟。\n杯前风景非秦代，鸿外关河尽汉封。\n搔首白云应可掇，谁骑黄鹤蹑仙踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄宗吏部子相","author":"梁有誉","text":"野馆西风丛桂开，天长犹阻朔鸿来。\n忧时应念山公启，作赋空惭水部才。\n一卧烟霞违汉署，几看烽火望燕台。\n清秋河岳堪藜杖，莫动江南庾信哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日寄大崙衡南二山人 其一","author":"梁有誉","text":"抱病独吟霜树根，乱馀风物倍惊魂。\n清秋远道豺狼过，落日浮云海岳昏。\n餐菊可堪骚客怨，佩萸犹忆汉宫恩。\n沧江岁晏清枫冷，烟艇鱼竿许共论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]