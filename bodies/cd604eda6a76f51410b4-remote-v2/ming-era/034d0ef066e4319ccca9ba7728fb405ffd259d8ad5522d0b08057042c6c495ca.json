[{"title":"过忻口","author":"杨巍","text":"落日临寒渚，悲风动戍台。\n云随长路去，水自乱山来。\n白发身将老，苍生志未灰。\n沙禽鸣向客，旅思转悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33269,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"逢杨风轩教谕时风轩罢官久矣劝之东归故乡","author":"杨巍","text":"前岁一官罢，于今尚远途。\n鬓毛惊尽白，囊箧想应无。\n老更攻诗翰，狂犹到酒垆。\n东归旧业在，三径未全芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33270,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿穆陵关效杜荀鹤体","author":"杨巍","text":"野馆千山里，颓垣少四邻。\n雄图追往古，衰鬓忆吾亲。\n岩月望不出，秋虫聒杀人。\n关门候明发，南去有通津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33271,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赴南都登太岳二首 其一","author":"杨巍","text":"驻马登东岳，凭高辨四溟。\n始知人世小，不断此山青。\n楼阁秋孤出，川原昼杳冥。\n将寻孙复隐，忽忘有严程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33272,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赴南都登太岳二首 其二","author":"杨巍","text":"梁甫名仍在，登封事不磨。\n逢人询古迹，览胜欲狂歌。\n匹练吴门近，丰碑汉代多。\n还能舒老眼，万里见沧波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33273,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"栾城读吴川楼给事壁间诗次韵时川楼犹谪宦","author":"杨巍","text":"青琐同袍友，知从此地眠。\n朝中传奏疏，客里见诗篇。\n大陆秋风急，长河夜雨连。\n赐环应见近，犹自著吟鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33274,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答温中丞见寄","author":"杨巍","text":"留滞春将晚，思君旷所期。\n荒城书到处，白日梦回时。\n老病医难得，兵符谢已迟。\n归途定相见，应叹鬓如丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33275,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清明后一日刘通政过岭园","author":"杨巍","text":"岭圃逢君夕，春风食尚寒。\n不言别后事，先问圣躬安。\n存殁悲诸老，去留任一官。\n云林最深处，相对酒杯宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33276,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋岭园对月","author":"杨巍","text":"为问林塘月，如何分外明。\n转怜河汉近，偏映竹松清。\n疑有羽人驾，杳无天籁声。\n庾公兴深浅，兹夕可相并。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33277,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄题屠赤水空明阁二首 其一","author":"杨巍","text":"闻君起草阁，赛我半间楼。\n深喜居相似，翻悲路阻修。\n江云晴乱入，山月晓还留。\n偶记少陵语，乾坤到十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33278,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄题屠赤水空明阁二首 其二","author":"杨巍","text":"高调已绝尘，林间阁又新。\n溪山且碍眼，名利岂关身。\n倚槛观无际，谈玄坐至人。\n漫言不识路，梦绕鉴湖滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33279,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠吕山人剑","author":"杨巍","text":"宝剑带龙文，空藏未策勋。\n呼童开玉匣，双手赠茅君。\n江海独行处，鲸鲵应散群。\n夜深漫拂拭，光在斗牛分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33280,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病中喜雨","author":"杨巍","text":"海国经年病，山堂少客过。\n平明看细雨，长日对垂萝。\n世事浑宜懒，生涯岂在多。\n老来厌兵甲，一洗望天河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33281,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三家村","author":"杨巍","text":"海色暗荒原，萧条自一村。\n日高不见火，人到始开门。\n屋比巢居陋，储无儋石存。\n犹闻催两税，对此欲销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33282,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"首尾吟二首效宋人体 其一","author":"杨巍","text":"我思尧舜时，寮寀尽师师。\n犹谨危微念，长歌喜起诗。\n中天悬日月，万古仰纲维。\n击壤人不见，我思尧舜时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33283,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"首尾吟二首效宋人体 其二","author":"杨巍","text":"我思孔孟时，人得圣贤师。\n六籍咸遵古，七篇半引诗。\n无非明帝道，总是正天维。\n异说纷然出，我思孔孟时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33284,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"得二鹤","author":"杨巍","text":"本是云霄侣，伴予守故丘。\n敢嫌双口累，似与二仙游。\n舞绕花间径，唳高尘外楼。\n身轻如有日，跨尔向罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33285,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊居秋兴","author":"杨巍","text":"郊原净秋色，幽事甚从容。\n不厌山僧过，每于田父逢。\n为桥通野水，伐木出寒松。\n更愿烟尘绝，终身一老农。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33286,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柏林寺别王计部寺即李晋王葬所","author":"杨巍","text":"园陵今作寺，秋草向沙陀。\n事叹千年往，人怜两度过。\n山川明霁雪，钟磬带烟萝。\n于此别知己，尊前意更多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33287,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日平定候代次韵詶任苗二子","author":"杨巍","text":"如何已解绶，犹此客天涯。\n为有求羊过，频开早晚衙。\n诗人情自好，尘世事堪嗟。\n遥忆岭园里，春深树树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33288,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠阳信武明府","author":"杨巍","text":"我读循良传，惟君似古人。\n爱民不啻子，接士俨如宾。\n野润潘花遍，城春陶柳新。\n圣朝正求治，早晚侍枫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33289,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重过沾化范公园","author":"杨巍","text":"人忆羲皇上，园开渤海西。\n以予别去久，是路再来迷。\n雨遍桑麻野，春深桃李蹊。\n平生一范老，不见意悽悽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33290,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南山上人来访送以小诗","author":"杨巍","text":"寂寞谁相访，师来千里馀。\n不言心自了，一咒病能除。\n归路石仍滑，世缘老更疏。\n从兹门再掩，草色遍郊居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33291,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠车镇村族叔三老","author":"杨巍","text":"吾家养斋老，所性好清閒。\n薄地不盈顷，草房只数间。\n宅邻广武墓，树接乌鸦山。\n已住郊原外，柴扉长日关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33292,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日同吕山人登览旷亭","author":"杨巍","text":"极目川原外，放怀天地间。\n千林秋叶坠，万里塞鸿还。\n风雨诗偏壮，茱萸晚正斑。\n不因君落帽，谁解是龙山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33293,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题介休王医杏林卷","author":"杨巍","text":"卖药兼求道，年年海上过。\n应人浑偶尔，济世有诸科。\n术异泣神鬼，心閒到薜萝。\n春来闻种杏，万树绕汾河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33294,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题马愧非巢云亭","author":"杨巍","text":"亭子起何所，高悬古柳间。\n为聆黄鸟语，兼爱白云还。\n杯外分平楚，座中到远山。\n襟期有如此，能望不能攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33295,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"壬申九日登览旷亭忆旧会兼喜谷司马初还次前韵","author":"杨巍","text":"往事真如昨，登高复此间。\n岁时人半老，江海客初还。\n暮雁声偏疾，寒花色自斑。\n不须多感慨，东望有牛山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33296,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送圆上人还五台","author":"杨巍","text":"清凉古佛地，有屋傍西台。\n涧雪春仍积，岩花夏始开。\n已知苦行满，想见文殊来。\n二虎倘无恙，为予问讯哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33297,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"庚寅九日登高","author":"杨巍","text":"林下登高处，飘然兴不同。\n迎霜树五色，对酒菊多丛。\n世事浮云外，风流落帽中。\n莫愁秋渐晚，天际有归鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33298,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"閒居赠五台僧","author":"杨巍","text":"浮世岂忘我，衰颓无片能。\n绝交惟独往，问字几人曾。\n门径长青草，轩窗挂紫藤。\n莫言少客访，见有五台僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33299,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元夜病足","author":"杨巍","text":"春到人犹病，寒灯卧似吟。\n篮舆他日事，药裹异乡心。\n岁序惊沙塞，椒花忆故林。\n归期仍未定，沧海梦中深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33300,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"家居次吕山人","author":"杨巍","text":"罢官真是迟，多病老来时。\n难抱灌花瓮，空临洗砚池。\n闭门春草长，伏枕隙驹驰。\n潦倒不堪用，非君孰我知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33301,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病足自遣","author":"杨巍","text":"仰卧长终日，空斋澹所思。\n何须穷海岳，祗贵得希夷。\n真性能无损，凡躯未足悲。\n文昌诗句好，身病是閒时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33302,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答王龙门见寄韵","author":"杨巍","text":"自向山中卧，萧条门径秋。\n市沽愁不醉，药品病多收。\n世事归诗卷，生涯有钓舟。\n闻君欲相访，家在海西楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33303,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月夜至山园","author":"杨巍","text":"而我爱光景，山园夜亦过。\n微风醒鸟梦，明月澹烟萝。\n露冷蛩声少，亭空树影多。\n此中得佳句，高咏向星河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33304,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋月吟","author":"杨巍","text":"清光正东上，大火已西流。\n皎皎四时月，如何偏爱秋。\n玉绳低草阁，金露湿芳洲。\n遥忆仙人宅，五城十二楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33305,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日閒居三首 其一","author":"杨巍","text":"笑我起居处，寥寥一竹床。\n长贫谙性命，多病识行藏。\n地与红尘远，秋怜白日凉。\n山僧久不至，木落井西堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33306,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日閒居三首 其二","author":"杨巍","text":"漫道无生理，秋天亦苦予。\n倩人斸药品，伐木结寒庐。\n酒采菊花酿，唫收桐叶书。\n所欢遂閒散，名利将焉如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33307,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日閒居三首 其三","author":"杨巍","text":"荒径无人到，柴门带晚霞。\n不知身抱病，且喜菊开花。\n买鹤供诗料，鬻书送酒家。\n秋来禾黍熟，垂老此生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33308,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"还家逢九日二首 其一","author":"杨巍","text":"自喜一官罢，宁悲三径芜。\n悬车少客访，入户有僮扶。\n黄菊寒仍在，青山道不孤。\n老来慵戏马，高枕卧江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33309,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"还家逢九日二首 其二","author":"杨巍","text":"芳辰来故国，秋色遍柴门。\n正值菊花候，新开竹叶尊。\n晴云高雁鹜，暮雨长兰荪。\n偶诵閒居咏，斯人可共论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33310,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和吕山人病酒","author":"杨巍","text":"酒病尝难受，山人其奈何。\n诗仍枕上得，饭已午时过。\n问字良朋集，闭门芳草多。\n忽闻发高兴，予亦散微痾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33311,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五月廿七为诞陶儿日时寓都门听覆试念之作此","author":"杨巍","text":"两年诞汝日，皆在客途间。\n正属炎蒸候，其如游子颜。\n科名是何物，天性自相关。\n从此堪偕隐，云深马谷山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33312,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月夜","author":"杨巍","text":"斋中人去夜，松际月来天。\n自击罗浮磬，高歌招隐篇。\n轩窗残雪在，河汉数星悬。\n鹤梦呼不起，吾心谁为传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33313,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闰八月十五柬王高二君以前月惠酒病不能会","author":"杨巍","text":"正当延赏夜，一病独成眠。\n北海尊空在，南楼兴杳然。\n清宵嗟已失，白月喜重圆。\n兹夕谁能负，星河万里天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33314,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戏题三角亭三首 其一","author":"杨巍","text":"茅亭独面东，想像总无同。\n形出方圆外，数兼天地中。\n联诗宜石鼎，讲道去尸虫。\n混世当如此，宁论拙与工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33315,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戏题三角亭三首 其二","author":"杨巍","text":"何方问蓬岛，尘世路多岐。\n独向小亭坐，还如上古时。\n斜开蒋诩径，静遣季文思。\n尽日看春色，萋萋薋菉施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33316,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戏题三角亭三首 其三","author":"杨巍","text":"前后悲身世，于今记得曾。\n年光何鼎鼎，人意尚棱棱。\n白日依檐转，昏星傍溜澄。\n惟应招总印，共此阅传灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33317,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戏题草屋三首 其一","author":"杨巍","text":"爽垲非吾愿，结茅独傍村。\n经营谋素拙，巢窟意犹存。\n俗士频回驾，高僧常到门。\n此中风日别，炙背有馀暄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33318,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戏题草屋三首 其二","author":"杨巍","text":"土壁须臾就，柴扉容易开。\n海乡乏木石，栋宇借蒿莱。\n尚恐秋风妒，应无燕雀来。\n平生怀栗里，八九亦多哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33319,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戏题草屋三首 其三","author":"杨巍","text":"茅茨高几许，所愿避风寒。\n雅称蓬为户，偏宜竹作冠。\n自甘刍狗弃，人以卧龙看。\n深感谷峰老，为予赋考槃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33320,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日郊居二首 其一","author":"杨巍","text":"岭圃寡尘鞅，悽然秋日心。\n呼僮移野菊，留客醉霜林。\n落叶悲时序，浮名笑古今。\n静言思化理，世虑尽销沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33321,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日郊居二首 其二","author":"杨巍","text":"昨夜凉风至，转怜景物新。\n已苏多病体，况复少烟尘。\n岁稔登禾稼，秋高有蕨莼。\n潇然无一事，犹念未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33322,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登新兴里黄台","author":"杨巍","text":"台起县中央，登临意独伤。\n愁云连海暗，蔓草接天荒。\n几里无鸡犬，迎冬见雪霜。\n凭谁问民瘼，村落满斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33323,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重过马谷山村","author":"杨巍","text":"山村重到日，风景益堪亲。\n家远惟宜病，境幽岂避人。\n云开山洞晓，水漫九河春。\n投老此中得，当年枉问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33324,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送汪山人游山海","author":"杨巍","text":"自是江湖客，犹然变姓名。\n妻拿贫不问，书画老逾精。\n云黯秦王岛，山高孤竹城。\n同谁登碣石，醉看海涛生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33325,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠李广文移居兼呈王宋二丈","author":"杨巍","text":"定尔嫌车马，还因欲卜邻。\n萧条委巷内，来往向谁频。\n门径不除草，图书长傍身。\n宋王家咫尺，俱是素心人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33326,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和吕二山人君子居韵二首 其一","author":"杨巍","text":"渤海非东海，穷乡奈薄游。\n惭予为地主，爱汝独风流。\n野色蓬三径，涛声夜一楼。\n邻人亦知德，送酒过墙头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33327,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和吕二山人君子居韵二首 其二","author":"杨巍","text":"此地谁堪隐，君来就我居。\n若非耽寂寞，宁不厌樵渔。\n绿柳村边舍，黄庭枕上书。\n相看吾道在，世路竟何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33328,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答吕二山人雨中问病韵二首 其一","author":"杨巍","text":"漫说宪非病，空惭回庶几。\n家贫人卧稳，桥断客来稀。\n秋草恣侵径，寒云伴掩扉。\n明朝野水落，依旧钓渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33329,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答吕二山人雨中问病韵二首 其二","author":"杨巍","text":"已向山中老，宁论世上功。\n尔诗久作祟，吾道岂云穷。\n百亩桑麻雨，一溪杨柳风。\n生涯亦自好，端不坐书空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33330,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"立秋后一日董刘二君过访","author":"杨巍","text":"杖藜偶尔出，忽见两高轩。\n不意索居处，得闻长者言。\n是时流大火，傍树倒清尊。\n落日遽相别，依然又掩门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33331,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邀诸学博赏菊","author":"杨巍","text":"佳菊偏宜晚，入冬始落英。\n寒增茅屋色，雅称野人情。\n霜露清三径，壶觞尽一生。\n广文能好我，骑马过柴荆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33332,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊居效乐天","author":"杨巍","text":"老去无馀事，徜徉草野间。\n高芦移当竹，乱石叠为山。\n客到即呼酒，僧来同闭关。\n不因逢盛世，那遂此清閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33333,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送邓广文之任崇阳令","author":"杨巍","text":"文旆忽南去，老怀奈别何。\n仙凫攀未得，荒墅更谁过。\n客路九江远，楚城三户多。\n一言堪赠否，佳政在弦歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33334,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送孙司训之任良乡学谕","author":"杨巍","text":"几载借荒城，为师独有名。\n那堪驱瘦马，犹自恋诸生。\n月上芦沟白，风传黍谷清。\n莫言官尚冷，已得近神京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33335,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨夜有感","author":"杨巍","text":"白昼又黄昏，更深未掩门。\n人垂灯下泪，鬼哭雨中魂。\n双鬓愁将老，一经还自温。\n寥寥长夜里，心事与谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33336,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄董佥宪閒居二首 其一","author":"杨巍","text":"闻君已解任，投老向青齐。\n结屋长山北，买田渤海西。\n花应栽满径，药想种成畦。\n处处堪行乐，春来酒自携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33337,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄董佥宪閒居二首 其二","author":"杨巍","text":"济世须安石，东山岂合归。\n尚存韬略箧，新作芰荷衣。\n紫塞名仍远，苍生志不违。\n长春高卧夜，犹梦羽书飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33338,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]