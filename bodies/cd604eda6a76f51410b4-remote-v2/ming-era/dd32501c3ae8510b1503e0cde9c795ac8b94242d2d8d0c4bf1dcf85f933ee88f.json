[{"title":"东关寺牡丹","author":"杨巍","text":"洛阳春色艳难胜，金谷于今半葛藤。\n争似一株山寺里，夜深犹映佛前灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33605,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠金相士口号","author":"杨巍","text":"看君碧眼是仙才，谁遣江湖万里来。\n自笑已成丘壑相，莫言麟阁与云台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33606,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆旧","author":"杨巍","text":"野色苍茫堤口路，故人前日从兹去。\n天边消息几时来，系马愁看杨柳树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33607,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"听黄鹂","author":"杨巍","text":"春城何处啭黄鹂，才听忽飞别树枝。\n因忆故园最深处，一尊相伴日西时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33608,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄讯纪山","author":"杨巍","text":"山连巫峡云为馆，花映楼台玉作人。\n把酒听歌明月夜，还闻世上有风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33609,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆东霞鍊师二首 其一","author":"杨巍","text":"知君名在七真中，我亦曾经访绛宫。\n不信昆崙丹洞里，向来烧鍊火犹红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33610,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆东霞鍊师二首 其二","author":"杨巍","text":"前日桃花路口分，自言采秀入閒云。\n海天漠漠正东望，一鹤飞来疑是君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33611,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陶生还会稽二绝句 其一","author":"杨巍","text":"问君那忍别吾庐，为忆兰亭有旧居。\n尘世变迁难自料，茂林脩竹近何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33612,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陶生还会稽二绝句 其二","author":"杨巍","text":"九河风色不胜秋，多病怜君上去舟。\n明岁春时还念我，桃花深处半间楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33613,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨小竹兵备昌平","author":"杨巍","text":"谢傅从容谈奕日，终军慷慨请缨年。\n风云阵列沙河上，虎豹旗翻帝寝边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33614,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暮秋醉过阳信诸君子别墅各留绝句以代面谈 其一 后溪","author":"杨巍","text":"黄叶青苔遍四邻，即看秋色亦胜春。\n此中曾见客来否，明日裁书问主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33615,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暮秋醉过阳信诸君子别墅各留绝句以代面谈 其二 东沙","author":"杨巍","text":"踪迹三江定五湖，当门空见有丹炉。\n满林落日杯还把，应笑高阳旧酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33616,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暮秋醉过阳信诸君子别墅各留绝句以代面谈 其三 信溪","author":"杨巍","text":"门前高柳几株斜，秋意萧条到菊花。\n老兴不知过重九，衔杯犹问是陶家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33617,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暮秋醉过阳信诸君子别墅各留绝句以代面谈 其四 北山","author":"杨巍","text":"辟疆亭馆傍城阿，明月秋深带薜萝。\n见说时人多载酒，却令狂客梦中过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33618,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过旧游","author":"杨巍","text":"十年前向此中游，尊酒传呼夜未休。\n何事春风不相待，垂杨摇落水边楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33619,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五岳各赋一绝","author":"杨巍","text":"玄岳去天尺五遥，阴崖长夏雪难消。\n聚仙亭上谁能住，万壑松风起夜涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33620,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七十二君封禅处桃花谷口几残碑独传李白诗魂在海日长看夜半时 其一","author":"杨巍","text":"衡岳南来江汉分，赤霞深护祝融君。\n芙蓉石上几时到，一夜心飞七泽云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33621,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七十二君封禅处桃花谷口几残碑独传李白诗魂在海日长看夜半时 其二","author":"杨巍","text":"太华岧峣第一峰，陈抟仙后有遗踪。\n何年去访高眼处，万里青天跨白龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33622,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七十二君封禅处桃花谷口几残碑独传李白诗魂在海日长看夜半时 其三","author":"杨巍","text":"少室峰头迹未陈，骑羊仙者是吾身。\n自从玉女窗前别，落魄尘寰五十春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33623,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪夜宿避风尘处梦夫人陈氏意极悲酸檃括其语为二绝句时万历乙未仲冬十六日也 其一","author":"杨巍","text":"风响寒林夜雪深，此来见我九泉心。\n别君更有千行泪，明日看时血满襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33624,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪夜宿避风尘处梦夫人陈氏意极悲酸檃括其语为二绝句时万历乙未仲冬十六日也 其二","author":"杨巍","text":"自别毗陵隔死生，白头未遂岂忘情。\n当年四鼓读书夜，记得南邻碾子声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33625,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游王母宫四首 其一","author":"杨巍","text":"周朝八骏去不返，此地犹传王母宫。\n昔日瑶池作泾水，仙人元在有无中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33626,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游王母宫四首 其二","author":"杨巍","text":"草色泉声向晚多，故宫犹嵌碧山阿。\n门前飒飒松风起，似听当年黄竹歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33627,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游王母宫四首 其三","author":"杨巍","text":"青鸟已无白鸟来，汉皇空筑集灵台。\n祗因王母曾临处，一树山桃对客开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33628,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游王母宫四首 其四","author":"杨巍","text":"曼倩空为洞冥记，四山半属野人家。\n长生自古谁能得，惟有苍松管岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33629,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为任柏溪题画二首 其一","author":"杨巍","text":"箕踞科头烟雾间，百年生计是青山。\n陶诗和罢无人见，落日苍松一鹤还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33630,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为任柏溪题画二首 其二","author":"杨巍","text":"万壑萦回一草亭，溪云漠漠山青青。\n主人何处寻芝术，留得松声与客听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33631,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠诸豪寺中观水二绝句 其一","author":"杨巍","text":"矮矮山门向渚开，小桥断岸傍经台。\n此中谁动观濠兴，遥想慈航送酒来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33632,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠诸豪寺中观水二绝句 其二","author":"杨巍","text":"野水僧家并作秋，把杯此地亦奇游。\n狂歌恐有蛟龙起，一夜惊涛溅佛楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33633,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和吕二山人病酒口号","author":"杨巍","text":"好奇空自笑扬雄，海上俄来吕甬东。\n卧病吟诗头共白，闭门三日雨声中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33634,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太原寒食和纪山韵二首 其一","author":"杨巍","text":"寒食客中只醉眠，不知何处杏花天。\n雁门此日犹烽火，却向绵山独禁烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33635,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太原寒食和纪山韵二首 其二","author":"杨巍","text":"山城亦自有游人，柳色千条汾水滨。\n见说汉宫新赐火，况闻楚客唱阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33636,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"静海逢炒米店旧主人甲辰下第曾饭其家","author":"杨巍","text":"萧条野店大河滨，三十年前旧主人。\n今日相逢无限意，一裘犹记苦风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33637,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"扬州","author":"杨巍","text":"吴山楚水古扬州，人竞繁华客独愁。\n二十四桥桥上望，堤边杨柳寺边楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33638,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"尧陵","author":"杨巍","text":"寒云漠漠树苍苍，晋国山河几夕阳。\n独有荒陵平水上，行人犹解拜陶唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33639,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"衰年苦寒暑赖此二物相陪戏各为一绝聊以遣怀非叹老也 其一 汤婆子","author":"杨巍","text":"衰年冬月更愁人，不怨天寒怨此身。\n惟尔与予堪共老，脚头布被暖如春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33640,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"衰年苦寒暑赖此二物相陪戏各为一绝聊以遣怀非叹老也 其二 竹夫人","author":"杨巍","text":"衰年炎暑体如焚，幸有此君为细君。\n纨扇无人挥亦得，一床一簟卧南薰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33641,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"井陉道中苦暑 其一","author":"杨巍","text":"道上行人渴欲死，病夫其柰此炎蒸。\n相如不得金茎露，杜甫空思玉井冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33642,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"井陉道中苦暑 其二","author":"杨巍","text":"炎天又出玉门关，路狭浑如在火间。\n忽忆沧江长散发，柳边石上弄潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33643,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题王宪长龙池图","author":"杨巍","text":"君家素业傍河汾，闭户谈经世所闻。\n不信终当作霖雨，请看池上夜生云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33644,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆老母用松溪韵 其一","author":"杨巍","text":"乡书两月不曾闻，谁阻天边鸿雁群。\n游子那堪遥极目，关门高接太行云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33645,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆老母用松溪韵 其二","author":"杨巍","text":"高堂白发似丝长，三伏谁生枕簟凉。\n苦恋微官不归去，百年心事愧黄香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33646,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阅武二首 其一","author":"杨巍","text":"半是汉兵半酒徒，五陵豪气莫嫌粗。\n眼前上马誇轻捷，腰下斜悬金仆姑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33647,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阅武二首 其二","author":"杨巍","text":"十八男儿六郡雄，一身能挽双雕弓。\n银牌射得不将去，醉卧妖姬酒肆中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33648,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"焚龙涎香","author":"杨巍","text":"夜静香烟入杳冥，草堂犹似带龙腥。\n不知何处鸣孤鹤，飞下窗前听道经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33649,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"介子推祠","author":"杨巍","text":"龙蛇寂寞一祠存，浊世谁知处士尊。\n漫向绵山空堕泪，火能烧骨不烧魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33650,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过野寺忆范沾南宪长","author":"杨巍","text":"山边小寺匝烟萝，秋日曾同范史过。\n记得一樽相对处，豆花门外雨声多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33651,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过清虚观忆王佥宪","author":"杨巍","text":"山头碧殿倚天开，去岁曾同仙客来。\n今日独过诗兴少，白云空绕牡丹台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33652,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梁中丞卷四首 其一 吉士","author":"杨巍","text":"宣献平时书已校，不须中秘更燃藜。\n都门处处春偏好，携酒看花费马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33653,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梁中丞卷四首 其二 给事","author":"杨巍","text":"漏转铜龙夜未残，即持白简立朝端。\n宰臣不喜忠良士，始信言官自古难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33654,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梁中丞卷四首 其三 阅边","author":"杨巍","text":"榆关西去接轮台，万里烟尘画不开。\n无限边情空浪说，惟君亲到玉门来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33655,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梁中丞卷四首 其四 参政","author":"杨巍","text":"三辅贤声未有涯，春风曾及万人家。\n至今父老思恩泽，犹护甘棠一树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33656,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送文冈诗予有青琐几年还入梦苍生此日转多情之句受庵周公许不吃力戏作绝句","author":"杨巍","text":"闭户吟诗十几年，浑无一句向人传。\n如何四海周公瑾，独取骊歌第二联。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33657,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽张状元元忭","author":"杨巍","text":"勋名端不负高科，白玉楼成柰命何。\n惟有良知心尚在，姚江深处月明多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33658,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"张大参前溪游五台山寄此二绝句 其一","author":"杨巍","text":"峨口村南烟嶂开，人无同类与谁来。\n不知万木千山里，上到文殊第几台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33659,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"张大参前溪游五台山寄此二绝句 其二","author":"杨巍","text":"灵山到处是花宫，秋日登临忆上公。\n碧涧水喧箫管处，寒岩松落酒杯中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33660,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同罗近溪先生夜坐","author":"杨巍","text":"南州高士神仙侣，一夕相逢世虑无。\n坐听玄谈清不寐，泠泠霜月贮冰壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33661,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答于谷山宗伯见怀四首 其一","author":"杨巍","text":"十里烟村一短筇，山僧野叟日相从。\n疏慵合向此中老，不问蓬莱若个峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33662,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答于谷山宗伯见怀四首 其二","author":"杨巍","text":"柴门松径已新开，旧日求羊亦不来。\n双鹤至今犹恋主，早晨放去夕飞回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33663,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答于谷山宗伯见怀四首 其三","author":"杨巍","text":"南北风尘入梦惊，书生抵掌竞谈兵。\n古来豹略推黄石，却向缑山吹凤笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33664,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答于谷山宗伯见怀四首 其四","author":"杨巍","text":"莫理城南汶水船，于今诸塞起狼烟。\n已知宵旰劳明主，不记仙曹侍从年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33665,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再过观音堂赠老尼","author":"杨巍","text":"野店南来古佛堂，旧游回首几星霜。\n不知别后参何法，枯木寒岩带夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33666,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过无棣旧城","author":"杨巍","text":"曾经此地一悲歌，东望营丘西大河。\n惆怅当年曾赐履，茫茫故垒野烟多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33667,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"遣怀","author":"杨巍","text":"世上除书不到眼，天涯怀抱自开尊。\n平生只有吟诗癖，吏散鸦啼独闭门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33668,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿岔道村家","author":"杨巍","text":"乱石为墙篱作门，今宵寄宿两家村。\n圣恩已许归田去，犹自江湖绕梦魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33669,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"延生来谒因善篆画各赠一绝 其一","author":"杨巍","text":"才到边城气即粗，高巾犹似鲁中儒。\n自言曾习阳冰学，百尺狼烟篆得无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33670,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"延生来谒因善篆画各赠一绝 其二","author":"杨巍","text":"受降城在黄河畔，东去山川接大宁。\n可恨何年陷沙漠，凭君图写上明庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33671,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄平定李给事","author":"杨巍","text":"短李曾为青琐郎，诗名谏草擅时芳。\n逢人首问平安否，高卧冠山白发长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33672,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋雨宿长安岭","author":"杨巍","text":"满户烟霞傍戍台，疏灯独坐一尊开。\n夜深怪底不能睡，松柏千山风雨来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33673,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"村中逢老人二绝句 其一","author":"杨巍","text":"八十村翁独倚门，子孙逃尽一身存。\n自言耕凿无筋力，朝夕充肠是草根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33674,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"村中逢老人二绝句 其二","author":"杨巍","text":"老人何事欲沾巾，不怨官家赋役频。\n手指门前桑枣地，已荒三十四回春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33675,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"平定李侍御应时予之同年友也曾视予病感之寄此","author":"杨巍","text":"前年视我山中病，落日独骑骢马来。\n记得任家亭子上，连翘花发共衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33676,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过环绿窝","author":"杨巍","text":"诗魂何处草萋萋，环绿窝中路已迷。\n黄鸟不知春寂寞，夕阳犹绕树头啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33677,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日对酒","author":"杨巍","text":"春来有酒即成醺，记得曾书白练裙。\n今日花开君不见，一杯谁去泻孤坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33678,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过王戍店","author":"杨巍","text":"野店春残不见花，高林落日乱鸣鸦。\n同游词客已黄土，泪尽当时卖酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33679,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"读骝山集","author":"杨巍","text":"楞严寺里论文夜，马谷山前看猎时。\n壮志已随流水去，遗编读罢不胜思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33680,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乙未除夕 其一","author":"杨巍","text":"自嗟七十九年身，滚滚流光又及春。\n莫怪更深不肯睡，天明便是八旬人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":33681,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]