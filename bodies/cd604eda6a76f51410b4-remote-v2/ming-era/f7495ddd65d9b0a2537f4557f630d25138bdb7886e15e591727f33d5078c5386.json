[{"title":"竹","author":"解缙","text":"春雨蛟龙变，不妨苔藓侵。\n苍苍孤直者，空洞本无心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河边绿柳 其一","author":"解缙","text":"御柳青青近绿池，迎春濯秀不违时。\n皇恩天地同生育，雨露无私亦共知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河边绿柳 其二","author":"解缙","text":"漫漫春风入舜韶，绿杨舒叶乱莺调。\n君王不肯娱声色，何用辛勤学舞腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"退朝即事 其一","author":"解缙","text":"圣主恭勤日万几，每因朝退问前疑。\n挥毫亲写蝇头字，常见宫官报酉时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"退朝即事 其三","author":"解缙","text":"㭨子南来百粤中，黄藤纯束赤筠笼。\n恩颁内阁分携去，犹有大官黄纸封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"退朝即事 其四","author":"解缙","text":"大将平胡兀亮阿，旌旗云拥照山河。\n明朝借我双雄凤，直上青天听凯歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"退朝即事 其五","author":"解缙","text":"北京官酒甜于蜜，高品传宣侑膳珍。\n圣主御筵犹未饮，便令分赐及儒臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄胡郭二驸马并柬王左军","author":"解缙","text":"年年荣近六龙车，共拂红云被日华。\n一自山中杜门后，几回清梦到天家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白鸡冠花","author":"解缙","text":"鸡冠浑是胭脂染，今日如何浅淡妆。\n只为五更贪报晓，至今犹带满头霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜雨泊江西","author":"解缙","text":"扁舟日泛水云乡，夜雨秋风宿豫章。\n预恐寒惊慈母线，起来先看旧衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东刘日升","author":"解缙","text":"见说文园多病后，又携书册卧乡山。\n新秋诏许归来早，药裹诗签任往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"安庆江上守风","author":"解缙","text":"莫叹风波行路难，舟船指日是长干。\n东山不为功名出，天下苍生望谢安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登镇江报恩寺超然楼","author":"解缙","text":"帝城天近瓮城高，梵宇嵌岩结构牢。\n试向超然楼上望，大江东去涨银涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西行","author":"解缙","text":"八千里外客河湟，鸟鼠山头望故乡。\n欲问别来多少恨，黄河东去与天长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贬河州述怀 其一","author":"解缙","text":"梦里心惊长乐钟，几回趋侍语从容。\n十年去国伤心泪，洒向天河载六龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贬河州述怀 其二","author":"解缙","text":"一身去国片云轻，白苧衣单万里程。\n九十严亲离别苦，夕阳挥泪倚门情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贬河州述怀 其三","author":"解缙","text":"堂上白头亲九十，西行万里赴轮台。\n人间此是生离别，何日金鸡遇赦回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贬河州述怀 其四","author":"解缙","text":"万里羁孤祇忆归，将心日日到庭闱。\n封书寄与南回雁，此去无劳更北飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":58572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登镇边楼","author":"解缙","text":"陇树晴云万里秋，思亲独上镇边楼。\n几年不见南来雁，真个河州天尽头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":