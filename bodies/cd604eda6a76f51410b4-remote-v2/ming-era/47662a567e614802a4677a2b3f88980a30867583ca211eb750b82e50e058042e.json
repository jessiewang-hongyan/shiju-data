[{"title":"题黄公东庄草堂","author":"李梦阳","text":"草色通门柳覆墙，绕堂新雨足时芳。\n晴郊客过沾犹湿，春昼人间觉更长。\n拚引满杯听鸟哢，愿留馀酝待花香。\n休誇水际兼山际，且醉松傍与竹傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55795,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"少林寺","author":"李梦阳","text":"林深谷暝客子入，钟鸣叶落秋山空。\n烟云细袅石涧底，峦岫乱积松窗中。\n唐碑汉碣藓字剥，虎啼猿啸萝灯红。\n独坐悠悠息尘想，少室影下月出东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55796,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望少林次韵","author":"李梦阳","text":"三十六峰云气通，何峰寺西何者东。\n林岩霜横远亦静，烟岚日破重还空。\n千山尽历暮转碧，一树不落秋能红。\n渐闻钟声出杳霭，得路谁怜马仆功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55797,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿少林次韵","author":"李梦阳","text":"万山微暝一钟鸣，古寺深秋倦客情。\n僧本折芦翻面壁，人非骑鹤故吹笙。\n寒催乱木风交响，白动虚严月自生。\n惭愧劳劳不成寐，丁丁卧听早樵声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55798,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暑日过雪台子园庄","author":"李梦阳","text":"蝉声树色村村似，一坐君亭日每斜。\n静里柴门惟燕雀，老来樽酒是桑麻。\n年丰邻里家家麦，时至园林处处花。\n苦热只今忧赤土，几时龙起沛天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55799,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寺前秋泛限韵","author":"李梦阳","text":"返照孤城落木中，尽船秋水坐来空。\n影涵楼阁人齐过，香引蒹葭路转通。\n云气袭樽温复冷，笛声将柂北还东。\n不须预问天边月，波上馀霞闪闪红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55800,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立夏后晴游我庄","author":"李梦阳","text":"郊出不知昨夜雨，日高烟翠湿空林。\n杨花欲尽村村雪，梅子先传树树金。\n笑向市城开俗眼，喜从园野见吾心。\n绕亭溪啻千千竹，夏日黄鹂更好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55801,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐将军园亭","author":"李梦阳","text":"将军别墅今停马，五月塘池莲半红。\n举眼江山惟赤日，快人楼阁自凉风。\n穿林竹翠沾衣满，布席葵香扑酒空。\n平世主人虚抱武，醉来誇挽六钧弓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55802,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清明下粮厅题杏花","author":"李梦阳","text":"清明箸处花争发，一树庭前尔独迟。\n不为炎天能结实，岂应官署许生枝。\n桃蹊李径虽多宠，扑酒飞帘自一时。\n巳办青钱贪酩酊，合教红蕾赴深期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55803,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柑至","author":"李梦阳","text":"丹橘黄柑世所珍，年年随贡走风尘。\n内廷赐出人人羡，近市收来颗颗匀。\n翻讶久藏香不逸，迥疑初摘蒂犹新。\n金盘玉箸真谁事，寂寞文园自病身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55804,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菊","author":"李梦阳","text":"世上虚名白发悲，霜前幽壑迥春姿。\n闲巡独树真怜汝，醉折寒花欲赠谁。\n官舍野堂浑一色，冷风凄露漫相欺。\n高年渐觉馨香远，万里徒伤酒一卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55805,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"牡丹盛开群友来看","author":"李梦阳","text":"吾家何处牡丹园，杨子冈西古宋原。\n忽有芳菲妍岸阁，岂期车马驻江村。\n怜香实怕青萝掩，在野虚愁蔓草繁。\n碧草春风筵席罢，何人道有国花存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55806,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬至菊","author":"李梦阳","text":"至日贪看九日花，弄霜吞雪转宜誇。\n思将正色留天地，肯使阴阳管岁华。\n寒蒂巳包重放萼，暖根应抱更生芽。\n书云莫误祯祥奏，斗酒东篱自有家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55807,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"王左史宅赏冬菊","author":"李梦阳","text":"菊筵元向春前约，共忆霜黄薄牡丹。\n冬日此逢香欲暖，夜堂偏醉色终寒。\n闲居四海嗟吾赏，晚岁三杯称尔官。\n疏影独枝看转剧，好添华烛近高阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55808,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙亥春郊圃牡丹盛开聿予离兹倏尔四载实兄莳艺成功约客往赏属雨发咏焉","author":"李梦阳","text":"牡丹元种无多本，别久丛分郁映杯。\n秾剧秪宜鸰鸟戏，品增疑傍棣花开。\n支离野圃群葩掩，杳袅春庭细雨来。\n高会主宾忻并健，冲泥车马莫空回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55809,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"人有送牡丹花至者与客同赋","author":"李梦阳","text":"大梁城郭万人家，太半朱门竞此花。\n不为国姿宁用折，玩传宾手转须嗟。\n双牵戏蝶临书牖，独惹游丝扑钓槎。\n我亦有园新植此，往来无倦出城车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55810,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"牡丹赏归柬边王二子","author":"李梦阳","text":"非因绝代专芳品，岂复郊园守后时。\n夜静两姿应更剧，野寒风蕊莫频吹。\n空斋独忆香仍满，晴日重寻路不迟。\n肯拟飞觞留徒笔，愿扳骢马护高枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55811,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"霖淫想郊园牡丹","author":"李梦阳","text":"园途雨泞花遥阻，倚杖流云洒北郊。\n纵使彩烟遍国本，岂逾清露足春梢。\n卷心暗蕊须时苦，绿湿红沾任俗抛。\n传道魏绯累满眼，傍株今可结游庖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55812,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊园饯御史许君属牡丹盛开","author":"李梦阳","text":"旷圃风郊尔独开，国香仙色敢辞猜。\n若先桃李名应减，纵隔城池客自来。\n秾压野栏张燕待，饯临官路挽骢陪。\n万须千萼非容易，忍遣台霜近酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55813,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"看牡丹晚移席草堂再赠许君","author":"李梦阳","text":"晚坐移花酒并移，几镫窗月转春姿。\n情真解缆争侵夜，意不怜香岂尽卮。\n汹汹野风諠树恼，冥冥波浪去途疑。\n亦知仙种贪行豸，醉听邻鸡是别期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55814,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"王左史宅赏牡丹","author":"李梦阳","text":"槐庭弦管称春筵，草圃繁华近暮天。\n老为名花扳自放，醉逢国色转须怜。\n娟娟影静金尊里，冉冉香回玉笛前。\n莫问平章旧时宅，沉香亭巳入荒烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55815,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊园牡丹复花容往","author":"李梦阳","text":"问主寻芳客故来，百花开尽此花开。\n凄凉野径堪车马，烂熳天香只草莱。\n穿叶自由蜂逐逐，坐枝频起燕回回。\n杨花暮合风沙迥，绕树猫倾醉后杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55816,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日盆荷阶葵芬敷率尔成句","author":"李梦阳","text":"候及名丛每自芳，物华渍暑倍年光。\n出波翠盖枝枝静，入院丹心朵朵香。\n向日岂期回俗眼，折筒聊得洗诗肠。\n不应种近榴花夺，绕槛巡池泪数行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55817,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山行见梅","author":"李梦阳","text":"长至山行梅不迟，攀条触雨益垂垂。\n云暗野桥直独见，岁寒蜂蝶敢相欺。\n时心巳抱调?实，久色难销傲雪姿。\n愁在不缘乡国乱，白头心事本同期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55818,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谷园二月梅集","author":"李梦阳","text":"江南海花苦繁剧，江北有梅花不肥。\n春枝巳矜雪后媚，玉蕊即妨风处稀。\n金尊绮席不时赏，快马轻车堪夜归。\n遥忆暗香月色动，莫令遽掩东园扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55819,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅下限韵作","author":"李梦阳","text":"闻说仙芳每避凡，托根长傍竹松岩。\n那期野圃深随酒，可柰风花细扑衫。\n斜日席移春欲透，步丛香起雪犹衔。\n岁寒朋旧今何处，徙倚裁书手自缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55820,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赏归忆谷园梅","author":"李梦阳","text":"临梅真惜先开蕊，后蕊吾归应更繁。\n藉草无愁细细落，有蜂只恐垂垂翻。\n折曾烂熳春携袖，醉记扶疏月坐园。\n巳觉时心向桃李，肯缘孤洁重回轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55821,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏蝉","author":"李梦阳","text":"秋来雨多凉气深，寂寞寒蝉愁暮阴。\n幸值开晴方听汝，不缘清切转关心。\n故逾丛棘沾沾入，却倚高槐细细吟。\n曹赋仅能推感激，骆诗徒亦拟同音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55822,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和清明后见燕","author":"李梦阳","text":"坐栋穿帘尔亦惊，纷纷红紫遍春城。\n群冲海雾寒应阻，对语堂花暖却明。\n去住溪山他日梦，主宾天地世人情。\n即论迟暮心难巳，切恐差池恨转生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55823,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日睹白云生率尔遣兴","author":"李梦阳","text":"天际游云白袅袅，渭阳羁客泪纵横。\n抟风弄雨有谁见，木落秋高堪自行。\n变幻楼台番有态，突然龙豹转须惊。\n老夫趁此欲登望，怪尔轻遮翡翠城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55824,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和李大隔墙见予家海棠次其韵","author":"李梦阳","text":"种汝深愁深不长，数年今遽出吾墙。\n临衢幸不矜全色，隔院应难掩暗香。\n敢向纷纷争俗眼，私怜袅袅压时妆。\n胭脂强半喧蜂少，倘过同倾花下觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55825,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同双溪方伯咏石几","author":"李梦阳","text":"栗栗天生白石几，癯癯日伴白头翁。\n清尊淹留不断客，灌木阴森常自风。\n看处遽浮金玉色，移来深仗鬼神功。\n兹须小物君堪醉，取致嵩山万翠中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55826,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石几再赋","author":"李梦阳","text":"确然片石我之几，置之堂边楼在东。\n葱芊海棠上重绿，绚烂盆榴旁小红。\n性含烟霞不减色，光敌玉金常吐虹。\n老夫有时醉凭汝，扣之高歌天暮风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55827,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏陶台使兰阳公廨五色葵花","author":"李梦阳","text":"炎天小县葵花好，五色空庭日日香。\n开正得时先让赤，见宜尊礼莫欺黄。\n交枝接叶谁为众，异蕊同心自向阳。\n此物烦君献天子，上林閒地草苍茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55828,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏瓶中柏限韵","author":"李梦阳","text":"爱汝侧叶寒能青，插之铜瓶依石屏。\n昼屯云气果不俗，夜飞光芒疑有灵。\n森耸似学鸾凤翼，屈曲巳具虬龙形。\n更欲移裁万仞岭，待与松桂凌冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55829,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹃崔后渠咏箓竹亭","author":"李梦阳","text":"崔家孤亭万竹里，绕窗栗栗青琅玕。\n结实当春凤不馁，托根有地龙且蟠。\n霜风飘萧起空谷，美人翠袖生暮寒。\n彼淇盈盈一水隔，望而不见徒自叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55830,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊斋逢人日有怀边何二子","author":"李梦阳","text":"今日今年风日动，苑边新柳弱垂垂。\n斋居寂寞难乘兴，独立苍茫有所思。\n谷暖迁莺番太甲，云长旅雁故多迟。\n凤池仙客容台彦，两处伤春尔为谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55831,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日过序公","author":"李梦阳","text":"炎天楼殿荫空扉，永昼云林孤鸟飞。\n病起出门风色异，独来清坐老僧依。\n扑帘花片疑红雪，解带藤萝映紫衣。\n万事回头谁得问，但逢心赏莫教违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55832,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过马陟次毛庶子韵","author":"李梦阳","text":"冉冉轻雷止复行，凤池清夏半阴晴。\n渐看西日笼花气，谁放南风作雨声。\n融入堑沙将拂燕，密侵宫柳益沾莺。\n晚来一赴薇郎约，匹马冲泥远兴生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55833,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"章氏芳园饯朱应登","author":"李梦阳","text":"细雨林塘花可怜，况有美酒斗十千。\n见日玄蝉元嘒嘒，含风绿筱自娟娟。\n朝廷岂料更新主，尘世难逢感昔年。\n纵倒芳尊不成醉，别怀忧绪两凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55834,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访何职方新居二首 其一","author":"李梦阳","text":"昨年闻汝在郴州，对酒时常使我忧。\n无客解题鹦鹉赋，同谁出入凤凰楼。\n潇湘梦泽今虚远，易水燕山不断游。\n旧雨休嗟车马伴，卜邻先近李膺舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55835,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访何职方新居二首 其二","author":"李梦阳","text":"街北小堂卜筑深，离离竹槛称幽吟。\n不争鹅鸭嫌邻舍，旋置琴尊见客心。\n呼两乳鸠仍暂止，定巢新燕故相寻。\n曾轩更许消清暑，露顶同依嘉树林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55836,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送殷进士病免归","author":"李梦阳","text":"鲁川西流石齿齿，川上茅堂千树林。\n春行不费风雩咏，日暮聊为梁父吟。\n南瞻岱岳云峰峻，东访沧溟烟雾深。\n司马岂缘封禅病，任公终有羡鳌心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55837,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别徐子祯卿得江字","author":"李梦阳","text":"我爱南州徐孺子，明圭美璧世无双。\n新从北极看南极，便自吴江下楚江。\n日落鹧鸪啼庙口，水清斑竹映船窗。\n檷衡王粲俱黄土，千载何人复北邦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55838,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追旧寄徐子","author":"李梦阳","text":"忆昔逢君雪满途，遥怜为客向江湖。\n看碑定忆羊开府，作赋先投楚大夫。\n日黑鱼龙豗梦泽，草青麋鹿上姑苏。\n空回玉轸思流水，不得骅骝见过都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55839,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过李氏荷亭会何子","author":"李梦阳","text":"三伏寻花到习池，幽怀真与故人期。\n出波菡萏晴相并，度槛流萤晚故迟。\n他日宴游能此地，向来开落果由谁。\n亦知尘世难逢醉，且把芳筒当酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55840,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬储太仆见赠","author":"李梦阳","text":"抱病逢春无那春，雪晴云气相鲜新。\n经旬不出恼官长，束带何由朝大宾。\n岂谓烟霄无劲翮，欲从江海访遗珍。\n商歌日暮悲风起，索处应惭扣角人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55841,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"荅太仆储公见赠","author":"李梦阳","text":"淮海先生海鹤姿，年来何事鬓成丝。\n安危异日须公等，文雅于今是我师。\n纵有孙阳难遇马，谁言安石但能棋。\n桂枝偃蹇空山里，旅病逢春故国思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55842,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病间闻何舍人梦故山有感","author":"李梦阳","text":"我逢新岁兼新病，君梦故园登故山。\n木杪啼猿行问讯，枕边流水莫潺湲。\n罙春古甫同谁往，绝壁孤云只自攀。\n怅恨无家傍林谷，定应何处小乡关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55843,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中忆张大夫园亭","author":"李梦阳","text":"我爱张家好亭子，满园林竹夏凄凄。\n沾花细雨飘窗里，映日轻雷过槛西。\n巳拚习池多乐事，况逢光禄有新题。\n朝回会与金兰约，走马携壶到碧蹊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55844,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"解官亲友携酒来看","author":"李梦阳","text":"严城击鼓天欲曙，风起平林纤月长。\n故人开尊且复饮，客子狂歌殊未央。\n卧病一春违报主，啼莺千里伴还乡。\n他时若访渔樵地，洛水秦山各淼茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55845,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王照磨省觐","author":"李梦阳","text":"浮沙皛皛楚王台，苦竹泠泠帝子哀。\n腊月江行莺语合，早春湘北杏花开。\n贪趋綵服聊轻舫，苦忆金门罢举杯。\n入幕郤超难许并，题桥司马直须回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55846,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄徐子","author":"李梦阳","text":"徐子南游涉洞庭，楚江风浪眼冥冥。\n朅来振玉朝天子，忽漫传书与客星。\n访戴难移剡溪棹，问奇曾过子云亭。\n烟沙水国催春发，杨柳愁边却尽青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55847,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄徐编修缙","author":"李梦阳","text":"题诗传语玉堂宾，想像鸣鞭散紫宸。\n玩弄门前金騕袅，宛如天上石麒麟。\n徒誇中论流人世，实有新诗泣鬼神。\n密勿愿先谐大轴，渔樵久巳属闲身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55848,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日寄何舍人仲默","author":"李梦阳","text":"九日无朋花自开，登楼独酌当登台。\n孤城落木天边下，万里浮云江上来。\n但遣清尊常不负，从教白发暗相催。\n梁南楚北无消息，塞雁风高首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55849,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬霁宴丘翁林亭","author":"李梦阳","text":"竹亭高宴雪霜残，柏坞移尊月色宽。\n驯鹤自知迎客舞，绝琴今拟向君弹。\n醉来箕踞仍呼酒，老去留宾不著冠。\n解道冥鸿能万里，肯输乌鹊一枝安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55850,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立春遇雪东孙君二首 其一","author":"李梦阳","text":"乾坤莽莽俱为客，世路悠悠各怆神。\n海内弟兄稀见面，天涯霜雪又逢春。\n驯阶鸟啄犹呼侣，破浪龙吟不避人。\n几欲开尊向梅柳，白眉青眼为谁颦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55851,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立春遇雪东孙君二首 其二","author":"李梦阳","text":"留滞周南春复春，路迷何处问三秦。\n竟非吾土堪垂泪，不为儒冠岂误身。\n偷腊槛梅暄媚眼，美寒山筱晚伤神。\n虚传夜雪能乘兴，不见山阴鼓柁人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55852,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张训导弃官为母","author":"李梦阳","text":"蜀道干戈暮角悲，水行溪壑转春姿。\n辞刘徐庶心先苦，回驭王阳愿不迟。\n正月巴山犹碧树，孤舟峡口巳黄鹂。\n并吞割据千年事，愁见岷峨有战旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55853,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早春酬内弟玑","author":"李梦阳","text":"骑马冲泥到竹扉，孤城雪日美晖晖。\n将飞鸿雁春相聚，得食鱼虾暖自肥。\n贾谊上书番远谪，桓荣稽古巳多违。\n亦知匡济诸君事，勿羡东皋早拂衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55854,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早春郊园赠别","author":"李梦阳","text":"野阴苍苍春不分，春堂黯黯惜离群。\n柳条欲折不应手，林花即开谁寄君。\n雁飞帆樯畏触雪，日蒸山泽恣成云。\n杳然携别东园晚，绮席玉杯相对曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55855,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"生日答李濂秀才","author":"李梦阳","text":"腊前此日梅花剧，盏送初筵竹叶新。\n千里共为青眼客，百年余是白头人。\n清霜丽蕊情休妒，醉舞狂歌意总真。\n忽忆退朝传粥食，迟回吟望一沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55856,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过内弟宅感咏","author":"李梦阳","text":"天汉桥东水竹居，明公卜筑迥幽虚。\n军城日月梁园里，戚里山河宋殿馀。\n诸弟冬林借雪笋，重闱日馔跃江鱼。\n水清牢落千秋事，手泽空嗟万卷书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55857,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]