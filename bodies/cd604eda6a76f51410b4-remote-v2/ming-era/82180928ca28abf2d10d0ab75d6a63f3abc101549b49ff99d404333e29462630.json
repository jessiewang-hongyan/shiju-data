[{"title":"游华山诗十二首 其四","author":"邓云霄","text":"九天飞瀑落岩扃，触石敲云鸟亦惊。\n白昼雷霆喧暗壑，晴天风雨起寒声。\n奔来溅沫侵衣湿，转入澄潭照胆明。\n漫道出山泉水浊，渭滨东去共流清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游华山诗十二首 其五","author":"邓云霄","text":"山中仙酒足留连，更遣茅龙唤子先。\n兴到拍浮斟玉井，醉来身世在金天。\n水帘风动摇环佩，灵籁山空胜管弦。\n戏与叔卿相对博，西岩赢得种芝田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游华山诗十二首 其六","author":"邓云霄","text":"度栈休歌蜀道难，扪萝胁息凛相看。\n乘危一盼头堪白，引满三杯胆尚寒。\n擦耳崖前缘绝壁，回心石上俯惊湍。\n金丹换骨风堪御，愿向飞仙借羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游华山诗十二首 其七","author":"邓云霄","text":"崚嶒十步已三休，错认山腰是上头。\n客子魂惊啼越鸟，仆夫力尽喘吴牛。\n莺花已报青春晚，霜月先传白帝秋。\n谁见黄河小如带，微茫一气罩神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游华山诗十二首 其八","author":"邓云霄","text":"双华中分诧巨灵，丹青面面削银屏。\n阴崖雪积岚光冷，古峡龙藏雾气腥。\n百二关河分地轴，三千世界拱天庭。\n谁能话尽开山事，欲访希夷尚未醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游华山诗十二首 其九","author":"邓云霄","text":"下界风沙白日昏，山中幽胜更谁论。\n参禅直踞莲花座，沐发轻翻玉女盆。\n杳杳河源迷宿海，茫茫山势暗昆仑。\n虚传箭栝通天路，咫尺无由叩帝阍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游华山诗十二首 其十","author":"邓云霄","text":"凭高坐石阅人寰，今古匆匆醉梦间。\n七国分争才半局，一丸何用闭重关。\n转轮日月圈中急，挥麈烟霞象外闲。\n可是岳灵容傲吏，谪居长得傍名山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游华山诗十二首 其十一","author":"邓云霄","text":"洞中鸡犬寂无哗，疑是秦人别有家。\n偃盖古松垂五粒，缀珠奇树吐三花。\n惊看玉井船如藕，遥忆蓬山枣似瓜。\n问讯关门仙令尹，青牛何日返流沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游华山诗十二首 其十二","author":"邓云霄","text":"感时怀古不胜情，肘后苍精夜自鸣。\n禹迹九河沉大陆，秦关千嶂护长城。\n华阳地敞堪归马，太白星高喜弄兵。\n北望浮云连朔漠，日边何处是神京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游嵩山诗十二首，并序 其一","author":"邓云霄","text":"曾思峻极咏周诗，此日经行拜古祠。\n百代封文藏玉检，三花晴色映龙墀。\n紫宫高敞金银阙，黄鹤能通祝史词。\n闻道今皇新秩祀，祈灵天语使臣知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游嵩山诗十二首，并序 其二","author":"邓云霄","text":"历险探奇无尽日，才登华岳又嵩邱。\n八方风气推中土，一统河山据上游。\n仙跸昔传青鸟下，封坛今有白云留。\n谁能尽解人间缚？\n直驾銮骖到十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游嵩山诗十二首，并序 其三","author":"邓云霄","text":"崤函叠嶂走轘辕，伊阙城皋锁壁门。\n四岳按方皆就列，中央之帝独称尊。\n浑浑土气通黄道，灿烂星躔贯紫垣。\n静听天鸡三唱后，缤纷芝盖上朝元。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游嵩山诗十二首，并序 其四","author":"邓云霄","text":"中原顾盼雾沉沙，俯视诸峰几点鸦。\n冬雪尚留封二室，春风已报到三花。\n短筇时伴松间鹿，半榻闲眠嶂里霞。\n瑶草朝来行问讯，南峰气暖渐抽芽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游嵩山诗十二首，并序 其五","author":"邓云霄","text":"君山彩翠共氤氲，独见中峰拥绛云。\n河洛分流蟠水府，图书并出焕灵文。\n登临已遍三千界，封禅曾经七十君。\n想像羽林纷扈从，今存惟有柏将军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游嵩山诗十二首，并序 其六","author":"邓云霄","text":"京洛名园翳绿芜，何如珠树满仙都。\n周遭峦嶂团城阙，朝暮云烟写画图。\n剩有声名高四岳，为传灵响效三呼。\n不知历代登封者，若个能餐九节蒲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游嵩山诗十二首，并序 其七","author":"邓云霄","text":"攀萝不避石牙冲，平步虹梁倒听钟。\n四面芙蓉迎蹑屐，九天鸾鹤引扶筇。\n秦皇汉武名空在，辇路行宫草尽封。\n闻道山灵犹望幸，彩云来往愿从龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游嵩山诗十二首，并序 其八","author":"邓云霄","text":"嵩阳官外将军树，烈烈高风舞翠虬。\n似有扬旗环细柳，如闻走马出长楸。\n摩天自是千年物，夹道曾随万乘游。\n日暮苍枝荫山鬼，啼乌遥吊汉陵秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游嵩山诗十二首，并序 其九","author":"邓云霄","text":"少林寺里松篁静，迥出高槐百尺长。\n五品承恩沾雨露，千秋阅世老风霜。\n阴浓坐对闲僧定，花发谁知举子忙。\n莫道秦宫今冷落，南柯闻有蚁为王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游嵩山诗十二首，并序 其十","author":"邓云霄","text":"达磨妙悟超因果，梵宇辉煌冠古今。\n幢影自摇金界地，松涛长泛海潮音。\n烟霞不散观空室，文字难传面壁心。\n只履西归何日返，芦洲秋老大江深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游嵩山诗十二首，并序 其十一","author":"邓云霄","text":"倦游司马苦长征，一到名山便有情。\n夜静神龙来送水，月明仙鹤惯吹笙。\n下看箕颍嫌邻俗，高揖巢由笑买名。\n好借蒲团三尺地，长依初祖證无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游嵩山诗十二首，并序 其十二","author":"邓云霄","text":"中州眺望浩无边，缥缈遐心落日悬。\n吊古平芜飞独鸟，忧时雄剑倚长天。\n降神尚忆生申日，定鼎还思卜洛年。\n肯信投簪容易事，四方多难正烽烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孙燕诒卜伯符过小斋","author":"邓云霄","text":"雀下空阶午梦馀，垂帘终日坐清虚。\n床头正熟贤人酒，户外谁停长者车？\n翠幕轻风吹散帙，银塘微雨对观鱼。\n相过休拟扬雄宅，焚草年来懒著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人出塞","author":"邓云霄","text":"抗手寒翻两袖风，平生猿臂学猿公。\n渡河暂见黄云合，绝幕谁怜白草空？\n沙碛路迷凭老马，关山书返倩南鸿。\n归来容鬓知何似，看取麒麟画像中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西园暑夜纳凉","author":"邓云霄","text":"微带清酣倚小亭，坐残华烛倩流萤。\n竹炉烟细茶初熟，杨柳风多酒渐醒。\n宿鸟惊翻千叶露，游鱼潜动一池星。\n暑深已厌耽书癖，架上惟留玉札经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏汝载入署同居适栽新竹喜而共赋","author":"邓云霄","text":"昨过野寺乘凉好，偶向山僧觅竹栽。\n槛外喜看团绿玉，阶前何惜破苍苔。\n影窥月幌清尘梦，爽入风窗进晚杯。\n正对此君堪坐啸，开门还见子奠来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新秋登大报恩寺塔","author":"邓云霄","text":"盘空百转上崔嵬，平步中天晚照开。\n迢递长安迷北望，苍茫秋气自西来。\n六朝人物随流尽，千古江山抱郭回。\n莫倚危栏伤往事，龙宫劫火亦成灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中元节恭谒孝陵","author":"邓云霄","text":"龙蟠佳气帝城东，缥缈园陵白露中。\n一统河山留铸鼎，万年松柏护遗弓。\n玉霄阊阖无人到，银海蓬莱有路通。\n翠盖霓旌空想像，峰头遥见片云红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日同潘景升吴翁晋卜伯符孙燕诒苏汝载家仲玄御登牛首山绝顶留宿僧院诘朝又游献花岩三首 其一 游牛首","author":"邓云霄","text":"拄笏看山兴杳然，到来爽气入秋鲜。\n他乡几度逢重九，上界遥临遍大千。\n天地悠悠同逆旅，江波滚滚送华年。\n征鸿已引愁心去，还见归帆落照边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日同潘景升吴翁晋卜伯符孙燕诒苏汝载家仲玄御登牛首山绝顶留宿僧院诘朝又游献花岩三首 其二 留宿","author":"邓云霄","text":"僧话淹留宿化城，迎霜钟磬晚来清。\n傍岩孤枕和云卧，落叶空山作雨声。\n听法未消三世梦，浪游谁息百年情。\n却怜浩劫如轮转，月堕西峰日又生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日同潘景升吴翁晋卜伯符孙燕诒苏汝载家仲玄御登牛首山绝顶留宿僧院诘朝又游献花岩三首 其三 游献花岩","author":"邓云霄","text":"南朝古寺挂岩阿，揽胜盘纡石磴多。\n风动佛幢时弄影，云深樵径但闻歌。\n松涛似涌千峰去，剑舄如骑独鹤过。\n试问法融归寂后，闲花幽鸟近如何？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题巨源王孙宴坐斋","author":"邓云霄","text":"吏隐江南本避名，爱君轩槛有馀清。\n叩门但见鹤双立，入座微闻磬一声。\n吹罢凤笙人未老，枕残鸿宝骨偏轻。\n天潢上接仙源近，好把芙蓉朝玉京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"屡上疏不报感赋","author":"邓云霄","text":"日暮空林鸟雀还，衙斋萧瑟似投闲。\n封章徒洒疮痍泪，阊阖谁开虎豹关？\n壮士有心思蹈海，愚公无力可移山。\n故园蕙帐悬秋月，梦里泉声落枕间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵元夕","author":"邓云霄","text":"繁华六代古今稀，灯夕烟花满帝畿。\n天净金波偏泛滥，春寒火树自芳菲。\n千群游骑冲尘过，几处行云绕曲飞。\n更听笙箫空外落，高台应有凤凰归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵谷寺看梅五首 其一","author":"邓云霄","text":"灵谷东风放早梅，寻芳词客共徘徊。\n只疑白鹤随飞锡，忽见天花满法台。\n疏影离离笼淡日，清香片片洒流杯。\n扬州西望江如带，东阁逢春几度开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵谷寺看梅五首 其二","author":"邓云霄","text":"路转深松过密筠，天开瑶圃迥含春。\n曲中玉笛吹残雪，梦里仙衣想美人。\n未许蝶蜂侵瘦骨，谁将沆瀣濯花神。\n怜君不肯如桃李，宝马香车自起尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵谷寺看梅五首 其三","author":"邓云霄","text":"宦情潇洒有馀闲，古寺幽芳得共攀。\n坐里氤氲香作国，醉中倾倒玉为山。\n陇头驿使春相问，岭外音书远未还。\n旧宅罗浮千万树，断肠猿鸟白云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵谷寺看梅五首 其四","author":"邓云霄","text":"白苧新披若不胜，素娥环佩自盈盈。\n妆开半面寒仍敛，笑入微风态更轻。\n翠羽有心窥艳蕊，青苔何意待飞英。\n还嫌生不临流水，为照冰姿入镜明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵谷寺看梅五首 其五","author":"邓云霄","text":"疏林澹澹挂斜晖，眼底游人看渐稀。\n芳草尚留珠履迹，香风遥送玉骢飞。\n山空转觉烟云净，春好何须锦绣围。\n最爱月明诸客散，万花深处一僧归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲春淫雨浃二旬感赋","author":"邓云霄","text":"拥褐西窗听雨眠，客稀门径簇苔钱。\n萧萧声咽淋铃曲，黯黯寒侵禁火天。\n巢落香泥愁乳燕，花垂红泪恼啼鹃。\n何人江閤开帘坐？\n收尽平芜万顷烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送苏太学汝载归粤","author":"邓云霄","text":"落梅如雪草如茵，送别江亭柳色新。\n六代湖山邀上客，三春花鸟怨归人。\n日高槐市收残卷，风便薄帆指晚津。\n回去相逢下机者，黑貂依旧未全贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明日雨","author":"邓云霄","text":"胜游已办杖头钱，风雨催花春可怜。\n寒食才过看改火，湿云何事翳新烟？\n岸泥滑滑无车马，水鹳哀哀噪墓田。\n晚踏斜阳倚虚阁，断虹犹挂绿杨边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王大将军出镇东粤","author":"邓云霄","text":"白门杯酒共谈兵，宝匣苍龙夜有声。\n送别东风摇五辆，启行南斗避双旌。\n关门吹笛梅花落，江阁投壶蜃气清。\n从此楼船徐荡桨，古来羊石是仙城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳凤台春望二首 其一","author":"邓云霄","text":"御苑春光变柳条，帝城烟树望中遥。\n登台人载青莲笔，招凤谁吹白玉箫？\n藉草流觞宜令节，落花啼鸟叹前朝。\n兰舟江上知多少，二水三山未寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳凤台春望二首 其二","author":"邓云霄","text":"化外红云压酒旗，城南村落到人稀。\n台荒小径通僧寺，草绿微香染客衣。\n曲水未同鸥鹭集，羽觞还学凤凰飞。\n松梢已报悬新月，杜宇多情莫唤归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得惠山泉送客游姑苏","author":"邓云霄","text":"梦回吴会隔寒烟，惠麓停舟记昔年。\n云窦滴来仙液冷，花溪流去暗香传。\n新烟正值清明后，烹茗才当谷雨前。\n饮罢不须携一斛，虎邱还有陆家泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"木末亭看新绿","author":"邓云霄","text":"微茫新绿遍金陵，不是东君染不成。\n蔼蔼翠烟浮处浅，迢迢白鸟去边明。\n伤离南浦三春晚，去国王孙万里情。\n况近长干冶游地，踏青环佩杂歌声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闰三月","author":"邓云霄","text":"春残逢闰日舒长，何处游人尚着忙？\n漫道花深催绿酒，转愁官厄似黄杨。\n空斋药里耽新病，微雨瓜田忆故乡。\n郎署从来能滞客，古今奚但有冯唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马嵬","author":"邓云霄","text":"广寒游罢舞霓裳，忘却嫦娥不死方。\n往日誓盟虚七夕，半生恩爱负三郎。\n军前驻马芙蓉折，剑外闻铃雨夜长。\n咫尺巫山难入梦，何须远觅水云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再咏雁字二首 其一","author":"邓云霄","text":"玉关人去叹飞蓬，织罢回文望远鸿。\n已学征夫同结阵，还如愁妾漫书空。\n偃波夜渡湘南水，垂露秋翻塞北风。\n近得苏卿消息否？\n君王正在上林中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再咏雁字二首 其二","author":"邓云霄","text":"秋声赋就强登楼，更倩惊鸿写旅愁。\n轻曳残云霏宝墨，斜连新月作银钩。\n有时濡翰银河侧，几度临池黑水头。\n肠断风霜关塞远，年年尺素为谁投？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀古迹五首 其一 黄陵庙","author":"邓云霄","text":"遗庙凄凉越鸟悲，云山九点望中疑。\n肝肠雨断随虞辇，桂酒千秋奠楚词。\n斑竹雨来还酒泪，洞庭烟净见修眉。\n行人莫问愁深浅，湘水滔滔未有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀古迹五首 其二 青陵台","author":"邓云霄","text":"云暗寒原白日阴，累累双冢见贞心。\n北山罗网虚惊鸟，古木鸳鸯自好音。\n未作吹箫游碧汉，可怜埋玉倚青岑。\n宋王台榭今何在？\n牧竖歌残草树深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀古迹五首 其三 虞美人草","author":"邓云霄","text":"剑气中宵不化虹，惟凭衰草寄残红。\n蛾眉岂怨君恩薄，玉帐初惊战士空。\n戏马台前啼晓露，乌江水畔泣秋丛。\n闻歌慷慨何须舞，禾黍离离满汉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀古迹五首 其四 青冢","author":"邓云霄","text":"别后传闻葬画工，君恩如海思难穷。\n香魂夜夜啼胡月，草色年年似汉宫。\n冢畔斜连南去路，天边不断北来鸿。\n沙场尚有征人骨，泣雨横霜卧短蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀古迹五首 其五 绿珠楼","author":"邓云霄","text":"锦障高褰集众宾，纤腰占尽一园春。\n红颜肯为他人好，薄命能捐报主身。\n花落雕栏空有影，香消幽径寂无尘。\n也知盛满多疑忌，不及萧萧四壁贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题焦弱侯太史谢墩别墅","author":"邓云霄","text":"龙卧林丘自晏如，名贤遗迹在阶除。\n荒苔尚印登山屐，细草曾回赌墅车。\n谁道风流千载尽？\n笑看风景六朝馀。\n襟期异代同遐想，挥麈浮云过太虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又题焦太史鸡笼山馆","author":"邓云霄","text":"太史书藏玉轴新，云边高馆倚嶙峋。\n青山旧是翻经地，玄草今多问字人。\n不信杖头吹太乙，试从台上验星辰。\n天鸡一叫琼窗晓，砚水遥分碧汉津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏双白燕三首 其一","author":"邓云霄","text":"对语雕梁昼正长，轻明珠箔映容光。\n秋深送别怜冲雪，春晚归来尚带霜。\n化去玉钗逢旧侣，梦回宝墨又新妆。\n于飞谁是同心者？\n公子多情道姓张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏双白燕三首 其二","author":"邓云霄","text":"翠幕飘飖不可留，爱君庭院暂夷犹。\n自矜赵后轻身舞，谁念卢家少妇愁？\n雾縠冰绡看并美，泥融沙暖好同游。\n不知盼盼楼头月，得似鸾箫到十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏双白燕三首 其三","author":"邓云霄","text":"处处堂帘斗丽华，谁云王谢是君家？\n并穿竹径犹沾粉，同泊梅梁忽吐花。\n秋入苧衣肌骨冷，寒催社鼓路途赊。\n青楼更有怀人句，对尔重歌浪飐沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日天界寺古桧下同诸词客听雨","author":"邓云霄","text":"林外斜阳侧布金，忽团云气昼阴阴。\n谁传玉女吹流电，不信天花散作霖。\n大泽共沾功德水，空山遥听海潮音。\n君看叶上明珠动，可悟青莲不染心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"避暑天界寺诏友人同宿","author":"邓云霄","text":"荒郊病蝎问医王，坐里青莲冉冉香。\n笑指红炉悲下界，梦随凉月到西方。\n天空花雨晴侵牖，风急松涛夜撼床。\n来宿莫嫌肌骨冷，已呼云物护新霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]