[{"title":"夏日村居四十二首 其六","author":"于慎行","text":"采得石花试煮，扫将柏子閒焚。\n色共龙团斗品，烟随鹊尾成文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其七","author":"于慎行","text":"玄莬城头鼓角，白狼河北烟尘。\n宵旰知劳圣主，安危定有谋臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其八","author":"于慎行","text":"稚子分操几杖，苍头并挽巾车。\n树底停杯听鸟，溪边觅鼎烹鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其九","author":"于慎行","text":"乳燕盈盈掠水，流莺恰恰啼烟。\n雨著绿杨枝上，云生白石矶边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其十","author":"于慎行","text":"抚枕沈吟焦鹿，衔杯啸傲蠃螟。\n已悟觉时是梦，还知醉里为醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其十一","author":"于慎行","text":"天籁非关比竹，园林片片春声。\n柳畔提壶劝酒，花间布谷催耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其十二","author":"于慎行","text":"倚杖云中送鸟，投竿水上观鱼。\n述志何曾著赋，绝交亦自无书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其十三","author":"于慎行","text":"雀入大水为蛤，橘踰长淮化枳。\n天地岂私我哉，人生贵适志耳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20497,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其十四","author":"于慎行","text":"石几移当薜幌，丝囊凭对花栏。\n门外何方骑吹，红尘北走长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20498,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其十五","author":"于慎行","text":"家住谷城山下，行踪半慕留侯。\n初无黄石公授，但从赤松子游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20499,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其十六","author":"于慎行","text":"握笔峰霞缥缈，弹琴涧水潺湲。\n草阁终年不闭，荆扉镇日常关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20500,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其十七","author":"于慎行","text":"面面溪山缭绕，村村花树蒙笼。\n人在渊明记里，家居摩诘图中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20501,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其十八","author":"于慎行","text":"偶遇城中客列，因知海上烽传。\n零落张骞使节，沈浮杨仆楼船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20502,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其十九","author":"于慎行","text":"九陌朱轮华毂，五陵骏马轻裘。\n眼底蜉蝣楚楚，枕中蝴蝶悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20503,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其二十","author":"于慎行","text":"啜茗风生瓦钵，焚香日上疏帘。\n坐久浑无个事，函开一卷楞严。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20504,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其二十一","author":"于慎行","text":"世界都无广狭，人生各有盈虚。\n鲲鹏两海不足，鹪鴳一枝有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20505,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其二十二","author":"于慎行","text":"开卷百年万里，连篇落日中原。\n一任骚坛定霸，争教学海穷源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20506,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其二十三","author":"于慎行","text":"呼马呼牛易应，梦鱼梦鸟难分。\n人世百年过客，勋名一片浮云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20507,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其二十四","author":"于慎行","text":"春尽新醅绿醑，日高旋煮雕胡。\n不羡金齑玉脍，休称琬液琼苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20508,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其二十五","author":"于慎行","text":"水绕项王冢畔，山围管子台前。\n万古英雄事业，斜阳衰草寒烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20509,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其二十六","author":"于慎行","text":"海岸渔竿自把，闾门雀网空张。\n浪迹真成汗漫，閒心不见炎凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20510,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其二十七","author":"于慎行","text":"春日雕梁燕雀，秋风高冢麒麟。\n贤圣谁能自免，身名何物为亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20511,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其二十八","author":"于慎行","text":"龌龊汉庭作吏，盘跚鲁国为儒。\n羞杀杜陵男子，笑倒高阳酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20512,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其二十九","author":"于慎行","text":"有竹有山有水，宜烟宜雨宜晴。\n欲似浣花溪畔，主人背郭堂成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20513,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其三十","author":"于慎行","text":"举袖翩翩调鹤，临池策策呼鱼。\n回忆天街跃马，当年心事何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20514,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其三十一","author":"于慎行","text":"竹影能留月影，松声颇乱琴声。\n此际翛然似水，应教多病身轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20515,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其三十二","author":"于慎行","text":"报岁常多野祭，迎年亦有巫歌。\n击壤升平旧老，欣随社鼓婆娑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20516,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其三十三","author":"于慎行","text":"古木千章水际，香泉万斛山阿。\n樵客空岩鸟道，田家半夜牛歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20517,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其三十四","author":"于慎行","text":"畏听山猿报客，愁看海鹤传书。\n可幸知交渐少，音尘不到幽庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20518,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其三十五","author":"于慎行","text":"薰为含香自爇，膏因吐燄常煎。\n拥肿能逃大匠，支离可尽天年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20519,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其三十六","author":"于慎行","text":"碧竹青萝院宇，黄鸡白酒盘飧。\n有客聊除花径，无人自掩蓬门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20520,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其三十七","author":"于慎行","text":"黄鸟声中酒肆，绿杨影里渔蓑。\n隔舍村翁泥饮，随身竖子徵歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20521,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其三十八","author":"于慎行","text":"蔓草生来勿剪，閒花落处休除。\n只任常生常落，年年点缀幽居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20522,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其三十九","author":"于慎行","text":"秋梦浑如春梦，春情化作秋情。\n出世何须避世，无名不用逃名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20523,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其四十","author":"于慎行","text":"量似饮河鼹鼠，居同粘壁蜗牛。\n阅世惟须满腹，谋身只合藏头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20524,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其四十一","author":"于慎行","text":"水面时喧雁鹜，山坳远下牛羊。\n细雨疏槐落日，披襟小坐绳床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20525,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日村居四十二首 其四十二","author":"于慎行","text":"见客端愁结袜，开门最怯梳头。\n赢得北窗偃卧，湘帘翠簟如秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20526,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题巴西甘大夫年谱小像十首 其一","author":"于慎行","text":"蜀都方著赋，汉阙正求才。\n借问题桥去，何当拥传回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20527,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题巴西甘大夫年谱小像十首 其二","author":"于慎行","text":"马上碧衣郎，春风锦带长。\n上林花万树，无处不飞香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20528,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题巴西甘大夫年谱小像十首 其三","author":"于慎行","text":"被冷明光夜，兰香画省秋。\n清时閒法吏，吟倚白云楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20529,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题巴西甘大夫年谱小像十首 其四","author":"于慎行","text":"轺轩秦塞远，戟府汉江开。\n万里桥边路，乡书几度来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20530,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题巴西甘大夫年谱小像十首 其五","author":"于慎行","text":"帷幄谈兵地，风烟陇树秋。\n不因羌管月，谁道近凉州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20531,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题巴西甘大夫年谱小像十首 其六","author":"于慎行","text":"尺籍徵兵下，铜鱼使者章。\n临淄十万户，一半戍渔阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20532,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题巴西甘大夫年谱小像十首 其七","author":"于慎行","text":"朝正开左个，玉帛古元侯。\n千骑东方至，朱衣在上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20533,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题巴西甘大夫年谱小像十首 其八","author":"于慎行","text":"挂冠三观顶，长揖海云孤。\n羞杀秦人树，犹称五大夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20534,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题巴西甘大夫年谱小像十首 其九","author":"于慎行","text":"一艇烟波里，垂钩傍月亲。\n风尘回首地，多少未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20535,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题巴西甘大夫年谱小像十首 其十","author":"于慎行","text":"辍耕陇头夕，山云稍欲没。\n散发啸平林，饭牛待凉月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20536,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆远集句","author":"于慎行","text":"春草年年绿，烟波处处愁。\n所嗟人异雁，犹隔洞庭秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"思归集句","author":"于慎行","text":"云暗双龙阙，花明绮陌春。\n悠悠洛阳梦，莫作未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日早朝","author":"孙继皋","text":"圣主能勤御，臣心敢避痾。\n风传天上漏，云集晓来珂。\n鹓序鸣钟列，龙光接陛多。\n日临千月荚，烟覆万年萝。\n彩簇新齐仗，衣单旧赐罗。\n冠裾高蹈舞，鸟雀并讴歌。\n香散螭头鸭，车回鹭口鹅。\n遥瞻紫微里，隐隐翠华过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"枣轩述怀叠前韵","author":"孙继皋","text":"休沐堪除累，乘閒学养痾。\n北窗聊伏枕，南陌自鸣珂。\n静爱琴尊润，清怜雨露多。\n焚香邀紫翠，晒药入藤萝。\n碧草萦湘帙，朱花剪绛罗。\n石苔随意长，山鸟任情歌。\n舞罢非调鹤，书成岂换鹅。\n客应看竹至，敢拟问奇过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴鸿胪改官旧都","author":"孙继皋","text":"君才长合侍明光，乞得新恩指凤皇。\n恋主几人仍奉母，移官随分只为郎。\n关城柳对三山月，驿路枫凋一夜霜。\n我亦周南留滞者，归心早已到江乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄翰长奉使河阳","author":"孙继皋","text":"使节飘飖出建章，宫袍绰约动辉光。\n天临二室金函固，日吐三花玉叶长。\n北极风云驱入洛，中原词赋盛游梁。\n须知圣主劳供奉，莫遣轺车滞故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送余太史使东藩","author":"孙继皋","text":"玉节金函出汉宫，清时乘传几人同。\n天临海岱河山古，地接青徐日月中。\n授简故应操白雪，搴帷犹自起雄风。\n承明共入真怜汝，一水心将夜夜东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李鸿胪解官还苻离","author":"孙继皋","text":"不缘华发谢朝簪，云白山青自素心。\n天语曾传三殿出，主恩偏向五湖深。\n人归雎水逢春暮，家近淮阳接桂林。\n最是陆沈吾已久，因君乡思一沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东门路","author":"孙继皋","text":"东门路，垂杨树。\n年年只解送行人，不管风光递来去。\n我生良苦亦以休，白发岂为青春谋。\n请看桥下长流水，日夜潺湲何处留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答邹缮部病中赠余枣轩新成不能过赏之作","author":"孙继皋","text":"不是恋簪裾，风尘暂结庐。\n苔深长者辙，竹引故人书。\n夜月寒相照，秋花晚更疏。\n天涯同病在，乘兴意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留钱徵君思归","author":"孙继皋","text":"那堪秋色里，容易别愁生。\n朝市非君意，乡原是客情。\n天寒一水阔，木落万山清。\n是处宜高隐，何须叹转萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得玉酒船漫赋","author":"孙继皋","text":"爱此璠玙质，偏宜托酒船。\n直须酿沧海，长醉白云边。\n载月浮金谷，乘风度绮筵。\n美人何处隔，引满一鸣舷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒夜管山人携具过访分得肥字","author":"孙继皋","text":"周南留滞未能归，江畔鲈鱼几度肥。\n岁晚惊心羁宦薄，天涯乘兴故人稀。\n林光引月过閒幔，夜色将寒上敝衣。\n君亦萍踪流落久，一尊何限思依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"解钱徵君自嘲以入贺长至故 其一","author":"孙继皋","text":"几年披发学垂纶，此日抠衣谒紫宸。\n莫以素心翻自诧，金门元有隐沦人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"解钱徵君自嘲以入贺长至故 其二","author":"孙继皋","text":"阳归仙仗觉春浮，野服何人见冕旒。\n自是无心能玩世，故山猿鹤未应愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"解钱徵君自嘲以入贺长至故 其三","author":"孙继皋","text":"含元殿下五云新，观阙中天日月亲。\n圣主可知能得士，巢由今已共称臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长至","author":"孙继皋","text":"六管葭灰动，新阳到玉除。\n履祥元老献，云物史臣书。\n气应和风转，衣添弱线初。\n自怜留滞者，犹复待吹嘘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小至集斗室分得知字","author":"孙继皋","text":"蚤解浮生理，经时一以悲。\n年华催鬓短，风景觉阳迟。\n心岂寒灰热，愁将弱线丝。\n宦情兼旅思，犹喜故人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋尽日雨","author":"孙继皋","text":"一自客咸秦，愁看落木频。\n秋随暮雨尽，寒入敝裘新。\n金马吾堪隐，雕虫老更亲。\n最怜窗外竹，萧瑟故人邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送管山人游山东 其一","author":"孙继皋","text":"绿酒黄花此送君，高城远雁不堪闻。\n随风若到天门观，为寄峰头一片云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送管山人游山东 其二","author":"孙继皋","text":"不唱人间行路难，飘零早已客长安。\n独怜一片并州梦，夜夜关山月里寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送管山人游山东 其三","author":"孙继皋","text":"九月燕山乍雪霏，客行何处授寒衣。\n遥知一水通吴楚，莫学王猷漫兴归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送管山人游山东 其四","author":"孙继皋","text":"当年五岭屐痕斑，五岳从今次第攀。\n游遍写将图画里，梅花一夜满名山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立秋日病","author":"孙继皋","text":"伏枕仍今夕，开轩乍已秋。\n高梧片叶落，大火一星流。\n楚塞砧初动，齐纨扇欲收。\n因思故园鲙，强起赋登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏西内白鹦鹉","author":"孙继皋","text":"慧质冯谁赋，奇毛祇自怜。\n黄冠莲蕊散，白羽雪花妍。\n讵有还山梦，能言度陇年。\n宫门盈尺地，不到圣人前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集顾秘书一枝馆得西字","author":"孙继皋","text":"一枝今见凤曾栖，门外谁当叔夜题。\n献赋昼趋金殿里，开尊秋满玉河西。\n寒花自媚兰台草，暮霭遥分秘阁藜。\n痛饮不辞疲击柝，沉冥吾已醉如泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆生还吴","author":"孙继皋","text":"岂为风尘说剑难，薄游无意恋长安。\n天垂碧野孤亭出，路入青山独马看。\n酒傍柳花江店晚，潮翻云树海门寒。\n春归度尽相思曲，紫玉声中夜月残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏调浦进士 其一","author":"孙继皋","text":"朱阁层层绮户开，今时碧玉号多才。\n相逢乍问郎年少，几度章台折柳来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]