[{"title":"文笔峰","author":"许子伟","text":"凭谁竖羲画，插破古天荒。\n云锦毫端彩，星芒笔底光。\n颖临千嶂俯，翰洒八埏香。\n对此心缘正，依稀首欲昂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五指山和丘文庄公韵","author":"许子伟","text":"翠壁崚嶒五岳连，恍疑仙掌出扶天。\n回环遥镇千溟浪，叆叇长浪百瑞烟。\n似鼓群山来北拱，已标奇甸正南悬。\n阳春雅调应相续，俊羽清商起太原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉使南还海口渡","author":"许子伟","text":"路断天涯得少停，楼船箫鼓日逢迎。\n三更挂席渺沧海，二月乘槎老使星。\n春气暖如帷下卧，潮声细入寝边听。\n寒装顿喜充行箧，依旧悬车菽水亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽海忠介公","author":"许子伟","text":"本来正气参天地，正气如公信可参。\n九死孤忠能悟主，一生奇节在惩贪。\n已闻吴下称为母，几见朝中果是男。\n蝉翼介轮何事重，对公衾影欲无惭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉阳书院","author":"许子伟","text":"好筑山堂深未深，篮舆便得两登临。\n共寻胜日无边景，时话先天一点心。\n苗发雨翻新作浪，枝头乌宿故知音。\n乾坤不惜明开眼，红紫东风自古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"皋塘馆喜晴拟回玉阳书院祀白沙先生","author":"许子伟","text":"闻道青山耻据梧，巾车又到小蓬壶。\n岩花宿雨红含态，水鸟新晴绿唤雏。\n本为登山持蜡屐，更盟观海泛棠舻。\n春风两袖蒲三尺，归对先生契我无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游青山三首 其一","author":"许子伟","text":"江门春景自吾乡，祀罢先生蹑玉阳。\n剩有春风蓑一领，不妨投足雨如浆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游青山三首 其二","author":"许子伟","text":"年来东道主人翁，静似潜龙动亦龙。\n潇洒不知身透雨，乘风直欲跨崆峒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游青山三首 其三","author":"许子伟","text":"春到文昌满县花，御杯高处讲无遮。\n微茫雨色团倾盖，错认青阳是白沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马鞍冈","author":"许子伟","text":"从来天厩种，不受俗鞿缰。\n锦鞯黄金勒，蹄骄道路长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"铜鼓岭观海寄贺明府 其二","author":"王弘诲","text":"一纵登临目，苍茫太宇空。\n断山浮潋滟，削壁判鸿蒙。\n地撼蛟龙斗，潮争鼓角雄。\n凭高独舒啸，宛在水晶宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海南风景","author":"邢宥","text":"南荒千里尽王疆，四顾天连海色苍。\n二郡舆图兴自汉，五州编户盛于唐。\n故家大半来中土，厚产偏多起外庄。\n弦诵声繁民物庶，宦游都道小苏杭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"琼台杂兴七首 其一","author":"邢宥","text":"德星南斗聚光华，文物衣冠耸故家。\n鱼兔叠班唐使节，楼台相望汉宫衙。\n阜康自拟唐贞观，习尚相高晋永嘉。\n聊乐不劳方外去，七洲烟月浩无涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"琼台杂兴七首 其二","author":"邢宥","text":"黉馆群游并俊华，书香半袭旧儒家。\n芝兰尚友颜回室，葩萼争雄宋玉衙。\n席上珍藏光发越，胸中道富乐肥嘉。\n白袍自破天荒后，秋鹗尝飞岭外涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"琼台杂兴七首 其三","author":"邢宥","text":"五指山光胜九华，版图曾奏汉王家。\n窠中人老多遗世，被里官闲早放衙。\n橄榄香回茶后美，蝤蛑鲙出酒馀嘉。\n薰风座上羲皇客，一曲雍容咏圣涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"琼台杂兴七首 其四","author":"邢宥","text":"六鳌洲背涌精华，十邑居民数万家。\n椰子户雄橙橘户，槟榔衙胜柳槐衙。\n匝花海上琼芝秀，含液枝头锦荔嘉。\n却被坡翁收拾去，至今龙泣水西涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"琼台杂兴七首 其五","author":"邢宥","text":"大同民习悃无华，轩冕浮云重世家。\n巷被空花明吉贝，屋披云构战繇衙。\n稻田秋敛冬还种，药圃菁芳雨更嘉。\n一斗桑麻半樽酒，兴如沧海没津涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"琼台杂兴七首 其六","author":"邢宥","text":"一经相继读南华，谁似清林处士家。\n庭外雨晴喧鸟市，檐前日暖散蜂衙。\n菊含霜气秋香烈，蔗酿寒浆晚节嘉。\n且幸海门波不动，居闲随分足生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"琼台杂兴七首 其七","author":"邢宥","text":"地极南壖萃物华，竹垣深浅里人家。\n儿童总解藏私货，父老无繇识县衙。\n藜子熟时村酒酽，甜茹茁处野肴嘉。\n东风不负凫鹥约，白首同归醉海涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七星排斗","author":"邢宥","text":"岂信人间有列星，天移北斗下南溟。\n望先及塔摹孤影，削不成峰笑五丁。\n返照入波垂列宿，密云扶雾点高形。\n皇舆碧落通呼吸，何日登临勒短铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋对月","author":"邢宥","text":"举头问月月无辞，俯首衔杯有所思。\n棘院观光群射策，茅斋刻影独吟诗。\n入秋欲养身丰羽，试酒先将面点朱。\n今夕桂条凭折尽，来科留取最高枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"任都御史纪恩","author":"邢宥","text":"半载封章两度颁，主恩深注再迁官。\n藩参既领一州易，都宪重兼百政难。\n财赋东南民力困，祖宗根本地方宽。\n拳拳付托为兵食，计拙谋疏寝未安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"思亲","author":"邢宥","text":"抱闷休閒宦况微，白头亲在久相违。\n后生稚子今应长，旧识老翁半已非。\n山蕨每怀三月美，海鳌常记四时肥。\n逢人莫话归来日，未语先沾泪满衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题海天春晓图送海南道副使致政","author":"邢宥","text":"旸谷风来力尚微，海棠花已映荆扉。\n雷鸣地角宣春令，日浴波心散晓晖。\n啼血鹃寒还树叫，寻香蜂倦绕林飞。\n渔翁独起观天色，收拾丝纶趁早归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归休途中","author":"邢宥","text":"乞得残形返故丘，满江明月送归舟。\n百年事业随身老，三岛烟霞入梦稠。\n花下自吟移短榻，海中相伴有驯鸥。\n春田鸭粟家尝酝，长醉无人笑白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"休归咏怀 其一","author":"邢宥","text":"脱却樊笼得自繇，家园万里望琼州。\n花看晚节添幽兴，人忆同时觅旧游。\n一枕黑甜山舍午，半樽白泼水亭秋。\n归来已定栖身计，独愧君恩未尽酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"休归咏怀 其二","author":"邢宥","text":"枉尺何劳计直寻，一官尝抱旧儒巾。\n时当岁晏芳心歇，风入高秋病骨侵。\n圣主独怜章累上，列卿同赆酒频斟。\n投簪莫讶归来早，倦鸟惟应恋故林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄葫芦族人","author":"邢宥","text":"卜筑葫芦境最幽，竹篱茅舍似荑莤。\n身多暇日琴随鹤，意得当年剑换牛。\n泉石愿依山作主，簪缨不羡世封侯。\n头因无事齐齐白，直是罗浮隐者流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书怀","author":"邢宥","text":"生平安分只随缘，临老休归得自然。\n两脚徐徐行实地，一心坦坦对青天。\n月因近日光常减，竹到经霜节愈坚。\n记得唐人好言语，相公但愿汝无权。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48029,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"草亭望海","author":"邢宥","text":"丘山望海水溟溟，万斛龙骧一羽轻。\n沙碛煮盐凝皓月，潮痕遗贝丽繁星。\n碙州夜露金银气，神电晴岚鹳鹤鸣。\n同会朝来望北阙，休归长颂海波平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48030,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛丑初度日","author":"邢宥","text":"前生自是白头翁，再见苍龙岁舍同。\n身世悠悠还是客，颠毛短短返成童。\n两间俯仰期无愧，百事修为贵有终。\n此去古稀年不远，桑榆晚景好收功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48031,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和友人韵","author":"邢宥","text":"作吏平江已六秋，抚心民事未全酬。\n闲来且看儿童乐，兴至还同父老游。\n红叶乘风惊落帽，黄花借酒可添筹。\n羡君作赋称通彦，凭眺高山任水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日有怀","author":"邢宥","text":"虚度重阳六十秋，菊花空对酒难酬。\n闲吟诗句皆新得，遍历江山多旧游。\n丘上曙开堪纵目，壶中矢发旋添筹。\n兴来活泼天机永，散步溪边看水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十岁勉学","author":"邢宥","text":"希贤希圣又希天，治国齐家此一肩。\n德业文章传世久，我今宜勉自童年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邱仲深至葫芦口占","author":"邢宥","text":"与君相送到葫芦，酒在葫芦不用沽。\n共饮一杯辞别去，君行西出故人无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吟翡翠","author":"邢宥","text":"文彩彬彬翠黛鲜，品流未让百禽先。\n休言筋骨非为贵，且道皮毛也值钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄南文德纯家","author":"邢宥","text":"山外平湖水接天，渔竿放下又耕田。\n相过暇日多贤达，诗酒优游忘岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48037,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄南文世远家","author":"邢宥","text":"幽居新筑海山头，树拥芳村翠欲流。\n好景坐看潮落处，钓船渔沪满沙洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48038,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"银花句","author":"邢宥","text":"风俗年来流又流，中流砥柱赖吾俦。\n于今又作银花涌，礼义何时得转头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48039,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海南村老歌","author":"邢宥","text":"海南村老非真村，家能识字里能文。\n读书大意破《论》《孟》，险夷巧拙知区分。\n得钱只欲买书读，不置田庐遗子孙。\n祝融司天霜不杀，四时雨露皆春温。\n禾收两熟杂粳糯，仓积穜稑多如云。\n木奴大者十馀种，半花半实充林园。\n族属姻娅无远迩，岁时壶榼通温存。\n水行乘舟陆乘马，巾服雍容礼义敦。\n况有童奴可将命，幸无徭役相劳烦。\n采钓芳鲜随意出，海中为乐难具论。\n养高花下酒一樽，无事足不蹑公门。\n心有馀宁形亦逸，海南村老非真村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48040,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安乐乡长寿歌","author":"邢宥","text":"人皆愿长寿，得之能几何。\n七十古来已稀有，今人八十尤无多。\n吾家老舅太叔裔，天锡偏隆家庆萃。\n鹤算今年八十跻，发鬓苍然颜似醉。\n日落春山社散时，少年醉卧老扶归。\n我翁坐起靸双屐，身轻步健行如飞。\n大田岁熟秋收急，拄杖田头终日立。\n如珠如玉嘱童奴，莫遗所天抛颗粒。\n此翁骨相本瑰奇，龙马精神松柏姿。\n少从严侍宰花县，足迹踏遍西江湄。\n高安风习厌浮薄，操觚直过庐陵学。\n炙贤摩善友多闻，扫尽游谈重然诺。\n客梦南云遥北堂，便辞严侍早还乡。\n彩衣舞罢寻耕钓，食鲜茹美轻膏粱。\n汪汪语笑夹飞瀑，五老香炉犹在目。\n探春海上独寻梅，涤暑林间常友竹。\n木奴四望环苍翠，采斲只在此山内。\n剩栽杞菊佐盘飧，细缉茝兰纫佩帨。\n内能睦族外比邻，湖海襟期最可人。\n识达义敦时望重，未容空谷老闲身。\n乌纱白发旧弱冠，云鹤相邀清且焕。\n自将名利等浮云，物外逍遥何羁绊。\n流水高山无常住，老翁胸中千古趣。\n不资金鼎炼神丹，静养清修安分素。\n此心无欲更无营，六脉清和百窍清。\n气血流通神秀发，性无戕贼自延龄。\n世人谋寿痴堪叹，念佛吃斋勤赛祷。\n不知作事要平心，却罔此心从左道。\n罔而得寿是为幸，潦倒龙钟奚足敬。\n谁似我翁益老益高强，寿保太和真可庆。\n谢庭兰玉并才贤，正临初度起芳筵。\n三族亲宾欢会集，寿觞满载酒如泉。\n阶前彩服舞傞傞，我为翁唱长寿歌。\n舞袖一翻歌一放，众宾争献金叵罗。\n我唱寿歌宾拍掌，掌拍声齐歌益壮。\n一杯未尽复一杯，不觉东方月已上。\n閒话升平兴未阑，新醅继出尽馀欢。\n且舞且歌行且拜，愿君长寿等南山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48041,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"镇守紫荆关作","author":"屈仲舒","text":"塞上风霜旧，军中号令新。\n枕弓头印月，卧甲臂生鳞。\n慷慨酬明主，忠劳致此身。\n狼居封有日，归贺太平春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48042,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荷钱","author":"屈仲舒","text":"一生池沼自馨香，不与青铜较短长。\n莲叶田田无可用，也能平买数鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48043,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"京师就义啮指报母诗","author":"梁惠生","text":"文星耿耿恶星缠，虚度韶光十八年。\n只望曾参养曾皙，岂知颜路哭颜渊。\n白头老母身犹在，红粉佳人分未完。\n待得血书归报日，一声儿子二声天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48044,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝安八景诗 其一 市桥春涨","author":"陈靖吉","text":"送春骤雨如翻盘，昨朝清浅今弥漫。\n此时济川匪舟楫，生民岂免为鱼鼋。\n长鲸跨江鳞甲动，阑干欲逐浪花涌。\n惜哉无处唤吴儿，跨上潮头试一弄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48045,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝安八景诗 其三 黄岭廉泉","author":"陈靖吉","text":"旗峰万仞插天碧，山高水深来有脉。\n古今酌遍野人杯，谁是夷齐谁盗蹠。\n愿公激浊更扬清，大作霖雨均山城。\n馀功不独苏久旱，且为赤子洗甲兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝安八景诗 其四 宝山石瓮","author":"陈靖吉","text":"飞流千尺落崆峒，声似晴雷震地动。\n松花竹木酿醴泉，素绠分碧银瓶冻。\n当时汲水蛟龙怒，渴饮岂料鼪鼯污。\n晋郡江山倘有灵，我公电扫看兹举。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝安八景诗 其五 彭峒水帘","author":"陈靖吉","text":"峒门倚空如壁立，隔断红尘飞不入。\n三秋风剪银河冰，四时天雨珍珠粒。\n语清无比贵无价，是谁主张山中挂。\n水晶宫殿岂无人，琴声玲玲明月夜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48048,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝安八景诗 其六 靖康海市","author":"陈靖吉","text":"滔天腥浪如天来，蛮烟瘴雾拨不开。\n江神无计役风伯，致使蜃气成楼台。\n长桥复道千万丈，车盖人马相来往。\n须臾水天同一色，落日照篷渔歌唱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48049,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝安八景诗 其七 海月风帆","author":"陈靖吉","text":"海月岩前天接水，岩上临之若无地。\n舶棹清风商客来，江程千里片时至。\n神飙吹送十幅蒲，惊鸥飞鹭为前驱。\n危樯过尽千复百，更无行踪流江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48050,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝安八景诗 其八 觉华烟雨","author":"陈靖吉","text":"江心楼阁梵王宫，三千世界疑虚空。\n渔村相对一水隔，竹篱茅舍有无中。\n半开霁景更奇特，远树参差青历历。\n一图水墨海天秋，今古不知谁捲得。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48051,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"峡山飞来寺","author":"李震","text":"飞来寺里独凭栏，暂息尘缘半日闲。\n水绕竹根穿石面，鹤巢松顶立云间。\n满台花雨飘僧梵，一路风霜老客颜。\n若许挂冠寻旧隐，结茅何必问庐山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48052,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九星岩","author":"李震","text":"飞星化作翠芙蕖，贯索垂光应斗枢。\n赤豹守关依宝藏，苍龙还钵护神珠。\n月林香露飘金粟，阴壑灵风振白榆。\n为纪重游磨翠藓，又从香积饭雕胡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48053,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海珠慈度寺","author":"李震","text":"海上禅扉记昔游，黄金鳌背踏清秋。\n天花影覆盘陀石，舍利光生杜若洲。\n足底潮声来合浦，望中云气接罗浮。\n老僧不管人间事，闲对沧浪数白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48054,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"香山览秀","author":"李震","text":"西康山色似芙蓉，亦有云巢向此中。\n九垒屏风金闪翠，千寻瀑布玉垂虹。\n也知太白诗无敌，独羡王维画最工。\n待我结茅同晚岁，不须骑鹤上崆峒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48055,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三洲岩","author":"李震","text":"维石岩岩紫翠连，原非禹凿自天然。\n旋磨崖壁镌新字，细看诗词忆旧贤。\n茂叔南来曾乐道，葛洪西驻已升仙。\n兴游几度寻遗迹，云满高峰月满天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48056,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巢翠轩兴怀","author":"李震","text":"停辙卧南居，敢言谢时辈。\n归对幽窗前，小憩依巢翠。\n兴来恣佳趣，秋至颇清快。\n览此群物情，遂我平生爱。\n心同鸥鹭盟，身与渔樵会。\n放意麋鹿性，长日懒冠带。\n远岫上新月，芳林破苍霭。\n岚散碧天青，光摇石潭碎。\n缅怀苏门啸，更忆郑生慨。\n二隐不可招，高风邈千载。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王武卿","author":"李震","text":"知君脱屣远浮云，牢落天涯寄此生。\n万里江湖随旅泊，十年风月付吟情。\n丝纶有学惟忧道，献纳无心不用名。\n流水桃花春已晚，几时来伴白鸥盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄桂林司训王德安","author":"李震","text":"百事无成多愿违，行藏深愧故人知。\n空教杜老愁如织，堪笑刘郎鬓欲丝。\n问字有谁能载酒，看花到处谩题诗。\n分台御史如相见，为说青衫似旧时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜过湖","author":"李震","text":"湖光无际月团团，倒浸山河宇宙宽。\n舞影鸾窥金母瓮，抱珠龙卧水晶盘。\n大姑罗袜江花绣，五老香炉石鼎寒。\n过客不知天险处，舵楼吹笛到更阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望九华山","author":"李震","text":"江上停舟望九华，水云如障卷晴霞。\n松巢白鹤千秋雪，地拥青莲万丈花。\n竹杖几时寻旧隐，石田何处觅生涯。\n自知素有唐人癖，吟对东风日已斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟次三水寄竹泉上人","author":"李震","text":"片云远隔五羊城，白足高僧事事清。\n吟对梅花看月色，坐题桐叶听秋声。\n一尘不及人间迹，万虑都忘物外情。\n卖却床头琴与剑，几回相见话生平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]