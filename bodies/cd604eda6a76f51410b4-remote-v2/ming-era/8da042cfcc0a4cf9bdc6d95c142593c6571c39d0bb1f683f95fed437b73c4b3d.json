[{"title":"午日赐观击毬射柳诗","author":"夏原吉","text":"奏罢南薰驾六龙，从容阅武禁城东。\n旌旗隐映花间日，鼓吹喧轰柳外风。\n百步叶穿弓满月，两朋毬击马飞空。\n从臣忻睹呈歌颂，吉日车攻讵比隆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39089,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"应制赋黄鹦鹉诗二首 其一","author":"夏原吉","text":"色正中央世所奇，绛膺丹趾古尤稀。\n远乘花雨辞滇水，高挹天香觐帝闱。\n上苑金莺难并侣，碧霄黄鹄喜联飞。\n信斯瑞物非徒致，惟我皇仁被九围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39090,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"应制赋黄鹦鹉诗二首 其二","author":"夏原吉","text":"皇仁广被世雍熙，南服祥禽贡玉墀。\n菊羽煌煌金色灿，星眸炯炯碧光垂。\n致身幸际千年运，调舌能歌万寿词。\n好向丹山邀彩凤，衔图共献太平时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39091,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送御史蒋暹乞假归省金台诸友诗图赠饯","author":"夏原吉","text":"客里频传送客钟，岂知孱质已成翁。\n狂歌强作江南调，薄饯聊随蓟北风。\n柑熟洞庭人足到，月明湘水梦谁同。\n凌云健翮须时奋，去去毋淹枳棘丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39092,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题人影","author":"夏原吉","text":"不言不语过平生，步步相随似有情。\n长向灯前同静坐，每于月下共閒行。\n昨朝离去天将暝，今日归来雨又晴。\n最是行藏堪爱处，显身须要待时明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39093,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"瑞兔","author":"夏原吉","text":"储精月殿几何年，今换新妆下九天。\n玄毳霏霏煤雨润，黔姿闪闪墨云鲜。\n眠寻雪窟身难隐，行傍梅花色更妍。\n似此真为清世瑞，可无诗献玉阶前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39094,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宣德己酉夏四月二十四日早朝应制二首 其一","author":"夏原吉","text":"月色朣朣玉漏停，九天阊阖悉开扃。\n云扶六驭来黄道，花覆千官列紫庭。\n清跸乍鸣诸殿肃，衮衣端拱万方宁。\n小臣何幸承殊渥，簪绂优游及暮龄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39095,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宣德己酉夏四月二十四日早朝应制二首 其二","author":"夏原吉","text":"圣主龙飞宰八区，视朝常在五更初。\n煌煌烛影辉金阙，袅袅香烟布玉除。\n仙掌每随东旭转，銮旂时为晓风舒。\n日高班捲夔龙出，黄阁从容阅奏书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39096,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和胡祭酒索黄精诗二首 其一","author":"夏原吉","text":"却秽通神更养生，黄精端不让青精。\n萝崖晓斸云连锸，竹砌宵蒸月满铛。\n服久岂徒跻寿域，身轻还许到蓬瀛。\n殷勤持向颐庵献，少助清筵骨董羹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39097,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和胡祭酒索黄精诗二首 其二","author":"夏原吉","text":"万里瓶封寄草庭，瑩然琥珀色微赪。\n灵根信是阳精结，香味真缘戊土生。\n资养丹台三景泰，扫除白发一身轻。\n独惭分献鳣堂晚，重辱珠玑堕月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39098,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄谢友人惠冬笋","author":"夏原吉","text":"带雪抽来犊角长，筠筐封惠自潇湘。\n锦绷乍剥棱棱瘦，玉板轻批片片香。\n孝子不劳林下觅，老亲深喜客中尝。\n明年此际应仍有，还肯相思寄远方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39099,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和刘给事中韵","author":"夏原吉","text":"文雅风流世莫双，黑头承荐入明堂。\n记言花露濡霜管，退食天香袭绣裳。\n北斗喜瞻嗟岁晚，阳春欲和愧才荒。\n愿摅忠荩裨清化，伯仲同垂竹帛光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39100,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和胡祭酒雨后见示诗韵","author":"夏原吉","text":"雨脚初收日色生，眼前景物一何清。\n亭亭高树张云幄，秩秩疏篁响凤笙。\n牛女如期天上会，蛬螀应候耳边鸣。\n官居独宿洪崖客，莫动西风张翰情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39101,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送员外郎陆仲英之闽宪副","author":"夏原吉","text":"兰署联镳已六秋，今当分袂赴闽州。\n葡萄满酌冰花冽，獬豸新簪霜气浮。\n万里骢声冲雪去，三关民瘼望风瘳。\n计程应向武夷过，烦问山人安乐不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39102,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠祝仲山滁阳省父还番阳","author":"夏原吉","text":"伟哉太仆起名儒，一住琅琊十载馀。\n苜蓿雨肥晨考牧，梧桐月白夜观书。\n达尊三备人咸羡，好句多吟我不如。\n珍重问安贤孝子，古来毋惜道途迂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39103,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"思亲","author":"夏原吉","text":"旅食金台已岁馀，高堂白发近何如。\n清晨应共妇占鹊，薄暮还同孙倚闾。\n衣服缝来针密密，音书寄到意劬劬。\n此身若有双飞翼，日日还家问起居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39104,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送春官侍郎仪公致仕归山东","author":"夏原吉","text":"伟矣南宫老亚卿，十年鸣佩玉阶行。\n经纶国事心惟切，辅导皇储志益精。\n景迫桑榆还故里，恩沾雨露出都城。\n寥寥疏傅荣归后，谁似先生播令名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39105,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送大理寺丞孙习之疾愈回南京","author":"夏原吉","text":"圣主仁明慎五刑，伏伽重起作廷平。\n读书读律谋猷富，无党无偏谳议精。\n抱疾经时淹北邸，承恩此日去南京。\n愿言更广平友政，勿使于张独擅名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39106,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送国子助教黄君立致仕归闽","author":"夏原吉","text":"太学横经已有年，圣恩今日许归田。\n三山耆旧迎疏广，六馆英髦仰郑玄。\n舟发天边无一物，诗传海内有千篇。\n如斯出处真高洁，惭愧吾侪后著鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39107,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送乡友监察御史彭希益还家省墓","author":"夏原吉","text":"异乡久抱故乡思，况复临岐送故知。\n鹦鹉忍倾桑落酒，玲珑愁唱竹枝词。\n想当蓟北霜飞处，正是江南人到时。\n烦语芹边诸俊彦，尚书今已鬓成丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39108,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送尚宝司丞葛贞还姑孰省墓","author":"夏原吉","text":"几年琐闼侍宸旒，风木长悬万里愁。\n忽喜纶音下阊阖，便寻兰棹觐松楸。\n群公毕饯金台晓，故老欢迎采石秋。\n安得此身同此志，束书也驾洞庭舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39109,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送冬官尚书黄公归山东省墓二首 其一","author":"夏原吉","text":"青岁登庸侍冕旒，白头归去觐松楸。\n袂分冀北冰初冻，车驻莱阳柳正柔。\n壮志肯缘乡土滞，此心长抱国民忧。\n虞廷弦奏南风调，拟听鸣珂谒凤楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39110,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送冬官尚书黄公归山东省墓二首 其二","author":"夏原吉","text":"京国交游已有时，春风偶动故园思。\n三杯燕市开怀酒，几句都门送别诗。\n海上仙人休问讯，山东民瘼好诹咨。\n先茔省罢还朝日，端笏从容奏主知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39111,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送教谕李素改除浙江就禄养亲","author":"夏原吉","text":"罗湘振铎十馀年，今又携书上浙船。\n梅玉一枝天上赠，蒲帆半幅月中悬。\n好披彩服同莱子，莫讶寒毡老郑虔。\n他日彤廷重考绩，春风台阁拟超迁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39112,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠僧南宗归钱塘诗","author":"夏原吉","text":"二十年前浙水游，题诗曾上看松楼。\n四檐风月清人骨，万里云烟驻笔头。\n宦辙祇惭同泛梗，尘心徒切仰虚舟。\n如今又向燕山别，旧日松楼诗在不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39113,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠李真翁","author":"夏原吉","text":"八闽高士老聃孙，结屋萧萧近水濆。\n心远更无金马梦，身閒常对白鸥群。\n黄庭夜读窗留月，绿绮朝弦榻驻云。\n何日移家傍翁舍，细聆清论涤馀氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39114,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过衢州次吴中书韵","author":"夏原吉","text":"使艖才拟过三衢，咫尺常山又驾车。\n流水有声浮舴艋，好山无数插芙蕖。\n身轻不惮行程远，才薄惟惭历仕初。\n珍重同来贤内翰，嘉言毋惜话前途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39115,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次芊源驿","author":"夏原吉","text":"舟次芊源日已西，个中风景夐清奇。\n潮声汹涌通闽海，山势逶迤接武夷。\n茉莉摘来香喷鼻，蛎房买到味如饴。\n翩翩上下皇华客，肯驻云帆共赋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39116,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"海上次吴中书韵","author":"夏原吉","text":"总角常思海上游，乘风今日得周流。\n一泓夜浴骊珠火，五色朝浮蜃气楼。\n辽水只今无鹤语，蓬壶千古戴鳌头。\n寄言汉使张公子，肯借灵槎犯斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39117,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次吴中书见示张真人所赠诗就步韵奉还","author":"夏原吉","text":"伟哉江右老儒宗，讲帐曾看设绛红。\n内史诗才存古意，天师书法冠时雄。\n寒毡懒坐清江雪，云锦新裁翰苑风。\n我欲踏花登凤沼，阳春一曲愧难同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39118,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次金泽颐浩寺僧中宅衡韵二首 其一","author":"夏原吉","text":"每愧无才位六卿，观风今出凤凰城。\n锦帆载月临金泽，宝刹披云驻玉旌。\n楼阁巍峨同上竺，江山清古儗南衡。\n何当了却公家事，来共高僧话月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39119,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次金泽颐浩寺僧中宅衡韵二首 其二","author":"夏原吉","text":"十载叨居治世卿，公游偶寓梵王城。\n法华流响清尘耳，薝卜生香袭使旌。\n苔石碑文迷岁月，云封星藏閟玑衡。\n谁能为我邀船子，问讯当年雪窦明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39120,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次前韵赠化城寺僧谦隐五首 其一","author":"夏原吉","text":"久闻声誉动时卿，今喜相亲在化城。\n风暖茶烟生几席，月凉花露湿幡旌。\n松关昼掩猿依榻，竹辇晨游鹤驾衡。\n贝叶有时看未了，小窗清夜爇松明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39121,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次前韵赠化城寺僧谦隐五首 其二","author":"夏原吉","text":"不羡人间冷煖卿，清修远傍阖闾城。\n禅衣稳胜三加服，锡杖殊轻五仞旌。\n烟岫以时开画障，风铃入夜响璁衡。\n祇惭我为尘缘扰，颠倒三生梦未明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39122,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次前韵赠化城寺僧谦隐五首 其三","author":"夏原吉","text":"朱门无意候公卿，自喜幽栖远市城。\n双屐登山舒眼界，一盂溪涧涤心旌。\n诗囊贮玉鸣吴楚，谈麈生风撼泰衡。\n况有空王遗录在，定馀时玩小窗明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39123,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次前韵赠化城寺僧谦隐五首 其四","author":"夏原吉","text":"簪笏庸庸位列卿，每惭时议鄙阳城。\n暂辞天上尚书省，来秉人间使者旌。\n治水无能追圣禹，穷经徒自慕匡衡。\n篇诗寄赠凝禅子，肯把真机为发明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39124,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次前韵赠化城寺僧谦隐五首 其五","author":"夏原吉","text":"献赋当年说长卿，至今名重锦官城。\n我生谩负三迁教，事业都无寸可旌。\n画舫当春行震笠，白云终日望湘衡。\n何时得似禅林客，襟宇澄澄万境明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39125,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿湖州慈感寺和壁间诗韵","author":"夏原吉","text":"借榻苕溪慈感寺，始知城市有山林。\n萧萧白发窗前老，漠漠红尘门外深。\n贝叶晓翻龙侧耳，珠光夜吐蚌倾心。\n道人相对莫相笑，聊洒松烟记重寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39126,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"昆山","author":"夏原吉","text":"昆阜遥看小一拳，登临浑似接青天。\n神钟二陆人才俊，气压三吴地位偏。\n岩溜下通僧舍井，林霏近杂市庐烟。\n何时重著游山屐，来访当年种玉仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39127,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟泊华亭述怀","author":"夏原吉","text":"官航昨夜泊华亭，谯鼓逄逄正四更。\n明月楼头人语静，西风江上客怀惊。\n萧何事业光前代，韩子文章法后生。\n顾我疏庸何所补，谩随沙鸟日营营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39128,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵答虎石道人三首 其一","author":"夏原吉","text":"几向天边仰德星，迩来相见正秋清。\n饱谙法海无穷理，不数宗门第一名。\n狮座晓登花有影，虎溪夜渡水无声。\n何时分我云间榻，烧烛烹茶尽此情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39129,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵答虎石道人三首 其二","author":"夏原吉","text":"为爱丛林老辨才，片帆归去又还来。\n囊中珠玉清人骨，尘尾风云障俗埃。\n莲社未知容我否，酒眉且自向师开。\n三吴早晚徵输足，重看天花雨法台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39130,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵答虎石道人三首 其三","author":"夏原吉","text":"每夜钩帘起看星，六符耿耿泰阶平。\n道人何独耽风月，不我相群攫利名。\n琢句春生池草梦，翻经时动海潮生。\n闲忙有分知谁并，惭愧无依记别情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39131,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次俞都御史韵与虎石道人二首 其一","author":"夏原吉","text":"纷纷车马走黄埃，此地谁能日日来。\n独有豸冠因酒病，时寻虎石扣门开。\n山中风月初相识，江上烟波又促回。\n今我登临亦何兴，谩看猿鹤舞徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39132,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次俞都御史韵与虎石道人二首 其二","author":"夏原吉","text":"道人净扫上方埃，瀹茗焚香待我来。\n风舞葛巾荷已老，露凝金?菊初开。\n心淹公事偷閒坐，话到真机忘却回。\n戍角一声催上马，满阶清影月徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39133,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登吴兴道场山","author":"夏原吉","text":"肩舆一上道场山，游览都忘陟顿艰。\n泉迸石渠存虎迹，峰名金盖拥螺鬟。\n木鱼催饭鸣松杪，野鹤窥窠过竹间。\n安得从今脱尘鞅，此中相伴老僧閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39134,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重游嘉禾天宁寺","author":"夏原吉","text":"前日曾留坚密轩，煮茶话旧夜无眠。\n此来重访山中客，再说三生石上缘。\n白鹤刷翎苔点雪，苍麋砺角竹分烟。\n何由顿谢尘纷事，也买蒲团学坐禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39135,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"虎丘怀古","author":"夏原吉","text":"我从山水窟中来，此地登临独怆哉。\n葬剑人亡池自碧，题诗鬼去石还埃。\n蒲牢叫月新修寺，麋鹿鸣风旧染台。\n谁似当时苏与白，画船箫鼓日追陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39136,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过吴江泗州寺访僧留宿","author":"夏原吉","text":"行尽吴江兴尚浓，却从寺里访瑄公。\n未论石上三生约，且喜山中一宿同。\n诗句新题蕉叶雨，茶香熟送藕花风。\n明当百八蒲牢吼，重整云帆向五茸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39137,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"至日述怀简袁少卿赵御医","author":"夏原吉","text":"去年冬至身为客，今岁逢冬仍未归。\n拜阙班联吴子国，还家梦绕老莱衣。\n尘踪似梗何时定，心绪如麻竟日违。\n珍重同行袁与赵，一尊好共酌斜晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39138,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题方尚书万竿烟雨图","author":"夏原吉","text":"琅玕碧锁何模糊，烟雨满林秋日晡。\n龙潜九地喷灵霭，凤入层霄衔瑞图。\n清瑟泠泠鼓湘水，翠华隐隐飘苍梧。\n云烟一幅醒我梦，二女祠前听鹧鸪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39139,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题太仆吴寺丞皆山轩","author":"夏原吉","text":"幽轩小小势翻翻，夭矫云峦四面环。\n青拥佛头朝雨后，翠排仙掌夕阳间。\n诗因景好偏多赋，琴为心閒不厌弹。\n可笑当年谢安石，谩携红袖走东山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39140,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题都御史所藏钱舜举山水","author":"夏原吉","text":"霁翁山水旧驰名，此卷今看笔更精。\n一瀑漏岩飞雪练，数峰当户列云屏。\n杖藜僧入松间寺，策骑人过柳外亭。\n佳境如斯在何处，扁舟便欲访蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39141,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题杨太仆所藏子昂画春牧图","author":"夏原吉","text":"我爱吴兴松雪翁，胸蟠百万渥洼龙。\n丹青邂逅挥窗底，牝牡分明见眼中。\n逸态雄姿皆汗血，高蹄促腕尽追风。\n何当驾此三千匹，踏碎边尘报九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39142,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题杨学士万木图","author":"夏原吉","text":"道殍累累岁大祲，达翁周恤意何深。\n指山托种千株木，发廪全倾万斛金。\n建水一时回菜色，龙津终古蔼棠阴。\n区区射利沽名者，俯仰斯图不愧心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39143,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题宝敬斋","author":"夏原吉","text":"宝敬斋名莫浪评，操存涵养在躬行。\n荒宁怠惰功斯坠，惕厉斋庄业乃成。\n朱子一箴千载重，丹书十字万金轻。\n贤哉甥馆清修客，仰止能忘西璧情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39144,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题常执中尚絅卷","author":"夏原吉","text":"三十年前共读书，已知君志与人殊。\n诗歌尚絅明深意，赋鄙雕虫学古儒。\n德业渊渊中自积，才华蔚蔚外如愚。\n只今从政多嘉绩，尤见躬行心得馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39145,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题主事张钺登云轩","author":"夏原吉","text":"伟哉南国登云士，志气如云孰与同。\n五色日边频献瑞，九重天上早从龙。\n不誇苍狗斯须态，肯眩奇峰顷刻容。\n润物以时施惠泽，直令四海仰丰功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39146,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题宋进士袁天与忠节传后","author":"夏原吉","text":"常山高辙久湮芜，之子寥寥踵后途。\n九窍入烟犹骂敌，一门赴水只存孤。\n沈朱效义真良仆，赵谢偷生岂丈夫。\n谁秉当时修纂笔，竟遗忠节快奸谀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39147,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题乐善堂二首 其一","author":"夏原吉","text":"休笑南阳诸葛庐，莫嗟西蜀子云居。\n寸心为善行无倦，尺地栖身乐有馀。\n瓮里况存招客酒，床头仍贮教儿书。\n閒来持此消长日，何用区区较毁誉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39148,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题乐善堂二首 其二","author":"夏原吉","text":"綵舟南溯路何长，过尽瞿塘是故乡。\n两岸柳风催去棹，一天梅雨迓归樯。\n好将吏部新书扁，高挂君家旧筑堂。\n他日归来重相见，熙熙人物共辉煌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39149,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"禁系省咎与傅生","author":"夏原吉","text":"端笏龙墀三十年，心持冰檗日乾乾。\n宁知卞玉青蝇污，犹幸秦台宝镜悬。\n夜枕悠悠萱草梦，晴窗耿耿鹡鸰篇。\n天门何日金鸡出，鹏翼重看万里骞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":39150,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]