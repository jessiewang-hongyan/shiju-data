[{"title":"戏调浦进士 其二","author":"孙继皋","text":"十二楼中吹笛声，梅花落尽不胜情。\n夜深忘却公车诏，笑指灯前暗结盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏调浦进士 其三","author":"孙继皋","text":"春风面面翠钿新，一片兰心好自亲。\n明日探花曲江院，知君遥属意中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏调浦进士 其四","author":"孙继皋","text":"下却高楼欲别难，如花容貌倚栏干。\n悬知簪绂无多日，云雨翻将梦里看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题钱山人园居 其一 伐檀斋","author":"孙继皋","text":"明月招我饮，白云披我衣。\n莫言生事少，镇日灌园归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题钱山人园居 其二 香雪馆","author":"孙继皋","text":"藤花白雪香，缤纷荫林樾。\n谁当问字来，踏破瑶台月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题钱山人园居 其三 待月廊","author":"孙继皋","text":"日落罢玄草，长廊一徘徊。\n山月出未出，幽人来不来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题钱山人园居 其四 旷视阁","author":"孙继皋","text":"川原何缭绕，开阁吞八九。\n为问阁中人，望见长安不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕喜浦大性初至为作长句","author":"孙继皋","text":"别君亦以久，见君一何难。\n相思两天外，各指流云端。\n岁暮关河匹马迟，朔风猎猎向人吹。\n可怜执手重逢处，正是天涯除夕时。\n丈夫聚散亦常尔，蓬转萍飘安足儗。\n但令意气无所惜，管鲍于今竟谁是。\n我生与子良已奇，束发倾盖苍颜期。\n家徒四壁只大醉，醒来一笑傍儿嗤。\n去年乡书挂名字，秋江桂树双琼枝。\n石渠金马漫相失，明月夜光空尔疑。\n迩来闻君大努力，文成班马无颜色。\n三年端合高飞鸣，一饱宁劳置胸臆。\n劝君解轻装，为君拂长剑。\n烛花寒复殷，明星夜方湛。\n殷勤会面梦耶真，惨澹魂销可具陈。\n莫惜尊前一杯酒，明朝又是隔年人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿陈石溪先生","author":"孙继皋","text":"起草名传建礼闱，东山归去倍恩辉。\n云霞彩簇新承诰，薜荔香生旧赐衣。\n酒下黄封知禁液，人从白玉见清徽。\n武夷应有神仙会，夜夜群星集少微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集王鸿胪宅","author":"孙继皋","text":"停策玉河边，清歌尽日妍。\n最怜林是竹，真有酒如泉。\n山月淡未出，野花红欲然。\n相看兴不减，何必晋人贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送内兄曹二还湘潭亲舍 其一","author":"孙继皋","text":"怜君竟漂泊，骑马出长安。\n去国关云暗，思亲楚水寒。\n功名尘世幻，道路古今难。\n莫以无家叹，还期振羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送内兄曹二还湘潭亲舍 其二","author":"孙继皋","text":"岁晏尔何适，情亲泪满裳。\n片云山下舍，孤剑橐中装。\n风急洞庭白，月明关路苍。\n泽兰如可采，为寄说行藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独坐","author":"孙继皋","text":"独坐空斋静，悠然太古心。\n日来亭己午，云过总成阴。\n山鸟乱鸣树，和风微动琴。\n平生寥落意，因以忆长林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题钱生册 其一","author":"孙继皋","text":"宫墙花发映垂杨，白马青衫满路光。\n游遍晋陵人共指，少年经术是钱郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题钱生册 其二","author":"孙继皋","text":"岸岸流莺树树啼，春晴风日锦标齐。\n最怜天畔池塘梦，尽逐芳菲衬马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题钱生册 其三","author":"孙继皋","text":"解说天门秘九关，广寒高处几人攀。\n君今踏得芹宫月，千丈丹梯在此间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题钱生册 其四","author":"孙继皋","text":"不知衿佩未为荣，自是云霄第一程。\n赋就金门明主召，青袍不解误儒生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送茹懋集山人还乡二首 其一","author":"孙继皋","text":"辞家日以久，归骑逼微寒。\n作客风尘倦，依人道路难。\n行歌劳陟屺，持赠托纫兰。\n别去空相忆，深杯此夜残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送茹懋集山人还乡二首 其二","author":"孙继皋","text":"文章难自贵，贫贱况天涯。\n归客惜芳草，离人对菊花。\n浮云迷汉阙，飞雪犯平沙。\n可有并州梦，关山路正赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李山人","author":"孙继皋","text":"故人骢马客，春尽一书来。\n分茗供幽事，论诗得异才。\n林塘堪下榻，风雨且深杯。\n苕水逢新涨，孤帆何处开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集得年字","author":"孙继皋","text":"逢君怀旧事，把酒惜流年。\n为问阊门道，垂杨几处眠。\n青山不在郭，风雨且开筵。\n好作平原饮，莺花春正妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠楚孝子无学居士","author":"孙继皋","text":"百里双亲隔夜台，三春寸草折寒灰。\n伤心易老乾坤窄，归骨重埋道路哀。\n宿伴空山思转剧，泪沾新冢梦初回。\n遥知周匝松楸外，两两青天吊鹤来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"管山人携具枣轩同钱徵君分得年字","author":"孙继皋","text":"为爱风林竹，高阳度酒船。\n蝉声连薄暮，花气入流年。\n片月窥人出，双星带客悬。\n宁辞永夜酌，一醉阮生贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨霁有怀钱徵君 其一","author":"孙继皋","text":"去住各何意，交情中路分。\n长安一夜雨，漂泊倍思君。\n树霭澹初日，城阴低暮云。\n雁书那可问，空自惜离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨霁有怀钱徵君 其二","author":"孙继皋","text":"户外雨不歇，忆君初到时。\n青山一以隔，华发总堪悲。\n世事酒杯过，閒情鸥鸟知。\n离居未可道，含意为裁诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有怀管山人建初","author":"孙继皋","text":"尽日风雨急，黯然千虑侵。\n不知江海客，何处酒杯深。\n萍水居难卜，云霄陆可沉。\n思之叹离索，一为赋愁霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日史民部饮斗室","author":"孙继皋","text":"画省风流独见君，散衙驱马慰离群。\n总缘六月歌成雪，遂使双龙气薄云。\n坐久凉飔供命酒，更阑花色照论文。\n当尊慷慨元吾辈，不向高楼问夜分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日同诸子集顾光禄分得屏字是日为光禄诞日","author":"孙继皋","text":"风尘玄草见君亭，尊酒千花照岁星。\n禁署声华头未白，中朝冠盖眼逾青。\n云浮北阙高金掌，日落西山列翠屏。\n以我相从诸子后，非才偏自学沉冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日卧病得诗十首 其一","author":"孙继皋","text":"客久堪谁过，官閒稳自慵。\n琴书供病色，花竹散尘容。\n昼杳沧洲梦，时寻白鹤踪。\n东方有高隐，吾意倘相从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日卧病得诗十首 其二","author":"孙继皋","text":"会心那在远，小筑见幽情。\n过雨宜花事，当风忽鸟鸣。\n青山供卧起，白日废逢迎。\n懒病依然惯，非高吏隐名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日卧病得诗十首 其三","author":"孙继皋","text":"幽居无俗事，小径即花源。\n薜荔春常在，轩窗月每存。\n焚香惟晏坐，对客只清言。\n更爱看山色，新开傍竹门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日卧病得诗十首 其四","author":"孙继皋","text":"不浅烟萝兴，尘中亦掩关。\n诗情消白日，病骨傲青山。\n野鹤焚香下，閒云散帙还。\n浮名将薄宦，吾意有无间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日卧病得诗十首 其五","author":"孙继皋","text":"偶尔成幽赏，居然得隐心。\n月檐松树迥，门径枣花深。\n窃禄从宾戏，论诗许客寻。\n浮生元不薄，何必定抽簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日卧病得诗十首 其六","author":"孙继皋","text":"伏枕违丹掖，端居坐紫微。\n颇怜官舍寂，未觉吏情非。\n乳燕窥悬幕，鲜云护赐衣。\n还思散直处，钟月远微微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日卧病得诗十首 其七","author":"孙继皋","text":"偃蹇供常病，栖迟隔故乡。\n检书槐月晓，移枕竹风凉。\n翠管虚中禁，金茎足上方。\n圣朝无羽猎，未敢奏长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日卧病得诗十首 其八","author":"孙继皋","text":"万事堪高枕，官衙况薜萝。\n闭门玄草歇，开牖白云过。\n竹翠晴犹湿，荷香晚更多。\n陆沉翻自爱，不复厌婆娑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日卧病得诗十首 其九","author":"孙继皋","text":"乞假辞朝谒，耽幽学隐沦。\n病翻思客至，閒不厌官贫。\n高树团晴霭，秾花恋晚春。\n物华偏在眼，肯惜酒杯频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日卧病得诗十首 其十","author":"孙继皋","text":"官阁暑犹寒，生涯寄药栏。\n风尘吾意懒，岁月主恩宽。\n短发牵丛桂，同心忆采兰。\n小盘甘苜蓿，时复一加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送文文学读书虎丘之梅花楼 其一","author":"孙继皋","text":"黄金谁复起燕台，白雪千春事可哀。\n易水风寒高士去，吴门秋早大江来。\n不缘莼菜劳归棹，自爱梅花照举杯。\n垂老飘零君莫问，穷愁今见著书才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送文文学读书虎丘之梅花楼 其二","author":"孙继皋","text":"汉廷寥落滞雄文，燕市悲歌忽送君。\n调里寒光回夜雪，行边真气动秋云。\n巨源交态疑中散，山令才名视右军。\n江阁梅花应好在，可能吟向凤城闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中同丁黎二计部欧博士顾王二鸿胪秦顾二中翰分得言字","author":"孙继皋","text":"良晤一何惬，爽然秋兴存。\n同来粉署客，共有沧洲言。\n木落雁鸿劲，庭空风雨繁。\n犹怜握手晚，未敢厌清尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送丁少鹤计部奏最还南都","author":"孙继皋","text":"酂侯绩奏未央宫，圣主亲嘉转饷功。\n廿载驱驰官总拙，三朝筹画计逾工。\n霜清画角襜帷外，月冷丹枫驿路中。\n君莫自怜郎署长，汉家根本两京同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"管建初山人从黄太史游嵩少诸山赋赠","author":"孙继皋","text":"名山千古郁相望，著屐归来鬓未苍。\n二室玉花飞翰墨，中嵩云气湿衣裳。\n高僧诀向峰头授，太史书宜石上藏。\n十载尚平游岳梦，逢君先为乞琼浆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送华三还南 其一","author":"孙继皋","text":"浮名那足恋，风雨问归途。\n客泪三年尽，乡心一雁徂。\n衣将裁薜荔，帆欲挂蘼芜。\n明镜刀头夜，霜华鬓有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送华三还南 其二","author":"孙继皋","text":"弹铗竟何意，挂帆秋满船。\n艰难为客倦，惨淡逐人怜。\n世路浮云外，乡心落日前。\n西风吹易水，因尔一潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙子春梦得一联足成一绝","author":"孙继皋","text":"落日船头浪，春风江上山。\n家园几千里，却向梦中还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬日顾光禄管山人过集分得春字","author":"孙继皋","text":"黄云惨白日，绿鬓悲青春。\n尊畔菊花老，梦中梅萼新。\n浮沉薄宦拙，出处贫交真。\n莫负天涯会，同为岁暮人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"彗经旬不灭","author":"孙继皋","text":"十月彗星见，亘旬光丈馀。\n银河不用扫，天意欲何如。\n避殿君王诏，登台太史书。\n杞人忧国泪，占夜几踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顾光禄管山人轩窗坐月分得生字","author":"孙继皋","text":"冬夜月仍满，入林疏影横。\n霜清薜荔色，雁度关山情。\n对酒兴难尽，披裘寒更生。\n故园丛菊在，寂寂照残英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送管山人之临清 其一","author":"孙继皋","text":"行人岁暮返，而汝独孤征。\n总惯无家别，非轻作客情。\n层冰岐路仄，落月大堤平。\n莫上高楼宿，应多哀雁声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送管山人之临清 其二","author":"孙继皋","text":"客久复行役，将因慰所亲。\n燕齐俱异路，冰雪未归人。\n水涸鱼龙苦，江寒豺虎新。\n贱贫何足问，君自慎风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小至 其一","author":"孙继皋","text":"今日日以短，明日日以长。\n长短互相催，一阴与一阳。\n浮云乱白日，倏忽东西翔。\n百岁苦易盈，何况生难量。\n金貂岂不贵，朱绶岂不扬。\n荣华等朝芳，夕散纷以戕。\n南山有松桂，冰雪交青苍。\n当窗读古书，可以终徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小至 其二","author":"孙继皋","text":"徜徉岂不好，乞身苦不早。\n江湖莽荆棘，豺虎伏中道。\n长星亘璧月，光芒下欲扫。\n群公上封事，天子夕露祷。\n小臣解忧国，涕泪亦盈抱。\n以兹坐蹉跎，安能不终老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小至 其三","author":"孙继皋","text":"老至会有时，吁嗟亦何为。\n吾年未三十，鬓发冰霜欺。\n寒灰半夜动，客心难自吹。\n转念线欲添，翻令愁欲丝。\n去住两踯躅，风光正迟迟。\n明发书云物，丰年以为期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"精卫","author":"孙继皋","text":"精卫精卫，朝衔西山木，暮衔西山石，去填东海头。\n东海常年流，吁嗟，东海之流有时尽，只恐西山一日化为海水何时收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送狄明府之官交河","author":"孙继皋","text":"郎官新出宰，早晚下滹沱。\n古渡层冰壮，荒城积雪多。\n君才元慷慨，民俗亦悲歌。\n预想鸣琴暇，能无剑客过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"应制题春景图","author":"孙继皋","text":"春草接堤平，晴湖抱槛明。\n远山花作障，纡岸柳为城。\n树杪疏篱出，流边古渡横。\n依依岚翠积，冉冉野烟生。\n地似桃源胜，人疑剡曲行。\n披图皇览洽，一慰豫游情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人日同李明府张上林顾光禄万吉士管山人集沈太史宅得妃字","author":"孙继皋","text":"雪后西山带落晖，天涯尊酒暂相依。\n人逢七日遗新胜，客为经年感敝衣。\n何事周南淹太史，却怜汉苑妒明妃。\n春风吹遍千杨柳，尘世沧江有是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正月十一夜同陈明府诸君集王鸿胪彦贻宅分得江字即席作","author":"孙继皋","text":"灯火动春光，酣来月过窗。\n世情悲白发，吾意忆沧江。\n肯惜金尊百，难逢玉舄双。\n何年五株柳，共系钓鱼艭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又得潮字","author":"孙继皋","text":"岁序何磅礴，宦情转寂寥。\n相逢不醉饮，其奈此良宵。\n夜筑当风壮，春灯带月骄。\n乡心与羁思，同入大江潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张殿读之南司成","author":"孙继皋","text":"几岁谈经傍日边，新恩仍许石头传。\n衣冠太学诸生候，礼乐中兴圣主年。\n幄帐春风花半拂，桥门夜月璧双圆。\n师臣讲席多同异，不似扬雄只儗玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题云水奇踪卷","author":"孙继皋","text":"兴以名山发，游因汗漫奇。\n偶随流水去，时与白云期。\n高士吾能传，如君世所师。\n肯同垂钓者，名姓使人疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐光禄挂冠还荆溪","author":"孙继皋","text":"白首轻微禄，清时早乞身。\n挂冠辞汉月，归棹及王春。\n世事深杯得，閒情倦鸟亲。\n无劳买山隐，家在五湖滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送谈参军免官还吴","author":"孙继皋","text":"孤帆落日去何迟，细草长烟满路岐。\n燕地故应销骏骨，汉宫元不妒蛾眉。\n千花黯黯春辞幕，片月盈盈夜堕卮。\n最是主恩宽放逐，五湖容易乞垂丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花朝后一日王彦贻黄清父姜固孟同集枣轩分得欢字","author":"孙继皋","text":"月引谈天兴，春留卜夜欢。\n柝声沉远戍，花信怯馀寒。\n梦自依温树，游堪理木兰。\n平生去住意，寥落为君弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二月十五日雨中同黎参议欧博士顾典客顾舍为钟丈人人沈进士黄文学永上人集王鸿胪宅得风字","author":"孙继皋","text":"相逢春正中，为客几春风。\n细雨飞觞白，秾花落烬红。\n世情吾自厌，狂态尔谁同。\n不见芳菲色，年年没汉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顾廷评汝和奉使滇南","author":"孙继皋","text":"金函飞诏出彤墀，玉节乘春四牡驰。\n五尺风烟秦道路，千山草木汉旌旗。\n天威合下蛮夷拜，使指无烦老父疑。\n异日词臣能奏赋，甘泉元有碧鸡祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]