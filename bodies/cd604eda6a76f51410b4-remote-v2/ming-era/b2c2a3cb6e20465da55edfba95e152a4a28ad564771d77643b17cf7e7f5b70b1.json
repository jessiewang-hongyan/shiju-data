bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"胡原节升大理乡复巡视浙江索诗赋四绝句 其四","author":"杨士奇","text":"行李萧萧去住轻，霜台柏府旧驰声。\n须教一道吴江月，照见中流彻底清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3355,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送萧雅容受诰后归省 其一","author":"杨士奇","text":"新着香罗綵绣衣，文江江上省庭闱。\n龙章五色金为笥，亲捧皇恩万里归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3356,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送萧雅容受诰后归省 其二","author":"杨士奇","text":"夏官初满擢天官，文武铨除职任难。\n谁似江西萧佛子，清如冰雪万人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3357,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送萧雅容受诰后归省 其三","author":"杨士奇","text":"京国相逢意共亲，心如秋水气如春。\n同朝同郡兼同调，二十年来见几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3358,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送萧雅容受诰后归省 其四","author":"杨士奇","text":"玉露漙漙下翠梧，蓟门携手惜离居。\n娱亲想及重阳节，酒汎黄花脍白鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3359,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过滁州马上口号寄陈廷器","author":"杨士奇","text":"长忆礼闱同事日，锦筵官烛夜论文。\n过城不见匆匆去，回首滁山隔片云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3360,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜宿池河梦颐庵","author":"杨士奇","text":"久别豫章胡祭酒，夜来梦见鬓星星。\n颇闻药裹今抛掷，应是文章属老成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3361,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"授散官 其一","author":"杨士奇","text":"五载金门为学士，朝来初降散官恩。\n幸因近侍沾荣命，犹胜超迁典大藩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3362,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"授散官 其二","author":"杨士奇","text":"二十年中六改官，论思匡辅古来难。\n不才未有涓埃报，徒切区区抱寸丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3363,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送崇厚归乡 其一","author":"杨士奇","text":"君家兄弟联双璧，馆阁怀归次第归。\n想见吉阳秋雨霁，江天鸿雁一行飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3364,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送崇厚归乡 其二","author":"杨士奇","text":"眼看科第擢英髦，又见南飞逸翮高。\n多病无能留滞者，秋风相送使心劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3365,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠人归南京","author":"杨士奇","text":"紫垣东畔词臣署，曾种琅玕万个清。\n一上金台二十载，看图长是忆南京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3366,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题乐山乐水二图 其一","author":"杨士奇","text":"岱岳巍巍万古青，奠安东国拱神京。\n出云为雨润天下，坐契仁人四海情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3367,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题乐山乐水二图 其二","author":"杨士奇","text":"为涧为河万折东，周流无滞更无穷。\n道人胸次涵流动，乐与宣尼川上同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3368,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书解大绅作其兄墓铭哀诗后 其一","author":"杨士奇","text":"少年兄弟同金榜，一日声名四海闻。\n更赐同归侍亲老，全家稽首戴天恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3369,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书解大绅作其兄墓铭哀诗后 其二","author":"杨士奇","text":"红芳庭馆紫垣阴，对酒论文夜向深。\n三十馀年如昨日，埋铭一诵一伤心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3370,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书解大绅作其兄墓铭哀诗后 其三","author":"杨士奇","text":"新诗字字皆愁痛，不待劳心苦思成。\n扬子江波深不极，未知难弟忆兄情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3371,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄示东城诸侄 其一","author":"杨士奇","text":"不才无计谢朝簪，流水年光七十三。\n盘古螺湖松柏地，梦魂夜夜到江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3372,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄示东城诸侄 其二","author":"杨士奇","text":"叨禄京华四十年，老来一念在归全。\n故乡无限佳山水，何处松楸著墓田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3373,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄昌平吴典史 其一","author":"杨士奇","text":"为问昌平吴典史，到官民事近如何。\n清时雨露涵濡厚，想见丰年黍稌多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3374,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄昌平吴典史 其二","author":"杨士奇","text":"已闻赞县清如水，廨宇萧条日掩关。\n简牍劳勤莲幕下，未应拄笏对青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3375,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送萧大庆之官始兴 其一","author":"杨士奇","text":"始兴庾岭南边邑，博士之官喜过家。\n广海年来多驿使，缄书频遣慰京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3376,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送萧大庆之官始兴 其二","author":"杨士奇","text":"县邑西连丹凤山，行藏有道听皇天。\n瘴烟毒雾皆休惑，忠简新州十八年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3377,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题萧德赞竹","author":"杨士奇","text":"昔年曾作萧斋客，绕槛毵毵翠玉枝。\n犹记凌云轩上坐，清风远道倍相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3378,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题萧德赞山水 其一","author":"杨士奇","text":"昔年曾借萧斋住，流水桃华尽日閒。\n读罢黄庭更何事，石台散发看青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3379,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题萧德赞山水 其二","author":"杨士奇","text":"一去京华三十春，乡山万里梦归频。\n山中尚有平生侣，应见题诗忆远人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3380,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题萧本器竹 其一","author":"杨士奇","text":"爱尔清淳比玉琳，青春黄卷好留心。\n林间石畔无尘事，一寸光阴直万金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3381,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题萧本器竹 其二","author":"杨士奇","text":"尔家潇洒自天台，山绕溪楼石作台。\n老我会扶苍玉杖，寻幽重度葛陂来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3382,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题山水与彦实侄","author":"杨士奇","text":"翠岭岧峣带白云，林间溪畔绝纤氛。\n须知乐志堂中坐，长日书声到夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3383,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题刘梓人竹","author":"杨士奇","text":"满林淇玉翠纷纷，白日苍苔夐绝尘。\n好近五云洲畔住，翛然閒作太平民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3384,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"酬友人寄酒","author":"杨士奇","text":"洞庭春色出黄柑，远致何由共一欢。\n感荷多情王刺史，独惭彭泽未休官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3385,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过习礼检讨家观菊不遇留三绝句 其一","author":"杨士奇","text":"花开只在屋西头，常待看花散旅愁。\n人事已閒天意好，无边晴景属清秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3386,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过习礼检讨家观菊不遇留三绝句 其二","author":"杨士奇","text":"短短垣墙不作篱，傍檐背日故开迟。\n好花正不论先后，无事频来坐少时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3387,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过习礼检讨家观菊不遇留三绝句 其三","author":"杨士奇","text":"昔者柴桑早去官，悠然把菊对南山。\n若缘五斗能留住，也到花时未得閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3388,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邹侍讲以诗问钱检讨索菊而仆以诗并骑邀之 其一","author":"杨士奇","text":"一室閒居俗虑清，题诗问菊见高情。\n何如解带花间坐，莫负秋晴送马迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3389,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邹侍讲以诗问钱检讨索菊而仆以诗并骑邀之 其二","author":"杨士奇","text":"邻菊初花粲可观，花前棋局足盘桓。\n寻常无事宜来数，即过城东来却难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3390,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"习礼惠菊以诗谢之并邀同赏 其一","author":"杨士奇","text":"萧散高情绝世稀，秋清分送菊花枝。\n清香正色明窗下，自与幽人晚岁宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3391,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"习礼惠菊以诗谢之并邀同赏 其二","author":"杨士奇","text":"一旦秋芳粲满家，黄金耀日十三葩。\n何妨拂袂来同看，门外青帘酒可赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3392,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"子启学士见过仆适他出不遇奉简","author":"杨士奇","text":"病来愁坐愁无那，强为寻医暂起行。\n寄谢玉堂曾学士，高轩相过不相迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3393,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"子启见和再用韵奉简","author":"杨士奇","text":"东里何如西墅清，广庭深巷足閒行。\n近栽杨柳高于屋，况复新来少送迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":3394,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]