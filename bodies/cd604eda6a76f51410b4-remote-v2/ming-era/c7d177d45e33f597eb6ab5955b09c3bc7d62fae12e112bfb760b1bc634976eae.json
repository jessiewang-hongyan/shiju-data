[{"title":"望湖亭三首 其三","author":"王樵","text":"垂杨流水石桥，白马青衫来路。\n有人指点凭栏，当喜相期不误。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"翠华岩七真洞","author":"王樵","text":"似我华阳洞，何时住七真。\n问僧僧不语，为拂石床尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乐哉行赠胡汝原佥宪之颍","author":"王樵","text":"乐哉胡公之有亲，相随看尽长安春。\n双受鸾封俱未老，躬拜瑶墀雨露新。\n盛事稀逢人共羡，八月开筵对归雁。\n上寿新峨獬豸冠，玺书捧下麒麟殿。\n颍水春风爱日迟，佳游清赏雅相宜。\n遥知侍奉多欢乐，好就银袍作綵衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别叶一沙司训","author":"王樵","text":"平原驿前征马嘶，御河东畔柳垂堤。\n半载情分三夕话，君向西江我向齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋日同吴霁寰副宪张瑞泉周中槐二佥宪登会波楼","author":"王樵","text":"独带斜阳来北郭，不知明月出东山。\n翠浮华顶烟初敛，绿满平畴水自环。\n正喜一登皆在目，未辞屡到即忘还。\n赋成却愧非王粲，诸老高名岂易攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李北山殷棠川来访小酌于寅宾馆承台中诸大夫翩然来过即席赋得青字赠北山北山云不到历下十年矣在西曹时北山曾以居相假","author":"王樵","text":"虚堂遥挹历山青，坐对金华两使星。\n四海故交逢此夜，十年乡梦忆重经。\n多君京国书连屋，借我幽居花满庭。\n人得良欢须尽醉，诗成莫放酒杯停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登岱岳二首 其一","author":"王樵","text":"宫阙逼虚清，千山雪献晴。\n徂徕如拜頫，汶泗故回萦。\n五夜金波㴸，三秋海日生。\n晏温秦观晓，独对紫霞明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登岱岳二首 其二","author":"王樵","text":"何事生天地，终年只蔀藏。\n我行似黄鹄，一举见员方。\n拱挹惟嵩华，朝宗有太行。\n身疑凌倒景，视下亦苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕","author":"王樵","text":"尘事俄消日，他乡亦作年。\n功名惭镜里，儿女且灯前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德藩招宴连珠泉沼汎舟","author":"王樵","text":"淑气回梁苑，光风动习池。\n地中琼玉溅，坐上斗星移。\n转舫周三岛，徵歌按四涯。\n夜深仍水殿，待月水中坻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长清道中二首 其一","author":"王樵","text":"有意空三载，无才补一官。\n早休诚我分，决去为谁难。\n盘谷终归李，荆州且识韩。\n几回亭舍晚，便作故山看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长清道中二首 其二","author":"王樵","text":"我忆茅山下，营居碧树团。\n饱书堪万卷，睡日到三竿。\n有用心常乐，无挠梦亦安。\n何如风雪道，只跨旧征鞍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌夜飞","author":"王樵","text":"乌夜飞，游子尚未归。\n岁将晚矣行侣稀，草头露湿裳与衣。\n心百碎，力已微。\n好为人尽不愿馀，青山白云期屡违。\n胡不归，青山不求汝是，白云不责汝非。\n乘车而瘦，何如徒步而肥。\n以忧易饱，不如乐而忘饥。\n前有誉兮，不如后无讥。\n坐消白日光晖晖，诗书空束囊与?。\n胡不归，无若迷乌失树，黄昏向人屋里飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣怀兼怀姜凤阿内翰二首 其一","author":"王樵","text":"浅疏难应俗，忧喜只随人。\n到处身如寄，何时我是真。\n兴来还自败，老去欲谁亲。\n回首高阳里，荀家有二仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣怀兼怀姜凤阿内翰二首 其二","author":"王樵","text":"君本同心友，相期到处同。\n调官先梦兆，分袂忽西东。\n剑阁风初煖，瞿唐雪正融。\n几时行部遍，有信及征鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出门二首 其一","author":"王樵","text":"素无出门缘，少得称意时。\n亦欲勉为好，随复有败之。\n长短不相补，事过然后思。\n安能免悔吝，空自长嗟咨。\n缅怀古至人，婉婉静女姿。\n动静无留阂，铅朱得所施。\n悠然游于世，诚哉丈夫师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出门二首 其二","author":"王樵","text":"人生亦何贵，但得与人平。\n失意难为妍，乘时易为名。\n无情任去来，爱彼水上萍。\n依依夕风起，淡淡春波生。\n美如耳馀交，恶如黡泽争。\n事奇终有反，不如退为荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别山东父老","author":"王樵","text":"疾病思吾土，逢迎负尔曹。\n六条除悍吏，三尺剪名豪。\n赤子才安席，苍鹰莫解绦。\n扁舟予日远，回首岱云高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"承赵江都阳溪子寄示登金山见怀之作聊成短歌奉答","author":"王樵","text":"海门兮长风，中流兮孤屿。\n怀美人兮何方，览大江之东去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送客入郢寄讯高鹿坡旧曹长二首 其一","author":"王樵","text":"尚子平生足胜游，有怀惟是岳阳楼。\n先忧后乐今谁与，月白天空江水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送客入郢寄讯高鹿坡旧曹长二首 其二","author":"王樵","text":"赤壁轻风放船好，兴来谁复碧萝前。\n洞箫吹月夜如昼，孤鹤横江秋满天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"窦灌行","author":"王樵","text":"窦灌守穷交，意气相引重。\n岂知种瓜人，不作东陵梦。\n生平百战心，轻为一朝用。\n东邻车马阗，西邻箫鼓唝。\n无嗔亲戚往，自忍鱼鳅弄。\n北溟云涛兴，不由汝操纵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十六日洮湖泛月","author":"王樵","text":"月届今宵望，圆殊昨夜看。\n澄湖秋万顷，涌出紫金槃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋大江观月","author":"王樵","text":"空江远与天接，月影荡若金虬。\n一叶波凌万顷，平生无此中秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长平公主歌","author":"王樵","text":"不相梦为奴与侯，时来不求富贵，富贵端相求。\n不相梦为奴与夫，身大将军，姊为皇后青，非昔青夫岂用奴。\n君不见艾窦太主庖人，偃生霍将军、冯子都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠华阳道者","author":"王樵","text":"华阳真人坐菊斋，一觞还对菊花开。\n丹霞满面双瞳碧，笑阅人间几去来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别黎正郎","author":"王樵","text":"十七年前同五品，清时雅望属夫君。\n相逢不忍重言别，他日临风思故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"简许邑侯","author":"王樵","text":"泰道转初阳，生朝遇履长。\n周南歌福禄，汉史志循良。\n好雨关农喜，东风卜岁穰。\n君侯多种德，何异古桐乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜许侯内召歌","author":"王樵","text":"义门郑氏称浦江，儒门许氏称东阳。\n潜德徐开道脉长，吾侯早发应文昌。\n有道施为自不常，两邑爱戴如桐乡。\n吾邑阴多召伯棠，花种河阳满县香。\n父老时登节爱堂，兕觥称寿祝无疆。\n共言仁政天降康，侯德难酬矢不忘。\n本由婺女星降祥，玺书徵召简贤良。\n侯今执法紫微旁，香案从容侍玉皇。\n青琐对拜称夕郎，兰台簪笔推南床。\n侯才八面皆可当，一朝建白惊四方。\n指陈大计何琅琅，尽将民隐达岩廊。\n坐令斯世跻虞唐，谟烈长垂青史光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"祭祖乐章三首 其一 初献","author":"王樵","text":"于惟王氏，代有令人。\n春寿胜义，不事污君。\n戊申圣作，宇宙更新。\n诚斋快睹，饮水衔恩。\n伯兄不吊，误挂吏文。\n击鼓上书，远叩天阍。\n帝曰俞哉，事竟报闻。\n抚其遗孤，三世不分。\n付以筦钥，让以藏金。\n爰有文子，一德同心。\n积善馀庆，及我后昆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"祭祖乐章三首 其二 亚献","author":"王樵","text":"兴衰之效，于古有徵。\n恒由浑厚，以开文明。\n文明既开，浑厚渐失。\n谓偶可常，至于骄佚。\n溯流知源，先祖是思。\n凡我后人，敬而听之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"祭祖乐章三首 其三 终献","author":"王樵","text":"宗人来止，其萃如云。\n祖考视之，其初一人。\n分形连气，有百其身。\n孰谓同宗，可不同心。\n愿言不昧，祖考如临。\n岁时休享，常我顾歆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为戊三侄题秋林图","author":"王樵","text":"读书结屋爱秋林，为有清幽可赏心。\n一种天香有时发，庭前丹桂五枝深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿族人夫妇六十","author":"王樵","text":"百年逢转甲，九月两长庚。\n巳尽田家乐，不求身外名。\n仙源通句曲，瑞气接荆城。\n会见骑黄鹤，吹箫作凤鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼殇","author":"王樵","text":"残冬沴气盛流行，但听家家哭子声。\n固是适来须有去，如何我辈独钟情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题","author":"王樵","text":"尧夫花外车还到，茂叔庭前草自春。\n长者幸迂陈孺驾，交情不是翟公门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洮湖纪兴 其一","author":"王樵","text":"涪山黛色映中流，月夜乘槎到上头。\n惊起山僧移短屐，相从岩洞访丹邱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洮湖纪兴 其二","author":"王樵","text":"西对三茅意自閒，谁知湖外有青山。\n小楼堪筑平沙上，两面回看兴未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洮湖纪兴 其三","author":"王樵","text":"几向湖边看日出，湖光山色两悠然。\n力耕把钓堪终老，也有滨湖数顷田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读书别业 其一","author":"王樵","text":"课农课子挟遗编，随处维舟杨柳边。\n相逢倘有人相问，不是米家书画船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读书别业 其二","author":"王樵","text":"山人何事爱林居，西陌东阡任所如。\n妙思还从个中得，不须象罔索玄珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同达观上人过城东别墅","author":"王樵","text":"师来南岳意犹勤，指点真如显法门。\n几度临流话心处，夕阳烟水一孤村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题于见素南园","author":"王樵","text":"堂开绿野水平矶，槛阁通幽花满蹊。\n波淡淡时鱼或跃，柳阴阴处鸟于飞。\n坐逢嘉话杯行速，月爱清辉客散迟。\n从此芙蕖红十里，不妨随到有新题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡淮寄内","author":"王樵","text":"夫妇于今兮各白头。\n嗟我中路兮复远游。\n感子送我兮意绸缪。\n手整衣裳兮与衾裯。\n昨夜秋风兮淮水陬。\n睹物兴怀兮涕交流。\n昔日相从兮此停辀。\n往返再经兮罹百忧。\n今我单行兮子独留。\n淮水之长兮我思悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元旦试笔偶成","author":"王樵","text":"嘉靖乙未岁，吾方十五龄。\n先君初谢政，兄弟同在庭。\n过庭奉严训，讲求惟六经。\n丁未登仕版，二亲尚康宁。\n前后五十载，三朝逢圣明。\n岁复当乙未，言归忝六卿。\n肯搆有仲子，新宫适已成。\n移居理旧业，耳目仍聪明。\n灯下能细书，蚤起鸡才鸣。\n平生寡嗜好，天假此性灵。\n六经毕其四，匪希身外名。\n旷世有相感，吾师在考亭。\n何如汉王吉，三世传其清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕 其一","author":"王樵","text":"久晴不厌雨濛濛，一枕清酣到夜中。\n睡起呼灯聊试笔，新诗书罢始闻钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕 其二","author":"王樵","text":"蚤探春信到梅花，夜静无风气候佳。\n依旧衡门飞燕子，留台御史近还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕 其三","author":"王樵","text":"书灯不剪两重花，气候清和雨也嘉。\n七十六巡新甲子，又看箫鼓闹邻家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春前得雪雪后喜晴","author":"王樵","text":"残冬见微霰，大雪降春前。\n喜得四时正，不忧三等田。\n况逢人谷日，开出艳阳天。\n汉室勤农诏，应须到日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄白下相知","author":"王樵","text":"坐卧蘧然在一堂，萧萧深竹对幽窗。\n如何尚作留都梦，寤寐高贤义不忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慰克加侄","author":"王樵","text":"百年容易尽，何事苦劳形。\n骨健神相守，心虚体自平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"示子孙","author":"王樵","text":"人生忌安逸，清时无幸民。\n士当勤读书，农当力耕耘。\n实益在勤俭，实修在天伦。\n未有天伦厚，人或忘其根。\n慈父生孝子，孝子生慈孙。\n慈孝匪相报，末茂本之深。\n人有亲中贤，尊贤且亲亲。\n亲贤得其所，其道并相惇。\n禹不贵尺璧，而乃惜寸阴。\n太康坠厥绪，逸豫乃其因。\n吾产诚已薄，吾志良亦勤。\n事欲得其继，言欲传其心。\n心传吾不死，望尔后之人。\n愿毋听藐藐，负我诲谆谆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同紫柏上人出郊奉赓法语 其一","author":"王樵","text":"不空宁有妙，诸妙本来空。\n落日云光里，茅山翠几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同紫柏上人出郊奉赓法语 其二","author":"王樵","text":"本来原不染，净是子孙缘。\n大道无名字，太和宇宙间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感兴","author":"赵完璧","text":"淳风不可挽，大道成微茫。\n椒兰不自保，恶榝以充囊。\n自爱琼佩姿，期以扬清芳。\n美人改中路，徒此明月光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻慎修两台交荐","author":"赵完璧","text":"顾我寡昧子，庸庸何所长。\n祇有一寸心，可以昭夜光。\n藏息良有由，持赠美人傍。\n念此蹇修理，爱惜以崇芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"笼鸟叹","author":"赵完璧","text":"山鸟胡不幸，罹此樊笼中。\n啄不获野田，栖不及深丛。\n梳翎背旭日，垂翅当寒风。\n徒抱旷逸怀，侧目云霄鸿。\n祇缘笙簧音，乃滞幽囚穷。\n嗟嗟耳目娱，盍以物我通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜书怀","author":"赵完璧","text":"新月衔寒山，北风下檐楹。\n羁人夜秉烛，孤坐远含情。\n渺渺海山曲，依依凤凰城。\n禄薄十口饥，官卑一身轻。\n印绶钳铁坚，风尘魂梦惊。\n枳棘忍自栖，盐车向谁鸣。\n舞剑尚馀辉，弹琴不成声。\n赖有杯中物，啸歌仰太清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月林遗酒西台感赋","author":"赵完璧","text":"故人遗我酒，我悲故人心。\n故人不可见，使我愁思深。\n画地谁能违，刻木威难禁。\n烟霜夜凄凄，鸿雁秋沈沈。\n衣葛当北风，餐荼绝衷肠。\n怨艾去祸胎，今古归福堂。\n把酒且自饮，淋洗郁冤伤。\n嗟嗟同心人，剪烛今何方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜感怀","author":"赵完璧","text":"高斋夜独坐，寂寂银蟾生。\n疏檐素影下，閒阶秋水明。\n冷光侵我体，清辉怡我情。\n独酌不成醉，幽吟无与赓。\n坐久静不寐，松风落寒声。\n悠悠东山下，岁晚沈高名。\n拔剑自抚拭，咄唶空悲惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮马长城窟行","author":"赵完璧","text":"饮马长城窟，马渴饮不巳。\n马饮良易足，我怀当何止。\n畴昔离故乡，淹淫几万里。\n明月缺复圆，边声日充耳。\n精魂绕天涯，日夜邈伊迩。\n仰天不可呼，归鸿背我起。\n燕然勒几时，大刀难自揆。\n一身寄他人，未保生与死。\n横颐断肠泪，堕落长城水。\n长城水不竭，离情不终歇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弃妇辞","author":"赵完璧","text":"弃妇出兰房，长辞薄倖郎。\n忆昔授绥曰，合卺双鸳鸯。\n相为琴瑟欢，宜室期馀光。\n自君荡春心，嬖爱章台倡。\n冶容盲尔明，荆布成恶裳。\n娇歌褫尔魄，沈默非巢簧。\n销神复索家，顾谓邂逅良。\n劬劳敬克室，反目卒为殃。\n子为邪孽迷，妾为君子伤。\n贱妾不足惜，古道孤肝肠。\n泪出身亦出，请试倡短长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代鹤言","author":"赵完璧","text":"元化泄灵淑，产此神异姿。\n皓洁焕冰彩，不杂尘埃缁。\n啄慊四海云，九霄惟所之。\n忘机天壤间，何意虞罗欺。\n铩我紫氛羽，剧我青田思。\n垂翅鸡鹜群，矫首燕雀嗤。\n良玉污涂泥，仙格奴隶司。\n昔为青云器，今为粪壤遗。\n郁郁寥廓抱，依依知者谁。\n开此含丹睛，迹滞无异窥。\n胡为作近玩，养翮以前期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"静宁晓发","author":"赵完璧","text":"晓出静宁郭，山川郁苍苍。\n初日韬玄霞，凄风下崇冈。\n铅花肃寒色，岚气昏朝光。\n山木涵烟古，云泉嗽石凉。\n我车亦何之，高谊图忠良。\n日短不遑食，暮夜成仓皇。\n空谷越营魂，冷候嗟薄裳。\n遥途力应踬，修坂马玄黄。\n鸿雁声嗷嗷，望之思渺茫。\n飘飖迥不见，横涕知几行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]