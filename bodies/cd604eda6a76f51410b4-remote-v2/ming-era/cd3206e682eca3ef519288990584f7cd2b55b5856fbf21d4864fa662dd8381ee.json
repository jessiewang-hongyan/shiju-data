[{"title":"入太和山游道院作 其二","author":"区大相","text":"秋山行不尽，望望意何穷。\n飞观疑无地，悬崖似挂空。\n人行碧雾里，鸟语青林中。\n多谢神仙侣，邀予芳桂丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入太和山游道院作 其三","author":"区大相","text":"淩晨石路开，披磴陟丹台。\n素女焚香去，青童捧药来。\n岚飞时作雨，涧响忽成雷。\n今日关门吏，重瞻紫气回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入太和山游道院作 其四","author":"区大相","text":"谷转迷丹洞，山分出石关。\n人疑骑鹤至，客似御风还。\n天乐行相引，琪花坐可攀。\n松间拜真老，从此谢尘寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入太和山游道院作 其五","author":"区大相","text":"怀仙复问玄，倚岫且听泉。\n深谷时穿地，长林共隐天。\n鸾书裁一纸，鹤语已千年。\n惆怅观棋客，胡为牵世缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"共题李仲贞隐居 其一","author":"区大相","text":"满园花共竹，即是洞仙家。\n门对沧浪水，林开嵾上霞。\n有官寻白社，未老学丹砂。\n更拟淮南曲，知君心赏遐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"共题李仲贞隐居 其二","author":"区大相","text":"门闭碧溪头，山光映水流。\n竹间书屋小，桥畔草亭幽。\n静爱林中卧，闲寻物外游。\n自嫌黄绶俗，情为白云留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"均州王守招游沧浪亭","author":"区大相","text":"混混复磷磷，孤亭水石滨。\n浊时因潦汩，清处见天真。\n旅望凭高尽，渔歌入兴新。\n祇疑浴波鸟，犹是濯缨人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"襄阳仲宣楼","author":"区大相","text":"漂泊依刘日，悲凉作赋年。\n无家浮汉水，有客忆秦川。\n乡国浮云外，江湖落雁前。\n逢时虽异感，怀土共凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将访鹿门","author":"区大相","text":"耆旧人何在，躬耕尚土风。\n风尘违跃马，江汉有冥鸿。\n陇亩情终在，丘园道不穷。\n扁舟从此去，回首见隆中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"习家池","author":"区大相","text":"闻道襄州好，高阳乐事多。\n山公来对酒，时听接䍦歌。\n台迥丛车马，池清照绮罗。\n徘徊抚陈迹，日暮汉江波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自荆门放舟晓霁作","author":"区大相","text":"新晴天气好，况在楚江秋。\n岸迥晨烟敛，山门晓树稠。\n沙禽随棹散，浦日共萍浮。\n羁思方无已，劳歌慰远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登岳阳楼望洞庭","author":"区大相","text":"湖阔天为水，楼高地出城。\n日光随镜满，帆势与云平。\n梦泽晨烟积，湘潭夜雨生。\n凭轩问舟子，归棹杳何征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日长沙","author":"区大相","text":"湖外今为客，方知气候分。\n地秋翻畏湿，江晚更蒸云。\n且拟浮湘作，休传吊屈文。\n就中多胜事，兰芷最思君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至湘潭访唐吏部同年","author":"区大相","text":"闻君休假日，闭户湘江深。\n偶尔便高卧，翻然惬远寻。\n莫因佳水石，遂欲久山林。\n长路亦何赠，殷勤白芷吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡湘川","author":"区大相","text":"湘南有归客，日暮渡湘川。\n征路尚馀几，乡心犹渺然。\n佳期芳杜外，远思绿江前。\n为问衡阳雁，苍梧何处边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九月八日何太守梁节推邀游合江亭","author":"区大相","text":"衡南秋更好，过客赏心并。\n风物重阳近，江流双练明。\n何年开胜会，此地集儒英。\n晚发临湘咏，千秋水石清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"`\t湘南旅思","author":"区大相","text":"客行犹未已，乡思苦无悰。\n棹倚啼猿岸，书停回雁峰。\n江声寒水落，松色晚烟浓。\n明发南征路，关山尚几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衡阳山家作","author":"区大相","text":"山村八九月，茅屋两三家。\n古道连枫叶，闲门落桂花。\n竹深鸡犬静，松暝炊烟斜。\n已似到田舍，犹嫌归路赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题临溪村舍","author":"区大相","text":"丹林间绿筠，溪路静无尘。\n枫岸谁为客，桃源即主人。\n饭香炊晚稻，酒熟斫鲜鳞。\n欲起临溪阁，还家隐钓缗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬寅元日使归家园作","author":"区大相","text":"正旦迎祥始，王春布令初。\n幸逢新岁月，言返旧田庐。\n帝祝无疆历，人看大有书。\n频年困徵敛，兹岁复何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侍御弟江洲园亭","author":"区大相","text":"台臣归卧蚤，偃息惟林园。\n得遂隐贤操，知为明主恩。\n小桥通柳径，深竹閟萝轩。\n虽共渔樵侣，幽怀未遣论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四兄方池内新构水亭 其一","author":"区大相","text":"隔浦望溪林，新亭冒绿浔。\n捲帘山在眼，过槛水澄心。\n时散竹间帙，闲调池上琴。\n更饶濠濮兴，鱼乐共幽深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四兄方池内新构水亭 其二","author":"区大相","text":"步入小桥去，方欣与俗暌。\n亭高云作幔，池满水如圭。\n鸟狎频移树，花浓不辨蹊。\n宁知远尘事，不是学幽栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孝兼四兄侍御七弟携侄自?川舟来约游西樵 其一","author":"区大相","text":"蚤发?东兴，春深始买舟。\n仍携竹林赏，来及棣华游。\n鹤蕊青岩丽，蒲香碧涧幽。\n名山多夙契，云卧共丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孝兼四兄侍御七弟携侄自?川舟来约游西樵 其二","author":"区大相","text":"我家?水北，高卧樵山西。\n日出东峰望，天清云树齐。\n将期炼金液，思欲淩丹梯。\n明泛桃花水，知无川路迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同四兄七弟泛舟海上望西樵 其一","author":"区大相","text":"海上望松关，苍茫云雾间。\n长风吹瀑水，飘落万重山。\n碧草通仙径，琪花待客攀。\n此时挂帆去，应得御风还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同四兄七弟泛舟海上望西樵 其二","author":"区大相","text":"七十二芙蓉，仙家第几峰。\n天清揽黛色，秀出海云重。\n地与蓬瀛接，人将鸾鹤从。\n此行若结宇，何异三茅踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻白云洞","author":"区大相","text":"春山饶胜事，花水足清芬。\n传道溪头寺，来寻洞口云。\n茗园春雨过，松径夕流分。\n虽复通人境，犹疑閟鸟文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵山行作 其一","author":"区大相","text":"樵山正可樵，石路上岧峣。\n复值观棋侣，同聆伐木谣。\n云垂接羽盖，虹起蹑天桥。\n自有淹留处，无烦折桂招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵山行作 其二","author":"区大相","text":"逍遥彩云际，窈窕春山阿。\n灌木见垂葛，孤村闻伐柯。\n烟霞尘事少，水石野情多。\n若问东山意，其如风月何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿石泉山中","author":"区大相","text":"空山惟习静，身世两相捐。\n春草芳夕渚，风潭鸣暗泉。\n云清独鹤梦，月照幽人眠。\n永夜结霞想，长吟待曙烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大科峰是西樵绝顶","author":"区大相","text":"登高四望开，绝顶出瑶台。\n远岫一方缺，长江数道来。\n云间下鸾鹤，天上扫莓苔。\n高揖烟霞外，三山何处哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"逢樵者讯云端锦岩","author":"区大相","text":"樵岭问樵夫，仙源路有无。\n几人松下老，若个谷中愚。\n古桂应谁折，新桃定数株。\n幽寻若可结，携手白云衢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至云端村","author":"区大相","text":"鸡鸣云外岫，犬吠谷中村。\n问竹才通径，看松忽到门。\n春潭千丈瀑，仙茗百年根。\n坐待主人出，相邀农圃言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"锦岩有铁泉庵旧址云端父老劝予卜筑于此","author":"区大相","text":"铁泉旧精舍，还见铁泉流。\n问讯锦岩胜，知为云水幽。\n居然异村舍，相劝卜林丘。\n且共区中赏，何劳方外求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵山中寄示梁少仲黎君玺兄弟兼答龚文学","author":"区大相","text":"扁舟泛云海，爱此樵湖春。\n缥缈度松壑，逍遥离俗尘。\n山如采芝岭，水似种桃津。\n君看烟霞路，应无朝市人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归自西樵梁少仲黎君玺龚岸文过问经游之胜","author":"区大相","text":"自得丘中赏，难为世上传。\n千家带乔木，百道响流泉。\n竹引青龙过，花邀白鹤眠。\n君非采樵客，安问斧柯年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山馆夏夜","author":"区大相","text":"馆静夜沉沉，闲阶捉扇吟。\n露光垂草尾，月影在花心。\n云作三峰古，烟绵一壑深。\n桃源未可往，桂树且招寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏夜独坐","author":"区大相","text":"缓步惜时芳，閒情逐夜凉。\n风声过竹爽，月色近花香。\n鱼噞闻幽沼，萤流度暗墙。\n留连未肯卧，琴曲遂能长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五月一日诸文士载酒邀泛江上颇具声乐","author":"区大相","text":"逢辰移桂棹，命赏接蒲觞。\n岸挟潮声上，江连雨色凉。\n兰香馀晚沐，莲唱倚新妆。\n已幸同舟载，休歌水一方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日家园宴","author":"区大相","text":"水绿鸳鸯浦，花明菡萏津。\n浴兰归省客，撷艾命闺人。\n蒲泛金尊满，丝缠玉臂新。\n晚凉珠箔动，随步起芳尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏月下采花","author":"区大相","text":"良夜采芳人，凝妆倚桂轮。\n月临花色艳，花助月华新。\n枝袅纤腰怯，香留小袖春。\n犹嫌多露处，盈手湿罗巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日与罗彦秀内弟江上泛舟","author":"区大相","text":"江风当夏清，与客放船行。\n岛屿烟中出，云霞水上明。\n林开朝雨霁，津阔晚潮平。\n桂棹方乘兴，菱歌且缓声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潖洲月下独泛","author":"区大相","text":"乘汐临芳渚，停桡弄晚霞。\n月华摇宝刹，星影落江槎。\n波送随流叶，风传出雾花。\n溯洄方未已，闲兴在蒹葭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛?川出三洲口溯大江至石洲登岸和四兄七弟 其一","author":"区大相","text":"落日晴川曲，悠然趣不穷。\n偶乘舟楫兴，还与弟兄同。\n山水存微尚，琴尊挹素衷。\n晚来清管发，时逐蓼花风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛?川出三洲口溯大江至石洲登岸和四兄七弟 其二","author":"区大相","text":"闲棹傍幽栖，泉香草复萋。\n稻畦蘋渚外，樵路竹林西。\n沙鸟晴偏浴，汀花净不泥。\n沿洄已可乐，况在故山溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛?川出三洲口溯大江至石洲登岸和四兄七弟 其三","author":"区大相","text":"乘流兴未已，摇楫大江清。\n晻暧前山望，留连后浦情。\n回樯依雁序，狎席恋鸥盟。\n今日仙舟上，谁知是弟兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将有江门之行维舟珠浦家兄舍弟自?川来会","author":"区大相","text":"朝来棠棣咏，恰与雁行期。\n海树寒烟断，江帆暮雨迟。\n昔人犹梦寐，吾道有埙篪。\n明发蘋洲上，应多访古思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟发五羊往江门途中有怀","author":"区大相","text":"以予迂且诞，书剑作良图。\n逐世方迷路，怀贤此问途。\n岸回平楚合，江阔晚帆孤。\n可叹无闻者，东南一竖儒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟泊江门周明府宴于嘉会楼","author":"区大相","text":"昔贤开教地，遗构倚江潭。\n文雅嘉兹会，儒风盛往谈。\n衣冠倾海内，山斗在天南。\n今日弦歌宰，芳筵更合簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊白沙里","author":"区大相","text":"黄云紫水路，翠竹白沙村。\n后进犹题里，前贤多及门。\n凤麟游已远，羔雁礼空存。\n侧想文明代，师臣久不论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白沙谒陈先生祠 其一","author":"区大相","text":"言公奋南国，卜子擅西河。\n绝学兴千载，微言阐四科。\n祀今崇圣域，礼昔重贤罗。\n赖有心源在，江流扬素波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白沙谒陈先生祠 其二","author":"区大相","text":"宇宙关皇运，东南挺大儒。\n有言皆训典，何事不师模。\n旧宅馀经壁，蒙泉启圣途。\n怀思不可接，俯仰愧吾徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门吊古 其一","author":"区大相","text":"遗恨前朝事，吾来问水滨。\n乾坤存一旅，社稷有三臣。\n惨澹勤王志，间关护主身。\n至今厓畔石，风雨洗胡尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门吊古 其二","author":"区大相","text":"极地南浮日，敷天左衽时。\n殒身徒有客，误国始由谁。\n百战江山破，三军恸哭辞。\n海门霞几片，犹闪旧旌旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门吊古 其三","author":"区大相","text":"北伐歼良将，南征失令图。\n人心非去宋，天意乃强胡。\n行殿秋烟冷，荒陵夜月孤。\n徒衔精卫恨，沧海几时枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门吊古 其四","author":"区大相","text":"万里穷何路，双厓壮此门。\n吁天惟决战，航海岂图存。\n虏骑能追宋，王师实灭元。\n聊持一尊酒，波上酹忠魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门吊古 其五","author":"区大相","text":"亡国遗墟在，扁舟访古行。\n厓无灭宋字，波有撼胡声。\n冠履仍华夏，乾坤仗圣明。\n回思驱逐日，极塞虏尘清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"楼船出厓门泛海作和四家兄兼示同游诸君 其一","author":"区大相","text":"浩渺洪流外，乾坤复几何。\n盈虚曾不有，舟楫意空多。\n天上回樯影，云边发棹歌。\n昔闻佔有圣，今夕正无波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"楼船出厓门泛海作和四家兄兼示同游诸君 其二","author":"区大相","text":"大壑吾将往，神仙客望登。\n水从天上转，槎似日边乘。\n贝阙含明月，鲛宫织夜灯。\n谁知溟涨里，朝暮变鹍鹏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛海归答侍御弟次韵","author":"区大相","text":"本无浮海意，兴发为观涛。\n弱水信神往，灵山空望劳。\n浪侵天势阔，波涌日轮高。\n渐鼓抟风翼，方驱戴地鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁少仲黄汝纶约游?川作此往订","author":"区大相","text":"鹿门栖逸地，耆旧向来多。\n豹隐真谁得，鸿冥奈尔何。\n和来泉石调，不是蒯缑歌。\n急剪蓬蒿径，相期二仲过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侍御弟园梅同梁少仲黄汝纶四家兄赏咏 其一","author":"区大相","text":"吾弟有奇尚，为园半植梅。\n溪桥寒意惬，山馆野情开。\n贞白存吾道，孤芳免物猜。\n惟应素心客，岁晏共迟徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侍御弟园梅同梁少仲黄汝纶四家兄赏咏 其二","author":"区大相","text":"小筑傍溪馆，先看倚岸梅。\n破霜孤干直，临水数枝开。\n香送春杯入，攀同野客来。\n和羹终用汝，藜杖且徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舍弟园亭与梁少仲黄汝纶小酌","author":"区大相","text":"为园幽涧曲，向水小亭开。\n贫有一瓢饮，闲能二仲来。\n烟霞多旧隐，花树几新栽。\n高兴林中发，清吟步绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四兄园亭晚步示黄汝纶","author":"区大相","text":"溪桥曳履行，晚景爱幽清。\n返照原中尽，残霞川上明。\n叶红林半落，堤绿草还生。\n莫学于陵灌，还依谷口耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚步?川","author":"区大相","text":"旧业青山下，长谣绿水边。\n近村逢浣石，远树起炊烟。\n竹密藏樵路，芦疏泊钓船。\n谁知谷口者，名在汉廷前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"官棠山庄梅树多数百年物花时偕家兄舍弟侄黄汝纶载酒往观酌咏其下","author":"区大相","text":"闻道江梅发，同来谷口寻。\n霜横千嶂静，雪压一溪深。\n冷月斜枝挂，寒烟瘦影侵。\n野桥与村舍，处处可行吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22330,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]