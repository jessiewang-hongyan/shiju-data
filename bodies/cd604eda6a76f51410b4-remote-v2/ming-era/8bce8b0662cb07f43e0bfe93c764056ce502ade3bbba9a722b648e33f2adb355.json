[{"title":"酬王尧载过访见贻","author":"欧大任","text":"词客淮阴至，江头把臂迟。\n枚乘工作赋，薛汉雅言诗。\n鞭弭犹相及，簪裾未可期。\n疏麻虽欲赠，何以报琼枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王尧载周渭阳薛世和沈孟威枉集","author":"欧大任","text":"一径莓苔滑，开关听马嘶。\n斋头散平楚，城曲带荒溪。\n过雨蔬能剪，微醺酒屡携。\n萧萧曼容宅，应记白门西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方子及李于田邀陪吴明卿同陆无从方仲美集天界寺属骤雨过得山字","author":"欧大任","text":"载酒因词伯，相携萧寺闲。\n云来常满阁，雨急欲沉山。\n净土莲花后，新林竹树间。\n谁令许玄度，扶策夜深还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻谭侍御子诚述衡岳之胜辄欲游瞩","author":"欧大任","text":"玉衡开胜域，金策寄灵踪。\n邓郁何年隐，刘虬几日逢。\n霞光飘紫盖，霁色上芙蓉。\n听得升真诀，松梯九万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诚意伯刘国祯招饮同郑光禄赵舍人集","author":"欧大任","text":"宗稷勋臣旧，君称文武才。\n簪巾羊祜出，笔札谷云来。\n芝曲从人问，松醪为客开。\n交游馀二纪，重上秣陵台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄田子艺","author":"欧大任","text":"凤乎千古士，君但汉田郎。\n老作申州客，官犹博士堂。\n陪游行橐笔，起草入含香。\n戢羽吾将去，分飞愧雁行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄何子启山人","author":"欧大任","text":"青鸟来三岛，金庭近五湖。\n游仙携绿玉，饭客具彫胡。\n世业能编竹，閒身欲据梧。\n綵衣君自乐，绕膝更双珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"汤义仍至闻丁右武已次扬州时邹尔瞻莅比部三月矣予将归岭外留赠三君子 其一","author":"欧大任","text":"江东文物盛，千古足吾徒。\n岂必周司乐，何伤楚大夫。\n鴸虽怜远客，马自识长途。\n欲待群贤赋，秋风已忆鲈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"汤义仍至闻丁右武已次扬州时邹尔瞻莅比部三月矣予将归岭外留赠三君子 其二","author":"欧大任","text":"太博曾封事，都官尚诤辞。\n风霜千字挟，江汉九歌遗。\n但可袁丝饮，宁知贾傅悲。\n扁舟吾引去，何以寄相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何仲雅访予普德寺","author":"欧大任","text":"逢君邂逅日，山里律僧家。\n名士归平叔，徵君识若耶。\n窗萝悬似带，岩桂郁将花。\n净土宁劳约，恒河一聚沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄丁元父","author":"欧大任","text":"鳞羽不相及，姓名先已闻。\n烟波鄂渚客，井牧海阳君。\n浮筏牵江水，开窗过岳云。\n便应青琐谒，能忆白鸥群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7688,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迁居青溪周文美以酒榼至","author":"欧大任","text":"西廨频迁次，为郎拙可知。\n宦游三署转，家具一车移。\n潘岳直犹寓，周颙到未迟。\n宅边寻菊把，溪上觅莼丝。\n惯懒旋抽牍，残痾久废诗。\n钟山今正近，猿鹤莫相疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7689,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄陈贰守在璞","author":"欧大任","text":"十五年前别，题书谢不能。\n郁林闻盛誉，营道喜先登。\n诗忆参军府，才推大郡丞。\n蒐兵收上策，勒颂纪中兴。\n梦去曾攀岳，心期在饮冰。\n春来归雁早，何以报金陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7690,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日郑子阳陈尔瞻沈秉忠过集斋中得长字","author":"欧大任","text":"童子钩帘起，啼莺乍过墙。\n日高花气暖，风细柳丝长。\n棐几时焚蒳，荒斋亦理觞。\n客能从蒋诩，郎自老冯唐。\n竹下通深径，溪头出大航。\n雅游因此地，何必让清漳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7691,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答姚玄胤","author":"欧大任","text":"雅游逢白下，艺圃每称雄。\n贤哲千秋事，歌辞六代风。\n君家僧坦后，世业秘书同。\n持橐为朝士，挥毫自国工。\n秦淮桃渡侧，晋苑竹城中。\n池解迎山简，门曾过孔融。\n蹇余思岭外，薄宦滞江东。\n帙束诗频寄，尊开酒易空。\n顾园閒欲造，蒋径可能通。\n倘得留伧父，无劳酌次公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7692,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日周公瑕马从甫陆成叔同集悦上人禅房得书字","author":"欧大任","text":"嘉会逢休沐，城南枉客车。\n竹深三径里，松偃六朝馀。\n贝叶齐诗策，莲花照梵书。\n词华青玉管，禅诵白云庐。\n棐几凉蕉石，清斋瞻笋蔬。\n逍遥持论后，玄度意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7693,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答陆成叔雪中见怀","author":"欧大任","text":"朔风千里至，霰雪满江天。\n客集璇房里，诗裁粉荔前。\n竹光惊岁暮，花片似春先。\n城照龙沙月，溪飞鹤沼烟。\n兔园新有赋，虎幄久无毡。\n玉马思常郡，铜驼望酒泉。\n梅清何逊句，葹绿沈郎篇。\n奚独承嘉藻，瑶华愧报笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7694,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"康裕卿挽词","author":"欧大任","text":"词客东嘉起，悠悠燕市閒。\n行孤肱自曲，吟苦鬓先斑。\n始遂丘樊乐，俄惊电露闲。\n橘花残石磴，槲叶满柴关。\n笔掩群鹅沼，书藏二雁山。\n汉家求禅草，应待所忠还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7695,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏文甫周稚尊张康叔薛世和冯伯延吴允兆汪象初黄说仲张汝弦九子见过得长字","author":"欧大任","text":"群公敦夙好，携手问潜郎。\n落日青萍在，秋风白发长。\n马卿虽玩世，张翰已思乡。\n禅理閒差胜，词锋老渐藏。\n秫花犹未酿，菰米但堪粮。\n将客聊开径，呼儿稍进觞。\n苑连凉竹密，溪近野莼香。\n招隐还题馆，钟山傍草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7696,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻朱宪使内子宜人卒于潼关寄挽十韵","author":"欧大任","text":"书来悽楚日，掩镜恨孤鸾。\n玉匣伤春晚，瑶妆罢夜阑。\n把箫空有忆，撤瑟不成欢。\n箧锁芙蓉带，奁收翡翠冠。\n旧椷仍墨渍，遗挂并香残。\n岳雨铭旌湿，关云帟帐寒。\n哀能毁璧赋，心更陨珠酸。\n羸博魂应返，千秋泪几弹。\n悼亡汾水上，归葬淦江干。\n梱得留彤管，松铭奕代看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7697,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"倾盖亭八韵","author":"欧大任","text":"嘉会自不偶，宾来盖可倾。\n亭因开径筑，楼以看山成。\n珠树门交翠，瑶花井并清。\n吕园能共灌，郑谷欲深耕。\n隐已携莱妇，游宁学尚平。\n畦蔬当列鼎，家酿足飞觥。\n颇有栖林约，犹多置驿情。\n怜予曾宿客，再访辟疆行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7698,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨盐城肖韩召入户部郎","author":"欧大任","text":"七载瓢城令，田荒涝未乾。\n河堤行使者，盐渎学农官。\n井里讴歌起，江淮保障完。\n皇家劳计省，宾从待词坛。\n筹国谈漕粟，逢人赋握兰。\n西山秋色好，知尔到长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7699,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗山九可诗 其一 可仰","author":"欧大任","text":"四照罗城色，山窗纳白云。\n万峰曾不隔，遥揖武夷君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7700,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗山九可诗 其二 可樵","author":"欧大任","text":"烟深斸山木，负薪辄沽酒。\n傥窥石上棋，视汝柯烂否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7701,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗山九可诗 其三 可钓","author":"欧大任","text":"涛涌雪成滩，星石绾其口。\n谁来选渔竿，约此溪中友。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7702,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗山九可诗 其四 可耕","author":"欧大任","text":"成都沃野桑，彭泽公田秫。\n击鼓吹豳诗，乐岁农功毕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7703,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗山九可诗 其五 可醉","author":"欧大任","text":"酿熟山中黍，炰羔宴比邻。\n独醒非所愿，乐我羲皇春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7704,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗山九可诗 其六 可蔬","author":"欧大任","text":"抱瓮行灌蔬，桔槔宁复用。\n园葵一饱馀，栩栩南窗梦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7705,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗山九可诗 其七 可读","author":"欧大任","text":"富有万卷藏，抱书时闭户。\n不逢堂下人，焉知斲轮悟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7706,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗山九可诗 其八 可俭","author":"欧大任","text":"邻多素心人，太朴求吾适。\n耕穫自有馀，似是柴桑客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7707,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗山九可诗 其九 可隐","author":"欧大任","text":"世业已千秋，明农不待求。\n桥边黄石在，留伴赤松游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7708,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题文休承萱花","author":"欧大任","text":"树萱灿庭花，风日当清昼。\n衣以斑斓来，持献北堂寿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7709,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题绣佛斋图","author":"欧大任","text":"众生无上道，开示方便门。\n非法非非法，斋心礼世尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7710,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题宋人绣达磨像","author":"欧大任","text":"东行震旦年，渡芦带江色。\n见性成佛心，影幻中嵩壁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7711,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观顾道行所藏面壁图","author":"欧大任","text":"神力不思议，如如本何动。\n稽首世尊前，一悟九年梦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7712,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"术海寺石壁","author":"欧大任","text":"山开仪凤门，江断卢龙石。\n三宿昔年人，泊舟总陈迹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7713,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"薛世和寄慧山泉","author":"欧大任","text":"九龙谷中来，贮月青溪曲。\n山瓢汲古心，江天赋怀陆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7714,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾司勋斋中二咏 其一 锄","author":"欧大任","text":"烟客以铁耕，霞起赤城日。\n泰山老父来，共种中林木。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7715,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾司勋斋中二咏 其二 竿","author":"欧大任","text":"湘竹供我钓，月明下江门。\n扁舟鸣榔急，持过桃花源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7716,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旷视楼","author":"欧大任","text":"浮云荡胸过，远照延瞩明。\n江山极千里，信美登楼情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7717,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拥翠楼","author":"欧大任","text":"列岫满窗中，翠色飞林杪。\n因之听松飙，卷帘坐清晓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7718,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题丁南羽画吴明卿云山冰井图二首 其一","author":"欧大任","text":"鹤下丁生笔，斋头到公石。\n六月乍清凉，婆娑玉华客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7719,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题丁南羽画吴明卿云山冰井图二首 其二","author":"欧大任","text":"辘轳何所用，注兹玉晶盘。\n阴山雪欲下，榻畔鸣琅玕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7720,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赴金陵留别都下诸公","author":"欧大任","text":"芳草垂杨引旆新，一官回首七经春。\n祖筵恋别停韦曲，去骑骄嘶过洛滨。\n小陆不堪羁宦日，大梁曾是倦游人。\n他时若问尊前客，老向江东忆紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7721,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨村驿逢朱可大谪汝州","author":"欧大任","text":"天涯何意复追欢，把袂苍茫别更难。\n传舍共怜迁客去，路人犹作近臣看。\n孤村浊酒临河醉，五月征帆带雨寒。\n汝洛相思千里外，书来不用叹南冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7722,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登天津城楼","author":"欧大任","text":"高城秋气已悲哉，一出金门驿路催。\n天远渔阳青燧断，日斜沧海白云来。\n江南十郡荒何救，辽左诸军戍不回。\n百万材官今扼险，胡琴羌笛未须哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7723,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"济州登李白酒楼","author":"欧大任","text":"汶上何来旅服游，至今犹足想风流。\n殊方宾客空词苑，万里河山一酒楼。\n供奉花深秦地月，酣歌星散鲁门秋。\n谁能不引中原目，金马铜驼迥自愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7724,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留城望沛上","author":"欧大任","text":"沛中一望似江乡，使者南来问渺茫。\n何代云飞浮芒砀，异时河徙筑宣房。\n关山四塞咸阳壮，汤沐千秋泗水长。\n最是漕渠劳轸念，灌输谁以报君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7725,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕子楼","author":"欧大任","text":"舞从掌上罢新欢，化作乌衣梦亦残。\n单翼不堪寻阁道，双栖宁复傍阑干。\n彭城落月枝枝恨，濉水秋风岁岁寒。\n何事蛾眉怨颜色，古来惟有报恩难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7726,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玄武湖堤上","author":"欧大任","text":"十里玄湖背郭斜，马头片片落山霞。\n荒渠早下昆明雁，小籞秋开御宿花。\n蘋末悲风摇枉渚，芦中轻舸出平沙。\n乐游旧事那堪问，惟有长楸起暮鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7727,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳前一日同陆来何吴魏胡黄郭范诸曹长阅留都城还上天坛眺望","author":"欧大任","text":"城开天阙俯江隍，何但黄山半夕阳。\n节近偶来持菊盏，恩深犹忆赐萸囊。\n青葱玉树甘泉色，零落彫胡太液香。\n谁向商飙称赋客，万年丰镐颂高皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7728,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答冯咸父","author":"欧大任","text":"翩翩年少雅能文，老愧西窗白练裙。\n士论共推诸谢族，邦人争识小冯君。\n建康柳色停金勒，长乐钟声散白云。\n若到谷阳操管日，过江鱼雁好相闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7729,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠郭封君题其二图衡庐两峰图","author":"欧大任","text":"西江南斗映岧峣，仙客谁如郭四朝。\n衡岳赤虬飞户牖，匡山白鹿下云霄。\n洞经魏姥曾亲授，社酒陶公不待招。\n簪黻奉恩黄发老，婆娑宁但侣渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7730,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹖冠著书图","author":"欧大任","text":"白首缁帷不下坛，一编元自足盘桓。\n书传绝学虫为篆，家隐名山鹖是冠。\n草阁几人题玉笈，竹林诸子荐铜柈。\n西昌更有长生箓，愿奉云亭岁岁欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7731,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同宋膳部惟一余太史伯祥过姚太守叙卿斋中看菊得残字","author":"欧大任","text":"霜天下马一尊残，把菊深秋兴倍欢。\n摇落未应同泽畔，风流今尚在江干。\n乌衣旧宅通花市，锦石高斋傍蕊栏。\n笑问东都白居士，许携宾客几回看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7732,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐民部宅饯刘大理长钦考绩北上","author":"欧大任","text":"酌酒黄花此夕情，久从海内得刘生。\n引经岂但推儒术，结袜因知借客名。\n月傍林乌玄武署，霜彫江树秣陵城。\n九霄宫阙长相忆，彩笔还来赋二京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7733,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄吴叔承","author":"欧大任","text":"绿发朱颜四十春，清班侍从拖朝绅。\n起家已作青云客，结社还从白岳人。\n芝术山中年自给，鹭鸥溪上日相亲。\n汉廷我亦东方朔，君到金门忆小臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7734,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"齐王孙园饯郭相奎曹长出守潮州","author":"欧大任","text":"急管娇歌醉月明，寒宵犹共秣陵城。\n文扶八代潮州去，诗擅诸曹水部名。\n南问舟航津树合，东看楼橹海烟平。\n不知几日王程路，何限儿童竹马情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7735,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻王敬美关中督学乞休还吴下","author":"欧大任","text":"入关去作半年游，拜疏归来岂复留。\n山徙琅琊东武日，门开安里射台秋。\n灵威丈人堪共酒，贞白先生不下楼。\n我亦陪京家渐近，乞君一杖向罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7736,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬至斋居次张侍御伯大韵","author":"欧大任","text":"定鼎钟陵俯大川，郊丘练日盛才贤。\n沐兰礼备精禋里，燎玉诚将奏格先。\n泰畤风云开禹甸，周庐星斗望尧天。\n斋郎听得阳春曲，犹愧西台寡和篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7737,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送宋膳部惟一考绩北上","author":"欧大任","text":"寒城出祖大江涛，曾是从君水部曹。\n稍转云司劳削牍，更移兰省借挥毫。\n星前入奏燕山近，雪后趋朝汉殿高。\n计最祠官应恋阙，可能归及荐樱桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7738,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除前一夕吴叔嘉黄白仲夏绳卿过集得杯字","author":"欧大任","text":"逼除风雨岁偏催，寂寞蓬门为尔开。\n梅萼似将春蚤到，椒花能与颂俱来。\n江干日月冥鸿羽，海内宾朋浊酒杯。\n岂是咸阳犹客舍，夜阑灯烛一徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7739,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春日同诸僚集黄都水督芦署中","author":"欧大任","text":"筵开西署绮窗寒，何限梅花水部看。\n绛雪不妨销夜烛，青丝犹自簇春盘。\n忆从北阙千官会，驭得东皇万国欢。\n谁道紫宸车马隔，由来江左旧长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7740,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日同许奉常用杜韵","author":"欧大任","text":"献岁日逢人共喜，过江星与使同看。\n航头南署曹虽简，阙角东风帽不寒。\n醉后五辛频对食，歌中双铗几回弹。\n客卿老问清卿业，敢向明时更说难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7741,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答金山人姚鸿胪人日过饮","author":"欧大任","text":"杖笠相寻竹径斜，客来犹似入烟霞。\n溪曾西府沿江宅，墅岂东山学谢家。\n大隐自堪论世外，旧游何必问天涯。\n尊前记取人为日，开到官梅几树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7742,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答俞公临沅州见寄","author":"欧大任","text":"大寒江上路初分，消息劳将尺素闻。\n吹笛故能陪汉将，杨舲犹自吊湘君。\n洞庭晓色鱼龙阵，沅浦春风雁鹜群。\n公子翩翩王粲赋，西来诗可寄从军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]