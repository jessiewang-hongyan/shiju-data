aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出塞曲五首寄季彭山郡侯 其五","author":"沈鍊","text":"雁门太守今隐居，桃李春风自结庐。\n藩墙几处留彤管，那能不著定边书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23192,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠柳文学 其一","author":"沈鍊","text":"只今并棹访庭闱，秋日扬鞭达帝畿。\n遥知早佩黄金印，终然不脱芰荷衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23193,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠柳文学 其二","author":"沈鍊","text":"若为楚曲凌辰发，犹抱音尘向明月。\n人言窈窕非玉凫，公自徘徊结罗袜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23194,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠柳文学 其三","author":"沈鍊","text":"嗟余亦作燕山游，怀公意气如清秋。\n狂歌未足为公赠，貌出芦花江上愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23195,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠柳文学 其四","author":"沈鍊","text":"遥忆春风数千里，祇啜江亭一杯水。\n山阴父老溪畔来，未见使君清若此。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23196,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠柳文学新居","author":"沈鍊","text":"卜筑新城大道边，楼居何必让神仙。\n知君綵笔充廷宇，莫学杨䧺只草玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23197,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"饮童氏山楼","author":"沈鍊","text":"芳筵歌舞夜徘徊，莫厌慇勤劝酒杯。\n满目江山君试数，几家弦管在楼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23198,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和张有功闻马孟河中礼闱消息","author":"沈鍊","text":"十上封书事始成，杏花园里最驰名。\n还知马上看春日，应有新词和凤鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23199,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得著论准过秦作赋拟子虚","author":"沈鍊","text":"芸阁临芳苑，韶光属令辰。\n三馀珍日月，七略谢风尘。\n鸿藻能齐汉，䧺词解屈秦。\n含毫方子夜，流曜在千春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23200,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李使君考绩之京","author":"沈鍊","text":"三年佐郡节旄䧺，四海声名在镜中。\n今日驱车就岐路，何人不奏管弦风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23201,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渡江 其一","author":"沈鍊","text":"江上春风暖复轻，春云淡淡碧波平。\n海门日涌蛟龙动，城上山连剑戟明。\n飞鹭巧迎帆影疾，鸣鼍遥答棹歌清。\n中流独有中原志，莫遣勋名愧祖生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23202,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渡江 其二","author":"沈鍊","text":"一卧江东已十年，重听笳鼓泛楼船。\n春潮声细江流稳，夜雨痕多柳色鲜。\n佛寺午钟惊鹤起，神州远岫见龙缠。\n䧺图王气俱堪赋，酾酒临风思渺然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23203,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过高邮","author":"沈鍊","text":"宛转舟行逐岸斜，短篷细雨正思家。\n春湖渺渺春蒲绿，两两鸳鸯戏浅沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23204,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送吴刑曹出淮阳 其一","author":"沈鍊","text":"方秋金气肃，主上遣曹郎。\n仗策临䧺郡，驱车出汉疆。\n草承鱼蕳白，花入隼旟黄。\n祖帐祥云动，兹行宪节光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23205,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送吴刑曹出淮阳 其二","author":"沈鍊","text":"白云飞皂盖，正值帝乡秋。\n剑佩离郎署，骖騑驻陌头。\n谁将吏作隐，自藉宦为游。\n弭节兰皋上，还经芳杜洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23206,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚轩词为苏山人题","author":"沈鍊","text":"莫厌回轩敞暮云，且将弦管醉斜曛。\n长安甲第青霄客，白首飘摇未及君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23207,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"遇陆竹石御医父子","author":"沈鍊","text":"燕土三年别，相逢楚水浔。\n丝萝元石友，桥梓总兰心。\n倚盖春风里，维舟古木阴。\n慇勤不忍去，望望夕烟深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23208,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"任节妇歌 其一","author":"沈鍊","text":"古往今来不尽年，一人旌节万人怜。\n曩时孟妇吴中怨，今日任姬越上传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23209,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"任节妇歌 其二","author":"沈鍊","text":"闺中此意谁解知，遥忆秋山连理枝。\n孤鸾别鹤云中操，蹑凤攀龙未是奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23210,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"任节妇歌 其三","author":"沈鍊","text":"独抱幽兰八十秋，遗孤此日剩孙谋。\n百年清节开藜杖，一寸丹心映白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23211,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"任节妇歌 其四","author":"沈鍊","text":"旧事连翩接会稽，他年典录著芳菲。\n身看王母庭花结，名与曹娥庙树齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23212,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沈玄斋赠剑以诗酬之","author":"沈鍊","text":"宝剑相持赠，关河意气多。\n题书悬日月，开匣隐星河。\n学武心先壮，谈边色未和。\n因君奉韬略，扬臂愿麾戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23213,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题青谷卷赠姚道士 其一","author":"沈鍊","text":"谷口青枝萦石云，杂花交绮蔼晴芬。\n浔阳道士幽栖处，萝月松云长念君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23214,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题青谷卷赠姚道士 其二","author":"沈鍊","text":"月閟霞宫綵，云回羽客文。\n谷青萝树合，沙白涧泉分。\n山僻欹猿啸，天深下鹤群。\n遥见春葩结，丹成独有君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23215,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄文司徒","author":"沈鍊","text":"京国看摇落，芳条此地新。\n非能不折赠，但恐坐伤春。\n恋禄频餐水，怀交强谢邻。\n自知书断绝，翻觉苦干人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23216,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和刘春冈侍御怡椿轩","author":"沈鍊","text":"绮榭长荣玉树春，光辉奕世自怡神。\n朝攀濯露枝偏旧，夕对流云叶并新。\n天上袭香薰委佩，日中重采映垂绅。\n北堂南殿恩俱切，莫遣挥毫赋咏频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23217,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张刑曹奉使恤刑","author":"沈鍊","text":"汉庭鸿藻属邹枚，丹笔还教握宪台。\n却见洛阳乘传出，何如博望泛槎回。\n城边候气知流昴，马上题诗问弃灰。\n若遣河东多覆奏，挥毫更展掞天才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23218,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得柳亭篇赠叶内翰","author":"沈鍊","text":"柏梁侍臣花满缨，却向烟霞怀柳亭。\n应怜宫苑千年树，讵念江湖万里萍。\n朝回骝马知曾系，春入黄鹂许纵听。\n何惧綵毫无献纳，永瞻日月耀光灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23219,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送屠直翁赴南都工部尚书","author":"沈鍊","text":"司空冠盖映海滨，南望金陵并作春。\n玄绶拂林花气发，隼旟接岸柳条新。\n中朝饯别千官出，夹道弦歌九叙陈。\n珍重留都根本地，只今水土是经纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23220,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送翁梦山拊循四川","author":"沈鍊","text":"结发交游今壮年，相逢朱盖只依然。\n并探禹穴非无棹，一眺津亭别有筵。\n欢意自怜花鸟近，归心徒畏简书传。\n使君且莫停车骑，蜀国山河已在边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23221,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠答张心厓","author":"沈鍊","text":"江离幽郁满城阿，之子临风杂佩过。\n宝剑独悬秋气肃，绮园时集野芳多。\n不教明月分光采，更有清风出咏歌。\n今日相逢君记取，他时勋业在山河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23222,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]