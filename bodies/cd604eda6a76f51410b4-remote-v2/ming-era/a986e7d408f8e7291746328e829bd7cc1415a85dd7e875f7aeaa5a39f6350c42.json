[{"title":"灯下观菊花影同社中诸友赋 其五","author":"袁宏道","text":"舞影将流地，颓香乍可闻。\n玲珑千朵月，碎琐一窠云。\n押以无弦韵，吟成没字文。\n长时嗔罔两，或恐近夫君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灯下观菊花影同社中诸友赋 其六","author":"袁宏道","text":"山中频领略，得意是萧疏。\n半赭佳人后，一帘温语初。\n墙颓生画意，蛇斗悟颠书。\n离即成三昧，超超寔起余。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灯下观菊花影同社中诸友赋 其七","author":"袁宏道","text":"静语一堂熏，兕觥屡付君。\n窿洼扪水影，游戏写风纹。\n倩女归时魄，巫山嫁后云。\n鼻根如灭却，亦可嗅清芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灯下观菊花影同社中诸友赋 其八","author":"袁宏道","text":"变体初从墨，名家但姓黄。\n空花新女弟，乌有旧儿郎。\n函作仙人谜，和成羽客方。\n浮生虚妄等，一倍感欢场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五弟清梵阁落成闰九月九日同邹伯学王闇然王连玉刘绳之方平弟觞其上得清字","author":"袁宏道","text":"隐几牙签横，蠹鱼渐次成。\n花枝合苑影，骚雅一楼声。\n租薄盘飧瘦，人閒笑韵清。\n篱东香未歇，展限与渊明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过五弟天花馆同郝公琰王尚父小酌","author":"袁宏道","text":"草草命洼樽，秋花瘦满盆。\n题诗红桕叶，坐语绿槐根。\n僧懒迟鸣磬，鸦昏不过村。\n开帘见树影，月在槿篱门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月下坐小阁","author":"袁宏道","text":"雏女笑咿哑，疏帘委委斜。\n酒浇清苦月，诗慰寂寥花。\n影落回风雁，先分坐树鸦。\n侍儿供茗碗，幽事在山家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜痛饮李上舍家和公琰韵","author":"袁宏道","text":"冠珥堕纷纭，清言了不闻。\n炉焦鸣暴雨，杯沓卷春云。\n醉眼常疑柱，颠书乱扫裙。\n主人苛酒政，起立诵弹文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郝公琰邀过禅堂访诸高衲 其一","author":"袁宏道","text":"白衱与乌藤，相邀访定僧。\n君言未合齿，吾屐已先登。\n但省乾无事，何忧百不能。\n如临幽涧水，虽小却清澄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郝公琰邀过禅堂访诸高衲 其二","author":"袁宏道","text":"幽院日清和，墙苔与径莎。\n到来閒挂少，始觉顶毛多。\n病亦强人健，愁犹胜客歌。\n且休谈出世，入世又如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过法华练若","author":"袁宏道","text":"瘦柏多连架，寒花半入瓶。\n山僧轮指语，幽客倚窗听。\n苔壁三年墨，蔬园十亩青。\n茶烟细细起，竟日锁柴扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜话清梵阁限韵","author":"袁宏道","text":"萧骚叶满窗，枫落话吴江。\n坐久枯兰烬，言深倒酒缸。\n寒泉鸣废圃，邻月影高幢。\n碧楯方塘曲，昂藏老鹤双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"看诸友奕 其一","author":"袁宏道","text":"竹影风轩外，楸枰石子声。\n暂凭閒调度，清却苦经营。\n乌帻连花堕，红云泼面生。\n旁观亦自喜，赖是学无成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"看诸友奕 其二","author":"袁宏道","text":"窗下攲襟坐，无人不看来。\n时闻飞似雨，忽有笑如雷。\n得意天山捷，沈思槁木灰。\n经营定何许，九地九天回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风林纤月落 其一","author":"袁宏道","text":"瑟瑟残规吐，泠泠小籁吹。\n偶然低远碧，恰好透疏枝。\n罥藻勾萝去，笼烟压露垂。\n归樵与去艇，处处杜陵诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风林纤月落 其二","author":"袁宏道","text":"轮浅虚笼树，兮斜乍避鸾。\n一痕光浅艳，万井气森寒。\n耻作妆奁喻，聊为烟水看。\n江湖多钓侣，时与校鱼竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风林纤月落 其三","author":"袁宏道","text":"碎影平侵槛，寒梢半妥轮。\n装幽来隐舍，布景与词人。\n只在风篁曲，长依水石邻。\n东郊西浦上，不信有飞尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风林纤月落 其四","author":"袁宏道","text":"帘卷烟条重，窗分翠叠澄。\n诗要林处士，图请赵吴兴。\n活景通千壑，閒观倚一藤。\n匡床谁对语，合有韵高僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜话春草堂限韵 其一","author":"袁宏道","text":"刻日春杯酽，消时筠管纤。\n问风传巷语，备体杂香奁。\n山水堆唇角，烟云上指尖。\n世缘如骰子，遇著偶然拈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜话春草堂限韵 其二","author":"袁宏道","text":"螺子春生艳，蛾眉老避纤。\n祗宜供剪尺，不可更妆奁。\n时缬抽丝嫩，新花出样尖。\n陇西见弓矢，二见一回拈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜话春草堂限韵 其三","author":"袁宏道","text":"陶令情非冶，广平赋偶纤。\n鸾台朝洗砚，春草夜收奁。\n倦翮犹思猎，村眉也效尖。\n白发伴毛颖，溷上亦时拈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜苏潜夫至柳浪座上限韵 其一","author":"袁宏道","text":"入门檐鸟乱，红叶照青衫。\n童子初弛笈，花骢乍解衔。\n瓮头倾滟潋，卷里出巉岩。\n屡眄跫音至，秋来信几缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜苏潜夫至柳浪座上限韵 其二","author":"袁宏道","text":"侧帽花垂髻，翻杯酒污衫。\n骚坛为佐领，曲部是兼衔。\n话久风掀席，思奇笋出岩。\n半宵酬和语，题满一封缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜苏潜夫至柳浪座上限韵 其三","author":"袁宏道","text":"小仄呼藤杖，微喧去皂衫。\n花头当槛落，鸟影入杯衔。\n对口浮三爵，他时老一岩。\n暂来犹有禁，佛语口须缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集方平弟绿荫堂古槐下即事限韵","author":"袁宏道","text":"率尔生幽意，非关对水山。\n苔枝垂酒盏，虫叶堕烟鬟。\n只此双眉黛，舒开一座颜。\n婆娑醉老叟，项领曲如弯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小修久住沙市苏潜夫迟之十馀日矣雨中集刘绳之高斋小脩忽至赋得十灰","author":"袁宏道","text":"百里三回约，无朝不眄来。\n未曾离口齿，忽已到池台。\n酒病花销去，诗心竹引开。\n筼筜旧老圃，芟草去尘灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得裙拖六幅潇湘水","author":"袁宏道","text":"细简匀匀叠，长墙靡靡澜。\n风回千皱乱，花绕一拖寒。\n洛水罗呈出，谢家练比看。\n两般俱死水，争解舞惊鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得欢场害马","author":"袁宏道","text":"恶态频来见，清谈事每差。\n杯徼合券客，庭老晒裈花。\n遇月长扃户，登山屡忆家。\n每当欢饮夕，三五散如鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乍寒集王连玉宅小饮","author":"袁宏道","text":"浅屋低檐下，春花滴小槽。\n箸阑思蟹足，话久觅绒袍。\n竹语调刀切，云啼獝狖高。\n等閒历寒暑，颠里换斑毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丈石居小集送苏潜夫","author":"袁宏道","text":"底事心难尽，穷宵说未终。\n半槽平口水，一叶打霜风。\n寒月冲煤焰，枯株照粉红。\n别来元白语，多分在诗筒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代","author":"袁宏道","text":"随例东门柳，那堪折赠行。\n早知云易散，何忍梦难成。\n小玉终无匹，汪伦只有情。\n别来林处士，卖鹤买新声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郝公琰南下","author":"袁宏道","text":"雪子落纷纷，鸣涛远送君。\n梦回牛渚月，书达敬亭云。\n俗薄休怀刺，交浮莫定文。\n王充如有论，应使蔡邕闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"外甥毛云花烛诗","author":"袁宏道","text":"玉立映澄壶，儿郎洵美都。\n香含新豆蔻，花引嫩鹓雏。\n案小频过额，烟轻欲散垆。\n韦门素业好，付与外甥卢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜起同廖道人扣王生门索酒酒行而电电大作众皆辟易余兴益豪至子夜乃休 其一","author":"袁宏道","text":"夜暖不成寐，披衣聊起行。\n一街丝雨暗，半隙幌灯明。\n壁上烟黄字，瓮头点滴声。\n乾莲与烘笋，倍觉有心情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜起同廖道人扣王生门索酒酒行而电电大作众皆辟易余兴益豪至子夜乃休 其二","author":"袁宏道","text":"天意苍茫恶，奔雷驾雨风。\n书翻入瓮内，儿走匿床中。\n拍案山公叫，沾唇儿盏空。\n归途那用烛，电火照人红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曾长石诗来约以寒食见过用韵合之","author":"袁宏道","text":"湖上腰如许，那能不系人。\n到门青李帖，屈指永和辰。\n笋蕨抽蔘嫩，旗枪战火新。\n云山无处少，只少自由身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨","author":"袁宏道","text":"且莫问提壶，春风一半孤。\n暮云啼滑滑，晓树语呱呱。\n梦绕飞花社，思牵线柳湖。\n无方可醉得，浊酒坐灰垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曾退如太史返棹江干雨甚宿杨上舍家令门僧持卷来观夜坐有怀敬题其末 其一","author":"袁宏道","text":"兰蕊坐销红，长吟短噫中。\n游天车轴雨，撼地户邮风。\n梦去云连峡，诗来翠扫空。\n习家地上酒，何事外山公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曾退如太史返棹江干雨甚宿杨上舍家令门僧持卷来观夜坐有怀敬题其末 其二","author":"袁宏道","text":"山鬼莫吹灯，羁心感少陵。\n话中江渺渺，卷里岫层层。\n岚重千畦衲，云开九节藤。\n联床今夜雨，空对岭南能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泛舟便河 其一","author":"袁宏道","text":"一棹碧苍茫，蕉衫碎影凉。\n风音和鸟语，水色与天光。\n岸老蒲根出，沙平荻笋香。\n蹄轮何滚滚，对面即沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泛舟便河 其二","author":"袁宏道","text":"禅板佐尊罍，青溪曲曲回。\n鱼閒知浪静，鸟喜觉风来。\n漠漠新云树，荒荒旧沼台。\n一番见高冢，一度使眉开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送苏潜夫北上","author":"袁宏道","text":"去去日华东，晴霞似火红。\n好辞杯底月，莫畏马头风。\n谢客休耽屐，张融且竖铜。\n绯袍白手板，勉矣偶场中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游章台寺和小修韵 其一","author":"袁宏道","text":"飞尘冷冷消，人语隔烟遥。\n雨洗青畦道，风薰白芷苗。\n竹深存废碣，僧老话前朝。\n霸业荒残尽，虚名只细腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游章台寺和小修韵 其二","author":"袁宏道","text":"碧水蠲忙去，红葩引笑开。\n兔葵伤故国，狐粉啸空台。\n古屋晴生菌，深房昼锁苔。\n松音与梵响，一洗大夫哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游章台寺和小修韵 其三","author":"袁宏道","text":"云捲三分地，尘飞六国王。\n自然归灭劫，不必问巫阳。\n古叠荒遗搆，澄波照冷篁。\n廿年双屈指，头白话儿郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游章台寺和小修韵 其四","author":"袁宏道","text":"碧渚新琅玕，入门碎影寒。\n么弦将水听，青黛作烟看。\n且乐时花艳，休悲故垄残。\n南威他自美，兴废岂相干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日同龙君超傅中执萧季星龚散木彭长卿崔晦之小修王小白泛舟便河得桥字","author":"袁宏道","text":"好作烟林谱，微霞带水条。\n平平铺碎浪，远远出红桥。\n天坼云鳞见，江澄暑路消。\n山光与粉黛，一种是逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又和龙君超韵","author":"袁宏道","text":"白板赤栏桥，石根系小舠。\n风传初稻信，雨应熟梅潮。\n柳密兼烟重，槎枯带藓漂。\n洄沿无定止，只似野云邀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘元质宅宴得金字","author":"袁宏道","text":"远水轻云意，孤桐野鹤心。\n消磨归酒政，游戏入花林。\n赵姊双名燕，卢郎一字琛。\n庞公见亦悔，湘水错沉金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙君超徼集章台以看花台为韵 其一","author":"袁宏道","text":"碧筱当烟出，朱华带渚看。\n佳人吴笑语，公子晋衣冠。\n始觉欢场盛，争言雅道难。\n经时觅快友，才得许如兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙君超徼集章台以看花台为韵 其二","author":"袁宏道","text":"一笑烂云霞，青娥驱法华。\n章台新马足，洞口旧鱼槎。\n秋水人人月，春风面面花。\n不同愁未玉，萧瑟对东家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙君超徼集章台以看花台为韵 其三","author":"袁宏道","text":"天际飒轻雷，浓阴泼地来。\n丛中避粉黛，树底卧樽罍。\n数点将穿屋，移时忽泛台。\n只疑旧歌舞，化作雨云回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起新霁见月","author":"袁宏道","text":"病起初逢月，云开哎亦开。\n云随残闷去，月逐好怀来。\n地叶凝清露，新香泻绿醅。\n冶心虽校浅，仍是欲然灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林兰阁同王以明先生及尚父谢道人小集偶成","author":"袁宏道","text":"凉月下空疏，萧萧静者居。\n休心花事断，忌药酒船虚。\n竹外披烟鹤，尊前带子鱼。\n盘飧聊复尔，商略古人书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉归示凡公响泉道人","author":"袁宏道","text":"不寐即狂歌，莲花漏水多。\n醉来寻白足，定起唤青娥。\n梵唱嗔吴肉，荷衣剪越罗。\n亦知风景煞，争奈老颠何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"当阳僧来邀游青溪紫盖诸胜 其一","author":"袁宏道","text":"十载青山约，今番始赴期。\n如云投旧岭，似鸟念高枝。\n蓝压仙翁井，苔深鬼谷祠。\n车将一喝去，秤取布裈师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"当阳僧来邀游青溪紫盖诸胜 其二","author":"袁宏道","text":"一涧珠翻处，千山玉照时。\n东冲西逻酒，横版侧厓诗。\n僧老扶雏至，鹤骄带子随。\n掌茶与谷水，宿世也相知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登遨游冢有感示凡公响泉道人","author":"袁宏道","text":"古冢新新道，荒原漠漠枫。\n荷衣蕙带鬼，燕麦兔葵风。\n颓叠高陵变，分趋逝水东。\n莫言空不得，何事不成空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将入青溪值雨雪凡公有诗见促用韵荅之","author":"袁宏道","text":"童子语諵諵，雪花打皂衫。\n云低天惨淡，霜老石巉岩。\n怪鸟鸣枯叶，空江立瘦杉。\n青溪骑鹤叟，聊且附书缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送雪照还吴","author":"袁宏道","text":"洗钵焚钞去，瞻云倚棹歌。\n离乡吴语变，入咏楚骚多。\n五老峰头瀑，三江雪后波。\n?衣棕笠子，袖手看嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又代作","author":"袁宏道","text":"四载椒林社，精研只有君。\n高谈排嘿照，独往贱多闻。\n江面瓶心月，山南岭北云。\n逆风香自远，无路袭芳芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮鸟投林和张明教 其一","author":"袁宏道","text":"雾卷复烟披，嘈嘈话许时。\n大都寻故侣，莫是拣高枝。\n半岭云千态，疏林月一规。\n夜寒风袅袅，归梦在天池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮鸟投林和张明教 其二","author":"袁宏道","text":"霞碧与山红，烟林绘谱中。\n乍啼缘见月，半妥为梢风。\n万点铺沙异，千畦带椟同。\n莫愁三匝苦，犹胜在金笼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮鸟投林和张明教 其三","author":"袁宏道","text":"渺渺辞沙屿，嘹嘹带远空。\n分行来树里，送影入池中。\n小艇烟江月，高楼晚箔风。\n佳人天末许，同此眄归鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙巳除夕","author":"袁宏道","text":"十亩负江田，归耕已七年。\n稚松云堰地，雏女发垂肩。\n贝叶翻将绽，荷衣著屡穿。\n贫乡何可恋，大抵为林泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同谢于楚周观国小脩李澄之王尚夫崔晦之刘绳之过智者堂访度门法师","author":"袁宏道","text":"数里碧阴森，高禅静亦吟。\n趁花来远涧，听鸟入平林。\n历尽摧车坂，稍存绕指金。\n浮尘都歇尽，未歇唾壶心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诸衲见过","author":"袁宏道","text":"閒即过东皋，衲衣对酒糟。\n袖中怀米帖，花底读离骚。\n箔卷垆烟细，窗寒石累高。\n负家无可供，沚水与溪毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭江进之 其一","author":"袁宏道","text":"石火乍飘红，匆匆四闰中。\n才名巴子国，吏迹馆娃宫。\n洗海登天月，催芳烂蕊风。\n不留长把玩，收拾与虚空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]