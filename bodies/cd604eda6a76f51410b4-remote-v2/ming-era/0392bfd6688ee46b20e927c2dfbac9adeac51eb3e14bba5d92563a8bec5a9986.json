[{"title":"赠河间丁襄教谕","author":"程敏政","text":"頖水芹香袭佩裾，皋比中坐八秋馀。\n令丞释菜询笾豆，子弟传经候起居。\n春捷尚期廷试榜，年劳先入考功书。\n广文异日推瀛海，只在丁宽众不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47479,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送戴廷珍侍郎持节册封鲁府","author":"程敏政","text":"龙节亲持下九重，亚卿风采羡儒宗。\n虞廷训诰班新册，鲁地山川析旧封。\n还阙使轺期再月，出城吟橐记初冬。\n孔林咫尺归途便，一叩宫墙礼圣容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47480,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送江文澜侍读持节册封荆府兼有寿母之便","author":"程敏政","text":"玉节煌煌下紫清，册封初命讲臣行。\n离筵把菊听歌郢，次国承恩许绍荆。\n人拥使轺观盛典，吏随公牒报严程。\n归途正及梅花候，春向高堂百倍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47481,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送戈良玉御史赴四川宪副崇夔保顺兵备","author":"程敏政","text":"柏台高处岁频更，奉敕宁辞万里程。\n云拥干旄归节制，风行山岳听威声。\n携家远过金牛岭，揽辔长临白帝城。\n珍重盛时勋业在，好将苏息问苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47482,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"李侍御二画 其一 鹤","author":"程敏政","text":"缟衣清露湿漙漙，四顾松阴弄影寒。\n老警自能知夜半，不缘明月下瑶坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47483,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"李侍御二画 其二 雁","author":"程敏政","text":"啄宿相依苇岸浔，幸离矰缴几秋深。\n可因恋稻频来往，须识随阳一片心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47484,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与庄定山司副潘时用待诏同至李宾之学士先茔登古城 其一","author":"程敏政","text":"看山空负一秋强，出郭来抛半日忙。\n草没断堤牵步远，柳拖斜日送阴长。\n百年丘垄怀先辈，几处园林似故乡。\n却尽壶觞临涧水，恨无渔笛和沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47485,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与庄定山司副潘时用待诏同至李宾之学士先茔登古城 其二","author":"程敏政","text":"古城高处立残阳，醉眼凭陵见八荒。\n木落放教冬岭瘦，鸟飞横绝暮天长。\n钟声远认驮经寺，帜影中开阅武场。\n胜览未穷吾正健，不愁荆棘罥衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47486,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送表兄林文美上舍赴青州训导","author":"程敏政","text":"郡博承恩出上庠，宦途仍喜近家乡。\n诗书俗厚称齐下，兄弟情深忆渭阳。\n寒月拥裘催去马，夕亭呼剑引离觞。\n官中旧识如星聚，不日分光到讲堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47487,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送吴汝德上舍赴渑池司训","author":"程敏政","text":"官舟南下逐寒潮，离思难胜郭外桥。\n仕版姓名初受禄，讲堂朱墨细分条。\n崤函境接山河胜，秦赵台空草木彫。\n麟史一编君旧业，几人延颈待甄陶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47488,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题四小景 其一 道院迎仙客","author":"程敏政","text":"日日栖空馆，呼童扫径苔。\n飘然骑鹤侣，时自海东来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47489,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题四小景 其二 书堂隐相儒","author":"程敏政","text":"万卷芸香里，萧斋绝点尘。\n须知调鼎客，原是断齑人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47490,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题四小景 其三 庭栽栖凤竹","author":"程敏政","text":"琅玕亲手种，早见拂云梢。\n要叶虞廷管，殷勤待凤巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47491,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题四小景 其四 池养化龙鱼","author":"程敏政","text":"小小储金鲤，池波一镜平。\n不须桃浪暖，头角亦峥嵘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47492,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送满城尹刘象谦","author":"程敏政","text":"陇西家世伟丰仪，京邸相逢恨见迟。\n早探杏园驰蹀躞，暂分花县抚疮痍。\n同年有后能如子，异选无多定属谁。\n大器可常淹百里，内台徵节快相期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47493,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同庚会寿施院使钦","author":"程敏政","text":"曾向西邻暂卜居，羡君供奉几年馀。\n婴医素出寻常表，朋寿今当五十初。\n香爱菊花浮盏面，秀看芝草茁庭除。\n海筹添屋从今始，借取家传肘后书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47494,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿歙义官王富祥","author":"程敏政","text":"朱颜犹未点霜毛，甲子初周第一遭。\n丹臼笑人分药饵，绮筵随意醉松醪。\n承恩始觉衣冠胜，阅世宁知岁月劳。\n喜到贤郎称寿日，梅花如雪照江皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47495,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢方伯辅夫妇挽诗 其一","author":"程敏政","text":"薇垣人去几春冬，曾说贤劳动九重。\n琬琰有文书大节，衣冠无计返生容。\n家庭稿在青箱贮，方岳功成紫诰封。\n馀庆百年流未已，凤毛谁及谢超宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47496,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢方伯辅夫妇挽诗 其二","author":"程敏政","text":"高堂偕老穴同藏，阃职名随涧水长。\n家训不骄亲子女，恩封犹爱布衣裳。\n尘埋妇苑庭萱殒，劫尽仙筹冢树苍。\n抚卷为君声薤露，五常真见白眉郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47497,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题祝黄门金鲤引子朝天图","author":"程敏政","text":"沧溟白日吹腥风，桃花浪蹙连春空。\n一鱼金甲忽腾起，顷刻变化云雷中。\n四鱼虽小亦奇健，鼓鬣偕升尾相贯。\n蹄涔回首顾凡鳞，咫尺龙门隔霄汉。\n刘郎写鱼如写人，鹅溪大幅开天真。\n临池挥染不论月，董羽杨晖争几尘。\n番水名流今大谏，头角峥嵘万人羡。\n丹青此意君得知，射策还徵过庭彦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47498,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题周驸马所藏小景","author":"程敏政","text":"一舟随泛水云中，醉爱高眠仰受风。\n惊起竹林双白鹤，背人飞过大溪东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47499,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十二月七日监放官吏俸粮其册云学士程某等共支米二百石初盖不知当此首选也戏成一律奉寅长西涯先生同一捧腹云","author":"程敏政","text":"三十年馀翰墨坛，强颜来作计筹官。\n清朝制古班恩厚，冷局人多卒岁难。\n吏事不堪诗兴败，公庖无暇晚炊寒。\n偶披俸历掀髯笑，浅薄由来首素餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47500,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题石菊","author":"程敏政","text":"一峰笔立青琅玕，介若端士何桓桓。\n托根秖许霜下杰，凛然正色凌秋寒。\n酡颜相倚为谁好，仙人自喜朝霞餐。\n山川入眼尽摇落，百卉岂敢誇铅丹。\n石棱苍苔蔚苒苒，花头灏露清漙漙。\n醒时把菊醉凭石，柴桑风致馀江干。\n好事何人得佳本，严陵邑子今郎官。\n郎官博雅近出色，鼻祖与我同新安。\n奉图见过索题品，弹指一春经岁阑。\n哦诗却怜写生手，意匠不减挥毫难。\n玉堂公退尘鞅绝，砚池火烧冰花残。\n临风唤尔金石友，为增骚谱盟鸡坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47501,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甲寅除夕饯岁有作时","author":"程敏政","text":"朝元先自拭宫袍，守岁仍呼煖浊醪。\n三品职衔愁不称，一年诗债幸粗逃。\n东风暗转窥蓬户，北雪公添入鬓毛。\n更属小儿须早起，扈行仙仗莫辞劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47502,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"弘治乙卯正月十一日郊祀分献东海坛纪事","author":"程敏政","text":"瀛东迂拙愧仙才，分奠沧溟此一回。\n金屋雪消风应律，紫坛尘净月当台。\n享神乐备钧天奏，扈跸人从复道来。\n愿积海筹添圣算，常占云气望蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47503,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送工部傅曰会员外荆州抽分","author":"程敏政","text":"南望荆门郢树深，水曹分部称华簪。\n一舟破冻催行李，万木浮江待主临。\n吟草便烦京国梦，扫松兼遂故园心。\n羡馀有献非君事，江汉清风喜自今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47504,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题墨梅寄陕西巡抚王都宪表伦年兄","author":"程敏政","text":"暗香飞沁墨池深，几日春回万玉林。\n喜报陇头消息好，一枝先寄岁寒心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47505,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题志远两浙巡宣卷","author":"程敏政","text":"江东才彦夙超群，浙上巡宣更数君。\n谏院几陈匡国疏，分司常揭劭农文。\n名高古亦来深忌，盗息谁堪策茂勋。\n却幸邦人诗史在，一篇留与四方闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47506,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送庶吉士汪抑之养疾南归","author":"程敏政","text":"几日东风来，河冰已全解。\n之子将告归，离情渺江海。\n念子极英妙，一举魁南宫。\n射策动天子，籍许金闺通。\n选试白玉堂，青萍益增价。\n倚马万言成，触目五行下。\n攻文不自已，稍稍疾见侵。\n经年别桑梓，归梦西江浔。\n承恩出都门，戒道以南往。\n喜有水部兄，图书接官舫。\n忆捧育材诏，我愧章句师。\n群英数请益，空空竟何施。\n与子今暂违，完养无自烁。\n能识舞雩心，行矣当勿药。\n子本越公胄，近出文公乡。\n至言久相领，敢谓一日长。\n遄归定何时，及此答隆遇。\n病起罢春醪，悠然赋长句。\n颇闻二千石，视膳亦有期。\n予言倘印可，一笑誇儒医。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47507,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题杨克仁鸿胪公车奏牍卷","author":"程敏政","text":"口传奇略自先侯，身退常怀致主忧。\n击节几人歌出塞，诵君三策气横秋。\n太平制敌宁忘战，老将成功半伐谋。\n分取剑囊收疏草，他年西系月支头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47508,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送魏黄门秉德延绥盘粮有燎黄之便 其一","author":"程敏政","text":"圣主忧勤念足兵，近臣特奉玺书行。\n离筵暂尔停车骑，外阃遥应识姓名。\n贾谊心劳陈政疏，韩公力筑受降城。\n传家贞观遗忠在，几日封章达帝京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47509,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送魏黄门秉德延绥盘粮有燎黄之便 其二","author":"程敏政","text":"马首春风潞水村，扫松先喜到茔园。\n新开翠碣书慈行，久锡鸾封荷主恩。\n玉节拥尘惊巷陌，锦衣流彩动川原。\n此行孝与忠兼得，为拂溪藤写赠言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47510,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张黄门经两广盘粮","author":"程敏政","text":"手持黄纸下红云，祖席东风酒半醺。\n总道使华当盛选，谁将边粟付虚文。\n行程烟火蛮中市，候馆旌旗岭外军。\n青琐再登知隔岁，皂囊频达九重闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47511,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"请杨贮春太医为栽盆莲","author":"程敏政","text":"老手栽莲不众同，绕阑栽药未论功。\n凭君为致西湖种，添我山棚十丈红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47512,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"胡氏二亲南山遥祝卷","author":"程敏政","text":"遥祝南山启寿徵，木公金母庆相仍。\n酡颜拍拍春同上，短发萧萧雪半增。\n汉历一周开鹤算，禹门三级待蛟腾。\n旧家欢动零陵郭，绮席松醪尽几升。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47513,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送马少卿宗勉谒告归常熟","author":"程敏政","text":"东风吹柳拂征车，感激恩生谒告馀。\n几日从班虚禁苑，一宵归梦绕丘庐。\n碑当有道铭谁撰，诰出颜公手自书。\n暂去即来天子诏，不劳相念托双鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47514,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"樗老行","author":"程敏政","text":"老人有家住吴中，白发被领双颧红。\n南华一卷常在手，富贵过眼惊尘空。\n古樗绕舍青童童，婆娑尽日心神融。\n大株拥肿小拳曲，斧斤自庆逃轮工。\n爨焦久惜吴山桐，霜落亦任吴江枫。\n老人与樗两相契，全身绰有庄周风。\n儿郎秀出芳桂丛，肯构独建诗书功。\n栋梁之需固在此，致身已到明光宫。\n老人迹比树屋佣，老人寿似桃源翁。\n我愚安得往分席，冥冥羡彼云间鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47515,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿李侍御思承母","author":"程敏政","text":"宝婺流辉启寿符，名郎承诏向三吴。\n萱花堂背春占鹊，柏树台端晓集乌。\n云绕旧家邻太岳，酒成新味似蓬壶。\n酡颜百岁知无恙，看取鸾封出帝都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47516,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"首夏斋享宿翰林东署作","author":"程敏政","text":"玉漏沉沉夜下迟，绛河星影动罘罳。\n忽从枕上闻啼鸟，却似南山独卧时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47517,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送傅佐还南京","author":"程敏政","text":"花边江到石城村，鸟外山围白下门。\n川陆自今劳奏事，衣冠他日待承恩。\n閒居字学黄庭在，幕府家传露布存。\n年少壮游浑得意，不须攀柳荐离尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47518,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玩芳亭为段太监次西涯韵","author":"程敏政","text":"沿径入芳园，萧然觉尘迥。\n起登罨画亭，四望如野景。\n平生汉阴志，俛仰惭掣绠。\n墙竹来清风，水花破幽泂。\n主人性爱客，时遣送佳茗。\n摩挲灵璧峰，孰是仇池境。\n妙哉泉石趣，蕞尔车徒骋。\n草色侵帘帏，芸香袭衣领。\n为和郢中篇，烦心坐来省。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47519,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仆所悬学士牙牌乃文懿公旧物今仆已获新制者敢用归之维立寅长侑以一诗用备词林故事且以著杨氏之盛云","author":"程敏政","text":"此牌休道阅人多，兄弟悬来得几何。\n竞爽衣冠誇浙水，承恩先后上鸾坡。\n我惭白雪歌难续，君爱青毡手重摩。\n他日阶庭看转付，森森兰玉待高科。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47520,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五月八日翰林前堂坐书所见","author":"程敏政","text":"公署忙閒不自由，眼中诗料忽相投。\n草分暗茁攻砖罅，槐出横枝荫瓦沟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47521,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送杨志仁宪副谪长沙通判","author":"程敏政","text":"文懿家声却有光，喜从郊野见孤凰。\n许身价抵千金重，爱国心随万里长。\n九辩赋存堪侑席，贰车官好胜监仓。\n当今圣主恩如海，刻日鸣珂入建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47522,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送尹同道还历城","author":"程敏政","text":"情切鸰原众不如，往来无惜走征车。\n百年子女成姻后，几日乡关入望馀。\n白社已开嘉庆宴，红鸾遥报上公书。\n先朝太宰今无恙，为托殷勤问起居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47523,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"莲沚为山东周仲瞻参议赋","author":"程敏政","text":"夜来一沚雨，濯濯明新妆。\n朝来一沚风，苒苒闻清香。\n主人霄汉士，系出汝南房。\n言爱君子花，卓彼草木场。\n摇摇青玉佩，文采丹霞裳。\n净植无纤尘，摩挲共沧浪。\n岂无若耶舟，过眼矜年芳。\n亦有泰华井，吐词落荒唐。\n君家无极翁，故宅遥相望。\n敬读爱莲文，手泽疑未亡。\n溪堂白日远，庭草春风长。\n倚歌赋莲沚，却愧通家郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47524,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"内阁赏芍药次少傅徐先生韵四首 其一","author":"程敏政","text":"玉堂佳地苑墙阴，红药根蟠岁律深。\n题品正宜宗匠手，栽培那识化工心。\n香浮御坐堪谁比，价重名园不易寻。\n前辈赏缘今更续，一编留得凤池吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47525,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"内阁赏芍药次少傅徐先生韵四首 其二","author":"程敏政","text":"花神如在镜中归，七宝妆成入眼稀。\n人立嘉名称近侍，天留奇品殿芳菲。\n药笼重此长医国，诗阵凭谁一解围。\n坐对薰风看未足，半帘斜日下龙扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47526,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"内阁赏芍药次少傅徐先生韵四首 其三","author":"程敏政","text":"宫树花飞尽绿阴，陆离红映掖垣深。\n仙妆露洗羞涂额，国色天成笑捧心。\n池上紫薇元并植，风前黄蝶敢相寻。\n锦亭烂熳金尊赏，消得玄晖一句吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47527,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"内阁赏芍药次少傅徐先生韵四首 其四","author":"程敏政","text":"蕊宫仙子步虚归，困倚南风午梦稀。\n宝鼎半薰香苒苒，锦袍秾衬绿菲菲。\n题惭郢曲歌千数，赏爱胡床列四围。\n莫问扬州三十种，几多抛掷傍岩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47528,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五月十二日公署后园偶步","author":"程敏政","text":"堂西亭子大于瓢，一雨才晴暑半消。\n几日不来亭上坐，拥阶蒿梗绿齐腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47529,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"便面题寄秦恭参将","author":"程敏政","text":"却敌能分北顾忧，齐纨何似掌中筹。\n一挥听取清风起，散作边城六月秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47530,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送进士李应灵赴宣城知县","author":"程敏政","text":"柳丝低蘸水沄沄，百里恩除喜送君。\n登第向来传警策，劝农他日看新文。\n政成拟赋江南乐，才美终空冀北群。\n忽念李邕今不见，旧游踪迹负停云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47531,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题洪克正行乐图","author":"程敏政","text":"峡口青松结成屋，云表苍崖挂飞瀑。\n一观已具四时花，何代雪樵今更续。\n乌帽朱衣林下行，琴书独乐轻浮名。\n须知郡伯有是子，不道侍御难为兄。\n竹底奔淙如剑截，此外黄尘任飞灭。\n磥砢千群翠欲流，离披万树红堪折。\n石栈丹梯不可攀，望中却似天台山。\n愿君寿比洪厓老，他日相期问九还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47532,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖广巡抚韩贯道都宪年兄移治河南有诗见寄次韵奉酬","author":"程敏政","text":"一缄细读晚风前，秀句分明压惠连。\n别计数年书札少，喜占今夜烛花偏。\n寻行我负经帷久，换节君承御墨鲜。\n玉署有怀清不寐，可人明月共遥天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47533,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朴庵先生何公哀挽八章 其一","author":"程敏政","text":"行比先民老更成，耻随流俗竞浮荣。\n家山日暮愁云起，留得庵居朴字名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47534,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朴庵先生何公哀挽八章 其二","author":"程敏政","text":"曾从江上拾遗金，瓦砾相轻见道深。\n野史有人应作传，世人谁是古人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47535,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朴庵先生何公哀挽八章 其三","author":"程敏政","text":"饥氓不道食无粮，贫女还应嫁有装。\n遥想輀车临葬日，几人遮道泪浪浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47536,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朴庵先生何公哀挽八章 其四","author":"程敏政","text":"孔墙东畔起高楼，望见宫前泮水流。\n家训有劳人共指，都台声价重宸旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47537,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朴庵先生何公哀挽八章 其五","author":"程敏政","text":"窗下俄生并蒂瓜，可须红紫斗繁华。\n高人已作全归士，和气犹传积善家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47538,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朴庵先生何公哀挽八章 其六","author":"程敏政","text":"山中逃暑睡方甜，门外于菟识孝廉。\n寿到古稀仍过七，老天明示吉人占。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47539,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]