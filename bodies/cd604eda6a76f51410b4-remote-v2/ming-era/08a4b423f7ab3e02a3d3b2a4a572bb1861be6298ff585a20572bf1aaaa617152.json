039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐汊即事四首 其一","author":"李梦阳","text":"窑头江水叉江头，捩柁挕纶雨不休。\n琐屑漫相誇捷手，蛟龙局浅岂渠游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56164,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐汊即事四首 其二","author":"李梦阳","text":"桃花潭前雪美姿，杨柳滩头柳不迟。\n著心虾蟹章江出，章江只解产颅鹚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56165,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐汊即事四首 其三","author":"李梦阳","text":"北船阻风晴未放，数舸南来却恁飞。\n扶柁长年频看眼，浪翻江叉赵家围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56166,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐汊即事四首 其四","author":"李梦阳","text":"忽吟水宿淹晨暮，七日窑头行路难。\n拚美碧波消北雪，岂期苍鬓且南冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56167,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖行二首 其一","author":"李梦阳","text":"湖雨鸥欢交鹭鹚，鸣榔渔子豢颅鹚。\n逢潭更见孤罾守，可道鄱鱼无尽时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56168,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖行二首 其二","author":"李梦阳","text":"白云今晨乱碧流，秃鹙风赶逐天鹅。\n抢帆额仄谁家舸，逆浪争先尔谓何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56169,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"城南塘汎舟二首 其一","author":"李梦阳","text":"短短桃花亦自春，隔墙飞水太惊人。\n沿洄不怕渔郎入，小小溪塘不是津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56170,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"城南塘汎舟二首 其二","author":"李梦阳","text":"野旷风惊强入舟，鳞鳞浪蹙转堪游。\n持杯只对双杨树，怪尔飞花汎汎流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56171,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春暮过洪园二首 其一","author":"李梦阳","text":"峨冠白首恋金鱼，甲冑红颜水竹居。\n墙上久悬平虏剑，床头新置种桃书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56172,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春暮过洪园二首 其二","author":"李梦阳","text":"出林春笋故当门，榆筴杨花乱扑樽。\n客到剪蔬聊作馔，近城栽柳自成村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56173,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白鼻骝","author":"李梦阳","text":"羽箭银鞍白鼻騧，春日徐行踏落花。\n扬鞭突入章台去，背指垂杨问酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56174,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"少年行","author":"李梦阳","text":"渔阳突骑幽并儿，弯弓射猎南山陲。\n横行未遂为人下，意气凭何结主知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56175,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春游曲二首 其一","author":"李梦阳","text":"骝马银鞍金市头，都门掣电落花流。\n扬鞭笑指胡姬肆，转拂垂杨向玉楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56176,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春游曲二首 其二","author":"李梦阳","text":"大道红楼珠箔垂，风起杨花欲暮时。\n胡姬半醉半遮面，恼杀幽州游冶儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56177,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"绝句","author":"李梦阳","text":"将军铁骑战金微，八月长安尽捣衣。\n砧声欲落三更月，翡翠楼头雁却飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56178,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿歌二首 其一","author":"李梦阳","text":"沙溪三月杜兰香，锦浪千层碧玉光。\n胜日宾筵开玳瑁，槛花飞入万年觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56179,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿歌二首 其二","author":"李梦阳","text":"门对黄山第几峰，翩翩白鹤舞青松。\n玉童来授轩辕诀，素女邀乘赤色龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56180,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"松鹤寿歌","author":"李梦阳","text":"松袅石门千仞开，天风吹鹤下瑶台。\n传书为问西王母，别后蟠桃熟几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56181,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夷门十月歌","author":"李梦阳","text":"小麦青青水半陂，半落不落杨柳枝。\n回风忽送天南雁，恰似春江二月时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56182,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄河风雪词","author":"李梦阳","text":"渺渺黄河风雪生，云愁海思不堪行。\n阳春白雪非难和，公无渡河无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56183,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"异景","author":"李梦阳","text":"异乡异景客中身，秋雨秋烟无那春。\n梁园八月如三月，笑杀桃花更笑人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56184,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春佘庄","author":"李梦阳","text":"暇即来游困即眠，玉杯长醉彩云前。\n春风暮起杨花乱，疑是梁园雪里天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56185,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浔阳歌","author":"李梦阳","text":"百尺高楼横映江，江花朵朵照成双。\n风波隔浦遥相唤，肠断南来北去艭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56186,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"汴中元夕五首 其一","author":"李梦阳","text":"花烛沉沉动玉楼，月明春女大堤游。\n空中骑吹名王过，散落天声满汴州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56187,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"汴中元夕五首 其二","author":"李梦阳","text":"玉馆朱城柳陌斜，宋京灯月散烟花。\n门外香车若流水，不知青鸟向谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56188,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"汴中元夕五首 其四","author":"李梦阳","text":"四海烟花逢上元，中州行乐竞千门。\n大江不辨鱼龙戏，珊瑚宝玦是王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56189,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七夕","author":"李梦阳","text":"云寂露凉丛蕙悲，意衔情恨隔年期。\n残机夜歇金萤度，怨女啼春玉箸垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56190,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"狱雨二首 其一","author":"李梦阳","text":"冷雨横天八月来，黑云来往赤云开。\n浔阳李白何如此，宋玉悲秋未是哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56191,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"狱雨二首 其二","author":"李梦阳","text":"雨打潮门流海烟，随风散落凤城前。\n愚臣独抱枯鱼泣，何日金鸡下九天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56192,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]