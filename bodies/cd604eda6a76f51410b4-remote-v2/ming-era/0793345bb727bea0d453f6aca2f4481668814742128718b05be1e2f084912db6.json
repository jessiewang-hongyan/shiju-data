[{"title":"大学士赵公招饮小憩章行父馆中作","author":"胡应麟","text":"尺五瀛洲路，频过户不扃。\n漏长中极殿，春满太玄亭。\n舞鹤花间度，飞鸾竹外停。\n最怜调鼎暇，吐握共忘形。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16531,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"是夕留饮至丙夜诘旦再呈此章","author":"胡应麟","text":"紫极方延伫，黄扉乍卜欢。\n上公能结袜，羁客尽弹冠。\n玉脔移中禁，琼浆出大官。\n夜阑台斗色，清切动长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16532,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访苏君禹城南别墅时郎君新获隽计偕二首 其一","author":"胡应麟","text":"韦杜城南曲，经过路不遐。\n重垣千树枣，曲径四时花。\n楚思融春雪，燕歌促暮霞。\n日斜羸骑返，睥睨半栖鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16533,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访苏君禹城南别墅时郎君新获隽计偕二首 其二","author":"胡应麟","text":"岂是东山墅，频张北海筵。\n帝城云色近，仙掌日华悬。\n旧燕纷窥幕，新莺促和弦。\n坐看池上凤，矫翼向甘泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16534,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云岭真松卷为崔母杨孺人题 其一","author":"胡应麟","text":"朗月悬西极，高风劲北堂。\n云松千尺秀，冰蘖万年芳。\n跨凤春情杳，丸熊夜漏长。\n惠文看哲胤，飞诏下明光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16535,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云岭真松卷为崔母杨孺人题 其二","author":"胡应麟","text":"一醮悲前事，三迁训后贤。\n即今衣绣日，犹是断机年。\n黄鹤瑶池下，青鸾玉座传。\n蚤知骢马客，风化遍淮瀍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16536,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题杨孝子卷为世叔孝廉","author":"胡应麟","text":"当年排帝阙，万死白虹知。\n楚泽长醒夜，燕台困饿时。\n有天号半菽，无地献三芝。\n藉甚遗孤在，干将对陆离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过苏生期歌者小谢不至戏作","author":"胡应麟","text":"寂寞看花兴，徬徨伐木歌。\n虚闻莺出谷，未见鹊填河。\n暮雨当窗断，春星入户多。\n明朝携小谢，池草梦如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠騄儿","author":"胡应麟","text":"騄儿才五岁，意气欲凌霞。\n骨已徵千里，书应诵五车。\n神清珠在握，体润玉无瑕。\n莫作鸡群拟，终当胜阿爷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邬子远还京口","author":"胡应麟","text":"倦索长安米，言寻旧鹤群。\n传家中宪业，负笈太玄文。\n客路樱桃雨，归帆杜若云。\n卜居何日事，携尔大江濆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠胡孝廉昌世","author":"胡应麟","text":"旅食渭桥边，青萍僦舍悬。\n骊珠溟海握，骏足蓟台捐。\n谒帝留孤愤，逢人话太玄。\n凭收嫁时泪，会有惜婵娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠璚树为顾朗生","author":"胡应麟","text":"艳色真琼树，丰肌倍玉环。\n红妆停夜月，翠黛压春山。\n飞凤秦台下，游龙洛浦还。\n相思几攀折，遮莫鬓毛斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临淮席上蔡生乞诗作时王山人在坐","author":"胡应麟","text":"龙阳君已贵，一笑眼能青。\n玉树标前砌，金茎梦后庭。\n声驰千里骥，歌送五侯鲭。\n莫以安期旧，揶榆蔡克灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过王山人啜茗作","author":"胡应麟","text":"束书来蓟北，题赋遍江南。\n不慕千钟粟，时分一味甘。\n苍筠摇午梦，黄叶坠清谈。\n细酌天池坐，何殊绣佛龛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钟天毓过访索诗赋赠","author":"胡应麟","text":"沾沾越吟客，穷巷又移居。\n旧著参军品，新临太傅书。\n花香萦短屐，柳色傲长裾。\n寂寞黄金馆，谁今问子虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱山人以非罪淹狱赋慰","author":"胡应麟","text":"泄柳门时闭，邹阳狱未苏。\n瓜田宁纳履，药肆尚悬壶。\n业就肱先折，愁深目半枯。\n青天覆盆底，见汝出穷途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过刘茂才百世读其玄珠诸稿作","author":"胡应麟","text":"似汝年犹少，投予赋已工。\n青藜三世后，赤帜万人中。\n朗润知潘似，清扬忆卫同。\n韶颜吾尽掷，一怆异时红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人游塞上","author":"胡应麟","text":"晓发灞陵桥，弯弓箭在腰。\n黄沙随地阔，紫塞极天遥。\n玉乳蒲萄熟，金羁苜蓿骄。\n贺兰千百仞，飞骑上岧峣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送章秀才从军","author":"胡应麟","text":"白草暮萧萧，黄榆叶半飘。\n四时风不断，经岁雪难消。\n大碛逢侦骑，平沙见射雕。\n兵锋随所指，百战静氛妖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠杨文学","author":"胡应麟","text":"身世一袍青，柴关尽日扃。\n鹿门传旧业，玄阁抱遗经。\n玉树祥云拥，金茎湛露零。\n异时飞紫诰，何羡客为星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和赵相国怀山八咏 其一 栖真居士","author":"胡应麟","text":"北极恩偏注，东山兴未穷。\n民犹歌畏垒，帝已问空同。\n绛阙星辰丽，彤墀日月崇。\n宁知西竺想，寤寐化人同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和赵相国怀山八咏 其二 六虚主人","author":"胡应麟","text":"翠屏罗窈窕，丹壑敞嶙峋。\n独占三山色，长栖六洞神。\n云霞居士梦，宇宙宰官身。\n几夜骑羊客，传书到玉宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和赵相国怀山八咏 其三 二初牧侣","author":"胡应麟","text":"炼药闲金灶，宣麻上玉除。\n黄庭弘景箓，碧洞稚川书。\n鹤化翀霄后，羊眠叱石馀。\n赤松如待牧，前席为谁虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和赵相国怀山八咏 其四 紫霞洞叟","author":"胡应麟","text":"巨磴山腰豁，流霞洞口平。\n阙疑屯紫气，馆忆坐朱明。\n草色金光绽，桃脂玉乳瑩。\n为探轻举候，少俟大还成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和赵相国怀山八咏 其五 灵溪渔父","author":"胡应麟","text":"泽畔吟初就，溪头望未涯。\n坐携青竹筱，行趁碧桃花。\n锦曳千林雾，绡疑万树霞。\n秦人遗核在，一种帝王家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和赵相国怀山八咏 其六 白云樵客","author":"胡应麟","text":"古树白云含，晴光上郁蓝。\n为霖今塞北，挟雾旧东南。\n石上凝苍霭，峰头杂翠岚。\n万方膏雨洽，出岫讵空谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和赵相国怀山八咏 其七 涌雪寒翁","author":"胡应麟","text":"一涧蜿蜒出，胡麻饭有无。\n云淙穿石窦，雪乳喷冰壶。\n峡峭凭舟探，潭深藉杖扶。\n隔凡天咫尺，归梦夕阳徂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和赵相国怀山八咏 其八 玉露丹仙","author":"胡应麟","text":"石室清虚畔，研朱坐泬㵳。\n空濛流月窟，点滴贮天瓢。\n掌忆金仙近，盆怜玉女遥。\n他年把周易，骑鹤上岧峣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭汪司马伯玉十首 其一","author":"胡应麟","text":"北阙悬车蚤，东林曳杖馀。\n神留中土卧，帝命太函居。\n五岳藏玄草，三天坠白榆。\n庭阶双玉在，雪涕茂陵书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭汪司马伯玉十首 其二","author":"胡应麟","text":"青萍悬虎穴，赤帜树龙门。\n居后杨宁耻，齐名杜转尊。\n星枢摧轸翼，天柱折昆崙。\n白玉楼前侣，飞云限九阍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭汪司马伯玉十首 其三","author":"胡应麟","text":"杖钺平边塞，麾戈逐战场。\n风霆流武库，河斗烛文昌。\n玉帐三韩外，铜标百粤傍。\n祗今吉甫颂，犹自播夷方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭汪司马伯玉十首 其四","author":"胡应麟","text":"黄山初谒帝，玄扈旧栖神。\n华夏悲司马，春秋痛获麟。\n名犹标泰岱，魄已化星辰。\n寂寞东南事，文章孰后尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭汪司马伯玉十首 其五","author":"胡应麟","text":"一榻中林畔，如椽大海头。\n丰碑腾六合，巨榜揭千秋。\n妓狎东山卧，宾残北海游。\n琅琊双墓在，天意合吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭汪司马伯玉十首 其六","author":"胡应麟","text":"汉阁空刘向，扬亭逝子云。\n中原谁步武，上界已修文。\n马骨骊黄外，蛟珠鸭绿濆。\n异时传汲冢，一代有三坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭汪司马伯玉十首 其七","author":"胡应麟","text":"浮生偕电露，名理悟幡风。\n浊酒谈中圣，清斋问大雄。\n净名居士榻，忉利梵王宫。\n此日三车去，悬知二业同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭汪司马伯玉十首 其八","author":"胡应麟","text":"黄粱殊未熟，大梦竟难呼。\n兜率天高下，遮须界有无。\n文成歆上帝，草定属潜夫。\n伏枥今谁辩，长歌碎玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭汪司马伯玉十首 其九","author":"胡应麟","text":"龙宫开净业，鹫岭学枯禅。\n障息三天外，神游万劫前。\n空花函谷梦，祇树肇林缘。\n谁复偕苏晋，长斋绣佛筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭汪司马伯玉十首 其十","author":"胡应麟","text":"邂逅平原饮，飘然夜雪过。\n寸心雄海岱，只语废江河。\n落日生刍远，悲风大树多。\n如渑犹夙昔，万恨掷蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"香山寺流憩亭小酌逢张郑应季四文学邀宿华严洞余与诸子素昧平生酒酣兴发策蹇十里从之诘朝复抵碧云泉上","author":"胡应麟","text":"十里华严寺，重游不厌频。\n携尊三市客，击筑五陵人。\n野筱长封雪，池莲不受尘。\n故园沧海上，飞梦绕垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送倪明府之桐城","author":"胡应麟","text":"河梁尊酒别，霜树半遥空。\n骏市燕台上，凫飞汉殿中。\n桐花城畔月，桃叶渡头风。\n最羡琴堂色，青苍对皖公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李少府","author":"胡应麟","text":"都亭尊酒别，秋叶照离筵。\n菊绽燕台下，松哦越峤前。\n孤航冲雨雪，短剑拂星躔。\n咫尺徵贤诏，黄金汉殿前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵进士使太原","author":"胡应麟","text":"秋水木兰桡，双旌出渭桥。\n飞云行上党，积雪过中条。\n谒帝朱衣近，宁亲绣服遥。\n向来龙剑影，辉赫电光摇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过董中翰体仁余廿载前旧友也别后始授室燕中今一子已踰冠矣感念今昔为之怃然","author":"胡应麟","text":"廿年燕市客，尔外更谁存。\n逆旅推耆旧，他乡见子孙。\n花香分玉殿，藜火直金门。\n笑我青衫敝，西风曳帝阍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同王行父李叔操徐象先诸子十日饮作","author":"胡应麟","text":"懒习干时技，聊同玩世人。\n华阳宁异代，河朔动经旬。\n旅兴先黄菊，乡愁过白蘋。\n莫教龙剑色，容易射星辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"廿载前读王汝化诗已意其为古人迩晤李本建乃知此公仅百龄尚无恙也因赋一律寄之","author":"胡应麟","text":"磊落王宫翰，青编入梦频。\n那知三楚客，遍阅五朝人。\n艺圃占灵药，词林颂大椿。\n前村武陵洞，相对几遗民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汪象先伯仲还新安二首 其一","author":"胡应麟","text":"叹息金兰逝，参差玉树长。\n多才秦别驾，雅量陆平章。\n马鬣封仍下，龙门副永藏。\n河桥相送地，抆泪滴干将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汪象先伯仲还新安二首 其二","author":"胡应麟","text":"烨烨名家后，翩翩上国来。\n玄经司马业，文赋士龙才。\n玉閟丰干社，金残碣石台。\n喧传茂陵诏，汉使下蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何仁仲之南都二首 其一","author":"胡应麟","text":"去去何公子，春风一骑寒。\n含香辞上国，傅粉入长干。\n桃叶江帆稳，梅花郡阁残。\n芳洲寻白鹭，何似故园看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何仁仲之南都二首 其二","author":"胡应麟","text":"祖帐春明外，桃花别路长。\n暂韬题赋笔，初绾纳言章。\n观入新鳷鹊，台呼旧凤凰。\n昼游欢咫尺，一水是潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送崔子玉之逢州","author":"胡应麟","text":"春水潞河舟，春风拂面柔。\n飞骖临剑阁，别驾问刀州。\n懒卜严遵肆，频登杜甫楼。\n巫山行雨暇，入梦正高秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人还四明","author":"胡应麟","text":"怅望春风色，河桥落照间。\n酒人三市别，狂客四明还。\n再举看黄鹄，孤飞羡白鹇。\n新妆苧萝下，吾梦亦潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送区学文还岭南","author":"胡应麟","text":"彩笔吾衰甚，惊看白面郎。\n家传周太史，殿赋鲁灵光。\n上国啼鹃尽，东风结驷长。\n罗浮花事早，月夜见明妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集张仲立馆中同胡孟韬赋","author":"胡应麟","text":"世事真鸡肋，吾侪日蟹螯。\n撩人偏笋蕨，作客又樱桃。\n业岂穷来擅，名应醉里逃。\n相看聊起色，毋拟曲江涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡昌世张仲立过访小集","author":"胡应麟","text":"何限春风色，长安醉碧桃。\n双携蒯缑剑，一话郁轮袍。\n射虎心犹剧，屠龙思并豪。\n平康花烂漫，未肯负持螯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李能茂五首 其一","author":"胡应麟","text":"命岂文章达，才偏造物憎。\n霜蹄残騕袅，风翮坠鲲鹏。\n大业愁中废，雄图怅代兴。\n兰陵川上酒，犹忆共如渑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李能茂五首 其二","author":"胡应麟","text":"肺病呻吟外，魂摇弃掷年。\n千秋迟白纻，万恨剧青毡。\n鸡鹜争谁得，龙蛇命岂然。\n玄亭莽空阔，愁绝异时传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李能茂五首 其三","author":"胡应麟","text":"世事狂歌外，人才太息中。\n篇章亡白贺，翰墨逝冰邕。\n弱女啼荒径，孤嫠咽殡宫。\n棠梨最无赖，满树发东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李能茂五首 其四","author":"胡应麟","text":"世谁怜薄禄，天亦忌雄才。\n落月长鲸去，悲风大鸟来。\n遗书残竹素，旧宅翳蒿莱。\n绝顶芙蓉上，曾同眺越台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李能茂五首 其五","author":"胡应麟","text":"青山曾不厌，朱绂定谁强。\n宇宙瑶华歇，川原玉树藏。\n无年嗟太傅，有业恨中郎。\n寂寞安昌第，堪谁到后堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送沈明府之竹溪二首 其一","author":"胡应麟","text":"一骑芦沟畔，西风落叶号。\n那知花县客，犹是竹林豪。\n雾拥双飞舄，霞蒸八咏毫。\n黄金悬汉殿，侧席待贤劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送沈明府之竹溪二首 其二","author":"胡应麟","text":"暂握铜章去，花封未寂寥。\n囊琴辞上国，岸帻望中朝。\n赋就湘潭竹，书传霅水苕。\n吴娃妆閤畔，计日候兰桡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永叔方舟豪饮即事十首时行次齐鲁卫间 其一","author":"胡应麟","text":"彩服荣新命，绨袍恋旧知。\n河梁晨舣棹，水国夜衔卮。\n渡远携桃叶，滩长和竹枝。\n疏灯解娱客，花艳朴谈诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永叔方舟豪饮即事十首时行次齐鲁卫间 其二","author":"胡应麟","text":"锦席时先后，清尊日过从。\n荒城严夜柝，远寺咽昏钟。\n意气红颜盛，心期白首浓。\n即今元礼棹，谁复共林宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永叔方舟豪饮即事十首时行次齐鲁卫间 其三","author":"胡应麟","text":"鼓吹中流发，图书四壁陈。\n高谈回丙夜，大雅和阳春。\n水驿驰关吏，津亭候榜人。\n雄飞吾党事，一快倦游身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永叔方舟豪饮即事十首时行次齐鲁卫间 其四","author":"胡应麟","text":"海月维仙缆，天风度客樯。\n赋题新赤壁，吟和旧沧浪。\n汎汎俱西子，依依但北堂。\n江鱼如玉雪，满载大家尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永叔方舟豪饮即事十首时行次齐鲁卫间 其五","author":"胡应麟","text":"云霄惭比翼，湖海豁遐心。\n一驻青丝窄，同携白玉琴。\n清吟霞色烂，剧语露华侵。\n快意篷窗下，天池酌水沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永叔方舟豪饮即事十首时行次齐鲁卫间 其六","author":"胡应麟","text":"大有乘桴兴，能无汎宅游。\n垂天双翼左，缩地寸心投。\n卤簿黄河岸，帆樯碧海流。\n支机怀袖满，昨夜到牵牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]