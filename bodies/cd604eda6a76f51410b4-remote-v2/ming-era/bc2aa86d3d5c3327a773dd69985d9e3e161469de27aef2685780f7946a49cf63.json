[{"title":"和答喻扬庵郡公五首 其二","author":"孙承恩","text":"种竹期三径，栽花亦数枝。\n溪山馀远兴，天地入新诗。\n尘世久成厌，清时难便辞。\n终当返初服，猿鹤共追随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答喻扬庵郡公五首 其三","author":"孙承恩","text":"遗老吾何敢，居閒得自怡。\n力耕聊卒岁，久病欲忘诗。\n盛美嗟谁及，迂疏忝受知。\n最怜公务剧，扳屈愧无期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答喻扬庵郡公五首 其四","author":"孙承恩","text":"卜筑真成戏，幽栖任俗猜。\n登临屈冠盖，光彩动蒿莱。\n自愧盘飧薄，能将怀抱开。\n迂疏或不弃，乘兴肯重来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答喻扬庵郡公五首 其五","author":"孙承恩","text":"叩户醒残梦，开门得好诗。\n骊珠惊到眼，宿疴忽如医。\n喜溢高歌久，才疏勉和迟。\n小亭成胜事，幽寂动春姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜雨","author":"孙承恩","text":"小雨看终日，昏来洒更微。\n新凉透疏簟，馀润湿书帏。\n宿鸟翻枝警，流萤触暗飞。\n云间淡星月，时复见依稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨不止再咏","author":"孙承恩","text":"黯黯连旬雨，阴云只自浮。\n竹窗巢翡翠，粉壁上蜗牛。\n野径人行少，溪塘水漫流。\n病夫为岁计，兀坐正含愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨益甚再咏","author":"孙承恩","text":"淅沥无时歇，俄惊忽沛然。\n疾奔横迥野，密洒暗长川。\n槛水看将溢，茅堂惧欲穿。\n苍茫浑不解，默默向穹玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨后邀友人","author":"孙承恩","text":"寂寞孙康宅，幽怀若与论。\n昨宵时雨过，今日绿阴屯。\n傍槛先铺簟，临流重洗尊。\n即看能枉驾，候子立柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中和答友人","author":"孙承恩","text":"风雨飘萧至，烟霏日夕深。\n二仪莽回合，万象尽阴森。\n龙蛰惭高隐，鹤鸣怀好音。\n何由得联席，重话百年心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨止","author":"孙承恩","text":"稍稍风生树，疏疏雨散痕。\n清溪明素练，斜日烂赪盆。\n粉蝶过吟幔，沙鸡舞竹根。\n幽寻何可已，拟一过前村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答詹东鲁年兄","author":"孙承恩","text":"寄兴有孤亭，居贫亦自清。\n野花当槛落，山鸟近人鸣。\n雅意师樊子，多才愧长卿。\n此心无俗累，永夜月同明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊月过东庄命园丁插柳","author":"孙承恩","text":"寂寂东庄晚，萧萧风正严。\n柳阴常愧薄，此月更应添。\n未拟成深径，还教覆短檐。\n明年看蓊郁，云幕映青帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张石盘侍御年兄过访之作二首 其一","author":"孙承恩","text":"倒屣迎骢马，焚香共草堂。\n情因樽酒洽，兴逐野云长。\n子特来乘暇，吾翻得少忙。\n不缘重交谊，经月懒冠裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张石盘侍御年兄过访之作二首 其二","author":"孙承恩","text":"曲径通蔬圃，清溪带草堂。\n野花随意好，鸣鹤向人长。\n得得閒中趣，悠悠物外忙。\n偶闻谈出处，为子欲褰裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别石盘二首 其一","author":"孙承恩","text":"道谊交情重，江湖别意深。\n清樽聊此话，何日更同斟。\n慷慨悲时事，蹉跎愧壮心。\n向来忧国泪，相对各沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别石盘二首 其二","author":"孙承恩","text":"去去从此别，重逢亦杳然。\n乾坤双眼阔，岁月寸心悬。\n失学嗟予病，忧时念子贤。\n明朝何处望，风雨隔江天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东里草堂二首为表兄赋 其一","author":"孙承恩","text":"屋后桑麻长，檐牙鸟鹊喧。\n丛篁深夹径，乔木翠当轩。\n自适清真态，都无俗累烦。\n优游百年内，此外更何言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东里草堂二首为表兄赋 其二","author":"孙承恩","text":"吾生厌尘俗，羡子得深栖。\n座有鸿生至，门无凤字题。\n绿蒲抽水直，朱果压枝低。\n此日从君饮，真?醉似泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晨起","author":"孙承恩","text":"避俗常忻静，晨兴亦不妨。\n疏星映幽户，寒露落芳塘。\n花竹辉书幌，琴尊静草堂。\n不缘有幽事，自是惜流光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜","author":"孙承恩","text":"露下闻蛩早，城中击柝频。\n惊风时搅树，明月似窥人。\n壮志看雄剑，中年歉病身。\n悲歌还出户，徙倚望星辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨后过友人别业","author":"孙承恩","text":"雨过郊原净，幽居惬老夫。\n弄晴花欲语，得意鸟频呼。\n风柳千丝袅，烟莎一望铺。\n欲过故人话，须挈杖头壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"克嗣侄毕姻示以诗二首 其一","author":"孙承恩","text":"尔父违而早，天遗后死悲。\n友于情曷已，对汝泪空垂。\n鞠育归惟我，承传系有谁。\n室家大人行，须效大人为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"克嗣侄毕姻示以诗二首 其二","author":"孙承恩","text":"造次嗟贫薄，区区毕此心。\n都将百年泪，一彻九泉深。\n儒素由来旧，家风岂独今。\n淫奢人易溺，俛仰一沉吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题便面二首 其一","author":"孙承恩","text":"寂历青山晚，悠然似古春。\n溪云生白石，茅屋断红尘。\n岚重浑疑雨，山深不遇人。\n秪应桥下水，照见白纶巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题便面二首 其二","author":"孙承恩","text":"脱屣浮云远，幽居赋考槃。\n秋衣裁薜荔，长佩缬芝兰。\n白日吟边过，青山天际看。\n松风惊谡谡，吹我切云冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日放舟","author":"孙承恩","text":"鼓楫春江上，幽怀无奈何。\n轻风泛蒲柳，斜日荡烟波。\n岁月双吟屐，乾坤一钓蓑。\n济川成底事，吾意渐蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起二首 其一","author":"孙承恩","text":"一卧兼旬日，居然怯病魔。\n山中寡尘事，静里见天和。\n邻父抄方送，门生载酒过。\n朝来颇强健，还我称弦歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起二首 其二","author":"孙承恩","text":"久病朝来栉，徐行力尚慵。\n幽花浑自媚，野鹤故能从。\n望远劳昏眦，临池歉瘦容。\n焚香还静坐，书卷任飘风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为杨士行题扇景二首 其一","author":"孙承恩","text":"林木散清霁，微风度水迟。\n扁舟荡落日，红色照吟髭。\n逸兴孤云远，閒情白鸟知。\n美人渺何许，幽赏共襟期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为杨士行题扇景二首 其二","author":"孙承恩","text":"老树颓崖石，轻舠拂渚矶。\n水花含晚净，沙鸟近人飞。\n凉吹还欹帽，晴云欲染衣。\n何由添入我，吟倚对斜晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又题扇景士行号晴川","author":"孙承恩","text":"碧汉烟俱敛，幽岩花欲然。\n美人多逸兴，载酒过前川。\n傲睨天垂野，啸歌风满船。\n何当三泖上，似尔亦飘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月廿七日借曹锦溪舟出郭小泛戏作呈舟主一笑二首 其一","author":"孙承恩","text":"画舸随潮发，幽怀颇自宜。\n鹭移参别渚，蝉咽送高枝。\n碧水静风浪，黄花惊岁时。\n世途多感慨，吾意欲何之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月廿七日借曹锦溪舟出郭小泛戏作呈舟主一笑二首 其二","author":"孙承恩","text":"摇落楚江湄，秋风独棹时。\n孤云淡离思，斜日照吟髭。\n忽想横江鹤，因看入水鹚。\n天随有真趣，吾欲共襟期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜露坐甚适","author":"孙承恩","text":"月出炎氛息，空庭爽气浮。\n斗杓初北指，河汉欲西流。\n竹卧横侵榻，萤飞径过楼。\n坦然无俗累，自觉兴优游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"督园丁溉菊","author":"孙承恩","text":"元亮归来兴，黄花岁晚心。\n数枝浑自秘，九日漫将临。\n会见风霜肃，全资灌溉深。\n东篱吐幽艳，我欲对清吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独坐","author":"孙承恩","text":"旭日照檐楹，高斋虚更明。\n闭门幽意惬，隐几篆烟清。\n野鸟每双下，林蝉时一鸣。\n敢云抛世累，暂尔学无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵谢吴黄洲郡守过访","author":"孙承恩","text":"瞻企时常切，追陪此日亲。\n偶同山简兴，来赏习池春。\n真率惟蔬具，迂疏愧野人。\n醉馀犹自整，随意岸乌巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"借韵述怀二首 其一","author":"孙承恩","text":"地僻尘喧少，幽居谁与亲。\n琴樽消侠气，花柳媚长春。\n感事频怀古，逃名欲避人。\n百年天地里，白日照乌巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"借韵述怀二首 其二","author":"孙承恩","text":"避世非吾事，幽居迹颇同。\n石田锄夜月，茅屋领春风。\n文债蹉跎有，江天梦寐空。\n怀人渺无极，望入泬寥中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月","author":"孙承恩","text":"天上繁霜降，人间秋色深。\n千林飞落叶，万户动疏砧。\n憔悴潘郎鬓，低回宋玉心。\n吟诗欲排闷，哀咏更难禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"菊","author":"孙承恩","text":"野菊丛丛艳，清香细细寒。\n孤根谢桃李，幽致契芝兰。\n欲共陶翁醉，思遗屈子餐。\n小斋明棐几，移得一枝看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日泛舟","author":"孙承恩","text":"幽意渺无著，溪边掉小舟。\n天晴鸣野鹤，浪稳趁轻鸥。\n不俟鉴湖请，聊同笠泽游。\n悠悠随所适，吾欲听渔讴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋晚村行","author":"孙承恩","text":"步屧江村晚，西风小作秋。\n深林喧鸟雀，落日下羊牛。\n机杼千家共，田禾一望收。\n偶同野老话，鸡黍为迟留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悲秋","author":"孙承恩","text":"海上凉风动，山中秋日深。\n百年摧短景，万里接层阴。\n冻蕊依时放，寒蝉恋树吟。\n平生摇落意，卧病更难禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观刈稻","author":"孙承恩","text":"秋霁郊原净，平畴刈穫空。\n千林留夕照，隔坞听高舂。\n数口劳生计，三时念仆功。\n流移多未复，能得几家同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈秋日漫兴十二首 其一","author":"孙承恩","text":"禁密邻天上，清閒学瀼西。\n风光不相负，笔砚且幽栖。\n径僻花通牖，阶深藓护泥。\n兴来得佳句，自向壁间题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈秋日漫兴十二首 其二","author":"孙承恩","text":"雨后蛙喧吹，风前鹤报衙。\n观书焚柏子，临帖泛松花。\n客至檐鸣鹊，天晴散晚霞。\n此中清寂甚，底处着纷华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈秋日漫兴十二首 其三","author":"孙承恩","text":"院静如僧寺，官閒类隐居。\n冻云低接树，露井暗通渠。\n虑淡入禅定，心游到古初。\n自知迂拙甚，底处曳吾裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈秋日漫兴十二首 其四","author":"孙承恩","text":"忽忽悲时事，悠悠念此心。\n道穷知己少，性僻避人深。\n树色阴连屋，花香淡拂襟。\n尽于疏懒便，无补费光阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈秋日漫兴十二首 其五","author":"孙承恩","text":"虚馆深秋色，閒情坐日西。\n幽花当槛落，小鸟傍檐栖。\n石罽苔漫砌，天书鹤篆泥。\n虽无观物妙，兴至亦堪题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈秋日漫兴十二首 其六","author":"孙承恩","text":"閒官稀候吏，玉署例槐衙。\n树隙鸟窥牖，水边鱼唼花。\n断虹低返照，残雨乱明霞。\n自是神仙境，幽幽远世哗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈秋日漫兴十二首 其七","author":"孙承恩","text":"未老先欣懒，辞人惯索居。\n爱花频葺土，引水亦穿渠。\n乳燕离巢后，高梧落叶初。\n时防候谒吏，聊复整冠裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈秋日漫兴十二首 其八","author":"孙承恩","text":"信步独行吟，悠悠太古心。\n鸟声听处惯，山色望中深。\n憩石频搔首，临风一振襟。\n片云应送雨，小院落虚阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈秋日漫兴十二首 其九","author":"孙承恩","text":"喜看残暑退，短景日行西。\n兀坐偏神爽，冥心与道栖。\n风轻蛛葺网，雨过蚓蟠泥。\n诗拙惭人看，唯应僻处题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈秋日漫兴十二首 其十","author":"孙承恩","text":"庭空下饥雀，吏散早休衙。\n引鹤寻芳草，教童扫落花。\n有书消白日，无句咏青霞。\n市远人声静，真堪断俗哗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈秋日漫兴十二首 其十一","author":"孙承恩","text":"林宗好孙子，如我好閒居。\n得句频贻我，论交最忆渠。\n异闻多白帖，妙句拟黄初。\n薄劣真无似，深惭共曳裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭杏冈秋日漫兴十二首 其十二","author":"孙承恩","text":"慷慨千年事，低回一寸心。\n行吟白日晚，怅望碧云深。\n旷志思超世，虚怀不满襟。\n济时吾岂敢，卷里较陶阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日漫兴用前韵十二首 其一","author":"孙承恩","text":"徙倚当清昼，花阴渐转西。\n小诗妨实学，野性惬幽栖。\n排闼迎山色，移床避燕泥。\n无边风物好，随意入新题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日漫兴用前韵十二首 其二","author":"孙承恩","text":"吏隐吾兼得，高斋休早衙。\n琴樽消意气，风日醉莺花。\n抚石衣生润，临书字剪霞。\n极知成散诞，聊复避喧哗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日漫兴用前韵十二首 其三","author":"孙承恩","text":"自任清真态，难同木石居。\n花浓阴照砌，草细浅笼渠。\n正是蚕眠候，相将麦熟初。\n城南闻更好，欲向涤尘裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日漫兴用前韵十二首 其四","author":"孙承恩","text":"疏拙从吾性，幽閒快赏心。\n断云随鸟没，清漏隔花深。\n聊适吟中趣，谁题汉上襟。\n小庭成久坐，茂树有馀阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日漫兴用前韵十二首 其五","author":"孙承恩","text":"坐惜春将晚，行吟日又西。\n鸟皆忻竞啄，鹤只爱孤栖。\n淡荡频催煖，廉纤不作泥。\n诗成诧朋辈，绝胜竹间题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日漫兴用前韵十二首 其六","author":"孙承恩","text":"近侍元非吏，瀛洲岂是衙。\n有莺皆唤友，无树不飞花。\n点易研清露，希真咀绛霞。\n从来轻世务，不独厌纷哗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日漫兴用前韵十二首 其七","author":"孙承恩","text":"此日江南景，吾思水竹居。\n槛边巢翡翠，花底戏雍渠。\n游客提壶处，农家布谷初。\n怀人邈难即，谁与共襟裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日漫兴用前韵十二首 其八","author":"孙承恩","text":"节物随时变，浮云任此心。\n花香捲幔入，草色闭门深。\n感事空弹铗，怀贤每正襟。\n留连未归去，斜日度轻阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日漫兴用前韵十二首 其九","author":"孙承恩","text":"厌俗俗难避，望山山更西。\n独怜玉署静，时有白云栖。\n对此花成阵，何妨醉似泥。\n好吟吾亦癖，重和隔年题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日漫兴用前韵十二首 其十","author":"孙承恩","text":"澹澹云生暝，阴阴日过衙。\n小窗穿燕子，高栋拂杨花。\n调瑟弦流水，醪醇斝泛霞。\n出门即尘市，车骑正喧哗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日漫兴用前韵十二首 其十一","author":"孙承恩","text":"喜有同心友，时来慰索居。\n清谈成款洽，高谊正勤渠。\n消息占羲画，幽玄溯太初。\n却怜寡昧者，还此愧襟裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日漫兴用前韵十二首 其十二","author":"孙承恩","text":"对景忽无语，何人识此心。\n寻花穿屈曲，洗砚汲清深。\n小鼎时添火，晴窗漫解襟。\n踏枝何处雀，搅碎一庭阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]