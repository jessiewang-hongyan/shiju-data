[{"title":"秋日还山 其一","author":"区大相","text":"秋山久不到，每与秋风期。\n绝涧倒槎碍，悬崖枯蔓垂。\n马疲知旧路，松古发新枝。\n遂欲投簪绂，长歌与世辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日还山 其二","author":"区大相","text":"村边黄叶路，溪上白云岑。\n草屋山家浅，松门野寺深。\n群鱼依密藻，独鹤返高林。\n若问还山事，多应负此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日还山 其三","author":"区大相","text":"频年寄书意，及此返柴关。\n泉响竹间石，霞明林外山。\n无人共长往，有客暂投闲。\n何事金门老，风尘却忘还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒先墓 其一","author":"区大相","text":"久宦抛庐舍，衔恩展墓田。\n岁时违洒拂，霜露几凄然。\n马踏残秋草，乌啼古树烟。\n孤忠犹未白，何敢报重泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒先墓 其二","author":"区大相","text":"地下音容在，人间岁月侵。\n年将世泽远，江与泪痕深。\n鸟雀荒村路，松楸久客心。\n空劳岵屺咏，终废蓼莪吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再宿溪上楼三兄读书处 其一","author":"区大相","text":"弭节上兹楼，风光异昔游。\n芸香充故栋，帘影上新钩。\n雁序中年断，鸰原此日秋。\n藏舟不可问，?水恨悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再宿溪上楼三兄读书处 其二","author":"区大相","text":"书带草新绿，阶钱苔半生。\n尘埃展旧榻，鸟雀聚虚楹。\n有弟官皆达，群儿学渐成。\n人琴竟已矣，含叹几时平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自横槎泛端溪","author":"区大相","text":"竹岸收残市，花源访故津。\n里将仁共美，俗以德为邻。\n土布芭蕉盛，林香橘柚新。\n何须会稽守，方作锦衣人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎惟仁梁少仲麦仲张黎君玺邀集浮丘 其一","author":"区大相","text":"洞府何年别，烟霞此会同。\n白云期乍返，沧海信常通。\n谒帝留双舄，宾王遇八公。\n还持鸿宝术，归访葛仙翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎惟仁梁少仲麦仲张黎君玺邀集浮丘 其二","author":"区大相","text":"闻有辽东鹤，千年始一还。\n我来仍未远，遗迹尚堪攀。\n访旧期餐液，求仙忆住山。\n沧桑何足问，小别鬓成斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿西南驿即事","author":"区大相","text":"未晚商船集，将昏戍鼓多。\n驿楼翔水雾，村火漏烟萝。\n夜柝迎风急，寒潮候晚过。\n常因白雉入，忆得海无波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送游宗谦归闽","author":"区大相","text":"贫交怜此别，昨别是京华。\n身老常为客，年残未到家。\n海风吹鬓短，江雁背人斜。\n不用忧荒岁，归餐洞口霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"正月三日黎惟仁诸公携酒见过得供字","author":"区大相","text":"暂着还山屐，闲扶采药筇。\n年新堤柳发，春暖砌桃秾。\n客至携尊酒，家贫少馔供。\n临池觞屡进，但觉野情浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重至濠上旧居 其一","author":"区大相","text":"濠西一亩宅，伊昔下帷馀。\n壁暗曾题字，园荒旧读书。\n闲禽歌后院，流水绕前除。\n旧识邻家叟，无惊驷马车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重至濠上旧居 其二","author":"区大相","text":"树回通委巷，花发识前津。\n昔去荒三径，今来访四邻。\n庭闲侵履藓，架掩积书尘。\n旧种墙东竹，年年待主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山馆春日","author":"区大相","text":"春园桃李月，山馆桂松烟。\n竹影壁间翠，花光池上燃。\n楮芳初剪玉，榆小未铺钱。\n节物信为悦，簪绅徒自牵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新成草堂之卜暇日漫兴 其一","author":"区大相","text":"偶洽林泉赏，端居意绪闲。\n阶兰差可掇，庭桂即堪攀。\n风扫留宾榻，云来傍舍山。\n居然松菊主，堪作挂冠还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新成草堂之卜暇日漫兴 其二","author":"区大相","text":"疏豁称吾庐，仍惭仁智居。\n颓墉粗补葺，荒蔓颇芟除。\n檐影交苔静，池光映竹虚。\n小童灌园罢，花下报朋车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新成草堂之卜暇日漫兴 其三","author":"区大相","text":"濠上昔垂钓，?东昨耦耕。\n未知投老地，聊快著书情。\n兰蕙思君子，棠花识弟兄。\n闲携竹林兴，驻屐听流莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新成草堂之卜暇日漫兴 其四","author":"区大相","text":"园林多暇日，簪绂忝明时。\n独负烟霞癖，谁图丘壑姿。\n春花披露摘，冬果带霜移。\n有客荷锄至，囊中得紫芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园内小台","author":"区大相","text":"桃李夹池栽，丛丛出小台。\n共跻明月上，独步清风来。\n看山聊隐几，临水屡挥杯。\n胜友频过此，高轩醉不回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"草堂新开四家兄携诸侄自?川移舫志喜 其一","author":"区大相","text":"自枉移舟约，先令扫户迎。\n入林仍共侄，举步即随兄。\n园蕊连枝发，池篁迸砌生。\n殷勤此酬劝，弥畅友于情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"草堂新开四家兄携诸侄自?川移舫志喜 其二","author":"区大相","text":"虽居穗城北，常忆?川东。\n胜怀因物寓，芳意与君同。\n小酌花间露，高谈竹下风。\n时闻棠棣咏，来对玉兰丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山馆漫兴兼柬黎惟仁梁少仲","author":"区大相","text":"良辰追胜事，高论集清流。\n买宅因林僻，为邻取寺幽。\n在家称长者，出户访比丘。\n终愿与君辈，相将鸾鹤游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将有报使之役山馆寓怀","author":"区大相","text":"年芳非一事，对此独怡神。\n小院烟霞色，幽庭松桂春。\n浊醪兼养性，丹壑且全真。\n懒出元吾意，何曾说向人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮丘洞中宴","author":"区大相","text":"洞府游仙入，楼台望气通。\n焚香来桂女，行酒命芝童。\n鹤舞春池月，莺啼碧树风。\n何当倚长袖，共挹浮丘公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟佳人年十五","author":"区大相","text":"艳质正婵娟，韶光复可怜。\n能歌初按拍，学弹始调弦。\n柔意才含蕙，芳心半吐莲。\n惟应三五夜，璧月此长圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟夜别何孔参","author":"区大相","text":"行舟仍暂舣，握手暝前湾。\n岸火连星出，春潮带月还。\n居人感白首，游子叹红颜。\n且恋离杯数，严城未上关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初发珠江","author":"区大相","text":"芳菲已满目，洲渚复含情。\n别路千程始，离愁百念生。\n简书催远去，行役惮孤征。\n为问辞家屡，劳劳何所成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚发三水溯北江","author":"区大相","text":"行客才经宿，离愁已不堪。\n邮亭数长短，江路背西南。\n里树春烟断，山城夕照衔。\n何时已行役，归结桂松庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将至胥江与兄侄别 其一","author":"区大相","text":"客游非不好，奈此别情何。\n连雁沙边久，离杯竹下多。\n中流忽判袂，芳渚遂分波。\n相望徒相失，谁能听榜歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将至胥江与兄侄别 其二","author":"区大相","text":"贤兄怜此别，小侄复沾襟。\n浦叶初辞树，汀鸿忽异林。\n江空数帆影，岸转失挐音。\n知逐回波去，何由返棹寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬别梁少仲黎君玺兄弟","author":"区大相","text":"梁公松柏质，黎子璠玙姿。\n对酒惜长别，临风扬妙词。\n兰香发深谷，莺啭上高枝。\n明旦怀亲友，山川遥梦思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡浈阳","author":"区大相","text":"岭路多奇绝，浈江境最幽。\n窥潭竹影净，披霭树光流。\n云气常凝夏，猿声尽带秋。\n投竿未忍去，辍棹且夷犹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚次清溪驿","author":"区大相","text":"古驿清溪上，溪声净掩扉。\n沙昏商舸集，村响晚樵归。\n旅食沾松粉，邮亭挂薜衣。\n临流饶怪石，时忆旧渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自清溪驿趋曲江山行作","author":"区大相","text":"晓障陟崔嵬，淩晨石路开。\n鸟啼皆应谷，涧影半含苔。\n林霭吹花度，溪烟杂雨来。\n王程若可缓，幽赏更迟徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过曹溪 其一","author":"区大相","text":"闻道南华寺，寻源向此溪。\n水香浮钵远，山翠入檐低。\n樵路春游鹿，松房午放鸡。\n津梁云不远，过此识前迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过曹溪 其二","author":"区大相","text":"相传此溪胜，来渡莫辞频。\n一派澄心水，千年说法人。\n松门数里寺，茅屋几家邻。\n愿假慈航力，长成利涉津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"见舆人妇携儿女馈饷其夫","author":"区大相","text":"岂是春田馌，将无玉案齐。\n应怜齐相御，好谢买臣妻。\n路李枝多子，山梅花满蹊。\n此时闺中望，玉箸几行啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次始兴江口驿舍","author":"区大相","text":"秋杪曾驱传，春深复此行。\n携家殊往日，独客倦长征。\n鸟雀荒村暮，风烟古路平。\n寒衣犹未脱，肠断望乡情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客中听刘季德吹箫","author":"区大相","text":"昔有秦台客，遗氛住绛霄。\n忽传飞凤引，独下彩云朝。\n奈此远游意，怅然仙路遥。\n乘鸾无处所，瑶管若为调。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"于曲江逢高正甫奉使南还","author":"区大相","text":"相逢一杯酒，与子暂绸缪。\n以我北来信，付君南下舟。\n乡心沧海上，客泪曲江头。\n为问乘槎使，何时到广州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食后晚投驿馆作","author":"区大相","text":"春事行将暮，羁愁殊未宣。\n兰肴过冷食，槐火试新烟。\n吏立松花下，马嘶藤叶前。\n东郊斗鸡道，遥忆帝城边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚至圆通寺","author":"区大相","text":"入寺一钟鸣，悠然幽思生。\n泉声和梵语，林影共僧行。\n藤叶溪烟积，松花石路平。\n禅房暂栖息，已觉旅魂清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮至天池寺","author":"区大相","text":"晓策淩晨磴，昏钟叩暝萝。\n天文上界近，梵语半空多。\n河迥横窗落，云低俯槛过。\n预愁筋力少，最奈胜游何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"佛手岩有竹林寺遗迹","author":"区大相","text":"僧言翠微顶，剩有一岩幽。\n异境客难到，诸天人罕求。\n崖悬几屋险，猿啸半山秋。\n不见竹林隐，时传钟梵留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大林寺","author":"区大相","text":"大林何代寺，花木尚馀芬。\n僧老艺松竹，鹤闲眠洞云。\n石苔微雨滑，泉涧细流分。\n天外猿声断，寂寥几客闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东林寺","author":"区大相","text":"昔读高僧传，兼怀逸士踪。\n停车虎溪水，对面香炉峰。\n旧殿丹青落，荒池蔓草茸。\n我来松下坐，日暮但闻钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"僧言远公池上忽开白莲","author":"区大相","text":"远公开社后，池废已千年。\n见说金仙降，俄然涌白莲。\n空香千叶散，妙相一花研。\n本自心无染，谁将半偈传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浔阳渡江","author":"区大相","text":"天浮三楚渡，城压九江浔。\n远堑分南北，中流见古今。\n桃花经汉渚，兰气下湘阴。\n为问朝宗意，应知望阙心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"破额山道场","author":"区大相","text":"为问西来信，灯凡几叶传。\n林端千梵接，象外二峰悬。\n演法开三乘，观空出四天。\n何时解尘缚，来此共栖禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙申三月十五日食寓西河驿作","author":"区大相","text":"月本为阴象，辉盈有蚀时。\n照临终不灭，圆景得无亏。\n小驿冠裳少，荒村鼓角迟。\n伫看光复处，始解万方疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"纡途过光州访故友刘职方园池","author":"区大相","text":"为践今生约，何言隔世期。\n云林应识我，鸡黍到因谁。\n花蕊经春落，禽声入暮悲。\n惟馀昔时剑，凄断挂何枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"面壁洞","author":"区大相","text":"震旦初来日，烟霞启洞扉。\n苔生面壁石，云湿坐禅衣。\n五叶灯前度，三花顶上飞。\n不知传教后，何事又西归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日游岳祠","author":"区大相","text":"丹台悬碧落，紫阁上空濛。\n兴发烟霞外，春归天地中。\n瑶林披霁雪，香霭飏微风。\n仙路逢迎处，纷纷羽节同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铜雀妓","author":"区大相","text":"铜台朝夕望，玉座掩流尘。\n园馆沦长夜，恩情无复春。\n铅华是日落，眉黛逐愁新。\n惟见西陵月，殊非欢宴辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"使还京邸有怀一时放逐诸君子","author":"区大相","text":"往来方岁隔，时事忽朝更。\n吾弟得罪去，诸君胡为行。\n悬巢无过燕，倚树独听莺。\n已采场驹咏，将何达圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁同年赴越西幕名炫","author":"区大相","text":"漓江西上寻，向下动乡心。\n借问莲花府，人言桂树林。\n地形三楚尽，山色九疑深。\n幕下由来重，多才独见今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送霍明府左迁河东转运从事名与瑺","author":"区大相","text":"才人新人幕，邑宰旧鸣琴。\n何事太行坂，能摧赤骥心。\n关危通马邑，地广实鸡林。\n莫道盐官小，今年国计深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得故园亲友书","author":"区大相","text":"故园书札至，未读已伤神。\n乡国离三月，亲知少两人。\n红颜因别灭，白发伴愁新。\n待到归田舍，衰翁几个邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"汪和叔新种庭竹索题","author":"区大相","text":"种君庭下竹，邀我中林人。\n入牖摇疏翠，临阶扫俗尘。\n秋声风际劲，寒色雨中新。\n万个沧江上，茅斋滋绿筠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送混成子 其一","author":"区大相","text":"夫子富道术，世人无不闻。\n徒闻不能用，长啸空青云。\n丹簏烟霞记，玉钤龙虎文。\n西山有鸾鹤，应共尔为群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送混成子 其二","author":"区大相","text":"再坐广文席，一弹邑宰弦。\n弦为新绿绮，席是旧青毡。\n歇马榴花酒，过江莲叶船。\n行藏不自意，何问沧浪天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孝安陈太后挽词 其一","author":"区大相","text":"内朝倦临御，中禁罢晨昏。\n后德千龄茂，母仪三纪存。\n永辞长乐仗，去上昭陵园。\n嫔御一哀送，悲风动国门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孝安陈太后挽词 其二","author":"区大相","text":"桂寝沦阴夕，椒涂启殡时。\n人怀丧妣慕，帝轸殒慈悲。\n宫女收遗事，词臣纪令仪。\n至今称马邓，惟绝外家私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孝安陈太后挽词 其三","author":"区大相","text":"惨淡兰陔寂，阴沉桂殿空。\n鸾旌犹往日，龙綍已新宫。\n银海人难渡，瑶台路不穷。\n惟应彤管德，千载冠椒风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孝安陈太后挽词 其四","author":"区大相","text":"仙舆披素帟，绛旐发皇畿。\n仪卫平生是，山川临幸非。\n玉衣迁隧馆，宝镜掩泉扉。\n万姓何劳慕，瑶池此日归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十六夜高正甫寺居对月","author":"区大相","text":"爱月愿长满，披云复共娱。\n光翻祇树静，影傍塔轮孤。\n入座悬灯暗，穿林宿鸟呼。\n圆辉殊未灭，讵假法尼珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送别驾之肇庆","author":"区大相","text":"小郡秋江上，新恩别驾中。\n封圻兼岭海，襟带尽西东。\n驱马朔风疾，佩刀寒色雄。\n长途日未暮，邦国急论功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":22124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]