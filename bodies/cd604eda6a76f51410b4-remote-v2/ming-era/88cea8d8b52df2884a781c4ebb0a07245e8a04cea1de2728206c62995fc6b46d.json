[{"title":"赠东谷之南归 其一","author":"黄廷用","text":"嵎夷地近受阳赊，十载辞家忆物华。\n昨夜东风何处是，谷前谷后已春芽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30987,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠东谷之南归 其二","author":"黄廷用","text":"别我还乡上小艖，柴门东向是君家。\n壶中细雨逢三月，知忆长安桃李花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30988,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日送友人还莆 其一","author":"黄廷用","text":"黄花不为离情绽，绿酒偏因别思深。\n高望云山何处是，凭君一寄故园心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30989,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日送友人还莆 其二","author":"黄廷用","text":"升高御气尽仙寰，今古乾坤自往还。\n眇眇青冥飞一雁，飘飘白羽过三山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30990,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳纪游 其一","author":"黄廷用","text":"昨秋驻节武夷宫，访道南山入梦中。\n管领春风花鸟外，忘机我已授仙童。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30991,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳纪游 其二","author":"黄廷用","text":"飞鸟乍闻罗汉语，名僧种树长娑萝。\n花开百合供调膳，醉石长招猿鹤过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30992,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳纪游 其三","author":"黄廷用","text":"上方信宿紫虚清，秪有泉声并雨声。\n转觉幻尘飞不染，任从来日自阴晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30993,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳纪游 其四","author":"黄廷用","text":"斋心净献玉坛文，前殿歌钟后殿闻。\n杳霭若承云旆下，西来又礼魏元君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30994,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳纪游 其五","author":"黄廷用","text":"山风吹雾锁高台，若为游人住不回。\n欲写仙踪犹阁笔，生憎下界仆夫催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30995,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳纪游 其六","author":"黄廷用","text":"瑶宫手掇金光草，欲汲飞泉作寿杯。\n遥献一心天上客，五云深处是蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30996,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳纪游 其七","author":"黄廷用","text":"桥下水流花片片，前村古寺有天台。\n相逢不必皆刘阮，他日人传仙子来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30997,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄适 其一","author":"黄廷用","text":"紫阁调梅供奉频，锦园花木自芳春。\n临风不暇携尊赏，吟望台阶一注神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30998,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄适 其二","author":"黄廷用","text":"园中种树多桃李，每到开时不及看。\n但愿花神长入思，芳情岂必在凭阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30999,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄适 其三","author":"黄廷用","text":"自从结发侍君王，白首论心在建章。\n忽忆绮园芳草绿，赏心无计付春光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31000,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄适 其四","author":"黄廷用","text":"上林松竹映空明，漫兴相看晚翠荣。\n即与名园春色似，乾坤何处不怡情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31001,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次院长后九月十日对菊","author":"黄廷用","text":"今岁黄花何太晚，秪缘闰月再重阳。\n凭阑更喜花如昨，紫阁朱衣送酒尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31002,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"回雁峰竹院口占 其一","author":"黄廷用","text":"秋入小亭楚水边，万竿翠色尚依然。\n分明迥与尘寰隔，吹老清风不记年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31003,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"回雁峰竹院口占 其二","author":"黄廷用","text":"欲截一枝鸣凤吹，无端风雨忽萧萧。\n琅玕满地无人扫，遗却蓝田春日遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31004,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"回雁峰竹院口占 其三","author":"黄廷用","text":"梵乐乍惊宿鸟飞，片云江上月华微。\n如何湘竹当年泪，犹向西风洒客衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31005,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"花药寺 其一","author":"黄廷用","text":"旧传仙子丹成日，花下尝栖五色禽。\n药鼎已侵芳草地，松阴空锁白云岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31006,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"花药寺 其二","author":"黄廷用","text":"秋入岳亭清磬远，春来湘水落花多。\n吏情似与禅心共，月色空中一啸歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31007,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对莲 其一","author":"黄廷用","text":"山下池开半亩莲，香侵翰墨度帘前。\n夜来风雨何相妒，溅落荷一碎却圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31008,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对莲 其二","author":"黄廷用","text":"亭亭翠盖出泥中，错献千层菡萏红。\n□喜群芳□间白，赏心人在水晶宫。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31009,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寺中见桂","author":"黄廷用","text":"可堪一日几回肠，南盻闽云带夕阳。\n欲寄愁心明月里，春兰秋桂为谁香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31010,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对月","author":"黄廷用","text":"云本无心翻妒月，晚来疏雨黯江城。\n广寒忽放嫦娥影，依旧关山万里明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31011,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对酒","author":"黄廷用","text":"风送西峰午两来，莲花娇艳半塘开。\n碧筒欲折怜丝綍，山鸟飞来一劝杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31012,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日偶作","author":"黄廷用","text":"谁言秋入诗人兴，我每逢秋动客愁。\n带甲貔貅今满地，庾公何意独登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31013,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观蒙惠二泉","author":"黄廷用","text":"二泉喷玉下荆门，流钵峰前试一尊。\n石罅微茫通蜀道，胡僧眼底识泉源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31014,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒武穆庙次壁间韵 其一","author":"黄廷用","text":"书生早计识权臣，事主肝肠越与秦。\n南渡已随流水去，空怜祠下吊忠人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31015,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒武穆庙次壁间韵 其二","author":"黄廷用","text":"怪尔靖康献纳臣，言和惟恐不同秦。\n甘心君父双囚虏，偏杀尽忠报国人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31016,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"疑冢","author":"黄廷用","text":"分香卖履事堪悲，枉用机心至死时。\n犹恐一身归未定，多堆黄土使人疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31017,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过邯郸 其一","author":"黄廷用","text":"处世卢生何太苦，也曾枕上见荣华。\n当年不与黄梁梦，白首青春空自嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31018,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过邯郸 其二","author":"黄廷用","text":"无端邂逅邯郸道，语及生平得数奇。\n何幸玄机犹不秘，分明托与梦魂知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31019,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过邯郸 其三","author":"黄廷用","text":"我轻万里游都下，自笑驱车六月忙。\n百岁光阴浑一息，欲传真诀竟茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31020,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游武夷 其一","author":"黄廷用","text":"三十六宫春色好，奇峰叠出作仙家。\n我今驾鹤游何处，历尽玄踪饱紫霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31021,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游武夷 其二","author":"黄廷用","text":"武夷山下溪流浅，九曲扁舟歌若何。\n闻道前溪犹有曲，春来流水落花多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31022,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登醒心亭","author":"黄廷用","text":"夕阳人渡小桥东，隐隐云屏入尽中。\n醉里同游谁独醒，半轮明月挂前峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31023,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书西厅小亭 其一","author":"黄廷用","text":"如此山腰作亭榭，何曾一费买山资。\n林间云鸟来无数，三鹳今年巢一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31024,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书西厅小亭 其二","author":"黄廷用","text":"幽亭曲径通流水，日暮尊前对此君。\n双鹤自来还自舞，一声长啸入青云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31025,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孙太守环山庄上对芙蓉 其一","author":"黄廷用","text":"朵朵芙蓉碧水隈，不知今日为谁开。\n山人报道看花侣，唤醒花神迟尔来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31026,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孙太守环山庄上对芙蓉 其二","author":"黄廷用","text":"一访幽栖眼倍明，花山山下水偏清。\n独游江上花饶笑，爱尔秋容似我情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31027,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孙太守环山庄上对芙蓉 其三","author":"黄廷用","text":"生在禾江色绝奇，分明浓淡各相宜。\n若临妆镜人能似，肯惜千金一顾时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31028,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孙太守环山庄上对芙蓉 其四","author":"黄廷用","text":"风飘落叶侵流水，水上名花独拒霜。\n谁识寸心终自见，偏于霜后压群芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31029,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孙太守环山庄上对芙蓉 其五","author":"黄廷用","text":"自昔名花羡牡丹，春风娇艳令人欢。\n若教植此沉香北，也得君王带笑看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31030,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孙太守环山庄上对芙蓉 其六","author":"黄廷用","text":"山公每醉习家池，倒著接䍦马上骑。\n花月故留归未得，高山流水自应知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31031,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酿泉","author":"黄廷用","text":"山下有酿泉，谁能似纪叟。\n但得此中趣，何须倾百斗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31032,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉翁亭古梅席上口占 其一","author":"黄廷用","text":"昨宵枕上听风雨，秪恐纷披花欲残。\n晓起寻芳来涧外，依然玉树两相欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31033,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉翁亭古梅席上口占 其二","author":"黄廷用","text":"当轩酌酒酹花神，愿得年年对此辰。\n莫就开时看早暮，枝南枝北总芳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31034,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉翁亭古梅席上口占 其三","author":"黄廷用","text":"江南二月疑飞雪，香韵因风知是梅。\n索笑檐前清不极，芳春端占百芯开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31035,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉翁亭古梅席上口占 其四","author":"黄廷用","text":"春台偃蹇数朝枝，风雪几侵冰玉姿。\n向晚不知何处笛，一声忽动故园思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31036,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉翁亭古梅席上口占 其五","author":"黄廷用","text":"纵是虎头尽不成，龙麟盘郁数枝横。\n更斟雪酒孤芳共，东望海云片月生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31037,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉翁亭古梅席上口占 其六","author":"黄廷用","text":"南谁谁植罗浮树，一问山僧不记年。\n若使醉翁曾醉此，今人遮莫更留连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31038,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉翁亭古梅席上口占 其七","author":"黄廷用","text":"如何苦入诗人兴，错比名花雪共春。\n况复枝头能结子，偏于日里长芳神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31039,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉翁亭古梅席上口占 其八","author":"黄廷用","text":"夕照鹤癯花共瘦，欹斜妖娆不胜寒。\n洛阳共道花如绣，亦在春深此后看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31040,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉翁亭古梅席上口占 其九","author":"黄廷用","text":"绛蒂黄中香气浮，花开五数恊中畴。\n君王若喜调商鼎，移向上林玉槛头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31041,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉翁亭古梅席上口占 其十","author":"黄廷用","text":"徙倚高枝凌短鬓，摘来杯里注春愁。\n也知一别扬州去，他日相思洛水头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31042,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寅卿赵柱野宅上对水仙花 其一","author":"黄廷用","text":"对此清芬梅作侣，水晶为骨玉为神。\n凌波欲溯银河上，暂向人间度几春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31043,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寅卿赵柱野宅上对水仙花 其二","author":"黄廷用","text":"戛玉鸣金摇翠羽，若从江渚挹花神。\n故将瑶佩聊相赠，肯信东家别有春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31044,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寅卿赵柱野宅上对水仙花 其三","author":"黄廷用","text":"瑶台春色每相宜，盆里娇黄逞玉姿。\n苔藓半蒙芳叶下，托根慎勿俗人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31045,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寅卿赵柱野宅上对水仙花 其四","author":"黄廷用","text":"一从品藻黄山谷，再见新题赵倚□。\n花下尊前香不断，玉人何处觅春游。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31046,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七夕泊舟清源 其一","author":"黄廷用","text":"邂逅清源雨乍晴，天河月色漾空明。\n罗帏寂莫支机冷，其柰牛郎此夜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31047,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七夕泊舟清源 其二","author":"黄廷用","text":"鹊桥欢会是良缘，犹恨离情尚隔年。\n曾奈人间长在客，空将令夕倍愁眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d