[{"title":"送客二首 其一","author":"黎贞","text":"绿杨阴下紫骝嘶，忍向江头送客归。\n满目离情秋色老，几行征雁向南飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送客二首 其二","author":"黎贞","text":"几年为客历风霜，每见南人问故乡。\n料得江门烟景在，青山如染映斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉后纵笔四首 其一","author":"黎贞","text":"碧油幢下侍元戎，出塞期收破虏功。\n勒石燕然犹未遂，几回横剑倚崆峒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉后纵笔四首 其二","author":"黎贞","text":"客里风波几度惊，每因愁处寓閒情。\n江南行尽未归去，直上辽阳访管宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉后纵笔四首 其三","author":"黎贞","text":"辽阳天气异中华，春尽园林未见花。\n那似故园风景好，绮罗丛里驾香车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉后纵笔四首 其四","author":"黎贞","text":"绝句无人独自敲，閒情云月上花梢。\n夜长无处消幽恨，谩学扬雄赋解嘲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"绝句二首 其一","author":"黎贞","text":"故乡南望隔风烟，客里为家过十年。\n用尽黄金归未得，五陵豪气尚依然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"绝句二首 其二","author":"黎贞","text":"白雁南来万里馀，平安寄汝一封书。\n离情别恨多如雨，写入春山作画图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄家二首 其一","author":"黎贞","text":"羡叹人生得意迟，菊残犹有傲霜枝。\n玉容不必添憔悴，留取香风晚节吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄家二首 其二","author":"黎贞","text":"自抛逢掖著征衣，书剑飘零与愿违。\n两地相思归未得，今年犹见雁南飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客中元旦","author":"黎贞","text":"东风先我过梅关，为报今年海外还。\n万里归装何所有，浩吟诗思满江山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重过小孤山","author":"黎贞","text":"昔年曾过海门关，一别江山十载间。\n今日扁舟赋归去，蒲帆又过小孤山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望庐山","author":"黎贞","text":"长江千里送归舟，重过名山忆旧游。\n风景苍苍只如昨，烟波离思满汀洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"午夜还乡呼酒先登钓台书二绝于壁 其一","author":"黎贞","text":"十年戎马不离鞍，沙漠长城万里寒。\n今日归来浑未老，青山还许白头看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"午夜还乡呼酒先登钓台书二绝于壁 其二","author":"黎贞","text":"忆昔边城夜未归，臂悬弓剑趁雕肥。\n杀心今觉消磨尽，鸥鹭从教自在飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送客还辽东柬谢诸藩帅","author":"黎贞","text":"越南燕北旆摐摐，十载承恩归旧邦。\n喜有钓台风景在，一竿便得老秋江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈宗沆妓筵赛神召不及赴书一绝答之时宗沆之弟江执戍辽阳故云","author":"黎贞","text":"锦瑟银筝白玉卮，赏音自是有钟期。\n独怜孤雁长城外，叫断南云总不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画梅红白香实图为古州李生泰题三首 其一","author":"黎贞","text":"昔向深宫伴寿阳，冰肌雪貌白霓裳。\n而今寂寞东轩外，只学山家澹澹妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画梅红白香实图为古州李生泰题三首 其二","author":"黎贞","text":"昨上罗浮访葛洪，丹砂换却旧时容。\n时人不识风流态，争道芳颜带酒红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画梅红白香实图为古州李生泰题三首 其三","author":"黎贞","text":"冰魂绰约带轻烟，万斛寒香雪霁天。\n吟到孤山诗更好，欲凭孤鹤访逋仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麦玄中竹梅二画二首 其一","author":"黎贞","text":"仙风吹下蓬莱岛，彩凤苍龙一齐老。\n波涛飒飒笔底生，顿觉新凉满幽抱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麦玄中竹梅二画二首 其二","author":"黎贞","text":"昔日孤山夜泛船，醉歌明月访逋仙。\n白头又上罗浮路，一色瑶池浅水边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古贤图为谭生廷训题四首 其一 渊明归庄","author":"黎贞","text":"黄阁朱扉是业缘，折腰懒向督邮前。\n抱琴倒挂茅亭下，翠柳黄花自在天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古贤图为谭生廷训题四首 其二 王猷访戴","author":"黎贞","text":"剡曲溪头近若何，扁舟风雪夜相过。\n象城亦有知音者，几度停云兴更多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古贤图为谭生廷训题四首 其三 羲之观鹅","author":"黎贞","text":"绿柳青池护碧亭，无端风月畅幽情。\n观鹅到处堪消遣，岂独山阴写道经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古贤图为谭生廷训题四首 其四 杜甫游春","author":"黎贞","text":"杜曲探春春可怜，落花流水夕阳天。\n蹇驴扶醉归来晚，林外数声响杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃梨榴荔四果图为邓生士齐题四首 其一","author":"黎贞","text":"世传方朔负仙才，虚道三偷不复回。\n我欲乘风访王母，远擎仙颗下瑶台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃梨榴荔四果图为邓生士齐题四首 其二","author":"黎贞","text":"御宿樊川百果宗，笑含曾荐茂陵宫。\n古今嘉赏多如雨，只有潘郎赋最工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃梨榴荔四果图为邓生士齐题四首 其三","author":"黎贞","text":"汉使西游尔始东，何人移植到南中。\n星房满贮丹砂粒，好向罗浮访葛洪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃梨榴荔四果图为邓生士齐题四首 其四","author":"黎贞","text":"南国何堪产异才，年年筐篚入蓬莱。\n千金难买蛾眉笑，一骑红尘万里来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春前一日书","author":"黎贞","text":"剥尽群芳独见梅，看花徐步踏莓苔。\n明朝又报春风到，写尽花前得意杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"淞江钓者","author":"黎贞","text":"山中博奕闲王质，谷口耕锄老子真。\n那似淞江风景好，一竿长钓水粼粼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"京回口号","author":"黎贞","text":"白云满野隐松杉，无数峰峦碧似蓝。\n京国归来诗满轴，西风吹帽鬓毵毵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题云山书屋图二首 其一","author":"黎贞","text":"黄云山下白云居，案有瑶琴架有书。\n今日客游惊见画，扁舟遥欲赋归欤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题云山书屋图二首 其二","author":"黎贞","text":"金陵南渡大江西，到处名山属品题。\n一曲倚阑千古意，浩歌归去访龙溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴","author":"黎贞","text":"达官于我既无分，亦学渊明归去来。\n香粳准备十月熟，黄菊商量九月开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺陈指挥寿二首 其一","author":"黎贞","text":"塞上凉风似水流，人间佳气属初秋。\n长庚耿耿光如月，偏照辕门万户侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺陈指挥寿二首 其二","author":"黎贞","text":"笑领三军辟草莱，柳营移向白云堆。\n骅骝花外嘶春雨，知是巡行麦垄回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画","author":"黎贞","text":"松桧如烟夹径开，宦情羁思共徘徊。\n柴门寂寂秋无际，都似渊明归去来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与张澄渊觅桃栽","author":"黎贞","text":"幽居浑似武陵溪，两岸飞花径欲迷。\n为爱碧桃无处觅，种桃仙客在城西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宴乐图 为夏挥使题","author":"黎贞","text":"筹边将略镇诸蕃，甲帐风清战马闲。\n宴尔画楼春似海，玉人扶醉倚阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题士女观书图","author":"黎贞","text":"宫院沉沉日似年，水晶帘卷理遗编。\n劝君只看班姬传，莫续胡笳十八篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题赵文贵画四首 其一","author":"黎贞","text":"雅爱结庐芳树林，闲云野鹤一生心。\n醉眠不觉春归去，门外落红成绿阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题赵文贵画四首 其二","author":"黎贞","text":"屋头松桧与山齐，屋外飞泉落小溪。\n野老相逢多款曲，杖藜时过石桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题赵文贵画四首 其三","author":"黎贞","text":"几年辜负钓鱼竿，从此江山老眼看。\n攲枕沧溟香梦远，西风吹不到长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题赵文贵画四首 其四","author":"黎贞","text":"曾记当年奏凯还，断滩冲雪过榆关。\n如今万里看图画，十载江山梦寐间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画梅","author":"黎贞","text":"蹇驴曾上庾关头，万树琼瑶雪夜游。\n一自别来经十载，扁舟又欲访罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49116,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扬州","author":"黎贞","text":"环城处处绕清波，甲第连云十万多。\n见说少年全盛日，卧吹箫管上淮河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49117,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题双门谢生佐山水图","author":"黎贞","text":"原非太华与终南，路入双门滴翠岚。\n京国归来亲未老，石桥流水径三三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49118,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹图 为董生匡题","author":"黎贞","text":"百尺苍龙亦逸溪，春阴日日宿云低。\n无端峡里英皇庙，更有鹧鸪深处啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49119,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过大庾岭寄冯梅宪表兄","author":"黎贞","text":"眼看庾岭梅花发，忽忆东窗月夜时。\n风景苍苍异南北，那堪心事转凄其。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49120,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉后纵笔","author":"黎贞","text":"琴剑相随汗漫游，萍踪梗迹遍中州。\n六韬三略知何用，空笑平生学武侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49121,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"听鸟","author":"黎贞","text":"青山叠叠水泠泠，只影堪怜万里行。\n莺燕不知怀别恨，隔林调舌送春声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49122,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"思归","author":"黎贞","text":"万里长城十载寒，归心日夜忆乡关。\n何时归到文溪上，自坐鱼台弄钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49123,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洪武丁丑免戍南归","author":"黎贞","text":"太平不用戍边关，六合尘清战马闲。\n圣代儒冠应有用，独骑款段出青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺王挥使生日","author":"黎贞","text":"九天仙鹤下瑶台，知是蟠桃昨夜开。\n五色祥云光闪灼，柳营佳气似蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"红梅图","author":"黎贞","text":"最爱西湖万树霞，绮罗丛里媚韶华。\n东风恰似河阳县，谁道孤山处士家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水东村","author":"黎贞","text":"翠竹三丫路，清流一带村。\n林间隐茅屋，深处自桃源。\n秋风熟禾黍，旭日散鸡豚。\n醉里忘为客，生涯即故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慧力寺","author":"黎贞","text":"寺住最幽处，半闲云外家。\n绿摇风动竹，红落雨飘花。\n倦客频登阁，山僧屡献茶。\n相逢如旧识，历历问南华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄古起之","author":"黎贞","text":"别后已三月，高怀近若何。\n绝怜过雁少，因负寄书多。\n夜梦惊梁月，春愁动剑歌。\n相思几惆怅，云树郁山河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清远县","author":"黎贞","text":"湍水急如箭，峡山高入云。\n久闻猺獠俗，何异犬羊群。\n远树含春色，孤城霭夕曛。\n独怜名利客，来往自纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦中与景文朱君夜坐作四句觉后续之","author":"黎贞","text":"此景不长好，其如良夜何。\n襟怀三月别，尊酒二更多。\n往事随春梦，新愁发浩歌。\n觉来家万里，鱼雁杳山河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游黄岩寺登双剑峰石塔观尾泉","author":"黎贞","text":"行到山深处，禅林迤逦开。\n云从双剑起，泉自半空来。\n境别浮屠塔，真空明镜台。\n扪萝登绝顶，临眺重徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游栖贤寺入万松关过三峡桥","author":"黎贞","text":"传者不足信，携琴直到山。\n虹横三峡水，云锁万松关。\n景到个中极，心从静处闲。\n湛庵大颠老，聊得共跻攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿五老峰下山家","author":"黎贞","text":"南来万里客，此地偶经过。\n鸡犬人家少，烟霞古迹多。\n青山堪隐逸，白发老耕锄。\n每说当年事，春风满薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游东林寺登远禅师讲经台览冰壶莲社之地","author":"黎贞","text":"莲社千年会，冰壶一鉴开。\n远公初入定，总老又重来。\n鸟向金轮去，云从石塔回。\n登临无限意，更上讲经台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒孟子庙","author":"黎贞","text":"青衫倦游客，过此圣贤居。\n战国山河在，成周礼乐殊。\n三迁忆慈母，百世重真儒。\n稽首崇瞻仰，清风满座隅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题戴侍御望云思亲图","author":"黎贞","text":"老亲康健日，爱子宦游时。\n目断青原下，心驰紫水涯。\n江云春漠漠，庭树影离离。\n远器公期负，归来鬓未丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至郡伯驿见新月","author":"黎贞","text":"暗魄光微露，长空影暂流。\n蛾眉初二夜，蟾窟一痕秋。\n客路惊时序，亲庭动别愁。\n遥怜小儿女，日日望归舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吉安河下夜雨","author":"黎贞","text":"江上思归客，扁舟愧远行。\n乡关几千里，风雨二三更。\n灏气催寒至，狂波入梦惊。\n谁家砧杵急，更恼阿侬情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过五婆滩几覆舟","author":"黎贞","text":"怪石如伏虎，崩湍若建瓴。\n风波几重险，躯命一毛轻。\n否泰从今日，乾坤付此生。\n斜阳幸无事，啼鸟送春声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和韵东隐聂表雷州见寄","author":"黎贞","text":"绝域淹行役，书空不自休。\n谩持苏武节，倦倚仲宣楼。\n邻媪能知己，吟翁岂重愁。\n穷通随所遇，天地一虚舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归梦","author":"黎贞","text":"客处独幽甚，风霜惊岁华。\n慈颜长在忆，归梦每还家。\n后圃橘垂弹，东轩梅欲花。\n觉来月在屋，抚枕重咨嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客怀","author":"黎贞","text":"亲庭旷定省，况复岁华临。\n明月故乡思，白云游子心。\n诗怜未超俗，琴恨少知音。\n何事东邻妇，当当急暮砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄诸弟三首 其一","author":"黎贞","text":"自怜苦相失，漂泊在天涯。\n万里长为客，三年不到家。\n初春逢驿使，知汝上京华。\n此后长相忆，愁来眼欲花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄诸弟三首 其二","author":"黎贞","text":"几载音书绝，乡关梦寐多。\n愁来悲骨肉，老去事干戈。\n路杳红尘暗，天长白雁过。\n无由问慈母，康健近如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]