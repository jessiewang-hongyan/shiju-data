[{"title":"水西春日 其二","author":"李云龙","text":"夭桃临水自照，翠竹梢云半斜。\n燕掠城头山色，莺啼东岸人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水西春日 其三","author":"李云龙","text":"潇潇凉雨夜歇，冉冉晴云晓飞。\n风林果实交堕，春水鱼虾正肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水西春日 其四","author":"李云龙","text":"啸楼西畔一室，古树笼云蔽日。\n但闻黄鸟唤声，不知白鹤飞出。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水西秋日 其一","author":"李云龙","text":"风吹翠竹不绝，露滴空林有声。\n高岸古槐叶落，寒塘衰柳蝉鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水西秋日 其二","author":"李云龙","text":"凉月乍窥松户，白云半掩荆扉。\n深巷秋风犬吠，古城夜火人归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题徐元祥清槐居 其一","author":"李云龙","text":"土阶虫语鹤语，草阁琴声磬声。\n先世三槐处士，对门五柳先生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题徐元祥清槐居 其二","author":"李云龙","text":"帘捲翠云朝坠，窗开绿雨晴飞。\n嘒嘒玄蝉秋唱，喈喈黄鸟春归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"少年行 其一","author":"李云龙","text":"万里辞家出塞垣，五原兄弟竞交欢。\n吴钩上有仇人血，解向尊前笑共看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"少年行 其二","author":"李云龙","text":"虎头猿臂捷如飞，三陷胡兵三突围。\n冒雪夜驰沙碛外，长缨亲系左贤归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明妃曲","author":"李云龙","text":"汉使南还未及春，单于别部寇西秦。\n将军不用临河战，犹有长门玉貌人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送客游广陵","author":"李云龙","text":"虎门枫叶雁群飘，君去江淮秋水遥。\n莫向官河歌九曲，吴宫台下草萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送客还楚","author":"李云龙","text":"雁翅城边猿夜啼，郁桐江上蓼花飞。\n湘沅西去三千里，一路秋山送客归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送客西游","author":"李云龙","text":"崧台西走是梧州，地接湘滩秋水流。\n九派云山疑未定，送君何处吊珠丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清溪","author":"李云龙","text":"清溪溪上雁群飞，两岸枫林叶渐稀。\n何处江楼夜吹笛，一时行客尽思归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都督王公阅兵海上歌 其一","author":"李云龙","text":"东风吹动碧油幢，帝遣嫖姚视海邦。\n猎猎云旗过郁水，嘈嘈雷鼓动珠江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都督王公阅兵海上歌 其二","author":"李云龙","text":"列舰如城望不分，角声吹彻大江云。\n武士各依云鸟阵，元戎亲领水犀军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都督王公阅兵海上歌 其三","author":"李云龙","text":"百尺华楼玉帐开，坐看飞舸蹴天回。\n老蛟起舞天吴拜，江上长风万里来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都督王公阅兵海上歌 其四","author":"李云龙","text":"虎门诸部捷如飞，日暮横江试铁衣。\n弦响乍闻侦候报，前锋川口射鲸归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都督王公阅兵海上歌 其五","author":"李云龙","text":"北风萧萧吹江关，白波几度流雪山。\n将军倚剑飞艎上，却似当年下濑还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都督王公阅兵海上歌 其六","author":"李云龙","text":"金戈指日日华生，玉弩临江江水平。\n横海楼船得似此，汉家何处校昆明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都督王公阅兵海上歌 其七","author":"李云龙","text":"雨过连营月满篷，一声清啸倚秋风。\n惊波不动江如练，东望扶桑欲挂弓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都督王公阅兵海上歌 其八","author":"李云龙","text":"鹳鹅飞尽阵云稀，杨柳风前小队归。\n一曲南征吹不散，又随明月过江飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙曲 其一","author":"李云龙","text":"芙蓉城上住金镳，手酌玉浆酬子乔。\n夜半月明环佩起，九天飞下董娇娆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙曲 其二","author":"李云龙","text":"青牛道士住碧峰，手把一枝青芙蓉。\n閒寻天女投壶去，赢却仙坛白玉龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙引和黎君献 其一","author":"李云龙","text":"蓬山东去水无波，玉舄金軿两度过。\n犹记瑶池旧仙子，碧桃花下奏云和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙引和黎君献 其二","author":"李云龙","text":"珠官芸局竟难留，一谪人间二十秋。\n当日灵姿何处在，白云无尽水悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙引和黎君献 其三","author":"李云龙","text":"水府春风兰杜香，流霞不断树苍苍。\n前溪谁唱游仙曲，不是刘郎是阮郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙引和黎君献 其四","author":"李云龙","text":"紫府青娥白玉肌，手攀琼树待幽期。\n五云隔断蓝桥路，不是裴航谁得知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采莲曲四首 其一","author":"李云龙","text":"江风潇潇生白波，荷叶拍水飞鹭多。\n兰棹莲舟自来去，女郎时唱采菱歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采莲曲四首 其二","author":"李云龙","text":"柳塘风起荻花飘，竹坞烟消江水遥。\n閒过隔船探女伴，飞上木兰桡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采莲曲四首 其三","author":"李云龙","text":"花前相见即相呼，日暮连舟渡碧湖。\n含笑问郎何处住，西来能过妾家无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采莲曲四首 其四","author":"李云龙","text":"日暮期郎杨柳津，小姑相妒阿婆嗔。\n扁舟欲去不得去，江水连天愁杀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕曲 其一","author":"李云龙","text":"香风袅袅透纱幮，云母窗前月吐珠。\n谁挟青娥踏歌去，隔花飘过绣罗襦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕曲 其二","author":"李云龙","text":"绿杨垂影覆雕檐，铃铎无声玉漏添。\n满院月光春似海，六街齐上水晶帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕曲 其三","author":"李云龙","text":"琼楼高阁锦云边，越女如花照绮筵。\n舞罢石榴裙带缓，侍儿扶过玉阶前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭崔季嘿 其一","author":"李云龙","text":"一夜飞霜下井桐，忽闻玉树委秋风。\n早知难觅延年药，悔向南樵访古公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭崔季嘿 其二","author":"李云龙","text":"斗下当年紫气微，曾惊神物吐光辉。\n不知出狱还何意，飞去延津竟不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭崔季嘿 其三","author":"李云龙","text":"水西亭院锁垂藤，水榭山楼昔共登。\n今日花开君不见，满窗风雨独悬灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭崔季嘿 其四","author":"李云龙","text":"手提三尺是龙泉，走马边城及少年。\n侠气至今销不得，散为烟雨蔽江天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭崔季嘿 其五","author":"李云龙","text":"城北城南雨满途，莺花无主月明孤。\n目中尽是山河恨，不独黄公旧酒垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭崔季嘿 其六","author":"李云龙","text":"曾共云山采药来，鹤舒台上竹窗开。\n松间昨夜闻清啸，人见亲骑白鹤回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭崔季嘿 其七","author":"李云龙","text":"粤江枫落晓霜微，郁水连天秋雁飞。\n独忆与君行乐日，扁舟乘月访僧归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭崔季嘿 其八","author":"李云龙","text":"忆君清泪洒西州，经岁西园罢宴游。\n何事邻人调玉笛，夜来吹落满城秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻征黎官军奏捷寄王都督 其一","author":"李云龙","text":"鹳鹅声合阵云霾，一夜蛮兵列藁街。\n何事汉王誇好武，却无馀力到珠崖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻征黎官军奏捷寄王都督 其二","author":"李云龙","text":"琼海冥冥玉帐移，瘴云如墨拥军麾。\n大铜江上南征曲，几向门生笛里吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻征黎官军奏捷寄王都督 其三","author":"李云龙","text":"漫道功成指顾馀，瘴乡风雨费驰驱。\n封侯亦是寻常事，莫把云台易五湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿萧少宰 其一","author":"李云龙","text":"十年金马侍龙颜，曳杖初辞玉笋班。\n试向上台占气象，岁星原自在人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿萧少宰 其二","author":"李云龙","text":"城上春风春昼长，桃花初发万年芳。\n飞来碧海三青鸟，曾见前身侍玉皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿萧少宰 其三","author":"李云龙","text":"玉堂清切傍龙楼，曾沐铜盘掌上秋。\n莫问赤松旧游处，酂侯原不是留侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题玉兰送刘少参入贺","author":"李云龙","text":"上林佳气霭氤氲，一树琪花夜照云。\n锦石雕兰春似海，千秋长奉玉宸君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏牡丹","author":"李云龙","text":"笑倚东风十二阑，沉香亭畔试春寒。\n笛声吹送清平调，长奉君王万岁欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"听乙姬弹琴","author":"李云龙","text":"香烟袅袅玉楼中，一曲离鸾度晚风。\n不是人前弄纤手，欲将幽恨托丝桐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄逢一席上戏赠诸侍子二首 其一","author":"李云龙","text":"轻绡裁就碧云裾，奉拂焚香竹下居。\n怪底隔花呼不转，玉窗西畔检残书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄逢一席上戏赠诸侍子二首 其二","author":"李云龙","text":"慧性修能迥自怜，人前玉立故翩翩。\n当筵昨夜司觞政，醉杀风流李谪仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游罗浮留别诸同好","author":"李云龙","text":"凉风萧瑟动，孤客发江滨。\n徒念丹丘近，先成别故人。\n远山寒历历，秋水暮邻邻。\n浮云有蔽塞，江汉无通津。\n穷猿不择木，衰草敢望春。\n寄谢同心客，去矣泉石邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得江清月近人","author":"李云龙","text":"大江风浪静，片月照孤芦。\n龙女初临镜，鲛人正弄珠。\n玉盘依远浦，金波荡平湖。\n洲明渔火寂，沙白凫影孤。\n舟疑泛银汉，魄似濯冰壶。\n前路饶灵药，嫦娥愿与俱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明霞篇","author":"李云龙","text":"江干白露秋，明霞水上浮。\n流光依浦溆，结绮傍汀洲。\n汀洲遥遥日沉树，海气渐升霞渐举。\n已讶长空驾綵桥，俄惊古渡飘红雨。\n飘红驾綵百态呈，玉宇银河变紫清。\n何年上界开丹阙，何处仙人住赤城。\n日华云影交相射，又逐秋风散楼榭。\n雁翅城边绛帐施，凤皇台上珠帘挂。\n珠帘绛帐影沉沉，孤鹜齐飞度碧浔。\n调脂乍映芙蓉水，织锦还依枫树林。\n轻舒漫卷纷无已，望来疑是犹龙气。\n地下宁无宝剑藏，关前应有真人至。\n集真岛上路漫漫，赤水山前欲去难。\n凭将鲍靓双飞燕，聊向飞云顶上看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韩宾仲专壑山房分得春字","author":"李云龙","text":"丹丘清寂与谁邻，云半三峰入望新。\n访道未逢餐玉客，寻仙先问住山人。\n烟深古木常飞雨，秋老岩花未变春。\n为报罗浮泉石侣，暂留非是恋红尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登书云台怀韩寅仲兼赠禹宝","author":"李云龙","text":"维舟在秋浦，策杖凌寒崖。\n峰峦互回薄，水石相因依。\n言寻蒋生径，遂扣扬子扉。\n修篁罗高馆，芙蓉发山篱。\n噭噭清猿啸，习习西风吹。\n美人游不还，毋由敦佳期。\n幸有琼枝树，可以慰相思。\n扪萝陟丹磴，听泉坐翠微。\n飞鸟既投林，白云亦知归。\n况乃秋易老，白露沾人衣。\n挥手布心腹，相期浮山陲。\n好为谢尘鞅，毋令赏心违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"道中寄张孟奇太守","author":"李云龙","text":"三峰天半出，苍翠望中遥。\n石路紫烟积，山泉秋雨飘。\n梅花频入梦，琪树远相邀。\n愿托双飞燕，从君度铁桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"始渡罗阳水历诸峰","author":"李云龙","text":"夙龄慕名山，心常恋仙阙。\n及此释尘鞅，清秋驾言发。\n沿溪行必尽，陟岭力务竭。\n飞泉既汹涌，连峰复嵂崒。\n槎枒石门邃，欹侧苔径滑。\n花明逢洞口，木落见山骨。\n谷静猿啸悲，云深飞鸟没。\n优哉山水都，信矣仙灵窟。\n餐彼岭上霞，弄此松下月。\n灵襟日潇洒，坐见生绿发。\n寄谢赏心人，毋令蕙草歇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过朱明洞","author":"李云龙","text":"晨策渡溪桥，迤逦寻古洞。\n连冈行渐别，长林目遥送。\n渐远绝人烟，稍近闻禅诵。\n云护瑶台暖，鸟蹴琪花动。\n曰予慕幽旷，夙托游仙梦。\n逝彼岂无忧，尘网不我纵。\n人惟知足足，物以无用用。\n暂托水云游，谢彼役役众。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿冲虚观","author":"李云龙","text":"瑶阶千折跨层峦，犹有仙人旧结坛。\n山口月来秋树白，花宫云近夜床寒。\n孤亭玉简留天语，古殿铜龙借客看。\n十载劳劳何所就，愿从仙令学金丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜冲虚观听羽人奏乐","author":"李云龙","text":"花宫云敛金轮高，羽人向月张云璈。\n寒潭水立群龙号，翩翩鸣鹤来九皋。\n瑶阶石裂山泉叫，修篁高咏长松啸。\n忽如玉斧削琅玕，又如黍珠撒金盘。\n响入遥天杂风雨，老猿掷枝山鬼舞。\n鲍靓长吟倚琼树，足下呢喃双舄语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过青霞谷","author":"李云龙","text":"背囊负丹经，花溪策绿玉。\n既经琪林下，遂造仙山麓。\n流水绕洞门，深松隐茅屋。\n秋云寒不归，暮鸟飞相逐。\n坐玩赤叶枫，行采黄花菊。\n紫芝既可茹，秘检时自读。\n渺矣丘中想，永怀霞外躅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登麻姑台","author":"李云龙","text":"结束紫霞衣，长啸出花关。\n杖藜连步向何处，麻姑台上看秋山。\n秋山历历翠相连，白玉楼台凌紫烟。\n楼头琪花散空碧，片片吹落西风前。\n我欲乘云扣仙阙，直上三峰弄明月。\n长风飘落千丈泉，铁桥如烟鸟飞没。\n回头还望白云衢，遥遥古木笑山都。\n鲍公双燕还来否，葛令遗衣今在无。\n我生本具烟霞骨，不见凌风生羽翼。\n台前落日又西斜，俯拾落花长叹息。\n长叹息，意迟迟，遥见麻姑彩云里。\n手撚一株琼树枝，安得鸟爪搔我背，便受神鞭亦不辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过石洞临洗耳泉","author":"李云龙","text":"逍遥长林下，倚杖秋山麓。\n石室飘紫烟，茅堂带乔木。\n山鸟时一鸣，溪流凡几曲。\n飞泉散成珠，澄潭碧如玉。\n黄猿接臂饮，翠羽联翩浴。\n清涟写晴霞，惊湍沸深竹。\n奇峰竖皆倒，白石煮欲熟。\n愿将浇块垒，何但清心目。\n恨无赤鲤骑，飞入湖中宿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石洞山居二首 其一","author":"李云龙","text":"长啸谢世氛，寻云事行乐。\n松下问花宫，岩间望菌阁。\n度形衣薜萝，量腹进藜藿。\n何知愁已老，坐见木叶落。\n请附鹤上人，终然务寥廓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石洞山居二首 其二","author":"李云龙","text":"山斋爽气饶，昨夜雨惊寝。\n揽带下绳床，开窗望遥畛。\n树色有浅深，山青无远近。\n残云曳作衣，馀花落成锦。\n行听谷鸟啼，去就山翁饮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙吟","author":"李云龙","text":"秋风一夜生庭草，落日流霞望中好。\n柴门倚杖听啼猿，坐见空山白云老。\n蓬莱峰畔铁桥横，中有泉源近玉京。\n愿骑哑虎云间去，长听仙人吹凤笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]