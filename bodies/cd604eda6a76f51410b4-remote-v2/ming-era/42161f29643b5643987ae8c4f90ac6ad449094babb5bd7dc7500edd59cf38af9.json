[{"title":"竹枝词 其一","author":"袁宏道","text":"龙洲江口水如空。\n龙洲女儿挟巨艟。\n奔涛泼面郎惊否，看我船歌八尺风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 其三","author":"袁宏道","text":"百钱一尺买吴丝。\n焦发龙钟旧玉儿。\n记得庚寅前后事，万红堆里插花枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 其四","author":"袁宏道","text":"东街晴雪未消泥。\n南陌阴?又涨堤。\n恰似江头娼女面，乍时欢笑乍时啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 其五","author":"袁宏道","text":"泥深一丈怯开门。\n恶风恶雨恶梦魂。\n才唤妇来又唤去，斑鸠唤得也顽烦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 其六","author":"袁宏道","text":"长樯铁鹿破洪涛。\n木绵子花七尺高。\n搜时蛮力强三虎，抛掷轻如一鸟毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 其七","author":"袁宏道","text":"船上女儿画春娥。\n一叶飘随水上波。\n左手牵妹右牵板，云冠不动青峨峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 其八","author":"袁宏道","text":"吴儿纤晰语音侬。\n北客高檐项领重。\n江西贾子面如漆，裤褶行缠伴老佣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 其九","author":"袁宏道","text":"陌上相逢尽楚腰。\n凉州一曲写吴绡。\n鹍弦拨尽南湖月，更与唱歌到板桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 其十","author":"袁宏道","text":"玉娘一曲叫天鹅。\n此地曾经牙板过。\n十五年前细腰柳，而今枯瘦十围多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 其十一","author":"袁宏道","text":"一片春烟剪縠罗。\n吴声软媚似吴娥。\n楚妃不解调吴肉，硬字乾音信口吪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 其十二","author":"袁宏道","text":"贾客相逢倍惘然。\n楩楠杞梓下西川。\n青天处处横珰虎，鬻女陪男偿税钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"食笋时方正月 其一","author":"袁宏道","text":"鲜甘最与素盘宜，羞杀莴苣与露葵。\n野腹虽馋下箸缓，疑他名字叫龙儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"食笋时方正月 其二","author":"袁宏道","text":"縠水温风解冻时，家家馔得雪玻璃。\n凭将野意酬君子，饱食西窗读楚辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"食笋时方正月 其三","author":"袁宏道","text":"才呼痛快忽伤唇，积玉堆霜止一巡。\n便与唤名西施腕，较他舌乳更清新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"食笋时方正月 其四","author":"袁宏道","text":"娇年那得逼人清，雪骨云肌已十成。\n枝色与香皆第一，蔬经头上拟题卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"食笋时方正月 其五","author":"袁宏道","text":"族类丛生楚水滨，前身未嫁湘夫人。\n请君试搅残箨上，也有斑斑泪点频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"食笋时方正月 其六","author":"袁宏道","text":"苦将墨派染龙孙，只写潇潇个字繁。\n寄语湖州文与可，袜林争似买盘飧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"食笋时方正月 其七","author":"袁宏道","text":"曾踏山阴雨后春，猫头花笋贱如薪。\n陶家只栋破塘买，一日常番两替人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45497,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侍家大人游太和发郡城偕游者僧宝方冷云尹生也 其一","author":"袁宏道","text":"戴将头发入禅关，长得閒时也畏閒。\n从此野人功课定，一年须上两番山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45498,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侍家大人游太和发郡城偕游者僧宝方冷云尹生也 其二","author":"袁宏道","text":"全家都爱踏云烟，过去青山香火缘。\n扶著白头拜真武，被人呼户地行仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45499,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侍家大人游太和发郡城偕游者僧宝方冷云尹生也 其三","author":"袁宏道","text":"朝衣叠却系乌藤，白石青岩取次登。\n识得袁家装束别，红旌队里一骑僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45500,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"习家池","author":"袁宏道","text":"一庭幽碧锁岚烟，旋著春茶试乳泉。\n想得当时醉山简，面容如赭影颓颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45501,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题紫霄太子岩","author":"袁宏道","text":"多少真官学大还，只将白雪换赪颜。\n争如净饭真王子，巢顶穿芽大雪山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45502,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七星岩","author":"袁宏道","text":"红霞一抹雾千重，石骨如斑翠点浓。\n何事丹砂炊不转，诸仙长爇灶门峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45503,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关公祠","author":"袁宏道","text":"平驱妖国洗蛟潭，月下高禅独自参。\n耻与摄山为伴侣，为他靳尚作伽蓝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45504,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕有感","author":"袁宏道","text":"閒花閒月免萦神，且乐明朝到手春。\n前日柳浪亭上客，今来留得几多人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45505,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟将","author":"袁宏道","text":"拟将藤杖伴袈裟，贺却新年便别家。\n湘竹庙前盆浦口，不知何处看桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45506,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"范生善形家言自山西还将归豫章诗以别之 其一","author":"袁宏道","text":"一身直出雁门关，踏遍尧封禹迹还。\n收拾行縢与笈子，待随徐福上三山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45507,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"范生善形家言自山西还将归豫章诗以别之 其二","author":"袁宏道","text":"携将双目入云堆，白石苍崖日几回。\n但得肉山先报我，衲头亲自领僧来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45508,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"范生善形家言自山西还将归豫章诗以别之 其三","author":"袁宏道","text":"三年掷却皂纱巾，五柳家风一味贫。\n愿得龙沙休带印，儿孙只作爱山人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45509,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游石洲 其一","author":"袁宏道","text":"爱取春江一抺澄，斜帆叠叠柳层层。\n閒来袖得佳石子，付与山中好事僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45510,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游石洲 其二","author":"袁宏道","text":"三番石上听歌唇，转眼杨花一纪春。\n座客十来消却五，更无一个六旬人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45511,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柳浪馆同龚散木小修赋得雪中新柳","author":"袁宏道","text":"缬青萦白几千条，胡粉聊将赠舞腰。\n当日辋川无此景，强于雪里写芭蕉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45512,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏题十姊妹花","author":"袁宏道","text":"缬屏缘屋引成行，浅白深朱别样装。\n却笑姑娘无意绪，只将红粉闹儿郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45513,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水仙花","author":"袁宏道","text":"琢尽扶桑花作肌，冷光真与雪相宜。\n但从姑射皆仙种，莫道梁家是侍儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45514,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"看纸鸢","author":"袁宏道","text":"等閒一叶破高云，一簇妖童十里尘。\n便与富儿偿酒债，不须更倩郭仙人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45515,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲辰午节观竞渡 其一","author":"袁宏道","text":"平湖新涨滑如油，十丈红幡绕树流。\n我有敝缌三两幅，也将裁去挂船头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45516,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲辰午节观竞渡 其二","author":"袁宏道","text":"碧酣楼下水平溪，濯足池边日正西。\n桥上桥下人如蚁，只愁翻却孟公堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45517,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴生贫甚所遭辄奇诗以送之 其一","author":"袁宏道","text":"踏遍吴关楚陌尘，榆花空对白罗春。\n如何四海袁居士，偏遇人间憔悴人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45518,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴生贫甚所遭辄奇诗以送之 其二","author":"袁宏道","text":"谢氏青山入梦多，骚人终是恼湘波。\n白公有语若听取，命压人时不奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45519,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲辰中秋后二日礼德山鉴大师塔偶成四偈示同行诸衲 其一","author":"袁宏道","text":"少年学得跳胡神，十地三贤眼上尘。\n老去无端呈败丑，倒持霜刃与他人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45520,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲辰中秋后二日礼德山鉴大师塔偶成四偈示同行诸衲 其二","author":"袁宏道","text":"流水高山只自听，白云终不碍峰青。\n贪他一口龙潭沬，枉却金刚般若经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45521,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲辰中秋后二日礼德山鉴大师塔偶成四偈示同行诸衲 其三","author":"袁宏道","text":"电走星流也是迟，龙潭不见是亲师。\n而今石塔牢龛取，正是金刚出世时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45522,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲辰中秋后二日礼德山鉴大师塔偶成四偈示同行诸衲 其四","author":"袁宏道","text":"棒头有眼师辨取，响里寻文我不知。\n前日少陵祠上过，秋花秋鸟总如诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45523,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德山遇大智龙湖旧侣也 其一","author":"袁宏道","text":"湖上烟峦一抺青，他时亲见望州亭。\n也知鲁国真男子，要识中郎旧典刑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45524,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德山遇大智龙湖旧侣也 其二","author":"袁宏道","text":"好伴青山作主人，门前衲子去如尘。\n法堂草长深三尺，更与腰镰走一巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45525,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅龙君御见忆之作君御诗云我家德山不得住故末句云云用博一笑次萹聊为解嘲亦可作一段公案也 其一","author":"袁宏道","text":"云岚已是属閒身，高下青崖日几巡。\n看尽德山好烟水，只缘不是武陵人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45526,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅龙君御见忆之作君御诗云我家德山不得住故末句云云用博一笑次萹聊为解嘲亦可作一段公案也 其二","author":"袁宏道","text":"眼前峦壑任高低，身里寻身却是迷。\n正在武陵溪上住，不须更觅武陵溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45527,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德山闻长嫂去世恸念伯修感而有作 其一","author":"袁宏道","text":"未亡亡去竟何悲，肠断坡公即世时。\n今日德山峰顶上，吞声重作哭兄诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45528,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德山闻长嫂去世恸念伯修感而有作 其二","author":"袁宏道","text":"山北山南累亦多，愁缘不尽奈他何。\n花源正好深深去，又听人间薤露歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45529,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜深不寐起视星文遂成谜语戏别君御兄","author":"袁宏道","text":"北斗栏杆南斗横，竹林今夕梦难成。\n愿凭织锦天孙指，谱出阳关叠外声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45530,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅君御诸作 其一","author":"袁宏道","text":"碧水丹崖不自由，无因阑入会仙楼。\n布帆饱趁潇湘水，几处青枫黄叶舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45531,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅君御诸作 其二","author":"袁宏道","text":"溪鸟溪花尽寄声，花源无路只空行。\n陶潜老被渔翁误，枉把青山累后生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45532,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅君御诸作 其三","author":"袁宏道","text":"溪流片片叠春纱，红树前头又一家。\n寄语青门种瓜叟，种瓜先种枕头瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45533,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅君御诸作 其四","author":"袁宏道","text":"打叠歌鬟与舞裙，九芝堂上气如云。\n无缘得见金门叟，齿落唇枯嬲细君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45534,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伏波将军避暑石室 其一","author":"袁宏道","text":"青山憔悴故将军，苔甲年年印水纹。\n受尽蛮烟与瘴雨，不知溪上有閒云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45535,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伏波将军避暑石室 其二","author":"袁宏道","text":"行尽跕鸢水上头，裹尸方始得心休。\n閒驱款段随乡里，我亦君家马少游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45536,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃花流水引 其二","author":"袁宏道","text":"路逢箫史不回身，风袅芙蓉绣领巾。\n云里自然清格少，但凭闺艳作仙人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃花流水引 其三","author":"袁宏道","text":"袖却红云侍紫皇，诙谐长是困东方。\n乍来不识天颜笑，只道频嘘列缺光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃花流水引 其六","author":"袁宏道","text":"斗草筵前霞作堆，花宫无事滥驱雷。\n麻姑向说水清浅，又过扶桑看一回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃花流水引 其七","author":"袁宏道","text":"东海群儿拜木公，腰间常系凤凰笼。\n绛裙一舞二山去，惊起扶摇满翅风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃花流水引 其九","author":"袁宏道","text":"尽到朝元会上来，春风坐遍小琼台。\n閒听蔡诞输龙语，引得诸仙笑似雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃花流水引 其十","author":"袁宏道","text":"浇尽银湾水作田，全凭奇僻傲诸仙。\n老来犹自耽儿戏，弱水洋中泛铁船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送寒灰入参上兼访陈卿 其一","author":"袁宏道","text":"青峰只在两眉间，何事三回不驻颜。\n信是黄冠多俗品，不曾俗却谢罗山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送寒灰入参上兼访陈卿 其二","author":"袁宏道","text":"玄编检尽蠹鱼残，不载云官与鸟官。\n未识上真真本末，君行试取藏经看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送寒灰入参上兼访陈卿 其三","author":"袁宏道","text":"摩肩簇绮沸如雷，早向天门道上来。\n为语别峰佳绝处，玉虚岩底出琼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送寒灰入参上兼访陈卿 其四","author":"袁宏道","text":"少年掷却敝头巾，老去常思个里人。\n葱岭走来无隙地，莫教踏著一微尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙巳初度口占 其一","author":"袁宏道","text":"南郭读书西郭田，一竿秋水一湖烟。\n蛮歌社酒时时醉，不学庞家独跳禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙巳初度口占 其二","author":"袁宏道","text":"白石青山到处缘，月高梳栉日高眠。\n无闻已是惭夫子，四十于今少二年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上 其一","author":"袁宏道","text":"桃花春水满江头，独拥佳人翡翠楼。\n谁抱琵琶江口上，声声弹出小梁州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上 其二","author":"袁宏道","text":"二月王花接郡城，绛桃垂柳独分明。\n请看高冢宫人草，别作青春一段情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过康节先生安乐窝","author":"袁宏道","text":"天津桥上沙围屋，共伯城边石吐泉。\n料得先生都不管，来时如月去如烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟作内词 其六","author":"袁宏道","text":"八月秋高兔子肥，卷毛宋鹊疾于飞。\n开阑一放天颜喜，玉手亲携自在归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜饮邹金吾家","author":"袁宏道","text":"夜深歌起碧油幢，部部争先那肯降。\n阅尽龟兹诸乐府，却翻新谱按南腔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"见宫监走马","author":"袁宏道","text":"苜蓿风高万马齐，东华门里映花嘶。\n平明挟弹西园去，白日晴翻碧玉蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登啸台","author":"袁宏道","text":"青峰如面洗溪纹，石上鸾音久不闻。\n欲向先生借天匕，嵩山烟雨华山云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻箫","author":"袁宏道","text":"江上清声入夜哀，潜虬初泣雁初回。\n前山月起青如黛，怕有幽人骑凤来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]