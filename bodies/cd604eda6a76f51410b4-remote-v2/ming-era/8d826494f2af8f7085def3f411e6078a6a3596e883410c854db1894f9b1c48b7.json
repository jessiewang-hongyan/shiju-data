[{"title":"送黄三峰兵宪山东","author":"黄廷用","text":"十载游京国，依依客里情。\n秋斋时听雨，春日共登瀛。\n云署临天路，星槎入海城。\n晋阳今患虏，到处合言兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30842,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈南江令溧水","author":"黄廷用","text":"白云曾作主，今访紫芝山。\n洞口春泉涌，空中夜鹤还。\n庭看松子落，帘对吏人閒。\n何处仙家是，无丹亦驻颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30843,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对菊","author":"黄廷用","text":"主人耽种菊，半院隔东篱。\n五色传词苑，群芳入酒卮。\n波分太液润，露及晚秋滋。\n客里长看汝，予心当告谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30844,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送锦衣参军王慎庵佥宪广东 其一","author":"黄廷用","text":"金门长送客，如子更情亲。\n白雁偏求倡，黄花懒向人。\n虎符牙帐旧，豸府尽轺新。\n倚望津桥夕，悬知海国春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30845,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送锦衣参军王慎庵佥宪广东 其二","author":"黄廷用","text":"祖席联文武，言追宛潞傍。\n锦衣明昼日，绣斧□秋霜。\n路入三山迥，风行百粤长。\n岭云连晚树，鱼鲙出江乡。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30846,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七夕雨席上次陈平冈太史韵为 其一","author":"黄廷用","text":"仙人不易会，异岁一同盟。\n銮幄七香度，机丝五色成。\n云间惊节换，雨下映空明。\n欲别犹闻调，铿铿玉佩声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30847,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七夕雨席上次陈平冈太史韵为 其二","author":"黄廷用","text":"用拙逢知己，云何卜此程。\n欲应天上会，漫道别时情。\n泪滴河源浅，愁分曙色明。\n星桥犹可度，相望水盈盈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30848,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送刘雨山正学光州","author":"黄廷用","text":"握兰春日好，冉冉忽三秋。\n苦作燕山别，言从洛浦游。\n奎光明客旆，云影拂仙舟。\n去去谁同调，思君凤阁头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30849,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壬寅十月再会同年陈戚畹宅 其一","author":"黄廷用","text":"曾缀金闺籍，欣联玉露卮。\n杏花三月宴，蓂荚八年期。\n文采当朝彦，章缝此会奇。\n同心何所愿，随分答明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30850,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壬寅十月再会同年陈戚畹宅 其二","author":"黄廷用","text":"四海逢知己，重过戚畹家。\n小春斟御酒，疏鬓忆宫花。\n逸兴凌寒色，芳心共岁华。\n人生犹聚梗，□骑夕阳斜。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30851,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壬寅十月再会同年陈戚畹宅 其三","author":"黄廷用","text":"侯家金作埒，戚里锦成行。\n云汉齐鹓鹭，楼台集凤凰。\n上台连帝座，列宿动文昌。\n此别何年会，王臣事四方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30852,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壬寅十月再会同年陈戚畹宅 其四","author":"黄廷用","text":"星霜惊易序，鸿雁喜同声。\n结翠青松合，凝光紫雾生。\n分庭俱下拜，列座细通名。\n半为离人思，翻多欢会情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30853,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壬寅十月再会同年陈戚畹宅 其五","author":"黄廷用","text":"少别成经岁，重逢尚问年。\n登龙瀛海近，倚马汉宫连。\n日色临双掌，阳光动八埏。\n愿陪芳躅后，长立泰阶前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30854,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀座主张宫保阳峰公","author":"黄廷用","text":"忆昔陪芳宴，春云生□堂。\n从珍皆宅俊，赐醴出君王。\n倚鼎调兰气，联裾傍日光。\n金陵悬夕望，欲往限津梁。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30855,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀座主礼侍蔡鹤江公","author":"黄廷用","text":"往岁游金苑，春风桃李滋。\n俨然师席重，列以□宫仪。\n剑履馀神采，门墙起梦思。\n淮南千里道，□□□□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30856,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"招隐","author":"黄廷用","text":"遍游天下寺，招隐旧知名。\n龙卧云犹湿，虎跑泉始清。\n山松不改色，风竹自成声。\n帝子今何在，荒台起暮情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30857,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除夜对国博景政光禄志恺铨曹君辩席间作","author":"黄廷用","text":"作客怜双鬓，长安经几春。\n漫传今夕旧，又及岁华新。\n看剑犹冲斗，开尊欲醉人。\n灯前听王漏，骨肉尔为亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30858,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送林见泉节推潮州","author":"黄廷用","text":"君复官南海，行踪总旧程。\n月色多乡梦，潮声动客情。\n惯持三尺法，能使万人平。\n何日徵循吏，同游五凤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30859,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠友人游太学归东广","author":"黄廷用","text":"折柳怜春暮，调兰爱日长。\n燕云如点缀，粤树更微茫。\n双剑冲南斗，孤帆下夕阳。\n谈经曾壁水，梦寐圣宫墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30860,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠丘判州解马还任","author":"黄廷用","text":"为民输国马，出塞给官兵。\n不有千金直，那能万里行。\n风尘悲往事，日夕轸边情。\n寄语东归客，仍将租赋平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30861,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠徐司教","author":"黄廷用","text":"怜子才名旧，为官红绂新。\n壮心还未老，行色正逢春。\n烟柳依沙堰，晴鸥浴潞津。\n轻舟乘雪水，容易楚江滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30862,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张都阃","author":"黄廷用","text":"相国兼文武，承家自不群。\n九重新两露，八阵旧风云。\n醉别黄花酒，行看白剑文。\n边城尚鼓角，画地破祲氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30863,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"嘉莲","author":"黄廷用","text":"上宰调元日，仙蕖若有神。\n孤茎章两象，异萼应三辰。\n经月香仍远，凌波色转新。\n同心谁独苦，偏识采芳人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30864,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东村兄观灯赏莲酌月种麦四时吟惠教漫兴次答 其一","author":"黄廷用","text":"骑马长安市，春游十二年。\n广都开火树，复游照金莲。\n七校香车度，千门珠履连。\n故乡同此夜，万里各风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30865,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东村兄观灯赏莲酌月种麦四时吟惠教漫兴次答 其二","author":"黄廷用","text":"池引金沟碧，莲开岁岁红。\n看花皆上客，作赋与群公。\n不及西湖里，相从小艇中。\n荷深鸥鹭狎，烟水亘长空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30866,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东村兄观灯赏莲酌月种麦四时吟惠教漫兴次答 其三","author":"黄廷用","text":"鸟鹊巢高树，关山起暮愁。\n金波云里净，桂影酒中浮。\n听笛当今夕，登楼度几秋。\n清光浑不减，一色照神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30867,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东村兄观灯赏莲酌月种麦四时吟惠教漫兴次答 其四","author":"黄廷用","text":"琴史缘清暇，为园玉堰西。\n三春兰满畹，九日菊成蹊。\n吏隐怜鸿影，禅栖厌马蹄。\n故山多麦陇，芳草已萋萋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30868,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"荆南道中","author":"黄廷用","text":"击鼓何村急，田家播谷忙。\n农人安故里，游子事他乡。\n迢递关川迥，蹉跎岁月长。\n所嗟容鬓改，犹愧汉冯唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30869,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"荆州渡江","author":"黄廷用","text":"孤鸟来云外，片霞染树边。\n荆南多贾市，沙渚佳渔船。\n全蜀下通楚，秋江亘接天。\n中流箫鼓泛，不似魏公年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30870,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渡关","author":"黄廷用","text":"车骑关前过，人生底事忙。\n汴城分省辖，赵国续封疆。\n地设重关险，云流五色光。\n驱驰成病暍，瞻阙讵能忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30871,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寅卿赵柱野督牧江南中秋有怀","author":"黄廷用","text":"八月潮应大，江平月正明。\n知君不能寐，何处独含情。\n击楫波千顷，倚楼笛一声。\n永阳山上盻，天气逼人清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30872,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"马院蒋督牧江南中秋有怀","author":"黄廷用","text":"未别即相思，思来泪欲垂。\n经年惟问病，无日不亲医。\n皇事何相逼，客心秪自知。\n生憎秋月皎，此际作分离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30873,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过吕梁洪 其一","author":"黄廷用","text":"砥柱能东障，洪梁遏上流。\n一宵风雨至，万顷水云浮。\n野树全低岸，人家半在洲。\n所嗟多荡折，禾黍已无秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30874,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过吕梁洪 其二","author":"黄廷用","text":"往年曾渡险，新涨若为平。\n喷沬依山转，生波浴日明。\n人从天上坐，舟似地中行。\n不见雍门者，空闻流水声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30875,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过吕梁洪 其三","author":"黄廷用","text":"昨夕牵卿梦，新秋动客心。\n风云时聚散，鱼鸟自浮沉。\n楚汉空争长，韩彭不可寻。\n秪馀城垒在，长傍古槐阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30876,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁巳中元过济上同友人户部主政袁民悦饮南池次鹅湖公壁间韵 其一","author":"黄廷用","text":"醉酒高楼上，何人是谪仙。\n河流犹旦旦，月色自年年。\n槐露沾珠履，莲风入绮筵。\n朋情殊未已，捩舵促行船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30877,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁巳中元过济上同友人户部主政袁民悦饮南池次鹅湖公壁间韵 其二","author":"黄廷用","text":"放舟齐鲁下，孤鬓入新秋。\n岁月从他去，泥涂愧晚收。\n故山频在望，嘉节倍生愁。\n杜甫曾为客，任城亦漫游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30878,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"维舟偶傍济城隈，登眺悠然宿雾开。取醉何缘逢地主，留题俱是掞天才。坐看古渡双垂钓，移向南池一洗杯。惟有酒楼高不极，仙踪杳霭去还来。","author":"黄廷用","text":"雉堞周围曲水隈，观澜桥畔尽亭开。\n同心喜有□花伴，即景惭非作赋才。\n淮上忽闻停戍角，济中相与乐仙杯。\n不知胡骑秋风起，犹敢南河牧马来。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30879,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"滁阳别友人","author":"黄廷用","text":"每忆传经日，相从在帝乡。\n岂期分袂后，重晤是滁阳。\n十载离情久，一朝欢意长。\n如何又别去，迟尔醉春觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30880,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"途中遣德 其一","author":"黄廷用","text":"奔走空皮骨，六年万里馀。\n疏狂沾厚禄，倾覆带高车。\n喜得投簪日，还如结绶初。\n春风开竹径，夜雨长园蔬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30881,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"途中遣德 其二","author":"黄廷用","text":"谗人嗟罔极，所喜圣朝清。\n点璧殊无失，诬金安足明。\n林园暌几载，日夕欲兼程。\n春到生芳草，濡毫总有情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30882,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"途中遣德 其三","author":"黄廷用","text":"穷冬逢作客，落日易生愁。\n蝗后成年欺，冰来滞水流。\n驿楼荒里渡，朴舍远中求。\n菊酒斟盈斝，河鱼上小舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30883,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙丑冬重过古囊 其一","author":"黄廷用","text":"不到囊山上，于今十二年。\n路迷荒草里，寺没古松前。\n何处来清磬，空山眷法筵。\n倭奴频作祟，无地可安禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30884,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙丑冬重过古囊 其二","author":"黄廷用","text":"虎溪三笑后，图□几人传。\n风景怜今日，登临忆昔年。\n珠林芳树合，金刹碧云连。\n讵意红尘起，斋心秪自怜。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30885,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙丑冬重过古囊 其三","author":"黄廷用","text":"净域何销歇，禅门困是空。\n一灯山月下，孤钵野云中。\n栋桡埋秋草，塔危带夕鸿。\n终期扫坛级，来上辟支宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30886,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙丑冬重过古囊 其四","author":"黄廷用","text":"本是吾宗子，超然云外情。\n重莲昭帝贶，双虎狎师行。\n缩地通仙界，扣关入洛城。\n空馀丹鼎在，采药学无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30887,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙丑冬重过古囊 其五","author":"黄廷用","text":"飞锡从初地，布金种福田。\n兽蹲承跌座，鸟喜结花毡。\n芝产灵池润，松滋甘露偏。\n禅心明皎月，兹事已千年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30888,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙丑冬重过古囊 其六","author":"黄廷用","text":"翠微分半榻，胜托此真缘。\n披草寻龙藏，过溪饮虎泉。\n香花萦下界，脩竹出诸天。\n忽忆同游者，浮生殊可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30889,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"腊月六日雪 其一","author":"黄廷用","text":"邦人不见雪，三十有三年。\n地拆炎方异，天垂瑞泽偏。\n檐前堆不树，海上寂无烟。\n稚子欢岐路，渔翁泊钓船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30890,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"腊月六日雪 其二","author":"黄廷用","text":"不寝听寒漏，拥衾蕙幔中。\n乘虚侵半榻，平白出遥空。\n宜麦知春早，飞花卜岁礼。\n暮龄欣对此，朋好一尊同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30891,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丙寅春日","author":"黄廷用","text":"春迎东郭外，喜过小楼东。\n天上璇玑转，人间锦绣丛。\n碧山春酒绿，玄圃臈梅红。\n忽忆金银胜，承恩出汉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30892,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次始祖唐御史文江公游囊山韵","author":"黄廷用","text":"古寺荒烟重，溪流脉脉斜。\n红花冲暮雨，白露点晴沙。\n慧窟犹唐月，禅心似汉花。\n谁期千载下，依旧属吾家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30893,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病中奉酬老东垂问（以下未第时作） 其一","author":"黄廷用","text":"熇暑何相逼，寒生染患多。\n寻方还枕褥，吃药间□哦。\n榻为医人下，车烦长者过。\n起来文馆外，已没旧时莎。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30894,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病中奉酬老东垂问（以下未第时作） 其二","author":"黄廷用","text":"夜雨回青竹，凉风长碧波。\n疗生道气少，伤肺火邪多。\n鸟语勾诗思，萤光醒病魔。\n深惭劳白发，数问我如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30895,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病中奉酬老东垂问（以下未第时作） 其三","author":"黄廷用","text":"潦倒年华易，飘零一束书。\n虚星斜度斗，金气暗通墟。\n王述痴相若，长卿病亦如。\n自怜逢有道，慰我负床馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30896,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"途中写怀","author":"黄廷用","text":"不才还落漠，去国属艰难。\n雨露新杨柳，烟波旧木兰。\n南行已百里，午梦复长安。\n閒拂床头剑，光凌北斗寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30897,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过分水关","author":"黄廷用","text":"雪雨泥应滑，岭高路更难。\n连朝怀魏阙，此日渡闽关。\n草落疑山瘦，松孳信岁寒。\n故乡回首望，渺渺白云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30898,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题方洲","author":"黄廷用","text":"□发灵峰上，平分蔓萃湖。\n云閒浮野树，日煖浴沙凫。\n花落流飘锦，石横浪搏珠。\n只缘贪胜迹，□日负诗逋。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30899,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"驾幸西陵 其一","author":"黄廷用","text":"陵园春雨梦思多，凤辇龙帏下禁坡。\n直北重关连朔漠，将军边事近如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30900,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"驾幸西陵 其二","author":"黄廷用","text":"远从千官依日御，新开三殿向榆河。\n炉烟袅袅腾春雾，犹引朝仪封事多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30901,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"驾幸西陵 其三","author":"黄廷用","text":"黄金台上瞻仙仗，野旷风清辇道疏。\n最爱沙河星月皎，夜深偏照紫宸居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30902,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"驾幸西陵 其四","author":"黄廷用","text":"文皇定鼎靖沙胡，宫阙□台此帝图。\n白昼铜关严甲士，青宵羽箭报金吾。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30903,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"驾幸西陵 其五","author":"黄廷用","text":"君王为卜冈陵吉，十人盘中峙凤凰。\n天寿万年传驻跸，词臣谁复拟长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30904,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送友人出郭 其一","author":"黄廷用","text":"跨马送君十里桥，桥边野渡几阑□。\n离情细逐新流水，春色晴看翠柳条。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30905,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送友人出郭 其二","author":"黄廷用","text":"细雨轻尘浥午风，春游篇爱帝城东。\n小桥流水通幽径，隔岸汀花几点红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30906,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题海青","author":"黄廷用","text":"海雾茫茫树影微，扶风遥入上林飞。\n汉王不吝千金直，博得天鹅一只归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30907,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送太常李楼云守磁州 其一","author":"黄廷用","text":"羡汝才名出奉常，曾将礼乐献君王。\n于今作牧劳符竹，欲使弦歌入淦阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30908,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送太常李楼云守磁州 其二","author":"黄廷用","text":"论诗喜及黄花暮，告别愁闻白雁声。\n明日星轺云树隔，相思宁似故人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30909,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]