[{"title":"古城春望","author":"李梦阳","text":"阴阴日欲暮，迢迢春望稀。\n野色吹寒立，林鸦逆雨归。\n孤城还麦秀，白首且花飞。\n临路长杨袅，前朝今是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55211,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东陂秋汎三首 其一","author":"李梦阳","text":"久说东陂好，今陪上客游。\n绮筵开画舫，哀笛奋中流。\n舞每低轻燕，歌先起白鸥。\n稍前休更进，吾爱荻花洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55212,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东陂秋汎三首 其二","author":"李梦阳","text":"水寺通人少，松亭隔芰荷。\n问僧舟暂舣，登岸酒同过。\n草木秋风入，湖山晚色和。\n返桡须痛饮，前路满渔歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55213,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东陂秋汎三首 其三","author":"李梦阳","text":"进艇晨烟碧，回槔晚日黄。\n宿禽喧乱苇，饥獭窜空梁。\n放浪形骸得，牵缠世路忙。\n要君待明月，此水是沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55214,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与骆子游三山陂三首 其一","author":"李梦阳","text":"库部平生友，湖山百代心。\n追思宫阙地，芜没水云深。\n连马穿芦入，群鸥坐石吟。\n谁能堪落日，莽莽古城阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55215,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与骆子游三山陂三首 其二","author":"李梦阳","text":"岳壑胸应满，乾坤眼独真。\n扬鞭指河洛，立马说周秦。\n古墓笙歌地，前朝战伐尘。\n秋风飒飒起，白草正愁人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55216,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与骆子游三山陂三首 其三","author":"李梦阳","text":"日扇逢林却，风旗改路回。\n悲凉元此岳，攀陟复何台。\n云破远峰出，天秋孤雁来。\n明朝异南北，归骑莫教催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55217,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上方寺钟楼","author":"李梦阳","text":"台上一钟鸣，登台万里平。\n蒹葭天正远，云气暮还生。\n饥雀喧空泽，黄蒿断古城。\n不堪临眺屡，况是感秋情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55218,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上方寺钟楼晚登","author":"李梦阳","text":"危阁秋登霁，寒烟晚坐重。\n长风欲动地，落日故衔峰。\n苇飐腾双鹜，云拖挂一龙。\n此怀吾不浅，怪尔暮鸣钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55219,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日台寺","author":"李梦阳","text":"寺僻春还丽，人闲午任游。\n行随碧草远，话为老僧留。\n池竹晴常润，龛花晚更幽。\n塔端两巢鹤，怪尔亦优游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55220,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春晴野寺和李大","author":"李梦阳","text":"野阔爱春幽，新晴觅寺游。\n立僧当径望，融雪向门流。\n净色悲诸界，浮生哂一丘。\n怜君厌嚣俗，行处即沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55221,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"城南夏望和王相国","author":"李梦阳","text":"散步郊南望，雏鸦款款飞。\n园林惟草色，时序巳絺衣。\n试粉莲初腻，残香栋乍稀。\n亦思河朔饮，无柰赏心违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55222,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陶行人宅赠","author":"李梦阳","text":"大道僧门对，萧然陶舍深。\n未论五杨柳，真悬一素琴。\n坐向霜烟夕，时闻鸿雁音。\n城笳流海思，边月起秋阴。\n苦劝蒙腾醉，应怀长别心。\n但看得云翼，冥冥谁竟寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55223,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬京师友人见寄","author":"李梦阳","text":"浮云悲故国，积水起鸣雷。\n不见长安日，愁登古吹台。\n故人三月别，天上一书来。\n欲问经行处，山中杜若开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55224,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台饯秦子二首 其一","author":"李梦阳","text":"异地同为客，看花更属秋。\n云连去国目，雁引望乡愁。\n陇树迷关道，吴山蔽驿楼。\n忍将宋玉恨，还共李膺舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55225,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台饯秦子二首 其二","author":"李梦阳","text":"万里游燕客，十年归此台。\n只今秋色里，忍为菊花来。\n霜露凝秦望，衣冠饯楚材。\n不堪分袂苦，落日一鸿哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55226,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送秦子","author":"李梦阳","text":"梁国秋砧满，范阳风叶稀。\n如何故人去，不与雁同飞。\n北路蓟门古，寒天易水微。\n君行莫怨雾，霜日指南辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55227,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻李公寓郊园寄赠","author":"李梦阳","text":"几日栖东屿，昔林今若何。\n主人能醉客，世事且狂歌。\n黄鸟晴吟竹，红蕖晚出波。\n自怜门士末，眠病阻呜珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55228,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答殷伊阳见寄","author":"李梦阳","text":"古县垂新柳，独吟酬好春。\n琴清山在眼，花碧酒随人。\n柰此河阳少，曾于汉署亲。\n邮筒定不惜，有句念沉沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55229,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄殷伊阳二首 其一","author":"李梦阳","text":"自枉去年札，约为嵩少行。\n梦常飞洛水，诗屡到伊城。\n萝殿王乔舄，花台子晋笙。\n君行奋双翮，吾此学长生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55230,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄殷伊阳二首 其二","author":"李梦阳","text":"可怪伊阳尹，冬来不寄诗。\n从怀白雪调，况逼暮云时。\n日落山城黑，风鸣邑树悲。\n身危属抚字，为尔一凄其。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55231,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送鲍生下第南归","author":"李梦阳","text":"只期横直上，岂料戢鳞归。\n抱玉终难掩，投珠安所希。\n秋风吹独马，落日照征衣。\n南到江亭上，还瞻北雁飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55232,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杭刑部东卿谈其师鼒","author":"李梦阳","text":"国难逢骄虏，时危惜俊才。\n盐车在泥淖，骐骥亦悲衰。\n片月清秋照，商风一夜来。\n思君不相见，惆怅对西台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55233,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张子抱疴避諠山寺阔别旬月作此怀寄","author":"李梦阳","text":"楚楚张公子，悲吟度岁华。\n弃官临野寺，服习向山家。\n石髓遇不识，黄精春始花。\n洞中日月秘，强食胜丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55234,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄钱水部世恩","author":"李梦阳","text":"雪时挥袂别，见雪即怀君。\n河馆冬难暮，沙洲晚更云。\n清为苍水使，静对白鸥群。\n昨夜寻君梦，微茫路不分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55235,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"风夕柬徐子","author":"李梦阳","text":"严冬万卉寂，苜吹迥添愁。\n岭日微含照，川云半逆流。\n频斋忘肉味，乍冷觅羔裘。\n差胜山阴夜，能孤访戴游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55236,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送舍侄木还汴","author":"李梦阳","text":"天涯逼除夕，念尔独归人。\n夜宿芦沟雪，朝逢易水春。\n为驹先污血，藏剑莫愁身。\n到及张灯候，遥知戏彩频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55237,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"得何子过湖南消息","author":"李梦阳","text":"及遇荆门信，洞庭秋巳凄。\n湘江饶苦竹，几听鹧鸪啼。\n马援留铜柱，王褒祀碧鸡。\n向南冲瘴疠，药物去曾携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55238,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆何子","author":"李梦阳","text":"忆尔辞京日，余歌万里行。\n经秋无过雁，索处若为情。\n去巳穷滇海，归应滞岳城。\n凤凰池上草，春到为谁生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55239,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"何子至自滇","author":"李梦阳","text":"醉折荷花别，宁期花复开。\n川原一回首，云日共徘徊。\n知向百蛮去，云从三峡来。\n进舟虽一赋，胡弃楚阳台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55240,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春归柬谢员外","author":"李梦阳","text":"寂寂鸣禽变，阴阴弱絮飞。\n烟花从客久，风雨会春归。\n且尽退随饮，休伤节序违。\n无端临暮景，番忆谢玄晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55241,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚过序上人","author":"李梦阳","text":"塔日微微堕，禅居隐隐凉。\n轩开惟有竹，坐定始闻香。\n万古风尘地，三生水月乡。\n频来寻白社，不为礼空王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55242,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再过序公月夜","author":"李梦阳","text":"岁巳残冬逼，月馀今夜圆。\n光侵僧磬发，清傍佛楼悬。\n鸣鸟疑深树，高云静暮天。\n夙心如解此，更欲问何禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55243,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚过定上人","author":"李梦阳","text":"中秋镜阁临，向晚过西林。\n月自湖间动，鹊翻袛树深。\n静宜钟磬发，寒更塔廊阴。\n万物辉今夕，悠悠尘外心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55244,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋雨访李鍊师","author":"李梦阳","text":"便静寻丹侣，飞梁度赤城。\n洞花含雨落，阶鹤下松迎。\n云雾生仙袂，秋寒咽凤笙。\n余情会浩荡，先品步虚声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55245,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送鲍光雄南归","author":"李梦阳","text":"世事风波远，悠悠素发新。\n乾坤万里色，江海独归人。\n岸柳牵行舫，汀花照暮春。\n山中采芳杜，好荐北堂亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55246,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"田生闻余浩然访于东郭花下酒集二首 其一","author":"李梦阳","text":"花林吾自酌，见觅尔情亲。\n转觉花饶笑，番惊蝶趁人。\n百年秦地客，万里宋宫春。\n酒罢烟城暮，无言对怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55247,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"田生闻余浩然访于东郭花下酒集二首 其二","author":"李梦阳","text":"令兄真国土，吾子更超然。\n同住孤城里，相邀东郭前。\n攀桃映落日，折柳向春天。\n更有梁台约，风尘入暮烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55248,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"佘氏园庄二首 其一","author":"李梦阳","text":"无端二月至，不分百花开。\n林坐斜阳入，郊暄沙色来。\n秾葩偏近牖，弱柳故临杯。\n共是天涯客，无辞酩酊回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55249,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"佘氏园庄二首 其二","author":"李梦阳","text":"百年吾不醉，一岁几何春。\n况接桃花暮，难禁柳色新。\n君为避世客，余是放歌人。\n烂熳题诗遍，林莺莫漫嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55250,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庚午十月佘氏东庄","author":"李梦阳","text":"南客招延屡，东游野兴高。\n乾坤侵肃杀，云木半萧骚。\n暖泽喧饥雀，冬林秀晚桃。\n时清还浪迹，痛饮笑吾曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55251,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人还关中","author":"李梦阳","text":"见君驱去马，忽起望乡思。\n华岳寒逾峻，泾河绕自迟。\n躬耕为谷口，把钓忆皇陂。\n何日一尊酒，南山对不移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55252,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄赠内弟玉园居","author":"李梦阳","text":"城市怜余独，乡居见尔稀。\n年华仍雪树，疾病有柴扉。\n烟起浦欲暝，沙寒鸿自饥。\n一身固不保，万事莫嗔违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55253,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"毒热在狱呈陈运使敩暨潘给事中希曾","author":"李梦阳","text":"此地饶炎热，南中恐未然。\n有风番助暑，挥汗欲成泉。\n鸟避栖深叶，蝇喧集满筵。\n百忧吾共汝，流涕北风篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55254,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"延庆观访陈州王君","author":"李梦阳","text":"珠阁晴逾丽，山林午自和。\n我来驱独马，笑尔溺双鹅。\n腊雪融楼薄，溪风傍竹多。\n虽非宛丘习，吾醉亦婆娑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55255,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徙泰公方丈秋夜","author":"李梦阳","text":"秋林风色暮，游子念征衣。\n鸿雁俱高起，江山独未归。\n月临莲室静，萤傍竹林微。\n喜对离群友，吾生本息机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55256,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"康状元话武功山水","author":"李梦阳","text":"梦寐关中好，连年未得归。\n侧闻武功胜，佳兴益翻飞。\n水绕褒斜出，山从盩厔围。\n因君觅水竹，为买钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55257,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"发京吕状元送出城","author":"李梦阳","text":"旭日清霜丽，关河独雁飞。\n征蓬各自远，会面后应稀。\n渭水萦秦塞，南山绕汉畿。\n料君乡思切，只恐未能归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55258,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答何子问讯三首 其一","author":"李梦阳","text":"伊汝投簪日，怜余罥网罗。\n江湖鸿雁绝，道路虎狼多。\n万死还乡井，潜身葺薜萝。\n天涯岁仍晚，无路觅羊何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55259,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答何子问讯三首 其二","author":"李梦阳","text":"仲夏辞梁地，中秋出夏台。\n醉行燕市月，留滞菊花杯。\n日暮千行泪，天寒一雁来。\n亦知张季子，不为食鲈回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55260,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答何子问讯三首 其三","author":"李梦阳","text":"弱冠真怜汝，投闲更可哀。\n山高桐柏观，水曲范滂台。\n假寐凭岩桂，潜行倚岸梅。\n此时谁借问，日短暮寒催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55261,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阻雨明港寄何子二首 其一","author":"李梦阳","text":"白日云犹动，青山雨忽来。\n计程今夜会，策马出村回。\n月对荆门上，天从梦泽开。\n旅灯依港宿，吟苦独徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55262,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阻雨明港寄何子二首 其二","author":"李梦阳","text":"微微山日舒，彼美碧山隅。\n信宿犹难遣，经年秪重吁。\n花含明日艳，月助此宵孤。\n久拟申城醉，香醪语尔沽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55263,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"贤隐寺集赠","author":"李梦阳","text":"水落移舟稳，山行酒暂随。\n寺高垂路细，林密见僧迟。\n楼阁登临日，江淮独去时。\n不应聊驻此，愈重白云思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55264,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"汉上遇钟参政","author":"李梦阳","text":"长安一为别，十载但书传。\n我自河南至，君来自沔川。\n偶逢知万事，重会是何年。\n馆静风依马，江鸣雨濯船。\n情多看转默，酒后惜分眠。\n明发孤帆疾，愁经大别边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55265,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠钟子汉上","author":"李梦阳","text":"君为薇省使，几度紫薇开。\n发以忧时白，舟巡累月回。\n汉川惊会面，江南助停杯。\n巳约同船下，安能晓霁来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55266,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"独对亭赠人过访","author":"李梦阳","text":"孤亭瞰巨壑，五老对衔卮。\n日出峰烟起，风凉谷树悲。\n石泉秋听急，山路晚归迟。\n异日东南赏，应深庐岳思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55267,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"发贵溪高子辈舟送","author":"李梦阳","text":"旌旗飞近邑，鼓吹送前舟。\n礼饯诸生侍，英寮并节游。\n长风驱瞑色，密霰响寒洲。\n见月帆犹进，山阴恨子猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55268,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄赠林都御史二首 其一","author":"李梦阳","text":"锦水啼莺起，巴山春望微。\n干戈满眼急，江汉一舟归。\n花送琴书色，霜留斧钺威。\n所伤豺虎乱，公也息鸥机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55269,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄赠林都御史二首 其二","author":"李梦阳","text":"诸葛能安蜀，穰苴本善兵。\n向来优起诏，番作急流行。\n老益丹心壮，忧惟白发惊。\n秪怜川父老，涕泣挽归旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55270,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠何君辞官归里","author":"李梦阳","text":"三年牧夷邵，万里竟归舟。\n瘴离程番雨，雪乘江汉流。\n琴书顿县邑，五马向山楼。\n棠树苗民种，清阴应旧州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55271,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新喻遇薛子送赠二首 其一","author":"李梦阳","text":"故旧日益远，寸心奚所安。\n雨留杯酒暂，明发楚途漫。\n炎暑百蛮尽，风霜五月寒。\n知君近南斗，时倚镆铘看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55272,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新喻遇薛子送赠二首 其二","author":"李梦阳","text":"解剑别此水，怜君向桂林。\n徒持一杯酒，其柰故人心。\n瘴疠秋行霁，沅湘马度深。\n衡阳虽更远，莫遣雁书沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55273,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立春寄杨君京口","author":"李梦阳","text":"一水相望隔，飘飘楚越身。\n北风犹送雨，南国暗增春。\n云入金山接，波添彭泽新。\n妙高峰上酒，对酌是何辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55274,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"顾子谪全州赠二首 其一","author":"李梦阳","text":"楚城悲远望，君去更悠悠。\n十月逢南雁，章江兄北流。\n寒沙带宿莽，霜日下孤舟。\n明发湘东路，应添吊屈愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55275,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"顾子谪全州赠二首 其二","author":"李梦阳","text":"苍梧遗舜迹，白云秋气愁。\n君得人文地，相传是此州。\n山连夜郎密，瘴入桂林收。\n独有思亲泪，非缘逐客流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55276,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与樾堂子晚步四首 其一","author":"李梦阳","text":"有伴沙行稳，无云楚望深。\n江湖席下出，楼观鸟边阴。\n共系南来迹，孤帆北逝心。\n徘徊忽复晚，朗月散松林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55277,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与樾堂子晚步四首 其二","author":"李梦阳","text":"晚俯林烟静，居然尽一城。\n江围三面白，雨过四时清。\n沙广偏升月，花疏转唤莺。\n可言南岫矮，青槩斗牛平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55278,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与樾堂子晚步四首 其三","author":"李梦阳","text":"北郭浮沙暝，西山拥坐真。\n日犹衔殿阁，江巳下星辰。\n禹服苗风杂，丰郊剑气伸。\n独嗟征舰日，歌吹满城闉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55279,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]