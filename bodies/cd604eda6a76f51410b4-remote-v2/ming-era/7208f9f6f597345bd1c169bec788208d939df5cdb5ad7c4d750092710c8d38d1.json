[{"title":"远志楼 其二","author":"谢重华","text":"悬榻俗宾自少，居楼侠骨偏尊。\n只容明月入户，独许清风扫门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"远志楼 其三","author":"谢重华","text":"楼上閒披古史，瓮头自泼新醅。\n生平愿此足矣，富贵吾何有哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"远志楼 其四","author":"谢重华","text":"风骤花颠欲舞，日斜鸟倦知还。\n乐事三杯白酒，生涯一片青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"远志楼 其五","author":"谢重华","text":"罗浮四百奇峰，排闼送青入座。\n非关我爱名山，名山自来亲我。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊子秋先严见背嬛嬛无倚忆雅诗出则衔恤入则靡至二语描写真切一字一泪 其一","author":"谢重华","text":"世乱无缘觅一官，区区菽水愧承欢。\n百年风木悲何极，夜夜皋鱼泣未乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊子秋先严见背嬛嬛无倚忆雅诗出则衔恤入则靡至二语描写真切一字一泪 其二","author":"谢重华","text":"庭舍凄凉可若何，哀思不禁发全皤。\n毛诗字字堪愁我，怪得王裒废蓼莪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其一","author":"谢重华","text":"高斋日抱白云眠，竹籁松涛落枕边。\n赢得樟冈当屋角，虽贫不废买山钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其二","author":"谢重华","text":"却笑年前未挂冠，欲排阊阖献琅玕。\n于今筮得天山遁，且学诗人咏考槃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其三","author":"谢重华","text":"不谒王侯春复春，自栽松菊结为邻。\n无端习懒翻成癖，怕见闉阇一片尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其四","author":"谢重华","text":"眠花藉草卧看山，岩下幽人镇日閒。\n犹有流莺閒不得，时时飞舞出林间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺","author":"朱学颜","text":"相携直上自吾徒，五月层阴暑欲徂。\n指顾星辰如可摘，参差云树尽堪图。\n为园韦氏今蒿藋，好住孙郎事有无。\n阅历不须重感慨，浊醪应解杖头酤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺","author":"朱学颜","text":"僻径扶萝入，壶中山水佳。\n阴寒仍五月，飞雪自层崖。\n酒尽杯盘藉，形忘鹿豕偕。\n半酣归路晚，洞口绿云埋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺","author":"朱学成","text":"鼓棹禺山峡，徘徊十九峰。\n云间巢翡翠，天外插芙蓉。\n酒泛清溪月，琴翻两岸松。\n奇踪随地觅，郁郁彩云封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺","author":"朱学曾","text":"峡山古寺栖云顶，传说飞来信有无。\n风籁松涛天外接，鸟啼猿啸月明孤。\n百年地僻尘嚣迥，六月江深暑气徂。\n应我忧时心独拙，暂逢幽赏莫踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花冢吊张丽人","author":"苏兴祥","text":"十二峰头月乍收，野棠枝上乱莺流。\n舞衣香在閒金镂，宝帐尘生卸玉钩。\n桃叶渡湮江楫冷，松花书断蜀笺愁。\n西陵若问同心结，油壁车声怨紫骝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵洲寺 其一","author":"苏兴祥","text":"海上维舟日，鳌峰夕照阴。\n虚亭鱼鳖上，古殿雨花深。\n境寂高僧定，江空孤客吟。\n何当芳草色，空忆在长林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵洲寺 其二","author":"苏兴祥","text":"苍茫离野岸，幽磬散江风。\n云树重重合，关河面面通。\n人非天地里，世在有无中。\n徙倚层崖上，遥天鹤唳空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日登翔凤台","author":"李麟祥","text":"荒台百丈挂藤萝，驻马登游载酒过。\n日色濛溶天淡抹，风声嘹亮雨斜拖。\n忧时蒿目心同远，恋阕幽怀赋更多。\n借问当年程太史，金商瑟瑟奈秋何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小瀛洲","author":"李麟祥","text":"瀛洲一块水镜开，别是蓬壶圻泐来。\n东鞭西弭悬日月，青天白昼吼风雷。\n齐谐吊诡志不得，或汩或没水长齧。\n如狮如象如虬形，倏忽鬼神潜出入。\n自从娲氏百炼成，派分龙门禹穴名。\n秋深岁月蛟龙长，茫茫海岛四无垠。\n最恨祖龙蓦着鞭，永弃江岸几千年。\n鲛人婺妇浑不管，蒸云吐雾带花眠。\n说恁牢骚松溪子，顾我谑浪情不已。\n留此瀛洲作话传，一咏一觞振如此。\n迩后杂遝罕逢迎，长松落日枕孤城。\n明月在天还自照，野花流水逐春生。\n至今说与浪游人，浮云苍狗君勿论。\n但使长江片石在，兹君伴奂老乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李侍御新建东山文昌阁落成诗","author":"李麟祥","text":"文昌新阁嶂东川，古木清幽不记年。\n城郭万家烟火合，宫墙千丈彩云连。\n龙山风雨天同润，凤岭圭璋日共缠。\n报道窦阳欣御李，几人瀛水并登仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封八景韵 其一 江口归帆","author":"蒙曾暄","text":"江流澄色碧于苔，夹岸山花次第开。\n柔橹声声向晚转，轻帆片片逐风回。\n闲云缥缈横遥渚，疏雨空濛洒落梅。\n可是虚无图画里，支筇徙倚漫徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封八景韵 其二 灵洲渔唱","author":"蒙曾暄","text":"何年神物结灵洲，付与渔人唱上头。\n惯弄烟波欺浪险，闲收纶网放歌秋。\n携来市酒呼明月，醉去狂吟和碧流。\n忆昔独醒人已远，凭谁共拟濯缨游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封八景韵 其三 景星夜月","author":"蒙曾暄","text":"卓锡何年驻景星，月华高向此中明。\n天香映处祇林白，玉露飘时贝叶清。\n草台荒台光惨澹，云间紫极耀升平。\n悬知胜概当年事，剩得馀辉满锦城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次临封八景韵 其四 猿岭飞泉","author":"蒙曾暄","text":"猿岭嵯峨势插天，云根晴润渔清泉。\n漂将匹练千寻碧，散落琼花万朵圆。\n不尽潺湲随曲涧，无边淜湃赴长川。\n只今逝者依然在，拭目源头一洒然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登太白酒楼用黄宫詹韵","author":"区大纬","text":"任城百雉何突兀，城边古道层楼出。\n楼上仙人去不还，杨柳芙蓉自披拂。\n清平奏曲是何年，天子呼来尚醉眠。\n何如采石矶头夜，捉月骑鲸飞上天。\n天边明月依然在，清光夜夜生沧海。\n玉楼高处几经春，虬龙何日洒飞鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过豫国士桥","author":"区大纬","text":"石桥夕照断行人，一读残碑一怆神。\n七尺当年捐报主，二心千载愧为臣。\n英魂赤日遥相映，侠气寒霜尚可亲。\n三跃未酬吞炭苦，祇令怀古泪沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈明卿太史招同李烟客集古南池","author":"区大纬","text":"黄鹂日日啭高枝，正是天涯倾盖时。\n风约露荷香淡淡，月窥檐树影离离。\n千秋重见南池宴，永夜频传北海卮。\n解却兰舟相借问，西山宁负白云期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都中同马伯起戴公纶送家启图","author":"区大纬","text":"天涯芳草碧纤纤，送客都门诗酒兼。\n话以忘形欢正剧，客缘将别恨偏添。\n雪歌自愧巴人和，星聚重烦太史占。\n我亦将归对黄菊，销魂无用赋江淹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登中宿峡","author":"区大纬","text":"秋江净如练，倒影渡秋阴。\n自得胜情具，不知山浅深。\n瀑声冷明月，蛩韵助微吟。\n醉拂石床卧，清光一夜侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"胡绢庵中尊西山寺虹社初开","author":"区大纬","text":"琴鹤招携上界开，艳阳佳气共登台。\n千年洛社潞公事，万里岳阳供奉来。\n金粟座高清梵落，木棉花好乱红堆。\n兴酣泼墨满衣袖，看我天池拂濯回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"濠涌水闸成赠冯明府","author":"区大纬","text":"烟涛何处接溟州，怪兕雄鲸出上游。\n旧迹百年归巨浸，庶攻不日赖嘉谋。\n直教半壁凭支柱，何事投鞭可断流。\n由此金汤万年利，看人閒放五湖舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南园故址","author":"黎延祖","text":"断桥芳草郭东渠，天上谁来享祀醑。\n五典旧闻从舜代，三仁方古见殷墟。\n鱼须学士悲埋骨，马革忠魂痛绝裾。\n空有行人知往迹，怀深重忍立踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南园故址","author":"黎延祖","text":"古祠仍旧在东隅，一读残碑却起予。\n五典旧闻从舜代，三仁终古见殷墟。\n鱼须学士悲埋骨，马革忠魂痛绝裾。\n空有行人知往事，暮云芳草共踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬辰寄谢陈伯玑先生选刻忠悯遗诗","author":"黎延祖","text":"古道谁于今日然，碑阴硕友记吾先。\n交因陈实生前重，书识扬雄死后传。\n恨魄犹随南诏鸟，吟魂应慰北邙烟。\n鹠鹂感激知何用，四壁无藏自可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得徐巨源先生书却寄","author":"黎延祖","text":"持书涕湿却难开，莫道先生天下才。\n鱼树鸟泉知去处，松云人路想归来。\n死生交至存今日，痛哭又成独上台。\n犹许故人为立传，不曾索米向蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得陈士业先生书却寄","author":"黎延祖","text":"十年瞻望虎头城，剑气狼烟暝未明。\n父党犹存能问讯，江西不远却难行。\n开书泪满高僧衲，频梦怜深孺子情。\n遥想旧时梁下榻，悲凉相对话平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得陈元水先生书却寄","author":"黎延祖","text":"十年音问尚茫茫，惊鹤遥传在建阳。\n忽见虎头城有信，因悲马革事重伤。\n循陔瞻望嗟何及，履石存心忆每狂。\n闻道家山憔悴尽，须眉争似旧时长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋羊城怀故山","author":"黎延祖","text":"闷客恹恹村梦数，听残画角每凭楼。\n山中何处白云满，濠泮依然绿水流。\n寂寞久淹芳草地，衰迟懒过御梨秋。\n故园橘柚空相待，好月谁看最上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"路易庵中翰入粤扶文贞公榇还广平见寄姑苏李密庵中丞撰先忠悯墓志铭志感赋赠","author":"黎延祖","text":"流家笠泽来南海，却望燕山忆旧时。\n古寺独扶丞相榇，荒碑烦寄外孙祠。\n相看空羡全忠孝，可赠唯多雪涕洟。\n为报龙门青琐老，孟郊名藉退之垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"澹归和尚坐上逢查伊璜先生初至羊城","author":"黎延祖","text":"海气函秋橘柚黄，满城悲角落微霜。\n高僧坐上初来客，出世文中最擅场。\n载酒游时怜寂寞，怀铅到处记荒凉。\n蓼莪涕雪因君感，慰读新编第几章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送严伯玉勋卿还虞山","author":"黎延祖","text":"枯泪沾巾鲠别言，旧时相送更谁存。\n白云空望吴山远，黄绶虚荣楚水昏。\n看尽家人离乱数，未完婚嫁往来烦。\n问君不肯淋漓饮，明日舟停何处村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜万季用职方偕弱士金吾亚叔博士至粤旅中感赠","author":"黎延祖","text":"吹角愁中初雁声，相怜相见不胜情。\n虎头恨在归蒙诏，羊舌交存过穗城。\n第宅已空唯拄剑，蓼莪虽废尚携籯。\n与君同是流离客，聊赠穷途泪一倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"坐忆","author":"黎延祖","text":"坐忆溪桥二月时，木棉花发鸟争枝。\n自红兽炭尝新酒，閒白龙筠补旧篱。\n携被好寻山寺宿，听莺同有后园期。\n迟迟此日桃花水，容与春风可共谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王玉树邑侯辞官归里","author":"黎延祖","text":"苍生方庆野成霖，忽动归与栗里吟。\n月缺俸钱犹似客，身辞官阁更无琴。\n漫云水弱须剂火，才见春晴已作阴。\n少乏宦情彝甫事，如君真有古人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄蒋莘田侍御","author":"黎延祖","text":"两代龙门天柱高，西台直节著清操。\n禁烟未散啼鸟树，宫月犹悬照豸袍。\n书上螭头承霁色，朝回花下醉春醪。\n何时骢马来南国，得向都亭见节旄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄朱竹垞太史","author":"黎延祖","text":"昔年曾接岭南游，尊酒论诗海上楼。\n枫落吴江渔梦断，月明珠海雁书浮。\n玉堂地迥心偏远，仙掌云深静似秋。\n闻道龙门收逸事，茂陵书在托谁投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王阮亭宫詹告祭南海神还朝","author":"黎延祖","text":"奠璧沧溟到海东，霓旌初下祝融宫。\n中朝保傅封禅重，北斗声名剑舄崇。\n驻盖便寻遗逸士，怀铅还问旧孤忠。\n相逢一赏猗兰操，不觉哀弦在爨桐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送严庶华进士归西湖","author":"黎延祖","text":"王孙归路草迢迢，画榜看山到六桥。\n朱毂满城临水饯，青蓑孤航隔江邀。\n珊瑚觅得归装剑，斑竹行探自斸箫。\n他日上林从羽猎，紫骝看跃霍骠骁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄严矱庵侍御兼致令弟庶华进士","author":"黎延祖","text":"湖山澹荡碧嵯峨，先世游踪此最多。\n天上星辰难借问，海边轩骑枉相过。\n不因论旧思鸳鹭，安拟缄书出薜萝。\n近想螭头封事少，柏台风细听鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛未花朝赠李孝先新婚","author":"黎延祖","text":"玉树茏葱更着花，三湘归客赋秦嘉。\n明珠卖补新茅屋，紫燕权栖咏柳家。\n东阁题梅称绝调，西园香雪许齐夸。\n文章节侠风流甚，好卷巫云入帐纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镇海楼","author":"黎延祖","text":"东南王气古今浮，层构重成镇十州。\n仙树夕阳啼鸟散，汉台微雨落花秋。\n半廉云卷犹飞栋，两袖风清更上楼。\n酒后翩翩乘兴至，海边明月挂城头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镇海楼","author":"黎延祖","text":"东南遥望霸图休，独上危楼见九州。\n仙树影斜啼鸟散，汉台人去落花秋。\n半帘日月依天转，万里波涛绕郭流。\n酒后有谁乘兴至，浮云高涌出城头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王虹友还姑苏","author":"黎延祖","text":"仙驿横江一舸开，丹山碧水探奇回。\n雨藏芳树搴吴苑，云蹴春涛别汉台。\n画省许通薜萝字，红亭应泛棣花杯。\n中朝计相归江左，喜共三农咏草莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉山道中","author":"黎延祖","text":"平芜一望锁烟霞，林树荒凉落槿花。\n野店自怜幽意好，白云深处少人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过七里泷谒严子陵先生祠二首 其一","author":"黎延祖","text":"严滩西渡绕晴空，古迹苍茫入望中。\n汉代山河今已矣，钓台犹自挹高风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过七里泷谒严子陵先生祠二首 其二","author":"黎延祖","text":"高风千载已如斯，初渡游人拜古祠。\n滩水滔滔云杳杳，夜沉谁识客星移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻春词二首 其一","author":"黎延祖","text":"日日寻春转惜春，木棉花发柳条新。\n黄鹂久住终飞去，忍见悲啼别主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻春词二首 其二","author":"黎延祖","text":"日日寻春不觉春，初来江燕自亲人。\n旧巢何处不飞去，莫是空梁已落尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水影芙蓉","author":"黎延祖","text":"轻红淡粉倚疏篱，似是还非独立时。\n愿解明珠寻洛浦，化为蝴蝶宿花枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋月","author":"黎延祖","text":"高楼吹角杂笙歌，团扇初悬换绮罗。\n何处夜来寒似水，赤栏桥上冶游多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"黎延祖","text":"碧砌初惊蟋蟀声，南窗移榻爱新晴。\n穷檐洗尽金银气，寄傲今宵且尽情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋汉","author":"黎延祖","text":"自是银河带砺长，岂同尘土变沧桑。\n白头吟尽悲人世，难似星期永不忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋林","author":"黎延祖","text":"丹枫衰柳不成堤，双立花禽对面啼。\n谢女晓妆楼上睇，连钱骄马过频嘶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋雁","author":"黎延祖","text":"远从北地集平沙，半夜一声惊岁华。\n忽忆故人湖海去，绝无兰讯到人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋萤","author":"黎延祖","text":"度水飞将星影乱，入林团作野燐愁。\n东家织女无灯火，莫惜馀光过小楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋砧","author":"黎延祖","text":"燕山迢递卢龙塞，蜀道艰难白帝城。\n总为寒衣添旅思，声声捣出别离情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芦笛","author":"黎延祖","text":"刁半一声画角沉，卷成落叶响秋林。\n自知不及梅花韵，亦令寒闺怨藁砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]