[{"title":"望厓门","author":"林皋","text":"怀山巨浪拥孤篷，极目厓门浩渺中。\n卷土有因惟夺港，间关无望任回风。\n于今星影寒渔海，自昔潮光乱玉虹。\n八万貔貅何所恨，白鹇犹纪宋时忠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊厓山三首 其一","author":"林皋","text":"慈元旧殿尽荆榛，碑压颓垣鸟迹新。\n惟有忠魂长不没，怒涛犹撼海门津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊厓山三首 其二","author":"林皋","text":"百年俎豆水云间，万里虹桥指顾还。\n节义今传余阙庙，何人解忆古厓山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊厓山三首 其三","author":"林皋","text":"占城一往竟何如，漫道宋人儒术迂。\n拚得海陵身一死，不妨长讲意诚书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送关明经还粤","author":"林皋","text":"石头频送客，归思正茫茫。\n水陆几千里，琴书共一床。\n彤墀曾献赋，墨绶待为郎。\n遥想还家日，南园荔子香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旅夜同李蓬庵","author":"林皋","text":"朔雪正漫漫，东楼夜色阑。\n烽烟吾潦倒，世路共艰难。\n说剑怀燕赵，题诗薄建安。\n江湖浮未得，瓠落大樽寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南安留别萧雪泥何任生","author":"林皋","text":"堤畔春风舞绿杨，又随贾客入南昌。\n布帆初问芙蓉渡，水驿遥连薜荔乡。\n满目白云迷浅渚，一时孤棹下寒塘。\n相思今夜能无赋，谁共讴吟只自伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊富阳有怀故园诸子","author":"林皋","text":"富春江上水悠悠，厓海烟岚望欲浮。\n书寄故人成万里，雁鸣残荻近孤舟。\n青袍欲湿穷途泪，白发犹存壮士忧。\n夜雨西园相忆否，可堪翘首仲宣楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云路","author":"佘锦","text":"驱车出东门，日午尚如雾。\n一水任潆洄，隔溪人唤渡。\n木末隐青山，渚禽不可数。\n松叶覆吾杯，松根络吾步。\n沙际千片云，天外双塔布。\n乐哉人未知，渔灯照归路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西山","author":"佘锦","text":"频年望西山，不踏西山路。\n冠者五六人，今始纵余步。\n野径自盘纡，绀宇半新故。\n云深鸟数啼，树密凉先吐。\n榕根络断崖，石栏曲折布。\n俯视百千家，何门有走兔。\n谁谓清泠场，未足展怀素。\n落景混孤钟，携手各相顾。\n筵罢咏而归，馀音似曲度。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鉴江","author":"佘锦","text":"长江白于练，一桥乃横束。\n齧石碎波声，十里泻冰玉。\n过客脍鲜鳞，炉头秋酿熟。\n饮罢自閒行，何必多舆仆。\n落日照空山，回光连渚绿。\n奈有僦居人，两岸杂歌哭。\n睹事若伤心，也应长闭目。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"锦岩","author":"佘锦","text":"好山如美人，贵肉宁贵骨。\n台榭其妆奁，草花其肤发。\n少之而媚生，多之则态没。\n伊岩自何来，观者神顿发。\n朱栏引清风，绀宇留明月。\n虽近歌舞场，真形亦昭揭。\n白石却嶙峋，游人不敢伐。\n如其在僻郊，万古犹傲兀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度浈阳峡","author":"黎国衡","text":"初辞中宿山，旋复度皋石。\n地灵各护奇，川岳几开辟。\n海势从西来，万里肆奔迫。\n怒石制波涛，连空锁秋碧。\n峭崖争欲坠，幽草缀寒壁。\n丹梯不可寻，止望莓苔迹。\n篙师习江湖，历险无阻阨。\n缓棹青溟间，遐览纵所适。\n飞仙去何年，微云天际白。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观音岩","author":"黎国衡","text":"奇石嵌空势，连山多崩奔。\n至此险亦止，截然当海门。\n千尺无迂回，古色雨露痕。\n俯映寒流急，惊浪相吐吞。\n近水乃岩之，海气通云根。\n欲寻杳无路，藤萝不可扪。\n徘徊荡舟去，芦苇泊荒村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为园 其一","author":"黎国衡","text":"耕烟何处好，长傍水云居。\n遇雨行无笠，逢人揖带锄。\n嘉蔬容易长，蔓草已先除。\n更待中田熟，南窗暇著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为园 其二","author":"黎国衡","text":"野人閒俯仰，山曲独腰镰。\n赤脚踏泥路，蓬头依草檐。\n锄云僮易懒，剪韭客尝淹。\n谁信于陵子，桔槔称最廉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为园 其三","author":"黎国衡","text":"昨有南山客，相期蚤种瓜。\n雨沾园一亩，云覆屋三家。\n虫小频书叶，禽幽喜近花。\n共安生计拙，不是癖烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孤舟泊小金山看月","author":"黎国衡","text":"独向灵洲问宝陀，晚晴渔舫系平波。\n山疑渡海分形小，僧记遗踪转世多。\n风捲夜云开碧浪，霜寒秋水映青萝。\n无端客思难成梦，芦苇林中起棹歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芦花丛里逢渔叟共酌","author":"黎国衡","text":"古树洲边访钓矶，芦花如雪扑蓑衣。\n澄溪雨霁客初到，隔浦云凉渔正归。\n水尽征鸿飞远碧，烟空閒鹭浴斜晖。\n江鲈斗酒何辞醉，纵有波涛此夕稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒郊野步","author":"黎国衡","text":"冬郊偶出遇晴天，片片霜红积岸边。\n老树无名涵古雪，冻禽息影入寒烟。\n荷担樵客通危径，拾穗村童度远田。\n独有石梁人到少，数声流水自溅溅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日同诸子游北园","author":"黎国衡","text":"沿溪寻路得閒园，霜后长林叶尚存。\n地僻不妨游客少，山深始识野人尊。\n池寒水落留孤石，日午烟睛见远村。\n坐久欲谈尘外况，鸟依深竹静无喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"市隐 其一","author":"黎国衡","text":"此日乾坤任隐沦，即依村市阅风尘。\n谈玄或遇垂帘客，讲易还寻卖酱人。\n樵担晚携遥岭雪，渔舟早渡隔江春。\n栖迟何处无烟月，谷口宁推郑子真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"市隐 其二","author":"黎国衡","text":"古坳旧传遗市迹，新墟长枕丝江边。\n黄牛惯牧芳洲雨，白雁閒栖苇岸烟。\n带雪独寻垂钓客，临春先访卖花船。\n野人自有野风味，初熟香粳伴海鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"市隐 其三","author":"黎国衡","text":"荏苒年光去若飞，太平景物见依稀。\n相如玩世耽沽酒，杜甫寻春屡典衣。\n鸟爱风柔鸣历乱，花知霜尽报芳菲。\n樵歌牧笛人皆醉，山隐斜阳未肯归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白蝴蝶","author":"黎国衡","text":"紫陌红尘伴侣稀，素容冉冉映斜晖。\n巧穿玉蕊浑无影，轻掠朱樱觉独飞。\n香阁似曾沾露粉，风前犹自护绡衣。\n秋霜一别知何处，琼树还应化梦归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游西樵遇雨","author":"梁湛然","text":"科峰狮岭恣探奇，洞里珠帘共泛卮。\n捉得玉龙新作浪，顿令山雨竞催诗。\n坐看红紫千章艳，顷刻阴晴万壑移。\n便欲结庐云外赏，买山休笑遁公痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦还濠弦草堂","author":"方国骅","text":"草堂昨夜梦，了了见茅屋。\n画壁存龙蛇，去向月痕读。\n破瓦盈蛛丝，短檐巢小鵴。\n直指当年题，日色照离陆。\n侧户履花寮，兰芷香若馥。\n厨烟淩高霄，庶妇馐馨蔌。\n出还理邺架，恍惚昔万轴。\n细雨湿庭阶，父老相过逐。\n予亦冠盖迎，樽罍走童仆。\n山鸡觉蘧然，往事千行哭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得灯火新凉催夜织","author":"方国骅","text":"炎热使人畏，饥寒使人忧。\n王孙六月发饮冰，烈火赤汗无与谋。\n王孙重燠樵牧寒，上天不分青白眸。\n邻家秦女夜歌舞，饮酒高楼击鼍鼓。\n夭姬学唱竹枝辞，铁板老优翻鹦鹉。\n老夫茅堂灯一辉，小儿书罢妻率机。\n粗布大帛愿不失，夜深相对有牛衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和陶归鸟诗六十八首 其一","author":"方国骅","text":"孑孑孤鸟，远弋于林。\n周回顾影，宁择佳岑。\n缄舌捲羽，郁陶中心。\n眷彼谷风，乔木阴阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和陶归鸟诗六十八首 其二","author":"方国骅","text":"孑孑孤鸟，畴与同飞。\n前者振羽，后者莫依。\n彩泽卑弃，独影宵归。\n怅望天末，云路阻违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和陶归鸟诗六十八首 其三","author":"方国骅","text":"孑孑孤鸟，渴饮徘徊。\n养弃何人，深丛馁栖。\n鸱鸮疾声，微息难谐。\n幽梁卑枝，结兹永怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和陶归鸟诗六十八首 其四","author":"方国骅","text":"孑孑孤鸟，昔鸣高条。\n凤凰于友，桐柯特标。\n烨烨其丽，产彼南交。\n伫以修翮，弗惜忧劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侠客行 其一","author":"方国骅","text":"少年重意气，昂首向长杨。\n射虎眼中刺，摧鹰臂上霜。\n肩舆谒轵里，竹笠访田光。\n坐忆王孙老，萧萧泪数行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侠客行 其二","author":"方国骅","text":"贫贱甘浊世，耻为乡里卑。\n无家秦剑许，有母严金辞。\n燕蓟吊孤竹，葡萄醉月支。\n封侯千载事，儿女未应知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侠客行 其三","author":"方国骅","text":"诸侯每长跪，北面莫须呼。\n大泽一竿钓，深山三尺屠。\n谈兵触狼食，怒酒折虬须。\n百岁累累冢，髑髅香不枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侠客行 其四","author":"方国骅","text":"绣帐长薰鸭，招邻日斗鸡。\n主依黄歇楚，宾拟孟尝齐。\n游去五湖尽，歌残北斗低。\n生憎说头白，长剑任东西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独饮","author":"方国骅","text":"隐几意不惬，把杯聊自醺。\n野人谁命驾，倦鸟独堪群。\n日暮柴门雨，秋寒水面云。\n瞽歌与巫觋，邻舍漫纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泥鱼","author":"方国骅","text":"暮酒愁蔬蔌，傒童忆钓竿。\n河鱼子夜泼，秋雨五更寒。\n岁稔江湖晏，村幽薮网安。\n香莼分得好，珍重报加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赤花","author":"方国骅","text":"远籴出韦浦，扁舟泛赤花。\n山山涵晓日，岸岸抱圆沙。\n穗井宁如旧，西川未有涯。\n十车空此载，愁绝是张华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏梅 其一","author":"方国骅","text":"汉宫颜色十年癯，白首春心梦有无。\n幽谷渺然徒自托，冰壶较尔意谁孤。\n更防戎马犹含碧，不语黄昏独握珠。\n东阁杜陵若相忆，美人原住远山隅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏梅 其二","author":"方国骅","text":"每到严冬眼自骄，嵯峨一树倚山腰。\n偏怜塞上将军笛，不负高楼玉女箫。\n霜色欲销逋客鬓，雪花全染逐臣貂。\n曾闻处士惭封禅，犹向江皋共寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"趁市八首 其一","author":"方国骅","text":"贾舶鱼航雪里来，冷烟残店竹檐开。\n难逢公子重迎亥，欲访吴门旧姓梅。\n兕酒已闻狂士哭，犊裙翻见美人哀。\n逋臣漫向鱼盐逐，一曲长歌日暮回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"趁市八首 其二","author":"方国骅","text":"鼓刀击筑更谁堪，敢向清时说盍簪。\n频岁避人如旅雁，终年糊口似春蚕。\n挟龟问卜疑伧叟，远磬焚香辨野庵。\n七宝十车浑是梦，莫誇邻女早提篮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"趁市八首 其三","author":"方国骅","text":"钩罾结罟小桥西，花雨沾衣细作泥。\n过野不存廉吏犬，绕篱仍缚杜陵鸡。\n千寻春水深成窟，百尺潜鱼大似犀。\n回首万残如市后，夕阳人散鹧鸪啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"趁市八首 其四","author":"方国骅","text":"桑麻无术故山求，归兴聊从物外游。\n万里词臣怀海市，千家鲛室杂蜃楼。\n丈人屡觅开元历，长者常披五月裘。\n怪底猎心犹未槁，逐看蛮女打春毬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"木棉花","author":"方国骅","text":"不材容得老天年，寒食丹砂木末燃。\n汉主堠亭情独远，隋宫春树色同鲜。\n残红似照崆峒火，野血疑啼建业鹃。\n惟有刺桐共开落，城南上巳句谁传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铜鼓歌","author":"方国骅","text":"辛丑二年驾黄龙，抚摩河伯鞭驱风。\n朝发夕至见铜鼓，铜鼓簴县神上宫。\n初见殊形胆若怯，跂翼古异心推崇。\n传自马援伐蛮方，得此交趾夷甸中。\n刻列星辰及牛女，魑魅魍魉无能逢。\n丹翠金石杂其状，恍惚太上鬼斧工。\n更凿龟螭踞其背，一阴一阳立雌雄。\n父老相传国初时，击之声震千里洪。\n水旱灾祲告海若，伐鼓鼓响神来宗。\n至此正统北狩年，萧养作逆据大东。\n僭王改号侮诸夏，欲取两鼓归贼中。\n百神奋怒不肯与，贼窃其一归艨艟。\n风雨雷电海水黑，此鼓跃入溟濛空。\n以后击雌雄辄应，离别凄惨难为容。\n迩来好事铸其匹，钜细新故岂等同。\n近闻儋耳之间山崩裂，流沙激出铜鼓公。\n体制尺寸恰相类，民欲归神贪天功。\n相君有力夺异贝，袭诸记室深房栊。\n俗人耳食未尽信，怀古感慨思其踪。\n昌黎石鼓子瞻和，前后两歌歌鏦鏦。\n方生歌此分鼎足，不负神天魂梦通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸳鸯词","author":"方国骅","text":"生女当生似木兰，嫁夫当嫁似王仁。\n木兰之勇天下知，王仁之名天下闻。\n君独不见青陵台，同生同死同丘坟。\n鸳鸯亦有四五种，错认便类野鸡群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿祁道民年伯七十一","author":"洪穆霁","text":"岁星南望亘长虹，大隐真人驾玉骢。\n瑶草传书来杲日，黄花开宴傲秋风。\n夜寒人醉鸠为杖，江远天空剑是龙。\n绕膝芝兰斜北斗，舞衣群拥白头翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺祁东园进士锦旋为九旬令祖母暨两尊人寿","author":"洪穆霁","text":"昼锦新从北极回，綵衣犹带上方裁。\n高堂迭进千秋寿，艺苑群推盖代才。\n天阔星文霜剑动，江寒月色夜珠来。\n追欢次第联花萼，同醉仙人露一杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿王梅孙先生七十初度","author":"洪穆霁","text":"篁溪争羡邵平瓜，更爱桃源树树花。\n万壑苍松仍老干，千寻玉蕊长新芽。\n天台小室还求友，海岛蓬莱却是家。\n遥望丹崖云起处，今朝犹似赤城霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺彭芳尚游泮","author":"洪穆霁","text":"玉树临风芹藻香，堂前争羡锦衣郎。\n传经指顾家声远，挟策驰驱翰苑场。\n千里池边腾骥足，三冬火里慰萤囊。\n丹书叠下流光远，翠羽斑衣乐未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"穷泛湖源","author":"翟祖佑","text":"一函诒我江枫咏，曾汎荃桡白鹭前。\n北郭遥连三品石，西新近失四铢泉。\n几丛弱苇牵长镜，何处残霞带远天。\n想去暮云平谷口，不知归棹卧凉烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石坂晴岚","author":"伍如璧","text":"峭壁云开古洞边，紫光十丈与天连。\n春花绽锦描朱幌，曙色流霞展翠毡。\n纷入寒潭秋洗雨，翻来图画晓笼烟。\n诛茅未遂青山计，十载行歌负石泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤山石室","author":"伍如璧","text":"星光云影凤山头，曾忆真人旧室留。\n碧玉调高明月满，黄金芽长彩霞浮。\n野花向日红犹绽，细草新晴翠欲流。\n石鼎久空丹灶冷，轻烟时抹暮林秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅坳晚眺","author":"容南英","text":"杨柳烟生蘸碧溪，春深惟见乱莺啼。\n花开如绣交松柏，日暮香零客自迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山楼夕照","author":"尹体震","text":"远望当归日，登楼思惘然。\n溪云连雨湿，风叶落霜前。\n鸟宿湖边树，人归月下船。\n秋风吹客泪，无处托啼鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金山寺塔顶留题","author":"尹体震","text":"风急乘舟破浪来，寺僧邀上最高台。\n云拖香阁浮空立，月照琼花入镜开。\n山势古今长作柱，潮声日夜似闻雷。\n登临正喜思乡望，况值新秋一雁哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒陈白沙先生母节子贤祠恭纪","author":"尹体震","text":"文章节操旧家声，世代传来共有名。\n碧玉楼边萱草长，楚云台畔蓼莪生。\n微臣遗像恩犹在，慈母留丹节尚荣。\n私淑愿为门下士，堂前瞻拜不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何柏友入都兼寄张元均明府","author":"尹体震","text":"大笑相看事壮游，不将柳色动离愁。\n好书可读开千卷，国士须寻第一流。\n冷落吴山空有梦，猖狂燕市想悲秋。\n知君久佩双龙剑，行路何妨遍九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旅况思亲","author":"尹体震","text":"强解莱衣别故园，白云南望几烟村。\n西风忽遇堂前燕，报道三秋尽倚门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏涨即事 其一","author":"尹体震","text":"长天遥见晚虹开，烟雨桐江上钓台。\n莫向迷津争问渡，钱塘应有怒潮来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏涨即事 其二","author":"尹体震","text":"暮雨空江自渺茫，美人犹隔在潇湘。\n相思望断南来雁，夜短犹悬秋梦长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏涨即事 其三","author":"尹体震","text":"花发桃溪锦浪平，采莲船起棹歌声。\n隔江儿女频相问，几度经年寄远情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]