tion":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陈稚冲一绝","author":"胡应麟","text":"绿发青袍易水涯，东风频过酒人家。\n为言上苑三春雪，何似长干二月花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"唁陆茂才二首 其一","author":"胡应麟","text":"谢家庭树正茏葱，莫拟探环向别丛。\n白玉楼中题记罢，他时来作顾非熊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"唁陆茂才二首 其二","author":"胡应麟","text":"潦倒青毡气未除，莫将流泪洒长裾。\n聊堪剩取双眸在，老向西河学著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别惟寅入燕四绝 其一","author":"胡应麟","text":"星散交游二十年，两人相对白门前。\n西风无赖长干柳，吹送千条上别筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别惟寅入燕四绝 其二","author":"胡应麟","text":"白鹭洲前白浪高，飞帆晨发广陵涛。\n浮云万里燕台上，击筑何人伴彩毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别惟寅入燕四绝 其三","author":"胡应麟","text":"十载酬知泪未忘，携来烂漫洒河梁。\n愁人最是秦淮曲，月落霜飞上去航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别惟寅入燕四绝 其四","author":"胡应麟","text":"片席遥分大海流，宝刀持赠若为酬。\n黄金台馆三千尺，截取长虹寄石头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黎秘书刘观察刘金吾丘计部李环卫周明府康茅朱三山人出饯即席赋 其一","author":"胡应麟","text":"骏骨黄金且未哀，飘然裘马赋归来。\n河梁日暮骊歌发，回首高天郭隗台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黎秘书刘观察刘金吾丘计部李环卫周明府康茅朱三山人出饯即席赋 其二","author":"胡应麟","text":"满坐青山照客装，风尘憔悴旧荷裳。\n吴钩莫问尊前色，白日长虹堕太行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黎秘书刘观察刘金吾丘计部李环卫周明府康茅朱三山人出饯即席赋 其三","author":"胡应麟","text":"四海论交碣石宫，一时携手向西风。\n惟应别后严陵钓，千尺重悬大海东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黎秘书刘观察刘金吾丘计部李环卫周明府康茅朱三山人出饯即席赋 其四","author":"胡应麟","text":"高天击筑暮云屯，大陆飞霜满蓟门。\n莫向尘埃惭浪迹，十年词赋在乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黎秘书刘观察刘金吾丘计部李环卫周明府康茅朱三山人出饯即席赋 其五","author":"胡应麟","text":"寂寞妖姬旧酒楼，南归金尽鹔鹴裘。\n阴符匣底犹堪读，可