[{"title":"闺中词二十首有序 其十八 弄婴","author":"张元凯","text":"锦襁犹自泣呱呱，玩弄当年小凤雏。\n恐学良人游汗漫，任教绣户不悬弧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29333,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其十九 缝衣","author":"张元凯","text":"征衣寄去到长安，才见霜飞木叶丹。\n何事深闺缝未息，高堂垂白恰初寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29334,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闺中词二十首有序 其二十 拥炉","author":"张元凯","text":"共簇红炉近翠床，貂狐袖手不成妆。\n愿言咫尺恒相倚，莫与春风出洞房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29335,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四公子诗 其一 孟尝","author":"张元凯","text":"脱秦过赵世称雄，食客何心负乃公。\n魏子冯驩犹未老，忍教薛县黍离中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29336,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四公子诗 其二 信陵","author":"张元凯","text":"六国纵横事若麻，少年公子玉无瑕。\n单车一出秦兵却，计画侯生定不差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29337,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四公子诗 其三 平原","author":"张元凯","text":"夫人弟却五城封，存得邯郸罢折冲。\n门下毛生犹未识，如何肯过卖浆佣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29338,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四公子诗 其四 春申","author":"张元凯","text":"三千珠履曳长裾，权略当年尽不如。\n裂土江东城郭在，夕阳秋草故吴墟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29339,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四美人咏 其一 明妃","author":"张元凯","text":"白龙堆里塞云昏，黄鹤歌残马上论。\n自恨良家充内选，也同公主嫁乌孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29340,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四美人咏 其二 飞燕","author":"张元凯","text":"三千宫女废昭台，飞燕雄心尚忌猜。\n乍报殿成名合德，悔教小妹入宫来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29341,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四美人咏 其三 文君","author":"张元凯","text":"澹荡春风腻锦江，洞房人静鸟啼双。\n临邛傥贱成都客，閒却花枝锁绿窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29342,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四美人咏 其四 绿珠","author":"张元凯","text":"石家歌妓俨成行，金谷温柔别有乡。\n既是绿珠吾所爱，季伦何惜剖身藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29343,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"古剑篇","author":"张元凯","text":"赤帝提携日月开，弃捐平世卧青苔。\n千年英物沉埋久，斗傍寒光狱底来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29344,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"古镜篇","author":"张元凯","text":"明月长盈万古同，雕龙匣里湛然空。\n耻留红粉妍媸态，烈士肝肠一照中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29345,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对酒吟二首 其一","author":"张元凯","text":"屈原投湘徒自洁，介推逃山焉用文。\n时乎不遇饮美酒，高歌激散青天云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29346,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对酒吟二首 其二","author":"张元凯","text":"季子黑貂不掩骭，百奚伏雌聊可烹。\n丈夫破产出门去，斗酒慰劳吴王城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29347,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"古词二首 其一","author":"张元凯","text":"纷华戚里不胜春，年少横行贵绝伦。\n待媵尽歌江有汜，于田乍赋巷无人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29348,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"古词二首 其二","author":"张元凯","text":"长杨宣曲尽为家，大道纷纷拥狭斜。\n十里五楼巢弱翠，千金一疋买桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29349,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"芳宴二首 其一","author":"张元凯","text":"醉客金罍芳树边，琼轩珠箔立婵娟。\n彩云窈窕檐间度，艳曲玲珑花外传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29350,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"芳宴二首 其二","author":"张元凯","text":"卜夜邀欢锦瑟调，满堂兰气袭鲛绡。\n冰壶月映光逾湿，玉树风含影太娇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29351,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"少年行二首 其一","author":"张元凯","text":"少年结伴出春明，十里青楼卷幔迎。\n游骑纷纷尽回辔，金张子弟独横行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29352,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"少年行二首 其二","author":"张元凯","text":"呼卢彻夜玉为筹，橐里金钱若水流。\n昨赐飞龙厩中马，今来输与富平侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29353,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨柳词二首 其一","author":"张元凯","text":"稽洛山边春草残，渔阳戍里夕烽寒。\n故园杨柳年年绿，只有闺人带泪看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29354,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨柳词二首 其二","author":"张元凯","text":"妾梦飘扬绕翠帏，柳花飞处思依依。\n好随风絮天涯去，寻得萧郎作伴归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29355,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卫尉春游曲二首 其一","author":"张元凯","text":"都护春游锦缆开，紫骝閒在夕阳台。\n升平不作军中乐，载得琵琶水上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29356,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卫尉春游曲二首 其二","author":"张元凯","text":"暮春芳树乱莺啼，紫障金罍绕大堤。\n不是海波平似镜，将军那得醉如泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29357,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"邯郸客二首 其一","author":"张元凯","text":"邯郸侠客长安游，青楼要入弹箜篌。\n单车使者来附耳，对酒不言心自筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29358,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"邯郸客二首 其二","author":"张元凯","text":"邯郸侠客黄金轻，彻侯争致公子迎。\n宝刀骏马散却尽，空手笑出燕王城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29359,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"故倡行二首 其一","author":"张元凯","text":"结客纷纷尽侠徒，身随大将执金吾。\n绿韝白马道傍立，长揖霍家冯子都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29360,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"故倡行二首 其二","author":"张元凯","text":"香风逐马御沟斜，朱邸潜归满袖花。\n女弟垂鬟才十二，不嫌怀里教琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29361,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹枝歌二首 其一","author":"张元凯","text":"燕子高楼水上开，楚江风雨竹枝哀。\n贾帆未向门前落，孤负春潮日日来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29362,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹枝歌二首 其二","author":"张元凯","text":"水落寒江露钓矶，春时去路已全非。\n郎今无那舟行远，匹马先从间道归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29363,"sha256":"0e5ded52c9