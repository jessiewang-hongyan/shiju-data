[{"title":"庚辰赴谪金陵过三山同年舒国裳刘实夫廖师贤郭澄卿邀饮即席联句时正月念五日 其二","author":"张岳","text":"春霁桥西雨，商歌本不卑。\n愁人尊酒尽，卧病一舟宜。\n忆昨心犹壮，怜今路正岐。\n杜陵那可作，心事草堂知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25155,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"海丰道中","author":"汪思","text":"问欲殊方走画熊，旌旗长在瘴氛中。\n山松带雾闲藏雨，海蜃吹涛怒斗风。\n烟火无家多作耗，鱼盐有户未应穷。\n可怜万里天王地，何为羁人感断蓬！","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25156,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"碣石卫城八景","author":"李实","text":"玄武三台景色鲜，犀牛望月吐青烟。\n永兴古寺钟声响，港口归帆渔火炫。\n南灶云霞波万顷，茯洲浮地浪千层。\n石桥半渡传今古，耸秀桂林夜月圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25157,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟师","author":"俞大猷","text":"倚剑东溟势独雄，扶桑今在指挥中。\n岛头云雾须臾尽，天外旌旗上下翀。\n队火光摇河汉影，歌声气压虬龙宫。\n夕阳景里归篷近，背水阵奇战士功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25158,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谒五坡祠","author":"王绍元","text":"丞相忠魂何处招？\n纲常九鼎系山腰。\n百年事去公方饭，千里师行恨未销。\n血染燕尘应化碧，气吞海若已随潮。\n荐芳哭尽英雄泪，枯木寒云暮又朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25159,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过碣石逢九日","author":"叶维荣","text":"不为谈天来碣石，只缘探海入蓬莱。\n三山晓日晴千里，万灶杉云酒一杯。\n白羽已随蛮嶂尽，黄花偏向战场开。\n风流不减桓司马，醉倚星岩落帽回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25160,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"颂五星祖祠","author":"叶高标","text":"荷蒙我祖建都阎，金水行龙木火炎。\n水出昆仑生帝北，火明许嶂法天南。\n东山乔木家声远，西域黄金汉室端。\n着锦千载承圣主，淮鸣土鼓尽中湛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25161,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过羊蹄岭赋","author":"陈炫藻","text":"巨灵擘石峭如梯，却向羊蹄试马蹄。\n雾拥山腰人影小，天垂海面夕阳低。\n千盘绝蹬行无尽，九点齐州望不迷。\n报道风涛犹鼎沸，欲将长剑截鲸鲵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25162,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"从军行","author":"卢锻","text":"羌笛横吹塞下秋，骁骑铁马满边头。\n丈夫报国应如此，不扫蓬婆誓不休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25163,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜长","author":"刘崧","text":"月出乌啼城上头，闺中美人含远愁。\n银河迢迢当北楼，褰帷弄影扬清讴。\n月光如水地上流，珠箔微茫悬两钩。\n罗衣半捲凉飕飕，起坐数尽寒更筹。\n更筹数尽明不发，明日镜中生白发。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25164,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黄石斋举子同馆勒双卮以寿 其一","author":"倪元璐","text":"杏坛推才，五台选德。\n为是父儿，宜烦孔释。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25165,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黄石斋举子同馆勒双卮以寿 其二","author":"倪元璐","text":"今之黄童，乃在漳江。\n是父是子，亦既有双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25166,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题王季重石鼓淮河两歌","author":"倪元璐","text":"二千年古，九千里曲。\n请无彼观，而此之读。\n掷地作声，染字皆绿。\n昌黎扶轮，少陵捧毂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25167,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画石为吴骏公","author":"倪元璐","text":"骨则有馀，态殊不足。\n问之君平，传于五鹿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25168,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画石为祝寰瀛 其一","author":"倪元璐","text":"我醉欲眠，其中空洞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25169,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画石为祝寰瀛 其二","author":"倪元璐","text":"静而有文，可不与语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25170,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画石为祝寰瀛 其三","author":"倪元璐","text":"人痴多肉，石狡去骨。\n山灵世情，与汨俱没。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25171,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画石为祝寰瀛 其四","author":"倪元璐","text":"比类连徒，棱棱岸岸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25172,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画石为祝寰瀛 其五","author":"倪元璐","text":"黝然以黑，蟠然以憨。\n似随鱼网，出于江潭。\n化书谭峭，想当盘桓。\n烦子再往，敬问平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25173,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画石为祝寰瀛 其六","author":"倪元璐","text":"居百尺楼，或拜其下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25174,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画石为祝寰瀛 其七","author":"倪元璐","text":"熊经鸟申，可以长生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25175,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画石为祝寰瀛 其八","author":"倪元璐","text":"善舞多窍，强骨能飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25176,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇石为王霁宇司马","author":"倪元璐","text":"静安以贞，轩翱而骋。\n巫高见飞，李广疑寝。\n其矫如虬，将萦似蚓。\n备德矜能，肤清骨挺。\n我将拜之，请君勿哂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25177,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画石为朱丈恒岳","author":"倪元璐","text":"中洞以灵，骨强而正。\n使人如此，天下其定。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25178,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为胡甥武迁题扇石奉陈明卿祭酒 其一","author":"倪元璐","text":"结为地脉，奋为星精。\n观其岳岳，有若文人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25179,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为胡甥武迁题扇石奉陈明卿祭酒 其二","author":"倪元璐","text":"如其飞来，必有攫去。\n此石头禅，不去不住。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25180,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题解石帆追褒册子","author":"倪元璐","text":"责花责其果，奖柯奖其株。\n为果为可食，为株为可扶。\n广陵八月涛，白马张素车。\n橘花台上花，一开千日敷。\n涛气为男儿，花妍发闺姿。\n所以两异人，鸿光双聚眉。\n干镆称夫妇，精合生双剑。\n黄门跃其一，奔霆以激电。\n方其理祥刑，持法如持水。\n及其拜夕郎，触山如触纸。\n江流岂不洪，追源良以远。\n有母问平反，无父教咸謟。\n薪尽火方传，形没理弥显。\n旌贤旌所生，彤章下元土。\n一命游鶤飞，再命潜蛟舞。\n不知地下人，为作何欢慰。\n君看死者荣，当知生者瘁。\n人生忠孝怀，但学围葵理。\n忠以倾其心，孝以芘其抵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25181,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"曹娥祠","author":"倪元璐","text":"浪影日夜翻，一翻一酸楚。\n凭舟认碑气，神童而庙古。\n屃汗洗籀文，虫口笺痛谱。\n健哉十四姝，胫走天吴府。\n载沉复载浮，潮汐共吞吐。\n神人相媚时，波心五月五。\n盱有技绝伦，媚神以妙舞。\n神何以报之，媚盱以死女。\n不由盱有女，那知娥有父。\n一浪使盱腐，再浪使娥俎。\n谁云死娥处，不是生娥所。\n茫茫忠孝魂，入水即水主。\n近从西江头，割来涛一缕。\n一衣带水耳，翻出奇如许。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25182,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沈孝廉继母节颂","author":"倪元璐","text":"天桥夜坼婺光起，愁鸿泣尽芦花水。\n冢中韩重宁孤栖，鬼声啾啾乞无死。\n养血血飞成羽鳞，潜蛟快舞双龙子。\n霞文欲聚霜华消，但望怀清台气美。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25183,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黄金台吟","author":"倪元璐","text":"吾将扬髯鼓腮，问乎昭王之金台。\n提金呼人汝其来，壮夫面土心成灰。\n宿瘤如有貌，想当不自媒。\n嗟吁乎，士不爱鼎，王不好瑟。\n燕王台上取良金，荆王门下投奇璧。\n璧固贱于玞，金亦不如锡。\n吾闻燕王买骏燕山下，蹄鬣相逢多路马。\n路马易嘶，路神易祈。\n若俾骏马鸣自理，骏马宁死而骨耳。\n马口瘖，人眼瞢，谁知者，九方歅。\n九方善相马，箧中无黄金。\n嗟吁乎郭隗乐毅非高贤，燕台抗千金，燕士持一钱。\n台高于天，士卑于渊。\n嗟吁乎今燕古燕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25184,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"古盘吟","author":"倪元璐","text":"古者制器人，奥深有神理。\n范泥能玉明，投尘不灰死。\n本期丰城光，故蛰吴桥里。\n一锹喧五龙，十里霞文紫。\n天壤凡英能，尽听炉锤使。\n就以昆吾钩，妙巧盛兹簋。\n何殊天地炉，精奇埏范子。\n百年显晦缘，大略通相似。\n众缺所以完，大美不能毁。\n左羊量楚卿，召管商齐垒。\n并审才不如，推能者生尔。\n风华足相亲，遂与为双士。\n配以冰玉壶，注之昌城蕊。\n弗使学剑华，化龙延津水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25185,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书浮丘左公传后","author":"倪元璐","text":"曾阅遗编节烈林，无端感激泪难禁。\n宇宙茫茫流水逝，秉彝好德在人心。\n伟哉正气砥伦常，肉骨虽寒魂魄香。\n即如浮丘左少保，立朝精白矢刚方。\n忆自貂珰煽毒薰，蔽明炀灶玉偏焚。\n福善祸淫天靡定，公与应山志不分。\n罗织百端肤已縻，捧日擎天甘如饴。\n闪倏逆氛若电扫，造物衡平信有知。\n离照当阳表幽韬，孤忠己录纶音褒。\n草野传呼竞称快，临风啸咏首重搔。\n吁嗟自古谁无死，或重泰山轻鸿毛。\n君不见李固杜乔标汉史，日杲杲兮泉滔滔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25186,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"健妇行为宗节沈氏作","author":"倪元璐","text":"有健女子汉不如，须眉百辈为次且。\n天柱地维时??，手持名教安鳌居。\n十八间关方婉娈，鸡凫佩玉春风倩。\n星桥忽坼燕羽差，千日簧翿激于电。\n尘生甑釜家徒壁，藐尔呱呱老姑戚。\n收魂约痛为其难，朝事酒浆暮襞绩。\n燧人无灵风不反，旱魃为虐池无蘩。\n天之杌我良不克，摩榆织荔矢弗谖。\n大刀截剃小截机，谁识青闺是绛帏。\n参穷荻尽课不歇，鬼为夜哭同歔欷。\n二十馀年犹一旦，芝草荣阶方灿烂。\n未亡无志求难老，归报黄垆应一粲。\n吁嗟苦节自不朽，乃若其才世岂有。\n方今海宇急需贤，安得如尔者八九。\n毅以治兵无逍遥，晰以治糈何庚癸。\n分津布要诚如此，潢池坐化揭竿毁。\n卖刀卖剑赖循良，剧盗槁缚蚁贼僵。\n于女则师士不冠，匪徒家祯伊国祥。\n臣忠妇节排九阊，仰视列宿射寒光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25187,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登香炉峰观石壁","author":"倪元璐","text":"到顶知山大，他家尽小巫。\n试看烟似篆，应予号为炉。\n摩诘室安否，稽康书有无。\n此原入画格，著我即成图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25188,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山行即事","author":"倪元璐","text":"桥影如长练，肥蛙侮瘦驹。\n十山则一水，东佛而西屠。\n竹倩云为客，花囚蝶作俘。\n风传糟气好，幸有杖头蚨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25189,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汎湘湖","author":"倪元璐","text":"叫破鸬鹚梦，粗吟与细呼。\n柔风扶病橹，瘦影点酸湖。\n舫额誇题米，堤身盗姓苏。\n山山有新意，不是画葫芦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25190,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏驾湖夜汎","author":"倪元璐","text":"湖口交云脚，憨烟一万梢。\n盲舟逢石怒，狂韵解山嘲。\n野有螺开舍，人如鸟失巢。\n愁燐方结阵，竖指画乾爻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25191,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"行路","author":"倪元璐","text":"行路不期到，抛鞭任钝驴。\n雨戾唾花面，云勤顾鹊庐。\n诗材资大猎，湖长奉新除。\n稍俟双眸阔，关门即著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25192,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游飞来峰 其一","author":"倪元璐","text":"未写亦槁子，连天云一团。\n花情如石冷，鸟语逼人酸。\n溪合雨成拍，峰无岚不冠。\n湖山饶炼格，政在杳茫难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25193,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游飞来峰 其二","author":"倪元璐","text":"领取空濛意，丛林五月寒。\n雨如椎博浪，石可枕邯郸。\n渐觉身非肉，傥由山是丹。\n分明旧相识，故作面生看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25194,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同汉逸康侯步出灵鹫寺踞石饮流萧然自远","author":"倪元璐","text":"祗是无他供，家常石一支。\n册云侯洞口，诏水使诗脾。\n味去僧无几，福踰佛不知。\n三人谁免俗，判一与沙弥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25195,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"发足灵鹫抵天竺便访峰丹二上人","author":"倪元璐","text":"闻之刘梦得，只此外何奇。\n青得山无奈，白为云可知。\n亲僧因佛面，刻竹是花诗。\n道破真名字，西来第几支。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25196,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陆鲲庭计偕","author":"倪元璐","text":"习说又三载，逢人胆过头。\n衙官班屈宋，儿子第融修。\n伸纸只无畏，上书非有求。\n管城飞食肉，相法必封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25197,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再至飞来","author":"倪元璐","text":"偶然成小别，几许阅悲叹。\n召鹤僧持节，埋花蝶挂冠。\n松巢新竹攘，山法野云干。\n喜有峰犹在，知他飞去难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25198,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夹沟马上作","author":"倪元璐","text":"舍舟而就陆，譬若解连鸡。\n野外山绵蕞，花间鸟滑稽。\n央驴权不借，陷酒入偏提。\n汗漫亦殊乐，谁为七圣迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25199,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"野食","author":"倪元璐","text":"我曰驰驱日，渠云稼穑时。\n驴粮恭艾子，马食怒张仪。\n谋以肉而鄙，人因痴乃肥。\n静宵得战胜，不敢薄羹藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25200,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冒雨行乐陵道入其城萧条非昔矣而闻中使者索邮骑大哗感赋","author":"倪元璐","text":"已作不栖鸦，随风转鹿车。\n丝云抽茧谷，针雨刺纹纱。\n来去千年鹤，官私两部蛙。\n看惟城郭是，愁听此嚣哗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25201,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雄州道上望溪流泓然","author":"倪元璐","text":"大小雄如画，丹楼十里城。\n此方元特达，得水益精神。\n口语烟波气，饭香鱼子羹。\n扁舟遥望美，乃始觉驴狞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25202,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"丁卯春三月道经河间有感","author":"倪元璐","text":"不觉泣沾衣，徘徊百事非。\n滹河沈麦饭，献邸播珠玑。\n赤子终当弄，妇人恐不归。\n民情与士气，智者必知微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25203,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"至日入贺","author":"倪元璐","text":"不识阳生意，但观天子容。\n群谋各宝鼎，睿虑独黄钟。\n献履既无补，呼嵩亦不庸。\n所期添一线，智水与才锋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25204,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"双节篇","author":"倪元璐","text":"鸾悲只不舞，鹣比两为奇。\n燕子最深阁，怀清相望碑。\n孟陶贵毛里，婴杵仗须眉。\n何似双婺影，桑虫夜祝时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25205,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戊辰春 其一","author":"倪元璐","text":"引光照幽谷，谷中人鬡鬇。\n群处饮神粪，翻嫌持圣灯。\n燃犀水怪沸，失日酒人朋。\n温峤世无取，微开吾不能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25206,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戊辰春 其二","author":"倪元璐","text":"贵鹤贵其唳，厌蝉厌彼喧。\n喧经霜塞默，唳与天通言。\n贾传诚初学，留侯岂美媛。\n无将绛灌语，去与圮翁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25207,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戊辰春 其三","author":"倪元璐","text":"蜣拿丸不脱，龙见珠而争。\n二物各持据，千秋分秽清。\n侏儒观一节，曲女无巍城。\n鲸力蒲牢上，看谁作大声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25208,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戊辰春 其四","author":"倪元璐","text":"李目年八十，出胎寿已登。\n及其老也戒，故诩舌之能。\n壮健非徐偃，聪明异许丞。\n谁其无姓氏，牛马胡为应。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25209,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戊辰春 其五","author":"倪元璐","text":"昔云必复楚，亦曰苏君时。\n宁作秦庭泣，无为马食羁。\n蒲胥投愤毂，博浪喧惊椎。\n血满脉俱竖，不能如戚施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25210,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戊辰春 其六","author":"倪元璐","text":"自有荆轲客，舞阳非所期。\n惊人截豸角，难事谋狐皮。\n东食岂西宿，伯埙谁仲篪。\n有怀既独往，将助亦胡为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25211,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戊辰春 其七","author":"倪元璐","text":"每承长者责，蒙亦有区区。\n马脱五何罪，龟藏六已愚。\n海潮音不女，戎服射为夫。\n所以蹶然起，登山求䝟貐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25212,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戊辰春 其八","author":"倪元璐","text":"如非道千丈，曷敢逼魔城。\n神鼠啮盂系，尸蛆失鬘璎。\n自为狐识错，非与魅争明。\n商陆子如熟，杜鹃亦不鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25213,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戊辰春 其九","author":"倪元璐","text":"美号世群托，孤情物所攻。\n蝠能幻鸟鼠，獭岂祭虬龙。\n欲火其书易，并剸吾子凶。\n要知蜃楼阁，非必隼高墉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25214,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戊辰春 其十","author":"倪元璐","text":"世局枭卢喝，以官注者昏。\n黄师呵自了，孔子击夷蹲。\n谁任千秋担，公推五父樽。\n无将忠义死，不与吃河豚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25215,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟次吴江","author":"倪元璐","text":"一离胥渡口，即是五湖豪。\n第石登花案，除云入水曹。\n小帆如蝶翅，暗浦乞萤尻。\n不问知吴地，风呼也带骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25216,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"锡令陈石夫邀饮惠山赋谢","author":"倪元璐","text":"自关缘法合，天亦为停云。\n山惧水勍敌，石推松冠军。\n宰官身澹漠，文字饮氤氲。\n笳鼓蛙俱好，谁能喧使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25217,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉赠李信卿太公","author":"倪元璐","text":"欲奏元灵曲，河阳春正曛。\n西平矜礼法，南极动星文。\n老子树为姓，山公人事君。\n二郎知必做，自可啸游云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25218,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金山","author":"倪元璐","text":"巨灵驱岳走，半渡落泥丸。\n静鼓记舟里，中针定浪盘。\n竿头容塔进，壁上聚龙观。\n最是移情处，惊风失碧澜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25219,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]