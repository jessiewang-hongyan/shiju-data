[{"title":"悲秋十八咏 其十六 秋笛","author":"邓云霄","text":"苦调烦声急更迟，戍楼羌笛不胜悲。\n谁怜战久人先老？\n可念兵残将自疑。\n月黑关山全失道，风高杨柳半无枝。\n遥知朔漠烟尘惨，不似南征马上吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其十七 秋笳","author":"邓云霄","text":"月引笳声出塞微，城南又合数重围。\n乍吹疲马寒嘶影，三奏严霜倒扑衣。\n乌集空营冤鬼哭，星低孤垒救兵稀。\n凭谁列作刘琨曲？\n半夜胡儿掩泪归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲秋十八咏 其十八 秋砧","author":"邓云霄","text":"少妇红颜黯自怜，下机鸣杵小楼前。\n捣残鸳锦非今日，梦隔龙沙又一年。\n不惜哀音催木叶，愿随明月到胡天。\n中原荒土无人辟，汉武时巡尚事边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古六宫诗六首 其一 吴宫","author":"邓云霄","text":"南国佳人自苧萝，屧廊香径夜经过。\n啼乌渐散城头鼓，斜月潜窥帐底歌。\n金虎气沉三尺剑，红颜春载五湖波。\n千秋胜地多游女，笑上荒台踏绿莎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古六宫诗六首 其二 楚宫","author":"邓云霄","text":"柳色章台半欲凋，烟霏残黛暮还朝。\n君王本自怜神女，屏障空教贮细腰。\n梦泽猎归存石马，巫山雨散落秋潮。\n行人莫问宫前水，声咽忠魂恨未消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古六宫诗六首 其三 汉宫","author":"邓云霄","text":"三月咸阳火已红，遥闻新构压秦宫。\n汉皇自定河山鼎，萧相徒劳土木工。\n运去赤龙伤逝水，时来铜雀更摩空。\n遗基指点无人识，弹剑高歌想大风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古六宫诗六首 其四 晋宫","author":"邓云霄","text":"太平天子漫焚裘，何事羊车恣浪游。\n深苑虾蟆喧雨夜，蒙尘龙马渡江秋。\n清谈未罢了胡语，醉客初醒对楚囚。\n莫道偏安成霸业，中原无处觅神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古六宫诗六首 其五 陈宫","author":"邓云霄","text":"璧月团团满锦筵，宫中行乐足芳年。\n新词结构文如绮，妙舞轻盈望似仙。\n春去不知琼树老，井深犹有酒龙眠。\n遗声飘落知何处，曾记秦淮夜泊船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古六宫诗六首 其六 隋宫","author":"邓云霄","text":"台殿东京倚绛霄，凿河通道气逾骄。\n天垂帐幕秋临塞，月引笙箫夜度辽。\n汴柳竟移龙舸缆，芜城空拍广陵潮。\n吴公台下雷塘路，点点山萤照寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴允兆秋草诗十二首 其一","author":"邓云霄","text":"长林啼鴂妒年芳，怜尔萧疏古道傍。\n楚客旅魂搴宿莽，谢家清梦落寒塘。\n西风匹马人千里，南国孤帆水一方。\n正是天涯逢岁晏，萋萋空结九回场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴允兆秋草诗十二首 其二","author":"邓云霄","text":"谁家捣练下鸣机，叹息萦砧又挂衣。\n山下蘼芜伤北望，朔方边马想南归。\n青青浥露临关尽，白白侵沙出塞微。\n闻道五原烽火急，战场几处傍磷飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴允兆秋草诗十二首 其三","author":"邓云霄","text":"春郊青绿细如丝，还记香车出郭时。\n已衬花茵眠醉客，更承琼佩拥歌儿。\n芳心岂恃青皇宠，薄命难逢白帝知。\n回首旧游欢赏处，疏烟残照总离离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴允兆秋草诗十二首 其四","author":"邓云霄","text":"秋来满目尽堪伤，叶冷枝斜不任霜。\n夜静荒原闻蟋蟀，风吹旷野见牛羊。\n平铺秋色浑无际，暗惜春期渺未央。\n莫向金天怨摇落，李家池馆爱迎凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴允兆秋草诗十二首 其五","author":"邓云霄","text":"皂雕高掣阵云平，猎骑骎骎出汉营。\n霜剪蓬蒿狐穴浅，风生沙碛马蹄轻。\n烧荒已见无遗烬，丛薄谁云有伏兵。\n极目萧条空万里，更催飞将取龙城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴允兆秋草诗十二首 其六","author":"邓云霄","text":"晚上平皋叹后凋，寒堤望去正迢迢。\n芳菲漫自疑蘅杜，零落谁能辨艾萧？\n临水数枝斜日短，连天一色断鸿遥。\n可怜仲蔚无人问，惆怅高踪竟寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴允兆秋草诗十二首 其七","author":"邓云霄","text":"秋老空嗟百卉腓，愁心此夕转依依。\n征夫泪落明妃冢，少妇苔侵长信扉。\n天外关山何处尽？\n阶前綦履向来稀。\n红颜渐与群芳歇，来岁王孙归未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴允兆秋草诗十二首 其八","author":"邓云霄","text":"步出溪桥俨画图，残黄衰绿满平芜。\n泥寒归燕能留否？\n露重啼螀近有无。\n故国田园荒径没，前朝陵阙野烟孤。\n古来兴废皆如此，一笑牛山只自愚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴允兆秋草诗十二首 其九","author":"邓云霄","text":"风日襄阳破旅愁，大堤碱月竞遨游。\n曾依柳幕窥青眼，厌向芦花伴白头。\n肠断春光思令节，情连秋水隔芳洲。\n行行莫畏逢多露，汉女从来未易求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴允兆秋草诗十二首 其十","author":"邓云霄","text":"岁岁他乡滞客星，秋深野蔓匝虚庭。\n悲风卷箨征衣薄，寒雨鸣条旅梦醒。\n秀色正宜迷晓蝶，枯茎何意化流萤。\n物华代谢光阴速，帘外蛩声不忍听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴允兆秋草诗十二首 其十一","author":"邓云霄","text":"掩卷幽窗秋气高，无端心绪折残蒿。\n徒伤飒飒摇书带，宁复霏霏乱客袍。\n好制薜萝招隐士，欲芟荒秽续离骚。\n茅斋寄在层岩畔，木落空山猿夜号。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴允兆秋草诗十二首 其十二","author":"邓云霄","text":"有客如痴又似狂，忧生怀国两茫茫。\n羁栖更忆仙人种，飘泊难寻不死乡。\n温对黄花悲九日，何时绿野转三阳？\n谁知寸草心偏苦，未报春晖意倍长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和米君梦秋柳诗十二首 其一","author":"邓云霄","text":"大堤迢递接平沙，树影萧条冷万家。\n密叶昔时啼好鸟，悲风此夕噪寒鸦。\n残妆尚结三春恨，微霰如飘二月花。\n寄谢白家新宠妾，莫将颜色向人誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和米君梦秋柳诗十二首 其二","author":"邓云霄","text":"驿舍旗亭各渺漫，临风踠地倩人看。\n阳关唱后多伤别，长笛吹来不耐寒。\n逝水遥怜随落叶，柔条谁复系离鞍。\n天涯岁晏乡心苦，折赠空嗟道路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和米君梦秋柳诗十二首 其三","author":"邓云霄","text":"弱缕凋零绕画楹，青楼绾结若为情。\n愁深巧黛难长好，寒入纤腰暗自惊。\n半幅征衫司马泪，数声残角亚夫营。\n年年惆怅封侯事，少妇深闺怨未平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和米君梦秋柳诗十二首 其四","author":"邓云霄","text":"忆昔隋家骋逸游，曾将锦缆系龙舟。\n春流汴树通淮水，秋色芜城对古邱。\n十二雕栏忘御道，三千红粉失迷楼。\n更闻桥上箫声急，一夜征人尽白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和米君梦秋柳诗十二首 其五","author":"邓云霄","text":"走马章台问故枝，秋原宿莽正离离。\n和风淡日还无力，凉露清霜岂自持。\n旧苑腰肢非昔态，暮天云雨到今疑。\n含情欲向湘江咽，江水东流无尽时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和米君梦秋柳诗十二首 其六","author":"邓云霄","text":"谁道春宫宠爱新，恩波已落玉河滨。\n应同团扇凄凉影，共伴长门寂寞身。\n舞罢夜怜罗袖薄，眠多朝惜翠眉颦。\n素娥有意还相照，青女何心更妒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和米君梦秋柳诗十二首 其七","author":"邓云霄","text":"物色关心天一方，临堤秋望浩茫茫。\n徒伤白日偏催岁，怪尔青丝亦带霜。\n门径萧森怀靖节，锻炉凉冷忆嵇康。\n谁能更作江南赋？\n此夜思归意倍长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和米君梦秋柳诗十二首 其八","author":"邓云霄","text":"广幕阴阴嫩绿齐，荒郊早已报莎鸡。\n根连杜若寒江落，影入蒹葭返照低。\n自有烟鬟留客醉，何须露脸向人啼。\n闲来指点伤心处，渭水城边灞岸西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和米君梦秋柳诗十二首 其九","author":"邓云霄","text":"试问愁心近若何，淮南木落洞庭波。\n倚楼不见回风舞，隔水如闻蹋地歌。\n浪作丰容矜窈窕，空令岁月易蹉跎。\n谁家叹息秋衿薄？\n曲卷砧声向晚多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和米君梦秋柳诗十二首 其十","author":"邓云霄","text":"暮暮朝朝怨未消，汉南人去路迢遥。\n不同青桂争秋色，却向丹枫映暮潮。\n宾雁掠枝惊断线，寒蝉失翳欲辞条。\n行行试上台城望，一片残烟锁六朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和米君梦秋柳诗十二首 其十一","author":"邓云霄","text":"伯劳东去燕西飞。\n转眼容华有是非。\n月浸白门孤枕冷，树迎乌榜几人归。\n盈盈波上骄罗袜，脉脉江干换绿衣。\n不记别离今近远，请看旧植渐成围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和米君梦秋柳诗十二首 其十二","author":"邓云霄","text":"遨游偏忆少年场，一曲琵琶陌上桑。\n颜色此时伤黯澹，风花往日笑颠狂。\n荣枯有分谁为主？\n天地无心莫较量。\n闻道东君回玉辇，好开眉黛试新妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴翁晋梅花诗十三首 其一","author":"邓云霄","text":"疏影干云百尺长，东风一夜入含章。\n庭森玉树浑无叶，雪度瑶池却有香。\n淑气潜回迎献岁，幽姿迥出擅群芳。\n寄言二八楼头女，若个新妆胜寿阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴翁晋梅花诗十三首 其二","author":"邓云霄","text":"彼美珠袍白氎巾，翩翩高步自殊伦。\n若非海外餐霞客，定是林间捉麈人。\n霜雪任教侵傲骨，溪山真合老闲身。\n对君如坐冰壶里，懒逐渔舟去问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴翁晋梅花诗十三首 其三","author":"邓云霄","text":"芳讯迢遥竟若何，陇头缄意待君过。\n西施窈窕无装束，卫玠清癯怯绮罗。\n小苑孤眠和冷月，横塘斜立溯微波。\n莫嫌开处寒仍敛，占断春光不在多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴翁晋梅花诗十三首 其四","author":"邓云霄","text":"近识仙人萼绿华，娉婷疑在太清家。\n洗妆银浦消残黛，种玉蓝田吐瑞花。\n春信欲传青鸟使，香风遥隔白鸾车。\n羞随桃李同门径，日暮低枝倚狭斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴翁晋梅花诗十三首 其五","author":"邓云霄","text":"怜尔花神彻底清，晓风拂槛报平明。\n却嫌荀令香还重，更笑湘妃态未轻。\n霜冷天高衣袖湿，参横月落梦魂惊。\n忽闻荒戍吹残角，肠断空山半夜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴翁晋梅花诗十三首 其六","author":"邓云霄","text":"独持风格见孤标，不学修眉与细腰。\n近水宜承交甫佩，傍山应挂许由瓢。\n折来霜月怜香淡，寄去乡关怨路遥。\n只有幽兰湘浦上，芳魂千里可同招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴翁晋梅花诗十三首 其七","author":"邓云霄","text":"脉脉春心结万重，凭栏不语若为容。\n共誇宾客盈金谷，谁识天人下玉峰？\n缟带翩跹低复举，翠翘缥缈淡还浓。\n也知不杂阳台雨，尘梦无缘莫浪逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴翁晋梅花诗十三首 其八","author":"邓云霄","text":"难道春归物物同，北枝独自怨东风。\n愁云匝地寒无影，飞雪迷天望若空。\n取醉径须浮太白，寻芳何用觅残红。\n贮香换骨谁能事，荣落应知属化工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴翁晋梅花诗十三首 其九","author":"邓云霄","text":"嫩绿平原半未匀，馀寒蜂蝶敢相亲。\n谁知他日调羹手，元是高斋卧雪人。\n环佩轻摇乘好月，琼瑶碎踏乱香尘。\n六街车马应无数，空谷孤芳孰探春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴翁晋梅花诗十三首 其十","author":"邓云霄","text":"东阁栽来大几围，古今清梦眼中稀。\n应怜国色羞红粉，始信山人是白衣。\n旷野萧疏幽兴发，闲堂寂静宦情微。\n五陵年少如相问，不用披裘更策肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴翁晋梅花诗十三首 其十一","author":"邓云霄","text":"何处寒花拂曙晖，行春相见转依依。\n雪深庾岭书来少，水绕孤山客到稀。\n乘兴移尊临浦岸，留香扫地锁郊扉。\n青皇为惜冰肌瘦，莫遣飞飞乱点衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴翁晋梅花诗十三首 其十二","author":"邓云霄","text":"凌风却月尽荒邱，何逊多情恋旧游。\n借问弄珠来洛浦，能如骑鹤上扬州。\n年年春到催花发，处处风吹逐水流。\n回首别离心欲折，数声长笛倚危楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴翁晋梅花诗十三首 其十三","author":"邓云霄","text":"有女仆春日暮时，淡妆独立嗅寒枝。\n柔肠暗许檀心合，艳质休教柳眼窥。\n顾影檐前聊索笑，倾筐树底重相思。\n可怜清绝无尘染，魏紫姚黄总不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"避暑露坐书怀","author":"邓云霄","text":"月浸疏帘暑气收，金波片片傍人流。\n途穷阮籍难青眼，官拙江生岂黑头。\n凉露霏微堪沐发，明河清浅待行舟。\n愁来戏作游仙曲，夜梦应归十二楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游衡山诗十二首 其一","author":"邓云霄","text":"飞书曾寄魏夫人，遥踏罡风下紫宸。\n南岳到来如旧识，懒残还记是前身。\n钵抛山下泉应满，柯烂岩边局又新。\n何事夜游须秉烛？\n好将明月作车轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游衡山诗十二首 其二","author":"邓云霄","text":"高拂尘缨濯石泉，夜深沆瀣更澄鲜。\n月临峰顶客初到，露滴松梢鹤正眠。\n嘹亮鸾笙吹爽籁，飘摇龙杖挟飞仙。\n琪花瑶草闲堪拾，还笑冥灵是小年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游衡山诗十二首 其三","author":"邓云霄","text":"昔年图记卧中游，此夜冥搜事事幽。\n峰逼星河常似晓，岩寒炎夏已惊秋。\n草深玉匣迷金简，风送松涛泛石舟。\n借问山灵谁佐命？\n吾家元已驻罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游衡山诗十二首 其四","author":"邓云霄","text":"手携金策响泠泠，绝顶禅房夜不扃。\n天净岩峦皆拱佛，山空猿鸟亦听经。\n上方散落千行炬，南斗新添数点星。\n何处黄粱炊未熟？\n锦衿罗幕正沉冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游衡山诗十二首 其五","author":"邓云霄","text":"天鸡半夜叫空寥，谁捧金轮已弄潮？\n紫气忽冲沧海雾，玄崖俄变赤城标。\n迢迢阊阖停疏漏，冉冉仙官散早朝。\n高揖东皇望蓬岛，安期还有鹤书招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游衡山诗十二首 其六","author":"邓云霄","text":"晓持鸾尾扫山云，晃朗天门曙色分。\n赤帝旌幢萦嶂转，青童环佩隔峰闻。\n闲调石髓供朝膳，静漱银河涤晚醺。\n啸傲空山谁是伴？\n和歌惟有紫阳君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游衡山诗十二首 其七","author":"邓云霄","text":"名岳岧峣并岱宗，汉皇何事未登封。\n坛虚星斗明青玉，潭涌金沙吼白龙。\n虞辇不归斑竹怨，禹碑灭没紫苔重。\n悠悠今古浑如梦，愿学无生出世踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游衡山诗十二首 其八","author":"邓云霄","text":"婚嫁何年是了期，翛然乘兴任吾之。\n前旌且莫惊朱鸟，后乘还闻载紫芝。\n孤巘芙蓉摇瀑布，晴天霹雳起雷池。\n翻嫌樵客穿云去，只恐摧残月里枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游衡山诗十二首 其九","author":"邓云霄","text":"怀岳何须赋四愁，官闲常得采真游。\n水帘斜挂黄姑渚，天柱高撑白玉楼。\n鸡犬洞仙忘甲子，蜉蝣人世自春秋。\n休誇眼底穷三界，海外还闻更九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游衡山诗十二首 其十","author":"邓云霄","text":"肘后常携五岳图，朅来登眺果仙都。\n诸天大地还高下，七泽三湘问有无。\n翠鹫欲飞风乍起，莲花不动剑同孤。\n寥寥欲写山中意，一片清冰在玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游衡山诗十二首 其十一","author":"邓云霄","text":"把酒狂歌万壑寒，风高重整切云冠。\n烟霞吞吐随挥麈，日月东西笑弄丸。\n千岁光阴消半局，四溟空水入危栏。\n庄生未达逍遥理，浪说图南是大观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游衡山诗十二首 其十二","author":"邓云霄","text":"千峰扫径喜迎宾，历险穷幽兴转新。\n访古难逢苍水使，还山偏羡白衣人。\n且斟云液酬啼鸟，莫向桃花问去津。\n共道馀粮盈石廪，山中供给未全贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游华山诗十二首 其一","author":"邓云霄","text":"行携谢眺惊人句，载笔名山岂惮遥。\n紫气临关迎露冕，青龙扶杖上霞标。\n杯挥仙掌云摩荡，剑倚明星夜动摇。\n封禅台荒銮辂远，且呼毛女问前朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游华山诗十二首 其二","author":"邓云霄","text":"探奇却笑昌黎怯，取道宁同襄野迷。\n拍手三天招皓鹤，回头四海总醯鸡。\n猿猱倒挂疑无路，縆索孤悬自有梯。\n不信耕烟种瑶草，石沟曾破老君犁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游华山诗十二首 其三","author":"邓云霄","text":"霏霏翠翠湿芙蓉，历险穷幽几万重。\n呼吸天中通帝座，儿孙膝下拥诸峰。\n石坛礼斗银河近，竹院吹笙玉露浓。\n最爱步虚声歇后，松风涧水韵疏钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]