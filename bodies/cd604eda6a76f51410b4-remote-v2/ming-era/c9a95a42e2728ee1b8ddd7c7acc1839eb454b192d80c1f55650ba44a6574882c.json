[{"title":"国子吴检讨先茔四景之二 其一 枫桥月落","author":"倪谦","text":"吴江枫落水通桥，斜月将沉斗转杓。\n两岸秋声随籁发，半篷寒影带波摇。\n渔舟乍起吹残火，估舶争开趁早潮。\n几度吟诗忆张继，钟鸣山寺夜迢迢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40490,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"国子吴检讨先茔四景之二 其二 寒寺鲸音","author":"倪谦","text":"招提遥隔阖闾城，夜半蒲牢吼地鸣。\n度岭微分山市晓，穿林偏带野泉清。\n高低夐彻三千界，次第频连百八声。\n独有思亲情倍感，乌啼月落梦魂惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40491,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"松月轩","author":"倪谦","text":"偃蹇长松拂四檐，瑶空移上海东蟾。\n金波湛湛光浮榻，苍雪霏霏影入帘。\n老鹤惊寒时振羽，怒虬终夜自垂髯。\n幽人对此浑忘寐，一任更深漏转签。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40492,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其一","author":"倪谦","text":"宾主论文对酒卮，灯前传令影交驰。\n香云拂座元无定，华月窥檐似有私。\n李广雄韬予所慕，王维佳句世同推。\n明时幸接丹霄羽，致主黄虞敢共期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40493,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其二","author":"倪谦","text":"坐对云屏不启关，恍疑蓬岛在人间。\n锦衣华胄多君武，玉署清资羡客閒。\n取醉漫劳新酒劝，谐欢频用巧辞讪。\n秪应义重能延款，不放花骢步月还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40494,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其三","author":"倪谦","text":"繁丝豪竹弄新声，绛蜡光分绮席明。\n投辖已?厌此夕，飞觥何惜到残更。\n酒酣风月胸中满，诗就云烟纸上生。\n忆昔洪都高客赋，独誇王勃最先成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40495,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其四","author":"倪谦","text":"词源浩瀚泻三江，百斛龙文笔可扛。\n艺苑雄才君独步，吟坛勍敌我须降。\n银丝细斫吴中鲙，玉管新番塞外腔。\n昭代行看树勋业，隐居谁羡鹿门庞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40496,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其五","author":"倪谦","text":"远寺昏钟已罢撞，锦袍黑发映明釭。\n清歌声度黄金缕，法酒香浮白玉缸。\n笑语送阄人隔座，豪呼博塞月盈窗。\n良宵欢会惟三益，此乐人间信少双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40497,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其六","author":"倪谦","text":"为问潜阳几日归，谈玄浑讶泄天机。\n醉狂始觉醒来好，今是方知昨已非。\n莫向蓍龟占否泰，且从裘马共轻肥。\n深情能保如胶漆，青史陈雷继有辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40498,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其七","author":"倪谦","text":"开轩待月费吟思，诗律曾推一字师。\n宴乐尽?今夕醉，功勋须及少年时。\n名驹未试谁能识，良贾深藏世寡知。\n但使酒肠宽似海，何妨连进紫金卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40499,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其八","author":"倪谦","text":"奎壁方中北斗高，谪仙醉着锦宫袍。\n庭松月浸苍龙骨，槛竹风梳紫凤毛。\n杯送赪霞歌宛转，炉围红玉坐周遭。\n赏音可羡徐东海，一曲冰弦动誉髦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40500,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其九","author":"倪谦","text":"宝鼎龙涎散碧云，剑横秋水自随身。\n月华堕地明如昼，火气当筵煖似春。\n饮酒每歌鱼在藻，感时又遇雁来宾。\n醉中和得迎仙曲，凤琯吹将向玉宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40501,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其十","author":"倪谦","text":"座上金莲彻夜开，故人相遇且衔杯。\n一庭霜月醒残醉，万里风云入壮怀。\n分阃伫看持节钺，调羹须是用盐梅。\n结邻若许通幽径，不惜移樽日笑陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40502,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其十一","author":"倪谦","text":"千金结客重交游，诗酒相忘不解愁。\n汗简细评科斗篆，仙关疑接凤麟洲。\n冯驩客里须弹铗，王粲吟边独倚楼。\n谁似此轩幽绝处，高歌取醉倒琼瓯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40503,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其十二","author":"倪谦","text":"貂裘坐拥不知寒，月转琼筵捲幔看。\n羌笛且教停折柳，瑶琴谩听鼓猗兰。\n图形拟上麒麟阁，执法休论獬豸冠。\n豪客新诗三十首，锦笺书就墨华乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40504,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其十三","author":"倪谦","text":"将军能武复能文，书重羊欣白练裙。\n韬略已看推巨擘，旂常行见纪元勋。\n肯将节操炎凉改，剩有声华远近闻。\n况是东轩多胜赏，新题时与故交分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40505,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其十四","author":"倪谦","text":"石屏积翠喜淩霜，遗戒谁曾效赞皇。\n九曲峰峦争起伏，四时松竹共青苍。\n开轩久玩情偏爽，把酒閒吟夜正长。\n醉后不禁喉吻渴，霜柑细嚼紫香囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40506,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其十五","author":"倪谦","text":"子乔飞舄下西清，来听古桐弦上声。\n玉椀香云传茗汁，金盘丹魄荐芝英。\n凤麟燄吐乌银屑，牛斗光腾宝剑精。\n却羡主人能饮客，酒行只用兕为觥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40507,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其十六","author":"倪谦","text":"碧天孤月起东林，人在重门画阁深。\n吟赏每招诸友共，清幽不受一尘侵。\n琼卮烂醉垆头酒，彩笔亲题汉上襟。\n坐久但闻香贯脑，凉烟如穗袅檀沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40508,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其十七","author":"倪谦","text":"金猊添火爇香尘，酒入欢肠不醉人。\n奇石喜看三仞玉，早梅谁寄一枝春。\n紫檀铁拨繁声急，彤管云笺丽句新。\n散步虚庭霜月冷，清风袅袅动垂绅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40509,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其十八","author":"倪谦","text":"封侯万里建旌旄，今见班超骨相高。\n小帐金杯淹翠袖，长檠绛蜡照绯袍。\n今宵痛饮宁辞醉，他日摅忠肯惮劳。\n会使燕然重勒石，功名端的冠时髦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40510,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其十九","author":"倪谦","text":"琅玕玉立俯清渠，岁晚珊珊绕燕居。\n客到閒从林下饮，诗成多向节间书。\n九天风月瞻光霁，一气阴阳验惨舒。\n宾主交欢何所似，依依绿水汎红蕖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40511,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其二十","author":"倪谦","text":"满注葡萄瓮里春，开轩剧饮见天真。\n菲才自愧登金马，壮节君看剖玉麟。\n灯下呼卢人影乱，庭前贯苇月华新。\n吟坛强和惊人句，梦入池塘觉有神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40512,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其二十一","author":"倪谦","text":"姓名早晚出金瓯，秉烛何妨入夜游。\n舞曲有腔频换谱，酒杯无算不论筹。\n閒中运甓思陶侃，醉里弹棋笑奕秋。\n逸豫每能存惕厉，行藏随处沐天休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40513,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其二十二","author":"倪谦","text":"宾主相看共眼青，喜联冠佩侍彤廷。\n多材俱羡成奇器，驰誉争誇正妙龄。\n凤斝深浮千日酝，鸾刀细簇五侯鲭。\n及时欢赏真明达，莫待霜华短鬓星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40514,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其二十三","author":"倪谦","text":"碧落惊寒雁影疏，东窗月上捲帘初。\n已成雾雨南山豹，须化风雷北海鱼。\n午夜偏能娱盏斝，三冬知不废琴书。\n明朝我试来相访，一榻清风醉梦馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40515,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其二十四","author":"倪谦","text":"胸襟潇洒更疏通，燕喜应知有古风。\n一曲清歌番子夜，百壶春酒醉新丰。\n更收残漏霜初下，云度轻绡月淡笼。\n千载南楼传故事，庾公高兴与今同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40516,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其二十五","author":"倪谦","text":"斗室幽清自不群，日华常映海东云。\n麝煤入鼎浮香篆，蛇腹横琴散断纹。\n每喜三冬频会友，谁云一饭敢忘君。\n却怜月夜霜华泠，涷损琅玕瘦几分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40517,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其二十六","author":"倪谦","text":"碧海鸟沉莫景昏，东君娱客管弦諠。\n年丰已卜经三白，阳长方当会一元。\n鹤发喜瞻南极粲，丹心常仰北辰尊。\n貂裘绣褥围炉坐，谁道连床席未温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40518,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其二十七","author":"倪谦","text":"佩玉鸣驺总俊贤，诙谐探赜更钩玄。\n酒开腊蚁清歌送，菜簇冰丝玉指传。\n榾柮煖煨霞满座，阑干醉倚月当天。\n萝关一径殊幽僻，绝胜王维旧辋川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40519,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其二十八","author":"倪谦","text":"良宵踏月远相寻，翠壁疏篁助细吟。\n度曲不须敲象板，赏音惟许操瑶琴。\n佳人惯索缠头锦，公子閒抛买笑金。\n宋玉高堂曾有赋，丽辞传诵到如今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40520,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其二十九","author":"倪谦","text":"酒酣耳热脸生红，剧辩高谈四座空。\n繁弱笑弯何慷慨，豪曹独拊自英雄。\n清音袅袅频吹竹，爽气飘飘欲御风。\n醉倒秪应同枕藉，日华还待出篱东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40521,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和王廷器检讨夕宴李挥使东轩诗三十首 其三十","author":"倪谦","text":"夜永铜龙滴水迟，玉壶春酒送青丝。\n鸾笙细咽浑忘醉，鲈鲙分尝慰所思。\n虎卫将军偏爱士，词林仙客每留诗。\n何当一拜高堂上，寿母亲称百岁卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40522,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送古廉李祭酒南归","author":"倪谦","text":"立朝四十有五载，名节赫然闻九州。\n请老许从今日去，效官真与古人侔。\n喜看群弟上封疏，即诏有司供驿舟。\n圣主虚心思旧德，乞言还见起林丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40523,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"览秀舫分题得番阳湖","author":"倪谦","text":"番湖风静水无波，此日曾乘画舫过。\n万顷天光澄素练，一拳山色涌青螺。\n朗吟赤壁苏仙赋，閒和沧浪孺子歌。\n佳胜经行宜纵览，应知清兴倚篷多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40524,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张驿丞","author":"倪谦","text":"明时作宰向雷塘，薄宦那知谪远方。\n身事不须惊宠辱，人情何必叹炎凉。\n一双白璧元无玷，百尺青松老更苍。\n万里渑池终奋翼，重登朝著讵能量。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40525,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扈从谒陵十咏 其一 驾出都城","author":"倪谦","text":"銮舆晓发带春曦，韎韐桓桓起六师。\n御路尘清森虎韔，神皋风暖掣龙旗。\n寝园祗荐存周典，原庙修祠陋汉仪。\n济济公卿扈仙跸，不才何幸亦追随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40526,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扈从谒陵十咏 其二 沙河驻跸","author":"倪谦","text":"晓驻旌旗遍野红，貔貅百里卫行宫。\n山连北极三千刃，身在中坚十二重。\n散骑徐牵金络马，将军齐带宝雕弓。\n八珍已进天厨膳，甲帐弹棋啜紫茸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40527,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扈从谒陵十咏 其三 御营启行","author":"倪谦","text":"御营五夜发沙头，满路金莲散不收。\n天外长风驱铁骑，海东初日耀戈矛。\n花香远逐龙涎喷，草色低承凤辇游。\n圣德神功弥宇宙，万年玉刻护松楸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40528,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扈从谒陵十咏 其四 寝园祗谒","author":"倪谦","text":"翠树重重宝殿开，五云常日绕蓬莱。\n才趋玉座函香进，忽报黄麾导驾来。\n下辇还须中使引，合班不待礼官催。\n鼎湖怅望飞龙远，空抱遗弓泪满腮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40529,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扈从谒陵十咏 其五 恭陪大祀","author":"倪谦","text":"人间节序属清明，天上时思轸圣情。\n法从班连庭陛肃，粢盛香拂几筵清。\n礼严陟降终三献，孝格幽明在一诚。\n此日微诚陪祀享，只歌潜颂答升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40530,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扈从谒陵十咏 其六 侍阅军容","author":"倪谦","text":"圣皇阅武禁门西，翠葆葳蕤簇仗齐。\n云拥旗幡辉日月，雷轰笳鼓振山溪。\n材官结队皆罴虎，宝马成群尽駃騠。\n勋业由来输卫霍，却惭簪笔侍金闺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40531,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扈从谒陵十咏 其七 银山从猎","author":"倪谦","text":"日上千峰紫雾消，银山蒐猎按銮镳。\n露香芳树攒红锦，风淡长杨亸翠条。\n迥野鸣鞘围万马，层空飞箭落双雕。\n从官谁道相如吃，赋就淩云气独飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40532,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扈从谒陵十咏 其八 龙池锡宴","author":"倪谦","text":"水殿筵开对碧峰，大官颁赐拆黄封。\n方壶缥缈环三岛，灵瀑铿锵喷九龙。\n在镐昔闻同岂乐，奔流今见总朝宗。\n幸逢上巳当修褉，分得恩波似酒浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40533,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扈从谒陵十咏 其九 辇道回銮","author":"倪谦","text":"三陵辞罢启高牙，振振还宫辇路赊。\n上将方移行殿垒，前茆已驻曲河沙。\n九天日驭临黄道，万乘霓旌拥翠华。\n时喜昌平贤父老，争持牛酒进官家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40534,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扈从谒陵十咏 其十 北郊迎觐","author":"倪谦","text":"清道龙骧已载途，甲光映日似银铺。\n百年礼乐逢昭代，万古山河壮帝都。\n朝士蕃王齐觐谒，黄童白叟竞携扶。\n词臣归从銮舆后，惟听嵩高振地呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40535,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卧云重题居处谧卷","author":"倪谦","text":"一枕悠悠卧翠微，白云满地掩柴扉。\n迎风疑化蒙庄蝶，汎月谁收玉女衣。\n有梦终同玄豹隐，无心遥接紫鸾飞。\n欲分半榻陪怡悦，莫道红尘未息机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40536,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"贺盛叔大升御医","author":"倪谦","text":"医国神功奏十全，新承雨露日华边。\n清资喜到金闺籍，素问多传玉版篇。\n晓月禁垣双佩入，春风都市一壶悬。\n几回欲觅烧丹处，红杏林深虎正眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40537,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"聂司训玩芳亭","author":"倪谦","text":"玩芳亭子泮之涯，身在毗陵即是家。\n促席翠烟浮绛帐，倚阑红雨湿乌纱。\n秋香篱落陶彭泽，春草池塘谢永嘉。\n莫向西风叹消歇，雪横墙角看梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40538,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次卢廷佐寄来诗韵","author":"倪谦","text":"青春去后几时回，银汉仙槎待子来。\n卞玉且为藏椟器，蠡舟终是济川才。\n秋风北渚歌遗佩，晓日南山咏有台。\n忽睹双鱼传尺素，吟看怀抱郁难开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40539,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宣圣五十五代孙孔克愚挽诗","author":"倪谦","text":"阙里移家住海乡，系分沂泗远流芳。\n壁中旧简存蝌蚪，墙际边宫识凤凰。\n放鹤亭空湖雪冷，采芝歌断野云荒。\n百年一枕钱塘梦，瀰瀰寒潮送夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40540,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同王侍御饮东郭草亭","author":"倪谦","text":"杨卿亭子郭之东，此日能来笑偶同。\n绿酒旋移花底榼，玉珂遥驻柳边骢。\n雅怀喜遇王文度，末席叨陪太史公。\n醉后联镳归去晚，丽谯犹带夕阳红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40541,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送彭状元弟纯正还安成","author":"倪谦","text":"阿兄喜中龙头选，难弟能谐雁序情。\n天上客床方对雨，沙边官棹已开晴。\n黄花篱落家千里，红叶关河路几程。\n归去宁亲知有暇，书斋良夜赋秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40542,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送杨编修假御史职佥兵兖州","author":"倪谦","text":"天书晨下紫泥封，奉使旬宣向兖东。\n深仗干城当阃外，足知兵甲在胸中。\n蓬莱久载词臣笔，海岱俄乘御史骢。\n万里封侯谈笑觅，旂常行见策元功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40543,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题刘季康绿筠书屋","author":"倪谦","text":"半亩多栽绿玉丛，小轩深结路斜通。\n疏林细雨儿孙长，高节清风父子同。\n鸾影常时翻简帙，佩声良夜入帘栊。\n乡人相访应相讶，只道秦淮是剡中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40544,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"世医堂","author":"倪谦","text":"一家医术妙通神，心地俱怀利济仁。\n肘后方书传父祖，囊中药物备君臣。\n丹砂夜伏芙蓉鼎，红杏春铺锦绣茵。\n试问白头无恙客，几多先世受恩人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40545,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送萧都宪启出镇山西","author":"倪谦","text":"绯袍金带拜恩光，玉节青骢入晋阳。\n疆域广轮连朔代，土风勤俭自虞唐。\n三秋碧汉西飞鹗，五夜威弧北射狼。\n边务方殷君暂去，归朝还拟振台纲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40546,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宴仁和聂广文东轩次刘邦彦韵","author":"倪谦","text":"东轩曲宴荐南嘉，最喜斯文会一家。\n青佩执经时问字，苍头隔竹午敲茶。\n床边酒熟开银瓮，窗下香清绕碧纱。\n醉后高歌双耳热，月钩从上紫薇花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40547,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游宝石峰次邦彦韵","author":"倪谦","text":"积雨初收日已高，湖光潋滟欲平桥。\n幽禽绕树番歌舌，细柳沿堤学舞腰。\n山水尽为金相窟，衣冠曾是紫宸朝。\n登临不用怀前古，尽放春醪入翠瓢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40548,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过严先生钓台","author":"倪谦","text":"深隐层台把钓钩，独将名节傲王侯。\n故人大度符高祖，夫子清风迈许由。\n已有衣冠盈凤阙，何须轩冕换羊裘。\n客星自落桐江上，千古犹能姓此州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40549,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水竹幽居为唐克敬赋","author":"倪谦","text":"移家久傍贺兰山，卜得幽居水竹间。\n冰镜光涵丹凤尾，翠云阴护白沙湾。\n雨涛夜鼓溪头涨，风箨晴抽谷口斑。\n有待叩门参玉版，小舟乘月弄潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":40550,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]