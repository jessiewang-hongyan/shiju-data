[{"title":"弇园杂咏四十三首 其八 饱山亭","author":"王世贞","text":"客但憩此亭，饱看山色足。\n若更入山深，宁知真面目。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其九 萃胜桥","author":"王世贞","text":"镜收远近观，毂绾往来路。\n至此即命觞，徘徊不忍度。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其十 簪云峰","author":"王世贞","text":"峰势若簪云，云根何太低。\n记得文登路，如绵衬马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其十一 突星濑","author":"王世贞","text":"五夜钟欲残，群星堕如雨。\n化为濑中石，欲飞不得去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其十二 小龙湫","author":"王世贞","text":"澄澄一泓水，那得吐光怪。\n山人七寸钵，尚有神龙在。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其十三 千年菌","author":"王世贞","text":"商山千年菌，一朝化为石。\n莫令鲍靓过，截作中时食。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其十四 白云障","author":"王世贞","text":"茅山陶隐居，自爱山云白。\n莫言难赠君，于今已成石。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其十五 黑云堆","author":"王世贞","text":"轮囷一片峰，宛如黑云吐。\n犹疑肤寸合，解作人间雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其十六 潜虬洞","author":"王世贞","text":"阴森石欲搏，曲跃津难渡。\n欲留不敢留，一去一回顾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其十七 青虹梁","author":"王世贞","text":"青虹下饮水，徘徊不能去。\n为我作石梁，遂得天台路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其十八 雌霓梁","author":"王世贞","text":"青虬在其上，雌霓甘为下。\n游者虽异途，阴晴不相舍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其十九 契此岩","author":"王世贞","text":"契此不弥勒，此像非契此。\n许大须弥山，收置一囊里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其二十 忘鱼矶","author":"王世贞","text":"我非汉庄光，钓矶满苍藓。\n虽有种鱼经，生来不开卷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其二十一 环玉亭","author":"王世贞","text":"春寒不成出，小出坐此屋。\n不知天工巧，树树雕成玉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其二十二 悯湘石","author":"王世贞","text":"宛宛欲沈波，憔悴抑其首。\n可怜望夫心，却作秋胡妇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其二十三 率然洞","author":"王世贞","text":"一夜中弇雷，率然穿作峡。\n蜿蜒诘曲中，时时露鳞甲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其二十四 天骨峰","author":"王世贞","text":"天公幻天骨，自然吐奇秀。\n宁如宋人叶，三年雕始就。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其二十五 小云门","author":"王世贞","text":"窈窕如不穷，芊眠足余趣。\n岂必有云归，自是归云处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其二十六 漱珠涧","author":"王世贞","text":"止水清可掬，居然媚其涧。\n吾有万斛珠，漱令夜光现。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其二十七 借芬阁","author":"王世贞","text":"隔崦千叶桃，清芬袭人鼻。\n更许墙头醪，不妨便成醉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其二十八 含雪阁","author":"王世贞","text":"直对缥缈楼，迭玉映晶洁。\n诵得少陵诗，窗含西岭雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其二十九 梵音阁","author":"王世贞","text":"夜半海潮音，松风窍天籁。\n我亦从中证，非惟观自在。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其三十 荣芝所","author":"王世贞","text":"三弇此三夏，三产三秀草。\n吾亦有三儿，宁馨似芝好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其三十一 徙倚亭","author":"王世贞","text":"壶公楼不开，于此待呼钥。\n长房少须臾，终享尘外乐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其三十二 分胜亭","author":"王世贞","text":"亭前有两径，俱取弇山右。\n处处饶胜奇，谁能双举肘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其三十三 百衲峰","author":"王世贞","text":"大似百衲僧，却顾僧雏语。\n其语了不闻，低头似相许。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其三十四 云根嶂","author":"王世贞","text":"偶然白云至，辉辉两相向。\n下有暗泉流，呼作云根嶂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其三十五 玢碧梁","author":"王世贞","text":"西弇石渐顽，此梁独玢碧。\n近取修竹荫，远借高天色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其三十六 却女津","author":"王世贞","text":"少女怯危津，徘徊不敢度。\n急唤阿?来，还寻旧时路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其三十七 惜别门","author":"王世贞","text":"醉客插花归，一步一惜别。\n不尽眼底奇，归从细君说。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其三十八 碧莲池","author":"王世贞","text":"世尊莲正青，远公莲自白。\n尔向青白间，别作天水碧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其三十九 文漪堂","author":"王世贞","text":"清漪感苹末，悠然自成文。\n得月稍绮丽，含霞太缤纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其四十 步屧廊","author":"王世贞","text":"百步响屧廊，步步有山看。\n临当出门去，犹复凭阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其四十一 来玉阁","author":"王世贞","text":"浙浙万瓦敲，沉沉一壶醉。\n窗里玉山颓，窗外玉山至。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其四十二 襺云窝","author":"王世贞","text":"甲帐挂流苏，人道春云热。\n梅花一纸寒，襺云云不泄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏四十三首 其四十三 墨池","author":"王世贞","text":"书不如右军，何烦使池墨。\n唯用将洗心，能令净业白。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题杏花书屋图","author":"王世贞","text":"十里杏花幄，书声琅然出。\n要踏曲江春，还从此中觅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题山水","author":"王世贞","text":"隔崦青峭峰，扑作眉间色。\n其奈春水深，褰裳不可得。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠谭道人 其一","author":"王世贞","text":"为余三月住，寄食赞公房。\n却问香积饭，何如太乙粮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠谭道人 其二","author":"王世贞","text":"昂藏九秋鹤，悦怿三春柳。\n宛似谭景升，化书可成否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠谭道人 其三","author":"王世贞","text":"闻汝返金山，何不焦山住。\n焦光虽苦生，郭第能供具。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠谭道人 其四","author":"王世贞","text":"汝携王孙诗，为标国香集。\n将过沅澧间，秋兰见应泣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题奕棋图","author":"王世贞","text":"松下两仙人，棋声日敲击。\n不愁清景移，愁它杀机发。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"文殊洞","author":"王世贞","text":"老大妙德躯，于焉暂栖止。\n犹胜运乖时，棹入粥锅底。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辟支塔","author":"王世贞","text":"自参薄伽梵，悔作辟支佛。\n舍利何足言，劫前一枯骨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又题清凉台","author":"王世贞","text":"别借金刚窟，微分室利场。\n羞他石卫尉，火宅号清凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公瑕先生在白下两月许别去得四绝句送之皆实际语也 其一","author":"王世贞","text":"长干一万家，半是君题壁。\n欲赠草书歌，惭余非李白。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公瑕先生在白下两月许别去得四绝句送之皆实际语也 其二","author":"王世贞","text":"同是金陵客，君归我不归。\n江头一延颈，悔杀是朝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公瑕先生在白下两月许别去得四绝句送之皆实际语也 其三","author":"王世贞","text":"尔卖梅花庄，我冷芙蓉墅。\n乐处不得归，归即无乐处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":42635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公瑕先生在白下两月许别去得四绝句送之皆实际语也 其四","author":"王世贞","text":"念汝西河戚，身罹隔谷悲。\n人生缺陷地，同是白头时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d1