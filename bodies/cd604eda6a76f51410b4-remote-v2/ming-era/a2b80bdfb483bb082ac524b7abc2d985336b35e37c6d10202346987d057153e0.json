[{"title":"楼陴两洞轩中坐对兰花","author":"湛若水","text":"三畹碧兰两洞花，氤氲六合一同家。\n馨香不受皮肤隔，呼吸朝朝共日华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大科峰登高诗","author":"湛若水","text":"九日携壶上大科，天歌一曲宣天和。\n浴沂六七惟童冠，孰与诸贤父老多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙午九月十二日新定仰辰台同周自正郑孔新谢振卿扳跻登望浩歌而归","author":"湛若水","text":"仰辰台上仰辰游，一曲歌声彻九州。\n感得圣恩深似海，外臣早许作巢由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆昔与周自正","author":"湛若水","text":"忆昔同游衡岳时，五峰形影日相依。\n经画晨昏供粥罢，紫云侍坐送斜晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云谷书院夹以左右二瀑布天下之奇也周生自正请予双瀑布诗","author":"湛若水","text":"双眺银河落九天，人言瀑布挂云边。\n合流喷浪风雷震，惊起蛟龙不得眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何于逵北上会试","author":"湛若水","text":"番山才子富文华，岭海于今第一家。\n春到不妨学东野，一日看尽长安花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58065,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云谷左天泉作","author":"湛若水","text":"天作地藏人肇文，天泉左右交流新。\n莫言洙泗人天远，同地同天同此人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云谷九曲溪作","author":"湛若水","text":"九曲涓涓始滥觞，潆流似我九回肠。\n江湖一念能忘得，曲曲还倾九百缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冠儿湘之口占奉谢冠宾何元科旦成盛事云","author":"湛若水","text":"凝道堂中冠礼成，三加辞确起人惊。\n痴儿果有成人道，万一能忘此日情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁未元日吟","author":"湛若水","text":"八十二回寒暑更，渭川同钓不同情。\n老夫独捲丝纶坐，坐到东溟月又生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东莞孙明府惠茶园香","author":"湛若水","text":"茶园万瓣令君封，爇向西樵第一峰。\n自是长官风韵远，香飘四百里长虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新春放歌 其一","author":"湛若水","text":"已住烟霞心未死，更开云谷了吾生。\n磬声击罢烟萝合，钓线收来海月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新春放歌 其二","author":"湛若水","text":"春动樵湖湖水生，逸樵湖光□如城。\n衰翁独坐樵□□，□十六峰齐□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送罗浮用濂溪先生韵与同游诸贤 其一","author":"湛若水","text":"我非随柳傍花人，山外飞云云外身。\n四百风光无觅处，归来灵府有天真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送罗浮用濂溪先生韵与同游诸贤 其二","author":"湛若水","text":"□有名山几万年，几人登陟几人仙。\n莫言一览诸天尽，到了诸天更有天。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁未七月二日云路七父老携酒过予水帘洞共语甚适","author":"湛若水","text":"岩扉半掩水帘遮，宴坐无言到日斜。\n七老携壶出云路，来看岩畔落天花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小朱明洞天枕上","author":"湛若水","text":"朱明小洞抱琴眠，只手还摩尺五天。\n一曲泬㵳人不和，自歌自拍洪崖肩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经始壁立洞用前韵 其一","author":"湛若水","text":"天与衰翁供打眠，又开面壁无穷天。\n也须明月清风入，分付吾墙只及肩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经始壁立洞用前韵 其二","author":"湛若水","text":"水际崖头取次眠，崖头天也水中天。\n始知身在乾坤里，漫说乾坤担在肩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁未八月十三夜枕上预留洪觉山方明谷","author":"湛若水","text":"问柳随花路四千，吟风弄月有双贤。\n西樵住过罗浮臈，待得春风送子旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳携酒同洪侍御觉山诸生方持素何宗远钟叔辉郑孔新周明几谢振卿周昌逵方毅中登高大科峰见日台翻王摩诘韵以广方洪归念","author":"湛若水","text":"大节登高大科顶，大家兄弟大家亲。\n三杯宙宇醄然后，不记异乡何处人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠李中冈都藩起复之京","author":"湛若水","text":"九十六峰樵月光，娟娟照见紫薇郎。\n将心托月随君去，去照中天北斗傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑞鹅诗 其一","author":"湛若水","text":"天飞地畜类同殊，感应神通岂谓无。\n妙阁鹅飞鸣奋翅，穿云度玉过银湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑞鹅诗 其二","author":"湛若水","text":"阁依云谷古今殊，瑞应鹅飞往事无。\n只欠有无争太极，他年应作小鹅湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新卜广朗坪","author":"湛若水","text":"云谷烟霞春尚浅，北寻广朗似清都。\n萦纡石径人踪绝，断岸无桥俗亦无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题大墩南卢祠堂","author":"湛若水","text":"采菱湾口放歌长，每过卢家世德堂。\n积善百年馀庆在，应知德厚有流光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北京吕舍人万乐子世宽明坤病目四十不肯娶遨游四方来访西樵将之藩府勉留住喷玉岩 其一","author":"湛若水","text":"昔贤恨不盲废早，不识一字也升天。\n牧犊不妻还姓吕，前身或者是回仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北京吕舍人万乐子世宽明坤病目四十不肯娶遨游四方来访西樵将之藩府勉留住喷玉岩 其二","author":"湛若水","text":"岩中自有一乾坤，云作衣衾山作垣。\n况有天花来作供，长裾何必曳王门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄何艮所明府","author":"湛若水","text":"颇忆风流何水部，钓台把酒听沧浪。\n不知风韵今何似，台自山高水自长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汤九山还古冈 其一","author":"湛若水","text":"樵山高高霄汉间，常恐相携著步难。\n收拾临归春景□，□朝何处忆商颜。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汤九山还古冈 其二","author":"湛若水","text":"□家鸡犬白云间，希世无论古□难。\n一去独遗篁桂□，相看犹自见清颜。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"捉笔谢李鳌峰别驾送迟荔甚佳","author":"湛若水","text":"色香味总闻三绝，荔到名园品绝奇。\n地远独便人不见，中州何物拟伦之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游罗浮怀诸贤与钟叔辉宝潭 其一","author":"湛若水","text":"福山觉山来信稀，鹤园鹤岑血沾衣。\n宝潭宝潭无愆期，予登飞云从予谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游罗浮怀诸贤与钟叔辉宝潭 其二","author":"湛若水","text":"朝发铁江暮铁桥，铁桥铁江同一流。\n蓬莱一股谁云遥，群仙排云出相邀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钱绪山秋官同诸友骆君举邓天德郭以平黄如礼黄如道钟体嘉来访甘泉三日告归予方登飞云遂与分袂诗以送之","author":"湛若水","text":"四千里路携诸友，三日甘泉共一门。\n岁晚独怜归草草，飞云月下未同论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和蒋道林登飞云至玉女峰而还解之 其一","author":"湛若水","text":"留与飞云一半花，来春还拟返云车。\n挥鞭直上通云界，不踏峰头未到家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和蒋道林登飞云至玉女峰而还解之 其二","author":"湛若水","text":"生天生地同生云，云与天地不必分。\n此云平生吾爱之，一半飞云难让僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鳌峰李别驾暮归鹿步寄之","author":"湛若水","text":"大梅小梅放船归，东洲西洲烟霞迷。\n鳌峰丈人乘鳌去，甘泉野老望歔欷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蒋道林诸君登钓台依石翁师韵二首 其一","author":"湛若水","text":"自拜江门风月句，一回一读一沈吟。\n诸君弄月吟风去，风月满身江水深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蒋道林诸君登钓台依石翁师韵二首 其二","author":"湛若水","text":"腊去春来年复年，江春钓石也成穿。\n急流勇退谁堪麈，似我前身亦姓钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登留后閤和道林韵","author":"湛若水","text":"超身直上空中閤，乌用支离百八般。\n多少世人平地语，相轮到了岂空言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即席和九山翁天阶之作","author":"湛若水","text":"九德山中有九峰，九峰元是九山峰。\n汤翁肯步陈翁武，便是乾坤第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韶州清溪潮水山有泉甚灵黄生经府绣送予为