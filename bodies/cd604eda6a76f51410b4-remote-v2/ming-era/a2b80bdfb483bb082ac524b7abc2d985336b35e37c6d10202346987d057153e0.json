119,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代简寄池州李古源上舍","author":"湛若水","text":"古源眠食今何似，我屋中华近到无。\n惊报双华消□恶，世间滟滪在荣途。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58120,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代简谢南都翰学吕巾石祝文□□何□阳曹赵眉溪京兆庞弼唐暨新泉诸□□四锦轴","author":"湛若水","text":"祝文经纬吕公情，同志三年积虑成。\n谢得馀年□□过，因超六合到生生。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58121,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代简答葛子东上舍因道及唐内翰同致意二首 其一","author":"湛若水","text":"笔端有眼观贤妇，葛子因知是义夫。\n合是造端由大道，鸢鱼天地贯通于。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58122,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代简答葛子东上舍因道及唐内翰同致意二首 其二","author":"湛若水","text":"凭君多谢唐荆川，若泛荆川慎上船。\n弄月吟风一条路，濂溪伊洛是真传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58123,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代简答沈艾陵监丞二首 其一","author":"湛若水","text":"禾川何似成均逸，又似陵湖枕上无。\n骤雨惊回几场梦，罗浮无梦到皇都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代简答沈艾陵监丞二首 其二","author":"湛若水","text":"罗浮无梦到皇都，纵到皇都梦亦孤。\n只有一端难忘处，巢由深荷有唐虞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代简寄扬州杨孝子锜","author":"湛若水","text":"维扬过客已知名，孝子旧为族党称。\n便合首科逑闵冉，闭门闹市坐懵腾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题何宗远铁崖别号","author":"湛若水","text":"宗远肝肠浑是铁，惟应同住铁江涯。\n世人反眼不相识，廿载樵西共煮霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送宪副钱平厓朝贺之京诗","author":"湛若水","text":"平厓不是钱王裔，功载征黎岂独多。\n去去五云瞻帝座，定应前席问黎么。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别驾曾梅谷以足疾告归休诗以贤之","author":"湛若水","text":"别驾方当展骥足，飘然托足疾归休。\n大儒晦翁足亦跛，古今不跛谁同流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为何元科题其世父小山别号","author":"湛若水","text":"小山光景小山知，九仞元从一篑为。\n明月照山无大小，小山榻上看盈亏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"追寿莲峰刘郎六十一","author":"湛若水","text":"莲郎六十重花甲，泉老期颐尚岁寒。\n共引东溟为寿盏，莲华峰顶寿筵坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为何宗远题龙泉精舍","author":"湛若水","text":"龙泉元切大科僯，同覆樵颠一片云。\n尺五天中连卧榻，龙泉科巅不须分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]