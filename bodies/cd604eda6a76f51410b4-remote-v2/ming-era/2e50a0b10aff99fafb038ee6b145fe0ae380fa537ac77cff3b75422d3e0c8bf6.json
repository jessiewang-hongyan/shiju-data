[{"title":"送林毅寄彭万里参政","author":"孙蕡","text":"闻君作宦山西去，为我持书问故人。\n青社部符藩屏重，黑头当轴宠光新。\n中原几载无狼虎，大野清时识凤麟。\n同侍禁闱今远别，鹧鸪啼杀上林春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙丑元夕送傅城进士还桂林","author":"孙蕡","text":"旧时相见即相欢，见说如今又作官。\n湖海别魂空窅窅，天涯愁思独漫漫。\n春风几日来江上，灯火逢君坐夜阑。\n忽报故园归思切，素琴惆怅不胜弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"到京","author":"孙蕡","text":"金阙瑶宫拥翠华，茫茫人海聚豪奢。\n明廷礼乐超三代，盛世车书混一家。\n龙虎山川昭胜概，衣冠文武际亨嘉。\n粤南草莽臣欣睹，瑞日祥云护彩霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钟山应制","author":"孙蕡","text":"苍翠巍峨插昊穹，紫金突起大江东。\n三山避迹投鲸海，五岳齐肩拥帝宫。\n珠树凤鸾鸣瑞日，宝圻龙虎壮威风。\n万年圣寿高堪并，常有神人祝华嵩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新春从幸天界寺次詹冢宰钟山应制韵","author":"孙蕡","text":"天界丛林开象魏，朱衣环佩俨群仙。\n瑞露迎銮飞扈跸，皇都佳气蔼新年。\n玉宸香满三千界，莲座光浮尺五天。\n敕使御前催应制，侍臣簪笔思如泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驾游钟山应制","author":"孙蕡","text":"玉宸警跸出蓬莱，近望名山翠色开。\n松柏屯云车骑过，峰峦簇锦节旄来。\n九成奏乐喧泉涧，百职联班蹴蹬苔。\n宴赏太平当赋咏，小臣侍从愧非才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驾幸天界寺和朱太史芾韵","author":"孙蕡","text":"宴语从容对上方，侍臣挥翰笔如扛。\n从行卫士随僧供，出定经声歇梵腔。\n鹫岭晓云扶辇毂，龙河春水漾旌幢。\n清平自觉文章盛，长忆天兵未渡江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陪翰林宋承旨游钟山","author":"孙蕡","text":"天上禅关敞薜萝，每缘休沐得经过。\n云笼梵宇青莲湿，地接皇居紫气多。\n甘露结花凝木末，醴泉如雨落岩阿。\n欲陪谢傅金屏约，未解朝簪奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朝奉天门","author":"孙蕡","text":"三陲寂静简书稀，不谓馀生睹盛时。\n月窟天根周正朔，琼琚玉佩汉官仪。\n蓬莱旧隐违仙赏，葵藿微衷结主知。\n尚想临轩膺顾问，徘徊当宁退朝迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贽左相宣国李公","author":"孙蕡","text":"吾皇神武定山河，上相奇勋盖世多。\n周室兴王尊吕望，汉朝开国任萧何。\n形图麟阁威当仰，铭勒燕然耿不磨。\n胙土分茅延世赏，振振麟趾沐恩波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"呈中书参政汪公","author":"孙蕡","text":"龙飞江左际风云，忠赤谋猷夙夜勤。\n枫陛论思严国体，薇垣计策净烟氛。\n褒贤奎画黄麻敕，补衮华虫色线文。\n承荐鲰生何以报，只将俚语颂元勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉左司郎中顾光远","author":"孙蕡","text":"九天拜命带天香，南粤旬宣礼义乡。\n青琐闼前恩渥重，紫薇垣里政声扬。\n田畴万顷蟠秋黍，海国群黎贡栈航。\n奕叶传家忠与孝，化为霖雨济遐方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诃林送赵生留南归","author":"孙蕡","text":"几年烟月共林坰，此日看花入帝城。\n老我未酬清世念，别君因起故园情。\n朝廷有道容樗散，献纳无才愧圣明。\n归去为烦先问信，沧江渔艇白鸥盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赵进士安中","author":"孙蕡","text":"词林每问归安使，闻说先生在德清。\n暇日画帘公吏散，春风华馆子衿明。\n三年不见新书札，百里空传旧政声。\n日暮碧云何处合，思君吟遍石头城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张典籍讷之官大同经历三首 其一","author":"孙蕡","text":"春风鸣玉下天阶，万里从戎亦快哉。\n远仗皇威清朔漠，更依云气望蓬莱。\n参军孙楚登瀛客，草檄陈琳补衮才。\n边事太平烟火息，柳营羌角为谁哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张典籍讷之官大同经历三首 其二","author":"孙蕡","text":"边陲见说青烽灭，赞画遥知白羽闲。\n夜月葡萄毡帐底，春风筚篥柳营间。\n贾生长是怀金阙，定远安能老玉关。\n沙漠年年飞羽捷，想随骠骑凯歌还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张典籍讷之官大同经历三首 其三","author":"孙蕡","text":"文章堂上论交日，对榻哦诗白昼长。\n晴日画帘观水影，暖风罗袂散天香。\n寻常应制才堪并，四十从戎鬓未苍。\n春半黄河冰片解，旌麾几日望敦煌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉致仕詹天官","author":"孙蕡","text":"京华帝城春事幽，相君家住城南陬。\n垂杨缺处水当户，燕子飞时花满楼。\n宾客金鱼悬玉佩，儿孙锦带挂吴钩。\n乡园父老傥相问，佐国元勋今白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉太史令护军公","author":"孙蕡","text":"虞渊捧日帝羽仪，文事武备天人师。\n笔端词翰河汉决，胸次韬略风云随。\n邦基肇造古伊吕，谟猷笃棐今皋夔。\n画图麒麟盟带砺，仙游更与赤松期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"投赠山东何方伯三首 其一","author":"孙蕡","text":"碧落初看王气清，丹山喜见凤凰鸣。\n分符出镇留遗爱，赐第荣归荷圣情。\n李绩忠贞明日月，窦融勋烈著丹青。\n白头风度浑如昨，尚可登庸佐太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"投赠山东何方伯三首 其二","author":"孙蕡","text":"皇风来播南陲日，开府兼持将相权。\n千里分封鸾诰下，三珠耀日虎符悬。\n长怜野日违清愿，且喜恩光照暮年。\n勋业已成头半白，蒋陵佳气丽中天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"投赠山东何方伯三首 其三","author":"孙蕡","text":"君侯昔在东藩时，英风远略人共知。\n帐前铁骑金锁甲，腰下宝玦珊瑚枝。\n将相兼权未足贵，身名两存今始奇。\n便可临风搔白首，对酒且赋归来词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张翰林孟廉赴山西行军三首 其一","author":"孙蕡","text":"日陪珠履下瀛洲，奏对銮坡最上头。\n校艺曾闻三献赋，从军喜遇一封侯。\n辕门羽檄清秋静，奎府文光午夜浮。\n顾问旧臣多特召，泥金会见出龙楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张翰林孟廉赴山西行军三首 其二","author":"孙蕡","text":"汉将防边意气豪，参军行处拥旌旄。\n云连白雪飞花片，风卷黄沙似海涛。\n塞曲但闻吹筚篥，人家多自种葡萄。\n升平见说从戎乐，欲解儒衣问战袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张翰林孟廉赴山西行军三首 其三","author":"孙蕡","text":"清时况是金闺老，跃马关河鬓未华。\n翠柳东门开祖帐，黄河北岸拥高牙。\n安边羽檄传司马，落帽西风忆孟嘉。\n万里封侯吾辈事，迟君谈笑靖胡沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉酬刘友贤黎仲辉二御史见过","author":"孙蕡","text":"故人骢马晓相过，错莫邻人避玉珂。\n朝下楚城高盖合，春深门巷落花多。\n飞腾每羡青云早，衰懒无如白发何。\n相见惟期树勋业，蒋陵佳气正嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄彭万里给事时参山西政","author":"孙蕡","text":"与君文彩旧同朝，翠管文章上九霄。\n辇路香风随卤簿，天坛花雨听箫韶。\n鹓鸾一别京关远，云月三年楚水遥。\n欲寄清诗慰寥阒，汴河东去近无潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送沈主事起复徐西安知县","author":"孙蕡","text":"年少天官旧考功，马蹄催入未央宫。\n声名已在云霄上，乡国犹悬涕泪中。\n辇路繁花明旭日，佳城乔木语天风。\n传家正欲存忠孝，千古君臣此道同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄郑御史毅","author":"孙蕡","text":"不见能诗老郑虔，七闽山色远依然。\n桃花流水瀛洲客，兰叶春风御史船。\n别后丰姿浑似玉，醉来毛骨欲成仙。\n勋庸封拜多殊泽，归日应陪上相筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张御史常泰","author":"孙蕡","text":"故人清楚旧能诗，去岁东南折桂枝。\n久拟手容清百辟，故将文采应昌期。\n诗题翠柏趋期早，颂奏嘉禾出殿迟。\n寥落与君长见面，无烦千里寄相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题黎仲辉御史先君墓志","author":"孙蕡","text":"广文振佩趋朝日，当宁临轩策士时。\n黄阁侍臣催奏牍，玉堂学士诵清诗。\n千花晓日文园合，一铎西风客棹迟。\n遗老寂寥芳岁换，空山松柏雨丝丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀刘宪副子高","author":"孙蕡","text":"泥酒兵曹老职方，蒋陵花柳纵清狂。\n雨晴振佩还西掖，日晏鸣镳出未央。\n朝散锦袍香拂拂，吟成诗句玉琅琅。\n燕台北去西风冷，谁伴吹箫引凤凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄罗友章先生","author":"孙蕡","text":"三年薄宦淹吴楚，长忆先生在海涯。\n不著朱衣垂玉佩，还将白发映乌纱。\n遥天剑气藏珠斗，百越文光绚彩霞。\n云路相期苦相失，春莺啼彻上林花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"圜丘大祀","author":"孙蕡","text":"松柏萧森倚半空，天坛高峙帝城东。\n宸旒肃穆千官合，卤簿辉煌万国同。\n上界清都移碧落，泰阶黄道隐晴虹。\n相如莫献青鸾赋，不是祈灵太乙宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄黄员外文博时出佐守徐州","author":"孙蕡","text":"使君文学冠贤科，入拜工曹意气多。\n五色云中披奏牍，九重天上振鸣珂。\n趋朝共沐恩波阔，出守谁怜岁月过。\n会有蒲轮徵故旧，未应黄发老蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀王彦举三首 其一","author":"孙蕡","text":"怀昔南园王给事，同开诗社向沧洲。\n凌风欲赴三山约，听雨还为十日留。\n蚁绿新醅浮翠盎，茧黄旧纸试银钩。\n别来风物应无恙，幸喜微官未白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀王彦举三首 其二","author":"孙蕡","text":"早岁南园开洛社，哦诗纵酒野云边。\n元龙豪气三千丈，翰苑文章二十年。\n春暖翠环歌白雪，夜阑银烛飏青烟。\n幽期寂寞沧洲里，何日天风泛画船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀王彦举三首 其三","author":"孙蕡","text":"闻道南园华物冷，小烟寒雨闭柴门。\n频年久负沧洲趣，此日谁过杜曲村。\n肯有文章千载重，不知朋旧几人存。\n芳辰乐事成陈迹，江水江花酒一樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀黄徵士观复","author":"孙蕡","text":"积翠西南天柱峰，中天仿佛玉芙蓉。\n时清有客歌鸣凤，地僻无人见卧龙。\n白璧明珠淹下国，丹崖绿壑寄高踪。\n匡时正有丘园念，几欲驰书道莫从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘芳之入蜀","author":"孙蕡","text":"峨眉西上穆陵关，犹似帘栊响佩环。\n华月高秋沉楚馆，彩云清晓散巫山。\n鸾衿寄恨今宵永，锦字传情几日还。\n惆怅风前花落尽，相思惟有泪潸潸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饯宋承旨潜溪先生致仕归金华七首 其一","author":"孙蕡","text":"鳌峰朝日鹊声稀，内使传宣下紫微。\n予告不须留秘阁，许归仍及赐春衣。\n恩浓玉检天书湿，人去金茎瑞气稀。\n况是阳和二三月，都门柳色正依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饯宋承旨潜溪先生致仕归金华七首 其二","author":"孙蕡","text":"先生家住金华里，门对双溪绿水流。\n烟树几年封故宅，云涛此日送归舟。\n怀京想梦三呼祝，载酒还登八咏楼。\n今夜寂寥清禁直，紫薇花上月如钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饯宋承旨潜溪先生致仕归金华七首 其三","author":"孙蕡","text":"承恩初入词林日，亦得叨陪侍从班。\n云影九重开凤阁，天光咫尺近龙颜。\n彤闱侍读青春暖，彩笔题诗白日闲。\n此去定酬优老愿，软轮游遍浙东山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饯宋承旨潜溪先生致仕归金华七首 其四","author":"孙蕡","text":"保傅储皇二十春，白头归去岁华新。\n优贤宠渥非缘老，盖世文章不是贫。\n锦诰焕颁云五色，青宫喜见日重轮。\n悬知恋阙丹心在，长倚遥天望紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饯宋承旨潜溪先生致仕归金华七首 其五","author":"孙蕡","text":"一自先生离禁闼，玉堂清致更无人。\n金莲飏彩初寒夕，燕寝凝香散暮春。\n著作有官惟故事，论思此道竟谁陈。\n青云志气惭悲梗，不觉临岐泪满巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饯宋承旨潜溪先生致仕归金华七首 其六","author":"孙蕡","text":"妙誉芳声照简编，丹青不待绘凌烟。\n清朝礼乐词林出，史馆文章异域传。\n贝锦春明天竺国，虹光夜贯日南船。\n匡时已是吾儒事，赢得高参面壁禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饯宋承旨潜溪先生致仕归金华七首 其七","author":"孙蕡","text":"龙门佳致接仙山，旧筑茅堂紫翠间。\n方外羽人霞作袂，瀛洲归客玉为颜。\n常时望气怀京国，午夜朝真响佩环。\n愿祝圣朝千万寿，还随笙鹤到天关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诸王之国观礼有作","author":"孙蕡","text":"帝子承恩恋九重，应门下诏趣分封。\n珠旒列拜宸居肃，玉佩随行礼数同。\n祖训丹书皇有极，天人宝历世无穷。\n君亲在望频回首，旌旆翩翻鸟隼风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀刘文学中美","author":"孙蕡","text":"村居最忆龙津好，五月南风熟荔枝。\n绿树千章云漠漠，明珠万解火离离。\n风亭月榭孤人兴，楚水淮山恼梦思。\n遥想故人招旧隐，几从猿鹤问归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠达禄修撰道夫","author":"孙蕡","text":"蓬鬓飘萧洛上翁，金门日日候晨钟。\n论思入奏天光近，对御题诗烛影红。\n衣故尚馀当日绣，马寒犹是旧时骢。\n词华已作青云客，圣代于今雨露浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西樵山","author":"孙蕡","text":"西樵山势捲飞龙，万里扶桑海色通。\n日丽锦岩开罨昼，雨馀银渚漾芙蓉。\n紫河车荫仙人掌，白鹤花明玉女峰。\n上相朝元鸣玉佩，三城佳气郁葱茏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀修撰朱备万","author":"孙蕡","text":"先生旧是瀛洲客，文藻风流第一人。\n华月玉堂仙署冷，西风辽海鬓毛新。\n文园最忆相如赋，茅屋谁怜杜老贫。\n圣世云衢需俊彦，肯令漂泊暮江滨。\n济济群贤圣度宽，怜君何事戴南冠。\n清时文物为儒贵，晚岁关山行路难。\n丹凤五门春日丽，玄菟万里海风寒。\n蒲车早晚徵耆旧，莫作长沙谪宦看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬至","author":"孙蕡","text":"冬至至日日初长，久客客怀怀故乡。\n梅蕊惟愁雪烂熳，柳条又是春相将。\n懒朝违世真自笑，忆远寄书殊未央。\n海门关外暮云合，应有南还征雁翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己未除夕","author":"孙蕡","text":"四十今已过二年，明日又复岁华迁。\n头颅种种见白发，生计落落仍青毡。\n梅花乱开客愁里，云物长迷乡国边。\n且可吟诗酌春酒，烂熳取醉东风前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄梁孟素","author":"孙蕡","text":"昔侍鳌峰先大夫，归山仍得佩金符。\n楼船载酒春将半，花寺寻僧日向晡。\n京国风云催步武，浙江烟雨送头颅。\n音容久旷交情在，岁晚临风忆凤雏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠端孝思文学","author":"孙蕡","text":"庆门昆季总能文，京国长随老使君。\n休沐东山人似玉，退朝南陌骑如云。\n金龟换酒犹能忆，玉树临风夐不群。\n莫向炎门悲往事，词华已足继清芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和翰林典籍牛士良使安南之作","author":"孙蕡","text":"五两招摇百尺杠，官舟十月下藤江。\n波心犀气寒通剑，石角潮声夜扑窗。\n酒荐吴盐浮腊味，歌传楚艳入巴腔。\n扬舲我亦蓬莱客，应趁春风画桨双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宋伯祯处士东园","author":"孙蕡","text":"买得长镵斸翠苔，青茄白苋绕篱栽。\n园翁作伴还成趣，野老赓诗只漫裁。\n蛱蝶蜻蜓随上下，葛巾藜杖久徘徊。\n临流学试羲之帖，会有函诗马上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤凰台","author":"孙蕡","text":"绮翮千年去已遥，古台犹见碧岧峣。\n枫林晓雾迷三楚，柳陌春风暗六朝。\n狂客昔时挥彩笔，飞仙何处撚琼箫。\n惟馀一道巴江水，流向天门作海潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再游钟山","author":"孙蕡","text":"空青楼阁□冥间，云是东南第一山。\n武帝鸾旗烟草碧，志公龙锡雨花闲。\n江光远荡鼋鼍窟，云气常笼虎豹关。\n欲驾天风凌绝顶，上方琪树夕阳还。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄王主事希文之官漳州","author":"孙蕡","text":"湖海交游似晓星，南宫长史独多情。\n清时吏散诗同赋，浊酒朝回日共倾。\n金水桥边看浴马，紫薇花上听流莺。\n岁华摇落人千里，何处漳州海上城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠性空上人","author":"孙蕡","text":"一见清容类远公，六传清派出南宗。\n已离世相诸方外，犹挂诗名万袖中。\n龙钵夜珠留海月，虎台秋木啸山风。\n天游不是长枯寂，舍利神光似火红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]