[{"title":"杜日章将军榆溪钓隐图","author":"董其昌","text":"濠梁之乐子非我，欸乃一曲秦无人。\n手铸黄金为少伯，头簪青笠比玄真。\n胡儿饮马留泉脉，海客盟鸥问水滨。\n烟艇莫言空载月，半营鱼阵半垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题璇源张郡侯却金舆颂册","author":"董其昌","text":"此判南山不可移，颂声宁独美双岐。\n即看华表含愁意，正是秦宫照胆时。\n天子再传关右事，史家添入岘亭碑。\n却金应拜黄金赐，名姓书屏黼扆知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题刘金吾牛山读书图二首 其一","author":"董其昌","text":"青藜山馆啖澄江，左手离骚右玉釭。\n身作蠹鱼游册府，閒看带草长芸窗。\n征南注左甘称癖，圯上传书气未降。\n壮尔百城真坐拥，邺侯如鄫不成邦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题刘金吾牛山读书图二首 其二","author":"董其昌","text":"千峰选胜著西清，讵许顽仙厕会盟。\n白芷青兰时照眼，乌丝翠袖不胜情。\n詶恩故有双龙在，徵事堪令半豹惊。\n见说边烽劳仄席，肯容定远又书生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题平湖弄珠楼呈萧象林使君二首 其一 弄珠汉水遗事使君汉阳人而平湖亦有汉瑭又称鹦鹉湖于弄珠差合","author":"董其昌","text":"閒将乡思倚层霄，吴楚乾坤共泬漻。\n鹦鹉洲前催作赋，凤凰台上忆吹箫。\n山连秦望三神近，湖似浔阳九派消。\n一自明珠还海曲，采风应到弄珠谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题平湖弄珠楼呈萧象林使君二首 其二","author":"董其昌","text":"茂宰能将吏隐兼，楼开山岳散江潭。\n芝兰一一分湘浦，杨柳依依似汉南。\n地有骊龙供照乘，人如黄鹤解停骖。\n欲知交甫遗珠事，历落星辰逗短檐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郭青螺六命册","author":"董其昌","text":"日月旂常姓字悬，铙歌凯曲舞衣前。\n师行长子标铜柱，帝念封君此渭川。\n摩顶麒麟堪入画，盟书带砺永相传。\n上公九命君家事，次第承恩巳六篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题秦中李筼谷黄门偃松图","author":"董其昌","text":"当年高隐傲千峰，搜得峨眉偃盖松。\n出蛰苍龙呈怪状，游空云鹤见遗踪。\n居然玉局铭三植，不向金泥羡五封。\n顾我亦衔风木恨，并刀一为剪吴淞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题孙明府梅花诗册","author":"董其昌","text":"双旌迢递出三巴，驿路寒梅千树花。\n怅别那堪标物序，宠行犹喜借年华。\n江南有信探应早，水部多才价欲誇。\n陇首残枝如可寄，莫令书问阻天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日泛泖四首 其一","author":"董其昌","text":"帆前送目四天无，长泖云涛接具区。\n不以盈虚随海月，直于伯仲□江湖。\n澄鲜空水通禅观，浩荡烟波混钓徒。\n莫道行吟惟泽畔，采华幽兴未能孤。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日泛泖四首 其二","author":"董其昌","text":"九点芙蓉堕淼茫，平川如掌揽秋光。\n人从隐后称湖长，水在封中表谷王。\n日落鱼龙骄夜壑，霜清钟磬度寒塘。\n浮生底阅风波险，欲问蒹葭此一方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日泛泖四首 其三","author":"董其昌","text":"白芷青兰夙有盟，浮天一叶带鸥轻。\n几经陵谷长为沼，似障波涛复化城。\n渔浦每看罾在屋，莼乡宁怅食无羹。\n只疑重向潇湘道，试听参差野赛声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日泛泖四首 其四","author":"董其昌","text":"遂作浮家海上翁，迢遥烟艇泬漻空。\n青螺拔地存尧市，白马凌波立梵宫。\n客有入吴观欲止，吾将泛斗路非穷。\n不须更喻迷津筏，自得遗珠象罔中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日泛泖因读先师莫中江之什忽又十五年感旧怀贤再赋呈唐明府君公 其一","author":"董其昌","text":"秋风牛渚不堪过，回首游踪感怆多。\n名手自传裙练在，壮心其柰佩刀何。\n广陵无复闻流水，华表空知怨逝波。\n稍解当年招隐意，湖天渺渺一渔蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日泛泖因读先师莫中江之什忽又十五年感旧怀贤再赋呈唐明府君公 其二","author":"董其昌","text":"楼船箫鼓重沾巾，莫以玄亭问水滨。\n白雪久沉空谷响，黄金难铸五湖人。\n搴芳楚泽情何重，洒墨萧斋迹未尘。\n是处凉秋摇落恨，不逢唐勒与谁陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天马山游眺","author":"董其昌","text":"天畔峰形望里微，到来烟霭破岩扉。\n半空疏梵虚无落，上界天花历乱飞。\n百里湖光开水镜，一山云气晃人□。\n何须回首听钟后，巳觉青莲社可依。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙王寺观荷","author":"董其昌","text":"沐日相将竹下群，芙蓉十里净京氛。\n故园风景能无忆，是处燕吴总不分。\n饮马倒窥临水树，惊凫忽断宿潭云。\n尘缨坐染青莲气，会遣东林社里闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆君策畸墅问水二首 其一","author":"董其昌","text":"南村欣赏数从君，积水窥天淼不分。\n岂向尧年歌石烂，将无楚泽混鱼群。\n怀人几失空梁月，泛宅遥连极浦云。\n顾我玉杯书未就，何当行药逗斜曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆君策畸墅问水二首 其二","author":"董其昌","text":"湿云终日拥巢居，似尔沉冥得晏如。\n隐向北山无怨鹤，乐期濠濮有鯈鱼。\n亦知仲蔚蓬心长，肯信王猷竹兴疏。\n总使田园生事拙，幽人只解爱吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"京口观水嬉呈姜养冲","author":"董其昌","text":"因看竞渡狎江湖，转觉中流贱一壶。\n骚客赋湘心尚苦，没人蹈水胆何粗。\n风传鼍鼓齐扬帜，势入骊渊欲探珠。\n见说筹笾劳仄席，渔矶可有梦来无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武夷陈司马云窝二首 其一","author":"董其昌","text":"舟随五曲棹歌行，百叠松篁绕画楹。\n直与列仙争选胜，不妨游子自寻盟。\n隔溪云色沉峰色，逢夜滩声映瀑声。\n莫是乘槎星汉上，试将名姓问君平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武夷陈司马云窝二首 其二","author":"董其昌","text":"司马何年赋遂初，幔亭深处结精庐。\n蔽亏日月开天小，出没烟岚入槛虚。\n峡口忽闻猿叫断，沙痕时印虎踪疏。\n跨君池上冲霄翮，搆取清微大洞书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邯郸夜宿","author":"董其昌","text":"榆关霜薄授衣初，莽莽平沙度软舆。\n赴阙几逢鸿渐侣，望乡犹阻雁来书。\n曲生风味邢醪近，羽客差池枕梦虚。\n漫咏陶诗当黄菊，倦游终自爱吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源狄将军席上观女乐","author":"董其昌","text":"急管繁弦写竹枝，听来不作异乡悲。\n六千君子旧名将，两队美人新教师。\n遂许羁心抛绿醑，可无佳句比红儿。\n若论湖海鸥盟在，再入花源未可知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李临淮太保惟寅席上","author":"董其昌","text":"凌烟世业带河盟，手握风云护汉京。\n几试韬钤无对垒，即论诗句亦长城。\n朋簪夜散莲花幕，刁斗秋闲细柳营。\n若向燕然磨片石，属铭宁复藉班生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冯元成第观牡丹","author":"董其昌","text":"名园占领艳阳多，未以沉冥废啸歌。\n坐竹兴仍修褉后，看花愁奈送春何。\n窗前散绮摇书带，台畔凝香乱钵罗。\n莫向花丛问姚魏，年来蝶梦不曾过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕集杯比部","author":"董其昌","text":"画省谁兼吏隐名，酒人只合向公荣。\n河明忽散朝峰爽，砧响遥翻夕籁清。\n千里莼羹回客梦，七襄诗句属长城。\n狂来星汉低相倚，肯信秋风独旅情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同姚纳言过张蓬玄中丞官署","author":"董其昌","text":"滹沱秋色飒邢关，宣武风流此共攀。\n客有清班同豹尾，时当高会比龙山。\n营开细柳闻笳发，觞引茱萸听漏殷。\n戏马正于戎马候，邀欢暂借枕戈闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柏乡道中寄张蓬玄中丞","author":"董其昌","text":"九流清鉴属方甄，成德军声紫电振。\n帝念股肱三辅重，师中耳目一时新。\n应多泛水依莲幕，无复驱车避柏人。\n为问累累金虎印，谁能先徙突前薪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶临潼王二首 其一","author":"董其昌","text":"玉井青莲秋正芬，函关紫气昼氤氲。\n史公同姓诸王表，天老真形五岳文。\n眉宇故应龙有种，烟霞只恋鹤为群。\n无能授简训枚马，远想雄风礼白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶临潼王二首 其二","author":"董其昌","text":"端居空谷感离群，万里论交见国君。\n等是策书分五社，谁能笔阵扫千军。\n怀人大小淮山桂，飞梦东南吴会云。\n莫以雄才求自试，词坛赤帜有閒勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶虞德园吏部","author":"董其昌","text":"七十二峰山下居，五千四百藏中书。\n文人自具生天慧，吏部今为选佛除。\n恍惚之间含有象，涅槃能度尽无馀。\n惭余学殖多荒落，祗作空玄老蠹鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虎丘和许周翰太守四首 其一","author":"董其昌","text":"青山亦似隐吴门，洞霭江烟欲互吞。\n虎气尚呵盟长墓，龙宫旧敞给孤园。\n涓涓石濑妨僧定，谡谡松涛洗市喧。\n敢向登临陪赋手，禅心或许證风幡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虎丘和许周翰太守四首 其二","author":"董其昌","text":"因寻白社款禅宫，野兴难随暝色穷。\n古径松篁幽碍月，上方楼阁迥含风。\n吴歈每发乌栖后，梵呗俄翻鹫岭东。\n莫向剑池嗟剑去，佩刀光气耿摩空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虎丘和许周翰太守四首 其三","author":"董其昌","text":"孤帆落处即登台，匹练光中首重回。\n旧苑灵峰摽海涌，东林精舍倚云开。\n剑痕转恨雄图尽，麈尾谁传祖印来。\n所以酣歌宜达曙，坐深五马莫相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虎丘和许周翰太守四首 其四","author":"董其昌","text":"生公台上两花新，时菊霜枫映画轮。\n终古金银沉夜壑，何年风雨啸延津。\n姓如玄度耽名理，宦似王弘爱酒人。\n若道虎溪同虎阜，应知顽石点头频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次詶姜仲文","author":"董其昌","text":"南徐曾接采真游，尊酒空江落木稠。\n共我五湖分半席，怀人一日抵三秋。\n龙门忽枉山藏副，鸿宝能开泽畔愁。\n见说人豪犹好在，未容馀子漫登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入楚詶诸王孙","author":"董其昌","text":"骚人于楚为同姓，向我唫吴遣四愁。\n龙节忆过云梦泽，鱼笺近附汉江流。\n恰分寒食新藜火，无恙春风旧选楼。\n今日词场看赤帜，谁非左袒为宗侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陆伯生三首 其一","author":"董其昌","text":"苔矶宛有直钩翁，梦到神清碧落宫。\n病解维摩非病处，才全庄叟不才中。\n秋高侯馆鸿遵渚，露下遥汀鹤泪空。\n四海交情君自见，五湖仍溯陆皮风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陆伯生三首 其二","author":"董其昌","text":"身惭鹤发一衰翁，岂逐峨眉入汉宫。\n管领山川青笠外，消磨贤圣绿尊中。\n濠梁不辨鱼知乐，谷口时闻响应空。\n好在咏怀才未尽，朗吟如在竹林风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陆伯生三首 其三","author":"董其昌","text":"翛然避世鹿皮翁，花竹春深一亩宫。\n笔力转添迟晚日，赋情多在别离中。\n名山大业看藏副，北海青尊肯放空。\n江左即今开旧社，可能乘兴与乘风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶胡小山鹾台苦雨二首 其一","author":"董其昌","text":"单车却厌雨师迎，御史能将铁笔耕。\n遂有文章驱鳄暴，未容鼓吹杂哇鸣。\n为忧藜藿无宁宇，若作盐梅可荐羹。\n自是补天还补漏，巢居何事旅魂惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶胡小山鹾台苦雨二首 其二","author":"董其昌","text":"川原弥望岸容移，警水愁霖若有期。\n自奏薰风回愠后，差疑繁露纵阳迟。\n商歌曰□何当烂，步祷朱轮不用脂。\n采得歌谣腾黼座，笔端如画是流离。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶刘燕及明二首 其一","author":"董其昌","text":"乍把琼枝恍旧游，平生左袒为刘侯。\n即看竹素千秋事，能废江湖万古流。\n鸥侣共依天上座，雁声孤□月中楼。\n新诗大有牢骚语，翻耐高歌散旅愁。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶刘燕及明二首 其二","author":"董其昌","text":"青编数卷敌华林，腹笥居然写赋心。\n自昔词坛憎百六，不妨天柱耸千寻。\n龙文忽照干将曲，鹤唳今听谷水阴。\n却笑安仁秋兴作，只伤留滞宦情深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵詶叶少师台山赠行四首 其一","author":"董其昌","text":"东朝联事步清尘，牢落灵光亦主臣。\n奉诏偶然因旧学，趋班直讶著陈人。\n纷纶津邸宾僚盛，詄荡天门羽翼新。\n纵是枯桐蒙赏激，詶知恐异爨馀薪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵詶叶少师台山赠行四首 其二","author":"董其昌","text":"素衣端合避京尘，留滞繇来说史臣。\n敢赋湘累愁帝子，但唫篱菊比皇人。\n钟山猿鹤寻盟晚，泽国莼鲈发兴新。\n为问陆沉成底事，征车生耳等劳薪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵詶叶少师台山赠行四首 其三","author":"董其昌","text":"沉沦不解叹风尘，攀鼎含情侍从臣。\n巳分浮家称钓客，那将慧业厕文人。\n玉杯繁露书多逸，石室阳秋例更新。\n六代江山饶吏隐，移文恐不到前薪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵詶叶少师台山赠行四首 其四","author":"董其昌","text":"驱车宛叶逐游尘，春出秋归似雁臣。\n闻道晚来差丧我，论才少且不如人。\n石渠书拟雠同异，金屋恩须问故新。\n入洛愧虚先达荐，初衣仍返会稽薪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叶君节茂才以诗赠行复次前韵詶之","author":"董其昌","text":"谢庭玉树迥埃尘，能向凉风问放臣。\n迹愧冥鸿宜路鬼，行歌骊御见词人。\n家声夙擅青箱旧，交态全轻白发新。\n闻说相门多有相，弓裘不尽火传薪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送叶君节归试并和原韵","author":"董其昌","text":"才子新诗锦不如，遄归欲试揣摩书。\n直看凤羽绳祖武，可但龙孙傍帝居。\n韦曲正繁庭际树，石家能下里门车。\n惭予汗漫延津客，剑气因君问斗墟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶胡开府","author":"董其昌","text":"独驱铁钺古交州，万里风烟控上游。\n湘色旧悬平子赋，山光时映越王楼。\n即今庙算勤方虎，尚有閒情问海鸥。\n盟府勋名腾简册，可容野史得相求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶范太蒙吏部","author":"董其昌","text":"几回优诏到周南，云壑难将选胜耽。\n吏部文章真不朽，龙图忧乐本同参。\n弹冠共是冥鸿侣，挥麈能忘白马谈。\n欲问海门新气象，骊珠径寸喜先探。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"调李京兆克庵备边疏","author":"董其昌","text":"清时共爱玉门閒，岁岁名王事款关。\n何限乘轩邀上赏，几谁越俎议行间。\n消磨细柳将军垒，无恙燕支妇女颜。\n壮尔筹边多胜算，先声今巳到天山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶李太史伯襄赠什","author":"董其昌","text":"三绝真惭妙与痴，坫坛潦倒亦偏师。\n朅来大隐从周史，得似中兴睹汉仪。\n独往骊渊探秘藏，行游兔苑骋妍词。\n岭梅不必秋能折，肯有邮筒及我私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶杨霁寰中丞","author":"董其昌","text":"玄阁宁论阻问奇，征南新勒万潭碑。\n冥心巳入风蝉定，得句偏饶绣虎诗。\n舞羽营门酋长侍，授书桥畔老人期。\n桂林我亦怀平子，岂有双金报所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶胡小山盐台二首 其一","author":"董其昌","text":"秀绝峨眉甲九垓，使君风采亦雄哉。\n忧时颇绌弘羊论，作赋谁当绣虎才。\n天划东南支半壁，人依冠冕重中台。\n省方合有輶轩记，可许侯巴问字来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶胡小山盐台二首 其二","author":"董其昌","text":"江海风烟揽辔论，百城守长拜行轩。\n朅从绣斧临吴甸，几为闾阎叩帝阍。\n挟笔千秋高雪调，熬波万灶矗云屯。\n鱼盐岂有藏名者，莫以于旄访席门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶卢原甫次韵","author":"董其昌","text":"山馆逢迎强著书，盘餐真愧郇家厨。\n聊供赋手骚兼蟹，雅称秋怀鲙有鲈。\n游屐若为偕尚子，雕虫祗合任非夫。\n遥知别后相思夜，能识罗浮梦里途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶董景越漕台二首 其一","author":"董其昌","text":"东山优诏见新除，又是西台揽辔初。\n轴转黄龙将禹贡，仗依玄武肃周庐。\n即今疏草凌霜笔，尽出春秋演露书。\n却为式微偏荐慰，年来无恙只三馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶董景越漕台二首 其二","author":"董其昌","text":"遥传北固驻襜褕，为采风谣入绘图。\n怀古定寻丁卯迹，登山谁作癸庚呼。\n星河初度天孙鹊，云槛朝飞御史乌。\n意气论交琼玖赠，何人存记钓鱼徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"魏涧泉中丞以奏疏诗集见贻诗以詶之","author":"董其昌","text":"壮猷何事厌雕虫，晁贾文章一代雄。\n尊俎坐筹销虏帐，山川行咏入唐风。\n奏将帝所篇称善，悬向都门字莫攻。\n鸿宝传来能自秘，较雠先贮石渠中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]