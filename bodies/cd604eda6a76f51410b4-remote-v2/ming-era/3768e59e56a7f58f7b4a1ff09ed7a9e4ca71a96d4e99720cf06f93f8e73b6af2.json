6029b79","dynasty":"明"}},{"title":"题金文鼎清风楼卷 其三","author":"杨士奇","text":"清风飒飒清云深，六月楼中暑不侵。\n朝阳光辉下凤彩，暮雨髣髴闻龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2336,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题金文鼎清风楼卷 其四","author":"杨士奇","text":"百年谁继赵松雪，近数毗陵王绂高。\n忽复乘云去无迹，登楼怀忆使心劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2337,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题金文鼎清风楼卷 其五","author":"杨士奇","text":"先生已别金陵去，归住吴淞近海滨。\n淇澳潇湘随处有，清风明月共何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2338,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题墨菊寄宗琏 其一","author":"杨士奇","text":"曾伴金城坊里住，邻园日日看花来。\n高秋九月毗陵郡，潇洒何人共酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2339,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题墨菊寄宗琏 其二","author":"杨士奇","text":"思诚斋里清如水，坐对幽花晚自香。\n共有故园螺渚上，几时归去赏秋芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2340,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"索子俊中书画松","author":"杨士奇","text":"千岁徂徕古翠蟠，拂云含雾泻风湍。\n毕宏韦偃君今是，烦写高堂五月寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2341,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蓟州道中见菊花有怀子启时彦行俭时勉诸君子 其一","author":"杨士奇","text":"秋光渐近重阳节，缓辔垂鞭踏软沙。\n却忆玉堂閒白画，谁家庭馆看黄花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2342,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蓟州道中见菊花有怀子启时彦行俭时勉诸君子 其二","author":"杨士奇","text":"想见联镳西出城，酒壶诗卷共高情。\n看山骑马渔阳郭，也似平坡寺里行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2343,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"滦河道中同杨太常宣夏二员外小酌柳下观鱼 其一","author":"杨士奇","text":"四人坐酌垂杨下，共爱清阴覆绿渠。\n未尽一壶还上马，却将閒散羡游鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2344,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"滦河道中同杨太常宣夏二员外小酌柳下观鱼 其二","author":"杨士奇","text":"云白山青护四围，水边杨柳翠如帏。\n人间无处无幽境，何补明时独未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2345,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅赠以穰","author":"杨士奇","text":"携手河梁欲别难，故乡南去路漫漫。\n一枝林下清如玉，但保风霜到岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2346,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"遇山居老有感 其一","author":"杨士奇","text":"细柳鲜桃潋滟春，白云流水净无尘。\n看渠鹤发林居者，只傍青山老此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2347,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"遇山居老有感 其二","author":"杨士奇","text":"著处溪山可置身，古人求志不求闻。\n从前未有匡时术，只合携家傍白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2348,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦亡妻 其一","author":"杨士奇","text":"孟光憔悴病来容，昨夜苍茫梦里逢。\n还似往年临别日，匆匆劳苦为纫缝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2349,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦亡妻 其二","author":"杨士奇","text":"经时未遂葬山丘，贤行终身恸不休。\n勤俭成家长儿女，一生辛苦为黔娄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2350,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送彝训兼问讯子勤 其一","author":"杨士奇","text":"銮坡凤沼接清班，忆昔同朝侍圣颜。\n此日相逢又相送，伤心回首见桥山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2351,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送彝训兼问讯子勤 其二","author":"杨士奇","text":"之官渺渺江南去，便道还家著锦衣。\n万里谁无桑梓意，同乡惆怅未同归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2352,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送彝训兼问讯子勤 其三","author":"杨士奇","text":"故人为郡端溪上，前月书来叹索居。\n同是贞元旧供奉，因君更问近何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2353,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题菊送别","author":"杨士奇","text":"送行渐及黄花节，江北江南白露寒。\n为有清香宜晚岁，独怜彭泽未休官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2354,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"唐马为士启题 其一","author":"杨士奇","text":"玉花骢马大宛来，俶傥权奇见异材。\n不道开元四十万，驽骀安得望龙媒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2355,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"唐马为士启题 其二","author":"杨士奇","text":"雄姿逸气真龙种，赤雾团身白玉蹄。\n自是西来第一匹，东风萧散不闻嘶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2356,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鬼谷圮桥东山云房四图为金学士题 其一","author":"杨士奇","text":"靡靡王风叹黍离，周公已远仲尼衰。\n乘车拥盖诸侯客，只说阳城鬼谷师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2357,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鬼谷圮桥东山云房四图为金学士题 其二","author":"杨士奇","text":"神遇圮桥岂偶然，君臣契合亦千年。\n不逢龙准真明主，三杰何人解识贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2358,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鬼谷圮桥东山云房四图为金学士题 其三","author":"杨士奇","text":"莫道征西旧司马，平生山水惬幽寻。\n白头匡济成何事，回首东山感慨深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2359,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鬼谷圮桥东山云房四图为金学士题 其四","author":"杨士奇","text":"云白山青琪树绿，神仙咫尺隔尘凡。\n九还真诀逢师授，自此流传到吕岩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2360,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨学士以海棠双鹊图赠其弟归求题 其一","author":"杨士奇","text":"杨家庭馆风光好，花萼连枝锦不如。\n况是和鸣双翠羽，相亲相乐似雍渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2361,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨学士以海棠双鹊图赠其弟归求题 其二","author":"杨士奇","text":"万里京华临别日，海棠花发欲春深。\n遥知晴鹊先将喜，啼满龙津碧树林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2362,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]