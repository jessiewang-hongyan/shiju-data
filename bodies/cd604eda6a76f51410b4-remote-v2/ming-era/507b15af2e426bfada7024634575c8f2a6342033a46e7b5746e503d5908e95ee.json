":"明_1.csv","pointer":49098,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归自北庄","author":"龚诩","text":"离却南沙已夕晖，随潮小艇快如飞。\n多情最是波心月，一路相随伴我归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49099,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早梅","author":"龚诩","text":"雪窗忽见两三花，便觉诗情渐有涯。\n应是东君念穷独，春风先遣到侬家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49100,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柏子庭画苍蒲","author":"龚诩","text":"爱尔青青石上蒲，寒泉清浸一尘无。\n世人不识无盐女，姣媚惟知羡子都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49101,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"癸未清明同八九友伴之玄明村为宋侍御乐庵先生扫墓","author":"龚诩","text":"道穷千载乐庵翁，埋没孤坟草莽中。\n今日我曹来拜扫，纸钱摇曳舞春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49102,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题听泉图","author":"龚诩","text":"万竹林中一草亭，亭前漱石水泠泠。\n道人不是筝笆耳，静倚阑干自在听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49103,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"负薪图","author":"龚诩","text":"会稽愚妇厌夫贫，辞去何曾愧失身。\n富贵自期年五十，买臣亦是一常人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49104,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"有感","author":"龚诩","text":"群峰叠叠水滔滔，跋涉都忘旧日劳。\n唯有不平常记得，每因感触便长号。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49105,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚菊","author":"龚诩","text":"宁忧失所困风霜，自信生平晚节香。\n一任寂寥无客赏，看花原不为重阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49106,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观梅","author":"龚诩","text":"梅花与我最相知，看了南枝又北枝。\n如此冷风如此雪，无人不笑老翁痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49107,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归自城中遇雪","author":"龚诩","text":"雪景诗情两得宜，枝藜何惜晚归迟。\n因过野老溪桥畔，又为梅花立少时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49108,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偕周季宏游东皋亭","author":"龚诩","text":"琅玕万个绕庭栽，无数青阴覆绿苔。\n漫煮凤团烧玉版，不妨日日与君来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49109,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游西畴竹林","author":"龚诩","text":"森森万玉俯清溪，径入苍云杳欲迷。\n珍重主人劳载酒，琅玕节下为留题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49110,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"枯荷","author":"龚诩","text":"红衣落尽翠盘倾，浣我清波一鉴明。\n说与儿童须摘尽，莫留馀叶引秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49111,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庭松","author":"龚诩","text":"岁寒群木总凋零，爱尔亭亭色愈青。\n谁信道人心似铁，小窗相对澹忘形。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49112,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢南野先生作棺见赠","author":"龚诩","text":"大患应知为有身，鸢乌蝼蚁岂疏亲。\n只缘未达庄生意，尚以遗骸累故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49113,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和孙格轩为余题泛舟图","author":"龚诩","text":"不慕瀛洲十八仙，青云无意事攀援。\n只怜南国溪山好，风月琴樽共一船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49114,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"道中见弋人有感而赋","author":"龚诩","text":"负弩蹲躯隐薜萝，鹤媒前导舞婆娑。\n凫鹥只合高飞去，同类应知误汝多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49115,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和金耑居为陈羽伯频写竹韵","author":"龚诩","text":"旅馆西风九月寒，脩篁摇翠两三竿。\n最怜明发归舟里，可得推篷带雨看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49116,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题西溪书舍赠顾宗术","author":"龚诩","text":"西溪高隐有馀清，最惬閒中野老情。\n秋夜几回来借榻，竹声清比读书声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49117,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"癸亥民情 其一","author":"龚诩","text":"太守安居花锦城，眼前儿女沸欢声。\n岂知田野通宵雨，救水浑如救火情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49118,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"癸亥民情 其二","author":"龚诩","text":"骤雨狂风日夕并，农夫泪眼几时晴。\n中秋赏客南楼上，唯恨顽云蔽月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49119,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙丑冬大雪时邑宰以雪作戏故赋之 其一","author":"龚诩","text":"衣破那禁透骨风，雪花如掌暗长空。\n忧民太守方沈醉，熟睡红炉煖阁中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49120,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙丑冬大雪时邑宰以雪作戏故赋之 其二","author":"龚诩","text":"腊雪连朝冷气严，喜闻宜麦更宜蚕。\n老夫正为苍生幸，冻死穷庐分亦甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49121,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]