[{"title":"失题 其三 芙蓉","author":"徐庸","text":"万朵芙蓉绿渚滨，露香清照水粼粼。\n锦云深处鸳鸯宿，秋色浑如富贵春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题 其四 菡萏芳塘","author":"徐庸","text":"綵云千片护芳塘，玩赏时来泛酒觞。\n醉唤美人歌一曲，数茎折取玉纤长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题 其五 南风琴韵","author":"徐庸","text":"处世长希太古心，南风一曲五弦琴。\n红尘消昼清如水，林下何人为赏音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题 其六 夜月壶觞","author":"徐庸","text":"丹桂花开几度新，壶觞对月倒青春。\n醉来欲劝嫦娥饮，愿乞玄霜济世人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题 其七 梅边听鹤","author":"徐庸","text":"声透梨云彻九天，古梅花底置胎仙。\n清风彷佛孤山下，处士诗成夜未眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"失题 其八 竹下围棋","author":"徐庸","text":"清风凉入芰荷衣，竹下围棋苦用机。\n剥啄几声敲不已，綵鸾惊起出林飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"文会图","author":"徐庸","text":"佳宾良会在秋林，诗句赓歌酒重斟。\n人世五伦今不废，百年同德不同心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂画 其一","author":"徐庸","text":"竹色兰香一雨过，两竿斜日照江波。\n钓徒岂是忘归去，家在西岩路不多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂画 其二","author":"徐庸","text":"苍松曾受大夫官，风起波涛五月寒。\n攲枕几回听不厌，竟无清梦到槐安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂画 其三","author":"徐庸","text":"蜜叶高枝倚碧天，半擎霜雪半云烟。\n峥嵘未作蛟龙去，要待青青化石年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂画 其四","author":"徐庸","text":"桐江无意恋羊裘，别向江湖买钓舟。\n捕得鲜鳞堪换酒，不知人世利名愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公馀八景 其一 一庭草色","author":"徐庸","text":"茸茸生意悦春华，绿藻闲庭衬落花。\n几度生金风偃处，官居浑似隐人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公馀八景 其二 三径苔痕","author":"徐庸","text":"三径莓苔雨后青，制来双屐不曾经。\n寻常只许胎仙踏，□迹俱成隶篆形。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公馀八景 其三 暑雨鸣荷","author":"徐庸","text":"荷叶满池鸣夏雨，珠玑乱撒翠槃中。\n郎官侧耳成清听，声比芭蕉竟不同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公馀八景 其四 清风动竹","author":"徐庸","text":"广寒畴昔扳丹桂，茂苑于今种翠筠。\n长日清风能解愠，新凉分及往来人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公馀八景 其五 月林清影","author":"徐庸","text":"秋风袅袅露漙漙，月在疏林影在阑。\n我玩清光坐良夜，嫦娥应恐不禁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公馀八景 其六 菊圃幽香","author":"徐庸","text":"黄花菊放晚香幽，万朵金钱买断秋。\n留取落英供服饵，不教白发上人头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公馀八景 其七 岁寒黄柏","author":"徐庸","text":"两株黄柏种庭前，六叶离离照简编。\n任使□天霜与雪，岁寒颜色自怡然。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33029,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公馀八景 其八 雪霁寒梅","author":"徐庸","text":"绛苇青枝□倚墙，六花□□早封香。\n共知结就累累实，鼎鼐调羹入庙廊。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33030,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上人竹兰石","author":"徐庸","text":"挺挺琅玕傍石坡，丈人君子一尘无。\n国香亦是清高物，结佩曾供楚大夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33031,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松竹 其一","author":"徐庸","text":"白点清霜翠点烟，老枝香叶寄林泉。\n长材不献明堂用，要待峥嵘化石年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松竹 其二","author":"徐庸","text":"老干新稍翠叶齐，龙光传派自曹溪。\n清风十八滩头景，却忆坡仙旧品题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九清图","author":"徐庸","text":"清姿九种惬清欢，松竹梅矾杏蕙兰。\n翠叶紫囊香小小，仙游不怯早春寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又画","author":"徐庸","text":"山雨初晴虎迹多，渡头倚日奈愁何。\n急呼渔艇求相济，彼岸无遥亦易过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木渎八景 其一 灵岩岚翠","author":"徐庸","text":"行殿销沉换化城，千岩万壑翠岚生。\n天风不散空濛影，一路丹青画不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木渎八景 其二 澄湖秋月","author":"徐庸","text":"澄湖浸月水天同，万顷金波五夜风。\n丹桂白莲秋最好，水晶宫似广寒宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33037,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木渎八景 其三 香径春游","author":"徐庸","text":"椒兰采罢馆娃倾，香径惟存旧日名。\n游客春来吊遗迹，野花芳草不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33038,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木渎八景 其四 虹桥晚眺","author":"徐庸","text":"飞梁甃石架空虚，湖水通流自具区。\n莫谓晚来闲眺望，正宜题柱继相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33039,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木渎八景 其五 姜潭渔集","author":"徐庸","text":"姜潭潭上钓船归，几树垂杨带落晖。\n笑斫锦鳞沽酒饮，醉敲铜斗舞蓑衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33040,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木渎八景 其六 山市樵歌","author":"徐庸","text":"红尘不上薜萝衣，一曲清歌与世违。\n斜日偶从山市过，几家鸡犬莫惊飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33041,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木渎八景 其七 锦峰霁雪","author":"徐庸","text":"锦峰重叠雪交加，散尽白云见日华。\n策杖莫辞山路远，试穿林麓探梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33042,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木渎八景 其八 胥浦澄霞","author":"徐庸","text":"胥浦红霞照碧流，夕阳影里衬渔舟。\n望来不异天孙锦，一幅鲜明晚未收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33043,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月梅","author":"徐庸","text":"梨云影里月团团，姑射新妆午夜寒。\n约得素娥离内阙，瑶台高处倚阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33044,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题钱廷丽画次东原韵","author":"徐庸","text":"薜雨萝烟屋数间，春风门外鸟关关。\n平生志在经书里，人世功名始是闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33045,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题严廷用扇","author":"徐庸","text":"溪雨初过作晚凉，一罾牵处藕花香。\n得鱼归去还沽酒，准拟今宵入醉乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题严廷器扇","author":"徐庸","text":"胜日寻芳踏软泥，蹇驴牵过石桥西。\n天台迥异人间世，开遍桃花路欲迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为陈叔庄题画次韵 其一","author":"徐庸","text":"青山尽处树边头，一片闲云学水流。\n爱此紫薇村上景，欲书招隐寄同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33048,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac