fe5294295f79689","path":"明_2.csv","pointer":33067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题奚彦礼所藏画四首 其二 天鹅","author":"徐庸","text":"菡萏花开照绿波，香红影里浴鴐鹅。\n飞鸣来去随情性，不向平原畏网罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题奚彦礼所藏画四首 其三 孔雀","author":"徐庸","text":"牡丹香吐正春深，何处飞来孔雀禽。\n倾国倾城颜色好，徘徊似有惜花心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题奚彦礼所藏画四首 其四 白鹤","author":"徐庸","text":"缟衣朱顶立亭亭，千岁形模□□经。\n啄食定思何处物，玉田芝草正青青。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扇面","author":"徐庸","text":"远来相访故人家，花落东风日易斜。\n布袜青鞋行巳惯，不妨途路有三叉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画二首 其一","author":"徐庸","text":"瞿昙一学便超群，十载辞家住白云。\n占断洞天林屋地，青山不许世人分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画二首 其二","author":"徐庸","text":"石路崎岖近却遥，抱琴将赴隐人招。\n茅堂只在云深处，骑马看山过野桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画 其一","author":"徐庸","text":"泉落高峰别样清，奔流无异玉河□。\n□将绿绮弹秋水，相呼潺溪一派声。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画 其二","author":"徐庸","text":"朔风吹雪洒渔蓑，水泛鱼鳞钓不多。\n薄暮收纶归去远，昔年重唱濯缨歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画 其三","author":"徐庸","text":"松花频饮饮中仙，半带微酣不醉眠。\n两腋清风箕踞坐，还将白眼望青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题汤汝鸣所藏葵丘","author":"徐庸","text":"一枕春酣起较迟，落花啼鸟掩芳茨。\n涧边南去无多路，有客相过竟不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石榴鹦鹆","author":"徐庸","text":"石榴枝袅夏风凉，鹦鹆双双闹日阳。\n啄取锦囊红子破，甘浆流出带清香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃花白头","author":"徐庸","text":"青枝翠叶弄光晖，一雨初晴万颗肥。\n彷佛王孙金弹子，幽禽何事不惊飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金桃画眉","author":"徐庸","text":"陇山鹦鹉啄金桃，空翠霏霏湿羽毛。\n若得画眉枝上立，金衣一色更清高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松阴书舍为顾廷尚题","author":"徐庸","text":"松树生阴草舍孤，右披经史左披图。\n长材莫向清时老，正好登庸作大夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林禽山鹊","author":"徐庸","text":"仙露如珠泻碧空，名园珍果熟秋风。\n林擒味好来山鹊，啄破枝头数点红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"僧画","author":"徐庸","text":"无声图画有声诗，留向禅房几岁时。\n白鹤未归华表柱，一回披诵一相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花鸟","author":"徐庸","text":"满树梨花白雪香，枝间啼鸟弄春阳。\n画眉人在深闺里，几度听来欲断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长房图","author":"徐庸","text":"长房学业己多时，中道还家到葛陂。\n竹杖得来随弃去，不知原是化龙枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二乔图 其一","author":"徐庸","text":"倾城倾国嫁孙周，两朵芙蓉并蒂秋。\n玉女阴符曾遍读，铜台安得锁春愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二乔图 其二","author":"徐庸","text":"临婚谁说愧英雄，日事兵书最有功。\n不学分香歌舞态，西陵遥望泣春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题沈如美雪中谒友图","author":"徐庸","text":"客途冲雪肯回舟，远过沙溪访太丘。\n金帐羊羔谈笑处，风情不减晋风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题张用宜梅卷","author":"徐庸","text":"孤山山下水边村，铁石枝条碧藓痕。\n一夜东风吹碇蕊，□香和月倚黄昏。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画 其一","author":"徐庸","text":"寻仙又复到天台，山上桃花依旧开。\n流水石桥春最好，如何不挈阮郎来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]