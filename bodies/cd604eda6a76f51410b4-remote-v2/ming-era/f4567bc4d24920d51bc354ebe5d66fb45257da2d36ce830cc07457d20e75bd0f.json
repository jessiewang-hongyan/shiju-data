[{"title":"送庞景元南还","author":"李英","text":"九陌晴明积雪光，邮亭南望路偏长。\n谩将书札投征骑，愁把梅花忆故乡。\n燕甸浮云垂碣石，楚天归雁度衡阳。\n那堪芳草三春别，握手何时慰断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日访客隆福寺","author":"李英","text":"万里春回汉苑西，禅林独步访幽栖。\n雪消石磴流澌急，云尽柴门落日低。\n归雁每从南浦见，新莺多在上林啼。\n清尊且约寻芳去，匹马西山路不迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答吴门王百谷","author":"李英","text":"荷衣鹤发老沧波，尺牍遥传念钓蓑。\n目断天涯秋月满，梦飞江左暮云多。\n新诗古调难为和，丛菊丹岩只自歌。\n海内才名珍重意，著书终日掩藤萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客至","author":"李英","text":"旅馆初春夕，天涯上客杯。\n梅花开欲尽，骑马几时来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"席上赋明月","author":"李英","text":"光分骢马色，彩散侍卧衣。\n飞盖还高会，西园客未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登飞来寺山顶","author":"李英","text":"峡山古寺傍青天，殿阁岧峣紫翠连。\n日暮薜萝千嶂合，猿声多在白云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吉州夜行","author":"李英","text":"西风鸣橹动轻鸥，章水萧条送客舟。\n何处江南望江北，楚天明月夜悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伏日臣病书事","author":"李英","text":"伏枕天涯病未消，乡心千里梦迢迢。\n一帘疏雨春花尽，深锁柴门臣寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张汝成归省　三首 其一","author":"李英","text":"边城雪后岁将残，张翰思归不可攀。\n此去驿楼今夜月，相思空望太行山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张汝成归省　三首 其二","author":"李英","text":"东归羡尔去承颜，送别长亭忍独还。\n到日故园多乐事，应怜王粲滞江关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张汝成归省　三首 其三","author":"李英","text":"题诗吟眺白云间，昔日缁尘憔悴颜。\n上苑莺声期尔赋，乘春须早入燕关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"日观峰","author":"李英","text":"巑岏万里岳云长，日观峰前接大荒。\n独立丹崖劳极目，不知何处是扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除前立春","author":"区大枢","text":"山城岁已暮，大寒将告终。\n岭雪照天白，阴云霁层穹。\n星纪淫玄枵，斗柄直方东。\n丑月届当春，彩仗迎苍龙。\n土牛出地气，勾芒逐严冬。\n青帝执规乘，大簇达荄蒙。\n阳和回宇宙，众庶欣豫同。\n羁栖南楚徼，留滞独微躬。\n方抱穷年闷，尚其骀荡融。\n嘉卉肇祁祁，鸣禽哢好风。\n于耜来举趾，羡彼东皋农。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六月十四夜偶起望月","author":"区大枢","text":"浮云纤欲净，众星疏以没。\n中宵不遑寐，起视南楼月。\n皓魄已几望，圆景尚微缺。\n溽暑澄金波，凉飙迎秋发。\n忆昔西园游，文思壮飞越。\n如何此时望，皎皎空城阙。\n搔首立瑶阶，徒然照华发。\n乌惊栖靡定，哀响送蜻蛚。\n仿徨还予寝，梦魂但超忽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏小燕","author":"区大枢","text":"小小檐间燕，翁翁傍母飞。\n弄音喧绣幕，学舞戏春晖。\n拾絮穿花过，衔泥掠水归。\n终辞白屋去，还向玉楼依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟下大路峡","author":"区大枢","text":"高秋明远水，水上见人家。\n津树迎船下，村烟带浦斜。\n野童樵曲岸，江女浣晴沙。\n便觉乡园好，何须泛海槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"紫竹洞","author":"区大枢","text":"岩扉长不掩，紫竹护仙宫。\n有客来清啸，翛然嶰谷风。\n云收千嶂雨，花发四时丛。\n龙杖终当策，何方访葛洪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沥湖","author":"区大枢","text":"木兰泛泛水云遮，碧浪重湖入望赊。\n近渚轻鸥随棹转，长堤芳草压桥斜。\n风前菱叶摇空镜，渡口桃花落晚霞。\n便欲□源穷河汉，恐令牛斗犯仙槎。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白玉蝀桥泛舟流霞岛","author":"区大枢","text":"彩霞飞自赤城标，双棹淩空渡玉桥。\n波上星辰三岛接，湖中云树十洲遥。\n层岩锦石晴相映，小洞桃花晚故飘。\n共促仙杯驻颜色，醉来同听紫鸾箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜发端州归?川","author":"区大枢","text":"羲御忽西驰，夕阳挂烟树。\n薄暮理归舟，端溪向东注。\n飞鸟投遥林，行人入前聚。\n江月呈圆辉，金波泛寒兔。\n皛皛下空洲，悠悠涉长路。\n时闻村中语，复觉挐音溯。\n美哉吾土乐，一枝良足度。\n不效浮海叹，窃同始宁慕。\n归去?川上，田园饬吾素。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"劝农诗 其一","author":"区大枢","text":"泛彼谷风，鼓荡大和。\n农辰既届，我庶如何。\n无趼于陆，无滥于河。\n以缘南亩，慎勿之讹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"劝农诗 其二","author":"区大枢","text":"袯斯襫斯，曷秉尔镃。\n芟厥茂草，窒彼荒岐。\n尔田不臧，谁则女诒。\n畇畇濯濯，罔或予埤。\n狎其疆畔，无昵尔茨。\n率彼妇子，往馌东菑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淋雨叹","author":"区大枢","text":"渰渰伏雨，浩浩洪泉。\n溢霤决渠，沉涂塞渊。\n堂阶藓积，屋瓦蜗缘。\n车有停轨，突无常烟。\n经旬杜户，累日如年。\n嗟尔贫士，长歌自怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邯郸道","author":"区大枢","text":"妾本邯郸女，不识邯郸路。\n侍辇灞陵上，君王东北顾。\n指此走妾家，始忆丛台故。\n寄语采桑伴，盈盈有长慕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"君马黄 其一","author":"区大枢","text":"君马黄，臣马玄。\n君马为龙，蹀躞万里，超忽九天。\n臣马批耳络首，勉承鞭策，不敢辞以骞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"君马黄 其二","author":"区大枢","text":"君马黄，臣马白。\n君马为神，追蹑风云，?腾八极。\n臣马仰秣伏枥，勉奉羁靮，不敢怠以息。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将进酒元旦作 其一","author":"区大枢","text":"将进酒，执玉卮，陛下万岁治无为。\n体道修身，以德临民，兆姓乐雍熙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将进酒元旦作 其二","author":"区大枢","text":"将进酒，捧瑶觞，陛下万岁坐明堂。\n班律布度，率职禀令，四海悦安康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将进酒元旦作 其三","author":"区大枢","text":"将进酒，献玉琛，四方万国属君心。\n濮铅祝栗，觚竹北户，靡不奉德音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春闺思","author":"区大枢","text":"晓起临芳树，柯条何沃若。\n香风入房栊，飞燕穿帘幕。\n昨宵春梦长，忘却花前诺。\n持此问情人，相望何寥郭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南还答汪公干兼别京中同好 其一","author":"区大枢","text":"余驾远行迈，将归南海南。\n感叹二三子，缱绻不能堪。\n五载客京华，出入必见参。\n何期一朝别，分飞各异骖。\n无以长相思，少原有遗簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南还答汪公干兼别京中同好 其二","author":"区大枢","text":"欢言苦不足，离别怅无多。\n执手长太息，中夜起悲歌。\n悲歌夫若何，人生渺逝波。\n驱车洛阳道，振策厉嵩河。\n三复琼瑶篇，永念在中阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南还答汪公干兼别京中同好 其三","author":"区大枢","text":"中阿不可见，念子情何极。\n遥望嵩衡云，恨无生羽翼。\n予附皇华游，子复亲闱忆。\n昆朋岂不乐，无乃少子识。\n欲从而末由，对之长叹息。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南还答汪公干兼别京中同好 其四","author":"区大枢","text":"叹息复何言，为别已在兹。\n对酒不能酣，抚缨立路歧。\n河清难再俟，白日忽西驰。\n感君意气多，期我岁寒知。\n愿言终努力，长歌怀此辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山店早发赴虔作","author":"区大枢","text":"蒙雾隮峻坂，荆榛翳前途。\n仆夫疲登顿，将进还趑趄。\n望见东峰上，杲杲出阳乌。\n浓露濡野草，丹枫变霜涂。\n圃场无滞穗，茅屋休犁锄。\n村中才卧起，炊烟曳穷庐。\n牧人驱犊出，商歌听有馀。\n勋名竟何立，祇用窘微躯。\n颠毛愁种种，览镜泣形枯。\n回首望平田，耦耕愧长沮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刺诡","author":"区大枢","text":"大易崇易简，小雅称正直。\n德业亮天地，福禄绥邦国。\n师师风渐邈，寅恭谊寖忒。\n谈笑类优俳，机锋不可测。\n平胸藏鳞甲，周道树荆棘。\n涂面事贵人，竿牍匪时入。\n猱升讵无因，茑施阴有力。\n闪烁千万端，变幻如鬼蜮。\n我想贤哲衷，青天并皎日。\n精白对友朋，靖共修厥职。\n焉用兹诡遇，难逃众目识。\n穷达况有命，显膴何必得。\n伤哉无耻徒，何为长太息。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"从军行","author":"区大枢","text":"六郡良家子，应募充羽林。\n边亭烽未息，往征阴山阴。\n平沙万里望，白草莽萧森。\n悲风四面来，胡马有哀音。\n矧伊中土士，能无泪沾襟。\n仰视雁南翔，悠悠伤我心。\n所赖主将贤，爱士重千金。\n殊恩且未报，虽生焉足任。\n誓将灭丑类，铭绩燕山岑。\n寄语闺中人，且勿常苦吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤台曲","author":"区大枢","text":"萧史弃尘氛，吹箫入紫云。\n还来邀弄玉，鸣凤自为群。\n联翮青冥外，和气结絪缊。\n列仙顾之笑，罗袂飘兰芬。\n世岂无仇匹，谁如此两君。\n即今秦台上，遗风百代闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采珠篇","author":"区大枢","text":"长安市儿鬻珠好，五侯七贵竞争宝。\n快意宁复论兼金，但获明珠即绝倒。\n远物何由遂见珍，彩光错落称媚人。\n声价无如走盘上，贵重直使连城嗔。\n倾都豪货每如此，九重好尚亦复尔。\n大农进御犹不敷，濒海仍闻出中使。\n陆路纷纷生绎骚，楼船泛泛历波涛。\n貂珰乘机恣渔猎，黔黎丧魄等鸿毛。\n纵然探得珠万斛，难免海滨兴怨讟。\n老蚌剖残明月孤，重渊搜尽骊龙哭。\n吾闻廉守昔孟尝，合浦珠徙还复光。\n比来竭泽何为者，珠倘有灵珠应藏。\n又闻国宝在得士，圣主投珠士乃止。\n与其径寸鉴数车，孰若高贤照万里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高丽刀行","author":"区大枢","text":"客从高丽回，诒我高丽刀，精钢新淬吹发毛。\n切玉剸犀未足贵，杀人饮血轻豪曹。\n此刀名擅高丽锷，高丽短兵非尽弱。\n一夫善操，万夫立却。\n迩来倭患危若丝，君臣拱手待我师。\n惜哉有刀不能用，乃知世上不可一日无男儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"捣衣","author":"区大枢","text":"秋闺寒不寐，中夜理衣裳。\n裂帛开朱匣，调砧响画廊。\n力从香杵竭，思绕玉关长。\n泪滴痕犹染，凭君察远将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塞下曲 其一","author":"区大枢","text":"玄漠风沙迥，防胡列汉兵。\n才乘光禄塞，复逼右贤营。\n玉剑连星出，金笳带月鸣。\n谁怜万里外，辛苦为长城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塞下曲 其二","author":"区大枢","text":"戚戚去乡里，遥遥上塞垣。\n秦城百战地，汉垒万年屯。\n牧马逢秋下，乘墉彻夜奔。\n从来边戍苦，不敢怨中原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塞下曲 其三","author":"区大枢","text":"汉戍出萧关，西行万里艰。\n黄云霾陇坂，白日曀阴山。\n疏勒经年往，玉门几岁还。\n惟应青海月，常得照离颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过湘阴吊三闾大夫","author":"区大枢","text":"放逐堪谁诉，孤忠祇自知。\n美人空怅望，公子敢言思。\n兰忍宁终弃，荪何竟不移。\n皇天虽有问，寥廓使人疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过长沙吊贾太傅","author":"区大枢","text":"政事堪流涕，南迁一疏分。\n猜疑蒙白日，卑湿堕青云。\n万里投湘赋，三年讯鵩文。\n可怜宣室后，召对更无闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻白云洞瀑布因坐泛石上","author":"区大枢","text":"侧径萦崖入，虚空小洞衔。\n雪飞初夏瀑，烟锁半晴岩。\n炼药安金鼎，藏书发石函。\n仙杯才共泛，未许素云缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登大科峰是西樵绝顶","author":"区大枢","text":"高峰云外跻，胜绝此樵西。\n茶径千畦上，村烟几处迷。\n林昏藏鬼谷，嶂迥出灵梯。\n抗手从兹去，天边蹑紫霓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日偕诸弟泛舟?川值雨","author":"区大枢","text":"炎云度远空，带雨入■中。\n急响浮行苇，馀阴挂剌桐。\n停舟依浅渚，载酒出深丛。\n渐觉新凉好，溪棠送晚风。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过侍御弟园亭因赠","author":"区大枢","text":"閒居能早赋，四十卧烟霞。\n旧列台中柏，新栽江上花。\n林藏三径曲，桥引一溪斜。\n谁忆清朝彦，归来傍钓槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三日登真觉寺","author":"区大枢","text":"隐隐冯香阜，平林入望重。\n风花千地散，春色半天逢。\n檐宿迎祥鸽，潭藏护法龙。\n晚看调马者，蹀躞敛疏钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋晚忆舍弟寺居清适复有此寄","author":"区大枢","text":"禅林秋色晚，久坐转成幽。\n白露收庭枣，清霜折海榴。\n诸贤时复过，半偈日应留。\n何必庐山上，还寻慧远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"发南京留别故人","author":"区大枢","text":"遥遥江上舟，千里溯江流。\n风景三山在，豪华六代幽。\n石城环故国，天堑隔重洲。\n欲采芙蓉去，思君南渡头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同太史弟游燕子矶 其一","author":"区大枢","text":"矶上一登临，沧浪下渚浔。\n秋来吴岫晚，寒入楚江深。\n绝磴窥青雀，长松韵素琴。\n苍苍葭菼际，之子尔何心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同太史弟游燕子矶 其二","author":"区大枢","text":"秋皋爽气偏，矶上信凄然。\n水国苍葭外，渔家白鹭边。\n云帆移远浦，江树羃浮烟。\n何处南来雁，遥遥下北燕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春思 其一","author":"区大枢","text":"春心不自持，春事正相宜。\n蝴蝶飘园粉，蜘蛛罥牖丝。\n落霞翻紫燕，芳树啭黄鹂。\n夫婿称殊众，青骢白玉羁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春思 其二","author":"区大枢","text":"春晓愁无绪，良人在异乡。\n玉台悬故镜，银蒜坠空床。\n沐发当谁惜，簪花祇自伤。\n终朝垂玉箸，徒负此年芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋思 其一","author":"区大枢","text":"重房秋寂寂，中夜守空帷。\n香气熏笼冷，虫声入户悲。\n流黄机罢早，尺素雁归迟。\n无限相思泪，阑干满面垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋思 其二","author":"区大枢","text":"日落空闺晚，寒螀暗壁啼。\n绣纹千缕刺，锦字八行题。\n鸾镜朝慵览，鸳帏夜苦栖。\n思君君不见，肠断玉关西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"从板石登舟赴虔","author":"区大枢","text":"积雨登崖滑，逢舟且驻骖。\n水防穿石溜，山閜出蒲庵。\n岸莽低春潦，峤丛隐暮岚。\n计行过信宿，犹未达虔南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"投宿山家 其一","author":"区大枢","text":"荒山行役晚，傍岭宿孤村。\n篱落人家少，溪塘暮雨繁。\n牛羊归故径，蓑笠散春原。\n独坐明灯里，寥寥谁与言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"投宿山家 其二","author":"区大枢","text":"田家无比闾，何处问安居。\n茅屋孤烟外，荒村返照馀。\n林藏山月小，雨过石潭虚。\n赖有清宵梦，犹能到玉除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵宝观 其一","author":"区大枢","text":"官閒便出郭，独驾往城东。\n菌阁含朝雾，芝楼带晚虹。\n林香飘户外，山翠落庭中。\n且就烟霞赏，吾将揽桂丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵宝观 其二","author":"区大枢","text":"不奈耽幽兴，来窥小洞天。\n地暄梧未落，秋晚菊将妍。\n岚气千峰净，川光一壑涟。\n松醪无处觅，相对共陶然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜 其一","author":"区大枢","text":"秋暑晚蝉鸣，商钟入夜清。\n烟消华月出，云净绛河明。\n井侧桐应下，林边鹊自惊。\n更堪城上笛，吹作玉关声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜 其二","author":"区大枢","text":"片雨下山阿，空庭暮若何。\n寒催秋过雁，凉入夜舒荷。\n草上来青女，池边出素娥。\n徒传瑶瑟怨，谁为鼓云和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]