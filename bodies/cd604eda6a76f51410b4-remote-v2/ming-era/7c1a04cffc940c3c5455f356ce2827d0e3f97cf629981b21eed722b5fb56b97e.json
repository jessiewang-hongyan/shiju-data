[{"title":"塞上曲寄少司马苏允吉 其五","author":"谢榛","text":"牧马深山白草中，不闻鼙鼓动西风。\n老兵閒坐斜阳里，尽说今秋魏绛功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上曲寄少司马苏允吉 其六","author":"谢榛","text":"鸦啼初日塞门开，昨夜阴山探骑回。\n秋尽漠南风雪遍，单于不敢射雕来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伤沈夷斋参政","author":"谢榛","text":"宦臣垂老付沧洲，八咏曾题江上楼。\n瑶瑟无声词客散，秖馀松槚片云秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄周木泾方伯","author":"谢榛","text":"金马山晴吐翠岚，洞庭春酒忆黄柑。\n文章自出吴中格，不尽云霞耀日南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张少尹元文还任新喻兼寄李明府伯承","author":"谢榛","text":"群玉峰头华月低，九仙台上白鸾栖。\n乘秋欲借王乔履，一夜高飞吴楚西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张宪副叔载镇巴东 其一","author":"谢榛","text":"风吹朔雁感离人，日下燕山望去尘。\n白发遥怜庾开府，满天秋色过三秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张宪副叔载镇巴东 其二","author":"谢榛","text":"驱马西行剑阁开，即今重见勒铭才。\n吟秋月照三巴水，吊古风生八阵台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同陈广文荩卿饮王学孔园亭","author":"谢榛","text":"乱树高亭驻落晖，鹍弦慢拨羽觞飞。\n古今多少风骚客，谁向花前不醉归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋闺","author":"谢榛","text":"棠梨落叶满园秋，门掩蛩声入夜愁。\n未寄征衣霜露冷，梦魂先到古云州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李子仁书屋","author":"谢榛","text":"苍林白屋满床书，山送秋云到广除。\n鸟雀不惊人对酒，一帘松月夜何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬李之茂","author":"谢榛","text":"梦回彷佛瓮头香，犹忆君家醉玉觞。\n起向花庭吸清露，不知残月笑人狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次南岑丈雨中见怀韵","author":"谢榛","text":"燕赵长歌调自悲，山城摇落叹归迟。\n夜深孤剑龙光动，风雨鸣窗不寐时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚登林虑城","author":"谢榛","text":"山抱孤城四壁青，云沙烟草夕冥冥。\n半天舒啸月东出，好醉美人双玉瓶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郭寿卿园同申伯宪牛国祯诸君吟酌","author":"谢榛","text":"苍凉海日上亭台，无数幽花带露开。\n人在万山秋色里，白云低傍酒樽来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿山家","author":"谢榛","text":"空山茅屋夜迟迟，促织啼寒欲诉谁。\n少妇灯前事机杼，秋风花尽木绵枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮雨登圆通阁望邺城有感 其一","author":"谢榛","text":"杰阁移时傍赤阑，野云东望转迷漫。\n太行不隔中天雨，遥忆柴荆共暮寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮雨登圆通阁望邺城有感 其二","author":"谢榛","text":"云压山城雨不休，阁中遥起故园愁。\n漳河东去苍茫色，犹似三台醉里秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次孔丈对花二韵","author":"谢榛","text":"桃树有花春可怜，醉归犹望洞门前。\n美人不得分明见，咫尺空濛隔暮烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林亭漫兴","author":"谢榛","text":"野树青青布谷啼，更看蝶绕菜花畦。\n今宵不尽名园兴，梦落苍茫水竹西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄曹中丞","author":"谢榛","text":"一自西河别孔融，楚天诗兴复谁同。\n青荷渐长黄梅熟，人在江楼细雨中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送高生归吴","author":"谢榛","text":"客中多病素琴孤，季子黄金更有无。\n花满江城春正好，一帆烟雨下姑苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春宫词","author":"谢榛","text":"鹦鹉唤人池殿东，花开晓日照金笼。\n绣帘不捲春将暮，懒向重阶扫落红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋宫词 其一","author":"谢榛","text":"桐叶满阶秋思多，深宫玉辇几时过。\n西湖还驾黄龙舫，日暮遥听瓠子歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋宫词 其二","author":"谢榛","text":"茜红衫子郁金裙，玉貌灯前坐夜分。\n汉帝如何诛画士，六宫犹自有昭君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋宫词 其三","author":"谢榛","text":"太液池东明月高，侍儿和露摘蒲萄。\n秋来不敢题纨扇，宣室于今万事劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋宫词 其四","author":"谢榛","text":"院院黄花秋色浓，几看青镜惜芳容。\n琼窗忽梦金舆过，长乐霜寒五夜钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采莲曲","author":"谢榛","text":"家近城西绿水塘，荷花开落几悲伤。\n采莲遥寄阿郎去，妾抱苦心终为郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"聂政墓","author":"谢榛","text":"轵里空馀鸟雀愁，依然落日对荒丘。\n丈夫一诺轻生死，浩叹风前万木秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阮籍墓","author":"谢榛","text":"凉秋白露满芳荪，无限穷途旧泪痕。\n千古狂歌谁会意，西风原上吊诗魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬方子文见寄登岱之作","author":"谢榛","text":"风骚谁继鲍参军，浩唱凌秋碧落闻。\n独秀峰头閒对酒，月华高出海东云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋暮登九龙山","author":"谢榛","text":"兴来携酒一登攀，满径秋花照客颜。\n醉舞天风人不见，白云飞度九龙山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕","author":"谢榛","text":"此夜欢游白昼同，六街车马度春风。\n丝簧声动仙人馆，灯月光连帝子宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中集王文父别墅登楼得秋字","author":"谢榛","text":"西园佳会几名流，野色偏多背郭楼。\n汾上雨晴还驻马，白云一片写清秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮雨山行感怀","author":"谢榛","text":"马首奔流响石滩，乱山风雨送人寒。\n别来茅屋常虚榻，却忆南华枕上看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新乡城西昔送李学宪于鳞至此感怀 其一","author":"谢榛","text":"路出新乡烟树重，石桥曾别李攀龙。\n谩言谢朓惊人句，独立秦高落雁峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新乡城西昔送李学宪于鳞至此感怀 其二","author":"谢榛","text":"望望崆峒倚赤霄，广成何日一相邀。\n凤台月出谁同醉，独爱秦声听玉箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新乡城西昔送李学宪于鳞至此感怀 其三","author":"谢榛","text":"薄暮登攀诗兴孤，奚囊多少大秦珠。\n探奇不尽仍呼酒，自信精华绝代无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新乡城西昔送李学宪于鳞至此感怀 其四","author":"谢榛","text":"文旌西去感秋风，汉代豪华祇废宫。\n静夜搜奇心自远，千年宝气有无中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新乡城西昔送李学宪于鳞至此感怀 其五","author":"谢榛","text":"大道相携五岳游，老夫共尔赋高秋。\n剩将石髓换仙骨，西指昆崙天尽头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洛城西送别纪明府贞甫","author":"谢榛","text":"送别西郊车马行，乱山深处隐孤城。\n黄花潭上秋将老，独采馀芳寄远情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杜预墓","author":"谢榛","text":"夜观左史日谈兵，勋业仍兼著述名。\n石马无踪神爽在，满天霜月照佳城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杜甫墓","author":"谢榛","text":"洞庭昔返楚天魂，孤冢千年失子孙。\n蜀道悲歌今不见，暮云愁色满中原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望嵩峰漫题","author":"谢榛","text":"嵩峰欲赋客徘徊，野菊馀花石上开。\n何处青山不秋色，白云有意傍人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嵩阳书院观碑忆李宪副元树 其一","author":"谢榛","text":"一到嵩山感故情，巍然碑石见题名。\n当时若赋阳春调，独立中原和楚声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嵩阳书院观碑忆李宪副元树 其二","author":"谢榛","text":"懒挥楚赋静心神，李白知谁是后身。\n试问汉时三柏树，有灵曾阅几诗人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"达摩洞","author":"谢榛","text":"心空面壁古来闻，五乳峰头自落曛。\n欲问无生渺何处，西归葱岭万重云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登封道中值雨","author":"谢榛","text":"山雨生寒接远烟，水中乱石绿苔鲜。\n几家茅屋疏林外，鸡犬无声薄暮天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月晦夜少林寺对雪","author":"谢榛","text":"山房宿雀静檐牙，月尽空林忽冻花。\n三十六峰今夜雪，并将寒色照禅家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚至白马寺登毗卢阁望洛阳安国禅院","author":"谢榛","text":"雪晴山阁冷侵衣，西望平林暮鸟归。\n鹫岭云霞空里色，洛城金界共馀晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独步明月山因睹荒凉遂沮游兴","author":"谢榛","text":"荒山白草路盘盘，却忆仙家倚石栏。\n落日疏烟秋色好，玉清阁上几回看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西园为南庵翁题","author":"谢榛","text":"黯淡云低竹石间，奚童斸笋踏泥还。\n菜花春老西园雨，尽日亭台燕子閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 黄河清 其一","author":"胡应麟","text":"黄河清，圣人出。\n应昌期，诞至德。\n著戎衣，奋三尺。\n靖四方，建都邑。\n干戈偃，弧矢戢。\n统九有，主社稷。\n神与鬼，咸受职。\n烽烟扫，爝火熄。\n维大明，照中国。\n万千祀，与天一。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其二 凤之翔","author":"胡应麟","text":"凤之翔，在濠梁。\n义师起，帝网张。\n二十四将驱天狼，兵锋所指定四方。\n薄海内外以莫不来王，威加六合返旧疆。\n徵歌悉发诸儿郎，复彼人民世世无有所与为我沐与汤。\n击筑大风云飞扬，千秋万岁乐未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其三 揽群雄","author":"胡应麟","text":"揽群雄，盗如猬。\n大圣握符起淮汭，与神为谋蓄锋锐，提三尺剑驱海内。\n驱海内，揽群雄。\n真人出，天下同。\n四方六合咸景从，如风从虎云从龙。\n汛扫大漠如飞蓬，扶桑曈曈朝日红。\n驱海内，揽群雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其四 克建业","author":"胡应麟","text":"克建业，定皇畿。\n皇畿定，举义旗。\n天兵百万任所之。\n东吴南汉西蜀七闽六诏从风靡。\n天下大定一戎衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其五 婺归德","author":"胡应麟","text":"天兵十万下东国，婺以先宁驻皇跸。\n景星荧荧耀城邑，我战则胜攻则克。\n四海从风靡弗一，势如破竹烽燧息。\n天命曷归归有德。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其六 四友","author":"胡应麟","text":"于维文王，是亲四友。\n疏附后先，以翼元首。\n峨峨高踪，异代曷有。\n天威是临，匍匐奔走。\n猗与圣祖，广延群雄。\n如天如海，为万物宗。\n王师所向，六合景从。\n爰率车徒，以定浙东。\n浙东底平，大统未集。\n蚤作暮思，思布文德。\n曰基曰濂，曰琛曰溢。\n玄纁奕奕，交布东国。\n曰四先生，论道经邦。\n坐而弗名，匡朕弗遑。\n呜呼盛节，庆流无疆。\n德六五帝，功百三王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其七 战鄱阳","author":"胡应麟","text":"明日大战战鄱阳，简师料徒百万强。\n烈风吹沙湖水扬，烟焰涨天焚大航。\n三十六将死康郎，再战湖口歼馀皇。\n我舟胶沙敌尚强，疾呼奋臂来冲撞。\n鲸鲵蔽空云日黄，拍江巨浪何茫茫，如血钜鹿尸昆阳。\n维天命我明，车轮碎螳螂。\n百矢定边背若芒，一矢贯睛谅死亡。\n谅死亡，理出降。\n威加四海，莫不来王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其八 盘门入","author":"胡应麟","text":"盘门入，士诚泣。\n前歌后舞大师集，兵不血刃下城邑。\n谁其帅者公魏国，归市弗止廛弗易。\n万姓欢呼颂皇德，二敌既歼皇之土东极。\n沧溟南亘楚长驱，入中原孰敢余阻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其九 降谷珍","author":"胡应麟","text":"方谷珍，起盗薮。\n乘元之乱，窃据一方地如斗。\n耗金币，大官酒。\n海上时时飞且走，如鬼如蜮鸡与狗。\n大明当空烛九有，举宗乞命窜海口。\n帝悯其愚印加肘，以较群雄最小丑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其十 七闽","author":"胡应麟","text":"七闽保岩阻，连亘皆山梁。\n友定据其巢，负固如金汤。\n我皇命将谕，谕以开茅疆。\n自谓故元臣，负义不肯降。\n王师十万下，戈船逐长江。\n兵入如破竹，如虎吞群羊。\n委身系尺组，支体磔分张。\n自谓故元臣，守节甘丧亡。\n大都以沦覆，谁为招国殇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其十一 维中国","author":"胡应麟","text":"维中国，帝王所自立。\n欃枪遍郊原，天地黯无色。\n天重开，地重辟。\n扶桑荧荧日月出。\n照八荒，烂九域。\n芟夷祸难四海一。\n神龙夹助正统集。\n帝悯边尘扰中国。\n诏下大将军，达副将军遇春提兵九十六万，戈鋋甲胄如浮云。\n命词臣濂草檄谕彼中华民。\n长驱入河洛，壶浆箪食来成群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其十二 大都走","author":"胡应麟","text":"元都平，四海清。\n神鬼受职万方庭。\n列大藩，置神京。\n汛扫烽烟混一区寓，再造华夏开文明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其十三 库库","author":"胡应麟","text":"察罕起元末，举代推鹰扬。\n天命去胜国，剚刃争战场。\n维库库，察罕子复良。\n下益都，伐洮阳。\n驱兵出没观以望。\n帝三谕，弥陆梁。\n执囚我行人，怒臂如螳螂。\n命大将，统武骁。\n北征陇右一战捣其巢。\n捣其巢，万骑突至如风飙。\n赖傅颍公却前茅。\n两军就舍不得交。\n夜分劫营，足纳一靴身骑骟马逃。\n骟马逃，绝大漠。\n我军四十万，胜负互相角。\n巨网漏吞舟，竟死蕃部落。\n帝称好男子，维库库。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其十四 升面缚","author":"胡应麟","text":"升面缚，出成都。\n母子哑哑啼路途。\n父旻玉珍一目枯。\n贪饕乱亡起雄图。\n不久身殉留遗孤。\n大明区寓至化敷。\n屡使遣谕如追逋。\n犷兵悍将骄相扶。\n骄相扶，守瞿塘。\n帝命颍国公东瓯王。\n伐山通道开战场。\n直捣阶文溃腹心，腹心溃，肝胆亡。\n母子舆榇大道旁。\n升也肉袒仍牵羊。\n侯以归义戒杀降。\n高皇帝德洪虞唐。\n唐高宋武如豺狼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其十五 北征","author":"胡应麟","text":"明受命，海宇一。\n前元馀属负固北庭保其宅。\n团结党类以俟我衅隙，为我子孙慝。\n皇帝遐思勿姑息。\n乃眷西顾以北征。\n桓桓大将，统兵亿万犁其庭。\n犁其庭，心胆落。\n单于遁，绝大漠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其十六 纳噶楚","author":"胡应麟","text":"纳噶楚，居金山。\n二十馀万众，虎视一何眈眈。\n帝命上公冯，统兵出全燕。\n天威所震慑，敌骑不敢驰，敌弓不敢弯。\n二十馀万众，一时赴长安。\n摐金伐鼓壮士欢，筑三受降玉门关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其十七 六诏","author":"胡应麟","text":"六诏天西南，惟滇号最钜。\n残元历数尽，遗孽犹虎踞。\n帝悯绝塞民，使命驰风尘。\n彼昏不奉诏，虔刘我信臣。\n皇赫斯怒命黔宁，艨艟巨舶浮昆明。\n昆明水涸歼长鲸，碧鸡金马入我版图四海平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟大明铙歌曲十八首 其十八 受天命","author":"胡应麟","text":"受天命，定四方。\n干戈偃，鈇钺藏。\n轶大武，驾成汤。\n媲轩辕，俪虞唐。\n扩地万里居中央。\n整齐万国开明堂。\n汉唐宋晋隋诸邦。\n絜功比德如蜩螗。\n万八千岁永无疆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]