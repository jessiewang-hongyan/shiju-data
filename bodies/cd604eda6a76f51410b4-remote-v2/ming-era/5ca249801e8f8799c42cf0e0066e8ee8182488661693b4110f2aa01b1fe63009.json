[{"title":"山中独行","author":"曹荃","text":"山石太嶕峣，孤行疑鲍焦。\n乱云钟外阁，细草涧边桥。\n立马欲相问，前人去已遥。\n麇麚飙忽影，碧落夜闻箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20893,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清源道中怀李虚谷处州","author":"龚勉","text":"晚天连远树，宿鸟各投群。\n清吹绕流水，征帆拂暮云。\n归程难预计，独酌易成醺。\n惟有怀人意，萧然坐夜分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20894,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王令泉武库出守永州","author":"龚勉","text":"仙郎戎政擅才名，简命熊幡向楚城。\n车骑旧瞻司马节，襜帷新识使君旌。\n九嶷南接湘江远，五岭东连粤路平。\n遥想行春风日好，瘴烟消尽百花明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20895,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"感事","author":"龚廷祥","text":"灵武中兴日，同仇共卧薪。\n勤王青海马，闲道白衣人。\n但恃江山险，都忘丧乱频。\n南朝歌舞地，醉杀后庭春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20896,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日游二泉书院","author":"过林盈","text":"策杖寻芳入幔坡，丹崖青壁五云多。\n文庄像下游人醉，忠定祠前逐客歌。\n苔藓不生新碣石，烟霞犹绕旧松萝。\n子规啼罢林莺语，万岁千秋一逝波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20897,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"希古社集","author":"黄学海","text":"吾尔复何求，惟知卧一邱。\n吹箫太古石，扫砚碧山秋。\n昨日花犹在，千年水自流。\n涧芳良可掇，谁与讨源头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20898,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"筑三里桥成","author":"顾懋章","text":"五里青山三里塘，水深病涉可无梁。\n千年顾港桥名古，土蚀残碑掩路旁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20899,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"遂初书院","author":"葛恒","text":"少从洙泗壁中寻，老恋龟山学愈深。\n悟到太初通六籍，春来青草是天心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20900,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林亭读书图","author":"葛恒","text":"岩岩松下石，泠泠涧中水。\n翼翼幽人居，寂寂众山里。\n闲亭蔼空翠，读书味玄理。\n荷锄时斲苓，缘流或采杞。\n感兹尘外踪，兴怀浩难弥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20901,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即席和敬修一绝","author":"黄禄","text":"乱插花枝在鬓边，花阴谈笑棹觥船。\n不须重订东君约，岁岁看花首夏前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20902,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登柳州城楼寄漳汀封连四州邓子厚韵","author":"黄禄","text":"垂老那堪谪远荒，凭高一望景苍茫。\n桄榔热雾迷官舍，薜荔阴云覆女墙。\n水散蛮溪分燕尾，路穿瘴岭转羊肠。\n同时沦落天涯客，白首何年返故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20903,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹石吟社开宴次纲庵韵","author":"黄禄","text":"云溪寂寞净无苔，泉上吟坛向石开。\n尘梦未醒春已老，山灵相唤客重来。\n酒筹不计看花饮，诗句难成待雨催。\n为惜残英久留恋，孤篷又向月中推。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20904,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"双溪","author":"华云","text":"莲蓉门外水悠悠，杨柳蒹葭岸岸秋。\n帆影两分青嶂雨，渔家一带白蘋洲。\n每疑杜老东西瀼，独放鸱夷远近舟。\n歌罢沧浪有余兴，济川功业可淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20905,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鼋头渚","author":"华云","text":"路入桃源九曲环，早春放棹碧云间。\n瑶台倒映参差树，玉镜平开远近山。\n片片峰霞开罨画，微微石溜起潺湲。\n胜游况值云霄客，共羡轻鸥去不还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20906,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"复碧山吟社和韵二首 其一","author":"华云","text":"黄公涧畔万松南，名胜流传径故谙。\n幽砌泉声随处响，双峰云影自相涵。\n赏心共向闲边会，空性都从静里探。\n徙倚檐前白日晚，一帘花雾对书龛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20907,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"复碧山吟社和韵二首 其二","author":"华云","text":"坐对山僧怅昔贤，春霞映日悟真诠。\n鸟啼当户疑闻法，花落闲阶不离禅。\n流水绿苔嗟世事，空山碧月断诸缘。\n一丘一壑冥鸿集，不负耆英胜始全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20908,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"祇陀寺","author":"华西颜","text":"古石桥平苔径幽，藕花白白竹修修。\n归来结宇松回指，趺坐谈经石点头。\n禅本虚空随物悟，心无仕着与天游。\n老夫久厌尘埃缚，拟借僧房过一秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20909,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重九日游惠山","author":"华西颜","text":"六年飘泊过重九，今对龙山看夕霞。\n黄菊正须浮绿蚁，白头羞见落乌纱。\n重冈北望无多地，五里西行有几家。\n亦欲强陪灵运屐，无钱陶令向谁赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20910,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"示从孙贞固","author":"华西颜","text":"栖碧久仙游，传家独宗韡。\n恂恂秉孝友，晦迹林后里。\n中年屏尘务，楮笔不停指。\n父书既成帙，家谱重经理。\n传芳继吾志，润色益精伟。\n时来较可否，议论恒亹亹。\n吾衰渐搁笔，二事终付尔。\n去取勿避嫌，录成须锓梓。\n后贤惜未见，慎勿轻弃委。\n玄真老渔樵，庞公绝城市。\n遗安良匪迂，荣达何足恃。\n他年传逸民，要亦知姓字。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20911,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次答明伯花下见怀之作","author":"华汝砺","text":"尚想风流醇酒卮，河阳今岂旧花枝。\n好携一片湖湘石，镌得新篇续旧题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20912,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"海天吟阁二首 其一","author":"华汝砺","text":"千古幽怀付酒杯，群公暇日此登台。\n雨余松翠侵一上，风暖荷香隔座来。\n醉后乾坤容潦倒，醒时湖海重徘徊。\n凭栏共拟登高赋，自愧应非王粲才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20913,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"海天吟阁二首 其二","author":"华汝砺","text":"高阁吟来赋钓矶，双双白鹭傍人飞。\n欲消繁暑须拼饮，故惜残花忘却归。\n四海风尘吾已老，一生落拓世仍违。\n绿萝不浅沧州趣，笑我从前迟拂衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20914,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送钱丈还凉州","author":"华宗韡","text":"十载从军两鬓霜，朅来仍整旧行装。\n关山迢递人千里，故旧殷勤酒一觞。\n投老不堪频作客，思亲拟合早还乡。\n班超功业须年少，付与诸郎奕世芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20915,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"四月情况殊不佳，勉强入市暴热","author":"华宗韡","text":"往事浑如梦，浮生良可叹。\n莺花愁里过，风月病中看。\n坐久腰如痛，行迟腿亦酸。\n时光顿炎热，未敢说求安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20916,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"得大儿书作诗寄之再寄大儿兴仁","author":"华宗韡","text":"花落深林晚，凄凉又一春。\n杖藜徐散步，卮酒不沾唇。\n无复繁华梦，空余老病身。\n裁诗强排闷，寄汝远游人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20917,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九月廿五夜枕上闻雨寄示兴仁兼简允庄弟","author":"华宗韡","text":"风雨潇潇夜，无眠忆远行。\n自惭衰老日，犹抱别离情。\n吉水舟初上，云阳月正明。\n来年春色好，准拟望归程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20918,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岁暮独坐书怀四首 其一","author":"华宗韡","text":"岁尽愁难尽，情深虑转深。\n生涯贫且贱，忧道古犹今。\n岂为求名论，空惭济物心。\n斯文如未坠，千载有知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20919,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岁暮独坐书怀四首 其二","author":"华宗韡","text":"斯道从先觉，新民亦古人。\n生逢汤武世，迹近许巢邻。\n俗务浑如旧，年华忽又新。\n一心能此念，万物即皆春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20920,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岁暮独坐书怀四首 其三","author":"华宗韡","text":"古来忧道者，往往不忧贫。\n己欲循天理，心惟济物仁。\n冰霜初入腊，梅柳已知春。\n人事难为力，林泉独善身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20921,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张师浩还梁溪忆四弟","author":"华宗韡","text":"故人归兴促行程，蘋末风生动客情。\n今夜梁溪逢舍弟，相思相望月同明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20922,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画次管玄伯韵","author":"华宗韡","text":"戴胜来时花正飞，鳜鱼出水荇初肥。\n五湖风月浑如旧，雨笠烟蓑竟不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20923,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦视先公","author":"华宗韡","text":"一绝趋庭二十年，年年春到倍凄然。\n光阴有限恩何极，报答无由岁屡迁。\n梦里音容浑似昔，人间故旧不如前。\n觉来犹记承欢处，涕泪交流落枕边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20924,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦先公自外而归","author":"华宗韡","text":"灯烛萦煌接父归，宛然昔日好容仪。\n解衣盛薄携班杖，放帽宽闲捻白髭。\n谒庙不忘循礼节，趋庭便欲问书诗。\n晨鸡唱断承欢处，不觉潸潸涕泪垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20925,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题沧浪轩","author":"华宗韡","text":"僻地幽栖野水浔，沧浪一派绕云林。\n光浮晓日含群动，风起寒窗听小音。\n虎豹纵横尘不到，鱼龙偃卧蛰还深。\n濯缨濯足非真趣，倚槛观澜洗我心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20926,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归故里","author":"华宗韡","text":"频年惜别恨萦怀，今夕还家笑语谐。\n共喜轩前仍有鹤，独怜坞内已无豺。\n西风发白人将老，东阁花红景又佳。\n愿尔自求多福祉，长留春色慰吾侪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20927,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"述怀","author":"华宗韡","text":"堪嗟老景病缠身，况复家居懒见人。\n石鼎煎茶浓当酒，茅檐曝背煖如春。\n乐天知命无荣辱，体道随时有屈伸。\n莫问浮生尘世事，相看又喜岁华新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20928,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题小蓬瀛","author":"华萚","text":"海上仙人钓六鳌，移山谁与傍南皋。\n层层洞户沧溟小，淡淡烟云峭壁高。\n渡口碧流通弱水，树头朱实熟蟠桃。\n登临欲约安期辈，共醉春风玉色醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20929,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题二泉书院","author":"华钥","text":"乾坤井井春常在，花石层层人自来。\n虚到竹心孤节耸，清如泉水百源开。\n昔贤共仰松风阁，故我难登点易台。\n昨夜梦魂寒月下，半庭香雨落江梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20930,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小春九日偶成","author":"华仲亨","text":"送客偶然出，归来仍掩门。\n青山当去路，黄叶满前村。\n幽赏已云足，浮生无可言。\n纷纷看归鸟，落日倚南轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20931,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日南园即事","author":"华仲亨","text":"山畔倚层楼，群公暇日游。\n竹深亭不暑，树密径先秋。\n幽鸟啼残梦，寒泉泻积愁。\n羲皇原不远，高枕此林邱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20932,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西园晚涉","author":"华仲亨","text":"为厌区中扰，而今物外情。\n日暄梅动色，风细竹无声。\n瘦石扶云立，疏杨傍水生。\n高楼供远眺，诗思陡然清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20933,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜再宿安茂卿西林次陈性甫韵却寄","author":"华仲亨","text":"丛林合沓隐丹邱，还指松头倚画楼。\n兰桨共移明月夜，绮窗遥对乳峰秋。\n阶前蟋蟀寒偏急，池上芙蓉晚更幽。\n寄语陈遵莫投辖，春来还拟复同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20934,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋杪徐太学邀游石湖时久雨初霁回舟复雨漫成","author":"华仲亨","text":"公车赋罢出长安，千里还家共岁寒。\n别去漫挥他日泪，相逢但说旧时欢。\n兰舟载酒乘秋晚，湖寺寻僧到日残。\n天为故人开霁色，近城风雨又漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20935,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"用辋川韵题画","author":"华叔阳","text":"逃名爱岩泽，一室面诸峰。\n月隐孤村树，云和远寺钟。\n溪声连断岸，垥影散疏松。\n合户斋心久，依然学老龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20936,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜雨","author":"华叔阳","text":"惊尘满目客愁多，忽而玄阴布太和。\n树色含烟云外合，竹声将雨梦中过。\n风传长乐添宫漏，气爽承明散玉珂。\n遥忆江南农事急，桔槔停处听讴歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20937,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"追和先君子九日斋居韵","author":"华复初","text":"忆昔长干道，登台雨正晴。\n长飙枫树远，独鸟大江清。\n柳巷三洲隐，芦花两岸明。\n当杯愁落木，揽古爱佳名。\n敢抱遗珠叹，难忘泣玉情。\n诸方来梵响，是处起歌声。\n紫蟹香粳饭，银鲈菰米羹。\n三秋怀鹤驭，十载记鸾笙。\n此日黄华早，悲风白露横。\n似闻华表语，翘首彩云生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20938,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送高静成先生之官黄岩","author":"华复诚","text":"十年交谊重相依，一夕离筵怅独违。\n已羡青春沾宠命，更怜彩服奉慈闱。\n地临海迥风尘后，花满山城案牍稀。\n为报鲸鲵休鼓浪，使君承檄正宣威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20939,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"灌园","author":"华善继","text":"未得餐霞去，还来学灌畦。\n杜门芳草绿，听雨药苗齐。\n世事看蕉鹿，心情问木鸡。\n接离休倒着，花下恐相迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20940,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中述怀","author":"华善继","text":"高城片雨外，倚棹乱蝉鸣。\n远树他乡色，浮云过客情。\n泉甘知早竭，木散得长生。\n悔逐时人后，空将骨肉轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20941,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨后","author":"华善继","text":"高树留残雨，层城带晚烟。\n炉香菰米熟，架满豆花鲜。\n未改狂奴态，还为长吏怜。\n不因公事暇，那赋白云篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20942,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春尽","author":"华善继","text":"即看春欲尽，渐觉客衣轻。\n燕以飞虫下，鱼因落絮惊。\n看云忘拙宦，对雨忆躬耕。\n最爱新移竹，清风叶叶生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20943,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"川上","author":"华善述","text":"亭午柳阴积，晴川聊可娱。\n舒荷已复敛，鸣蝉亦徐徐。\n目送东波逝，中有西上鱼。\n唯恐钓饵及，含意独踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20944,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再游惠山","author":"华善述","text":"山色炤西津，重来不出旬。\n虽言爱云石，只欲远风尘。\n泉水寒如昨，松花晚作春。\n九龙俱稳卧，去去莫攀鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20945,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游南禅寺","author":"华善述","text":"秋风郭外泊，落日寺中行。\n欲借空林意，聊移畏路情。\n阶虫惊客住，檐鹊代僧迎。\n雉堞如云近，还疑是化城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20946,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谒泰伯庙","author":"华善述","text":"三让身将隐，千家国亦偏。\n庙唯称至德，乡不讳先贤。\n卜洛无王业，归吴有墓田。\n县官修伏腊，野老记流传。\n风土变夷后，云山采药前。\n柱痕龙跃夜，松盖鹤栖年。\n阶藓乾秋日，炉尘幂暮烟。\n仰瞻遗像肃，端委尚依然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20947,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小除日署中祭先","author":"华元禔","text":"飘忽年华似电流，每瞻风木不胜愁。\n深惭禄养违初愿，敢谓名成喜壮游。\n异地岁时聊俎豆，故山霜雪冷松楸。\n清尳未酬肠先断，何日貤恩下帝州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20948,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闲居杂言用陶韵","author":"华师召","text":"经岁掩柴扉，端居谢尘鞅。\n身贱避贵人，齿衰绝妄想。\n有时入山中，素心共还往。\n乍见询寒温，杂坐无少长。\n争夸饮兴豪，不羡交道广。\n竟日鹿豕游，忘形其草莽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20949,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日同张池水公兼兄游惠山分得泉字","author":"华师召","text":"欲消长夏日，同试九龙泉。\n树远含初雨，云低结暮烟。\n峰巅双塔耸，石畔一僧眠。\n不尽登临兴，言归思渺然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20950,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠族侄","author":"华允诚","text":"当年草创水西堂，忠孝关情此日觞。\n一德赓歌荃泽久，三春报答棘心长。\n云深会有重离照，纲密其如千仞翔。\n最爱芝兰森秀色，早为家国兆祯祥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20951,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"绝命词","author":"华允诚","text":"视死如归不可招，孤魂从此赴先朝。\n数茎白发应难没，一片丹心岂易消。\n世杰有灵依海岸，天祥无计挽江潮。\n山河漠漠长留恨，惟有群鸥侔寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20952,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登惠山石门用谢康乐登石门最高顶韵","author":"华琪芳","text":"晨凌苍霭上，暮并山禽栖。\n一步一超忽，旷然睇清溪。\n苟非天所设，谁为积崇基。\n烟云入始阶，泉石破旧迷。\n士樵不同术，桃李非异蹊。\n茅茨来春风，亦有黄鹂啼。\n所以铅椠徒，守道贵不移。\n墙蒿抗岩柯，青条陵碧荑。\n太虚亦何心，气运无安排。\n君看方寸内，自有上天梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20953,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"丽泽堂","author":"华琪芳","text":"风雨弦歌地，天教吾道南。\n交从澹处久，义向静中参。\n得意鸟声悦，名言草色酣。\n雅歌能砭俗，何必假双柑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20954,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西畴课农","author":"华文钦","text":"已悔辞书卷，堪怜稼穑难。\n蝉吟三伏暑，雁阵五更寒。\n轻棹还飘泊，颓庐葺未完。\n自知通塞久，窗外鹊声干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20955,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上巳山中喜晴","author":"侯祖德","text":"杖履追欢赋遂初，酒饼犹自挂架车。\n雨晴山鸟能呼客，风暖林花亦启予。\n曲水流觞诗欲就，茂林修褉事非虚。\n只今四海兵戈偃，好觅人间种树书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20956,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鼎湖","author":"侯让","text":"鼎湖龙去不知秋，湖水依然入海流。\n仙杖凌虚嗟帝远，鸟号堕地是谁收。\n天空鸥鹭联翩起，波暖鼋鼍赑屃浮。\n西望崆峒重回首，白云千里去悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":20957,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]