[{"title":"重阳后六日登镜光阁","author":"陆深","text":"下方僧梵杂鸣钟，身上危阑复几重。\n微看太液波光净，更接蓬莱雨气浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西轩凿壁作南窗打炕其下以供夜坐","author":"陆深","text":"地炉煤火夜如年，旋作南窗映月眠。\n谁种庭中数竿竹，一时弄影到窗前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙子除夕","author":"陆深","text":"一枝银烛坐更阑，小几摊书只自看。\n家在江南四千里，有人今夜说长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二月望晨起","author":"陆深","text":"修竹深溪带浅沙，隔篱初见小桃花。\n东风最是无情物，却与人间管岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓起","author":"陆深","text":"雨洗春容淡有姿，柳丝花雾共参差。\n人家住在青山曲，无事朝来睡起迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂咏三首 其一","author":"陆深","text":"回廊曲曲面青山，身世悠悠蝶梦间。\n半郭半村秋色里，听风听雨夜深还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂咏三首 其二","author":"陆深","text":"竹阑干外石方塘，映月含风贮早凉。\n乞得名花周匝种，为谁着意最怜芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"园居杂咏三首 其三","author":"陆深","text":"芙蓉洞口石坡陀，橘刺藤梢带女萝。\n一夜好风吹雨过，晓来添起碧嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其一","author":"陆深","text":"绿杨如线草如茵，紫竹肩舆白叠巾。\n不是为春禁不得，老来心绪最怜春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其二","author":"陆深","text":"山中春色二分强，次第开花到海棠。\n风日一帘初病起，斜摊黄素写官方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其三","author":"陆深","text":"临池草阁背山堂，乳燕泥融补画梁。\n却按茶经试江水，自开阳羡阅旗枪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其四","author":"陆深","text":"种成修竹倚云看，新筑方塘漾翠寒。\n一夜落花风信急，隔溪吹折钓鱼竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其五","author":"陆深","text":"隔江楼阁郁岧峣，掩映繁花更柳条。\n红日半窗春睡足，独携藤杖过溪桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其六","author":"陆深","text":"上临风雨下尘氛，一上层台思不群。\n更爱草深成小坐，摩挲双眼看江云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其七","author":"陆深","text":"重重帘幕护馀寒，拓得兰亭映日看。\n颇觉近来诸念尽，偏于笔砚遣犹难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其八","author":"陆深","text":"久忘把镜照容姿，风动屏开见鬓丝。\n岩背好花浑未发，莫将春色怨迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其九","author":"陆深","text":"土作坡陀石作岩，晓乘甘雨种松杉。\n门前日日春潮到，定有双鱼寄一椷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其十","author":"陆深","text":"细雨庭除湿未匀，小山毛骨长精神。\n呼儿半捲湘帘坐，满涧飞花苦恋春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其十一","author":"陆深","text":"春深山馆日如年，品石尝泉各有缘。\n好客远从云外至，自移尘榻向花前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其十二","author":"陆深","text":"湘帘面面拥孤亭，雨弄春晴草更青。\n山静日长无一事，倚阑閒看鹤梳翎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其十三","author":"陆深","text":"高槐细柳俨成行，远水遥山护草堂。\n一片浮云飏空碧，半分寒气酿春光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其十四","author":"陆深","text":"侍儿日日报花开，白白红红尽手栽。\n我自白头春自好，莫教风雨便相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其十五","author":"陆深","text":"江上高楼隔晚霞，蒲团静结倚窗纱。\n暗香一道随风力，知是前村枳橘花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其十六","author":"陆深","text":"寂寂春阴江阁閒，绿浮新雨涨潺湲。\n隔花一犬足高卧，门外借书人未还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其十七","author":"陆深","text":"花傍高楼半掩扉，河豚风起钓鱼矶。\n沙鸥似解閒人意，时向蒹葭深处飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其十八","author":"陆深","text":"春江一曲绕孤村，鹤有双雏竹有孙。\n爱听沧浪临水坐，背人新月弄黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其十九","author":"陆深","text":"遥闻大药驻衰颜，我付行藏与鬓斑。\n多事一春眠白日，无言十里对青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其二十","author":"陆深","text":"漠漠杨花闹晓晴，穿帘入幕太多情。\n如何无力遮春住，点破沧浪万里清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其二十一","author":"陆深","text":"一溪一曲大江东，细柳新蒲窈窕通。\n寒食楼台三日雨，捲帘庭院百花风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其二十二","author":"陆深","text":"花木阴阴午漏长，迁莺啼近读书堂。\n谁能料理春多少，閒写新诗上粉墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其二十三","author":"陆深","text":"纸帐蒲茵白板床，秪将春睡答春光。\n梦中几曲溪南路，水浴风行总未忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其二十四","author":"陆深","text":"莺啼燕语各分明，最爱春声自物情。\n风送夕阳宾客退，一帘香雾浪纹生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其二十五","author":"陆深","text":"连宵草色雨中池，拂地垂杨压水枝。\n倦倚阑干检官历，忽惊春到已多时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其二十六","author":"陆深","text":"古意苍颜积渐肥，座中山色有馀辉。\n岸回细柳生绿暗，风送飞花深翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日杂兴二十七首 其二十七","author":"陆深","text":"杨柳蒹葭一色匀，江门日日弄丝纶。\n夜来新水强三尺，钓得龙湾六六鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南窗试笔砚二首 其一","author":"陆深","text":"紫阁花深吏散衙，肘悬金印净胡沙。\n山中亦有閒勋业，拓得兰亭上白麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南窗试笔砚二首 其二","author":"陆深","text":"减却尘缘六十馀，背山花木面山居。\n炉烟茗椀春风里，龙尾鸲睛自著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即景","author":"陆深","text":"江门日日弄扁舟，雨雨风风得自由。\n昨夜桃花新水涨，鲚鱼多在碧莎洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水涯","author":"陆深","text":"一里二里过头树，三株两株着眼花。\n东风一片閒心力，送绿添红到水涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中岁","author":"陆深","text":"中岁山林颇有情，柳条花萼弄春晴。\n目长无事江门外，独立斜阳看水生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书扇寄杨朝敬","author":"陆深","text":"一夜江门春水生，东风吹浪海云轻。\n从来不识王侯面，两两渔舟尽日横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和顾未斋韵寄郑山人二首 其一","author":"陆深","text":"暑雨初开江阁空，水芳摇动栋花风。\n新裁白苧明于雪，閒倚阑干送断鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和顾未斋韵寄郑山人二首 其二","author":"陆深","text":"萧萧竹院午风微，曲曲花篱宿雨稀。\n人向此时初睡起，海潮正上白鸥矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山间杂花","author":"陆深","text":"杂花冥冥岭云低，紫艳红芳各自奇。\n最爱午风吹作阵，杜鹃枝飏海棠丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月三日与客一绝","author":"陆深","text":"城外青山翠可餐，欲酬心约怕春寒。\n美人肯伴云中宿，为买青骢白玉鞍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至昌平与客月下看主人后园梨花","author":"陆深","text":"最爱梨花傍晚看，月光如水漾轻寒。\n为怜明日知何处，试借春风暂倚阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书扇赠棋士褚子高","author":"陆深","text":"阵马冲车次第行，触蛮蜗角总功名。\n山中尽日无人到，卧听松间落子声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题张氏南庄","author":"陆深","text":"鹤坡南望水如天，亦有人家似辋川。\n莼菜鲈鱼无恙否，几时来泛季鹰船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑞应堂留别所知二首 其一","author":"陆深","text":"世间好事一百一，春日丽辰三月三。\n此地故人还故国，他时江北望江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑞应堂留别所知二首 其二","author":"陆深","text":"四面有山皆入座，一年无日不看花。\n如何又踏朝天路，春水楼船漾浅沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南旺湖二首 其一","author":"陆深","text":"爱此长堤夹树行，北来乡土倍关情。\n青山白水浑相似，只欠提壶布谷声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南旺湖二首 其二","author":"陆深","text":"远水贴天霜破晓，微风无力摇枯草。\n青蝇不点烂银盘，湖上无山湖更好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题扇","author":"陆深","text":"秋满江亭生紫烟，纶竿稳泛木兰船。\n多情只爱芙蓉水，便得鲈鱼不卖钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"满林风雨图","author":"陆深","text":"山林何处无风雨，不似人情翻覆间。\n我有一区江上宅，几回蓑笠夜深还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和赵类庵题画鱼","author":"陆深","text":"天池咫尺候龙飞，荇带荷钱出水肥。\n神物自应多变化，长竿空傍钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"绝句","author":"陆深","text":"十年忧国鬓如丝，一路看山到武夷。\n信宿故园无限意，人情莫怪去迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆生归","author":"陆深","text":"天上青云白玉堂，子云辞藻擅长杨。\n因君并羡南归雁，海月江云入梦长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龟湖","author":"陆深","text":"湖绕青山候客归，暖风堪着芰荷衣。\n水中鸥鸟今无数，知傍閒人不肯飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿阳察院次壁间韵二首 其一","author":"陆深","text":"无心随处梦魂安，古柏台深五月寒。\n自笑青山老居士，松窗閒杀旧蒲团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入晋南关","author":"陆深","text":"丹崖倒浸一溪影，碧叶抽花十里香。\n最是闽中留客处，不知春尽度辽阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松隐为弋阳王","author":"陆深","text":"冒雪擎寒气转豪，遍身鳞甲五云高。\n自从不受秦封后，风雨年年长翠涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"草萍道中","author":"陆深","text":"老怀病目向秋风，江水西来湘水东。\n可是青山知好客，淡云疏雨翠微中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙窟二首 其一","author":"陆深","text":"江南泽国水风秋，彭蠡西来是上游。\n百尺楼船箫鼓发，和云冲过百花洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙窟二首 其二","author":"陆深","text":"白鸟斜飞水拍天，隔湖树色见风船。\n烟波只许渔郎惯，一任蓑衣枕月眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成 其一","author":"陆深","text":"曲曲筠阑雨乍乾，拍湖风酿海棠寒。\n不知乡思添多少，宽尽黄金旧带鞶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成 其二","author":"陆深","text":"官署红梅着花便，伤于雪怃然有述。\n因赠提学张静峰，佥宪谪广东提举。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成 其三","author":"陆深","text":"胭脂的的照疏林，蝶冷蜂寒春未深。\n一夜无端风雨横，朝来多少惜花心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘都阃送菖蒲","author":"陆深","text":"虎须戟戟映窗纱，劲气孤标露有华。\n见说仙灵通九节，夜深清梦伴梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病愈","author":"陆深","text":"细煮参苓拥弊裘，满城风雪送春愁。\n下帏强作还家梦，蝴蝶冲寒不过楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起独坐东堂","author":"陆深","text":"斜倚绳床落照东，一帘秋意捲西风。\n金丹换骨谁曾见，欲起衰颜借酒红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有数燕递营一窠若人之伴工然者偶成","author":"陆深","text":"湖上云开水漫波，绿阴庭院昼清和。\n梁间燕子如呼侣，相伴衔泥垒旧窠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乘月行定州道中有怀表弟顾世安","author":"陆深","text":"绝爱丰标玉有烟，故园分袂已多年。\n如何今夜春宵月，辜负金台共被眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄河南岸见梨花二首 其一","author":"陆深","text":"烟消露湿斗轻盈，梨花枝枝如有情。\n分付东风莫吹尽，道旁留照夜深行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄河南岸见梨花二首 其二","author":"陆深","text":"粉痕香晕雨初乾，惆怅芳心怯晓寒。\n忆向小楼吹铁笛，湘帘十二捲朱阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新野道中","author":"陆深","text":"隆中迢遰汉江滨，辇路风吹阵阵春。\n二十四番今第几，莫将花信寄閒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居八首 其一","author":"陆深","text":"十旬高卧画楼东，曲曲阑干面面通。\n远暝欲成梅子雨，晚凉初动楝花风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居八首 其二","author":"陆深","text":"人间何处无风雨，老去才情减十分。\n半月不曾梳白发，薰笼添火暖香芸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居八首 其三","author":"陆深","text":"水云烟月市桥西，菱角荷钱已满溪。\n读罢黄庭三百首，人家茅屋午时鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山居八首 其四","author":"陆深","text":"倚空楼阁枕西郊，新筑方塘漾柳梢。\n忽有山童报奇事，一双孙子鹤成巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]