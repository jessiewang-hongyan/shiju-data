[{"title":"哭龙君御诗 其三","author":"袁宏道","text":"多少人间死，于君特怆神。\n玄言从此尽，白日奈何春。\n礼法雠狂士，乾坤侮俊人。\n再来如有意，莫见宰官身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹤林寺和尚","author":"袁宏道","text":"竹里逢开士，花间觅著书。\n禅观今果足，文字往因馀。\n听雨知鱼乐，开轩任柳疏。\n自怜婴世网，敢复事空虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中","author":"袁宏道","text":"莫自夸强项，逢人且折腰。\n微生信坎止，作吏也逍遥。\n山月领归棹，江云凑晚潮。\n古来差快意，唯有一王乔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同江进之登金山 其一","author":"袁宏道","text":"白浪三千顷，苍岩二十盘。\n鲛人分夜火，龙女给晨餐。\n潮涌天难定，地孤石也寒。\n由来多胜迹，草里读碑残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同江进之登金山 其二","author":"袁宏道","text":"宝楯千年碧，炉烟镇日青。\n穿藤逢石怒，倚险嗅波腥。\n鼋过吞人影，潮来念佛经。\n幽期如可订，住此学沉冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡太湖","author":"袁宏道","text":"野树澄秋气，孤蓬罥晚晖。\n渔舟悬网出，溪叟载盐?。\n山叠鹦哥翠，浪驱白鸟飞。\n暮来风转急，吹水溅行衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泊西洞庭","author":"袁宏道","text":"白浪浸天冷，青山引黛长。\n朝童迷水怪，夜女出江黄。\n种橘皆成市，凿山半作堂。\n路疑烦指点，洞口觅渔郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东山晚望","author":"袁宏道","text":"转厌人间少，翻愁大地空。\n石枯山眼白，霞射水头红。\n浪恶惊三老，鱼稀祭五风。\n奇峰探不尽，点点乱流中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乞归不得","author":"袁宏道","text":"不放陶潜去，空陈李密情。\n有怀惭狗马，无路达神明。\n竹影交愁字，莺啼作怨声。\n但凭因果在，陨血誓来生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪宦","author":"袁宏道","text":"薄宦经年许，心精好欲慵。\n诗书攻俗讳，耳目信尘封。\n生女从呼囡，学音渐是侬。\n令吴何所有，震泽两高峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初杜门","author":"袁宏道","text":"一笑挥铜绶，高眠諀部民。\n放风疏垢发，信懒著闲身。\n吏省公移字，堂清案牍尘。\n静居堪养性，州郡但劳人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋居戏题","author":"袁宏道","text":"深入终防饵，高张远避罗。\n课儿书上字，听客唱吴歌。\n检药神方少，疏经悟语多。\n一枝生计足，五斗奈人何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏柬江进之","author":"袁宏道","text":"作令真成累，全身总是归。\n道傍春自谑，人里鬼相依。\n缓系牛皮带，宽披燕子衣。\n云霄终有翼，学取一行飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惜日","author":"袁宏道","text":"芳树低檐浅，游丝绕户牵。\n闲情观秘戏，消日坐枯禅。\n范蠡藏身险，庄周入梦颠。\n浮生如石火，何物可长年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"任意吟","author":"袁宏道","text":"解带腰肢免，投闲意态疏。\n纵心搜乐事，信口择群书。\n万物齐非马，千仙饱壁鱼。\n有名终是累，无用可还虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荒园独步","author":"袁宏道","text":"寒食春犹烂，东风草自芊。\n花燃无焰火，柳吐不机绵。\n宦博人间累，贫遭妻子怜。\n一官如病旅，直得几缗钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起","author":"袁宏道","text":"病起心情太，閒来礼法疏。\n愁听传事板，懒荅问安书。\n不去终惭鹄，无才合类樗。\n何如逃世网，髡发事空虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜起","author":"袁宏道","text":"凉月穿纱见，微风响树来。\n夜虫亲火语，窗鼠触明回。\n生卧凭书遣，行藏作谜猜。\n终宵眠不得，无计缓愁哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"袁宏道","text":"嵇叔终疑傲，陶潜总任真。\n祗因啚事简，不敢恨家贫。\n宦邸为欢少，乡书报死频。\n弥天都是网，何处有闲身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独坐","author":"袁宏道","text":"胸臆知难尽，行藏未可陈。\n摊书嫌字小，烹水试茶新。\n拨闷占茅卜，祈归拜上神。\n闲云与倦鸟，终是一流人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"述怀","author":"袁宏道","text":"岁月无停晷，迁流快织梭。\n寐来趋夜壑，老去皱恒河。\n悟法东西祖，藏身大小何。\n一沤能几许，枉自著愁多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和江进之寒山寺之作 其一","author":"袁宏道","text":"山寺依人境，乘闲且杖藜。\n好花营地种，熟鸟认枝栖。\n洗钵防茶老，开轩碍竹低。\n西来空有义，记取鹁鸠蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和江进之寒山寺之作 其二","author":"袁宏道","text":"忍草侵阶遍，慈云湿座飞。\n爱花僧是业，伺食鸟成机。\n一榻书和卷，三生钵与衣。\n尘劳方未已，合掌愿皈依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏同江进之坐孙内使池台感赋 其一","author":"袁宏道","text":"竹隐千花径，亭开卐字栏。\n银塘骄水鸭，罗幄护风兰。\n邸报传来闷，民膏到处难。\n东南供费极，不忍更周残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏同江进之坐孙内使池台感赋 其二","author":"袁宏道","text":"细果亚枝重，垂藤拂幔低。\n檀烟薰睡犬，松子食雏鸡。\n情鸟雄雌狎，名花姊妹齐。\n繁华终有气，端不似山栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登阳山","author":"袁宏道","text":"巉石蹲如象，枯松驳似鳞。\n鹤仙何处是，龙母果然神。\n穴有能言兽，岩多不语人。\n吴宫零落尽，踪迹果谁真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮徐参议园亭","author":"袁宏道","text":"古径盘空出，危梁溅水行。\n药栏斜布置，山子幼生成。\n攲仄天容破，玲珑石貌清。\n游鳞与倦鸟，种种见幽情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠江进之 其一","author":"袁宏道","text":"苑花经四果，门柳近千枝。\n年俭迟君俸，官贫独我知。\n痛民心似病，感事泪成诗。\n不是催科拙，由来薄茧丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠江进之 其二","author":"袁宏道","text":"数叠铜符篆，一挥案牍尘。\n宾朋嗔事简，妻子怪官贫。\n德畏民无狱，道治鬼不神。\n知君本仙令，家世武陵人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠江进之 其三","author":"袁宏道","text":"窥铜怜貌减，裹鬓觉霜欺。\n乡语青奴误，官情白鸟知。\n佳儿能问字，小妇与填词。\n解得庭中乐，闲官亦可为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠江进之 其四","author":"袁宏道","text":"几年名茂宰，艳冶古长洲。\n霸气吴宫尽，涛声震泽秋。\n花深苑作国，人去馆为楼。\n箫管家家曲，那能不醉侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠江进之 其五","author":"袁宏道","text":"端居持简体，吏隐见仙才。\n案牍皆诗料，纷庬入酒杯。\n横乌移卯去，灵鹊抱巢来。\n一见逍遥作，知君笑口开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠江进之 其六","author":"袁宏道","text":"债子今应长，钱儿久不神。\n簿书行流水，参佐拥空尘。\n蓄古频分客，题诗每向人。\n退斋修竹里，盆沼漾文鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠江进之 其七","author":"袁宏道","text":"尝胆经时苦，劳薪几日休。\n秃须黄印绶，芒履黑平头。\n簿领分从事，腰肢恼督邮。\n可怜人似玉，赢得发如秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠江进之 其八","author":"袁宏道","text":"专诸遗旧剑，西子变新娥。\n国大游民聚，时清艳事多。\n炫城花似面，络地水如罗。\n团扇前溪上，吴娘唱子歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44497,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丘长孺 其一","author":"袁宏道","text":"不问南和北，都成故与新。\n放开双孔眼，阅尽一时人。\n言语谁同味，肝肠孰最真。\n金陵居可买，是否作佳邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44498,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丘长孺 其二","author":"袁宏道","text":"横金米如珠，洞庭春似雪。\n只恐君不来，君来我当设。\n酒可供千人，米亦勾三月。\n君来当即来，明日吴令发。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44499,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张伯起","author":"袁宏道","text":"两年稀面见，一字到官疏。\n白石连云煮，青芩带雨锄。\n尊前红拂传，花下古钗书。\n兄弟多名理，何山故不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44500,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曹以新","author":"袁宏道","text":"踪迹人间冷，生濡一世疏。\n近花安酒曰，避雨约床书。\n文雅王元美，清夷孙太初。\n长庆名不死，有子亦为馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44501,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张幼于","author":"袁宏道","text":"家贫因任侠，誉起为颠狂。\n盛事追求点，高摽属李王。\n鹿皮充卧具，鹊尾荐经床。\n不复呼名字，弥天说小张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44502,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"皇甫中璋","author":"袁宏道","text":"爱客常投辙，登盘必市鲜。\n茶烹无色水，香炼不燃烟。\n高十披先传，稽勋拾旧编。\n藤花缭閤子，点点缀青钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44503,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘子威 其一","author":"袁宏道","text":"盛事推弘正，高才足雁行。\n丹台函姓字，石鼓筮文章。\n管库名伊吕，闭门读老庄。\n时贤零落尽，天壤一刘郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44504,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘子威 其二","author":"袁宏道","text":"山居忘甲子，玄想證无生。\n天意私高士，人间瑞老成。\n文章不死药，形体岁星精。\n避世羞藜火，桃灯传五行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44505,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"县斋孤寂时曹以新王百谷黄道元方子公见过有赋","author":"袁宏道","text":"宦向清时懒，囊添旧日贫。\n琴孤行赠客，鹤惯不疑人。\n怕死归婆子，休官谢鬼神。\n寒云流日影，震气赤鳞鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44506,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题方子公蓼莪馆","author":"袁宏道","text":"小筑依蒿里，高篇寄蓼莪。\n天空犹堕雪，垢苦不生萝。\n夜月呼山鬼，秋坟咽楚歌。\n近轩多古柏，攀折泪如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44507,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁暮即事","author":"袁宏道","text":"兰焰添灯重，花光簇夜红。\n綵枝閒玉剪，金帖冷屏风。\n宦意如霜草，乡心折晚鸿。\n谁能学少女，眉画入时工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44508,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕同王百谷皇甫仲璋方子公衙斋守岁","author":"袁宏道","text":"懒贴宜春字，聊为卒岁歌。\n官能客脱网，客喜不张罗。\n始觉门如谢，刚惭肉似何。\n江湖新管领，一径白云多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44509,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日述怀","author":"袁宏道","text":"客署闲花事，乡心醉柳条。\n闭门春草长，高枕白云骄。\n牛马呼仍在，鹍鹏路已遥。\n有田堪种米，罄折笑前朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44510,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日方子公对奕","author":"袁宏道","text":"三百争驰道，十千讣赌钱。\n屠苏惭得后，奕品僣居前。\n花锦添新日，霜毛减少年。\n谁能黑白里，悟得远公禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44511,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"述怀","author":"袁宏道","text":"种树先芝桂，裁衣度薜萝。\n敝图悬祖炳，败絮拥妻罗。\n丘壑驰驱甚，玄虚色相多。\n市朝无拘管，何处不渔蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44512,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病痊","author":"袁宏道","text":"病合当求去，宦情非是阑。\n与其官作病，宁可活无官。\n腰膝皆相贺，妻儿亦自驩。\n高堂垂万里，谁与说平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44513,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨","author":"袁宏道","text":"转觉云沉重，翻疑天苦辛。\n横将无厌两，淹杀有情春。\n山作龙钟貌，花如失意人。\n百钱一斗米，谁与贷官贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44514,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿惠山僧房 其一","author":"袁宏道","text":"小阁寒灰火，清香古佛颜。\n潮来吹雨叶，云起叠山鬟。\n白恰随人指，青峰送客还。\n红尘触处到，长日下幽关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44515,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿惠山僧房 其二","author":"袁宏道","text":"排遣何曾达，思惟亦是尘。\n病翻为乐果，发在是愁因。\n松老皆成佛，花清亦避人。\n禅栖如窦许，色色可怡神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44516,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初晴","author":"袁宏道","text":"暾日迟迟影，和风淡淡新。\n山微舒态度，柳小足精神。\n宗测当如祖，梁鸿竟傍人。\n欲从游客饮，除里觅纱巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44517,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成 其一","author":"袁宏道","text":"世事怜贪饵，同群怖独翔。\n摊书时引梦，临水或思乡。\n兄弟皆丘小，山林之日长。\n行藏细检点，多半是襄阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44518,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成 其二","author":"袁宏道","text":"佛大刚盈尺，山高也避尘。\n时时闻戒定，法法遇贪嗔。\n竹粉遗天女，松脂食道人。\n南能休借阅，即汝是前身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44519,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成 其三","author":"袁宏道","text":"羁客胸怀少，天涯侣伴稀。\n未须愁独立，终是念归飞。\n云来吹水叶，潮去落沙衣。\n酷忆湘江上，梅花伴钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44520,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄江进之","author":"袁宏道","text":"吏老心尤苦，才清调转孤。\n花飞常乱押，梅气欲侵符。\n旧俸开来否，新粮勾也无。\n政成须勉强，尺步是?途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44521,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉兴道上过古寺","author":"袁宏道","text":"金尽沙为地，竹枯水过篱。\n龙池蛙带子，佛顶雀衔儿。\n古迹钱王是，残经宋代疑。\n道旁龟剥落，草里卧丰碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44522,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉兴道中","author":"袁宏道","text":"弥野桑成市，排溪柳作衙。\n菜香齐吐甲，树煖欲蒸花。\n天色滑如卯，江容润似纱。\n酒帘青带日，三五聚邹家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44523,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过龙井示德舟禅人","author":"袁宏道","text":"数盘行井上，百计引泉飞。\n画壁屯云族，红栏蚀水衣。\n路香茶叶长，畦小药苗肥。\n宏也学苏子，辨才君是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44524,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮湖心亭","author":"袁宏道","text":"便可无方丈，何须说洞庭。\n虽云旧山水，终是沾丹青。\n浓淡妆常变，天乔性亦灵。\n白波千丈许，众好湖心亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44525,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵隐路上 其一","author":"袁宏道","text":"柳缕时常罥，花溪不断飞。\n因寻涧底水，忽过树傍扉。\n面熟逢僧问，心闲数客归。\n沿流多石趾，尽可作渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44526,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵隐路上 其二","author":"袁宏道","text":"柳光吹绿焰，溪雨作红烟。\n花气蒸云熟，石纹带乳鲜。\n闻香知草性，随例与茶钱。\n淡冶应无比，幽奇亦可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44527,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵隐路上 其三","author":"袁宏道","text":"细鸟伤心叫，闲花作意飞。\n芳蹊红茜雨，古涧绿沈衣。\n艳女逢僧拜，游人缓骑归。\n幸随真寔友，无复可忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44528,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过灵峰","author":"袁宏道","text":"冥漠烟如醉，空濛日带青。\n有山兼有涧，宜榭复宜亭。\n避客愁云热，拜僧怕佛灵。\n无心竖拂子，随意举莲经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44529,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过龙井","author":"袁宏道","text":"都说今龙井，幽奇踰昔时。\n路迂迷旧处，树古失名儿。\n渴仰鸡苏佛，饥参王版师。\n因循坐谷口，欲去复还疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44530,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"去湖上","author":"袁宏道","text":"浪迹西湖上，儿童问总知。\n能言出入处，及与往来期。\n不忍题归字，终难滞许时。\n眼前虽别去，只恐病相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44531,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天真书院阳明讲学处","author":"袁宏道","text":"百尺颓墙在，三千旧事闻。\n野花粘壁粉，山鸟煽炉煴。\n江亦学之字，田犹画卦文。\n儿孙空满眼，谁与荐荒芹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44532,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初至绍兴","author":"袁宏道","text":"闻说山阴县，今来始一过。\n船方革履小，士比鲫鱼多。\n聚集山如市，交光水似罗。\n家家开老酒，只少唱吴歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44533,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]