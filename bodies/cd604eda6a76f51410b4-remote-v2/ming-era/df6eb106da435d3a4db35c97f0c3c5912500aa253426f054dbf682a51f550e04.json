[{"title":"秋日郊寺访客酌谈","author":"尹台","text":"细雨城南寺，开尊对落晖。\n青山依幔入，黄叶映杯飞。\n野迥尘沙净，烟深草树微。\n林坳驻安马，取醉欲忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滕县道中","author":"尹台","text":"滕阳三百里，大地捲沙霾。\n不辨春阳气，能胜旱暵哀。\n柳长伤碧乱，草涩阻青回。\n试问东蒙北，何山可剪莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州龙山亭宴集","author":"尹台","text":"胜地标龙久，危亭借鹤传。\n长河当槛入，乱岫袅空悬。\n日月珠林外，风云倚席前。\n此方多难日，匡济赖诸贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"时数日不雨宴亭中乃忽交澍喜甚有作","author":"尹台","text":"出郭时云合，登山好雨来。\n旱愁开仆御，春色起楼台。\n唤叶啼鸠聚，冲花舞燕回。\n群公鞠疚日，此地畅樽罍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨集少山水部新轩","author":"尹台","text":"水部新轩敞，芳樽映雨开。\n竹枝交乱草，花片渍深苔。\n檐溜洪梁落，槛峰禹碣来。\n相将娱夕暝，豪意豁深杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜过宝应湖作","author":"尹台","text":"楼船贪夜涉，积水径长湖。\n片月悬明晦，疏星澹有无。\n烟浮鲛客素，波涌汉妃珠。\n遥指维扬树，苍苍暝色孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云居寺燕集","author":"尹台","text":"云居通凤岭，石阁转香台。\n一径听钟入，数峰迎户开。\n湖光摇绮席，天色倒金杯。\n向夜繁星动，高歌未拟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"啸严寺泊","author":"尹台","text":"维舟依古寺，解缆下幽源。\n花发渚烟聚，草青江雨繁。\n鱼梁交石屿，鸟路界山村。\n坐羡垂纶者，看云过晓昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"普门寺","author":"尹台","text":"普门层嶂里，独径隐崔嵬。\n宝积烟霞聚，香林日月开。\n盘山亘地出，汉水划天回。\n注目桥陵远，苍苍冥雾来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"淳于髡墓","author":"尹台","text":"叹息淳于叟，奇谈往籍留。\n操豚辞近狎，饮鹄辨真游。\n坏墓藏山曲，行人指道周。\n无由听炙輠，时鸟自啁啾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"习家池","author":"尹台","text":"习氏池犹在，山公驾岂来。\n豪贤空往旧，耕种已亭台。\n曲槛鸣泉落，危梁叠石摧。\n寻幽聊驻马，暝色下苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"羊侯祠","author":"尹台","text":"叔子晋仁人，政乃郑侨似。\n和邻敌止侵，戢境民安理。\n祠比召南棠，颂流汉曲水。\n千秋岘首碑，泪堕襄人士。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巴陵道中","author":"尹台","text":"晓发巴陵道，冲泥突锦鞯。\n雾飞翻作雨，石出屡回泉。\n露坼池荷损，风披岸槿捐。\n物情尽摇落，吾意竟谁怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湘阴道中","author":"尹台","text":"来往三湘遍，真成感倦游。\n烟开林影乱，日出鸟声稠。\n草木惊时变，光阴荡客愁。\n所思渺天未，不见祗离忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出资阳赴武冈道中二首 其一","author":"尹台","text":"合沓千峰里，轻舆鸟背还。\n山花交乱石，硖竹袅奔泉。\n岩合疑无径，林开忽有天。\n永言辞俗鞅，自卜挂冠年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出资阳赴武冈道中二首 其二","author":"尹台","text":"屡回山谷阻，时复得幽村。\n路转松杉密，疃开芋秣繁。\n人烟通绝岭，草树豁高原。\n莫问桃花水，前溪亦武源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃花洞","author":"尹台","text":"桃花开几许，客至槲林深。\n洞豁天门霁，岩垂石阁阴。\n秦人家岂在，阮客路空寻。\n坐忆青霞髓，翻悬王烈心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李泌宅","author":"尹台","text":"旧宅迷黄叶，荒基隐碧岑。\n昔贤遗迹在，流水暮烟深。\n石拆悬蛇径，云霾伏虎林。\n相唐垂大业，终此遂初心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7146,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孤山林和靖墓","author":"尹台","text":"处士孤坟在，疏林映水开。\n湖山千古丽，诗句几人裁。\n鹭渚寒烟积，鱼梁晚照来。\n梅花飘欲尽，谁为扫荒苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"栖霞岭谒岳武穆王墓","author":"尹台","text":"元忠瞻异代，巨庙倚高坟。\n痛矣英雄事，悲哉战伐勋。\n金牌飞白日，铁戟断黄云。\n劲气号松柏，犹疑叱咤闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"祗谒孔林二首 其一","author":"尹台","text":"罔极怀夫子，瞻思向墓林。\n寝宫寒日閟，隧路古云深。\n尚想奠楹梦，空传曳杖吟。\n斋心共蘋藻，聊以荐居歆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"祗谒孔林二首 其二","author":"尹台","text":"世远松楸换，神游剑履藏。\n秋阳无改暴，梁木自兴伤。\n报德崇千代，修禋暨百王。\n侧观孤桧色，遗慕窅难忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高斋","author":"尹台","text":"高斋轮鞅绝，独卧碧云幽。\n山气青常润，湖光澹不流。\n脱巾临竹屿，展席向花丘。\n去此寻真境，尘嚣安可求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"居然亭","author":"尹台","text":"地出青莲宇，亭开碧槲林。\n明湖澄静影，峭壁偃孤阴。\n雾窟黄熊性，烟波白鸟心。\n从来豪达慕，不受世笼侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"藕花居","author":"尹台","text":"藕花亭子好，乃在水中央。\n万树菩提色，千池菡萏香。\n綵云流绮幄，珠雨散瑶房。\n此际江妃曲，应遗汉水璜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"见山","author":"尹台","text":"幽人昔解绶，草阁赋归来。\n嗒尔帘栊启，悠然烟雾开。\n晴光分径竹，晓色下阶苔。\n不尽东篱意，千岩秋气回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙游除夕","author":"尹台","text":"迢迢游客子，岁暮感山川。\n鼓角流残夜，星河转旧年。\n扁舟寒水侧，故国白云边。\n未展经时志，孤心魏阙悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送龙良卿使淮藩十四韵","author":"尹台","text":"诏使辞天阙，仙槎渺汉津。\n炎风吹驿路，赤日转轺轮。\n藩冑尊贤礼，天王展懿亲。\n元仪开墄陛，恤制降丝纶。\n驷马中朝节，輶轩上国宾。\n题桥誇昔柱，聘席感前珍。\n树引江帆色，花迎綵服春。\n红颜归锦昼，白发倚门晨。\n晓梦占鱼笋，秋思入鲙莼。\n驱驰千里道，忠孝百年身。\n怜我迹兹滞，因君泪满巾。\n瞻云亭屺岵，步月感参辰。\n每叹朋俦隔，徒怀原隰询。\n若行逢桂树，愿迟晚攀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李司成之留雍十二韵","author":"尹台","text":"帝宅金陵峙，儒垣璧水开。\n川遗秦凿迹，山隐晋临台。\n槎汉通南斗，文星出上台。\n阳城真士范，李白信仙才。\n日月鳌宫丽，风云虎观回。\n誉髦归德造，狂简藉成裁。\n六义经帏展，三长史局推。\n论恩终楮薛，侍从陋邹枚。\n赤绂皋比拥，丹心衮职陪。\n金镛登笋簴，玉驭待龙媒。\n时序玄驹变，江湖白雁来。\n愁心牵饯引，惆怅对深杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送欧经历赴绍兴幕十韵","author":"尹台","text":"会稽天下郡，彊服夏王开。\n海望通秦道，山形引越台。\n霞峰天姥峻，雾涧若耶回。\n地讶屏分合，人疑镜往来。\n云沙张吏幕，花鸟傍仙杯。\n丽域东南擅，英僚俊乂陪。\n名车应选御，巨室合抡材。\n岸鹢微风柳，江蝉细雨槐。\n愁心牵畏简，梦思引循陔。\n若暇登官阁，无忘何逊梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德州李主政濯缨亭集","author":"尹台","text":"使君堂左侧，一径转幽森。\n地阻青林僻，亭开碧水深。\n薄遗投绶意，因寄濯缨心。\n邃廨稀人入，名园得独寻。\n官閒从岸帻，客至罢鸣琴。\n偶访谐沾席，交欢展盍簪。\n云霞流晚憩，虫鸟助秋吟。\n水尽蒹葭色，风疏柿栗阴。\n烟霜行色变，时序旅愁侵。\n短剑晶荧气，哀丝幻眇音。\n淹留成剧坐，感慨扼雄襟。\n愤世思长往，怀贤惜所钦。\n有才谁逮古，无力岂忘今。\n去矣吾焉适，怀哉此滞淫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"毛进士使边得省十二韵","author":"尹台","text":"勍敌窥三辅，元戎练五兵。\n纡筹劳圣主，献画满神京。\n鸟旆黄云合，鱼书白日征。\n三秦忧转饷，六郡募横行。\n贾谊单于组，终军关吏缨。\n时危矜战绩，世难耻儒名。\n捧檄毛生志，扬舲祖逖情。\n未辞邛邑驭，敢问朔方旌。\n梦远蛟龙泽，愁深骠骑营。\n空怜新竹笋，徒泣旧庭荆。\n入里梧飘井，归朝柳媚城。\n葵心知抱赤，好向太阳倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘生东田赴南昌因讯水洲诸公","author":"尹台","text":"怜君豪俊士，白首弊儒冠。\n旅食燕京市，长歌行路难。\n一毡仍独抱，双剑向谁看。\n漫拭芙蓉匣，还吟苜蓿盘。\n匡诗颐自解，董赋志堪叹。\n薄宦元饶隐，微名不累官。\n西山长户牖，南浦任波澜。\n若过逢梅尉，为余讯勉餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林明府谪官金陵","author":"尹台","text":"长安木叶下，匹马问何之。\n去逐南鸿迅，行将北燕随。\n风沙从弋缴，岁月任轩楣。\n毛羽宁论铩，绦笼固可辞。\n沧洲吾道得，旧国宦游宜。\n六代豪华迹，三山缥缈思。\n别怜歌玉树，赠欲把瑶枝。\n童稚情亲日，江湖岁晚时。\n相逢聊此地，后会定何期。\n若见羊何侣，新篇慰我知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送文学赵先生归致兰溪八韵","author":"尹台","text":"湛湛瀫江水，东驰严濑长。\n昔贤遗遁迹，故里有辉光。\n世远人文振，风高道术扬。\n前元诸子奋，今代数公昌。\n有美师模抗，翻然士帜张。\n众方观作止，我独辨行藏。\n豹息元依雾，鹙饥秪慕梁。\n送君禾浦上，何异别山阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江太孺人寿诗","author":"尹台","text":"二月花欲然，莺声上苑传。\n暖萱初媚日，慈竹已含烟。\n门集仙人履，堂陈寿母筵。\n珠翘娱景丽，綵服戏春鲜。\n宅住云霄里，尊开日月边。\n招邀青鸟驭，玩诵赤鸾笺。\n箓受华存秘，教成孟博贤。\n驻龄垂八十，累行载三千。\n汉史东征赋，鲁诗閟颂篇。\n古来阴化助，遗述重彤编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈给事赴守卫辉十韵","author":"尹台","text":"送君淇上去，我思积如何。\n五马郊原别，三年谏疏多。\n吴干缠斗气，魏阙阻关河。\n目断天山箭，心悬渤峤波。\n指庭轩后草，挥日鲁阳戈。\n往事嗟难问，新诗行自哦。\n一麾兹出守，八使昨催科。\n宿赋诛曾免，疲氓病孰摩。\n鲁公流昔颂，廉范听今歌。\n逖矣吾焉讯，尺书迟雁罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送大司寇笠翁先生赴召北上十四韵","author":"尹台","text":"紫匦传新命，彤轺发旧京。\n三垣卿月丽，五夜法星明。\n鼎业光儒术，彝功阐帝纮。\n祯符占贯索，泰纬应阶衡。\n祖席郊关展，离弦渭唱并。\n怀贤怜汉佩，惜别咏河缨。\n亭晚吴天豁，江秋蜀涨平。\n挂帆云出浦，倚棹月临城。\n淮树行相引，徐山若处横。\n鲈莼乡思剧，鸿雪旅情惊。\n白闼悬珂影，朱扉听履声。\n祥刑钦吕德，淑问想皋名。\n岁晏松筠劲，霜寒葭菼鸣。\n何时尺笺堕，一诵慰平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元潭观追忆旧游作","author":"尹台","text":"雪浪阁前草树春，十年重过一沾襟。\n到来剡曲迷新棹，老去延平失旧津。\n岁月岂应尘里度，烟霞自向梦中亲。\n追思未待山阳笛，祗对清江已怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答张主政镗赠别之作","author":"尹台","text":"乞归忻荷帝纶颁，作赋何须效子山。\n耕陇自看新犊长，钓船时引旧鸥还。\n惠庄谈辨六经外，臧谷功名一笑间。\n老矣无心问谁是，曳藜聊共片云閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠建宁刘丞余尝过其家","author":"尹台","text":"十年不采衡阳杜，千里知哦建曲松。\n闽雨几沾金騕袅，岳云长护玉芙蓉。\n交游向识茅容异，语笑何时程本逢。\n四十年来湘水别，高楼曾复卧元龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿郭平翁八十诗","author":"尹台","text":"藉甚先朝献纳臣，一麾江海谢熊轮。\n论交忆侍彤扉入，论道惭违黄发询。\n八十就言归耇俊，三千曳履盛儒绅。\n应吟抑训当盘几，卫武方箴欲耄身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿三塘老人","author":"尹台","text":"老筑林间半亩庐，三塘云物在巾裾。\n向人且试岐俞术，医国应存素难书。\n肘后丹经聊自检，山中瑶草正纷如。\n何当启我长生诀，拂袖阆风戏紫虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题宗室瀑泉","author":"尹台","text":"西山千尺之洑流，注作瀑泉散九秋。\n万古烟霄飞玉练，一天星斗缀珠旒。\n东平善以涓涔积，河间经兼浑灏求。\n掬勺清沦堪自濯，底须雁荡玩灵湫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄谢豫章诸士友","author":"尹台","text":"岁月虚惭老斲轮，江湖聊复寄垂纶。\n久甘樗散藏幽迹，忽拜瑶华感故人。\n隋珠幸向骊渊得，燕石空兼鱼目陈。\n稷下雕龙谁似者，南洲风义薄高旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七十自寿","author":"尹台","text":"抱柝夷门齿谬同，谁堪黄发应非熊。\n朝廷俊宅充多士，社稷匡扶倚数公。\n散木自甘丘壑卧，非材岂任栋梁崇。\n能词吉甫叨承系，愿诵中兴二难功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答大宗伯董用均","author":"尹台","text":"平生秘迹华阴求，苦忆昔年张益州。\n旧省愧同何劭入，扁舟忻共李膺留。\n松陵月上青菰晚，苕水波翻紫稻秋。\n他日相思期结社，休文传有故时丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中别用均学士有怀","author":"尹台","text":"南省几伤道阻长，西清一别秪相望。\n何期苕水朱弦思，并入松陵白雪章。\n千里神交劳远忆，十年儤直感同行。\n故情杯酒应难述，此日怀君意可忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泷江别一崖奉常阳溪侍御一首","author":"尹台","text":"不见旧交今十年，相思泷水隔长烟。\n奉常节引金舆侧，御史书持玉几边。\n老去谈经匡鼎废，别来辞疾杜冠捐。\n飞腾宦达成何事，笑折晴花舞醉筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿陈氏学易堂作","author":"尹台","text":"一入泷溪坐此堂，俨然尘意濯沧浪。\n无言自识先天画，有梦浑游太古乡。\n泽豹文章成雾蔚，神龙变化蛰渊藏。\n虚帘长下同严肆，隐几应知异坐忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次答文江曾中丞枉讯二首 其一","author":"尹台","text":"老向中林习掩扉，荒村车马过从稀。\n偶乘剡水扁舟兴，来玩舂陵朗月辉。\n几日春风双榻对，千山暮雨一帆归。\n新章更枉场驹问，始幸沧洲蚤拂衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次答文江曾中丞枉讯二首 其二","author":"尹台","text":"九折摧车忆蜀门，每因叱驭笑王尊。\n秪随白鸟忘争席，敢拟青牛学著言。\n勇退乞身元不易，倾危视舌亦何存。\n也知衣白终堪相，肯向羊裘卧钓纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同诸讲友会社堂遂游梅田洞有作","author":"尹台","text":"锦林寒叶洒新裘，石户高开少皞秋。\n遇过稷亭谈白马，贪依函谷驻青牛。\n中天秘室仙人隐，异代真符使者求。\n老幸歌游长此地，不知尘世隔丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留馀堂诗","author":"尹台","text":"留馀堂在碧川浔，绮构高开紫桂林。\n一自烟霞辞凤隐，几惊风雨动龙吟。\n窦公教擅庭贤盛，荀氏家承世德深。\n共羡石涓遗嗣矩，犹传宋语作心箴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芝林诗","author":"尹台","text":"毗山秀挺芝煌煌，千林气吐云雾苍。\n绮皓出安鸿鹄计，商岩长咏凤鸟章。\n金茎夜渍三危润，玉菌朝含五曜光。\n不用仙经篆图牒，硎山霅水纷流祥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙子元日述怀","author":"尹台","text":"糟粕从谁问斲轮，支离七十又逢春。\n生逢四圣休明世，仕列三朝礼乐臣。\n老向星辰忘听履，病将舟楫寄垂纶。\n子房本乏神仙骨，白发能抛乌角巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忠爱堂诗","author":"尹台","text":"御史大夫之故堂，飞甍杰阁森层冈。\n春深燕雀纷成鷇，岁久云霞仍倬章。\n有美闻孙承奕泽，思恢哲祖振华光。\n新悬丽扁昭前学，我咏斯干颂世昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西苑春晴","author":"尹台","text":"暖气先浮太液舟，晴光渐度上阳楼。\n蚕宫雨霁桑犹稚，谷社烟和草乍柔。\n地静云霞依御宿，春深鱼鸟迟宸游。\n豳歌逸训传丰镐，丽日长瞻圣藻流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五日侍宴龙舟应制","author":"尹台","text":"綵仗葳蕤交帝苑，翠华缥缈拂仙台。\n芳辰箫鼓中流竞，元峤风烟竟日回。\n好鸟过林迎步辇，新花隔水照行杯。\n叨从燕镐观宸豫，不向横汾羡汉才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋对月","author":"尹台","text":"四海秋期逢此夕，九霄月色对长安。\n堪怜委地金波动，未厌沾衣玉露寒。\n兔影才生云母帐，蟾辉忽烂水晶盘。\n悬知永夜关山外，鼓角风凄万幕看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送苍梧令","author":"尹台","text":"五岭风烟接九疑，苍梧形势控南陲。\n一尊此送弦歌宰，万里谁驯鸾鹄姿。\n象郡久艰秦篚贡，交州犹动汉旌旗。\n丈夫才力须兼济，作吏寻常讵汝期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送史簿调阳江","author":"尹台","text":"三年岭县琴书僻，万里炎荒剑舄孤。\n沙草乍辞彭蠡雁，江花又送海陵凫。\n阴阴古雾迷铜柱，炯炯寒冰映玉壶。\n鹅水于今歌节操，看君高义过文儒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]