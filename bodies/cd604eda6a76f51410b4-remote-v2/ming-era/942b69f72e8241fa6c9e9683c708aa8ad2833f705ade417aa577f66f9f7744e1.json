[{"title":"答曾启东文学","author":"卢龙云","text":"樗散才名愧豫章，燕金敢自叹留良。\n寒馀渐见生春色，暗里谁凭识夜光。\n迟日煖浮千树晓，条风和动百花庄。\n栽培羡尔多桃李，茅茹还看应会昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之临朐答大司马王公赠别二首 其一","author":"卢龙云","text":"绿野堂前醉别觥，春林好鸟自嘤嘤。\n不同赋鵩忧时命，却喜登龙署姓名。\n此日孤琴随鹤远，他宵明月怅乌惊。\n祇应有待开东阁，会听彤墀曳履声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之临朐答大司马王公赠别二首 其二","author":"卢龙云","text":"投赠慇勤且复留，江湖何地不堪忧。\n四愁未若孤臣切，一顾难忘国士酬。\n暖入东风碧草细，烟消南浦绿波浮。\n华夷自昔知司马，即拟安车下帝州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答王之绥","author":"卢龙云","text":"漂泊怜君义独高，小斋曾与读离骚。\n莫愁沈约频移带，拟赠王祥有佩刀。\n春水五渠江路渺，暮云千里客心劳。\n长吟两地空相忆，多暇应难似马曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江应雷偕诸太学追送余苏家桥暮酌有赠答和二首 其一","author":"卢龙云","text":"柳色青青思独劳，霸桥星聚五陵豪。\n已因别赋分玄草，更遣离愁付浊醪。\n并马尘轻苏市雪，歌骊声散苑家涛。\n公车此日需贤哲，谁解诗成得锦袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江应雷偕诸太学追送余苏家桥暮酌有赠答和二首 其二","author":"卢龙云","text":"握手徘徊却为君，旅中那不念离群。\n探春预约花为主，入社何妨酒并醺。\n两地复悬千里月，长途遍历万山云。\n欲知别后相怀处，驻马题诗日正曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答车一中","author":"卢龙云","text":"异乡为客混风尘，薄宦相从似买邻。\n世态共看思往事，主恩初下及孤臣。\n蛾眉渐老应难妒，鸡肋微名岂遂湮。\n汉室谈经推董相，早将三策为君陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答王司封","author":"卢龙云","text":"客舍并州岁乍更，长途匹马又东征。\n腰肢自觉虚徇禄，奔走由来只为名。\n北海尊罍思旧处，春风岐路别君情。\n微才敢附山公启，祇笑嵇康是懒生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答郭茂才二首 其一","author":"卢龙云","text":"几年奔逐愧飞黄，去矣怜君酒一觞。\n但使高台收骏骨，何言末路有羊肠。\n徘徊别意看新柳，淡荡春风入野棠。\n后会不知何处是，每依北斗望龙光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答郭茂才二首 其二","author":"卢龙云","text":"杯酒临岐别友生，一时去住却关情。\n恩仍凤阙随新牒，义似鸡坛恋旧盟。\n芳草王孙游渐远，绿波南浦雨初晴。\n上林托猎君应赋，得意还能荐马卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"百丈厓在东镇沂山","author":"卢龙云","text":"海上岧峣拥翠回，当霄壁立势雄哉。\n青春洞口犹含雪，白日泉声似带雷。\n天造故悬千尺险，地灵何藉五丁开。\n诸峰罗列俱难比，不尽浮云任去来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瀑布泉在百丈厓","author":"卢龙云","text":"缥缈丹梯最上头，何来千仞泻飞流。\n初疑银汉从天下，忽讶沧波倒峡浮。\n草木春回馀作润，江山人藉此相留。\n红尘久负登临兴，沾洒欣从物外游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏宴集迟中丞别墅时牡丹盛开","author":"卢龙云","text":"莫道春归独掩门，春光还在百花村。\n几丛蝶舞留芳径，数啭莺歌住短垣。\n傍槛故多姚魏品，招游何减李桃园。\n公馀雨霁烟霏净，恰好移樽坐晚轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李张二郡博二首 其一","author":"卢龙云","text":"问月曾同李谪仙，风尘去住感流年。\n翻从异地思联榻，犹记芳樽恋别筵。\n海上兵戈烽未息，天涯朋旧梦相悬。\n八行欲寄加餐字，搔首云间一雁还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李张二郡博二首 其二","author":"卢龙云","text":"薄宦栖迟旅思劳，故人谁与问绨袍。\n长吟渭北天边树，未识玄都观里桃。\n旧雨不堪诗伴隔，荒台曾共月轮高。\n此时对酒空相忆，何处天风下玉璈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登朐山","author":"卢龙云","text":"雨足芳郊万绿齐，看山携伴过前溪。\n云閒杖屦花迎入，日永壶觞鸟劝提。\n比屋喜逢鸡犬静，公庭那有簿书迷。\n不妨取醉成高会，共听流莺自在啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读旌孝录为故郡大夫杜公作","author":"卢龙云","text":"早年射策向明光，疆项归来一草堂。\n善养岂嫌三釜薄，承恩偏幸百年康。\n庭前爱日斑衣永，冢上居庐白发长。\n使者几回劳博采，圣恩今已下龙章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答云中吕观察","author":"卢龙云","text":"锁钥云中久借恂，秋风戎马净边尘。\n登楼坐啸千门月，挟纩长留万里春。\n拙宦我甘随牒远，忘年君自托交神。\n已闻公府资为宪，伫见天书下紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄高比部","author":"卢龙云","text":"风尘漂泊海东方，翘首金茎路渺茫。\n青社赐环栖傲吏，白云题柱忆仙郎。\n赋才合迩西山色，谳奏能消六月霜。\n不分清曹多燕暇，几时握手近含香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀广武诸旧游","author":"卢龙云","text":"一别丛台隔两秋，漂零身世海东头。\n伤心往事俱流水，屈指当年几旧游。\n投赠我惭青玉案，索居谁问黑貂裘。\n此时广武城边月，正好同君大白浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答梁茂才二首 其一","author":"卢龙云","text":"何处新诗念旧裁，忽传尺素傍愁开。\n几瞻岭外云边树，犹记尊前月下杯。\n泉石祇怀寻壑侣，风波宁有济川才。\n于今夜夜看南极，遥见光华入望来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答梁茂才二首 其二","author":"卢龙云","text":"五岭群峰万叠高，思乡无奈寸心劳。\n吟边桂树非南国，梦里梅花似法曹。\n每愧登仙追景倩，空怀纵壑颂王褒。\n十年自历羊肠遍，牢落风尘一敝袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜宴吕观察新宅时侍者奏塞上曲","author":"卢龙云","text":"堂构初成燕自来，几人今夕对传杯。\n微风却暑娱清夜，细雨生凉引绿醅。\n坐客总深碧玉调，塞儿新制紫云回。\n休嫌近市仍湫隘，数武阶前且植槐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱使君寄寿老母赋答","author":"卢龙云","text":"忆别河梁越岁华，云山千叠总为家。\n芳樽已隔吟边月，彩笔犹传梦里花。\n自引斑衣娱爱日，难将春酿拟流霞。\n遥闻双白重开宴，几颂南山庆倍嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题益津八敌台","author":"卢龙云","text":"提封千里尽春台，又见崇台面面开。\n云物迥连天阙下，股肱独近帝城隈。\n霞光睥睨飞常入，烽色萑苻净不来。\n自是修文非讲武，登高时有大夫才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题杨中丞思亲楼二首 其一","author":"卢龙云","text":"背郭重新百尺楼，楼前霜露迥生愁。\n辞荣不羡千秋观，善养曾轻万户侯。\n馀庆祇看归绿野，浮生何处觅丹丘。\n每瞻堂构思贻翼，却喜传家解作裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题杨中丞思亲楼二首 其二","author":"卢龙云","text":"一上高楼思悄然，片心长在白云边。\n蓼莪最引终天恨，岵屺难忘爱日年。\n锡命几回瞻拜阙，承欢但欲赋归田。\n至今明发怀如旧，强对开帘月万川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望京楼和张中丞二首 其一","author":"卢龙云","text":"极目楼头望紫烟，梦回宫阙思悠然。\n蓬莱地隔鸿书渺，阊阖天高象魏悬。\n万国衣冠同拜舞，当年江汉忆旬宣。\n于今独抱葵心在，欲奏南山第几篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望京楼和张中丞二首 其二","author":"卢龙云","text":"江湖幽思近何如，天畔楼孤望帝居。\n御苑春饶莺语合，仙茎露下雁来初。\n悬车尚忆齐鸣佩，闭阁惟耽自著书。\n此际经纶看世业，升平俱沐圣恩馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"常比部谳狱关内事竣还朝时方露祷无以酌别赋此代觞","author":"卢龙云","text":"青青城畔柳条新，折向河桥赠远人。\n行部霜飞三辅肃，归朝花发五陵春。\n亦知枌社情偏系，可奈桑林念转频。\n明到宵衣如召对，不须重拟大东陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏过冯将军别墅","author":"卢龙云","text":"将军池馆即仙家，万木森森野水涯。\n入户且须先看竹，开樽还似坐餐霞。\n林间晓色多啼鸟，帘外风香有落花。\n岂厌升平虚抱武，耽幽长自对瑶华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠泉","author":"卢龙云","text":"何处青山海上浮，浮来山下是龙湫。\n一潭滉漾沧浪色，万颗匀圆合浦流。\n深竹况宜逃暑会，野航真作弄珠游。\n与君坐对冰壶澈，可道无因尚暗投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠张司理","author":"卢龙云","text":"楚材钟岳自衡阳，射策声华满建章。\n诏下九重辞北阙，官持三尺莅东方。\n随车待遍千家雨，谳牍看消六月霜。\n闻道圣朝资献纳，更须丹笔侍虞唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答易山人送腊","author":"卢龙云","text":"春前淑气将舒柳，腊尽馀寒已送梅。\n愁里酒杯添寂寞，病来诗句废敲推。\n年光荏苒真虚度，宦业逡巡岂上才。\n羡尔久盟泉石侣，赏心何限白云隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠寺谒李忠简公遗像","author":"卢龙云","text":"钟祥曾道应星光，岭海仍流异代芳。\n忠赤有心悬疏草，勋猷何意在旂常。\n提戈自障鲸波险，请剑宁辞鸟道长。\n遗像清高瞻拜肃，珠江犹自胜桐乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠俞参军","author":"卢龙云","text":"何来趋府擅才华，绿水池边几度花。\n走檄名高谁具美，请缨年少自堪誇。\n三城钤辖归油幕，五岭风云护绛纱。\n文武一时推妙选，湛恩仍待早宣麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韩公祠祠在西樵山上公名雍时总制两广奏免茶税山人德之后为中官所谮引疾乞归卒谥襄毅","author":"卢龙云","text":"一径穿云入翠微，中丞祠庙出林霏。\n诛求榷吏恩能逭，采摘山家愿不违。\n力食总馀君子泽，绣裳真念小人依。\n春来处处茶畦雨，彷佛甘棠露未晞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白云洞","author":"卢龙云","text":"岩岩翠壁倚天开，冉冉閒云度壑来。\n野瀑细流成曲水，石床积润带苍苔。\n芳亭岁引看山屐，纡径时同避暑杯。\n贪赏夕阳天忽晚，又从云里戴星回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甘棠税驾卷为杨兵宪作","author":"卢龙云","text":"车骑重看到海乡，褰帷夹道旧甘棠。\n几年蔽芾依留荫，此日澄清慰奉尝。\n故老短筇瞻节钺，使君新绶并银黄。\n关西世泽应长在，更普商霖下大荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送袁敬德游勾漏","author":"卢龙云","text":"欲问丹砂事有无，采真何必惮长途。\n三江乍泛袁宏舫，五岳新携向子图。\n紫气东来星是客，碧云西望月同孤。\n如闻葛令当年诀，分取刀圭到药垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"听莺","author":"卢龙云","text":"雨后千林翠欲流，春馀高柳绿偏稠。\n迁乔野外声初巧，求友枝间意独幽。\n闭户不禁司马渴，出门堪并少陵游。\n笙簧满耳听难尽，徙倚同消万斛愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄答张山人","author":"卢龙云","text":"何来双鲤傍江干，三径如同仲蔚看。\n佩以蕙兰芳泽远，诗成珠玉夜光寒。\n人从斗色知龙剑，君为鸥盟恋鹖冠。\n愧我浪游虚岁月，东篱犹负落英餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赈荒后为吴令公作","author":"卢龙云","text":"东南民力久堪怜，菜色何曾似近年。\n老稚不禁途有殍，流离多是突无烟。\n三城未下蠲租诏，十郡都烦劝赈钱。\n此日孓遗方记忆，江头曾挽令公船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新兴姚明府封母","author":"卢龙云","text":"板舆亲奉出苕溪，三载分符粤岭西。\n十郡循良推异等，孤城辽绝托卑栖。\n霜含荐牍腾乌府，天动褒书下紫泥。\n燕喜北堂歌寿母，忘忧今见集全褆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题瑞龟桥","author":"卢龙云","text":"百尺虹桥截海成，何劳驱石到东溟。\n群游尽讶无天险，异迹还徵有地灵。\n河上欢声齐万户，洛中馀瑞协千龄。\n几人壮志能题柱，此地堪留驷马亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠康星士","author":"卢龙云","text":"百钱都市未全贫，华发飘飘白氎巾。\n眼底乾坤堪玩世，壶中日月好藏身。\n心从知命应逾彻，口到谈天类有神。\n若向尘埃先物色，十年曾已识平津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚泊","author":"卢龙云","text":"野人常占白鸥沙，今夕同舟对落霞。\n鸿雁几声停客棹，蒹葭一水望仙槎。\n风含露下炎蒸散，月拥潮平逸兴加。\n何处鸣榔听不尽，推篷真乐在渔家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿杨民部兼送寿卮","author":"卢龙云","text":"汉庭积贮念司农，粤社诗盟有国工。\n客自歌狂休叹凤，人从慕弋不惊鸿。\n黄花栗里初三径，丛桂淮南旧八公。\n赠尔飞觞供载酒，问奇多过草玄雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送金兵宪起复","author":"卢龙云","text":"四海年来羽檄频，宵衣长念?兵臣。\n松楸故里心难系，节钺中朝命转新。\n庾岭梅花迎客旆，蓟门芳草驻征轮。\n不知何地当除拜，到处苍生望紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题邓氏孝友堂","author":"卢龙云","text":"风教从谁仰范模，义门今在凤山隅。\n君陈本自心为政，公艺何须忍作图。\n堂构功高人并美，棣兰色秀晚全敷。\n由来召顺膺多福，试听斯干颂岂无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠王别驾时署县有荐","author":"卢龙云","text":"才名共仰三川旧，治行咸推百粤先。\n郡以分猷看展骥，邑缘试剧待烹鲜。\n霜含白简俱称最，春满黄堂各颂贤。\n珍重佩刀酬解赠，君家元沐主恩偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈司训膺奖","author":"卢龙云","text":"璧水谈经道已尊，霜台飞檄誉兼存。\n苏湖教化新移俗，邹鲁诸生并在门。\n桃李风前争自媚，鹍鹏霄际待齐骞。\n讲堂喜报三鳣兆，何厌阑千苜蓿盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽易山人","author":"卢龙云","text":"冬来犹及寄双鱼，岂道翻成绝笔书。\n壮志未能周五岳，残编谁为惜三馀。\n岁寒祇自荒松径，龙卧何因叩草庐。\n欲拟山阳思旧赋，不堪闻笛却愁予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送周方大读书清城兼寄朱少襄","author":"卢龙云","text":"家学濂溪逮紫阳，传经嗣业喜重光。\n渊源道脉流俱远，伯仲交游意并长。\n两岸莺花春气象，一江烟雨客衣裳。\n主人旧约飞泉胜，乘兴因君思欲狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王明府调任龙门","author":"卢龙云","text":"已看骑竹慰儿童，复有宣麻下汉宫。\n飞舄未论天近远，分符宁限地西东。\n讴歌渐起鸣琴外，悲怨翻传别调中。\n何事山城偏借寇，萧条榛莽入春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送方伯胡公入贺","author":"卢龙云","text":"福星才照粤江头，又报乘轺入帝州。\n喜慰邦人新四岳，言修岁事古诸侯。\n陈谟金鉴臣心展，咨牧纶麻上意优。\n杼轴大东看若此，可因前箸动宸旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高正甫比部还朝时谳狱江北便道归省","author":"卢龙云","text":"白云仙吏下蓬莱，笑索扬州雪里梅。\n作伴青春来昼锦，承欢綵服映霞杯。\n琼枝乍见庭阶集，芳草翻从驿路催。\n到处汀洲新绿满，喜供吟咏达金台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"佘处士六十初度从子孝廉来索寿诗","author":"卢龙云","text":"江上春明二月初，东风吹绿满閒居。\n鸟窥寿席歌相答，花映斑衣锦不如。\n蜗角懒看尘俗态，蝇头翻阅少年书。\n竹林小阮欢多洽，更喜潘园并导舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠张医官张家世淮阳其术兼明太素","author":"卢龙云","text":"淮南丹术旧称良，羡尔传为肘后方。\n海上不须求大药，壶中已自胜长桑。\n阴功岂但千人活，国手无容二竖藏。\n察脉况知荣悴理，似闻七发尽飞扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赵司教报满赵柳州人其门下杨生索诗为赠","author":"卢龙云","text":"十年曾记柳江湄，折柳樽前赠别离。\n望远星高荀氏里，怀人春满谢家池。\n鱼鸿异地风尘渺，桃李山城雨露私。\n最喜弹冠将及代，鳣堂遗事总堪期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何太学入京","author":"卢龙云","text":"秋到炎消海上天，新凉堪引孝廉船。\n向来珠树依三秀，此去金茎待四迁。\n藉藉才名芳水部，寥寥经术老菑川。\n中朝自有山公在，姓字都从启里传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何茂才游太学","author":"卢龙云","text":"握手秋江送画船，为君初赋远游篇。\n三朝故事青箱习，千里轻蹄赤汗鲜。\n翡翠明珠方贡越，黄金白璧重游燕。\n京华到日思何逊，谁遣梅花笛里传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶州谢使君考绩","author":"卢龙云","text":"江流曲抱九成台，冉冉芙蓉夹岸开。\n山郭但逢廉叔晚，苍生终赖谢公才。\n心劳雁泽荒为政，诗劝雌堂暇自裁。\n报绩九重先赐玺，徵书还自日边来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]