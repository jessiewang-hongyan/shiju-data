[{"title":"之京留别祁羡仲诸子","author":"卢尧典","text":"江亭酒尽晚烟浮，漂泊人操小小舟。\n接地月明疏雨后，隔溪渔唱夜潮头。\n素衣总与缁尘惯，佳句能支道路愁。\n他日京华千里梦，雁书迟尔慰登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入大藤峡","author":"卢尧典","text":"独拥鹴袍思渺茫，断蒹衰草共苍苍。\n人家出没层崖合，客路潆洄乱壑长。\n明月自怜当我独，青山如解笑人忙。\n浮生尽是翩翩草，何事烟波滞异乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒孝廉陈公绚墓","author":"卢尧典","text":"寂寂玄扃列古松，高冈若斧已成封。\n凭枝挂剑非无札，载笔争铭尚有邕。\n梦去终教魂化蝶，泉中应比尔为龙。\n天怜伯道遗犹子，寒食馀钱岁自供。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游海珠寺","author":"李韡","text":"渺渺昙花映座光，周遭石槛绕沧浪。\n居如龙树趺为坐，水似曹溪挹亦香。\n向晚落霞浮栋宇，有时白月度慈航。\n表贤原是瞻依地，暂借祇林一咏觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日","author":"梁绍震","text":"风高千户晓，云静九天开。\n把酒聊随俗，占年一上台。\n野梅催岁色，好鸟唤春来。\n坐看江潭父，得鱼吹笛回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经灵洲山","author":"梁绍震","text":"金山山月下，清夜洞门开。\n说法林猿听，焚香野鹤回。\n欲寻苏学士，更上妙高台。\n怅望情何极，难将客思裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀丛桂社中诸子","author":"梁绍震","text":"惜别春吟少，神交夜梦多。\n六年三黜后，一日五噫歌。\n鸡黍堪同约，羊求可并过。\n蓬蒿满幽径，其奈美人何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋兴","author":"梁绍震","text":"梧桐飞叶帝城隈，正是寒期素节催。\n玉女吹霜摇碧落，仙人擎露在蓬莱。\n时闻作赋凌歊馆，追忆相从戏马台。\n晋宋风流俱寂寞，登临怀抱向谁开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登飞来寺","author":"梁绍震","text":"满眼红尘苦不开，抠衣聊此暂徘徊。\n云山叠叠安禅地，花雨重重说法台。\n古洞旧传猿化去，残碑犹记寺飞来。\n苍茫往事俱成幻，落日凭栏思转哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送丁山人游粤西","author":"梁绍震","text":"家住飞云最上头，别君长笑出罗浮。\n吴松不入山人梦，辽鹤常随野客游。\n彩笔浪吟虚白社，黄金买醉倚青楼。\n玉姬歌罢无持赠，采采芙蓉八月秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠萧良有良誉赴春官","author":"梁绍震","text":"双凤翩翩薄汉飞，九苞殊色占文辉。\n大苏逸调天成独，小阮高华世所稀。\n入眼已知呈白璧，点头行复见朱衣。\n上林春色鲜如锦，同趁花香近紫薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"半月岩","author":"梁梦鼎","text":"我爱月岩胜，月岩胜若何。\n半轮通窍久，千里共明多。\n影到天南地，光涵海北螺。\n骑鲸直上者，更得一枝摩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"开岁十日同李计部唐尚宝奉陪诸郡公南岩落成二首　 录一","author":"章曰慎","text":"小结山亭石径斜，探幽飞盖入烟霞。\n平临坛寺三千界，俯瞰江城十万家。\n槛外徘徊看海色，樽前笑语落天花。\n古瀛文物从今盛，仙迹禅栖未足誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉和徐心翁使君枉过南岩小酌留题佳韵","author":"章曰慎","text":"西郭南岩岁几登，月台风榭此时兴。\n中丞镇蜀推严武，小队看花过少陵。\n父老喜瞻熊是轼，迂疏故道寿为朋。\n留题剩有如椽笔，取醉何妨酒似渑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉和庄致庵贰守留题小洞之作","author":"章曰慎","text":"逍遥林壑逢春日，缥缈干旌度水村。\n访古扪萝穿石径，探奇移席傍云根。\n澄湖十里牵诗兴，暝色千峰落酒樽。\n况是登高能作赋，才名孰与大夫尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日承诸郡公招同李仰山唐曙台泛舟西湖用前韵 其一","author":"章曰慎","text":"春日临门快一登，桃花新水浪纹兴。\n自缘容接过元礼，岂有才华似茂陵。\n锦绣江山侯作主，林泉麋鹿我为朋。\n饮醇一滴心堪醉，何况兵厨酒似渑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日承诸郡公招同李仰山唐曙台泛舟西湖用前韵 其二","author":"章曰慎","text":"胜地滥陪冠盖客，方舟同泛水云乡。\n西山雨霁岩峦秀，南渚风回兰桂香。\n片石崔巍题雁塔，长桥缥缈锁鱼梁。\n他年回首旧游处，两岸棠阴逗夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺","author":"钟于田","text":"寺倚山烟碧，僧閒绀殿西。\n已知天地别，曾否佛肩齐。\n白日浮生梦，青云石道梯。\n探奇吾独得，垂老欲幽栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登舟见月怀乡友","author":"钟于田","text":"春日花开祖道前，秋风人上潞河船。\n红尘易变干时发，新月殊明故国天。\n四顾江山犹昔日，一分襟袂即经年。\n玉楼两地光辉满，南北相思益渺然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自叹","author":"钟于田","text":"归去来兮归去休，为园瓜果未全收。\n膏肓久矣甘泉石，筋力何因困马牛。\n莫问韶光如逝水，总之人世只浮沤。\n百年便作千年计，不待西风也白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏楼居督诸子馆课","author":"钟于田","text":"潦倒无心问郭田，小楼风入抱书眠。\n河清有几人为瑞，酒熟能酣浊是贤。\n但以一经传世业，不妨双鬓引馀年。\n从来稽古高门第，可负韶光却自怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"行行重行行","author":"郑学醇","text":"别离在万里，依依梦故乡。\n道路阻且艰，引领遥相望。\n音尘久断绝，寤言怀忧伤。\n蟾蜍怀故土，騊駼思旧疆。\n欢爱人自好，忧思人自老。\n少壮能几时，相须苦不早。\n思君会无期，焉得不枯槁。\n勖哉崇明德，令名以终保。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青青河畔草","author":"郑学醇","text":"泛泛东流水，筛筛水中鱮。\n煦煦青阳晖，婉婉怀春女。\n灿灿盛容华，依依弦上语。\n昔为比目鱼，今为孤栖侣。\n玉貌易摧残，茕然伤独处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青青陵上柏","author":"郑学醇","text":"亹亹玄象运，羲御东西驰。\n年命若飙忽，斗酒无常期。\n往日不可再，来日安可知。\n蟋蟀赋岁暮，为乐毋乃迟。\n宛洛美游戏，宫阙何巍巍。\n轩车日击毂，冠盖相追随。\n田窦互倾轧，宾客以盛衰。\n君但骋逸足，揽策随所之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"今日良宴会","author":"郑学醇","text":"置酒高堂上，宾旧罗华筵。\n雕盘荐野簇，棘匕进熊蹯。\n柔风洽四座，丝竹清且繁。\n新声响入云，听者有馀欢。\n人生匪金石，安得长令颜。\n何不建奇策，杖剑先登坛。\n无为事圭窦，槃躄长哀叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西北有高楼","author":"郑学醇","text":"高楼临大道，榱构起参差。\n惠风流阿阁，旭日衔双扉。\n思妇谁为容，绵带罗裳衣。\n当户理清瑟，音响何一悲。\n良人久燕赵，宛转守空闺。\n朝至春花妍，日暮华色衰。\n不惜朱颜改，所嗟时易违。\n君亮执高谊，白首以为期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"涉江采芙蓉","author":"郑学醇","text":"崇兰生别涧，孑孑扬秋芬。\n采之欲有赠，谁为同心人。\n直道易以疏，伊优易以亲。\n与君非鹣鹣，安得为一身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明月皎夜光","author":"郑学醇","text":"冉冉岁云暮，悲风鸣北林。\n孤鸿号外野，积霰散重阴。\n时节忽复易，伤哉徒滞淫。\n剽烈怆中怀，慷慨成哀吟。\n念我携手好，形影若飞沉。\n金石有销铄，信义安足谌。\n相须胶与漆，弃置商与参。\n顾因晨风翼，惠此瑶华音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冉冉孤生竹","author":"郑学醇","text":"郁郁山上松，高枝荫穷崖。\n上有女萝草，缠绵自不移。\n伤彼路傍花，孤生还独萎。\n伊昔侍君子，熠耀阳春时。\n轩车来薄薄，执手惠前緌。\n死生与契阔，岂无萝与丝。\n驰情在皓首，吁嗟中暌离。\n思君如皎日，所顾光不遗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庭中有奇树","author":"郑学醇","text":"桐生峄杨颠，枝叶何猗猗。\n下盘千仞谷，上干青云霓。\n涓旷一见录，投漆縆清丝。\n泠然扬妙曲，宁谓知音稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迢迢牵牛星","author":"郑学醇","text":"迢迢河汉渚，聊慄变金素。\n历历白榆花，团团浥清露。\n跂彼河东女，辛勤朝复暮。\n札札不成章，涕泣谁为诉。\n揽衣即河梁，踯躅不可度。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"回车驾言迈","author":"郑学醇","text":"玉露泫庭柯，悲哉秋气早。\n灼灼园中英，凋伤同野草。\n物汇随时化，荣华讵常保。\n盛年不奋容，奄忽沦衰老。\n谁为王子乔，容颜常美好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东城高且长","author":"郑学醇","text":"东城属浮云，四术连广陌。\n楼阁互蔽亏，轩车何络绎。\n贵贱各有营，劳劳自不息。\n往者无复今，今者复为昔。\n二曜更相送，谁非逆旅客。\n燕赵盛名倡，自矜桃李色。\n皓齿激清声，招邀日相索。\n长歌一何欢，短歌一何迫。\n驰骛奢与华，俛仰成陈迹。\n达人务大观，奚必长戚戚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"驱车上东门","author":"郑学醇","text":"屏居意不怿，载酒登北邙。\n但见丘与坟，磊磊被山岗。\n四野生悲风，白日黯无光。\n牛羊上隧道，斧斤戕白杨。\n人生若流电，此路终茫茫。\n谁能緤圭组，意气在重壤。\n妖艳伐真性，服食摧肝肠。\n不如脩嫭人，千载流芬芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"去者日以疏","author":"郑学醇","text":"旷野独行迈，宿莽萋以腓。\n顾瞻宛与洛，第宅纷崔嵬。\n山川洵云美，久客当何为。\n岂无今所欢，不如故所知。\n顾为双黄鹄，奋翅俱高飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"生年不满百","author":"郑学醇","text":"人事有代谢，天运无常盈。\n计功与殉利，咄咄竟何成。\n哲人悟神理，垢氛长不缨。\n存虚御六气，振翰凌蓬瀛。\n高揖九州士，天路空冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凛凛岁云暮","author":"郑学醇","text":"弱卉瘁微霰，松柏贞隆寒。\n浮云蔽千里，游子何时还。\n川原漫浩浩，欲往无轻翰。\n忧来知夜长，陨涕空汍澜。\n华灯列高宴，丝竹不解颜。\n黄鹄西南来，孤飞独盘桓。\n积薪苦见凌，后爱易前欢。\n彭咸与正则，嘉宠成祸端。\n驱车九折坂，始知中险艰。\n忠诚不见谅，剖心良独难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孟冬寒气至","author":"郑学醇","text":"炎暑徂朱夏，大火流西方。\n仰观天上宿，三五列成行。\n薄帷鉴明月，络纬鸣东厢。\n客从远方来，遗我篚流黄。\n上织缠绵草，下织双鸳鸯。\n裁为衾与裯，置之黄金床。\n三载不为御，眷此空彷徨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客从远方来","author":"郑学醇","text":"有客天一方，遗我五彩笔。\n下有灵兔毫，上有琅玕节。\n节以明幽贞，毫以明纯洁。\n持勖故交心，感此意良切。\n揽之怀袖间，题书寄长别。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明月何皎皎","author":"郑学醇","text":"烛烛明月光，照我西南隅。\n白露变严霜，岁序忽以除。\n揽衣起踯躅，所思万里馀。\n梦见匪无欢，觉后空踌蹰。\n离忧勿复道，涕下沾裳裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怨诗行","author":"郑学醇","text":"明月照高楼，流光满几席。\n上有愁思人，当窗三叹息。\n叹息知为谁，无乃荡子妻。\n日月递弦望，荡子胡不归。\n上山采蕨薇，下山恒苦饥。\n中心独徊徨，离忧当告谁。\n胶漆有时解，琴瑟有时垂。\n顾为身上衵，展转在君怀。\n勿以寒暑易，而忌敝絮襟。\n勿以贵贱故，而忘昔日心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东飞伯劳歌","author":"郑学醇","text":"东飞伯劳西飞燕，南斗北斗不相见。\n谁家女儿季且都，珊瑚木难间明珠。\n独处盘桓傍绣闱，良人安在玉门西。\n千金不博盛年好，盛年忽为相思老。\n昨夜风吹豆蔻花，春光使我长咨嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独漉篇","author":"郑学醇","text":"独漉独漉，水深泥浊。\n泥浊可撬，水深难溯。\n萑苇之藋，不可以杭。\n芙蓉之秀，不可以裳。\n孤蓬离根，随风飘举。\n我心悠悠，念子无所。\n岩居野处，独行何施。\n夜衣锦绣，谁则知之。\n张宁设罿，彼兽何辜。\n死为烈士，生为懦夫。\n有虎唬哮，伏于山阿。\n袒裼以搏，其如虎何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲歌","author":"郑学醇","text":"肉食不如稻粱，衣锦不如故乡。\n道远思归，壹郁徬徨。\n欲济河无梁，欲行车无脂。\n北首太行山，员辐将安之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铜雀台","author":"郑学醇","text":"高台春欲尽，凤吹隔花迷。\n漳水流无尽，西陵日易低。\n穗帷不可见，歌舞半含啼。\n惟有东风在，年年莫自萋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长信宫","author":"郑学醇","text":"对使与当熊，勇怯何如此。\n欲饮向苍天，衔恩终一死。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子夜歌","author":"郑学醇","text":"青丝贯蠙珠，是侬幼所佩。\n丝丝自相牵，珠珠自相对。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自君之出矣","author":"郑学醇","text":"自君之出矣，无复御铅华。\n逝水有西泛，狂夫那忆家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长干行","author":"郑学醇","text":"同是长干人，相逢语姻娅。\n何用比欢情，芙蓉吐清夜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白纻词二首 其一","author":"郑学醇","text":"姑苏台上春日长，百花洲畔春花芳。\n昼欢未足夜筵张，华灯灼灼舒红光。\n云屏锦帐兰蕙香，横箫挟瑟出幽房。\n朱唇宛转发浩倡，馀音袅袅浮雕梁。\n金壶滴月流西方，酣歌缓舞殊未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白纻词二首 其二","author":"郑学醇","text":"天河荧荧横鹊梁，阊门半启秋风凉。\n吴娥窈窕斗华妆，越罗楚练蒙素禳。\n促樽合坐飞瑶觞，樽前起舞摇明珰。\n引商激羽声琳琅，含情托意一何长。\n东江月出西江光，芙蓉露下杨柳霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采莲曲","author":"郑学醇","text":"岸中杨柳隰中莎，轻舟荡桨艳吴娥。\n纤纤翠带垂轻罗，繁花着人颜微酡。\n齐声一唱绿水歌，惊起鸳鸯冲素波，极浦风烟愁奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夷门歌","author":"郑学醇","text":"秦人一举坑长平，进兵直抵邯郸城。\n魏王睥睨不敢救，公子再拜咨侯嬴。\n嬴知办此有朱亥，虎符窃出王卧内。\n袖椎椎杀晋将军，魏兵北乡秦兵退。\n嬴送公子复何言，慷慨刎颈北风前。\n如姬且为公子死，抱关贱吏何所怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜度杨子江","author":"郑学醇","text":"扁舟暮发彭郎渚，莽莽寒云暗平楚。\n乍见瑶花委地遥，渐看玉屑漫空举。\n瑶花玉屑愈缤纷，夜色寒光缥缈分。\n低回烛影看逾态，飒沓涛声听不闻。\n天柱崔嵬冻欲裂，鼍鼓龙笙奏银阙。\n朱明洞口散梅花，阿母池头漾秋月。\n谁家楼阁凤凰栖，六代烟花远近迷。\n清樽访客山阴棹，秃节孤臣海上羝。\n冥冥漠漠春无极，万顷茫然随所适。\n何当拍手挟飞仙，躐蹋横江吹铁笛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得长安月","author":"郑学醇","text":"一片长安月，遥从碧海来。\n乍临秦塞曲，偏傍汉家台。\n穆穆金波涌，亭亭玉漏催。\n宫花不待晓，尽向镜中开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送友人之咸阳","author":"郑学醇","text":"持此清尊酒，送君征马尘。\n秋风辞北阙，别路在西秦。\n渭水花千树，峣关月一轮。\n试看五陵上，何似汉时春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东林寺","author":"郑学醇","text":"早出庐山岑，步屧过东林。\n鸟飞莲社寂，云落虎溪深。\n绝磴松蟠石，寒池月散金。\n何因从惠远，长此寄禅心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旅兴","author":"郑学醇","text":"怪得倦游人，年年客此身。\n催颜羞揽镜，生事欲垂纶。\n裋褐穷犹恋，寒灯夜独亲。\n落花兼细草，愁见异乡春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼亡","author":"郑学醇","text":"万物皆有尽，浮生谁百年。\n忽成终古恨，何地不堪怜。\n别梦残秋色，哀音流夜弦。\n鬼门关外月，犹自向人圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西江夜泛","author":"郑学醇","text":"霜后瘴烟清，空江新月明。\n中流千籁寂，孤屿一舷鸣。\n练色淼无际，长风如有情。\n美人何处所，吟望隔蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登梧州郡城奉和管慕云太史管时分守苍梧","author":"郑学醇","text":"南交十月早霜微，云物苍苍拂曙晖。\n地险戍楼依郭转，时平烽火近郊稀。\n海门蜃散千艘集，铜柱烟和独鹤归。\n百队貔貅閒战斗，空多营马入秋肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同刘陆韦诸博士冰井寺宴集","author":"郑学醇","text":"寺后秋山落木纷，寺前秋色净沄沄。\n岩阿雪作千花散，石窦泉从一道分。\n钟定乍飞员峤月，剑归犹带洞庭云。\n天涯莫送凭高目，何限联翩北雁群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]