[{"title":"山家春兴八首 其一","author":"陶益","text":"囊琴披鹤向山中，鸟自歌时花自红。\n一榻浮云飞不到，庚申常守万缘空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山家春兴八首 其二","author":"陶益","text":"袅袅春风涧谷间，紫芝长护白云閒。\n今来山阁无邻并，笑杀山人不恋山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山家春兴八首 其三","author":"陶益","text":"茶烟缥缈鹤飞迟，正是初醒午梦时。\n开衲迎凉花气入，绕篱黄蝶未曾知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山家春兴八首 其四","author":"陶益","text":"定息山斋不记年，花开花落自然然。\n翻嫌看历鲁多事，莺燕时来已报先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山家春兴八首 其五","author":"陶益","text":"阖闾清坐酒全醒，习静楚香养性灵。\n休道山房春色少，涧松池草正交青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山家春兴八首 其六","author":"陶益","text":"采药山前懒著巾，孰知城市有閒身。\n回来独对寒藤卧，不觉菖蒲绿已匀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山家春兴八首 其七","author":"陶益","text":"千村万落总依微，山霭层层带夕晖。\n入洞朝元无住著，花间眠犬待人归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山家春兴八首 其八","author":"陶益","text":"观海行逢有发僧，芳崖翠壁拉同登。\n解衣推食云中坐，御戢徒惭报未能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白菜传自吴今岁布诸近地心甚爱之因赋","author":"陶益","text":"玉质喜为邻，窥园日欲亲。\n锄成江左绿，摘作岭南新。\n叶淡调羹顺，根香得味真。\n加餐常赖尔，肉食莫相嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题西所见真图","author":"陶益","text":"居近长庚隔远堤，长庚盘阻照青藜。\n君王若画真泉石，定是沙头西复西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀关念斋","author":"陶益","text":"山人不欠买山钱，祇欠朱明吏隐贤。\n得句投囊无倚仗，问玄载酒隔风烟。\n菊花冉冉团秋露，梧叶萧萧落暮天。\n雁断岂胜频怅念，篝灯骞玩旧来笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻兵戏答张忝戎二首 其一","author":"陶益","text":"坐牛随意出荆扉，闻道重宣大将威。\n云鸟影来黄石路，踟蹰叩角赋无衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻兵戏答张忝戎二首 其二","author":"陶益","text":"兵戈扰扰杂风尘，苦忆魁梧一旧人。\n满眼黄花排作阵，祇宜閒对白纶巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华阳巾制成题赠黄龙洞文道人","author":"陶益","text":"巾痕摺出华山云，似识莲花旧隐君。\n戴向罗浮观海月，礼坛香绕动星文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居漫兴次文道人韵","author":"陶益","text":"地僻通三岛，云閒接九疑。\n遨游能寄傲，检束可酬知。\n乞火呼邻叟，焚香宿鍊师。\n祇愁偏废酒，吟咏不成诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渔夫吟","author":"陶益","text":"菰叶芦花又一年，任从儿女钓江天。\n于今赢得閒无事，卧月狂歌但扣舷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"百岁丈人何石龟入夜见访口占以赠","author":"陶益","text":"黄发浮江舸，青筇向竹林。\n北窗初梦醒，南极一星临。\n石枕云烟润，龟盘岁月深。\n期龄欣见汝，烧烛听论心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"揽镜歌","author":"陶益","text":"揽镜徐徐向陆阿，目光牛背照无何。\n閒来阅世长松下，花品嗟如人品多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜菊花枕醉后漫成","author":"陶益","text":"秋英入手敢辞迟，制枕偏于与病宜。\n幽侧但能贫事好，冷香惟恐异人知。\n暗闻恰似存三径，渴睡真如傍一篱。\n巾漉未应论竹叶，也缘陶令起相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"腊日代简速郑过斋","author":"陶益","text":"联翩霜信指汀州，影乱停云结客愁。\n子曰何其怜独念，岁云暮矣忆同游。\n香焚古鼎琴初弄，叶扫寒阶霰尽收。\n便合开樽邀郑谷，醉从铅椠赋登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迎春日书茅笔寄怀","author":"陶益","text":"惜昔迎春寺重游，珠林同咏壁间留。\n今朝独试茅龙手，折取梅花寄陇头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉吟二首 其一","author":"陶益","text":"发狂形骸忘，长啸天地杳。\n白眼向世人，知心良独少。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉吟二首 其二","author":"陶益","text":"不识王侯贵，无论世故多。\n陶然对松壑，笑月摆藤萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送萧广文转官延安","author":"陶益","text":"萧字惊看惜解携，清樽留恋绿杨堤。\n奎光入夜人争仰，遍照江南又陜西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日江墩遣意","author":"陶益","text":"谷口莺啼半亩春，榆钱绕屋未全贫。\n从将白发衣冠旧，漫对青阳岁月新。\n当槛折梅怀驿使，隔篱呼酒话比邻。\n九宵人胜金屏宴，不换江边一钓纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"樾下怀顾符台并和所寄山泉隐居之作","author":"陶益","text":"沽垆不为秫无田，小筑开云望大贤。\n千里结言徒自信，十年称病仗谁怜。\n亭亭夕照移函涧，泯泯春流入响泉。\n霄汉归来仙跸敛，相思长咏考槃篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"风雨短述","author":"陶益","text":"翡翠飘残羽，冬青湿落花。\n闭关延坐客，攒竹煮新茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与郑过斋诗话因忆林白庵林宦途近五老峰故以仙况之","author":"陶益","text":"忆汝仙人白兔公，双凫踪迹寄飞鸿。\n诗囊尽纳匡庐月，归散江门夕钓中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦梁仲房感述二首 其一","author":"陶益","text":"灌锄稀果今何在，羞耻空囊亦不存。\n遐想南塘还梦寐，白头欹枕叹黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦梁仲房感述二首 其二","author":"陶益","text":"旧游丘壑梦相寻，薤粥谈玄坐绿阴。\n醒后独怜人去远，五更风雨十年心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"城外旧居予大父方伯公所筑也虚存七十馀载兹复以居之感赋","author":"陶益","text":"第宅新修数十秋，石楼丹勒日光浮。\n赐书宝动骊龙见，封诰函开彩凤留。\n种德庭除时在念，渥恩霄汉世难酬。\n课儿学运斋前甓，犹似桓公在八州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舍北新筑水亭","author":"陶益","text":"开竹移幽径，结茅占碧湍。\n鱼苗惊乍暖，燕子送轻寒。\n野外留江槛，檐前护药栏。\n卜邻惟有仲，晨夕数相欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水亭纪梦用旧居韵","author":"陶益","text":"黄木湾前隔几秋，偶凭清梦到罗浮。\n丹丘隐豹憎人上，石室游僧并客留。\n回首凤凰台独迥，快心鹦鹉赋相酬。\n又从蕉鹿乘江舰，霏雪寒风舣帝州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日送人入京次过斋韵","author":"陶益","text":"白马临江潮欲生，青袍登舫棹将行。\n分霓作槛牵长缆，合海为垒酌巨觥。\n庾岭雪消梅影瘦，芦沟鸿截剑光横。\n何人折赠新杨柳，忆采蘋花讯玉京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种瓜四首 其一","author":"陶益","text":"小圃既锄亦已耘，邵平留叶倩谁勤。\n烟霞掩映低最实，纳履翻疑五色文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种瓜四首 其二","author":"陶益","text":"接庐栽破一区云，引瓞扪林画处分。\n三径无资偏爱汝，丈人才力岂堪云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种瓜四首 其三","author":"陶益","text":"近来呼雨鸠无灵，汲古灌成取次青。\n棚下夜凉瞻斗气，流萤故故拟流星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种瓜四首 其四","author":"陶益","text":"并蒂亚花照水明，林塘藤蔓总留情。\n不辞小摘邀邻曲，习习薰风各又生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"事葵菊","author":"陶益","text":"春深临别墅，草盛没江篱。\n开径分因菊，向阳灌为葵。\n琴樽期白帻，雨露忆清时。\n花意未全得，凭栏空赋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兰亭","author":"陶益","text":"爱兰居士此披襟，不数流觞会竹林。\n畹上昔曾分异种，窗前今已结同心。\n娟娟翚月依文槛，细细香风散绮琴。\n更有木樨贤达甚，时张舒蕊伴清吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蒲雨","author":"陶益","text":"何物水石居，云气逼梁苑。\n青青滴砚池，窃补残经卷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宾馆夜集","author":"陶益","text":"清宵花气满庭西，好是窗开对木犀。\n共引壶觞醒欲得，绳床印月坐闻鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"听凯三首 其一","author":"陶益","text":"楼船背水鼓声频，杀气连云暗海滨。\n龙节经年屯虎旅，红旗一旦捲黄巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"听凯三首 其二","author":"陶益","text":"跃马阑街卸铁衣，屠牛倒酒耀兵威。\n凯歌莫踏城头月，犹有同仇逐梦归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"听凯三首 其三","author":"陶益","text":"胡尘千里杂蛮烟，大将功成控绮筵。\n游子独能依乐土，愧无文采勒燕然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鉴江亭步吴刺史韵","author":"陶益","text":"南望荒荒驿路回，鉴江亭子定常开。\n仙帆影曳青霄出，渔榜声随白鸟来。\n楚客旅魂惊海峤，梁园词赋寄蒿莱。\n满城拥彗迎征盖，谁解当年倚马才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羽林曲二首 其一","author":"陶益","text":"镫雪西归马并帆，参差燕子又呢喃。\n翠眉竞认封侯相，羞解沙场溅血衫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羽林曲二首 其二","author":"陶益","text":"阴山险栈断青芜，结发防胡持汉繻。\n老出玉关怡斗草，勿论腰上有金无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫词二首 其一","author":"陶益","text":"节序惊心不自由，攀花趁蝶日悠悠。\n无端更倚长门树，积叶閒看出御沟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫词二首 其二","author":"陶益","text":"炉烟侵晓渡帘栊，夹道遥连左个风。\n飞尽桃花何意绪，会言鹦鹉在金笼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜何春元惠鹤","author":"陶益","text":"凰早庭前朱顶新，何当省识林逋客。\n顾侣员吭出绿阴，昂昂共刷排云翮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遇丈人","author":"陶益","text":"爱汝忘年叟，遗予不韵诗。\n自言曾著述，到老负襟期。\n懒去樵空叶，狂来钓废丝。\n相逢何草草，一别即留思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小海唱","author":"陶益","text":"雨霁长林碧，霞生空洞赤。\n湘江之水深千寻，湘水之鱼广数尺。\n鱼腹曾留先生离骚篇，江头不见渔父鼓枻迹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓郭外别业","author":"陶益","text":"江郭侧径云一隈，石壁历乱悬莓苔。\n水长初逢鸂鶒浴，烟消远辨辛夷开。\n贤人无来孤象纬，俗物难遣空徘徊。\n祇应黯黯客怀恶，尺牍细行谁与裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对雨","author":"陶益","text":"泽国初夏云霾偏，一雨不绝昼凄然。\n山禽正返路转杳，江草欲没岸犹牵。\n小炉易沸忙进酒，单衣寒生催换绵。\n安得体轻奋八翼，蹑风披日回午天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归答林衢仲见贶","author":"陶益","text":"轻舟采采陂塘曲，莲叶莲花飞属玉。\n返棹郁蒸见密云，移林疏快宜幽谷。\n漆园傲吏每无馀，栗里徵君常不足。\n别驾念之叩吾庐，殷勤厚硕徒感触。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留客","author":"陶益","text":"不惜崇朝饮，仍将旧事论。\n驿程同窜改，村市共卑喧。\n过客珠为履，归人荜是门。\n已拚形迹忘，耐可坐云根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恨别二首 其一","author":"陶益","text":"昔年结辙与君游，今日胡然不少留。\n帆逆曲流回复去，恼怀最是木兰舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恨别二首 其二","author":"陶益","text":"恼怀最是木兰舟，率意乘风天际浮。\n日暮江楼频极目，微茫斜倚赋离愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遣使寄答余希传","author":"陶益","text":"一缄书正发，三老棹偏行。\n路逐浮萍转，思随蔓草生。\n苏湖君迈迹，郑圃我逃名。\n不尽相期意，临流歌濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有客","author":"陶益","text":"偶出登台榭，相携爱客贤。\n阴繁翠盖柳，气馥红衣莲。\n蕨采诗添料，葵烹酒满筵。\n醉吟凉月夜，无用背花眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石榴","author":"陶益","text":"千叶风摇墙上出，数花雨洗眼边明。\n多房多子人相问，罔觉流莺并坐声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓起戏和庄家","author":"陶益","text":"朝朝忙盥栉，汲汲为桑麻。\n鸡唱山沉月，燕衔雾看花。\n禁僚催尽漏，关令放初衙。\n却怪图南懒，眠云不少差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠小金山僧","author":"陶益","text":"忽忆灵州古寺间，江山曾识长公颜。\n禅参隐语知多少，惟有无生是大还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊行即事","author":"陶益","text":"郊外联佳约，山中结静缘。\n女墙斜隐雾，人境远生烟。\n藉草为茶灶，纫兰当酒钱。\n平生无长物，一任野情偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过邮亭有感","author":"陶益","text":"愁见邮亭倚道旁，那堪算别重彷徨。\n十年作客非吾土，千里怀人是帝乡。\n溪绕閒花全倒景，店垂弱柳半斜阳。\n回头宿处清樽旧，说剑星流午夜光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚午岁端午书怀","author":"陶益","text":"记得常年五日朝，临江鼓吹客愁消。\n浴兰倒著荷衣缓，戏草回看荇带遥。\n里开竞传朱挽索，榔桡争夺锦缠幖。\n祇今寂寂缘何事，不久钱塘又弄潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"驯鹿","author":"陶益","text":"驯鹿真无价，幽人似有缘。\n偕游木石下，远害林丘前。\n呈瑞毫方异，应图毛转妍。\n采薇怀独穫，夹毂忆相联。\n麌麌仍堪羡，儦儦亦可怜。\n何当鸣向野，遗响入宾筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"墩中偶述","author":"陶益","text":"水国逢秋霁，山庄未夕昏。\n临池书满幅，入室酒盈尊。\n客子空弹铗，儿童懒候门。\n祇惟常阒寂，愧比谢公墩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀吴下诸友","author":"陶益","text":"飘泊萍蓬念独劳，百年尘路恋绨袍。\n云停粤岭江声渺，雁落吴门剑气高。\n季子得金还上国，长卿能赋拜仙曹。\n自怜贫病不相放，那觉四愁侵二毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送儿辈应试","author":"陶益","text":"遥见秋风接郡城，吾家诸少动长征。\n江门水长船同上，岭表云开雁并鸣。\n漫道骞藤应得意，须知温饱莫留情。\n夜来匆忆烧心地，桂影团圆离恨生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄白云社诸丈","author":"陶益","text":"耆德云中会，贤声天下闻。\n酒添南海郡，诗续北山文。\n鹤驾思殊切，霓旌望每勤。\n何时聊恣访，遍识紫阳君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访僧不遇二首 其一","author":"陶益","text":"绿护屏前瘴雾开，寻幽问药恨无媒。\n方袍自结人间社，祇有松声恋玉台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]