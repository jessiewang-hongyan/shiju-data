[{"title":"寒食","author":"殷奎","text":"咸阳官舍冷无烟，翘首南云思黯然。\n泪眼遥怜诸弟在，吴冈门北钱塘边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54740,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明日喜雨","author":"殷奎","text":"关陜连年苦旱灾，春田如石垦难开。\n十雨直教一雨足，二月欲尽三月来。\n菜甲充肠回饿莩，麦苗满眼发枯荄。\n先生共喜夜不寐，饱饭终年不用猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54741,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漫成","author":"殷奎","text":"无荣无辱任疏顽，未有平生此日閒。\n月幌听乌当北斗，风檐扪虱对南山。\n人情落落休分别，身世悠悠谩往还。\n问有未偿何债在，青鞋终华待跻攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54742,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送季公存主簿还褒城","author":"殷奎","text":"巴茶充贡入长安，王事能忘道路难。\n阁道马鸣关月冷，站车驼困岭云寒。\n偿来官课囊应涩，打去碑文墨未乾。\n明日拟将颜帖寄，好分鹿脯到朝盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王宪佥馈饼饵","author":"殷奎","text":"绣斧分巡礼数宽，怜才特地辍朝餐。\n官厨饼餤红绫样，分入先生苜蓿盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀公武","author":"殷奎","text":"快字豪吟在赫蹄，一庭春草梦魂迷。\n草堂忆得遥装夜，罢酒篝灯候晓鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海燕","author":"殷奎","text":"海燕朝始来，巢我旧堂楣。\n酸枣作春花，还是去年枝。\n微物亦有常，人事乃不齐。\n东风故园暮，万里愆归期。\n岂无弟与妹，志养须躬为。\n亲忧路共长，况复音书迟。\n安得如海燕，飞去慰所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆江南三首 其一","author":"殷奎","text":"江南忆，何处忆当先。\n先忆吾家春水船。\n有酒有花重庆日，无风无雨太平年。\n朝夕侍宾筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆江南三首 其二","author":"殷奎","text":"江南忆，其次忆何人。\n正忆高堂七十亲。\n膝下舞筵围稚子，花前茶会洽比邻。\n长奉笑颜春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆江南三首 其三","author":"殷奎","text":"江南忆，何事次当三。\n弟妹妻孥共笑谈。\n举酒凉秋持紫蟹，张灯春夜擘黄柑。\n宁不忆江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"故园酴醾","author":"殷奎","text":"一架酴醾手自栽，故园春老未曾开。\n明年乞得身归去，满为花神酹一杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"紫荆树","author":"殷奎","text":"紫荆亲种北堂前，春雨宜男色共鲜。\n拟举韦家为月会，乞身归去莫迟延。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮酒","author":"殷奎","text":"薄薄市沽酒，陶然得天真。\n长安二三月，亦复可怜春。\n山鸟劝提壶，山花能笑人。\n朝来黑头公，暮归黄土坟。\n汉家旧陵阙，无树照斜曛。\n雨荒西内殿，草没上东门。\n今日不强饮，古人谁复存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早起","author":"殷奎","text":"今日起来早，开户见南山。\n日出鸟相鸣，云断龙飞还。\n欲往翠微处，复畏暑路艰。\n梳头坐门畿，聊且乐吾閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"故园","author":"殷奎","text":"野雉将雏乳燕飞，风光人意两相违。\n宜男草生春已老，牵牛花开人未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠同官茅丞","author":"殷奎","text":"海门东畔是三沙，绝域孤城去路赊。\n紫蟹银鱼充顿顿，红椒金橘种家家。\n地邻员峤仙人宅，门系河源使者槎。\n枳棘元非栖凤处，故应归思满烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄麟游危丞","author":"殷奎","text":"危公佐山县，颇蹑傲吏踪。\n白眼对时俗，岸帻咏孤松。\n淮南无隐士，垄上有耕农。\n公事吾已了，偃卧元非慵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咸阳逄卜师颜照磨","author":"殷奎","text":"故人已别十年过，衰鬓相逢半已皤。\n共挽客衣怜道路，又持使节傍关河。\n归来西掖清光近，坐对南山爽气多。\n庭下鸟啼人吏散，紫薇花发柰君何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵武功余主簿见赠","author":"殷奎","text":"作簿如君信可书，妙年直节见廉隅。\n邑人自此知从化，天下于今正用儒。\n远荷到门题作凤，空惭授馆食无鱼。\n万里庭帏虚侍养，几时同此赋归欤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆学堂前凌霄花","author":"殷奎","text":"开遍凌霄石上花，先生犹自未归家。\n去年此日花开里，几度凭阑到日斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人从军","author":"殷奎","text":"小队拥霓旌，从军右北平。\n轻身常逐北，猛力惯擒生。\n落日黄河动，清秋太白横。\n单于未款塞，勋业待君成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平凉雹","author":"殷奎","text":"仲夏之日十又九，平凉城下晡时后。\n阴风吹云变天色，寒气袭人噤人口。\n须臾腷膊声满地，怪雹横飞大如斗。\n摧车折木不可当，人马辟易逃林薮。\n东门宿麦熟未摲，美实离离遍田亩。\n就根平削三十里，一穗不存君信否。\n道傍老父向人言，此田官种非民有。\n欲知种者是何人，两府指挥都督某。\n乌乎天道岂梦梦，警戒昭然事非偶。\n厚藏多取物斯忌，害盈福谦神所守。\n君不见公仪休曾相东鲁，拔却园葵去织妇。\n又不见霍将军在汉武时，匈奴未灭家何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒蝉","author":"殷奎","text":"已分长依露叶秋，懒陪貂尾上人头。\n风前不敢高嘶去，怕被虚声惹别愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"野鹤","author":"殷奎","text":"野鹤长鸣老树根，呼来不上大夫轩。\n群鸡啄食谁争去，风满秋林独自鶱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陪吴令访古长陵留宿萧城僧舍","author":"殷奎","text":"青鞋访古长城坂，路僻草深人迹稀。\n落日汉陵双阙在，閒云萧寺一僧归。\n览观幻境时时别，点检浮生念念非。\n我亦此身无住著，晚来禅榻暂相依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜雨","author":"殷奎","text":"一床夜雨梵王宫，预送秋声到客中。\n孤梦晓来休唤醒，要从渭北过江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿渭城田舍","author":"殷奎","text":"陶然一室野人庄，榻席当门石枕凉。\n饮食更怜淳朴俗，礼从宜处便随乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初度","author":"殷奎","text":"年年重六日，是我始生朝。\n自昔增悲感，于今更寂寥。\n盘餐惭草具，奠醊恨蓬飘。\n望里南云白，魂飞未易招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"见月","author":"殷奎","text":"举头见月使人怜，自出门来十上弦。\n阿姥此时堂下拜，教儿无事归来快。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张将军庙","author":"殷奎","text":"咸阳县中春寂寂，官寺民居皆瓦砾。\n岿然一殿渭河边，暮雨荒垣翳蓬荻。\n人言此庙祀张侯，作创年深失来历。\n但见舟人渔子事之谨，常具盘餐致私觌。\n七月二日庆生朝，十队水嬉飞画鹢。\n露台百戏竞娱神，变幻鱼龙走巫觋。\n口称将军主吾渡，渡口流传多伟绩。\n盲风怪雨白浪翻，过客乞灵无没溺。\n况闻生时在当阳，据水横矛气如霓。\n曹家水步八十万，瞑目一呼无敢击。\n生前英烈死为神，庙祀夤缘岂其的。\n吾侪小人无识知，知有阴灵系休戚。\n只今香火甚萧条，风雨前时破堂壁。\n猊像摧颓府藏空，旌旄散落门庭阒。\n何当一日还旧观，好妥神栖荐清涤。\n小人托命在风波，衣食生来此中吃。\n县官倘有修葺意，愿效区区答涓滴。\n我听此语为踌躇，祀典民情两相䦧。\n将军自是熊虎将，猛力雄姿万人敌。\n长刀不斫严颜头，国士之风何傥俶。\n功存汉鼎三国分，义却秦兵千载激。\n荒城野殿何足多，不慰吾民久惊惕。\n我来伏谒岂有他，前史遗忠自相觅。\n作诗荐愤代牢羞，投卷中流同吊汨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊陈寿夫","author":"殷奎","text":"去年此日昆山县，射圃亭中开小宴。\n寿夫送我上南京，把酒题诗苦相劝。\n酒酌碧筒对花饮，诗题素壁成吾谶。\n谁知岁月才一周，两人生死不相侔。\n我行万里生如寄，君得一官死如戏。\n人生变故不可常，洒我风前几行泪。\n北固山，在何处。\n西风落日大江秋，诗酒明朝吊君去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南山三绝句 其一","author":"殷奎","text":"南山突兀塞吾斋，啖饭看山似食鲑。\n山自有心来近我，何人裹袜又穿鞋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南山三绝句 其二","author":"殷奎","text":"南山万叠为吾开，一日支颐看几回。\n最是夕阳时好看，几人閒处解看来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南山三绝句 其三","author":"殷奎","text":"看罢南山看北山，北山奇峭夺天悭。\n有时走上高原去，秀色娱人忘却还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与吴宗德县令访古西原三首 其一 最师埪","author":"殷奎","text":"无僧秋寺倚荒原，劫后三埪几许存。\n争取唐碑镌字记，一碑未刻卧山门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与吴宗德县令访古西原三首 其二 天圣宫","author":"殷奎","text":"异人乃有重阳子，四海全无第一师。\n今日偶来寻故宅，海棠开过已多时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与吴宗德县令访古西原三首 其三 吉祥寺","author":"殷奎","text":"野寺犹遗一老僧，客来閒话失歊蒸。\n出门不觉归途晚，一片斜阳挂茂陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54776,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题吉祥寺壁画僧","author":"殷奎","text":"何人盘礴羸，写此特健药。\n三问病维摩，闭眼不一诺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54777,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜凉","author":"殷奎","text":"玉露凉生昨夜秋，芙蓉香老柳枝愁。\n故园归思知多少，卧听残更转戍楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54778,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴明府惠嘉瓜","author":"殷奎","text":"光含碧碗蔗浆寒，色浸红犀玛瑙盘。\n故侯亲手门前种，摘送相如渴夜餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54779,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送武功余簿行稼商州","author":"殷奎","text":"秦岭纵横宿雨收，西风匹马蹋商州。\n锦囊诗句题应满，此是南山第一游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵曹长通见寄二首 其一","author":"殷奎","text":"故山隔我几重关，翘首愁怀遣正难。\n春日题诗来末伏，苏州明月过长安。\n交游满眼无如旧，盟好经年顿觉寒。\n每忆吾乡诸寿俊，至今文力尚桓桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵曹长通见寄二首 其二","author":"殷奎","text":"故人别来隔冬春，劳我梦魂飞海滨。\n秋山终欲援丛桂，夜雨满拟餐丝莼。\n平生寂寂从人笑，末俗悠悠秖自珍。\n缄诗万里寄孤客，直比骨肉情相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得家书借长通韵怀二弟 其一","author":"殷奎","text":"封书远寄自乡关，令弟恩情政急难。\n万里元非双节贵，千金独有一身安。\n月明孤馆啼乌夜，秋在疏桐滴露寒。\n欹枕愁肠知几转，归期那敢尚盘桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得家书借长通韵怀二弟 其二","author":"殷奎","text":"曲堂花树可怜春，白日愁眠寂寞滨。\n老去慈亲惭负米，秋来诸弟忆羹莼。\n独游纵美谁为贵，同处虽贫自足珍。\n闻健归来一尊酒，百年相守意弥亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"疏雨","author":"殷奎","text":"庭旷疏雨响，夜凉归思多。\n缄书未能寄，流恨满烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋树","author":"殷奎","text":"秋树巳摵摵，秋风复吹吹。\n独居感时节，忧来浩无涯。\n念身匪金石，强壮忽已移。\n四十惧无闻，五十庶知非。\n丈夫事业在，用舍无盈亏。\n自信苟不谬，天命吾奚疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贡院夜集","author":"殷奎","text":"秋暑不可那，风庭生夕凉。\n高树互荫蔽，云月流微光。\n庞眉三数公，幽赏来相将。\n才彦集翘楚，亦有张与黄。\n咄兹古都会，况当文翰场。\n前徽信未沫，夙慕斯终偿。\n于焉盘礴羸，欣然命壶觞。\n趣得景自会，心迥形都忘。\n谈谐杂嘲谑，引此清兴长。\n良晤难屡得，乐事不可常。\n酒行莫辞醉，散去徒相望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郑参政第宴集","author":"殷奎","text":"秩秩宾筵昼日开，校文初罢棘闱来。\n省臣礼数宽容抗，座主文章老许陪。\n碧椀浆寒清骨气，红绫饼耎胶牙腮。\n醉归鼓腹羞餐素，预拟横堂育俊才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张昭季索送傅君还彰德诗","author":"殷奎","text":"归来老人雪满头，廿年汗漫西秦游。\n终南太白意不足，直上葱岭穷冥搜。\n手探河源蹋积石，昆崙磅礴皆历历。\n九点齐州两眼空，却返三峰聊一息。\n人间之世何纷纭，遍地干戈不可闻。\n只今天地重开辟，霁日扬光万景新。\n天王降诏厚风俗，养老今年饮乡曲。\n翻身归赏故园春，享此太平无限福。\n相州却筑归来庄，笑杀韩家画锦堂。\n一生富贵今何在，万古功名毕竟亡。\n君不见东门黄犬华亭鹤，死不得归空作恶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴明府南还","author":"殷奎","text":"茂宰贵从枢府出，荒城喜见德星临。\n饥寒忍放鞭笞手，流转频劳抚字心。\n伏枥难羁千里足，甘棠才驻一年阴。\n渭川过雨秋波满，得似离愁几许深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"以地图赠吴明府题诗其上","author":"殷奎","text":"路从秦岭入吴关，万里山河百战残。\n携取地图车子上，一番登览一开看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与吴令游雁塔","author":"殷奎","text":"合尖百丈插秋旻，俛仰千年感慨频。\n梵夹已成空相久，题名都化劫灰新。\n云来重洒思亲泪，雨歇才清拂面尘。\n来往匆匆聊记此，他时留与话前因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒蝉","author":"殷奎","text":"白露凝霜抱叶眠，渴肠愁杀夜来蝉。\n群儿莫谩相轻贱，清节高风死亦妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"述怀呈昭季教授","author":"殷奎","text":"长安学舍十日雨，客思秋来何可禁。\n出门青泥没两屐，满城素练敲千砧。\n田园荒芜归未得，桑梓梦寐来相寻。\n赖有主人张季子，每聆清话入更深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵吴明府","author":"殷奎","text":"赴阙是还乡，无烦恨路长。\n蟏蛸空罥户，䆉稏已登场。\n转觉行期近，频添别泪滂。\n云泥从此隔，聊复驻遥装。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴庆宫怀古","author":"殷奎","text":"落日宫城咏黍离，一堤衰柳护龙池。\n蓬莱已失清时水，华萼空馀劫后碑。\n锦瑟鹃声听去杳，玉笙鹤背候来迟。\n祇今遗构还修葺，应识雕墙鉴戒垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日述怀写寄余秦袁陆诸乡先达","author":"殷奎","text":"辞家来此恰周星，汛汛浮生水上萍。\n万里乾坤浑欲老，五更风雨不堪听。\n黄花天畔怜彭泽，青橘霜前忆洞庭。\n归计坐来成蹭蹬，飞鸿回首羡冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宋晋宁节度使徐公与金人战死葭州七世孙备为耀州判官以公事至葭见公题名石刻尚存乃致祭而还","author":"殷奎","text":"葭州徐节度，死节壮南朝。\n大义亲能灭，忠魂孰与招。\n山川犹惨淡，岁月已萧条。\n万里诸孙至，遗民涕泪饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奎在乡里时辱先达诸公折辈行与之交者多矣而或远在百里之外近亦不下一二舍以故不获亟从之游独吾叔御道原公武次泉潜夫数君子居相近志相同出入往来无间蚤暮有得必告有疑必质当是时亦诚以为乐矣而未知其为难得也一二年来或出或处或南入于广或东往于齐而奎亦远迹关辅閒居独处每一兴怀平昔从游之乐如在天外茫乎不可复得然后知会合之不易而离索之为苦也昔之人中年为别必数日作恶岂为过哉作诗一首以寄此怀","author":"殷奎","text":"离怀莫怪涕如河，柰此平生交友何。\n翠阁半山春共赏，板桥深巷晚相过。\n篇诗出口赓酬快，杯酒论心劝戒多。\n今日天涯分散尽，几回中夜独悲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄赠孝扬弟","author":"殷奎","text":"书来一事快吾怀，童子之师也自佳。\n四益缘知功在我，多闻须顾密名斋。\n兔园挟策身虽困，龙窟探珠志必谐。\n他日遗经同讲学，白头相对乐无涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"睢州书报道原之亡而不言其故哭之二夕梦与相见语其事甚悉然不可徵也作此寄卢吊且问之","author":"殷奎","text":"睢州昨日缄书至，报道道原今亦亡。\n岂为思家缠旧病，莫因作县坐新章。\n无人老母谁终养，寡妇孤儿我独伤。\n客夜梦回呜咽久，不禁寒月下空梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴朝锡尚书咸阳吊古次韵送之","author":"殷奎","text":"渭城秋草白于霜，驻马高原吊夕阳。\n汉节观风才独老，秦宫怀古意偏长。\n云端孤凤巢阿阁，雪里新莺绕建章。\n想见回朝频奏对，履声长在殿中央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自警","author":"殷奎","text":"生平为学苦多歧，一寸灵台尚可持。\n肯向二三频致察，何须五十始知非。\n行藏莫昧乘机速，仁义无妨见效迟。\n静里工夫难著力，尽教动处与防微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]