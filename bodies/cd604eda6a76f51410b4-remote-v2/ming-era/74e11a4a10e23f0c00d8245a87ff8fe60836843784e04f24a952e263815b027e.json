[{"title":"后杂忆诗 其六","author":"凌义渠","text":"松来条脱掷还收，生小无拘得自由。\n可是娇慵可是闷，阑干倚遍未梳头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25489,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"后杂忆诗 其七","author":"凌义渠","text":"狼籍寻芳悔独迟，残莺空复立残枝。\n问谁曾拂当年面，的的春光十五时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25490,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"后杂忆诗 其八","author":"凌义渠","text":"静掩垆香气尚温，随风栩栩近黄昏。\n有人耳畔低声叫，收得枝头一缕魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25491,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"后杂忆诗 其九","author":"凌义渠","text":"孤鸿流影怯成双，曲径苔深护小厖。\n晨起楼端凝盼久，待将秋色到前窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25492,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"后杂忆诗 其十","author":"凌义渠","text":"千年一别怨蹉跎，听缓须臾可奈何。\n暗嘱忘忧忧孰切，凭肩携手掐痕多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25493,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"稚儿识字歌","author":"凌义渠","text":"残月辉辉惜夜短，为欢无间笑声煖。\n捏蓝涂皂各纷纭，偏汝携毫未曾懒。\n小小眼光贮几字，字字能以意取譬。\n偶然道著喜点头，移时敛手默含羞。\n偏傍形似易相乱，欲辨未辨试推求。\n推求不了鼓催起，亟从阿母索刀子。\n率然下阶忘所以，一编翻覆灯光里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25494,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戏为麦灯歌","author":"凌义渠","text":"隐隐金光一线起，挑共华筵寂无语。\n别将朴质试妍心，有人擘穗如擘纸。\n茎叶旋枯莩膜在，普作光明不相碍。\n仰看月影卜年丰，中有老农拥褦襶。\n春宵秘戏本无方，鱼龙蹴踏争低昂。\n烛下风来饼饵香，跽受明赐乐难忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25495,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"步寻竹潭","author":"凌义渠","text":"自可呼私路，翳然隐一泓。\n投钱听共汲，留影照微清。\n竹气森能立，苔纹斜与萦。\n渟渟焉所托，漱入岕香生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25496,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄题镜阁","author":"凌义渠","text":"山水清娱别有机，翻成丽瞩入芳菲。\n相招宛自溪边立，熟视如从镜里归。\n但静见闻光寂寂，频移花鸟影依依。\n阴晴转眼君难问，梦锁湖烟只掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25497,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"旅次闻隔壁棋子声","author":"凌义渠","text":"一局覆清昼，停针辄按谱。\n两两喧笑杂，子落未遑数。\n校情孰争先，不拟孤注赌。\n只此就郎嬉，春残或可补。\n属耳偏有人，徘徊至亭午。\n花飞怕著身，业除诸恼苦。\n钏响隙边度，影匿光吞吐。\n聊试定中禅，寂寂天机舞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25498,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又雨","author":"凌义渠","text":"蚤见云开日，依然雨接云。\n兰兰香并减，燕燕湿为群。\n矫首天如压，酣眠昼不分。\n空阶滴陷处，尽遣梦中闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25499,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"两同年拉步禹陵因过南镇","author":"凌义渠","text":"藉草穿莎总不妨，同人牵涉上层冈。\n千年肸蚃如常在，一度花春几日忙。\n竦听孤泉何剡剡，平窥落照已荒荒。\n未须测注幽明理，酒旆高悬指墓傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25500,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"不入西湖者几年矣偶以事至信宿即返留句自嘲","author":"凌义渠","text":"欲趁良时安可希，年年川陆迭相依。\n瞥来秋燕终如客，一往奔蹄独畏鞿。\n久失湖情能渐熟，满担行色又催归。\n樨香露湿凉浮早，怪我无端与愿违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25501,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再至湖上","author":"凌义渠","text":"纷纭道听失惊呼，暂借閒僧伴影孤。\n何处溪山容酩酊，也教鸥鹭免羁逋。\n早游人事争春晚，不觉流光与岁徂。\n云罩数峰并悄悄，尽将生意入严枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25502,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春雨","author":"凌义渠","text":"妄意商晴雨，沉绵叹未休。\n生苔将及榻，抱卷欲登楼。\n竟日凭何遣，孤衷祗自仇。\n纷然多所念，不暇为春忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25503,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邺中诗 其一","author":"凌义渠","text":"微风触树冷修修，漳水依然咽旧流。\n何处高楼啼落月，久传疑冢认荒丘。\n佳人南国经春锁，公子西园爱夜游。\n最是英雄多感慨，杜康今日好销忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25504,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邺中诗 其二","author":"凌义渠","text":"俄闻霸业归残劫，尚许文心蹑后尘。\n阑入四科皆韵士，戏拈百技总天人。\n弹棋握槊飞扬甚，剔面搔头点缀频。\n恰好萧家堪并辔，后先烨烨更何论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25505,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邺中诗 其三","author":"凌义渠","text":"百万排空横自骄，仰天吠日一狞獠。\n自关率土摧王气，可有遗民数伪朝。\n和尚来施降虎力，欃枪下作扫宫妖。\n殿铃风细愁无语，洛度声声漫寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25506,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邺中诗 其四","author":"凌义渠","text":"建安旧事久纷纭，断碣耕馀故国坟。\n知有玺符答圣瑞，偶遗螺黛赏奇文。\n鬼神一窖工嘲谑，史乘千年讹见闻。\n多少古人冤愤意，好将双颊拄斜曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25507,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邺中诗 其五","author":"凌义渠","text":"谈仙白日等幽荒，暂倚温乡望帝乡。\n蛱蝶掠筵愁翅损，狐狸映月写眉长。\n才人无赖容追梦，爱子多情与嫁殇。\n剑有王髦带廓落，少年冶习可曾忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25508,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邺中诗 其六","author":"凌义渠","text":"弩末才知气不扬，卧看雀石又颓唐。\n啾啾燕语怜双卵，累累蜂窠缀几房。\n素旐单车行路哭，投笺解绶老臣忙。\n英魂未肯随尘土，地下相逢揖少康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25509,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邺中诗 其七","author":"凌义渠","text":"遗踪髣髴辨城闉，未有黄金铸幻身。\n尚爱残荷窥靥冷，强遮初月斗蛾新。\n神针夜夜愁拈指，细袜年年稳踏尘。\n鍊色选声真自可，那能閒置洛川神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25510,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邺中诗 其八","author":"凌义渠","text":"落日沉沉惜返戈，当涂典午又如何。\n中原惊见鱼头簇，内殿传称狗脚多。\n未辨蚁牛谁胜负，可怜歌舞早婆娑。\n唯馀一片铜台瓦，墨泪横侵不忍磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25511,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜薄杞城宋文玉邀饮 其一","author":"凌义渠","text":"百道思君似转轮，适成邂逅此堪亲。\n层云隔面昏黄色，雪意盈盈伫玉人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25512,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜薄杞城宋文玉邀饮 其二","author":"凌义渠","text":"嘹呖宾鸿惯惜群，瞥逢灯下气如云。\n停杯有意频凝瞩，不遣飞觥到十分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25513,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜薄杞城宋文玉邀饮 其三","author":"凌义渠","text":"为期燕邸重携手，乍可尊前忆踏花。\n不浅风光抛掷尽，馀将秃鬓架乌纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25514,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜薄杞城宋文玉邀饮 其四","author":"凌义渠","text":"名山志业未容论，过眼青黄一度新。\n记得濒行珍重语，不教个字及时人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25515,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜薄杞城宋文玉邀饮 其五","author":"凌义渠","text":"并爱烟姿擢魄青，微风片雪近前楹。\n只言寒漏迎人永，叵耐楼头又几声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25516,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟卧听雪","author":"凌义渠","text":"腊月如常暖，兹宵觉未曾。\n听声仍带雨，散粒乍为冰。\n以我客途始，遥知寒思增。\n与舟相齧处，彻夜冻层层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25517,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻沈弱瞻病甚忆其平日语记之","author":"凌义渠","text":"淳笃自天性，论文或嫌薄。\n评君君自评，意惬口无怍。\n我觉君仍厚，灵光寄寸钥。\n按笔如帝临，惴惴欣有托。\n未敢欺世人，言卮必忏削。\n以兹困揣摩，精神久落落。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25518,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜梦尸秽狼籍有类丛冢以古语占之岂将得官耶拈笔一笑 其一","author":"凌义渠","text":"凶吉何妨更倒颠，妍皮痴骨等秋烟。\n要知踏遍长安景，只似游魂陌上看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25519,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜梦尸秽狼籍有类丛冢以古语占之岂将得官耶拈笔一笑 其二","author":"凌义渠","text":"嗔嫌此际忽狂歌，非想非因梦若何。\n世法营官官自腐，北邙留待市朝多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25520,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元日早起即事","author":"凌义渠","text":"村鸡寒复涩，又觉五更时。\n门帖留新句，他乡见古仪。\n所思聊复尔，有梦不容追。\n却愧主人意，艰难备一卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25521,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阅同昌公主传戏题玉儿九鸾钗 其一","author":"凌义渠","text":"结此如烟质，微嵌似玉名。\n相携同命脆，各自恋身轻。\n钿盒藏幽魄，双鬟致远情。\n偶因幻昧迹，馀恨复分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25522,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阅同昌公主传戏题玉儿九鸾钗 其二","author":"凌义渠","text":"梦与梦相续，南齐恰几春。\n钏馀琥珀冷，虹逐美人新。\n抱影愁光烬，蒙花可带颦。\n一般缄惜意，终是女儿神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25523,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"将访龙梦先","author":"凌义渠","text":"寸管迥相接，宁因数面亲。\n论交何所赠，开匣未全贫。\n落落远游意，潇潇风木晨。\n感君仓卒际，寄瞩不辞频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25524,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小楼夜集有赠","author":"凌义渠","text":"閒羡楼居好，低回撤烛迎。\n月来浮袷净，茶点入瓯轻。\n促坐嫌分影，吟秋非一声。\n相看澹不了，何处复关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25525,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"水灯","author":"凌义渠","text":"悬知离火宅，未肯背明栖。\n一叶才能汎，中流此不迷。\n枫根逢月黑，芦渚觉风嘶。\n残烬飘何极，荧荧早向西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25526,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"胡端叔招饮月泉观剧","author":"凌义渠","text":"一抹柔痕著眼鲜，藏春十五故娟娟。\n妆凝薄鬓将雏燕，蕊抱红心未放莲。\n歌板暂停残照里，閒情早憩晚凉天。\n醉馀归路迷泉影，山月斜飞又欠圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25527,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画兰诗","author":"凌义渠","text":"睡起慵多欹花骨，云情晻暧兴复没。\n那用粉本借春工，偶然以意轻点拂。\n曾闻此花最泥人，低枝贪近女儿身。\n参差不避纤手摘，两两痴婢苦遭嗔。\n画者何人差能似，蜂蝶留连诚何取。\n夜深举笔醮花神，祇恐幽香荡无主。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25528,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过临淮","author":"凌义渠","text":"真为濠濮想，恰恰好天时。\n远水淼能活，晴云宕有思。\n出篱群野女，映栎古丛祠。\n村社喧成醉，渔歌日已暆。\n催归迎小鸟，稳梦足南枝。\n莫问搴兰兴，初心未可期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25529,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阅董宗伯赠姚画溪先生诗卷有述","author":"凌义渠","text":"初读泌园诗，棣棣未可选。\n再读泌园文，洪荒自迤演。\n前人大手笔，讵易撼其键。\n分路日争驰，周行为芜践。\n发函失典刑，俨若具簪冕。\n辞条既丰蔚，腕势信开展。\n录似溪上翁，良辰相与撰。\n吁兹罨画间，一水徐潆转。\n古木拒云寒，朝曦晓莫辨。\n春阳一以敷，风力失凝蹇。\n流韵及后人，蔼蔼馀温善。\n黾勉互相期，墙宇差无舛。\n盥手几摩挲，遐哉意方缅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25530,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新嘉驿感咏 其一","author":"凌义渠","text":"淡墨随烟拟向谁，邮亭是处结相思。\n欲知过客低回苦，遗袜当年传玩时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25531,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新嘉驿感咏 其二","author":"凌义渠","text":"土花蚀尽不生春，啼笑匆匆识幻因。\n最是五更清梦杳，绕床残月独窥人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25532,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新嘉驿感咏 其三","author":"凌义渠","text":"繇来此恨好相关，且向东君暂破颜。\n那管三春风雨后，飞花瓣瓣在人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25533,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"家居偶感因和潘右安包氏园亭之作仍步子瞻韵","author":"凌义渠","text":"岂必名园饶胜地，数椽且复问吾庐。\n花迎舞袖长年在，照返墙隅一半无。\n好踞平泉醒酒石，试拈金谷晚春图。\n关渠何事巢梁燕，岁岁添泥戏引雏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25534,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集贺公调署分得十四盐","author":"凌义渠","text":"偶集因成醉，来期不待占。\n清言机互答，默坐意俱恬。\n好戏非为虐，同心或借砭。\n月初临隙牖，风早避重帘。\n烛泪侵宵冷，笳吹彻曙严。\n暖须催鼓起，寒亟觅衣添。\n未觉主人倦，何辞良友淹。\n清歌曳尾细，花帽压檐尖。\n北客音同鹧，吴侬笑是盐。\n羁怀殊悄悄，酒趣故厌厌。\n低恋香光促，谁堪别思兼。\n倒觥聊自湿，急口未容钳。\n路入斜阳莫，天方衰草粘。\n孤心随幻蝶，美翰惜双鹣。\n率尔难为句，枯肠许再拈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25535,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"感往 其一","author":"凌义渠","text":"往复天心不可知，寒凝早已失冰凘。\n几年妖梦从谁践，竟日微吟空尔思。\n路有玃猿深护妾，行逢豺虎忍啼儿。\n未堪觉后重寻梦，喜惧双关此一时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25536,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"感往 其二","author":"凌义渠","text":"淼淼愁看雨雪雰，无凭烛曜待朝昕。\n同心携手将何往，痛哭裁书那可云。\n鬼刹丛中千杵下，甘棠亭侧一杯分。\n荒榛寒夜低声泣，咽绝因风久始闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25537,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"感往 其三","author":"凌义渠","text":"期将风信准枯桑，可但中流寄一航。\n长者吊丧宁忍诟，书生射策未全狂。\n机锋后起须相对，意眹才萌盍早防。\n底蕴岂容口舌尽，五千文字较茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25538,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"感往 其四","author":"凌义渠","text":"抵掌谁能佐末筹，翾飞小智亦啁啁。\n不愁难长同痴木，乍恋忘机到野鸥。\n绝险载输将伯助，褰裳竟渡为公忧。\n须臾变灭成泡沫，谷洛于今可暂休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25539,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏初自夹山莫归 其一","author":"凌义渠","text":"乍雨一番洗，湖光皎可看。\n霁昏何所属，晓暮亦云难。\n绿遍天同湿，鸦飞照乃残。\n半因来往熟，幽折得相安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25540,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏初自夹山莫归 其二","author":"凌义渠","text":"分外添明秀，如将山色矜。\n层层停客舫，点点着渔罾。\n新月光初引，晴霞煖渐蒸。\n淼然馀一白，临视久无凭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25541,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别刘晖吉司理 其一","author":"凌义渠","text":"衙庭峰影簇如簪，坐起行吟致尽酣。\n政入委蛇君较得，梦成迁扰我何堪。\n耶溪恰好乘春泛，古穴曾闻列炬探。\n独少清机相接取，虚留双屐越江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25542,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别刘晖吉司理 其二","author":"凌义渠","text":"一往孤畸不自禁，驱来碌碌负初心。\n寻声未拟追良晤，托迹终能倚素襟。\n梵夹乍舒时避湿，苇帘低捲日愁阴。\n对君讵免为清态，洗眼窗前照莫岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25543,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过从母净居感述 其一","author":"凌义渠","text":"闺律通禅旨，篱门昼反扃。\n辞家知有托，结愿岂无灵。\n器钵閒相守，音文寂共听。\n春光许暂入，一见草青青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25544,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过从母净居感述 其二","author":"凌义渠","text":"所尚匪奇节，恬然出素心。\n严霜久可狎，旭照恍初临。\n门户支何许，中宵叹不禁。\n翻如身得度，憬悟在情深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25545,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"会稽宣绣方之上海顾绣适堪姨姒友人见贻分丝观音一幅针锋细贴殆类白描女工之佳者也赞之以歌","author":"凌义渠","text":"心准手停不得语，始见吴娘今越女。\n天人冥接裁半方，晴摇香络风轻举。\n避风亦复畏日色，待倚绣床徐拂拭。\n大士幻身藏指尖，一丝飘断一丝黏。\n小声低咒灵未答，敛容内向愁纤纤。\n缘兹一意催成幅，秽不能留香并触。\n何如静女自收藏，结取慈情照眉绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25546,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日漫兴 其一","author":"凌义渠","text":"触目凋残泪暗倾，朝来初踏御街行。\n马头山色还依旧，喜听涂人说太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25547,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日漫兴 其二","author":"凌义渠","text":"上林树树借栖乌，树下何人转辘轳。\n早晚入门先问主，就中谁菀复谁枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25548,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日漫兴 其三","author":"凌义渠","text":"眼前一勺即沧浪，傍午爞爞暑气长。\n粪积泥犁堆面熟，也随驴背入诗囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25549,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日漫兴 其四","author":"凌义渠","text":"无蚊恰称晚凉天，高捲纱幮薄似烟。\n饱类樱桃饥类絮，尽人坦腹讵妨眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25550,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日漫兴 其五","author":"凌义渠","text":"镇日劳劳费送迎，梦馀尘土未全清。\n一般看到中天月，裁觉江南分外明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25551,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日漫兴 其六","author":"凌义渠","text":"庙市争趋朔望馀，观乎既往复踌躇。\n稍赢月俸钱堪质，为检摊门叶子书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25552,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日漫兴 其七","author":"凌义渠","text":"厌闻折简漫相呼，酒肉淋侵下箸无。\n且忍须臾随例散，一匙浓茗胜醍醐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25553,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日漫兴 其八","author":"凌义渠","text":"相逢曾否订心交，早趁凉阴学架巢。\n笑我有时触热到，等閒热客未须嘲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25554,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]