[{"title":"发凤阳途中呈徐公子","author":"唐之淳","text":"联骑发濠州，梅天雨似秋。\n马多同栈乐，人少异乡愁。\n小嶂藏轻雾，深涡走浊流。\n榆花零落尽，春去若为留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37387,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉和公相池河驿中留示之韵","author":"唐之淳","text":"君亲俱在念，风雨肯迟留。\n不作随阳雁，真如泛水鸥。\n寸心驰万里，一日似三秋。\n料得承恩处，南薰五凤楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37388,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过清流关追和宋滁守林公石刻诗韵","author":"唐之淳","text":"乱后关山开王气，雨馀行李带春泥。\n鹁鸠啄椹蚕开簇，布谷催耕水没犁。\n壁上好诗无客和，井边遗庙有乌啼。\n翻思野渡舟横处，只在滁州西涧西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37389,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"附林诗","author":"唐之淳","text":"病起溪翁枯似木，语多村叟醉如泥。\n麦边雨剩水鸣陇，月里农忙云破犁。\n山柳带愁知客意，野禽解事向人啼。\n明年此日华时节，我也东归君也西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37390,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠袁公子","author":"唐之淳","text":"往年同事李轻车，幕府青年总不如。\n谈阵爱知司马法，临文能读鲁连书。\n弓刀北塞秋风劲，灯火西堂夜月虚。\n今日相逢畏相别，天池早晚化鲲鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37391,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五月朔日雨中有怀灵谷禅师","author":"唐之淳","text":"涔涔西塘雨，曀曀北山云。\n云从望边起，雨向睡中闻。\n徂雨迷故辙，归禽失前群。\n异乡多知友，缱绻独论文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37392,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和徐公子怀公相两岁不得同赏端午韵","author":"唐之淳","text":"涨天风雨揽离情，忽得新篇破宿酲。\n眼底字疑山月照，耳根声似石泉清。\n每经佳节身多客，却忆征途梦亦惊。\n艾叶榴花濠上酒，元戎此日共谁倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37393,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送敷竺昙住义乌双林寺二十韵","author":"唐之淳","text":"双林古名刹，婺女之乌伤。\n云出汉水白，云归山气黄。\n维昔传大士，依山开道场。\n六时动天乐，草木生妙香。\n峰头七佛塔，塔下双神堂。\n堂中席久虚，猿鹤愁怨望。\n吾师霞外秀，六十须眉苍。\n祝发石桥左，挂衣双涧傍。\n小笠冒暑雨，轻袍带晨霜。\n手持文部檄，脚踏龙河航。\n访我玄津西，送之钟山阳。\n是时五月朔，绿树薰风凉。\n薝葡白胜云，菖蒲过人长。\n我留看归去，迟回以彷徨。\n师行过越乡，烦师一徜徉。\n乡中多亲友，念我几回肠。\n为我少安慰，令我羁思忘。\n马群有骐骥，羽族有凤凰。\n览德匪称力，如火不用光。\n大士迟师久，勉哉宜自彊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37394,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和徐公子同游","author":"唐之淳","text":"地拱皇都接太微，寺连冈阜势峨巍。\n殿门幡动朝行道，塔院灯明夜启扉。\n中使传宣香满袖，胡僧露坐罽为衣。\n偶因晴日陪游赏，喜得祥云傍马飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37395,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访友不遇","author":"唐之淳","text":"触热访君池上宅，草屋竹篱新板扉。\n黄尘扑面日卓午，知在翰林归未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37396,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中遣兴二首 其一","author":"唐之淳","text":"举觞问酒亦何如，四月初连五月初。\n出水大鱼看处好，望晴乾鹊报来虚。\n睡多梦熟还乡路，湿久蜗沿插架书。\n安得此身轻似鹤，云头松顶寄巢居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37397,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中遣兴二首 其二","author":"唐之淳","text":"已晴还雨半阴天，石榻纱厨不碍眠。\n新水白翻风里浪，好山青染夜来烟。\n心同渴骥奔鲸海，身学浮萍拂钓船。\n故国老亲思望切，数行音信若为传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37398,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送白先生还越","author":"唐之淳","text":"三年两度赐金归，南极文星隐少微。\n圣主恩深才不忝，上公情重礼无违。\n问船回马丹阳郭，临水登山白苧衣。\n自念同征不同去，烦君为我访庭闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37399,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋徐公子澄碧轩十二韵","author":"唐之淳","text":"赐第古城东，池连旧辟雍。\n画檐涵浩渺，素壁动冲融。\n公子闻轩处，长云野望通。\n影沉南寺塔，声浸北山钟。\n曲槛临流得，横桥到岸逢。\n龟翻荷盖雨，莺掷柳丝风。\n莎借秋帘绿，萍欺晓幔红。\n蜗传书法古，鱼识阵图雄。\n舞剑惊飞鹤，谈诗起蛰龙。\n自天恩泽溥，向煖墨华浓。\n气浥研朱露，光浮射鸭弓。\n我思分钓石，莫遣碧苔封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37400,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暑坐喜雨","author":"唐之淳","text":"涷雨尘外飞，凉飙霎然至。\n远岫分夕阴，轻雷阁炎气。\n云端去翼灭，石罅奔流驶。\n境胜神亦融，无言转多思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37401,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读和古体凡二十有六韵丰腴醇重有顺无彊第其间与予过实君子宁失于厚公则有之受而不惭正恐不免见讥于识者别用奉答以谢愚拙时戊辰六月癸亥朔日也","author":"唐之淳","text":"王郎长诗壁垒坚，老将睥睨不敢前。\n方公偏师扼其吭，如窦车骑登燕然。\n我闻一鼓避三舍，镞不破的敢言射。\n闭关朗咏二公篇，累累星斗钟山夜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37402,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得乾坤一草亭","author":"唐之淳","text":"天地之间寄此身，九州随处结比邻。\n邓林东影扶桑国，弱水西沉析木津。\n坐上竹书开宇宙，壁间藜火落星辰。\n不愁风捲三重破，惆怅谁为百岁人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37403,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"六月十日夜宿江上韩桥店","author":"唐之淳","text":"晨舻畏炎曦，夕枕爱轻爽。\n星摇大江动，月送惊潮响。\n微钟答野吹，短梦兴遐想。\n雨止流萤来，荧荧度疏幌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37404,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登观音山洞","author":"唐之淳","text":"悬厓临江皋，飞阁栈石面。\n空中金像古，舄下云涛溅。\n淮楚指顾间，河汉中流见。\n幸与风水遭，宁辞登涉倦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37405,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渡江至仪真","author":"唐之淳","text":"山月未落潮水平，不闻潮声闻橹声。\n乍徐忽远复兴举，宛若秋天鹤鹳鸣。\n龙潭已过仪真近，江南行更江北听。\n瓜步屯边戍卒閒，白沙坝下盐船并。\n桑麻旆旆黍油油，楚色江光万户秋。\n七十里程弦样直，好风今夜宿扬州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37406,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扬州","author":"唐之淳","text":"芜城草色绿迢迢，胜国繁华寄寂寥。\n红药无人开锦幄，玉楼何处教鸾箫。\n荒祠古木雷塘路，细雨平莎扬子桥。\n五日恶风今日好，摊书高卧仰青霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37407,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扬子桥","author":"唐之淳","text":"白浪迎船走玉龙，船头人听广陵钟。\n朱帘寂寞琼花落，二十四桥空碧峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37408,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"邵伯镇龙王庙","author":"唐之淳","text":"夜合花香槐子肥，庙门人集祭龙妃。\n灵风洒面云旗湿，知是朝来行雨归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37409,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"高邮湖","author":"唐之淳","text":"高邮湖，湖中飞蚊不可驱。\n六月七月日未没，春雷隐隐鸣菰蒲。\n饥蚊如针峰，饱蚊如樱珠。\n绕船大叫掌流血，有梦不得游华胥。\n前人寄语后人道，不信但看露筋庙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37410,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"淮安月夜","author":"唐之淳","text":"处处南风藕自香，人烟多处是山阳。\n两城对垒车轮小，一水中流衣带长。\n哀怨昔曾歌布粟，盛衰元不问金汤。\n今宵偶作淮东梦，无柰月明思故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37411,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜过泗州","author":"唐之淳","text":"明月长淮水，孤帆永夜船。\n缺云呈远汉，凉露落高天。\n州近更声急，山微塔影偏。\n江湖多兴绪，吾亦信吾缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37412,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓淮北行府呈公相","author":"唐之淳","text":"府第雄深出圣裁，濠城北面接鱼台。\n恩波正比淮流远，瑞霭多从禁国来。\n周室藩邦基百世，汉家戚里近三台。\n金鱼玉带亲调膳，日对南山举寿杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37413,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉和公相韵","author":"唐之淳","text":"小雨湿斜晖，残红阁翠微。\n寺遥僧过少，河涨客来稀。\n习静留云住，乘閒放鹤飞。\n几农侵月散，知罢桔槔归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37414,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿公相","author":"唐之淳","text":"南极明黄阁，长庚映紫垣。\n地居勋戚右，身处相臣尊。\n金狄符仙箓，丹心照宠恩。\n阶蓂三叶秀，和气霭东轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37415,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"淮上七夕遇雨","author":"唐之淳","text":"雨雨风风淮上城，水禽山叶送秋声。\n可怜今夜星桥月，不著清光照客情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37416,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"往荆山道中即事","author":"唐之淳","text":"小河水深没马颊，浴盘浮渡如浮杯。\n碾涡咫尺不可上，四夫争挽声喧豗。\n大河雨馀势业业，邑人来迎具舟楫。\n片帆天际落春云，万斛空中舞秋叶。\n东边雨响西边日，船上鼓鸣船里笛。\n馀霞闪映一川明，大鱼惊跳双尾赤。\n帆回棹进指淝河，涂山荆山颦翠蛾。\n当年辑玉会朝处，今日西风生短莎。\n山前屯兵半降虏，山后人家尽禾黍。\n倚滩晚饭已黄昏，将军横槊方怀古。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37417,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陪南涧宿","author":"唐之淳","text":"银烛烂春霞，高楼隐暮笳。\n月光侵坐薄，雨气入帘斜。\n醉眼翻嫌酒，诗肠却爱茶。\n语多浑不睡，秋思逼窗纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37418,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"是夜蒙公相寄示三首因用韵以成 其一","author":"唐之淳","text":"云头鹤背碧迢迢，仙子飘然不受招。\n直入银河秋水去，好风明月是轻桡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37419,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"是夜蒙公相寄示三首因用韵以成 其二","author":"唐之淳","text":"日长公府坐论思，羽扇风清虎帐垂。\n望见石枰斜点笔，不知诗句欲怀谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37420,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"是夜蒙公相寄示三首因用韵以成 其三","author":"唐之淳","text":"淮北淮南两地情，藕花菱子月三更。\n心同老鹤无多睡，听得东轩剪烛声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37421,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和南涧经然灯寺韵","author":"唐之淳","text":"长涂策征騑，解后栖禅处。\n入门坐盘石，果得山僧遇。\n阴泉浥雨漪，阳坡荫云树。\n衣留大颠室，马系支公墅。\n一息神已怡，忘言转多趣。\n所嗟尘鞅羁，又复扬飙去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37422,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和公相晓出中都父道门韵","author":"唐之淳","text":"太微连甲第，黄道接天居。\n月柝收更罢，星轺发轫初。\n鞭声喧野渡，旗影照村墟。\n欲出怀调膳，言归畏简书。\n宠光朝奏毕，物色苦吟馀。\n自笑从公后，烟波负老渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37423,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和公相舟行即事韵","author":"唐之淳","text":"水面吴歌接楚歌，歌声不似水声多。\n卸帆摇橹过湖去，一路秋香生晚荷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37424,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟唐人游仙二首 其一","author":"唐之淳","text":"度海乘龙底用船，上清知号不知年。\n西分弱水浇丹灶，东入扶桑系马鞭。\n文字每书龙汉后，封章多到玉皇前。\n几回下视人间世，碧落空歌动八埏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37425,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟唐人游仙二首 其二","author":"唐之淳","text":"家住蓬莱第几峰，静如云水动如龙。\n九天官府无人到，八海山川有路逢。\n岩畔牧羊曾化石，坐中吹饭或成蜂。\n夜来青鸟双飞去，寄得麻姑信一封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37426,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扬州竹枝词四首 其一","author":"唐之淳","text":"隋家杨柳古扬州，杨叶无多野水流。\n莫说小红楼畔路，琼花观里少人游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37427,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扬州竹枝词四首 其二","author":"唐之淳","text":"小年曾入镇南家，回首西风白日斜。\n独抱胡琴理胡曲，白菱飞上野菱花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37428,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扬州竹枝词四首 其三","author":"唐之淳","text":"十里珠帘卖酒旗，一时都逐火云飞。\n伤心欲问前朝事，白发淮人即渐稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37429,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扬州竹枝词四首 其四","author":"唐之淳","text":"往年歌管不曾閒，遮莫商船到北湾。\n今日樵儿吹野曲，犹传一曲汉东山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37430,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送一斋公子还凤阳四首 其一","author":"唐之淳","text":"同泛楼船上玉京，独骑归马向濠城。\n日斜烟淡山如写，江北江南一段情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37431,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送一斋公子还凤阳四首 其二","author":"唐之淳","text":"绿浪轻帆潮热后，白云归路雁啼时。\n望来鞭影旗亭暮，吟过滁州几首诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37432,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送一斋公子还凤阳四首 其三","author":"唐之淳","text":"疋马新从阙下辞，扬鞭疾去莫教迟。\n寻常一样中秋月，谁似升堂捧寿卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37433,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送一斋公子还凤阳四首 其四","author":"唐之淳","text":"明朝送客出城隅，先向东家借蹇驴。\n仆健马肥泥水少，料知三日到中都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37434,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和昂霄见怀韵","author":"唐之淳","text":"偶作淮甸游，空烦故人待。\n执热思雨凉，驰情寄云海。\n岂无黄发期，但恐朱颜改。\n共保金石躯，芳名岁寒在。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37435,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读千里题赏静诗因而有寄","author":"唐之淳","text":"旧闻诗学有渊源，喜见新题赏静轩。\n拾得珠玑愁海客，织成云锦费天孙。\n竹烟茶熟风生枕，鹤梦秋清月到门。\n我亦钟山爱唫者，好烦尺牍寄瑶琨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37436,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"千里有诗见贻次韵以答","author":"唐之淳","text":"自入秋来相见频，手挥谈麈爱清新。\n三冬文史青灯夜，七尺丰姿玉树春。\n马上射生闻胆略，坐间写诏得精神。\n尔家慈母王家女，宅相于今见此人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37437,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题徽宗写秋塘翡翠图","author":"唐之淳","text":"藕花红堕莲房老，藕根水涩波声悄。\n一双翡翠破苍烟，衔鱼出波飞向天。\n日暮无人来荡桨，半黄残柳寒蝉响。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37438,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题十六罗汉画卷","author":"唐之淳","text":"十六应真谁为写，无住庵主隆茂宗。\n茂宗亲入龙眠室，意匠彷佛将无同。\n结跏趺坐侍天女，偏袒右肩降神龙。\n手乂布衲云石静，背倚蒲团秋树空。\n或圆其颅狞若怒，或帽其首皤而翁。\n或持经卷面新竹，或撚长须修古容。\n或陪语笑荫嘉木，或袖麈尾邻枯筇。\n或憩荦确枕苍虎，草木衣袂皆天风。\n或老无力挟以幼，牙齿脱落双鬓童。\n一翁羽扇治茗饮，二士徐行相与从。\n就中笔法各臻极，体态一一清而丰。\n非仙非神亦非鬼，特以戏幻施神通。\n我去天台不千里，赤城烟霞魂梦中。\n胡麻饭熟木瓜烂，桃花流水春溶溶。\n每思石桥若天上，有脚未踏心忡忡。\n今日何日展图画，钟山秋雨鸣梧桐。\n欣然矫首望瀛海，应真有灵当我逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37439,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹坡辞为汤公子赋","author":"唐之淳","text":"繄坡陀兮岩谷，荫蒙茏兮脩竹。\n月湛湛兮照夜，烟冥冥兮升旭。\n坡之人兮相羊，依密荫兮开洞房。\n剪春箨以为冠兮，制秋云以为裳。\n截高枝以为竿兮，钓溪流之鲤鲂。\n窍玲珑以为管兮，集高台之凤凰。\n凤凰兮来下，食有鱼兮饮有醑。\n挺持节兮养幽素，坡之人兮受天祜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37440,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"期高公子不至分韵得佳字","author":"唐之淳","text":"坐起对凉雨，绿苔生碧阶。\n如何跬步间，竟作万里乖。\n远雁送秋色，白云满秦淮。\n所思如钟山，日夕空自佳。\n何能一飞堕，翔泳展中怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37441,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和答赵孟玘二首 其一","author":"唐之淳","text":"同抱琴书客异乡，巷南巷北见寻常。\n论交有道伤时俗，沽酒无钱愧客囊。\n骐骥夜寒沙塞雨，蟪蛄秋老石林霜。\n何时重理渔蓑去，短楫长竿镜水傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37442,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和答赵孟玘二首 其二","author":"唐之淳","text":"睡起多从池上行，不宜风雨只宜晴。\n看知鸟鹊营巢意，听得鲂鱼散子声。\n夕径响添惊木落，秋袍凉透觉云生。\n客边喜遇谈诗友，时复相过慰旅情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37443,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋有怀","author":"唐之淳","text":"去年夜醉渔阳月，身逐边鸿寄天末。\n幕中文采六七翁，歌舞喧呼至明发。\n今年独客钟山阳，有家不归仍异乡。\n午时雨落晚未息，桂树无影星收芒。\n寒砧楚曲秋声早，南北东西故人少。\n明年又复在何乡，且吸清尊慰怀抱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37444,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨窗睡起赋得浪字","author":"唐之淳","text":"倦来随意卧匡床，归路无多客路长。\n帘幕已空秋社燕，房栊犹贮午时香。\n锦菭生户蛛丝合，银烛当檐雨气凉。\n记得暂时逢酒伴，瓦瓯篷底醉沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37445,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉怀国公大公兼寄杨镇抚","author":"唐之淳","text":"一从驰驿向西秦，几欲封书托使臣。\n渭水白云生马足，函关紫气接车尘。\n众中持节传宣久，到处题诗访古频。\n藩府官寮多属望，料知杨震独情亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37446,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九月六日催菊赋得何字","author":"唐之淳","text":"江雨茫茫涨白波，东篱秋色竟如何。\n十分犹较三分少，九日争先二日多。\n西子睡浓方敛笑，太真娇重不成酡。\n花神好雨匆匆发，莫负公家金叵罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37447,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日分韵得壶字","author":"唐之淳","text":"偶逢佳节寄京都，家远亲朋一字无。\n睡起晚云生枕席，雨馀秋水足江湖。\n石城木落砧声早，天堑风高雁影孤。\n北望蒋陵才咫尺，不曾与客共携壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37448,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九月十一日天禧寺访卢月桐观画壁回口占二绝句以寄 其一","author":"唐之淳","text":"秋路沙晴不起风，长干寺里访卢鸿。\n瓦棺已失维摩样，画壁他年看月桐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37449,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]