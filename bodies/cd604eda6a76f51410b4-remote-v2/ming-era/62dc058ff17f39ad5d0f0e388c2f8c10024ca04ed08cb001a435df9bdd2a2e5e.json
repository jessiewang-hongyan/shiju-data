[{"title":"枫桥夜泊梦邓汝高进士","author":"徐熥","text":"燕吴遥望隔天涯，魂去魂来只自知。\n梦里顿忘裘马贵，相逢犹似布衣时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中对酒怀陈子卿","author":"徐熥","text":"横塘烟雨不胜愁，满目山川忆旧游。\n今夜一杯三白酒，犹疑同醉太湖舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜雨","author":"徐熥","text":"客路逢秋梦易醒，空江烟雨晚冥冥。\n数声夜半孤篷外，不似高斋竹里听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀任夫","author":"徐熥","text":"天涯虽自叹离群，不用题书更寄君。\n日日同游有诸弟，一回书寄一回闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朝天宫赠沈道士","author":"徐熥","text":"回廊九曲隐星坛，霞佩螭衣偃月冠。\n唱彻步虚词一阕，白云满地磬声寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃叶渡访张幼于","author":"徐熥","text":"淮水东边杨柳新，白头犹醉曲中春。\n尊前试看红妆女，谁是当年劝酒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青溪逢吴叔嘉投赠","author":"徐熥","text":"广陵云树秣陵烟，两地飘零共几年。\n老母七旬家十口，资生惟有卖书钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寻汪尧卿不遇","author":"徐熥","text":"落叶苍苔满径幽，怀人空对秣陵秋。\n秦淮渡口无踪迹，一日看花十四楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹫峰寺逢赵用拙","author":"徐熥","text":"白云洞里觅无踪，何意青溪得再逢。\n无却是真逢是幻，欲将真幻问南宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苕川寻钱叔达不遇时叔达在闽","author":"徐熥","text":"我客苕川君客闽，天涯同是未归身。\n应知两地相寻处，俱闭閒门不见人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐怀玉生 其一","author":"徐熥","text":"冷衾如水室如冰，未尽更筹欲尽灯。\n回首旧游多感慨，双双骑马戏金陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐怀玉生 其二","author":"徐熥","text":"疏林明月照匡床，一点孤灯泪万行。\n夜半顿忘人已别，诗成犹自问王郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴兴感怀呈在杭","author":"徐熥","text":"客中何事太凄然，不得归闽未到燕。\n囊橐渐空游渐倦，故人离别又残年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏燕","author":"徐熥","text":"燕子娇飞羽翼齐，呢喃时向小窗西。\n只因旧垒营初定，纵有雕梁不敢栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过钱功父悬磬室","author":"徐熥","text":"一室依然似磬悬，传家负郭旧无田。\n鸊鹈剑售鹴裘典，只有藏书不卖钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再寻王太古不遇","author":"徐熥","text":"梅花影里访幽栖，门掩寒塘水满堤。\n两度相寻不相见，一帆风雨出梁溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江","author":"徐熥","text":"一叶扁舟逐浪飞，罡风吹浪上征衣。\n他时纵有南归梦，梦见涛声不敢归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"交河道中 其一","author":"徐熥","text":"路入交河日半曛，北征车马各纷纷。\n如何一片黄沙地，能胜青山与白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"交河道中 其二","author":"徐熥","text":"黄沙漠漠马骖驔，北地春光久自谙。\n不用褰帷纵游目，断无山色似江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旅店感旧","author":"徐熥","text":"壁上题名八九春，重来疑是梦中身。\n几回欲觅题名处，忘却谁家是主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕南道中怀君大熙吉熙工玉生诸子","author":"徐熥","text":"萧萧羸马向天涯，一片黄尘满面沙。\n记得去年春雪里，白云庄上看梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏道傍柳","author":"徐熥","text":"一片东风一度新，生来不见上林春。\n莫言此物无情甚，送尽天涯落魄人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新城阻雨","author":"徐熥","text":"寂寞孤村独掩门，几家灯火近黄昏。\n一般寒食梨花雨，此地听来更断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东阿道中","author":"徐熥","text":"马上青山夕照明，看山应动故乡情。\n虽然不及江南好，犹胜平原旷野行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阳谷马上戏作呈幼孺","author":"徐熥","text":"万树垂杨送客行，春风三月未闻莺。\n上林此日方千啭，不向归人唤一声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过东平城北元故丞相墓","author":"徐熥","text":"谁家翁仲卧荒坟，闻是先朝旧相君。\n三百年中来往客，几人下马看碑文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汶上感旧","author":"徐熥","text":"汶水匆匆唱渭城，春风一别数年情。\n知君本是飘零客，未必重逢在此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同幼孺马上见桃花","author":"徐熥","text":"寂寂山家半掩门，却怜春色满荒园。\n同行不觉旗亭远，看尽桃花又一村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿界河驿梦从许灵长索书兰亭记","author":"徐熥","text":"折柳都门路遂分，故人回首隔烟云。\n不知此别千馀里，犹乞兰亭学右军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过薛君故城","author":"徐熥","text":"高台倾尽曲池平，此地犹传薛故城。\n珠履三千俱寂寞，行人空动雍门琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挂剑台","author":"徐熥","text":"公子当年然诺深，千金宝剑挂空林。\n应知十字碑题后，泉路相逢无愧心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"亚父冢","author":"徐熥","text":"亚父孤坟蔓草荒，行人何用叹兴亡。\n汉家多少功臣骨，若个能归葬故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"彭城感旧","author":"徐熥","text":"落尽天桃万树花，伤心重问旧琵琶。\n平康门巷多相似，不记垂杨第几家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏马台今改为昭烈庙","author":"徐熥","text":"英雄千载说喑哑，此地曾经戏五花。\n只有荒台留不得，依然香火属刘家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广陵别陆无从","author":"徐熥","text":"客路相逢叹二毛，片帆南下月轮高。\n他年一枕扬州梦，满树璚花万顷涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟抵京口作","author":"徐熥","text":"舟过金焦日未斜，回看瓜步即天涯。\n故乡虽隔三千里，得到江南似到家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丹阳舟中与幼孺对月时余南还幼孺将客苕川","author":"徐熥","text":"共倚孤篷月似霜，夜深风露满胡床。\n应知此月重圆夜，君在他乡我故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀平夫","author":"徐熥","text":"客里思君路渺茫，回看往事更凄凉。\n十年夜半罗山雨，若不销魂也断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀惟秦","author":"徐熥","text":"江上春风吹布袍，题诗千里问蓬蒿。\n君还记得当年事，竹下焚香读楚骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题落日孤舟扇面送幼孺","author":"徐熥","text":"古木苍苍落照收，谁人独自汎中流。\n灯前不敢披图看，恐是松陵别后舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夹浦桥感旧寄谢在杭","author":"徐熥","text":"夹浦桥西芳草新，当时此地共迷津。\n年来买遍松陵棹，犹是江边失路人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重集谐赏园忆歌者陈情 其一","author":"徐熥","text":"龙阳窈窕胜蛾眉，埋玉空山是几时。\n重到园中听歌舞，不成驩乐却成悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重集谐赏园忆歌者陈情 其二","author":"徐熥","text":"陈郎丰度似何郎，长袖蹁跹韵绕梁。\n此日重来君不见，舞裙歌扇总凄凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八尺湖夜泊怀李与熙张子环","author":"徐熥","text":"八尺湖边月上迟，相逢犹记去年时。\n一从落魄长安后，三处飘零各不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetr