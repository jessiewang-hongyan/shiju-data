[{"title":"游藕花居","author":"许天锡","text":"五山皆佛国，潇洒藕花居。\n水气蒸楼润，山光入座虚。\n香床松子落，小径竹风徐。\n岁月缨微禄，烟霞空敝庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27607,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"兀坐","author":"许天锡","text":"兀坐如禅定，空斋日又斜。\n游蜂窥砚水，斗雀落庭花。\n世事随风马，年光赴壑蛇。\n惟应倚脩竹，高咏答韶华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27608,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望远","author":"许天锡","text":"望远春还早，思亲日较长。\n闭门疏世故，抱病惜流光。\n买药囊将罄，呼朋酒已香。\n江边有草阁，结绿自垂杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27609,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王永清之武阳","author":"许天锡","text":"紫陌消残雪，青天带晚霞。\n双凫辞北极，一骑向中华。\n风拂金明水，春生博浪沙。\n知君为政日，岂有席门家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27610,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重阳前一日柬余景文","author":"许天锡","text":"三句违玉署，一枕感秋蓬。\n失谱琴忘操，思家药减功。\n寒烟冲去雁，暮雨入飞虫。\n明日重阳酒，烦君对菊丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27611,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谒严子陵祠","author":"许天锡","text":"一点微星炯，双厓钓石存。\n炎陵销旧业，过客酹清尊。\n草竹藏碑碣，渔樵问子孙。\n群英如耿邓，千载更谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27612,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"立春前二日下茶洋","author":"许天锡","text":"客路侵残岁，归心胜急湍。\n寒风吹落日，健橹下层滩。\n石过鼋鼍走，山来剑戟攒。\n华堂荐松韭，能得预春盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27613,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿大枫岭","author":"许天锡","text":"一宿大枫岭，客怀殊未厌。\n梦残山鸟识，衾薄野云添。\n淡月窥幽户，寒泉近短檐。\n奔驰百年内，吏隐几人兼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27614,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日","author":"许天锡","text":"春风怜病久，分暖到窗纱。\n雉堞朝无雪，茅茨物有华。\n惊心惟节序，快意自生涯。\n南客今将发，题书可问家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27615,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送人之燕","author":"许天锡","text":"燕云七千里，之子去匆匆。\n酒尽溪头上，春归暮霭中。\n桃花不受雨，榕叶易吟风。\n莫此伤离别，男儿欲竖功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27616,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戊午除夕泊建溪","author":"许天锡","text":"守岁严城下，维舟积水前。\n春风吹短鬓，夜雨送残年。\n献纳成何事，推敲秪自怜。\n倦来成隐几，飞梦五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27617,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿桃源与同乡简主簿志饮","author":"许天锡","text":"西日衔云叶，南风鼓浪花。\n亭孤留宿鹢，帆远带归鸦。\n岁月惊为客，儿童问到家。\n他乡逢简簿，又作醉生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27618,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画","author":"许天锡","text":"渔家在何处，松坞枕寒流。\n况与上方近，时闻清磬幽。\n柴门掩村雾，小艇钓江秋。\n因忆寻槎客，无缘访十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27619,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寻幽","author":"许天锡","text":"寻幽无此地，可以息尘纷。\n藤络悬崖石，风回出洞云。\n因棋耽晚景，待月续微醺。\n兴尽归来路，飘飘麋鹿群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27620,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游南岩寺抵葛仙洞留题","author":"许天锡","text":"穿岩越壑访遗踪，直度虹桥扣石钟。\n云幕半笼青菡萏，砂床长荐紫芙蓉。\n仙翁化去名犹在，稚子催归兴尚浓。\n欲借鲁阳挥日剑，一川烟水已高舂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27621,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"饮陈侍御风节亭","author":"许天锡","text":"纤尘飞不到霜台，风节亭前长绿苔。\n石榻旧携明月坐，竹窗今为故人开。\n客途只合添诗草，时序都将付酒杯。\n回首苍梧云黯黯，与君愁思望蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27622,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题张文献公祠","author":"许天锡","text":"何处思贤一繫舟，芙容山下曲江头。\n忠诚贯日千秋鉴，风度凌云百尺楼。\n野草荒烟迷故宅，红蘅碧杜满新洲。\n文章事业垂青史，直与双溪万古流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27623,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戏赠李参赞","author":"许天锡","text":"帝邱居士负峥嵘，老去犹为世网婴。\n幕府三年多酿黍，新诗一箧半言兵。\n天骄自保豺狼穴，朔漠空怀骠骑营。\n何日呼韩来稽颡，更题长句赠花卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27624,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新秋即事","author":"许天锡","text":"九城疏雨洗蒸岚，独上高楼看蔚蓝。\n马挟秋声驰塞外，雁将凉信到江南。\n摩娑酒盏酬时节，斟酌方书理宿痰。\n笑我竖儒糜寸禄，安西车马怯征衫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27625,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事","author":"许天锡","text":"小聚村墟入柳斜，青帘红槛两三家。\n插花少妇低临水，藉草儿童乱掬沙。\n莫论酒杯防药饵，还寻诗句答春华。\n清风自觉生双腋，不待卢仝七椀茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27626,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"饮易妙山亭和司空琬韵","author":"许天锡","text":"风磴逶迤到此亭，掀髯长啸骇山灵。\n渐离故宅林枫暗，郭隗荒台野蔓青。\n白水一泓云作液，杂花三月锦为屏。\n醉来不话兴亡事，欲觅青鸾跨杳冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27627,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谒陵","author":"许天锡","text":"仙卫珠邱王气深，百灵朝护郁森森。\n风生虎谷调春律，云起龙池结昼阴。\n玉匣千年留剑舄，金箱终夕动奎参。\n天潢正衍无穷泽，万国于今尽献琛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27628,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"政和旧徒陈生恪至询及南峰读书处","author":"许天锡","text":"见说南峰旧竹林，烟霞长为锁清阴。\n溪边茶灶笋穿破，谷口吟窝花覆深。\n无数青芝生石室，千条白泻下云岑。\n于今苦被尘缨缚，秪恐仙源莫再寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27629,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄鍊上人山房石上梅甚奇","author":"许天锡","text":"一栗禅林傍古台，洞门长为锁苍苔。\n山头旧雨何人到，石上寒梅几度开。\n龛壁光知江月上，塔轮鸣听海风来。\n八千里外常飞梦，疑我前身是万回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27630,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送南光禄署丞徐麟","author":"许天锡","text":"曾共西湖醉画船，镜天花雨忆鸣弦。\n清歌欲坠孤山月，浩气真浮五色烟。\n东省身同将倦鸟，南都官是半閒仙。\n不堪明日河桥别，相对秋堂画烛偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27631,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄华亭博士傅鼎","author":"许天锡","text":"酷怜仙迹旧苍苔，世网那能一面开。\n十载尘埃人易老，五更风雨梦初回。\n春花东阁垂垂树，明月西楼滟滟杯。\n何似云间双白鹤，数声相和更归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27632,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨京兆惠银鱼","author":"许天锡","text":"朝来江渚凿冰痕，献罢随登七贵门。\n几处豆羹尊鲋鮇，谁家玉食厌羔豚。\n霜腴入鼎愁仍解，雪乳浮杯淡不繁。\n抚事独伤千古意，重卿今却贵鱼飧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27633,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄谢邦实","author":"许天锡","text":"八年一夜梅溪口，水悄沙寒晤语多。\n两地尚为愁伯道，半生长似病维摩。\n狂非畴昔惟心在，老易侵寻奈别何。\n熟计浮沈俱拂意，碧山明月负春萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27634,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"人日","author":"许天锡","text":"人日晴明与物宜，负暄忘却宿舂迟。\n融和天地新调律，零落亲朋旧寄诗。\n千里客途蓬梗断，一年春事柳梢知。\n东风只解欺冰雪，不奈霜华点鬓丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27635,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送照磨潭还闽","author":"许天锡","text":"紫薇幕府似仙家，每忆过从早退衙。\n覆地绿云榕接叶，拂檐苍雪荔交花。\n诗成蝌蚪刊脩竹，奕罢旗枪斗细茶。\n京国相逢又相别，不禁清兴绕天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27636,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梨云僧舍饯郑希大","author":"许天锡","text":"半年不到梨云室，送客偶然来赋诗。\n缘息暂依香座息，好怀翻为别情移。\n合欢明日非今日，晤语新知向旧知。\n最是秋风易生感，坐来梧叶落参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27637,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓望","author":"许天锡","text":"清晓才披旧黑貂，门前物色便相招。\n野塘柳待风光动，茅屋霜随日影消。\n听鹤偶来松下径，看泉时倚竹边桥。\n无营更览能偕俗，日被山僧酒伴邀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27638,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"车盘驿道中","author":"许天锡","text":"杨柳风柔荡旅魂，耳边流水咽潺湲。\n青山当面似无路，黄犊出林疑有村。\n途路客怀聊自遣，闾阎民瘼不堪言。\n长安万里家千里，鸟宿僧归日又昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27639,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆江上草亭","author":"许天锡","text":"每到芳春便忆归，梦中江国旧斜晖。\n渚边舴艋有时放，沙上鸬鹚无数飞。\n野兴顿从官后减，封书更觉病来稀。\n年将半百堪惆怅，钟鼎山林意愿违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27640,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次杭考功阙左池上","author":"许天锡","text":"禁籞轻云宿渐飞，九重楼阁曙光微。\n螭头濡笔书言出，鸡舌含香启事归。\n双阙晓风嘘爽气，一池秋水浸寒晖。\n令人却忆西征士，已有新霜上铁衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27641,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题思亲楼","author":"许天锡","text":"楼前旧鹤返长松，松想孤标鹤想容。\n极目逝波千种恨，伤心残梦五更钟。\n窗临东郭当秋陇，帘捲西风自夕舂。\n如此楼居仙所爱，爽灵休上幔亭峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27642,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春暮怀洞江草堂","author":"许天锡","text":"近水茅堂旧乐饥，此时时物正芳菲。\n绿杨深巷黄鹂语，红槿疏篱粉蝶飞。\n春院野云疑我在，夜船江月照谁归。\n十年京国成何事，却被缁尘化素衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27643,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送叶成夫还闽中","author":"许天锡","text":"南征白雁叫秋旻，送尔归骖忆故人。\n月旦有评惭许劭，婚姻不断羡朱陈。\n山间松叶他时醉，洞口榴花几度新。\n怀梓况逢多病后，梦中鱼鸟递相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27644,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大功德寺","author":"许天锡","text":"第一湖山大布金，当时松柏郁森森。\n月明高下楼台影，风静东西钟梵音。\n苔上穹碑春寂寂，草荒行殿昼沈沈。\n劫灰易见如弹指，独倚雕栏感慨深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27645,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄南光禄卿杨公峻","author":"许天锡","text":"千寻古柏出霜林，万里长风称鹤心。\n还椟已完和氏璧，饰钗那用汉宫金。\n春山不碍云双屐，晓镜何妨雪一簪。\n闻说丘园多胜事，老来筋骨更能任。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27646,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送郑司训归玉山","author":"许天锡","text":"三山之外小丹丘，送客归来半醉游。\n倾盖无缘松下问，逢僧有茗草间留。\n夕阳隐地千林暝，皂筴生风五月秋。\n却忆郑虔情更切，茫茫云水一孤舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27647,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓吟","author":"许天锡","text":"千里关山叫断鸿，五更钟鼓报西风。\n酒杯病后如纨扇，诗兴秋来似角弓。\n努力不堪伤老大，悲歌何处吊英雄。\n閒情无那成推枕，又见东方海日红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27648,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送潘司训璋任海南","author":"许天锡","text":"五羊城郭瞰环洲，君去之官是胜游。\n碧玉香分蒲涧水，绿萝阴合荔枝洲。\n渊人慷慨来鲛室，海气依稀见蜃楼。\n勾引十年幽讨意，欲从仙子问浮邱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27649,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题李隐君山庄三首 其一","author":"许天锡","text":"春云如幄荫仙家，千里寻君拂露华。\n傍舍野篱牵药蔓，过门流水带桃花。\n诗情借问谁题竹，酒渴时闻客唤茶。\n长日未将高兴尽，忽惊林杪闹栖鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27650,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题李隐君山庄三首 其二","author":"许天锡","text":"痴儿竟日了公家，忽忆郊原物有华。\n策马独来寻旧约，听莺何处觅残花。\n杜陵稚子能赊酒，甫里先生解品茶。\n坐久不禁诗思搅，向君东壁醉涂鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27651,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题李隐君山庄三首 其三","author":"许天锡","text":"狂客惟思醉作家，困临池馆挹光华。\n青天荡漾鱼跳水，红雨阑珊燕蹴花。\n午饷偶留山客饭，夕凉还赴野僧茶。\n明朝结束应官去，钟鼓长杨听晓鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27652,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬省寮故人","author":"许天锡","text":"小村山馆隔风尘，卉服椰冠称野人。\n五粒寒松苍石古，一旗春茗碧瓯新。\n非无剡曲堪乘兴，少有壶天足抱真。\n应悔鸣驺出空谷，百年何日是閒身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27653,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十月八日雪与诸寮倡和","author":"许天锡","text":"元冥初试发硎铓，屑玉镂花散渺茫。\n画里渔舟归晚浦，吟边风竹泻寒塘。\n窗涵明月三分白，帘绝飞埃半点黄。\n却笑年来衰懒甚，镇龙羔袖锁书仓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27654,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游海珠寺","author":"许天锡","text":"冠山浮动小金鳌，拥出蓬壶控巨涛。\n沙渚南来遗谶在，海门东望暮潮高。\n芳洲碧草连苍霭，上界青莲吐白毫。\n醉卧中泠呼不起，欲招王子奏云璈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27655,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"苍梧閒眺","author":"许天锡","text":"云暗苍梧晓正开，独舒怀抱向高台。\n千年剑在神光现，三足麋鸣使节来。\n越隽西连山似戟，桂江东注水如苔。\n登临不尽雄豪兴，欲倒鲸川入酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27656,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚至平南忆别马参戎澄","author":"许天锡","text":"寒江落日背孤城，海月沙头又欲明。\n千里家乡残梦断，一川烟水暮愁生。\n不辞椰子杯中醉，生怕梅花笛里声。\n陡觉别来消瘦甚，马卿多病更多情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27657,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"安博站偶成","author":"许天锡","text":"跕鸢飞处水如苔，一发青山认宝台。\n压架芙蒥更旧叶，穿林刺竹长新胎。\n村庄野圃春初动，瘴雾蛮烟午未开。\n自是皇恩天广大，平分雨露及蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27658,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过鬼门关","author":"许天锡","text":"隔林啼鸟乱鸣春，才到山巅又水滨。\n老树苍藤含雾雨，层峦叠嶂蔽星辰。\n穿岩越壑驱车险，伐木刊崖取道新。\n生过鬼门关下路，客怀争得不伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27659,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"安南王送赆金礼物辞以此诗","author":"许天锡","text":"歌罢皇华赋式微，春风披拂旧征衣。\n菁茅又喜重苞贡，薏苡何须满载归。\n国主仪文将赆意，使臣朝暮对天威。\n不恭虽愧心如月，留取清光照琐闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27660,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"征妇词","author":"许天锡","text":"明月团团出，闺中夜夜看。\n愿随明月影，一照玉关寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27661,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过姑苏","author":"许天锡","text":"远山如黛接平芜，白鸟分飞里外湖。\n宝带桥头开醉眼，江南诗景在姑苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27662,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚眺","author":"许天锡","text":"暝色遥随旅雁群，戍鼙声动不堪闻。\n可怜天畔登楼眼，不尽南飞一片云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27663,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"偶题","author":"许天锡","text":"朝回困懒坐胡床，无事可消春昼长。\n寻诗不得欲合眼，啼鴂一声花雨香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27664,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东津岸同沈太史何大行晚眺","author":"许天锡","text":"青草黄蒿满野田，溪行尽日断人烟。\n落霞几抺青螺小，此是浔南夕照天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27665,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柳花","author":"许天锡","text":"无赖杨花终日飞，穿帘入座落人衣。\n须怜客子伤迟暮，莫更飞来点鬓丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27666,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画","author":"许天锡","text":"酒筒诗卷足生涯，更爱茅斋傍水斜。\n独倚东风寻句好，一溪春渌涨桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27667,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题小景","author":"许天锡","text":"三叠秋心万里流，萧萧黄叶满汀洲。\n箨冠芒屩诗翁瘦，并作江南一片秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27668,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄黄京兆澍","author":"许天锡","text":"闻君伏枕在虚沟，我亦经旬病裹头。\n一种黄花风雨里，祗应不似故园秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27669,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓发张湾","author":"许天锡","text":"黄鹂啼歇晓阴开，两岸垂杨荫绿苔。\n叶底轻花君不见，暖风吹入短蓬来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27670,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜词二首 其一","author":"许天锡","text":"七宝香台倚素秋，酒阑清切听箜篌。\n八千里外人如梦，月色经年不上楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27671,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜词二首 其二","author":"许天锡","text":"手弄双双交佩珠，不知明月上庭梧。\n秋来正望江南信，塞雁高飞过五湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27672,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"空同席上饯别陈大行愚泉","author":"左国玑","text":"皇士竟纶翰，旋轸适帝乡。\n辕马暂回镳，言税君子堂。\n华洞窅逶迤，绮席错圆方。\n云鸿唳时响，庭木敷春芳。\n昔誉徒结念，今范得俱详。\n客转百岁怀，主称万年觞。\n觞至勿复辞，劝君且解裳。\n竹实本倾凤，雍呜在朝阳。\n神剑慕合并，雄雌苦分张。\n欢娱不终夕，隔别违吟疆。\n岂无他时期，此日难遽忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27673,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]