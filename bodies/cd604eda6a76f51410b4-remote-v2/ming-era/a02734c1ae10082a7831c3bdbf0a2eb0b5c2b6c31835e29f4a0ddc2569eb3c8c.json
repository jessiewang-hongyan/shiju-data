[{"title":"送潘希召节推怀庆","author":"符锡","text":"寂寞当春立，故人应更违。\n百花谁唤醒，一鸟自高飞。\n月傍灵泉迥，诗传楚客稀。\n东风如解惜，连夜款吾扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"一舫斋为倪水部赋","author":"符锡","text":"县知江海客，白首未忘情。\n一舫揭斋地，孤云尽日征。\n按图神自往，绝羽意难并。\n风浪何时净，梦魂犹自惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北河舟中戏柬思行兄","author":"符锡","text":"六月有六日，四旬馀二年。\n焚香祝眉寿，行棹列华筵。\n白发人双健，青云业再传。\n花颜更起舞，真是小神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓思行沙庄呈尊甫南山隐翁三首 其一","author":"符锡","text":"短棹辞喧聒，长林坐阒□。\n岸明花绕舍，畦暗水通潮。\n陶令何曾返，庞公不可招。\n未应经世略，老向此中销。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓思行沙庄呈尊甫南山隐翁三首 其二","author":"符锡","text":"清风竹林下，宛见南山翁。\n高节真无比，芳尊那与同。\n海涛生枕席，花月隐房栊。\n独自怜疏晚，登堂愧阿戎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓思行沙庄呈尊甫南山隐翁三首 其三","author":"符锡","text":"急雨喧茅屋，流云弄夕晖。\n莲衣疏更脱，萤火湿犹飞。\n夜久渔将入，秋来客未归。\n何当更东下，沧海故人稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南舟次韵同志","author":"符锡","text":"南舟一回上，尘想十年虚。\n江月好谁共，村醪聊自如。\n春鸿断遥浦，乡梦稳平湖。\n不是逃名者，庐阳我故居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤阴","author":"符锡","text":"借问汤阴路，皇州第几程。\n雪山人面起，云阵马头横。\n烟火村村莫，樵歌处处声。\n功名是何物，天地苦留情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰墩次韵","author":"符锡","text":"楚畹当年种，江乡何处墩。\n清风宜此老，明月共谁樽。\n细采还纫佩，幽期岂负言。\n汨泥应未得，无梦不沂村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送西泉刘子","author":"符锡","text":"念此灵根别，秋来花正繁。\n楚云思共远，鲁调意犹存。\n揽佩空多感，临风重结言。\n寸怀知浩渺，孤月度江村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣兴","author":"符锡","text":"高卧东窗下，迢迢万里心。\n青山双短屐，流水一长琴。\n候客眠幽径，寻僧过远林。\n渔樵歌互发，虚谷自馀音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送金齿张任之南还","author":"符锡","text":"六街春夜雨，九陌昼连云。\n深树藏啼鸟，危楼澹夕曛。\n飞花轻款款，离思正纷纷。\n酌尽沽来酒，何言可赠君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚翠","author":"符锡","text":"长松跨幽壑，十丈垂高枝。\n兴到每孤往，寤言如有期。\n澹烟秋老处，细雨日斜时。\n杯酒浮生外，惟应白发知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆九万侍乃翁还山阳","author":"符锡","text":"久客忘归路，乡心正淼茫。\n何堪同舍旅，欲别向淮阳。\n县爵非无待，行翁赖远将。\n悬知东海月，今夕满慈堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅龙子道亨","author":"符锡","text":"藜藿怕饥者，污抔照此心。\n不冠常对客，扫月自鸣琴。\n闭户绝尘鞅，开关延道林。\n春风飘楚曲，湘水送清音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乾鹊来巢","author":"符锡","text":"手植庭前树，高枝信鹊巢。\n忘情自来去，何喜用嘐啁。\n岁乙通神处，雄■致力交。\n丁宁汝僮仆，方哺勿轻捎。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"祷雨有感赠石冈吴太守","author":"符锡","text":"为政逢汤岁，何人似我公。\n殷忧怜赤子，引咎吁苍穹。\n一雨四郊足，诸方八蜡通。\n不惭歌颂拙，■备采民风。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书浩然碑有感","author":"符锡","text":"古人今不见，安遣泪双垂。\n早愧平原笔，缘书有道碑。\n纲常元有赖，天地本无私。\n爽气西山在，终然百世师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"获麟古渡","author":"符锡","text":"麟也何为至，千秋见此湖。\n硕人多梗槩，吾道岂蓁芜。\n云卧鱼龙稳，波翻岛屿孤。\n归帆明落日，流转任迷途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟过南昌有怀谢李诸子 其一","author":"符锡","text":"会府经过地，诸贤楷范存。\n阁梅春早别，江月夜深论。\n逝水谁能挽，西山竟不言。\n离人归艓在，无复假招魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟过南昌有怀谢李诸子 其二","author":"符锡","text":"若在仙人馆，章门首重回。\n会风归翼喜，冲雨莫帆开。\n契阔成何事，艰难况此来。\n新诗故满眼，相对不能裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"严太史钤山书屋","author":"符锡","text":"玉人何处住，一室对孤岑。\n池上蓼花白，山中秋意深。\n林穿蒋诩径，座拥河汾琴。\n未觉衣缨在，沧洲更远寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太史同登钤冈 其一","author":"符锡","text":"久矣吾钤望，幽怀迥此开。\n晴空眇南郡，紫阁丽中台。\n日落岩扉瞑，龙归海气来。\n飘飘挟仙侣，乘月放查回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太史同登钤冈 其二","author":"符锡","text":"清秋兴不极，迢递复登山。\n草阁空题字，芳尊且慰颜。\n木喧风渡岭，坛静月临关。\n异景无人会，松巢鹤自还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈通府从师东还寻奉檄督储北上","author":"符锡","text":"师从几月罢，赋董复输燕。\n名岂劳偏著，心因鍊愈坚。\n鱼龙秋浪净，星汉客查连。\n预恐天留佐，虚瞻使节还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郡城登故人楼喜张明府使者还自崇阳","author":"符锡","text":"戍也归何处，清风满郡楼。\n大阿初出匣，小邑有全牛。\n别意惊秋雨，孤怀忆剡舟。\n鷡朋翮未铩，肯被楚云留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄陶大痴邑慱 其一","author":"符锡","text":"南浦经春别，临川不得书。\n山居正寥阒，旅况近何如。\n汝水寒犹菊，蒙田雨自锄。\n醉言妨忤俗，长笑勉教除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄陶大痴邑慱 其二","author":"符锡","text":"江海怜君在，文章逐转蓬。\n汉亭怀孺子，唐碣拜颜公。\n剧话参辰隔，多愁去住同。\n何当似鸥侣，浩荡五湖中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄谢干子","author":"符锡","text":"忆昨燕山别，春寒花事迟。\n蒙园忽秋尽，肥署遣书知。\n白日妨余视，黄精有岁饥。\n拨云与烹月，端合拜君私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"久雨共农人言有感","author":"符锡","text":"天漏渠能补，淋漓日未休。\n豆封泥不甲，畦没潦争流。\n尔病兼无食，予耕尚乏牛。\n为儒惭盛世，徒抱老农忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山庄杂兴 其一","author":"符锡","text":"日长萝径悄，树密草堂深。\n竹几翻书晒，绳床抱膝吟。\n呼儿荷锄出，露顶憩松阴。\n欲共清风举，飘飘吹我衿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山庄杂兴 其二","author":"符锡","text":"谩道吾庐好，闲来有许忙。\n雨移花易活，晴斸药偏良。\n窦石通泉细，隔林鸣籁长。\n微吟缓归屧，松月满山塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"崇阳张二兄寄示汪主政见怀佳作奉酬一首","author":"符锡","text":"得隽张明府，豪吟汪户曹。\n珠投章水媚，云卧楚峰高。\n白日淹骐足，青霄上羽毛。\n不眠歌起舞，纤月送林皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦登钤阁因怀严太史奉寄一律","author":"符锡","text":"何物为灵阁，牵予入梦开。\n瞬将千里目，宛上九层台。\n鸟散青林下，龙□苍渰来。\n夕阳疲思外，天共倚徘徊。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中旧有榴树今春重移一株","author":"符锡","text":"为念仙姿独，频移野伴来。\n低昴各有态，萧散不堪裁。\n狂对东风舞，秾邀暖日开。\n下方殊未厌，何处忆蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送奚贰守应朝","author":"符锡","text":"直北瞻天近，还知是故乡。\n独非陈授职，兼得慰高堂。\n祖帐凌秋浦，寒花摇拒霜。\n梯枯如有待，春色赖渠将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽张尧冕","author":"符锡","text":"回首筠山下，持君是几年。\n清言犹在耳，瘦骨巳重泉。\n古行存流俗，浮名问绝编。\n宁知遗安泽，岐术妙心传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"彭泽归来图","author":"符锡","text":"笑问陶彭泽，归来五老峰。\n柴门流水外，菊径白云重。\n尺泽无横鲵，深山有卧龙。\n脩然千古意，高柱过眉筇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王正提举海北","author":"符锡","text":"雨夜纷羁思，如君更远游。\n方春别帝里，畿日到廉州。\n书问天南使，尊开海北楼。\n岭梅□信早，慰我意曾留。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送谢明府泮之善化 其一","author":"符锡","text":"自昔同门友，未论篪与埙。\n长沙君出宰，岐路我何言。\n阙曙流云淡，江春带雨浑。\n客帆行处远，那复对清尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送谢明府泮之善化 其二","author":"符锡","text":"谩似随阳侣，翩翩不惮烦。\n悯时怀孔席，殊技去齐门。\n骥足谁能絷，虬髯且自掀。\n湖南春酿好，■慰北堂萱。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周良会掌教池口","author":"符锡","text":"一官嗟远去，何限惬情虚。\n教尚江边邑，经横浦口庐。\n庭阴足桃李，宾馔饶溪鱼。\n抱癖京尘者，扪心愧卷舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中遣怀奉呈严陆二大史 其一","author":"符锡","text":"禁城吹角罢，楚客忆乡时。\n病去裁书懒，愁来见月迟。\n屈身贫可仕，混俗志难移。\n菽水清欢地，凉温秪自知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中遣怀奉呈严陆二大史 其二","author":"符锡","text":"旅食春归后，愁躯病厌时。\n天高玉绳迥，家远雁书迟。\n有效方难得，无眠枕屡移。\n平生心一寸，曾许故人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮高宪佥宅","author":"符锡","text":"芳邻高使君，世美洽能闻。\n御带山东臬，名□冀北群。\n绮窗邀白日，锦树截红云。\n漫泧惭知旧，清尊礼遇勤。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周宣统省祭还乡","author":"符锡","text":"帝里怀归客，宁辞溽暑行。\n帆开燕飔满，潮落楚云平。\n遂有林园梦，能忘霄汉情。\n衣冠拜家庆，庭树月华明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送辽东李断事","author":"符锡","text":"黑子关东地，明庭重守疆。\n典戎期士杰，参幕选才良。\n风物饶千里，河山自一方。\n并州翻乐土，莫谩忆咸阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送漆医官还新昌","author":"符锡","text":"何吏堪儒隐，御恩且故乡。\n谩传经世学，还有惠民方。\n江舸明秋月，征袍想御香。\n诗囊问题品，空愧尔师行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王氏园亭","author":"符锡","text":"淮南亭榭好，觉此逾清芬。\n谢树齐森玉，吴峰半出云。\n酬花淹日暮，吟雨坐宵分。\n明发湖西客，尊前谁念群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旅夜有怀兼呈淮南诸故旧时河□匆解望荩臣行李不至 其一","author":"符锡","text":"漂泊淮南客，东归日夜心。\n湖风欺短褐，沙月动长吟。\n旅望天无际，羁愁海并深。\n相期故人在，时复枉舟寻。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旅夜有怀兼呈淮南诸故旧时河□匆解望荩臣行李不至 其二","author":"符锡","text":"寂寥缘抵事，怅望复何之。\n远塞无书雁，寒江有钓丝。\n酒醒馀拂剑，愁在强拈诗。\n行李谁相问，归艖倚断澌。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"待荩臣行李不至雪中酬友人 其一","author":"符锡","text":"淮南裘马客，书剑误归舟。\n酒处花连屋，吟边雪满楼。\n失群怜野鹤，狎水媚群鸥。\n那问狂驰子，东家眇圣丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"待荩臣行李不至雪中酬友人 其二","author":"符锡","text":"南山经岁别，北渚底人留。\n踏雪频过友，看云独上楼。\n渔翻湘浦□，客榜洞庭舟。\n风物亲吴楚，何当散百忧。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠崇一内弟","author":"符锡","text":"吾内有贤弟，芝兰气谊并。\n别离书满纸，相见泪盈缨。\n舟楫空怀济，鱼盐岂避名。\n艰难遂生理，莫忘故园情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仪真逢卢彦四邀题龙江别卷","author":"符锡","text":"我望建康路，君从几日来。\n晓风千嶂合，寒练一帆开。\n牛首山椒寺，凤凰江上台。\n旧游谁复在，潮打石城回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过真州感孙柱史思行不得吊唁写此抒怀","author":"符锡","text":"骢马何轩特，年来遽病衰。\n世途深有倚，天道竟难知。\n十载砂村语，千秋泉路期。\n何当下东郊，抆泪奠新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"康慈寿园","author":"符锡","text":"睿孝褒崇久，慈园宠建新。\n江山知有待，草木自生春。\n垣气盘龙虎，周家瑞趾麟。\n屏翰千赖□，休泽荷儒绅。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽诗","author":"符锡","text":"胡公今已矣，朴德畴能名。\n投老得人在，终身报主情。\n江风开素幕，山雨闇佳城。\n万事忽春梦，空闻猿夜声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢遗笔琴界尺","author":"符锡","text":"琴尺何来此，寒光近眼明。\n导丝行褚直，阁臂展书轻。\n妙得行藏理，频临几按清。\n小童知爱惜，无枉故人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"已邜避地宿宜阳梦绣领二方谩云杜云采色三秋动而首尾俱忘醒念兹游不及秋而黄鸟碧云皆不晓所谓姑续成之以俟","author":"符锡","text":"渺渺沅湘路，征人入梦初。\n晴穿黄岛岭，庙下碧云梳。\n采色三秋动，云程一鸮孤。\n何时重沽酒，风雨谢泥途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长沙有怀古迹五首 其一","author":"符锡","text":"身世一逆旅，漫怀千载音。\n美人伤岁晚，芳杜怨江深。\n本意投鱼腹，犹将悟主心。\n凤麟空下世，衰德涕沾衿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长沙有怀古迹五首 其二","author":"符锡","text":"何处屈原宅，汨罗来问津。\n怀沙甘此水，谋国竟何人。\n汉主恩非薄，贾生才绝伦。\n亦知藩傅远，特遣吊孤臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长沙有怀古迹五首 其三","author":"符锡","text":"海徼皆吾土，浮生任所之。\n若为湘水夕，不置逐臣思。\n落落安刘策，英英吊屈辞。\n雄才掩千古，慷慨有馀悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长沙有怀古迹五首 其四","author":"符锡","text":"杜子湖南日，年衰世路迷。\n鸥波怜泬寂，渔艇漫依栖。\n巴道仍妖梗，秦天出汉低。\n文章竟何用，名字谪仙齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长沙有怀古迹五首 其五","author":"符锡","text":"湖南闻自昔，风壤慨重过。\n地阻铜标远，云深草泽多。\n朝廷忧赤子，司牧慎催科。\n疲民万无赖，往辙鉴如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再至辰阳假寓龙兴寺喜诸友见过","author":"符锡","text":"他日趋庭客，春鸿迹谩寻。\n洞门过道侣，虚室憩禅心。\n山带城隍老，江分草树深。\n静闻龙雨去，还傍洗尘襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"呈陶明府 其一","author":"符锡","text":"长官贤孰似，平易近人人。\n彭泽家风远，河阳惠政新。\n边隅花作县，幽洞鸟鸣春。\n骥足时看展，无誇汉吏循。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"呈陶明府 其二","author":"符锡","text":"岂谓诸侯客，江湖一老生。\n畏人常屏迹，通籍竟虚名。\n索莫登楼兴，留连倾盖情。\n宠招时命骑，山寺往来轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]