[{"title":"送郑元美致政还闽二首 其一","author":"吴琏","text":"萍水论交四十春，几清官况几归人。\n芝兰气味久弥笃，道义心情老更真。\n珠海沧波秋月夜，湖山烟树暮天云。\n相思何日能相慰，珍重来书莫算频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑元美致政还闽二首 其二","author":"吴琏","text":"一跳尘关万里回，百年天地心悠哉。\n葡萄泼瓮酒初熟，黄菊满篱花正开。\n高屐瘦筇新径里，短歌长咏小山隈。\n纷纷来往门前客，争讶神仙何处来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李元善 其一","author":"吴琏","text":"极品谁言下品官，先生交义老弥尊。\n人逢万里常相问，情重三年两造门。\n诗寄山中新意好，金悬腰上旧心存。\n茫然一去无消息，我泪汪洋涨百川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭李元善 其二","author":"吴琏","text":"百疏金门疏疏通，清时谁不羡人龙。\n一方伯爵心常苦，二品官囊日屡空。\n黄鸺羽垂云黯黯，紫薇花萎雨濛濛。\n蛮司官长蛮山獠，洒泪含悲想望中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"珠江别意卷送冯汝清 其一","author":"吴琏","text":"文旆向神京，衣冠饯梵亭。\n酒怀天共阔，吟兴水同清。\n欲别难为别，分行未忍行。\n江深不见底，端的似离情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"珠江别意卷送冯汝清 其二","author":"吴琏","text":"烟波千里去，村巷几时逢。\n黄菊香谁共，青山兴自浓。\n官资随分转，音信逐时通。\n莫记门前柳，殷勤答圣躬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潜避城中感事漫成","author":"吴琏","text":"万里烟波一短蓬，白头闲卧海之东。\n瞳瞳门外严冬日，细细榕阴盛夏风。\n伏枕喜看眠已稳，出门深欲耳双聋。\n闲来试检申屠传，从始雍容看到终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和江桂轩先生韵","author":"吴琏","text":"五十辞官六十来，老怀长向酒中开。\n春深紫蕨盈筐采，雨后芳兰绕径栽。\n讲诵诗书儿满眼，品题风月稿成堆。\n细观身外浑閒事，一枕方床日几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闽令刘公升肇庆府判来访诗以奉答","author":"吴琏","text":"闽下新哦蔽芾诗，一官清誉四方驰。\n霜威未降炎先退，阳气将萌物已知。\n文辙东愁行大急，仙舟南望到何迟。\n名医囊里皆良药，细诊民痍对症施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"电孙生于闽允祯以电名之书报即惊其命名失于所择后果早殁正如电虽光而不久也诗以哭之","author":"吴琏","text":"万里庭阶长瑞兰，老翁衰病即怡颜。\n一封书堕数行泪，三尺土堆何处山。\n灵迹远从闽岳降，旅魂应望故乡还。\n始闻名电微惊怪，闪烁浮光一瞬间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫笔 其一","author":"吴琏","text":"三尺龙泉耀日光，深山韬历几星霜。\n试将磨洗岩前水，瑞气腾空鬼魅藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫笔 其二","author":"吴琏","text":"一事无成六十馀，胸中豪气竟何如。\n幽情止有沙鸥识，莫怪无人问竹庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吕望","author":"吴琏","text":"八十江头老钓翁，时来人自识非熊。\n后车远载腾腾去，四海升平指顾中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孔明","author":"吴琏","text":"三顾频烦草屋中，奋然扶汉一心雄。\n当时不入英雄眼，谁识南阳有卧龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘方伯朝觐","author":"吴琏","text":"捧檄承宣岭海滨，紫微深处荡皇恩。\n五风十雨年年事，万壑千岩处处春。\n度律北来民物轨，衣冠南去帝王宾。\n朝端亦有江南客，拜舞雍容借冠君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林宪长朝觐","author":"吴琏","text":"北台桓典车南行，五月六月秋霜横。\n穿窗透帘月皎皎，惊远惧迩雷轰轰。\n幽明万里献天子，黜陟一邦钦众情。\n眼底阴阳候调燮，普施霖雨济苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃源吟","author":"吴琏","text":"清世桃源卧闲叟，数把尘衣上山抖。\n清风明月满洞岩，野草幽花遍林薮。\n于四时美景良辰，邀几个良朋好友。\n临清风诗几首，对明月酒数斗。\n见幽花采盈手，踏野草足不蹂。\n軥辀林外数声啼，麋鹿山前几回走。\n吟复吟，吟成纸上风雷吼。\n饮复饮，饮后衣裳绝尘垢。\n大笑数声天下闻，闻者或讪亦或嗔。\n一笑石榴开口频，一笑老蚌徒含珍。\n一笑石季伦，倘来富贵终杀身，杀身因溺坠楼人。\n一笑李斯欲固秦，焚书坑士愚黎民，东门黄犬空狺狺。\n一笑吴竹庐，不肯少屈以自伸，五十弃官归隐沦。\n一生忠悃无地陈，治具满怀空自春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送花张东所","author":"吴琏","text":"白白堂前一树花，晓香缭绕入窗纱。\n试将赤手涵清露，摘送城西逸士家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"示可大孙时方十一岁","author":"吴琏","text":"冉冉浮光一掷梭，明年年并古甘罗。\n诗书万卷翁能积，义理千层汝自磨。\n块土谩堆终是塔，涓流不息自成河。\n莫言幼小无加勉，少妇腾腾是阿婆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅 其一","author":"吴琏","text":"月到稍头月愈光，雪飞稍外雪辉煌。\n鱼吞池影腹应洁，鸟宿岩枝魂亦香。\n庾岭古崖闲自白，罗浮深坞为谁芳。\n疏枝冷蕊荒篱外，谁识相寻一到旁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅 其二","author":"吴琏","text":"松竹冰霜共此贞，一生真不负魁名。\n横枝笼月影偏好，老干放花香更清。\n驿使寄人情始雅，鼎羹需实味方成。\n寻香幸际晴明日，莫踏漫天夜雪行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苍崖为大历彭处士作","author":"吴琏","text":"高怀何处足幽栖，万仞峰头一杖藜。\n苔拥石傍云掩映，锦铺岩下树高低。\n藤枝拖雨猿争下，草色连天鸟乱啼。\n欲到个中一寻访，恐劳磨石记新题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送本邑杨大尹入觐","author":"吴琏","text":"湖右文章伯，江南父母官。\n三钱斗米价，一雨万家村。\n远远享天子，高高飞凤鸾。\n明年二三月，黎庶眼将穿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江村暮景","author":"吴琏","text":"远近山光淡，苍茫树色微。\n贪閒人睡早，恋食鸟归迟。\n蛇虎纵横出，蚊虻散乱飞。\n晓看红日上，又是大明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"城中遣怀","author":"吴琏","text":"投老卧州城，山村月未明。\n旧齑春味好，新韭晓香清。\n黄卷儿童业，芳樽故旧情。\n一心随所寓，踪迹任浮萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桢尹怀安诸儿在学偶作自遣","author":"吴琏","text":"男子分明百事堪，人情谁不愿生男。\n河东三凤已多二，荀氏八龙还欠三。\n一坐琴堂春澹澹，四开黄卷夜喃喃。\n不知天意诚何似，只各辛勤老自甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶遇陈习之于途邀至家出诸郎劝酒","author":"吴琏","text":"四十年中一故知，乍逢疑是复疑非。\n嘉殽密饯新篘酒，高兴频哦旧寄诗。\n洒洒笑谈浑故态，訚訚纡袂尽英儿。\n相看可预为君贺，多却燕山桂一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和邝敦仁游白云山韵","author":"吴琏","text":"白云高觉四山低，中有源泉注百溪。\n洗耳涧边清彻骨，振衣岗上净无泥。\n谈间适意言何尽，天际轻阴日未西。\n屐稳路平行易易，免教前路鹧鸪啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和敦仁游月溪用前韵","author":"吴琏","text":"萦纡松径路高低，三扣禅关见月溪。\n千岭南横千岭北，一池东注一池西。\n飞云洞阔无遮日，过雨林深未湿泥。\n满日助吟吟不尽，小禽何处数声啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄康孙 其一","author":"吴琏","text":"长大聪明幼可观，诗文能诵说康孙。\n他年定笑而翁拙，四十馀三始作官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄康孙 其二","author":"吴琏","text":"长大辛勤幼可观，诗文频诵说康孙。\n他年定笑而翁懒，五十馀三即弃官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"写怀时允祯初应召","author":"吴琏","text":"无官真觉一身轻，晓罢厨烟睡正醒。\n对客日无辞酒意，教儿时有读书声。\n一犁秋垄输官早，几箔春蚕报茧成。\n试问怀安近消息，圣明行召到神京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和同年滕侍御见寄韵 其一","author":"吴琏","text":"井不停污井自清，镜频磨洗镜常明。\n座前草长翠交翠，花外鸟啼声接声。\n新隐要加新样学，老闲应习老农耕。\n藏机露拙谋身计，天性由来怕近名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和同年滕侍御见寄韵 其二","author":"吴琏","text":"碧山深处暂逃名，舆羽钩金别重轻。\n能勿忘时须勿助，既无将处亦无迎。\n曾参属纩且易箦，子路蹈危还结缨。\n不是苍天与良弼，筑夫那出为调羹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和同年滕侍御见寄韵 其三","author":"吴琏","text":"久坐专城鬓已班，一封投乞卧青山。\n畅怀美酒频招饮，得意新吟每自删。\n花径有苔闲自扫，竹门无事镇常关。\n桃源深处成深隐，无复渔郎到此间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集古寄滕吉甫侍御 其一","author":"吴琏","text":"一别侵寻二十年，中间消息两茫然。\n故人若问吾何况，头白纷纷只醉眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集古寄滕吉甫侍御 其二","author":"吴琏","text":"宦情文思竞阑珊，年去年来两鬓班。\n独向高斋展衾卧，了然尘土不相关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集古寄滕吉甫侍御 其三","author":"吴琏","text":"久脱朝簪岸幅巾，疏慵闲托草堂身。\n年来渐识幽居味，着处题诗发兴新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集古寄滕吉甫侍御 其四","author":"吴琏","text":"抛官九载卧柴扃，酒满螺杯月正明。\n感激大恩何以报，空然惭汗仰皇扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感事","author":"吴琏","text":"青骢迢递一旌持，日烈霜横鬼魅知。\n流放不谈谈齿决，豺狼无问问狐狸。\n连村惨澹云霞黑，一路沧凉草木悲。\n珍重古来强项者，堂堂宫事不容私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜元恶伏诛","author":"吴琏","text":"黄河千派忽澄清，四海喧然诵太平。\n障日浮云旋自散，洗天凉雨为谁倾。\n辉辉当路消狼迹，赫赫朝阳起凤鸣。\n老眼久期应见此，新诗聊作慰苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺张都阃乔迁用张东所韵","author":"吴琏","text":"天宠新承地位高，暇观风雅次离骚。\n春风泼面人情好，古略蟠胸胆气豪。\n扪虱倚墙谈世务，赋诗横槊挂征袍。\n淩烟诸老名千古，都在忠诚一念操。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃源八景九首 其一","author":"吴琏","text":"井脉连江水自清，桥拖岚气碧云凝。\n小池洗砚鱼争跃，高树迎轩鹊乱鸣。\n径竹日筛金锁碎，坞莲风拂座香馨。\n宦园藜杖逍遥后，吟弄松阴一小亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃源八景九首 其二 松阴亭","author":"吴琏","text":"万松岭上松阴亭，松阴盛夏风泠泠。\n老翁午睡忽惊觉，何处鸟啼三四声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃源八景九首 其三 通潮井","author":"吴琏","text":"一脉连江水气通，时消时长与潮同。\n供炊来往人何限，饱后都忘造化功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃源八景九首 其四 灵鹊枝","author":"吴琏","text":"挺挺高枝势入云，喳喳灵鹊噪声频。\n年来喜事知多少，珍重时时报主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃源八景九首 其五 通云桥","author":"吴琏","text":"袅袅垂虹跨紫霄，彩云深处路迢迢。\n少年倘遂男儿志，何必乘车过此桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃源八景九首 其六 莲花坞","author":"吴琏","text":"红莲艳艳碧莲开，风细馀香远近来。\n藕大如船花十丈，结窝何必问蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃源八景九首 其七 乌宦园","author":"吴琏","text":"乌宦名园古所闻，古人佳致属今人。\n一林风月年年在，吟弄依然只缙绅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃源八景九首 其八 万竹径","author":"吴琏","text":"万个萧森一径遥，逼人清气日飘飘。\n瘦藤短帽闲来往，立听微风奏凤韶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃源八景九首 其九 洗墨池","author":"吴琏","text":"云影天光一鉴开，墨波微动晓风来。\n细看洗砚鱼吞句，知是青山老骏才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"祭墓见乞者可笑因成一绝","author":"吴琏","text":"手展坟东眼转西，风中沈醉雨中迷。\n清明节过墦间静，东郭杖藜归未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八喜","author":"吴琏","text":"逐臣还旧职，稚子试新衣。\n狱客来天赦，盘鱼入巨池。\n晋闻淝水捷，汉解白登围。\n少妇孤帏久，夫从远戍归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺江桂轩华诞","author":"吴琏","text":"南极祥光入夜清，瑶池仙品献华庭。\n堂前丹桂参天秀，腰上黄金耀日明。\n老鹤万年翎濯濯，南山千古色青青。\n鲰生拜舞还深祝，坐睹云仍列帝城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺杨大尹升德庆州守","author":"吴琏","text":"仙舟南海去，竹马峡山迎。\n好雨知时下，凉风到处生。\n砚山包肃庙，香浦隐之亭。\n历览能追忆，低昂万古名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴斗南谓人生须行乐何拘拘不出写以奉答","author":"吴琏","text":"人各持一心，心各主其事。\n显晦道本同，语默理无二。\n鲁男深闭门，柳公置怀次。\n凁水时拒妾，东山日携妓。\n伯夷耻周粟，太公赞周治。\n严陵戏横足，尼父肃屏气。\n辟佛闻韩公，押僧见苏氏。\n闭门著道德，历国说仁义。\n汲黯摅直忠，陈平弄奇计。\n独醒沈汩罗，盗饮卧邻地。\n谁适更谁莫，谁非更谁是。\n君子何必同，亦仁而已矣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"进贤王都宪公子以官生入监奉使于岭南过馆话旧赠之以诗","author":"吴琏","text":"使节煌煌耀草莱，钟陵情抱眼中开。\n清平旧识诸耆硕，雄猛新闻几俊才。\n太学何蕃情绻绻，柴桑陶令鬓皑皑。\n遥知宦辄南行日，翠竹庭阴几度来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣怀","author":"吴琏","text":"经春不到门，衰病老闲官。\n万虑镇常扫，一身殊自安。\n睡浓清梦远，心静草堂宽。\n马系垂阳下，阴风处处寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽司马刘东山 其一","author":"吴琏","text":"舞雩春暮树婆娑，清世谁同一咏歌。\n卓尔泰山耸云汉，屹然铜柱障江波。\n调元痛失雷司户，医国伤无晋叔和。\n寄语城狐已投阱，洞云深处笑呵呵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽司马刘东山 其二","author":"吴琏","text":"一咏甘棠岭外喧，塞尘狼火静沿边。\n常遭厥愠常驰誉，不怍于人不愧天。\n丹凤碧梧鸣盛世，冷风寒徼痛残年。\n自惭莫遂抠趋愿，空学侯巴忆太玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴斗南别号西庄","author":"吴琏","text":"元亮归去来，欲与市尘绝。\n何当过行轩，推窗玩新月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨景昌宴会林别驾席中成诗在席者各次其韵","author":"吴琏","text":"乌巷深沈古谢家，衣冠文彩绚飞霞。\n铿金戛玉宾吟富，列鼎焚沈主宴华。\n醇酿饮馀加烈酿，菊花丛里灿梅花。\n醉来身外浑忘却，疑在仙河共泛槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用前韵自述 其一","author":"吴琏","text":"渺渺烟村逸士家，远天孤鹜衬飞霞。\n松稍郁郁淩霜气，草尾垂垂阁露华。\n眼到江山浑是兴，春来红白自开花。\n家藏斗酒需时久，携向沧江问钓槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用前韵自述 其二","author":"吴琏","text":"古洞烟村三四家，桃花二月蒸红霞。\n锄芸直慕老莱子，蘋藻岂须阴丽华。\n入馔白鱼来碧海，研朱清露滴梅花。\n故人天上知多少，谁问沧江老钓槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用前韵自述 其三","author":"吴琏","text":"四海冠裳共一家，可容衰朽老烟霞。\n边尘不动虏还虏，弦诵霭然华自华。\n恋主蚁蜂真异种，向阳葵藿实名花。\n孙阳眼到成高价，未信张骞独去槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次前韵答邹邦范见寄","author":"吴琏","text":"汉宋流芳积善家，胸蟠星斗气蒸霞。\n棘场梁灏心还壮，诗社林逋鬓未华。\n万里秋香蟾窟桂，一林春色杏园花。\n文王台畔霜髯老，还记沧江旧钓槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张东所承荐北行诗以奉赠","author":"吴琏","text":"事道宗尼父，谈仁法孟翁。\n圣贤无二道，千古此心同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":53843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]