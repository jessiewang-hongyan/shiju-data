[{"title":"钤山夜别简侍御得宽字","author":"严嵩","text":"柱史来天上，相过坐夜阑。\n霜威清暂假，月色好同看。\n晨渡河冰壮，春浮楚泽宽。\n台臣纲纪地，送子见才难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33503,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阳春书院唐朱二侍御邀集","author":"严嵩","text":"阳春院里花仍发，不饮其如春色何。\n高台曲沼人能到，迟日浓烟景自多。\n犹怜绿水飞鸿雁，更著兰舟采芰荷。\n章郡升平异前日，时邀骢马一相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33504,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"薛楼宴集次汪户部希会是日出师捕安义之寇","author":"严嵩","text":"城外章江碧草春，城头高阁绮筵新。\n野航受客还依渡，江燕穿花不避人。\n山川南国登临在，今古浮云感慨频。\n战舸眼边连夜发，捷书早报放吾颦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33505,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜登明远楼同王阳明中丞唐朱二察院","author":"严嵩","text":"遥夜肃已静，朗月照重湖。\n风窗倚天汉，星峤临蓬壶。\n的的徐亭树，寥寥霜署乌。\n微言欢欲奉，清赏未云徂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33506,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龟峰寺 其一","author":"严嵩","text":"森森荫水柏，暝暝入山烟。\n始惊灵境绝，忽步翠微先。\n异状群峰出，幽探万虑捐。\n心期驾鸾鹤，从此问真仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33507,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龟峰寺 其二","author":"严嵩","text":"鸟鸣芳树暗，云度碧峰阴。\n春益林峦秀，山围洞壑深。\n青莲窥色相，绿竹动讴吟。\n人世那逢此，丹溪一一临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33508,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上巳玉山集 其一","author":"严嵩","text":"岩嶂何盘郁，汀洲复渺绵。\n江深迷草树，林霁净风烟。\n兰叶修春禊，杨花对别筵。\n不醉河阳酒，愁心益惋然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33509,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上巳玉山集 其二","author":"严嵩","text":"怀玉今辰到，官亭憩晚晴。\n连山雨渺渺，独树花盈盈。\n对酒三春暮，离家一月程。\n旧窗园木暗，惆怅忽闻莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33510,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塔山望","author":"严嵩","text":"初闻流泉响，渐入深林间。\n灵峰窥宝塔，竹径款禅关。\n晻暧花覆谷，空濛雨映山。\n回看万壑里，云雾渺人寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33511,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自西湖入灵隐上天竺","author":"严嵩","text":"苏桥初进艇，露峰忽振衣。\n三竺开丹鹫，诸天在翠微。\n涧水浮花片，松磴锁烟霏。\n屈折岩扉到，萧条苔径归。\n藉草还留酌，闻香顿首机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33512,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉兴三塔寺留别朝仪子谦二使君年丈","author":"严嵩","text":"三塔移舟望若仙，穹林翠壑俯江烟。\n莺花对酒城春丽，钟梵登楼海日先。\n世路无端频送客，空门不碍拟逃禅。\n与君更是燕吴别，冲雨开帆各惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33513,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虎丘寺侍少傅守溪公游奉次高韵 其一","author":"严嵩","text":"禅径香台访碧山，玉堂黄阁奉台颜。\n乍挥藻翰花争丽，久脱朝簪鹤并间。\n林下看云松影静，岩边著屐藓痕斑。\n分明仙舸中流坐，瞻送宫袍月下还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33514,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虎丘寺侍少傅守溪公游奉次高韵 其二","author":"严嵩","text":"潭渚逶迤草树重，上方台殿隐孤峰。\n清辉夜吐吴城月，虚籁寒生梵院松。\n窗瞰浦云宜引望，石留僧讲谩遗踪。\n移舟更欲归城市，惆怅青山日暮钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33515,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东平遇雨","author":"严嵩","text":"急雨来东郡，萧萧乱入云。\n祷祠诸路见，亢旱一春闻。\n风疾吹疑断，天高洒易纷。\n都饶万民望，吾亦洗炎氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33516,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"莲花淀舟泛","author":"严嵩","text":"沿洄洲渚异，演漾水云空。\n绿荷初冒日，青蘋解起风。\n唳鹤横天迥，眠鸥炯云同。\n会意聊自适，望美转难穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33517,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卢沟桥","author":"严嵩","text":"逝波与行客，汨汨无时休。\n猊蟠明积雪，虹饮亘长流。\n晓月迷征骑，春沙压弊裘。\n经过道傍寺，暍思且淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33518,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆钤山寄溪亭明府","author":"严嵩","text":"小径升堂绿桧长，翠屏终日对钤冈。\n丘园物色闲闲在，朝市风尘事事忙。\n尚忆琴尊同笑语，最怜风雨发舟航。\n朝来马上逢乡使，为寄新诗当八行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33519,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南京户部后池双莲同干大司徒王公邀赋","author":"严嵩","text":"朱夏尚书省，池莲表异祥。\n绛葩开并蒂，青乳结连房。\n晻薆红云丽，披翻翠盖长。\n文鸳纷比翼，振鹭俨分行。\n引类何猜妒，淩波故颉颃。\n灵妃泛湘浦，赵女入昭阳。\n照月平分影，迎风倍有香。\n瑞呈鲛室外，盛过鲤湖傍。\n旱暵忧方剧，芬敷理讵常。\n气和占圣世，地重切公堂。\n嘉木歆连理，灵芝颂九光。\n予惭职歌颂，留赏滥华觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33520,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初拜留院少师相公赠诗用韵拜酬","author":"严嵩","text":"金陵楼阁倚天开，玉署晴云覆禁槐。\n荐赋敢晞文似者，拜恩真荷帝俞哉。\n鸿钧播物宁论德，豹管窥斑却愧才。\n拭目庙堂歌喜起，五星重聚凤凰来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33521,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉酬汪石潭宗伯","author":"严嵩","text":"八座高衔礼绝攀，两朝清望重于山。\n招延隽老皆登用，揣量非才合置閒。\n驽骀岂复思千思，广厦终期庇万间。\n谁意用儒逢世理，一尊相属重开颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33522,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉酬翟石门兄","author":"严嵩","text":"春明别棹问南京，谁道君犹羡我荣。\n恋阙巳瞻红日远，忝官仍喜玉堂清。\n鸠巢计哂经营拙，鱼饭心怜去住轻。\n十七年中同宦侣，细论离合倍关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33523,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夕次潞河怀寄馆阁寮友 其一","author":"严嵩","text":"朝游燕台上，夕宿潞河滨。\n空洲牵积水，广陌足流尘。\n情忆离尊满，年伤别袂频。\n玉署星辰切，金陵月露新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33524,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夕次潞河怀寄馆阁寮友 其二","author":"严嵩","text":"虚薄忝朝籍，文馆厕英寮。\n萝施攀松柏，葭倚接琼瑶。\n鸟有同栖树，鱼怜独上潮。\n江海参辰隔，流盻极春霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33525,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春迎慈圣歌 其一","author":"严嵩","text":"绿水云摇帐殿开，龙艘日照锦帆来。\n千盘玉膳分船进，百骑银珰奏御回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33526,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春迎慈圣歌 其二","author":"严嵩","text":"御气金门起郁蟠，至尊当殿候鸣銮。\n玉食直移九州养，龙楼长奉万年欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33527,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春迎慈圣歌 其三","author":"严嵩","text":"濮园议礼伸舆论，代邸崇恩本圣情。\n正阳文母遵门入，五凤英皇却辇迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33528,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东昌驿下逢少保鹅湖相公赴召，是日大行人赍敕迎劳适至，敬抒赠贺","author":"严嵩","text":"直道谁云竟忤时，如公亲结九重知。\n大贤出处关朝运，圣代谋谟重鼎司。\n龙纸才开天咫尺，使轺重遣路逶迟。\n试论再入中书事，文吕于今复见之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33529,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德州董子庙","author":"严嵩","text":"董生读书处，寂寞临高台。\n门墙窥孔室，编简拾秦灰。\n业守三馀积，宫存一亩开。\n墨池春草遍，园木晚禽来。\n独有贤良策，人称王佐才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33530,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"翰林斋宿","author":"严嵩","text":"郊禋元岁盛声明，玉署深寒宿旧京。\n长乐听钟天已远，钟陵对雪梦犹清。\n池头星斗归环佩，城上风云飐旆旌。\n鹓侣此时皆侍从，綵毫春色赋初成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33531,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汪司成学省斋宿寄赠","author":"严嵩","text":"清宵琴铎静斋庐，怅望无因奉起居。\n寺近独吟孤嶂雪，烛明亲校六堂书。\n云中比翼瞻鸿雁，河畔开缄忆鲤鱼。\n渐拟谢池春草发，清诗幽梦复何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33532,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"祷雨晓出神乐观","author":"严嵩","text":"灯火严城启，楼台秘苑通。\n精明石坛月，凄断柏林风。\n望极仍延伫，忧深尚蕴隆。\n瓣香勤祝史，何以格皇穹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33533,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钦佩南原草堂集别","author":"严嵩","text":"梁宛乘骢马，秦淮掩竹扉。\n因怜奉丹诏，不得羡荷衣。\n古屋秋山近，清池夕鸟飞。\n故人从此去，吾至欲何依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33534,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄子伯固昔为兵部郎官率同列谏止巡幸，被杖斥归。今上登极起为南京大理丞，奉表入贺饯以是诗","author":"严嵩","text":"明到凤楼听漏日，汉仪重睹泪堪垂。\n伏蒲旧侣谁同在，荐藁芳名帝独知。\n骅骝逸步谙长道，鹓鹭崇班恋赤墀。\n凭将金鉴千秋录，为献南山万寿卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33535,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张子常甫自翰林出督学旋以病告寄赠","author":"严嵩","text":"登朝与子最情亲，院宿郊游事巳陈。\n暂失凤池官自好，重归山径业犹贫。\n遍栽松菊疑真隐，且废讴吟惜病身。\n燕乳蝶飞烟草绿，相思难寄秣陵春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33536,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新作院署之堂汪司成投赠佳篇用韵和酬 其一","author":"严嵩","text":"偶锄荒圯得清深，更置芸编对素琴。\n凉吹泻轩翻竹韵，朝阳临砌捧葵心。\n高依凤阙知天近，净扫蛩阶与月侵。\n幸有大贤携晚进，文觞几度惬幽寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新作院署之堂汪司成投赠佳篇用韵和酬 其二","author":"严嵩","text":"金銮西畔玉堂深，凤沼云泉滴暗琴。\n巳藉典谟开骏业，更留烟月寄閒心。\n池栽脩竹藏莺语，亭覆荒碑见藓侵。\n牛渚故逢仙子问，桃源不遣世人寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭司业官舍閒咏 其一","author":"严嵩","text":"阶西众山处，重到有馀情。\n地是名贤宅，庭栽古柏成。\n夕岚迷叠嶂，秋雨过高城。\n最爱摊书坐，窗灯映竹清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭司业官舍閒咏 其二","author":"严嵩","text":"前日瀛洲侣，同来白下居。\n真能忘尔汝，时复到阶除。\n鱼笋供常宴，朱铅校古书。\n南都官况僻，暂免听朝车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郭司业官舍閒咏 其三","author":"严嵩","text":"池宽新雨后，山翠夕阳时。\n秀句无心得，幽怀只自知。\n暮钟来古寺，秋槿遍疏篱。\n欲践移尊约，新凉月色宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬和少宗伯汪先生省中步月见怀之作 其一","author":"严嵩","text":"南宫风露溢清寒，华月当窗转玉盘。\n始信仙踪隔尘土，漫怜浮世有悲欢。\n茶烹石鼎分池雪，香爇金垆和泽兰。\n忽荷云章寄琼署，欲携春兴伴花坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬和少宗伯汪先生省中步月见怀之作 其二","author":"严嵩","text":"夜深高咏在虚亭，无柰蟾光影竹青。\n对树栖鸦眠自在，傍城更柝语丁宁。\n歌馀白雪翻瑶瑟，兴入沧洲拂画屏。\n人事故逢清景少，赏心长为碧云停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石潭先生荣进吏侍兼副史局用韵贺赠","author":"严嵩","text":"凤日龙霄近欲攀，仙踪元只在蓬山。\n尽誇荣宠从今盛，长拟门庭似旧閒。\n群才总属陶钧地，一字犹严衮斧间。\n当日相从今远别，玉堂凉月梦清颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王中丞赴召前在豫章有平难之绩","author":"严嵩","text":"绣斧清霜避，楼船绿水开。\n风云千历会，麟凤众贤来。\n投老仍严召，当途赖上才。\n向来筹策地，投檄净烽埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠林大理茂贞","author":"严嵩","text":"尔别河桥系我思，柳枝攀赠绿烟丝。\n中兴奏议看前辈，南国声名重棘司。\n今古秪应荣节槩，圣明奚忍负恩私。\n明庭此去观夔契，好续徂徕圣德诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨侍御使蜀","author":"严嵩","text":"江草萋萋江水长，使轺闻欲度潇湘。\n开帆夜坐星河色，载笔春吟杜若香。\n綵绣过家非旧服，皂囊还阙有新章。\n西州五月无炎暑，应避青骢满路霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"待月集宗伯凤山邸第","author":"严嵩","text":"风梧翻夕籁，云叶漏轻光。\n东林初上月，华馆更留觞。\n寅清欣务简，宴语接宵长。\n方占德星聚，复咏柚华芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送礼侍吴公赴召","author":"严嵩","text":"文昌星彩动南宫，徵拜三卿宠数崇。\n承旨故随宗伯后，致辞初入谢班中。\n披云近睹长安日，击水高抟渤海风。\n朝省事频閒日少，回看烟月忆江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蒋户侍省墓送赠","author":"严嵩","text":"楚江秋潦净，巴岭夕云重。\n烟鸟随孤舫，乡山到万峰。\n窗园馀旧菊，墟墓长高松。\n国计遥相待，期君隔岁逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠邵佥宪","author":"严嵩","text":"幽兰閟芳馨，白璧怀坚贞。\n端居不踰阈，奕奕当世名。\n剡荐驰云陛，鹤书贲柴荆。\n直道昔忤时，今为士所荣。\n始感白日照，亲见黄河清。\n恭翼承皇命，慷慨发脩程。\n骢车列城避，鸟道千峰行。\n水邮经楚甸，海峤浮昆明。\n饮冰徇苦节，击隼蜚英声。\n挥手自兹别，许身良不轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉送司寇赵公入觐","author":"严嵩","text":"群公得句锵鸣球，司寇引杯登綵舟。\n金函奉表江东发，银汉乘槎天上游。\n六月沧洲不知暑，夜泊风烟渺何许。\n远势斜分清泗流，新凉早入长杨树。\n羡公怀抱有馀清，临流见月几诗成。\n调高白雪谁同和，行爱青山自问名。\n公今去国巳经时，星履重来上赤墀。\n皋陶淑问持邦宪，阅道清忠结主知。\n纯皇当日擢群英，三十馀年并列卿。\n庙堂正藉经纶业，江海犹传冰糵声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠寇京兆","author":"严嵩","text":"宦情乡思渺难裁，怅望春帆带雨开。\n芳草不堪频送客，暮云何处独登台。\n闾阎解说循良政，廊庙元须卓异才。\n借问府中林馆胜，棠花应候使车回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠边太常黎银台北觐 其一","author":"严嵩","text":"两乡南国望，同上赤墀行。\n接羽鹓鸾贵，论言玉雪清。\n冠裳临伟饯，风雨发严程。\n遥羡川途兴，新诗几许成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠边太常黎银台北觐 其二","author":"严嵩","text":"莽莽龙河雪，双帆几日开。\n亦知从此别，巳是隔年回。\n珂马春城并，衣冠晓仗催。\n驿亭梅柳色，来往送行杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春神乐观饯方使君","author":"严嵩","text":"登临南郭久相期，忽漫看山是别时。\n童子正宜春服咏，使君莫为一尊辞。\n林中坐石焚香静，花里穿云出洞迟。\n欲赠美人无缟纻，石坛折取古松枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠少司寇胡公赴召","author":"严嵩","text":"秣陵佳胜几招邀，公去风骚叹寂寥。\n?俊总登台鼎地，乾坤今睹圣明朝。\n鹍鹏击水辞瀛海，鹓鹭排云上紫霄。\n黄花送酒期留醉，沧浦鸣榔惜去遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠太宰罗公归省","author":"严嵩","text":"宁亲诏赐驿舟行，祖席南都尽列卿。\n裴宰重名悬水鉴，秦公家范列簪缨。\n日临化国春逾永，星映澄江德共明。\n已报远书传勿药，要知虚席待持衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大司马廖公致政","author":"严嵩","text":"两都清望许谁先，留钥恩深遽引年。\n陵路晓辞松罢雪，江船春坐水连天。\n山林岁月从今得，编简勋名与世传。\n旧里龙湾草堂胜，手栽松菊故依然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠杨月湖先生","author":"严嵩","text":"尘外高踪何处?，白云依岫鸟归林。\n才于济世施难尽，学为逢原得最深。\n独抱韦编閒自注，静观庭草坐长吟。\n门墙已隔春风地，江汉徒悬北斗心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大宰杨公考绩送赠","author":"严嵩","text":"相业当朝文敏最，直看家学到今公。\n笏床经笥传何远，岐凤郊麟瑞本同。\n政以经纶归重望，久知清白振高风。\n国思世受何为报，多在山公启事中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送司徒秦公入朝","author":"严嵩","text":"剑履乘春上玉墀，梅花度腊送行卮。\n承明宣室元相待，鹭溆钟陵无到时。\n江上流移何日少，眼中经济属公宜。\n东曹斋阁松阴在，几借前筹退食迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观雪登清凉山饯秦司徒","author":"严嵩","text":"岩壑风烟积，楼台气色寒。\n祗园最高处，飞雪更宜看。\n鹤近瑶空舞，花依绮席漫。\n中台趣严召，南斗寄馀欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送鲁给事之江西","author":"严嵩","text":"远别逢春望转迷，柳条萦绿草新齐。\n回看紫禁烟霄上，独宿征帆楚水西。\n事往不堪闻战伐，忧分行可慰黔黎。\n越边高阁临江在，閒对山云续旧题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠寇都宪赴镇","author":"严嵩","text":"上谷风烟钜镇开，雄关叠嶂锁萦回。\n山川故识鸾舆幸，戎落新惊绣斧来。\n耕牧总叨明圣力，保釐多倚宪臣才。\n秋城落日烽尘静，倚剑遥登万里台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送边都宪召掌北台","author":"严嵩","text":"诏书宣召北门归，恋阙怀乡愿不违。\n行爱云山过旧里，步纡星履上彤闱。\n朝廷正倚台纲重，天日长瞻帝座辉。\n雄峻古称三独坐，百寮回首避霜威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]