3,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"写梅花赠萧山令沈孟威时孟威以内召至","author":"张萱","text":"盘根错节玉交加，五月长安亦放花。\n惟有夫君堪把赠，春风从此满天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七里滩","author":"张萱","text":"万叠芙蓉翠郁盘，牵江百丈溯巑岏。\n回风忽送孤舟笛，知在严家第几滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"武彝山中即事","author":"张萱","text":"尘缘太重道缘轻，住世原非出世情。\n却笑羽流空拔宅，名山无计避新征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幔亭峰","author":"张萱","text":"跨鹤吹笙弄紫烟，幔亭高宴祖龙年。\n祇闻海上劳徐福，不省人间有魏骞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三姑峰","author":"张萱","text":"闻说诸天护苾刍，大王峰畔从三姑。\n游人不敢轻捐佩，匪石能同玉女无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡分水关","author":"张萱","text":"半连楚越半瓯闽，地煖春明花渐新。\n路入白云馀几许，到家犹得及清明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡西峡江","author":"张萱","text":"乘风破浪截流过，津吏摇头公渡河。\n莫道风波今日恶，世途何日不风波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大田驿古梅","author":"张萱","text":"揽梦催花一夜风，尚馀春色几多丛。\n枝头已见梅如豆，天外犹怜客似蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小寒食深青驿留题","author":"张萱","text":"古院春深长绿莎，墙头开遍荔枝花。\n明朝又是逢寒食，倦客如何未到家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别谢大行友可社丈擢南北部 其一","author":"张萱","text":"十载輶轩万里程，闻君久已厌承明。\n两都可是无人赋，暂借新词写旧京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别谢大行友可社丈擢南北部 其二","author":"张萱","text":"钟山晴傍白云司，玄武湖边吏散时。\n柳色送凉荷扑鼻，官閒身健好裁诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别谢大行友可社丈擢南北部 其三","author":"张萱","text":"一官何必较炎凉，大业千秋独擅场。\n庐岳欲倾彭蠡涸，岿然君自鲁灵光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别谢大行友可社丈擢南北部 其四","author":"张萱","text":"此去休言是薄游，六朝佳丽且彝犹。\n垂鞭日过昭明宅，拉伴频登孙楚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别谢大行友可社丈擢南北部 其五","author":"张萱","text":"三山晴色落棋枰，怪底南风日日勍。\n别野若闻淝水捷，好将一着赌宜城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]