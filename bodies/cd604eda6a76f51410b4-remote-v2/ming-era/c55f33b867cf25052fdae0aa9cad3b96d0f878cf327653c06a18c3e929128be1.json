[{"title":"赣州歌四首 其二","author":"欧大任","text":"翠浪玉虹南斗间，庾关北走更千山。\n大纛高牙秋色里，白云长对节楼闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赣州歌四首 其三","author":"欧大任","text":"郁孤台下江月光，白鹊楼前江水长。\n何处边笳传塞曲，万家砧杵满城霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赣州歌四首 其四","author":"欧大任","text":"筹边军府有高楼，节制蛮方几十州。\n赣水城头夜吹笛，梅花飞落楚门秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小除夕至奉新","author":"欧大任","text":"雪过青山马上看，故乡千里岁将残。\n遥知祀灶比邻会，独念征人驿路寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望玉笥山","author":"欧大任","text":"群玉诸峰不可群，斗牛千里此中分。\n荡胸渺渺飞鸿去，天畔遥看一片云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过石涧桥初入庐山","author":"欧大任","text":"曲涧泠泠乱石中，红尘已隔几千重。\n从今欲控仙人鹤，飞过匡庐第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虎溪桥","author":"欧大任","text":"虎啸中原天地间，白云犹得一溪闲。\n溪前送客师应笑，何事柴桑亦出山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白莲社","author":"欧大任","text":"净土莲曾几度开，游人今日有宗雷。\n高僧若结云中社，谁更攒眉不肯来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"善法堂","author":"欧大任","text":"弥陀殿侧远公堂，忆昔开山古道场。\n缁素三千来此会，苍茫禅海一津梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"讲经堂","author":"欧大任","text":"东林曾疏涅槃疑，石木苍苍雪满池。\n弟子何人更都讲，山猿犹似听经时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"许州道中 其一","author":"欧大任","text":"茅屋萧萧颍水斜，行人何处问曹家。\n春深山下棠梨树，犹自千条缀雪花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"许州道中 其二","author":"欧大任","text":"许下长途片雪残，貂裘狐帽过春寒。\n题诗誇向江南客，嬴得琼瑶马上看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过广武","author":"欧大任","text":"广武山前云色开，千年楚汉已尘埃。\n时无英雄有竖子，长啸秋风天际来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题邯郸吕仙祠","author":"欧大任","text":"漳河西问主人餐，釜里黄梁醉后看。\n闻道吕公曾一梦，自怜驱马过邯郸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赵州大石仙桥","author":"欧大任","text":"何处仙人倚石阑，骑驴曾此向长安。\n华清一笑远山后，应忆西南栈道寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登保定城望西北诸关 其一","author":"欧大任","text":"百里边城倒马关，白羊口外戍兵还。\n恩深一剑封侯晚，已觉风沙老客颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登保定城望西北诸关 其二","author":"欧大任","text":"烽火星连战后云，庙堂悬爵待殊勋。\n将军万里怀金印，明月胡笳夜夜闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登保定城望西北诸关 其三","author":"欧大任","text":"居庸关外虏降多，百万旌旗奏凯歌。\n一望燕云今内地，紫骝嘶过白沟河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登保定城望西北诸关 其四","author":"欧大任","text":"三辅星屯护帝京，渔阳上谷尽精兵。\n汉家斥堠天山外，不用劳军细柳营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早过卢沟桥","author":"欧大任","text":"客行万里见金台，晓渡卢沟霁色开。\n听尽春鸿还策马，关门应笑弃繻来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广德寺禅堂观牡丹","author":"欧大任","text":"黄花翠竹散清芬，又见华鬘一院云。\n独坐翻经台畔石，几回天女异香闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王仪甫索题黎惟敬画","author":"欧大任","text":"绿柳晴波杳霭间，昆吾御宿直南山。\n仙郎尚记看花处，宫锦曾披跨马还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题刘子脩画牡丹送吴子充还白下 其一","author":"欧大任","text":"内苑繁花胜绮罗，五陵春色共经过。\n君归独把金陵酒，一曲谁同玉树歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题刘子脩画牡丹送吴子充还白下 其二","author":"欧大任","text":"春深魏紫满雕阑，尔到江南尚未残。\n独有长安骑马客，曲江亭上几回看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送罗美至宰云梦五首 其一","author":"欧大任","text":"李白曾为七泽游，东窥云梦带昭丘。\n竹枝歌罢巴童醉，月在西陵万树秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送罗美至宰云梦五首 其二","author":"欧大任","text":"孤城更在楚江西，涢口千山夕照低。\n君去行春应露冕，不堪烟雨听猿啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送罗美至宰云梦五首 其三","author":"欧大任","text":"于菟何处梦中归，此地蒲骚旧垒非。\n试向斗辛城上望，枫林江水白云飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送罗美至宰云梦五首 其四","author":"欧大任","text":"使君游猎苑云开，明月珠旗曳楚台。\n不羡子虚誇作赋，相如还奏上林来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送罗美至宰云梦五首 其五","author":"欧大任","text":"汉江东下洞庭寒，赋客登楼把酒看。\n莫道烟波千万里，春鸿飞处是长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送许充复赴滁州","author":"欧大任","text":"一舸江淮水寺钟，看碑应到白云重。\n风尘羡尔扶藜去，秋满琅琊七十峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡宪使伯贤赴滇中六首 其一","author":"欧大任","text":"万里中原一骑过，清秋饮马渡黄河。\n不知何处登楼赋，衡岳峰头白雁多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡宪使伯贤赴滇中六首 其二","author":"欧大任","text":"诏下楼船习水犀，昆明更在益州西。\n非缘圣主贤臣颂，争遣王褒祀碧鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡宪使伯贤赴滇中六首 其三","author":"欧大任","text":"叶榆河上赤枫秋，霜落苍山小队游。\n骑吹翩翩迎汉使，诸蛮西拜五花楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡宪使伯贤赴滇中六首 其四","author":"欧大任","text":"岛夷曾畏伏波军，久见边尘断吐蕃。\n白日烟消西洱海，青天云捲雪山门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡宪使伯贤赴滇中六首 其五","author":"欧大任","text":"南中孟获七擒时，羽扇从容不用师。\n铃阁治书逢使者，函封先寄爨王碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡宪使伯贤赴滇中六首 其六","author":"欧大任","text":"腰间宝剑七星开，何限中朝赠策来。\n君上高峣还北望，白榆秋色满燕台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京迁居城南次韵答张鸿与伦绍周见讯 其一","author":"欧大任","text":"碣石宫前偶卜居，都亭奏记未堪书。\n上林亦有相如赋，五色云中望玉舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京迁居城南次韵答张鸿与伦绍周见讯 其二","author":"欧大任","text":"浮沉燕市结交新，击筑酣呼满四邻。\n君看龙门谁奋袖，自怜不识汉平津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁判官之郁林","author":"欧大任","text":"临蒸南去路悠哉，塞雁飞时海燕回。\n一片郁林犹有石，政成还伴使君来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘仲恭索题文休承西湖图","author":"欧大任","text":"藕花风起绿波间，十里平湖十里山。\n载酒寻僧谁可共，画船吹笛月中还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻姚元白南还已过徐州","author":"欧大任","text":"书寄彭城雁已还，春风先到秣陵关。\n梦中不记黄楼上，万里天涯一片山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题陈士谦墨竹","author":"欧大任","text":"词客当年有钓台，檀栾犹见夹池开。\n玉箫曾共吹明月，何处双飞碧凤来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎惟敬席上文休承有赠歌者戏和二首 其一","author":"欧大任","text":"燕市悲歌酒易消，双声流响入云霄。\n送君更唱江南曲，草绿吴洲第几桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎惟敬席上文休承有赠歌者戏和二首 其二","author":"欧大任","text":"西第留欢更此宵，清诗题赠董娇娆。\n锦袍明月江船上，谁共扬州听玉箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张侍御按浙还京吴侍御见招同饮万金吾园中因病不赴 其一","author":"欧大任","text":"红药花边遣骑迎，青丝空返独含情。\n曲中一片西湖月，閒杀文园病马卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张侍御按浙还京吴侍御见招同饮万金吾园中因病不赴 其二","author":"欧大任","text":"好客将军陈孟公，门前时系五花骢。\n歌钟不到书生耳，斗酒新丰明月中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韩虞部子成以诗招饮次韵戏答","author":"欧大任","text":"马似游龙拂蓟台，笑予犹得狎群才。\n韩婴自冠儒林学，莫唤谈诗匡鼎来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄李伯承 其一","author":"欧大任","text":"看花春尽蓟门杯，一出承明尚未回。\n曾是词臣随玉辇，岂堪西望柏梁台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5658,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄李伯承 其二","author":"欧大任","text":"南谯父老拥旌游，杯底黄河百折流。\n落日离骚君莫读，浮云那似楚江秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5659,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄李伯承 其三","author":"欧大任","text":"风尘九折畏途多，濠上观鱼且自歌。\n天末故人题尺素，漆园为吏意如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5660,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄李伯承 其四","author":"欧大任","text":"君上秋风百尺台，白云片片乱鸿哀。\n江潭此去三千里，那得瑶华远寄来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5661,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄苏子冲","author":"欧大任","text":"酒钱正待苏司业，三月水边多丽人。\n君自曲江骑马过，那能不醉五陵春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5662,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中题林逋观梅图","author":"欧大任","text":"徵君不出意何如，雪满孤山一草庐。\n诗在水边篱落处，岂堪西上茂陵书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5663,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题孙参军荔枝练鹊","author":"欧大任","text":"红云开实满林香，海鸟孤飞练带长。\n粤客赋成西掖里，荔丹时节最思乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5664,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"胡仲一谈嘉州淩云寺之胜王叔承欣然赋诗便欲西游邀予同作四首 其一","author":"欧大任","text":"巴渝千里望峨眉，风急蒲帆片片吹。\n日暮嘉陈江上客，竹枝歌里蹋船儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5665,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"胡仲一谈嘉州淩云寺之胜王叔承欣然赋诗便欲西游邀予同作四首 其二","author":"欧大任","text":"淩云楼阁半空悬，踯躅花深雨更然。\n五百比丘趍讲席，人天会里尽成仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"胡仲一谈嘉州淩云寺之胜王叔承欣然赋诗便欲西游邀予同作四首 其三","author":"欧大任","text":"嘉州无数好山名，雪下岷峨春水生。\n曾共高僧谈出世，尸陀林在钵罗城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"胡仲一谈嘉州淩云寺之胜王叔承欣然赋诗便欲西游邀予同作四首 其四","author":"欧大任","text":"楚天猿啸断人肠，鱼腹白盐归客航。\n我欲裁书寄三峡，不知何处棹相将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对雪柬沈山人懋学三首 其一","author":"欧大任","text":"白发黄金未易成，何年揖别汉公卿。\n翩翩东郭先生履，犹向长安雪上行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对雪柬沈山人懋学三首 其二","author":"欧大任","text":"木落女儿湖水低，雪花飞过断桥西。\n孤山山畔梅千树，曾见诗人一杖藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对雪柬沈山人懋学三首 其三","author":"欧大任","text":"风雪驴车且未还，暂留蓟子在人间。\n开窗谁识挥毫意，画出江南万叠山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题元人唐子华捕鱼图二首 其一","author":"欧大任","text":"漫郎家世在烟波，一落红尘失钓蓑。\n回首芙蓉溪上艇，买鱼沽酒意如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题元人唐子华捕鱼图二首 其二","author":"欧大任","text":"悲歌弹铗欲何依，春鳜秋鲈幸自肥。\n手把渔竿容易去，五湖烟月待人归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张伯衮参军之塞上二首 其一","author":"欧大任","text":"出关沙草渐萋萋，虎帐孤悬涿鹿西。\n塞上题书须早寄，莫令投笔过摩笄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张伯衮参军之塞上二首 其二","author":"欧大任","text":"桑乾明月照琵琶，都护西行莫忆家。\n千骑不闻刁斗击，铙歌归及上林花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和戴伯常种兰同魏顺甫赋 其一","author":"欧大任","text":"赐沐郊园正早春，碧兰为佩尚堪纫。\n明朝握向龙楼侧，不扈江篱似楚臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和戴伯常种兰同魏顺甫赋 其二","author":"欧大任","text":"楚人赋本似离骚，燕颔将军亦綵毫。\n一自兰台陪宴后，十年香草忆江皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别刘比部仲恭二首 其一","author":"欧大任","text":"客子当筵意气真，满天霜雪一沾巾。\n千杯不醉襄陵酒，明日关河万里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别刘比部仲恭二首 其二","author":"欧大任","text":"上党天低南北分，帝乡携手恋青云。\n心期五岭春鸿雁，还把瑶华一寄君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泰山四首 其一 封禅坛","author":"欧大任","text":"芝泥封石满天坛，燎玉无光月色寒。\n七十二君何处去，白云空自绕阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泰山四首 其二 仙人桥","author":"欧大任","text":"闻道青螺去复回，何年驱石过蓬莱。\n我今岳顶餐灵气，更待安期海上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泰山四首 其三 日观峰","author":"欧大任","text":"一出金门奉紫泥，孤灯日观听仙鸡。\n君看东海扶桑影，高照长安玉殿西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泰山四首 其四 观海楼","author":"欧大任","text":"海雾冥冥远接天，蜃楼东与岳云连。\n十洲只在三山外，不遣楼船更候仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮淮","author":"欧大任","text":"南征浮淮水，行迈方余舟。\n桐柏导西来，湍激从安流。\n鸿濑下涡浦，高澨见马丘。\n扬帆唱归风，击汰齐棹讴。\n夕曜涌明月，熻爚蠙珠浮。\n龟龙腾以嬉，鸨雁翩其游。\n在昔省徐方，师旅戒万艘。\n水军发谯城，舳舻泛悠悠。\n俛仰忆往事，波骇今千秋。\n曙色荡溟昧，商飙复飂飗。\n朅来肃王程，耽赏非所谋。\n咏言仲宣赋，渺矣怀九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]