[{"title":"山居三十韵 其六","author":"屈士煌","text":"衡门新水漾成渠，桐叶凋霜下草庐。\n每惜悲歌酒徒尽，谁怜迟暮美人疏。\n春秋著作成公案，月旦身名任史书。\n多少远怀长不寐，江湖消息渺愁予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其七","author":"屈士煌","text":"千峰如画不能图，远水当窗镜是湖。\n梦里浮沉春婉转，人间南北鬼揶揄。\n望迷故国心同折，坐破寒山眼独枯。\n徙倚放歌长啸起，此生怀抱在冰壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其八","author":"屈士煌","text":"心识长安莫向西，柴门幽绝怯闻鸡。\n片云入眼谁堪白，半面于人不可啼。\n梦破寂寥孤榻冷，目无山水四天低。\n深情最是忘言地，桃李苍凉自满蹊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其九","author":"屈士煌","text":"漫将心迹寄天涯，欲讯升沉恐未谐。\n自惜烟霞多痼疾，谁言草泽有椎埋。\n素琴深浅终难定，长剑雌雄不易猜。\n拂袖不辞高退缩，青天云海一芒鞋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其十","author":"屈士煌","text":"物外风霜自劫灰，住残萝薜首频回。\n东西南北人何处，三万六千春去来。\n歌遏行云声是玉，卧当流水影如梅。\n登高欲赋还惆怅，愁绝江南不可哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其十一","author":"屈士煌","text":"高居谈咏雨无尘，选胜探奇快绝伦。\n击筑莫须悲往事，传灯今又见何人。\n烽烟地作经年别，寥落家还去日贫。\n未必物缘消遣得，时时回首泪沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其十二","author":"屈士煌","text":"结屋如船卧水云，相知不辨鹿麋群。\n坐沉似得山情性，住久都无僧见闻。\n目送晓天情易极，意于寒月淡何分。\n客来尽道同招隐，愁煞居停七十君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其十三","author":"屈士煌","text":"推窗祇觉澹无痕，野望亭亭快愿言。\n蝌蚪有书狐问字，麒麟空冢狖啼魂。\n居同莲国疑非世，地拟桃源别作村。\n翻笑年来生计脱，断霞深树日关门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其十四","author":"屈士煌","text":"桥流清浅静生寒，小插花枝待倚栏。\n虎豹掩关天万里，鹧鸪啼晓日三竿。\n微吟策杖云痕湿，病眼登楼秋意乾。\n空谷久抛人事后，抱琴何处写幽闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其十五","author":"屈士煌","text":"身外冰霜亦易删，春衫何事泪痕斑。\n坐开明镜三千顷，遥写峰眉四百弯。\n种树渐能通至道，藏书犹许借名山。\n近来新学餐奇字，辟谷琅环二酉间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其十六","author":"屈士煌","text":"秋宵相对小如年，蛩语微茫静可怜。\n半地冷云平待月，何人凉露坐谈天。\n墨花吐出终疑梦，剑影飞来或化烟。\n不觉闭门摇落后，满函新草近成玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其十七","author":"屈士煌","text":"上方灯火夜萧条，静煞冰云不易招。\n低树笑声知斥鴳，故枝无恙赠鹪鹩。\n月悬大地皆明镜，梦落空林尽海潮。\n最有斯人眠未得，更深犹过水西桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其十八","author":"屈士煌","text":"乱涧横桥小结茅，榻移深树卧如巢。\n雌黄满眼谁同调，玄白逢人懒解嘲。\n片石有缘呼阿丈，南金无力铸神交。\n客情泯泯谁能见，花雨空濛自一梢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其十九","author":"屈士煌","text":"枕边松啸欲为涛，绝壑苍凉野思劳。\n耽我图书如菽粟，没人花草当蓬蒿。\n朝缄尺鲤慵题素，夜听啼乌起读骚。\n寒瀑坐深浑不记，萧森凉湿读书袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其二十","author":"屈士煌","text":"雨残连岫绿于螺，草际微凉入薜萝。\n米汁数升浇佛尽，云根几片赚僧多。\n秋高虎涧闻清啸，夜半牛衣见踏歌。\n如此幽晖书未得，空劳物色惹鱼蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其二十一","author":"屈士煌","text":"重重天路渺何涯，底事空劳梦寐赊。\n千古物情怨云雨，一时人事化虫沙。\n雁函寂寞秋无字，笔冢离披夜有花。\n野客过从谈正剧，燃香还品玉川茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其二十二","author":"屈士煌","text":"零落无声石乳香，野人栖宿寄花房。\n书残红叶枫犹碎，餐尽寒英菊未霜。\n半榻草虫同索寞，当时风鹤托清狂。\n烟霞未必多成癖，多少牢骚怯望乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其二十三","author":"屈士煌","text":"涧畔行吟此际情，听泉问石意分明。\n倦游岂复干人事，高卧何关买世名。\n住以好山成密友，坐于无事见平生。\n年来见客频萧索，惭愧黄鹂几树声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其二十四","author":"屈士煌","text":"湘帘寒捲雨峰青，古木虚冥点翠屏。\n病后著书笺药谱，霜前得水续茶经。\n蟪姑吟歇山方暮，蚨蝶飞来梦已醒。\n野客不知焚笔砚，问奇犹讯草玄亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其二十五","author":"屈士煌","text":"闲来生计若无凭，种药通泉事事能。\n孤冷情怀常厌客，飘零踪迹半如僧。\n鹔鹴典去贫何补，鸲鹆耕残道未曾。\n一片野心谁可问，支离空掩一笼灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其二十六","author":"屈士煌","text":"非关岩壑解淹留，静喜闲身渐早抽。\n半岭人归游子地，一帘秋老读书楼。\n逃禅酒力应千日，作赋文心起四愁。\n咫尺风尘看岂得，请君回首乱峰头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其二十七","author":"屈士煌","text":"不用登高叹陆沉，狂来梁甫未成吟。\n乱流沉石分清浊，局外看棋得浅深。\n伏枥拟淹千里足，闻飙又热一秋心。\n频年湖海成何事，祇合空谭坐夕阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其二十八","author":"屈士煌","text":"拜石盟花事正酣，每于幽兴最和南。\n从来啼笑存多少，如此浮沉得二三。\n方寸久应遗色相，风流终不堕清谈。\n悟回文字知成障，焚出床头笔几函。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其二十九","author":"屈士煌","text":"山楼寒色朔风尖，双袖飘然过雾沾。\n天下有心人独老，古来失意事同拈。\n断霞当席乌啼树，远梵无声僧到帘。\n松谡半窗惊睡起，石泉流水夜来添。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居三十韵 其三十","author":"屈士煌","text":"芙蓉插壁秀巉巉，上有仙书秘石函。\n丛菊径荒惟待酒，芰荷香老未裁衫。\n溪烟薄暝看横屋，水气当晴亦满岩。\n赋就忽惊山鬼泣，新题竹素已三缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读蜀忠王遗表","author":"屈士煌","text":"正气居然长子师，遗忠未竟陨疮痍。\n数行翰墨千秋事，一寸肝肠五色丝。\n身后微言悬日月，幕中名笔写须眉。\n英雄零落呼难起，对此牢骚欲语谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜翁山归自辽东","author":"屈士煌","text":"羊裘布帽雪霜凝，几载风尘寄迹僧。\n名姓隐交随五岳，须眉留得拜诸陵。\n应知徐庶心徒苦，却恨留侯事未能。\n归卧故园薇渐长，西山同约几时登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感时 其一","author":"屈士煌","text":"乾坤作戏未逢场，人力天心两渺茫。\n粉黛纵工愁掩袖，菁华如竭忍搴裳。\n非才论计终投石，短鬓忧时欲见霜。\n万里麻鞋成底事，悲来无地可佯狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感时 其二","author":"屈士煌","text":"出山愁易入山难，当局何如局外闲。\n拂袖恐伤明主意，作书惟许后人看。\n竿无巧饵鱼空羡，匣有遗珠雀敢弹。\n薪胆未成今日事，终宵频起涕阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠剑","author":"屈士煌","text":"蛟胎静啸匣雷鸣，长日摩挲为不平。\n事去寸心难自按，时来千里不留行。\n斗边宝色精华敛，枕畔寒泉夜气横。\n拟赠尚须逢国士，深藏犹未别荆卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"避乱水花庵同贲兄赋","author":"屈士煌","text":"南荒兵燹日销魂，咫尺寒山好闭门。\n半席烟霞豺虎穴，三时风雨脊鸰原。\n林腰草气兼花气，石脚云痕共水痕。\n乘兴小舟无不往，村西亭子与东园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠王山人非熊","author":"屈士煌","text":"高士如君绝世尘，埋名休认买名人。\n故山丛桂隔烟雾，天际浮云为比邻。\n文字有神供寄傲，揶揄无鬼笑清贫。\n花间浊酒勤相对，好共匡床过小春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登龙门岛","author":"屈士煌","text":"孤心一夜怯闻鸡，挂席初沉绝岛西。\n地尽日南同削迹，天环夷徼杂雕题。\n穷荒短策追铜马，曲港楼船校水犀。\n满目山榛吟兴起，美人何处瘴烟迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将西上未远海外寄王山人","author":"屈士煌","text":"离离相望隔沧溟，海外搴裳赋隰苓。\n闭户秋深高士卧，吹箫人去酒徒醒。\n仙盘寂寞辞茎露，帝座飘遥远客星。\n惭愧故人向西笑，麻鞋今始过零丁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和周伯度许参尔辞部挂冠作","author":"屈士煌","text":"额叩天阍碎豸冠，龙颜不动改容看。\n未闻东海容高士，莫赋南山笑解官。\n冥鹄已潜臣节重，城狐不死主恩宽。\n淋漓谏草休焚去，一字霜飞六月寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜何文客过宿城南旅舍","author":"屈士煌","text":"斗酒深宵度不难，何妨相对雪漫漫。\n乡心断绝惟沉醉，谈兴支离可破寒。\n旅榻挑灯人万里，严城传柝月三竿。\n翻思剪韭年前事，一夕风吹客思乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滇南元夕","author":"屈士煌","text":"一气回阳万井烟，红衫宝马迸如泉。\n春街烂漫清平屐，月地噌吰大小弦。\n度曲千门翻白纻，悬灯百戏选青钱。\n繁华好梦频消歇，粉饰怜看半壁天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送一灵禅师之匡庐","author":"屈士煌","text":"十年怀绪此宵平，相对疏林百感轻。\n送子便须忘世法，避人应是为时名。\n佳山自古遗高士，多病而今见道情。\n同作旧游怜独往，凭君先试枕滩声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次答陈活残","author":"屈士煌","text":"山中老宿知名旧，一见冰壶相映寒。\n谈笑可人惊入座，风骚盟主让登坛。\n交期古道精神别，兴在云山杖屦宽。\n欲折幽兰赋招隐，买邻何处待袁安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠閒道人定水楼居","author":"屈士煌","text":"每忆西山旧颜色，相逢疑对紫峰云。\n冰霜不入客魂梦，烟火何关身见闻。\n住与冷梅支岁晏，吟同疏磬落更分。\n年来结尽江湖士，惭愧名埋始识君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题赠陈宪副白主新筑","author":"屈士煌","text":"卜居占尽湖山胜，如此幽晖画不如。\n海岳何尝秘精采，烟云长得润图书。\n窗虚淡淡笼花气，人静迟迟见道馀。\n乐在忘言谁得会，主人非我我非鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜郑大河见过","author":"屈士煌","text":"僻居好友不多得，况复伊人心独劳。\n谢客久知从木石，怀君忽已到蓬蒿。\n山川不閒自千古，日月几何成二毛。\n把酒放歌愁正热，挑灯同起按檀槽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送太常人镜游鸡足","author":"屈士煌","text":"道流结束宰官行，问讯云淙眼独明。\n怀里几时劳梦寐，望中何以寄平生。\n秋兼山水俱无尽，人与文章渐有情。\n胜事如君消受得，等閒饱听石泉声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望昆明池","author":"屈士煌","text":"西山山下一泓烟，匣镜遥开小半边。\n勺水未酬观海眼，轻风犹更泛湖船。\n波光隐接夕阳树，水气遥吹过雨莲。\n于此有人呼或出，菰芦一幅静娟娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"还山吟","author":"屈士煌","text":"拂衣多谢道旁尘，笠杖随身悟夙因。\n浊世何曾有高士，好山犹肯待归人。\n诗书是幻须能读，钟鼓无灵莫认真。\n落落乾坤随具眼，此行翻喜见闻新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠洪水部","author":"屈士煌","text":"却马岩居老省郎，旧游曾忆共明光。\n十年鹭羽差池别，一代鸿篇郑重藏。\n往事龙蛇歌转咽，故人云水兴偏长。\n青尊祇合频频对，短鬓相逢渐有霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归自滇中呈故园同社","author":"屈士煌","text":"乾坤谁遣又生存，禹鼎销沈日月昏。\n乌鸟岂知还故苑，芳兰今始避当门。\n浮生孟浪终惭道，未死颠连恐负恩。\n乱后故人相念否，高歌谁为作招魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送铁庵北上","author":"屈士煌","text":"绛侯能武陆公文，岭外才名孰与君。\n四海今看鸿鹄羽，廿年曾共鹿麋群。\n剑花拂向关门雪，囊草题将日下云。\n此际歌骊何所赠，楚臣芳杜满江滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿在犙和尚","author":"屈士煌","text":"东土传衣旧，南宗衍派长。\n曹溪分滴乳，祇树散幽芳。\n五岭空王国，千秋选佛场。\n马驹方远踏，鹙子知高飏。\n月指初融相，灯传不露光。\n鼎湖擎玉柱，瑞塔竖金梁。\n密谛翻圆藏，全机示宝航。\n挈衣珠在掌，开匣剑生铓。\n兴任麻鞋费，参尝劲弩张。\n天童酥合酪，玄水雪加霜。\n坐破瀛山桶，掀翻觉浪床。\n象林狮一吼，炎峤凤还翔。\n芥子须弥纳，针锋梵刹藏。\n炉锤承大冶，澡灌藉神浆。\n宝掌逢初度，宗风正远扬。\n雨花疑献供，摛管代飞觞。\n海岳同声气，人天总吉祥。\n僧袛弹指事，应笑赵州忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出都谣八章","author":"何绛","text":"鞭马射狐，狐入地呼。\n天高不闻，老狐别雏。\n走兔不死，得见天子。\n飞鸟一群，壮士如云。\n熟黍熟黍，缘无雀鼠。\n雀鼠之无，实赖天子。\n离京十里，车声未已。\n一耳十环，官人之婢。\n斩竹断木，不避民屋。\n青纹刺面，云是官仆。\n易水漫漫，冰犹未泮。\n拙矣荆卿，一去不返。\n下上高原，昭君之村。\n九原可作，庶释涕痕。\n地动殃民，除税七分。\n身死为砾，无由报君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁楚恕还五羊","author":"康麟","text":"之子耽游侠，江湖得趣深。\n孤琴江上月，一剑客边心。\n故国楚云外，归舟吴水浔。\n举杯不忍别，聊赋短长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柳庄","author":"康麟","text":"爱此陶潜柳，春来种满庄。\n雨条牵翡翠，风线弄鹅黄。\n黛色侵书幌，清阴覆草堂。\n闲中幽兴发，相对引壶觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发连江","author":"康麟","text":"早发连江驿，迢迢去路长。\n山川分杳霭，云树入微茫。\n茅屋鸡声晓，芳洲杜若香。\n不须高喝道，惊散睡鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至汀府","author":"康麟","text":"汀路千山里，山山景可耽。\n芙蓉开叠障，翡翠隐明岚。\n水驿通章贡，人烟接岭南。\n喜逢贤五马，清政得玄谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日泊谷亭闸","author":"康麟","text":"舟行逢九日，晚泊谷亭津。\n坐久风欺帽，吟多月醉人。\n茱菊羞双鬓，萍蓬叹一身。\n君亲恩未报，回首欲沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春昼睡起","author":"康麟","text":"池草诗初就，华胥梦正回。\n铜龙希昼漏，宝鸭冷春埃。\n燕燕蹴花去，莺莺求友来。\n物情苦相撩，何惜玉尊开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋夜雨独坐试笔","author":"康麟","text":"风送初秋雨，潇潇入夜鸣。\n井飘梧一叶，壶滴漏三声。\n暑向帘栊退，凉从枕簟生。\n长吟不成寐，无限客初情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽杨烈妇二章","author":"何绛","text":"室中之戈，其乱孔多，妾死则那。\n天穷地黑，刀光水白，断送鬼魄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋有感","author":"康麟","text":"客里逢佳节，飘蓬愧此身。\n可怜今夜月，独照异乡人。\n物色随秋改，羁怀逐日新。\n何时优诏许，归养白头亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入罗浮住石洞作 其一","author":"何绛","text":"清晨策高足，游我罗与浮。\n投身入石洞，暂息石上楼。\n流览先贤迹，道德良难俦。\n日夕凉风至，深谷有馀秋。\n自吟还自咏，兹事复何求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入罗浮住石洞作 其二","author":"何绛","text":"微风动林木，细雨飘然至。\n秋尽气还佳，萧萧入我寐。\n揽衣念前哲，明时上封事。\n骸骨归山阿，学术承洙泗。\n悠悠百年内，俎豆存真意。\n圣贤久不作，斯文恐将坠。\n嗟予老未闻，徒然负此志。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独坐柬罗颢甫胡大灵 其一","author":"何绛","text":"世代去如驶，昨日又今日。\n昂昂七尺躯，知非不化物。\n车马狭道旁，功名终不实。\n二氏良玄幻，君亲两相失。\n先师有遗训，勉之可入室。\n徒然事糟粕，无乃太粗率。\n东邻散诞子，美哉圣贤质。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独坐柬罗颢甫胡大灵 其二","author":"何绛","text":"明月照衣带，松风吹我怀。\n何必饮美酒，兹事亦殊佳。\n纷纷复纷纷，多恐与吾乖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]