[{"title":"题渔梁客舍","author":"袁表","text":"渔梁渡头新雨歇，大竿岭外飞云没。\n迟回不见故乡人，却见云间故乡月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7558,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"符子入秦郊游","author":"何御","text":"寒日行白陆，朔吹扬飞尘。\n送客往广陌，中情多苦辛。\n野云覆长路，孰识东西秦。\n临发执前绥，愿为陈所因。\n瞻彼二黄鹄，泪下不能伸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7559,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"有鸟歌","author":"何御","text":"有鸟有鸟集华池，长嘴得食短嘴饥。\n何不弯弓射长嘴，前行丈人翻见嗤。\n有鸟有鸟在中逵，长嘴能飞短嘴迟。\n何不弯弓射短嘴，后行公子独怜之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7560,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山南作","author":"何御","text":"小隐依陵薮，山南良可家。\n一洲环橘柚，十里荫桑麻。\n白帻欹深酝，青鞋猎远沙。\n倘逢李都尉，射虎亦生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7561,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"少年行","author":"何御","text":"少年砺剑心含冤，潜入长安东郭门。\n怒发上冲双眦裂，问之举腕无一言。\n日暮得仇策马去，九衢凛凛黄□昏。\n莫怪此徒轻杀人，千金曾报一饭恩。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7562,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过庆原","author":"何御","text":"野烧萋萋带雨痕，半山斜日近黄昏。\n驿亭阻绝来时路，烟火萧条战后村。\n倦鸟惊人移浦树，寒潮带月上江门。\n长年书剑催行色，白首惭孤报主恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7563,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"落花怨","author":"徐永宁㭿","text":"晓起西园望，空阶散落红。\n自嗟根蒂浅，不敢怨东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7564,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寻隐者不遇","author":"徐永宁㭿","text":"杖藜徐步出荒原，漠漠寒云掩洞门。\n流水桃花人不见，孤莺飞过绿杨村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7565,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"万寿节朝天宫习仪二首 其一","author":"张治","text":"曲槛通丹室，长松锁翠烟。\n楼台凌绝巘，钟磬发诸天。\n瑞荚生尧日，绯桃入汉年。\n君王有明德，万寿应高玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7566,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"万寿节朝天宫习仪二首 其二","author":"张治","text":"看佩移宵烛，闻钟候晓鸡。\n鼓严千队肃，嵩祝万声齐。\n凤吹随金仗，龙宫隐玉题。\n回看天北极，香案五云西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7567,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"废寺","author":"张治","text":"古寺饶苍苔，断础委蔓草。\n秋高木叶深，霜重池荷老。\n日光穿云来，竹色不可扫。\n世代成古今，恻然伤怀抱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7568,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清溪阻雨","author":"张治","text":"客愁已若此，况听雨声多。\n潮气连沧海，江光涌白波。\n暝云低野度，湿鸟掠船过。\n咫尺齐山色，萧萧锁薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7569,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日登城楼用南田韵","author":"张治","text":"城临孤壁迥，楼出万峰开。\n域势衔天阔，江形抱楚回。\n野风吹日落，霜雁切云哀。\n直北长安道，凭轩首独回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7570,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"发茶陵别诸亲旧","author":"张治","text":"行行离故里，洒泪别交亲。\n明发过湘水，应为更远人。\n雨侵山树晓，花落莫江春。\n何事怀簪组，风尘白发新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7571,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋怀酬泰泉学士","author":"张治","text":"花下疏钟静，天涯独客愁。\n功名扬子阁，词赋仲宣楼。\n杜若沧洲雨，春潮野渡舟。\n有怀吾共汝，双鬓又逢秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7572,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江宿","author":"张治","text":"移舟初极浦，倚岸即斜曛。\n澹澹月临水，微微星出云。\n流萤散高影，暗水聚寒纹。\n山雨夜深至，凄然不可闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7573,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"草市庙","author":"张治","text":"登临犹不倦，倚杖更山扉。\n旧壁龙蛇落，空堂蝙蝠飞。\n云香流别涧，树影动深矶。\n便欲招仙侣，青天振羽衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7574,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋郭小寺","author":"张治","text":"短发行秋郭，尘沙记旧禅。\n长天依片鸟，远树入孤烟。\n野旷寒沙外，江深细雨前。\n马蹄怜暮色，藤月自娟娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7575,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"道场纪事","author":"张治","text":"黄发真人戴玉冠，身骑金虎佩苍鸾。\n俯窥日月行丹极，贪礼星辰拜石坛。\n幡影一庭仙掌净，钟声万户彩云寒。\n朝元初罢千官下，碧宇沉沉夜未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7576,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登石钟山望庐山","author":"张治","text":"庐岳亭亭翠万重，悬泉千尺挂飞龙。\n石钟山下江如镜，映出青天五老峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7577,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂咏二首 其一","author":"张治","text":"大明宫阙九天开，中使传宣殿里来。\n红玉雕盘宫锦覆，上公含笑赐金回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7578,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂咏二首 其二","author":"张治","text":"望湖亭下水如天，曾是宣皇赐幸年。\n玉辇不来凫雁冷，一湖杨柳锁春烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7579,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中送驾和研冈二首 其一","author":"童承叙","text":"春祀瞻陵庙，宸游出帝城。\n丰隆扶翠辇，屏翳抗龙旌。\n柳色迎銮细，莺歌向跸清。\n寝园佳气合，驰道瑞烟平。\n沙软千官拥，泥香万骑鸣。\n精禋劳圣主，数傍碧山行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7580,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中送驾和研冈二首 其二","author":"童承叙","text":"法驾开云幕，慈闱拥万城。\n社烟随采仗，谷雨落青旌。\n春豫流鲜泽，皇游览太清。\n沾衣知宠渥，润物感升平。\n山绕銮舆净，泉当帐殿鸣。\n传宣戒龙舸，还泛玉湖行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7581,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"临清公署作","author":"童承叙","text":"万家楼阁抱城阿，武帝旌旗向此过。\n不见凤笙吹别殿，空闻龙舸驻清河。\n水寒沙碧生冰雪，华榭歌台长薜萝。\n共道于今游幸少，豹房虎圈月华多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7582,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词四首 其一","author":"童承叙","text":"晓向君王赐赏还，长街一字佩珊珊。\n白头宫监呼名姓，换入迎春第几班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7583,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词四首 其二","author":"童承叙","text":"不眠常问夜如何，殿角风铃响渐多。\n记得一声《河满子》，低低灯下学人歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7584,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词四首 其三","author":"童承叙","text":"蛾眉扫罢去朝天，正值官家例散鲜。\n见说羊车随意到，不教中使口宣传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7585,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词四首 其四","author":"童承叙","text":"三三两两不知愁，结束罗裙学打球。\n傍晚忽闻天乐近，分明只在殿东头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7586,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓渡玉河桥","author":"童承叙","text":"百尺飞梁烟雾生，雕阑玉窦绮罗行。\n御沟月露生秋兴，驻马垂鞭听水声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7587,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过友人郊园","author":"李舜臣","text":"暇日薄言出，郊园到薜萝。\n为将芳树歇，亦是别君多。\n即槛看红药，开尊面绿荷。\n晚来烟径上，率尔遂长歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7588,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋江晚望","author":"蔡经","text":"沙头云树郁依依，晚稻吹香紫蟹肥。\n露白秋江鸥一梦，月明寒树雁双归。\n蓬窗剪烛孤弹剑，草屋禁风静掩扉。\n沧海十年空短鬓，青山未返薜萝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7589,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望九江城","author":"蔡经","text":"隔江遥望九江城，零落人家烟火生。\n此日不知云鸟阵，昔时曾动鼓鼙声。\n三军已拔洪州帜，万里空劳镇国兵。\n西土莺花今寂寞，北陵回首泪纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7590,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 朱鹭一章十一句 其一","author":"黄佐","text":"朱鹭，姚以般。\n从以孔盖，车班班。\n北至榆林，南逾淮之水，驾之日千里。\n鹭飞得飞止，茄下游鱼赪其尾。\n皇帝饮酒，恺乐寿无极。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7591,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 思悲翁一章十句 其二","author":"黄佐","text":"思悲翁，枭子雄。\n美人梦翁也，从天以来下。\n悲翁之来，神灵雨。\n子朝以飞，暮何于处。\n猗嗟嗟，松柏萧萧泰陵树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7592,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白沙赴诏","author":"李辅","text":"曾向江门弄钓丝，海风吹浪泼蓑衣。\n忽惊天子黄麻诏，打破先生白鹭矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7593,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 上之回一章十四句 其四","author":"黄佐","text":"上之回，大驱马。\n汗沾野草，百里赭。\n行以北，美人从，不驾舍。\n行以南，美人泣，不旋驾。\n左平虏，右写奕。\n豫章率服，威武谁与敌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7594,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 拥离一章七句 其五","author":"黄佐","text":"拥离在朱巷。\n珂马避之谁者往。\n前有宫殿詄荡荡。\n箭火飞，从天门。\n道傍讴者野游盘。\n万年行乐谁不欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7595,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 战城南一章十二句 其六","author":"黄佐","text":"战城南，分战疆。\n运握奇，陈八方。\n铠甲纷员衷土黄。\n龙江之水洪汤汤。\n马得饮之，人不敢尝。\n馘囚乡晨解其缚。\n犒以钱刀，暮用为乐。\n愿为忠臣死报国。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7596,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 巫山高一章十三句 其七","author":"黄佐","text":"巫山高，高若何。\n淮水绕之，不可以过。\n䯀骢文马锦障泥。\n我欲渡之，徘徊而骄嘶。\n阳台有女居迷楼。\n爱而不见烟云愁。\n胄有虮虱，户有蛜蝛。\n嗟我行役，今还归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7597,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 上陵一章十三句 其八","author":"黄佐","text":"上陵以游遨。\n下津驻旌旄。\n问君从何来，来从朔方渡淮濠。\n軨猎为君车，驾以赭白马。\n鼓声琅琅漏初下。\n手格飞禽血四洒。\n户寐而讹绝行者。\n宫监盱骇走且僵。\n玉盘荐食君莫尝。\n当天鸣镝射兔獐。\n须臾白日出东方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7598,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 将进酒一章七句 其九","author":"黄佐","text":"将进酒，君莫辞。\n何以侑之虎拨思。\n荐嘉肴，陈雅诗。\n群桀既剪江无螭。\n时迈其德隆天基。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7599,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 君马黄一章十一句 其十","author":"黄佐","text":"君马黄，臣马玄。\n狭斜相逢不敢前。\n黄马驰，玄马逐。\n后喷沙，前喷玉。\n副以江许翼两张。\n翩翩倏如流电光。\n周有穆满今圣皇。\n君臣布德周万方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7600,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 芳树一章八句 其十一","author":"黄佐","text":"芳树生兰池，华叶何芬敷。\n鸾凤去之栖者乌。\n唶我西秦氏，家有荡子焉为夫。\n乌乳且哺生有雏。\n嗟嗟蹇尔胡乃无。\n帝何尔惜金仆姑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7601,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 有所思一章十三句 其十二","author":"黄佐","text":"有所思，思我母慈。\n身上锦裲裆，母身清宁寿以眉。\n日夜要襋之，于今化为缁。\n嗟我乃多携离。\n水流东海归何时。\n嗟我会面安可知。\n晨鸡鸣，鸣不已。\n东方明星光动地。\n照我驱驰走千里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7602,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 雉子班一章十五句 其十三","author":"黄佐","text":"雉子班，行可思。\n雄求山梁雌从之。\n羽短何繇飞。\n流宕原泽中，雉子雊以遨。\n翁孺知之，思美其膏。\n白龙化鱼，罹彼豫且。\n视子所止，乃非丘隅。\n谓之载之我有车。\n雉子去，我将安所如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7603,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 圣人出一章十句 其十四","author":"黄佐","text":"圣人出，龙翩翩。\n美人出，以管弦。\n千旌万骑雄哉纷。\n四家从以部领军。\n舞剑浮白觞，我镇国。\n陈秘戏，乐复乐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7604,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 上邪一章六句 其十五","author":"黄佐","text":"上邪，下狭山童不可猎。\n射鼋向江江水竭。\n愿皇垂拱开明堂。\n铺仁获政和阴阳。\n千秋万岁长乐康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7605,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 临高台一章九句 其十六","author":"黄佐","text":"临高台，望泗与淮。\n言采其芑于水涯。\n谁其殖之感我怀。\n奋戎东南逖以北。\n无以逸欲临万国。\n生民何依依我德。\n皇祖在天，敬哉有赫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7606,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 远如期一章十句 其十七","author":"黄佐","text":"远如期，驾马以出门，咫步不可知。\n林有虺，水有蜮，短狐封狼，肉人以为糜。\n万里吁可悲。\n有杕之杜乔其枝。\n皇人寿谷今旋师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7607,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 石流一章九句 其十八","author":"黄佐","text":"石流江怒，乌龙万斛，不可以渡。\n江怒石流，万斛乌龙，不可以浮。\n神怪隳突卫皇跸。\n皇潜以跃跃复出。\n于万斯年保贞吉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7608,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 唐尧一章七句 其十九","author":"黄佐","text":"务成昭，惟唐尧。\n钦明秉德群后朝。\n建礼缦缦歌庆霄。\n屈轶在廷礼不彫。\n茅茨土阶以逍遥。\n望云就日谁敢骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7609,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 玄云一章七句 其二十","author":"黄佐","text":"玄云油油，北风肃肃。\n震电晔晔拔大木。\n雪雹须臾及牛腹。\n驱车随銮走折轴。\n关弓射天中鸿鹄。\n酌金叵罗奏蕃曲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7610,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 伯益一章十句 其二十一","author":"黄佐","text":"伯益虞有虞。\n智周百物，禽用三驱。\n无为而治永终誉。\n皇帝孔武徒手搏彫虎。\n去其爪以蹲俯。\n腓皇于后寔率舞。\n荷皇之勇骇万人。\n山川宁，鸟兽驯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7611,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铙歌鼓吹曲二十二首 钓竿一章九句 其二十二","author":"黄佐","text":"钓竿何珊珊，不如罟网贤。\n鰋鲤何筛筛，不如鲔与鳣。\n网罟一举获者千。\n彼鲔与鳣潜深渊。\n嗟鳣与鲔终弃捐。\n金瓢进御烹小鲜。\n兜离欢呼寿万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7612,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏志二十首 其一","author":"黄佐","text":"栖迟衡门下，向夕绝来鞅。\n轻风荡微月，玄景振清响。\n游心观物化，閒庭恣偃仰。\n苍蝇以翼鸣，营营在蛛网。\n鸿雁随阳飞，一览八纮广。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7613,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏志二十首 其二","author":"黄佐","text":"朱火照玄夜，耿耿怀平生。\n云汉经中天，为章竟何成。\n潇潇风雨歇，引领晨鸡鸣。\n褰帷纳素月，悠然钟我情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7614,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏志二十首 其九","author":"黄佐","text":"大道久已隐，中情末由写。\n所欣青阳动，庭槐绿盈把。\n仲尼亦何叹，匪虎率旷野。\n出门望长川，谁为问津者。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7615,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏志二十首 其十","author":"黄佐","text":"上山采芙蓉，日莫倾筐归。\n驺轲陈王道，脂车向梁齐。\n龙战方择肉，志愿空令乖。\n理人为之牧，嗟哉名实违。\n布谷春无畲，促织秋无衣。\n悠悠感物变，恻恻怀烝黎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7616,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏志二十首 其十一","author":"黄佐","text":"昔余客幽燕，步上黄金台。\n骏骨日以轻，昭王安在哉。\n乐生功未奏，荆卿为祸媒。\n风吹易水波，萧萧有馀哀。\n谁知百代后，东阁淩天开。\n岂令蹇谔士，零落同蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7617,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏志二十首 其二十","author":"黄佐","text":"荒哉阳台梦，无情成匹仇。\n苟非精神合，淄渑为断流。\n汉廷富群策，一言相千秋。\n金石勒盟誓，倏忽婴罪尤。\n河清尚可俟，汉广不可求。\n言树谖草花，庶用忘我忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7618,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"学古三首赠胡承之归关中 其一","author":"黄佐","text":"翩翩双鸣雁，噭噭云中飞。\n娟娟蛾眉女，劄劄流黄机。\n弃置不成匹，叹息减容辉。\n问女何所叹，良人怅有违。\n万里遥相望，何由接音徽。\n蕙楼鉴素月，兰镫暧虚帏。\n身非骖与服，安得同车归。\n河清尚可俟，会合何可希。\n临岐奏此曲，泪下谁能挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7619,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋怀","author":"黄佐","text":"瑟瑟陵上松，琅琅峡中泉。\n回风相遇合，凄清成管弦。\n端居抚时运，闵默何由宣。\n野庐尽县磬，飞挽犹开边。\n初月张虚弓，流火无炊烟。\n明河不可觞，白榆不为钱。\n吾民亦劳止，昊天胡乃然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7620,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"临江道中","author":"黄佐","text":"荞麦花开山翠飞，腰镰翁孺愁相依。\n金川道上风浪急，玉笥山前烟火微。\n长鲸已堕黄石矶，大将犹搴龙虎旗。\n翩然扬袂者谁子，陌上酣歌缓缓归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7621,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓发卢沟望京城有感","author":"黄佐","text":"大车殷地扬尘起，小车轧轧鸣不已。\n苍凉似是长安日，呜咽元非陇头水。\n玉辇南行筑将台，九重宫阙何崔嵬。\n卢沟桥上阑干曲，不似行人肠九回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":7622,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]