0d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29472,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送谢生以南粤战功谒选北上二首 其一","author":"张元凯","text":"三载亲从上将牙，水军十万下珠崖。\n汉庭若薄征南赏，海外何人斩吕嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29473,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送谢生以南粤战功谒选北上二首 其二","author":"张元凯","text":"戈船下濑尽邀勋，年少登坛独出群。\n不是终军功易建，却因杨仆捷先闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29474,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山居书怀","author":"张元凯","text":"薜萝垂户闭云烟，永谢区中未了缘。\n待得三秋明月夜，青松影里弄寒泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29475,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"尧峰寺同山甫丈看月","author":"张元凯","text":"高山月出动湖波，宝树珠光夜若何。\n自是清晖恋岑寂，那知人世有笙歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29476,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上迟客","author":"张元凯","text":"石湖溪水碧于苔，烟雨扁舟去复回。\n恰有桃花一千树，春风能迟阮郎来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29477,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访叶茂长","author":"张元凯","text":"白云常护草玄亭，谁识江南有客星。\n问字未回邀笛至，芙蓉湖上不曾醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29478,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丹阳道中作","author":"张元凯","text":"高阜荒荒古木稠，南徐江水送行舟。\n河山已带中原色，风雨今为北道愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29479,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"高邮湖即事","author":"张元凯","text":"白马湖边白浪生，吴侬船在浪中行。\n已知到处风波急，何事栖栖问水程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29480,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"北河地名杨柳青于此送客","author":"张元凯","text":"两岸蝉声客梦醒，片帆初落暮云停。\n故人无奈年年别，江北江南杨柳青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29481,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜幼元以光禄迁京兆参军","author":"张元凯","text":"再看新绶绾铜章，年少常趋鹓鹭行。\n花拂绿窗仙署晓，画眉未了又含香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29482,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠安茂卿","author":"张元凯","text":"才入燕京便有声，少年慷慨说荆卿。\n黄金只就青楼醉，不识西园可市名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29483,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"贻马用昭","author":"张元凯","text":"苍头款段自长途，不事轻肥骑从都。\n献纳旧臣如荐士，孝廉公子世间无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29484,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"潞河舟中寄朱在明","author":"张元凯","text":"潞水潺湲怆旅魂，故人不共月中樽。\n如何咫尺春明路，恰似吴门忆蓟门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29485,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"约幼元访彭广文寓","author":"张元凯","text":"月落初闻长乐钟，车如流水马如龙。\n寂寥谁识扬雄宅，载酒同君一过从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29486,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送茂卿还无锡二首 其一","author":"张元凯","text":"玉露金茎未易攀，西风斜日送君还。\n潞河杨柳今摇落，愁杀江南庾子山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29487,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送茂卿还无锡二首 其二","author":"张元凯","text":"秋风落叶满城头，才子思家倦远游。\n明月放歌何处好，芙蓉湖上一扁舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29488,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]