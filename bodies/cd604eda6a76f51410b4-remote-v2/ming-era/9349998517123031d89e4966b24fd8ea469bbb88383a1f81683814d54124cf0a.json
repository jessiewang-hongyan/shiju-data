[{"title":"新晴八咏 其八 葺篱","author":"成鹫","text":"一径入花村，天晴花正繁。\n近嫌车马迹，编竹护苔痕。\n隙地搴萝补，深根任雨翻。\n叮咛语鸡犬，从此掩重门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居十咏 其一 埽地","author":"成鹫","text":"隙风如橐籥，野马互驰驱。\n转盼为陈迹，无心事埽除。\n苍头朝拥彗，白发老摊书。\n即此离尘鞅，清閒绰有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居十咏 其二 净几","author":"成鹫","text":"隐几成枯寂，风埃任蔽亏。\n滞形如土偶，觌面笑元规。\n拂拭浑无事，跏趺空复为。\n谁知尘世上，此座有閒时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居十咏 其三 焚香","author":"成鹫","text":"博山爇沉水，矮屋笼高烟。\n枯木发光怪，寒灰待火传。\n众芳閒里过，一味静中禅。\n空印真消息，深宵坐默然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居十咏 其四 试茗","author":"成鹫","text":"多谢雪中炭，言烹雨后泉。\n茶经无定法，老衲有真传。\n破壁孤烟直，虚堂细响圆。\n何人携茗椀，来问赵州禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居十咏 其五 饲鸟","author":"成鹫","text":"忘机狎群鸟，朝去暮还回。\n饮啄得无惧，樊笼不待开。\n鹤田分滞穗，燕语下香台。\n独有山梁雉，长饥唤不来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居十咏 其六 灌花","author":"成鹫","text":"种花临水际，花发水添香。\n抱瓮不辞倦，溪深杓柄长。\n雨馀容我懒，春老教人忙。\n自得閒生理，荣枯感众芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居十咏 其七 洗砚","author":"成鹫","text":"介石为良友，端溪忆旧游。\n相逢在云水，聊与濯清流。\n黑白静中见，烟霞深处收。\n不辞频拂拭，尘世共沉浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居十咏 其八 品琴","author":"成鹫","text":"静理匣中琴，传将弦外音。\n翛然如有寄，弹者本无心。\n山月下枯木，松风吹素襟。\n何人为此曲，无乃水龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居十咏 其九 观奕","author":"成鹫","text":"天下原无事，人间局未空。\n战酣残日下，声乱落花中。\n退步思黄老，当机笑狡童。\n旁观方袖手，何暇辨雌雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居十咏 其十 临池","author":"成鹫","text":"偶然看舞剑，聊尔学临池。\n草圣予私淑，长沙素律师。\n逢山留墨沈，卜地葬毛锥。\n写尽芭蕉叶，春风总不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其一 霜林闻雁","author":"成鹫","text":"繁霜变危绿，叶叶作秋声。\n绕树一为听，长空数雁鸣。\n飘零无定所，远近自分明。\n共有坚冰戒，高飞惬野情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其二 客舍闻雁","author":"成鹫","text":"终岁长为客，秋风早闭门。\n哀鸿频入耳，羁旅易销魂。\n矰缴满天下，菰蒲即故园。\n所思葭菼外，烦汝问寒温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其三 雪晴闻雁","author":"成鹫","text":"初日映残雪，负暄何处翁。\n千山尚凝素，万里见征鸿。\n我欲蹈东海，好音来远风。\n无由生羽翼，相伴出樊笼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其四 雨夜闻雁","author":"成鹫","text":"高虹收宿雨，宾鸟下斜阳。\n振羽云犹湿，求声兴转长。\n风轻常近影，天迥易成行。\n相唤芦中去，伊人水一方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其五 月下闻雁","author":"成鹫","text":"秋光何皛皛，天际来嗈嗈。\n不辨镜中影，应迷雪后踪。\n芦花深夜语，桂殿五更钟。\n知有归期在，家山已万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其六 阁夜闻雁","author":"成鹫","text":"旷怀观物理，何者最相宜。\n高阁月明后，孤灯雁过时。\n海风吹不断，天路去多岐。\n拟作秋鸿操，知音更有谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其七 舟中闻雁","author":"成鹫","text":"我本钓鱼客，秋江晚候潮。\n雁归芦苇岸，人倚木兰桡。\n细语互相答，野情如见招。\n隔波听未彻，云水两迢迢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其八 城楼闻雁","author":"成鹫","text":"落叶古城秋，遥声起百忧。\n惊禽来绝塞，寒月下南楼。\n高不及星汉，卑惟恋荻洲。\n玉关人未入，应悔觅封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其九 山间闻雁","author":"成鹫","text":"渺矣冥鸿迹，逢山得自如。\n片云随去住，孤鹤互相于。\n出谷为求友，闻声独起予。\n凭君寄消息，白首老樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48966,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其十 溪边闻雁","author":"成鹫","text":"清溪流湱湱，枕石日耽眠。\n翻笑云中翼，偏惊物外禅。\n一音分众籁，微响杂高蝉。\n直入蒹葭去，秋风又一年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48967,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其十一 过桥闻雁","author":"成鹫","text":"咫尺虎溪水，危桥著屐过。\n旅禽知此意，留语入烟萝。\n天路难如此，秋云薄较多。\n稻粱非所羡，相戒慎风波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48968,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其十二 病起闻雁","author":"成鹫","text":"强起倚书愰，冷虫喧四围。\n多情惟旅雁，相劝授寒衣。\n久病独无绪，远书来更稀。\n留君慰岑寂，江燕任先归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其十三 孤灯闻雁","author":"成鹫","text":"枯禅如木石，深坐对银缸。\n静极乃闻雁，声高犹到窗。\n履霜心自苦，带月影俱双。\n莫怪焚膏客，秋怀老未降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其十四 驴背闻雁","author":"成鹫","text":"独策蹇驴去，东郊踏雪花。\n遥遥见蜚雁，一一入晴霞。\n过耳边声近，惊心暮影斜。\n归鞭吟正好，诗兴寄平沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其十五 欹枕闻雁","author":"成鹫","text":"侧枕拥残絮，日高犹未兴。\n似闻天半语，遥唤雪中僧。\n万物尽形役，几人能曲肱。\n相怜为漂泊，应不羡飞腾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其十六 拥炉闻雁","author":"成鹫","text":"斗室煖如纩，堆堆坐到晨。\n翰音遥聒耳，枯木为伤神。\n明月下沧海，全家住白蘋。\n谁将雪中炭，空忆上林春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其十七 东篱闻雁","author":"成鹫","text":"三径久不埽，篱根长绿苔。\n秋声随雁入，花意待人开。\n予亦自知老，宾从何处来。\n水边频寄宿，鸥鸟或相猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48974,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其十八 西畴闻雁","author":"成鹫","text":"郭外纵横亩，秋田远近山。\n三农方待穫，一雁下庾关。\n似诉风霜苦，焉知稼穑艰。\n躬耕与行役，相视未能閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其十九 倚杖闻雁","author":"成鹫","text":"植杖倚晴雪，长天来好音。\n双禽听未稳，孤策意何深。\n肃肃云霄羽，悠悠湖海心。\n一条瘦筇竹，期汝共浮沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁杂咏 其二十 抱膝闻雁","author":"成鹫","text":"枯禅长抱膝，兀坐到更阑。\n何处双飞翼，频惊五夜寒。\n繁音归碧落，馀响入蒲团。\n为语嗷嗷者，微生寄迹难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其一 寻幽","author":"成鹫","text":"偶来非久住，所得乃无穷。\n树浅频移鹤，天高任转蓬。\n自誇双足健，不觉一瓢空。\n又复寻幽去，春光处处同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其二 访旧","author":"成鹫","text":"白社曾游处，朱门今几重。\n云峰仍故态，水镜变衰容。\n地主闻虚席，山人许寄踪。\n鹿门知可托，垂老愿相从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其三 卜筑","author":"成鹫","text":"小补成新筑，能閒拟乐邦。\n墙低山入榻，池浅月摇窗。\n开径惭非诩，居亭恰是庞。\n了无鹰兔见，随意守枯桩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其四 安居","author":"成鹫","text":"九夏安居近，閒房得便宜。\n本来无破漏，何用更修治。\n雨细泉先入，风轻暑不知。\n叮咛语僮仆，从此息驱驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其五 闭门","author":"成鹫","text":"举世为形役，吾生愿息机。\n相逢无半语，惟劝掩重扉。\n同病怜孤鹤，将閒博一饥。\n绳枢牢缚定，遑问是邪非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其六 谢客","author":"成鹫","text":"却防佳客至，先寄数行书。\n但愿存真契，无劳念索居。\n风埃盈几案，藤蔓碍轩车。\n要识东樵否，迎逢近不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其七 课圃","author":"成鹫","text":"入门先学圃，隙地垦榛芜。\n一雨喧童稚，双畦逐老夫。\n充厨先野菜，虚架代新瓠。\n爱此同生意，何曾计有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其八 探泉","author":"成鹫","text":"圣泉清且冽，乃在此峰西。\n久别频相念，重寻定不迷。\n杖藜聊独往，茗椀且教携。\n但得驱烦渴，何须入品题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其九 栽莲","author":"成鹫","text":"小池荒已久，春藕种来佳。\n尘世能无染，真香静入怀。\n浅深随所托，清浊岂相垂。\n物理信如此，吾生未有涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其十 种菊","author":"成鹫","text":"清明分善种，谷雨及时栽。\n即事堪怀古，长歌归去来。\n人无终岁力，花仅一秋开。\n莫怪东篱下，沉吟日几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其十一 删竹","author":"成鹫","text":"箐篁三亩宅，落箨四无邻。\n枝叶删将尽，萧条乃见真。\n去留惟便我，疏密不因人。\n恰好存孤干，风前倚病身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其十二 移橙","author":"成鹫","text":"每怜橙荫好，端坐挹清芬。\n近树安茶灶，移根傍水云。\n八风深浩荡，一气自氤氲。\n莫漫伤憔悴，繁华不似君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其十三 护梅","author":"成鹫","text":"古梅枝亚地，春老子偏繁。\n惜绿斜开径，怜黄镇掩门。\n虫饥防钻核，蚁语诫伤根。\n物我同生理，经年总避喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其十四 刈草","author":"成鹫","text":"地宽榛莽遍，天迥露珠漙。\n早出衣从湿，归来日已乾。\n长镵聊自托，被灶笑相看。\n识得新州老，刍荛未可瞒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其十五 濯足","author":"成鹫","text":"清泉供濯足，休笑道人顽。\n等觉原平等，閒身岂有閒。\n鹤归云外步，僧踏水中山。\n两脚俱无著，相随且闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其十六 振衣","author":"成鹫","text":"曾上飞云去，今来水石边。\n临风振衣袂，回首忆当年。\n千仞何为者，七斤殊不然。\n老人新浴罢，抖擞息诸缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其十七 午斋","author":"成鹫","text":"儒门洵澹薄，吾道不萧条。\n午食喧群雀，春蔬盈一瓢。\n闻钟炊玉粒，洗钵闭松寮。\n差胜陶彭泽，长饥为折腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其十八 晚霁","author":"成鹫","text":"閒园过宿雨，野水浸堂坳。\n渐觉多忙事，商量葺破茅。\n远天收螮蝀，斜日织蟏蛸。\n最羡云中鹤，高飞不定巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其十九 趺坐","author":"成鹫","text":"兀兀成吾是，悠悠笑尔曹。\n自从来此住，坐久不辞劳。\n一榻空诸有，双趺送二毛。\n偶然舒两足，窗外月轮高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其二十 经行","author":"成鹫","text":"闭门事行脚，当下息奔波。\n一日能千里，诸方如我何。\n跛牂誇迅疾，夸父逊蹉跎。\n三匝清池去，香风吹芰荷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其二十一 微吟","author":"成鹫","text":"本欲成高咏，低吟背落花。\n隔樯人久立，多恐是诗家。\n风细不关树，泉轻微漾沙。\n此情俱寂寞，馀响送流霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其二十二 清啸","author":"成鹫","text":"偶然发清啸，飞出水云乡。\n天籁一时寂，山风万里长。\n苏门心自远，竹里老偏狂。\n谁是知音者，斯人未可忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":48999,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其二十三 步月","author":"成鹫","text":"人间天所忌，久雨阻经行。\n不放终宵月，空馀半夜明。\n自来还自去，谁送复谁迎。\n顾影无相识，唯闻屐齿声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49000,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其二十四 迎风","author":"成鹫","text":"草屋近南亩，远风来渺冥。\n披襟纳凉驶，觌面识居亭。\n虚室静生白，孤灯长自青。\n封姨许相过，从此撤疏棂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49001,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其二十五 拥书","author":"成鹫","text":"所贵遮吾眼，方将理葛藤。\n谁知斲轮处，犹有读书僧。\n三冬无俗物，千古得良朋。\n翻笑东林老，逢人说上乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其二十六 高枕","author":"成鹫","text":"年来惟善病，高枕水西楼。\n独宿同孤鹤，閒眠笑老牛。\n云阴山被薄，月满竹床幽。\n竟夜不成寐，无言自唱酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49003,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其二十七 顾影","author":"成鹫","text":"频频相管带，处处惜光阴。\n此意无人会，唯君知我深。\n孤明虚一盼，静夜息三心。\n少小为形役，劳劳直至今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其二十八 书空","author":"成鹫","text":"高视薄云汉，书空止自谙。\n眼边无怪事，指下有清谈。\n真易何须画，圆伊不待三。\n玄珠归罔象，持此报同参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其二十九 述嘲","author":"成鹫","text":"有客频相劝，言师道过严。\n蝇屯偏择秽，蜂聚却因甜。\n苦节多成病，长饥为矫廉。\n殷勤谢来意，鱼掌岂能兼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"借园杂咏 其三十 纪梦","author":"成鹫","text":"昨夜梦行脚，茫然失圣凡。\n有人坐盘石，云是补陀岩。\n明月下沧海，长风吹布衫。\n觉来舒老眼，红日上松杉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其一 秋寺","author":"成鹫","text":"寂寞蒹葭外，微茫见佛灯。\n数株红树下，一个白头僧。\n露冷先藏鹤，林虚静爱鹰。\n西风动幡影，无语问南能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其二 秋原","author":"成鹫","text":"落叶不到地，远风时在林。\n有人骑瘦马，终日拍鞍吟。\n草色惊心老，霜痕刺眼深。\n如何行路客，容易说登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其三 秋瀑","author":"成鹫","text":"空谷无人处，高泉间落霞。\n寒光投涧直，悬影入云斜。\n八月山有雪，二时天雨花。\n老僧观不足，飞沫湿袈裟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49010,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其四 秋屋","author":"成鹫","text":"一所尖头屋，千山落木风。\n日斜葭菼外，人在寂寥中。\n倚树见归鸟，开轩闻草虫。\n转嫌邻舍近，隔水结茅篷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49011,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其五 秋社","author":"成鹫","text":"村童喧北里，野老报西成。\n掩豆豚肩小，吹豳羯鼓鸣。\n神鸦飞食肉，社鼠坐分羹。\n醉舞黄花下，巫阳象版轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49012,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其六 秋楼","author":"成鹫","text":"我亦有仙骨，高居远俗尘。\n不因吹笛处，谁识倚楼人。\n山色开三面，秋空无四邻。\n超然群动外，日月逐閒身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49013,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其七 秋塘","author":"成鹫","text":"下流不可处，众浊难为清。\n最爱荒塘水，能留孤月明。\n烟波秋潋滟，荇藻夜纵横。\n取次坚冰近，春来草又生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49014,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其八 秋戍","author":"成鹫","text":"白草经年戍，黄花万里情。\n秋风度天堑，落叶满边城。\n壮士犹编伍，将军未厌兵。\n主人恩尚浅，七尺为谁轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49015,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]