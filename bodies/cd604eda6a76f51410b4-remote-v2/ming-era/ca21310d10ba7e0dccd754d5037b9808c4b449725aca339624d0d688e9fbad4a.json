r/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48386,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梁台六咏 其六 秦淮渔笛","author":"史谨","text":"一堤烟柳集昏鸦，两两渔舟渡浅沙。\n短笛自吹无调曲，暗惊栖雁入芦花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48387,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙潭八景 其一 三江观潮","author":"史谨","text":"一痕忽起势崔嵬，直上三江吼怒雷。\n红蓼滩头斜日里，恍疑鳌戴雪山来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48388,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙潭八景 其二 七星礼斗","author":"史谨","text":"七星山色翠冥冥，玉宇琼楼护六丁。\n夜半天坛明月上，道人独自礼寒星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48389,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙潭八景 其三 华麓寻真","author":"史谨","text":"两峰苍翠接三茅，路入云深去转遥。\n惆怅茅君不可见，却从樵子问王乔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48390,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙潭八景 其四 柳湾待渡","author":"史谨","text":"篙师倚棹傍寒芦，力倦操持不受呼。\n多少行人将有适，不知谁是仲尼徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48391,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙潭八景 其五 官桥送别","author":"史谨","text":"百尺飞梁接大堤，柳阴常见驻轮蹄。\n香尘忽起行人去，水自东流日自西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15