15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题潇湘八景 其七 山市晴岚","author":"史谨","text":"绿阴夹道树重重，人杂渔樵远近通。\n回望酒家山色里，青帘斜飏落花风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48405,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题潇湘八景 其八 渔村夕照","author":"史谨","text":"鹧鸪声断雨初晴，渡口风来水气腥。\n村北村南齐晒网，钓舟閒在夕阳汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48406,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题抱琴图","author":"史谨","text":"童子携琴过野桥，松阴夹路草萧萧。\n知君不是花奴手，未必侯门肯见招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48407,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"耕乐图","author":"史谨","text":"瘠田数亩九峰间，暮耔朝耘不放閒。\n云满绿蓑微醉后，自骑黄犊看青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48408,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"墨梅","author":"史谨","text":"渴龙夜饮鹅池水，喷落孤山雪后枝。\n不是清香暗浮动，黄昏庭院有谁知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48409,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次郭公子韵 其一","author":"史谨","text":"曾经紫塞射鴐鹅，臂挽雕弓膂力多。\n日暮据鞍南望处，碧天无际海无波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48410,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次郭公子韵 其二","author":"史谨","text":"忆向龙池看斗鹅，无边春色上衣多。\n归来醉坐三山顶，笑指银蟾浴海波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48411,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次郭公子韵 其三","author":"史谨","text":"洗砚池头帖换鹅，翠云轩外晚山多。\n座中知有金门客，声誉应齐马伏波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48412,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄郭挥使","author":"史谨","text":"君到金台已暮秋，鹓鸾同集凤池头。\n不知野老含情处，日落秦淮独倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48413,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题海棠白头","author":"史谨","text":"日落华清王气收，海棠妖艳不知秋。\n花梢一夜西风急，啼得山禽也白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48414,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题渊明图","author":"史谨","text":"堤边杨柳舞秋风，篱下黄花发露丛。\n莫笑归来巾漉酒，风光不是义熙中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48415,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题雪景","author":"史谨","text":"山排玉剑倚高寒，路绕琼台万木攒。\n一白不分天远近，却从何处望长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48416,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画","author":"史谨","text":"隔岸青山拥翠螺，野禽啼处夕阳多。\n汉庭累下徵贤诏，未许先生老钓蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48417,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送袁太常省墓","author":"史谨","text":"鄱阳湖上豫章城，万壑千厓列翠屏。\n白发太常归祭扫，西风烟树几长亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48418,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画","author":"史谨","text":"十年羸马厌西东，髀肉全消鬓若蓬。\n幸得栖身鱼鸟畔，酒酣濯足听松风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48419,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题宣和风竹图","author":"史谨","text":"尘迷艮岳淡无辉，尚捲珠帘写竹枝。\n三百年馀重玩赏，孤梢还带北风吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48420,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄徐德器 其一","author":"史谨","text":"石头城下楚江边，有客言回鄂渚船。\n寄语故人徐孺子，白头相见在何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48421,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄徐德器 其二","author":"史谨","text":"君居鄂渚我秦淮，每辱鱼笺慰客怀。\n何日相逢重握手，山南山北试青鞋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48422,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水边芙蓉","author":"史谨","text":"不随桃李竞春光，开向西风压众芳。\n恰似湘娥初睡醒，强临秋水照红妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48423,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"废宅梅花","author":"史谨","text":"门径萧然遍草莱，寒梅一树倚风开。\n可怜香影无人顾，只有山禽自往来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48424,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题黄葵花","author":"史谨","text":"玉颜憔悴鬓鬅松，自有倾阳一段忠。\n来向野人庭院里，道家妆扮立薰风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48425,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"扇上梅花","author":"史谨","text":"月满长空夜气寒，暗香微度碧阑干。\n翠禽唤醒罗浮梦，折得南枝掌上看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48426,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武当八景 其一 天柱凌云","author":"史谨","text":"诸峰罗立翠莲开，天柱当中冠五台。\n势插银河逾万仞，顶摩黄鹄倚三台。\n丹光夜向琳宫出，云气朝从华岳来。\n我忆凭高望乡国，一杯沧海隔蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48427,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武当八景 其二 玉虚环翠","author":"史谨","text":"宝殿珠宫护六丁，一尘不染昼冥冥。\n树环松桧千层碧，山立芙蓉四面青。\n落日风声随虎豹，虚檐云气走雷霆。\n道人不管人间事，自拂烟霞采茯苓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48428,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武当八景 其三 五龙披雾","author":"史谨","text":"万壑千厓晓雾消，琳宫弘敞映仙桃。\n路通绝顶青冥阔，凤哕朝阳紫殿高。\n林下每看羊化石，松间时见鹤归巢。\n我今欲借登山屐，来访安期不惮劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48429,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武当八景 其四 九渡鸣泉","author":"史谨","text":"深谷藏源远近通，下连诸涧尽朝宗。\n飞空自响钧天乐，震地偏惊启蛰龙。\n阔处倒涵山岳影，渡边多见鹿麋踪。\n几番过雨扶筇听，髣髴涛声起万松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48430,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武当八景 其五 南岩削壁","author":"史谨","text":"岩前流水带龙腥，石上灵芝到处生。\n绝壁倚空非禹凿，高萝悬幄自天成。\n岚飞翠雨林梢滴，鹤载瑶笙月下鸣。\n知有仙宫烟雾里，樵歌长答步虚声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48431,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武当八景 其六 紫霄层峦","author":"史谨","text":"山绕琳宫列画图，天然形势一仙都。\n翠岚窗户藏丁甲，白昼风云忽有无。\n羽客夜归骑一虎，仙禽晓过引双雏。\n何时得造烟萝径，石上同寻九节蒲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48432,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武当八景 其七 雷洞发春","author":"史谨","text":"古洞深沈万木遮，洞中初转阿香车。\n已知太乙行时令，不觉春光动物华。\n甘雨顿青原上草，仙桃渐吐日边花。\n明朝拟欲寻芳去，先向新宫觅少霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48433,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武当八景 其八 璚台霁晓","author":"史谨","text":"层台屹立楚天西，曙色遥分石径危。\n玉兔已沈千仞壁，金乌飞上万年枝。\n露凝仙掌云犹湿，花覆天坛影渐移。\n中有长生餐玉者，往来不许世人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48434,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元夕宴史广文宅","author":"史谨","text":"五十年馀鹤发翁，喜逢今夕宴黉宫。\n雕阑月转三更后，火树花开一气中。\n歌吹暗惊幽鸟梦，炉烟轻度落梅风。\n座中俱是天涯客，安得明年此会同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48435,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪霁登龙潭驿楼","author":"史谨","text":"飞楼百尺倚青冥，与客凭阑雪已晴。\n山绕华阳银作树，云开铁瓮玉为城。\n寒禽向日浑无语，暗谷流泉觉有声。\n一舸明朝又西去，还陪鹓鹭入蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48436,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮中赋","author":"史谨","text":"岁月浑如东逝波，醉乡深处喜频过。\n手中不荷刘伶锸，耳畔常闻薤露歌。\n天地有情终寂寞，功名无分欲如何。\n却怜皓首求仙客，终日惺惺鍊紫河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48437,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"经人鲊瓮","author":"史谨","text":"远承仙诏出乌蛮，春色相随万里还。\n一舸又经人鲊瓮，全家如过鬼门关。\n舟师捩柁仓皇际，鱼腹埋身顷刻间。\n到岸不须谈往事，且宜携酒看青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48438,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒黔宁王庙","author":"史谨","text":"冠冕遵王制，祠堂枕野池。\n喜令蛮父老，复睹汉威仪。\n杰栋星河近，虚檐薜荔垂。\n乱峰排剑戟，高树拥旌旗。\n奕叶承恩重，平生出计奇。\n功勋齐马援，德量并韩琦。\n天意深留眷，秋声远送悲。\n故山依日月，新冢卧熊罴。\n猿鹤虽无主，鹪鹩各有枝。\n峨峨光万丈，千古照边陲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48439,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浮休室为颖上人赋","author":"史谨","text":"自悟身同不繫舟，借栖禅室扁浮休。\n眼中生死轻如叶，世上荣枯信若沤。\n金谷已闻樵牧唱，苏台终见鹿麋游。\n几番醉坐三生石，天地为棺总不忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48440,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"驺虞行","author":"史谨","text":"远带仁风出郊薮，素质玄文世希有。\n形虽似虎德如麟，肯让狻猊出其右。\n将军乘暇猎秋风，唾手擒来亦天授。\n天生异物表祯祥，一见终当入灵囿。\n圣德浩荡侔西周，将军勇气横九秋。\n所至不用兴戈矛，桑麻遍野民无忧。\n况逢此兽应时出，光被四表闻歌讴。\n昔年见画谁能识，今见真形世无匹。\n双睛闪电气成虹，一尾横空势如戟。\n虽云四足疾于鸟，不使骅骝共槽枥。\n卞庄冯妇皆叹息，远视傍观股应栗。\n却从昭代致升平，龙马还当负图出。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48441,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画","author":"史谨","text":"雨馀山色翠如苔，树杪寒烟湿未开。\n童子无端扫红叶，隔林知有故人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48442,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画","author":"史谨","text":"竹树萧萧带夕阳，无边秋意满潇湘。\n雁声忽起黄芦岸，多少征人忆故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48443,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"碧嶂归云送友之江西","author":"史谨","text":"万仞匡庐倚碧空，无边云气尽随龙。\n昼还忽锁千厓翠，夕散仍栖五老松。\n冷护石泉微有影，乱迷巢鹤竟无踪。\n君今复向云深去，屏迹当居第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48444,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画","author":"史谨","text":"乱峰如剑插天青，飒飒凉飙树底生。\n一鸟不鸣云散尽，无人收拾万松声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48445,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠日本廉上人","author":"史谨","text":"一别扶桑路，俄惊二十秋。\n暂逢皆白首，相顾各青眸。\n就里诸天近，行边一念休。\n出山应扫迹，渡海不须舟。\n雨过龙归钵，经残月满楼。\n尚期他世会，聊共此生浮。\n猿鸟陪吟眺，乾坤任去留。\n堂堂天竺境，都在汝心头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":48446,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]