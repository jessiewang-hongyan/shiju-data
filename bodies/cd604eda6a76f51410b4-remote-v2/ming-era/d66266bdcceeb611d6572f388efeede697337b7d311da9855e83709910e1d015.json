o":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34976,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"墨兰 其一","author":"王恭","text":"仙佩销残楚畹香，为谁琴里寄凄凉。\n荒苔野棘稀人到，摇落寒山秪自芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34977,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"墨兰 其二","author":"王恭","text":"澧云湘水思悠悠，捐佩空歌总是愁。\n自负山林幽隐性，不教人见也风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34978,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"墨兰 其三","author":"王恭","text":"金薤琳琅九畹秋，湘皋环佩为谁留。\n空香总逐寒霜尽，不比西风落叶愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34979,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书冯公肃耕读小景","author":"王恭","text":"垂萝云捲读书声，谷口人稀晚自耕。\n不见五陵松柏外，秋风离黍故宫情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34980,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送乐舞生陈志淳还京","author":"王恭","text":"踯躅初红柳作花，五云西上是京华。\n承平欲奏钧天乐，莫遣仙舟后别家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34981,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"方壶竹","author":"王恭","text":"一鹤东飞出楚云，手携湘绿下入群。\n几多金薤琳琅影，散入秋声夜夜闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","p