[{"title":"立夏","author":"符锡","text":"春光留不住，属目又朱明。\n雨长悬岩树，风喧接叶莺。\n市邻朝伐鼓，童释夜吹笙。\n转觉乡心碎，归帆几日程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朗都纲谢官居龙山绝顶结小庵予号曰鹊巢赠以诗","author":"符锡","text":"未出沙弥臼，还来寄鹊巢。\n安禅云共被，施食鸟分匏。\n香篆空中灭，经鱼露下敲。\n任他尘劫化，勘破此山坳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽宾峰董副郎先生并序","author":"符锡","text":"宾峰薄车驾，云卧武陵川。\n处世何如梦，游仙竟不还。\n庭乌泣夜雨，墓木拱寒烟。\n怀旧登堂客，能无倍惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辰士赵伯行之母贤而早寡伯行于予有一日之雅因丐挽章义不得辞","author":"符锡","text":"龙山逢赵子，怪问泪双行。\n御哀为慈母，大节凛秋霜。\n白日空山里，苍松古道傍。\n墓碑终不朽，潜德永幽光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贾文卿酌余龙兴寺叙别","author":"符锡","text":"野客城西寺，跻攀兴不穷。\n扶云石蹬□，泛月酒杯空。\n胜景馀方外，名山似剡中。\n临流话分手，他夜几人同。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"佥宪贾公谢事西川怡神楚北锡忝通家敬呈鄙作公病初起适慰其怀云","author":"符锡","text":"释宪还刀服，陶然世虑空。\n年年见菜子，日日舞春风。\n野水醅尊绿，山花压鬓红。\n不知全楚外，斯乐几人同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上舍李民望厥考草窗晋叔王子志其墓仍祈余作","author":"符锡","text":"纪实王生在，还因识草窗。\n读书名不涉，晓法化能襄。\n酉水遗波远，辰山宿草长。\n传家徵世泽，起凤表民望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钓艇","author":"符锡","text":"适兴江艖老，何妨并日餐。\n纶□白日静，高荫绿杨宽。\n得酒妻同话，弄云儿共欢。\n本无匡济隐，渭猎免相干。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙池湖","author":"符锡","text":"湛湛龙池景，轻航日晏寻。\n锦凫回断岸，翠筱郁孤岑。\n楫晓天平渡，容秋镜忽临。\n菱歌隔前浦，饶得助清吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湘山寺","author":"符锡","text":"寺裹湘山僻，林连渌水攲。\n鱼盐通小市，鹅鸭满前池。\n荒殿游人憩，残僧避客窥。\n乡园独延伫，龙战羽书迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巳邜八月东还次萍乡感激时事适少府李君见邀且谕以尝献策平寇移时江省报至不觉喜形于色相与散步正衙纵观楚王台古桂姿有凌云之气慨然赋此用写一时欣戚之怀云","author":"符锡","text":"少府高时论，尘襟喜暂开。\n我无乡井累，渠有折冲才。\n月露团秋桂，天风落古台。\n闲寻五柳宅，剩对菊花杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梅谷次太守韵","author":"符锡","text":"不见寒花破，风传何处村。\n写真诗落眼，牵梦客消魂。\n谷口度春雪，城头掩竹门。\n幽芳抱终日，渠共尔忘言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题水阳山二亭 其一","author":"符锡","text":"水阳何处在，亭子对山枫。\n果熟邻人摘，垣周曲径通。\n步凉松洒雪，舒啸竹交风。\n脱略休容易，尘襟几个同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题水阳山二亭 其二","author":"符锡","text":"静爱山亭好，青枫远市居。\n林秋万籁□，郊月四窗虚。\n客访弹琴谱，儿雠种树书。\n传闻建溪叟，莫浪比经畬。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送念斋侍御赴阙","author":"符锡","text":"清江渺万里，天际指皇都。\n绕阙双龙迥，横秋一鸮孤。\n白云回使节，红树促征舻。\n轺过霜威在，巴人忆得无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送一溪侍御按蜀","author":"符锡","text":"西川杳何在，冰雪岁将阑。\n天使驰驺去，巴人按节看。\n星回阁道近，春入豸袍宽。\n曲士怀同调，徒歌行路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"族叔一中发迹思南出宰东安政缉民和寄赠二章 其一","author":"符锡","text":"□作东安宰，南薰想令闻。\n清标八桂雪，幽思九疑云。\n鹯击材非偶，鸾栖志不群。\n遥怜阮咸在，放意徒云云。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"族叔一中发迹思南出宰东安政缉民和寄赠二章 其二","author":"符锡","text":"德人尝觌面，宗望不虚传。\n自少山阴兴，空怀叶令仙。\n书当回雁断，愁与岳云连。\n试问零陵水，何当汇海堧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿诗","author":"符锡","text":"江上坦斋老，行藏何自由。\n乐窝洲万硕，生计橘千头。\n耳顺方年及，天真与物游。\n况逢嘉靖日，蓬海看添筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郑太守乃翁七十寿卷","author":"符锡","text":"节使临江郡，瞻云独系思。\n屋添闽海算，椿老万年枝。\n耆会高贤满，丰庖厚禄移。\n未缘朱绂系，覃泽柰明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木湖寺","author":"符锡","text":"山寺重临日，荒榛满目前。\n瓦灯秋照佛，草榻夜安禅。\n殿敞流云气，林回折涧泉。\n买田吾欲老，未必是尘缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟次阿城次韵王推府见赠","author":"符锡","text":"朝宗美江汉，亦自抱微涓。\n舟楫关河晚，秋风鸟翼先。\n贫非坚壮节，老不恨流年。\n对客仍寒夜，高怀霁景兼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沙湖为王良二","author":"符锡","text":"杨子清江客，沙湖独系思。\n储经裕后日，买犊课农时。\n酒伴两三辈，莺花四五枝。\n谋生于此足，骑鹤更何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏柬贤十良二","author":"符锡","text":"邂逅沙湖子，他乡眼倍明。\n金炉湖上意，秋燕幕中情。\n旧有东峰约，重寻颖水盟。\n燋桐应未拂，卓氏不须惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南塘卢子十二","author":"符锡","text":"广陵遇卢子，深悉契家情。\n昔别矜年少，今知重老成。\n观濠鱼得趣，混迹鹾能轻。\n宦拙兼迟暮，无嗟难弟兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨子忠尹青田 其一","author":"符锡","text":"郊行频送远，连露扑花英。\n折赠东欧使，迟回北斗城。\n颂应归政简，閒得以诗鸣。\n往事何嗟及，寒松晚更荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨子忠尹青田 其二","author":"符锡","text":"四十年才过，郎官领未迟。\n虚堂聊启饯，明月恰圆时。\n礼乐还渠讲，清贞实我师。\n汇缘匪根蒂，从笑广军奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送崔有仪还六安","author":"符锡","text":"信美安丰使，争看报政归。\n浓花迎候馆，甘澍逐征騑。\n脕颖思应锐，朝宗愿岂违。\n摧颓如念我，时有塞鸿飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃花坞书屋","author":"符锡","text":"吴城十万户，隙地可桃花。\n接叶团清露，疏窗影绛霞。\n读书忘岁月，学圃是生涯。\n错认迷津处，升堂小径斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠程明誉","author":"符锡","text":"冠带荣乡士，冰霜集帝城。\n美才当见试，详法足□名。\n眼角风云壮，毫端兰竹清。\n鸿胪期有赠，戎幕倚参衡。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平湖","author":"符锡","text":"不见平湖叟，逍遥□步阳。\n烟波迷旧钓，鸥鹭起晨光。\n矩棹何年别，孤吟此夜长。\n春明重翘首，才薄愧榆扬。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄彦七告假归省","author":"符锡","text":"君方广陵去，即拟到辰阳。\n远徼追游惯，高楼逸兴隆。\n槎浮天汉出，梦绕帝居长。\n老觉还丹在，林砂岂冀将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送欧东井宰景陵","author":"符锡","text":"汉水龙飞日，波澄七泽通。\n景陵新属邑，天府旧行宫。\n弦奏薰风里，棠滋细雨中。\n宰官前席召，谁复首群公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送符道州","author":"符锡","text":"政拙庸何病，吾宗自得师。\n云山增旧槩，风节照当时。\n雁过三湘远，音□五岭迟。\n春陵贤剌史，继此复书谁。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"质庵","author":"符锡","text":"若个藏修地，弥文尽返淳。\n未妨违俗尚，稍喜出风尘。\n奉引瞻天仗，班行肃缙绅。\n卫贤如可起，此道竟谁陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠梅谷贡士卒业南都","author":"符锡","text":"合欢天上侣，旋棹复何之。\n愁遣羁人独，诗怀作者谁。\n阜云盘凤阙，岩桂引虬枝。\n会想跻游惬，无忘此宿期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘朝信之荆门","author":"符锡","text":"郡中潭德化，宾幕最为亲。\n申土推恩旧，荆人属望新。\n雨消三伏著，潦净六街尘。\n酌酒欢相别，离歌且莫陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送江汝州全之","author":"符锡","text":"汴汝悬鱼使，冰霜别凤城。\n英风开五马，甘澍逐双旌。\n郡僻逢迎简，堂高讼牒清。\n故人时问讯，石帖尚分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观莲城西主人出酒鼓琴偶用璧间韵奉呈同志一首","author":"符锡","text":"盆莲开雨后，幽趣几人知。\n藕出华峰顶，泉分太液池。\n受风香迸吐，倾日盖频移。\n烂熳西堂会，琴尊幸晚随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次日再叠前韵答李慱厅","author":"符锡","text":"漫爱芙渠好，花开不自知。\n流云低彩槛，宿雨涨盆池。\n越岁容如故，涵贞态岂移。\n赏筵能赋者，操翰愿追随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送侯生","author":"符锡","text":"侯生将家子，弱冠得腰金。\n晓日辞枫陛，雄姿映羽林。\n冀城春色早，漳海暮云深。\n滨别何堪赠，边隅□主心。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感雨漫兴答李慱厅二首 其一","author":"符锡","text":"春郊向不雨，夏夜苦无休。\n云带嵩□瞑，衢通汴泗流。\n衡门人迹少，禁苑暮烟浮。\n宴息㭺齐阁，鸣鸠厌底求。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感雨漫兴答李慱厅二首 其二","author":"符锡","text":"驱马长安陌，不为泥泞休。\n山山雨未歇，处处潦交流。\n稍喜炎埃净，翻虞殄气浮。\n秋成民有赖，赋入省诛求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜晴次答李慱厅二首 其一","author":"符锡","text":"一雨三农望，才看足便休。\n亨嘉怀睈代，调燮杖儒流。\n院柳含风细，池莲荡日浮。\n典祠真吏隐，疏懒更何求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜晴次答李慱厅二首 其二","author":"符锡","text":"雨馀观物态，吾意亦休休。\n野鸟平轩过，晴云满户流。\n卷舒聊自适，名实任渠浮。\n酤客床金尽，邻家尚可求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明供祀还感兴三首 其一","author":"符锡","text":"天造兴王地，长陵百世宗。\n群龙翔日表，万马下云中。\n肇祀春添土，神谋早建宫。\n楼碑光日月，岁节走臣工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明供祀还感兴三首 其二","author":"符锡","text":"晓日红门启，元寮遣祀崇。\n金传三奏定，殿献七陵通。\n御柏凝香雾，仙桥隐驶潨。\n荧星散笼烛，归骑万山中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明供祀还感兴三首 其三","author":"符锡","text":"祀喜亲供暇，春牵野兴忙。\n地穷锤石口，迹绝老君堂。\n纵目隅东海，重关限朔方。\n兹游诚不易，虚约后屏尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汪本之达州别驾","author":"符锡","text":"别驾通州去，宁嗟蜀道难。\n金华千古镇，巫峡百重关。\n入馔江鱼美，醺人曲米宽。\n独怜才力健，双鬓未曾班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠李经卫邦立","author":"符锡","text":"旧识李参军，多能众所闻。\n才猷摅幕府，■浪出尘氛。\n神术缘谁受，还丹许我分。\n何时访蓬岛，挥袂共乘云。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫荆关漫兴","author":"符锡","text":"紫塞三千里，雄关百八盘。\n汉营空绝漠，周鼎定长安。\n象逼中天近，台临五夏寒。\n胡儿莫窥伺，飞羽度应难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈上思思慎","author":"符锡","text":"思州新剌史，为别意何长。\n职贡通南海，声闻过越裳。\n凿蹄怀折坂，刷羽忆朝阳。\n麟凤应希有，将能滞一方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王方南守泉州","author":"符锡","text":"郡符岩芣重，闽海足兴思。\n斋阁论心旧，都亭载酒迟。\n苑边花蔟马，坐上雨催诗。\n何物堪持赠，遥传纪政碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送丁朗山剌杭州","author":"符锡","text":"越都新郡守，水部旧声华。\n风咏谁能似，湖山此正嘉。\n倒衣时见客，抱牍吏催衙。\n未减孤仙兴，梅残几树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑天挺别驾高州","author":"符锡","text":"倚伏不可道，出处圣之徒。\n我闻盐骥语，君出岭南途。\n孺子书千卷，高州饭一盂。\n地偏官自好，且莫问桑榆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘美中别驾广州","author":"符锡","text":"故人美利小，壮志雄千夫。\n岭南忽独往，鹔鹴谁共酤。\n寥廓监州远，腾骧瘴雨苏。\n官袍先锦里，且足老亲娱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送润州王贡士南还","author":"符锡","text":"故人高弟子，不问可知名。\n学易编常绝，论交盖始倾。\n黄金古台暮，白发异乡情。\n无计留君住，相思共月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周都宪得假驰驿送母还昆山","author":"符锡","text":"执法何容远，还家诏暂辞。\n圣情隆孝理，贤母被恩私。\n馔忆江鱼美，春生昼绣宜。\n周爰应不惮，衮职慰来思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大理郑公寿乃兄止斋登七十","author":"符锡","text":"南极腾辉远，平台注目劳。\n裕家勤伯氏，徵寿藐蟠桃。\n山水幽居适，风云宦业高。\n圣明多乐事，去住任霜毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"半舫斋 其一","author":"符锡","text":"半舫曹郎地，虚疑泛远天。\n永怀津济阔，推却簿书眠。\n云树浮空出，春禽傍榻前。\n何如在纶阁，纱帽醉吟偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"半舫斋 其二","author":"符锡","text":"画省非无署，幽斋别数椽。\n暂宜消俗虑，终岂恣高眠。\n魁硕门风在，清贞世泽传。\n居然对虚舫，不假渡平川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆九万通判绍兴","author":"符锡","text":"山水有胜槩，会稽自古名。\n独欣监郡往，不尽子长情。\n鉴影星河近，潮声鼓角平。\n自公多逸兴，吟睡句还成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再送九万","author":"符锡","text":"仙舟去日下，早晚达山阴。\n风雨秦碑在，蛇龙禹穴深。\n俗疲劳轸问，理裕惬幽寻。\n亦有临岐赡，无忘夙昔心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠刘世臣出宰赣榆","author":"符锡","text":"淮海东边邑，高人秉令初。\n激昂风夙远，清净理应馀。\n春雨农归业，秋灯户有书。\n烦君且安适，不远见徵车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代送世臣","author":"符锡","text":"赣榆何僻远，纵目海涛宽。\n失得虚能置，疲癃简自安。\n鹤鸣诗思逸，星彩剑光寒。\n风云眼前事，未足拟弹冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽永新贺司训","author":"符锡","text":"未论多贤地，如公道不贫。\n圣庭分铎远，蛮府作人新。\n种德非干誉，挥金乐为亲。\n九原高谊在，颓俗可还醇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬金近山夜坐怀颖江少谷二子 其一","author":"符锡","text":"老却狂生在，叨陪圣化多。\n时名推李郭，词藻避阴何。\n古木延陵剑，西风易水歌。\n凭谁话凉夜，骑马月中过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬金近山夜坐怀颖江少谷二子 其二","author":"符锡","text":"秋思何关客，忉忉逆旅边。\n凤城高士远，鲸海一旌悬。\n勋业非吾事，文章岂世传。\n终当谢明主，相就白云眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]