r":19072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞曲十六首 其三","author":"胡应麟","text":"年少江东智略饶，长驱日本破天骄。\n不缘羽扇能挥敌，铜雀春深闭小乔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞曲十六首 其四","author":"胡应麟","text":"高宴从军乐事多，白登城上夜如何。\n数声清啸迎风发，十万前驱尽倒戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞曲十六首 其五","author":"胡应麟","text":"受降城下战初回，无定河边画角哀。\n落日沙场秋色满，题诗人在赫连台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞曲十六首 其六","author":"胡应麟","text":"磨灭雄心仗翠钿，幽兰一曲暮云前。\n从知顾盼仙郎熟，不向人前误拂弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞曲十六首 其七","author":"胡应麟","text":"幕拥青油夜漏迟，从军尔亦解观棋。\n不知淝水风行日，可似张玄授策时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞曲十六首 其八","author":"胡应麟","text":"骏马雕弧铁裲裆，何人不羡独孤郎。\n横戈夜度燉煌戍，直取凉州献未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞曲十六首 其九","author":"胡应麟","text":"跃马阴山白日低，拂云堆上醉如泥。\n弯弓错拟旄头落，并坠双雕大碛西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞曲十六首 其十","author":"胡应麟","text":"八法纵横擅彩毫，何烦抛掷事龙韬。\n聊飞尺檄萧关外，已报单于雪夜逃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞曲十六首 其十一","author":"胡应麟","text":"一笑能空塞北亭，寒光闪烁射青萍。\n歌残杕杜长城下，万仞燕然自勒铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞曲十六首 其十二","author":"胡应麟","text":"渔阳东望海云平，横笛偏吹骠骑营。\n绕夜落梅春不断，千山明月满龙城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞曲十六首 其十三","author":"胡应麟","text":"青海城头月照沙，黑山何处问琵琶。\n长缨尽缚呼韩将，重取明妃入汉家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞曲十六首 其十四","author":"胡应麟","text":"短小周郎五尺躯，侯门花色照长裾。\n莫言谈笑无奇策，百雉聊城祇片书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞曲十六首 其十五","author":"胡应麟","text":"君卿唇古诧纷纷，笔札兼传谷子云。\n怪得五侯鲭满座，铁椎曾夺信陵军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞曲十六首 其十六","author":"胡应麟","text":"拂袖行歌入帝都，灞陵亭上醉相呼。\n过从赖有任安在，使酒何劳挈灌夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河抵吕梁再寄徐参知即景舒怀共十绝句 其一","author":"胡应麟","text":"千顷清淮匹练长，使君高谊重馀皇。\n布帆无恙南风正，日暮行人到吕梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河抵吕梁再寄徐参知即景舒怀共十绝句 其二","author":"胡应麟","text":"漫说陈登百尺楼，十年湖海浪成游。\n多情好是徐元直，一借仙槎问斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河抵吕梁再寄徐参知即景舒怀共十绝句 其三","author":"胡应麟","text":"星宿黄河浊浪澄，长淮飞雪罢奔腾。\n金堤万国输王会，玉盌千秋镇茂陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河抵吕梁再寄徐参知即景舒怀共十绝句 其四","author":"胡应麟","text":"栉雨梳风事若何，古来师克在人和。\n飞刍直接桑乾塞，转粟新成瓠子河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河抵吕梁再寄徐参知即景舒怀共十绝句 其五","author":"胡应麟","text":"花照桃源百里红，班荆曾此聚群雄。\n虚疑仙子栽灵药，莫认渔郎系短篷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河抵吕梁再寄徐参知即景舒怀共十绝句 其六","author":"胡应麟","text":"龙起曾惊大陆前，书生今握万夫权。\n轻裘沛上分曹处，鼓吹牙门白日悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河抵吕梁再寄徐参知即景舒怀共十绝句 其七","author":"胡应麟","text":"千仞云龙列翠屏，乱山环匝楚天青。\n干旄绝顶行人过，遥指元戎放鹤亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河抵吕梁再寄徐参知即景舒怀共十绝句 其八","author":"胡应麟","text":"芒砀龙飞大泽云，高台戏马送斜曛。\n胡床何处邀词客，清夜黄楼万柝闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河抵吕梁再寄徐参知即景舒怀共十绝句 其九","author":"胡应麟","text":"豹略熊韬冠世姿，双龙腰下剑雄雌。\n封侯莫讶儒生薄，谈笑曾纡十万师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河抵吕梁再寄徐参知即景舒怀共十绝句 其十","author":"胡应麟","text":"进履桥头国士踪，谷城山下记相从。\n功成屈指封侯日，重向金华问赤松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瀫元亭上听歌作","author":"胡应麟","text":"花竹周遭十二栏，万家明月满长安。\n夜深庭院天风起，队队霓裳出广寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]