[{"title":"寄成均诸先生二首 其二","author":"陈琏","text":"昔忝同官居胄监，客情都付笑谈间。\n校书共照青藜火，待漏曾联玉笋班。\n时雨寻常生璧水，祥云咫尺近钟山。\n别来几度怀清赏，安得诗同数往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游柏子潭伏读太祖皇帝神龙效灵碑","author":"陈琏","text":"此地曾经翠辇过，神龙率职效灵多。\n溥施甘雨回枯朽，尽使黎民乐太和。\n圣制万年昭日月，奎星午夜烛山河。\n巍巍圣德同天大，汉主徒为沛上歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马神庙陪祭宿龙潭精舍","author":"陈琏","text":"风露潇潇秋满天，斋居清坐不成眠。\n月光烛地鹤在树，云气满山龙起渊。\n灯歇兰膏销紫焰，垆焚柏子袅青烟。\n钟声催动陪严祀，独立瑶坛礼意虔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登农山访张道士故庵遗址因望钟山偶赋","author":"陈琏","text":"公馀偶到丰亭上，踏破崖前苍藓纹。\n雨过草香衣染翠，日晴芝暖石生云。\n道人已去坛空在，词客重来路莫分。\n瞻望皇都才咫尺，钟山佳气自氤氲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢恩偶成","author":"陈琏","text":"昨日承宣到玉京，赐金增秩荷恩荣。\n衣颁内藏传中使，宴赐容台近列卿。\n沉水香清焚宝篆，葡萄酒酽泻瑶觥。\n微生何幸沾休泽，愿效涓埃答圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄致仕尚书义门郑公仲与","author":"陈琏","text":"旧拜春官品秩崇，明良千载喜遭逢。\n官壶驰赐葡萄紫，锦诰荣颁玉篆红。\n孝义家声闻四海，经纶事业著南宫。\n如今已遂悬车志，闲向山中伴赤松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄南安训导廖慎初","author":"陈琏","text":"振铎南安已九年，西江人士共称贤。\n宾筵佳豆诸生荐，讲席青毡奕世传。\n芹泮香清时雨足，梅关翠合瘴云连。\n稽勋早晚膺高擢，定有声名著日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄学圃黄先生兼柬览德陈先生","author":"陈琏","text":"别来岁序几回更，南望乡关眼倍青。\n洛社衣冠逾昔日，襄阳耆旧半晨星。\n蓝溪派远连洙泗，览德名高学考亭。\n何日承恩归故里，重趋讲席听谈经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿萱堂为主事娄文昌赋","author":"陈琏","text":"南极星明化日长，北堂萱绽政芬芳。\n轻分翠叶鹦鸰碧，初吐金花鹄嘴黄。\n和气雍雍生绮席，清香冉冉入瑶觞。\n朝回戏綵欢无奈，惟愿慈闱乐寿康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"追和亢宗陈主事见寄韵","author":"陈琏","text":"载酒同游忆去年，荷花荡里醉乘船。\n香分榄子焚金篆，茶拣春芽煮玉泉。\n绕廓好山多似画，到村荒径直如弦。\n灵岩石上题诗遍，昭代才名岂浪传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵纯沈福二御史按治交阯","author":"陈琏","text":"绣衣同日沐恩光，路入南交万里长。\n藩阃总超唐节镇，图经原载汉封疆。\n槟榔树老屯云盛，荔子花开带雨香。\n远近争看骢马至，愿敷德化遍炎方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题传桂卷","author":"陈琏","text":"阀阅高门众所誇，古今人物擅才华。\n诗书泽远承先世，科第才高萃一家。\n雁塔联名题露石，蟾宫接武折秋花。\n也知积庆由来久，桂籍流芳未有涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和洪源先生游琅琊韵","author":"陈琏","text":"胜日寻僧到上方，满山空翠湿衣裳。\n树围西崦春云绿，花落平池暮雨香。\n独鹤静依岩下宿，潜鳞多向沼中藏。\n幼卿去后欧曾老，翰墨今谁嗣耿光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宴集柏子潭分韵得招字","author":"陈琏","text":"昨荷诸公折简招，偶从幽谷到山椒。\n一林花气薰兰麝，万壑松声讶海潮。\n茶煮新泉分石鼎，尊开佳酝注椰瓢。\n兴来痛饮情偏美，醉听风前碧玉箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永乐七年春二月九日上巡狩北京越三日至滁阳予率官吏父老郊迎二首 其一","author":"陈琏","text":"罕毕前驱辇路长，马随仙杖识天香。\n明良喜际风云会，士庶欣瞻日月光。\n羽葆龙旂纷杂遝，金舆玉略倍焜煌。\n时巡今睹雍熙世，礼乐文章迈汉唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永乐七年春二月九日上巡狩北京越三日至滁阳予率官吏父老郊迎二首 其二","author":"陈琏","text":"圣主时巡稽古礼，千官扈从出銮坡。\n祥云拥驾青鸾引，御宝随车白象驮。\n四海清宁歌治化，万方丰稔庆时和。\n小臣何幸逢嘉会，此日思沾雨露多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄翟进士溥福","author":"陈琏","text":"我爱天朝新进士，多君文誉著金闺。\n开尊对客浮春蚁，待漏趋朝听晓鸡。\n政喜云霄同作伴，可堪江海又分携。\n京华何日重相会，紫陌看花散马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄余仲逸昆仲","author":"陈琏","text":"闻道忠襄谱谍存，风流文采见诸孙。\n传家不坠诗书业，满邑咸誇孝义门。\n谖草堂前来采服，紫荆花下列芳尊。\n怜君昆季多才俊，何日重逢共讲论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄用拙彭徵士","author":"陈琏","text":"蚝冈自昔多佳致，此日怜君喜卜居。\n花坞壶觞时劝酒，草堂灯火夜观书。\n莫嫌淡泊生无计，且得安閒乐有馀。\n若念青云旧知己，平安莫惜寄双鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄祝仲韶","author":"陈琏","text":"别后俄惊四载馀，可人风度想如初。\n桂花香里裁唐律，柿叶霜前学晋书。\n痛饮每怀倾绿蚁，平安还荷寄双鱼。\n高堂禄仕膺眉寿，早晚期来问起居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽董伯琪教谕","author":"陈琏","text":"道学渊源众所推，一朝捐馆实堪悲。\n虚斋夜月黄粱梦，旅榇西风薤露诗。\n行义固应朋辈重，文章当有史臣知。\n承家二子殊英特，足慰重泉永夜思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄给事中罗亨信","author":"陈琏","text":"献纳才高动禁闱，生平素志喜无违。\n趋朝玉佩随班入，侍宴金花压帽归。\n天近紫垣宫漏远，日长青琐谏书稀。\n别来咫尺频瞻仰，夜夜奎光烛太微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陈廷贡先生","author":"陈琏","text":"家学相承最有声，閒居林下遂高情。\n阶兰自放风光淡，庭草不除春意生。\n空谷几人甘隐遁，少微终夜自光明。\n长才政好陈歌颂，万里黄河近日清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瞻云为给事中罗亨信赋","author":"陈琏","text":"自沐恩荣侍禁闱，忠心曾受九重知。\n孤云极目五千里，一日思亲十二时。\n陟屺徒令增浩叹，趋庭应见遂归期。\n嗟予久切高堂念，引领天南思欲飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄竹林张先生","author":"陈琏","text":"泮水归来罢采芹，幽居林下绝嚣氛。\n螺杯醉客秋吟月，蜡屐寻僧晓蹋云。\n开沼养鱼多种藻，藏书辟蠹盛栽芸。\n何时乘兴寻君去，煮茗谈诗到夜分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和杨嗣庆见寄韵","author":"陈琏","text":"我爱西江老徵士，传家喜有百年书。\n才名重似连城璧，文采光如照乘珠。\n洛社衣冠原自好，柴桑风致未应殊。\n山中著述人争诵，莫惜佳章远寄予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送佥宪武大本赴交阯参赞英国公","author":"陈琏","text":"新承恩命出銮坡，万里交州喜再过。\n公馆清风荣使节，蛮溪明月听夷歌。\n藩臣才略唐都护，征虏威名汉伏波。\n闻道分茅铜柱在，古今勋业共峨峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"召赴春闱同考太仆寺诸公饯于三里冈春闱稿","author":"陈琏","text":"奎光夜夜烛三台，闻道春闱早晚开。\n岂意徵书天上降，遂劳使者日边来。\n暂停柳下青丝鞚，同醉花前白玉杯。\n行望京华应咫尺，钟山云气接蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉天门早朝","author":"陈琏","text":"校艺春闱荷主知，喜随鹓鹭拜彤墀。\n夔龙礼乐隆熙代，贾董文章际盛时。\n阙下虹光燃宝炬，花边云影动旌旗。\n尚书敷奏天颜喜，同沐恩波出凤池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"锡宴礼部","author":"陈琏","text":"紫禁朝回响佩珰，南宫锡宴礼非常。\n乌纱斜插金花粲，银瓮初开御酒香。\n盛世已闻麟在薮，高冈喜听凤鸣阳。\n小臣屡得沾恩泽，遥仰丹宸祝圣皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至凤阳","author":"陈琏","text":"太祖龙飞当此地，中都形胜四方闻。\n长淮水净明如练，万岁山高半是云。\n天下车书归大统，城中甲第总元勋。\n皇陵咫尺频瞻仰，王气时为五色纹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大龙兴寺","author":"陈琏","text":"高皇敕建龙兴寺，御笔亲书第一山。\n圣制万年光宝地，慈云终日护禅关。\n楠檀香度清风细，薝卜花开白昼闲。\n独步修廊看画壁，不知身在翠微间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河","author":"陈琏","text":"万里奔流势转雄，风雷曾见舞鱼龙。\n西来派出昆崙远，东去波连弱水通。\n砥柱龙门神禹迹，宣房瓠子武皇功。\n桑田沧海应非偶，谁觅当年九道踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"相国寺","author":"陈琏","text":"相国千年地有灵，巍巍楼阁倚苍冥。\n空闻碧落新敲磬，谁见琅函旧赐经。\n华表月明留鹤语，石池水退带龙腥。\n惠云一去无消息，空有新刊壁上名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洛阳","author":"陈琏","text":"繁华当日说西京，人事千年几变更。\n平乐台荒空见迹，荜茥馆废尚留名。\n龙门雨过波涛壮，金谷春回草木生。\n一自尧夫经过后，天津谁复识鹃声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太初宫怀古","author":"陈琏","text":"太初宫在函关上，一片遗基几百春。\n谩有狐狸来作穴，更无鸾鹤与为邻。\n灵符玉检神何在，石室瑶台迹已陈。\n景物亦随今古异，断碑荒础雨苔新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"函谷关","author":"陈琏","text":"谁将鬼斧凿嶙峋，函谷之名天下闻。\n望气一时知老子，闻鸡半夜走田文。\n崖经宿雨石将堕，尘暗西风路莫分。\n今日车书归大统，不劳鱼钥守三军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"到潼关喜雨","author":"陈琏","text":"途长连日苦炎蒸，一雨东来喜不胜。\n添作河流黄万顷，洗开华岳翠千层。\n檐垂银竹光如玉，簟展桃笙冷似冰。\n一榻萧然清不寐，仆夫韝马候晨兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华清宫怀古","author":"陈琏","text":"唐代离宫久已荒，华清应似鲁灵光。\n草迷翠辇经游路，池有诸嫔赐浴汤。\n满壁丹青空见画，閒庭花木自闻香。\n登临不用兴长叹，且向高冈咏凤凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朝元阁怀古","author":"陈琏","text":"忆昔神君下降来，朝元宝阁倚山开。\n九重天近春如海，五色云深锦作堆。\n杰搆几番遭劫火，遗基空自长莓苔。\n长杨昨夜西风起，吹作秋声万壑哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"温泉","author":"陈琏","text":"华清楼阁骊山下，几窍温泉出地中。\n波涌石莲光淡淡，香浮粉腻暖溶溶。\n洞门深锁无人到，复道来游有路通。\n一自翠华西幸蜀，空馀遗址在离宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少林寺","author":"陈琏","text":"四面峰峦翠作堆，重重梵宇倚云开。\n空传北魏文皇建，曾见西天达摩来。\n古塔有名依绿树，断碑无字卧苍苔。\n登临每喜询遗事，闲共高僧坐石台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青阳宫怀古","author":"陈琏","text":"谁搆琳宫太室前，昔年遗址尚依然。\n松阴凿径通岩穴，花底流觞引石泉。\n云气常留虚白室，丹光高射蔚蓝天。\n浮丘道士今来否，瑶草离离满玉田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒中岳祠","author":"陈琏","text":"巍巍碧殿倚苍冥，玉节金幢拥百灵。\n乐石镌碑彰瑞应，斋廊画壁杂丹青。\n朝廷锡号恩尤重，使者函香意独精。\n维岳降神闻自昔，愿生申甫佐明廷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嵩山","author":"陈琏","text":"五岳惟嵩位独尊，诸山环向侣儿孙。\n青鸾白鹤时常至，玉检金书世永存。\n地毓坤灵钟厚土，天教雄伟壮中原。\n闲从万岁峰头望，五色祥云护帝阍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会仙观","author":"陈琏","text":"昔会群真地有灵，琳宫玄馆又重兴。\n仙翁成道忘人我，宝鼎还丹护甲丁。\n华表年深留鹤语，黄河水长带龙腥。\n绿阴满院清如许，闲读黄庭一卷经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿州","author":"陈琏","text":"胜地欣从六月过，藕花无数满城河。\n扶疏亭下竹何在，会义庭前草已多。\n建郡当年号南宿，怀人此日忆东坡。\n明朝又过符离店，满眼云山翠似螺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州","author":"陈琏","text":"彭城城下草萋萋，无数楼船泊大堤。\n二水合流通汴泗，远山入望是青齐。\n黄茅冈上云生石，戏马台前雨作泥。\n此际不胜怀古意，酒酣赋就气如霓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遇济宁蒋大守资","author":"陈琏","text":"京国分携近十期，客中邂逅慰怀思。\n寇恂自信能治郡，司马原来善属辞。\n芍药省中曾视草，紫薇垣里旧题诗。\n曲江事业吾邦重，好把忠贞答圣时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别河东教谕周德润","author":"陈琏","text":"桂林别后十年过，转瞬光阴似掷梭。\n我正较文趋北阙，君方振铎教东河。\n金兰托契情何厚，锦轴题诗意转多。\n明发庄平回首处，谷城山色翠峨峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至北京","author":"陈琏","text":"闻说北京形势地，此来自觉壮怀开。\n九逵车马云屯盛，万国诸侯辐辏来。\n题柱相如应有赋，上书贾谊更多才。\n圣朝频下兴贤诏，不数黄金漫筑台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入试院偶成","author":"陈琏","text":"宴罢薇垣赴棘闱，衣冠济济肃威仪。\n官槐花早临街放，宫柳条长拂地垂。\n今我较文当世盛，诸生角艺在斯时。\n蟾宫丹桂秋来盛，谁解高攀第一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登崇文阁","author":"陈琏","text":"飞甍百尺近苍穹，万里乾坤在眼中。\n海子桥横金螮蝀，居庸山簇翠芙蓉。\n云栖画栋晨光淡，雨过湘帘爽气通。\n几度凭阑凝望处，皇都佳气郁葱葱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"文丞相祠","author":"陈琏","text":"堂堂大宋文丞相，耿耿声名照古今。\n本拟卧龙兴汉室，竟孤四海望商霖。\n平生不负读书志，一死能明报国心。\n遗像至今犹俨雅，祠前老柏翠森森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海子桥","author":"陈琏","text":"海子东头海子桥，阑干几曲琢琼瑶。\n芰荷叶老香犹在，杨柳条长翠未消。\n公子锦衣金勒马，佳人红袖木兰桡。\n太平风景今尤盛，满耳歌声杂凤箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庆寿寺","author":"陈琏","text":"暇日行经凤阁西，喜瞻佛刹与云齐。\n高僧屡致金襕赐，华扁曾承御墨题。\n烟满禅房香蔼蔼，雨荒鹤径草萋萋。\n偶来林下寻碑看，祇树阴中听鸟啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会真宫","author":"陈琏","text":"会真宫里访天倪，琳馆清虚亦自奇。\n宋帝巡游曾驻跸，回仙去后谩留诗。\n烟生宝鼎存丹火，雨过瑶田长玉芝。\n明发乘风快登览，泰山顶上候安期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登泰山","author":"陈琏","text":"青鞋踏破翠重重，晓上天门第一峰。\n静听泉声鸣涧底，遥看云气出封中。\n崖存唐代原刊颂，山有秦时旧种松。\n不惜乘风登旧观，闲披瑶草觅仙踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登阙里奎文阁","author":"陈琏","text":"杰阁巍巍百尺高，也知兴建自金朝。\n牙签插架书仍在，芸草满厨香不消。\n圣学万年昭日月，奎光终夜烛云霄。\n凭阑自觉襟怀壮，邹鲁山川入望遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐王祠","author":"陈琏","text":"峨峨祠宇白云中，万木幽深路可通。\n文石叠街红码碯，好山当户翠芙蓉。\n寒花淡淡含秋雨，落叶萧萧起暮风。\n每岁祠官严祀享，尊崇应荷圣恩隆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"见东平城外墓林偶成","author":"陈琏","text":"东平城外半松楸，古冢累累迹尚留。\n翁仲凄凉空在目，石麟埋没几经秋。\n金丹难驻容千载，贵贱同归土一丘。\n欲觅断碑稽往事，白杨风起使人愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月初一日奉天殿早朝","author":"陈琏","text":"凤诏班师大驾还，金门冠佩肃千官。\n祥云常护蓬莱殿，旭日光临玉笋班。\n扇影参差开雉尾，天威咫尺觐龙颜。\n词臣争进平胡颂，万岁千秋喜治安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重游天师庵","author":"陈琏","text":"阆风玄圃知何处，城里仙居亦自奇。\n珠树深深巢瑞鹤，瑶田春暖长琼芝。\n修廊画壁丹青石，老碣文章字画奇。\n为爱道人谈往事，紫薇花底坐多时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨州蕃禧观","author":"陈琏","text":"谁知今日蕃禧观，原是当时后土祠。\n云散琼花仙去远，月明华表鹤归迟。\n偶逢故老谈遗事，旋拂苍苔读旧碑。\n欲觅欧公行乐处，无双亭下草离离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":49886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]