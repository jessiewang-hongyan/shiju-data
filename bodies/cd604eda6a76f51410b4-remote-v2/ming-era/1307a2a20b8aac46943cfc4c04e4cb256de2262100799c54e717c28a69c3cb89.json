[{"title":"招隐 其四","author":"霍与瑕","text":"盍归乎来，前汀送远舟，明虾大且脩。\n与公聊乐饮，乐以忘忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南江遐祉 其一","author":"霍与瑕","text":"园有蔬兮紫姜，嘉果熟兮柑黄。\n绿橘垂兮青焦，荐寿筵兮侑觞。\n山之高兮水之长，君子偕老兮乐未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南江遐祉 其二","author":"霍与瑕","text":"园有蔬兮枸杞，嘉鱼登兮鳊鲤。\n酒熟兮蟹肥，荐寿筵兮燕喜。\n橘之洲兮栗之里，君子偕老兮乐未已。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"开复旧河濠 其一","author":"霍与瑕","text":"河水之悠悠兮，人或以为尤兮。\n口胡为乎不缄。\n将起羞兮，尚慎旃哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"开复旧河濠 其二","author":"霍与瑕","text":"河水之涟漪兮，人或以为非兮。\n言胡为乎伤易。\n诞以支兮，尚慎旃哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北山有松 其一","author":"霍与瑕","text":"北山有松，其干凌云。\n露雨泽之，几百千春。\n于嗟乎，松之茂兮，慎斋之寿兮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北山有松 其二","author":"霍与瑕","text":"北山有柏，其干凌霄。\n春华不滋，秋柯不凋。\n于嗟乎，柏之茂兮，慎斋之寿兮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桂之坡 其一","author":"霍与瑕","text":"桂之树，彼美无度。\n几回春风，几回春雨。\n凉秋八月，太清泫露。\n有茁其华，芬芳布濩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桂之坡 其二","author":"霍与瑕","text":"桂之华，清海之涯。\n霭霭天香，灿灿朝霞。\n凉秋八月，吐此奇葩。\n广寒之宫，宴尔维嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桂之坡 其三","author":"霍与瑕","text":"桂之叶，繁阴叠接。\n桂之枝，结子叠垂。\n桂之下，谁来游者。\n桂之坡，丛树婆娑。\n我有嘉宾，乐饮微酡。\n呦呦鹿鸣，食野之莎。\n我啸我歌，坐石烂柯。\n百千斯年，永矢弗过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"圣人出","author":"霍与瑕","text":"圣人出，黄河清。\n多士生，邦家祯。\n多士思皇，元老虑四方，九重垂裳。\n南暨遐荒，莫敢不来王。\n猗欤休哉，万寿无疆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"战城南","author":"霍与瑕","text":"战城南，疾风雨，三军夜渡龙江水。\n频年辛苦瘴烟中，白尽眉须行未止。\n于皇将士，绵绵翼翼。\n天威赫奕，蛮丑荡涤。\n平乐既平，怀远亦怀。\n新宁十寨，次第绥来。\n是惟元老之猷，一何壮哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雉子斑","author":"霍与瑕","text":"雉子斑，春草绿，呼雏唤侣戏西畴。\n有时群向清溪浴，逢人何事太从容。\n王孙出游无弹弓，至人在位煽仁风。\n煽仁风，万物若山梁之雉，鸣且啄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阊阖开","author":"霍与瑕","text":"阊阖开，临九垓，正面南离俯交阯。\n道一风同万馀里，哲人应运绥福履。\n绥福履，践泰阶。\n开府南州星几回，河清海晏越裳来。\n天子有新命，元老归来曰：总是宪台宪万邦哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有所思","author":"霍与瑕","text":"有所思，山之西，苍梧千里九疑低。\n画堂高歌劝君酒，春风满座祝君寿。\n一别十多年，孤山锁暮烟。\n天涯知己青编在，西南有记谁当采。\n廉颇空饱，冯唐易老。\n有所思，山之西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄","author":"霍与瑕","text":"薰风五月隔江来，吹彻重城上玉台，五弦琴奏鹤徘徊。\n鹤徘徊，人吏散时，一挥蒲葵扇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长歌行","author":"霍与瑕","text":"人孰不有父，王侯为之教其子。\n人孰不有兄，王侯为之教其弟。\n青青子衿，忠信孝悌。\n出言有章，邦家之光。\n猗其中洲之菁莪兮，北山有杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"短行歌","author":"霍与瑕","text":"我行端州，三年六度。\n载见君子，不改其步。\n乃如之人兮，霭阳春兮。\n渊乎是类，吾不知其里。\n炎天久坐，使我忘暑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大堤行","author":"霍与瑕","text":"朝行大堤上，游春士女三三两。\n暮行大堤上，唱歌卖饼声嘹喨。\n堤畔塔，一何高。\n耸天柱，补坤鳌。\n完瑞气，育英髦。\n谁其作之民忘劳。\n千斯年斯，绎子之绵斯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采莲曲","author":"霍与瑕","text":"七星岩下采莲花，莲花人面照明霞，昔年湖水注东斜。\n谁凿渠，绕城左。\n缘东堤，顾复我。\n泛莲舟，出江头。\n摇慢橹，溯安流。\n千斯年斯，绎子之绵斯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花落","author":"霍与瑕","text":"梅花落尽端州道，鹧鸪啼乱春山晓。\n女郎两两踏歌行，愁杀嫣绵堤畔草。\n堤畔草，使君车，三年为政乐何如。\n歌且谣，来趁墟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"公无渡河","author":"霍与瑕","text":"公无渡河，罗旁绿水恶风波。\n深潭静夜舞蛟鼍，豺狼白昼血人多。\n血人多，将奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"战城南","author":"霍与瑕","text":"战城南，烽燧举。\n罗旁贼首猛如虎，陈侯歼之不一鼓。\n追奔逐北无遗侣，显显戎功上军府。\n谗烁金，毁销骨，盖世英猷竟埋没。\n寄语凡夫莫鞅掌，烈士报国安图赏。\n中流屹石对贞心，年年岁岁，恶浪崩腾任消长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"越人歌","author":"霍与瑕","text":"今日何日兮，维舟崧台。\n客从西方兮，以酒浆来。\n清歌互劝兮，乐极增哀。\n绿江碧树兮发旧枝，望南山兮白云飞。\n白云飞兮天欲晚，王孙游兮何时反。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄鹄歌","author":"霍与瑕","text":"黄鹄一去兮云溟溟，岁月滋长兮无音声。\n有雏有雏兮五色毛羽，凌空高举兮来西土。\n来西土兮集故枝，飏清风兮振綵衣。\n天高日朗兮帝道重熙，河清海晏兮见羽仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度关山","author":"霍与瑕","text":"度关山，风乍寒。\n搴帷蹑露千峰晓，黄童白叟随车绕。\n阳春有脚少君来，旧日遗黎康乐哉。\n康乐哉，归安处。\n门无咆哮吏，日高眠未起。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采桑度","author":"霍与瑕","text":"采桑度，春晚人行路。\n今岁蚕丝大有收，时雨家家急农务。\n使君来，问疾苦，山村父老嬉无语。\n听流莺，转高树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"战城南","author":"霍与瑕","text":"战城南，整师旅。\n舟如龙，人如虎。\n元戎六月出波罗，一洗妖氛净疆宇。\n㘵涌芦荻长，青海不扬波。\n昔闻水鬼哭，今闻儿女歌。\n儿女歌，声自好，谁赞鸿勋陈太老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"关山月","author":"霍与瑕","text":"明月上关山，流影落前湾。\n前湾风浪息，贾客串珠还。\n沽酒追欢赏，商歌夜未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长歌行","author":"霍与瑕","text":"仙城有佳园，园中桃与李。\n二月春风深，树树殷红紫。\n谁尸造物工，朝阳更时雨。\n秋来食其实，应知价不赀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临高台","author":"霍与瑕","text":"临高台，望隔洲，白蘋红树送新愁。\n惜远别，起离忧。\n勖灵修，加飧食，浔州之水不咫尺。\n男儿投笔自封侯，何况金章紫绶照兰舟，勖灵修。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"易水歌","author":"霍与瑕","text":"涉易水，北风凉。\n昔为战国今虞黄，簪缨万里总文章。\n总文章，边尘起。\n烈士悲秋风，壮心犹未已。\n谁知己，为君死。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"君马黄","author":"霍与瑕","text":"君马黄，我马玄。\n长安道，并垂鞭。\n行人司，丞相府。\n盛冠裳，罗樽俎。\n发清讴，扬妙舞。\n对酒当歌生几何，春华零落空庭柯，三十六年迅逝波。\n忆昔复忆昔，人今头已白。\n瘦马过门前，谁识旧时客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸡鸣歌","author":"霍与瑕","text":"鸡既鸣，风露零。\n起视夜，步中庭。\n十月鸡鸣才夜半，大星未起小星灿。\n我思之人在北方，欲寄音书无羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将进酒","author":"霍与瑕","text":"将进酒，夜未央。\n楼台初月上，林薄绪风凉。\n吹鸾箫，和凤管。\n倒犠樽，酌鹚碗。\n我为君歌，君莫辞满。\n去日苦多来日短。\n乐今宵，无思远。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"巫山高","author":"霍与瑕","text":"巫山高，高入云。\n搴裳涉水远辞君，南渡潇湘采芳芬。\n潇湘之水，东下洞庭，秋风夕起波浪生。\n凉露下太清，云雨梦难成。\n惜往日，泣涕零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄八景 其一 龙阁晴云","author":"霍与瑕","text":"沧溟蜃气结巍楼，九天日照成丹邱，文章五色烂瀛洲。\n烂瀛洲，郁龙阁。\n图现河，书出洛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄八景 其二 凤池朝日","author":"霍与瑕","text":"凤池冈面映东阳，梧桐结子叶边傍，凉风渐起青且黄。\n青且黄，盈金翠。\n有鸟来，鸣盛世。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄八景 其三 藤涌月露","author":"霍与瑕","text":"朦胧初月照藤涌，参差荔子横低空，连天水色露华浓。\n露华浓，歌婉转。\n寄相思，天苦远。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄八景 其四 桂圃风香","author":"霍与瑕","text":"短槎迢递溯银河，金风吹冷桂枝柯，广寒宫里问嫦娥。\n问嫦娥，秋几许。\n探花郎，来伴侣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄八景 其五 冈尾樵歌","author":"霍与瑕","text":"南山山上郁青松，南山山下游儿童，三三两两笑歌浓。\n笑歌浓，归路晚。\n牛下山，月出阪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄八景 其六 湾头钓艇","author":"霍与瑕","text":"一番垂钓六鳌愁，二番垂钓改商周，三番垂钓客星流。\n客星流，侵帝座。\n且归来，春江卧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄八景 其七 登洲涌潮","author":"霍与瑕","text":"潮平儿女唱歌来，潮落中流慢橹回，登洲两岸乱花开。\n乱花开，杂芳草。\n郎不来，春将老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄八景 其八 西淋返照","author":"霍与瑕","text":"江天漠漠白鸥飞，绿野漫漫堤树微，怀人独立晚忘归。\n晚忘归，发孤啸。\n望西淋，馀返照。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄 其一","author":"霍与瑕","text":"生儿百日丧所天，春风秋月恨绵绵，三年五载抱儿眠。\n抱儿眠，强嬉笑。\n欲引诀，怜儿少。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄 其二","author":"霍与瑕","text":"儿生七岁美容姿，趋跄步武逞威仪，良辰吉日尔从师。\n尔从师，予从父。\n生别离，勿相顾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄 其三","author":"霍与瑕","text":"孤灯微灭天气凉，更深夜静影徬皇，上床莫更唤阿娘。\n唤阿娘，知何处。\n悲复悲，谁怜汝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江南弄 其四","author":"霍与瑕","text":"天明早起风萧飕，八旬祖母为梳头，随群逐伴学中游。\n学中游，归来独。\n冷饭茶，聊充腹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"远别离 其一","author":"霍与瑕","text":"惜春复送春，送春兼送远。\n清尊珠海滨，含愁歌婉转。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"远别离 其二","author":"霍与瑕","text":"别公廿载前，见公廿载后。\n只今又别公，见公知何又。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"田家乐 其一","author":"霍与瑕","text":"采桑桑叶稀，养蚕蚕上箔。\n丝黄米复贱，处处田家乐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"田家乐 其二","author":"霍与瑕","text":"乡村无吠犬，里闾闻笑谑。\n月明行答歌，处处田家乐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12658,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"估客乐 其一","author":"霍与瑕","text":"估客自东来，三年游南海。\n南海静无波，知有姬公在。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12659,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"估客乐 其二","author":"霍与瑕","text":"东海恢天网，天老举其纲。\n吞舟时或漏，终然断其吭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12660,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙马歌","author":"霍与瑕","text":"龙马行空步，腾骧在天衢。\n天衢多雁阵，为寄广州书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12661,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望九疑","author":"霍与瑕","text":"行行上桂林，望望九疑山。\n翠华瞻气象，帝子在云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12662,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒重华","author":"霍与瑕","text":"矫矫焚馀草，共驩赖扫除。\n重华今在御，赓歌喜都俞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12663,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄远","author":"霍与瑕","text":"缄书寄远行，珍重慰瞻忆。\n寒夏愿添衣，晚岚须早食。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12664,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"论诗呈双鱼 其一","author":"霍与瑕","text":"俯仰千古馀，将诗与君评。\n浑浑太古音，雄深为世经。\n载赓自虞廷，五歌传夏声。\n商颂既清庙，幽微入无形。\n上泄天载秘，下宣文治精。\n小雅及大雅，渊渊皆难名。\n滔滔江汉流，倬倬云汉明。\n纪纲万国具，允矣信大成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12665,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"论诗呈双鱼 其二","author":"霍与瑕","text":"小雅多言政，大雅多言德。\n古人信知言，昭昭存简策。\n伤哉周德衰，变雅一何多。\n徒写君子忧，丧乱可奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"论诗呈双鱼 其三","author":"霍与瑕","text":"王风雅之亡，鄘卫风之变。\n变雅多隐忧，变风多哀怨。\n离乱亡国音，万世良足鉴。\n岂无君子人，幽怀空永叹。\n更有栖衡门，又如歌简简。\n轻世肆其志，高尚不自乱。\n惓惓尼山叟，凤衰游不倦。\n磬写当年心，滔滔竟不反。\n晚归正诗歌，百代垂明宪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"论诗呈双鱼 其四","author":"霍与瑕","text":"国风虽离乱，时闻平淡音。\n降及离骚作，哀思不可任。\n驰骋不可御，纵横更莫伦。\n遂为词赋祖，精华世所歆。\n嗟哉铁石肠，徒寄此璆琳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"论诗呈双鱼 其五","author":"霍与瑕","text":"秦居列国中，其声独浑雄。\n霸图虽烈烈，夏商亦遗风。\n矧据关河胜，地厚气亦钟。\n所以春秋末，居然并七雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"论诗呈双鱼 其六","author":"霍与瑕","text":"汉初尚淳质，文雅殊未釐。\n风气颇类秦，诗歌犹甚稀。\n建武招文学，词章郁以摛。\n泛滥多雄赋，然而古意衰。\n一十有九章，实擅汉代辉。\n下及魏晋间，曹谢揽其奇。\n作者日以多，风骨日以卑。\n江左传六朝，纤巧益以滋。\n诗章与世运，升降展相依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"论诗呈双鱼 其七","author":"霍与瑕","text":"唐亦六朝变，声口皆馀波。\n济之以浑淳，沛然遂成河。\n中叶李杜兴，巍然萃其英。\n古风赖一回，雄才砥沧溟。\n晚唐又渐靡，清声徒泠泠。\n作者岂不勤，气习良难胜。\n五代更无闻，宋朝且未评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"论诗呈双鱼 其八","author":"霍与瑕","text":"渺渺盛世音，终古不复起。\n气格日以微，波流日以靡。\n欲障此颓澜，吾侪当自励。\n驰骤应千古，上下宜百世。\n囊括尽诸家，包含兼六义。\n志立事竟成，谁云古人逝。\n与君更切磋，一篑毋自止。\n予亦悠悠者，鞭策赖君子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"论诗呈双鱼 其九","author":"霍与瑕","text":"在天有星辰，河汉为其章。\n在地有山川，草木贲其芳。\n诗乃人之华，蕴藉耀其光。\n内外本一致，德言互显藏。\n实德展无量，矢言自辉煌。\n古者以道志，末世但轻飏。\n与君更勉力，内心不可忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉酬勉纯 其一","author":"霍与瑕","text":"南国有佳人，遗我尺素书。\n书中成锦字，文章映碧虚。\n情义既洵美，德音复婉都。\n回首樵云外，感此益凄且。\n寥寥鹡鸰诗，君今歌是图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉酬勉纯 其二","author":"霍与瑕","text":"客子登征途，云山淡且好。\n漫漫夜向长，冉冉秋将老。\n亲戚生别离，童仆自相保。\n极目天之涯，零零尽衰草。\n回顾望旧乡，忧思那能道。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]