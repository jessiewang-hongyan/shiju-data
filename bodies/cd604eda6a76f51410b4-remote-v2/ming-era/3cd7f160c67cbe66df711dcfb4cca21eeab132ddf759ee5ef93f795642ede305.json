[{"title":"冬日刘平子周献之过访留宿秋兰阁分得壶字","author":"伍瑞隆","text":"八年不相见，一棹此招呼。\n山水情俱远，琴尊兴不孤。\n论诗投玉案，把酒对冰壶。\n信宿莫辞数，心期不可无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠关生","author":"伍瑞隆","text":"怜君美少年，况此惬清缘。\n逸思云山外，闲情花月前。\n含辞心映雪，味道舌生莲。\n赠我幽兰佩，酬之芳蕙篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱仪伯来自武林误寻余于铁城不值时予亦以病不得访仪伯赋此为别兼致声乃弟子悬陆与偕徐楚白三子 其一","author":"伍瑞隆","text":"高谊有吾子，穷交良在斯。\n不辞千里棹，来赴十年期。\n杜若山中佩，梅花陇畔枝。\n可堪相访处，兴尽子猷时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱仪伯来自武林误寻余于铁城不值时予亦以病不得访仪伯赋此为别兼致声乃弟子悬陆与偕徐楚白三子 其二","author":"伍瑞隆","text":"岐路满天下，君行思转多。\n到来失相见，别去感如何。\n日月淹愁病，云山阻笑歌。\n此时忆良友，真自愧蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱仪伯来自武林误寻余于铁城不值时予亦以病不得访仪伯赋此为别兼致声乃弟子悬陆与偕徐楚白三子 其三","author":"伍瑞隆","text":"海内文章士，登坛有二朱。\n得徐洵连璧，友陆况冰壶。\n我亦有心者，同声幸不孤。\n暂随明月夜，将梦到西湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登拱北楼","author":"伍瑞隆","text":"地灵神物护，天阔海云长。\n五岭衣冠气，三城日月光。\n凭高临渺渺，迥立尽苍苍。\n极目关山北，瞻云意不忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32999,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白云寺与诸子对菊怀何襄武伯友","author":"伍瑞隆","text":"幽人澹如菊，对菊爱幽人。\n密蕊经霜净，繁香入酒新。\n栽依无树域，开并散花晨。\n采采山中暮，何由寄所亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33000,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同文徵瑞昆有开诸子送龙友入京赋得闻雁","author":"伍瑞隆","text":"海国秋多雁，天空夜每闻。\n可怜千片影，凄断万重云。\n月冷声多苦，风高响易分。\n此时送征客，一听一氤氲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33001,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日同何襄武李伯襄何龙友诸子探梅驼山归集紫芝园分赋得京字","author":"伍瑞隆","text":"看花虽醉且挥觥，一别园林岁几更。\n交谊死生元并许，故人何李旧齐名。\n风前紫气看雄剑，袖里名篇出帝京。\n我自爱君兼爱夜，可能烧烛坐天明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送伯襄上春官","author":"伍瑞隆","text":"十年湖海傲元龙，匣剑新开赤电锋。\n万里征轺淩晓霰，一尊江雨落芙蓉。\n挥毫色动西山雪，献赋风清紫禁钟。\n闻道新恩常永夜，莫辞宣室待从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33003,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得水精帘赠友人新昏","author":"伍瑞隆","text":"冰文隐隐碧光浮，绣户璚窗映更幽。\n晻暧半遮金缕带，玲珑分照玉搔头。\n迎风响散招仙阁，罩月寒生待凤楼。\n颇怪新欢晓妆处，不堪临镜捲娇羞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝海珠寺煎茶因忆故山","author":"伍瑞隆","text":"青峰两岸郁含滋，水寺疏钟晚饭时。\n僧供石泉留客语，人逢佳节乱乡思。\n风牵水荇沉波碧，雨湿江云趁鹭迟。\n举目同怀半贫病，故山犹自负归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居 其一","author":"伍瑞隆","text":"不到驼山向一年，归来犹及暮春前。\n萍开碧沼见藤影，花落闲窗闻杜鹃。\n在处未妨多酒债，看春应辨买花钱。\n兴来幽意道不得，落日长风吹紫烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居 其二","author":"伍瑞隆","text":"溪上归来一钓艭，杏梁新燕媚双双。\n暖云欲雨犹藏谷，坠叶无风不到窗。\n傲性亦知人共弃，尘心多付酒中降。\n一声横笛竹深处，夜半月来潮满江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居 其三","author":"伍瑞隆","text":"闲从高阁望崔嵬，檐日阴阴喧晚雷。\n橘近野亭猿摘去，花开别院鸟衔来。\n寻僧夜月遥听梵，招客乘舟不用催。\n寂寂山斋无一事，乱云疏竹伴登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得伯襄报 其一","author":"伍瑞隆","text":"捷书遥自帝城来，问别初停掌上杯。\n闻道十年莲社客，居然七字柏梁才。\n众中词赋谁争长，别后风尘黯不开。\n言念旧时风雨过，岭云燕树首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得伯襄报 其二","author":"伍瑞隆","text":"词场騕袅竞空群，四子登坛始是君。\n高唱十年馀白雪，大名一日起青云。\n会应头腹龙堪定，可是雌雄剑自分。\n摇落故人犹善饭，未忧重拟北山文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33010,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋前二日同瑞虞天培有开诸子宿龙友凉木荫分韵席上赋四首选一","author":"伍瑞隆","text":"石榻风清晓露迟，朝来乘兴又东篱。\n卢仝已拚书千卷，张翰何如酒一卮。\n疏雨屡移林下席，秋风欲上槛前枝。\n相逢莫漫倾尊起，一到红尘未可期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33011,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄黄六如","author":"伍瑞隆","text":"几度寻君醉落霞，至今风雨尚天涯。\n可应彭泽先生酒，不到东陵处士家。\n留客晚凉枝上月，聊人幽思槛前花。\n吾将拚尽山阴兴，为尔登临日每斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33012,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同诸子登醉花台望圭峰席上赋","author":"伍瑞隆","text":"醉花台上醉花来，徙几名山入望开。\n我按晚云金世界，欲寻丹灶玉楼台。\n谁哉地主能歌桂，久矣群峰待举杯。\n不尽飞扬看落日，几时乘兴御风回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33013,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠从弟桢卿新昏","author":"伍瑞隆","text":"绮阁银钩净曙晖，仙郎初御紫霞衣。\n裁成楚峡行云赋，飞入秦楼跨凤归。\n醉里月明花共倚，风前妆罢玉相辉。\n从知咏雪多佳句，只恐清词和亦稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33014,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日同有开龙友诸子饮瑞虞点石斋席上赋四首 其一 得山字","author":"伍瑞隆","text":"溪流晴漾水花翻，客有乘舟来叩关。\n出户石泉当倚槛，闭门朝爽到他山。\n风雷乍拔林烟起，蒲艾初传野兴闲。\n荐罢灵均转相笑，座中谁忍独醒还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33015,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日同有开龙友诸子饮瑞虞点石斋席上赋四首 其二 得摇字","author":"伍瑞隆","text":"为君晴泛木兰桡，几费溪头坐待潮。\n自信幽期应易阻，肯令佳节不相招。\n歌翻楚客黄金掷，麈对江莲白羽摇。\n醉挟飞龙欲归去，乱云疏竹故萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33016,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日同有开龙友诸子饮瑞虞点石斋席上赋四首 其三 得森字","author":"伍瑞隆","text":"乘兴开樽竹树林，亭前风雨昼萧森。\n幽怀转向三闾尽，沥胆犹堪二子深。\n节序怀中青玉案，岁明山上白云心。\n可知一片英雄泪，不读离骚亦满襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33017,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日同有开龙友诸子饮瑞虞点石斋席上赋四首 其四 得花字","author":"伍瑞隆","text":"五丝如锦蘸明霞，吊屈何须水上槎。\n就此一尊歌沅芷，亦当临海赋长沙。\n阄题乍送含情发，丽句争裁点笔斜。\n越女似怜新调好，隔江求谱采莲花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端阳后二日何瑞虞龙周勚何龙友诸子过集紫芝园同家霞举幼度桢卿有开文度分赋席上赋四首 其一 得云字","author":"伍瑞隆","text":"如此新醪且共醺，幽期三日两逢君。\n谈天尚挟怀中雨，作赋先裁袖里云。\n入座竹声寒滴沥，近人山色昼氤氲。\n怀湘更好扁舟去，溪上云涛涨不分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端阳后二日何瑞虞龙周勚何龙友诸子过集紫芝园同家霞举幼度桢卿有开文度分赋席上赋四首 其二 得园字","author":"伍瑞隆","text":"暂可维舟溪上园，淹留风雨一开尊。\n岁时未尽湘灵恨，酬唱犹怜郢调存。\n问字岂堪玄草宅，论诗还就浣花村。\n相看一片青山色，不负空梁落月魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端阳后二日何瑞虞龙周勚何龙友诸子过集紫芝园同家霞举幼度桢卿有开文度分赋席上赋四首 其三 得醒字","author":"伍瑞隆","text":"风前谁送蕙兰馨，散帙松窗昼不扃。\n尘里共怀荆玉白，句中如见楚山青。\n才因倚马人争避，酒为催诗客易醒。\n真信古来名士业，只教醇酒与骚经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端阳后二日何瑞虞龙周勚何龙友诸子过集紫芝园同家霞举幼度桢卿有开文度分赋席上赋四首 其四 得杯字","author":"伍瑞隆","text":"相将腕下走奔雷，刻烛当筵亦壮哉。\n万壑烟云生彩笔，二仪风雨见鸿裁。\n经营未了先挥墨，结撰初停即引杯。\n敏捷众中谁第一，并驱还有不凡材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送龙友上春官","author":"伍瑞隆","text":"临觞不惜醉相看，此别应须强自宽。\n鸿雁泣残怜客计，白云看处亦亲欢。\n千金市骏人非偶，三献连城玉不难。\n莫漫断肠回首处，春风吾欲待弹冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊长洲山下望月","author":"伍瑞隆","text":"芙蓉醉尽暮江平，有客停船待晓行。\n山洗夜风秋转静，水明天镜月初生。\n情知乌鹊元三匝，魄在冰壶见独清。\n此去采芳携手处，相看明日又孤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟夜阻风与诸客空酌","author":"伍瑞隆","text":"水精盐白笋姜红，杯酒乘舟夜阻风。\n席比冰壶犹未净，盘邀明月且成空。\n曲神自领清虚趣，酒圣元堪澹泊中。\n服食只今渣滓尽，肯令殽核枉相从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陆贞吾明府入觐","author":"伍瑞隆","text":"望望孤帆开紫烟，士龙飞传入朝天。\n才高洛下名偏盛，官近罗浮令亦仙。\n宣室夜谈知转切，御屏题姓许谁先。\n小臣漫有王褒颂，聊欲因君献日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜陈时献招饮采笔斋赋","author":"伍瑞隆","text":"轻槐落尽悄秋城，杯酒空堂此夜情。\n醉里疏钟销缱绻，歌中凉雨助凄清。\n十年声价交初惬，一夕招携意独倾。\n此后相思君不见，月寒秋水照心明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜有怀","author":"伍瑞隆","text":"幽期寂寂阻相怜，月上知君尚未眠。\n一自断桥惊晓后，几回清梦到花前。\n红楼夜静人何处，翠被寒生思几牵。\n自信高唐容作赋，为云应念楚襄年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日同何似公李伯襄仁伯定国安国舍弟有开探梅驼山分赋 其一 得秋字","author":"伍瑞隆","text":"相将选胜惬淹留，不负梅花满岭头。\n别后几悬沧海梦，兴来俱到剡溪舟。\n尊开绿酒矜初熟，客有青云是旧游。\n就此邀欢无不可，未须明月醉杨州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日同何似公李伯襄仁伯定国安国舍弟有开探梅驼山分赋 其二 得风字","author":"伍瑞隆","text":"醉色沉沉返照红，移尊犹自泥花丛。\n玉山倒处看相映，雪调飞来见转工。\n驲使每怜花发后，美人原在月明中。\n不妨太史偏归晚，自有梅诗供采风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜望落霞峰有怀何似公戴公纶二子","author":"伍瑞隆","text":"咫尺群山不可登，箫条清梦隔垂藤。\n岩花雨洗香沾草，雪树风来冻逼灯。\n肝胆醉中时自见，文章穷后转堪凭。\n故人未用悲摇落，自许清心信夺冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周文郁以除夕别以初春二日来访喜赋","author":"伍瑞隆","text":"雪中何处剡溪船，柏酒惊看得共传。\n饮具纵疏应十日，别情虽暂亦经年。\n心调绛蜡娇春雪，手辟名山待列仙。\n高兴似君难得再，愿拚幽事奉清缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋前一夕同幼度有开诸弟集得秋字","author":"伍瑞隆","text":"梧桐一叶破新愁，明日明朝又早秋。\n抱病岁时频废酒，闭门风雨亦销忧。\n秋当隐映山多思，人领清虚韵独幽。\n风竹露荷同一醉，夜深凉籁下西楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕同诸子集伯襄太史建霞楼得秋字","author":"伍瑞隆","text":"明河飞练敞高楼，七夕开尊望女牛。\n坐久暮天云似水，醉深长笑夜宜秋。\n蛛丝漫可穿针待，缑岭真疑跨鹤游。\n向晓不堪凉雨发，万山灵籁起沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李伯玉过访伯玉幼名世玙四岁能大书以神童显名诸缙绅间","author":"伍瑞隆","text":"美名一自赋高轩，驹齿龙文客共尊。\n转眼十年成血汗，论心今日到文园。\n禅峰映处天花落，笔兴飞来凤藻翻。\n我供晚厨香积馔，与君乘月醉秋原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄与东之任南宁司理","author":"伍瑞隆","text":"即看真气又临关，六传风云不可攀。\n积瘴望中铜柱日，乱峰明处朗宁山。\n相才岂颖能淹骥，蛇笏推宁自一班。\n迟过昆崙重怀古，知君坡上望仙还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登金钗山访余五娘墓","author":"伍瑞隆","text":"香魂招罢掩春闺，翠袖金钗委作泥。\n过客自矜兰麝土，夜台谁伴凤凰栖。\n冰心似月怜多缺，藻思如花想旧题。\n延伫不堪怀古处，冷风斜日墓门西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"爽籁亭为右明赋","author":"伍瑞隆","text":"群嚣息尽地逾偏，爽籁泠泠秋可怜。\n辋口有湖歌自诧，苏门拥膝啸为缘。\n清音信许兼山水，幽响谁应别地天。\n最是北窗天际想，到来吾意亦翛然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答寄李襄国显国二子 其一","author":"伍瑞隆","text":"一尊风雨散词林，几度怀君动楚吟。\n锦被漫劳青翰舫，新题先到紫鸾音。\n情深并抱英雄泪，赋就俱悬绝代心。\n咄咄斯人真独往，千秋吾党见双金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答寄李襄国显国二子 其二","author":"伍瑞隆","text":"浣花溪上浣花村，小筑萧然独避喧。\n敢谓爱参能具状，却怜醉白喜过门。\n因看彩笔词争长，想见名山道并尊。\n梅蕊满条春酒熟，几时乘兴到文园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中观梅花答何文徵见寄","author":"伍瑞隆","text":"鸡鸣日暮雨萧萧，只尺怀人万里遥。\n歌就南山芳草色，梦残东阁落花朝。\n怀中锦字劳相问，溪上名园早见招。\n晴觅蹇驴君共往，可知诗思满渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日李伯襄何龙友招同何似公李仁伯定国安国家小开诸子探梅有赋","author":"伍瑞隆","text":"寒雨冰魂不自持，乍晴犹及赏花期。\n香生自觉佳人近，清绝唯应高士知。\n幽兴水曹能纵酒，仙才供奉早成诗。\n多情晚更怜飘落，画里传将雪几枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日雨","author":"伍瑞隆","text":"积暗春寒灯事阑，更堪人日雨漫漫。\n已拚今夕愁相向，只恐明朝晴亦难。\n南陌绮罗空对酒，东邻书札问加餐。\n新花细草吾怜汝，独有兰膏不耐残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳日同戴公纶印上人诸子泛舟得飞字","author":"伍瑞隆","text":"一棹风前弄晚晖，乱流斜日净含辉。\n溪云势挟孤帆起，花雨晴分两岸飞。\n漫绕芳洲寻杜若，欲携新月上春衣。\n千秋禊事今人感，不醉东风怅不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠医者李生生有妾陈姬善歌","author":"伍瑞隆","text":"笼中绛雪调红粉，袖里青囊映翠蛾。\n采药岂应仙犬吠，怜才今见雪儿歌。\n但防窃去能奔月，不待章成更渡河。\n况是高唐容作赋，相逢不饮奈狂何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书闷因寄襄武伯襄二子","author":"伍瑞隆","text":"高秋不尽客愁宽，咫尺山楼一晤难。\n我已伤心惊往事，君还良夜忆清欢。\n歌来白玉魂堪断，哭罢青山泪未残。\n一片灞陵驴上月，几时携手雪中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旅夜寄赠蒙胤良","author":"伍瑞隆","text":"少年绿鬓任清芬，文藻风流更不群。\n醉后兰心成缱绻，分来香气太氤氲。\n车留潘令怀中果，身是高唐梦里云。\n玉树风前吾欲倚，转教无地不思君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陈襄仲","author":"伍瑞隆","text":"相逢杯酒少年游，宝剑千金不易酬。\n风约柳丝寒不定，雨笼花气小生秋。\n诗成错落千重锦，人在玲珑十二楼。\n未论邀欢如许事，看君吐纳已风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绿萝馆为詹伯润赋","author":"伍瑞隆","text":"初服时同薜荔裁，万重青翠小堂开。\n意应彭泽先生解，客许西昌逸士来。\n解带晚风摇下榻，窥人片月到衔杯。\n随他日共蓬蒿长，聊好数从仲蔚回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李太史建霞楼前兰开五丫秋日同有开过赏因宿楼中","author":"伍瑞隆","text":"潮平溪畔雨初收，一棹看花西海头。\n天产异兰元五颖，客怜新爽漫兹楼。\n晴晖影泛枝枝玉，晚径凉生叶叶秋。\n结佩与君歌楚曲，何人不为采芳留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集药洲芙蓉花下怀何七李四","author":"伍瑞隆","text":"芙蓉万树溪水东，十里冉冉秋花丛。\n晓日映分玛瑙紫，晚风吹作珊瑚红。\n乍来感此有馀忆，欲采寄之无便鸿。\n一棹蹉跎不相过，祇愁飘落随飞蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瑞莲诗","author":"伍瑞隆","text":"高斋谁送芰荷芳，异色灵葩迥不常。\n空翠幻含冰壑玉，綵霞横抹华峰霜。\n仙妆自识红三变，金沼元堪赤共光。\n法藏知君兼悟后，未徒幽事在衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠李君新昏","author":"伍瑞隆","text":"紫陌春云绚小桃，乘龙新按八琅璈。\n人从宝镜看明玉，客自金门擅彩毫。\n莲炬夜寒花欲动，凤楼人醉月初高。\n不知此际仙郎梦，犹记当年宫锦袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿叶台山太师二首 其一 赋得三山列翠","author":"伍瑞隆","text":"巑岏青黛拥仙都，万壑千峰入画图。\n地自名山开九籥，树从栖鹤识三珠。\n白云岭上元堪悦，灵气朝来尽可呼。\n我欲山中寻宰相，相携尽日醉蓬壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]