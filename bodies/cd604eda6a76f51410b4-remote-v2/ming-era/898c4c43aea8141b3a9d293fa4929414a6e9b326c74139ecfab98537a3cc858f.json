[{"title":"归宗山籁一百四首 其九十","author":"释函是","text":"坐落西轩月，行看东岭松。\n易教云作水，难信石成钟。\n物理自衰变，人情时夏冬。\n是谁能免此，同上最高峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其九十一","author":"释函是","text":"对人时累足，闭目不观空。\n偶起探晴岳，携筇过寺东。\n古松摇涧底，怪石出云中。\n多少住山事，茫茫逐异同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其九十二","author":"释函是","text":"寒月窥帘悄，晴云覆岫阴。\n一般閒景趣，识得道人心。\n视听当犹昔，溪山岂自今。\n愿同泉石老，猿鹤许相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其九十三","author":"释函是","text":"一榻蒙头坐，千峰夕照移。\n重云低匝地，微月上高枝。\n气暖龙蛇蛰，山寒鸟雀饥。\n不知春信至，即在夜长时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其九十四","author":"释函是","text":"积雪通昏昼，丛光掩岳川。\n闭门寒色敛，拥褐夜灯然。\n三事白头衲，一床黄独烟。\n青山非世僻，容得懒成颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其九十五","author":"释函是","text":"万古一弹指，云山梦里看。\n目前销不易，荣落始知难。\n大雪危峰出，残冰饥鸟欢。\n拥垆对良夜，独自耐深寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其九十六","author":"释函是","text":"百情安一遇，得解不成文。\n雪满云山合，澌流河汉分。\n掩窗寒隔纸，煮茗叶烧云。\n俯仰观尘劫，冥心知所云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其九十七","author":"释函是","text":"人羡庞公好，全家隐鹿门。\n但知山泽美，宁畏虎狼喧。\n独树难藏影，旋岚不著痕。\n此心无去住，何事更招魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其九十八","author":"释函是","text":"春草露先白，霜根雪后青。\n拥垆当秉烛，饵药失颓龄。\n引兴寻梅澹，凭高共鹤泠。\n不辞摇落尽，寥寂自寒庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其九十九","author":"释函是","text":"閒中数往事，往往叹前因。\n不信先贤语，几成衰世人。\n身名存石室，岩壑老风尘。\n借问鸾溪水，能回白草春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其一○○","author":"释函是","text":"叹惜今时事，难追往哲风。\n道随炎冷异，心与利名同。\n拙朴甘吾塞，文章让世通。\n陆沉终不易，何苦问污隆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其一○一","author":"释函是","text":"何人能独立，云静与山深。\n万木无行径，千峰稳住心。\n拚教风逐虎，输去月同琴。\n想望人天际，迢迢流水音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其一○二","author":"释函是","text":"山泽匪耽寂，云林自作师。\n好随明月去，休被晚风吹。\n乱石填阶砌，长松荫后篱。\n一从深入后，垆火不曾离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其一○三","author":"释函是","text":"绳床方敛足，不觉到馀曛。\n碧涧沉清影，青霄无片云。\n夜猿愁月照，山鬼畏僧闻。\n自笑为人浅，都惭与物分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其一○四","author":"释函是","text":"晚年宜好静，日日数生涯。\n候种畏寒早，为园及暖乖。\n临风多远思，明月易生怀。\n不作馀龄计，忙来亦自佳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归隐罗浮诗报老父","author":"释函是","text":"潦倒云岩日惘然，听泉时枕石头眠。\n且非有意逃人世，那得閒情结俗缘。\n盖代勋名都是梦，大家生死倩谁肩。\n年来老大心须歇，百劫光辉在目前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"还小持船示诸子","author":"释函是","text":"眼前一望黍离离，燕子忘机归亦迟。\n当忆百年缘散处，莫随顷刻念生时。\n黄粱未熟谁先觉，荷叶初开我已悲。\n幸自临池多暇日，无生有诀慎相期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答吉州周天木","author":"释函是","text":"今人行业古人心，落落孤标物外寻。\n白鹭洲前春有脚，五羊城外海无音。\n雄才未遂甘丘壑，清梦犹能到石林。\n世运兴衰看不尽，赤松桥北未沉沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁弼臣北上","author":"释函是","text":"天上只今已如此，丈夫出处倍相关。\n时危不可徒干禄，亲老何妨暂住山。\n绿树清泉身足隐，眠云坐石道能閒。\n秘书未必赤松意，笑杀留侯空自还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郭无伤邝无畏见过","author":"释函是","text":"金粟如来是后身，澄潭孤月净无尘。\n看同镜里人何似，话到声销道易亲。\n铁树开残寒腊燄，雪花藏得旧年春。\n水云上下深深意，鹤影松虬好结邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵写怀十首 其一","author":"释函是","text":"乾坤内外绝为邻，梦里何劳问主宾。\n治乱兴亡千古事，死生老病百年身。\n白云欲锁寒山色，梅萼谁怜冻腊春。\n石上因缘知几几，莫教浮世笑閒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵写怀十首 其二","author":"释函是","text":"破衲蒙头一味真，随时粥饭莫嫌贫。\n伊耆阪涿今何在，沧海桑田岂有垠。\n已过身名他日泪，未来事业旧时人。\n凭谁深信三生论，共坐樵峰话往因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵写怀十首 其三","author":"释函是","text":"一日閒来一日足，百年愁去百年忙。\n须将后事翻前事，莫误今狂学古狂。\n松覆石床人外寂，门开竹径意中凉。\n诸缘易尽心难尽，好悟无生万法忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵写怀十首 其四","author":"释函是","text":"溪声山色净无尘，独坐云峰意自新。\n无智无能空笑我，多才多艺总输人。\n百年生计须臾弃，历劫操存旦夕因。\n一领衲衣閒不彻，箪瓢陋巷几曾贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵写怀十首 其五","author":"释函是","text":"世外难忘物我情，败非成是不须争。\n时来用尽生前福，事去徒矜死后名。\n一念乍兴旷劫累，万缘休歇此身轻。\n林泉大有甘心处，寒夜孤筇傍月行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵写怀十首 其六","author":"释函是","text":"身前身后事谁明，才忆因缘暗里惊。\n猛士难催金锁骨，精兵不破涅槃城。\n平原兔尽归将晚，黄石松疏荫未成。\n一自世途机滚滚，青山历乱少人行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵写怀十首 其七","author":"释函是","text":"十年丘壑梦魂轻，渐喜人忘旧姓名。\n影现情缘迷处尽，融通起灭静中明。\n鸟啼花落空岩意，月淡云寒流水声。\n老我儒冠劳半世，柴门犹得寄馀生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵写怀十首 其八","author":"释函是","text":"觅得茅庵奉老亲，玉泉清冽映松筠。\n试茶暂过石桥北，步月遥看菊径新。\n睦叟无鞋应愧母，隐峰有妹足閒身。\n乱离法乐饶天乐，好共人间识旧因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵写怀十首 其九","author":"释函是","text":"身隐须教心共隐，遣情争似泯情佳。\n桔槔转处聪明巧，机轴停来天地差。\n逐浪随波人易偶，离非绝句道犹乖。\n可怜林下逃名者，名重如山时未谐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵写怀十首 其十","author":"释函是","text":"青山满目匪人间，楖栗横挑自往还。\n过客但闻时事慨，论心每觉道情悭。\n目前活句堪谁举，天外摇头笑我顽。\n近日有人知此意，明年三月掩柴关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊子春掩关雷峰诸道俗见讯示此","author":"释函是","text":"四十年来弹指间，荷担大道不知顽。\n无缘常恐法轮坠，多病偏怜梦幻悭。\n业识未乾迷悟假，垢心忘尽圣凡閒。\n于今剩有蒙头衲，敢效高僧闭死关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恭怀空老人","author":"释函是","text":"香花曾结胜缘欢，十载追随行路难。\n忆别忽惊风俗异，感寒时念衲衣单。\n月明千里心相照，云起双峰影独看。\n已是道人情似水，一回潮满一回澜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦馀轩","author":"释函是","text":"浪迹阎浮四十春，依稀重记劫前身。\n白云万里空双眼，绿影横空足几人。\n近竹淡烟他日梦，隔桥明月旧时津。\n江山今古长如此，高卧峰头我欲贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋","author":"释函是","text":"月落风高秋渐横，此时谁复论浮名。\n巍巍独坐虚生白，寂寂幽林露有声。\n久住深山无此意，偶观尘世乐閒情。\n竹林薄梦先桐叶，不到寒更衣欲轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀祖心弟","author":"释函是","text":"故园泉石亦迟迟，万里云山此一时。\n常对夕阳愁去雁，每因风雨梦连枝。\n望空天地月能语，思共林梢花不知。\n闻道江南多故老，笠瓢相访未应疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀湛六","author":"释函是","text":"四十扶筇筋力微，远檐平望独依违。\n月明万里霜天直，云淡疏帘秋水肥。\n远树苍茫辜客梦，乱流明灭有人归。\n光辉已自成今古，赚我寒更露满衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊子九日","author":"释函是","text":"去年此日乱离中，霜叶寒花今又逢。\n雁羽不堪穷漠北，戍歌犹是大江东。\n烟销衰草横塘静，日照疏林秋浦红。\n潦倒莫辞朝落帽，夜猿声急白蘋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日洪少宰西岩袁都宪特丘放生小持船赋此却寄","author":"释函是","text":"闻道重阳白社开，德云不在妙高台。\n尽教鱼跃鸢飞去，识得长天秋水来。\n贝叶肯和霜叶脱，昙花应傍菊花栽。\n金钱不买陶潜醉，别有醍醐露一杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日忆梁未央用台设韵","author":"释函是","text":"百年踪迹客情悭，占得雷峰一日山。\n篱菊饮残陶令酒，茱萸看尽杜卿颜。\n死生多故闻秋雁，老大无心卧竹关。\n为语登临但乘兴，长江滚滚几时还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"复风幡堂旧趾","author":"释函是","text":"梦断风幡不可寻，虚堂犹见古人心。\n一池春水临高阁，十亩荒烟想故林。\n人事暗销芳草尽，道情偏共乱云深。\n月明此地知何限，薄影横窗曾几吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答商丘伯侯若孩","author":"释函是","text":"披衣夜夜睹明星，古寺寒塘户半扃。\n笑我抛閒居市井，多君相见望州亭。\n千家灯火销兵甲，万里烟波注海溟。\n野老新承堂搆旧，好添封事进坛经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日书怀","author":"释函是","text":"云里无家何处归，平生踪迹尚依依。\n休心阅世机常钝，拙算投林愿亦违。\n入梦青山一榻稳，逢人丹荔半餐肥。\n乱离不作终朝计，潦倒浓阴暂解衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋郡守丞倅诸公过译经台","author":"释函是","text":"浩公载自鹿门至，谂老床头接赵王。\n不是野人情简略，都缘护法意深长。\n虎溪苔印秋容淡，玉带光流山色凉。\n珍重诸贤然诺处，译经台畔木樨香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日喜袁特丘刘同庵过访","author":"释函是","text":"门无分水绕长松，亦枉高轩林下逢。\n竹院风高先见雁，经台日午不闻钟。\n无心于世秋偏冷，有意寻僧梦独浓。\n相对秖应閒着眼，百年踪迹问云峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与崔石师泛舟","author":"释函是","text":"深闭柴扉独种园，何人招我破云痕。\n竹摇青影落河渚，日蘸寒光出海门。\n秋水连天横小艇，晚烟笼树失孤村。\n归来一路渔歌起，芦荻洲前月色温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆老亲","author":"释函是","text":"寒涕垂垂一比丘，依林傍岸独誇犹。\n甲兵老我半生事，饥渴消人百岁忧。\n绿竹沿溪已无夏，青山入座望临秋。\n海天浪拍门前月，远映高堂清欲浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答刘客生中丞用来韵","author":"释函是","text":"海天秋色共茫茫，雁影长空入草堂。\n有句不堪酬长老，无心曾否问空王。\n裴公已结香花债，诸子谁教秘密藏。\n选佛未应迟破衲，幞头先愿为人忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"葵扇二首 其一","author":"释函是","text":"谁将碧眼入芳丛，裁就云团欲荡空。\n岂与世间忙腊月，且随云麓度秋风。\n逍遥蓬户宜高士，摇落朱门傲贵公。\n手里仙人君见否，不曾遮面透罗红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"葵扇二首 其二","author":"释函是","text":"严寒始见世人容，寥落风尘独有侬。\n逸士正宜青竹坞，老僧携上白云峰。\n轻裾泛夜如飘素，薄暮投凉拟坐松。\n似我何须畏炎热，和衣清昼梦魂浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜述怀","author":"释函是","text":"一龛灯火月微明，似听孤猿坐五更。\n毳衲岂无芳草意，蒲团犹有倚寒情。\n十年辜负西山梦，今日空惭渔父名。\n假我百千疏散计，乱云叠嶂老馀生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄庞若云用梁同庵韵","author":"释函是","text":"窗间犹见数峰青，已报秋归霜满庭。\n添我道情空落落，赚谁人事独惺惺。\n红炉点亦欺残腊，万派声须到巨溟。\n倚石惯知寒瀑味，乘风无限意泠泠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答梁同庵叠前韵","author":"释函是","text":"挥空长剑倚天青，万里无云月在庭。\n双眼阅穷终古意，百年聊复共人惺。\n梦甜林麓空群岳，坐拥溪流失四溟。\n谁道珠江江上水，亦随残腊冻泠泠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"如是居忆椒园用憨山韵","author":"释函是","text":"川原历乱欲谁归，独有山人到竹扉。\n恍忽旧时梅影冷，似曾寒坐月华微。\n百年人事空潭影，一夕云林孤雁飞。\n特地不堪重话处，倚栏顿尔发清机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊王勃用达此韵","author":"释函是","text":"高阁凌霄尚壮哉，何人风雨渡江来。\n影沈湖水秋烟冷，韵遏匡云碧嶂开。\n多艺如君应薄命，閒情似我亦怜才。\n遥知万古长天色，一度登临恨一回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬汪明府用来韵","author":"释函是","text":"一从谷口白云横，世上谁当问隐名。\n绿水绕门依古渡，青松夹岸喜秋声。\n绳床久向空中坐，玉带难忘方外情。\n此语莫教消息漏，溪桥深锁夜乌轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晏和何朗水韵二首 其一","author":"释函是","text":"江门春色自何来，冷燄寒香暗里催。\n物化共看谁着眼，旅怀独酌未成杯。\n劳劳人外虎溪月，落落更残牛粪煤。\n野衲不知时序易，数株松树一瓶梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晏和何朗水韵二首 其二","author":"释函是","text":"扰扰劳生又到春，钟山投老倦蹄轮。\n乾坤有恨销穷腊，江汉无情问隙尘。\n黑白异同今日梦，枯荣宠辱百年身。\n匡庐且纵陶潜酒，嬴得酡颜倚雪筠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵碧玉洞与诸子卜筑","author":"释函是","text":"谁信匡庐千尺练，曾移一半到西樵。\n多年梦断黄岩路，此日寒生碧玉条。\n远眺宝峰云影乱，近开灵鹫雨花飘。\n可怜十八多佳士，筑得沿溪度石桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚寅二月雷峰即事","author":"释函是","text":"野寺疏钟接晚笳，蓟门残雪岭南花。\n十年征战江云断，二月风烟山日斜。\n古洞暮猿凄绝岸，荒原明月照谁家。\n越王台上西风急，夜夜哀魂到海涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答侯若孩太傅二首 其一","author":"释函是","text":"海阔天空鸟不藏，孤城日暮怯微霜。\n烽烟暗锁千门柳，羽檄分驰万里骧。\n戎马十年肠亦冷，竹床二月梦先凉。\n一般桃李春开尽，今古云山漫度量。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答侯若孩太傅二首 其二","author":"释函是","text":"野寺孤村泣断燐，半生魂梦若为真。\n可怜按剑看投夜，始信寒岩独有春。\n沐雨栉风多载恨，锄云耕月一身贫。\n劳生扰扰同今昔，更莫长歌恸鬼神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀王园长","author":"释函是","text":"四望重围鸟鹊愁，何人乘月独登楼。\n海门一夜寒沙起，香水三春野服游。\n古寺黄鹂啼欲暮，严城画角吹成秋。\n河山万里应同恨，雪竹霜筠此日投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雷峰夜雨","author":"释函是","text":"细雨轻寒梦不成，萧然一榻自生平。\n严城春夜近无梦，野寺云溪渐有声。\n林外不妨花落尽，篱边犹爱笋初生。\n江山此夕同何夕，惭愧幽人空复情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春晴望诃林诸衲","author":"释函是","text":"竹院春深亦乍晴，青山历历水盈盈。\n白云草木连沙漠，玄菟旌旗拥穗城。\n人在重围风雨暗，鸟啼高树雾烟轻。\n从来识得荣枯理，不谓离群感独生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]