[{"title":"流杯石","author":"王世贞","text":"云根障底暗泉流，莲花瓣中莲叶舟。\n直疑分出君山酒，夺得头杯不肯休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"飞练峡","author":"王世贞","text":"游女拿舟向峡边，惊呼白练界苍烟。\n生来未识天台瀑，湿着红衫不解怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"娱晖滩","author":"王世贞","text":"滩头垂杨好系船，杨枝戏水桃花颠。\n枕流漱石从他误，白眼卧看沧浪天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉树亭","author":"王世贞","text":"嘉树周遭一水亭，不妨呼酒共沈溟。\n当头赤日不敢下，拂面好风吹自醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留鱼涧","author":"王世贞","text":"夭桃落英长自留，游鱼一入便堪愁。\n梁宫亦有千迷道，闽岭闻歌九曲流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"敛霏亭","author":"王世贞","text":"倦鸟初栖犹未还，一生贪看夕阳山。\n纵令收尽人间色，几点峰尖紫翠间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43116,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小浮玉桥","author":"王世贞","text":"一拳残石水中央，醉艇纵横也不妨。\n唤作吴兴一浮玉，从教人笑夜郎王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43117,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"先月亭","author":"王世贞","text":"呼尊欲缓暮天愁，忽有金波潋滟浮。\n总为西亭最先得，清光一抹露山头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43118,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天镜潭","author":"王世贞","text":"纤鳞不起静无风，倒写青天入镜中。\n两岸青山带楼阁，何人不道水晶宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43119,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤条馆","author":"王世贞","text":"一片春云绿正饶，枝枝尽作凤皇条。\n他年傥得成焦尾，不待琴心已就挑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43120,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄屠长卿 其一","author":"王世贞","text":"神虎门头一挂冠，镜湖东去海天宽。\n人间有客都无耳，自是相如胜井丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43121,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄屠长卿 其二","author":"王世贞","text":"莫以怜才少相君，提封尽跨五湖云。\n请看六字镌官诏，便是仙都十赉文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43122,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"离薋园杂咏四首 其一 鴳适轩","author":"王世贞","text":"大鹏九万苦不足，尺鴳抢榆恒有余。\n除却逍遥真际在，便应方朔羡侏儒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43123,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"离薋园杂咏四首 其二 碧浪室","author":"王世贞","text":"百挺琅玕直复斜，午熏摇入小窗纱。\n偶然将作清漪看，碧浪湖头一钓艖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"离薋园杂咏四首 其三 晞发亭","author":"王世贞","text":"九月微霜未授衣，桑榆向暖发堪晞。\n不知紫翠峰头敛，愁见栖鸦闪闪归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"离薋园杂咏四首 其四 壶隐亭小山","author":"王世贞","text":"数拳培塿小亭前，涧壑峰峦亦宛然。\n不似壶公暂时幻，主人留结著书缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏无住观中物四首 其一 白鹦鹉","author":"王世贞","text":"仙音隐隐似云和，雪色衣裳推素娥。\n生长白莲花瓣内，那能不遣诵弥陀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏无住观中物四首 其二 双鹤","author":"王世贞","text":"青田别种是胎仙，午夜清音彻九天。\n我诵黄庭换凡骨，他时一点破苍烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏无住观中物四首 其三 驯鸽","author":"王世贞","text":"日长行散步庭皋，插羽佳人媚寂寥。\n五色别成铺地锦，千铃忽起半天娇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏无住观中物四首 其四 朱鱼","author":"王世贞","text":"猩红数点媚清泠，暖藻香萍度此生。\n莫向江湖贪广阔，近来鱼网大纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无锡陈生自樊山王邸来将梓其诗乞序姑与饭而以二绝句止之 其一","author":"王世贞","text":"词客淮南气若云，莫疑山叟怯相闻。\n自然鸡黍田家有，只是无名可借君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无锡陈生自樊山王邸来将梓其诗乞序姑与饭而以二绝句止之 其二","author":"王世贞","text":"平台新赋许谁贤，惟有相如赐独偏。\n若要上林天子问，吮毫应更十余年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画寿大参旸谷先生七十 其一","author":"王世贞","text":"永嘉城外小缑山，明月长容笙鹤闲。\n总为旸湖泉石好，未教王子厌人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画寿大参旸谷先生七十 其二","author":"王世贞","text":"千重绿嶂百重流，仙籍垂登朝籍收。\n长见岁星瓯越部，不劳明主访羊裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林光宇文学同高吴二茂才还闽四绝句 其一","author":"王世贞","text":"韩子文章日月光，当时闽海一欧阳。\n不论观察如常衮，分得三珠夜已光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"