[{"title":"林良二画 其二","author":"程敏政","text":"断崖风急鸣枯杨，回溪沙白芦草黄。\n羽毛纵横各有适，顾影似爱秋原长。\n此本谁当百金售，画堂彷佛闻清咮。\n老隼苍鹰不敢窥，疑在洋洋古灵囿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47418,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪窗兰","author":"程敏政","text":"谁将幽韵泻朱绳，赢得风神寄野僧。\n澧上国香还几种，欲钞花谱问零陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47419,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送史主事","author":"程敏政","text":"一年分省近江乡，不似亲庭隔太行。\n咫尺家书传溧浒，东南军食重淮阳。\n天恩早下金华诰，士论原归粉署郎。\n春晚送君频注目，落花随棹楚云长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47420,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄题蒋令君瑞芝亭","author":"程敏政","text":"槁木中宵紫气生，天开佳兆动山城。\n累累不止荣三秀，节节真堪配九茎。\n羽客四求空按谱，豸冠频谪更知名。\n洵阳百里甘棠地，徵诏何时出帝京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47421,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹鹤老人山水","author":"程敏政","text":"溪风吹云绕山腹，上见青山下茅屋。\n谁家亭子据潺湲，中隔板桥烟树绿。\n野艇悠悠来涧阿，晴沙白石滩声多。\n幽人不喜问奇字，扣舷一曲沧浪歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47422,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沈石田小景","author":"程敏政","text":"雨晴山麓上莓苔，老木亭前罨画开。\n城市爱閒应更少，水边才见一人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47423,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"画菜","author":"程敏政","text":"嫩甲纤纤浥露青，小斋终日候园丁。\n不知春到先红紫，几处争开择胜亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47424,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"画鹰","author":"程敏政","text":"一瞬青霄万里风，草间狐兔几回空。\n不知敛迹惊涛里，却是千人百购中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47425,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和答郑廷纲通政","author":"程敏政","text":"银台名重两京传，三载功高翰墨筵。\n南去地瞻钟阜近，北来人仰郑公贤。\n推恩喜奉回銮锦，赠别思临洗句泉。\n多士只今窥大业，肯从江海计流年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47426,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"双凤篇","author":"程敏政","text":"大凤先飞上丹阙，小凤随飞出丹穴。\n皇家结网未全疏，入眼平生两奇绝。\n春风簉羽骖龙翔，文章五色明朝阳。\n鹓班共指不易得，旧家似出三槐王。\n清咮时闻起阿阁，和气还应叶韶籥。\n舜文有道致祥多，远陋西京奏神雀。\n垣竹枰梧高入天，喧啾百鸟空茫然。\n愿加自宝奉明主，听取人歌双凤篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47427,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西垣对雨有怀罗明仲祭酒用旧韵奉简","author":"程敏政","text":"风回午枕梦初惊，雨促苔花绕砌生。\n墙角鸟喧黄屋静，树头人爱绮窗明。\n红尘不了真无计，白发相寻似有盟。\n忽忆旧游江海隔，一生知己大司成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47428,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九桥书舍为京学教授莆田陈君叙畴作","author":"程敏政","text":"十里莆南竹树村，九桥精舍太丘孙。\n衣冠屡报看花捷，水石疑留洗墨痕。\n聘士高风今入画，尚书经学久专门。\n寄言莫坠藏修地，白鹿遗规可重论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47429,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郭熙雪浦待渡图为杨孟瑛主事赋","author":"程敏政","text":"郭生写山名一代，平远萧然有馀态。\n触目谁传雪浦图，画苑风神宛如在。\n飞琼势压冻岚空，叠出数峰兼粉黛。\n傍岩古寺隔西崦，鸣玉淙淙得奇爱。\n联鞯恐是采梅者，何处山村酒堪贷。\n石梁欹仄冰在地，踯躅小童如不耐。\n前行候渡立沙尾，掉手野航呼并载。\n江空鸟绝树号风，一色乾坤四无碍。\n澄溪何必剡中路，高兴未孤思访戴。\n李成弟子凡几人，三叹郭生今不再。\n湘缣拂拭重怀古，清景无边句难逮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47430,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送平江伯陈公奉诏治水张秋","author":"程敏政","text":"薰风铙吹发连舻，入眼惊涛化坦途。\n令肃河防新铸印，功成邦计旧分符。\n世家不数酂侯传，幕府长披禹迹图。\n宽取圣忧归及早，可容旌节滞江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47431,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"八角雕花幡石一块饷暟东白善世","author":"程敏政","text":"云根谁凿竖经幢，流落真同客异邦。\n几见白莲驮象马，却埋苍藓混珉矼。\n三生梦觉诗仍在，八角盘坚意久降。\n舍赠幸逢东白老，看渠磨拭对禅窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47432,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泥金兰蕙图","author":"程敏政","text":"一干一花香出尘，一干数花香袭人。\n幽花本出山谷品，国香何似沅湘春。\n高洁棱棱石为偶，清籁萧萧竹为友。\n草间荆棘短且疏，去取疑非画工手。\n云谁爱作泥金披，为重此本千金宜。\n谷风习习未见采，古意只有焦桐知。\n供奉门庭净于水，图史如云集书几。\n无言相对此同心，粉黛从人写桃李。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47433,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"似大器亚卿约赏葵于北城","author":"程敏政","text":"闻说薰风会计轩，蜀葵开遍锦云繁。\n浓阴更可消炎暑，僻地谁能绝市喧。\n载酒几人来北郭，联镳一日下西垣。\n知君无限倾阳意，不羡閒花种满园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47434,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"翰林公署偶作","author":"程敏政","text":"回廊寂寂锁斋居，白日都消病历馀。\n窃食大官无寸补，绿阴亭上勘医书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47435,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送马谦贡士赴许州知州","author":"程敏政","text":"中州名胜亦西湖，喜奉新恩领郡符。\n五凤久徵循吏传，八龙谁复聚星图。\n白眉异表真才子，绿发初衔已大夫。\n圣主忧勤尝旰食，一方民瘼待君苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47436,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"衍圣公自曲阜载奇石一块至京相馈诗以谢之","author":"程敏政","text":"尼山分劈小昆崙，千里航来秀可飧。\n续谱正堪题雪浪，呼童频为洗云根。\n摩挲未了平生癖，斧凿疑存太古痕。\n荒圃自今增胜槩，一诗先谢素王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47437,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送释方策住善权寺","author":"程敏政","text":"上刹新闻住辩才，一舟南去水如苔。\n再传衣钵诗宗远，终日溪山画障开。\n草没仙人烧药灶，花明丞相读书台。\n病夫久欲捐荤饮，春焙还能数寄来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47438,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题张师夔画","author":"程敏政","text":"沙洲閒寄野航轻，山郭遥通石栈平。\n安得倚筇松下路，共凭高阁听溪声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47439,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哀灵椿卷为徐中行赋 其一","author":"程敏政","text":"鸡絮香残剑影空，一抔遥隔帝城东。\n夜深自有招魂些，树脚川声树杪风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47440,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哀灵椿卷为徐中行赋 其二","author":"程敏政","text":"坟草青青岁月多，独馀庭树影婆娑。\n他时结綵缠修干，重续徐卿二子歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47441,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒陵承西涯翰长有诗相饯次韵五篇 其一 道中作","author":"程敏政","text":"北郭诗筒走置邮，风光长为客迟留。\n连村岁稔鸡鱼贱，故国城荒鹿豕游。\n水没断村惊旧雨，蝉依高木战新秋。\n青山久别今重见，一笑还能识面不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47442,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒陵承西涯翰长有诗相饯次韵五篇 其二 甲辰岁与子阳太史同行今十年矣感旧作","author":"程敏政","text":"岁华忙迫似星邮，霜入吟髭不少留。\n三日倡酬曾满纸，十年离合几同游。\n方难却老思医扁，学易隳功感奕秋。\n佳话不知残暑退，清风能及故人不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47443,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒陵承西涯翰长有诗相饯次韵五篇 其三 宿刘谏议祠下作","author":"程敏政","text":"百岁浮生一传邮，重公英誉到今留。\n人间虎榜真多愧，地下龙逢可并游。\n孔庙作邻庭桧晚，唐宫何处井梧秋。\n得开祀典须贤令，能有封章达帝不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47444,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒陵承西涯翰长有诗相饯次韵五篇 其四 连日忧雨作","author":"程敏政","text":"黑云成阵作诗邮，不得荒城半日留。\n岚黛有情随面出，雷车无定绕空游。\n道傍唤转林鸠午，风外飞馀石燕秋。\n寸寸入山惊雨意，友人还及念予不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47445,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒陵承西涯翰长有诗相饯次韵五篇 其五 谒陵后喜晴作","author":"程敏政","text":"来往浓阴若递邮，晚晴无复片云留。\n山呈玉笋凌空出，水幻骊龙抱月游。\n奇事我逢三日霁，赏心天赉一林秋。\n归途为问朝陵使，曾有新篇纪胜不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47446,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王懋伦佥事进表还四川提学","author":"程敏政","text":"雨露恩通万里天，喜随群牧上尧年。\n文章旧业馀三馆，弦诵新声遍两川。\n壮岁几人先服豸，清秋一路早闻蝉。\n贾生不久还膺召，为子长歌解剑篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47447,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送常州府知事邵智之任","author":"程敏政","text":"一舟南去渺征鸿，秋意才看到井桐。\n恩向枫宸分湛露，仕从莲幕引清风。\n酒杯饷客驱驰里，诗券还君邂逅中。\n喜说晋陵官况好，簿书清简粟陈红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47448,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"贺徐原一亚卿得双生子","author":"程敏政","text":"画堂俯通逵，佳气日葱茜。\n襁褓忽双生，彷佛蚌珠见。\n凭谁分伯仲，婉娈如一面。\n主人廊庙姿，慷慨济时彦。\n及此熊罴祥，那觉鬓丝变。\n升升骐骥种，采采芣苢眷。\n坐令阀阅家，远迩一惊羡。\n纷纭会汤饼，箫管动庭院。\n末由充贺宾，追逐叨一面。\n为赋瓜瓞篇，迂迟笑衰倦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47449,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送通守马金进表还庐州","author":"程敏政","text":"才看谪宦出京畿，早见来朝自合肥。\n上寿喜随瞻舜冕，娱亲兼得试莱衣。\n中天雨露常时降，南国山川几日归。\n记取一番新去住，离亭蝉咽井梧飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47450,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄子久山水为陆翰长廉伯题","author":"程敏政","text":"丹青旧数黄公望，一幅溪山似瀼东。\n悬瀑自天喷早雪，飞桥临水驾晴虹。\n谈玄偶接苏门士，采药空迷雁荡翁。\n安得为弦招隐操，共凭苔石面松风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47451,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"小景便面","author":"程敏政","text":"水边芳草绿茸长，石畔新蕉凤尾香。\n满目化机谁解领，掀髯应不为诗忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47452,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送唐秀才还曹州","author":"程敏政","text":"别路惊残暑，行人发去舟。\n一经传载记，千里向曹州。\n馔会芹宫晓，香分桂殿秋。\n宾鸿声渐近，随处莫登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47453,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王德润参政进表还河南 其一","author":"程敏政","text":"朝辞南去及秋晴，万岁声齐报礼成。\n巨镇带河中土胜，列星环斗北辰明。\n久推茂绩书循吏，渐拟清班接上卿。\n嵩岳正当封域里，往来多少爱君情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47454,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王德润参政进表还河南 其二","author":"程敏政","text":"礼闱亲荐出群才，翰苑重看蚌有胎。\n榜下衣冠今再叶，里中文献旧三槐。\n出城催上离亭宴，候馆知从觐阙来。\n多病得谁增壮色，送君斜日下燕台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47455,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送周文良医从兴王之国","author":"程敏政","text":"辇下儒医正数君，城东为别思纷纷。\n黄花香入离觞饮，白雁声随客棹闻。\n焚券有名看续传，曳裾无事好论文。\n萍踪落落仍多病，金匮馀方得见分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47456,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题山水障子","author":"程敏政","text":"摩诘诗从画中见，触处天机自流转。\n黄鹂白鹭辋川图，入眼何须好束绢。\n多君此图谁笔之，谓是当年春望诗。\n绿草烟横荜茥苑，红莲雨足昆明池。\n金阙沈沈半空起，柳暗花明连数里。\n不嫌车马踏泥行，城外风光似城里。\n太平有象作者难，品题不在丹青间。\n悠悠致主泽民意，对景令人生汗颜。\n隐几秋霖玉堂署，渭水黄山渺何处。\n倦来无力展新图，时复高吟右丞句。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47457,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿林宜人七十","author":"程敏政","text":"闽海风光说上元，一时佳庆绕鱼轩。\n瑶池屡喜青鸾至，丹穴齐看彩凤鶱。\n寿羡几人跻耄耋，教行诸妇谨寒暄。\n晴霄万里瞻云意，并逐春风入故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47458,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻绩溪高尹被奖劳之典","author":"程敏政","text":"乐奏新声彩币红，令君名满练溪东。\n风行驿路除宵警，雨足山乡乐岁丰。\n考绩政成花县久，旌劳人羡柏台公。\n题诗欲附循良卷，思绕丛山紫翠中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47459,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和答屠元勋都宪","author":"程敏政","text":"忽忽沧洲子，京华两见秋。\n望尘惊市陌，听雨忆江楼。\n白发欺谁老，黄花慰客留。\n归心轻过雁，君宠若为酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47460,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甲寅岁八月廿七日过大监戴公城东清适园亭漫成一律","author":"程敏政","text":"雨后晴沙不作泥，路回深巷忽闻鸡。\n黄交稚菊栽初盛，绿上新蔬剪未齐。\n尘外画缣谁布景，眼前诗橐好分题。\n主人莫讶难相见，绕屋滩声似剡溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47461,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与曹良金吉士","author":"程敏政","text":"永日吾伊不惮劳，篇篇成诵爱吾曹。\n九畴一序皇猷远，二相同心圣见高。\n孔壁有灵开治本，考亭无斁仰人豪。\n閒抛岁月成何事，三嗅芸香感二毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47462,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孤松挺秀图为用礼题","author":"程敏政","text":"天寒地坼万木凋，何许直干凌丹霄。\n凛然夜壑走风雨，老龙怒挟钱塘潮。\n人言丁公得奇梦，手抚苍髯欲飞动。\n良工好取献明堂，莫向空山委梁栋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47463,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿庆云侯母夫人八十","author":"程敏政","text":"南极流辉彻绛霄，北堂称庆拥金貂。\n恩筵味足兼麟脯，寿曲声清叶凤箫。\n生值太平期百岁，教行长乐冠三朝。\n饮馀试阅瑶池景，慈竹凌寒独后凋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47464,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送俞凝之赴徽郡照磨","author":"程敏政","text":"不见尊公喜见渠，郡中莲幕奉恩除。\n一尊把菊难为别，两世通家老愧予。\n行李却随征雁后，到官应及杪秋馀。\n因君定作乡园梦，先到南山水竹居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47465,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次陈白沙太史韵送广东何贡士赴南京光禄署正","author":"程敏政","text":"世诵何蕃传，名题孝行门。\n积诚孚草木，贻训及儿孙。\n簪绂新恩重，诗书旧业存。\n貤封君素志，纶綍待王言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47466,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题泰和吴尹必显祈雨有感卷","author":"程敏政","text":"杏园风日早蜚英，花县功名合有成。\n一雨慰民非偶尔，寸心忧国是平生。\n帝闻美政酬褒典，人乐丰年起颂声。\n此日恤荒频下诏，为君题卷不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47467,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九月八日閒步公署西园独坐亭上有怀","author":"程敏政","text":"公退聊乘半日閒，小园深径雨苔斑。\n红尘不到幽亭上，白鹤长鸣古树边。\n老学簿书空有感，才非供奉久无颜。\n明朝又及黄花候，何处登高忆故山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47468,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题金太仆本清竹","author":"程敏政","text":"往年曾识太瘦生，风神如鹤诗有声。\n高情雅澹惟爱竹，挥染不让东吴卿。\n一竿两竿已清洒，凤尾萧萧翠堪把。\n秋空弄影纵复横，宛坐山窗月明下。\n眼中何得千琅玕，怪石齿齿扬飞澜。\n人间六月无寸暑，细看令我霜毛寒。\n忆在江南白沙渚，十亩新篁舞烟雨。\n腰镰斸笋荐松醪，不惜年年自宾主。\n马蹄再触京华尘，梦魂长绕苍庭筠。\n偶窥墨本犹昨日，满耳清风怀故人。\n谪仙之孙好图史，风节棱棱重金紫。\n公馀相对欲忘餐，为说坚贞似君子。\n朔气来时嘘冻云，千花万卉无馀芬。\n凭谁可结岁寒友，雪后青青惟此君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47469,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽刘屯田","author":"程敏政","text":"宰木萧萧掩墓场，屯田人去几星霜。\n早将礼乐魁南甸，几出忠言拒左珰。\n小阮立台昭世训，髯刘为宰冠诸郎。\n名镌翠碣青山下，拟共禾川逝水长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47470,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿锦衣鲁宣百户母八十兼受封","author":"程敏政","text":"禁卫才名羡鲁侯，诰颁新轴锦盘虬。\n恩封不比寻常庆，慈寿将临八十秋。\n鹤酝屡尝春拂面，翟冠初上雪盈头。\n显扬有子身仍健，海屋遥添第几筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47471,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送汪廷器艮观","author":"程敏政","text":"曾随南雁住云中，又出榆关到海东。\n壮岁尽誇行乐好，太平谁致塞尘空。\n轮蹄惯比孤舟速，书画收兼百货丰。\n来往莫讥江上客，王孙家世古元戎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47472,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和答屠朝宗都宪见赠之什 其一","author":"程敏政","text":"久幸斯文号一家，我惭学海望中赊。\n修鳞合附风雷起，朽木那堪雨露加。\n讲幄寸衷看日稿，宦途多病数年华。\n缁衣可续知公意，不负崇班帝汝嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47473,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和答屠朝宗都宪见赠之什 其二","author":"程敏政","text":"积书空似邺侯家，白发侵寻岁月赊。\n清世一官无寸补，湛恩三日愧重加。\n思从尹谢研家学，敢共卢王斗国华。\n天语不忘供奉辈，涓埃何力称褒嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47474,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和答屠朝宗都宪见赠之什 其三","author":"程敏政","text":"诗筒来自大夫家，路转东城一径赊。\n珠玉在缄光照映，龙蛇随笔影交加。\n君才入眼真无敌，我屋从今倍有华。\n拟泼旧醅酬近约，晚秋风日正清嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47475,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿樊驸马母夫人","author":"程敏政","text":"寿筵风景似丹丘，珠翟辉煌映白头。\n女士向来誇邺郡，帝甥今日数樊侯。\n庭晖影转蓂更朔，宫露香分菊恋秋。\n却指南山问东海，几时清浅报添筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47476,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"贺屠朝宗进左都宪加太子少保","author":"程敏政","text":"凤敕辉煌听晓颁，鸿恩汪濊属丹山。\n江南旧望传三辅，岭表新功震百蛮。\n左辖位当乌府印，东朝官重紫宸班。\n清时才杰如公少，看立勋名宇宙间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47477,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题小景","author":"程敏政","text":"黄叶风前守钓矶，石梁沙口负薪归。\n轮蹄只在青山外，想见红尘扑面飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47478,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]