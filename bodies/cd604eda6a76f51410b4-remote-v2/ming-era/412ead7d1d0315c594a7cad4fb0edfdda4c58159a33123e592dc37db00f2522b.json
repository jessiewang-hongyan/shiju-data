[{"title":"夏涨即事 其四","author":"尹体震","text":"烟波十里晓风飘，杜若洲前暑气消。\n眼底阴晴今古事，渡江谁作楚魂招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"王应莘","text":"江干握别思依依，惆怅佳人去不归。\n鸾镜冷抛孤影没，雀台深锁旧踪稀。\n愁闻野鸟哀明月，忍见闲花送夕晖。\n瞻望至今嗟弗及，挥毫空有泪沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其十四","author":"梁以壮","text":"五十年来事，今朝悔昨朝。\n路行皆蜀险，书著亦秦烧。\n一啸响空谷，五噫归小桥。\n片心孤托月，长独立中宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其十五","author":"梁以壮","text":"天地唯空阔，幽居亦静深。\n畏纶鳐有翼，舐铁貊何心。\n烟到柳边白，潮生花外阴。\n热情都去尽，不用斸黄芩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其十六","author":"梁以壮","text":"我有阿堵物，天亡造化权。\n鬼神皆懒散，人事漫周旋。\n养雀留阶米，浇花汲野泉。\n隔江丹荔熟，一放木兰船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其十七","author":"梁以壮","text":"涉世殊劳顿，多从病后知。\n方圆皆有失，喜怒总成痴。\n信步寻幽晚，穿林听鸟迟。\n忽闻吾社事，明日又吟诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其十八","author":"梁以壮","text":"看书才罢卷，习圃过前坳。\n辛苦方能寿，幽栖乃见嘲。\n土硗添竹笋，林密保鸦巢。\n近得池盈亩，中间结一茅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其十九","author":"梁以壮","text":"文字皆无用，趋时自觉疏。\n此心人未解，幽事独何如。\n偶得天官册，看星静夜初。\n蛮童催酒熟，酣卧石阶虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居 其二十","author":"梁以壮","text":"省累惟甘拙，添欢或益狂。\n看山契樵牧，酌酒向林塘。\n鸟亦能歌舞，花仍解赠将。\n蹉跎期寿补，天与水云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牧羊","author":"梁以壮","text":"乱石荒原外，烟深影共邻。\n入山非背世，为物亦依人。\n一啸微阳下，数茎白发新。\n长年披五羖，不是牧羊贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋雨","author":"梁以壮","text":"秪欢时雨及，不敢怨风寒。\n民力一秋苦，山田昨日乾。\n小桥行未折，破屋补方完。\n白鸟难沉没，云边人共看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜雨","author":"梁以壮","text":"初秋雨不歇，云暗四围深。\n何处看天地，通宵独抱琴。\n蛙声灯影入，鱼气瓦边沉。\n寂莫还如此，狂风讵到心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟入浈阳峡怀同社诸子","author":"梁以壮","text":"日午不落影，秋心极窅冥。\n飞泉舂石瘦，峭壁到天青。\n无雁下前水，微吟隔叠屏。\n几回风雨后，独立看清泠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旅怀","author":"梁以壮","text":"如何为客泪，一一逐啼乌。\n闾久无人倚，庭空仗弟趋。\n寄书劳楚驿，得梦语奚奴。\n慎莫多霜雪，貂裘敝五湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬至日舟次耒阳","author":"梁以壮","text":"旧去羁吴路，今来滞楚乡。\n二年逢至日，一水泊斜阳。\n对橘思亲在，看云忆雁行。\n不知此时节，家事得平常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟入中宿峡","author":"梁以壮","text":"前山当面隔，一转互相通。\n世路已如此，人生却亦同。\n树深藏宿雨，烟澹散朝风。\n蓑笠眠渔父，芦边日影红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上九峰泷","author":"梁以壮","text":"水声高似雨，日断几回魂。\n船向半空立，烟盘群鬼喧。\n浮生馀病骨，愁绪起秋原。\n履险韩祠在，忠诚不易言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"裘敝","author":"梁以壮","text":"入秦书不上，瘦骨一冬寒。\n自笑貂裘敝，多添布衲宽。\n拥炉当雨雪，炙日向阑干。\n换酒非无物，馀刍可作欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"走马","author":"梁以壮","text":"短服齐腰窄，红飞阔帽缨。\n人看能走马，谁识是书生。\n一路花难媚，长风鸟共争。\n十年三去向，文武旧西京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻莺","author":"梁以壮","text":"莺语皆闻惯，呢喃众不疑。\n自怜凤皇舌，莫乞市人知。\n出谷难为嘿，高飞却独还。\n未能藏大雅，名著亦莺危。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻鸡","author":"梁以壮","text":"落落复如此，漫漫夜复长。\n一鸡惊客梦，十载滞他乡。\n齐井三更月，秦关万里霜。\n不知谁待旦，愁老入清狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊子小除夜","author":"梁以壮","text":"今年小除夜，安似去年时。\n不见老成父，兼无第五儿。\n对灯犹旧影，告灶是新辞。\n报说春消息，三更到海湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日东皋","author":"梁以壮","text":"水隔一山断，烟微草色初。\n物情知入暖，世事未全疏。\n度柳莺声涩，过桥日影徐。\n昔人无复作，凭吊亦何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对镜","author":"梁以壮","text":"秋水入怀抱，相知尔独亲。\n家无双老大，须变几茎新。\n四十一年事，东南西北人。\n红颜何药驻，况乃在风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕","author":"梁以壮","text":"夜半西风寂，双星一会时。\n路嫌芳草湿，桥爱细乌知。\n秋月明河汉，寒云结辇帷。\n人间纵无别，终有白头悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊","author":"梁以壮","text":"篱光通竹屋，霜色上幽襟。\n与尔相怜晚，临风顾影深。\n疏慵能寿世，静澹乃知心。\n莫恨馀衰草，纵横岂易侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻梅","author":"梁以壮","text":"人烟离渐远，心已觉香温。\n路入春消息，山通夜梦魂。\n霏霏仍小雪，漠漠又孤村。\n几折湖桥外，相留到月昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芙汀居士自赠","author":"梁以壮","text":"居士何如者，谋生拙且慵。\n三閒茅屋地，一半木芙蓉。\n独立抱明月，幽思向绝峰。\n近来车马过，已报去为农。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"击柝","author":"梁以壮","text":"兵马难防盗，为民夜夜辛。\n轮当击柝子，来唤读书人。\n磁枕前年梦，桃花何处春。\n莫多閒作赋，随队五更频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十六夜月蚀","author":"梁以壮","text":"昨夜兴未已，兹情岂偶然。\n三更独薄蚀，万感不能眠。\n世路多陈蔡，悲歌半赵燕。\n高明故当厄，遮莫问青天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有托招予谒门下者诗以代柬辞之","author":"梁以壮","text":"秪恐负知己，沉吟故草莱。\n书为垂老癖，心已及秋灰。\n有鹿归蕉梦，无珠保蚌胎。\n甘贫讵免醉，迂拙是从来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"省先君子墓","author":"梁以壮","text":"先人素潇洒，魂体尚能全。\n不肯还家老，而为伏虎仙。\n一丘空落日，万恨在终天。\n春草无知物，青青年又年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有感","author":"梁以壮","text":"本是寻常事，时艰不易行。\n外愁攻四面，独立似孤城。\n野阔猿无迹，天高鹤一声。\n未能閒数物，寂寞亦劳生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种药","author":"梁以壮","text":"半亩馀空阔，江烟绿到帘。\n药宜春及种，人以病犹淹。\n懒灌得泉近，新愁为野添。\n山翁贻我谱，分晰尚纤纤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"示四儿","author":"梁以壮","text":"汝祖十二世，皆为盛世儒。\n文章留在箧，功业著当途。\n莫似疏狂父，空成懒癖夫。\n此心难细说，甘苦得知无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀申岘山协领","author":"梁以壮","text":"绥江归十日，未过戟门深。\n以我秋葭抱，思君明月心。\n郊居仍读易，城隔不闻琴。\n懒癖知能恕，蛮笺又至今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与西宁明府王可亭对奕","author":"梁以壮","text":"不可迷当局，安危不易终。\n用奇留劫外，得算在心中。\n漠漠孤亭雨，微微一径风。\n以兹托幽意，馀橘照人红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马子千招饮","author":"梁以壮","text":"正想与君饮，君招岂偶然。\n北门戎马地，陋巷箪瓢贤。\n添酒呼儿入，看诗就烛边。\n客中难得此，又到二更天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"烧炉","author":"梁以壮","text":"香烟吹已歇，金兽半尘埃。\n只合添新炭，还堪保旧灰。\n于人能养性，为物亦成才。\n寂寞明窗里，辛勤十载来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿华首台","author":"梁以壮","text":"不识罗浮路，初寻华首台。\n云归灯影湿，人立鹤飞来。\n合掌移萝月，孤峰对茗杯。\n似闻半空语，门掩几回开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱明洞","author":"梁以壮","text":"勾曲来云气，云深四百巅。\n洞中藏万象，日夜星辰悬。\n岂有真人出，如闻清啸前。\n此时心里血，一一化寒泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿见日亭","author":"梁以壮","text":"独影孤亭宿，飞云衿抱中。\n海声上萝薜，夜半扶桑红。\n下屐疑无地，凭虚御有风。\n稚川如不见，长啸与谁同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚过中宿峡","author":"梁以壮","text":"雨后斜阳半，虹霓草面生。\n有山皆画意，无水不琴声。\n薄雾空犹湿，潜蛟影欲呈。\n曾闻老僧说，幽险似人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长儿淮完婚诸君子赋赠因答之","author":"梁以壮","text":"儿大催吾老，多愁始作翁。\n亲朋皆至喜，诗律总能工。\n布席有薇蕨，司壶无仆僮。\n但求都草草，双耳听松风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有客说近闻场屋兼取诗赋素能必售因信口示之","author":"梁以壮","text":"李杜科名薄，高才大半沉。\n天无西北角，人有万千心。\n造化谁看破，聪明鬼忌深。\n秪当聊自得，吾自写吾吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四儿溆生日诗以示之","author":"梁以壮","text":"归家苦行路，客里且盘桓。\n一十三年侍，初秋四日欢。\n劬劳惟汝母，汝父尚艰难。\n学闻如俱长，当时梦白鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"须白","author":"梁以壮","text":"撚断馀无几，沉吟倚雪风。\n艰危辛苦里，五十二年中。\n劳落犹为客，蹉跎已是翁。\n渐知头亦白，肝胆为谁红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢山人退非赠诗","author":"梁以壮","text":"吾亦名冲漠，谁曾知此心。\n嚼华丹鹤下，吞响翠屏深。\n尺蠖振城郭，焦螟飞夕阴。\n五难聊洒落，君复开瑶琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日","author":"梁以壮","text":"年来无一似，渐老益疏慵。\n酒少留寒饮，衣崩候暖缝。\n热肠渐变雪，瘦骨欲成峰。\n且便搜馀纸，残窗细细封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙申岁将暮家有一豕鬻之市人可以过岁闻夜暴死","author":"梁以壮","text":"一豕极微值，难留过岁贫。\n空劳妻子事，不是井田人。\n作脯同牛误，为云化水频。\n浮生休计较，吾道未全迍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢黄西村惠安南棕竹杖","author":"梁以壮","text":"惠我棕竹杖，来从九真烟。\n亭亭方百节，踽踽已多年。\n忆岳重游易，过桥得影先。\n夕阳筋骨好，醉入杏花边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟上闻江寺晓钟","author":"梁以壮","text":"候潮情未已，空阔独闻钟。\n一一度寒水，泠泠入远峰。\n乾坤皆梦薮，城市亦萍踪。\n心忽随僧觉，浮云破几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与友人订入罗浮","author":"梁以壮","text":"罗浮抱初气，可以鼓吾琴。\n忘世非孤立，同君有素心。\n泉边朝斸术，洞口晚锄芩。\n四百峰中住，无人到得寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送癯仙住沙湾","author":"梁以壮","text":"闻说青螺外，幽斋好一间。\n有人风雅甚，留汝赋诗閒。\n写字临残帖，扶藤上近山。\n深秋知雨少，予或到沙湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮","author":"梁以壮","text":"五十此岁暮，萧条不易过。\n租因淫雨失，债为酒赊多。\n寒月澹四壁，古琴鸣一歌。\n妻儿岂忘俗，其奈懒人何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"食蚬","author":"梁以壮","text":"沙蚬鲜于蚌，春肥价亦廉。\n食惟无钉易，味以有珠兼。\n可辟山岚重，能消酒气严。\n十年甘淡薄，傍海结茅檐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春朝郊行","author":"梁以壮","text":"漠漠东郊上，方升日照容。\n白驹司姣仆，春服到高松。\n草色青归眼，涛声阔入胸。\n无穷芳意外，云起看新龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上元夕擘柑","author":"梁以壮","text":"美人出怀袖，传我一柑归。\n指上春痕脆，灯边香雾飞。\n近知垂老得，能集幼孙围。\n萍实何年事，空劳感物微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答马子千过兰扃赋赠","author":"梁以壮","text":"以我疏狂老，多凭酒释愁。\n天馀游宕子，爵是醉乡侯。\n遂与世情背，将毋古道求。\n不嫌人陋巷，仙迹带浮丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠","author":"梁以壮","text":"天地来磅礴，三城挹太和。\n中流长砥柱，频历几风波。\n灵气随潮凸，含光见月多。\n朱明开一户，不是宅神螺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"眼暗","author":"梁以壮","text":"几日抄书后，惊看字画肥。\n蹉跎催眼暗，老态与心违。\n佩玉寒分石，盘珠听辨玑。\n翻嫌少年事，明白半成非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明日","author":"梁以壮","text":"文草杯棬在，清明分外愁。\n白云随眼到，红泪入肝流。\n世上无长梦，谁终免一丘。\n赤松吾欲访，还恐涉虚浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铲草","author":"梁以壮","text":"最恶无如草，烟霾日复阴。\n用柔人不觉，滋蔓地全侵。\n禾众伤犹浅，兰孤害更深。\n只须都铲尽，方快至仁心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乞金","author":"梁以壮","text":"世路多贫贱，营营乞羡馀。\n不知阿堵物，能变绝交书。\n浓露藏微药，浮云过太虚。\n焚香惟玩易，明月在吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"星岩","author":"梁以壮","text":"乍入不知处，山风逆面凉。\n四时似飞雨，几折透湖光。\n倒碛分辰宿，流声合徵商。\n避秦当日叟，此地却遗忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端阳","author":"梁以壮","text":"端阳归且好，恰有卖文钱。\n杨柳边沽酒，离支下放船。\n细风渔浦晚，疏雨汨罗天。\n才是人间妒，当空哭古贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀罗浮 其一","author":"梁以壮","text":"未能谢尘俗，心已在罗浮。\n名利难为钓，神仙或可求。\n任人笑痴拙，于我得优游。\n准拟幽栖去，梅村定石楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀罗浮 其二","author":"梁以壮","text":"危真亦已久，渐老悔前非。\n易卜天山遁，诗吟泌水饥。\n白烟丹灶火，青薜野人衣。\n异草供朝夕，能令病骨肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀罗浮 其三","author":"梁以壮","text":"山半云行雨，三更日照林。\n人间都在梦，世外岂多阴。\n以此发清啸，同谁弹古琴。\n若逢乌利子，还可结知心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归去","author":"梁以壮","text":"归去且归去，吾庐自一天。\n静能存耳目，贫不碍山川。\n岁晚兰犹吐，粮微鹤亦坚。\n半裘明月下，点检旧诗篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟入大庙峡","author":"梁以壮","text":"古庙亦林麓，琴书几往还。\n绿齐芳草岸，红尽海棠山。\n不断岩泉响，争飞野鸟閒。\n何当杂渔牧，难得是愚顽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]