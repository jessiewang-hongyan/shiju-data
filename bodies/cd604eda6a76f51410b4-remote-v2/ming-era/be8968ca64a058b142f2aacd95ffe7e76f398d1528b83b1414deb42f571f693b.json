[{"title":"秋杪","author":"区越","text":"落寞经秋尽，蚕绵未着衣。\n酒狂诗欲发，已被菊花知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汤涧松钟海月二公舟中手谈","author":"区越","text":"输赢论世局，消长看潮航。\n何日梅花句，同公赋草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"看菊寄毅斋刘宪长","author":"区越","text":"到日开三径，骚坛会九翁。\n数篇佳菊赋，应念赏心同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"午日","author":"区越","text":"久洽烟霞赏，风花入讨论。\n龙声腾海外，徙倚独开樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜 其一","author":"区越","text":"鸡黍荐新酌，莼鲈添客尝。\n东园月已满，坐久不知凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜 其二","author":"区越","text":"橘棋留未著，梅酒快先尝。\n野老心如澹，秋分夜倍凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与李铁谷践归隐之约","author":"区越","text":"东谷当时约，飞云敢后期。\n风流惟有此，猿鹤且同之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起指示诸侄","author":"区越","text":"烟霞成旧垒，溟海笑浮卮。\n白发真谁伴，梅花瘦碧墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暇日书怀","author":"区越","text":"哦诗拈近体，采酒压新刍。\n老得身闲处，何须分外求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初秋社约 其一","author":"区越","text":"晨起山楼坐，微风度雁音。\n青尊酣白露，时动北窗吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初秋社约 其二","author":"区越","text":"洲近芦翻白，林低橘荐黄。\n篱前萧飒意，聊以佐秋觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜雨","author":"区越","text":"万壑阴云合，一天凉雨来。\n泉声锵有韵，花坞净无埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"口占","author":"区越","text":"共酌小亭下，诗新酒倍浓。\n闲花争两岸，醉眼不朦胧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"溪行","author":"区越","text":"笛远归渔急，芦轻扑酒飞。\n偶然云水趣，宁占白鸥矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜答友人","author":"区越","text":"连旬多逸事，荷叶制新衣。\n不尽藤溪舫，兴来觉有时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登小卢山楚云台","author":"区元晋","text":"放歌天外倚崆峒，半亩犹存处士宫。\n螺黛蹲连山九锁，嚣尘飞断路千重。\n岩閒鹿迹侵苔绿，春浅桃花覆涧红。\n千载楚云思不尽，欲凭黄鹤问仙踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题弓鞋山","author":"陈珖","text":"龙泉仙子下江游，脱却双湾半不收。\n愿倩天孙补成对，乘风踏上五云头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晋康八景诗 其一 香山古迹","author":"陈辂","text":"香山谁许锁烟霞，地主风流旧景加。\n桃李种新亭焕昔，客来寻赏媚春花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晋康八景诗 其二 三洲洞天","author":"陈辂","text":"三洲清玩忆年年，杖履真游兴浩然。\n一幅寰中仙岛画，翠涵虚壁自开天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晋康八景诗 其三 端溪夜月","author":"陈辂","text":"端溪清练满菱花，翡翠鵁鶄十里沙。\n最是月明天湛碧，静看风景更无涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晋康八景诗 其四 笔架晴岚","author":"陈辂","text":"建业三山名与齐，烟霄青出洗低迷。\n借来架我描天笔，扫却岚光莫乱栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晋康八景诗 其五 锦石撑空","author":"陈辂","text":"女娲馀炼此孤撑，屼峍云天锦削生。\n满眼狂澜纷日下，老怀移欲障东倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晋康八景诗 其六 青旗拥翠","author":"陈辂","text":"曾说风雷起卧龙，青旗犹自绕前峰。\n迎神曲罢荒祠外，古木寒烟翠几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晋康八景诗 其七 西湾渔唱","author":"陈辂","text":"西去康州碧水湾，晚来渔唱隔溪还。\n风晴浪静扁舟稳，安得奔波试一看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晋康八景诗 其八 佛岭樵归","author":"陈辂","text":"嵯峨樵径晓纵横，猿鸟愁闻伐木声。\n辛苦为谁肩担上，晚归鸦噪已西城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆大夫祠","author":"陈辂","text":"独持黄纸传天语，万里归朝感尉佗。\n南海共宜新庙宇，晋康非但汉山河。\n春风此地闻箫鼓，锦石千年洗薜萝。\n满眼绿林烟雨里，尚怀清论息干戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉靖丁酉腊月十二日守备聂挥使邀游三洲岩","author":"陈辂","text":"晓岸晴烟驻画篷，胜寻迷赏到崆峒。\n香深衣袂琪花径，翠润杯觞石乳宫。\n三岛远分浮岱粤，七星相映峙西东。\n崔嵬万古堂虚静，翻笑人心浑不同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨子江舟中同湛甘泉先生对酌","author":"祁孜","text":"两岸垂葭荻，中流一叶舟。\n无边光景好，浑似粤江秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿祁兰窗先生","author":"陈志敬","text":"绿野香风满画檐，明窗高卧捲湘帘。\n写怀閒把冰弦奏，修谱还将彩笔拈。\n半点尘埃何处著，九重雨露会频沾。\n年来生意无穷在，兰玉阶前次第添。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题榕湾别号","author":"陈志敬","text":"绿树屯云醾碧波，水云乡里寄吟窝。\n蝉鸣叶底声调瑟，鱼跃波间影弄梭。\n拂石敲棋惊鹤梦，隔江呼酒听渔歌。\n醉来我有山阴兴，几欲移舟雪夜过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过羊子山","author":"陈超","text":"石磴穿云鸟道边，山花诗兴两茫然。\n千寻崖壑劳撑住，几度篮舆费挽牵。\n老鹤声中僧伴月，嫩岚遮处岭横天。\n欲将往事山前问，羊子题名尚记年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒尹吉甫祠","author":"陈超","text":"天上煌煌羽檄催，烧空硉矹火云堆。\n一时曾振中兴业，千古还思大将才。\n月满松萝栖鹳鹤，年深阶砌长莓苔。\n经过亦有城皋寄，谁赠清风一慰开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴中思亲寄兄柏山","author":"张镖","text":"思亲无计得归家，惆怅危楼对落花。\n枕上三更羁旅梦，眼中两度早春华。\n山窗破晓莺啼树，水郭排青竹映沙。\n自笑为谋真太拙，一身孤立见天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读文山集","author":"邝岑","text":"真金千炼文山老，正气堂堂宇宙中。\n被执潮阳生慷慨，临刑燕市死从容。\n庐陵有水皆增色，龚胜虽忠亦下风。\n当日陆张同死国，厓门香火万年崇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日登玄览台","author":"陈锡","text":"靡靡流火西，鲜飙扫馀燠。\n奇怀迈良辰，散步粤山麓。\n林峦蔚葱茜，丘壑缭而曲。\n振缨蹑崇台，神情若新沐。\n绰约台上人，清扬美如玉。\n冥心观太初，天地渺一粟。\n幻形忘赘疣，委运付亭毒。\n浮云寓太虚，不满一捧腹。\n悠哉偕友朋，适意此盘谷。\n岸帻南斗旁，云溟聘遐瞩。\n徜徉四山暝，日入欢未足。\n秋声动乔林，飒飒度疏竹。\n松灯奚待篝，明月自为烛。\n真乐同逍遥，岂必骖黄鹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浴日亭","author":"陈锡","text":"苍茫烟水拍长天，断续渔舟起荻湾。\n林雾半沉鳌背月，波光先撼虎头山。\n摩挲若木聊晞发，呼吸朝霞小驻颜。\n安得乘风生羽翼，宾阳长傍彩云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三忠祠","author":"陈锡","text":"荒凉艮岳草萋萋，南渡湖山意转迷。\n炎海膻腥朝饮马，厓门风雨夜鸣鸡。\n两间正气华夷肃，万古精光日月齐。\n成败未须伤往事，狐宫煨烬没棠梨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登越王台","author":"陈锡","text":"百粤风尘迥，登临野色分。\n牛羊散平陆，狐兔穴荒坟。\n旧垒寒鸦集，残碑动火焚。\n青山故无恙，鸾道杳秋云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏菊呈有中先生","author":"黄著","text":"何处金钱万朵开，举杯相对问谁栽。\n风清霜白真堪赏，疑是原从栗里来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午除夕","author":"李瑜","text":"三十三回江上年，年年江上枕蓑眠。\n梦迷云水轻鸥外，身在梅花太极前。\n造次眼中攻百病，浅深杯里谢千缘。\n床头且觅花婆酒，一笑聊供守岁筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵李子长","author":"李瑜","text":"欲寻酒处结生涯，安得藤枝引病骸。\n栗里对花皆逸事，醉乡眠月亦无怀。\n影临秋水疑乌帽，足入云山信短鞋。\n起倒惟公深有意，不知何处是瑶阶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴东湖明府升四川成都别驾","author":"李瑜","text":"千里还乘别驾车，花封刚足百年书。\n月离水郭千家暝，春渡巴江万锦舒。\n水雪每形歌咏里，功名分付笑谈馀。\n丹青胜欲留公影，只恐风流画不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"飞来寺留别吴邑侯次梁景行韵","author":"李瑜","text":"看到公心水月羞，民歌柏柏起南州。\n日边忧国将成老，郭外行春未尽头。\n又到饥寒愁赤子，忍看琴鹤上孤舟。\n追随征路无穷意，更借飞来几日游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送庄明府考绩之京","author":"李瑜","text":"万户欢腾五裤歌，三年羙锦感民多。\n农耕陇上无收犊，渔卧江头不脱蓑。\n虎渡江灵时雨化，琴鸣单父晓风和。\n追随不觉征途远，儿女情深日易过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别吴东湖以本省大方伯升湖广都宪","author":"李瑜","text":"生民十郡起悲凄，无计留恂驻马蹄。\n怅望紫薇花底月，清光又照楚天西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中夜思二首 其一","author":"郑铭","text":"午夜长风生，撼我庭前树。\n为忆意中人，垂尽青衫泪。\n湘江波浪深，寸缄达何许。\n惆怅空断肠，燃灯达天曙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中夜思二首 其二","author":"郑铭","text":"我愁不可拨，撩乱西山岑。\n援琴出高调，指冷难成音。\n为谋日已拙，岁月日已侵。\n感此坐无言，涕泪飞秋襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"约潮歌","author":"郑铭","text":"窅窅黄云洞，嵂屼厓门山。\n今古潮汐环其间，朝暮嘘吸时往还。\n吐吞乌兔不计岁与月，渔歌欸乃远近明灭芦花湾。\n惠魁老人兴不浅，放步潮头作游衍。\n旦日高歌夕鼾眠，潮神要约同岁年。\n眼空不见天地大，脱略边幅能江边。\n卢肇子，海潮赋，月离日入穷毫素。\n高论自诧极天人，臆说茫茫失其故。\n争似海门封山潮候者，月加卯午亡离舍。\n变化伸缩弦望间，昼夜潮平非假借。\n我之一身备天地，变理师资还二气。\n仁义周流信亦随，睇波洪潮岂其二。\n日月至焉，天地斯异。\n重为告语海潮云，一心与尔同朝曛。\n高楣钜榜终顾諟，便是希夷向上人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"演武亭呈徐兵宪","author":"郑铭","text":"入韵春台已见清，阅兵犹作近郊行。\n六花别出当年阵，细柳真屯此日营。\n金鼓声传千谷应，旌旗影动四山明。\n舒徐五丈原头步，赋得诗成玉槊横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"厓门春浪","author":"郑铭","text":"谁向艰危问死生，厓门忠义即燕京。\n春风吹起祠前浪，直为三仁洒恨声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"象冈秋月","author":"郑铭","text":"辉辉朗月照横坡，风景其如此夜何。\n要识长官新政好，冈头深夜听弦歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别同社黄叔谦","author":"郑铭","text":"何处西风里，萧萧木叶稀。\n游人感秋色，归棹趁寒衣。\n海阔离情远，天空去雁迟。\n相看各无语，红树又斜晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白沙祠堂","author":"郑铭","text":"昆仑万丈来白龙，一亩中有仙人宫。\n草色犹馀楚云碧，莲花别作濂溪红。\n客星无光尘梦远，凤鸟不来吾道穷。\n至今寂寞古祠下，薰人依旧自春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"相逢行","author":"周用","text":"虞卿辍著书，杖策入金台。\n冠盖青云合，轩车紫雾开。\n北杓转西指，西日屡东回。\n如何羁客久，未获介人来。\n千金买斛酒，一日倾一杯。\n酒阑风尘扇，咫尺不相见。\n不见愁此心，山高复水深。\n食玉炊丹桂，囊琴卷布衾。\n驱车卖旧帏，出郭叹斯时。\n忽见鲁连子，走马到何迟。\n慰问不得意，各言前相思。\n举杯酌流水，解琴调素丝。\n一弹渭水怨，再奏西山悲。\n曲路各南北，会面未能期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陈安平掌教 其一","author":"周用","text":"驱车出东门，仙客别行岐。\n索我龙门宝，系我冰蚕丝。\n宝有云霞象，远大以相期。\n丝积日月工，丈疋勉自治。\n命屯宜少忍，道合自有时。\n语壮良多激，意重不敢辞。\n可以报知己，奉之千岁龟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陈安平掌教 其二","author":"周用","text":"君子有所思，所思在远道。\n朝吸天日精，暮挹芝兰草。\n岁月积已多，龙蟠在洲岛。\n时运多变更，鹏起凌苍昊。\n我欲观其人，朝夕在怀抱。\n江汉广且深，一步不可造。\n山岳阻且修，一蹴不可到。\n起来为君歌，殷勤为君祷。\n上寿三千岁，下寿一百考。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意寄盛希道翰林","author":"周用","text":"芙蓉夹岸香风起，遥忆美人千万里。\n有意相逢竟不逢，霞光倒醮秋江里。\n金缸不照别离心，瑶琴独弹清思徵。\n漏滴铜壶五夜钟，声声乾鹊报新喜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村居纪事 其一","author":"周用","text":"举网得鱼日正中，晚禾收穫靠东风。\n杖藜来往闲相语，此日官司卖社翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村居纪事 其二","author":"周用","text":"银弁金钗百万家，万家喧买四停花。\n杖藜来往闲相语，鸽鸟何如变老鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送丘明府考绩之京","author":"周用","text":"颍川称四长，山阴称一丘。\n河阳有王涣，官城有高柔。\n彼美前大夫，嘉行振儒流。\n寂寞千载下，吾侯迈前修。\n试问才何似，太阿切琳球。\n试问量何似，洞庭纳细流。\n试问清何似，玉壶涵霜秋。\n试问明何似，秦台照隐幽。\n农桑沃春野，弦诵冠南州。\n侯骑青骢马，身衣素绮裘。\n遗我山泽叟，欲作国都游。\n追之不可及，挽之不可留。\n环立甘棠下，张望以夷犹。\n祝侯愿侯寿，福与南山侔。\n推忠佐天子，四海均洪休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟次繁昌阻风戏作","author":"周用","text":"江湖五月南风生，北船迟滞南船行。\n南人多在北船上，日日思家万里情。\n起来搔首与天语，愿得广莫良风至。\n人皆笑我违天时，我愿彼苍从人意。\n韩子讼词苦无端，郑弘隆德终能济。\n寄奴登舟风亦转，坡老掷珓风亦还。\n宫亭之神分上下，个个使船郊使马。\n风兮风兮听我语，从我之意解人苦。\n晨转北兮暮转南，两两平分谁恼汝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕","author":"周用","text":"有线难牵日，持杯只对天。\n今霄犹旧岁，明日是新年。\n薄宦居人后，无才只自怜。\n荆妻应念我，与子话灯前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"周用","text":"浊酒一杯自酌酬，囊中不必问提流。\n卑卑此日无高论，秩秩谁人莫大猷。\n李杜那能降巷伯，孙刘似欲拟荆州。\n乘桴未可浮沧海，且揭离骚读远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过江","author":"周用","text":"渺渺烟波江上游，云山四合兴悠悠。\n别辞城市已三日，始觉年光遍九秋。\n聊借便帆成野渡，不须击楫誓中流。\n临行又为东风使，缓步长裾杜若洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"走百病行","author":"周用","text":"都城灯市由来盛，大家小家同节令。\n诸姨新妇及小姑，相约梳妆走百病。\n俗言此夜鬼穴空，百病尽归尘土中。\n不然今年且多病，臂枯眼暗兼头风。\n踏穿街头双绣履，胜饮医方二钟水。\n谁家老妇不出门，折足蹒跚曲房里。\n今年走健如去年，更期明年天有缘。\n蕲州艾叶一寸火，只向他人肉上然。\n去年同伴今希有，几人可卜明年走。\n长安主人肯居停，寂寂关门笑后生。\n但愿中秋不见月，博得元宵雨打灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芝山","author":"周用","text":"驱马登山去，其如高兴何。\n竹书聊寄胜，芝草已无多。\n野树吹黄叶，丹山蔓碧萝。\n同游吾令尹，诗石有人磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送伦殿撰使安南便道还乡","author":"郑一初","text":"载笔螭头远，绥和万里行。\n舟居南海便，衣袖锦袍轻。\n铜柱将军约，沙堤宰相名。\n何时重混合，法从在蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]