[{"title":"武霞纪游 其六","author":"佘翔","text":"缑山长跨鹤，叶县亦飞凫。\n欲采三珠树，还藏五岳图。\n乾鱼传汉峙，小犬吠仙都。\n试问避秦者，于今尚有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19729,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武霞纪游 其七","author":"佘翔","text":"高阁延清眺，千崖气渺茫。\n钟声沉断壑，鸟影曳斜阳。\n倚竹风生籁，听泉月到床。\n胡麻如可饭，未许问沧桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19730,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武霞纪游 其八","author":"佘翔","text":"斋心探道箓，细听步虚声。\n不辨游三岛，焉知驻五城。\n忽悬鲛室泪，翻忆鹿门耕。\n何处安期枣，如瓜饷此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19731,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仙门洞次苏大禹参君韵","author":"佘翔","text":"共有寻真兴，林峦望里微。\n朝乘青雀舫，暮叩白云扉。\n涧水寒侵榻，岩花香扑衣。\n僧来分乞食，信宿欲忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19732,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏扇","author":"佘翔","text":"汉宫纨扇动，人斗绮罗春。\n素手披云叶，青娥媚月轮。\n合欢将锦字，度曲绕梁尘。\n莫作班姬怨，翩翩咏洛神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19733,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日对酒","author":"佘翔","text":"地僻便科发，一杯绿可亲。\n竹林元我辈，河朔更何人。\n却暑挥团扇，迎风岸角巾。\n陶然?酩酊，莫是葛天民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19734,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬日苦雨 其一","author":"佘翔","text":"积雨愁无赖，蓬蒿日掩门。\n炊烟沉北舍，饥鸟噪孤村。\n南亩终何穫，东柯早已髡。\n沉吟空自苦，抚景暗销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19735,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬日苦雨 其二","author":"佘翔","text":"檐前声不绝，枕上听来频。\n乞米空怀帖，披裘那负薪。\n形骸枯欲折，童仆馁生嗔。\n如此萧条色，谁堪原宪贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19736,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同施仲宣黄惟聚尧衢游九鲤湖分得齐字 其一","author":"佘翔","text":"洞壑寻真去，扶筇过莒溪。\n路随青嶂转，人与白云齐。\n灌木寒风冷，閒猿隔水啼。\n具茨何处是，七圣望中迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19737,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同施仲宣黄惟聚尧衢游九鲤湖分得齐字 其二","author":"佘翔","text":"托乘探仙箓，三花驻马蹄。\n泉声喧万壑，云气护层梯。\n采秀骑玄鹿，传书倩碧鸡。\n霞浆堪一醉，扫石待留题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19738,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同施仲宣黄惟聚尧衢游九鲤湖分得齐字 其三","author":"佘翔","text":"瞥见如泥髓，前身岂姓稽。\n湖澄涵白练，山迥接青霓。\n六博仙初聚，三珠鹤并栖。\n水晶帘正捲，吾欲授刀圭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19739,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同施仲宣黄惟聚尧衢游九鲤湖分得齐字 其四","author":"佘翔","text":"倚杖看飞瀑，空山日渐西。\n云中思跨鲤，水底欲燃犀。\n梦觉星初聚，诗成马正嘶。\n避秦还此地，何日重攀跻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19740,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠马聚生 其一","author":"佘翔","text":"大楚雄风起，如云竹马迎。\n地当闽斥卤，官即汉廷平。\n荔子香侵阁，壶公翠入城。\n花关人吏散，坐听鸟嘤嘤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19741,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠马聚生 其二","author":"佘翔","text":"皎皎冰壶月，郡斋乐事多。\n衣沾萱草色，酒对棣华歌。\n一雨苏粳稻，长松映薜萝。\n谢公诗满卷，倘许和羊何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19742,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日题东麓草堂 其一","author":"佘翔","text":"出郭乘青雀，看山坐水湄。\n晴云笼碧树，好鸟啭高枝。\n把酒荷香入，摊书竹影移。\n硕人栖此地，长咏考槃诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19743,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日题东麓草堂 其二","author":"佘翔","text":"池上凉风至，荔枝香满庭。\n凌波双鹭白，捲幔数峰青。\n绮丽追金谷，诙谐得岁星。\n相将?一醉，身世等浮萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19744,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日题东麓草堂 其三","author":"佘翔","text":"青莲花乍吐，长啸一登台。\n芳树摇青盖，轻霞动举杯。\n骚人裁竹箨，浣女摘杨梅。\n为问西园客，谁当绣虎才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19745,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日题东麓草堂 其四","author":"佘翔","text":"地僻便科发，烟霞更可亲。\n何来垂白者，得御草玄人。\n舞蝶窥花幄，游丝绾钓纶。\n溪山堪小隐，莫问武陵津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19746,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿林观察园亭 其一","author":"佘翔","text":"长歌招隐日，别业旧西耕。\n花竹分三径，楼台拥五城。\n云含秋雨色，树带海涛声。\n把酒欢何极，重怜下榻情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19747,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿林观察园亭 其二","author":"佘翔","text":"郭外开精舍，篮舆恣往还。\n虬龙潜巨壑，猿鹤啸空山。\n凿井偏投辖，入林但闭关。\n庭前饶玉树，倘许数追攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19748,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三河舟中","author":"佘翔","text":"漠漠千山雨，飘飘一叶舟。\n东南饶瘴疠，身世任沉浮。\n丧乱吟逾苦，风尘醉亦愁。\n此心关去住，能不愧沙鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19749,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日閒居 其一","author":"佘翔","text":"浮海吾何敢，龙蛇深自藏。\n九章怀屈宋，一榻傲羲皇。\n老乏还丹诀，贫馀辟谷方。\n试听渔父曲，吾道属沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19750,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日閒居 其二","author":"佘翔","text":"艺苑云蒸日，邹枚尚典型。\n登坛名跋扈，倾国色娉婷。\n独笑桑间饿，谁怜泽畔吟。\n朱弦千古调，无梦不湘灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19751,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日閒居 其三","author":"佘翔","text":"削迹浑无事，为园抱瓮劳。\n逢人聊应马，玩世漫持螯。\n洞壑探蝌蚪，江天纵羽毛。\n不知吴市卒，那用姓名逃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19752,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日閒居 其四","author":"佘翔","text":"高蹈非无意，疏慵合废居。\n狂呼厨下酒，奇爱帐中书。\n著述饶蓬鬓，行藏自草庐。\n冥冥鸿鹄举，矰缴竟何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19753,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集宗振宅","author":"佘翔","text":"海上春将尽，开尊兴不孤。\n青山寒击筑，黄鸟间呼卢。\n岁月甘龙卧，纵横学狗屠。\n风尘空荏苒，酒尽更须酤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19754,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"麦斜岩别吴文仲比部","author":"佘翔","text":"何事寻樵谷，空山路转微。\n岳莲飞入座，岩桂扑行衣。\n众壑趋云窦，孤峰对石扉。\n徘徊珠树鹤，明发又分飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19755,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬夜徐茂吴集汪惟一邵长孺汪虞卿于建初寺分得青字","author":"佘翔","text":"寒月照松棂，昙花香满庭。\n偶来沧海客，一缀白榆星。\n妙偈参诗入，微钟杂梵听。\n危楼频徙倚，醉眼落空青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19756,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卧游室为图南题","author":"佘翔","text":"不须穷亥步，一室足徜徉。\n榻上逢宗炳，书中得子长。\n骖云低五岳，吸露驻三光。\n更有凌云梦，天孙赠锦裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19757,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄陈尧勋","author":"佘翔","text":"十里江城路，怀人过五陵。\n交情深尺牍，别梦醒孤灯。\n我已歌衰凤，君还赋大鹏。\n高楼秋月白，尊酒共谁登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19758,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日集普德寺竹林仝林光甫张子明马一卿赋 其一","author":"佘翔","text":"习静投莲社，逃名醉竹林。\n可怜千古事，独契一时心。\n祗树巢幽鸟，繁云结夕阴。\n风来醒客梦，溽暑岂相侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19759,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日集普德寺竹林仝林光甫张子明马一卿赋 其二","author":"佘翔","text":"趺坐对琅玕，空林夏亦寒。\n清斋供野蔌，杂佩纫幽兰。\n灌木鸣蝉静，孤村过雨残。\n支公能爱客，不厌借蒲团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19760,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮马于阶草堂仝钱叔达康孟担作","author":"佘翔","text":"华筵开别墅，坐对菊花香。\n自爱倾醽醁，何须典鹔鹴。\n徵歌多子夜，纵酒得高阳。\n秉烛忘归去，沉沉漏未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19761,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"康元龙招饮草堂分得心字","author":"佘翔","text":"园林秋色淡，置酒傍花阴。\n隔竹寒蝉静，高楼宿雾深。\n图书清玉案，山水和瑶琴。\n踏月听歌去，悠悠子夜心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19762,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鄱阳湖舟中","author":"佘翔","text":"挂帆彭蠡泽，渺渺但乘风。\n日月涵元气，匡庐插太空。\n鸿多遵浅渚，龙自远幽宫。\n何事䲭夷子，飘然类转蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19763,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"海陵除夜仝德夫宗振道昭邦彦作","author":"佘翔","text":"雨雪欺双鬓，天涯那可亲。\n却怜今夜酒，俱是旧游人。\n牛马怀他日，龙蛇蛰此晨。\n新诗裁刻烛，读罢倍伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19764,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日","author":"佘翔","text":"逆旅逢元日，相看总隐沦。\n愁来诗不废，客久鬓如新。\n把钓怀东海，垂衣想北宸。\n江湖浊酒在，一醉任吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19765,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"空囊","author":"佘翔","text":"芳草经春歇，阴云入夏多。\n鹭鸥群水曲，猿狖啸岩阿。\n白发何生理，青山且放歌。\n空囊归未得，倚棹笑蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19766,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中书所见","author":"佘翔","text":"江村日日雨，四月尚衣绵。\n?屋颓沙岸，麦丘尽水田。\n深林喧宿鸟，远浦起寒烟。\n何物禁愁得，杖头乏酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19767,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"至日","author":"佘翔","text":"旅馆逢长至，萧萧雨雪时。\n愁肠添一线，短发乱如丝。\n天地阳初转，风尘泪欲垂。\n此生驹隙过，但罄手中卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19768,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过兰溪投赠胡元瑞兼柬王元美先生","author":"佘翔","text":"十载交游冷，新从縠水过。\n上书违北阙，讲道老西河。\n病久青云薄，愁深白发多。\n郢人今已矣，雪调向谁歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19769,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日仝陈别驾登白鹤峰","author":"佘翔","text":"素节登高处，相看岂故乡。\n乾坤同逆旅，岁月又重阳。\n睥睨孤城暮，潺湲二水长。\n归心浑欲折，篱畔菊初黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19770,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岁暮怀归","author":"佘翔","text":"天涯双鬓改，雨雪岁将徂。\n自笑穷愁老，谁云去住孤。\n诗篇销日月，酒态傲江湖。\n何限还家梦，沧洲一钓徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19771,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李茂承之白下","author":"佘翔","text":"任达云间彦，千秋一季鹰。\n若非君落拓，谁与古凭陵。\n桃叶春风艇，昙花夜月灯。\n六朝多胜迹，幽兴日堪乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19772,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中集洪仲昭楼居仝詹淑正何行吉管象吉殷公觐分得樽字","author":"佘翔","text":"南楼云里迥，星斗若堪扪。\n邀客秋初爽，看山日渐昏。\n雨声寒几席，烛影乱金樽。\n莫问城笳起，新诗坐夜论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19773,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登清水岩","author":"佘翔","text":"鹫岭开云际，扶藜登眺初。\n不知身历险，只觉气凌虚。\n楼观空中尽，松萝象外疏。\n陶然参绣佛，何物是真如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19774,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日怀所知 其一","author":"佘翔","text":"眼看春草色，忽动故园吟。\n入社分僧供，临流听鸟音。\n三洲沧海近，九漈白云深。\n肠断离群者，徒劳梦里寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19775,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日怀所知 其二","author":"佘翔","text":"一春多苦雨，落魄愿多违。\n白雪生明镜，缁尘染素衣。\n溪流清绕舍，竹影乱侵扉。\n若问江湖兴，朝朝咏式微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19776,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"度分水关","author":"佘翔","text":"五载还乡客，嘤嘤鸟恋群。\n往来人渐老，闽越水初分。\n远树含烟瘴，诸天幻火云。\n归心悬落日，处处乱蝉闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19777,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得桐江水寄许才甫","author":"佘翔","text":"碧绿桐江水，羊裘隐在兹。\n滩声流日月，山色拥玻璃。\n林莽供樵爨，烟波理钓丝。\n君家欲洗耳，舍此更何之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19778,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"午日泛舟怀古","author":"佘翔","text":"载酒当佳节，临流感慨深。\n笙歌喧远浦，烟雨散平林。\n抱石千秋泪，怀沙午日心。\n遗风留泽畔，落日想行吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19779,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题君霖六书楼","author":"佘翔","text":"公子开高阁，参差碧汉齐。\n书应工倒薤，帙已映燃藜。\n翼轸光堪摘，匡庐望不迷。\n几人能载酒，时上白云梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19780,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"开元寺对月怀归","author":"佘翔","text":"兰若春晴夜，横空片月新。\n诸天澄素影，初地绝轻尘。\n丧乱长为客，婵娟故恼人。\n青山归去好，莫遣鬓如银。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19781,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"久不得子韩粤中消息怅然有怀","author":"佘翔","text":"无赖炎州客，漂零胡不归。\n天涯双鬓改，岭外尺书稀。\n珠探鲛人室，帆遥燕子矶。\n何时重握手，一醉典春衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19782,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水晶宫有怀","author":"佘翔","text":"白云随杖屦，閒到赤松家。\n倚槛听流水，怀人怨落花。\n游仙长枕石，避世饱餐霞。\n未了浮生事，青门老种瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19783,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊都昌","author":"佘翔","text":"白发甘丘壑，胡为叹转蓬。\n乍看西过雨，旋起北来风。\n尺素思双鲤，扁舟涨片鸿。\n囊中金已罄，那得醉新丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19784,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谼中避暑仝郭次甫龙君善庄静甫汪仲淹潘景升刘季然分得侵字","author":"佘翔","text":"仙源迷咫尺，暂卧白云深。\n阁对悬崖静，庭分灌木阴。\n松涛醒鹿梦，洞壑起龙吟。\n纵饮追河朔，都忘暑气侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19785,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集鼓山寺仝从甫郑尧邻吴道敬吴赞庭陈万里作","author":"佘翔","text":"陶潜栖白社，谢眺赋青山。\n地似藤萝外，人多伯仲间。\n裁诗幽鸟下，移石暮云还。\n但得如渑酒，沉冥学闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19786,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读射阳湖稿赠杨肖韩","author":"佘翔","text":"四杰推杨炯，新诗郢调孤。\n柳移彭泽县，花匝射阳湖。\n丹灶开仙令，沧洲老钓徒。\n骊龙衔片月，应识夜光珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19787,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹅湖馆中别詹修之 其一","author":"佘翔","text":"余向江南去，君为蓟北行。\n舟车含别泪，风雨恋交情。\n燕市初求骏，湘累自采蘅。\n天涯如见月，莫负岁寒盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19788,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹅湖馆中别詹修之 其二","author":"佘翔","text":"一朝复一夕，身世似飘蓬。\n雁度寒云外，莺啼细雨中。\n形骸嗟我老，肝胆与君同。\n岐路愁分手，劳歌思不穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19789,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"建安别诸祖守宪弟道佩","author":"佘翔","text":"仝舟溯建水，岐路别如何。\n旅鬓秋霜短，乡心夜雨多。\n寒鸿依海岛，岩狖啸烟萝。\n回首三江水，何时共钓蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19790,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄赠吴体中明府","author":"佘翔","text":"双凫飞赤县，才子重南金。\n花吐临川笔，风清单父琴。\n千峰澄碧水，片月照寒林。\n未得参禅去，徒怀仰止心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19791,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄贞甫读书灵隐寺禅楼赋赠","author":"佘翔","text":"之子穷经处，高楼拱翠峦。\n龙疑盘洞壑，凤欲啄琅玕。\n星斗挥毫乱，烟霞拂枕寒。\n支床鸡骨在，临别劝加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19792,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集林晋伯霞村别业","author":"佘翔","text":"园林多秀色，载酒趁花朝。\n听鸟凭江槛，看云度野桥。\n曲池含月影，列嶂乱霞标。\n乘兴还过此，无劳折简招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19793,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送林德夫之淮南","author":"佘翔","text":"相逢秋已暮，又尔别夫君。\n千里扬帆去，三山落叶纷。\n吴陵迷夜雪，楚水隔寒云。\n日夕歌丛桂，还招海上群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19794,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭林翼甫","author":"佘翔","text":"闻汝风流尽，青春重可哀。\n江湖愁里隔，形影梦中回。\n片玉埋秋草，孤琴掩夜台。\n天涯交谊在，无计奠椒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19795,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访徐唯起绿玉斋喜陈伯孺僧如翰并至席上怀惟和","author":"佘翔","text":"城隅开一径，曳杖到玄亭。\n山色窗中出，秋声竹里听。\n焚香参绣佛，解佩赠湘灵。\n不尽怀人意，寒云隐翠屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19796,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠松溪昌明府","author":"佘翔","text":"灌坛行雨令，千载复南州。\n制锦花为县，鸣琴月满楼。\n双溪分曲水，五柳繫仙舟。\n我有湛卢兴，何时挟蒯缑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":19797,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]