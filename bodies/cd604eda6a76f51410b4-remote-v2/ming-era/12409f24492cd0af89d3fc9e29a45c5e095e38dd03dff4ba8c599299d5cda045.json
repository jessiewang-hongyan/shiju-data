[{"title":"题月溪卷","author":"陈献章","text":"月出东方白涨溪，溪翁行乐溪东西。\n相思欲过隔溪去，南斗无光北斗低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41878,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠周镐兄弟","author":"陈献章","text":"周生两马齐两鞭，京指长安镐在山。\n今夜尊前看秋月，明年秋月忆尊前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41879,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日 其一","author":"陈献章","text":"山河一望仲秋前，枫叶初黄水半川。\n路上行人不归去，北风吹尔过残年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41880,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日 其二","author":"陈献章","text":"木犀未发奈莲空，小女来方剪綵工。\n不信衰荣是天道，觅花无处怨西风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41881,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阅马氏均田文","author":"陈献章","text":"王侯尚爱橐中装，何况田家弟与兄。\n孟子未知人世事，独将仁义教齐梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41882,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠邓柏林其人貌似伍光宇 其一","author":"陈献章","text":"南山面目偶然同，又向人间见此翁。\n碧罗窗下一杯酒，犹胜良宵梦里逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41883,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠邓柏林其人貌似伍光宇 其二","author":"陈献章","text":"此老若是石曼卿，此山便是芙蓉城。\n高歌独控青骡去，是有风流万古情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41884,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜雨","author":"陈献章","text":"满眼珠玉不足珍，甘雨一洒万家春。\n昨日苍头木洲至，又道木洲饥杀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41885,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"将如东莞闻途中盗发不果","author":"陈献章","text":"扁舟东过扶胥口，一日二日之便风。\n何故三旬不成往，仰船冈下贼旗红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41886,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题朴轩","author":"陈献章","text":"葛洪亦号抱朴子，安知朴翁不是仙。\n莫将甲子编年看，人道翁生大桡前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41887,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题应宪副真率卷","author":"陈献章","text":"今古一杯真率酒，乾坤几个自由身。\n春风回首黄岩会，醉插花枝少一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41888,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"茶园曲寄治香匮袁晖","author":"陈献章","text":"峡东湾湾一水长，商船无日不苏杭。\n千村万落无穷树，尽是袁郎匮里香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41889,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"插花","author":"陈献章","text":"岩前上马兴难拿，卯酒三钟帽半斜。\n两鬓馨香齐插了，赛兰花间木犀花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41890,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访山家次韵 其一","author":"陈献章","text":"樛枝径口郎迎马，语鸟篱前妾扫云。\n笑杀主翁忙出户，手提筐果唤厨人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41891,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访山家次韵 其二","author":"陈献章","text":"清泉煮蕨爱山家，夜饮西岩望月斜。\n涧底白云留不住，半随红雨落天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41892,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"萧黄门书来见责久无书用旧韵答之","author":"陈献章","text":"谏官一字照天涯，南海年年问钓沙。\n沧波不与黄门信，笑杀龙钟百姓家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41893,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"平乡伯陈公以紫茄花绢为家慈寿诗以谢之","author":"陈献章","text":"吴纨衫色紫茄花，老亲着时众口誇。\n小儿奉酒歌七字，持献军门表拜嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41894,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"景云偕范规海上割稻","author":"陈献章","text":"犬子给炊海上舟，范生打浆两同游。\n田中割稻家中望，逢著诸仙莫浪投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41895,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"招讼者归","author":"陈献章","text":"越王城里尘随马，刺史衙前吏喝人。\n此日王孙不归去，旧游芳草可怜春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41896,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋期诸友不至","author":"陈献章","text":"山妻有钱肯沽酒，诸友赋诗期不来。\n范生也逐吾儿去，一夜清光对玉台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41897,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠邝载道之淮阳别驾前御史谪黄岩","author":"陈献章","text":"十年花县眼中人，别驾淮阳又几春。\n曾共乌台高十仞，郑郎今著白纶巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41898,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感事","author":"陈献章","text":"齿本生来不著唇，呶呶众口剧鹅群。\n鼻雷自炒元城耳，夜半钟声那得闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41899,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"木犀四绝寄倪麟 其一","author":"陈献章","text":"正月山桃委地红，柳塘还捲落花风。\n木犀一树浑堪赏，尽日相看烟雨中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41900,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"木犀四绝寄倪麟 其二","author":"陈献章","text":"风雨归来问小奴，药栏花架费人扶。\n黄昏雨歇茅檐月，只有木犀对老夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41901,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"木犀四绝寄倪麟 其三","author":"陈献章","text":"春城无日不思家，风雨经旬损物华。\n竹色四时长不改，平安先报木犀花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","poi