[{"title":"自喜","author":"郑文康","text":"自喜传家物，传家有旧编。\n当时修谱者，特记孝宗年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕","author":"郑文康","text":"东家火树夜光飘，堂上春寒向晚消。\n楚舞吴歌盈耳目，千金一刻度良宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿车塘张氏馆","author":"郑文康","text":"县城寒漏雨中沉，江馆无人醉拥衾。\n年少书生岂陶谷，肯因一笑费千金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题赵仲穆出猎图","author":"郑文康","text":"骏马胡鹰万里天，飞尘一道暗如烟。\n清平正好调弓马，莫为从禽学少年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山斋","author":"郑文康","text":"山斋无事乐忘饥，姓氏何须太守知。\n有客叩门惊犬吠，若非求药定求诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新酒初熟约徐宽共尝候久不至","author":"郑文康","text":"群鸦飞尽月黄昏，不见人来共酒樽。\n坐久隔墙闻犬吠，桂花香里又开门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日读书树下","author":"郑文康","text":"高树凉风落翠阴，古诗三百治平音。\n壮年且尽双瞳力，莫为功名易动心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔樵问答 其一","author":"郑文康","text":"妻子同舟钓浪花，晓行淮浦暮长沙。\n采薪只在深山里，得似江湖处处家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔樵问答 其二","author":"郑文康","text":"担头春酒一瓢多，树底看山树底过。\n谩说江湖妻子乐，几人失脚在风波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27065,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾刑部韵","author":"郑文康","text":"杜陵花竹怨离居，驿使遥传日下书。\n啼断西风原上鸟，海天愁思正纷如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏鹤","author":"郑文康","text":"丹顶玄裳雪羽衣，水边石上最相宜。\n清高不入樊笼里，只许仙人渡海骑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄徐叶祥","author":"郑文康","text":"南州高士有佳儿，清节虽贫亦自持。\n闭户读书多岁月，不将名姓向人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春园","author":"郑文康","text":"柳眼茶芽总未抽，满天云意叫寒鸠。\n辘轳罢转人踪静，不是春天是晚秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刺牡丹","author":"郑文康","text":"名花不入小家园，岁岁花时沸管弦。\n只恐春风容易过，邻翁耕作种瓜田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客中闻弟病","author":"郑文康","text":"家书无雁到京迟，两月沉疴近始知。\n莫是劳心思远客，夜窗多诵鹡鸰诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贫儿","author":"郑文康","text":"哀哀枕上泪成冰，哭入长更不忍听。\n子母同眠犹较可，阿婆独宿更零丁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄海上韩杲","author":"郑文康","text":"一纸相思托便鳞，客乡人寄故乡人。\n看花深忆山中乐，只恐归迟不见春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送洪彦章致仕还括苍","author":"郑文康","text":"壮年游宦晚年休，落尽红颜渐白头。\n别郤江湖风浪险，扁舟归去入安流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题西溪书舍倒用韵 其一","author":"郑文康","text":"东家歌舞隔花阴，日夜欢情似海深。\n独有西溪隐君子，一编探尽圣贤心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题西溪书舍倒用韵 其二","author":"郑文康","text":"富贵功名不动心，数掾遥在百花深。\n先人手种庭前树，长得孙枝满地阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题静室","author":"郑文康","text":"静中风月静中身，不见长安市上尘。\n自分封侯无骨相，只应终老作闲人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题静室","author":"郑文康","text":"饥采松苓渴饮泉，静中最喜日如年。\n衣冠不接闲宾客，只向诗书接圣贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与谢素庵酌酒","author":"郑文康","text":"廿年易过似流星，对酒怜君已暮龄。\n旧事凄凉半陈迹，一场春梦不堪听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲戌岁","author":"郑文康","text":"陇头一夜雪平城，海口潮来水就冰。\n百岁老人都解说，眼中从小不曾经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晨兴","author":"郑文康","text":"一宵酣睡不曾醒，忽见东窗日已明。\n自笑起迟非中酒，为无人解报鸡鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"药名诗赠郑完 其一","author":"郑文康","text":"草果堆盘酒满觞，羹调五味郁金香。\n谁言没药延亲寿，炼得灵砂贯众方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"药名诗赠郑完 其二","author":"郑文康","text":"使君有子正乌头，双眼空青气伏牛。\n半夏里来知母健，忍冬归去亦忘忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"药名诗赠郑完 其三","author":"郑文康","text":"有客回乡赋白驹，怕将薏苡混珍珠。\n道园稿本君家刻，只载车前百部书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"药名诗赠郑完 其四","author":"郑文康","text":"紫苑雕残百草霜，醉骑海马送宾郎。\n红娘敲折金钗股，笑对王孙续断腔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送马绍荣补学官弟子","author":"郑文康","text":"有客新从泮水游，誓将刀笔换公侯。\n若非正学叨封拜，终落功名第二筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送马绍荣补学官弟子","author":"郑文康","text":"临轩天子觅真儒，郕国遗编第一书。\n君去尽心须尽读，好携十传赴公车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安闲","author":"郑文康","text":"脱却朝衫制芰荷，芙蓉亭上啸还歌。\n生来骨相知轻贱，长得安闲幸已多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"唤渡","author":"郑文康","text":"渡头风急水生波，客路归心向晚多。\n唤出小舟行不上，隔江无奈雨来何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"唤渡","author":"郑文康","text":"白浪浮空散作花，荡舟食力度年华。\n行人不用愁风雨，过得江来似到家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观烧劫图","author":"郑文康","text":"福严寺里秃鹙儿，不竖幡幢竖贼旗。\n白昼杀人凭佛力，严沙沟变火坑池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观烧劫图","author":"郑文康","text":"烧劫谁能作画图，南阳壮士手亲摹。\n官兵一出髡郎死，满县歌声听鹧鸪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题杂画 其一","author":"郑文康","text":"直道难容竟独归，离骚赋罢泪沾衣。\n魂灵不逐湘流逝，还向怀王殿上飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题杂画 其二","author":"郑文康","text":"自古含容解弭灾，将军从此负荆来。\n早知一饭三遗矢，悔不当初谢郭开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题杂画 其三","author":"郑文康","text":"才逢生客便呼郎，仙女风情想未忘。\n莫笑思家轻出洞，家中自有旧糟糠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题杂画 其四","author":"郑文康","text":"恨无顾恺刺心针，担负风流仗酒醺。\n谁料邻家机上女，怀春不似卓文君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题杂画 其五","author":"郑文康","text":"追忆蒲鞭汉大夫，扑刑虽用得完肤。\n郤怜东鲁臧孙氏，不去鞭蒲去织蒲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题杂画 其六","author":"郑文康","text":"壮士轻生易许人，图谋未遂已亡身。\n明知一去无还理，底事狂歌竟入秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题杂画 其七","author":"郑文康","text":"弱水蓬山几万重，仙宫未必胜秦宫。\n君王轻听齐人语，空驾楼船入海中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题杂画 其八","author":"郑文康","text":"史传荒唐怪事多，乘槎那得上天河。\n不知织女支机石，遗落人间竟若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192f