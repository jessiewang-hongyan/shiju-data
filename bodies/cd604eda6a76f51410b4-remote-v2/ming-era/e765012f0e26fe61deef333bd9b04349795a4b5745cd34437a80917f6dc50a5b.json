[{"title":"答浙客","author":"韩邦奇","text":"怜君风雪入潼关，斯世茫茫行路难。\n尔是浙人应自悉，萧萧生事比君寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钓台 其一","author":"韩邦奇","text":"江上双台俯白云，子陵风节古今闻。\n皋夔熙绩唐虞世，精一相传在典坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钓台 其二","author":"韩邦奇","text":"华山长卧堕驴翁，功成海外虬须老。\n天下已属赤符人，惟有桐江一丝好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹　题宗元画轴","author":"韩邦奇","text":"劲节虚心本自奇，四时常见绿猗猗。\n笑他江上罗浮树，只放寒花三两枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅答宗元","author":"韩邦奇","text":"凌霜傲雪不凡才，直到严冬烂熳开。\n不为春光便改色，莺莺燕燕莫相猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢却洪尹赠金","author":"韩邦奇","text":"洪尹高情太古音，艰危昏夜赠行金。\n为仁君子存颠沛，不是当年伯起心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鲁桥神","author":"韩邦奇","text":"尸素何曾有寸劳，虚名空使万民谣。\n圣朝法度山难转，不似仙神在鲁桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉翁亭","author":"韩邦奇","text":"滁阳天外数峰青，暮带云霞似画屏。\n每向离骚悲楚客，何心更上醉翁亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偕邃谷子登映江楼","author":"韩邦奇","text":"秋风遥上越江楼，两岸云山共别愁。\n日暮海门潮正急，烟生沙碛树如浮。\n襟期此日还看剑，尊酒他乡且系舟。\n梅岭古来多瘴厉，南行敢说是奇游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再过邃谷子","author":"韩邦奇","text":"暮雨江头使节来，茅斋一醉菊花杯。\n连朝案牍惭吾俗，今代文章羡子才。\n落木荒云秋色远，孤城寒角夜声哀。\n相看俱是天涯客，此地过从更几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邃谷将行话别","author":"韩邦奇","text":"十年海上谩相逢，坐对清尊听晚松。\n长路风尘悲逐客，南荒礼乐见儒宗。\n看山是处还三宿，去国无心更万钟。\n圣主即今思化理，未应直道独难容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再会邃谷观潮阁二首 其一","author":"韩邦奇","text":"万山落木望萧萧，久客殊乡倍寂寥。\n对景益增离思苦，望云空有梦魂遥。\n蒹葭淩乱江风白，岛屿微茫海气消。\n尊酒明朝与君别，相思何处独闻箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再会邃谷观潮阁二首 其二","author":"韩邦奇","text":"落日招提上，西风越海边。\n浩歌闻野牧，长笛隔离筵。\n庾岭千山瘴，蓝关万里天。\n北归吾未卜，相对一潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会邃谷子天然阁 其一","author":"韩邦奇","text":"三吴佳丽地，高阁一开扉。\n鹫岭开图画，松关入翠微。\n江潮冲雨下，木叶带云飞。\n海国相逢几，年来故旧稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会邃谷子天然阁 其二","author":"韩邦奇","text":"烟雨秋江上，关河故国思。\n开尊疑梦寐，执手惜暌离。\n远道风尘恶，他乡岁月迟。\n潮阳何日见，不愧读韩碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会邃谷子天然阁 其三","author":"韩邦奇","text":"灯火湖边寺，相看夜欲阑。\n海云松影暗，风塔铎声残。\n饭出胡麻供，更消金秤丸。\n诗成僧入定，山月正团团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会邃谷子天然阁 其四","author":"韩邦奇","text":"霜雁惊乡思，星槎望海门。\n欲归还觅句，既醉复移尊。\n说法听山鬼，行歌答岭猿。\n明朝即城市，此意共谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会邃谷子天然阁 其五","author":"韩邦奇","text":"月出千山白，风高万壑哀。\n沧江连海阔，飞阁倚云开。\n贫病秋还客，登临夜复杯。\n天涯几知己，候吏莫相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留邃谷子","author":"韩邦奇","text":"江头忽报理行舟，急策征骖向子留。\n满眼黄花近佳节，数声白雁过高秋。\n越王台上可登眺，和靖祠前多倡酬。\n且尽渭城一杯酒，钱塘南去揔离愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日约邃谷子饮邃谷子游胜果寺余二人不能从","author":"韩邦奇","text":"昨宵风雨是重阳，满地黄花笑客忙。\n飘泊遥怜知己在，登临谩逐野僧狂。\n白衣负我东篱约，乌帽从渠短发苍。\n湖上秋光未零落，不妨小艇载清觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登保俶寺　钱越王俶入朝于宋国人建塔祝其来今其塔相传为保俶寺因以名 其一","author":"韩邦奇","text":"百尺浮图上碧霄，登临此日忆前朝。\n夕阳天外千山暮，秋海江头八月潮。\n社稷有臣挥痛泪，君王何事树降标。\n当年城郭分明在，十里长塘见野桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登保俶寺　钱越王俶入朝于宋国人建塔祝其来今其塔相传为保俶寺因以名 其二","author":"韩邦奇","text":"封疆吴越百年传，一渡长江竟不还。\n北望犹存萧寺塔，南归曾见御函笺。\n秋深宫殿迷寒草，日落湖山起暮烟。\n千古兴亡回首梦，清尊相对重悽然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邃谷将行饯之二首 其一","author":"韩邦奇","text":"秋江两月驻行旌，一度相过一度情。\n明日即为南去客，临岐数问北归程。\n霜红越树重城隔，云黑蛮溪万里行。\n人世生离今夕是，谩同尊酒叹浮萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邃谷将行饯之二首 其二","author":"韩邦奇","text":"夜静潮鸣阁，江空月影寒。\n一尊成远别，万里愿加餐。\n不愧三龙水，深惭七里滩。\n播迁吾道在，共说报君难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别梅溪 其一","author":"韩邦奇","text":"才喜逢君又远违，海乡相对思依依。\n风高古木猿声急，霜落寒江雁影稀。\n共向离歌悲祖席，不堪别泪点征衣。\n关河万里滇南道，我独驱驰驷牡騑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别梅溪 其二","author":"韩邦奇","text":"痛饮新联兴转豪，还惊秋色下庭皋。\n雨过丛菊开金苑，风入长林动碧涛。\n山对小楼峰似戟，潮生沧海水如刀。\n天涯零落绨袍在，一事无成早二毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岳坟","author":"韩邦奇","text":"武穆祠前落叶秋，悲风长夜起松楸。\n精忠万古南枝在，遗恨无穷汴水流。\n凤阁谁为天子诏，龙沙空抱上皇忧。\n舆图竟付东窗计，寂寞崖山一叶舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒庙","author":"韩邦奇","text":"古柏高秋露气寒，桥门初日集儒冠。\n万年制作从周礼，千仞宫墙拜汉官。\n自是圣朝多化雨，还看吾道障狂澜。\n迂疏愧我真无补，山斗于今正仰韩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松崖方都宪号","author":"韩邦奇","text":"乌石山高隔世尘，长松郁郁八千春。\n暖云不断灵脂结，晴雪初乾老干新。\n万木惟应梅作使，孤根还许竹为邻。\n山腰松下茅堂小，中有高翁乐性真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜话","author":"韩邦奇","text":"小坐依脩竹，新凉涤素襟。\n残砧秋戍外，长笛越江浔。\n一客惊蓬鬓，孤灯共此心。\n相看清漏尽，月转碧梧阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阅城","author":"韩邦奇","text":"东南论胜地，吴越此名邦。\n天险连三省，城高带二江。\n貔貅明剑戟，虎豹拥旌幢。\n万国车书一，寰瀛气自降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登天宁寺","author":"韩邦奇","text":"石磴层云出，风林百鸟啼。\n秋阴花外转，午院竹边低。\n野兴逢僧发，狂怀共客题。\n浮踪今两浙，归梦自关西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜归宿公署","author":"韩邦奇","text":"竹光明夜露，湖影浸秋城。\n月白千家静，霜寒九陌清。\n山舆归路并，风榻客窗横。\n千古陈雷意，相从幸此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"索户部夜话","author":"韩邦奇","text":"寒雨响檐溜，孤灯共夜堂。\n乡愁闻海柝，旅况对春觞。\n远别匆匆话，浮生处处忙。\n相看浑不寐，江戍漏声长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慧岩将赋归小酌话别 其一","author":"韩邦奇","text":"海内论英俊，如君复几人。\n还林非倦翼，纵壑愧修鳞。\n别意春江暮，孤怀夜月新。\n寄声频托雁，千里见情真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慧岩将赋归小酌话别 其二","author":"韩邦奇","text":"庭竹暝烟乱，江云野鹤还。\n山光梁水外，鸟哢武林间。\n得著先收局，耽春欲问山。\n悬知非俗驾，世路自漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慧岩将赋归小酌话别 其三","author":"韩邦奇","text":"多难知交谊，离筵倍感怀。\n江山真得友，花鸟欲忘骸。\n圣代恩波阔，高名物理乖。\n先机今勇退，尘绊愧吾侪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慧岩将赋归小酌话别 其四","author":"韩邦奇","text":"云净天光远，江空别意长。\n骊歌闻柳外，祖席醉花旁。\n夜雨他年梦，巅崖此日缰。\n欲归归便得，洛渭正沧沧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将适双溪","author":"韩邦奇","text":"江上楼船待客归，山城尊酒且依依。\n宦途岁月他年梦，乡国田园昨日非。\n露冷槿花闻雁度，风牵荇带忆鲈肥。\n淹留不觉秋宵永，漏尽寒谯月满扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别慧岩","author":"韩邦奇","text":"满江风雨解离舟，病客难禁万斛愁。\n欲去为君仍水宿，重来共我一山游。\n多情衢婺诗篇在，过眼莺花岁月浮。\n脉脉尊前不成醉，海天苍莽是杭州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中　徐东岩御史 其一","author":"韩邦奇","text":"多病亲三木，虚名有四知。\n何能酬圣主，深愧负明时。\n月落寒砧急，秋高夜漏迟。\n推枰听鸡唱，故国动相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中　徐东岩御史 其二","author":"韩邦奇","text":"南省名曾并，西台罪有馀。\n身如罝里兔，命似釜中鱼。\n痛哭怀宣室，佯狂问卜居。\n古今一生死，吾道竟何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中　徐东岩御史 其三","author":"韩邦奇","text":"窗外萧萧叶，阶前唧唧蛩。\n夜深人寂寞，天迥月朣胧。\n愚直逢明世，狂言渎圣聪。\n拘幽皆自致，敢谓小臣忠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅溪赴滇南","author":"韩邦奇","text":"吴江秋雨正潇潇，江上离愁黯不消。\n万里云山初解缆，十年京国几联镳。\n乡情不尽阳关酒，客梦还惊越海潮。\n万里滇池俯金马，征鸿渺渺暮天遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中 其一","author":"韩邦奇","text":"月华如水近中天，脉脉相看夜不眠。\n湖海萧条家在越，风尘荏苒客居燕。\n先几今已惭张翰，小雅曾闻悼马迁。\n此夕感时多少泪，尽随旅梦入云烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中 其二","author":"韩邦奇","text":"圜土无人昼掩扉，西风吹送雨霏微。\n愁随落叶萧萧下，心逐行云片片归。\n万死宁嫌同草木，一官原不为轻肥。\n平生点检知无愧，尘世何劳较是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中 其三","author":"韩邦奇","text":"两鬓萧萧百病攻，天涯秋尽且飘蓬。\n半篱残雨催寒菊，几树酸声下晚松。\n愁入梦魂归故里，身无羽翼脱樊笼。\n阴房寂寂人踪少，白日时看鬼火红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中 其四","author":"韩邦奇","text":"重门深锁一灯昏，十载交情此夜论。\n谏草问君焚几度，穷途见子谪三番。\n疏窗时有惊风入，晚树犹闻宿鸟喧。\n咫尺尧天传玉漏，圣明不久布洪恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中 其五","author":"韩邦奇","text":"落叶西风过短墙，远林疏雨递微凉。\n三秋松菊乡园在，五夜关河客梦长。\n世事了知棋一局，年华空负酒盈觞。\n与君欲学东山卧，十载君恩讵敢忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中 其六","author":"韩邦奇","text":"瞽言无补圣明时，几箸冰鲜万姓脂。\n两浙口碑遐迩见，百年心事鬼神知。\n茫茫谁识成周礼，默默惟观易卦辞。\n灯下相看成一笑，铁交窗外冷风吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中 其七","author":"韩邦奇","text":"千里寒城起暮烟，蛩声断续恼人眠。\n披衣坐对青灯暗，步月愁看白雁还。\n永夜床头周易在，羁怀云外蜀山连。\n夏黄记取当年事，闻道应知愧昔贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中怀程以道","author":"韩邦奇","text":"一别茫茫近十年，偶来手字墨犹鲜。\n殷勤始见交游谊，激切时闻谏议篇。\n泾野联镳秋色晚，幖山对榻雨声连。\n知君此夜相思梦，定绕圜扉碧树烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中怀吕道夫","author":"韩邦奇","text":"如君乡国最心知，咫尺空劳两地思。\n何日论文重对酒，今宵遣兴且凭诗。\n秋深青琐愁多少，月落沧江梦几时。\n况是艰危佳节后，黄花寒雨满东篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中怀曾东石","author":"韩邦奇","text":"少岷清瘦近如何，云树相思病转多。\n别后诗篇今几帙，秋来风雨忆重过。\n青春已负前年约，明月应怜此夜歌。\n生事茫茫各萍梗，几回搔首叹蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"言别","author":"韩邦奇","text":"京华一别七年过，忽讶相逢在网罗。\n月落梧桐疑是梦，夜阑风雨不成歌。\n平生许国心还壮，此日分襟恨转多。\n去去相期各努力，敢将衰朽负贤科。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"满江红　广武道中","author":"韩邦奇","text":"漠漠霜天，孤城下、九秋时节。\n飘零处、寒灯独照，荒山几叠。\n渺渺长空哀雁叫，凄凄野戍悲笳咽。\n望秦川、今夜到明朝，头应白。\n来时候，柳可折。\n才回首，流芳歇。\n叹玉关人老，岁光奔迫。\n代马踏残青海草，塞风吹落云中月。\n愧浮沉、今已负平生，应悲切。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金菊对芙蓉　阅兵雁门登城","author":"韩邦奇","text":"楼起层城，城蟠绝岫，旌旄上拂云天。\n看龙蛇阵绕，虎豹关严。\n班声一喏桑乾沸，青霄外、震裂恒山。\n有英雄骁将，黄金绣铠，白玉雕鞍。\n北望杀气腾腾，更飞霜漠漠万里行。\n遥把壮心，引动鼙鼓填然。\n合当痛饮黄龙府，纵兵十日，蒐畋好生擒开罕。\n招徕冒顿，约束楼兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"满江红　哀仲礼","author":"韩邦奇","text":"四野停云，哀猿哭、潇潇渭水。\n伤心处、青山雨歇，白杨风起。\n十二楼中谁是主，三千门下空珠履。\n想当时、雪夜渡冰舟，成何济。\n五经义，十九史。\n班马才，关闽志。\n但萋萋荒冢，寒莎遍地。\n长夜沉沉何日晓，绵绵此恨何时已。\n看穹碑、历历写衷肠，千行涕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"踏莎行　 赵氏二子仲典仲礼皆以奇童称仲典十七秋试归病于途死仲礼十九秋试归病于途死二子生时其母梦紫龙入室即飞去人见二子奇特谓必大成皆夭殁异矣","author":"韩邦奇","text":"绿柳沙迷，白楼烟袅。\n莎青花落鹃声杳。\n紫龙两两没遥天，双双玄鹤归华表。\n子建才高，甘罗年少。\n论经纶、那有君怀抱。\n竟一抔黄土掩英贤，想九原，痛恨乾坤老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"满江红　吴中秋","author":"韩邦奇","text":"时序惊心，庭皋下、梧桐一叶。\n才回首、春光几许，早来秋色。\n遥忆去年燕市酒，忽看今夕吴中月。\n最飘零、无定似浮萍，功名客。\n江千折，山万叠。\n壮志寒，归心切。\n算人间业帐，何时了绝。\n百岁奔忙愁里过，楚台汉冢君知得若。\n待黄粱、梦醒始知休，真痴惑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"踏莎行　春思","author":"韩邦奇","text":"梦转红英，愁生绿绮。\n小窗独对应无语。\n雨馀花气细侵帘，画梁燕子双飞去。\n情绪千端，家山万里。\n乡心不为功名系。\n沉云重隔华山青，长河不断空流水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"满江红　客思","author":"韩邦奇","text":"雪浪连天，还几阵、阴风怒作。\n正此际、潮生越海，吴江枫落。\n万里孤舟渔火对，满山溟雨滩声恶。\n纵瓶中、有酒洌如泉，那堪酌。\n愁似海，心如烁。\n多病体，难支阁。\n说海棠开了，便酬初约。\n七夕重阳都已过，楚台空负朝云合。\n望长安、云树阻归程，成萧索。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"踏莎行　盟台","author":"韩邦奇","text":"落日荒荒，停云脉脉。\n行人共指盟台说。\n相如曾此挫强秦，汗青万古称豪杰。\n韩信兴刘，陶朱霸越。\n英雄自有谋王策。\n当时一怒顾长刀，将军颈上空流血。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉楼春　客中春","author":"韩邦奇","text":"槛外桃花红似血。\n岸上柳条青可折。\n美人何处春醉眠，独倚高楼看明月。\n楼上玉箫声断绝。\n江上琵琶还惨切。\n夜深风送海潮来，回首秦关肠欲结。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"踏莎行　韩信庙","author":"韩邦奇","text":"高岭连云，繁烟带雨。\n长杨满路悲风起。\n将军墓上草萧萧，荒祠白日眠狐鼠。\n九里山前，未央宫里。\n凄凉往事烦胸臆。\n乌江汾水两悠悠，东流不尽英雄泪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]