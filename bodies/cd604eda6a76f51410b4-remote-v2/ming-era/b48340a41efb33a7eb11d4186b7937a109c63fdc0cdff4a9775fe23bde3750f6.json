[{"title":"螺源诗社为陆肖静明府题","author":"卢龙云","text":"林园觞咏几相将，物外逍遥乐正长。\n水自青螺环胜概，人俱白凤吐文章。\n千秋已共归耆社，百里还应让醉乡。\n江月溪花堪寄傲，品题何地不奚囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏杪镇海楼宴集","author":"卢龙云","text":"驱逐风尘岁月虚，临高几度望乡馀。\n楼头落日重披宴，树杪凉飙复振裾。\n暌别每愁书札远，合并休放酒杯疏。\n山林此地依城郭，耽僻何须问井墟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答廖隐君三首 其一","author":"卢龙云","text":"何处远寻高士宅，喜君就我拂云和。\n好文久自成玄草，断酒年来息白波。\n开径但招耆作社，安车宁慕礼为罗。\n风尘似我空驰逐，得比衡门乐事多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答廖隐君三首 其二","author":"卢龙云","text":"结束当年诣阙行，侵寻法署共持平。\n无冤活狱惭张尉，旧学传经仗伏生。\n休沐暂随田舍会，篇章谁似鬼神惊。\n高门异日君家事，已见孙枝迭向荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答廖隐君三首 其三","author":"卢龙云","text":"齿德由来重月评，词坛兼羡一鸿生。\n平反我愧文无害，恬寂君方觉有情。\n玄论几看围屡解，白头宁道盖初倾。\n阶庭雨露多兰玉，一任儒林自著声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈观察请告暂归温陵","author":"卢龙云","text":"福星才傍岭云高，湖海元龙气尚豪。\n每到秋风偏忆鲙，更思凉月共持鳌。\n鹏抟暂息垂天羽，骥伏难辞历国劳。\n归去东山宁久卧，徵书即拟下蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林郡丞入觐二首 其一","author":"卢龙云","text":"佐郡一隅方展骥，朝天万里且鸣驺。\n遐荒每藉承宣重，治行常从抚字优。\n竹虎分猷劳暂摄，玉麟专使更何求。\n赐金阙下仍增秩，遮莫儿童待细侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林郡丞入觐二首 其二","author":"卢龙云","text":"万方玉帛归双凤，两地苍黔恋五羊。\n愧我金城曾种柳，多君南国尚留棠。\n褰帷满听循良颂，趋陛依然太守章。\n简在只今询异等，承家况复有青箱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘氏真隐园","author":"卢龙云","text":"岩峦幽窕树扶疏，中有高人自结庐。\n地僻了无关势利，身閒端合混樵渔。\n鸿冥独振云逵羽，龙卧偏宜水竹居。\n莫笑刘郎仙洞远，青苔白石岂全虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋玩月值文闱试士日答廖文学二首 其一","author":"卢龙云","text":"秋光才满习家池，有客新篇更陆离。\n胜赏谩宜方外侣，浮名休羡里中儿。\n诗成珠玉当谁和，忧在江湖只自知。\n到处楼头增夜色，樽开且续屡传卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋玩月值文闱试士日答廖文学二首 其二","author":"卢龙云","text":"露气初寒凭槛外，月华高映举杯前。\n新晴雨洗看逾洁，入夜云开望独圆。\n索处未应甘抱寂，满庭无奈正连娟。\n豪吟已为秋生色，顾影何须只自怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘令公入觐","author":"卢龙云","text":"飞凫两度入朝天，屈指南来及五年。\n牧事已成荒徼外，主恩长恋未央前。\n御屏书以循良重，舆论推应侍从先。\n寄语山阴诸父老，可能重借使君贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿潘孺人七十光禄子朋之内子也","author":"卢龙云","text":"曾拜天书耀翟冠，归来总羡一枝安。\n仙坛授箓传青鸟，侍女吹笙应紫鸾。\n洛涘閒居耆社集，家园周览鹿门看。\n金茎分露多兰玉，酒脯何劳忆大官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋晚梁园饯别陈孝廉兄弟北上分得东字二首 其一","author":"卢龙云","text":"梁园赋客一樽同，多少心期别酒中。\n云里凤毛看颉颃，斗间龙气识雌雄。\n齐名烨烨三珠树，蹑影翩翩几玉骢。\n江左青箱元共习，承恩堪并建章宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋晚梁园饯别陈孝廉兄弟北上分得东字二首 其二","author":"卢龙云","text":"萧萧万木起秋风，共向山厨荐晚菘。\n客路远冲枫叶赤，曲江春待杏花红。\n双龙色借林霞外，三凤祥呈海日东。\n伫听京华消息好，孙枝方信长高桐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答车一中明府","author":"卢龙云","text":"辞荣得早遂樵渔，秫酿方饶百斛储。\n坐有车公堪共乐，歌齐郢里更谁如。\n尘中暂许随高会，花外时劳望小车。\n却笑王程催道路，可能长日奉篮舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿林乔化明府","author":"卢龙云","text":"早岁辞荣访赤松，林泉乐事得相从。\n归来正似陶彭泽，引去何惭邴曼容。\n真率渐成耆社会，优游好袭醉乡封。\n閒居日就千秋业，翻笑尘游少定踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄太史看菊有述见示赋答","author":"卢龙云","text":"猎猎阴风已戒寒，萋萋林卉各凋残。\n惊看红叶年垂暮，喜对黄花露始团。\n感物长吟俱寡和，怀人独酌不成欢。\n玉堂仙客元非远，安得东篱共夕餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送宪使刘公入觐","author":"卢龙云","text":"宪府新开粤海隅，朝天旋复赋骊驹。\n小春物候菊萸晚，肆觐身先玉帛趋。\n王事固应怀靡及，臣劳端不负长驱。\n依刘赤子心元切，秉钺重来望未孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日初晴登镇海楼历粤秀诸山同张孟奇计部黄士明太史分赋二首 其一","author":"卢龙云","text":"乘閒结伴蹑丹梯，海晏天清望不迷。\n城倚粤台开杰阁，地邻萧院叩禅栖。\n云山极目千愁豁，烟树平临万象低。\n每叹词盟羁宦远，壶觞何幸得同携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日初晴登镇海楼历粤秀诸山同张孟奇计部黄士明太史分赋二首 其二","author":"卢龙云","text":"北风猎猎袷衣寒，雨后山川此际看。\n赋美大夫来倚马，行从古道入呼鸾。\n登临自喜逢三益，并合何须羡四难。\n胜赏淹留将竟日，归来已任夕阳残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿潘子迁五十并举第三子","author":"卢龙云","text":"谁兼富寿与多男，最是君家乐且耽。\n百岁光阴甫强半，一楼花萼渐成三。\n冈陵颂溢安仁赋，龙凤名高浚仲谈。\n不尽犀钱娱燕喜，桂丛偏近菊花潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兰亭祓禊图","author":"卢龙云","text":"何处群贤开胜会，流觞竟日洽幽襟。\n永和岁月传修褉，曲水朋游美盍簪。\n谁解才情追逸少，由来盛事只山阴。\n茂林峻岭依然在，岂乏词人续咏吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答麦养明处士","author":"卢龙云","text":"久逐风尘驱道路，暂来休沐出郊畿。\n少微自动烟霞色，南极长悬涧壑辉。\n旧德镇浮轻组绶，新篇寄远尽珠玑。\n凤雏已长丹山翮，伫见层霄向日飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柏谷长春卷","author":"卢龙云","text":"苍苍乔木出云岑，翠柏干霄始十寻。\n直干栽培根已厚，高枝雨露沐逾深。\n岁寒并茂惟松径，地近连芳有桂林。\n若比汉家梁作咏，何如中谷自清音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为张太学寿其外舅萧刺史","author":"卢龙云","text":"东风吹绿映霞杯，喜傍芳丛绮席开。\n人自三朝歌寿考，官从五马赋归来。\n冠裳郡国宾筵重，兰树阶庭世泽培。\n子婿更看兼玉润，丈人安坐进春醅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄太史卜居仙湖里冯君奇索赠","author":"卢龙云","text":"凤山山下昔枌榆，江抱如龙宅一区。\n韦杜城南今托始，谢王江左远相符。\n堂垂燕翼昌诗礼，阙拜龙章杂紫朱。\n可奈直庐天尺五，每悬卜筑在仙湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为刘生题日升图赠杨郡丞","author":"卢龙云","text":"海门朝旭映扶桑，指顾辉腾被八荒。\n云影三山连浩渺，波光万里出苍凉。\n川原在处皆生色，草木何心亦向阳。\n莫笑野夫贪曝背，由来普照尽穷乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送柯国博之任岳州司马","author":"卢龙云","text":"殷勤相送出江滨，草色波光及暮春。\n三楚风流新佐郡，百年礼乐旧成均。\n情悬桑梓应同切，心为苍黔亦已频。\n政暇岳阳多览胜，勋名还拟范公伦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答刘左史有序","author":"卢龙云","text":"玩世优游八十年，寻真杖屦且飘然。\n春光载道花如锦，紫气临关月正弦。\n五岳壮游过尚子，一经世业本韦贤。\n独沉似我君频顾，记忆何由到日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"余比部林廷评将应召入京赋别二首 其一","author":"卢龙云","text":"相携杯酒送临岐，共喜君王结士时。\n公望久推青琐闼，赋才新起白云司。\n向来吏绩徵三异，此去臣谟集众思。\n圣德岂须论庆历，拔茅堪上进贤诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"余比部林廷评将应召入京赋别二首 其二","author":"卢龙云","text":"何来棘署暂相随，辄为徵书念远离。\n旧雨转成今雨叹，法星聊旁客星移。\n辟门近事光虞典，簪笔明廷复汉仪。\n秋好有奇知共吐，八行须及雁南时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答钱五卿郡丞","author":"卢龙云","text":"虞山琴水隔风烟，屈指离亭十八年。\n时拟听莺仍拜阙，岂应携鹤遂归田。\n遗荣逸意游云外，求旧徵书待日边。\n诗卷茶炉知念我，山阴难放子猷船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送伦美卿太学南归","author":"卢龙云","text":"浩渺江流暑渐蒸，扁舟何事达金陵。\n谈来道路心仍戒，语及乡园思转增。\n家学箕裘推嗣美，词场鞭弭羡重兴。\n探奇更藉江山助，到处虹光健笔淩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冯太学归寿卷","author":"卢龙云","text":"长铗归来岂为鱼，春晖几望白云居。\n省亲近得阳城教，遗子难忘邺架书。\n旅雁去时催客棹，篱花开处待班裾。\n人文上国多篇咏，却道南山颂不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邓玄度给谏出佥楚宪","author":"卢龙云","text":"几烦封事达明光，请剑还期出尚方。\n祇信臣衷元粹白，难符众论不雌黄。\n君门渐远恩非薄，宪府新开画自长。\n岂为食鱼思建业，将同回雁起衡阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答陈生心文","author":"卢龙云","text":"远海缄书一雁传，品题国士忆当年。\n郁袍未动朱衣赏，蓉镜堪期御墨鲜。\n乡似并州心独切，庄如陆氏意俱悬。\n骅骝本自轻千里，更向长途早着鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六月六日诸词客大集天界社招余以公阻不克赴","author":"卢龙云","text":"步出长干第几桥，天开净界息烦嚣。\n总宜河朔为高会，兼喜濠梁得见招。\n白雪惊飞来伏日，乌衣群聚忆先朝。\n不缘意气归词社，褦襶何当折简邀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答王皞如太学二首 其一","author":"卢龙云","text":"一别江干几岁华，纵横彩笔屡生花。\n菰城夜月怀偏远，桂苑秋风望转赊。\n贻我漫同青玉案，逢人休道紫金沙。\n雕虫祇合居王后，已识长杨重汉家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答王皞如太学二首 其二","author":"卢龙云","text":"消息东南迥不闻，每缘篇咏辄思君。\n环桥礼乐趋晨旭，两地壶觞隔夕曛。\n赤帜先登才独步，白门重聚意俱勤。\n新诗持赠辉双璧，相忆何如但暮云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"量移司农分署答李成白姚巽卿二首 其一","author":"卢龙云","text":"有客新篇炫彩霞，翛然逸调胜群哗。\n每因留滞怜羁宦，肯许文章附大家。\n禅戒并宽莲社酒，枯肠翻笑玉川茶。\n商飙渐有清秋兴，笔底能无复梦花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"量移司农分署答李成白姚巽卿二首 其二","author":"卢龙云","text":"几年漂泊江之湄，此日频烦领度支。\n公事正须相料理，百家端合稍停披。\n持筹但可资分画，授简何妨听赋诗。\n水旱近来多奏牍，中和宣布在何时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张子云赴选","author":"卢龙云","text":"逼侧歌残始见君，翩翩结束又离群。\n三都十载推能赋，一日同舟重抚军。\n客路山川烦应接，帝城风月与平分。\n不知何地堪资画，却为苍生望已勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高孩之入贺长至","author":"卢龙云","text":"云物登台庆履长，翩翩车骑客衣裳。\n心驰上国离南国，路绕他乡达故乡。\n此日送君同虎拜，到时趋陛近龙光。\n家园莫恋连枝会，须道怀人水一方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李大顺寄怀二首 其一","author":"卢龙云","text":"相违何处觅鸿音，珍重缄题识远心。\n思入苍葭秋露渺，望穷碧树海云深。\n风尘似我虚糜禄，山水怜君独抱琴。\n目极闽南几千里，川原寥绝意难禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李大顺寄怀二首 其二","author":"卢龙云","text":"绵绵远道隔星霜，几度思君到海阳。\n自尔抽簪还雾豹，只凭留舄恋星凰。\n犹馀岭海甘棠爱，堪笑岷峨畏路长。\n最是穷愁工著作，却教泉石美词章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"澹然亭八景有序 其一 小有钟声","author":"卢龙云","text":"何处洞天称小有，疏钟点点出云间。\n结庐自得寰中胜，入社僧同物外閒。\n问字去来杨子宅，参禅日暮远公山。\n总知至理归恬澹，习静应能共闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"澹然亭八景有序 其二 兽石龙吟","author":"卢龙云","text":"突兀孤峰孰斗奇，地灵盘毓许先知。\n冲霄头角看来近，戛石音声识者希。\n亭似草庐诸葛卧，人方渔钓渭阳师。\n天池云雨年年在，递看飞腾万里时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"澹然亭八景有序 其三 芝山晓月","author":"卢龙云","text":"紫芝烨烨遍山椒，山对孤亭望不遥。\n睡起暝烟犹洞壑，坐看华月正云霄。\n清辉缥缈临书幌，曙色依稀接绮寮。\n矫首乾坤吟思远，馀醺卯酒未全消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"澹然亭八景有序 其四 北盂夕照","author":"卢龙云","text":"苍苍员峤面高斋，山色岧峣夕转佳。\n永日开帘来紫气，馀晖傍户映丹厓。\n牛羊已下初闻磬，鸟雀驯来尚满阶。\n莫怪茶垆淹坐久，晚晴瞻眺动诗怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"澹然亭八景有序 其五 十洋城市","author":"卢龙云","text":"百里专城傍海濆，千家鸡犬日相闻。\n南荒卉服通朝贡，北阙龙章净岛氛。\n山郭但裁招隐赋，楼船何事伏波军。\n勿言近市多喧杂，亭敞时堪驻白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"澹然亭八景有序 其六 五马烟萝","author":"卢龙云","text":"山势崚嶒跃马来，当檐朝暮翠屏开。\n四时物色烟花里，百叠峰峦锦绣堆。\n长许卧游碧落外，何须济胜白云隈。\n知君雅有看山兴，不厌凭阑日几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"澹然亭八景有序 其七 鳌顶祥云","author":"卢龙云","text":"鳌戴三山弱海东，城南咫尺亦堪同。\n卿云缭绕孤峰外，瑞色冲腾杳霭中。\n影结楼台临绝涧，光生岩岫散晴空。\n高人对此自怡悦，不羡飞扬逐大风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"澹然亭八景有序 其八 瀛洲晚渡","author":"卢龙云","text":"清江环抱号瀛州，日晚人归古渡头。\n波带夕阳催荡桨，潮生海月待维舟。\n尘途不定时来往，鸥鸟无心自去留。\n始识澹中馀隽永，萧然身世即丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺同年王计部初诞曾孙二首 其一","author":"卢龙云","text":"曲江并马记吾曾，华发头颅日渐增。\n绕膝喜君孙有子，开颜对客祖为曾。\n镜中白镊殊堪慰，经里玄成且代兴。\n最是凤毛俱五色，云霄次第见飞腾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺同年王计部初诞曾孙二首 其二","author":"卢龙云","text":"廿年膝下忆含饴，又见庭芳毓瑞时。\n祖德亲传为世德，孙枝迭长出新枝。\n王家尚纪三槐传，窦氏休誇五桂诗。\n奕叶庆馀看济美，应多雨露发华滋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄寿姻家潘少临将军","author":"卢龙云","text":"廿载儒冠事素王，厌从笔砚守青箱。\n请缨自许匡时略，授钺堪先结客场。\n龙马精神看矍铄，麒麟勋业待腾骧。\n椿株未老誇芳桂，文武家声合并昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答颜生半千","author":"卢龙云","text":"江湖几度客为星。\n烟水茫茫忆聚萍。\n钱谷未须论宦绩，风云有待赋湘灵。\n持筹似我心偏苦，校艺怜君鬓尚青。\n门下侯芭谁者是，他年应为守玄经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠医官黄文明","author":"卢龙云","text":"上池真诀出长桑，肘后仙经尽禁方。\n鸿术似缘三世远，专门堪擅四家良。\n积功大有千人活，起色全无二竖藏。\n谁更庐山依董奉，知君林杏已苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘比部入贺千秋便道归霸州兼寄怀诸旧游","author":"卢龙云","text":"家住畿南近帝城，前星咫尺望中明。\n班悬法从鸠司远，颂入承华鹤禁清。\n晓拜枫宸思论对，昼游梓里重含情。\n当时朋旧今何似，为道难忘客舍并。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李成白自秋浦寄怀时将适皖潜","author":"卢龙云","text":"君家供奉昔曾游，词赋于今更并留。\n兴在九华依福地，梦回千里忆皇州。\n诗因离合思同调，书免浮沉复致邮。\n闻道皖潜有佳处，固应移棹溯江流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广生至有述赋答","author":"卢龙云","text":"翩翩群从系离思，别每经年聚却迟。\n竹室旧誇杨氏客，兰阶多识谢家儿。\n炎氛过雨开三伏，爽气先秋满二仪。\n羁旅相逢应尽醉，明朝休道尚书期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]