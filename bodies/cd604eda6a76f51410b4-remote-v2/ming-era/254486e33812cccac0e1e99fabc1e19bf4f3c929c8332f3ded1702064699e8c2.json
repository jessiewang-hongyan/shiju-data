[{"title":"读邵康节击壤集二十首 其二十","author":"薛瑄","text":"少年应自负雄才，老悟玄机此意灰。\n岁月风光情自得，山云水石兴悠哉。\n一环理窟閒中见，万古天心动处来。\n宝匣瑶琴遗响在，几何人识伯牙怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6168,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次王侍御韵","author":"薛瑄","text":"宪府乘骢旧有名，今秋偶尔会蛮荆。\n虹霓气接风云气，珠玉声随咳唾声。\n万里山川劳跋历，诸蕃部落待澄清。\n愧予无补虚持节，赖有丹心老更明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6169,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"平定州分司次江侍郎韵","author":"薛瑄","text":"乘轺万里越河关，报国宁辞道路艰。\n首夏初离巫峡水，新秋又过太行山。\n久知雁塞妖氛扫，载喜龙沙凤驾还。\n白发已承归老诏，陛辞不日觐天颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6170,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄王用章宪副","author":"薛瑄","text":"每从青济忆同官，祗隔沧溟一水宽。\n我捧天书行万里，君持宪节按三韩。\n封章入奏时名大，骢马巡边将胆寒。\n双剑有光常夜夜，暂回风雨未应难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6171,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"附录所赠二首 其一","author":"薛瑄","text":"名利场中一梦醒，知君浑不负苍冥。\n村醪且去随时饮，涧水重来洗耳听。\n俗眼任他终日白，山光还似旧时青。\n从教门外尘如海，坐向空斋阅圣经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6172,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"附录所赠二首 其二","author":"薛瑄","text":"自许孤忠结主知，居官宁肯论安危。\n平反不愧张廷尉，三黜何惭柳士师。\n已向一身中道立，更看千古大名垂。\n到家莫废韦编业，伊洛高踪尚可追。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6173,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚秋过相国寺怀然上人","author":"朱睦㮮","text":"与君结静因，回首俱陈迹。\n缅忆山中游，岁景倏已夕。\n秋飙飒空林，淡月来寒石。\n兀坐亦何言，含情念畴昔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6174,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答田六深甫郑二信之过陂上","author":"朱睦㮮","text":"岂是谈经所，真成载酒庐。\n竹停仙客骑，花翳孝廉车。\n秉烛惊山鸟，调琴出浦鱼。\n悠然对孤屿，宛在水中居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6175,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汴上逢夏左伯孝廉","author":"朱睦㮮","text":"雨雪满夷山，相逢逆旅间。\n寒云依竹屏，微月映柴关。\n酒半思陈迹，灯前认旧颜。\n廿年今邂逅，忍复送将还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6176,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汴上逢李柬因寄李二素甫","author":"朱睦㮮","text":"端坐意不适，夏林飒已秋。\n忽逢关外使，暂缓望中忧。\n野日回残照，池烟淡夕流。\n怀君欲何语，独上竹西楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6177,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送朱生游德安兼简蔡太守","author":"朱睦㮮","text":"送尔之南国，清宵恋别觞。\n词人江左客，刺史汉中郎。\n碧柳临官道，秋兰绕郡堂。\n遥知讲经处，赓和有新章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6178,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄题沈逸人故居","author":"朱睦㮮","text":"修竹湘沅畔，会闻有避喧。\n叶香馀在户，翠影尚临轩。\n野日怅谁语，江云愁与繁。\n自君腾驾后，阒寂此丘樊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6179,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送郑处士信之还歙因忆昔同游诸君子","author":"朱睦㮮","text":"同和日云稀，怜君复远违。\n青山双屐在，白首一帆归。\n野烧浮残雨，寒林散夕晖。\n因兹忆畴昔，相对各沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6180,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夕忆信之","author":"朱睦㮮","text":"城阳分手地，摇落倍前时。\n微月衔高树，寒云覆古陂。\n新知竟谁是，旧好复何之。\n寂寞朱弦夜，思君只益悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6181,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吹台上送李柬还关中兼寄李素甫孝廉","author":"朱睦㮮","text":"台前洛阳路，送尔向秦年。\n岂意歌吟地，真成邂逅筵。\n寒花然暮雨，落叶乱秋烟。\n为语同袍友，相思实黯然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6182,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送鸣虚弟卜居长葛","author":"朱睦㮮","text":"濠客观泉兴，屈原行泽篇。\n怜馀黄发暮，羡尔白眉贤。\n落叶荒城畔，寒花别路前。\n惠连春草句，先已郡人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6183,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日倍文谷翠岩二省使燕东书堂应教","author":"朱睦㮮","text":"邸第张筵日，秋风荐早凉。\n地当清洛外，台接紫云傍。\n绮席仙俦集，瑶阶大乐张。\n坐移淮桂影，身佩楚兰芳。\n乡月淹今夕，文星聚此堂。\n图书披箧笥，词赋入笙簧。\n自愧非枚马，赓歌厕雁行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6184,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"遣使诣李中麓太常求录诸经图解获之喜而赋谢","author":"朱睦㮮","text":"好古君侯最，遗编赖不亡。\n远从济上授，曾向壁中藏。\n负马图才识，伤麟义未荒。\n简将青竹剖，函以碧芸香。\n存乐元闻鲁，传经幸在梁。\n因观科斗字，白日到羲皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6185,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"胡咏竹隐君挽歌","author":"朱睦㮮","text":"大隐卜龙川，疑君楚泽贤。\n纫兰思旧制，咏竹简遗编。\n壑有藏舟地，人无问字年。\n黄山仍似昨，丹灶独萧然。\n径草晞春露，溪松偃暮年。\n朅来一南眺，不见客星悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6186,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送邢宪佥入贺","author":"朱睦㮮","text":"宪使趋京邑，旌旗指上台。\n霜威驱溽暑，雨色净尘埃。\n长乐陈仙乐，承明捧寿杯。\n御炉香欲散，宫扇影初开。\n献颂封人意，匡时国士才。\n向来廷诤地，瞻恋独迟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6187,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"圣驾南狩楚中有诏免迓","author":"朱睦㮮","text":"法驾乘春出上雍，千官剑佩肃雍雍。\n分禋四岳登新典，望历三湘属旧封。\n江草遥怜敷宠色，岩花应似被恩容。\n宸游自识群情洽，欲向周南叹不逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6188,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻明卿补高州","author":"朱睦㮮","text":"十年载笔侍枫宸，万里分符向海濒。\n共拟禁庭思长孺，莫寻湘水吊灵均。\n三山桂发烟中色，五岭花生雪里春。\n此去谁言留滞久，君恩先到泣珠人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6189,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"明卿行父道函诸公枉过陂上分韵得烟字","author":"朱睦㮮","text":"孑孑干旄杂暮烟，浚郊千载尚依然。\n柴扉近接鸥汀侧，草阁平临雉堞前。\n绿柳影含新驻舫，碧芸香护旧题篇。\n夜分把臂酣歌地，细雨青灯似昔年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6190,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早春大中丞同川李公见访询及陂上旧游处赋此奉简三首 其一","author":"朱睦㮮","text":"陂塘春至绿波生，讲肆萧然对古城。\n多谢故人频问讯，渚兰汀树正含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6191,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早春大中丞同川李公见访询及陂上旧游处赋此奉简三首 其二","author":"朱睦㮮","text":"夷门东向接郊坰，使节曾于此地停。\n十九年华一回首，紫云空护壁间铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6192,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早春大中丞同川李公见访询及陂上旧游处赋此奉简三首 其三","author":"朱睦㮮","text":"清溪自分老渔竿，白首欣逢旧豸冠。\n芦叶柽花最深处，舣舟犹记昔时欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6193,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"席上送樵村兵宪西亭","author":"朱睦㮮","text":"云黄沙白静边州，万里风烟属上游。\n幸值清村无所事，且从射猎海西头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6194,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄穆少春吏部","author":"朱睦㮮","text":"阙下投书去不返，山中种豆今何如。\n欲问形容向来使，臞然应似楚三闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6195,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王山人游三楚","author":"朱硕熏","text":"门前杨柳树，风乱曲尘丝。\n日暮临溪别，春帆适楚时。\n人烟杨子渡，山木偃王祠。\n处处生芳草，悠悠千里思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6196,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊居","author":"朱硕熏","text":"结屋临溪水，悠然心自闲。\n泉分杯底月，云共枕前山。\n芳树经春合，幽禽薄暮还。\n邻人借渔钓，嗑尔款柴关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6197,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过族祖姑寿阳君主墓","author":"朱硕熏","text":"高阜城西墓，荒凉卧石麟。\n青山犹似黛，金粉自成尘。\n花落梅妆在，莺啼竹泪新。\n向来萧馆月，不照夜台人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6198,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访张茂才时甫不值","author":"朱硕熏","text":"寻君复不遇，长啸出林间。\n草满池中水，蓬高屋外山。\n夕阳看鸟尽，秋色任云闲。\n爱尔幽居好，归来亦闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6199,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答寄欧桢伯水曹","author":"朱硕熏","text":"闻醉金陵酒，高歌李白楼。\n书来牛渚夕，赋罢凤台秋。\n径竹裁青简，江花照绮裘。\n从来何水部，头白尚风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6200,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"香严寺代袭美怀子田","author":"朱硕熏","text":"几日忽成别，出门秋草长。\n西风看雁序，落月掩龙堂。\n公子兰为藻，缁郎穗作香。\n山中苦相忆，惟恐石成羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6201,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日隐山别墅过邻翁叶氏庄偶赠","author":"朱硕熏","text":"垂老事耕凿，结邻还尔宜。\n相携鹿门隐，不作牛山悲。\n疏木掩村巷，孤云生水湄。\n隔林见烟火，莫负往来期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6202,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"洛阳吟","author":"朱硕熏","text":"洛阳芳草正漫漫，曾是伊王古社坛。\n毁壁断环收拾尽，青山留与路人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6203,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日闻莺柬允治","author":"朱硕熏","text":"秋莺呖呖雨如丝，晓入西园独听时。\n回首绿杨摇落尽，数声还上万年枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6204,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邵山人子俊见过话游梁事","author":"朱硕熏","text":"有客担簦过草堂，一尊风雨话游梁。\n雁池寂寞芙蓉冷，逢著行人说孝王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6205,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"炼真宫","author":"朱硕熏","text":"九华宫殿草菲菲，公主西游去不归。\n底事不如秦弄玉，至今青鸟恨双飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6206,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山中送袭美","author":"朱硕熏","text":"龙伯祠前白日斜，山中七日饭胡麻。\n送君最爱春潭水，流出东风玉涧花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6207,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"纪梦","author":"朱硕熏","text":"一夜西风玉凉枕，梦回明月在横塘。\n分明记得相逢地，笑隔荷花唤阿郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6208,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金谷园","author":"朱硕熏","text":"花落楼空委翠尘，千秋明月恨长新。\n西风原上群芳歇，独有芙蓉似美人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6209,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日怀长安故人","author":"朱硕熏","text":"美人遥忆凤城西，芳草年年路欲迷。\n今日出门春已半，樱花如霰晓莺啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6210,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再过信师房","author":"朱硕熏","text":"廿载寻师此闭关，秋风今日鬓毛斑。\n重来指引看花地，一榻荒凉野草闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6211,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆昔","author":"朱硕熏","text":"清淮浊酒忆同舟，回首风烟又感秋。\n一朵行云倾下蔡，半帆残月按《凉州》。\n吐茵丞相何曾恼，剪袖佳人不解愁。\n红烛半销芸榻曙，梦回行露湿箜篌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6212,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"欧桢伯得请归岭南赋此以寄","author":"朱硕熏","text":"白头词赋出先秦，只字犹能泣鬼神。\n桃叶渡头三载客，梅花岭上一归人。\n鹧鸪啼处垂丹荔，鸿雁归时满白蘋。\n惟有寄书书更远，生前想作范铜身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6213,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过允治园感怀","author":"朱硕熏","text":"三径萧条半绿苔，故人此地罢衔杯。\n莎长露砌蛩争语，荷败秋池雁独来。\n流水无音琴绝响，崩云有恨笛生哀。\n忘情不拟陈王赋，独步斜阳数落梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6214,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"明卿避世下雉著书告成久不得讯驰此往问","author":"朱硕熏","text":"十载回山只著书，一编初就竟何如。\n杀青想尽黄陵竹，剖素常空白水鱼。\n尘起江头频障扇，秋深门外久县车。\n明年待买泷湘棹，欲就三闾问卜居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6215,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"读徐宗伯沙市狱记","author":"朱硕熏","text":"十二星辰应土罗，提封高帝旧山河。\n自从梁邸分旗侈，转厌长沙舞袖多。\n汶水一区还鲁后，商于十里奈秦何。\n铭勋不在干戈际，长叹西风咏涧阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6216,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄鲁三父","author":"朱硕熏","text":"日暮风沙路转迷，征鸿愁度竞陵西。\n云霾楚树连江暗，雪涨湘江泊水低。\n三户没金千口累，两朝怀玉几人啼。\n同时纵有刘光禄，封事于今不敢题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6217,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"均州乐二首 其一","author":"朱器封","text":"真人宫对青楼起，面面青楼俯江水。\n楼上箜篌楼下船，大堤花暖汉江烟。\n汉江估客青楼妾，十五蛾眉娇可怜。\n白铜小唱《黄金缕》，对客还成可怜语。\n垆头客醉不留行，明道㠁峰望云雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6218,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"均州乐二首 其二","author":"朱器封","text":"临江贾人黄篾船，涴涴青油篙刺天。\n下船上岸买鱼酒，二八当垆夸数钱。\n烟萦罗幌春将晚，白日衔山不思返。\n珠帘红袖影傞俄，楼上明妆楼下波。\n沙棠树上娇春鸟，月出平江齐唱歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6219,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游㠁山二首 其一","author":"朱器封","text":"万丈披鸿蒙，远势断太古。\n赤山表东关，山峰建翠羽。\n轻霄无驻景，群鹤有常侣。\n海气浮丹毛，盈盈栖复举。\n下有窈窕岩，隐隐仅可睹。\n几横三玉书，粲粲黄金镂。\n竹花开五色，苔叶垂千缕。\n饮泉仰天浆，茹芝饱春露。\n娇娇升天龙，斤斤日中兔。\n关尘日暮黄，岂辨秦楚路。\n片云停不飞，下覆昭王墓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6220,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游㠁山二首 其二","author":"朱器封","text":"灵峰七十二，一一相为通。\n峰下结竹龙，云中响楠虫。\n相接梁柱飞，各显班倕工。\n触首入云清，下界犹丹空。\n木难饰阶砌，璠玙雕房栊。\n阿阁栖凤凰，仙阙标芙蓉。\n金蕙落萧萧，石梁翼飞虹。\n珍木集丹地，扶疏罗修桐。\n修桐碧玉柯，春阳发萌茸。\n紫茎光陆离，绿叶纷青葱。\n爱此饮飧食，驻颜游无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6221,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鬼谷","author":"朱器封","text":"鬼谷最深邃，千灵迷涧濒。\n高风响冰叶，山根暖馀春。\n未敢别人界，桃花是谷神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6222,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄田子艺","author":"朱器封","text":"芙蓉摇落寄何迟，远道犹涵玉露滋。\n山绕穆陵秋矗矗，月明浉水夜离离。\n翻经台畔一灯寂，挝鼓楼前双杵悲。\n无奈西风吹病骨，因君将赋五游诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6223,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郇关归憩刁河寺忆子田龚美之万","author":"朱器封","text":"西来驱马度晨星，却望群峰刺眼青。\n门外苔痕留远屐，水边花树覆空亭。\n分携忆折相思柳，独卧长窥如意瓶。\n翻与山僧重握手，日华杲杲涧泠泠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6224,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜渡小江口宿丹崖赵氏寄怀李子田太史","author":"朱器封","text":"平沙为席石为幢，歇马呼船夜渡江。\n双桨烟迷青草溆，九宵月傍绿芸窗。\n门前题字过丹穴，客里逢春覆玉缸。\n觅尔深山读书处，幽居长羡鹿门庞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6225,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨","author":"朱多?","text":"触石阴霞北岭遥，逗风寒雨入檐飘。\n天涯故旧惟孤枕，箧里衣裳祗敝貂。\n绽雪芦花纷历历，经霜枫叶莽萧萧。\n还应撼郭涛声急，只怪空江上夜潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6226,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"酬罗敬叔","author":"朱多?","text":"病里送君游白岳，归来对我惜苍颜。\n移家只是湖边好，莫问茱萸第几湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6227,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十四夜玩月忆亡友彭稚修","author":"朱多炡","text":"玉绳界西陆，澄空净如浣。\n庭柯泫零露，早见圆景满。\n悄焉增永怀，顿令衣带缓。\n四气无终极，人生一何短。\n心悲雍门操，泪陨山阳管。\n徂谢子山丘，凄其我华馆。\n临觞惨不怡，忧来莫能款。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6228,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"丙戌岁除","author":"朱多炡","text":"初年朝旭旦，故岁徂景夕。\n逡巡蚁旋磨，倏忽驹过隙。\n拙劣应逃世，疏慵翻寝疾。\n逢时独悲悼，抚己三太息。\n弥增长年愧，末契养生术。\n昔贤夙相伍，枚叟徒见七。\n每有忧生嗟，忧来恨非一。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6229,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"以古玉钗寄马姬","author":"朱多炡","text":"千有馀年两鎈股，传玩微沾汉宫土。\n当时贵姊应嘉辰，此物曾经踊跃陈。\n同心七宝苔花结，连理交枝竹节新。\n昭阳燕子无消息，瞥见钗头无比翼。\n遥忆美人临镜妆，凤凰台前双凤凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6230,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄丘二十二谦之","author":"朱多炡","text":"丘郎一官一再左，手版三投三不可。\n进退艰如踯躅羊，功名涩似威蕤琐。\n忆昔与子初结欢，觞咏浣韨章江干。\n别来忽下阆中命，五马重歌蜀道难。\n阆中君家旧治域，父子分符如画一。\n耆旧摩挲去后碑，少年捃拾毛中迹。\n纵有诗名天地间，那能相见一开颜。\n我擅秦声君楚舞，醉望城头千仞山。\n君当强仕不得意，我尚沉冥未知止。\n与君各自斗身强，四十头颅已如此。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6231,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"酬方于鲁以制墨见寄","author":"朱多炡","text":"汉室瑜糜香，魏台石螺色。\n东海玄夷使，翰林子墨客。\n此时落手金不渝，无事临池水应黑。\n阿圭阿谷久无光，处士千秋擅古方。\n不博一枰狮子注，且留十袭豹皮囊。\n回头笑指窗前女，今日双蛾画较长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6232,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]