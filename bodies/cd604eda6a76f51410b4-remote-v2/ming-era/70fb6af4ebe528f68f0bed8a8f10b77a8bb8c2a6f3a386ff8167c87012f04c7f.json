[{"title":"华阳杂咏八首 其五 涵碧池","author":"胡应麟","text":"池上藤萝岁月深，半空寒影动青岑。\n携琴欲写潇湘意，夜夜蛟龙水面吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华阳杂咏八首 其六 浴云潭","author":"胡应麟","text":"绝壑东回鸟道微，隔山流翠转依依。\n西风落日空潭上，满地寒云湿不飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华阳杂咏八首 其七 飞来石","author":"胡应麟","text":"片石巑岏倚怪松，清秋寒雨滴虬龙。\n苔深不记飞来处，疑是崆峒第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华阳杂咏八首 其八 步虚台","author":"胡应麟","text":"缥缈天都十二楼，银河遥望不胜愁。\n何因醉逐飞琼语，谪向人间五百秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖竹枝歌四首 其一","author":"胡应麟","text":"四山楼殿锁清秋，一水萦洄岛屿幽。\n咫尺蓬瀛休道远，画船箫鼓在中流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖竹枝歌四首 其二","author":"胡应麟","text":"听乐鱼龙出渼陂，学飞凫雁绕昆池。\n青林半锁瑶台暮，绿浪平铺画舸移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖竹枝歌四首 其三","author":"胡应麟","text":"倚棹汀洲草色齐，回船涛浪满苏堤。\n万家杨柳青门外，一片芙蓉绿水西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西湖竹枝歌四首 其四","author":"胡应麟","text":"双鹤徘徊几夕阳，孤山云水似潇湘。\n重游好探东风信，万树梅花舣雪航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡文父还匡庐五首 其一","author":"胡应麟","text":"尔去匡庐第一峰，翠屏千叠紫烟重。\n何时共拾金光草，对倚青冥跨白龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡文父还匡庐五首 其二","author":"胡应麟","text":"秀出香炉万岭西，远公精舍夕阳低。\n怜君我欲逃禅去，相逐寒云住虎溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡文父还匡庐五首 其三","author":"胡应麟","text":"栖隐峰头树色分，传书遥寄紫阳君。\n一声铁笛千林晚，片片桃花落彩云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡文父还匡庐五首 其四","author":"胡应麟","text":"闻说年来李梦阳，青鞋曾遍踏苍茫。\n扶筇何处天池近，指点银河百尺长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡文父还匡庐五首 其五","author":"胡应麟","text":"九叠云屏雾雨馀，海风江月望来虚。\n携书倘逐青莲兴，乞取匡君旧结庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽陆文学一绝","author":"胡应麟","text":"廿载青衫阅岁华，殡宫遥映夕阳斜。\n春风何处山阳笛，落尽棠梨万树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上即事二首 其一","author":"胡应麟","text":"一派笙歌拥大堤，春风携酒画桥西。\n回镳竞挽青丝骑，苏小门前柳色齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上即事二首 其二","author":"胡应麟","text":"垂柳朱门十万家，青帘红旆各年华。\n苏小墓前寒食近，碧桃无主乱飞花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡钱塘七首 其一","author":"胡应麟","text":"一夜天风挂海涛，雪山零乱舞江皋。\n轻舟忽渡钱塘水，万仞扶桑日色高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡钱塘七首 其二","author":"胡应麟","text":"赭龛回望两山屯，天削银屏障海门。\n白浪昼看三百里，不知谁唤伍胥魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡钱塘七首 其三","author":"胡应麟","text":"浊浪东排万里天，平分吴越海云前。\n凭谁为乞支机石，坐拥浮槎到日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡钱塘七首 其四","author":"胡应麟","text":"十二楼台倚碧空，安期亦在紫云东。\n璚车笑指相逢处，摘取蟠桃万树红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡钱塘七首 其五","author":"胡应麟","text":"江色浮空四望遥，青山斜倚木兰桡。\n何人共击中流楫，散发回看大海潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡钱塘七首 其六","author":"胡应麟","text":"十载长安祇浪游，扬帆东蹴海天流。\n含毫秋斗思光赋，万壑鱼龙起暮愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡钱塘七首 其七","author":"胡应麟","text":"坐拥轻桡入乱山，蓬莱东望彩云閒。\n麻姑是处堪携手，重叠秋江倚翠鬟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜发钱塘以风涛迅甚次日遂抵桐庐","author":"胡应麟","text":"暮云飞尽海门开，越客扁舟万里回。\n一片青山涛浪里，不知帆过子陵台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"裕卿业与余为钱塘之约余以归计迫不及待辄留一绝","author":"胡应麟","text":"飞流如雪洒篷窗，一夜离心拥去艭。\n回首不堪相忆处，千山明月满桐江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登钓台四绝 其一","author":"胡应麟","text":"重叠岚光倚翠屏，天风吹客上危亭。\n持竿试著羊裘坐，何处长安有客星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登钓台四绝 其二","author":"胡应麟","text":"挟策初从帝座回，系舟重上子陵台。\n峰头日暮狂歌发，万里浮云海色来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登钓台四绝 其三","author":"胡应麟","text":"欲向桐君话隐沦，千峰寒色对嶙峋。\n青袍可是游燕客，不染玄都半树尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登钓台四绝 其四","author":"胡应麟","text":"百尺纶竿俯碧流，危阑天半夕阳愁。\n山灵似识携家意，十里鱼龙送客舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邦相游烂柯不遂戏为四绝询之 其一","author":"胡应麟","text":"底事双凫向碧空，洞天重叠锁芙蓉。\n虚疑王质云中去，仍见王乔县里逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邦相游烂柯不遂戏为四绝询之 其二","author":"胡应麟","text":"乘风百级上莓苔，樵者峰头唤不回。\n何似归寻胡伯子，石屏霞谱为君开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邦相游烂柯不遂戏为四绝询之 其三","author":"胡应麟","text":"当年仙诀妙通神，下子蟠桃十度春。\n一自移居兰水上，烂柯岩畔更无人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邦相游烂柯不遂戏为四绝询之 其四","author":"胡应麟","text":"一局才从石上看，人间千日已阑珊。\n何如共载溪头酒，剩作平原百遍欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问喻邦相病四首 其一","author":"胡应麟","text":"闭阁经旬卧起迟，青山长日对支颐。\n吏人莫讶休文瘦，政是初成八咏时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问喻邦相病四首 其二","author":"胡应麟","text":"名姓曾闻在赤城，衙斋一卧万缘轻。\n惟应剩取清羸骨，白日飞凫上太清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问喻邦相病四首 其三","author":"胡应麟","text":"十年归卧茂陵居，长日惟删旧著书。\n最是汉庭怜汲黯，病来犹得伴相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问喻邦相病四首 其四","author":"胡应麟","text":"尔闭高斋送夕阳，余愁肺病卧空床。\n何缘对挟飞龙去，万仞青天坐石梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题方山人听秋轩","author":"胡应麟","text":"密甃疏棂翠筱中，碧天遥挂二梧桐。\n何时自挟蒲团至，坐领阶前万叶风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋中绘五岳为图称卧游焉各系以诗 其一 泰山","author":"胡应麟","text":"玉殿琼楼起太空，扳藤遥上碧云中。\n中宵不辨星河色，万丈天门海日红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋中绘五岳为图称卧游焉各系以诗 其二 衡山","author":"胡应麟","text":"拄杖飞萝上百盘，狂吹玉笛和青鸾。\n回看月色千岩吐，不道峰头是广寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋中绘五岳为图称卧游焉各系以诗 其三 嵩山","author":"胡应麟","text":"远下昆崙度玉华，黄河九曲照三花。\n空明洞底无人住，散发中天弄紫霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋中绘五岳为图称卧游焉各系以诗 其四 华山","author":"胡应麟","text":"太华三峰削不成，巨灵高掌矗咸京。\n相携玉女朝天去，朵朵莲花足下生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋中绘五岳为图称卧游焉各系以诗 其五 恒山","author":"胡应麟","text":"绛节回看上帝台，金茎云雾接蓬莱。\n不知碣石青何处，万里冰天雪色来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日南轩栉发忽数茎斑斑焉漫题二绝志感 其一","author":"胡应麟","text":"未到潘年已二毛，胡床箕踞白云高。\n犹胜寓直秋风里，寂寂寒更赋骑曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日南轩栉发忽数茎斑斑焉漫题二绝志感 其二","author":"胡应麟","text":"绿鬓全抛旧日容，一庵秋色照蒙茸。\n凭谁试摘三千丈，挽取羲和驾六龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月十五夜小亭玩月","author":"胡应麟","text":"尊酒凭阑客思孤，万家明月对冰壶。\n不知檐外秋多少，一夜飞霜下井梧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢章仪父惠家酿二绝 其一","author":"胡应麟","text":"玉碗香飞琥珀明，自呼南斗吸长鲸。\n河清莫道今难俟，已换王家月旦评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢章仪父惠家酿二绝 其二","author":"胡应麟","text":"一饮挥毫一百篇，何人真是酒中仙。\n应知他日来民舍，不饮麻姑石上泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人之会稽","author":"胡应麟","text":"问水看山兴未涯，十年瓢笠寄烟霞。\n青鞋夜宿云门寺，好趁千峰向若耶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日寄友人山中","author":"胡应麟","text":"白雁丹枫尽作行，霜天何处问重阳。\n东邻老衲归来晚，静夜猿声到竹房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄洛中友人","author":"胡应麟","text":"浊酒青丝照玉壶，信陵公子对呼卢。\n狂歌莫问燕台客，零落秋风傍狗屠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张鍊师","author":"胡应麟","text":"搆得茅斋傍玉华，芙蓉伏火鍊丹砂。\n清秋绝顶朝元夜，白露千岩湿桂花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韩逸人西游二华持扇索题戏为书一绝句","author":"胡应麟","text":"豆蔓松花护客居，半床云色半床书。\n西游何处烧金液，太乙峰前旧结庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人入蜀","author":"胡应麟","text":"远下荆门客思浓，清秋落木遍千峰。\n猿声一夜孤舟雨，愁杀巫山十二重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何生游边","author":"胡应麟","text":"翩翩书记向龙堆，白草黄云大漠开。\n落日固原飞檄少，题诗频上赫连台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄黔中刘从事","author":"胡应麟","text":"崔嵬铜柱乱峰前，迢递乡书隔岁传。\n醉卧桄榔明月底，不知人在夜郎天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日送人之夔州","author":"胡应麟","text":"黄牛峡口暮云愁，白帝城前江水流。\n落日片帆秋色里，千山行尽见夔州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕纪梦十绝 其一","author":"胡应麟","text":"芙蓉一枕自徘徊，恍惚钧天帝子台。\n长啸八公携手去，万峰云色驾蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕纪梦十绝 其二","author":"胡应麟","text":"足蹑安期两赤虬，飞行忽到海西头。\n青山一片昆崙顶，乱落星河满蒯缑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕纪梦十绝 其三","author":"胡应麟","text":"晓入瑶池殿里行，珠帘斜捲月华明。\n天姝十万花如绮，不省何人是智琼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕纪梦十绝 其四","author":"胡应麟","text":"十五神鳌戴白云，三山长揖魏元君。\n不须远问灵飞箓，玉佩金珰尽秘文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕纪梦十绝 其五","author":"胡应麟","text":"永夜银河送客槎，吹笙遥赴阿环家。\n狂抛织女支机石，携手扶桑万尺霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕纪梦十绝 其六","author":"胡应麟","text":"龙蹻泠泠踏紫烟，罡风吹向大罗天。\n白云满地秋如水，十二琼楼独自眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕纪梦十绝 其七","author":"胡应麟","text":"一局王乔对未残，飞书何处到青鸾。\n骑龙夜赴西池会，三百明星乱玉盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕纪梦十绝 其八","author":"胡应麟","text":"玉榜琼楼次第开，梯仙灵境乍徘徊。\n花前舞罢山香曲，万朵红英落绛台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕纪梦十绝 其九","author":"胡应麟","text":"树树桃花玉洞前，成都卖药已千年。\n秋来跨鹤腾空去，月满仇池第一天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕纪梦十绝 其十","author":"胡应麟","text":"缥缈群仙列上清，天都齐送佩环声。\n归来莫道无人见，两袖霞光罩赤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜登金华绝顶慨然有怀作步虚词五章 其一","author":"胡应麟","text":"两袖明星拂绛河，天风吹客上嵯峨。\n无劳更觅梯仙界，半夜鞭龙入大罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜登金华绝顶慨然有怀作步虚词五章 其二","author":"胡应麟","text":"长揖元君向紫宸，中天楼殿矗金银。\n如花座上三千女，携手先过第一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜登金华绝顶慨然有怀作步虚词五章 其三","author":"胡应麟","text":"礼斗坛边下夕阳，焚香绝顶奏虚皇。\n不知谁唤群仙到，零乱星河白玉床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜登金华绝顶慨然有怀作步虚词五章 其四","author":"胡应麟","text":"一谪仙班下海涯，梦魂长绕阿环家。\n西华旧业荒芜甚，老却瑶池万树霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜登金华绝顶慨然有怀作步虚词五章 其五","author":"胡应麟","text":"左揖龟台右木公，仙坛瑶草暮茸茸。\n金华自有骑羊客，漫许留侯事赤松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新秋郭鸿胪吴文学过访留饮小斋至暮","author":"胡应麟","text":"一自华阳罢和歌，频年白眼卧山阿。\n玄亭莫怪秋来启，刚为侯芭到绿萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘲小杜","author":"胡应麟","text":"花压虹桥水压城，玉箫吹月到天明。\n当时自少挥毫客，可道青楼横得名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喻邦相即署中建楼题曰信美索诗为赋四绝 其一","author":"胡应麟","text":"胡床明月坐高秋，碧瓦朱甍大海头。\n十二危阑宾从满，一时传作庾公楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喻邦相即署中建楼题曰信美索诗为赋四绝 其二","author":"胡应麟","text":"画槛雕阑瞰越城，平湖十里最分明。\n公馀半捲珠帘坐，四百楼台弄晚晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]