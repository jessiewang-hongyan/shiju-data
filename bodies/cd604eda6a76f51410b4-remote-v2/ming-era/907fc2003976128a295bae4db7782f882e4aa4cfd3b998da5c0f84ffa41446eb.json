[{"title":"长夏","author":"汪广洋","text":"凉挹溪山爽，翚飞省署新。\n莺声清过耳，草色绿愁人。\n浊酒传杯重，乌丝界纸匀。\n吾儒公事毕，聊复暂怡神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得杭州从侄璧书","author":"汪广洋","text":"自我离乡井，于今十六年。\n汝亲罹丧乱，诸叔困颠连。\n痛哭春江树，将书暮雨前。\n几时㩦汝辈，归种水西田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"风雪大作子敬寘酒喜朱伯徽寻鲁志敏回 其一","author":"汪广洋","text":"天寒栖鸟定，野阔暮云多。\n奈可山城寂，其如风雪何。\n感时将白发，处世尚彤戈。\n赖有王都督，徐徐动雅歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题玄同子卷赠考功葛元德","author":"汪广洋","text":"吾爱玄同子，须眉冰雪清。\n一言辞职去，九转炼丹成。\n句曲陶弘景，涔阳窦子明。\n相望隔千里，松鹤倍增荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆建业","author":"汪广洋","text":"江城秋宴日，公馆雨来时。\n纵得陶潜酒，难浇宋玉悲。\n浦云寒易湿，汀草暝先知。\n何以长干道，悠悠我所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得风","author":"汪广洋","text":"拜命趋归日，沿流喜顺风。\n雨帆皆得意，直下大江东。\n神物潜幽宅，灵妃敞閟宫。\n啸歌横短槊，历览气何雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马当山","author":"汪广洋","text":"江畔山无数，马当青出群。\n坡陀支急水，盘礴抗浮云。\n怪木悬春雨，幽花丽夕曛。\n缅思开辟际，光岳肇初分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京口","author":"汪广洋","text":"江水白如练，楚山青可人。\n晴光生北固，暮雨隔西津。\n云雾帆樯合，金银殿阁新。\n眷兹天堑险，直与海为邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"扬州","author":"汪广洋","text":"忆昔曾游地，于今有几家。\n湿云缠戍鼓，高柳聚城鸦。\n玄鹤去无迹，绿芜愁更赊。\n盈盈江上月，何处照琼花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淮安","author":"汪广洋","text":"薄宦游齐鲁，去乡知几千。\n东流淮水急，直下楚城连。\n浊浪横冲海，斜阳半在船。\n我为官府系，长是涉风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洪泽屯","author":"汪广洋","text":"兵农古为一，耕战两无妨。\n重在人经理，终期国富强。\n服勤遵往辙，较艺得遗方。\n灌溉尤多利，云山白水长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过泗州旴?","author":"汪广洋","text":"泗水开名郡，旴?拥大山。\n云林与城郭，都在画图间。\n淮楚钟灵异，烟霞恣往还。\n从来形胜地，造化默相关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"神女山","author":"汪广洋","text":"神女去云远，名山依旧存。\n佩环空寂寞，岩壑阅晨昏。\n云木深藏庙，淮流直到门。\n无因停桂楫，和露挹兰尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮山","author":"汪广洋","text":"禹功疏凿远，淮泗奠安流。\n秀出冈峦好，看来紫翠浮。\n传闻仙境异，轩豁洞门幽。\n松柏萧森处，阴阴长似秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五河县浍沱漴沙入淮","author":"汪广洋","text":"一县控冲要，五河当合流。\n生民逢丧乱，治日免需求。\n筑地栽蔬短，编茅住宅幽。\n叮咛单父宰，慎勿事优悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钓鱼台","author":"汪广洋","text":"溜急沙堤险，张帆荡桨过。\n计程知远近，趋事恐蹉跎。\n芦苇千层合，河流百折多。\n钓鱼台下客，空忆扣舷歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜分","author":"汪广洋","text":"好雨涤烦暑，夜分浑是秋。\n沙明疑见雪，月上可行舟。\n凉气侵床榻，清风入柁楼。\n浣花村里客，只合住沧州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过颍州废境","author":"汪广洋","text":"倡乱伊谁始，频年战未休。\n风云随变态，淮水尚安流。\n绿野弥荆棘，黄沙惨髑髅。\n移舟暂临眺，掩涕不胜忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓兴","author":"汪广洋","text":"落日一樽酒，壮歌淮蔡间。\n停杯爱云水，解带对溪山。\n野旷月初出，鸟鸣心自閒。\n稍晴湍濑急，百丈费跻攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈州","author":"汪广洋","text":"淮蔡奠平野，桑麻翳夕阴。\n土风仍自古，城郭尚於今。\n世乱人家少，年饥草泽深。\n适当开创始，绥抚在经心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"离汴京渡口","author":"汪广洋","text":"衮衮天河水，雄奔际海涯。\n一官辞帝阙，六月上星槎。\n平地俄兴浪，中流忽涌沙。\n瞿塘与巫峡，神变不须誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄陵冈","author":"汪广洋","text":"坤宁信足美，河决岂为常。\n重在修宸德，方能合彼苍。\n波涛来汹涌，畚锸谩堤防。\n感叹秋风客，萧萧愁白杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹州","author":"汪广洋","text":"河北生灵苦，曹州最可哀。\n兵兴多在难，水溢屡为灾。\n蒿草侵城合，狐狸上冢来。\n伤心寥落地，一顾一徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钜野县","author":"汪广洋","text":"废邑开新治，招来近百家。\n未应供赋役，聊可艺桑麻。\n邻里更相吊，悲欢觉倍加。\n徐徐访遗落，亦复事生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿嘉祥县","author":"汪广洋","text":"落日临兹境，萧条太古初。\n十年逢水溢，一县尽巢居。\n地迥鱼龙盛，山空草木疏。\n渺无涯涘处，何以事耕锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"离济宁汎舟北行","author":"汪广洋","text":"杨柳娉婷绿，荷花旖旎红。\n鱼游华盖底，人在鉴湖中。\n太白拈春酒，轻衣受晚风。\n龟蒙与凫绎，只隔片云东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鞍山泊","author":"汪广洋","text":"才入鞍山泊，河流徒觉宽。\n晴波来浩浩，空翠郁盘盘。\n鸂鶒眠沙稳，芙蕖挹露寒。\n天然开胜境，总在画图看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁山泊","author":"汪广洋","text":"河水滔滔阔，梁山奕奕雄。\n洪流连海外，巨镇拥齐东。\n石洞含晴霭，杨林进晚风。\n无因蹑飞屩，高处望龟蒙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"在省晚凉","author":"汪广洋","text":"湿热愈炎炽，端居念远游。\n雷霆催急雨，海岱入清秋。\n素魄云中出，微凉叶底浮。\n汲泉供暝酌，扫地坐来幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"公馀","author":"汪广洋","text":"政剧理常简，公馀宜咏歌。\n移床避阶草，和月盼庭柯。\n露下缘秋重，萤飞向夕多。\n铜池凉可掬，萧爽动蒲荷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"历下秋夕","author":"汪广洋","text":"掖垣嘉禾秀，秋实何其蕃。\n天迥月争彩，风凉露渐繁。\n疏蛩鸣唧唧，惊鹊去翻翻。\n坐久愈岑寂，幽怀谁共言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日济南闻莺","author":"汪广洋","text":"帘幕捲秋晴，间关闻啭莺。\n柳边迷过影，花外度新声。\n簧舌调来稳，歌喉汎出清。\n碧云浮绮榭，疑在锦官城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渔樵清会图","author":"汪广洋","text":"烟溆收归棹，云山罢采薪。\n相逢岑寂处，总是画图人。\n野蕨供芳蔌，江鱼得细鳞。\n瀼西村酒熟，此会最情真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋写怀","author":"汪广洋","text":"前年合江上，去年南浦中。\n沿流爱明月，挂席任西风。\n秫酒酌不醉，林花看更红。\n姮娥应笑我，今夜客山东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"济南喜得家书 其一","author":"汪广洋","text":"阿丈怜余甚，家书寄八行。\n且云添骥子，还可慰萱堂。\n自念十四载，壮游征战场。\n寸心无所昧，出处任穹苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"济南喜得家书 其二","author":"汪广洋","text":"一心忧国事，何事更关情。\n慈母怜垂老，痴儿想学行。\n久违甘旨奉，遥隔四千程。\n感慨秋风里，阴蛩劳夜鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸥","author":"汪广洋","text":"人言海鸥白，我爱海鸥閒。\n野水际空阔，溪云带往还。\n素心终自得，机事不相关。\n鹰隼独何物，鶱腾狐兔间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荅张徵士韵","author":"汪广洋","text":"斗南曾独步，白下早闻名。\n飘逸晋三谢，威仪鲁两生。\n春杯黄秫酒，野饭碧芹羹。\n扰扰风尘者，谁能得此清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠邓司计焕","author":"汪广洋","text":"层冰出幽壑，清见古人心。\n念子久相别，知予何独深。\n偶逢齐鲁地，共醉松柏林。\n细把白驹咏，毋为金玉音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠张典簿璿","author":"汪广洋","text":"伯乐过冀北，人言冀北空。\n固知神骏出，不与凡马同。\n世路驱驰外，天闲十二中。\n从来明圣日，驾驭必英雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿宣城山家","author":"汪广洋","text":"委曲疑无路，幽深别有天。\n偶披青嶂入，得与白云眠。\n树密巢归鸟，溪回响暗泉。\n草堂终夜寂，高枕听鸣弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过泰山","author":"汪广洋","text":"绝顶望神州，淋漓紫翠浮。\n天低众山小，星拱一峰秋。\n云气成龙虎，岚光荡斗牛。\n北恒与西华，引领日东头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云亭山","author":"汪广洋","text":"飘飘学仙子，遗迹閟空青。\n欲往寻芝草，因之采茯苓。\n数松晴雪在，孤嶂暮云停。\n应是蛟龙语，山灵夜出听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大汶口","author":"汪广洋","text":"传云大汶口，秋夏水平洲。\n一雨稍成滞，众山皆合流。\n我来闲饮马，谁谓不容舟。\n无数盘陀石，冲波回万牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峄山","author":"汪广洋","text":"言从邾子国，行过峄易山。\n地迥烟霞古，天低紫翠殷。\n纪城人已去，辽海鹤应还。\n闻道秦碑在，颠崖老树间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峄州","author":"汪广洋","text":"世乱遭多难，斯民苦屡迁。\n山围邹子国，草上汉儒阡。\n王事催归日，寒天逢暮年。\n二疏遗庙在，不得久周旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滕州","author":"汪广洋","text":"有周开列国，联络太行东。\n控制三边外，遨游数日中。\n山川存古迹，草木尚遗风。\n予亦东之楚，长歌意气雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁城道中","author":"汪广洋","text":"平原遗巨垒，云是古梁城。\n树木童童出，䲭鸢帖帖鸣。\n澄空来急吹，何处委芳英。\n往事随流水，凄然伤我情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃源郭外","author":"汪广洋","text":"驱车大堤上，四顾多草莱。\n严吹崇朝止，层凌蔽岸来。\n行行思古道，故故立荒台。\n满目皆陈迹，聊将浊酒开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过渑池悯旱","author":"汪广洋","text":"风沙扑面吹，疲马厌行迟。\n迢递经函谷，崎岖上渑池。\n遗民遭丧乱，久旱转流移。\n不有甘霖降，何能脱死危。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望嵩山","author":"汪广洋","text":"巩洛纵游观，嵩山势郁盘。\n三呼开澒洞，四岳壮维翰。\n松偃彤霞古，云凝紫盖团。\n应当作霖雨，沾足救时难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过鼎湖得雨","author":"汪广洋","text":"好雨来天阙，层云覆鼎湖。\n九农承厚泽，四海慰来苏。\n丰稔行将见，炎蒸坐觉无。\n老夫殊有喜，狂舞动三呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠张主事关中讲究运道回","author":"汪广洋","text":"关中兵旱久，黎庶窜亡多。\n重感朝廷德，频烦使者过。\n舟车资馈饷，田野动讴歌。\n寄语诸朋达，遐方在抚摩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南喜得家书","author":"汪广洋","text":"稽首开书札，倾心想面颜。\n一官居岭徼，万里别乡关。\n最喜慈亲健，都忘两鬓斑。\n尤闻小儿女，日日望回还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登海角亭","author":"汪广洋","text":"海角固云远，人生罕见闻。\n一亭开澒洞，四壁动尘氛。\n月暗鱼龙伏，天晴岛屿分。\n比来舒老眼，浩荡气淩云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上寿","author":"汪广洋","text":"节钺专征握帝符，东南黎献望来苏。\n长驱白日浮云净，直扫沧江积翳无。\n紫极高秋逢电绕，彤霞清晓听嵩呼。\n诸侯玉帛承筐篚，殊译河山入版图。\n五福载陈昭往昔，百男重颂溥欢娱。\n不期赫赫铭彝鼎，况乃乾乾究典谟。\n虚席每延多士语，解衣终见远人孚。\n周家仁厚流芳盛，端与明时作范模。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大祀圜丘喜甘露降应制","author":"汪广洋","text":"至节圜丘祀颢穹，先期法驾幸斋宫。\n山纡紫气排双阙，日射红云拥六龙。\n八表清明群动喜，一诚感格百灵从。\n露垂甘液凝珠颗，松偃香蕤合翠幪。\n凡物均沾神物化，天心允与帝心通。\n绝胜宝瓮陈终夕，奚待金茎倚半空。\n汉苑醴泉非旨美，梁园瑞雪谩形容。\n小臣际遇承恩泽，涓滴何能答九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"范蠡庙","author":"汪广洋","text":"越王去国将危日，范蠡归心用计时。\n千古君臣难再遇，百年耆老尚兴思。\n空檐暮雨巢乾雀，遗庙春风哭子规。\n惟有西施滩下水，浪声东向不胜悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读吴越春秋","author":"汪广洋","text":"口血才乾又复雠，总无诚意为东周。\n夫差只爱容狂佞，勾践殊能用智谋。\n槜李郡还舆土广，姑苏台就鹿麋游。\n高情独羡陶朱子，万顷沧波一叶舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"姑苏台有感","author":"汪广洋","text":"何事夫差日渐淫，都将兴废付登临。\n霸图反手归尝胆，醉魄流涎属捧心。\n台土尚存芳草合，鹿麋空卧古苔深。\n唯应胥口波涛急，百折东流感至今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜过江州伪汉故都","author":"汪广洋","text":"此地当年建翠华，歌钟云沸五侯家。\n眼前谁是池中物，身后徒为井底蛙。\n午夜长风催桂楫，满江明月浸芦花。\n琵琶哀怨今安在，惟有荒城寄宿鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊舟左蠡寺","author":"汪广洋","text":"鸣雁嗈嗈集野田，白沙如雪照行船。\n秋风一阻经三日，客子重游已二年。\n左蠡碧流烟雨外，匡山青落酒杯前。\n空林老衲犹思治，解说王师奏凯旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送鲁志敏往番阳兼讽谕吴德广","author":"汪广洋","text":"江左谁为保障臣，感时临别重敷陈。\n兰陵大飨千秋祀，越国终全六郡民。\n莫倚峻关严虎豹，好图高阁画麒麟。\n灯前预拟旋归日，联辔莺花二月春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"豫章中秋","author":"汪广洋","text":"丹桂吹香玉宇寒，绪风如水月如盘。\n空传许逊骖黄鹄，不见文箫逐綵鸾。\n乐奏广庭云外落，山连章渚镜中看。\n宾筵有酒君当酌，莫待秋霜满鬓端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏","author":"汪广洋","text":"纨扇盈盈剪越罗，麦秋时候转清和。\n云飞城郭烟中远，星散渔家水际多。\n小树暮天收白蜡，平芜晴日放新鹅。\n南州高士亭前客，尤爱沧浪第一歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和子常赵聘君诗韵","author":"汪广洋","text":"圣人予夺严书法，曾托春秋二百年。\n世道久嗟鸣凤后，王纲深著获麟先。\n闭门纂述无虚日，直笔光华动烛天。\n还忆低头拜东野，紫阳山色落窗前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸卯秋大军围武昌予极欲一登黄鹤楼不数日复命还建业莫遂所怀乃赋七言以寄予兴","author":"汪广洋","text":"武昌城头黄鹤楼，爽垲迥挹西南州。\n嶓江岷江於此合，古人今人无限游。\n天际一帆悬宿雨，云边万木下高秋。\n赋诗横槊慷慨事，笑指阑干近斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨晴","author":"汪广洋","text":"护龙河头春雨晴，黄鸟白鸟相兼鸣。\n重来高阁寓幽目，一望故园销客情。\n野花羃䍥照江浦，官树依微绕石城。\n想见六朝全盛日，紫宫楼观碧云横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"召赴京师别豫章 其一","author":"汪广洋","text":"天子图全念用兵，国公承命任专征。\n不烦麾下驱驰日，已定山东七十城。\n自古庙堂求胜算，只今河洛遂欢迎。\n小臣愧乏旬宣力，愿竭愚衷答圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]