pointer":11715,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸲鹆育雏于贞节堂东壁壁高且危二雏堕地下乃就而哺之悲鸣徬徨如在无人之境予怜之取雏纳之巢纪以是作 其一","author":"陈献章","text":"将雏无力上榱题，声断残阳翅忽低。\n高栋托身君亦误，鹪鹩安稳只卑栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11716,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"午睡起","author":"陈献章","text":"道人本自畏炎炎，一榻清风捲昼帘。\n无奈华胥留不得，起凭香几读《楞严》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11717,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋晓","author":"吴与弼","text":"风来夜枕寒，云生晓窗雨。\n旅思共秋清，遥思故山侣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11718,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓立","author":"吴与弼","text":"灵台清晓玉无瑕，独立东风玩物华。\n春气夜来深几许，小桃又发两三花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11719,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"络纬辞","author":"张弼","text":"络纬不停声，从昏直到明。\n不成一丝缕，徒负织作名。\n蜘蛛声寂寂，吐丝还自织。\n织网网飞虫，蜚虫足充食。\n事在力为不在声，思之令人三叹息。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11720,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"假髻曲奉许天爵","author":"张弼","text":"东家美人发委地，辛苦朝朝理高髻。\n西家美人发及肩，买妆假髻亦峨然。\n金钗宝钿围珠翠，眼底何人辨真伪。\n夭桃窗下来春风，假髻美人归上公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":11721,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]