[{"title":"山中八景为友人赋 其五 新巷樵歌","author":"欧必元","text":"下山踏歌相和，归路日暝争先。\n牛羊已入深巷，樵人尚隔前川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37344,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中八景为友人赋 其六 大园牧唱","author":"欧必元","text":"萋萋芳草秋绿，淅淅古松夏寒。\n群儿竞乐树下，长笛一声倚栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37345,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中八景为友人赋 其七 观田耦耕","author":"欧必元","text":"昨检农书卜年，相传父老忻然。\n欲酿松花春酒，先种南山秫田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37346,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中八景为友人赋 其八 习沼垂纶","author":"欧必元","text":"落日池上小舟，浦口相迎白鸥。\n何处高人垂钓，百年吾道沧州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37347,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初入罗浮山径 其一","author":"欧必元","text":"路迂穷日夕，山近逼氤氲。\n策杖回青霭，披衣染白云。\n苔痕深莫辨，树密色难分。\n一过莲池上，泉声到处闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37348,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初入罗浮山径 其二","author":"欧必元","text":"登高聊骋望，磴道转逶迤。\n何石非三岛，无花不四时。\n篆符分竹叶，仙鸟啄灵芝。\n倘问长生诀，应寻华子期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙诗五首 其一","author":"欧必元","text":"平生志寥廓，所思三神山。\n屃屃奠巨鳌，六龙镇潜渊。\n蓬莱倏浮海，高峙摩苍天。\n玄都与閟阙，乃在县宇间。\n五色多异鸟，文綵相翩翩。\n琪花间瑶草，四时呈鲜妍。\n采之服饵食，可以驻颓颜。\n幽宫产赤土，九转炼金丹。\n乘鸾驾云螭，白日生羽翰。\n寄言谢汉武，何处求神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙诗五首 其二","author":"欧必元","text":"崚嶒四百峰，周回五百里。\n中多阆风人，幽岩借栖止。\n左揖灵芝翁，右招子华子。\n葛令进丹砂，轩辕赴诏旨。\n仙驭时往来，烟霞生洞里。\n月明宴瑶京，音乐夜盈耳。\n沆瀣进瑶浆，不在甘与旨。\n笑彼攀龙人，腥膻徒为尔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙诗五首 其三","author":"欧必元","text":"天清月明夜，佳人入梦来。\n颜色都且丽，轻衣绝尘埃。\n随风送奇香，飘飘透我怀。\n晤言用握手，扬辞诙且谐。\n邀我玉女峰，坐我铁桥隈。\n饮我神湖水，进我白玉杯。\n仙凡不久处，倏忽隔蓬莱。\n安得长生药，千年当复来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37352,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙诗五首 其四","author":"欧必元","text":"远望登高峰，餐霞思幽室。\n夜半闻天鸡，坐观沧海日。\n奇幻不可常，寸灵难殚述。\n上界覆青莲，峰峦多兀突。\n怪石敞为楼，池水清且密。\n复道多逶迤，层城隔吴越。\n壁峭不可攀，循崖如股栗。\n凄然多悲风，安得邹生律。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37353,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙诗五首 其五","author":"欧必元","text":"晦明有代谢，盈缺相始终。\n睹物嗟往事，悲来感无穷。\n巢居不可寒，海处难为风。\n饵颜无异术，安得长如童。\n白日倏西迈，兹意成悾惚。\n神驰阆风苑，兴在神山中。\n玄鹤一以驭，青禽来相从。\n云霄下缝节，命我驾六龙。\n一朝辞世氛，直到蓬莱宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37354,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿冲虚观同陈景文万伯文梁元珍邓伯乔李烟客赋","author":"欧必元","text":"南岳何年奠此封，浮来片片玉芙蓉。\n遥瞻上界馀千仞，初入名山第一峰。\n洞口朱明悬旧迹，祠旁丹灶觅遗踪。\n云深羽客差能指，酒熟居人尚可供。\n暂息欲移香石榻，数声犹似定林钟。\n月明半带霜华冷，山色围将紫翠重。\n杳杳仙源知不远，迢迢清梦未能逢。\n朝来济胜愁无具，安得茅家杖作龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37355,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自冲虚观寻朱明洞故址","author":"欧必元","text":"步入瑶坛紫翠连，苔深林静锁云烟。\n山浮碧海知无路，洞掩朱明别有天。\n怪石几层将径碍，枯藤千丈断崖悬。\n何因得借升真去，定绝风尘世上缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37356,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读家虞部罗浮碑铭有感","author":"欧必元","text":"万仞丹梯试一登，丰碑遗碣尚崚嶒。\n官缘水部留词翰，墨副名山有代兴。\n挥泪尚思镵记否，游仙今入梦魂曾。\n欲追谢傅宣城会，路隔瑶台愧未能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37357,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石洞谒叶化父先生祠","author":"欧必元","text":"昔闻岩洞奇，乃在兹山麓。\n巨石垒作门，涂槩结为屋。\n天巧既有馀，人事岂不足。\n天畔闻风涛，行边翳花竹。\n苔古云自封，林深径乃曲。\n洗耳有清泉，聆音如漱玉。\n昔有大隐人，于此卧空谷。\n九还炼未成，五车应可读。\n身在朝野间，名岂世途局。\n欲勒北山文，谁知西州哭。\n怅然怀千秋，到此豁心目。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37358,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经瑶石台忆黎秘书先生因怀其子君献","author":"欧必元","text":"山高元近小蓬莱，磴道丛深莽不开。\n涧长千年瑶是草，崖悬百尺石为台。\n虚传宝篆中郎秘，尚忆金闺侍从才。\n书就青山看接武，寻真玉斧未能来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题葛仙祠","author":"欧必元","text":"南来访洞天，丹诀有遗编。\n勾漏虚称令，罗浮便作仙。\n衣冠犹昨日，羽化自何年。\n傥有留人意，吾将向玉田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登玉女峰","author":"欧必元","text":"孤峰看嵂崒，四望气霏微。\n黛色浮为鬓，霞光染作衣。\n几从鸾鹤去，恍惚佩环归。\n葛令登仙后，凌空势欲飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入水帘洞","author":"欧必元","text":"兹山有神湖，众水于此蓄。\n瀑挂若联珠，涓鸣如喷玉。\n饮之爽人怀，挹以濯吾足。\n不辨仙与凡，蓬莱隔天竺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过梅花村","author":"欧必元","text":"数家村寂寞，一水流潺潺。\n梅树虽犹在，幽香不可攀。\n素衣遗玉女，白鹤过缑山。\n傥入师雄梦，空中闻佩环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37363,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄野人庐","author":"欧必元","text":"岩空小有天，径僻锁岚烟。\n不见溪边草，那寻洞里仙。\n白云迷去路，青涧出流泉。\n欲和梅花句，劳君竟一篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37364,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大石楼怀梁幼宁明府","author":"欧必元","text":"诸峰青霭合，兹洞白云幽。\n为问朱明馆，何如大石楼。\n仙人曾作令，居士亦称侯。\n好待乘鸾至，题诗在上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37365,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"由大小石楼过源泉福地十韵","author":"欧必元","text":"海涌三山至，峰连二石楼。\n明霞常五色，琪树已千秋。\n径仄谁能到，云深客自留。\n跨应同白鹤，气岂望青牛。\n玉检知难探，丹砂或可求。\n仙成鸡犬处，地似凤皇洲。\n环佩空中响，金银海上浮。\n轻烟迷日色，细雨带泉流。\n杖履差能济，招携足胜游。\n洞天兼福地，只说在罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37366,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中曾炼师携酒同景文伯文元珍伯乔烟客饮黄龙洞","author":"欧必元","text":"乱石郁嵯峨，两山相对峙。\n上有孤青峰，下临天华址。\n甘露湛亭芬，翠盖随风起。\n草木翳蓊蒙，登陟碍綦履。\n乘云腾黄龙，鞭电驾赤鲤。\n饵食贮金砂，眺览勒玉趾。\n仙迹讵能攀，伯图徒为尔。\n谁知天畔涛，飞作涧中水。\n素练堪澄怀，清泠可砺齿。\n羽客移一尊，笋舆邀数子。\n沿崖陟高巅，府视无底止。\n侧耳闻罡风，纵目观海市。\n只为愁飞廉，不见升蒙汜。\n神魂望若摇，蓬莱路应迩。\n大醉酬奇游，归途疾于驶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37367,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"见日庵","author":"欧必元","text":"罗浮山与天门通，若木之西扶桑东。\n赤轮飙驾出海上，须臾普照大地红。\n照见楼台如蜃起，咸池浴罢趋濛汜。\n大千世界有无间，电光明灭俱如此。\n此庵恍与飞云齐，俯视山河万象低。\n耸身直上云霄去，空中咿喔闻天鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37368,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云顶放歌","author":"欧必元","text":"罗山之峰高插天，下围紫翠凌苍烟。\n蓬莱一峰浮海至，两山相对参差连。\n飞云绝顶罕人迹，弱水迢迢天路隔。\n身轻倏忽摩天门，不用侯阳驱电策。\n我闻此地多瑶宫，楼台颢气乘鸿蒙。\n遍游别殿七十所，道逢丹女与芝童。\n我便抠衣向前揖，长跪愿乞丹砂粒。\n女童相笑不肯言，导我瑶宫左户入。\n身经贝阙几层城，会见群真宴玉京。\n群真詈我凡胎重，唐突如何谒太清。\n我魂惊悸不能语，遍身秖觉汗如雨。\n中有庞眉一老翁，列在仙曹为桂父。\n说我原从散圣班，天机漏泄堕尘寰。\n仙源傥有回头念，玉笈金书可次颁。\n忽闻此语如痴梦，但记丹经口中诵。\n顷刻群真罢宴归，觉来云锁深岩洞。\n乃知仙路元非遥，流水桃花过铁桥。\n云静天清如此夜，恍惚空中听玉箫。\n回看下界须臾景，目前山水俱泡影。\n何以身游天府间，下山明月松风冷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37369,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出罗浮寄谢唐博罗","author":"欧必元","text":"四百峰头览翠微，出山风雨带泉飞。\n凌空欲驭苍龙驾，解佩聊分玉女衣。\n不假王乔双舄去，那求葛令九还归。\n看君是处多题咏，郢调从来欲和稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37370,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入罗浮怀王大都督羽卿","author":"欧必元","text":"为访名山入惠阳，霞蒸回首隔扶桑。\n将军建武原名岳，居士琅琊本姓王。\n夹道赤松犹翠霭，几寻丹灶但苔荒。\n麒麟阁上功成后，倘勒峰铭亦不妨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37371,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韩孝廉宾仲邀饮山下草堂","author":"欧必元","text":"扁舟邀饮日流连，郭外寻幽亦有天。\n馆近朱明迷洞口，湖当青草长门前。\n閒披几席云犹湿，共醉枫林月正圆。\n多恐时清难更隐，北山猿鹤怨年年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37372,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜乐洞","author":"欧必元","text":"昔贤云清音，不在丝与竹。\n何似奏钧天，夜半应空谷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37373,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白云洞","author":"欧必元","text":"洞有真人宅，山留一片云。\n寻仙迷去路，鸡犬静中闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37374,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蓬莱洞","author":"欧必元","text":"地与三山通，兹岩乃一隙。\n中多羽化人，遗此蝉蜕迹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37375,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃源洞","author":"欧必元","text":"桃花产灵洞，开落已千秋。\n欲觅栽人处，唯看水上流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37376,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观源洞","author":"欧必元","text":"洞中有清水，流不到人间。\n洗药供杯酌，丹成见大还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37377,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蝴蝶洞","author":"欧必元","text":"蝴蝶自蘧蘧，群飞集仙洞。\n衣化是何年，揽却游仙梦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37378,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白莲池","author":"欧必元","text":"萏菡发香池，皎洁如仙鹤。\n时现水中花，间吐峰头萼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37379,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阿耨池","author":"欧必元","text":"清泉注神湖，派出凌云塔。\n池畔有神龙，听师夜说法。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37380,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洗耳泉","author":"欧必元","text":"兹池何日辟，洗耳浪传名。\n不遇巢由辈，安知泉水清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37381,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卓锡泉","author":"欧必元","text":"峰头贮天泉，涓涓石下滴。\n飞湍千丈流，不如师一锡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37382,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经罗浮山下陈村有感","author":"欧必元","text":"吾乡偶与此同名，鸡犬村中若有声。\n他日逢人问真隐，移家元欲傍朱明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37383,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜听邻舟美人琵琶同梁元珍李烟客赋","author":"欧必元","text":"江烟接素秋，乘夜荡轻舟。\n霜微叶随落，波平月不流。\n相逢似洛浦，乍闻如江洲。\n暗忆初停指，错断为凝眸。\n心曲凭谁写，凄清或自由。\n可怜狂客听，悲吟徒解愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳前二夕扶胥舟中赋得橹摇背指菊花开","author":"欧必元","text":"秋水自潆洄，潮生去棹催。\n但逐青枫冷，遥见黄花开。\n霜华侵澹月，香气扑馀杯。\n回首思三径，鸣榔送酒来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经湛文简钓台","author":"欧必元","text":"为想藏名地，增城胜富春。\n一出江门派，如乘宝筏津。\n烟波迷去棹，沙岸隐垂纶。\n谁是宫墙议，先朝忆老臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中赋得江清月近人","author":"欧必元","text":"万顷澄如练，三秋影渐圆。\n霜气侵衣袂，波光上客船。\n白处疑无岸，青浮但有天。\n鹭飞惊远渚，鹤唳凌空烟。\n请诵玄晖句，难成希逸篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日石龙舟中同诸子赋","author":"欧必元","text":"探奇诸子兴何豪，秋水兰桡许共操。\n为访名山元在望，非关佳节不登高。\n东篱未许酬黄菊，北海应凭醉浊醪。\n向晚江心明月上，天风疑泛度仙涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明霞篇","author":"欧必元","text":"凉秋九月风飕飕，江澄日净波不流。\n向晚渔船泊浅岸，乘凉游客荡轻舟。\n须臾海岛日将暮，虞渊返照映江树。\n锦绣长空忽乱垂，参差点缀应无数。\n初疑蜃气成楼台，又道鲛人室里裁。\n昆崙山上散为绮，王母池头进作杯。\n别有赤城天外见，紫翠丹房如汉殿。\n带月光摇绛女衣，随风飘送桃花片。\n绛衣花片杳冥间，蓬莱清浅问三山。\n羽士遥空恣轻举，山人服食驻颓颜。\n舟中偕游四五子，襟怀谁是烟云侣。\n操觚共赋明霞篇，安得风云生翰羽。\n我闻谷在朱明峰，山灵咫尺急相从。\n今日与君订幽约，莫惜杖屦真人踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别韩参知叔捷十年已偶游罗浮过访赠以诗","author":"欧必元","text":"蜀锦寄江头，翻思已十秋。\n谁言方岳贵，犹念布衣游。\n白社招陶令，青门忆邵侯。\n东山高卧处，今乃在罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入循州哭叶六敬亭","author":"欧必元","text":"秋来失意别，湖上哭君时。\n石洞成虚约，西州无乃悲。\n空传司马法，不草茂陵诗。\n满目阶前树，徒伤伯道儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经朝云墓 其一","author":"欧必元","text":"一片青山掩玉容，月明湖上想遗踪。\n行云纵得如神女，白鹤元非十二峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经朝云墓 其二","author":"欧必元","text":"孤坟无地不凄凉，吴越何曾隔异乡。\n妒杀风流苏小小，梦魂知不到钱塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒叶太保墓","author":"欧必元","text":"新冢累累傍郭阴，松楸湖上郁森森。\n生前已拼封侯骨，死后谁怜报国心。\n纪传自知惭马史，经游时或助龙吟。\n功臣敢谓恩波浅，落日澄潭烟水深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"博罗道中月夜闻新雁","author":"欧必元","text":"江心秋月满，江上澄潭清。\n试举蓬窗望，忽闻新雁声。\n高翻银汉影，凄断玉关情。\n海国来何暮，云端试一鸣。\n偏宜霜露冷，不畏稻粱轻。\n嘹喨推先后，联翩见弟兄。\n遥空疑裂帛，按柱学调筝。\n别却三河曲，桥居五穗城。\n自应因戈避，不更为弦惊。\n夫婿长离别，何曾事远征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入循州访公赏广文学舍","author":"欧必元","text":"几年违白社，今日访青毡。\n绕径植修竹，连床唯古编。\n一峰当户口，乱草长门前。\n共语经时别，犹胜访戴船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张守戎叶太仆携妓招同万伯文梁元珍邓伯乔李烟客饮湖心亭","author":"欧必元","text":"霞光山色夕阳天，箫鼓中流载画船。\n宾客醉时听玉漏，梁尘飞处落金钿。\n惊看节序黄花后，坐对尊罍绿草前。\n灯火背城明月夜，断桥堤柳锁寒烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"循州杂咏八首 其一","author":"欧必元","text":"惠阳元自古循州，地控龙江据上游。\n欲纪名山寻胜迹，片帆西下即罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"循州杂咏八首 其二","author":"欧必元","text":"郭外湖西烟水深，荒亭落日映湖心。\n游船傥得常歌舞，何必繁华羡武林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"循州杂咏八首 其三","author":"欧必元","text":"西风凄断到黄昏，新旧遗阡洒泪痕。\n已向麒麟悲往事，更从青草吊香魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"循州杂咏八首 其四","author":"欧必元","text":"先朝三疏足千秋，学士遗踪尚可求。\n傥过山前骑鹤去，月明人倚合江楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"循州杂咏八首 其五","author":"欧必元","text":"夫君山斗大名齐，宝筏当年可度迷。\n一自慈航东去后，谁言吾道不关西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"循州杂咏八首 其六","author":"欧必元","text":"甲第飞轮倚若云，狭邪城市路缤纷。\n从教冠盖来东陌，犹与山中鹿豕群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"循州杂咏八首 其七","author":"欧必元","text":"金银高挽髻边堆，称体蓝衫窄袖裁。\n非出城边吸江水，定从溪上浣纱回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"循州杂咏八首 其八","author":"欧必元","text":"幕府分营细柳军，旌旗城上压行云。\n前茅十里行人避，千骑东方让使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮书云台怀韩寅仲时寅仲已令遂安","author":"欧必元","text":"东篱三径傍城开，十载空悬梦寐来。\n云本无心疑出岫，游曾有约为登台。\n诗成郢调惊人句，墨副罗浮校乘才。\n闻道政成清似水，严陵滩下几潆洄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]