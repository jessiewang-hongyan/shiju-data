[{"title":"城南别叶夏集二首 其二","author":"李梦阳","text":"荷锄侈高咏，濯缨肆佳吟。\n畴知稼穑场，乃尔蒹葭侵。\n步风逾曾堤，徙筵趁重阴。\n于情既有托，瞩寓良自深。\n逶迤波上云，征征草间禽。\n峭台信巳古，巍城方肇今。\n验物果足遣，杯乾聊复斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54794,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庆都篇","author":"李梦阳","text":"于昭开帝则，荡荡协钦文。\n高辛初缵服，大舜复升闻。\n瞻依太古日，怅望春空云。\n缓策遵墟里，翱翔咏放勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54795,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"帝乙 其一","author":"李梦阳","text":"帝乙归元岁，沩汭降高秋。\n白雾凌苍璧，文烟结綵楼。\n枫陌三公引，云衢六马游。\n行当瞻月驭，伫想咏河洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54796,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"帝乙 黄衢二首 其二","author":"李梦阳","text":"黄衢会日月，紫气悬阴阳。\n冉冉神龙下，英英朱凤翔。\n兰烟凝玉阁，桂月满金堂。\n礼元歆九庙，德巳合无疆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54797,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"帝乙 其三","author":"李梦阳","text":"桂宫新降驭，蚕室烂生氛。\n曳绨成汉业，采葛相周文。\n会奉重轮日，先胆五色云。\n秋明天路夕，瑞雨碧氤氲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54798,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十二月朔","author":"李梦阳","text":"积阴凌紫极，玄雾暗三辰。\n黄龙游帝畤，万乘若浮云。\n六虬何蚴蟉，杂沓走天神。\n明王熙庶载，至敬达郊禋。\n玉辇亲牛豕，重瞳注鹿群。\n精诚先百物，咸德届牺人。\n扬銮回御道，九宇冀阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54799,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏歌","author":"李梦阳","text":"积潦溢广泽，炎云翳崇台。\n玉阶履綦绝，紫殿生莓苔。\n萤流疏竹静，风动绤帏开。\n佳期怅千里，竟夕以徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54800,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘妃怨","author":"李梦阳","text":"采兰湘北沚，搴木澧南浔。\n渌水含瑶彩，微风托玉音。\n云起苍梧夕，日落洞庭阴。\n不知篁竹苦，惟见泪斑深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54801,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春曲","author":"李梦阳","text":"萋萋百尺台，南临大道开。\n月明珠箔捲，尘暗宝车来。\n豪雄五都侠，意气万人摧。\n带醉穿林径，垂鞭拂阁梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54802,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"结客少年场行","author":"李梦阳","text":"灯如列宿行，月似九秋霜。\n番番七贵儿，灿灿五侯郎。\n杂沓凌香陌，徘徊竞夕光。\n各携万金剑，结客少年场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54803,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"侠客行","author":"李梦阳","text":"幽并豪侠地，燕赵称悲歌。\n千金市骏马，万里向交河。\n公卿赠宝剑，君王赐玉戈。\n捐躯赴国难，常令海不波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54804,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"从军行","author":"李梦阳","text":"弃家从上将，报主扫胡戎。\n弩满常随月，旗翻数起风。\n右指昆邪尽，左盻月支空。\n驰名紫塞外，开府玉关东。\n不逢百战日，谁识万夫雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54805,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出塞曲","author":"李梦阳","text":"单于寇边城，汉将列长营。\n旌旗蔽山谷，钲鼓昼夜鸣。\n乘我浮云骑，彀我明月弓。\n奇兵左右出，长驱向云中。\n彭彭阵结虎，飒飒剑浮虹。\n一战皋兰灭，再战沙漠空。\n归来献天子，长揖不言功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54806,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铜雀伎","author":"李梦阳","text":"帷飘雀台上，弦奏舞衣前。\n群悲一以望，春草为谁妍。\n芳岁销兰怨，流尘集锦筵。\n为问西陵道，孰与汉家阡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54807,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"漳津夕眺","author":"李梦阳","text":"扬舲乱北渚，靡盖望西陵。\n帐殿牛羊下，歌台麋鹿升。\n日夕松柏路，萧萧响风树。\n连沙改故浦，空山没苍茂。\n徘徊望霸气，邺城在何处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54808,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吕仙祠","author":"李梦阳","text":"孤游逢吕迹，永逝感卢生。\n眷彼炊梁术，契我遗世情。\n苍山故国道，落日邯郸城。\n阴阴祠宇夕，宛宛曲池清。\n不见金芝侣，谁闻朱凤声。\n田鼯穴桂壁，野葛蔓松楹。\n宁知往来者，不是寐中行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54809,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三月河上宴集","author":"李梦阳","text":"触霁迈芳坰，修韨临长洎。\n虽非曲觞饮，聊异秉蕳戏。\n波延拾翠舸，岸匝寻青骑。\n羽爵恋驰景，鸾箫剧春思。\n群谣狎凫雁，抚适欢同志。\n亦以扩凡超，流连岂吾事。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54810,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏乐溪","author":"李梦阳","text":"濯足荒溪口，延望大江浔。\n石树环碧綵，泉潭生翠阴。\n经亘涉清涟，沿洄登素岑。\n日暮樵响绝，但闻山水音。\n鸿雁遵渚飞，麋鹿聚空林。\n而子岂不乐，其如兼善心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54811,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠刘主事元瑞二首 其一","author":"李梦阳","text":"驾舟越洪川，飘风扬其波。\n白日不可驻，浮云一何多。\n搴芳涉北沚，采虻陟南阿。\n怅我平生友，伤此欲如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54812,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠刘主事元瑞二首 其二","author":"李梦阳","text":"濛濛孤舟夕，横笛坐烟浦。\n秋绿被汀沙，落雁不可数。\n烈调千行云，激商复流羽。\n曲竟和者谁，坐人泪如雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54813,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘江吟","author":"李梦阳","text":"对酒歌绿猗，岁宴怀佳人。\n山寒翠袖薄，微霰沾衣巾。\n空持紫鸾箫，欲致愁无因。\n日暮湘江曲，浩荡烟波春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54814,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春曲五首 其一","author":"李梦阳","text":"维南有曾城，下瞰梁王台。\n痽构翳云日，歌钟暮徘徊。\n芳草遍旧畿，山川邈悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54815,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春曲五首 其二","author":"李梦阳","text":"春城花烟满，杳霭生夕阴。\n白马系芳树，绣袪弹鸣琴。\n樗蒲少年子，一掷千黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54816,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春曲五首 其三","author":"李梦阳","text":"绮阁俯通阛，后有百尺楼。\n并坐紫罗茵，双引青玉瓯。\n扬花起薄暮，糁糁萦芳洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54817,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春曲五首 其四","author":"李梦阳","text":"菁菁艳阳月，郁郁美人思。\n游丝罥白日，炯若春风姿。\n零落垂手舞，空传白纻词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54818,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春曲五首 其五","author":"李梦阳","text":"借问美人居，云住城东隅。\n背有桃李馆，前临车马衢。\n十三妙歌舞，十五冠名姝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54819,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朔日","author":"李梦阳","text":"朔日悲风起，空除落叶平。\n犹闻砧杵急，巳复剪刀鸣。\n一夜传霜箭，黄云满塞城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54820,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"槿树","author":"李梦阳","text":"槿树依空砌，寒时尚著花。\n未能堪暮色，徒自绚朝霞。\n寄语闺中女，无多镜里华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54821,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"槿园","author":"李梦阳","text":"槿园秋气夕，唧唧寒螀聚。\n风回啼欲断，月落归何处。\n爰悲在堂吟，复咏山枢句。\n感尔中夜兴，微霜下庭树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54822,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春情","author":"李梦阳","text":"俗萦一何绵，驾言春巳分。\n绿郊鲜行轮，朱树花将纷。\n鸣雁起前墟，浮阳蔼东濆。\n徙倚孤台侧，伫回送征云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54823,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游寺","author":"李梦阳","text":"褊心俦辈寡，幽境每苔步。\n绵郁倚磴歇，冯孤眺迥屡。\n洞塔阴古宇，芬萝袅澄树。\n伫观野禽哺，此外岂吾虑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54824,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"升天行","author":"李梦阳","text":"市居苦烦溽，陆暑怀清波。\n缅思溪壑侧，丹崖卷曾阿。\n仙人挂树下，窈窕攀青萝。\n我独尘歊内，营营欲如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54825,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春游篇","author":"李梦阳","text":"古台悲帝子，歌吹馀春愁。\n草绿夷梁野，云浮河海流。\n击壶咏四泽，鼓钟眺三洲。\n扳条已无那，驾言谁倦游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54826,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四清篇","author":"李梦阳","text":"盘松屹当户，修筠静依槛。\n羁远桐丝涩，萧瑟鹤思减。\n归伤园坞废，坐令荒秽斩。\n弹曲憩疏荫，皋唳清露湛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54827,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"正德四年七夕上方寺作","author":"李梦阳","text":"逸人厌嚣俗，达士乐閒胜。\n乃兹城中林，而非车马径。\n积雨豁新霁，云石掩秋映。\n微阳下孤塔，潦水夹明镜。\n巳疑尘寰隔，况睹莲方净。\n岂惟慕真觉，亦以叩诠證。\n玄蝉共西夕，浮云本无定。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54828,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戊寅早春方方寺","author":"李梦阳","text":"逾年罔涉兹，过之门巷疑。\n匪畏霜露辰，肯与春事期。\n径兰芊故丛，苑松发新蕤。\n陟丘念废居，升危眺回漪。\n抱以幽旷豁，情缘悽怆移。\n惊风递虚塔，振振空廊悲。\n得遣复安较，劳生良尔嗤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54829,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夕集上方寺辛巳春","author":"李梦阳","text":"晨飙奋以厉，夕林回晏温。\n郊游怅伊阻，驾言乃松门。\n春湖静瑶宇，塔萝袅清樽。\n遥睇被原草，近搴临水荪。\n花雨时自落，法云凝复奔。\n淹留迟宝月，破此人径昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54830,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中","author":"李梦阳","text":"山中雨乍歇，一夜瑶草长。\n风吹翠岩竹，下应石濑响。\n时来展书坐，悠悠绝尘想。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54831,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"置薪","author":"李梦阳","text":"读书古木阴，置薪倚其根。\n露零石径滑，云起溪日昏。\n白虎启巍观，金马开高门。\n君自薄簪绂，难称国未恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54832,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九潭诗","author":"李梦阳","text":"岧岧千仞岭，下有百尺潭。\n夕风起微澜，浟浟动晴岚。\n俯之鉴我心，伫玩云波涵。\n流蕤飏寒清，跃鱼手可探。\n蹊暝樵响歇，猿鸟来相参。\n寄语泥中物，长蟠恐未堪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54833,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登东城楼晚下楼作赠同游数子二首 其一","author":"李梦阳","text":"登高散凉目，隤然日云暮。\n逃暑良巳恹，恋景复延顾。\n广野起暝色，层闉合昏雾。\n眷言楼中客，共此城上步。\n蚊虫扑面游，蝙蝠时自度。\n二仪但莽莽，一气黯回互。\n昼夜本定理，明晦非难悟。\n日入各言息，钟鸣复驰骛。\n崷崒宋帝阁，突兀信陵墓。\n往似宿沙禽，来如缀花露。\n徙倚千仞梯，长谣发悲愫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54834,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登东城楼晚下楼作赠同游数子二首 其二","author":"李梦阳","text":"盛阳丽楼台，烂如锦绣错。\n日入暝烟起，俯视但冥漠。\n即此悟人理，天道固可度。\n动静启晦明，代谢有今昨。\n凉飙逐夕兴，回声满虚阁。\n四顾水明灭，宿鸟喧相索。\n哑哑啼城乌，噭噭上云鹤。\n忉怛感晨暮，徙倚罢觞酌。\n北斗忽复低，西月隐长薄。\n闪烁海光动，翕沓氛雾廓。\n无恃黑头在，早定沧洲约。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54835,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄赠端溪子二首 其一","author":"李梦阳","text":"叹凤世巳远，悲麟竟何为。\n兰蕙秘幽岩，萧艾盈路岐。\n君子抱明德，伤也谁复知。\n随流非我心，特立乃见疑。\n亭亭南山松，匪无霜霰摧。\n寒蕤但不改，孤贞常自持。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54836,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄赠端溪子二首 其二","author":"李梦阳","text":"智者尚高契，达人慕希声。\n旷世有相感，同时怅难并。\n烈风起玄朔，百卉忽以零。\n登高望所思，慨焉念徂征。\n鸿雁序翅飞，麋鹿呦呦鸣。\n为言明馨子，盍簪终有成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54837,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠苍谷子","author":"李梦阳","text":"玄云翳白日，积阴何漫漫。\n风气日以凄，泥雨常不乾。\n漂萚委川涂，百卉良可叹。\n览物怀伊人，抚时悲凉寒。\n忧来如乱丝，理之棼无端。\n为霜念逝鹄，多露怨芳兰。\n所嗟声影隔，匪惧馨香残。\n徒把瑶华音，长谣望林峦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54838,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠刘潜","author":"李梦阳","text":"人生无常因，飘如风中云。\n昔别大江隅，今也长江濆。\n凉飙起霜夕，陨叶何纷纷。\n我菊有佳色，毅然独芳芬。\n迟速良有时，勉哉树高勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54839,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠崔子","author":"李梦阳","text":"鲲鱼游北溟，凤鸟翔南涯。\n扶摇非无运，鸣世自有期。\n显夫竞钟鼎，遁士潜蒿藜。\n驷马岂不荣，泉石安且怡。\n悠悠西山人，匪为薇蕨饥。\n寄言青云客，策勋及今兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54840,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠孙生","author":"李梦阳","text":"古人种桃李，不为搴其花。\n君子振英芬，岂在文与华。\n炎阳赫晴彩，百卉流丹霞。\n蕡彼东园实，累累一何嘉。\n采者自成蹊，举世徒咨嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54841,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠王生二首 其一","author":"李梦阳","text":"凤鸟世希有，众人常见疑。\n一朝下西周，戛焉鸣高岐。\n光彩照四极，观者惊以咨。\n神物耻自衒，卑鄙甘见欺。\n骥马匪伯乐，盐车空号悲。\n烨烨丰城剑，非华谁固知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54842,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠王生二首 其二","author":"李梦阳","text":"伯牙违钟期，有琴不复弹。\n兹意奚以取，良为知音难。\n得失有荣枯，合离成怨欢。\n万鹄戾天云，玄鸿渐河干。\n浅夫贵多矜，狭士贱自残。\n幸子固明志，显塞察所安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54843,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠崔生","author":"李梦阳","text":"伊昔振我衣，连步千仞冈。\n岩谷窈疑阻，岐径回羊肠。\n与者咸莫从，子也乃同行。\n举手撼天枢，纵目揽大洋。\n星斗何历历，海波浩茫茫。\n登山贵及颠，涉水非无航。\n愿言穷高深，念哉母相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54844,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠魏子二首 其一","author":"李梦阳","text":"霖潦久乃歇，晨兴送还辀。\n野寒泥淖盛，念兹途路修。\n人生苟相许，岂必曾绸缪。\n踟蹰东路岐，赠子双吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54845,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠魏子二首 其二","author":"李梦阳","text":"八月浙潮满，念子鼓南楫。\n海月团会峰，山风下江叶。\n里闾多宴娱，任宦有荣业。\n早回北向辕，昼日望三接。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54846,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三士篇赠医李郑张","author":"李梦阳","text":"严飙厉时威，稿叶下荣木。\n春风一以敷，病草奄回绿。\n天道岂常肃，人事有还复。\n七情既吾贼，六淫乃为殰。\n农经发玄旨，轩问扩英馥。\n代殊理易昧，行乘计相逐。\n陈荄抱绵息，寒根蕴真育。\n李生起专门，郑子振空谷。\n张也剖金匮，奏效更神速。\n饮橘秪自衒，种杏亦可恧。\n诵我三士篇，聊以助清穆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54847,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寺游别熊子四首 其一","author":"李梦阳","text":"天地固常尔，遇之情不同。\n但看摇夏树，何似飞秋逢。\n古来怨离人，岂必穷与通。\n默默两无语，坐披琳殿风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54848,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寺游别熊子四首 其二","author":"李梦阳","text":"夕风起凉阁，入耳松搣搣。\n当此佳胜区，谁忍遽离析。\n篇鹳戛戛鸣，萝翠满衣席。\n异时冠盖场，倘忆幽赏迹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54849,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寺游别熊子四首 其三","author":"李梦阳","text":"散眸七宝地，觞尔孤云台。\n一望碧云合，四面清风来。\n流影荡我前，炎树生秋哀。\n一笑问天地，劫灰安在哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54850,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寺游别熊子四首 其四","author":"李梦阳","text":"独立台上阁，俯兹城下湖。\n为问黄金鱼，径尺今有无。\n愚者人尽笑，贤之乃谤诬。\n二者吾适从，不如乘海桴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54851,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甲申中秋寄阳明子","author":"李梦阳","text":"风林秋色静，独坐上清月。\n眷兹千里共，眇焉望吴越。\n窈窕阳明洞，律兀芙蓉阙。\n可望不可即，江涛滚山雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54852,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠李世德","author":"李梦阳","text":"豢畜不生麟，鸾穴无鹯鹪。\n求水贵求源，佳木无亚条。\n李门世清修，三辈烨雄超。\n黄扉早杀翮，中叶乃沦凋。\n生也困逾励，奋飞竟云霄。\n大钓干神化，万物随生消。\n英英畹中蕙，化为艾与萧。\n愿坚谋始心，全我全石要。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54853,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄赠玉溪子","author":"李梦阳","text":"松桧不栖蝉，熊皮不上蚁。\n秉性死不易，斯足验人理。\n苟投信若饴，义交固如水。\n如水遐则思，若饴背乃毁。\n悠悠徂暑月，眷眷念君子。\n霍云停复飞，汾水荡而驶。\n山西回夕阳，皎如觏光美。\n徒操孤绝弦，叹息竟何以。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54854,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初秋上方寺别郑生","author":"李梦阳","text":"胜地亮常尔，佳士难屡并。\n未穷结驷游，遽复扬帆行。\n古林郁城隅，石门敞幽清。\n趁风选浓荫，布席觞群英。\n竹凉时自来，残暑骄未平。\n戒饮今二期，为子杯一倾。\n义投不在故，迹远心自萦。\n念兹徘徊意，时哉树嘉名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54855,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠郑生三首 其一","author":"李梦阳","text":"杪秋木叶脱，霜露告成岁。\n驱车溯寒郊，触物念征迈。\n戒舟有程日，维驹阻心爱。\n所幸旦暮留，前途或风濑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54856,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠郑生三首 其二","author":"李梦阳","text":"伊予解组归，汝也美少年。\n骏马臂两弓，射猎梁王川。\n感子重意气，授之黄金鞭。\n万里不易致，悲鸣为谁前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54857,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠郑生三首 其三","author":"李梦阳","text":"英英百寻木，时至乃黄落。\n楚楚青俊郎，还家鬓萧索。\n桂树寒正荣，溪鱼白而跃。\n山行采瑶草，寄我长生药。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54858,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]