[{"title":"罗浮山和邹方伯四首 其四 水帘","author":"庞嵩","text":"绝壁开云扃，飞湍作帘挂。\n因风时捲舒，巧入诗人画。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4358,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙池寺四首 其一 白云崖","author":"庞嵩","text":"云来山有衣，云去山呈骨。\n白云自有无，万古山常兀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙池寺四首 其二 后龙顶","author":"庞嵩","text":"蝘蜒苍龙蟠，此是龙之首。\n迅雷昼日翻，列缺云中吼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙池寺四首 其三 避暑窟","author":"庞嵩","text":"山中无甲子，地窟疑长秋。\n夏日人登览，仍添集翠裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙池寺四首 其四 鸡冠石","author":"庞嵩","text":"午夜漏虹光，出岩观海日。\n天鸡浑未鸣，已见鸡冠出。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方塘四景 其一 春景","author":"庞嵩","text":"春雨夜初歇，源泉晓发时。\n无风尘欲静，水面见玻璃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":4363,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方塘四景 其二 夏景","author":"庞嵩","text":"暑翳云中敛，寒光镜面开。\n冰霜涵六月，疑渡水晶来。","collection":"明","