15f84d192fe5294295f79689","path":"明_1.csv","pointer":23711,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄旷知事伯逵四首 其一","author":"刘崧","text":"昔别已千里，新愁复四年。\n风尘不可见，江海一凄然。\n才想群公荐，名因过客传。\n东南藩镇重，独觉省郎贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23712,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄旷知事伯逵四首 其二","author":"刘崧","text":"抱檄诉邻饥，开关破贼围。\n近随兵帐出，远送米船归。\n吴水波涛恶，西山草树稀。\n艰危知共济，莫遣壮心违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23713,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄旷知事伯逵四首 其三","author":"刘崧","text":"闻说移居地，还依孺子亭。\n对门湖共白，一路柳长青。\n仕已沾恩露，庭应聚德星。\n谁能远车马，况不异郊坰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23714,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄旷知事伯逵四首 其四","author":"刘崧","text":"郡邑溪山在，风尘寇盗馀。\n长怀管宁去，未卜屈原居。\n计拙忧虞剧，閒多礼法疏。\n柴门春草满，惊捧故人书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23715,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"即事","author":"刘崧","text":"此日螺山下，春深草谩多。\n官船依近郭，寇垒隔长河。\n市缺新年酒，田荒旧种禾。\n忧危仍寂寞，回首飒悲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23716,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"承曾子硕自洪归赣道次太和以故人旷伯逵书问见及临别怅然诗以送之","author":"刘崧","text":"阁下帆初落，江干雨正疏。\n感君千里意，远致一封书。\n旧宅蓬蒿遍，新愁瘴疠馀。\n冥冥更南上，烟浪满寒虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23717,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过王氏南园看竹刘以和携酒至共酌林间 其一","author":"刘崧","text":"王子时相见，刘郎晚共携。\n邀人竹林下，沽酒石桥西。\n林绚甜椔发，畦深苦藚齐。\n徘徊未能饮，着意鸟频啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23718,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过王氏南园看竹刘以和携酒至共酌林间 其二","author":"刘崧","text":"禁得南园笋，新成数百竿。\n何年通一径，长有客来看。\n露叶沾重席，烟梢拂小冠。\n风湍听不定，况复近江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23719,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过王氏南园看竹刘以和携酒至共酌林间 其三","author":"刘崧","text":"磊磊苍苔石，娟娟翠筱林。\n圃畦分晓色，邻屋借秋阴。\n日转游丝细，天寒聚雀深。\n独无三亩地，种汝伴清吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23720,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过王氏南园看竹刘以和携酒至共酌林间 其四","author":"刘崧","text":"节下题诗遍，林间送酒迟。\n亦愁春雨里，共爱晚晴时。\n斩玉嗔初见，移根任所为。\n长令扫苔石，来此赴幽期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23721,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次颜用行留别韵二首 其一","author":"刘崧","text":"昔避乌仙洞，归来又六年。\n乡园各奔散，寇盗竟缠连。\n愁共将零叶，身如不系船。\n艰危惊再见，未有买山钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23722,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次颜用行留别韵二首 其二","author":"刘崧","text":"叹息泸源上，何时寇盗平。\n凄凉惊往事，浩荡怯孤征。\n世乱欢娱少，时危出处轻。\n送行频惜别，落日最伤情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23723,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仲秋八日赴洪都应试夜宿盐堆头","author":"刘崧","text":"花石耀寒星，盐头隐暮汀。\n风沙开漠漠，烟浪入冥冥。\n战鼓秋初急，羁愁夜不醒。\n故园西岭外，渐隔两长亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23724,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"桐江","author":"刘崧","text":"残垒带江沙，荒祠集暮鸦。\n客行桐水市，人采木绵花。\n山掩飞烟直，江浮落日斜。\n旧游那可问，依约见人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23725,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阑泊口","author":"刘崧","text":"一岸危于削，群山隐似围。\n豺狼前日盛，市井近来非。\n古屋蓬蒿遍，荒村鸟雀稀。\n还闻覆巢日，烈火照天飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23726,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新淦","author":"刘崧","text":"乱山淦水上，雨气白如烝。\n古塔遗孤表，荒壖散百层。\n贾船初放桨，鱼屋稍悬罾。\n近有官军守，科征恐未能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23727,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过峡江","author":"刘崧","text":"石峡閟苍烟，江流似昔年。\n戈船犹自守，草市稍相连。\n白骨青山下，黄蒿古道边。\n石桥携酒处，风雨一凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23728,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题春山烟雨图","author":"刘崧","text":"崖溜下林陂，春云带雨垂。\n不知村远近，惟见树参差。\n柳巷闻莺早，桃溪放犊迟。\n乱馀宁有此，愁绝辋川诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23729,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张子明归武夷","author":"刘崧","text":"东去渡沙关，宁辞道里艰。\n云连闽海郡，家近武夷山。\n腊酒鹅儿碧，春衣稚子斑。\n徘徊南浦上，别恨不能攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23730,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题云林别墅图为黄子邕赋","author":"刘崧","text":"云薄黎川水，月明萧曲峰。\n寒沙闻落叶，绝顶见长松。\n别墅携壶兴，深林蹑屐踪。\n秋江愁不渡，谁共采芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23731,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再赋","author":"刘崧","text":"种树萧峰下，结茅黎水滨。\n疏星澹将夕，众草忽已春。\n遭乱去故里，临图忆高人。\n怅言赴归日，从子理荒榛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23732,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送省掾刘宗弼之岭南买官马","author":"刘崧","text":"烽火暗崇江，官船发豫章。\n千金求骏马，万里入南荒。\n倚剑看明月，停杯问故乡。\n相臣忧国意，注目倚腾骧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":23733,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]