[{"title":"诸将八首 其一","author":"李梦阳","text":"穆张亦是枭雄将，胶柱谈兵实可怜。\n力屈杀身同一地，丧师辱国在今年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56193,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"诸将八首 其二","author":"李梦阳","text":"诸将才猷岂尽奇，大都力战各乘时。\n黄毛近怕庄游击，黑面休誇李太师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56194,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"诸将八首 其三","author":"李梦阳","text":"闻说当时扫地王，威名朔漠阵堂堂。\n自称大将张旗鼓，首控骅骝出战场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56195,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"诸将八首 其四","author":"李梦阳","text":"但富黄金与白珠，登坛拥众镇边隅。\n即使勉攀貂玉贵，终然不类将门趋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56196,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"诸将八首 其五","author":"李梦阳","text":"国公承袭惟纨裤，侯伯虽多大抵同。\n旧典此中抡大将，平江英保是元戎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56197,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"诸将八首 其六","author":"李梦阳","text":"紫塞长城万古悲，堑山还复见今时。\n臊奴秪益轻专制，老耄何堪锐出师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56198,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"诸将八首 其七","author":"李梦阳","text":"天下军储尽海头，材官郡国遍防秋。\n若道成功无造伪，岂应屠贾坐封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56199,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"诸将八首 其八","author":"李梦阳","text":"黄河青海入狼烟，汉将胡兵杀气连。\n安得即时寻魏绛，务农休甲报皇天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56200,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆昔六首 其一","author":"李梦阳","text":"巳巳蒙尘数郭登，驰驱国难有杨弘。\n如今岂乏熊罴辈，比较元非击搏能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56201,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆昔六首 其二","author":"李梦阳","text":"北望黄云想翠华，千官徒跣哭清笳。\n安危社稷惟司马，天下车书又一家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56202,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆昔六首 其三","author":"李梦阳","text":"石亨善战真无比，跋扈飞扬却累身。\n佩剑岂宜恩死士，拖金终要作诚臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56203,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆昔六首 其四","author":"李梦阳","text":"王宏犯阙虽愚戆，舍命临危亦丈夫。\n犹胜须眉为妇女，更怜冠剑学儿徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56204,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆昔六首 其五","author":"李梦阳","text":"吉祥宠幸反称兵，一夜达官尘满城。\n悖逆天诛终不赦，此曹王法更须明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56205,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆昔六首 其六","author":"李梦阳","text":"半夜飞章入凤楼，寇公流血李公忧。\n尔曹作逆同蒿草，臣节江河万古流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56206,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"京师春日漫兴五首 其一","author":"李梦阳","text":"十日不出花尽开，城南城北锦成堆。\n即教闭户从花尽，莫遣看花不醉回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56207,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"京师春日漫兴五首 其二","author":"李梦阳","text":"杏花盈盈大逞姿，桃花灼灼亦不迟。\n纵饶种露栽云地，可柰风狂雨骤时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56208,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"京师春日漫兴五首 其三","author":"李梦阳","text":"东门百花红照天，独树梨花更可怜。\n但看弦管朝朝急，不道春风不费钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56209,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"京师春日漫兴五首 其四","author":"李梦阳","text":"今番花开委难当，眼见稀疏叶欲长。\n春光几朝不一醉，为问汝曹因底忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56210,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"京师春日漫兴五首 其五","author":"李梦阳","text":"西湖湖上杨柳枝，临流袅娜风更吹。\n切防白云漫天舞，莫放黄金拂地垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56211,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"牡丹五首 其一","author":"李梦阳","text":"乱絮繁华春更烟，一枝袅袅独风前。\n玉园忽漫无颜色，徐步看君却自怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56212,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"牡丹五首 其二","author":"李梦阳","text":"若使姚黄无魏紫，孰容倾国复倾城。\n接枝一任今人笑，不坠花王万古名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56213,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"牡丹五首 其三","author":"李梦阳","text":"莫道清平调独狂，牡丹元不与昭阳。\n后来亦是先花叶，谁醉君王玉笛傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56214,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"牡丹五首 其四","author":"李梦阳","text":"秦地洛阳俱寂寞，圃开周国复天香。\n童时及见流传谱，万意千心足断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56215,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"牡丹五首 其五","author":"李梦阳","text":"漫山故国花无数，客舍河头今数株。\n绝代色孤终不掩，丹葩绿叶锦心须。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56216,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊园步花二首 其一","author":"李梦阳","text":"常苦出城花不开，花开今日共风来。\n亦知谁便渠能主，独步徐看数十回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56217,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊园步花二首 其二","author":"李梦阳","text":"即使怜花何恁苦，不如开落任风吹。\n花开花落从渠得，柰记栽桃种柳时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56218,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"步庭海棠下四首 其一","author":"李梦阳","text":"买宅兼花事亦希，树成春足主人归。\n花开巳诧胭脂透，叶展还惊翡翠围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56219,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"步庭海棠下四首 其二","author":"李梦阳","text":"若较梨花憎太白，纵多桃李叶全无。\n何如翠袖红妆倚，的的黄须锦瓣扶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56220,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"步庭海棠下四首 其三","author":"李梦阳","text":"独恨无香恐未真，纷纷蜂蝶底相亲。\n俗传定欲烧银烛，绝代谁为照睡人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56221,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"步庭海棠下四首 其四","author":"李梦阳","text":"沉香亭上已多欢，梦入昭阳月色寒。\n若使天香亦倾国，君王应更倚阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56222,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏庭中千瓣榴花三首 其一","author":"李梦阳","text":"药栏尔后花希赏，日日东斋只困眠。\n每易庭榴树底小，一朝开亦照高天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56223,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏庭中千瓣榴花三首 其二","author":"李梦阳","text":"的的朱榴夏始成，水帘冰簟益分明。\n偏枝不动宜雏燕，接叶时披称小莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56224,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏庭中千瓣榴花三首 其三","author":"李梦阳","text":"万瓣千须始一花，累累应只为年华。\n春风无限倾城萼，结实谁真取世誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56225,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪中见枯树似梅二首 其一","author":"李梦阳","text":"忆在江南梅照眼，几年繁蕊失溪云。\n如何枯树寻常见，一雪垂花朵朵分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56226,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪中见枯树似梅二首 其二","author":"李梦阳","text":"可向繁枝问假真，纷纷过眼即飘尘。\n东风一夜高楼篴，乱落江梅谁柰春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56227,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜雨三首 其一","author":"李梦阳","text":"破到榴花今日雨，向来红紫可怜吟。\n蝶沾蜂湿徒增忌，杏绿梅黄亦苦心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56228,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜雨三首 其二","author":"李梦阳","text":"二麦临河半欲黄，一夜生长谁禁当。\n挥锄荷笠能辞苦，浪泼云翻虑尔忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56229,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜雨三首 其三","author":"李梦阳","text":"水缺沙乾燕只忙，交交莺羽闪无光。\n今辰底恁穿杨急，拍拍衔泥向我堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56230,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夷门曲二首 其一","author":"李梦阳","text":"黄河岸头多容船，大堤小堤杨柳烟。\n独树花开特造次，邻家香醪不索钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56231,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夷门曲二首 其二","author":"李梦阳","text":"南堤二月杏花红，北堤高楼红映空。\n珊瑚宝玦谁家子，系马门前青树中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56232,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新水至二首 其一","author":"李梦阳","text":"桃花照水杨柳长，河水新添一尺强。\n昨夜舳舻衔尾至，不是鱼航是酒航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56233,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新水至二首 其二","author":"李梦阳","text":"时和驿边河水流，康王城近舍西头。\n青蘋两眼汀洲里，芳草连天无那愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56234,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"狂风三首 其一","author":"李梦阳","text":"狂风吹柳袅袅长，杏花落地如白霜。\n后来好花开细细，昨朝风恶更难当。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56235,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"狂风三首 其二","author":"李梦阳","text":"来禽青李不须猜，一日一夜桃花开。\n朝来春风休更恶，枝头绿叶暗相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56236,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"狂风三首 其三","author":"李梦阳","text":"新筑茅斋近北堂，喜有杨柳千尺长。\n不争一朝风折尽，赤日炎天何处凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56237,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河上","author":"李梦阳","text":"河上昨宵风势恶，狂花不敢更高飞。\n农夫日望甘霖至，估客深愁逆浪归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56238,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂咏","author":"李梦阳","text":"春尽梁园花不稀，随风片片坐人衣。\n丁宁百舌浑休语，遮莫林莺且自飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56239,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"睹小儿吟诗戏作绝句","author":"李梦阳","text":"关中韦杜世称豪，王谢江东底更高。\n兰苕翡翠空啾唧，肃肃云鸿万里毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56240,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东园花树下二首 其一","author":"李梦阳","text":"夜来睡美春风颠，朝望大梁花满烟。\n钱家东园好李树，堪可铺排无酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56241,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东园花树下二首 其二","author":"李梦阳","text":"今年春色太无赖，千树万树花分明。\n便学少年出走马，更抛香弹打流莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56242,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登台","author":"李梦阳","text":"梁孝台前白杏花，眼看风落散晴沙。\n黄鹂恰恰谁为侣，紫燕飞飞自作家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56243,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻桃花盛开","author":"李梦阳","text":"不及东园红杏时，梨花懊恼太开迟。\n即防桃李红欺眼，更打黄蜂莫近枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56244,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张池春日即事","author":"李梦阳","text":"东门野塘花树红，昨日不风今日风。\n倒著接䍦习池上，狂调生马竹林中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56245,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"漫兴二首 其一","author":"李梦阳","text":"白水苍山万里身，咏花吟鸟百年人。\n城门此路怜芳草，盏酒他乡不是春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56246,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"漫兴二首 其二","author":"李梦阳","text":"杨柳春江对自流，清沙白石伴谁游。\n弋人莫羡能鸣雁，海叟虚疑不动鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56247,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"钱园二绝句 其一","author":"李梦阳","text":"去年钱园万李树，落莫今春只数枝。\n多应斩伐贫人卖，岂复能思烂熳时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56248,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"钱园二绝句 其二","author":"李梦阳","text":"墙东李树太含胡，院背夭桃斩不枯。\n及早荣枯休浪拟，趁时车马自应趋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56249,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"城南别业","author":"李梦阳","text":"傍堑沿堤二里馀，柳墙茅屋此成居。\n浣花便拟吾何忝，独愧穷愁懒著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56250,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日豫章杂诗十首 其一","author":"李梦阳","text":"东角楼东寒食日，吾家海棠双树花。\n忽忆花开吾在此，豫章寒食独思家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56251,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日豫章杂诗十首 其二","author":"李梦阳","text":"乱蕊浓花今有无，旧趋北阙忆西湖。\n垂杨画鹢金鞍戏，三月烟花满上都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56252,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日豫章杂诗十首 其三","author":"李梦阳","text":"每爱高楼畏独来，非关觔力怕徘徊。\n江头无限桃花树，恰到来时满眼开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56253,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日豫章杂诗十首 其四","author":"李梦阳","text":"江花照水两三枝，弄日吞烟是尔时。\n不应春风与作意，挂断低空百尺丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5