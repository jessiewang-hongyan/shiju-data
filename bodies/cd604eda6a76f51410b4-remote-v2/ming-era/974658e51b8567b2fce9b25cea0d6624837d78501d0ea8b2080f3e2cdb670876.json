inter":30877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬至日镇江道中","author":"张弼","text":"万户笙歌长至日，一蓬风雨远行人。\n买鱼沽酒俱收市，且自煎茶洗客尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"台郡叶太守寄文贺寿赋此志谢","author":"张弼","text":"琅函仙语出天台，白鹤青鸾特送来。\n付与诸郎歌且舞，恍肰身世醉蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郭总戎率僚吏饯予于查山初发矢有雉惊起于麦陇继发一矢雉即毙众惊喜而贺予口占一绝","author":"张弼","text":"查阜前头雊雉肥，一飞白羽锦离披。\n辕门竞为将军贺，帖帖海波无是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢赵弘济进士携酒至兼简丁编修","author":"张弼","text":"潘安原是种桃徒，冷淡寒香不足娱。\n独有柴桑陶靖节，西风时复一提壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"翰林编修丁原敬屡约不至作此问之","author":"张弼","text":"别后相期屡负期，多应中酒苦吟诗。\n独餐鸡黍花前坐，好鸟嘤嘤知为谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与雪崖叶都宪饮于弘济园亭先有待姬而却之听叶景阳秀才弹琴二首 其一","author":"张弼","text":"锦树西风啼栗留，小春天气亦风流。\n水亭又听南薰调，人在蓬莱第一州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2