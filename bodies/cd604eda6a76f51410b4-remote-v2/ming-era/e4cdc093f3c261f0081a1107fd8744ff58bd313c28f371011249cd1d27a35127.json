[{"title":"苦疡出息东郊田舍二首 其二","author":"顾璘","text":"明月入我帷，照见床头书。\n揽之起坐读，冥心向黄虞。\n君王既神圣，黎庶俨如愚。\n礼乐少虚文，法令颇宽舒。\n民力尽耕凿，暇乃事畋渔。\n生无冻饥苦，死也何羡馀。\n浩荡宇宙间，聚散任所如。\n周公太多事，六典过爬梳。\n遂令斯鞅辈，展转生虫蛆。\n燎原日以甚，伊谁之过欤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56749,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽居十二咏和鲁南 其一 煮茗","author":"顾璘","text":"为有馀酲在，还牵睡思繁。\n汲泉敲石火，先试小龙团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56750,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽居十二咏和鲁南 其二 焚香","author":"顾璘","text":"烟生沈水细，火宿博山温。\n鼻观自相媚，无劳矜返魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56751,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽居十二咏和鲁南 其三 洗砚","author":"顾璘","text":"旧污涤乃去，新美净乃留。\n清清池水侧，与尔勤交修。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56752,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽居十二咏和鲁南 其四 检书","author":"顾璘","text":"眼迷四库籍，手倦三绝编。\n愿寻橐驼传，送此龙钟年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56753,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽居十二咏和鲁南 其五 扫径","author":"顾璘","text":"清心唯素月，满意祇苍苔。\n落叶时相妒，那能不扫开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56754,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽居十二咏和鲁南 其六 捲幔","author":"顾璘","text":"每报庭花发，烦余捲幔看。\n东风先会意，吹搭小阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56755,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽居十二咏和鲁南 其七 移榻","author":"顾璘","text":"花开前后圃，月照东西檐。\n总为怜花月，移床不自嫌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56756,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽居十二咏和鲁南 其八 拭几","author":"顾璘","text":"游尘彼何物，暗我净几光。\n拂拭诚多劳，憎爱各有常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56757,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽居十二咏和鲁南 其九 养蒲","author":"顾璘","text":"芳根恶浮尘，纤叶爱澄露。\n它生愿化汝，濯濯居净土。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56758,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽居十二咏和鲁南 其十 灌花","author":"顾璘","text":"众芳植庭曲，地润花自饶。\n物情苟相赖，可惮抱瓮劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56759,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽居十二咏和鲁南 其十一 摘蔬","author":"顾璘","text":"右丞斋露葵，拾遗饭苍葈。\n朱门竞肥秾，野老独宜此。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56760,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽居十二咏和鲁南 其十二 种树","author":"顾璘","text":"种树取柔条，人言老难待。\n所贵适目前，胡为计身外。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56761,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜雨柬东邻陈叟","author":"顾璘","text":"草阁平池细点分，柴门杂树乱声闻。\n游龙倒吸沧江水，舞鹤低翻紫阜云。\n田舍病来怀稔岁，山瓶喜极判沈醺。\n莫欺老手扶犁怯，荷策驱牛未让君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56762,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"复雨","author":"顾璘","text":"松林云气拂人流，茅屋雨声鸣不休。\n庭潦旋添鹅鸭喜，稻苗先慰雁鸿谋。\n疏帘寂静宜书卷，野壑苍茫忆钓舟。\n寄语邻翁多酿酒，放歌沈醉送清秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56763,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"作亭后丘之上名清旷系之短吟","author":"顾璘","text":"蓬莱微茫不可求，匡庐迢遰非易游。\n掌中佳景任揽撷，不如后圃登吾丘。\n吾丘清旷招远风，谢客妙语遗山翁。\n古今乐事留宇内，天地于我何终穷。\n天印苍苍钟陵紫，左右倒影山杯里。\n白鸟南穿楚岫云，片帆东落吴江水。\n卢鸿草堂何处开，陶令柴车日往来。\n花间筑室支丹灶，石底穿池立钓台。\n形胜随心动生趣，讴吟触口皆成句。\n无官迹已混樵渔，有家誓不关婚娶。\n高空雕鹗横秋目，近舍流莺鸣夏木。\n但愿丰年秫米熟，山翁烂醉死亦足。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56764,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"午日","author":"顾璘","text":"五月五日在田舍，城郭风光应自新。\n燕女綵丝缠蝎尾，吴儿画楫斗龙鳞。\n山中祇见榴无色，病后初知艾有神。\n落日一杯桑柘底，邻翁相对野情真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56765,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东郊田舍戏占","author":"顾璘","text":"北望紫山横紫烟，南窥天印削青天。\n柴门古木行荒径，柳堰回溪抱野田。\n蕉叶舞墙凡几处，藤根萦石自何年。\n穿巢鸟鹊初将子，落簇红蚕已上绵。\n行客卖茶微雨里，农夫依饷古槐边。\n身抛岁月何须记，地远尘埃亦自怜。\n卖却异书多买犊，收将狂性且逃禅。\n申屠即树成居屋，陶令逢人馈酒钱。\n云至剩添閒伴侣，花开新得小婵娟。\n眠惊鹤啄弹琴石，坐爱鱼吞洗墨泉。\n四大有生皆梦幻，一真无累即清玄。\n所希畏垒庚桑子，莫羡丹阳葛稚川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56766,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忧旱二首 其一","author":"顾璘","text":"南国久无雨，皇皇六月交。\n池乾鱼伏网，林热鸟移巢。\n淬魃临祠庙，迎龙就涧坳。\n祇愁秋稼尽，何以度衡茅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56767,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忧旱二首 其二","author":"顾璘","text":"野人遗世虑，水旱独关渠。\n垤鹳鸣何验，江龙饮亦虚。\n田畴堪一哭，祷祀竟何如。\n夜坐看星月，临风益叹歔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56768,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"松坞答鲁南对月见忆之作","author":"顾璘","text":"良宵爱对空山月，赤旱愁侵独坐人。\n江鹳不将时雨至，林乌还带晚霞新。\n家依百亩心同切，地隔孤峰梦亦频。\n野寺相随又相别，人间离合本无因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56769,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋至亭上","author":"顾璘","text":"关心唯碧树，豁目更苍岑。\n雨喜蜻蜓出，秋惊蟋蟀吟。\n狂歌穿竹响，瘦影照池深。\n岂好逃城市，喧嚣自不禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56770,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"屏山田舍","author":"顾璘","text":"小溪风露带渔舲，曲坞松杉接草亭。\n夜久野云横树白，秋高山色过江青。\n长亲拙政知农事，暂学清斋适性灵。\n独笑吴中狂处士，强将身比少微星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56771,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"食菌","author":"顾璘","text":"嵇康食石髓，安期枣如瓜。\n虚无不可致，想像生咨嗟。\n深谷隐松桂，雨露抽灵芽。\n名齐金光草，品异仙掌茶。\n采采供晨飧，色瑩味亦嘉。\n金膏溢齿颊，五内生云霞。\n腥腐一以荡，神明发精华。\n吾闻古灵仙，饵芝乃升遐。\n从兹谢厚味，服尔登云车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56772,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋山中夜起玩月","author":"顾璘","text":"中秋万古月，城阙玩每同。\n今年展奇观，对此空山中。\n圆魄出东岭，海气开洪濛。\n长风扫浮翳，清辉荡遥空。\n吴山翠千点，错列指顾中。\n澄江动虚影，下彻鼋鼍宫。\n天地同一色，苍茫浩无穷。\n顾兔露其爪，冥冥避高鸿。\n把酒发商歌，声激河汉东。\n古今一瞬息，过客犹转蓬。\n而我寓宇内，薨薨侣微虫。\n生存不自乐，溘死徒忡忡。\n鸡鸣且莫寝，坐迟初阳红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56773,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山夜","author":"顾璘","text":"秋气振庭枝，山空响易悲。\n草寒蛩语涩，树老鹊巢危。\n古道因书得，衰颜赖酒持。\n未忘蝉蜕念，真笑虎头痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56774,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"积雨","author":"顾璘","text":"积雨蓬门客过稀，野人吹火炙寒衣。\n禾畴乳鸭鸣相乱，柳径愁鸦坐不飞。\n抱膝漫吟梁父曲，劳心真厌汉阴机。\n清泉白石从吾好，驷马高车悟昨非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56775,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋思","author":"顾璘","text":"露下风高燕雁斜，秋光平落楚江涯。\n霞绡堕树飘枫叶，雪浪排溪涨苇花。\n爱酒虽贫多酿黍，避人无事远移家。\n经旬积雨怜衰病，断绝门前问字车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56776,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"野步","author":"顾璘","text":"出郭病身健，还山秋日长。\n云光漏疏木，岚翠集虚堂。\n远害愁防虎，全生拟牧羊。\n那知岩壑外，随步有康庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56777,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"野兴三首 其一","author":"顾璘","text":"花岩控牛岭，连峰碧嵯峨。\n秀色亘千古，我生能几何。\n行几苦难屡，筑室枕其阿。\n坐卧长对之，所获庶可多。\n朝云结丹绮，夕月流金波。\n采之鍊真液，永以蠲沈痾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56778,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"野兴三首 其二","author":"顾璘","text":"落日满秋野，独步登平丘。\n山经夜来雨，寒泉出溪流。\n缅怀古时人，开荒广良畴。\n深山寡人力，劳此千岁谋。\n去者水长逝，存者纤云浮。\n往来但瞬息，百虑徒煎忧。\n不如饮美酒，坐啸空岩幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56779,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"野兴三首 其三","author":"顾璘","text":"苍隼摩天飞，黄鹄志千里。\n秋空莽寥阔，快尔南溟徙。\n浮云东北生，风雨飒然至。\n六翮困沾湿，吹之堕寒水。\n南山松桂阴，西畴稻粱美。\n万事难预期，不如早栖止。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56780,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜坐","author":"顾璘","text":"白露中夜寒，蟋蟀鸣床下。\n簌簌葛衣裳，惨淡谢炎夏。\n闺人戒机杼，田畯课场稼。\n眷此岁载阴，蹇予日多暇。\n朱颜黯以苍，短发不盈把。\n商战讵能肥，蘧年未知化。\n兀兀迷陈编，何以酬夙夜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56781,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"邻叟见过","author":"顾璘","text":"场雀惊且飞，篱犬隔树嘷。\n开门见田父，饷我携浊醪。\n寒暄甫及席，首陈入城劳。\n继云太庙灾，策免数大僚。\n京兆岁大比，荐拔多英豪。\n请君望泰阶，清平在崇朝。\n闻言谢田父，野语胡大谬。\n我袖恨不长，无以掩君口。\n进退国大政，柄在相与后。\n挥霍如云雷，小民但奔走。\n尔我服稼穑，所忧唯百亩。\n出位而妄言，它人恐相诟。\n山厨蒸藜熟，与君酌君酒。\n明月生东山，移床就衰柳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56782,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽怀二首 其一","author":"顾璘","text":"文章经纬业，制作贵有程。\n六籍出元圣，道奥非华英。\n自从删述来，尔雅存西京。\n马迁缀古史，笔力驱沧溟。\n苏李起介胄，诗辞霭和平。\n今观宇宙间，日月垂天明。\n小儒竞绮丽，琐屑如繁星。\n吾衰志未泯，愿缔诸贤盟。\n扬雄强模拟，何啻苍蝇声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56783,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽怀二首 其二","author":"顾璘","text":"昌黎文章伯，后代罕俦匹。\n李杜虽云雄，气格差甲乙。\n奈何赋长篇，退让如自失。\n想像巨刃扬，魂魄生战慄。\n乃知作者苦，穷探极幽密。\n譬对百战场，动静慎师律。\n守正兼设奇，变化贵神出。\n左车井陉谋，淮阴几见绌。\n多畏乃胜人，名家有深术。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56784,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"散步","author":"顾璘","text":"理生就田畴，辞喧出闾里。\n自叹乏高风，时归念妻子。\n栖鸦迷夕岚，浮雁唳寒水。\n散步数群峰，日从天阙始。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56785,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋对月和罗女文","author":"顾璘","text":"高秋明月满天凉，露坐风生薜荔裳。\n蟋蟀近床还独语，蟾蜍离海已深藏。\n人间忽敞清虚府，地上平铺雪霰光。\n笑玩素娥敲药杵，不劳银汉问舟航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56786,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨后漫兴柬罗女文","author":"顾璘","text":"春花落尽垂杨低，竹林鸣鸠相应啼。\n夜来久旱得微雨，门前细草青萋萋。\n饮虹桥头西日落，桥下水光摇草阁。\n莫嫌野客杖藜来，瀹茗摊书殊不恶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56787,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东野 其一","author":"顾璘","text":"天印山如天斲方，秦淮水萦练带长。\n夜坐船头看明月，垂虹斜挂几飞梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56788,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东野 其二","author":"顾璘","text":"东山茅屋野人家，谢傅蔷薇春著花。\n入市懒骑从事马，开园时种故侯瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56789,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新凉夜坐次彦明二首 其一","author":"顾璘","text":"独鹤夜何事，松头栖复迁。\n树凉占老态，禾熟受丰年。\n细竹枝枝袅，明星个个悬。\n年来知物化，无意更求仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56790,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新凉夜坐次彦明二首 其二","author":"顾璘","text":"残暑金风改，中宵白露寒。\n秋期来朔雁，野服罢齐纨。\n蛩响喧阴壁，萤光点石栏。\n荷衰叶更起，留伴蓼花看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56791,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"八月四日热","author":"顾璘","text":"八月江南毒热新，火云郁郁尚蒸人。\n井梧叶落太伤早，庭户蚊喧难及晨。\n不见金天流素月，思沾玉露洗黄尘。\n重寻箧笥开纨扇，始笑西风误认真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56792,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"许彦明过荒斋看菊","author":"顾璘","text":"寂寂柴桑宅，黄花但满园。\n相将秋意晚，无奈晓霜繁。\n珍重殊方种，艰危隔岁根。\n玩来终澹泊，莫向美人言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56793,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪中承刘司马许顾二司徒见过","author":"顾璘","text":"北风吹雪拥篱根，高驾翩翩午扣门。\n倒屣自怜庭户湿，围炉同待酒瓶温。\n江山积素看松翠，闾井占年喜麦蕃。\n茆舍萧条虚盛赏，殷勤烧烛伴黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56794,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宪府王公载卿命酒期过草堂阻雪不至奉简一首","author":"顾璘","text":"不诵清诗三十年，晚城佳会又虚传。\n书来送酒春生户，兴尽回舟雪满天。\n独向琼枝劳怅望，非干霜简绝攀缘。\n江梅近暖参差发，还拟乘骢野水边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56795,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和陈鲁南遂初斋漫兴","author":"顾璘","text":"投老书千卷，栖真屋数楹。\n放形依鸟宿，仰面看云行。\n雪棹谁乘兴，风瓢莫弄声。\n归来追往事，无味是浮名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56796,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除夕二首和女文鲁南 其一","author":"顾璘","text":"时序惊心独倚栏，敝裘犹耐故年寒。\n饧糕饷节乡风旧，秫米逢秋酒债宽。\n萱叶向阳铺砌绿，茶花冲雪透林丹。\n青山已结登临约，且喜篮舆老更安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56797,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除夕二首和女文鲁南 其二","author":"顾璘","text":"条风中夜转东方，醉恋残年更举觞。\n白发空添寿者相，朱衣曾玷大夫行。\n贪闻雪垄遗蝗陨，爱见春林旧柳长。\n闾里高人多典则，追随何忝郑公乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56798,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除夕","author":"顾璘","text":"桃茢驱傩画荜门，椒花颂寿泻芳樽。\n生涯喜傍农夫老，社会惭登大父尊。\n长有蟹螯持左手，更添莺舌弄前轩。\n天时代谢非吾事，莫为增年意转烦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56799,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和徐子仁除夕","author":"顾璘","text":"蓬鬓休嗟老不堪，馀生都已付沈酣。\n身旋蛙井元无几，岁历龙飞又十三。\n江草向人寒更绿，塞鸿何事早辞南。\n年来结念投禅寂，且喜维摩屡放参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56800,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和舜玉春日偶题","author":"顾璘","text":"小园泉石占清华，竹坞松堂静不哗。\n悬薄护寒藏橘实，曲池?水灌兰芽。\n缁衣老衲时求饭，纱帽幽人共煮茶。\n门外东风摇五柳，居邻閒拟似陶家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56801,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和鲁南元夜雪","author":"顾璘","text":"雪飞元夜玉盈除，灯射玻瓈烛影虚。\n林借月华疑宿鸟，池添冰力困游鱼。\n春愁正赖寒欺酒，老眼空劳夜照书。\n火树银花交映地，留欢休问五更初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56802,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪夜观灯和彦明二首 其一","author":"顾璘","text":"春夜邀宾景物宜，雪华灯燄两争奇。\n鹤翻玉羽迷仙驾，龙吐骊珠照酒池。\n乐剧不辞金管噪，坐寒频唤画屏移。\n祇缘郢曲高难和，岂是东君赏兴疲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56803,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪夜观灯和彦明二首 其二","author":"顾璘","text":"雪花凝素照虚台，薄暮谁披鹤氅来。\n酒熟似邀灯节至，梅开应被笛声催。\n临觞幸免当官累，投辖惭非劝客才。\n莫笑田家无所献，火轮冰柱亦诗材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56804,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和鲁南新春","author":"顾璘","text":"白雪酿寒仍送腊，红灯窥暖巧偷春。\n神君綵仗鞭牛早，游女罗幡缀燕新。\n泉石投交忘主客，齿牙垂老厌酸辛。\n閒门旧友皆星散，唯有陈雷晚更亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56805,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"閒居四首 其一","author":"顾璘","text":"太湖之石紫崔嵬，溪上茅斋对尔开。\n指点庭心分泰华，依稀岩背宿风雷。\n双飞鹊斗穿晴树，百转虫书印古苔。\n明月不知吾懒散，夜深来照读书台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56806,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"閒居四首 其二","author":"顾璘","text":"黄阁朱楼槩太清，江山襟带旧神京。\n开园更拟閒居赋，近市非干大隐名。\n聊养孤豚供菽水，尚劳群雀恋柴荆。\n薰炉药灶真馀物，合伴狂夫过此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56807,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"閒居四首 其三","author":"顾璘","text":"城郭秋阴袭苧袍，林园稀到长蓬蒿。\n蟏蛸傍树生罗网，野鹤临池惜羽毛。\n年长渐惊朋辈少，形枯真悔簿书劳。\n追欢未断清尊酒，左手犹堪擘蟹螯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56808,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"閒居四首 其四","author":"顾璘","text":"种柳今春拂地垂，黄鹂来挂最长丝。\n高城过水衔青嶂，古树摇花照绿池。\n猿鹤忘机堪结侣，马牛多病枉逢时。\n扬雄错指玄经好，覆瓿他年总莫知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56809,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答许彦明见梦二首 其一","author":"顾璘","text":"浪迹唯方外，劳生总梦中。\n远公开净社，玄度有高风。\n尘世閒难得，禅机病易通。\n所希情性合，何必往来同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56810,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答许彦明见梦二首 其二","author":"顾璘","text":"禅宫元寂静，况复雨连阴。\n座有僧同饭，门无客见临。\n妙香团狭室，远磬落高林。\n谁信城中梦，超然契此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56811,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]