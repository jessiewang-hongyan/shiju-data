pointer":58156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上唐庄旧名盘龙山村老云崔丞相有碑一通喜而赋此","author":"湛若水","text":"丞相龙山片石悬，偶来卜筑定前缘。\n云卿千里从徐孺，旷世相知五百年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉东莞诗","author":"湛若水","text":"沙贝风烟接莞天，政声藉藉到门前。\n不知卓曾循良政，兼有风流水部贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"已答赵大洲司成书意有未尽情见乎辞 其一","author":"湛若水","text":"浩气人今贤大洲，请缨盍系单于头。\n天教远去深藏器，前席他年赞大猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"已答赵大洲司成书意有未尽情见乎辞 其二","author":"湛若水","text":"元明洞里亦吾庐，喜共公来木石居。\n直须坐到江河满，不禦流行自沛如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"已答赵大洲司成书意有未尽情见乎辞 其三","author":"湛若水","text":"苏门长啸意何如，叹息人间几丈夫。\n何处约君同槁坐，飞云顶上天为徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题横江草堂","author":"湛若水","text":"横江风景吾昔游，一见横江消我愁。\n门对横江心似水，我歌浩浩万江秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"脩明诚书院完各以鹅酒花红劳管工仓官唐未海工房潘滔耆老李权张孔教口号","author":"湛若水","text":"凤凰鸣矣明诚开，土木群工翕于来。\n仓宰工房耆二老，殷勤合得酒鹅回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠周生阶自安福无仆而来","author":"湛若水","text":"无仆无朋独自身，影行潭底月三人。\n春粮千里求仁去，到了还归自已仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归自罗浮访望翁爱峰亭题壁","author":"湛若水","text":"不用一字已升天，罗浮回首气如仙。\n榴皮小记回公迹，会与卢公结永年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贰尹杨亦泉送行恋恋因念其旦旦勤事乎凤凰士民称之寓燕石作诗劳之","author":"湛若水","text":"送我迢迢鹤子前，晴明二月中和天。\n凤凰山下殷勤意，尽道吾增二尹贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴举人简斋高士也乃郎进甫应阳庠生相送数十里赠之归呈其大人","author":"湛若水","text":"白面青巾拉马随，数程情义自相依。\n而翁高士髻年契，不受人间爵禄縻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄观善堂院长张春冈及诸生","author":"湛若水","text":"观善堂中院长居，澄心中夜坐诸儒。\n试看坐到忘言处，定有文章耀八区。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题卢民任玉泉别号","author":"湛若水","text":"玉泉似与甘泉通，风味两泉何以同。\n及泉煮玉为甘旨，始见乾坤造化工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周生对阳归安福","author":"湛若水","text":"飞云月底送周郎，心似月圆神似光。\n归对廓翁同玩月，中天普照一无方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三皓与黎养真瑞鸾黄慎斋民准吴藤川纯","author":"湛若水","text":"养真慎斋与藤川，三皓同时及我门。\n八十头颅事事真，老来赤子心还存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾增令尹盛剑崖回道少孤感严东溪翁教载成之而无矜伐之意也吾又感其教成剑崖以泽吾增也为作诗寿之","author":"湛若水","text":"东溪溪上隐君平，济弱恩波及相城。\n思报感恩生我等，我歌聊为寿先生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题盛贤母贞妇诗","author":"湛若水","text":"堂堂贞节达天庭，小小诗篇何足称。\n尽道显扬今有子，立身行道是谁能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读何东莞怀云宜民政颂而吾增邑尹盛剑崖行所无事民无能名同归于循良诗兼赠之","author":"湛若水","text":"莞政宜民有颂声，增江无事民能名。\n两贤共有循良绩，他日观风一例评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠苏仁伯何于逵霍勉衷三进士之京二首 其一","author":"湛若水","text":"赠君六字风霆咒，更割罗浮一片云。\n肤寸不能生万汇，雷雨之动何欣欣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠苏仁伯何于逵霍勉衷三进士之京二首 其二","author":"湛若水","text":"穗城三凤翀天起，五色文章光陆离。\n我爱丹心生羽翼，随君直到凤池西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘安峰方伯考满之京二首 其一","author":"湛若水","text":"故人分辖薇垣省，能播香风十郡闻。\n我病山中无一事，朝朝犹解扫閒云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘安峰方伯考满之京二首 其二","author":"湛若水","text":"外臣天贷巢由老，四岳欣逢尧舜仁。\n昨夜因公还作梦，梦随公去拜枫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉藩伯李一吾博笑四句一韵","author":"湛若水","text":"天下一人惟一吾，一吾之外更无吾。\n友身自觅真吾看，万物乾坤一是吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"承广西大巡东逵陈侍御下车之初即致书来问盖公学出于蒋道林有渊源矣以此正己格物而风俗化矣小诗奉寄","author":"湛若水","text":"下车谁问百年人，定过桃源一问津。\n无侮老成存古训，扬清激浊道之神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻大巡王白厓巡历新会以西尽得人心追□春间饥民之变赖公筹策以定今秋又旱矣人心惶惶怀之小诗奉寄","author":"湛若水","text":"去时饥莩变危机，拨乱微公人尽非。\n巡历以西东土怨，悲歌云汉望公归。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏虚庵相从三十年老友也自海阳数千里来问长年之事诗以送之","author":"湛若水","text":"踏月穿云路几千，扣关来问我长年。\n故人合是苏耽后，我道全归更问天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郁林守邝和仲乃元博宪副之犹子而吾友松溪程学士之徒也谬称予为师祖持松溪赠良守诗访天关予喜其贤而赓之云","author":"湛若水","text":"金台金陵两都花，曾共松溪玩月华。\n郁林贤守开诗卷，三世斯文共一家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄孝子观英卖菜养母四十不娶妻恐妨母食作诗表之","author":"湛若水","text":"鬻蔬养母亦堪怜，曾有东湖识屦钱。\n四十不妻妨母食，险□啖鸭已忘天。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送衡阳何怀云迁应天府江宁令尹","author":"湛若水","text":"天关白日□怀云，赤县神州声易闻。\n我欲乘云还岳去，凭公先报祝融君。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄五川杨梦羽兵宪","author":"湛若水","text":"五川流自一川清，一月光分五水明。\n了意悬知川上叟，从今不必读西铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄文衡山内翰约同居南岳","author":"湛若水","text":"谁人不说文衡山，闻说衡山开我颜。\n我有衡山旧精舍，相期月底共追扳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王岱麓中丞送母夫人过岭","author":"湛若水","text":"昔年分部共寅清，翰苑奇游抚上京。\n道旧未终随凤翥，白云翘首送君行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠增城学李东川迁大姚掌教","author":"湛若水","text":"桂阳因忆何明府，临武明师迁大姚。\n舜日高悬万里照，沙溪复起云南谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甘泉子成童时馆坡山白莲池东房嘉靖甲寅夏李氏右坡青霞父子邀饮于大钟之楼旧迹变迁惕焉感怀","author":"湛若水","text":"白莲池上觅仙踪，曾听攒眉夜夜钟。\n七十年前灯火地，东寻无路白云封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴楚诸贤蒋道林因李鹑野附长子如川预致九十寿文小诗总谢","author":"湛若水","text":"远大千言同祝寿，浑沦一体愧全归。\n盈亏独有真常在，永命同天共自祈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓枕怀徽州诸贤","author":"湛若水","text":"良知天理孩提爱，皓皓须从暴濯寻。\n非圣厉阶谁自梗，慈湖长啸暮烟深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与李三洲中丞遇于巷喜不自胜吾谓喜处即道纪之","author":"湛若水","text":"青说从蓝青过蓝，三洲拜我得无惭。\n一朝巷遇三年念，天理沛然人莫参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀故司训姚子山诗书付族孙姚植之","author":"湛若水","text":"怅想子山起一经，是谁帮济未成名。\n短檠初事人皆笑，宗伯先公独用情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陈所素暨宅上诸亲","author":"湛若水","text":"徒杠欲折问舆梁，定有阴功达上苍。\n千人万人行致祝，公侯万代沙村堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄贺太仆吕巾石疏乞得归","author":"湛若水","text":"浮云过目勋华尽，下惠三公定有无。\n巾石乞归对怀玉，也应多谢左偏枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题扇寄严介翁阁老","author":"湛若水","text":"把柄入手便生风，一面摇时面面同。\n感应有如躬握吐，翁今握吐即周公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题扇寄山西潘春谷子抑","author":"湛若水","text":"天南天北梦难通，春谷风同云谷风。\n舒卷乾坤一箑耳，莫教春信断来鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题扇寄端溪彭太守兼呈王端溪宗伯","author":"湛若水","text":"一握清风弥六合，此风传播到端溪。\n无中生有如神速，勿以炎凉间弃携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题扇寄邹东廓司成","author":"湛若水","text":"东廓惟应更有西，兼愁南北规尘迷。\n廓清直到廓然处，一握清风老手题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题扇赠郭平川太守二首 其一","author":"湛若水","text":"心平灵似水平清，纯正堂前有准铭。\n此是中都旧风教，平川传播到洪城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题扇赠郭平川太守二首 其二","author":"湛若水","text":"平川消息问何如，只有中思是坦途。\n奋箑无中生有处，应知有有即无无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题扇送平川侄尚恺","author":"湛若水","text":"小阮能随大阮游，收身连理洞藏脩。\n川翁巨眼同观海，家学湖西第一流。\n百尺竿头今进步，新诗题箑记春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答李鳌峰别驾二首 其一 答白云","author":"湛若水","text":"山在白云山更山，此山天与老年閒。\n更愁十里红尘到，故著先门隔世间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]