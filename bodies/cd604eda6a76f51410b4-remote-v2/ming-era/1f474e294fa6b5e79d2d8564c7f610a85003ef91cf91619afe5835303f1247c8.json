c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王明府之齐二首 其二","author":"林大春","text":"北海春回一骑过，西京人去奈离何。\n何时便渡康浪水，为寄当年白石歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送滑州张明府二首 其一","author":"林大春","text":"即看宝剑动神州，羡尔铜章下铁丘。\n好过漆园询故事，至今人尚说庄周。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送滑州张明府二首 其二","author":"林大春","text":"今朝相送五云间，春树犹含冰雪颜。\n明日相思定何处，满天风雨过秋山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠广德邝使君","author":"林大春","text":"十年意气动京关，千里分符吴楚间。\n一夜东风吹锦旆，人传春在伍牙山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人赴东原驿官","author":"林大春","text":"燕台南望鲁城东，有客乘春向此中。\n此去看山见杨柳，至今犹是展禽风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"边城雪","author":"林大春","text":"起被朝衣轻着霞，凌晨走马忆京华。\n孤城此日堪惆怅，三月已破还雪花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浔阳晓渡","author":"林大春","text":"江上寒云敛晓晖，一年两度照征衣。\n离人日日怀燕塞，何事孤鸿犹未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"便面二首 其一","author":"林大春","text":"碧水浮云弄晚岑，秋深落叶满空林。\n石桥乘兴欲飞度，谁识维舟结网心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"便面二首 其二","author":"林大春","text":"万壑寒来凝玉马，六花飞尽见琼枝。\n驱驰应有梁园约，不似羊生入楚时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过邯郸吕公祠柬杨次泉阴月溪二公时阴赴关右督学予与杨并之官河南云二首 其一","author":"林大春","text":"仙迹千年草树空，行人犹自拜仙宫。\n可怜人世惊心事，都在黄粱一梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过邯郸吕公祠柬杨次泉阴月溪二公时阴赴关右督学予与杨并之官河南云二首 其二","author":"林大春","text":"拜将封侯事几回，朱轮鼎食总堪哀。\n东都建节西都骑，不信曾从梦里来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"去大梁入辉县道中人不知其为故臬吏也漫有短述却寄同游诸君子二首 其一","author":"林大春","text":"海上幽居岁几更，山中一出为苍生。\n祇今听得孙登啸，肯向时人说姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"去大梁入辉县道中人不知其为故臬吏也漫有短述却寄同游诸君子二首 其二","author":"林大春","text":"昔从此路入梁园，今别梁园复此路。\n寄语邹枚旧词客，相思莫诵凌云赋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻程生得官回乡作此赠之","author":"林大春","text":"明月高悬四海宽，朔风吹动九边寒。\n长安卷轴应无数，不道陈生已拜官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋声图","author":"林大春","text":"一雨秋山爽气深，主人坐我秋云阴。\n披图莫诵秋声赋，玉树萧萧愁客心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"便面","author":"林大春","text":"百顷风涛万马奔，空山行旅尽销魂。\n未论天险开巫峡，疑有神功凿禹门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊寺送客","author":"林大春","text":"窗外忽过夜雨声，郊南送客喜新晴。\n酒醒孤寺车尘远，何处人家起暮笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠王提举二首 其一","author":"林大春","text":"廿载干戈草木稀，东南秋色近如丝。\n朝来借得西风力，扶起幽岩三两枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠王提举二首 其二","author":"林大春","text":"江城新月带微霜，策马征途幽兴长。\n闻道海氛今欲净，登高何处醉重阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苍梧九日偶成二绝 其一","author":"林大春","text":"九月炎荒暑未回，如云瘴气满高台。\n菊花本是凌霜物，怪得今朝不肯开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苍梧九日偶成二绝 其二","author":"林大春","text":"谁道一官清似水，虚堂犹自出樽罍。\n官衙况在山深处，不用登高便避灾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小卧草亭适刘广文寿日诗以贺之二首 其一","author":"林大春","text":"年来岭海说玄经，秋满乾坤卧草亭。\n夜起月明银汉净，寿星长自护文星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小卧草亭适刘广文寿日诗以贺之二首 其二","author":"林大春","text":"香飘绛帐鲁芹宫，此日诸生拜马融。\n莫道广文官独冷，明经本是汉三公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠客","author":"林大春","text":"千里江湖萦客梦，十年市隐见人心。\n问奇时向扬雄宅，不学邯郸破万金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠刘大参公子二首 其一","author":"林大春","text":"苍梧郭里万山斜，独对青灯映雪花。\n不向李膺投姓字，无人知道是通家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠刘大参公子二首 其二","author":"林大春","text":"严君几载滞边城，此日仙郎傍母行。\n汉代向歆今不忝，明经应自振家声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]