[{"title":"代王九皋作送同年连脩撰","author":"曹义","text":"游宦京华几度春，玉堂清夜梦归频。\n枫宸此日偏承宠，兰棹行时独问津。\n秋水白蘋迎客旆，夕阳红树接瓯闽。\n遥知明到家山日，闾里争誇昼锦新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和编脩许道中腊月初三日诞诗三首 其一","author":"曹义","text":"诞日筵开花喜簪，老人光现斗之南。\n年华才过四旬二，璹大还期九十三。\n劝酒情深人尽醉，赓歌材薄我怀惭。\n新诗一律劳眸电，应向灯前笑拆缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和编脩许道中腊月初三日诞诗三首 其二","author":"曹义","text":"清时共喜戴朝簪，气吐虹光射斗南。\n登第昔誇年十八，庆生今喜臈初三。\n玉堂名重人争羡，粉署官闲我独惭。\n称寿出关图未献，临风聊为寄泥缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和编脩许道中腊月初三日诞诗三首 其三","author":"曹义","text":"茅峰玉立宛如簪，雄镇金陵杨子南。\n福地从来推第一，名山自古只称三。\n学仙少术颜多厚，报国无才色更惭。\n久别琳宫相忆剩，几看道士寄来缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送医人归田嘉兴人为朱脩撰作","author":"曹义","text":"都市悬壶雪满颠，宋清名誉远相传。\n归田此日承优诏，别浦乘春放画船。\n客路柳风飞紫燕，蓬窗花雨湿青毡。\n遥知旧业南湖上，药圃春晴霭术烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨太守衡之通州","author":"曹义","text":"抚字多闻政治平，分符又喜向通城。\n沂州民吏思遗爱，京国交游动别情。\n酒尽官亭花雨歇，旆迎驿路柳风轻。\n四知自古称杨震，好抗家声著令名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送主簿归老其人清廉","author":"曹义","text":"几年花县暂栖迟，仇览才名众所知。\n报国一心清似水，归田双鬓白如丝。\n新盟应结鸥为伴，旧业还存菊绕篱。\n遥想杖藜行乐处，绿阴晴昼鸟啼时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人之高邮教职","author":"曹义","text":"清时振铎远驰声，共说滇南教有成。\n奏绩才看朝玉阙，承恩又喜向□城。\n一尊晓日官亭酒，十里东风客路情。\n文旆悬知明到日，青衿几许远相迎。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人归田","author":"曹义","text":"解组归来雪满颠，优游林壑度馀年。\n春风绕舍多栽竹，夏日临池独看莲。\n高兴每因清醑适，闲情常对白云眠。\n客来关款无盘饤，旋钓槎头缩项鳊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽松窗先生即俞处恭也","author":"曹义","text":"白发林泉遂野情，仙游一梦到蓬瀛。\n箕裘家世推俞附，湖海声名说宋清。\n杏坞春闲丹药灶，松窗月冷石棋枰。\n吟成楚些愁无极，忍听山阳暮笛声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽张中书父","author":"曹义","text":"凤池有子擅才名，嬴得褒封荷宠荣。\n银带乌纱娱暮景，清泉白石遂闲情。\n游仙忽断华胥梦，乘醉应骑沧海鲸。\n遥想牛眠埋玉处，青山落日对新茔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽知县姑苏人任遂安","author":"曹义","text":"几年宰邑著能声，襟度人誇玉雪清。\n才见飞凫朝禁阙，忽惊跨鹤上蓬瀛。\n公庭无复施新政，民吏虚劳望旧旌。\n京国幸多知己友，临棺哀挽不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送樊参政归闽","author":"曹义","text":"薇垣佐政几经春，烨烨声名播八闽。\n北上喜看书最考，南还重见沐恩新。\n都门暑退飞来雁，江渚秋深老白蘋。\n到日公馀应有忆，诗成好寄玉堂人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张给事中居杰升云南参政","author":"曹义","text":"簪笔多年侍赤墀，旬宣今喜沐恩私。\n才华总谓公卿荐，姓字谁期圣主知。\n晓日锦衣辞凤阙，春风兰棹上滇池。\n藩垣后夜遥相忆，肯忘鹓行待漏时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽耕隐先生朱德润之翁也","author":"曹义","text":"肥遁林泉鬓已霜，生平名利澹相忘。\n半犁春雨东皋兴，一枕清风北牖床。\n荏苒光阴闲里度，迢遥仙路梦中长。\n独怜埋玉龙溪上，千古穹碑对夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽诗为中书沈为忠作","author":"曹义","text":"讣逐西风到客边，黄门令子泪潸然。\n百年正拟荣三釜，一梦俄惊入九泉。\n蕙帐夜寒悲吊鹤，枫桥春晚怨啼鹃。\n生平喜有褒封诰，淑德仍看太史传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送袁令尹复任赣州雩都县","author":"曹义","text":"一别词垣几度秋，共誇宰邑政优游。\n花村机楙声连屋，春雨桑麻绿满畴。\n奏绩才看飞玉舄，承恩又见棹兰舟。\n一杯酒尽离亭晚，后夜相思独倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何县丞任建阳","author":"曹义","text":"客边曾记旧为邻，游宦东瓯几度春。\n抚字花封才誉著，奏功枫陛宠恩新。\n一尊岐路同倾酒，千里关河独问津。\n别去此心多有忆，到官毋惜寄书频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邵孟辉之任丹阳丞","author":"曹义","text":"相识京华半俊英，拜官今喜荷恩荣。\n马蹄未发金台路，声誉先驰铁瓮城。\n判笔已知霜雪凛，襟怀还拟玉壶清。\n古来佐政谁无欲，独有张玄著令名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴太守闰复任饶州府","author":"曹义","text":"太守循良谁第一，吴公自古占魁名。\n才看振佩朝天阙，又喜还官出凤城。\n行李喜沾新雨露，儿童争迓旧麾旌。\n也知襟度如秋水，嬴得人称彻底清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽工部林主事超之母夫人广东人","author":"曹义","text":"讣音万里到京华，粉署贤郎重叹嗟。\n箧笋香残遗綵服，妆台尘掩暗菱花。\n姆仪垂簳人争羡，妇德宜家众所誇。\n嬴得一生名石泯，褒封有敕宠恩赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑雍言佥宪之河南","author":"曹义","text":"昔年黄榜共题名，佥宪新除荷宠荣。\n玉节绣衣辞凤阙，青骢紫控出都城。\n交游总惜才华老，谳决应知狱讼平。\n自古诹询称重任，风谣早为达民情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送唐舟御史致仕归广东","author":"曹义","text":"历职霜台几许年，白头今喜赐归田。\n锦衣侵晓辞丹陛，绿酒临岐对绮筵。\n春暖云连庾岭树，雨晴人上潞河船。\n到家悬想行吟处，旧业林塘野水边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送太守易公之四川","author":"曹义","text":"粉署才华属老成，喜膺荐剡寄专城。\n锦衣新自鹓行去，昏盖遥从鸟道行。\n柳岸莺啼凉雨霁，槐庭花落午阴清。\n政馀莫忘同年好，时寄新吟?别情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄璿太守之任河南","author":"曹义","text":"十载同听禁苑钟，分符此日向开封。\n云连蒗荡路千里，山接夷门树几重。\n故国文翁今已远，颖川黄霸又相逢。\n鹓班多少同年客，争似偏承宠渥浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送平江伯孙南还","author":"曹义","text":"将军孙子雪冰清，文武才高著令名。\n北上远承严侍训，南还深念倚门情。\n雨晴紫陌骅骝健，风暖官河画鹢轻。\n悬想长□明到日，春生阀阅倍光荣。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送严太仆宗信","author":"曹义","text":"三十年来侍禁庭，迁官又喜列名卿。\n朱衣象简辞龙衮，疋马双旌出凤城。\n望入秦关烟树迥，路经汉畤暮云平。\n当年司牧称毛仲，莫使前人独□名。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顾佥宪归老仪贞","author":"曹义","text":"□辙遨游三十秋，青骢到处说风流。\n投簪此日辞天阙，拂袖迎秋买客舟。\n旧业还寻篱下菊，新盟重结水边鸥。\n陶情诗□谁为伴，听雪松窗共唱酬。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和晏铎幕宾咏天鹅韵兼送行","author":"曹义","text":"昔年曾共玉堂游，屈指于今二十秋。\n柏府才华驰北阙，花封清誉播南州。\n相逢客邸情如旧，惜别都门话不休。\n去去莫言云路迥，鹓班还拟侍宸旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得天寒月映霜送黄布政定之山东","author":"曹义","text":"除书晓捧出明光，朝罢瑶阶月映霜。\n积素冷涵环佩瑩，清辉晴耀锦衣香。\n心悬北阙天恩重，望入东蒙客路长。\n莫道此时寒气肃，薇垣到日转春阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽金中书舍人父文鼎先生其人能诗善画","author":"曹义","text":"凤池封秩荷恩深，几许能声播士林。\n笔底江山移造化，闲中风月纵清吟。\n骑鲸忽断黄梁梦，挂壁空馀缘绮琴。\n欲奠生刍嗟莫致，歌残楚些泪沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"善庆堂","author":"曹义","text":"闻说君家多积德，高标善庆扁轩居。\n床头书卷充梁栋，庭下芝兰映玉除。\n一篆香烟销昼日，半犁春雨乐耕锄。\n欲询世泽知何在，瓜瓞绵绵自有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送车黄门致政南还","author":"曹义","text":"黄门十载侍宸旒，此日辞荣去莫留。\n门径未栽陶令菊，关河先棹季鹰舟。\n东风花雨沾行旆，南浦芜烟引别愁。\n明到故园行乐处，音书母惜寄交游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蔡良医孟颐致仕桐川","author":"曹义","text":"京国交游二十年，邻居犹喜往来便。\n书灯几乞丹炉火，茶灶频分橘井泉。\n正拟悬壶施妙术，那堪解组赋归田。\n一樽送别都门道，后夜相思月满天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽龚通政父","author":"曹义","text":"令子清时列近臣，褒封锦敕荷君恩。\n百年正拟荣三釜，一梦俄惊隔九原。\n蕙帐夜寒悲吊鹤，兰溪月冷怨啼猿。\n西风故旧山阳笛，几度闻来欲断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分题得直沽海势送杨公子","author":"曹义","text":"□老关河暑尽消，辞亲远泛木兰桡。\n直沽到处轻移棹，海口过时趁早潮。\n蜃气寒凝征旆湿，涛声晴送片帆遥。\n他年定省重来日，经此应知兴转饶。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽工部诸郎中谦父","author":"曹义","text":"晚岁褒封雪满头，一官林下乐优游。\n吟行花径扶藜杖，醉阅芸编憩竹楼。\n尘梦忽随仙梦断，闲情竟与世情休。\n不堪回首兰溪上，烟雨松楸锁暮愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨编脩寿夫先生","author":"曹义","text":"游宦清时雪满颠，辞荣一旦赋归田。\n玉堂纂述年华久，锦敕褒封宠渥偏。\n碧水丹山闽海兴，西风凉雨潞河船。\n到家书屋应如故，松菊窗前著太玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"霅川归趣送黄布政叔正归田二首 其一","author":"曹义","text":"霅川归处趣何清，竹下琴樽柳外亭。\n风煖波光涵户白，山晴云影压帘青。\n眠沙鸥鸟吟边见，投浦渔歌静里听。\n更想客来清话日，不谈名利只谈经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"霅川归趣送黄布政叔正归田二首 其二","author":"曹义","text":"三十年来涉宦途，解缨一旦赋归欤。\n甘棠藩府存遗爱，别业苕溪有旧居。\n枕石眠时同野鹤，杖藜行处伴樵渔。\n梦回莫忘青云友，好托鳞鸿远寄书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄余处恭先生","author":"曹义","text":"悬壶久住大江濆，俞拊家声远近闻。\n红满杏林涵宿雨，丹成药灶霭春云。\n围棋花径销春昼，听雪松窗坐夜分。\n羡尔平生多雅趣，交游来往总斯文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽吴参政广德人给事中升任","author":"曹义","text":"昔年曾共簉鹓班，几见承恩拜好官。\n柏府振威奸胆落，薇垣布政吏民安。\n华堂忽见飞凶鵩，仙岛俄惊跨彩鸾。\n悬想牛眠埋玉处，白杨声惨暮云寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送兵科郑给事中悠归省","author":"曹义","text":"久客黄门定省违，喜承优诏向南归。\n佩辞玉阙左初曙，酒尽都亭兴欲飞。\n路指旱江云树迥，帆经淮浦夕阳微。\n高堂想到称觞日，舞罢班衣换锦衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽同年郑通判广东人","author":"曹义","text":"京国相逢记昔年，琼林曾共醉华筵。\n论交青眼谁偏旧，佐政黄堂尔独贤。\n正喜奏功膺宠渥，忽惊捐馆隔重泉。\n堪嗟旅榇南归处，丹旐翩翩瘴海边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄同年陈知府安","author":"曹义","text":"千里封章奏九天，喜承恩命赐归田。\n交游总叹故人去，民庶多思太守贤。\n翠壁啼猿巫峡路，清风落日晋江船。\n到家莫忘同年好，鸿雁来时寄锦笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送主事姜子澄任广南太守","author":"曹义","text":"凤池染翰早驰名，粉署为郎属老成。\n玉阙一朝膺荐剡，滇阳万里任专城。\n青山客路双旌杳，夜月关河独棹轻。\n边徼从来风俗异，好勤抚字播天声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李桓乡试","author":"曹义","text":"清俊才华众所欲，少年声价重南金。\n题桥久抱相如志，献策犹怀贾谊心。\n蟾窟秋高丹桂发，禹门春暖浪花深。\n此行定占鳌头选，早寄泥缄报好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何观中书归省","author":"曹义","text":"青年染翰凤凰池，堂上双亲鬓若丝。\n天禄巳荣三釜养，寿龄还拟百年期。\n锦舆花底欢迎处，綵服樽前戏舞时。\n爱日应知诚孝笃，几回惊□□□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽丁副都夫人","author":"曹义","text":"褒封才喜沐恩私，一去瑶池杳莫知。\n霞帔空嗟遗箧笥，蘋蘩无复荐先祠。\n西风蕙帐悲鸣鹤，残月机窗照断丝。\n珍重良人乌府客，都门含泪送灵輀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺陈都宪有戒寿","author":"曹义","text":"华诞忻逢甲子周，宪台贺客总儒流。\n霞觞满劝麻姑酒，寿算频添海屋筹。\n春暖绮筵和气霭，夜深南极瑞光浮。\n自惭浅薄将何祝，簪笏年年侍冕旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽丁副都","author":"曹义","text":"玉陛常同觐九天，俄惊一梦竟游仙。\n乌台美政留今日，黄甲香名记昔年。\n海北云深归吊鹤，江南春去怨啼鹃。\n嗟予素有相知好，楚些吟成泪泫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"积庆堂为杨都御史作","author":"曹义","text":"君家清白远相传，裔出关西几百年。\n馀庆固从先世积，明时今喜后昆贤。\n官联九寺声华重，诰赐双亲雨露偏。\n不独此身钟令美，会看簪绂更蝉联。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽沈学士度","author":"曹义","text":"八哀年高雪满簪，仙游一梦竟沉沉。\n草麻几对西清月，润笔多颁内帑金。\n蕙帐夜空孤鹤怨，薇垣春去落花深。\n海棠依旧栖灵鹊，宁得重来听好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨仲举先生致仕来朝升侍郎而回","author":"曹义","text":"先生藩邸旧儒绅，致政重来觐紫宸。\n鹤发半垂晴映雪，龙颜一见喜生春。\n颂台升秩名声重，锦诰荣颁雨露新。\n此去故乡寻别业，阊门杨柳倍精神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄曹朝阳先生","author":"曹义","text":"同宗同学复同年，十载横经在蜀川。\n施教夙闻风化溥，迁官今喜宠恩偏。\n客窗未尽连床兴，潞渚俄移下水船。\n沙麓讲馀无事日，平安母惜雁来传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送康先生振致政南归","author":"曹义","text":"封章奏乞解名缰，诏许南还喜欲狂。\n绿酒岐亭新去客，绣衣匹马旧行装。\n心悬北阙云霄迥，望入西江驿路长。\n宝敕堂前明到日，应知击壤颂虞唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和祭酒陈先生留别诗韵","author":"曹义","text":"诏许归田乐暮年，应知圣主重才贤。\n五朝恩宠谁能并，一代文风独擅专。\n旧业剩栽陶令菊，图书满载米家船。\n春风送别长安道，多少衣冠集祖筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和周学士梅花诗韵","author":"曹义","text":"万物敷荣自有时，孤摽开处傍寒池。\n香浮玉署春回早，影转湘帘月上迟。\n独喜冰肌含雪瑩，不同蒲质望秋衰。\n追思东阁吟看夜，翠羽争栖第一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陕西张参议之任四川人","author":"曹义","text":"虎榜曾魁第一名，黄门列职又驰声。\n封章屡进超群辈，参议新升惬众情。\n驿路马蹄经汉畤，都门烟树接秦城。\n此行休道云霄迥，他日还期佐圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽刘给事中华甫之父","author":"曹义","text":"先生令子职黄门，嬴得褒封荷宠恩。\n荣养已沾三釜禄，仙游忽断百年魂。\n窗前闲却青藜杖，花底空遗绿酒樽。\n悬相艾冈埋玉处，白杨箫瑟暮云屯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽李侍郎父","author":"曹义","text":"昭代贤郎列亚卿，先生林下乐升平。\n杖藜花径吟边兴，尊酒松窗醉里情。\n鸾诰未膺孤禄养，鸡年先梦兆行程。\n也知积德多深厚，祭葬推恩荷宠荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和孙绣衣先生见寄诗韵","author":"曹义","text":"解组南归荷宠荣，林泉从此乐时清。\n不闻报晓鸡人唱，秪听催耕布谷鸣。\n交友共怜双鬓白，看书自喜寸心明。\n柏台嬴得声名在，尊酒花前任醉倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]