[{"title":"游焦山因谒汉隐君祠","author":"李英","text":"冥心归净域，幽赏且高歌。\n泉石留人处，烟霞奈尔何。\n诸天开福地，落日满沧波。\n为访焦君隐，春深长薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋登迷楼","author":"李英","text":"倦客关山万里遥，清尊频为故人招。\n因怜芳岁留蓬鬓，又见秋风到柳条。\n淮水北来天渺渺，岷冈西上雨潇潇。\n隋堤旧是官河路，莫向高楼怨玉箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"思家曲四首 其一","author":"李英","text":"乡关迢递树重重，尚隔巫山十二峰。\n梦去不知江上路，满天秋色散芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"思家曲四首 其二","author":"李英","text":"愁来双鬓似潘郎，尺素无由寄孟光。\n独向高楼看破镜，夜寒犹自照西廊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"思家曲四首 其三","author":"李英","text":"飘零何处问刀环，回首罗浮霄汉间。\n莫似窦家频织锦，秋风西寄望夫山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"思家曲四首 其四","author":"李英","text":"阑干十二月如霜，玉笛凄清客断肠。\n莫把綵毫写新恨，只愁无雁到衡阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬姑苏张太学见赠","author":"李英","text":"江湖落魄独怜予，铁砚生涯自索居。\n入洛幸逢张太史，游邛今见马相如。\n清秋淮海看停辔，旧隐吴门忆著书。\n良晤不堪仍赋别，白云东望一踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮秋广陵驿下送别王氏兄弟南归","author":"李英","text":"关河此别思依依，淮甸秋高落木稀。\n南国惊看鱼雁杳，西风愁送鹡鸰飞。\n千行衰柳笼寒色，一片征帆向夕晖。\n知是故园花满径，应怜客子未同归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泗水驿楼晚眺","author":"李英","text":"策马淮西路，飘飘作远游。\n关山频击柝，疲病独登楼。\n河绕龟峰出，天连泗水流。\n不堪羁客思，吹角送残秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小除夕寓濠梁官舍对雪","author":"李英","text":"奔走过残腊，辞家似管宁。\n淮淝天共远，风雪路重经。\n万国曾王会，中原一客星。\n此时无斗酒，何以慰飘零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春泛舟游玄湖二首 其一","author":"李英","text":"郭外玄湖胜，风光欲暮春。\n扁舟聊寄兴，泉石偶相亲。\n万柳飘丝密，千莺转曲频。\n沧浪还指点，烟景与游人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春泛舟游玄湖二首 其二","author":"李英","text":"行行三径曲，采秀绕湖滨。\n山鸟能迎客，潭鱼不避人。\n绿蘋依水净，红药袅烟新。\n半醉淮西酒，浮沈又一春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠新葵张山人赋得书字","author":"李英","text":"汝南天下士，龙卧意何如。\n玉树春偏长，金尊夜不虚。\n持竿桐陌水，问字竹林居。\n狂客思琼玖，君能一报书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伏日同吴虎臣诸君避暑玄湖","author":"李英","text":"海燕飞飞西复东，几人钓艇石湖中。\n天边珠树三峰白，镜里荷花六月红。\n落羽独怜游洛客，问奇时傍灌园翁。\n烟霞处处堪招隐，谁道淮南有桂丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潢上钓鱼得四十九枚戏成小诗","author":"李英","text":"偶结西河叟，朝朝驻水滨。\n谁知麋鹿性，还与白鸥亲。\n草伏情偏剧，风餐岁更贫。\n因思游北固，曾作钓鲈人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄邵山人长孺","author":"李英","text":"昨见淮南使，知君近著书。\n隐同嵇叔夜，游似马相如。\n芳岁衔杯过，浮名与世疏。\n堪怜留滞客，汝水忆烹鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻陆秀才无从游武夷山赋寄二首 其一","author":"李英","text":"南征闻尔武夷游，药裹琴囊一叶舟。\n此去曾孙迎太姥，幔亭车马莫淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻陆秀才无从游武夷山赋寄二首 其二","author":"李英","text":"吴钩万里羡雄飞，海内才名自陆机。\n大隐屏前揽秋色，七闽词赋益光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄蒋秀才子夏","author":"李英","text":"负剑西行入汝来，别君当日腊梅开。\n陆沈自笑泥涂客，清梦时时傍弩台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"草秋郊园","author":"李英","text":"蹉跎犹作客，为爱辟疆园。\n渔浦亭临水，人家艇到门。\n白云屯大泽，秋色满中原。\n欲赋思归引，江蓠傍酒尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡淮","author":"李英","text":"西风淮右过，客子意如何。\n夕照长堤曲，秋生平楚多。\n衰柳连古驿，落叶下沧波。\n挂席飘然去，谁知鼓枻歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄郭山人次甫","author":"李英","text":"三茅云气海门浮，贞白年来不下楼。\n客自巴邛供一杖，人从天地寄扁舟。\n月悬方丈娟娟夜，风起沧溟飒飒秋。\n淮上桂丛千树发，几时招隐到山幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠朱明府仲开二首 其一","author":"李英","text":"何年彭泽赋归来，未少柴桑酒百杯。\n蓝舆诸生今又至，不知西去几时回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠朱明府仲开二首 其二","author":"李英","text":"文词高已□皇坟，海内风流尔不群。\n多少侯芭来问字，柴门何但似扬云。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过京口访茅秀才平仲","author":"李英","text":"暂系江边艇，寻君薜荔居。\n白云三径菊，落叶满床书。\n纵酒疑元亮，传经似仲舒。\n慇勤还握手，别去忆双鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠吴山人虎臣","author":"李英","text":"千里翩翩独往情，应知嵩少有幽盟。\n由来任侠如长孺，不但才华似士衡。\n入社每怀匡岳约，还山尝拟鹿门耕。\n嗟余落魄风尘色，笑解吴钩赠尔行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日出郊游鄢庄二首 其一","author":"李英","text":"马上垂鞭问竹扉，东风吹我薜萝衣。\n郢中谁道阳春曲，此地杨花似雪飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日出郊游鄢庄二首 其二","author":"李英","text":"载酒春山路不迷，平原千里草萋萋。\n看花深入花源去，无数黄鹂傍客啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄刘仲光","author":"李英","text":"隋家堤畔柳如烟，玉勒金羁侠少年。\n闻道刘生能结客，春光应在酒垆前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别吴山人虎臣","author":"李英","text":"雪色双龙剑，谁知又解携。\n余归思问寝，尔去尚羁栖。\n涕泪天俱远，河山日易低。\n依依今夜梦，犹自恋淮西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"普惠寺饮饯即席留别王云卿","author":"李英","text":"中原马首白云开，双树林边尽此杯。\n明日过淮还忆汝，西风摇落景夷台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重过虎溪因忆胡氏诸子","author":"李英","text":"远游曾共此栖禅，莲社题诗已十年。\n旧客重来僧易老，相思残雪满山川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清远客舍春夜对月感怀","author":"李英","text":"十口家何在，驱驰度此生。\n苧衣江雁信，菰米海鸥情。\n迢递川空迥，徘徊月自明。\n山城春草绿，愁杀杜鹃声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆山人华甫见过山房二首 其一","author":"李英","text":"迢递梅花国，怜君向此游。\n征航能一叶，行李祇双钩。\n白发沧江夕，青山铁笛秋。\n稚川今度岭，真不负罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆山人华甫见过山房二首 其二","author":"李英","text":"汝水分携后，余归又二年。\n停云劳梦寐，兹夕共周旋。\n梅萼沾山雪，芝柈引石泉。\n钓竿吾欲荷，一泛五湖船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重赴京师留别山中亲友","author":"李英","text":"结束事行役，扁舟欲问津。\n祇因游侠去，不为住山贫。\n飘泊凭孤剑，驱驰愧此身。\n别君多慷慨，相忆白纶巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"爽台诗应教","author":"李英","text":"大江江畔是平台，犹有西山一片来。\n爽气乍从千里至，白云曾傍五城开。\n人推大雅标词苑，春逐清歌进酒杯。\n幸得追游逢赋雪，侍臣谁敢并邹枚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮梁大雪过祁门","author":"李英","text":"鸿雁尽南飞，山山落木稀。\n乡关何处望，鞭弭几时归。\n雪色催征骑，梅花点客衣。\n新安江上水，莫遣送斜晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过休宁访邵长孺","author":"李英","text":"河上三春别，鄣山千里来。\n长途初解辔，献岁一衔杯。\n我自缁尘客，君称白雪才。\n莫教分手易，相忆在燕台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪后游齐云岩","author":"李英","text":"栖真十载梦天都，一入名山似玉壶。\n上帝宫庭双凤下，群仙楼阁五龙趋。\n雪飞白岳纷零乱，云过玄洲乍有无。\n欲向关门瞻紫气，流沙西去此身孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游吴舍人园","author":"李英","text":"禁闼辞归日，青霞道自尊。\n翛然丛桂隐，何异辟疆园。\n大壑今逃俗，高林已避喧。\n飘飘南海客，短褐一登门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过长源访程子虚","author":"李英","text":"识面欢相得，劳劳念敝裘。\n天涯余浪迹，海内尔名流。\n邺郡称诗客，甘泉献赋秋。\n他时还把袂，策马入皇州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过溪南访吴虎臣","author":"李英","text":"汝南分手各凄其，雁字何由慰所思。\n岭峤驱车寻太隐，烟霞披褐赴幽期。\n孤征欲赋怀空壮，五载重逢鬓已丝。\n飘泊风尘那可道，报君惟有白驹诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠程生","author":"李英","text":"涤器临邛客，千秋事可同。\n酿成新白酒，种得嫩青菘。\n混俗壶中叟，寻师河上公。\n应知深寄迹，巾舄复西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过滁州游琅琊寺","author":"李英","text":"滁阳寻福地，江上早春时。\n谈麈僧开阁，挥毫客赋诗。\n诸天残雪暝，双树白云垂。\n欲学无生法，皈依问远师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再至京邸春日书事","author":"李英","text":"五陵游侠地，春晓独徘徊。\n御柳层烟散，金堤一骑回。\n晴云飞碣石，残雪照燕台。\n十载周南客，公车此复来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄顾使君","author":"李英","text":"锡山家庆日，宾客满华堂。\n五柳当门色，双珠照乘光。\n抽簪怜白发，持钓爱沧浪。\n世业青箱贵，承恩在建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周文璧见过","author":"李英","text":"为客依僧舍，西来尔独临。\n径开黄叶积，窗掩白云深。\n落魄怜生事，栖迟见素心。\n朱弦能一奏，岂是为知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都下遇邵文学长孺有赠和答一首","author":"李英","text":"傲倪蓟门下，重逢感慨多。\n奏书君未遇，弹铗我能歌。\n魏阙频车毂，江乡有薜萝。\n垆头堪醉否，容易隔山河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙子早春送方元素还歙","author":"李英","text":"郭生台畔柳，折赠正逢春。\n去矣江南客，凄其蓟北人。\n东风吹犬陆，细雨湿征尘。\n未许辞枫陛，黄山作外臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送罗范阳山人游嵩山","author":"李英","text":"长安送客处，把袂思悠哉。\n马首燕云尽，关前岳色开。\n飞鸿过大泽，积雪满平台。\n尔采三花树，何由远寄来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答田博士","author":"李英","text":"风流田国士，江左自翩翩。\n似是居驺客，今逢入洛年。\n甘泉秋献赋，碣石夜谈天。\n愧我双钓色，蹉跎傍日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙子除夕","author":"李英","text":"穷愁一岁过，何事滞燕台。\n柏叶觞仍举，梅花使不来。\n银灯寒影照，玉漏夜声催。\n明日南楼望，江鸿渐欲回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别郭太学建初还闽中","author":"李英","text":"君今天下士，更有古人风。\n侠自留燕重，才因入洛雄。\n星辰怜聚首，江海叹飘蓬。\n别去伤春夜，闽山在梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王体仁之豫章","author":"李英","text":"上林春似海，君去莫能留。\n御柳千丝密，黄鹂百啭愁。\n山青回夕照，云白度江流。\n到日燕鸿过，题书及蓟州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日卧病显恩僧舍承邬文学汝翼贻诗枉问赋此答之","author":"李英","text":"寂寂掩松萝，秋声萧寺多。\n劳君传七发，为我起沈痾。\n书似文园病，贫能杜甫歌。\n京江他日梦，迢递阻沧波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送潘上人舍子朋南归","author":"李英","text":"卧病难为别，君今问寝还。\n秋风吹潞渚，几日过秦关。\n照乘沧池月，藏书白鹤山。\n重闱方健饭，须早入朝班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陆山人华甫还吴中","author":"李英","text":"抱病怜君去，销魂不可言。\n飘然归茂苑，念我卧祇园。\n水国莼羹美，秋阴桂树繁。\n扁舟还有约，江上访柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"斋中对菊怀静修上人","author":"李英","text":"病起逢摇落，黄花开几枝。\n独怜居士屩，曾诵远公诗。\n斗酒难成醉，椷书有所思。\n翛然双树下，明月与君期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮","author":"李英","text":"蓟北岁欲暮，蹒跚步不胜。\n天涯双白发，客舍一青灯。\n浪迹已如此，岩栖尚未能。\n梅花千树发，心寄岭云层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自述","author":"李英","text":"铁砚生涯老鹖冠，烟波三载负鱼竿。\n梅开蓟北孤窗冷，雁去江南一字看。\n醉哭穷途非阮籍，高歌长铗愧冯欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁丑除夕","author":"李英","text":"爆竹京台夕，浮生客似星。\n风尘怜马走，天地寄鸿冥。\n易水迎春白，燕山送晚青。\n所思千万里，飞梦下烟汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李上舍南归","author":"李英","text":"少年游上国，名冠鲁诸生。\n惜此三春别，飘然万里行。\n承欢怀綵服，奏赋望金茎。\n岁晚吾将去，山田欲课耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邵太学使江南因归省觐","author":"李英","text":"一轺南去日，衔命出西京。\n山驿占星候，江帆带月行。\n閒居潘赋乐，奉使陆装轻。\n綵服来须早，金门待长卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李明府椷遗葛履兼贶六韵问病二首 其一","author":"李英","text":"词人能解赠，黄帽与青鞋。\n抱是烟霞疾，凄其土木骸。\n短藜扶蹇步，芳草动归怀。\n谁道缁衣馆，偏怜破砚斋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李明府椷遗葛履兼贶六韵问病二首 其二","author":"李英","text":"白马长安令，投余大隐篇。\n封椷遗侧陋，怀袖奉周旋。\n岭峤青霞上，关门紫气前。\n流沙他日去，稽首著书年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠姚太医","author":"李英","text":"吴下医名大，人推鲍太玄。\n家声千卷在，儒业一经传。\n卖药能供酒，持筇不挂钱。\n相如独消渴，愿乞上池泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送苍云上人还金陵","author":"李英","text":"沧波秋色远，一苇渡江东。\n别路风沙外，还山幻住中。\n碧云诗欲拟，苍雪笔偏工。\n去矣成千里，椷书寄塞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王鸿胪归养","author":"李英","text":"诏许潘郎去，秋风昼锦归。\n枫江辞魏阙，菽水奉慈闱。\n采秀太湖石，栖霞白板扉。\n长安西笑日，莫遣滞渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都下逢孙伯远时有岭南之行赋此为赠","author":"李英","text":"多才怜小阮，不但语惊人。\n偶作并州客，悲歌易水滨。\n双钩狂自舞，十日醉为真。\n别我罗浮去，梅花万树春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]