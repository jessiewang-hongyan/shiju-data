[{"title":"宿西湖巾子山刘氏别业","author":"谢与思","text":"湖岸朱栏迥，春宵亦借眠。\n烟林自渺渺，水月故娟娟。\n梦引此村鹤，磬生何处禅。\n微宫何足恋，顿欲寐尘缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初至都门与陈生别","author":"谢与思","text":"游燕还恋越，少别却相寻。\n百队风沙苦，三年意气深。\n飞腾终刷羽，岐路总关心。\n后夜虚斋梦，清蛩候月吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发北关有怀槜李姚江诸子","author":"谢与思","text":"小艇辞烟郭，孤踪寄薜萝。\n风前诸彦集，花底一尊过。\n出语云生袂，传觞月始波。\n今宵山寺梦，应恨促骊歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过居山人值雨","author":"谢与思","text":"小径居高士，青山对榻开。\n诗抄穷海去，书换好鹅回。\n风雨忽川岳，匏冠只草莱。\n茗炉耽尔话，檐溜决花台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无锡篇赠如序上人","author":"谢与思","text":"我已非真我，弦何是有□。\n看波仍灭水，把月自还天。\n默默尽空界，泠泠彻大年。\n平生无挂意，羡尔得单传。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"谢与思","text":"暧暧烟际树，悠悠原上村。\n奇峦羃云脚，激水漱石根。\n远色虚难拟，幽襟孤可扪。\n虽无跻攀侣，兹地足隐沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀庄生","author":"谢与思","text":"秋水系烟棹，越吟愁绮疏。\n各天人不见，为雨梦应虚。\n玉想初承唾，香留旧剪裾。\n惟惭公子贵，空复恋前鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过崇德哭李子升年兄","author":"谢与思","text":"死别怜吾辈，经行感旧黎。\n音传花作县，早已竹成堤。\n苦雨翻空急，寒烟带日凄。\n不堪愁绝处，城上乱乌啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"少梅篇为乡人卢氏赋号","author":"谢与思","text":"玉蕊先春漏，名香带晓笼。\n新应争朔雪，弱不受玄风。\n塞笛吹难落，花神梦未浓。\n惟馀美人思，偏讶小窗丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨湖秋泛","author":"谢与思","text":"片舸荡秋空，云峦翠几重。\n花边添野水，鸟外下村舂。\n风入频催羽，吟高一划龙。\n醉馀藉堤草，齐拍任儿童。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中送王伯良病足东渡","author":"谢与思","text":"屐有先登兴，堂怜不下时。\n山灵笑拘束，吾意恨羁离。\n雨裛囊琴润，潮生渡鹤迟。\n那堪官阁望，吟苦独支颐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋发武林沈子阳子熙陈立甫王伯良朱少白诸子送我富渚赋此为别","author":"谢与思","text":"客思绕并州，双舲别杪秋。\n泪将华袖满，心向宝刀酬。\n落汐明寒渚，回飔引暮篝。\n犹疑鉴湖曲，尊酒澹羁愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朱少白醉后走笔","author":"谢与思","text":"激涧回丹树，孤舟涌白波。\n言从东道去，其奈故人何。\n匡鼎谈诗剧，扬雄问字过。\n明朝江阁思，玉轸怨弦多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与舍弟夜酌二首 其一","author":"谢与思","text":"一尊明月满，千里暮云开。\n故国违鸿雁，閒庭自草莱。\n松风吹解带，江色照衔杯。\n不尽佳人思，空看畹蕙催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与舍弟夜酌二首 其二","author":"谢与思","text":"砌雨春难寐，篝灯夜可怜。\n寒更人语外，客思蒯缑前。\n绿自添新酒，青犹恋故毡。\n欲将乡国泪，竹里百重泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝","author":"谢与思","text":"万壑阴晴换，孤山瘴疠侵。\n暂看花到眼，翻觉节惊心。\n懒就抛囊草，贫馀絓壁琴。\n今朝春酒绿，愁绝不堪斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙门道中","author":"谢与思","text":"客行殊未已，白露遍平芜。\n野火穿林小，寒星隐涧孤。\n人烟经战伐，生计有樵苏。\n为问中山叟，今年少吏呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟夜忆湖上人","author":"谢与思","text":"月色沈鲛室，箫声隔凤楼。\n一生倾国恨，双鬓涉江秋。\n青鸟遥堪寄，明珠暗未投。\n为怜娇艳质，莫待岁华流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同舍弟登青湖寺亭","author":"谢与思","text":"列磴回丹树，閒亭俯碧流。\n风云四壁静，镫火一村幽。\n易遣芳尊暮，难禁远望愁。\n坐看渔父乐，隔浦动轻讴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱生怀内索春闺怨戏作","author":"谢与思","text":"寂寞掩春闺，缘阶草色萋。\n镜中鸾自舞，楼上凤应迷。\n锦字缄新怨，罗巾蚀旧啼。\n向人那解说，肠断在乌栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夕怀沈仲子未至","author":"谢与思","text":"赪鲤经秋断，黄花映坐寒。\n天涯为客久，梦里故人欢。\n隔户移风竹，褰衣转泽兰。\n思君如可到，长遣酒怀宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠赣县邓画师","author":"谢与思","text":"绝蓺丹青擅，飘然弄素翰。\n花明莱子服，云切楚臣冠。\n银海将神度，玄岩著膝安。\n不知身是幻，持作故吾看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宁化蒋簿归养索赠赋此","author":"谢与思","text":"念尔云间骏，辞官娱老亲。\n朱门无揖客，沧海独归人。\n径岂荒丛竹，盘犹足细鳞。\n吾惭潘令赋，薄宦拙谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"慎斋林师远访赋赠","author":"谢与思","text":"吾师意潇洒，杖履历山川。\n不有高轩过，斋头榻旧悬。\n寒星侵坐语，流水写鸣弦。\n惟愧牛刀训，卑栖老一毡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长至","author":"谢与思","text":"微阳回朔气，云物倍飕飕。\n岁月逢长至，风尘叹薄游。\n停车道傍树，把酒市中楼。\n欲渡黄河水，萧条雪满舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"问傅生病","author":"谢与思","text":"闻道途穷客，归来赋索居。\n三秋仍伏枕，万事总抛书。\n隋叶从风扫，流萤及雨除。\n论文尊酒在，朋好莫全疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆弟","author":"谢与思","text":"论年尔尚幼，为别我难忘。\n会识诗中圣，无劳醉后狂。\n登楼近山好，散帙小池凉。\n若问风尘事，归来语亦伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阴道中有怀黄叔化年丈","author":"谢与思","text":"古树浸江密，朝岚隐岫空。\n夫君何处所，觞咏昨宵同。\n计自投竿拙，人今掩袖工。\n无将长庆句，悽恻付玲珑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日游智度寺","author":"谢与思","text":"九日招提境，登临剩欲狂。\n羽觞随意发，篱菊近人黄。\n避俗爱清梵，谈经闻妙香。\n下方人吏待，驱马又须忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别黄叔化","author":"谢与思","text":"共是南游客，分飞复此州。\n欲招春作伴，翻觉酒生愁。\n古道云栖石，归风柳映舟。\n明朝忆携手，寒色蘸中流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送周见吾南还","author":"谢与思","text":"劳歌燕市酒，驱马旧家山。\n以我经时病，惜君将别颜。\n风尘孤宦在，湖海尺书难。\n何日开三径，求羊许共攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得薄雾笼花","author":"谢与思","text":"玉树朱华艳，芳晨紫雾笼。\n微分团砌色，稍辨簇香丛。\n风袅珠难胜，阳晞縠转濛。\n临觞欣赏意，应较昨宵浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日登南安东山","author":"谢与思","text":"自怜天畔眼，又对菊花丛。\n醉折东山屐，醒回落帽风。\n竹光移石榻，萝月上珠宫。\n归路烟霞隔，寒钟出涧东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚酌","author":"谢与思","text":"苦热山城剧，携樽暮竹前。\n楼将返照歛，池护绿阴偏。\n藉草衣随解，乘风席每迁。\n人生个自足，莫受百愁煎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中作","author":"谢与思","text":"棱棱七尺骨，坐卧对空山。\n病久节从换，才疏官较閒。\n呼儿抽药裹，避客静柴关。\n乞地非勾漏，何心问大还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临城即事","author":"谢与思","text":"华馆青丝驻，梨园白玉飘。\n芳尘兼燕蹴，艳曲度莺娇。\n欲赋巫山梦，还疑洛水遥。\n无将明烛泪，滴向可怜宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得杨白花","author":"谢与思","text":"何许伤心剧，春风杨白花。\n稀疏媚朝日，淡荡逐年华。\n夹道频嘶马，缘堤半宿鸦。\n惟应惬幽赏，移种野人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛湖有怀玄崖先生","author":"谢与思","text":"扁舟乘月放，十里静歌钟。\n塔影悬镫迥，湖光鼓枻空。\n人烟非旧赏，觞咏好谁同。\n尚有遗篇在，风流忆老翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发高唐","author":"谢与思","text":"不寐先晨发，空林散鸟啼。\n月寒人影小，天阔戍墩低。\n失路认来骑，占时听远鸡。\n苦吟还未就，鞭促背囊奚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"萧君汝瑩暨其仲弟孔植汝莳饯子三峰寺时张生晋卿郑生孔实君佐尔钦辈亦送予于此遂同夜集","author":"谢与思","text":"陶令挂冠日，东篱菊正华。\n无心怀簿领，有伴到烟霞。\n话久青檠短，情深绿醑赊。\n别离何所恨，吾道得侯芭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"永安赖氏别业在寿春岩故称名胜戊子之秋余自大田言归而门人萧生汝培独骑追送薄暮经焉辄辱地主吉泉君偕游因赋二律 其一","author":"谢与思","text":"主贤能倒屣，客倦此停镳。\n洞壑云扃启，琴尊玉麈邀。\n看棋仍扫石，把钓却过桥。\n坐使烦嚣隔，寻真路不遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"永安赖氏别业在寿春岩故称名胜戊子之秋余自大田言归而门人萧生汝培独骑追送薄暮经焉辄辱地主吉泉君偕游因赋二律 其二","author":"谢与思","text":"绣阁横云峻，丹梯绝磴通。\n鸟啼依径竹，人对飏花风。\n俯眺湖光白，酣歌烛燄红。\n今宵归兴缓，还喜友生同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芰荷服新成","author":"谢与思","text":"野服清凉杼，呼童试若何。\n裁应七尺称，□借九秋多。\n弄盏深能映，搴芳稍辨歌。\n还须将片箨，同倚碧山阿。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初归同诸弟夜坐","author":"谢与思","text":"拂尘坐来久，轻飏生绤衣。\n半年几今夕，为客正东归。\n露裛竹梢润，萤穿书幌微。\n但愁城际月，清漏促光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬至后集元祯叔宅得鱼字","author":"谢与思","text":"促席杯当手，搴芳玉映除。\n棋谈安石野，字问子云庐。\n物色凌寒转，年光入鬓疏。\n还怜魏公子，情竭在前鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同曾完初诸君游海珠寺","author":"谢与思","text":"碧树明秋霭，清飙度晚钟。\n回流彯组练，列嶂削芙蓉。\n渔唱纷堪引，鸥盟浩欲从。\n却怜星聚处，珠已探丽龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"携李王文学伯仲饮予西湖谈烟雨楼之胜因偕会稽王道坚登之","author":"谢与思","text":"一上高楼悲远天，谁飞岛屿压长川。\n烟含万树当窗没，雨净千帆拂镜悬。\n未向沉沦耽把钓，若为消渴酌寒泉。\n登临此际怜王粲，那复湖头汎酒船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金山二首 其一","author":"谢与思","text":"水国何年拥此邱，乾坤佳气郁中州。\n梵钟响度吴门霁，海树寒生楚甸秋。\n风细鱼灯低入牖，日高鲸浪近摇楼。\n将因法界窥空色，聊得攀缘一系舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金山二首 其二","author":"谢与思","text":"绝辟秖邀天汉路，披云更蹑妙高台。\n千樯下破江光阔，两郭平临岸势回。\n客自品泉供沦茗，僧从乞食坐浮杯。\n凭栏为洒英雄泪，南北戈鋋有劫灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宾竹篇为乡人卢氏赋归","author":"谢与思","text":"万里移家依茂苑，十年开径满湘筠。\n閒庭洒扫从车马，散屐阶除自主宾。\n澹景隔云凉入梦，疏梢临水碧涵春。\n知君节操元如玉，遮莫颠毛总似银。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别周将军兼寄黄叔化同年","author":"谢与思","text":"骄嘶紫燕历羊肠，九陌看君几度霜。\n归束短衣飞将幕，出提雄剑少年场。\n乡心易醉呼持蟹，国士难酬想式螳。\n东道若逢黄叔度，丈夫今已笑昂藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沛上怀古","author":"谢与思","text":"王气销沉井邑钟，翠华曾此集扶筇。\n江流已失彭城马，剑去尤号芒砀龙。\n击筑有歌残碣卧，离宫无主野蒿封。\n停鞭亦自悲游子，指点风云意每雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟泊虎邱全伯典自四明追及感而赋别","author":"谢与思","text":"吴苑晴芳野色开，客居旬日坐莓苔。\n山中风物谁堪侣，江上烟帆尔独来。\n春井虎光沉剑壁，午钟花雨散经台。\n明朝南北俱尘旅，可负当尊锦瑟催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邹县道中","author":"谢与思","text":"隔水高城生野烟，冲坭疋马晚堪怜。\n及期畦麦应丛发，欲止林乌时一旋。\n泣璞孤臣终献主，寻砂何地许延年。\n伤心青幔开春酿，醉指长安更日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀沈生伯仲","author":"谢与思","text":"苦忆沈家好兄弟，时常清梦在山阴。\n病馀药饵劳生事，书去关河见客心。\n湖荇旧随青雀泛，窗镫虚映紫霞斟。\n江门秋色吾将问，对尔风前桂树森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东平道中赋得风中絮","author":"谢与思","text":"陌头杨柳花应稀，树树经风剌眼飞。\n每恨芬芳根并结，谁怜飘泊质元微。\n河豚应节翻虚上，屯雀群喧太剧饥。\n糁径已惊春事晚，江湖萍梗定何依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙酉夏日喜雨","author":"谢与思","text":"郊壝露祷劳明主，一雨真宽恤瘼心。\n敢谓旱乾须版筑，已看沾洒应桑林。\n侵畦麦变纤纤动，覆径榆回宛宛阴。\n野老灌园休抱瓮，稳眠初称暮凉深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚泊萧荷花祠","author":"谢与思","text":"古庙阴林野火青，乱萤秋雨渚云腥。\n波涛不洗曹娥恨，环佩空归湘女灵。\n银烛双悬吹袅袅，锦帆孤逗落冥冥。\n殷勤欲采蘋花荐，尤睹清霜拂幔铃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题五首 其一","author":"谢与思","text":"肠断秋江垂柳斜，轻风迢递引香车。\n空惊藻句来红叶，那遣芳心恐白花。\n兰佩可容贻下女，粉墙何事避东家。\n即今咫尺仙源窅，谁汎银河八月槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题五首 其二","author":"谢与思","text":"横塘花发动兰舟，镇日相思到水头。\n环佩步阑春渺渺，珊瑚栖冷夜悠悠。\n窗悬碧汉看星度，坐惜朱颜借酒酬。\n欲倚微风挥玉轸，求凰一曲使人愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题五首 其三","author":"谢与思","text":"独倚疏棂暗燄飘，梦回蝴蝶恋空宵。\n心如寸茧丝应结，身比春冰骨易消。\n深洞桃花无去路，隔河乌鹊未成桥。\n愁来剩有相思字，题破阶前万叶蕉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题五首 其四","author":"谢与思","text":"阳台云雨日虚无，枕上千行洒辘轳。\n书去画梁空燕雀，愁来江浦换蘼芜。\n谁家锦帐邀春住，此夕青灯带影孤。\n莫把明珠买倾国，马卿四壁有当垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题五首 其五","author":"谢与思","text":"若个芳年十日豪，空怜续命五丝劳。\n花心自许飘金埒，酒态那辞污锦袍。\n炉兽烟浓香梦绕，烛龙光散泪痕高。\n凭将乐事当春色，青冢何人问薜涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜与舍弟小酌二首即席赋 其一","author":"谢与思","text":"野馆梅花晚自舒，清尊酩酊独愁予。\n孤城节序灯前泪，十载交游袖里书。\n剑浦寒芒驱罔象，武夷佳气护储胥。\n空将綵笔酬云物，赋就阳春总未如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜与舍弟小酌二首即席赋 其二","author":"谢与思","text":"山城微雨长园蔬，桂醑频倾破索居。\n双眼怜春馀子夜，百年怀土岂吾庐。\n禁愁绿鬓催花落，对客青山映榻□。\n谁道扬雄应寂寞，草元今就箧中书。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题上寿荣封卷","author":"谢与思","text":"马坞高峰翠崿联，徵君齿德并山川。\n采芝剩有金光在，种桂都成玉魄圆。\n凫舄养分天上禄，鱼头宠拜耄馀年。\n只今何以酬明贶，忠孝传家两字全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":17329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]