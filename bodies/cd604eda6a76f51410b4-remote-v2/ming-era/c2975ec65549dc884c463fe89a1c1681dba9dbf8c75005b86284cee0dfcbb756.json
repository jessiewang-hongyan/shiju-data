[{"title":"钟天章张伯邻二户曹载酒夜过","author":"欧大任","text":"酒榼何因至，蓬门偶一开。\n谁知居士室，犹有故人杯。\n落魄看交态，分曹见吏才。\n鹔鹴吾已典，萝月几回来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冯侍御共宿归义寺禅房","author":"欧大任","text":"谁期趋府客，同有住山心。\n涧鹿窥禅诵，林猿听苦吟。\n清斋黄菊冷，孤磬白云深。\n安石膺朝寄，幽盟未敢寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答曾缮部省中见招","author":"欧大任","text":"省署散群吏，知君绕径行。\n听松心独远，把菊句还成。\n簪组时人态，浮沉大隐情。\n谁当虚左待，宾客老侯生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与黎秘书夜集曾缮部省中得花字","author":"欧大任","text":"官舍绕霜花，邀欢兴未涯。\n雁鸿秋万里，砧杵夜千家。\n明月松杉直，高天河汉斜。\n潘郎宁拙宦，词赋满京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送潘时服省觐还吴兴","author":"欧大任","text":"同待公车诏，秋风一骑还。\n以吾思问寝，羡尔去承颜。\n钓鲤太湖水，采芝天目山。\n故人期握手，春色到燕关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张山人碵夫游东岳","author":"欧大任","text":"支瓢不惮远，东谒泰山君。\n河带泠泠水，松栖片片云。\n玉书窗下诵，金策月中闻。\n归上诸儒议，千秋汉禅文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎惟敬初度曾缮部有作即席索和","author":"欧大任","text":"市隐扬云宅，风流贺监年。\n清歌停座上，紫气落尊前。\n词赋谁争长，婵娟却自怜。\n金门沉陆久，那识是神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何别驾见可之晋陵","author":"欧大任","text":"佐郡推经术，名儒出汉庭。\n严霜醒蓟酒，落月引吴舲。\n稻熟荆溪馆，鲈肥笠泽亭。\n延州歌颂在，谁共使君听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"范员外见访偶出不得款待柬谢一首","author":"欧大任","text":"子猷非兴尽，犹是雪中回。\n终愧凿坏遁，难逢结驷来。\n芸窗黄叶积，蒿径白云开。\n更枉夷门顾，清尊得共陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陆元德还山二首 其一","author":"欧大任","text":"洛下辞伧父，咸阳厌布衣。\n遂成歌凤隐，不为忆鲈归。\n名岂菰蒲掩，身才糠籺肥。\n赁舂今且去，吾道未全非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陆元德还山二首 其二","author":"欧大任","text":"谁念客游者，归装无一金。\n检书黄叶积，荷锸白云深。\n亲膳供莼菜，官租指橘林。\n因君寻角里，先寄五湖心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"姚元白黎惟敬张羽王见过小酌得孤字","author":"欧大任","text":"燕市浮沉日，将谁向酒垆。\n自难期贵客，君肯问潜夫。\n白眼千人废，黄金一醉无。\n却看星斗上，剑气不曾孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中访洪山人从周不遇","author":"欧大任","text":"一径无车马，相寻且杖藜。\n戴因招隐忆，袁岂避人栖。\n仗虎炉空在，笼鹅帖懒题。\n蹇驴何处去，应过灞桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晏旅中寄故园诸子十二首 其一 邝子乾","author":"欧大任","text":"鹤氅高斋日，貂裘久客间。\n饥寒驱我出，鱼菽羡君閒。\n落羽栖燕渚，归心度汉关。\n故乡兵甲后，那得帛书还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晏旅中寄故园诸子十二首 其二 郑克一","author":"欧大任","text":"严遵常闭肆，匡鼎亦传经。\n短褐谁曾问，哀歌只自听。\n观棋多妙理，嗜酒且沉冥。\n楚客宁知此，江潭赋独醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晏旅中寄故园诸子十二首 其三 陈潜父","author":"欧大任","text":"柴荆君独掩，怀抱向谁开。\n日惨朱旗闪，云愁白雁来。\n蒯缑多侠气，草屦老生涯。\n二仲应相过，江乡望我回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晏旅中寄故园诸子十二首 其四 陈梦庚","author":"欧大任","text":"故人无一字，目极为伤神。\n虎观求方急，牛衣卧独贫。\n罪言忧战伐，饥色杂风尘。\n岂不怜同舍，飘零万里身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晏旅中寄故园诸子十二首 其五 梁公瑞","author":"欧大任","text":"论交兄弟少，每忆长公诗。\n书札能相慰，干戈未可期。\n铜鞮君隐早，玉笈我归迟。\n知有青箱在，行藏任鬓丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晏旅中寄故园诸子十二首 其六 林维乔","author":"欧大任","text":"与君期出世，那复待玄纁。\n聊试漆园吏，将寻沧海君。\n玉颜如可驻，金液早须分。\n南北艰虞日，椷书报白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晏旅中寄故园诸子十二首 其七 黎惟仁","author":"欧大任","text":"寒霄频梦远，多在故人家。\n箫咽云成綵，杯深月散华。\n孤亭吟列岫，三径醉餐花。\n忽复烟波外，书归汉使槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晏旅中寄故园诸子十二首 其八 潘干周","author":"欧大任","text":"扁舟相访处，浑似武陵溪。\n岁月期看竹，风烟忆杖藜。\n橘林双渡口，草阁万峰西。\n斥堠年年远，重来路恐迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晏旅中寄故园诸子十二首 其九 潘少承","author":"欧大任","text":"昔年台尚好，共隐大科南。\n犬护山厨火，猿听海客谈。\n烟中捐蕙佩，云里锁松庵。\n君自谙吾性，移文亦不惭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晏旅中寄故园诸子十二首 其十 梁少学","author":"欧大任","text":"阮氏仲客贤，名家业已传。\n峤南霜橘帖，海上牡丹篇。\n远信劳鱼素，穷交念酒钱。\n崇兰君莫寄，抽思向江天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晏旅中寄故园诸子十二首 其十一 罗曜文","author":"欧大任","text":"故园多难日，消息尚纷纭。\n朋旧空相忆，安危久未闻。\n兵骄寻陕战，戍苦伏波军。\n问讯沧洲上，渔樵亦可群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晏旅中寄故园诸子十二首 其十二 梁仲登","author":"欧大任","text":"苦忆江楼别，北来音信疏。\n曾投章甫去，几卜杜陵居。\n岭峤仍烽火，朝廷问捷书。\n不知溪上客，入幕策何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中送别姚元白还金陵","author":"欧大任","text":"寒城一以别，晓骑发卢沟。\n燕代千山过，关河大传游。\n鸡声惊叠鼓，雪片乱征裘。\n去听江南笛，应思倦客愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴明卿自闽至寒夜同集吴约卿谒舍得明字","author":"欧大任","text":"何期燕市酒，并得楚狂生。\n词赋空时辈，歌呼岂世情。\n幔亭云片落，碣石雪花明。\n莫问垆头夜，沉酣有步兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同吴员外过韩员外子成宅饮时子成以病在告","author":"欧大任","text":"病爱枚乘笔，闲资季重谈。\n颇从京洛下，一望石湖南。\n月俸还官藉，山经与客参。\n何因歌九辨，憔悴忆江潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴侍御席上赠门人张玉归武定省觐","author":"欧大任","text":"两月传经去，宁亲借使骢。\n席常虚待左，道岂敢云东。\n射策张家子，能诗任氏童。\n苍苍岱云里，何处听春鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁尽独卧长安客舍怀文休承","author":"欧大任","text":"公车同此夕，别去又经年。\n格五无宣召，朱儒自俸钱。\n孤灯残雪后，乱帙小窗前。\n谁共文江客，屠苏一醉眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同明卿惟敬过约卿宅得朝字时除前一夕","author":"欧大任","text":"坐期官烛尽，且以永今宵。\n纵酒惟吾辈，狂歌有圣朝。\n胜传金缕蝶，颂倚玉盘椒。\n城角风前断，空闻枥马骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日同张山人孙鸿胪徐文学集诚意伯刘公宅得盘字","author":"欧大任","text":"西堂冠剑合，春酒一筵欢。\n七叶蓂初长，千条柳尚寒。\n河山连甲第，歌管荐辛盘。\n华胜风前影，持觞几度看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同黎惟敬询韩子成病 其一","author":"欧大任","text":"同是沉冥客，言寻消渴人。\n避諠三署夕，归计五湖春。\n玄晏成书早，维摩示病真。\n相将江乘浦，烟艇共垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同黎惟敬询韩子成病 其二","author":"欧大任","text":"同谢鹓鸿侣，而私丘壑身。\n赐衣沽酒尽，积俸买山贫。\n梦蝶閒园吏，怀荃托楚臣。\n因君上书早，偏忆岭南春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日同社诸公集道院咏雪得庭字","author":"欧大任","text":"岁献云含白，春回树失青。\n鸾骖停玉笥，鹤氅肃金庭。\n梅萼丛丛湿，松枝片片零。\n何当笙磬发，同听蕊珠经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜大雪骑过明卿邸中","author":"欧大任","text":"山阴吾兴剧，一骑偶冲寒。\n栖凤银成阙，游龙玉作鞍。\n云中妆树出，空里散花残。\n为爱阳春曲，来同郢客看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十三夜同苏子川黎惟敬方德新吴明卿苏子冲成仁卿黄定甫集吴约卿观灯得开字","author":"欧大任","text":"银缸生暖色，谁省在霜台。\n月傍琼枝出，花攒火树开。\n杯盘欢五夜，赋颂见群才。\n隐隐闻歌笑，鸾舆太乙回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5330,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆华父金元宾邀饮灵济宫赵道士馆","author":"欧大任","text":"同作华阳客，过从惬素情。\n市朝多大隐，喧寂共浮生。\n坛石流云湿，山钟过雪清。\n问君携手约，金液几时成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5331,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"范方伯职方兄弟邀同吴太守庄黄二文学汪吴二山人夜集分得兵字","author":"欧大任","text":"华筵逢二陆，春色凤皇城。\n一雨沉花气，千门过雁声。\n狂歌何处客，浊酒此时情。\n竹径风流在，谁如阮步兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5332,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬厉都谏滦河见寄","author":"欧大任","text":"憔悴投荒去，何年祀碧鸡。\n谁怜青琐客，自老白云栖。\n碣石春涛外，卢龙暮角西。\n安危还寄托，健饭且扶藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5333,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"期陈明府子野晚过","author":"欧大任","text":"君岂陈惊座，邀欢满汉都。\n懒朝仍傲吏，纵饮亦吾徒。\n夕苑千花暗，春沟片月孤。\n糟床堪一斗，乘兴肯来无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5334,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题冯汝行海浮山居图","author":"欧大任","text":"远识金银气，舟行望转微。\n楼台疑蜃起，风雨挟鹏飞。\n孤岛分齐鲁，千山入海沂。\n图南吾欲去，渺渺泛潮归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5335,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾缮部省中夜赏牡丹得狂字","author":"欧大任","text":"官阁题诗夜，重陪水部郎。\n花摇池槛影，酒洽竹林狂。\n国色含烟紫，宫妆写额黄。\n月中看不足，汉署更闻香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5336,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送冯明府谪教润州","author":"欧大任","text":"讲肆延陶令，今非马队扃。\n葛巾原漉酒，绛帐且传经。\n高浪西津白，生烟北固青。\n江南书札近，好寄鹤丘铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5337,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈子野调令宁乡","author":"欧大任","text":"古来才子地，天遣到长沙。\n谁道三湘水，今看一县花。\n橘洲收井税，竹浪见人家。\n君自谈云梦，无令楚客誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5338,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送丁子文赴浙省","author":"欧大任","text":"名士曾书记，之官亦散曹。\n登楼中夜月，作赋曲江涛。\n荷叶迎仙棹，薇花洒客袍。\n知君还北望，离思满烟皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5339,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太保刘文安公彰恩卷 其一","author":"欧大任","text":"功德四朝日，河汾千载馀。\n曲台家乘礼，东观世藏书。\n诵岂多三箧，名因出九胪。\n殿前曾剑履，师傅几人如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5340,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太保刘文安公彰恩卷 其二","author":"欧大任","text":"风雨中台坼，笳箫上党寒。\n崇班瞻太保，旧学失甘盘。\n瓜奠频繁遣，槐阴次第看。\n凤毛今五色，得恐谢家难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5341,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日集周都督子脩宅得诗字","author":"欧大任","text":"缓带从容日，天中盛赋诗。\n总戎周太尉，好客郑当时。\n射柳无劳试，觞蒲且共持。\n陆沉金马下，三见汉宫丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5342,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中承曾缮部见召不赴缮部以予将归曾有二诗意最勤厚因并酬答","author":"欧大任","text":"倦游仍伏枕，归思更何如。\n君已怜将别，吾方念介居。\n家贫沧海钓，身老茂陵书。\n知有盈觞酒，还来伴直庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5343,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘伯良宰信宜","author":"欧大任","text":"明卿春出牧，慷慨又刘生。\n邸吏惊怀印，都人羡请缨。\n云随铜柱尽，山过窦州平。\n我欲移家去，鸣弦听诵声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5344,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送从弟淳伯南归二首 其一","author":"欧大任","text":"三载惊相见，都亭把袂时。\n游梁吾已倦，入洛尔何迟。\n谁诵淩云赋，仍为失路悲。\n天涯贫贱别，只少杜陵诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5345,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送从弟淳伯南归二首 其二","author":"欧大任","text":"同有怀萱梦，而先戏彩欢。\n朝餐行荐笋，秋佩且纫兰。\n山笥归时检，尘冠异日弹。\n长安春柳色，还待玉骢看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5346,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日同潘时良出访徐子与因避暑张园 其一","author":"欧大任","text":"休沐名园里，飞觞细雨前。\n瓜期元不偶，萍迹况相怜。\n避暑仍袁绍，登楼亦仲宣。\n何须仙掌露，心赏已泠然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5347,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日同潘时良出访徐子与因避暑张园 其二","author":"欧大任","text":"空庭回赤日，万竹驻高轩。\n入座凉飙满，披襟玉露繁。\n风尘俱傲吏，河朔一清尊。\n即此看沉陆，无论金马门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5348,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同徐子与使君过袁鲁望进士留酌","author":"欧大任","text":"燕市吾徒在，相携片语真。\n饥寒驱薄宦，簪绂偶时人。\n醉看青萍短，娇歌白纻新。\n君看袁夏甫，落落傍风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同曾缮部宿省中得园字","author":"欧大任","text":"邀欢成伴直，退食一清尊。\n画省更明月，铜驼非故园。\n竹阴凉露滴，楼影夜乌翻。\n看尔郎官草，青绫怀主恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方侍御德新宅伏日同诸公宴集得台字","author":"欧大任","text":"青骢人正避，皂帽客犹来。\n酒以金鱼换，谈容玉麈陪。\n迎风开岳色，消暑倚霜台。\n君已投车辖，那能不醉回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中顾汝所招饮不赴闻是日子与先归鲁望吐酒有污茵之句因以戏之","author":"欧大任","text":"消渴难乘兴，空斋独闭关。\n最思光禄酒，一望太行山。\n客劝袁丝饮，人歌山简还。\n不知谁戏剧，噀雨到人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5352,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伏日同徐子与顾汝和袁鲁望沈道桢顾汝所集文寿承斋中得家字","author":"欧大任","text":"同心曾海岳，握手偶京华。\n酒狎高阳侣，诗称博士家。\n盘冰寒苜蓿，井碧泛甘瓜。\n独有留欢处，空庭日易斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5353,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨朝藩掌教安仁","author":"欧大任","text":"洞庭南去路，文学得君良。\n地以琳琅重，洲因橘櫾香。\n听猿过楚岫，看雁到衡阳。\n莫道王程远，由来近帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5354,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张彦旬掌教诸城","author":"欧大任","text":"赐履千秋地，谭经五岭豪。\n汉儒称世业，齐客亦吾曹。\n马耳登台见，琅琊出浪高。\n傥能游海上，为我访卢敖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5355,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋日同文寿承徐子与顾汝和沈道桢顾汝所朱子愚饮袁鲁望宅得凉字","author":"欧大任","text":"秋催词客赋，晚醉酒人傍。\n纨扇西风早，絺衣白露凉。\n落梅惊玉笛，坠叶响银床。\n惟有潘郎鬓，飘零感异乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5356,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王茂成归括苍 其一","author":"欧大任","text":"骏足图难索，蛾眉画莫凭。\n盐车曾涕泪，国色未须矜。\n秋菊怀三径，燕歌别五陵。\n大楼岩下月，谁得伴支藤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5357,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王茂成归括苍 其二","author":"欧大任","text":"今日中原客，秋风送汝还。\n五噫辞汉主，一骑出秦关。\n醉眼功名际，浮云去住间。\n黄精归可斸，且看浙西山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5358,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕遇雨同徐使君袁进士刘沈二山人集潘大理宅时子与已有长芦之役","author":"欧大任","text":"月卿重促宴，星使欲临河。\n急雨下秋叶，平池生夕波。\n风前双掌出，云里二灵过。\n且莫捐兰佩，其如怅别何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾缮部以三宅饯徐使君子与得情字","author":"欧大任","text":"故人今夕酒，砧杵凤皇城。\n碣石片云落，渔阳孤月明。\n佩刀看侠气，击筑共平生。\n别后南皮客，应知汉署情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]