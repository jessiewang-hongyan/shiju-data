[{"title":"谒苏文忠公祠","author":"钟继英","text":"遗像层台烟雾中，瓣香几度仰高风。\n遥遥禁院金莲烛，落落天涯白鹤峰。\n两赋至今留赤壁，三言当日副丹衷。\n高才自古多萋菲，翘首嶙峋听晓钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14348,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋水","author":"李应兰","text":"百川随地涌，一色接天清。\n壑冷鱼龙蛰，波浮日月明。\n南连湘浦远，东注海门平。\n望望美人隔，扁舟无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卧病","author":"李应兰","text":"伏枕山斋上，图书晢夕披。\n百年无暇日，一病是閒时。\n梦里虚逢旦，窗前可傲羲。\n小童供茗罢，熟诵杜陵诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早朝后寄所知","author":"李应兰","text":"禁钟初散紫宸朝，云际双茎露未销。\n身惹御香归粉署，心随红日上丹霄。\n西山朔雪千林满，南国风烟万里遥。\n珍重故人沧海隔，玉堤何日共鸣镳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日偕诸寮长集镇海楼","author":"李应兰","text":"佳辰连骑上崔嵬，楼阁平临睥睨开。\n野树依微霜欲染，海云迢递雁初来。\n十年紫剑空横斗，万里黄金尚有台。\n往事悠悠衰草外，西风长啸且衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14352,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送程度支督储清源兼怀郑山人","author":"李应兰","text":"潞水春深绿似芸，锦帆东去度支君。\n珂声晓散承明漏，剑气晴披岱岳云。\n过鲁未忘倾盖语，入齐犹饷射书军。\n旧游忆有琴樽侣，谷口风流自不群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14353,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄孙承卿时督蓟饷","author":"李应兰","text":"塞北风高雁影过，省郎寥落奈秋何。\n云连朔气浮青海，月带寒笳出白河。\n天下军储惟蓟重，中原豪杰莫秦多。\n风尘忆向清源别，载酒何时复笑歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14354,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题钟侍御理蔬小筑","author":"李应兰","text":"与君曾上郭生台，帝里春光醉客杯。\n沧海何年双剑别，风尘回首二毛催。\n桔槔莫问于陵业，侍从还徵司马才。\n直待安车悬岁晏，抱琴长傍碧山来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14355,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过故友邝大年空中楼阁","author":"李应兰","text":"空中楼阁自崔嵬，仙客凌空去不回。\n窥户更无双燕入，傍阑惟有数花开。\n屋梁落月留寒色，邻笛秋风隔夜台。\n十载重临倍惆怅，断云征雁正初来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14356,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽弟经可","author":"李应兰","text":"勋名应拟汉平阳，历尽风尘鬓未霜。\n瀛海天高遥倚剑，潞河秋冷泛归航。\n梦听残雨伤春草，愁断悲风起白杨。\n却爱一经遗业在，悯纶他日有辉光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14357,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"彭南元明府招赴池亭野酌","author":"戴记","text":"草径萧萧带郭斜，小亭池畔半蒹葭。\n邀欢白苎风前曲，爱客青山雨后花。\n远塞风尘催岁律，故人消息尽天涯。\n醉归晚度看流月，忽忆溪山上钓槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14358,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塞上杂咏四首 其一","author":"戴记","text":"无定河边觱栗鸣，夜深灯火赫连城。\n八千里外江南客，边塞悠悠度月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塞上杂咏四首 其二","author":"戴记","text":"万碛千山奏角过，北风吹雪满榆河。\n萧条古戍行人少，衰草寒沙放橐驼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塞上杂咏四首 其三","author":"戴记","text":"受降城外草芊芊，曾记嫖姚北伐年。\n不见燕然铭塞上，汉家天子重安边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"塞上杂咏四首 其四","author":"戴记","text":"大碛茫茫走雪沙，边人处处夜吹笳。\n阴风冻杀祁连雀，千载燕支落汉家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次知府吴国伦鉴江亭诗韵","author":"李一迪","text":"石壁高悬一径回，新亭屹立为谁开。\n云含山色从天落，日送江光入槛来。\n抱病频年怀鉴水，衔杯此地即蓬莱。\n欲归共拟观涛赋，无那郢都白雪才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14363,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈衍死敌","author":"陈一龙","text":"荣膺一命出徂征，勇士堂堂统义兵。\n誓志矢心甘效死，愁云落日竟捐生。\n香山拟并孤高节，锦水空流咽哽声。\n英爽不随阴晦散，夜来长傍斗星明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14364,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镇海楼眺望","author":"黎民怀","text":"镇北有高楼，周遭俯层城。\n险绝逼汉宇，沿洄走沧溟。\n瑶甍鸑鷟奋，金沙匹练澄。\n西关逗丹穴，东岳裛神京。\n巑岏叠翠蔼，睥睨亦通明。\n举扇远缁尘，列席茂荑英。\n黄鹤讵无信，白云空复情。\n琅玕照冰簟，翡翠集櫩楹。\n不废烟霞趣，坐觉衡落清。\n春风嗟王粲，矫首思长征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14365,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五仙台","author":"黎民怀","text":"兹邱临远海，崇观郁崔嵬。\n列仙渺何许，五石明翠苔。\n药圃敞瑶阁，灵液小池回。\n参差朱户转，出没雉云开。\n檀栾荫修竹，阛阓净蒿莱。\n琪花不待插，玄酒宁停杯。\n祠灶乏灵悟，入海非仙才。\n风飙起飞藿，市井无尘埃。\n鸡鸣曙钟歇，朱曦散九垓。\n锵锵运镳郓，霞思良徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14366,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镇海楼送刘职方还留都","author":"黎民怀","text":"江流空阔楚天回，万树秋声绕吹台。\n百代繁华何处问，登高今见大夫才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14367,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"菊月游浮邱","author":"黎民怀","text":"久释樊笼累，养拙甘龙蠖。\n九秋兴攀陟，挹袖谐所托。\n丹垩抚虚馆，紫烟尚浮阁。\n始欣群动息，暂与世缘薄。\n玉管促飞鸾，朱羽时鸣雀。\n平峦收夕霏，远流■归壑。\n清宴美芹粟，华年嘻荑萼。\n岂乏登高怀，所愧正述作。\n悠哉澹忘归，况此成大药。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14368,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日浮邱雅集","author":"黎民怀","text":"金银楼阁空中起，一丈珊瑚明井底。\n披荆开径者为谁，今代风流赵太史。\n国初词客五先生，春色南园草尚青。\n开元遗响久不作，千金灵修空复情。\n维扬李君供奉俦，汪沦高雅来同游。\n晓泛沧浪寻白社，暮携羽扇仍丹邱。\n嗟嗟盛事轻千里，吴下机云非我拟。\n未论丹砂变紫荷，且向梅花操绿绮。\n雕盘翠釜愧仙厨，满地凉云荫碧虚。\n酒阑我欲骖鸾去，兴至随君驾鹿车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14369,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游浮邱呈赵太史","author":"黎民怀","text":"丝纶池上凤毛稀，漫向朱明启石扉。\n雾隐瑶台仙掌接，风传珠树紫鸾飞。\n青尊萧瑟迎秋气，彩笔凭陵对落晖。\n莫道周南留滞久，受釐今已忆皇闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14370,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒张丞相祠","author":"黎民怀","text":"季冬风日凄，于役溯燕阙。\n旧疆遵五岭，雄图肇百越。\n还顾天井隅，回互秦山别。\n关门凝紫烟，陇梅欺芳雪。\n翼翼曲江祠，羹墙访遗哲。\n岂伊宏词选，风度自殊绝。\n再陟承明庐，文武见彰设。\n洋洋白羽挥，煌煌金鉴晢。\n拜相启江南，凿岭神功揭。\n唐历弥千祀，高名齐稷契。\n茫茫抚鸿舆，地灵由人杰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14371,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游南华寺","author":"黎民怀","text":"閒从海上游，挂席遵韶石。\n星驿郁夫容，应有弥须迹。\n炉峰耸秀异，龙门湛空碧。\n中天据南华，四境若完璧。\n灵感宝林谶，名重开元额。\n祥云澹不飞，古桧何翼翼。\n象教亘千龄，传灯惟一夕。\n不饮曹溪水，世尘无由释。\n不悟明镜台，本来那可译。\n师言不二门，至乘无千百。\n冥濛恣敖游，舍筏惟所适。\n悠悠此溪流，天地无与易。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14372,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游罗浮山","author":"黎民怀","text":"积思久滞淫，兴言恣攀陟。\n奇峰亘四百，面面俱可识。\n上有飞云峰，远接扶桑色。\n迤逦瑶台石，烟霞随杖舄。\n群仙宁尽纪，丹灶犹可觅。\n家由葛令移，松是秦时植。\n仰首接飞鸢，摩崖多籀刻。\n朱草希黄落，仙禽无倦翼。\n步入梅花村，美酿分玄碧。\n可以醉游人，若为驱肉食。\n小隐吾敢捐，漫向高山忆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14373,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王忠铭先生游罗浮","author":"黎民怀","text":"勋华八座动辉光，玉节忻逢郁水傍。\n万里怀归桑梓切，廿年供奉鬓毛苍。\n海门日出浮仙岛，天半云飞隐帝乡。\n遮莫梅花缓幽酌，玺书今下五云长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14374,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金鸡岭","author":"黎民怀","text":"五更金鸡唱，声声彻翠微。\n暤熙逢舜日，遥向凤楼飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14375,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马鞍冈","author":"黎民怀","text":"层空蟠碧翠，佳丽伫雕鞍。\n夙聘黄金勒，风云冀北看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14376,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丽句亭作","author":"黎民怀","text":"春色载阳，清泉汤汤。\n匪绍来游，插羽于襄。\n歌言依咏，筐篚于将。\n匪曰纡馀，大雅聿昌。\n流泉在左，诛茆在右。\n隐衷何逖，懿踪惟旧。\n篁竹其苞，华实其茂。\n云虹具苍，金石迭奏。\n昔日太和，凤鸟于飞。\n郁郁其址，淑人是依。\n嗣日建安，白雪于霏。\n湜湜其源，雄词爰归。\n匪予小子，念日先民。\n游于西园，亦暮之春。\n我车既安，我马既駪。\n千万斯年，维德之邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14377,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"听雪","author":"黎民怀","text":"荏苒岁云暮，摇落秦城阴。\n遥天亘玄色，瓦屋飞琼音。\n稍薄庭下树，微动风中琴。\n篝灯美良夜，寤言拥绨襟。\n一齧有馀滋，僵卧徒所歆。\n蟪蛄罢秋响，寒螀符我吟。\n岂谓四序周，而多炎景侵。\n缅彼凤池客，芳咏劳华簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14378,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄谭永明","author":"黎民怀","text":"志士无穷达，所尚植其节。\n譬彼松柏枝，岁与繁华别。\n吾友本布衣，而膺素丝哲。\n两疏不见投，志摧肝胆裂。\n瑟瑟齐台风，皎皎燕地雪。\n掩关向蓬蒿，玄言相与析。\n舍尔献璧怀，慰此纫兰洁。\n全生天地宽，寄迹烟霞结。\n岂若六国豪，功名凭寸舌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14379,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观鱼","author":"黎民怀","text":"忆从辞京都，樊笼滞城市。\n偶与海人期，遵彼清江址。\n凫鹭寂不惊，鲂鳞逐波起。\n泳陶何离蓰，溉鬵亦徒尔。\n虽鲜桐庐贤，因證蒙庄理。\n美人眷日夕，茫茫隔江水。\n尘襟渺然涤，纶巾醉应滓。\n人生贵所适，何必溱与洧。\n迟回荡轻舟，五湖从此始。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14380,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落梅","author":"黎民怀","text":"清夜彻山扉，春风捲客衣。\n影随鸾镜转，香逐蝶魂飞。\n和歌何袅袅，结绪更依依。\n遮莫传羌塞，征人不易归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14381,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日与林开先侄贤之铭之登高","author":"黎民怀","text":"凭高一舒啸，尊酒白衣来。\n天地秋何处，茱萸晚故开。\n老深庾亮兴，君亦孟嘉才。\n任此陶然去，西风起霸台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14382,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别弟惟节北上","author":"黎民怀","text":"曾于艺苑著雄文，岂为吹嘘入五云。\n老去宦情应识我，时来剑气独怜君。\n花开客舍尊堪把，草绿池塘梦又分。\n自昔黄金招骏骨，音书南雁好相闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14383,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"欧使君雨莲以诗见寄次韵奉答","author":"黎民怀","text":"五马龙蒸蚤著声，漫劳沧海讯鸥盟。\n传来陇使春如见，梦里王孙草自生。\n至日吹葭堪对酒，暮云残角倍含情。\n共嗟桂树千丛发，不减燕山窦氏名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠方元素次汪司马韵","author":"黎民怀","text":"跌宕还高猛士风，黄金不惜客途穷。\n朅来饮马长城窟，忽漫寻仙大海东。\n南武衣冠馀涕泪，苍梧风雨转空濛。\n为谈殊锡嗟司马，功在麟台石画中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林山人还闽","author":"黎民怀","text":"海上丹砂不易逢，如君微尚几能同。\n他乡对酒兵戈里，故国移居感慨中。\n远浦帆樯开雨雪，高楼词赋倚春风。\n罗浮亦有金银宅，迟尔重来访葛洪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"始至金陵承姚佘二侍御过访","author":"黎民怀","text":"龙虎纡回王气中，千秋阊阖锁玲珑。\n山河影射王侯宅，松桧香飘御史骢。\n竹径幸无题凤侣，兰台还倚搏雕雄。\n晚来云雾沧洲隔，搔首长空思不穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"霜夜拙清楼闻笛","author":"黎民怀","text":"暮倚高楼待月生，陇头湘水共凄清。\n风前响逐流云驻，帘外霜兼乱叶鸣。\n折柳梦中惊绝塞，哀鸿天外度孤城。\n庾公正有登临兴，不似山阳转动情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游琪林观","author":"黎民怀","text":"拥褐青山岁月赊，讵知城阙隐仙家。\n千年珠树归黄鹤，一径桃花落紫霞。\n龙虎尚传茅氏诀，乾坤惟有羡门砂。\n踟躇白首玄心在，拟泛银河八月槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太平寺","author":"黎民怀","text":"偶来双树下，依止远公房。\n薝卜飘香气，娑罗露月光。\n禅机随去住，心地得清凉。\n欲證无生理，玄言亦暂忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝曲江舟中见峰腰繁花历乱曰映山红者赋以纪兴 其一","author":"黎民怀","text":"嫩绿嫣红拂雾开，乱峰高下绣莓苔。\n何当徙尔长杨去，潦倒君王万寿杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝曲江舟中见峰腰繁花历乱曰映山红者赋以纪兴 其二","author":"黎民怀","text":"二月江中花事多，寻春剩有鸟来过。\n那能一借东风力，吹尽千红伴绮罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙弈石鉴","author":"黎民怀","text":"石楼巀嵲临沧海，岩前霞石何磊磊。\n削成棋局方且平，□位中分成两垒。\n白发参错罗星文，藤萝掩覆蒸风云。\n蛇鸟尚惊鱼复阵，犀象无乃昆阳军。\n空山犹闻下子响，霹雳一声愁魍魉。\n林越萧萧霜倒飞，万壑千崖气森爽。\n鸾旌孔盖望不来，樵斧剥蚀馀苍苔。\n亡羊歧路竟何事，龙争麟斗俱尘埃。\n菖蒲可采桂可食，且看赤日扶桑隈。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别司封侄伯华","author":"黎民怀","text":"朝发郁水湄，苕荛陟汉京。\n芳树垂清阴，彤云递轻盈。\n嗟哉铨曹贵，先后被宠荣。\n宁忘素丝守，而抱白玉贞。\n忆昔乘骢者，揽辔扬浊清。\n彼美献镜贤，风度悬丹青。\n名寄圣贤籍，怀深岁月征。\n灼灼东日华，光旭含紫清。\n骅骝意何自，徘徊相顾鸣。\n策名际清朝，庆誉由兹升。\n安能盼昭回，炯炯怀合并。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金山别黄水帘二首 其一","author":"黎民怀","text":"高论忽同舟，看君不可留。\n莫辞今夜饮，曾是昔年游。\n细雨蒹葭暮，疏星河汉秋。\n情深聊记别，酩酊渡中流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金山别黄水帘二首 其二","author":"黎民怀","text":"江月来何迟，轻风吹鬓丝。\n不是送君别，安知此地奇。\n客中灯是伴，兴至酒相宜。\n明日东林下，玄言应对谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送秘书家长兄至石门山归舟口号二首 其一","author":"黎民怀","text":"江风何太恶，病骨苦相侵。\n去水分歧路，还舟即旧林。\n寒城橘柚熟，霜岸鹡鸰吟。\n物色今如此，偏悬北望心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送秘书家长兄至石门山归舟口号二首 其二","author":"黎民怀","text":"飞篷迅于箭，触浪响如雷。\n风烟不可住，归梦空悠哉。\n慌然赤城去，暂向郁州来。\n喜有梁鸿在，秋风次第栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄欧崙山虞部兼订校司封先兄集","author":"黎民怀","text":"洛水东归日，荒村慰卜居。\n第令题似凤，不为食无鱼。\n高枕火云出，清尊河朔虚。\n自惭牛马走，还拟订藏书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五柳先生咏","author":"黎民怀","text":"栖栖晋处士，岂是学逃名。\n跌宕空千载，饥寒洵此生。\n柳条春自见，诗法晚逾清。\n易卜盈虚理，沧浪今濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨溪洞","author":"黎民怀","text":"披榛凌石磴，一造羽人居。\n星乱围棋后，虹飞解剑馀。\n藤花风外落，槲叶雨中疏。\n归路逢王烈，应迷鸟篆书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"扶胥浴日","author":"黎民怀","text":"津连黄木湾，虚亭翠霭间。\n川光摇子夜，坐见海中山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白云晚望","author":"黎民怀","text":"仙山多白云，渺与天汉接。\n何当持赠人，秋风同一叶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蒲涧帘泉","author":"黎民怀","text":"涧道泻飞流，鸾声最上头。\n谁持九节去，潇洒石林秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大通烟雨","author":"黎民怀","text":"日永祇林幽，江空自生碧。\n谁能载酒游，烟云随挂席。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过惶恐滩和古诗一绝","author":"苏旦","text":"出住非关为利名，乾坤何地不怡情。\n笑他底事称惶恐，转觉安流自在行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题石龟塘大岩","author":"陈璘","text":"万历四年天洞开，从前未见一人来。\n我今欲借神仙窟，浪学尧夫日打乖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题魁岩","author":"陈璘","text":"魁星岩面蓬莱境，宰相人间好读书。\n二十年前戎马地，今看高步玉堂居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵李舜臣 其一","author":"陈璘","text":"堂堂又赳赳，微子国应危。\n诸葛七擒日，陈平六出时。\n威风万里振，勋业四维知。\n嗟我还无用，指挥且莫辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵李舜臣 其二","author":"陈璘","text":"不有将军在，谁扶国势危。\n逆胡驱晨日，妖气卷今时。\n大节千人仰，高名万国知。\n圣皇求如切，招去岂终辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]