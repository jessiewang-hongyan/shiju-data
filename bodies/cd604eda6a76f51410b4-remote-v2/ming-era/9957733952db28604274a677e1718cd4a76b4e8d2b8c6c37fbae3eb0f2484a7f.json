[{"title":"初秋","author":"苏葵","text":"夜深凉影动星枌，赤帝回銮已策勋。\n一叶井梧刚始落，四时花雨对停分。\n金风爽拂旌阳剑，银汉清煎织女裙。\n明日泬寥天九万，大鹏何处薄层云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆归四首 其一","author":"苏葵","text":"闲忆锄园种荔枝，望乡台上此心驰。\n人生贵在得乐耳，老去荣来安用之。\n蒲涧高僧书札杳，海珠疏雨钓竿迟。\n飘然欲买江边棹，卖赋无金探俸资。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆归四首 其二","author":"苏葵","text":"仕路何时是惬心，腰间赢得滥横金。\n名于廊庙元无分，乐在田园正合寻。\n闲课子孙耕读计，醉招鸥鹭盍朋簪。\n兴来次第嘲花鸟，不学杨雄作酒箴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆归四首 其三","author":"苏葵","text":"到处鱼羹饭有无，暮年何必苦贪图。\n人间白日排羁客，江上青山爱腐儒。\n沙蟹剥螯充骨董，海螺蘸甲泛屠苏。\n凭君细看蜗牛角，只为升高就壁枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆归四首 其四","author":"苏葵","text":"今年觉比去年衰，何事言归不果归。\n忧世漫歌天下乐，感怀常鼓雉朝飞。\n松花有待时供酒，荷叶深惭未制衣。\n莫道饔飧无负郭，有人曾采首阳薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弘治十八年七月七日听宣大行皇帝遗诏感恸有作","author":"苏葵","text":"日落风悲涕泪流，谅阴元老要伊周。\n远臣敢替终天恨，嫠妇犹怀昔日忧。\n西序忽闻陈大训，内庭谁始献嘉谋。\n祖宗典则森然在，唐宋区区莫效尤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙丑七月二十有五日北楼观兵有作","author":"苏葵","text":"独坐高楼辟四窗，俯看旌旆尽飞扬。\n将军似虎生风勇，士卒如山压卵强。\n閒暇养成堪敌忾，太平修武是堤防。\n白头也有安边策，宝剑无缘赐上方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄毕汝舟编修毕予督学日雅旧也","author":"苏葵","text":"别来荏苒十年馀，两接京华太史书。\n故旧不遗真羡子，文章无补尚惭予。\n粗官冷笑淹巴蜀，芳誉新闻蔼石渠。\n珍重久要如有念，冯唐双鬓已萧疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜雨后乍凉","author":"苏葵","text":"烈烈炎威半饷消，洗天须用泻天瓢。\n万方尽享康侯乐，六幕俄除酷吏妖。\n当午不烦勤羽扇，广堂何羡得鲛绡。\n阴阳默有乘除数，此日凭谁妙燮调。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感事漫书","author":"苏葵","text":"纷纷上客半焦头，何事渔翁守直钩。\n旗鼓尽归蜗角氏，皮毛须信棘端猴。\n惊闻古有嗟来食，少见人从得处忧。\n若悟浮生如一梦，三公争换醉乡侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄娄元善正郎娄江西上饶人时家居修鹅湖书院予在江西日曾请为白鹿书院山长二首 其一","author":"苏葵","text":"先生风致古英豪，枕流漱石烹溪毛。\n汪汪学海人宏道，滚滚词源仆命骚。\n汉最足称徐孺子，禹无能屈伯成高。\n匡庐旧雨三更话，万里青天漫郁陶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄娄元善正郎娄江西上饶人时家居修鹅湖书院予在江西日曾请为白鹿书院山长二首 其二","author":"苏葵","text":"得归不归公笑谁，巴西羁客鬓毛衰。\n文章谫谫曾何补，原委深深竟未窥。\n五万买鞭缘外饰，再三求筮为中疑。\n行藏地僻无龟鉴，长忆庐山剪烛时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴二首 其一","author":"苏葵","text":"浮云漠漠蔼苍冥，风劲郊原草木零。\n苜蓿影寒千里瘦，梧桐枝老九苞鸣。\n酒杯潋滟供秋兴，旅馆萧条触物情。\n自古五侯嫌肮脏，误将多智薄君卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴二首 其二","author":"苏葵","text":"鹰隼高飞寥廓空，微霜寒入菊花丛。\n耽酣量浅援陶止，欲赋才疏怯庾工。\n闲傍阶前听蟋蟀，更从江上赏芙蓉。\n尘襟旋借西风拂，清洁谁能效两龚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄示毅儿","author":"苏葵","text":"诗礼遗芳愧孔庭，一缄封罢更叮咛。\n读书要与古人等，治产须教世业兴。\n穷达固应生禀定，智能还自敏求成。\n吾儿填勿甘豚犬，聊慰而翁舐犊情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴","author":"苏葵","text":"闲名闲利不须贪，消得荣枯是一酣。\n幸际明时宽酒禁，更偷闲处纵清谈。\n花枝淡淡晴还雨，萍梗飘飘北又南。\n瓮茧欲成身已老，定谁先事鉴春蚕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙丑春日思郊野之游不遂戏书","author":"苏葵","text":"远近郊原烟雨收，无边光景触吟眸。\n欲扶苍玉出城去，更散黄金买酒游。\n天气大都春半好，物华多在郭南优。\n锦城一掌未曾遍，况问瑶池与十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"延景花","author":"苏葵","text":"百卉萧条正恼人，却延风景弄精神。\n灵根应用胭脂染，娇态偏成雨露新。\n造化不雕元自巧，盎盆虽小有馀春。\n从教芍药能红白，领得春风已后尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游昭觉寺归途偶成三首 其一","author":"苏葵","text":"万个琅玕一径幽，禅房清绝四时秋。\n聊从石上三生话，偶作尘中半日游。\n不计赢输棋信手，拚教酩酊酒添筹。\n肩舆兀兀归来晚，稚子拦街笑醉侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游昭觉寺归途偶成三首 其二","author":"苏葵","text":"偶过山寺访支公，千树松涛落午舂。\n露草未凋沿涧碧，霜枫新染隔林红。\n香烟袅袅来翔鹤，钵水清清隐伏龙。\n诗兴有馀尊酒尽，强挥归袂入城中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游昭觉寺归途偶成三首 其三","author":"苏葵","text":"寻僧十里出郊垌，才到招提便觉清。\n露竹受风迎客舞，山花经雨向人明。\n大瓢吸酒嶙峋兴，小院敲棋剥啄声。\n天际轻阴非日暮，从容更了乐游情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题","author":"苏葵","text":"闾须容不笑无盐，谁厌双娥八字纤。\n花凭绿窗春寂寂，月侵琪树夜厌厌。\n鸳鸯有恨停针线，嬉子无徵挂屋檐。\n缟袂青裙照溪水，画眉明日效于潜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登嘉定儒学后山先天阁阁为黄冠所据自国初至今知州瞿刚乃取而归之儒学遂易今扁","author":"苏葵","text":"朱檐矗矗耸山巅，一目全收万里天。\n观物可探康节学，凭虚谁悟子云玄。\n春深坛杏当窗看，夜半仙藜隔座然。\n佳胜陆沈馀百载，只今才见集英贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登八角亭亭在州学后山半","author":"苏葵","text":"凿石诛茅费几工，无边佳胜入亭中。\n先天次第罗诸卦，造化寻常散八风。\n近起草烟拖翡翠，远来山雨洗芙蓉。\n太元莫笑前闻拙，后学今谁解逼雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉定泛舟南下马尾滩恶既过赋此","author":"苏葵","text":"学仙曾未列仙班，犹在尘埃扰扰间。\n满路旌麾偏骇鹤，片时尊俎偶看山。\n一江衿带连诸郡，万石巉岩折几湾。\n湍险是谁忘怖慑，中流惟我觉安閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送犹子兆麟东还","author":"苏葵","text":"二月川江江水平，阿咸东下鹢舟轻。\n囊无宦路苞苴浊，心醉名邦胜概清。\n骨肉一门惟见汝，江山万里若为情。\n到家倘有亲知问，应说还惭赵抃名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄致政州守梁叔龙亲家","author":"苏葵","text":"挂冠掉臂归山林，市朝日远山日深。\n但知黄菊迸篱馥，遮莫甘棠匝地阴。\n要客自烧烹石鼎，引孙时屈钓鱼针。\n等閒莫用轻相笑，已约梅花旧水浔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄余宗善表弟义官","author":"苏葵","text":"石门寺前分袂时，贪泉曾感赠行诗。\n西来自把三江照，老去惟凭一鹤知。\n每厌朱轮妨梦觉，细看白发卜归期。\n明朝烟雨竹竿袅，共钓君家十亩池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄德言何亲家致政转运","author":"苏葵","text":"别君荏苒岁频迁，旧约持竿愧食言。\n高致定应于我笑，浮名犹自被渠牵。\n时添白发何妨老，身谢红尘便是仙。\n料得江村无个事，养恬多引抱孙年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄万松邵妹丈","author":"苏葵","text":"林泉风致今如何，湖海游人两鬓皤。\n未有了期炊黍梦，最无干计紫芝歌。\n朱陈乡在归心杳，王谢堂深别恨多。\n曾荷四知旧箴儆，白头宦况自砻磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄从兄月江先生致政司训","author":"苏葵","text":"同在风尘先息机，皋比丢却理荷衣。\n风高彭泽知公逸，梦久邯郸愧我非。\n漠漠水田香稻熟，清清池馆落花飞。\n家传真一须多酿，留待游人十月归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答林宗敬致政别驾","author":"苏葵","text":"五羊城下引长年，虽不骑羊亦是仙。\n明月楼台庄子梦，落花风雨少陵篇。\n甘棠旧植从渠诵，黄菊新栽却自怜。\n料得等閒开口笑，笑人甘羡二疏贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和罗方伯游静居寺韵","author":"苏葵","text":"十里山光接少城，终朝游兴为山清。\n心随野鹤怜垂翅，吟对幽花且放情。\n大斗酌残真一酒，新词歌到喜迁莺。\n旁人莫道无仙骨，紫府丹台旧有名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题浣花草堂二首 其一","author":"苏葵","text":"浣花溪水绿于苔，诗老祠堂近水开。\n闲把祢衡徵往事，始知严武解怜才。\n春风树老莺仍坐，夏日梁空燕尚来。\n阅遍遗诗深感慨，夕阳庭院自徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题浣花草堂二首 其二","author":"苏葵","text":"西郊十里路延袤，天放尘中剩浣花。\n几树杉松邻野寺，一溪烟雨隔人家。\n干戈避地江湖远，羁旅遗踪岁月赊。\n莫道有心人不识，万篇忠荩是声华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"锦州较士阅卷漫成","author":"苏葵","text":"白头灯火尚砻磨，老秤无星却易讹。\n漫笑冷毡难脱换，不知驽马惯蹉跎。\n芳尊久负青山约，清世何须白石歌。\n不是马周原是我，敢言当路少常何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过梓潼七曲文昌祠","author":"苏葵","text":"七曲青山百尺楼，十围松柏荫庭幽。\n道旁鸟散书台晓，天下人祈桂籍秋。\n剑阁路回岚气合，文昌星耿夜光流。\n二千年后乾坤老，还有灵通在上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"歇剑州武莲寺","author":"苏葵","text":"剑阁西头般若开，乱峰如画拥禅台。\n幡摇落日无鸦过，门掩寒天有客来。\n煮茗斋厨通活水，烧香炉火热残灰。\n山僧也解谈今古，漫笑姜维不是才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题宋学士祠二首 其一","author":"苏葵","text":"翊运人豪岂偶然，六经仁义继前贤。\n君恩如晦登瀛日，身事昌黎过岭年。\n七尺佳城真郁郁，千秋祠宇自绵绵。\n庐山亦与舂陵隔，莫限龙门万里天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题宋学士祠二首 其二","author":"苏葵","text":"际会龙飞道正亨，白头歧路却西行。\n赐环有待公先逝，理玉无归数已平。\n华表秋风仙鹤泪，祠堂春树杜鹃鸣。\n儒臣自古堪枚举，当代谁教血食荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄杨学士介夫先生","author":"苏葵","text":"五见飞花卸杏枝，星轺州郡漫驱驰。\n未宏大道酬清世，敢把虚声托故知。\n玉笋班前那复梦，铁桥坡外欲寻诗。\n如今纵有孙阳在，争奈庸驽借旧时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立儿扶其母榇还乡作此以示四首 其一","author":"苏葵","text":"汝扶慈衬自西归，门键嗟予不敢违。\n董永只今称至孝，嗣宗千古笑全非。\n三千曲礼书仍在，二十成人行要徽。\n无限义方言不尽，自须磨砺自撑持。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立儿扶其母榇还乡作此以示四首 其二","author":"苏葵","text":"舟行三月本平流，送汝宁忘在道忧。\n寒暑要知衣厚薄，登临休为酒淹留。\n慢藏莫恃行囊薄，宿泊须寻口岸优。\n幸有惠连堪倚仗，晨昏行止细筹谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立儿扶其母榇还乡作此以示四首 其三","author":"苏葵","text":"曾闻杜老诮渊明，白首如今未脱情。\n舐犊有私偏缱绻，斗鸡无补屡丁宁。\n经书卷卷皆存诲，田业些些仅养生。\n鉴戒不须求远事，乡闾成败足堪惩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立儿扶其母榇还乡作此以示四首 其四","author":"苏葵","text":"谁为儿孙积俸金，作官偏费老年心。\n好看司马传家训，更究杨雄远酒箴。\n见恶探汤应自罕，读书如渴易成深。\n到家不忘趋庭语，鞭辟应须向上寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟行值雨停泊沙岸偶成","author":"苏葵","text":"江雨霏霏江水生，东行彩鹢雨中停。\n典衣取酒无人受，拥被寻诗欠客评。\n山色凄迷遥入画，渔歌欸乃近堪听。\n无端野趣因渠减，津吏纷纷报远迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙丑春暂视臬篆公暇漫成","author":"苏葵","text":"嫩绿成堆树影重，公庭天迥日融融。\n简孚暂折桁杨狱，佔毕仍专夏楚功。\n载酒未亲奇字老，寻诗多愧蹇驴翁。\n芸香小阁端溪石，却被红尘两月封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月忠州道中","author":"苏葵","text":"日斜云淡远山低，三月王孙草色萋。\n一叶频繁明月峡，六年流恋浣花溪。\n盐齑有味名还薄，木铎无功道未西。\n何日濯缨江海去，石床藤枕对凫鹥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过梁山蟠龙岭遇雨","author":"苏葵","text":"练石曾无补漏天，鹁鸠啼处雨绵绵。\n寒岩滴沥添新溜，天岳朦胧失旧巅。\n鸟道萦纡芳草外，马蹄淩竞乱云边。\n山灵绝倒知何谓，笑杀行人不自怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿垫江新兴铺风雨骤作","author":"苏葵","text":"山路崎岖两度经，一毡灯火宿长亭。\n萧骚万籁风初起，淅沥三更雨未停。\n门外峰峦森画障，床头星斗隐青萍。\n道人厌作南柯梦，不为荒凉睡不宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中漫兴","author":"苏葵","text":"山趁兰桡管送迎，前山胜似后山青。\n可怜松柏在岩谷，却有藓苔生石屏。\n背客岭云从北去，可人江月未东升。\n羁客落寞凭谁会，聊对岩花泻瓦瓶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予巡自东还过重庆大参吴公饯予舟中既醉日晚别去予舟西行是夜月色如昼江空沙白壶觞对影有怀吴公因作二律 其一","author":"苏葵","text":"小傍凫鹥问画桡，好山当面酒深瓢。\n风流莫讶人豪少，谈笑真知道味饶。\n悠漾晚移云影淡，清泠东去水声遥。\n黄昏别后银蟾起，人隔重城不可招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予巡自东还过重庆大参吴公饯予舟中既醉日晚别去予舟西行是夜月色如昼江空沙白壶觞对影有怀吴公因作二律 其二","author":"苏葵","text":"壶觞未尽日衔山，一棹西驰一棹还。\n云水可人能久憩，鹭鸥疑客是偷閒。\n气吞牛渚千秋下，风夺仙舟半日间。\n纵有鱼翁畏争席，空教明月满前湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"合州河即事","author":"苏葵","text":"日暖晴云覆水涯，画桡行处少人家。\n鹿麛有伴眠芳草，蛱蝶无情弃落花。\n山好自深浮蚁斝，水回多隐钓鱼艖。\n老夫要与渔郎语，分付黄头鼓莫挝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙寅端阳日对酒写怀二首 其一","author":"苏葵","text":"天涯人值天中节，独泛菖花酒旋添。\n龙舫尽仍前日竞，鹗羹惟许近臣沾。\n闲看羸豕愁阴长，静絷腾驹觉日炎。\n五十七回如梦过，不应憔悴到苍髯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙寅端阳日对酒写怀二首 其二","author":"苏葵","text":"六阳尽处端阳到，无限闲愁付太虚。\n祈谷未闻雩百辟，竞凫谁果吊三闾。\n博劳傍树声偏聒，苋陆当阶叶渐舒。\n不为菖花才满酌，客怀萧索正凭渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕","author":"苏葵","text":"五更魂梦隔年情，云雾绡衣织渐成。\n离恨未消榆荚老，佳期元在鹊桥横。\n河边有信鸾先度，海底无缘日缓行。\n赖是人间尽新巧，不劳分送下云城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄义宰乙斋赵亲家","author":"苏葵","text":"兰桂花开香满庭，玉盘传脍泻银瓶。\n月低岩岫吟边见，雨过楼台醉后听。\n无事弄孙消永日，有丹要客论仙经。\n香山社里须相候，已厌浮名水上萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和陈宪长先生来韵","author":"苏葵","text":"初秋炎暑未全消，暂歇蚕丛按部轺。\n晓望正怜鸾避鹘，夜眠偏怪鼠欺猫。\n吾心皎月涵清沼，世事浮云度碧寥。\n成败本来同局面，冷看惟有烂柯樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读史至苏武归国感而有作","author":"苏葵","text":"毡城秋早雪漫漫，十九年中节未残。\n信有乳羝归国易，莫云飞雁带书难。\n河梁别泪谁先落，麟阁完名自不刊。\n可恨旧衔天命在，茂陵深闭雨声寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日闲中戏呈杨志道长官","author":"苏葵","text":"竹影移阴过院迟，日长人困漫支颐。\n寒蝉抱叶初偏聒，社燕穿帘惯又辞。\n无奈兴亡嫌读史，拙于美剌懒寻诗。\n不知谁解如黄绮，须就高山一局棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游白鹿洞和沈文进寅长韵","author":"苏葵","text":"佳胜元从少小闻，始来庭下叩英芬。\n寒岩怪石漱流水，翠柏苍松栖乱云。\n我马谅非求捷径，山灵休更事移文。\n怀贤吊古诗嫌坉，欲藉名家一运斤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]