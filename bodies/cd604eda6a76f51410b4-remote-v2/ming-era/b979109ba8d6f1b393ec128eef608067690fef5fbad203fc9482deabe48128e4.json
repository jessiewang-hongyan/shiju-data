[{"title":"雨中和清溪","author":"何景明","text":"濛雨萧条至，悲风日暮多。\n积阴生径草，永夜落庭柯。\n宅愧高人隐，门劳长者过。\n白鸥如有意，相逐下烟波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清溪草堂 其一","author":"何景明","text":"草阁临溪上，幽期孰与论。\n白沙连曲岸，秋水到閒门。\n槛外常垂钓，舟中数举樽。\n风情有如此，不异浣花村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清溪草堂 其二","author":"何景明","text":"夜夜闻清濑，朝朝见碧浔。\n百年应有寄，终日自长吟。\n宿桨依沙树，开窗散渚禽。\n生涯众人事，不独爱幽深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清溪草堂 其三","author":"何景明","text":"隐者常稀阔，幽居独羡君。\n汀洲起渔唱，篱落傍鸥群。\n水接吴门树，窗生禹洞云。\n更传诗句好，还似沈休文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清溪草堂 其四","author":"何景明","text":"太湖湖上地，闻占好园池。\n有业堪投老，无官可避时。\n渡传桃叶咏，门听竹枝词。\n何日山阴棹，溪堂见戴逵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀高铁溪先生四首 其一","author":"何景明","text":"积雨空林畔，庭除烟雾昏。\n佳人不我至，樽酒向谁论。\n野树斜连屋，秋山遥对门。\n何时孤兴发，骑马到荒村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀高铁溪先生四首 其二","author":"何景明","text":"吾慕高夔府，风流汉长卿。\n新诗裁锦字，丽赋掷金声。\n早谢人间事，幽通物外情。\n相违动旬月，何日见黄生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀高铁溪先生四首 其三","author":"何景明","text":"磊落真邦彦，襟期亦我师。\n右丞元好画，谢传未忘棋。\n花鸟留新兴，云山待妙词。\n小堂能枉驾，一为细论诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀高铁溪先生四首 其四","author":"何景明","text":"僻居临水次，竹树稍深幽。\n对景非无酒，登高亦有楼。\n好风吹永夜，片月度清秋。\n不见孤舟至，令人忆子猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月丁日","author":"何景明","text":"孔庭严祀典，冠冕萃吾乡。\n霄汉回清乐，星辰入画裳。\n万年仍俎豆，千仞自宫墙。\n此日斯文地，瞻依病未忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度","author":"何景明","text":"此日逢初度，悲怀却自宽。\n久为京洛客，初乞茂陵官。\n堂上慈颜喜，灯前稚子欢。\n一杯承膝下，愿得岁相看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阴","author":"何景明","text":"惨澹长阴合，苍茫四望同。\n地秋还易雨，树晚故多风。\n楼阁山寒里，衣裳水气中。\n农家务收穫，早为豁层空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吾州","author":"何景明","text":"辽邈吾州地，名从申伯来。\n通淮一水下，入楚万峰开。\n旧国无遗庙，寒城有废台。\n秋郊独临眺，怀古意悲哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北望","author":"何景明","text":"北望风尘里，遥思日月边。\n山河临地极，楼观倚星躔。\n翠羽开诸国，金瓯至万年。\n自从归病后，常梦五云前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠张合之秀才二首 其一","author":"何景明","text":"张子元奇士，携书过我林。\n激昂高论气，落魄远游心。\n一饭山家晚，孤灯夜雨深。\n城边有岐路，送尔独长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":146,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠张合之秀才二首 其二","author":"何景明","text":"匹马何时出，还家此日心。\n卞生怀楚璧，郭隗待燕金。\n雄剑青云志，哀弦白雪吟。\n功名少年在，不必泪沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雷","author":"何景明","text":"不见苍山破，虚闻巨壑驰。\n烈声回地底，馀响落天涯。\n魍魉何由避，蛟龙得自随。\n中宵沛云雨，威泽正当时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月二首 其一","author":"何景明","text":"宛宛秋山月，今宵尚未圆。\n光生万里外，影对一樽前。\n城静虚弓倚，楼高破镜悬。\n草堂风露下，终夜不成眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月二首 其二","author":"何景明","text":"片月中秋近，辉光一岁无。\n天清惊塞雁，夜冷落枫乌。\n不寐知宵永，无言对影孤。\n更深何处没，万里堕江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三关","author":"何景明","text":"楚塞三关隘，云峰入望重。\n何年戎马地，空有昔人踪。\n积水沉秋堞，长烟带古烽。\n乾坤当失据，饕餮任群凶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月","author":"何景明","text":"九月清霜下，中林蕙草寒。\n暮霞多变态，秋色不宜看。\n丘壑容吾拙，乾坤敢自安。\n古来俱涕泪，况复岁华残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"樊秀才园内菊","author":"何景明","text":"樊生园内菊，相对小塘西。\n露蕊凄凄放，风枝袅袅低。\n栽依石竹下，发与畹兰齐。\n明日重阳酒，殷勤为尔携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同马君卿任宏器登高四首 其二","author":"何景明","text":"远地宜登望，秋光薄暮浓。\n楼高窥万井，潭迥落千峰。\n花为重阳发，人怀百岁逢。\n同游俱俊彦，尊酒得从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同马君卿任宏器登高四首 其三","author":"何景明","text":"病思逢佳节，孤怀忆远游。\n河山还似昔，烟树不胜秋。\n故国浮云去，高台日暮愁。\n牛山元有恨，休讶泪长流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同马君卿任宏器登高四首 其四","author":"何景明","text":"向夕枫林爽，行吟未拟回。\n明霞积水外，落日古城隈。\n鼓角秋深怨，风霜岁晚催。\n莫将迟暮意，孤负菊花杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登钓台","author":"何景明","text":"野阔穷秋出，云寒望未开。\n万峰遥驻马，残日更登台。\n水落龙蛇蛰，沙空雁鹜来。\n孤怀对摇落，吟罢有馀哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孟冬","author":"何景明","text":"孟冬严气至，坐见物华微。\n古树犹秋色，寒山半夕晖。\n江湖深欲冻，鸿雁各知归。\n羸病便深卧，从兹日掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄孙世其举人","author":"何景明","text":"得意西风里，宾筵听鹿鸣。\n此生看事业，今日重科名。\n锦树连江路，秋花照楚城。\n北来休太晚，慰我隔年情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除架","author":"何景明","text":"苦叶萧疏久，秋匏亦委沙。\n家人空抱蔓，山鸟莫啼花。\n零落亲寒事，蹉跎感物华。\n衰荣转相代，何必恨生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十月","author":"何景明","text":"十月苍山静，孤村带郭长。\n卜居怜此地，高枕复吾乡。\n野雾沉寒日，城阴迟早霜。\n一年看欲暮，酒熟共谁将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀孟望之","author":"何景明","text":"消息三秋隔，虚瞻鸿雁群。\n长安望不极，落日起浮云。\n奉使何时出，吟诗谁共闻。\n岂知离索久，病思日纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒","author":"何景明","text":"水郭逢寒早，城阴惨澹中。\n远山常雾雨，衰柳更天风。\n病骨思狐貉，愁颜付酒筒。\n关河待冰雪，何处有途穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"残菊","author":"何景明","text":"寒丛后摇落，冬至亦蹉跎。\n病叶强相守，孤英无奈何。\n园篱空自爱，霜霰暮还多。\n幸有馀香在，深杯为尔歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韩席二佥宪见过留饮","author":"何景明","text":"野外惭供给，台端枉驾来。\n河鱼还自取，樽酒为君开。\n落木寒风急，孤城暮雨催。\n相逢孟冬节，翘首待阳回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晴","author":"何景明","text":"冬郊零雨霁，烟郭望初分。\n独树馀寒照，平沙足晚云。\n风鸢高不下，野鹤迥难群。\n夕坐亲杯酒，长歌还自闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪柬沈马任三子","author":"何景明","text":"黯黯山云起，茅斋傍水涯。\n一冬才见雪，十月已开花。\n雾袅寒城霰，风吹野岸沙。\n同游词赋客，骑马入谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜望之至以诗迎之","author":"何景明","text":"经岁青山下，空吟求友诗。\n故人天上至，慰我病中思。\n腊近冰霜苦，春回草木知。\n小堂终日待，枉驾莫教迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再别清溪子","author":"何景明","text":"冬馆萧条别，开樽为尔吟。\n岸梅催客鬓，江柳送归心。\n南国浮云暮，孤城积霰阴。\n逢春湖雁起，休滞北来音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得钱水部书","author":"何景明","text":"故人俱落魄，水部近何如。\n河上三年别，天涯十月书。\n烟波愁望里，风雨梦魂馀。\n更枉怀人作，长吟泪满裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀沈子","author":"何景明","text":"沈生南国去，别我独悽然。\n落月清江树，归人何处船。\n十年安陆舍，数口太湖田。\n想到乡园日，生涯亦可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别望之","author":"何景明","text":"相送不得远，临水一悲歌。\n行云暮不止，游子意如何。\n楚塞风烟迥，燕关雨雪多。\n春还问消息，尺素莫蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洪法寺别锦夫邃伯","author":"何景明","text":"古寺垂杨里，楼台照落晖。\n重来旧游地，却与故人违。\n云树千山暗，风花三月飞。\n未将湖海泪，空洒路傍衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄孙世其","author":"何景明","text":"世路渺难定，相期未有涯。\n昔为燕地客，常到楚人家。\n系马中堂树，听莺上苑花。\n故园看北斗，肠断忆京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬葛时秀","author":"何景明","text":"罢归翻自喜，旧业有青山。\n积雨稀来客，孤云独往还。\n良朋枉高倡，抚卷一开颜。\n何日还乘兴，题诗到竹间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀叶时华","author":"何景明","text":"佳人湖上住，亭榭迥堪怜。\n手把青荷叶，行吟绿水边。\n客皆莲社友，人是竹林贤。\n欲系空庭马，闻君高树蝉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨夜","author":"何景明","text":"云薄高城上，孤亭郡郭西。\n暗中萤火度，灯下草虫啼。\n零落同游客，凄凉旧雨题。\n高歌视雄剑，慷慨为谁携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游贤隐寺次马君卿韵","author":"何景明","text":"系马长松下，风烟几日留。\n天高还薄暮，地迥更逢秋。\n孤嶂开僧舍，千峰绕佛楼。\n自能来白社，不用远公求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与孙世其晚坐","author":"何景明","text":"留客江村暮，开尊对浦沙。\n池心上孤月，树杪落残霞。\n地僻唯宜竹，秋高未有花。\n琴书堪晤语，随意宿山家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十四夜","author":"何景明","text":"水际浮云起，孤城日暮阴。\n万山秋叶下，独坐一灯深。\n白露蒹葭落，西风蟋蟀吟。\n关山今夜月，横笛有哀音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中","author":"何景明","text":"一室高原次，遥天起夕风。\n雨来河树外，日沉山雾中。\n凫雁秋沙静，鸡豚委巷通。\n白云望不尽，相对意无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄雷长史","author":"何景明","text":"不见雷夫子，相望岁半馀。\n王门盛宾客，仙府足图书。\n贾傅才谁敌，相如病独居。\n怜君兼吏隐，休忆锦江鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿胡山人家","author":"何景明","text":"骑马侵晨出，看山至日昏。\n鸣鸡千嶂里，高树一家村。\n白石斜通径，清泉直到门。\n秪疑人世外，别自有乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登坚山寺","author":"何景明","text":"西峰插天起，绝顶寺门开。\n云里一僧住，山中无客来。\n落花平讲席，积草遍香台。\n我欲闻清梵，焚香坐不回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄焦太史蕴德","author":"何景明","text":"抱璞声名旧，逢时意气殊。\n麒麟出天厩，騕袅在云衢。\n世史称司马，英词继董孤。\n遥知东观里，终日会文儒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄马君卿进士","author":"何景明","text":"怜君得意日，骑马向春风。\n通籍金门里，分曹画省东。\n宫袍唐进士，陛戟汉郎中。\n辞赋相如妙，声名谁与同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄阮行人","author":"何景明","text":"夫子风流士，高怀近若何。\n张骞能奉使，阮籍自行歌。\n文字留中岳，楼船渡大河。\n梁都看不远，枉驾几时过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张季升给事","author":"何景明","text":"独立当霄汉，清誉在处闻。\n朝趋青琐闼，日侍御垆薰。\n温室千年树，蓬莱五色云。\n同年还愧我，天上早离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄孟望之","author":"何景明","text":"昔在长安日，相看慰别颜。\n君行太行谷，多亦下燕关。\n春去无消息，秋来书未还。\n可怜骨肉梦，常越万重山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄戴仲鹖进士","author":"何景明","text":"戴生久离别，宦况近何如。\n白日閒官舍，青云近帝居。\n明时难自晦，直道未应疏。\n问我生涯事，山中懒著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀李献吉二首 其一","author":"何景明","text":"闻君在罗网，古道正难行。\n无使传消息，凭谁问死生。\n东方元太岁，李白是长庚。\n才大翻流落，安知造物情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀李献吉二首 其二","author":"何景明","text":"冠盖京华地，斯人独可哀。\n神龙在泥淖，朱凤日摧颓。\n世路无知己，乾坤孰爱才。\n梁园别业在，何日见归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同诸友登贤隐山五首 其一","author":"何景明","text":"九日西山上，登临思渺然。\n高城过一雁，疏柳歇繁蝉。\n胜概仍佳节，同游似往年。\n休将竹叶盏，空对菊花前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同诸友登贤隐山五首 其二","author":"何景明","text":"古寺来游日，高秋云物清。\n楼台芇里目，时序百年情。\n野树斜侵郭，河流曲抱城。\n明年当此际，谁与共题名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同诸友登贤隐山五首 其三","author":"何景明","text":"野望秋无赖，西风城树凋。\n浮云满天地，落日更萧条。\n醉舞随长剑，哀歌逐短箫。\n龙山高兴者，千载竟难招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同诸友登贤隐山五首 其四","author":"何景明","text":"野寺空崖里，高台旧国傍。\n山川待我辈，风日媚重阳。\n云峤秋临迥，松林暮倚长。\n由来宋玉意，摇落自悲伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同诸友登贤隐山五首 其五","author":"何景明","text":"薄暮经行处，千岩落照深。\n孤松秀云壑，众草莽寒林。\n故里登高兴，平居怀旧吟。\n风前一感慨，不异古人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望京师寄王职方","author":"何景明","text":"北望依南斗，长安万里愁。\n西风入上苑，杨柳落金沟。\n云近蓬莱阁，天回太液流。\n仙郎归尽省，高咏接同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日怀铁溪","author":"何景明","text":"独忆高夔府，何时骑马来。\n一秋常卧病，九日废登台。\n寂寞传杯手，凄凉作赋才。\n陶家园内菊，风雨为谁开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"两后次孟望之二首 其一","author":"何景明","text":"断雨藏深浦，残云霁晚空。\n人家乱水外，野艇夕阳中。\n风急鸣江鹳，天高落塞鸿。\n沧浪浩歌起，身世羡渔翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"两后次孟望之二首 其二","author":"何景明","text":"万里看无际，高秋接素氛。\n沙村昏片雨，石壁断孤云。\n鸿雁常求侣，凫鸥不离群。\n寒山有落木，风起暮缤纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"霜节","author":"何景明","text":"鼓角苍山畔，孤城此岁残。\n回风夜不止，清霜日以繁。\n未惜琼树晚，还悲瑶草寒。\n阳春在何日，幽谷待鸣鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]