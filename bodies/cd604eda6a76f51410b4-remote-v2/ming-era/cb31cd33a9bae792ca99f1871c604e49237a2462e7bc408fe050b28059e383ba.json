[{"title":"岊江兰若送浦大归晋陵分得衣字","author":"林鸿","text":"离亭征骑晓騑騑，正值关河朔雁飞。\n白发相看闽海别，青山遥送晋陵归。\n江城雨外莲峰出，野寺霜前柿叶稀。\n自愧忘情非上知，临歧唯有一沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14522,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄高八逸人","author":"林鸿","text":"离亭高唱久难酬，明月心期恋旧游。\n泛腊酒香频中圣，流年花发总关愁。\n山园浥露寒梨熟，水国迎霜晚稻收。\n自愧湮沈向城市，閒情惟有一登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14523,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得垂杨送客","author":"林鸿","text":"客路垂杨最有情，暖风吹绿渐冥冥。\n雨深炀帝宫前见，月落桓伊笛里听。\n叶暗乍堪藏乳燕，花飞终恨化浮萍。\n分携欲折长条赠，愁绝河桥酒幔青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14524,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归冶城辱群公追饯至江心亭","author":"林鸿","text":"梅风初熟布帆归，相送劳君到翠微。\n远树啼莺留客醉，高林深竹见僧稀。\n江心绝岛晴浮出，雨外孤云湿倦飞。\n野鸟白鸥如有待，想应知我拂朝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14525,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋江离思图","author":"林鸿","text":"粤城衰柳拂金堤，雨里秋襟惜解携。\n客散江亭闻断雁，酒醒沙馆候鸣鸡。\n枫桥夜冷吴讴起，笠泽天寒楚望迷。\n天路云山从此别，一封愁札为君题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14526,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜浦舍人见宿园亭分得天字","author":"林鸿","text":"南宫饮散动经年，此会羁魂各黯然。\n霄汉故人谁更在，江潭逐客自堪怜。\n疏灯细雨开秋宴，落叶惊风搅夜眠。\n归去晋陵成远别，好凭阳雁望南天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14527,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夕阳","author":"林鸿","text":"抹野衔山影欲收，光浮鸦背去悠悠。\n高城半落催鸣角，远浦初沈促系舟。\n几处闺中关绣户，何人江上倚朱楼。\n凄凉独有咸阳陌，芳草相连万古愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14528,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送林一归山中","author":"林鸿","text":"楝花雨里醉逢迎，南国看山又送行。\n求侣暗惊春草色，还家愁逐暮江声。\n残阳向野闻边笛，远树登楼见海城。\n谁念长沙迁谪久，懒从季卜问君平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14529,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚日杉关","author":"林鸿","text":"荒苔古道敛微曛，马上笳声不可闻。\n地自乱离民舍少，山当闽楚客程分。\n长林积雨寒为雪，深树孤峰湿作云。\n愧我旧游见关吏，也将书剑学终军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14530,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄林一和深字","author":"林鸿","text":"雨馆张灯坐夜深，故人相对醉成吟。\n二毛易老惭看镜，四美难并愧盍簪。\n泽国晓霜催候雁，县城春树变鸣禽。\n贾生尚有长沙谪，此日无劳叹陆沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14531,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆郑二宣时往交州","author":"林鸿","text":"旬日阴霖结不开，穷居幽草乱侵阶。\n也知白发缘愁长，无那青山与愿乖。\n行阻看花携浊酒，卧闻啼鸟闭虚斋。\n比来况与浮丘别，一望南天一怆怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14532,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初出同黄少府宿采石","author":"林鸿","text":"南宫拜疏许归休，芦荻沧江晚系舟。\n贳酒暂同牛渚咏，曳裾无复凤台游。\n海门白涌潮头急，烟岛红拖雨脚收。\n不用临流濯缨袂，此心从此不惊鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14533,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新秋浮亭夜集分韵得摧字","author":"林鸿","text":"海国新凉一雁来，衣冠高会壮怀开。\n浮亭夜月樽前满，古树秋声笛里哀。\n白发朋游嗟落魄，青山故业怨低摧。\n灯残酒醒还成别，刻漏应愁晓箭催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14534,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄高逸人漫士","author":"林鸿","text":"独倚城南百尺阑，粤乡秋思浩漫漫。\n平台树色催残照，近郭砧声报早寒。\n云物正当摇落后，关河终念别离难。\n龙门别墅今宵月，谁与相同把酒看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14535,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与黄一秀才辈雨夜浮亭集宴忆郑二宣","author":"林鸿","text":"香灺灯残意万重，与君共忆远游踪。\n尺书不到惊春雁，樽酒相逢话夜钟。\n风动栎枝翻暗鹊，雨深莎井响鸣蛩。\n自惭浅薄谁招隐，尚掩丘樊学卧龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14536,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题吴江垂虹桥","author":"林鸿","text":"云帆秋晚过垂虹，落日鲸波动远空。\n欲借仙家辽海鹤，月明吹笛水晶宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14537,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓行","author":"林鸿","text":"前山树暗月胧胧，马色鸡声共晓风。\n不为逢秋多感慨，只缘身在别离中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14538,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梦中仙游","author":"林鸿","text":"天葩小院敞云屏，鹊散星河逗客星。\n欲识别来离思苦，晚峰长学黛眉青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14539,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"将之海上群公相饯至龙津","author":"林鸿","text":"百尺云帆絓海霞，劳君相送到天涯。\n重来应恐清秋晚，落尽清泠桂子花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14540,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿逆旅闻泉声","author":"林鸿","text":"练瀑飞空作雨声，楼虚月白旅魂惊。\n相思不道无归梦，自是离人梦不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14541,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"下山寻朱继","author":"林鸿","text":"携琴载酒远寻君，石径人稀半夕曛。\n纵醉也须上山去，莫教闲却半床云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14542,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题朱舍人为史太守写梧竹","author":"林鸿","text":"舍人退食写閒情，公子开椷玉雪清。\n曾向凤池同夜直，掖垣梧竹总秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14543,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题郑昭甫写张骞乘槎图","author":"林鸿","text":"滚滚黄河天上来，茂陵底事望蓬莱。\n早知博望乘槎便，虚筑通天百尺台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14544,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别沈校书","author":"浦源","text":"与君昔相逢，花开酒楼醉春风。\n平生车马愿与共，何意事变分西东。\n君卧东山里，我钓西江曲。\n几回枫树梦中青，千里桂枝愁处绿。\n飞燕翔鸿徒往来，音书不寄使人哀。\n返照斜分远行路，浮云乱绕旧登台。\n今朝复见兰陵道，细雨微烟湿芳草。\n别离惆怅十年多，我少朱颜君已老。\n握君手，与君吟，感君知己复知音。\n我将归去重回首，云海苍茫情更深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14545,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人之荆门","author":"浦源","text":"长江风飏布帆轻，西入荆门感客情。\n三国已亡遗旧垒，几家犹在住荒城。\n云边路绕巴山色，树里河流汉水声。\n若过旗亭多取醉，不须吊古漫题名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14546,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送贾文学入京","author":"浦源","text":"春城送别已斜阳，花发官亭酒正香。\n远骑青山江上路，新莺细柳禁中墙。\n疏星北阙趋朝早，澹月南宫听漏长。\n谁谓贾生年最少，犹能陈策辅君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14547,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄杨先归颍上","author":"浦源","text":"荒城此日共悽然，我欲南征子北迁。\n秋雨黄芦思颍水，夕阳红稻忆吴田。\n萧条客舍虫声里，迢递乡书雁影边。\n安得重逢一携手，别离同话酒尊前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14548,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别谢秀才","author":"浦源","text":"兰陵陌上喜逢君，华馆清谈酒未醺。\n虫唤旅愁秋已半，烛欹吟影夜初分。\n虚窗叶响风惊雨，远浦钟来水接云。\n良会不知能几度，明朝何事又离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14549,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送包鹤州归湖上","author":"浦源","text":"西风江上赋归休，值雨那堪夜泊舟。\n官路暝烟迷驿舍，郡城寒火出更楼。\n到家正及湖田熟，在客先惊馆树秋。\n还忆情人相别处，短亭孤棹共悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14550,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"并州寒食","author":"浦源","text":"梦入故园千里远，觉来寒食在并州。\n垂杨不是相思树，那得花开便白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14551,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王济民归盘谷","author":"浦源","text":"官亭酒香柳花白，下马持觞送行客。\n客归江上愁更多，春水雨中生绿波。\n青山遥对扬子渡，残日微明广陵树。\n渡头酒醒伤别离，夜半舟人歌《竹枝》。\n乌啼月落海天远，驿程已过淮阴县。\n楚乡菰饭食有鱼，宵征在鞍宿在车。\n中原渐近太行麓，不知何处通盘谷。\n一径萦纡万壑深，始知旧宅隐云林。\n昔年泉谷浑无恙，猿鹤犹存松桂长。\n遗老家家怀故情，相邀鸡黍话平生。\n樽前不问宦游好，只说山中农事早。\n数亩何须负郭田，郡中太守正求贤。\n知君不肯入城市，日逐渔樵向山水。\n江南故人那可逢，有书仍寄南飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14552,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄袁二","author":"浦源","text":"长安年少羽林郎，骑射惟能事武皇。\n弓影醉开孤月满，刀头新买百金装。\n听鸡晓阁疏星白，走马春郊细柳黄。\n应慕玉门关外去，请缨先系左贤王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14553,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送荆南师户侯移镇公安","author":"浦源","text":"悠悠旌旆碧云端，远去孤城入乱山。\n淮月上楼人奏角，海天低树雁临关。\n几家白发遗民在，千里青丝猎骑还。\n旧镇荆南多胜槩，别来惟见画图间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14554,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阻风清河县","author":"浦源","text":"阻风淮岸忆家山，骨肉相亲梦寐间。\n冀北一官今独往，江南千里几时还。\n孤村人语秋临水，小县鸡鸣夜掩关。\n明月异乡谁不见，嗟予偏对别离颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14555,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人还乡","author":"浦源","text":"都门杨柳拂离筵，归路青山水国连。\n三月春阴垂细雨，几家寒食起新烟。\n听莺谷口停行盖，立马江头问渡船。\n此去故园应酒熟，杏花开遍草堂前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14556,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽高季迪","author":"浦源","text":"鼓罢瑶琴遂解形，萧萧日影下寒城。\n薄田供祭遗妻子，新冢题名望友生。\n地下未应消侠气，人间谁肯没诗名。\n旧庐重过悲闻笛，欲赋《招魂》竟不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14557,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王二归山中","author":"浦源","text":"阖闾城外敛馀晖，水国苍茫夕鸟微。\n远火山中人未宿，孤舟江上客初归。\n高林果熟经新雨，疏柳春深映旧扉。\n遥想到家无一事，閒看儿女笑牵衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14558,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西城晚眺","author":"浦源","text":"宫柳犹遮旧女墙，角声孤起送斜阳。\n英雄百战成寥落，吴楚平分自渺茫。\n寒雁动愁离塞远，暮江流恨入云长。\n古今天地谁非客，何用登临独感伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14559,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"林膳部鸿浮亭夜饮得河字","author":"浦源","text":"都亭分袂惜蹉跎，此夕相逢奈若何。\n细雨疏灯闻落叶，断云高树见明河。\n客踪迢递天边雁，归梦微茫海上波。\n鞍马朝来又成别，且倾尊酒一狂歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14560,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和马秀才先归","author":"浦源","text":"长安甲第似云稠，冠盖相望孰解愁。\n宫漏深沉春树里，禁垣环绕碧山头。\n微烟草色迷征路，澹月梨花隐驿楼。\n闻道马卿归卧病，懒攻词赋客诸侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14561,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过星轺馆","author":"浦源","text":"仙馆万山深，銮舆近驻临。\n洞门金锁閟，垂柳粉墙阴。\n旌旆移龙影，笙竽过凤音。\n小臣来独晚，向此一沉吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14562,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日旅怀","author":"浦源","text":"别后犹飘泊，春来倍叹嗟。\n花开今日少，人忆故园赊。\n细雨连山暝，清溪入郭斜。\n慈闱在何处，欲望暮云遮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14563,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送丘上舍之边上","author":"浦源","text":"挥金收壮士，解剑赠离群。\n数骑临秋去，孤猿入夜闻。\n帐寒营满雪，边旷路连云。\n愿出平胡策，功成报汉君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14564,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀何士信谪西河","author":"浦源","text":"全家离故乡，万里谪穷荒。\n草木疏边境，牛羊绕帐房。\n风声连雨雪，汉语杂氐羌。\n远念平生友，行吟泪数行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14565,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠张颍州","author":"浦源","text":"迢递浮淮泗，凄凉过颍州。\n水阴孤馆夕，草色半城秋。\n才薄惭王事，吟多惜宦游。\n不逢张太守，那得暂相留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14566,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和干先生","author":"浦源","text":"秋城黄叶下，闻笛泪沾衣。\n乍雨千峰出，残阳一鸟归。\n客贫知己少，乡远去人稀。\n何事荆南道，逢君始可依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14567,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题张生旧馆","author":"浦源","text":"广陵人去客天涯，旧馆凄凉闭落花。\n立马斜阳空洒泪，一声横笛起邻家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14568,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题赵昌所画御屏牡丹","author":"浦源","text":"绿芜春雨洛阳城，不见名花国已倾。\n影落画屏何处物，断金残粉故宫情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14569,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬干秀才","author":"浦源","text":"酒醒题诗忆送君，残阳半掩竹间门。\n相思昨夜空斋里，烛灭香炉火尚温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14570,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除夜客怀","author":"浦源","text":"火冷空斋夜掩霜，明朝新岁在殊方。\n故乡亲老谁相守，独对寒灯泣数行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14571,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹枝词","author":"浦源","text":"红漆车儿驾白羊，吴盐空洒竹枝香。\n不知羊角如心曲，才听车轮欲断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14572,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄熙上人","author":"浦源","text":"孤愁无处觅高僧，欲问楞伽竟不能。\n遥想山中禅定夕，半窗残雪一寒灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14573,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送友人","author":"浦源","text":"孤舟春别万花西，云淡山青水满溪。\n料得客愁何处是，绿阴官舍听莺啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14574,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题青山白云图","author":"浦源","text":"青山欲转绿溪回，古木春云掩复开。\n不识桃源在何处，但看流水落花来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14575,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚过张林山","author":"浦源","text":"名山几度欲寻幽，此日虽来不暇游。\n一棹黄昏过山下，疏灯络纬满林秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14576,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜听谷大弹阳春白雪遂歌以赠","author":"黄玄","text":"昔闻歌《白雪》，未知弦上声。\n看君弹来秋月下，十指如度春风鸣。\n初闻飘飘下天阙，乱逐回风气骚屑。\n冻来深树梅不开，散入空林竹应折。\n又如纷纷江上来，流音中节浑相催。\n灞陵一日几人度，剡溪半夜孤舟回。\n清川带寒流，野鸟绝繁语。\n少女歌残叶共飞，仙郎唱罢花能舞。\n须臾雪晴风亦迟，按弦问君君不知。\n声残响绝无所见，惟见桐枝秋露垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14577,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"北岭陪殷大夜饮感别","author":"黄玄","text":"故国秋风见仲宣，悲欢都集夜灯前。\n二毛对酒仍堪醉，万里还家祇自怜。\n树拂断猿疑峡路，月临征雁梦湘川。\n谩将草木同衰朽，未必阳春雨露偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14578,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丹阳道中","author":"黄玄","text":"五陵为客久，儒服满尘埃。\n望阙无知己，还乡愧不才。\n山阴残雨度，河广断云开。\n归去多朋旧，春城共酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14579,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河上立春","author":"黄玄","text":"故国几时别，殊乡今早春。\n青阳开霁雪，残日送归人。\n渐与云霄隔，空惊岁月新。\n不堪零落处，愁泪满衣巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14580,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题周进士古木清猿图","author":"黄玄","text":"昔从锦城来，却过愁猿道。\n千崖万嶂不可闻，此中哀怨令人老。\n况是西江秋水来，冲波逆折鸣风雷。\n攀萝涉水苦难度，腾枝抱子俱萦回。\n空林阴阴不知处，前惊后呼若相语。\n正当绝险陵天梯，揽辔听来泪如雨。\n君不见蚕丛开国通秦关，六龙西幸仍跻攀。\n猿声鸟道有如此，一为长歌《行路难》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14581,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送金秀才之温陵","author":"黄玄","text":"官亭花发酒初香，白马翩翩大道傍。\n醉客尽随歌舞散，寒川空对别离长。\n紫云洞里逢秋月，赤鲤潭边度早霜。\n休说故山多少恨，军中吹角断人肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14582,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏秋风","author":"黄玄","text":"目眇洞庭波，辞雄楚江宴。\n帝子正愁予，羁臣发先变。\n冷然阊阖生，飒尔江潭遍。\n随阳惊塞雁，附热驱巢燕。\n萦回步云飞，飘拂歌雪转。\n衣露戒履冰，弦霜愁泪霰。\n蔡文掩悲笳，班姬袭团扇。\n凄凉如一宵，偏向长门殿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14583,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"揭天谣九首 其一","author":"周玄","text":"巨灵吹空南斗死，鬼哭如云学流水。\n桂阑天影白鹤秋，兔光斜坠三泉里。\n泉宫暗虫寒草根，土灯燃露絓黄昏。\n铁心九回滴秋血，三十六帝闻俱吞。\n帝遣双童去不返，楸梧参差牧马苑。\n青烟一点吹六龙，芙蓉吐光海波浅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14584,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"揭天谣九首 其二","author":"周玄","text":"西池鹊寒坠灵羽，水嘶粼粼冻王母。\n青娥遏云纷玉琚，水帘桃花逗香乳。\n紫元双眉牵黛光，颓蒿折玉寿齐长。\n风台神人铁作背，哭声酸骨啼秋裳。\n彩丝结绳絓秋影，身骑白龙劝天醒。\n暗魂斜背南山飞，独立香虫泣空冷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14585,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"揭天谣九首 其三","author":"周玄","text":"鱼鳞居次龙堂高，琉璃砌空银烂涛。\n波灵泣诉海若浪，腥风卷昼云漕漕。\n珠潭沉光瘗神妪，瘦蛟啾啾走沙雨。\n仙郎秋袂斑斑啼，泪花凝碧扶桑树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14586,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]