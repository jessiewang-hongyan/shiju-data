[{"title":"题黎氏沧洲图","author":"邓雅","text":"滔滔大江水，冉冉沧洲云。\n兰杜有香气，莓苔无垢氛。\n数家临绝岸，一艇横通津。\n渔唱落霞晚，鸟啼芳树春。\n对景阅图画，乐哉栖遁人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31255,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"耕乐为黄从礼赋","author":"邓雅","text":"山鸠鸣高树，科斗散平池。\n甘泽既已足，播谷当及时。\n俛焉佩古训，服田不知罢。\n躬耕宁为耻，所乐实在兹。\n丰年黍稌登，庶用给公私。\n匏尊湛香醪，彘肩亦已肥。\n农谈共邻叟，鼓腹常熙熙。\n人生贵力本，汲汲将奚为。\n陶然上皇逸，载诵豳风诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31256,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题胡志同云松巢","author":"邓雅","text":"高风慕太古，喜结云松巢。\n餐松复餐柏，葺云如葺茅。\n氛氲翠色合，浑沦元气包。\n谪仙本同志，巢父为旧交。\n徵起拜龙衮，乞归吹凤匏。\n还将御赐笔，挂在凌云梢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31257,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"盘泉为李原初赋","author":"邓雅","text":"盘中有真乐，君子恒慕之。\n径转得幽处，泉流无尽时。\n潭深老龙蛰，藻密潜鳞依。\n俯瞰照须发，渴饮清骨肌。\n忘情或渔钓，洗耳无是非。\n吾才匪韩子，愧尔来徵诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31258,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题谢氏坚白斋","author":"邓雅","text":"堂东有白石，堂西有白石。\n堂南有白石，堂北有白石。\n团团若天成，光彩眩玉色。\n煮之可充饥，拂之可为席。\n磨涅不磷缁，宜比君子德。\n若人好斯堂，因之扁坚白。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31259,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题宋彦辅梅屋","author":"邓雅","text":"幽人爱孤芳，贞白比冰玉。\n寂寞竹篱间，相依结茅屋。\n久香似无闻，一清如可掬。\n不有铁石心，谁能伴幽独。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31260,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹅溪钓叟为陈充宾赋","author":"邓雅","text":"前林带溪水，湛湛寒潭深。\n垂纶不设饵，鲂鱮自浮沉。\n明月照孤艇，清风飘素襟。\n物我俱两忘，悠然尘外心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31261,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠道者张回风时寓居双林寺","author":"邓雅","text":"回风西北来，入我双树林。\n松声常在耳，彷佛丝桐音。\n静时若有得，动处元无心。\n炎天访禅宇，为我开烦襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31262,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄陈伯玉徵士自号云樵 其一","author":"邓雅","text":"桃李耀芳园，芝兰翳深谷。\n世人竞纷华，君子秉贞独。\n缅思云樵翁，中心澹无欲。\n恳切辞簪缨，还山养麋鹿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31263,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄陈伯玉徵士自号云樵 其二","author":"邓雅","text":"养鹿春草肥，樵云碧山深。\n投閒固所愿，沽名本无心。\n清涧可濯足，微风亦飘襟。\n萧然坐盘石，长歌有馀音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31264,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄陈伯玉徵士自号云樵 其三","author":"邓雅","text":"君歌我还续，声入云霄间。\n能使潜蛟舞，亦招飞鹤还。\n依稀在仙岛，恍惚非人寰。\n扰扰当世士，胡为多苦颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31265,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白云中人为陈知县赋","author":"邓雅","text":"青山何逶迤，白云时卷舒。\n相看两无心，幽处真自如。\n斯人在岩壑，承诏升天衢。\n回首瞻白云，浩然赋归欤。\n朝与白云对，夕同白云居。\n缥缈落窗户，氤氲拂衣裾。\n云中何所乐，所乐在琴书。\n常恐白云散，门外来徵车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31266,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题高山流水图","author":"邓雅","text":"泰山一何高，江水亦何深。\n宁知伯牙弦，妙合钟期心。\n清风邈千载，太息谁知音。\n斯人好古调，拂轸徽黄金。\n一弹玄鹤舞，再弹苍龙吟。\n翛然山水趣，得之在胸襟。\n画师亦好古，能画复能琴。\n援笔写幽意，溪声风满林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31267,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题李次晦明复堂","author":"邓雅","text":"宝镜出匣中，尘垢乃翳之。\n一朝事拂拭，鉴物分妍蚩。\n灵台素澄湛，利欲或昏迷。\n谁知方寸间，至理森在兹。\n先师有明训，于以觉后知。\n性善苟能复，圣贤可同归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31268,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题鞠孟端悠然亭","author":"邓雅","text":"渊明住柴桑，门无车马諠。\n青山如故旧，一见心悠然。\n若人慕高风，作亭临水边。\n高柳三五株，兰菊亦鲜鲜。\n宾朋日过从，饮酒和陶篇。\n悠然得所乐，庶以全其天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31269,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题陈寅宾旸谷斋","author":"邓雅","text":"高斋面旸谷，四序常如春。\n挂巾扶桑枝，晞发迎朝暾。\n雍熙逢治世，俯仰信乾坤。\n未知羲和事，自是尧舜民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31270,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题何氏南塘旧隐","author":"邓雅","text":"阴森野竹寒，缭绕南塘幽。\n窗虚纳翠霭，门閒俯清流。\n中有隐沦士，抱冲真寡俦。\n垂纶聊自适，守已澹无求。\n俯仰忆先世，逍遥寓斯丘。\n为歌少陵诗，勉旃继前修。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31271,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题李氏维稼堂","author":"邓雅","text":"逐末成浇风，力本化淳俗。\n遐思在古人，播殖维嘉谷。\n斯堂俯青郊，窗户荫高木。\n了无尘事侵，稍喜生意足。\n维时沛甘泽，良苗蔼新绿。\n辛勤愿有秋，饱煖更无欲。\n唐虞致雍熙，巢许乐幽独。\n为子歌韩诗，清风起盘谷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31272,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题乐閒堂","author":"邓雅","text":"为善真可乐，无营心自閒。\n奈何世之人，汩没尘埃间。\n是中有佳趣，游目皆青山。\n依山搆堂宇，白云锁松关。\n古意阅图史，幽香闻蕙兰。\n尊前好风月，泉响当鸣弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31273,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题内弟吴大使子充墨龙","author":"邓雅","text":"神龙潜九渊，变化恍难测。\n伊谁写真形，一览壮心魄。\n淋漓元气湿，惨淡风雨黑。\n终当上天门，四海望涓滴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31274,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠相士黄逸仙","author":"邓雅","text":"伯乐善相马，一顾增千金。\n荀子颇知道，相形先相心。\n黄生师唐举，于义尤精深。\n取人或渔钓，所遇多缨簪。\n嗟我守贫贱，辱子过云林。\n未示衡气机，赠以离别吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31275,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黎氏积庆堂诗（并序）","author":"邓雅","text":"积善有馀庆，不善有馀殃。\n至公在司造，报效亦已彰。\n蔓草务去根，猗兰愿留芳。\n人心与天理，好恶乃其常。\n驷车于门高，五桂窦氏昌。\n阴德信有徵，福泽其无央。\n斯堂扁积庆，著善斯不忘。\n后人继芳躅，奕世垂休光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31276,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柬同宗邓仲伟","author":"邓雅","text":"流水本同源，丛兰亦同根。\n匪有薰莸异，而无泾渭分。\n余忝高密裔，念君亦闻孙。\n礼服既悠远，岁月复驰奔。\n相视如路人，莫知卑与尊。\n兹晨得良晤，永托为弟昆。\n所重骨肉亲，贵贱安足论。\n我昔历艰苦，慷慨心欲扪。\n八龄失所怙，犹幸慈母存。\n鞠育与教诲，天地同深恩。\n乱离废旧业，诗礼犹清门。\n不敢忝厥祖，佩服先哲言。\n为君写衷曲，短笔聊复援。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31277,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"外甥吴缉字克熙洪武十二年二月客死于景陵时年二十八余哭之恸赋此以志余哀","author":"邓雅","text":"人生天壤间，脩短难一致。\n吾甥昔四人，今焉只存二。\n缉也颇聪明，风骨亦殊异。\n总角事诗书，英年总材艺。\n山林厌拘束，湖海多意气。\n辞亲远服贾，霜雪逼残岁。\n昆弟争挽留，同侣复牵制。\n别去一月馀，还附手书至。\n悲风忽重来，闻作景陵鬼。\n景陵在何方，西北数千里。\n黯黯荆山云，茫茫汉江水。\n白骨埋黄沙，荒阡复谁祭。\n吁嗟乎苍天，夺汝竟何意。\n恶草常蔓延，幽兰易凋悴。\n我思平生情，悽怆裂肝肺。\n亲老子尚孩，相看祗垂泪。\n汝父客岭南，归骨已无计。\n汝复没他乡，不鉴覆辙弊。\n作诗招汝魂，仍以戒后世。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31278,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送何正夫西游","author":"邓雅","text":"野老守贫贱，无营方灌畦。\n故人将远适，问我审安危。\n穷达固有命，行止亦有时。\n人能不违天，履险如平夷。\n君既悟斯理，行矣复奚疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31279,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄兴平税使何维翰","author":"邓雅","text":"自古有离别，余今独伤悲。\n关河数千里，辗转劳梦思。\n时序倏以迁，容鬓日以衰。\n萧萧朔风寒，杳杳孤鸿飞。\n欲往良独艰，相见讵有期。\n商歌意无限，零泪忽沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31280,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"高允宪先生客习氏馆中清风修竹翛然有尘外意喜而赋此","author":"邓雅","text":"萧萧池上竹，飒飒林间风。\n风来为谁清，乃与君子同。\n君子秉贞节，翛然在山中。\n岁寒不改操，结交梅与松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31281,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"客馆岁暮别友人","author":"邓雅","text":"斋居仅一亩，旅寓将五旬。\n盈几散书帙，并坐俨冠绅。\n从容谈妙道，彼此乐清贫。\n灯孤不成寐，岁晏喜相亲。\n寒气正催雪，梅香偏袭人。\n情深忍离别，诗就写慇勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31282,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜坐有怀丁御史子坚","author":"邓雅","text":"山斋夜岑寂，落木含凄风。\n青灯照孤影，幽思浩无穷。\n人生无定居，飘转如飞蓬。\n美人在何许，使我心忡忡。\n援琴复置之，默坐想音容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31283,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月夜有怀曾主簿伯曼","author":"邓雅","text":"华月照虚馆，悲蛩鸣草根。\n閒情还脉脉，离思更纷纷。\n感慨不成寐，羁孤谁与论。\n惟应弃官客，佳思寄琴樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31284,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄陈壶隐","author":"邓雅","text":"十年不相见，远客梁宋间。\n词华动侯伯，羁思满河关。\n归来厌世事，采药游名山。\n猿鹤共吟啸，渔樵相往还。\n有情泛佳菊，无语对丛兰。\n即此羡閒适，营营徒险艰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31285,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄邹椿龄","author":"邓雅","text":"大隐在城市，小隐居山林。\n所居虽异地，所乐还同心。\n我歌小山词，君弹流水音。\n相知既已久，相忆思难任。\n何时遂盍簪，绸缪话胸襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31286,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄李如愚","author":"邓雅","text":"黄叶林中深，幽泉竹根冷。\n徐步下逢人，双飞见禽影。\n偶伤良晤乖，暂喜尘事屏。\n伫立遥相望，微云隔松岭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31287,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄曾隐君大雅（其所居堂扁曰东乐）","author":"邓雅","text":"高山列屏嶂，下有幽栖人。\n崖壁饶古意，轩窗多白云。\n松阴覆几席，兰气袭衣巾。\n其乐似东老，熙熙满怀春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31288,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"北平捡挍谢叔宾谪官岭南诗以寄之","author":"邓雅","text":"幽燕春苦寒，岭海冬尚热。\n寒暑君备尝，相思最愁绝。\n君怀自夷旷，君心秉贞节。\n所愿济斯民，艰难底须说。\n皇天幸无私，白日照丹阙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31289,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄画者彭子惟求作松下煮蒲小景","author":"邓雅","text":"高情似王维，妙画固无匹。\n绝岛与寒汀，挥秃千兔笔。\n飘然江海踪，伫立怀高风。\n为作老松树，下著煮蒲公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31290,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上有怀曾主簿","author":"邓雅","text":"归鸿不可留，去鹤犹难招。\n朔风起离思，短发寒飘萧。\n远树带斜日，沧江生暮潮。\n双飞愧鸥鸟，独立心摇摇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31291,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上览物有感","author":"邓雅","text":"愁怀似江水，汩汩无时休。\n俯仰今古意，凄凉天地秋。\n鸿飞避矰缴，鱼跃惊纶钩。\n所幸遂天性，逍遥在沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31292,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读陶渊明诗二首 其一","author":"邓雅","text":"吟诗不须苦，吟苦失诗意。\n吾笑郊岛徒，彫锼损肝肺。\n凯风因时来，微雨从东至。\n凭几诵陶诗，诗中有深味。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31293,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读陶渊明诗二首 其二","author":"邓雅","text":"我性爱陶诗，难窥数仞墙。\n閒来辄诵之，愈觉滋味长。\n太羹无盐梅，土鼓谐宫商。\n谁能起公死，执鞭向柴桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31294,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉中作","author":"邓雅","text":"平生不嗜酒，酒至苦难避。\n僶俛事劝酬，聊乐宾主意。\n重觞即陶然，兀坐时假寐。\n君当恕醉人，我已忘天地。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31295,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读道书作","author":"邓雅","text":"篱落带幽篁，繁阴翳虚牖。\n萧然坐团蒲，布衲蒙衰朽。\n平生好清虚，道帙常在手。\n意会欲忘言，欣然复良久。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31296,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"有感","author":"邓雅","text":"昨日天气热，披襟步林间。\n今朝朔风劲，觉我衣裳单。\n气运有盛衰，天道常循环。\n富贵何足羡，贫贱何足叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31297,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮归途中作","author":"邓雅","text":"残阳在林梢，孤鸟度微影。\n行人念归程，十里隔松岭。\n萧萧风色寒，漠漠烟光暝。\n稍喜近人家，溪桥接村径。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31298,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"客中逢乡人得家中消息","author":"邓雅","text":"去家不忍别，久客遂忘还。\n忽见故乡人，与语增戚颜。\n比邻害疵疠，群从亦凋残。\n所幸一室安，卫生良独艰。\n语终对斜日，一鸟鸣空山。\n意存恍惚际，心在悲喜间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31299,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮秋感事","author":"邓雅","text":"寒风起萧瑟，落叶鸣空阶。\n荣枯固常理，时事何其乖。\n俯仰慨今古，无由舒我怀。\n皇天亦愁思，白日常阴霾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31300,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岁暮山中夜坐","author":"邓雅","text":"冉冉岁将暮，沉沉夜初永。\n木落风生寒，窗虚月流影。\n四邻寂无諠，独坐山斋静。\n孤灯照残书，妙道得深省。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31301,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元正后雪霁过邻曲","author":"邓雅","text":"晴岫消冻雪，春郊布熙阳。\n嘤嘤幽鸟鸣，静听如调簧。\n兴怀访故交，徐步登前冈。\n石窦通泉脉，林隈散梅香。\n稍欣得胜地，复喜升华堂。\n交庆遇岁始，共语思时康。\n愿言课孙子，读书力农桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31302,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"午睡初醒景与意会援笔赋此","author":"邓雅","text":"绿阴满庭户，苔色上阶除。\n数声幽禽语，一枕清梦馀。\n起视日将午，隐几观残书。\n陶然若有得，心存太古初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31303,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山行","author":"邓雅","text":"山行不逢人，山鸟随我飞。\n松风起涧壑，草露沾裳衣。\n独立爱萧爽，此心忘是非。\n何由跨仙鹤，一往寻安期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31304,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜雨二首 其一","author":"邓雅","text":"甘泽被丘园，良苗似膏沐。\n杖藜恣逍遥，满眼生意足。\n野饮携匏樽，农谈过邻曲。\n躬耕幸有年，何用干微禄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31305,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜雨二首 其二","author":"邓雅","text":"簪缨世所荣，犁锄我所安。\n况兹蒙润泽，岂复忧饥寒。\n园中摘蔬果，案上罗杯盘。\n诸孙戏我侧，俯仰良可观。\n山妻顾予笑，自足平生欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31306,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜雨寄诸友","author":"邓雅","text":"仲夏风雨多，萧萧凉气生。\n凭轩望原野，品物皆敷荣。\n唐虞在上位，海宇际升平。\n丰年况有象，一饱更无营。\n喜来赋新诗，持用寄高朋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31307,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨后作","author":"邓雅","text":"山中足时雨，萧爽如清秋。\n飞泉洒绝壁，白云被高丘。\n我性好冲澹，无心事彫锼。\n兴来且斟酌，吟咏当歌讴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31308,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"洪武癸亥夏五渡江访诸友暮归既登舟而风雨骤至","author":"邓雅","text":"清晨访故旧，及暮始言还。\n发棹风雨至，去留良独难。\n小舟如一叶，出没波涛间。\n兀坐丧神魄，相顾惨不欢。\n此身尽沾濡，那复惜衣冠。\n在险犹仓猝，历险心始寒。\n从兹慎行止，宁复婴忧患。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31309,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对庭树","author":"邓雅","text":"庭隅有佳树，偃蹇繁枝柯。\n长夏蔽朱炎，萧萧凉气多。\n玄蝉噪其间，好鸟声相和。\n余亦性所爱，对之聊咏歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31310,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"青山有高人","author":"邓雅","text":"青山有高人，澹泊无所求。\n虽能抱材艺，不肯干王侯。\n龙剑藏宝匣，霞衣住丹丘。\n浩然足清兴，何必三神游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31311,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚凉访邻曲诸友","author":"邓雅","text":"晚凉步幽径，微风飘衣襟。\n悠悠何所思，所思在同心。\n邻居二三友，托好在云林。\n宁忧贫与贱，所乐书与琴。\n閒时辄相过，有酒能共斟。\n醉时各分散，明日重相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31312,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日有怀丁御史","author":"邓雅","text":"永昼倦烦燠，披襟倚南窗。\n浮云忽凝阴，鲜飙喜微凉。\n心境适澄静，翛然尘虑忘。\n故人应此际，高卧到羲皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31313,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送邓吾贯往山东省亲","author":"邓雅","text":"天地司化育，品汇咸昭苏。\n怀哉父母恩，实与天地俱。\n生儿待终养，服劳报勤劬。\n儿幼父行役，伤心复何如。\n忆昔初别时，痛哭牵衣裾。\n关河数千里，风沙各天隅。\n尧舜在上位，山河归版图。\n云屯齐鲁邦，四境今无虞。\n觐省戒行李，艰难涉长途。\n是时朔风至，野树寒萧疏。\n出门指天日，见父乃旋车。\n送者为之戚，闻者为之吁。\n纯孝敦古道，性善由厥初。\n兹行毕素愿，勖哉慎其躯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31314,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早春踏雪游群玉山中","author":"邓雅","text":"山中春早寒，涧道积冰雪。\n屐齿碎琼瑶，行吟思清绝。\n仙人乘素鸾，飞下白银阙。\n授以长生方，金茎和玉屑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31315,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠星士陈鹤皋","author":"邓雅","text":"天运固有常，命理亦已微。\n先圣既罕言，后学鲜能知。\n巫咸实诡秘，虚中颇神奇。\n衰旺酌五行，祸福剖众疑。\n寥寥千载下，术者谁继之。\n斯人袭世业，造化窥璿玑。\n勖哉师古人，庶以鸣当时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31316,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]