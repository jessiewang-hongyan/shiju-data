[{"title":"朝陵次学士家兄韵","author":"杨守阯","text":"谯门曙漏咽铜龙，天上祥云捧日重。\n廿里驰驱经辇道，万山环绕护堂封。\n黄金台殿东西列，白玉舆梁远近重。\n欲向桥陵追杜老，难将瓦缶敌黄钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26499,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿史母一百一岁","author":"杨守阯","text":"峨峨珠翟翠云稠，堂北高居寿最优。\n大衍再周重挂一，平壶百刻又添筹。\n贤孙及第传金帖，令子悬车尚白头。\n屈指古今能有几，题诗更祝八千秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26500,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得震泽晴波送人入闽","author":"杨守阯","text":"五湖秋水客南还，极目空明豁醉颜。\n素练平铺云梦泽，青螺半出洞庭山。\n几行雁影孤帆外，万里天光一鉴间。\n南望八闽何处是，归心先已到乡关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26501,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别墅","author":"杨守阯","text":"廛市西头别有天，芋区桃圃近相连。\n绕城春水鱼浮沼，负郭秋风鹤在山。\n书幔影飘荷叶外，酒垆香入稻花边。\n主人高步瀛洲上，犹自哦诗忆辋川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26502,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送胡佥宪克敬","author":"杨守阯","text":"大河南北路东西，来往褰帷路不迷。\n华渚流虹身入觐，池瑭春草句留题。\n观风又返轺车鹭，带月应闻野店鸡。\n衮衮外台登内省，乔迁有待筑沙堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26503,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹茶炉次吴原博谕德韵","author":"杨守阯","text":"渭滨苍翠隔云泉，谁取编排事茗煎。\n凤阁舍人工创物，秋灵公子巧模前。\n火红松叶汤初沸，月白桃花客未眠。\n饮罢雪香三弄笛，閒中清趣自天全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26504,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林木养高","author":"杨守阯","text":"平生林下拥皋比，笑看鹓雏集凤池。\n锦诰已承明主赐，云山还系故园思。\n鸿飞碧汉凌尘坌，鹤向青田啄玉芝。\n老眼静看人世事，夕阳亭外几枰棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26505,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阳谷道中清明","author":"杨守阯","text":"昨夜东风急雨声，晓逢佳节是清明。\n篷窗春色柳枝挂，茶灶新烟榆火生。\n彩索鞦韆花外稳，画船箫鼓月中鸣。\n因思往岁朝陵后，兄弟赓酬百韵成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26506,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"孝陵恭谒有述","author":"杨守阯","text":"淮海龙飞入建康，金戈铁马净欃枪。\n不阶尺土兴如汉，尽革夷风治过唐。\n三纪衮衣明日月，万年陵寝肃风霜。\n小臣瞻拜祠宫外，惟见参天树色苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26507,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"视篆后二日得孪子","author":"杨守阯","text":"日出东城啼乳乌，檐前乾鹊又相呼。\n判花公署方投笔，坐草私门又挂弧。\n自笑秋瓜生并蒂，休嘲老蚌出双珠。\n多男且得宽怀抱，未计将来贤与愚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26508,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邵伯湖口与质夫丈启小酌","author":"杨守阯","text":"兰棹翩翩先后行，夜来相失苦相萦。\n石尤风似知人意，甓社湖边阻客程。\n云抹青山螺黛碧，天涵白浪雪花明。\n篷窗对景堪同乐，况有金陵酒满罂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26509,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"德州王知州琎韩同知琏各招宴于园亭","author":"杨守阯","text":"州衙深靓绝氛埃，客至园亭次第开。\n两院树阴当昼合，隔墙莺语送春来。\n小桥幽径翻红叶，曲涧鸣泉漾绿苔。\n别驾行觞欢未毕，还从太守醉霞杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26510,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"退直有怀寄董德初太守","author":"杨守阯","text":"赐环簪笔侍明君，待漏趋朝对夕曛。\n未有尺书能寄远，谩思尊酒共论文。\n吟看雁影横秋色，坐对灯花落夜分。\n不识滇南贤太守，也曾相忆赋停云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26511,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿都宪五兄第中","author":"杨守阯","text":"冀北频年忆广西，陟冈遥望暮云低。\n壶公缩地知无术，灵运登云喜有梯。\n宪府冰霜全晚节，夜床风雨咏新题。\n清灯坐久谈文运，五纬何时再聚奎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26512,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"钝儒","author":"杨守阯","text":"章台颖脱出群伦，日染龙香剂润身。\n涉署水衔头欲秃，题封山启迹还新。\n中心正直摹犹壮，小字模糊大转神。\n莫话秦人少恩事，不遗黎老咏皇仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26513,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"芳童","author":"杨守阯","text":"何物宁馨辟稻粱，云根稚子有刚肠。\n香分娲氏云中线，烟散图澄掌上光。\n藜火明销天禄阁，荀龙涎喷德星堂。\n佛书谩说严童子，非木非空闻妙香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26514,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"高叟","author":"杨守阯","text":"楮生平素懒谈玄，学董垂帷到暮年。\n午蝶有时同寤寐，秋蚊无路得夤缘。\n虚中惟见室生白，覆下何愁屋有天。\n自卜吾衰犹未甚，周公时梦到君边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26515,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"焙师","author":"杨守阯","text":"年来折节出岩阿，灭裂抽思作用多。\n千眼法王空相在，九还仙子内丹多。\n亲闱不待身温被，斋室宁容汗浥罗。\n雪夜梅天尤藉汝，袪除寒湿养天和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26516,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"美稚","author":"杨守阯","text":"缥绿两儿皆好酒，邹阳潘岳赋中看。\n却怜今日诸童子，只侑先春小凤团。\n白面总如冠玉美，清标恍出壑冰寒。\n交梨火枣从何得，披腹呈来不用盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26517,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"爽客","author":"杨守阯","text":"九光佛眩两街僧，六角金从五字增。\n几叶栟榈人易忽，一逢安石价须腾。\n轻翻香袖风生席，独映齐纨月似冰。\n纱帽閒眠对鸥客，不须庸汝却炎蒸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26518,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵寄侄茂仁郎中","author":"杨守阯","text":"南国移居有竹衙，平安消息报京华。\n傍篱已见新生笋，穿径还侵旧种麻。\n每对此君思小阮，无由缩地与陵霞。\n重怀文懿归游处，啼鸟惊心泪溅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26519,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送大司寇戴公祭扫荣归","author":"杨守阯","text":"去岁乞归归未成，今年报政又陈情。\n尚书展墓原无例，圣主加恩许暂行。\n日月祥光辉昼锦，江湖秋色渺云程。\n饶阳山上焚黄处，草木欣欣也向荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26520,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"得请喜复原韵","author":"杨守阯","text":"去岁蜩鸣入觐来，今年莺啭出金台。\n四时有序成功退，六十犹痴了事回。\n钟阜晓山青抹黛，秦淮春水绿于苔。\n濯缨还向江东去，免得风吹扑面埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26521,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吾鄞龙舌朱氏予先祖侍郎府君之姻族也守阯弱冠时尝馆于其家表侄名轩者年才十三从受业焉今来南都须鬓苍然问其年已六十二赋此志别","author":"杨守阯","text":"莺脰湖堤挟两川，形如龙舌尚蜿蜒。\n故家乔木千馀尺，先祖华姻上百年。\n犹记小窗灯火夜，研穷大易后先天。\n垂髫弟子今华发，话旧南都一慨然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26522,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画山水为费廷言司业题","author":"杨守阯","text":"一幅鹅溪绢，纵横数尺宽。\n良工先泼墨，妙手旋施丹。\n物象罗胸次，天机到笔端。\n宏开千顷泽，夐出万层峦。\n远近浓还淡，高低险复安。\n遥岑眉黛蹙，列岫剑峰攒。\n濯秀森琪树，飞空下玉湍。\n烟霞俱带润，林壑似生寒。\n几处重重屋，谁家曲曲栏。\n空青排闼入，澄碧捲帘看。\n红叶危将堕，苍苔湿未乾。\n云中无犬吠，潭底有龙蟠。\n潦尽沙矶路，峰回石磴盘。\n小桥通别墅，轻棹度前滩。\n触目皆佳景，游心恣大观。\n拟寻灵运屐，犹戴贡生冠。\n玩物情休荡，匡时志欲弹。\n何当画无逸，持以献金銮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26523,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"应制苍苔","author":"杨守阯","text":"禁苑初收宿雨天，玉沙驰道碧苔鲜。\n春来自是稀游幸，一任飞花点翠钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26524,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题朱太守山水画雪夜景","author":"杨守阯","text":"山雪初晴月蘸川，乾坤一色浩无边。\n不应清景无人见，系岸初回访戴船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26525,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"园亭家晏次大兄韵","author":"杨守阯","text":"风吹香径晚菲菲，落尽红芳蝶过稀。\n却是蔓青花独秀，春深犹解驻晴晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26526,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送莆田尹周用中","author":"杨守阯","text":"与君旧友结新邻，京国相过分外亲。\n凫舄南飞留不住，嘤嘤啼鸟蓟门春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26527,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题兰竹图","author":"杨守阯","text":"深谷香风泛紫兰，云根斜倚碧琅玕。\n若为尽化黄金色，应是西山返照看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26528,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿金山听潮阁","author":"储巏","text":"朝游欢未极，暮憩还自营。\n上方钟磬罢，虚室泠然清。\n起视夜何其，片月东南生。\n青山如改顾，隐隐攒高城。\n蛟龙寒尚蛰，波浪谁与争。\n乃知群动息，夕景涵空明。\n歘尔紫霞想，缅贻沧洲情。\n篝灯闭石阁，细听江涛声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26529,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"公乐驿","author":"储巏","text":"薄暮抵山驿，高舂辞蓟丘。\n青山半衔日，重为行人留。\n山中三日行，颇觉怀抱幽。\n鸟鸣白云澹，不省人间忧。\n简书复驱出，兀兀如拘囚。\n自憎牛马走，真作稻粱谋。\n何人谐夙尚，为我营莬裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26530,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"发永济驿","author":"储巏","text":"暮宿山下城，朝上山下驿。\n山高云雾深，饭久初见日。\n岂不畏驰驱，欲憩仍复出。\n悄悄闵农心，落落用世术。\n川涂漭无际，税驾何时必。\n赖此宽旅忧，千里青未毕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26531,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蓟州山中","author":"储巏","text":"青山借微雨，洗沐为谁容。\n宿云犹未归，更觉冈峦重。\n我行颇愁寂，赖此青山容。\n宛如平生交，倾盖遥相从。\n晚来境逾胜，四顾皆奇峰。\n何由擅一丘，且作渔阳农。\n谅无功业建，还以千家封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26532,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"涉园","author":"储巏","text":"涉园日已晚，春去聊追攀。\n微风喜我至，习习鸣树间。\n方池澹无波，中有凫藻閒。\n虽非沂水曲，聊此清尘颜。\n浩歌弥自慰，携幼徐当还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26533,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题苍雪道人卷","author":"储巏","text":"水官失苍佩，龙伯窃上天。\n染成天水碧，屑花竞芳妍。\n瀰漫三万顷，彷佛堆云烟。\n物情忌太洁，白帝不敢前。\n道人茅宇小，骨冷惊高眠。\n出门杳无见，乾坤正苍然。\n谁开混沌窍，坐此清泠渊。\n翩然谢浊世，还我太古年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26534,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事用韵荅赵叔鸣进士","author":"储巏","text":"赵生淮海士，眉宇温而閒。\n宛如九皋禽，独立秋塘湾。\n朅来游京国，籍甚名贤关。\n胸中烂文字，膏泽曾与颜。\n翘材馆阁地，贤俊争追攀。\n胡为不见擢，犹滞郎吏间。\n青云多捷径，冠盖纷区寰。\n谁能澹无事，日眺西城山。\n生才必有用，颇笑时人悭。\n幽贞子无厌，天道纵好还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26535,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七月廿有三日雨中同边李坐李道士西轩","author":"储巏","text":"炎歊困朱墨，久阻尘外游。\n及兹风雨辰，相与跻昆丘。\n飞觞狎羽客，搦翰逢诗流。\n翛然供宴坐，花竹媚凉秋。\n空庭水盈尺，泱漭天光浮。\n搴帘迟夕霁，欲去仍为留。\n坐悲芳草歇，况复鸣蝉稠。\n岂无终夕欢，感事令人愁。\n层云蔽苍彗，谁能诘其由。\n梯空谅有术，愿就王乔谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26536,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过玄武湖","author":"储巏","text":"北山飞翠凝吾杯，舟人举棹相徘徊。\n城隅捩舵踏冰入，船底轧轧闻春雷。\n霜风吹衣衣欲裂，湖天泱漭疑飞雪。\n司空劝饮夕郎酬，始觉微酣生颊热。\n中流咫尺冰尽开，沙禽水鸟忘惊猜。\n新洲昨夜梅花发，暗香偏逐诗人来。\n湖波为带城为被，册府图书真得地。\n堪笑前朝建此都，只将山水供游戏。\n钟山龙蟠几百里，下有龙宫藏剑履。\n山中老树尽成龙，夜夜飞来饮湖水。\n湖波直与银河通，背城一?垂晴虹。\n柏梯高寒石梁迥，十洲三岛神仙宫。\n长堤隐隐湖心路，堤上行人日来去。\n春风杨柳夏芙蕖，换尽年华颜色故。\n世间万事如云烟，湖光山渌只依然。\n不及湖中鱼与乌，涵泳恩波今百年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26537,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴康斋赠刘济宁清白字卷","author":"储巏","text":"康斋两字云垂纸，珍重刘宗百金比。\n南窗把卷触热看，习习清风吹簟几。\n就中墨汁西江水，直寄任城五千里。\n阆中丈人不复见，得见风流老孙子。\n传家所宝在不贪，阿堵真堪付泥滓。\n长安父老向人说，虞部郎官亦如此。\n君不见汉家西京全盛时，五侯七贵门如市。\n繁华回首并成空，籍籍今闻杨伯起。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26538,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"房山","author":"储巏","text":"我行京西三百里，日望燕台歌易水。\n春风着眼到房山，不放黄尘吹马耳。\n烟岚护雪不肯销，层峰相揖如相招。\n千金枉购尚书画，何如平地横生绡。\n晚来顷刻岩姿变，急雨漫山飒银箭。\n斜阳一抹乱青红，似与诗人供戏幻。\n胸中丘壑句传神，闻道刘公下笔亲。\n太华中峰五千仞，人间何地卜东邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26539,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送程贡士入南监","author":"储巏","text":"与君倾盖长安陌，姻娅何须论宿昔。\n京游三月苦思归，白马湖乾欲龟坼。\n春官召试彤庭前，晨曦五色摇炉烟。\n集贤学士看墨卷，青袍鹄立知谁先。\n姓名且入南雍籍，桂殿秋风吹羽翮。\n到家喜雨谩留题，洗眼湖光依旧碧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26540,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南旺湖次韵","author":"储巏","text":"南湖水阔秋无岸，尽日开帆疑不转。\n忽从树杪得高崖，始觉扁舟出天畔。\n渔家何自住枫芦，陂寒雁鹜遥相呼。\n斜阳欲下晚风急，人间此景何时无。\n君不见饮啄那须论蒋霍，人生得意良不恶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26541,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨夜","author":"储巏","text":"㵵泻河将渴，飘萧漏未终。\n云峰悬宿雨，月殿闭遥空。\n泾渭千流合，清凉万里同。\n北窗支石枕，秋意满帘栊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26542,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望夕","author":"储巏","text":"暑郁庚重伏，阴疑魄正圆。\n羽虫明可数，萤火暗能然。\n尘土开清景，光华照暮年。\n浩歌追太白，把酒问青天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26543,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"露坐","author":"储巏","text":"曙鼓憎春睡，开窗月已西。\n树高先占鹊，城小尽闻鸡。\n露坐移床久，星言数马齐。\n何时巾栉罢，携酒觅芳蹊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26544,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"入顺义","author":"储巏","text":"眼缬晴初放，心旌暮欲悬。\n柳行聊弭盖，沙渡急回船。\n积水经荒漠，层峰抱远天。\n柴墟它日梦，应到此山川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26545,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过牛栏山追次许给事九日韵","author":"储巏","text":"不识阳坡路，牛山十里迟。\n野阴秋近晦，沙软雨移时。\n石迸千年菊，江涵九日诗。\n凭高怀小杜，此地亦堪悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26546,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"将至清河睡起","author":"储巏","text":"睡醒湖日满，帆影见中流。\n风景犹吾土，妻孥共此舟。\n潮随残夜长，水接远天浮。\n野性依然在，閒飞羡白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26547,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"古城","author":"储巏","text":"古城临水驿，灯火望中微。\n雨夜孤舟泊，江春远客归。\n楚谣多慷慨，汉事惜暌违。\n指点英雄迹，渔樵漫是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26548,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"淮上春晦","author":"储巏","text":"捲幕凉生帢，楚天今麦秋。\n留连淮浦饮，怅望秣陵舟。\n树密藏村墅，湖平见驿楼。\n碧波芳草晚，春亦带离愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26549,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元日雷雨三日雨雪仍雷四日雪","author":"储巏","text":"元日何多雨，才春已荐雷。\n史严宣父笔，诗冷杜陵杯。\n一饱思坡麦，閒吟嗅野梅。\n晴光与淑气，应不待人催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26550,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿龙江驿有感","author":"储巏","text":"旧驿临江浒，开门近翠微。\n忆曾乘月宿，因得趁潮归。\n岁久舲人老，天寒使客稀。\n摩娑庭下树，顿觉壮心违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26551,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"人日雪不止","author":"储巏","text":"入夜飘初急，迟明积已深。\n王春方少雪，人日不妨阴。\n病阻城南步，寒生塞上吟。\n晴郊灯月近，愿听属车音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26552,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别刘东之席上次韵","author":"储巏","text":"我有连城璧，赠君良是轻。\n虚庭扳逸驾，芳宴列华檠。\n山水秦中地，关河岁暮程。\n休歌渭城柳，投老若为情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26553,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冯御史执之贾主事璇同游太明寺 其一","author":"储巏","text":"野寺乘春到，萦纡一径赊。\n风声残叶乱，人影夕阳斜。\n醉墨怀僧壁，歌钟失帝家。\n冯唐多逸兴，随处岸乌纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26554,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冯御史执之贾主事璇同游太明寺 其二","author":"储巏","text":"骋望摅幽抱，兹游良已迟。\n冈峦联楚蜀，台殿阅陈隋。\n云物苍茫外，莺花寂历时。\n谈兵怀杜牧，对酒写乌丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26555,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"驿中会宿别朱亨之用实夫韵","author":"储巏","text":"惜别重行行，高风落雁声。\n野阴朝雨急，江静夜波明。\n弋水旁通越，灵山曲绕城。\n此邦多故旧，送子不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26556,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠周瀛一首仍其喜雨韵","author":"储巏","text":"钟甫后来秀，词林新有声。\n诗随今雨得，画共远山平。\n野寺秋光早，高居夜气清。\n栖迟应不久，名在鲁诸生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26557,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次徐傅赏内閤芍药","author":"储巏","text":"风流独擅玉堂阴，手植当年意已深。\n好是菁华融结地，偏承雨露发生心。\n暗香岂待凭栏嗅，绝品从教按谱寻。\n五色诏成长对此，清平谁羡谪仙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26558,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次杨邃庵先生韵","author":"储巏","text":"五亩阴阴草盖亭，短墙长送半山青。\n篝灯夜几先流竹，洗砚秋池墨污萍。\n赋就每怜司马渴，客来惟爱次公醒。\n黄花莫道真幽独，樽有新醪粟有瓶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26559,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]