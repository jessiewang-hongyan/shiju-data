[{"title":"题萱桂图送徐理之父子","author":"顾清","text":"白头人对綵衣裳，本自无忧不待忘。\n谁写萱花傍丛桂，要看雏凤挹天香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53141,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蒋国器往岁南归予苦头风不得送赋诗有记取他年说今日冷云疏雨出都门之句今再至而归予亦病中天复阴雨俯仰今昔为之慨然","author":"顾清","text":"五载京华两赋归，客心都似宦情微。\n天应有意还留舌，雨亦何心惯湿衣。\n长路不须怀近事，旧题浑已谶先几。\n小昆山下农田早，为想秋风蟹稻肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53142,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐子容祖母寿八十三","author":"顾清","text":"春湖映空光一碧，春日烘云成五色。\n金堂仙人燕王母，云影波光乱瑶席。\n麟洲别来几清浅，兰叶萱枝翠如剪。\n笑轮花甲问东风，八十三年供一莞。\n杨花扑帘春昼迟，鸾笙幻眇朱弦稀。\n瑶环涓秀瑜珥润，戏舞绕膝争含饴。\n就中一孙俊而奇，珊瑚玉树含春晖。\n担簦上国未能去，几日目断孤云飞。\n西风八月仙桂黄，手携鹗书还故乡。\n仙人一笑开北堂，重帘复幔皆天香。\n男儿悦亲宁碌碌，作诗献寿还拭目。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53143,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"邹时鸣父母双寿","author":"顾清","text":"玉陛风光动綵裾，鹊声先已报江鱼。\n鸾回两检新封敕，龙卧三湘旧隐居。\n喜气并添凝望里，宾筵相压小春馀。\n无因得与升堂拜，长傍红云想使车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53144,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"家僮摘槐芽","author":"顾清","text":"小奴携筐绿掩苒，斜日归自东邻家。\n青精未试仙子诀，泠淘的见诗翁誇。\n人间正味竟何在，天地育物真无涯。\n紫莼青荇更不恶，高秋谁泛三江槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53145,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王约赴河间县丞","author":"顾清","text":"平原西北古瀛洲，长记征车半日留。\n山接全燕从地起，河分二水带城流。\n千年王泽诗书古，永日丞厅竹树幽。\n好去王郎更清白，龙门一局未应休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53146,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽苏廷玉","author":"顾清","text":"到处江湖识此翁，几番倾廪惠疲癃。\n灵岩山下一片石，叹息高踪已梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53147,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"何处士赏静亭","author":"顾清","text":"万里松州限蜀川，风流幕府重当年。\n筹边屡上金城略，退食还歌菉竹篇。\n意外云山争自媚，环中风月许谁传。\n瀼西茅屋长邻近，相望孤鸿落照边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53148,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送可晚吴翁","author":"顾清","text":"十里山塘接虎丘，隐翁家近白蘋洲。\n偶来暂别延陵庙，欲去还同孺子舟。\n云里綵衣高捧日，雨中黄菊苦思秋。\n经年正有庭闱念，为酌离觞悔远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53149,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送谢司仓","author":"顾清","text":"宁知信宜邑，乃在古高州。\n地接朱鸢近，天连碧海浮。\n官仓馀火米，土俗罢绵裘。\n莫作炎蒸虑，男儿重远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53150,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书饶贡士友爱堂卷 其一","author":"顾清","text":"江雨红垂荆树花，草堂千里梦京华。\n无人为续池塘句，长向春风忆谢家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53151,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书饶贡士友爱堂卷 其二","author":"顾清","text":"风雨长安旅食孤，夜窗灯火说江湖。\n红尘下马东城路，来看饶家友爱图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53152,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送夏良惠","author":"顾清","text":"君从澄江来，还望澄江去。\n澄江渺千里，孰是君归处。\n连连波上山，历历沙边树。\n长安多亲知，青云在指顾。\n一行拂尘衣，高意竟莫禦。\n淩江望农烟，憩石呼晚渡。\n芳阡笑儿童，佳木散徒御。\n问讯钓鱼竿，汀洲未云暮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53153,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送宋惟德分教池州","author":"顾清","text":"池阳风物似长沙，第一名山是九华。\n输与能诗宋文学，芙蓉影里岸乌纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53154,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王汝昭考绩还南乐","author":"顾清","text":"鸣玉薰风下紫清，日华流采照君明。\n重来一鹗秋期近，暂去双凫晓翼轻。\n封域未踰关辅地，别离无奈故人情。\n归轮入境应频驻，一路棠阴父老迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53155,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送汪县丞还吴兴 其一","author":"顾清","text":"吴绵百箧练千箱，岁占东南第一纲。\n不似朱家贡花石，九重龙衮要文章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53156,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送汪县丞还吴兴 其二","author":"顾清","text":"洞庭烟浪接吴兴，使者归舟画里行。\n浮玉山前万松底，好诗多为别来生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53157,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题李徵伯扇","author":"顾清","text":"新雨蕉叶大，云根生昼阴。\n只此可永日，何必弦鸣琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53158,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题赵希文所藏王孟仁小景","author":"顾清","text":"柳丝如烟散晴风，小桃野树交青红。\n芳洲细草何丰茸，绿波远与青天同。\n遥山西入空濛中，扁舟兀坐谁氏翁。\n物色似是天随公，惊麇骇鹿不可踪。\n此日此意殊从容，自从挟书朝帝宫。\n十年梦寐劳江东，长桥飞盖连垂虹。\n尚想烟雨推孤篷，偶然一笑岂易逢。\n丹青信有缩地功，燕山六月苦蕴隆。\n开轩对此情无穷，谁欤往者吾其从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53159,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送盛世虔兼简严以德 其一","author":"顾清","text":"红云千里隔江关，容易看君独往还。\n留得锦笺无恙在，不教空到小吴山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53160,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送盛世虔兼简严以德 其二","author":"顾清","text":"东河日日望兰舟，远客新年已倦游。\n为忆相逢话京邸，红菱白藕正清秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53161,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书吴通判焚黄卷","author":"顾清","text":"淮甸风烟接海门，甘棠随处绿阴蕃。\n人传旧德歌三异，帝有新恩贲九原。\n华表月明苍树合，宝函春动彩云翻。\n乡人应悔籯金误，衰草荒坟泣断猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53162,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送杨启祥","author":"顾清","text":"杨生画兰近无敌，挥笔使金如使墨。\n玄缯绀楮随所遇，入手光风灿朝日。\n湘江南北几千里，收拾都归笔锋里。\n閒来天上弄秋光，落笔便得天颜喜。\n有时片纸出人间，传看一日遍九廛。\n五侯七贵争莫致，时复挥翰骚人前。\n西风八月吹锦衣，掉手还向江南归。\n汀洲蘼芜寒更绿，木叶时傍孤帆飞。\n回首思君何处切，南薰殿里午风微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53163,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"八月六日周北野宅尊乡会雨不能赴先是予招客亦值大雨","author":"顾清","text":"秋雨亦无赖，偏欺我与君。\n每当开燕日，故作满城云。\n未说初春旱，何如后夜闻。\n一般尤足恨，红湿从伶裙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53164,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孝松为故华亭贰尹吴君赋","author":"顾清","text":"君昔哦松古华亭，我方挟书游县城。\n流风善政尚能忆，未省至孝通神明。\n郎君京华报君讣，握手道边双涕横。\n潜光隐德有如此，如君岂独堪为丞。\n乾坤茫茫日月速，斯人已复从先茔。\n茔前郁郁万松树，总是君手栽培成。\n乡人重君不忍斥，指点苍翠歌仪刑。\n秋霜春雨几悲怆，大篇长句何铿鍧。\n松兮节操本自贞，何幸遇君增令名。\n田家紫荆尚千岁，何况美与参骞并。\n我歌孝松君敬听，古来万化由家庭。\n行将东海甘棠树，并入朱弦流颂声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53165,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乡人徐景晖老而丧子游京师意象悲甚将别赠此","author":"顾清","text":"早向丹山识凤雏，十年清梦隔江湖。\n偶来聚首惊霜鬓，忽漫长歌缺唾壶。\n春雨南洲生杜若，夕阳西崦近桑榆。\n扁舟挥手渡江去，从此人间谢畏途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53166,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东海先生有表弟褚君跛一足先生呼为鹧鸪叟输赋入京求此诗","author":"顾清","text":"有叟有叟名鹧鸪，壮年意气亦豪疏。\n豪行不顾一足拘，苦吟赢得全身癯。\n有儿不令左右扶，独携短筇朝帝都。\n县吏睢盱索官租，儿职催科翁代输。\n输完妇子得宁居，老身健在百不虞。\n西风官亭倾别壶，亭树哑哑啼乳乌，似是忧翁步趑趄。\n乌不能言意有馀，何不啼向吴城隅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53167,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宋宫蹴鞠图","author":"顾清","text":"甲马营中五色光，天将一统付真王。\n后园踏鞠宁为戏，犹有萧娘卧榻傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53168,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画送夏时臣尹龙游","author":"顾清","text":"红叶西风吹客衣，江边行李立多时。\n舟师亦解衢人喜，横棹中流歌竹枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53169,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新安郑氏四节坊","author":"顾清","text":"卫乱共氏理，周兴比干封。\n义节本天授，褒扬系皇风。\n閒披新安志，仰企荥阳宗。\n烈烈四女士，允为男子雄。\n世运有迁革，英风浩无穷。\n高闳丽云汉，大字腾蛟龙。\n在殷比三仁，于宋齐五忠。\n世有长乐老，此地无经从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53170,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送少师谦斋先生致政归义兴","author":"顾清","text":"逢掖登庸玉带归，近来亲见古应稀。\n两朝旧学传黄卷，一代完名映紫微。\n西洛园池增胜槩，东城冠盖掩前辉。\n门墙剩有抠趋地，还许相从认钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53171,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画马","author":"顾清","text":"吴兴公子人中英，文学之外百艺精。\n龙纹鸟迹穷变态，落笔万类无潜形。\n画家难工在狗马，即物计数皆天成。\n平生所见凡几本，如形在鉴影在灯。\n君家此幅得何处，真迹似是来吴兴。\n前行三匹骏且狞，急鞚恐作蛟龙腾。\n一匹顾类未肯行，一匹欲卧垂青缨。\n中间一匹骨如堵，四蹄犹带交河冰。\n紫衫奚官发鬅鬙，胡靴短靿带红鞓。\n当年内厩事毛仲，几随仙仗过华清。\n兴亡百变物尽化，惟有遗迹留丹青。\n摩挲绢素三叹息，毛鬣似觉雄风生。\n君不见千金尚买死后骨，此马此人君勿轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53172,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"塞上谣 其一","author":"顾清","text":"十月龙沙百草乾，嫖姚乘胜逐呼韩。\n关中更有萧丞相，千里无忧给饷难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53173,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"塞上谣 其二","author":"顾清","text":"千顷膏腴紫塞秋，健儿耕作贵人收。\n金城遗迹犹堪按，只在忠良与国谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53174,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题松鹤图为周太守寿","author":"顾清","text":"翩翩双白鹤，飞自瑶台阴。\n玄裳既修整，缟袂亦萧森。\n乔林纵远步，虚壑引清音。\n俛仰各有得，逍遥清涧浔。\n达人事当世，雅志本云林。\n悬车不待岁，戢羽思高寻。\n何异松间鹤，飘飖云汉心。\n嘉诞宾友集，初筵列朋簪。\n鸣丝送旨酒，抗节起高吟。\n白日丽华栋，簪犀炫钩金。\n招要香山翁，笑傲白云岑。\n岁岁但如此，焉知寒暑侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53175,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"邹静修挽诗","author":"顾清","text":"好景耆年正合閒，背堂花竹面楼山。\n祖风田画交游里，家法王凝伯仲间。\n尘梦一宵惊汗漫，舞衣当日记斓斑。\n伤心玉井峰头叶，谁共沧洲载月还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53176,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈清泉挽诗","author":"顾清","text":"短世匆匆春梦同，蜉蝣蜾裸空西东。\n眼中寿考已如此，膝下子孙谁似公。\n纪德前身太丘长，游仙此去云台翁。\n清风来往雁山下，应笑白发悲儿童。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53177,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题姜少卿廷宪墨竹","author":"顾清","text":"草草临池墨，萧萧落叶风。\n高情不可见，怅望越江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53178,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送程克晦","author":"顾清","text":"春阳迟迟风奕奕，滦河潞河冻俱释。\n河边官柳千万株，一一长条曲尘色。\n小车载酒沿堤去，目逐行舟不能住。\n攀条弄色临晚风，却忆前年别君处。\n君家奕世廊庙人，暂蹶霜蹄何足云。\n南山积书充四库，西洛奥旨穷三坟。\n山深昼长风日美，把卷临流思千里。\n有书数寄南来鸿，慎勿待、建邺西风吹桂子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53179,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秦一元自通山尹调归善李文瑞索诗送之","author":"顾清","text":"青云早折桂林枝，鄂渚鸣琴有去思。\n为爱罗浮峰顶月，清光犹得照朱丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53180,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈汝砺宪使自云南入觐升左方伯","author":"顾清","text":"朔云逢入觐，南纪送归藩。\n地昔埋轮旧，官今列岳尊。\n冰霜回晚烈，风日散春温。\n定遣炎州物，秋毫识帝恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53181,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东圃题陈明之菊期南夫二郎","author":"顾清","text":"日出东轩积雪融，菊芽兰茁竞春工。\n君看石畔丛丛碧，已办西风一丈红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53182,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴汝玉自公安赴会试以例格不许","author":"顾清","text":"吴郎自负知何似，一落荆南便十秋。\n夜榻偶然同举酒，春风几处独登楼。\n名场接轸分胡越，剑气中宵看斗牛。\n已识行藏非在我，江湖何地不优游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53183,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月楼为杨尚絅赋 其一","author":"顾清","text":"飞盖桥头踏月华，顺流东去是君家。\n晓风依约凭阑处，隔浦金盆漾浅沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53184,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月楼为杨尚絅赋 其二","author":"顾清","text":"层轩高栋切云浮，纵有阑干不碍秋。\n谁在隔江歌水调，清寒重忆广庭游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53185,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题王敬止所藏陈明之菊二首 其一","author":"顾清","text":"云根翳金英，零露杂芳草。\n忆昨南山行，相逢正秋晓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53186,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题王敬止所藏陈明之菊二首 其二","author":"顾清","text":"王郎东使年，金绯照云海。\n馀辉贲园芳，岁晚犹采采。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53187,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偶书 其一","author":"顾清","text":"万事人间不可期，云中日日候来仪。\n九苞自爱桑榆暖，惭愧西风碧树枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53188,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偶书 其二","author":"顾清","text":"鱼腹隐刀犹可测，牛头有角岂难知。\n寒泉渴饮真破甑，更向青冥学忍饥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53189,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"李方伯挽诗","author":"顾清","text":"玉节新移自汴郊，缄题千里托神交。\n有怀旱岁为霖雨，无地青山酹束茅。\n南楚遗民怨芳草，西江归榇泣潜蛟。\n诸郎不忝长平裔，云路争看丽九苞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53190,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书感","author":"顾清","text":"九十百里半，一篑千仞基。\n少壮必有立，晚节乃堪持。\n感彼日暮者，眷此青阳时。\n婉娈不自爱，瓦裂当告谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53191,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"袁澄夫顾东曙寄诗各次其韵 其一","author":"顾清","text":"夜归连得故人诗，二妙谁令聚一时。\n感旧不知吾慷慨，论才宁合子栖迟。\n花当春半方堪赏，杯到愁来只自持。\n只尺龙潭笑游地，扶摇今日望天池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53192,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"袁澄夫顾东曙寄诗各次其韵 其二","author":"顾清","text":"生世端如雪上鸿，一尊犹记别时同。\n云山有梦寻常到，江水无情日夜东。\n未许文章真我辈，尚馀礼乐待诸公。\n他年只恐西亭鹤，哀怨西风穗帐空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53193,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送胡仲光分务清江浦","author":"顾清","text":"计省郎官白发新，抡才元是玉堂人。\n不将粉黛从时样，尽有风流愧后尘。\n淮海又成千里别，山林犹是十年身。\n秋风会有离群思，还向清江采白蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53194,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送林光甫分教上犹","author":"顾清","text":"行尽西江是上犹，南来五岭入云浮。\n官曹不厌诗书冷，风物且为山水留。\n虚市早春梅子大，畬田初夏稻花稠。\n公馀我欲烦骑马，一访张公铁汉楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53195,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沙阳徐复礼持曹宗孝书来却归省亲还赴南雍秋试","author":"顾清","text":"剑岭西南不断青，七峰罗立凤冈横。\n弦歌里俗誇新尹，江海奇珍见此生。\n远信恰随春雁至，归心先逐暮云征。\n扶摇更觉南溟近，为想西风六翮轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53196,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄寿何以仁御医用匏翁韵","author":"顾清","text":"松间倚几逐阴迁，竹里茶铛扫叶然。\n老去益知閒有味，丹成不恨世无传。\n风尘笑我方为客，云海如君更羡仙。\n翘首碧山丛桂底，一尊相属定何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53197,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送谭贡士拱之入南雍","author":"顾清","text":"陋巷频烦枉刺笺，入门风格故翩然。\n云衢继美看诸父，璧水蜚英及壮年。\n师友尽观南国士，平安时报上江船。\n清秋桂子金陵月，还比长安一样圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53198,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送丁指挥","author":"顾清","text":"丁将军，家习武，身好文，一生读书思致君。\n君门射策不得意，俛著兜鍪发如猬。\n男儿岂必皆明经，叔皮定远俱成名。\n阴山尚有强梁客，听我秋弓霹雳声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53199,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送任希贤分教云和","author":"顾清","text":"古栝风烟接四明，旧家文学最知名。\n承恩尚及青毡在，怀土潜惊白发生。\n春雨菁莪遥送喜，秋风棠棣独关情。\n祗应此后池塘梦，长共飞云绕凤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53200,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题书堂二小画 其一","author":"顾清","text":"收却吴蚕八茧丝，草虫连夜促鸣机。\n内家见此谁能解，游子江南正忆归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53201,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题书堂二小画 其二","author":"顾清","text":"蒹葭倚空未老，蓼花被水初红。\n我觉蜻蜓得意，翾飞来往薰风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":53202,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]