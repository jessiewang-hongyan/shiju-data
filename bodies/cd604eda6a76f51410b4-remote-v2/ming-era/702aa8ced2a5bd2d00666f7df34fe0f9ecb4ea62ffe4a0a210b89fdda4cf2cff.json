689","path":"明_1.csv","pointer":937,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"《绮疏遗恨》之灯擎","author":"唐寅","text":"三尺银擎隔帐燃，欢愉未了散姻缘；愿教化作光明藏，照彻黄泉不晓天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":938,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"《绮疏遗恨》之针","author":"唐寅","text":"乞巧楼前乞巧时，金针玉指弄春丝；牛郎织女年年会，可惜容颜永别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":939,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"《绮疏遗恨》之绣床","author":"唐寅","text":"月沈花谢事堪伤，春树红颜梦短长；只有绣床针线在，残绒留得口脂香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":940,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山水图","author":"唐寅","text":"山回水抱独往，路深树密迷家。\n有客隔林借问，惊禽蹴落藤花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":941,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]