[{"title":"和潘南山山居秋怀","author":"谢迁","text":"落叶萧萧拥暮林，个中行迹杳难寻。\n云连白石南山灿，雨急寒潮西涧深。\n苦思旋添新鬓雪，高怀轻撇旧腰金。\n秋光又到东篱菊，斗酒何当共醉吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13946,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和山亭联句韵答雪湖","author":"谢迁","text":"朝来爽气满西山，山下幽亭称我閒。\n落叶拥阶风扫却，飞花渡水鹿衔还。\n呼童剪棘通虚谷，引杖探泉过浅湾。\n醉后留题向深竹，笑看龙箨解新斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13947,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病目再和山亭联句韵柬雪湖","author":"谢迁","text":"陶翁雅性在邱山，晚岁看山喜更閒。\n三径清阴寒不改，千林倦翼暮知还。\n烟横树杪层分障，风逗溪声几转湾。\n数日养疴深闭户，庭前想见雨苔斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13948,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病目再叠山字韵遣闷柬雪湖","author":"谢迁","text":"老来青眼只湖山，造物何缘妒我閒。\n尘翳本空宁是色，神光不远未全还。\n雾中霜树春三月，云外寒流玉一湾。\n却忆西林有玄豹，寻常欲就管窥斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13949,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻丕儿得请喜而有作","author":"谢迁","text":"停车正自爱秋山，又喜儿曹共我閒。\n牛陇草深将犊卧，鹤巢云暝引雏还。\n樵苏作伴经岩谷，堂构随缘傍水湾。\n寒日茅檐长对面，承欢何用舞斓斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13950,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"补和联句东字韵三首效雪湖作 其一","author":"谢迁","text":"鸿泥踪迹忘西东，旧业归老如梦中。\n漠漠唐虞世已远，悠悠孔墨将无同。\n也知三岛杳难即，但愿一尊长不空。\n咫尺相过亦非偶，望中云树常朦胧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13951,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"补和联句东字韵三首效雪湖作 其二","author":"谢迁","text":"高冈直接扶桑东，小亭新构深谷中。\n主人自愧是逋逸，梅花却与孤山同。\n暗香一派出冰壑，清风万仞凌秋空。\n夜深纸帐眠未醒，角声吹起月朦胧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13952,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"补和联句东字韵三首效雪湖作 其三","author":"谢迁","text":"巢父掉头归海东，宜休亭结梅花中。\n岁寒一节良自许，春意满腔谁与同。\n白鹤放时客在户，翠禽啼处霜漫空。\n素心伊迩每来往，杖藜踏破云朦胧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13953,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重阳和雪湖见怀二首 其一","author":"谢迁","text":"小亭不到又弥月，佳节忽遇倍怀人。\n采芳篱下共谁语，索笑檐前空自巡。\n夙昔远游成汗漫，只今高兴犹嶙峋。\n天留老眼看秋色，杖藜更约双湖滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13954,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重阳和雪湖见怀二首 其二","author":"谢迁","text":"幽斋坐卧养衰疾，知天久矣宁尤人。\n未容白发便千丈，谁说愁肠时几巡。\n红树夕阳竞烂熳，碧山秋气增嶙峋。\n乾坤胜景肯辜负，还拟寻芳穷水滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13955,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再叠前韵酬雪湖","author":"谢迁","text":"少陵有诗驱疟鬼，公诗亦合传万人。\n病眸真与缄并启，笑口不知杯几巡。\n西郊停云树杳霭，东篱采菊山嶙峋。\n芙蓉炤水秋未老，濯缨还共沧浪滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13956,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病目初愈用前韵写怀","author":"谢迁","text":"经旬伏枕谢尘俗，竟日冥心怀古人。\n韦编逊志未三绝，泗水寻芳时一巡。\n静掩衡门遂潦倒，回思阿阁渐嶙峋。\n东窗晴旭炤蓬鬓，起来独步秋涧滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13957,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十月三日会冯雪湖潘南山于牛屯山庄夜宿次联句韵三首 其一","author":"谢迁","text":"山前款段踏霜来，一笑迎门望眼开。\n会老纡徐重负约，登高强健尚能陪。\n鬓随年改缘多病，志与时乖愧不才。\n谩向空林叹摇落，寒香伫看绕亭梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13958,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十月三日会冯雪湖潘南山于牛屯山庄夜宿次联句韵三首 其二","author":"谢迁","text":"溪头坐对夕阳明，风叶随人似有情。\n松菊未荒归老地，鹭鸥曾结洗心盟。\n潭凝潦水连天碧，山抹晴岚隐树平。\n邻叟好怀晨馈鲤，浊醪呼取尽馀觥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13959,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十月三日会冯雪湖潘南山于牛屯山庄夜宿次联句韵三首 其三","author":"谢迁","text":"风珰入夜杂松涛，旋摘佳蔬荐白醪。\n林下胜游重结社，灯前衰影旧同袍。\n月明野渡渔歌杳，露落孤桐鹤唳高。\n酒醒山堂尘虑寂，熟眠不遣梦䰟劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13960,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠屠太宰被召北上","author":"谢迁","text":"白云岭上不堪持，携手河梁酒一卮。\n镜水稽山方有待，秋鸿社燕杳难期。\n先朝燕翼馀耆旧，今日龙光重倚毗。\n当道故人如问及，为言多病已成衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13961,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪湖见过冒雨而归漫成一律奉寄","author":"谢迁","text":"海风吹雨昼霏微，瘦马冲寒薄暮归。\n信宿未偿东道约，晨昏真念北堂违。\n春晖寸草心良苦，晚景黄花会亦稀。\n望望湖堤乌帽远，湿云停处雁低飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13962,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和雪湖长至感兴","author":"谢迁","text":"忽漫归田又一年，故乡风物总依然。\n履长自喜迎新庆，怡老惟应续旧缘。\n曝背南檐真负日，举头北极远瞻天。\n草深径路关重闭，疏拙生涯静独便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13963,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又和方桥道中见怀之作用前韵","author":"谢迁","text":"方桥徙步记当年，今日经过一怆然。\n老去杜门深避俗，閒来命驾偶随缘。\n乘桴嗤我从浮海，鍊石凭谁诧补天。\n邂逅行窝仍一笑，联床剪烛话心便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13964,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪湖冒寒西归用前韵奉怀","author":"谢迁","text":"两人相对各衰年，羡子清癯独竦然。\n振策远犹轻步履，据鞍高不废攀缘。\n潇潇风雨冲寒地，渺渺村墟向晚天。\n怪底王猷夜乘兴，雪舟自与苦吟便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13965,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"閒居遣兴二首用雪湖韵 其一","author":"谢迁","text":"园田归老幸逢年，邻曲相看每粲然。\n素食半生违夙志，黑甜一枕遂良缘。\n絪缊野马窗前日，嘹亮宾鸿雪后天。\n漫取南华经细读，閒居惟有养生便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13966,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"閒居遣兴二首用雪湖韵 其二","author":"谢迁","text":"百事无营学引年，虚窗生白思悠然。\n韦编课子供消日，竹院逢僧话结缘。\n山径半坡黄犊草，湖波千顷白鸥天。\n蓝舆画舫时乘兴，光景无边意总便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13967,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山园见梅用前韵柬雪湖","author":"谢迁","text":"山雪初晴欲暮年，蚤梅花共雪纷然。\n茅亭佳景新成趣，纸帐清香旧有缘。\n白鹤步虚檐外月，素娥妆倩洞中天。\n赏心应有凌寒客，杖履来过野兴便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13968,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"叠前韵","author":"谢迁","text":"村居腊尽未知年，忽见梅花一惘然。\n高咏尚馀东阁兴，幽期不负北山缘。\n香凝夜壑留残雪，影落寒潭炤远天。\n漫论调羹须结实，乾坤清气久相便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13969,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏梅再叠前韵二首酬雪湖 其一","author":"谢迁","text":"梅花契阔几经年，归见梅开倍怅然。\n墙角一枝劳梦想，岁寒三友结心缘。\n画屏香细春藏坞，羌笛声高月在天。\n踏破石崖看不厌，雪中驴背兴犹便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13970,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏梅再叠前韵二首酬雪湖 其二","author":"谢迁","text":"手植寒梅不记年，年来珠玉竞森然。\n溪山入画真全景，雪月如期本夙缘。\n仙种旧分清绝地，疏枝遥倚泬寥天。\n任教桃李争春色，冷淡风光性自便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13971,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"祠堂新构用雪湖韵述怀二首 其一","author":"谢迁","text":"白屋栖迟本固穷，青云寥廓误登崇。\n永思端荷流光远，优典真逢泰运隆。\n温饱平生俱分外，孝忠两字只胸中。\n同休愿效华封祝，国祚无疆日正东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13972,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"祠堂新构用雪湖韵述怀二首 其二","author":"谢迁","text":"陋巷萦回路不穷，庭槐阴护短墉崇。\n苟完愧我培基浅，元吉从天藉栋隆。\n享祀有仪还道古，音容无地每虚中。\n春光又喜生门户，昨夜遥瞻斗柄东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13973,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄母舅教授","author":"谢迁","text":"停云霭霭夕阳斜，路入西川望眼赊。\n丹药未成难却老，锦城虽好不如家。\n东风门巷重栽柳，逝水年光几及瓜。\n酒熟山中春又到，何时相对看梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13974,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"腊月十八日与冯雪湖潘南山会宿山亭次韵联句 其一","author":"谢迁","text":"屋角梅花映雪清，石头路转入云平。\n盘餐供客聊随分，箕踞看人直任情。\n侵晓开笼閒放鹤，先春荷锸漫移橙。\n素心良会频难得，深夜清樽待月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13975,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"腊月十八日与冯雪湖潘南山会宿山亭次韵联句 其二","author":"谢迁","text":"菊枕藤床午梦清，起来江上晚潮平。\n酒杯到我偏无分，丘壑于今胜有情。\n稚子篱根迷旧竹，木奴霜后压香橙。\n剡川一曲春长满，合与知章老四明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13976,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"叠前韵酬雪湖","author":"谢迁","text":"两湖流水接天清，十里湖堤入望平。\n诗札往还如索债，岁华更代总忘情。\n酒须家酿多栽秫，果杂村柈或荐橙。\n石鼎一篇殊未巳，春宵灯烛待弥明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13977,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"生辰辱雪湖贺章依韵奉答","author":"谢迁","text":"流光荏苒仍初度，世路优游愧此生。\n身健不嫌双鬓短，岁寒惟守寸心贞。\n醉乡高卧宜衰晚，寿域宏开荷圣明。\n珍重故人来远祝，鹤南飞共雪梅清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13978,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小除日赴县习仪途中有感","author":"谢迁","text":"去年此日始还家，转盻乾坤又岁华。\n犹记行装迟暮雨，喜看野色炫晴霞。\n缠腰人诧能骑鹤，添足吾惭学画蛇。\n漫向东风閒索笑，寒梅疏傍竹篱斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13979,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和雪湖元日纪兴","author":"谢迁","text":"笑看儿孙绕膝前，满斟椒酒庆新年。\n任教白发持公道，久与红尘谢俗缘。\n野老平安山竹报，江春消息陇梅传。\n扁舟莫负寻芳约，万顷晴波足剡川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13980,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和雪湖人日见怀","author":"谢迁","text":"晓来群鹊绕檐前，报道今年胜去年。\n柳眼送青如有约，鬓丝添白岂无缘。\n桑田夜雨催星驾，诗礼家风习旧传。\n会待春深试春服，与君相伴浴沂川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13981,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和潘南山新春之作","author":"谢迁","text":"崔巍黄道自天开，婉娩青阳蓦地来。\n冰泮河流鱼欲上，雪晴沙渚雁初回。\n行逢新岁虚增算，惭负先皇误育才。\n忧国寸衷殊未泯，愿看玉烛炤春台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13982,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和雪湖山庄有怀","author":"谢迁","text":"探春拟上最高峰，数日春寒意尚慵。\n阴壑流澌馀旧雪，湿云将影落疏松。\n人间元夕哗灯市，天外新晴报寺钟。\n选胜寻芳频有约，吟鞭到处愿追从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13983,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"教授舅还自蜀遇于越城喜而有作用前韵","author":"谢迁","text":"酒旗摇飏柳枝斜，邂逅山城酒漫赊。\n宦海十年甥念舅，春风万里客还家。\n白云岭岫多藏药，灵雨园田蚤破瓜。\n杖履从今共行乐，比来双眼欲生花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13984,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"越城览胜六首次雪湖韵 其一 登蕺山","author":"谢迁","text":"散尽春阴万象融，蕺山高起跨垣墉。\n戒珠寺古遗荒径，洗砚池深映远空。\n上界梵钟将入定，小桥角扇尚清风。\n蓁芜不独兰亭胜，千载斯文感慨同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13985,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"越城览胜六首次雪湖韵 其二 游梅山","author":"谢迁","text":"野寺晴钟出远林，仙家遗迹古犹今。\n断桥对峙清溪曲，小径斜通绿树阴。\n望入市门劳企想，坐来丹井动豪吟。\n卜居便欲从兹始，且共山僧话洗心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13986,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"越城览胜六首次雪湖韵 其三 游阳明洞","author":"谢迁","text":"溪桥过雨路初乾，步入阳明眼界宽。\n酒瓮峰回开罨画，羽衣人去剩还丹。\n青鞋布袜真乘兴，野蔬山肴漫合欢。\n尘虑顿空留竟日，不知三岛在人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13987,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"越城览胜六首次雪湖韵 其四 登龙山","author":"谢迁","text":"迤逦冈峦隔市尘，嵯峨台殿集高真。\n天低象纬先分曙，地接蓬壶独驻春。\n大府建牙森棨戟，仙坛煮石足荆薪。\n满前多景真奇绝，老眼于今又一新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13988,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和答陆静之太守二首 其一","author":"谢迁","text":"客怀十载系山阴，世路纷嚣不耐侵。\n道与志同宜结社，病随年至即投簪。\n乾坤俯仰皆陈迹，丘壑优游足赏心。\n见说兰亭旧风景，尚馀修竹茂成林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13989,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和答陆静之太守二首 其二","author":"谢迁","text":"春雨初晴起晏眠，韶光凌乱逐吟鞭。\n软红尘土今无梦，晚翠林峦旧有缘。\n野渡潮平鱼艇集，杏村风煖酒旗悬。\n与君重订寻芳约，班白相随不偶然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13990,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"酬雪湖见怀二首用陆韵 其一","author":"谢迁","text":"转眼红芳又绿阴，游丝飞絮漫相侵。\n衰颜未必输青镜，短发惟应怯旧簪。\n坐待白云归洞口，卧看明月到天心。\n怀人正复劳倾企，啼鸟嘤嘤隔远林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13991,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"酬雪湖见怀二首用陆韵 其二","author":"谢迁","text":"小斋无事足春眠，乘兴寻芳偶著鞭。\n苔石漫供醒酒具，鸥波重结洗心缘。\n东园桃李迎风笑，别壑藤萝带雨悬。\n相伴浴沂惭负约，湖边凝睇思悠然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13992,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三月十四日贾汝易冯雪湖同过山亭小饮次联句韵","author":"谢迁","text":"振衣同上白云岑，宿雨初晴春正深。\n流水落花纡曲涧，煖烟芳草护长林。\n雩风入咏聊言志，园景凝眸总会心。\n犹道馀芳在幽壑，杖藜徐步漫追寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13993,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三月廿日王龙山太宰偕雪湖见过次联句韵","author":"谢迁","text":"倒屣衡门迓故人，翛然风采共清真。\n解衣呼酒春方熟，策杖看山晚更新。\n三益有怀开径竹，八珍无谱荐溪蘋。\n閒身总是鸱夷侣，同泛扁舟莫厌频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13994,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答表弟昕二首兼柬廷臣舅 其一","author":"谢迁","text":"尘缨原不耐羁縻，旧隐归来已负期。\n适意漫怜孚蜡屐，任真翻笑墨悲丝。\n端居閒静聊观物，饱饭优游只和诗。\n更是溪山看不厌，披云寻月每忘疲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13995,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答表弟昕二首兼柬廷臣舅 其二","author":"谢迁","text":"懒性年来幸脱縻，白头行乐遂心期。\n春深绿野双吟屐，雨后沧江一钓丝。\n却老荐添栽药圃，素餐犹愧伐檀诗。\n渭阳时有过从兴，只恐肩舆仆告疲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13996,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"四月十五日会雪湖于牛屯山庄次雨中联句韵","author":"谢迁","text":"白石岧峣绿树重，雨中烟景淡还浓。\n远鸡报午迟村馌，灵谷占晴急梵钟。\n苔径行踪双屐补，竹窗吟料四山供。\n劝农已见循良令，匹马西来一鹤从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13997,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五月初七日恭遇先帝忌辰不胜悲恸强成一律用写哀悰","author":"谢迁","text":"翘首玄云暗鼎湖，馀生无路谒楸梧。\n忧深漆室心如醉，泪尽乌号眼欲枯。\n老病自惭孤末命，梦魂犹忆赞吁谟。\n黄扉残稿俱零落，无逸惟存旧献图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13998,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次雪湖韵魏二尹乃兄还维扬","author":"谢迁","text":"惆怅宫亭柳一枝，客乡离合杳难期。\n路当树与云深处，舟及潮随月上时。\n棠棣分阴遥伫立，鹡鸰声急苦萦思。\n背萱却喜春光满，归去高堂捧酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13999,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五月十二日与雪湖南山避暑山亭次联句韵二首 其一","author":"谢迁","text":"缃帘高捲北窗凉，茗椀时分石鼎香。\n水荇受风牵舞藻，路槐穿日间垂杨。\n清虚未必输三岛，笑饮何妨累十觞。\n野蔬山殽兼海错，不嫌粗粝待君尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14000,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五月十二日与雪湖南山避暑山亭次联句韵二首 其二","author":"谢迁","text":"几席频移趁绿阴，倍因逃暑爱林深。\n偶逢白石堪投足，漫和沧浪惬洗心。\n绕屋桑麻迷远近，当筵瓜果任浮沉。\n及时行乐聊乘兴，却怪癯翁太苦吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14001,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五月初四日游永乐寺次联句韵呈同游冯雪湖魏邦直牧时庸诸君","author":"谢迁","text":"乘兴聊同汗漫游，江边人诧谪仙舟。\n山围上刹昙花杳，地近中天颢气浮。\n镜水风流真未减，兰亭禊事合重修。\n坐来顿觉烦歊净，却讶松涛万壑秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14002,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汪公溥挽诗","author":"谢迁","text":"浏阳遗爱至今存，阴德真宜裕后昆。\n都水有声分汉署，驷车何意负于门。\n渊源家学非绵蕞，清苦官箴只菜根。\n三世交情悲契阔，临风聊为赋招魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14003,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宾阳轩为杨仲谨作","author":"谢迁","text":"华轩高启面隅夷，似与朝阳宿有期。\n海曙未分虚席久，檐暄欲满上阶迟。\n门深屏障攒朱槿，市远盘餐胜露葵。\n我亦频过候曦驭，不辞倾倒卯前卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14004,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忧旱次冯絅之韵","author":"谢迁","text":"五月粜新颙望岁，恒阳为虐重伤秋。\n茫茫赤地尘千里，贸贸苍生泪满畴。\n杼轴已空那忍见，江湖未远敢忘忧。\n天瓢一滴谁能挽，会使沾濡遍九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14005,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜雨用前韵","author":"谢迁","text":"焦枯久渴云霓望，一雨如膏尚及秋。\n卧听欢声动比屋，起看生意满平畴。\n至诚真应桑林祷，衰病全忘杞国忧。\n更愿皇天均霈泽，直从濒海到神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14006,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]