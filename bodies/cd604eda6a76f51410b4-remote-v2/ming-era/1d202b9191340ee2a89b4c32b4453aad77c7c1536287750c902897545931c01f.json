[{"title":"答李鳌峰别驾二首 其二 答天关","author":"湛若水","text":"大隐羊城过几寒，两湖三岛怕人看。\n欲移枕席无人地，直向祝融峰嵿安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送大理司厅林艾陵考满复职之留都","author":"湛若水","text":"庄渠闻说道其东，忠信惟君独得宗。\n廷尉北门重锁钥，青天白日送人龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书扇寄严东楼司空年侄","author":"湛若水","text":"子能干父父恭君，圣谕江湖亦远闻。\n忠孝一门须刻骨，老夫题箑播清芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏书天真上人所携罗念庵诗卷及楞严经解","author":"湛若水","text":"达磨西来无一字，空馀只履西归时。\n空来空去空家宝，更数他财作甚为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南昌吴一舟送鸣鹤赋之","author":"湛若水","text":"昂然独立我庭隅，海客携来伴老夫。\n折翼天门终有疗，凡今未有楚胡卢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠钟君斑田宪副之广右","author":"湛若水","text":"海内几家三世好，广文令祖况同年。\n叔参蓄木不肯用，历扬中外发斑田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘生象龙行","author":"湛若水","text":"博施济众唐虞病，枯槁焉能活辙鳞。\n满载空言无水菽，飞书留馆两候仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题翁东白别号","author":"湛若水","text":"邻翁能爱东方白，喜忆通宵海底明。\n祝融夜见浮金晕，玉色祥云捧日精。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读冬官卢冠岩兴国生祠碑","author":"湛若水","text":"岿然屹立此何为，先有民间口作碑。\n百世循良谁续传，青天白日照生祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"续得蒋道林书付鹑野来者颇异之欲条答病未能小诗书扇代启三首 其一","author":"湛若水","text":"毁誉存亡破两关，超然自在出人寰。\n耄期觅我身无见，得失从谁作往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"续得蒋道林书付鹑野来者颇异之欲条答病未能小诗书扇代启三首 其二","author":"湛若水","text":"道大难容吾岂敢，和光瓦合讵吾情。\n孔孟共憎乡愿媚，乡评中半是中行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"续得蒋道林书付鹑野来者颇异之欲条答病未能小诗书扇代启三首 其三","author":"湛若水","text":"大圣方人犹不暇，日乾夕惕法天行。\n老婆老去心能切，口耳劳劳只送迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小诗代启通谢南北祝寿诸贤","author":"湛若水","text":"定超六合到生生，贤哲三千祝永龄。\n短世息存吾守一，乾坤不管共清宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄何前溪","author":"湛若水","text":"前溪之外是前川，傍柳寻花我宿缘。\n天与不忘公德处，昏期通变有曾孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题扇寄何上舍","author":"湛若水","text":"何曾二子游杨辈，霜雪青霞候我门。\n可是行云无定迹，东风招手白云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"走笔谢邓念斋太守惠佳荔","author":"湛若水","text":"荔枝三百坡翁啖，四百笼来何太多。\n颗颗念翁二百遍，白云还写谢公歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢江右陈医昭送五品妙丹","author":"湛若水","text":"禺山过我坭丸子，分惠医身五品丹。\n我有医心丹未试，凭君传播到人寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吊厓次邓念斋韵兼呈何善山大尹诸君","author":"湛若水","text":"负帝元臣已赴波，天时人事奈之何。\n江边奇石阅时旧，厓下悲风感客多。\n万古精忠悬日月，中华大道自江河。\n诸君剩有纲常意，俎豆重开剪薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南岳书院枕上偶次应谨庵督学韵二首 其一","author":"湛若水","text":"三径低回双豸入，一心灯火四人同。\n天留好客须微雨，风捲残云邮一松。\n灵药由来知有待，诸天此去尚无穷。\n公程王事无休日，骏马轻蹄只欲东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南岳书院枕上偶次应谨庵督学韵二首 其二","author":"湛若水","text":"万云长锁祝融峰，千里谁教笑语同。\n高翮岂能留白鹤，小堂元未有青松。\n墨流枉自悲丝染，阮籍空闻哭路穷。\n别鹤试弹弦尚涩，停云遥望送之东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别衡山唐石泉二首 其一","author":"湛若水","text":"何处名山可遁藏，紫云天柱寄山堂。\n清风明月为衾枕，阖辟乾坤共弛张。\n静笑千峰生雾霭，声闻十里如鸾凰。\n五峰已入烟霞癖，说著还家似断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别衡山唐石泉二首 其二","author":"湛若水","text":"井地来时许共耕，八家同井作人情。\n约筵消得公田入，木铎恭听圣教鸣。\n灵鸟歌时红药舞，钧天奏罢紫云生。\n朱明主亦朱陵主，两洞閒云互送迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中即席和答何艮所明府","author":"湛若水","text":"循吏千秋无续传，凤凰今复见鸣时。\n莫言王道人心远，且听民谣载路辞。\n一曲新诗闻沕穆，三杯立地到希夷。\n典刑乡里孤踪在，清献当为百世师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答邓梅坡先生","author":"湛若水","text":"与尔同庚三十许，江门风咏亦同春。\n殊途达塞都归梦，到底江山不负人。\n肯信太山无绝顶，更开云谷了閒身。\n昨来耻独终行独，槁坐樵云只忆君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病枕和答高明黎君民怀问安","author":"湛若水","text":"短长昼夜岂须惊，长与天清与地宁。\n逆旅岂无诸客过，大冬谁信一花荣。\n形神葆合元来相，亥子调和太一羹。\n造物小儿何促狭，几旬来苦老先生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答少参王敬所访黄龙洞天华书院","author":"湛若水","text":"黄龙昔绕天华宫，龙去宫空石几重。\n千载四贤开俎豆，九天万里闻声钟。\n说惺说梦嗟人世，无助无忘有圣功。\n多谢登歌水月句，淩风飞锡未来同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答文衡山内翰韵","author":"湛若水","text":"紫云洞口紫云台，居士前身亦姓回。\n半夜长庚骑鹤过，五峰明月待公来。\n三月二月春之半，千山万山花正开。\n独立乾坤谁伴侣，及时相赏共追陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙卯元日祝圣台即事步介翁大学士自述韵","author":"湛若水","text":"登台躩跞喜胡然，九十逢元祝圣天。\n炙背熙熙同舜日，齐声万万颂尧年。\n列宿中天扶帝座，从吾平地作神仙。\n明良相遇真难得，九五飞龙应在田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送符生士亨还南昌三章 其二","author":"湛若水","text":"出门多路岐，行行慎所之。\n古人千里谬，所差在毫釐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送符生士亨还南昌三章 其三","author":"湛若水","text":"江风送子来，新月迎子归。\n风月同自然，吟弄亦奚为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"示学六言赠六安潘汝中黄门","author":"湛若水","text":"随处体认天理，六字千圣周行。\n万里一心感应，虚灵中正观生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"富良歌","author":"湛若水","text":"乘玉节兮坐王子舟，披霞缨兮云裘。\n击兰浆兮泛中流，冯夷舞兮蛟人游。\n草萋兮荒洲怅，独立兮容与，望五云兮神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即席送陈梓卿归省携侄来山","author":"湛若水","text":"太丘子弟，从宝潭来。\n来时一念，自天先开。\n河源涓治，到海不回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"始居朱明洞馆示洗奕倩秋官刘应言贰尹诸子","author":"湛若水","text":"畴昔访朱明，淩晨斯板筑。\n不谓四无邻，山深又多木。\n兹予入宅初，朋从宵秉烛。\n就榻拥被吟，病惫欣自足。\n自足夫何为，我生得初服。\n玉女峙北方，麻姑在西麓。\n暇蟆岌南临，呵禁护我屋。\n东海洪涛舂，鸡鸣观日浴。\n闲从素心人，时来道心曲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有怀南岳之约作诗酬觉山侍御","author":"湛若水","text":"故人知我趣，与我衡山行。\n六翮生长风，意气倾洞庭。\n北斗垂清光，南山入紫冥。\n揽结兼两室，朱明与朱陵。\n优游寻五峰，玩心于神明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"衡山不远","author":"湛若水","text":"尧舜应不远，羹墙即躬逢。\n宇宙应不远，万里方寸同。\n衡山应不远，见之悠然中。\n即此不远心，大道立可通。\n八极周瞬息，何必骑苍龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将之南岳登岸渡武溪过芙蓉寄觉山","author":"湛若水","text":"驱车渡武溪，路过芙蓉西。\n忆我去年游，旧路意皆迷。\n去年今年人，王孙芳草萋。\n有风东南来，飘飘吹我衣。\n万里谁云远，寸心以为期。\n起脚即已到，岳岭同天齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至梯上山麓将登矣忽为大雨所阻及乏仆夫而还作诗讼梯上神","author":"湛若水","text":"我闻梯山险，石磴过百盘。\n如架淩云梯，平地入天门。\n山高岂无灵，感应讵不神。\n七十轻千里，一念衡山勤。\n水深石齧趾，历途百邅迍。\n胡为纳大麓，云雨骤漫漫。\n仆夫欲号泣，羸马拥不前。\n迥驾亦不易，胜事徒空言。\n我匪昌黎子，尔愧衡山云。\n吾将愬厚地，巫成扣天阍。\n嗟予不度此，命也亦已焉。\n不见临河叹，遗响垂千年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南岳访胡致堂五峰兄弟故居","author":"湛若水","text":"不见李泌居，懒残煨芋处。\n五峰旧址存，问讯祠前树。\n优游南山下，寒暑三十度。\n玩心何神明，玩者是谁作。\n请君一转语，吾当执杖屦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送方金两生还福山诗","author":"湛若水","text":"二子何翩翩，负笈路四千。\n奈何为势拘，阅月上归船。\n安得效缩地，相见顷刻至。\n万里即跬步，相见如梦寐。\n我有缩地方，见尧在羹墙。\n念兹倏在兹，何忧山水长。\n人为天地心，无上下古今。\n一体能感应，何远近高深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四居吟","author":"湛若水","text":"春宜居罗浮，冬宜居甘泉。\n夏宜居西樵，秋宜居天关。\n何以谓之宜，顺气无乖愆。\n罗浮春花发，西樵夏木蕃。\n天关秋水清，甘泉冬背寒。\n四时运无穷，吾以了吾缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮冼少汾氏鹤园观烟火有感似同志","author":"湛若水","text":"名园开午宴，入夜坐星轩。\n烟火观气机，有若天使然。\n人乃夺天巧，天人无后先。\n平空作雷电，花鸟争喧妍。\n万有生于无，人事何足怜。\n风波起平地，毁誉虚相传。\n周孔大圣人，流言悄忧心。\n哲人善自释，赖古多此贤。\n万变如是观，而我无事焉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初宿仰圣楼","author":"湛若水","text":"小楼依白石，且近周公涯。\n溪水迎门入，贾舫趁潮回。\n闹市可安禅，缘未学如来。\n因寻周公梦，来者犹可追。\n一日供偃仰，明日非所裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将入朱明宿源头精舍","author":"湛若水","text":"到岸宿源头，源头乃吾庐。\n自兹达朱明，近可卅里馀。\n插柳妨前江，围竹背后畲。\n八十已任真，藩篱知有无。\n未计明日事，日夕相与娱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自挽诗","author":"湛若水","text":"入山取椑随，为待终焉翁。\n翁年八十一，三万化日中。\n即尽亦已足，无复芥心胸。\n昨闭烟霞关，悭不与人同。\n今归天堂土，骨肉等蒿蓬。\n毁誉满天下，同时并成空。\n但恨在生时，所志末由从。\n为子未尽孝，为臣未尽忠。\n致君本无术，为民没成功。\n毁方愧瓦合，直行悲途穷。\n今则誓长往，聚散大化工。\n天道尚去来，人理有始终。\n何哉失声哭，虑师迷去踪。\n贤者或筑室，送客各西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸡鸣一章示诸生","author":"湛若水","text":"鸡鸣起为善，拥衾坐中思。\n乘此夜气生，丕显亦无为。\n汤周云待旦，待之乃何施。\n不待以不先，从心任化机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自寿且酬三十子寿觞","author":"湛若水","text":"生年八十一，八十能知非。\n秋瓜未脱蒂，多年亦奚为。\n所幸男子身，聪明无损亏。\n又幸生中国，四朝全盛时。\n收身自卿相，归来学鸱夷。\n朱明与朱陵，洞天随所之。\n挈家入烟霞，永谢世危机。\n又幸得其门，入室似有期。\n自兹超六合，无论到期颐。\n试与诸贤约，且作廿年规。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与郑孔新","author":"湛若水","text":"孔新爱我字，字者心之画。\n心苟有神妙，不画亦自得。\n由画以得心，立造神妙域。\n氤氲初沐时，太和未鸟迹。\n吾欲斩茅根，同子坐端默。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与秦幼贞","author":"湛若水","text":"吾闻有神马，一日能千里。\n历块以过都，追风飙忽耳。\n秦子千里驹，龙胎忽堕地。\n简易受道资，无言自超诣。\n诸侯不能友，天使不能致。\n卜筑从云谷，终始以为志。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"日一梳头","author":"湛若水","text":"三日一梳头，父老笑予懒。\n鸡鸣闻栉洗，无乃公太简。\n予答父老言，太简敬之反。\n有一俨于中，若懒元非慢。\n遇利懒于货，遇色懒于娴。\n懒为德之助，天地同坦坦。\n天地既简易，吾驾不可返。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舆疾如罗浮赴约","author":"湛若水","text":"初定居樵钓，足迹不下山。\n惟有罗浮念，未能断往还。\n今晨妨蹇足，自往谁作难。\n挥手拨云破，舆疾出三关。\n有约汾江彦，无负古林贤。\n人道在忠信，心期安可愆。\n能办千里志，跛鳖到无前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜报洪觉山方时素将至樵","author":"湛若水","text":"二妙福山秀，一身当三千。\n潜心已深造，况乃得其门。\n路远梦魂惫，不见八九年。\n其人天下士，其学百世传。\n谁谓室是远，索我樵云巅。\n初闻喜不寐，所喜非寒暄。\n此道期坐进，共入无穷天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同洪觉山方时素与曾廓斋为罗浮之游遂饯别江门钓台因以为赠","author":"湛若水","text":"前日迎二妙，今日迎五马。\n相见十年馀，乐意满天下。\n今日送五马，明日送二妙。\n聚散罗浮云，令我心悄悄。\n我心悄以豫，大道无来去。\n饯别江上台，江水常流注。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同方时素洪觉山曾廓斋何悔斋李中冈冯左山郑孔新邓粤良罗浮行望见云阴停驻不散久之即天华精舍也","author":"湛若水","text":"罗浮岂云远，飞盖忽神游。\n此神岂在远，只在我念头。\n天字晴光散，天尽云阴浮。\n中有彩霞屋，花卉无冬秋。\n问之此何境，不答意悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠洪觉山方时素归福山五首 其一","author":"湛若水","text":"行行重行行，行行过峡山。\n登山望所思，大科霄汉间。\n霄汉岂云远，见之在不迁。\n纷纷怅离别，浩浩元同天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠洪觉山方时素归福山五首 其二","author":"湛若水","text":"行行重行行，行行度庾岭。\n是为人鬼关，平地戒深阱。\n使君有感通，白猿出相迎。\n感通亦何为，不迁乃有定。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠洪觉山方时素归福山五首 其三","author":"湛若水","text":"行行重行行，行过十八滩。\n一滩度一劫，见月出平澜。\n夷险一不迁，心亨无所难。\n我曾此放歌，兹以为君言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠洪觉山方时素归福山五首 其四","author":"湛若水","text":"行行重行行，行经铁柱观。\n为问锁蛟人，飞升乃何岸。\n滕王迹已空，苏张隔湖畔。\n谁云死不亡，啸歌复长叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠洪觉山方时素归福山五首 其五","author":"湛若水","text":"行行复行行，行行入星源。\n到岸不用船，拍手飞青天。\n归来闭关坐，默成在无言。\n无言天至教，四时以行焉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游小华山","author":"湛若水","text":"小华与西华，大小何所分。\n究竟西华月，亦是小华云。\n云月无疆界，南北本同天。\n无穷天理教，突过希夷前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同道林诸贤天关泛舟","author":"湛若水","text":"天关天所裁，白云从天来。\n一水暗入城，群山为之回。\n天池宜泛舟，大风无怒涛。\n因动五湖恩，吾岂鸱夷俦。\n急桨花在后，缓桨花无有。\n忘情缓急间，不觉花在手。\n寄语同舟人，一任操陀叟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西樵与蒋道林诸游者","author":"湛若水","text":"西樵等山耳，君来四千里。\n一来即一去，去来有何意。\n大科见日台，共坐了大事。\n收拾到山时，明日书难寄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新创天阶精舍作","author":"湛若水","text":"樵麓有高峰，大科之初程。\n峨峨入云汉，天柱同峥嵘。\n于兹作小歇，天阶何乃名。\n人谓天盖高，无阶不可升。\n岂知得其门，无穷吾可陵。\n举足踏半云，倏然羽翰生。\n披云逐日月，超然忘故身。\n天道无声臭，神游不在形。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":58267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]