ommit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42463,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答文定上人 其一","author":"陈献章","text":"千金帖子忽飞驰，洗手开缄只汗颐。\n前代昌黎今我是，恍然海上记留衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42464,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答文定上人 其二","author":"陈献章","text":"神交今在识荆前，再结前生未了缘。\n果蒙道力相扶起，蚤晚东林对长官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42465,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"钟太守美宣挽 其一","author":"陈献章","text":"诗人自古例多贫，恨杀滇南金带新。\n公与定山贫到老，已有陈黄一辈人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42466,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"钟太守美宣挽 其二","author":"陈献章","text":"天下功名无我关，只缘我自爱江山。\n若对江山元没兴，纸钱灰冷未知閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42467,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梦游衡山遇南极数老人来过却须先生作主与诸老对酌洪崖寿崖在旁歌诗以侑觞合坐皆喜予以诗一首识兴云","author":"陈献章","text":"衡岳去天能几何，一株松下月明多。\n南极老仙骑鹿过，一瓢斟月两崖歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42468,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题任明府思亲楼卷用定山韵","author":"陈献章","text":"人间何处不楼居，亦有如椽大笔书。\n定山丈人都不管，一拳不屑老何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42469,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"碧玉楼昼梦扶病出游村径甚适忽安福罗进士携彭秀才来访遂书以赠之","author":"陈献章","text":"春早春寒著莫人，黄鹂啭处暖初匀。\n狂心刚被风吹动，走遍南垞到北津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42470,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泉石为顺德张氏题","author":"陈献章","text":"江山几处堪还我，泉石边头合有人。\n高著一双无极眼，闲看宇宙万回春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42471,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"罗浮春寄民泽 其一","author":"陈献章","text":"海上花开万玉林，閒门碧玉梦相寻。\n不知开处花多少，折尽罗浮半夜心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42472,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"罗浮春寄民泽 其二","author":"陈献章","text":"九肋蹒跚清楚阔，九苞真与黄云深。\n复有凤凰山上月，遍照罗浮玉洞春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42473,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈海蓬诸子冠毕来见赠以诗","author":"陈献章","text":"兄弟参差作雁行，春风碧玉喜同登。\n近午天风吹雁去，翩翩吹入紫云层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42474,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"周方伯至白沙","author":"陈献章","text":"天上客来寻故人，江门月下足音闻。\n便传一点江门信，逢著桃源且问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42475,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偶得","author":"陈献章","text":"一碧光横南岳前，灵坛秋玉青相连。\n道士来携三尺木，高山流水一声弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42476,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答送茄瓜 其一","author":"陈献章","text":"两头肥绿压肩斜，五月江园始送瓜。\n童子近前与翁语，小篮瓜底是新茄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42477,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答送茄瓜 其二","author":"陈献章","text":"同将形色委人间，窃比高松一鹤閒。\n口腹累人都未免，茄瓜篮里又诗还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42478,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新年 其一","author":"陈献章","text":"阴雨方连日，新年损物华。\n呼儿酌我酒，骑马到谁家。\n黯黯寒云密，萧萧暮景斜。\n人生正无赖，狼藉任桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42479,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新年 其二","author":"陈献章","text":"今日胜元日，江天乍放晴。\n呼瓶汲井水，煮茗待门生。\n山鸟鸣将下，桃花暗复明。\n所嗟人易老，况复岁华更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42480,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"止客宿","author":"陈献章","text":"为恨开年雨，江村马迹稀。\n诸君能枉拜，今夕不须归。\n岁酒堪投辖，人家欲掩扉。\n仍闻仆夫语，畏逐骏蹄飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42481,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮雨客去","author":"陈献章","text":"入郭路初暝，过桥客已劳。\n仆夫亦人子，马足徇吾曹。\n春色归诗妙，花枝爱酒豪。\n良宵只孤负，遮莫雨萧骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42482,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登陶公壮哉亭","author":"陈献章","text":"新亭开石窟，远势借昆崙。\n天地双眸迥，沧溟一口吞。\n公来席不暖，士死庙长存。\n忆昔干戈际，南征万马奔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42483,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"是夕范生小酌","author":"陈献章","text":"日月双轮转，乾坤一气旋。\n是时冬始闰，细雨夜如年。\n人语斜风外，天机落叶边。\n凭谁给灯火，更坐读残篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42484,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"至容贯宅","author":"陈献章","text":"在昔偶相遇，如今共白头。\n敝衣寒露肘，破屋早知秋。\n家业凭觚翰，厨烟管去留。\n老夫如辟谷，与子入罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42485,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"福童灌园","author":"陈献章","text":"绾瓶行百步，池在小桥东。\n抱瓮虽无忝，寒衣却未丰。\n数畦仍待绿，十趾遂流红。\n口腹终同及，能无愧此童。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42486,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄胡宁寿康斋先师之甥","author":"陈献章","text":"年华当转鸟，诗思更涂鸦。\n父子皆吾友，箕裘一舅家。\n人犹思岭北，书不到天涯。\n莫作妻孥计，浮生日易斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42487,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石门","author":"陈献章","text":"白发非公事，扁舟进此门。\n山云寒不雨，江路曲通村。\n玩世吾何有，长途马不存。\n晚来堪一醉，江月照空樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42488,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岁晚江上追次王半山韵","author":"陈献章","text":"山寒烟错寞，江晓日荒凉。\n水际风巾动，梅边蜡屐香。\n低头挈小榼，拍手笑轻航。\n何但供游走，而须此日光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42489,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"辱和拙作见示九日醉中再次奉答","author":"陈献章","text":"激楚嗟难和，霓裳更可同。\n更阑朱鸟下，声断碧云中。\n稍歇沾花雨，还吹落帽风。\n万松期不至，半偈欲腾空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42490,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]