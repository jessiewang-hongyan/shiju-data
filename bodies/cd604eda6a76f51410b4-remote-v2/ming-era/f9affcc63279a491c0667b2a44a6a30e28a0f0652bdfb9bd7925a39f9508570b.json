[{"title":"题郑氏思亲卷","author":"杨士奇","text":"不忍杯棬饮，愁闻陟屺诗。\n九原那复作，寸草恨难遗。\n为养诚无及，行身庶可期。\n灵椿百年寿，至乐罄吾私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2831,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"章江刘先生挽诗","author":"杨士奇","text":"经术师承正，才名天分高。\n閒情安野逸，雅操迈时髦。\n百岁光阴远，诸生嘅慕劳。\n章江庭馆外，逝水日滔滔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2832,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送东平傅知州复任","author":"杨士奇","text":"政成初北觐，考最复南征。\n相逢遽相别，缱绻若为情。\n露冷黄花老，天清锦树明。\n吏民迎望切，慎莫滞双旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2833,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送贺宁知县之丰川","author":"杨士奇","text":"作宰丰川县，芳年际圣朝。\n时清公事简，地僻瘴烟消。\n抚字须勤职，驱驰莫惮遥。\n匆匆斗酒别，聊复永今朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2834,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送钱习传","author":"杨士奇","text":"迢递沧江路，天寒风雪深。\n相知何在早，临别自难任。\n人重昆冈玉，乡荣郤氏林。\n为山终一篑，持赠比南金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2835,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汪氏慈训堂","author":"杨士奇","text":"早失过庭教，深依母氏恩。\n持身在仁义，奉训切朝昏。\n天地何由报，行藏矢弗谖。\n慈颜千岁寿，春暖北堂萱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2836,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴母挽诗","author":"杨士奇","text":"西风北堂上，白日黯春晖。\n寂寂承欢处，尘封五色衣。\n未终三釜养，遽动九原归。\n女范传应在，闺门嗣不违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2837,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"刘母挽诗","author":"杨士奇","text":"禄养人皆羡，兼荣母德贤。\n空遗板舆在，竟负綵衣鲜。\n吊鹤嗟何及，乘鸾望不旋。\n恩封冀他日，光命贲重泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2838,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"萧母挽诗","author":"杨士奇","text":"日夕乌啼树，悲风起穗帷。\n彩衣空五色，无复上堂时。\n壸范嗟犹在，灵游不可知。\n百年怀养者，长废蓼莪诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2839,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春晖堂","author":"杨士奇","text":"早失趋庭训，深依徙舍恩。\n踉蹡五色服，乐舞对春谖。\n寿酒华觞进，安居绮席温。\n持身务不辱，还究古人言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2840,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送乐舞生还闽中","author":"杨士奇","text":"清庙连丹阙，天坛接上台。\n君王严祀礼，乐舞得仙才。\n闽海三秋迥，云霄一鹤回。\n飘然终散逸，还忆上蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2841,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题郭智宪使荣养堂","author":"杨士奇","text":"朝廷崇孝理，宪纪用儒臣。\n分得乌台禄，归荣鹤发亲。\n褒封承帝命，光彩焕龙文。\n慈寿知方永，谖花百岁春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2842,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽吴彦直","author":"杨士奇","text":"珠还合浦日，令尹擅廉明。\n兴学皆从化，锄奸赫有声。\n诗书传奕世，夷险任平生。\n婉婉临终咏，闻之共怆情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2843,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠尚书吕公挽诗 其一","author":"杨士奇","text":"清比蓝田玉，含辉故有馀。\n乡人尊德义，世业重诗书。\n渭水淹吟兴，莲峰对隐居。\n百年皆过隙，不泯羡芳誉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2844,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠尚书吕公挽诗 其二","author":"杨士奇","text":"瑞世生贤杰，登朝奉圣明。\n身膺二品养，官赠六卿荣。\n光宠真千载，遭逢自一经。\n龙章照玉玺，褒拂极平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2845,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"示稻秫及昱","author":"杨士奇","text":"行年七十七，况复困沉疴。\n世德流传远，天恩覆被多。\n冉冉西颓景，骎骎东逝波。\n诗书好承续，黾勉勿蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2846,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"时勉学士升国子祭酒奉赠 其一","author":"杨士奇","text":"近侍踰三纪，文章柬掖垣。\n冰霜存桧柏，廊庙荐玙璠。\n帝重经筵旧，官升师道尊。\n翩翩起车骑，相送向桥门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2847,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"时勉学士升国子祭酒奉赠 其二","author":"杨士奇","text":"拜命彤廷日，龙墀瑞雪飞。\n缙绅瞻有喜，寮采念相违。\n时雨司成馆，天香学士衣。\n斯文千载运，吾道有光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2848,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"时勉学士升国子祭酒奉赠 其三","author":"杨士奇","text":"玉署东头阁，红扉昼不开。\n衰龄馀我在，清论更谁来。\n学者希传道，朝廷仗育才。\n贤关有佳兴，时寄锦笺回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2849,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽拙庵徐子信","author":"杨士奇","text":"行义时人重，才能邑里称。\n系传高士远，家挹太湖清。\n身世惊流电，朋游叹曙星。\n从知郭有道，不愧蔡邕铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2850,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠佥事鲁希文","author":"杨士奇","text":"自是天台秀，声名起绣衣。\n八闽监海国，六月凛霜威。\n考绩趋丹禁，承恩拜?闱。\n从来冰檗操，吾道有光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2851,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"示侄孙镛","author":"杨士奇","text":"念尔遽远别，送行无限情。\n一心常体道，百行贵存诚。\n海阔鹍鹏运，天寒冰雪清。\n盛年当努力，莫让古人能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2852,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠陈文编脩","author":"杨士奇","text":"庐陵南望远，六十五长亭。\n之子归宁日，重闱拜庆荣。\n文章金榜贵，官秩玉堂清。\n一幅湘皋赠，殷勤故郡情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2853,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送李绍检讨","author":"杨士奇","text":"安成李克述，三岁在词林。\n言色温如玉，操持坚断金。\n君恩紫诰重，亲舍白云深。\n万里归荣日，聊贻淇澳吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2854,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄顾都御史","author":"杨士奇","text":"翩然谢荣禄，林下乐天真。\n台府留清望，朝廷忆老臣。\n神情超物表，光彩动星辰。\n俗辙何由到，长同园绮亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2855,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨后","author":"杨士奇","text":"炎天久不雨，数雨复还晴。\n竹树繁阴合，阶墀幽草生。\n闭门无俗事，散帙任閒情。\n回首时西睡，芙蓉千叠清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2856,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"庭树","author":"杨士奇","text":"手种庭前树，参差总出墙。\n不须愁夏暑，已屡傲寒霜。\n过雨纷交翠，因风亦度香。\n如添清涧绕，即拟住山庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2857,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暑中卧疴写怀 其一","author":"杨士奇","text":"坐卧连晨夕，中怀郁不开。\n蝇攒眉上棘，蚊隐耳边雷。\n无那惔焚困，生增褦襶来。\n病咽兼患齿，两月废衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2858,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暑中卧疴写怀 其二","author":"杨士奇","text":"白发垂垂老，丹心耿耿存。\n毫丝无小补，天地有深恩。\n病马长联皂，羸牛不驾辕。\n蓬山望咫尺，惭负不胜论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2859,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"示表侄陈纯","author":"杨士奇","text":"西江海桑老，冠冕重儒林。\n我自外家学，尔求曾祖心。\n诗书宜善继，尘俗莫容侵。\n不见南山树，寸茎今百寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2860,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送魏源尚书按视边务","author":"杨士奇","text":"宝剑动华星，关城候使旌。\n春随司寇笔，霜重总兵营。\n武备千年固，尘氛万里清。\n归来奏天子，青史载鸿名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2861,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅寄傅知州","author":"杨士奇","text":"初入聊城县，遥闻郓守贤。\n教先重芹泮，治不假蒲鞭。\n吏牍清无滞，农田盛有年。\n公馀多秀句，吟咏玉梅边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2862,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过济宁作","author":"杨士奇","text":"久发潞河棹，初经济水浔。\n远山明晓黛，新柳动春禽。\n恋阙云霄迥，怀乡岁月深。\n君亲总恩重，来往并关心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2863,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中夜待弼侄不至","author":"杨士奇","text":"维舟喜相见，解䌫复相违。\n江阔春潮满，云深夕月稀。\n无眠成脉脉，延伫但依依。\n寂寞蓬窗下，挑灯坐揽衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2864,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"入西江境","author":"杨士奇","text":"万里移归舠，东风谢绛桃。\n烟迷彭泽柳，雪喷海门涛。\n身世江湖老，君亲梦寐劳。\n匡庐翠九叠，萧散白云高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2865,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归来","author":"杨士奇","text":"归来语向谁，白发故交稀。\n满目亭台好，伤心俗化微。\n慌迷携鹤径，惭过钓鱼矶。\n童子何知我，犹嗤旧素衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2866,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦诸孙","author":"杨士奇","text":"绕膝戏诸孙，相看意独亲。\n怜渠森似玉，对我浩生春。\n已惜承欢浅，何堪入梦频。\n亢宗吾望汝，莫遣愧荀陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2867,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄黄汝申宪使 其一","author":"杨士奇","text":"藩垣出岭表，宪节赴山东。\n旧有先师化，行惟大道公。\n百僚归表率，一志在瘝痌。\n纲纪从容振，时来视頖宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2868,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄黄汝申宪使 其二","author":"杨士奇","text":"预想山东境，高才起颂声。\n黔黎誇用恕，寮采荷推诚。\n老柏霜逾劲，寒梅雪共明。\n应同钟宪副，一力振澄清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2869,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五月六日早静海迤北大雨聊可苏旱","author":"杨士奇","text":"仰视月离毕，滂沱不待晨。\n人心异昨日，物态总回春。\n尚忆郊原遍，深思天地仁。\n来牟已无及，回首一沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2870,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"直沽","author":"杨士奇","text":"城堞绕巍峨，城阴下九河。\n水归东海近，人上北京多。\n仓廪皆漕储，闾阎半负戈。\n鱼盐十万户，何处有弦歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2871,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过漷县望都门西山","author":"杨士奇","text":"东旭光芒起，西山紫翠分。\n驰心向凤阙，仰首见龙文。\n旆影高低出，钟声远近闻。\n预将缨绂振，拟近玉炉薰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2872,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠文玉主事","author":"杨士奇","text":"清高玉堂署，聚处岁年深。\n心事澹于水，交情利断金。\n衰龄各垂白，远道又分襟。\n重会知何日，临岐惨不禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2873,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送宋万中致事南归","author":"杨士奇","text":"白首遂辞荣，承恩出凤城。\n故交推我老，远道念君行。\n酒对黄花酌，帆随白雁征。\n临岐记同学，惆怅不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2874,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戴母挽诗","author":"杨士奇","text":"道路何屯塞，闺门著肃雍。\n行宜君子配，恩拜孺人封。\n妆閤间薰鸭，床帏惨暗蛩。\n薇垣朝退食，举案属谁从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2875,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重寄澹庵","author":"杨士奇","text":"东观承恩地，俱看鬓雪侵。\n别来春未暮，延伫夏将深。\n忆我辞家日，知公恋阙心。\n五伦书未奏，还待共披寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2876,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"慰时勉学士丧孙","author":"杨士奇","text":"承过西昌日，提携已识奇。\n相随万里至，翻动九原悲。\n岂是多时别，无深岁晏思。\n与君俱此痛，排闷强裁诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2877,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寒夕独坐乡思浩然有怀何文渊 其一","author":"杨士奇","text":"乡国云山外，衰年入梦勤。\n经旬断杯酌，独夜对炉薰。\n窃禄真惭我，论心每忆君。\n许丞浑重听，时事不能闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2878,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寒夕独坐乡思浩然有怀何文渊 其二","author":"杨士奇","text":"薄雪俄消瓦，惊风复撼窗。\n蹉跎忽晏岁，寂寞伴寒缸。\n病骨支难稳，愁心郁未降。\n何由冰泮日，联棹溯西江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2879,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送袁本谦致仕归 其一","author":"杨士奇","text":"早岁从王事，迢迢促去骖。\n十年留汉口，万里入滇南。\n舟楫行应惯，弓刀力不堪。\n昨朝新有旨，头白许抽簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2880,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送袁本谦致仕归 其二","author":"杨士奇","text":"白下门前路，殷勤独送行。\n楚山浮暮霭，淮树起寒声。\n菰米香云饭，鲈鱼紫玉羹。\n老年今有此，何异学长生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2881,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄何文渊","author":"杨士奇","text":"忽复经年别，思乡趣不稀。\n松筠还旧隐，山水溢清辉。\n把钓银鲜滑，携镵紫蕨肥。\n南归吾有日，访剡兴无违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2882,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送廖子谟贰守归河间","author":"杨士奇","text":"三载一相见，匆匆又别离。\n荒年兼旱潦，圣主寄茕嫠。\n刘毅才无敌，阳城道可师。\n勋庸属贤俊，努力及明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2883,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽诗","author":"杨士奇","text":"乡里谈遗德，传流终未休。\n甘依泉石老，不应栋梁求。\n风树贻深感，云山徙故丘。\n宪台忠孝在，宠赠被恩稠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2884,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送周仲规脩撰","author":"杨士奇","text":"恩拜龙头选，六年登禁闱。\n暂辞金殿直，遥著锦衣归。\n云净江天阔，潮平岛树微。\n舟行足清景，诗思未应稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2885,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘定之编脩","author":"杨士奇","text":"六载庭闱隔，常悬定省情。\n自天膺宠命，即日戒归程。\n人物金闺彦，才华玉署清。\n承欢在有道，非但锦衣荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2886,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"任善得教谕于蜀辞行诗以勖之","author":"杨士奇","text":"典教除巴县，之官出帝畿。\n也知轻道路，所乐近庭闱。\n河岸杨花满，帆樯燕子飞。\n相期传授暇，自省莫令稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2887,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送别","author":"杨士奇","text":"相送复相别，花飞过却春。\n朝廷屡考最，黎庶总归仁。\n但倚丹心在，从教白发新。\n崇文门外柳，折赠不辞频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2888,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题晋江何氏怡寿堂","author":"杨士奇","text":"圣代多耆寿，何家有凤毛。\n谖明承日暖，椿老拂云高。\n甘旨供天禄，欢娱艳赐袍。\n庭闱介百岁，锦诰见华褒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2889,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送曹都御史","author":"杨士奇","text":"宠命膺边寄，天书焕紫泥。\n九秋辞阙下，万里度关西。\n著豸金横带，乘骢玉作蹄。\n归朝奏成绩，光宠赐鞶犀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2890,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈母挽诗","author":"杨士奇","text":"曾题南野墓，主孟复云亡。\n八帙又三岁，诸孙泣满堂。\n母仪乡里重，妇道族姻伤。\n忍听门前树，乌啼惨夜霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2891,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄萧德迪","author":"杨士奇","text":"桃源萧德迪，苦志事题诗。\n含咏常忘暮，抽思无倦时。\n云边写素瀑，岩下发华芝。\n万里劳相寄，聊酬青凤枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2892,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹赠彭同知","author":"杨士奇","text":"分得筼筜谷，翛翛翠一竿。\n曾闻裁作简，不假制为冠。\n势接丹霄近，清宜白日看。\n但保风霜操，相期历岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2893,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅赠医士萧玄立","author":"杨士奇","text":"兰陵传谱系，两鬓雪霜侵。\n医业过三世，仙方抵百金。\n橘香苏氏井，杏艳董家林。\n更着梅花好，光辉利济心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2894,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"毛行人奉使江南便道省亲题梅花赠之","author":"杨士奇","text":"去乡六千里，念别思悠悠。\n共是江南客，君乘使者舟。\n折梅将远意，擢桂重名流。\n捧檄升堂日，承欢慰白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2895,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭康甥孟嘉","author":"杨士奇","text":"提携二十载，羽翮已云飞。\n眼见乘骢出，惊闻旅衬归。\n素行元不忝，夙愿竟都违。\n虽不多时别，能无涕泪挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2896,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林佥宪斗山风木卷","author":"杨士奇","text":"青春艳绣衣，得禄更兴悲。\n无复娱亲日，徒伤负米时。\n迢迢桑梓恋，恻恻蓼莪思。\n天地无穷极，难伸寸草私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2897,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重游东郭草亭","author":"杨士奇","text":"园亭风日好，邀客绮筵开。\n重合金闺彦，兼联玉署才。\n泉流经近席，花气拂深杯。\n不断劝酬意，更堪弦管催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2898,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅赠萧雅容员外赴兖州知府","author":"杨士奇","text":"有美同乡彦，兹晨又别离。\n光承宠命出，正及艳阳时。\n抚字人皆望，操存我所知。\n梅花故园意，持赠慰相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2899,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹送雅容老友复任湖广布政聊寓折柳之意云","author":"杨士奇","text":"荣捧天恩出，都门雨散丝。\n重临江汉上，深慰吏民思。\n纯璞时稀识，贞松岁久知。\n相逢即相别，聊赠凤凰枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":2900,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]