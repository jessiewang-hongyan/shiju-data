[{"title":"秋晚梁溪道中","author":"郭谏臣","text":"向晚梁溪道，秋光满画船。\n山明低落日，波净倒涵天。\n远市分残雨，丛林起暮烟。\n同行俱故旧，杯酒共留连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22864,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"毗陵道中","author":"郭谏臣","text":"兰舟载酒集高朋，缥缈孤帆指义兴。\n平楚桥临青嶂曲，晴空塔耸白云层。\n沙汀水落萍还积，田舍秋来黍渐登。\n一局残棋宾未散，夕阳烟树近毗陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22865,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"园亭夜宿","author":"郭谏臣","text":"华屋三年别，閒来一驻骖。\n移樽同胜赏，下榻恣幽探。\n林壑秋声满，亭台夜色含。\n山窗灯火下，相对尽沉酣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22866,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蚤抵锡山","author":"郭谏臣","text":"苦暑竟宵征，归帆拂曙星。\n帘垂秋水碧，坐对晓山青。\n徙倚看渔艇，微吟到驿亭。\n此身浑似寄，沧海一浮萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22867,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柏渎夜归","author":"郭谏臣","text":"天末夕阳收，归途只暝投。\n扬舲过蠡泽，失路问渔舟。\n雨暗湖天夜，风生荻岸秋。\n宵分方抵舍，灯火映青邱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22868,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖州城下夜泊","author":"郭谏臣","text":"清秋移桂楫，薄暮宿苕溪。\n云磬来篷底，烟林隔水西。\n川原随地胜，星汉去城低。\n欲访山中旧，前途候蚤鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22869,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宴座主董司空宅","author":"郭谏臣","text":"司空爱客兴何长，芳宴时开绿野堂。\n皓齿满前歌玉树，纤腰相对舞霓裳。\n瑶觞频劝人先醉，银烛高烧夜未央。\n归卧兰舟初梦觉，罗襟犹带酒痕香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22870,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚过平湖县东湖","author":"郭谏臣","text":"薄暮风生访戴舟，湖波遥引太空流。\n墟烟缕缕山腰起，塔影层层水面浮。\n几点閒鸥红蓼晚，一行新雁碧云秋。\n江乡到处堪乘兴，莫怪明时便乞休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22871,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜归娄门","author":"郭谏臣","text":"潮生荻岸平，日暮兰桡歇。\n篷底坐移时，开帘见新月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22872,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜独处怀内","author":"郭谏臣","text":"天远凤楼空，风清鸳帐冷。\n不寝起凭栏，月落孤松影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22873,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋晚虎邱山楼小坐","author":"郭谏臣","text":"水国深秋景，山楼薄暮时。\n閒寻兰若客，同醉菊花卮。\n草木行看变，云林似有期。\n笙歌声正沸，归棹未云迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22874,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蠡塘舟中晚眺","author":"郭谏臣","text":"江乡过雨晚萧疏，霜染枫林锦不如。\n数里烟帆渔父棹，孤村水竹野人居。\n樽携绿醑时浮蚁，囊解青钱欲买鱼。\n菊有黄花秋渐老，临风徙倚独踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22875,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初冬日园亭杂兴","author":"郭谏臣","text":"细雨园林润，初冬景亦佳。\n蕉馀含露叶，菊剩傲霜花。\n古木临寒水，高窗送晚霞。\n烹茶问童子，分火向邻家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22876,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬夜与诸友同集冯郡伯园亭分得栖字","author":"郭谏臣","text":"名园冠盖集，坐久忽鸡栖。\n明月当空满，晴云去树低。\n窗间银烛剪，松下绿樽携。\n到处清辉绕，归途醉不迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22877,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠丁侍御同年赴南都三绝 其一","author":"郭谏臣","text":"沧江一棹驾长风，水底鱼龙亦避骢。\n他日埋轮兼破柱，始知江海有孤忠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22878,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠丁侍御同年赴南都三绝 其二","author":"郭谏臣","text":"绣服霞明映廌冠，台端今日用丁宽。\n先声但落奸雄胆，莫遣霜飞六月寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22879,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠丁侍御同年赴南都三绝 其三","author":"郭谏臣","text":"折桂当年并马游，君今揽辔气横秋。\n自惭空负澄清志，宦海归来已白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22880,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与顾水部期登楼玩雪不赴简一绝","author":"郭谏臣","text":"彤云万里雪漫漫，门外花飞玉树寒。\n欲上层台寻故约，问君何事学袁安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22881,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除夕","author":"郭谏臣","text":"百年已过半，此夜岁云除。\n消却风云气，聊同水竹居。\n湖山原有社，政府久无书。\n元日来朝是，春风到草庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22882,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舣舟灵殿寺与客同探梅花","author":"郭谏臣","text":"泽国春阴久，梅花尚未开。\n疏枝含玉蕊，清影落瑶台。\n客舫移樽至，僧厨进茗来。\n不须催几席，随意坐莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22883,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王少参同年赴豫章","author":"郭谏臣","text":"迢递西江路，花开满故枝。\n君悬新绶去，予动旧游思。\n彭蠡春深后，匡山月落时。\n梦魂飞度处，云水隔天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22884,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨后登城野望","author":"郭谏臣","text":"雨歇天还霁，沙乾路不迷。\n乱鸠鸣竹坞，飞燕掠芹泥。\n城带春云润，山衔落日低。\n醉馀时纵目，芳草绿萋萋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22885,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨后南园晓望","author":"郭谏臣","text":"病酒连朝起较迟，南园门掩日长时。\n庭前草长多新绿，雨后花开满故枝。\n丝飏微风罥古木，水流曲径到平池。\n呼童为整登山屐，恐负幽人石上期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22886,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上巳前一日与客同集虎邱山楼","author":"郭谏臣","text":"山楼携客饮，春色正堪怜。\n叠嶂浮云外，明湖落槛前。\n松门斜映日，花径暗流泉。\n欲扫千人石，欣然一醉眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22887,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日与客同过张幼于湖上别业","author":"郭谏臣","text":"春风湖上驻蓝舆，言访蓬蒿仲蔚居。\n高阁过云浮栋宇，匡床飞雨润琴书。\n呼童频进松陵酿，对客时烹笠泽鱼。\n缱绻从君还竟日，倦游谁惜病相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22888,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日访方司训二首 其一","author":"郭谏臣","text":"访旧携轩从，山行一径斜。\n春风多柳絮，夜雨长蒲芽。\n草满王孙路，云深处士家。\n怜君头白尽，潦倒卧烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22889,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日访方司训二首 其二","author":"郭谏臣","text":"不见方干久，沉吟带瘦容。\n青山城市远，白屋薜萝封。\n身向閒中老，交从病后慵。\n湖山风月夜，安得更相从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22890,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山窗独坐二绝 其一","author":"郭谏臣","text":"日永篆烟消，风寒襟袂薄。\n閒窗无客来，坐久庭花落。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22891,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山窗独坐二绝 其二","author":"郭谏臣","text":"林合鸟声频，山含花气重。\n春色已将阑，欲寝不成梦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22892,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上湖舟中","author":"郭谏臣","text":"春游兴未已，一棹泛中流。\n塔影波心落，岚光树杪浮。\n岸花红欲尽，汀草绿初稠。\n念此频来往，壶觞共劝酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22893,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早登拂水岩","author":"郭谏臣","text":"肩舆侵晓发，一径入中天。\n花落莺声外，人行鸟道边。\n云深低护石，风送乱飞泉。\n更上层巅望，双崖若剑悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22894,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山斋睡起","author":"郭谏臣","text":"幽斋初睡起，斜日透窗明。\n檐外群蜂出，花间一鸟鸣。\n微吟无限思，晏坐有馀清。\n点检残春色，凭阑诗又成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22895,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初夏日与社友同集蒋高凉宅","author":"郭谏臣","text":"芳辰喜良晤，清酌坐花前。\n松竹开三径，冠裳聚七贤。\n笑谈娱白发，醉眼望青天。\n别后林光暝，归途细雨边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22896,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新夏登虎邱山阁","author":"郭谏臣","text":"山楼杯酒坐移时，醉倚阑干日欲西。\n芳草丛深麋鹿走，残花落尽杜鹃啼。\n林藏宿雨枝头重，风压轻云水面低。\n游客不知春已去，画船箫鼓聚香堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22897,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠吴少溪宫詹","author":"郭谏臣","text":"国内贤豪士，如公复几人。\n弃繻游上国，弹铗客平津。\n意气凌霄汉，声华动缙绅。\n穆皇初御极，潜邸昔为臣。\n昼日方倾藿，秋风忽忆莼。\n烟霞堪自老，风月未全贫。\n安石登山屐，渊明漉酒巾。\n竹林群结社，桃实几经春。\n坐客金兰旧，庭闱玉树新。\n陶朱同晚节，方朔是前身。\n人并推耆德，时方礼逸民。\n圣朝纁璧诏，早晚下枫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22898,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浒墅新晴","author":"郭谏臣","text":"雨歇芳林润，风生细浪浮。\n河津当孔道，关法阻行舟。\n斜日蒸花气，轻寒动麦秋。\n自嫌婴世网，空负主人留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22899,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河桥晓发","author":"郭谏臣","text":"水村鸡唱后，曙色到蓬窗。\n云破犹随月，河斜欲堕江。\n乘风携画桨，分火剔银釭。\n残酒时消尽，诗魔未肯降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22900,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"集徐鸿胪园林","author":"郭谏臣","text":"雷声起天末，骤雨忽倾盆。\n径引奔泉落，林栖断霭昏。\n残阳催去客，暝色带清樽。\n醉拂罗衫袖，淋漓半酒痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22901,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日园居独坐","author":"郭谏臣","text":"经时久不到山庄，数亩园居野趣长。\n窗竹日高斜弄影，庭花风动暗浮香。\n书抛满架呼僮帙，酒熟盈樽待客尝。\n独坐更无尘虑扰，萧然真足傲羲皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22902,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南楼雨坐","author":"郭谏臣","text":"投閒登小阁，独坐倚雕阑。\n帘幕千村雨，絺衣五月寒。\n水声来坐上，烟景翳林端。\n风洒侵窗竹，图书润未乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22903,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南浦新晴散步","author":"郭谏臣","text":"散帙寻幽赏，园林过雨新。\n菜畦微有径，苔石净无尘。\n邻犬时迎客，池鱼解避人。\n壶觞随意饮，漉酒不须巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22904,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹅湖雨后舟行","author":"郭谏臣","text":"雨洗湖光净可怜，远山湖外敛轻烟。\n离披芦荻疑连汉，浩渺兰舟欲上天。\n鸟逐帆飞明镜里，渔收网挂夕阳边。\n呼僮酾酒消閒坐，散发篷窗一醉眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22905,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"毗陵舟中","author":"郭谏臣","text":"向晚毗陵道，官桥系短篷。\n水迎风起浪，日射雨成虹。\n鬓逐年华白，颜随酒晕红。\n甘心老空谷，一任笑愚公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22906,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟中望惠山","author":"郭谏臣","text":"往返梁溪道，开帘见惠山。\n遥怜多胜槩，恨不及跻攀。\n云壑清泉冷，松门白日閒。\n狂游今不倦，极目只空还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22907,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归舟晚眺","author":"郭谏臣","text":"侵星时鼓棹，毕景未收帆。\n日落烟横浦，天高月挂岩。\n多情新绿酒，落魄旧青衫。\n醉后清狂态，凭谁笑阿咸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22908,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"常熟舟中","author":"郭谏臣","text":"落日琴川路，薰风彩鹢新。\n烟波时独往，鸥鸟自相亲。\n兴岂同元亮，狂疑类季真。\n凭谁问行迹，湖海一孤臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22909,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十三夜山亭玩月","author":"郭谏臣","text":"华馆中秋夜，青天片月来。\n彤弓弦未彀，宝镜匣初开。\n疏影穿帘幕，清光落酒杯。\n坐深忘却倦，一任漏频催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22910,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋夜石湖舟中无月","author":"郭谏臣","text":"湖上通宵坐，中天月未明。\n孤舟虚夜景，万籁自秋声。\n竹叶沽还进，灯花剪复生。\n故人相对饮，潦倒不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22911,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十六夜抵虎山桥","author":"郭谏臣","text":"夙有山桥约，今从烟水游。\n晴岚浮列嶂，落日漾中流。\n寺迫诸天晚，湖悬一镜秋。\n相看明月上，谈笑理觥筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22912,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日与客同登灵岩二首 其一","author":"郭谏臣","text":"破晓登危巘，行行入翠微。\n琴台松韵细，香径露华晞。\n地僻幽花吐，池晴浴鸟飞。\n投閒寻古迹，竟日自忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22913,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日与客同登灵岩二首 其二","author":"郭谏臣","text":"灵岩携上客，石磴倩僮扶。\n掬水临双井，凭高瞰五湖。\n烟霞迷古洞，霄汉插浮图。\n此地三年别，重来兴不孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22914,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"家弟归自秣陵携酒同登虎邱","author":"郭谏臣","text":"朝来乌鹊喜，天畔鹡鸰归。\n挈客登高阁，开樽对落晖。\n天香流绮席，秋色上罗衣。\n醉后回孤棹，风帆一片飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22915,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浒墅舟中与蒋云厓郡守夜话","author":"郭谏臣","text":"河梁同舣棹，杯酒夜相亲。\n坐对青灯久，还惊白发新。\n烟霞三径侣，天地两閒人。\n故旧论心处，相看醉态真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22916,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日与蒋使君同游黄公涧","author":"郭谏臣","text":"登高行憩树，扫石坐听泉。\n林谷含秋色，村墟起暮烟。\n亭依青嶂曲，酒送白云边。\n饮罢天将暝，归舟醉欲眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22917,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蠡东秋夜","author":"郭谏臣","text":"池馆深秋夜，寒蛩不住鸣。\n凉飙千里至，新月一钩明。\n古壁残灯影，空阶落叶声。\n芸编閒检罢，独坐有馀清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22918,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋晚南园二绝 其一","author":"郭谏臣","text":"亭俯曲池中，人归残照里。\n夹岸芙蓉花，盈盈隔秋水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22919,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋晚南园二绝 其二","author":"郭谏臣","text":"幽栖谢俗缘，僻性耽清赏。\n醉后步苍苔，东林月初上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22920,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南园秋暮二首 其一","author":"郭谏臣","text":"暂尔尘氛远，居然心境幽。\n遣怀频觅句，穷睇独登楼。\n禾黍孤村晚，芙蓉夹岸秋。\n自甘疏懒性，清世愧沉浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22921,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南园秋暮二首 其二","author":"郭谏臣","text":"摇落深秋后，凄凉欲暮时。\n印阶多鸟篆，网户总蛛丝。\n竹圃风声集，蕉庭日影移。\n时逢携酒伴，相与醉东篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22922,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨后晨起即事","author":"郭谏臣","text":"卧听中宵雨，仍惊十月雷。\n晨光时渐动，寒色晓来催。\n试检狐裘在，慵将鸾镜开。\n科头清旭里，独步思徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22923,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送长洲李明府入觐","author":"郭谏臣","text":"作宰君当英妙时，政成应报九重知。\n云中宫阙双凫远，客里风霜一鹤随。\n紫陌朝回烟未散，彤庭宴罢日初移。\n自来卓异堪殊赏，借寇能忘竹马期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22924,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与袁太常顾水部蒋郡守同登徐鸿胪后苑层楼","author":"郭谏臣","text":"丛林架层阁，缥缈插青天。\n远送千山雨，平吞万井烟。\n杯传残照里，人醉白云边。\n贤主时邀客，频来下榻眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22925,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬日舟过蠡西","author":"郭谏臣","text":"仲冬风日好，天气更宜人。\n雾散林初霁，霞明水欲春。\n帆移青雀远，村狎白鸥驯。\n故旧时相迓，樽前意味真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22926,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜过蠡西竹梧书院","author":"郭谏臣","text":"当年读书处，今日喜重过。\n拂树霜华重，穿帘月色多。\n兴同狂阮籍，迹类病维摩。\n醉向孤灯坐，凄凉奈若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22927,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉归东蠡","author":"郭谏臣","text":"醉归天渐暝，野烧映寒原。\n委巷儿童候，丛林鸟雀喧。\n灯花落书案，风叶走柴门。\n自喜身閒旷，那能效槛猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22928,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹梧轩晨起","author":"郭谏臣","text":"夜饮归来晚，晨眠起较迟。\n日高烟未散，春入鸟先知。\n自觉心如水，宁言鬓似丝。\n疏狂时共弃，独乐复何疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22929,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东楼小坐","author":"郭谏臣","text":"高楼瞰玄圃，杯酒坐移时。\n烟景翳林杪，春光上柳枝。\n窗虚云满栋，冰泮水平池。\n夙有清狂兴，临风一解颐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22930,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早春与客同过张幼于曲水别墅","author":"郭谏臣","text":"寻梅往南郭，因过辟疆园。\n奇石风霜古，长林竹树繁。\n高情追梓泽，痛饮效平原。\n客散宵分后，空馀月满轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22931,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蠡东别业阅壁间郑侍御诗怆然书感","author":"郭谏臣","text":"谷口人何在，缄题手泽存。\n青年弃轩冕，白社共琴樽。\n身退名还重，家贫道自尊。\n修文竟成幻，无处可招魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22932,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]