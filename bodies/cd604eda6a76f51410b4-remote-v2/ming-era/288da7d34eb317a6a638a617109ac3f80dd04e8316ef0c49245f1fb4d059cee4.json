[{"title":"寿姊夫林君并姊氏七十 其二","author":"黄仲昭","text":"同胞犹幸两人存，姊已稀年弟六旬。\n献寿末由倾绿醑，空馀清梦到家频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿姊夫林君并姊氏七十 其三","author":"黄仲昭","text":"伉俪齐年七十馀，承欢况复子孙俱。\n缄词远寄南飞鹤，相约蓬壶看海枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙卯重过圆通寺借宿再用夏提学韵赋一律","author":"黄仲昭","text":"欲濯尘缨尚未能，匡庐又见碧层层。\n半生牢落空怜我，一味清闲却让僧。\n周览未酬霞外想，长吟聊伴佛前灯。\n重游更与山灵约，只恐萍踪不可凭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南安行台赋古梅 其一","author":"黄仲昭","text":"横浦行台有老梅，看花今是第三回。\n浮生莫叹容颜改，铁干冰姿亦半摧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南安行台赋古梅 其二","author":"黄仲昭","text":"铁干冰姿亦半摧，入门为尔重徘徊。\n独怜不改坚贞操，依旧寒花冒雪开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登上清宫鹤归亭用赵松雪韵","author":"黄仲昭","text":"揽衣一上鹤归亭，亭外奇峰晚更青。\n无计可能医俗病，矢心期不愧山灵。\n清音度曲莺啼树，碎影摇金月到庭。\n欲拂瑶琴奏山水，子期已去复谁听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙岩亦用前韵","author":"黄仲昭","text":"风景依稀似幔亭，悬崖峭壁绝丹青。\n请看石窦函遗蜕，可是神仙尚有灵。\n华表不闻归白鹤，道人空自诵黄庭。\n山禽似喜游人至，树底和鸣亦可听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"走笔题扇送方恒谦行人之京","author":"黄仲昭","text":"十年江海叹离群，才得逢君又送君。\n明日高楼凝望处，几重山水几重云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题白莲","author":"黄仲昭","text":"蓬岛仙姝浅淡妆，翠旌羽盖渡沧浪。\n镜奁不是无朱粉，羞与奸谀比六郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闽江观涨","author":"黄仲昭","text":"闽山春雨积旬馀，新涨盈江混太虚。\n行客朝迷山下路，渔舟夜系竹间庐。\n鸟飞烟霭冥濛里，人在乾坤混沌初。\n愁听村农相告语，傍溪田圃半沮洳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游钟山和同寅潘应昌韵二首 其一","author":"黄仲昭","text":"红尘十载走金陵，偶共寻幽适性灵。\n山色自应千古在，人生能得几回经。\n苍松栖鹤看尤好，碧涧潜蛟饮觉腥。\n一段风烟堪入画，谁言蓬岛隔穷溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游钟山和同寅潘应昌韵二首 其二","author":"黄仲昭","text":"我来抚景无穷思，安得长绳系曜灵。\n白鹭洲空潮自去，乌衣巷古燕还经。\n六朝事业浮云尽，千载江山战血腥。\n圣代乾坤宁谧久，洗兵何用倒沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再和同寅潘应昌游钟山韵三首 其一","author":"黄仲昭","text":"丘陇高低六代陵，谁将尊酒酹遗灵。\n蚀残断础荒苔合，剥尽丰碑野烧经。\n樵唱幽林空谷应，渔归芳渚晚风腥。\n英雄割据成何事，依旧青山枕翠溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再和同寅潘应昌游钟山韵三首 其二","author":"黄仲昭","text":"帝业天开形势壮，望中濯濯著威灵。\n山连吴楚周遭绕，江发岷峨迤逦经。\n夷夏有归供职贡，犬羊无地肆膻腥。\n千年王气今全盛，累洽重熙奠八溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再和同寅潘应昌游钟山韵三首 其三","author":"黄仲昭","text":"泉石幽奇爱秣陵，卜居拟访草堂灵。\n嗅梅细和逋仙句，种茗闲看陆羽经。\n醉里玉山能自倒，世间铜气任渠腥。\n浮生此计何当遂，谁问飞尘竭九溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽馀姚黄处士夫妇","author":"黄仲昭","text":"同阅升平九十年，蓬莱相继梦游仙。\n乡评共说梁鸿好，闺范还称德曜贤。\n棋局昼闲花屿上，机声秋断画堂前。\n贤孙霄汉钟馀庆，指日焚黄贲陇阡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重九同年戴大节诸君登台赋诗病中示次韵","author":"黄仲昭","text":"身如病鹤未能飞，闻道群公集翠微。\n料得清尊能纵饮，肯教黄菊笑空归。\n山添新翠初经雨，鸦带残红欲落晖。\n却忆去年多乐事，故山倾倒卧苔衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和同寅黄九成棘寺言怀亦用前韵","author":"黄仲昭","text":"公馀仰见白云飞，身外浮荣顿觉微。\n世路风波随处险，天涯萍梗几时归。\n乾坤举眼成何事，岁月无情易落晖。\n况复元规尘满面，西风无地拂征衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨郎中恺之参议广西","author":"黄仲昭","text":"万里云山是桂林，都门雪霁马骎骎。\n驰声粉署年华久，佐政薇垣宠眷深。\n瘴厉须凭甘雨散，疲癃还望福星临。\n此行上德敷宣遍，定有殊勋简帝心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲午季冬雨雪连旬公馀感触辄赋八绝 其一","author":"黄仲昭","text":"琪花谁散满林端，一夜钟山失翠鬟。\n上下清光相掩映，乾坤都在画图间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲午季冬雨雪连旬公馀感触辄赋八绝 其二","author":"黄仲昭","text":"道傍甲第是谁家，金帐羊羔兴正赊。\n棘寺郎官清透骨，自敲冰片煮春茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲午季冬雨雪连旬公馀感触辄赋八绝 其三","author":"黄仲昭","text":"茫茫积雪遍山川，瘦马冲寒敢自怜。\n应有闭门僵卧者，甑无炊黍突无烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲午季冬雨雪连旬公馀感触辄赋八绝 其四","author":"黄仲昭","text":"匡时事业了无成，牢落风尘笑此生。\n却羡灞桥驴背客，无端风味助吟情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲午季冬雨雪连旬公馀感触辄赋八绝 其五","author":"黄仲昭","text":"一雪旬馀晓暂晴，晚云旋复结浓阴。\n村农初喜春宜麦，麦陇今嫌雪太深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲午季冬雨雪连旬公馀感触辄赋八绝 其六","author":"黄仲昭","text":"寒威入夜彻吟帏，布被无温酒力微。\n谁念三边征戍苦，满天风雪卧戎衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲午季冬雨雪连旬公馀感触辄赋八绝 其七","author":"黄仲昭","text":"要路诸公宠禄兼，红炉炽炭酒频添。\n迂疏只合长清冷，案牍时呵冻笔签。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲午季冬雨雪连旬公馀感触辄赋八绝 其八","author":"黄仲昭","text":"青山雪后可寻春，欲谢微官未有因。\n闻道村桥梅已发，看花酌酒属何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题进士起家卷","author":"黄仲昭","text":"龙头鼻祖家声旧，又见闻孙起盛时。\n笔健应扛汾水鼎，才高独占郤林枝。\n宸聪快睹天人策，睿眷荣超礼乐司。\n故物青毡今尚在，继承还为后人期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王主事世英还朝次翰林诸公饯别联句韵","author":"黄仲昭","text":"万里东瓯驾使骖，春风归路过闽南。\n囊中不着新增物，箧里惟存旧赐衫。\n十载论心情最剧，半生忧国意犹酣。\n还朝若问经行俗，为道流殍泽未覃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿仙溪张母吴氏七十次周翠渠韵","author":"黄仲昭","text":"舞袖斓斑晓日前，慈闱尊酒贺稀年。\n长生莫问还丹诀，种得琼芝满石田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题仙溪游鹤轩次周翠渠韵","author":"黄仲昭","text":"林木阴森林草萋，林塘一鹤独幽栖。\n檐端飞起茶烟瞑，云际归来岩日低。\n声挟天风闻更远，舞当庭月望还迷。\n秪应长伴蓬仙侣，谁羡趋朝候晓鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛酉二月二十日晨起访云峰即事","author":"黄仲昭","text":"晓访云峰认旧蹊，种松拟筑茧窝栖。\n溪云荡漾浮山足，石径崚嶒怯马蹄。\n绅笏久羁真自误，林泉勇退未终迷。\n年来颇得蒙庄趣，天地蜉蝣一视齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"致仕过常思岭兰若和故友彭从吾韵二首 其一","author":"黄仲昭","text":"引年得请荷清朝，报答惭无尺寸劳。\n吾道自难酬素志，愚衷空复恋青霄。\n百年世事心俱懒，两眼云山兴末消。\n偶读从吾旧题句，九原无路起诗豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"致仕过常思岭兰若和故友彭从吾韵二首 其二","author":"黄仲昭","text":"乡山动是十年思，今日重过一赋诗。\n黄菊相看如旧识，白云未许笑尘姿。\n鸟鸣翠竹尤深处，鹤立苍松最上枝。\n我亦归寻旧栖隐，开尊冷看世途危。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠大田驿丞彭籍三首 其一","author":"黄仲昭","text":"先人昔日教安成，我在黉宫廨里生。\n垂老又经司学政，安成人士独关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠大田驿丞彭籍三首 其二","author":"黄仲昭","text":"大田驿舍偶逢君，问是安成宦族孙。\n空谷足音心自喜，平生迹异底须论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠大田驿丞彭籍三首 其三","author":"黄仲昭","text":"一官山馆使车稀，公事无多足自怡。\n委吏乘田遗训在，立身元不论崇卑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大田驿和林元佐地官留题韵","author":"黄仲昭","text":"此地经过知几回，山灵应笑我重来。\n吟春幽鸟寒犹涩，带雨顽云湿不开。\n恤政未沾桑下饿，闲愁空切杞人怀。\n百年畎亩馀忠在，岂逐衰残没草莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺延平刘宫保得男二首次林见素韵 其一","author":"黄仲昭","text":"郁葱佳气絇晴霞，维岳钟英少保家。\n汤饼筵开春意蔼，沉檀香袅煖烟斜。\n灵椿虽老尤增翠，萱草从今更着花。\n天上麒麟重孕秀，徐卿二子未须誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺延平刘宫保得男二首次林见素韵 其二","author":"黄仲昭","text":"剑水深蟠双翠虬，灵钟人物轶常流。\n光前骨相由天定，裕后休祥自己求。\n怡养行看翻彩服，蒸尝有待荐嘉羞。\n百年宫保书香在，继武还修五凤楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿仙溪李朴庵夫妇七十次陈待徵郎中韵","author":"黄仲昭","text":"高堂春酒莫辞倾，此夕弧南星正明。\n莱服频翻娱绮席，南陔新谱入瑶笙。\n西来王母蟠桃熟，东望函关紫气横。\n寿域无涯才七十，蓬瀛还看海尘生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽三山张浚大尹","author":"黄仲昭","text":"昔年同听鹿鸣歌，浮世光阴转眼过。\n白发盈颠嗟我老，黄泉无路奈君何。\n芹宫化雨英髦盛，花县春风惠泽多。\n独恨行营星遽殒，鲸鲵未睹伏天戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郡守陈公入觐","author":"黄仲昭","text":"老来送别易销魂，况复今朝别使君。\n霖雨已看苏赤子，馀波还喜及斯文。\n关河白雁秋惊梦，阊阖疏星晓奏勋。\n后夜月明天万里，空依北极望红云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题张叔著桂林书院中曲水流觞次郑东园韵","author":"黄仲昭","text":"桂林风物擅幽奇，此日追随一憩之。\n水有渊源流易满，杯行结曲到应迟。\n莺调簧管来深树，脍切银丝出别池。\n浮世兹游须尽兴，万牛难挽岁华移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题镇海朱大尹渔樵耕牧图次翠渠韵","author":"黄仲昭","text":"乾坤何处是通津，谢却浮荣避俗尘。\n渔笛数声芳渚暮，樵歌一曲碧山春。\n高秋禾黍遍层陇，落日牛羊归四邻。\n架有琴书尊有酒，何须蓬岛觅仙人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题守拙卷","author":"黄仲昭","text":"高隐林泉远市朝，半生守拙卧衡茅。\n浮荣有分从吾好，世事无机任俗嘲。\n袜雀让教称巧妇，斑鸠自合寄成巢。\n知君妙契濂溪赋，岂向清时作系匏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送宗侄孙道进任新会教谕次同年李若虚韵 其一","author":"黄仲昭","text":"年来谢却白鸥沙，荣捧除书出帝家。\n遥想振扬文教日，春风开遍杏坛花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送宗侄孙道进任新会教谕次同年李若虚韵 其二","author":"黄仲昭","text":"吾家文献自唐开，未羡床头笏满堆。\n此去誉髦期不忝，青毡还付与云来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题仙溪张氏一乐堂庆寿图","author":"黄仲昭","text":"灵椿萱草并鲜妍，玉树芝兰复满前。\n共倚蓬壶看春色，从教沧海变桑田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和方友允迪六十自寿诗","author":"黄仲昭","text":"寿酒年年宴此晨，未论腰带绾黄银。\n人无丰约闲应好，事有乘除乐亦均。\n素履不渝从我好，世途寡合任渠嚬。\n纷纷华要曾何补，谁谓儒冠真误身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题周宪使公载归来亭次壁间韵","author":"黄仲昭","text":"小亭依约水晶宫，四面澄波可鉴容。\n槐蚁梦随残月曙，莼鲈兴绕白云重。\n忧时畎亩馀忠在，结社林泉乐意浓。\n我欲亭中分半榻，闲看孤鹤舞苍松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽赠监察御史董□夫妇","author":"黄仲昭","text":"一双白璧閟青山，逝水东驰不复还。\n人世有天敷庆泽，泉台无路接清颜。\n凤毛碧汉双高翥，鸾诰彤墀屡涣颁。\n墓石惭予辞不斐，足留潜德示人寰。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曾郎中谢病还乡","author":"黄仲昭","text":"半生尘土鬓成丝，谢事还家竟不疑。\n陶令谩因黄菊去，留侯曾与赤松期。\n闲来轩冕应无梦，到处溪山定有诗。\n我未别君君别我，江东回首不胜思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"具庆堂诗庆林季瑞税使伉俪寿六十 其一 次林太守韵","author":"黄仲昭","text":"木公白发岸乌纱，金母酡颜映紫霞。\n老眼摩挲看流转，桑田渐满海东涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"具庆堂诗庆林季瑞税使伉俪寿六十 其二 次吴宪副韵","author":"黄仲昭","text":"甲子年来又一新，人间还看几回春。\n仙翁云外传消息，已注长生箓上人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送望江教谕伯清先生乃兄还莆 其一","author":"黄仲昭","text":"春草梦残劳北上，松楸望断复南归。\n往来总系纲常重，一任风尘敝客衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送望江教谕伯清先生乃兄还莆 其二","author":"黄仲昭","text":"两京飘泊几星霜，却喜逢君话故乡。\n潮水不知离别苦，又从江上送归航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送道士还乡","author":"黄仲昭","text":"孤踪无碍任西东，一片闲云寄碧空。\n卖药暂游都市里，寻真又入故山中。\n兰桡夜泛鸥边月，铁笛晨吹鹤背风。\n惆怅旧游归未得，天涯翘首送冥鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题怡闲卷和都察院经历黄仲?韵","author":"黄仲昭","text":"声利劳人鬓易斑，红尘终日走间关。\n始知廊庙千钟禄，不及丘园一味闲。\n载酒日游花屿上，携书时向竹林间。\n因君便欲辞轩冕，风月平分数亩山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"绝句二首招诸友游东岩 其一","author":"黄仲昭","text":"一春强半雨中过，节过清明日始和。\n垂老看春知几度，乘春不饮欲如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"绝句二首招诸友游东岩 其二","author":"黄仲昭","text":"细君手酿已新篘，准备寻春作胜游。\n明日东山修褉事，不知诸友肯从不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题夏太常竹送周翠渠知广德州 其一","author":"黄仲昭","text":"天上清卿写竹工，分明淇澳雨中丛。\n赠君去作鄣城守，德业期同卫武公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题夏太常竹送周翠渠知广德州 其二","author":"黄仲昭","text":"上苑琅玕高百尺，天恩浩荡饱曾沾。\n一枝带得銮坡雨，洒向南州散酷炎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题夏太常竹送周翠渠知广德州 其三","author":"黄仲昭","text":"郡在灵南山秀中，筼筜绕舍翠阴浓。\n清贫太守庖无肉，春雨犹能赦箨龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽陈教授先生廷威","author":"黄仲昭","text":"乾坤俯仰叹斯文，眼底何人更似君。\n一代才名追郑老，百年科第屈刘蕡。\n经横绛帐春风蔼，人去诗坛夕照曛。\n旧日林塘重过访，数声邻笛不堪闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽橘泉方文谟先生","author":"黄仲昭","text":"八十高年强健身，西风一夜殒庄椿。\n黎元正尔多奇疾，天地胡为夺此人。\n橘井泉深空自洌，杏林花发为谁春。\n刀圭我亦曾蒙惠，一束生刍泪满巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其一","author":"黄仲昭","text":"水石阴森烟月清，山中事事可怡情。\n始知世路闲荣辱，真与浮云一样轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]