[{"title":"下邳舟中和子公","author":"袁宏道","text":"飞雨贱窗湿，衣寒拥敝裈。\n所忧唯腊近，最苦是荼浑。\n只有飞沙市，更无啼鸟村。\n两渔相对语，舟系古槐根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集平山堂用平山字为韵偕游者方子两谢生也 其一","author":"袁宏道","text":"衰草乱畦平，长江一线明。\n云开智者寺，山表润州城。\n万井清霞气，千樯晚吹声。\n隋宫何处问，荆杞傍墙生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集平山堂用平山字为韵偕游者方子两谢生也 其二","author":"袁宏道","text":"天业空遗事，披图咫尺间。\n斜桥兴废水，淡墨有无山。\n野老囲香泽，妖狐学黛鬟。\n荒亭犹故井，马上挈泉还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邹子尹偕僧秋水见访门者不知却之相见乃一笑","author":"袁宏道","text":"几失孔文举，惊逢祢正平。\n云澄天自澈，月上海先明。\n渴骥闻泉喜，孤鸿见侣鸣。\n昭文琴自好，无那有亏成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中投宿栖隐寺寺去大冶五千里在乱山中 其一","author":"袁宏道","text":"下马历巑屼，晶晶四壁寒。\n山门云占断，佛舍雨浇残。\n茶好临泉试，松宜带雪看。\n轩窗无一可，孤负此峰峦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中投宿栖隐寺寺去大冶五千里在乱山中 其二","author":"袁宏道","text":"岩户何人启，泉声只自闻。\n夜浇盈衲雨，晓耨一犁云。\n野笋呼雏伐，山苗带子分。\n会须知此意，禅讲也输君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中投宿栖隐寺寺去大冶五千里在乱山中 其三","author":"袁宏道","text":"细数高低岭，閒询远近乡。\n山烟随涧出，松火隔林香。\n云冷莓苔殿，雪封萝薜墙。\n里门通德近，谁与辟荒凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春日金牛道中","author":"袁宏道","text":"田夫辍耒耜，红女停机梭。\n士人废简编，官吏罢征科。\n商贾离廛肆，渔家收钓罗。\n余独何人者，峻岭与危坡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汉阳过王章甫葵园和二仲韵","author":"袁宏道","text":"户外即遥岑，寒香渐出林。\n增池缘亩阔，疏竹为庭阴。\n烟雪裁为句，风泉写入琴。\n欲知桐性老，火里试焦音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中除夕忆李安人","author":"袁宏道","text":"客里逢除夕，灯前少故人。\n乍如云没海，忽似影离身。\n满褶衣衫泪，半年河渚尘。\n井枯泉脉在，栋老燕巢新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王章甫送余石头口因共游赤壁章甫将归读书九峰山 其一","author":"袁宏道","text":"小舫沙棠楫，矶头试一游。\n偶然偕郭李，不是吊曹刘。\n山色当陲出，江波载世流。\n沉沙无折戟，应已化渔钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王章甫送余石头口因共游赤壁章甫将归读书九峰山 其二","author":"袁宏道","text":"晴柳烟江路，幽探喜共君。\n暮风歌鸟翮，春水玩鱼纹。\n石老犹含态，蛟闲不起云。\n沙头寻鹭侣，且莫话三分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王章甫送余石头口因共游赤壁章甫将归读书九峰山 其三","author":"袁宏道","text":"一棹别乌林，高云去去深。\n易销唯黑发，未了是名心。\n洗墨桐花下，读书石壁阴。\n明年定传写，千纸满璆琳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柳浪馆杂咏 其一","author":"袁宏道","text":"柳匝层层水，花纷曲曲堤。\n古藤随意拙，熟鸟任情啼。\n寄客诗题岳，招僧语隔溪。\n菱蒲分外长，渐与竹栏齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柳浪馆杂咏 其二","author":"袁宏道","text":"偶然修竹里，新鸟一回闻。\n鸡下翻盆石，僧归语峤云。\n纵风生水态，任月织波文。\n莫遣鸥凫去，频来只有君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柳浪馆杂咏 其三","author":"袁宏道","text":"饶水饶烟地，谅花临柳居。\n经营成净社，穿凿架僧庐。\n小作番唐像，闲堆农圃书。\n主人荤血断，鹤亦念溪鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柳浪馆杂咏 其四","author":"袁宏道","text":"斋阁行将近，迂回又隔蹊。\n八窗中远水，万柳外长堤。\n凿曲添鱼舍，芟枝减鹤栖。\n无人残暴汝，宜近亦宜低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过藕花庄","author":"袁宏道","text":"深院竹编墙，丛梢若个长。\n入门溪雨溅，满路麦风香。\n好梦因凉得，閒愁到水忘。\n因循二十载，来到藕花庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日同顾朗哉居士王遗狂游谢公岩主人于野宗侯留饮 其一","author":"袁宏道","text":"只有烟林在，王家一事无。\n到门唯藓石，对语画山臞。\n路失云相引，厓攲竹可扶。\n看人车马去，尘起是修途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日同顾朗哉居士王遗狂游谢公岩主人于野宗侯留饮 其二","author":"袁宏道","text":"莫损莓苔壁，长留翠倚空。\n云能供点缀，石自解玲珑。\n泉落当窗径，香生渡涧风。\n楼台杳何许，树影有无中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登定州开元寺塔 其一","author":"袁宏道","text":"孤塔三千级，俯身见鸟过。\n但知天阔远，未许岫嵯峨。\n铃语闻沙塞，灯光射虏河。\n昔贤谁眺此，韩宋与东坡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登定州开元寺塔 其二","author":"袁宏道","text":"我醉中山酒，兴衰渺莽间。\n宋家遗塞垒，唐典旧河山。\n破壁风雷出，空堂燕雀还。\n莫言无外警，西去即层关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄竹石入都作别","author":"袁宏道","text":"北阙何曾过，西山亦未登。\n袖中无半刺，须上有层冰。\n梦入冲烟鹤，书询过海僧。\n省庐真似水，知汝不求丞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"残冬选曹乏人戴星出入不觉过春感而赋此","author":"袁宏道","text":"若问曹中事，但观鬓上丝。\n经年未见水，初度也无诗。\n夜月閒杯子，春光恼侍儿。\n西郊有游骑，唯汝不相宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初授司功副郎","author":"袁宏道","text":"舍锻来为吏，嵇康也未慵。\n带犹悬素銙，衔得比青松。\n案牍心先碎，疏题手自封。\n何年桂神武，买断紫芝峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒食高梁桥","author":"袁宏道","text":"簿领送春光，须眉分外苍。\n僧犹怜我老，水亦怪人忙。\n两作青山色，风吹翠袖香。\n醉中如有忆，艇子上馀杭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春偕苏潜夫丘长孺李茂实僧宝方雪照出郭","author":"袁宏道","text":"且复须臾坐，夕阳山气佳。\n人归烟雨寺，春到海棠花。\n茜甲缘畦吐，青溪带郭斜。\n楼台深隐隐，种竹定谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春同王以明丘长孺苏潜夫魏二方游韦氏庄得宽字 其一","author":"袁宏道","text":"几叶茭蒲水，微风亦起澜。\n如何寻丈地，绰有江湖宽。\n种果栽花易，招鸥引鹭难。\n辋川如具礼，画里试思看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春同王以明丘长孺苏潜夫魏二方游韦氏庄得宽字 其二","author":"袁宏道","text":"树历高云老，门临细水寒。\n乱中时有整，幽处偶然宽。\n芦笋芽将茁，槟榔蕊渐残。\n游鳞真可喜，梦不到渔竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春同王以明丘长孺苏潜夫魏二方游韦氏庄得宽字 其三","author":"袁宏道","text":"径路微微折，亭轩倍倍宽。\n经营百事善，物力屡朝看。\n果税分时敛，茶坊凑水安。\n袈裟幸自乐，何苦恋中冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮渭南郭外水亭","author":"袁宏道","text":"清响落银塘，崖高瀑白长。\n晴飞半院雨，暑洗一山凉。\n竹石江南梦，云泉逸士肠。\n长安卜日饮，金紫照壶觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜小修至 其一","author":"袁宏道","text":"疋马西风客，青衫远道人。\n倾觞三日语，洗面一升尘。\n发箧探家信，呼儿换葛巾。\n颜肥兼耳阔，失意几曾嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜小修至 其二","author":"袁宏道","text":"家事若蚕丝，细听无了期。\n某山今旷废，何仆最顽痴。\n验貌争肥瘦，谭心校髓皮。\n因勘对病药，第一是随时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜小修至 其三","author":"袁宏道","text":"俱言三岁苦，挨得几番虚。\n鍊就玉圭字，磨穿铁板书。\n莫非头罪过，傥亦慧乘除。\n知汝能排遣，高谭且自如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜小修至 其四","author":"袁宏道","text":"买米钱都尽，装衣絮亦无。\n奴颜愀失路，马尾秃长途。\n沙哭终雠楚，梁舂已去吴。\n弥天布铁网，不肯拔珊瑚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与小修夜话忆伯修","author":"袁宏道","text":"羁客观人世，孤云信此生。\n长兄官自达，小弟学无成。\n买酒思灯市，踏花忆贯城。\n飞沙没马首，怕不御街行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"百六诗为丘大赋 其一","author":"袁宏道","text":"血蚀青铜照，魂牵白玉环。\n人间冤女冢，地下望夫山。\n著土泪犹碧，邻湘草亦斑。\n至今西陵月，不忍向南弯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"百六诗为丘大赋 其二","author":"袁宏道","text":"一夕归兹路，三生惜此人。\n死无长负债，恨是不销尘。\n小玉终为厉，苏卿必有神。\n决猊与怒蟒，无以喻吾嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"百六诗为丘大赋 其三","author":"袁宏道","text":"恶雨催兰桂，饥枭啄凤凰。\n埋忧觉地小，量恨与天长。\n万者难焦泪，千生不化肠。\n明当告世主，幽合诅城隍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"百六诗为丘大赋 其四","author":"袁宏道","text":"怪事咄如许，稗官见亦稀。\n若无亲口语，定道客传非。\n始觉生为债，谁言鬼是归。\n长时检遗箧，不忍触歌衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"百六诗为丘大赋 其五","author":"袁宏道","text":"冤诉知无已，冥司可奈何。\n只愁女鬼弱，不怕俗钱多。\n双陆因名废，新声只自歌。\n唯当仗佛力，救汝出幽罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赴栖霞","author":"袁宏道","text":"黄叶三秋后，青烟一脉中。\n天寒虫蛰雨，江阔鲤鱼风。\n鹤瘦行藏劲，鸥閒饮啄工。\n舟迂迷去处，小立问渔翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"摄山纪游 其一","author":"袁宏道","text":"黄叶旋空下，清泉作雨飞。\n苔毛青佛面，石色老天衣。\n僧静厨蔬少，山寒野雀稀。\n自然消万虑，不是学忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"摄山纪游 其二","author":"袁宏道","text":"山色重重怪，高谭事事新。\n荒松吹老鬣，古石长斑鳞。\n入室寻僧梦，翻经晤客尘。\n禅兄兼酒弟，傲杀世间人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小集张伯实斋头","author":"袁宏道","text":"白菊颜将赭，苍原木渐黄。\n蟹匡行酒至，梧子作阎藏。\n钩月分兰焰，玄霜打橘房。\n主人红靺鞈，一笑上排场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问方子公病 其一","author":"袁宏道","text":"落尽梧桐叶，萧骚满一庭。\n当书裁枕被，减食买参苓。\n壁暗秋虫泣，垆攲夜火青。\n病来曾几日，疏发冷生星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问方子公病 其二","author":"袁宏道","text":"贫病知何极，高天也不原。\n愁声彻晓夜，药气满楹轩。\n梦恶凭奴解，衣单借手温。\n空堂悬一榻，黄叶自封门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李季宣比上 其一","author":"袁宏道","text":"长短丹枫道，高低白雪枝。\n奚如肩古帙，骏尾束红丝。\n闺月能通梦，边烽易入诗。\n因思誇官日，是我见朝时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李季宣比上 其二","author":"袁宏道","text":"策蹇迎霜去，冲风逆雁行。\n梦中呼小玉，瓮底拜荆卿。\n驿路听塘报，寒冬怯水程。\n预知廷对策，多半是谈兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"日暮","author":"袁宏道","text":"苍茫山几处，高下鸟千枝。\n野火烘云脚，霜风老地皮。\n安心权在酒，长日困于诗。\n除却閒居外，朝昏总不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望乡","author":"袁宏道","text":"无日无乡梦，空街与大堤。\n白长香米熟，青浅麦芽齐。\n荻月铺双寺，渔双冷孟溪。\n长江无尽处，渐觉雁飞低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"袁宏道","text":"掷却颠毛去，百无一事齐。\n客中稀信至，梦里别家啼。\n野店胡桃小，山房枸杞低。\n慇勤托鹪鸟，借取半枝栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蕴璞之通州","author":"袁宏道","text":"敝衲才三尺，羞囊无数钱。\n谭诗宗岛瘦，运笔想怀颠。\n白果行厨饭，枯株半夜禅。\n天涯青点点，一脉海门船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆潘景升","author":"袁宏道","text":"赤仄何年至，青蛾几日休。\n当衣归楚子，兑酒卖吴钩。\n冻雨江豚泣，邮风海若秋。\n相思无寄处，独上县西楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄伯修","author":"袁宏道","text":"次第逢京使，皆言鬓有华。\n廊餐博白饼，宫雪打乌纱。\n夜起先鸡唱，朝归必日斜。\n倦来呼侍史，石水试煎茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事","author":"袁宏道","text":"越锦刺吴女，桐弦命小妻。\n炉鸣茶已罢，香散日初低。\n近火观猫戏，閒窗听鸟啼。\n乡书修总懒，笑作两行题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扬州晓泊","author":"袁宏道","text":"薄雾随风尽，寒霜对酒销。\n芋魁腾晓市，蟹子趁归潮。\n往事琼花观，新沟杨子桥。\n虽然富罗绮，未必似前朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事","author":"袁宏道","text":"野树凋青叶，寒江扫白波。\n讹音东事变，重语北船过。\n衢橘连霜买，卢姬尽日歌。\n扬州饶嫁娶，箫鼓夜来多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得迷楼","author":"袁宏道","text":"古寺行宫是，荒台迹近真。\n枫枯能作语，钗老化为人。\n夜蜡烧天泪，秋蛾幻月新。\n当年倘不乐，难道不成尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小集吴嗣仙斋头","author":"袁宏道","text":"寒月冲帘薄，空阶似水凉。\n橘皮消酒气，栗尾乱书床。\n校拇人高下，踏歌调短长。\n自知非饮客，亦不喜欢场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集乔光禄斋头","author":"袁宏道","text":"烛气烘人煖，帘丝透月来。\n近花安饮几，分筱出重台。\n细曲龙香拨，清酣鹄卵杯。\n彻明尚不去，安肯见灯回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饭王太古馆中","author":"袁宏道","text":"万事无如静，浮云他自飞。\n身心全白业，行止半缁衣。\n山药和霜荐，园禽带雪饥。\n忘名兼去欲，学道古人稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"袁宏道","text":"贫色杯中减，衰音镜里知。\n青山千里屐，白发满头诗。\n夜雪烹朝水，鲜花勒陈枝。\n回身笑罔两，尔我共支离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀作","author":"袁宏道","text":"閒适鱼归水，孤羁鸟怯飞。\n寒江粘戍艘，贾俗厌儒衣。\n失路于人左，贪生学道非。\n无才甘自弃，不是怨知希。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中","author":"袁宏道","text":"盖膝衣三补，充脾饭一匙。\n长贫商贾贵，久客保佣知。\n开帖临黄字，关门变黑髭。\n飞蓬逐流水，何日是休时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒行","author":"袁宏道","text":"入肆添红晕，出门换白衣。\n雉惊过水去，雀冷近仓飞。\n古木半身死，邻僧一个归。\n客中无旧识，远望却依稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中看月","author":"袁宏道","text":"强起持杯酒，长歌命小鬟。\n一重两重白，千里万里山。\n冻鹤僵孤影，穷霜益老颜。\n客思只如此，渐梦别离顽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题","author":"袁宏道","text":"富贵岂非情，荣枯未必平。\n破笼麾鸟去，斸竹放云行。\n穷骨耽书傲，寒毛看剑生。\n东方唇自腐，执戟竟何成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读书","author":"袁宏道","text":"拭却韦编尘，衣冠对古人。\n著来皆肺腑，道破益精神。\n把斧樵珠玉，恢纲网凤麟。\n拟将半尺帚，匝地扫荆蓁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]