[{"title":"送严季祥会试","author":"孙一元","text":"远征此日怜吾子，木落苍山烟雾开。\n挂席独看淮北月，与谁同眺沛中台。\n上林冰雪愁时暮，万里江湖入梦来。\n此去君门看献策，济时须用出群材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日登南屏山漫兴","author":"孙一元","text":"南屏九日登临地，望里风烟秋事幽。\n青蕊娟娟怜物候，孤帆袅袅隔江洲。\n秦云陇树归心远，易水燕山落日愁。\n诗罢长吟还自伫，汀凫沙雁晚相游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留周用宾宿山中","author":"孙一元","text":"道人访我西湖间，拄杖月明闻扣关。\n焚香下榻夜初静，解衣对坐神自閒。\n眼中君似王摩诘，海内我亦元次山。\n短袍高帽意更远，同来白日游尘寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仲冬一日闻雷有感","author":"孙一元","text":"仲冬一日忽闻雷，无乃皇天号令乖。\n白日风云时自晦，横江波浪起争豗。\n千官不见居庸道，八骏空驰黄竹哀。\n北望何人经国计，野臣孤愤泣蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题倪司谏公在竹里馆","author":"孙一元","text":"使君家在渭川上，茅堂正对青琅玕。\n皇陂月出夜初静，紫阁云连秋映寒。\n已爱冉冉坐中见，更要潇潇吟处看。\n闻道南邻有蒋诩，携壶相过日高谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦郑继之","author":"孙一元","text":"不见平生郑广文，风尘侧望隔青云。\n殊方物色偏怜客，两夜灯花频梦君。\n隔叶山鸠高自语，避人江鹳独为群。\n眼中此日堪惆怅，塞北音书久未闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孟佥事望之载酒晚访湖上","author":"孙一元","text":"堆案不愁簿领急，青春画舫载歌行。\n看云湖上牵清梦，对客船头洗玉觥。\n沙岸行人枫树黑，水楼残夜月华明。\n追随此日真高会，四海相看意气横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送少谷子继之","author":"孙一元","text":"少谷山人去不返，洪河素舸坐长空。\n一官卧病菰蒲里，万里看山烟雾中。\n海内谈诗名已动，夜深说剑气还雄。\n关西野客应怜汝，君有当年季子风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登城漫兴","author":"孙一元","text":"独上荒城望九垠，长风吹月到天津。\n蛟鼍浪起全吞楚，鸟鼠山空远见秦。\n岁月虚惊青琐梦，江湖终要白纶巾。\n不须更道归来好，烂醉樽前软脚春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新筑苕溪草堂成","author":"孙一元","text":"白沙翠筱净江潭，新筑堂成映色寒。\n旋有飞凫临钓石，即看浴鹭傍清湍。\n扁舟此日鸱夷子，木榻经年管幼安。\n长暇南邻呼酒伴，一樽相对坐林峦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜访吾舍人廷介留酌","author":"孙一元","text":"白首相看笑语同，满楼秋色坐来空。\n瓶开美酒晚留我，心到古人今有公。\n一夜好诗灯晕里，十年旧梦雨声中。\n故山风物浑无恙，还结茅茨八九弓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游天竺寺","author":"孙一元","text":"楼阁排空送目劳，肩舆到寺步还遥。\n古雷破碣无全面，老树拿崖露半腰。\n盛世不须妆放逸，青山政尔要诗豪。\n归来湖上东风晚，带得芳鲜气未消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠青城道士","author":"孙一元","text":"新织鹭蓑间红羽，水云随处足徜徉。\n传来彭蠡鱼经古，见说眉山帽桶长。\n云冷听钟寻野寺，月明吹笛过江乡。\n如今去觅玄真子，还伴渔郎作醉狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梁溪舟中遇吾廷介廷顺昆仲口歌送之","author":"孙一元","text":"吴门北下喜相寻，乍见扁舟系水浔。\n感慨独收今日泪，昂藏同露百年心。\n高歌醉里江湖远，白发灯前夜雨深。\n此去秣陵如忆我，逢人还寄敬亭吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答邵国贤少司徒","author":"孙一元","text":"岁华荏苒坐成暮，江南十月叶乱投。\n沧海放身我何意，老松阅世天能留。\n虞卿著书只愁思，杜陵老病惟孤舟。\n几年格斗归未得，随地看云藜杖幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴节妇","author":"孙一元","text":"闺门节义纲常重，里巷何人咏竹洲。\n剔目要看同此烈，握符须信仰前脩。\n杼声细雨孤灯夜，虫语空堂万木秋。\n我为题诗重起叹，百年风化见皇猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仰则堂为吴孟昌题","author":"孙一元","text":"竹洲洲上有幽居，为继先人结搆初。\n野径古梅春事旧，石池孤月夜光虚。\n当时人去斯名重，绝代堂成仰则馀。\n须信乾淳经济在，异时家学有遗书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郑继之新着小乌巾访予作诗戏赠","author":"孙一元","text":"道人相见一笑同，乌巾自制誇新工。\n礼数懒慢政着我，山林风流今爱公。\n眼前物议一时事，溪边自照双鬓蓬。\n接䍦倒载间红羽，何当江上寻渔翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望海","author":"孙一元","text":"绝顶天风吹鬓毛，长天东去望中遥。\n沙边烟浪浮珠牡，岛上人家住翠鳌。\n万里閒情穷海岳，百年无事只渔樵。\n连翩尽日归来晚，看到潮生月色高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十四夜月下微醺仿邵尧夫首尾吟","author":"孙一元","text":"薄晚微醺对月圆，此时意象独能传。\n皇王有用从千古，鱼鸟无言共一天。\n好句忽成幽径里，春风初到野梅边。\n襟怀老大元无事，薄晚微醺对月圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"把酒漫成","author":"孙一元","text":"南窗不作裹足卧，出门万里随所之。\n宝书长剑岂无意，白日高歌应自奇。\n杨子草玄遭客骂，杜陵痛饮真吾师。\n百年事业不须问，随地看山筇一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"率溪书院和韵","author":"孙一元","text":"构得茅堂枕石矶，矮篱匝匝槿相围。\n通渠水煖鱼知乐，隔坞梅开春有机。\n半引短帘供野望，漫搜奇句了残晖。\n阶前尽日无人到，绿上莓苔几片衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日孤山楼对酒","author":"孙一元","text":"玄晏先生不解愁，偶来湖上一寻幽。\n健杯到手倾巴峡，捷句惊人破蔡州。\n四野秋声酣晚日，半空云影抱晴楼。\n倚栏遥望归来处，家在青山最上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重过南屏山","author":"孙一元","text":"白帻长歌湖水隈，两年风物是重来。\n吟边忽漫乘高兴，亭上依然笑举杯。\n独树山花还自照，深春江燕故相回。\n寻幽此日真吾事，随意看云坐石苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有客访予南屏山中袖出铁笛作三弄予闻而作","author":"孙一元","text":"有客磊落江海情，袖中取笛时一鸣。\n初闻浪捲水龙咽，静听铁击珊瑚声。\n汉戍三秋泣沙碛，胡雁中宵悲月明。\n感时去国意无那，折柳落梅能自生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"槜李城别倪世亨","author":"孙一元","text":"槜李城边春意动，与君半月喜连翩。\n弱条丽蕊看梅柳，白发青樽且岁年。\n交友晚逢文举喜，诸郎早得仲容贤。\n西归他日同乘兴，万里清江放舸船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居","author":"孙一元","text":"幽居结搆远风尘，长爱青山老此身。\n隐几忘言真得道，闭门却扫不逢人。\n近湖鹳鹤来终日，绕屋棕篁青过邻。\n唤起林逋同载酒，六桥风月兴犹新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠申将军制阃蓟门","author":"孙一元","text":"青云鼓角动边畿，白日旌旗赤羽飞。\n直免苍生忧社稷，喜闻天子卸戎衣。\n三秋瀚海风传檄，万马燕山夜破围。\n他日功成忆孙楚，江边来问钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夜携诸友澉墅湖泛月望海","author":"孙一元","text":"中秋此地成高会，山雨初收澉野隈。\n望里星河舟楫近，坐中沧海酒杯开。\n月明静抱鼋鼍出，树色晴浮岛屿来。\n烂醉狂歌真自得，回头天地莫生哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感二首简休阳程世大 其一","author":"孙一元","text":"长吟独坐思冲冲，回首江湖梦寐中。\n石壁青灯悬夜雨，山城画角散天风。\n十年故国忧戎马，万里音书滞塞鸿。\n避地风烟怜杜老，草堂今寄浣花东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感二首简休阳程世大 其二","author":"孙一元","text":"北风雨雪岁潇潇，问舍求田意已劳。\n去国久堪衣佩玦，抚时空惜剑吹毛。\n齐东郑泰名应早，邺下田畴气自高。\n回首风尘今万里，侧身天地一渔舠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽居","author":"孙一元","text":"小结幽居苕水上，坐分沙草地应偏。\n鸣鸥浴鹭春长满，翠木凉云江可怜。\n白日著书真自适，青山招隐不虚传。\n扁舟亭上时来往，独有侯芭问太玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题程世洪栖云楼","author":"孙一元","text":"楼上閒云万顷漫，爱云长日倚阑干。\n岩花半落岚光重，木叶乱鸣江雨寒。\n野老自甘泉石味，儿童时进蕨薇盘。\n閒来更觉青山好，湘簟疏帘静里看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆郑继之","author":"孙一元","text":"年来苦忆郑夫子，独坐幽林兴转孤。\n皛皛鸥群回晚日，青青菱叶散春湖。\n何时共采金鹅蕊，此日君犹银兔符。\n一笑沧洲终自去，那堪风物眼中殊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过陈进士遂初湖上草堂","author":"孙一元","text":"盛年射策怜吾子，早卜茅堂湖水涯。\n卧病沧洲心自得，看云白日首重回。\n鵁鶄鸂䳵柴门近，翠石寒沙水叶开。\n作客乾坤吾自放，终当同隐白云隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜雨","author":"孙一元","text":"骄阳一雨动林皋，喜极呼儿破白醪。\n石壁青灯云色乱，草堂丛竹夜声高。\n苍生望岁心偏切，独客忧时意已劳。\n水满前湖风日好，钓丝十尺弄渔舠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"草堂","author":"孙一元","text":"溪上高秋云木凉，地偏人事不相妨。\n开门江日流书幌，背水秋花照草堂。\n堑北买田时未就，舍南种竹已成行。\n幽居自拟王官谷，药裹书签引兴长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋","author":"孙一元","text":"中秋酒盏聊乘兴，南国兵戈未息机。\n作客惯看吴地月，忧时重泣楚臣衣。\n远江天入星河湿，高木吟回风露稀。\n一望沧洲终自好，百年只漫钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题范文予臞庵卷","author":"孙一元","text":"道人黄山梅花仙，瘦骨崚嶒神苍然。\n饮泉坐石幽涧底，衣草食木青厓边。\n汊川风物久作计，工部家学犹堪传。\n夜深兀坐松月静，独鹤一声柴庵前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐","author":"孙一元","text":"中庭露下湿征裾，独起苍茫伫望馀。\n河汉夜深人语静，海门潮上月华初。\n盛时去国愁难破，看剑烧灯气未疏。\n三载相看隔南越，故山戎马久无书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日登南屏山漫兴","author":"孙一元","text":"客中此日逢佳节，扶醉来登千树林。\n斜日碧云秋寺净，折荷残苇晚湖深。\n中原目送双流泪，老马时存万里心。\n何处草堂还可借，杜陵今有卜居吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李郎中元任过别湖上","author":"孙一元","text":"苦竹泠泠沙雨青，秋风别我钓鱼汀。\n好持使节朝天子，莫道江湖有客星。\n北固云回山历历，洪河龙斗浪冥冥。\n眼中经济须公等，殿上夔龙有典刑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"种竹","author":"孙一元","text":"种竹荒冈手记曾，满林苍翠尽腾凌。\n遥连野水青无间，斜压秋云冷不胜。\n惯觅渔竿防稚子，秪分拄杖与山僧。\n黄陵歌罢无人和，明月阑干只自凭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上","author":"孙一元","text":"沙砾喧寒雨，枫根挽钓楂。\n菰蒲起烟火，隔水是渔家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"解衣","author":"孙一元","text":"解衣坐渔梁，水风来许许。\n月明不见人，幽篁自相语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"靖江道中","author":"孙一元","text":"落日精灵语，空山旅客惊。\n沙寒留鹭影，风急走江声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钩帘","author":"孙一元","text":"钩帘坐晚吹，斗酒娱清晖。\n幽怀未可言，木叶不停飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孤山","author":"孙一元","text":"谁将一拳石，弃此湖水边。\n老梅盘拿春，玩弄到何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"相见","author":"孙一元","text":"相见不作语，天风吹长须。\n探取虎盘囊，留赠昆崙图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜晴","author":"孙一元","text":"鸟鸣隔篱落，雨脚上翠微。\n闭门吟正苦，客来为解围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日游惠山以老杜一径野花落孤村春水生衍韵次第得诗十首 其一","author":"孙一元","text":"春色满三分，梅事过其一。\n不有载酒游，白日去更疾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日游惠山以老杜一径野花落孤村春水生衍韵次第得诗十首 其二","author":"孙一元","text":"茅堂藏山隈，寻转更幽兴。\n一鸟浴寒塘，数花明小径。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日游惠山以老杜一径野花落孤村春水生衍韵次第得诗十首 其三","author":"孙一元","text":"石桥斜斗水，竹杖行堪把。\n隔溪鹤如人，相看不知野。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日游惠山以老杜一径野花落孤村春水生衍韵次第得诗十首 其四","author":"孙一元","text":"境静山光合，门临钓石斜。\n老翁抱瓮出，清晓来灌花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日游惠山以老杜一径野花落孤村春水生衍韵次第得诗十首 其五","author":"孙一元","text":"半里同井臼，数家带篱落。\n溪翁留白鱼，社友移新箨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日游惠山以老杜一径野花落孤村春水生衍韵次第得诗十首 其六","author":"孙一元","text":"向晚意不歇，残阳澹欲无。\n渔榔隔浦断，樵响入云孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日游惠山以老杜一径野花落孤村春水生衍韵次第得诗十首 其八","author":"孙一元","text":"短策时寻句，高怀自领春。\n山禽莫相避，我是住山人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日游惠山以老杜一径野花落孤村春水生衍韵次第得诗十首 其九","author":"孙一元","text":"卸杖坐松根，觅句烟云里。\n得意酬青山，一掬野泉水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日游惠山以老杜一径野花落孤村春水生衍韵次第得诗十首 其十","author":"孙一元","text":"归来吟不了，剩有水云情。\n船头借渔笛，韵中明月生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"净业二首 其一","author":"孙一元","text":"薰炉参鼻观，蒲团伴法喜。\n闭门风叶堆，半月书不理。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"净业二首 其二","author":"孙一元","text":"容成觉么虫，盘特了一句。\n我今无所闻，结茅双松树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜","author":"孙一元","text":"道人晏坐起，推窗时一吟。\n白鹤忽不见，月明秋满林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂咏四首 其二","author":"孙一元","text":"云容溪上澹，木叶山中稀。\n野客青丝屦，高人白板扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂咏四首 其三","author":"孙一元","text":"雾霭湿空山，招提路未分。\n穿林人不见，钟磬却相闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"毛应奎副使隐居严陵钓台赴召小诗赠之","author":"孙一元","text":"长风吹去棹，万里客星孤。\n何物为君赠，桐江画作图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋晚","author":"孙一元","text":"秋晚不扃扉，秋亭一叶飞。\n采莲人不见，水面落红衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永夜","author":"孙一元","text":"黄叶下西阪，山空秋正清。\n永夜无人语，残河尽意明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"避客","author":"孙一元","text":"报客频劳鹤，束书更住山。\n从今松桂里，散发弄潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成二首 其一","author":"孙一元","text":"寒日下高木，照见女几山。\n豺虎声相闻，何人当九关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]