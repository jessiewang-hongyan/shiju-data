[{"title":"哭李师文宪副二首 其一","author":"顾璘","text":"激烈先朝疏，沉沦积岁年。\n初闻登宪府，倏尔掩黄泉。\n伯道终无子，冯唐岂乏贤。\n彼苍犹忌刻，那望世人怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57842,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭李师文宪副二首 其二","author":"顾璘","text":"谁夺千金璧，俄崩万丈松。\n羁魂逢鵩鸟，直气化蛟龙。\n吏道循良传，人伦孝友容。\n长号呼不起，泪满若堂封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57843,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭景伯时中允","author":"顾璘","text":"中允璠玙器，临年失庙廊。\n江山空尔秀，科第竟谁光。\n志屈经纶略，名蜚翰墨场。\n石渠刘向陨，徒使汉庭伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57844,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄颜唯乔","author":"顾璘","text":"憔悴淮阳别，归田近若何。\n应知闭户后，祗是注书多。\n龙去逃江海，鸿飞挂罔罗。\n雪深僵卧夜，县令莫相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57845,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别刘元瑞还寄苕溪四首 其一","author":"顾璘","text":"出处意谁测，去家今几年。\n病辞乌府节，归泛太湖船。\n琴鹤居何定，莼鲈味独偏。\n长歌自南下，不问买山钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57846,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别刘元瑞还寄苕溪四首 其二","author":"顾璘","text":"仗钺临雄镇，输忠翊大廷。\n紫霄搏鹗隼，白日走雷霆。\n即拟参元化，何因赋独醒。\n风尘闻望眼，历历太行青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57847,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别刘元瑞还寄苕溪四首 其三","author":"顾璘","text":"不筑江东宅，仍寻苕上庐。\n乾坤俱传舍，丘壑且樵渔。\n托迹庞公隐，陶情逸少书。\n终泥紫金鼎，安坐讲玄虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57848,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别刘元瑞还寄苕溪四首 其四","author":"顾璘","text":"郊居尘事息，嗒尔寄禅房。\n菜甲供晨夕，松林傍雪霜。\n客来幽兴起，官罢病身强。\n颇笑陶彭泽，醺醺混道场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57849,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寺宿再别元瑞四首 其一","author":"顾璘","text":"寺阁悬灯宿，幽期记昔年。\n风烟几分手，湖海各回船。\n疏广辞官切，稽康习性偏。\n相逢多贳酒，囊罄莫论钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57850,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寺宿再别元瑞四首 其二","author":"顾璘","text":"余病隐吴市，君归辞汉廷。\n鹤栖宜独树，龙卧恶惊霆。\n江月维舟久，风泉唤酒醒。\n南山多旧意，相赠十松青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57851,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寺宿再别元瑞四首 其三","author":"顾璘","text":"世业刘公干，仙才汉子房。\n翻身下霄汉，砺齿漱冰霜。\n闭户诗书远，还山步履强。\n时应振馀韵，烂熳压词场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57852,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寺宿再别元瑞四首 其四","author":"顾璘","text":"赫赫中丞贵，归与一草庐。\n委心同野马，垂钓即溪渔。\n节映冰壶立，名遭汗竹书。\n平生行己意，披豁对青虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57853,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东园分韵","author":"顾璘","text":"竹坞红亭隐，松岩碧磴悬。\n云光浮蚁爵，秋律应鹍弦。\n缓坐延明月，高吟对暮天。\n不因开洞府，何以狎群仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57854,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨再游","author":"顾璘","text":"细雨秋尘净，林亭异昔观。\n清游吾屡得，密坐客齐欢。\n草树春无净，池塘暮转寒。\n殷勤岩桂色，已谢两回看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57855,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮振之馆限韵","author":"顾璘","text":"高馆临槐柏，清筵引桂觞。\n淮南秋望迥，江左故欢长。\n气色琼枝映，词华翰墨香。\n只应今夕会，星聚比陈乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57856,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄吴县杨尹","author":"顾璘","text":"满目循良事，贤侯即古人。\n弹琴变民俗，飞舄杂风尘。\n棠树千家颂，桃花百岁春。\n枳栖难久滞，天上待持钧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57857,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄沐参将崧","author":"顾璘","text":"异姓王孙贵，偏裨将帅雄。\n威行蛮部落，名并古元戎。\n缓带辞兵印，长歌缀国风。\n不须伤薏苡，天听自多聪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57858,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"嘉郑老至","author":"顾璘","text":"郑老交亲久，新诗近见多。\n好奇游泰岳，为客傍黄河。\n故里馀松菊，幽寻更薜萝。\n养痾茅屋下，爱尔此经过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57859,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄水南田勤甫","author":"顾璘","text":"耿耿绨袍赠，频经洒泪深。\n相看万里别，独抱古人心。\n岐路俄星散，高才竟陆沉。\n辞官真得计，怡老乏黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57860,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宴守溪相国园亭二首 其一","author":"顾璘","text":"黄阁辞荣早，丹邱托兴遥。\n蓉池窥海岛，芝馆踏烟霄。\n卧处苍生望，忧馀素发飘。\n当筵心尽醉，秋爽讵能销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57861,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宴守溪相国园亭二首 其二","author":"顾璘","text":"窈窕平泉宅，清华独乐园。\n烟霞深晚景，花竹霭春温。\n招隐临丛桂，怀仙倚洞门。\n自惭尘土质，聊尔奉琴尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57862,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游虎邱二首 其一","author":"顾璘","text":"画舫疏帘雨，溪门落木秋。\n黄花仍对酒，白发两登楼。\n古井泉香发，荒池剑气浮。\n驱驰吾已懒，谁共老兹邱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57863,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游虎邱二首 其二","author":"顾璘","text":"故园初入望，嘉客且同盟。\n倚槛观秋稼，吟诗对晚晴。\n浦寒鸿雁起，天暝水云横。\n急管休催发，悲歌正有情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57864,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠吴医","author":"顾璘","text":"更入壶中市，新林种杏多。\n闭门看古典，汲井起沉痾。\n爱酒狂方朔，能医老华陀。\n茂陵方病渴，爱尔数经过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57865,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"将往吴下成少子婚罗质甫徐一之俞鲁用泛舟送至令桥二首 其一","author":"顾璘","text":"千古秦淮水，离觞我辈来。\n山河形胜出，舟楫画图开。\n秋色丹枫映，羁怀片雨催。\n吟诗别亲友，重发谢公哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57866,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"将往吴下成少子婚罗质甫徐一之俞鲁用泛舟送至令桥二首 其二","author":"顾璘","text":"婚嫁人间累，犹然及老夫。\n未成游五岳，先遣入三吴。\n恋别停孤棹，刘欢倒白壶。\n摩挲葛仙鼎，相向叹迷途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57867,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十三夜质甫诸君别去乘月行舟","author":"顾璘","text":"霜月明如昼，沙溪见底清。\n客疑灯下坐，舟向镜中行。\n读易无昏字，看山辨远名。\n祇应归棹上，翻遣别怀生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57868,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"溧水道中值雨","author":"顾璘","text":"旅次番番雨，山行活活泥。\n长途添马病，午饭迫鸡栖。\n作客欢应少，劳生晚尚迷。\n误辞贤宰约，忍听仆夫啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57869,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"野店","author":"顾璘","text":"急雨官塘道，篝灯野店门。\n茅茨连雾霭，车马带泥痕。\n男子四方志，王孙一饭恩。\n年来乍安稳，无乃咤心魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57870,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游光禄史巽仲宅溪山不值光禄","author":"顾璘","text":"咫尺千峰聚，周回一水通。\n壶悬蓬阆界，槎犯斗牛宫。\n野竹排云碧，溪花傍雪红。\n无劳见安道，幽兴自难穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57871,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜度九里湖","author":"顾璘","text":"烟波东郡阔，此水亦无垠。\n风起摇坤轴，云生抱月轮。\n蒹葭秋后思，江海病中身。\n夜舫迷茫去，逢谁可问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57872,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮雨登上方山","author":"顾璘","text":"暮踏孤峰雨，苍茫下界分。\n平湖铺大野，高阁挂行云。\n霜气明枫叶，天寒叫雁群。\n拟投僧舍宿，清梵夜堪闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57873,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陆子潜子远携酒过宿赠一首","author":"顾璘","text":"二陆吾邦秀，携壶问草亭。\n醇醪雨中醉，寒烛夜深青。\n宝气腾双璧，人伦赡六经。\n坐馀玄论洽，倾耳为君听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57874,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿太守姚大章","author":"顾璘","text":"耆旧襄阳满，耽吟复此翁。\n名跻作者列，身有古人风。\n避宠辞朱绂，含精守绛宫。\n谁云眉覆雪，转觉面如童。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57875,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"瓜洲江眺二首 其一","author":"顾璘","text":"把酒临江阁，洪波满目来。\n却看浮玉树，青壁转崔巍。\n水鸟孤飞下，风帆万叶开。\n古人输郭老，赋味尽雄才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57876,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"瓜洲江眺二首 其二","author":"顾璘","text":"日峤攒红树，云湍拥碧沙。\n春生江有色，地尽水无涯。\n虚阁归晴望，深杯领物华。\n乱山西去好，隔岸认吾家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57877,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望焦山莫至","author":"顾璘","text":"石斗东溟起，云含北固青。\n江山分气槩，风雨走精灵。\n处士轻龙诏，仙岩秘鹤铭。\n由来玄圃路，少许俗人经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57878,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮仲氏山池二首 其一","author":"顾璘","text":"凤叶摇新竹，虬枝结古松。\n宛临三亩宅，翻上九华峰。\n池净深深见，花繁处处逢。\n爱君多美酒，留赏兴从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57879,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮仲氏山池二首 其二","author":"顾璘","text":"池月衔楼影，岩云沁酒香。\n扣门无俗驾，开宴有韶光。\n暗水鸣轩砌，幽花近石床。\n淮南招隐地，丛桂更芬芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57880,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟次对月二首 其一","author":"顾璘","text":"穆穆春宵月，沄沄春水流。\n直窥千尺下，寒影动琼楼。\n烟草迷晴渚，风花入夜舟。\n关山吹玉笛，遗韵渺生愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57881,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟次对月二首 其二","author":"顾璘","text":"孤舟明月好，春思结川云。\n岸煖桃花近，洲香杜若芬。\n良辰空作客，薄宦未离群。\n不分清辉隔，钩帘过夜分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57882,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟胶","author":"顾璘","text":"川涸唯泥滓，舟胶不可过。\n安山一步地，千里渺银河。\n雨泽经春断，风霾彻夜多。\n欲寻沧水使，长楫请馀波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57883,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春四首 其一","author":"顾璘","text":"旅次移春色，沙暄碧草深。\n游丝横渡水，飞絮巧穿林。\n物态催年序，风光搅客心。\n不禁苍鬓短，衰白忍为侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57884,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春四首 其二","author":"顾璘","text":"故国春残日，暄风绽牡丹。\n诗成传绮席，人醉倚朱阑。\n久种能多萼，无言独耐看。\n十年虚此会，何用系微官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57885,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春四首 其三","author":"顾璘","text":"煖觉春衣重，閒知昼漏长。\n蛙声今日有，花片晚来狂。\n懒性憎书札，衰颜信药方。\n绝交非达论，那敢学稽康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57886,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春四首 其四","author":"顾璘","text":"齐鲁春全旱，焦原麦不肥。\n幸逢天子圣，端怪雨师非。\n世难占农务，吾生指钓矶。\n悬鹑行满眼，空著大夫衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57887,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"荅边太常华泉二首 其一","author":"顾璘","text":"远别书盈箧，相逢泪满襟。\n年均谁黑发，交久各倾心。\n并棹清川永，开樽短漏沉。\n与君论旧迹，转觉爱光阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57888,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"荅边太常华泉二首 其二","author":"顾璘","text":"坐挹松筠气，追怜玉雪姿。\n先朝名独盛，直道宦犹迟。\n骨肉交情老，风波世路危。\n苍生方切望，天意更谁疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57889,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠唐员外云卿二首 其一","author":"顾璘","text":"特达青云器，蹉跎白首郎。\n行藏身自得，今古意何长。\n秋日饶诗卷，江天一草堂。\n空怜贾太傅，流涕吊沉湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57890,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠唐员外云卿二首 其二","author":"顾璘","text":"京口通乡井，台南接宦游。\n谊先倾盖密，诗及倒囊收。\n黑绶真微物，清谈足胜流。\n新裁芰衣就，应许并渔舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57891,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日桐岩道中二首 其一","author":"顾璘","text":"野日正矜午，岭云难自凉。\n祗愁山石裂，渐觉黍苗黄。\n物役煎衰鬓，吾生习瘴乡。\n眼中多茂树，安得置藜床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57892,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日桐岩道中二首 其二","author":"顾璘","text":"居人犹洒汗，行子独何堪。\n鸟翼垂难戢，龙鳞渴未安。\n只疑临火井，谁暇乞冰盘。\n稍待凉秋至，萧萧见尔残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57893,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮定公竹院分韵","author":"顾璘","text":"片雨飘庭竹，微凉泛坐隅。\n不须千亩盛，且喜一尘无。\n避俗逃金界，忘情倒玉壶。\n眼中清供满，馀赏及盆蒲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57894,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟次呈林郡牧杨司理二首 其一","author":"顾璘","text":"昔结萧朱绶，今登李郭舟。\n秋随人共爽，晚觉意俱投。\n古树分堤绿，回川抱市流。\n疏帘同慰藉，无酒亦销忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57895,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟次呈林郡牧杨司理二首 其二","author":"顾璘","text":"十日仙舟并，三秋逸兴多。\n天空披积雾，河润饱馀波。\n星斗连樯宿，风烟舞剑歌。\n百年饶意绪，倾倒柰君何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57896,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"经贼处复闻警","author":"顾璘","text":"举目堪流涕，萧条战伐尘。\n野花摇白屋，江燕啄青蘋。\n将帅恩私厚，朝廷法令新。\n连城忧盗贼，嗟尔异方人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57897,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蔡林屋举酒爱日亭玩月","author":"顾璘","text":"露下碧天凉，空庭明月光。\n幽人爱丛桂，举酒近池塘。\n河影填乌鹊，箫声下凤凰。\n莫教秋兴浅，不尽夜歌长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57898,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同诸君游碧峰寺","author":"顾璘","text":"净域秋如昔，佳宾胜在兹。\n壶觞牵野兴，歌咏发岩姿。\n殿古高云积，林深落照迟。\n莫留残醉去，他日怨暌离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57899,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿达公房","author":"顾璘","text":"旧地人重宿，劳生梦一醒。\n乱峰明积雪，虚殿纳疏星。\n僧发老逾白，佛灯寒更青。\n悠然生道念，对坐阅金经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57900,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送同年王奉常赴阙四首 其一","author":"顾璘","text":"鹏运方南海，莺迁更上林。\n礼容恢国步，人望简天心。\n朱绂群公列，彤墀委佩音。\n台衡应不远，四海望商霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57901,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送同年王奉常赴阙四首 其二","author":"顾璘","text":"王氏名流众，韦家相业优。\n满床乱簪笏，夺目见琳璆。\n一卧留丹壑，崇班尚黑头。\n鼎彝千古业，晚节会须收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57902,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送同年王奉常赴阙四首 其三","author":"顾璘","text":"虎榜论交后，差池有岁年。\n相逢俱暮矣，怀抱各依然。\n余钓东南水，君还尺五天。\n离愁将去棹，冉冉隔江烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57903,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送同年王奉常赴阙四首 其四","author":"顾璘","text":"观风来几日，览胜有馀情。\n汉阙留关右，周王重镐京。\n乾坤缠水府，龙虎抱山城。\n纸价休惊重，班生两赋成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57904,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张参戎园十首 其一","author":"顾璘","text":"时物易代谢，名园偏较迟。\n松杉无改色，花卉递生姿。\n托兴双樽酒，澄心一镜池。\n请看新种竹，取次发孙枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57905,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张参戎园十首 其二","author":"顾璘","text":"郁郁吴山色，居然隐几看。\n岩峦排闼至，风雨捲帘寒。\n尽日开图画，伊谁振羽翰。\n差差龙凤岭，飞舞绕朱栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57906,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张参戎园十首 其三","author":"顾璘","text":"兀坐华轩下，相邀待月生。\n未看离大海，先喜照前楹。\n庾老情非浅，陈王赋欲成。\n绕池多少树，萧索送秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57907,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张参戎园十首 其四","author":"顾璘","text":"迟日散花影，离离幽意新。\n美人娇写照，狂客醉留春。\n醒酒宜眠石，搴芳莫动尘。\n年来空色相，己悟净为真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57908,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张参戎园十首 其五","author":"顾璘","text":"东风吹玉蕊，晴雪谩离披。\n石径寒香积，苍苔晚色宜。\n多情沾短屐，故作泛残卮。\n无限相思恨，君听横笛词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57909,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张参戎园十首 其六","author":"顾璘","text":"一春长病酒，小啜向寒塘。\n掬得梅花影，添留齿颊香。\n填胸无俗物，吐论发馀芳。\n悟取清冷味，何须列鼎尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57910,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张参戎园十首 其七","author":"顾璘","text":"月痕如半璧，下印碧池深。\n光动虚无境，寒龙不敢吟。\n空林垂露采，清夜净人心。\n坐尽西岩影，悠然万籁沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57911,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]