[{"title":"边词 其十四","author":"徐渭","text":"十八盘南甃沸汤，燕京楼子待梳妆。\n当时浴起萧皇后，何似骊山睡海棠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"边词 其十五","author":"徐渭","text":"邯郸才人似花枝，嫁与辽东厮养儿。\n懒向楼中拈粉絮，解从马上寄征衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"边词 其十六","author":"徐渭","text":"黄鼠白脂捷遁逃，夜猴搏鼠捷于猱。\n将猴比鼠无多大，自古獐麋怕皂雕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长干行 其一","author":"徐渭","text":"玉人夜夜板桥湾，金尽萧郎隔水看。\n不分踏楼骑凤脚，偷来桥外立红阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长干行 其二","author":"徐渭","text":"木兰艇子夜夜开，桃叶桃根太往来。\n搅起鸳鸯双睡翅，倒嫌他扇落金钗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长干行 其三","author":"徐渭","text":"红板青楼是尔家，鸳鸯家做在荷花。\n月明打开犹自可，月黑打开愁杀他。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长干行 其四","author":"徐渭","text":"野鸭鸳鸯姊妹如，打散鸳鸯鸭亦飞。\n月落沙空俱不见，满江鹅鹳吊雄雌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钟子投我篆章答此","author":"徐渭","text":"定是元常几代孙，朱砂小篆遂专门。\n谁知老子壁拆路，竟让新郎屋漏痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟往中止","author":"徐渭","text":"绿菽胡麻各一盘，怜君饷我每朝飧。\n犹闻灶下青衣嫂，打饼铺椒脆月团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"菊","author":"徐渭","text":"百草诸香百露漙，一时非不哭湘沅。\n千年独有黄花瘦，为伴行吟瘦屈原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曹秀才","author":"徐渭","text":"来为亲铭几日留，归船正遇荻花秋。\n高樯莫戛江边树，恐有啼乌在上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"默泉篇","author":"徐渭","text":"泥金小扇月分团，淡淡烟煤写默泉。\n泉水有流不作响，正如琴上不绷弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意","author":"徐渭","text":"只堪话旧作生涯，若论风情鬓有华。\n记得金钗堕双凤，十年前夜舞谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王元章墓","author":"徐渭","text":"君画梅花来换米，予今换米亦梅花。\n安能唤起王居士，一笑花家与杰家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄沈子","author":"徐渭","text":"两月归家不出门，溪边荷叶大如盆。\n不知近到西湖上，更大如盆有几根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠孙山人","author":"徐渭","text":"龙津先生高角巾，多能不特是诗人。\n昨宵与客溪桥上，话到风平水不鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山阳歌醉中赠鲁君","author":"徐渭","text":"淮河流水尽芦苇，明府冰清貌苦羸。\n却说故人禅灶冷，为烹一尺鳜鱼肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽陈君之配蒋","author":"徐渭","text":"陈君辖我饮青春，焦革贤闺酿绝伦。\n若举醉乡祠祭典，沈香先刻蒋夫人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芙蓉死","author":"徐渭","text":"旧种芙蓉今不活，跏趺秋草看明月。\n红颊成都卖酒人，与欢亦是千年别。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟 其一","author":"徐渭","text":"一辞羌马献兰䈥，四海歌谣美汉文。\n天为吾皇厌祥瑞，不教麟犊恼明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟 其二","author":"徐渭","text":"光山产麟光烛天，无心住世去飘然。\n鲁叟若逢应不哭，不比哀公十四年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟 其三","author":"徐渭","text":"帝王瑞到我皇真，主圣臣贤尽凤麟。\n即看阁上千秋画，不羡牛边数叶鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟 其四","author":"徐渭","text":"吾皇巳却千里马，天亦踌蹰五采麟。\n尚恐越裳重译至，急传黄纸与边臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟 其五","author":"徐渭","text":"清时麟夭不须伤，野老番为哭一场。\n傥似角端能解语，欲传一语奉明王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟 其六","author":"徐渭","text":"鳞中许贡止常鳞，但取冰鲥片厣新。\n五马敢团茶叶饼，一车不动荔枝尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟 其七","author":"徐渭","text":"南潦北旱禹汤年，何瑞能回圣主怜。\n亲御布袍行十里，汗香飞绕一坛圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"麟 其八","author":"徐渭","text":"闻道麒麟斗海东，亲令白日蚀当中。\n牛肠鳞甲知何物，干犯天光半夜红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔鼓词四首 其一","author":"徐渭","text":"卢家双燕不双栖，南浦鹧鸪日夜啼。\n红绵如水单衾大，冷煖在郎归不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔鼓词四首 其二","author":"徐渭","text":"大唐自古谚鱼洲，百贾囊钱入海流。\n央杀主人寻翠羽，不知鹦鹉在高楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔鼓词四首 其三","author":"徐渭","text":"虎丘茶叶昆山歌，专诸骨董刻丝梭。\n明月大家消一看，焉能人娶一嫦娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔鼓词四首 其四","author":"徐渭","text":"洞庭橘子凫芡菱，茨菰香芋落花生。\n娄唐九黄三白酒，此是老人骨董羹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林某 其二","author":"徐渭","text":"夏来凉夜似秋多，正好酣歌奈去何。\n欲买缠头无蜀锦，赠将白苧当红罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"设代林某答胡通政","author":"徐渭","text":"银台相望渺银河，瀫水情人待亦多。\n妾本一身非两体，一时难作往来梭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云州舍身台","author":"徐渭","text":"欲留躯壳巳贪哉，欲弃之贪更费猜。\n一弃一留都不计，道人偶上舍身台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慕兰篇","author":"徐渭","text":"新篁拗曲围成圃，碧玉垂花琢作条。\n终岁摩挲两无厌，剧于十五女儿腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 其一","author":"徐渭","text":"秋日高城大道边，黄花无处不金钱。\n撩钿惹鬓无他事，只助青楼镜裹妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹枝词 其二","author":"徐渭","text":"弄玉吹箫在凤楼，凤鬟度曲亦悠悠。\n略攒秋月双蛾晓，直遏行云一雁秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"盘古社树","author":"徐渭","text":"大枝入汉拔龙蛇，小叶凉人雨雪遮。\n三代以来无此物，欲从青帝问年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"托王老买瓦窑头银鱼","author":"徐渭","text":"宝坻银鱼天下闻，瓦窑青脊始闻君。\n烦君自入蓑衣伴，尽我青钱买二斤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"买得一猫雏纯黑而雄戏咏","author":"徐渭","text":"柳条不必穿鱼聘，花径冯教扑蝶行。\n从此牡丹须再画，要看一线午时晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五泄 其一","author":"徐渭","text":"紫阆村中一线微，穿厨入灶浣裙衣。\n无端流出高岩上，解与游人作雪飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五泄 其二","author":"徐渭","text":"斗厓紧接大槽平，长练难倾怒愈生。\n绝似海门潮正急，白头翻贴黑沙行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五泄雾","author":"徐渭","text":"茫茫一卵未曾分，倍觉悬流渺一痕。\n大似龙堂灯火暗，香烟几缕自黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七十二峰归来书寺壁","author":"徐渭","text":"五条挂练玉龙奔，七十二峰鬼斧痕。\n堕水堕驴都不恨，古来一死博河豚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自燕京至马水竹枝词","author":"徐渭","text":"沙浑石涩夹山椒。\n苦刺桑乾水一条。\n流出芦沟成大镜，石桥狮影浸拳毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"写扇与毬儿","author":"徐渭","text":"既巳明珠随口散，谁能明月绕身飞。\n何时接得裁文锦，送与毬儿作舞衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉则衷绯而西 其一","author":"徐渭","text":"最宜才子著红衫，万里青天坐片帆。\n何似雪深将酒伴，看君题字万重岩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉则衷绯而西 其二","author":"徐渭","text":"此去长江非浪游，两行别泪不胜秋。\n寄将三尺竹如意，为我严滩敲石头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过陈氏园看杜鹃花花高可十五尺馀郡中无其比也","author":"徐渭","text":"西蜀来时一寸高，如今丈五尚馀梢。\n翻霞弄日长空上，笑杀朱榴著地烧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"镜湖竹枝词 其一","author":"徐渭","text":"越女红裙娇石榴，双双荡桨在中流。\n憨妆又怕旁人笑，一柄荷花遮满头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39489,"sha256":"ed4816f919f168ab037d2a481a87ac236