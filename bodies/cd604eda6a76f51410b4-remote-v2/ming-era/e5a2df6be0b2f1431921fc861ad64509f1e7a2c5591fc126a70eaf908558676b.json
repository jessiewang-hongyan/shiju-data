明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39502,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李子送小景","author":"徐渭","text":"李君小景入斯文，不用毫端力一分。\n更是山腰能简便，墨痕断处便成云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39503,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔画 其一","author":"徐渭","text":"外看杨柳障渔汀，内必桃花闭武陵。\n曝网张鱼等閒事，且登岸上逐花行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39504,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔画 其二","author":"徐渭","text":"一翁醉梦一惺惺，各有湘潭渔父情。\n添写三闾来问答，真成出相楚骚经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39505,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为杭人题画 其一 帐竿木偶图","author":"徐渭","text":"帐头戏偶巳非真，画偶如邻复隔邻。\n想到天为罗帐处，何人不是戏场人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39506,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为杭人题画 其二","author":"徐渭","text":"一处飞槌一踏橇，锣声鼓韵走儿曹。\n无端士女如云集，也要丹青费笔描。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39507,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端阳题慕兰雪画","author":"徐渭","text":"十里空江一物无，青蓑曳雪老渔孤。\n酒筵正苦黄鱼热，对此寒生绿叶蒲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39508,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"唐伯虎古松水壁阁中人待客过画","author":"徐渭","text":"南京解元唐伯虎，小涂大抹俱高古。\n壁松水阁坐何人，若论游鱼应著我。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39509,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题折花美人图","author":"徐渭","text":"高髻阿那长袖垂，玉钗彷佛挂罗衣。\n折得花枝向宝镜，比妾颜色谁光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39510,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"抱琵琶偶伫蕉阴美人","author":"徐渭","text":"离宫给事小青衣，催送琵琶向琐帏。\n行到芭蕉忽回想，去年此日嫁明妃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39511,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画梅 其一","author":"徐渭","text":"凫牛两碟酒三卮，索写梅花四句诗。\n想见元章愁米日，不知几斗换冰枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39512,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云门寺题画梅","author":"徐渭","text":"浮桥流水雪潺潺，客子来游二月阑。\n蓓蕾巳青酸满树，梅花只就画中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39513,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹 其一","author":"徐渭","text":"叶叶枝枝逐景生，高高下下自人情。\n两梢直拔青天上，留取根丛作雨声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39514,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹 其二","author":"徐渭","text":"郡城去海不为遥，墨箨淋漓似郁蛟。\n莫遣风来吹一叶，恐于笺上作波涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39515,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹 其三","author":"徐渭","text":"片石苍苍映莽林，南宫如见拜难禁。\n牛车若使能移去，卖与侯家五百金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39516,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹 其四","author":"徐渭","text":"昨宵风雨折东园，那许从天乞一竿。\n数叶传神为不朽，儒寒道瘦任人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39517,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹 其五","author":"徐渭","text":"林梢片石墨初笼，冻笔勾寒入指中。\n急遣苍头沽一榼，破帘穿日荡杯红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39518,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹 其六","author":"徐渭","text":"笔底霜丛三四竿，园中解箨两三年。\n修蛇拔尾当黄土，小凤梳翎在碧天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39519,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]