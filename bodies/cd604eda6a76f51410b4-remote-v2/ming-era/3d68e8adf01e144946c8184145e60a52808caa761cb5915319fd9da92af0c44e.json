[{"title":"秋日忆早朝 其一","author":"温纯","text":"当年朝拱斗星移，飞鸟回翔亦有期。\n静听鸡鸣金钥动，喧传象过玉珂随。\n肃清秋色连宫阙，咫尺天颜入梦思。\n何日鼎新三殿后，侍臣重睹汉官仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日忆早朝 其二","author":"温纯","text":"暑退年年侍讲帷，秋来日日想朝仪。\n金流胶折非畴昔，鹄立鹓联正及时。\n漏待千门花作侣，烟开双阙月应知。\n忽闻少海恩波渥，即向文华拜赤墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋前四日集维益朱榴馆得残字","author":"温纯","text":"秋色愁肠夜乍寒，偶从看月一凭栏。\n海潮白拥江门雪，榴累朱悬洞府丹。\n林野总沾新雨露，闾阎仍苦旧凋残。\n爽鸠此日春将半，何得馀波动地欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋集余望筠馆时久坐方得月会逮税使之横于楚者又逢圣诞志喜分得山字","author":"温纯","text":"坐看皎月出云间，岂为扶阳力不悭。\n顷刻阴翳消宇内，普天光照遍人寰。\n正逢汤沐生春色，想见宫闱霁圣颜。\n自是大明千万世，将呼嵩岳寿南山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14037,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西台满考谢赐羊酒钞锭","author":"温纯","text":"朱衣使者降从天，下拜欢承雨露偏。\n楮币何缘分内帑，纶音似欲赦前愆。\n委蛇愧乏羔羊节，醉酒深惭饱德篇。\n不是作霖逢大旱，投醪漫想古人贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14038,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忧旱 其一","author":"温纯","text":"炎刘何意说乾封，雩罢今看舞燕从。\n岂向桑林躬六事，争歌云汉念三农。\n目前生意怜芳草，海内多愁望赤松。\n闻道吕梁洪尽陆，军储此日又难供。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14039,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忧旱 其二","author":"温纯","text":"西郊云起也纵横，不分星河夜夜明。\n近水园林何处绿，向阳葵藿几时倾。\n岂因东海冤犹结，可是弘羊烈未烹。\n却忆吾皇曾步祷，随车膏雨遍生成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14040,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送万伯修司马之镇蓟辽","author":"温纯","text":"异邦振旅九重知，锁钥亲提十万师。\n对奕先筹淝水捷，请缨欲向幕南驰。\n辅京列镇金汤在，属国三韩保障宜。\n只恐材官生髀肉，翻嫌款塞望羁縻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14041,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻谷中桥成先是以高僧福登力建万佛塔募缘致毕此工远近赖之志喜","author":"温纯","text":"悬空飞渡俯清流，为倚慈航在上头。\n题柱不劳歌蜀道，吹箫似已到扬州。\n綵虹斜向双龙挂，紫气高连二华浮。\n欲济巨川思大楫，应知明主梦相求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14042,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘伯时之登州","author":"温纯","text":"相逢把酒共登台，怅别衔情祖帐开。\n已有甘棠留梦泽，还须露冕向蓬莱。\n郡斋閒共仙人卧，睥睨平临蜃气来。\n渤海于今歌出牧，佩刀谁不让君才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14043,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"改予知儿和袁生微之戊子下第所作时儿与生同试顺天","author":"温纯","text":"涉世何妨共陆沉，聊从林壑惜分阴。\n任他按剑临明月，羡尔怀珍有炼金。\n江驿多梅春可寄，池塘生草梦频侵。\n莫忘献赋当年意，狗监相逢听好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14044,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱左使归衡州","author":"温纯","text":"雨雪青门供帐开，千年疏傅两贤哉。\n即从山色怜花径，总是君恩到草莱。\n灞上攀辕今日去，衡阳归雁几时来。\n莫愁按剑风尘薄，还为苍生叱驭回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14045,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周光禄册封晋藩归省","author":"温纯","text":"近臣持节渡滹沱，捧册遥临鹫岭过。\n故国重沾周雨露，新恩偏到晋山河。\n分桐帝子宗藩盛，负弩诸侯保障多。\n明主不忘骢马旧，莫因归省恋烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送祝将军伯良之任吴淞并序","author":"温纯","text":"承家綵笔雅能文，仗剑东南欲竖勋。\n郤縠诗书堪上将，君陈孝友试中军。\n澄江波静三吴月，镇海春回细柳云。\n燕颔登坛将万里，箕裘卫霍汉廷闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同董维益司寇蔡弘甫内翰集朱汝修保御脩竹馆得开字","author":"温纯","text":"杏林三径雨馀开，漫倚琅玕结伴来。\n如向渭川成别业，那逢燕市不衔杯。\n黄庭经为笼鹅写，綵笔吟看过雁裁。\n只恐疮痍仍满目，人人都望长桑回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14048,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次秋字","author":"温纯","text":"疮痍入梦起边愁，又值萧萧落木稠。\n何处征人惊雁影，谁家织妇望刀头。\n杯停河朔忧时日，月照关山出戍秋。\n为语请缨年少者，风尘海上未曾休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14049,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送秦给事使齐","author":"温纯","text":"纶綍传宣下掖垣，远持玉节过云门。\n夕郎暂辍芙蓉直，公子遥沾雨露恩。\n拥彗定馀从事醴，攀条故倚帝城园。\n淄青遗俗君应问，何日函封上至尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14050,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送贾德脩奉常使赵","author":"温纯","text":"容台清晓登征车，千里漳河入望初。\n本为景风持使节，不同当日曳长裾。\n韩陵山下还藏石，紫陌宫中好购书。\n帝子相逢应授简，赋成白雪寄双鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14051,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀雒阳翟座师","author":"温纯","text":"清时何事拂衣回，咫尺门墙望眼开。\n一自抡才称国士，遂令增价向金台。\n灌园户外真罗雀，结社花前共举杯。\n他日经过闻鲤对，春风满座尚徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14052,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张羽王言别得分字","author":"温纯","text":"虔刀把赠倍慇勤，暂合延津袂欲分。\n休向风尘愁按剑，且从杯酒细论文。\n莺花日下同为客，韦孟风流已到君。\n狗监若逢杨得意，赋成蚤上汉廷闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14053,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送秦二使君之蜀","author":"温纯","text":"一麾十载怅离群，乍晤那堪落叶分。\n重以神羊临绝域，几呼绿蚁对斜曛。\n草堂莫问悲秋赋，剑阁应传谕蜀文。\n此日西南豺虎甚，除苛万里喜逢君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14054,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题葵园","author":"温纯","text":"沁园春色盖倾初，日涉因成趣有馀。\n排闼青来山峍屼，当轩碧拥树扶疏。\n忘机迹与鸥相狎，卫足心仍藿共舒。\n况是侯王同姓者，何如藜杖夜雠书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14055,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宜川谢刘伯明年兄赙吊晤其弟叔贞 其一","author":"温纯","text":"不忘高义臭如兰，跋涉那知行路难。\n座对西铭堪论道，尊开北海且加餐。\n知君有意抟鹏翮，老我何妨戴鹖冠。\n他日看花游上苑，伫逢春色满长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14056,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宜川谢刘伯明年兄赙吊晤其弟叔贞 其二","author":"温纯","text":"从来意气重金兰，投辖多情况二难。\n乘兴不因雪夜尽，衔杯还并月华餐。\n书成已贵雒阳纸，赋就应弹贡禹冠。\n伯仲总为廊庙器，吾将垂钓老江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宜川谒刘太公墓有感","author":"温纯","text":"游燕杖屦趋承日，过里低佪想像时。\n我愧延陵将挂剑，谁怜有道为题碑。\n心灰杯泻千行泪，手泽肠回一局棋。\n极目松楸两地隔，不堪霜露系吾思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送辛甥省亲兼示诸甥","author":"温纯","text":"爱子趋庭共藁砧，又逢佳节酒齐斟。\n杯从河朔花争灿，腹坦琅琊月正临。\n敢谓家传同鲤对，蚤将文价重鸡林。\n老夫尘外消长昼，尔辈窗前惜寸阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠安肃郑公","author":"温纯","text":"兴来曾泛剡溪航，置驿何须羡郑庄。\n眼为金兰青似染，发同海鹤白于霜。\n看君合用安车召，念我终将小草藏。\n推毂未能羞献纳，临风先寄紫霞觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次汝脩观梅","author":"温纯","text":"帝里梅花向日红，巡檐不与少陵同。\n已分上苑枝头月，肯逐高楼笛里风。\n醉后共怜西圃盛，赋成谁似广平工。\n九重正想调羹手，莫道商岩有傅公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙午上元西社观灯登城楼次日桥上看龙灯同孔治甫暨薛龙阜胡含素梁君旭来阳伯驭仲家弟希孔得同字","author":"温纯","text":"村社招邀少长同，正逢皎月满晴空。\n欲从雉堞游天外，如暏鳌山在禁中。\n不夜城连南北合，长春花入绮罗丛。\n桥成灿烂龙争跃，鼓鬣双双戏彩虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李次溪制台奉召入理京营 其一","author":"温纯","text":"仗钺西征十二年，归朝丹诏降从天。\n开疆胜略虚韩范，系颈威名纪简编。\n宠渥三朝沾凤阙，姓名万里勒燕然。\n犹龙即向滹沱渡，还有函关紫气连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李次溪制台奉召入理京营 其二","author":"温纯","text":"原是当朝矍铄翁，治兵今向帝城中。\n新兼节制仍司马，旧领嫖姚尽总戎。\n刁斗风清山海北，旌旗日煖羽林东。\n高牙坐镇烽烟息，争看麒麟第一功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李次溪制台奉召入理京营 其三","author":"温纯","text":"十载旌麾独镇西，论功不止魏公齐。\n疆开千里生春色，波及三秦净鼓鼙。\n延世缇骑星拱极，荷天雨露凤衔泥。\n几几赤舄归朝去，无奈攀辕父老啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14065,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李次溪制台奉召入理京营 其四","author":"温纯","text":"陛见勋臣至自西，禁兵十万许谁提。\n中军上佐兼南北，一代元戎肃鼓鼙。\n飞盖首回二华远，登仙旌入五云齐。\n已知司马属人望，应筑长安拜相堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"藩伯王道服张宪周枉过草庐","author":"温纯","text":"老我归来学种瓜，干旄今到故人家。\n剡溪不尽王猷兴，渭水何劳传望槎。\n久借甘棠临绿墅，相逢投辖对黄花。\n欲为十日平原饮，忽漫车尘望渐赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕同董惟益司寇蔡弘甫薛鲁叔二太史集朱汝脩保御脩竹馆分得身字","author":"温纯","text":"乌鹊桥成玉露新，双星久雨阻通津。\n河边似作参商侣，机上空怜寂寞春。\n随俗曝裈聊复尔，穿针补衮是何人。\n又闻思妇深闺语，不及连枝叹此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仲春陪祀先师","author":"温纯","text":"太牢遣荐陋溪毛，窥见宫墙数仞高。\n节历中和方月魄，乐成金玉俨云璈。\n获麟千载伤吾道，歌凤当时入楚骚。\n此日辟雍争北面，忧时何必目频蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过保定许贞甫侍御墓见其二子","author":"温纯","text":"秋色萧萧向晚寒，谁家吹笛傍征鞍。\n子猷雪夜空乘兴，玄度风流也盖棺。\n野外月明骢马第，冢边烟锁钓鱼滩。\n相思十载平原饮，此日松楸对二难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王将军北征","author":"温纯","text":"几年坐镇海波平，忽听骊歌送北征。\n百队熊罴攀祖帐，一时笳吹动江城。\n营前细柳那堪折，匣底芙蓉若自鸣。\n共说承家多节操，伫看塞北请长缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠张甥","author":"温纯","text":"南台旧业擅名流，接武英贤欲奋脩。\n芹舍仰瞻墙数仞，桂轮辉映月中秋。\n即看綵笔追秦汉，定有青萍射斗牛。\n好共儿曹勤努力，吾将蓑笠狎群鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送马叔遇马千里卢敬之周汝信张学曾李国柱王荩伯胡颐玄张聚五张孺充陈维则安曰儒诸孝廉偕计","author":"温纯","text":"雪霁衔杯傍早梅，谁能不羡百花魁。\n上林已就相如赋，骏骨将逢郭隗台。\n三策献馀春宴渥，五云深处杏园开。\n王褒即有贤臣颂，凤起丹山蛰起雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送文仲子应举","author":"温纯","text":"交游三世似金兰，此日箕裘数二难。\n衣钵承家仍旧武，鹡鸰比翼向长安。\n逢时桃李花呈实，奔月嫦娥桂遇丹。\n上苑醉馀齐许国，老夫不复梦邯郸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"久阴芍药不开望垄有感","author":"温纯","text":"红药含芳惨不开，况逢阴雨助人哀。\n欲投綵笔诗全废，漫倚雕栏首重回。\n荒冢望为云里舍，斑衣翻作梦中莱。\n一尊彷佛承欢日，又听啼乌泪满腮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送来阳伯常脩之薛允执高大克石复朴偕计","author":"温纯","text":"塔寺重新带映虹，题名曾报五人同。\n秋深桂阙轮争綵，春暖桃花浪欲红。\n行见成龙为云雨，应歌鸣凤集梧桐。\n重令百二山河重，肯负周王棫朴功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"老僧岩 其一","author":"温纯","text":"独向中峰立，洪荒直到今。\n如何身不动，为悟石头心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"老僧岩 其二","author":"温纯","text":"色相空山里，无言亘古今。\n嵩山面壁者，还有去来心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"移居宣武街庭前有奇石四各题以名维益汝脩弘甫欣然赋诗余亦各得一首 其一 立禅僧","author":"温纯","text":"止锡天台似，石头今已矣。\n九年少室山，面壁亦暂耳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"移居宣武街庭前有奇石四各题以名维益汝脩弘甫欣然赋诗余亦各得一首 其二 二华峰","author":"温纯","text":"我有五亩园，当檐二华峙。\n山灵似有情，不约忽来此。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"移居宣武街庭前有奇石四各题以名维益汝脩弘甫欣然赋诗余亦各得一首 其三 邀月岩","author":"温纯","text":"云何安乐窝，从窟手探月。\n为悟生生机，天根于此发。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"移居宣武街庭前有奇石四各题以名维益汝脩弘甫欣然赋诗余亦各得一首 其四 化石岭","author":"温纯","text":"宁知木匪石，又知石匪心。\n不二者谁子，忘言亘古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浮光八咏 其一 戈山","author":"温纯","text":"郁嵂邻嵩少，仙人遗旧迹。\n苍翠薄青霄，烟霞烂白石。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浮光八咏 其二 淮水","author":"温纯","text":"东望长淮水，宛如渭水清。\n空明天一色，亦可濯吾缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浮光八咏 其三 春申宅","author":"温纯","text":"昔日春申宅，今时绛节宫。\n人事今时异，风烟昔日同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浮光八咏 其四 霸台","author":"温纯","text":"萧王古霸台，野旷望何极。\n月夜楚歌寒，草木无颜色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浮光八咏 其五 七里泉","author":"温纯","text":"荧碧小龙湫，郁葱腾佳气。\n独有洗心人，一歃知清味。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浮光八咏 其六 五龙宫","author":"温纯","text":"风俗存三户，雩禜寄五龙。\n有年书太史，无事忆乾封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浮光八咏 其七 刘墓","author":"温纯","text":"参军玩世者，醉德不醉名。\n天地馀抔土，古今诵达生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浮光八咏 其八 聚仙阁","author":"温纯","text":"小阁何岧峣，霏岚如动色。\n杖策问筌蹄，丹梯不可即。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过吕公祠","author":"温纯","text":"行役红尘里，仙迹古道傍。\n七年浑是梦，不必问黄梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望温岭温泉 其一","author":"温纯","text":"极目看山日望云，住山欲与白云分。\n老僧笑指东头岭，原是温名本属君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望温岭温泉 其二","author":"温纯","text":"把酒探奇坐紫岩，温泉温岭望中兼。\n二名偶合相传久，添我何妨共作三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同官姜女遮骑山","author":"温纯","text":"山灵亦为妇人哀，半路能令追骑回。\n何似愚公长障塞，免教骸骨尽成灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送远卿之幕滇藩 其一","author":"温纯","text":"不辞小草向承明，从臾多君过渭城。\n渭树江云怜日莫，忍看万里又西行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送远卿之幕滇藩 其二","author":"温纯","text":"万里风烟六诏生，壮游莫听鹧鸪声。\n行行即见薇垣紫，綵笔还看赋远征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊望","author":"温纯","text":"尽日奔忙半日閒，羞将尘眼对青山。\n山头似有栖云室，欲向山灵借半间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山行","author":"温纯","text":"冒雨登山望眼舒，翠微山色拥征车。\n只看足底烟云合，便是洪荒太古初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题铜雀台有感效陆放翁沈园之作","author":"温纯","text":"漠漠烟笼铜雀台，几年幽思若为裁。\n临流不敢开尘眼，怕见波涵只影哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送左金部夏伯之河西务","author":"温纯","text":"花底青樽为尔携，相看蓟北与河西。\n不堪孤邸仍分袂，醉听骊歌月影低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]