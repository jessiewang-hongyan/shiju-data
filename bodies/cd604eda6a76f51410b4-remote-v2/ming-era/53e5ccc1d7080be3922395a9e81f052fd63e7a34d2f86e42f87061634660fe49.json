[{"title":"题陈幼白石浪阁 其二","author":"范景文","text":"遵海忽南来，潮浪接紫荇。\n入夜梦寒光，虚寮涵素影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题陈幼白石浪阁 其三","author":"范景文","text":"枕流与漱石，共此静观中。\n高阁贮云气，将无性所同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题陈幼白石浪阁 其四","author":"范景文","text":"不学乘桴游，却为鞭石计。\n凭虚招米颠，花浪沾清袂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠三昧禅师","author":"范景文","text":"道是宗风盛，戒居定慧先。\n看花飞作雨，聚石击无烟。\n堂上三车法，灯前一指禅。\n往来乘愿力，大地拥金莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋杪二日招诸友集静远堂分得门字时扈芷天游二上人新至","author":"范景文","text":"共挹高秋色，茗杯远意存。\n囊云来古涧，绘雪艳耑门。\n花影当风乱，歌丝入夜繁。\n禅参清醉里，听曲莫销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿邱太安人为杨计部母","author":"范景文","text":"鸾珈色映綵衣新，栉帨曾随骨鲠臣。\n教化鲤庭勤杜稷，溯来熊梦叶天人。\n潘舆晴日花堪赏，陶母官厨性爱贫。\n见说冰心兼露洒，南天竞祝北堂春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊寅初度喜雨","author":"范景文","text":"冬燠知将雨，应期此日阴。\n春先梅意润，爽入酒杯深。\n滴沥寒歌韵，云雷激壮心。\n感时才易尽，漫自说为霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"落梅将残有作","author":"范景文","text":"花事亦何与人事，不禁开落自关情。\n雪中欲尽寒梅影，留取残枝待月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺李少文","author":"范景文","text":"凤毛代起重明光，御笔新分豸史霜。\n暂尔鸣珂娴礼乐，还看策驭问津梁。\n褰帷日映寒花丽，感事愁同雁字长。\n尺五恩章晖帝里，应知谏草映缥囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再寿太蒙宗兄","author":"范景文","text":"狼山菁葱海云薄，真人岳降鲲鹏壑。\n伊昔我祖宦海陵，丹穴一枝才焯烁。\n冰心蝉蜕薄专城，博学追随汉五更。\n十年郎署芬时誉，起部风清水镜明。\n叆叇卿云奉帝玺，翩然拂衣谢青紫。\n卜筑岩阿依白门，六代风流偕卧起。\n仙风飘缈生春姿，耆英高会浣花时。\n幸附埙篪进?醁，觞蒲好咏大椿诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日登雨花台","author":"范景文","text":"山光一带正迎人，选胜高台载酒茵。\n绮席閒分铺草坐，香尘似袅散花身。\n晴烟破晓青堪谱，浅黛描春翠可亲。\n解缚胜情还不碍，披云双屐试游新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月游摄山作","author":"范景文","text":"山寺春云护，披霞入渐深。\n品泉移谷口，选石费天心。\n磴转江能近，林空月不沉。\n无生吾欲證，灵药懒重寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游牛首山时方解官","author":"范景文","text":"看山雨后清于洗，天阙遥临翠可分。\n恰对峰岚如欲语，此来猿鹤免移文。\n塔移影转因回照，磴引身轻恍入云。\n坐定聊参火风义，空香何处觅声闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高座寺","author":"范景文","text":"绿云遮断寺边扉，如寄閒身向此归。\n山月每窥竹影瘦，松风忽泻茶声微。\n入来如共云分座，话久偏怜翠上衣。\n坐破蒲团无是处，眼前烂漫逗禅机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沮风夜泊","author":"范景文","text":"桡停月落暗江滩，何处吹帆夜未眠。\n自是随风侬不惯，乘流莫怨下来船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿薛千仞八帙时寓白门","author":"范景文","text":"少微星曜谢公墩，祭酒群推白社尊。\n笔下六朝供带草，眼中四世见芳荪。\n朱弦爱谱清平调，丝雨欣沾绮季村。\n夜读仙经和鹤啸，幔亭烟月接昆崙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送葛震甫归洞庭","author":"范景文","text":"夏寒新涨碧澌流，雨洒别筵感易秋。\n敝箧千篇存故业，孤筇万里侈奇游。\n清风满袖无馀橐，烟水当门好系舟。\n同是羁人先送汝，愁深忍复说离愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"祝何芝岳相国时为嘉平月万寿前十日","author":"范景文","text":"补衮功成日月间，赐裘红腻映童颜。\n庭栽玉树娱清昼，药采芝田养大还。\n九鼎犹存黄发老，一壶肯许赤松閒。\n冈陵恰祝嵩呼候，南国仍看北阙环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立秋日钱与立诸君送之广陵影园月下听歌次郑超宗韵","author":"范景文","text":"恰当胜地又佳时，暑去人来月与期。\n空水亭为开面目，新秋柳亦竞腰肢。\n园摹画格形生影，妙解歌情肉并丝。\n嘱语萧萧翻别调，登临无事更伤离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予与方书田相国同时被放舟次维扬饮文昌阁","author":"范景文","text":"艳说听涛正及秋，烟波一带望中收。\n莺花逗梦生閒恨，烽燧关情荡远愁。\n去国何妨聊问酒，思乡无奈只登楼。\n閒身并荷明王赐，避世相将访十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己夘九月杪再游摄山遇雨","author":"范景文","text":"笋舆经雨倍逡巡，虚想秋游胜似春。\n却对烟云如画里，入山仍作卧游人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与一门上人白云庵共话即用其韵","author":"范景文","text":"閒心与山意，秋际更相关。\n因雨增萧飒，有僧澹往还。\n云留翻碍寂，鸟过总归閒。\n挥麈通顽石，无言并可删。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白门重晤刘相国舟中共话","author":"范景文","text":"霜深黄叶满秋山，相对江头各解颜。\n四海无家经乱后，一身尽瘁忆行间。\n法明始欲求疏网，主晤何难立赐环。\n去国孤忠悬九庙，金縢启处绛车还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归舟暂泊京口","author":"范景文","text":"空航亦号五湖游，胜地真堪与唱酬。\n唯许卜邻招隐地，三山虽好懒淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登焦山","author":"范景文","text":"一棹凌波陟翠巅，潮生几席恍疑仙。\n山青忽断云沉寺，月白遥连水际烟。\n瘗鹤空闻铭石壁，盟鸥应许话江天。\n洞称避诏今犹指，道是逃名却更传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游金山寺","author":"范景文","text":"万顷波中独占天，客帆日夕望苍烟。\n过江车马劳尘劫，绕寺鱼龙稳昼眠。\n僧喜抄诗添墨拓，佛来香国记桑田。\n一拳已自涵空相，何必安心问了然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺茅止生举第三子","author":"范景文","text":"荀家才妙诞慈明，蹀躞云驹类所生。\n旧业留存铜雀研，赐袍剪作铁花绷。\n已知瑞国徵三索，但祝成人享太平。\n河朔恰逢消夏会，欢倾百斗故人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庚辰闰元旦作","author":"范景文","text":"天心重起贞元会，月纪春王序不穷。\n爆竹无声融晓日，冰花尽泮漾条风。\n夜忘守岁新人意，瑞再占云费化工。\n最喜太平频献寿，椒觞又进未央宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闰元宵作","author":"范景文","text":"闰来犹自唤元宵，灯事重重意亦骄。\n影粲星华梅尽绽，烟清火树雪全消。\n传柑盏更温前月，踏柳游还忆昨朝。\n天似多情人并韵，春深恰好试轻绡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闰元夕同茅止生诸友雨中听歌座间偶谈长生之旨客有以占候家为是月不宜闰者故并及之","author":"范景文","text":"常期计已过花朝，因闰称元再此宵。\n灯焰明因离月晕，歌情妙不借笙箫。\n驻颜酒当三千核，取景人疑廿四桥。\n赢得百年刚一遇，忧天无事问层霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同方孩未王子云及支浮诸上人华山月下共谈","author":"范景文","text":"参禅何处问宗风，欲断声闻棒喝穷。\n香散空阶花自寂，谁留影印月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿南少司农毕东郊老师","author":"范景文","text":"法星晓灿映长庚，钟阜遥看五色明。\n周召大猷勷武烈，东南元气巩陪京。\n泉流九府心能计，天柱四维手可擎。\n歌罢冈陵还进酒，缑山恍听夜吹笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题周江左鼎足斋斋中所贮书画古法物","author":"范景文","text":"结庐人外意萧然，香国翻成小有天。\n四壁忽生空翠湿，千秋如见墨痕鲜。\n摩挲金石人俱古，寝处缥缃梦亦仙。\n共我于中成鼎足，坐来谁羡米家船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送卢德水漕使于京口","author":"范景文","text":"奕奕丰棱朗遹云，澄清颂更满江濆。\n霜飞铜墨骢堪避，疏绘流亡草莫焚。\n齐鲁名咸宗泰岱，东南士尽仰河汾。\n明朝扬子仙帆渡，遥向三山挹紫芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立秋前四日同诸子秦淮夜泛计二十年再续此游感慨系之分得霜字","author":"范景文","text":"桃叶芳游梦未忘，廿年回首叹流光。\n秋将启候月先好，花与为邻蘋自香。\n溪涨声如听雪瀑，诗成字欲挟风霜。\n鸥盟长订秦淮水，一棹渔蓑岸柳傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王子云归楚","author":"范景文","text":"人道愁时我亦愁，秋风江上送行舟。\n孤高懒上春明赋，慷慨能抒国士筹。\n篷底正堪题雁字，酒家到处典鹴裘。\n欲过湘水怀明月，应忆秦淮古渡头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"途中见红叶用少章韵","author":"范景文","text":"曲曲寒塘点绿蘋，霜林远映倍精神。\n炤来光影宜朝日，别已经年见故人。\n黄菊为怜依晚径，青松独许作芳邻。\n游人试拭看花眼，冷艳秋容自不贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送太蒙宗兄还海陵","author":"范景文","text":"临岐执手意踌躇，秋老还归海上居。\n桃叶寒烟留拄杖，白狼翠色点衣裾。\n粲英正及寻三径，挥麈相将伴六如。\n我亦倦游思避地，卜邻踪迹溷樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠朝宗上人","author":"范景文","text":"心栖空不住，意色更轩轩。\n白鹤云间出，青狮座底翻。\n谈令龙耳听，定起石头言。\n竖拂开诸义，天花夜雨繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀倪玉汝太史","author":"范景文","text":"西湖感旧梦中过，桥畔秋容近若何。\n携奕山头皆谢墅，扣舷月下谱吴歌。\n星躔太史藏书丽，潮涌钱塘得气多。\n可忆白门孤啸者，江风萧瑟叹庭柯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠铉冲晋少司寇","author":"范景文","text":"帝德好生意已宣，皋陶新简众欣传。\n白门雨润膏滋黍，园土春生火长莲。\n真佛心慈能度世，仁人力大可回天。\n覆盆行望朝暾色，矫首卿云在日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送方尔止传经蔡兵宪幕中并司记室","author":"范景文","text":"柳澹风柔草色欣，春江帆影映斜曛。\n从戎自昔推才子，办贼于今属使君。\n剑气宵寒星斗动，书声晓动鼓笳闻。\n圣朝顿网旁求切，奏捷先看露布文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同雪峤上人游瓦官寺","author":"范景文","text":"廿载流光叹掷梭，乘春无意复相过。\n清阴不改留孙竹，老树曾经挂女萝。\n劫历刹随陵谷易，境幽香杂雨烟和。\n坐来试證无言谛，止水何须问定波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汰如返吴门","author":"范景文","text":"高坐谈经响法钟，又看拂麈问吴葑。\n懒残煨芋迎寒月，古德归藤伴老松。\n弟子教成香作雨，维摩健去舌无锋。\n枫林已订重相访，花路禅关莫便封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杜开之都督镇浙","author":"范景文","text":"汉庭秉钺重嫖姚，上将轻裘不拥貂。\n铃阁已清南国纪，雕弓欲射浙江潮。\n楼船雪霁飞双缆，健马烟寒驻六桥。\n遥忆旌麾移镇日，西泠月照铁花袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送雪藏上人将还匡庐","author":"范景文","text":"未识匡山面，逢师似已经。\n云峦光在眼，笔墨性能灵。\n言下三乘法，图中五岳形。\n倦游何处去，风雨路冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李少文按闽","author":"范景文","text":"霜花肃气秋，九月红如茜。\n送子驰青骢，丹山水飞练。\n频行重握手，忧时心悁悁。\n烽烟震我圉，茧丝悲赤县。\n谁为柱东南，济川藉手援。\n海邦幸无尘，时恐妖氛见。\n水镜澄官方，绣斧彰雷电。\n封事策金城，揽辔巡夏甸。\n庶以荅焦劳，入对含章殿。\n慎旃似尔祖，崇勋懋帝眷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋杪登安隐寺后山小饮适余筑精舍额曰萍庵因以萍字限韵","author":"范景文","text":"节过重阳秋易老，霜花著树映山青。\n妙高台望人皆蚁，云物波流室似萍。\n选梦聊分僧榻卧，徵诗借作梵音听。\n情多易感谁能醉，莫怪三闾叹独醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日游仲茅爰园 其一","author":"范景文","text":"夙约今方践，期春故尔迟。\n石犹存雪貌，柳渐逗烟姿。\n鸟嫩声能和，竹多径易疑。\n韵留歌尽处，酒半出新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日游仲茅爰园 其二","author":"范景文","text":"乐事应非一，清宵好放船。\n窗开缘月上，岸泊定花前。\n穿谷工疑鬼，回溪别有天。\n为欢愁漏短，明日隔风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周挹斋相君再召","author":"范景文","text":"绛车花拥草烟和，海宇风传尽舞歌。\n辅弼星明销孛茀，岱宗云出灌江河。\n功铭鼎釜书今续，玉称身腰发未皤。\n从此杞人无过计，补天晓看五云多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪峤禅师见过留坐将还径山诗以留之","author":"范景文","text":"秋原霜色懒招寻，鹤引高流入径深。\n茶醉酒醒难判断，身真世假任浮沉。\n参禅并入删元语，听曲翻能长道心。\n行脚无须商去住，心空何处不云林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿王季重石夫人六帙寿","author":"范景文","text":"林下高风女士行，名人绝代影相将。\n箧馀布素随仙吏，梦发兰闺育国香。\n凤翥云中风正饱，花明雪后日初长。\n齐眉笑对佳山水，岁岁綵衣进紫觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张九山给谏言事被谪","author":"范景文","text":"丹翰戾南国，矢音曜奇姿。\n梧掖肃秋霜，秉节陈危词。\n狐鼠已魄阻，凭城安所施。\n天意神颠倒，吾道无诡随。\n瞻彼高冈翙，何妨暂枳栖。\n君子司邦直，卑飞亦光仪。\n中诚苟不昧，剖衷对龙墀。\n嗟余抱孤愤，慷慨共心期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿方孩未年丈","author":"范景文","text":"秋花寄静枝，幽妍入蓉帐。\n霜气肃万物，孤松发条畅。\n君子古处心，坚于九节杖。\n狂流升推迁，末俗怀嘉尚。\n吾道赖主盟，骚坛亦宗匠。\n略寄安石棋，量倾次道酿。\n相看双发元，閒情悟昭旷。\n冰雪神仙姿，湘波泻清漾。\n药圃菊苗肥，枫林红叶飏。\n何处托远心，古衲互酬唱。\n黄粱梦蚤醒，百事任层浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送成宝慈侍御言事被逮","author":"范景文","text":"景运丽中霄，阶扉翳重雾。\n大道忽沦夷，疏稗茂嘉圃。\n抱叶秋风寒，独鹤扬清嗉。\n昌言排九阍，口诛振末步。\n未忧天听高，恐为先圣惧。\n伦彝既大明，生死何足顾。\n阳德正方亨，丰蔀莫能锢。\n风雷感帝心，昂首骧皇路。\n君子勖敬身，同心要主悟。\n莫言虎啮人，相戒公无渡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"去国辞陵忽大风雷","author":"范景文","text":"晓望钟陵紫气开，五年拱护愧非才。\n狂愚有罪臣应死，高厚无私怒易回。\n帝鉴自能明日月，孤臣敢诧动风雷。\n去天洒泪重回首，何日烽烟靖九垓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻黄幼元系释志喜","author":"范景文","text":"雪霁春风遍草莱，累臣系释日边来。\n尧仁又见三言宥，汤网今看一面开。\n庙社有灵深呵护，圣神独鉴自昭回。\n太平应卜天心转，海宇欢声动若雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿姜汉洲封君六帙双寿","author":"范景文","text":"夜读灵文晓弄潮，齐眉白发未飘萧。\n古心映物存三代，佳致移居爱六朝。\n世望门高东海表，国材梓象北山桥。\n长春酒进还难老，蓬岛仙人近可招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"烟霞载为钱与立题","author":"范景文","text":"灏气荡空明，一棹如浮梗。\n奇当无穷咨，溯洄人外境。\n梦出水云间，风雨皆霁影。\n扣船者谁子，卧游悟閒静。\n不载石与书，恐为空明屏。\n日月吹逝波，纵心以相领。\n恰得片片霞，澄怀对三景。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"涂德公疏救黄幼元廷杖寻奉诏释于其归也作此以赠 其一","author":"范景文","text":"未回天怒雪霜纷，洒血陈词叫帝阍。\n任戆久能容汲黯，免冠故敢救朱云。\n风传太学幡犹立，名动宸旒草莫焚。\n盛代即今宽党禁，好将厨俊报明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"涂德公疏救黄幼元廷杖寻奉诏释于其归也作此以赠 其二","author":"范景文","text":"曾闻逢比犯婴鳞，今日天留不死身。\n哕凤欣看来草野，寒蝉足可愧簪绅。\n千秋义激关师友，五夜铭心泣鬼神。\n持此孤忠知不变，登朝只愿作良臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":22698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]