[{"title":"慰栖贤石长老病二首 其一","author":"释函是","text":"荦荦堪谁道，轩渠为尔吟。\n一年愁去路，千里独归心。\n世故逢人浅，肝肠与病深。\n且将形影息，高卧锦江岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"慰栖贤石长老病二首 其二","author":"释函是","text":"何曾吾道拙，带病事深耕。\n辛苦酬先泽，绸缪淡俗情。\n千溪停鹤梦，一枕入蝉声。\n金井桥边水，秋来彻底清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"康熙庚戌孟秋制府周彝初持服北归道出韶石订入山不果赋诗三首奉柬兼以为别 其一","author":"释函是","text":"奉命临南越，含哀返蓟门。\n双旌发穗水，千骑指相原。\n布地初成果，论因知有源。\n途中应计日，遥礼法王尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"康熙庚戌孟秋制府周彝初持服北归道出韶石订入山不果赋诗三首奉柬兼以为别 其二","author":"释函是","text":"孝治兴朝重，覃恩守制还。\n哀音联北雁，遗爱见南蛮。\n愿深楼至后，心许懒残閒。\n渺渺江云暮，停舟何处湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"康熙庚戌孟秋制府周彝初持服北归道出韶石订入山不果赋诗三首奉柬兼以为别 其三","author":"释函是","text":"节钺王臣贵，灵山嘱自今。\n断肠萦子舍，翘首望祇林。\n云影藏龙浅，天花积雨深。\n他年重奉诏，应记入山心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云从大士随制府还北口占寄别","author":"释函是","text":"专阃军威重，陪驺入帝乡。\n相水摇龙虎，丹山仰凤凰。\n金绳天界现，玉轴梵宫藏。\n盛事非今昔，空闻姓字香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽刘平田仪部","author":"释函是","text":"文章传胜国，苦节著当今。\n高寄遗民迹，徘徊选佛心。\n八行馀绪论，千里想清音。\n邈矣嗟梁木，典型何处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中刘德馨太史过访","author":"释函是","text":"再访情弥笃，人扶出见难。\n病魔辜客意，官舫送秋寒。\n暂作江淮别，宁知天地宽。\n明春有归雁，消息到长干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎同三见访索诗时予在病中","author":"释函是","text":"广南有佳士，远访庐山岑。\n卧病机输我，维摩默至今。\n隔林人影怯，掩烛夜堂深。\n写照霜筠月，三年出袖吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"复生松用谢秋水韵","author":"释函是","text":"铁干嗟犹在，相看各自怜。\n冰霜还暮岁，泽溉不乘权。\n吊古成今日，伤生忆往年。\n祇须同后死，珍重未凋前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉帘泉用伦使君韵","author":"释函是","text":"界破青山色，相看面目真。\n不因矜碎玉，何事到金轮。\n莫问东流意，还同此日春。\n云烟笼不住，迢递出风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送端严侍者归省","author":"释函是","text":"宁亲千里去，一衲念春寒。\n匡岳经初隐，黄梅莫久安。\n燕雏新引子，竹笋未成竿。\n望汝归长夏，南薰山日漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"用韵送方楼冈之楚","author":"释函是","text":"泉石添新梦，干戈滞故乡。\n兴亡非我事，去住为人伤。\n归雁逢春雪，饥蚕念古桑。\n江淮千万里，湘水旅魂长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋示大绍禅人归省","author":"释函是","text":"送汝宁亲去，西风妒晚荷。\n蝉声辞石镜，雁影到淮河。\n故里白云少，家山黄叶多。\n夜来牛火怯，须忆老婆和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题一树轩示诸子二首 其一","author":"释函是","text":"将军无此树，独立叹当时。\n荫阔人空过，风多鸟不知。\n高柯怜曲干，密叶覆低枝。\n暂托安禅处，还山尔莫悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题一树轩示诸子二首 其二","author":"释函是","text":"梦里水云隔，贪凉附薜萝。\n海隅疑广莫，瓠落对山河。\n席户迎风细，推窗得月多。\n荣枯不可问，寥寂当如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送严天莫入京谒选","author":"释函是","text":"送尔选官去，天然今不然。\n幞头无道俗，朝宁赖英贤。\n湖水通淮直，庐峰逼汉连。\n匡时须努力，投老在何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼旋庵湛都寺六首 其五","author":"释函是","text":"行业人天重，因缘吾道轻。\n庄生宁厌死，尚子欲如生。\n易引丹霄步，难辞荆棘行。\n洪波鼓冥壑，长人亦自惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼旋庵湛都寺六首 其六","author":"释函是","text":"色声情易尽，来往梦难消。\n眼见浮沤幻，生当识浪娇。\n莫嫌千仞壑，珍重一梢瓢。\n与尔他生别，应防独木桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜坐竹下口占示净成诸子四首 其一","author":"释函是","text":"开径岂容易，搴萝赖汝曹。\n閒时须得趣，忙里莫辞劳。\n竹月筛空地，松风走怒涛。\n纵观尘世苦，无过住山高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜坐竹下口占示净成诸子四首 其二","author":"释函是","text":"月色入林悄，溪声到枕寒。\n山中风味别，人外泬寥宽。\n有力耕锄易，无钱结构难。\n莫嗟生事薄，乘夜绕秋坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜坐竹下口占示净成诸子四首 其三","author":"释函是","text":"往返含鄱路，鸠材作栋梁。\n他时茅殿月，此日草头霜。\n莫笑买山拙，应怜避世狂。\n请看秋雁影，随意上潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜坐竹下口占示净成诸子四首 其四","author":"释函是","text":"秋汉连湖白，山枫入涧红。\n孤尔独行外，惭予静对中。\n境疑劳逸异，心与忆忘同。\n归鸟投林疾，高低息夜钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诃衍摩静主五十初度","author":"释函是","text":"五十年前事，能无堕悄然。\n视生如汝否，掩室占谁先。\n竹密栖云煖，山高见月圆。\n风光犹未晚，汨汨念时贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送尘异归省","author":"释函是","text":"宁亲为令子，何以慰而师。\n万里干戈日，三冬霜雪时。\n入关逢旧识，出岭数新诗。\n予老无人侍，言归莫过期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遣慧潜随尘异但子归省","author":"释函是","text":"劳汝送予子，子安予乃安。\n临风须早泊，戴月慎朝餐。\n去路桃花煖，回山梅蕊繁。\n此心随所到，梦倚碧琅玕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"一峰辞予泪下感而示此","author":"释函是","text":"辞我归丹岫，潸然泪满襟。\n去留伤老大，山水畏高深。\n为道思初日，离情盼远岑。\n及时须努力，莫负古人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶成","author":"释函是","text":"世情何足论，寿夭亦徒然。\n妙指法琴瑟，同根翻地天。\n白云笼嶂北，溪水绕门前。\n高卧镜楼下，谁云造物偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送尘异掩关","author":"释函是","text":"绕肠离我子，冷面作而师。\n祖道于今坠，天龙舍汝谁。\n莫尝刀上蜜，休系藕中丝。\n十载清霜操，斯文允在兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘莘叟携其子二人孙四人入山有诗见赠而韵四出予即依其格答之盖诗取见情不必区区也","author":"释函是","text":"别驾刘莘老，遥来看老僧。\n言真无巧拙，情至少逢迎。\n话我似弥勒，谁当辨浊清。\n多携孙若子，相视笑亭亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆方楼冈","author":"释函是","text":"之子颇好道，难忘是世心。\n劝归江上稳，偏向楚中寻。\n失路疑南北，乘风竟陆沉。\n普施应有作，休负白头吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和尘异松下春兰诗二首 其一","author":"释函是","text":"春兰松下放，弱质倚松盘。\n岂易承春暖，曾经怯岁寒。\n枝蟠香自结，月照影成澜。\n大树知能护，寻源人共看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和尘异松下春兰诗二首 其二","author":"释函是","text":"花瘦松脂毓，根盘兰叶张。\n春霜难损色，夜月暗生香。\n高荫朝昏静，深藏臭味长。\n仰看云影布，荣落岂相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送泽萌遇长老住华首","author":"释函是","text":"吾师开法地，虚席已多年。\n鈯斧承先匠，雄风仰后贤。\n高标千嶂木，深牧两溪烟。\n坐断飞云上，红轮覆五天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春送山燄监寺之西安","author":"释函是","text":"出山何所适，百二秦关长。\n旅次谋晨夕，春寒慎俶装。\n垂鞭堤柳短，中食客途忙。\n宝殿赖经始，倚门夏日长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中三首 其一","author":"释函是","text":"老去因人病，情疏且自宽。\n蒙头销意气，拨火耐春寒。\n霜月澄潭迥，梅花积雪残。\n一双青白眼，长日似流湍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中三首 其二","author":"释函是","text":"俯仰成辜负，思量总惘然。\n博山临别语，寝室抚膺年。\n举目看朝菌，遐心托杜鹃。\n老成匏落尽，遮莫误先传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中三首 其三","author":"释函是","text":"自顾愿王在，残灯岂复明。\n馀生犹有待，后死得无成。\n我法如江汉，倾怀托弟兄。\n诲人吾不倦，宁更惜身名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新种梅花开一朵朵","author":"释函是","text":"去年栽此梅，今岁一花开。\n稍露知根在，不萌畏雪摧。\n枝繁怜独立，寒尽待人来。\n白眼应谁见，凭栏香暗回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诗成行者报再放一朵","author":"释函是","text":"一花开可喜，况又一花开。\n清韵非无偶，幽姿不待媒。\n双双寒月并，寂寂暗香陪。\n莫道知希贵，孤根护宝胎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"叹逝","author":"释函是","text":"天高不可问，人事日荒唐。\n芳草绿绵密，王孙归渺茫。\n释子平湖殁，无禅穗石亡。\n馀生多涕泪，孤雁入寒塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"季春书怀","author":"释函是","text":"山静无人到，春深鸟不知。\n少眠怜夜短，多病厌身危。\n不觉夕阳下，空嗟朝槿迟。\n双眸青复白，岂敢忆当时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜","author":"释函是","text":"当台光自满，与像一无穷。\n信此空成色，悬知异亦同。\n徽猷千古上，掩映十方中。\n寒照无人处，深潭吼夜龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"空","author":"释函是","text":"谁拟虚空相，所见是顽空。\n钝置僧繇笔，徒劳造化功。\n易开云里月，难系岭头风。\n廓尔无知识，寥寥太古中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水","author":"释函是","text":"本自无筋骨，能乘万斛舟。\n入河惟一湿，到海汇千流。\n且莫惊波浪，还须识泡沤。\n相逢冷暖意，智者翻增愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"风","author":"释函是","text":"号号吹万窍，难触是虚空。\n岂费纤毫力，惟观动静同。\n谁当随所转，势尽恨无穷。\n有感斯皆累，休誇列子功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卜隐洪岩","author":"释函是","text":"解院寻深隐，洪岩最上关。\n碧霄怜老拙，高视谢人寰。\n举世魔风炽，惭予壮志顽。\n愿生真有道，早慰圣明颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其一","author":"释函是","text":"滂沱昨夜雨，晴好忽今朝。\n策杖归初地，登堂布旧条。\n老成怀德在，小子习心销。\n从此风规远，金轮瑞气昭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其二","author":"释函是","text":"胜地传匡岳，名蓝属此间。\n右军初舍宅，耶舍接开山。\n六朝频易主，一代愧为颜。\n绍续兵荒后，安禅但掩关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其三","author":"释函是","text":"来日嗟犹及，去年何足云。\n归乌愁暮雨，衰草怯秋云。\n林下惟行道，山斋罢论文。\n时名焉可苟，垂老畏空闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其四","author":"释函是","text":"昔年曾住此，屡梦到山中。\n彭蠡城边月，鸾溪寺里钟。\n簇新春草绿，依旧野花红。\n黄鸟知予意，关关啭晚风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其五","author":"释函是","text":"梅花开雪里，不畏寒风吹。\n百卉凋伤日，一溪烟雨时。\n枝从行路折，香爱晓窗知。\n自惬幽人意，宁辞鸿雁疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其六","author":"释函是","text":"已得溪山意，何疑世上情。\n腊穷松自见，寒尽草频生。\n撼树风声惨，入潭人影清。\n嗒然忘语默，不但百怀轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其七","author":"释函是","text":"世间贵文字，吾道慎支离。\n以此薄词藻，相看空墨池。\n凿沟疏水路，先雨葺茅茨。\n莫笑禅枯澹，清宵试一思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其八","author":"释函是","text":"管奏石泉细，图开峦岫横。\n临池爱人影，近柳羡莺声。\n日落溪云重，月明山雾轻。\n万缘何处去，持此慰生平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其九","author":"释函是","text":"日暮欲何去，迢遥咫尺中。\n繁花红岸北，细草绿畴东。\n舐犊怜牛老，回车念客穷。\n涂长谁信宿，条柳倚春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其十","author":"释函是","text":"观世得无我，随时且爱人。\n山川若是画，泡幻更谁真。\n寒鸟生台饭，空林雪夜春。\n等閒离合处，迢递总风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其十一","author":"释函是","text":"云水何曾异，茅房独自真。\n晴空休瞪目，寒色更宜人。\n岂爱潭中月，知无花外春。\n莫随吾与若，疑误住山身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其十二","author":"释函是","text":"高峰月正白，一半是溪云。\n空满川光合，烟沉石溜分。\n寒灰香后散，归鸟声先闻。\n如梦谁堪似，吾今不欲云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其十三","author":"释函是","text":"衰老成疏节，孤危寄上岑。\n钟声霜殿湿，月色夜堂深。\n雪鸟无寻处，春花不择林。\n岂甘为散诞，随分见余心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其十四","author":"释函是","text":"石镜摇初日，金轮隐暮云。\n如何此际见，不似昔年闻。\n雨过寒塘静，风交春树殷。\n从来人贵耳，伫望独云云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其十五","author":"释函是","text":"名利能生诈，人心各自良。\n常因徇理处，迸起护情方。\n泉石能降习，烟霞别有长。\n曾随寒涧水，一鉴得参商。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其十六","author":"释函是","text":"坐月候钟鸣，阶前虫韵清。\n定中山觉静，闻外水无声。\n花影何曾动，天光空自横。\n禅房门半掩，廊外有人行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其十七","author":"释函是","text":"厨灰方欲冷，添钵望归来。\n朱户知难扣，青苗犹未栽。\n香烟迟午食，鸟雀下空台。\n松径无生客，庭阴长绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其十八","author":"释函是","text":"轻飙不入户，就地且乘凉。\n殿后垂枫密，门前藉草芳。\n江山宁有尽，寒暖但随方。\n得意即为乐，长歌过夜塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其十九","author":"释函是","text":"雨足期秋熟，无云嗟去年。\n适予复来此，一众总茫然。\n到处扣门拙，还山得食偏。\n好从今日始，努力耕山田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其二十","author":"释函是","text":"昨日米船到，肩担出郡河。\n正当秧好插，更值吏催科。\n午食尚难给，差徭且奈何。\n青山岂易得，勉矣莫蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其二十一","author":"释函是","text":"负米远千里，开书欣八行。\n吾门犹有此，一众岂虞荒。\n稚子白葵扇，老翁青竹床。\n当轩且磅薄，乘倦到羲皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]