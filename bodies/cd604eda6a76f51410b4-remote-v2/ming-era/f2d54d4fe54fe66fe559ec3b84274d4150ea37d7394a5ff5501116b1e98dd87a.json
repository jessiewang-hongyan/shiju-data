[{"title":"赠高深甫二首 其二","author":"胡应麟","text":"自惬逍遥理，谁同汗漫游。\n异书中秘得，名墨太清留。\n夜月渔阳鼓，春山燕子楼。\n六桥杨柳色，无处避骅骝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集刘将军即席作示孙徐两生","author":"胡应麟","text":"聊同珠履客，共此岁华徂。\n潦倒青丝盒，淹留白玉壶。\n寒风回击筑，骤雨促呼卢。\n不道嫖姚贵，犹能事博徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读季孝廉匡庐诗卷题","author":"胡应麟","text":"彭蠡扬帆近，匡庐纵目长。\n高峰悬紫翠，乱瀑洒青苍。\n竹隐文殊座，莲空慧远堂。\n攒眉何处客，不远是柴桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽赵别驾汝申四首 其一","author":"胡应麟","text":"神武门前路，何人复挂冠。\n华阳閒鹤驭，瀫水罢渔竿。\n冷日黄金灶，寥天白玉棺。\n君看鸡犬去，已到赤城端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽赵别驾汝申四首 其二","author":"胡应麟","text":"频年嗟伏枥，此日叹藏舟。\n世阀传中垒，乡闾问太丘。\n朱弦俄入夜，素翣正逢秋。\n好在蓬池顶，题诗遍十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽赵别驾汝申四首 其三","author":"胡应麟","text":"玉局留丹界，琳宫寄碧霞。\n渐荒陶令菊，难觅邵侯瓜。\n雾里三天舄，云中八月槎。\n椒浆聊一奠，陇树乱栖鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽赵别驾汝申四首 其四","author":"胡应麟","text":"蘧然孤蝶寝，忽到夜台傍。\n别墅丛青桂，空斋翳白杨。\n星沈南极杳，天入大罗长。\n一尉何须恨，修文正拜郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萧含誉自楚中来访留集二首 其一","author":"胡应麟","text":"下榻仍松桧，移尊更薜萝。\n星当雄剑聚，云傍彩毫多。\n客计留天目，乡书问汨罗。\n五游他日遂，相逐老岩阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萧含誉自楚中来访留集二首 其二","author":"胡应麟","text":"狂歌青桂下，醉舞绿筠前。\n越绝书犹著，湘累赋已传。\n风葭云梦笛，雪苇洞庭船。\n归路甔甀近，能无问太玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访张伯起煖阁小集夜同过幼于园","author":"胡应麟","text":"伐木怀同调，连枝惬共吟。\n围炉冬阁煖，秉烛夜堂深。\n月倚孤城棹，风交万户砧。\n龙唇弦绝久，拂拭为知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幼于园中听歌","author":"胡应麟","text":"一径蓬蒿入，层台面绿波。\n客携桑落酒，人倚柘枝歌。\n夕露更衣堕，晨星襆被过。\n五湖花照眼，蚤晚著渔蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠钱将军","author":"胡应麟","text":"属国儒风远，轻车将略长。\n侍童青玉案，前队绿沈枪。\n北府晨开席，南楼夜据床。\n邵陵游猎处，白马映丝缰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题吴肇成清波碧玉图","author":"胡应麟","text":"亭亭开素面，袅袅出朱唇。\n水畔疑西子，波心似洛神。\n浣纱犹倚石，移袜乍生尘。\n那得相携去，馨香赠远人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻王问伯领解南都喜而有作","author":"胡应麟","text":"此夕庭阶树，真成奕叶光。\n赋曾标五子，名欲擅三王。\n客礼龙门下，神交雁塔傍。\n百年兄弟好，同日奏长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟次槜李寄王承父山人","author":"胡应麟","text":"邂逅兰溪约，秋风望未涯。\n地违青雀舫，天靳白鸥沙。\n虎阜看茶近，乌程问酒遐。\n春来定寻汝，酩酊万桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泊姑苏寄吴文仲","author":"胡应麟","text":"寂寞寒山寺，钟声只自听。\n高云随去舄，夜雪到空舲。\n竹色谁分座，花香独扣扃。\n太湖峰七十，历历傍愁青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访曹子念戏赠","author":"胡应麟","text":"幽居仍薜荔，雅兴旧菰芦。\n一榻悬东海，孤航领太湖。\n须髯疑大侠，骨相异潜夫。\n何事吴阊底，频年侣博徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长干道中书事 其一","author":"胡应麟","text":"金波鳷鹊下，玉管凤凰调。\n晋帐延双隗，吴妆出二乔。\n柘枝频度曲，桃叶旧传谣。\n欲认相寻处，城南十五桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长干道中书事 其二","author":"胡应麟","text":"紫雾藏金屋，丹霞间玉楼。\n那能佳丽地，不作狭斜游。\n江女名无畏，卢家字莫愁。\n徐娘虽老去，象管不停讴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过淮上读贞烈沈氏实编作沈为侍御吴公妾余丙子吴公所取士也 其一","author":"胡应麟","text":"匪石心难转，如山诺竟酬。\n馀生宁九地，一死为千秋。\n壮节长淮远，贞魂大海留。\n预看彤史笔，灿烂照松楸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过淮上读贞烈沈氏实编作沈为侍御吴公妾余丙子吴公所取士也 其二","author":"胡应麟","text":"忆昔吴公赏，真同贾傅看。\n凄凉神武阙，早挂惠文冠。\n旧事悲桃李，高风想蕙兰。\n酬知万行泪，愧汝大江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河","author":"胡应麟","text":"九曲黄河水，奔流下夕阳。\n芦根渔网集，树杪客帆张。\n巨石撑淮浦，高洪压吕梁。\n黄姑频岁约，击楫上扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿良乡","author":"胡应麟","text":"小市良乡驿，征人暂解鞍。\n空林万木落，孤馆一灯残。\n旅色逢秋暮，乡心入夜阑。\n那知百里外，明日是长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"家大人七秩恭贺四首 其一","author":"胡应麟","text":"粲烂长生箓，高悬瀫水阳。\n中元秋届节，南极夜生光。\n黄鹤吴天外，青鸾越海旁。\n惟应双瑞曲，永送万年觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"家大人七秩恭贺四首 其二","author":"胡应麟","text":"懿行三千就，遐龄七十延。\n竹宫观礼日，兰署校文年。\n六传巡滇骑，双旌入楚船。\n讴歌犹咫尺，拜舞大椿前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"家大人七秩恭贺四首 其三","author":"胡应麟","text":"华堂开寿域，瑞霭接瑶池。\n十地来菩萨，三天降辟支。\n名犹喧隶卒，化已洽边陲。\n何限朋游集，千花照玉卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"家大人七秩恭贺四首 其四","author":"胡应麟","text":"慎默藏身宝，圆明应物踪。\n年高黄叔度，世拟郭林宗。\n日月迟玄草，云霞恋赤松。\n八千春共祝，宁羡渭滨封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄居曲水园柬张氏伯仲二首 其一","author":"胡应麟","text":"自爱新居僻，宁论故业贫。\n伯通能借庑，仲蔚已为邻。\n茂苑花淹客，吴门药赠人。\n苍茫太湖底，生事起垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄居曲水园柬张氏伯仲二首 其二","author":"胡应麟","text":"独有陶公径，能停谢客舆。\n陆浑虚旧宅，阳羡觅深居。\n水木孤轩外，云萝四壁馀。\n何如传舍客，日月敝长裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岭南陈孔信贽其诗来谒报赠二章 其一","author":"胡应麟","text":"何物元龙少，囊携绝妙词。\n百篇难汝弟，一字愧吾师。\n剑击要离冢，壶倾泰伯祠。\n钱塘万家雪，只棹慰相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岭南陈孔信贽其诗来谒报赠二章 其二","author":"胡应麟","text":"骤发扁舟兴，佯狂到海涯。\n诗成筒寄草，梦断笔生花。\n把赠罗浮雪，回看茂苑霞。\n鲈乡亭下馆，归路欲栖鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过张水部新居","author":"胡应麟","text":"负郭成三径，郊原带草堂。\n飞甍摇海气，画槛纳江光。\n花色吴门近，棠阴越里长。\n中朝思大厦，未许醉清商。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过娄江载宿弇园时囧伯逸季并以事留云间独房仲在下榻款留亡异长公存日感赋此章","author":"胡应麟","text":"十日欢犹洽，千秋态未忘。\n开尊怜仲子，下榻梦中郎。\n旅色停孤棹，歌声咽后堂。\n屋梁明月满，惆怅夜何长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小袛园怀囧伯逸季","author":"胡应麟","text":"寂寞双林下，迟回一杖过。\n盛名犹宇宙，陈迹已山河。\n落月连枝远，悲风大树多。\n独将知己泪，烂漫洒青萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"澹圃访王闲仲及二弟渊季征叔留集作","author":"胡应麟","text":"夜久尊偏绿，更阑烛尚红。\n云霄三隽在，海岱二难空。\n旧业东陵异，新欢北海同。\n那将季札剑，两地挂悲风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆楚生新居在弇园澹圃间邀余斋中啜茗即席赋","author":"胡应麟","text":"爱尔新居僻，令余世事忘。\n一瓢寒树里，四壁浣花傍。\n鸿渐馀茶灶，龟蒙但笔床。\n坐闻邻笛起，涕泪满山阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16296,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再过陆楚生","author":"胡应麟","text":"小筑娄江畔，萧然四壁空。\n断桥流水外，茆屋乱云中。\n有意交胡质，长歌问陆通。\n犹怜傅舍客，弹铗卧秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜卧沈子书斋出素笺索题信笔赋","author":"胡应麟","text":"褥许分青锦，厨仍卧碧纱。\n浓香熏柏子，清梦杂梅花。\n未觉仙家好，浑忘客路赊。\n异时怀仲举，湖水渺云沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伯隅童子冶卿持扇索题走笔一律赠之","author":"胡应麟","text":"偶遇张公子，频年拥素琴。\n貌堪酬白璧，名已铸黄金。\n肯作调鞭老，时为捧剑吟。\n红绡遇何日，倩汝入花阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴刺史之桂林","author":"胡应麟","text":"莫作炎荒叹，骞腾识凤麟。\n棠阴流皂盖，桂实堕朱轮。\n雨润遐陬俗，风驰绝徼尘。\n好将南国化，沐浴瘴乡人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈方伯自闽中移蜀寄柬","author":"胡应麟","text":"奏事驰仙阙，除书下圣朝。\n杨舲江树合，行部海棠娇。\n云暗三峨寺，天长万里桥。\n浣花溪上路，词客可重招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蔡生移居城北招饮作","author":"胡应麟","text":"咫尺城东寓，相寻路未遐。\n怀人闽海荔，留客武夷茶。\n几席凝香雾，杯盘散绮霞。\n成行儿女在，袛合老天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过郭翌之故居有感","author":"胡应麟","text":"尚忆鸿胪第，淹留白日斜。\n新坟俄宿草，旧圃更残花。\n地迥悲邻笛，天清咽暮笳。\n异时风雪满，孤棹问谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠张真人","author":"胡应麟","text":"何年赤松子，羽节到皇家。\n步蹑飞云履，游乘贯月查。\n珠宫浮紫贝，绛阙炼黄芽。\n应笑唐供奉，仙裙滞九华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿郭隐君","author":"胡应麟","text":"苍茫翠微半，突兀见孤亭。\n大壑悬真气，高天卧客星。\n桐江标胜迹，庐阜毓英灵。\n不尽名山色，东南万古青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题孙生别墅","author":"胡应麟","text":"小筑寄林泉，萧森十数椽。\n苏门飞啸日，郢国和歌年。\n室静飧霞饱，窗虚卧月便。\n溪兰一以撷，为汝拂冰弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题朱茂才孝行卷","author":"胡应麟","text":"千古朱家侠，芳声异代留。\n蒸梨知孝行，瀹茗见清修。\n乌鸟心长切，羔羊愿未酬。\n君看彤史笔，卓荦下螭头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄何稚孝","author":"胡应麟","text":"邂逅清源下，差池易水濆。\n心期元独许，意气本无群。\n六翮排青汉，孤踪傲白云。\n春风上林苑，击节子虚文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少宰赵公还北寄送","author":"胡应麟","text":"饯别列鹓鸿，悬腰剑色雄。\n台垣三殿近，冢宰二京同。\n禁树连云紫，庭花傍日红。\n扫门饶赋客，宁复叹飘蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少宰赵公拜相寄贺八章 其一","author":"胡应麟","text":"一夜求贤诏，欢呼万国同。\n谟谋咨大老，启沃仗元功。\n绝域车书会，中天剑舄崇。\n异时评太史，何羡帝臣风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少宰赵公拜相寄贺八章 其二","author":"胡应麟","text":"翊运逢明主，匡时倚上材。\n尊荣逾四岳，宠渥重三台。\n瀫水初调鼎，华阳已筑台。\n早知霖雨泽，六合净炎埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少宰赵公拜相寄贺八章 其三","author":"胡应麟","text":"玉铉调贤佐，金瓯扈圣朝。\n群龙齐捧日，双凤各凌霄。\n大业皋夔近，荣名稷契遥。\n蓬莱云五色，烨烨近人飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少宰赵公拜相寄贺八章 其四","author":"胡应麟","text":"满目乾坤事，关心社稷臣。\n八荒悬密勿，九域藉经纶。\n煖阁调羹夜，平台赐宴辰。\n好将司马业，传播外番人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少宰赵公拜相寄贺八章 其五","author":"胡应麟","text":"六馆推名德，三司备羽仪。\n麻宣鳷鹊殿，草辍凤凰池。\n礼乐重兴日，诗书再睹时。\n太平方有象，宁讶庙堂迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少宰赵公拜相寄贺八章 其六","author":"胡应麟","text":"凤诰辉纶綍，龙光切冕旒。\n坐调中极鼎，永作大川舟。\n八表清风被，三朝壮节留。\n长安贵游满，处处撤行驺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少宰赵公拜相寄贺八章 其七","author":"胡应麟","text":"尚记临轩日，龙头曳佩环。\n帝心悬北斗，人望切东山。\n燮理阳春布，论思乙夜閒。\n万方伊葛想，翘首玉宸班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少宰赵公拜相寄贺八章 其八","author":"胡应麟","text":"上相同心日，真儒佐命年。\n白麻初翊圣，黄阁骤招贤。\n吐握回三代，吹嘘动八埏。\n肯教扬马辈，头白卧林泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长至后三日幼于斋头对菊同张使君陈文学周山人陆孝廉即席分赋得寒字","author":"胡应麟","text":"节已过长至，花犹耐早寒。\n似忻彭泽采，偏称汨罗餐。\n袅袅团霜砌，亭亭立露盘。\n何当撷千朵，烂醉赤栏干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过王氏小隐同陆山人周上舍閤中小集","author":"胡应麟","text":"信步绿萝庄，春波夹画墙。\n壶中藏滟滪，盆底著潇湘。\n曲折花为径，纵横竹绕廊。\n乘风时一到，好是白云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜过周懋脩馆中月色盈庭皎如霜雪即席口占","author":"胡应麟","text":"咫尺周郎馆，衡茅葑水傍。\n披襟流素月，把袂落繁霜。\n逸调阳春远，清歌乙夜长。\n预愁明发路，枫叶乱金阊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西林汎舟即席作","author":"胡应麟","text":"谷口肩舆入，悠然兴未穷。\n尊前五湖尽，槛外十洲通。\n削壁笼丹雾，飞梁挂彩虹。\n坐闻天籁发，兀兀万缘空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得壮士乐长征","author":"胡应麟","text":"言从汉飞将，结发隶行间。\n列戟秋乘障，扬旗夜出关。\n双雕婆勒渡，独马贺兰山。\n宁忆空闺下，梅花树树攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过沈材叔留卧斋中作","author":"胡应麟","text":"华亭疏雨过，小阁乱云流。\n榻为延徐下，船因问戴留。\n春光回枕簟，寒色驻衾裯。\n十日犹能客，从君笑薄游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠钱将军","author":"胡应麟","text":"征马去飘飘，将军旧度辽。\n运筹推武库，横槊羡英标。\n转粟三吴尽，飞刍六郡遥。\n烦君持大纛，取次静氛妖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"司马汪公以仲淹讣至寄挽二章 其一","author":"胡应麟","text":"消渴真怜汝，幽忧竟若何。\n一尊犹水曲，万事已山阿。\n旧业荒兰芷，遗文照薜萝。\n异时轩冕贵，较仲定谁多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"司马汪公以仲淹讣至寄挽二章 其二","author":"胡应麟","text":"濩落词人长，飞扬侠客俦。\n生宁惭一诺，死欲擅千秋。\n失弟怜司马，从师困伯牛。\n天都乱山色，何处挂吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄丁元父","author":"胡应麟","text":"闻道丁元父，筵倾邺下才。\n政成初百里，名动已三台。\n岸帻寻芳草，弹琴坐落梅。\n尚思风雪里，并马立蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题章氏木假山","author":"胡应麟","text":"早谢樵人斧，悠然野客家。\n双峰寒宿雾，列干迥撑霞。\n埋没沟中断，飘零海上查。\n逢时千载事，为尔一长嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]