[{"title":"白伯伦仪部移居夜阶助甫司封访之席上赋得卜居赤甲迁居新两见巫山楚水春十四韵 其十二","author":"宗臣","text":"问君何所爱，庭户满西山。\n夜夜仙人至，时时拾佩环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白伯伦仪部移居夜阶助甫司封访之席上赋得卜居赤甲迁居新两见巫山楚水春十四韵 其十三","author":"宗臣","text":"主人出家醅，千酌葡萄紫。\n不问江南人，知是江南水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白伯伦仪部移居夜阶助甫司封访之席上赋得卜居赤甲迁居新两见巫山楚水春十四韵","author":"宗臣","text":"落月频催酒，群星低送人。\n句中杨柳色，不是五陵春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吴张二子 其一","author":"宗臣","text":"望君白云边，逢君明月下。\n明月岂银鞍，去住随君马。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吴张二子 其二","author":"宗臣","text":"自我遣明月，终夜照君屋。\n婵娟未解情，只在阶前宿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人还楚","author":"宗臣","text":"蓟门摇落朔云秋，尔去千山落日愁。\n白发行藏孤剑在，青枫舟楫丈江流。\n楚人昔有怀沙怨，湘水今还鼓瑟留。\n念我好传鸿雁曲，月明应醉庾公楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赵山人","author":"宗臣","text":"别来音书何太稀，塞南日日秋鸿飞。\n青山一去谁消息，白发双垂今是非。\n岁月祗穷词客路，薜萝难负楚人衣。\n故园剩有沧浪水，寒雨江枫吾赋归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省楼春集","author":"宗臣","text":"朝来鸣佩散长安，汉树千花覆石栏。\n把酒逢君歌北雁，上书有客泣南冠。\n万家芳草悲春暮，三月高松过雨残。\n欲寄愁心与白日，浮云满目不胜寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"午日同于鳞子与集公实时值雷雨","author":"宗臣","text":"蓟门芳草逐人来，午日新蒲对酒开。\n沉陆揔为方朔侣，怀沙独惜楚臣才。\n人间魍魉雷堪走，海上蛟龙雨不回。\n夜半浮云难去女，更堪孤角凤城哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日寄袁二丈","author":"宗臣","text":"清风何处问吾庐，落日他乡泪满裾。\n胡马频年为客计，塞鸿八月故人书。\n白蘋江上共谁把，紫蕨山中好自锄。\n只恐凌云称赋者，汉家久矣待相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送施明府之萧山","author":"宗臣","text":"马上秋风吹客缨，送君千里越中行。\n芙蓉落日凭谁语，杨柳寒江非世情。\n群盗羽书仍北向，频年将相议南征。\n白云茂宰今看女，莫问飞凫向帝京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二月三首 其一","author":"宗臣","text":"二月春华满凤城，万家杨柳共愁生。\n烽高紫塞愁都护，诏下甘泉议北征。\n昨日羁縻胡市马，西风萧瑟汉臣缨。\n琼衣玉札殊恩泽，早把勋劳荅圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二月三首 其二","author":"宗臣","text":"蓟门芳草满长衢，是处黄金不可无。\n西入羽书三辅急，北方龙气七陵孤。\n天王按剑思临塞，大将观兵岂备胡。\n报主忧时今更切，敢将心事问江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二月三首 其三","author":"宗臣","text":"闻道元戎出帝畿，即看远道耀军威。\n汉金百万朝通使，胡骑三千夜解围。\n塞上烽烟何日定，山中麋鹿计全非。\n由来天意高难问，徒自燕云滞客衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄许殿卿","author":"宗臣","text":"声名历下共羊何，海岱秋云几度过。\n燕市黄金图骏少，齐人白石饭牛多。\n山中夜赋深风雨，醉后春衣泣薜萝。\n圣世才贤俱近幸，碧池芳草待鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄沈二丈","author":"宗臣","text":"长髯短鬓近何如，湖北湖南定卜居。\n琴里潇湘中散曲，池边风雨石军书。\n秋来双径谁看菊，月下清尊自摘蔬。\n旧日纶竽还好在，岂能终负楚江渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀子培舍弟","author":"宗臣","text":"故园春草日依依，别后池塘今是非。\n明月江风频忆弟，清秋塞雁一沾衣。\n病多客枕余芝术，书去名山问蕨薇。\n闻道沧洲新水阔，可怜鸥鹭满渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省中斋居贻于鳞子与公实元美四比部","author":"宗臣","text":"向夕停珂省阁幽，吏人犹自进春裘。\n蓬莱双阙金茎远，阊阖千门紫气流。\n明月在天难命驾，白云垂户好登楼。\n明朝献赋甘泉者，汉畤秦祠非昔游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送熊守之太仓因便省觐","author":"宗臣","text":"羡尔新分剌史符，南方千骑乱平芜。\n潇湘天阔春归楚，震泽风高晓入吴。\n父老几年忧战伐，使君到日问樵苏。\n蓟门旧侣能相忆，八月双鸿起太湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送明卿席上有赋","author":"宗臣","text":"陌上黄金侠者游，蓟门春草暮堪留。\n一尊破尔青山梦，万里怀人落日愁。\n鹦鹉昔悲湘客赋，鹔鹴初典汉家裘。\n酒阑忽听孤笳起，肠断胡云出塞秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望蜀","author":"宗臣","text":"华发萧然寄一官，于今蜀道更艰难。\n北来戎马应看剑，南去莼鲈好挂冠。\n杨柳岂堪巫峡暮，薜萝空对锦江寒。\n东山旧日饶书札，夜夜灯前拭泪看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送冒明府谪教杭州","author":"宗臣","text":"匹马天风听暮笳，南归尚醉故园花。\n尺书在袖逢江雁，万里扬帆似汉槎。\n帐下谈经余首蓿，湖中对客半兼葭。\n钱塘岁岁春堪卧，莫忆渔竿返玉华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送方行人使鲁还蜀","author":"宗臣","text":"仙吏朱衣下紫霄，天书亲捧翠微遥。\n梅花一夜飞羌笛，明月千山护使轺。\n鲁甸王程逢雁尽，剑门乡思听猿销。\n送君双泪悲游子，白发清江正寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得黄山人书","author":"宗臣","text":"昨日传书到汉京，几年为客向江城。\n怀人夜雨孤尊在，闻尔秋霜两鬓生。\n半世行藏频倚剑，各天消息一沾缨。\n何时共逐华阳侣，手把芙蓉对月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄马明府","author":"宗臣","text":"秋云何处寄相思，华发知君满面垂。\n去国柴桑陶令醉，还家薏苡汉臣悲。\n竟无尺素传朱鲤，或与仙人种紫芝。\n一自沧江分折柳，十年摇落鹿门期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客舍新迁有赋","author":"宗臣","text":"如何一别淮南桂，竟日淹留冀北花。\n九塞烽烟仍抱病，三年京洛屡移家。\n人间岁事催黄鸟，江上春衣阻赤霞。\n骨肉音书常不断，白云依旧是天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈使君还楚","author":"宗臣","text":"使君匹马向河梁，此去江乡即帝乡。\n楚客多才见鹦鹉，汉旌何日渡潇湘。\n山中杜若迎新绶，渚上芙蓉念旧裳。\n京洛交游俱近幸，迟君秋色赋长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陆子和","author":"宗臣","text":"江门一别又秋分，何处风烟不忆君。\n久客衣裳鹑自结，旧游尺素雁为群。\n十年世路雕青鬓，三叹斯人卧白云。\n羽翼南溟最相近，未须重勒北山文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈生南还因寄江乡游好","author":"宗臣","text":"蓟北秋高起夕峰，送君南去楚云重。\n市中五斗新丰酒，醉后三年长乐钟。\n耕陇未须悲燕雀，涉江何处采芙蓉。\n寄言旧日飧霞侣，曾否天台访赤松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29497,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李虞部之杭州","author":"宗臣","text":"一尊晨散帝城游，万里江云拥去舟。\n楚国芳荃难汝别，蓟门朝雨为谁留。\n万家熢燧胡缨夕，八月蒹葭海戌秋。\n使者无须频北顾，浮云何处不堪愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29498,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旅怀二首 其一","author":"宗臣","text":"远塞风高暮角哀，浮云终日去燕台。\n百年骏骨逢时晚，十月鸿书隔岁来。\n锦水即从巫峡出，青山定向剑门开。\n独伤人事多留滞，万里停云日几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29499,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旅怀二首 其二","author":"宗臣","text":"客计年来尚卜居，楚江渔父意何如。\n茂陵肺病长卿赋，汉帝心知贾谊书。\n天地一身惟报主，烽烟双眼正愁予。\n秋风万里吹南国，丛桂花开满故庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29500,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陆长庚","author":"宗臣","text":"天涯一自失论文，岂有同心不忆君。\n孤客逢秋悲蓟草，尺书经岁阻江云。\n清时易别烟霞路，明月难随鹿豕群。\n便欲投簪沧海去，兵戈消息不堪闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29501,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韦氏池亭四首同于鳞子与元美赋 其一","author":"宗臣","text":"城上春山并骑来，曲池芳草好停杯。\n鸬鹚水净窥人立，燕雀风高逐岸回。\n客计独留玄草在，帝京三见紫薇开。\n吾将遂拟郊居赋，怪尔临岐候吏催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29502,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韦氏池亭四首同于鳞子与元美赋 其二","author":"宗臣","text":"雨过林塘花正飞，高松细石俯渔矶。\n扁舟明月堪长往，万里沧江胡不归。\n猿鸟经秋分客泪，薜萝他日只吾衣。\n相逢未可轻相负，一到红尘事事违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29503,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韦氏池亭四首同于鳞子与元美赋 其三","author":"宗臣","text":"重来韦曲解春襦，碣石华阳望不孤。\n万里天风吹短发，千家凉雨飒高梧。\n青山祗负渔樵问，玄鸟深知日月徂。\n一醉矶边濯吾足，却疑身世即江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29504,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韦氏池亭四首同于鳞子与元美赋 其四","author":"宗臣","text":"出门驻马饮平川，为尔徘徊下夕烟。\n捐佩不堪芳草暮，沾衣吾得紫霞篇。\n渔阳戍鼓东何急，易水悲歌昔所怜。\n更欲开尊待新月，浮云容易妒婵娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29505,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陈使君","author":"宗臣","text":"春日春风太可怜，忧怀别绪俱茫然。\n江南涕泪望松梓，冀北花鸟空云烟。\n鸳鹭暂解仙子佩，蓼莪应废门人篇。\n袖中尺素向谁寄，不见双鸿飞暮天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29506,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西来","author":"宗臣","text":"西来秋色满燕山，昨夜平胡使者还。\n白羽书传辽左捷，黄金诏赐殿中班。\n竟何汉卒屯清海，难信班生老玉关。\n闻说单于频出猎，相逢马上看刀环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29507,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王参军之横州","author":"宗臣","text":"中原落日怨离群，万里关山路又分。\n乱后谁为骠骑使，征南吾忆伏波军。\n湘妃班竹行秋雨，帝者苍梧起暮云。\n铜柱高标犹在眼，好将勋业荅明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29508,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诸子夜集","author":"宗臣","text":"鸣佩朝来散紫宫，相逢意气为谁雄。\n一尊醉忆江湖上，三月春残风雨中。\n消渴文园卧司马，题书碣石问冥鸿。\n青山南北吾将往，肯向人间泣路穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29509,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中得家书","author":"宗臣","text":"走马归来稍自宽，愁边萧索汉庭冠。\n葵榴不落千枝净，风雨频生六月寒。\n客到庭阶惊自出，书传兄弟泪难看。\n两乡白发关河阻，日日江鸿愧羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29510,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再寄袁二丈","author":"宗臣","text":"秋高摇落蓟门城，万里相思对月明。\n人在蒹葭歌白苎，病中风雨望金茎。\n关山尺素时堪寄，南北孤鸿暮不征。\n闻说子云能献赋，长杨羽猎古今名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29511,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人日东杨子","author":"宗臣","text":"游子频年栖汉庭，又看春事落阶蓂。\n乾坤双眼逢人日，江海孤槎是客星。\n病起鬓毛知汝白，愁边杨柳为谁青。\n风烟况复音书隔，向夕征鸿不可听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29512,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀赵子隆","author":"宗臣","text":"当日相携十二桥，寒江东接广陵潮。\n青云客计龙门策，明月谁家凤女箫。\n久别书来愁雁鹜，故园秋尽忆兰苕。\n长安新柳黄金色，迟尔看花匹马骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29513,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人归淮南","author":"宗臣","text":"燕市六月芳草班，落日忽惊游子颜。\n骑发邯郸逢赵璧，雨来桐柏近淮山。\n黄河日夜去仍急，沧海东南浩不还。\n秋到正逢丛柱色，王门诸客共谁攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29514,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴八首 其一","author":"宗臣","text":"往岁含春紫禁东，千官环佩散天风。\n茂陵病逐樵人去，淮海春残桂树丛。\n宦计云霄惟敝舄，主恩日月在冥鸿。\n简书使者江亭满，可得相逢问汉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29515,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴八首 其二","author":"宗臣","text":"沧江生事起垂纶，蜀使西来泪满巾。\n万里书传巫峡雨，几时归摘楚江蘋。\n青猿知在关山听，白发应催日夜新。\n人世百年堪俯仰，蓟门一别五经春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29516,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴八首 其三","author":"宗臣","text":"遥传塞上又征兵，使者飞书入汉京。\n边马不归青海戌，朔云常断玉关缨。\n七陵松柏今开府，三辅河山夜勒营。\n自是群公能策虏，即看赤羽莫深惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29517,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴八首 其四","author":"宗臣","text":"建业春云咫尺看，云中宫阙旧长安。\n孝陵只在钟山上，紫气遥凭白日寒。\n剑佩千秋还凤舞，关河四顾自龙蟠。\n至今父老谈神武，匹马传书定契丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29518,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴八首 其五","author":"宗臣","text":"石门草色曳春裾，愁里春花满旧庐。\n计吏征求那太急，苍生憔悴竟何如。\n黄河北注鱼龙泣，赤壤终年稼穑虚。\n天上近传优恤诏，可能一夕起樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29519,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴八首 其六","author":"宗臣","text":"中原五子送将归，十二峰头拾紫薇。\n别后何人鹦鹉笔，书来念我薜萝衣。\n邗沟明月行将问，鸿鹄天风高自飞。\n南北岐途两无赖，江门烽火照渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29520,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴八首 其七","author":"宗臣","text":"高杨乱石把雕弧，有客频过问壮图。\n落日中原停万骑，悲风万里下三吴。\n台前麋鹿秋相泣，海上鲸鲵夜自呼。\n闻道中丞新授命，急将戎马救姑苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29521,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江村","author":"宗臣","text":"西风朝散汉臣班，万里江村一夜还。\n题柱声名空画省，采芝岁月有青山。\n烟开曲水频垂钓，日卧苍梧不掩关。\n直欲天台拾瑶草，何人迟我白云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29522,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄顾纯一时客于扬","author":"宗臣","text":"自君去矣湖之滨，日夜湖南生白蘋。\n江雨千家任伏枕，潭云百尺堪垂纶。\n书传孤雁正明月，病起空山愁暮春。\n桃花流水堪避世，武陵樵者今何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29523,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄袁二丈二首 其一","author":"宗臣","text":"孤鸿不到海门烟，别后音书动隔年。\n江上暮云空复好，湖南新月为谁圆。\n怀人竟负看梅曲，卧病长歌采蕨篇。\n咫尺山阴飞早雪，可能一上剡溪船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29524,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄袁二丈二首 其二","author":"宗臣","text":"九月寒花照客杯，故人何处独登台。\n霜华好与青枫落，秋色能堪白雁催。\n鼓角孤城犹自急，干戈双眼共谁开。\n知君近有江南赋，千占深知庾信哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29525,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同子与使君登文游台台在高邮","author":"宗臣","text":"何处星槎使者回，孤城寒吹共登台。\n湖间明月双珠出，雨后青山万井开。\n炼石尔徒天目到，观涛谁更广陵来。\n越吟楚曲俱摇落，江左新惊鼓角哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29526,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赵山人至","author":"宗臣","text":"千行垂柳暗江村，江上何人到石门。\n倚杖年华垂素发，登楼雨色满清尊。\n骤雷似有蛟龙怒，落日愁闻豺虎喧。\n只此渔舟堪结侣，未须楚水问桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29527,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠凌子","author":"宗臣","text":"有客问予青鹭洲，当年遇汝芜城秋。\n一尊楼阁短箫发，十里芙蓉片月留。\n别后素书不肯寄，袖中白璧何所投。\n明朝江路叹游子，莫遣霜华盈敝裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29528,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拱极台","author":"宗臣","text":"高台此日眺中原，台上空惊夜色繁。\n人在千峰明月表，天垂列宿紫微尊。\n秋衣薜荔真君计，早岁渔樵亦主恩。\n即拟寻仙向五岳，烽烟犹自滞江门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29529,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万里","author":"宗臣","text":"万里青枫悲素秋，千门风急楚云流。\n江南涕泪重城急，海上亲朋暮角愁。\n西入战烽迷汉骑，年来渔父失江鸥。\n寄言诸将须深策，早把新军驻石头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29530,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"待元美不至二首 其一","author":"宗臣","text":"书来有意问沧波，晓起柴门抚旧柯。\n孤楫中流杨子暮，白云西去秣陵多。\n双龙一别各风雨，五斗相逢今薜萝。\n寄语湖边垂钓者，好寻虾菜待君过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29531,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"待元美不至二首 其二","author":"宗臣","text":"谁传消息到湖西，欲来不来空杖藜。\n昨日合门开枳橘，早时孤艇散凫鹥。\n愁人碧草戎戎短，候客清尊夜夜携。\n二十四桥今寂寞，未应重为玉箫迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29532,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]