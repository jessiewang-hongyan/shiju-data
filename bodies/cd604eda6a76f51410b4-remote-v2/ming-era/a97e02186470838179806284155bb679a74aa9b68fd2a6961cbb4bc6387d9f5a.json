[{"title":"赠天宁院主","author":"成鹫","text":"门临古道塔凌空，山色西来水向东。\n钟鼓不殊云顶寺，轮蹄争辏梵王宫。\n禅心静印千江月，殿角凉生八面风。\n花下留僧饱斋去，芒鞋无地避残红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘明府仰山作宰行唐以外艰归里奉命焚黄赋此以赠","author":"成鹫","text":"寒食东风郭外烟，仙郎归去罢鸣弦。\n三梁素冕辞双阙，五色黄麻下九天。\n读礼更吹藜杖火，诵诗曾废蓼莪篇。\n官閒亦爱僧閒否，应过东林续旧缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登写心亭怀马郡守","author":"成鹫","text":"韶阳城外曲江边，独上皋亭思渺然。\n入座奇峰铦似笔，当门周道直如弦。\n琴鐏复古希前哲，堂构重新仰昔贤。\n几树棠梨花落尽，西风吹冷半池莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过碧山精舍赠印千师","author":"成鹫","text":"碧山深处锁烟霞，近筑层台礼法华。\n隙地遍栽黄阁老，清池多种白莲花。\n凭高望远疑无地，入谷逢僧便当家。\n静埽溪边坐禅石，与师谈到月光斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"佛桑花","author":"成鹫","text":"篱落秋光静者知，槿花常早菊花迟。\n灵山半写娑罗影，旸谷平分若木枝。\n色相寂寥僧定后，繁华消歇日斜时。\n何堪荣落伤朝暮，一笑相逢两不疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落叶","author":"成鹫","text":"秋声一夜过林西，旧绿新黄响未齐。\n共是飘零难久住，何妨憔悴托卑栖。\n归除白石迟明月，收拾红笺付小奚。\n满地榆钱贫更甚，不堪持赠为儿啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观刘东溪所藏吴虎泉晚槐栖鸦图","author":"成鹫","text":"故人相失在京华，手泽犹存茂宰家。\n宿草久荒迟挂剑，墨槐空见晚归鸦。\n披图想像身前影，绝笔虚无梦后花。\n惆怅旅魂招不得，旧游零落各天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送徐铎愚归五羊兼柬城中诸子时值宾兴","author":"成鹫","text":"东书还问锦江津，霜入枫林叶叶新。\n秋草渡头归病客，槐花时节送閒人。\n儿童颇怪诗囊重，造物多嫌古道真。\n寄语郡城车盖地，不知谁念马卿贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荅崆峒主人张顽石招隐诗","author":"成鹫","text":"劳君招隐寄诗筒，款款开缄拜好风。\n老我独迟篱菊节，怀人长在桂花丛。\n望遥云水心先往，梦入烟霞世亦空。\n问道有期应不远，广成今已在崆峒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"霍西牛归自春州除夕过寓见赠用韵赋答因寄崆峒主人","author":"成鹫","text":"一别红尘便不如，出门往往避轩车。\n故山未返春先入，老景无多岁又除。\n鹿性似嫌莎草短，莺声无柰柳条疏。\n凭君报语崆峒主，愿借岩西小结庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病鹤诗寄社中诸子","author":"成鹫","text":"谩道仙禽能住世，一春长与病相依。\n卧残白日消朱顶，梦断红尘拥毳衣。\n瘦骨正宜烟火绝，轻身宁羡稻梁肥。\n凭谁解赠青田价，放出凌空一一飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题隐泉新院","author":"成鹫","text":"相闻结社锦江涯，七字长成自建牙。\n款段远绳新息武，芭经重起隐泉家。\n敲推静倚三珠树，鼓吹遥闻两部蛙。\n稍待瘦权筋力健，与君吟到日西斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏隐泉新院并蒂莲花","author":"成鹫","text":"玉井连枝出锦江，盍簪炎土即仙邦。\n芙蓉并跃呈霜锷，蝴蝶交飞近绮窗。\n倾盖联翩珠靸履，重乔掩映碧油幢。\n麻姑总角今何在，青冢空留鹤一双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄马卧仙","author":"成鹫","text":"閒从世外识人豪，最喜先生道眼高。\n花甲输君加四齿，冰霜欺我上三毛。\n虚堂下榻迟留带，破衲生寒待赠袍。\n愿借南薰消伏暑，抱琴应许过林皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中荅丘坡三见寄来韵","author":"成鹫","text":"诗情病态转相因，贾瘦郊寒且自亲。\n老去烟霞成痼疾，閒来风雨伴吟身。\n药炉多累书辞架，蜡屐无声径积尘。\n赖有东皋丘处士，新篇还许寄山邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中放言 其一","author":"成鹫","text":"廿年曾记住朱明，饱食丹砂道未成。\n暂到此间修白业，更无馀力种黄精。\n烟霞久别休心住，药石应难与化争。\n不见苧萝溪畔女，颦眉捧腹更倾城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中放言 其二","author":"成鹫","text":"频年多难逢寒食，怅望家山又一春。\n青草久荒攀柏地，黄梅深愧种松人。\n哀猿啼树将圆月，饥鸟眠花动隔旬。\n辜负清明好时节，梦中犹忆蕨薇新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中放言 其三","author":"成鹫","text":"老来深悔不耕田，日暮方思嗣昔缘。\n瓶底量留三日粟，枕边书破八行笺。\n芰荷露重倾犹惜，榆荚风多落更偏。\n赖有市南弄丸子，黄河挹住到西乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中放言 其四","author":"成鹫","text":"三尺胡床七尺躯，横身无计笑区区。\n清谈我不如夷甫，嫚骂谁能恕灌夫。\n紫陌追风鸣叱拨，华堂秉烛醉屠苏。\n茂陵多病曾知否，日夕吟呻独向隅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中放言 其五","author":"成鹫","text":"馀生何幸绝逢迎，任是沉疴也称情。\n近识化人家裸国，新开别业远愁城。\n穷来渐觉贫交少，病后犹夸瘦骨轻。\n何事北窗眠不稳，枕边闻卖荔枝声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中放言 其六","author":"成鹫","text":"木绵花落刺桐乾，梅子添黄荔减酸。\n拥被不知时节过，锁窗犹畏暑风寒。\n滞霖十日如桑扈，尘甑经旬笑范丹。\n多谢旧游枉车骑，相逢重叠劝加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中放言 其七","author":"成鹫","text":"夜行宁免泣途穷，自笑逢时术未工。\n词赋何能消肺渴，文章终不愈头风。\n芭蕉叶底偏多雨，芦苇花边任转蓬。\n虫臂鼠肝吾岂惜，知音惟有信天翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中放言 其八","author":"成鹫","text":"一息浮生一寸阴，閒观物理静披襟。\n案头蜾蠃鸣筠管，壁上蟏蛸挂玉琴。\n逝者如斯良有以，道人那得更无心。\n朝来成就吉安法，始信嚬呻即咏吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中放言 其九","author":"成鹫","text":"漫学招魂续楚些，出门须唱太平歌。\n却嫌升屋三呼晚，转觉登堂七发多。\n薤露未晞春睡足，草虫无那夜吟何。\n浮生穿凿休相管，云散长空月在波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中放言 其十","author":"成鹫","text":"夙习难忘自不知，床头遗草有新诗。\n尻神浸假为轮马，肘臂郎当见柳枝。\n留骨岂堪逢伯乐，葬身何必迩要离。\n昆冈玉石同灰烬，不是铅刀跃冶时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得山意冲寒欲放梅","author":"成鹫","text":"空谷萧萧自主宾，南枝跃跃老风尘。\n飘残六出见五出，过尽小春还早春。\n白首半生归寂寞，青山一气露精神。\n何堪花事从头说，月落参横未有人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜友人过寓话旧分赋","author":"成鹫","text":"浮生作客难留客，老病思归未即归。\n何事故人来雪舫，乍惊邻犬吠柴扉。\n情真味澹空葵藿，地僻山寒少蕨薇。\n寂寞閒心随处写，夜来相对一灯微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答西粤冯作鹏来韵","author":"成鹫","text":"壮游衰病各离居，旧约寻思一半虚。\n去国声名夸肸蚃，入山滋味类泔鱼。\n槐花閒却三秋半，菊蕊忙于九月初。\n我未心空君未第，相思莫讶梦来疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渔灯","author":"成鹫","text":"光生浦溆夜潮平，江上推蓬远思盈。\n两岸波光重叠见，一天星月浅深明。\n分将松火炊菰米，移转银缸近酒盛。\n翻羡浮家能继晷，漫穿邻壁笑匡衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和黎广文过东林作","author":"成鹫","text":"一别东林动隔年，茅堂岑寂闭荒烟。\n壁间剩有琅玕字，物外难忘木石禅。\n吟到天花遥入磬，思深春雨细通泉。\n近来风雅凋零甚，愿与先生结此缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"还东林萧志三见赠用韵赋答 其一","author":"成鹫","text":"烟波回首人微茫，归路何如归兴长。\n两地云山无主客，半年风日各炎凉。\n方池旧闻花添影，圆牖重开月借光。\n莫笑别来贫更甚，榆钱将䞋遍斋堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"还东林萧志三见赠用韵赋答 其二","author":"成鹫","text":"何事行藏偏落后，却缘筋力不如前。\n虚堂久别从生草，旧社重开又种莲。\n爱石谱将云里岫，引泉流出水中天。\n老来识得荣公乐，只买青山不买田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中答双桂洞天公见寄兼柬同门兄弟 其一","author":"成鹫","text":"浮阶春水漫苔衣，滞雨连旬不启扉。\n桂洞老人劳见讯，华林穷子未曾归。\n琴高岂用全抄谱，棋罢还当更息机。\n闻说弟兄多胜事，悬知权教入深微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中答双桂洞天公见寄兼柬同门兄弟 其二","author":"成鹫","text":"耿耿难忘为阿谁，却防一息不相知。\n雪霜到处欺双鬓，粥饭今年减半匙。\n月出便寻高枕地，日斜不是苦吟时。\n吾家赖有真龙象，为报云门道未衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓鼎湖李天章过访拉游飞水潭试茗分赋因寄信安冯尔公广文","author":"成鹫","text":"榕堂旧别忆何年，忽漫相逢古寺边。\n白首不堪同草木，青云还许到林泉。\n茶香静发烟霞气，诗句平分水石缘。\n为报郡斋冯外史，隔江招手有枯禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送伍秋农下山","author":"成鹫","text":"微云疏雨入天湖，野客追陪兴不孤。\n岂有风雷迷大麓，漫随龙象礼浮图。\n莲花开日难为别，丛桂前期记得无。\n我且暂留君暂去，可堪离合在须臾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"博山剖公入天湖见赠用韵送行","author":"成鹫","text":"芒鞋踏破岭头云，水石留题字字新。\n遂有文殊来过夏，始知无著是家人。\n天花夜静侵衣满，山雨朝晴振锡频。\n别后孤峰翘首处，长空圆月俨师真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游飞水潭与诸子同赋限韵 其一","author":"成鹫","text":"病躯未去心先去，筋力无加却有加。\n七尺乌藤伴形影，一条白练入烟霞。\n灵湫镇日倾盆雨，顽石当阳散宝花。\n莫道银河隔尘世，迷津何处不通槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游飞水潭与诸子同赋限韵 其二","author":"成鹫","text":"山色溪声无远近，林光潭影互交加。\n密云触石成疏雨，孤鹭迎风散落霞。\n坐久三衣疑浣雪，凭高双眼易生花。\n青猿也羡临渊乐，隔水呼儿上断槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送僧还里省母","author":"成鹫","text":"无成底事未閒身，回首门闾有老亲。\n世外彩衣犹恋母，道傍青眼未逢人。\n满船明月家将近，两袖清风客不贫。\n归去北堂何所献，衣珠擎出是家珍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黎大年入西宁","author":"成鹫","text":"结束琴书怅索居，泷江西去欲何如。\n方将京雒三陈策，且向河阳一曳裾。\n九月水边逢旅雁，六都沙别见嘉鱼。\n临邛买酒堪留醉，莫漫狂歌学接舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采石矶怀古","author":"成鹫","text":"维舟采石月华新，一曲狂歌吊逐臣。\n仙籍骑鲸如昨夜，醉乡梦蝶已千春。\n投荒未必关仪狄，玩世何须避永璘。\n自古文章憎命达，汨罗还有独醒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹅潭渔父 其一","author":"成鹫","text":"石门斜日柳波烟，钓得槎头缩项鳊。\n小港溪桥沽酒去，大通渔火枕蓑眠。\n山腰系带朝收网，水面生皴夜缆船。\n羡尔浮家识风雨，自伤留滞一年年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹅潭渔父 其二","author":"成鹫","text":"通津津口钓鱼还，十里澄潭两岸山。\n风便送归杨柳渡，月明留醉荔枝湾。\n沧桑阅尽须眉古，波浪经多梦寐閒。\n閒对白鹅搔白发，与君同寄水云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹅潭渔父 其三","author":"成鹫","text":"沙角潮平地轴宽，多君浪迹胜严滩。\n鹅潭倒影涵山郭，鸥侣将雏近钓竿。\n烟雨南来云漠漠，牂牁东注水漫漫。\n画船尽载沉香去，閒与儿孙倚棹看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛珠江望白云山 其一","author":"成鹫","text":"扁舟独渡珠江水，野客登临耳目宽。\n绀殿钟声移棹听，白云山色隔城看。\n遐心指点峰千叠，生计商量钓一竿。\n今夜月明何处宿，梦魂应绕郑仙坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛珠江望白云山 其二","author":"成鹫","text":"早潮暮潮时往还，大浪小浪波涛间。\n一声呕哑涉江棹，十里涳濛回首山。\n水寺无人僧定稳，仙岩有路鹤飞閒。\n菖蒲花发便须去，居此不难凋玉颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春望燕","author":"成鹫","text":"东风初拂柳花飞，旧垒新梁几夕晖。\n白玉横钗留影住，乌衣深巷见人稀。\n掌中妙舞何时入，塞外风尘及早归。\n社日尚遥频怅望，别来红缕是邪非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠僧","author":"成鹫","text":"偶来城市得良朋，千佛楼中一个僧。\n保福不须还拨草，汤休今已继传灯。\n三生旧社高歌入，万仞孤峰信步登。\n从此吾宗有文字，倩人书壁笑南能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题亦稼堂赠梁广生","author":"成鹫","text":"人稼青苗汝稼书，三冬争似富三馀。\n不随袯襫驱黄犊，宁向缣缃学蠹鱼。\n东阁弦壶追洛诵，西畴蓑笠笑长沮。\n何须更凿邻家壁，曾见藜灯照石渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初晤杨式公","author":"成鹫","text":"信道诗轻万户候，识君犹胜识荆州。\n谈锋似剑双龙合，心细如丝独茧抽。\n湖海多情容散诞，市朝无骨莫淹留。\n相寻话到忘言处，野鹤归飞月满楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答杨式公","author":"成鹫","text":"红尘紫陌偶相期，蹑屐登龙快所思。\n山径有云归路晚，市门斜日下楼迟。\n漫劳轩盖遥相问，暂寄茅堂只在兹。\n他日幽栖还有计，千峰平处一峰奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蔡箕衍孝廉偕诸公过访分赋","author":"成鹫","text":"病是权称懒是真，闭门风叶积成旬。\n漫劳上国看花客，来问空山卧雪人。\n别鹤传将流水操，饭牛分得建溪春。\n殷勤净埽三生石，待与宗雷辨主宾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟补春夜宴桃李园诗 其一","author":"成鹫","text":"园林烟景快相亲，兄弟招欢自主宾。\n银烛金樽长夜饮，夭桃秾李一家春。\n盛年共惜同为客，明月从来不待人。\n回首二毛搔渐短，不应辜负接䍦巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟补春夜宴桃李园诗 其二","author":"成鹫","text":"群季追欢兴不孤，芳园娇鸟唤提壶。\n名花自种还同赏，家酝新篘不待沽。\n素魄影边添蜡烛，绿茵深处布氍毹。\n可能后会频相觅，长愿高阳作酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题英鸡黎国所画园林图","author":"成鹫","text":"尺幅云林幻也真，无端闻见一番新。\n丹青不是支那笔，花木还同震旦春。\n弱水东流终到海，越裳南去即通津。\n年来颇有居夷愿，莫怪披图数问人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与刘念兹","author":"成鹫","text":"惺惺唤起主人公，万念消归一念中。\n月影不随波影散，钟声寻与鼓声通。\n世知有我山还浅，静到无人市亦空。\n一路桃花带流水，刘郎何处不相逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冯作鹏归自桂林过宿话旧分赋得窗字","author":"成鹫","text":"何时书剑别西江，竹院寻僧兴未降。\n得与旧游重款款，快闻新论一桩桩。\n诗兼虫语吟幽砌，梦逐鸡声出破窗。\n明发不堪怅离别，重来应讶碧油幢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别亦庵","author":"成鹫","text":"三年衰病借閒房，冷局无端作笑场。\n迟我别峰凭地主，还他华屋与空王。\n蟪蛄聒耳山犹浅，鶗鴂伤心草不芳。\n多谢门前生耳树，重来应恐是迷阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居梅园","author":"成鹫","text":"明知熟境最难忘，借得园林当宝坊。\n长揖红尘归白社，暗移圆月入方塘。\n鹿门旧识庞居士，兔径重游孟八郎。\n荆棘满园须护笋，老来高节看谁长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居示诸子","author":"成鹫","text":"蛙声分部各开堂，自大何须不夜郎。\n顽石座边挥玉麈，古梅花下布绳床。\n闭门已得偷閒计，入世真难买笑方。\n高挂钵盂待甘贽，休心还拟更休粮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽刘东溪明府","author":"成鹫","text":"六月飞霜天不知，贞魂浩气忽骑箕。\n哀歌自挽陶彭泽，直道难容柳士师。\n入社久虚三笑约，怀人空赋四愁诗。\n东林寂寞吟庐闭，无复分题接席时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居梅园答庞静庵来韵 其一","author":"成鹫","text":"入林多恐负初心，一别名园遂至今。\n地迥江山由我借，天空云月不相侵。\n梅花老去偏宜雪，菊蕊秋来渐有金。\n何幸鹿门能爱客，肯分乔木托幽禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]