[{"title":"谢大司马王舆浦惠冰","author":"孙承恩","text":"长夜斋居将寸诚，坚冰分至荷高情。\n积阴经日寒犹凛，华洁非砻炯自明。\n掬取已看炎燠解，嚼馀顿觉燥心平。\n虚亭相对无尘俗，应与襟怀一样清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"使郢渡黄河","author":"孙承恩","text":"渺渺洪流泛使航，萧萧寒日淡无光。\n平沙依约云横渡，短楫飘摇风满裳。\n水底鱼龙时啸舞，望中鸢鸟没苍茫。\n天书玉节恭承命，不似乘槎志意荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元佑宫","author":"孙承恩","text":"洞府深深静不哗，名山新礼玉皇家。\n琳宫辉煌丽日月，石璧窈窕开云霞。\n三极玄风昭有象，万年鸿鼎祝无涯。\n玉田明岁春雨熟，更忆此地餐胡麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三洞阁","author":"孙承恩","text":"宝地登临冬日晴，岧峣芝阁俯重城。\n山连碧玉诸天拱，江作青罗一带横。\n已占六合孚玄贶，即有群仙降旆旌。\n潭下有龙时隐见，夜深来听步虚声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郢城有降箕仙者自云李太白也有赠予诗用韵奉答二首 其一","author":"孙承恩","text":"太白星精降异才，骑鲸千载复归来。\n清风漫拂江涛静，逸气遥冲岳麓开。\n世外真诠翻宝墨，中天明月啸琼台。\n悬知太史占乾象，定有灵光烛泰阶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郢城有降箕仙者自云李太白也有赠予诗用韵奉答二首 其二","author":"孙承恩","text":"骚坛曾仰谪仙才，此日神游汉沔来。\n剑影独随孤月逝，文旌高拂九天开。\n蓬莱顶上金光草，衡岳中间玉女台。\n愧我尘中常碌碌，可容参叩傍云阶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登阳春台和韵二首 其一","author":"孙承恩","text":"帝居西畔岌层台，旧是先皇驻辇来。\n宝翰仰瞻镵屃屃，恩光常自照莓苔。\n千年盘石河山拱，八表风尘日月开。\n欲拟彩毫干气象，登高深愧昔人才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登阳春台和韵二首 其二","author":"孙承恩","text":"摄衣晴日上层台，万里霜前鸿雁来。\n昭代皇风今薄海，鬻熊遗迹尚荒苔。\n依依极浦兰洲出，历历晴江烟树开。\n仰止钜公惭接武，再赓佳什叹雄才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沔阳志感二首 其一","author":"孙承恩","text":"早岁从亲此宦游，重来五十四春秋。\n更无耆老询前事，尚有邦人德故侯。\n吏治渐闻随俗变，汉江终古抱城流。\n州前老桧当时物，笑我垂髫今白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沔阳志感二首 其二","author":"孙承恩","text":"古复名邦汉水堧，依稀往事记当年。\n甘棠父老犹能护，风木孤儿秪自怜。\n舆论已徵良史笔，新词深荷长官贤。\n迟留不尽王程系，回首重来意杳然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒先大夫遗爱祠","author":"孙承恩","text":"危祠新搆傍湖浔，宪府思贤父老心。\n即有雕题明巨榜，更闻弦诵集青衿。\n百年遗爱无今昔，一掬寒泉有顾歆。\n游子偶从瞻仰切，不堪此日泪痕深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水香亭小饮","author":"孙承恩","text":"湖光烟霭两氤氲，此日清游共使君。\n已着高甍临绿水，即思短楫棹红云。\n歌邀落日传杯酌，风起青蘋写浪纹。\n聚散未期题榜在，后来应有感斯文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和夏桂洲感赐直庐诗","author":"孙承恩","text":"元臣诏处殿东庐，肃肃清宵拱帝居。\n风递漏声来禁闼，月移树影上阶除。\n感恩时拜金茎露，缮性閒披玉简书。\n此日遭逢良不偶，创闻何啻百年馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次严介溪朝房落成斋居纪事之什三首 其一","author":"孙承恩","text":"大道金门咫尺西，禁庐新搆与云齐。\n即看净室无尘到，时有灵乌傍月栖。\n郢曲久传当日事，巴讴今和隔年题。\n二三同德寅恭切，夜直青绫每共携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次严介溪朝房落成斋居纪事之什三首 其二","author":"孙承恩","text":"斋居寂寂斗横西，高阁遥闻刻漏齐。\n鸣玉时从趋凤阙，避人不拟学鸡栖。\n秪将夙夜勤公务，仰荷帡幪拜御题。\n内使每传催入对，袖中疏草独亲携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次严介溪朝房落成斋居纪事之什三首 其三","author":"孙承恩","text":"西安奕奕门之西，直馆华榱万瓦齐。\n不有元臣躬异数，何由来者得安栖。\n明禋高阁炉薰煖，检押风光彩笔题。\n愧我迂疏羁寓远，良宵往往负招携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贡院将揭榜借韵","author":"孙承恩","text":"五夜文光射斗寒，穿杨破的若无难。\n沧波龙起雷初震，碧海鹏抟宇正宽。\n定有玄徵来梦里，好占喜色上眉端。\n曲江红杏饶春色，羡尔明朝走马看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和亭溪宫詹院中赏莲之什二首 其一","author":"孙承恩","text":"若耶溪上赏心违，玉署金塘喜共依。\n碧锦帐中簇西子，翠云堆里拥真妃。\n亭亭白日风翻盖，冉冉青冥露湿衣。\n最是张衡多妙思，清词健笔一时挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和亭溪宫詹院中赏莲之什二首 其二","author":"孙承恩","text":"玉堂高宴群公集，为爱名花镇日从。\n浪说若耶云万叠，平分太液锦千重。\n莫教池上停歌板，已判归途听暮钟。\n清景情欢良不易，赏心须为惜从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张玉溪宫詹斋居二首 其一","author":"孙承恩","text":"玉堂虚寂称斋居，三日追陪笑语馀。\n月上广庭人未寝，星临高栋夜何如。\n风尘荏苒年华逝，江海分违故旧疏。\n廿载冯唐犹是昔，独随群彦曳朝裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张玉溪宫詹斋居二首 其二","author":"孙承恩","text":"此日清斋玉署居，乾坤回首廿年馀。\n我无术致玄丹就，君有诗吟白雪如。\n花妥幽阶香澹澹，竹摇虚牖影舒舒。\n素衣缁尽长安土，欲探兰苕织翠裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和玉溪斋夕感怀之什","author":"孙承恩","text":"官里匆匆节序过，又看春色上柔柯。\n斋居自喜无尘杂，幽兴时能寄啸歌。\n岂有涓埃禆圣化，且同精祓仰玄科。\n词林滥窃逾三纪，碌碌无闻双鬓皤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和玉溪斋居怀坊馆诸公","author":"孙承恩","text":"朝来喜色遍尧天，圣主明禋契上玄。\n且慰斋居共良夜，独惊衰鬓又新年。\n冥冥元化孚颙际，穆穆仙真陟降前。\n伐木有怀人不寐，一灯清焰对高眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对雪和玉溪韵","author":"孙承恩","text":"绥绥缕缕舞长空，淑气氤氲不待风。\n太乙降歆临法会，天孙剪缟散瑶宫。\n三农已见丰穰兆，一德由来感格中。\n幸接夔龙沾圣泽，更将歌颂万方同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金山口望诸陵","author":"孙承恩","text":"野色朝开墟日晴，冲寒踏冻作郊行。\n地从西北冈峦拥，望直陵园云雾生。\n虎踞龙蟠天险壮，河清海晏帝衢亨。\n万年鸿宝如磐石，不尽敷天颂祷情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和夏桂溪祈雪之作二首 其一","author":"孙承恩","text":"祷雪宵辞禁苑西，贞符亲睹御标题。\n古祠深院留明月，宝炬银灯拂绛霓。\n北角芒垂寒斗近，中庭乌噪朔风凄。\n仰瞻一德孚颙若，欲和阳春意独迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和夏桂溪祈雪之作二首 其二","author":"孙承恩","text":"祈灵恭向禁城西，天语亲承御笔题。\n古鼎浮烟团小盖，宝幡摇影飐脩霓。\n神君时至泠然语，云物冬深飒以凄。\n三白即看歌瑞应，尧衢汉阙望中迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉诏阅庶吉士卷和介翁韵二首 其一","author":"孙承恩","text":"阅士群公我滥同，王言赫奕炳如虹。\n须知独为储贤地，要是无分入彀雄。\n清庙岂容遗卞玉，云门合自识焦桐。\n庸愚廿载前叨与，愧乏涓埃答睿衷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉诏阅庶吉士卷和介翁韵二首 其二","author":"孙承恩","text":"阁下群贤角艺同，彩毫挥染尽成虹。\n先唐甲第皆称俊，有宋宏词独擅雄。\n宝气一时呈匣剑，太音千古寄丝桐。\n明时报称惭无似，荐士聊为竭寸衷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37296,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和桂洲阁老赐宴礼部记恩遇诗二首 其一","author":"孙承恩","text":"春明南省息风埃，帝敕高筵此日开。\n并命趋陪联八座，同依衮舄仰三台。\n万方民物资陶冶，一代谟猷属化裁。\n欲罄微忱赞休烈，再歌白雪意悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和桂洲阁老赐宴礼部记恩遇诗二首 其二","author":"孙承恩","text":"九载黄扉秉国钧，千年紫气际昌辰。\n衣冠总荷天家泽，省署遥连禁院春。\n晴旭浓薰花草丽，暖风细逐管弦新。\n极知此日酬恩志，不负平生报主身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再叠二首 其一","author":"孙承恩","text":"来玉亭边冠盖集，五云深处御筵开。\n式从星履陪高会，快睹奎光烛上台。\n凤敕重宣颁异数，麟袍新赐称春裁。\n试披简册论遭际，再咏明良仰盛哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再叠二首 其二","author":"孙承恩","text":"九重纶綍褒元宰，三月莺花属令辰。\n华省高筵齐北斗，大官仙醴注长春。\n盐梅调剂臣工在，日月光明圣德新。\n青史远看千载事，黄金拟铸百年身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和玉溪贺桂老钦宴诗二首 其一","author":"孙承恩","text":"南省春朝芳宴开，湛恩传自九天来。\n庙谟式仰多殊绩，台翰争誇出妙裁。\n桓老漫言稽古学，姚公曾擅济时才。\n叨陪愧我何为者，笑插宫花倚醉回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和玉溪贺桂老钦宴诗二首 其二","author":"孙承恩","text":"湛露曾闻宴镐京，兹晨春赏洽孤卿。\n元臣独倚恩荣重，老我偏多感激生。\n拂坐篆烟浮瑞霭，遏云歌吹杂流莺。\n无能纪述誇明盛，郢曲传来强为赓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许龙石之南少宰","author":"孙承恩","text":"金陵宫阙五云生，银汉兰舟送子行。\n南北曹分原并重，山川地胜有馀清。\n官斋剪烛题春雨，钟峤支颐看晚晴。\n旧学名高三十载，岂容旌节滞江城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张阳峰大宗伯","author":"孙承恩","text":"怅望留都岁月淹，似公名德几人兼。\n即看鼎铉禆元化，暂与冠绅肃具瞻。\n山寺春晴朝促驾，萧斋客去昼垂帘。\n旧时风月三千首，闻道新来律更严。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甘翁六十寿诗和乃弟几山司空韵二首 其一","author":"孙承恩","text":"美人家住芙蓉国，仙宅岧峣云雾窗。\n洞口春游花作阵，湖心晴泛水平江。\n真诠箓授五千字，瀛海筹输三十双。\n即向长安望南极，寿星昨夜照西邦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甘翁六十寿诗和乃弟几山司空韵二首 其二","author":"孙承恩","text":"文物衣冠见俊庞，堂开寿域敞云窗。\n案供遥借支矶石，酒酿平添濯锦江。\n洞里花明春冉冉，膝前莱舞玉双双。\n青城翠壁神仙窟，名胜从来说此邦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明日都人士俱为扫松之行儿子克弘告予曰儿不随父拜垄上三岁矣闻之怆然因述以诗","author":"孙承恩","text":"纷纷士女出郊行，处处兹晨报本情。\n宦海一为乡垄隔，天涯三见岁华更。\n已孤禄养惭乌鸟，未有涓埃答圣明。\n稚子有言吾忍听，不堪回首泪纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨敬斋之官湖南二首 其一","author":"孙承恩","text":"春日阴阴飞柳花，潞河新水泛仙槎。\n一官发轫恭承命，隔岁宁亲喜过家。\n好拟坡翁閒听鹤，更寻陆子试烹茶。\n莫嫌枳棘卑鸾翼，万里云程正未涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨敬斋之官湖南二首 其二","author":"孙承恩","text":"才贤杨子自儒珍，不是稽勾簿领人。\n廿载已孤锥脱颖，一官且喜职亲民。\n洞庭南下观沧海，衡岳中宵望紫宸。\n见说梅山梅盛发，可能遥赠一枝春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省中斋居","author":"孙承恩","text":"省树沉沉山鸟鸣，舞风飞絮扑檐楹。\n轻云澹霭日将午，茗盌炉薰神自清。\n未有涓埃惭报塞，且同斋祓荐精诚。\n吾皇圣德潜昭假，寅直如臣惧曷胜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉赠松皋太宰二首 其一","author":"孙承恩","text":"郁郁乔柯手自栽，秀分东岳藐徂徕。\n冰霜万壑看凌厉，云雾中天日往来。\n造化独私培养力，明堂须倚栋梁材。\n眷言仰止森严地，常藉清阴庇九垓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉赠松皋太宰二首 其二","author":"孙承恩","text":"移来巨植自高嵩，九仞重泉起蛰龙。\n柱国已看充禹贡，名称应不羡秦封。\n贞姿向日心偏切，香叶流云影自重。\n胜地钟灵无尽已，更多材美继前踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和戴龙山喜雨韵二首 其一","author":"孙承恩","text":"朝来喜雨伏骄阳，一念精禋契昊苍。\n沃泽共看沾四野，来牟已喜兆千箱。\n不缘圣德昭灵贶，讵有民和协至祥。\n仰止周文求治切，更闻兢业每宵裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和戴龙山喜雨韵二首 其二","author":"孙承恩","text":"穆穆严宸拱舜裳，明明端揆燮阴阳。\n仰瞻至德躬玄默，再睹卷阿咏治康。\n道本箕畴孚禹化，心诚汤祷致殷昌。\n小臣窃禄惭无补，欲赞神功未易量。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送花隆恩归江阴","author":"孙承恩","text":"细云斜日澹秋姿，路出都城策马迟。\n久客任教尘染袂，到家犹见菊盈枝。\n青囊子有全婴术，白首吾深舐犊私。\n见说重来犹未卜，不堪回首共凄其。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张远之银台南归","author":"孙承恩","text":"元方霄汉日承恩，季子关河又问津。\n原上鹡鸰偏独苦，尘中野鹤故难驯。\n深山雪盛镵黄独，明月天空咏白蘋。\n莫为幽閒迟驿使，帝乡回首即长嚬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡子刚","author":"孙承恩","text":"不为京尘易涴衣，荣亲事了即思归。\n已看地下昭先德，更念庭前色养非。\n移孝有阶崇继述，读书无意羡轻肥。\n贤关即是图南地，万里云霄好奋飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"因送胡子颇动归思借韵一首","author":"孙承恩","text":"宵梦山中薜荔衣，朝来匹马送将归。\n子承家学惟忠孝，我畏危途有是非。\n霜冷洞庭橙已熟，月沉鱼浦蟹初肥。\n茅堂夜雨秋堪听，望逐仙舟思欲飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺石门阁老得孙诗五首 其一","author":"孙承恩","text":"鲤庭喜见重添玉，纶阁开颜倍旧欢。\n已见琴书称有托，未容身世羡无官。\n奇英试辨啼声异，禄寿天教付畀完。\n掌上明珠宁有价，老怀一日几回看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺石门阁老得孙诗五首 其二","author":"孙承恩","text":"老桂孙枝并秀难，兹欢应是异常欢。\n共占素履孚天道，直拟书香继祖官。\n胤祚几人三世见，乾坤万事十分完。\n名门德泽源流远，还有云仍奕叶看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺石门阁老得孙诗五首 其三","author":"孙承恩","text":"充闾喜见重门阑，此日庭除共一欢。\n盛德从知应有后，老怀方始惬为官。\n乔松元气神明护，仙果天家雨露完。\n赐笏剩教遗远泽，要留忠孝范模看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺石门阁老得孙诗五首 其四","author":"孙承恩","text":"恭闻相府生孙日，杂遝朝绅喜助欢。\n犀钱重制皆珍赐，汤饼频调给大官。\n召公世德勋贤近，张老名贤颂祷完。\n调燮馀閒聊洒翰，阳春吟得遍传看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺石门阁老得孙诗五首 其五","author":"孙承恩","text":"老见佳孙心倍宽，膝前令子足承欢。\n黄扉介寿徵平格，绿野关情且耐官。\n人莫与期天自定，事无违愿福方完。\n魏家勋烈称千古，留取声华作对看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢答端溪少宗伯诗","author":"孙承恩","text":"老去诗篇少兴吟，枯肠今复费搜寻。\n况言药裹时萦念，更是山林日上心。\n佳句强赓愁险韵，雅情久负积愆深。\n芝兰幸接真惭晚，冰雪相依继自今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵赠答同年诸守谷","author":"孙承恩","text":"勋名虽足上凌烟，藻翰于今尔擅贤。\n不为风波当日里，已看金紫十年前。\n秋深古桂香逾远，岁晚乔松色更鲜。\n禁掖清华人共羡，得兼吏隐即神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"借韵述怀并呈守谷","author":"孙承恩","text":"达观万事等朝烟，痛饮狂歌此较贤。\n少日襟期青史里，老来情事白鸥前。\n孤槎海上兼天远，三秀山中浥露鲜。\n康世未能惭出世，欲传真诀学神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"场中劳瘁弗怡偶念守谷赠韵再叠六首 其一","author":"孙承恩","text":"邯郸梦里一炊烟，勘破浮荣若个贤。\n豪气渐消华发里，草堂思搆碧山前。\n黄尘扰扰日月暗，白云英英颜色鲜。\n何当振衣从此去，骑鲸海上追群仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"场中劳瘁弗怡偶念守谷赠韵再叠六首 其二","author":"孙承恩","text":"蟠龙陇上一犁烟，我慕樊生亦自贤。\n已结小堂依水曲，更栽脩竹傍窗前。\n天空万里冥鸿远，雨过千林橘柚鲜。\n寂历九峰秋色里，浩歌明月送飞仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"场中劳瘁弗怡偶念守谷赠韵再叠六首 其三","author":"孙承恩","text":"茫茫尘海渺云烟，脱屣谁如疏傅贤。\n宦迹久羁红日下，乡心已逐碧波前。\n大烹野蔌同堪饫，锦服荷衣各自鲜。\n不用广成参妙道，形神无累即真仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]