[{"title":"冬日淮上怀了能","author":"大遂","text":"冻断黄河与月河，行人马上带冰过。\n惟君生得梅花骨，独占江南暖日多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":615,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄汰如师","author":"大遂","text":"早早言归尚一身，秋空又见雁来宾。\n不知近事堪传否，须记西风怅望人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":616,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"落花","author":"志淳","text":"早破春相赚，飘零不自知。\n未完九十日，消尽万千枝。\n点水嫌萍扫，粘苔怕月移。\n莫谙化工意，荣悴孰为司？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":617,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟夜","author":"志淳","text":"浦冻水声死，烟交暮色黄。\n一舟风猎猎，两岸日荒荒。\n小梦偶然就，孤怀终不忘。\n已知行学事，惟有歇心狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":618,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日过月公兰若","author":"志淳","text":"孤村相叩嗜禅翁，一径春风到寺中。\n人语悄闻杨柳绿，鸟啼幽出杏花红。\n经残瘦坐焚香起，茗熟传题得句工。\n足迹不留帘外土，小庭深寂雨空蒙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":619,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夕","author":"弘己","text":"寂寞灯无焰，何堪发短丝。\n小坐自怜惜，谁将语所思。\n百年犹一年，定有今夕时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":620,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游赵氏洲居","author":"海旭","text":"小港悭通棹，行知经几滩。\n败荷还立雪，寒水不生澜。\n扫石容苔瘦，栽松待鹤安。\n梅花如有月，借我一宵看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":621,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀宋化卿居士","author":"海旭","text":"湖上诸峰秀，君常次第行。\n细评僧社句，准课自修程。\n对月唯忘酒，逢渔劝放生。\n空斋清夜坐，隔水寺钟鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":622,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜炊","author":"海旭","text":"猛觉冰生颊，孤吟翻欲狂。\n汲泉溪作冻，移火月吞光。\n渍米频拈稗，开薪再剪霜。\n夜炊一幽事，仆仆不为忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":623,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"残年","author":"海旭","text":"恐此一林雪，从予颅顶侵。\n梅花香远远，柳眼闭深深。\n斋洁犹邻供，诗清还自吟。\n瘦筇愁破腊，何处卓春阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":624,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪夜山行","author":"斯学","text":"孤舟疑入剡，夜绕乱山行。\n雪与月俱白，江因人更清。\n岚深寒气重，岸断冻痕平。\n况复人烟少，空闻落雁声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":625,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄吴少君山人","author":"斯学","text":"知君好芳草，荷芰半衣裳。\n一别春山绿，几经秋叶黄。\n海门生片月，江寺送残阳。\n曾有天台梦，相携度石梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":626,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"废褒能寺","author":"大持","text":"枯松乱竹一丘陵，曾此开堂演上乘。\n瞰祭鸦如放生鸟，扫坟人似远归僧。\n刹竿倒处见翁仲，鬼火移时替佛灯。\n片碣欲书闲姓字，不知敕赐有褒能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":627,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过黄叶庵","author":"圆映","text":"郭西有竹庵，幽闲旷奇绝。\n壁绿苔晕封，地走松根裂。\n林鸟领法音，冢鬼飧禅悦。\n秋池净若空，霜枫赤疑血。\n晦迹简酬人，义无不了说。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":628,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋草","author":"圆映","text":"护虫吟月苦，衬马滑蹄行。\n萤火烧难死，霜花落也生。\n谁伤当路践，自怨不春萌。\n独有秋江上，离离关客情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":629,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山中怀萍庵师","author":"圆映","text":"高竹过于木，溪分两岸阴。\n看流成独影，得句只孤吟。\n诗草荒谁理，心蓬乱日深。\n怀人秋水寺，寂莫此山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":630,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜投南寺会梵印松涛二师弟","author":"圆映","text":"竟投南寺宿，知子寄松寮。\n几恨隔良晤，孤愁破此宵。\n秋钟清历历，夜竹冷萧萧。\n话到灯花老，邻鸡报诘朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":631,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重过上方寺","author":"圆映","text":"城外西湖水，泉根暗入池。\n鱼游如有翼，树老欲无枝。\n前度故人去，一番新住持。\n老僧扶杖出，但问孰相知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":632,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟行怀竹浪师弟","author":"圆映","text":"远水明于练，前舟如凿空。\n白云鸿爪外，红树雨丝中。\n禅咏知兼胜，行藏孰与同。\n去年留此月，常共泛溪东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":633,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日过金冲垣涤烦坞","author":"圆映","text":"踏沙春路迟，柳倒却如眉。\n因入竹间室，闲吟壁上诗。\n护花常换土，割水暂通池。\n延赏欲终日，涤烦茗苦时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":634,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"落叶","author":"圆映","text":"肯信非常事，何伤撩乱飞。\n茂时藏败局，殒处发生机。\n稀护枝头鸟，深埋路到扉。\n莫将黄瘦片，还拟落花肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":635,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿莲花阁","author":"圆映","text":"家山知远近，身卧与云平。\n数载未归意，一楼风雨声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":636,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"述怀","author":"圆映","text":"春风迢递想天台，六月冰寒说五台。\n无限名山游未遍，秋霜又欲上眉来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":637,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又别庵居","author":"圆映","text":"昔别庭中竹未栽，归来笋已破苍苔。\n安知此去重还日，屋后蔷薇几度开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":638,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏雪","author":"圆映","text":"似梅似絮乱空奔，非月非霜眯远村。\n自被树高先受白，谁怜苔瘦渐消痕。\n山头凹凸犹难辨，水面波澜却易浑。\n顿使世间烦热处，一从寒冷便惊魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":639,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寻梅","author":"圆映","text":"玉格冰魂见尚稀，忽惊岁暮思依依。\n每当深雪偏肥绽，才得东风便谢归。\n断板桥边孤影瘦，冷村墙外暗香微。\n相逢不忍相离别，飘瞥斜枝趁落晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":640,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽玄珠上人","author":"圆映","text":"残灯耿耿夜何其，虚室空悲禅坐时。\n廿载形骸孤鹤吊，一生心事故人知。\n雨添郭外沉龛草，风涸窗前洗砚池。\n白社曾同秋后集，而今惆怅泣题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":641,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访隐","author":"圆映","text":"久向名飞未习眉，寻踪几折过岩欹。\n转从怪道泉珠洒，飘瞥悬崖乳玉垂。\n开落松花数许里，短长竹子百馀枝。\n却逢种术东篱下，翻问溪童是阿谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":642,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽大年法师","author":"照源","text":"影堂灯永夜，想像似安禅。\n授法两三子，深心十二年。\n矮松方挂月，新塔已生烟。\n气结更何语，徒为叹逝川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":643,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"落花","author":"照源","text":"飘零思雨露，撩乱玷苍苔。\n苦被风常扫，因伤春斗开。\n娇莺歌绿转，痴蝶想红来。\n事尽如花事，荣时瘁亦催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":644,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金明老人黄叶庵落成志喜 其一","author":"文贞","text":"扫除荒秽剪凡材，卧榻初安四壁苔。\n隔浦舟移帆影过，邻家客到犬声来。\n霜晨月夕谁为侣，屋后阶前尽种梅。\n心法别将何物喻，莲花不限满池开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":645,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金明老人黄叶庵落成志喜 其二","author":"文贞","text":"一瓢一笠挂西林，不负生平有此心。\n易补高低篱作障，难分新旧竹为阴。\n瓶添水满浇松大，杖拨云开引路深。\n愧死吾侪诸弟子，相依谁学树栖禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":646,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金明老人黄叶庵落成志喜 其三","author":"文贞","text":"不贪幽寂不辞喧，野外茅堂可省烦。\n求法人穿荒冢路，放生鱼过小桥村。\n云将白绕闲排牖，草引青长静掩门。\n深更深山只如此，花开花落欲无言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":647,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金明老人黄叶庵落成志喜 其四","author":"文贞","text":"香光茗气和氤氲，宴晦清斋撇见闻。\n鸟睡树高溪倒影，蚁旋苔滑路回纹。\n北村人语空衔月，东寺钟鸣夜宿云。\n住此顿忘安隐想，隔林咫尺便纷纭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":648,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江门","author":"通凡","text":"未出海门国，遥遥见城郭。\n江风四月寒，衲衣尚嫌薄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":649,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闲居","author":"知证","text":"香径藓花生，阴檐藤叶绿。\n日长不耐闲，行溪看鸥浴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":650,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仙岩山居 其一","author":"慧秀","text":"茅屋青岩半，云来路已迷。\n树深松鼠竞，花暗竹鸡啼。\n绝壁吹寒瀑，空潭饮素霓。\n日斜山影里，樵语下前溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":651,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仙岩山居 其二","author":"慧秀","text":"日出苍烟尽，千山入望新。\n风流临水树，云逆过桥人。\n花竹殊无恙，茅茨未有邻。\n颓然自终古，不是学逃秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":652,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仙岩山居 其三","author":"慧秀","text":"谁家深竹里，当槛即鸣湍。\n人语入云尽，峰阴到水寒。\n草香娱鹿性，藤老学龙蟠。\n步屟浑忘远，兹山不厌看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":653,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠陆少保平泉 其一","author":"慧秀","text":"八座荣天禄，三祗证妙身。\n慧涵清净理，寿历太平春。\n绮席徵歌少，篮舆入社频。\n阶前戏彩客，亦足法王臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":654,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠陆少保平泉 其二","author":"慧秀","text":"鹤发神仙纪，蝇头梵字书。\n请僧开宝藏，作供施金鱼。\n海众投莲社，门人奉笋舆。\n夙乘坚固誓，祇树藉安居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":655,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"淮阴侯祠","author":"慧秀","text":"落日淮阴道，人传汉将名。\n悬知三旅尽，安用一军惊。\n赫奕飞龙佐，逡巡走狗烹。\n英雄空庙貌，千古恨难平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":656,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阻风华阳镇谒三闾庙","author":"慧秀","text":"左徒忠愤见词章，风阻舲船拜庙旁。\n鱼腹吐云天半黑，龙门吹浪日俱黄。\n蕙肴桂酒乡人荐，修幕灵衣估客张。\n应念远游将托乘，涉馀容与上涔阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":657,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"独夜","author":"慧秀","text":"独夜然灯照薜萝，空山魑魅暗经过。\n交游冷落情缘少，坐卧轻安定力多。\n疏竹趁风捎夜壁，哀鸿冲雨度秋河。\n年来更制莲花漏，几度鸣钟事羯磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":658,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五十自纪","author":"慧秀","text":"泡焰俄惊五十春，卉衣霍食已三旬。\n枯藤鼠啮悲斜日，敝箧蛇攻苦病身。\n牛马任人呼辄应，荃茅在我辨非真。\n闭门且觅安心法，槛外松风解拂尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":659,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"人日病闲","author":"慧秀","text":"三因不究病何长，人日晴和强下床。\n托命瘦筇翻似躄，怖头明镜实非狂。\n梅横露蕊犹包紫，柳亸烟梢渐著黄。\n洒翰檄魔文已就，波旬应向藕丝藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":660,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"示徒","author":"慧秀","text":"早办莲花劫外因，乾城海市恐非真。\n青铜屡换娘生面，黄壤频收鬼录人。\n未守鹅珠犹刻粪，强修蛇箧类添薪。\n何当净扫松阴石，送想金天德水滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":661,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九月望夜","author":"传慧","text":"节去愁衣薄，虫声渐近床。\n偶然林下坐，早见草头霜。\n寒月明如此，浮云掩不妨。\n通宵照萝壁，忘却夜初长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":662,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同静泉仲龄二公过南庄邻翁偶谈时事有感","author":"传慧","text":"郭外行应好，香清荷芰风。\n到来茅屋下，谈笑竹林中。\n径草先秋绿，江云过日红。\n眼前不平论，难禁白头翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":663,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄有门法师","author":"传慧","text":"才送登台岭，蟾蜍五晦明。\n江云沉雁影，湖雨咽钟声。\n见岂观河变，狂因照镜生。\n倘怜穷露子，早望印心盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":664,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿四明山心","author":"传慧","text":"寂历游仙处，尘寰隔断霞。\n九溪流雪水，八月绽桃花。\n茅栗圆于弹，霜梨大似瓜。\n云南与云北，依旧作邻家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":665,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄王百谷","author":"传慧","text":"惠山泉水虎丘茶，相去柴门路不赊。\n经岁故人书断绝，夕阳林外即天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":666,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖上杂咏 其一","author":"传慧","text":"草色连云暗水陂，掠芹乳燕影差池。\n游丝惜似春光尽，密罥残花挂竹枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":667,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖上杂咏 其二","author":"传慧","text":"湖水无风似镜清，湖船日日送人行。\n垂杨浪许关离别，有限长条无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":668,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜渡金山","author":"传慧","text":"空江信渺茫，月出水生光。\n入浦潮如雨，沾衣露欲霜。\n天清沙气白，夜静海云黄。\n渐觉钟声动，应知到上方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":669,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠无生祝发","author":"圆复","text":"剃染酬初愿，皈依向大乘。\n夙传人似玉，新纳戒如冰。\n香钵分甘露，田衣挂紫藤。\n从今翠微里，添个白云僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":670,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别念空","author":"圆复","text":"问水寻山各自忙，草鞋无底踏秋霜。\n江南游遍将江北，何日还来共竹房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":671,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登钓台","author":"道衡","text":"丈夫于世各有营，岂为公卿以身辱。\n先生汉之一布衣，千古谁堪继芳躅。\n我来停舟一登跳，双台杳渺林端矗。\n江水沈沈彻骨清，山光霭霭有馀绿。\n只此江山彼江山，严刘到今定谁属？\n先生早知钓得名，拗折当年钓竿竹。\n有脚但可踏青山，何必将加帝王腹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":672,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山居杂诗 其一","author":"道衡","text":"却怪年来懒更长，见人无力下绳床。\n自知无德将谁傲，一任诸方唤我狂。\n活竹编篱生晚翠，新茅缚枕带秋香。\n鸟声啼入碧烟去，古寺遥钟散夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":673,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山居杂诗 其二","author":"道衡","text":"闲向颓檐昼负暄，前峰忽听落啼猿。\n未离文字非心眼，欲证圆通有耳根。\n翠羽每衔花入梦，好风特为我关门。\n胸中一事凭谁论，将此身心报佛恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":674,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山居杂诗 其三","author":"道衡","text":"苍苔欲死翠光存，秋去空林冷梦魂。\n竹暗小窗僧打坐，月明深壑虎敲门。\n谩愁粒绝鼠无耗，应喜衣穿虱易扪。\n天黯恐因霜雪至，呼童好护菊花根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":675,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"凿径","author":"道衡","text":"茅庵将已就，取径透柴门。\n渐剔污泥净，平添怪石蹲。\n雪埋留虎迹，雨过长苔痕。\n让竹微成曲，还惊古道存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":676,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"架桥","author":"道衡","text":"世人那可避，有策亦无聊。\n为凿一钩水，还安独木桥。\n瘦筇扶过易，醉客望来遥。\n渐得游踪少，浓霜踏不销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":677,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"编篱","author":"道衡","text":"虽是无长物，从人也插篱。\n远山留照眼，短缚不过眉。\n未禁闲云度，宁防野鹿窥。\n行看牵紫蔓，采菊在何时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":678,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"力农","author":"道衡","text":"衲子家风在，空山自有年。\n死心衣带下，生意头边。\n火种锄秋月，刀耕破晓烟。\n倦来何所事，高枕夕阳眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":679,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"知非吟 其一","author":"道衡","text":"种兰近竹边，竹与争兰光。\n竹影日渐薄，兰叶亦萎黄。\n物以类相合，胡为反相伤？\n我今抱兰去，永保深林香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":680,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"知非吟 其二","author":"道衡","text":"鱼以水为命，僧与山相依。\n山无僧不灵，僧非山何归。\n谁谓是孤云，是天皆可飞。\n若云是孤鹤，决当择所栖。\n慎哉山与僧，幸勿轻相离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":681,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"知非吟 其三","author":"道衡","text":"昨日花正繁，今朝花在地。\n路旁重徘徊，慷慨莫可既。\n花落明年开，人寿安可系。\n同是风中花，却洒花前泪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":682,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别道恒","author":"宗乘","text":"浪迹兼多病，相看独尔真。\n同消半载日，弥重一生身。\n凉月舟前路，秋风别后人。\n所怀应自得，情忘莫沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":683,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新冬","author":"宗乘","text":"荒斋草尽腓，薄冷暗微微。\n上卷新秋句，加身旧葛衣。\n窗疏留堕叶，檐浅恋残晖。\n来往殊相绝，都忘举似机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":684,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闲居","author":"宗乘","text":"落叶积深巷，闭门无客敲。\n闲云过石面，争雀堕篱坳。\n障眼书难废，看心日易抛。\n青青数竿竹，应不厌穷交。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":685,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]