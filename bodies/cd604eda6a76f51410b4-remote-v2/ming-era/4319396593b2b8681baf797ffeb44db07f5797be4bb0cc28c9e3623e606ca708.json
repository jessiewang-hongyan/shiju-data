[{"title":"莫愁乐 其二","author":"李攀龙","text":"莫愁善西曲，曲曲变新声。\n含意娇不发，春风感人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23771,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"莫愁乐 其三","author":"李攀龙","text":"莫愁幽闺性，非但倾城色。\n石城诸少年，人人自相识。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23772,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"莫愁乐 其四","author":"李攀龙","text":"何处寻莫愁，石城诸少年。\n可怜六萌车，不送莫愁还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23773,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"襄阳乐 其一","author":"李攀龙","text":"朝上大堤头，暮上大堤头。\n大堤诸女儿，游冶不知愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23774,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"襄阳乐 其二","author":"李攀龙","text":"女萝复可缝，兔丝复可织。\n唯有菖蒲花，郎自不曾识。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23775,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"襄阳乐 其三","author":"李攀龙","text":"大堤诸女儿，歌舞日相逐。\n郎今定怜谁，夙昔谁家宿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23776,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"襄阳乐 其四","author":"李攀龙","text":"郎君但坐饮，听我白雪弦。\n十三工西曲，自不工数钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23777,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"襄阳乐 其五","author":"李攀龙","text":"杨州大估客，千金作一装。\n谁敢攀贵德，牵坏侬衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23778,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"襄阳乐 其六","author":"李攀龙","text":"诧侬断信使，还书亦不作。\n微薄自怜侬，欢岂自微薄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23779,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三洲歌 其一","author":"李攀龙","text":"何处估客豪，杨州估客豪。\n象牙持作樯，鍮石持作篙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23780,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三洲歌 其二","author":"李攀龙","text":"闻欢扬州去，大艑居上头。\n一载五百万，两载千万馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23781,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三洲歌 其三","author":"李攀龙","text":"何来板桥湾，持底唤沽酒。\n两丛蒱锻镮，问侬取不取。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23782,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"襄阳蹋铜蹄 其一","author":"李攀龙","text":"白马蹋铜蹄，着地铜蹄鸣。\n往来大堤上，出入襄阳城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23783,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"襄阳蹋铜蹄 其二","author":"李攀龙","text":"大马珂峨头，一步三舂锄。\n借问马上儿，家在襄阳不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23784,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"襄阳蹋铜蹄 其三","author":"李攀龙","text":"白马金络头，一步三駊騀。\n便是马上郎，何尝不婀娜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23785,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"襄阳蹋铜蹄 其四","author":"李攀龙","text":"阳春二三月，襄阳好徘徊。\n渌酒汉江色，与郎传一杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23786,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青骢白马","author":"李攀龙","text":"青骢踯躅八尺强，黄金络头丝作缰。\n可怜白马如人长，着地徘徊自生光。\n青骢白马冶游郎，劳君下都看三阳。\n可怜白马逐青骢，石桥柏梁五湖东。\n青骢白马六萌车，可怜今夜宿谁家。\n借问窈窕西曲娘，白马青骢去无常。\n借问窈窕西曲女，石城莫愁凭寄语。\n齐唱可怜泪沾裳，可怜三声忘故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23787,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"长松标","author":"李攀龙","text":"落落南山松，长标一何拙。\n上栖万里风，下覆千年雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23788,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"双行缠","author":"李攀龙","text":"朱丝葳蕤绳，是侬双行缠。\n绕腕结同心，傍人那得见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23789,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黄督","author":"李攀龙","text":"谁能见歌舞，不自爱阳春。\n少年双泪落，知是他乡人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23790,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"作蚕丝 其一","author":"李攀龙","text":"拾蚕蚕如指，出桑桑如掌。\n一日三箔眠，交侬那得往。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23791,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"作蚕丝 其二","author":"李攀龙","text":"大茧大如卵，小茧垂其腴。\n三秋上织作，君看罗绣襦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23792,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"碣石篇 其一","author":"李攀龙","text":"碣石中怒，沧海北倚。\n元气吐欱，若偃若起。\n长风相薄，跳波千里。\n悬流冒颠，天汉外纪。\n地轴高摽，毂转白日。\n与齐俱入，与汩偕出。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23793,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"碣石篇 其二","author":"李攀龙","text":"凉秋九月，塞外草衰。\n白日萧条，北风苦悲。\n边声四起，胡马成群。\n爝火如星，列障如云。\n钱镈既置，修我戈矛。\n裹粮坐甲，唯敌是求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23794,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"碣石篇 其三","author":"李攀龙","text":"委蛇者河，千里一曲。\n方之舟之，匪刍伊粟。\n太行诘屈，西北是经。\n车辙马迹，日不遑宁。\n于铄圣人，依其在京。\n差次吏功，郡国以成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23795,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"碣石篇 其四","author":"李攀龙","text":"羽翼未就，鸿鹄徘徊。\n神龙失水，蝼蚁所裁。\n珠不暗投，剑不倒持。\n能弗用利，勿处于疑。\n高才者妒，匪但在人。\n逃名避世，以保其身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23796,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白纻舞歌 其一","author":"李攀龙","text":"华镫参差月舒光，笛箫笙竽琴瑟张。\n馆娃窈窕夜未央，西施起舞属吴王。\n白纻飒沓零繁霜，浮云绰约凝且翔。\n将绝复引歌为长，回身急入促管藏。\n扬跗摩趺匝洞房，流风徘徊生绣裳。\n答桴应节蹈鼓行，挺钗欲堕复不遑。\n罗袖缭绕满中堂，与志变化无恒常。\n诸工竞写忽已忘，迁延就次进羽觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23797,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白纻舞歌 其二","author":"李攀龙","text":"二八齐容罗象筵，激楚之结独秀先。\n白纻萧索阳春前，回风飞雪相流连。\n玉腕缭绕萦繁弦，朱唇宛转含蹁跹。\n将行复却私自怜，愿君蹋歌及盛年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23798,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白纻舞歌 其三","author":"李攀龙","text":"春日荏苒花落英，吴姬起舞媚前楹。\n回身顿趾迅且轻，纤尘暗暧不及生。\n投袂一转激楚成，徘徊复进为新声。\n二八敛手停鸣筝，中曲再变豪竹惊。\n如矜若怨意未明，馀姿逸态犹纵横。\n妙技绝世色倾城，谁能顾盻感人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23799,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白纻舞歌 其四","author":"李攀龙","text":"双袖徐起若有思，逸态一放横难持。\n淫衍诘屈纷陆离，流纨曳縠风委迤。\n萦尘逗节利屣施，纡形赴曲影不知。\n纤腰欲结行缀移，众变沓至生繁姿。\n踌躇中止人尽疑，浮腾绝迹称神奇。\n游精荡志君自治，大乐万岁远如期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23800,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"霹雳引","author":"李攀龙","text":"平成天地剖九州，罗列五岳江河流。\n明堂受计朝诸侯。\n人马辟易气纵横，悲歌慷慨志不平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23801,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天马引","author":"李攀龙","text":"胡风雨駪駪而空，山有人踯躅兮悲鸣。\n匝余室兮三行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23802,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蝶蝶行","author":"李攀龙","text":"蝶蝶翻翻戏，游来东园苜蓿中。\n不知谁家涎涎乳子燕，衔之我入窈窕紫深宫。\n紫深宫，欂栌间，高坐顑颔待哺两黄口。\n睨之阿母得食还，摇头鼓翼。\n谁忍视蝶蝶，轻薄亦可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23803,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"悲歌","author":"李攀龙","text":"慷慨乃知故人，徘徊乃知故乡。\n远道多怀，久客自伤。\n欲驾车无輗，欲渡河无梁。\n中夜顾形影，泣下沾衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23804,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"猛虎行","author":"李攀龙","text":"饥且从漂母食，寒且从巢父栖。\n石不为周客笑，玉不为楚王啼。\n菅茅但塞路，桃李自成蹊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23805,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"枯鱼过河泣","author":"李攀龙","text":"大鱼啖小鱼，小鱼啖虾䱉。\n虾䱉啖沮洳。\n啖多沮洳涸，请君肆中居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23806,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"远游篇","author":"李攀龙","text":"万里未足步，过谒历遐荒。\n一举驾黄鹄，再举凌云翔。\n澄氛隐北斗，河汉集为梁。\n山川自纡曲，天地自圜方。\n六鳌抃蓬莱，十日弹扶桑。\n潮水怒相击，昆崙出中央。\n流览临九州，众人何茫茫。\n絪缊造元气，控揣成阴阳。\n黔羸秉大钧，丛脞不可当。\n道逢王子乔，揖我还故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23807,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"广齐讴行","author":"李攀龙","text":"不劳歌楚艳，请为罢吴趋。\n上客但安坐，听我奏齐讴。\n鹰扬表东土，赐履维青州。\n沃壤既如膏，丝枲韧且柔。\n鱼盐无俭岁，海王自春秋。\n百二敌彊秦，八九吞徒州。\n美哉一匡力，天下咸宗周。\n朝服西济河，鞭箠使诸侯。\n至今临淄途，诵义慕前修。\n枹鼓立军门，意气纵横浮。\n举袂成帏幕，攘臂赴仇雠。\n先君务养士，奕世恢鸿猷。\n晏婴以当路，结交鲁孔丘。\n其人聘列国，终日无停辀。\n及闻箾韶音，若与唐虞游。\n三月忘寝食，栖栖此淹留。\n季札本荆蛮，华夏多夷犹。\n泱泱叹大风，观采不能休。\n五伯桓称首，四豪文其尤。\n拥彗为宾师，铁笼存主忧。\n阔达有遗俗，功利非所谋。\n驰骋一何䧺，冠剑常相求。\n蠋辞万家邑，连谢千金酬。\n即论二布衣，岂复商贾流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23808,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"前缓声行","author":"李攀龙","text":"海中之山，必有天上之河。\n人知其一，莫知其它。\n自非意气轻黄金，结交宁足多。\n当复思东来之兔，必有西去之乌。\n不舍昼夜，曾何爱于吾徒。\n长笛不呼短笛呼，愿君有酒即饮无酒酤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23809,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"结客少年场","author":"李攀龙","text":"翩翩白马客，游冶长安城。\n自矜有侠骨，肮脏多交情。\n羞倚将军势，讵借傍人名。\n利剑一在掌，四海皆弟兄。\n片言出肝胆，杯酒如平生。\n恩雠等白日，然诺千金轻。\n君看少年场，意气谁纵横。\n骂坐亦已粗，探丸非老成。\n浅之为丈夫，贤豪大所营。\n长兄推鲁连，仲兄推虞卿。\n小弟处囊中，黾勉荆楚行。\n但令称国士，不必取先鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23810,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东飞伯劳歌","author":"李攀龙","text":"东飞伯劳西飞鹊，黄金仓琅葳蕤钥。\n谁家女儿倚高楼，含娇吐怨弹箜篌。\n明珠翠羽红粉妆，单衫婀娜春风香。\n女儿年几十五馀，开颜发艳玉不如。\n箜篌宛转作新声，可怜一曲倾人城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23811,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乐府","author":"李攀龙","text":"群胡款朝那，请与汉家和。\n紫貂黄羊白橐驼，单于阏氏乘六骡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23812,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"河中之水歌","author":"李攀龙","text":"河中之水流迢迢，洛阳女儿名娇娆。\n娇娆十三称绝色，十四怀春未可挑。\n才梳堕髻即殊众，怕逐时人斗小腰。\n学成织锦机犹涩，解度新声瑟懒调。\n日出采桑城东路，路傍桃李花飘姚。\n左手提笼丝作系，右手攀花折其条。\n国卿下装不复顾，使君五马徒相邀。\n董家高楼一百尺，归来谁见倚逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23813,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郡斋同元美赋得阴字","author":"李攀龙","text":"漳之浔，大陆阴。\n天落落，日骎骎。\n谁为郡，此滞淫。\n君在坐，倍萧森。\n嗟波及，邈陆沈。\n酌我酒，听长吟。\n秋无色，风雨深。\n山欲出，薜萝侵。\n泪相视，卧独临。\n沧海梦，白云心。\n来何处，别至今。\n重握手，一知音。\n孤城夜，枫树林。\n漂短发，问抽簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23814,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"效阮公 其一","author":"李攀龙","text":"太清孔阳，元气絪缊。\n灵曜悬鉴，列宿垂文。\n威凤振羽，神龙作鳞。\n蕙兰幽郁，松桂轮囷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23815,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"效阮公 其二","author":"李攀龙","text":"日照月临，天高气清。\n金支秀华，羽林翠旌。\n六驾龙秋，四牡鸾鸣。\n濯缨云汉，晞发增城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23816,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其一","author":"李攀龙","text":"悠悠念往路，离别从此长。\n何以酬明德，携手归故乡。\n良时不须臾，且复各盈觞。\n仰视日月驰，千载互相望。\n浮云难独留，游子暮彷徨。\n绸缪踰皓首，风波忽一方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23817,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其二","author":"李攀龙","text":"千秋一嘉遇，此别安可知。\n良时不努力，贱躯欲何为。\n晨风野萧条，浮云西北驰。\n河梁临往路，远望令人悲。\n游子自有怀，悠悠当告谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23818,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其三","author":"李攀龙","text":"长思何益会，久留何益归。\n行人怅明发，褰裳路徘徊。\n嘉期能再至，安辞渴与饥。\n浮云一相失，千里常依依。\n我欲往从之，送子东南飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23819,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其四","author":"李攀龙","text":"秋兰怀芬芳，依依树前庭。\n春华不再盛，枝叶皆已零。\n念昔二三子，俛仰如流星。\n羽翼一以乖，邈若隔平生。\n徘徊顾四海，谁能喻中情。\n结交各有时，千载一濯缨。\n离别不在远，日月从此征。\n长当为路人，独无弟与兄。\n尊酒可自慰，愿言崇令名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23820,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其五","author":"李攀龙","text":"乖疑起恩爱，离别生欢娱。\n念子非一身，中怀难久俱。\n握手一相失，奄忽秦与胡。\n新知自言乐，山海日以殊。\n行路方未央，出门思故庐。\n浮云没景光，北风悲有馀。\n褰裳复四顾，徘徊当路衢。\n结发在战场，皓首为征夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23821,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其六","author":"李攀龙","text":"四海一黄鹄，千里命其俦。\n悲风厉胡马，踯躅鸣相求。\n何况同袍友，从此远行游。\n离别无慷慨，去去且复留。\n白日没边城，回首望中州。\n浮云西北飞，河汉东南流。\n视夜常苦早，寒冬正悠悠。\n明月烛罗帏，严霜切绸缪。\n俛仰已自喻，谁能不怀忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23822,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其七","author":"李攀龙","text":"念当首往路，千里邈已临。\n丝竹发高堂，听我双龙吟。\n泠泠江汉流，浮云寒以阴。\n长风激羽翼，严霜摧北林。\n慷慨有馀悲，新声怆人心。\n游子失相视，征夫泪不任。\n中曲一俛仰，从此无知音。\n故乡一尊酒，愿言常酌斟。\n徘徊恋景光，忽为辰与参。\n来者自非昔，去者自非今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23823,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其八","author":"李攀龙","text":"高楼耿长夜，揽衣歌且谣。\n秋风一何悲，游子不得骄。\n明月照空床，罗帏自萧萧。\n三星既隅列，河汉东南朝。\n黄鹄正徘徊，翩翩顾其曹。\n故乡邈千里，慷慨命同袍。\n浮云日西北，安知心所劳。\n携手在须臾，经时复漂摇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23824,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其九","author":"李攀龙","text":"河汉何皎皎，众星错其间。\n揽衣立前庭，明月照苦颜。\n悲风中夜起，萧萧有馀寒。\n涕泪应声零，四顾惨无欢。\n往路信可怀，为乐及盛年。\n游子不自爱，故乡岂难旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23825,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其十","author":"李攀龙","text":"黄鹄难为群，游子常苦辛。\n念当从此别，中怀日以新。\n清光皎明月，远望不可亲。\n高楼正萧条，徘徊四无人。\n上有千里云，其下起飙尘。\n各言还故乡，握手道何因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23826,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其十一","author":"李攀龙","text":"穷冬盛阴气，白日西南微。\n征人常早寐，皎月照我扉。\n故乡千馀里，中夜起怀归。\n干星驾言迈，严霜裂裳衣。\n独行无俦匹，谁知渴与饥。\n穹庐多悲风，萧萧边草衰。\n身在天一隅，何得不徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23827,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其十二","author":"李攀龙","text":"颜色无常好，春华一以零。\n悲风蔽地来，四顾何冥冥。\n寤言怀往路，揽衣从此兴。\n杀气拳毛发，涕泣断为冰。\n仰视河汉星，离如水中萍。\n景光不恋人，游子岂遑宁。\n夜依牛羊宿，日驱驽马行。\n努力及明时，安能爱其情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23828,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其一","author":"李攀龙","text":"秋风既萧萧，浮云亦依依。\n四顾但他乡，游子一何微。\n驾言西北迈，中道正裴徊。\n客行无好怀，万事不如归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23829,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其二","author":"李攀龙","text":"三星跂相视，新月拳素光。\n两宫高自出，双阙遥相望。\n云霞绚河汉，机杼成文章。\n罗帏彯四座，华烛摇中堂。\n主人前进酒，弹瑟为清商。\n流猋激长夜，杀气陨严霜。\n萧萧堕白发，翩翩曳衣裳。\n男儿不憔悴，谁知在他乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23830,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其三","author":"李攀龙","text":"北风著枯林，浮云苦多阴。\n红颜日就衰，他乡日就深。\n别离起中夜，对酒不能斟。\n丝竹含妙伎，佳人怀好音。\n眄睐适君意，慷慨动君心。\n罢曲一俛仰，变为游子吟。\n念当事行役，泪下难自禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23831,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其四","author":"李攀龙","text":"秋风西北来，萧萧动百草。\n荡子无室家，悠悠在长道。\n红颜能几时，弃捐一何早。\n对客发素书，零涕复盈抱。\n上言故乡好，下言故人老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23832,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其五","author":"李攀龙","text":"冉冉年欲度，秋兰采间萎。\n荡涤千岁情，结束欲何为。\n美酒不误人，红颜多所宜。\n万事自明日，行乐此一时。\n四座惨无言，游子中心知。\n浮云动悠悠，故乡难可期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23833,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"录别 其六","author":"李攀龙","text":"悲风堕白日，天地何冥冥。\n招摇弹北户，河汉条中庭。\n征夫苦难夜，且复命新声。\n芳言动君子，四座无不清。\n人生即满百，长此千载名。\n岂如饮美酒，赵女奏鸣筝。\n慷慨尽逸响，慰我饥渴情。\n惟念当离别，翩翩渺独征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23834,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]