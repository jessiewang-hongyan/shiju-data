[{"title":"恻恻吟 其三十","author":"彭日贞","text":"朱颜早慧竟无年，冷落歌楼及舞筵。\n莫怨小乔轻弃我，朝云衔恨别坡仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其三十一","author":"彭日贞","text":"拥炉却忆玉肩凭，争道恩深似未曾。\n闻说他宵将远别，杏黄衫袖泪成冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其三十二","author":"彭日贞","text":"云髻抛残金缕箱，行周开取泣衣裳。\n我曾一剪经亲付，腻歇香消总断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其三十三","author":"彭日贞","text":"怅别乔仙归楚台，师雄沉醉卧寒梅。\n松关不闭葳蕤锁，留待清宵过梦来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其三十四","author":"彭日贞","text":"灵药长生是也非，嫦娥偷去度蛾眉。\n小乔应亦曾分得，飞入蟾宫永不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其三十五","author":"彭日贞","text":"人世相思见月怜，疏梧秋霁忆乔仙。\n游魂到处难周觅，三十三天离恨天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其三十六","author":"彭日贞","text":"乔仙飞去撒天花，罗绮长抛谢物华。\n却恨金笼旧鹦鹉，伤心时误唤琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其三十七","author":"彭日贞","text":"出浴闲庭步晚凉，薄罗衫子藕丝裳。\n于今抛冷缕金匣，襟褶微侵玉汗香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42776,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其三十八","author":"彭日贞","text":"红拂天人出世姿，小乔明慧也如斯。\n可怜鲜识英雄眼，不得长随李药师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42777,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其三十九","author":"彭日贞","text":"寻常日上看梳头，憨倚新妆不解愁。\n自弃碧窗丝网合，凄凄烟雨怕登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42778,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其四十","author":"彭日贞","text":"残魂黯淡拂花笺，字字钟情问可怜。\n分薄未甘轻诀别，一缄红泪寄窗前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42779,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其四十一","author":"彭日贞","text":"琴心永托伴閒居，远别犹勤一纸书。\n弹指转缘伤浅促，文君无望诔相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其四十二","author":"彭日贞","text":"满幅春愁湿未乾，几回垂幌静中看。\n非关要结凭香火，如此深情不可寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其四十三","author":"彭日贞","text":"朱颜玉腕委黄坭，薄命张乔月坠西。\n寄语东山谢丞相，归来无妓可相携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其四十四","author":"彭日贞","text":"西来锁骨幻婵娟，度尽烟花上碧天。\n若问小乔近消息，琼楼初侍玉皇前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其四十五","author":"彭日贞","text":"谁遣仙凡有久要，每怀河汉恨迢迢。\n玉虚天帝应相谅，莫惜乘鸾下绛霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其四十六","author":"彭日贞","text":"应有灵谣寄别愁，放班闲作步虚游。\n孤踪莫过嫦娥宅，桂数摇风易感秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其四十七","author":"彭日贞","text":"浪说神仙住碧霄，初寒对月思无聊。\n韦郎心绪原多乱，休倚层台落玉箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其四十八","author":"彭日贞","text":"满眼烟光暖欲醺，回思粉面杳如云。\n恨无崔护桃花句，泣断春风也不闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其四十九","author":"彭日贞","text":"犹忆乔仙共锦航，采莲午日醉霞觞。\n小怜空有佳名号，命薄如丝续不长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其五十","author":"彭日贞","text":"荔支红忆醉颜红，笑倚菱歌荡桨同。\n十里香风人不见，乱荷深处小船通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其五十一","author":"彭日贞","text":"情热鸳鸯蓦地分，悲凉离绪怨秋云。\n泉台去处漫漫黑，肠断凭谁说与君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其五十二","author":"彭日贞","text":"朔气阴阴雪满貂，小乔玉冷暗香消。\n世间金屋非难事，长恨无缘贮阿娇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其五十三","author":"彭日贞","text":"盈盈微步涉江间，一梦迷娇绝玉颜。\n何似文姬嫁胡去，恨传笳拍却生还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其五十四","author":"彭日贞","text":"咫尺东洲去不回，小乔踪迹费人猜。\n非朝非暮非云雨，魏帝无方拟夜来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其五十五","author":"彭日贞","text":"乔婧轻拌金缕衣，杜秋断送少年时。\n如今纵有青楼约，长恨无花空折枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其五十六","author":"彭日贞","text":"濒行解赠别前楹，别后那知薄命倾。\n扶我梳头从此绝，不关结发也伤情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其五十七","author":"彭日贞","text":"闻道乔仙委蜕时，痛熏鲍艾损蛾眉。\n纵然白獭膏能觅，谁起卿完似玉肌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其五十八","author":"彭日贞","text":"小乔茹淡意偏谐，蕙聚同甘愿早乖。\n我忆微之伤逝句，为君营地把香埋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其五十九","author":"彭日贞","text":"芳魂零落黯松楸，颠倒华山泣断丘。\n命薄只教千古恨，一翻风雨一翻愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其六十","author":"彭日贞","text":"昔看才艳压仙班，今寄孤坟寂寞山。\n词客共怜冰玉骨，新诗凭吊满人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其六十一","author":"彭日贞","text":"春原细草碧萋萋，怅忆张乔泪眼低。\n前度飞觞听艳曲，繁花销尽鹧鸪啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其六十二","author":"彭日贞","text":"藓满瑶阶绿作茵，春来纤履步芳尘。\n玉儿身去苍烟暮，零落金莲不见人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其六十三","author":"彭日贞","text":"绿鬓髫髫张倩娘，才华未嫁早凋伤。\n无情相及犹应哭，何况人非阮藉狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其六十四","author":"彭日贞","text":"候涉朱明花欲然，柴扉深掩篆销烟。\n敲诗按曲生无分，白日荒荒拥病眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其六十五","author":"彭日贞","text":"消愁比苑寻芳日，忽忆东洲恨别时。\n病眼怯看花带露，依稀清泪湿胭脂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其六十六","author":"彭日贞","text":"无端幽抱迸难裁，堆叠春愁扫不开。\n遗扇有诗长把咏，娟娟犹忆梦中来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其六十七","author":"彭日贞","text":"小院閒香婉娈情，夜凉入梦较分明。\n与君别后怀中事，枕畔喁喁彻五更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其六十八","author":"彭日贞","text":"绣被无劳蕙炷熏，风流欢散楚天云。\n去年元夕灯前酒，犹记藏阄笑夜分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其六十九","author":"彭日贞","text":"碧海澄澄转玉盘，鲛人初怯露华寒。\n水精宫院青辉彻，愁杀红绡倚槛看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其七十","author":"彭日贞","text":"桂影当樽莲漏岩，翠楼良夜捲珠帘。\n今来望月成追忆，怀抱逢秋一倍添。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其七十一","author":"彭日贞","text":"海上仙山有十洲，璇房幽绝最宜秋。\n蓦然远忆心期事，谁慰张乔翠黛愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其七十二","author":"彭日贞","text":"七日欢恩百岁情，他生还认李元平。\n小乔设愿终成否，肠断凭诗问九京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其七十三","author":"彭日贞","text":"红粉佳人碧玉妆，轻盈曾是杜兰香。\n风前响绝飞仙曲，每忆当时暗断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其七十四","author":"彭日贞","text":"挽逝长歌懊恼诗，小乔东去未曾知。\n南唐后主伤心句，佳节缠哀不自持。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其七十五","author":"彭日贞","text":"乔倩香埋落北阡，伤心不忍说蓝田。\n空怜死有招魂赋，自恨生无种玉缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其七十六","author":"彭日贞","text":"一抔新土丽人家，水垒峦层涧道斜。\n珍重不教文采没，为君新植满山花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其七十七","author":"彭日贞","text":"挥洒闲窗得几朝，风兰湘竹一时描。\n笔踪卷上新如昨，艳魄泉中久已销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其七十八","author":"彭日贞","text":"一觉扬州梦几年，不堪回忆旧情缘。\n锦筝冷落轻尘锁，细雨霏霏寒食天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其七十九","author":"彭日贞","text":"林下高襟酒与诗，风流通德抱幽思。\n眼前开谢成今古，忆对伶元拥髻时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其八十","author":"彭日贞","text":"萧萧秋籁夜愁生，舞叶如闻响屧行。\n帷影灯魂殊恍惚，西风吹梦竹房清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其八十一","author":"彭日贞","text":"新诗遥寄枕前开，垂死呼灯咏几回。\n刚为断肠教下咽，此心争道肯成灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其八十二","author":"彭日贞","text":"二乔莫恨世缘悭，早谢风尘到是闲。\n犹胜题红深院里，断肠终日忆人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其八十三","author":"彭日贞","text":"无复南楼倚翠屏，风花着水叹飘零。\n兰因絮果生前业，掩抑诗篇恨小青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其八十四","author":"彭日贞","text":"画图春风一面娇，难凭颜色驻轻绡。\n为君和泪编遗稿，留取千秋认小乔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其八十五","author":"彭日贞","text":"西墅池亭背郭开，小乔同赋忆寻梅。\n可怜入望盈盈水，曾照惊鸿步影来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其八十六","author":"彭日贞","text":"双楼池馆又经春，前度花开漾眼新。\n风暖蝶轻啼鸟缓，到来偏忆旧游人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其八十七","author":"彭日贞","text":"神女巫山底事非，同游踪迹尚依依。\n清宵好入襄王梦，莫漫为云到处飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其八十八","author":"彭日贞","text":"小乔疑隔大江隈，铁锁横空鐍不开。\n争似莫愁双桨渡，轻舟容易送将来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其八十九","author":"彭日贞","text":"彷佛声尘欲见难，衔哀思影觉心酸。\n一觞絮奠惭韩重，安得邀为三日欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其九十","author":"彭日贞","text":"艳质当春遽堕红，玉颜飘没水归东。\n空怜一枕游仙梦，不逐云英入洞中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其九十一","author":"彭日贞","text":"小乔命薄似秋云，滴泪研珠写诔文。\n花发菖蒲人已葬，悲风凄断薛涛坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其九十二","author":"彭日贞","text":"山花迎笑忆温柔，袅袅回风舞未休。\n落得榆钱空满地，不堪持赠作缠头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其九十三","author":"彭日贞","text":"千秋彤史有遗诗，词客登临吊古碑。\n谁是王轩冥感切，留题石上见西施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其九十四","author":"彭日贞","text":"青娥词藻艳相闻，身后金钗有小坟。\n留得东南风雅在，几多时辈不如君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其九十五","author":"彭日贞","text":"玉埋尘土过春三，为祝芳魂扣小庵。\n泪染竹枝君不见，断肠聊拟望江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其九十六","author":"彭日贞","text":"芳华销歇古来多，欲哭张乔且放歌。\n借问赵家痴姊妹，六宫专宠近如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其九十七","author":"彭日贞","text":"二乔高格重词场，瘗玉郊原骨更香。\n我似吴门风雅客，痴情颠倒咏真娘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其九十八","author":"彭日贞","text":"幽窗寂寂晚风悲，为忆深恩漫赋诗。\n若论玉颜题百咏，小乔应笑比红儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其九十九","author":"彭日贞","text":"徒倚长谣愁作堆，情钟生死自堪哀。\n欲销葛尉无穷恨，除是张乔再世来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恻恻吟 其一○○","author":"彭日贞","text":"吞声旧咏几汍澜，恻恻新题恨百端。\n悲动有时终一读，弥天风雨黯窗寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小怀仙 其一","author":"彭日贞","text":"花前踪迹已茫茫，梦里寻君枉断肠。\n再世纵为连理树，此生那觅返魂香。\n帘窥燕语翻歌拍，竹罥游丝学舞裳。\n一自缄题遥诀后，几回临宴不成狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小怀仙 其二","author":"彭日贞","text":"绞绡遥寄泪痕鲜，生死情怀最可怜。\n幻梦破残知是梦，佳缘愁绝竟无缘。\n香分韩寿辞青琐，艳逐麻姑变碧莲。\n石上精魂何处是，夜寒添冻半床眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小怀仙 其三","author":"彭日贞","text":"十九春光尚未盈，瑶台遥傍许飞琼。\n空馀奔月流辉影，无复行云响佩声。\n玉管奏花思并蒂，朱弦调谱泣双清。\n亦知歌舞君馀技，恨尔称诗风雅成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小怀仙 其四","author":"彭日贞","text":"佳人自昔称难再，荀倩偏伤别后神。\n岂有潜英还素魄，漫劳洛浦觅微尘。\n竟虚松柏心期誓，空现梅花梦里身。\n碧落黄泉穷不得，百千哀怨两眉颦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小怀仙 其五","author":"彭日贞","text":"属笔何堪赋悼亡，风流昔擅少年场。\n当枰犹忆争棋道，把酒难凭佐客觞。\n檀板拍残山鸟怨，画衣熏散野花香。\n黄垆自古消红粉，为尔临风泪万行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小怀仙 其六","author":"彭日贞","text":"冷艳影图容易就，娇痴心性最难描。\n为怜笑语人长别，翻怕丹青粉渐消。\n素魄忍看鸳冢闭，香魂哀乞蝶裙招。\n韦皋幽怨元无极，再世茫茫问玉箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":42845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]