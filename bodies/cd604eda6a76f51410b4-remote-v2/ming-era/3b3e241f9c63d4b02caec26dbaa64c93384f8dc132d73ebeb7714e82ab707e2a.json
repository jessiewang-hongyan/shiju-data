[{"title":"雨中怀友","author":"李时行","text":"客里秋风叹索居，况兼旬雨更愁余。\n故园正值黄花候，京国偏逢落雁初。\n袁绍未收襄北盗，相如犹对茂陵书。\n风尘荏苒归何日，无限羁怀祇自纾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游上天竺遂登诸峰绝顶","author":"李时行","text":"二仪肇开辟，山水相摩融。\n南洲峭奇削，仙界敞神宫。\n云端列莲座，竹外聆疏钟。\n高僧皆驭鹤，金鼎尽蟠龙。\n怀芳事幽讨，巇崄相追穷。\n扪萝回石径，披雾凌苍空。\n身被翠云服，手握青藜筇。\n缥缈仙源接，纡萦云路通。\n蹑足攀绝顶，群真杳来从。\n振衣划然笑，鸾声落长松。\n仰窥天阙近，象纬横西东。\n俯瞰坤舆狭，巘崿纷嵷巃。\n眺远云为地，乘虚步随空。\n璚杖挺虚谷，玉蕊灿春丛。\n璚津芬可挹，石髓会应逢。\n近阅安期舄，遥企王乔踪。\n玄机如可度，学炼此山中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送东崖李都阃入觐还楚","author":"李时行","text":"十年楚国驰驱日，此夕京华邂逅间。\n素向幕中穷虎略，远从天上觐龙颜。\n九疑木叶飞红雨，七泽波涛涌雪山。\n惆怅相逢又相别，几时重听佩声还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中见月","author":"李时行","text":"江静波光练，天空月色孤。\n崇林烟外密，远岫霭中无。\n流萤依露草，旅雁宿秋蒲。\n坐觉良宵永，悠然逸兴俱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"楚江遇雪感怀","author":"李时行","text":"彭泽波涛壮，浔阳雨雪飘。\n扬帆冲暮霭，击枻趁春潮。\n柳暗章台路，花深海市桥。\n追游怀宋玉，魂去竟谁招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜怀舍弟少芬","author":"李时行","text":"露滴疏松月在梧，三更飞梦到西湖。\n秋深渐觉南云远，泽国空嗟雁影孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"听琴","author":"李时行","text":"几曲高流清客心，恍疑风雨夜龙吟。\n子期一去无人会，寂寞谁传太古音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陡门见雪寄吴南曾方伯","author":"李时行","text":"肃穆胶客饮，杯端气初结。\n靡靡玉带凝，皓皓银塘洁。\n飞空类散花，虚映瑶台月。\n胡为乘兴来，独鼓山阴楫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金山寺","author":"李时行","text":"重楼馀蜃气，双塔锁鳌峰。\n振锡归林鹤，挥云起钵龙。\n梵影涵秋月，潮声送暮钟。\n净缘如可结，于此卧寒松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小金山夜宴别亲友","author":"李时行","text":"珠江维别舸，郁水敞离觞。\n锦瑟翻新调，春花发暗香。\n开襟情不极，携手意难忘。\n今夕同看月，明朝各异乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋词","author":"李时行","text":"淅淅天风吹女萝，感时怀抱入秋多。\n音书望断南来雁，心思虚随东逝波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋","author":"李时行","text":"秋高云静渺烟霏，璧月澄空澹素辉。\n万里关河应入望，九霄风露觉沾衣。\n巢边鸟雀方栖稳，水底鱼龙合奋飞。\n遥忆故山知己在，每逢佳节便思归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠王沂川","author":"李时行","text":"爱汝词华俊，才名人所闻。\n高风齐孺子，逸思过参军。\n剑气藏珠斗，丹光拂紫云。\n招携吾岂敢，端坐慕清芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朝天宫听笙","author":"李时行","text":"碧殿高临太乙坛，坛前羽客紫霞冠。\n仙童解奏霓裳曲，引得双飞月下鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿月溪黄山人山房","author":"李时行","text":"山静四宇幽，松涛半空落。\n采药夜归来，黄云引孤鹤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望湖亭","author":"李时行","text":"紫逻通玄圃，珠林抱镜湖。\n机忘鸥鸟狎，心静水云孤。\n地拥三吴胜，天开七宝图。\n何时容卜筑，携鹤拟仙逋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早朝日寄所知","author":"李时行","text":"汉家楼阁倚天开，紫禁烟花锦作堆。\n太液池边云隐现，玉河堤畔水萦回。\n天临綵仗龙旂动，月引丹舆凤管催。\n随舞霓裳歌白雪，月痕尚印荫三才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游三过堂赠徐鹤山","author":"李时行","text":"永日延清暇，山亭啸傲时。\n诸峰留晚照，一水湛清漪。\n静倚青藜杖，狂吟白苧词。\n沧洲吾道在，潇洒任吾之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有所思","author":"李时行","text":"长安少年才十六，小可躯材爱装束。\n紫袷偏垂金错囊，绣鞢斜约玲珑玉。\n此时相见即相怜，驻马回车问岁年。\n朱户乍开云母帐，雕栏不捲水晶帘。\n水晶云母风光早，细柳夭桃觉春好。\n芳渚双浮跃藻鳞，娇枝对坐啼花鸟。\n春来物色总难禁，况逢春鸟感春心。\n乍可花间成并蒂，那能陌上受黄金。\n花开大道联芳蓹，陌上高台云外举。\n不将锦瑟向君王，愿把鸾箫学秦女。\n曾闻投漆不分离，曾闻比目戏涟漪。\n可怜邂逅情非一，持此殷勤两不疑。\n轻雨轻云过绿琐，看花看柳争婀娜。\n碧筒朝泛合欢卮，金莲夜结双头朵。\n自谓欢娱尽百年，自矜娇小得人怜。\n调丝忽断离前曲，望月翻成别处圆。\n妾住崤函君向洛，镜里箫边两疏索。\n花发初怜春正芳，春归不待花零落。\n悠悠长路阻云风，望望云山知几重。\n去雁千回空有问，来骖百过讵能从。\n来骖去雁情无已，暮暮朝朝铅色委。\n祇拟缠绵比兔丝，相依那得长松树。\n妾心愿作高唐云，飞来飞去不见君。\n君身岂是丰城剑，那有长光天上见。\n锦字虚将洛水湄，玉容空锁梨花院。\n传闻金谷丽妖娃，更道铜驼好物华。\n练影时飞千里辔，香尘惯逐五侯车。\n别有青楼照南陌，瑶窗绣栱玻瓈色。\n深深灯火出娥眉，款款笙歌留上客。\n上客春游春未央，贱妾空房空自伤。\n初言别去方三月，谁解忧来历九霜。\n昨日娇痴今老丑，沧海桑田讵能又。\n寄语今时游冶郎，须怜旧日章台柳。\n柳色青青河水滨，柳丝缕缕恋芳辰。\n耐将枝叶留君折，莫待摧残空复春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月下观潮同王叔廉赋","author":"李时行","text":"啼鸟哑哑日初没，金瓯欲空捲瑶席。\n醉中招却五陵豪，走马出城观海汐。\n此时八月天气高，霜华暗落风萧骚。\n俄惊片月出海底，白璧一轮腾泬寥。\n波明月皎相辉炫，月色波光杳难辩。\n掩映如临云母堆，清冷疑在玻瓈殿。\n初闻隐隐复隤隤，旋摇地轴殷鸣雷。\n三军缟素声阗涌，白马来奔怒未回。\n须臾喷沫乱如雨，洪涛激空雪山竖。\n秦冈乍裂起千蛟，梁堰忽崩百里喧。\n灏气虚涵若水山，天声直捣子胥湾。\n吐吞击抟不可禦，高塘巨石愁摧翻。\n灵祇变幻在俄顷，诸豪抵掌叹奇警。\n顿使雄襟去垢氛，三百金杯一时醒。\n我亦飘飘湖海身，翛然对此瑩心神。\n遥闻天上银潢接，直欲乘槎去问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镇海楼","author":"李时行","text":"缥缈飞楼高接天，窗临星斗望中悬。\n浮空雪浪三江口，映树晴霞五岭前。\n草长越台连野色，花深药圃暗春烟。\n倚栏极北频回首，遥指长安在日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄嵇南川太史","author":"李时行","text":"叔夜擅风流，陶情水石幽。\n一春多中酒，几日不梳头。\n对月移歌席，披烟弄钓舟。\n何时理棹去，同尔竹林游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游小金山","author":"何孟伦","text":"十二栏干俯碧流，偶来乘兴此追游。\n灵岩环瞰千山迥，郁水遥分一派收。\n云共昙花閒梵钵，月将潭影纳虚舟。\n江涵竹树苍烟合，海气山岚不断秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古 其一","author":"何孟伦","text":"航海东南计已穷，逢厓今日运将终。\n枫林魂散千山黑，瘴海龙归百战空。\n惨结玄黄迷极浦，泪随寒雨陨霜风。\n悠悠今古兴亡恨，落日啼乌古殿钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古 其二","author":"何孟伦","text":"乱云斜日隐荒宫，王气消沈向此中。\n穷野腥膻俱犬彘，海门风雨泣鱼龙。\n誓心报国英雄尽，起义勤王事业空。\n多少冤魂招不得，至今长恨水流东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长相思","author":"何孟伦","text":"洞庭天阔雁来迟，迢递江南秋暮时。\n新题锦字光陆离，欲寄幽情无所之。\n长相思，心恻恻，楚水吴山杳相隔。\n青枫摇落夜乌啼，风露泠泠远空碧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨夜","author":"何孟伦","text":"凉风入窗户，翻我读残书。\n叶落苔阶寂，春閒木榻虚。\n阴晴看异局，伎俩笑迂儒。\n搔首独长啸，幡怀太古初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊飞来寺","author":"何孟伦","text":"扁舟重过峡山寺，老衲相迎停夕曛。\n宝刹云深人不到，玉环尘寂事空闻。\n诸山对峙双门迥，一水中流两岸分。\n千古依依名胜地，断崖枯木护閒云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江门舟夜","author":"何孟伦","text":"前村烟树落微茫，待月听潮夜未央。\n沽酒人家在何处，竹灯明灭隔沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游海珠寺 其一","author":"何孟伦","text":"玻璃荡漾浴晴空，突出中流见梵宫。\n绿荫周遭烟树杳，黄湾迢递海潮通。\n光涵南极摇星纬，影动波心起卧龙。\n回首沧江明月上，满天秋色磬声中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游海珠寺 其二","author":"何孟伦","text":"招提古树隔江城，江上潮声杂橹声。\n弦月乍窥潭底见，微风不动镜中行。\n云连琪树青芜合，雨逗春江绿涨平。\n万顷瑶光漫无际，水天涵映夜珠明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游海珠寺 其三","author":"何孟伦","text":"乘月谁将独夜舟，偶寻幽胜得芳洲。\n青连溟树四时景，绿泛微风两岸秋。\n地隔飞尘无俗客，僧閒作伴有盟鸥。\n何时更遂沧洲约，山色湖光共白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游海珠寺 其四","author":"何孟伦","text":"绿树微遮两岸分，楼台隐映隔江津。\n机心自息鸥盟我，俗客难寻老是宾。\n临水清秋开罨画，濯缨深夜动星辰。\n文溪逝水东流远，犹有馀波属后人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旅馆秋日怀旧隐 其一","author":"萧端蒙","text":"青山真与故人违，万里相思共落晖。\n忽见飙风生客幌，遥知秋色度柴扉。\n江云岭树情无限，翠壁丹梯事已非。\n南望征鸿凭寄语，张翰应是未能归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出自蓟北门 其一","author":"萧端蒙","text":"蓟门何苍苍，渔水何湲湲。\n壮夫身在边，那能复生还。\n千金买骏马，百金饰刀环。\n相邀晓出塞，誓捣贺兰山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出自蓟北门 其二","author":"萧端蒙","text":"饮马长城窟，回首望家乡。\n家乡日以远，朔风日以长。\n风吹游子衣，涕泪忽滂滂。\n岂不怀归来，匈奴在边疆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫词四首 其二","author":"萧端蒙","text":"长信宫中日影稀，终南山外白云微。\n閒情不买相如赋，泉水歌残又绿衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫词四首 其三","author":"萧端蒙","text":"参差官树乱啼莺，后院沉沉坐月明。\n玉辇不来春已半，遥闻凤吹隔霞声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫词四首 其四","author":"萧端蒙","text":"绣帘终日祇低垂，伴女相邀看奕棋。\n细说羊车消息远，谩传秋后册昭仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阳泾为同年袁定山尊甫作","author":"萧端蒙","text":"别业薄菰浦，渔矶映橘洲。\n晚罾鲈鲙细，秋陇稻花稠。\n泾匝长文宅，烟生鲁望舟。\n年来疏散趣，雅足称风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送香山郭使君","author":"萧端蒙","text":"春日发云端，东风画旆寒。\n符分南粤岛，舟度郁孤滩。\n海郡惊仇览，乡闾壮郭丹。\n才沦君莫叹，此地暂栖鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日","author":"萧端蒙","text":"上苑春应去，西昆日正长。\n薰风回锦瑟，暖气散雕梁。\n池静荷花白，台空杏子黄。\n悠悠感时变，朱火忽微茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明妃曲 其一","author":"萧端蒙","text":"朔雪胡沙拂羽旌，君王命重妾身轻。\n和戎本为苍生计，敢惮焉知万里行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明妃曲 其二","author":"萧端蒙","text":"绣辇东来琛骑驰，蛾眉亦自繫安危。\n如今塞上无遣镞，不说军中有贰师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明妃曲 其三","author":"萧端蒙","text":"羌塞翩翩三十春，毳裘潼酪亦甘温。\n自从冯傅纷纷后，始悟馀生是主恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明妃曲 其四","author":"萧端蒙","text":"秋叶萎黄思不禁，灞川荆峡两幽沉。\n游魂不逐胡笳散，冢草青青见妾心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日登韩山","author":"郭廷序","text":"松风满袖觉身轻，蹑屩登临逸兴生。\n夹路野花迎客笑，隔林幽鸟向人鸣。\n爱閒愁向尘中老，吊古能无物外情。\n百岁重阳逢有几，浩歌归去月华明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳游西湖山次石上韵","author":"郭廷序","text":"采兰人竞出湖西，騄駬蹄轻去若飞。\n酒听鸟声传不住，席移树影坐忘归。\n烟花过雨枝枝瘦，霜竹穿云笋笋肥。\n隔岸遥山是何处，绿围红拥望中微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古别离","author":"郭廷序","text":"自少不出门，岂识天涯阻。\n郎欲上青霄，舟系江之浒。\n从容对我言，慷慨无多语。\n妾亦不知愁，率尔聊相许。\n风雨近深更，闻鸡还起舞。\n酌酒壮行装，薄劝三杯住。\n执手问归期，笑指相如柱。\n匆匆分袂间，对面无分付。\n上马出门行，马首犹一顾。\n归来心始忧，此别何仓遽。\n孤灯耿兰房，滚滚流光度。\n记得别君初，黄花冒寒露。\n此日又春回，绿柳阴如雾。\n登堂拜问姑，郎行何久处。\n姑愁颜强笑，神京八千路。\n闻语暗心惊，低头泪如雨。\n那知大丈夫，一别轻如羽。\n妾欲寄新衣，肥瘦应如故。\n消息两茫然，鹊语空相误。\n欲上望夫山，愁心不成步。\n清宵欲望之，东西忽迷路。\n何敢怨归迟，愿接夔龙武。\n仗剑向南面，风光应未暮。\n却恐凤书严，致身归圣主。\n草色上空阶，衡门疏旧屦。\n郎兮归去来，毋为功名苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招隐","author":"郭廷序","text":"逍遥出城郭，步入西山阿。\n断桥芳草合，幽径落花多。\n扪萝跻绝壁，牵裳涉清波。\n閒云自舒捲，绿絮郁婆娑。\n禽鸟巢丛竹，猿猱啸高柯。\n飞泉下岩窦，声如琴瑟和。\n中有巢由徒，岁寒心靡他。\n朝吟考槃诗，夕诵采薇歌。\n我欲往从之，雅志成蹉跎。\n迟回愆岁月，如此美人何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"萧烈女","author":"何派行","text":"西风吹血溅戎衣，负骨山头忍泪时。\n青冢月明啼杜宇，绿杨烟净啭黄鹂。\n百年俎豆嗟殊土，千古纲常耀短碑。\n望尽冈州云没处，墓门芳草正离离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读水程","author":"黄显","text":"太庙应禅峡，终朝近梵宫。\n往来均履顺，动静各悬空。\n舟楫资人力，波涛擅帝功。\n夜梦莫须有，天机将无同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"羊城吊古","author":"潘光统","text":"南国川原几变更，三杯长啸不胜情。\n蓬蒿半掩刘王坞，山水犹盘陆贾城。\n海寺晚风传梵呗，石门斜日送江声。\n登临不用嗟殊代，翡翠明珠属汉京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠寺别欧桢伯 其一","author":"潘光统","text":"龙宫开海上，独客晚经过。\n老衲寒初破，灵花雨后多。\n心空无色相，院静有檀那。\n玄度期将至，临风听棹歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠寺别欧桢伯 其二","author":"潘光统","text":"兰桨乘流泛，偏怜萍梗踪。\n鸿鸣寒碛月，霜送夜船钟。\n交岂时情改，年惊伏腊逢。\n分襟在明发，何地更相从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日侍家慈过南园","author":"潘光统","text":"家园欢赏处，卉木正欣然。\n节序逢人日，生全荷母天。\n赁舂非庑下，戏綵且堂前。\n岂薄毛生檄，儿孙解种田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中对月忆家慈","author":"潘光统","text":"山月扬清光，照我芙蓉裳。\n娟娟如故国，游子滞他乡。\n他乡见月心独苦，正是家人望游子。\n衡岳峰头断雁群，扶胥浦口沉双鲤。\n庭前老母白发稀，日日倚门望子归。\n燕京九月严霜候，应念羁人未授衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小金山送别启猷弟会试","author":"潘光统","text":"熬峰重访长公祠，离思深凭酒一卮。\n台上千金招骏足，云边五色映龙池。\n梅关传舍闻鸡早，彭蠡秋风过雁迟。\n别后草堂应入梦，音书何日慰吾思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次和黄宫詹泰泉先生喜家伯父罗江公以尚书郎乞休南归","author":"潘光统","text":"洲边新筑钓鱼台，菡萏蒹葭两岸回。\n一自松楸承雨露，即从廷陛乞归来。\n竹林清咏怜余后，菊径芳樽待客开。\n自昔江湖多恋阙，好从北极望蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出京","author":"潘光统","text":"献书此日出神州，残雪飞花满敝裘。\n万里归心悬白发，三年离恨忆沧洲。\n驱驰南北成多病，感慨烽烟欲倦游。\n何处买山堪寄傲，丹砂吾拟问罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤城秋夜柬陈士鹄郡丞","author":"潘光统","text":"摇落离群思不胜，美人遥隔暮云层。\n梦回双杵孤城月，愁入寒窗独夜灯。\n黄菊秋深应送酒，白莲何处共寻僧。\n龙山此日重阳近，杖屦从君更一登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]