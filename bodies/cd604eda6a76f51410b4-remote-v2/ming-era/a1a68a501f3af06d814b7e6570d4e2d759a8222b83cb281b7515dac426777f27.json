[{"title":"初春感怀寄马孟高社丈","author":"何其伟","text":"腊尽年踰物候新，盈眸何处不风尘。\n沧波浩淼蛟龙斗，野况优游鹿豕伦。\n袖里书成愁雁鹜，楼头吟望阻江滨。\n剡溪雪夜难乘兴，暂折寒梅寄早春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黄卓表见怀之作","author":"何其伟","text":"冬深客思转萧萧，文苑书来破寂寥。\n剑倚青蘋看斗极，诗成白雪傍云霄。\n栖真津浦閒挥麈，寄傲蒲溪欲弃瓢。\n叔度风流思聚首，几回扶策望征轺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居省城感赋一首","author":"何其伟","text":"江村频斥堠，避地且藏身。\n未必离乡井，聊为出世人。\n望穷二岛界，梦绕五湖滨。\n倘遇群真侣，相期共结邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲子元日宇亮孙入省枉集山馆观灯","author":"何其伟","text":"山馆张灯夜，何来一俊人。\n金莲初色艳，玉漏莫声频。\n社结枌榆旧，舟凌剡水新。\n平原欢圣酒，披豁任吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨河泊赴任荆州辽府仓曹","author":"何其伟","text":"首夏沿堤柳飏丝，送君归去黯然悲。\n汪洋恺泽留心印，欸乃渔歌作口碑。\n珠浦云开帆度渺，荆门路绕马征迟。\n长裾莫厌平台曳，何地经纶不可施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒林岳祖坟陈君以诗见投次韵答之","author":"何其伟","text":"先代音容妥岳岑，白杨风飒转萧森。\n贻谋世泽年将远，洒拂孤坟泪与深。\n缭绕兆阡连宅畔，笼葱佳气郁山林。\n荀陈谊重干霄汉，白雪飞投见客心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马孟高将乡旋偕法南禅师携酒过别即席各赋一首","author":"何其伟","text":"白眉词客善谈天，穷巷联镳共话禅。\n骀荡情深珠海外，淋漓酒态杏花前。\n杯行席上摇青玉，两足峰头散绿烟。\n何物最为关别恨，野桥残月照清涟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答寅汉侄孙九日登高见怀之作","author":"何其伟","text":"遥传高调复高情，只字堪当十五城。\n歌罢牛山开罨画，吟成戏马斗峥嵘。\n衔杯席上需陶子，落帽风前忆孟生。\n时事岂能搔侠兴，定期春酒此同倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿寅汉母八十一","author":"何其伟","text":"中天列宿婺星明，玄女飞琼宝座盈。\n十数孙曾迎凤辇，三翻清浅看蓬瀛。\n频倾玉洞萄为醴，载嚼瑶池枣似瓜。\n闻道西王占女籍，相将鸡犬问桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答李亮侯寓文康梁公祠左见怀之作","author":"何其伟","text":"栖遁山门拥薜萝，旧游离索怅怀多。\n珠投皛皛回霄汉，藻思纚纚绚绮疏。\n相府居停连数武，通家义重一相过。\n留宾愧我无鸡黍，兴尽平原奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日李亮侯过访即席限多字各赋一首","author":"何其伟","text":"年来霜鬓傲蹉跎，廿载兰交意气多。\n苔径忽闻喧燕雀，蓬门旋为辟蒿萝。\n衔杯漫倚双文剑，击唾相怜一啸歌。\n感旧壮怀俱不浅，至今搔首付沧波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲子冬寅阳卜居仓边邻左赋此贻之","author":"何其伟","text":"避地城隈日自斜，萑苻历乱老年华。\n旅怀独切三更漏，归梦虚随八月槎。\n穷巷久抛荒桂渚，芳邻近接话桑麻。\n翻怜萍梗愁孤影，缩地于今正一家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄苏四郎","author":"何其伟","text":"多君碧海卧烟霞，竞爽才名拟谢家。\n一枕香风飞梦远，廿年蓬鬓傲霜华。\n歌翻棣鄂酬清圣，乐奏埙篪舞镆铘。\n暂写相思舒别恨，垄头空自折梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄苏应槐","author":"何其伟","text":"投分良非少，知音谁复多。\n君饶幼妇调，吾奈老狂何。\n聚首惊霜鬓，相携踏雪歌。\n兰芽新茁玉，行矣听鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄苏仲辂","author":"何其伟","text":"碧水逍遥半壁间，硕人心迹迥尘寰。\n交联一臂蝉联席，业在千秋副在山。\n开径有花流盻远，干时无策寸心閒。\n飞觞积翠还能否，乘兴寻盟早叩关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄苏仲吕","author":"何其伟","text":"论交见弟旧，握别已多时。\n三复长公赋，谁赓幼妇词。\n梦魂迷去路，警柝起遐思。\n残腊梅先破，从他点鬓丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄苏仲芳","author":"何其伟","text":"昔从碧社结青莲，屈指分携几换年。\n当日弟兄齐竞爽，朅来萍梗隔风烟。\n停云珠浦春裁赋，步月津亭夜不眠。\n五岳胸中知不减，期君长啸白云天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲子除夕前二日立春","author":"何其伟","text":"腊残二日迎春日，除夕先晨已报春。\n蓬岛沧桑三过睫，昂藏天地几朝身。\n望乡心逐年华转，怀土情随柳眼新。\n翘首彤云瞻拜迥，彩毫裁颂祝枫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙丑元日同寅阳赋","author":"何其伟","text":"聿转初正候，柴门向晓开。\n柏尊谁为办，椒颂尔先裁。\n景色三城媚，年华两鬓催。\n履新应与日，遥睇祝天台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日过苏廷襄宅畔池亭各赋一首","author":"何其伟","text":"丁年投分邈山河，念昔寻盟曳履过。\n把袂开轩临沼沚，烹茶滴雪傍松萝。\n交亲羡尔青云壮，感旧怜余白发多。\n自是通家词谊重，空忧和客愧羊何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙丑新正九日书怀","author":"何其伟","text":"漠漠晓烟枫树林，开轩舒抱发清吟。\n老夫庭畔关情日，游子天涯恋阙心。\n燕市樽醪谁共赋，云霄冠盖重相寻。\n忽闻檐外嘈嘈雀，驿使应驰报好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙丑正月十八夜苏廷襄宅灯宴","author":"何其伟","text":"讵谓灯阑夕，烟花集绮筵。\n千门仍火树，九陌尚钧弦。\n节去邀欢住，春明结社连。\n分题怜此会，刻烛为谁燃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊新城与遂芳丈舟中小酌","author":"何其伟","text":"两足峰头万仞青，维稍杨柳泊新城。\n三江湍急催仙艗，孤扬杨舲走客旌。\n欹枕樵楼更漏永，谈天星斗夜分明。\n蝉联不尽邮签去，弹剑酣歌彻太清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14688,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天台晚眺","author":"何其伟","text":"万仞芙蓉削汉青，偏舟遥望一峰晴。\n岧峣孤屿开图画，缥渺群真列翠屏。\n碧落影函高象纬，层霄倒插入沧溟。\n仙根带露和烟滴，赢接香风扑鼻清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14689,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟过兰溪望富阳","author":"何其伟","text":"目极峰峦海上浮，挂帆天际踏歌游。\n严陵踪迹知何处，富邑山河入望收。\n水廓民氓沾恺泽，沧江士庶饮清流。\n观风问俗邮签至，帝德恩洪遍九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14690,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五月廿四日舟抵富阳忽承约初老丈以诗见投奉答一首","author":"何其伟","text":"朱夏沿堤柳色鲜，桐江瑶草坠云天。\n汉庭经术推高第，晋室才华独著鞭。\n摇麈谈天更漏转，徵歌促席夜杯传。\n何因得接双龙气，愿借馀光照简编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14691,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"富春钓台","author":"何其伟","text":"纵苇如川击汰玲，富春真迹几千龄。\n一丝常蘸漪桐水，九鼎凭将系汉庭。\n日射台端生气凛，风摧沙响透窗棂。\n长竿倘借矶边弄，勿讶江南有客星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14692,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄答苏廷襄","author":"何其伟","text":"梦入清斋路未真，觉来怜旧转伤神。\n荀陈谊重干霄汉，苏颋才华出世尘。\n一醉乡心时自起，三城秋事总忧贫。\n巴歌敢谓酬双璧，聊写相思寄羽鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14693,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五马山","author":"何其伟","text":"五马腾空绕翠寰，徘徊疑是大夫山。\n分明出自天闲骏，蹀躞何时得驻骖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14694,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋夜集限秋字","author":"何其伟","text":"漏下沉沉溽气收，井梧飘叶露华浮。\n谈玄锦帐风初落，握麈星河夜欲流。\n羌笛调残芦苇月，塞鸿声动海门秋。\n惊心节序催蓬鬓，旅客能无罢远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14695,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕","author":"何其伟","text":"日落秋阴客并游，况逢佳节漫淹留。\n频年多病怜司马，此夕孤灯看女牛。\n凤舄独随青鸟渡，鹊桥谁架彩云浮。\n相携未尽翻离恨，河汉遥添别泪流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14696,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居四咏为区封君赋 其一 春日","author":"何其伟","text":"遁迹风尘外，萧然一古琴。\n鹍弦调雅咏，鸠杖为芳寻。\n兴逐潺湲淼，情陶蔽芾阴。\n尊开倾柏叶，抱膝独长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14697,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居四咏为区封君赋 其二 夏日","author":"何其伟","text":"清和饶永日，骚雅重江乡。\n河朔衔杯剧，高阳引兴长。\n屐缘芳径湿，裳带茭荷香。\n坐石疏松荫，时闻奏鼓簧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14698,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居四咏为区封君赋 其三 秋日","author":"何其伟","text":"萧瑟菊花天，高人足晏眠。\n长生惟药裹，时世傲桑田。\n三径逃名卧，一经课子传。\n封章驰汉室，丹凤五云翩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14699,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居四咏为区封君赋 其四 冬日","author":"何其伟","text":"园林可自适，避俗结幽盟。\n帘捲青山暮，歌翻白苧清。\n杖藜看雪积，把酒听鸿鸣。\n服炼凌霜秀，梅花点鬓生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14700,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偕苏玄山念吾叔侄景山经佐昆玉集山房对菊","author":"何其伟","text":"携尊娱永夜，促席傍花移。\n香送金飙转，英含月露垂。\n竹林推并美，玉树总堪奇。\n际此凌霜候，同著傲雪姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14701,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚泊榕树潭","author":"何其伟","text":"春风摇淡荡，水国片帆轻。\n怪石侵江出，奇峰截岸横。\n浦云移远树，江月照行旌。\n寥泊榕阴晚，清狂咏濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14702,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋得吟字","author":"何其伟","text":"徙倚南楼日已沉，冰轮初涌散枫林。\n西风隔水谁家篴，明月满庭何处砧。\n辉落关山惊皓荡，光侵松桂转萧森。\n抚时按剑心偏切，彩笔聊为白雪吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14703,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日郊居","author":"何其伟","text":"出郭愁真破，探春意独偏。\n乾坤风物外，消息杏花前。\n野竹连荒径，娇莺掠舞筵。\n郊空呈万汇，幽兴亦悠然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14704,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄西粤李生维明茂才乃勋臣嫡裔也","author":"何其伟","text":"两粤峰峦障暮烟，问谁旌节驻南天。\n山斋已下延徐榻，江海先回访戴船。\n麟阁勋名题汉署，龙门声藉记瑶篇。\n悬知匣里生颜色，夜夜楼头向斗边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14705,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送番波罗一株谢正术纳斋诗以代柬","author":"何其伟","text":"共讶殊方产异葩，谁移仙种自天涯。\n不随薏苡归南土，也傍张骞奉使槎。\n暂割一株供笑傲，长荣五色艳窗纱。\n君家玉树芬相集，留伴庭阶亦可誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14706,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游西樵夜宿沛然堂次壁间韵","author":"何其伟","text":"萧瑟金风吹鬓丝，更阑霜冷益凄其。\n孤鸿夜逐关河度，倦客愁随鼓角悲。\n欹枕听鸡偏寂寞，披衣鸣剑独委蛇。\n开帘曙色临青嶂，立马云端自咏诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14707,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游故少师方西樵府二首 其一","author":"何其伟","text":"凌霄台榭傍山隈，并辔何因选胜来。\n绕槛烟花香腻湿，夹池风竹籁声哀。\n探幽客有携筇兴，怀古谁怜倚马才。\n一代风云今寂寂，重门空锁绿莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14708,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游故少师方西樵府二首 其二","author":"何其伟","text":"秋阴漠漠咽寒蝉，漫倚楼台落日悬。\n雄据千峰维地轴，纡盘青嶂出尘烟。\n丹心已作祥云度，宸训空馀素壁传。\n论列风裁千古在，好将勋业记瑶篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14709,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"欧念桥黄君甫过社宴集时二丈方应督学试得边字","author":"何其伟","text":"诃华推二妙，赢得过谈玄。\n世路谁风雅，才名属后先。\n晴云飞素练，翠筱动朱弦。\n迟尔新铏发，昂藏向斗边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14710,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明妃怨 其一","author":"何其伟","text":"忍听边声急暮笳，西风吹泪湿琵琶。\n非缘薄命污颜色，恨乏黄金买画家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14711,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明妃怨 其二","author":"何其伟","text":"胡骑长驱紫陌头，穹庐无复汉宫秋。\n飘零不改春风面，试问君王念我不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14712,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"边警","author":"何其伟","text":"万里边声报羽翰，朔方骚驿动长安。\n胡尘远逐关门暗，戎马频嘶铠甲寒。\n天意可无擒颉利，王灵终自斩楼兰。\n夜来烽火忧时切，蒿目中原带剑看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14713,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜期小岑叔南华弟过山房","author":"何其伟","text":"箫鼓慎春夜，香车并辔联。\n更乘村上月，还过洞中天。\n雅度推公辅，清标属惠连。\n倘逢双璧至，幽兴亦悠然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14714,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中七夕简廷伯过饮育物亭得鸣字","author":"何其伟","text":"飒飒秋声万木鸣，悲哉爽籁透虚楹。\n开尊笑逐看牛女，带雨过逢得马卿。\n十载芝兰怜意气，千秋瓜果共词盟。\n人间天上多离思，疑滴芭蕉别泪横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14715,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠赵侍儿","author":"何其伟","text":"桃花双脸带酥胸，歌得霓裳玉树高。\n更道掌中能妙舞，几回肠断五陵豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14716,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠得白桃","author":"何其伟","text":"樱桃脸自带胭脂，忽讶相逢事可疑。\n岂谓红颜披素练，却将艳质改冰肌。\n嬉春姊妹非杨柳，凝露翩翻似雪儿。\n独抱灵犀同玉洁，羞从态黛斗蛾眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14717,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜怀灵叔枉顾小酌儿辈鼓琴稚子斗鸡为乐猥承佳篇率尔奉答","author":"何其伟","text":"倒屣中郎匹马嘶，踏歌清夜更吹藜。\n风前喜奉弹嵇散，醉后欢娱斗祝鸡。\n琢句浑忘更漏转，衔杯宁觉月轮低。\n少微星聚元非客，太史封章莫浪题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14718,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日偕李少芝山人集苏文甫宅","author":"何其伟","text":"当年裘马向长安，此日相逢意气欢。\n季子风流称琬琰，龙门声价重琅玕。\n朱弦山水知音少，华发江湖胜会难。\n东阁观梅惭我拙，广陵春色至今看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14719,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日偕李少芝李少修苏仰伯子垣梁少陵集苏仲吕昆玉宅得东字","author":"何其伟","text":"西园佳公子，置酒画楼东。\n春风吹淡荡，飞盖驭青骢。\n绿杨垂芳渚，黄鸟鸣森丛。\n绮席留残照，冠佩列群公。\n玉盘馔羞错，艳曲入云中。\n多君重李善，神交意气通。\n猗余惭子季，辜尔调相同。\n彩笔华阳馆，谈天碣石宫。\n醇酎觞飞急，柳瘿亦不空。\n宾主相酬劝，鲸吞气贯虹。\n耳热起剑舞，酣歌漏未终。\n良会元非偶，载笔垂无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14720,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读李少芝当垆集有赠 其一","author":"何其伟","text":"书记相随别帝京，卜幽仙洞欲逃名。\n时人笑指临邛事，谁识前身是马卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14721,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读李少芝当垆集有赠 其二","author":"何其伟","text":"才名卿相早相闻，落魄归来犊鼻裙。\n燕市旧游多乐事，何如长伴卓文君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14722,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同罗孝廉觉我诸君登神步塔 其一","author":"何其伟","text":"旋转龙蛇到上头，山城水郭坐中收。\n金沙地涌浮真气，宝筏川横接汉流。\n隐映龟峰齐雁塔，纡回云路抱蜃楼。\n未论形胜他年事，坐挹空香万劫休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14723,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同罗孝廉觉我诸君登神步塔 其二","author":"何其伟","text":"宝塔新成据上游，故邦形胜自遭周。\n不缘长者黄金布，那得祇园绛气浮。\n乍听琅珰虚白月，偶来钟磬静丹丘。\n尘机坐久都消尽，会见天花十二楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14724,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙午岁族叔怀灵侄禹门孙宇亮邓甥世田元夕过集","author":"何其伟","text":"花月看江乐事浓，踏歌迤逦过山中。\n鱼灯海上干霄汉，凤吹楼头弄晚风。\n弹剑当歌怜皓魄，呼卢把酒问长空。\n诸豪不惮厌厌饮，遥听虾蟆响未终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14725,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜偕李亮侯孔甥尚志剧谈时事怆然有感得响字","author":"何其伟","text":"谈经倦客傲林坰，一卧山斋笑独醒。\n谩说豺狼多跋扈，共惊坼堠振韬铃。\n筹臣借箸心应切，壮士挥戈思未停。\n旅食有怀忧不细，夜阑空自拭青萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14726,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"时闻边报留别李亮侯","author":"何其伟","text":"驿路驱车雨雪分，倦游归计惜离群。\n弦中山水千秋合，匣里雌雄一夕分。\n东阁疏梅惊破腊，淮南丛桂坐舒芬。\n别来烟树生春色，莫遣飞鸿断暮云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14727,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸣鹤楼为李永明赋","author":"何其伟","text":"依稀华表柱，疑是缑山亭。\n地自龙门胜，天闻鹤唳清。\n烟生青嶂合，风飒绿芜平。\n上客栖真处，时听引吭鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14728,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将往陆川江上逢吴明府夜酌","author":"何其伟","text":"何期仙令下蓬莱，忽接藤江彩鹢催。\n望气已知云外度，探奇犹自雪中来。\n方舟客似山阴兴，对酒人如御李回。\n顿觉椰榆惊染翰，纤纤孤月共徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14729,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]