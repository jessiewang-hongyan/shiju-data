[{"title":"鹿门归兴　孟浩然","author":"郭之奇","text":"松月虚窗夜，幽人独往时。\n本无蝉冕意，且赴鹿门期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石鱼醉歌　元结","author":"郭之奇","text":"漫翁愁独醒，时向石湖秋。\n客醉知鱼乐，鱼欢为客游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日自号三士道人","author":"郭之奇","text":"观我观生莫漫陈，为名为姓岂全真。\n自从海内称三士，长愧山中少一人。\n少许驱驰思夙志，老犹崛强问馀身。\n所求心迹无他扰，何必渔樵是隐沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日立春浮云蔽日使人愁叹而问春","author":"郭之奇","text":"珠岛新烟百道屯，青阳已至莫逡巡。\n寒光入水宜销散，旅绪如云自屈伸。\n老去浮生终愧我，春来幽事强撩人。\n梅花柳色今何在，辜负东风亦此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"听读书有感","author":"郭之奇","text":"嘿识应留万古神，休将疑难强吟呻。\n羲经八卦无君子，孔论通篇四圣人。\n今古漫随时代纪，往来谁是继开身。\n此中糟粕真何用，堂上终须问斲轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中兴一旅文武遗臣欲尽制乙未闻感叹有作","author":"郭之奇","text":"七载空思鹿野芩，九天谁听鹤皋音。\n周家八士季为马，鲁国元侯伯是禽。\n几见夔龙堪再命，漫言罴虎未全任。\n何时一网收麟凤，蝣羽鹈梁莫浪歆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬辰避地马鞍山治一枝未就兹春闻儆复于前址搆栖感赋十律 其一","author":"郭之奇","text":"伐木来幽谷，诛茅获故居。\n我怀终惬旧，山意亦留初。\n海色林中隐，云光物外舒。\n生涯安可说，且复任蘧庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬辰避地马鞍山治一枝未就兹春闻儆复于前址搆栖感赋十律 其二","author":"郭之奇","text":"山色迷终古，春情自浅深。\n此中求素托，何处可真寻。\n鸟兽多无礼，林泉别有心。\n谁堪携手共，同异问苔岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬辰避地马鞍山治一枝未就兹春闻儆复于前址搆栖感赋十律 其三","author":"郭之奇","text":"旅绪终谁止，春光亦有初。\n剪芜防甲折，植援俟条舒。\n曲径微风转，西窗落照徐。\n此中容抱膝，何敢问琴书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬辰避地马鞍山治一枝未就兹春闻儆复于前址搆栖感赋十律 其四","author":"郭之奇","text":"独有霞栖客，林峦未许迷。\n寻幽同记忆，选胜自标题。\n海色衣时卷，岩烟手日携。\n颇疑空阔内，若与素心齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬辰避地马鞍山治一枝未就兹春闻儆复于前址搆栖感赋十律 其五","author":"郭之奇","text":"即事才知止，劳生久息机。\n风林时飒飒，云谷转依依。\n群跃因潮起，孤鸣俟月飞。\n春心徒目极，与物未相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬辰避地马鞍山治一枝未就兹春闻儆复于前址搆栖感赋十律 其六","author":"郭之奇","text":"竹室团幽白，荆篱漏远光。\n春林初照耀，晓岫日微茫。\n物外风云淡，山中岁月长。\n冥机时坦步，心迹两当忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬辰避地马鞍山治一枝未就兹春闻儆复于前址搆栖感赋十律 其七","author":"郭之奇","text":"林峦相隐蔽，茅屋自荒深。\n未了青春色，难伸白雪吟。\n惊翔姑一止，哀啸且为音。\n猿鸟人间物，安知物外心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬辰避地马鞍山治一枝未就兹春闻儆复于前址搆栖感赋十律 其八","author":"郭之奇","text":"微尚难矜己，虚荣独让时。\n买山聊复尔，浮海亦安之。\n止足明孤性，栖寻见夙思。\n巢居何代子，不使世人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬辰避地马鞍山治一枝未就兹春闻儆复于前址搆栖感赋十律 其九","author":"郭之奇","text":"遭人身欲退，适我物皆悠。\n岩壑澄朝景，风潮变夕流。\n高深时应接，今古日沉浮。\n耳目周旋外，馀心尚可求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬辰避地马鞍山治一枝未就兹春闻儆复于前址搆栖感赋十律 其十","author":"郭之奇","text":"世事环千虑，春容出万端。\n林泉方滴沥，风雨莫迷漫。\n独鸟依深树，群鸥就远澜。\n且同尘外物，时向静中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚眺得初月有怀二首 其一","author":"郭之奇","text":"薄暮来孤眺，春愁强独宽。\n轻云归远岫，初月动微澜。\n物象宜高广，人心亦静安。\n如何羁客绪，复自有千端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚眺得初月有怀二首 其二","author":"郭之奇","text":"翠壁双流界，苍烟一带围。\n空山犹作伴，芳草未同归。\n往日催春色，回风动落晖。\n伤心千里外，魂远莫予违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居蓬罗七绝 其一","author":"郭之奇","text":"三神山在有无中，仙岛人区那可同。\n我自耽幽思遁迹，安能逐景望璇宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居蓬罗七绝 其二","author":"郭之奇","text":"人亦有言松有林，惟予及尔是同岑。\n相携物外凌霜质，独抱山中向日心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居蓬罗七绝 其三","author":"郭之奇","text":"冥思已觉生如梦，回首方知色是空。\n一室萧然山水内，海涛随意出松风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居蓬罗七绝 其四","author":"郭之奇","text":"风潮每夜送馀音，身在高山意转深。\n颇怪松吹多别调，凄凄尽作水龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居蓬罗七绝 其五","author":"郭之奇","text":"不分松声听似海，生增草色望如涛。\n山心水意终难定，耳目当前莫漫骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居蓬罗七绝 其六","author":"郭之奇","text":"一片春山绿似醅，几多烟景白如皑。\n为谁悦己时相向，淡扫浓妆百样裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居蓬罗七绝 其七","author":"郭之奇","text":"入山惟恐未全深，为鹤为猿万古心。\n便许兹山留片石，时将真气朗云林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伤怀五绝 其一","author":"郭之奇","text":"未了馀生百自劳，伤怀一事若相遭。\n无端更作幽山侣，错认松声是海涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伤怀五绝 其二","author":"郭之奇","text":"苍松尽日舞烟风，为爱林栖息意同。\n一自秋霜凋露白，懒从春水问溪红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伤怀五绝 其三","author":"郭之奇","text":"春思秋怨总相同，一寸柔肠百断中。\n春草萋萋秋不见，教人长愧落花风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伤怀五绝 其四","author":"郭之奇","text":"朝云已去暮还归，长与山人共落晖。\n举目跚跚频立望，空中虚影是耶非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伤怀五绝 其五","author":"郭之奇","text":"半载幽思孰共怜，几番愁梦倍凄然。\n人间亦有伤怀者，未必钟情似我坚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禊日春雨初宿西月微明思从中来漫成九绝 其一","author":"郭之奇","text":"禊日休临水，春风合在山。\n山光无晓暮，为我独来还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禊日春雨初宿西月微明思从中来漫成九绝 其二","author":"郭之奇","text":"冥冥天地色，缩缩古今情。\n所遇多陈物，谁能郁化精。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禊日春雨初宿西月微明思从中来漫成九绝 其三","author":"郭之奇","text":"春与春相接，风光自发陈。\n悲时成既往，适我尽皆新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禊日春雨初宿西月微明思从中来漫成九绝 其四","author":"郭之奇","text":"玄崿流新润，烟林发旧华。\n襟颜姑一寄，涯角且为家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禊日春雨初宿西月微明思从中来漫成九绝 其五","author":"郭之奇","text":"风月同幽谷，林泉共小园。\n只宜招士隐，不足为人言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禊日春雨初宿西月微明思从中来漫成九绝 其六","author":"郭之奇","text":"山色看看翠，松风听听清。\n眼中无俗韵，谷内有禽声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禊日春雨初宿西月微明思从中来漫成九绝 其七","author":"郭之奇","text":"分风宜密岫，穿月赖疏林。\n微照同幽意，轻吹中远心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禊日春雨初宿西月微明思从中来漫成九绝 其八","author":"郭之奇","text":"西林悬细月，亦爱此松风。\n淡扫春蛾黛，含情独向东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"禊日春雨初宿西月微明思从中来漫成九绝 其九","author":"郭之奇","text":"秋魂无定止，春梦偶相持。\n梦断如花落，从风不自知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四怨三愁五情诗 其一 一怨","author":"郭之奇","text":"燕丹谋国事，田樊空自戕。\n卿匕一何短，王剑一何长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四怨三愁五情诗 其二 二怨","author":"郭之奇","text":"鸿沟不可割，乌江不可济。\n虞兮从逝骓，幸不为人彘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四怨三愁五情诗 其三 三怨","author":"郭之奇","text":"策疲驱远道，偶得憩高林。\n不解轩车至，喧阗尽此阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四怨三愁五情诗 其四 四怨","author":"郭之奇","text":"山泉自宜清，海水自宜浊。\n高深既已殊，浓淡休相学。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四怨三愁五情诗 其五 一愁","author":"郭之奇","text":"昭阳迎晓日，长信坐秋风。\n岂料诗书意，全为歌舞穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四怨三愁五情诗 其六 二愁","author":"郭之奇","text":"玉露团幽桂，黄英送绿荷。\n秋容无间歇，衰鬓独如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四怨三愁五情诗 其七 三愁","author":"郭之奇","text":"花落叹丛孤，随风莫漫徂。\n不念枝独处，当念子谁俱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四怨三愁五情诗 其八 一情","author":"郭之奇","text":"玉兔衔初景，婵娟又一时。\n西林何所妒，不肯让蛾眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四怨三愁五情诗 其九 二情","author":"郭之奇","text":"卑栖迷远谷，微影托深林。\n自顾双飞羽，常留一片心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四怨三愁五情诗 其十 三情","author":"郭之奇","text":"每怜红艳落，幸倚碧泉幽。\n萍梗非前识，相要何处流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四怨三愁五情诗 其十一 四情","author":"郭之奇","text":"陈思赋雒神，飘缈动霞津。\n当年不可并，千载孰堪邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四怨三愁五情诗 其十二 五情","author":"郭之奇","text":"渔阳耳外声，马驿怀中泪。\n肠断剑门锋，何关花鸟事。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春山八事 其一 春草","author":"郭之奇","text":"空山无可言，寻幽春已半。\n羁怀积数峰，颇受春光乱。\n离群自何日，于兹独永叹。\n所叹春与人，空山同聚散。\n山静人亦閒，聊复临高看。\n阴晴众壑分，万象殊昏旦。\n飞岚无定容，芳草弥其断。\n轻风草际飏，苍烟成一段。\n初日破迷离，浥露疑珠贯。\n青皋一带浮，绿树千条绊。\n问尔何色香，曾是古人玩。\n即此见遥心，永作春山幔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春山八事 其二 春松","author":"郭之奇","text":"春松不异冬，每见东吹簸。\n方知霜雪含，未许烟云卧。\n所志在干霄，独有高山佐。\n亭亭百尺姿，连群相友和。\n晓日翠华凝，夜月疏光破。\n群树皆遥揖，凡栖宁敢过。\n自凭夏氏食，复使齐共饿。\n百代异枯荣，千人分吊贺。\n岂不罹岁寒，于此明肩荷。\n是以甘殊谷，羞言秦五大。\n为我留青青，幸无樵采剉。\n幽人既同兹，永令清风播。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春山八事 其三 春鸟","author":"郭之奇","text":"鸟性悦山光，山光亦同鸟。\n氤氲交万物，气类何纷扰。\n其中惟羽族，所向宜缥缈。\n岂不均异姿，清浊殊昏暸。\n浊者撄世尘，清者怀孤矫。\n鸿冥必渐磐，鹏怒方垂表。\n缅彼逍遥游，一往谁能了。\n山经所未及，舍大姑徵小。\n嘤嘤出自幽，燕燕飞于杳。\n嗟兹二物微，天涯共夕晓。\n乘时作好音，独与春山绕。\n山鸟日欣欣，君子毋心悄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春山八事 其四 春云","author":"郭之奇","text":"幽人卧空山，起视山已绿。\n春云自东来，所向无拘束。\n林峦坠其中，安知空与曲。\n朝弥万谷皴，夜补千岩瘃。\n大哉天地容，四海互瞻瞩。\n雷雨之所屯，日月之所浴。\n悠悠出岫情，遂满群生欲。\n岂为神女行，肯受襄王辱。\n嗟彼荒淫者，千年徒蹢躅。\n是以君子心，永言肤寸触。\n愿同春作霖，每念秋如玉。\n予曰上天需，谁当山下告。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春山八事 其五 春泉","author":"郭之奇","text":"春泉吐窈岑，夜雨通遥壑。\n每同石势浮，时见山光落。\n林影拂参差，苔痕留淡薄。\n迷茫涨海中，谁挥神斧凿。\n已开山下蒙，耐可幽人酌。\n繇不愿甘肥，是以供藜藿。\n地阻情自偏，聊从静者乐。\n自获洗心徒，安知牛口怍。\n馀滋动草芽，远润明花萼。\n本源清若此，方思此一勺。\n涓涓及江河，将拟百川学。\n谓予言不信，君其问海若。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春山八事 其六 春月","author":"郭之奇","text":"春色淡疏烟，夜月涵深静。\n山居无一事，缓步苍松岭。\n所思不可见，所见徒耿耿。\n谁开大海容，忽吐高峰景。\n已得惠风吹，岂受繁霜儆。\n疏林漏其辉，复上幽人领。\n幽人意若何，独向飞轮请。\n夜光尔何德，死育须臾顷。\n可怜人异月，一去难追省。\n每当春月和，长恨秋月冷。\n安知长恨人，不是婵娟影。\n方春抱玉华，流照归人境。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春山八事 其七 春风","author":"郭之奇","text":"羁绪日摇摇，百年徒鼎鼎。\n浮生不足言，大梦真难醒。\n惜往漫抽思，悲回孰共謦。\n秋兰既已摧，寒松嗟独挺。\n岂谓冬复春，春风自东迥。\n春来人不知，深忧如宿酩。\n转眼及春三，有律名姑洗。\n乍闻萍始生，所畏虹初炯。\n每旦视牵牛，谁酌天河泂。\n尽洗郁萌中，一向愁波拯。\n春风忽去来，我意终平等。\n持此问春风，春风或首肯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春山八事 其八 春雨","author":"郭之奇","text":"天地久和同，阳光多豫暇。\n熙熙万汇怀，慕德从春借。\n谁司大皞权，俄睹苍龙驾。\n生气发句萌，水木互奔泻。\n是时我山栖，昏旦依郊舍。\n悠悠日月居，半倚云雷架。\n未能分浅深，且欲观高下。\n闭户养幽清，倚棂望桑柘。\n时同草木心，日向春荣谢。\n嗟兹大块情，不以遐方罢。\n流润细无声，随风潜入夜。\n重绎杜陵诗，乃知时雨化。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春梦","author":"郭之奇","text":"囊中留一钱，欲就春宵买。\n无心堪化蝴，识字何须豸。\n从兹愿息机，嘿念同冰解。\n屈指数时光，二跳徒相骇。\n人间花尽落，天上春犹挂。\n安知梦里游，容易天阶躧。\n倚阊孰望予，玉屑时飞洒。\n已乞神君言，将携太乙柺。\n云根未获窥，月窟终当揩。\n回看尘世中，观场人尽矮。\n齐州九点烟，万国双流澥。\n忽见此波涛，梦断东风摆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得芳草无行径","author":"郭之奇","text":"山川馀阻僻，宇宙一荒园。\n遂有迷离色，能铺近远痕。\n兔丝悬碧照，虫网飏黄昏。\n不向穷途返，安知屐齿存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得空山正落花","author":"郭之奇","text":"尝疑春梦短，时令晓魂微。\n初日开林影，回风动客衣。\n正怜红艳落，愁见绿芳肥。\n何事幽峰曲，能留一片飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得虚牖风惊梦","author":"郭之奇","text":"竹室摇清影，松吹动窈岑。\n祇同春寂寞，能使夜凄深。\n久恨成终古，长愁折寸心。\n宁关空谷响，却令远魂沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得空床月厌人","author":"郭之奇","text":"永夜虚长枕，孤衾下短帷。\n已愁灯久对，那许月相窥。\n念昔惊同梦，于今照独思。\n自甘形抱影，不用素娥嗤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"烟色翠痕","author":"郭之奇","text":"惜吾不及古，谁与共蘅荪。\n虚泛循烟色，淹留舍翠痕。\n祇愁春欲暮，复使旦为昏。\n缓步从樵子，归来独掩门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸟啼花落","author":"郭之奇","text":"山静岩烟隮，春遥树影深。\n樵风闻黝黑，微路出幽森。\n自结羁人恨，偏惊物候沉。\n鸟啼应有意，花落岂无心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":36095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]