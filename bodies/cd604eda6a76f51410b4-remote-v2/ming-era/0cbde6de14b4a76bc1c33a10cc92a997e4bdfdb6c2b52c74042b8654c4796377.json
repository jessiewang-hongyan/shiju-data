[{"title":"和友人春游六首 其二","author":"卢龙云","text":"万树烟深雨正丝，春阳育物已多时。\n半黄乍变柔条柳，更倩东风向晓吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和友人春游六首 其三","author":"卢龙云","text":"林木欣欣总向荣，几人结伴探春行。\n未论百卉争红紫，一夜池塘草复生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和友人春游六首 其四","author":"卢龙云","text":"芳菲节物美遨游，细叶轻花拥翠楼。\n乐事林园应已足，何须春色在皇州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和友人春游六首 其五","author":"卢龙云","text":"晴日春晖满洞门，名花历乱野花繁。\n游人入夜浑忘倦，秉烛还来倒绿尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和友人春游六首 其六","author":"卢龙云","text":"娇歌清管下楼台，灯火荧煌漏莫催。\n最喜春宵寒已薄，可能金钥彻明开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱学博以心学图见寄赋谢","author":"卢龙云","text":"家学渊源接紫阳，按图终日味偏长。\n已知室暗能虚白，更与诸生事勿忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马仲高纳姬于冈州载归寿母为赋二首 其一","author":"卢龙云","text":"堂前萱草号忘忧，况有佳人字莫愁。\n归去小星閒赋咏，婺光长映碧云头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马仲高纳姬于冈州载归寿母为赋二首 其二","author":"卢龙云","text":"大妇中厨事事精，新来小妇但吹笙。\n今夕多应降王母，侍儿先见董双成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北上赴谪次浈阳四首 其一","author":"卢龙云","text":"满天风雨客程劳，鬓有新霜欲二毛。\n往事不须重记忆，寒流东下水滔滔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北上赴谪次浈阳四首 其二","author":"卢龙云","text":"南北风尘道路赊，何时驱马到长沙。\n眼前世事应难定，望里云山总一家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北上赴谪次浈阳四首 其三","author":"卢龙云","text":"莫以长途叹路难，敝裘犹耐雪霜寒。\n飞扬未限晨风翼，可为枋榆惜羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北上赴谪次浈阳四首 其四","author":"卢龙云","text":"抱瓮频年学汉阴，重来宁暇卜升沉。\n山中远志应还在，谁识江湖此日心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芙蓉驿换舟二首 其一","author":"卢龙云","text":"碧山千叠削芙蓉，山下寒江旦暮通