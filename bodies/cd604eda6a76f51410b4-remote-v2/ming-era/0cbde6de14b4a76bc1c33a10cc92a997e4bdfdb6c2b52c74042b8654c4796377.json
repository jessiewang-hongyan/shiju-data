lection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日江楼眺望二首 其二","author":"卢龙云","text":"翩翩鸥鹭满前湾，面面波光映客颜。\n试看龙沙今日酒，风流无亦似龙山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题孤松挺翠","author":"卢龙云","text":"虬鳞鹤盖拥飞芝，相附由来有兔丝。\n共历岁寒苍不改，岂于桃李竞春姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过彭泽","author":"卢龙云","text":"一片孤城傍水涯，风涛日日涌江沙。\n折腰此地荒松菊，不为督邮也念家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大风","author":"卢龙云","text":"维舟暮泊楚江皋，入夜天风转怒号。\n多少波涛曾历遍，不须重惮客程劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题小景","author":"卢龙云","text":"乔木阴森境最幽，扶筇因暇看岩丘。\n老僧更道心如水，堪共携琴作漫游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画鸟","author":"卢龙云","text":"卑栖何事未乔迁，却道飞鸣两寂然。\n自是相求声始切，乘风振翮总凌天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画马","author":"卢龙云","text":"暂释羁衔性最宜，谁从垌牧识纤离。\n兰筋养就追风力，不负驱驰报所知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莫愁湖二首 其一","author":"卢龙云","text":"美人当日属吾家，歌管楼台乐岁华。\n此地何缘誇托胜，空馀水木媚烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莫愁湖二首 其二","author":"卢龙云","text":"一片湖光傍石城，却因佳丽与留名。\n当时歌舞人何在，渚鸟汀花独有情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题方朔蟠桃图二首 其一","author":"卢龙云","text":"翩翩笙鹤下瑶池，太一坛前侍宴时。\n自诧蟠桃经几熟，不妨分惠与邻儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题方朔蟠桃图二首 其二","author":"卢龙云","text":"岁岁金门号陆沉，何如寄傲得云林。\n碧桃种处从花实，翻笑东方别有心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五云驿赠李医士","author":"卢龙云","text":"南客扁舟度五云，却缘芝术得相闻。\n千年柱下留真诀，紫气关头即是君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠施茶僧真山二首有引 其一","author":"卢龙云","text":"清风习习语兰奢，解渴功曾及万家。\n香积施馀无一事，夜看萝月昼松霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠施茶僧真山二首有引 其二","author":"卢龙云","text":"文武声华并起予，翩翩丽藻照茅居。\n不缘净土能持法，那得丛林见异书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题会仙图","author":"卢龙云","text":"蟠桃几树正花开，花下何人独坐来。\n引得群仙将鹤舞，频频争道进霞杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"懒石二首 其一","author":"卢龙云","text":"丰草长眠境独幽，无营终日傍林丘。\n任教说法通神理，不为生公强点头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"懒石二首 其二","author":"卢龙云","text":"触云隐雾尽无心，一径蓬蒿但自深。\n纵有神人驱不得，奇章何用此中寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恒心堂为周医题","author":"卢龙云","text":"活世功多未易能，真心一点自堪凭。\n何须在处求仁术，圣训昭昭但有恒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题道人隐居图","author":"卢龙云","text":"深谷松云护结庐，万山回合径盘纡。\n道人已悟青牛诀，别有玄亭自著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题壶山诸景十首有引 其一 沙堤横玉","author":"卢龙云","text":"长堤如带玉为堆，不减昆丘石洞开。\n似为明时徵海晏，川原随处效珍来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题壶山诸景十首有引 其二 壶井流琼","author":"卢龙云","text":"澄潭山下一壶悬，须信壶中别有天。\n潮退真源清自见，堪将仙液拟流泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题壶山诸景十首有引 其三 鳌峰驾海","author":"卢龙云","text":"奇峰巀嶪驾洪涛，何必三山并戴鳌。\n海若固应怜负重，化来此地转孤高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题壶山诸景十首有引 其四 笏石当潮","author":"卢龙云","text":"岧峣异石出岩头，一派潮声向此收。\n疑是山灵因望海，独能端笏礼阳侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题壶山诸景十首有引 其五 悬厓耸壑","author":"卢龙云","text":"崇岩百丈俯芳洲，壁立当霄据上游。\n一任浮云自来往，巍巍巨镇古今留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题壶山诸景十首有引 其六 洽水环襟","author":"卢龙云","text":"百道山泉出峡来，汪洋赴壑尚萦回。\n已知学海终能至，须识灵源向此开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题壶山诸景十首有引 其七 草堂浥露","author":"卢龙云","text":"草色苍苍海雾盈，污邪何日始堪耕。\n沧桑莫说功难就，已藉居人力渐成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题壶山诸景十首有引 其八 莲阜凝烟","author":"卢龙云","text":"群峰叠叠起青莲，朝暮溟濛泛瑞烟。\n岂是孤根沾广润，芳标时映海中天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题壶山诸景十首有引 其九 仙槎汎月","author":"卢龙云","text":"何处浮来海上槎，寻源此地若为家。\n常邀夜月沧波外，大有辉光照荻花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题壶山诸景十首有引 其十 石鼓惊天","author":"卢龙云","text":"广乐何年到海隈，犹馀鼓迹蚀苍苔。\n波恬已幸梯航远，不遣扬桴此日来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观迎春四首 其一","author":"卢龙云","text":"翩翩队舞鼓如雷，共喜春从此日来。\n试看东皇司令始，条风吹雨净纤埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观迎春四首 其二","author":"卢龙云","text":"东郊淑气接长干，帝里春还万户欢。\n几向寒梅问消息，今朝得与众同看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观迎春四首 其三","author":"卢龙云","text":"春到江南觉独先，蓂开三叶景初妍。\n阳和散作人间乐，社酒新丰美十千。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观迎春四首 其四","author":"卢龙云","text":"登楼入望见春明，处处池塘草欲生。\n花胜分来笔共彩，辛盘更侑羽觞行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为周韬之题画","author":"卢龙云","text":"板桥藜杖出江村，水榭云轩接寺门。\n风起绿蘋堪送远，飞帆天外带晴暄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题群芳图","author":"卢龙云","text":"百卉芬芳各有时，寒梅遇腊转多姿。\n和羹预待林中实，一种天香分外奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺","author":"曾仕鉴","text":"千峰中断一江遥，古寺丹梯跨泬寥。\n急峡雷霆喧白昼，上方钟磬入青霄。\n崖悬翠色轩中落，竹引泉声石上飘。\n金锁玉环俱莫问，兴深萝薜坐翛翛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门吊古","author":"曾仕鉴","text":"白鹇已没黄龙去，百二山河只夕晖。\n东海有波填帝女，苍梧无路怨湘妃。\n厓前古木传金柝，海底鲸鲵护宝衣。\n惟有哀歌亭上月，夜深犹伴旅魂飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古 其一","author":"曾仕鉴","text":"草市行宫古木阴，闽杭回首一沾襟。\n双龙北去金瓯缺，六马南来玉玺沉。\n尝胆未消干隧愤，攀髯无限鼎湖心。\n凄凉莫问祥兴事，禾黍离离江水深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古 其二","author":"曾仕鉴","text":"频年航海计难成，一旅扶天势易倾。\n双匣久无冬树骨，六更长罢夜钟声。\n月冲南斗铜驼冷，星陨东溟铁锁轻。\n不独金牌堪洒泪，汴京全盛杜鹃鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古 其三","author":"曾仕鉴","text":"楼船载国沈沧海，厓树空栖万古魂。\n驻跸有山仍碧草，藏舟无壑自黄昏。\n酸风似咽田横恨，幽鸟如鸣杵臼冤。\n欲向客庐问兴废，只今燕冀是中原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿黄龙洞偕卢唐宪","author":"曾仕鉴","text":"石室春同入，龙宫夜不眠。\n青天双瀑下，明月二楼悬。\n羽盖悲陈迹，金书忆晋年。\n何如绮与角，长赋采芝篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同卢唐宪入罗浮","author":"曾仕鉴","text":"去年勾漏过寒食，今日罗浮亦暮春。\n满地松苓何岁月，诸天宫阙自金银。\n丹砂草碧迷仙令，符竹烟深失羽人。\n惟有豫章祠下月，清光长照水粼粼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元冈晚眺","author":"曾仕鉴","text":"秀压群峦瞰碧空，一方云树画图中。\n南临雁岭烟光紫，北引龙溪灏气融。\n历井仰窥天阙近，望河回见海门通。\n蓬莱缥缈无多路，目断浮云兴未穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"合江楼怀苏文忠","author":"曾仕鉴","text":"千山楼外两江斜，地是端明学士家。\n白鹤不归城郭在，东新桥下水如花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜游永福寺","author":"曾仕鉴","text":"酒尽寻僧寺，孤舟系月明。\n入门鸂鵣散，坐石薜萝清。\n大静湖如练，云移树有声。\n空山人不见，来往伴飞萤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访化甫石洞十四韵","author":"曾仕鉴","text":"洞夹朱明胜，峰环玉女深。\n晴窗含岫色，夏木舞溪阴。\n羽观邻曾卜，仙踪杳杳寻。\n一官轻脱屐，四海重投簪。\n往事过棋局，浮生叹陆沈。\n鹤巢依密树，鹿性恋丰林。\n老称逃名隐，闲消出世心。\n眠高忘昼永，虑淡却尘侵。\n尔素甘云卧，吾来有足音。\n烹葵分涧溜，洗耳听龙吟。\n藓蚀云中屐，松赓石上琴。\n江山容偃蹇，天地几登临。\n鬓短书犹著，歌长酒并斟。\n昔闻回俗驾，今见涤烦襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花村二绝 其一","author":"曾仕鉴","text":"云碓激泉春，仙犬隔花吠。\n采药独行深，天地非人世。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花村二绝 其二","author":"曾仕鉴","text":"空山雪色深，凉月梅梢动。\n啁啾翠羽声，忽断游仙梦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青霞洞","author":"曾仕鉴","text":"古洞即仙居，飞楼却太虚。\n身疑梦蝶后，人亦祝鸡馀。\n树杪悬风磴，蒲根溜石渠。\n往来幽兴熟，何处不吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀赵太史 其一","author":"曾仕鉴","text":"长夜愁不寐，起视青天浮。\n促织吟四壁，春草忽已秋。\n美人怅迟暮，欲济无方舟。\n伤彼畹中兰，采之寄何由。\n不及松与萝，缠绵永山丘。\n安得即六翮，比翼写我忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀赵太史 其二","author":"曾仕鉴","text":"偃仰衡门下，怅焉陟高岑。\n采秀遗所思，日暮江流深。\n忆昔春华媚，醉我嘉树林。\n在贵岂忘贱，片言失南金。\n如何诧霄壤，杂思伤滞淫。\n不见钟子期，依谁拟赏音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祁四衍曾之燕书来约别伏枕赠之 其一","author":"曾仕鉴","text":"何来双鲤鱼，中有故人书。\n一字一叹息，逝将辞旧墟。\n北上黄金台，出入承明庐。\n冠盖满衢路，念我行不俱。\n岂曰川无梁，伏枕天一隅。\n故乡日以远，音问日以疏。\n行行各努力，万里犹相于。\n无为临路啼，儿女同欷歔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祁四衍曾之燕书来约别伏枕赠之 其二","author":"曾仕鉴","text":"念子远行迈，采采芳洲杜。\n长路多虎狼，白日忽已暮。\n怅彼行者遥，不惜居者苦。\n与子连枝鸟，分飞在中路。\n子去将谁因，新知不如故。\n在远贱易忘，良无金石固。\n子其爱景光，高堂有慈母。\n中情苟不移，岁寒共贞素。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]