[{"title":"谢李黄门见招不赴","author":"苏仲","text":"忽闻天上故人呼，颠倒衣裳遣子扶。\n争奈烟津缺舟楫，不胜云水涨江湖。\n春风胜赏花千朵，深院生香酒百壶。\n宾主贤豪如此会，野人无分笑区区。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"道中忆钟美彰因寄以诗","author":"苏仲","text":"流落相随二十秋，宦途分散各悠悠。\n君持教铎鸣兴国，我忝催科老岳州。\n诗酒逢春怀往事，梦魂清夜感同游。\n诸郎已振抟风翼，南海扁舟共我不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"老梅二首 其一","author":"苏仲","text":"铁干乾坤品最奇，不分南北总相宜。\n常支老大癯仙骨，抹却纤毫艳女姿。\n林薄幽幽清不减，风霜凛凛节难移。\n暗香疏影黄昏外，浪说孤山独有诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"老梅二首 其二","author":"苏仲","text":"凭君著眼看南枝，此是乾坤造化机。\n冰骨自从逢雪月，玉龙飞出上阶墀。\n诗成湖外真堪赏，梦幻罗浮亦可疑。\n评品未公黄太史，山矾安敢并驱驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"锁试院中奉和曹公韵","author":"苏仲","text":"大会衣冠入选闱，夹山烟霭送寒霏。\n人间士类如云集，天上文星逼斗辉。\n世有真龙能识别，谁衔燕石敢为非。\n诸公藻鉴真如许，夺得佳人锦绣机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"院中赏中秋遇雨复步前韵","author":"苏仲","text":"四面□山瘦锁闱，片云拖雨乱交霏。\n深杯敢负今秋兴，皓魄何辜此夕辉。\n痴拙我知□我老，狂醉狂是更谁非。\n眼中磊落文章士，笑杀人间斗巧机。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈方伯试院中有作二首 其一","author":"苏仲","text":"天人眉宇自堂堂，百世文章百世香。\n求马本能忘牝牡，遗珠休更问沧茫。\n请看天上风云会，敢道人间傀儡场。\n他日更逢云五色，莫将温饱待湖湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈方伯试院中有作二首 其二","author":"苏仲","text":"棘闱深锁隔红尘，人对秋灯阅卷频。\n汗漫才华经只眼，品题声价倍千钧。\n太阿出匣光难掩，燕石堪谁假作真。\n方岳老臣山斗重，低头谁不拜冠绅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登黄鹤楼","author":"苏仲","text":"偶寻仙迹共遨游，黄鹤仙郎去几秋。\n山拥楼台空寂寞，天开人物几沈浮。\n汉阳胜概横当面，荆岳鸿图据上流。\n长笛一声何处起，片云飞度荻花洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟次石头口忆家偶作","author":"苏仲","text":"劳劳京国久相羁，浪逐湖湘又几时。\n松菊径荒情未了，乡关天远梦归迟。\n牛贪水草心偏爱，鸟入烟萝事可知。\n独倚孤篷吟不断，天边新月上高陴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"边太守张筵厚款诗以代谢","author":"苏仲","text":"高堂三日起炉薰，华宴初开列缙绅。\n天使从容忘势分，主人情意解慇勤。\n茶烹古鼎团龙焙，酒饮云安曲米春。\n今夜为君还拚醉，明朝烟雨出江津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽张潜轩先生","author":"苏仲","text":"人间勇退为公誇，湖海多年管物华。\n钓艇不来虚夜月，白鸥无复睡春沙。\n空遗世上潜轩稿，剩有篱傍晚节花。\n万事了中还不了，尚留清誉照人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得乡人邓世珍讣音","author":"苏仲","text":"儒官家远死堪哀，万里天涯榇未回。\n乡里我嗟囊橐薄，故人谁遣麦舟来。\n灵前有子供香火，路上何人奠酒杯。\n五岭倚云天一角，为君挥泪洒荆台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公馆夜坐","author":"苏仲","text":"何处楼头鼓角声，夜阑无语坐中庭。\n长空月朗一声鹤，腐草城荒几点萤。\n帘捲落花空自惜，行藏栖鸟不须惊。\n家童百计供茶椀，小慧能知老子情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予有天津之行同僚耿副郎辈郊饶赋此以谢之","author":"苏仲","text":"祖帐香飘酒兴浓，小桃无数压枝红。\n莺声夹道诸公远，马背飞尘我自东。\n西岭半衔将落日，暮云飞散捲长风。\n沧江白浪明朝路，回首相思独倚篷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚泊新涌口","author":"苏仲","text":"一棹遥遥更欲西，拽船人倦鸟将归。\n云迷洞口人家远，水落崖高日月低。\n浪势撼舟乡梦短，角声悲月客情悽。\n劳劳问我成何事，草长丘园没马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈公晦张信夫来顾失迓诗以谢之","author":"苏仲","text":"草屋柴门夜不扃，青山终日望高軿。\n先声信有程夫子，后世真无董五经。\n浊酒不陪花下饮，孤桡空向浪中鸣。\n相逢世事长如此，回首东风恨未平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘲蚊","author":"苏仲","text":"生长污渠野水滨，转侵人境漫缤纷。\n劳劳用尽如针嘴，扰扰无过半粟身。\n闷杀终宵挥扇客，何辜千载露筋人。\n纵饶饱吮腥腥血，万死西风有几旬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘲鼠","author":"苏仲","text":"穴居野处得安身，齧草茹蔬度岁晨。\n自把窝巢依冢土，却来城市扰吾民。\n潜形灭迹过青昼，造衅呈妖俟半昏。\n遗孽万端天有眼，未逢当日畜猫人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题春城别意卷送梁献甫还乡","author":"苏仲","text":"出门回盻意弥迟，伯氏承欢只片时。\n一面风光随马去，曲江春色浴凫知。\n莺和别调如相问，燕送新声似有期。\n临去鹏程应万里，早传春信慰人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟次临湘复步边太守韵","author":"苏仲","text":"白浪湘江推白沙，舟中人老不忘家。\n偶看倦鸟怀乡土，每对秋山数岁华。\n二女庙前僧作寺，三闾冢上客锄瓜。\n高风千古人如在，愁向荒城起暮笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赈饥于临湘途中怆然有感","author":"苏仲","text":"匹马行行路几千，许多人户断炊烟。\n凄凉旧宅成荒士，零落残生敢诉天。\n济世极知无妙策，救荒其奈缺官钱。\n欲将一本饥民籍，泣向君王上彩笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日寓临湘有感","author":"苏仲","text":"东风吹上碧桃花，春思无穷日影斜。\n老大他乡怜病客，寂寥无酒负诗家。\n坐看夜半留残烛，度过时光唤煮茶。\n自愧菲才耽禄久，天涯流落敢咨嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中大雪","author":"苏仲","text":"朔风吹急万牛呼，浪打船头雪涨湖。\n客子酷怜无酒价，行人争得有茶炉。\n江山点缀银铺彩，天地分明玉作图。\n引望江南与江北，老梅谁遗一枝无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓华容连日阴雨写怀","author":"苏仲","text":"客舍萧条乱草侵，夹旬风雨昼常阴。\n青蛙绕屋声如阵，白鸟侵人嘴似针。\n老眼不堪劳案牖，薄才无计转伸吟。\n自知久矣妨贤路，一意怀归恋旧林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游石门","author":"苏仲","text":"隐然城郭一门通，矻立奔流万派中。\n携酒我来寻古迹，拽船人叫上滩风。\n缘崖草木韶光媚，对面峰峦气势雄。\n莫笑白头贪玩赏，白头清兴不胜浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游九曲池","author":"苏仲","text":"远道迢迢拂袖风，崎岖萝径石桥通。\n两岩流水环孤岛，一个凉亭坐五翁。\n古寺半遮苍树底，远山高竦白云中。\n人生但得闲游走，要亦风流一世雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋后采菊","author":"苏仲","text":"折得黄花觅酒卮，老贪花酒又贪诗。\n霜寒古径留佳色，秋过残香恋故枝。\n爱酒客归无旧主，餐英人去少相知。\n悠悠隐逸千年趣，笑我相看日已迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芍药花","author":"苏仲","text":"艳色浓香两得之，春风富贵占依稀。\n前生想是佳人魄，出世还为倾国姿。\n对面风流焚子素，向人妆点小虞姬。\n仙葩只好仙郎看，贫病衰翁著眼迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿吕钓叟","author":"苏仲","text":"鹤形龟背吕仙翁，八十年华世罕逢。\n至道宅中诸老会，青城山里几人同。\n群仙献笑蟠桃熟，南极流光酒盏红。\n祝寿仙中人起舞，歌声长引欲摩空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题贞筠晚翠卷","author":"苏仲","text":"几度西风昼掩门，独持清节守空贫。\n漫怜薄分痴儿小，敢负残生阿舅恩。\n谁把贞筠看晚景，自经凝雪见孤根。\n淩寒卓战风流表，不入人间众卉群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答爱菊花","author":"苏仲","text":"隐逸之花归隐人，高标幽致自天真。\n严霜冷月见晚节，素香佳色淩清晨。\n诗酒门墙堪托迹，王侯池馆岂容身。\n春风笑杀千红紫，都向园林学媚人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六十一自贺","author":"苏仲","text":"借得闲山剩水眠，日逢初度酒开筵。\n三门女婿歌眉寿，四个儿郎祝老天。\n世上无功空白首，时逢有道引长年。\n无官无累无荣辱，看到春花日几千。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自寿为李国瞻题","author":"苏仲","text":"或者山中有道流，年周甲子尚休休。\n时逢盛世看青鬓，眼见诸孙未白头。\n柱杖客归花底月，拜天人愿海添筹。\n从今不管尘嚣事，烂漫看花几度秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄从弟叔诚","author":"苏仲","text":"得失功名非易计，纷纭世故总难知。\n心能顺道何须问，行不愧天胡可疑。\n笑把菊花酬晚景，休疑桃李占春曦。\n满天风月闲开眼，长入醉乡无是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访表弟梁应和留饮代谢二首 其一","author":"苏仲","text":"门外溪流泛落花，水香风送客浮槎。\n主人意好诗情远，老子心欢酒量加。\n连日世情言不了，满天风月兴无涯。\n秋光更有传芳意，一炷炉香一煮茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访表弟梁应和留饮代谢二首 其二","author":"苏仲","text":"阴阴乔木访仙家，正值南薰散晚霞。\n学语低飞梁上燕，嫩红初发槛中花。\n松根扫石棋声落，山客迎风酒味嘉。\n容我二人尘世外，共敲诗句作生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和顾工部送成孔二进士回京","author":"苏仲","text":"祖筵香篆紫烟飞，婉转歌童捧玉卮。\n艳曲本传留客意，馀音争与白云期。\n春风秋月儒林雅，紫电清霜制阃仪。\n冠盖两行南北骑，明年还共拜龙墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺刘克柔正郎严慈俱七十有五以人生七十古来稀为韵七首 其一","author":"苏仲","text":"椿灵彭翁气象，萱秀王母精神。\n正喜天开寿域，端为世外稀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺刘克柔正郎严慈俱七十有五以人生七十古来稀为韵七首 其二","author":"苏仲","text":"高享朱门富寿，荣封紫诰家声。\n贤郎举觞称庆，祷祝不老长生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺刘克柔正郎严慈俱七十有五以人生七十古来稀为韵七首 其三","author":"苏仲","text":"绿醅泼尽千钟，灵药烧残数粒。\n直侪洞府诸真，遐算曷云六七。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺刘克柔正郎严慈俱七十有五以人生七十古来稀为韵七首 其四","author":"苏仲","text":"动地歌童欢呼，腾空仙俦贺集。\n苍松老柏参天，借问冰霜几十。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺刘克柔正郎严慈俱七十有五以人生七十古来稀为韵七首 其五","author":"苏仲","text":"神龟伴坐开筵，黄鹤飞临下土。\n偕老快活平生，康强独高千古。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺刘克柔正郎严慈俱七十有五以人生七十古来稀为韵七首 其六","author":"苏仲","text":"霞佩乌纱并寿，庞眉皓发齐谐。\n恁是出人地步，都从教子中来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺刘克柔正郎严慈俱七十有五以人生七十古来稀为韵七首 其七","author":"苏仲","text":"世上双亲双老，人间佳妇佳儿。\n画堂春风豪迈，眼底断然真稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驾游环碧演新乘马应制 其一","author":"方献夫","text":"御林初夏晴明日，天子乘龙喜色多。\n共讶飞云擎白玉，浑看匹练下银河。\n同游环碧臣何幸，赐对重华语更和。\n应制惭无天马赋，南薰惟诵舜廷歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驾游环碧演新乘马应制 其二","author":"方献夫","text":"九重飞盖驾祥龙，仙仗如云出帝宫。\n金勒雕鞍当午丽，草茵花障倍春融。\n銮舆已许词臣从，玉食仍教御馔供。\n锡服承恩更稽首，庸愚何以答重瞳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又古乐府二章 其一","author":"方献夫","text":"白马黄金勒，霓旌天上来。\n君王政机暇，游衍薰风台。\n长堤柳亸金鞭回，锦宫花簇琼筵开，侍臣快睹纷徘徊。\n纷徘徊，捧寿杯。\n仰瞻神武姿，驾驭多良才。\n需云一曲升平乐，八方顺轨无纤埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又古乐府二章 其二","author":"方献夫","text":"圣王临兆民，凛如朽索驭。\n六马昔贤忠爱深，峻坂不敢驰驱下。\n安不忘危古所嘉，敬恭一念思无邪。\n周瑶池，汉渥洼，唐舞倾杯貌玉花。\n吾皇一洗千年陋，皇途帝轨同驰骤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又恭和圣制古风一章","author":"方献夫","text":"渥洼之种非寰中，乘云来自瑶池宫。\n天闱十二推长雄，七骏承恩新赐名，金鞍玉勒相峥嵘。\n日暇銮舆降环碧，同观演步惭予弼。\n委缨伏御兮安不惊，始知在德兮不在力。\n重华深处复传宣，天语相期过契弃。\n赞襄愚陋匪所能，鞭驽报主徒有心。\n君臣自古贵一德，敢忘汤盘日日新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又恭和圣制近体一首","author":"方献夫","text":"高拱无忘六辔驹，翩翩云锦出宸居。\n骄嘶喜受君王箠，仰秣时听舜禹谟。\n神相固知离牝牡，庸才何幸傍乘舆。\n禁林日永薰风足，咫尺天颜久未违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢赐飞鱼服","author":"方献夫","text":"千古豳风颂衮衣，鱼袍何幸及臣微。\n深惭赵子身胜服，徒羡张丞梦着绯。\n圣典庸功严在笥，老年图报正知非。\n寸心自许同春草，俯仰时时恋德辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭和圣制夏日与辅臣同游 其一","author":"方献夫","text":"太液流光，水阔源长。\n万年社稷赖明良。\n稽首我皇，致治成康。\n载稽首慈圣，安祝皇嗣炽而昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭和圣制夏日与辅臣同游 其二","author":"方献夫","text":"传宣西指御林中，清馥余温挹帝冲。\n何幸忧农降清问，一歌云汉泻愚悰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭和圣制夏日与辅臣同游 其三","author":"方献夫","text":"雄搆因无逸，豳风曲未终。\n圣皇稽古意，直欲继神农。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪圣恩春日同游并颁赐殊品 其一","author":"方献夫","text":"谫陋深承主眷优，一旬两度赐同游。\n金亭宝殿从观眺，又降宸间许倡酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪圣恩春日同游并颁赐殊品 其二","author":"方献夫","text":"云间缥缈望鸾旌，太液池边迤逦行。\n宝月传宣先赐见，光荣应已胜登瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪圣恩春日同游并颁赐殊品 其三","author":"方献夫","text":"促步追趋度锦芳，殿名清馥御炉香。\n重承左室温纶下，满袖薰风带宠光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪圣恩春日同游并颁赐殊品 其四","author":"方献夫","text":"仙茗分来御椀携，内庖珍馔共甘肥。\n缥囊彩扇连翩至，仰见皇心欲解衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪圣恩春日同游并颁赐殊品 其五","author":"方献夫","text":"小憩迥廊逼翠华，皇风忽尔散天葩。\n赓歌未足成羞涩，已赐仙花压帽斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪圣恩春日同游并颁赐殊品 其六","author":"方献夫","text":"献诗重上翠芬亭，拂拂花香袭御屏。\n更喜绕栏观芍药，始知仙境在皇扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪圣恩春日同游并颁赐殊品 其七","author":"方献夫","text":"金碧辉辉映玉台，百花丛里五云堆。\n感恩稽首臣何祝，愿捧年年万寿杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪圣恩春日同游并颁赐殊品 其八","author":"方献夫","text":"瞻对从容晷屡移，晚阴松径出迟迟。\n归来便向妻孥羡，千载儒生际遇时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭和圣制秋日书怀 其一","author":"方献夫","text":"御苑亲耕喜有秋，闾阎犹系花农忧。\n深惭变理臣无补，祇觉霜添两鬓愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭和圣制秋日书怀 其二","author":"方献夫","text":"传闻边将谨防秋，宵旰何劳圣主忧。\n早晚西征罢归士，衔枚无复室家愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]