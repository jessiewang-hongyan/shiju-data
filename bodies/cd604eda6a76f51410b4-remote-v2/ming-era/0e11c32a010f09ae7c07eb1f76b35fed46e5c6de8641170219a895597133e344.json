ovenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30971,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"袅袅旌?夹日来天南风净彩云开燕人马上过京洛问是谁家铜雀台 其一","author":"黄廷用","text":"九霄日月耀宸斿，万国舟车拥冕旒。\n南望湖湘云树绿，君王不是爱春游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30972,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"袅袅旌?夹日来天南风净彩云开燕人马上过京洛问是谁家铜雀台 其二","author":"黄廷用","text":"前驱都护度关津，宛洛春原官舍新。\n郡邑分门供廪饷，黄昏马上点行频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30973,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"袅袅旌?夹日来天南风净彩云开燕人马上过京洛问是谁家铜雀台 其三","author":"黄廷用","text":"三春川峡下荆门，襄汉江声万马翻。\n锦缆棋舟成辇道，琉璃新筑帝城垣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30974,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"袅袅旌?夹日来天南风净彩云开燕人马上过京洛问是谁家铜雀台 其四","author":"黄廷用","text":"清道女儿千万家，帝王南狩羽旗赊。\n旧时杨□今芳草，空度春风忆物华。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30975,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送华中翰奉使 其一","author":"黄廷用","text":"□□□□□□□，□□□□□□□。\n□□□入淮扬道，几树梅花点月明。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30976,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送华中翰奉使 其二","author":"黄廷用","text":"君到西湖春酒熟，湖中春水白鱼肥。\n茫茫烟艇堪垂钓，天遣游人此日归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30977,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻砧","author":"黄廷用","text":"萧萧木落五陵寒，捣练谁家夜已阑。\n月照罗帷人不寐，倚床犹自怯衣单。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30978,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠陈司教","author":"黄廷用","text":"头白为官别紫宸，罗浮山杳海云滨。\n春风桃李缘门径，细雨空斋莫厌贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30979,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元夕赠苏州二守如雍侄","author":"黄廷用","text":"春灯春月晃春城，相向尊前二阮情。\n今夜逢春春尚浅，更看春色老蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30980,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送钱南湖任楚雄","author":"黄廷用","text":"疋马燕云夕照斜，江南春到有梅花。\n行人莫唱梁州曲，诸葛边营属汉家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30981,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"驾往西陵 其一","author":"黄廷用","text":"腊月云霾苦不晴，貔貅百万怯衣轻。\n但言天子深宫处，犹向山中风雪行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30982,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"驾往西陵 其二","author":"黄廷用","text":"大峪云深紫气明，翠华亲为筑陵行。\n雀蛇龙虎千年壮，桧柏松楸百代情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30983,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日侍班","author":"黄廷用","text":"叨陪侍从奉天东，袅袅云烟春日红。\n仕愿君王多福祉，词臣岁岁赋东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30984,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蟠桃 其一","author":"黄廷用","text":"百颗蟠桃今几时，浪传此植自瑶池。\n秋风不者仙家树，春色年年入酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30985,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蟠桃 其二","author":"黄廷用","text":"仙桃盘屈三千里，杳隔云深碧海来。\n我亦欲寻刘阮去，路迷何处是天台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30986,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]