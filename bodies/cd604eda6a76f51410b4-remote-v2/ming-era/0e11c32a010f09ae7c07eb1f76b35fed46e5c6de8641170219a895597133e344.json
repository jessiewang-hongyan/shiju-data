[{"title":"爱春","author":"黄廷用","text":"二月河津杨柳花，东风摇曳落谁家。\n春光九十今将半，怅望青楼夕照斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30910,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠郭锦衣跃泉 其一","author":"黄廷用","text":"汉将少谈云鸟阵，禁廷新拜虎符臣。\n秋天白日明戈戟，罗绮轻骄跃马人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30911,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠郭锦衣跃泉 其二","author":"黄廷用","text":"池馆楼台帝里东，锦袍初赐五花红。\n三千珠履同瑶席，醉里时闻长乐钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30912,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠郭锦衣跃泉 其三","author":"黄廷用","text":"羽箭貂裘白马肥，平明入直紫金闱。\n晚来花底喧歌吹，曾识汾阳见虏归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30913,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜同沈省斋玉河看月口占赠之入济 其一","author":"黄廷用","text":"步月河梁喜及秋，相看月色照东流。\n无情最是城头月，流水何心管别愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30914,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜同沈省斋玉河看月口占赠之入济 其二","author":"黄廷用","text":"我客燕城君入济，与君一别即三秋。\n不知太液池中水，犹绕河东醉月楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30915,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜同沈省斋玉河看月口占赠之入济 其三","author":"黄廷用","text":"宫漏沉沉城阁清，九霄云净万方明。\n不堪静听楼前曲，一夕离情白发生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30916,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜同沈省斋玉河看月口占赠之入济 其四","author":"黄廷用","text":"月色低临龙凤阙，水流迥出蝀鳌桥。\n明朝相送成千里，背向西风白马骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30917,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题杏园赐宴","author":"黄廷用","text":"曲江江上杏花红，朵朵新沾雨露同。\n闻喜承恩谁独醉，斜看燕子舞春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30918,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻车","author":"黄廷用","text":"征轮门外何辚辚，六月长安炎暑蒸。\n主第侯家忘昼永，弦歌枕簟列层冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30919,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清明 其一","author":"黄廷用","text":"初试春衫出禁城，轻烟晴日是清明。\n南望乡关天万里，凤山云树独含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30920,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清明 其二","author":"黄廷用","text":"十载长安似浪游，乘春时出紫宸楼。\n不知故国松楸绿，依旧东风锦水头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30921,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送大行李浔江使齐归省 其一","author":"黄廷用","text":"五色晴云晓欲低，新承朝命使东齐。\n罗衫白马行春日，北海孤山望不迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30922,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送大行李浔江使齐归省 其二","author":"黄廷用","text":"乽人珍重使君行，独立层霄捧日情。\n路入瀛洲青鸟近，朝看南越白云明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30923,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送大行李浔江使齐归省 其三","author":"黄廷用","text":"经年列馆帝城东，日日郊游引辔同。\n醉里忽闻歌别调，愁看芳草向春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30924,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送大行李浔江使齐归省 其四","author":"黄廷用","text":"欲别依依万里情，连宵弦管泛春声。\n明朝驿路烟霞里，夕照相思五凤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30925,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送大行李浔江使齐归省 其五","author":"黄廷用","text":"三月青门柳色新，西郊相送转情亲。\n知君使节经过地，楚水吴山俱是春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30926,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题月洲","author":"黄廷用","text":"我客鹅湖忽十年，月明时泛木兰船。\n清流夜映银河碧，沙碛秋含远树烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30927,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日送陈主教 其一","author":"黄廷用","text":"春日春杯春色晓，春衫策马动春云。\n燕山春树眇何许，一路春风日送君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30928,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日送陈主教 其二","author":"黄廷用","text":"春入平原桃李新，官斋犹似洛阳春。\n蓝袍碧水清相映，俱是瀛洲作赋人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30929,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"康砺峰宅中上元宴集 其一","author":"黄廷用","text":"月照金门玉漏迟，灯城火树上元时。\n东风偏向瀛洲客，醉里梅花春色宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30930,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"康砺峰宅中上元宴集 其二","author":"黄廷用","text":"门连棨戟五侯家，风送鸾笙锦曲赊。\n杯泛黄金迟月色，盘行白玉荐春华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30931,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"招隐 其一","author":"黄廷用","text":"几树桃花洞口开，春风遥送谪仙来。\n不知天地何年老，醉吸山泉当酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30932,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"招隐 其二","author":"黄廷用","text":"六朝宫殿没苍苔，往事江流去不回。\n惟有龙光犹未歇，夜深偏照读书台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30933,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"招隐 其三","author":"黄廷用","text":"蹑尽山亭石径回，我心麋鹿自为媒。\n老僧欲别云关外，何意朱衣送酒来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f