[{"title":"行途漫兴","author":"苏葵","text":"分付前驱静鼓笳，莫惊山鹿吃山花。\n泉声急傍溪桥响，树影低笼石磴斜。\n观物眼高容易尽，行途吟苦顿忘赊。\n今宵可借禅家榻，与得高僧论法华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭乡友陈正郎学之四首 其一","author":"苏葵","text":"黑头交谊白头伤，世路分明不可常。\n水部独怜何逊老，乡邦尤憾郑君亡。\n标题贞操凭良史，收拾遗文有阿郎。\n怪杀青天偏太靳，不留忠荩佐陶唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭乡友陈正郎学之四首 其二","author":"苏葵","text":"暌违将及十年来，君在冬曹我外台。\n书札只言双鬓改，行藏谁料九原催。\n马经唐肆原难驻，人到华胥竟不回。\n未染彩毫题墓碣，哀歌先漫剔灯裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭乡友陈正郎学之四首 其三","author":"苏葵","text":"君家兄弟比慈明，夜雨荆花次第零。\n别驾在人留惠爱，部郎平日著贤声。\n三千世界孤芳尽，五十年华一梦醒。\n寄问久要罗令尹，能无挥涕过东城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭乡友陈正郎学之四首 其四","author":"苏葵","text":"襟宇怜公养得高，诗家翘楚酒家豪。\n风流有样希千古，廉介遗声在两曹。\n许国精忠曾未究，修文消息却难逃。\n他年我乞林泉去，烟雨凭谁共浊醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽乡友李元善方伯二首 其一","author":"苏葵","text":"少年文誉老精忠，两著边藩屏翰功。\n共把庙廊期大拜，可怜窀穸却先封。\n风流自出尘埃表，事业当收简策中。\n听得地曹贤辈论，许多遗稿后人宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽乡友李元善方伯二首 其二","author":"苏葵","text":"风流公亦是人豪，又被人间一浪淘。\n莫把隙驹嗟世短，已看方岳得官高。\n长才每信堪经济，往事回思自郁陶。\n清泪欲将何处洒，紫薇花下雨萧骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈秉衡寅长韵四首过重庆","author":"苏葵","text":"三巴未改汉时名，歇马谁深吊古情。\n杜宇漫啼三月魄，女墙孤起万家城。\n星回井鬼分区旷，江涨岷涪拍岸平。\n父老只今尚传说，岐阳军令最严明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八阵图","author":"苏葵","text":"炎光如线尚堪图，已踣山河赤手扶。\n地老阵形犹未改，雨深江练却平铺。\n四门张翼期收魏，千里连营误伐吴。\n颠倒纲维书入寇，么么陈寿欲谁诬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过垫江二首 其一","author":"苏葵","text":"陆转花封不透江，小溪经雨自琤淙。\n石嫌碍路牙成列，山爱堆云髻绾双。\n樵子放歌含古意，牧童吹笛集村腔。\n陌尘不动前驱过，分付居人莫掩窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过垫江二首 其二","author":"苏葵","text":"方城三里万山深，父老惊看使节临。\n风俗如惭输讼矢，闾阎争出买书金。\n星回碧落瞻吾道，月在秋潭信此心。\n若得涓埃堪报主，任教白发不胜簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弘治甲子夏六月巡新繁道由田塍睹禾稼有感二首 其一","author":"苏葵","text":"千亩香风散稻花，只输租赋更无他。\n任教金勒纤离好，不似藤蓑觳觫嘉。\n学稼者曾闻圣道，明农人岂外官家。\n少年也有犁锄趣，况复如今两鬓华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弘治甲子夏六月巡新繁道由田塍睹禾稼有感二首 其二","author":"苏葵","text":"二顷潮田荒不荒，骑牛人恋跨飞黄。\n也知伊尹莘郊乐，绝胜苏秦相印忙。\n门外水苗生处好，鼎中云子熟时香。\n殷勤寄谢浮萍草，漂去漂来梦一场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弘治甲子陈宪长吉夫入觐时予按保宁送之郊即别去赋此寄之","author":"苏葵","text":"明霜谊分古来难，筮肯将谁晚辈看。\n三载末寮亲典则，几场高论振琅玕。\n共知黯直真宜汉，自笑郊穷不再韩。\n一夜相思消未得，梦回星斗正芒寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日私居感怀","author":"苏葵","text":"芙蓉零落菊萧条，飒飒西风射绮寮。\n半路孤琴弦已断，莫年中馈味谁调。\n三更残梦犹如见，一片香魂不可招。\n底用金刚为渠诵，大罗天上佩声遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答江景吴寅长","author":"苏葵","text":"槁梧弹处羽音清，三弄猗兰调未更。\n心事只缘洙泗老，声名焉藉汝南评。\n升沈久破邯郸梦，雠校重烦太乙精。\n闻道芝田东海外，白云长日自英英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲子七月二十日观刘巡抚发兵气势之盛因占丑虏有不足殄作此二律以揄扬之呈寅长诸君索和二首 其一","author":"苏葵","text":"蜀乡原未识军容，此日方知有范公。\n在在旁观称得策，人人西去愿收功。\n甲光耀日惊飞鹬，剑气横秋断落虹。\n从此威声如霹雳，不愁狐鼠不潜踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲子七月二十日观刘巡抚发兵气势之盛因占丑虏有不足殄作此二律以揄扬之呈寅长诸君索和二首 其二","author":"苏葵","text":"江汉军声久不闻，中丞威令一番新。\n从来名下无虚士，信是师中贵丈人。\n汉将每云乘破竹，松州何意有飞尘。\n十年徒诵安边策，不得先锋挽六钧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲子蜀藩放榜","author":"苏葵","text":"入彀英贤七十人，人人名姓彻枫宸。\n风云变化皆龙虎，罗网分明得凤麟。\n三物我亏芹泮雨，六经谁鼓杏坛春。\n鸢飞鱼跃天然妙，化洽遐陬自圣神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日二首 其一","author":"苏葵","text":"篱畔秋容不改常，年年今日是重阳。\n黄花晚节可人意，白发天涯深酒觞。\n几片落霞随鹜尽，数声鸣鹤入云长。\n醉来欲撚苍髯坐，和得陶诗四五章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日二首 其二","author":"苏葵","text":"不是幽人亦赏花，花枝经雨迸篱斜。\n官贫贳酒常施债，才窘耽诗不到家。\n三径也曾来梦里，四年忘却滞天涯。\n西风偶掣尊前帽，莫道疏狂似孟嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日和江寅长韵","author":"苏葵","text":"秋深何独葛洪川，锦水西风亦飒然。\n邻瓮吝赊无醉处，篱花烂放足吟边。\n霜横雁度天拖字，潦尽蛟潜水没涎。\n三径有盟知久负，浮萍江汉愧年年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日书怀二首 其一","author":"苏葵","text":"天涯漫作十年游，心醉南华绝点愁。\n儒业有缘官淡泊，萍踪无定客夷犹。\n云连高树疏帘晚，雨洗残花小院秋。\n闲凭阑干听蟋蟀，荒蓁浑忘剪菟裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日书怀二首 其二","author":"苏葵","text":"轇轇扰扰欲如何，误尽青春两鬓皤。\n台署尚耽酸子业，江湖思和散人歌。\n日斜林麓多归鸟，秋老池塘半败荷。\n身事是谁裁截易，莫将缠绕笑藤萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中新寒坐芸香小阁呈郝兵备二首 其一","author":"苏葵","text":"雨酿新寒病骨愁，俸金不及换貂裘。\n观书袖手偏慵检，援笔攒眉便欲投。\n静想只宜花下酌，何为未向马前休。\n严风朔雪都门道，笑杀朱衣半白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中新寒坐芸香小阁呈郝兵备二首 其二","author":"苏葵","text":"雨珠千点散琅玕，淅沥声高客袂寒。\n金鉴有光勤自拂，龙泉无事厌轻弹。\n空闻蟋蟀吟朝夕，未见鹍鹏振羽翰。\n岁岁穷经无寸补，怪谁将作蠹鱼看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐","author":"苏葵","text":"更漏沈沈夜不哗，坐来羁思绕天涯。\n八千有路通乡井，二万无钱付酒家。\n归梦被寒霜瓦重，醉吟毫润雨珠斜。\n十年萧索青毡老，自起挑灯看莫耶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"心悬北阙为李国宾题","author":"苏葵","text":"闲控金羁艳绮罗，官家随处剩恩波。\n藩垣柳色阳春富，戚里花香湛露多。\n欲补青天思炼石，想扶红日梦鸣珂。\n昼长直馆巴山外，和得陶唐击壤歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"目极南山同前","author":"苏葵","text":"南山山下水源深，淘出慈孙孝子心。\n几处邱原青草合，万株桑梓白云阴。\n望乡台古情偏切，昼锦堂高梦亦寻。\n不道当年何驸马，朱门清夜月沈沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和宋兵备同寅来韵二首 其一","author":"苏葵","text":"小院金猊喷瑞芬，玄谈时自座前闻。\n运筹边计轻羊祜，落笔词锋逼子云。\n万里江山瞻赤旆，百年心事共斯文。\n都门夜雨论周易，应憾伊川止七分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和宋兵备同寅来韵二首 其二","author":"苏葵","text":"芝兰忻得挹英芬，更向朱弦次第闻。\n天地此心同夜月，江山明日隔春云。\n千章半是惊人句，六籍全通载道文。\n清晤有期应不远，诗题同看石榴分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和陈秉衡长官梦渔舟之作","author":"苏葵","text":"莫将清梦向芝田，今古能多范蠡船。\n万里骅骝贵腾踏，九霄鸾凤本联翩。\n才优王剪谁嫌老，懒过边生我合眠。\n三径不妨逾旧约，寄声先谢傅延年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再用前韵呈陈长官","author":"苏葵","text":"二顷谁多负郭田，未应先买洞庭船。\n莫耶不与铅刀伍，斥鴳争看彩凤翩。\n前辈几何东海去，古来只个华山眠。\n潞公不是寻常辈，八十才当入相年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽陈白沙二首 其一","author":"苏葵","text":"满江秋水蘸冰壶，白首行藏道已孚。\n孤洁世称徐孺子，风流人惜邵尧夫。\n江门大雅遗音在，伊洛春风旧迹芜。\n可恨著书嫌强聒，空教来学想规模。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽陈白沙二首 其二","author":"苏葵","text":"英灵谁昔夺山川，还却英灵是此年。\n江汉文章非偶尔，乾坤风致自巍然。\n千秋高士应稀见，一脉斯文亦正传。\n寄语后来描画者，莫将遗像失真传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉后漫书二首 其一","author":"苏葵","text":"闲看秋水思飘然，蕴括洪纤一掬天。\n荣辱自来还自去，利名谁后更谁先。\n倾残竹叶消今日，吟到梅花又一年。\n若个世人真识我，半如酸子半如仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉后漫书二首 其二","author":"苏葵","text":"苍髯银鬓自萧然，老去行藏只靠天。\n闻道愧甘伊洛后，谈玄将占老庄先。\n收琴买鹤宁论价，傍柳随花懒记年。\n心解遨游随处好，不须方外挟飞仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁晏漫成四首 其一","author":"苏葵","text":"天地无心日月流，寒寒暑暑自悠悠。\n才将风色分花信，便有年光换历头。\n混沌是亡还是在，神仙堪爱亦堪求。\n等閒识得盈虚意，未许庄生据上游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁晏漫成四首 其二","author":"苏葵","text":"乾坤消息本无穷，渠自儿童我自翁。\n黄帝向谁闻至道，伯阳徒尔注参同。\n生生化化机先定，去去来来信默通。\n明日鬓丝添几寸，肯将催促怪东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁晏漫成四首 其三","author":"苏葵","text":"不匆匆处也匆匆，残腊迎春又送穷。\n双眼老看狂世态，一官终坐冷家风。\n冰壶天蘸诗坛外，玉烛阳回宦海中。\n闲把曲生倾数斗，肯教憔悴到颜容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁晏漫成四首 其四","author":"苏葵","text":"交还残腊与洪钧，唾手风前换得春。\n且喜花枝浑改旧，不妨霜鬓漫添新。\n拚倾仪狄千钟酒，谢绝元规半点尘。\n把定壮心偏忘老，轩昂天地任吾人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送江寅长致政还江右二首 其一","author":"苏葵","text":"十年谊分照霜明，割席何忙强问程。\n只为乾坤双眼阔，便看名利一毫轻。\n白鸥喜狎忘机客，丹陛能容采菊生。\n安得一丸如许大，旋封三峡不教行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送江寅长致政还江右二首 其二","author":"苏葵","text":"五湖烟水忆扬舲，心事江篱岸芷馨。\n峨豸几年看长价，相牛明日听谈经。\n人间高士鸿辞网，眼底贪夫蚁恋腥。\n把酒爱公真慷慨，折梅相赠过长亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕","author":"苏葵","text":"坐看童子放花筒，又是乾坤一岁终。\n缓酌壶觞延夜雨，大开门户领春风。\n百年分在忘他老，四品官清送甚穷。\n闲染彩毫题短咏，烛花光射砚池红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元旦后用前韵呈郝王二官长二首 其一","author":"苏葵","text":"泻尽香醪忆旧筒，将来高兴未全终。\n浣花溪上融融日，濯锦江头淡淡风。\n无事恼怀赢得懒，有诗消闷易忘穷。\n人生一世如一日，莫待斜阳抹树红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元旦后用前韵呈郝王二官长二首 其二","author":"苏葵","text":"欲共渔翁理钓筒，不应官事未曾终。\n光浮竹叶怜秋月，吹落梅花怪晚风。\n减价卖痴痴不了，强吟乘兴兴难穷。\n夜深分得青藜火，读尽南华日又红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酌酒及灌花复用前韵呈川北同寅二首 其一","author":"苏葵","text":"大瓢吸酒胜荷筒，醉倚花阴日未终。\n世路每怜蕉鹿梦，人情偏慨马牛风。\n愁随蔓草□难歇，目送征鸿去不穷。\n闲绕芳塘漫寻句，水光清漾晚霞红。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酌酒及灌花复用前韵呈川北同寅二首 其二","author":"苏葵","text":"汲水浇花截竹筒，爱花吾亦解图终。\n高悬响索惊飞鸟，斜插疏篱护恶风。\n生意固应天不靳，韶华须信树无穷。\n凭君莫惜尊前醉，来看深红并浅红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和刘都宪喜松潘报捷韵二首 其一","author":"苏葵","text":"野无烽燧草无埃，戎虏输诚次第来。\n千骑不如单骑力，今人真有古人才。\n勒彝端可媲周雅，拜将何烦筑汉台。\n镇靖正宜羊叔子，从前边衅咎谁开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和刘都宪喜松潘报捷韵二首 其二","author":"苏葵","text":"地屦天冠绝点埃，万山烟净月明来。\n貔貅尽领平戎略，中外浑惊迈众才。\n五凤楼前宣露布，九夷人亦囿春台。\n笙歌有待升平宴，宾从华筵甚日开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感事","author":"苏葵","text":"区区可是学仙徒，别有丹方足自娱。\n三爵自无闲计较，五车时有老工夫。\n闲看雨里花无恙，更喜窗前竹不枯。\n今古浮名同一梦，莫论平越与平吴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙丑送春写怀","author":"苏葵","text":"日暖迁乔莺乱啼，恶怀无赖欠新题。\n梨花笑客壶觞寂，燕子嫌人户牖低。\n远道光阴空自惜，上林消息且休提。\n阶前暂卸寻芳勒，怪得骅骝也漫嘶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和王朝器同寅来韵二首 其一","author":"苏葵","text":"射隼高墉藉六钧，丈夫藏器正资身。\n古今上下偏由我，天地盈虚不属人。\n世路有时还似梦，宦途随处是通津。\n闲荣闲辱休提说，且尽梨花百斛春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和王朝器同寅来韵二首 其二","author":"苏葵","text":"彷佛红楼买笑人，大都宜假不宜真。\n王成漫自縻高爵，即墨凭谁辨远臣。\n玉在无瑕元是美，棋残有著又从新。\n经纶康济吾儒事，莫道尘羁未卸身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"署篆冗中漫书呈杨至道陈孔章长官","author":"苏葵","text":"俗事纷纷俗杀人，莺啼燕语误芳辰。\n无诗无酒如秋淡，多病多愁厌雨频。\n行处瑕瑜劳计较，法家机械费精神。\n尚平可学谁曾学，自笑区区见未真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄刘仁仲学士同年","author":"苏葵","text":"蓬瀛回首十年过，扰扰尘中鬓易皤。\n欲究图书规邵子，偶拈刀笔附萧何。\n光风霁月吟边少，绿水青山梦里多。\n一臂旧交谁不改，襜褕常日自摩挲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谬掌堂事四越月颇厌烦劳喜得宪长京还交代有作三首 其一","author":"苏葵","text":"懒散如何不是仙，人间亦有洞中天。\n谁教鸿鹄荣丝绁，自喜骅骝卸锦鞯。\n行看晚霞公牍了，醉听朝雨曲肱便。\n病夫敢比程明道，傍柳随花学少年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谬掌堂事四越月颇厌烦劳喜得宪长京还交代有作三首 其二","author":"苏葵","text":"一百廿日妨晏眠，轇轇扰扰总徒然。\n纵令明决得金矢，何似优游寻简编。\n鼓缶莫嗟将昃日，浴沂宁泥暮春天。\n豫章社栎君须玩，材与不材谁永年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谬掌堂事四越月颇厌烦劳喜得宪长京还交代有作三首 其三","author":"苏葵","text":"机械谁教漫自烦，终朝碌碌不如闲。\n醉来檐底疏疏雨，睡起天边淡淡山。\n龙子白而非白外，庄生才与不才间。\n乾坤尽有寻常乐，雪月风花任往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦热","author":"苏葵","text":"蒲扇无功院宇卑，月行犹未次南箕。\n九成宫在君恩远，三伏天高日影迟。\n当午水晶供一枕，辟炎冰茧胜纤絺。\n困来漫忆千年事，犹有三军六月驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从弟亚夫进士自南安寄书至喜而赋此寄京答之","author":"苏葵","text":"一缄何处远传将，带得梅花庾岭香。\n乡梦唤回鱼泼泼，墨云飞动雁行行。\n细看顿觉愁中喜，大笑浑疑醉后狂。\n万里寄书情莫罄，几时风雨复连床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜亚夫进士将选寄以期勉","author":"苏葵","text":"清白传家四百霜，偶然科甲共君扬。\n寸心可据摅忠地，一饭休忘种德堂。\n往事模棱堪鉴戒，暮年完璧是行藏。\n区区老病浑无补，惟把经纶卜季方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]