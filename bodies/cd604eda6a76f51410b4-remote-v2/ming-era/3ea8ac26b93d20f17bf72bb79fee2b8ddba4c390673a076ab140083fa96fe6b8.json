[{"title":"寄张超然 其二","author":"何绛","text":"溪涧冰来懒灌园，残编读罢闭柴门。\n文章盖世曾推仰，却喜南人得殿元。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41739,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄张超然 其三","author":"何绛","text":"相逢閒忆旅金阊，白发惭余老楚狂。\n得意雁书应莫惜，北田路不过衡阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41740,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"横塘曲为泽远弟池园作 其一","author":"何绛","text":"清溪隐隐入门流，别馆高开水上洲。\n日晚塘南望塘北，黄云城上几峰秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41741,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"横塘曲为泽远弟池园作 其二","author":"何绛","text":"风静寒塘月上时，画船箫鼓绕疏篱。\n轻帆祇逐花香去，不觉惊飞双鹭鸶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41742,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"横塘曲为泽远弟池园作 其三","author":"何绛","text":"洞箫谁向月深吹，月上高林鸟未知。\n满壁秋灯摇竹影，落花声里有敲棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"横塘曲为泽远弟池园作 其四","author":"何绛","text":"水碧沙明静不流，蓑衣閒上木兰舟。\n鲈鱼钓得长盈尺，脍就银丝玉碗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"横塘曲为泽远弟池园作 其五","author":"何绛","text":"绿水青帘小槛幽，鲭鲂白鳊数千头。\n坐来莫说机心事，多恐群鱼渐远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"横塘曲为泽远弟池园作 其六","author":"何绛","text":"谁将香雪散千株，昨夜师雄梦到无。\n最恨盈盈一水隔，美人空自握明珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"横塘曲为泽远弟池园作 其七","author":"何绛","text":"碧桃花落杏花鲜，绿树莺啼二月天。\n白发先生眠未起，鹧鸪飞上钓鱼船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"横塘曲为泽远弟池园作 其八","author":"何绛","text":"飒岸薰风菡菼香，沧浪歌罢水天长。\n君来休道西湖好，山外青山不可方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"横塘曲为泽远弟池园作 其九","author":"何绛","text":"树头树底生离枝，笑杀东坡量不支。\n日食仅能三百颗，肚皮已不合时宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"横塘曲为泽远弟池园作 其十","author":"何绛","text":"大堤堤上柳丝丝，今日重来异昔时。\n岂是近人离别易，年年折尽路头枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"粤台新柳 其一","author":"何绛","text":"雨雪纷纷冰满潭，越台新柳已毵毵。\n非因杜宇天津唤，天气如何亦自南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"粤台新柳 其二","author":"何绛","text":"陆贾城边越水滨，翠条犹是汉时春。\n不知事去千馀载，无奈东风吹又新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"粤台新柳 其三","author":"何绛","text":"几树流莺唤晓晴，淡黄轻绿曳春明。\n呼鸾道上东风急，吹入长条渐作声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"粤台新柳 其四","author":"何绛","text":"婀娜新枝舞细腰，多连山口任风飘。\n期君莫恃为樊圃，脆软由来是柳条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"粤台新柳 其五","author":"何绛","text":"珠海西流入柳坡，年年春色最先过。\n虽然枝叶垂垂密，菀柳从今不用歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"粤台新柳 其六","author":"何绛","text":"春花开遍叶初齐，十里阴中走马蹄。\n霸上棘门何足道，试将一箭射长堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿月涛上人 其一","author":"何绛","text":"千针一衲白头僧，久坐山中少送迎。\n六十年前师记否，明星灿烂独周行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿月涛上人 其二","author":"何绛","text":"蒲团定后夜风清，钟磬不鸣江月鸣。\n百八念珠齐放下，本来无灭亦无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送迹删上人入西宁 其一","author":"何绛","text":"偶辞僧伴逐閒云，锡杖西飞访隐沦。\n莫向崧台台下过，山川如旧易伤魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送迹删上人入西宁 其二","author":"何绛","text":"道为吾道非吾道，山是他山莫认真。\n若种桃花遮洞口，又来尘世避秦人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄白山上人 其一","author":"何绛","text":"昔别江城何太匆，忆师常在五更钟。\n缄书欲寄樵西寺，寺隔春云千万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄白山上人 其二","author":"何绛","text":"菩提树下识师初，贝叶经文手自书。\n僧腊渐高心渐了，又携衣钵入深居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄敏上人","author":"何绛","text":"一从飞锡入青山，日日行吟水石间。\n昨向樵夫曾问信，隔溪遥见掩松关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自河头入山 其一","author":"何绛","text":"宵烟未散笋舆行，花落东风尚有声。\n茅屋隔松蒸秫火，光和残月到天明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自河头入山 其二","author":"何绛","text":"野花黄白涧桃红，行尽千山路未穷。\n莺语不离春树里，马蹄多入瀑声中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自河头入山 其三","author":"何绛","text":"几间山店石桥西，谷口风高酒幔低。\n鸡黍熟时行客到，当垆风俗但凭妻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自河头入山 其四","author":"何绛","text":"新雨连朝水灌畦，薄田千亩及时犁。\n农夫就饷林间妇，笑指声声布谷啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自河头入山 其五","author":"何绛","text":"千声征铎出长林，绿叶重重春渐深。\n不识此间行道者，鸡鸣时节尔何心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自河头入山 其六","author":"何绛","text":"野棠花谢水无声，旧殿荒凉禾黍生。\n故老尚能遮道语，鹃啼无夜不三更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自河头入山 其七","author":"何绛","text":"黄泥湾下几重滩，滩水如雷去不还。\n怪得道傍长太息，红尘飞处是人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自河头入山 其八","author":"何绛","text":"春草斜侵石路微，春花如锦木芽肥。\n鹧鸪本是南翔鸟，每向车前傍我飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自河头入山 其九","author":"何绛","text":"丁丁伐木昼声喧，竹里人家溪上村。\n青箬盖头椎髻妇，乱烟驱犊上高原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自河头入山 其十","author":"何绛","text":"绝巘层峦若上天，朝昏常共鸟争先。\n肩舆下阪逢虾蟹，又听潮声到海边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自电白至海安 其一","author":"何绛","text":"诸溪滂湃众峰巍，牧竖歌声出翠微。\n绝壁有花皆倒出，深山无鸟不低飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自电白至海安 其二","author":"何绛","text":"春云过处行犹湿，岭树晴时看更多。\n最惜长官排卤簿，往来无数奈忙何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自电白至海安 其三","author":"何绛","text":"黄茅障里树苍苍，问禁先须自入乡。\n何事村中人尽道，狐狸休惮畏豺狼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41776,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自电白至海安 其四","author":"何绛","text":"瘴云乍起四天低，鳷鹊飘鹞无定栖。\n不是据鞍凭老马，纵逢沮溺路终迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41777,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自电白至海安 其五","author":"何绛","text":"悲风吹地日无光，道是贤王旧战场。\n君子不留猿鹤在，萧萧白骨总闻香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41778,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自电白至海安 其六","author":"何绛","text":"渐入深林瘴渐多，闻声始觉有人过。\n高天久矣人难问，蓁莽何劳更作罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41779,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自电白至海安 其七","author":"何绛","text":"千峰日落客行稀，雾捲东风欲湿衣。\n树下老猿当涧饮，村边黄犊带禽归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自电白至海安 其八","author":"何绛","text":"无多篱落绕柴门，又是停车一夜村。\n野老偶谈征战事，我闻斯语过闻猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自电白至海安 其九","author":"何绛","text":"竹床木枕暂将公，几盏村醪睡正融。\n生恨小窗深夜雨，赚人春梦不能终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自电白至海安 其十","author":"何绛","text":"双溪直下水迢迢，又逐东风过小桥。\n见有雁飞犹未海，望无山处渐闻潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"琼南杂咏 其一","author":"何绛","text":"海阔天空鸟不飞，远书难得到柴扉。\n可怜一梦忘艰阻，如此波涛夜夜归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"琼南杂咏 其二","author":"何绛","text":"穷溟无复雁南翔，腊月家家插稻秧。\n椰斝静倾粘实酒，梅花白映菊花黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"琼南杂咏 其三","author":"何绛","text":"三年频上仲宣楼，日日题诗忆旧游。\n归去米囊花正好，共沽村酒擘箜篌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"琼南杂咏 其四","author":"何绛","text":"杏花桃萼领春风，一片朝霞照眼红。\n却忆小山丛桂长，年年空自笑山翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠崖杂咏 其一","author":"何绛","text":"一春黄菊满东篱，岂是高天别有私。\n错被鹧鸪频懊恼，原来佳物不逢时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠崖杂咏 其二","author":"何绛","text":"箬笠青裙一八姩，丹唇墨齿尽堪怜。\n外人不谙蛮言语，祇见槟榔满口边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠崖杂咏 其三","author":"何绛","text":"藤蔓交加海漆香，山川满目尚洪荒。\n槟榔子熟输官税，椰酒邀人杀豕尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠崖杂咏 其四","author":"何绛","text":"花梨树底结重阴，野鹿千头榛莽深。\n木客刳将沉水去，猩猩群坐语幽林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠崖杂咏 其五","author":"何绛","text":"南风轻软浪头疏，艓子开时日出初。\n白发老翁双桨急，蜃楼边去捕飞鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠崖杂咏 其六","author":"何绛","text":"海燕层崖结素房，安居未就饱人肠。\n覆巢小事君休讶，弱肉人间尽食强。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠僧 其一","author":"何绛","text":"振锡东南一载期，入廛垂手几人知。\n相逢试问修心事，笑指閒云未去时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠僧 其二","author":"何绛","text":"道貌经年战胜肥，一身衣是旧时衣。\n黄梅久待新州獠，切勿逢人说是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠少年李道士","author":"何绛","text":"手持二尺黄金简，旧有传家道德经。\n吉日天坛朝北斗，少年原是老人星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广州元夜歌 其一","author":"何绛","text":"穗石春明古洞开，绛花千树布香街。\n绿舆来往穿花市，半揭珠帘露绣鞋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广州元夜歌 其二","author":"何绛","text":"永夜花丛百戏张，家家儿女为春忙。\n相过更约相携去，城里新开内教场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广州元夜歌 其三","author":"何绛","text":"粤秀春山锦绣文，烧香士女日纷纷。\n游人背指呼鸾道，千尺飞楼插白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广州元夜歌 其四","author":"何绛","text":"雁翅城边宝月升，星桥百道彩云凭。\n六榕古寺香烟起，女伴相携礼塔灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广州元夜歌 其五","author":"何绛","text":"谁家年少醉春杯，两朵桃花脸上开。\n侧着毡鞋双足热，钟楼西畔打毬回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广州元夜歌 其六","author":"何绛","text":"十五儿郎满面春，槟榔嚼罢露朱唇。\n越罗衫袖笼瓜子，玉指分开渡与人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广州元夜歌 其七","author":"何绛","text":"堂上鸣琴百务休，美人何处不风流。\n家家弦诵寻常事，最是花时月满楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广州元夜歌 其八","author":"何绛","text":"有情夜月上栏杆，穿入疏棂欲寐难。\n搔首起来窗外立，狂吟不觉又更残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广州元夜歌 其九","author":"何绛","text":"少妇闺中学画眉，春山楼外淡相窥。\n不知底事关眉角，恰似山回叠浪时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广州元夜歌 其十","author":"何绛","text":"铁砚磨穿不惮劳，桃花浪里钓金鳌。\n只因整顿衣冠去，不怕龙门万丈高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惠阳竹枝辞 其一","author":"何绛","text":"惠阳城南浪似雷，惠阳城东江水来。\n嘱郎莫学双江水，一合千年去不回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惠阳竹枝辞 其二","author":"何绛","text":"侬家住在西湖边，暮暮朝朝得见莲。\n恨杀昨宵无赖雨，水深寻藕总无缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惠阳竹枝辞 其三","author":"何绛","text":"此去广州三日水，此去罗浮日半山。\n算来亦是无多路，只要郎心乐往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惠阳竹枝辞 其四","author":"何绛","text":"烟霞桥出鳄湖边，一道垂杨入野田。\n郎骑白马来殊好，鳄怪伤人是浪传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惠阳竹枝辞 其五","author":"何绛","text":"床下别郎何草草，欲送郎行怕兄嫂。\n自从郎渡合江头，侬鞋不踏门前道。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别林君卫 其一","author":"何绛","text":"春风三度客琼台，春去春来共把杯。\n此别便随春去也，春来秪是寄书来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别林君卫 其二","author":"何绛","text":"连宵风雨尚联床，乍听荒鸡便束装。\n他夜梦魂还到此，故人门巷最难忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别林君卫 其三","author":"何绛","text":"去去山程复水程，离魂消尽子规声。\n布帆虽趁南风稳，恨不同君咏月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别林君卫 其四","author":"何绛","text":"九州行尽涉珠厓，白发毵毵事事乖。\n归去幸留吾舌在，一区田亩尚萦怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡大灵携其门人与幼子作客青齐 其一","author":"何绛","text":"泰山夜半曾观日，要识秦王无字碑。\n君去未须惊往事，诗书原不与时宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡大灵携其门人与幼子作客青齐 其二","author":"何绛","text":"从我岂惟门弟子，车中共载有佳儿。\n知过阙里趋庭处，小子才当学礼诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":41817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]