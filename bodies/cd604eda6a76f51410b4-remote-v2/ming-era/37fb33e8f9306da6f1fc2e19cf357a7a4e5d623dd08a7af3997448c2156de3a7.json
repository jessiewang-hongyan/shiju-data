[{"title":"暮春书怀和周云谷","author":"庞尚鹏","text":"谁道春归去，长从水竹居。\n池边通小径，花外驾轻车。\n见猎心全息，逃禅计未疏。\n浮名千古笑，安用茂陵书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日得塞上督府书","author":"庞尚鹏","text":"惊喜边书到，祁连朔气清。\n共论张仲蔚，何似李西平。\n岁月东山远，风尘白发生。\n谁家吹铁笛，偏动玉关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得边帅书","author":"庞尚鹏","text":"西望阳关路，冲星剑气横。\n天青沙草暗，月白陇云明。\n投笔千年事，平胡万里情。\n逐臣江海远，回雁听边声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"残年写怀","author":"庞尚鹏","text":"日月双推毂，俄惊节序更。\n岁寒新酒熟，风急敝裘轻。\n多暇惟谈易，长贫懒治生。\n鹪鹩栖息稳，何意向人鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"视溪亭树","author":"庞尚鹏","text":"曲径环深树，何如习氏园。\n参天含雾气，蹲石倚云根。\n横覆高低屋，斜连远近村。\n渔樵无路入，疑是武陵源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醒枕","author":"庞尚鹏","text":"辗转虚良夜，曾无稳卧时。\n寸心应自遣，百虑欲何为。\n月落鸡声早，风寒禁漏迟。\n华山寻睡法，无计访希夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老妇","author":"庞尚鹏","text":"最是青春好，其如白发新。\n却怜看镜日，长忆画眉人。\n莫问前生事，争誇见在身。\n嫦娥有灵药，重喜结芳邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春前一夕宿远客","author":"庞尚鹏","text":"休道论交晚，相看岁月长。\n雪消沽酒市，云满聚星堂。\n占气春将到，忘年喜欲狂。\n须君留信宿，同醉满庭芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀光孝寺寄霍南峤用韵","author":"庞尚鹏","text":"曾问西来意，谁参最上乘。\n即心原是佛，出世不如僧。\n说法空堂月，翻经午夜灯。\n炎洲多苦海，应有玉壶冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦应酬和高左史呈谭别驾","author":"庞尚鹏","text":"却笑门如市，劳劳欲避人。\n闭关藏竹坞，倒屣厌车尘。\n乐国如何地，浮生祇此身。\n扁舟同载酒，江上且垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳书怀和谭别驾","author":"庞尚鹏","text":"黄花三径好，一醉即柴桑。\n月色临池近，秋声入夜凉。\n江天横朔雁，垄树带斜阳。\n犹忆边城日，登楼望故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛海有述","author":"庞尚鹏","text":"孤屿横连海，渔樵共一家。\n沧波浮日月，远树带云霞。\n夜静骊珠现，沙平雁阵斜。\n扁舟星汉近，缥缈泛仙槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀刘跃衢年兄","author":"庞尚鹏","text":"世态烟波转，江流自古今。\n共看千里月，长照百年心。\n尘掩虞卿璧，山藏董坞金。\n忆君投辖醉，天远白云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独坐和卢方伯","author":"庞尚鹏","text":"世局纷纷变，斋居总不知。\n青春忙里过，白日静中移。\n鸿鹄翔千仞，鹪鹩恋一枝。\n此心忘去住，面壁得吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客有问予别墅者作此答之","author":"庞尚鹏","text":"结屋沧洲上，桃花隔武陵。\n海深先近日，山远不逢僧。\n鹤立千年树，岩藏六月冰。\n苏门渺何许，长啸忆孙登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答友人话旧","author":"庞尚鹏","text":"西北风尘地，那堪论泬寥。\n与谁筹国事，何日灭天骄。\n塞马宁论失，江鲈早见招。\n薄躯犹善饭，拊髀未全消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登黄鹤楼和同年张侍郎","author":"庞尚鹏","text":"千古名楼远，凭高何壮哉。\n江随天地转，山抱日星回。\n树色连云合，湖光拂曙开。\n欲寻仙客去，乘鹤共飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"久雨","author":"庞尚鹏","text":"天远层云合，占晴独倚门。\n玄蝉投树滑，黄潦入江浑。\n山气岚烟重，蛙声鼓吹喧。\n三农歌帝泽，晴景未须论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和移石床近莲花","author":"庞尚鹏","text":"风从天上起，吹送野亭香。\n竹外红云岛，溪头白玉床。\n流霞开艳景，明月助清光。\n斗酒逢君醉，宁论世路忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日无客","author":"庞尚鹏","text":"炎天长独卧，岑寂最相宜。\n客散何须问，瓶空不自知。\n闭关凉雨过，题竹晚风吹。\n小步临花砌，婴儿执袂随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚眺祈晴闻龙舟出海","author":"庞尚鹏","text":"积雨连旬朔，江村乐事稀。\n忽闻金鼓震，争讶木龙飞。\n雪浪滔天涌，旌旗向日挥。\n晴飙云里发，应跨彩虹归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"颓垣和谭别驾","author":"庞尚鹏","text":"独乐名园在，休论四壁摧。\n藤萝长自好，风雨任相催。\n竹坞邻鸡入，蓬门野径开。\n青山堪卜筑，千载共崔嵬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园亭避暑用韵","author":"庞尚鹏","text":"德星连夜聚，知为集耆英。\n喜气从天下，豪谈举座倾。\n采莲溪上醉，看竹雪中行。\n壶里乾坤小，还期泛八溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和王总戎假寓西庄","author":"庞尚鹏","text":"西台凝望远，永夜看旄头。\n饮马思吞海，投鞭欲断流。\n东山千里月，南雁五湖秋。\n画角中天发，虚疑塞上楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和谭别驾病起","author":"庞尚鹏","text":"万事从今好，休言百病侵。\n加餐香稻足，稳步曲门深。\n雨后窥三径，风前戏五禽。\n何劳学庄舄，长作越人吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日苦热","author":"庞尚鹏","text":"郁郁炎州地，骄阳白昼腾。\n空中飞鸟绝，树杪乱烟凝。\n夜月秋光暗，天门海气蒸。\n閒云方出岫，疑是待龙兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卧游海珠寺","author":"庞尚鹏","text":"天高孤月小，海阔万山连。\n身世云间鹤，乾坤浪里船。\n逃禅留客醉，开阁倚云眠。\n探得骊珠在，神光照佛前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋良会客有不待月而别者","author":"庞尚鹏","text":"庾亮多秋兴，高怀向晚开。\n酒深人渐散，天远月徐来。\n瑶草千茎露，彤云百尺台。\n嫦娥能共醉，徙倚夜徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清夜吟用韵书感","author":"庞尚鹏","text":"拊髀嗟时事，风高晓漏迟。\n长悬千载虑，岂为一家私。\n乌鹊云中渡，明星月后随。\n江湖心欲折，新白几茎髭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠刘翰林还京","author":"庞尚鹏","text":"奏赋才名远，抽豪上玉堂。\n禁垣劳侍从，纶阁待平章。\n拥传趋东观，看云忆太行。\n词臣司献纳，忠谠达明光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春","author":"庞尚鹏","text":"休道春归去，青春去复回。\n鸟声来远树，花气落深杯。\n景色何曾别，人情莫浪猜。\n绿阴高阁上，偏忆草玄才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻杜鹃","author":"庞尚鹏","text":"月色横天地，长林闹子规。\n悲鸣如有恨，怅望欲何为。\n声急凄风断，魂寒晓漏迟。\n愿教深结舌，投足万年枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻蝉","author":"庞尚鹏","text":"夏日开东阁，天边送远声。\n一身能自遣，万口为谁鸣。\n露重林霏润，风高羽翼轻。\n知音如有待，听尔岂无情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园树有巢鹊","author":"庞尚鹏","text":"绿树连霄汉，幽栖羡一枝。\n托身忘偃蹇，集木识安危。\n云暗归巢早，天寒出户迟。\n名园修健翮，不使弋人窥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古剑","author":"庞尚鹏","text":"神物终当合，应怜解佩难。\n倚天曾耀日，抵掌独登坛。\n价比南金重，光腾北斗寒。\n沛公西略地，三尺定长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄙述答谏议萧公","author":"庞尚鹏","text":"谏草传天下，奸谀胆正寒。\n赤心悬日表，紫气上眉端。\n春殿依龙幄，慈闱拜凤冠。\n秘书三万卷，频向夜灯看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂言五首 其一","author":"庞尚鹏","text":"翻云还覆雨，天道几晴阴。\n义薄黄金重，人情似海深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂言五首 其二","author":"庞尚鹏","text":"人生日营营，得失为心患。\n世事尽浮云，冷眼林间看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂言五首 其三","author":"庞尚鹏","text":"陵谷有变迁，日月无停滞。\n寂寞子云居，何人来问字。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂言五首 其四","author":"庞尚鹏","text":"看花閒便出，邀月醉还斟。\n试问羲皇人，千载谁问心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂言五首 其五","author":"庞尚鹏","text":"累累多荒冢，谁辨贤与愚。\n丹心照青史，伟哉真丈夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"睡觉 其一","author":"庞尚鹏","text":"云深天未晓，侧足踞绳床。\n明星窥户牖，疑是旭日光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"睡觉 其二","author":"庞尚鹏","text":"日高睡未足，愧我希夷身。\n钟鸣更漏尽，犹有夜行人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居杂言 其一","author":"庞尚鹏","text":"瓮牖窥天地，何人顾草庐。\n家无千日酒，惟有万言书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居杂言 其二","author":"庞尚鹏","text":"世事今何日，深居独灌园。\n夜来焚谏草，偏愧舌犹存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居杂言 其三","author":"庞尚鹏","text":"一卧沧江晚，何年梦觉时。\n周公如复见，千古是吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨景","author":"庞尚鹏","text":"一夜风雷起，溪流处处通。\n五湖天浩荡，烟水更冥濛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西平道中","author":"庞尚鹏","text":"树色迎朝日，春风动酒旗。\n杏花村里过，无处觅金龟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高苕峰陈莘野刘纯吾三公隔水不得相见 其一","author":"庞尚鹏","text":"芳村连曲水，树色隔江分。\n愿结青山侣，同为出岫云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高苕峰陈莘野刘纯吾三公隔水不得相见 其二","author":"庞尚鹏","text":"莫叹归来早，那堪远别离。\n凤城春草绿，偏忆旧游时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"默坐 其一","author":"庞尚鹏","text":"地远山河静，天空日月移。\n明心持戒律，禅定是吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"默坐 其二","author":"庞尚鹏","text":"芸阁藏诗谱，忘言对项斯。\n竹阴环短榻，况复月明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绝句和杜 其一","author":"庞尚鹏","text":"远树笼朝雾，轻鸿踏雪泥。\n江楼先得月，野店是闻鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绝句和杜 其二","author":"庞尚鹏","text":"短发霜前草，浮名镜里花。\n风烟皆过客，宇宙即□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"医巫闾山","author":"庞尚鹏","text":"长夏萧森不知暑，云中鸡犬作人语。\n石磴禅房长薜萝，老僧持钵归何处。\n洞里原无蝉蜕人，山腰空见冬青树。\n眼中日月长为侣，华岳峰头高几许。\n撑天拄地镇夷荒，触石兴云作霖雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西河驿","author":"庞尚鹏","text":"去岁淮楼坐明月，海色山光白如雪。\n今岁扬旌拂塞尘，黄沙白草埋青春。\n听鸡握发事长路，东渡辽海西入秦。\n临岐拊髀长叹息，愧我碌碌非能臣。\n会当早觉渔樵伴，买舟结屋称芳邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"院中葵","author":"庞尚鹏","text":"苍颜本非杨柳质，幽香不似芝兰室。\n年年空有岁寒心，万绿丛中长捧日。\n公馀坐对满枝红，岂羡江陵千树橘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飓风歌","author":"庞尚鹏","text":"卧闻万里天声动，赫赫玄威孰操纵。\n撼岸潮头涌怒涛，却疑汉楚睢阳閧。\n翻盆暴雨夜漫漫，浲水千丈迷桑田。\n黑风捲地蛟龙斗，乱云披靡相牵连。\n扬沙拔木木欲折，霆击山摧群芳歇。\n胡商倚舶揽惊魂，濒危始悔谋生拙。\n射潮安得万弩强，力能倒海如鞭羊。\n中流安得撑底柱，屹立东障波澜狂。\n天地何心民何罪，田园荒落留逋税。\n干戈旱潦苦相仍，十室九空叹贫悴。\n谁能飞身云汉长，坐扫重阴天帝旁。\n挽起扶桑回赤日，深山穷谷歌朝阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁","author":"庞尚鹏","text":"有鸟有鸟刺天飞，凌风何处借高栖。\n朝游碧落暮四海，谁道汤网横天施。\n雪深边塞五更时，洞庭云暗雨如丝。\n河汉一声天地晓，耻随越鸟巢南枝。\n沙头明月秋偏好，芦洲曲水环蓬岛。\n群居不为稻粱谋，回翔肯落虞人手。\n问尔常从海上来，钓徒几见鹰扬老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邻妇哭殇子用韵","author":"庞尚鹏","text":"山中歼露歌，里人皆动色。\n何况母子间，情义关休戚。\n拊心长恸白日颓，泪零百草东山摧。\n奈何原壤歌狸首，独于母死忘悲哀。\n亦有风流称放达，浃旬一饮醉如泥。\n祇将白骨埋黄土，雨馀荒冢草萋萋。\n世间骨肉多如此，吁嗟邻妇何深悲。\n幽明已隔重泉路，肠断呼天知为谁。\n游魂一去不复返，人生如寄终同归。\n乾坤亦有销沉日，杜宇空劳月下啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11966,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓行歌送卢方伯如城","author":"庞尚鹏","text":"鸡声初乱五更残，朔风飕飕送晓寒。\n潮长扁舟下急湍，轻波水面正瀰漫。\n日轮浮动海天宽，蓬莱宫阙倚云看。\n咫尺谁家吹紫鸾，城上朱楼十二阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11967,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛溪纪游","author":"庞尚鹏","text":"朔风飘飘溪树前，轻篷短棹溪边船。\n翩翩鼓枻泛溪去，鉴湖万顷通长川。\n入夜披光清且涟，粳秫蔽野横朝烟。\n举酒相属意悠然，青天直与水相连。\n村墟日高集贩贾，铺排沙头杂儿女。\n相逢问答无别言，耳边尽是农家语。\n吁嗟世态如春云，纷纷代谢不堪陈。\n经过渡口百花繁，信宿随风向水滨。\n古来万事长如此，招携何惜采芳频。\n会心便是忘机处，忽觉鱼鸟来相亲。\n避人休问桃源洞，祇今圣代非嬴秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11968,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感时排律和杨胪山","author":"庞尚鹏","text":"閒居卜筑枕江濒，举杯独酌罗浮春。\n宇宙几逢三月景，蜉蝣应笑百年身。\n何缘蝉蜕寰中事，得比羲皇世上人。\n赤地平原飞旱魃，穷阎瓦甑起黄尘。\n十郡敲鞭官赋急，四郊烽火羽书频。\n利穷山海脂膏尽，税及舟车道路贫。\n云冷战场埋白骨，车深山麓绝遗民。\n当昼街衢横虎兕，故乡门巷长荆榛。\n饥寒共抱农桑恨，覆载何孤天地仁。\n贷粟捐租常倚盻，积薪厝火敢谁论。\n书生叹息曾流涕，天阙高深难具陈。\n日月亦常临蔀屋，庙堂宁忍弃编氓。\n阳春浩荡云为雨，和气氲氤夜向晨。\n伫望太平知有待，错教愁苦动相嗔。\n东皋舒啸陶彭泽，谷口躬耕郑子真。\n啜菽敢忘青玉案，忧天空负白纶巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惠短笺口号","author":"庞尚鹏","text":"朝来新得五花笺，尺素须教百世传。\n笔底龙蛇欲飞动，松魂片片生云烟。\n益州十万谁寄我，望幸不作明河篇。\n洛阳一日闻增价，三都赋就心跫然。\n咄咄书空愧知白，宁为草圣酒中仙。\n薛涛千幅不尽意，掀眉投笔且谈玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"弼唐兄食不重肉乃东西远游无宁岁感而赋此寓忠告之意","author":"庞尚鹏","text":"流光荏苒如掷梭，人生温饱能几何。\n安乐窝前万事足，年年新雨长青蔬。\n饥来长啜一盂粥，坐对妻儿生计足。\n钟鸣鼎食岂不荣，祇恐终朝闻颠覆。\n夷齐采薇西山外，震世高名悬绝代。\n何人下箸日万钱，风尘朽骨今何在。\n浊醪粗饭常有馀，肯负平生七尺躯。\n人世蜉蝣等朝露，黄金筑坞何其愚。\n古来富贵皆由命，绳枢瓮牖吾何病。\n此心扰扰空自劳，天定安能以人胜。\n何如避地且悬车，赢得胸藏万卷书。\n开门永日对幽草，莫问家无儋石储。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪月歌寿卢方伯 其一","author":"庞尚鹏","text":"拥炉朝赏东山雪，抚筝夜燕南楼月。\n醉来满地砌琼瑶，清光万里横双阙。\n蓝桥风起报春回，江南江北梅花发。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪月歌寿卢方伯 其二","author":"庞尚鹏","text":"齧梅先齧枝头雪，招客先招江上月。\n雪深同结岁寒盟，红梅雪后才堪折。\n门前旧客任去来，明月何曾远离别。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":11973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]