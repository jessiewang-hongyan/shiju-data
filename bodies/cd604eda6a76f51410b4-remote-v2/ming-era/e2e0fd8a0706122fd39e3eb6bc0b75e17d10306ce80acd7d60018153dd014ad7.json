[{"title":"四景 其三","author":"朱瞻基","text":"新秋凉露湿荷丛，不断清香逐晓风。\n满目秾华春意在，晚霞澄锦照芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18566,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四景 其四","author":"朱瞻基","text":"池头六出花飞遍，池水无波冻欲平。\n一望玻璃三百顷，好山西北玉为屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18567,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幸史馆","author":"朱瞻基","text":"天命余躬抚万方，丹心切切慕虞唐。\n退朝史馆咨询处，回视文星烂有光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18568,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过史馆","author":"朱瞻基","text":"荡荡尧光四表，巍巍舜德重华。\n祖考万年垂统，乾坤六合为家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18569,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上林春色","author":"朱瞻基","text":"山际云开晓色，林间鸟弄春音。\n物意皆含春意，天心允合吾心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18570,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏撒扇（见梅纯《狷斋日记》）","author":"朱瞻基","text":"湘浦烟霞交翠，剡溪花雨生香。\n扫却人间炎暑，招回天上清凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18571,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"静中吟","author":"孝宗敬皇帝","text":"习静调元养此身，此身无恙即天真。\n周家八百延光祚，社稷安危在得人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18572,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"致仕还乡","author":"杨一清","text":"时光疾箭催人老，先后恩荣世间少。\n虽然私第保余年，每日心悬侍天表。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18573,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"銮舆幸第","author":"杨一清","text":"车驾亲临茂社堂，玺书高挂耀龙章。\n升平宴罢明良会，盛事流传万载香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18574,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拦门劝酒","author":"杨一清","text":"欢饮醺醺出相门，劳卿再四劝金尊。\n南征已定旋师旅，去暴除残第一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18575,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上马留题","author":"杨一清","text":"正德英名已播传，南征北剿敢当先。\n平生威武安天下，永镇江山万万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18576,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"车驾驻润州幸少傅杨公私第欢燕累日恭述六首 其一 镇江府同知严时泰","author":"杨一清","text":"先朝宰辅寓京师，翠辇临门或有之。\n独是远临家食地，无人得似荷恩私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18577,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"车驾驻润州幸少傅杨公私第欢燕累日恭述六首 其二","author":"杨一清","text":"夜深莲炬半烧过，模写神功入咏歌。\n直继诗人《常武》什，下看韩愈颂元和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18578,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"车驾驻润州幸少傅杨公私第欢燕累日恭述六首 其三","author":"杨一清","text":"柳宿垂光应不虚，百花深处设仙厨。\n不愁调膳无滋味，旧日盐梅尚有余。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18579,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"车驾驻润州幸少傅杨公私第欢燕累日恭述六首 其四","author":"杨一清","text":"芳园一日驻龙旂，从此清芬胜旧时。\n想是御香零落在，花神收拾上花枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18580,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"车驾驻润州幸少傅杨公私第欢燕累日恭述六首 其五","author":"杨一清","text":"才宣索句便相催，顷刻吟成烛未灰。\n写进御前蒙鉴赏，亲闻天语叹奇才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18581,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"车驾驻润州幸少傅杨公私第欢燕累日恭述六首 其六","author":"杨一清","text":"夜深花露滴高枝，还许殷勤进寿卮。\n听得侍臣私共语，天颜喜剧倍常时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18582,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"又六首 其一 国子生臣孙育","author":"杨一清","text":"神武威南服，龙舟驾巨涛。\n廑兵宣略远，定乱禹功高。\n日彩浮黄钺，云光动赭袍。\n老臣三稽首，复恐圣躬劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18583,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"又六首 其二","author":"杨一清","text":"海宇承平日，明良庆会时。\n虹光连井钺，绿野绕参旗。\n荷宠星辰近，承恩雨露私。\n还闻天鉴迩，政积在西陲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18584,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"又六首 其三","author":"杨一清","text":"待隐留仙跸，名园异雒阳。\n礼遵周制度，赋奏汉文章。\n树映螭头晓，花迎雉尾香。\n忽闻鸣凤吹，又进万年觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18585,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"又六首 其四","author":"杨一清","text":"三顾承恩渥，回銮此日过。\n绮楼辉宝宇，花浦接银河。\n乐奏鸣球叶，歌传在藻多。\n唐虞今复见，盛德迥难磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18586,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"又六首 其五","author":"杨一清","text":"南阳延帝幄，莘野访臣庐。\n雨骤千军骑，云屯七圣车。\n琼筵张赵瑟，华烛转燕裾。\n史馆行宣付，勋庸合屡书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18587,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"又六首 其六","author":"杨一清","text":"万舞临周宴，清欢一夕同。\n圣情春浩荡，天翰日昭融。\n袅袅金飙度，厌厌玉漏中。\n载歌赓《既醉》，花外已鸣钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18588,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨柳","author":"兴献王睿宗献皇帝","text":"金丝缕缕是谁搓，时见流莺为掷梭。\n春暮絮飞清影薄，夏初蝉噪绿阴多。\n依依弱态愁青女，袅袅柔情恋碧波。\n惆怅路歧行客众，长条折尽欲如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18589,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"飨","author":"世宗肃皇帝","text":"太庙礼成，赐张元辅。\n戊子新正吉，春享祖庙亲。\n祀事欣已成，肃驾回宫宸。\n登辇偶一顾，舆南一辅臣。\n貌奇真才杰，形端气志伸。\n外焉秉贞一，内则抱忠纯。\n诚正辅吾躬，清白饬乃身。\n予喜荷天眷，赍贤作邦仁。\n庶几皋夔辈，望以康斯民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18590,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日即事诗三章送元辅张罗山（恭录一章）","author":"世宗肃皇帝","text":"拂暑金风动衮裳，满天商吹动新凉。\n农家万宝收成后，十里遥闻禾黍香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18591,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"劝学诗","author":"神宗显皇帝","text":"斗大黄金印，天高白玉堂。\n不因书万卷，那得近君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18592,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"燕京杂咏 其一","author":"来复","text":"秋满龙沙草已霜，射雕风急朔云长。\n内官连日无宣唤，猎取黄羊进尚方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18593,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"燕京杂咏 其二","author":"来复","text":"鸭绿微生太液波，芙蓉杨柳受风多。\n日长供奉传新谱，教舞天魔队子歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18594,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蝶恋花 九月海棠","author":"仁宗皇帝","text":"烟抹霜林秋欲褪。\n吹破胭脂，犹觉西风嫩。\n翠袖怯寒愁一寸，谁传庭院黄昏信。\n明月羞容生远恨。\n旋摘余娇，簪满宫人鬓。\n醉倚小阑花影近，不应先有春风分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18595,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉太平 赐学士沈度","author":"李忱","text":"浓云散雨收，花苑内鸣鸠。\n晓来喜见日光浮，暖融融永昼。\n麦苗润泽怀清秀，榴花湿映红光溜。\n田家歌舞尽歌讴，是处庆丰年醉酒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18596,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹧鸪天 赋绣鞋","author":"周宪王","text":"花簇香钩浅浣尘，轻风微露石榴裙。\n金莲自是悭三寸，难载盈盈一段春。\n仙已去，事犹存，阳台何处更为云。\n相思携手游春日，尚带年时草露痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18597,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送常伯昂","author":"陶安","text":"燕云郁嵯峨，形势拱北京。\n土厚人劲毅，慷慨意气倾。\n一有温恭儒，翘然擢奇英。\n夙秉济物志，而无阿世情。\n西江赞风纪，顷步怀廉平。\n岭海涤氛翳，湖湘亦澄清。\n寻登南廌院，爱此霜月明。\n中台有徵书，共说选择精。\n春残柳飞絮，送别金陵城。\n子行勿迟迟，时事方营营。\n平生报主心，不为利禄婴。\n致远自今始，侧耳闻佳声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18598,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"明月生南浦 广州省治南汉主刘银故宫铁铸四柱犹存周览叹息之馀夜泊三江口梦中作一词觉而忘之但记二句云千古兴亡多少恨总付潮回去因檃括为明月生南浦一阕云","author":"张以宁","text":"海角亭前秋草路。\n榕叶风清，吹散蛮烟雾。\n一笑英雄曾割据。\n痴儿却被潘郎误。\n宝气销沉无觅处。\n藓晕犹残，铁铸遗宫柱。\n千古兴亡知几度。\n海门依旧潮来去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18599,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苏武慢 江亭远眺","author":"韩守益","text":"地涌岷峨，天开巫峡，江势西来百折。\n击楫中流，投鞭思济，多少昔时豪杰。\n鹤渚沙明，鸥滩雪净，小艇鸣榔初歇。\n喜凭阑、握手危亭，偏称诗心澄彻。\n还记取、王粲楼前，吕岩矶外，别样水光山色。\n烟霞仙馆，金碧浮图，尽属楚南奇绝。\n紫云箫待，绿醑杯停，咫尺良宵明月。\n拚高歌、一曲清词，遍彻冯夷宫阙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18600,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水龙吟 春思","author":"贝琼","text":"楚天归雁千行，一书不寄相思苦。\n匆匆过了，踏青时节，更愁风雨。\n燕子黄昏，海棠春晓，几番凄楚。\n问谁能为写，重重别恨，算除有、江淹赋。\n尚记银屏翠箔，抱琵琶、夜调新谱。\n芳年易度，沈腰宽尽，白头如许。\n弱水三千，武陵一曲，重寻何处。\n奈无情杜宇，年年此日，到淮南路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18601,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"行香子 芙蓉","author":"高启","text":"如此红妆，不见春光，向菊前、莲后才芳。\n雁来时节，寒浥罗裳。\n正一番风，一番雨，一番霜。\n兰舟不采，寂寞横塘，强相依、暮柳成行。\n湘江路远，吴苑池荒。\n恨月濛濛，人杳杳，水茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18602,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沁园春 雁","author":"高启","text":"木落时来，花发时归，年又一年。\n记南楼望信，夕阳帘外，西窗惊梦，夜雨灯前。\n写月书斜，战霜阵整，横破潇湘万里天。\n风吹断，见两三低去，似落筝弦。\n相呼共宿寒烟。\n想只在、芦花浅水边。\n恨呜呜戍角，忽催飞起，悠悠渔火，长照愁眠。\n陇塞间关，江湖冷落，莫恋遗粮犹在田。\n须高举，教弋人空慕，云海茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18603,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 花朝","author":"杨基","text":"鸾股先寻斗草钗，凤头先绣踏青鞋。\n衣裳宫样不须裁。\n软玉镂成鹦鹉架，泥金镌就牡丹牌。\n明朝相约看花来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18604,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏初临","author":"杨基","text":"瘦绿添肥，病红催老，园林昨夜春归。\n深院东风，轻罗试著单衣。\n雨余门掩斜晖。\n看梅梁、乳燕初飞。\n荷钱犹小，芭蕉渐长，新竹成围。\n何郎粉淡，荀令香销，紫鸾梦远，青鸟书稀。\n新愁旧恨，在他红药栏西。\n记得当时。\n水晶帘、一架蔷薇。\n有谁知。\n千山杜鹃、无数莺啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18605,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"多丽","author":"杨基","text":"问莺花，晚来何事萧索。\n是东风、酿成新雨，参差吹满楼阁。\n辟寒金、再簪宝髻，灵犀镇、重护香幄。\n杏惜生红，桃缄浅碧，向人憔悴未舒萼。\n念惟有、淡黄杨柳，摇曳映珠箔。\n凭阑久，春鸿去尽，锦字谁托。\n奈梦里、清歌妙舞，觉来偏更情恶。\n听高楼、数声羌笛，管多少、梅花惊落。\n鸳带慵宽，凤鞋懒绣，新晴谁与共行乐。\n料应在、楚云湘水，深处望黄鹤。\n天涯路，计程难定，长恁飘泊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18606,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"烛影摇红 帘","author":"杨基","text":"花影重重，乱纹匝地无人卷。\n有谁惆怅立黄昏，疏映宫妆浅。\n只有杨花得见。\n解匆匆、寻芳觅便。\n多情长在，暮雨回廊，夜香庭院。\n曾记扬州，红楼十里东风软。\n腰肢半露玉娉婷，犹恨蓬山远。\n闲闷如今怎遣。\n看草色、青青似剪。\n且教高揭，放数点春，一双新燕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18607,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浪淘沙 寒食","author":"刘炳","text":"石径土墙斜。\n桃李桑麻。\n纸钱飞处乱啼鸦。\n祭馀携酒去，寒食野人家。\n苑树忆天涯。\n遗恨琵琶。\n铜驼衰草卧龙沙。\n汉寝唐陵无麦饭，暮雨梨花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18608,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"满江红 寄水北山人徐宗周","author":"刘炳","text":"水北幽居，抱柴门、一溪寒玉。\n山万叠、青林当户，白云连谷。\n乳燕落红春又晚，柴桑三径多松菊。\n喜新晴、布谷又催耕，秧分绿。\n床头酒，何时熟。\n谋诸妇，明朝漉。\n谩黄鸡炊黍，共邀邻曲。\n旧梦风云销侠气，繁华看破知荣辱。\n系扁舟、钓罢晚归来，书还读。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18609,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"木兰花慢 辛酉九日","author":"刘炳","text":"写长空一雁，又景物、是重阳。\n甚雨暗东篱，数枝青蕊，未放秋香。\n支筇倦登高处，掩柴门衰柳映横塘。\n日暮江声滚滚，西风鬓影苍苍。\n当年歌舞翠红乡。\n一曲杜韦娘。\n曾击碎珊瑚，玉人扶醉，银烛成行。\n回头已成陈迹，早归来茅屋石田荒。\n谩把清樽遣兴，都非少日疏狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18610,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆秦娥 送别","author":"刘炳","text":"溪头柳。\n青青折赠行人手。\n行人手。\n最伤心处，西风重九。\n阳关一曲长亭酒。\n停鞭欲去仍回首。\n仍回首。\n少年离别，老来依旧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18611,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卖花声","author":"黄澄","text":"人过天街，晓色担头红紫。\n满筠筐、浮花浪蕊。\n画帘睡醒，正眼横秋水。\n听新腔、一回催起。\n吟红叫白，报得蜂儿知未。\n隔东西、余音软美。\n迎门争买，早斜簪云髻。\n助春娇、粉香帘底。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18612,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清平乐 其二 题眭履道所画桃花送琴士蒯文达归山","author":"程本立","text":"山翁归去。\n记得来时路。\n雨涨溪泉人不渡。\n花外鸟啼何处。\n人间不是山中。\n高怀都付丝桐。\n一曲瑶池宴罢，春风吹尽残红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18613,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"转应曲","author":"姚广孝","text":"斜日，斜日，门外马蹄声疾。\n林栖鸟尽飞还，霞彩红衔远山。\n山远，山远，莫怪行人归晚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18614,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长相思 寄友","author":"解缙","text":"吴山深，越山深，空谷佳人金玉音。\n有谁知此心。\n夜沉沉，漏沉沉，闲却梅花一曲琴。\n高松对竹林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18615,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卜算子 夹城八景 其三 半道春红","author":"王洪","text":"宿雨涨春流，晓日红千树。\n几度寻芳载酒来，自与东风遇。\n弱水与桃源，有路从教去。\n不见西湖柳万丝，满地飞风絮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18616,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"摸鱼儿 苏堤春晓","author":"瞿祐","text":"望西湖、柳烟花雾，楼台非远非近。\n苏堤十里笼春晓，山色空濛难认。\n风渐顺，忽听得、鸣榔惊起沙鸥阵。\n瑶阶露润，把绣幕微搴，纱窗半启，未审甚时分。\n凭阑处，水影初浮日晕，游船未许开尽。\n卖花声里香尘起，罗帐玉人犹困。\n君莫问，君不见、繁华易觉光阴迅。\n先寻芳信，怕绿叶成阴，红英结子，留作异时恨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18617,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"买陂塘 赋东郭草堂","author":"张肯","text":"爱草堂、带村连郭，门前碧水千顷。\n秋波泠浸遥山晚，青镜净涵眉影。\n沙浦迥，怪隔水渔歌，鸥梦都惊醒。\n时乘小艇，向柳外花边，载诗载酒，独尽漫游兴。\n谩重省，且得身闲心静，乐事自甘瓢饮。\n好怀谁道中年减，佳趣更多吟咏。\n□转径，门正对朝阳，不怕梅花冷。\n流年暮景，肯容我为邻，相依卜筑，共尔两家隐。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18618,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浪淘沙令 咏莎滩","author":"张肯","text":"雨过碧云秋，占断滩头，沧浪翻处湿纤柔。\n谁展翠茵平似剪，宿鹭眠鸥。\n沙尾远凝眸，雨惨烟愁，萋萋不共水东流。\n几度渔人来傍宿，绿映孤舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18619,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉落魄 咏苔","author":"张肯","text":"径翠钿狼藉，绿圆点点浓如积。\n芳痕涨雨凝寒碧，一片浓阴，休扫坐来石。\n径深不教残阳入，茸茸不似春红色。\n芳尘净洗无纤迹，吟客来时，只恐印行屐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18620,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"如梦令 咏石","author":"张肯","text":"径庭掩尘踪静悄，雨长苔痕缭绕。\n行处不妨花，容我醉眠偏好。\n休扫，休扫。\n待积落红多少。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18621,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"声声慢","author":"张肯","text":"雪晴山邬，月冷江皋，岁寒解后相逢。\n携手归来，轻盈一样春容。\n行行□鸣环，暗香霏、缥缈东风。\n弄花手，与安排金屋，共贮芳。\n雅淡暗通心素，笑桃根桃叶，冶艳妖红。\n试问韶华，樽前若个情浓。\n想是乔家姊妹，可人处、清致皆同。\n春正好，淡眉山、愁减几重。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18622,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蝶恋花 苏堤春晓","author":"莫璠","text":"十里楼台花雾绕，宜雨宜晴，山色笼春晓。\n杨柳梢头残月小，海棠枝上犹啼鸟。\n兰帐玉人初睡觉，试问楼前，画舫开多少。\n报道寻芳人起早，紫骝嘶过香尘道。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18623,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蝶恋花 曲院荷风","author":"莫璠","text":"五月凉风来曲院，绿水芙渠，红白都开遍。\n风递荷香情不断，采莲舟过歌声缓。\n醉折碧筒供笑玩，翠盖红绡，高下翻零乱。\n向晚新凉生酒面，六铢衣薄停纨扇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18624,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柳梢青 题秋塘图","author":"李昌祺","text":"落尽芙蓉，收残菱芡，晚色凄迷。\n断荇随流，枯荷折柄，秋满苏堤。\n沙禽自在幽栖。\n极浦外、天连水低。\n粉坠莲房，波漂菰米，烟暝湖西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18625,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浪淘沙令","author":"王直","text":"风暖翠烟飘，残雪都消。\n游丝百尺堕晴霄。\n可惜春光容易过，又近花朝。\n驱马第三桥，芳意萧条。\n竹林浑未放夭桃。\n瘦尽城南千树柳，不似宫腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18626,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"千秋岁","author":"徐有贞","text":"引风搅柳丝，雨揉花缬，蚤过了清明时节。\n新来燕子语何多，老去莺花飞未歇。\n秋千院，蹴鞠场，人踪绝。\n踏青拾翠都休说，是谁马走章台雪，是谁箫弄秦楼月。\n从前已是无情绪，可奈而今更离别。\n一回头，人千里，肠百结。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18627,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]