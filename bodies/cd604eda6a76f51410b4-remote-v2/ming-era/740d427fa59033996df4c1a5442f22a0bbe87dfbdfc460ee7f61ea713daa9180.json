[{"title":"因讲春秋召陵有感再用前韵","author":"程敏政","text":"斜日难回曙影曈，王心消歇霸心隆。\n屈人包匦菁茅问，照眼牲盘歃血红。\n万世纲常尊孔子，一时民物赖桓公。\n东都不是无元宰，谁为天王达四聪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46374,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张一之除临城知县","author":"程敏政","text":"百里封疆古县男，喜君才力正相堪。\n红尘落日淹离酝，黄叶西风促去骖。\n社稷礼成官亦重，弦歌声起化应覃。\n他时不负承恩处，徽国遗书得指南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46375,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻赵孟麟主事移居入城","author":"程敏政","text":"闻说爱山子，移居近入城。\n红尘遥隔路，粉堞正当楹。\n客刺投应便，朝更听最明。\n来朝先定约，携酒慰新盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46376,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题扬州杨成玉太守梅花","author":"程敏政","text":"红紫缤纷落暮寒，贞姿偏耐雪漫漫。\n广陵太守能题品，不作琼花一例看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46377,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题四鸽图 其一 紫褐袖","author":"程敏政","text":"东风开遍蔷薇萼，禁网稀疏罢缯缴。\n珍禽颜色亦可人，紫袖双垂比宫鹤。\n随时饮啄哺两雏，天然母子行相呼。\n抚景令人发三叹，耳畔如闻城上乌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46378,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题四鸽图 其二 白河西","author":"程敏政","text":"海榴花红摇日光，初平石畔薰风凉。\n河西北种不易得，玉羽六月飞吴霜。\n凭谁貌入丹青里，金笼雪衣呼欲起。\n清时恐有放生人，献寿能令相君喜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46379,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题四鸽图 其三 皂套项","author":"程敏政","text":"铁衣玉项双红趺，入眼精神如燕乌。\n太湖峰下立相倚，徘徊顾影怜芳肤。\n几色黄花傍幽沼，一阵西风动寒筱。\n传书能副曲江公，何羡当时上林鸟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46380,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题四鸽图 其四 白点子","author":"程敏政","text":"山茶红香竹青节，掩映驯禽羽毛洁。\n驯禽羽毛生绝奇，墨华点破双团雪。\n朔气吹风肌栗寒，雌和雄鸣随所安。\n群飞寄语莫惊顾，鹰隼宁过花石阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46381,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乡举同年会集武学得请字","author":"程敏政","text":"昔在京闱士，名录亦焕炳。\n偻指十六年，散居星耿耿。\n离合苦不常，相顾惜萍梗。\n薄言酒一卮，温此旧盟冷。\n武庠国东隅，良会惜幽屏。\n矧当履长节，君子受初景。\n居然杂遝来，曾靡费招请。\n乃知同袍人，不啻共庐井。\n笑谈既款浃，丰度益修整。\n辴然觥筹交，纷彼丝竹骋。\n浮生大块中，取乐几俄顷。\n天寒白日速，华烛坐堪秉。\n明明尊俎间，我愿事箴警。\n学哉加进修，仕者效忠鲠。\n务令吾榜人，一一尽苕颖。\n松节坚平生，蔗味期晚景。\n犬马齿最卑，窃禄秘书省。\n悠悠附骥心，阳春愧歌郢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46382,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"先公同年之子二十七人作通家会漫成一律","author":"程敏政","text":"屈指通家四十年，举杯相属意茫然。\n一家兄弟非生客，两世衣冠本夙缘。\n昼短不妨灯继晷，情长那惜酒成川。\n无前胜会从今日，愿保家声作美传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46383,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿仙图寿顺天马汝才通判乃兄汝明","author":"程敏政","text":"祈阊老者推黄发，京兆能官数白眉。\n瑞彩远随南极现，高情那愧北山移。\n黄钟律转知阳复，紫府图成与寿宜。\n看取凤雏昭世泽，不妨鸠杖乐期颐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46384,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送赵文声知博兴县","author":"程敏政","text":"碧云凉吹满林皋，奉檄东行属俊髦。\n百里为民常择尹，一官旌异得均劳。\n河桥秋别犹攀柳，县郭春来莫种桃。\n齐鲁弦歌原接境，看君今日试牛刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46385,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"钱孝子","author":"程敏政","text":"至性由来不易论，两番刲股报亲恩。\n惊心苫块三年阕，入眼羹墙百世存。\n宅里可旌新孝子，弓裘何愧旧王孙。\n此身不尽推仁处，更看城东漏泽园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46386,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵送沈时旸参议提督福建银课","author":"程敏政","text":"上京才喜坐逢君，行省那堪手更分。\n粤地山场今责贡，隐侯家世旧崇文。\n芝书戒晓颁官露，桂楫凌秋动水云。\n此日牙绯应暂别，汉庭香篆待重薰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46387,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送安成刘静洙赴曲江教谕","author":"程敏政","text":"岭南佳处曲江头，喜载青毡作宦游。\n孔殿韶音犹仰舜，汉人经学久宗刘。\n壮颜不逐流年改，化雨能兼宿瘴收。\n学半有功须重惜，礼闱高选待春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46388,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菊庄图为致仕章元益给事赋","author":"程敏政","text":"秋气入墟落，凉飙振疏林。\n繁华坐销歇，一径穿篱深。\n篱东有晚色，粲粲千黄金。\n不随时物变，肯受繁霜侵。\n陶令去已远，寥寥孰知音。\n章君琐闼彦，时名屈当今。\n一朝谢尘鞅，返驾鄞江浔。\n旧社作新主，永日消烦襟。\n年来婴世患，未获穷幽寻。\n念此松桂友，敬使丹青临。\n遥遥岁将晏，采采劳归心。\n黄花故无恙，白酒且复斟。\n一酌为子寿，再酌为子吟。\n天意久乃定，相期肃缨簪。\n花神永结好，冷眼窥浮沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46389,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送都宪左公廷珍巡抚辽东","author":"程敏政","text":"关西声价重提刑，又总行台出帝庭。\n千里封疆当北镇，九边绥服尽东溟。\n皂囊坐遣烽烟息，宝匣长韬剑气腥。\n宵旰分忧在今日，不须崖下勒新铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46390,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"定西侯蒋公筠清轩卷次周草庭都尉韵十绝 其一","author":"程敏政","text":"高轩近北城，幽径折三四。\n中有长琅玕，知人岁寒志。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46391,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"定西侯蒋公筠清轩卷次周草庭都尉韵十绝 其二","author":"程敏政","text":"临池写来禽，坐石呼格五。\n森森苍雪寒，九夏失炎午。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46392,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"定西侯蒋公筠清轩卷次周草庭都尉韵十绝 其三","author":"程敏政","text":"新开八尺庭，迥异五侯宅。\n眼中箨龙孙，无不一当百。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46393,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"定西侯蒋公筠清轩卷次周草庭都尉韵十绝 其四","author":"程敏政","text":"结客总豪俊，诗坛如将坛。\n呼童刻新粉，记取最长竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46394,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"定西侯蒋公筠清轩卷次周草庭都尉韵十绝 其五","author":"程敏政","text":"爱此万玉林，不下筼筜谷。\n时汲井中泉，殷勤溉慈竹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46395,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"定西侯蒋公筠清轩卷次周草庭都尉韵十绝 其六","author":"程敏政","text":"袅袅翻翠云，涓涓净尘思。\n借看来何人，苔阶屦痕二。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46396,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"定西侯蒋公筠清轩卷次周草庭都尉韵十绝 其七","author":"程敏政","text":"虚心能自保，世态非所甘。\n江梅与岩桧，交情澹成三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46397,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"定西侯蒋公筠清轩卷次周草庭都尉韵十绝 其八","author":"程敏政","text":"名园盛韦杜，红紫动盈千。\n何似总戎府，清风兼渭川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46398,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"定西侯蒋公筠清轩卷次周草庭都尉韵十绝 其九","author":"程敏政","text":"将军诚好文，盛世不忘战。\n时对抱节君，孙吴阅终卷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46399,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"定西侯蒋公筠清轩卷次周草庭都尉韵十绝 其十","author":"程敏政","text":"欲待此君醉，窃分凤尾馀。\n他年杀青手，高节为君书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46400,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"贺东宁伯焦公得男","author":"程敏政","text":"珠箔高悬兽锦红，侯门佳气喜葱葱。\n啼声试处知英物，骨相生来有祖风。\n开宴竞投新玉果，传家先拭旧彤弓。\n分明世契非生客，汤饼还叨入会中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46401,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送西邻毛贡士世杰知汲县","author":"程敏政","text":"东社西邻岁几更，恩衔初得令君名。\n禁中晓日辞天仗，客棹薰风记水程。\n石表忠魂留孔篆，山环遗堞抚殷城。\n定多治迹如崔瑗，看取邦人续政声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46402,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送都水姚懋明主事改任南京仪制","author":"程敏政","text":"曾向青源识俊髦，恩除重下为均劳。\n留都官爱新仪部，驿路人迎旧水曹。\n千里长安随日近，万年钟阜入云高。\n宦情乡思谁兼得，莫惜离亭尽浊醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46403,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"播州程氏世泽堂","author":"程敏政","text":"闻说家声自洛中，几年移筑向蚕丛。\n短檠不废箕裘业，一剑长收保障功。\n心吐秀葵知晓日，根蟠乔木自春风。\n等閒庆泽应难尽，长共滔滔蜀水东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46404,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追思旧游寄浙江左时翊参政十绝次草庭都尉韵 其一","author":"程敏政","text":"湖船诗十联，半入烟霞气。\n我语惭不工，居然别泾渭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46405,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追思旧游寄浙江左时翊参政十绝次草庭都尉韵 其二","author":"程敏政","text":"倚棹岳坟庵，碑本见遗墨。\n万古擎天功，高峰峙南北。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46406,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追思旧游寄浙江左时翊参政十绝次草庭都尉韵 其三","author":"程敏政","text":"草满六桥路，依稀放鹤人。\n道傍修竹里，时见一枝春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46407,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追思旧游寄浙江左时翊参政十绝次草庭都尉韵 其四","author":"程敏政","text":"开尊净慈阁，鹅鸭满湖田。\n对岸雷峰塔，亭亭入暮天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46408,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追思旧游寄浙江左时翊参政十绝次草庭都尉韵 其五","author":"程敏政","text":"三生空有石，三竺未成赋。\n徘徊九里间，吟情拂高树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46409,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追思旧游寄浙江左时翊参政十绝次草庭都尉韵 其六","author":"程敏政","text":"天外一峰迥，飞来势未降。\n冷泉亭上立，逸趣洒寒江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46410,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追思旧游寄浙江左时翊参政十绝次草庭都尉韵 其七","author":"程敏政","text":"石屋龙潜处，题名忆长公。\n洞门喧水籥，苔径失西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46411,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追思旧游寄浙江左时翊参政十绝次草庭都尉韵 其八","author":"程敏政","text":"一?龙井寒，未续茶经笔。\n林外忽闻香，僧房焙茶日。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46412,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追思旧游寄浙江左时翊参政十绝次草庭都尉韵 其九","author":"程敏政","text":"山形绕废宫，一凤云中度。\n下见浙江潮，寒声自朝莫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46413,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追思旧游寄浙江左时翊参政十绝次草庭都尉韵 其十","author":"程敏政","text":"忆登保叔塔，举酒别诸君。\n两听春鸿过，相思逐片云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46414,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送马天禄给事赴云南佥事","author":"程敏政","text":"禁钟晓初歇，骑出城东门。\n惜君有远役，相携荐芳尊。\n君本琐闼彦，忠言动天阍。\n起居今十载，廷谢初蒙恩。\n西南万馀里，滇江浩沄沄。\n轺车足时雨，宪节明朝暾。\n丈夫挟壮气，抚此岁月奔。\n红芳漫春色，青松自霜根。\n迢遥古南服，慷慨扶风孙。\n行台知有道，后会须重论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46415,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次司马通伯侍御留别韵二首 其一","author":"程敏政","text":"风流儒雅重分司，先德犹传宋太师。\n学制久非三舍法，教条今过百年期。\n冰霜饱历承家训，桃李深培答主知。\n闻说行台多暇日，馀情还付墨淋漓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46416,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次司马通伯侍御留别韵二首 其二","author":"程敏政","text":"相违不觉又经年，日月真同蚁磨旋。\n养士定知湖学盛，忧时曾说贾生贤。\n一从宪节分江左，几遣书筒到日边。\n大雅寥寥今未作，黄钟应待恊宫县。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46417,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮庆寿寺柬似聪讲经","author":"程敏政","text":"红尘飞不透疏帘，白日行空渐向炎。\n柳絮挟风常滚滚，麦苗经雨倍纤纤。\n上方暂喜朋簪盍，西郭从教酒价添。\n更爱远公能入社，他时有约问楞严。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46418,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送仰进卿给事佥宪四川","author":"程敏政","text":"天子念饥岁，方勤西顾忧。\n川陕本相接，君子可淹留。\n当时文石陛，往往闻嘉猷。\n况兹行台尊，恩言若为酬。\n提印走列府，洗冤及遐陬。\n功名当骏发，壮气横高秋。\n谁云蜀道难，为子歌安流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46419,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽致仕于千户 其一","author":"程敏政","text":"春风吹面雪盈头，已过人间八十秋。\n山戍昼閒惟系马，水村天远独盟鸥。\n周穷义重焚逋劵，知足心长守乐丘。\n身后有人能接武，辕门声价到皇州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46420,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽致仕于千户 其二","author":"程敏政","text":"每过深巷拜仪刑，不觉篮舆几日停。\n醒眼爱留通夕饮，壮心慵展卫生经。\n别来吟发添新白，望里家山只旧青。\n千里生刍嗟莫致，一缄哀些涕交零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46421,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题傅曰川谕德蜻蜓便面 其一","author":"程敏政","text":"五月京华吹旱尘，江乡风物系情频。\n满陂绿水连堤草，雨后蜻蜓不避人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46422,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题傅曰川谕德蜻蜓便面 其二","author":"程敏政","text":"书带青青草似苔，绛驺飞处小蓬莱。\n良工可识词林客，为作朱衣入眼来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46423,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽西庄耕隐章处士同知廷圭之父","author":"程敏政","text":"红云含日照西庄，楚些声中白发长。\n杖履忍看桑柘影，衣巾犹带薜萝香。\n寿于吕尚非侥福，死比黔娄合谥康。\n经学已闻传令子，功名无愧古循良。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46424,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"分得惠山泉送张公实参议还浙江","author":"程敏政","text":"岿然九龙山，下有鸣玉声。\n苍藓络深罅，溅溅流石泓。\n逝人一回首，倒影下空明。\n峰头陆羽祠，俯瞰若有情。\n峰麓听松庵，织竹存遗铛。\n我昔停征车，凭阑濯尘缨。\n一?毛发爽，再饮肌骨清。\n中?乃伯仲，此品宁虚名。\n张公佐浙省，矫矫人中英。\n峻操如隐之，冰蘖相峥嵘。\n泉石岂无癖，所羁在王程。\n官舟忽南下，寻源重兹行。\n怀古应有作，颠崖念苍生。\n龙团笑茶谱，石鼎怜诗盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46425,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨后过文会轩","author":"程敏政","text":"雨后名园我独来，浅红深绿绕池台。\n禽声也乐消烦暑，马首初看净宿埃。\n邻客有期频折简，主人乘兴即衔杯。\n偶然良会须终日，一任残阳下古槐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46426,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送黄岩黄汝彝赴休宁训导 其一","author":"程敏政","text":"浙东经学推黄氏，玉树临风见一枝。\n山邑百年弦诵地，自今应喜得良师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46427,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送黄岩黄汝彝赴休宁训导 其二","author":"程敏政","text":"宫墙遥隔练溪湾，门对青青玉几山。\n分拥皋比应最乐，书声时出翠微间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46428,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送黄岩黄汝彝赴休宁训导 其三","author":"程敏政","text":"孔殿西头企德堂，两贤曾此托维桑。\n衣冠俎豆瞻依处，洛学千年未可忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46429,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送黄岩黄汝彝赴休宁训导 其四","author":"程敏政","text":"温公家世不凡才，六一清风满后来。\n知子教条还易举，頖宫星斗夜昭回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46430,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送宗人德望进士还德兴","author":"程敏政","text":"一宗元自相湖分，雏凤新呈五色文。\n家庆暂应纡綵服，桥名先已识青云。\n冰开水国舟难滞，春入郊亭酒易醺。\n小别重来堪屈指，鹓班风节待超群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46431,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送吴容之进士还歙","author":"程敏政","text":"二月莺花满帝城，手扳黄柳送君行。\n传家旧熟麟经笔，中选新题雁塔名。\n画舫摇春新旅况，綵衣称寿足亲情。\n还乡不久应趋召，重簉鹓行玉佩声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46432,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送族孙凤翔还浮梁兼东其兄徐州同守楚英","author":"程敏政","text":"相违无奈帝城垠，扑面流尘似水云。\n酒兴半生过阮籍，乡情终日仰番君。\n船随贾客行装起，曲爱歌童别调闻。\n路指彭城应问宿，雨中新榻许谁分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46433,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李知事还蜀","author":"程敏政","text":"大夫勋业重先朝，合有鹓雏振九霄。\n几载宦情宣室近，一番离思蜀山遥。\n归帆正藉东风驭，恋阙长悬北斗杓。\n簪绂重来知有日，不须扳柳向河桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46434,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蒲窗清隐为蔡德馨赋 其一","author":"程敏政","text":"石发森森照水寒，绿云摇动紫瑛盘。\n归来不道清如许，疑在君家画里看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46435,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蒲窗清隐为蔡德馨赋 其二","author":"程敏政","text":"叶叶都含淡墨痕，窗前生意蔼然存。\n摩挲九节如堪斸，误遣山童为洗根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46436,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送岳时雍上舍归河间","author":"程敏政","text":"与君倾盖会京华，两见春风陌上花。\n折简故人聊隔巷，攻书儿子亦通家。\n忽传行李腾归骑，满罄离觞泛落霞。\n云路功名消息近，重来双佩看趍衙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":46437,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]