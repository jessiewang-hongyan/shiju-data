[{"title":"奉和朱翁老师病怀三首 其一","author":"尹台","text":"久吟碧草思门径，况对黄昏媚省曹。\n入夜星文回黼阁，经秋云物恋宫袍。\n持衡合兆三阶正，倚杖那思五岳高。\n但使松乔延服食，可容稷契访蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和朱翁老师病怀三首 其二","author":"尹台","text":"忆昨鸣鞭趋晓仗，侧看曳佩领仙曹。\n龙墀乍驻尚书履，凤阁旋纡学士袍。\n地接勾陈珠斗近，天临太乙綵云高。\n悬知数视明光草，不效元庐闭碧蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和朱翁老师病怀三首 其三","author":"尹台","text":"长拟丝纶承帝制，讵论词赋冠儒曹。\n神鳌鳞甲辉宫观，织女机杼绚锦袍。\n岁月幸依经幄静，云霄倍望讲筵高。\n成蹊漫愧随桃李，塞径从谁薙莽蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀","author":"尹台","text":"蓟野秋交朔气深，渔阳上谷莽萧森。\n河关迥带烟尘色，海甸浑迷风雨阴。\n天远芙蓉难独采，露寒兰芷莫先侵。\n腐儒素食惭何补，草阁荆扉日夜心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁酉冬十月雪","author":"尹台","text":"可道去年雪太迟，今年孟月雪丝丝。\n含风窕袅纷成态，向日轻盈密弄姿。\n田畯好占宜麦兆，边人莫动采薇思。\n平南凯奏应今至，破蔡功成是尔时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊一日雪","author":"尹台","text":"腊月一日寒色异，同云四霈雪纷侵。\n咆林豺虎骄应减，入地螟蝗定几深。\n白日八埏浑一象，玄冰九泽冱成阴。\n故山梅柳垂垂发，折赠谁遗寄远心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送彭廷化归云阳","author":"尹台","text":"三月柳花飞禁城，楚南游子别燕京。\n江湖气暖鱼龙动，郊泽春多云雾生。\n五岳奇探虚夙志，三湘长望渺孤程。\n因君浩思横天末，安得吾帆并汝征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送符太仆迁韶州太守","author":"尹台","text":"武水韶山昔政传，中朝人士几君贤。\n花间此佩双鱼出，岭外仍迎五马还。\n漫忆金珂趋晓并，长看玉剑倚秋悬。\n召棠莱竹占今盛，念别无忘寄远篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送高安吴太史侍母南归","author":"尹台","text":"蓬省仙僚别禁庐，新秋綵服傍慈舆。\n晴风白渚遥浮鹢，细雨黄河欲上鱼。\n云引太行千里迅，天悬钜野一帆虚。\n怜余四易长安暑，枕扇无因慰倚闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿姚封君七十","author":"尹台","text":"仲节悬桑阳始达，省郎斑服计趋庭。\n藤衣老卧江门雪，蕊笈閒开笠泽星。\n迟暮看山劳柱杖，逡巡闭户了仙经。\n人间七十古称少，况睹仪鸿在九冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送方雁里理淮狱","author":"尹台","text":"淮海风烟汉节驰，仙郎遥出白云司。\n江湖漫忆同舟日，花鸟还怜并辔时。\n孺子桥荒无旧石，王孙草绿有新祠。\n英雄事业谁长在，访古知悬百代思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己亥出京","author":"尹台","text":"蓬莱宫观九天开，鳌禁星辰接上台。\n岂有文章承帝制，漫令姓字列仙台。\n词垣忝数追趋后，御幄惭叨品校来。\n暂出京门堪涕泪，致身元乏广川才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题崔阃帅竹泉卷","author":"尹台","text":"将军作镇古滁阳，林壑遥分豹节光。\n僻爱石泉鸣绝巘，侧开茅屋倚疏篁。\n千峰雨送寒流急，一径云低暮色苍。\n莫笑祭遵不好武，时平无事借鹰扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别少山水部至吕梁宿酣始解因忆轩中山石有寄","author":"尹台","text":"豪吟别尔看花筑，醉里浑忘下濑船。\n片雨忽听河岸侧，数峰犹忆石梁前。\n误疑五老虚江雾，却问三神失海烟。\n相望彭城成阻绝，令余长兴独翻然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"御史大夫周公旱雩得雨诗示答二首 其一","author":"尹台","text":"数月江帆一雨无，黄沙飒岸野田枯。\n方春众盗愁兼剧，比郡三农困得苏。\n敢爱玄牲将奠瘗，即防白屋转流逋。\n时霖果应南郊雩，一夜云雷土尽酥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"御史大夫周公旱雩得雨诗示答二首 其二","author":"尹台","text":"督府上卿天下无，淮阳出镇怜彫枯。\n忧时隐念悬鱼釜，计国深思入爨苏。\n民有长谣歌惠恤，吏无横索及穷逋。\n霏微更惬千人望，沾沃真成九地酥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"严先生祠堂","author":"尹台","text":"江阁斜阴倒碧流，钓台崛立水云幽。\n图中物色今谁肖，帝侧星文不可求。\n往矣功名成邓寇，时哉心迹合巢由。\n南阳旧识狂奴态，底事犹持谏议留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"衢州大雨涨作","author":"尹台","text":"首夏三衢诸涨发，西安县前江可怜。\n乱流涌树忽失岸，高浪捲花时近船。\n大地且忧及昏垫，巨川欲济那洄沿。\n便应即此乘虚筏，径访群仙赤峤边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龟山","author":"尹台","text":"弋阳龟山天下无，丹梯紫阁含云孤。\n群峰冉冉纷合沓，一水盈盈中回纡。\n五色金芝秘阡术，九文玉笈函经图。\n安得遂挟飞仙侣，高寻石鼎凌神区。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上","author":"尹台","text":"岸曲风烟霁短槎，水楼云日丽清沙。\n雨残乍袅新抽竹，春过犹存未落花。\n黑发何人能解绶，青山是处足为家。\n独怜无事渔竿侣，长卧沧波弄晚霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长沙贾太傅祠","author":"尹台","text":"太傅祠堂何处开，长沙旧宅半荒苔。\n隐思自托三闾吊，痛哭谁知七国哀。\n绛灌在亭能得士，古今当路少怜才。\n请看汉帝何如主，宣室仍虚前席回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东湖草堂","author":"尹台","text":"我爱东湖湖上居，奇山合沓在门除。\n径开蒋诩僻还似，宅效王维胜亦如。\n渚曲秋风群泽雁，槎头春雨聚湘鱼。\n捲帘终日琴书里，天色云光相映虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荆州秋夜","author":"尹台","text":"卧病荆南伤客心，井梧埤竹助萧森。\n开窗忽见昏星变，隐几遥悲序火沉。\n南忆佳人香雾远，北招仙侣綵云深。\n萱花棣萼秋虚映，吟倚孤亭思不禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月二十七日恭谒显陵有述","author":"尹台","text":"象阙高开古郢州，天垂翼轸照南陬。\n群山迥引嵩邙势，众水遥交汉沔流。\n树里云霞飞綵仗，窗中日月閟玄旒。\n小臣百拜遗弓远，怅望桥山松柏秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至郢同乡三臬使集宴因赠","author":"尹台","text":"名藩臬使三贤并，藉甚吾邦昔见稀。\n独夜繁灯张馆宴，清秋凉雾拂仙帏。\n文昌象纬通南斗，执法星芒切太微。\n持轴愿看公等入，早令皇治迈垂衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汉寿亭侯祠","author":"尹台","text":"气结旌旗惨不舒，将军遗恨此荒墟。\n三分割据功谁并，百战河山绩已虚。\n义报曹公辞魏得，心轻陆竖计吴疏。\n至今剟剑留危石，劲雨凌风立自如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟晴","author":"尹台","text":"晚日斜光淡自舒，三湘秋色映船虚。\n天开众岫晴依幔，浪袅孤云影在书。\n得食空怜阳渚雁，藏身欲钓洞庭鱼。\n回帆侧指朱陵近，绝壁长林拟坐予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岳阳楼观洞庭湖作","author":"尹台","text":"万水东奔江汉回，无边秋色洞庭开。\n荡胸云雾晴兼吐，得意帆樯晚并来。\n望阙长悬公子思，登楼谁是仲宣才。\n茅茨漂泊鱼龙窟，满目苍葭楚泽哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨宴岳楼观洞庭湖复述","author":"尹台","text":"危槛高凭万里风，湖天飞雨映冥濛。\n二仪漭荡长波外，七泽回游元气中。\n绮宴疑张龙女宅，瑶弦似听帝妃宫。\n酒阑忽见君山出，髣髴仙鬟亸太空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"累石","author":"尹台","text":"累石南纡一径微，群山回合突成围。\n渚云淰淰初凝旆，江雨冥冥忽在衣。\n唤侣渔舟仍独泛，趁人沙鸟故高飞。\n平生疏豁真成性，散发惟便旧钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"涉汨罗水作","author":"尹台","text":"路绕忠祠叹式微，草深昏国怨萋菲。\n江流似恋夫君至，山木疑怀公子归。\n渔父真能辞浊世，沧浪还可濯尘衣。\n秪怜一曲清湘水，不向西周抱渭矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水寺","author":"尹台","text":"万里秋风吹客衣，江天晚色静霏微。\n白云水寺蝉孤噪，黄叶山房鹊乱飞。\n奉使经年劳馆饩，辞家每夜梦庭闱。\n燕中始出花犹冻，杨柳今疏客未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"资阳潭石矶特奇怪艮斋赵使君招宴即席二首 其一","author":"尹台","text":"独柱支撑何大奇，资潭回抱迥逶迤。\n林悬石阁飞梁袅，径折峰亭曲栈垂。\n四海登游无此地，百年谈笑几今时。\n不妨扶醉留歌舞，并接凉蟾倒玉卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"资阳潭石矶特奇怪艮斋赵使君招宴即席二首 其二","author":"尹台","text":"百丈孤矶耸碧涛，熊幡鸟旆此招邀。\n岩倾讶俯鼋鼍窟，石出疑横乌鹊桥。\n坐久玉绳当户落，酒残银汉向杯摇。\n欲因霞岛辞朱绂，长挟飞仙倚凤箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋云根亭次艮斋使君","author":"尹台","text":"此夜中秋人共怜，况邀岩洞酒杯前。\n楼台近映千家月，河汉遥开万里天。\n玉署相看逢旧侣，瑶台何用问群仙。\n已拚烂醉酬清赏，不惜虚槎挂斗边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"法象岩","author":"尹台","text":"法象奇岩霾古云，平冈峭石突缤纷。\n林含赤岛三花影，洞列丹枢七曜文。\n锦瑟玉笙闻缥缈，金芝瑶草閟氤氲。\n欲寻世外真仙侣，暂狎山中麋鹿群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出法象道林赴周都阃宴集","author":"尹台","text":"雾袅阴萝锦嶂开，石门秋色净仙台。\n不辞关尹青牛访，遥跨将军白马来。\n豪对绮筵探宝铗，醉邀罗袖款金杯。\n酒阑更秉中林炬，为草新题刻紫苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观法象诸岩下眺平麓得石丘隐丛莽中奇甚因命仆夫除秽同周帅取酒酹山神署其名曰岝崿丘移席再宴艮斋旧馆友也","author":"尹台","text":"岝崿一丘七洞连，崛奇千古霾云烟。\n旋驱厮隶斸荒蔓，即为将军排好筵。\n突兀诸峰云际出，扶疏众树席中穿。\n画图焉得王丞手，胜事长令百代传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"衡州雁峰寺宴集","author":"尹台","text":"衡阳七十二峰开，雁入南天向此回。\n吴楚山盘朱鸟出，蒸湘水蹴白龙来。\n僧车自演昙花宇，佛座长尊法树台。\n五岳尚牵婚嫁在，暂将豪兴托深杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上封寺","author":"尹台","text":"路转千峰石栈危，上封云阁半空披。\n乍看西日虚岩落，忽见群星大壑垂。\n海雾四时流户牖，天风中夜振?帷。\n匡床暂傍银河宿，明发颠崖访禹碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"方广寺","author":"尹台","text":"衡岳峰阴方广寺，幽林危刹傍天台。\n水如银叶烟中落，山作瑶莲石上开。\n深夜星河朱栱宿，高秋云雾黑潭来。\n欲辞簪绂堕猿鹤，留记老僧待客回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓望石廪峰欲登不果作","author":"尹台","text":"莲花峰影动参差，石廪天梯袅雾危。\n坐惜阴崖苍藓滑，吟看峭壁紫罗垂。\n谷声昼吼蜚廉窟，云气秋翻霹雳池。\n安得身轻凌绝顶，卧承悬露咽仙芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浙藩紫薇堂燕集","author":"尹台","text":"省署深堂坐竹虚，洒然秋雨集交疏。\n凉随舞叶林中堕，暑向歌筵盏底除。\n宋苑楼台空昔盛，元寮人物岂今如。\n欢娱况属豪华地，合遣群公色笑舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫薇堂山石燕峰岳伯索题","author":"尹台","text":"突兀三峰省后开，背林幽阁转孤台。\n却疑华室中天隐，翻讶秦梁跨海来。\n谷黑得无霾虎豹，崖敧莫遣挂风雷。\n虚窗竟日珠帘捲，咫尺秋云万里回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入云隐诸山作","author":"尹台","text":"地入南高峰益峻，削成无数青芙蓉。\n盈盈一水银河绕，杳杳诸天金界通。\n采药真人不可问，持花圣女应难逢。\n广轮法相俱尘土，净境攀跻聊扣钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秦宫保封丘祠次王侍御二首 其一","author":"尹台","text":"临陴力掎垂围邑，破贼功辉画像祠。\n庭草润含春雨细，阶棠阴转夕阳迟。\n闾阎自此安周甸，父老谁忘睹汉仪。\n二十年前旗帜色，伤心空有野人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秦宫保封丘祠次王侍御二首 其二","author":"尹台","text":"风捲长河水作潮，尚思虎䩨飒金镳。\n艰危不假夷门节，汴洛真瞻马柱标。\n张相功名称益久，韩侯惠爱颂邳遥。\n观风赖有巡方使，为采覃怀白屋谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄龙良卿补黄门给事","author":"尹台","text":"右顺门西旧禁扉，先朝元锁侍臣闱。\n地邻密勿通贤谏，天切丝纶出帝畿。\n短草知酬轩后陛，何人思补仲山衣。\n云霄看尔奇毛逸，搏击功能岂晚违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄西昌陈子虚入制阁","author":"尹台","text":"制阁丝纶召典裁，唐臣旧羡子昂才。\n文章已入黄麻选，雠校应兼缥轴开。\n泽豹藏身聊雾雨，神龙何地不云雷。\n怜余尚滞周南迹，倚剑思君日几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"济上坐浅斋中丞半隐园二首 其一","author":"尹台","text":"济上风烟接九河，中丞勋业此方多。\n不愁浚凿劳轩橇，长恐才贤负罻罗。\n白日林中瞻仗钺，青霄花下忆鸣珂。\n即知诏掌中台近，定许时从禁掖过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"济上坐浅斋中丞半隐园二首 其二","author":"尹台","text":"小结新亭半隐名，林园终日抱虚清。\n台中吏散鸟争聚，花外人稀鹤不惊。\n细水自生秋雨后，片霞恰映晚池明。\n桃源古朴还相似，不羡平泉卉石并。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟病逢圣寿节有感","author":"尹台","text":"忆昨兹辰供奉班，五更华盖侍龙颜。\n朝衣步共炉烟转，舞佩声随扇影还。\n柳底鸣銮回御辇，花边贡马簇天闲。\n只今卧病湮河曲，梦绕鹓行霄汉间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感事二首 其一","author":"尹台","text":"突然散骑满云中，将帅休誇破敌功。\n坐镇已无梁督统，提边谁是石征戎。\n可怜士马空秦塞，即恐烽烟彻汉宫。\n安得本兵深庙算，遍收奇勇策勋庸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感事二首 其二","author":"尹台","text":"扶桑铜柱亦堪危，未说天骄扰汉池。\n虎穴横戈须此日，龙沙拔帜定何时。\n通蛮久绝唐蒙使，凿岭犹烦马援师。\n诸省壮丁输挽尽，无由四海息疮痍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛丑元日早朝","author":"尹台","text":"玉叶葳蕤绚五云，金茎缥缈出层氛。\n风回阁道朱衣过，日射銮轩綵仗分。\n万国并朝王正朔，群公重焕帝仪文。\n小臣拜舞三阳会，愿以康年祝圣君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华盖入侍","author":"尹台","text":"绛炬光繁晓漏催，九天春色动蓬莱。\n旌旗并拂星河入，剑佩齐冲月雾来。\n步辇乍停仙乐引，侍臣先睹圣颜开。\n私惭衮职虚何补，长傍炉烟候曲台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和托斋尚书雨忆浣花堂寓宿之作","author":"尹台","text":"尚忆西岷云气生，犹思昏黑蜀星明。\n虚灯独夜草堂宿，细雨高秋木叶鸣。\n天地名贤空往迹，山川文藻漫含情。\n谁言紫阁青扉梦，长动烟猿水鸟声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河别王民瞻舟中","author":"尹台","text":"潞河三日维双楫，忽漫相逢得汝舟。\n闇闇风尘兼昼暝，辉辉霜日向人流。\n孤弦聊为离筵解，九折何妨壮轴游。\n况是汉廷恩筏宰，普天民力困诛求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘少怜奉使便省","author":"尹台","text":"海国春风白马骄，长天南引使星遥。\n覃怀柳色迎旌转，济汶花光入佩摇。\n万里江山观眺得，百年鱼笋梦思劳。\n知君此去承欢近，迟日高堂绚锦袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊廿日恭上大行皇太后册谥遇雪","author":"尹台","text":"西掖仪成引白麻，诏传急雪忽飘花。\n色摇三殿金觚静，影逐千官缟带斜。\n翻讶玉霄行羽旆，暗悲瑶海断仙车。\n莫令孝笋重抽土，更使宸衷恸物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪后显灵宫即事","author":"尹台","text":"独马閒寻羽客庐，雪风吹我白菟裾。\n冰悬细柏摇珠缀，雾袅深萝羃绮疏。\n昼静虚堂疑斗步，心清妙地惬仙居。\n更看玉壑烟霄外，结绶垂鱼意并疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻林旂峰先生家难有怀二首 其一","author":"尹台","text":"海上三秋白雁疏，昨传消息更愁予。\n成家但立相如壁，坏宅宁存孔鲋书。\n畅志酒杯应料理，端居述作复何如。\n含情漫极天南目，徙倚高台咏卜居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻林旂峰先生家难有怀二首 其二","author":"尹台","text":"解绶风尘意得开，聊思松菊一归来。\n逢时独惜云中守，抗俗谁怜邺下才。\n底用文章矜豹变，须看驾御岂龙媒。\n瑶华断绝闽中使，怅望沙村草阁梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]