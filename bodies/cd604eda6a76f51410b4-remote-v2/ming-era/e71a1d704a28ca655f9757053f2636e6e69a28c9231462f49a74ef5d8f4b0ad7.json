[{"title":"白莲 其一","author":"杨慎","text":"凌波仙子白霓裳，风助精神露洗妆。\n曾向蕊珠宫里见，人间何处有红芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白莲 其二","author":"杨慎","text":"玉立亭亭笑粉光，浣纱人在越溪傍。\n鳞官⾙屋难留住，合上吴王白玉床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白莲 其三","author":"杨慎","text":"风清月皎露华凉，深隐花丛暗递香。\n寄语玉人休折尽，夜深留伴睡鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄远曲","author":"杨慎","text":"濯锦江头烟水绿，相思万里人如玉。\n瑶琴别后不曾弹，今朝才理将归曲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春淇馆会别以道","author":"杨慎","text":"淇水东流生晚波，巴人惜别动燕歌。\n可怜袅袅垂杨柳，奈此迢迢别恨何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄花吟","author":"杨慎","text":"金风滟滟开黄菊，黄蝶茸茸竞相逐。\n千英万蕊艳且香，晚来知向何枝宿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"董坝","author":"杨慎","text":"扁舟孤棹宿枫林，猎火渔灯逼岁阴。\n千里思家回句首，青山江上叠愁心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鱼凫关","author":"杨慎","text":"鱼凫今日是阳关，九度长征九度还。\n何补干城与心腹，枉教霜雪老容颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"摩尼寒夜拥炉有怀冯定水","author":"杨慎","text":"行炉特赠远行人，处处温柔乡里身。\n寒夕赖君生煖热，炭星红喷雪楼春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪关绝粒谕从者","author":"杨慎","text":"仆痡马病漫兴嗟，戎旅华封本一家。\n我骨巳仙元不馁，何须食柏与餐霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冰雪封途马蹄踏之铿然有声","author":"杨慎","text":"积雪层冰路百盘，银杯逐马玉鸣銮。\n老狂不怕玄冬冷，呵手挥毫兴未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠贾东亩","author":"杨慎","text":"兰叟和光卧白云，贾生东亩挹清芬。\n何人为续稽康传，题作杨林两隐君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三题板桥馆壁","author":"杨慎","text":"朔雪玄冬冻不开，仆夫疲病马虺隤。\n鬓毛尽向风尘白，往复滇云十四回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高峣雨中闷坐以果实散诸村童因忆儿辈","author":"杨慎","text":"不为全生狎楚童，自缘嬉戏感衰翁。\n昨霄梦里分明见，让枣推梨在眼中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华亭寺僧德林送山茶花","author":"杨慎","text":"宝地香风吹雨花，林公分送子云家。\n玄亭丈室同岑寂，相望白牛山月斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春帖用宋人四句例 其一","author":"杨慎","text":"离别江阳初饯腊，淹留滇徼又逢春。\n敬恭四海皆兄弟，文字三都尽主宾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春帖用宋人四句例 其二","author":"杨慎","text":"江国梅花头并白，高峣杨柳眼还青。\n八村烟水移春槛，九寺云山借景亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春帖用宋人四句例 其三","author":"杨慎","text":"礼年雪?行天马，上日春还帖户鸡。\n天运盈虚与消息，吾生南北又东西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅会斋惠金晕酒杯","author":"杨慎","text":"药王绕瓷巧制新，红绡金錽?陶巾。\n不须綵绣殷勤捧，花露仙?别有春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠门生杨静夫北上","author":"杨慎","text":"滇海门生廿载遥，飞腾次第上云霄。\n衰年七十犹羁旅，谁向玄亭慰寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二月廿二日饮段宪卿金枢楼","author":"杨慎","text":"金枢楼上醉流霞，何羡扶风豪士家。\n丹砂唱罢初生月，烛剪银台第几花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"毛园萃芳亭与沈中白丘月渚同赋 其二","author":"杨慎","text":"哨声红雀语黄莺，知我名园赏杂英。\n远客应添今夕梦，海棠红湿锦官城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"毛园萃芳亭与沈中白丘月渚同赋 其三","author":"杨慎","text":"额城一别会滇云，花底匆匆酒未醺。\n青殿挥毫应忆我，金梁明月碧峣分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"毛园萃芳亭与沈中白丘月渚同赋 其四","author":"杨慎","text":"酥雨才收又夕阳，参差竹粉映花光。\n流泉石窦停教住，莫放轻飘曲水香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏箐底香花","author":"杨慎","text":"滇海花名箐底香，山矾风味水仙妆。\n琼枝本是天边种，零落遐荒四拾霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月十八日水滨閒步 其一","author":"杨慎","text":"鱼?蚁酒野人欢，且喜春残花未残。\n无事栖栖经半载，出门天地一何宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月十八日水滨閒步 其二","author":"杨慎","text":"杨林今日是昭关，白首拘留未得还。\n渔父浣纱浑不见，断肠今古泪潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪梦","author":"杨慎","text":"梦里江阳荔子单，觉来枕上五更寒。\n含情懒对痴人说，强向杯中觅旧欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病渴汲楼前井花水饮之","author":"杨慎","text":"半夜儿童汲井花，老夫病渴漱云牙。\n八公德水何须问，甘露清泠在我家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月廿三日高峣大雪 其一","author":"杨慎","text":"朔雪如筛密不开，自怜身在乱云堆。\n剡溪纵有王猷棹，中道那堪兴尽回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月廿三日高峣大雪 其二","author":"杨慎","text":"佳句渔蓑怜郑谷，中庭鹤氅立王恭。\n那知执戟杨云老，冻卧孤村积雪中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月廿三日高峣大雪 其三","author":"杨慎","text":"雪满昆池胜画图，长吟独坐兴偏孤。\n何如太白襄阳道，笑坐金鞍挂一壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月廿三日高峣大雪 其四","author":"杨慎","text":"雪中送炭忆前人，欲暖曲身成直身。\n翠柏苍松元自劲，岁寒那肯变天真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"犯星歌 其一","author":"杨慎","text":"金沙江水绕环洲，江岸家家对白鸥。\n渔父长歌僰人曲，盐商爱上白夷楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"犯星歌 其二","author":"杨慎","text":"馀甘结子草交头，暮霭朝岚似蜃楼。\n飞鸟不飞愁羽堕，行人何事远来游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"犯星歌 其三","author":"杨慎","text":"抢垒弓营遍翠微，韦鞲椎髻裂华衣。\n松林雾合腾蛇出，草屋星流暗蛊飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"犯星歌 其四","author":"杨慎","text":"十月妖花红满烟，万家蛮树绿遮天。\n眼中忽见浑相识，梦里曾游瘴海边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兴教寺海棠","author":"杨慎","text":"两树繁花占上春，多情谁是惜芳人。\n京华一朵千金价，肯信空山委路尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有寄","author":"杨慎","text":"宝刀截水恨难裁，玉箸啼春湿未开。\n昨夜阳台添暮雨，梦魂飞过曲江来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"温泉再过怀李仁甫","author":"杨慎","text":"仙源灵液蓬壶境，碧杜红蘅慵照影。\n美人来时寒谷春，美人去后温泉冷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闰七夕","author":"杨慎","text":"闰月新秋重七日，金风玉露夜如何。\n似怜天上佳期少，特遣仙姬再渡河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野鸡坪","author":"杨慎","text":"野鸡坪边饶杂花，幽兰石竹交山茶。\n可怜春色浩无主，徒使骚人恼鬓华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江陵丹中赠田李二乡客","author":"杨慎","text":"朗月寒沙夜未分，玉箫金管醉中闻。\n明朝回首沅江路，愁听清猿和白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫词","author":"杨慎","text":"天上佳人出北方，能骑白马射黄羊。\n玉颜长在金舆侧，笑指青山是妾乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸟吊山","author":"杨慎","text":"鸟吊山头鸟道微，梧叶陨黄青蕧稀。\n九苞文彩谁得见，千古画图知是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉州壁津","author":"杨慎","text":"壁津渔火照江城，城下滩声彻夜鸣。\n寒笛莫吹杨柳曲，故园回首不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马道壁上次韵","author":"杨慎","text":"嘉陵江水碧迢迢，雷吼晴滩雪涌潮。\n岸曲行人愁驻马，清猿声在白云霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十六日游水头 其一","author":"杨慎","text":"易阳门外眺金天，禾黍故宫秋可怜。\n泛泛龙渠通野井，茫茫雉堞入苍烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十六日游水头 其二","author":"杨慎","text":"马跑泉水水西头，当日帝丘成古丘。\n遥见双林青霭合，尚思千骑翠华游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十六日游水头 其三","author":"杨慎","text":"放棹山阴未拟回，酒酣乘兴更登台。\n苍藤古木浑无语，曾见繁华几主来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"食莲子忆师邵","author":"杨慎","text":"锦杯曾醉碧池春，回首风光入梦新。\n今日临池剥莲子，却思池上咏花人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"以来禽果饷煚庵","author":"杨慎","text":"佳果东来濯锦江，楚谣萍实亦堪双。\n王家珍重来禽帖，青李樱桃总受降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"煚庵饷白果","author":"杨慎","text":"霜黄鸭脚折琅玕，结实累累缀蜡丸。\n好比仙家双桂树，一枝留向月中攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄叶道亨","author":"杨慎","text":"欲截珊瑚作钓槎，旋随鸥鸟狎云沙。\n美人不隔他乡月，迁客何妨著处家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书扇","author":"杨慎","text":"墨池波染蕺山云，书尽蒲葵与练裙。\n郎君自爱家鸡好，肯问兰亭王右军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"圣灯寺","author":"杨慎","text":"苍烟丛里圣灯红，火齐萤辉照远空。\n元是枫林霜叶下，露华光泫月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汎舟昆江","author":"杨慎","text":"杜若洲边露气香，更无人语有鸣榔。\n澄潭倒影天涵水，翻觉星辰在下方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得刘郎浦送人","author":"杨慎","text":"吴蜀成婚此水傍，至今江浦号刘郎。\n停桡送客休嘲咏，不是朝云惑楚王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河 其一","author":"杨慎","text":"河上人家杏子花，河边人唱浪陶沙。\n草薰风煖春将半，若亇行人不忆家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河 其二","author":"杨慎","text":"广武城边河水黄，沿河百里尽沙冈。\n麦苗短短榆钱小，愁听居人说岁荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自江川之澄江赠王钝庵廷表并柬董西泉云汉三首 其一","author":"杨慎","text":"通海江川湖水清，与君连日镜中行。\n孤山一点冲烟小，何羡霞摽挂赤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自江川之澄江赠王钝庵廷表并柬董西泉云汉三首 其二","author":"杨慎","text":"澄江色似碧醍醐，万顷烟波际绿芜。\n只少楼台相掩映，天然图画胜西湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自江川之澄江赠王钝庵廷表并柬董西泉云汉三首 其三","author":"杨慎","text":"海螫江蟹四时供，水蓼山花月月红。\n自是人生不行乐，莼鲈何必羡江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沐五华送鸡㙡","author":"杨慎","text":"海上天风吹玉芝，樵童睡熟不曾知。\n仙翁住近华阳洞，分得琼英一两枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贵竹杂咏 其一","author":"杨慎","text":"林云菁雾不分天，清露常如雨线穿。\n百里迥无烟火接，依稀犹似燧人前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贵竹杂咏 其三","author":"杨慎","text":"铜鼓声中夜赛神，敲钗击钏斗金银。\n煚郎起舞姎徒唱，恼杀长征久戍人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贵竹杂咏 其四","author":"杨慎","text":"保甸坡前不可留，盘江渡头惟一舟。\n驱鼋役鹊无奇术，谁是寻源博望侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贵竹杂咏 其五","author":"杨慎","text":"龙马先朝出养龙，御前赐名飞越峰。\n人间神骏宁无种，天上孙阳不易逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙关歌 其一","author":"杨慎","text":"鹫头峰古接仙氛，龙尾泉香石溜分。\n爨妇洗酥凝白雪，樵童叫笛响青云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙关歌 其二","author":"杨慎","text":"清海桥下海波凉，月白霜清木叶黄。\n惊鹞联翩穿远树，沉鱼拨剌避鸣榔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙关歌 其三","author":"杨慎","text":"双洱烟波似五津，渔灯点点水粼粼。\n月中对影遥传酒，树里闻歌不见人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花绝句九首 其一","author":"杨慎","text":"探梅人似放鱼人，只道梅稍粉未匀。\n不向村姑钗上见，那知虚负一年春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花绝句九首 其二","author":"杨慎","text":"村姑只恐是花神，花信前头报早春。\n奇树芳滋休冷眼，好从初地唤真真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花绝句九首 其三","author":"杨慎","text":"庾岭岧亭陇驿遥，梅开忽近岁之朝。\n折来烛下炉前玩，只恐琼枝煖易消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花绝句九首 其四","author":"杨慎","text":"开自多情茖亦香，残英点缀曲堤傍。\n织成白地光明锦，合与无功作醉乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花绝句九首 其五","author":"杨慎","text":"闭户先生何太痴，梅花开遍不吟诗。\n岁寒三友交情澹，却似无怀上古时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花绝句九首 其六","author":"杨慎","text":"么凤丛边鹤膝枝，孤山清梦水仙祠。\n觉来寒影谁能写，苦忆逃禅老补之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花绝句九首 其七","author":"杨慎","text":"夜来偷醉早梅傍，风致何人继陆郎。\n禁酒国中佳节换，樽前谁唤点酥娘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花绝句九首 其八","author":"杨慎","text":"索笑寻檐花不应，被花恼彻为花憎。\n舞筵东望开金盏，渴杀西川杜少陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]