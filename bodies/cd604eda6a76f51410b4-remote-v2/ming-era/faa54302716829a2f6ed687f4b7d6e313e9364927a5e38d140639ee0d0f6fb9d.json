[{"title":"秋后以扇赠人代柬","author":"符锡","text":"爱此清风好，秋来谨笥藏。\n谁知持赠意，元不计炎凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺思二首 其一","author":"符锡","text":"寒日澹无辉，边城戍不归。\n眼穿楼外雁，抆泪向孤帏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺思二首 其二","author":"符锡","text":"碧草照轮辉，王孙何日归。\n愿言厸双鹄，头白共鸳帏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扇面","author":"符锡","text":"空林寒日薄，古道行人稀。\n渺渺烟光外，惟馀倦翼归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹","author":"符锡","text":"千里来看竹，秋风欲动时。\n虚舟元不系，何问主人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"追挽谢都转令岳石厓秀才 其一","author":"符锡","text":"乐公还自好，何预卫郎贤。\n隔世看□玉，还应相照鲜。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"追挽谢都转令岳石厓秀才 其二","author":"符锡","text":"回首蓬蒿里，重吟薤露辞。\n英雄下世久，慷慨欲谁悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事","author":"符锡","text":"江云吹不尽，山雨莫还飞。\n昨日停车处，花枝一半稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阻风","author":"符锡","text":"去日多北风，南薰归正高。\n就边竞帆者，无笑背驰劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"文轩","author":"符锡","text":"金为□书掷，门因远俗扃。\n春风何处入，庭草夜来青。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋江罢钓图","author":"符锡","text":"尽日楚江濆，钓竿把成趣。\n岂不在得鱼，江空且归去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萍乡泛小舟下湘东绝句 其一","author":"符锡","text":"昨日泸溪客，今朝此问津。\n野航吾自惯，一度当寻春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萍乡泛小舟下湘东绝句 其二","author":"符锡","text":"湘春日日雨，湘水夜来高。\n莫道刀舟险，吾尝学自操。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萍乡泛小舟下湘东绝句 其三","author":"符锡","text":"紫蕨长镵老，黄茅野烧晡。\n春风缘瑟缩，桃李自华敷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萍乡泛小舟下湘东绝句 其四","author":"符锡","text":"十里□山路，茅檐五七家。\n机舂人不见，流水自翻车。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萍乡泛小舟下湘东绝句 其五","author":"符锡","text":"贪看滩上凫，回头忽相失。\n何如贪程心，翻恨滩舟疾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萍乡泛小舟下湘东绝句 其六","author":"符锡","text":"萍江即楚江，今日非昨日。\n但见萍江流，不见萍江实。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽花","author":"符锡","text":"幽花不知姓，独绣楚江隈。\n宁为无人见，春风自剪裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凫鹥","author":"符锡","text":"为爱微禽好，河洲尽日闲。\n无因疑过艇，双逐下前湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辰江杂兴 其一","author":"符锡","text":"顽石连云起，洪流触地来。\n不知千万古，谁辟此中开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辰江杂兴 其二","author":"符锡","text":"有路沿云断，无人但鸟呼。\n半山御落日，始觉客怀孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辰江杂兴 其三","author":"符锡","text":"地僻安居蒶，江深隐俗浑。\n剪茅初著土，聚落渐成村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辰江杂兴 其四","author":"符锡","text":"江上采桑女，茅檐还是家。\n山花随结束，各自足生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与僧题墨梅","author":"符锡","text":"怪道枯梅树，天机不解藏。\n如何寒雪里，独著有幽香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小画","author":"符锡","text":"客思閒流水，禅房静碧山。\n草玄如许借，乘月扫松关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蜻蜓","author":"符锡","text":"尺寸蒲苇地，蜻蜓漾日飞。\n不愁秋涨没，早晚欲何依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南风","author":"符锡","text":"薰风滞南艇，何处忆吾庐。\n欲唤北风起，无人为带书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萱草","author":"符锡","text":"满地萱谁种，金花绕北堂。\n儿曹如解道，不遣隐忧长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙戍正月部兵赴南宁道中杂韵 其一","author":"符锡","text":"蕞尔蛮夷长，干天不自量。\n泰山垂压卵，辙擘可能当。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙戍正月部兵赴南宁道中杂韵 其二","author":"符锡","text":"长洲三十里，烟火接戎炉。\n怅望蜂虿穴，何年尽扫除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙戍正月部兵赴南宁道中杂韵 其三","author":"符锡","text":"四望千山合，夹城双水流。\n客行春渚净，不省过藤州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙戍正月部兵赴南宁道中杂韵 其四","author":"符锡","text":"敌忾三千士，功期一箭□。\n相逢鲁连子，不用话封侯。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙戍正月部兵赴南宁道中杂韵 其五","author":"符锡","text":"夜过黄丹驿，朝临白马屯。\n剑歌弥激烈，挥麈共谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44029,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙戍正月部兵赴南宁道中杂韵 其六","author":"符锡","text":"蛮徼缠妖气，王师蔽海濆。\n君看旗旐举，白昼起风云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44030,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌蛮滩 其一","author":"符锡","text":"邕州何处在，滩险说乌蛮。\n一鼓千艘上，三军共解颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44031,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌蛮滩 其二","author":"符锡","text":"天设蛮江险，鸿濛一派通。\n未须论禹迹，疏凿仗神功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44032,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌蛮滩 其三","author":"符锡","text":"西征尔多士，道路莫辞艰。\n不日平南虏，薰风奏凯还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44033,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌蛮滩 其四","author":"符锡","text":"扰扰横州路，征夫意自闲。\n数声秦吉了，一枕乌蛮山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉诸耆民闇浈阳峡路小诗十首 其一","author":"符锡","text":"浈水频封峡，篙师不敢来。\n从今开栈道，拍手上鱼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉诸耆民闇浈阳峡路小诗十首 其二","author":"符锡","text":"江险多逢石，山高少见天。\n徭人寺湾里，昨日又钩船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉诸耆民闇浈阳峡路小诗十首 其三","author":"符锡","text":"饮辟鱼台路，诸君莫道难。\n如今浈峡险，不在牯牛滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44037,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉诸耆民闇浈阳峡路小诗十首 其四","author":"符锡","text":"鋻衢临水便，问铺入山遥。\n子贡倘移得，还因省白蕉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44038,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉诸耆民闇浈阳峡路小诗十首 其五","author":"符锡","text":"嘉祐初开峡，南山岂浪传。\n我来寻旧迹，榛塞兴茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44039,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉诸耆民闇浈阳峡路小诗十首 其六","author":"符锡","text":"绝险方钩栈，图成落此年。\n传通三舍近，功满万人缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44040,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉诸耆民闇浈阳峡路小诗十首 其七","author":"符锡","text":"峡山开辟有，峡路待诸贤。\n举事谋千古，垂名动万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44041,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉诸耆民闇浈阳峡路小诗十首 其八","author":"符锡","text":"良工固难遇，拙匠非谋始。\n胜果君勿忧，自有神人启。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44042,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉诸耆民闇浈阳峡路小诗十首 其九","author":"符锡","text":"大事岂惜费，小人常惮劳。\n劳多功始茂，费重业还高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44043,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉诸耆民闇浈阳峡路小诗十首 其十","author":"符锡","text":"涵谷久寂寥，龙山事辉奕。\n借问当世人，崇虚竟何益。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44044,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十六夜宿石门驿偶忆李正郎小诗一首","author":"符锡","text":"印马三屯去，期人五日旋。\n良宵嘉会阻，塞月好谁员。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44045,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅轩次晋叔韵二首 其一","author":"符锡","text":"名谢梅轩好，当尊梅正开。\n攀花不尽兴，倒著接䍦回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅轩次晋叔韵二首 其二","author":"符锡","text":"美酒倾玉壶，尽日梅根坐。\n醉问把壶人，和靖何如我。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扇面赠南山翁其一得于梦中 其一","author":"符锡","text":"春早天边雁侣，日斜江上园林。\n閒共渔樵问答，就中得趣谁深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44048,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扇面赠南山翁其一得于梦中 其二","author":"符锡","text":"绕屋一湾流水，隔溪数点青山。\n白云有意相待，野老无心自閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44049,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉花阴 送希召赴洛次韵","author":"符锡","text":"绿杨深处游缰并。\n听莺啼不尽。\n红日又西飞，骊驹歌罢，恼乱离人兴。\n叹浮生蜂衙蚁阵。\n聚散何时定。\n愿潘郎去也，花满河阳，回首长安近。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44050,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画堂春 山桐花盛开壬午暮春","author":"符锡","text":"柴门过雨春融液。\n月色桐花香藉。\n梦断晓莺山更寂。\n可谁寻觅。\n曾嫌紫陌同尘，岂畏红芳避迹。\n朝阳鸣凤无消息。\n也应抛掷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44051,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉蝴蝶 怀友","author":"符锡","text":"举目云遥雁杳，玉人何在，不尽悲凉。\n萧萧风雨，秋期又近重阳。\n井梧飘、生憎待凤，篱菊把、孤负传觞。\n黯相望。\n山花山鸟，分付谁行。\n思量。\n南来北往，几翻风浪，几度星霜。\n襟期皓首，素衣何处惹尘黄。\n谢醴筵、先几罔测，抱芳芷、旧恨难忘。\n悄更长。\n关山月冷，梦断潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44052,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"木兰花慢 奉呈介翁阁老依来韵","author":"符锡","text":"天留宰辅侍宸旒。\n开史局、庆重游。\n信綵笔花生，白云篇净，尘断境偏幽。\n伫待玉人来也，熙帝载喜，起入赓酬。\n千古堪传盛节，四民满听歌讴。\n元寮黑发讵容休。\n试抬头。\n看海阔天高，鹏抟鲲运，襟度许悠悠。\n那须个、兴风使浪，皮里著阳秋。\n藉好上林晴日，载醪随处停辀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44053,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉楼春","author":"符锡","text":"天街密信传青鸟。\n恍出尘寰会瑶岛。\n错莫春霄风雨声，繁枝迸落长门晓。\n阳台梦杳凭谁道。\n松萝误惹荣怀抱。\n拟将幽限托朱弦，他生何处同谐老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44054,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"减字木兰花 调送杨原山次桂翁韵","author":"符锡","text":"还来暂去。\n海天踪迹男儿志。\n射影难妨。\n子夜歌残急就章。\n行吟吊古。\n忠悬霄汉心同苦。\n济险惟贞。\n周道还看似砥平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44055,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤栖梧 次韵奉答俨山阁老","author":"符锡","text":"黛眉暗锁针停缕。\n半捲珠帘，默听流莺语。\n往事不堪秋梦断。\n无情几点芭蕉雨。\n鱼雁漫凭传尺素。\n镜掩妆台，枉避纤腰妒。\n机札夜阑忙倒屦。\n懵然回想身何处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44056,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西江月 次韵答前人","author":"符锡","text":"春去漫增閒恼，病馀更爱孤眠。\n浮名浮利总如然。\n生只被他萦管。\n囱草不除夜雨，盆榴半吐朝烟。\n寻常打破鬼门关。\n何是何非堪免。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜迁莺 庆江明府先生荣膺奖擢 并引","author":"符锡","text":"垂帘清昼。\n倩妆点溪山，春明如绣。\n这户弦歌，那村花柳。\n民物总归仁囿。\n禾传九穗登场，麦道两岐呈秀。\n观风使，问循良说甚，汉家卓茂。\n庇佑。\n天锡廉明贤宰父，富贵谦多受。\n荐剡频闻，福星高照，顷见徵车来召。\n平陵谩拟留宽，河内空期借寇。\n君去也，想遗爱难忘，棠阴重覆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜迁莺 驾明府谢君荣膺旌奖 并引","author":"符锡","text":"瘴雨蛮烟。\n伫西风□尽，月满前川。\n水色柔蓝，山光列画，断崖芳树连天。\n试问带牛佩犊，何如凿井耕田。\n争柰得，老布道东西，征讨频年。\n堪怜。\n赖得琴堂分黑白，馀喘并周全。\n犬卧桑阴，雉驯麦垄，古来胜事空传。\n且喜鸮书高荐，行看骥足骧腾。\n从今去，但仙凫迹远，魏阙心悬。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"帝台春 为府学师生送徐太守北觐并引 代君家作","author":"符锡","text":"亭亭物表。\n器宇秋天杳。\n廉明太守，说向吾人，古来稀少。\n清风两袖朝天去，转眼是、凤池春晓。\n好敷陈，兽锦袍新，御炉香袅。\n蓬莱岛。\n莺花绕。\n霜月皎。\n鸡人早。\n伫献绩天颜，渥恩重，谩回首、石城云杪。\n舟楫川途莫道烦，乾坤整顿还须了。\n记取旧门墙，几人归鉴藻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤来亭登睡","author":"符锡","text":"笔峰抓起凤来亭，蓬岛遥传浪得名。\n碧嶂远开千里目，寒江中抱万家城。\n依稀石磴扶云步，愰荡天风落雁声。\n暂假嬉游浑似梦，郡人错比晋山卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西河方舟展试阶同寅往观漫纪一律","author":"符锡","text":"武水民艰涉，方舟此奏工。\n栉比江阔狭，絙络岸西东。\n六六扶拦出，双双表柱空。\n澄波浮彩鹢，疏雨卧长虹。\n拥盖行天上，联鞯度镜中。\n互低人簇马，微曲缆牵风。\n砥石分维壮，晴雷起昼同。\n樵苏男挟妇，市易叟和童。\n阛阓人人便，村墟处处通。\n万缘宁有我，一德敢论功。\n民病难辞责，人言合反躬。\n惼心多伎俩，名德盛帡幪。\n治行渐黄相，威来耻寇公。\n极知名过实，争奈享逾丰。\n引疾宜先避，尊拳免后逢。\n蒙阳遗业在，不负汝归农。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕誉楼宴集","author":"符锡","text":"燕誉楼开武水滨，危拦十二对通津。\n桥头车马时时竞，城上烟云日日新。\n山逗岚光来几席，风含芳润袭衣巾。\n凭高几度情何极，更上芙蓉望北辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月六日吕园观莲值雨戏呈同列","author":"符锡","text":"去岁看花曾冒雨，今年冒雨复看花。\n旧游争似新游乐，晴景何如雨景佳。\n凉飔一天翻翠盖，夕阳半沼弄明霞。\n楼船箫鼓归时晚，灯火通城候水涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将至端峡夏潦阻舟走诗袁滨涯咨进止","author":"符锡","text":"亟来参幕府，遥望隔端城。\n杖钺阻川涨，停舟待水平。\n岛夷宁孔棘，嶂雨聿孤征。\n仃仅昩时事，君当不吝情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44065,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚至端州口号遣怀二首 其一","author":"符锡","text":"峡口二十里，端州半日程。\n洪流天漠接，巨浸市楼平。\n树杪行舟过，檐头宿鸟惊。\n命觞仍散帙，且复寄吾情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚至端州口号遣怀二首 其二","author":"符锡","text":"怪道梧江发，牂牁万里流。\n凭陵摧岸谷，泛滥淼山丘。\n伫望嘉祥集，何知殄气浮。\n天心与物理，茫昩可能求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清远新开峡路南岑吴公命诗纪之","author":"符锡","text":"峡山束水半岭高，鲛鳄扬威风怒号。\n舟航颠顿莽无所，漂溺民命轻鸿毛。\n呜噫嘻峡山之险兮，羊肠折版莫与并，开辟以来无路行。\n大椎控石煅以火，介然坦道疑天成。\n君不见南樯北舵日相竞，夜度飞来了不惊。\n读书高台谁勒铭，神功禹迹不可绝，湛湛寒江流颂声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]