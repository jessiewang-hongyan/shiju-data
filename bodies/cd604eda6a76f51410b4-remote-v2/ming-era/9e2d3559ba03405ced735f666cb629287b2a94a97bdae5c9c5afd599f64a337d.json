[{"title":"送李无锡入为仪部郎教习驸马","author":"王世贞","text":"傅粉何都尉，含香汉省郎。\n礼曹新日御，戚里自风光。\n花邑留驯雉，笙楼引凤皇。\n唯余邑父老，选石慧山忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郭太史美命先生贻诗见投奉和仅得二章 其一","author":"王世贞","text":"策士董江都，骚人屈左徒。\n名高自张楚，才大欲吞吴。\n一字心堪死，千秋意未孤。\n好将疏越调，结鲤向姑苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郭太史美命先生贻诗见投奉和仅得二章 其二","author":"王世贞","text":"吾怜郭景纯，新赋美无伦。\n官阁紬青史，师门得素臣。\n去裁郢里雪，归问武陵春。\n莫结王生袜，虚名恐未真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正月八日即事","author":"王世贞","text":"谷日距元日，风雨正迷离。\n日色何曾见，天心未可窥。\n骨销朋党论，心折夏侯辞。\n早晚林深处，咿咿有子规。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瀫阳公入佐天官兼领翰学赋此送之","author":"王世贞","text":"且莫疑清世，居然表直臣。\n已烦司藻鉴，还复赞丝纶。\n起色江湖浊，封章岁月新。\n须公一砥柱，吾意已沉沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒食于官舍私荐感痛有述","author":"王世贞","text":"晓知寒食节，洒泪荐清酤。\n岁岁悲新鬼，时时恨大巫。\n庭帏两世尽，天地一身孤。\n似有君王诏，青山着老夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林茂才以材之澧州赴华阳王馆","author":"王世贞","text":"调笑辞蛮语，歌呼慕楚狂。\n青箱从建业，朱邸有华阳。\n醴是贤王宠，兰为大国香。\n浮山与绣水，听汝贮奚囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"故人周士昌以宗伯董公书来视余值方倦奕乞一诗而归","author":"王世贞","text":"机心老欲尽，对客厌围棋。\n汝挟孤山授，唯容太傅知。\n春堤几两屐，秋省一篇诗。\n便是饶归计，从人笑数奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈廷尉追送栖霞同叩达上人诗别陈公","author":"王世贞","text":"江淹不怨别，陶令欲披襟。\n为接远公话，俱生无住心。\n林枝却飞盖，涧溜写鸣琴。\n从此猿鸟迹，翛然不可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王学士碧水桥","author":"王世贞","text":"太史藏书所，西林古渡头。\n桥通千嶂碧，溪抱一村幽。\n小径有时合，落花随意流。\n柳梢维不住，身是济川舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄龙君善博士","author":"王世贞","text":"空自三才绝，时违不得骄。\n官仍广文冷，地觉永嘉遥。\n所至宽游目，何妨且折腰。\n黄柑三百颗，好趁越江潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠海上人参五台","author":"王世贞","text":"比丘拟参室利，乞我一诗证明。\n久矣毗邪杜口，其柰菩萨求名。\n清凉自心自造，烦恼不灭不生。\n毕竟都无可赠，别有繻传西行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初得南廷尉报偶成","author":"王世贞","text":"戟门逃暑似蘧庐，忽有分司洛下除。\n世事从呼惯牛马，乡心兼喜得熊鱼。\n未论朱芾堪赊酒，依旧青山好著书。\n厚禄自惭无寸报，主恩前后不曾虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余将赴金陵陜帅董中丞追诗及贶走笔报谢","author":"王世贞","text":"交游垂晚尽时名，谁复醇深似董生。\n得汝片言堪结袜，赠余双案欲连城。\n函关不锁三秦色，天堑长流六代声。\n敢为相思愁道远，建康今是汉西京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈体干太仆邀饮醉翁亭","author":"王世贞","text":"孤亭面面敛青葱，坐语翛然万虑空。\n樵径渐移残照外，商歌忽入暗泉中。\n岩头寂寞诸名迹，石上婆娑两醉翁。\n也解板舆松影好，披襟留试月明风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜偕体干太仆过饮丰乐亭","author":"王世贞","text":"路穷平楚近还疑，忽敞空亭碧四垂。\n延尽绪风仍岸帻，踏残凉月更飞卮。\n催花别按渔阳掺，拂藓仍看幼妇碑。\n莫讶深更未成别，风流今古并吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜过柏子潭恭读御碑是高皇三注矢得雨事","author":"王世贞","text":"金书赑屃耸长空，彷佛神谟大禹同。\n涧底泉鸣疑去镝，峰头月满似弯弓。\n苍藤忽破虬龙影，怪石频穿虎豹丛。\n似觉普天多苦旱，可无灵雨报祈丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过饮陈体干少卿时石拱辰大卿迟一驿未到","author":"王世贞","text":"驿骑关河新雨余，逢君设醴更焚鱼。\n孟公雅自能投辖，内史何当不下车。\n浮白寸心终自吐，乍青双眼未全舒。\n明朝定有新知会，迢递南云日夜疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黎惟敬内翰沈嘉则张幼于诸君过弇州园分韵 其一","author":"王世贞","text":"下马捋须无限情，微言入坐有余清。\n巉岩水落鼋鼍出，峭茜风过鸾凤鸣。\n宾主东南当代事，庙廊丘壑暂时盟。\n中朝若问王廷尉，一曲沧浪寄此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黎惟敬内翰沈嘉则张幼于诸君过弇州园分韵 其二","author":"王世贞","text":"青葱竹柏吐余姿，不似长年摇落时。\n已割溪云充野供，还调涧溜作清丝。\n客缘探隐难言结，心到论文偶自知。\n但许布衣欢十日，未应惆怅问归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠名医盛老","author":"王世贞","text":"先朝奕叶尚医郎，御史中丞蚤雁行。\n时复闭门如泄柳，忽来施药是长桑。\n胡姬惯识弦中语，弟子能传肘后方。\n见说刀圭如可借，野夫那怕鬓苍浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁丑元日试笔","author":"王世贞","text":"今年节物媚吾庐，儿女分行拜起居。\n官兴尽来知骨肉，主恩深处领樵渔。\n屠苏到我春从晚，爆竹由他岁惯除。\n萧散虚窗聊捉笔，可能成就右军书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初正答谢江右潘中丞","author":"王世贞","text":"宦迹流年已并除，词肠酒态未全虚。\n山南东道初辞节，江右中丞再寄书。\n文锦细盘衔草鹘，紫琼新脍带冠鱼。\n莫惊廷尉门犹暖，自是交情古不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石丈自滁穆丈自魏贻诗见慰罢官走笔呈谢并抒近况 其一","author":"王世贞","text":"闲门久矣雀堪罗，忽有双珠拂暮过。\n阴德总输于氏远，交情终比翟公多。\n数拳地借包山色，一曲天留镜水波。\n在昔相思须命驾，可能携手问烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石丈自滁穆丈自魏贻诗见慰罢官走笔呈谢并抒近况 其二","author":"王世贞","text":"初从纳节号闲人，踪迹空劳两地论。\n居魏江湖怀北阙，环滁山水惜孤臣。\n听鸡起候村梅曙，泛蚁偷争野老春。\n如此风光真自好，可容长作半闲身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"莫子良方伯以花朝自感诗见贻率尔奉答","author":"王世贞","text":"短蓬风色昼凄其，诵尔花朝感叹词。\n众卉只知为雨勒，乔松元自得春迟。\n纵今芳意如平仲，已有幽心付子规。\n转眼繁华何足问，祗应商略岁寒时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"莫方伯子良与子云卿追饯松江道中留赠","author":"王世贞","text":"小舫飞觞不厌频，交情父子更谁真。\n青云未晓弹冠意，明月元多按剑人。\n总是众知龙卧稳，也还身睹凤毛新。\n临岐一扇书双美，此日难教谢傅论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太师存翁相公以元旦家燕诗见示次韵","author":"王世贞","text":"山中宰相启初筵，乍有修风绿野前。\n北阙定书南极瑞，老臣亲致太平年。\n尊开四代长宜柏，烛忆三朝旧赐莲。\n见说新诗传欲遍，江南草色已油然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"解任后得明卿罢官报寄赠二章 其一","author":"王世贞","text":"参差尺一谢朝班，回首风尘梦寐间。\n敢谓清时稀白简，居然薄命损朱颜。\n浮云久自深吾辈，春雪犹能近故山。\n世态纷纷何足道，与君偷得到头闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅于鳦先","author":"王世贞","text":"一春孤抱叹无当，行卷初开喜欲狂。\n今日君王应爱少，古时童子解为郎。\n群珠拣尽无鱼目，六翮成来肯雁行。\n莫道李膺门第峻，久容文举独升床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林近夫朝回时返岭外以诗见寄感而有答","author":"王世贞","text":"杯酒沉沉且杜机，新诗一读泪堪挥。\n谁能汉省分凫舄，便向吴山问薜衣。\n客许故情销骨后，自怜前事捧心非。\n封书欲发还多感，纵有梅花驿骑稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶写近况","author":"王世贞","text":"三抛符印返江乡，其奈差池五十强。\n懒胜世情无一可，醒多春夜亦成长。\n文章薄晓才难继，儿女粗安事未偿。\n甚欲掩关抽二藏，天宫净土总茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"旧有诗赠月溪上人将十年今春至吾州讲经毕过我小祇园言别更成一章赠之","author":"王世贞","text":"十年高坐许重登，不向无机说小乘。\n破尽六宗犹竖拂，听来半偈是传灯。\n谈时舍利祥光显，到处军持法雨兴。\n若问中丞何似业，居然退院一闲僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李丈琦自解银台力辞不出读书燕中赋此见怀","author":"王世贞","text":"当年风采动朝端，咫尺天衢行路难。\n金马醒多犹碍隐，银鱼卸却始成安。\n聊从秘术探鸿宝，不为雄心注鹖冠。\n见说郊居新赋就，可能将寄阿筠看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"况吉夫大参以长笺长律见期读史记有感而答","author":"王世贞","text":"鸿书忽自豫章天，读罢捻须一莞然。\n续汉中郎空见许，过秦新论有谁传。\n君怜竹素将来日，我在雌黄未定年。\n何似扫除千古障，争名空室坐逃禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宗良国将以近作见示且致知己之感有答一章","author":"王世贞","text":"行卷初开喜欲狂，看来字字挟风霜。\n那从帝子鸣銮玉，且学书生看屋梁。\n忆旧明珰投汉渚，怜才清梦绕吴阊。\n知君岂少南州誉，误信王生齿舌香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德甫居太夫人忧致诗见慰悲激用壮聊成一律为答","author":"王世贞","text":"癖懒归来白发侵，故人清问一沾襟。\n不知鸡骨支床日，能作龙渊滞狱心。\n变尽浮云庐岳在，涸残秋水大江深。\n与君但解逍遥意，何事区区梁父吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"父国尉以乃叔用晦书介绍投诗见褒有中兴大雅语率尔答赠","author":"王世贞","text":"新诗藉甚美清扬，汝叔书来许雁行。\n已是入林同小阮，还应赌墅似中郎。\n文高龙种偏堪识，禄薄牛车也不妨。\n莫向中兴论大雅，老夫名姓欲深藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巍父佳父二国尉合书及诗见寄极有龙门之思因及于鳞怅然有怀奉荅时舍弟方按部其地","author":"王世贞","text":"并马翩翩过酒胡，子侯腰玦有珊瑚。\n青萍对结雌雄斗，石笋双抽大小孤。\n笛里悲风追济上，琴心流水到姑苏。\n不须惆怅登龙远，曾试吾家阿敬无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答用晦丈时有三诗极为余致不平之感且订后期","author":"王世贞","text":"高枕怀人忽黯然，西江尺素自鸿边。\n无言白璧偏堪点，何处朱弦不可怜。\n纵酒此生终得计，论文它代别为权。\n与君商略嵇康驾，紫气湓城在几年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏行园有怀敬美弟南康","author":"王世贞","text":"清和时序雅相宜，阿惠那能读我诗。\n行遍池塘犹是梦，听残丝竹未成篪。\n香垆可作斋中物，石镜谁临画后眉。\n翻恨双鸿毛羽就，北风吹断各天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余燕中别宋廷尉望之今十七年矣公秉钺吾邦余谢病归里虽讯问时及而竟睽握手乃成一诗奉怀适太学张恒思以画索寄漫题于首","author":"王世贞","text":"差池握手愧初盟，十七年来何限情。\n念我和歌无宋意，知君结袜少王生。\n棠阴转傍华阳馆，柳色仍围幕府城。\n不是逐臣多落魄，可知吴市易逃名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"程京兆汝懋视余少长别燕中者三十年矣余自郧入留棘谓得相从而竟以言罢方成一诗奉怀适太学张恒思携画索寄漫题于首","author":"王世贞","text":"何堪屈指看花时，并有霜华上鬓丝。\n宦迹乾坤垂欲尽，世情离合本难期。\n丹阳刘尹多佳话，京兆张郎不妩眉。\n若问同袍辞节后，酒垆茶榻解支持。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初遇子与方伯昆山旋尔言别赴任江右","author":"王世贞","text":"马鞍山脚乍停船，黄鸟嘤嘤到酒边。\n我自一翁安避地，君还四岳近朝天。\n初完赵璧披云出，忽折吴钩向斗悬。\n蓄念千端那可尽，不如相对坐陶然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汪惟一得古印摩之易其文曰五湖长见赠","author":"王世贞","text":"籀迹秦章手自摩，刻刓翻拟赠潜夫。\n毋论此掾同三语，且爱新衔长五湖。\n到处酒旗成卤簿，见来渔父是官徒。\n如闻尚有风波事，一榻禅房署苾刍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠顾生","author":"王世贞","text":"里门冠盖学天津，南阮由来不厌贫。\n从他废箸儿曹事，似汝淫书我辈人。\n沼上墨花堪染练，阶前带草欲成茵。\n肯为辟疆容径造，那将蜡屐比朱轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李文正吴文定诸学士于海月庵赏十月菊五七言律俱以前用骑字押和颇成险窘余戏悉为步之","author":"王世贞","text":"贪看晚节傲霜飔，淡色幽香冷不辞。\n入坐叵罗争自引，归来款段未须骑。\n推敲月下犹孤语，竞病风流彼一时。\n若使东篱主人在，攒眉那肯和新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺张太史","author":"王世贞","text":"天上张星傍斗悬，凤池春色凤毛偏。\n久闻伊陟能光后，共道周公许拜前。\n从此玉堂添气象，几人金殿领勾传。\n承家故有丝纶在，续史何劳慕马迁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠史金吾","author":"王世贞","text":"看君真作韫川珠，袭坐春风况不孤。\n家世旧传南史氏，禁廷新拜执金吾。\n门无下客歌弹铗，诏为名儒掌唾壶。\n最是将台寻礼乐，未须终夜读阴符。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题潘中丞芝林时昆山书院成芝满于林故以名焉","author":"王世贞","text":"数尽潘园赋众芳，何如神草被昆冈。\n庭中玉露漙三秀，木末丹霞散九光。\n出共箑蒲昭圣瑞，归同天韭作仙粮。\n野夫亦有黄公癖，地肺何年许并藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送子与方伯赴江右任兼怀德甫用晦二君","author":"王世贞","text":"双旌宛宛向洪州，斗色虽遥渐可求。\n定有征君堪下榻，那无帝子共登楼。\n西山南浦来尊外，紫电清霜满案头。\n屈指三朝词酒客，几人方岳领诸侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石湖遇朱在明小饮将别邀过虞山吴氏馆","author":"王世贞","text":"南薰徐入芰荷裳，小艇遥停喜欲狂。\n双眼忽分湖上碧，五言能借岭头苍。\n从他兴尽难回棹，念汝情深好对床。\n见说虞山多胜事，相携且踏少年场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢襄王存问一首","author":"王世贞","text":"纳节归来万念荒，祗残清感渚宫傍。\n能从蜀肆沽醽醁，为有梁园赐鹔鹴。\n忽尔佩兰贻帝子，可还乘雨报君王。\n襄江正是沾恩地，流到中吴始见长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿王太常有壬","author":"王世贞","text":"乌衣江左数诸王，谁似三朝老奉常。\n家有鱼须丞相笏，囊余鸡舌侍臣香。\n看山偶尔施双屐，避客犹能挂一床。\n屈指旧京鹓侣在，可容时进百年觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"敬美弟有荅予寄怀之作适以奉贺归倚原韵为赠","author":"王世贞","text":"十年岐路感商星，见和新诗未忍听。\n幸自归家同社燕，还将握手慰原鸰。\n南金价重留成镜，云母恩深宴作屏。\n莫以微涓夸湛露，高阳初酝若为醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏寄吴生","author":"王世贞","text":"我爱髯公气谊深，长因任侠贱黄金。\n裁成艳曲呼如意，教就明童字称心。\n歌管时停星桧底，酒船多在尚湖阴。\n东邻更有陈遵在，失却鸾篦好易寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"殷无美余故人也东归之后贽而强纳拜焉辄成以赠","author":"王世贞","text":"一归初就已忘言，三径虽荒好避喧。\n罗雀汝宁廷尉客，登龙吾未李膺门。\n云披胜览堪双出，海踏狂探试共论。\n若语抗颜专席事，至今犹愧古人尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张见甫以腊月见访明岁之夏复走使讯问感而有寄","author":"王世贞","text":"破腊轻舠问五湖，冲炎信使走长途。\n谁能作伴门前雀，汝自差怜屋上乌。\n洛下寺碑堪小语，江南匣剑已全孤。\n何时更拟平原会，紫气从他看有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送成伯鸿胪还朝","author":"王世贞","text":"斋舫纷纷秋色间，几人符传扣天关。\n仍参豹尾君王仗，亲缀蛾眉将相班。\n望里金茎仙作掌，墀端玉笋品为山。\n交游倘及归田叟，洗墨分甘未尽闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠汪生象先","author":"王世贞","text":"父客吴趋一见寻，翩翩公子更词林。\n才清似得颜延笔，橐在全无陆贾金。\n偶自履霜宁入操，居然爱日有余心。\n衡门幸少孤臣泪，浊酒新凉取次斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠刘生","author":"王世贞","text":"百战侯封表赐茔，庐山一一仿长平。\n清朝戢武留颜色，白首降羌记姓名。\n敢谓文章归阿士，于今意气少刘生。\n燕然尚有将军石，倘许如椽再勒铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]