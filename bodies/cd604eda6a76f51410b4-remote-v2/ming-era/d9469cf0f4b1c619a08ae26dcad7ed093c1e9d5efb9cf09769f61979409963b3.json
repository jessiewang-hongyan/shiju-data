[{"title":"寿郭光山太仆","author":"董其昌","text":"亢村自昔产人豪，吏部文章北斗高。\n卿月辉辉膺异数，晨星落落此同袍。\n壮猷不尽汾阳意，雅量宁虚郭泰褒。\n闻说还丹有真诀，不令青鬓点霜毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀总宪张华东","author":"董其昌","text":"归舟初逗广陵涛，却忆联衡意气豪。\n执法星占三独坐，人伦月旦九方皋。\n谈深漏下更银烛，壶尽墙头过浊醪。\n如此风尘论交态，何殊猿鹤共蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿唐母吴太君六十","author":"董其昌","text":"唐家恊相汉图章，曾向宫端进寿觞。\n庭际种兰思谢传，吟边泛柏拟共姜。\n凤毛等是金为友，鹊起终看玉作堂。\n顾我词林旧宾客，怀清无复感沧桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史四首 其一","author":"董其昌","text":"汉家经岁事和戎，綵缯曾无到后宫。\n怪底蠲租仍有诏，非关时令易为丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史四首 其二","author":"董其昌","text":"鸣珂共赴午朝时，宿卫环罗退食迟。\n若道传餐非盛事，恰如成败论行师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史四首 其三","author":"董其昌","text":"金华殿里是崆峒，分直谈经礼数崇。\n为问君门千万里，儒臣何路向重瞳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史四首 其四","author":"董其昌","text":"赤地三年一妇冤，海东连坐又何言。\n土龙不解行霖雨，日表应须照覆盆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读华严合论偈","author":"董其昌","text":"帝网明珠遍刹尘，都来当念两言真。\n华严论主分明举，五十三参钝置人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读寒山子诗漫题十二绝 其一","author":"董其昌","text":"声色无端不我期，缘心应处亦如之。\n若人欲走无生国，除却斯门总路岐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读寒山子诗漫题十二绝 其二","author":"董其昌","text":"六根选择耳圆通，窍在无思自应中。\n此观若成何以验，人嘲人赞响排空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读寒山子诗漫题十二绝 其三","author":"董其昌","text":"儒衣僧履道家巾，三教无依是此人。\n馀子纷纷立门户，长空不倩扫埃尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读寒山子诗漫题十二绝 其四","author":"董其昌","text":"怪底前人忒受瞒，一生知破几蒲团。\n争知信得迷时及，随分阿鼻与涅槃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读寒山子诗漫题十二绝 其五","author":"董其昌","text":"勋业终归马伏波，閒身孰与钓台多。\n金刚圈子才吞却，百劫熏修不奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读寒山子诗漫题十二绝 其六","author":"董其昌","text":"接得西来最上机，一生须及尽玄微。\n但言顿悟无修證，热病教君失转依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读寒山子诗漫题十二绝 其七","author":"董其昌","text":"种种纲宗是卦文，吉凶请向自家论。\n若言密室传心印，辜负当天月一轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读寒山子诗漫题十二绝 其八","author":"董其昌","text":"家资了□□湘流，太华山边撤石头。\n个是学人真榜样，深闺儿女漫悠悠。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读寒山子诗漫题十二绝 其九","author":"董其昌","text":"羽士争谈不死方，到头若个免无常。\n神仙留下真丹诀，先取生时死一场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读寒山子诗漫题十二绝 其十","author":"董其昌","text":"千树青松养圣胎，常年石户不关开。\n山中莫道无俦侣，片片閒云自往来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读寒山子诗漫题十二绝 其十一","author":"董其昌","text":"举著空宗便道无，如盲说象太模糊。\n请君自对秦宫镜，两道眉毛历历孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读寒山子诗漫题十二绝 其十二","author":"董其昌","text":"赤骨萧然巳露形，更堪橐盖逐狐精。\n年来赌去千金駮，但任跛驴三脚行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送唐元徵太史二首 其一","author":"董其昌","text":"乘轩百道拜行尘，不独奎章昼锦新。\n江左流离诗里画，寰区人物眼中筋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送唐元徵太史二首 其二","author":"董其昌","text":"平生温饱笑人痴，练到风尘更不疑。\n君向世流真砥柱，许吾一面佐偏禆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送楚方伯薛青雷","author":"董其昌","text":"柳绿花明出楚都，晴骄衣綵散春芜。\n何人不咏南陔句，解印惟看此大夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35497,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送冯咸甫","author":"董其昌","text":"画里拈将楚客词，登山临水送新知。\n苍苍葭荻三千里，尽是怀人入梦时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35498,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张了心归楚二首 其一","author":"董其昌","text":"蓬窗听雨夜迢迢，谁遣尊前慰寂寥。\n楚畹众香都好在，尧阶瑞草不曾凋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35499,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张了心归楚二首 其二","author":"董其昌","text":"来雁霜天楚客归，野情祗受薜萝衣。\n只今白社詶裴迪，绝胜朱门荐陆机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35500,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"范长倩偕隐天平山居四首 其一","author":"董其昌","text":"百叠松篁绕画楹，羊肠峻坂划然平。\n愚公践华差如意，金母升天亦有行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35501,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"范长倩偕隐天平山居四首 其二","author":"董其昌","text":"滇海奇游万里馀，天平楼阁化人居。\n鹿门不独偕庞隐，彤管犹闻续汉书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35502,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"范长倩偕隐天平山居四首 其三","author":"董其昌","text":"不羡金茎去日边，龙文双剑鹿台前。\n摄将维室三千界，奏取唐山十五篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35503,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"范长倩偕隐天平山居四首 其四","author":"董其昌","text":"连峰仄径斸云根，只尺星辰若可扪。\n能赋五噫专五岳，此中端合唤皋门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35504,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄叶台山宗伯留都","author":"董其昌","text":"鸥友鲈乡两不猜，石城秋霁净飞埃。\n最怜六代风流地，重有