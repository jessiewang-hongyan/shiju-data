[{"title":"归宗山籁一百四首 其二十二","author":"释函是","text":"行行自行行，性住步常轻。\n一往知何事，周遭空复情。\n鹤鸣还子和，鱼乐果谁明。\n久矣忘渠我，何须辨浊清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其二十三","author":"释函是","text":"心知非一一，林木自森森。\n不识云烟幻，惟同岩壑深。\n枕窥明月白，溪近野棠阴。\n绝迹何云易，谁从行处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其二十四","author":"释函是","text":"一条云路直，千顷野田平。\n湖气干霄汉，松涛引梵声。\n山深不数夏，僧老渐忘名。\n吾欲从兹去，相将混耦耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其二十五","author":"释函是","text":"山云时出没，溪水日平漫。\n世外无拘束，人间有易难。\n屋疏宵不寐，肺病午方餐。\n野鸟真堪近，喃喃不畏寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其二十六","author":"释函是","text":"出门遂觉远，仍在此山丘。\n独自有馀乐，于人无复求。\n绿畴眠白鹳，赤土涂黄牛。\n所向何曾异，从生至白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其二十七","author":"释函是","text":"茅堂饮啄惯，不愿朱门多。\n林下拾朝菌，池边赏晚荷。\n无人常独立，有兴忽长歌。\n恃此能无病，兼之遣睡魔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其二十八","author":"释函是","text":"目前生意满，到处野情疏。\n藤挂偷梨鼠，苔沉入涧鱼。\n农夫忙播种，稚子懒观书。\n旷大劫来事，悠然见太初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其二十九","author":"释函是","text":"山池荷未放，忽已过端阳。\n花木宜天暖，人情耽夜凉。\n去年苦不雨，今夏满方塘。\n预卜秋田稔，可能无再荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其三十","author":"释函是","text":"主人有逸兴，招我坐龙潭。\n危瀑乘风下，平流倒日涵。\n纵观心欲一，细听耳成三。\n明日端阳节，携筇返故龛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其三十一","author":"释函是","text":"是非何日已，同异百年身。\n了此不相顾，何劳问幻真。\n天高云出没，林阔鸟疏亲。\n秋草自衰变，西风宁与人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其三十二","author":"释函是","text":"山深气序易，六月著寒衣。\n酷暑不终日，轻飙时到扉。\n欺人夜色冷，落涧泉声微。\n久矣忘艰苦，谁为别是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其三十三","author":"释函是","text":"年来无彼我，谁谓匪心安。\n古道于今少，人情到此难。\n鹏飞六月息，鹪寄一枝寒。\n相笑何时已，逍遥海岳宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其三十四","author":"释函是","text":"山岚朝不散，水雾午犹遮。\n地僻惟僧到，县贫无药赊。\n崖头悬拄杖，石上晒袈裟。\n只此自知处，须怜日易斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其三十五","author":"释函是","text":"山远有猿噭，溪深无水声。\n夜来云际火，照见古湓城。\n微月入林浅，归鸦到树轻。\n心间纡暝色，含盼不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其三十六","author":"释函是","text":"别去三千里，传来一纸书。\n王家增佛日，山叟爱吾庐。\n华屋少年侈，茅檐老景舒。\n仰人殊未易，服食倚耕锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其三十七","author":"释函是","text":"閒心山事夥，堪见不堪云。\n鹤照池中影，人行岭上云。\n林交容马过，池阔到村分。\n日夕疏钟起，谁从定后闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其三十八","author":"释函是","text":"懒眠常竟日，纸被喜新成。\n门外无人候，床头有鼠声。\n鸟来从自去，雨过不知晴。\n寄语朝中贵，能无此夕情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其三十九","author":"释函是","text":"莫道丹霞热，鸾溪热有馀。\n云高峰顶薄，雨少柏阴虚。\n树密风过岸，篱穿日照庐。\n但除心里火，随分且耕锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其四十","author":"释函是","text":"百岁行过半，全身托翠微。\n犹嫌刍食恶，更觅菜羹肥。\n过午金仙训，忧贫鲁士讥。\n我心真匪石，抗手谢同衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其四十一","author":"释函是","text":"只今惟守拙，闭户逊时贤。\n身退名何在，情穷道不迁。\n朝看云里岫，暮听竹边泉。\n与众同居止，降心一味禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其四十二","author":"释函是","text":"匡月入湖小，千波影共圆。\n月光不到水，水月岂从天。\n对镜看群岫，依林数过船。\n个中谁是主，敛目独澄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其四十三","author":"释函是","text":"自笑生涯拙，犹能不怕穷。\n就泉惟酌茗，移榻爱当风。\n到老凭谁力，千峰一策通。\n不知人事易，随意任西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其四十四","author":"释函是","text":"湖水连天白，登高见远帆。\n肝肠付寥廓，形影托松杉。\n心在何劳圣，情忘莫厌凡。\n一般孤月迥，容易住层岩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其四十五","author":"释函是","text":"山鸡半夜鸣，月落溪云生。\n坐久悬灯暗，门开宿鸟惊。\n何人于此得，独自绕檐行。\n三十年前后，松涛一样声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其四十六","author":"释函是","text":"祇园临大路，独立数晨宵。\n官树贫人斫，春田野火烧。\n云封当涧屋，月暗近山桥。\n夕鸟催归客，松林断续招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其四十七","author":"释函是","text":"祖意在山边，水牛眠野田。\n深知黄叶趣，不坐白云禅。\n鸠唤栽秧雨，风牵上水船。\n此中无限意，肯向外人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其四十八","author":"释函是","text":"山食只粗粝，怜予谢少年。\n岂当为苦节，贫贱得安禅。\n多病偏宜澹，无缘但听天。\n相从忘岁月，始觉及门贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其四十九","author":"释函是","text":"兴来谭往事，相逐过西溪。\n解意忘前后，因人有笑啼。\n语諠山岳静，树远夕阳低。\n微月挂檐隙，回途尚不迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其五十","author":"释函是","text":"故山几日别，临崖一指间。\n依然丹岫月，只度大庾关。\n饮水知源远，耕田傍寺閒。\n老年筋力少，不敢畏痴顽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其五十一","author":"释函是","text":"院后遗残屋，吾师旧掩关。\n湖光先日照，塔影驻云间。\n对此无馀说，秖应时往还。\n且教■子住，予欲老投閒。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其五十二","author":"释函是","text":"理策随身去，行行过石桥。\n夕阳悬树杪，山犬吠藤条。\n认得灵溪路，曾无道士招。\n玄关予亦透，但不上青霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其五十三","author":"释函是","text":"独唳不堪闻，孤松影到曛。\n落虹摇浅濑，归犊出深云。\n顾我当奚似，于人何可云。\n古来多显达，垒垒见高坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其五十四","author":"释函是","text":"身在难忘世，机停始见山。\n龟蛇知雨至，鸿雁及春还。\n月出胸怀爽，霜飞道路艰。\n层峦与孤屿，能得几人閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其五十五","author":"释函是","text":"目前谁是客，梦里悟多身。\n莫辨客中主，宁知身外人。\n西风飘一叶，万木敛三春。\n启我惟秋色，优游林下真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其五十六","author":"释函是","text":"尽言黄独美，难得白云横。\n岂是一生事，都酬旷劫情。\n钟敲霜叶落，雁叫碧潭惊。\n不了目前意，空怜道者名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其五十七","author":"释函是","text":"密树连云暗，残荷杂草香。\n心孤寄水月，年迈历秋霜。\n世有高僧传，人无辟谷方。\n方知林下士，多半为閒忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其五十八","author":"释函是","text":"群岫当轩入，寒泉到枕边。\n何须更举足，只在此中眠。\n睹影日中鸟，闻声梦里蝉。\n萧条自岑寂，莫与懒人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其五十九","author":"释函是","text":"黄叶纷纷坠，白云片片飞。\n只闻辞社燕，不见捣寒衣。\n世故山城远，清秋霜露微。\n野人无感激，寂寞掩柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其六十","author":"释函是","text":"三日松风生，五天檐雨声。\n此时大麦熟，秋谷仓箱盈。\n荒后人心约，安贫势利轻。\n世间与世外，何事不相成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其六十一","author":"释函是","text":"秋原怀远踪，想像正无穷。\n问路草初白，遥山叶欲红。\n销磨云水里，俯仰客情中。\n洒拂禅房静，还家听塞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其六十二","author":"释函是","text":"一觉开门出，月明才四更。\n江流浮夜色，石濑引秋声。\n敛听忽何有，冥心合太清。\n谁当更复忆，不可号无名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其六十三","author":"释函是","text":"五更山吐月，四望空无云。\n树转西峰影，风斜北雁群。\n上关仍就榻，稍坐见微昕。\n世事惟高蹈，关河了不闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其六十四","author":"释函是","text":"柳叶夏已长，稻花秋更齐。\n山门无一事，寻伴步西溪。\n老鹳认人惯，田鸡过午啼。\n村夫知雨至，指树觉天低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其六十五","author":"释函是","text":"菊花开灿烂，溪水日潺湲。\n不睹黄云暗，焉知白露繁。\n稻粱迟社燕，茗盌对山村。\n回首成衰迈，还应望石门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其六十六","author":"释函是","text":"出栊金锁鸟，杀羽向山丘。\n不啄黄金盌，空栖青树头。\n往还愁俊鹘，居止学巢鸠。\n长翮虚空阔，高低纵晚秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其六十七","author":"释函是","text":"何处堪栖息，烟霞隐梵宫。\n鸟摇篱菊嫩，犬吠夕阳空。\n问世无成策，安心只是穷。\n老僧惟有退，含笑委长风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其六十八","author":"释函是","text":"满目无山水，全身已在林。\n不因人自昔，那得我从今。\n香暖流云幕，钟寒怯曙襟。\n当时谁坐断，塔影尚沉沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其六十九","author":"释函是","text":"斗大梧桐树，当檐引晚风。\n半留山月到，更与野禽通。\n子落知秋老，枝疏惜岁穷。\n衰荣看欲尽，独立意谁同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其七十","author":"释函是","text":"雁叫微霜后，林寒细雨初。\n板桥先度客，野圃罢烧畲。\n望寺僧归疾，投城马去疏。\n前涂云树合，回步竟何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其七十一","author":"释函是","text":"閒情销隐几，独觉愧婆和。\n秋水无心照，山禽有影过。\n拂空翻鸟迹，把火沸冰河。\n人道虚神用，吾师念积屙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其七十二","author":"释函是","text":"流水去无返，年华暑复寒。\n根尘如梦起，识浪几时乾。\n白日忙閒过，青山岁月宽。\n尝闻高隐客，还共夕阳残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其七十三","author":"释函是","text":"五更开户望，孤月照禅真。\n脚踏生台影，灯摇绕佛身。\n风停花入定，雁过水无尘。\n不到空潭曲，难论旷世因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其七十四","author":"释函是","text":"不是远人迹，都缘避世誉。\n经行苔径没，燕坐草堂虚。\n生死当知处，浮沤岂易除。\n年来消息断，惭愧客情疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其七十五","author":"释函是","text":"主院至垂老，因人敢爱閒。\n幸然无俗客，乘暇且看山。\n掩户推云出，开窗揖月还。\n高松投鹤影，永夜不成关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其七十六","author":"释函是","text":"人定钟初歇，灯明夜最真。\n闻猿几丧我，观树亦犹人。\n万籁归何处，群机得所因。\n谁当更消息，孤负陌头春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其七十七","author":"释函是","text":"赋性偏多癖，违时追昔贤。\n疏才居事后，勇退在人前。\n自合栖岩壑，难教入市廛。\n爱人殊未已，有约白云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其七十八","author":"释函是","text":"午睡鸟呼觉，交交声未休。\n不知吾觉后，鸟意复何酬。\n濯濯风前柳，洋洋石上流。\n山中长似此，卒岁乐优游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其七十九","author":"释函是","text":"发白垂将遍，眸青尚可观。\n往年筋力异，来日杖头宽。\n禅寂终宵尽，房栊薄暑寒。\n岂堪贪茗盌，更使夕阳残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其八十","author":"释函是","text":"空谷归人少，高峰落日寒。\n望云惭老大，深夜绕栏杆。\n万事省心力，六时惟内观。\n浮生岂容易，休作少年看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其八十一","author":"释函是","text":"歘然一自返，头白老青山。\n俯鉴游鱼戏，仰看飞鸟还。\n身随松鹤瘦，心逐野鸥閒。\n旦晚清阴下，安知世路艰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其八十二","author":"释函是","text":"不择名山老，江流尽有源。\n金轮承雨露，华首接云根。\n一榻长霄迥，千峰古木繁。\n终焉复何憾，相视欲无言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其八十三","author":"释函是","text":"含晖欣晚景，立雪忆当时。\n我亦承人后，谁无一日知。\n江流深不测，云影变多奇。\n峰顶孤松色，岁寒然后知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其八十四","author":"释函是","text":"百岁过驹隙，憧憧何所成。\n机深天性薄，欲寡道心生。\n世故岂难见，林泉空有名。\n吾生少营虑，于此独能明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其八十五","author":"释函是","text":"不识幽栖趣，徒劳招隐心。\n长空无雁影，流水误琴音。\n虎豹畏山浅，鱼龙忘海深。\n高林多绮角，莫向洞庭寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其八十六","author":"释函是","text":"谁信子期死，伯牙仍鼓琴。\n从来无覆处，岂敢贵希音。\n住久识山性，听多知水心。\n晨宵欣独往，林下莫沉吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其八十七","author":"释函是","text":"往复长松下，相逢岂异人。\n暗投愁按剑，什袭愧非珍。\n过涧须眉在，啼林鸟雀亲。\n生平吾不昧，以此得安贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其八十八","author":"释函是","text":"背山朝隐雾，傍殿夜闻钟。\n忽忆此生事，都忘何处从。\n百骸成聚散，一觉有春冬。\n饮啄同山鸟，登临信竹筇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归宗山籁一百四首 其八十九","author":"释函是","text":"望夕光沉魄，晴林影尚微。\n为云曾不是，即月岂全非。\n过眼山容隐，含情夜色晖。\n若教迟皓洁，已丧目前机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]