[{"title":"江行","author":"薛瑄","text":"两岸好山看不尽，一江烟水去无穷。\n谁人为和沧浪曲，兴在空濛杳霭中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5395,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"平羌望峨眉山","author":"薛瑄","text":"峨眉画出天边秀，青到平羌尚未休。\n山月半轮怀李白，扁舟我亦下渝州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5396,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"读史二首 其一","author":"薛瑄","text":"汉唐末事谁能鉴，晋宋当年世所知。\n犹有一编青史在，悠悠长使后人悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5397,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"读史二首 其二","author":"薛瑄","text":"东言来若用言难，不用忠言亦等閒。\n若信当时江统论，定无戎马到长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5398,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夜","author":"薛瑄","text":"又逢除夜客西川，银烛金炉白发前。\n却忆去年京邸夜，朝衣新试候朝天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5399,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蜀中元夕","author":"薛瑄","text":"京华西蜀两元宵，总去家山道路遥。\n来岁乞归逢此夕，故乡灯火沸笙箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5400,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"成都看梨花","author":"薛瑄","text":"锦城风煖不生尘，开遍梨花万树春。\n吹散绿云帘尽捲，广寒宫里有仙人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5401,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"看木瓜花","author":"薛瑄","text":"杏艳桃夭二月终，好花难比木瓜红。\n回头总愧青青柏，生怕林间一夜风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5402,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏史","author":"薛瑄","text":"平吴四海尽为家，内苑新添万树花。\n秪喜羊车游别院，不堪轵道驾牛车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5403,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戏题则天乡","author":"薛瑄","text":"无端险恶山川气，尽付当时武媚娘。\n淫虐千年遗臭在，至今人唾则天乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5404,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"纪行口号","author":"薛瑄","text":"襄阳曾渡汉江水，嶓冢还寻汉水源。\n自笑苦无经济略，道途何事往来烦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5405,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自朝天驿回京","author":"薛瑄","text":"去春舟发朝天驿，今夏朝天岭上回。\n水陆朝天行已遍，朝天从此上金台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5406,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太常许卿送菜戏简十首 其一","author":"薛瑄","text":"为谢东邻许太常，嘉蔬频送意难忘。\n呼童带叶连根煮，咬得其中一味长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5407,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太常许卿送菜戏简十首 其二","author":"薛瑄","text":"摘送园蔬露未乾，齑成新味带咸酸。\n几回放箸诗肠饱，绝胜先生苜蓿盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5408,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太常许卿送菜戏简十首 其三","author":"薛瑄","text":"空堂养病似斋居，喜送东园几种蔬。\n吃此久无烹宰事，不须仍用远庖廚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5409,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太常许卿送菜戏简十首 其四","author":"薛瑄","text":"白发青袍老寺丞，卜居喜近太常卿。\n故知气味多相似，频送东园菜把青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5410,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太常许卿送菜戏简十首 其五","author":"薛瑄","text":"菜出东园种种新，太卿相送意何亲。\n平生自是甘清味，肉食能无愧古人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5411,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太常许卿送菜戏简十首 其六","author":"薛瑄","text":"园蔬新拔带霜浓，烂煮香根放箸空。\n谁识其中有真味，不须苦羡紫驼峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5412,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太常许卿送菜戏简十首 其七","author":"薛瑄","text":"自笑官贫气尚豪，党姬休复论羊羔。\n卿家能送东园菜，清味还应厌老饕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5413,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太常许卿送菜戏简十首 其八","author":"薛瑄","text":"此色斯民不可有，此味庙堂不可无。\n顾我已非调燮手，先生相送意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5414,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太常许卿送菜戏简十首 其九","author":"薛瑄","text":"雅契名卿柰若何，嘉蔬频送意尤多。\n生平味此无厌足，恐似当年吃菜魔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5415,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太常许卿送菜戏简十首 其十","author":"薛瑄","text":"京华交契似君稀，白首相看意不违。\n忽见名园送新菜，故乡老圃倍思归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5416,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"徐州见黄河","author":"薛瑄","text":"吾家正在龙门下，流出黄河几曲长。\n忽向徐州城外见，牵情一水正思乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5417,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"燕子楼","author":"薛瑄","text":"孀妾当时一女流，犹知守节度春秋。\n往来忘义忘仁者，莫上彭城燕子楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5418,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戏马台","author":"薛瑄","text":"八千兵渡大江来，戏马高台亦壮哉。\n何事乌江骓不逝，高台翻使后人哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5419,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陵母墓","author":"薛瑄","text":"鹿走中原海起尘，独从草昧识真人。\n纷纷都是人间死，母死高名万古新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5420,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吕梁洪","author":"薛瑄","text":"长洪几折奔流急，乱石两崖还叠重。\n被发行游浑不见，往来舟楫自匆匆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5421,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过淮阳有感而作","author":"薛瑄","text":"武皇侧席正求贤，直道谁居汲黯前。\n何事不教留禁闼，淮阳高卧度流年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5422,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"高邮露筋庙二首 其一","author":"薛瑄","text":"高邮女子志何坚，假宿宁论性命全。\n甘向荒陂死蚊喙，此生元不愧苍天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5423,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"高邮露筋庙二首 其二","author":"薛瑄","text":"囋血其如利觜何，荒陂一夕死贞娥。\n从教筋骨当年露，嬴得清名世不磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5424,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渡江","author":"薛瑄","text":"仪真北上念三年，又上江南济渡船。\n清晓登舻望京国，钟山彷佛翠云连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5425,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望南京","author":"薛瑄","text":"虎踞龙蟠入望边，钟山瑞霭翠相连。\n仰思圣祖开洪业，定鼎宜过忆万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5426,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题双鹊图","author":"薛瑄","text":"梅竹交青映柏枝，飞来双鹊立多时。\n主人翁好无弹射，有喜令渠日日知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5427,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太平门","author":"薛瑄","text":"何处清时快往还，太平门外好湖山。\n閒花野草应无数，惟有青松最耐看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5428,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大理后庭竹林山色二首 其一","author":"薛瑄","text":"钟山雨过翠成堆，竹里清风作阵来。\n爱竹看山有真乐，高人远矣忆追陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5429,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大理后庭竹林山色二首 其二","author":"薛瑄","text":"閒爱脩篁静爱山，清阴秀色座中看。\n老来渐得悠然趣，天际浮云任往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5430,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"临终口号","author":"薛瑄","text":"土床羊褥纸屏风，睡觉东窗日影红。\n七十六年无一事，此心惟觉性天通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5431,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青城分司暮春","author":"薛瑄","text":"漠漠杨花满院飞，重来又见一春归。\n去年记得停骖日，正月庭前雪作围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5432,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题松竹梅图","author":"薛瑄","text":"翠竹青松共白梅，几枝潇洒出尘埃。\n长年自保风霜节，不学春红向煖开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5433,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"濮州道中口号","author":"薛瑄","text":"岁月多从马上过，勋名未立鬓先皤。\n风霜满面谁能识，极目苍天一放歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5434,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟发辰溪岸","author":"薛瑄","text":"岸脚插江深，洄潭摇石影。\n舟行若天游，妙处心独领。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5435,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"静夜","author":"薛瑄","text":"雨滴霜台静，灯明宪府深。\n新诗吟谩好，谁复是知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5436,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题墨兰二首 其一","author":"薛瑄","text":"已见光风转，应知九畹深。\n殷勤采香洁，持慰美人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5437,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题墨兰二首 其二","author":"薛瑄","text":"既自充楚佩，还曾入孔琴。\n寄言采芳者，云谷莫辞深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5438,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜","author":"薛瑄","text":"泠泠碧窗风，皎皎疏帘月。\n重门掩秋霜，素练捣寒雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5439,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荒径","author":"薛瑄","text":"晓行荒径中，瀼瀼草上露。\n日出云气收，一鸟空中度。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5440,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜饮李海昌宅","author":"薛瑄","text":"重门敞春夕，灯烛霭馀辉。\n醉我百壶酒，留连夜未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5441,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早起","author":"薛瑄","text":"鸡鸣耿不寐，展转待明发。\n童子看窗前，犹言有残月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5442,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早发","author":"薛瑄","text":"晨星耿孤色，晓月馀清朗。\n舟人解缆行，梦觉波声响。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5443,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"野市","author":"薛瑄","text":"野市二三家，柴门傍水斜。\n溪童卖蒲笋，归路不辞赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5444,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"率成","author":"薛瑄","text":"舟过水无迹，云收天本清。\n外物自纷扰，吾心良独明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5445,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送和司训","author":"薛瑄","text":"秋色满平阴，秋声处处砧。\n离筵对衰草，别路绕疏林。\n白日青霄迥，红云紫极深。\n此行应得意，早晚报佳音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5446,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"久雨遣怀六首 其一","author":"薛瑄","text":"客居连市井，积雨竟朝昏。\n屋漏频移榻，泥深少出门。\n窗风侵座冷，檐溜入宵繁。\n赖有诗驱闷，无劳问酒樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5447,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"久雨遣怀六首 其二","author":"薛瑄","text":"秋来常苦雨，风气早生寒。\n小鸟投林急，高鸿下食难。\n奔流淹古道，密雾隐前山。\n试诵停云句，中怀独未宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5448,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"久雨遣怀六首 其三","author":"薛瑄","text":"连日对秋雨，其如客思何。\n泥涂宁出户，流潦欲成河。\n生菌井阑遍，积苔墙角多。\n无由访知己，遣兴且吟哦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5449,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"久雨遣怀六首 其四","author":"薛瑄","text":"泥泞不可出，茅斋静坐时。\n怀贤寻往传，课子诵新诗。\n近悟柔为胜，深知巧是非。\n雨声杂凉吹，萧飒发清机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5450,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"久雨遣怀六首 其五","author":"薛瑄","text":"密雨洒如丝，凉风散漫吹。\n泥途殊汨没，茅舍久淋漓。\n秋意心先得，虫声耳独知。\n田家望收穫，何日静云霓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5451,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"久雨遣怀六首 其六","author":"薛瑄","text":"小窗听雨坐，灯影照孤吟。\n谁识无边道，元同不外心。\n客襟澄夜气，檐溜滴清音。\n诗就无馀和，悠悠思转深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5452,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄秉忠周司训二首 其一","author":"薛瑄","text":"良夜对床宿，清晨送子行。\n西郊雨新霁，古道马频鸣。\n执手别时话，挥鞭独往情。\n相思杳难极，鸿雁带秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5453,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄秉忠周司训二首 其二","author":"薛瑄","text":"过我衡门下，秋宵雨歇初。\n繁星随汉阙，明月到窗虚。\n别数宁辞酒，谈多不厌书。\n今朝远相忆，陡觉鬓毛疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5454,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谩成","author":"薛瑄","text":"客里经年久，交游日渐新。\n名浮真自愧，知少不生嗔。\n大道终非外，微言总是真。\n悠然无所竞，转觉快心神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5455,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈广文见访","author":"薛瑄","text":"爱客情何厚，肩舆到所居。\n樽醪携腊蚁，盘错间春鱼。\n雅意忘年契，高怀胜日雩。\n剧谈移永昼，未儗促归途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5456,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽江处士","author":"薛瑄","text":"处士好静者，放情丘壑间。\n樽前流水远，窗外白云閒。\n孙子诗书熟，交亲礼数宽。\n百年今已矣，凉月满柯山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5457,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卢沟桥","author":"薛瑄","text":"沙水相荡潏，晴宵飞彩虹。\n阑干临极浦，华表撼高风。\n爽气西山秀，祥云北阙浓。\n南征从北发，归拟驻华骢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5458,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"入湖南界","author":"薛瑄","text":"行尽中州地，湖南境界初。\n渐闻人语异，更讶鸟音殊。\n溪谷多栽稻，池塘尽养鱼。\n山村聊借宿，风月夜堂虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5459,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"应山道中","author":"薛瑄","text":"万壑岚光满，晓骑骢马行。\n茂林交拥盖，脩竹送前旌。\n到面溪风冷，经心石涧清。\n豺狼应远迹，狐鼠不须惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5460,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚至云梦","author":"薛瑄","text":"云梦行看近，肩舆趁晚凉。\n稻塍新穗吐，莲沼落红香。\n密树隐茅屋，芜堤系野航。\n霜台绝萧洒，容我得徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5461,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"发云梦二首 其一","author":"薛瑄","text":"鞍马几千里，又登云梦舟。\n天围平野阔，水入大江流。\n笑傲倾樽蚁，微茫听棹讴。\n往年怀七泽，今日遂清游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5462,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"发云梦二首 其二","author":"薛瑄","text":"昔闻云梦泽，今泛楚人船。\n地远烟迷树，湖平浪拍天。\n南风清宪节，北斗烛龙泉。\n频向中宵望，武昌何处边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5463,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大江逢霁景独酌有作","author":"薛瑄","text":"舟行逢霁景，逸兴杳难群。\n绿树江边影，青天水底云。\n众山连复断，双橹合还分。\n自酌樽中酒，微吟到半醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5464,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟发城陵矶","author":"薛瑄","text":"急鼓催舟发，依稀见岳阳。\n远波浮岛屿，众水合岷湘。\n竹瓦居人閤，杉脾贾客房。\n且看风景异，未觉远游伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5465,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"辰溪晓泛五首 其一","author":"薛瑄","text":"沅水一千里，辰溪又泛舟。\n山云合雨暗，身世与天游。\n已觉鸡声远，惟闻橹韵幽。\n所经多险涉，还似解离忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5466,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"辰溪晓泛五首 其二","author":"薛瑄","text":"湛湛江流碧，层层石岸高。\n蛮讴催健橹，瘴雨洒轻舠。\n自勖冰霜操，宁辞旦夕劳。\n五溪山万叠，何处是龙标。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5467,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"辰溪晓泛五首 其三","author":"薛瑄","text":"怪石双崖峻，秋江一道平。\n榜人皆异语，岸鸟亦殊声。\n洞户编茅小，蛮舟刳木轻。\n虽惊风土异，重喜万方清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5468,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"辰溪晓泛五首 其四","author":"薛瑄","text":"苍峡几千尺，天开万古馀。\n波穿石眼瘦，舟压水心虚。\n历历瞻奇秀，悠悠想化初。\n所希观物妙，难觅邵尧夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5469,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"辰溪晓泛五首 其五","author":"薛瑄","text":"自有烟霞分，观风任所之。\n洞馀槃瓠种，江绕伏波祠。\n秋老芙蓉树，云深薜荔丝。\n欲知消远思，秪是咏新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5470,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟发长沙四首 其一","author":"薛瑄","text":"晓溯湘江水，微风漾碧波。\n好山随岸远，野烧入林多。\n往哲题诗处，今予鼓棹过。\n年来游览数，天意遣吟哦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5471,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]