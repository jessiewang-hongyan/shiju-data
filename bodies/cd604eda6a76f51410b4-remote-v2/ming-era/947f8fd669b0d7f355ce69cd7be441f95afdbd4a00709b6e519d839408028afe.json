5f79689","path":"明_3.csv","pointer":44993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牡丹台边桃花","author":"释函是","text":"桃花先占牡丹春，开落台边不顾人。\n自是淡红深著雨，敢轻富贵惜风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蜡梅","author":"释函是","text":"雪里鹅黄亦是梅，寒香一簇入帘来。\n似韬洁白随人意，嚼碎金茎献宝胎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"净成口占","author":"释函是","text":"五溪深处失樵踪，曲曲溪声烟雾重。\n石压高坪出新柳，一条堤指紫霄峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"栖贤口占","author":"释函是","text":"万叠青山峡涧东，黄埃白昼虎狼风。\n僧归野火烧松树，照入深潭起卧龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚申除夕","author":"释函是","text":"白头只合老青山，山事如今且未閒。\n明日又归三峡寺，千峰林下水潺潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"固穷吟三首 其一","author":"释函是","text":"近来有个固穷法，只是堆堆不著忙。\n闻说栖贤无米爨，但教伸手向村坊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":44999,"sha256":"dc0f9be95fde68d0587a89f7