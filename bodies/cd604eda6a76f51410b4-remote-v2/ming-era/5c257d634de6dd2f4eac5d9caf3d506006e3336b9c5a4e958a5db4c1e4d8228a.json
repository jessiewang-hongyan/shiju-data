[{"title":"华林除夕与诸子守岁赋得山中无历日寒尽不知年得无字","author":"成鹫","text":"病骨支离七尺躯，不堪长作寺家奴。\n别山渐觉人将老，入世方知岁易徂。\n岂有樊笼宜野鹤，更无寒暑管樵夫。\n隔年未信春先入，借问梅花开也无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕后一夜与诸子话别","author":"成鹫","text":"三城细雨散春灯，半榻疏钟对好朋。\n岐路恰逢青眼客，故山将返白头僧。\n光摇冷幌风欺烛，响落层崖夜堕冰。\n回首林泉发幽兴，一声长啸忆孙登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将返马山答诸子见招来韵","author":"成鹫","text":"珍重缄书报所欢，得盘桓处且盘桓。\n烟霞密约终当践，城市嚣尘去不难。\n老鹤随身云一片，春莺饶舌日三竿。\n明朝料理还山棹，月满松窗好共看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春还马山，静语师归自丹霞，十影、化声二子各还故里，赋此","author":"成鹫","text":"流水行云各有因，乾坤容我老閒身。\n移花买石堪晨夕，送往迎来自主宾。\n远近杖头三事衲，东南鼎足数家春。\n同参欲挽知难住，相劝还山作懒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初冬卢雁林过宿马山寺有怀云庵上人","author":"成鹫","text":"偶寻荒寺拥孤衾，难得良朋话夜深。\n凿牖引山归冷榻，开帘延月出疏林。\n寒花渐改高秋色，流水长怀太古音。\n惆怅旧游成寂寞，影堂空挂薜萝阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卢雁林过庵见赠赋答","author":"成鹫","text":"红树黄花覆槿藩，一庵秋色数家村。\n僧閒自笑驴窥井，客至唯教鹤应门。\n短烛话深通语默，旧游见惯失寒暄。\n与君早有居山约，双鬓无端雪渐繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁晋煌适珠崖省墓","author":"成鹫","text":"孤儿十载已无家，又逐飞蓬渡海涯。\n分室我应惭郈伯，下车谁复问西华。\n桑榆日暮频怜影，杕杜春深自放花。\n此去定知防墓近，白杨犹有未归鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春何古钱过宿马山分赋","author":"成鹫","text":"野老入山殊草草，旧游留话未匆匆。\n半窗萝月三更梦，万壑松涛一夜风。\n高韵独吟清漏永，孤灯分照寸心同。\n殷勤致语东林炳，莫漫逢人说懒融。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与李远霞卢雁林诸子分赋","author":"成鹫","text":"故人笑我住人间，指点云林共掩关。\n隔竹閒门新白板，满楼春色旧青山。\n眼前有句频拈出，物外无心且放顽。\n乘兴更探泉脉去，一溪流水碧潺潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜毛中庵明府归自丹徒 其一","author":"成鹫","text":"道情平澹世知稀，一奏良刀便入微。\n官似澄江清见底，心同高鹤倦思归。\n春栽荷芰成初服，晚脱华簪伴衲衣。\n閒上竹楼楼上望，青山依旧对玄晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜毛中庵明府归自丹徒 其二","author":"成鹫","text":"草鞋正拟参方去，却喜金山有主人。\n北道未通怀里刺，东篱重理瓮头巾。\n朱弦静谱当时曲，白社言寻昨日春。\n分卫偶来劳见讯，长官争似衲僧贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题郑停莪新筑","author":"成鹫","text":"负郭依山结筑牢，到门唯见一峰高。\n翚飞轮奂饶云物，凤食琅玕足羽毛。\n东阁书声喧彩服，西轩茗色醉方袍。\n主人本是忘机者，肯向春田事桔槔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"分卫铁城贻社中诸子","author":"成鹫","text":"好春早有名山约，稔岁偏宜托钵僧。\n自买草鞋来海岳，遍将米价问庐陵。\n莲塘旧社归难得，桂岭孤峰到未能。\n多谢同参屡招隐，蹉跎深愧久要朋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雷峰寺观潮","author":"成鹫","text":"廿年曾过潮边寺，今日初观寺外潮。\n万马直奔鱼腹浦，一鸥閒立虎溪桥。\n前村云树连空碧，隔岸菰蒋入望遥。\n犹胜西湖二三月，风光多半属渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋郊观猎","author":"成鹫","text":"霜天晓角出长楸，选队从禽逐胜游。\n高鸟欲飞聊戢羽，饥鹰将击尽凝眸。\n东门黄犬缨金锁，南国青蛾控玉骝。\n大笑守株林下叟，雀罗深巷鹿呦呦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜李东园诸子过宿马山赋得身閒数得上方眠","author":"成鹫","text":"物外身閒几个能，入山居士住山僧。\n孤衾独抱来何暮，短榻高悬下未曾。\n古月照残尘外梦，新虫吟破壁閒灯。\n殷勤报语侵晨客，莫把浮云换曲肱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日偕诸子过东园别业分赋古梅","author":"成鹫","text":"昨日梅花村里回，偶寻高士见庭梅。\n最怜老干棱棱瘦，不似群芳草草开。\n硕果岂供嘉客赏，孤根曾见太平来。\n春风吹醒閒人梦，长笛一声诗兴催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初入东湖谒契如和尚 其一","author":"成鹫","text":"久向东湖十载前，遐心长寄水云边。\n偶来隔竹闻清磬，为爱新凉上小船。\n生计百年三事衲，名山到处一家禅。\n从师乞得閒房住，愿执巾瓶侍法筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初入东湖谒契如和尚 其二","author":"成鹫","text":"祖翁旧业未荒芜，赖有西乾古丈夫。\n白社一灯悬太白，湖光千顷接天湖。\n林间趺坐花香满，水际閒行鹤影癯。\n珍重清光似明月，长留孤棹在菰蒲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初入东湖谒契如和尚 其三","author":"成鹫","text":"万象森罗一鉴中，化城今在莞城东。\n波光倒插千峰影，暑气潜消五月风。\n翠竹晚凉丹荔熟，白莲朝映槿花红。\n罗浮咫尺家山近，细把程途问主翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客夜与林叔吾湖上话旧","author":"成鹫","text":"棋罢花边覆局难，灯前一笑太无端。\n坐残溽暑心犹热，话到深宵胆亦寒。\n酒力驱君投寺宿，月华留客过湖看。\n别来学得无弦曲，草草相逢未易弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中阻风","author":"成鹫","text":"寒江信宿类孤鸿，一日归程五日风。\n入梦家山明月外，满船疏雨乱流中。\n秋声夜半闻飘叶，浪迹年来笑转蓬。\n但得沧波似平地，不妨长作钓鱼翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"圆瘏黎住仙掌岩却寄","author":"成鹫","text":"孤峰顶上数閒屋，仙掌岩边一个僧。\n高处看人明了了，老来无事冷冰冰。\n漫劳法社虚前席，亲见威音绍祖灯。\n十载步趋惭我后，门庭高峻拟先登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日登仙掌岩谒圆阇黎","author":"成鹫","text":"郡城咫尺旧皇州，仙掌嵯峨控上游。\n金马铜驼空落日，珠林琪树不凋秋。\n登高望远凭青眼，坐石看山到白头。\n师若肯留予肯住，世间无地可藏舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"听卢生弹琴","author":"成鹫","text":"静者能琴不易弹，一弹一曲一盘桓。\n繁弦按月孤心细，枯木生风十指寒。\n天籁去人无咫尺，广陵终古有波澜。\n吟君好句知难和，谁信希声和更难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门怀古","author":"成鹫","text":"海滨头白老渔翁，今古兴亡在眼中。\n罢钓一过沉玉浦，挂飘犹畏覆舟风。\n珊瑚树底瞻龙衮，鹓鹭行边想贝宫。\n惆怅翠华何处所，一声长啸动高穹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和毛明府中庵见赠","author":"成鹫","text":"十载经过万木森，今来祗树又成林。\n閒僧到处青山在，廉吏还家白发侵。\n老病渐思寻活计，虚名多恐负初心。\n自从识得陶彭泽，一度相逢一度深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和梁茂才磐重见赠","author":"成鹫","text":"朝来抱瓮过横塘，冬后偏宜灌药房。\n待我未能容我懒，劳生何敢笑人忙。\n野芹采去肥因雨，老苋烹来脆有霜。\n佳客不嫌滋味淡，明年多种待君尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和方壶洲见过赋赠","author":"成鹫","text":"此生那得两閒身，聊复停居避市尘。\n止水月深三五尺，过桥云隔数由旬。\n忙拖象屐迎佳客，偶著鹑衣见故人。\n炉火正红茶正熟，留君差胜瓮头春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答萧明经邻翼见赠","author":"成鹫","text":"古木新篁共一林，草堂如在碧山岑。\n过桥送客无宾主，隔水看云有浅深。\n露柱日中停昼影，风琴寒定失清音。\n城中好友曾知否，寂寞生涯为许寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和区木参来韵","author":"成鹫","text":"浪迹似萍浮泛泛，枯形如鹤瘠栾栾。\n旁观笑我棋先罢，饱食逢人铗懒弹。\n暂借名园为地主，拟留佳客畏天寒。\n夜来好月谁同见，紧闭柴门独自看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和何太占来韵 其一","author":"成鹫","text":"渐老渐知行处偏，忍抛朋侣泥林泉。\n有人问我此中事，荅道山僧不会禅。\n疏雨隔墙添夜色，冷云穿牖透孤烟。\n相过独有何公子，世外神交岂偶然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和何太占来韵 其二","author":"成鹫","text":"爱此幽居水石偏，閒门临沼沼通泉。\n鸂鶄饱食朝收钓，鹳鹤长饥夜立禅。\n冷灶静添煨芋火，破窗时有煮茶烟。\n君归尚忆东林否，乘兴重来亦偶然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和萧志三见赠","author":"成鹫","text":"借得名园东郭东，清溪曲曲小桥通。\n千寻碧树鹤巢顶，四面青山人在中。\n映水波分双橘绿，经霜风散半林红。\n劳君诗句频相过，吟旁斜阳答远钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广州江楼阻雪荅家峻山峋山","author":"成鹫","text":"出门多与此心违，几日浓阴半撞扉。\n冷榻不堪愁里坐，故山频向梦中归。\n江声过雨成空润，风势兼寒入细微。\n南阮老来贫更甚，劳君重叠劝添衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊遇雪","author":"成鹫","text":"严城吹角晚栖鸦，野客扁舟归兴赊。\n隔岸冻云迷浦溆，满船寒雨湿袈裟。\n萍踪自断随风力，蓬鬓知难避雪花。\n便把生涯问渔父，明年相继学浮家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同住东林，有厌清苦者相继辞去。时值小除，与诸子守岁，示此以坚其志","author":"成鹫","text":"山厨破甑久生尘，笑拨寒灰事火神。\n冷灶已无黔突客，居亭犹有刻舟人。\n橘因易地春为枳，姜自经冬老更辛。\n大尽到来能几几，暂留同住守庚申。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬申元旦谩兴示诸子","author":"成鹫","text":"一夜春风洗病颜，乾坤容我老痴顽。\n新知如故花边日，暂别能来雨后山。\n竹径有风朝罢扫，松门无客晚休关。\n等閒指出閒生理，慎勿将心更觅閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游墺门宿普济禅院赠云胜师","author":"成鹫","text":"珠林遥隔水云村，百里寻僧日欲昏。\n行逐鲛人趁番市，渐闻鴃舌杂华言。\n山钟近接三巴寺，海气晴分十字门。\n到处不妨吾道在，岛夷今识法王尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"墺门阻风","author":"成鹫","text":"绝徼到来曾几日，故山回首已千重。\n归从旧路常忧雨，去逐春潮却滞风。\n拜浪江豚随上下，忘机鸥鸟自西东。\n偶来识得居夷叟，浮海乘桴兴不穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李广文方水掌教筠城，兼寄潘明经圆子","author":"成鹫","text":"同游回首各升沉，往事那堪数至今。\n两度川山仍旧路，三年风木负初心。\n大儒到处多虚席，古道由来有盍簪。\n白首故人如见讯，祖庭秋冷待相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨孝廉明度出宰宣平，其昆玉江度旻度送至官舍，归途遍历西湖、天台诸胜，辄有题咏，出以示予，赋此以致欣赏之意，因寄宣平明府 其一","author":"成鹫","text":"诗情偏重宦情轻，谁似杨家好弟兄。\n风雅一门分鼎足，纵横七字筑长城。\n逢僧说瀑眉毛冷，随地看山耳目清。\n多谢新篇劳见示，把吟终日忆宣平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨孝廉明度出宰宣平，其昆玉江度旻度送至官舍，归途遍历西湖、天台诸胜，辄有题咏，出以示予，赋此以致欣赏之意，因寄宣平明府 其二","author":"成鹫","text":"梦想西湖二十年，输君先我祖生鞭。\n六桥花信供诗笔，四面山光上画船。\n歌馆醉吟翻艳曲，精林来往悟真禅。\n还家已过春三月，犹欲开池自种莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨孝廉明度出宰宣平，其昆玉江度旻度送至官舍，归途遍历西湖、天台诸胜，辄有题咏，出以示予，赋此以致欣赏之意，因寄宣平明府 其三","author":"成鹫","text":"七体雄篇推哲匠，千寻飞瀑下天台。\n吟成好句敲推久，忘却危梁经过来。\n蜡屐岂应遗雁宕，奚囊无计逐龙媒。\n相闻更有名山约，抖擞閒身为许陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊端州","author":"成鹫","text":"几过端州逢九日，水边三见菊花新。\n秋风江上同为客，凉月天涯识故人。\n渐老自知佳梦少，乍寒先与敝袍亲。\n何堪倦鹤睡方足，遥听鸡声起白蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发长江寺","author":"成鹫","text":"长江古寺数声钟，催起船头白发翁。\n初日渐高群象外，轻烟不尽乱流中。\n微吟自拾沿流叶，清啸遥迎破衲风。\n秋色重重山又水，不知何处息征篷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙山国恩寺谒卢祖影堂","author":"成鹫","text":"群峰西峙水流东，旧路分明见祖翁。\n白日渐低祗树影，青山空冷桂花风。\n当时不合分南北，后世何因说异同。\n一瓣真香为谁爇，镜台无像日当中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49658,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题卢祖父母暮","author":"成鹫","text":"列嶂嵯峨逼太清，百千龙象拥佳城。\n一家共住无生国，异世经过何限情。\n教子直须成佛祖，显亲谁得似宁馨。\n北邙多少累累冢，寂寞泉扉昧姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49659,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归舟夜泊峒口","author":"成鹫","text":"秋江何处不清泠，近浦维舟远思兴。\n野烧入船添夜色，岸萤依草乱村灯。\n看山记得来时路，顾影还同昨日僧。\n岁暮归心似流水，一随风力便成冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49660,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿佛径庵，赠迈往师，怀开山故人","author":"成鹫","text":"千峰行尽水迢迢，日暮寻师过断桥。\n僧老不闻翻贝叶，身閒惟爱种芭蕉。\n山藏绝壑人稀少，秋入空林夜寂寥。\n惆怅居亭何处所，满庭黄叶落萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49661,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠平山庵主兼贻谭氏诸阮","author":"成鹫","text":"千家烟火隐云岚，一个真僧守破庵。\n行脚不妨随我住，枯禅还喜有人参。\n竹林诸阮分南北，莲社群贤数二三。\n咫尺乌衣门巷近，出墙红树间黄柑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49662,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸酉元旦书怀","author":"成鹫","text":"衮衮两九三百六，看看五十七年春。\n青阳有主身为客，白发无情老近人。\n欲买北山虚旧约，偶寻东墅得佳邻。\n风光不厌频流转，一度移居一度新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49663,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"开元寺探泉","author":"成鹫","text":"停舟偶过开元寺，就地还寻最胜泉。\n石甃久荒苔藓外，茶瓢犹挂薜萝边。\n当时一滴成花雨，终古馀波及稻田。\n老衲不知陵谷变，殷勤挹注奉金仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49664,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过何太占南塘","author":"成鹫","text":"南塘春雨客来稀，一个閒僧到竹扉。\n乔木不随沧海变，野鸥长傍水亭飞。\n榄峰晚色青千叠，槐岸新阴绿一围。\n便向居亭问祗树，隔溪遥指钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49665,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿何赤木西园","author":"成鹫","text":"数年有约兴初乘，一宿西园快寝兴。\n柳色齐檐临水阁，花光摇槛隔桥灯。\n鱼笺重叠曾招隐，鹤米平分许饭僧。\n多谢主人能爱客，相门虽峻不妨登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊江门","author":"成鹫","text":"东风挂席下江门，江上维舟晚渡喧。\n日脚乍收云外雨，潮头遥失水边村。\n年来浮海心偏远，老去看山眼未昏。\n极目沧桑更怀古，崖山回首一销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过白沙先生祠故址","author":"成鹫","text":"大儒出处见高风，遗搆依稀想像中。\n皋座春来莎草遍，石楼兵后玉书空。\n偶然消息成吾是，静里端倪忆我公。\n咫尺江门江上水，扁舟来往此谁同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访杨敏叔不遇，时敏叔归崖门故宅","author":"成鹫","text":"来从古寺问西墩，隔水遥知处士门。\n陋巷僦居徒四壁，故园归棹有孤村。\n青山浪迹聊舒愤，白首论心未报恩。\n何事先生难得见，一年强半在慈元。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登玉台寺呈雪玻长老","author":"成鹫","text":"玉台半壁削天根，金地巍峨古佛尊。\n万里山川供指顾，二时钟磬辨朝昏。\n往来烟水疑无路，出入云霞别有门。\n欲向孤峰问禅律，自伤迟暮不堪论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归舟过大悦滘，访屈无倦、无极二子","author":"成鹫","text":"春风门巷薜萝阴，大悦溪边水石深。\n久别乍惊儿女长，老来犹见弟兄心。\n残枰懒向花间覆，旧梦多从醒后寻。\n草草相过殊未快，归舟一路托枯吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客西园赠陈东崖","author":"成鹫","text":"回首嬉游似断篷，可堪相见各成翁。\n童心掷向红尘外，壮志销归白业中。\n短榻夜禅陪病鹤，閒阶春望送孤鸿。\n西园宾从多新识，争羡先生有祖风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋七日集容尘轩分赋","author":"成鹫","text":"一轩秋色净无尘，幕府烹葵召野人。\n躐等不知宾礼密，过中多感主情真。\n閒题丽句酬仙侣，笑指灵槎忆汉臣。\n翘首客星何处所，晚来风雨暗天津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]