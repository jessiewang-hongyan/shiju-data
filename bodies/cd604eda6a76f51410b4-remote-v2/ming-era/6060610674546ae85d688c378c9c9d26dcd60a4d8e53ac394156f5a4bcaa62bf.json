[{"title":"江城子 秋日行舟","author":"沈麖","text":"浮萍潆曲小桥边，似荷钱，似花钿。\n秋艇宜人、一路棹添烟。\n三径高情来访菊，无事尔，此身前。\n新生野水碧涓涓，跃鱼渊，钓丝牵。\n疏柳依依、坡岸弄轻妍。\n日落残霞分夜影，钟断处，塔铃传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18875,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中兴乐","author":"沈自炳","text":"芙蓉池上露初凉，桐花月转回廊。\n秋满纹帘，孤灯漏长。\n梦入红楼画墙，见萧娘。\n觉来枕畔，玉钗犹响，无限思量。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18876,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"更漏子","author":"沈自炳","text":"忆情人，南浦去，携手向人低语。\n眉样浅，翠衣轻，莺啼画舫行。\n香闺掩，珠帷敛，春剩杨花千点。\n愁不禁，黯销魂，黄昏独倚门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18877,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"虞美人 春景","author":"沈自炳","text":"竹篱阵阵飞花雨，栖燕衔香语。\n孤云细草小溪晴，攀梅拾豆打流莺，短桥横。\n杨花一似郎情薄，相见还飘泊。\n空余三月断肠春，万重山外楚江滨，有行人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18878,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"虞美人","author":"韩曾驹","text":"落花不为随春去，别有闲情绪。\n寻花偶过野人家，偏是菜花开尽见桃花。\n无情每恨良宵月，圆少翻多缺。\n上弦数到下弦时，问有几多明月上花枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18879,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 红桥","author":"张纲孙","text":"白舫青帘映碧流，西风初透芰荷秋。\n玉箫声里度扬州。\n二十四桥今寂寞，隋堤芳草莫添愁。\n如淮美酒醉红楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18880,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山花子 夏夜","author":"周永年","text":"低髻拢花梦半醒，重携枕簟向闲庭。\n何处玉箫风送远，倚阑听。\n趁着萤光看络纬，卷开珠网放蜻蜓。\n不是夜长愁不寐，候双星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18881,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"眼儿媚","author":"许友","text":"精魂石上忆三生，寒夜与君盟。\n帘前明月，窗间小饮，楼上残更。\n而今闲坐记芳情，庞儿较可憎。\n亸肩倚案，低头弄笔，斜眼挑灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18882,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮","author":"韩洽","text":"疏帘淡月和烟入，琵琶深夜愁弦涩。\n莫奏踏罗裳，沙寒闻雁娘。\n重衾宵梦午，梦忆莲花浦。\n归棹带星澜，隔船窥舞鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18883,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 王氏园","author":"韩洽","text":"玉鳞狼藉残梅片，轻禽倒挂垂杨线。\n春沼绿波融，香吹蝶翅风。\n峰峦横小翠，竹径通幽邃。\n缩取六桥山，移来绣陌间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18884,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"法曲献仙音 拟周美成","author":"韩洽","text":"迟日笼晴，温飙荐暑，入夏炎光初烁。\n扇剪轻纨，裙裁白苎，松吹半掀华幕。\n看槐柳、浓阴满，翛然似岩壑。\n寥寞。\n恨佳游、星分雨散，流年换、憔悴几孤旧约。\n仿佛绿琴声，记秦楼、欢笑如昨。\n岁月欺人，惧芳华、先秋摇落。\n任花开花谢，谁叩草玄亭阁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18885,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"潇湘逢故人慢 拟王和甫","author":"韩洽","text":"园亭晴敞，正梁飞旧燕，林唱新蝉。\n望清景无边，有青峰回合，碧渚相连。\n葛衣纱帻，对南薰、一曲虞弦。\n起无限、乡心别恨，潇湘夜雨朝烟。\n曲终也，余韵在，见游鱼浴鹭、出没波间。\n爱褥草芊绵，更秾柳垂池，翠柏参天。\n日长人倦，向北窗、欹枕高眠。\n愁魂绕、沧浪云梦，片时行尽三千。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18886,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 红桥即事","author":"蒋平阶","text":"柳外高楼一带遮，门前偷下六萌车。\n玉环双臂绾红纱。\n十二阑干闲倚遍，黄莺啼上内人斜。\n隔江愁听后庭花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18887,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙","author":"于儒颖","text":"一片心情眼底柔，倦容疏态越风流。\n未经惆怅不知愁。\n鸳谱怪来针线减，工夫强半为梳头。\n日西初见下妆楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18888,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南歌子","author":"周积贤","text":"玉篆沉凫永，金铺小凤斜。\n杜娘无力绣春纱，闲倚绿萍池畔，数杨花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18889,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望江南","author":"周积贤","text":"遥想忆，残泪湿轻纱。\n斜倚画楼帘半卷，东风微雨落杨花。\n肠断七香车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18890,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"花非花","author":"计南阳","text":"同心花，合欢树。\n四更风，五更雨。\n画眉山上鹧鸪啼，画眉山下郎行去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18891,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"如梦令 纪事","author":"计南阳","text":"长乐晨钟初动，睡熟紫绡娇凤。\n翠辇一时移，十骑红妆云拥。\n如梦，如梦，城上乌啼相送。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18892,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归自谣","author":"张天湜","text":"更漏歇，一夜珠帘风自揭。\n寒鸦影碎梧桐月。\n玉关征戍音尘绝。\n当年别，江南莺语花时节。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18893,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河满子","author":"金是瀛","text":"忆在玉窗金户，弯环晓月西斜。\n城角数声留不住，暗香携得还家。\n梁上双栖燕子，庭中一树梨花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18894,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"桂枝香 寄友村居","author":"张逸","text":"天高气肃，正一派秋声，悲吟万木。\n潇洒远山抹翠，澄溪漾玉。\n故人家住残阳外，小枫村、低低茅屋。\n烟生芦渚，霜沾菊圃，酒香茶熟。\n疏篱畔、山中野服，想竹栏琴韵，松窗棋局。\n四壁清幽，闲挂云林几幅。\n鲤鱼风起天横雁，待一叶寻他剡曲。\n开樽长啸，池边蟹紫，墙头橘绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18895,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望江东","author":"李元组","text":"一幅春光明更美，莺满院，啼花碎。\n飞絮落红相点缀，人立在、秋千背。\n长思短忆供憔悴，算只有、花前泪。\n已将心事随流水，阑干下、金钗坠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18896,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阿那曲 舟中待友","author":"李明岳","text":"几回闲夜停机杼，支枕蓬窗风许许。\n吹尽苹香不见人，绕塘寒月痈癗语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18897,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"离亭燕 白下怀叶君实师","author":"胡偕行","text":"归雁行行啼哢，唤破一宵秋梦。\n梦醒封题忙寄与，又不会将书送。\n怅望碧山头，遥嘱几声珍重。\n踏遍长安何用，满目烟云寒冻。\n檐外铮铮风弄咽，急战雨声还恐。\n多少客金陵，今夜离愁谁共。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18898,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 秋兴","author":"程馞","text":"尽日荷锄治圃，有时捉杖寻泉。\n山翁招我坐桥边，笑指菊花开遍。\n隔岸重重竹树，近溪点点潭烟。\n滩头流下小鱼船，转过芦花不见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18899,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玉楼春","author":"程馞","text":"子规啼过杨花路，缄泪函情无寄处。\n君如南浦往来潮，妾似西陵朝暮雨。\n当年只恨传金缕，何必相逢成别苦。\n夜深蜀国十三弦，紫女青皇私自语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18900,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"锦堂春 秋怨","author":"程馞","text":"玉簟寒生暮雨，冰绡泪染朝霞。\n多情记得还家未，丛桂已无花。\n谱入银筝恨切，窥来宝镜愁加。\n无端雁去书难寄，飞尽总由他。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18901,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阮郎归 立夏","author":"张大烈","text":"绿阴铺野换新光，薰风初昼长。\n小荷贴水点横塘，蝶衣晒粉忙。\n茶鼎熟，酒卮扬，醉来诗兴狂。\n燕雏似惜落花香，双御归画梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18902,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"少年游 秋思","author":"张大烈","text":"萧瑟秋风古渡桥，江风壮晚潮。\n夕阳衰柳，何堪轻拆，瘦损小蛮腰。\n碧云澹远澄波静，惨怨散林皋。\n山海情深，石尤风急，留住远征桡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18903,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 来青阁","author":"程可中","text":"复道悬空踏翠微，芳林过雨湿胭脂。\n卷帘岚气扑人衣。\n半榻午阴销剩暑，一窗寒碧送斜晖。\n曲阑十二绿成围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18904,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"如梦令 九月晦日尚未得归","author":"秦瀚","text":"亭外桂花香满，秋入芙蓉过半。\n衰柳不禁风，黄叶乱飘无限。\n目断，目断，愁望故乡偏远。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18905,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"捣练子","author":"钱继振","text":"春睡足，落花平，草架荼睸送晚晴。\n梅子弄黄茶炙翠，梢头犹剩一声莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18906,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙","author":"张杞","text":"苔草无人半入泥，妒风狂雨绿窗西。\n闲来梦断苦莺啼。\n蝶媚常黏飞絮浦，燕娇惯舞落花溪。\n晓天深夜冷幽闺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18907,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"念奴娇 茉莉","author":"于玉班","text":"檐栊午寂，正阴阴窥见，后堂芳树。\n绿遍长丛花事杳，忽见琼葩丰度。\n艳雪肌肤，蕊珠标格，消尽人间暑。\n还忧风日，曲屏罗幕遮护。\n长记歌酒阑珊，微闻暗麝，笑觅衣沾露。\n月没阑干天似水，相伴谢娘窗户。\n浴后轻鬟，凉生滑簟，无限风流处。\n惹人幽梦，枕边零乱如许。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18908,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 江游","author":"沈懋德","text":"江声汹汹鱼龙老，云情烟色从空绕。\n千里一扁舟，看完无限秋。\n苹花随浪急，白鹭迎风立。\n天外倚高楼，有人添暮愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18909,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"临江仙","author":"查维宏","text":"庭院深深愁几许，落花妒杀东风。\n天涯人远思无穷。\n绿窗梦觉，扶起玉钗松。\n漫忆当年行乐处，而今酒懒诗慵。\n卷帘悄步曲廊东，恼人燕子，双舞夕阳中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18910,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"祝英台近","author":"顾德基","text":"饮将阑，天欲曙，无奈逼人去。\n唱罢阳关，折柳惹飞絮。\n断魂画角尊前，锦帆江上，但私祝、东风留住。\n更相觑，且问甚日归来，叮咛不多句。\n把袂踟蹰，欲判泪如雨。\n长年不管人愁，扬舲方遽，知此夜、棹停何处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18911,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"风入松 漫兴","author":"戈止","text":"生涯应作浣花翁，事事疏慵。\n结庐恰喜尘嚣外，栽花地、雨碧霜红。\n家在乱云深处，人来流水声中。\n年年相识旧东风，排我小帘栊。\n榆钱落尽萍钱落，奚囊在、不畏诗穷。\n夜泛试移短棹，晓眠常过高舂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18912,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卜算子","author":"孟称舜","text":"回首望西陵，隔别入南浦。\n缥缈孤云自往来，寂寞归时路。\n蓼渚小鸿飞，梦断风吹雨。\n江外峰青似剑，难割愁肠去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18913,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蝶恋花","author":"王化龙","text":"小院幽窗风弄晓，柳织烟笼，开罢棠梨了。\n枝上流莺啼更早，惜花人共春花老。\n金鸭香深檐外袅，绣到鸳鸯，转惹侬情恼。\n镜掩孤鸾羞独照，眉山一点愁多少。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18914,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙","author":"蒋尔玙","text":"剪剪轻云片片霞，玉钩纤月短屏遮。\n黄昏风睯绣帘斜。\n花蕊半含多抱蝶，柳条犹软不胜鸦。\n一番春梦落天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18915,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"如梦令","author":"周珽","text":"深院一番风起，狼藉残红满地。\n点点露珠浓，应是别离人泪。\n无寐，无寐，闲却半床鸳被。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18916,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"定风波 客园看桂","author":"周珽","text":"蟋蟀声寒黯淡风，谢家池馆九秋中。\n丛桂四山香满院，一片，妆成金屋画阑东。\n对酒不知身是客，堪惜，夕阳容易散晴空。\n却待夜深明月好，须早，扁舟隔岸采芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18917,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"点绛唇 上元","author":"邵梅芳","text":"车马三更，香风一带笙歌路。\n月华初度，万点春星曙。\n曾记当初，今夜相逢处。\n君休去，玉箫声住，帘卷梅花树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18918,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柳梢青 春雨","author":"邵梅芳","text":"昨夜今宵，东风不断，细雨丝飘。\n暗锁银塘，微沾玉砌，草绿兰皋。\n落红一溜江潮，香断处、平芜画桥。\n杨柳烟低，梨花雪重，多半春销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18919,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望江南","author":"邵梅芳","text":"春光好，芳草绿初齐。\n新雨翠摇雕槛外，轻潮红涨画楼西。\n约伴著罗衣。\n何处去，桃李更芳菲。\n凤额帐深垂柳带，鸦头袜染落花泥。\n憔悴踏青期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18920,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 咏雪","author":"邵梅芳","text":"柳絮空中吹早，梨花槛外开迟。\n红炉翠幌玉堂西，欲堕因风扶起。\n望去一山明月，踏来几寸银泥。\n春光寒峭暮烟低，小立早梅香里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18921,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆汉月 咏萤","author":"邵梅芳","text":"芳草谁知前度，正值寒塘欲暮。\n因风零乱玉阶前，偷炤绮罗香处。\n怜他垂柳外，千万点、长堤碧树。\n黄昏细雨情无人，管取夜深来去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18922,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"眼儿媚 咏燕","author":"邵梅芳","text":"东风一剪过池塘，曾识旧纱窗。\n乌衣未改，红妆如昨，稳上雕梁。\n年年花下相逢处，何事更商量。\n多应是诉，来时春短，别后秋长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18923,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"少年游 晓别","author":"邵梅芳","text":"五更天晓渐鸡鸣，斜月半床横。\n树杪风疏，马蹄霜滑，银汉带疏星。\n看他渺渺垂鞭去，望里不分明。\n一线江流，几层山色，千里隔长亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18924,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙","author":"邵梅芳","text":"水殿凉生咽暮蝉，亭台百尺映清泉。\n数声雨过小荷钱。\n纨扇轻摇圆似月，冰绡斜映薄如烟。\n鬓云撩乱堕香肩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18925,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"风中柳 落花","author":"邵梅芳","text":"一夜东风，南陌落红吹急。\n正芳时、画桥寒食。\n秋千庭外，挂游丝百尺。\n怎凄凉、粉愁香泣。\n半启朱扉，又是青阴如织。\n更凝眸、有谁怜惜。\n但教飞去，向铜沟流出。\n及早透、三春消息。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18926,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉花阴","author":"邵梅芳","text":"病起闲愁消永昼，香钮松金扣。\n时节近清明，燕子双来，翠幄轻寒透。\n杏花新雨池塘后，莫道春依旧。\n昨夜更东风，一树海棠，零落胭脂瘦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18927,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋蕊香 落叶","author":"邵梅芳","text":"门外秋声不绝，簌簌空阶吹彻。\n寒枝影乱鸦啼歇，满院清霜斜月。\n和风带雨难分别，还凄切。\n绮窗敲处灯明灭，梦醒三更时节。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18928,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南柯子","author":"邵梅芳","text":"杏雨新沾砌，梨花冷闭门。\n几重映色上湘纹，断送墙腰长日、又黄昏。\n澹澹斜阳下，微微碧树分。\n楼高莫倚数归人，望去浮云千里、怨王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18929,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"贺新凉 雁声","author":"邵嶙","text":"睡觉秋窗罅，正闲阶、商飙萧飒，明蟾低亚。\n嘹唳数声天际响，直透茆檐竹瓦。\n这凄怨、凭谁堪话。\n辛苦塞垣千万里，又明星、几点湘烟挂。\n稻粱好，究须怕。\n娟娟凉露横空洒。\n好似听、哀弦密拍，楚歌悲咤。\n难比闲鸥和野鹜，随意鲈乡蟹舍。\n任沙觜、沿缘上下。\n今夜重帏寒信紧，又豆棚、络纬萧萧者。\n铜仙泪，泫然泻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18930,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"好事近","author":"徐士俊","text":"剪乱海棠丝，抛却春心不管。\n杨柳那知人意，惹莺儿啼怨。\n脸红眉翠不堪销，拥着半床懒。\n二十四番花信，数春宵愈短。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18931,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金明池 秣陵怀古","author":"殳丹生","text":"断雁西风，瘦驴黄叶，又是关门日暮。\n仙梵度、清凉山寺，对凤阙绛云留处。\n见长干、宝塔翚飞，总阅尽、天界茫茫尘土。\n任沽酒南冈，垆头人老，莫问少年归去。\n裙屐风流叹如许。\n便画面薰衣，隐囊挥麈。\n倚司马、长城却敌，空剩春灯燕语。\n再休言、六代繁华，与半壁乾坤，残棋孤注。\n想虎踞龙蟠，江山形势，都付冷烟疏雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18932,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹤冲天 题莼魰小像和葆馚原韵","author":"钱澄之","text":"云沙月渚，梦里曾游处。\n春草夜来生，催佳句。\n为金门待诏，总交付，渔家住。\n赖诗朋酒侣，唱和新声，谱入舞巾歌苧。\n扁舟晓暮，难趁秋风去。\n觅取故乡鲈，和烟煮。\n又飞觞刻烛，且同听、燕山雨。\n吾衰心未许，扶醉追欢，不减旧年情绪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18933,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"临江仙 春情","author":"钱光绣","text":"酒国投时辄醉，砚田荒久慵耕。\n不堪落叶两三声。\n病从秋后减，愁向雨中生。\n拊剑还歌白石，焚香闲展黄庭。\n徘徊山寺又钟鸣。\n鸦啼归晓树，蛩语伴疏灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18934,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"满江红 春情","author":"季孟莲","text":"燕子何时，衔去了、旧年人约。\n镇帘栊、恹恹春睡，东风遍恶。\n夜雨忽添窗外草，晓晴乱惹楼头鹊。\n算赢来、一段好相思，何曾学。\n而今事，当初错；别时泪，空流落。\n怕归来重问，有词难却。\n天远梦随骢马倦，昼长人并风筝弱。\n望河桥、万柳织黄烟，愁遮幕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18935,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蝶恋花 暮春","author":"贺裳","text":"薄暮银塘风色静，闲倚雕阑，自赏娉婷影。\n一簇芙蓉相掩映，唾花落处游鳞竞。\n女伴潜呼浑未醒，横睇回波，才讶红妆并。\n飞尽残霞天又暝，柳梢笑指新悬镜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18936,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渔家傲 晓别","author":"贺裳","text":"啼罢荒鸡衰雁接，荧荧寒焰窗犹黑。\n欲别重将酥手执，行又立，门前瘦马嘶残月。\n递得金鞭红袖湿，回头已被疏林隔。\n独倚高楼看去辙，铃音绝，纤腰凭久雕阑热。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18937,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]