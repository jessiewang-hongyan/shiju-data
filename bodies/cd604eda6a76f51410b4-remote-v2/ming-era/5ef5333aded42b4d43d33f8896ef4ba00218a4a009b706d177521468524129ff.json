[{"title":"渡黄河","author":"欧大任","text":"津头小吏候旌干，河激高歌举棹欢。\n天转浮云酸枣决，涛翻斜日具茨寒。\n万行归雁风前过，一片征帆树里看。\n沉璧宣房非汉代，君王无事诏千官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5423,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河上送七郡太守入洛","author":"欧大任","text":"关东犹切九重忧，已报诸侯会洛州。\n梁狱竟劳田叔按，楚筵宁见穆生留。\n嵩邙远近生寒色，瀍涧东西急暝流。\n何日山河还带砺，词臣空忆兔园游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5424,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻空同先生河上草堂","author":"欧大任","text":"西来孤骑过中原，却忆词人旧有园。\n岳色至今干紫极，河声犹似下龙门。\n雪驱梁苑千年赋，云惨浔阳万古冤。\n荒径只今书带满，独留玄草在乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5425,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"汴梁怀古","author":"欧大任","text":"缥缈宫城十二楼，玉津无复昔年游。\n烟深废苑常疑雨，柳折残堤半似秋。\n遗老尚能谈楚汉，平台谁更召枚邹。\n輶轩一望中原路，长送黄河过汴州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5426,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过邺下访谢山人茂秦","author":"欧大任","text":"中原七子似君稀，独向西河老布衣。\n四海风云鸿鹄远，五陵烟月薜萝归。\n竹林青荫乌皮几，铜雀高临白板扉。\n自笑缁尘京洛去，新诗偏忆谢玄晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5427,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丛台","author":"欧大任","text":"磁州北走邯郸道，一上高台万里思。\n马服山从低树见，葛鹅城为浊河移。\n啼乌岂是娇歌日，衰草全非袨服时。\n六国不知蚕食易，西来游客最堪疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5428,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登龙兴寺天宁阁同胡佥宪伯贤阅观音像","author":"欧大任","text":"佛阁淩空百尺浮，六鳌曾此负神丘。\n金身天竺来何日，石塔波罗到几秋。\n恒岳烟消通大漠，滹沱风急涌寒流。\n凭高岂但超尘劫，咫尺彤云是帝州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5429,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初至燕京宿报国寺英上人房","author":"欧大任","text":"长途日暮叩僧扉，疑入名山坐翠微。\n高阁佛灯留客枕，中天禅月照征衣。\n不堪夜梦仍南去，已听春鸿尽北飞。\n回首缁尘心独远，欲从初地得皈依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登毗卢阁","author":"欧大任","text":"东方初日照觚棱，振舄冯高眼倍明。\n四塞河山环大内，诸天楼观俯沧瀛。\n花台似涌云中出，仙袂疑从岳顶行。\n綵槛雕阑闲倚遍，九霄长送凤凰声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓黎秘书馆王全人见过","author":"欧大任","text":"献赋长安春暮来，故人今典汉兰台。\n紫貂贳酒君能过，玉笥藏书客自开。\n金马沉冥犹薄禄，青云冠盖几怜才。\n竹林正是邀欢地，车骑良宵得共陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴侍御约卿宅同黎秘书惟敬杜舍人从殷得臣字","author":"欧大任","text":"日下衣冠散紫宸，郑庄虚席正邀宾。\n鹔鹴燕市频沽酒，鸿雁胡天半过春。\n自笑负薪随计吏，偶从视草识词臣。\n尊前意气惟须醉，世路风尘白发新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5433,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和顾汝和玉河堤上见白燕","author":"欧大任","text":"海上遥思玳瑁梁，御沟东畔几回翔。\n瑶台乍过疑无影，珠树曾栖半带霜。\n风里差池飞玉舄，月中妆束舞霓裳。\n谁云京洛缁尘化，犹自衔恩绕建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5434,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈侍御道襄巡畿甸及齐鲁诸郡","author":"欧大任","text":"虎节翩翩獬豸冠，前驱负弩渡桑乾。\n花飘燕甸春风早，雨过齐州岱色寒。\n东海煮盐纾国计，北庭飞粟募材官。\n芝泥玉检登封地，羡尔云边策马看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5435,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈进士彦吾使密云兼还南海省觐","author":"欧大任","text":"前驱负弩驿亭间，建节东行暂出关。\n霄汉乍辞丹凤阙，风烟先卷白檀山。\n主恩远许封轺去，家庆深欢綵服还。\n莫恋故园春草色，汉庭郎吏待鹓班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5436,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁彦国滦州书至","author":"欧大任","text":"疲马饥衔苜蓿嘶，怜予千里望辽西。\n风驱朔雪卢龙近，云暗春城碣石低。\n帐下谭经留客坐，斋中把酒听莺啼。\n雄文最似相如赋，侍从河东待尔题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5437,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送岑允穆司理池州","author":"欧大任","text":"春深杨柳暗燕关，南去襜帷不可攀。\n雪浪城头江祖石，芙蓉天外李家山。\n讼堂吏散莺堪听，药院僧来鹤共闲。\n秋浦看花能忆否，封书须及早鸿还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5438,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"首夏沈鸿胪宅同吴侍书黎秘书顾舍人赏牡丹","author":"欧大任","text":"玉鞭遥向五陵家，沁水园中日未斜。\n万片綵云飘翠幕，一阑红锦照晴霞。\n席茵最忆江南草，尊酒频看蓟北花。\n欢赏幸陪供奉客，绝胜歌管七香车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5439,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王武库定甫使金陵因还南昌展省","author":"欧大任","text":"供帐都门赠柳条，仙郎衔命下丹霄。\n浮云万里辞燕甸，明月孤亭拥汉轺。\n碧草渐迷扬子渡，青溪还问谢公桥。\n过家莫羡南昌尉，鸣玉含香满圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5440,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同钱水部吴职方施缮部曾虞部登西山绝顶","author":"欧大任","text":"绝嶂西来翠柏残，片霞时堕汉臣冠。\n青天大岳云边出，落日中原马上看。\n玉气重关开碣石，飞泉千折下桑乾。\n欲将凫舄翩翩去，花落天坛露正寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5441,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓出玉泉山经西湖","author":"欧大任","text":"玉泉散作镜湖波，闻道宸游向此过。\n宫阙三山浮弱水，楼船千里度星河。\n白麟朱雁无消息，瑶草金芝近若何。\n词客昔年誇扈从，琳池花似汉时多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5442,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"省中芍药和惟敬","author":"欧大任","text":"苑中红药艳阳催，禁直仙郎宴赏回。\n官锦乍披青玉案，露华深注紫霞杯。\n清芬结佩佳人赠，迟日当阶上客裁。\n词赋王褒今待诏，銮舆临幸几时来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5443,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨夜郑驾部携酒同过黎司封宅时司封已擢广西参藩","author":"欧大任","text":"佩刀解赠意踌躇，把袂燕歌泪满裾。\n客路风烟频汉诏，主恩天地有潘舆。\n蓟门夜色千家雨，桂海秋涛九月书。\n乡里衣冠吾独后，淩云空自老相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中过周园访沈山人与姜膳部对酒作","author":"欧大任","text":"虎林词客宿称豪，下马何人问浊醪。\n醉里山连秦苑树，赋成风起曲江涛。\n雨深绿草胡尘断，云散金茎汉阙高。\n岂有雄文今待诏，桓谭犹道在春曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送司封黎郎中惟和出参广西政","author":"欧大任","text":"凤城芳草散鸣珂，横笛谁堪马上歌。\n荆楚晓烟飞越巂，湘漓秋色入牂牁。\n省郎剑佩云霄远，词客江潭岳牧多。\n玉节明年应趣召，咸阳西上莫蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬王舍人仪甫潞河见寄","author":"欧大任","text":"骊驹几日出燕关，咫尺青云不可攀。\n便访安期沧海上，谁容方朔汉庭间。\n故人书札愁中寄，逐客风烟梦里还。\n秋色王程应渐远，知君西望太行山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"约卿宅同元白惟敬咏盆荷得前字","author":"欧大任","text":"华顶曾窥玉井前，燕阳还赋九花莲。\n秋风细洒池边石，暑气全消雨后天。\n鱼戏绿波经十里，龟游清露已千年。\n因思溪上芙蓉馆，谁更菱歌上钓船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜饮诸太史端甫宅","author":"欧大任","text":"周南初返直庐年，朝退能开野客筵。\n宫锦夜披明月下，禁钟秋到凤楼前。\n玉绳低映长安树，仙掌高擎白露天。\n方朔自惭还索米，汉庭空有故人怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同元白惟敬过约卿所出鲥鱼侑酌感赋","author":"欧大任","text":"赐鲜今见出青冥，旅食京华鬓已星。\n珠履尚弹孤客铗，金盘宁羡五侯鲭。\n天遥渔艇三江水，秋入鲈乡万里亭。\n何处沧洲无钓侣，清时犹自恋宸扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新秋同文寿承沈懋学文休承许殿卿姚元白黎惟敬集吴约卿高斋得飞字","author":"欧大任","text":"初闻征雁送斜晖，凉夜高斋此会稀。\n沧海月从危堞过，太行云入小窗飞。\n狂来每忆莲池咏，醉后还寻竹径归。\n万里秋风长作客，尊前空愧薜萝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送许右史殿卿之河南","author":"欧大任","text":"曳裾闻尔相东平，诏许亲藩借老成。\n梁苑词臣齐客在，济南经术汉家名。\n驱车落日河流远，策杖秋风岳顶行。\n莫叹壮游今已倦，主恩还遣入西京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"万寿节早朝皇极门","author":"欧大任","text":"清秋阊阖曙光分，逢掖追趋谒圣君。\n南极一星珠斗近，嵩呼三祝绛霄闻。\n九傧赞后班群瑞，八伯歌成下五云。\n白雉赤麟誇盛事，兰台还奏汉都文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朝退出右掖望西苑","author":"欧大任","text":"紫宸分仗散千官，谁奉西清曲宴欢。\n瑶水风云随玉辇，蓬莱宫殿接金銮。\n九霄幡影玄坛閟，五夜钟声碧落寒。\n却忆甘泉秋色里，侍臣多在月中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卢方伯少明入京中秋见邀玩月","author":"欧大任","text":"使车南去少能留，此地还期月下游。\n万里星环燕阙夕，九关榆落蓟门秋。\n已闻卿相频推毂，自笑风尘老敝裘。\n宾从他宵还对酒，不知谁共庾公楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十六夜小斋待月元白约卿同赋","author":"欧大任","text":"东来车骑访幽栖，共待清光手重携。\n九市烟尘人境外，万家砧杵帝城西。\n黄山远见宫槐直，紫阁平临海树低。\n何事天涯问圆缺，故园应待尺书题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十七夜同何太仆卢方伯袁节推集黎秘书宅","author":"欧大任","text":"赐金几日出西京，秘省留欢此夕情。\n渐望使星天畔去，尚悬卿月禁边明。\n腾骧独识秦关骑，战伐曾谈涨海兵。\n只尺君恩如召问，上书何以答升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日同黎秘书李黄门吴冯二侍御登宣武门楼","author":"欧大任","text":"百二山河控上游，郁葱佳气满皇州。\n风驱大漠浮云色，天转滹沱落日流。\n双阙金茎连紫极，万家红树动高秋。\n佩萸氿菊俱恩泽，不是荆南独倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何太仆入贺还平凉","author":"欧大任","text":"长安何处望萧关，醉里燕歌一解颜。\n辑瑞北来趋魏阙，封轺西去过秦山。\n城连上郡羌胡远，马饱中原战伐闲。\n乘障莫嗟边吏苦，玺书行召护军还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸亥明堂大祀礼成纪事","author":"欧大任","text":"甘泉高擢汉明庭，更筑崇台礼万灵。\n宗祀偶同书癸亥，中兴谁复数殷丁。\n芝生九叶铜池碧，日抱重光玉树青。\n前殿公卿频上寿，万年何用禅云亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送姚匡叔之魏郡兼寄谢茂秦","author":"欧大任","text":"萧萧一骑渡洺河，知有心期在薜萝。\n漳滏波声黄叶下，邢襄秋色白云过。\n股肱三辅分庭少，笔札诸生任侠多。\n后夜西园应见月，谢家新赋更如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过沙河行","author":"欧大任","text":"离宫千里苑城开，扈从当年尽汉才。\n凤扆尚留清禁肃，龙游曾奉属车来。\n日高复道晨驱出，星散周庐夜徼回。\n宣曲长杨俱望幸，彩云深护建章台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒长陵","author":"欧大任","text":"居庸叠嶂俯桑乾，终古长陵王气盘。\n凉雨石城千堞雪，秋风金阙万松寒。\n鼎湖弓剑胡天远，原庙衣冠汉月残。\n三驾犁庭思帝力，北门封守在长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阳翠岭","author":"欧大任","text":"丛霄积翠筑金墉，仙仗曾过第一峰。\n海日夜摇三殿玉，园霜秋落七陵钟。\n石当御路皆成鹿，松起中天半是龙。\n圣主合符临万国，侍臣谁更颂东封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李尚宝册封肃府","author":"欧大任","text":"曾使琉球海上行，又驰关陇别承明。\n兰山星散千秋垒，榆谷天连万里城。\n负弩绛驺迎玉节，直庐青琐忆金茎。\n汉家茅土雄边镇，从此河湟不用兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送沈给事册封周府","author":"欧大任","text":"礼重亲藩命汉官，手持金册出长安。\n睢阳旧苑鸣驺入，洛涘名园载酒欢。\n积雪歌声犹缥缈，夹池竹色尚檀栾。\n相如亦有游梁兴，何日平台醉后看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈侍御道襄出按闽中","author":"欧大任","text":"天书朝捧禁城西，骢马翩翩向晚嘶。\n三策锁闱周礼乐，六条行部越山溪。\n频年戈甲穿篁竹，此日渔樵罢鼓鼙。\n绝徼早宣明主意，勋名麟阁待君题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答施虞部曾缮部同直省中见怀","author":"欧大任","text":"对直寒宵向省闱，仙郎词赋有光辉。\n高悬霜月联曹近，闲锁冰厅见吏稀。\n梦隔关城砧杵急，心随江汉雁鸿飞。\n草玄寂寞无人问，自笑长安一布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄参军赴闽幕","author":"欧大任","text":"君行气激五都豪，闽越频年尚属櫜。\n簪袅军劳秦爵贵，奉常家学汉庭高。\n图中按垒窥鱼腹，幕下持觞论豹韬。\n别去从军诗早寄，故人还赠吕虔刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中曾缮部携酒同黎秘书夜过得长字","author":"欧大任","text":"并马移尊问草堂，茂陵秋色正苍苍。\n城头笛起关山月，槛外砧飞汉苑霜。\n多病更堪羁思苦，清欢其奈鬓丝长。\n芸台水部能来往，倦客浑忘在异乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次夕黎秘书携酒曾缮部同过得霄字","author":"欧大任","text":"故人尊酒慰萧条，并控骅骝意气骄。\n郢里高歌回白雪，燕台寒色满青霄。\n城边明月鸿声起，灯下清霜木叶飘。\n此夕谢庄惭作赋，词臣多在圣明朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病起曾缮部夜过","author":"欧大任","text":"倦疾柴门夜不扃，三年萧寺只沉冥。\n瀑窗药试疑瞳碧，山笥书成愧汗青。\n明月颇思玄度咏，浊醪能问子云亭。\n他宵松落空坛静，谁共幽人石上听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"施虞部敦甫寄诗问予卧病次韵奉答","author":"欧大任","text":"萧斋偃卧即山林，门掩藜床岁月深。\n市里玉壶聊混俗，省中词客限同心。\n拥衾洛下书生咏，击节幽州马客吟。\n赖有故人相慰藉，不须重问橐中金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十月虏警书事三首 其一","author":"欧大任","text":"朔气初飞万树霜，惊传胡马过渔阳。\n从军岂乏三河少，度漠曾招六郡良。\n鸣镝月寒窥雁塞，射雕云暗散龙荒。\n皇威赤羽劳诸将，不似周王拥白狼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十月虏警书事三首 其二","author":"欧大任","text":"甘泉烽火到长安，阙下衣冠立马看。\n北转储胥刍粟富，西来骠骑雪霜寒。\n观兵帐外期超距，拜将庭中议筑坛。\n细柳已屯江总制，月明羌笛满桑乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十月虏警书事三首 其三","author":"欧大任","text":"关塞秋阴暗白登，飞狐道上羽书仍。\n云屯汉卒徵三辅，风急胡笳过七陵。\n暂向太原称薄伐，已知吉甫佐中兴。\n书生亦有燕然颂，待勒恒山第几层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答张民部饷军左安门寒夜见寄","author":"欧大任","text":"飞刍忽上白云边，知尔登楼啸远天。\n半夜军声胡垒月，万家寒色蓟门烟。\n檄成楯鼻提兵日，箭落旄头破虏年。\n投笔欲随骠骑去，汉庭勋业在祁连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵酬曾缮部以三斋居省中见怀","author":"欧大任","text":"燕台风起暮萧骚，念我偏题尺牍劳。\n阔略幸无三府辟，激昂终愧五陵豪。\n公车岁月囊钱尽，郎署云霄剑佩高。\n停辇若逢明主问，莫言宾客有绨袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和梁彦国虏退后行经三河诸村落慨然见寄","author":"欧大任","text":"战后秋阴蓟柳疏，怜君驻马为踌躇。\n烽沉万垒荒烟外，鬼哭千村野烧馀。\n霜草有狐啼废井，夕阳无鸟入残墟。\n防胡李牧须频遣，莫更边庭走檄书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兵后梁彦国自滦州见过","author":"欧大任","text":"辽海君如管幼安，萧条一骑客行难。\n堠边星落秦皇戍，战后云愁汉将坛。\n驿路飞沙千里暗，海风吹雪万山寒。\n灯前独照昆吾剑，长得蛟龙夜夜看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜同梁彦国宿永光寺禅房怀故园诸子得来字","author":"欧大任","text":"江南词赋有群才，曾共高僧社里来。\n人忆歌骊辞粤峤，客疑招骏上燕台。\n寒翻贝叶斋前诵，香识梅花雪后开。\n惟与许询禅此夕，故园书待雁飞回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中同梁彦国过文寿承学舍","author":"欧大任","text":"袖中怀刺倦尘沙，清晓寻君坐日斜。\n客食空斋惟苜蓿，宦情高阁有梅花。\n庭阴独下孤山鹤，禁雪遥栖万树鸦。\n经学汉儒推博士，何人江左更名家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜同惟敬饯别彦国还卢龙得高字","author":"欧大任","text":"浊酒寒宵共尔曹，明朝东去客途劳。\n山窥上谷孤城月，关倚玄菟万里涛。\n黄竹当歌燕雪积，白云随骑朔风高。\n期君早献甘泉赋，金马词臣待彩毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送许舍人稚干请告还灵宝","author":"欧大任","text":"金门侍从捧纶音，去采三花结远心。\n令伯表陈臣分浅，茂陵书在主恩深。\n雪凝嵩少扶藜往，云起殽函驻马吟。\n东阁故人应暂别，岂容簪绂卧山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]