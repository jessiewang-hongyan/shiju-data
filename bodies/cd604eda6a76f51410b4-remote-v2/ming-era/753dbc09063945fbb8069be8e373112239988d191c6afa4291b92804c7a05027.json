[{"title":"罗浮山三十咏 其五","author":"成鹫","text":"宿雨初晴策短藜，看云行到乱峰西。\n眼前图画无人绘，皮里诗囊且自携。\n果熟静观连蒂落，松高曾记与眉齐。\n分明一簇香风过，开遍山楂又木樨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮山三十咏 其六","author":"成鹫","text":"六时禅诵又斜曛，童子烧香礼愿文。\n向晚也须迟掩户，前峰犹有未归云。\n岩猿宿树仍留果，社鼠依山亦断荤。\n莫怪痴心爱狂黠，相逢尽道不如君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮山三十咏 其七","author":"成鹫","text":"清晨客至暮方还，问我何心住此间。\n在世但知聊寄迹，旁人都说是居山。\n近嫌路有樵人识，渐觉门须侍子关。\n他日与君相见处，断崖移屋不堪攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮山三十咏 其八","author":"成鹫","text":"云头雨足楚姓腰，特地奇峰出汉霄。\n微路暗通行石腠，把茅牢结凭松寮。\n灶边泉号孤僧井，屋角田供一岁瓢。\n个是老夫归宿处，时人惊弃幸相招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49363,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮山三十咏 其九","author":"成鹫","text":"终朝役役叹吾曹，络马穿牛共一牢。\n野茧结成空自缚，文蛾飞去不堪缫。\n重楼变幻随孤蜃，大地浮沉仗六鳌。\n何处藏身没踪迹，华亭船子自家操。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49364,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮山三十咏 其十","author":"成鹫","text":"一日能閒一日过，山中幽事岂须多。\n风前众窍呈庄籁，月下群猴学楚歌。\n土掬丹炉泥破灶，叶收仙篆补残蓑。\n外边凭语应难信，曾记儿时讶橐驼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49365,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮山三十咏 其十一","author":"成鹫","text":"大地全安曲录床，尚馀閒隙置皮囊。\n三间破屋难留客，一个孤僧亦过堂。\n纳得须弥无芥子，持来赝药有真方。\n闭门刈取庭除草，归去炉头较短长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49366,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮山三十咏 其十二","author":"成鹫","text":"昨夜灯前细雨声，晓来林鸟报新晴。\n日乘风势排窗入，云写山光对枕横。\n莲房未落兼花供，芋屋初开带叶烹。\n二六时中且如此，明朝依旧可怜生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49367,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮山三十咏 其十三","author":"成鹫","text":"飞云天半碧层层，万仞孤峰不易登。\n行遇断崖看撒手，去当无路莫牵藤。\n一茎细草皆成药，方寸閒田可住僧。\n多少懦顽难到处，程途终日问南能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49368,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮山三十咏 其十四","author":"成鹫","text":"经旬铜片一开奁，静处窥形敢自嫌。\n任运去留今面目，因人颦笑旧须髯。\n山风浩浩云归岫，天宇澄澄月到帘。\n独往独来还独语，我生何幸老穷檐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49369,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其一","author":"成鹫","text":"隔水看山东复东，片云无住寸心同。\n出逢岐路谁家子，钓尽江波何处翁。\n覆顶千丝难禁雪，当门两齿不关风。\n身閒投老知何日，独倚孤筇问碧空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49370,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其二","author":"成鹫","text":"海涛近枕夜淙淙，旅梦乡心未易降。\n乘月一归云里洞，挂帆犹记寺临江。\n三身衣覆枯僧榻，四壁灯明古佛幢。\n香印半销人定后，飞虫何事触明窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49371,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其三","author":"成鹫","text":"何须领众复匡徒，无事天真佛一躯。\n飏下屠刀知广额，策开眉睫见宝卢。\n宋人什袭藏顽石，胡贾千金市世珠。\n大地有禅吾亦老，故山归去作樵夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49372,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其四","author":"成鹫","text":"大好随身五尺藜，临行遗落石房西。\n青山久客不归去，白发老僧凭借携。\n忆昨破鞋乘月往，有时高笠与云齐。\n秋来胜事知多少，辜负堂前古木樨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49373,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其五","author":"成鹫","text":"洞里主人去不来，好山抛向白云堆。\n岩花落尽空中雨，野火烧残劫外灰。\n虚室岂宜终日闭，重门相待及时开。\n悬知开后仍虚室，寄语同参莫见猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49374,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其六","author":"成鹫","text":"溪山非舌亦非身，久去重来见益亲。\n四百峰中开别院，三千里外结芳邻。\n苔生碧砌青如染，镜锁明窗净不尘。\n为报诸方参学者，罗浮深处近无人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49375,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其七","author":"成鹫","text":"海气苍茫日色曛，客窗谁与细论文。\n蹉跎别路连风雪，惆怅家山隔水云。\n地足槟榔无菜茹，门饶鹳鹤厌腥荤。\n几回欲寄南中信，底事何堪举似君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49376,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其八","author":"成鹫","text":"野老经年别古坛，东林岑寂叶重丹。\n鹤藏雪里微窥顶，鸡斗蓬中自正冠。\n月满铁城人过少，腊残琼琯客归难。\n春来拟补尖头屋，去拾松花就地餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49377,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其九","author":"成鹫","text":"当时一入便忘还，分得云房屋半閒。\n笑我住来仍渡海，输他飞去不离山。\n抛将松竹无田地，领取生涯有死关。\n庵主纵归难得见，孤峰从此绝跻攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49378,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其十","author":"成鹫","text":"岁暮方思住洞天，斧冰临涧煮寒泉。\n半閒茅屋连朝雨，品字柴头一缕烟。\n山色去心无咫尺，路岐回首已三千。\n他时得遂投閒计，不拟将心更学禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49379,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其十一","author":"成鹫","text":"三条篾束十四腰，渐远尘寰近碧霄。\n云水相投因系屋，蕨薇将罄便移寮。\n人间未易开双眼，林下还思挂一瓢。\n早晚閒身定归去，小山丛桂不须招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49380,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其十二","author":"成鹫","text":"九十春秋强半过，住山时节苦无多。\n海滨自顾垂垂老，林下还思踏踏歌。\n云壑晚烟笼瀑布，石门晴日晒藤蓑。\n主人何事不归去，笑杀南村郭橐驼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49381,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其十三","author":"成鹫","text":"一钵雕胡七椀茶，衲僧随分有生涯。\n摩醯顶上开新眼，香象云中瘗旧牙。\n结社更思修白业，还山不拟煮黄芽。\n庵西道者如相问，宕子年来解破家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49382,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其十四","author":"成鹫","text":"止有云霞覆短床，不留馀物在空囊。\n因探泉脉移茶灶，为爱松风结草堂。\n一日别山同隔世，经年高枕当参方。\n老来渐觉无筋力，归路争如归兴长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49383,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其十五","author":"成鹫","text":"多谢山翁远寄声，别来林下几阴晴。\n阶前埽叶云容乱，树底窥花雀尾横。\n拾得仙砂无法煮，种成鬼芋待时烹。\n知君笑我长为客，归日何曾面目生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其十六","author":"成鹫","text":"洞门流水碧泠泠，经过人间不暂停。\n溪舌广长当下见，雷声浩大静中听。\n逶迤入海成波澜，迢递看山隔杳冥。\n独有庵西泉一线，夜来涵月浸空庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其十七","author":"成鹫","text":"孤峰云外有千层，竹杖扶身独自登。\n绝壁诛茅成矮屋，当门红树挂枯藤。\n森森棘布三叉路，密密囊藏一个僧。\n算定生涯归欲早，人前惟谢百无能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其十八","author":"成鹫","text":"独木桥边水自流，閒鸥野鹤目相投。\n垂杨未识青骢马，细草遍宜白牯牛。\n海日射开新病眼，晨钟惊起老枯髅。\n山中事事堪相忆，昨夜松窗月一钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其十九","author":"成鹫","text":"桐树千岁孤根深，蒙君斲作囊中琴。\n旁观一唱复三叹，静听七弦成五音。\n得意失意岂真性，有声无声皆苦心。\n何如生长峄阳谷，风雨潇潇龙自吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其二十","author":"成鹫","text":"饮光未是识瞿云，关吏何曾见老聃。\n四十九年无一字，五千言下尽虚谈。\n岳边万派全归海，岛外千峰自向南。\n一个孤僧天畔立，不知谁与盍朋簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其二十一","author":"成鹫","text":"癯形衰态笑窥奁，世眼相逢岂免嫌。\n自有天生穷骨格，不须人羡美髭髯。\n林间得病常欹枕，海外无寒亦下帘。\n正忆故山此时节，梅花和雪压重檐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客珠崖怀罗浮寄山中诸子三十韵 其二十二","author":"成鹫","text":"细写新诗寄岭南，区区谁识是空函。\n止啼黄叶从君玩，无口匏瓜且自缄。\n风转谷声鸣众籁，日回竿影下长杉。\n何人领取居山去，脱却平生鹘臭衫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其一","author":"成鹫","text":"来牛去马任西东，云月溪山各异同。\n莲社久虚清论地，槐花多笑白头翁。\n前窗破梦三更雨，隔案翻书六月风。\n群动自喧吾自寂，时人休道是顽空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其二","author":"成鹫","text":"青门何处觅侯封，占得荒山老此农。\n云气有时遮矮屋，风涛无故响高松。\n肩泉自拟寻源入，腰石还思索米舂。\n人世欲閒閒不得，鸡声啼破五更钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其三","author":"成鹫","text":"高泉过雨自淙淙，独坐无心外境降。\n断送浮云归八极，止留孤月印千江。\n野狐队里燃华表，顽石中閒建法幢。\n惭愧有情偏识我，十年前已掩蓬窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其四","author":"成鹫","text":"升沉何用更图惟，道在能贫数合奇。\n冻澈冰河宁有底，花开枯木不相知。\n门因避地重重闭，屋仅容身度度移。\n本是钓鱼船上客，往来不惮八风吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其五","author":"成鹫","text":"閒从物外识真机，会得希夷更入微。\n鹏鴳总教乘化往，鹪鹩宁羡控天飞。\n过桥车马黄金勒，隔竹人家白板扉。\n久住东林僧渐老，旧游何日许同归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其六","author":"成鹫","text":"明知水到便成渠，夙习难忘未废书。\n痴想筌蹄得鱼兔，贪看标指失蟾蝫。\n人间岂有憨于我，世路应无懒似予。\n几度欲抛文字去，坳堂添水学栽渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其七","author":"成鹫","text":"乘车戴笠总吾徒，衣锦披缁等幻躯。\n尘世交驰看野马，猎心腾跃笑韩卢。\n庶人自爱怀中璧，稚子争探颔下珠。\n老我闭门无一事，日持高论著潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其八","author":"成鹫","text":"隔林烟火晚蒸藜，寂寞茅堂返照西。\n送客懒从桥上过，爱琴閒向石边携。\n老来少事贫偏好，静到无心物也齐。\n却笑当年黄太史，花时犹自说闻樨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其九","author":"成鹫","text":"经年不挂放参牌，自拟将身活活埋。\n病后止存真面目，梦中无复旧恢谐。\n白云共住寒分榻，红树当门影接街。\n蛙鼓未终虫韵继，知音何处觅同侪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其十","author":"成鹫","text":"长与红尘断往来，茅堂移在白云堆。\n发同木叶逢秋改，心似炉烟向晚灰。\n老树偏宜孤鹤立，幽花止为一人开。\n溪翁本是忘机者，珍重群鸥莫见猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其十一","author":"成鹫","text":"局外输赢物外身，闭门猿鹤自相亲。\n风摇竹影侵虚幌，雨过山光在隔邻。\n鼠堕空瓶惊绝粒，蛩鸣冷甑笑生尘。\n年来识得贫中乐，一盗高悬懒向人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其十二","author":"成鹫","text":"倚杖柴门送夕曛，长歌三复北山文。\n了无痴梦投青琐，止有閒身伴白云。\n沙市晚喧饶笋蕨，村童久住厌辛荤。\n斋厨午后无烟火，自把茶瓯对此君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其十三","author":"成鹫","text":"日出东林众壑暄，野花开遍小桃源。\n行吟不负孤筇力，独坐偏宜老树根。\n顽铁转身成俗物，名山到处有田园。\n生平乐事唯知足，莫怪閒人妄自尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其十四","author":"成鹫","text":"一片蒲团覆石坛，枫林垂荫映眉丹。\n新知不羡腰缠玉，往事休论发指冠。\n满地征尘生计拙，弥天荒草路行难。\n时人莫笑西山饿，周粟繇来不易餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其十五","author":"成鹫","text":"牧笛樵歌日往还，近嫌住处逼人间。\n年丰雀鼠犹争食，果熟猿猴不共山。\n老去机心聊自息，贫来米价复相关。\n罗浮旧隐宁忧此，绝顶孤峰更拟攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其十六","author":"成鹫","text":"谷口晴阴别有天，夜来新雨长红泉。\n湿云不放冰河燄，破屋全销冷灶烟。\n隔浦远香生杜若，长林寒色老君千。\n繁华寂寞秋风里，消得山僧半日禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其十七","author":"成鹫","text":"却缘不折督邮腰，老鹤腾身上九霄。\n绿水青山新地主，黄冠白发旧同寮。\n顽砖拘去磨为镜，大瓠栽成剖作瓢。\n惆怅故交多已贵，隔江相见谩相招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其十八","author":"成鹫","text":"懒似林间五白猫，日高犹自卧堂坳。\n草鞋久别因耽坐，布被长蒙为病哮。\n废尽桔槔甘我拙，抛残棋局倩谁饶。\n安居已过门犹闭，何处秋声上竹梢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其十九","author":"成鹫","text":"别畛分疆笑尔曹，百年幻宅不坚牢。\n蒸沙作饭终难饱，独茧抽丝未易缫。\n天际雨声喧石燕，江潮月色满车螯。\n閒来渐觉虚舟稳，平浪轻风且自操。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其二十","author":"成鹫","text":"漫劳车马枉经过，僧老空门胜事多。\n入座山花争解语，隔林幽鸟自能歌。\n翻嫌谢传留双屐，却恨严光欠一蓑。\n万法本閒人自闹，此心吾欲问仙陀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其二十一","author":"成鹫","text":"独上孤楼杖古茶，泬寥秋色在天涯。\n赤城日落如悬鼓，紫逻峰高拟建牙。\n草泽有人歌麦秀，风霜无地护兰芽。\n看谁得似云边翼，来往虚空处处家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其二十二","author":"成鹫","text":"云中高枕石为床，万事无如静括囊。\n人到老年閒悄悄，月当中夜露堂堂。\n纸衣补就云千片，铁笛吹残水一方。\n多少旧游许相过，出门无那路迂长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其二十三","author":"成鹫","text":"一般啼鸟两般声，半日浓阴半日晴。\n马麦满盘随饮啄，雀罗当径任纵横。\n閒身懒就三台舞，瘦骨那堪五鼎烹。\n何事不抛文字去，尚留夙习送馀生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其二十四","author":"成鹫","text":"閒门秋水日清泠，万竹交加抱一亭。\n过客未须寻路入，高歌谁许隔墙听。\n坐看精卫填东海，翻笑鲲鹏化北冥。\n老去渐知生意少，夜来添火读黄庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其二十五","author":"成鹫","text":"占得孤峰最上层，断崖绝壁少人登。\n黄猿独坐啼清昼，白鸟群飞立古藤。\n借地百年聊作客，出门千里不逢僧。\n老来空有名山约，拨草瞻风愧未能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其二十六","author":"成鹫","text":"浊水滔滔不住流，寸胶珍重莫轻投。\n僧眠冷榻旁栖鹤，人老荒村静牧牛。\n金马风云销肮脏，铜驼荆棘枕骷髅。\n门前大道如弦直，日久行多曲似钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其二十七","author":"成鹫","text":"睡起空山夜正深，茅堂寂寞静风琴。\n满床明月连孤影，隔壁寒螀惠好音。\n老去有身聊寄迹，閒来无处可徵心。\n冷灰爆出星星火，拥鼻何忍更苦吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其二十八","author":"成鹫","text":"自从屋里种优昙，不愿函关见李聃。\n近与宗雷开净社，岂知五谢善清谈。\n蛰虫未雨争辞穴，宾雁先寒尽向南。\n物理如然吾亦尔，故人相劝早抽簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其二十九","author":"成鹫","text":"贯珠叠翠作妆奁，归去金堂未免嫌。\n香阁但知誇粉黛，藁砧相见笑须髯。\n朦胧好梦愁欹枕，寂寞寒灯懒下帘。\n何似阿姨贫不字，长斋甘老破茅檐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马山杂咏三十韵 其三十","author":"成鹫","text":"相逢何用更喃喃，新得金人肘后函。\n至道本来唯一默，吾生从此愿三缄。\n曾无恶浪欺顽石，岂有惊涛下秃杉。\n我纵不言君也会，是非留在七斤衫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]