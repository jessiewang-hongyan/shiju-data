[{"title":"卫河夜汎 其二","author":"王世贞","text":"白波如练掣长空，上下银河一色通。\n歌罢朝来新乐府，满天寒色起丹枫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀徐子与 其一","author":"王世贞","text":"马首平城雨雪多，故人仙棹霅中过。\n宁知日暮江南曲，不异秋风塞上歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀徐子与 其二","author":"王世贞","text":"驻马相逢邢大夫，玉卮亲上紫酡酥。\n俱称汉使由来贵，为问徐卿定有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀吴明卿 其一","author":"王世贞","text":"使君车马自风尘，闻尔匡庐发兴新。\n落日千峰秋色里，不知何处斗嶙峋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀吴明卿 其二","author":"王世贞","text":"遥怜李白在浔阳，纵酒狂歌秋兴长。\n夜夜银河萦斗色，肯教龙剑吐风霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题沈参军竹林图","author":"王世贞","text":"谁家十万碧琅玕，个个春云秀可餐。\n我是王猷君更熟，何妨一问主人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"提兵海上戏呈袁将军","author":"王世贞","text":"十年文战蓟门空，东海兵符倚画熊。\n却恨少时疏剑术，欲将身事白猿公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄辽阳罗将军 其一","author":"王世贞","text":"十年辽海斗兵稀，边马乘秋转更肥。\n共道嫖姚新按塞，不愁明月满金微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄辽阳罗将军 其二","author":"王世贞","text":"医无闾畔暮云齐，回首军城万垒低。\n莫怪鲜卑惊白马，使君原是旧安西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"调唐将军 其一","author":"王世贞","text":"将军荡寇大江还，蹀?霜蹄未拟閒。\n自是封侯飞骨在，任教明镜负刀环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"调唐将军 其二","author":"王世贞","text":"十万楼船下濑兵，已乾东海腊长鲸。\n如何戍角依然在，夜夜征夫向月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴峻伯校诸生走笔二绝 其一","author":"王世贞","text":"群山秀色静临衙，日暖风微绛帐纱。\n万马自应空伯乐，千人重见屈田巴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴峻伯校诸生走笔二绝 其二","author":"王世贞","text":"何人东向坐诸生，倡雪悬河稷下倾。\n组练鎏戈霜一色，使君亲教五家兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和峻伯蓬莱阁六绝 其一","author":"王世贞","text":"坐看红日映天鸡，曙色中原一瞬齐。\n雄观古来谁得似，昆崙高柱大荒西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和峻伯蓬莱阁六绝 其二","author":"王世贞","text":"虚无紫气映蓬莱，水落青天忽对开。\n已借鳌簪为岛屿，还从蜃口出楼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和峻伯蓬莱阁六绝 其三","author":"王世贞","text":"绛节秋逢鸾鹤群，安期遣信欲相闻。\n袖中亦有千年枣，不羡瀛洲五色云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和峻伯蓬莱阁六绝 其四","author":"王世贞","text":"早晚苍龙自在眠，春波织就蔚蓝天。\n风雷忽捲秦桥去，日月还依禹碣悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和峻伯蓬莱阁六绝 其五","author":"王世贞","text":"万乘秋风屈布衣，沧桑今古定谁非。\n田横五百应如在，徐市三千竟不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和峻伯蓬莱阁六绝 其六","author":"王世贞","text":"君汎仙槎拟问津，我从东海学波臣。\n隋珠却坠双明月，鲸岛寒光夜夜新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"于鳞尝为四怀诗寔首余世贞焉其次四寄某某子甲也乃世贞则亦首于鳞馀三人同之寄倍之矣风雨如晦飞龙乖隔每一讽咏泪下绠縻然又有私慰焉于鳞故已挂冠垂当得会耳寄以言托也是不必数子见之 其一 怀于鳞","author":"王世贞","text":"黄鹄秋翔太华颠，坐攀仙掌扑青天。\n乘风忽傍东溟转，矫首扶桑帝日悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"于鳞尝为四怀诗寔首余世贞焉其次四寄某某子甲也乃世贞则亦首于鳞馀三人同之寄倍之矣风雨如晦飞龙乖隔每一讽咏泪下绠縻然又有私慰焉于鳞故已挂冠垂当得会耳寄以言托也是不必数子见之 其二 怀明卿","author":"王世贞","text":"鸿归重枉豫章书，不向钧天梦帝居。\n若使府公誇束带，便携妻子入匡庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"于鳞尝为四怀诗寔首余世贞焉其次四寄某某子甲也乃世贞则亦首于鳞馀三人同之寄倍之矣风雨如晦飞龙乖隔每一讽咏泪下绠縻然又有私慰焉于鳞故已挂冠垂当得会耳寄以言托也是不必数子见之 其三 怀子相","author":"王世贞","text":"越王山拥七闽秋，天入东南大海收。\n雨后虹霓看不见，何人截取钓鳌钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"于鳞尝为四怀诗寔首余世贞焉其次四寄某某子甲也乃世贞则亦首于鳞馀三人同之寄倍之矣风雨如晦飞龙乖隔每一讽咏泪下绠縻然又有私慰焉于鳞故已挂冠垂当得会耳寄以言托也是不必数子见之 其四 怀子与","author":"王世贞","text":"武平之山胜武夷，汀江如巴学字移。\n但道江山多气色，不知新著谢公诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄俞仲蔚","author":"王世贞","text":"病后青山足卧游，愁时白雪自为酬。\n开门草色迷三径，刺史干旄不可求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄谢茂秦","author":"王世贞","text":"亦知留赵鲁先生，片语能尊万乘名。\n何事平原无上客，却教双璧赠虞卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李伯承","author":"王世贞","text":"汉帝秋风在柏梁，一时词赋有辉光。\n那知此日文园令，犹有金茎露未尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄魏顺甫","author":"王世贞","text":"白云高省意蹉跎，华发萧条掩镜过。\n莫怪相闻多楚调，秋风自傍楚人多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄余德甫","author":"王世贞","text":"当年握手帝城春，馆客平津日夜新。\n君自误传流水调，朱门只许抱竽人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张肖甫","author":"王世贞","text":"离亭太白泻流霞，马首横刀意气誇。\n一自相如归使后，至今春雪满三巴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄应在明","author":"王世贞","text":"寒灯晕碧影重重，匣里吴钩欲化龙。\n莫向尊前论旧事，满天霜色锁芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"于鳞慰余哭子有答 其一","author":"王世贞","text":"读罢新诗涕暗垂，朱帘愁对月如圭。\n自来天上无知己，虚怨庭前玉树枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"于鳞慰余哭子有答 其二","author":"王世贞","text":"十年空抱两麒麟，依旧天涯一病身。\n欲付五车王粲去，蓟门犹有受书人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏呈王佥宪入贺","author":"王世贞","text":"故人相见时相及，但道嵇生懒自如。\n囊里俸钱沽酒尽，不须重草绝交书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过靳八公题壁 其一","author":"王世贞","text":"纵横风雨尚如新，下马摩挲读未真。\n此际靳公应大笑，笑余虚是谪仙人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过靳八公题壁 其二","author":"王世贞","text":"虬书昼隐薜萝寒，石髓如粳绝可餐。\n但得长生似王烈，不须重索秘文看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答吴峻伯 其一","author":"王世贞","text":"李生华岳吾岱岳，各有新诗在上头。\n不散星辰南北极，未交风雨占中州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"