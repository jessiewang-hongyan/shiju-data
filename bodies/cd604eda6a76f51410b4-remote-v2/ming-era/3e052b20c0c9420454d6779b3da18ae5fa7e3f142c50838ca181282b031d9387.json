eror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高唐王邸夜宴口占","author":"王世贞","text":"翡翠春温金屈卮，青天璧月浸蛾眉。\n君王莫更留髡饮，政是能胜一石时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送客吕生谒赵生因问谢山人 其一","author":"王世贞","text":"丛台歌舞四时春，君去平原客更新。\n双璧连城都不换，却教将赠立谈人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送客吕生谒赵生因问谢山人 其二","author":"王世贞","text":"平明策马渡漳河，回首东秦紫气多。\n若见谢榛应借问，不知华发傍谁过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓬莱阁后六绝 其一","author":"王世贞","text":"东望鼍矶插汉高，坐来峰屿小秋毫。\n不知云雾连波长，漫道任公已钓鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓬莱阁后六绝 其二","author":"王世贞","text":"高城钟鼓唤苍茫，海若镕波浴太阳。\n绮色中天徐散尽，空青一点是扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓬莱阁后六绝 其三","author":"王世贞","text":"初月弓弯碧海秋，乱峰如镞碍云流。\n鲛人只讶秦皇至，使者还疑肃慎留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓬莱阁后六绝 其四","author":"王世贞","text":"不尽沧波返照红，千寻霞锦蹙回风。\n中流忽迸真珠起，知是垂天饮白虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓬莱阁后六绝 其五","author":"王世贞","text":"汉兵飞度下朝鲜，十万旌旗鸭绿悬。\n烽戍祗今寒月色，可闻杨仆将楼船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓬莱阁后六绝 其六","author":"王世贞","text":"杖底秋风忆旧游，题诗应在阁东头。\n长令风雨千山合，不逐星辰五夜收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄致仕尚书山阴何公","author":"王世贞","text":"嵇山别墅倚云开，新放尚书天上回。\n客至不妨棋局赌，主恩还乞鉴湖来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏为登州歌四章 其一","author":"王世贞","text":"空令小妇怨辽阳，只隔风烟一水长。\n不道天河才咫尺，双星夜夜永相望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏为登州歌四章 其二","author":"王世贞","text":"十三娇小学搊筝，搊得筝如鸾凤鸣。\n却问秦王何处去，不教童女访蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏为登州歌四章 其三","author":"王世贞","text":"约伴烧香海庙行，就中商妇独含情。\n由来海市惟看影，恰似狂夫枉得名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏为登州歌四章 其四","author":"王世贞","text":"弹子涡畔水争流，小石星星滑似油。\n不惜红裙裹将去，与郎花下斗藏钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"单家桥赠杨柳","author":"王世贞","text":"十五年前杨柳条，轻阴绿遍单家桥。\n而今髡尽如僧老，却怪行人鬓早彫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代杨柳荅","author":"王世贞","text":"秋来憔悴不关情，客鬓霜华枉见轻。\n一夜东风对吹却，请看何处绿还生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜发卢沟有感","author":"王世贞","text":"鸡鸣只傍五更长，瘦马陵兢影自伤。\n一样卢沟桥上月，不知南去便如霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客谈庚戍事","author":"王世贞","text":"红颜宛转马蹄间，玉箸双垂别汉关。\n无限春风抛塞北，不教青冢遍阴山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚春","author":"王世贞","text":"漠漠残花独闭门，斜阳偏惹泪珠痕。\n闺人莫怨秋宵永，春日何曾不断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻王明辅将游赵 其一","author":"王世贞","text":"卧病闻君邺下行，披衣推枕不胜情。\n漳河只作西来水，慷慨何人变羽声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻王明辅将游赵 其二","author":"王世贞","text":"梁王词客有邹枚，苑雪千金一宴开。\n何似兰台新赋就，碧天无际大风来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]