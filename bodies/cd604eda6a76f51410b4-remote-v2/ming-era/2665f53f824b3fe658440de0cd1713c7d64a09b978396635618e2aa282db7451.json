[{"title":"漫兴四绝 其一","author":"胡应麟","text":"斟酌千秋事，何人一瓣香。\n娄江宵梦断，月色满空梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴四绝 其二","author":"胡应麟","text":"一代汪司马，怜才海内闻。\n乍日传书至，慇勤问白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴四绝 其三","author":"胡应麟","text":"十载吴明卿，相闻不相识。\n遥夜武昌楼，梅花飞铁笛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴四绝 其四","author":"胡应麟","text":"可怪滇南老，雌黄信笔成。\n那知陈晦伯，剖击更无情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其一 清啸园","author":"胡应麟","text":"为园学步兵，筑台五千丈。\n清夜啸声流，冷然万峰上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其二 松关","author":"胡应麟","text":"爱此松风吹，柴关抱麋鹿。\n白眼四无人，涛声满空谷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其三 阳春台","author":"胡应麟","text":"高堂挥彩笔，字字濯云霞。\n锦帐三千女，齐歌玉树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其四 芙蓉阁","author":"胡应麟","text":"杰阁起千寻，芙蓉不盈丈。\n为有谪仙人，含毫坐其上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其五 清风馆","author":"胡应麟","text":"一径入深篁，翛然碧云堕。\n凉飙四面来，吾将北窗卧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其六 先月台","author":"胡应麟","text":"中天白玉台，高挂九千尺。\n薄暮海东云，先送嫦娥入。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其七 涵虚阁","author":"胡应麟","text":"平湖千丈宽，中有涵虚阁。\n静夜时推窗，星辰四檐落。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其八 度云桥","author":"胡应麟","text":"青鞋趁桃花，杳杳赤城路。\n石梁千仞横，自蹑飞云度。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其九 浣花池","author":"胡应麟","text":"方池六尺强，风吹众芳堕。\n时有杜陵翁，扶藜石栏坐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其十 拱辰阁","author":"胡应麟","text":"危栏跨长空，星辰俯手拾。\n独有紫薇垣，可望不可即。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其十一 藏真洞","author":"胡应麟","text":"藤萝垂洞口，空谷四无人。\n恍惚天台路，难寻两玉真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其十二 白云峰","author":"胡应麟","text":"移来十丈峰，虬鸾舞虚牖。\n面面白云生，终南亦何有。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其十三 翠微亭","author":"胡应麟","text":"荷锸入中条，云霞导双屐。\n山腰翠渐微，冉冉孤亭出。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其十四 凝秀轩","author":"胡应麟","text":"轩窗洞然开，正对西山碧。\n十日忘朝餐，饱此莲花色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其十五 来云洞","author":"胡应麟","text":"去家十里遥，结茅在深树。\n白云洞口来，忽与幽人遇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其十六 虬峰","author":"胡应麟","text":"苍鳞剥苔藓，千尺自成趣。\n朝来云雾生，缈缥欲飞去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其十七 钓矶","author":"胡应麟","text":"八十曾无恙，苍颜出渭滨。\n宁知汉飞将，黑发画麒麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其十八 鳌屿","author":"胡应麟","text":"海上钓鳌客，曾闻太白翁。\n何如置孤屿，圆峤在庭中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其十九 琅玕亭","author":"胡应麟","text":"十万琅玕枝，个个青欲堕。\n不分王徽之，借我亭中坐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其二十 芳草斋","author":"胡应麟","text":"幽斋只数椽，科头抱书读。\n经旬不出门，芳草上阶绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其二十一 青霞馆","author":"胡应麟","text":"朝吟白雪斋，暮憩青霞馆。\n羲皇以上人，脚赤发仍散。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其二十二 松室","author":"胡应麟","text":"危阑系铁絙，高悬四松上。\n千尺凌云台，晋人何足尚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其二十三 青莲阁","author":"胡应麟","text":"虚阁倚青莲，恍入庄严界。\n悠然清净身，万古长不坏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其二十四 贝叶斋","author":"胡应麟","text":"一出恒沙河，弹指几千劫。\n金刚在舌根，何许贝多叶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其二十五 会心处","author":"胡应麟","text":"聚书三十冬，插架三万轴。\n开卷时忻然，三公岂吾欲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其二十六 苍玉馆","author":"胡应麟","text":"帘内延湘妃，帘外种湘竹。\n秋风何泠然，淅淅动苍玉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其二十七 制芰轩","author":"胡应麟","text":"湖上秋风生，推窗绿无数。\n不制三闾裳，但制三闾赋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其二十八 疑舫斋","author":"胡应麟","text":"虚斋窅千尺，恍忽阿融留。\n何须疑陆处，天地一虚舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其二十九 浮白斋","author":"胡应麟","text":"左手鸬鹚杓，右手鹦鹉杯。\n拍浮酒缸中，万事何有哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其三十 草玄居","author":"胡应麟","text":"翩翩白凤凰，夜吐青藜馆。\n何人坐吮毫，莫是扬中散。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其三十一 梅花亭","author":"胡应麟","text":"孤亭十尺藏，梅花万株列。\n中有姑射仙，肌肤若冰雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其三十二 澹然阁","author":"胡应麟","text":"事业等唐虞，浮云过太虚。\n何如高阁上，支卧一床书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其三十三 如如境","author":"胡应麟","text":"兰若何翛然，焚香拥孤衲。\n兀坐万缘空，绳床下黄叶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其三十四 滋兰室","author":"胡应麟","text":"移将九畹芬，散植雕楹畔。\n悠然丈室中，如坐潇湘岸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其三十五 绿雨楼","author":"胡应麟","text":"飞楼瞰平津，空翠散遐瞩。\n山雨暮欲来，萧萧入窗绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其三十六 留客处","author":"胡应麟","text":"十亩辟彊园，寒风洒亭榭。\n何须问主人，日坐琅玕下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其三十七 延春亭","author":"胡应麟","text":"南园红药尽，西坞绿阴重。\n别有藏春处，胡床未易逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李惟寅山房三十八咏 其三十八 沙上晚泊即事","author":"胡应麟","text":"叶落枫如撼，花攲桂若崩。\n白头溪上叟，閒坐结鱼罾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月下船窗独坐寄内是夜系缆东昌","author":"胡应麟","text":"憔悴鹔鹴裘，飞霜正暮秋。\n亦知妆阁上，频夜望刀头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"席上戏为崔孝廉赠所欢","author":"胡应麟","text":"妖姬年二八，艳色妒名花。\n莫问张君瑞，崔莺是婿家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王恒叔山居杂咏十首 其一 紫芝山房","author":"胡应麟","text":"何物东园翁，老作储皇翼。\n后夜呼茆君，乘风起八极。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王恒叔山居杂咏十首 其二 松浔","author":"胡应麟","text":"飞楼跨四松，杳杳拂云汉。\n白日广陵涛，飘萧起天半。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王恒叔山居杂咏十首 其三 莲社","author":"胡应麟","text":"西来有别传，自得碧筒趣。\n肯使柴桑公，攒眉独归去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王恒叔山居杂咏十首 其四 嘉树台","author":"胡应麟","text":"千尺摩云霄，百围蔽林莽。\n逍遥双树根，不作大槐想。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王恒叔山居杂咏十首 其五 钓亭","author":"胡应麟","text":"玉璜钓姬公，羊裘钓汉祖。\n奇哉清静君，玄成钓万古。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王恒叔山居杂咏十首 其六 忘归石","author":"胡应麟","text":"双矶渍莓苔，赤脚此閒坐。\n偶逢邻叟谈，不知夕阳堕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王恒叔山居杂咏十首 其七 芙蓉城","author":"胡应麟","text":"层城粲朱华，彩艳照林薄。\n新篇露下吟，一一谢康乐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王恒叔山居杂咏十首 其八 曲水濑","author":"胡应麟","text":"玉匣閟昭陵，聚讼欲成薮。\n千载真兰亭，复落王郎手。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王恒叔山居杂咏十首 其九 云碓","author":"胡应麟","text":"林钟疏北岭，茶杵急西家。\n湖风亭子外，扫尽石楠花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王恒叔山居杂咏十首 其十 龙藏","author":"胡应麟","text":"前身阿难陀，种此青莲舌。\n何事五千函，虚谷尽贝叶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同叶唐赵郭朱包诸生游兰阴作","author":"胡应麟","text":"百雉云中午，双虹水面晴。\n曲江春事蚤，随处丽人行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为赵宗鲁别驾题屏菊四绝 其一","author":"胡应麟","text":"玉蕊迎风粲，金英浥露开。\n东篱遥怅望，拊掌白衣来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为赵宗鲁别驾题屏菊四绝 其二","author":"胡应麟","text":"直干经时雨，繁英乍夜霜。\n灵均餐不尽，艳色满潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为赵宗鲁别驾题屏菊四绝 其三","author":"胡应麟","text":"簪来盈宿露，插处炫明霞。\n布帽须频落，何烦笑孟嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为赵宗鲁别驾题屏菊四绝 其四","author":"胡应麟","text":"袅袅依危石，亭亭照暮山。\n羡他甘谷水，千载驻红颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡谷元池亭杂咏十二首 其一 深雪庵","author":"胡应麟","text":"襆被茧云窝，清虚四天照。\n门前乘兴来，或有王郎棹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡谷元池亭杂咏十二首 其二 凝香寝","author":"胡应麟","text":"斗室罗尊彝，名香坐中发。\n何处佳人过，援琴鼓白雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡谷元池亭杂咏十二首 其三 薝卜斋","author":"胡应麟","text":"虚斋植薝卜，香气何缭绕。\n一路闻棋声，琤琮出花杪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明