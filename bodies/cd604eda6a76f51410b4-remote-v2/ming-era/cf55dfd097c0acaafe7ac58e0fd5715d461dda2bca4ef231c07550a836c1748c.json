[{"title":"游观音阁","author":"康麟","text":"楼殿玲珑架石琴，四时钟磬出潭心。\n潮生潮落自朝夕，帆去帆来成古今。\n清冷迥无尘俗到，幽虚疑有白云侵。\n乘阑不尽登临兴，笔底新诗取次吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"澹斋为邻翁邓氏赋","author":"康麟","text":"茆斋潇洒绝尘侵，世外埋名学陆沈。\n一榻白云闲有梦，九重丹诏老无心。\n藿葵滋味忘荣辱，韦布清风迈古今。\n只恐祥鳞腾化日，定将台阁换山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"还家","author":"康麟","text":"自爱吾庐僻，能辞长者车。\n病多常废栉，游倦且逃虚。\n开幔过巢燕，摊书走蠹鱼。\n不缘潘岳拙，那得遂閒居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"车遥遥","author":"陈政","text":"自君出门去，驱车涉长道。\n心送无所言，但愿归期早。\n如何岁复岁，各在天一涯。\n行役未有期，相见知何时。\n东风昨夜生苦恶，万片飞红雨中落。\n驱车何处逐风尘，远道思君安得闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登楼歌","author":"陈政","text":"爱兹楼兮朝登，忽阳春兮暮矣。\n望美人兮不来，渺澄江兮春水。\n兰桂发兮蔼芳姿，阒寥寥兮闻鸟啼。\n盼遥空兮雁北归，嗟美人兮来何时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古风五首 其四","author":"陈政","text":"北山有孤松，阅历几千载。\n根节固铁石，枝柯蔼幢盖。\n华姿沃以青，四序不迁改。\n山深无鸟雀，天际闻竽籁。\n我欲茇其下，骋视风尘外。\n缥缈怀沧洲，逶迤阻瀛海。\n地远不易到，扁舟欲何待。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂诗 其一","author":"陈政","text":"忽闻春光回，将遍东南城。\n卧病方在床，无由起相迎。\n东风入帘幕，仿佛闻流莺。\n美人会相见，庶几道平生。\n病起忽二旬，春色殊已深。\n崇兰秀阶下，碧草交繁阴。\n旭日迟迟升，众芳同照临。\n援琴未成调，拂拭迟知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂诗 其二","author":"陈政","text":"有客踵门来，云自天南至。\n喜是同乡人，殷勤问家事。\n父母安高堂，兄弟乐田里。\n令我闻此言，欣然欲忘寐。\n官舍春昼长，冲淡自成趣。\n良朋日往来，衷言以相语。\n琴书既足乐，得丧亦何预。\n卓彼先民言，庶几永终誉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿丰城范处士","author":"陈政","text":"先生清隐处，孺子昔曾游。\n山近云生户，江空月映楼。\n飞觞迎媚景，展席俯清流。\n轩冕元无梦，何须范蠡舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牧马图","author":"陈政","text":"草细泉香野色新，五花骄气散春云。\n昂头似忆当年事，立仗淩寒夜正分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牧牛词","author":"陈政","text":"晓光晴逗林霏灭，乌犍踏破春郊雪。\n升沈荣辱耳不闻，横笛一声山石裂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送内父碧筠罗先生还乡","author":"鲁能","text":"万里驰驱上帝州，夜灯尊酒话绸缪。\n旅怀忽起乡园梦，逸兴应随潞渚舟。\n玉润惭非红杏雨，冰清照破碧天秋。\n悬知后夜相思处，月满关山独倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送进士马克毅还新会","author":"鲁能","text":"钟鸣长乐曙光寒，斗酒城阴话别难。\n姓字已荣题璧水，衣冠暂许出金銮。\n轻风淮上杨花白，细雨江南荔子丹。\n莫向故园耽恋久，早来簪笔侍朝端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咸阳怀古","author":"鲁能","text":"烟树苍茫一望中，汉陵秦苑总成空。\n铜驼埋没悲秋雨，石兽荒凉怨朔风。\n寂寂落花歌舞地，轻轻茅草乐游宫。\n停骖欲问前朝事，惟有青山夕照红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西宁感怀","author":"鲁能","text":"西山环绕古西平，番簇相连汉戍营。\n秣马征夫思野战，牧牛童子待春耕。\n路经三峡风涛急，水满三川月色明。\n回首咸阳渺何许，岭猿啼处不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古路樵归","author":"鲁能","text":"羊肠远接白云乡，归路行歌傍晚凉。\n薪担寒挑林外月，芒鞋香带草头霜。\n依稀酒幔摇村店，缥缈钟声度上方。\n圣主只今求隐逸，刍荛应见入尧章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送伍上舍宁告还乡兼简乃兄缙斋","author":"鲁能","text":"皇都春暖雪初晴，驻马东郊送客行。\n弹铗暂辞双凤阙，挂帆遥指五羊城。\n千秋丹荔怀乡梦，万里青山带别情。\n风雨对床如问我，一官今见二毛生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽张茂才秉伦诗","author":"李素","text":"麟溪寂寞雨声愁，叹息英雄事业休。\n赤手持家诸弟显，锐心倡学盛名留。\n龙亡虎逝怜陈迹，鹤怨猿惊锁故丘。\n疏拙忝为门下士，伤心讵忍过西州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛巳仲春游岩有感","author":"梁惠","text":"落魄泷城十五春，回头梦觉水□身。\n月当劫蚀光犹在，棋到残敲著始神。\n古洞烟霞藏石角，灵岩风雨出龙津。\n念知此后名山约，添得纱笼一事新。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"却聘诗","author":"梁惠","text":"七十年来德未加，每劳贤者到山家。\n忙来汲水无茶煮，感待邻家有酒赊。\n入馔拳鸡才脱母，作羹野菜尚含花。\n归与若对琴堂说，人在长江理钓槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"颂母德诗","author":"何清","text":"一生不愧柏舟诗，熊胆为丸年少时。\n绕膝彩衣何处是，薤歌声断使人悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游惠宗寺题磨崖","author":"何清","text":"春郊极目思悠悠，风景元来第一州。\n山势北从衡岳起，水声东向海天流。\n树连洲渚城烟静，峰插云霄野思幽。\n怪得地多英俊士，南轩曾有读书楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清虚观","author":"何清","text":"寻真选胜此中来，野菊迎人次第开。\n为问王乔无觅处，兴阑随意坐苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"彭城遇宗弟大尹佐","author":"王恪","text":"一脉斯文气味长，共君世系出莆阳。\n枝柯自信原同本，天地如何使异乡。\n唐宋家声曾梓谱，彭城风雨幸连床。\n春来傥有池塘梦，莫惜新诗寄远将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏竹","author":"袁孚","text":"朝阳乍起祥云动，年来频睹高冈凤。\n潇潇翠羽振回风，偏带天门露华重。\n伶伦嶰谷劳探寻，湘江雨霁烟云深。\n虞廷律吕待时作，四方共听箫韶音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽戴南湾","author":"袁孚","text":"托迹江湖八帙馀，雍容人物世应稀。\n尚期大老来东海，不觉浮云掩少微。\n前浦清风空自满，南湾明月更谁依。\n我来此日怀高谊，楚些歌残两泪飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长乐道中","author":"陈龙","text":"邮程十里又十里，山树一重还一重。\n滩急雨添新涨水，天晴云护最高峰。\n野人破屋牵萝补，畬妇香粳付水舂。\n即此便知为乐土，休将谪宦惜坡翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"廉泉","author":"陈龙","text":"寒泉清见底，浑不染尘埃。\n廉是当时号，源从何处来。\n天光相照映，云影共徘徊。\n饮此襟怀洁，何辞酌满杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽戴南湾","author":"陈龙","text":"南浦蒹葭覆钓舟，草堂人去水空流。\n凄凉烟月沧洲晚，憔悴霜风玉树秋。\n身世百年同逆旅，功名两字等浮沤。\n史臣异日书高洁，东汉严光是匹俦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠戴竹堂","author":"陈龙","text":"庭户翛然爽似秋，筼筜祇护小堂幽。\n日光筛地碎金雨，岚气袭人空翠浮。\n乞笋僧来成坐久，论诗客至更迟留。\n明廷方下徵贤诏，未许追随二阮游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文峰翠合","author":"邓瑗","text":"嶙峋笔架插天齐，眺望回看列岫低。\n一带晚烟凝翡翠，半空暝色映玻璃。\n云开峭壁寒偏急，雨霁遥空望欲迷。\n郁结灵钟腾瑞气，馀光夜夜灿文奎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"避乱羊城寄涂探花","author":"伍敬","text":"一从锋火照征衣，几处移家独掩扉。\n囊箧萧条吟草在，关河牢落故人稀。\n朝来远堠犹传箭，春尽边城未解围。\n回首动惊亲舍远，几时孤棹向南归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬塾师二绝 其一","author":"邓素庵","text":"菜根有味美如脂，要识希文未遇时。\n铁杵磨针难却易，飞鸿休放此心驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬塾师二绝 其二","author":"邓素庵","text":"凤雏应喜际昌期，文教何殊丰镐时。\n养就腾霄双彩翮，嗈嗈飞上碧梧枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠戴竹堂","author":"陈鏊","text":"琅玕万个绕堂前，开卷悠然胜辋川。\n金影碎笼檐外月，玉声清和石间泉。\n翠禽啼处烟如锦，紫箨栽来雪尚鲜。\n霹雳一声惊蛰起，龙孙高插碧云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同诸子游山园分赋得衣字","author":"钟吕","text":"林麓深深隐翠微，山空灵籁响秋晖。\n行穿竹里云连盖，坐倚松根露湿衣。\n迎客犬从花径出，惊人鹤绕柳塘飞。\n醉来不觉幽情放，散步狂歌踏月归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入杭","author":"钟吕","text":"何来佳丽压姑苏，极目江山入画图。\n三竺花笼新佛寺，六桥烟锁旧皇都。\n舞翻翠袖多称越，曲唱菱歌半是吴。\n若问风流何处最，酒船明月泛西湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观澜","author":"周敞","text":"云开山晓色，风静鸟啼音。\n物意含春意，渊深似道深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉陪朝列大夫饶秉鉴题三洲岩","author":"李公瓛","text":"昔闻蓬岛有三洲，今见壶山锦水头。\n题石诗存人已远，炼丹仙去灶还留。\n岚生海屿千峰暝，风度云关六月秋。\n争扫崖屏三五幅，得人佳句即时收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏毕氏节妇","author":"马仕彪","text":"忍听遗言事后人，从教鸾镜锁埃尘。\n香魂暗逐黄泉客，老泪重伤白发亲。\n千古高风惊薄俗，两行信史在词臣。\n当时若得为男子，事主临危肯顾身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古四首 其一","author":"黄瑜","text":"招摇复招摇，行子何所之。\n云山浩茫茫，万里以为期。\n江南雨滑道，朔北风裂肌。\n襜裘不自豫，中路当依谁。\n尘霾起天末，耀灵隐崦嵫。\n牛羊各知家，栖鸡尚知埘。\n驰骤失其路，安用轮辐为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古四首 其二","author":"黄瑜","text":"太极涵万始，羲娥运灵景。\n春声殷木末，池塘噪蛙黾。\n彼美林居子，歛神发深省。\n月出千山晓，云来万壑暝。\n抱独人不知，竹风吹松影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古四首 其三","author":"黄瑜","text":"英英陇上云，随日递晴阴。\n汎汎河中水，与波自浮沉。\n浩荡云水中，轸兹郁陶心。\n我心良足伤，结交费黄金。\n昔日繁华地，悲风集枯林。\n去去五湖上，缘苇听挐音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古四首 其四","author":"黄瑜","text":"大鹏起南溟，鼓翼天池翻。\n九万抟扶摇，一息谅何难。\n朝栖若木阴，夕宿昆崙端。\n胡然恣饮啄，将使风露乾。\n冥冥天际鸿，渐渐兴于磐。\n君子不素饱，居贫诚所安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暑雨叹","author":"黄瑜","text":"骄龙走平陆，长空浩洪涛。\n天瓢翻不绝，雨师何乃劳。\n出门畏无车，衢路多野蒿。\n后土吹未乾，庭树空萧骚。\n兀坐悄无言，蚯蚓向我号。\n须臾赫羲轮，六合成炉鏊。\n炎凉每如此，嗟嗟天盖高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠宁道士","author":"黄瑜","text":"刚风起鹏溟，梦结紫霞赏。\n白日生羽翰，玄珠失象罔。\n长离与矞皇，招我流铃响。\n耸身登郁罗，翛然蹑虚朗。\n玉娥拂我衣，谓我税尘鞅。\n何年同尔游，逍遥披鹤氅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北山","author":"黄瑜","text":"青门郁葱葱，北山佳气浓。\n不见邵平瓜，见此金芙蓉。\n芙蓉历冰霜，秀色射埤海。\n谓彼贞心人，素履长不改。\n我祖廊庙材，早没随蒿蓬。\n大母矢靡忒，白首甘所终。\n时平共钟鼎，世乱逐戎马。\n缅怀东陵侯，哀歌泪盈把。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿星塘","author":"黄瑜","text":"汪汪寿星塘，上有岵与屺。\n松柏悲风来，惊波渺不起。\n岵屺日登望，父母嗟何之。\n惊波有定日，眦泪无乾时。\n谁云蓬莱仙，夜来驻笙鹤。\n刀圭如可求，庶几起冥漠。\n嗟我寸草心，萋萋徒自伤。\n泪下不可收，日暮惊波长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤凰山","author":"黄瑜","text":"桃花悄无源，仙姝渺何许。\n空馀一片山，欲逐凤凰翥。\n长林暮萧飕，似送飞琼语。\n倏然卧荒村，清猿深夜雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"獭窟山","author":"黄瑜","text":"西林簇龙象，昔为獭所穴。\n逍遥入苍翠，永与炎埃绝。\n禅话落松风，洒作襟上雪。\n坐久明河沉，疏帘挂海月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花水","author":"黄瑜","text":"早春适川上，兴随流水长。\n时有白云至，远带梅花香。\n日诵文山诗，目送孤鸿翔。\n悠悠宇宙间，是非两亡羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长洲山","author":"黄瑜","text":"微雨净山绿，赏心投鹤群。\n拂藓憩幽洞，松花如密云。\n龙湫接狮滘，石濑时远闻。\n野烟湿苔径，牛羊下斜曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"干将曲","author":"黄瑜","text":"干将昔随赤帝子，挥霍上下振龙纪。\n狡童效之乃殉死，尔权遣吏胡至此。\n启玄堂，露黄肠。\n珠襦玉匣光琳琅，喜获双干将。\n嗟尔权兮荒以蹶。\n恩西陵，仇南粤，干将飞飞诉天阙。\n取非其有非英雄，赤眉凶辙将无同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"温泉曲","author":"黄瑜","text":"温泉春满芙蓉国，江南社燕辞巢幕。\n锦绷酥乳结朝云，偃月堂深日光薄。\n翠华西度峨眉巅，长安入望成飞烟。\n万里归来老兴庆，闻铃犹自悲婵娟。\n君不闻野鹿宫中衔牡丹，明驼那避朔风寒。\n日长微露金诃迹，竦发攒愁眉黛间。\n于嗟堂堂由媚妩，黄台瓜尽那复数。\n温泉之水秽万古，何似青陵墓中土。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贞燕谣","author":"黄瑜","text":"贞燕贞燕，影皇皇，尾涎涎。\n去年雄共栖，今年雄不见。\n深沉帘幕花随风，空梁独宿思故雄。\n何人并卧氍毹月，罗袂鸾篦花影中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"烈鸳谣","author":"黄瑜","text":"烈鸳可悲。\n雄已死，雌依依。\n宁同镬中烹，不向湖上飞。\n生来相随不相舍，如今奋翅同所归。\n何事楚宫娇不语，露桃脉脉东风里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲井澳","author":"黄瑜","text":"白雁过，江南破，更无一寸土可坐。\n自闽入广随波流，胡尘暗天天亦愁，黄芦霾岸风飕飕。\n上有深井山，下有仙女澳，渔舟不往御舟到。\n风吹御舟力排奡，嗟嗟悲哉谁与告。\n谁与告兮悲复悲，逢崖则止会有时，星星之火奚威为。\n君不见，青苗行时不敢语，大事已逐黄龙去。\n又不见，金牌出时不可回，杀气先随白雁来。\n舒王生，鄂王死，宋家刑赏乃如此。\n嗟嗟井澳徒悲尔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"井岙","author":"黄瑜","text":"白雁过，江南破，更无一尺土可坐。\n自闽入广随波流，尘沙暗天天亦愁。\n黄芦苦竹风飕飕，鹧鸪雨中啼不休。\n上有深井山，下有仙女岙。\n黑云卷波白浩浩，渔舟不到御舟到。\n鳄鱼鬐扬蛟尾掉，苍天苍天谁与告。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"番禺张元隆从事藩司入觐归司有独鹤见之必鸣且舞遇他人则否元隆以为吉兆求诗予序之为歌曰","author":"黄瑜","text":"鹤之鸣，鸿厥声。\n鹤之舞，仪其羽。\n猗嗟乎，子当出群。\n谁其云，崔山君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友琴堂","author":"黄瑜","text":"瑶琴真益友，伴我绝将迎。\n清冷梅依月，悠扬絮过城。\n檐花冲雨落，谷鸟挟风鸣。\n勾引阳春到，满庭莎草生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张九衢都帅北上时镇惠潮","author":"黄瑜","text":"环佩趋天北，帆樯向斗东。\n离情满江汉，秋色入梧桐。\n飞挽三河道，传宣五柞宫。\n岩廊用儒将，应见虏尘空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春喜晴次李司鉴","author":"黄瑜","text":"丽日熏轻葛，残春似早秋。\n庭莎经雨发，渠水绕花流。\n抚剑成高咏，衔杯散远愁。\n阴晴嗟未定，竹外正闻鸠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饯别伍太守希渊即席赋","author":"黄瑜","text":"朱幡辞郡阁，白马拥江津。\n化日三城晓，浓花十月春。\n野歌闻德泽，朋酒见经纶。\n回首棠阴下，应无剪伐人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客寓苏氏小楼","author":"黄瑜","text":"日夕危楼上，凭阑望故乡。\n淮流山外碧，燕树日边黄。\n旅梦鱼千里，归心雁一行。\n坡仙风韵在，时与话高皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]