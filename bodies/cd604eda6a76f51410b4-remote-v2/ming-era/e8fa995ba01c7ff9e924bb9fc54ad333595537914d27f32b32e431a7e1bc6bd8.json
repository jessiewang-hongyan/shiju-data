[{"title":"游玉案山宝珠寺","author":"杨慎","text":"名山已发兴，空宇复离群。\n开楼见西海，出岫指南云。\n泉华玉霤接，风籁紫宵闻。\n前朝一片石，金薤剥苔文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬金秀才","author":"杨慎","text":"伏枕抱疾日，闭关馀春时。\n欣闻空谷音，适与中林期。\n清风洒兰藻，零雨坐茅茨。\n翻然不可见，悠哉寄遐思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌撒喜情","author":"杨慎","text":"易见黄河清，难逢乌撒晴。\n阴霾既巳豁，险道况复平。\n蜀日杳千里，滇云惟十程。\n江花与江草，异国看春生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大理春市因忆李仁甫","author":"杨慎","text":"海国樱桃市，春山兰蕙游。\n青丝盘騕袅，红颊醉扶留。\n狼荒金莫辨，鲛宫珠暗投。\n佳人眇天末，因之问阻脩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大华寺即事","author":"杨慎","text":"旧雨高峣上，新晴太华中。\n松门㡠山霭，兰渚镜文虹。\n钟动烟花紫，灯然暝色葱。\n山僧多养马，疑是古支公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大相公岭","author":"杨慎","text":"九折刺史坂，七擒丞相桥。\n沉黎汉原古，严道蜀关遥。\n策马冰槽滑，乘橇雪泞消。\n我行再经此，感慨一长谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"招刘善充","author":"杨慎","text":"戎旅九塞上，暂归如梦中。\n双江碧云合，九桥明月同。\n摇心渺天末，携手期城东。\n伫立永今夕，银蜡粲铜缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鱼凫关宴别赵龙岩佥宪","author":"杨慎","text":"有美台中彦，怀予别思长。\n薄云随马首，落日送渔梁。\n野燎山多黑，江秋荻已黄。\n摇摇愁转旆，宁用诉华觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北桥离席留别赵州诸子","author":"杨慎","text":"漂泊犹戎旅，羁栖且岁年。\n又伤南浦别，重醉北桥边。\n烟树环江浒，风花簇野筵。\n乡心那可问，愁思绕离弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅马敬臣 其一","author":"杨慎","text":"北阙承恩谴，南荒作旅人。\n可堪同瘴疠，犹自隔音尘。\n鹤岭霏烟外，螳川积水滨。\n三年不相见，两地各伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅马敬臣 其二","author":"杨慎","text":"空宇澄新霁，殊方报早秋。\n凉风天末树，明月海边楼。\n塞草封归望，湘兰唤别愁。\n来章三复罢，对酒不能詶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅杨从龙给事","author":"杨慎","text":"仙居深紫府，旅望渺苍波。\n五夜劳魂梦，三年阻啸歌。\n云心陶令远，秋兴杜陵多。\n鱼浦南风便，龙关一羽过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次张大理文柔别后见寄韵 其一","author":"杨慎","text":"四牡何时发，双鱼此日将。\n别离惊草绿，衰谢感芸黄。\n泽畔风霜劲，天涯岁月忙。\n款襟难借问，濡迹但相望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水边梅影","author":"杨慎","text":"玉宇暧微霄，瑶华擢秀翘。\n贝宫浮藻景，鱼浪净兰桡。\n佩冷汉皋橘，珠明河上萧。\n不逢南雪唱，空倚北风谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦游感通寺简诸友","author":"杨慎","text":"李白题诗寺，文箫雁韵楼。\n海光浮树杪，山翠滴床头。\n热想寒泉濯，春曾煖谷游。\n暝钟萝月下，清梦一相求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢杨肃庵都谏惠笔","author":"杨慎","text":"彤管分青琐，琼缄到紫岩。\n草玄疲执戟，花梦老江淹。\n嶰谷箨龙健，寒宫桂兔尖。\n无因白雪唱，空拟碧云瞻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"亭前引水名曰墨池","author":"杨慎","text":"金潭朝洗菊，玉甃暖滋兰。\n何如玄阯水，分作墨池澜。\n烟云生几席，星斗宿阑干。\n问字休携酒，仙家沆瀣寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过石桩村访唐河东刺史王仁求碑 其一","author":"杨慎","text":"唐代河东守，周朝圣历时。\n土花封绿字，石发被金碑。\n泣露麟犹卧，嘶风马自悲。\n荒原谁过问，郡乘不曾知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过石桩村访唐河东刺史王仁求碑 其二","author":"杨慎","text":"鸣蚁古河东，川原势亦雄。\n城荒吊华纳，山远问葱蒙。\n玉箸埋天禄，银钩剥画虫。\n闾丘名姓在，乡衮仰清风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玫瑰花","author":"杨慎","text":"庭际玫瑰树，含芳当坐隅。\n春盘红玛瑙，晓帐紫珊瑚。\n风信翻霞锦，天香缀露珠。\n仙壶春酝好，留著醉麻姑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海篺","author":"杨慎","text":"芳洲隐蘋末，葑埒寄芦中。\n上下随春水，东西逐夜风。\n浮家还泛宅，断梗复飘蓬。\n感物伤羁思，生涯愧海翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏霜","author":"杨慎","text":"天驷粲寒芒，青腰骋素妆。\n珠帘银蒜白，金井碧梧黄。\n汉署宵钟彻，胡庭晓角长。\n礼貂无暖色，坐待烛龙光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滇池泛舟见新雁","author":"杨慎","text":"忽见行行雁，来应自故乡。\n天涯多少路，云际几乎霜。\n滇水饶葭菼，禺山足稻粱。\n金河尔休恋，无限虏弦张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中元夕望开福寺塔灯","author":"杨慎","text":"窣堵高千尺，然灯达五更。\n刚风吹不灭，甘露洗还明。\n龙烛真堪并，蛾飞不敢惊。\n獶升何矫捷，应见闼婆城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏琵琶","author":"杨慎","text":"回窗映华表，连环系锦绦。\n桃叶双鬟小，枫香一调高。\n牛羊上青冢，狐兔没黄蒿。\n留宾芳夜促，且欲醉蒲桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨","author":"杨慎","text":"蝉咽枝头露，鸠抟树杪风。\n窗窗凉意足，叶叶雨声雄。\n案对灯花喜，宵分簟色融。\n不知何水部，吟断滴阶中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青桥驿","author":"杨慎","text":"铁壁千秋雪，冰崖万壑雷。\n人家比星散，鸟道入云回。\n旅寓山河隔，乡心日夜催。\n客行春又夏，不见捷书来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆用叙弟","author":"杨慎","text":"阿弟远行役，一年无定居。\n劳劳恒念尔，寂寂正愁予。\n日月攀芳树，云霄隔素书。\n燕南池草绿，应好赋归欤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同祝鸣和锦江泛舟","author":"杨慎","text":"八月茅花水，诸天桂子风。\n追凉琪树底，击汰锦亭东。\n人境嚣尘隔，仙曹逸兴同。\n城楼钟欲动，斜照带微红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游中嵓寺","author":"杨慎","text":"高阁诸天近，长江客路分。\n帆开山吐月，钟动水连云。\n渔唱通宵起，樵音隔浦闻。\n佛香浑不断，散作南岧薰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次胡孝思中嵓韵","author":"杨慎","text":"翠微连宝地，青霭压云堤。\n俯瞰行人小，平瞻远树齐。\n振衣淹暮屐，回棹听寒鼙。\n雨歇枫林静，荒鸡尚未啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桔柏渡","author":"杨慎","text":"桔柏古时渡，江流今宛然。\n名存巴国志，诗有杜陵萹。\n鸨鹢冲烟散，鼋鼍抱日眠。\n分留馀物色，朗咏惜高贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重过华清宫","author":"杨慎","text":"绣岭仙人阁，华清玉女汤。\n山川犹气象，台殿久荒凉。\n暖水生烟雾，寒松受雪霜。\n碑文无岁月，螭首卧牛羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临晋道中","author":"杨慎","text":"茅店昏烟集，榆乡燎火开。\n宵征何太急，暝望忽相催。\n月树群鸦散，霜桥列骑回。\n解城闻漏点，星宿满梅台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕亿远","author":"杨慎","text":"离人惜离景，星聚又星分。\n双津乌鹊候，三山鸾鹤群。\n锦江澄夕浪，玉台生晓云。\n山途何渺渺，愁思极纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王维贤吉士出知广德州","author":"杨慎","text":"朱方新出守，玉署早知名。\n邦域周千里，文章汉二京。\n凤皇天北顾，鸿雁暮南征。\n清赏何由共，琼枝别后情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周彦通侍御秋斋 其一","author":"杨慎","text":"北斗临茅宇，西山出蕙楼。\n凉风吹玉树，明月下金丘。\n歌对梧桐语，辞因丛桂留。\n高人耽吏隐，不是采真游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周彦通侍御秋斋 其二","author":"杨慎","text":"凤皇巢扈阁，蟋蟀在西堂。\n庐是承明地，园非避世墙。\n清琴宵弄月，白简昼飞霜。\n采采篱边菊，相期重晚芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋房春夕","author":"杨慎","text":"青云临鹿苑，焕景入虹梁。\n燕坐诸天近，斋心五夜长。\n尘埃徐孺榻，灯火赞公房。\n隐隐闻清漏，迢迢出建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬郭司业","author":"杨慎","text":"元岁天斋里，新阳月令逢。\n僧房联下榻，仙佩待鸣钟。\n云会连枝比，宵分隐几慵。\n同心成坐隔，回首是行踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送余懋忠","author":"杨慎","text":"河上冰犹合，关山雁未回。\n君行阻舟楫，征马犯尘埃。\n天远惊离袂，春寒入劝杯。\n江东碧云外，日暮独悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春雪","author":"杨慎","text":"南雪转东风，千门四望同。\n爱穿珠箔透，愁点玉阶融。\n竹覆玲珑叶，梅残绰约丛。\n夕窗还映白，蜡炬更添红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春雨","author":"杨慎","text":"春雨掩柴扉，勾芒力尚微。\n润通瓜蔓水，寒透木绵衣。\n大泽龙蛇远，空林鸟雀稀。\n山翁多甲子，杖屦候芳菲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惟信朱晓早发至古店回诗见寄次韵","author":"杨慎","text":"井辖虚投夜，河桥暝发时。\n明星将夙驾，重露欲沾帷。\n南浦蘼芜合，东门杨柳垂。\n回风飘锦字，空谷寄遐思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源楼观涨 其一","author":"杨慎","text":"潢潦飞櫩外，洪波古堞前。\n山收玄豹雨，江展白虹天。\n牛马迷昏谷，鱼龙失故渊。\n樵人归太晚，隔浦认炊烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清源楼观涨 其二","author":"杨慎","text":"云色含山色，涛声撼树声。\n枯槎何处下，怒浪几时平。\n退鹢昏相失，飞乌晚对鸣。\n如何誇海若，犹自诧庄生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒","author":"杨慎","text":"天籁调寒吹，神炉炼晓霜。\n稍惊绵力薄，还讶叶声长。\n画戟归边将，青绫直省郎。\n谁论萍氏禁，须问曲生方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅天郊晚","author":"杨慎","text":"连日黄梅雨，蛙声积渐多。\n丰年无赤地，平墅似银河。\n园筱凉生叶，堤柽水没柯。\n半村斜照里，收钓晒渔蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒食见梨花","author":"杨慎","text":"寒食村藏寺，晴光水见沙。\n老僧闲贝叶，邀客看梨花。\n尘外冰壶瑩，风前玉树斜。\n洗妆犹待雨，春态倚云霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒霄月色","author":"杨慎","text":"明月流寒影，低櫩复转廊。\n雪霜留澹白，参昂伴昏黄。\n野径多樵笛，江村有钓航。\n不教乌鹊定，直待烛龙光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄许玉林","author":"杨慎","text":"吾怜许玉林，道气夙龄深。\n悬车未华发，解佩晏清襟。\n山水归与兴，琴樽静者心。\n紫芳行可觌，丹灶拟同寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶袁永之","author":"杨慎","text":"书到滇阴日，封题阳朔春。\n同心虽异县，未面巳通神。\n骏发高岑后，鸿裁晔寿新。\n伊予嗟暮耋，颙子掞天宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒夕","author":"杨慎","text":"璧月寒生晕，银河冻欲冰。\n檐花穿雾凇，窗纸战风棱。\n桂火嘘难焰，兰膏坐自凝。\n新梅如姹女，妆束待晨兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱参政良矩还金华","author":"杨慎","text":"仙人无白发，何事早归山。\n东海文鳐逝，南云倦鸟还。\n竹林同晋逸，芝岭异商颜。\n明月和清梦，随君度雪关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕高峣早起","author":"杨慎","text":"独向高峣宿，遥闻水寺钟。\n疏灯青耿壁，斜月翠沉峰。\n星点萤穿竹，潮音鹤舞松。\n明湖开晓镜，倒影木芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村晓","author":"杨慎","text":"水寺霜钟起，山楼晓堞迷。\n长庚配残月，斜汉界晴霓。\n犬吠声如豹，蝇喧听似鸡。\n老怀浑不寐，遥夕又新题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄王云巢","author":"杨慎","text":"红尘厌市廛，白首伴云眠。\n巢父元无地，壶公别有天。\n北山回俗驾，南岳定诗禅。\n莫讶焦鹩细，逍遥且大年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀韩子中","author":"杨慎","text":"风流点苍彦，天骨乘黄奇。\n出宰千家邑，归无三径资。\n兰亭传墨诀，草阁伴玄思。\n怊怅汤田别，深杯欲暝时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张愈光","author":"杨慎","text":"刘安悲落木，曹植感飞蓬。\n夜雨灯前梦，秋霜镜里容。\n绵绵思远道，戚戚苦无踪。\n何日来仙驾，青天骑白龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王民望 其一","author":"杨慎","text":"与子旷参辰，眷言淹晷曜。\n婉婉来清扬，娓娓启玄调。\n暝宿太华峰，晨理高峣钓。\n沙上怆分襟，城隅阻言笑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王民望 其二","author":"杨慎","text":"言笑豁相思，有约当后期。\n云峤苔屐并，风檐兰襟披。\n衢步拾瑶草，池酌系青丝。\n俊游希白下，高会继南皮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王民望 其三","author":"杨慎","text":"南皮驶清流，北渚爽金?。\n去骖俨立鹄，走舸歙飞鸥。\n胡然婴痾疢，临岐隔欢游。\n望美天咫尺，何以慰离忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王民望 其四","author":"杨慎","text":"离忧一何丛，我心一何忡。\n紫芳行采采，翠管坐濛濛。\n开奁熭宝饵，隐几拂彫桐。\n驰神随去鹢，缄情付归鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王民望 其五","author":"杨慎","text":"归鸿翔泬寥，绪风传䬃沓。\n凉氛秀峰期，温盟通海榻。\n讵诧彩霞分，终令碧云合。\n张敏梦不迷，刘协兴还荅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高峣夕","author":"杨慎","text":"雌霓晴桥跨，雄风晚籁斜。\n绿畴翻?稏，苍浦贙蒹葭。\n樵隐同山麓，渔商集水涯。\n荒村门早闭，卜树已归鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人之吴楚","author":"杨慎","text":"佳丽东南地，登临罨画中。\n竹云笼晓渚，梅雨澹烟空。\n风顺帆如马，天高月似弓。\n哀歌休拔剑，槎上觅仙翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与胡在轩简西峃泛舟至柳坝晚归","author":"杨慎","text":"北风吹海岸，拥沬聚银沙。\n去棹穿汀叶，归帆拂渚花。\n鹅儿黄似酒，杨柳绿藏鸦。\n物色撩人醉，醉歌凌紫霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滇晓","author":"杨慎","text":"林迥碧鸡飞，花稍露欲晞。\n迢迢城漏寂，隐隐寺钟微。\n小店明灯出，残妆带月归。\n云津渔唱起，空翠湿蓑衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元宵雪","author":"杨慎","text":"娥月隐春城，仙云飘六霙。\n花随四照出，光与九枝争。\n白战横诗槊，清愁倩酒兵。\n何须访姑射，人世即瑶京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月望日与诸弟夜泛","author":"杨慎","text":"嘉木绕通川，空林众籁传。\n江天清近榻，霜月冷侵船。\n尽日供愁坐，连宵只醉眠。\n不同池上酌，何事有新篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次夜","author":"杨慎","text":"南浦风光阔，东林霁景饶。\n滩声喧昨夜，峰影静今朝。\n行艓寻烟语，停杯待月邀。\n清游不隔日，玉树好风标。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]