[{"title":"十九秋 其九 秋镜","author":"成鹫","text":"爱尔本无我，逢秋识故人。\n滞形还偶影，顾笑复怜颦。\n虚室自生白，太空谁写真。\n所嗟承弁鬓，一见一回新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49016,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其十 秋帘","author":"成鹫","text":"白蘋红桕岸，孑孑幔旗高。\n沉醉归吟客，凉风吹毙袍。\n长卿新酒保，公瑾旧醇醪。\n相见芭蕉道，枯禅笑我曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49017,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其十一 秋渔","author":"成鹫","text":"华亭人去后，湖海几经秋。\n留得一竿竹，閒来坐钓舟。\n百年参水鹤，一笑狎沙鸥。\n相劝桐江老，青蓑换黑裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其十二 秋烟","author":"成鹫","text":"不道秋烟浅，山光淡几重。\n晓来看远岫，飞去最高峰。\n月恨冰壶小，云添水墨浓。\n渺然闻见外，清籁散疏钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其十三 秋菜","author":"成鹫","text":"瓜蔬秋未晚，姜桂老偏宜。\n物理洵如此，吾生定不疑。\n根苗凭地力，烹瀹在人为。\n莫漫遗黄叶，随流自不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其十四 秋灯","author":"成鹫","text":"檐前凉雨过，灯下落花频。\n万古无穷事，三更不寐人。\n秋光成一片，老景自相亲。\n寂寞消难得，平分与隔邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其十五 秋琴","author":"成鹫","text":"大地同明月，一人弹素琴。\n秋声入枯木，馀响在空林。\n偶尔写情性，翛然无古今。\n钟期如可作，犹恐未知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其十六 秋猎","author":"成鹫","text":"处处鸟声稀，秋风动杀机。\n将军初命驾，寥廓已高飞。\n犬带重鋂出，鹰饕一饱归。\n鹪鹩方自喜，何幸此身微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其十七 秋衫","author":"成鹫","text":"莫笑山衣破，偏能代负暄。\n公然对狐貉，各自话寒温。\n九秋霜露重，一衲水云屯。\n閒与儿童道，无衣早闭门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其十八 秋簟","author":"成鹫","text":"新得蕲阳簟，秋来布石床。\n有时自舒卷，无地不潇湘。\n雨过籧篨润，风高薤叶凉。\n莫誇人并倚，幽独兴偏长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九秋 其十九 秋蝶","author":"成鹫","text":"物外形兼影，花边弟与昆。\n翱翔入秋草，迟莫忆王孙。\n好梦迷乌足，前身是漆园。\n御风人未返，何处可招魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十放诗 其一 放云","author":"成鹫","text":"携云下暝岫，两腋生寒光。\n中道一为别，故山归兴长。\n升沉无定所，咫尺遥相望。\n行矣勿复道，秋高天淼茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十放诗 其二 放萤","author":"成鹫","text":"懒惰已成性，与君相见稀。\n括囊乾欲死，腐草忍同归。\n好去度星汉，休来点客衣。\n破除文字障，何处不高飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十放诗 其三 放鹰","author":"成鹫","text":"独立倚秋风，猎心知汝雄。\n臂鞲聊为解，宇宙一何空。\n俦侣情偏洽，山林兴不穷。\n举头天外望，谁复出樊笼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十放诗 其四 放鸭","author":"成鹫","text":"天寒犹下水，日暮自呼名。\n爱尔无泥滓，托身随浊清。\n归来风雨后，放出羽毛轻。\n莫逐双凫去，丹霄不易行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十放诗 其五 放猿","author":"成鹫","text":"怜尔受羁绁，逢僧解玉环。\n独归千嶂外，长啸一声閒。\n静躁难同住，猕猴莫共山。\n殷勤挥手别，相望白云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十放诗 其六 放鹤","author":"成鹫","text":"山中有高士，共住一年年。\n短榻寒连影，孤灯夜立禅。\n神交天地外，怅别秋风前。\n大笑出门去，閒云何处边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十放诗 其七 放牛","author":"成鹫","text":"三农胥有役，一隙即閒身。\n以此均劳逸，安能长苦辛。\n溪山随所适，水草自相亲。\n白石歌残后，应无扣角人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十放诗 其八 放驴","author":"成鹫","text":"蹇驴欺我老，出郭故蹒跚。\n尽日行吟苦，长风吹面寒。\n归来语童仆，从此解鞯鞍。\n相送秋田去，焉知世路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十放诗 其九 放鱼","author":"成鹫","text":"隔江老渔父，收钓细鳞肥。\n问市提筐入，逢僧托钵归。\n从容苏涸辙，谈笑得生机。\n极目沧浪外，烟霞静可依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十放诗 其十 放蝶","author":"成鹫","text":"翩翩双凤子，来自古罗浮。\n好客难为别，飞仙不可留。\n遐心返初服，归路指丹丘。\n共有逍遥梦，相期在石楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东林七问 其一 问天","author":"成鹫","text":"碌碌今如此，冥冥非所知。\n胜人宁有定，于我或无私。\n劫火焚刍狗，青云变素丝。\n杞忧诚罔极，深信转成疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东林七问 其二 问影","author":"成鹫","text":"屏迹茅檐下，追随日以疏。\n偶然到城市，未免识侬渠。\n造物静相对，此身常有馀。\n何时谢形役，不敢惜离居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东林七问 其三 问津","author":"成鹫","text":"古道接桑麻，仙源入望赊。\n避秦人去后，无复种桃花。\n岐路伤萍梗，逢溪问钓槎。\n隔江何处所，或恐是吾家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东林七问 其四 问岁","author":"成鹫","text":"老去懒耕田，秋来愿有年。\n每从桥下卜，频解杖头钱。\n南地三冬雪，西畴万井烟。\n农谈昨如此，曾否不虚传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东林七问 其五 问夜","author":"成鹫","text":"高枕得无事，出门胥有营。\n红尘骑马客，白发听鸡声。\n茅屋閒将老，蒲团坐到明。\n相看同此意，谁浊更谁清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东林七问 其六 问字","author":"成鹫","text":"相知无厚薄，相见有疏亲。\n偶尔逢新识，悠然思古人。\n阅穷千载事，赢得半生贫。\n何似秦灰后，金张早致身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东林七问 其七 问剑","author":"成鹫","text":"往往难平事，烦君几濯磨。\n风尘频抖擞，岁月易蹉跎。\n钟虡消兵器，铅刀当太阿。\n不知三寸管，谁较杀人多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"后七问 其一 问天","author":"成鹫","text":"我有千古恨，高高将听卑。\n亦知曾补后，不似未分时。\n得气清何少，流光照或私。\n可能空阔外，容我管中窥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"后七问 其二 问影","author":"成鹫","text":"不辨谁宾主，何因有往还。\n怜君时一顾，笑我未能閒。\n世态胶难合，前尘迹可删。\n终当事韬晦，相待掩重关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"后七问 其三 问津","author":"成鹫","text":"扰扰役车尘，悠悠失路人。\n九衢多覆辙，一往几埋轮。\n我亦自兹去，相逢笑有因。\n别寻林下叟，回指故山春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"后七问 其四 问岁","author":"成鹫","text":"空瓶无俗物，破甑久生尘。\n比日事田圃，占年拜水神。\n审能免沟壑，不敢慕陈因。\n愿得长如此，终身作野人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"后七问 其五 问夜","author":"成鹫","text":"孤灯坐终夕，坐久灯力微。\n晓漏知多少，邻鸡闻庶几。\n病躯慵下榻，花气促披衣。\n笑问儿童道，晨星稀未稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"后七问 其六 问字","author":"成鹫","text":"自从闻鬼哭，不复更摊书。\n渐觉乌成马，无心獭祭鱼。\n偶来观越绝，相失半秦馀。\n稽首空王问，三伊如不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"后七问 其七 问剑","author":"成鹫","text":"举世争雄日，何妨独守雌。\n冤亲平等视，风雨寂寥为。\n浩气销能否，全身付与谁。\n一弹三太息，惟许湛卢知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十闰诗 其一 闰元夕","author":"成鹫","text":"北里休蚕绩，西畴罢耦耕。\n又来看灯市，相伴入春城。\n好月光仍满，清宵昼欲平。\n旧时按歌地，犹有绕梁声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十闰诗 其二 闰花朝","author":"成鹫","text":"花发朝还暮，花时去复回。\n方将踏青候，又逐看花来。\n所惜韶华老，频教羯鼓催。\n春风如有待，不放刺桐开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十闰诗 其三 闰上巳","author":"成鹫","text":"采兰人散后，折柬又相招。\n老去仍添闰，江边更弄潮。\n韨除尘欲尽，枕漱兴偏饶。\n难得长如此，留春慰寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十闰诗 其四 闰佛日","author":"成鹫","text":"佛日薄虞渊，真风空寂然。\n再来行七步，一闰即千年。\n天上僧祇劫，人閒昼夜缘。\n犹存增减见，惭汗沐金仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十闰诗 其五 闰端阳","author":"成鹫","text":"中天回北陆，馀闰继南离。\n至朔盈虚定，朱明日月迟。\n涧蒲添节节，榴火足枝枝。\n昨有灵均约，重来此一时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十闰诗 其六 闰七夕","author":"成鹫","text":"计日近中秋，星河澹欲流。\n可怜上弦月，犹挂旧针楼。\n巧自前宵得，欢从两度留。\n笑将离合意，重叠问灵修。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十闰诗 其七 闰中秋","author":"成鹫","text":"天上同明月，争怜再闰难。\n山中无历日，虚作九秋看。\n木落光初满，霜深影较寒。\n清辉曾不异，莫惜重盘桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十闰诗 其八 闰九日","author":"成鹫","text":"往往龙山去，频频笑孟嘉。\n更寻前月约，还问隔篱花。\n雪近霜侵鬓，风高帽侧纱。\n几回登望意，一半惜年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十闰诗 其九 闰除夕","author":"成鹫","text":"闰馀已成岁，春入不知年。\n老长三旬腊，穷多一月缘。\n痴呆先待价，粥饭后还钱。\n明发开新历，生涯十二篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十闰诗 其十 闰生日","author":"成鹫","text":"事事不如人，蹉跎又一春。\n浮生易知足，馀闰苦随身。\n对客徵前梦，逢僧话昔因。\n赢来三十日，输却落花晨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其一 垦荒","author":"成鹫","text":"爱此无租税，荒田自在耕。\n土膏深更出，混沌凿还生。\n鈯斧悬腰重，长欃著手轻。\n偶来问农圃，大地几时平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其二 种树","author":"成鹫","text":"十年生计在，此意与谁论。\n取次青垂槛，方将绿映门。\n无心藤倚树，转盼叶归根。\n留得庭前柏，清阴付子孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其三 编篱","author":"成鹫","text":"所居无四壁，聊复借藩篱。\n芳槿环三匝，春风时一披。\n人声灯火外，门掩月光迟。\n莫惜重重隔，墙东知是谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其四 葺茅","author":"成鹫","text":"诛茅补茅屋，乃在西峰西。\n但恐风雨至，不知云日低。\n宽惟客膝坐，高仅与眉齐。\n何事居庵主，沿山辞蒺藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其五 摘茶","author":"成鹫","text":"草木得真性，无人也自芳。\n下山才半日，采撷已盈筐。\n剩有烟霞气，归来衣带香。\n留僧酣茗战，看尔展旗鎗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其六 芟草","author":"成鹫","text":"石上草根浅，日高朝露晞。\n荷锄惟独往，翘楚刈将归。\n物理有代谢，吾心无杀机。\n所思在空谷，迟暮惜芳菲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其七 灌园","author":"成鹫","text":"飞泉不到地，疏雨未成霖。\n努力事朝汲，长歌怀汉阴。\n露葵刚覆足，霜芥欲抽心。\n珍重灌园叟，平施无浅深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其八 牧牛","author":"成鹫","text":"与子周旋久，无心得便安。\n溪山随分纳，苗稼不相干。\n春草閒眠稳，秋田纵步宽。\n笑看披绣者，骍角太无端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其九 枧泉","author":"成鹫","text":"众流归绝壑，一线下阶除。\n结束云閒瀑，飞腾屋角鱼。\n入门无别路，应物贵中虚。\n何用西江汲，长空水到渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其十 负薪","author":"成鹫","text":"清晨随众出，薄暮负薪归。\n渐觉钟磬近，远看云树稀。\n长林连野烧，落木带霜威。\n忆昔樵苏地，不知今是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其十一 拥炉","author":"成鹫","text":"石火爇枯木，地炉生湿烟。\n阳和回冻谷，风雪过残年。\n世事自冰炭，吾心殊冷然。\n无人知此意，使我忆南泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其十二 补衲","author":"成鹫","text":"十年成一片，计日累千针。\n重叠水云态，绸缪岁月深。\n揩磨非著意，寒暑失偷心。\n渐觉无痕迹，衣珠不用寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其十三 制笠","author":"成鹫","text":"搴藤编箬叶，迎刃解霜筠。\n新制平头笠，能遮扑面尘。\n影边无别物，世外有閒身。\n多谢乘车者，何劳揖故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其十四 织屦","author":"成鹫","text":"老来生计拙，织屦学于陵。\n拨草明朝路，编蒲昨夜灯。\n过桥逢孺子，度岭识归僧。\n从此狞如虎，孤峰可共登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其十五 斸笋","author":"成鹫","text":"落箨带残霜，新苞出旧房。\n浅深俱有得，遍界不曾藏。\n所贵无枝叶，何须较短长。\n此君知此意，相赠独盈筐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其十六 餐菊","author":"成鹫","text":"楚客有佳味，山僧非酒人。\n醉嫌陶靖节，颦效屈灵均。\n无复盐梅想，偏宜姜桂辛。\n东篱花满眼，霖雨任经旬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其十七 折藕","author":"成鹫","text":"浮生聊寄迹，决绝复奚辞。\n一洗尘根净，方知涅不缁。\n可堪盈手赠，偏与素心宜。\n大地同饥渴，于君有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其十八 啖斋","author":"成鹫","text":"白首无兼味，黄斋只数茎。\n不知牙齿落，还与菜根争。\n发瓮醢鸡笑，行堂热椀鸣。\n辛酸赢一饱，多谢楗椎声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其十九 采蕨","author":"成鹫","text":"晨出采薇蕨，暮归逢隐沦。\n殷勤频借问，夷叔是何人。\n粳米卢州饭，迷阳大地春。\n我心无不可，饱食报能仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居杂咏 其二十 茹芝","author":"成鹫","text":"茅堂烟火后，云外采芝归。\n紫玉流匙滑，银丁入馔微。\n神仙宁绝粒，吾道本忘饥。\n却笑商山老，驴年未息机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十二声诗 其一 涧声","author":"成鹫","text":"浩然长独往，万古无知音。\n纵与烟霞别，终存水石心。\n幽人通语默，相得在高深。\n寂寞笙歌外，闻声不可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十二声诗 其二 杖声","author":"成鹫","text":"隔溪微送响，一一入徘徊。\n声向静中得，客从何处来。\n谷兼山屐应，路带楚吟回。\n渐觉过桥疾，多应落日催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十二声诗 其三 叶声","author":"成鹫","text":"古亭抱秋树，秋意失婆娑。\n畟畟下凉吹，萧萧鸣远柯。\n渐知声应少，止觉别离多。\n未敢随流默，知音谓我何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十二声诗 其四 车声","author":"成鹫","text":"安步吾将老，驰驱世共频。\n枕边倾只耳，门外过双轮。\n一往忘喧寂，同声互主宾。\n文轩齐荜辂，俱是未閒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十二声诗 其五 茶声","author":"成鹫","text":"几欲清烦虑，闻薰便爽然。\n圆音知活火，微响辨新泉。\n想到希声处，消归七椀边。\n邻翁听总彻，宁待隙风传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]