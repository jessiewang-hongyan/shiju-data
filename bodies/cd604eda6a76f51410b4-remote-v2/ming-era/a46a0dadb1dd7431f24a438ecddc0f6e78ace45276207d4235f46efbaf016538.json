itle":"游莫愁湖徐氏庄 其四","author":"王世贞","text":"一葫芦酒一沙鸥，唤作卢姬与劝酬。\n陌上少年知自悔，青楼抛尽锦缠头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其一","author":"王世贞","text":"一口空龈两鬓星，可能知己不凋零。\n那堪此夜山阳笛，吹到原头病鹡鸰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其二","author":"王世贞","text":"偷得余生能几时，不须肠断为分离。\n唯愁业识难凭据，枉向泉台无会期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其三","author":"王世贞","text":"一讣惊传渐已真，但来相慰各沾巾。\n谁能洗却关情话，祗道乾坤无此人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其四","author":"王世贞","text":"当时奉讳十年强，何夕何曾不对床。\n但落人间成聚散，更堪天地两茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其五","author":"王世贞","text":"久将情字付庄周，有泪何曾汗漫流。\n今日泪来禁不得，始知真痛在心头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其六","author":"王世贞","text":"端坐能抛火宅身，共言前路不迷津。\n惟怜忍位无无着，那可翛然送世亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其七","author":"王世贞","text":"澹圃烟波似辋川，薋园花木小平泉。\n而今总是销魂地，断送余生蜡屐缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其八","author":"王世贞","text":"新诗十卷写初成，滴泪和丹字字评。\n唤作家鸡应不分，风神多自济南生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其九","author":"王世贞","text":"初从六季仿先秦，晚节成风妙斲轮。\n若使余年天假后，老夫甘作卫夫人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其十","author":"王世贞","text":"容易金门四挂冠，不言田里起家难。\n前头正是云霄路，收拾雄心付盖棺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其十一","author":"王世贞","text":"尚忆当年废蓼莪，凄然吊影两湘累。\n那知白日回光处，已傍崦嵫奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其十二","author":"王世贞","text":"子猷当日痛人琴，刚是乾坤死别心。\n若使弹成山水调，更应肠断为知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其十三","author":"王世贞","text":"尚书阡柏紫云屯，新奉君王表墓门。\n莫较生前供养日，九泉先得侍晨昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其十四","author":"王世贞","text":"谈玄未竟又谈禅，似净身心未了缘。\n何事又添名理障，病中犹着望崖编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其十五","author":"王世贞","text":"晨朝煮粥啖饥贫，夕向寒林施鬼神。\n岂是好生非帝意，不教留却善缘人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其十六","author":"王世贞","text":"支分身后析秋毫，尔自从容见似劳。\n惭愧老夫临去日，一抔黄土听儿曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其十七","author":"王世贞","text":"晨晡一哭泪全枯，泪到枯时气稍苏。\n无奈陡然冲念发，数声天际雁行孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其十八","author":"王世贞","text":"一病经年百感侵，到头方验道根深。\n银台化佛空劳至，不解无生忍处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其十九","author":"王世贞","text":"长将勇退抑飞腾，火色鸢肩未可凭。\n别有数行家国泪，宋文皇帝语王弘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其二十","author":"王世贞","text":"欲将何物拟传真，遗墨纵横妙绝伦。\n不展如何便忘却，展来一字一伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其二十一","author":"王世贞","text":"当时得御李龙门，爱尔长呼小陆云。\n今日人间留不得，可应相替一修文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其二十二","author":"王世贞","text":"闽海诸生雅并奇，山摧斗折为君悲。\n那知匹练吴门马，发白颜公在此时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其二十三","author":"王世贞","text":"遗书一字不关情，相度须宏士气平。\n纵美兹言谁为达，阿兄无意问燕京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭敬美弟二十四首 其二十四","author":"王世贞","text":"四十金绯已叹迟，腰章一纪未全移。\n莫言卿少年仍老，得老于今也不悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上人将谒补陀过金陵谒诗为别 其一","author":"王世贞","text":"百日都无一日闲，暂闲如在补陀山。\n难将面目从师勘，且向潮音洞里还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上人将谒补陀过金陵谒诗为别 其二","author":"王世贞","text":"宝地莲花不动尊，如何移足向红尘。\n请公但问金陵客，若个能抛火宅身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠闽人姚应诰林谐林故司寇汝雨公子也","author":"王世贞","text":"姚生拥鼻无闽语，林子裁篇有父风。\n怪得延津饶紫气，赠余双剑有雌雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李宗伯以四绝句慰余请告赋此奉酬且伸后约 其一","author":"王世贞","text":"清狂贺监雪盈颅，再乞君王旧镜湖。\n最爱青莲李供奉，掌中投赠四骊珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李宗伯以四绝句慰余请告赋此奉酬且伸后约 其二","author":"王世贞","text":"一书驰奏请林皋，旅病经时骨自高。\n十月霜浓流潦降，怜君空赋广陵涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李宗伯以四绝句慰余请告赋此奉酬且伸后约 其三","author":"王世贞","text":"肯向朝贤叹积薪，从他籍底日沈沦。\n若教容易居薪上，已作君厨爨下尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李宗伯以四绝句慰余请告赋此奉酬且伸后约 其四","author":"王世贞","text":"金陵市酒黑于油，公肯来寻从事不。\n莫道老夫归思恶，比他陶令尚风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠詹常卿与其弟仲发两茂才 其一","author":"王世贞","text":"詹家玉树两分行，文酒丹青事事强。\n却有一言应莫笑，不知谁得使君狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠詹常卿与其弟仲发两茂才 其二","author":"王世贞","text":"水到休阳分外清，乔髦二子早知名。\n争先出匣龙渊色，容易交他乐令评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘溧阳征复应朝便道省觐御史大夫公 其一","author":"王世贞","text":"尚书尺一问潘郎，可是河阳让溧阳。\n河阳种花千万树，溧阳祗晓课农桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]