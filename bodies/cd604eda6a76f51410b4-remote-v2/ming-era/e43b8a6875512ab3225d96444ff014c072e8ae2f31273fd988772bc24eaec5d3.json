[{"title":"题黄明甫扇","author":"邵宝","text":"小江波接大江波，江上潮声入梦多。\n赋得新诗来慰我，溪人争道濯缨歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠周松月","author":"邵宝","text":"晓起空庭月在松，惠山寺里正鸣钟。\n诗人访我来何早，第七峰前一短筇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"显公房夜坐","author":"邵宝","text":"两宿禅房不问禅，夜深无事足高眠。\n西山松竹东山月，共作清凉到榻前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚酌吴太史新第用送吴中孚韵","author":"邵宝","text":"晚凉乘月到新居，庭院无尘意有馀。\n不信故人千里隔，可教今夜一尊虚。\n清风六月仍留卷，淫雨三秋未报书。\n水接长空山满地，天涯有客独知予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游山不果用前韵自解兼寄宁庵","author":"邵宝","text":"相逢应笑我痴顽，谁到宜兴不到山。\n乘兴更期三载后，题名真拟万峰间。\n旧游随处皆成漫，胜槩平生未放閒。\n莫作寻常诗话道，有人天上正思还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过昌山用欧阳圭斋韵","author":"邵宝","text":"江自袁来一道斜，万山回首正思家。\n游云润足滋胸臆，活水清堪漱齿牙。\n薄暮更闻林外鸟，馀春犹见道傍花。\n铃冈高处多奇观，已办明朝踏软沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谈秋云挽词","author":"邵宝","text":"云到秋来懒作霖，飞飞何处竟销沈。\n听琴未了钟期兴，许剑长怀季札心。\n两郡事曾归史馆，百年名合传儒林。\n新碑高倚游来坞，时有行人下马寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏竹茶垆次匏翁","author":"邵宝","text":"雨过春山满汲泉，旧僧垆在好烹煎。\n缁尘性绝甄陶外，烈火心降汗竹前。\n白雪翻时群蟹沫，碧云烝处一龙眠。\n调元固有商家鼎，不出山林道已全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别都昌师生","author":"邵宝","text":"三宿淹留四庙前，诸生日日候开船。\n情深东道天留客，心急南风夜梦仙。\n刚道旧游如传舍，漫看新赏又宾筵。\n沙边回首人堪画，青隐团山水接烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望白鹿不克至","author":"邵宝","text":"白鹿山人旧结庵，胜游寥阔思何堪。\n也知云壑风泉在，却与田夫野老参。\n十里舆从双涧北，三间亭对五峰南。\n宗儒更想瞻依地，高座凝尘共一龛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄沈提学先生 其一","author":"邵宝","text":"千里书来十载心，庐峰回首洞庭深。\n杜陵故有江头兴，楚客今非泽畔吟。\n赤壁紫箫仍响应，白云黄鹤竟销沈。\n钟期亦是人间耳，只向无人听处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄沈提学先生 其二","author":"邵宝","text":"草堂白下几相寻，春燕秋鸿远竟沈。\n鲁国尚存周乐谱，吴歌还和楚人吟。\n閒随酒榼山山胜，老向书檠夜夜深。\n他日一言君误矣，百年高谊独铭心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游龟峰","author":"邵宝","text":"倚空秀色独青苍，久拟登临始得偿。\n径似天旋深更曲，峰如人立正兼方。\n飞潜有象元奇幻，开阖无机亦善藏。\n却伫山门穷众妙，不知僧语落荒唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白鹿洞怀苏虚斋","author":"邵宝","text":"虚斋游处我还游，每见新诗石上留。\n对月幽怀双榻晚，乘风高兴一槎秋。\n九龄度远何须问，安定功多却许收。\n欲向匡峰望巫峡，楚天云尽有江流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄谢陈中丞","author":"邵宝","text":"御河流水逐潮回，南去风帆不用催。\n千里驱驰劳远计，百年经略见雄才。\n地当海浦非他镇，城倚天津复此台。\n病眼临分重回首，拱辰楼迥晓烟开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄梦弼还江阴","author":"邵宝","text":"儒吏风流又在今，寻常嚬笑见君心。\n车前独许花迎旆，堂下长留鹤听琴。\n紫极自连诸宿近，白云犹阻一江深。\n明年欲问鸾栖地，天照西台柏有阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄储静夫太仆","author":"邵宝","text":"未出都门便忆君，沧波渺渺海陵云。\n船如米芾谁当泊，榻似陈蕃我合分。\n塞北兵戈方用武，江东尊酒自论文。\n不堪画鹢催南发，杨子湾头日正曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒邺侯祠","author":"邵宝","text":"井道而今政有功，瓣香来吊邺侯宫。\n龙收云雨秋空碧，鸿起江山夕照红。\n朱绂漫传封拜后，白衣真想指挥中。\n石池千古寒泉在，歌罢沧浪一鉴空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别惟诚左辖","author":"邵宝","text":"西湖方了旧襟期，懒和三湘赠别诗。\n冰鉴百年谁尔相，汪陂千顷子吾师。\n登临兴逸山僧识，经国心劳野老知。\n回眼江天人似玉，东风还寄古梅枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠刘瑞州用齐用陆东皋先生在许州赠予韵","author":"邵宝","text":"长安别后怀君甚，下马频过太法师。\n曲沃政看重布日，横渠书忆旧谈时。\n忧深未觉江湖远，望切真嫌道路迟。\n若问东山今岭外，暮云千里隔心期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻周文化擢宪使","author":"邵宝","text":"天上新传宪长书，向来人望果非虚。\n十年剑试磨霜后，百鉴堂开捲雨馀。\n风月一庭元自在，湖山千里竟何如。\n我车半识江西路，荆棘须公次第除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅朱廷补 其一","author":"邵宝","text":"春风三月动新袍，泉上归来兴颇豪。\n流水有情双涧远，浮云无数九峰高。\n醉颜不是烧丹苦，病骨犹堪艺圃劳。\n日夕怀人何处是，草亭烟水注离骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅朱廷补 其二","author":"邵宝","text":"知子才名日月深，宫花真合一枝簪。\n理从后宋能超拔，文到先秦已浸淫。\n百战力回千里足，九成丹熟一丸心。\n明时莫叹遭逢晚，六行宾兴古即今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"追次秦中斋先生韵赠潘玉林","author":"邵宝","text":"不见中斋见此诗，玉林高榻雨丝丝。\n白莲社里曾为客，黄石祠前自得师。\n方外未应无野史，世间元亦有儒医。\n墓铭久閟西原草，到处逢人说母慈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中荅杨澹成","author":"邵宝","text":"旧堤溃尽水奔徂，腹疾春来我未苏。\n万厦庇人心本有，一车载鬼事非无。\n病深难与医求艾，苦极聊为子弄雏。\n明日阴晴何处卜，漫将耕穫对田夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又荅","author":"邵宝","text":"雨突云冲势未徂，黄楼谁助长公苏。\n雷师此日威何有，风伯他年讼可无。\n灶引坎蛙将故侣，檐飞巢燕困新雏。\n长歌欲堕填河泪，万里东南一病夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄钱子推是日子推宿山中","author":"邵宝","text":"病不登山梦到山，也知高兴在松关。\n云随社老看碑去，风送邻僧供茗还。\n无石似龙还画葛，有崖如玉合书颜。\n更烦题我新精舍，脩竹千竿屋数间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分宜道中","author":"邵宝","text":"钟山洪口望铃冈，十里萦纡水石长。\n鸥鸟自忘争席老，桃花曾误问津郎。\n督师节远凭催鹢，视学碑荒愧憩裳。\n此去胜游须记取，春风三月过潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻李絅庵计","author":"邵宝","text":"逢人每问李蓉湖，晚兴春来倩杖扶。\n画有幅巾真称尔，传无椽笔枉教吾。\n全归地拟诸君子，终养天成一丈夫。\n他日遗文何处觅，平生碑板满东吴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过清江访彭云田","author":"邵宝","text":"相逢忽讶鬓成丝，药笼闻多贮紫芝。\n汝颍旧游如说梦，江湖今雨又论诗。\n碧分草色开新社，红入桃花满故枝。\n田事有秋何必问，白云元与此心期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客中病作","author":"戚继光","text":"暑气蒸衣湿，幽栖祗自怜。\n那堪多病客，偏怯火云天。\n旅梦惊啼鸟，乡愁望过船。\n杖藜何所值，野寺一僧还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪树","author":"戚继光","text":"丛林凝雪时，琼花耀长路。\n忽忽来羲和，依然见枯树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暑雨","author":"戚继光","text":"暑雨连三夕，溪声日日流。\n门前通独木，天上过孤舟。\n旧国莓苔老，他乡禾黍秋。\n故人何契阔，愁绝一登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江楼","author":"戚继光","text":"半溪晴日衔疏柳，无数秋山入小楼。\n谁伴主人一潇洒，滩头钓石石头鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀","author":"戚继光","text":"佳人负红颜，家在白茅渚。\n独怜形影时，东风一延伫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺意","author":"戚继光","text":"不见郎君到，但见塞鸿归。\n鸿归知妾意，故向楼前飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南庄即事","author":"戚继光","text":"野色山千里，香风水半池。\n小亭无一事，白日苦催诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河听笛述闺情","author":"戚继光","text":"茫茫辽海无鳞羽，戍客寒深妾怨深。\n何处少年吹铁笛，愿风吹入阿郎心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日谒圣水庙","author":"戚继光","text":"庙枕清泉不记秋，当年灵气一时收。\n谁人更识为霖意，门掩松杉落日愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜静","author":"戚继光","text":"静极气如响，流芳月下闲。\n仰天发长啸，宿鸟堕林间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金岭驿","author":"戚继光","text":"楚雀声中感慨深，邮亭午梦苦相侵。\n院幽昼永无人到，啼罢槐阴过柳阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛亥年戍边有感","author":"戚继光","text":"结束远从征，辞家已百程。\n欲疲东海骑，渐老朔方兵。\n井邑财应竭，藩篱势未成。\n每经霜露候，报国眼常明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日 其一","author":"戚继光","text":"经时谢客掩柴关，秋入江皋草色斑。\n玉露凄清天宇迥，金风萧瑟洞云闲。\n苍苍晚木群猿集，历历睛沙一鸟还。\n偶上高楼意疏豁，山河极目转愁颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日 其二","author":"戚继光","text":"清溪谁与濯尘缨，水气常昏海上城。\n北塞晓烟嘶戍马，西风寒浪吸长鲸。\n旗翻紫电皇威远，剑跃青虹阃令明。\n骄子莫询周鼎重，郁葱佳气满神京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"述竹间妇","author":"戚继光","text":"绿竹映芳渚，竹里谁家女？\n手攀竹上枝，咄咄时自语。\n高楼临通津，朝暮阅行人。\n芳颜易老妾未售，不是知心肯托身？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙卯元日登太平楼","author":"戚继光","text":"高台元日一登游，东向扶桑送远眸。\n岸隐潮声连古戍，天回春意满芳洲。\n鲸波突兀辽阳隔，螺岛微茫海市浮。\n翘首五云宫阙近，灵氛常映太平楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过严子陵祠","author":"戚继光","text":"当时虎符臣，千载羊裘友。\n试看元勋台，何似山祠久。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋涧","author":"戚继光","text":"寒碧不盈掬，山花欲盈筐。\n同侪好相待，从容采其芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关岭寺有感","author":"戚继光","text":"圣治于今天地宽，危岑何事尚名关？\n客中幞被因秋薄，月下禅钟入梦闲。\n寒水绕溪喧古树，睛烟破曙满空山。\n平生却遣群鸥笑，一片孤忠两鬓斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巾帻山","author":"戚继光","text":"春城东去海氛稀，城畔人烟绕翠微。\n山麓高楼开重镇，辕门晓角起晴晖。\n九天云气三台近，百里江声一鸟飞。\n极目苍茫忆明主，吴钩高接斗牛辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游谢庄","author":"戚继光","text":"谢家亭馆客心惊，径草无媒雨益生。\n柳覆绮疏余迭藓，花摇石磴但流莺。\n仇湖客散黄金后，精舍书闲白日声。\n偶见门前双燕子，徘徊独有主人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忠爱亭","author":"戚继光","text":"危亭悬百尺，结构记兹年。\n陟险消多病，凭高却万缘。\n云边燕阙近，树杪越峰连。\n谁会劳人意，西风一惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"抚松亭","author":"戚继光","text":"我爱将军树，谁同国士忧。\n沧波回远寇，极岛认归舟。\n风堕钧天乐，云横卧月虬。\n抚君频极目，西北有神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自取池","author":"戚继光","text":"挠之亦浊，澄之亦清。\n名曰自取，濯足濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韬钤深处","author":"戚继光","text":"小筑惭高枕，忧时旧有盟。\n呼尊来揖客，挥麈坐谈兵。\n云护牙签满，星含宝剑横。\n封侯非我意，但愿海波平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春野","author":"戚继光","text":"短竹编篱人几家，野扉傍水碧阴斜。\n睛莎何意翩翩燕，淑气无私处处花。\n浙海风和横舴艋，越山春静老烟霞。\n愧予不是寻芳客，夜夜严城度戍笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"铁马","author":"戚继光","text":"一簇敲风百炼成，中宵惊起玉关情。\n总然用尽檐前力，应是无心为利名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄书","author":"戚继光","text":"寄书向知己，不解作家音。\n男儿铁石志，总是报君心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"普宁寺度岁","author":"戚继光","text":"落日萧萧起暮钟，祗园呼酒亦从容。\n时华已谢群情异，风景相将到处同。\n百战谁能宽束带，平生自慰有孤忠。\n残宵坐对寒灯尽，远思悠悠在海东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天台道中柬林尹","author":"戚继光","text":"乱后遗黎始卜家，春深相与事桑麻。\n绿云万顷无闲地，浪说河阳一县花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同行即事","author":"戚继光","text":"客程车马集多贤，随处寻幽意欲仙。\n分石坐谈萝月里，却忘身世是惊弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓征","author":"戚继光","text":"霜溪曲曲转旌旗，几许沙鸥睡未知。\n笳鼓声高寒吹起，深山惊杀老阇黎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张都护","author":"戚继光","text":"萧条宦况有谁怜，横槊歌君感旧篇。\n促膝曾听窗外雨，论心空忆镜中年。\n身谋落落嗟秋水，剑气棱棱倚碧天。\n拜命自惭青鬓在，同期勋业勒燕然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"船厂阻雨","author":"戚继光","text":"春雨下危墙，烟波正渺茫。\n好山当幕府，壮士挽天潢。\n鸟立林边石，人归海上航。\n驱驰还我辈，不惜鬓毛苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送别","author":"戚继光","text":"帘外漏传疏雨，篱边风递幽香。\n明日使君归去，一方月照空梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过清风岭节妇祠","author":"戚继光","text":"清风名岭复名寺，往事依然动客悲。\n岭下年年驰驷马，何如节妇荐江蓠？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿阿育王寺","author":"戚继光","text":"十里青青竹作围，连天山色欲西飞。\n不因国愤冲双鬓，便与支公老翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"督兵援闽游雁山戏集为诗","author":"戚继光","text":"灌木苍苍潦水收，展旗迢递下闽州。\n石僧卓笔含珠晓，玉女乘鸾瀑布秋。\n仙子屏炉回候雁，天孙刀剪傍牵牛。\n神工特为东南缺，砥柱巍然立海陬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"援闽过平阳","author":"戚继光","text":"铁骑长驱千里余，几回清梦到樵渔。\n停杯听雨分秋漏，忧国瞻云启夜庐。\n天末有怀看易老，客中无计可容疏。\n何时投传来东海，还向蓬莱一卜居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宁德平","author":"戚继光","text":"孤城已复愁还剧，草合通衢杂藓痕。\n废屋梁空无社燕，清宵月冷有悲魂。\n步兵涉海悬夷馘，飞旆降俘散蚁屯。\n且喜丈人在帷屋，愿从骥尾报君恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]