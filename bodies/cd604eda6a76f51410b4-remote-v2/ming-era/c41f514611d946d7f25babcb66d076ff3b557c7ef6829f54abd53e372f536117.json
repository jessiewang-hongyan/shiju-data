[{"title":"次庆州壁上韵","author":"崔应贤","text":"风尘回首几番春，案牍堆前白发新。\n夜半惯成林下梦，明朝依旧未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8183,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对马岛舟中夜作","author":"金欣","text":"独泛孤蓬卧未安，西风一夕晚潮寒。\n海天秋色寻无处，却向潘郎鬓上看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8184,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西江寒食","author":"南孝温","text":"天阴篱外夕寒生，寒食东风野水明。\n无限满船商客语，柳花时节故乡情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8185,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"会苏曲","author":"金宗直","text":"会苏曲，会苏曲，西风吹广庭，明月满华屋。\n王姬压坐理缫车，六部女儿多如簇。\n尔筐既盈我筐空，酾酒揶揄歌相逐。\n一妇叹，千室劝，坐令四方勤杼轴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8186,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黄昌郎","author":"金宗直","text":"若有人兮方离龆，身不三尺一何骁。\n平生汪锜我所师，为国雪耻心无憀。\n剑金单向颈股不栗，剑金单指心目不摇。\n嗟尔千乘如蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8187,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"圣母祠祷雨","author":"金宗直","text":"前峰已失后峰青，屏翳撩人不解晴。\n谁画遨头一蓑笠，满村风雨看苗生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8188,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"华山畿","author":"金宗直","text":"冢上青青连理枝，行人争唱《华山畿》。\n野棠花发当寒食，几度春魂化蝶飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8189,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答晋山相公","author":"金宗直","text":"村南村北祝豚蹄，榆柳阴阴鸟雀啼。\n身遇太平生事足，日斜扶醉断桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8190,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游郑氏池亭","author":"金净","text":"主人发天秘，篱落成沧浪。\n孤亭如凫珣，载我浮中央。\n清飙扇巾帻，山翠滴壶觞。\n游鱼聚檐影，飞絮骨海棠。\n聊将倦游客，一笑酬年光。\n森森万竿竹，飒沓驱商羊。\n镜面乱浮沫，藻荇相扶将。\n须臾动涟漪，草木耿斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8191,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"祷龙潭","author":"金净","text":"猿呼乌复噪，四山忽已暮。\n回汀搴杜若，叶叶沾凉露。\n聊就菰蒲眠，秋声在高树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8192,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋闺","author":"金净","text":"木落千山江杳杳，秋空一雁秦云渺。\n空阶月皎蛩音长，蔓草露滴萤光小。\n耿耿残灯夜半过，红楼西畔落星河。\n边衣剪罢寒不寐，飒飒西风鸣败荷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8193,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"旅怀","author":"金净","text":"江南残梦昼厌厌，愁逐年华日月添。\n莺燕不来春又去，落花微雨下重帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8194,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"村舍","author":"金净","text":"水乡丰德郡，萧寺远浮烟。\n地近村灯近，天垂水气连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8195,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次华使张承宪公游汉江","author":"申光汉","text":"天上河源落五台，楼前澄影隔尘埃。\n杨花春尽帆归远，楮岛烟消雁影来。\n物色不随游子去，芳樽今为使君开。\n三韩胜地皆方丈，更借仙风倾一杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8196,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"癸巳三日寄茅洞?山 其一","author":"申光汉","text":"去年三月初三日，燕已归巢花已开。\n人事天时多异态，别情春思重相催。\n前村后谷应无恙，旧约同游底不来。\n茅洞风流还可继，善山虽去?山回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8197,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"癸巳三日寄茅洞?山 其二","author":"申光汉","text":"三三九九年年会，旧约犹存事独非。\n芳草踏青今日是，清樽浮白故人违。\n风前燕语闻初嫩，雨后花枝看亦稀。\n茅洞丈人多不俗，可能无意典春衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8198,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄稷山宰闵君","author":"申光汉","text":"招寻相对县西陵，白日玲珑看纳冰。\n被酒夜归浑似梦，小村时点绩麻灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8199,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望三负山有感","author":"申光汉","text":"孤舟一出广陵津，十五年来未死身。\n我自有情如识面，青山宁忆旧游人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8200,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书事","author":"申光汉","text":"归思无端梦自迷，先生今老小村西。\n杏花绕屋繁如雪，春雨霏霏山鸟啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8201,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"从军行","author":"安璲","text":"关云漠漠关雪堆，北风惨惨山木摧。\n长河冰合马蹄滑，沙塞日落胡笳悲。\n自恨少小系军籍，愁枕金戈眠不得。\n苦寒苦饥不敢言，谁人不畏将军律。\n中宵愁叹何纷纭，犹将膏血输将军。\n将军好服黑貂服，十貂皮当金十斤。\n将军独嗜太牢味，一日军中九牛毙。\n山无馀貂野无牛，诛敛无穷棰楚至。\n鼎中粒，机中布，日日输入将军库。\n将军日富士日瘠，欲往诉之逢彼怒。\n君王每忧军士寒，毛衣布衲输岁阑。\n将军分给苦不遍，肌肤冻裂手拘挛。\n蝗虫岁旱无岁无，不闻赈恤闻催租。\n阿翁弃姑儿弃妇，过半相携逃入胡。\n胡中艰辛不可说，犹胜将军浚膏血。\n将军将军胡不去，去作公卿一军悦。\n天门杳杳严九关，御史纷纷深闭舌。\n廉颇李牧不复生，激烈悲歌肠内热。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8202,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李少妇词","author":"崔庆昌","text":"相公之孙铁城李，养得幽闺天质美。\n幽闺不出十七年，一朝嫁与梁家子。\n梁家之子鸾凤雏，珊瑚玉树交枝株。\n池上鸳鸯本成匹，园中蛱蝶何曾孤。\n丈夫壮志仕远方，山川阻绝道路长。\n儿女含情不忍别，一别那堪肠断绝。\n高梧叶落黄花香，忽惊今日重阳节。\n佳晨依旧复谁在，满苑茱萸不堪采。\n更上高楼望远天，天涯极目空云烟。\n不向旁人道心事，回头滴泪空潸潸。\n牛羊归尽山欲夕，门外终无北来客。\n此身愿得归泉士，死后那知离别苦。\n春花易落兰早摧，凤台翠幄垂蛛丝。\n芳魂不作武昌石，定寄湘江斑竹枯。\n斑竹枝头杜鹃血，血点泪痕俱不灭。\n青山碧草夜茫茫，千古香魂坟上月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8203,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"感遇","author":"许篈","text":"君好堤边柳，妾好岭头松。\n柳絮忽飘荡，随风无定踪。\n不如岁寒姿，青青傲穷冬。\n好恶苦不定，忧心徒忡忡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8204,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"牵情引","author":"许篈","text":"熊州楼观飞云外，白简霜威凌皂盖。\n组练三千引绣衣，罗裙二八鸣珠带。\n九华之帐香氤氲，寂寂琼楼午夜分。\n苎里佳人娇荐枕，巫山仙子渺行云。\n牵情梦罢看归路，别恨迢迢隔烟雾。\n妾心苦作藕中丝，郎意何如荷上露。\n锦水东西杨柳新，往来愁杀断肠人。\n欲将心事寄青鸟，芳草年年空复春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8205,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出山别元参学","author":"许篈","text":"花宫星斗寒相映，叠叠春山闻夜磬。\n楚客初招万里魂，胡僧暂起经年定。\n王孙绿草渐芳菲，松月留人归未归。\n欢喜岭头丛桂暗，芙蓉峰下怪禽飞。\n荷衣蕙带宿云湿，宝殿沉沉鬼神泣。\n明日朝阳江上行，知君惆怅溪头立。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8206,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送参军吴子鱼大兄还大朝","author":"许筠","text":"国有中外殊，人无夷夏别。\n落地皆弟兄，何必分楚越。\n胆胆每相照，冰壶映寒月。\n倚玉觉我秽，唾珠复君绝。\n方期久登龙，遽此成离诀。\n关河路险巇，秋郊方蠲热。\n此去慎行休，毋令阻回辙。\n东陲尚用兵，海峤日流血。\n须冯鲁连子，却秦掉寸舌。\n勿嫌九夹陋，勉徇壮夫节。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8207,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"听子野琴","author":"许筠","text":"秋风入高树，幽斋闻清音。\n误疑在溪壑，不知傍有琴。\n我爱康子野，与世任浮沈。\n美哉恬澹质，涤我尘垢心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8208,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送卢判官","author":"许筠","text":"秋山悬夕照，客意已悲凉。\n况复当此时，送君归故乡。\n相对茅檐下，灯火吐清光。\n佳人抱瑶瑟，促柱倾壶觞。\n殷勤须尽醉，明发各茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8209,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"平壤送南士还天朝 其一","author":"许筠","text":"公子中州彦，缅邈青云姿。\n诗情敌谢朓，赋笔凌左思。\n慷慨请长缨，万里东海涯。\n壮志未劘罍，归骖忽西驰。\n箕郊尚秋热，行李多险巇。\n知音既云稀，况复将远离。\n长路漫浩浩，念之涕双垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8210,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"平壤送南士还天朝 其二","author":"许筠","text":"弱龄有遐想，栖迟在丘壑。\n玩世笑东方，隐几师南郭。\n中年来城市，误为簪组缚。\n谁言珥彤管，素志非黄阁。\n公子稽山秀，为说稽山乐。\n万壑夹崖流，千岩当镜落。\n天台与雁宕，相峙对冥莫。\n所恨天一方，不得凌垠崿。\n尚冀通关梁，东南骋行脚。\n徘徊云门寺，携手翔寥廓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8211,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江天晓思","author":"许筠","text":"西飞燕，东流水，人生倏忽春梦里。\n一夜狂歌不尽欢，十年惆怅情无已。\n渚烟汀树春朦胧，曲栏珠箔星在东。\n兰台鸣鼓逐晓发，轻帆一片飞长空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8212,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蕊珠曲","author":"许筠","text":"云窗雾阁何夜长，湘帘明月低银床。\n玉斧真人年正少，罗衾好绾双鸳鸯。\n兰灯荧荧照画阁，栏外绛河犹未落。\n宿香乍染翡翠衾，娇云未散芙蓉幕。\n佳人风骨广寒仙，霞裾六叶裁轻烟。\n羽盖朝朝向玄圃，蟠桃花发三千年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8213,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陪吴参军子鱼登义城","author":"许筠","text":"迥野垂天末，长江接海流。\n雨馀多牧笛，风急少行舟。\n一鹗穿云去，双凫就渚浮。\n相怜无限思，空倚仲宣楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8214,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴子鱼南庄归兴次韵","author":"许筠","text":"松关竹径带晴烟，家住溟州第二天。\n绕屋溪声来更远，卷帘山色自堪怜。\n家人宿火炊篱菜，坐客清谈汲茗泉。\n偏缚尘缨为傲吏，几将乡思赋归田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8215,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬吴子鱼先生","author":"许筠","text":"野馆荒凉门半开，入帘残月影徘徊。\n露虫偏向秋林织，今夜故人来不来？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8216,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"呈吴子鱼先生","author":"李秀才（朝鲜","text":"凌晨走马入孤城，篱落无人杏子成。\n布谷不知王事急，隔林终日劝春耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8217,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"席上赋呈吴子鱼先生","author":"蓝秀才（朝鲜","text":"平壤城北路偏赊，满目烟波日又斜。\n且向尊前惜欢笑，马头开遍海棠花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8218,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"感怀呈子鱼吴参军","author":"尹国馨","text":"麻衣偏拂路歧尘，鬓改颜衰晓镜新。\n上国好花愁里艳，故园芳树梦中春。\n扁舟烟月思浮海，匹马关河倦问津。\n七载干戈叹离别，绿杨莺语太伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8219,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游龙山呈吴子鱼先生","author":"梁亨遇","text":"桃花开后杏花稀，客子来时燕子飞。\n山郭数村芳草合，野篱三面乱峰围。\n风尘歧路何年尽，破帽长裾此计非。\n遥忆故乡归不得，白鸥春水掩柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8220,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和钟陵山居诗 其一","author":"梅月堂诗","text":"人间变态薄于纱，端合归来卧碧霞。\n老境病蝉藏翳叶，人生秋蝶寄浮槎。\n风前细细飞松子，云外毵毵落桂花。\n莫道道人咽沆瀣，岩边春雨种胡麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8221,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和钟陵山居诗 其二","author":"梅月堂诗","text":"蛱蝶双双飞药畦，山禽饶语竹篱西。\n一丛枸杞花初遍，五丫人参弃已齐。\n翠竹林中香麝睡，紫荆枝上画眉啼。\n乾峰昨夜疏疏雨，泛滥南池涨小溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8222,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜泊大滩","author":"荪谷","text":"夜缆泊滩下，水村霜气凝。\n枯查拾沙渚，爨火乞渔灯。\n病客孤舟梦，寒江十月冰。\n辞家今几日，黄帽是亲朋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8223,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别李季献之京","author":"荪谷","text":"别意不自制，前情良可嗟。\n海隅为客久，关外送人多。\n野岸飞花树，春桥水上波。\n犹同子规鸟，洒泪湿林柯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8224,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"公山逢宋廷玉","author":"荪谷","text":"寇盗经年岁，干戈满汉阳。\n所亲皆丧乱，不敢问存亡。\n西日瞻行殿，东风入故乡。\n时危对君酌，涕泪欲沾裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8225,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓行板桥村","author":"荪谷","text":"水关西路听鸡鸣，岭月初沉晓雾平。\n人响间闻茅店语，马蹄连上板桥声。\n悠悠渐喜乡山近，琐琐偏知旅态生。\n更下长陂说徒侣，天明须趁及先行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8226,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄问许典翰","author":"荪谷","text":"甲山西北接阴山，鸟道悬云不可攀。\n迁客北行何日到，家书时寄隔年还。\n长闻刁斗城埤里，但见鼯貂树木间。\n圣代岂终才子弃，莫教三十鬓成斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8227,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渡清川江","author":"荪谷","text":"安州城外水如天，立马沙头唤渡船。\n帆带晚烟依草岸，雁迷残日下芦田。\n长途旅客思归计，向老筋骸忆少年。\n始信在家贫亦好，近来双鬓转萧然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8228,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书怀","author":"荪谷","text":"人间万事不如意，得失悠悠看塞翁。\n好月楼台还有病，落花时节每多风。\n倘来轩冕虚无里，过去英雄寂寞中。\n五十之年何所有，一声长啸望遥空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8229,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"道中感怀","author":"荪谷","text":"龙泉鸣吼匣中悲，十月西风两鬓丝。\n黄叶满山秋寺废，白沙连渚小桥危。\n孤帆过后千峰夕，匹马行时百草衰。\n牢落故居空入梦，乱藤疏竹有茅茨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8230,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题清道李家壁","author":"荪谷","text":"南来数月计多违，节序如流已授衣。\n旅舍不堪黄叶落，暮天遥望白云飞。\n唯有同来野僧在，病吟相对说西归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8231,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠别韩景洪濩","author":"荪谷","text":"西街曲巷尹家庄，每到寻常把酒觞。\n全盛旧时如梦寐，乱离今日更凄凉。\n短衣关塞风霜苦，匹马秦京道路长。\n往事悠悠问无处，送君安得不沾裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8232,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"立春吴体","author":"荪谷","text":"江东客里逢立春，节物风光愁杀人。\n盘中生菜不可食，门前柳条还欲颦。\n悠悠西塞独身远，杳杳南国多兵尘。\n中兴宗社大臣在，怅望涕泪沾衣巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8233,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"客怀","author":"荪谷","text":"此身那复计西东，到处悠悠逐转蓬。\n同舍故人流落后，异乡新岁乱离中。\n归鸿影度千峰雪，残角声飞五夜风。\n惆怅水云关外路，渐看芳草思无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8234,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢勤上人","author":"荪谷","text":"新家峡里老农居，田圃收功不愿馀。\n百计谋生无上策，数诗排闷有中书。\n秋晴林径时行药，雨后溪潭见钓鱼。\n惟有野僧知我意，近来栖息问何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8235,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无题","author":"荪谷","text":"瑶弦纤缕合欢床，暖压红钱小洞房。\n梦觉秦楼分翡翠，日沉湘浦断鸳鸯。\n妆钿宝月明珠缀，腰带盘云瑞锦囊。\n十二斜行金雁柱，碧沙如雾掩秋香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8236,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙城次玉峰韵","author":"荪谷","text":"清溪雨后起微波，杨柳阴阴水岸斜。\n南陌一樽须尽醉，东风三月已无多。\n离程处处王孙草，门巷家家枳壳花。\n流落天涯为客久，不堪中夜听吴歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8237,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"歌平调四时词 其一","author":"荪谷","text":"门巷清明燕子来，绿杨如雾掩楼台。\n同随女伴秋千下，更向花间斗草回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8238,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"歌平调四时词 其二","author":"荪谷","text":"五色丝针倦绣窠，玉阶新发石榴花。\n银床冰簟无馀事，尽日南园蛱蝶多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8239,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"歌平调四时词 其三","author":"荪谷","text":"金井梧桐下玉阑，琵琶弦紧不堪弹。\n欲将宝镜匀新黛，卷上珠帘怯早寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8240,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"歌平调四时词 其四","author":"荪谷","text":"锦幕围香宝兽危，晓妆临镜涩胭脂。\n绣笼鹦鹉嫌寒重，犹向帘间觅侍儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8241,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"步虚词 其一","author":"荪谷","text":"三角峨峨鬓上绡，散垂馀发过纤腰。\n须臾宴赴西王母，一曲鸾箫向碧霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8242,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"步虚词 其二","author":"荪谷","text":"青铜结伴婉凌华，夜下三洲小玉家。\n闲说紫阳宫里事，玉阶偷折碧桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8243,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"步虚词 其五","author":"荪谷","text":"西岳真君上紫微，百灵奔走备威仪。\n三清秘诀无传授，偷写天章半夜归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8244,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"步虚词 其六","author":"荪谷","text":"羊城使者取真符，露佩胸前豁落图。\n直指扶桑催木帝，及时传语上清都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8245,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"步虚词 其七","author":"荪谷","text":"三坛中夜讲真经，大集群仙列下庭。\n唯有老君修别殿，手书云篆送玄冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8246,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫词 其一","author":"荪谷","text":"平朝日出殿门开，凤扇双行引上来。\n遥听太仪宣诏语，罢朝新幸望春台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8247,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫词 其二","author":"荪谷","text":"宫墙处处落花飞，侍女烧香对夕晖。\n过尽春风人不见，院门金锁绿生衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8248,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]