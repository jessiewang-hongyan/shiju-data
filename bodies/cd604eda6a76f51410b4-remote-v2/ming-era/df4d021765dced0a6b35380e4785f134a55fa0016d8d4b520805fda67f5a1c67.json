[{"title":"过朱潜父种菊园 其一","author":"欧大任","text":"五柳门前一草亭，手栽丛菊爱延龄。\n只今南国王孙宅，人识西江处士星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过朱潜父种菊园 其二","author":"欧大任","text":"离垢先生旧有园，黄花三径喜犹存。\n篮舆半醉归来日，尚有柴桑浊酒尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱贞吉彭稚脩出宿南浦舟中为别得寒字","author":"欧大任","text":"交深淹旅泊，共宿楚江干。\n雪积征途远，波惊客梦残。\n饭牛天欲曙，枕曲夜犹寒。\n星剑灯前把，他宵却自看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宗良孔阳携酒同贞吉饯石亭馆得曹字","author":"欧大任","text":"王孙何意气，送客出城劳。\n交谊星能聚，诗名岳并高。\n雄飞俱世路，雌守且吾曹。\n尚有浮生在，中山足浊醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贞吉携酒同宗良孔阳再饯滕王阁得筵字","author":"欧大任","text":"为恋平原酒，沙头复此筵。\n阁犹看蛱蝶，月自斗婵娟。\n去住牵舟后，江湖把袂前。\n斯须还共立，赢得故人怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春日风雨仍泊石亭馆魏甫佳甫携酒同宗良贞吉孔阳饮舟中得桡字赋成韵","author":"欧大任","text":"章江不可渡，今复驻双桡。\n客困亭仍泊，君来笛暂邀。\n稍堪忘节序，犹自候风潮。\n腊暗催梅萼，青新入柳条。\n沉云歌扇湿，急桨酒船遥。\n满酌开怀抱，清欢慰寂寥。\n鸿飞惊屡下，马冻立频骄。\n莫奏箜篌曲，离魂已半销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瑞昌奉国将军奉敕旌孝伯融与焉纪赠一首","author":"欧大任","text":"将军忠孝自天成，令子犹脩奕世名。\n相以象贤殷大戊，家传为善汉东平。\n千秋带砺河山在，五色丝纶日月明。\n仲举偏题高士疏，豫章今更表西京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过方士功玄隐轩","author":"欧大任","text":"海内诗名谢法曹，径荒今已长蓬蒿。\n书成亭下玄为草，载向门前白是醪。\n孺子湖连敷浅远，匡庐山并少微高。\n知君不借青云色，以此千秋亦足豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望武阳寄余德甫","author":"欧大任","text":"尺书何处问加餐，溢米荒庐一布冠。\n尉氏骨今柴并立，介休刍与玉同看。\n哭来玄冢啼乌急，病后青山策马难。\n惟有白华堪寄汝，烟波西阻武阳寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子深用晦携酒同宗良孔阳饯送分得书字","author":"欧大任","text":"近关频载酒，先枉隔城书。\n风雪能留客，烟波几定居。\n情牵五两外，歌送百觚馀。\n别去长相忆，江头问鲤鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中同华甫发南浦酬用晦 其一","author":"欧大任","text":"六花飞满菟园中，枚叔挥毫自国工。\n江上挂帆千里去，兰台今借大王风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中同华甫发南浦酬用晦 其二","author":"欧大任","text":"陆贾装轻共北归，扁舟冲雪雁同飞。\n谁知此地三人别，却向姑苏望少微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王元美出抚郧阳时予过豫章遥有此寄","author":"欧大任","text":"九重新诏赐彤弓，数马曾知石庆同。\n郧上共尊中执法，郢都今似右扶风。\n楼开玉节筹边远，堤唱铜鞮佐酒雄。\n宾从况兼文武士，登临谁不羡羊公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"腊日过欧村有感","author":"欧大任","text":"黟县南头亦我村，何论名姓谢公墩。\n出山抛却鸡豚社，独把椒花忆故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途中寄顾少参益卿于时益卿方谢病居海上","author":"欧大任","text":"天涯病后忆行旌，北去空驰万里情。\n薏苡谤来双凤阙，芙蓉光在五羊城。\n山中客解陪操管，海上人犹望请缨。\n不是穷愁归赵日，著书何必似虞卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕同华父祁门客舍","author":"欧大任","text":"椒花曾共岭南看，岂料新丰此夕寒。\n独以衣裘淹逆旅，却怜儿女忆长安。\n酒沽白堕扶残醉，饭煮雕胡谢一餐。\n爆竹家家欢不寐，万山风雪照银鞍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游齐云岩雪霁","author":"欧大任","text":"帝畤金堂玉作桥，万松积翠半空寥。\n青山九锁琅函秘，白鹤群呼绛节朝。\n风似洞庭闻广乐，云疑玄圃上丛霄。\n天都此是升真路，去去骖鸾亦不遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白岳樃梅庵吴鍊师西阁","author":"欧大任","text":"玄武宫西侧，千秋此阁尊。\n云移知岳立，松响似涛翻。\n鹤并炉烟起，鹅因墨沼存。\n晓来看玉检，杖策过天门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过休宁访汪禹乂邵长孺","author":"欧大任","text":"雪霁山城曙色开，冲寒犹为故人来。\n柴门下马惊相问，稚子牵衣绕几回。\n河洛风尘千里梦，广陵花月十年杯。\n只今世路头堪白，莫漫飘零说剑才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游吴舍人贲园","author":"欧大任","text":"视草归来未白头，隐居何处是菟裘。\n山移华岳攒花出，水学巴江作字流。\n曲磴云边盘鸟道，飞滩屋下引龙湫。\n辟疆不厌留伧父，春入西园一度游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访胡茂承不遇","author":"欧大任","text":"千金曾结少年场，自拟重逢典鹔鹴。\n念我游燕歌后筑，问君归粤橐中装。\n来投短刺门前客，立忆他乡马上郎。\n极目吴阊飞匹练，回船无笑子猷狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过长源就程子虚宿","author":"欧大任","text":"问讯丰干社，因君策马寻。\n盖倾交未晚，榻下意何深。\n綵笔诸生事，绨袍国士心。\n剧谈天欲曙，携手恋山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪南访吴虎臣","author":"欧大任","text":"河梁别后五年更，金竺停车此日情。\n涕泪总谈皮骨在，云霄宁问羽毛生。\n世疑厌次狂方朔，家自陈留醉步兵。\n与尔逍遥俱万里，不妨江海托浮名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴仲实携酒同陆华父吴仲足方献成吴虎臣方元素汪仲嘉泛新安江得飞字","author":"欧大任","text":"乘筏下渔矶，良朋此会稀。\n雨看巫峡至，涛似曲江飞。\n海雁云俱湿，溪梅玉并围。\n一尊同尔赋，聊得濯征衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨夜集吴虎臣宅得歌字","author":"欧大任","text":"谢家宾从得羊何，夜雨萧萧我更过。\n直以酒尊留北海，岂缘经术老西河。\n青春作伴堪乘兴，白雪谁来敢和歌。\n陵劲一时诸子在，大鄣千丈郁嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜过黄鸿胪汝会宅同华父惟昭汝学直卿观灯得灯字","author":"欧大任","text":"京洛同游客，谁期此试灯。\n树悬珠的皪，窗照玉崚嶒。\n云骑花争出，星桥鹤共升。\n称诗纷满席，偏喜酒如渑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日过吴舍人","author":"欧大任","text":"清溪万道赤山回，内史名家甲第开。\n五色花中龙马种，一毛池上凤凰才。\n人为日起新年入，客似星从万里来。\n右掖知君曾染翰，尚看云气接三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邵一坤墓舍得新泉汪中丞题曰裂石为赋四韵","author":"欧大任","text":"青门故侯后，家行石中涓。\n傍冢山成雪，锄云供有泉。\n碑犹题马鬣，祠已筑牛眠。\n太史操彤管，皇恩更万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题陈达甫酒星亭","author":"欧大任","text":"百年天地小蘧庐，种竹为林与世疏。\n沧海一星堪是酒，青山二酉尽成书。\n葛巾漉后宁辞醉，藜杖钱多不愿馀。\n白眼沉冥君自爱，苏门长啸意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠汪虞仲","author":"欧大任","text":"落穆汪郎有父风，息阴偏学隐墙东。\n谁将处士轻周党，我自通家得孔融。\n相马岂论今日瘦，雕虫先让少年工。\n石楠睥睨天门侧，何限萧然万籁中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴瞩亭为程虞仲赋","author":"欧大任","text":"为问丹阳山长，朝来爽气如何。\n九锡杖笠无恙，四履烟霞孰多。\n欹枕飞梁大石，绕窗全竺松萝。\n纵望长安西笑，不妨捉鼻行歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游程舍人樗园 其一","author":"欧大任","text":"一卧山林道自尊，舍人今似浦长源。\n天年何但樗堪比，手种槐阴已满门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游程舍人樗园 其二","author":"欧大任","text":"珠树岭前看五松，大鄣丘壑贮君胸。\n东来客有青霞佩，为向关前认是龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题宗海别驾水月亭","author":"欧大任","text":"悬车休沐早，于此息微躬。\n水月涵晖处，冬春皎镜同。\n金波犹穆穆，白露共濛濛。\n君自真如性，何劳论色空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬功父格之禹乂鲁文上甫汝恒送别","author":"欧大任","text":"停君车骑翠坡陀，白玉双童几曲歌。\n行客岂堪连袂听，海阳携手似漳河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元宵同李功甫陆华甫邵一坤邵格之汪禹乂金德润金上甫郑鲁文程鸣甫汪虞仲邵济时邵惟成邵汝恒集邵长孺环斋程子虚无过兄弟自歙适至分得高字","author":"欧大任","text":"丘中一士卧，门径尚蓬蒿。\n瓜自逃秦禄，兰曾入楚骚。\n忆从邗上日，并赋广陵涛。\n越调谁令变，南音颇亦操。\n盘宁嫌苜蓿，尊不待蒲萄。\n禅寺时同被，漕河数放舠。\n诗传梅下阁，社结竹西皋。\n再别梁园隔，相思蓟北劳。\n烟霞寻旧约，笔札有吾曹。\n交已倾肝胆，衰今感鬓毛。\n海阳鸾凤渚，江左鸊鹈刀。\n麇至逢诸子，嘤鸣得二豪。\n中兴人竞奋，右席客偏叨。\n筵敞灯花艳，庭看象纬高。\n百牢纷折俎，四座俨挥毫。\n烨烨青萍色，翩翩白鹄袍。\n罗浮归鲍靓，金马使王褒。\n揽袂平原饮，停车末路遭。\n簪裾惭抚髀，风雨洽持螯。\n预恐离群去，何年问浊醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈明府德基邀游江石台迟汪禹乂邵长孺未至得高字","author":"欧大任","text":"天台百尺驻干旄，一曲偏惊白雪高。\n树拥归云封断石，涡盘急峡激飞涛。\n陂因仆射铭今勒，湖比郎官兴更豪。\n千载风流酾酒日，可令鞭弭少吾曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同陆华父邵长孺集何少愚侍御日宜园","author":"欧大任","text":"避骢不记是何年，折节邀宾意独偏。\n席下溪声长㶁㶁，雨中萝色净娟娟。\n问多奇字今无酒，抚亦孤琴久不弦。\n江左仲言称上驷，风流谁得共櫜鞬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜登曹进士仲宣楼","author":"欧大任","text":"江左风流汉署郎，高楼邀客说干将。\n名高绣虎题双管，书就雕龙满几囊。\n山色尽疑连宛邓，溪声犹似挟沮漳。\n只今信美当吾土，夜倚星辰望帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉芝亭为程无过赋","author":"欧大任","text":"明时蒸上瑞，天意为斯文。\n三秀披清露，双茎护綵云。\n玉餐秦桂父，軿度汉茅君。\n欲勒亭前石，仙才本不群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题邵汝恒据梧轩","author":"欧大任","text":"树下机方息，嗒然唯浊醪。\n世今嗟物役，君已解天韬。\n稍得樗全幸，宁知磬折劳。\n松萝看不厌，行弄白云高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新安别华父","author":"欧大任","text":"南来岭外二年赊，并辔东风又岁华。\n铁笛尔思吴苑月，青尊吾醉蓟门花。\n山人诗在宁知侠，国士恩深敢问家。\n抗手新都还此别，莫令漂泊失天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宛陵陈太守郡斋夜集","author":"欧大任","text":"马首都门十载分，宣城把酒念离群。\n榻非孺子犹称客，诗似玄晖却羡君。\n歌里娟娟春谷月，尊前片片敬亭云。\n江南此别三千里，何处飞鸿尺素闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采石渡江寄内","author":"欧大任","text":"携家久有鹿门期，底事风萍怅别为。\n海上渔樵驱远道，天涯童稚见何时。\n江深白雪翻成浪，柳细黄金尽作丝。\n此际不须八行字，羞将憔悴报君知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登谢眺楼","author":"欧大任","text":"南朝多出守，谁似谢宣城。\n宛水犹词藻，青山有姓名。\n烟绵平楚远，练净大江清。\n更望新林浦，应伤去国情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采石谒太白祠","author":"欧大任","text":"庙题江上客，船是酒中仙。\n虎口虽曾脱，蛾眉自可怜。\n醉深秋浦月，梦失夜郎天。\n恨切枫林黑，西川哭杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"憩和州香泉馆","author":"欧大任","text":"何代温汤馆，今依浴院开。\n气蒸江汉上，云度历阳台。\n鹤沼荒明月，骊宫散紫埃。\n惟馀功德水，长许濯缨来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太仆邀游琅琊寺","author":"欧大任","text":"渡江先问好山名，西上琅琊策马行。\n入部敢论星是客，在坰今识月为卿。\n泉题庶子烟光薄，亭倚梅花雪色明。\n未必朝簪妨学道，禅林何限宰官情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"濠上庄子台","author":"欧大任","text":"积石雪涛飞，云来曳白衣。\n大鹏风外息，蝴蝶梦中归。\n天地惟秋水，山河自落晖。\n谁知漆园吏，于此讥无机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"徐州度黄河酬舒观察","author":"欧大任","text":"孔令离筵酌酒歌，风尘犹傍战场过。\n雁声颇共乡心远，春色偏于客路多。\n芒砀东来开钜鹿，昆崙西坼注黄河。\n临戎秉宪如君几，戏马台前兴若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过峄山题邹县亭子","author":"欧大任","text":"邹峄晴看翠满衫，杏花飞尽柳毵毵。\n怪来马上还家梦，却是青山似岭南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衮州楼上闻晓角","author":"欧大任","text":"龟蒙山畔鲁城东，春晓飞花似雪中。\n画角岂堪征客听，断肠不必待秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过兖州寄李阳谷","author":"欧大任","text":"故人双舄远，一望鲁东门。\n经术汶阳重，儒风稷下尊。\n出令惭小草，佩欲赠芳荪。\n粤客犹章甫，谁怜岁七奔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二月十三日大风沙起行德州三十里 其一","author":"欧大任","text":"九道河枯古驿迷，春深风砾马频嘶。\n故乡此日帘栊暖，尽试轻罗听鸟啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二月十三日大风沙起行德州三十里 其二","author":"欧大任","text":"岭外花朝花事齐，故人载酒满江堤。\n谁知独冒风霾色，千里鸣沙似碛西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阜城过献县次公瑕壁上韵因怀公瑕","author":"欧大任","text":"瀛渤苍茫星汉微，征鸿西傍蓟云飞。\n五湖真觉难抛得，未到长安已忆归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食谒大毛公墓祠","author":"欧大任","text":"东过瀛海驻征鞍，椒酒祠前食正寒。\n薤叶覆深题字石，杏花飞满讲诗坛。\n风多大国泱泱后，教自西河寂寂残。\n赵客一官轻博士，鲁人三颂入长安。\n献王昔拜先生席，都养曾供弟子餐。\n碧树种来秦日月，青山藏有汉衣冠。\n祭荒古社增悲怆，城护精庐尚郁盘。\n岂但儒林称训诂，传经千载似公难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄚州城春望","author":"欧大任","text":"柳屿芦汀帆数舟，燕南今似五湖秋。\n楼头一望春波细，谁信风尘古鄚州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卢沟晓发入都","author":"欧大任","text":"百里关门待曙开，西行挽辂几人哉。\n滹沱月照边鸿过，大陆云随代马来。\n紫殿烟花纷晻霭，碧霄宫阙郁崔嵬。\n长卿敢道游梁倦，愧乏公车奏赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初至燕京袁文谷邢子愿梁孔适三进士朱在明顾叔潜二光禄汪太学仲淹同集黎秘书惟敬宅得春字","author":"欧大任","text":"蒯缑歌肯向时人，倦揽征裘万里尘。\n字挟风霜沧海气，路停车毂蓟门春。\n一官直阁怜君老，诸子高阳笑我贫。\n清世已知容结绶，岂堪枚叟更游秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳朱在明见邀同管建初安绪卿张元春修禊韦园时在明南迁将行","author":"欧大任","text":"风光三月帝城春，韦曲千家俯涧滨。\n燕酒共携拚酩酊，客衣频挽韨缁尘。\n青丝辔转花间骑，锦带穿来柳下鳞。\n醉后双童吹玉管，莫令催送渡江人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张羽王利州参军","author":"欧大任","text":"十年相见鬓成丝，燕柳偏逢谪宦时。\n江汉九歌谁忍听，风波一失尔何之。\n巴山月落啼猿急，蜀栈云深去马迟。\n莫道护军蛮府远，应知剑阁待铭诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朱光禄赴崇府审理","author":"欧大任","text":"孤臣何处不天涯，一啸青冥散落霞。\n笛里江淮千里棹，尊前嵩洛十年花。\n在邹韦氏诗为傅，居鲁朱生侠是家。\n去国恩深归有日，汝南元自异长沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈忠甫携酒同梁孔适夜过","author":"欧大任","text":"三年书剑尔燕台，万里风尘我亦来。\n作客敝裘曾自补，傍人长铗竟谁哀。\n斗醪差慰穷途色，囊粟堪羞国士才。\n何限青云骄白眼，酣歌星汉一徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":6575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]