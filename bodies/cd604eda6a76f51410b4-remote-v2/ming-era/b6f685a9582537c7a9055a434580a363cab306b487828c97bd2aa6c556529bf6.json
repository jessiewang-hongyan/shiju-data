[{"title":"为黎学博题琴书图二首 其二","author":"卢龙云","text":"衡门多乐事，何事最相宜。\n会意丝桐远，搜神汗竹奇。\n圣贤终日对，山水几人知。\n儒雅风流并，如君实可师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海天松鹤图","author":"卢龙云","text":"共美千年鹤，来依百尺松。\n樛枝罥海雾，健翮伫天风。\n阅世冰霜久，巢云岁月同。\n九皋闻远近，长是应雌雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"解邑丞兼郡捕得代还东官二首 其一","author":"卢龙云","text":"贰职双凫最，空群一鹗先。\n海方歌赞府，幕下借曹椽。\n舒卷忘情外，腾淩议法前。\n通才需妙选，随地副班联。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"解邑丞兼郡捕得代还东官二首 其二","author":"卢龙云","text":"佐邑称能吏，兼曹重外台。\n绸缪资画诺，保障涤氛埃。\n莲幕三城颂，花封百里回。\n名因趋府达，当宁解抡才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴逸士读小刻有作","author":"卢龙云","text":"几忆王孙草，忽传幼妇词。\n隐高商皓迹，和有郢人诗。\n大雅千秋业，清风百世师。\n知君能载酒，独愧子云奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19658,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答族侄子馨旅中见怀","author":"卢龙云","text":"露气沾残暑，秋声送早凉。\n琴樽怜夜月，书剑返江乡。\n何日云鹏起，他山雾豹藏。\n主人能爱客，旅思不须伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19659,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与诸同年话别于飞云洞二首有引 其一","author":"卢龙云","text":"留滞乡园久，无心更出山。\n圣人方罪己，逐客岂投閒。\n未敢终违世，何妨更抱关。\n招邀惭已再，花下强酡颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19660,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与诸同年话别于飞云洞二首有引 其二","author":"卢龙云","text":"廿载通贤籍，难期聚会同。\n关山时去住，岐路复西东。\n已慕汉阴叟，还希塞上翁。\n浪游随所适，终自愧冥鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19661,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辞三司诸公招饯","author":"卢龙云","text":"蓬巷幽栖久，公庭礼法疏。\n薄游思汗漫，野服出樵渔。\n自觉惭虚席，何劳望小车。\n年来俱饱德，无待接宾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19662,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"勖崔甥二首 其一","author":"卢龙云","text":"明堂需巨栋，资用匪枚条。\n耕凿安时俭，弓旌待国招。\n简编聊自富，岁月岂徒消。\n羽翼南溟徙，吹嘘或不遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19663,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"勖崔甥二首 其二","author":"卢龙云","text":"儒冠看嗣业，取效岂寥寥。\n力及千钧弩，功殊五石瓢。\n贻谋思作室，壮志慕题桥。\n仙液终应就，飞腾越世嚣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19664,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三水舟中别诸亲族二首有引 其一","author":"卢龙云","text":"万里关山道，偏怜后会疏。\n风霜仍旅食，花月想閒居。\n前路谁知己，新诗重起余。\n发船催叠鼓，倚棹更踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19665,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三水舟中别诸亲族二首有引 其二","author":"卢龙云","text":"俛仰思前度，魂销几弟兄。\n归来重聚首，死别已吞声。\n未论干时计，先伤造物情。\n交亲期末路，珍重保馀生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过飞来寺","author":"卢龙云","text":"寺是前朝幻，舟曾几度过。\n江山无恙在，道路此生何。\n云气连帆影，谷声应棹歌。\n茅堂堪避俗，回首愧烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清溪驿阻风适制府戴公书至兼闻西所已报捷云","author":"卢龙云","text":"远道愁风色，停舟问水程。\n冻云孤岫白，细雨一溪清。\n杯酒阳关意，椷书杕杜情。\n西征闻已捷，铙吹动军声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中寒雨二首 其一","author":"卢龙云","text":"水宿愁零雨，江寒傍客裘。\n川原犹万里，漂泊且孤舟。\n不为资三径，何缘薄一丘。\n关心无限事，揣分愧宜休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中寒雨二首 其二","author":"卢龙云","text":"寒风催改岁，阴谷待回春。\n旅鬓星星短，行厨日日贫。\n室家携自累，僮仆转相亲。\n即道京华好，难忘旧隐沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读朱公叔绝交论","author":"卢龙云","text":"伐木歌求友，陈雷义独高。\n知心谁缟带，恋旧几绨袍。\n莫倚甘如醴，真防笑有刀。\n古人交欲绝，著论岂徒劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曲江夜雨","author":"卢龙云","text":"静夜风逾响，孤舟雨较多。\n听篷惊梦断，欹枕奈愁何。\n再想鸣珂入，初残扣角歌。\n漫漫皆未旦，天路忆春和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚霁二首 其一","author":"卢龙云","text":"夕照笼山霭，轻霞映水光。\n冻消林卉木，暖入客衣裳。\n莫自悲游子，教人说漫郎。\n天涯信萍梗，或类酒诗狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚霁二首 其二","author":"卢龙云","text":"未尽江湖兴，转多羁旅情。\n众星捲雾出，孤月带川明。\n道路宽相忆，家山梦不成。\n凄凉追往事，偏唤客愁生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度庾关","author":"卢龙云","text":"一入庾关道，方知楚粤分。\n岭梅明霁雪，乡树迥看云。\n水石应难恋，音书未可闻。\n山川成异地，回首思纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"攸镇夜泊","author":"卢龙云","text":"石齿夹江悬，滩声永夜喧。\n凄风鸣断岸，残月照高原。\n独客无相问，孤舟谁晤言。\n寒鸡催曙色，隐隐出荒村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春日舟过南浦","author":"卢龙云","text":"鼓枻西江道，开樽异地春。\n土牛随俗远，綵燕为谁新。\n雪片残疏柳，风光转弱蘋。\n千门俱淑气，何处可相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕寓玉山客舍","author":"卢龙云","text":"守岁萍蓬里，停骖信宿间。\n两宵看腊去，三日见春还。\n万里趋金阙，孤灯傍玉山。\n天时与人事，客况总相关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春自玉山度岭","author":"卢龙云","text":"率土新王月，他乡有渭城。\n阶知蓂渐发，池梦草初生。\n去逐春宵雁，行听禁苑莺。\n鸡声催晓曙，立马更含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过严子陵钓台","author":"卢龙云","text":"鼓棹出桐江，孤舟类钓艭。\n烟霞迹自混，湖海意难降。\n千古尊严濑，一丝重汉邦。\n客星今寂寂，明月照船窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"正月十六夜泊舟槜李城下时天霁月出漫赋二首 其一","author":"卢龙云","text":"万里途方半，千金夜未休。\n去年今夕酒，一别几般愁。\n士女争浮舫，笙歌别上楼。\n寥寥天畔客，漂泊正孤舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"正月十六夜泊舟槜李城下时天霁月出漫赋二首 其二","author":"卢龙云","text":"向愁江雨阔，今见海蟾生。\n城郭春仍丽，帆樯夜转明。\n孤灯篷底思，独酌旅中情。\n可惜良宵里，长吟作越声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"由云阳登陆途中杂咏五首 其一","author":"卢龙云","text":"吴越舟初系，维扬渡不迷。\n山川馀应接，岐路任东西。\n宦迹存鸡肋，春风送马蹄。\n王孙游莫倦，芳草正萋萋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"由云阳登陆途中杂咏五首 其二","author":"卢龙云","text":"旅席何曾暖，严程不暂遑。\n窗间蝴蝶梦，天上鹭鹓行。\n晓曙疏星白，风沙大陆黄。\n主人粱正熟，驱马复他乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"由云阳登陆途中杂咏五首 其三","author":"卢龙云","text":"客路春山远，乡心海国遥。\n澹烟催柳变，细雨濯花娇。\n策马过回岸，听鸡度板桥。\n王遵叱驭意，多恋圣明朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"由云阳登陆途中杂咏五首 其四","author":"卢龙云","text":"浊酒当春候，缁尘又客衣。\n梨花开野店，燕子入山扉。\n已逐行程远，休嫌乐事违。\n上林香满树，还待日辉辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"由云阳登陆途中杂咏五首 其五","author":"卢龙云","text":"廿载风尘役，三春道路人。\n瞻天行渐近，知己仗谁亲。\n漂泊悲游子，支离笑逐臣。\n绝怜芳草色，随处傍征轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京邸即事二首 其一","author":"卢龙云","text":"独客愁难破，经时念转劳。\n园林开芍药，寝庙荐樱桃。\n乳燕巢檐急，归鸿绝塞高。\n山川凝望远，诗兴为谁豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19688,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京邸即事二首 其二","author":"卢龙云","text":"青阳初改谢，绿叶始交加。\n细雨生榆荚，微风起楝花。\n寂寥虚客况，漂泊感年华。\n骨肉两乡远，谁能不念家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19689,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出京答黄士明吉士","author":"卢龙云","text":"再入长安道，相逢愧逐喧。\n文雄官自达，骨傲位难尊。\n我更莲花府，君惟竹素园。\n预知供奉日，应制几千言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19690,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将晓渡江","author":"卢龙云","text":"挂席出邗沟，长江接远流。\n晴霞光海树，初日起沙鸥。\n山色微浮玉，潮痕不辨牛。\n忽过京口渡，绝爱晓风柔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19691,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚泊广济桥","author":"卢龙云","text":"清浅河桥下，犹传广济名。\n画图山里色，环佩水中声。\n数幅云帆远，千层雪浪平。\n往来多信宿，不尽古今情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19692,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过草萍驿","author":"卢龙云","text":"楚越间关道，篮舆又草萍。\n苔文滋锦石，云气点苍屏。\n扰扰浮生役，劳劳送客亭。\n秋风迟落木，山较往时青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19693,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初至豫章","author":"卢龙云","text":"匹马出长安，山川路渺漫。\n候人催赴幕，先达笑弹冠。\n拙宦羁微禄，非才免素餐。\n公馀仍野服，不省是何官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19694,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"余继中都曹招看花二首 其一","author":"卢龙云","text":"地僻元藏拙，官閒更避喧。\n花神招密坐，酒态美芳尊。\n菊艳先秋发，兰芽过雨繁。\n绕庭栽茉莉，睹物尽乡园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19695,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"余继中都曹招看花二首 其二","author":"卢龙云","text":"满座长留客，分曹静放衙。\n开帘调舞鹤，入座绕繁花。\n胜算棋偏敌，高谈日欲斜。\n非君时命酒，何以度年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19696,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和何郡丞元日郡楼眺望","author":"卢龙云","text":"物态时时改，春光岁岁逢。\n江山留宦迹，花鸟悦尘容。\n望阙心千绪，怀人路几重。\n岂堪持柏酒，独酌对晴峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19697,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈任二君入贺长至二首 其一","author":"卢龙云","text":"江国逢秋尽，征轺望阙回。\n繁霜沾玉勒，霁雪傍金台。\n岁事仍长至，皇休正大来。\n向疑帘陛远，阊阖为君开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19698,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈任二君入贺长至二首 其二","author":"卢龙云","text":"帝里瞻天近，王程计日长。\n榻思违仲举，御喜得元方。\n雪瑞瞻双阙，嵩呼动一阳。\n礼成需后会，且莫厌他乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19699,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"追远诗为张显之赋二首 其一","author":"卢龙云","text":"自得阳城教，偏多狄相思。\n陔兰生永慕，风木有馀悲。\n捧檄伤乌养，遗经重燕贻。\n承恩看奕叶，方信显亲时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19700,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"追远诗为张显之赋二首 其二","author":"卢龙云","text":"已荷丝纶诏，难忘岵屺心。\n松楸看渐远，雨露感弥深。\n爱日欢能几，终天恨不禁。\n显扬知未艾，宁自愧朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19701,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铁柱宫二首有序 其一","author":"卢龙云","text":"墨绶辞荣日，黄冠入道时。\n嵩阳元法地，章水亦瑶池。\n柱藉千年镇，宫开万寿基。\n睹河思禹绩，移颂大江湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19702,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铁柱宫二首有序 其二","author":"卢龙云","text":"赖有诛邪法，堪成拯溺功。\n支祁妖自伏，罔象怪应穷。\n拔宅登玄阆，遗祠礼玉隆。\n鲸鲵多未戮，剑术可能工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19703,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答邓介繁远寄二首 其一","author":"卢龙云","text":"岁月疲奔走，山林道转尊。\n水云淹粤海，吏隐忆江藩。\n命驾谁千里，长城自五言。\n汉文称有道，何日更承恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19704,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答邓介繁远寄二首 其二","author":"卢龙云","text":"寄兴多山水，凭谁为赏音。\n远书仍问业，异地更论心。\n牛马风难及，鱼鸿信易沈。\n何时花月夜，杯酒复同临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19705,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春二日二首 其一","author":"卢龙云","text":"青阳才二日，蓂荚为谁新。\n散吏偏能暇，他乡别有春。\n简编聊自悦，花鸟渐堪亲。\n物态长如此，微名强傍人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19706,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春二日二首 其二","author":"卢龙云","text":"光阴恒代谢，时命复如何。\n雪后惟看竹，春回渐傍花。\n阳舒随物理，雌伏念年华。\n吏傲元兼隐，羁怀望转赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19707,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和希举彦成二宗侯春游诗二首 其一","author":"卢龙云","text":"紫陌条风远，朱门淑气新。\n流年堪抚景，结骑好乘春。\n红染桃初遍，青垂柳欲匀。\n馀寒欣渐散，鱼鸟总相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19708,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和希举彦成二宗侯春游诗二首 其二","author":"卢龙云","text":"当春饶乐事，随处蹑游踪。\n百舌林声巧，千章岸影重。\n偏提悬屡续，凿落泻初浓。\n多少池塘咏，堪谁授简从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19709,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送崔伯子南归二首 其一","author":"卢龙云","text":"每忆乡园会，山川隔晤言。\n愁惟看短剑，喜忽迓高轩。\n并合翻疑梦，襟期未细论。\n匆匆仍别袂，空自愧盘飧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19710,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送崔伯子南归二首 其二","author":"卢龙云","text":"客里逢归棹，江干问谪居。\n斋閒方喻马，铗在岂歌鱼。\n吴楚扁舟路，亲朋几字书。\n薄游嗟世味，应复爱吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19711,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"分宜道中小憩宣风亭","author":"卢龙云","text":"避暑疑无地，宣风忽有亭。\n云流当户白，山起傍檐青。\n隐几看题勒，披襟豁性灵。\n不须愁去暮，纤月起林坰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19712,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过长沙询贾生故宅","author":"卢龙云","text":"汉道犹全盛，君为痛哭书。\n少年方志大，前席岂恩疏。\n赋鵩悲时外，怀沙吊古馀。\n行人多感慨，立马正踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19713,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宁乡四桂亭","author":"卢龙云","text":"徙倚孤亭下，繁阴逗晚风。\n燕山殊未五，淮海不成丛。\n秀色偏相媚，幽香暗自通。\n独谣还独酌，差可慰飘蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19714,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沅湘交会处","author":"卢龙云","text":"太史南浮日，临沅亦涉湘。\n江山藉地胜，藻绘擅人长。\n史述龙门隐，书窥禹穴藏。\n蛮荒何所重，草木借名香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19715,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃源洞二首 其一","author":"卢龙云","text":"一径寻源入，昔人此避秦。\n衣冠今孔道，车马日生尘。\n涧水难容艇，渔郎孰问津。\n仙凡终古隔，耕凿几家邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19716,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃源洞二首 其二","author":"卢龙云","text":"不逢逃世者，空纪遇仙桥。\n缨濯龙池洁，笙听鹤岭遥。\n居人全类古，生业半为樵。\n坐久呼僧语，尘心亦自消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19717,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辰溪山塘驿二首有引 其一","author":"卢龙云","text":"一别薇垣署，溪山路几千。\n花光时记忆，驿舍转娇妍。\n胜赏宁夷险，芳心孰后先。\n主人兼命酒，坐语息尘缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19718,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辰溪山塘驿二首有引 其二","author":"卢龙云","text":"山塘花下酌，仍忆令君香。\n岭树遮炎暑，溪风纳午凉。\n卑枝含万绿，韡萼擅群芳。\n对此烦襟豁，浑忘在异乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19719,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黔岭早行","author":"卢龙云","text":"伏尽已多日，炎氛却未清。\n晓行听木叶，何树着秋声。\n涧草仍生色，山花不辨名。\n重重交紫翠，物态转多情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19720,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沅州中丞府","author":"卢龙云","text":"叹息西征日，曾烦十万师。\n星霜驰白羽，洞壑闪朱旗。\n授钺增开府，修戈慑远夷。\n太平今有象，谁为惜疮痍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19721,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华元洞","author":"卢龙云","text":"一入华元洞，方知境界清。\n荆榛何代辟，门户总天成。\n地迥尘难到，室虚白亦生。\n野僧能供佛，那得罢逢迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19722,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]