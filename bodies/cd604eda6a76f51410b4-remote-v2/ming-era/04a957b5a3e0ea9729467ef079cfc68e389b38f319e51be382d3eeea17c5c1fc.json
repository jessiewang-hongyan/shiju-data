[{"title":"青羊涧","author":"王世贞","text":"流沙西去失青牛，却坐青羊向益州。\n我效初平仍一叱，可能分作钓鱼裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鬼谷涧","author":"王世贞","text":"捭阖书同用不同，可甘王誗易仙宫。\n欲知幽谷原名鬼，六国游魂出此中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"百花泉","author":"王世贞","text":"密绿成帷红作茵，仙家日月号长春。\n不须流出千般色，一种桃花也殢人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甘泉","author":"王世贞","text":"清澄绝胜汉甘泉，一酌心魂自爽然。\n应是武皇探未到，不教仙观表祈年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太乙池","author":"王世贞","text":"浅碧泓停一镜开，探瓢欲酌更迟徊。\n孤峰倒插青莲影，疑是真人坐叶来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"向侍御宗洛登玄岳奉赠得二绝句 其一","author":"王世贞","text":"均阳秋色未成寒，天柱峰头雪欲残。\n君到浮云应不蔽，于今日出是长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"向侍御宗洛登玄岳奉赠得二绝句 其二","author":"王世贞","text":"一笑君家向子平，辞官五岳问长生。\n何如柱史元仙骨，上到天门便玉京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别梁舍人鈙 其一","author":"王世贞","text":"留君且作片时閒，红药清酤染客颜。\n莫笑帅厨无可供，案头长满太和山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别梁舍人鈙 其二","author":"王世贞","text":"名家旧业已三朝，零落犹馀一凤毛。\n今日梁园谁让席，不如金马世堪逃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄欧桢伯助教","author":"王世贞","text":"寄语青毡郑广文，风流儒雅汉庭闻。\n从它明主题三绝，一绝于今总让君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙子郧台偶题十绝 其一","author":"王世贞","text":"燕中车马兴阑干，也恋青山也恋官。\n今日真成双举肘，戟门山色四时看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙子郧台偶题十绝 其二","author":"王世贞","text":"放了报申无一事，雨晴回照在东除。\n天公乞得閒风日，恨少人间未见书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙子郧台偶题十绝 其三","author":"王世贞","text":"汉庭求旧未堪论，列镇俱登八坐尊。\n赖得郧山深更僻，不教衰骨负櫜鞬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙子郧台偶题十绝 其四","author":"王世贞","text":"莫欺憔悴鬓苍浪，片纸能为百邑霜。\n昨夜尚书来尺一，始知身是夜郎王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙子郧台偶题十绝 其五","author":"王世贞","text":"儿童剪纸作元霄，几盏荧荧破寂寥。\n点罢灯油千石尽，两条红烛导归朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙子郧台偶题十绝 其六","author":"王世贞","text":"四月榴花未上枝，不须惆怅怨花迟。\n床头白酒长教熟，也有誇他烂漫时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙子郧台偶题十绝 其七","author":"王世贞","text":"眼底粗无搅意人，要闻乡信又愁论。\n交游变故君休怪，老态参差渐到身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙子郧台偶题十绝 其八","author":"王世贞","text":"周妻何肉不须疑，一卷维摩静自持。\n看到法门真不二，从前绮语尽堪悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙子郧台偶题十绝 其九","author":"王世贞","text":"一枕腾腾梦帝乡，醒来依旧在郧阳。\n它时纵许春明入，梦处无多醒处长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙子郧台偶题十绝 其十","author":"王世贞","text":"鼓吹喧阗棨戟新，出誇前队拥千人。\n无端谩取图经读，此地元来是逐臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦热","author":"王世贞","text":"六月苦热杜门复何道，科头解衣徙坐清阴边。\n为语诸君且莫河朔饮，我欲一枕上就羲皇眠。\n凛如足踏太行万古雪，恍若卧对匡庐千尺泉。\n长安道中褦襶者谁子，薰心炙手不畏天公权。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五杂俎三首 其一","author":"王世贞","text":"五杂俎，车中缨。\n往复还，辙不停。\n不获已，删六经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五杂俎三首 其二","author":"王世贞","text":"五杂俎，长信殿。\n往复还，君心变。\n不获已，咏纨扇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五杂俎三首 其三","author":"王世贞","text":"五杂俎，手中丝。\n往复还，寄所知。\n不获已，守空帏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三五七言 春汎","author":"王世贞","text":"兰为楫，桂为桨。\n春波既摇裔，春日仍骀荡。\n归到横塘市欲收，平林一抹苍烟上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三五七言 秋江辞","author":"王世贞","text":"风江秋，风叶愁。\n孤云阁远屿，一雁落汀洲。\n贪看十五焦山月，帆到金陵不肯收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"一至十言 题竹","author":"王世贞","text":"娟，娟。\n斜日，晓烟。\n歌嶰谷，泣湘川。\n楣云室雨，襟山带泉。\n虚心受泽润，素节破霜坚。\n东南奕奕称美，寒暑亭亭自鲜。\n箨坼龙鳞蜿白昼，梢排凤尾拂青天。\n似风前婥约霓裳舞，羡雪后飘飖鹤氅仙。\n王氏触目琅玕难比秀，谢家荣庭兰玉敢争妍。\n安得共此君一邱一壑里，与尔听秋声万仞青林颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"两头纤纤","author":"王世贞","text":"两头纤纤梭鸣机，半黑半白盘中棋。\n腷腷膊膊乌队栖，磊磊落落一男儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂言五首 其一 大言","author":"王世贞","text":"鸟王翼覆须弥谷，龙伯缗连巨鳌六。\n九海捐波濯吾足，兜率宫庳不堪宿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂言五首 其二 小言","author":"王世贞","text":"海沙濛濛散鲲子，标虱悬心中蓬矢。\n檀槐接壤五千里，蛮触交兵万人死。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂言五首 其三 难言","author":"王世贞","text":"愚公移山卫填溟，呼日东走岱西行。\n秦皇采药求上升，傅节比义取公卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂言五首 其四 易言","author":"王世贞","text":"江流辞峡注清湘，金沟堤旁种垂杨。\n邯郸艳姬挑冶郎，长安金多结貂珰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂言五首 其五 危语","author":"王世贞","text":"悬度山腰铁絙靡，恶风吹船入罗鬼。\n前有窫貐后伏虺，孤臣握兵内惭毁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"回文 春游","author":"王世贞","text":"绿草芳原平，青山一带晴。\n玉鞭骄试马，珠弹惹啼莺。\n曲奏低云度，杯深贮月明。\n促归传钥待，游冶遍春城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别思","author":"王世贞","text":"边塞断魂愁夜夜，枕珊无梦托君思。\n娟娟月晓留妆镜，冉冉山秋入画眉。\n弦柱雁飞钿瑰涩，剑文龙远匣星离。\n篇成织锦和珠泪，写恨春风江上枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵岩晚步","author":"王世贞","text":"阙涧遮幽树，低云薄断鸿。\n月残生白小，天远入青空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨","author":"王世贞","text":"微力展运荷恩休，绯金灿赫比王侯。\n肥马脂车走燕幽，辉光烁目溢道周。\n翚翟孤翔偕不俦，依依妾肠痛纷缪。\n飞花逐风委波流，挥泪涕咨怨深秋。\n围带宽改倏岁遒，稀星列汉垂帘钩。\n蝛啼哀蝉传梧楸，衣寒剪涩玉指柔。\n机鸣罢织乍灯收，霏霏华露湿衾帱。\n徽音恋君幸君留，非耶是耶君思愁。\n围香柔玉煖新裯，薇藿焉足充脯羞。\n饥往念饱谁悠悠，归哉勖君思昔游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春游","author":"王世贞","text":"碧濑春粼粼，芳洲遍绿蘋。\n摘花惊坐鸟，飞絮惹游人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人名 渡江口阻风书事","author":"王世贞","text":"孔涉在兹辰，风江淹旅役。\n枫抱秋郭丹，月侵衰杨白。\n大陆云苍苍，金山涛间碧。\n游鱼石濑响，倦鸟辞张翼。\n天高澄清气，湛然明空色。\n山僧来何晏，鸣钟会施食。\n籍谈彼岸趣，言偃江门石。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书怀","author":"王世贞","text":"少小负高适，中林类偃蹇。\n胡为国书徵，王接亮非腆。\n自厌丘樊迟，冀以闾阎显。\n慕蔺相如垂，栖吴武陵远。\n疾雷被群植，郑兰亦摧剪。\n冉冉耕钓年，计然嗟已晚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归怀","author":"王世贞","text":"二毛遂已侵，日暮途胡广。\n由来历落士，项领何偃仰。\n青山简容膝，一丘迟归鞅。\n既谢玄豹姿，将求仲长赏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏落日","author":"王世贞","text":"冉冉求濛汜，萧萧映桑梓。\n朱云黯犹射，空江湛转绮。\n静闻幽禽息，瞥见高蟾起。\n虚白林外偏，垂杨素氛靡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春游","author":"王世贞","text":"越罗敷，紫陌飞燕时相偶。\n好系木兰船，春江芊眠柳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戍赵归思寓姓名一章","author":"王世贞","text":"嗟予谢安枕，朅来历荒徼。\n边声横赵朔，代马腾秋草。\n九塞张武军，三关羽书少。\n疲禽息故林，赪鱼遵幽沼。\n日归荒丘迟，寒向戍楼早。\n白杨兴悲风，石虎横周道。\n千秋胡敢言，生平当自保。\n将陈乞骸章，田间以终老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晨发真定怀归有作用前体","author":"王世贞","text":"震方望欲鼌，烂然明银海。\n天高湛霜气，大陆澄霞彩。\n方欣全赵胜，更惭魏多垒。\n衰谢混俗宜，飞扬雄心改。\n伊昔蒙国书，时维帝元载。\n牧冀缺远图，家吴起深悔。\n疲马良念归，长林放麋在。\n筹边让群乂，勤王济真宰。\n挂冠亦由余，何求复何待。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"离合 其一 承乏淄青将发有怀故人寓郡望姓字","author":"王世贞","text":"唱郢同声人，昌辞忽中咽。\n昃影薄下舂，日垂虞渊辙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"离合 其二 承乏淄青将发有怀故人寓郡望姓字","author":"王世贞","text":"群苕忌孤秀，亡羊境纷列。\n郎秩今再满，良友将乖别。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"离合 其三 承乏淄青将发有怀故人寓郡望姓字","author":"王世贞","text":"金绯虽被躬，余怀日飘瞥。\n诗韵成孤赏，讨论谁为竭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"离合 其四 承乏淄青将发有怀故人寓郡望姓字","author":"王世贞","text":"天垂碣石雨，人隔燕然雪。\n竟尔驱车行，音容自兹绝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"离合 其五 承乏淄青将发有怀故人寓郡望姓字","author":"王世贞","text":"漾漾黄河流，水声驰天末。\n秋风吹高原，禾黍夕烟灭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二属 归思","author":"王世贞","text":"梁苑辞兔耕，商丘罢猪牧。\n狗马病未已，龙蛇年可卜。\n世自饶虎冠，吾宁蹈猴沐。\n昼鼠饥猎床，昏鸡倦栖木。\n牛羊下来否，相从老空谷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八音 宫怨","author":"王世贞","text":"金屋疏桐长信秋，迷离屈戍片萤流。\n石栏凝露芙蓉冷，纨扇辞飙彩凤愁。\n丝徵肉奏明月开，閒庭徙倚泪潜揩。\n竹宫祠罢拳姬进，桂棹歌停掌伎来。\n匏瓜茕茕望织女，箕斗无浆酒星苦。\n土鼓长吞弃后声，冰簧自咽愁中语。\n革故迎新如转丸，故人善愁新善欢。\n木难元是千金买，不作珊瑚一分看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五行十支 即事有感","author":"王世贞","text":"银河乙夜凉无声，此时缺月摧长庚。\n江南愁霖水渺瀰，蓟北落日金纵横。\n是处乾坤淹汉甲，何方戊巳却羌兵。\n辛壬未见玄圭锡，庚癸空劳素书忆。\n长安丙相虚问喘，丁傅门前马如织。\n君不见柏梁既火复建章，土木之使春相望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"州名 散步郊野间即事有感","author":"王世贞","text":"索处寡合并，三益不我迟。\n散步遵广隰，江干饶奇致。\n流水青宛转，垂杨绿遥裔。\n波风徐自发，翛翛微凉至。\n古墓交长衢，深楸起幽意。\n荆棘日夜生，能无雍门泪。\n兖客奏钟鼓，爰居终不豫。\n稻粱苟足谋，缨弁非所冀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸟名 闺怨","author":"王世贞","text":"羁栖雌鹄妒鸳鸯，卧壁悬鹑损鹔鹴。\n借问碧鸡天外影，还入丹凤梦中乡。\n乌头自白君自客，雁足空素妾空房。\n妾边比翼偏相恼，君处催归可自伤。\n轻鹣玉剪初分匹，啼鹃银箸暗成行。\n十二鸾钗容续股，三五莺闺枉断肠。\n颔燕峥嵘依汉日，鬓鸦萧飒欲秋霜。\n愁似三山鹏海阔，精卫丸泥正渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五平体 岁暮有感","author":"王世贞","text":"江城饶奇寒，畸生微欢悰。\n丹青辞柯条，昆虫司其宫。\n幽崖栖玄霜，枯杨号天风。\n沈沈冰房鱼，茕茕川途鸿。\n年龄时推移，乾坤吾何终。\n衰岐殊千端，茫然趋余躬。\n温篘为酡颜，嗟哉须臾红。\n宁如皈无生，群忧由来空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五仄体 晚步偶述","author":"王世贞","text":"海国岁倏晚，索处意不怿。\n饭罢一鼓腹，偶往若有得。\n积雪酿野态，古桧媚石色。\n稍稍究僻径，忽忽任短屐。\n落日堕鸟背，一抹太宇碧。\n未许大阮恸，且共赐也息。\n列烛映散帙，嗒尔更阒寂。\n曷不但饮酒，短发日可摘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"数名 感怀在青州作","author":"王世贞","text":"一壑违遂初，谬干有司试。\n二帙通闺籍，执戟聊需次。\n三守尚书郎，屏营虞吏议。\n四迁剖符竹，遂领东方骑。\n五子散中原，幽怀谁予寄。\n六奇内惭寡，儋圭焉所觊。\n七发既未工，安能令纸贵。\n八翼衡天门，畴为折其翅。\n九辨哀屈生，独洒咸阳泪。\n十载冠惠文，徘徊能无愧。\n百折冲波间，锋锷尽排坠。\n千石俄已逾，秋风发归计。\n万分竟何补，寥落身后事。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将军名 即事","author":"王世贞","text":"楼船出下濑，车骑屯新平。\n坠鸢伏波道，埋雪度辽营。\n祁连饶战马，蒲类恣长鲸。\n俯仰宇宙间，飞檄正纵横。\n空怀决胜筴，前辙有馀惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫殿名 其一 拟古","author":"王世贞","text":"昭昭阳春色，桃李吐华光。\n流年若飞雪，曷不日鼓簧。\n美人绝代姿，行步兰椒芳。\n赠我合欢歌，报以万年觞。\n物候诚骀荡，为乐殊未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫殿名 其二 拟古","author":"王世贞","text":"四候无长春，七情无长乐。\n零露及朝阳，浮彩须臾铄。\n方欣朱明晷，阊阖风间作。\n恋恋千金躯，畴施万年药。\n含德以自滋，逍遥于林薄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀李于鳞戏集李杜各一首 其一 集李","author":"王世贞","text":"双珠出海底，飞在白云端。\n海月明可掇，不为世人观。\n长鲸正崔嵬，为我扬波澜。\n一朝攀龙去，独宿天霜寒。\n掩泪出故房，清晨起长叹。\n酌醴焚神鱼，问言谁与餐。\n方希炼金骨，并乘双飞鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀李于鳞戏集李杜各一首 其二 集杜","author":"王世贞","text":"长啸宇宙间，扬马宜同时。\n前辈复谁继，名家信有之。\n博采世上名，得失寸心知。\n李侯有佳句，突过黄初诗。\n伊昔临淄亭，痛饮真吾师。\n佳人绝代歌，行酒双逶迤。\n掌中琥珀钟，照耀珊瑚枝。\n快意八九年，浩荡从此辞。\n终悲洛阳狱，朱凤日威蕤。\n千载得鲍叔，弃我忽若遗。\n饮酣视八极，岁暮有馀悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舍弟有投赠之作叙致酸楚余不能复续漫集杜句酬之凡十韵","author":"王世贞","text":"春色生烽燧，关山信月轮。\n帝乡愁绪外，梁狱上书辰。\n社稷缠妖气，生涯脱要津。\n艰难随老母，寂寞向时人。\n年事推兄忝，门庭畏客频。\n要闻除䝟貐，独泣向麒麟。\n磨灭馀篇翰，飘零且钓缗。\n百年歌自苦，一字买堪贫。\n耕凿安时论，泥涂任此身。\n今秋天地在，怀旧益沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自青州发明卿书有感","author":"王世贞","text":"有客乘舸自忠州，语不惊人死不休。\n念我能书数字至，悲君已是十年流。\n可怜怀抱向人尽，一辱泥途遂晚收。\n跨马出郊时极目，春风回首仲宣楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘲俗子","author":"王世贞","text":"乡里儿童项领成，客至从嗔不出迎。\n安得壮士掷天外，吾与汝曹俱眼明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏集唐句示子念","author":"王世贞","text":"长安城中足年少，论交岂必皆同调。\n前门长揖后门关，当面输心背面笑。\n薄俗嗟嗟难重陈，万事翻覆如浮云。\n欲向何门靸珠履，令人常忆平原君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]