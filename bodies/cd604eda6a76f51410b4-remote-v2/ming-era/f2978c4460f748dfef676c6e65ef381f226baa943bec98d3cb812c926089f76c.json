[{"title":"后明妃曲","author":"胡应麟","text":"出塞涕沾襟，遥望阴山阴。\n旧宠汉宫薄，新恩边地深。\n紫骝涉长道，黄鹄寄哀音。\n千载琵琶曲，谁明去住心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"董娇娆","author":"胡应麟","text":"素手拨箜篌，盈盈在画楼。\n玉钗翘紫燕，金盒贮红虬。\n楚台行雨过，汉殿乘风游。\n期门诸侠少，无处系骅骝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洛阳道","author":"胡应麟","text":"迢迢洛阳道，日暮正飞花。\n公子青丝榼，王孙白鼻騧。\n骑吹金张宅，歌钟赵李家。\n遥传丽人至，偷眼七香车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秦王卷衣","author":"胡应麟","text":"春色醉秦楼，秦玉夜宴游。\n銮舆回卤簿，凤管叶箜篌。\n七宝流苏帐，千金集翠裘。\n何人最承幸，卷赠龙阳侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"铜雀伎","author":"胡应麟","text":"松柏西陵路，君王不复游。\n高台铜雀暮，故苑石麟秋。\n舞将罗袖歇，歌倚穗帷愁。\n浮云渺天末，漳水共悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得盈盈楼上女","author":"胡应麟","text":"盈盈楼上女，十五正婵娟。\n照胆秦宫镜，含情蜀国弦。\n踏青回绮陌，拾翠傍晴川。\n轻薄金吾子，无劳问少年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少年行","author":"胡应麟","text":"翩翩游侠客，结束自名邦。\n过赵黄金百，游秦白璧双。\n鸣鞭中贵避，插羽右贤降。\n日暮名姬肆，飞花扑玉缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫骅骝","author":"胡应麟","text":"蹀躞天闲骑，曾从大宛来。\n悬金当骏市，喷玉过龙堆。\n伏枥心元壮，鸣鞭气不回。\n何辞万里道，逐北向轮台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关山月","author":"胡应麟","text":"绝塞生秋早，空闺入夜愁。\n光飞银阙上，影抱玉门流。\n露气漙丝管，霜华拂锦裘。\n征夫犹北戍，目断大刀头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"剑侠行","author":"胡应麟","text":"少年学剑术，飞身游泬寥。\n鹿卢云气拥，龙匣电光摇。\n醉呵鲁句践，怒骂霍嫖姚。\n夜来风雪猛，拂袖灞陵桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"骢马驱","author":"胡应麟","text":"骢马千金装，日夕过平康。\n寸心重衡岱，片诺回沧桑。\n白屋笑原季，青云轻赵张。\n明朝砍文吏，竟夜赤丸光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公子行","author":"胡应麟","text":"新开平乐第，红妆簇画楼。\n骅骝金作埒，鹦鹉玉为鞲。\n汉宫鸣佩入，梁园挟弹游。\n海棠花正发，选伎合梁州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侠少曲","author":"胡应麟","text":"鸣鞭白门道，新柳正藏鸦。\n七宝装繁弱，千金散狭斜。\n飞扬孟公坐，调笑季伦家。\n夜夜双龙气，腰间挂赤霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邯郸曲","author":"胡应麟","text":"夜宿邯郸花，朝扳灞陵柳。\n五侯竞献鲭，七贵争持酒。\n巨先胶漆契，翁伯金石友。\n纵死咸阳宫，何负将军首。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜夜曲","author":"胡应麟","text":"褥隐芙蓉丽，筵开玳瑁频。\n绣屏朝选伎，罗幌夜留宾。\n艳曲梁间度，纤腰座里陈。\n渐看银漏促，舄履杂华裀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采莲曲 其一","author":"胡应麟","text":"桂楫漾沙棠，向暮出横塘。\n罗裙娇绿水，玉腕映红妆。\n搴花怜盖弱，折藕爱丝长。\n回桡弄斜影，惊起双鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采莲曲 其二","author":"胡应麟","text":"飞身下七襄，骖驾六龙翔。\n负局行中夏，携壶出大荒。\n蓬莱千日酒，沆瀣万年浆。\n勾漏砂如石，蓝桥玉作霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"爱妾换马","author":"胡应麟","text":"行雨蛾眉去，追风骏足来。\n金羁沙苑秣，宝屧画廊苔。\n太息专房艳，长鸣伏枥材。\n何当效周穆，騄耳上瑶台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邯郸才人嫁为厮养卒妇二首 其一","author":"胡应麟","text":"乍辞鸾辂出，回望凤墀高。\n幸脱君王难，宁忘厮养劳。\n生轻惭比叶，命薄叹同蒿。\n尚异乌孙贵，穷毡配二毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邯郸才人嫁为厮养卒妇二首 其二","author":"胡应麟","text":"新恩偕伉俪，旧宠易累囚。\n饮恨辞金屋，含悽下玉楼。\n鸠巢元鹊憩，鱼服暂龙游。\n不见平阳婿，次且择卫侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巫山高","author":"胡应麟","text":"阳台出天半，高压大江湄。\n暮雨连三峡，朝云合九疑。\n猿啼青嶂急，鸟度翠屏迟。\n莫作峰头梦，魂迷十二时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芳树","author":"胡应麟","text":"年年旧桃李，烂漫帝城阴。\n结实当前殿，开花满上林。\n香飞金谷早，影坠玉池深。\n一曲山香罢，芳菲何处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蜀国弦","author":"胡应麟","text":"春风杜宇国，千载寄哀音。\n水激巫娥佩，山鸣卓女琴。\n铜梁朝日艳，玉垒暮云深。\n浣花溪上宅，词人可重寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邯郸行","author":"胡应麟","text":"狭斜连锦里，垂柳夹香堤。\n绿绮千条润，青丝万树齐。\n玉鞭骑过马，金距斗回鸡。\n朝日红妆坐，流莺拂户啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"艳曲十首 其一","author":"胡应麟","text":"青楼开大道，翠馆接平阳。\n柳拂葳蕤锁，花明玳瑁梁。\n合欢年少客，新镂郁金床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"艳曲十首 其二","author":"胡应麟","text":"画阁青门外，朱帘碧水浔。\n绣衾描比翼，罗带结同心。\n夜夜求凰意，无劳听玉琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"艳曲十首 其三","author":"胡应麟","text":"北陆歌钟起，东郊骑吹旋。\n花香长乐外，草色未央前。\n十万章台柳，玲珑拂翠钿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"艳曲十首 其四","author":"胡应麟","text":"春光平乐近，胜事曲江留。\n帝子联镳语，王孙挟弹游。\n共邀金犊至，藉草大堤头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"艳曲十首 其五","author":"胡应麟","text":"金羁连绮陌，玉佩照晴沙。\n北极元僚第，南阳贵主家。\n楼台七十二，日暮乱飞花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"艳曲十首 其六","author":"胡应麟","text":"神女云为色，妖姬雪作歌。\n三千回粉面，二八拥青蛾。\n咸阳游冶客，赵李日经过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"艳曲十首 其七","author":"胡应麟","text":"粉黛徵歌伎，腰肢斗舞人。\n绿珠金谷艳，碧玉玳筵春。\n珊瑚十万树，一一破瓜辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"艳曲十首 其八","author":"胡应麟","text":"明眸骄绮绣，皓齿粲琼瑰。\n挟瑟燕姬肆，吹箫凤女台。\n巫山何处是，指点片云来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"艳曲十首 其九","author":"胡应麟","text":"宝帐连金屋，琼筵弄玉箫。\n娇娆花作髻，静宛柳为腰。\n当歌小垂手，烂漫雪花飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"艳曲十首 其十","author":"胡应麟","text":"渌水荡涟漪，江南日暮时。\n吴姬木兰棹，越女竹枝词。\n恼杀横塘下，纷纷轻薄儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又六首 其一","author":"胡应麟","text":"金埒贮骅骝，银妆络马头。\n相逢狭斜道，并倚大长秋。\n何用知名姓，联翩入画楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又六首 其二","author":"胡应麟","text":"博山银缕细，沈水玉壶香。\n后院通韦曲，前除接建章。\n名姝三百辈，月底诵灵光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又六首 其三","author":"胡应麟","text":"玛瑙妆为砌，珊瑚聚作林。\n万钱编马埒，一脔试牛心。\n向夕香风动，连车爇水沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又六首 其四","author":"胡应麟","text":"乳燕穿朱屋，流莺啄画檐。\n雾消云母帐，风动水晶帘。\n遮莫嫦娥下，千花拂彩蟾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又六首 其五","author":"胡应麟","text":"朝朝呈翠黛，夜夜斗纤腰。\n枕上偷金合，屏前弄玉箫。\n罗衣三十院，无处觅红绡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又六首 其六","author":"胡应麟","text":"绮楼藏盼盼，罗幕贮盈盈。\n雾袂空中举，霓裳月下行。\n相看时一笑，若个不倾城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"企喻歌四首 其一","author":"胡应麟","text":"双鞬铁裲裆，谁家大健儿。\n蛇矛丈八盘，上马捷若飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"企喻歌四首 其二","author":"胡应麟","text":"腰间大羽箭，竖指百夫力。\n突如飞天鹞，万鸟戢羽翼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"企喻歌四首 其三","author":"胡应麟","text":"落日平原西，射雕控飞骑。\n九种黑山戎，各各相引避。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"企喻歌四首 其四","author":"胡应麟","text":"天生健男子，何须多结伴。\n独身取月支，降卒三十万。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钜鹿公主歌 其一","author":"胡应麟","text":"油壁香车向何许，玉勒花骢汗红雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钜鹿公主歌 其二","author":"胡应麟","text":"呵殿纵横灞陵渚，夹岸行人目相语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钜鹿公主歌 其三","author":"胡应麟","text":"新封大国钜鹿主，钜鹿为谁大家女。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕夜女儿歌四首 其一","author":"胡应麟","text":"侬家白揄树，一年一开花。\n郎如牵牛星，一年一来家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕夜女儿歌四首 其二","author":"胡应麟","text":"不恨欢意薄，但愿欢情长。\n牵牛与织女，一年一成双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕夜女儿歌四首 其三","author":"胡应麟","text":"一年但一会，一夜一年周。\n犹胜侬儿郎，十载客巴州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕夜女儿歌四首 其四","author":"胡应麟","text":"都将一年意，一夜申缱绻。\n桥畔乌鹊声，天河渐清浅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"碧玉歌二首 其一","author":"胡应麟","text":"莫嫌小家女，青春正十六。\n新嫁琅琊王，娇爱比碧玉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"碧玉歌二首 其二","author":"胡应麟","text":"恨无倾城色，不敢邀王怜。\n相欢那在貌，动体生春妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃叶歌二首 其一","author":"胡应麟","text":"可怜王家郎，不解事桃叶。\n清晨渡江去，日暮忘迎接。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃叶歌二首 其二","author":"胡应麟","text":"桃花作罗袖，桃叶为罗裙。\n何似阿兄騃，终日怜此君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"懊憹歌二首 其一","author":"胡应麟","text":"翩团黄犊车，载欢出城东。\n看看白日堕，那能不懊憹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"懊憹歌二首 其二","author":"胡应麟","text":"谁家娇女儿，三三复五五。\n结伴邀欢行，今夜大辛苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白团扇二首 其一","author":"胡应麟","text":"白团扇，含情待郎来，不使路傍见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白团扇二首 其二","author":"胡应麟","text":"白团扇，懊恨负情侬，手持不令见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华山畿","author":"胡应麟","text":"华山畿，不愿生同栖，但愿死同止。\n上有双比翼，下有双连理。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安东平 其一","author":"胡应麟","text":"严冬凛烈，北风雨霜。\n河大水冰，断绝车航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安东平 其二","author":"胡应麟","text":"客子远游，夐夐秦越。\n囊无赀粮，带断裘结。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安东平 其三","author":"胡应麟","text":"我有绨袍，以遗故人。\n物薄意厚，贵称君身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安东平 其四","author":"胡应麟","text":"微物在机，是侬手织。\n千缕一丈，三丈一袭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安东平 其五","author":"胡应麟","text":"东平刘生，远持遗郎。\n愿得邀郎，早还故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15497,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"女儿子 其一","author":"胡应麟","text":"木兰歌声起两岸，江陵一夜肠欲断。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15498,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"女儿子 其二","author":"胡应麟","text":"估客年年下黄牛，巫山十二猿鸣愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15499,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜四时歌 其一 春","author":"胡应麟","text":"大堤三月中，垂杨千万树。\n郎骑白马来，堤上遥相遇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15500,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜四时歌 其二 夏","author":"胡应麟","text":"期欢大堤口，迟我采莲回。\n向暮南风急，兰桡不敢开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15501,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜四时歌 其三 秋","author":"胡应麟","text":"人言秋日短，侬爱秋月光。\n邀郎解衣坐，肌肤如雪霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15502,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜四时歌 其四 冬","author":"胡应麟","text":"围炉然兽炭，为郎理瑶瑟。\n不知重檐外，雪花厚三尺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15503,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子夜变歌","author":"胡应麟","text":"期欢半夜来，忽复月光晓。\n九月芙蓉花，颜色讵长好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15504,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青骢白马","author":"胡应麟","text":"青骢白马娇成群，往来蹀躞如浮云。\n系马高楼石城下，三百青铜莫论价。\n七香炯炯并马行，卢家少妇车相迎。\n郁金堂前双紫燕，白马青骢暮相见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15505,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿阳乐","author":"胡应麟","text":"妆楼百馀尺，寿阳开，白马从东来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15506,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石城乐四首 其一","author":"胡应麟","text":"欢居石城西，侬住石城东。\n何愁不相见，一夜秦淮风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15507,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石城乐四首 其二","author":"胡应麟","text":"秦淮便风起，布帆疾如矢。\n恨杀巴陵秋，洞庭八百里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15508,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石城乐四首 其三","author":"胡应麟","text":"洞庭八百里，一夜南风回。\n送郎到长干，泊舟凤凰台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15509,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石城乐四首 其四","author":"胡应麟","text":"携手登高台，台荒半野草。\n殷勤传语郎，莫忘石城好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15510,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]