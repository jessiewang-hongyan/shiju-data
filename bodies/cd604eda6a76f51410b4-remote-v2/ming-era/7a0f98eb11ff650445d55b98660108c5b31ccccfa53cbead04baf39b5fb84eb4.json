[{"title":"怀洮州李公子瓛","author":"罗亨信","text":"公子风流玉雪姿，别来怜我倍相思。\n云连远树关山隔，月映虚堂梦寐驰。\n学武已闻閒骑射，修文犹喜业诗书。\n他年继述安边峤，会有芳名圣主知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和南宁李太守韵","author":"罗亨信","text":"每怀青琐论交谊，握手都门问起居。\n五裤稔闻歌德政，三馀犹喜业诗书。\n选钱慰叟驰芳誉，悬榻思贤发咏吁。\n麾节便看归建武，朱轓人识郡侯车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈太守所赠韵自遣","author":"罗亨信","text":"昔年为学莫参回，肯羡渊明归去来。\n金榜题名联二甲，黄门忝职近三台。\n经纶济世诚何补，献纳涂归愧不才。\n越自谪居江海远，几回飞梦上金台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈都堂所赠韵","author":"罗亨信","text":"老去迂疏愧著冠，末衔犹自厕台端。\n出巡喜际三边静，抚谕频看众庶欢。\n远塞云连山色暝，严城月落角声寒。\n同寅义重相思切，翘首东南臂欲翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和李祭酒赠行诗韵","author":"罗亨信","text":"塞北旬宣岁屡迁，才疏政拙愧同年。\n省耕每向春风里，问俗常于夜月前。\n白发盈颠秋渐短，丹心报国老弥坚。\n桥门咫尺云霄隔，听教无由讲席连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和李祭酒所赠韵","author":"罗亨信","text":"奉使频年寓北陲，深惭食粟与朝衣。\n既疏长策安边鄙，岂有雄才布德威。\n纳款屡看殊域至，献琛更喜远人归。\n回朝得遂同年乐，信觉斯文倍有辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和李祭酒韵","author":"罗亨信","text":"几年载笔侍明光，盛有才名播四方。\n超擢荣看登璧水，归田未许老柴桑。\n诸生侍讲闻霏玉，六馆循规戒履霜。\n造就英才为世用，人思德教永难忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和袁指挥所赠韵","author":"罗亨信","text":"祖父安边世业雄，丹心耿耿贯长虹。\n霜蹄暂蹶宁为失，藻鉴常悬有至公。\n鲤化好随三月浪，鹏抟应趁九霄风。\n知君素蕴孙吴略，跃马期收奏捷功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和教谕王德宾所赠韵","author":"罗亨信","text":"别后相思日几回，青云空有梦魂随。\n惊心白发嗟何益，过隙光阴去莫追。\n绛帐传经当让子，金门抗疏不知谁。\n丈夫志气干牛斗，未信贫无立地锥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和教谕邵夔韵","author":"罗亨信","text":"忝职黄门记往秋，联班常得近王侯。\n涂归晚直金銮殿，入奏晨趋五凤楼。\n韶濩惯闻天上乐，葡萄曾醉御前瓯。\n自从谪向江湖远，旋学康衢击壤讴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和汉阳府司训李文辉所寄韵二首 其一","author":"罗亨信","text":"羡子风标夐出尘，书来深荷托鸿鳞。\n暮云春树情何切，明月青尊意独勤。\n讲学挑灯黉馆夜，浴沂行乐泮林春。\n别来京国劳瞻企，何日高谈许我闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和汉阳府司训李文辉所寄韵二首 其二","author":"罗亨信","text":"郡斋幽雅绝纤尘，泮沼春深跃锦鳞。\n博士传经能解惑，诸生受业自攻勤。\n西窗翠竹含孤节，东阁梅花吐早春。\n近日儒官多拔擢，伫看清誉四方闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和同年翟彦荣所赠韵二首 其一","author":"罗亨信","text":"对策无才愧贾生，多君爱我独心倾。\n金台别后劳飞梦，谷郡相逢话旧情。\n素志谩期苏赤子，丹心终日恋瑶京。\n边庭宁谧狼烟息，一统华夷仰大明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和同年翟彦荣所赠韵二首 其二","author":"罗亨信","text":"昔年簪笔侍銮坡，献纳疏慵感愧多。\n遐峤播迁怜跋涉，内台超擢沐恩波。\n乡居幸托联桑梓，宦达常怀共甲科。\n况是金兰交契重，悠悠高谊岂能磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸巳谪交阯过十八滩","author":"罗亨信","text":"几年踪迹仕途间，此日重过十八滩。\n怪石槎牙如列戟，湍流迅急似倾盘。\n神灵有感能相护，心事无私险自安。\n遥望九重犹咫尺，秋高应拟泛舟还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安南感怀","author":"罗亨信","text":"拙宦虞翻拙未休，九年恩谴滞炎州。\n日长山鸟啼官舍，地僻蛮烟绕郡楼。\n梦断禁垣虚补衮，忧深边徼欲前筹。\n莫言交广风烟接，一望南溟恨已悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛亥九月望后二日北京大雪偶成","author":"罗亨信","text":"初冬未至雪花飘，六出沾泥积后消。\n弱柳低垂银袅娜，远山高耸玉岧峣。\n书窗偏称书声雅，酒市应知酒价饶。\n丰稔预占来岁兆，自惭无作颂神尧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛酉宣府岁暮书怀","author":"罗亨信","text":"塞北驰驱又二冬，宣城除夕思忡忡。\n先茔远隔沧溟外，天阙遥瞻紫极中。\n笑饮屠苏惟我后，谩题桃句与谁同。\n六旬有六明朝是，拟解朝簪学老农。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会宴太监郭公清凉亭","author":"罗亨信","text":"别构华轩远市廛，公馀开宴集群仙。\n酒倾琥珀浮银瓮，脯擘麒麟列绮筵。\n宾主献酬情烂熳，笙歌杂遝舞蹁跹。\n太平青海无飞羽，共祝皇图亿万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"佐戎出塞","author":"罗亨信","text":"俎豆堪嗟尚未闻，疏庸缪忝佐三军。\n貔貅出塞威如虎，鼓角喧天阵若云。\n司马持权明赏罚，总戎刻志净妖氛。\n会看残□成擒尽，奏凯归朝候策勋。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凯还","author":"罗亨信","text":"大将提兵靖□回，凯歌声沸动春雷。\n三边喜见烽烟息，万里行看贡赋来。\n拟作铙歌齐雅乐，便裁露布献金台。\n□□自此无遗类，一统文明遍九垓。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮景写怀","author":"罗亨信","text":"年逾六十觉尪羸，泪眼迎风不敢开。\n腰下沉沉如坠石，耳中隐隐若闻雷。\n趋朝上马须扶插，奉使乘轺怯往来。\n便拟辞閒林下去，无营无虑乐悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"景泰元年七月二十日蒙恩致仕八月二十一日早于奉天门阶辞奉旨赐酒饭毕复宣至左顺门赐衣一袭俾归服用内大红纻丝圆领一织金獬豸青纻丝搭护一绿纻丝摺子一退赋诗一首以纪其荣云","author":"罗亨信","text":"四十馀年事圣君，归休此日别枫宸。\n醉来内酝葡萄艳，赐出宫袍獬豸新。\n人羡风流同广受，自惭衰朽少经纶。\n故乡剩有佳山水，应觅渔樵为结邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵送别","author":"罗亨信","text":"白发乘轺老绣衣，观风又向日边归。\n政施吴浙霜威肃，舟渡秦淮月色辉。\n太学师模当世重，中朝人物似君稀。\n于今棘寺推平反，谁谓生平志愿违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋江待渡","author":"罗亨信","text":"我昔乘轺过孟津，江皋待渡立逡巡。\n扁舟共泛登河洛，匹马西游入陇秦。\n满目江山含暮雨，数行鸿雁杳秋旻。\n归来京国看图画，犹忆当年跋涉勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江湖游览","author":"罗亨信","text":"多君壮志慕前修，早向江湖作胜游。\n废举几年居逆旅，观光此日到神州。\n闽歌越调经闻惯，楚水吴山历览周。\n归去勉修忠孝业，锦城虽好莫淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蛾眉夜月","author":"罗亨信","text":"璧月娟娟映翠华，扁舟夜泊宦情赊。\n香飘桂子来高宇，风送潮声入浅沙。\n李白墓荒仙梦远，蛾眉亭古断碑斜。\n将军何暇探陈迹，要立殊勋镇海涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观诰思亲","author":"罗亨信","text":"新颁锦诰出明光，捧读思亲意不忘。\n两世功勋昭汗简，九重褒锡焕龙章。\n谩期继述超前列，誓竭忠贞答圣皇。\n禄秩绵绵传未已，应知千载播馀芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望云思亲","author":"罗亨信","text":"双亲沦逝几星霜，行役瞻云意倍伤。\n垄树迥连湘水渺，庭帏遥隔楚天长。\n深恩罔极应难报，哀思无穷岂暂忘。\n好竭丹衷答明主，传家忠孝播馀芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丹凤鸣阳","author":"罗亨信","text":"圣德巍巍被八荒，大藩选士际时康。\n禹门共睹鱼龙化，阿阁争誇凤鸟翔。\n六象羽仪昭至治，九苞文彩协祯祥。\n虞庭礼乐皆明备，好和箫韶九奏章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独鲤朝天","author":"罗亨信","text":"游泳江湖已有年，一朝鼓鬣独朝天。\n禹门变化良非偶，霄汉飞腾信自然。\n霖雨弘施苏万物，风云庆会集群仙。\n鲸鲵自是神龙类，肯逐凡鳞困九渊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杏林春霁","author":"罗亨信","text":"三世为医积累深，活人种杏已成林。\n晴霞绚目花开遍，翠盖当窗树蔼阴。\n京国别来劳远梦，片帆归去遂初心。\n画图不尽家山趣，旧迹陈踪取次寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"双旻隐居图","author":"罗亨信","text":"双旻山下楚溪东，乔木森森翠作丛。\n石径萦纡苍藓合，茅堂隐映白云封。\n过庭诗礼传三叶，奕世衣冠近九重。\n京国披图频想像，膏车何日许相从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题旧隐图","author":"罗亨信","text":"故人家住睢阳郡，溪上茅茨迤逦开。\n当户好山金晻映，沿堤流水玉萦回。\n读书已遂飞腾志，衣绣咸推俊迈才。\n客里披图怀旧隐，功成他日赋归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题隐居图","author":"罗亨信","text":"仙居迢递傍遥岑，流水桃花径路深。\n千顷白云迷远岫，数椽茅屋映疏林。\n栖迟自得闲中趣，韬晦都忘物外心。\n久客归期殊未卜，展图惆怅不胜吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题山水","author":"罗亨信","text":"云树苍茫紫翠连，水光山色共悠然。\n丛林幽谷栖禅刹，曲岸垂杨系钓船。\n花坞鸟啼春寂寂，松庭鹤唳月娟娟。\n虎头已去龙眠老，此幅清新孰为传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题雪溪图","author":"罗亨信","text":"瑞花乱落似飞琼，极目乾坤一色明。\n瘦竹低垂银袅娜，远山高耸玉峥嵘。\n芸窗皎洁书声雅，蕙帐虚澄鹤梦清。\n恍惚剡溪溪上景，王猷孤棹岸边横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题游春图","author":"罗亨信","text":"满目春光淑景融，游人并辔出郊东。\n莺花烂熳诗怀壮，宫锦淋漓酒兴浓。\n夹道垂杨青袅袅，激湍流水绿溶溶。\n悬知日暮忘归去，醉倚危楼第几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画山水图","author":"罗亨信","text":"幽人卜筑傍江湾，门掩清风白昼闲。\n远岫含云烟树渺，落花铺地紫苔斑。\n林泉自拟终栖遁，城市何曾识往还。\n祇恐鹤书起遗逸，衣冠重整拜金銮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武馀清乐卷","author":"罗亨信","text":"阅武归来脱战袍，诗书适兴乐陶陶。\n道遵孔孟儒风盛，学究孙吴武略高。\n试爇龙涎弹绿绮，谩将虎韔橐乌号。\n安边正尔需贤将，会睹承宣沐宠褒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苍峦诗卷","author":"罗亨信","text":"幕宾旧隐傍遥岑，乔木千章翠作林。\n祖祢昔闻培厚泽，衣冠今喜映华簪。\n奉丧尽礼宁亲魄，待选趋朝听玉音。\n盛世功名期显达，蹉跎莫遣二毛侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水云卷","author":"罗亨信","text":"羽客翛然物外心，名山胜境恣幽寻。\n何年跨鹤来溟海，此日囊琴别盍簪。\n千里水云闲笑傲，半生落魄任浮沉。\n还丹九转功成日，飞渡蓬瀛看浅深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贞节卷","author":"罗亨信","text":"戎行薄俗岂堪论，节义孤高在德门。\n奉养孀姑登上寿，教成稚子见曾孙。\n嫠居独守心良苦，素志坚持行自敦。\n直指回朝宣奏牍，褒旌应见沐深恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题萧世英千户行卷","author":"罗亨信","text":"将军先业在筠阳，乔木森森映画堂。\n三世功勋昭汗简，一门忠孝播馀芳。\n暌违谩叹关山隔，游宦空惊岁月长。\n致政安居归故里，香山九老共徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题绥阳八景","author":"罗亨信","text":"金紫嵯峨势插霄，鹧鸪苍翠更岧峣。\n凤林寿岭春光媚，古洞龙门景物饶。\n竹下清泉常汩汩，杏梢晴霭自飘飘。\n仙翁归隐多幽兴，足迹何曾到市朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题高彦敬画","author":"罗亨信","text":"尚书旧写隐居图，半幅溪藤意有馀。\n千顷白云山掩映，满林苍蔼树模糊。\n鸟啼幽谷春声早，鹤唳空庭月色孤。\n倦客怀归殊未得，临风把玩谩踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画梅","author":"罗亨信","text":"宇宙凝寒百卉凋，罗浮仙子挺孤标。\n蜂腰鹤膝精神古，玉质冰肌体态娆。\n为爱幽贞同雅操，谩传清影入生绡。\n华堂吟对成高兴，踏雪何须过野桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自题小影","author":"罗亨信","text":"霜鬓萧萧七帙馀，豸冠绣服竟何如。\n忝为宪职粗知律，空负儒名少读书。\n修竹寒梅娱晚节，清风明月称幽居。\n等閒有问襟怀事，湛湛灵台点翳无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"联奎坊","author":"罗亨信","text":"名门积庆信无违，父子联科世所稀。\n月桂两攀诚卓异，奎星重映倍光辉。\n皋皮接武乘骢马，儒服传家著绣衣。\n文献百年推阀阅，门前华表自巍巍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题周氏族谱","author":"罗亨信","text":"故家文献岂徒然，积德由来几百年。\n闽郡析居嗟远别，琼台游宦属南迁。\n衣冠济济光前哲，诗礼彬彬蔼后贤。\n谱牒修明敦本始，曾孙什袭永相传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁安卧雪","author":"罗亨信","text":"积雪盈阶已丈馀，先生高卧自安舒。\n梅花纸帐宜清梦，曲巷疏篱称隐居。\n县令远临劳骑从，孝廉芳誉重璠玙。\n一朝应诏幡然起，赫赫功名太史书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西伯访渭","author":"罗亨信","text":"渭川终日坐垂纶，乐道安贫老此身。\n喜见熊罴占吉兆，特劳车驾到江滨。\n归周已觉年将迈，佐业宁知志独勤。\n千载画图留伟迹，令人歌咏想精神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杜甫游春","author":"罗亨信","text":"春到皇都淑气回，杜陵仙客好怀开。\n郊原景物多佳致，湖海诗声属俊才。\n满目风云情淡荡，游人歌舞重徘徊。\n太平处处皆行乐，雨露深恩被草莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渊明赏菊","author":"罗亨信","text":"渊明归去隐浔阳，篱菊秋深尽吐芳。\n璀璨金英凝晓露，娉婷玉质傲秋霜。\n壶觞自引酬佳节，僮仆欢迎入画堂。\n醉倚南窗多逸兴，高风千古托羲皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"濂溪观莲","author":"罗亨信","text":"手植芙蓉尽放花，倚阑赏玩谩咨嗟。\n亭亭翠盖擎仙掌，灼灼红妆绚彩霞。\n十里薰风来几席，一帘香雾透窗纱。\n淤泥杂处应难染，外直中通信可誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林逋观梅","author":"罗亨信","text":"逋仙性癖嗜梅花，六出开时兴倍赊。\n入座暗香清馥郁，当窗寒影瘦槎牙。\n晓吟自觉诗怀壮，夜饮应知酒量加。\n结实待看调鼎鼐，莫嫌孤淡负韶华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灞桥诗思","author":"罗亨信","text":"同云密布雪花飘，策杖殷勤过灞桥。\n得句也知肩屡耸，成章应觉兴偏饶。\n不才自信明君弃，多病宁烦故友招。\n太守亭中留伟貌，至今名誉尚遥遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"罗浮山房","author":"罗亨信","text":"故人家住罗浮下，山色崔嵬倚大空。\n云敛翠屏开玳瑁，日华金瓣削芙蓉。\n读书已信成名早，游宦频添别兴浓。\n几度披图增感慨，扁舟何日放归篷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰溪渔隐","author":"罗亨信","text":"故人结屋兰溪上，紫玉曾裁作钓竿。\n一曲沧浪清兴古，半蓑烟雨白鸥闲。\n从龙早岁为霖去，访旧何时衣锦还。\n几度凭高频拄笏，宦情乡思满江关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蟾溪水阁","author":"罗亨信","text":"巍巍杰阁俯溪湾，几度登临豁笑颜。\n云影水光相上下，海鸥沙鹭共回还。\n宾兴已遂飞腾志，归省宁辞跋涉难。\n盛世功名期卓立，蹉跎莫遣鬓毛斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹云书房","author":"罗亨信","text":"雪压筼筜昼未乾，书斋冻合四漫漫。\n芸窗晃耀牙签润，蕙帐虚澄缟袂寒。\n声杂伊吾闻淅沥，影随杖屦共幽閒。\n高人素有经纶志，会接夔龙玉笋班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹川书舍","author":"罗亨信","text":"幽人结屋傍江干，种得疏篁半亩宽。\n翠干拂云时弄影，沧浪浸月夜生寒。\n香云辟蠹书千帙，春笋充庖食一箪。\n苦节清修期卫武，成名应拟拜金銮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓬莱清隐","author":"罗亨信","text":"玄都南畔构幽居，隔断红尘俗辙疏。\n瑶草生香秋榻暝，银蝉流影夜窗虚。\n延龄早得还丹诀，味道恒观太古书。\n我亦生平慕閒雅，几时相访命巾车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]