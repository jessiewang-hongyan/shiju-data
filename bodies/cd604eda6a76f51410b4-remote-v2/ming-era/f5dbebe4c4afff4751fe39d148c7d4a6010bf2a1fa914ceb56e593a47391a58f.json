[{"title":"题弋阳吴茂宰双白轩","author":"吴与弼","text":"物则民彝本粲然，奈何多蔽损其天。\n谁怜双白同吾意，遥赋新章更勉旃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10643,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋玩月次旧韵","author":"吴与弼","text":"戊子中秋月又圆，小陂新雨净风烟。\n襟期美恶元由我，身世浮沉一听天。\n细数流光怀旅次，独醒残梦立檐前。\n达生知命应须服，慎勿憧憧役莫年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10644,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿斯和岭徐氏","author":"吴与弼","text":"青山投宿问斯和，安乐真同邵氏窝。\n幸记松楸邻贵里，云仍奕叶假经过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10645,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉柬彭泽族里","author":"吴与弼","text":"小春新霁快行装，力病由来拜响塘。\n寄语华宗贤后裔，先茔宜护不宜伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10646,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿种湖","author":"吴与弼","text":"笋舆遥自响塘归，故里欢迎逐夕晖。\n青灯绿酒绵绵话，总念桑榆见面稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10647,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿罗原冈","author":"吴与弼","text":"彭泽迢迢宿种湖，罗原冈上又停车。\n夜分独散青霄步，一点灵台合太虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10648,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"偶成","author":"吴与弼","text":"年将八十待何为，贤有良谟圣有规。\n逐日孜孜无别想，幸时相赏莫相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10649,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事","author":"吴与弼","text":"满圃芳菲积雨摧，东阳新霁病怀开。\n儿扶杖策閒游处，尚有残红待我来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10650,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"璿庆生辰","author":"吴与弼","text":"良辰大壮绮筵开，细酌诸生介寿杯。\n珍重相观而善处，麟经羲画养灵台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10651,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄严陵张太守","author":"吴与弼","text":"金台高谊连三月，严濑离情又六年。\n驻马江干何日遂，暮云春树梦相牵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10652,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自得亭 其一","author":"吴与弼","text":"晓立鸡声月，昼坐绿阴风。\n两行名教旨，千古此心同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10653,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自得亭 其二","author":"吴与弼","text":"一尘不动处，万籁无声时。\n高卧清风里，微吟自得诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10654,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"不寐","author":"吴与弼","text":"老去逾怜学圣难，日新程课敢容悭。\n细思夙昔无眠处，凉月纷纷五夜阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10655,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽豫章胡昭","author":"吴与弼","text":"璧水才华夙分深，九莲高谊古人心。\n衡茅新约成春梦，何处凄凉问断金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10656,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东轩即事","author":"吴与弼","text":"东轩高卧处，竹影乱虚檐。\n借问轩中事，新功细学谦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10657,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"八月十四夜玩月","author":"吴与弼","text":"满林凉月映更初，高枕虚窗玩易馀。\n老去倦为湖海客，年深幸托竹松居。\n知几渐觉工夫密，安分宁论活计疏。\n企仰圣谟频浩叹，襟期何日得纯如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10658,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽饶州吴别驾","author":"吴与弼","text":"男儿何者是豪雄，德义存心任转蓬。\n虽死犹生双白志，廉顽立懦仰英风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10659,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次前己丑暮秋拙吟以策馀齿","author":"吴与弼","text":"旧迹沉吟久，新功感慨多。\n形容空老去，抱负竟如何。\n颜孟虽相远，路岐宁敢他。\n先民有成宪，程课日渐磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10660,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日次杜韵","author":"吴与弼","text":"当年谢病辞金阙，此日高登在凤台。\n嘉礼特蒙天使盛，客怀时向故人开。\n浮沉转盼成今古，寒暑惊心几往来。\n万事蹉跎空白发，馀龄程课为谁催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10661,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀阎巡检","author":"吴与弼","text":"戊寅此日接吴航，历叙羲轩重大方。\n伴宿跪辞劳梦想，尺书何日达南阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10662,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"隆孙初度","author":"吴与弼","text":"前日慇勤话梦兰，兹晨喜气蔼门阑。\n鹏程万里男儿事，夙夜孜孜学孔颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10663,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽叶侍郎盛二首 其一","author":"章懋","text":"华国文章老更奇，康时才业未全施。\n空馀欧范平生志，不见功名上鼎彝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10664,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽叶侍郎盛二首 其二","author":"章懋","text":"金镜朝端方委重，玉楼天上更传宣。\n迂生不识平津阁，因诵遗文亦泫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10665,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜坐得句寄示弟侄","author":"章懋","text":"秋初一别又冬残，欲写家书意万端。\n最是白头千里外，时时梦到兆嘉山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10666,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵题萍实桥二首 其一","author":"章懋","text":"汝坟江汉古名邦，曾见周南化日长。\n麟趾驺虞浑忘却，谩誇萍实瑞昭王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10667,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵题萍实桥二首 其二","author":"章懋","text":"桥名萍实表南邦，谣语流传岁月长。\n书社不封千载恨，空将伯业望君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10668,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游牛首山和沈仲律韵三首 其一","author":"章懋","text":"乘兴来山寺，清樽共解颜。\n院深春昼永，香袅午风闲。\n短屐行应遍，危栏倦亦攀。\n白云飞不定，何处是乡关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10669,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游牛首山和沈仲律韵三首 其二","author":"章懋","text":"登临长败兴，尘世几开颜。\n偿却三年债，都来半日闲。\n山泉寒可汲，石磴绝难攀。\n半榻能分我，看书昼掩关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10670,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游牛首山和沈仲律韵三首 其三","author":"章懋","text":"丘壑真吾分，簪缨是强颜。\n无才堪世用，多病爱身闲。\n猿鹤惊相迓，松萝郁可攀。\n哦诗归路晚，乘月度重关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10671,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张都宪瑄用陈公甫韵二首 其一","author":"章懋","text":"万里无诸国，旬宣仅一年。\n稻收千浍雨，榕翳几村烟。\n保障多新政，规模总昔贤。\n设施嗟未究，赤舄又言旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10672,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张都宪瑄用陈公甫韵二首 其二","author":"章懋","text":"二南风不作，道丧几千年。\n行苇荒秋雨，甘棠老暮烟。\n继周遭圣哲，分陜况才贤。\n好试经纶手，乾坤一转旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10673,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登科","author":"章懋","text":"太平天子御金銮，奎宿光芒午夜寒。\n汉代文章推董贾，唐家科第属欧韩。\n龙门浪暖成头角，雁塔风高快羽翰。\n虽是看花年尚少，莫将温饱问儒冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10674,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"琼林赐宴","author":"章懋","text":"风云千载遇重华，赐宴琼林宠渥赊。\n丹桂广寒非月窟，紫烟蓬岛是天家。\n食分绫饼堆红玉，酒出黄封泻绛霞。\n见说金明池上事，有人闻喜不簪花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10675,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早朝","author":"章懋","text":"未央钟动曙光生，隐隐初闻柳外莺。\n风静御炉香篆细，日高斧座衮衣明。\n螭头陛拥黄麾仗，豹尾班联白玉珩。\n最喜君王勤庶政，苍蝇声里问鸡鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10676,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"玉孟端画竹","author":"章懋","text":"此君一别己经年，今日披图不厌看。\n风度只疑摇翠佩，月明应想下青鸾。\n肯随群卉争春色，直伴孤松老岁寒。\n珍重凤凰池上客，尽将清节付毫端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10677,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"圃东新井","author":"章懋","text":"凿井深深傍玉堂，石根流沁一泓凉。\n冰壶夜浸秋蟾湿，云液晴涵甘醴香。\n苔藓未生侵玉甃，桐阴初长拂银床。\n寒泉可汲应须汲，莫使行人为断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10678,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日感兴","author":"章懋","text":"昨夜西风袭缊袍，壮怀落落兴飘飘。\n全才人物思韩范，杂伯功名陋管萧。\n阊阖万言陈国论，沙场百战灭天骄。\n前修未远斯文在，九辩何须赋寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10679,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨总兵征西","author":"章懋","text":"山西名将好男儿，报国丹心一剑知。\n貔虎衔枚严号令，犬羊寒胆避旌旗。\n九重雨露朝承诏，八阵风云夜出奇。\n此去西羌应坐困，功臣充国早班师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10680,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"移菊","author":"章懋","text":"白玉堂前种紫薇，菊花开落在东篱。\n为怜秋后香偏好，故向春前手自移。\n冉冉旋添承露叶，亭亭先长傲霜枝。\n乐天只爱黄昏伴，一种幽香恐未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10681,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送谢守之无为州","author":"章懋","text":"东风跃马锦溪傍，重榜而翁太守章。\n骑竹儿迎新皂盖，爱棠人说旧黄堂。\n野田雨秀双岐麦，燕寝春凝一篆香。\n难弟正紬金匮史，要看乔梓共循良。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10682,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谒文丞相祠","author":"章懋","text":"元宋兴亡迹已陈，忠臣祠宇尚如新。\n夕阳古树烟犹暝，夜雨荒阶草自春。\n慷慨六歌空洒泪，间关百战竟捐身。\n穆陵地下应相见，不负胪传第一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10683,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归雁","author":"章懋","text":"灵囿池台是旧游，西风万里思悠悠。\n阵横紫塞霜天晓，影落澄江水国秋。\n栖止更嫌芦荻浅，飞归不为稻粱谋。\n一封带得边城信，要把平羌报冕旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10684,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和郑侍郎廷纲长至有怀","author":"章懋","text":"学道年来绝爱憎，肯随时俗竞蜗蝇。\n新阳已向今宵复，老态应从此际增。\n䞉喜舒长迎化日，仍愁积姤至坚冰。\n衰迟只合居林下，重沐君恩报岂能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10685,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和郑廷纲除夕感怀","author":"章懋","text":"满城箫鼓乐无央，共说明朝是孟阳。\n却笑流年成老大，讵堪随众厕班行。\n厌闻爆竹除残岁，谩对梅花忆故乡。\n何日得偿林下愿，簿书鞅掌任渠忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10686,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送林亨大以太宰考绩 其一","author":"章懋","text":"鸾声旂淠忽匆匆，元宰书劳觐合宫。\n曾见昌言天动色，还期大义日当空。\n䞉栽桃李居门下，多贮参苓在箧中。\n老我依刘心正切，不堪回首各西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10687,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送林亨大以太宰考绩 其二","author":"章懋","text":"三十馀年别故知，重来京国话心期。\n喜看大畜亨衢日，正是清朝景运时。\n身际风云归北阙，志先霖雨活南畿。\n武丁旧学甘盘在，说命勋庸更属谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10688,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送韩司马文赴北为大司徒","author":"章懋","text":"杏园花下昔同游，南国相逢已白头。\n枢务贤劳舆望协，板曹新任主恩优。\n一分须用宽民力，九式还应为国谋。\n此别何时重执手，不堪凝睇李膺舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10689,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送马侍郎廷用考绩","author":"章懋","text":"词苑容台久擅名，东风奏绩上宸京。\n浪花滚滚催行色，烟柳丝丝系别情。\n粉署郎君思侍教，木天仙侣喜寻盟。\n好将胸次经纶策，宣室从容启圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10690,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送吴学士俨考绩","author":"章懋","text":"玉堂学士旧宫臣，器业文章更绝伦。\n衮补合陪黄阁老，锦归先慰白头亲。\n禁庭花柳关心久，客路江枫得句新。\n宣室从容应访问，豳风无逸好敷陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10691,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送大司宪张公敷华还朝考绩","author":"章懋","text":"三十年前贤部使，又来都下得相亲。\n憩棠南国民谣在，横梃中台吏喏频。\n龙衮体元新大化，豸冠述职际昌辰。\n这回司马休归洛，四海苍生望秉钧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10692,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送程参议考满","author":"章懋","text":"伊昔仇鸾栖枳日，凤毛年少最风流。\n别来四纪犹青眼，到得重逢愧白头。\n粉署久劳明殿最，银台今复著材猷。\n东风奏绩朝天去，三接行膺宠数优。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10693,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送太常李少卿赴史馆","author":"章懋","text":"圣德神功夐绝伦，纂修开局命儒臣。\n龙头望重三朝旧，麟笔书成一代新。\n待漏鸣珂金殿晓，垂帘挥翰玉堂春。\n好将斧衮酬天地，扬厉光休启后人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10694,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王司马致仕还乡","author":"章懋","text":"材猷勋烈重当朝，抗疏辞荣重莫招。\n晓日都门开祖帐，轻风江渚泛归桡。\n魏公晚节吟秋圃，裴老闲情寄午桥。\n可是太平无一事，角巾私第得逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10695,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送大理汪少卿宗器还朝","author":"章懋","text":"丹诏催归九棘班，桂花香里泛楼船。\n罚轻犯跸追先哲，望重埋轮记昔年。\n争看上书规走马，未须把酒诧登山。\n日边故旧如相问，衰病惟应卧辋川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10696,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送侄拯之梧州通判任","author":"章懋","text":"阿咸谪倅苍梧郡，骨肉相看怅别离。\n皓首稀年吾老矣，脩途六月子何之。\n须防马援遭薏苡，且学东坡啖荔枝。\n到手功名当努力，泷冈犹待树封碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10697,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谒文丞相祠","author":"章懋","text":"篝灯夜坐读书台，怀古令人不寐来。\n世远唐虞文未丧，俗经秦汉事堪哀。\n周公礼乐真王佐，管氏功名只霸才。\n千古是非昭简册，岂容踪迹共尘埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10698,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出京和庄孔易韵","author":"章懋","text":"夕阳道路风尘暗，明月孤村草树稠。\n郭隗台前无逐客，萧家林下有行舟。\n音书断绝家何在，踪迹飘零水共流。\n此地经过多少事，今年不似昔年游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10699,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"止赐酒","author":"章懋","text":"君王念儒臣，眷养良独厚。\n解带食天厨，日赐黄封酒。\n饮食贵有节，适时乃无咎。\n昨诏酒云止，曰兹炎暑候。\n岂惜曲糵费，狂药恐作疚。\n周书戒崇饮，圣诰垂不朽。\n嗟彼八达徒，沉酗良作丑。\n宁为摄生谋，不问中圣否。\n皇恩浩如天，欲报惭何有。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10700,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"本院南新辟三圃","author":"章懋","text":"圣门学为圃，人皆陋樊迟。\n借问玉堂客，筑圃将奚为。\n儒冠安淡薄，志不图甘肥。\n苦硬根可咬，酸齑味可知。\n在贵不忘俭，藿食固所宜。\n大哉君子心，所存应在兹。\n苟能充此志，堪作和羹资。\n试我盐梅功，济彼闾阎饥。\n孰云谋生计，日夕勤敷菑。\n不有公仪休，拔弃园中葵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10701,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送白沙先生陈公甫","author":"章懋","text":"洙泗迥且深，伊洛浩不息。\n建溪一以逝，末流日湮塞。\n浙水泛功利，西江浸虚寂。\n寥寥宇宙间，何人践斯域。\n陵夷二百年，儒术转乖僻。\n争先取青紫，明经竟何益。\n有美罗浮仙，遗编自探索。\n章甫非我心，铿然只鸣瑟。\n尚友千载人，充然如有得。\n礼乐古三王，删修今六籍。\n坠绪何茫茫，仰钻各致力。\n回澜障百川，屹立中流石。\n任重道路长，行行慎无斁。\n斯文谅有在，前修未应没。\n何当谢尘纷，云山随杖舄。\n共对梅花春，细扣先天易。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10702,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送春","author":"章懋","text":"黄鹂啼老绿杨树，萋萋草满王孙路。\n落红无数点苍苔，九十春光倏将暮。\n东君何事驾言回，典衣且尽花前杯。\n殷勤相送共一醉，后会又是明年来。\n别离不用伤怀抱，四时代序天之道。\n君不见功成名遂便拂衣，汉家疏傅辞荣早。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10703,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赐粽","author":"章懋","text":"细葛香罗试新暑，太平时节逢重午。\n五兵辟尽百邪消，不用钗符悬艾虎。\n九重天上宴芳辰，菖蒲香泛宫壶春。\n青青孤叶包金黍，玉盆满贮颁群臣。\n小臣何幸遭明主，承恩共醉薰风里。\n愿题官帖献新诗，纳忠窃效欧阳子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10704,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赐扇","author":"章懋","text":"祝融南来司火令，大地郁蒸如坐甑。\n蓬莱宫中夏日长，南薰有歌思解愠。\n尚方新造宫扇成，削玉裁云形制精。\n内侍传宣赐卿士，一挥顿觉炎尘清。\n鲁公诗句平生志，愿与君王除酷吏。\n安得牧守皆循良，远播仁风慰黎庶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10705,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送抚宁侯朱永北征","author":"章懋","text":"单于猎骑惊云中，羽书夜入甘泉宫。\n君王抚髀思颇牧，将军勇略千人雄。\n去年征南闻凯奏，侯印腰间大如斗。\n今年北征初受脤，剑锋拟斫楼兰首。\n铁马横行塞草春，阴山瀚海无烟尘。\n归来看取麒麟阁，汉家卫霍何其人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10706,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽张都宪敷华母姚节妇","author":"章懋","text":"良人早峨金豸冠，致身事主遭时艰。\n边人内犯烽烟起，从征一去不复还。\n伟矣闺中未亡人，固穷志节金石坚。\n孤灯寒幌矢靡他，柏舟再续三百篇。\n劬劬夙夜抚遗孤，箕裘旧业期有传。\n中丞位望光前烈，几经断织丸熊连。\n镜鸾孤飞四十年，官原宿草迷寒烟。\n归去九泉重执手，此生端不负所天。\n呜呼，夫死国兮妇死夫，忠贞两全谁与俱。\n铭章昭垂千百载，燕许大笔春秋书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":10707,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]