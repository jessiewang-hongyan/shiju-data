[{"title":"铁峰耸翠","author":"王绅","text":"安岳名山号铁峰，层峦叠嶂耸重重。\n雨过翠色排螺钿，雪后清姿见柏松。\n奇秀堪为佳阜俪，孤高独让岱山宗。\n何时能著谢公屐，来与山灵一笑逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"简袁公弼","author":"王绅","text":"休政归来席未温，关中父老总能论。\n鉴湖一曲终须赐，陶径孤松喜尚存。\n夜雨简编穷岁月，春风兰蕙长儿孙。\n闭庐僵卧家声远，坐对岷峨雪满门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁丑除夜梦母舅养素先生","author":"王绅","text":"岁华惨淡月朦胧，梦入家中千万重。\n一世死生劳想像，五更长短见形容。\n壑舟不系应长往，蕉鹿无凭莫再逢。\n回首渭阳何处是，城头寒鼓起鼕鼕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽安老先生二首 其一","author":"王绅","text":"儒林祭酒鲁灵光，白首专门杜滥觞。\n千古文章悬皎日，一生德业简贤王。\n玉楼作记神先往，丹旐书名夜正长。\n喜有及门诸弟子，肯令端木独居场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽安老先生二首 其二","author":"王绅","text":"晨星落落老儒宗，佐政亲藩道益崇。\n车马列陈稽古力，君臣遭遇赞襄功。\n讣闻当宁兴长悼，魄入佳城保令终。\n莫叹首邱归未得，二苏遗冢汝城东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜赦诗为宪台诸公赋","author":"王绅","text":"丹凤衔书下紫宸，覃恩深喜及无垠。\n肖翘共睹乾坤大，枯朽齐沾雨露均。\n文景规模真足继，成康德业已堪论。\n乌台诸相心如水，日对岷峨道气新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和吴原颐喜雪韵","author":"王绅","text":"天皇昨夜驾云车，上苑璚林总散花。\n石兽荒凉俄拥肿，茅檐垂冻互聱牙。\n欲寻东剡王公棹，难觅西湖处士家。\n赖有苏公作司业，酒钱频与不须赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和晏助教赐茵褥诗","author":"王绅","text":"文茵新赐制平宽，坐比皋比软更安。\n自是皇家崇圣教，故令洪泽及儒官。\n阳回孔席春先暖，雪积程门书□□。\n莫叹广文官独冷，当思机杼女工难。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送周大庆归省","author":"王绅","text":"三月金陵花欲燃，胡为归兴忽翩翩。\n年来鹤发久违养，春满云衢未着鞭。\n雨过匡庐千嶂净，风轻彭蠡片帆悬。\n清秋桂子飘香日，稳步蟾宫待子先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王俊用监丞","author":"王绅","text":"东海名邦应上台，纷纷人物总贤才。\n范模自足仪多士，姓字相传遍八垓。\n日丽赤城斑袂舞，云横苍岭锦衣回。\n儿童不识先生面，争道朝中使客来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘宗上舍省亲","author":"王绅","text":"轻暖轻寒三月春，莺啼花发总精神。\n独怜太学青年客，能念高堂白发亲。\n钟阜山前扬去旆，严陵滩上识归津。\n此行取道桐君里，不老仙方问异人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王佥事复任之成都","author":"王绅","text":"日近瑶天雪乍融，御沟冰解水溶溶。\n豸冠久著风霜肃，乌府重承雨露浓。\n舟上瞿塘看滟滪，春生锦里种芙蓉。\n蜀中童白谙名姓，竹马相迎喜再逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和无为张真人见寄韵 其一","author":"王绅","text":"当年蹑屩上清中，指点虚无问道宗。\n几共五更听夜雨，长怀一月坐春风。\n身游璧水功名薄，目断耆山誉望隆。\n千里椷诗劳问讯，词源决峡势何穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和无为张真人见寄韵 其二","author":"王绅","text":"学道多年觉有情，几思发轫继周程。\n一经蚤授惭韦相，三策将陈愧董生。\n暑雨论心龙虎地，春风握手凤凰城。\n何当解绶东归去，再向玄都问旧盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈信归省","author":"王绅","text":"三年游学寓金陵，夜雨青灯万里情。\n云起岷峨亲在望，雪消巴蜀水初生。\n鸟啼花落俱成恨，水远山长莫计程。\n乐育君恩深似海，促装母待断机声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再和张真人见寄韵二首 其一","author":"王绅","text":"坐看日月走壶中，久识虚无是本宗。\n瑶草香生璚署雨，岩花影动石坛风。\n衣冠奕世名何远，印剑传家誉自隆。\n长忆耆山旧游日，仙岩高处兴无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再和张真人见寄韵二首 其二","author":"王绅","text":"世故悠悠不动情，致身偶尔入云程。\n谈玄每遇青牛客，进谏徒怀白马生。\n鸣佩趋朝钟阜月，登台吊古石头城。\n自知家学惭司马，空负山中岁晏盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题徐子明雅淡轩","author":"王绅","text":"萧然一室仅环堵，柏子销时日过午。\n古琴抚罢风满帘，深杯邀得月当户。\n往来问卜无白丁，过从谈论皆鸿生。\n俗态已忘世虑息，雅淡中含太古情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题吴文质嵩阳云树","author":"王绅","text":"延平自昔佳山水，闻说嵩阳景更奇。\n溪树藏烟阴欲雨，岭云出岫霁无时。\n辋川寂寞今谁在，盘谷幽深隐者宜。\n一自承恩居帝里，披图犹起考磐思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题墨竹","author":"王绅","text":"湘江春暮雨霏霏，舟泊黄陵酒力微。\n夜半开篷群玉响，天风吹下凤凰飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送稌东归并示穆穰稔辈六首 其一","author":"王绅","text":"象鼻原头万本松，清阴周匝护新封。\n也知世泽应钟此，近岁多承雨露浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送稌东归并示穆穰稔辈六首 其二","author":"王绅","text":"青岩山下石溪头，草屋柴门事事幽。\n但奉欢娱养慈母，荣名势利不须求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送稌东归并示穆穰稔辈六首 其三","author":"王绅","text":"百亩山田绕敝庐，近年丰歉竟何如。\n诸郎若肯勤耕种，甘旨时供定有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送稌东归并示穆穰稔辈六首 其四","author":"王绅","text":"夜读诗书朝出耕，古人多此寄深情。\n殷勤语汝诸兄弟，好尽彝伦学董生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送稌东归并示穆穰稔辈六首 其五","author":"王绅","text":"五年滇蜀倦奔驰，两鬓萧萧齿亦稀。\n宦业未成人渐老，始知三十九年非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送稌东归并示穆穰稔辈六首 其六","author":"王绅","text":"湖海淹留岁月深，萧条苦乏满籯金。\n传家幸有遗经在，迟汝重来共寸阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题墨竹","author":"王绅","text":"潇湘江上暮云迷，落日无人翠羽低。\n舣棹黄陵庙前宿，一篷春雨鹧鸪啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题小画三首 其一","author":"王绅","text":"青萝山下松涛室，几度临风忆旧游。\n今日画图看髣髴，淡云疏木不胜秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题小画三首 其二","author":"王绅","text":"古树森沈俯碧湾，江花拥雪正漫漫。\n海门潮落舟归晚，铁笛几声人倚阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题小画三首 其三","author":"王绅","text":"三月桃花浪蹴红，系船晒网夕阳中。\n卖鱼买得浔阳酒，岩树生阴坐晚风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龚给事家索菊","author":"王绅","text":"长安门外禁垣西，公馆幽深带小蹊。\n满圃黄花谁占得，清香曾许我分携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题野航徐氏双竹图","author":"王绅","text":"翛然谷口碧琅玕，影落澄波夜正寒。\n独倚野航人寂寂，月华浮水度双鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送汉阳安知州之任","author":"王绅","text":"太平不钓渭溪璜，白首之官上汉阳。\n鹦鹉洲中旧风月，从今收拾到黄堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题思萱堂","author":"王绅","text":"手种萱花近北堂，慈亲相对百忧忘。\n年来太学游歌久，一向春晖一断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画梅","author":"王绅","text":"忆昔黄昏访老逋，小舟乘月渡西湖。\n暗香浮动人声寂，皓鹤飞来只影孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题墨竹三首 其一","author":"王绅","text":"潇湘江上暮春时，舟泊黄陵思欲迷。\n夜半忽惊风雨作，潇潇两岸鹧鸪啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题墨竹三首 其二","author":"王绅","text":"子猷宅畔寻常见，蒋诩门前次第栽。\n山馆日斜无俗客，清阴忽过短墙来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题墨竹三首 其三","author":"王绅","text":"嘅我居官岁月多，每于紫陌听鸣珂。\n天风忽起王猷宅，彷佛朝回阙下过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄章同吉三绝句兼柬范叔彝 其一","author":"王绅","text":"怀人万里思悠悠，清梦寻常到益州。\n昨夜冥鸿将信至，开椷字字解予愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄章同吉三绝句兼柬范叔彝 其二","author":"王绅","text":"五更踏月候朝钟，退食词垣旭日红。\n金匮玉函披阅遍，从容无复旧时风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄章同吉三绝句兼柬范叔彝 其三","author":"王绅","text":"范郎辞翰尽堪誇，五色卿云簉彩霞。\n不寄冷官王仲子，封题偏到绣衣家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题李白小像","author":"王绅","text":"一自骑鲸去不回，风流千古数雄才。\n至今采石江头月，犹共长庚烛九垓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄叔雍舍侄三首 其一","author":"王绅","text":"百亩良田不间畦，息耕亭畔曲江湄。\n五年不踏江头路，明月清风午夜思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄叔雍舍侄三首 其二","author":"王绅","text":"长忆青岩旧草堂，手栽松竹翠成行。\n诸儿未了公私事，三径年来想就荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄叔雍舍侄三首 其三","author":"王绅","text":"满城风雨五更寒，灯火趍朝夜未阑。\n年少曾誇华冕贵，老来方觉布衣安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题夹梅竹","author":"王绅","text":"月白风清夜未央，小窗人静漏偏长。\n翩翩翠鸟来何处，只影飞随白凤凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题雪棹图","author":"王绅","text":"万顷顽云拨不开，山河大地总皑皑。\n怀人夜出山阴远，兴尽何妨半路回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"敬进宁王殿下仙人好楼居三章 其一","author":"胡奎","text":"仙人好楼居，乃在青云中。\n金窗洞然开，咫尺与天通。\n上有太古音，被以龙门桐。\n左招广成子，右揖浮丘公。\n凭虚览八极，呼吸凌洪濛。\n寿与天地并，逍遥乐无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"敬进宁王殿下仙人好楼居三章 其二","author":"胡奎","text":"仙人好楼居，乃在蔚蓝天。\n东西九万里，日月相周旋。\n上有飞霞佩，五凤何翩翩。\n左招王子晋，右揖洪崖仙。\n含和鍊金魄，至真洞玄玄。\n无为以清净，寄傲羲皇前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"敬进宁王殿下仙人好楼居三章 其三","author":"胡奎","text":"仙人好楼居，下瞰凌虚台。\n鸡鸣海色动，万里云霞开。\n上有白玉虬，骑之上蓬莱。\n左招梁园客，右引邹与枚。\n吹笙弄明月，八鸾以裴回。\n俯视一泓水，终古无纤埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步虚词九首 其一","author":"胡奎","text":"五气合大梵，三花凝素云。\n冲妙混真朴，玄化荡无垠。\n灵飙遵绛节，稽首虚皇君。\n啸歌琼台上，飘飖鸾鹤群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步虚词九首 其二","author":"胡奎","text":"寥寥蔚蓝天，曜灵开龙阳。\n黄老维我神，玄精贯中央。\n氤氲九天气，晃郎七星芒。\n游燕玉京府，逍遥紫极房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步虚词九首 其三","author":"胡奎","text":"九气合大梵，鸿濛启神霄。\n上披三素云，灵宫郁岧峣。\n群真翊羽盖，绛节凌回飙。\n粲粲霏玉葩，琅琅歌洞谣。\n凝神息万虑，遐龄比松乔。\n稽首无为化，永言赞昌朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步虚词九首 其四","author":"胡奎","text":"玉虚运玄化，曜灵升大罗。\n三景开天根，碧落浮空歌。\n仰瞻弥罗馆，紫云覆峨峨。\n缥缈金芙蓉，御以麒麟车。\n九光分异采，万汇含冲和。\n皈命希夷门，超然凌太霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步虚词九首 其五","author":"胡奎","text":"皇朝阐真教，慧风覃八埏。\n琅函启灵篆，玉文简玄玄。\n授以丹霞衣，回翔玉清天。\n三精飞爽灵，五色凝非烟。\n黄老维我神，专气长绵绵。\n逍遥无极君，归真合自然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步虚词九首 其六","author":"胡奎","text":"浩劫开隆运，鸿灵秉化机。\n云章结丹篆，空洞启玄微。\n九凤翼羽盖，八龙卫金扉。\n授以赤玉文，丹霞为之衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步虚词九首 其七","author":"胡奎","text":"迢迢白玉京，上通蔚蓝天。\n煌煌黍米珠，五色浮空悬。\n包括无极际，虚明洞玄玄。\n可望不可即，恍惚象帝先。\n得此以为宝，逍遥以长年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步虚词九首 其八","author":"胡奎","text":"万化同逆旅，百年等浮沤。\n何不学神仙，汗漫与天游。\n餐以旸谷霞，濯以星汉流。\n左手招安期，右手揖浮丘。\n傲睨八纮内，逍遥以忘忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步虚词九首 其九","author":"胡奎","text":"东窗绿玉树，锐叶何离离。\n春秋八千岁，蟪蛄安得知。\n至人有玄术，灵泉漱华池。\n专气有真一，超然入无为。\n会当保贞素，黄发以为期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登九天阁制步虚词 其一","author":"胡奎","text":"龙汉还荡荡，琼宫郁峨峨。\n九气结灵篆，千月印明河。\n穆穆渝妙容，飘飘登大罗。\n仙人绿云中，缥缈回空歌。\n逍遥永无极，旸谷驻羲和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登九天阁制步虚词 其二","author":"胡奎","text":"玉虚启真境，宝阁凌丹穹。\n曜灵洞八窗，空响振回风。\n绛节飘飖下，玄房曲密通。\n中有古仙人，黄公与赤松。\n飞霞为之佩，下上随云龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日登九天阁三首 其一","author":"胡奎","text":"曜灵启旸谷，丹霞丽玄穹。\n晨朝回绛节，群真集珠宫。\n登高览八极，逸兴凌空濛。\n中有古仙人，云是商山翁。\n浩歌紫芝曲，此意无终穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日登九天阁三首 其二","author":"胡奎","text":"九日良燕会，登高畅余怀。\n凭虚发清啸，浩荡天风来。\n金茎逼华盖，六符明泰阶。\n排云叫阊阖，灵扉洞然开。\n安得金衣鹄，乘之上蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日登九天阁三首 其三","author":"胡奎","text":"朝披碧瑶簪，夕登紫极房。\n绮云纷郁郁，龙汉郁苍苍。\n游神九霄外，恍忽觐虚皇。\n相从赤松子，乃有韩张良。\n安知千载后，跨鹤重来翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登玉虚阁赋游仙词二首 其一","author":"胡奎","text":"五山出东海，巨鳌十五头。\n帝遣戴山足，勿使西南流。\n至今云霞间，上有白玉楼。\n琪树丽阳冈，瑶花被玄洲。\n麻姑有书信，方平或未游。\n寻真谅不远，怅望凌高秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登玉虚阁赋游仙词二首 其二","author":"胡奎","text":"琳宫倚虚碧，瑶海含清辉。\n翩翩花鸟使，日暮云中归。\n弱水隔玄圃，三山横翠微。\n明月为我佩，丹霞为我衣。\n天颜觐咫尺，晃朗朝金扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙词","author":"胡奎","text":"东海有麻姑，乃在三山岑。\n去时海水浅，来时海水深。\n翩翩三青鸟，结巢琪树林。\n寄我锦字书，泠然空外音。\n何由启玉齿，临风披素襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"所思四首 其一","author":"胡奎","text":"郁郁我所思，所思在瀛洲。\n黄金以为阙，白玉以为楼。\n枯桑漂白日，弱水不容舟。\n亭亭三珠树，别来已千秋。\n仙人招我来，采药游丹丘。\n饷我千岁桃，赠我五云裘。\n长鲸鼓巨浪，欲往无安流。\n因风寄寥廓，东望空悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":55569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]