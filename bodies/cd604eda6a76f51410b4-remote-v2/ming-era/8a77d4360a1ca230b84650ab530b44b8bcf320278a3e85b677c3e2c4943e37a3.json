[{"title":"十二声诗 其六 棋声","author":"成鹫","text":"竹楼新雨过，馀响杂楸枰。\n静到无言处，悠然感物情。\n子疏机转密，手重敌还轻。\n历历虚窗入，须臾几战争。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十二声诗 其七 梵声","author":"成鹫","text":"此声满天下，止有一人能。\n万籁寂还寂，孤峰层又层。\n无情堪说法，离句即传灯。\n流布人间遍，浮生听未曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十二声诗 其八 榜声","author":"成鹫","text":"风便扬帆去，潮生荡桨回。\n此时欹枕听，何处榜歌来。\n击楫情偏远，叩舷声转催。\n归心似流水，三老莫徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十二声诗 其九 柝声","author":"成鹫","text":"戍楼频击柝，中夜旅魂惊。\n梦鹤回千里，晨鸡破五更。\n明明围伏枕，一一绕愁城。\n回首孤峰宿，何曾得此声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十二声诗 其十 舂声","author":"成鹫","text":"饥来心计诎，静极耳尘空。\n何处频相杵，邻家事宿舂。\n腰间留片石，庑下寄高踪。\n寂寂千秋后，闻声怀此公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十二声诗 其十一 杼声","author":"成鹫","text":"促织吟东壁，清音入耳微。\n家家喧杼轴，札札出蓬扉。\n积缕知成疋，停梭想授衣。\n闻声还报语，风雪正霏霏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十二声诗 其十二 蛙声","author":"成鹫","text":"鼓吹近清晨，招呼洽比邻。\n殷雷初发蛰，眢井亦知春。\n世网难容物，心声疑动人。\n泥涂堪溷迹，缄结莫逡巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中杂咏六首 其一 煮雪","author":"成鹫","text":"钻取槐檀木，烹将云母芽。\n凝冰与焦火，相待过年华。\n茗椀吹阳律，银山翻浪花。\n却怜苏属国，持节未还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中杂咏六首 其二 凿雪","author":"成鹫","text":"山径积复积，洞门开未开。\n持将鈯斧子，剖出蕊珠胎。\n寒月光转阔，冷风吹又来。\n凌阴方可纳，宁待玉山颓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中杂咏六首 其三 埽雪","author":"成鹫","text":"寒斋朝拥彗，触破玉壶冰。\n借问侯门客，生涯见未曾。\n埽除非草草，堆叠自层层。\n挥手下阶去，纵横兴可乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中杂咏六首 其四 踏雪","author":"成鹫","text":"疲马暮失足，芒鞋朝请缨。\n冻云光匝地，衰草白无情。\n鹤步随吟迹，牛涔引杖声。\n悠悠灞陵道，今古几人行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中杂咏六首 其五 拥雪","author":"成鹫","text":"我有辟寒玉，青州布一围。\n何曾羡狐貉，差胜掩牛衣。\n曝背癯形露，充绵瘦骨肥。\n蒙头过残腊，忘却六花飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中杂咏六首 其六 积雪","author":"成鹫","text":"千山迟解冻，三月不知春。\n谁信看花候，还来送炭人。\n冰壶藏白发，火宅笑红尘。\n褦襶门前客，无劳剥啄频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与谢邺门还山同赋","author":"成鹫","text":"便与所亲别，终年拟闭关。\n如何此时节，亦复到人间。\n急雨移新路，痴云恋旧山。\n归逢林下叟，笑我未能閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又","author":"成鹫","text":"何人排闼入，来客与归僧。\n昨日山下路，苍苔没几层。\n怒蛙喧废井，饥鼠啮枯藤。\n莫厌荒凉地，分吟古佛灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中寒雨答友人","author":"成鹫","text":"山云作山雨，问山山不知。\n我心正如此，君子复何辞。\n雪色侵长薄，鸡声过短篱。\n见闻俱寂寞，何处更寻师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜发汾江寄山中诸子","author":"成鹫","text":"故山在何处，乃在白云端。\n今夜孤舟宿，方知海气寒。\n潮声欹枕听，月色隔船看。\n此际谁堪语，持归寄所欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陶握山还山喜赠","author":"成鹫","text":"梦想所不到，见时仍梦中。\n可怜双鬓改，只有寸心同。\n无足为君道，前尘过眼空。\n故山茅屋在，归兴复何穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"野人","author":"成鹫","text":"野人有真性，对客不通名。\n赤脚驱黄犊，山田事耦耕。\n桑麻存古道，水石足平生。\n我欲同沮溺，终身免到城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚发石龙","author":"成鹫","text":"昨枉故人信，无端事远游。\n山城何日到，江水正东流。\n身老难为客，心閒易觉秋。\n最怜今夜月，孤棹别罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚泊赤岭","author":"成鹫","text":"残日还归海，馀光更上天。\n中流千嶂合，断岸一镫悬。\n旧路成生路，前船是后船。\n客心无可道，回首但茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过七里湖","author":"成鹫","text":"尽日舟中住，江声静入怀。\n昼眠宜浅水，宿雨避丹崖。\n渐觉乡音异，惟闻鸟语佳。\n旁人那辨此，幽兴与谁偕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊煎湖","author":"成鹫","text":"近识舟居乐，波涛渐不惊。\n临流谙水性，随地问山名。\n樵径通牵路，松风杂棹声。\n兴来履危石，为爱草虫鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"示同舟","author":"成鹫","text":"举目同为客，何人似我閒。\n舟中安笔砚，到处写溪山。\n大道无拘束，吾生任往还。\n终当清颍上，洗耳听潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中寄同学诸子","author":"成鹫","text":"为语操舟者，中流好着篙。\n微风生浦溆，一水尽波涛。\n彼岸渺无际，予心郁以陶。\n何时群动息，轻棹过江皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚泊临水驿","author":"成鹫","text":"同舟拾枯竹，钻火作盘餐。\n晚食推篷坐，秋风隔浦寒。\n山亭临水驿，旧吏送新官。\n独有沧浪叟，年年倚棹看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊浮鹅石登大悲阁","author":"成鹫","text":"孤棹去呕哑，千山暝色遮。\n牛羊归古渡，鸥鹭下晴沙。\n久客思寻寺，逢僧便当家。\n劳师相指点，前路水三叉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"昼雨书事","author":"成鹫","text":"昼雨洗山骨，溪云覆涧毛。\n悬崖花气近，出谷鸟声高。\n选石临清濑，当风振敝袍。\n船头见黄菊，秋思更萧骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中晚泊","author":"成鹫","text":"出门方八月，中道已深秋。\n去国一千里，长江日夜流。\n浓阴生绝壑，疏雨在孤舟。\n自是无家客，逢山便可留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上滩","author":"成鹫","text":"华发生秋色，青山惜暮年。\n艰难行路客，留滞上滩船。\n远水分孤屿，中流见逝川。\n客心正摇落，吟遍夕阳边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中寄李苍水广文","author":"成鹫","text":"一夜千峰雨，江声怒似雷。\n青山频北望，白雁正南来。\n为客伤迟暮，伊人愿溯洄。\n秋风肯相待，到日菊花开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中见新月","author":"成鹫","text":"大江流■㶁，初月如悬弓。\n独坐鉴孤影，清光思不穷。\n兼烟笼夜色，杂树摇秋风。\n回忆故山际，此心谁与同。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过河源","author":"成鹫","text":"二水分山县，东西别渭泾。\n前峰消积雨，流潦下沧溟。\n晴日睡方足，江风吹复醒。\n看看老渔父，一曲过寒汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过二峡","author":"成鹫","text":"是处有人家，停舟见落花。\n黄茅沽酒肆，红蓼钓鱼槎。\n社古榕阴阔，山高石径斜。\n东南车马路，何地得如他。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊龙川","author":"成鹫","text":"一日一停船，长歌落照边。\n孤城连雁塔，古道入龙川。\n山出烟中髻，薇舒雨后拳。\n冥心观物理，初月不成眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"投通衢店","author":"成鹫","text":"倦客寻山店，随人入郭门。\n短檐低白日，细雨又黄昏。\n伫立知何处，徐行渐到村。\n不辞频问讯，恐或是桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清溪店","author":"成鹫","text":"东去清溪水，水清能照人。\n我来住行脚，独立见閒身。\n红桕当孤店，青山在隔邻。\n风尘暗前路，谁复是知津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种梅 其一","author":"成鹫","text":"选树斸山骨，托根宜土膏。\n荷锄聊独往，抱瓮不辞劳。\n引客吟官阁，教人恨楚骚。\n寒柯时一抚，白发且频搔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种梅 其二","author":"成鹫","text":"大地直如寄，天机祇自全。\n新知丰乐老，能识藐姑仙。\n在世了无梦，与僧长有缘。\n何人从此去，参得大梅禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种梅 其三","author":"成鹫","text":"门心俱似水，到处即罗浮。\n侧径堪旋马，新阴未蔽牛。\n江城吹■篥，山月照襟裯。\n莫怪参横候，花前忆故丘。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种梅 其四","author":"成鹫","text":"绿英逢李白，佳句似阴铿。\n叶底吟诗遍，花时太瘦生。\n尘根当下尽，心目一齐清。\n自谓山凡异，拈来愧老兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种梅 其五","author":"成鹫","text":"落叶满空林，花边好独吟。\n十年非过计，七日本无心。\n虚室含朝白，閒阶布夕阴。\n夜来三尺雪，谁复更相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种梅 其六","author":"成鹫","text":"出林生内热，移树就新寒。\n夜坐当三五，朝眠过一竿。\n雨肥争影瘦，吟苦觉诗酸。\n即此忘饥得，应同井李看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种梅 其七","author":"成鹫","text":"抚物吾当老，东风度度春。\n如何枯树下，犹有守株人。\n灵谷花无赖，孤山鹤作邻。\n低枝君莫损，留挂接䍦巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种梅 其八","author":"成鹫","text":"未有还童术，言寻萼绿华。\n高天回白首，平地发黄芽。\n丰骨独殊众，荣枯一任他。\n长镵三尺柄，凭尔作生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种梅 其九","author":"成鹫","text":"枝叶删须尽，天根返太清。\n枯禅与枯木，无地亦无生。\n当下成空色，真宜作太羹。\n谁能知此意，默默绕花行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种梅 其十","author":"成鹫","text":"本来同木石，天性足烟岚。\n老大惟留骨，扶疏自向南。\n世人胥病渴，吾道莫空谈。\n何日提筐去，归山掩破庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟发石湾奇别山中诸子","author":"成鹫","text":"言从泷水去，忍与故山违。\n帆影侵平楚，钟声隔翠微。\n孤踪成独往，无梦见君稀。\n早岁同袍者，何年携手归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吕耕山从李广文之澄迈 其一","author":"成鹫","text":"却笑耕山子，翻为渡海人。\n个中知者少，此事与谁陈。\n游藉儒官重，交从古道亲。\n行行慎岐路，彼岸淼无垠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吕耕山从李广文之澄迈 其二","author":"成鹫","text":"我将入山去，君复事南征。\n海国人稀到，东风自送行。\n滞形同在客，问道愧称兄。\n知有归来日，愁予白发生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吕耕山从李广文之澄迈 其三","author":"成鹫","text":"山间有明月，珍重赠临岐。\n后夜遥相望，清光知为谁。\n当中无影象，独立见须眉。\n正是飞云外，千峰一日时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"示罗定水受室","author":"成鹫","text":"此日乘龙客，当年竹马儿。\n漫惊年纪大，陡觉汝翁衰。\n琴瑟调今夕，杯棬感昔时。\n莫将江氏笔，持去画张眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别罗颢甫","author":"成鹫","text":"老母发垂白，痴儿口尚黄。\n苍茫就岐路，感激问行藏。\n别绪通幽隐，贫交在久长。\n海天无处所，惆怅一相望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留则陶握山","author":"成鹫","text":"只合住山老，胡为复有今。\n此行难自问，何况是知音。\n物外得无累，稠中见素心。\n悠悠岐路意，沧海未为深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"用韵留别庞鸿侣","author":"成鹫","text":"斲取爨中烬，被弦成五音。\n为君弹一曲，举世少知心。\n满载孤云去，言观大海深。\n到时无可寄，惟有水龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"用韵留别胡大灵","author":"成鹫","text":"舟楫送羁客，门闾倚老亲。\n分明眼前事，疑杀意中人。\n大海载孤月，单车转只轮。\n我心正如此，惭叹可谁陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途中口占","author":"成鹫","text":"望望知何去，悠悠不定家。\n泥深九折坂，尘冒只轮车。\n斜日闻归鸟，回风见落花。\n不堪回首处，几片赤城霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿那旦","author":"成鹫","text":"日入山欲暝，我行聊启居。\n三閒破茅屋，一宿即吾庐。\n砧急秋声外，月光人定初。\n今宵且高枕，来日复何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发太平","author":"成鹫","text":"轻舟胜驽马，周道似盘蛇。\n不为披星往，何由见月华。\n野风吹白草，零露湿黄花。\n谁念悲秋客，长歌怀宋家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆公泉","author":"成鹫","text":"此老去云远，茶经渐不传。\n如何荒徼外，亦有陆公泉。\n一勺还刍牧，千流及稻田。\n纷纷行路子，谁与共潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过韩公堤","author":"成鹫","text":"精卫填沧澥，虹蜺贯石梁。\n崎岖如鸟道，曲折胜羊肠。\n旷野人烟渺，平原客路长。\n无端过桥去，归目滞雷阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十月朔英利道中作","author":"成鹫","text":"去国正重九，中途逢小春。\n水喧争渡客，山静过桥人。\n岂效枯鱼泣，言随野马尘。\n明朝潮汛好，行矣莫逡巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄李苍水广文","author":"成鹫","text":"濠梁相见后，一别一回春。\n知尔非干禄，微官聊称贫。\n仕途容傲吏，僧外作閒人。\n莫远高凉席，天边有隐沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"故友梁腾虎困死朱崖，就地藁葬。九月登高望远，凄然有存亡之感","author":"成鹫","text":"白日孤光尽，英雄志气衰。\n瀰天皆宿草，何处葬要离。\n蜗国人休战，橘中谁斗棋。\n漫将成败理，持语髑髅知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄西宁张明府 其一","author":"成鹫","text":"不到泷中久，难忘最胜缘。\n梅砰城外寺，龙井石间泉。\n白日供身老，青山待我禅。\n还思寻旧隐，闻说长官贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄西宁张明府 其二","author":"成鹫","text":"旧识罗浮子，西归惠好音。\n一官清似水，四野沛为霖。\n游刃良庖技，挥毫郢匠心。\n殷勤出佳句，留与老僧吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄西宁张明府 其三","author":"成鹫","text":"吏习久不振，斯人方起衰。\n循良追古道，儒雅式今兹。\n政洽看鹰化，心閒有鹤知。\n何当弦诵地，容我结茅茨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄西宁张明府 其四","author":"成鹫","text":"佳气郁葱葱，琴台日出东。\n五弦弹解愠，六月来薰风。\n闻者饮馀善，与人存大公。\n谁能为此曲，无乃是文翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄西宁张明府 其五","author":"成鹫","text":"五岭丹砂窟，神仙作令多。\n文章鸿渐陆，枳棘凤巢阿。\n高缀赤松实，旁分泷水波。\n五云如可赠，借我护藤萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送岑金纪游珠崖五首 其一","author":"成鹫","text":"海外曾归客，春来复送人。\n相看同去住，临别且逡巡。\n去以初弦月，行当渐满轮。\n不应惟独照，凭尔辨疏亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]