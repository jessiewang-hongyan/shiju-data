[{"title":"灵谷寺梅花坞六首 其三","author":"焦竑","text":"一枝初出岩阿，看尽千林未多。\n天女知空结习，散花不碍维摩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1298,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"灵谷寺梅花坞六首 其四","author":"焦竑","text":"二十四番风信，四百八寺楼台。\n何似草堂梅燕，同人先探春回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1299,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"灵谷寺梅花坞六首 其五","author":"焦竑","text":"落落半横参月，溶溶尽洗铅华。\n盈盈湘浦解佩，脉脉萝村浣纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1300,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"灵谷寺梅花坞六首 其六","author":"焦竑","text":"西湖梦断人寂，东阁妆残月斜。\n襟解微闻芗泽，钿昏半卸檀霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1301,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石经洞","author":"冯有经","text":"小西方境隔层台，半岭何年一藏开。\n舍利涌光文字住，香林施净帝天来。\n山名白带知幽爽，洞作烧痕试劫灰。\n更上高峰最高处，风雷竟日为鸣哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1302,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春尽过显灵宫","author":"冯有经","text":"长杨夹路水流渠，高阁烟光落槛疏。\n歌鸟报晴云彻净，架藤满紫蝶来初。\n风回氅佩飞谭麈，香扑真文走蠹鱼。\n有药驻颜难驻日，一春抄得酒方书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1303,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上望飞云洞","author":"王一鸣","text":"咫尺飞云洞，巉岩不可登。\n江风吹落日，时见出山僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1304,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜行问外舅病","author":"王一鸣","text":"问舅甥宜往，存亲妇亦携。\n路长宁禁夜，月小正临溪。\n浅水时时渡，高山步步迷。\n不须求驻马，早已听鸣鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1305,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渡河至大梁","author":"王一鸣","text":"陇净林争出，壕纡岸果通。\n日增秋草澹，风闪石花红。\n猎骑归梁苑，沙人牧宋宫。\n凭高一俯仰，来往愧冥鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1306,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五月末旬皖中作二首 其一","author":"王一鸣","text":"细细生青霭，娟娟动绿筠。\n晚凉风入座，帘卷月随人。\n天宝唐中叶，长沙汉远臣。\n双龙空在匣，何地出风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1307,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五月末旬皖中作二首 其二","author":"王一鸣","text":"寺僻诸天近，人忙五月残。\n书淫长不治，药裹近相宽。\n菜熟供宾话，墙低借树看。\n岂应聊住此，吾甚梦鱼竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1308,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"便民仓是县漕米入江处时方忧旱","author":"王一鸣","text":"修竹回斜径，高蝉噪夕阳。\n数行迁客泪，一洒便民仓。\n剜肉知何补，劳心或自伤。\n骄雷蟠赤日，念尔稼登场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1309,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白莲峰再别阮太乙张若愚","author":"王一鸣","text":"草泽悲将隐，莲峰慰独留。\n因君三日住，赠我万山秋。\n芋栗供僧饭，沧浪忆钓舟。\n诸天念离别，钟磬晚悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1310,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊九江","author":"王一鸣","text":"泽畔吟迁客，云边认郡名。\n天扶惊浪转，秋共放船清。\n山密无劳问，江长不肯平。\n柁楼城下泊，旅饭月初生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1311,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日杂诗","author":"王一鸣","text":"天入层层树，山回片片云。\n乾坤输独立，江汉正平分。\n久计行藏熟，深悲治乱闻。\n林深见麋鹿，异类得同群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1312,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宁夏破贼歌","author":"王一鸣","text":"东倭西虏共欃枪，宁夏军书报太平。\n九庙红云迎饮至，诸公白日快谈兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1313,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"马当","author":"王一鸣","text":"早发鲟鱼嘴，西风过马当。\n日连波皛皛，天入树荒荒。\n远岫能相迟，归鸿不计行。\n禹功疏瀹苦，今古戒垂堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1314,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"固镇驿感旧","author":"王一鸣","text":"忆昔朝天回憩此，湍青沙白殢春阴。\n已拚车马兼程苦，更剧干戈死战心。\n群盗就平吾放逐，五年重到暮登临。\n桃花最似曾相识，嫩蕊繁枝伴独吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1315,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戏马台","author":"王一鸣","text":"彭城南郭云山豁，病骨扶筇午上台。\n燕去鸿回登眺眼，龙争虎斗古今才。\n荒荒白日三春过，滚滚黄河万里来。\n昭烈祠堂亦邻近，暖云烟树更徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1316,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十月三十日夜二首 其一","author":"王一鸣","text":"十月余今夕，孤城笑此身。\n云墙喧柝重，霜月卷帘真。\n鸣雁悲千古，悬鱼负众人。\n北风时引领，燕赵接风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1317,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十月三十日夜二首 其二","author":"王一鸣","text":"墨墨怀孤愤，皇皇过六旬。\n浪移秦国木，稳积汉家薪。\n杂遝乾坤事，奔腾战伐人。\n星檐送徐步，高树上苍旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1318,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"可叹","author":"王一鸣","text":"可叹羁栖地，谁高簿领名。\n醉乡有天地，大事问公卿。\n江缩龙堪蛰，山深虎自耕。\n十年路傍月，犹照逐臣缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1319,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除夕答秦京","author":"王一鸣","text":"孤城留翰墨，高咏豁心神。\n岁晚悲游子，官卑忆古人。\n鼓钟迎曙急，梅柳报春匀。\n愧作长安梦，衣冠拜紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1320,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十载","author":"王一鸣","text":"十载犹迁客，孤踪愧俗人。\n长缄存后舌，乍保爨余身。\n楚泽云千里，春城月半轮。\n潜夫潜未得，飘泊损天真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1321,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"旅舍","author":"王一鸣","text":"旅舍清淇侧，经过有底忙。\n树围春堡急，沙涨午风黄。\n万事看云哭，三年跃马长。\n敝车生耳地，僮仆笑行藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1322,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卫上梦见徐孔时李聘若","author":"王一鸣","text":"客梦通徐李，晨钟报独眠。\n空花劳世界，宿草几风烟。\n死友惭天地，余生误保全。\n卫流清树底，应共泪溅溅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1323,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"即事","author":"王一鸣","text":"清漳曲折逐臣居，病骨西风枕簟虚。\n数罢过鸿无一事，半窗槐影半窗书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1324,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"述怀寄达邢太仆子愿先生二首 其一","author":"王一鸣","text":"白简腾三府，黄州住二年。\n旱从新谷贷，寒想叠衣眠。\n简出山川贵，深耕性命全。\n优游开万卷，事事信皇天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1325,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"述怀寄达邢太仆子愿先生二首 其二","author":"王一鸣","text":"鹊山寒吹老，雁泊溟烟深。\n杳杳登临眼，纷纷离合心。\n报书扶病写，好句背人吟。\n亦有三台酒，秋轩想共斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1326,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄高邑赵考功梦白先生","author":"王一鸣","text":"恒相无多路，邮筒苦不传。\n韩陵高树杪，碣石乱云边。\n世事添酣睡，高才早弃捐。\n朔风吹水立，俯仰一潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1327,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿州见燕子","author":"王一鸣","text":"燕子孤飞眼乍新，睢阳风日可怜春。\n细推湖海同为客，漫住亭台莫避人。\n穿垒衔泥终物性，南来北去任天真。\n处堂一恸堪千古，对尔题诗会怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1328,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"支硎山口占","author":"王衡","text":"晓山烟重暮山开，石马三朝半绿苔。\n扫得墓门清似水，梅花昨夜又飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1329,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"花朝","author":"王衡","text":"晴烟膏露若为容，踯躅香苞望晓红。\n莫怨五更风色恶，开花原是落花风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1330,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"计偕别长儒仲醇","author":"王衡","text":"结旆萧萧事远游，沙湖潮上荻花秋。\n征帆日落长江外，送客钟闻野渡头。\n一夜弟兄吴市酒，几回风雪剡溪舟。\n缁尘古道浑如许，珍重初衣问白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1331,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与仲醇馆中夜话","author":"王衡","text":"腰镰无赖剪秋蓬，孤馆寥寥夜色空。\n忽报客来钟定后，共看心事月明中。\n梦回书带飞蝴蝶，坐久经帘堕网虫。\n种得芭蕉堪作纸，墨庄荒尽旧墙东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1332,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"北上吕城阻坝别亲","author":"王衡","text":"苏苏寒雨滴平川，共话行期笑屡迁。\n宿草故含河畔色，新炊半见客中烟。\n隔江鸿雁如兄弟，明月天涯是去年。\n匹马夕阳缘底事，梅花零落野塘边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1333,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"池上即事","author":"王衡","text":"含情落叶已缤纷，深转歌喉齿未分。\n桥上玉人真咫尺，箫声似隔数重云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1334,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大内莲花","author":"王衡","text":"西山青落影娥池，仗外芙蓉入照时。\n薄雨未消初日晕，晚风欲语向人枝。\n六宫香粉流红腻，三殿浮凉湛绿漪。\n的的夜舒人不见，集灵台畔露华知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1335,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓极乐寺","author":"王衡","text":"湾湾绿水带城阴，白日青莲双树林。\n万叠云山千里梦，六时钟磬五更心。\n寒灯贝叶翻香蠹，春日檐花坐语禽。\n随意竹床葵菜好，经帘不卷画堂深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1336,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东坡作戒杀诗贻陈季常季常自后不复杀岐亭之人多化之有不食肉者适有感于吾里宴会之侈因和前韵得二诗示闲仲肯倡此戒于里中不也 其一","author":"王衡","text":"人饥慕粱肉，肉厌思茗汁。\n径寸神明仓，蛲蛔争暖湿。\n珍味纵可穷，饥饱要自得。\n于我实腐余，于彼捐所急。\n曲曲方塘边，扰扰牧鸡鸭。\n时哉谨栖止，柳花作茵幂。\n怜汝巢卵倾，忍使羽毛赤。\n每来待曲宴，倒瓮浮大白。\n渐为腰缓带，或遣头穿帻。\n釜熟薪且劳，瓶饱汤已泣。\n少损郇公厨，鼎笾未为缺。\n淡然天人粮，请以羞主客。\n一枕茶寮清，时时共来集。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1337,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东坡作戒杀诗贻陈季常季常自后不复杀岐亭之人多化之有不食肉者适有感于吾里宴会之侈因和前韵得二诗示闲仲肯倡此戒于里中不也 其二","author":"王衡","text":"饮酒不尽樽，啜肉不尽汁。\n同生天地间，念此相呴湿。\n每见肉食人，豆藿亦甘得。\n臡牛挂脯林，无乃非其急。\n窗前能谈鸡，栏傍自名鸭。\n性命嗟有制，俄尔膏鼎幂。\n五虫毛领殊，共兹一腔赤。\n蜣螂纵高飞，曷思蠕中白。\n强力相噬吞，何异虎而帻。\n抚己胡功能，忍彼釜底泣。\n吾欲食称事，稍补百行缺。\n乞汝耕馌余，施我不速客。\n愿同雀鹆驯，欣然掌中集。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1338,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"子夜夏歌二首 其一","author":"公鼐","text":"驰辉入朱明，汤风庭中满。\n欢情如敲冰，易消复易断。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1339,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"子夜夏歌二首 其二","author":"公鼐","text":"青莲如华盖，明珠朝露鲜。\n风来荷盖侧，珠亦不成圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1340,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋歌","author":"公鼐","text":"宵烛无余光，熠耀已在堂。\n萤光能几许，焉照妾中肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1341,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出戒坛北行岢罗山道遇雨小憩村家","author":"公鼐","text":"路转瑶坛背，阴崖石更奇。\n前峰堆冒絮，过雨扬游丝。\n暂问油囊酒，旋铺马鬣棋。\n却因争席处，转畏野人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1342,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西郊有地名钓鱼台金主游历处","author":"公鼐","text":"花石遗京入战图，燕门衰草钓台孤。\n不知艮岳宫前叟，得见南兵入蔡无？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1343,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初入谏院寄慰肥城父老","author":"陆懋龙","text":"剧县息劳人，新班立紫宸。\n种花收薄效，焚草企先臣。\n漏欲天同补，膏怜土渐春。\n淮西蚕麦候，缓税乞皇仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1344,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"行部公安袁进士中郎过访","author":"陆懋龙","text":"双旌初到郭，片刺忽临门。\n冷榻尘谁扫，新茶火正温。\n望君知白皙，屏从接清言。\n待淅官厨米，留灯坐日昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1345,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖楼雨集","author":"陆懋龙","text":"不量晴雨便称卮，雨过楼头别一姿。\n画壁云香从座起，筠帘风影逐波移。\n歌残烛灺春衣怯，语杂觞条夜漏迟。\n带湿管箫疑半咽，城乌啼上隔墙枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1346,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"还家作","author":"陆懋龙","text":"官道如弦照水空，双扉半掩绿槐中。\n曾经拜命施行马，又到挥弦送去鸿。\n邴禄初过谋秫酒，羊棋罢赌听松风。\n生来左癖称专业，手课儿童为教忠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1347,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偶阅先辈刘大参洪黄观察隆卢谏议瑀严驾部端夏游福德庵诗次韵","author":"陆懋龙","text":"落尽藤花始一游，绿杨如握可维舟。\n手持茗碗哦诗罢，半岸纱巾露白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1348,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"小院","author":"陆懋龙","text":"小院幽阴似井间，风枝堕地点苔斑。\n何时铲却重檐去，露出西南一角山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1349,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜有怀","author":"吴稼竳","text":"孤灯掩虚室，独枕抚空床。\n客寐何缘假，秋宵一倍长。\n离怀江水急，薄命柳条黄。\n西月横天落，乌啼满树霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1350,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋怀四首 其一","author":"吴稼竳","text":"谁家凄切捣衣声，吹入空闺恨转生。\n永夜寒乌栖未定，清霜独鹤舞难成。\n素丝沈水元无影，绿绮临风久不鸣。\n惟有旧时机上月，照人寂寞片心明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1351,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋怀四首 其二","author":"吴稼竳","text":"金荆为枕紫荆床，已共秋尘委曲房。\n灯下有情归络纬，机中无梦到鸳鸯。\n明星烂烂愁天老，爝火离离叹夜长。\n一树桐花零落尽，可怜梧子自经霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1352,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋怀四首 其三","author":"吴稼竳","text":"当年窃药事还真，碧海茫茫未许亲。\n银烛可怜徒向夜，玉颜无复更知春。\n清商感激愁中曲，落羽差池病里身。\n奉诏长门能买赋，黄金取酒为何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1353,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋怀四首 其四","author":"吴稼竳","text":"重扃落叶迥相依，罗袂无声事已非。\n宝镜欲开鸾自泣，玉钗初断燕犹飞。\n旅葵未合生空井，苦蘖真堪染故衣。\n满目清秋何所似，白云愁色远微微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1354,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"花朝","author":"吴稼竳","text":"日气朝青池上波，交交啼鸟傍池多。\n三春花事终难负，二月风光半未过。\n土俗岁时存旧记，闺人单夹制轻罗。\n正怜一树樱桃放，桃李相催奈若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1355,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"社日过山庄","author":"吴稼竳","text":"背依丛竹面清溪，茅屋萧疏类瀼西。\n儿子社钱无用觅，田家秋酿且相携。\n梁间已去将雏燕，阶下新行傍母鸡。\n一束荆薪兼蕴火，不愁山路夜归迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1356,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟行归思","author":"吴稼竳","text":"大江日夜水粼粼，飞尽杨花不见春。\n枕畔独吟愁里客，镜前双笑梦中身。\n生能无累庞居士，老未忘情白舍人。\n儿女团栾归便得，底教歌榭暗流尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1357,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜阻江上","author":"吴稼竳","text":"风揭空江浪忽兴，停舟断岸石棱棱。\n遥闻野寺一声磬，近辨渔家几处灯。\n归信不如潮有准，客程翻似梦无凭。\n薄寒谁为更衣计，闲杀中闺半臂绫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1358,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金陵酒肆赠茅平仲","author":"吴稼竳","text":"暮年看尔壮心孤，落落酣歌击唾壶。\n但数一钱怜姹女，才夸千骑笑罗敷。\n梨花雨湿红襟燕，杨柳春藏白项乌。\n欲向卢家借双桨，莫愁不是旧时湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1359,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"代寄徐仲容","author":"吴稼竳","text":"秋雨苏苏滴井梧，风吹妾梦到东吴。\n生来自恨青溪近，独处无郎似小姑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1360,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春梦","author":"吴稼竳","text":"群书一束枕山楹，残雪融檐作雨声。\n春梦不随春水慢，片时还到阖闾城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1361,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂感六首（万历初，江陵当国时作） 其一","author":"梅鼎祚","text":"羲轮发扶桑，虞渊弭六龙。\n圆景戒恒满，朏魄以示冲。\n如何夸毗子，作意矜颜容。\n步捷举趾高，顾盼有余工。\n执极何不然，人鬼且合从。\n屋禽骄亦淫，气焰若流虹。\n修途焉可竟，天运亦有终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1362,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂感六首（万历初，江陵当国时作） 其二","author":"梅鼎祚","text":"海燕西方来，雕梁托其端。\n差池若有媚，主寿称万年。\n凉风忽东逝，旧垒成弃捐。\n微禽一何知，乃与徂化迁。\n北山有寒焰，南山有温泉。\n一气荡相薄，阴阳互为权。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1363,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂感六首（万历初，江陵当国时作） 其三","author":"梅鼎祚","text":"龙角眷已旦，星鸟贞良时。\n三光亦浮系，焉得久控持。\n风水为轮枢，玄天经玉仪。\n空虚密流徙，自然有成亏。\n画挈递相矜，娓娓安所归。\n八埏生乱戎，戎首职为谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":1364,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]