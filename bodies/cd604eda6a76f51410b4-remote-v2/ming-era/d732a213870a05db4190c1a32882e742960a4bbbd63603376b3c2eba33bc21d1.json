[{"title":"八月十三日夜梦亡室安人惊泣而窹因思去年丁丑是日在京师安人未明兴告予曰今日趋朝不可如常日之宴盖其日警跸值新狩还也今遇是日感其贤淑又小子周二岁之晬重感赋绝句二首 其二","author":"杨慎","text":"稚子今朝是两周，新衣戏舞拜前头。\n伤心孺慕声声切，母在重泉听得不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8559,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠宋文百户石冈舍人","author":"杨慎","text":"七十从戎鬓已斑，劳君相送出滇关。\n过家儿子如相问，为报衰翁二月还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8560,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"征人早行图","author":"杨慎","text":"杜鹃花下杜鹃啼，乌臼树头乌臼栖。\n不待鸣鸡度关去，梦中征马尚闻嘶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8561,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"海估行 其一","author":"杨慎","text":"海估帆乘锦浪飞，绡宫夜取万珠玑。\n翻身惊起蛟龙睡，血污清泠竟不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8562,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"海估行 其二","author":"杨慎","text":"偃月堂空罢舞尘，靖安坊冷怨佳人。\n芙蓉莲子随他去，不及当年石季伦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8563,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"王子渊祠","author":"杨慎","text":"玮晔灵芝发秀翘，子渊摛藻掞天朝。\n汉皇不赏《贤臣颂》，只教宫人咏洞萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8564,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"复字闲咏六言绝句五首 其一","author":"张含","text":"花影重重叠叠，风声刁刁调调。\n日暖群蜂酿蜜，春寒独鸟栖巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8565,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"复字闲咏六言绝句五首 其二","author":"张含","text":"苍松错错落落，桃花灼灼盈盈。\n树老云盘睡鹤，春残雨咽啼莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8566,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"复字闲咏六言绝句五首 其三","author":"张含","text":"丈夫磊磊落落，下土戚戚营营。\n独勘庄周蝶梦，不闻祖逖鸡鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8567,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"复字闲咏六言绝句五首 其四","author":"张含","text":"浮生泯泯默默，荒村阒阒幽幽。\n远避尘中车马，独寻月下沙沤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8568,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"复字闲咏六言绝句五首 其五","author":"张含","text":"人世匆匆扰扰，天道汩汩悠悠。\n但得钓渔避世，从教屠狗封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8569,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"代古明月子娟娟篇","author":"张含","text":"南国多倾城，娟娟况有名。\n舞腰杨柳细，歌掌楚云轻。\n池月摇花影，帘风弄竹声。\n衡皋秋水净，洛浦晓霞明。\n仙苑笼金瓦，候门醉玉笙。\n人间亦天上，莫忆董双成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8570,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岳阳楼晚眺","author":"张含","text":"凉风八月秋，独倚岳阳楼。\n水自蚕丛国，山含鹦鹉洲。\n过雁防湖阔，哀猿动客愁。\n龙归锦云散，铁笛起渔舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8571,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜","author":"张含","text":"霜雁孤鸣际，秋宵独坐情。\n隙风微烛焰，寒雨翳钟声。\n六十无官职，诗书有弟兄。\n雕虫真末技，潦倒负平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8572,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"离夕有赠 其一","author":"张含","text":"仙子武陵溪，春深归路迷。\n翠翘迎露湿，罗袖避风啼。\n留佩花笼玉，分钗月印犀。\n金杯延落日，酒醒各东西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8573,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"离夕有赠 其二","author":"张含","text":"南浦盈盈泪，东风小小年。\n回镫窈窕夜，分镜泬寥天。\n销骨惊花箭，离肠泥酒船。\n可怜明月子，依旧影娟娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8574,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读亡友何仲默无题诗继作二首 其一","author":"张含","text":"晓日昭阳燕子斜，香尘不到绿珠家。\n翠裙楚岸江蓠叶，红袖唐宫石竹花。\n宝镜玉龙羞佩璲，檀槽金鹊涩琵琶。\n洗妆夜拜瑶池月，怅望神仙萼绿华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8575,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读亡友何仲默无题诗继作二首 其二","author":"张含","text":"结绮临春照晚霞，琼枝壁月斗妍华。\n双歌共醉瑶池酒，万舞齐开玉树花。\n合浦明珠穿蹀躞，中山文木斫琵琶。\n可怜一笑倾城者，犹自江头浣越纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8576,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"开怀","author":"张含","text":"城内溪园有钓台，青丛花尽蝶还来。\n百篇诗律抒孤愤，千卷书签换旧裁。\n山客每过评药价，寺钟初发赴僧斋。\n松心鹤性清如水，逗雪盘云共老怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8577,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"颍川侯祠（点苍山、白石江皆颍川战地）","author":"张含","text":"野老争传傅颍川，当年功业建南滇。\n平蛮营垒苍山外，破虏旌旗白石边。\n只见荒祠通落日，不闻遗像照凌烟。\n阴风古树无穷恨，常为英雄吊九泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8578,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"遣兴","author":"张含","text":"蒙舍秋风不作凉，少陵何咏洒衣裳。\n青青古树如张盖，熠熠流萤欲近床。\n城接银河通沆瀣，江连铁柱锁封疆。\n蟾光不蔽名山色，望里悠然见凤皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8579,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日村居闲作","author":"张含","text":"庭草初齐巷柳斜，暖风晴旭野人家。\n山中梦破寻蕉鹿，杯里弓疑避酒蛇。\n棋局交情空点检，机关世道重吁嗟。\n闲陪白昼驯阶鸟，归数黄昏卜树鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8580,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除夕次用修韵","author":"张含","text":"新岁重赓往岁诗，壮心寥落忆南邮。\n东风消息谁先得，客子光阴我自知。\n芳草已回迎步处，梅花又满断肠枝。\n明朝莫负城西约，踏遍郊原问酒旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8581,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄升庵长句三首 其一","author":"张含","text":"别路归鞍金屈卮，瑶华篇赠欲秋时。\n青山倦鸟怜幽独，白日寒花怨别离。\n狡兔共称三窟好，鹪鹩惟许一枝宜。\n严冬鳞羽频相讯，迷雾牵云梦不迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8582,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄升庵长句三首 其二","author":"张含","text":"霜月娟娟鼓角清，连然回首梦魂惊。\n舞筵尚想鸡鸣酒，棋阵浑防鹤唳兵。\n凤阙云寒迷北顾，龙关风暖护南征。\n徒令白首攻文事，铸错难消铁满城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8583,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄升庵长句三首 其三","author":"张含","text":"连然醉折荷花别，过眼那知红叶残。\n甸尾海云随雁过，苍颜山雪照城寒。\n欲捻锦瑟黄金盏，旋买青骢白玉鞍。\n弦满清光今夜月，可怜君在异乡看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8584,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题","author":"张含","text":"维摩丈室散花回，公子华筵向晚开。\n锦里词华薛洪度，秦川歌舞赵阳台。\n颓云宫髻笼香界，纤月城眉照玉杯。\n舞罢罗裳《小垂手》，一枝豆蔻薄寒催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8585,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"得少海遣谪归蜀消息寄赠","author":"张含","text":"文章声价冠东曹，海上传闻复钓鳌。\n白帝云中须采药，夜郎月下得吹箫。\n古来直道犹三黜，今日忧时枉二毛。\n濯锦江头非泽畔，挥毫何用赋《离骚》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8586,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀用修仁甫","author":"张含","text":"廿年踪迹遍雕题，传道重游洱水西。\n离梦独牵张半谷，风流惟共李中溪。\n郑玄耐可笺浮蚁，王勃何须檄斗鸡。\n紫菀丹丘曾有约，赤松黄石肯相携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8587,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄升庵二首 其一","author":"张含","text":"东观声名北斗齐，凤皇踪迹戍雕题。\n八千里外潮阳马，十九年来海上羝。\n铜柱蒹葭鸿雁响，铁城烟雨鹧鸪啼。\n连宵数有怀人梦，记得分明锦水西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8588,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄升庵二首 其二","author":"张含","text":"璧玉津辉锦里间，龙堤池水故潺潺。\n雕磨荆石刘公干，萧索江干庾子山。\n四海英雄空迸泪，一林猿鹤共愁颜。\n宴游尽日东山妓，谁道怀情善闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8589,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄升庵（近撰海口碑文，极奇）","author":"张含","text":"公子思归几岁华，王孙芳草遍天涯。\n楼头艳曲包明月，海口新铭蔡少霞。\n光禄塞遥空递雁，上林枝好只栖鸦。\n梦中记得相寻处，东寺钟残北斗斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8590,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽居感事兼怀升庵","author":"张含","text":"陈编历历复悠悠，蕉萃荣华一转头。\n秦客已游黄犬市，齐奴还起绿珠楼。\n君从海上寻方朔，我向山中觅许由。\n好学四禅同结夏，不须《九辩》独悲秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8591,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"己亥秋月寄升庵","author":"张含","text":"金马秋风十载余，芙蓉深巷闭门居。\n登楼莫作依刘赋，奉使曾传谕蜀书。\n卧病可怜天一柱，独醒无奈楚三闾。\n北来消息风尘动，白首沧江学钓鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8592,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀归","author":"张含","text":"九龙池上有高台，池下芙蓉台上开。\n锦鲤不妨仙客跨，白鸥须望主人回。\n青山绿树孤猿啸，黑水黄云一雁哀。\n戎马西南经百战，夕阳铜柱锁苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8593,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甲申仲冬闻雷兼得北来消息","author":"张含","text":"荒城冬仲尚鸣雷，万里惊传邸报来。\n祭马天骄兵甲动，织衣中使锦帆开。\n江湖白发交游泪，霄汉孤臣献纳才。\n短景更催伤岁暮，南鸿应伴北鸿哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8594,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"绝句二首 其一","author":"安磐","text":"折竹声乾万壑虚，晚风江上有归渔。\n闲来只共梅花笑，雪里何人到草庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8595,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"绝句二首 其二","author":"安磐","text":"竹杖纶巾避俗翁，闭门终日坐高松。\n抱琴却是无弹处，流水高山一万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8596,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过印上人故居","author":"安磐","text":"振策当年诣远公，袈裟相见坐从容。\n向来弹指空千劫，今日低头礼万松。\n小院影堂无客到，绳床蒲坐有尘封。\n可怜月色还如旧，泪下西楼夜半钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8597,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画","author":"安磐","text":"百里同云雪满蓬，冥冥那复计西东。\n轻舟不畏邪溪水，向晓南风暮北风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8598,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"枕上口占","author":"兰廷瑞","text":"枕上诗成喜不胜，起寻笔砚旋呼灯。\n胆瓶滴取梅花水，已被霜风冻作冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8599,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杜鹃词","author":"丽江木知府","text":"山前杜宇哀，山下杜鹃开。\n肠断声声血，郎行何日回？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8600,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春居玉山院","author":"丽江木知府","text":"玉岳崚嶒映雪堂，年年有约赏春光。\n飞红舞翠秋千院，击鼓鸣钲蹴鞠场。\n迟日醉听群鸟哢，暖风时送百花香。\n好山好地堪为乐，莫厌尊前累尽觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8601,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"华马国（巨津州名，昔元世祖驻跸于此而封）","author":"丽江木知府","text":"政暇西巡华马国，铁桥南度石门关。\n北来黑水通巴蜀，东注三危万里山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8602,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮春会","author":"丽江木知府","text":"官家春会与民同，土酿鹅竿节节通。\n一匝芦笙吹未断，蹋歌起舞月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8603,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春游即事","author":"丽江木知府","text":"金狨缓拽红衢腻，叱拨频嘶绿巷深。\n噆柳穿花还未遍，夕阳又抹树头金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8604,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"席间即事","author":"丽江木知府","text":"春宴英蕤载满头，玉船横举较诗筹。\n双鬟拨尽《鼙婆曲》，复听蛮童唱石榴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8605,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"采莲词二首 其一","author":"丽江木知府","text":"石榴裙卷足如霜，折得红莲满抱香。\n羞向人前女儿貌，手遮西日看湖湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8606,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"采莲词二首 其二","author":"丽江木知府","text":"弱袂长鬟荡水中，钏文钗影入荷丛。\n鸣榔惊起韩朋鸟，一个西来一个东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8607,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自种柳","author":"丽江木知府","text":"双杨初种几经春，始见长条已拂尘。\n万缕绿阴堪作帐，一枝不许赠行人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8608,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬日喜饮","author":"丽江木知府","text":"暖阁熏香雪未晴，浅斟脍炙舞茵横。\n侍儿斜立朱帏下，十指红蚕弄锦筝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8609,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"览镜","author":"丽江木知府","text":"借览青铜镜，香奁出绣栊。\n喜看今日面，不改旧时红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8610,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病起","author":"丽江木知府","text":"临晓新梳发，呼儿卷幔纱。\n平生行乐惯，病起即看花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8611,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日晓起有感","author":"丽江木知府","text":"床侧支赜忆故情，忽闻檐外有啼莺。\n夜来记得游春梦，柳下花前一字行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8612,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"太素轩","author":"木青","text":"磐陀石畔看云屋，一一轩窗面水开。\n不是避门妨俗客，爱闲能有几人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8613,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙池春游曲","author":"张含","text":"红心草茁红桃开，龙池淼淼春水来。\n春鸟啼不歇，春燕语更切。\n少妇踏春游，伤春无限愁。\n红蕖蹀躞曳罗袜，罗袜尘生暗香发。\n密意难传陌上郎，含羞折花空断肠，跢伫路侧盼斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8614,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日","author":"兰廷瑞","text":"终日凭阑对水鸥，园林长夏似深秋。\n槐龙细洒鹅黄雪，凉意萋萋风满楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8615,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题姮娥奔月图","author":"兰廷瑞","text":"窃药私奔计已穷，藁砧应恨洞房空。\n当时射日亏犹在，何事无能近月中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8616,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"塞下曲","author":"程启充","text":"黑龙江上水云腥，女真连兵下大宁。\n五国城头秋月白，至今哀怨海东青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8617,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登高丘而望远海","author":"顾璘","text":"豋高而望远，不见天地端。\n日月互上下，东西如跳丸。\n长风自何起，瀛海翻波澜。\n六鳌正抃舞，五岳无时安。\n恍惚青天中，仙人跨飞鸾。\n邀我谒帝室，金门郁盘桓。\n青龙对人怒，玉女倾笑欢。\n彷徨返故路，北斗方阑干。\n坐地仰天叹，三日不能餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8618,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"伤歌行","author":"顾璘","text":"青春欲去不可留，白日欲落花含愁。\n银鞍白马分明别，故苑夫容伤素秋。\n不惜红颜坐凋歇，可怜君恩难再得。\n夜簟香销巫峡云，寒衣泪落秦关雪。\n掩却青铜镜，不忍生尘埃。\n且留兰膏烛，有心莫成灰。\n风吹蓬枝往复回，去年团扇今年开。\n小物无情尚如此，何独君恩无去来。\n买赋无黄金，挑丝不成锦。\n欲因魂梦逐车轮，愿君莫恶珊瑚枕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8619,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日行","author":"顾璘","text":"汉家三十六离宫，桃花树树摇春风。\n武皇当年正好武，天马七尺如飞龙。\n清晨蹋鞠过新市，薄暮鸣鞘入禁中。\n中人尽戴鵔鸃冠，猛士半跨黄金鞍。\n弯弓向云仰射雁，一发两禽皆道难。\n大官赐酒砗磲瓯，一春击尽千肥牛。\n撞钟伐鼓献奇舞，灯前变幻鱼龙浮。\n宫门沉沉金钥收，明月挂在城西楼，东方渐高复来游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8620,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"独漉篇","author":"顾璘","text":"独漉独漉，水多泥滑。\n泥滑道阻，伤我车毂。\n持膏作烛，将以照夜。\n虚花掩光，不逮槃下。\n猛虎在山，百兽畏威。\n陷阱三日，垂首诉饥。\n铁生矿中，入冶为器。\n剑负威神，锤则委地。\n男儿生身，万事纲纪。\n突梯无施，不如女子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8621,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"塞下曲 其一","author":"顾璘","text":"千里骅骝丈八矛，男儿画地取封侯。\n黄昏塞上传烽火，一夜吹笳坐戍楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8622,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"塞下曲 其二","author":"顾璘","text":"百战摧胡未许强，马前生缚左贤王。\n麟符鹊印须臾事，只博凌烟字一行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8623,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"塞下曲 其三","author":"顾璘","text":"黄河冰厚马横行，朔气棱棱古铁明。\n恨杀夜来风雪紧，匈奴逃出受降城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8624,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"古壮士歌","author":"顾璘","text":"山西壮士何才雄，虬须燕颔生英风。\n青春挟槊三边外，白昼探丸九市中。\n一身列侍麒麟殿，跨出龙驹万人羡。\n狐腋朝裁赵客裘，鹈膏夜淬吴王剑。\n生年十五事横行，肯学操觚记姓名。\n当衢贾勇万乘避，临危重义一身轻。\n田文鸡狗真馀子，有足不曳春申履。\n眼前国士稍倾心，慷慨桥阴为君死。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8625,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长相思曲","author":"顾璘","text":"长相思，在何处，吴岫云深隔江树。\n江树临春花正荣，人今已向天涯去。\n璚楼绣户横兰烟，中有绿鬟金骨仙。\n星河隐约秋期杳，坐捲朱帘望月圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8626,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉赠柴墟储公","author":"张羽（凤举","text":"儒雅当年定可师，相留一醉亦心期。\n宦情多暇诗频拟，秋兴堪悲菊未知。\n病喜家儿能检药，静怜檐鸟不惊棋。\n身应万仞青云上，沧海明珠几注思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":8627,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]