858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"府江吟 其七","author":"霍与瑕","text":"孤灯夜照西岩，画舫秋风凉雨。\n诗成弄石滩头，吏报寒更三鼓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"府江吟 其八","author":"霍与瑕","text":"和风和日秋天，碧水碧山洞府。\n桃源定在前头，试问西湾渔父。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登观澜阁 其一","author":"霍与瑕","text":"淡荡云容出岫，参差树影临江。\n黄犊晚归呼子，白鸥晴浴成双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登观澜阁 其二","author":"霍与瑕","text":"水色溶溶薄雾，山光淡淡明沙。\n试倩渔郎寻去，隔江疑有仙家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登观澜阁 其三","author":"霍与瑕","text":"径来羊仲求仲，菊有黄花白花。\n昨日南山书到，折腰郎向谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登观澜阁 其四","author":"霍与瑕","text":"太极图书易简，濂溪风月寻常。\n如何人去千载，高踪谁嗣遗芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重登观澜阁 其一","author":"霍与瑕","text":"禹贡旧时彭蠡，岷峨尽处匡庐。\n风物万年长是，祇今阳鸟攸居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重登观澜阁 其二","author":"霍与瑕","text":"落落云崖古木，锵锵铁涧寒流。\n多少孤桐浮磬，重华原未曾收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吕亭驿走笔 其一","author":"霍与瑕","text":"此地曾游吕仙，至今名驿千年。\n或者他时好事，更将对霍名轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吕亭驿走笔 其二","author":"霍与瑕","text":"暖日和风天气，青山绿水人家。\n对岸草眠黄犊，古亭槐集乌鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吕亭驿走笔 其三","author":"霍与瑕","text":"疏星错落瑶天，皓月徘徊银汉。\n凄断何处清歌，单衣饭牛夜半。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"走笔谢齐太衢戴浑庵 其一","author":"霍与瑕","text":"几度逢人问信，三年无雁传书。\n何因清昼陪侍，临水登山步虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"走笔谢齐太衢戴浑庵 其二","author":"霍与瑕","text":"方外清谈亹亹，花边乐事溶溶。\n如何路岐一别，回首云山几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋江送远 其一","author":"霍与瑕","text":"江上风波薄暮，天边云雨深秋。\n送君此日归去，楚水闽山共悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋江送远 其二","author":"霍与瑕","text":"水鬼含沙射影，山魈啸雨吹灯。\n无奈高真入定，支离伎俩何曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋江送远 其三","author":"霍与瑕","text":"三代同行直道，五溪原自淳风。\n何啻攀辕堕泪，纷纷图像鸠工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋江送远 其四","author":"霍与瑕","text":"露冕三年广甸，搴帷二载浔州。\n两地去思洵美，巍然祠宇江头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋江送远 其五","author":"霍与瑕","text":"疏灯白酒清湾，细语为君解颜。\n世界原非圆满，试看残月关山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋江送远 其六","author":"霍与瑕","text":"江门曾有真言，于福不可求全。\n饮水饭疏孔乐，耕田凿井尧天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋江送远 其七","author":"霍与瑕","text":"爝火精神有限，流星岁月无多。\n寄语达真高士，来归安乐仙窝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋江送远 其八","author":"霍与瑕","text":"自是丹山彩凤，偶然白璧苍蝇。\n且将韫椟而待，会见卷阿载鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋江送远 其九","author":"霍与瑕","text":"遥见天边归雁，忍闻秋半啼莺。\n悲歌送远何极，采遍芳洲杜蘅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋江送远 其十","author":"霍与瑕","text":"清尊宾主扁舟，解携珠海伤秋。\n不知何处吹篴，咽断寒江夜流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长相思","author":"霍与瑕","text":"楼阑写恨吟飞燕，歌管传情投木瓜。\n苦病三春愁不尽，谁将怀抱寄重华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题直山庄","author":"霍与瑕","text":"九曲溪边一泛槎，偶随云路过仙家。\n沉风暖日山堂静，东篱点点落梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]