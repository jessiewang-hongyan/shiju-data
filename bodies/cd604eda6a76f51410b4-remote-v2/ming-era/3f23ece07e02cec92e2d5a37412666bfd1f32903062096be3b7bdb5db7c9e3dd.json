[{"title":"邸舍立秋 其二","author":"沈守正","text":"盻盻望秋至，今宵梦亦秋。\n鹊衔蝉噪急，云带汉光流。\n有酒难独醉，无人堪说愁。\n如何不归去，闲老荻花洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中元鲁弥生张尔唯罗尚之招饮同郝刘二校书","author":"沈守正","text":"高城如榭水如油，良月开樽破客愁。\n夹坐名花含露艳，荐亡灯火杂星流。\n飞觞欲叫清辉下，改□俄惊戍鼓收。\n一辈蓬飘无所事，谋欢重九再登楼。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日邸舍","author":"沈守正","text":"秋风淅淅渐鸣枯，旅馆牢骚气色殊。\n门外泥深无客到，床头罍耻数钱沽。\n何人能市千金骨，吾道真如五石瓠。\n老却故乡莼似玉，一生大错是之乎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱澹修休假南还","author":"沈守正","text":"王家珠树三枝秀，少者先鸣驷马还。\n鸿雁数行随彩伏，蒹葭八月唱阳关。\n荆溪秋老文为石，鹫岭枫丹锦是山。\n令谱修成假未满，洞茶闲拨断桥湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆行仲南还","author":"沈守正","text":"子忘非主今为客，使我劳人转忆家。\n斑马不鸣魂巳断，红亭屡到泪空奢。\n慈亲白发怜衰柳，小妇青衫泛菊花。\n但是能归皆足羡，何须昼绣始堪夸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张尔唯九日招饮同弥生尚之大白洛生绸生用韵兼有所感","author":"沈守正","text":"三逢令节独悲秋，幸尔招携浪漫游。\n但醉不须嘲落帽，对花何必更登楼。\n南冠尽望燕山远，楚岫仍将暮雨收。\n转忆去年今日事，同人千里始知愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云娘行","author":"沈守正","text":"沈郎花谱近十年，云娘倾国人人传。\n每恨闻声不见面，无人为结三生缘。\n今年留滞在京都，都下美人多如荼。\n褰帷瞥见云娘在，喜动颜色光荣殊。\n萧萧疏柳直风前，皦皦孤鹤唳重玄。\n林下风流瑶阆骨，肯与妖邪争爱怜。\n谋欢正剧忽欷戏，知子胸怀不暂舒。\n似感故交零落尽，眼前香粉空相与。\n我方坎壈重太息，睹子肝肠增偪仄。\n忆昔十五入词场，烟飞纸落不可当。\n纷纷余子何足道，彼其当年耻雁行。\n流光荏苒廿余载，忧患经多容鬓改。\n空留七尺自昂藏，难使鸡群不尽骇。\n以此伤怀各自思，半面才通如旧知。\n何图座上风波阻，脉脉相看不得语。\n临岐把酒俨向人，转复无言但酸楚。\n人生会合自有神，何必荐枕始成亲。\n子尚风尘予浪迹，朱颜须慎百年身。\n他时若得重相见，应费青衫作泪巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和弥生晓行作限韵","author":"沈守正","text":"仆仆驱寒日，行行望酒帘。\n长途淹蹇步，衰鬓怯霜尖。\n过市嗟萧索，逢人问戒严。\n幸然偕胜侣，投策一掀髯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过金山不登感旧","author":"沈守正","text":"金山一过一回思，星聚连床彼一时。\n漫说箕裘徒筦尔，纵留文采亦空而。\n试凭江阁难舒眼，但听潮声巳蹙眉。\n明到江南逢旧侣，冻云寒日总成悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归过柳堂谒休复柩次时将之东海","author":"沈守正","text":"冲雪沾泥到柳堂，忍看阶草白于霜。\n嫁卿阿鹜今成谶，车忆桥公我独伤。\n生死自然多变态，飘沦应不责疏狂。\n拟将东海千寻浪，酹尔英雄一寸肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初归","author":"沈守正","text":"蒙茸万里解征骖，叙隔陈愁丙夜谈。\n细数亲朋将减半，笑怜儿女幸存三。\n梅花腊尽香先发，杨柳春来叶渐毵。\n游子乍归寻乐事，不须憔悴似江潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁巳元日怀都下游好","author":"沈守正","text":"椒觞柏醑正微醺，转忆燕山别绪殷。\n星聚忽然俱万里，风期终想冠千军。\n西陵春暖花如霰，曲院灯深女似云。\n总是多情易关涉，每逢胜令思纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄岩道中","author":"沈守正","text":"马烦人倦日晻■，岩壑争奇应接迟。\n雨脚云头皆米画，水田夏木忆王诗。\n江村种粳多于秫，秃树啼鸦怪似鸱。\n野性由来贪览涉，独嫌冠帻路傍知。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄岩怀古二首 其一 古城","author":"沈守正","text":"漠漠孤烟江上横，行人说是偃王城。\n当年仁义将何用，地下疮痍恨未平。\n故垒几朝看鹿走，荒基无岁不牛耕。\n徐山石室今何似，旧楚依然春草生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄岩怀古二首 其二 壕头","author":"沈守正","text":"此地不闻如巨鹿，何缘白骨似长平。\n古壕三尺冤难涤，亡镞千年魄尚惊。\n风雨丹枫标汉帜，兵戈旧垒筑新城。\n英雄多少埋黄土，屠钓偏流竹帛名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕有怀","author":"沈守正","text":"去年七夕燕山度，今日双星海畔看。\n一自故人如雨散，曾无片楮报霜寒。\n关河到处容堪老，杯酒人开会尚难。\n万卷腹书何意晒，且从儿女觅新欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日沈倩明黄及生应百禄庆云陈长孺仲孺招饮九峰寺","author":"沈守正","text":"九日携樽到九峰，峰藏修竹列高松。\n篮舆幸有门生□，红饮欣无俗子逢。\n孤塔出林留夕照，古藤余兴待疏钟。\n三年令节皆为客，南北东西愧短筇。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"施生归自九江赋赠 其一","author":"沈守正","text":"枫老橙黄物候新，记行犹自草如茵。\n九峰诸子飞觞夜，果是茱萸少一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"施生归自九江赋赠 其二","author":"沈守正","text":"子归何日发湓城，江路萧萧匹马行。\n此地琵琶曾送客，只疑犹有别离声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日感怀 其一","author":"沈守正","text":"红树缘江寸寸秋，依刘王粲懒登楼。\n去年此日留京国，醉酒迷花别样愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日感怀 其二","author":"沈守正","text":"昨日行人唱出关，西陵回望即家山。\n宁知秋老千山外，日日思还不得还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日感怀 其三","author":"沈守正","text":"故人裁诗面不如，诗到怀时莲叶舒。\n此地岂真回雁处，至今未报一行书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日感怀 其四","author":"沈守正","text":"秋江潮落尽鱼虾，满市鯹风到日斜。\n转忆西湖莼再熟，紫丝牵出长冰芽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日感怀 其五","author":"沈守正","text":"帜列丹枫斗上春，灵山片席事如新。\n公超市罢门生散，南北东西止一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日感怀 其六","author":"沈守正","text":"何事群山不遍过，啸歌常在此山阿。\n十年屡见伤心事，恐有猿声惹泪多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日感怀 其七","author":"沈守正","text":"梧桐霜后扑人飞，十月谁家不捣衣。\n独坐空堂□失笑，无端小草不能归。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日感怀 其八","author":"沈守正","text":"半生落落负贫豪，万事如空问浊醪。\n纵使西风吹败叶，不教独奏郁轮袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"署中怀人十绝 其一 太常朱世其光祚江陵人有国士之感行藏未定缺焉抠衣","author":"沈守正","text":"何图脍凤屠龙手，佞佛翻经对九如。\n惭愧昔人千里驾，十年空羡武昌鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"署中怀人十绝 其二 编修钱受之谦益虞山人迹潜誉远是将出矣","author":"沈守正","text":"破龙山下惜居诸，子厌承明退著书。\n莫似茂陵常病渴，明光视草待相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"署中怀人十绝 其三 大理董崇相应举闽县人会为广州广文广人思之","author":"沈守正","text":"公门如市心如水，九鲤能如子也清。\n不识始平痴博士，试看南粤董先生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"署中怀人十绝 其四 大参曹能始学佺侯官人由蜀入庐有终焉之志令人感深","author":"沈守正","text":"无缘共听巴江雨，怀袖常存蜀道书。\n闻说庐山有新筑，虎溪远近定何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"署中怀人十绝 其五 学宪黄贞父汝亨同郡人蹭蹬宦海近始典文","author":"沈守正","text":"南国诸生旧在门，音徽未远典刑存。\n今朝捧檄新文格，夫子重来道逾尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"署中怀人十绝 其六 驾部孙子啬谷华容人家世张楚位不配才常怀邑邑","author":"沈守正","text":"公子勋名满冶城，逢人处处说鲰生。\n谗夫未便能投□，匣底鱼肠夜不平。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"署中怀人十绝 其七 郡守沈千秋圣岐乌程人病废往日风流都尽","author":"沈守正","text":"药椀残编寄寂寥，歌梁舞馆半沉销。\n豪华尽是伤心事，沈约于今果细腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"署中怀人十绝 其八 邑博朱公朗怀吴宜兴人俛首一博昂然有千古之气","author":"沈守正","text":"一毡未必联床席，万里俱堪托死生。\n寄与君家老公叔，何须着论博高名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"署中怀人十绝 其九 孝廉李长荇流芳嘉定人绝世雅流屡期不至惄如朝饥","author":"沈守正","text":"曾约秋风到石梁，桐翻一叶便如狂。\n即今木落山空矣，未卜何因见李郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"署中怀人十绝 其十 山人赵文度左华亭人小笔之美擅乎东南","author":"沈守正","text":"我来粉本满溪山，君住天都几日还。\n他日相逢应大笑，笑人云雾说荆关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀汪孟朴","author":"沈守正","text":"朝朝促膝犹嫌阔，岂料空山隔暮猿。\n薄俗五交多到溉，深情千尺只汪伦。\n海滨渐败椒兰气，宇内争蹊桃李言。\n莫以忧伤损肝胆，吾侪尚欲用乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午初度","author":"沈守正","text":"巳过纲成跃马年，纵逢唐举不轩然。\n逃名漫学墙东隐，小筑真疑岸上船。\n自叹半生惟砚北，畏闻两字在卢前。\n却如老大当垆妇，脂粉调人亦可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别王献叔上舍","author":"沈守正","text":"两年叨末契，忽别意如何。\n一榻吾难稳，千秋尔孰多。\n江山渐风雪，东北况干戈。\n相忆凭鱼腹，焉能似屡过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别王甥元建","author":"沈守正","text":"海内存知己，何人一脉联。\n可儿原足爱，似舅未云贤。\n萝薜宜加护，琴书莫浪传。\n长安多便羽，迟尔寄佳篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同罗玄甫章廷纶龚华茂集张石宗竹香斋时华茂将之练水","author":"沈守正","text":"竹下频留客，尊前且纵歌。\n莫言同调少，只怪别离多。\n凉月摇丛桂，轻烟澹薜萝。\n有情堪入赋，笔彩定如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张符九龚华茂小集南屏","author":"沈守正","text":"避俗依兰若，晴湖落照低。\n危峰苍欲滴，芳树绿初齐。\n流水乱人影，轻阴留鸟啼。\n诗肠堪鼓吹，何必定黄鹂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感 其一","author":"沈守正","text":"少年尝许足三冬，盘错孤根老未逢。\n自昔鸡群多笑鹤，何来犬格欲驯龙。\n功名暂且归公等，怀抱终□□阿侬。\n千古蓬茆原有事，休言得意尽歌橦。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感 其二","author":"沈守正","text":"□年海内共班荆，纵未相遭也识名。\n敢谓云霄皆□味，岂知寒热较阴晴。\n度阡越陌予心古，北斗南箕世态轻。\n散发海隅聊自适，虞翻原不托嘤鸣。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送柴式谷赴保定韩中丞幕 其一","author":"沈守正","text":"一官何拓落，又送子长征。\n雨湿袍襟重，秋随马足轻。\n别离多感槩，疆场兜戈兵。\n稳坐莲花幕，凌烟在笔耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送柴式谷赴保定韩中丞幕 其二","author":"沈守正","text":"念子能迂阔，谋生拙似予。\n老亲须禄养，游子莫居诸。\n世态浮云似，高名画饼虚。\n无言扬得意，方始识相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送柴式谷赴保定韩中丞幕 其三","author":"沈守正","text":"尚忆栽桐日，高枝巳拂云。\n故人皆雨绝，尔我又萍分。\n再刖羞自献，一鸣今属君。\n长安多美酒，解佩待殷勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江","author":"沈守正","text":"片帆晴日乱江流，顾此茫茫万顷愁。\n一夕悲欢真是梦，三年来往亦何求。\n山如有意增萧索，风怪无情不石尤。\n回首苍烟隐城郭，况堪重上仲宣楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山阴逢朱晋明","author":"沈守正","text":"山阴十月政秋冬，短鬓萧萧叹尔同。\n詶对三人俱苜蓿，别离八载总飘蓬。\n禹陵突兀名山古，大海苍茫灏气通。\n鸿雁两行俱旧好，可怜踪迹亦西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重至黄岩署中 其一","author":"沈守正","text":"一官何淡漫，去矣又还来。\n桐桂依然在，妻孥不我陪。\n荒城堆败叶，冷署等寒灰。\n更值督邮过，渊明真达哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重至黄岩署中 其二","author":"沈守正","text":"如斗二楹屋，那堪隤短垣。\n蜗牛开壁垒，野鸽长儿孙。\n对客时扪虱，呼僮且逐豚。\n独有西山色，氤氲□在门。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重至黄岩署中 其三","author":"沈守正","text":"台荡古奇胜，羽洞郁中蟠。\n共说仙为吏，难言味不酸。\n题评皆恶札，谭笑一儒冠。\n为爱江瑶柱，重来作此官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和吴司李老僧岩韵 其一","author":"沈守正","text":"我闻老僧岩，未到僧岩石。\n庄诵半游诗，恍若山行客。\n是日望舒满，笋舆戒发夕。\n素影流稻衣，晃皪骇绀碧。\n定在白马前，安问何年划。\n阅尽驱驰人，劳劳倦于役。\n闭口一无言，攒眉亦何益。\n会当往拜之，有癖自畴昔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和吴司李老僧岩韵 其二","author":"沈守正","text":"老僧说法本多门，一石峨然万象奔。\n却似息妫归楚日，开尽桃花总不言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和吴司李老僧岩韵 其三","author":"沈守正","text":"何事平畴见应真，似嗔饶舌走江津。\n若将移入生公座，应说点头予后身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪 其一","author":"沈守正","text":"衰苇败柳尽琅玕，孤客拥裘饱意看。\n只学袁安真简易，欲寻安道也艰难。\n霏霏着树催梅蕊，故故随风绕画栏。\n若谓撒盐差可拟，似来傲我水晶盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪 其二","author":"沈守正","text":"同云漠漠风凄凄，雪花如掌高复低。\n深山似欲过牛目，怒岭遥知绝马蹄。\n鸦背渐高栖不稳，雁群屡拆阵难齐。\n到门开雪今人少，纵令能来扫即迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪晴","author":"沈守正","text":"闭门不厌三尺雪，数日阴寒也快晴。\n乍见玉龙纷夭矫，只疑银海亘纵横。\n啁啾鸟鹊声如抃，班驳峰峦画不成。\n日暮流霞散余绮，明光白锦耀山城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和王献叔和雪诗谢其登楼之约兼志所感","author":"沈守正","text":"堆琼迭壁接雕栏，曾约重来语未寒。\n可惜酒人归太早，欲修往事兴先阑。\n空斋独对飘扬甚，快阁裁诗寂寞看。\n且待梅开披鹤氅，恐君为我费猪肝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独酌","author":"沈守正","text":"日车难系一年过，发短心长奈若何。\n作客自惭游日少，课诗争得似愁多。\n江乡漫说蹊桃李，野性惟思纫芰荷。\n雪色如银那不饮，醉龙无日不高歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕 其一","author":"沈守正","text":"逼除客子本多情，况复衰迟忧患萦。\n对酒忽成千里梦，思家真觉一官轻。\n先春鸟转频频语，小市人穷蹩蹩行。\n我亦酸斋无甚事，画灰听爆到三更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕 其二","author":"沈守正","text":"南北蹄轮路几千，江城岁暮雪连绵。\n不遑将母难忘叹，只似无家也度年。\n摩诘仆僮聊自遣，陶公诗酒且颓然。\n升沉过眼如陈历，明日迎春醉绮筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书至得含儿考信","author":"沈守正","text":"政当悠忽日，接得便鸿书。\n小子尚黄口，偶然上头居。\n老妻应一粲，新妇更何如。\n小战何足道，微名不可虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庚申元旦行春","author":"沈守正","text":"元日逢春春事初，舞倡伐鼓建旄旟。\n风条巳顺青祗令，灵雨刚先白鹿车。\n马上红装摇彩凤，辛盘冰缕荐江鱼。\n故乡此日豪奢甚，搔首何人奉板舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]