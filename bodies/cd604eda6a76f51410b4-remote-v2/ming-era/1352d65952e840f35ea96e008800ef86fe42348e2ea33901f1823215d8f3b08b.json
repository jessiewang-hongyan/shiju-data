[{"title":"送郑翁还广 其三","author":"王立道","text":"玉窖溪连海色新，罗浮山下别开春。\n南还更尽登临兴，莫遣清江空白蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑翁还广 其四","author":"王立道","text":"城头云向南飞远，城下车从北发迟。\n日暮红尘千里隔，晓星寒雨不胜思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿嵇川南母 其一","author":"王立道","text":"春暖瑶池花草香，金鱼珠履俨成行。\n一杯沆瀣千年祝，此夕为欢殊未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿嵇川南母 其二","author":"王立道","text":"翠槛红楼拂曙开，琼芝瑶蕊映金杯。\n方平遥向麻姑语，碧海扬尘今几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿嵇川南母 其三","author":"王立道","text":"北堂清昼蔼春晖，歌绕雕梁燕却飞。\n自有神仙携凤吹，不须令子舞莱衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿嵇川南母 其四","author":"王立道","text":"二月蟠桃亦放花，花枝烂熳赤城霞。\n逡巡已结千年实，更觅安期枣似瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿嵇川南母 其五","author":"王立道","text":"谁赠君家县圃图，紫烟白鹤列仙都。\n江妃鼓瑟湘娥舞，识得中间王母无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿嵇川南母 其六","author":"王立道","text":"庭前袅袅长春萝，堂上歌钟伴绮罗。\n闻说东邻有好事，金鞍银烛夜深过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有谷堂 其一","author":"王立道","text":"甲第新成高入云，风流廿载忆徵君。\n亭亭独鹤閒芳草，惟有诗书日夕闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有谷堂 其二","author":"王立道","text":"陶令归来看五柳，魏公老去有三槐。\n朱轮翠盖交生荫，须信当年不妄栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏夜崇雩坛陪祀 其一","author":"王立道","text":"中天星斗净瑶坛，夹陛旌旗四月寒。\n百辟自随千仗下，六龙犹在五云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏夜崇雩坛陪祀 其二","author":"王立道","text":"城南击柝夜如何，清跸初传万乘过。\n辇道逶迤多暝色，故开宫扇望星河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏夜崇雩坛陪祀 其三","author":"王立道","text":"野树苍苍散夕晖，天门西望翠华飞。\n微臣未解风雩乐，独咏皇恩泛马归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏夜崇雩坛陪祀 其四","author":"王立道","text":"双阙遥瞻龙虎旗，金根羽盖自葳蕤。\n君王不遣先除道，沾洒分明待雨师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏夜崇雩坛陪祀 其五","author":"王立道","text":"日毂雷行过紫都，蚩尤太一总先驱。\n圣世百神能受职，雨师何事尚天诛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏夜崇雩坛陪祀 其六","author":"王立道","text":"君王此日祷桑林，万井沉沉羽卫森。\n玉检泥封多秘祝，祠官偏识爱民心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏夜崇雩坛陪祀 其七","author":"王立道","text":"龙见修雩古有名，君王亲出为苍生。\n炉烟已结氤氲气，雨足森森散凤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王母歌 其一","author":"王立道","text":"汉宫初起集灵台，绛节飘飖羽扇回。\n云锦书传青鸟信，遥看阿母自西来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王母歌 其二","author":"王立道","text":"芳春花草满瑶池，忽忆麻姑海上期。\n欲问蓬莱水深浅，因风遥寄万年枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王母歌 其三","author":"王立道","text":"瑶岛分明近日边，周王元未解求仙。\n八骏崎岖云外路，空疑道里隔山川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王母歌 其四","author":"王立道","text":"云母屏前吹玉笙，侍儿犹识董双成。\n笑余学隐金门客，太似当年方朔生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王母歌 其五","author":"王立道","text":"昨夜重游汗漫归，依然戴胜发如丝。\n三千年一校仙籍，回指彭聃是小儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王母歌 其六","author":"王立道","text":"玉洞桃花引去津，鹤声犹似隔红尘。\n自嫌王烈无仙分，乞得素书翻与人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月晦日出郊游衍偶诵唐人诗三月正当三十日因用为起 其一","author":"王立道","text":"三月正当三十日，又骑款段出城南。\n欲赋送春诗未得，柳溪花径遍相探。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月晦日出郊游衍偶诵唐人诗三月正当三十日因用为起 其二","author":"王立道","text":"三月正当三十日，夕阳欲尽乱啼鸠。\n榆钱铺地应无数，买得春光几许留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月晦日出郊游衍偶诵唐人诗三月正当三十日因用为起 其三","author":"王立道","text":"三月正当三十日，把酒题诗兴不悭。\n汀洲芳草不归去，留得春光总是閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月晦日出郊游衍偶诵唐人诗三月正当三十日因用为起 其四","author":"王立道","text":"三月正当三十日，莺声如倦复如愁。\n绿杨拂地花成雪，断送春风也白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月晦日出郊游衍偶诵唐人诗三月正当三十日因用为起 其五","author":"王立道","text":"三月正当三十日，馀春零落入风尘。\n閒过岁月不知老，失却莺花转觉贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月晦日出郊游衍偶诵唐人诗三月正当三十日因用为起 其六","author":"王立道","text":"三月正当三十日，一春又向客中过。\n薜萝已负沧洲约，騕袅空怜白玉珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月晦日出郊游衍偶诵唐人诗三月正当三十日因用为起 其七","author":"王立道","text":"三月正当三十日，落花寂寂对閒门。\n莫言春尽浑无事，分菊移葵事更繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南村漫题","author":"王立道","text":"绿野风烟入望频，柳溪松坞别藏春。\n莫言未识南材路，逢着桃花试问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梅","author":"王立道","text":"独树离奇带雪看，小窗应绝胜江干。\n竹床纸帐成幽伴，冷蕊疏枝几岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻人氏五十寿诗 其一","author":"王立道","text":"生年半百混樵渔，教子还看上石渠。\n欲舞绛衣应未得，却凭丹凤早衔书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻人氏五十寿诗 其二","author":"王立道","text":"青山尽日独支颐，白首犹堪一卷师。\n八十年来閒击壤，儿童齐和紫芝词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏阁中芍药 其一","author":"王立道","text":"缭绕朱栏倚日边，葳蕤红药露华鲜。\n蓬瀛本自多奇卉，况尔栽培更有年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏阁中芍药 其二","author":"王立道","text":"琼干旧分天上种，瑶葩偏向夏初开。\n侍臣草罢明光诏，独傍清阴过碧苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题惜花美人图","author":"王立道","text":"满苑芳菲映晓妆，折将春色媚高堂。\n一声啼鸟且归去，秪恐清露沾衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8116,"sha256":"ed4816f