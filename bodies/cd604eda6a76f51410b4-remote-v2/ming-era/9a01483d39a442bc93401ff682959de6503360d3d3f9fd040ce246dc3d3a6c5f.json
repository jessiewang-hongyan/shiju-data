[{"title":"四景画为朱天锡题 其四","author":"张宁","text":"雪压危桥骑不前，万山寒寂树沉烟。\n逶迤曲磴松关静，应有閒人对鹤眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8050,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画秋林独步图为崔廷佩题","author":"张宁","text":"山共人閒水共清，满林松籁助吟声。\n十年中外红尘骑，何似斜阳策杖行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8051,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画雪景二首 其一","author":"张宁","text":"一斗寒酤数尾鲜，只应多费草书钱。\n羊羔饮唱真成俗，却笑袁安忍饿眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8052,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画雪景二首 其二","author":"张宁","text":"隔桥沽酒傍船鱼，风味寒酸趣有馀。\n醉后和衣不成寐，半床微月照残书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8053,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画菜","author":"张宁","text":"平生肉食惭无补，见画令人一怅然。\n祝鲠无人供膳缺，老怀偏与此相便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8054,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"莲叶舟","author":"张宁","text":"莲落红衣玉露秋，萧萧鹤发映中流。\n若非太华峰头种，那得乘风稳似舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8055,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鸲鹆","author":"张宁","text":"微微初日转花梢，流丽声随雨露高。\n见说群飞不踰济，鲁经何事纪来巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8056,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和沈石田写生牡丹诗意","author":"张宁","text":"画堂红酒滞清欢，折得馀芳兴已阑。\n老去不堪春似梦，笑图倾国贮吟坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8057,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画四首 其一","author":"张宁","text":"龙虎风云际盛时，明良何事抗相辞。\n无端尽学巢由去，千古纲常欲付谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8058,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画四首 其二","author":"张宁","text":"天潢障缺落浮沤，混作人间万水秋。\n一自南华声漱起，至今汗漫未回流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8059,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画四首 其三","author":"张宁","text":"群后从容揖逊同，鳏夫一举已徵庸。\n当时谟典应难考，直欲西寻太史公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8060,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画四首 其四","author":"张宁","text":"内史功名振士林，东封车驾从登临。\n如何早拙催科政，不忘艰难畎亩心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8061,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂画四首 其一","author":"张宁","text":"春山无伴偶相迎，清话投机晚未行。\n却笑会稽谈富贵，不知愚妇已忘情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8062,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂画四首 其二","author":"张宁","text":"独树溪边石藓斑，碧山猿鸟共秋閒。\n怪来翘首斜阳外，情绕湘云渭树间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8063,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂画四首 其三","author":"张宁","text":"閒看图画想离骚，香草萎垂半野蒿。\n何事春风太相误，却教荆棘出林高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8064,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂画四首 其四","author":"张宁","text":"云深无处认岩扉，童子閒行鹤未归。\n独步空林望斜日，满身松露湿秋衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8065,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"芭蕉美人","author":"张宁","text":"一点蕉红若展丹，东风先自暗凋残。\n满怀都是伤春思，綵笔无题绿叶乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8066,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吕纪白鹭图","author":"张宁","text":"万里江湖钓弋稀，懒随鸥鸟候忘机。\n还应静避风涛恶，共立苍茫暮不飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8067,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"张复阳画","author":"张宁","text":"山凝岚气树凝烟，宿雨才收社后天。\n山下人家夜留客，开门花落满篱边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8068,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"四松卷","author":"张宁","text":"手植苍松今几时，空亭面面绿阴滋。\n半临山谷半溪水，雪月风烟各自宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8069,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"瀹雪诗","author":"张宁","text":"总是金山与惠山，源流无不历尘寰。\n从来天一清凝味，只在陶生茗瀹间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8070,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王舜耕画为雪江题","author":"张宁","text":"春愁满眼殢昏昏，不是行人亦断魂。\n彷佛幽居风雨旦，梨花落尽未开门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8071,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"刘松年山水二幅 其一","author":"张宁","text":"红树青山满眼秋，江南江北路悠悠。\n一行归雁无书信，倚尽斜阳不下楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8072,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"刘松年山水二幅 其二","author":"张宁","text":"春色催人不耐閒，危桥曲涧远跻攀。\n却嫌昨夜东风雨，漂得桃花满钓湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8073,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"美人图二绝 其一","author":"张宁","text":"少女风微柏子香，夜深吹透紫霓裳。\n缑山月落春回首，应悔吹箫引凤凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8074,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"美人图二绝 其二","author":"张宁","text":"月明如水溢秋波，手撚花枝夜思多。\n玉魄冰魂无著处，欲随青鸟扣嫦娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8075,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪松","author":"张宁","text":"蓝关疋马瘦停鞍，羝窟天荒汉节残。\n一纸家书人不到，开封犹带旧衣寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8076,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为月塘上人题赵松雪兰杭人有卖兰为业","author":"张宁","text":"楚畹萋萋草共生，吴城日日卖花声。\n离骚读尽无人问，閒倚萧斋看落英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8077,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画竹树图送谭大尹","author":"张宁","text":"古楠幽竹海山秋，一片离怀共水流。\n纵尔抡材入廊庙，也应不忘九年游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8078,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题菊二首 其一","author":"张宁","text":"清劲姿标浅淡黄，幽篁古石共冰霜。\n生来不是春园物，老向枯枝死亦香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8079,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题菊二首 其二","author":"张宁","text":"白石尘消苦竹生，一枝秋色淡无情。\n幽居莫作芳菲看，晚露寒霜老更清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8080,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画景","author":"张宁","text":"千山晴翠湿春云，万树凝风昼不分。\n欲趁山童入深处，落花填径鹿成群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8081,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画登高望远图","author":"张宁","text":"独上危崖望大荒，老怀应不为重阳。\n白云红日频回首，萧飒西风两鬓霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8082,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题便面山水","author":"张宁","text":"斜阳晚色满沧洲，红叶飞随水乱流。\n惆怅隔江人不见，西风谁汎木兰舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8083,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪景为沃文裕题","author":"张宁","text":"玉山银海夜如年，寂寞山阴访戴船。\n老病不禁溪上冷，放容窗月伴吟眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8084,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画匡庐春雨图题赠医士","author":"张宁","text":"密树丛篁满石田，匡庐春雨杏花天。\n不知茆屋无人处，看到灵枢第几篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8085,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送庄汝恭","author":"张宁","text":"海郭西风野色昏，飘飘鸣雁欲辞群。\n满林都是秋来树，留得春松折赠君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8086,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画雪蕉","author":"张宁","text":"风送飞琼拂地垂，映窗烟绿半离披。\n清贫不共繁华改，犹记袁安冻饿时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8087,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"董源画","author":"张宁","text":"金鳌玉龙蟠作堆，老树屈铁泉鸣雷。\n舟轻水急云荡漾，彷佛使槎天上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8088,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戴文进小景二绝 其一","author":"张宁","text":"萧萧葭菼著霜稀，秋水连天有雁飞。\n怅望溪山旧人去，一船斜日映愁归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8089,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戴文进小景二绝 其二","author":"张宁","text":"忙处人多静处稀，芦花风急梦将飞。\n莫教一枕黄昏雨，直待邯郸觉后归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8090,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为秋江题姚公绶竹","author":"张宁","text":"本是飞仙号懒仙，研池日日起风烟。\n何人为惜清秋景，留伴山房看雨眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8091,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题蒋文藻画为丁文礼","author":"张宁","text":"荒山亭馆客游稀，瀑布无声野鸟飞。\n愁绝梅花庵外路，年来风景似邪非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8092,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"松鹤图","author":"张宁","text":"风送天声月影寒，玉箫吹裂缟衣翻。\n巢居苦爱云松伴，自抱孤琴对画弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8093,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画二首 其一","author":"张宁","text":"雨晴芳渚野凫飞，杨柳条长荇叶肥。\n閒展蓬窗看溪水，春痕渐上钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8094,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画二首 其二","author":"张宁","text":"雪满孤山雨满楼，青春花鸟淡相留。\n年芳似旧故人少，默倚阑干悔昔游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8095,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"古宫妆待月图","author":"张宁","text":"坐倚危栏一倍思，月光初上桂花枝。\n可怜歌舞千门夜，不信无情默对时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8096,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题节庵梅","author":"张宁","text":"冷风吹雪下层霄，积满西湖第六桥。\n野鹤未归人独坐，不胜清恨许谁招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8097,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题月林清影图","author":"张宁","text":"澹澹苍烟破玉蟾，隔林清影落疏檐。\n从今留作黄昏伴，分付山童莫下帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8098,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画","author":"张宁","text":"十年京国念山林，一夜趋朝一夜心。\n今日还家逢老病，画中风物尽知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8099,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题张南山画","author":"张宁","text":"胸中丘壑自分明，草笔临池一肆情。\n不是丹青旧家法，古来能事贵天成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8100,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画","author":"张宁","text":"下极黄泉上碧空，鸟飞不到碍云峰。\n桃花流水知何处，野鹿闻笙出洞中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8101,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"一笑山小飞来峰","author":"张宁","text":"飞来峰在西湖上，何事飞来尺地间。\n只恐飞来又飞去，小门风雨夜先关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8102,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"便面为沃文裕题","author":"张宁","text":"买断青山无别主，结庐惟许自幽栖。\n门前花落呼童扫，始信春残鸟不啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8103,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"一笑山辞","author":"张宁","text":"邈舒啸兮山间，宛游息兮幽閒。\n齐绮褐兮无斁，忘藿肉兮加餐。\n滴花露兮月午，宿暮雨兮空岩。\n画烹茶兮烟远，夕往颊兮云还。\n濯莲池以舒思兮，步兰坡以怡颜。\n卓笔盘陀兮研清涟。\n挹苍玉之佳爽兮，眄芙蓉之巑岏。\n怅昔游之既远兮，念长别而怀惭。\n晤无由而忽至兮，安毕景于忘言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8104,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"佩兰辞","author":"张宁","text":"夫何胜地兮，独当此茂辰。\n百卉竞发兮，群动趋新。\n积李缟夜兮，崇桃炫晨。\n纷色臭之投时兮，又蹊径之同人。\n蹇予行之无从兮，切独怀夫幽真。\n弹吾冠以陟冈兮，振吾衣以扬尘。\n拾遗芳于宿莽兮，仍故素于荒滨。\n缉华英以为佩兮，袭馀香以垂绅。\n亦旖旎而葳蕤兮，既绸缪而因循。\n谅易词之不可以忞忞传兮，服楚言而恂恂。\n弦清琴以和鸣兮，邃虚室以求伦。\n挹信美之自中兮，庶音好之弗湮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8105,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题莘叔耕山水图","author":"张宁","text":"山出云兮周垣，水洄风兮双弹。\n树交维兮帐羃，猿鹤语兮歌繁。\n漱清蒙兮酎饮，撷芳实兮珍餐。\n缉青蒲兮盛服，枕白石兮重裀。\n纷彼美兮难即，易予素兮聊安。\n怀良朋兮不至，胡一来兮遄还。\n念蓬累兮终陋，感匏系兮长叹。\n谅馀衷之耿耿兮，终吾遇而盘桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8106,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五噫薤露歌","author":"张宁","text":"薤上露，何易晞。\n人生脩短何由期，噫。\n黄金如山不如泥，噫。\n长夜漫漫路逶迤，噫。\n北邙山头草离离，噫。\n古人去兮今人悲，噫。\n薤上露，何易晞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8107,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"牧牛词","author":"张宁","text":"桑树阴阴啼布谷，野草青青隔湖绿。\n驱牛渡水湖南牧，中流水深莫放犊。\n蒲草缰绳槿树鞭，横骑牛背稳如船。\n但令草长牛常饱，不怕公私田不了。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8108,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"叶太守丛竹图","author":"张宁","text":"斐君子兮湘川，冠绿玉兮乘云。\n軿俨若来兮既遇，忽轩举兮蹁跹。\n风萧萧兮雨歇，月皎皎兮山间。\n怅幽贞兮不见，渺音节兮云天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8109,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王孟端烟雨竹石正统十四年为许竹窗题 其一","author":"张宁","text":"西风萧飕白石寒。\n鼪鼯昼啼榆叶残。\n沅湘归客望江干。\n九疑云路何漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8110,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王孟端烟雨竹石正统十四年为许竹窗题 其二","author":"张宁","text":"美人远我天一方。\n何以遗之双琳琅。\n黄云蔽天日无光。\n纷纷雨雪濡衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8111,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"种茄词为刘侍郎作","author":"张宁","text":"去年种茄时，雨水伤茄枝。\n今年卜蛙声，茄菜又不宜。\n城中薪米贵如玉，官府虽轻私债促。\n但愿田神作主张，累累满圃皆成熟。\n岂不见东家富贵厌炮烙，醉来仍索园中藿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8112,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"廷器亲家索画梧竹图成系之以词","author":"张宁","text":"高居寂阒兮地迥春深，时物竞发兮草蔓交侵。\n兰葳垂而不见兮，鞠迟暮而湮沉。\n松偃蹇而蔽壑兮，梅槎牙而当岑。\n陟高冈以纾眺兮，越陂陀而幽寻。\n将息迹以灭影兮，胡跫然乎空谷之音。\n忽流眄夫碧梧之茏葱兮，翳翠竹之萧森。\n笋落箨以成竿兮，条挺秀而增阴。\n搴群芳而独伍兮，蠲众迹而孤吟。\n招清风于予袖兮，邀明月于余襟。\n执高致以自适兮，谅卒岁而同心。\n嗟庶植之殊情兮，纷纤丽而妖淫。\n或先时而忽往兮，或后时而乖于今。\n芳华与土壤而同归兮，硕大又匠石之难禁。\n羌是物之具美兮，永盘衍乎丰林。\n若夫通方贡兮侪南金，荐郊庙兮偶球琳。\n列匏管兮为瑟琴。\n是固造物者之定分，乌足以状是物之登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8113,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠文林翰林编修陈公哀辞缉熙之父","author":"张宁","text":"余尝息御于苏台兮，寻弭节于辽阳。\n徵遗铭于幽竁兮，访故事于遐荒。\n闻先生之少孤兮，形影相吊而无亲。\n攀千仞而独上兮，如一发之引千钧。\n亦既识夫康庄兮，坦顺适乎前路。\n握瑶瑜以自好兮，力衔策而疾步。\n世方以其事为事兮，夫何独先生之好修。\n彼将絷凤凰以司晨兮，扰骐麟以曳辀。\n夫既知其不可兮，姑将反是以求道。\n何枘凿之终不可以相入兮，又竿瑟之异好。\n返兰舟于漭漾兮，回素辔于寥廓。\n苟初心之未渝兮，虽隐约其奚怍。\n盖智者不訾予以迷邦兮，而枉者将罪予以怀璧。\n嗟厉阶其孰基兮，而祸本其谁植。\n女入室而见妒兮，不嫁何尤。\n士入朝而见嫉兮，不仕何忧。\n岂刚者恒足以致缺兮，而美者必于致毁。\n璞玉之必于见剖兮，而渊珠之必于见取。\n胡为乎煽烈火于馀烬兮，加矰缴于伤羽。\n彼苍苍者其广大兮，而㷀㷀之谓何。\n匪予行之当是兮，谅矢心而靡他。\n行遥遥其日远兮，心耿耿而伤悲。\n羌去故而即新兮，念长往而不来。\n旦引领于国门兮，夕凝睇于桑梓。\n登高丘而望远兮，或居閒而独语。\n曾岁月之几何兮，倏少壮之代谢。\n憯辽鹤之夙吊兮，惊楚鵩之集舍。\n魂杳杳以无归兮，魄沉溟而忘故。\n渺尘海之不可以极兮，又云关之不可以经度。\n风凄凄其昼吟兮，雪缤纷其夜零。\n日卓午而不明兮，草逢春而不青。\n忽天宇之开霁兮，仰恩光之下泽。\n慨仁者之有后兮，叹生死而肉骨。\n驾灵舆于万里兮，复此故丘。\n贲徽名于九原兮，荣溢东州。\n方其阽身就死而无所恤兮，又孰念夫孤嫠。\n兴坠继废而人所不亿兮，天实为之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8114,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"满庭芳 送欧掌教","author":"张宁","text":"红杏花深，青芹香汎，古坛幽泮生风。\n纵横礼乐，人在舞雩中。\n窈窕门墙数仞，相逢处，衿佩匆匆。\n因何事，琴停瑟间，嘉会又成空。\n叹离怀宦况，天涯海角，渭北江东。\n且重斟别酒，慢挂征篷。\n今夜扁舟泊处，斜阳外，数点归鸿。\n黄昏后，半醒半醉，清梦两相通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8115,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"玉烛新 送周大尹","author":"张宁","text":"萧萧风雨歇，陡暑老凉肥，半清时节。\n画船摇飏，江风澹、草青蘋黄叶。\n仙郎去也，怅花县，清琴间绝。\n凝望处，万里烟霄，人在九重天阙。\n南云北斗双凫，隔白叟黄童，望归心切。\n功名激烈。\n漫懊恼，枳棘鸾凰栖屑。\n东风漏泄，看紫诰文衣旌别。\n壶浆候，春水帆归，明年三月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8116,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"苏武慢 金兰","author":"张宁","text":"丽水真精，南州高品，流落楚皋湘岸。\n翠帐销残，带鱼粉碎，写不尽灵均怨。\n莺羽潇潇，菜花掩映，黄瘦过初相见。\n记当时，传报泥缄，早已遂同心愿。\n似谁将，三径寒芳，满林枯叶，把九畹风光换。\n从今契合，世路交情，拚一笔都勾断。\n操变西音，佩纫中色，郁鬯酒堪同荐。\n尽教人，东抺西涂，都不改旧时疏淡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8117,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]