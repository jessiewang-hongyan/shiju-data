[{"title":"己酉夏观察金公有祝釐之行余卧病弗获祖之江干每枕上有怀辄得诗一二句积之缀成四首用当骊歌 其二","author":"林熙春","text":"春来强半闭岩阿，此日能忘发啸歌。\n将母尊前分玉露，趍君阙下动金珂。\n云龙九五腾玄极，海鹤三千度绛河。\n前席祝釐应有问，愿陈民瘼近如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己酉夏观察金公有祝釐之行余卧病弗获祖之江干每枕上有怀辄得诗一二句积之缀成四首用当骊歌 其三","author":"林熙春","text":"遭逢绣斧祝乘舆，多病难遮使者车。\n岭月便随双雀舫，宫云长护九龙居。\n南天霞灿冈陵巩，北极秋高气色舒。\n仙掌遥知茎露满，可无杯沥及相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己酉夏观察金公有祝厘之行余卧病弗获祖之江干每枕上有怀辄得诗一二句积之缀成四首用当骊歌","author":"林熙春","text":"天外几年销瘴疠，云中五色拥旌旄。\n谁游珠海甘茹檗，独上瑶池为献桃。\n万里肯辞王事苦，九重宁负使臣劳。\n未央宴罢君恩渥，当有彤弓属锦韬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送柯心邃从金观察入贺访禁方","author":"林熙春","text":"八千里外挟青囊，特入神州访禁方。\n帝问向誇传扁鹊，皇华今幸附腾骧。\n满腔浑抱人心活，三祝还祈圣寿康。\n游罢上池歌易水，可无一勺慰沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送孝廉王浙泉北上二首 其一","author":"林熙春","text":"有美青萍客，翩翩作颂才。\n凭陵蟠赤海，睥睨筑金台。\n云拥双岛去，泥衔五凤来。\n不须尧白首，亲舍接蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送孝廉王浙泉北上二首 其二","author":"林熙春","text":"以我高阳侣，期君济世才。\n惊传鹦鹉赋，信步凤凰台。\n北望青天近，东浮紫气来。\n长杨如献纳，愿许辟污莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送经历李毓岩入觐","author":"林熙春","text":"建安才子舄翩翩，尊酒韩江怆别筵。\n两瑟阳春推国手，一帘明月见家传。\n羊肠勿惮八千里，凤翮还归尺五天。\n岂是风尘犹宦拙，丝纳遄发衮衣前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀朱存敬并申祝意","author":"林熙春","text":"海上当年赖壮猷，天门青琐仰前修。\n因依棠树遥相忆，欲寄梅花末自繇。\n幸有凤毛堪系简，况逢鹤算更添筹。\n武彝自是神仙宅，碧水长清映白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送比部张元辉还朝时己推滇观察候命","author":"林熙春","text":"汉庭仙吏使槎回，白露清樽此日开。\n万里骅骝将命去，九霄丹凤送书来。\n且游名岳多怀吐，莫负春风两鬓催。\n当宁每思谁借箸，天南还仗出群才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏仲园豆盛熟每饭不彻戏示埈儿曰朝朝一味豆尔能偶乎埈儿谢不敏解目园中为余偶者四因成四绝 其一","author":"林熙春","text":"朝朝一味豆，日日寸心葵。\n每抱丰年愿，乾坤未有涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏仲园豆盛熟每饭不彻戏示埈儿曰朝朝一味豆尔能偶乎埈儿谢不敏解目园中为余偶者四因成四绝 其二","author":"林熙春","text":"朝朝一味豆，灼灼满园萱。\n无限春晖思，何堪对酒尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏仲园豆盛熟每饭不彻戏示埈儿曰朝朝一味豆尔能偶乎埈儿谢不敏解目园中为余偶者四因成四绝 其三","author":"林熙春","text":"朝朝一味豆，对对几缸兰。\n风动香逾远，不禁人倚栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏仲园豆盛熟每饭不彻戏示埈儿曰朝朝一味豆尔能偶乎埈儿谢不敏解目园中为余偶者四因成四绝 其四","author":"林熙春","text":"朝朝一味豆，岁岁两株松。\n水满亭前镜，宁知鬓似松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"封公曾缵槐寿","author":"林熙春","text":"久抱明珠懒暗投，凤毛千仞兴全收。\n黑头正喜冠加豸，稳步无劳杖刻鸠。\n使者绣衣嵩少出，老人紫气岭南浮。\n悬知骢驭澄清急，遥借三花当酒筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题孝廉杨寄实凝翠图","author":"林熙春","text":"华堂早擅金银气，画里楼台得似君。\n曲径花深常带雨，方塘水暖每生云。\n潭龙吼自书声起，海鹤惊从瑟韵闻。\n旦夕上林分夜色，只留紫翠锁氤氲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再次韵二首并趣季实计偕 其一","author":"林熙春","text":"鲤庭桃李是前身，凝翠园开种紫莼。\n松桂动时摇月影，水云停处见天真。\n金城争献千般秀，彩笔曾千万象春。\n翠色不随秋色攺，一回花发一回新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再次韵二首并趣季实计偕 其二","author":"林熙春","text":"家世三朝捧御章，乾坤待尔定行藏。\n山中文豹浑身雾，天上神驹满足霜。\n莫为池塘耽李杜，须教怀抱答虞唐。\n八千里外扶摇远，献纳无迟达未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余与畅梧兄友有年最称莫逆己酉兄夫妇同化心甚伤之时余以病弗及临唁间后漫赋挽章二首用致哭私 其一","author":"林熙春","text":"昔年梅墅锁研旧，羡尔交情久益新。\n蚤擅雕虫仍数厄，因贪训鲤更家贫。\n那知鸾凤星辰化，顿令龙蛇卜谶真。\n即使过君终挂剑，子牙能不转伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余与畅梧兄友有年最称莫逆己酉兄夫妇同化心甚伤之时余以病弗及临唁间后漫赋挽章二首用致哭私 其二","author":"林熙春","text":"东山乔木郁宗祊，世德堂前玉树生。\n何事君心抛凤羽，可教吾党失莺鸣。\n魂移泽畔音容杳，影吊天涯涕泪横。\n五色伫看千仞起，九原应慰一生盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送谢广文归","author":"林熙春","text":"桥门讲席却称谁，江左传家足间奇。\n玉简正看翔凤羽，金台何事妒蛾眉。\n著书久定修齐计，作赋翻从董贾移。\n愧我闭关因病懒，忽闻归棹独凄其。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送广文萧宾竹归将乐 其一","author":"林熙春","text":"倡道东来欲订顽，昌黎一脉可跻攀。\n青藜光照清华地，玄草声传霄汉间。\n凤渚莫缘开虎观，龙池自是接龟山。\n归与定作千年计，岂肯浮生半日閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送广文萧宾竹归将乐 其二","author":"林熙春","text":"十载褰帷贲海濆，瀛州瑞色有馀芬。\n汉家长者频过我，鲁国日生半事君。\n黑发悬车师道重，青山纳履主恩存。\n时人莫讶衣裘敝，剑气长看绕白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松山图寿孟善弟","author":"林熙春","text":"郁郁苍松万仞山，栖迟何计可跻攀。\n乾坤一局高人榻，坐对松山尽日閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送浚川全山人归镛并怀萧广文五绝 录一","author":"林熙春","text":"一别年经二十春，相逢转觉白头新。\n入门骤讶君何处，犹是当年畏垒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送浚川全山人归镛并怀萧广文宾竹五绝 其二","author":"林熙春","text":"漫学烹鲜成底事，间关千里慰吾思。\n衡茅匝月茶为酒，一话一更未有涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送浚川全山人归镛并怀萧广文宾竹五绝 其三","author":"林熙春","text":"年来懒病频疏客，诗思多君发兴长。\n闭阁不禁炎夏苦，闻君诗思转凄凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送浚川全山人归镛并怀萧广文宾竹五绝 其四","author":"林熙春","text":"惜别韩江祗浊醅，渭城赓唱莫相催。\n愧予藿食无堪赠，聊折荷蕖当岭梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送浚川全山人归镛并怀萧广文宾竹五绝 其五","author":"林熙春","text":"归欤强自隐岩阿，五采凤雏莫浪过。\n为问子云萧祭酒，开来近日更如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和德进端一纳凉见怀之作","author":"林熙春","text":"草堂愁暑雨，诗到思翻凉。\n水动鱼深逝，风来花更香。\n园林成独乐，鸥鸟浑相忘。\n君过茶为酒，何须问醉乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庚戌除夕","author":"林熙春","text":"无计回天听，栖迟十五春。\n今宵尘垢净，明日岁华新。\n未献南山颂，先开北海樽。\n庚星留德曜，长照八千椿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛亥元日","author":"林熙春","text":"忽听鸡鸣曙色寒，辛年辛日荐辛盘。\n乾坤逸我为亲老，六十催人可自宽。\n汤饼幸来联棣萼，镃基犹望接鹓鸾。\n小臣祗向朝阳祝，华发任从镜里看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"修玉简塔完登眺漫赋","author":"林熙春","text":"岭外岧峣地，春游亦壮哉。\n南原标玉柱，北望映金台。\n七级峥嵘复，三朝象纬恢。\n黄堂增几案，赤县仰崔嵬。\n益显文星耸，先占泰运培。\n初临愁雾塞，少选幸云开。\n父老供新醁，山灵辟旧苔。\n步从天上起，声自谷中来。\n满目峰如画，凝眸海一杯。\n石牛凭去住，穴虎任徘徊。\n甘露微玄贶，仙踪长绿莓。\n慈封瞻涕泪，亲舍接蓬莱。\n纵切登高兴，谁堪作赋才。\n但期鱼鳄徙，凤啸应三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五老诗","author":"林熙春","text":"华堂春树开花日，梓里翩翩集寿筵。\n况复人间称五老，真云天上列群仙。\n义方特贲龙章重，缝掖均垂鹤算年。\n更有慈亲昆弟者，宁无似勫外甥焉。\n南山星聚毛成雪，北海尊开酒若泉。\n白鹿洞中归白社，青牛关外问青田。\n凤城自昔誇灵异，鸠杖于今羡偓佺。\n不是丹头传九返，胡从黄发探三玄。\n周旋尚健依绳墨，谭吐犹欢说圣贤。\n小子荆班诸客侧，吾兄莱舞大人前。\n曾玄共祝如冈阜，淇澳频歌当管弦。\n菽水可?今日兴，八千春色绕云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游凤凰塔谒郭祠","author":"林熙春","text":"朝阳栖凤处，砥柱障川东。\n影落惊波鳄，光延接彩虹。\n蘋蘩思北斗，桃李忆春风。\n无限登临者，千年仰令公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答龚润寰","author":"林熙春","text":"归来暌别怅如何，燕市当年意气多。\n我已有心依菽水，君今何事叹嗟跎。\n凤雏自是毛俱奋，鸥侣犹然鬓未皤。\n国是纷拿殊未了，可容紫帽发长歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郭公祠 其一","author":"林熙春","text":"昌黎一脉几千年，橡木繁花气色鲜。\n可是有能绳北斗，擎天玉柱九霄县。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郭公祠 其二","author":"林熙春","text":"郁郁棠阴海上岑，扶筇十里足行吟。\n凤皇塔上弦歌沸，犹忆当年露冕心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢将乐缙绅贺六十","author":"林熙春","text":"忆昔操刀领上游，百年虚度几春秋。\n幸从玉简依云住，梦到金华泛月游。\n自愧一乡鸠刻杖，何劳千里鹤添筹。\n衡茅己就疏狂癖，海上遥瞻紫气浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长至送张杳宇贺六十回镛","author":"林熙春","text":"知非又度十年春，杖履遥询放逐臣。\n三月论心多眷恋，一阳分手倍精神。\n柳条渐吐青山色，梅蕊争研白发新。\n此去君家腾剑气，龙光射斗自振振。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢黄全二生贺六十兼致郎君","author":"林熙春","text":"二十年前绾玉华，于今劳苦问天涯。\n耕田自作山中计，畏垒曾从海上誇。\n洞养芝荂频绚彩，溪培桃树更开花。\n一经自是青云业，凤翥翩翩即大家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛亥守岁","author":"林熙春","text":"八千里外寅前夜，六十年间雪后春。\n对酒莫辞今夕醉，明朝又是岁华新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛亥守岁二绝 其二","author":"林熙春","text":"频年除夕犹今夕，此日良宵异昔宵。\n有客问予何以异，酒垆五世祝三偷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬子元日","author":"林熙春","text":"昨夜犹然刚六十，五更六甲忽重逢。\n燕台岂意劳推毂，驹隙何心叹转蓬。\n椿树百年几九帙，椒花一日胜三公。\n自知聚首皆明赐，海上嵩呼愿岁丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侄圻之南雍诗以勉之","author":"林熙春","text":"老大春来叹索居，欣逢小阮赋公车。\n路从庾岭梅花发，天近杨州箭竹舒。\n结驷莫云惊四坐，临桥且就足三馀。\n殷勤杯酒江干祝，珍重千金慰倚闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李汉翀回镛汉翀工诗画为两峰先生孙","author":"林熙春","text":"大父久经过偃室，梧孙千里问暄寒。\n昔年澡发犹骑竹，今日论心数染翰。\n海上青山任寄傲，词中白雪可胜摊。\n君归牛角奚囊满，莫把侯芭问字看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬子除夕同叔弟守先墓","author":"林熙春","text":"昨年除夕椿犹茂，今岁今宵独怆心。\n兄弟莫缘留去腊，山川何处聆遗音。\n坐来夜半思逾剧，目断一丘泪不禁。\n徙倚达朝修展谒，日边瑞色起遥岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸丑元日","author":"林熙春","text":"日边瑞色起遥岑，一泪一收慕转深。\n祗向松楸勤虎拜，无从趋步听龙吟。\n幸逢天子朝阳会，况复云孙祝岁临。\n但愿山灵频孕秀，可能奕世绂缨簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵寄答李司勋人日之作","author":"林熙春","text":"年来底事赋清流，读易陶园岁几周。\n天地风尘还自语，弟兄簪笏久同抽。\n侧闻天子频招隐，尽道山公尚壮猷。\n千里曲江传胜事，宁知褊性合栖幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送堪舆饶少峰归豫章","author":"林熙春","text":"廿载南游访十洲，半肩剑履遍瀛州。\n繇来世族推高第，直为亲茔下一筹。\n云锁丝纶腾白鹤，江环风木卧青牛。\n渭城何计迟桥梓，绿蚁尊前水驿舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送司理黎中崙还豫章","author":"林熙春","text":"明时仙吏最称谁，满座红莲沸口碑。\n凤峤向来推骏足，燕山忽己妒蛾眉。\n频年劳瘁真堪涕，五色丝纶慰所思。\n况复龙光终射斗，无云式谷恋东篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀黎丽阳谏议因季弟司理却寄以识遐思","author":"林熙春","text":"昔年趍步直承明，此日稀闻玉佩声。\n耕凿歌天宁自放，星辰远斗半同盟。\n韩津有弟称鸠爽，汉迢须君作凤鸣。\n逋客祗知笼纵鹤，黎醇焉忍负苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将乐杨贞母古风一首","author":"林熙春","text":"瞻彼蕙兰芬，灼灼竞桃李。\n当春谁不艳繁华，有时倏忽随霜靡。\n只有南山顶上松，历尽寒冬节不毁。\n自古风人咏柏舟，于今贞妇差足拟。\n贞妇当年初嫁时，夫心愿托梁鸿轨。\n讵云变起不须臾，白日黄泉路便徙。\n剖破菱花无合期，掩玉埋香嗟已矣。\n青天寥廓不可呼，几番欲赴青丘里。\n转思夫死宜从夫，从夫慷慨徒死尔。\n藐诸咄咄不堪闻，母死儿孤更何以。\n况复高堂白发双，朝夕何人相终始。\n宁为万死一生身，忍饥和丸供菽水。\n艰苦备尝五十秋，窗前明月为知己。\n凤毛五色幸翩翩，鸣翮摩天咫尺尔。\n三山中夜怜啼乌，停翼犹俟风云起。\n向予偃室接澹台，今日相期何底止。\n勉旃报母春晖心，圣世忠臣求孝子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀王心亭驾部时终养将释经","author":"林熙春","text":"曾听鸣琴擅好音，归来海上并抽簪。\n百年易地孤臣泪，千里同堂孺子心。\n司马声闻传视草，冥鸿飞倦恋栖林。\n王祥自合徵书至，鳄渚无劳叹陆沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题翁粤初姻友约心轩四首并得心字 其一","author":"林熙春","text":"承明方奉诏，忽动故园心。\n司马勋劳旧，神驹雨露深。\n阶兰时绕砌，径菊日成阴。\n偶有相如渴，天将渥尔襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题翁粤初姻友约心轩四首并得心字 其二","author":"林熙春","text":"出郭探名胜，斋居为约心。\n碧桃呈瑞锦，丹荔绽黄金。\n一鉴星辉动，垂虹月色侵。\n俗尘时不染，兴至抚瑶琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题翁粤初姻友约心轩四首并得心字 其二","author":"林熙春","text":"海上八千里，清轩向日心。\n凤台凝爽气，雉堞隐芳林。\n云卷群峰秀，风和万籁吟。\n趁时聊适赏，翘首作商霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题翁粤初姻友约心轩四首并得心字 其四","author":"林熙春","text":"久矣烟霞癖，登临慰昔心。\n千花迎客笑，百鸟解人□。\n展画环山水，摊书猎古今。\n瞻依无限思，啸凤听高岑。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡别驾归蜀","author":"林熙春","text":"凤皇台上憩祥鸾，直道翻成按剑看。\n报主有缘才驻足，对人无处可披肝。\n一声琴鹤韩江净，万里间关蜀道难。\n剩有明珠携掌上，入门犹自胜弹冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送和羹赋南宫","author":"林熙春","text":"少年共榻抱琅琳，搔首相期报国心。\n白璧繇来双足刖，黑头未许二毛侵。\n燕台骏骨千金重，凤渚龙吟五夜深。\n献赋上林君自爱，高山流水有知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蔡海洲兄赋南宫","author":"林熙春","text":"久抱明珠懒暗投，宁甘竹箭赋杨州。\n家传戴礼推高足，昆季韩江并出头。\n向自汗驹迟一顾，今从老骥始相售。\n壮猷尚拔燕山帜，侧席烦君借箸筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠淳源邢太公","author":"林熙春","text":"甲第繇来擅帝乡，君家玉树郁相望。\n孺心岂肯移天地，侠骨宁辞解骕骦。\n幸以燕贻传二戴，况从凤翥憩三阳。\n丝纶甫下韩江沸，丰镐恩来未可量。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]