[{"title":"九日马默斋送姑苏酒至次韵奉答","author":"陈献章","text":"姑苏一壶酒，九日到山开。\n即事焉能赋，颓龄漫爱杯。\n清风生菊径，落日满溪台。\n酩酊藜床上，云来覆老莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42491,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"求荔枝栽贞节堂","author":"陈献章","text":"高榜近东溟，朝光满北楹。\n欲便清昼睡，须待绿阴横。\n名木从谁假，幽居赖母成。\n君家多黑叶，火急送双茎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42492,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"华山飞翠","author":"陈献章","text":"何处青天外，穹然起一丘。\n山名疑属我，诗景尽归楼。\n九夏云长润，千岩翠欲流。\n野夫好游走，衰病只罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42493,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对鹤 其一","author":"陈献章","text":"潦倒溪翁谁，人疑鸟不疑。\n閒将鹤起舞，不作老无奇。\n任病还亲酒，虽慵不废诗。\n悠然清唳外，一枕到皇羲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42494,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对鹤 其二","author":"陈献章","text":"吾晚病兼贫，麻衣稳称身。\n朝来参两鹤，花底作三人。\n日出东南雨，莺啼宇宙春。\n三杯下衫袖，拂拭旧龙唇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42495,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题罗一峰赠马龙道南卷","author":"陈献章","text":"花发春来少，愁添老去长。\n高才想倾盖，昨夜语连床。\n天下罗公佛，湖西马子香。\n离筵一杯酒，歌苦莫相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42496,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮陂头","author":"陈献章","text":"入崦花丛密，遵陂石路高。\n柴门过午饭，村老对春醪。\n水白都如练，风清不作刀。\n自然五字句，非谢亦非陶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42497,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴村吊庄节妇墓 其一","author":"陈献章","text":"豺虎何由近，风涛浩若无。\n行人看墓榜，英爽在清都。\n江暝云长合，原寒草不枯。\n乾坤不朽事，持此报君夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42498,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴村吊庄节妇墓 其二","author":"陈献章","text":"此里有此墓，千年亦不磨。\n世方逐蔡琰，吾甚敬曹娥。\n淫盗死殊色，良人及逝波。\n江翻练裙带，激烈有遗歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42499,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀古次韵王半山 其一","author":"陈献章","text":"三径五株柳，孤村独板门。\n先生正高卧，众鸟莫交喧。\n晋宋当时改，乾坤此老存。\n手中一把菊，秋色满丘园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42500,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀古次韵王半山 其二","author":"陈献章","text":"相逢疏柳下，宾主两忘言。\n处士乃无履，江州初到门。\n低头入茅宇，散发对金樽。\n长揖朱轓别，狂歌向小园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42501,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"即事","author":"陈献章","text":"龙溪一片水，何处是真源。\n沈吟搔白首，伫立向黄昏。\n宿鸟争投树，归牛渐满村。\n少年谁氏子，歌吹隔江繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42502,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"经故居","author":"陈献章","text":"到溪田作圃，环堵树为门。\n老忆先庐在，贫知草座温。\n三迁时己后，二纪恨空存。\n旧事无人话，斜晖满故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42503,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"容琴月生孙以诗来贺之","author":"陈献章","text":"春意复西良，孙枝茁更芳。\n自堪为喜极，谁肯笑诗狂。\n竹杖还渠撰，金杯与客长。\n簪花垂白发，叠映绿衣香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42504,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠何廷桂罢馆归","author":"陈献章","text":"科头行百里，笠影落烟霞。\n四十亲舒卷，寻常过酒家。\n儿童非讲席，铅椠此归槎。\n共待春芳发，来看旧种花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42505,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠谢德明有事赴广还 其一","author":"陈献章","text":"毕嫁吾何有，劳君作犬商。\n钗裙是荆布，岁月胜资妆。\n月动江涛白，山衰木叶黄。\n无钱入城府，来往但轻艕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42506,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠谢德明有事赴广还 其二","author":"陈献章","text":"月落五仙城，天空一雁鸣。\n离愁动江色，归缆解钟声。\n鹭应船讴起，溪寻酒幔行。\n经过不买醉，贪嗅早梅馨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42507,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"有传罗一峰观化 其一","author":"陈献章","text":"悲风何处起，散作断肠声。\n乘彼白云去，湖西问死生。\n四海方悬仰，一峰何可倾。\n平生不下泪，今日尽沾缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42508,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"有传罗一峰观化 其二","author":"陈献章","text":"问讯南川子，金牛有是非。\n忧为妻子地，泪湿故人衣。\n岁晚流言恶，天涯信使稀。\n西风吹落叶，故故傍愁飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42509,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四月 其二","author":"陈献章","text":"生意日无涯，乾坤自不知。\n受风荷柄曲，擎雨柏枝垂。\n静坐观群妙，聊行觅小诗。\n临阶爱新竹，抽作碧参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42510,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"风雨夜有数十客共饭达旦不寐","author":"陈献章","text":"老觉生涯少，贫添食指繁。\n雨中谁举火，夜半客推门。\n室暗承尘湿，阶翻坠瓦喧。\n平明不曾睡，负锸理花根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42511,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻方伯彭公上荐剡 其二","author":"陈献章","text":"骨相合长贫，岩栖累十春。\n忽传邦伯疏，见笑北山神。\n伎俩只馀子，行藏独老亲。\n古来称冰鉴，谁是鉴中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42512,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初秋夜 其一","author":"陈献章","text":"四时相代谢，已度一日秋。\n风吹露下叶，月照水边楼。\n尧舜今当御，巢由竟媚幽。\n山灵邀梦去，昨夜又罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42513,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初秋夜 其二","author":"陈献章","text":"自我不出户，岁星今十周。\n丹砂求未遂，绿鬓去难留。\n时节来将晚，山河值早秋。\n西风捲雨去，星月满池流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42514,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋梦 其一","author":"陈献章","text":"山斗英魂在，江湖秋梦深。\n还将百年泪，滴破一峰心。\n絮酒熏天地，金牛恨古今。\n龙泉不挂墓，吾欲殉吾琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42515,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋梦 其二","author":"陈献章","text":"南海五千里，不来庄定山。\n何由到江北，此会非人间。\n短短目相属，悠悠心自閒。\n莫言但是梦，好梦亦云悭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42516,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋梦 其三","author":"陈献章","text":"夜来何所梦，洗耳白龙池。\n秋月下相照，天风高自吹。\n永持一瓢水，细嚼万年枝。\n山鬼向我拜，先生是希夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42517,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答惠州郑别驾惠葛布","author":"陈献章","text":"惠我一疋葛，缝衣笑不奢。\n赋诗酬别驾，爱酒典邻家。\n独酌秋风里，浩歌山月斜。\n醉魂不觉远，卧探惠阳花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42518,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"世泽 其一","author":"陈献章","text":"世泽由来远，何年播广东。\n吾庐依外海，分派自南雄。\n家剩为裘业，山馀偃斧封。\n千秋文物类，并与劫灰空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42519,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"世泽 其二","author":"陈献章","text":"世泽由来远，时当阨难中。\n长须躬陇亩，赤脚话儿童。\n骨肉危相保，干戈晚益穷。\n存亡一丝发，端为谢苍穹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42520,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"世泽 其三","author":"陈献章","text":"世泽由来远，中更几替隆。\n市廛怀直道，夷险信阴功。\n地接华山隐，家严涑水翁。\n百年还旧物，报事亦无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42521,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"世泽 其四","author":"陈献章","text":"世泽由来远，谁兴启迪功。\n今无夭颜子，古有圣重瞳。\n想像千年下，凄凉百感中。\n痴儿何足了，徒只愧家风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42522,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江门墟","author":"陈献章","text":"十步一茅椽，非村非市廛。\n行人思店饭，过鸟避墟烟。\n日漾红云岛，鱼翻黄叶川。\n谁为问津者，莫上趁墟船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42523,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋期友赏月遣苍头致馈以诗迓之","author":"陈献章","text":"笼鹅并榼酒，食有一金携。\n寂寂惭吾子，依依向隔溪。\n开筵面华月，出户望青藜。\n若负今宵醉，何不西山栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42524,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"即席赋","author":"陈献章","text":"夕风生微凉，池塘散月光。\n呼儿看酒具，待客饮江乡。\n月对歌筵徙，风拖舞袖长。\n人生行乐耳，归棹夜相将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42525,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"盆池栽莲至秋始花 其一","author":"陈献章","text":"栽种已后时，花发秋将迟。\n虽无女伴采，亦有山蜂知。\n叶稀因地力，香远是天资。\n安得三闾手，临轩赋楚词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42526,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"盆池栽莲至秋始花 其二","author":"陈献章","text":"秋露开炎萼，非时不遣誇。\n盆中玉井水，溪上舂陵家。\n酒醒凉风发，诗成缺月斜。\n愿为若耶叟，种水作生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42527,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"盆池栽莲至秋始花 其三","author":"陈献章","text":"开花恨不早，花落却生愁。\n白露能消物，红莲不耐秋。\n频来痴小女，对此泪长流。\n不识荣枯理，哀乐空相仇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42528,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"盆池栽莲至秋始花 其四","author":"陈献章","text":"此夕不能寐，此乐殊无央。\n下堂步明月，月印花自长。\n涓涓花间露，夜滴池水香。\n但惜花月好，那知风露伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42529,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"圭峰阁","author":"陈献章","text":"胜处不在远，杪秋何处寻。\n步崖碧涧落，眠石青松阴。\n地少沧溟入，山高雁鹜沈。\n此时閒伫望，谁识倚阑心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42530,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庚子元旦","author":"陈献章","text":"风日佳元日，乾坤自此春。\n蒸空云气湿，照水柳芽新。\n笑语聊供客，杯盘少对人。\n能宽垂老意，花鸟不无神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42531,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春兴","author":"陈献章","text":"野晴花簇白，山暖树更青。\n卯酒醉欲睡，午风吹又醒。\n閒拈曲江句，胜读法华经。\n自在山窗下，跏趺趣己冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42532,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晨起","author":"陈献章","text":"群雀晓啾啾，闭门春事幽。\n下床花到眼，招手鹤朝头。\n永日还书卷，衰年但酒瓯。\n醉来江柳下，笑引子陵钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42533,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早起","author":"陈献章","text":"推枕起新晴，披衣向小明。\n坐忘新病减，梦少夙心清。\n轧轧开邻户，鼕鼕杀县更。\n跛奴呼具盥，旋起绕花行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42534,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春怀次韵陆放翁","author":"陈献章","text":"江发溶溶绿，山开面面青。\n春风何气力，吹动綵云亭。\n时物归春雨，交游散晓星。\n十年江海梦，谁道不曾醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42535,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清明日往孔家山墓","author":"陈献章","text":"旧隐经都会，佳城入孔家。\n春云低拂马，山路曲萦蛇。\n只隔飘香处，犹疑坏圃花。\n九原无晓夜，谁管夕阳斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42536,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春兴追次后山韵","author":"陈献章","text":"万物各得性，天开一岁春。\n风柔翻弱羽，波暖跃纤鳞。\n稚柳初成趣，芳芹亦赏新。\n川云将岳雨，何者不供人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42537,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨坐","author":"陈献章","text":"风雨坐前楹，关关双鸟鸣。\n正当落花处，更作送春声。\n大化归无极，斯人乐久生。\n不知川上水，东逝几时停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42538,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吊陈毅卿墓","author":"陈献章","text":"微风松下起，落日照蜻蜓。\n絮酒知吾辈，春山忆毅卿。\n由来都大梦，终寄一浮萍。\n极目苍岑外，波涛满地生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42539,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蓬莱山祭伍光墓","author":"陈献章","text":"道骨成仙蜕，名山是阆丘。\n云中骑款段，天上叫?辀。\n人世黄梁熟，吾侪白发秋。\n仍留一杯酒，何处酹金牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42540,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"树穴兰 其一","author":"陈献章","text":"树穴疑生理，花开不记年。\n灵根那藉土，芳气值薰天。\n瘦比餐芝老，清于辟谷仙。\n平生谁得见，云峤但苍然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42541,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"树穴兰 其二","author":"陈献章","text":"大托千寻树，真堪托此生。\n春风卷骚怨，秋月照琴声。\n南极峰连起，东溟水一横。\n所栖非近地，持赠若为情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42542,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"家兄携秉常看山予病不能往","author":"陈献章","text":"行色千崖里，风光三月中。\n山家愁酒少，造物爱诗工。\n好鸟簧为韵，新花锦作丛。\n吾能骑瘦马，不惜远追从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42543,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题龟山小隐贺聂清碧新居","author":"陈献章","text":"濒海地三亩，连云厦数间。\n龟山爱清碧，清碧爱龟山。\n笠屐谁同往，江湖我自閒。\n芙蓉小溪水，曾此照衰颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42544,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山下别业","author":"陈献章","text":"豕脚有濡需，乾坤胡适随。\n看云因坐久，抱瓮得归迟。\n家累无多口，生涯但一陂。\n归哉五湖乐，吾未羡鸱夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42545,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"弄孙","author":"陈献章","text":"画栋三重檐，曈昽晓雀穿。\n一儿卧我膝，一儿坐奴肩。\n风日秋逾美，诗书老未传。\n二雏当慰我，心赏独悠然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42546,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戏赠都老","author":"陈献章","text":"蔡坑黄野舟，独坐小园幽。\n被命为都老，倾心向县侯。\n万家春且至，一纪俗全偷。\n莫倚无言化，须君九借筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42547,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"韦夫人挽","author":"陈献章","text":"人生如朝露，死亦同蜕蝉。\n有子能如诩，夫人可以仙。\n春台花灼灼，秋浦月娟娟。\n唤醒何州梦，归来泪迸泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42548,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵何宗濂","author":"陈献章","text":"洒落仪曹句，遗名得自求。\n如何行不顾，胶向漆中投。\n无事由来得，多言大抵浮。\n结趺樗木下，即此是良谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42549,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金洲石","author":"陈献章","text":"舟楫公馀日，金洲不少留。\n中流几丈石，明月五湖秋。\n目击金山寺，春来白鹭洲。\n西风从此去，几日到罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42550,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吊李九渊","author":"陈献章","text":"水竹更新主，风花失故权。\n夜台无起日，春草自流年。\n万有终归尽，千秋不必传。\n倒巾此相对，只有玉台山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42551,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"德庆州舟中呈伍南山","author":"陈献章","text":"江涨麻墟雨，天低德庆城。\n正当击楫处，空有结趺情。\n入夏寻双井，沿流到七星。\n同行邹道士，劝我学长生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42552,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"德庆峡是年大水舟行不由故道","author":"陈献章","text":"客路一千里，羊肠八百盘。\n时时行树杪，往往异人间。\n竹缆牵江暝，絺衣入峡寒。\n倚门应尽日，谁与报平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42553,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和尚石","author":"陈献章","text":"舟楫行天上，斜晖卷浪花。\n回流忽吞吐，鸣橹极呕哑。\n便可通星汉，还堪著钓槎。\n云根僧一个，疑我不袈裟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42554,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南归寄乡旧 其八","author":"陈献章","text":"紫水团沙北，黄云古刹东。\n楼吞沧海日，幔卷玉台风。\n物色求钟鼎，丹砂访葛洪。\n芙蓉开十丈，天际白龙宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42555,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南归寄乡旧 其九","author":"陈献章","text":"出处有分付，将非人所能。\n君看飞鸟辈，谁不顾高腾。\n放意三杯酒，留情半夜灯。\n韦丹非俗吏，灵澈自高僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42556,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南归寄乡旧 其十","author":"陈献章","text":"沙渠风日美，弄水爱群儿。\n花落莺犹语，春归蝶未知。\n惜芳心未已，高咏社公祠。\n四序每如此，独忧无乃痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42557,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春兴","author":"陈献章","text":"野鸟飞窗静，春萝补屋穿。\n时时咽花气，翳翳傍林园。\n山鸟日暮至，长鸣芳树烟。\n唤醒陶令醉，惊觉华山眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42558,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"社西村 其一","author":"陈献章","text":"孤村比屋静，疏竹小塘幽。\n何处还三径，如公也一丘。\n晚田行布狗，春草散?辀。\n汲涧谁家女，金樱插满头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42559,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"社西村 其六","author":"陈献章","text":"卜筑真何意，施为但自由。\n乡音还社阮，家业且陂头。\n野老眠看客，山童坐饮牛。\n无生知乐否，更为问骷髅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":42560,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]