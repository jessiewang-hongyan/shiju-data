[{"title":"九日登千佛山寺五首 其四","author":"边贡","text":"窈窈寺门敞，苍苍山径微。\n风轻不落帽，云近忽凝衣。\n背领丹枫直，垂岩紫菊肥。\n晚途喧葆吹，舆醉出林霏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17622,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日登千佛山寺五首 其五","author":"边贡","text":"半岩风且急，冲雨下山难。\n醉后还骑马，狂来不正冠。\n阴阴南国暝，淰淰暮秋寒。\n预想茅檐际，迎门稚子欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17623,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十月六日游千佛山寺","author":"边贡","text":"亭午登山寺，淹留夕未归。\n凉风起高树，落叶满僧衣。\n城郭寒烟聚，楼台暮景微。\n京华十年客，愁绝赏心违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17624,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"入寺","author":"边贡","text":"共邀黄鹤侣，来问野狐禅。\n日出山中寺，风鸣树里泉。\n落花空色相，啼鸟伴幽玄。\n莫叩轮回事，吾生自有缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17625,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出寺","author":"边贡","text":"鸡鸣春日晓，钟落上方幽。\n树湿云犹住，山空翠欲流。\n酒床随客去，诗草付僧收。\n虚羡岩栖子，尘镳不可留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17626,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿孙万户母","author":"边贡","text":"岁岁称觞处，将军此旧庭。\n玉函开宠诰，纱幔叩遗经。\n径茁宜男草，檐垂婺女星。\n白头真入画，长对晓山青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17627,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿程良用父","author":"边贡","text":"雅尚陶洪景，风流顾辟疆。\n名传天北极，家住水中央。\n晚日明花宴，春云护草堂。\n髯郎归节美，衣绣出明光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17628,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿文孔旸","author":"边贡","text":"寿域开梁苑，韶华逼艳辰。\n月临春馆静，花簇夜筵新。\n鹤信传西母，鸾箫乐上宾。\n转怜多病客，高枕独怀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17629,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"何圌樵寿五月十五日","author":"边贡","text":"胜地三茅北，嘉辰九夏中。\n寿尊浮海月，樵唱落天风。\n席近红榴艳，庭深绿桂丛。\n遥怜烂柯者，仙籍会相通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17630,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题秦国声为乃翁卑牧寿卷二首 其一","author":"边贡","text":"江门閒起坐，白发照秋山。\n花拥宜人佩，兰分稚子班。\n天恩来锁闼，星信报银湾。\n笑看东林鹤，传书海上还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17631,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题秦国声为乃翁卑牧寿卷二首 其二","author":"边贡","text":"池馆山中旧，风光画里新。\n涧松同雨露，江草自冬春。\n犬吠当林坞，花明隔水滨。\n遥疑姓秦者，莫是武陵人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17632,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿康对山母","author":"边贡","text":"垂柳荫香车，西园春雨馀。\n寿多从入老，身健欲凌虚。\n紫凤云中诰，青鸾海上书。\n近臣兼色养，何必赋閒居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17633,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿高给事乃翁","author":"边贡","text":"老境真熙洽，山中白日长。\n鹤巢松树古，花近寿筵香。\n几杖荣朝典，讴歌乐岁康。\n郎君青琐贵，归路满恩光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17634,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽无钖吴翁","author":"边贡","text":"锡山春日墓，闻说?乡贤。\n露叶迷蒿里，风笳惨木田。\n名高悬榻后，事定盖棺前。\n陇上清明月，年年哭杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17635,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王宪司挽章","author":"边贡","text":"桓典声名久，相如词赋稀。\n世方骢马避，身已茂陵归。\n白露凋原草，流尘集穗帏。\n伤心庭下鹤，时向月中飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17636,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨介夫丧母","author":"边贡","text":"楚客抱沉哀，孤舟天际回。\n恩馀五鼎食，人闭九泉台。\n古壁机丝断，残灯穗帐开。\n慈魂犹恋子，夜夜梦中来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17637,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽董天粹母","author":"边贡","text":"板舆游乐地，经晋复经燕。\n岂料言归日，翻成永别年。\n堂虚春草合，机冷夜灯悬。\n欲问三迁事，慈容隔九泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17638,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽谢都宪二首 其一","author":"边贡","text":"太守驱车日，中丞拥节年。\n化行江郡美，名在蜀人传。\n漆吏悲移壑，殷王惜济川。\n陇门双石表，何处立秋烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17639,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽谢都宪二首 其二","author":"边贡","text":"人间七十载，地下几千秋。\n无复青山到，真同逝水流。\n乱云笼閤迥，啼鸟殡宫幽。\n欲采蘋花奠，闽江远帝州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17640,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽张思绍乃翁","author":"边贡","text":"归老身犹健，游仙梦已侵。\n盐司官誉在，豸服主恩深。\n迢递碧山路，凄凉嘉树阴。\n秋风渡泸水，客子正愁心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17641,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"刘惟馨二亲哀册二首 其一","author":"边贡","text":"徂谢感流光，悲凉十四霜。\n箧中无谏草，身后有封章。\n遗曲传巴里，清风满蜀乡。\n凤凰原上木，愁色日苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17642,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"刘惟馨二亲哀册二首 其二","author":"边贡","text":"相如驷马荣，毛义悦亲情。\n讵料终天别，惟争一日程。\n机堂穗帷捲，隧户漆灯明。\n欲识归人恨，江猿夜夜声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17643,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽海钓翁","author":"边贡","text":"山海关头月，春来几度圆。\n杖藜无起日，华表有归年。\n寂历远游道，凄凉孤愤篇。\n朱云不可见，留槛汉庭前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17644,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"萧医士挽词","author":"边贡","text":"术妙轩岐上，年垂耋耄间。\n烟霞成癖性，松柏是容颜。\n济物心常在，游仙梦不还。\n钱塘江口月，长照玉泉山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17645,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽王宪副父母二首 其一","author":"边贡","text":"露白秋郊迥，风高宰木凄。\n深嗟墓门道，犹有聘君题。\n隐迹庞公并，诗名魏野齐。\n孝魂招不返，应只在辽西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17646,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽王宪副父母二首 其二","author":"边贡","text":"白首来官舍，丹旌返旧山。\n有怀空色养，无日见生还。\n暮草春回碧，机堂昼掩关。\n天涯有游子，肠断舞衣斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17647,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题王臣指挥母挽册","author":"边贡","text":"将军怀母处，堂屋对南山。\n香断氍毹冷，机空络纬閒。\n暮花愁里色，春酒梦中颜。\n一掬长淮泪，随波去不还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17648,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽同年程御史良用次见素韵二首 其一","author":"边贡","text":"有志经邦国，无忧及子孙。\n凄凉柱下史，慷慨殿中言。\n发已生离白，声还死别吞。\n空山一杯酒，何日奠忠魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17649,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽同年程御史良用次见素韵二首 其二","author":"边贡","text":"新安新庙起，闻子入乡贤。\n古墓青山外，秋风老泪前。\n乾坤英爽聚，日月大名悬。\n谁续少陵语，载歌骢马篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17650,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭儿羽","author":"边贡","text":"阿羽生存日，人呼圣小儿。\n虚疑渥洼种，实有凤麟姿。\n学步先遵礼，能言即赋诗。\n悼渠怜子夏，休讶入官迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17651,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖上忆亡儿羽","author":"边贡","text":"往岁春湖曲，尝携稚子游。\n花迎玉肤笑，云傍綵衣流。\n隔水时穿竹，看鱼数探舟。\n伤心独来日，烟月暮含愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17652,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登王丈墓","author":"边贡","text":"磊落王夫子，消沉岁月深。\n墓田馀数柳，书屋有孤琴。\n挂剑千秋恨，通家百世心。\n暮山荒草际，登拜一沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17653,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"亡弟赋改葬述哀","author":"边贡","text":"葬汝已六载，那期重抚棺。\n壮心原不死，遗骨久应寒。\n石室灵仪在，铭旌粉字残。\n一为同气感，双涕夕汍澜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17654,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上王氏妹墓","author":"边贡","text":"王郎呼不起，吾妹亦泉台。\n白日山头下，悲风树里来。\n有亲差可慰，无子更堪哀。\n岁岁荒坟土，何人奠一杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17655,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仲冬望日先陇述哀","author":"边贡","text":"矻矻衔石鸟，愔愔栖月乌。\n云霄双翼倦，天地此身孤。\n雪野兼愁远，风杨著泪枯。\n一杯残腊酒，知到九原无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17656,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东村暮归经罗侍御墓缅怀知旧恻然兴哀兼呈同志二首 其一","author":"边贡","text":"云日苍茫合，东郊暮雪时。\n古台斜落影，青嶂迥含姿。\n泽静龙蛇远，山寒雁鹜饥。\n亲交半丘墓，愁诵七哀诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17657,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东村暮归经罗侍御墓缅怀知旧恻然兴哀兼呈同志二首 其二","author":"边贡","text":"野色拥归轩，遥遥登古原。\n田乌啄素雪，山鸟下黄昏。\n近郭寒收市，荒祠静掩门。\n吾行有佳赏，思与故人论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17658,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过王履轩墓","author":"边贡","text":"郁郁将军墓，苍苍松桧林。\n断猿千古梦，归鹤九原心。\n地胜河流抱，门閒草色侵。\n承家有儿子，文史富缨簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17659,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"幽寂","author":"边贡","text":"幽寂卧蓬户，凄凉怀旧吟。\n莺啼非故国，草色乱春心。\n落日黄云暮，阴风碧海深。\n嗷嗷北来雁，二月有归音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17660,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对月感怀","author":"边贡","text":"惆怅东篱下，西风酒一壶。\n物随秋渐老，人与月同孤。\n幻梦疑蕉鹿，尘踪笑网蛛。\n寒蛩不解意，唧唧向青芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17661,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王廷珍分教东明","author":"边贡","text":"春日东明去，西斋教铎分。\n毡随郑老座，经授伏生文。\n水暖鱼腾藻，泥融燕啄芹。\n有怀如我及，看雨赋停云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17662,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"方献夫读书山寺","author":"边贡","text":"闻君读书处，孤榻寄禅林。\n日抱左氏癖，时为梁甫吟。\n开窗千嶂出，隔巷一灯深。\n独有花龛月，盈盈鉴苦心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17663,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨宿姚村二首 其一","author":"边贡","text":"旧陇东城外，新坟更在东。\n川原相近接，灵爽合潜通。\n碧草生秋石，青杨袅夜风。\n茂陵山下路，来往恨无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17664,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨宿姚村二首 其二","author":"边贡","text":"野径来人绝，村居夜寂寥。\n牖灯方闪闪，庭雨更潇潇。\n墓土空亲筑，精魂不可招。\n百年孤子恨，天地与同销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17665,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻三平菊酒初熟诗以调之","author":"边贡","text":"爱酒苦无酒，避狂翻蹈狂。\n闻君新酿熟，色胜菊花黄。\n月夜楼阴静，霜天海气凉。\n何当骑马去，饱挹瓮头香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17666,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"故山道中二首 其一","author":"边贡","text":"此山青可爱，岩嶂绕云松。\n暂息野中驾，弥耽尘外踪。\n石桥今古在，香客往来逢。\n落日谷风起，依稀闻瞑钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17667,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"故山道中二首 其二","author":"边贡","text":"素盖凌风转，飘飘度石梁。\n田家始晡食，村店已斜阳。\n红忆山椒熟，青怜陇麦长。\n郊行亦何事，能遣世情忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17668,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"辛巳元日止酒","author":"边贡","text":"草阁逢元日，悠悠一病身。\n碧山虚对雪，青柳自含春。\n罢接屠苏盏，长抛漉酒巾。\n相过见渔父，应笑独醒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17669,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望雨","author":"边贡","text":"倚杖柴门底，云峰引兴长。\n验霞从曙色，瞻雨过昏黄。\n柱础虚含润，盆荷实抱香。\n空檐百尺溜，何日听浪浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17670,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忧旱二首 其一","author":"边贡","text":"欲叩苍天意，悠悠默且玄。\n树焦真可爨，井渴故须穿。\n碧汉空秋水，钟山静晓烟。\n九重宽恤诏，何日下荒田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17671,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忧旱二首 其二","author":"边贡","text":"亢阳厚土裂，兹事莫言无。\n旱貉久为怪，惰龙真恼吾。\n未沾三伏雨，敢说九秋租。\n珍重云霓望，苍生待一苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17672,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"坐雨","author":"边贡","text":"密云蒸短夜，繁雨下清朝。\n不救中田麦，犹沾晚岁苗。\n度窗才浙浙，浮槛更萧萧。\n咫尺苏端舍，冲泥未可招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17673,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"八日喜晴","author":"边贡","text":"海门晴日吐，春水坐来添。\n喜入三农望，丰归五谷占。\n野莺啼秀木，江草映虚帘。\n我病生嫌酒，深杯且一拈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17674,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过北川周子庄","author":"边贡","text":"借问平阳守，泉庄今若何。\n树稀鸣鸟散，花乱早蜂多。\n酒坫封苔藓，渔罾罥薜萝。\n凄凉世交子，忍泪一相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17675,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"正月十七日先大人寿辰","author":"边贡","text":"此日吾亲寿，常年乐事多。\n夜堂歌窈窕，春綵戏婆娑。\n永恨重泉隔，深惊六载过。\n风前酹卮酒，肠断楚川波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17676,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过王生庐墓","author":"边贡","text":"赤日东郊午，言过孝子庐。\n草衣惟短杖，土屋有藏书。\n蛛网苔侵户，蜗墙雨溜渠。\n闵祠看咫尺，比德定何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17677,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"问信","author":"边贡","text":"问信陈州盗，将军有捷书。\n真成机上肉，岂虑釜中鱼。\n杀气东连颍，烽烟北近徐。\n招招淮口楫，将发故踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17678,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"盗贼","author":"边贡","text":"盗贼还奔突，传闻过白洋。\n关河苦迢递，云月复苍茫。\n贾客回江舸，居人竞野航。\n鸡鸣戒同伴，或恐犯垂堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17679,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过姚村旧业村有先君子遗陇","author":"边贡","text":"里巷纷仍在，邻翁半不存。\n午鸡喧井落，寒犬卧衡门。\n侧宇天光入，巍阡雾色昏。\n百年桑梓地，回首一伤魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17680,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忽报二首 其一","author":"边贡","text":"忽报杨开府，新传羽檄过。\n未须忧赤县，且复守黄河。\n去马定看疾，来舟遂不多。\n飘蓬愧生理，终日傍干戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17681,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忽报二首 其二","author":"边贡","text":"岂料朝天使，翻为避地人。\n去留难与决，传报恐非真。\n碧树花争蕊，清江水自春。\n庙堂嘉靖日，州郡转风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17682,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙洞山杂咏二首 其一","author":"边贡","text":"寺绕层峰入，溪通曲涧开。\n八年千里梦，七日两回来。\n古壁流烟色，荒蹊叠草莱。\n登高赋摇落，惭愧宋生才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17683,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙洞山杂咏二首 其二","author":"边贡","text":"出郭始朝饭，入山闻瞑钟。\n自怜衰病久，敢恨仆夫慵。\n立马看群岫，开尊对两松。\n谁能回白日，眼眺且从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17684,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"丁字口北","author":"边贡","text":"海口潮初落，片帆秋正堪。\n斜阳飞鸟度，微雨断云含。\n恋阙心驰北，留人风自南。\n一声渔篴响，凫雁起江潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17685,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鄂渚","author":"边贡","text":"鄂渚维舟楫，登高览洞庭。\n地连秋水白，天入暮山青。\n望阙瞻星斗，怀人感鹡鸰。\n渔箫向夕起，呜咽不堪听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17686,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暮行","author":"边贡","text":"野色苍茫合，宵征问路频。\n马蹄经藓滑，萤火度溪新。\n乡国今何许，家书动隔春。\n远村灯烛处，箫鼓赛田神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17687,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"逐客","author":"边贡","text":"逐客去已远，相思空尔哀。\n不闻宣室召，徒抱贾生才。\n野竹侵书幔，山莺进酒杯。\n梁园亲识满，今雨几人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17688,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"野风","author":"边贡","text":"野风吹荻苇，寂寂楚江秋。\n水气寒侵幌，涛声夜撼舟。\n古今双社鸟，天地一沙鸥。\n欲作怀湘赋，官程不可留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17689,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泛江","author":"边贡","text":"汎舟成小酌，半醉倚篷看。\n烽火偏西接，关山直北寒。\n渚花春漠漠，江日暮团团。\n谁识荆南守，思乡欲挂冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17690,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归自北村","author":"边贡","text":"款款野中话，依依川上情。\n雨昏沙径色，风起暮林声。\n临水仆夫望，呼予童子名。\n柴门露远火，回策兴弥清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17691,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]