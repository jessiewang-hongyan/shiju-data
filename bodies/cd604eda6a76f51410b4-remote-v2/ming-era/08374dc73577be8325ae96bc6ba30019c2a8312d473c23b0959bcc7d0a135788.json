nter":41399,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题南昌徐布政义景斋卷 其三","author":"韩雍","text":"甘棠遗爱满中州，景慕前闻退急流。\n多少世人空碌碌，钟鸣漏尽不知休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41400,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"二载无暇至龙泉比至慰问父老吏循民安殊无一事皆上之赐也晚步中庭喜而有感口占一绝","author":"韩雍","text":"王化渐摩久益深，士风民俗总还淳。\n山城驻节寂无事，闲步月明看北辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41401,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"食鲥鱼","author":"韩雍","text":"官廪送来香稻米，网船买得活鲥鱼。\n烹鱼炊米空饱食，补报无能愧逸居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41402,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖口望孟诚李都宪不至","author":"韩雍","text":"同榜同官意气同，几年宦迹隔西东。\n江头久望无消息，欲叩苍苍乞便风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41403,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"云谷八咏为乡人袁仲玉题 其一 杏林春雨","author":"韩雍","text":"医传董奉活人心，济物功成不受金。\n云谷年来春雨后，新栽红杏已成林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41404,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"云谷八咏为乡人袁仲玉题 其二 竹径清风","author":"韩雍","text":"一径深栽竹万竿，清风潇洒逼人寒。\n知君高节真相似，莫厌频频岁晚看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41