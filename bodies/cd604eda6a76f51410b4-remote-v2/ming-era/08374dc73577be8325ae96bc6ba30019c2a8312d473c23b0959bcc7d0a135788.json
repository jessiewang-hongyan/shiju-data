[{"title":"送张方伯廷玺荣满","author":"韩雍","text":"琼林宴会识英雄，宦辙循行见事功。\n江右声华陈仲举，岭南风望召康公。\n趋朝定儗承新宠，报国须当竭至忠。\n独我忧时无可效，海天万里思无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41371,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送宁方伯之浙江","author":"韩雍","text":"岭南廉察见才全，坐席初温秩又迁。\n两浙黎民怀惠泽，九重锡命再旬宣。\n英声已喜蜚天下，大拜还期近日边。\n海内于今尚多事，莫教勋业愧前贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41372,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠乡郡丘太守","author":"韩雍","text":"吾乡太守真豪杰，节操文章有古风。\n伯道清名传海外，乐天佳句满吴东。\n一麾抚字催科内，千里讴歌德化中。\n却恐邦人留不住，飞腾还建济时功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41373,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"慕萱堂为婿指挥谢瑛题","author":"韩雍","text":"北堂慈母忽游仙，乌鸟私情日夜悬。\n罔极深恩无报日，不禁哀泪动呼天。\n空承世禄难为养，每湿征袍祇自怜。\n大孝从来非止此，显扬还儗继前贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41374,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送刘郎中宽仁审刑广西回京","author":"韩雍","text":"皇华十载进秋台，荣捧天书万里来。\n游宦久谙当世务，平反今显济时才。\n旌摇庾岭梅初放，舟指滦河冻渐开。\n老我临边思无限，空将衰眼望蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41375,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿郭母太孺人诗","author":"韩雍","text":"吴淞江在吴城东，江头林木何青葱。\n汾阳后人住林下，高堂不与时人通。\n堂中慈母登寿考，八十春秋未为老。\n簪中白发千丈长，镜里朱颜四时好。\n降神之日近早秋，藕花风轻残暑收。\n长筵广席盛罗列，驼峰凤髓皆珍羞。\n贤子贤孙綵衣舞，玉树芝兰何楚楚。\n座中贺客半诗人，琳琅大振珠玑吐。\n酒酣笑指婺女星，共祝寿考还康宁。\n瑶池蟠桃再结实，遐算直儗三千龄。\n我与君家交最厚，南望乡山重回首。\n安得还乡与寿筵，岁岁年年祝慈寿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41376,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽柳御史母孺人","author":"韩雍","text":"闻道孺人发已苍，母仪妇道总非常。\n幽闲德比芝兰秀，贞静心如铁石刚。\n孝养姑欢朝侍膳，忧祈夫疾夜焚香。\n恒随令节供先祀，每赞凶年发义仓。\n道路行人资饮食，闾阎茕独举婚丧。\n抚存舅氏遗孤振，表率姻家阃政良。\n教子成名看衣绣，抱孙传业见飞黄。\n清时锡命来丹阙，晚景承恩在画堂。\n冠簇翠珠双凤结，袍明霞帔五云章。\n重重禄养来方厚，杳杳仙游去忽忙。\n霜落宜男凋草色，云遮婺女暗星芒。\n七旬高寿生无沗，一世荣名没有光。\n新冢玉埋闲永夜，穹碑山立对斜阳。\n题铭太史多称颂，执绋乡人重感伤。\n我亦为诗扬盛美，千秋万岁永流芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41377,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题松赠溤公子泰","author":"韩雍","text":"落落栋梁具，阴阴冰雪姿。\n曾经钜眼识，登用合乘时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41378,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵酬大司马王公度四首 其一","author":"韩雍","text":"万斛明珠远寄，漫言开府清新。\n几度焚香捧诵，不禁光彩惊人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41379,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵酬大司马王公度四首 其二","author":"韩雍","text":"圣主龙飞九五，嘉与天下更新。\n军国最为重事，于今付托得人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41380,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵酬大司马王公度四首 其三","author":"韩雍","text":"仕路相知难得，笑他白头如新。\n青眼始终垂顾，如公能有几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41381,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵酬大司马王公度四首 其四","author":"韩雍","text":"奔走车尘马足，常时送旧迎新。\n却有许多真乐，湖山风景可人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41382,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"洪都四景 其一 南浦朝云","author":"韩雍","text":"南浦楼前日未晖，白云片片自飞飞。\n河阳道路知何处，怅望京华犹未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41383,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"洪都四景 其二 西山暮雨","author":"韩雍","text":"门对西山暮捲帘，雨来江上水痕添。\n应须四海均沾足，一洗苍山九夏炎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41384,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"洪都四景 其三 东湖夜月","author":"韩雍","text":"湖水漫漫烟雾生，人间万籁寂无声。\n独留一片秋空月，照见波心彻底清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41385,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"洪都四景 其四 龙沙飞雪","author":"韩雍","text":"龙沙风起雪皑皑，江上空山玉作堆。\n最是霜台寒气肃，喧啾百鸟不飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41386,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄弋阳致政李少卿四首 其一","author":"韩雍","text":"天宠虽隆归兴浓，耆英会里得从容。\n悬知一点丹心在，清梦还飞到九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41387,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄弋阳致政李少卿四首 其二","author":"韩雍","text":"兰台棘寺已功成，归卧烟霞咏太平。\n多少世人空碌碌，冒霜犹趁夜钟行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41388,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄弋阳致政李少卿四首 其三","author":"韩雍","text":"凤雏鸣日在高冈，拂袖归山百虑忘。\n独伴清风与明月，新诗题遍午桥庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41389,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄弋阳致政李少卿四首 其四","author":"韩雍","text":"三年不见谪仙人，落月空梁入梦频。\n无限忧民忧国事，何时尊酒细咨询。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41390,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题陈御史苍厓舞凤竹乃仲昭笔也","author":"韩雍","text":"??葆羽上青霄，叫断苍梧路转遥。\n夜半天风弄明月，不知何处正吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41391,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送林黄门聪奉命代祀南海便道归省和同寅王公度韵四首 其一","author":"韩雍","text":"朝阳鸣凤瑞皇家，四海苍生览德赊。\n多少回天好封奏，人传曾梦笔生花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41392,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送林黄门聪奉命代祀南海便道归省和同寅王公度韵四首 其二","author":"韩雍","text":"一身已许帝王家，奉使何嫌道路赊。\n直以诚心将宠命，祝融坛上奠松花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","poi