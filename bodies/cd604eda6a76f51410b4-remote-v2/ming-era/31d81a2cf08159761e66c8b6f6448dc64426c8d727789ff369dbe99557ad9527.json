[{"title":"春日即事次陈石岸韵五首 其一","author":"王应斗","text":"春老寒林未作花，惊闻战伐动千家。\n愁肠索句髭应断，惫骨忧时鬓易华。\n帐下伏波方聚米，军前道济正量沙。\n严飙到处催行役，莫怪离鸿彻夜哗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日即事次陈石岸韵五首 其二","author":"王应斗","text":"肃气吹残上苑花，一封征调出官家。\n敷天有泪伤民瘼，烟景无人玩物华。\n累岁秋风鸣甲马，几时妖雨化虫沙。\n愿教再睹昆崙捷，五夜军筵寂不哗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日即事次陈石岸韵五首 其三","author":"王应斗","text":"眼底千艘逐浪花，离篷相率叹无家。\n登坛宿将思王剪，吊古名文忆李华。\n兵到八公疑草木，糈行千里掷泥沙。\n羁栖赖有中黄檄，细柳深营自禁哗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日即事次陈石岸韵五首 其四","author":"王应斗","text":"相传幽讨暗春花，百里行无三两家。\n新道直穷房绝徼，故宫遥过楚章华。\n野猿触客争升水，山鬼逢人欲射沙。\n寂寂征魂无耐可，更深惟有杜鹃哗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日即事次陈石岸韵五首 其五","author":"王应斗","text":"离楚声声送落花，也同闻敌志忘家。\n官催一鼓乘朝气，农惜三时误岁华。\n夜旦有人歌白石，天昏竟日走黄沙。\n鳞鸿几度传家报，肠断妻孥伏枕哗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"熊约生令子四人并饶才致各以二诗祝贱辰依韵荅之 其一","author":"王应斗","text":"冉冉奔驹度隙光，静中阅尽几炎凉。\n闲收芳草春前碧，细拾残荷雨后香。\n何用偷桃称曼倩，不须砍桂话吴刚。\n忘情便识尊生指，无复牢骚减徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"熊约生令子四人并饶才致各以二诗祝贱辰依韵荅之 其二","author":"王应斗","text":"梧垣丰采夙推尊，厚泽垂芳拟大门。\n孤愤未销风雨夜，旷怀时寄水烟村。\n庭前特立东山树，座上频开北海樽。\n更喜鸿章温世谊，远寻幽石破云根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"熊约生令子四人并饶才致各以二诗祝贱辰依韵荅之 其三","author":"王应斗","text":"龙门从昔种芝田，家学源深奕世传。\n月榭芳兰新绕砌，天都谏草旧遗篇。\n行觇听鹿鸣江浦，又送飞鸿过楚天。\n此夜赓吟偏逸致，墨华吹动綵衣跹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"熊约生令子四人并饶才致各以二诗祝贱辰依韵荅之 其四","author":"王应斗","text":"百感惊来忧绪多，蓬门长拥翟公罗。\n颠毛日送秋风老，野唱时闻春梦婆。\n何事锦鳞冲浪至，忽传佳句载云过。\n看君不浅挥毫兴，紫电英英遍大阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"熊约生令子四人并饶才致各以二诗祝贱辰依韵荅之 其五","author":"王应斗","text":"词苑翩翩拟斲轮，弓裘真羡窦家椿。\n遥瞻彩笔千花动，似对琼峰百尺峋。\n献赋可知青眼在，论交应慨白头新。\n几时一棹临修水，莫怅天涯参与辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"熊约生令子四人并饶才致各以二诗祝贱辰依韵荅之 其六","author":"王应斗","text":"廿年携手忆钟期，几度临风谩寄诗。\n白雪偶来公子调，青山聊慰美人思。\n七旬幻迹同沤影，千里交情托玉卮。\n和罢新词无限意，不禁挥涕洒江湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"熊约生令子四人并饶才致各以二诗祝贱辰依韵荅之 其七","author":"王应斗","text":"琅函廿载致芳闻，一曲新词胜远芹。\n洵是锦苞分凤彩，雅同修羽出鸡群。\n游神邃古君方懋，引领遐天我正殷。\n从此好音知不断，年年剖鲤向江濆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"熊约生令子四人并饶才致各以二诗祝贱辰依韵荅之 其八","author":"王应斗","text":"□□风雨送芳辰，笑挹春花坐绣茵。\n避乱那谋千日酒，忧时徒老百年人。\n渔舠放去烟为侣，鹤梦闲来月作伦。\n独喜宫亭飞一叶，清装分得锦囊新。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上司理时偕卢公兼怀令兄九台年丈","author":"王应斗","text":"看花曾近五云边，梦绕金门四十年。\n宝锷秋横湘浦月，高牙夜肃汉江烟。\n重瞻祥李光先泽，转忆甘棠竞后妍。\n白首狂歌天有二，可胜怀古思悠然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诗草帙成步韵荅友","author":"王应斗","text":"大都冲口似鸣蛙，遑计诗成璧与瑕。\n唱和有时随野鸟，品题率意第山花。\n梦回久索文通笔，病起慵搜惠民车。\n却笑渔樵无韵侣，风烟推我作当家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余嵩山以秋曹晋选部寄贺一首","author":"王应斗","text":"皎皎风棱尺五天，西曹雄望陟司铨。\n因占贯索澄空后，群仰冰壶坐照前。\n重地选官犹选佛，清才为吏更为仙。\n山涛启事无遗俊，独许嵇康懒自便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿允升贺父母","author":"王应斗","text":"累岁阴云黯弗彰，疾风未扰灌坛疆。\n不缘泽国惊波险，谁识山城化日长。\n新息生男皆字贾，道州有子悉称阳。\n群呼莫谓讴歌细，巳听欢声彻帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送熊渭熊任安吉州贰","author":"王应斗","text":"风啭莺簧荐盛游，晴云冉冉护仙舟。\n宏才不厌分司牧，逸致何妨有监州。\n毫綵光回南斗气，依班香蔼北堂秋。\n素心莫为浓时变，要作冰壶第一流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和东坡聚星堂韵即事 其一","author":"王应斗","text":"春林风袅千梢叶，柳花乱洒江城雪。\n梦中栩蝶忽惊流，枝上啼鹃正凄绝。\n传来霜檄墨方淋，閒向风檐心半折。\n榻前鼾睡不容留，非底妖氛期扑灭。\n闾阎力尽秪声吞，官帑钱空惟肘掣。\n兴索慵飞大白觥，泪垂冷渍深红缬。\n抛遗丝谷慱金铢，转掷泥沙如木屑。\n途沿沟壑委千骸，籍上流亡供一瞥。\n三空屡叹复何之，百孔未填向谁说。\n叫罢须逢当轴怜，广平不得心如铁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和东坡聚星堂韵即事 其二","author":"王应斗","text":"千?鳞次经于叶，百尺奔涛泼如雪。\n历落平沙雁影寒，凄凉古岸猿声绝。\n巳随鸟道入千盘，不信羊肠纡九折。\n别后征蓬几暮朝，思来乡梦半明灭。\n中黄夜令肃飙驰，大纛朝移惊电掣。\n轩盖相仍藉草莱，冠裳那得亲罗缬。\n帐下凝眸望米珠，道旁委骨如尘屑。\n悠悠岁月等流波，渺渺用原经过瞥。\n息肩盻断知何时，点鬼心寒无可说。\n但愿天风捲乱云，不烦寸兵与尺铁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"佛印烧猪待子瞻","author":"王应斗","text":"□芳勘破味何殊，禅喜风流属大苏。\n若使屠刀真碍佛，那须烹炙到香厨。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又","author":"王应斗","text":"棒底神龙未出潜，在家菩萨可同瞻。\n群饕未解蒸豚意，大梦何时醒黑甜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五日","author":"王应斗","text":"饮能消独况，愁不解三吁。\n快节家悬艾，寒飓景逼榆。\n簪花羞短发，斗草命长须。\n性癖耽吟苦，萧然守病癯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月十七日快孙生余生十五日","author":"王应斗","text":"宾筵初罢报孙枝，家庆重欢此一时。\n裴庾昔年传笑语，甲辰何必问雄雌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"笔客持卢文甫下雉书来附荅一首","author":"王应斗","text":"藉草三冬日，看花二月天。\n偶来毛颖使，分得照邻笺。\n宝翰寻钟阜，名文访富川。\n甑□同仰止，凭吊可悠然。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为两儿祝贺明府寿二首 其一","author":"王应斗","text":"城南星锦灿天中，瑞绕宫墙岁岁同。\n问道立深门下雪，披怀哎挹座间风。\n松高泰岳千寻碧，花放河阳七度红。\n唱罢海筹无尽爵，明霞初拥日生东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为两儿祝贺明府寿二首 其二","author":"王应斗","text":"钧天瑶鼓振芳辰，历历蓬壶座上宾。\n粹白近连江夏裔，孤清遥接镜湖春。\n菁莪迭咏中都化，桃李欣逢上苑新。\n只愧九方垂策后，蹇驽犹自滞风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王翰宿以诨语二绝见贻步韵荅之 其一","author":"王应斗","text":"寒床久矣谢红妆，无复山妻犯太常。\n群少也遵房老约，不□天壤有王郎。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王翰宿以诨语二绝见贻步韵荅之 其二","author":"王应斗","text":"频年风雪守衰翁，那得馀欢倚袖红。\n近悟广成无异术，眼前平地是崆峒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟游仙曲再和前韵 其一","author":"王应斗","text":"隐隐天台伴素妆，赤霞城里话家常。\n桃花开遍无穷树，只笑思归旧阮郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟游仙曲再和前韵 其二","author":"王应斗","text":"太华峰顶会苍翁，共看莲花十丈红。\n乘兴不知归路迥，又随明月上崆峒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咄咄吟 其一","author":"王应斗","text":"事到书空倍可嗟，遣愁惟藉酒杯奢。\n光天共质心如水，朗日宁防影射沙。\n未必三人成市虎，终当一语释弓蛇。\n唫馀转重平生愧，虚道神羊解触邪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咄咄吟 其二","author":"王应斗","text":"颠毛频拥雪霜侵，累日牢骚付短唫。\n未肯酖人款叔子，终怀慈母识曾参。\n身当磨蝎宫中老，路向羊肠历后深。\n却喜蒲团心弗动，尽教山鬼自浮沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咄咄吟 其三","author":"王应斗","text":"向道春残卷舌宜，近来岐路更多岐。\n休论肺腑深三窟，就阅皮毛亦九疑。\n好语终嫌鹰眼疾，朴心翻笑虎头痴。\n铜山自昔无常主，蜃海楼台得几时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咄咄吟 其四","author":"王应斗","text":"索居何用叹奇穷，涉世真惭老未工。\n原火空燃非有种，江涛自沸不因风。\n忘情那复窥衷甲，炤隐还须藉且铜。\n读罢骚辞天可问，郁陶深处有神通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次客韵 其一","author":"王应斗","text":"惊涛声息梦粗安，晓起山云下笔端。\n院静到门欣有客，身轻阅世喜无官。\n久邀牛耳修盟好，谁复羊肠畏路难。\n嗟子风尘能绝俗，新花错落夜唫残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次客韵 其二","author":"王应斗","text":"晴江波映百花燃，一路莺啼送晓天。\n北郭青山容我老，西堂佳句羡君传。\n冷怀落得风生袖，归兴聊存月满船。\n谁问隽城人太瘦，作诗未拍少陵肩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南山有佳色 其一","author":"王应斗","text":"晨光新捲翠微烟，弄态偏于两后妍。\n独坐小楼青自到，不因采菊见悠然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南山有佳色 其二","author":"王应斗","text":"萧疏岚影乱芙蓉，濯濯迎熏挺数峰。\n才见飞猿穿绝峤，又惊舞鹤下孤松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南山有佳色 其三","author":"王应斗","text":"重峦浥露洒朝氛，紫绿千峰尽逊君。\n当户分明成好友，莫教山北起浮云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南山有佳色 其四","author":"王应斗","text":"气映朱明景自奇，幽窗惟有对君宜。\n年来晏起无多事，也学韦庄改旧诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南山有佳色 其五","author":"王应斗","text":"把酒何当作寿卮，春林花落鸟衔时。\n蓬莱宫阙遥相对，抚景宁堪今昔悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南山有佳色 其六","author":"王应斗","text":"雾隐频年惜豹斑，几番风雨洗春颜。\n沉唫恍入空濛里，醉梦时飞杳霭间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过千佛庵","author":"王应斗","text":"乍出东城道，微风度磬音。\n桃源分路细，竹坞覆云深。\n佛现千千相，人归一一心。\n广长无隙地，敷遍给园金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁嵾岚咏学宫古柏二章书扇见贻次韵附荅 其一","author":"王应斗","text":"饱尽风烟几岁寒，裒然高韵矗文坛。\n声摇五夜飞金玉，色映千秋拥盖冠。\n并秀巳无群卉在，后彫应作老成看。\n森阴偶寄骚人榻，累日豪唫属和难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁嵾岚咏学宫古柏二章书扇见贻次韵附荅 其二","author":"王应斗","text":"萧条犹见典刑垂，铁干铜标迥自持。\n镇定转怜风劲后，孤清遥对月明时。\n危巢蔽日栖乌老，瑞骨留仙梦鹤知。\n几度宫墙鸣夜雨，凄凄如响壁间丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"明日黄花蝶也愁","author":"王应斗","text":"宿花魂魄带香逋，昨到龙山伴饮徒。\n金色暗凋霜下杰，玉痕新化雨中枯。\n旋教庄叟空成梦，顿使滕王懒绘图。\n安得有丹扶骨起，英英枝上锦重铺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次和袁嵾岚见赠三十韵","author":"王应斗","text":"舂陵有佳气，风雅代相持。\n旷躅倾三户，铉言贵一时。\n伟哉公后劲，能与昔同揆。\n崒嵂连嵾峙，汪洋泻汉滩。\n仓皇逢世乱，谈笑取官奇。\n锦制江城丽，斤挥鄂渚宜。\n李桃相竞秀，桑梓愧言私。\n骥足方闲步，羊肠复履巘。\n调高嫌寡各，怀宝惜希知。\n逸致宗陶阮，高风接颖箕。\n筇飞丹岳迥，车纵白门驰。\n识以观涛壮，情因望海移。\n尽韬文豹雾，孤引渐鸿仪。\n墨翰资游戏，烟云任蔽亏。\n朗怀澄皎皎，冲度益夔夔。\n每快闻声蚤，翻憎握手迟。\n一朝披赤牍，千里挹青芝。\n裔续公安著，名齐洛下垂。\n有时凌白也，率意写羲之。\n老作文章伯，狂呼造化儿。\n抽毫惟信腕，得酒不攒眉。\n自我逢袁粲，何殊遇子期。\n唱酬欣有托，摸索谩云谁。\n斗北行占聚，河东岂待吹。\n时花俱扫艳，古柏独成诗。\n读罢陈杯酌，欢陪畅梦思。\n清谈依茂宰，列席近先师。\n咳唾生珠玉，敦庞肃鼎彝。\n不图休晚沐，旋复吐新词。\n从此耽深契，逢人说项斯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"生圹成","author":"王应斗","text":"荒原携酒散春愁，细逐烟岚步首丘。\n万事至今同逝水，百年何计问藏舟。\n陶潜自挽成孤况，□圣生茔寄卧游。\n只笑普天俱覆鹿，虚从大地指眠牛。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广德观","author":"王应斗","text":"昔隶清虚府，今藏般若函。\n白头宗老子，黄面礼瞿昙。\n空色元无定，禅铉任所参。\n但知心是一，何用教分三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕读坡诗 其一","author":"王应斗","text":"年光虚遣酒杯酬，那得诸缘与岁休。\n堪笑东坡犹耐老，到将长健慱穷愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕读坡诗 其二","author":"王应斗","text":"白头纷壤复年年，未见浮生可释肩。\n入手屠苏虽在后，耽心烦苦却居前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕读坡诗 其三","author":"王应斗","text":"杯残膏烬夜如何，徙倚难支岁事过。\n苦境正愁明日又，孤吟莫讶此宵多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕读坡诗 其四","author":"王应斗","text":"年哀怕看历头新，此语亲尝始觉真。\n更有怆心言未得，风霜经遍六朝人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有误传游衲为旧宗者席间示之","author":"王应斗","text":"飘飘云水自成奇，何必天潢足重师。\n法喜胎中皆玉叶，优昙钵里是金枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋晨起侍见进桂一枝插于短发笑而咏之","author":"王应斗","text":"折桂当年事，簪花此日因。\n仅馀千里志，空老六朝身。\n时会有今昔，物华无故新。\n又欣轮满夜，同醉庾楼人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀旧令君贾长傅","author":"王应斗","text":"乍传飞鹤下晴川，幽梦追寻竹马年。\n彩舄高回江渚月，仙舟遥带郁林烟。\n户瞻莱柏阴犹盛，手种潘桃花正妍。\n安得九天怀七泽，于旄重映隽州悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜袁嵾岚至崇适际公郎试周之会赋贺一首","author":"王应斗","text":"仙舟初下洞庭滨，恰际瑶盘弄玉麟。\n五十钟祥呈晚秀，三千行路应佳辰。\n黄金斗大先摩肘，紫电霜明蚤拭茵。\n他日峥嵘须记取，悬弧我作座中宾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"随口赠天树和尚","author":"王应斗","text":"菩提无树树生天，尽扫滋培付自然。\n借问根花何处现，法云飞遍雨三千。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次汪中子扇头韵 其一","author":"王应斗","text":"意绪年来总不如，萧条谁拟段家闾。\n松间冷笑苍云变，花下閒吟化日舒。\n谩惜一生濒九死，聊随万卷守三馀。\n相看独有梧桐月，夜夜流光到绮疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次汪中子扇头韵 其二","author":"王应斗","text":"痛饮狂吟恣所如，醉醒何苦问三闾。\n诗中甲子怀元亮，策里天人忆仲舒。\n关塞悲笳犹未静，江湖竭泽巳无馀。\n伤心尽有乘轩使，可许颠连一上疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次汪中子扇头韵 其三","author":"王应斗","text":"寥寥生事竟何如，剩有肝肠信比闾。\n泪下山猿啼月冷，影随江鹤带云舒。\n频年逐队忧三尽，何处高眠享二馀。\n翘首庙谟宣郁滞，礼功不下九河疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]