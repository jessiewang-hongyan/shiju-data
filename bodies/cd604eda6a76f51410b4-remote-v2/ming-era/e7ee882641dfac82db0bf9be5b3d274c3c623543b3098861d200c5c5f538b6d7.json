[{"title":"送右辖王子逼除赴嵩山之役以狱事","author":"李梦阳","text":"遽有嵩山役，恰然逢此春。\n旌旗拂岫入，车马驻萝新。\n坐爱溪花发，行怜寨兽驯。\n时雷苏万物，君重系累民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55348,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送佘生南监","author":"李梦阳","text":"江门柳色暗，四月浪花高。\n尔抱鱼龙志，休随雀燕曹。\n金山入紫气，璧水动青袍。\n倘虑音书隔，南风有顺毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55349,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台秋饯何子二首 其一","author":"李梦阳","text":"会少怜君暂，台孤引望频。\n清秋属过雁，落日有征人。\n华岳元通洛，黄河不弃秦。\n异时愁独上，千里见嶙峋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55350,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台秋饯何子二首 其二","author":"李梦阳","text":"候吏催迟暮，游人怨解携。\n十年内供奉，万里竟关西。\n地古饶文物，时平罢鼓鼙。\n巡行有佳兴，应遍绝崖题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55351,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再饯何子","author":"李梦阳","text":"武场重布席，文士此分襟。\n人世东西路，秋天旦暮阴。\n杯光摇弱草，庭色下饥禽。\n他日关中使，无忘汴上音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55352,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜李生自京师归","author":"李梦阳","text":"北极星齐入，中原尔独归。\n田园自松菊，身世有庭闱。\n鱼可一钱买，花常四季飞。\n感时台莫上，恐湿贾生衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55353,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送柳仪宾进圣节表","author":"李梦阳","text":"万国生辰表，天王北狩时。\n鸡鸣元紫禁，虎拜亦丹墀。\n汉树霜枫古，尧蓂露荚移。\n无辞醉宫酒，当是旧朝仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55354,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋别郑生","author":"李梦阳","text":"别离谁独免，此别是中秋。\n尔上袁宏艇，予登庾亮楼。\n羽衣飘北槛，渔笛起中流。\n炯炯共明月，那堪两地愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55355,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"已卯元日内弟玑见过二首 其一","author":"李梦阳","text":"内弟元朝过，柴门午一开。\n柏尊吾足办，椒颂尔须裁。\n天地冰霜变，江湖日月催。\n鬓毛斑欲甚，谁忍复春来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55356,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"已卯元日内弟玑见过二首 其二","author":"李梦阳","text":"汝今年四十，而我八年多。\n世路怜书剑，生涯笑薜萝。\n游将花并放，醉拟鸟同歌。\n莫问朝元日，伤心是玉珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55357,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送戴氏","author":"李梦阳","text":"两河飞雨尽，万里不尘沙。\n白马朝天客，春风御柳花。\n声名新上计，袍笏旧传家。\n谅有兰台擢，应难舍伏伽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55358,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄毛监察","author":"李梦阳","text":"江汉归鸿雁，乾坤罢虎狼。\n薜萝吾故土，骢马尔何乡。\n岸树霜先赤，篱花晚自黄。\n向来杯酒地，台柏但苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55359,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪中郑生见访","author":"李梦阳","text":"万户风花起，吾门尔一开。\n惊看破履迹，笑指白须来。\n驴为登桥熟，船非访戴回。\n今朝梁苑赋，合试马卿才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55360,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪中苏生以诗见过","author":"李梦阳","text":"楚楚眉山裔，儒林羡白眉。\n朅来白雪里，惠我阳春词。\n结绶终相庆，投珠莫自悲。\n长安马蹄疾，是尔看花时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55361,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春初大道观访苏生","author":"李梦阳","text":"草生坛雪尽，宛宛孤云辉。\n怪尔黄庭罢，双鹅不换归。\n窗镫留夕照，栏竹伴春晖。\n安得频过此，谈玄两不违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55362,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄陈浚","author":"李梦阳","text":"借问垂双翅，何时奋一飞。\n黄金不易就，黑发渐应稀。\n山雪骑驴出，江风捲钓归。\n所嗟冠盖地，独尔薜萝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55363,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠僧怀让越人也嗜酒其居有借树轩","author":"李梦阳","text":"访旧来东社，焚香对病禅。\n素琴真与寂，浊酒及通玄。\n邻树当经牖，春花落讲筵。\n不逢支遁语，谁解月中传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55364,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"逢郏王子","author":"李梦阳","text":"相思汝水月，相见帝城春。\n紫逻云烟迥，青门柳色新。\n岂如题凤侣，疑是好鹅宾。\n醉即挥鞭别，金龟报主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55365,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐子过别因而留宿","author":"李梦阳","text":"岂是陈蕃榻，能淹孺子栖。\n无言向春月，难寐及晨鸡。\n钩幔回春色，梳头过鸟啼。\n如何艳阳节，与尔惜分携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55366,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"洪法寺遇乡僧","author":"李梦阳","text":"烂熳春游处，重来冬日凄。\n松风犹故壑，露叶巳新蹊。\n废井浮阳出，巍阡冻雾栖。\n逢僧话乡曲，寒望转萋迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55367,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张生还金齿二首 其一","author":"李梦阳","text":"万里来何事，三人此复过。\n高秋鸿雁下，落木洞庭波。\n岁月长途老，风云后进多。\n百蛮家更远，自爱莫蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55368,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张生还金齿二首 其二","author":"李梦阳","text":"大雅流重译，殊方挺上才。\n批鳞书几上，塌翅首频回。\n白发南荒路，秋风北宋台。\n三杯邂逅地，为尔一徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55369,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送郑淳入闽","author":"李梦阳","text":"江海发春涛，南浮二月舠。\n花行浙口盛，云近武夷高。\n土布离乡贵，杉鸡诧客号。\n延平津倘过，珍閟匣中刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55370,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王左史入觐","author":"李梦阳","text":"帝里花应待，王筵醴暂违。\n舟从泰水上，人是锦衣归。\n日月瞻新衮，风云壮旧畿。\n辞朝君即返，莫赋北山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55371,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送侄竹赴京听除","author":"李梦阳","text":"皇王宝历开，汝上黄金台。\n气色三光正，人心万国来。\n拜除将檄入，辞谢柚香回。\n幸会风云路，行伸騕袅才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55372,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送伍长垣赴召二首 其一","author":"李梦阳","text":"君赴兰台召，谁看此县花。\n久知骢是马，当许鹭随车。\n日月新明主，乾坤旧一家。\n异时缣帛赏，应首及孙伽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55373,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送伍长垣赴召二首 其二","author":"李梦阳","text":"要地徵名尹，新朝急俊臣。\n班升玉笋晓，台散紫兰春。\n万水元趋海，群星自拱辰。\n谁言大河上，白首有垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55374,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄熊御史塞上","author":"李梦阳","text":"汉官持斧处，天险惜离群。\n塞口孤城断，峰腰细涧分。\n胡天秋更惨，杀气暮还云。\n定有忧边计，缄驰达圣君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55375,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日王子台上","author":"李梦阳","text":"暑霁名王会，台成上客过。\n清秋疏草木，落日上笙歌。\n天地衔杯尽，风云傍槛多。\n圣明今御极，谁复虑干戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55376,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬钱子锡山之招","author":"李梦阳","text":"南迁公约我，北望我怀公。\n阳羡春芽秀，荆溪早稻红。\n乘槎伍胥口，采药洞庭东。\n何日酬吾志，江涛日夜风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55377,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王子如淞江","author":"李梦阳","text":"宝剑寒无色，苍然海上行。\n异书探战伐，高论动公卿。\n何日为毛遂，前身是贾生。\n谁怜同学子，章句独虚名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55378,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚过孟氏雷雨遽至会王子亦来二首 其一","author":"李梦阳","text":"王褒真畏友，孟浩复多才。\n下马云徐暮，开尊雨骤来。\n疾雷当户落，惊电触檐回。\n坐待明星出，无疑晓漏催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55379,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚过孟氏雷雨遽至会王子亦来二首 其二","author":"李梦阳","text":"霁月出还没，骄雷东复西。\n千门萤火动，六月候虫啼。\n共是天涯客，能忘雨后题。\n吾诗催仗汝，好放片云低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55380,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"僧园秋集同田生二首 其一","author":"李梦阳","text":"榴竹晴相媚，秋光满给孤。\n微风捎果重，残暑入林无。\n宝塔金杯映，青天白鹤呼。\n不须谈浩劫，吾醉亦忘吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55381,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"僧园秋集同田生二首 其二","author":"李梦阳","text":"自笑红颜日，僧今白首看。\n秋风修竹过，台殿碧梧残。\n钟磬昏仍起，壶觞醉不乾。\n塔层思尽上，恐逼斗牛寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55382,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日宴山泉王子之第同左田二子二首 其一","author":"李梦阳","text":"入殿笙箫合，开筵锦绣围。\n苑枝春竞发，台日晚犹辉。\n语燕窥吟管，飞花坐舞衣。\n二豪同酩酊，与尔月中归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55383,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日宴山泉王子之第同左田二子二首 其二","author":"李梦阳","text":"巳恨韶华剧，能孤烂熳游。\n莺啼檐树换，蝶戏槛花流。\n宾客朝开苑，笙歌晚入楼。\n但看今会者，孰与汉枚邹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55384,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬赠阁老刘公四首 其一","author":"李梦阳","text":"雷奋龙犹卧，云俱鹤自闲。\n一杯莘野月，双屐谢公山。\n贵客常辞避，田夫数往还。\n桂庭秋偃蹇，公醉拉谁攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55385,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬赠阁老刘公四首 其二","author":"李梦阳","text":"大号更嘉靖，明公会古稀。\n老惊诗律健，闲爱醉游归。\n庭户罗花竹，儿孙导綵衣。\n向非千仞览，那见太平辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55386,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬赠阁老刘公四首 其三","author":"李梦阳","text":"寿席秋能半，宾庭月故圆。\n前身金粟佛，今代玉堂仙。\n兔巧元供药，龟灵岂算年。\n蝇头灯下字，犹注紫霞编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55387,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬赠阁老刘公四首 其四","author":"李梦阳","text":"野绿情真逸，山香望独高。\n酒嫌裴相浅，诗掩乐天豪。\n公实当三老，吾虚受二毛。\n人遐室幸迩，音惠莫言劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55388,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送田生读书上方寺三首 其一","author":"李梦阳","text":"嗜静甘违俗，藏修合就僧。\n绿移开径竹，寒扫护窗藤。\n殿阁秋阴下，琴书爽气增。\n不须匡氏壁，常有玉莲灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55389,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送田生读书上方寺三首 其二","author":"李梦阳","text":"寺压孤城断，堂开积水围。\n一僧当茗灶，群鹭狎荷衣。\n被酒时登塔，持书晚坐矶。\n鹤腾知客至，嗟汝咏而归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55390,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送田生读书上方寺三首 其三","author":"李梦阳","text":"凉雨满庭户，冷然松桂幽。\n隔云清磬湿，向夜一灯留。\n萤火辉书幌，乌啼上佛楼。\n让多今古意，先著宋春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55391,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登钟楼答田秀才","author":"李梦阳","text":"老足秋能健，朋游崄益豪。\n眼当孤阁放，身巳百层高。\n霜壁摇朱杞，风檐落白蒿。\n生平望东海，一钓有连鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55392,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别郑生","author":"李梦阳","text":"白首还离别，长途倍苦辛。\n愤时惟按剑，避世谩垂纶。\n江海烟霜日，乾坤去住身。\n临河见双雁，杳杳向秋旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55393,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送白帅留守中都","author":"李梦阳","text":"幕府开淮甸，山河绕汉陵。\n晓霜迎旆入，王气及秋澄。\n弩卧铜牙涩，矛抛绿藓增。\n黄金印如斗，应有异时徵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55394,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再送白帅","author":"李梦阳","text":"圣主下龙章，将军入凤阳。\n地盘淮海壮，天拥汉陵长。\n棨戟新开府，威名古辟疆。\n卜年元万世，王道是金汤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55395,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再送郑生","author":"李梦阳","text":"闻君数日住，使我百忧宽。\n池馆杯觞易，天涯故旧难。\n久晴冬欲暖，近水晚犹寒。\n借取防身剑，慇勤醉里看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55396,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谭刘二子过赏牡丹二首 其一","author":"李梦阳","text":"载酒来朋远，寻芳出郭遥。\n遇花双盖住，系柳一骢骄。\n野席留香迥，晴尊助艳娇。\n谁言阑百宝，吾有玉鸾箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55397,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谭刘二子过赏牡丹二首 其二","author":"李梦阳","text":"学舞花将起，矜歌鸟自来。\n日筵随荫徙，风袂入香开。\n李白昭阳调，姚黄洛下杯。\n古今君莫问，且促醉轺回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55398,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日寄题崔学士后渠书屋七首 其一","author":"李梦阳","text":"草阁临何地，花天想后渠。\n傍墙应植柳，俯岸几跳鱼。\n好撰王褒颂，休亲郭橐书。\n改元新礼制，侧席待相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55399,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日寄题崔学士后渠书屋七首 其二","author":"李梦阳","text":"石白云花瑩，湍青水叶香。\n野情鸥鸟足，纱帽世涂忘。\n问字船能过，听莺客不妨。\n无言浑是暇，当有草玄忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55400,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日寄题崔学士后渠书屋七首 其三","author":"李梦阳","text":"鲍客春还邺，崔渠遂盛传。\n水溶漳岸日，草碧魏城天。\n径竹竿竿秀，汀花朵朵鲜。\n但无醒酒石，物物胜平泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55401,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日寄题崔学士后渠书屋七首 其四","author":"李梦阳","text":"敞敞渠边屋，煇煇座右铭。\n竹琴晴愈静，萝烛夜还青。\n洹水明卿月，陈家聚德星。\n泥中虽近戏，仆隶解谈经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55402,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日寄题崔学士后渠书屋七首 其五","author":"李梦阳","text":"是否龟蒙鸭，将无逸少鹅。\n内官聊一戏，道士敢烦过。\n自坐莆矶饮，谁攀桂棹歌。\n绝弦知不易，白眼向山河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55403,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日寄题崔学士后渠书屋七首 其六","author":"李梦阳","text":"赋笔多崔瑗，朋车愧吕安。\n碧渠何日到，云树一春看。\n南果枇杷活，西郊苜蓿宽。\n觅君终系马，舣棹是何滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55404,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日寄题崔学士后渠书屋七首 其七","author":"李梦阳","text":"且养岷山鸟，休焚学士鱼。\n穷通不在我，水竹漫成居。\n绿薜深藏屋，丹花浅映渠。\n几时朝圣主，人拟治安书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55405,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"小园花发谭刘二君订游涉夏始至席上三首 其一","author":"李梦阳","text":"尚有春留赏，无言客过迟。\n砌红残芍药，园绿半荼縻。\n邂逅情真倍，追随酒莫辞。\n有怀君尽放，得意是佳期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55406,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"小园花发谭刘二君订游涉夏始至席上三首 其二","author":"李梦阳","text":"缱绻杯侵夜，迂徐月转庭。\n醉寻松影立，凉爱竹风听。\n老去朋情恕，年来世事经。\n玉绳天历历，谁识少微星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55407,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"小园花发谭刘二君订游涉夏始至席上三首 其三","author":"李梦阳","text":"涉夏榴能绽，深更客尚游。\n群行逢树问，独立为花留。\n就月还移席，呼儿重洗瓯。\n醉眸横北斗，曙角起城头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55408,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送吕广文四川衡聘","author":"李梦阳","text":"大省文衡重，名师礼聘遥。\n阁云寒暑旆，栈月引星轺。\n古帝蚕丛国，今人驷马桥。\n好将杨马辈，收取贡清朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55409,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠孟监司赴任三首 其一","author":"李梦阳","text":"南辍江湖棹，东飞海岱旗。\n勇辞知至性，强起为名时。\n气节聊城箭，文章孔庙碑。\n秋风立马地，莫动季鹰思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55410,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠孟监司赴任三首 其二","author":"李梦阳","text":"汶上篇仍在，齐东节重过。\n绕台新柏秀，匝县旧花多。\n海色摇行幰，山云护咏窝。\n谈天君一问，稷下近如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55411,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠孟监司赴任三首 其三","author":"李梦阳","text":"麋鹿游山性，蛟龙卧水心。\n得云终一起，食野不孤吟。\n汝去观沧海，予常慕孔林。\n何时挈尊酒，同蹑太山岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55412,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送谭子二首 其一","author":"李梦阳","text":"国谥逾年至，王臣触暑行。\n水花邀去节，山鸟劝离觥。\n久客交人广，携家念土轻。\n玉筵颁扇目，应注使回名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55413,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送谭子二首 其二","author":"李梦阳","text":"聚赏蜂初课，分携燕巳雏。\n泥惊落夏簟，花忆倒春壶。\n水路风旗进，晴船暑气无。\n五云赤日外，缥缈是皇都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55414,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠监察阻雨郊馆","author":"李梦阳","text":"积雨淹征旆，层城隔论文。\n一尊真惜酒，万里正横云。\n京国骢谣属，闽江道派分。\n美名吾实羡，何处接高芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55415,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庭菊纷披有怀王喻二君子","author":"李梦阳","text":"雁急秋真晚，园空菊自黄。\n露团番有色，风度不随香。\n却忆初开日，君来夜把觞。\n忍今看烂熳，独绕碧篱傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55416,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]