[{"title":"习家池","author":"林光","text":"平生双老眼，又认习家池。\n瘦影含方境，晨风绉绿漪。\n寺荒疑隐窦，诗灭更无碑。\n一歃烟霞味，人间或未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谷隐寺","author":"林光","text":"肩舆绕回涧，四月麦初黄。\n澹澹来薰风，葛襟任飘扬。\n山门在何处，松桧森护藏。\n雨馀绿正肥，丽日浮晴光。\n葵榴傍佛阶，喷艳倾和阳。\n褰衣步巉岩，尚幸筋力强。\n方袍三两僧，延我到上方。\n安知无远公，愧我非柴桑。\n谷虚自有应，山远无摧伤。\n众生沉苦海，吾欲驾津梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52433,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五朵谒宪王墓","author":"林光","text":"名香赍入万山层，西汉何因羡霸陵。\n圣主思波深玉牒，姬公肝胆在金縢。\n幽明不隔千峰耸，际会难逢百感增。\n五朵山前向谁语，涧声飞绕碧云凝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52434,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游大承恩寺","author":"林光","text":"古寺藏虚谷，追寻路忽穷。\n千峰杯酌里，万木笛声中。\n细雨和烟洒，洪泉穴地通。\n方袍僧几个，欢撞赐来钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52435,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临坪道中","author":"林光","text":"沾衣不足惜，五月雨生凉。\n崖树层层画，山花淡淡妆。\n肩舆穿绝峤，步涧背馀觞。\n百里临坪路，来拈一炷香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52436,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临坪谒定王墓阻雨","author":"林光","text":"密雨漫空不放晴，山田溪涧潦将平。\n昌黎昔被衡山误，杜老曾烦聂尹迎。\n衣湿尚堪怜仆从，香拈直欲格神明。\n黑甜唤醒王庄梦，安得鸣鸠三两声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52437,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中谒简王墓","author":"林光","text":"雄压山窝虎豹逃，丹青盘搆可胜牢。\n步参无计停朝雨，衣湿何妨触野蒿。\n古树排来襄嶂合，伏龙飞去蜀天高。\n隆中莫问要离冢，云木东祠是汉豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52438,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隆中谒诸葛武侯","author":"林光","text":"君臣天地本难逃，谁道先生睡不牢。\n三顾江山增感慨，千年祠宇肃焄蒿。\n欢同鱼水知犹浅，迹比萧曹识更高。\n运去营中星忽殒，未降心醉几英豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52439,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隆中遇雨","author":"林光","text":"隆中留胜迹，冒雨我能来。\n树洗层层翠，溪喧滚滚雷。\n草深诸葛庙，云罩简王台。\n安得长风扫，阴霾拨未开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52440,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答庄国华仪宾三首 其一","author":"林光","text":"七夕谁家送酒频，南阳一骑走红尘。\n铜鞮唱月延今我，岘石沉江笑昔人。\n秋嶂挥杯添话柄，暮云翘首忆儒绅。\n常疑诸葛增烦恼，不向隆中作逸民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52441,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答庄国华仪宾三首 其二","author":"林光","text":"明月清风不用求，乐天知命亦何忧。\n董生已破江都梦，穆子空怀醴酒愁。\n秋气入帘残暑尽，晚山当座白云留。\n缄书何日逢知己，寂寞心随造化游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52442,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答庄国华仪宾三首 其三","author":"林光","text":"千里神交感至情，远持书币到襄城。\n岘碑老泪今谁堕，汉水真源拟共评。\n潦倒几回尝世味，疏慵深恐负诗盟。\n梅花香浸罗浮梦，已对澄潭一镜平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52443,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"保和堂为唐殿下题","author":"林光","text":"朱甍碧瓦照南阳，争羡明禋有此堂。\n对越每加临上帝，孝思时或见先王。\n斋居四面存箴警，宗社千年共寿昌。\n磊落高楼咸显庆，昔人何事独流芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别储冬曹子充","author":"林光","text":"恩洽王封土未□，爱君真觉别君难。\n岘碑泪感何人堕，坏冢山新此日观。\n杯酒寻常倾肺腑，江风容易起波澜。\n肩舆一笑惊相失，目倦东吴路渺漫。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"汉江临泛","author":"林光","text":"幽兴不可遏，江源何处通。\n船移春水上，人醉画图中。\n远树排青嶂，澄波映碧空。\n铜鞮旧襄曲，也任聒南翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书堂十咏奉和少司寇新昌何世光先生韵 其一 竹","author":"林光","text":"繁枝争洗几梢斜，清绝当轩更莫加。\n春老虚心还自挺，岁寒直节却堪嘉。\n声谐韶管仍须制，影舞祥鸾不受拿。\n李径桃溪从艳治，东风容易扫浮夸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书堂十咏奉和少司寇新昌何世光先生韵 其二 柏","author":"林光","text":"根夺从教径草萎，年深雨露益清奇。\n閒扳凤翅衣裳拂，吟傍蟉枝屐屡欹。\n蜀庙流传苍古干，杜陵描尽岁寒姿。\n品题又落先生手，岂待吾侪更著诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书堂十咏奉和少司寇新昌何世光先生韵 其三 荷","author":"林光","text":"矮著轩窗高著台，池荷亦任傍欹梅。\n薰风香里花饶笑，急雨声中翠作堆。\n倒影当窗从戏舞，捲筒排日醉徊徘。\n元公一点无言意，不用穷搜向九垓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书堂十咏奉和少司寇新昌何世光先生韵 其四 菊","author":"林光","text":"在处移根在处安，灵苗应不惮春兰。\n节当重九偏增重，人过渊明却解看。\n秋气催花香淡淡，月华凝叶影团团。\n岁寒篱落霜清后，谁表贞心上笔端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书堂十咏奉和少司寇新昌何世光先生韵 其五 碧绛桃","author":"林光","text":"几树轩西几树东，满机云锦织春风。\n轻粘瑞雪枝交白，晴挂绯衣日罩红。\n纵步总堪供老眼，仰空何必顾飞鸿。\n平章小放题诗笔，却笑难描造化工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书堂十咏奉和少司寇新昌何世光先生韵 其六 石菖蒲","author":"林光","text":"罗浮山子贮盆池，长养灵苗覆绿漪。\n根托岩崖应任瘦，叶含珠露转清奇。\n夜灯移傍晴消候，药饵餐来老后时。\n莫道春风少浓艳，繁华不竞是天姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书堂十咏奉和少司寇新昌何世光先生韵 其七 黄杨木","author":"林光","text":"秋去看看春复来，每拈时雨洗浮埃。\n婆娑未有贪高意，清寂应怜不竞才。\n数岁未须愁厄闰，避霜终合护根荄。\n东风吹醒游人眼，几凭阑干笑口开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书堂十咏奉和少司寇新昌何世光先生韵 其八 瑞香","author":"林光","text":"淡荡春风扇万山，托根何日到人间。\n歌传香韵莺声滑，舞恋丛枝蝶翅斑。\n名美定从仙子品，花奇亦许野人攀。\n阶前缓纵寻诗步，杖屦东西任往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书堂十咏奉和少司寇新昌何世光先生韵 其九 牡丹","author":"林光","text":"能红能白又能黄，笑倚春风各样妆。\n不向名园誇富贵，却宜上苑对君王。\n轻烟旭日薰朝艳，戏蝶游蜂醉晚香。\n何处洛阳还有会，白头今日且持觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书堂十咏奉和少司寇新昌何世光先生韵 其十 芍药","author":"林光","text":"阶西移植更阶东，叶渐深时花渐丛。\n艳丽可能禁暮雨，娇娆应厌舞春风。\n常因夜露添生意，每借霜根庇老癃。\n留伴花王供赏后，是谁收入药囊中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何司寇抚绥还朝四首 其一","author":"林光","text":"檄书频降自都台，经画曾谙济世才。\n三省遗黎归抚字，一春甘雨不劳催。\n泰山峰顶嗟何及，北斗天边望几回。\n四牡騑騑向金阙，汉江十顷照离杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何司寇抚绥还朝四首 其二","author":"林光","text":"清妥编氓仰硕儒，檄书传布肃规模。\n春阳和煦连三省，度量汪洋隘五湖。\n司府雍雍鳞册就，闾阎帖帖犬声无。\n中原百万收编户，奏最应闻帝曰都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何司寇抚绥还朝四首 其三","author":"林光","text":"肩舆穿破万山烟，江北河南路几千。\n收拾流亡归载籍，抚绥憔悴见青天。\n玺书宠贲名应重，章疏经营事可传。\n献纳还朝春未晚，愿留遗教奉周旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何司寇抚绥还朝四首 其四","author":"林光","text":"山高野旷汉东西，在处流亡此托栖。\n天遣公来深雨露，地宽民乐任耕犁。\n阴云渐散春过半，垄麦初青叶未齐。\n卧辙扳辕仰恩育，先生行矣念群黎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别谭司训","author":"林光","text":"青毡十载怯秋霜，官满先春买楚航。\n元改喜逢亲正德，雪寒难别旧襄阳。\n神驰庾岭添归梦，手拍铜鞮倒饯觞。\n留恋乡心如汉水，送君千里下长江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题梅","author":"林光","text":"春风频剪拂，蓓蕾未全开。\n更著黄昏月，孤山兴渐来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题品物流形图山茶梅莲芍药为庄国华国宾并对联","author":"林光","text":"造化生生不暂休，乾坤万物本同流。\n如何双眼丹青里，祇把烟花四样求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠华仁甫少参致仕东归","author":"林光","text":"天柱峰寒谢胜游，紫薇行省几宜休。\n鹿门忽悟庞公远，岘石难扳叔子留。\n霄汉仰看回健翮，风波何处着虚舟。\n太湖高照东吴月，且放渔歌到枕头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再赠","author":"林光","text":"参佐名藩仗俊才，乞身飞疏入金台。\n人间晴雨浑无定，天际浮云任去来。\n薇省无缘淹凤鸟，棠阴遗爱洽蒿莱。\n锡山归□□□杖，花萼争随笑口开。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"改建武侯庙开基宿隆中","author":"林光","text":"责任吾侪不可逃，丁宁先筑此基牢。\n人龙二表开心胆，盘谷千年蔽野蒿。\n吼虎忽闻山口震，夜窗流照月儿高。\n武侯祠宇间关在，招手襄阳几俊豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隆中武侯庙成次前韵","author":"林光","text":"妖狐狡兔已奔逃，忠武新祠结搆牢。\n三顾声华盖襄汉，千年祀典贲蓬蒿。\n丹青草野云龙会，森爽峰峦栋宇高。\n几向隆中回首处，梦魂缥缈见人豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侵晨出郭候陈提学往隆中","author":"林光","text":"胜处无多路，斯文有夙缘。\n风轻催柳拜，霞早映花妍。\n簇簇山迎鸟，飘飘衣罩烟。\n隆中何限景，一一待诗传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隆中谒武侯陪陈提学佥宪二首 其一","author":"林光","text":"卧龙胜处久模糊，寻访欢承拉老夫。\n三顾迹经今日眼，千年人貌旧时图。\n躬耕活水田犹在，抱膝苍崖石尚孤。\n莫道斯文没关系，风光随处偃莱芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隆中谒武侯陪陈提学佥宪二首 其二","author":"林光","text":"薇蕨山中口可糊，人龙泯迹在农夫。\n遭逢未感三回顾，成算先开八阵图。\n割据英雄时已去，经纶天地迹何孤。\n祠前俛仰千年下，樽酒斜阳洒绿芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"承提学佥宪陈先生垂顾用杜子美严公仲夏枉顾草堂韵","author":"林光","text":"瓜菜装排老瓦盘，先生含笑驻金鞍。\n景撩岘首诗泉涌，酒劝铜鞮量海宽。\n雨到分龙犹恨少，天当小暑尚微寒。\n论文共有无穷意，不尽樽前竟日欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隆中武侯庙揭扁二首 其一","author":"林光","text":"圣断重闻感若何，翼然轮奂起盘窝。\n扁悬忠武真无忝，恩盖隆中永不磨。\n灵肖罗池诛慢侮，祭堪梁父入登歌。\n戊辰告庙当残腊，寒怯梅花放未多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隆中武侯庙揭扁二首 其二","author":"林光","text":"卧龙迹灭可如何，栖庙山阳有此窝。\n华扁却从天上赐，穷碑留待意中磨。\n贪贤礼忆三回顾，旌德诗从万口歌。\n千古隆中千古祀，大明恩典实蒙多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊辰重九携子时表衷登岘石岩","author":"林光","text":"旱极谁家菊解开，清秋老兴若为栽。\n乾坤一雨山将变，父子三人马续来。\n醉杖鸠藤哦旧句，笑扳崖石拂枯苔。\n未须计度明年事，且尽岩边入手杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朝使还京","author":"林光","text":"分封藩国莅襄台，骏骨应从渥水来。\n节册自天当日降，王心如日拨云开。\n欢声合奏铜鞮曲，暑汗连挥琥珀杯。\n留得习池清喷玉，沃君真当浴沂回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵龚中贵桃竹感之作","author":"林光","text":"才长何事不堪兼，桃竹诗催信口占。\n绛袖绯袍欺蜀锦，虚心直节挺羲炎。\n藏春静看千蜂舞，栖凤真无一鸟嫌。\n老兴喜将霜韵步，西施镜里刻无盐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南阳庄国华国宾诗来徵文次韵奉答","author":"林光","text":"晚仗遗经自警箴，乾坤曾不乏知音。\n人逢会意少逾老，天有何言古到今。\n岘石每嫌标姓字，汉江偷把濯陈襟。\n独怜八代文衰后，费尽元和一老心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉次徽王韵赠毕亚卿豫荆凶荒黎民阻饥朝廷简命亚卿毕公兼都宪来膺赈恤重任王有诗嘉赠因次韵少申颂期之意","author":"林光","text":"中原万姓岂愁饥，天遣公来任抚绥。\n在处流亡俱引领，会看愁苦变雍熙。\n甘霖终慰群生望，草芥能忘一日知。\n野史大书消几句，汉江那用更沉碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"襄阳戊辰除夕遣怀","author":"林光","text":"春光残腊领年光，赏雪趺跏坐北堂。\n醴酒挥杯还自设，好山驱马逐谁忙。\n閒从乐地安心地，老把他乡作故乡。\n旋买河田供百指，东坡阳羡我襄阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己巳仲春王承吉招游习池因谒乃祖忠节祠墓遂同侍御曹西泉伯仲彭副郎文卿徜徉尽日而还","author":"林光","text":"白云双袖带天香，忠节祠参谷隐傍。\n春半花开兼蓓蕾，风和柳舞任低昂。\n巉岩岭峻登还怯，苍翠林深步更长。\n返照在山杯在手，诸君能不为诗忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李岳台别驾至日有感","author":"林光","text":"恩联九族想神尧，沾禄名蕃愧圣朝。\n安养微阳看渐复，淡浇元酒醉还消。\n光芒仰斗枢应转，清艳藏梅雪未彫。\n更待融和春意满，鞭羸吟傍鹿门桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三过曹侍御见庞亭叠韵二首 其一","author":"林光","text":"豸冠高挂已多年，兴寄孤亭落翠烟。\n庞老风情先我得，鹿门山色向谁妍。\n诗寻碧嶂千峰拱，心洗长江一练悬。\n吏隐安知无二仲，更开池阁醉花仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三过曹侍御见庞亭叠韵二首 其二","author":"林光","text":"匾山三过阅三年，仰止庞亭罩绿烟。\n汉水却来开眼界，鹿门终不为诗妍。\n辍耕羡彼辞明府，纳拜何人解倒悬。\n老我罗浮归未得，梦魂空迓铁桥仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读果庵传","author":"林光","text":"果庵面目信何如，磊落平生传翠渠。\n墓木文山今已拱，野航义水旧曾渔。\n献投力却扶孤寡，诬枉终明庇里闾。\n有父有兄还有子，一门荣耀总堪书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南川别墅四首 其一","author":"林光","text":"南川都里迓南川，此境宁知非夙缘。\n活水周遭来不竭，好山奇绝列当前。\n辋川笑任王维老，颖地堪供欧九眠。\n指日微官沙汰去，寻僧问寺了衰年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南川别墅四首 其二","author":"林光","text":"龙门胜迹照三川，梦里他时会此缘。\n苗垄细分千涧下，雨云轻罩万峰前。\n衡茅小搆无多费，身事閒添几觉眠。\n醴酒未须谈际遇，尚凭泉石引吾年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南川别墅四首 其三","author":"林光","text":"谷国南来讯后川，平生踪迹浪随缘。\n春深却任花含笑，涧曲从教马不前。\n野叟田夫真任狎，土墙茅屋暖堪眠。\n赛神听得人欢语，尽道今年又有年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南川别墅四首 其四","author":"林光","text":"勒马斜阳渡汉川，风波回首信天缘。\n身随蜀相躬耕后，心出羲爻未画前。\n玉粒香粳添日膳，草茵松榻饱宵眠。\n儿曹更祝公强健，尽道今年胜旧年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"食鲜虾","author":"林光","text":"寻常波浪汉江滨，五载鲜甜不入唇。\n若道菜根魔未了，也应亏煞岭南人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶书","author":"林光","text":"长腰粳米秧初插，缩项鳊鱼网未开。\n谁道王官无好况，旋烧庭笋引磁杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六月十六夜宿万山迓少保大司寇总制洪两峰先生四首 其一","author":"林光","text":"冒暑来无远，寻幽此借眠。\n碑潭晴浸月，粲井静窥天。\n竹密知风动，林深觉鸟便。\n悠然坐清晓，葛袂罩浮烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六月十六夜宿万山迓少保大司寇总制洪两峰先生四首 其二","author":"林光","text":"伏夜山初旦，虚檐鸟聒眠。\n云霞俱捧日，晴雨未占天。\n寺隐幽兰胜，江来舴艋便。\n无人会心曲，搔首绿杨烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六月十六夜宿万山迓少保大司寇总制洪两峰先生四首 其三","author":"林光","text":"凉浸万竿竹，清恬一夕眠。\n澄江深洽地，明月正当天。\n山水僻元在，云霞性本便。\n会看贤总制，功业照凌烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六月十六夜宿万山迓少保大司寇总制洪两峰先生四首 其四","author":"林光","text":"狐鼠穿邻穴，干戈炒夜眠。\n元戎临重地，恩雨降皇天。\n暑汗挥何谢，江船泛自便。\n分明一宵梦，香傍将坛烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]