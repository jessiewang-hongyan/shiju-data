[{"title":"李陵台明妃冢","author":"庞尚鹏","text":"北望中原隔虏庭，汉家遗恨付沧溟。\n李陵台下多芳草，不似明妃冢上青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏武城","author":"庞尚鹏","text":"夜听胡笳鬓尽丝，暗看南雁忆归期。\n黄沙白草空明月，忍读河梁送别诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"姜女石","author":"庞尚鹏","text":"独立风涛咽海濒，梦回空见月重轮。\n六宫粉黛秦楼夜，谁望沙丘一怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华表柱","author":"庞尚鹏","text":"化鹤重来见此身，当年华表已成尘。\n神仙本是人间梦，何处桃源可问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入山海关","author":"庞尚鹏","text":"辽阳新草未抽芽，关上红梅满树花。\n塞外风烟原自别，从来春早是京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答临干云谷二首 其一","author":"庞尚鹏","text":"春水年年上钓矶，扁舟今趁暮潮归。\n羊裘已被虚名累，须向沧洲著布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答临干云谷二首 其二","author":"庞尚鹏","text":"龙跃云从岭外村，江头白日雨翻盆。\n纷纷世事如棋局，西望长安欲断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答弼唐兄","author":"庞尚鹏","text":"罢钓空江水绕矶，无鱼偏载月明归。\n东陵已卜宜瓜地，谁向青门问布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别孔临干凡六年偶泛舟过桥下望水竹新居勃然有怀","author":"庞尚鹏","text":"蒋径新开曲水滨，桥头花发万家春。\n牵牛更向前湾饮，恐有当年洗耳人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与苏近斋年兄对榻话旧二首 其一","author":"庞尚鹏","text":"澹澹秋光似宦情，浊醪深酌道平生。\n归来梦断长安路，犹记当年听鹿鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与苏近斋年兄对榻话旧二首 其二","author":"庞尚鹏","text":"月上东亭水接天，春风吹送钓鱼船。\n长公曾是西湖主，愿借苏堤柳下眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿邵端台","author":"庞尚鹏","text":"一笔丹青载五湖，晚凉新月醉莼鲈。\n他年许结长眉社，重作香山九老图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别乐平高秀才","author":"庞尚鹏","text":"万壑风声漱玉泉，长亭尊酒醉离筵。\n东归父老如相问，春早江头一钓船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别乐平舒子长礼部儒士","author":"庞尚鹏","text":"世路浮沉叹奕棋，十年尘梦各天涯。\n侧身大笑风雷动，肯为穷愁两鬓丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乐平旧友过草堂告予北行","author":"庞尚鹏","text":"文园曾道漱孤芳，亲捧词头下玉堂。\n若与马周同客邸，好将封事付何常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端阳日次韵寄寿周云谷","author":"庞尚鹏","text":"莫问诗仙与酒仙，相携飞舄遍山川。\n行歌五岳随明月，每处峰头住十年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠筠台戴太守还闽","author":"庞尚鹏","text":"五岳何人共采芝，昼游应恨得归迟。\n梦回莫问邯郸路，秋早携家入武夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居避俗二首 其一","author":"庞尚鹏","text":"避秦休问入桃源，避世何须金马门。\n欲访草堂何处是，石桥流水百花村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居避俗二首 其二","author":"庞尚鹏","text":"风起松阴鸟乱啼，五云深处有丹梯。\n閒来送客岩前路，一笑应忘过虎溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得戴筠台太守游山记","author":"庞尚鹏","text":"重岩千仞遍跻攀，天遣浮生几度閒。\n马首断烟随鸟没，却从云外见冰山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白沙先生像","author":"庞尚鹏","text":"倡道东南接孔林，谁从山海测高深。\n千年遗事传青简，白日青天是此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诗柬不书名","author":"庞尚鹏","text":"曾讶人间月旦评，雌黄原自口中生。\n年来正苦虚名累，莫遣儿童识姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻有司议赈","author":"庞尚鹏","text":"一饱从来不愿馀，幸分官廪到穷闾。\n长鲸便欲吞溟渤，升斗犹能活涸鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆亡弟次韵","author":"庞尚鹏","text":"从来死别最堪怜，况复同胞更少年。\n泪洒鹡鸰原上草，不堪衰谢老江边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀关玄门累期不至","author":"庞尚鹏","text":"片言为药借神功，瞬息能令业障空。\n回望双凫如万里，尺书无路托飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"猫卧花下石山","author":"庞尚鹏","text":"横天剑气夜光闾，晚入重楼护赐书。\n赢得花阴閒白昼，敢论终岁食无鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周云谷枉顾别后寄怀次韵","author":"庞尚鹏","text":"万木丛中一钓台，满湖烟水百花开。\n江村不是瞿塘路，莫惜乘潮百度来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送别还城次韵","author":"庞尚鹏","text":"艳阳朝气杏花天，楼上青山湖上船。\n风雨临池看醉墨，令人长忆酒中仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪亭新筑石径漫题","author":"庞尚鹏","text":"廿载瞿塘路上行，惊魂飘泊叹浮名。\n从今稳步随明月，肯信风涛陆地生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东门别业为陈二山太守题","author":"庞尚鹏","text":"倚郭芳阴石径斜，鸟声人语带烟霞。\n东门远地春光早，多种秦侯五色瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渔","author":"庞尚鹏","text":"东倚扶桑共结邻，轻舟长载日华新。\n夜来风雪连天地，信有寒江独钓人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"樵","author":"庞尚鹏","text":"万树芳阴日往还，长随玄鹿入松关。\n春深何处寻行迹，洞口云开便出山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"耕","author":"庞尚鹏","text":"斜倚溪流屋数椽，自分粳秫种溪田。\n君恩一饭终难报，长对春晖百草前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"牧","author":"庞尚鹏","text":"短褐风前夜饭牛，满天明月更何求。\n青山芳草眠黄犊，特向沧江饮上流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访黄山人二绝 其一","author":"庞尚鹏","text":"绿树丛阴草屋春，满庭鸡犬若无人。\n入门却恨逢君晚，一笑惊看折角巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访黄山人二绝 其二","author":"庞尚鹏","text":"披襟谈笑动梁尘，白发原非避世人。\n三尺皂囊频□检，万言书在墨犹新。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邻翁问治生口占一绝","author":"庞尚鹏","text":"长啸须寻阮步兵，醉来高枕一身轻。\n如何范蠡扁舟去，千载犹传货殖名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋天","author":"庞尚鹏","text":"冥鸿万里知何处，乱蝉白日鸣高树。\n缥缈江头一片云，朝来散作千山雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁山人夜宿东书堂有述用韵寄酬","author":"庞尚鹏","text":"俯仰空斋常晏如，圆天为盖地为舆。\n坐看千古经纶事，却恨从前不读书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早起用韵 其一","author":"庞尚鹏","text":"梦里乾坤何处静，纷纷局面还谁胜。\n东园曙色天欲明，翩翩蝴蝶穿花径。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早起用韵 其二","author":"庞尚鹏","text":"门前如市心如水，懒学邻翁鸡鸣起。\n五湖天远驾扁舟，陶朱不是鸱夷子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐 其一","author":"庞尚鹏","text":"北斗移天拱帝星，流光长照太玄经。\n俄看子夜风雷起，尽撼人间百梦醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐 其二","author":"庞尚鹏","text":"银河高挂玉楼前，笑拂彤云尺五天。\n几处关山明月好，何人终夜不成眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄夔州郭使君 其一","author":"庞尚鹏","text":"五马行春出凤城，故人天上岂无情。\n十年醉卧平津阁，肯似淮阳对月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄夔州郭使君 其二","author":"庞尚鹏","text":"几年相望隔河梁，独有渔舟系绿杨。\n夜雨江头春睡足，不知何处是瞿塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幽独","author":"庞尚鹏","text":"扫叶烹茶数米炊，几番啼鸟上花枝。\n晴檐对日心如水，不读兵书不看棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹下乘凉","author":"庞尚鹏","text":"绿雪飘飘阴复晴，园林啼鸟似秋声。\n萧然一枕羲皇世，万事浮云百虑轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题寄南华寺 其一","author":"庞尚鹏","text":"曾道南宗胜北宗，天王岭上秀高峰。\n卧游笑指曹溪路，宝树花前意万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题寄南华寺 其二","author":"庞尚鹏","text":"上方台殿拂云齐，俯阚悬崖枕碧溪。\n卓锡便寻花果院，绿杨啼鸟万山低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送提督武学金冲庵主政考绩","author":"苏季达","text":"谈经较艺数登坛，天与全才间世贤。\n老我亦闻青幕诀，少年多荷素书传。\n芰荷香远迎文旆，杨柳阴浓递玉鞭。\n奏绩迥怜当胜日，悬知晋接御阶前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其一 行行重行行","author":"姚光虞","text":"寒日照疏林，北风何冽冽。\n河梁一分手，即为万里别。\n去去把征衣，遥遥望车辙。\n君行何当还，令我中抱热。\n玄冬繁冰霜，江河迥且长。\n居常同室欢，奄忽隔两乡。\n辰参东西驰，日月互相望。\n但嗟行者远，谁怜居者伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其二 青青河畔草","author":"姚光虞","text":"灼灼池中花，茸茸涧边草。\n婉婉青楼女，粲粲颜色好。\n悠悠理朱弦，缓缓歌窈窕。\n游子行不归，日夕念远道。\n空房寂无人，沉忧涕盈抱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其三 青青陵上柏","author":"姚光虞","text":"青青松与柏，轮囷山之阿。\n人生寄一世，迅速如颓波。\n及时为欢娱，有酒且高歌。\n遨游宛洛间，騕袅鸣玉珂。\n宛洛多王侯，邑里竞繁华。\n车马日缤纷，第宅郁嵯峨。\n别馆接离宫，一一凌烟霞。\n恣意且游瞩，戚戚将如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其四 今日良宴会","author":"姚光虞","text":"佳辰倡高会，广宴陈中堂。\n宾友满四座，冠佩鸣锵锵。\n绮错一何纷，琬液流霞觞。\n堂上鼓瑟琴，堂下吹笙簧。\n即此娱心意，相与复翱翔。\n佳辰岂易得，欢会安可常。\n少年不为乐，老至徒慨慷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其五 西北有高楼","author":"姚光虞","text":"高楼一何高，岧峣乃百尺。\n绮疏凌层霄，飞甍临广陌。\n其中多佳人，一一倾城色。\n弦歌发新声，宛转谐金石。\n馀响入青云，高唱娱日夕。\n往来道旁者，岂无知音客。\n安得褰衣裳，和歌于其侧。\n日暮门墙外，伫望空叹息。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其六 涉江采芙蓉","author":"姚光虞","text":"江干有芙蓉，泽畔多芳芷。\n涉江复泛泽，采以致君子。\n延伫天之涯，相隔乃万里。\n远道不得达，惆怅情何已。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其七 明月皎夜光","author":"姚光虞","text":"迢迢仲秋夕，璧月扬素辉。\n仰视河汉间，灿灿明星稀。\n白露泫庭柯，蟋蟀鸣声悲。\n鸿雁天际翔，岁暮将何之。\n言念平生欢，结交贫贱时。\n一朝致青云，弃我如敝帷。\n物候有变迁，人情难久持。\n友道日荆棘，叹息谷风诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其八 冉冉孤生竹","author":"姚光虞","text":"郁郁庭中树，生为连理枝。\n结发成婚姻，恩爱两相宜。\n如何远行迈，悠悠在边陲。\n一去今十年，轩车未旋归。\n不见园中花，当春竞芳菲。\n采采不及时，零落将何为。\n我心信匪石，不可以转移。\n愿君怀夙欢，毋忘皓首期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其九 庭中有奇树","author":"姚光虞","text":"迟迟艳阳日，蔼蔼众芳发。\n忽忆同心人，经时向吴粤。\n采芳欲遗之，天长路难越。\n卷置怀袖中，馨香何由彻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其十 迢迢牵牛星","author":"姚光虞","text":"天际有灵匹，河汉日相隔。\n一水何悠悠，可望不可即。\n七襄久脱骖，机杼恒罢织。\n岂无欢会期，望渺初秋夕。\n伫立河之干，含情泪沾臆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其十一 回车驾言迈","author":"姚光虞","text":"策马出郊圻，行行即长路。\n西风莽摇落，百卉悉非故。\n荣枯自有时，人生苦不悟。\n少壮能几何，忽焉已衰暮。\n混混大化中，终同草木腐。\n不朽在荣名，勉旃早自树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其十二 东城高且长","author":"姚光虞","text":"高城郁崔嵬，阿阁壮且丽。\n复道相回环，云雾森亏蔽。\n郊墟草树黄，飒飒北风厉。\n狐兔走平陆，荏苒将暮岁。\n青楼有佳人，倚柱多幽思。\n当此摇落时，怀人不能置。\n闭户理朱弦，宫徵一何备。\n曲罢仍徘徊，清歌助悲慨。\n含意将告谁，沉忧叹寤寐。\n思为兰麝香，得近君衣被。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其十三 驱车上东门","author":"姚光虞","text":"晚出城东门，落日照高树。\n衰草遍郊原，松楸绕长路。\n草间何累累，前代公侯墓。\n翁仲卧荒烟，残碑断以仆。\n嗟彼地下人，在昔贵而富。\n一朝即玄堂，终古如长暮。\n时移与代迁，子孙不知处。\n俯仰慨今昔，胡为不觉悟。\n挈榼且携壶，及时且游豫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其十四 去者日以疏","author":"姚光虞","text":"处世若传舍，今古相推迁。\n出郊试骋望，迥野俱荒阡。\n人匪金石伦，谁能久延年。\n贵贱同物化，荣辱亦茫然。\n自拟挽歌词，叹此达者贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其十五 生年不满百","author":"姚光虞","text":"人生七十稀，而况年至百。\n所贵能达生，徒忧亦何益。\n诞者求神仙，愚者爱金帛。\n不如且置酒，长筵日招客。\n百年如隙驹，岁月良可惜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其十六 凛凛岁云暮","author":"姚光虞","text":"霜雪载道路，鸿雁鸣声悲。\n游子万里去，越在天之涯。\n北风何凄凄，远道寒无衣。\n尺书久不来，日夕怀音徽。\n冉冉芳岁徂，行客无还期。\n不惜岁月迈，所忧华发滋。\n独宿空房中，思君久徘徊。\n明月照绮窗，疏灯鉴重帏。\n寤言长相思，涕下不可挥。\n离忧千万端，卑怀君讵知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其十七 孟冬寒气至","author":"姚光虞","text":"时维孟冬夕，天气凄以清。\n寒飙入高树，霜露浩且盈。\n起视夜何其，河漠见参横。\n蟋蟀入我床，蛩螀草间鸣。\n逝节何迅速，感时偏多惊。\n脉脉步前除，中抱不自明。\n良晤何悠悠，胡以慰我情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其十八 客从远方来","author":"姚光虞","text":"故人渺天末，遗我一尺书。\n书中复何言，但言久离居。\n当时游子衣，貂裘敝无馀。\n去日犹少壮，今已毛发疏。\n卷书不能读，陨涕沾衣裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古十九首 其十九 明月何皎皎","author":"姚光虞","text":"遥夜不能寐，揽衣起凭栏。\n皓月流中闺，明河亘天端。\n怅然忆远人，川原浩漫漫。\n君去行役劳，妾处多苦艰。\n契阔慰何时，俯首为泛澜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂咏 其一","author":"姚光虞","text":"客有嗟王嫱，自恃好颜容。\n一失画者欢，远丧胡尘中。\n汉后去掖庭，久处长门宫。\n已购长卿赋，承恩以始终。\n予前对客评，不见汉祢衡。\n声名起鹗荐，遂为江夏倾。\n秦政急逐客，李斯不肯行。\n宠利为祸媒，毕竟具五刑。\n近燎势多焦，争道寡全軿。\n薄劣守穷贱，且以安吾生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]