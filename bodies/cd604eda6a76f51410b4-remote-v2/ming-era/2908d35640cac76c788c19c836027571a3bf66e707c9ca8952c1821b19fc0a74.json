[{"title":"喜雨","author":"孙蕡","text":"崆峒云气远嶙峋，万片从龙下孟津。\n三月久晴农事晚，一时甘雨帝城春。\n蟠桃花发丹砂炫，御柳条长翡翠匀。\n老我宦游归计阻，仙台几度药苗新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀旧游寄李士行","author":"孙蕡","text":"忆上高台望赤霄，火轮光动彩虹飘。\n鲛人夜织明珠佩，龙女晨参绛节朝。\n迤北关山周正朔，平南将校汉嫖姚。\n狂游又是三年别，海上蟠桃露气销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄高彬","author":"孙蕡","text":"条风二月古隋堤，杨柳青青拂水齐。\n万里客怀将白发，一年春信又黄鹂。\n亲朋岁久愁多望，故国书成醉懒题。\n惟有别君情不浅，梦中时到石城西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蔡九节还南安","author":"孙蕡","text":"向年为客怕逢秋，每见春来忆旧游。\n归梦夜随寒雨急，片帆飞逐大江流。\n看山有兴还堪写，惜别从来不解愁。\n斗酒殷勤拚一醉，相思何处却登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴寄端方故居","author":"孙蕡","text":"乱藤高竹散清烟，独倚阑干思渺然。\n流水恨随春浦阔，故人家住白云边。\n三年远别空相忆，一段新愁自可怜。\n欲得山阴晴夜雪，东风吹放大江船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西岩图 为严彦恭题","author":"孙蕡","text":"欲写沧浪愧不才，画图今喜见君开。\n峰峦影落寒潭静，欸乃声从返照来。\n千顷白波龙伯国，百年高兴子陵台。\n闻君早晚趋金阙，风雨渔矶长绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人还乡","author":"孙蕡","text":"岁晏那堪送独归，石门烟树晚依依。\n几回客思愁江浦，十幅蒲帆挂夕晖。\n沽酒乍闻何处笛，问程应为故山薇。\n到时犹想多幽兴，一乐堂深见舞衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀白云山房","author":"孙蕡","text":"家住沧洲洲上山，数椽茅屋乱云间。\n天晴叠嶂开金碧，雨过清泉响佩环。\n高兴别来长寂寞，故人谁与共跻攀。\n洞门猿鹤应相问，何事先生久未还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再寄罗友章先生","author":"孙蕡","text":"白发中林老散仙，别来长拟共周旋。\n凤台僧舍秋题壁，兰石清溪夜扣舷。\n渔唱晚霞红蔼蔼，醉吟夜月白娟娟。\n无因一献长杨赋，辜负清游四五年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"征南将军回京","author":"孙蕡","text":"统领貔貅净海隅，封狐狡兔总消除。\n风雷自昔凭神算，巢橹从今息战车。\n不学伏波私薏苡，得如武惠载图书。\n勋阶冠着貂蝉贵，捷报常看锡帝居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀海珠寺","author":"孙蕡","text":"海上蠙珠占一泓，分明梵宇住蓬瀛。\n虹浮光彩生灵蚌，树拥楼台压巨鲸。\n湘女佩遗存颗粒，商人帆过拂檐楹。\n十年京国心南鹜，应负沙头白鸟盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夜","author":"孙蕡","text":"大地白雪似白沙，游子况复未归家。\n寒云黯淡暗海曲，春风浩荡来天涯。\n楚山卢橘渐舒叶，故园枇杷应着花。\n未得乘船出江口，枯坐旅邸如春蛙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出京","author":"孙蕡","text":"水落轻舟搁浅沙，客心长是恋京华。\n祥云晓护钟山树，旭日春明上苑花。\n仙佩每闻催夹仗，宫壶曾记出流霞。\n白头归去丹心在，茅屋三年梦帝家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"之官平原留别诸老","author":"孙蕡","text":"朱衣和泪别龙庭，瘦马嘶风出凤城。\n托迹禁闱原已重，之官名邑未全轻。\n驰驱祇笑儒生拙，悯念难忘圣主情。\n后夜玉堂清夜永，紫薇花月向谁明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别妓","author":"孙蕡","text":"骊驹西上帝皇州，斜抱云和泪暗流。\n子夜歌词翻白雪，残春风物似清秋。\n青鸾信断阳台路，翠被香寒燕子楼。\n七十二泉萦别恨，济南烟树绿幽幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代妓送别","author":"孙蕡","text":"清歌一曲转阳关，况是山城春景阑。\n翠黛愁来空自敛，华容别后倩谁看。\n风过绿酒和花饮，月晃银筝带泪弹。\n此去凤城多近远，到时千万寄平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过扬州怀萧太守惟一二首 其一","author":"孙蕡","text":"不到扬州四五年，凌风台观尚依然。\n天晴锦树开千叶，雨过琼花耀八仙。\n杜牧愁来春寂寂，何郎老去月娟娟。\n风流太守今尘土，谁借缠腰十万钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过扬州怀萧太守惟一二首 其二","author":"孙蕡","text":"二十四桥春水波，东风杨柳客船过。\n关心往事成陈迹，照眼花枝奈老何。\n狂客此时全错落，紫骝无状玉盘陀。\n淡云芳草繁华地，不道游人感慨多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄扬州通府解真白","author":"孙蕡","text":"我与黄昌是故人，也知通守最情真。\n诗如水部翻成癖，官到黄州只自贫。\n妒雪琼花台观旧，行春露冕岁华新。\n悬知别思如春柳，长遣飞花到泗滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金山寺","author":"孙蕡","text":"玄洲贝阙烂相辉，夹岸人家对敞扉。\n四壁波涛长触石，孤山花木自成围。\n横江鹤向扬州去，泛棹僧从建业归。\n迁客凭阑重回首，蓬莱云气晓熹微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送牛应祥都阃","author":"孙蕡","text":"将军淮北分符地，正在隋家古汴河。\n别馆芙蓉飘绣帽，御堤杨柳映雕戈。\n强兵戍久通胡语，降虏年深解汉歌。\n此去看花朝上国，春风天上听鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送夏仲寅之桐城","author":"孙蕡","text":"山到淮西迤逦平，舒州遥对皖公城。\n怜君岁晚之官去，似我年时捧檄行。\n书卷更因为县废，诗篇浑要在朝清。\n寿阳千载遗祠庙，为捋江萍一荐馨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复虹县颜徵士景明","author":"孙蕡","text":"三淮北岸凉威早，六月秋风动虹亭。\n公馆簿书长衮衮，汴堤杨柳自青青。\n愁销楚客文鸳绮，梦返秦仙彩凤翎。\n今雨襟期又云旷，暮云遥隔少微星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高邮","author":"孙蕡","text":"山日未出烟渺茫，高邮放船催下江。\n摇橹唱歌白鹞子，过湖打鼓黄头郎。\n鸟拖云叶低贴水，鱼噀浪花高接窗。\n微官所得几何计，吟鬓四十今苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋风二首 其一","author":"孙蕡","text":"秋风淅淅吹屏山，汴何之水声潺潺。\n归云一似宦情薄，飞雁不将乡信还。\n千峰澹对寂寞景，孤客况栖羁旅间。\n且可狂歌对樽酒，未须惨戚怀江关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋风二首 其二","author":"孙蕡","text":"秋风淅淅吹江亭，汴河之柳犹青青。\n黄姑东渡会七夕，白帝西来朝百灵。\n初开琪树已云落，远别客愁今未醒。\n欲写乡书寄南雁，故园万里天冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虹县九日登五女冢五首 其一","author":"孙蕡","text":"又见殊方风物新，宦情羁思两纷纷。\n楚山南下猿啼树，淮水东来雁拍云。\n黄菊最怜贫靖节，西风还识旧参军。\n远游所得都能几，三载柴扉怨鹤群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虹县九日登五女冢五首 其二","author":"孙蕡","text":"每爱华颠杜曲翁，登台此日对西风。\n吟边菊蕊盈头白，醉里茱萸泼眼红。\n故国音书凭去雁，殊方节物叹飘蓬。\n风流拟欲追千古，寥落谁怜赋未工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虹县九日登五女冢五首 其三","author":"孙蕡","text":"肺气经秋久未平，佳辰酌酒看君倾。\n雨催黄菊非无意，风落乌纱最有情。\n仙客此时缑岭上，彩鸾何处玉箫声。\n逶迟未就丹砂术，俯仰微官愧此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虹县九日登五女冢五首 其四","author":"孙蕡","text":"老去佳辰得几逢，登临此会叹匆匆。\n云来汴水波光白，日落屏山树杪红。\n抱病独怜贫子美，休官惟羡老陶翁。\n遥知弟妹家山里，几向天涯倚断鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虹县九日登五女冢五首 其五","author":"孙蕡","text":"玉女峰头烟树荒，登临聊得散徜徉。\n忽惊重九今朝是，却忆三千客路长。\n冷露馀花偏有色，朔云断雁不成行。\n宁教醉里逢佳节，且免醒来望故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"淮上思家","author":"孙蕡","text":"正月二月花草芳，水鹅拍拍茭菰塘。\n卢橘荔枝赤璀璨，鸡头菱角青相将。\n春光偏向越山好，客路苦阻淮天长。\n飞鸿不解带愁思，空寄音书还故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"淮南赠友","author":"孙蕡","text":"淮水西风吹白蘋，丹枫黄叶总愁人。\n糕糍已入荆州俗，舴艋何时越水滨。\n幸有故人同绮席，可无佳句慰芳辰。\n清吟来拟追韦曲，一笑临风岸葛巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"淮上忆京","author":"孙蕡","text":"去岁兹辰客帝畿，蒋陵西曲雁飞飞。\n秋风丛菊开芳径，落日浮云满翠微。\n老去吟边风物改，别来天上故人稀。\n登临复对青樽酒，醉倚淮山忆禁闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清河口","author":"孙蕡","text":"清河黄河相间流，四月五月如九秋。\n墨云压地箕斗黑，浊浪吐雪鱼龙愁。\n江河万里杳何极，行役半生犹未休。\n故园清兴自不浅，此日松竹风飕飕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"圮上怀古","author":"孙蕡","text":"草没荒台烟树疏，维舟凝眺久踟躇。\n凌波见说求仙履，博浪曾闻误副车。\n勋业赤龙三尺剑，风云黄石一编书。\n独怜衣赭人如玉，鸿鹄歌残怨有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过三洪","author":"孙蕡","text":"官舟已落三洪口，犹在飞流澒涌间。\n放棹忽闻过乱石，开窗始觉慰愁颜。\n云连雪浪瞿塘峡，树隐青泥古剑关。\n谩有微吟追太白，此身疑谪夜郎还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过吕梁二首 其一","author":"孙蕡","text":"二月三月寒尚饶，上洪下洪春雪消。\n奔霆出地星火裂，吼浪触石鼋鼍骄。\n晨昏雾底苍水佩，明灭云中丹凤箫。\n灵风为我送归棹，故国越海天迢迢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过吕梁二首 其二","author":"孙蕡","text":"彭城三月风未和，吕梁雪消春水多。\n浊浪蟠空作飞雨，崩涛薄岸成盘涡。\n鲛人珠佩影明灭，龙女金支光荡摩。\n故山云物几时见，迁客此地长经过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州洪二首 其一","author":"孙蕡","text":"吕梁积石天峥嵘，徐州上洪波稍平。\n蛟龙怒卷四时雨，砥柱乱落三秋星。\n辛夷杜若散洲渚，贝阙珠宫开窈冥。\n舟人倚棹笑相语，九里山色连彭城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐州洪二首 其二","author":"孙蕡","text":"龙门铁石倚天开，仿佛瞿塘滟滪堆。\n万里江风来灏气，九秋晴雪迸惊雷。\n层阴水府和云见，浊浪漩涡划岸回。\n小舣扁舟待明发，霸王台下久徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汉祖庙","author":"孙蕡","text":"长陵见说石麟荒，遗庙丹青野水旁。\n古剑星光时出没，大风云气尚飞扬。\n三秦宝鼎垂鸿业，万岁英魂恋故乡。\n莫怪凭高重回首，楚台烟树郁青苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"项羽庙","author":"孙蕡","text":"武安城郭水光中，云是前王昼绣宫。\n秦汉寂寥悲霸业，烟霞叱吒想重瞳。\n金舆已没三秋草，铁马犹嘶午夜风。\n惆怅夕阳芳草路，一天愁思满江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"歌风台","author":"孙蕡","text":"汉陵秋树起苍烟，故里高台夕照边。\n逐鹿洪图今已矣，歌风遗迹尚依然。\n赤松人去封留后，梦泽云寒狩楚年。\n可是君王思猛士，青峰和雪暗胡天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏马台","author":"孙蕡","text":"盖世英雄亦壮哉，古河三面对荒台。\n汉家陵阙迷春雨，嬴国江山起暮埃。\n雄剑昔年金箓□，龙媒此日锦毰毸。\n乡云一笑山花动，疑是君王衣绣来。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"范增墓","author":"孙蕡","text":"旧识荆州老将名，秋风此日过佳城。\n群雄逐鹿留遗迹，稚子求羊入废茔。\n玉斗有声松雪落，苍精无影石麟横。\n可怜牢落祥云气，又向芒砀谷口生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过黄石公祠","author":"孙蕡","text":"尘编寥落千秋事，野客停舟问隐居。\n烟月高名兴汉后，风云远略避秦馀。\n赤松仙子依丹室，黄石山精护素书。\n岁晚圮桥风物改，泥中履迹近何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过高唐","author":"孙蕡","text":"瘦马嘶春北郭门，郡城茅屋似山村。\n荒坟肸子雄风在，野曲绵驹旧谱存。\n霏雾出林销杀气，行云驻彩阁朝昏。\n千年往事今尘土，寥落幽花酒一尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过东昌与通守王孟璘话旧","author":"孙蕡","text":"天官曾记共论诗，绿幕茅檐昼景移。\n花近鬓丝晴冉冉，日明宫锦暖霏霏。\n黄河水落官舟远，粉署香凝禁漏稀。\n忽忆旧游霄汉上，不知尘土涴征衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过睢宁怀叶知县夷仲","author":"孙蕡","text":"扁舟夜泊睢宁岸，对月临风忆故人。\n嘉树百年留惠爱，华文几度见清新。\n高秋旅馆凋青柳，何处柴门敞翠筠。\n芳岁五湖归棹早，可能同戴紫纶巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客平原春日有怀","author":"孙蕡","text":"怅望乡园去计违，春来惟有思依依。\n客程故向南天远，花信偏于北地迟。\n汉帝苑边卢橘熟，秦陀墓上鹧鸪飞。\n柴门独对东风掩，此日松筠冷翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿高彬第","author":"孙蕡","text":"夜宿故人孤旅邸，更深华月满晴空。\n朋游动是经年别，樽酒宁知此会同。\n上国莺花明戚里，故山松柏语天风。\n豪吟未觉清狂尽，醉里诗成气吐虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽夏尚忠","author":"孙蕡","text":"匹马江南更度关，寒云撩乱扑燕山。\n故乡风物频回首，同辈衣冠竟厚颜。\n使节谩随征雁远，宦情长似野鸥闲。\n黄湾绿水深千尺，此日西风旅榇还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重过玄都观","author":"孙蕡","text":"舜台南下敞壶天，春日桃开锦彩鲜。\n石室丹光长五色，道人神气已千年。\n龙依羽盖听灵籥，树化凫翁礼太玄。\n乱后重来风物改，古坛瑶草绿荒烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀彭万里给事","author":"孙蕡","text":"最爱黄门彭给事，雅怀于我独相亲。\n承恩御果常分赐，应制清诗每动人。\n金雀芙蓉开晚霁，兰苕翡翠戏青春。\n荒凉泗水清宵月，别后遥知梦寐频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈御史孟阳之官西河","author":"孙蕡","text":"几年文墨侍彤闱，妙句曾看对御题。\n翠柏台前听雨漏，金莲炬底立霜蹄。\n当时意气青云动，此日凄迟皂帽低。\n歧路相逢又相别，滦河烟树冷凄凄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠杨主簿时为金银闸坝官天台人三首 其一","author":"孙蕡","text":"寥落清时老孟嘉，向风长是整乌纱。\n西江见说诗无敌，东郡谁怜鬓有华。\n金坝晚飞湖上雨，巾峰晴漾海门霞。\n微官未遂青游愿，辜负仙桃几树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠杨主簿时为金银闸坝官天台人三首 其二","author":"孙蕡","text":"黄河四月动官舟，河上梁山紫翠浮。\n马颊馀波冲岸断，龙门残雪带星流。\n熹微曙气乡心远，飒□凉风鬓影秋。\n遥忆钓鱼洲渚上，几番吟兴付沙鸥。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠杨主簿时为金银闸坝官天台人三首 其三","author":"孙蕡","text":"青齐北地寒威盛，四月黄河雪始消。\n啼鸟落花春寂寂，绿蘋芳芷水迢迢。\n三千客路迷乡国，四十头颅荷圣朝。\n此去定酬山野愿，不烦猿鹤更相招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古河","author":"孙蕡","text":"萧关之北黄河流，昔时禹迹今成邱。\n荒碑苔藓不辨色，古水蛟龙犹有湫。\n野人千载见清浅，海宇万里无戈矛。\n明当作颂献天子，高镌宝册垂鸿猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出关","author":"孙蕡","text":"忘却看花上帝都，出关犹记佩兵符。\n龙归古寺云初定，鸟落寒滩水半枯。\n万古文章关气运，十年风雪老头颅。\n凭将翠管三千牍，换取黄柑二百株。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"骊山","author":"孙蕡","text":"朝元高阁倚嵯峨，十月时巡乐事多。\n宝树天香迎剑佩，青蝇辇路沸笙歌。\n龙头暖浪芙蓉玉，马上喧风蛱蝶罗。\n一瞬繁华千载事，空山寥落后人过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬至","author":"孙蕡","text":"朝来喜色动钟山，云气从龙杳霭间。\n宫扇影摇春仗下，佩环声散早朝还。\n书祥谩有三千牍，献颂长违咫尺颜。\n已拟阴河同结社，遍题新句老江关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"思家","author":"孙蕡","text":"京华薄宦已沾巾，寥落三年济水滨。\n冷雨青灯吟客梦，东风蓬鬓异乡人。\n云涛渺渺沧江暮，榆柳依依旅邸春。\n朋旧别来多野兴，故园应已赏芳辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]