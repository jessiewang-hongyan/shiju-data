[{"title":"留别长春观杨道士","author":"邓林","text":"天上恩承雨露多，归来双鬓未全皤。\n何当学就长生诀，坐看桑田变白波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云村梁纹涧惠茶酝以诗答之","author":"邓林","text":"雪夜乘舟访戴逵，酒醒茶罢兴阑时。\n可人家在村头住，邂逅相逢似故知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画犬","author":"邓林","text":"宋鹊韩庐迹已遐，世无乌琢与桃花。\n野人相遇惊相问，偃盖山前是我家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题郑进士雨竹二首 其一","author":"邓林","text":"笔底金刀叶叶奇，分明彩凤舞朝晖。\n无因醉墨淋漓洒，又见群鸦带雨归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题郑进士雨竹二首 其二","author":"邓林","text":"谁将浓墨写疏寒，秋意萧萧玉一竿。\n绝似湘妃祠下过，篷窗半掩雨中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松涧图","author":"邓林","text":"错节蟠根拥肿形，风霜雨露备曾经。\n也知才大难为用，留擅浮山涧底青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梧竹","author":"邓林","text":"珍重伊人识远图，满庭栽竹更栽梧。\n他年竹实梧桐老，应为明时养凤雏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"菖蒲","author":"邓林","text":"灵根九节可延年，故尔多栽水石边。\n若得安期传妙诀，定应凡骨也成仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蕙","author":"邓林","text":"□泽佳人翠带长，萧萧独立晚风凉。\n灵均已矣知心少，深谷颠崖只自芳。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪山","author":"邓林","text":"白云隐约露山村，茅舍人家尽掩门。\n不有桃花随水出，谁知洞里是桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赏菊","author":"邓林","text":"东篱昨夜菊花开，邻舍人家酒酦醅。\n藜杖芒鞋由一幅，先生正是赋归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题牡丹四幅风","author":"邓林","text":"翠罗襟袖起飘飘，斜倚东风态度娇。\n兰麝锦囊原不结，擅心散粉异香消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晴","author":"邓林","text":"多谢东风巧剪裁，深红浅碧一时开。\n晴雷隐隐天无雨，知是香逵绣縠来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨","author":"邓林","text":"粉红狼藉晓妆残，泪雨盈盈倦倚阑。\n自是绛罗衫袖薄，不胜憔悴为春寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"露","author":"邓林","text":"妆镜台前酌□□，□明画出越西施。\n酒痕□□□□□，□□□□□□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渊明归去图","author":"邓林","text":"柴桑松菊正宜秋，典午衣冠尽姓镏。\n长啸一声赋归去，清风高节振林丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赵仲穆画马二首 其一","author":"邓林","text":"清风辇路净无埃，岁逐奚官立仗回。\n不是良工模写去，世间那得见龙媒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赵仲穆画马二首 其二","author":"邓林","text":"千金骏骨岂寻常，冀北群空见一良。\n莫遣画师徒画肉，九方原不辨骊黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹溪图","author":"邓林","text":"城中无竹令人俗，寸土如金不可栽。\n谁向潇湘烟雨里，挥毫移出万竿来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋江独钓二首 其一","author":"邓林","text":"老翁何事苦垂竿，霜落吴江水已寒。\n徒有鲈鱼堪作脍，明时谁肯便休官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋江独钓二首 其二","author":"邓林","text":"借问沧浪老钓徒，终朝垂钓得鱼无。\n连鳌须入任公手，莫谓虚名负壮图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画禽画眉","author":"邓林","text":"淡淡春山翠黛横，生来娇态自天成。\n何曾一日教人画，京兆风流浪得名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸲鹆","author":"邓林","text":"穿花戏水两幽禽，雌和雄鸣自好音。\n若作人言虽可爱，樊笼何乐似山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"窃脂","author":"邓林","text":"江梅已放腊前枝，双鸟犹嫌春信迟。\n早晚园林红绿遍，穿花度柳自娱嬉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹡鸰","author":"邓林","text":"谁将尺素写双清，五鸟群居似有情。\n若使雌雄相唱和，不知一只向谁鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松隐小景","author":"邓林","text":"手植青松百尺高，白头方得解尘劳。\n茯苓堪煮花堪酿，坐听天风响翠涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赤壁图","author":"邓林","text":"坡仙作赋纪清游，画出江山一段秋。\n读罢令人神思爽，凌风便欲上瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题小景白云无心","author":"邓林","text":"八荒岁旱待为霖，出岫无心亦有心。\n本是从龙天外物，谁教岩下久湮沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻溪悟道","author":"邓林","text":"清溪流出万山中，赴海悠悠日夜东。\n不是逝川曾有叹，谁知夫子道无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林下高风","author":"邓林","text":"鸟啼花落不知春，一榻清风乐趣真。\n圣代求贤今正急，肯容林下有贤人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云中古刹","author":"邓林","text":"云山千叠郁苕荛，萧寺年深绀宇凋。\n横砌断碑苔藓合，摩挲犹可认南朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜燕潘氏文会堂醉后口号","author":"邓林","text":"银烛摇红院宇深，管弦声里夜沉沉。\n琼杯满酌深如海，不及东人爱客心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次日登舟夜值风雨复用前韵二首寄潘氏 其一","author":"邓林","text":"酒兴诗情谩自深，江湖无地寄湮沉。\n那知一夜山阴雪，惹起王猷访戴心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次日登舟夜值风雨复用前韵二首寄潘氏 其二","author":"邓林","text":"篷底燃灯坐夜深，可人篷上雨沉沉。\n新诗吟就谁能和，只有潘郎称赏心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登临安徐景文夕佳楼","author":"邓林","text":"酒入诗肠脸半酡，夕佳楼上晚凉多。\n层阑倚遍无新句，奈此溪山景物何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海棠翠羽","author":"邓林","text":"银烛摇红照夜深，故教春睡昼沉沉。\n梦回无语春如许，啼杀东风翠羽禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杏花幽禽","author":"邓林","text":"梅树青青正欲酸，帘纤雨过杏花寒。\n幽禽也为红芳惜，久立枝头著眼看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荆兰竹石","author":"邓林","text":"劲节幽芳夹翠屏，相看风韵喜同情。\n蒹葭倚玉从来有，荆棘何妨一处生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月影梅","author":"邓林","text":"西湖昨夜转东风，报道南枝消息通。\n踏遍六桥寻不得，谁人移上月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢幼医李士端","author":"邓林","text":"谷中竟夕不眠时，父母心犹爱小儿。\n红杏满林无力种，此情多感故人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春草图为梁鎯赋","author":"邓林","text":"和烟和雨自凄凄，生意何人为品题。\n一自池堂春梦觉，满庭风雨属濂溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风雨归舟图","author":"邓林","text":"蓑笠篙工伛偻身，舣舟和雨泊江滨。\n掩篷高卧听鸣玉，清杀芦花里底人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄方伯饶泰政遣人送至常山因赋此以谢之","author":"邓林","text":"钱塘潮到富春还，逆水移舟寸步难。\n不是仁风送帆力，七程何日到常山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"捕鱼图二首 其一","author":"邓林","text":"浩浩春江漾碧虚，桃花新水正生鱼。\n一罟休笑生涯窄，意在烟波乐有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"捕鱼图二首 其二","author":"邓林","text":"客边长日望江南，回雁无书思不堪。\n渔父得鱼须遗我，腹中恐有故人缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和羊城梁俊民三首 其一","author":"邓林","text":"貂裘已敝早寒侵，优许归田奉玉音。\n欲访徵君谈出处，丹崖翠碧白云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和羊城梁俊民三首 其二","author":"邓林","text":"诗怀久为俗尘侵，有耳那闻大雅音。\n折简相招入吟社，多君于我独情深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和羊城梁俊民三首 其三","author":"邓林","text":"眼目昏昏鬓雪侵，还乡犹未改乡音。\n良朋倘肯来今雨，便共烧灯话夜深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏何节妇","author":"邓林","text":"连岗宿草暗孤坟，今古空馀节妇村。\n惟有辘轳床上月，夜深犹照井中魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桂花鸲鹆","author":"邓林","text":"金粟花开非等閒，月宫分种到人间。\n幽禽莫占高枝立，留待吾家士子攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏赵烈女","author":"邓林","text":"人言慷慨轻生易，只有从容就义难。\n说起玉颜贞烈事，风吹老鬓鬓毛寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阙题","author":"邓林","text":"古今谩说飞来寺，幻化神工亦异哉。\n寒玉一泓开地脉，翠屏千级绝尘埃。\n驯猿童子朝留饭，杖锡禅僧晚渡杯。\n到此令人清百虑，海中谁道有蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"双忠庙","author":"吴景熙","text":"中唐天宝末，万里胡尘昏。\n两京既不守，百僚争窜奔。\n桓桓张许公，秉义江淮间。\n睢阳抗要冲，百战阅险艰。\n慷慨忠义士，焦劳摧肺肝。\n孤城忽食尽，饥肠为辛酸。\n终焉费力敌，西拜泪潺湲。\n平生誓许国，视死非所难。\n忠魂上诉帝，悲号达天关。\n雄名垂竹帛，闻风心胆寒。\n灵祠依山麓，千载瞻遗颜。\n我来重致辞，肃恭荐蘋蘩。\n临风发浩歌，击节空长叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"双忠庙","author":"林克刚","text":"大唐养儿恩宠极，播弄乾坤窃京国。\n刚肠不独颜杲卿，将军怒气摩苍冥。\n手持三尺睢阳里，誓杀羯奴雪天耻。\n帐前虎士心桓桓，衽金枕革同肺肝。\n去兵那堪重去食，稽首皇天臣力竭。\n再迟三日全高墉，皇天欲尽公孤忠。\n碎牙裂眦竟何益，将军一去江淮掷。\n储皇欲遂中兴期，此身虽死何足悲。\n千秋庙食到海岳，不减图形上麟阁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白牛岩","author":"林克刚","text":"两真和尚留遗迹，兰若兴衰几岁星。\n老树倚岩春寂寂，幽泉下涧曰泠泠。\n莲花座耸开新像，宝藏函空失旧经。\n露地白牛何处觅，一岩芳草自青青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"罗汉寺","author":"林克刚","text":"东山山下访禅栖，古木繁阴水满陂。\n海阔白云来汗漫，山连青髻出参差。\n秘经藏古忘遗检，奉佛堂空馀故基。\n千古珠林顿消歇，不知罗汉更何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和平桥","author":"林克刚","text":"大海东来浪势骄，长虹直跨影岧峣。\n基深不受江流转，版断曾经野火烧。\n过客接鞭南北路，渔翁垂钓往来潮。\n大峰缅想今何在，遗惠于今耿不消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自题墓碣二首 其一","author":"彭西川","text":"天角危危獬豸形，神仙与我作佳城。\n子孙不必求行状，水月山前是墓铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自题墓碣二首 其二","author":"彭西川","text":"百岁无缘落魄身，湖山风月伴游魂。\n摩崖聊寄人间迹，谁识神仙天上坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"神应港","author":"王惠","text":"江水奔投海，湍沙障作堤。\n萦纡盘数里，迢递接双溪。\n港窄波还漫，潮平岸始低。\n鲛人频揭水，蕃舶每胶泥。\n宋将威何赫，王师力并齐。\n辇沙劳畚锸，堰水跃鲸鲵。\n既辟俄云合，将通又复迷。\n海神驱万族，飓母驾群犀。\n别港开如堑，征帆径若溪。\n庙坛初建设，祭物盛提携。\n不独便舟旅，更兼喜旄倪。\n当时神显应，此日客分题。\n烂漫离杯劝，娇腾驻马嘶。\n不堪情缱绻，回首暮云西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"程烈妇诗二首 其一","author":"王惠","text":"西风昨夜怒掀天，吹折瑶池并蒂莲。\n夫属妇言情已切，妇从夫死志弥坚。\n不惟大义今时重，犹有芳名后世传。\n最是伤心孤与老，一家两地隔蛮烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"程烈妇诗二首 其二","author":"王惠","text":"人间何事使人惊，一死能全万古名。\n合卺已相同穴葬，盖棺宁忍别偷生。\n肝肠断折情犹切，节义坚贞命必轻。\n多少英雄名达士，临危何不尽忠诚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游灵山诗得颓字","author":"王懋","text":"芒鞋竹杖陟崔嵬，一径烟岚两半开。\n阴洞丹炉无伏火，古祠画壁拥荒苔。\n杳浮苍霭茶烹鼎，免溜红霞酒满杯。\n陪赏归来情未□，□川斜日暮云颓。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"载酒堂","author":"王懋","text":"万里投荒到海南，桄榔林下即茅庵。\n谪居身世何须惜，忧国情怀尚不堪。\n当日岂无人载酒，至今常使客停骖。\n我来堂上瞻遗像，飒飒清风洒布衫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题淑正先生隐居","author":"林祖","text":"归遁旧林泉，西堂隔市廛。\n功名端不慕，尘俗讵能牵。\n果落禽惊弹，苔铺鹿卧毡。\n里闾多造就，千载仰伊川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林述古","author":"林仕猷","text":"圣朝尚文治，侧席思英贤。\n下诏宣郡邑，推荐相后先。\n所以布衣士，彬彬起林泉。\n林君潮阳彦，质美而志坚。\n曩从张鲁庵，易学得所传。\n韦编已三绝，亹亹通幽玄。\n青衿立其门，执经望开宣。\n箪瓢足自乐，菽水奉亲欢。\n念此以终老，富贵浮云然。\n吾郡有贤守，奏对枫陛前。\n荐子以明经，书名达天官。\n州司遂逼迫，促登孝廉船。\n入市卖琴书，聊以充盘缠。\n上堂别慈母，白发垂双肩。\n母曰子行迈，重见知何年。\n人生谅难必，出处宁非天。\n秋风振落木，高城啸饥鸢。\n云海浩无际，川流亦溅溅。\n我老不出乡，送子韩江边。\n愿言崇令德，保身若冰渊。\n远大以为期，忠孝贵两全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白牛岩","author":"林仕猷","text":"幽怀旷冲赏，陟彼东山巅。\n山人邀我饮，满座皆英贤。\n披云望海水，拂石听流泉。\n昔贤有遗迹，遐哉弗可攀。\n矫首见白云，悠悠在青天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵山寺","author":"林仕猷","text":"一洞烟霞紫翠深，上方台殿锁秋阴。\n悬崖老树鸣天籁，落涧飞泉响石琴。\n往事祇今成感慨，浮生何幸得登临。\n留衣亭上三更月，照彻昌黎万古心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春江待渡应制","author":"戴次冑","text":"绿杨芳草马频嘶，担重奚奴举步迟。\n小艇不来春水急，沙头独立已多时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游灵山","author":"李玉","text":"紫烟初散洞门开，水泛桃花出涧来。\n红映绿波三十里，个中深入是天台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石龙头山","author":"李玉","text":"天上归来寻旧迹，行边清兴只依然。\n白云流水回幽涧，碧树啼猿破晚烟。\n翠落山光方外景，露和花气洞中天。\n须知此地经行处，屈指重游二十年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]