[{"title":"次韵送缓斋大贺四首 其四","author":"黄衷","text":"玉函通北极，金鉴出西藩。\n细认台端路，何妨带涣恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沙冈为徐伯川赋","author":"黄衷","text":"窈窕纡新径，平虚散晚庵。\n世情孤竹外，诗兴小梅南。\n鸂鶒晴姿澹，鸳鸯暖梦酣。\n未谙花溅泪，漫伫月从谈。\n稷下才何忝，隆中老更堪。\n屏居无俗客，遥放数峰参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐次竹溪联句韵二首 其一","author":"黄衷","text":"习简频休假，怀荣敢献姿。\n物情为计早，僧味闭关迟。\n敝甑投饥鼠，低樊护冻鸱。\n月堂银烛减，趺坐有馀思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐次竹溪联句韵二首 其二","author":"黄衷","text":"倦力祛尘障，苍髯谢世姿。\n道从迂处古，机讳巧中迟。\n静榻闻喧蚁，清泥戒堕鸱。\n薄云归故岫，予亦动乡思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芦田市和韵","author":"黄衷","text":"物情颇逐蘧蘧梦，野意时闻浩浩歌。\n天上自纡黄鹄路，江南无限白鸥波。\n石滩放鹢春风急，沙市来牛莫雨多。\n梅柳亦关兵火恨，苍烟回首奈愁何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南亭驿和韵","author":"黄衷","text":"饥鹰得食飏不搏，老狖知风悲复啼。\n江栖数口菜根尽，山樊二月桃花低。\n画船急榜候吏走，白板返扃无客题。\n揽衣中夜看弧矢，破镜已挂寒岩西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古祚驿和韵","author":"黄衷","text":"荒城隐隐昼恒阴，野火依微瘴水浔。\n浊酒不醺嫌兴浅，老予何以答春深。\n静看木槿垂花态，欢动山蕉卷叶心。\n愿放官家逋负令，江天随处有猿吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昭潭驿和韵","author":"黄衷","text":"郡城东下瘴江流，利涉今无贾客舟。\n桐木归来津口渡，杨花飞过驿南楼。\n空山赏籍徒封介，昭代侯功止号留。\n潭畔醉渔呼不起，世情应到酒边休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿昭潭馆","author":"黄衷","text":"曙郭啼乌人未行，春江新草逐愁生。\n谢公自济山中胜，王掾终收海内名。\n弄野轻云仍有态，送花流水不胜情。\n竹间一道茶烟动，知是闲堂赋喜晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五世春官为彭大参赋","author":"黄衷","text":"未上龙门识素风，年家荣论满南宫。\n词头凤翼交云彩，马首春花数杏丛。\n星社崔堂还伯仲，冰厅贺氏亦孙翁。\n生绡为蓄扶舆气，不看丹青看化工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜鹊","author":"黄衷","text":"帘额飞花日正迟，选林晴鹊弄春姿。\n主人金印累累地，曾见山中变化时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸲鹄","author":"黄衷","text":"两两低飞趁曙晴，闲庭娇唤竹风轻。\n祇应惯见司空客，解语琵琶别调声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山呼","author":"黄衷","text":"武帐鸣飙秋气高，元戎扶醉较龙韬。\n谁家绿树朱门寂，不听山呼听百劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒鸦","author":"黄衷","text":"栖遍秦家古树枝，曹瞒休咏月中诗。\n较量江上寒深浅，不及昭阳晚噪时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"藤江晚泊","author":"黄衷","text":"小鸟林依山欲昏，冷烟犹动獞人村。\n黄茅屋背登禾穗，白竹篱腰带潦痕。\n武帐鸣刁江客悄，平沙争爨仆夫喧。\n邛家云水真堪忆，月净梅花未掩门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿鹭","author":"黄衷","text":"婉颈双双戢振翰，暖沙长恋苇花滩。\n身轻也学溪凫并，梦远应怜海鹤单。\n夜定影浑欺月色，江空神更敌霜寒。\n两年岁杪蛮乡路，剔尽银灯见汝难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浔阳除夜","author":"黄衷","text":"设戟森森小队齐，然松挝鼓郭东西。\n行藏笑向浔阳馆，功业嫌听子夜鸡。\n金粟悬釭谙近信，银钩走笔动新题。\n老予谩有难忘处，徙倚天街认聚奎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邕管立春日江行阻风","author":"黄衷","text":"雄风似倚东皇势，吹我船头欲倒回。\n大地渐敷江上草，浮云都付掌中杯。\n明堂当御青阳左，旧业仍荒白涧隈。\n自古兹辰颁恤政，遐方吾愧佐时才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伏波庙","author":"黄衷","text":"古木巃嵷半亩宫，香江犹为祀英风。\n楼船不载浮溟恨，铜柱方标殿粤功。\n纵毁世从君子后，争雄人在女流中。\n成周远略还无外，白雉千年到洛东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西征次韵屠巡察三首 其一","author":"黄衷","text":"最是等威齐将相，更堪馀地走英雄。\n惠分旭日千山晓，令肃高旻九月风。\n神算坐筹铜柱外，妖氛迅扫扶桑东。\n都狼岭上磨崖遍，不尽南巡疋马功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西征次韵屠巡察三首 其二","author":"黄衷","text":"天上绣斧光煌煌，巡台笑靖古狼荒。\n千山澒洞铁骑走，万窟瑟缩长蛇藏。\n严霜乍飞日杲杲，时雨欲下云霙霙。\n溪翁拥彗贺还祝，迟公洒扫同心堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西征次韵屠巡察三首 其三","author":"黄衷","text":"露檄宵驰北路长，探丸今日静江乡。\n宋功谩录收邕管，汉将徒劳下桂阳。\n借箸公还将绣斧，洗兵吾欲挽银潢。\n何人更上平蛮雅，续得淮西墨几行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吊泾川公墓","author":"黄衷","text":"湘流依旧国华凋，谩检生平附楚招。\n位极上卿仍四部，望隆东观自三朝。\n山笼花雾阴犹浅，泉彻椒浆恨岂消。\n谢疏不堪挥泪读，夜堂奇气欲蒸歊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中和宗宪长五首 其一","author":"黄衷","text":"野兴逢山苦欲生，即嫌新涨乱江声。\n西岩未暝东岩白，棹过前溪弄月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中和宗宪长五首 其二","author":"黄衷","text":"十日黄埃上砚屏，谁堪秋月照花明。\n素衣暂倚凉风坐，羡杀横江一鹤行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中和宗宪长五首 其三","author":"黄衷","text":"最忆南山一翠屏，秋来晴霭转分明。\n眼前数点疑相似，却唤回桡傍岸行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中和宗宪长五首 其四","author":"黄衷","text":"谁为芙蓉减障屏，梦中云物认朱明。\n铁桥十月梅花动，何得麻姑白鹿行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中和宗宪长五首 其五","author":"黄衷","text":"淡疑云母隐金屏，远即乾坤判晦明。\n便儗振衣千仞上，人间应有近天行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和絅庵遗笔四首 其一","author":"黄衷","text":"闻于习静得观颐，弄野云姿思与迟。\n濡沬早敷千变泽，览辉曾见九苞仪。\n堂灯风雾孤凭几，墓木星霜几执规。\n八极有神应驭气，不知何路逐安期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和絅庵遗笔四首 其二","author":"黄衷","text":"藩省才名雅自堪，端如鹏翼快图南。\n较量大策嗟时运，刊落陈言谢俗惭。\n药裹先秋虚小草，家林旧味寄馀甘。\n剑亭千里高贤去，传得残篇与笔谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和絅庵遗笔四首 其三","author":"黄衷","text":"午夜凄清吊鹤音，山桥江槛想经临。\n芙蓉虽好看宁足，鶗鴂先鸣怨已深。\n有客曾过虚白室，于君难见彼苍心。\n东风不减元公趣，满地仍开紫玉簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和絅庵遗笔四首 其四","author":"黄衷","text":"小閤花枝渐碍冠，江乡高誉尚曹官。\n书麟始断周删述，问鵩真灾汉治安。\n月满梁间疑可见，精还箕尾恐芒端。\n救滨万里澄清辔，莫恨台司副愿难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代和四首 其一","author":"黄衷","text":"沃沃清髭渐拂颐，霄程宁卜遽衰迟。\n闽山风动馀行马，汉署香残自令仪。\n作赋有人悲正则，登楼而我怅元规。\n平生几点交游泪，洒向新阡愧后期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代和四首 其二","author":"黄衷","text":"手把遗文思岂堪，新愁聊与吊江南。\n身为僧后疑真幻，名在卢前信不惭。\n千里未终才自逸，万金难售剂宁甘。\n夜台可作人心在，谈到平湖便喜谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代和四首 其三","author":"黄衷","text":"天问他年嗣楚音，巫咸不语夜将临。\n玉盘何意频圆缺，瑶海无凭谩浅深。\n入省独摇惊吏笔，盖棺安死济时心。\n一经堂上多良冶，肯负金缕尺只簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代和四首 其四","author":"黄衷","text":"清班不见切云冠，地下修文定有官。\n鸣雁独飞犹海曲，残潮还到自临安。\n烦忧似草萦暌绪，往事如泉饮恨端。\n万里大川风正紧，一舟谁共济艰难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分得长安此去欲何依七韵送俞子宜 其一","author":"黄衷","text":"郭门临祖道，晓旭动花光。\n似君去时面，眉间佳气黄。\n兼程发湘水，计日见江乡。\n拜庆高堂上，春风萱草长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分得长安此去欲何依七韵送俞子宜 其二","author":"黄衷","text":"携手东江侧，情如浊水澜。\n但挹别离色，不觉樽俎欢。\n曲江金镜录，而子触邪冠。\n努力当于迈，能令黎庶安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分得长安此去欲何依七韵送俞子宜 其三","author":"黄衷","text":"挂管荒落馀，佳处差可纪。\n月满梅花天，不说千金市。\n图书山近郊，兰桡拢江涘。\n三年持宪心，清寒得如此。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分得长安此去欲何依七韵送俞子宜 其四","author":"黄衷","text":"飞走各有营，久客念岁序。\n不见官道槐，兔目忽满树。\n入门当何时，幸借食前箸。\n送君漓水长，予亦从此去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分得长安此去欲何依七韵送俞子宜 其五","author":"黄衷","text":"春晏雨脚滋，桃花泣红玉。\n津吏把传符，徒御立宵烛。\n天上贵仙宅，台榭青云覆。\n但见鞲上鹰，不闻龙有欲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分得长安此去欲何依七韵送俞子宜 其六","author":"黄衷","text":"昔年骢马路，绣斧铁为柯。\n四座噤不语，骈耳骇悬河。\n属来气犹健，长风撼洪波。\n手中二三策，讵为谒常何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分得长安此去欲何依七韵送俞子宜 其七","author":"黄衷","text":"树柏古台上，苍苍晨带晖。\n柏以况君操，晖光良不微。\n京城香雾尘，长傍马首飞。\n素袍未改色，谁能怀所依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56296,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苦雨和缓斋","author":"黄衷","text":"钟鼓声微不报晴，坐知江涨夜还生。\n看云都是因风起，占毕应嫌背月行。\n厌胜玄庭闻水咒，忍嘉牟陇切农惊。\n城阴欲捣虞山庙，可是词衡怯柳争。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽巡察谢侍御","author":"黄衷","text":"阳和风力动兼权，直向秋潭看静渊。\n越绝江山筹策外，闽中桑梓泪花前。\n游魂何处应宾日，报德无徵欲问天。\n遗疏一函看不得，霜髯宁是受知年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻鹃和合溪","author":"黄衷","text":"初声犹是月中啼，稍送馀寒逼曙衣。\n花歇渐催红雨乱，树芳应藉绿云依。\n悬知沃野勤方作，偏动高楼怨未归。\n莫儗天津桥上听，杜陵残泪不胜挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"移家不至葵轩戏以诗次韵答之","author":"黄衷","text":"春浮沙际浩无涯，鸂鶒撩人近复赊。\n香灺煖风催试葛，江光新潦约回槎。\n南山亦有蘼芜草，此日徒怜百合花。\n总是铁肝销不得，蛮烟未灭肯为家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柳江夜泛","author":"黄衷","text":"炎歊郁郁遍炎方，病骨贪程趁夜凉。\n鸥聚暗惊铜角响，入家微近玉绳光。\n望穷喧濑叉鱼火，思杀轻纨弄月堂。\n独扣溪舷歌鞅掌，未应文字损韶芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟赠","author":"黄衷","text":"节旄光动峤南軿，司马奇踪照杀青。\n衮钺忆曾窥志郡，风骚誇为觅书屏。\n江山是处高卿月，宇宙无穷一使星。\n越绝故深摇落恨，未随衣屦过山亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苍梧雨中和定斋二首 其一","author":"黄衷","text":"南山欲雨渐云蒸，斋阁清愁病与仍。\n独鹤背人行且啄，两凫骄我睡相凭。\n风炉煮蟹聊供具，寒水罾蛟敢赞能。\n文字可娱贫亦得，烛花何夕对陈登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苍梧雨中和定斋二首 其二","author":"黄衷","text":"日晏东邻无饭蒸，西家绮席候云仍。\n山杯自爱当花举，江槛那堪趁雨凭。\n秋兴定知衰易减，世情争与懒相能。\n词场偶对陈平垒，得似刘邦困白登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"追挽张都阃","author":"黄衷","text":"虎头信有通侯骨，马革何曾壮士悲。\n邕管山河挥羽日，交州风雨死绥时。\n报恩宁顾万金宠，仗节惟馀孤剑知。\n疑冢椒浆今入土，祇应冥莫鉴孙慈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨内斋佥司谢政归越","author":"黄衷","text":"马首看花旧丙辰，黄埃端愧隔清尘。\n生涯老去凫鸥在，初服归来杜若新。\n呼吸午窗依姹女，歌游晴谷答幽人。\n镜湖一曲春深浅，思杀风流贺季真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送戴醉菊都司谢政归燕","author":"黄衷","text":"来时建节鬻琴归，谁悟将军远世机。\n百粤边声清梦隔，三湘秋水故人稀。\n樽前狎鸟新情致，服上蟠螭旧等威。\n黄菊落英如可拾，颓龄相济莫相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁丑中秋玩月和合溪","author":"黄衷","text":"尘世清光重此时，夜晴那惜倚阑迟。\n槎通银浦客何去，秋遍唐宫人未知。\n轮转高山看桂满，席妨深树命樽移。\n酣歌不作西岩望，神魄休疑我是谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢惠莲酒二首 其一","author":"黄衷","text":"香带芙蓉露气多，暖光融媚上颜酡。\n虚教日莫成遐想，携向银塘答艳歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢惠莲酒二首 其二","author":"黄衷","text":"掌上琉璃绿雾轻，茂陵何处乞金茎。\n情知不似莲花味，别是将军酝籍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢饮张合溪舟中","author":"黄衷","text":"清秋哀角动千峰，蛮瘴迎飙淡不浓。\n雄镇偶逢严仆射，扁舟谁况郭林宗。\n笔间风雨啼山鬼，橘里乾坤御草龙。\n野客岂堪追逸赏，江樊遥负木芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过象棋滩和合溪","author":"黄衷","text":"潦涨秋江失旧涯，石穿枯柽见浮槎。\n林端禽语人烟寂，天上船来客路赊。\n未许新霜催碧杜，渐看明月映苍葭。\n烧痕晓遍青峰脚，报道山猺种晚畬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月水际拒霜","author":"黄衷","text":"气肃天高花数枝，迎船映竹亦离离。\n寒崖浅涧各自媚，蜀槿戎葵又一时。\n霜腻尚馀藏蝶粉，烟须犹见缀蜂丝。\n老予敢续猗兰调，惆怅曾看粤水湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣闷和合溪次拒霜韵","author":"黄衷","text":"黯黯江天唱竹枝，娟娟秋水正愁离。\n烛花小馆长吟夜，雁阵高云薄暮时。\n石蕨香霏收玉屑，溪鱼竿重挽风丝。\n身惭紫绂西藩后，兴在黄湾青岸湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鳌峰寺饯饮谢骆任之","author":"黄衷","text":"持檄经秋催鹢舫，疏筵几日借僧轩。\n风云岐路犹南北，灯火比邻已子孙。\n竹叶杯深山上局，蓼花潮到寺前村。\n要知楚泽青兰月，只有怀君不可言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中和张天益二首 其一","author":"黄衷","text":"风前箫鼓落滩声，云际孤帆逐鸟轻。\n秋满残林初送雨，夜严荒徼渐传更。\n无心更著江湖记，庞俗曾闻山海经。\n惟谢同行张博望，一尊遥为寄高情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中和张天益二首 其二","author":"黄衷","text":"江空滩急榜歌声，西上奚囊一叶轻。\n云影自从秋里薄，山姿岂必雨前更。\n愁心附雁知何去，逸迹凭诗记所经。\n蔀屋晨烟犹未业，缓箫鼍鼓不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东山宅题沈卿小景四首 其一","author":"黄衷","text":"茶烟深院青，东野媚晴晓。\n嘤嘤林端声，听似秦吉了。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东山宅题沈卿小景四首 其二","author":"黄衷","text":"凉树转佳阴，游丝静无力。\n翔集各有营，朱门自迟日。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东山宅题沈卿小景四首 其三","author":"黄衷","text":"去住悲胡燕，低飞趁泽鷮。\n江南秋色早，幽意满风苕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]