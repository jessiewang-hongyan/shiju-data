[{"title":"送范中丞尧卿镇赣州 其一","author":"谢榛","text":"朔雁催行色，江天入望遥。\n旌飞秋草岸，船压夕阳潮。\n有赋思梁宴，虚心听楚谣。\n霜威及岭外，千里瘴烟消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送范中丞尧卿镇赣州 其二","author":"谢榛","text":"九月虔州去，天南宿雾开。\n扬帆生远思，秉钺见雄才。\n地转三吴尽，山连百粤回。\n夜深瞻北斗，独上郁孤台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题山水图 其一","author":"谢榛","text":"川原人不到，尽日草亭閒。\n秋晚树摇落，天高云往还。\n沙边多白鸟，湖上一青山。\n榜子复何处，暝投红蓼湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题山水图 其二","author":"谢榛","text":"石树重阴合，郊亭远色分。\n泉飞半空雨，江落数峰云。\n幽兴自深坐，长歌谁更闻。\n申生今白首，无意待玄纁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄南都毛明府正之","author":"谢榛","text":"久宰南都邑，乌台空荐书。\n讵知人事巧，翻使宦情疏。\n梅雪清相映，山云澹自如。\n大江春水发，应有北来鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洛阳怀古","author":"谢榛","text":"百战龙蛇定，中原旧帝居。\n邙山谁酹酒，落日自停车。\n汉室浮云过，周京乱草馀。\n即今苏季子，秪合老田庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿少林寺同莫陈二秀才","author":"谢榛","text":"萝径通深处，苍然峭壁重。\n吟成太室雨，坐久少林钟。\n习静聊今夜，探奇复几峰。\n还期共禅榻，莫负岁寒松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"达摩洞","author":"谢榛","text":"长江折芦后，面壁此高岑。\n祗树抱岩古，法云垂洞深。\n石存一片影，天印万年心。\n徒使登攀客，松风听梵音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张德徵汴中见访仆已过杞两不相值","author":"谢榛","text":"相寻非预期，乘兴我何迟。\n两地琴樽夜，同怀风雨时。\n苦吟灯自对，良晤梦先知。\n好共碧筒饮，荷花杳满池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答沈禹文见寄","author":"谢榛","text":"未息吴中战，宁闻燕市歌。\n一官身事重，长夜国忧多。\n古道淹骐骥，秋山老薜萝。\n趋朝成百感，风色动鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴逸人汝震归甬东","author":"谢榛","text":"有客叹无鱼，河亭送别初。\n马归梁园路，兵阻越乡书。\n野岸沧波转，霜天赤叶疏。\n世情堪一醉，还定海门居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"静公园借居","author":"谢榛","text":"欲览匡庐胜，衰年惜未能。\n栖迟无俗侣，幽寂共邻僧。\n禅定阶前石，心空夜半灯。\n浮图著灵异，昨上最高层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"维扬兵后寄张佥宪士直","author":"谢榛","text":"羽书飞不绝，东望海天遥。\n旗杂广陵树，兵喧扬子潮。\n材官曾几战，壮士莫轻招。\n独立多悲感，江城飒晚飙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄豫章周子乾","author":"谢榛","text":"解官君独早，南北募兵年。\n烽火端㞐外，云霞高枕边。\n放歌行野寺，垂钓坐江船。\n剩有閒园地，开池种白莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陆太守子部","author":"谢榛","text":"目极九江水，谁传双鲤鱼。\n城当吴楚地，天逼斗牛区。\n怀古云西驻，求贤榻左虚。\n郡齐梅正发，岁晚意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄隐君南归","author":"谢榛","text":"黄生久不见，一见即言归。\n落叶世情薄，浮云生事微。\n潮声随晚棹，江色照寒衣。\n还醉莆中酒，春风自掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哀江南八首 其一","author":"谢榛","text":"为说江南胜，豪华异往年。\n波涛扬子夕，风雨秣陵天。\n岁苦兵间赋，春荒战后田。\n都门迟飞挽，何处泊吴船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哀江南八首 其二","author":"谢榛","text":"昆明未习战，南伐转忧深。\n兵气连瓜步，人烟断柘林。\n吴姬穷海泪，燕将故关心。\n何日铙歌转，苍生望捷音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哀江南八首 其三","author":"谢榛","text":"战马嘶江上，寒生枫树村。\n新兵五都尽，旧业几家存。\n共倚中朝盛，谁将上策论。\n梁鸿避世者，宁复老吴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哀江南八首 其四","author":"谢榛","text":"召募今南讨，中原羽檄过。\n几年纡策定，一战赏功多。\n雾变青山色，天横沧海波。\n飘零国士老，长望一悲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哀江南八首 其五","author":"谢榛","text":"华亭未奏捷，烽火更西湖。\n海舰贼来去，天兵功有无。\n人心多为汉，国计竟全吴。\n野哭徵求尽，苍茫寒月孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哀江南八首 其六","author":"谢榛","text":"古来兵不到，湖里洞庭山。\n日惨干戈际，云愁猿鸟间。\n少年应习武，幽士且栖閒。\n纵熟黄柑酒，谁能长醉颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哀江南八首 其七","author":"谢榛","text":"江山天设险，满目战图秋。\n东海兵停棹，西风客倚楼。\n朝廷存大体，斧钺系深忧。\n不信征南将，功成早白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哀江南八首 其八","author":"谢榛","text":"氛祲频年动，东南尽处看。\n海摇千舰出，兵犯七闽寒。\n杀伐宁无定，凭陵信有端。\n遥闻日本使，犹自贡长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过清源故居有感 其一","author":"谢榛","text":"旧业成暌远，亲朋久失群。\n百年生长地，一片往来云。\n独立空流水，长吟但落曛。\n结茅何日定，西陇事耕耘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过清源故居有感 其二","author":"谢榛","text":"飘零三十春，下马问比邻。\n相见弟兄老，堪嗟门巷新。\n行踪犹泛梗，世故一浮尘。\n王谢豪华地，殊非旧主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别史郎中应之还张秋 其一","author":"谢榛","text":"一见遽言别，其如南北情。\n君今何水部，吾岂谢宣城。\n帆影树中出，河流天际平。\n谁无感怀赋，两地共秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别史郎中应之还张秋 其二","author":"谢榛","text":"安平南去道，官署在河浔。\n一水风烟色，三秋鱼鸟心。\n才高君柱石，计拙我山林。\n应念离居者，虫鸣蔓草深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢刘监察质卿见寄","author":"谢榛","text":"清霜肃海岱，春到野夫边。\n骢马劳今日，苍生望有年。\n旧交仍杖屦，遐思各云天。\n为问齐中俗，何人似鲁连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日方晦叔同登北城楼兼示真上人二首 其一","author":"谢榛","text":"相期赋九日，倚堞兴何饶。\n天若来风雨，人应感寂寥。\n长河明远色，寒柳净疏条。\n更爱东林胜，谈禅坐此宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日方晦叔同登北城楼兼示真上人二首 其二","author":"谢榛","text":"登高有惠远，揽胜即庐山。\n幽事知谁重，浮生得此间。\n乾坤惟旧侣，霜露各衰颜。\n莫待黄花老，明朝更一攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重九夜吴希实隐君馆陪饯君搢诗人 其一","author":"谢榛","text":"开樽当节序，归思莫匆匆。\n秋色犹南菊，寒声自北鸿。\n几人心迹定，万事古今同。\n旷达真吾辈，何如栗里翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重九夜吴希实隐君馆陪饯君搢诗人 其二","author":"谢榛","text":"茱萸共把玩，聚散复何愁。\n秉烛重阳过，移樽片月留。\n我?同调侣，君醉异乡秋。\n别后多诗兴，还登何处楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬翁子书见示新作","author":"谢榛","text":"病馀秋思动，对月几吴吟。\n江上多莼菜，山中有橘林。\n感因为客久，情岂在交深。\n安得共耕凿，相期松柏心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮秋柬徐别驾载卿","author":"谢榛","text":"南征秋转剧，不寐夜漫漫。\n白发艰虞尽，沧洲去住难。\n旌旗连夜暗，兵甲照江寒。\n选将须臾事，谁能议筑坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄塞上路监察子中","author":"谢榛","text":"沙漠动霜威，巡行久未归。\n眼中求将略，意外得边机。\n日落马南顾，天寒雕北飞。\n莫令诸侠少，争猎向金微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮秋闻倭寇稍平寄上南都大宗伯孙公兼怀太史文和二首 其一","author":"谢榛","text":"才罢江南战，凭高动越吟。\n涛声翻日暮，兵气结秋阴。\n听履青天远，含香紫雾深。\n世传修汉史，谁识二班心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮秋闻倭寇稍平寄上南都大宗伯孙公兼怀太史文和二首 其二","author":"谢榛","text":"省中霜叶下，百感向斜晖。\n北饷多留滞，南征几是非。\n寸丹经国远，尺素到家稀。\n共拟孙弘阁，无劳说布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"老怀","author":"谢榛","text":"残年百事过，阅世复何言。\n多病仍春草，全家岂故园。\n游丝风不定，乱雀日相喧。\n我欲从丹侣，青山静掩门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许殿卿守建宁","author":"谢榛","text":"移官君独远，惆怅撤离筵。\n山转荆南路，江浮蜀外天。\n自能归异俗，几为问荒田。\n到日梅花发，春生五马前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠卢次楩 其一","author":"谢榛","text":"五年君一到，未是曳裾频。\n晓发黎阳骑，宵探漳浦春。\n交游魏公子，怀抱楚骚人。\n好觅沧洲侣，相将采绿蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠卢次楩 其二","author":"谢榛","text":"谁识丰城剑，天空紫气高。\n老来悲道路，醉后益风骚。\n物议冰霜过，才名岁月劳。\n一寒今范叔，谁复赠绨袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠卢次楩 其三","author":"谢榛","text":"五十君多感，艰危不可忘。\n自知兄弟少，宁为鹡鸰伤。\n汉党无文字，燕歌独醉狂。\n莫违湖海兴，徒自老黎阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭弟松 其一","author":"谢榛","text":"多病吾仍在，沉酣尔遽休。\n相依堪共老，永别杳难求。\n伏腊还新酒，风烟岂故丘。\n漳河暮转急，呜咽正东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭弟松 其二","author":"谢榛","text":"吾弟忽长往，孤魂应向东。\n在家忧患过，为客去留同。\n白日身何懒，清樽老不空。\n至今城北路，陇树起悲风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀徐以言","author":"谢榛","text":"罢官还旧业，应起著书楼。\n海鹤当庭下，溪云拂槛流。\n独醒风雨后，高卧甲兵秋。\n况有东山胜，堪追谢傅游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李佥宪师孟","author":"谢榛","text":"楚客限王程，春风游宦情。\n山连吴地阔，天与浙中平。\n烽燧劳东望，干戈甚北征。\n莫教终孺子，独为请长缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘侍御叔清擢守扶风赋此寄赠","author":"谢榛","text":"旌节发河阳，君行西路长。\n心悬陇上月，威带日南霜。\n入郡春随马，谈兵秋满堂。\n于今汲长孺，易使鬓毛苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王元美镇青山赋此寄怀","author":"谢榛","text":"当年客燕市，官舍每经过。\n促膝寒灯尽，论心夜雨多。\n别来成老病，愁里问干戈。\n北海开樽日，何人共醉歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日柬方晦叔两江","author":"谢榛","text":"端居何思远，名士亦心劳。\n巨笔凌班史，秋怀得楚骚。\n窗虚清桂露，庭迥急松涛。\n诗草人争写，三齐纸价高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓居禅院申明府幼川携酒过夜","author":"谢榛","text":"禅扉夜尚开，何意冒寒来。\n好客无馀俸，为官不尽才。\n冰花明古树，烛影动春杯。\n落尽孤城月，乘酣车马回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴人郑速季入邺省兄中伯每谈倭寇之乱久而思归赋此以赠三首 其一","author":"谢榛","text":"驱马来河朔，云愁故国赊。\n干戈身是赘，道路酒为家。\n海戍多归雁，江城几落花。\n白头弟兄在，急难复何嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴人郑速季入邺省兄中伯每谈倭寇之乱久而思归赋此以赠三首 其二","author":"谢榛","text":"江南兵未息，朝野共忧端。\n战伐疲吴税，功名老汉官。\n天空山雾惨，地坼海涛寒。\n妻子书难达，华亭梦里看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴人郑速季入邺省兄中伯每谈倭寇之乱久而思归赋此以赠三首 其三","author":"谢榛","text":"我惜吴门客，言归动是哀。\n形容愁里变，离乱死中来。\n家远身犹滞，田荒赋几催。\n时清渡江去，长啸虎丘台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"涌金亭同冀定甫马伯龄醉赋","author":"谢榛","text":"百泉声不断，风雨乱沧波。\n地接烟岚迥，天开灵秀多。\n古人馀胜事，今代有狂歌。\n为爱苏门好，携樽共一过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓晁太史湖亭王乐三见过同酌","author":"谢榛","text":"子猷吾旧好，乘兴过林扉。\n席外沧波近，歌边白鸟归。\n浦烟开霁色，松日转春辉。\n学士呼新酒，宁教幽事迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别","author":"谢榛","text":"北上千秋箓，西归万里桥。\n黄花空有约，绿酒不同宵。\n树拥秦云断，山悬蜀栈遥。\n艰难杜老在，莫谩简书招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"楼居秋夜","author":"谢榛","text":"短筇不到地，老子爱楼居。\n徙绮常科发，疏慵肯著书。\n窗高生月早，檐迥接天虚。\n万户灯明灭，秋光澹自如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李员外秀夫","author":"谢榛","text":"久别谁先老，西风两地心。\n海天来朔雁，关月起秋砧。\n性懒交游少，才高感慨深。\n遥怜松桂色，寂寞华山阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卧病张肖甫枉顾时奉使还蜀","author":"谢榛","text":"蜀客来千里，相看慰病颜。\n心驰消息后，义重死生间。\n飞梦通秦塞，缄书度汉关。\n登高不同赋，秋色满河山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"枕上病怀赠陆道函兼谢枉驾","author":"谢榛","text":"卧病劳相问，茫然意答迟。\n科头何气色，拊背独心知。\n地湿霜凝草，庭喧雀满枝。\n君看燕赵俗，豪士岂长悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜奇上人禅房独坐","author":"谢榛","text":"久寄青莲宇，因之问上乘。\n自知閒有味，不愧老无能。\n响彻秋风树，寒生夜雨灯。\n匡床坐幽寂，身似定中僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴君搢归新安二首 其一","author":"谢榛","text":"燕赵久为客，乘秋鸣棹还。\n独吟霜月晓，几转荻芦湾。\n朔雁惊心后，江城屈指间。\n奇峰三十六，天际识黄山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴君搢归新安二首 其二","author":"谢榛","text":"故国多形胜，青山拥万重。\n溪南岁暮雪，石上古时松。\n留客呼新酒，敲棋度暝钟。\n春来觅诗处，谁系野云踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有怀","author":"谢榛","text":"秋风起邺城，重我故园情。\n林壑居难定，渔樵计未成。\n野云随浪迹，村酒脱浮名。\n欲赋多忧思，何如阮步兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀王子梁镇鄜州","author":"谢榛","text":"君乘旧骢马，西望渺黄河。\n春色关中满，霜威塞上多。\n宦情逢羽檄，世事起商歌。\n独夜耿无寐，星光摇太阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋无月","author":"谢榛","text":"连宵雨太急，仙桂失清芬。\n四野明秋水，孤城乱暮云。\n阴晴何处定，悲乐此时分。\n不见山河影，笙歌空自闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜范宪伯尧卿宅同许宪副子春得天字","author":"谢榛","text":"宦情与客思，岁暮共悠然。\n云暗春前树，山明雪后天。\n浮沉惟短褐，聚散几芳筵。\n莫惜今宵醉，相期动隔年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢子明别业对酌","author":"谢榛","text":"背郭茅亭子，联镳薄暮来。\n田夫扫径罢，庭雀出墙回。\n地僻隐狐兔，园荒迷草莱。\n主人久不到，黄菊向谁开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]