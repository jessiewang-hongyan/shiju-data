[{"title":"别杭州承任侍御饯别送至北新关","author":"林光","text":"阳春襟度变霜台，十日杭城几往来。\n扶善看公伸赤手，有容当世岂无才。\n画前易却须参透，删后诗真费剪裁。\n晚雨关头远相送。\n百年怀抱一时开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别杭州留赠田景瞻地曹","author":"林光","text":"论心江浙几亭台，却喜君来我北来。\n三竺休嗟虚近约，八闽曾忝旧抡才。\n关门别酒连朝泻，篷底新诗带雨裁。\n相送扁舟忽相失，东吴千里布帆开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经三过堂","author":"林光","text":"森森松桧护亭台，又拽官舟槜李来。\n僧梦一空西蜀老，堂誇三过子瞻才。\n瀰漫陇麦苗初覆，肥泽园葵叶未裁。\n安得风流任御史，翠云深处一樽开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平湖顾能挽","author":"林光","text":"尘埃真解白人头，一盖楠棺万事休。\n饫炙误同工部醉，骑鲸疑逐谪仙游。\n催徵岁晚粮羞办，吟弄身前句苦投。\n伯氏天伦恩素厚，新阡迟卜信何由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水部正郎傅日会招饮姑苏官署适红梅花蕾满树一朵初放座中走笔","author":"林光","text":"蓓蕾含春醉未醒，才开一点最多情。\n精神却恐忙边忽，风韵从知瘦更清。\n色混夭桃红自别，香浮夹蝶舞来轻。\n花神未识真何意，却费吾诗仔细评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陈刚举人 其一","author":"林光","text":"难将秃笔订行藏，二十馀年鬓各霜。\n光范三书休更问，毗陵春酒劝君尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陈刚举人 其二","author":"林光","text":"梅花清艳半犹藏，未肯春初犯晓霜。\n白首欲谙当世味，山林城市尽须尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京口再赠陈刚","author":"林光","text":"连朝拿短棹，追送及江天。\n应世机须活，虚心善更迁。\n诗成魔尚在，衣敝肘还穿。\n欲借中冷水，醒君几醉眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京口三赠陈刚","author":"林光","text":"睽离二纪各心倾，逆旅相看即弟兄。\n杯酒话穷三百里，晨钟撞破几年情。\n江波远照金山影，酒舫飞摇瓜步旌。\n莫放高谈惊俗耳，此身原属旧科名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过邵伯湖","author":"林光","text":"风压云帆片片斜，湖边星散几渔家。\n烟含柳眼春犹浅，鸥浴蒲梢水未赊。\n舴艋回时呼卖蟹，夕阳低处见翻鸦。\n诗成欲诵无人会，挑落船灯几点花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"高邮湖","author":"林光","text":"长堤叠砌绕湾斜，知役丁夫几百家。\n帆驾长风真自快，瓶无馀酒便须赊。\n云开远见天边树，诗就狂涂纸上鸦。\n风景满前吟不尽，凫鸥输骇浪翻花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝应湖","author":"林光","text":"连过三湖日未斜，天教清兴发诗家。\n何嫌顺境风涛壮，更爱扁舟眼界赊。\n角角芦根呼水鸟，翻翻帆影散堤鸦。\n春波闪烁摇晴日，添得南翁两眼花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过恭襄祠道院","author":"林光","text":"恭襄祠下系舟迟，竹献清森石献奇。\n久坐虚亭花未放，壁间留诵石斋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上枣林诸闸","author":"林光","text":"酒杯谁共领风光，一日春催一日忙。\n闸水添疑潮夺岸，燕泥融讶草生香。\n丹心未逐风旗舞，暮景何堪道路长。\n世味尝来今更熟，了无清思入诗囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过临清","author":"林光","text":"一线漕渠几尺深，往来南北日骎骎。\n风尘乍惨今朝目，闸水狂惊昨夜心。\n春半尚无花可赏，诗成那许酒停斟。\n边河杨柳初舒眼，安得黄鹂送好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河西务阻风适王冬官以和赵秋曹杂诗见示遂用韵纪怀九首 其一","author":"林光","text":"午夜呼号直彻明，梦魂惊挠不曾清。\n浮埃满眼河西务，又阻扁舟一日行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河西务阻风适王冬官以和赵秋曹杂诗见示遂用韵纪怀九首 其二","author":"林光","text":"飞飞白纸挂坟端，寒食人家火已钻。\n敢怨颠狂淹去棹，却愁风定百花残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河西务阻风适王冬官以和赵秋曹杂诗见示遂用韵纪怀九首 其三","author":"林光","text":"函谷西封欠一丸，閒愁关系正无端。\n风埃会洗清明雨，老我寻芳兴未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河西务阻风适王冬官以和赵秋曹杂诗见示遂用韵纪怀九首 其四","author":"林光","text":"扁舟北上任迟迟，身计升沉我自知。\n静掩篷窗聊饱睡，却怜分减好春时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河西务阻风适王冬官以和赵秋曹杂诗见示遂用韵纪怀九首 其五","author":"林光","text":"挠乱诗怀几许清，浮云遮隔日微明。\n东君转盻回辕去，满耳池蛙草自生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河西务阻风适王冬官以和赵秋曹杂诗见示遂用韵纪怀九首 其六","author":"林光","text":"飞步相将到玉阶，人间尘土未沾鞋。\n篙师莫与风师敌，歛棹篷窗供佛斋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河西务阻风适王冬官以和赵秋曹杂诗见示遂用韵纪怀九首 其七","author":"林光","text":"刚风猎猎鬓丝丝，添得行囊几句诗。\n花鸟未酬今日兴，寻常又到暮春时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河西务阻风适王冬官以和赵秋曹杂诗见示遂用韵纪怀九首 其八","author":"林光","text":"春深风伯意何如，乱搅浮云泊太虚。\n我亦懞头安敢讼，白云聊寄广东书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河西务阻风适王冬官以和赵秋曹杂诗见示遂用韵纪怀九首 其九","author":"林光","text":"黄埃满眼正愁人，疲乏篙师打号频。\n何似知难先退步，名花留得几分春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入京","author":"林光","text":"衰颜羞照潞河清，行尽东南数十程。\n卜任何妨排甲子，看花刚好及清明。\n黄埃未染心先怯，白昼真愁梦未醒。\n夜雨欣逢一开霁，马前千嶂拥都城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵李祯伯秀才面侍方石先生索赠二首 其一","author":"林光","text":"独乐谁家更买园，天台一老兴犹存。\n生忘水月梅为侣，步破苔莎竹有孙。\n阅世却留吾眼碧，救时终感圣言温。\n南垞北沜花栽满，甘雨和风总是恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵李祯伯秀才面侍方石先生索赠二首 其二","author":"林光","text":"红紫争春正满园，几番风雨几枝存。\n乾坤运化开远合，铜狄摩挲子又孙。\n老凤自应知否泰，冥鸿先已识寒温。\n鬷明白首浑无语，携手难求叔向恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出安定门偶至华藏寺","author":"林光","text":"厨烟初散晓风凉，独自鞭羸到上方。\n僧井水甘初试茗，佛堂炉冷更燃香。\n摩挲老眼寻丹壁，拾飒麻衣挂麦芒。\n欲问山门兴废事，古碑无字枕颓墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵周文郁送蜀葵栽 其一","author":"林光","text":"反舌无声夏欲穷，野蒿满径闹芳丛。\n名花移植根犹浅，未许柔苗战乱风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵周文郁送蜀葵栽 其二","author":"林光","text":"何限天机话未穷，翠交庭草茂丛丛。\n向阳已识葵真性，长养还须花信风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卜居","author":"林光","text":"谁家庭院雅宜诗，挥尽行囊亦不辞。\n清兴每因尘俗减，虚名多误贵人知。\n堂思杜甫流离日，园想温公独乐时。\n步步风埃疲老脚，懒随曾点浴乎沂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迁居四首 其一","author":"林光","text":"拈弄天机几句诗，抛梁那更用新辞。\n庭供午枕花饶笑，门换春风燕未知。\n香袅篆烟帘捲后，白生虚室坐忘时。\n藩篱撤尽无遮碍，乐地何须羡鲁沂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迁居四首 其二","author":"林光","text":"一度花开一度诗，青毡虽冷亦何辞。\n门庭洁处人心别，世味尝来鬓脚知。\n纳尽帘风炎暑日，步低檐月醉醒时。\n宫墙数仞无由入，魂梦年年绕泗沂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迁居四首 其三","author":"林光","text":"佳境才拈便有诗，六经何用赘浮辞。\n重门昼掩真长策，白月宵临即故知。\n居偶宽凉容展步，事无牵强但随时。\n明朝策马都城北，吟弄西湖当浴沂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迁居四首 其四","author":"林光","text":"浣花溪里草堂诗，山水空怀子美辞。\n庭户偶堪供起倒，市廛那惜断闻知。\n磁瓯酒泻歌吟里，柳笔风生酩酊时。\n谁道文房关闭密，也容归梦过淮沂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居且弥月旧主迟迟未去诗以促之","author":"林光","text":"变换门庭更买新，休论谁富更谁贫。\n梁间已换来巢燕，榻外那容鼾睡人。\n两耳岂堪闻毁瓦，千金犹欲买比邻。\n我来暂作栽花主，莫怪晨昏吠犬嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西厅候试诸生呈堂尊方石先生","author":"林光","text":"堂堂胄监萃儒冠，虚席公来众尽安。\n言志何尝非善诱，较文那谓启争端。\n尘埃望雨真如渴，花木逢春自可观。\n笑我衰残无一技，也随桃李育桥门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西厅写怀","author":"林光","text":"逢人羞更语弹冠，寄迹贤关席未安。\n去脚驱驰春已暮，浮云挥扫事无端。\n芝兰径里风微动，枢斗天喧夜耸观。\n放笔自歌还自笑，尘埃满眼拜谁门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠林仰之迁南京国子监丞","author":"林光","text":"叉手东风月一更，我来君去最关情。\n天机转弼南都教，人事难逃月旦评。\n四海英豪频属望，八闽衣线念非轻。\n乡书首发他年解，谁道吾侪眼亦明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"代赠仰之子","author":"林光","text":"笑将图画写睽离，画不能言更著诗。\n山色高低催去棹，莺花撩乱倒深卮。\n云霄有路看飞翮，经典何缘托旧知。\n荡荡薰风吹鍻袂，别时先已计来时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨子山行人奉命有事于武冈亲王将便道归省来叙别诗以奉赠","author":"林光","text":"雨脚初收日向低，哦诗斟酒惜分携。\n庭花喜听乡音笑，枥马如留客子嘶。\n使节仰瞻衡岳近，天香持过洞庭西。\n莱衣归舞羊城月，乐事真堪满卷题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺周文郁得子","author":"林光","text":"都城产子甫胜冠，十八年来又此欢。\n笑我两叨汤饼会，他乡仍作故园看。\n一门谱续宗支茂，九地心知伯氏宽。\n向老铨专还展限，天留福地在长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同唐荣夫大行人余宗周侍御过马文明中舍西轩小酌席中赋二首 其一","author":"林光","text":"薰风暑汗正沾裳，邂逅还来共此觞。\n冰碗凝寒摇日影，荷筒分窍吸天香。\n庭花总有催诗意，鸟语浑如笑客狂。\n多谢诸公能爱我，欲挥馀兴上轩墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同唐荣夫大行人余宗周侍御过马文明中舍西轩小酌席中赋二首 其二","author":"林光","text":"面面清风洒葛裳，麻姑陈酒更盈觞。\n宜男砌草迎人绿，菡萏盆荷称意香。\n笔底敢降今日敌，胸中无复少年狂。\n阿谁绘得閒滋味，几片丹青挂短墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次余空夫侍御","author":"林光","text":"解带风轩小坐时，雨馀花草正撩诗。\n淋漓墨汁书乘醉，屈曲荷筒酒及迟。\n握手倾心非偶事，忘形如我是何谁。\n官閒自笑无羁绊，踏月归来亦不辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答马中舍二首 其一","author":"林光","text":"偃卧空庭月满裳，陶陶曾未引杯觞。\n图传周子元无字，梅写林逋尚有香。\n夜合烟消栽渐长，蕡麻风逐舞还狂。\n眼中新得知音友，折简难呼入我墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答马中舍二首 其二","author":"林光","text":"亭午方将瞌睡时，洗心又领一番诗。\n閒来弄笔君应捷，老去论心我自迟。\n广大桥门容吏隐，摩挲铜狄记人谁。\n开樽夜夜看明月，扫尽支离误世辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六月苦雨","author":"林光","text":"电掣风驰变霎然，满街流潦涨如川。\n人因屋漏多嗟雨，我愿年登欲补天。\n违湿五迁窗榻外，燎衣三易壁灯前。\n丈夫耻作安□□，□□□□□万年。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太博沈文华招饮苏鲁麻酒","author":"林光","text":"殊方传酿得新醅，糯麦融成造化胎。\n风韵只凭葭管透，阳春疑似蜀江来。\n坛封未许诗人剖，糟粕常令盏水催。\n俛首何妨作牛饮，污樽争挽古风回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题逸老堂卷","author":"林光","text":"双眸窥破覆前车，吏隐心藏入仕初。\n墨发归来忘此世，青山依旧统吾庐。\n寻诗野寺游应惯，看竹邻家到亦疏。\n逸老堂空观化后，松风泉韵自长歔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次潘孔修秋官怀南韵时孔修乞南畿便养兼致赠别意","author":"林光","text":"老去耽诗亦是魔，怀南满卷听吾歌。\n心悬手线鹑衣绽，目断秋云雁影过。\n八十慈颜应怅望，三千归路易蹉跎。\n为忠为孝男儿事，未许人推艳语多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再次潘武库恩迎韵","author":"林光","text":"积雨深秋快一晴，圣恩新领出都城。\n便亲子恳陈章疏，养志人多托弟兄。\n日薄西山催令伯，官行南国慰初平。\n梨黄枣赤堪携酒，更续阳关第四声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别沈文华太博迁辽府长吏","author":"林光","text":"官寓桥门傍帝墀，尘埃几度振皋比。\n经生喜授西川易，王相新推太傅师。\n江水屈蟠荆郢远，云霄环顾楚山卑。\n寻常语泄天机妙，却忆夫君首肯时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠李大使将致仕南归","author":"林光","text":"从事劳劳鬓已丝，云间归去乐何疑。\n逡巡酒压荔枝熟，骨董羹调蚬子肥。\n世路魔来多险阻，官阶梦破任崇卑。\n秋风却羡天边雁，也解随阳到海涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别诸用昭助教迁郑府太傅","author":"林光","text":"圣恩初拜出金銮，便买仙舟逐急湍。\n藩相尊推中土贵，带花光变旧毡寒。\n三千岂谢程途远，八十难忘母子欢。\n红树白云秋似水，饯君深欲拉同官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对凤仙花","author":"林光","text":"墙角株株得意时，能红能白看成痴。\n清秋坐转虚檐日，我亦如花花不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉慰相国李西涯先生丧冢嗣","author":"林光","text":"造化小儿没定期，倒横直竖报迟迟。\n唐侯纵有朱何托，鲁叟能无鲤也悲。\n看破西铭恩自普，验穷周易吉多违。\n庙堂栋柱先生在，肯怨秋风哭我私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中追和东坡韵八首 其一","author":"林光","text":"絮粘枯树闹饥鸦，载酒过门问小车。\n屐齿每嫌穿碧玉，陶铛端欲煮琼花。\n剡中夜舫殊堪画，驴背诗情却到家。\n老我都城兴无限，那钱买醉不藏叉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中追和东坡韵八首 其二","author":"林光","text":"纷飞撩乱扑朝鸦，老妇贪看驻纺车。\n三白果堪登百谷，一香何惜让群花。\n光添玉宇无边景，清变都城几万家。\n坐拥羊茸挥老兴，冻呵寒砚手频叉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中追和东坡韵八首 其三","author":"林光","text":"冻笔狂提谩扫鸦，跏趺忘却紫河车。\n连阴未识天何意，积瑞贪看眼欲花。\n倏往忽来怜剡曲，浅斟低唱是谁家。\n冲寒便欲鞭羸去，踏遍皇都路几叉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中追和东坡韵八首 其四","author":"林光","text":"寒林凝重堕翻鸦，更恐通忂汗辗车。\n阴积何愁胶地轴，冬深乱落爱天花。\n兵踰蔡壁奇谁策，茗煮琼瑶笑我家。\n求道何人心似铁，立深三尺手还叉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中追和东坡韵八首 其五","author":"林光","text":"冻拈诗笔指纤纤，时到隆冬气自严。\n三白依稀呈国瑞，半空摇漾洒吾盐。\n琼瑶夺目皆填市，玉箸凝冰已挂檐。\n会见晴无云一点，西来看尽万峰尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中追和东坡韵八首 其六","author":"林光","text":"天机谁与辨毫纤，岁纪庚申忆在严。\n葭管欲飞冬至节，犁花飘杂水晶盐。\n寒催皎兔逃三窟，饥困乌鸦傍暮檐。\n酒落诗肠醒复醉，蛟龙驱舞笔锋尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中追和东坡韵八首 其七","author":"林光","text":"轩冕浮云藐若纤，羊裘大泽钓输严。\n吟看匝地光浮玉，坐恐周天误雨盐。\n瞑目伊川尸讲席，齐腰释子立穷檐。\n白头吏隐桥门下，诗到忘新不用尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中追和东坡韵八首 其八","author":"林光","text":"浮云全不动毫纤，争识元冥今最严。\n千首杜陵高格调，两年白帝困齑盐。\n磁瓯索醉那辞酒，鸠杖扶衰更绕檐。\n何处梅花堪放艳，风刀刮面利尖尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":52248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]