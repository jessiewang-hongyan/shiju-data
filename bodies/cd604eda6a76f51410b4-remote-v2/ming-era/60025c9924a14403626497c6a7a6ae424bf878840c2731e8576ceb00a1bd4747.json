[{"title":"甘肃元旦次朱都宪韵","author":"何乔新","text":"玉关雪霁绝狼烟，殊胜呼韩款塞年。\n万灶貔貅森列卫，两班冠剑俨群仙。\n明珠翡翠来重译，卉服毡裘共一天。\n羽檄不飞刁斗静，蚤看嘉绩勒燕然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8567,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过长城作","author":"何乔新","text":"断垣迤逦亘?坪，云是秦人旧筑城。\n折戟每因耕后出，斜蒿时向雨馀生。\n瓮门草满鼪鼯啸，雉堞云消鹳鹤鸣。\n东望狼村三舍近，凄凄烟树倍伤情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8568,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽王都宪","author":"何乔新","text":"汉口当年醉别卮，岂知嘉会更无期。\n玉关已喜生前入，汗简空垂没后思。\n夜月柳营笳吹断，秋风蒿里铎声悲。\n白茅藉饭无由致，南望章江泪满颐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8569,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送朱都宪巡抚两广兼总督军务","author":"何乔新","text":"紫袍香拂御炉烟，出镇仍兼将相权。\n铁骑千群嘶去路，绣旂五色照离筵。\n榕城霜重炎氛净，桂岭云消黛色鲜。\n文武兼资能有几，蚤看勋业继名贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8570,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽德安张都宪瓒","author":"何乔新","text":"黄鹤矶头醉别筵，别来云树两茫然。\n才闻奏对趋三殿，忽讶音容隔九泉。\n衰草晚烟平寇垒，长堤春水饷兵船。\n欲寻斧屋涢川曲，鼓子花残落照边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8571,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李黄门孟旸使占城","author":"何乔新","text":"金函颁诏出彤墀，特命儒臣抚岛夷。\n龙节远稽周典礼，鸡林重睹汉官仪。\n海云敛色迎丹仗，水怪潜形避绛旗。\n路过越裳烦告谕，皇家威德迈周时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8572,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过畅村作","author":"何乔新","text":"行行疋马过孤村，土屋荒凉昼掩门。\n豪客用人如楚子，名家裸葬似王孙。\n怪鸮磔磔烟光暮，冤鬼啾啾月色昏。\n太息生灵馀几许，空原一眺黯消魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8573,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"绛阳道中谩成","author":"何乔新","text":"城郭萧条村落空，潸然清泪堕西风。\n萑蒲有盗如朱粲，郡邑何人似郑公。\n云暗荒郊啼馁鬼，日斜古道泣衰翁。\n独惭未有匡时策，翘首苍冥祝岁丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8574,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山西大饥人相食哀叹之馀谩成一律","author":"何乔新","text":"春风不入野人家，白骨如丘事可嗟。\n小瓮满储彭越醢，轻车稳载德光羓。\n头颅无复归黄壤，腥腐犹能饱暮鸦。\n立马邮亭倍惆怅，几行老泪洒烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8575,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜雨诗 其一","author":"何乔新","text":"翩翩鸿雁正哀鸣，谁把天瓢此夕倾。\n稻畎青回春意足，蘋池水长晓波清。\n残民已有生成望，委巷初闻笑语声。\n愧我西来无寸补，载歌周雅颂皇明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8576,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜雨诗 其二","author":"何乔新","text":"屏翳驱云昼不开，龙瓢滴滴自天来。\n才看白练垂檐隙，忽报银河落涧隈。\n嫠妇从今收滞穗，田家无复叹污莱。\n朝来默听民歌颂，尽道皇仁被九垓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8577,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜雨诗 其三","author":"何乔新","text":"天心允协帝心仁，一雨祁祁慰我民。\n润洽枯荄含秀色，凉生远树绝熇尘。\n污池喜听蛙声闹，荒圃惊看菜甲新。\n只恐户曹徵税急，遗黎依旧走逡逡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8578,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和安道宪副颍阳元日述怀 其一","author":"何乔新","text":"行台吏散昼无哗，此处停骖即是家。\n古柏每怜含晚翠，枯荄渐觉换春华。\n寿觞香泛金茎露，瑞雪寒凝玉树花。\n却笑病躯偏冗迫，晨兴不待玉衡斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8579,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和安道宪副颍阳元日述怀 其二","author":"何乔新","text":"病起那堪燕雀哗，式微歌罢苦思家。\n梁公尚不知师德，介甫惟闻荐子华。\n世事悠悠蕉下鹿，人情淡漠雾中花。\n鄱湖西去先庐在，归梦时穿竹径斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8580,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"弘治三年春三月望上御奉天殿亲策天下贡士命公卿及文学之臣赴东阁读卷都宪屠公赋诗以纪盛事诸公相属和之仆忝同事谨步严韵不自知狗尾续貂之不可也 其一","author":"何乔新","text":"御柳低垂禁苑春，临轩又睹缛仪新。\n群英献策陈王道，诸老赓歌颂帝仁。\n待漏金门晨整佩，论文玉署昼垂绅。\n连宵襆被容台宿，遥望奎光映紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8581,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"弘治三年春三月望上御奉天殿亲策天下贡士命公卿及文学之臣赴东阁读卷都宪屠公赋诗以纪盛事诸公相属和之仆忝同事谨步严韵不自知狗尾续貂之不可也 其二","author":"何乔新","text":"天子龙飞海宇春，盛时典礼喜重新。\n文华读卷瞻天表，楮币颁恩荷圣仁。\n光溢金卮分御醴，香浮宝鼎散朝绅。\n得贤深为皇家喜，曳履从容出禁宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8582,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"传胪之明日赐宴礼部凡供事者皆与焉都宪屠公又赋一律仆再和之","author":"何乔新","text":"恩荣曾醉杏园春，垂老重沾宠命新。\n饼剪红绫思旧制，酒分黄缥荷深仁。\n云随舞羽来庭戺，风送天香到佩绅。\n圣德如天惭未报，载歌鱼藻拜枫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8583,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"文华殿读卷次司马马公韵","author":"何乔新","text":"彤楼日转漏频催，献策咸推贾董才。\n吾道喜同文运泰，圣颜还为直言开。\n儒臣捧卷来深殿，常侍濡毫近上台。\n日晏传宣催赐宴，五云高处醉金杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8584,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谨身殿开卷出听传胪次学士李公韵","author":"何乔新","text":"霁月当空八牖明，履声晨并殿廊行。\n上卿开卷初题榜，宣赞当阶迭唱名。\n天际庆云昭瑞应，御前大乐奏和声。\n金明路上人相语，天与吾皇产俊英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8585,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"恩荣宴又次学士李公韵","author":"何乔新","text":"籥翟当庭奏乐频，琼林锡宴际芳辰。\n槐阴绿映伶官服，花气香飘舞佾巾。\n淳酎润含仙掌露，欢声散作帝台春。\n英声感激争相勉，誓秉忠贞敢爱身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8586,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东阁读卷次少司空谢公韵","author":"何乔新","text":"金銮策士诏群卿，礼乐纵横细与评。\n黼黻舜衣期补衮，盐梅商鼎用和羹。\n喜闻瑞霭空中见，肯羡青云足下生。\n记得蚤年登第日，蓝袍济济看题名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8587,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谭都督祠","author":"何乔新","text":"铁骑凭陵压北门，将军拥卒战平原。\n秋风孤戍边声急，落日重围杀气昏。\n帐下健儿争效死，阵前强敌暗消魂。\n至今溪水含馀怒，夜半填然万鼓喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8588,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日登鹞子崖","author":"何乔新","text":"秋风吹我上层崖，周览茫茫亦快哉。\n对菊始知佳节到，看山却喜壮怀开。\n浮云变态元无定，逝水奔流不复回。\n北望帝城才咫尺，金觚玉阙是蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8589,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张启昭 其一","author":"何乔新","text":"劝讲文华沐宠优，欲将直道赞皇猷。\n金人何用三缄口，铁汉从教一斫头。\n台谏交章良可笑，儒绅咋舌亦堪羞。\n圣恩眷注元无替，肯使南都久滞留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8590,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张启昭 其二","author":"何乔新","text":"乡邦交谊最相亲，忍向离筵劝酒频。\n抗疏但求禆圣治，论思端不忝词臣。\n自怜石介非狂士，任诋西山是小人。\n暂别銮坡非远谪，莫将辞赋吊灵均。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8591,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东河驿寄京师诸友","author":"何乔新","text":"北山歌罢泪浪浪，承命西来鸟道长。\n使节昼冲秦岭雪，征骖晓踏渭桥霜。\n愁肠暗逐鹃声断，归梦常随雁影翔。\n京国同袍应笑我，马蹄连岁为谁忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8592,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白瀑寺用壁间韵书怀","author":"何乔新","text":"宦辙驰驱志已慵，无心更觅彻侯封。\n但令气节垂青简，不羡勋名勒景钟。\n官况天边云澹澹，客愁雨后叶重重。\n呼童汲取山头瀑，一洗秋来憔悴容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8593,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"播州行台偶书","author":"何乔新","text":"万里驰驱到夜郎，亲承紫诏谕殊方。\n欲持清白光先训，敢毁廉隅负圣皇。\n琴鹤不教随使骑，金珠况肯入行装。\n宾朋试解悭囊看，祗有新诗十数章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8594,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早朝听誓戒","author":"何乔新","text":"彤楼钟动万鸦飞，玉佩珊珊向禁闱。\n银烛影摇温室树，宝炉香拂侍臣衣。\n鸿胪传制依黄道，禁旅鸣鞘拱紫微。\n朝罢从容归陋院，喜看旭日散晴辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8595,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"驾出南郊","author":"何乔新","text":"羽林清跸出都城，圣主南郊展敬诚。\n紫极氛消春日丽，黄坛尘静晓风轻。\n鸡翘影逐龙舆动，鼍鼓声随象辇鸣。\n欢溢臣民咸抃舞，此生何幸睹升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8596,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"斋居赐蜜饵","author":"何乔新","text":"金盘蜜饵出彤庭，天语丁宁赐列卿。\n宋室凤团宁擅美，楚宫椒糈浪驰名。\n香甘方士青精饭，润滑仙家紫石英。\n衰朽自惭无补报，载歌天保祝皇明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8597,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南郊陪祭","author":"何乔新","text":"圣朝奠璧礼圜丘，万炬飞光映冕旒。\n斋殿云深清漏迥，燎坛风暖瑞烟浮。\n灵祗分献多儒硕，辇路群趋尽彻侯。\n湖海愚臣忝陪祀，愧无词赋颂鸿休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8598,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宪副郁公惠青布及诗酬以白纻并赋诗答之","author":"何乔新","text":"湘川别后几星霜，青布慇勤远寄将。\n展玩尚涵江气润，裁成长带淀花香。\n诗人莫刺蜉蝣羽，骚客空誇薜荔裳。\n白纻愧非琼玖报，池亭聊用纳新凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8599,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜斋宿怀仲深宗伯","author":"何乔新","text":"耿耿星河映户明，斋居徙倚不胜情。\n啼蛩石砌秋声早，落叶银床夜景清。\n归计未成心转急，炎威渐退气初平。\n知公亦有幽栖志，何日联镳出凤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8600,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出京偶成","author":"何乔新","text":"九重命下许归休，便向江头买去舟。\n客梦未离金阙树，乡心已逐楚江鸥。\n身同裴相投间乐，事异灵均去郢忧。\n圣德如天惭未报，回瞻紫禁思悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8601,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太宰介庵先生以诗饥别用原韵奉答 其一","author":"何乔新","text":"晓拜彤墀出帝城，寒江归去结鸥盟。\n秋兰萧艾何香臭，蝉翼黄钟孰重轻。\n滕甫未应为恶党，休文非必是狂生。\n于今谁秉春秋笔，忠佞廉贪好细评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8602,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太宰介庵先生以诗饥别用原韵奉答 其二","author":"何乔新","text":"谢病连年叩紫宸，挂冠今喜作閒人。\n思莼正值新秋候，种豆还期故里春。\n忧国独怜君实切，论交谁似景仁真。\n炎风朔雪烦调燮，珍重当朝社稷臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8603,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太宰介庵先生以诗饥别用原韵奉答 其三","author":"何乔新","text":"晓纳牙牌别禁城，竹梅拟结岁寒盟。\n君恩何啻万钧重，行旅从来一叶轻。\n誓保忠贞全晚节，肯求温饱负平生。\n鹤山未必非君子，成大如何敢妄评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8604,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太宰介庵先生以诗饥别用原韵奉答 其四","author":"何乔新","text":"冠盖追随出拱宸，知几已后鲙鲈人。\n黄花烂熳东篱晚，紫蕨离披别墅春。\n谁识张汤多变诈，自怜汲黯任天真。\n归与且饱鱼羹饭，休论忠臣与佞臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8605,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归田后连得二子秋官郁君以诗相贺次韵答之 其一","author":"何乔新","text":"垂老㷀㷀每自怜，双雏初乳却欢然。\n窦家骥凤虽难比，白傅文章幸有传。\n稍喜阶前瑶草秀，敢誇掌上宝珠圆。\n山间汤饼无兼味，聊和新诗侑庆筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8606,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归田后连得二子秋官郁君以诗相贺次韵答之 其二","author":"何乔新","text":"静倚松窗感物华，平生踪迹半天涯。\n蜀秦鸟道频驰传，楚粤鲸波几泛槎。\n有口耻尝楼护膳，无庐肯主瘠环家。\n悠悠往事休重道，且向青门学种瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8607,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜不寐卧诵郁秋官诗用韵述怀 其一","author":"何乔新","text":"南北驱驰叹独贤，归来林下喜陶然。\n幸多圆史留儿读，讵有勋名与世传。\n抱瓮虽劳甘守拙，方知欲凿耻为圆。\n茆檐饱吃鱼羹饭，似胜侯家玳瑁筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8608,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜不寐卧诵郁秋官诗用韵述怀 其二","author":"何乔新","text":"宦游几载厌纷华，乞得閒身钓水涯。\n骑马懒从听禁漏，问津直欲泛仙槎。\n虽无食客堪延誉，幸有痴儿可保家。\n负郭何须田二顷，数畦祗种邵平瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8609,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"子弟廷祺园中紫牡丹盛开邀予赏之醉后赋二律以识其事时弘治八年二月廿二日也 其一","author":"何乔新","text":"看花几见洛阳春，魏紫嫣然迥绝伦。\n玉板每惭攀逸驾，鹤翎无计避芳尘。\n香同荀令携来好，色似韩湘染未匀。\n今日对花须尽醉，黄荃画里本非真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8610,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"子弟廷祺园中紫牡丹盛开邀予赏之醉后赋二律以识其事时弘治八年二月廿二日也 其二","author":"何乔新","text":"前身应是紫薇郎，化作名花擅国香。\n初讶晓烟笼翠幄，忽疑甘露沁霞觞。\n灵根浅映兰芽嫩，秾艳微涵歙砚光。\n世代祗今怜间色，谁脩花谱续欧阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8611,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"读康斋集作","author":"何乔新","text":"濂洛关闽迹久湮，斯文何幸得斯人。\n朱弦一曲声偏澹，玄酒千觚味独醇。\n竹色花香元自乐，芸编缃帙不为贫。\n纷纷黄小休轻讪，见道谁如此老真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8612,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"閒居述怀","author":"何乔新","text":"万里归来已白头，溪风山月思悠悠。\n黄河铁骑成春梦，锦水牙樯忆旧游。\n病后更添元凯癖，閒中还抱杞人忧。\n桃花流水知何处，愿与渔郎共放舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8613,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"都宪韩公贯道惠诗次韵答之 其一","author":"何乔新","text":"疏庸久荷圣明知，却恨非才贸盛时。\n三晋云山应识我，两京议论竟归谁。\n閒寻平子归田赋，懒诵灵均问卜辞。\n渭树江云嗟契阔，何当一醉习家池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8614,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"都宪韩公贯道惠诗次韵答之 其二","author":"何乔新","text":"老得悬车古亦难，桔槔春雨静中看。\n昔年曾叱王尊驭，此日休弹贡禹冠。\n春草池塘诗思逸，午桥樽俎酒肠宽。\n萧萧风雨鸡鸣夜，菊枕芦衾睡正安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8615,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"癸已岁藩省祝寿和自立韵 其一","author":"何乔新","text":"文武班联玉笋行，紫袍赤舄烂成章。\n共推宝历承三统，更喜皇风被八方。\n香影暗随云影动，恩波元共海波长。\n炎荒未许淹弘识，伫见鸣珰侍圣王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8616,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"癸已岁藩省祝寿和自立韵 其二","author":"何乔新","text":"两阶剑佩俨成行，缥缈登歌奏大章。\n万国衣冠环北极，九天雨露洽南方。\n香飘仙仗微风度，星转银河晓漏长。\n最喜三边氛祲息，征西诸将縳戎王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8617,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宋玉宅","author":"何乔新","text":"旧宅萧条泮水隅，骚人曾此托幽居。\n荒台日暮无行雨，废圃春深有揭车。\n茂树櫹椮摇落后，姱辞曭朗变风馀。\n巫阳歌罢秋天迥，应有遗魂返故墟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8618,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"樊城怀古","author":"何乔新","text":"断垣衰草古樊城，胜国当年此战争。\n往事已随流水逝，空山犹倚暮云平。\n幡幢隐隐仁王寺，葭菼萧萧虏将营。\n登览怅然怀往哲，烝民歌罢不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8619,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谒贾太传祠作 其一","author":"何乔新","text":"汉殿从容席屡前，得君何事遽南迁。\n孝文犹自疏贤佐，绛灌能无妒少年。\n寂寂荒祠啼鵩鸟，沉沉遗甃洌寒泉。\n从来材大难为用，惜誓歌残一泫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8620,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谒贾太传祠作 其二","author":"何乔新","text":"经国材猷迥绝伦，春秋以后见斯人。\n谁知一代兴王佐，遽作三湘放逐臣。\n斜日坐隅来怪鸟，寒烟江上吊灵均。\n须知穷达皆由命，何用悲伤自殒身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8621,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题徐氏贞节卷","author":"何乔新","text":"孤篁劲柏翠交加，静处幽闺阅岁华。\n誓保贞骸归北垄，忍移芳屣到东家。\n梁间愁见春巢燕，庭际羞栽夜合花。\n青简已书中垒传，昭昭姱节世争誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8622,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中感怀集句","author":"何乔新","text":"短棹吴歌花满川，客心何事转悽然。\n平生自笑王夷甫，少日真期鲁仲连。\n独对青灯思往事，忍将离恨托哀弦。\n故园尚有平生约，落日孤云望眼穿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8623,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题桃源小隐集句","author":"何乔新","text":"桃源面面少风尘，独构茅堂养道真。\n万叶秋声孤馆梦，一庭草色自家春。\n祗从暮醉兼朝醉，却恐閒人是责人。\n借问路傍名利客，朱门虽富不如贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8624,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"福安书事 其一","author":"何乔新","text":"海门夜半吼长鲸，怒捲闾阎入巨溟。\n惟有清霜台上桧，亭亭不改旧时青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8625,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"福安书事 其二","author":"何乔新","text":"市闾白昼舞天吴，无限群生化作鱼。\n弭节行台增慨叹，萧条邑里似荒墟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8626,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"福安书事 其三","author":"何乔新","text":"兵后萧然甑有尘，更堪疠鬼困残民。\n惭予不是张希孟，也对斜阳泪满巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8627,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"福安书事 其四","author":"何乔新","text":"驱车晓度碧山隈，拂拂腥风逆鼻来。\n怪得饥鸢飞舞下，前村露骴卧污莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":8628,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]