[{"title":"送李比部廷实守兴化","author":"欧大任","text":"乌石推名郡，儒风大海隅。\n行应持鹊印，恩已赐麟符。\n子荔红云岛，侯梅白雪湖。\n看君飞盖日，词客待操觚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭李驾部归榇","author":"欧大任","text":"共惜舆司马，都人聚哭号。\n天心何殄瘁，王事竟疲劳。\n丹旐城边雨，青舲海上涛。\n钱唐归葬日，风木正萧骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送顾君实游南雍还上海","author":"欧大任","text":"槐市传经去，东归不可留。\n绣襦明月佩，金埒少年游。\n海燕迎乡路，江花照客舟。\n子云怜父党，相忆白门楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有方斋为许徵君作","author":"欧大任","text":"出告游非远，耕锄十亩馀。\n承颜思问寝，食力命巾车。\n陶令瓶惟粟，班生赐有书。\n羡君欢綵服，兰玉更谁如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦归","author":"欧大任","text":"应世吾何玩，谁令未拂衣。\n三江双桂楫，五岭一荆扉。\n羁绁名为辱，蹉跎梦每归。\n岂因灌园日，始息汉阴机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王元美闻予转虞部见寄二首 其一","author":"欧大任","text":"尔宅金庭近，楼居夏亦凉。\n智锋挥宿障，慧炬照迷方。\n桂父贲禺外，茅君句曲旁。\n山虞应可笑，岂是汉冯郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王元美闻予转虞部见寄二首 其二","author":"欧大任","text":"游仙劳远梦，招隐寄操觚。\n坛下毛公石，帆前范蠡湖。\n学将参小品，书未著潜夫。\n黄鹄空相望，翩翩肯载无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送沈秉忠还钱唐","author":"欧大任","text":"君去问桑梓，欢逢兵气销。\n月从天竺寺，秋入海门潮。\n酒舫歌迎客，渔家醉答樵。\n秣陵游可忆，倘得似南朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送卫比部君大守温州","author":"欧大任","text":"握得麟符去，谁知请郡情。\n渔樵歌五裤，郊遂望双旌。\n白雨江心寺，青枫斗口城。\n琅琊王内史，犹重永嘉名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送冯孝廉咸父北上","author":"欧大任","text":"斗酒青溪曲，君行谒玉除。\n家传缑氏学，兵少洛阳书。\n御宿春飞骑，承明夜直庐。\n他时看建节，何但汉相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周鸿胪汝砺李太仆孝甫王孝廉永叔过溪上","author":"欧大任","text":"留客秋偏暑，江东艇未行。\n烟霞频瞩目，兰芷一交情。\n醉问贤人酒，歌残子夜声。\n五君谁更咏，且傍竹林名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答钱功父","author":"欧大任","text":"建业孤舟路，维扬几岁书。\n长鞭愁策马，尺素问烹鱼。\n曲奏吴趋市，玄留蜀客庐。\n秋风苦萧瑟，隐几兴何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴驾部公择斋中同臧晋叔钱仲美二博士玩菊","author":"欧大任","text":"兴来吾不浅，问菊进杯盘。\n分得朱门色，移从粉署看。\n金枝灯并照，玉艳雪争寒。\n欲奏山芗曲，秋风向上兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同周文美游宗振集顾司勋宅张幼于适至得来字","author":"欧大任","text":"清夜仙曹约，华筵竹下开。\n周颙携客至，张翰狎盟来。\n雅共三觞饮，歌逢九咏才。\n剧怜乘兴远，忻赏更徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同方鸿胪张太学集许太常宅限赋堂字","author":"欧大任","text":"风流建业盛，耆德甲江乡。\n宾客仍棋墅，烟霞似射堂。\n字从杨子问，酒爱次公狂。\n驺骑何劳促，寒宵玉漏长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张太学幼于刘大理长钦顾司勋道行胡孝廉元瑞枉集徐氏东园迟李临淮惟寅不至共赋心字二首 其一","author":"欧大任","text":"江东词客至，高会主家林。\n鹊起中原日，鸿冥异代心。\n并驱皆上驷，照座半南金。\n厌次今方朔，为郎尚陆沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张太学幼于刘大理长钦顾司勋道行胡孝廉元瑞枉集徐氏东园迟李临淮惟寅不至共赋心字二首 其二","author":"欧大任","text":"赐园名杜曲，邀客到山阴。\n弦管歌中合，鱼龙席下今。\n石曾驱海至，溪似入江深。\n骠骑难同赏，空驰径寸心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山亭再饯伯大同幼于道行用唐人韵","author":"欧大任","text":"白门一相送，斗酒缓君行。\n密树霜初落，离亭月渐生。\n山通巴子国，驿过锦官城。\n立马空凝望，寒江浪正平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同顾司勋张太学苏陆二山人夜集吴驾部斋中得蒸字","author":"欧大任","text":"知有酒如渑，西来兴可乘。\n歌能嘲饭颗，醉不答肴蒸。\n霜送高城析，星摇小院灯。\n江东皮陆后，谁得和松陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后黄都水道登李司封于田邀同张太学幼于饮徐氏东园限门字","author":"欧大任","text":"林竹过秋繁，雨声宵更喧。\n酒能携石井，车自问篱门。\n涧曲前朝寺，溪深太傅园。\n扳留劳秉烛，频得奉清言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕和顾司勋","author":"欧大任","text":"天涯惊节序，鹤发日偏长。\n寓直金陵岁，思归粉署郎。\n辛盘欢旧俗，浊酒醉他乡。\n鼓吹江南曲，春来满建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中送吴拾之还金溪","author":"欧大任","text":"客里惊分袂，词人正少年。\n游称吴季子，诗似谢临川。\n落雁帆樯侧，深江雨雪前。\n云林归有赋，早寄秣陵船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送尤计部被播暂归闽中","author":"欧大任","text":"行色候春星，闽峰九叠青。\n省兰初入握，江草已扬舲。\n书笑中山箧，关迎醉尉亭。\n主恩今不浅，趣召在宸扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送卓长习还杭州","author":"欧大任","text":"业成槐市日，鼓箧岂云劳。\n去泛三江棹，归看八月涛。\n季长犹赋颂，仲蔚且蓬蒿。\n汉室需才急，秋风起凤毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻朱评事可大自汝州量移崇德","author":"欧大任","text":"昔送滍阳去，今看槜李来。\n除书何日下，迁客未须哀。\n署里郎官旧，关东任侠才。\n白门江雁过，思尔数登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送来佥宪济时赴西粤备兵梧州","author":"欧大任","text":"为郎同舍久，冠豸羡君行。\n塞上遥开岭，牂牁曲抱城。\n请缨趋府客，吹笛下江兵。\n瓯骆劳招谕，千秋汉使名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳陈右父金道存聂道亨何惟圣吴载伯黄伯仲过集得歌字","author":"欧大任","text":"青溪修褉事，尊酒兴偏多。\n宅近陈中令，人犹晋永和。\n积苏初似树，鸣鸟半成歌。\n留客无丝竹，君能不厌过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"问夏绳卿病","author":"欧大任","text":"尊生知有道，犹遣问寒温。\n司马常称疾，东方更避諠。\n荆榛苍石几，芝术白云园。\n君向医王学，清凉自不烦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春姚唯之邬汝翼方康侯李季宣陈季迪诸子见过属芍药初开","author":"欧大任","text":"青溪拂石处，红药试花时。\n爱客欢方剧，开樽醉不辞。\n谢郎华省真，白傅礼曹诗。\n谁似闲如我，从君倒接䍦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏夜同刘廷尉吴驾部顾司勋集李司封宅","author":"欧大任","text":"钟岭临高阁，双桐夏亦寒。\n邀欢樽是桂，并署握皆兰。\n赋借文犀管，酣欹紫箨冠。\n夜深留客久，星汉一盘桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读何孝妇殷传","author":"欧大任","text":"负汲心非苦，齐眉食但贫。\n谁知呕血日，独有刲□人。\n涧月照青竹，江风吹白蘋。\n他年陈俎豆，思与孟家邻。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为刘屯部悼吴季子","author":"欧大任","text":"郎君东国彦，家学似丁宽。\n雨急折苍玉，霜清彫紫兰。\n修文何自早，遗札不能看。\n独有秋风叠，山窗夜夜寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杜子庸入都","author":"欧大任","text":"吴钩新结束，薜荔带堪裁。\n书劳严乐上，赋待马卿来。\n阊阖晓方辟，箜篌秋莫哀。\n更逢推毂日，汉主最怜才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同省中诸郎游莫愁湖登楼上","author":"欧大任","text":"酒楼不可问，舟子载琵琶。\n残黛诸堤柳，遗钿五浦花。\n一裘非李白，双桨似卢家。\n湖倚郎官赋，宁劳异代誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋吴幼安佘宗汉闵寿卿陈守礼郝谦亨程孺文黄白仲梅季豹集青溪馆汪象初祁羡仲不至得干字","author":"欧大任","text":"客过漫郎宅，依然不似官。\n桤林通崦曲，茅屋傍陀干。\n白雪芙蕖酒，秋风苜宿盘。\n两生期未至，犹作孟公看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送闵寿卿汪象初读书金山寺","author":"欧大任","text":"许询都讲去，浮玉白波南。\n海客求碑到，江僧写偈参。\n匡床开竹苑，乱帙寄花龛。\n米汁曾无禁，山觚半夜谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送葛士隆还通州省觐","author":"欧大任","text":"征虏亭前艇，踟蹰送客归。\n青持藏箧简，斑照上堂衣。\n江北帆初卷，淮南叶共飞。\n海霞开馆日，莫断孟家机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜同范比部介儒集方鸿胪允治署中得京高二字 其一","author":"欧大任","text":"衙斋凉露色，谁道在陪京。\n山近城乌起，篱疏涧鹿行。\n青镫寒卷幔，玉漏促飞觥。\n二纪看交态，谈深此夕情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜同范比部介儒集方鸿胪允治署中得京高二字 其二","author":"欧大任","text":"把酒何欢洽，中原得二豪。\n晋家方仆射，汉日范功曹。\n而我思鲈脍，逢人问蟹螯。\n江东今夜月，偏照鼎门高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子及返自滇中而予将归岭外感今叙昔情见乎辞","author":"欧大任","text":"沧海十年期，钟山今在兹。\n赐环君始返，捐袂我将辞。\n客傲亦自适，吏廉而可为。\n欲求千古士，别去谢班司。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题徐朝直课子图","author":"欧大任","text":"学已推文苑，儿今更宁馨。\n壁藏济南简，家授广川经。\n夜诵镫常碧，晨趋佩自青。\n豫章名父子，奎斗焕江星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏文甫将游五岳别于江东","author":"欧大任","text":"夏统药囊在，向平藜杖随。\n溪逢三笑客，岳待五游诗。\n济胜看能事，深栖愧夙期。\n挂冠神武去，终欲寄茅茨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日雨中同方允治集范介儒书斋同赋霞伦二字 其一","author":"欧大任","text":"招携非夙约，雨宴法曹家。\n厨出双樽酒，园滋五色瓜。\n潮沟添急溜，林苑入飞霞。\n沾湿银鞍远，何论过浣花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日雨中同方允治集范介儒书斋同赋霞伦二字 其二","author":"欧大任","text":"谁道山王会，犹能及伯伦。\n闭关聊玩世，结社欲栖真。\n萧爽斋中帙，沉冥竹下宾。\n他宵如听雨，应忆倦游人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄顾元浚评事","author":"欧大任","text":"京洛频相讯，才名顾长康。\n官称廷尉府，阁直秘书郎。\n槐影夹城近，漏声双阙长。\n因君劳远梦，秋思满江乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大有山房为天台黄生赋","author":"欧大任","text":"洞辟空明上，千秋委羽时。\n鸣鸿飞欲隐，控鹤去难期。\n旧业儒林传，名家祖德诗。\n谁知岩石卧，姓字动京师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆无从崔子玉梅季豹见过","author":"欧大任","text":"幽期曾不远，策蹇傍溪行。\n岂亦陈留郡，能寻阮步兵。\n鸣琴怡逸兴，浊酒寄浮生。\n落落南朝客，焉知世上情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陆纂父归洞庭山中","author":"欧大任","text":"去问渔樵路，东归过太湖。\n刺犹题处士，书自著潜夫。\n麈尾谈宾少，鱼肠借客无。\n橘林今正熟，千树给秋租。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7658,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"木末亭送孙叔达还吴门","author":"欧大任","text":"秋兴吴中去，津人暂系舲。\n菊花园客酒，贝叶竹僧亭。\n问路江浮碧，看山海涌青。\n未论丘壑胜，清世且沉冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7659,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送方伯书省觐还莆田","author":"欧大任","text":"千里宁亲舍，云霄尔不群。\n归舟风欲落，别路雁初闻。\n啸共蓬池客，书投沧海君。\n青箱推世业，去有荐雄文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7660,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送周公化游楚","author":"欧大任","text":"劳劳频送远，城下俯江流。\n夜雨三山渡，秋风七泽游。\n酒边堪顾曲，赋里似登楼。\n欲问莼鲈去，吴门待客舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7661,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"俞公临卜居阳羡有年矣余闻其幽适辄寄二诗 其一","author":"欧大任","text":"遁世荆南去，芳邻德岂孤。\n药畦黄檗涧，渔侣白鸥湖。\n两舫携芒屩，三驺对酒垆。\n知君工笔札，论可著潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7662,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"俞公临卜居阳羡有年矣余闻其幽适辄寄二诗 其二","author":"欧大任","text":"洞壑应非远，移家杖笠携。\n井犹王粲宅，山似戴颙栖。\n田父求绵上，诗人爱瀼西。\n他时新水长，吾欲问凫鹥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7663,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠邵南仲","author":"欧大任","text":"隐操存闾史，贤声重国琛。\n独怜堂背树，摧折百年心。\n跃鲤生难致，眠牛梦可寻。\n东山能内举，兰玉谢家林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7664,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日宋西宁忠父黄孝廉白仲李山人次公携酒过访得秋字","author":"欧大任","text":"十日布衣饮，西能问酒楼。\n长楸三骑过，短剑五陵游。\n投劾吾何晚，怀归不易求。\n马卿方病渴，犹卧汉园秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7665,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬彭虎少自全椒过江见访","author":"欧大任","text":"浦口帆初下，相寻到大航。\n摄衣花籞外，把酒药垆旁。\n龙剑星星跃，骊珠字字光。\n仲宣书籍富，应不待中郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邵长孺自吴门过别因寄无过虞仲","author":"欧大任","text":"谈君十年事，犹是马相如。\n科斗题周记，瓠卢饷汉书。\n归停青雀舫，去问白牛车。\n旧好应能忆，朱明有敝庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"讯少廉孟白无从公临校书宝光寺","author":"欧大任","text":"校籍开龙藏，谁将马队看。\n笔床犹傍暖，书带未应残。\n居士元金粟，诸生尚鹖冠。\n石经何日就，江左似长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅禹金见访青溪","author":"欧大任","text":"宣城何自至，建业始能寻。\n数问劳修翮，相逢结片心。\n梅花寒气早，枫叶暮江深。\n欲把朱弦理，听君白雪音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答宋忠父黄白仲雪中饮击筑斋见怀","author":"欧大任","text":"谁道梁园客，偏能寄所思。\n霙初飞药籞，霰已积书帷。\n引筑歌相和，盈觞醉共持。\n自怜深闭户，犹似洛阳时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同朱仓部次夔携酒过唐民部仁卿宅得花字","author":"欧大任","text":"夹毂问君家，疑从杜曲斜。\n御河街里酒，宫阁雪中花。\n擽炬喧饥马，城箛急暝鸦。\n向来论去住，吾意邵平瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除前二日同陈山人尔瞻集方银台允治斋中得儒字","author":"欧大任","text":"逢君苍玉佩，封奏汉庭趋。\n台斗荣新秩，江湖剩老儒。\n春声官署鹤，雪色禁城乌。\n有客金钱会，何劳问酒垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘计部克和何起部师召考绩同舟北上","author":"欧大任","text":"两省推贤最，三年入帝乡。\n俶装轻道路，理咏共舟航。\n凤阙烟光紫，鹓班曙色苍。\n汉家逢盛事，同日奏长扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄吴县傅明府伯俊","author":"欧大任","text":"茂宰苏台日，词人历下生。\n才名驰上国，问讯过陪京。\n卜夕移花宴，行春带雨耕。\n思君题一札，遥寄阖闾城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中李惟寅宋忠甫邀集冯虚阁同吴公择方子及诸君得游字 其一","author":"欧大任","text":"沾湿银鞍去，行从小队游。\n苑花迷塔寺，江霭薄城楼。\n馆似雷居士，园称沈隐侯。\n开尊仍此地，百代更风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中李惟寅宋忠甫邀集冯虚阁同吴公择方子及诸君得游字 其二","author":"欧大任","text":"千雉鸡山侧，丹梯到上头。\n石能萦细蔓，阁自俯长楸。\n净土高僧社，清时大雅游。\n雨深春草绿，犹自足淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄方山人景武时从戚大将军在岭外","author":"欧大任","text":"蓟门传尺素，白下久相闻。\n学似陈书记，行随霍冠军。\n岭云朱鹭曲，江雨白鸥群。\n秋晚吾将去，扶藜一问君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]