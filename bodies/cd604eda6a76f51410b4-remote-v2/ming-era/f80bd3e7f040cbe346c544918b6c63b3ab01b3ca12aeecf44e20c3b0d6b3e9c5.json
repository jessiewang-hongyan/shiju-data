[{"title":"宿曹溪方丈","author":"岑用宾","text":"兰若隐珠林，窗虚月半阴。\n僧开莲阁晓，客恋草堂深。\n塔影连云影，钟音和梵音。\n溪流留演偈，一切本无心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题刘御史我崧墓","author":"岑用宾","text":"北郭荒郊多墓田，白杨青草自年年。\n千秋欲下雍门泪，此日犹传京兆阡。\n邹母寒零荒藓地，王褒忍诵蓼莪篇。\n寒云落照栖鸦晚，愁对残碑一怆然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠战贡士归楚","author":"岑用宾","text":"枫叶萧萧间去津，临岐把袂一沾巾。\n千峰白雁逢归客，三径黄花候主人。\n司马远游多博物，相如能赋亦甘贫。\n潇湘赤壁堪乘兴，忆尔应知入梦频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送唯吾王侍御谪楚","author":"刘介龄","text":"嗟君强项素知名，折槛能容荷圣明。\n梁苑游麟悲见获，朝阳孤雁辄先鸣。\n羁怀恋国倾葵切，短棹浮湘一叶轻。\n宣室只今需召对，肯虚前席后苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴兴署中同顾若溪司空徐龙湾太守赋雪中红梅次二公韵 其一","author":"刘介龄","text":"香影孤山句里闻，错因颜色怪东君。\n梁园朱箔轻笼月，洛浦霞绡远抹云。\n仙梦醉容迷绛帐，汉妆新态妒榴裙。\n瑶华天为增奇赏，羌管无劳奏夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴兴署中同顾若溪司空徐龙湾太守赋雪中红梅次二公韵 其二","author":"刘介龄","text":"名园幽胜喜过从，梅雪佳辰雅会同。\n瑞霭纷披云锦树，明霞缭绕岁寒丛。\n虚疑梦入桃源里，错忆诗题杏苑中。\n自是瑶台春富贵，玉人沉醉倚东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺晚泊","author":"刘介龄","text":"飞来古刹是何年，此夕维舟思惘然。\n既有胜游供旅兴，况逢知己共清联。\n前湾兔色生寒照，古洞猿声搅夜眠。\n我亦飞来又飞去，僧钟催发北征船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得七月既望泛舟赤壁","author":"刘介龄","text":"赤壁坡仙两度游，赋成白雪映清秋。\n当年胜事空流水，此日高情更泛舟。\n咽月洞箫声袅袅，横江孤鹤梦悠悠。\n一尊乘兴重怀古，那问黄州定粤州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云峰寺 其一","author":"刘介龄","text":"云际孤峰远，峰头觉宇开。\n欲穷云外赏，乘兴拨云来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云峰寺 其二","author":"刘介龄","text":"僧舍依深竹，幽寻到竹间。\n一声清磬外，人世说谁閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云峰寺 其三","author":"刘介龄","text":"梵钟清磬落，觉路入虚明。\n去住云无定，青山只自青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"波罗道院 其一","author":"刘介龄","text":"三城遥望曙云东，境入扶胥海日红。\n赤壁乍回孤鹤梦，步虚声彻蕊珠宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"波罗道院 其二","author":"刘介龄","text":"神仙洞壑隐江城，倏忽风雷变化成。\n挥剑试看龙可役，吹笙时有鹤来迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"讲经台","author":"刘介龄","text":"高台天畔白云关，蹑磴凌虚试一攀。\n寂寂讲经人去也，空馀清梵落人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红白紫菊 其一","author":"刘介龄","text":"东篱金紫喜联芳，素锦添移白玉堂。\n谩道秋容元冷淡，秾华丛里载寒香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13330,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红白紫菊 其二","author":"刘介龄","text":"玉蕊金英开及时，移来紫艳更添奇。\n石家锦障人争羡，不见东篱烂漫枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13331,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红白紫菊 其三","author":"刘介龄","text":"金玉堂中紫锦张，东篱今作岁寒芳。\n柴桑雅淡休论此，富贵花开似洛阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13332,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀南园五先生","author":"刘介龄","text":"中原文物回天地，洛社风流自古今。\n遥忆南园五星聚，漫誇东晋七贤林。\n阿谁大雅追唐律，遮莫希音有越吟。\n此日浮邱论往事，尊前何必叹升沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13333,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集饮东林梁先生书舍","author":"翟瑀","text":"春月梁园处处花，武陵深处有人家。\n薜垣静锁轻烟细，石径潜通曲水斜。\n雨过莓苔沾蜡屐，潮来鸥鹭狎浮沙。\n主人归隐重游地，漫引清樽赏物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13334,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀王百谷","author":"方蕖","text":"飞舄今何处，遥怜无价珠。\n月光侵座满，烛影照人孤。\n雨过苔犹湿，阶明蚓乱呼。\n邻家吹玉笛，疑是起姑苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13335,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新秋","author":"方蕖","text":"衰柳欲依依，晴云敛翠微。\n数声惊雁过，一叶觉秋归。\n愁入新纨扇，凉生旧葛衣。\n可怜娇燕子，不见拂帘飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13336,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雁","author":"方蕖","text":"水静芦花暗，风高羽翰轻。\n楚云孤影断，汉月几家明。\n韵入冰弦怨，书传玉塞情。\n江城无限思，短笛一声清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13337,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得春有游女","author":"方蕖","text":"窈窕春风度，宫鞋径草微。\n棠梨明玉脸，杨柳剪罗衣。\n望处巫台似，逢时洛浦非。\n摇摇环佩去，三两夕阳归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13338,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕岩庵","author":"方蕖","text":"峡转珠林入，云封石路疑。\n岩深花未发，春到燕先知。\n香篆诸天寂，泉光百道披。\n性便招隐地，禅榻坐忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13339,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"方蕖","text":"星横碧落雁初归，徙倚虚庭入望时。\n声断紫箫花底凤，露寒丹桂月中枝。\n病添司马金茎渴，梦觉庄周玉蝶迟。\n孤剑十年犹是客，半生双鬓易成丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13340,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王伯谷还金昌","author":"方蕖","text":"楼船青雀繫河梁，别思天涯酒一觞。\n兰佩乍分心上结，柳丝新折路头霜。\n碧霄有梦吴洲远，明月无情越水长。\n却忆子猷书剑外，暮山云雨似潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13341,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江行","author":"方蕖","text":"越江兰桨晓春移，宿雨初收水满堤。\n处处引童耘旧陇，家家牵犊试新犁。\n桃花带晕红犹浅，柳叶拖金绿未齐。\n客路正愁行不尽，玉莎丛里鹧鸪啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13342,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得汉细君","author":"方蕖","text":"高楼凤去琐寒烟，风物江都已惘然。\n胡地夜笳惊戍马，汉宫春色怨啼鹃。\n乌丝老去毡房冷，黄鹄歌残毳幕前。\n生入玉门犹腐骨，不知青冢草芊芊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13343,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得杨柳","author":"方蕖","text":"閒杏欹桃最可怜，东风飖漾绿丝牵。\n金衣公子饶簧舌，绣陌行人繫画船。\n隋帝宫墙千树雪，陶家门巷五株烟。\n闺中悔杀封侯事，几度登楼思惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13344,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出塞曲 其一","author":"方蕖","text":"秋风吹铁衣，征人望金阙。\n吹笛满关山，忽落城头月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13345,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出塞曲 其二","author":"方蕖","text":"騄駬嘶金勒，干将吼玉龙。\n楼兰犹未斩，无梦到关中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13346,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟宫词 其一","author":"方蕖","text":"暗拭啼痕嘱侍儿，此情休与内家知。\n君王若是閒相问，为道红颜胜昔时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13347,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟宫词 其二","author":"方蕖","text":"绣户朱扉彻夜开，手持银烛独徘徊。\n满阶青草留应久，只是羊车不肯来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13348,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文姬琵琶图","author":"方蕖","text":"塞风吹拍自单于，谁道中郎女不如。\n纵学胡笳非汉业，馀生犹得续残书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惜花","author":"方蕖","text":"日日亭前检落花，一腔心事惜年华。\n燕子不知人有恨，又衔红蕊落窗纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嘉会楼宴集次韵","author":"廖文炳","text":"晓逐片帆临泽国，晴随樽酒上楼台。\n清时避席怀芳誉，此日挥毫是异才。\n树色乍迷村径合，潮声初动海门开。\n凭虚一望黄尘绝，得意鱼龙向客回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白燕","author":"刘士进","text":"姑射山头化雪衣，却怜春色到柴扉。\n舞依玉树梅花堕，影落瑶阶柳絮飞。\n乍入鹭行犹缥缈，便随蝶去更依稀。\n昭阳殿里春如许，莫怨秋风独自归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13352,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞霞阁水松","author":"刘士进","text":"飞霞高阁俯双松，绿水寒塘翠欲重。\n风送涛声喧鸟雀，日衔波影散虬龙。\n曾供陶令三秋兴，不数秦皇尺命封。\n岁晚不渝冰雪操，采芳何处问芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13353,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镇海楼宴王涣江丈口号","author":"何进修","text":"有客是南州，招邀郭北游。\n彩云飞画栋，粉堞炫山楼。\n尊俎三生话，乾坤一色秋。\n凭虚聊纵目，怀古重夷犹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13354,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜雨宿西庄","author":"何进修","text":"结屋芦湾浅水边，柴门阒寂自风烟。\n楼头忽堕千山雨，窗外俄飞万斛泉。\n深夜篝灯还下榻，故人挥麈共谈天。\n惭予搔首成衰老，漫向矶头理钓船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13355,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午梦","author":"何进修","text":"半亩桑麻未是贫，日长猿鹤自相亲。\n芒鞋竹杖人间世，纸帐梅花梦里身。\n圣代也能容弃物，北窗应亦有高人。\n百年天地俱蕉鹿，醒后偏宜漉酒巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13356,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游海珠寺","author":"何进修","text":"昔年谁驾六鳌浮，此日波光结蜃楼。\n星斗平临江上晚，烟霞散入海门秋。\n钟鸣梵宇逢僧话，角起孤城动客愁。\n万古乾坤此仙岛，胜游吾欲泛扁舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13357,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"廿三日观迎祀纛仪仗后宴集黄信卿启芳亭","author":"何进修","text":"都护楼头阵势连，依稀犹似出师年。\n旌旗昼闪三城地，景物情看九月天。\n萸菊香浮凭槛外，雁鸿声断把杯前。\n启芳亭畔重回首，片片飞花落舞筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13358,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登城西角楼眺望","author":"何进修","text":"一上闉阇眺晚晴，登临怀古重含情。\n水军不见当年寨，里巷犹存上古名。\n炎海风烟开五岭，越王台榭控三城。\n可怜桥下滔滔逝，断送韶华只此声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郑比部谳狱粤西","author":"何进修","text":"使者衔恩自九关，轺车朝报发燕山。\n乘秋杀气随飞隼，到日春风满百蛮。\n已道贯星连轸野，蚤应狱剑出人间。\n苍梧万里重华远，夜雨潇湘竹正斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀徐灌园","author":"何进修","text":"破镜飞飞且未还，芙蓉江上杳难攀。\n赋成珠海楼头月，梦入瑶溪榻里山。\n万事只今蕉鹿后，此身聊且马牛间。\n何当大醉荆高市，击筑相呼一解颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登镇海楼","author":"郭槃","text":"秋风萧爽正登楼，琪草琼花映宝邱。\n槛外星辰临曲牖，月边雕鹗起清秋。\n白云山色当空见，黄木湾声抱岸流。\n东望蓬莱今咫尺，可谁骑鹤过瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠 其一","author":"郭槃","text":"排浪来孤艇，看花到水滨。\n射龙谁入梦，蜚鸟自依人。\n入望青云色，牵情黄木津。\n惠休情不浅，留我赏冰轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13363,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠 其二","author":"郭槃","text":"银海光芒宝镜浮，梵宫深郁起琼楼。\n神光暖护摩尼室，灵树长生聚窟州。\n上界苍茫元气合，中流突屼水云浮。\n冯虚我欲乘风去，直跨金鳌绝顶头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13364,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游西樵山","author":"郭槃","text":"一望樵湖野水分，奇峰巀嶪绝纤氛。\n岩光半落仙人石，日影全遮玉女云。\n四月馀寒生几席，九天空翠散氤氲。\n乘风便欲凌飞翰，漫向青霄访道君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13365,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过梅岭","author":"郭槃","text":"悬萝攀磴出芳林，敬谒人龙再整簪。\n宝刹飞时山磬落，玉猿啼处岭云深。\n知多丰度标黄阁，剩有文章照紫岑。\n自愧年来频仰止，不知经世复何心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13366,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六祖法坛","author":"郭槃","text":"宝刹郁嶙峋，停云万象新。\n何时布金地，重见雨花人。\n钵小龙堪驭，坛空鸽自驯。\n法界超尘累，名香结净因。\n欲识空中趣，宁同物外身。\n三车何用演，万劫自回轮。\n磬声云外落，僧语月边论。\n风幡如可悟，台镜本无尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13367,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜宇","author":"郭槃","text":"法宝藏灵府，员光澈上穹。\n尘埃何处染，色相本来空。\n普照诸天外，流辉万劫中。\n欲观无尽理，如在水晶宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13368,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻砧","author":"郭槃","text":"露下秋林木叶稀，邻家砧杵韵初飞。\n三秋塞北悲传檄，十月江南始授衣。\n敲落夜灯浑不断，梦回孤枕觉犹非。\n闺中少妇劳相讯，为问征人归未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13369,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻雁","author":"郭槃","text":"芦花淡白水微茫，又听雍雍旅雁翔。\n几点乱云迷洛浦，数声和月起潇湘。\n蹉跎故国家千里，迢递乡音字两行。\n楚水吴山旧时路，年来何事竟忙忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13370,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感秋 其一","author":"郭槃","text":"镇海楼高锁暮烟，清愁兰桂自媗妍。\n美人漫忆看花地，仙子犹传化石年。\n千里梯航求翠羽，万金悬市购龙涎。\n那堪回首空肠断，徙倚山城眺远天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13371,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感秋 其二","author":"郭槃","text":"一自烽烟销客魂，况惊多难不堪论。\n鲸鲵畏是冲波险，鼓角愁兼下濑喧。\n地涌洪涛翻白昼，天摇寒浪暗黄昏。\n商声萧瑟怜孤翮，直欲排云叫帝阍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13372,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感秋 其三","author":"郭槃","text":"玉露零零报早秋，凉飙初布火星流。\n南园词赋俱寥落，北海宾从漫去留。\n爱月每思王粲赋，怀人还上李膺舟。\n感时蓬鬓嗟迟暮，樽酒论文不自由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13373,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"扬州怀古","author":"郭槃","text":"离宫行乐拥霓旌，谁料当年谶已成。\n綵仗晓花空结恨，画楼初月独含情。\n龙归汴水金瓯覆，骏没辽云玉轴倾。\n惟有垂杨依旧堞，春来犹自转啼莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13374,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登飞来十九福地","author":"郭槃","text":"何处飞来鸑鷟峰，层崖嵂崒散芙蓉。\n烟迷万象开禅室，风落千岩响梵钟。\n金锁迹荒潭水静，玉环情断洞云重。\n遥思帝子登高处，犹向丹函觅旧封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13375,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小姑山","author":"郭槃","text":"小姑凝盼翠娥愁，独自临妆上画楼。\n初日乍悬金镜晓，暮云长傍宝钗浮。\n衷情欲诉湘江远，幽恨还随汉水流。\n一自含颦朝玉辇，至今凝望六龙游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13376,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登白云寺","author":"郭槃","text":"芙蓉千仞倚层空，蹑屐扪萝有路通。\n十二琼楼连碧落，三千金界散洪濛。\n天边忽洒仙人露，槛外长吹玉女风。\n闻说广成丹尚在，便应晞发卧崆峒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13377,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻笛","author":"郭槃","text":"何处怀人不断肠，笛声哀怨起江乡。\n落花尽入羌人调，归泪曾沾楚客裳。\n明月千家砧杵动，关山一曲梦魂长。\n流年况是催容发，那独潘郎鬓有霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13378,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花 其一","author":"郭槃","text":"一番风雨到妆台，肠断芳菲恨未灰。\n忽逐暗香随水去，又飘疏蕊入窗来。\n红铺沼面平如绮，綵谢阶前散作瑰。\n为惜飞花重结子，赏心寥落罢衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13379,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花 其二","author":"郭槃","text":"何处笛声惊昼眠，乍听忽尔思凄然。\n扪空零乱飘红雨，点地轻盈散紫烟。\n恨入汉宫因罥蝶，愁随湘浦为啼鹃。\n韶华已尽秾芳歇，指点清明又一年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13380,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花 其三","author":"郭槃","text":"美人楼上惜韶光，漫自朱颜淡扫妆。\n隋苑曲终红拂散，石家歌罢绿珠忙。\n羞他溽雨芳容改，却哂回风舞态狂。\n檀板柘枝犹未歇，一声羌管在横塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13381,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花 其四","author":"郭槃","text":"朝来阴雨更连绵，帘外飞花暗远天。\n忽向画堂污玉匣，乍来香案覆金钱。\n飘残片片添闺怨，散谢枝枝撩客怜。\n开落由来随节候，闭门休咏刺桐篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13382,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李卫公祠","author":"郭槃","text":"杖策还能作帝师，从来侠客负天奇。\n白衣自拥旌轺出，红拂偏教羽骑随。\n大陆龙飞开茂烈，荒原鸡卜有灵祠。\n勋名到处人争羡，磊落苍崖起义碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13383,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]