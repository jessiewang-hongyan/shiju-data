[{"title":"对酒怀友人","author":"区怀年","text":"筇笠互西东，清言洽梦中。\n泽文思隐豹，逵翼侘冥鸿。\n怅望碧云渚，劳歌青桂丛。\n浊醪无限意，酣畅酹秋空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同诸子纳凉于饮虹涧","author":"区怀年","text":"浅碧照苍颜，幽盟片石间。\n瀑悬争险落，禽语入秋闲。\n古木稠能荫，欹崖叠可攀。\n晚酣清啸翕，馀响际空山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪上晚春","author":"区怀年","text":"春光不可留，春事淡悠悠。\n野钓寒烟迥，溪舂宿雨收。\n故人劳寤寐，芳杜满汀洲。\n欲侣云中鹄，高鶱碧海头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孤雁","author":"区怀年","text":"渐逵何独展，只羽下秋阴。\n况乃离群意，凄其远道心。\n影回牵露苇，声急混霜砧。\n烽火频年厉，休翻郁水浔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食展墓","author":"区怀年","text":"积阴弥旷野，羸策赴幽阡。\n草没石翁仲，花明山杜鹃。\n锄荆暮烟里，迸涕春风前。\n马鬣宁无虑，低回增暗厌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日吴于逵孙弘先朱未央过集池上","author":"区怀年","text":"落木生寒霭，高轩过夕阳。\n惠风仍缟带，幽事惬青裳。\n客有天台赋，梅分水部香。\n自怜衡泌欸，蒲芡待相将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过水石山房听泉因题于石","author":"区怀年","text":"落日照松关，高僧不在山。\n瀑潆增活趣，云老挹苍颜。\n草石纡回次，轩窗杳霭间。\n但能捐鄙陋，终日听潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访李子长墓","author":"区怀年","text":"古木临樗社，高风不可齐。\n废侗应有托，谐谑岂无稽。\n玩世閒胸次，忘机绝品题。\n缅怀丘垄侧，凝眺碧云偍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙未除夕","author":"区怀年","text":"华发荏居诸，寒更四壁虚。\n独怜分岁酒，谁换纪祥书。\n橘碗喧童稚，松棚照井闾。\n晚农方授稼，残腊又经除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蒲涧寺","author":"区怀年","text":"投策向山扉，长松暑气微。\n谷云吹不断，峰翠陊还飞。\n佛古宜僧老，蒲香过雨肥。\n谁能拨尘鞅，休负薜萝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后喜苏谢二子载酒过酌池上","author":"区怀年","text":"一春风色黯，花月兴全孤。\n何处巢云侣，搴芳来玉壶。\n清言狎奇石，小摘出新蒲。\n愁事为君迸，淹留逮夕乌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"折柳曲","author":"区怀年","text":"结束轻腰似内家，酒旗阴里罥流霞。\n春风禁苑怀张绪，落日吴宫閟馆娃。\n锦勒有情嘶騕袅，青衫无虑泣琵琶。\n折来已重伤迟暮，江畔愁闻杨白花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜曲 其一","author":"区怀年","text":"火树虹梁拂绛宵，拍张浑脱沸春朝。\n韶华璧月当三五，丽曲银筝度六么。\n螺黛试妆眉晕浅，麝枚分润甲煎销。\n葳蕤莫下朱门钥，不及晨钟未寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜曲 其二","author":"区怀年","text":"传柑文篚戒青娥，十斛醲香散叵罗。\n争道柘枝丛里失，系情弦索闹中多。\n熏炉兽炭供扶醉，宝带鸾靴倩踏歌。\n斜月半窗花影乱，褰帷须问夜如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邗沟","author":"区怀年","text":"千里平堤入水乡，荷花香净涨雷塘。\n村酤惯趁湖头曲，贩女犹知殿脚妆。\n别浦霜葭愁野鹜，迷楼莎雨泣寒螀。\n玉钩斜畔仍疏柳，掀断残烟到夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龟河","author":"区怀年","text":"矫首明河天际浮，占星谁误泛槎游。\n光涵帝女三千轴，影澈仙人十二楼。\n银浦露森乌鹊杳，玉绳霜冷白榆秋。\n何时挽取涟漪色，一洗人间远别愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠边将","author":"区怀年","text":"建牙新睹靖岩疆，坐引雕戈控白狼。\n旅戍十年班定远，风流千古杜当阳。\n骍弓晓落燕支月，铁骑寒飞木叶霜。\n南扈不惊秋气矫，夜娴铙吹过金张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蓟门怀古","author":"区怀年","text":"榆塞清笳起暮烟，桑乾秋色过居延。\n千金俊骨台空纪，一匣鱼肠刃未捐。\n易水送轲愁击筑，碣宫留行竟谈天。\n当年任侠称燕蓟，挥手边烽歘黯然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白燕","author":"区怀年","text":"江皋春蔼片泥融，轻剪浑疑织素工。\n香鬓几回羞玉雁，锦襟何事怨华虫。\n差池广厦飘晴雪，婀娜閒窗掠晚风。\n愁别乌衣人不见，丽情多在絮阴中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红鹦鹉","author":"区怀年","text":"蚤是能言累已婴，岂堪文彩更知名。\n坐传琥珀香魂改，飞入珊瑚岛树轻。\n朱鹭几闻赓楚曲，赤乌何事厌吴兵。\n高华绝代难供御，碧草芳洲无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜闻雁","author":"区怀年","text":"客梦浑疑朔气侵，朅来谁忆动秋砧。\n半天清响数行字，万里寒光此夜心。\n望断玉关迷薄暮，惊回珠树发幽吟。\n长风羡尔悠然去，踪迹冥冥何处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红梨花","author":"区怀年","text":"不数秦川白雪香，内园歌舞嬖新娼。\n雕栊暮湿胭脂雨，绮阁寒消靺鞨装。\n语燕乍迷魂欲断，啼鹃无度魄初狂。\n东风宛借彤云色，护得醲春赐并房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏马缨丹","author":"区怀年","text":"杜宇啼春血易残，紫驼宫锦见应难。\n香风不解珊瑚勒，丽影遥分苜蓿栏。\n天上火云蓊郁改，日南琼树陆离看。\n从教别却追风足，自倚红妆照合欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉拒霜","author":"区怀年","text":"珠帷银烛暝烟多，零落西风笑芰荷。\n白苧按歌情转剧，香肌微晕意先酡。\n扁舟木末沈红粉，拾翠霜前失素娥。\n卯酒易醒人未识，肯教回雪擅凌波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"锦边莲","author":"区怀年","text":"风漪晴织藕丝牵，一撚胭脂废独妍。\n芳泽久娴苏蕙藻，彩霞分绚薛涛笺。\n三秋碧水瑶台月，十丈华峰玉井烟。\n何处扁舟从太乙，靓妆摇落素馨田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为李青来悼程仲姬","author":"区怀年","text":"柳絮桃根事已荒，卢家空擅郁金堂。\n青鸾归去春霞寂，红缕牵愁海燕忙。\n天上几年劳种玉，世间何处可怜香。\n檀郎惯领相思苦，凄断高楼晓月霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈集生太史报命还都","author":"区怀年","text":"輶轩朝发柳依依，淮甸听莺驷牡騑。\n天上故人劳属念，日南佳事递相违。\n烽烟满目连青塞，剑佩生香动紫微。\n引见预知承顾问，九重渊穆正宵衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新柳","author":"区怀年","text":"百结柔丝散晓芬，舞腰初试蹙湘裙。\n陌头系马阴俱薄，楼外藏莺影未分。\n隋苑别枝伤故国，灞桥颦叶扫春云。\n踏歌少妇休连臂，羌笛徒淹楚塞军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐书怀","author":"区怀年","text":"几缘清梦怯晨钟，玉斝香罗节节慵。\n病骨久惭花录事，诗脾新夺酒提封。\n虚窗烬落秋蛩啸，曲径苔深野鹿踪。\n顾影欲颓还看剑，独馀肝胆照芙容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜陪诸公宿镇海楼","author":"区怀年","text":"北城轩盖动高秋，万井疏烟暝不收。\n木落远村微见水，山空凉月正当楼。\n清砧漫续蛩声溺，丽藻閒舒客思悠。\n松露满栏沾几席，梦魂容易到沧州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自慰","author":"区怀年","text":"高卧兰陂葛井东，几年疏韵叶焦桐。\n思分曲垒商浮白，梦狎桃笙赋比红。\n山国日閒鸥社稼，海门春老鲎帆风。\n清狂近接无争侣，不喻蓬蒿有射工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春过郊寺访李伯开","author":"区怀年","text":"雨过林垌翠未乾，莺花三月尚凝寒。\n高原放犊催春耨，小院鸣钟报午餐。\n野兴暂依禅藻逸，闲情休作旅尘看。\n蒯缑南国如君几，莫向松窗净侣弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿李伯襄大宗伯","author":"区怀年","text":"视草声华满阙廷，垂天修翮振南溟。\n文章班马归毫管，礼乐夔龙有典型。\n一味咀兰胸是锦，双貂悬珥鬓俱青。\n诙谐不用推方朔，调鼎人今俟岁星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕曾息庵藩伯招集南园智上人在坐","author":"区怀年","text":"春风南陌缓鸣珂，春水池亭带雨过。\n华筦玉缸浮蚁净，碧栏芳树暮莺多。\n徵诗石畔牵云衲，选技花前出翠蛾。\n莫讶冲泥归路促，严城灯火夜如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠匡上人入罗浮","author":"区怀年","text":"已向曹溪展法龙，还寻仙峤托高踪。\n寒敲石火怜光灭，净掬泉香厌水浓。\n丹灶月明宵卓锡，铁桥烟断午闻钟。\n芙容四百俱幽绝，知尔禅栖若个峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答董叔远见赠时余还自蓟门","author":"区怀年","text":"莫遣穷经老蠹鱼，青衫黄犊笑居诸。\n招邀恁地劳君赏，偃蹇还谁读父书。\n双鬓酒狂风格在，十年诗价浪名馀。\n成都自少谋生策，负笈无因献子虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤城晚眺","author":"区怀年","text":"江光微蘸女墙边，城影缘山半插天。\n疏树忽生云路雨，短桥空锁石湖烟。\n牛羊远近归童牧，罟网参差傍客船。\n留滞独怜清鬓改，夕阳春草兴萧然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过黎叔宝新居","author":"区怀年","text":"底事巢云向十洲，一窝赢得老菟裘。\n窥檐山翠迟迟下，绕壁茶烟处处留。\n书罢放歌松影晚，水边闲梦蓼花秋。\n过从幸莫劳车马，胸次如君已狎鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花 其一","author":"区怀年","text":"眼底秾纤决意裁，枝间啼鵙暗相催。\n霓衣鹤氅凌空去，蝶翅蜂须弄影来。\n满径绿芜春旖旎，深宵凉月思裴回。\n临风检点愁红色，髣髴含嫣昨日开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33422,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花 其二","author":"区怀年","text":"六渠香水泻胭脂，绘梦题春事亦痴。\n赋罢额川遗枕夜，歌残金谷堕楼时。\n飘霜顿压明妃冢，折玉徒存幼妇碑。\n狼藉冶愁驱不尽，又随花恨到双眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33423,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭上谒张文献祠","author":"区怀年","text":"相国崇祠苔径深，阁连山寺昼多阴。\n丰碑没土刚三尺，古木含霜定几寻。\n端揆素怀虚伟略，开元忠愤寄幽吟。\n一从风度劳明主，岭海文章盛至今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33424,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"撤棘后过东华门避肩舆呵导者","author":"区怀年","text":"十载穷经涨海滨，角巾愁色带缁尘。\n方惭要路无知己，不信清时有逸民。\n阙下晚传青盖拥，仗前寒映紫貂新。\n逡巡试问遮呼卒，道是京营中贵人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33425,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杪秋饮黄石斋太史席中赋谢","author":"区怀年","text":"买丝何处绣平原，一展清觞意亦存。\n白雁影斜惊逆旅，紫萸香冷怨王孙。\n石渠简要声逾藉，枫陛论思地更尊。\n堪笑十年燕市筑，弊裘还扫舍人门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33426,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉河桥即事","author":"区怀年","text":"西苑凉风彻御沟，平桥霜草夕阳收。\n中涓络绎持丹凤，宿卫传呼驻紫骝。\n流水自纡宫路晚，古槐高拂禁城秋。\n铃鸾小队骎骎去，莫是寻芳过五侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33427,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕集象先家司徒署中","author":"区怀年","text":"帘幕清灯照叵罗，岁华将逐晓星过。\n寒消粉署情无限，徼断金吾夜几何。\n尘旅敝衣怜短发，禁城春漏待鸣珂。\n壮猷倩尔军需在，好副虞弦奏太和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33428,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日长安道上","author":"区怀年","text":"无处春风不蹋莎，锦鞯华毂费征歌。\n西院缟带邀云集，北里香尘蔽日过。\n避马敢争官路壅，典衣终觉子钱多。\n蒯缑零落弹何事，漫倚青帘醉叵罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33429,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秣陵秋况 其一","author":"区怀年","text":"蹉跎谁复问长安，九陌花光梦里看。\n邦禁自宽愁酷吏，史宬多阙借稗官。\n风流异代仍归晋，月旦何心冀识韩。\n清誉几人终惠好，楚江回首溯鸡坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秣陵秋况 其二","author":"区怀年","text":"摇落秦川赋独醒，钓竿惭却五湖汀。\n有怀漫笑屠龙技，无事容探瘗鹤铭。\n远道几年违菽水，枯囊终日计参苓。\n吴舠载酒清歌艳，愁绝临风未忍听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秣陵秋况 其三","author":"区怀年","text":"消渴丁年总不如，近应除酒托清虚。\n烟光满壁裁诗就，雨气凝窗䇘茧馀。\n怪石短蒲幽客贶，香奁彤管美人书。\n居心此际庸非净，犹胜天涯怨索居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秣陵秋况 其四","author":"区怀年","text":"白门书剑误凭淩，拟向龙天结小乘。\n寤寐故山惟粤秀，过从高士半吴兴。\n拈花短偈閒相赏，挂席长风病未能。\n蔬具茗炉朝夕课，不妨人唤在家僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33433,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈集生宫詹招饮写叶山房","author":"区怀年","text":"山除秋敞绿阴繁，好月邀人共到门。\n任放有怀交履舄，周旋无地属櫜鞬。\n歌声近榻惊花睡，露色浮轩扑酒魂。\n约略谈锋归玉斝，不妨终席费寒暄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33434,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春即事","author":"区怀年","text":"惊心才觉日分长，绿满閒庭燕子忙。\n古帖润侵蝉翅浅，高丛阴厚蜜脾香。\n愁当赠玦情俱远，赋就停云调亦伤。\n过雨药栏新溜急，落红消息问横塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33435,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日同李伯开吴侯履集越山迟子建不至","author":"区怀年","text":"南国秋深展别悰，溪山迢递此过从。\n青鞋白帢追呼近，野蔌篱香取次供。\n寒色乍侵桑落酒，夕阴遥度翠微钟。\n高歌望断幽人迹，何处萸花趁短筇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33436,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春雨中阮实夫偕张姬过访再用稽字","author":"区怀年","text":"食经畴昔未曾稽，薄脍银丝命小奚。\n探字客留春寂寂，散花人在雨凄凄。\n交情一倍怜湖海，韵事千秋费品题。\n更爱曲池芳意早，柳条行见绿初齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33437,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蚤梅","author":"区怀年","text":"一剪香风破暝看，冷烟斜压碧琅玕。\n幽姿若个催迎腊，长笛谁家倩倚栏。\n庾岭梦魂千里月，斗窗消息半梢寒。\n清商白雪难为和，摇落江城老鹖冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33438,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日江上","author":"区怀年","text":"笙歌十里酿闲愁，水郭凉风五月秋。\n双桨玉壶供野酌，六衢香粉翳中流。\n搴芳日丽芙蓉浦，听技云生翡翠舟。\n幽况早同渔父适，钓竿无恙狎沙鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33439,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈宗伯席上送黄逢永游四明","author":"区怀年","text":"潦满江潭暑未除，片帆濒发藕花馀。\n樽空北海淹行乐，草绿南园动索居。\n客梦远依兰渚旷，诗怀清似鉴湖虚。\n何时一引任公钓，溟渤天风振巨鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33440,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为陈中秘寿母","author":"区怀年","text":"昔季曾误食金桃，几见宫花灿锦袍。\n青玉案边閒戴胜，矞云天上戛琅璈。\n祥开绛节麟为脯，武接朱缨凤蔚毛。\n谁倚幔亭秋色丽，婺星长映月轮高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33441,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日同诸子登朝汉台","author":"区怀年","text":"萸花香趁客愁开，十里青帘醵酒来。\n晴树远山分极目，短筇衰发对衔杯。\n江门雁字迎霜落，城路砧声向晚催。\n何处风烟堪寄傲，秋光空满越王台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33442,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初度述怀 其一","author":"区怀年","text":"倦游诃社旧盟稀，水国看星识少微。\n白发早閒冰雪骨，青云将笑芰荷衣。\n心超甲子虚禅腊，迹累征猺损道机。\n为问葛亭珠黍谷，石楠应报长新围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33443,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初度述怀 其二","author":"区怀年","text":"兰阪秋风倦钓纶，片云轻护竹溪身。\n窗依鹤垤情多暇，室掩鱼编价自珍。\n衣茹私非难老术，凿耕原是太平人。\n黄尘碧海三山远，锐屐修筇畎亩春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿吴乔楚将军","author":"区怀年","text":"菊觞华发傲烟萝，矍铄人惊马伏波。\n燕颔几年飞食肉，龙韬千里坐横戈。\n霜清涨海珠光媚，月皦浮山桂树多。\n莫讶功成方遁迹，赤松天路近如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"逍遥台晚步","author":"区怀年","text":"罡风披拂到层台，杖底烟消野色开。\n秋水不教双涧没，夕阴遥挟片云来。\n峰坳古径堆黄叶，石窦寒芊长碧苔。\n松籁泠然啸归去，昏鸦无约漫相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻燕京变起志哀","author":"区怀年","text":"勾陈北极暗鸾旗，一夜欃枪越尾箕。\n金册孔惭周带砺，玉班俄损汉威仪。\n云愁钜鹿披三辅，波委卢龙遁六师。\n闻说鼎湖弓欲折，攀髯天上几人悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送家兄启图解铳入京","author":"区怀年","text":"天阕新恩焕紫纶，故人开阁待平津。\n供输草莽皆臣事，迢递关河半旅尘。\n官冷寸心犹报主，气雄孤剑但随身。\n知君奏对彤墀外，方及秦淮柳絮春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":33448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]