[{"title":"舟发长沙四首 其二","author":"薛瑄","text":"已觉长沙北，犹瞻岳麓西。\n天浮湘水阔，树入楚山低。\n岸芷馀香草，丛篁染旧啼。\n昔贤游览地，我亦为留题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5472,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟发长沙四首 其三","author":"薛瑄","text":"长沙城下驿，解缆发扁舟。\n水栅千家市，沙村十里洲。\n喜逢晴霁景，况值太平秋。\n宪节叨光宠，怀贤独未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5473,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟发长沙四首 其四","author":"薛瑄","text":"十日长沙住，登舟忆少陵。\n花飞有底急，酒美为谁倾。\n浩浩当年兴，悠悠此日名。\n幸逢明盛世，持斧故南征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5474,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湘乡道中","author":"薛瑄","text":"湘乡南去路，连日是山行。\n地僻溪潭绿，冬和草树荣。\n野人悬稻把，古戍列旄旌。\n异俗今如此，归当话友生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5475,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"思亲","author":"薛瑄","text":"二亲俱久逝，孤子际明时。\n谬忝风霜任，深承雨露私。\n光荣宁及养，劬育竟何为。\n愿竭涓埃报，焚黄会有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5476,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿湘乡道中山亭纪怀","author":"薛瑄","text":"又是山亭宿，林峦夜杳冥。\n天临南岭近，风入北窗清。\n开卷求心事，倾壶荡客情。\n二亲久辞世，不寐想平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5477,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沅州新正书景三首 其一","author":"薛瑄","text":"楚南时节异，正月似深春。\n傍砌萱苗长，临池草色新。\n江山晴景媚，庭院煖风频。\n坐惜梅花落，题诗忆远人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5478,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沅州新正书景三首 其二","author":"薛瑄","text":"颇讶沅州地，新正景不同。\n远山青草瘴，深院落梅风。\n角角寻巢鸟，喧喧采蕊蜂。\n春衣初试裌，和气满帘栊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5479,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沅州新正书景三首 其三","author":"薛瑄","text":"楚地春来早，群花次第开。\n轻黄舒柳线，重碧染莓苔。\n永日香凝篆，和风酒满杯。\n端居叨宠渥，何以答涓埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5480,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"正月十三日夜书","author":"薛瑄","text":"两日是元夕，山城已试灯。\n讴歌连夜发，萧鼓遍街鸣。\n人喜新风景，时逢旧太平。\n柏台谁是伴，梅月正交清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5481,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"遣兴","author":"薛瑄","text":"庭幽多乐趣，向歇爱晴晖。\n绿竹生孙早，红梅结子稀。\n赋诗新有趣，读易渐知几。\n眼镜何空阔，看云天际飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5482,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓上草阁","author":"薛瑄","text":"通宵雷雨骤，晓霁试登楼。\n百鸟声相和，双江涨合流。\n宁知冀北客，来按楚南州。\n满眼波涛急，飘然欲放舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5483,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乔口溯流往长沙","author":"薛瑄","text":"楚岫无边翠，湘流不尽清。\n香兰屈子赋，苦竹鹧鸪声。\n风景当年事，云霞万古情。\n沙头旧鸥鸟，谁肯与寻盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5484,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"武口守风四首 其二","author":"薛瑄","text":"武口丛祠下，维舟几日馀。\n北风增骇浪，南客念归途。\n水远浮三蜀，烟浓暗五湖。\n江村秋雨里，难觅酒家垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5485,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"武口守风四首 其三","author":"薛瑄","text":"归思方正切，北风何太狂。\n江村平隐见，湖树远微茫。\n浪起鱼龙伏，天低鹤鹳翔。\n貂裘思更著，秋雨早生凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5486,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"武口守风四首 其四","author":"薛瑄","text":"系舟杨柳驿，风雨苦连朝。\n远岸烟埋树，荒村水没桥。\n年华身老大，湖海兴萧条。\n天意何留滞，应怜望国遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5487,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中偶成","author":"薛瑄","text":"舟中如斗室，坐卧觉心清。\n闭户嫌风冷，推篷爱日明。\n偶思前世事，因见古人情。\n自顾知何益，诗书浪得名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5488,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汉江晓泛","author":"薛瑄","text":"城下扁舟发，江清宿雾消。\n竹村迎岸出，粉蝶背人遥。\n神女无消息，明珠久寂寥。\n鹿门看渐近，满耳飒清飙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5489,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中遣闷","author":"薛瑄","text":"五日行不尽，洞庭青草宽。\n穷阴连旦夕，密雾隐湖山。\n诗思虽难竭，酒壶行复乾。\n孤舟亲爱远，何日暂为欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5490,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"近日收书渐多戏成","author":"薛瑄","text":"元凯真成癖，收书日又多。\n静须频检阅，忙不废吟哦。\n得意欲谁语，感怀聊自歌。\n忘形到尔汝，胶漆岂能过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5491,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"院中遣兴二首 其一","author":"薛瑄","text":"为客知应久，池塘夏景深。\n圆荷高倚盖，新笋密成林。\n山鸟因时语，阴虫应节吟。\n乾坤知帝力，自许一生心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5492,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"院中遣兴二首 其二","author":"薛瑄","text":"片雨过山城，空阶物意清。\n黄梅拾又落，翠藓踏还生。\n几许催诗景，无端望国情。\n蛮方耕事少，乌府但横经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5493,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜坐偶书","author":"薛瑄","text":"夜夜烧官烛，时时读我书。\n斗牛双古剑，天地一迂儒。\n郡邑三苗外，风霜两岁馀。\n江湖怀魏阙，似觉鬓毛疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5494,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中三首 其一","author":"薛瑄","text":"来往虽云数，应无愧此江。\n观书心见独，揉橹韵闻双。\n岸转山相掩，湍奔石互撞。\n裁诗清兴发，晏坐启船窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5495,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中三首 其二","author":"薛瑄","text":"石底明皆见，清波淡不流。\n几年乌府客，一叶楚江舟。\n求富知为妄，存心得自由。\n所欣安履顺，未必叹淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5496,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中三首 其三","author":"薛瑄","text":"好在黔中地，相留过几年。\n岸经冬岭树，水宿夜滩船。\n支枕思前事，清心忆往贤。\n一阳看渐近，吾道故应旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5497,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔江晓泛","author":"薛瑄","text":"五月蛮江涨，官船泛泛轻。\n波光一道白，山色两边青。\n只有耽书癖，都无报国能。\n中原有家室，终日望归程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5498,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"诗礼堂为衍圣公赋","author":"薛瑄","text":"洙泗趍庭日，相传自世家。\n三千惟有敬，一语自无邪。\n乔木参天色，猗兰绕砌花。\n遗风从此地，花雨被无涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5499,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"崇恩堂为衍圣公赋","author":"薛瑄","text":"赤芾趍朝日，彤庭锡劳时。\n宫壶沾宠渥，命服被恩私。\n遗泽应无竭，深恩勉自持。\n高台书盛事，行见被声诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5500,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题风木卷","author":"薛瑄","text":"秋色满天地，寸心将若何。\n行云宁返迹，逝水绝回波。\n断织封蛛网，残篇掩蓼莪。\n空馀东岭树，向夕受风多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5501,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题瞻云卷","author":"薛瑄","text":"游子久行役，松楸空系情。\n几经秋草合，长见白云生。\n水映遥空淡，烟迷暮垄平。\n鹤归华表夜，沧海月虚明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5502,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"人日立春","author":"薛瑄","text":"人日逢春日，韶华此又新。\n暂归持斧客，犹是读书人。\n别久交游敬，年深骨肉亲。\n升平占霁景，爱国赋诗频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5503,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"村居","author":"薛瑄","text":"乔木荒村古，归来遂所居。\n人情安瓦落，机事识舟虚。\n岁晚霜横野，宵长月照书。\n心田恐芜没，不敢废耘锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5504,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"读书","author":"薛瑄","text":"俯仰千年道，常看万卷书。\n鬓毛兼黑白，事业尚铅朱。\n庭雨催寒早，窗风度月虚。\n抚时宁浪出，慨想北溟鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5505,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋夜诸生持酒至二首 其一","author":"薛瑄","text":"宪府乘骢入，湖南仗斧游。\n异乡饶节序，故里忽中秋。\n白月当空度，明河入夜流。\n诸生劳载酒，坚坐看相酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5506,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋夜诸生持酒至二首 其二","author":"薛瑄","text":"五见中秋节，湘南想北州。\n忽看今夜月，忘却昔年愁。\n汾水通河汉，龙门近斗牛。\n霜钟传永夕，高咏未能休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5507,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"示弟瑭","author":"薛瑄","text":"大屋星霜久，新年雨雪频。\n田园知己薄，生计可忘勤。\n乔木宜思祖，鸡豚莫恼邻。\n东堂花几树，应与岁俱春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5508,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻张侍御升大理卿复升都御史","author":"薛瑄","text":"闻道张公子，频年被宠光。\n一清廷尉法，再肃柏台霜。\n绝足风云阔，高门岁月长。\n所期崇令德，汗简看垂芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5509,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏夜","author":"薛瑄","text":"肃肃凉景夕，满怀诗思生。\n虫鸣新雨霁，钟递晚风清。\n爽气浮天极，乡心对月明。\n中州知久客，归兴绕汾亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5510,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽吴孺人","author":"薛瑄","text":"高节知谁似，终身不二天。\n脩篁秋更绿，老柏苦尤坚。\n意切和熊处，心伤断织前。\n贤郎今有立，紫诰贲幽泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5511,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"直沽舟中","author":"薛瑄","text":"潮来两岸平，风顺一帆轻。\n海阔浮云白，天低野树青。\n久叨持斧客，非是弃繻生。\n岱岳行看近，秋高试一登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5512,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"按部出济南","author":"薛瑄","text":"雨歇西门道，微凉草树秋。\n风云连北极，海岳接东州。\n圣世方全盛，书生得壮游。\n频年叨宠渥，感激未能休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5513,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七夕宿郯城","author":"薛瑄","text":"郯子国中宿，高堂蜡炬红。\n满林惊夜鹊，绕砌响秋蛩。\n远意知谁省，长吟未许同。\n去年当此夕，京国见西风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5514,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"发长清","author":"薛瑄","text":"清晓出南郭，南行喜有山。\n入林秋雾薄，到面水风寒。\n已觉年华大，还应宇宙宽。\n几回持宪节，不改铁为冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5515,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卢主事具庆堂","author":"薛瑄","text":"卢子古名族，几年家大梁。\n未为观国士，已作奉亲堂。\n乔木侵檐密，芳花绕户香。\n春风长满座，永日但称觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5516,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登州抵福山道中二首 其一","author":"薛瑄","text":"冈岭高还下，荒村断复连。\n波涛风捲雪，岛屿日生烟。\n水坼人间境，春融世外天。\n云霞今古异，何处有神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5517,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登州抵福山道中二首 其二","author":"薛瑄","text":"正是春光好，重来海上行。\n轻鸥联影落，旅雁一行鸣。\n徐市三山棹，安期万古名。\n只今俱泯没，惟见水云平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5518,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"潞河舟中","author":"薛瑄","text":"岁月忽如昨，三年又此来。\n水长通御苑，山近绕金台。\n谬拟传心学，惭无济世才。\n永怀清不寐，终夕望三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5519,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中思亲","author":"薛瑄","text":"三十年前事，舟中忽有思。\n老亲游宦日，巴蜀泛江时。\n青嶂两边合，黄猿万树垂。\n只今行海岱，忍自受恩私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5520,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沧州舟中","author":"薛瑄","text":"澶漫沧州北，舟行逆水迟。\n连林秋柳瘦，接翅晚鸦稀。\n原野波涛减，人家生理微。\n端居对明烛，深念莫相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5521,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病齿","author":"薛瑄","text":"病齿经时久，忧烦屡搅肠。\n吟哦良觉废，诵读总相妨。\n志切风雷益，心惩噬嗑刚。\n古柔无所苦，因悟养生方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5522,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赐纱","author":"薛瑄","text":"理寺承恩召，宫纱被宠光。\n红酣升海日，浓染自天香。\n省德知轻重，裁衣称短长。\n章身良自愧，何以报皇唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5523,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赐扇","author":"薛瑄","text":"敕赐端阳扇，云笺五色花。\n动摇烦暑退，披拂好风斜。\n法语真堪畏，汤铭恐未加。\n身心蒙帝力，留与子孙誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5524,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登南坡","author":"薛瑄","text":"雨霁陟岧峣，凉风作阵飘。\n目随青嶂远，心与白云高。\n野草连冈细，家林百尺乔。\n茫茫天宇内，倦鸟已安巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5525,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汉江源","author":"薛瑄","text":"巨峡自天辟，峨峨嶓冢尊。\n回环幽谷底，清浅汉江源。\n泉古通元气，根深彻后坤。\n朝宗东去意，应不废晨昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5526,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"嘉陵泛江","author":"薛瑄","text":"湛湛嘉陵水，沉沉石底明。\n岸翻云树影，谷响棹歌声。\n微冷南风细，轻阴暮雨晴。\n应难逢此景，还慰远游情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5527,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"嘉陵江雨","author":"薛瑄","text":"官舫泛嘉陵，浑如一叶轻。\n滩高骇浪急，岸阔漫流停。\n山木无边翠，人烟几处青。\n棹歌高枕听，竟日雨冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5528,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨后宿嘉陵","author":"薛瑄","text":"夜宿嘉陵岸，扁舟雨不休。\n山云迷涧壑，林火射江流。\n久坐思王事，难眠动旅愁。\n所期氛祲扫，走马上神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5529,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"嘉陵喜晴","author":"薛瑄","text":"不堪篷背雨，直打到天明。\n乍喜朝云敛，俄看旭日晴。\n林分千嶂秀，山空一江清。\n泛泛情何极，舟人急橹声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5530,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"锦城寓馆八首 其一","author":"薛瑄","text":"寓馆富花竹，书斋夏日长。\n芭蕉红锦秀，栀子白花香。\n树密宁知暑，窗开但觉凉。\n远怀虽暂遣，世虑未能忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5531,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"锦城寓馆八首 其二","author":"薛瑄","text":"曲径通幽处，交阴翠竹高。\n书斋成雅趣，花圃惬游遨。\n石甃涵天影，风林作海涛。\n宁知城市内，清境胜江皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5532,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"锦城寓馆八首 其三","author":"薛瑄","text":"细雨过空庭，纤纤草色青。\n凉风生近户，淡霭散高冥。\n林外鹃声急，檐前燕语轻。\n锦城虽可乐，终是念归程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5533,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"锦城寓馆八首 其四","author":"薛瑄","text":"当户海榴树，纷纷落绛英。\n竹林新笋出，石砌绿苔生。\n小屋知心静，繁花觉眼明。\n少陵今远矣，谁与论诗情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5534,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"锦城寓馆八首 其五","author":"薛瑄","text":"偶居锦城馆，还似浣花堂。\n雨过青苔润，风来翠簟凉。\n竹鸣潇洒韵，花送自然香。\n清兴虽无尽，乡心未可忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5535,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"锦城寓馆八首 其六","author":"薛瑄","text":"红芳经雨重，翠竹引风多。\n生意每如此，天心奈乐何。\n一杯吾自劝，隔户鸟当歌。\n忽起乡关念，条山绕大河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5536,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"锦城寓馆八首 其七","author":"薛瑄","text":"清晨坐书閤，初日照花林。\n宿露泫庭竹，晴天啭野禽。\n心无一念杂，窗绝半尘侵。\n道理无边在，悠然思转深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5537,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"锦城寓馆八首 其八","author":"薛瑄","text":"閒坐竹林内，风来见箨飘。\n轻烟晴冉冉，凉气晚萧萧。\n易古还宗邵，书删却自尧。\n莫嫌耽典籍，清景美相调。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5538,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"有感五首 其一","author":"薛瑄","text":"火发木将燬，奸生理自危。\n洞观千古事，深合一时为。\n往事既如此，来踪可更追。\n尔心徒自省，吾道欲何之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5539,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"有感五首 其二","author":"薛瑄","text":"谁使三苗叛，深劳王者师。\n操兵诸将勇，转粟万人疲。\n行见投戈日，还看奏凯时。\n犬狼何足道，雨露本无私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5540,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"有感五首 其三","author":"薛瑄","text":"锦里南天外，中原北斗边。\n乘轺孤节远，恋阙寸心悬。\n雁塞氛常净，龙沙驾已旋。\n忠臣扶社稷，快著祖生鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5541,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"有感五首 其四","author":"薛瑄","text":"庶官务割剥，不念远人穷。\n况复羽书急，时兼馈饷供。\n探兵林莽密，转粟水山重。\n指日兵氛扫，车书四海同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5542,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]