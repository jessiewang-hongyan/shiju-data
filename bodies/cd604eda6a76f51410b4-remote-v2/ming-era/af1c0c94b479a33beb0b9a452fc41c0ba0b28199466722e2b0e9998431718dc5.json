[{"title":"赠张文学汝成","author":"李英","text":"尔本云霄客，余惭草莽人。\n风尘悲短剑，意气惜芳春。\n绿发新诗早，青灯旧业贫。\n甘泉誇献赋，应继汉词臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中过灵济宫访黄山人因留酌斋中赋此","author":"李英","text":"幽栖堪避俗，步屧好追攀。\n雪里开孤径，城中见五山。\n鸟声迷竹浦，寒色掩松关。\n共贳新丰酒，陶然一醉还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠李少成","author":"李英","text":"蓟城风土异，冰雪又将春。\n旅食乡同远，泥涂客共贫。\n交游谁意气，兄弟尔情亲。\n白璧轻相赠，何能报主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓西长客舍对雪有怀","author":"李英","text":"江城一望雪漫漫，杨柳萧疏万户寒。\n玉树祥云飞太液，金茎佳气满长安。\n飘零三径今虚远，流落孤怀强自欢。\n却忆旧游溪上客，此时开阁正凭阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕同庞景元过饮李时芳馆时景元将归","author":"李英","text":"竹林行乐且相亲，雪满河山莫问津。\n邸里共欢除夕酒，灯前俱是异乡人。\n世情曲折交游在，客况萧条岁月新。\n却羡梅花千万树，天涯明日又逢春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日","author":"李英","text":"风尘悲独客，飘泊忽三年。\n多病逢人日，归心度楚天。\n暝云千树失，残雪万峰连。\n极目长安道，春江思渺然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日道院咏雪","author":"李英","text":"腊尽梅初发，春光郁未开。\n六花飞汉苑，三白满蓬莱。\n天阔银成海，山高玉作台。\n蹇驴犹索句，孤眺思悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜旅怀柬国辉时芳","author":"李英","text":"客中怜此夕，灯火自相亲。\n梅柳故乡梦，风烟上国春。\n年深容易老，道在岂言贫。\n为问青山约，相将寄此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄伦惟伯黄悦可","author":"李英","text":"江楼一以别，书札若为传。\n沧海空相忆，缁尘只自怜。\n穷愁三径月，归计五湖天。\n把钓烟村晚，渔歌取醉眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张汝成自东鲁至过访邸中二首 其一","author":"李英","text":"下马长安道，相逢慰所思。\n可怜鸡黍约，不负竹林期。\n世态看今日，春光正此时。\n子云方寂寞，三径莫来迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张汝成自东鲁至过访邸中二首 其二","author":"李英","text":"怜君东岳至，把袂值三春。\n上苑莺声动，千门柳色新。\n江关回紫气，边塞净烽尘。\n斗酒那辞醉，论交有故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黎国辉南还","author":"李英","text":"燕市浮沈日，论交独有君。\n此时一为别，何日复同群。\n嫩柳已堪折，新莺不可闻。\n天涯归去好，敢怨路岐分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邹子南还二首 其一","author":"李英","text":"燕山晴色照千门，朔塞春鸿度禁垣。\n此际送君江上路，翻教芳草怨王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邹子南还二首 其二","author":"李英","text":"郊门饯别一尊残，万里春山马上看。\n忆尔音书两行泪，莫因归雁寄长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵酬伦惟伯见怀","author":"李英","text":"多年萍迹自浮沈，江海空驰万里心。\n九陌繁花春梦里，五湖青草暮天阴。\n怀君寂寞难成赋，抚景萧条漫抱琴。\n欲寄尺书缄别恨，新莺偏似故园音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黄悦可见寄","author":"李英","text":"日南天尽粤王台，犹得飞书远寄来。\n何事关山八千里，暮云春树思悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春有怀二首 其一","author":"李英","text":"九关北望净风尘，碧草萋萋柳色新。\n却愧文园犹卧病，落花飞雨怨残春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春有怀二首 其二","author":"李英","text":"天南天北暮春时，徙倚空怜御柳丝。\n云掩碧苔人寂寂，数声啼鸟在高枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广德寺观牡丹","author":"李英","text":"径转西园窈窱通，寻芳步屧到禅宫。\n池边风卷千丝密，槛外烟笼万片红。\n上界香飘双树侧，曲江春在一亭中。\n松门不厌缁尘客，骑马携壶兴未穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后过集徐氏诸子馆","author":"李英","text":"海内论心少，尘中孰爱才。\n可堪风雨后，能过竹林来。\n去住怜孤剑，飘零且一杯。\n长安留滞客，怀抱待君开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋","author":"李英","text":"千山当落日，一叶又惊秋。\n未解相如病，犹增宋玉愁。\n行藏羞短鬓，渔钓忆沧洲。\n何事长为客，西风独倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送友人南还","author":"李英","text":"登楼万里望乡关，倦翼江南不可攀。\n易水寒波飘木叶，楚天秋色满河山。\n城边征雁千群起，驿外归人一骑还。\n独客此心君不见，风尘何以慰愁颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出京潞河别吴子福","author":"李英","text":"东风吹晓日，春水下江湖。\n潞渚劳君送，燕山别梦孤。\n轻烟笼翠柳，细雨洒平芜。\n解缆飘然去，前期万里途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登岱","author":"李英","text":"岱宗犹有汉云封，瑶草金芝事事空。\n万树苍茫舟壑里，诸峰迢递碧霞中。\n双龙尚见秦关气，疋马频嘶越观峰。\n自笑登高不能赋，古松苍柏思何穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过曲阜阙里谒孔庙","author":"李英","text":"阙里抠衣地，中天紫气舒。\n自怜草莽客，幸礼圣人居。\n道在千秋日，功成六籍书。\n金丝犹可听，俯仰意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春日渡江过濠梁","author":"李英","text":"落日满濠梁，中原路已长。\n暝云通泗水，归雁度潇湘。\n柳色争春发，梅花满路香。\n南行家渐近，登阁见江乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日登五羊城楼眺望因寄溪上友人","author":"李英","text":"翩翩归雁过扶胥，独客登楼俯大虚。\n涨海波声天外尽，平原烟色柳中疏。\n浮云越巂千峰迥，霸气秦关万里馀。\n却忆故人南海上，相将骑鹿访茅庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙寅二月新婚有作","author":"李英","text":"却喜佳期至，东风柳色新。\n深杯银烛夜，明月洞房春。\n梦寐千秋事，驱驰百感身。\n起看天地里，问寝在兹辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题醉姝图","author":"李英","text":"玉壶春酒映颜红，翠黛青鬟柳色中。\n何事旁人扶不起，醉来无力倚东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端午同友人泛舟游大通寺","author":"李英","text":"中夏值端阳，来游曲水旁。\n落霞侵殿阁，芳草过林塘。\n竞渡歌声乱，开尊客思长。\n陶然同一醉，明月在沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕","author":"李英","text":"月殿桂香飘，双星渡鹊桥。\n佳期怜此夕，分手恨明朝。\n机杼丹心苦，烟波涕泪遥。\n百年怅灵匹，怀抱几时消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜同欧黄诸词客集城南楼得凉字","author":"李英","text":"江城明月夜，幽赏思偏长。\n笛弄梅花落，尊开竹叶香。\n淡云笼树色，荒径散秋凉。\n好觅渔樵去，扁舟赋水乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋江村即事","author":"李英","text":"鸿雁南来急，秋高万木残。\n一轮明月满，况在故园看。\n沧海惊烽燧，烟霞失钓竿。\n终宵把长剑，江色不胜寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日山中寄怀燕京诸友","author":"李英","text":"关河遥望五云长，巾舄翩翩剑气光。\n万里青天飞紫雾，几家红树散秋霜。\n怜余兰茝垂丹壑，忆尔风尘在异乡。\n此际南来燕塞雁，可无书札寄山房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜同欧黄关诸词客雅集","author":"李英","text":"萧萧朔气满江津，明月西园集上宾。\n白眼相看双剑合，清尊潦倒片心真。\n望中海树飘红叶，江上秋霜莽白蘋。\n却羡芙蓉烟水色，可堪携手共垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初冬至淩江旅寓同何尚锡邝建弘何尚祯丘朝仰黄汝良月夜宴集","author":"李英","text":"短褐西风愧旅游，高歌一曲暂淹留。\n异乡尊酒论心夜，明月天涯作客秋。\n驿路淩江双水合，望中庾岭片云浮。\n明朝又是梅关别，匹马斜阳处处愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"横浦驿别梁景怀何尚贤欧允亮","author":"李英","text":"萍梗飘零笑此身，十年羁思不堪陈。\n谁知南北章江水，又向河桥别故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临江道中遇乡友","author":"李英","text":"孤篷千里外，淦上喜逢君。\n倾盖怜羁旅，开尊醉白云。\n心驰章水远，路入楚江分。\n共是飘零客，秋声不可闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜旅泊南昌","author":"李英","text":"抚剑悲行役，看山计去程。\n雁飞沧海月，客问豫章城。\n树色苍烟出，秋声画角生。\n关河不可望，千里若为情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"发南康度鄱阳湖阻风","author":"李英","text":"西风湖口叹飘零，独倚篷窗思渺冥。\n一望秋涛千里色，青山何处是宫亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过留都访何尚爵客馆","author":"李英","text":"万里飘蓬叹异乡，故人握手慰愁肠。\n登楼共醉金陵酒，击楫还冲楚泽霜。\n目断江城秋树迥，心驰淮海暮天长。\n别来勿谓关山阻，待尔鸿书远寄将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵旅夜","author":"李英","text":"青山何处可堪留，双屐重来白下游。\n萧瑟西风吹客鬓，婆娑明月满江楼。\n玉箫断续秦淮曲，画角凄清汉苑秋。\n湖海萍踪人又远，尺书谁更问刀头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送罗汝绩南还","author":"李英","text":"把袂离杯惜共传，君家白发最堪怜。\n漫游湖海三千里，旅食风霜二十年。\n明月心期沧浦上，白云家在粤江边。\n凄凄又向维扬别，落木寒波送客船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送傅应秋南归","author":"李英","text":"送尔还家我独留，暂时尊酒共登楼。\n舟行南国三江暮，帆挂西风万里秋。\n岁序飘零怜越鸟，天涯去住惜吴钩。\n可堪相见仍相别，水远山长寄我愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜寄怀溪上友人二首 其一","author":"李英","text":"高阁寒江独眺，长天征雁孤飞。\n故人千里难见，客子三冬未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜寄怀溪上友人二首 其二","author":"李英","text":"一见楼前雪色，因思溪上梅花。\n沧海怜余作客，何时共尔餐霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪巾送别黄氏诸子北上二首 其一","author":"李英","text":"送君北上黄金台，淮水征航晓日开。\n今夜飘零何处泊，竹西亭畔笛声哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪巾送别黄氏诸子北上二首 其二","author":"李英","text":"江淮飞雪满河东，尔去长安赋汉宫。\n到日西山春正好，高楼明月醉东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"扬州丙寅除夕","author":"李英","text":"岁月催双鬓，浮生又一年。\n乡关渺何处，书剑益凄然。\n雪积千山暝，云深万树连。\n凭高仍引望，离思满江天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日游上方寺访竹塘上人禅房四首 其一","author":"李英","text":"步屧寻江路，随缘到上方。\n日高丹鹫岭，心远白云乡。\n草树含芳润，风烟接混茫。\n隋家堤畔柳，春浪汴渠长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日游上方寺访竹塘上人禅房四首 其二","author":"李英","text":"披云游古刹，问偈欲栖禅。\n共倚梅花阁，因翻贝叶篇。\n青霞吾道在，丹壑此心悬。\n何事劳行役，尘踪只自怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日游上方寺访竹塘上人禅房四首 其三","author":"李英","text":"春草正芳菲，禅关隐翠微。\n古堂僧定后，荒径客来稀。\n烟散千山远，江空一鸟飞。\n坐听钟磬晚，双树思依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日游上方寺访竹塘上人禅房四首 其四","author":"李英","text":"徙倚蜀冈边，探奇思渺然。\n看碑寻古井，挥麈赋新篇。\n野寺多逢客，山家有胜缘。\n倘成莲社约，何异虎溪前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泰州光孝寺留别法轮上人","author":"李英","text":"十年萍迹叹浮沈，此际因怜静者心。\n明月独堪裁薜荔，白云犹自恋衣簪。\n疏钟隐隐千峰碧，高阁重重万树深。\n别去江淮清梦远，他时书札复相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友人何于参自岭南北上过广陵访余客邸共宿十夕而别因赋此为赠","author":"李英","text":"广陵驿下大江干，谁遣西来十日欢。\n落魄怜余羁楚甸，连翩送尔入长安。\n分镳自觉酣歌少，仗剑休嗟行路难。\n到日侠游多乐事，上林秋色月中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋","author":"李英","text":"千家疏柳送鸣蝉，秋霁长空月正圆。\n山势北连平楚外，海门东望片帆前。\n坐闻戍角临城起，愁听邻砧闭阁眠。\n借问淮南丛桂树，何人还赋小山篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋兴二首 其一","author":"李英","text":"邗江秋色对踌躇，五岳年来忆著书。\n多病已抛沧海钓，穷愁惟问白云居。\n掩窗有梦频成蝶，弹铗高歌不为鱼。\n强欲解嘲君莫笑，寂寥半似草玄庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋兴二首 其二","author":"李英","text":"兵戈世路感离忧，江国谁怜远客愁。\n谈笑便能投笔去，功名宁负抱书游。\n疏砧城郭家家月，落叶篱门树树秋。\n莫向淮阴吊韩信，汉庭元不吝封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻迷楼遂登平山堂","author":"李英","text":"隋家东引汴渠流，锦缆牙樯向此游。\n玉殿凄凉萤火夕，丹枫摇落石鲸秋。\n塞鸿南度经吴苑，淮水西来下楚州。\n莫向池边歌九曲，暮鸦啼处使人愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游大明寺","author":"李英","text":"平山堂在蜀冈边，松下清泠第五泉。\n梵宇钟声千涧落，江门秋色片帆悬。\n题诗旧社人何处，挥麈高斋客共禅。\n更欲与君期出世，归心多在白云天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送余沈二春元赴进士举","author":"李英","text":"四明才子最风流，双璧开函万里秋。\n落日悲歌辞易水，青春献赋上瀛洲。\n云浮五色听胪唱，花簇千门策马游。\n正反圣朝新气象，追趋东观侍宸旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠许秀才","author":"李英","text":"之子江淮彦，高歌侠气雄。\n孤灯悬雪屋，双翮待秋风。\n木食惭余拙，荷衣得尔同。\n邗沟一长啸，离合感飘蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵春日雨后同盛姚诸君子出游城南诸寺遂登雨花台","author":"李英","text":"梅冈新霁后，犹似雨花年。\n说法空山顶，斋心绣佛前。\n江边六代寺，城上五云天。\n欲赋长干柳，苍茫起夕烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过姚洪胪市隐园","author":"李英","text":"中林一归客，行乐在茅茨。\n水石今为主，烟萝旧有期。\n草玄芸满径，举白月临池。\n莫与公荣饮，春山爽气时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访无着上人因题青莲宇","author":"李英","text":"东林池水净，何许种青莲。\n精舍开三径，幽期驻七贤。\n经行明月下，趺坐薜萝前。\n我亦寻支遁，抠衣一访禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊辰二月自金陵过京口遇雪有作","author":"李英","text":"飘飘何处客，乍别凤凰台。\n为忆三山胜，宁辞百里来。\n夕帆过海树，春雪点江梅。\n即此堪乘兴，犹如访戴回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游金山寺","author":"李英","text":"久忆名山胜，春风泛艇游。\n巨涛吞宝刹，朗月涌江流。\n啼鸟窥禅诵，飞花过石楼。\n上方钟磬晚，天乐起峰头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游甘露寺","author":"李英","text":"甘露何年降，翛然古佛堂。\n老僧不说法，童子自焚香。\n大地慈云合，诸天慧日长。\n一庵藏海岳，空忆米家狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]