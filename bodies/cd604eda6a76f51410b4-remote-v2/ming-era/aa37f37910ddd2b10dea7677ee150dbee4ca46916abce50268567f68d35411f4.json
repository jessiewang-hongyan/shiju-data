[{"title":"游白鹿洞诗三首 其二","author":"胡俨","text":"路入匡山里，遥遥五老峰。\n缘崖披绿草，涉涧转苍松。\n野果经时落，岚烟积处浓。\n平生林壑兴，今日得从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游白鹿洞诗三首 其三","author":"胡俨","text":"访古求精舍，萦回石洞幽。\n何人今养鹿，有客昔骑牛。\n云谷千年境，风泉万壑秋。\n剪茆荐芳醑，胜友喜同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过枞阳留题二首 其一","author":"胡俨","text":"画舫朝天去，经过访旧游。\n青山只如此，华发已堪羞。\n陶侃枞阳日，潘郎花县秋。\n儿童应不识，父老独能留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过枞阳留题二首 其二","author":"胡俨","text":"昔忝桐乡令，曾鸣单父弦。\n重来新物色，不改旧山川。\n往事从人说，虚名愧我传。\n司农今已老，白首益萧然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵荅吴司业","author":"胡俨","text":"京国分携后，江湖岁月余。\n郑虔家少粟，玄晏架多书。\n为托金兰重，休嫌音问疏。\n茂陵秋色老，多病愧相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月二十六日拜谒长陵","author":"胡俨","text":"盖世英雄主，恢弘事业多。\n南分交址郡，北控斡难河。\n玉帐銮舆远，神宫紫翠罗。\n小臣瞻拜处，有泪落山阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拜谒献陵","author":"胡俨","text":"学富千秋日，龙飞万国春。\n重华生浚哲，大业秉经纶。\n每切勤民志，深怀守位仁。\n老臣违执绋，抆泪向苍旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓出昌平","author":"胡俨","text":"晓出昌平县，含凄别二陵。\n清霜横塞草，旭日上云屏。\n野水冰花白，孤村雾气青。\n军都当直北，寒早树先零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留寓通州","author":"胡俨","text":"独坐转岑寂，他乡留未归。\n疾风声猎猎，寒日影辉辉。\n火冷炉烟歇，茶香酒力微。\n天时与人事，相值辄相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨少傅士奇自京以诗惠酒肴随韵赋荅","author":"胡俨","text":"衰疾事朝谒，迟留不忍离。\n恩深明主眷，义重故人思。\n蚁酝分官瓮，羔肩侑客炊。\n金銮登宰辅，白首愧儒师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄少保用杨少傅韵亦以诗惠酒肴赋答","author":"胡俨","text":"十载重相见，那堪又别离。\n空梁残月梦，春树暮云思。\n辄拜分甘惠，终非接淅炊。\n太原闵仲叔，口腹愧为师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曾学士亦用杨少傅韵以诗惠肴面赋答二首 其一","author":"胡俨","text":"老辞天上去，故旧叹分离。\n短述频烦和，残灯独系思。\n冰俟春来解，薪难雪后炊。\n白头孤世望，惭愧作人师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曾学士亦用杨少傅韵以诗惠肴面赋答二首 其二","author":"胡俨","text":"张叔蒙恩泽，江淹赋别离。\n玉堂千里梦，丘首百年思。\n树对冰花结，甑非埃墨炊。\n养心惟寡欲，邹孟是吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春后三日杨少傅勉仁惠节物赋答","author":"胡俨","text":"瓦陇雪俱消，东风入户飘。\n河冰将解冻，野树不鸣条。\n胜里金花重，钗头彩燕娇。\n青山与绿水，相忆思迢迢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"通州除日","author":"胡俨","text":"衰病身先老，淹留岁又除。\n桃符循度索，竹叶渍屠苏。\n樽俎人情好，风霜客思孤。\n官河冰已解，传发儗旋舻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜","author":"胡俨","text":"已是逢人少，那堪夜更幽。\n水光清不冻，月色冷如秋。\n未熟还家梦，旋登过驿舟。\n经由虽快意，老病却宜休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新安舟中望下邳见归雁鸳鸯","author":"胡俨","text":"一棹随流水，孤城望下邳。\n沙寒残雪在，山远夕阳迟。\n鸿雁知时节，鸳鸯不别离。\n老夫行已久，计日定归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜过小孤","author":"胡俨","text":"一柱中天起，扁舟双橹鸣。\n月笼山影静，风帖浪纹平。\n荡漾星河动，凄迷烟雾横。\n更阑过彭泽，问驿是龙城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中发彭泽驿","author":"胡俨","text":"江平风不起，一棹溯中流。\n坐对桃花雨，行逢杜若洲。\n老方知静乐，病岂为身谋。\n不见陶元亮，闲情付狎鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上二首 其一","author":"胡俨","text":"归到西江上，扁舟若泛槎。\n青青香附草，的的野棠花。\n断岸几千尺，孤村三两家。\n水生鱼正美，饱饭试新茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上二首 其二","author":"胡俨","text":"解缆雨初晴，觉来闻鸟鸣。\n江云飞不断，岸草没还生。\n欲向洪崖住，谁同洛社盟。\n独怜鸥泛泛，相对两忘情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽栖","author":"胡俨","text":"避喧南郭外，地僻称幽栖。\n树色参天起，花枝入户低。\n风云时变化，陇亩自东西。\n邻曲经过少，阴阴竹覆堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春口号五首 其一","author":"胡俨","text":"村村农事急，好雨不愆期。\n蚕起桑初长，莺啼花已稀。\n梦中随物化，诗里送春归。\n寡欲无荣辱，忘言绝是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春口号五首 其二","author":"胡俨","text":"乡人皆力作，稼穑愿年丰。\n野水日无际，浮云时复空。\n谁能拜床下，我独恋丘中。\n花间蜂与蝶，各自领春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春口号五首 其三","author":"胡俨","text":"临镜理衰鬓，萧疏雪一簪。\n加餐惟粝饭，策杖散幽襟。\n蔼蔼花垂榭，森森笋出林。\n物生各成性，人事苦经心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春口号五首 其四","author":"胡俨","text":"雨霁晓风清，春鸠几处鸣。\n落花粘屐齿，飞絮拂檐楹。\n徐孺湖边宅，庞公陇上耕。\n吾犹逐人事，时复有逢迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春口号五首 其五","author":"胡俨","text":"安得名山去，追寻向子平。\n烟霞无俗迹，林壑遂幽情。\n大药终难就，衰颜或可更。\n长镵与短褐，采药过余生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正月五日食新","author":"胡俨","text":"老病安田里，偏于药裹亲。\n昔年愁不腊，今日喜尝新。\n止酒同元亮，躬耕愧子真。\n农书占岁稔，荠菜见初春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴四首 其二","author":"胡俨","text":"墟里人烟少，茆茨八九家。\n杜鹃啼夜月，鸂?下晴沙。\n江海空遗梦，园林半落花。\n病来长废饮，对客只烹茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴四首 其三","author":"胡俨","text":"带雨教移树，分畦学种蔬。\n汉阴劳灌溉，栗里费耕锄。\n看竹时呼鹤，临渊不羡鱼。\n芭蕉舒绿扇，高映碧窗虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴四首 其四","author":"胡俨","text":"地僻幽栖处，有时闻马嘶。\n每劳京国使，常过杜陵溪。\n径转苍苔滑，门临绿树齐。\n相看忘野逸，旋复惜分携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"池馆二首 其一","author":"胡俨","text":"池馆寂无尘，翛然物外身。\n已知生是幻，一任老随人。\n暑去园林净，秋来月露新。\n平生耽逸趣，始得遂吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"池馆二首 其二","author":"胡俨","text":"池馆寂无喧，清风水竹村。\n牛羊闲遍野，鸟雀动成群。\n碧树初黄叶，青山半白云。\n悠然墟里外，秋色净衡门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕忆旧","author":"胡俨","text":"云澹月朦胧，人喧古庙中。\n山林无故旧，灯火聚儿童。\n宫阙鳌峰起，星河凤辇通。\n奉陪思宿昔，锡宴万民同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春雨述怀","author":"胡俨","text":"老疾交游少，幽栖童仆亲。\n社前犹似腊，雨里不知春。\n浅薄虚乡论，萧条愧国宾。\n诗书空满架，问字竟何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄于御史谦","author":"胡俨","text":"一别又三年，长怀按部贤。\n绣衣还阙下，黄发泣江边。\n行李惟霜简，清风满画船。\n老夫前太史，彤管记遗编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨夕偶书","author":"胡俨","text":"碧树西风动，虚堂暑气收。\n砧声孤枕雨，蛩响一庭秋。\n挂席江湖远，忘言简册休。\n丰年多乐事，击壤遍林丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴四首 其一","author":"胡俨","text":"郭外烟尘净，林间风日清。\n罢琴看鹤舞，倚杖听蝉鸣。\n稍得园池趣，已忘儿女情。\n玉堂遗旧梦，白发送余生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴四首 其二","author":"胡俨","text":"数日新秋雨，蒙茏竹树交。\n世缘虽未了，尘事已全抛。\n黄叶随风下，清砧带月敲。\n何时同李白，五老结云巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴四首 其三","author":"胡俨","text":"西风吹雨过，江郭迥清幽。\n不叹交游少，喜闻禾稼收。\n暗蛩莎草暮，残蝶豆花秋。\n野服心如水，萧条老一丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴四首 其四","author":"胡俨","text":"水天同一碧，秋色净江山。\n归燕翩翩急，浮鸥个个闲。\n虚怀游物外，随分在人间。\n却笑楼船客，如何去不还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日村居四首 其一","author":"胡俨","text":"春兴浑无赖，诗篇亦漫吟。\n老来安散逸，年少忆登临。\n碧草萋萋发，浮云忽忽阴。\n洪崖好山水，怅望隔幽寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日村居四首 其二","author":"胡俨","text":"今年六十八，白发奈渠何。\n风雨连朝夕，烟霞深薜萝。\n交游天上远，人事眼前多。\n清江与碧嶂，欲往竟蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日村居四首 其三","author":"胡俨","text":"浩浩东风起，微茫晓日寒。\n老翁鸠社米，稚子送春盘。\n齿痛常妨饮，花开竟懒看。\n儿孙日一至，聊复慰衰残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日村居四首 其四","author":"胡俨","text":"鸟鸣时雨霁，微物亦欣然。\n江山空有待，物色为谁妍。\n傍树安鱼钓，开窗理蠹编。\n已谙萧散趣，不必更求田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独吟二首 其一","author":"胡俨","text":"幽怀每不惬，何处可登临。\n芳甸隔春雨，浮云留夕阴。\n山林安石兴，江海子牟心。\n此意同谁语，沉绵只独吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独吟二首 其二","author":"胡俨","text":"樗栎材虚拱，桑榆景已残。\n天涯春色远，窗下雨声寒。\n独自空玄守，何人问字难。\n蔷薇花又发，却笑酒杯干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江村早秋露坐即事 其一","author":"胡俨","text":"翳翳景将入，凉风生夕襟。\n暗蛩连野径，惊鹊绕疏林。\n已与交游息，都无俗事侵。\n杜陵空老大，短发不胜簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江村早秋露坐即事 其二","author":"胡俨","text":"林梢纤月白，江上晚风清。\n禾黍千家聚，梧桐一叶惊。\n银河垂绿野，瑶露泻金茎。\n宋玉虽能赋，都无少日情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有秋二首 其一","author":"胡俨","text":"颓龄淹困疾，却喜见丰年。\n露积村村获，官租迭迭蠲。\n牛羊连下泽，雁鹜际平川。\n本自无桴鼓，幽居且熟眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有秋二首 其二","author":"胡俨","text":"太平本无象，有象在田畴。\n禾黍闻皆熟，鸡豚散不收。\n池塘梧叶雨，篱落豆花秋。\n乐岁人欢聚，熙然不外求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸丑元日试笔 其一","author":"胡俨","text":"倏忽惊年换，衰颓喜见春。\n逢迎吾已老，经过客来频。\n雪压尘氛净，花含雨露新。\n却思供奉日，恩礼倍精神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸丑元日试笔 其二","author":"胡俨","text":"颓龄跻七十，世谓古来稀。\n礼俗多从简，尘劳久息机。\n春前云黯澹，雪后雨霏微。\n却忆少年日，看人扶醉归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惊蛰夜大风雪落惊寝","author":"胡俨","text":"急霰洒窗纸，飙风翻竹枝。\n划然衾觉冷，正是梦醒时。\n晓起瓦皆白，春回花不知。\n老来肌骨瘦，无那被寒欺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题包希鲁祖母送学延望图","author":"胡俨","text":"髫龀怜儿幼，诗书仰母慈。\n过桥分野色，极目送春晖。\n座右陈情表，窗前故杼机。\n试看图画里，泪落老莱衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"池上纳凉","author":"胡俨","text":"徂夏暑方盛，已闻寒蝉鸣。\n风摇水花碧，日落林影清。\n虚怀散烦郁，独坐念平生。\n入夜群动息，池塘惟月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二月一日早朝","author":"胡俨","text":"曈昽初日曙光遥，钟鼓声传下九霄。\n万国衣冠趋象魏，两阶干戚奏箾韶。\n天清华盖云中见，风细垆烟仗外飘。\n朝出金门还北望，钟山苍翠正岧峣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秘阁书事简同志","author":"胡俨","text":"秘阁清严接观台，九重佳气护蓬莱。\n宫墙树近莺声度，金水芹香燕子来。\n行傍朱阑吟细雨，坐分瑶席绝浮埃。\n太平无事多休暇，忝列词林愧不才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华盖殿读卷放进士榜","author":"胡俨","text":"御前读卷重抡材，香动红云宝扇开。\n银烛光深传刻漏，玉阶班列总琼瑰。\n深惭染翰依宸极，况复承恩接上台。\n阙下两行陈法乐，遥迎金榜自天来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕侍宴","author":"胡俨","text":"风清华月丽晴空，湛露筵开圣泽浓。\n灯火遥连丹阙外，萧韶只在彩云中。\n九重瑞霭浮金雀，万树银花粲玉虹。\n光禄传宣催进酒，乌纱都映醉颜红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阅子棨行卷","author":"胡俨","text":"扈驾从容上北京，东风千里马蹄轻。\n行宫日暖花争发，御路尘清草正生。\n乌帽趋朝晨载笔，红旗分队晚催营。\n历观卷里多佳制，端有才华压长卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"禁中对雪次韵","author":"胡俨","text":"昼漏沉沉禁苑清，苑中飞雪入帘轻。\n天低玉树连双阙，风送琼花下五城。\n紫雁声惊寒信早，白鹅影落冻云平。\n晚来同出金门道，光映西山眼倍明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵仲熙侍讲元夕侍宴 其一","author":"胡俨","text":"黄伞高张宝扇开，教坊初进鼓如雷。\n星移珠斗云中下，鳌戴仙山海上来。\n欢宴稀闻传夕漏，游观总喜到春台。\n侍臣独有金闺彦，即席裁诗不待催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵仲熙侍讲元夕侍宴 其二","author":"胡俨","text":"驰道金舆驾六龙，鸣銮遥下五云中。\n呈来彩队香飘席，听彻清歌月转空。\n树拥蓬莱浮暖翠，花含火齐照春红。\n圣恩浩荡深如海，岁岁年年乐未穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月十日迎诏","author":"胡俨","text":"天书遥降自胪句，五色云随使者车。\n袅袅鸡竿悬象魏，亭亭凤盖簇龙舆。\n黄沙部落提封远，紫塞氛埃汛扫余。\n早晚王师归振旅，千官仗外拥琼琚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朝回喜雪即事","author":"胡俨","text":"阙下朝回散锦鞯，窗前独坐拥吟毡。\n一垆松火春生席，万点璚花雪满天。\n腊蚁泛瓯倾绿醑，香狸载俎割红鲜。\n微才碌碌嗟无补，饱食徒令愧俸钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和胡学士扈从猎阳山","author":"胡俨","text":"晓随万乘出城东，列校分屯部伍同。\n云里六龙移彩仗，风前一雁落彤弓。\n露凝松柏垂垂白，日映旌旗猎猎红。\n遥见下绥传令发，将军飞骑总英雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和胡学士扈从再猎武冈 其一","author":"胡俨","text":"武冈苍翠郁岧峣，日上千林曙色遥。\n驰道鸣銮闻涧谷，期门立表近云霄。\n角弓飞镝寒偏劲，猎火依山晚更烧。\n万骑前头笳鼓发，长歌吉日喜联镳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和胡学士扈从再猎武冈 其二","author":"胡俨","text":"霜清辇路净无尘，甘露凝珠万树春。\n旷野飞鹰腾猎骑，行宫举㧘锡词臣。\n仲冬大阅昭时典，此日三驱仰帝仁。\n莫道角端曾应瑞，中山今已见麒麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]