[{"title":"赋得楚姬二首 其一","author":"郑学醇","text":"纤腰浑欲不胜裾，花不如兮玉不如。\n莫倚红颜轻缓颊，君王留意在商于。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得楚姬二首 其二","author":"郑学醇","text":"章华西望即高唐，为雨为云入梦长。\n惟楚有才如宋玉，只将词赋事君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日园亭七首 其一","author":"郑学醇","text":"琅玕百尺漫摇风，石榻闲吟日可中。\n黄鸟自来还自转，绿阴谁惜又谁同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日园亭七首 其二","author":"郑学醇","text":"溶溶新绿满池塘，红藕花深属玉藏。\n蓦地赤游忽惊散，空馀烟水半斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日园亭七首 其三","author":"郑学醇","text":"金鸭香销午梦馀，数声啼鸟竹窗虚。\n箕山去后无高士，玄晏何劳更著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日园亭七首 其四","author":"郑学醇","text":"莫买黄金铸子期，素琴三尺久无丝。\n静观物理成幽趣，嘒嘒玄蝉绿树枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日园亭七首 其五","author":"郑学醇","text":"日永庭阴荫转迟，坐调元气学希夷。\n谁人解得还丹意，大乙关元只自知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日园亭七首 其六","author":"郑学醇","text":"山桃花落叶青青，掩户时看大洞经。\n扫却竹床无所事，松风偏喜卧来听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日园亭七首 其七","author":"郑学醇","text":"自有灵根自不知，浮生何苦事支离。\n内庭销尽元精秘，欲养纯阳觉已迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕子楼三首 其一","author":"郑学醇","text":"燕有空巢树有霜，楼前梧叶满银床。\n一从剑履归东洛，离恨空随濉水长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕子楼三首 其二","author":"郑学醇","text":"香袅金炉一缕烟，薰栊斜倚更潸然。\n霓裳舞罢歌钟歇，虚却楼头月几年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕子楼三首 其三","author":"郑学醇","text":"肠似江流日九回，经年不见雁书来。\n玉颜自昔多尘土，莫恨昆明有劫灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潘子迁之琼州五首 其一","author":"郑学醇","text":"曾闻海外是奇游，绛阙瑶宫彩蜃楼。\n五指山边风日美，挂帆一瞬便琼州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潘子迁之琼州五首 其二","author":"郑学醇","text":"海中奇甸三千里，翠箔珠楼十万家。\n太守旧知新地主，到应前席贾长沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潘子迁之琼州五首 其三","author":"郑学醇","text":"涓涓椰酒似璚浆，少妇垆头学闹妆。\n何事客怀春更好，清歌一曲压郡觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潘子迁之琼州五首 其四","author":"郑学醇","text":"百花如绣拥苍屏，云是先朝学士亭。\n览古莫将商调按，夜深沧海老龙听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潘子迁之琼州五首 其五","author":"郑学醇","text":"天池南畔即珠崖，南极煌煌映泰阶。\n清夜长吟抱明月，骊珠何处不探怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏州十二景 其一 阊阖门","author":"郑学醇","text":"吴门西路版桥通，万室鳞鳞水接空。\n鹤市鸡陂何处是，繁华都在画图中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏州十二景 其二 虎丘山","author":"郑学醇","text":"梵宫千尺拥姑苏，势压吴江与太湖。\n惟有生公堂下石，不知今更点头无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏州十二景 其三 虎山桥","author":"郑学醇","text":"十里楼台绿映红，酒旗轻闪楝花风。\n桥边树树闻莺语，总付游人半醉中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏州十二景 其四 南峰寺","author":"郑学醇","text":"绀殿重重隔翠微，石门中望四山围。\n飞仙自别支公去，缟袂何年更一归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏州十二景 其五 天平山","author":"郑学醇","text":"峰峦突兀郡城西，万树松杉落日低。\n何事吟筇不归去，白云馀兴尚堪携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏州十二景 其六 石湖","author":"郑学醇","text":"越来溪畔石湖开，范蠡扁舟去不回。\n荡漾何人还钓雪，夜寒山月几裴徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏州十二景 其七 天池山","author":"郑学醇","text":"华山奇石倚苍屏，下有池莲冉冉青。\n闻道玉人曾羽化，愿从风御出沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏州十二景 其八 七宝泉","author":"郑学醇","text":"一泓青彻碧山头，绿染絺衣五月秋。\n绰约荷花飞雨过，只疑神女弄珠游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏州十二景 其九 玄墓山","author":"郑学醇","text":"万峰寺下五湖水，漾漾溶溶掩映中。\n独倚层栏看不尽，一时楼阁起秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏州十二景 其十 太湖","author":"郑学醇","text":"太湖三万六千顷，渺渺波涛自古今。\n日晚湖南望湖北，布帆天际弄轻阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏州十二景 其十一 灵岩寺","author":"郑学醇","text":"吴苑娃宫旧有名，只今云树望中平。\n潇潇梵宇风铃响，犹似当时步屧声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏州十二景 其十二 甫里祠","author":"郑学醇","text":"甫蠕祠堂岁月深，秋风潇瑟满平林。\n不知笠泽人归后，千载谁同遁世心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其一 《高帝纪》","author":"郑学醇","text":"亲提三尺抚山河，汉帝归来猛气多。\n何事不禁游子恨，酒酣犹倚大风歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其二 《文帝纪》","author":"郑学醇","text":"文帝当年惠爱深，绨袍恭俭本真心。\n露台亦是观氛祲，犹为穷民惜百金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其三 《梁孝王传》","author":"郑学醇","text":"梁王旧苑宋城东，万乘旌旗比汉宫。\n宾客豪华终寂寞，平台脩竹但秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其四 《吴世家》","author":"郑学醇","text":"馆娃宫毁月轮欹，歌舞偏令霸业亏。\n纵使图存留一旅，甬东无地著西施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其五 《十二诸侯年表》","author":"郑学醇","text":"嬴秦世德自飞兼，八百岐周地总兼。\n直以富强成帝业，岂知豪杰在闾阎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其六 《六国表》","author":"郑学醇","text":"三晋当年各拜侯，王纲纽解竟难收。\n山东连师凭谁在，容易强秦并二周。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其七 《月表》","author":"郑学醇","text":"芒砀山前气结龙，干戈天地各争雄。\n尽收人杰摧强楚，倡义谁知是董公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其八 《天官书》","author":"郑学醇","text":"清宵月晕几重围，参毕微茫澹曙晖。\n十万健儿齐彀弩，平城初拥翠华归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其九 《礼书》","author":"郑学醇","text":"殿上欢呼击柱时，叔孙初起汉朝仪。\n周官典礼应犹在，绵蕞何须野外为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其十 《乐书》","author":"郑学醇","text":"天马遥从异域归，乐歌宣奏汉廷威。\n当时中尉披忠谠，何事平津动杀机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其十一 《封禅书》","author":"郑学醇","text":"汉帝雍郊五畤祠，夜通权火树灵旗。\n祥麟宝鼎皆符瑞，万岁君王正受釐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其十二 《河渠书》","author":"郑学醇","text":"河水潺湲瓠子通，宣房堤上作新宫。\n千秋梁楚皆平土，长忆玄圭锡禹功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其十三 范雎","author":"郑学醇","text":"三亭南逐使车尘，客子西来却柄秦。\n世上莫论恩怨事，绨袍应念旧交贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其十四 赵胜","author":"郑学醇","text":"翩翩公子赵平原，漫有三千客在门。\n上党未归秦将出，长平何限国殇魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其十五 蔺相如","author":"郑学醇","text":"献璧相如亦壮哉，秦廷相顾重裴徊。\n渑池莫问谁强弱，羸得君王击缶来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其十六 乐毅","author":"郑学醇","text":"力破齐城七十馀，乐生才略好谁如。\n功名自昔难终始，去国彷徨只报书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其十七 荆轲","author":"郑学醇","text":"欲劫强秦事已难，可怜骈死为燕丹。\n美人玉腕将军首，恨满西风易水寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其十八 聂政","author":"郑学醇","text":"结好宁论百镒金，此生然诺为谁深。\n濮阳仗剑酬知己，不负穷交一片心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其十九 王蠋","author":"郑学醇","text":"呜咽歌中薤露晞，田横宾客世间稀。\n可怜王蠋捐生日，七十馀城只布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其二十 屈原","author":"郑学醇","text":"枫树潇潇汩水深，宗臣眷顾意何深。\n强秦反覆重诒楚，谋国何人竭寸心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其二十一 贾谊","author":"郑学醇","text":"日落烟生楚水昏，不堪南望独销魂。\n长沙召去游梁苑，宣室空劳赐对恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其二十二 蒙恬","author":"郑学醇","text":"辽阳东望尽临洮，万里风烟戌垒高。\n城窟未堙秦祚改，不知亭幛为谁劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其二十三 张良","author":"郑学醇","text":"故国恩深五世馀，强秦回首已丘墟。\n东风阳武惊尘起，犹似韩椎击副车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其二十四 陈涉","author":"郑学醇","text":"丛祠篝火作狐鸣，垄卒凭妖亦树兵。\n百二山河终瓦解，不须闾左戍长城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其二十五 虞美人","author":"郑学醇","text":"慷慨休论百战功，楚歌声散阵云空。\n英雄失势谁相恋，惟有虞姬在帐中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其二十六 郦食其","author":"郑学醇","text":"落魄高阳旧酒徒，一冠仄注笑谈粗。\n匆匆早据陈留粟，曾见良平此画无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其二十七 韩信","author":"郑学醇","text":"平齐覆赵挠强楚，世上功高责报难。\n淮水潇潇秋日莫，王孙应忆钓鱼竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其二十八 周勃","author":"郑学醇","text":"厚重何须少绛侯，世勋原自足安刘。\n淮阳宾客今犹在，小为将军决胜筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其二十九 周亚夫","author":"郑学醇","text":"羽书朝奏未央宫，大将兵屯细柳东。\n阃外不闻天子诏，六飞先驻壁门中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其三十 陆贾","author":"郑学醇","text":"汉主推心御远夷，赵佗垂老拜恩时。\n岂知一介重来使，全胜戈船十万师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其三十一 司马相如","author":"郑学醇","text":"徼外西夷入版图，使君拥传过成都。\n长江可恨流如锦，不洗临邛旧酒垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其三十二 李广","author":"郑学醇","text":"射猎归来夜已迟，霸陵亭尉醉呵时。\n将军莫恨封侯事，何限人间是数奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其三十三 汲黯","author":"郑学醇","text":"非关长孺恋中郎，补阙真心老更长。\n禁闼未容趋狗马，十年官阁卧淮阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其三十四 李广利","author":"郑学醇","text":"张骞西使大宛通，苜蓿葡萄满汉宫。\n多少征人归不得，论恩先赏贰师功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其三十五 霍去病","author":"郑学醇","text":"汉家初筑受降城，塞外烽烟入望平。\n胡虏已归屯戍减，陇头秋月向人明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"史记三十六首 其三十六 卫青","author":"郑学醇","text":"风沙夜击武刚军，雪压弓刀几尺馀。\n晓上阗颜山上望，不知何路逐单于。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"前汉书十七首 其一 公孙弘","author":"郑学醇","text":"相君徒步起东齐，爵拜平津老执圭。\n东阁尽招天下士，董生何以滞胶西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"前汉书十七首 其二 倪宽","author":"郑学醇","text":"内史曾亲凿六渠，汉廷儒术更谁如。\n登封典礼躬逢日，不羡文园只著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"前汉书十七首 其三 主父偃","author":"郑学醇","text":"严安徐乐临淄偃，朝奏封章夕拜郎。\n明主独惊相见晚，抡才何但策贤良。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"前汉书十七首 其四 终军","author":"郑学醇","text":"终军年少独称才，长揖青州太守来。\n奉使东归行建节，关门何事索襦回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"前汉书十七首 其五 朱买臣","author":"郑学醇","text":"樵檐行歌半似狂，艾年初拜汉宫郎。\n丈夫得意多迟暮，邱吏休惊太守章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"前汉书十七首 其六 东方朔","author":"郑学醇","text":"玩世何嫌谲谏非，金门依隐愿多违。\n长安索米囊钱少，且自谈谐割肉归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"前汉书十七首 其七 卜式","author":"郑学醇","text":"草蹻披衣自牧羊，朴忠曾不愿为郎。\n司农少府犹称诎，何但民间少盖藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"前汉书十七首 其八 萧望之","author":"郑学醇","text":"东海萧生射策时，栖栖何事抱关为。\n岂知师傅持衡日，不是承恩是履危。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"前汉书十七首 其九 赵充国","author":"郑学醇","text":"忠言自合酬明主，屯疏何辞屡犯颜。\n坐策西羌终瓦解，全师横槊凯歌还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"前汉书十七首 其十 扬子云","author":"郑学醇","text":"为郎三世汉朝臣，载笔何须更美新。\n莫厌草玄终寂寞，相过还有问奇人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"前汉书十七首 其十一 朱云","author":"郑学醇","text":"专门师说独超群，折角亲摧五鹿君。\n却向上方曾请剑，汉廷狂直有朱云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":15309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]