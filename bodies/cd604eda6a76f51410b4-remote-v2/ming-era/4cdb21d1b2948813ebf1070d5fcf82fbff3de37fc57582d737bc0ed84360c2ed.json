[{"title":"井陉道中","author":"释今无","text":"边风扫北平，行人出井陉。\n斜阳悬马首，寒色拥邮亭。\n道拙心如水，愁多发欲星。\n从今归旧隐，麋鹿与松扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偕露庭松山诸子寻西山精舍","author":"释今无","text":"卜室非求隐，扪心事正长。\n世人甘扰扰，吾道亦皇皇。\n草色连关塞，风声聚太行。\n行藏多悔吝，翻对汝曹伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再过乱落星","author":"释今无","text":"一去穷塞关，重来乱落星。\n云归山脚白，天入石门青。\n竦盻驱神远，深幽觉性灵。\n香风长不散，兰蕙满阶庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬徐秀才栖贤韵 其一","author":"释今无","text":"一径松杉密，千峰雨雪寒。\n有时云气入，逾觉草堂宽。\n半菽山中味，香台鸟下餐。\n高人来蜡屐，殊愧客盘单。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬徐秀才栖贤韵 其二","author":"释今无","text":"久住芙蓉侧，前山竟少游。\n涧花朝亦采，松子晚方收。\n草屦因人出，禽声为客幽。\n堪嗟严子濑，徒有黑羊裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿黄子","author":"释今无","text":"玉醴难持赠，禅心君所亲。\n但将今日意，长祝百年人。\n鹤静能忘影，松寒不计春。\n共看斯道胜，却笑枉逃秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿监寺旋兄","author":"释今无","text":"几年匡岳顶，坐月每怀君。\n境觉閒中换，心从别后真。\n气虚常接物，才富亦因人。\n手泽千株茂，遐龄笑大椿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南海神祠","author":"释今无","text":"隋唐遗一庙，香火历千秋。\n地足扶桑雨，山当大海流。\n读碑堪吊古，问树识蛮陬。\n正欲题诗去，笳吹起暮愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浴日亭","author":"释今无","text":"万古祝融殿，千秋浴日亭。\n气收南海阔，云到北溟青。\n短景寒威弱，波声古木灵。\n地舆曾入汉，辛苦使臣星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登西台","author":"释今无","text":"入望烟波阔，登台气象高。\n风声低雁翅，海色上僧袍。\n红日当朝见，鲛人闻夜号。\n平生有怀抱，行坐总成劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送顿修还栖贤随省亲苕上","author":"释今无","text":"何年共归去，岁岁送行舟。\n渐老伤频别，长途系远愁。\n白云深霅水，红叶满丹丘。\n两处劳心膂，风烟日夜流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"扫先师翁塔大雨赋此","author":"释今无","text":"四百峰中雨，倾盘聚此峰。\n眉分双涧瀑，雷起隔溪龙。\n土嫩难禁水，心悲易怯风。\n晴阴付天地，随处见吾翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送祖印游靖安","author":"释今无","text":"君去非予意，山川但暂看。\n雪深知发白，云静觉江寒。\n鞋岂南询着，衣从北路单。\n相关切相望，勉矣慰人难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题波罗庙达奚司空","author":"释今无","text":"绝域无归日，炎州列汉官。\n波声乡梦远，海色泪痕乾。\n遗泽千秋古，蛮烟百代寒。\n如今方羡汝，难得是衣冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送记汝入栖贤","author":"释今无","text":"携手投名岳，閒心副薜萝。\n诗吟佳景易，病系远人多。\n溪咽了无梦，天寒自伐柯。\n明年秋雁至，寄我慰如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈牧止游篁山","author":"释今无","text":"兹行探白岳，不比赴公车。\n风景供拈笔，高情在策驴。\n山长欺雪过，岁晏藉诗除。\n自得冥心理，门生可执书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻见一病愈戏成","author":"释今无","text":"忽闻君病剧，凄断不堪陈。\n旋得瞑眩药，犹惊矍铄神。\n树盆嘱后事，花罐取藏身。\n自此不须用，都应赠与人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顿修省觐苕上痛堪家难事后返栖贤久未入岭诗以速之","author":"释今无","text":"伤心看已过，几作覆巢馀。\n大难频忧汝，生还但寄书。\n山深风木苦，师远道颜疏。\n应早趋瓢笠，繁心一解予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"托钵佛山 其一","author":"释今无","text":"僧贫思仗钵，歛虑向人间。\n窄路人争过，嚣声我独閒。\n袖藏曾熟面，门掩尽愁颜。\n舍卫城当日，如何便返山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"托钵佛山 其二","author":"释今无","text":"一臂酸成毒，双胫涷欲枯。\n市言多戏谑，僧笑讲锱铢。\n头碎金鸡爪，鞋沾铁镬镆。\n密云偏见雨，众口竟难糊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄凌髭放","author":"释今无","text":"雨霁留君住，江深放棹归。\n碧云虚野寺，春雾重征衣。\n道在经行迹，时危畏钓矶。\n衡门来剥喙，营虑及秋微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿张母","author":"释今无","text":"欲驭瑶池驾，宁亲有凤毛。\n百年双袖舞，万里一官劳。\n厚泽穷檐遍，交情野衲叨。\n清操有如此，方信白华高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46966,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顿修自髫水丁家难后掩关匡庐复归雷峰即以是日入侍寮诗以志喜","author":"释今无","text":"关掩伤心后，人归芳草前。\n祇须长见面，不必问流年。\n三佛香能爇，千秋愿未圆。\n衰宗期努力，谁是着先鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46967,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻凌髭放脱白丹霞此寄 其一","author":"释今无","text":"旧虑消轩冕，新情戴笠瓢。\n水寒长见影，禅罢不过桥。\n空谷存孤足，灵根得异苗。\n昔时风穴谶，烁烁起云霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46968,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻凌髭放脱白丹霞此寄 其二","author":"释今无","text":"眼老烟霞阔，尘轻岱华浮。\n几年无国土，今日有松楸。\n窗冷山飞叶，心明海息沤。\n再冬应得见，高腊笑云头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入肇庆峡","author":"释今无","text":"西风斜入峡，反侧片帆收。\n怒浪先侵石，低沙不泊舟。\n云开雷划火，野旷雨迷牛。\n独数空江眼，浮沉万点沤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"第二十三册初发琼州道中恭怀本师","author":"释今无","text":"塞雪曾辽左，蛮烟复海南。\n风尘双短鬓，去住一征衫。\n山向望中阔，书从梦里缄。\n道情偏自重，翘首见慈严。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天堂驿","author":"释今无","text":"新颓宫殿北，驿路过天堂。\n青霭石争出，红桥花漫香。\n车研春草短，鸠唤竹山长。\n书册先贤在，予生亦未忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阳春道中","author":"释今无","text":"山到阳春好，人传电白奇。\n藤花行客采，鸟语土人知。\n当面天门出，横桥岚气移。\n蛮方如脱木，定胜是秋时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阳春县","author":"释今无","text":"小邑阳春县，荒冈䀨岭尖。\n停轮惜白日，买饭爱青帘。\n水米贱于布，山柴只换盐。\n欲询明日路，乡语不能兼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46974,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发","author":"释今无","text":"晓发向通津，车声聒耳新。\n蛮烟千里道，竹笠一閒身。\n椰酒山家店，槟榔木客唇。\n更逢赤眼叟，疑是泣珠人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"车上 其一","author":"释今无","text":"野饭依山店，驱车向日边。\n眼前云到地，身外事由天。\n细雨滋油笠，高枝噪夏蝉。\n一行森古木，髣髴住山年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"车上 其二","author":"释今无","text":"有时不可耐，得意是无言。\n草色尽情绿，莺声取次喧。\n低头过石径，高枕憩蓬门。\n亦是途中事，年来始自存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗蛋","author":"释今无","text":"长途亦一食，饥困日难胜。\n暑气万山出，青天一线迎。\n沙低车脚软，石滑树头横。\n果然行不得，惭愧鹧鸪声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"电白县","author":"释今无","text":"风尘还自笑，岁月此淹留。\n地僻逢人少，城荒见客愁。\n藤蛇山店卖，海水县前流。\n作宦同羁旅，人传此邑侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"热泉","author":"释今无","text":"车歇泉声热，岩开暑气多。\n三春看若此，九夏复如何。\n绕浪花根苦，寒流北涧和。\n征尘或一洗，令尔想山阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经化城庵见憨大师遗笔","author":"释今无","text":"弘法曾婴难，经过此地贤。\n文章斯道大，笔墨世人传。\n岳色摇还壮，岩花映独鲜。\n所悲无后起，移睇欲潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三桥赠别王太初","author":"释今无","text":"相逢俱万里，分手向三桥。\n山势背人远，车声入梦消。\n砂红勾漏重，发白故乡遥。\n日暮孤征酒，愁心尔可浇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠张三","author":"释今无","text":"走马蓟门远，酬恩壮士心。\n逢僧修白业，赠客辄黄金。\n酒脱貂裘得，才因幕府深。\n看君无不可，宝剑是知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦竹驿","author":"释今无","text":"已尽崎岖径，投南渐不毛。\n雨侵人面黑，山映虎声高。\n随身惟笠钵，过眼尽蓬蒿。\n又说前途险，行人腰带刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"徐闻县","author":"释今无","text":"所经皆险僻，州县复凄凉。\n旅思一时动，心情半日伤。\n草深公府闭，人断禁门荒。\n更有明朝役，乘槎泛渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谭兑子以槟榔皮制鞋遗余谢之","author":"释今无","text":"野物君能致，幽情我不违。\n子收南国重，皮拆女红微。\n冠箨茅山小，衣莲梅老稀。\n双凫虽称意，那向谷中飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白衣庵新居 其一","author":"释今无","text":"自来无此畏，出郭愈多欢。\n不是风尘苦，焉知水石难。\n小床依草稳，片月到襟寒。\n尚得馀今日，幽情或未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白衣庵新居 其二","author":"释今无","text":"城内无多事，朝朝怯马蹄。\n门依堞影暗，首为主人低。\n细语心常动，粗餐意倍迷。\n槟榔图一醉，便梦玉渊西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白衣庵新居 其三","author":"释今无","text":"岂敢求安住，深知厌此身。\n一瓢供?轲，两眼足酸辛。\n月色真难得，人情岂易论。\n秋风莫轻触，发际渐如银。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白衣庵新居 其四","author":"释今无","text":"已穷投食计，又乞买茆钱。\n意怫西风苦，情深乡月悬。\n竹声喧枕畔，椰叶到庵前。\n亦是浮生事，焚香莫论禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白衣庵新居 其五","author":"释今无","text":"敢云效古昔，亦负客中春。\n贱极似成傲，愁多不为贫。\n嗒然堪丧我，竟欲属何人。\n所喜门前石，长吟不见嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游潭口放舟","author":"释今无","text":"解缆投何处，寻幽拟石厓。\n一生贪笑傲，万里得情怀。\n沙角鱼纹细，天边月影佳。\n远游多怪事，余欲赠齐谐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46992,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊邕阳","author":"释今无","text":"野泊邕阳好，晴看江月宜。\n棹头天路远，转眼客心悲。\n石浪归黎女，椰风聒鹭鹚。\n系舟须着力，界外即南夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46993,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潭口寻仙洞 其一","author":"释今无","text":"亦是翛然地，停舟恰受风。\n水源黎母出，地脉扶桑穷。\n怪鸟藤花杂，嘉葩椰叶重。\n棋枰不可见，伫立上洪濛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46994,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潭口寻仙洞 其二","author":"释今无","text":"苍莽盘纡径，阴幽郁石台。\n四山围不紧，一水划争开。\n潭曲风声软，岩欹海色回。\n一身经万里，难订是重来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46995,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人还五羊","author":"释今无","text":"相送关予意，蛮烟独未归。\n橹摇秋飓静，车展路花稀。\n宝货槟榔重，新诗椰叶肥。\n故山君处近，书札莫相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46996,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别吴特公","author":"释今无","text":"语短爱君深，相逢直至今。\n不堪形片纸，况复付长吟。\n石路悬红日，青山惹素襟。\n世名终自得，犹未是予心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46997,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别洪培自","author":"释今无","text":"子亦有馀致，烟霞得性灵。\n风流传旧日，才气发新硎。\n聚首宜秋月，分襟背落星。\n几多言外意，莫损柳条青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46998,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日高文斗招同诸公登浮粟","author":"释今无","text":"野色秋光满，亭高客望先。\n酒香茶盏缓，日煖菊花鲜。\n身世存微虑，山河带暮烟。\n不因佳节序，难得到名泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":46999,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别李旸谷","author":"释今无","text":"谪宦南溟远，难为送别心。\n鬓毛愁自短，乡思感何深。\n剑怯龙泉号，声存太古音。\n谁犹轻世态，握我泪沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47000,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别王九如 其一","author":"释今无","text":"海势居然远，相看此共深。\n世人论交态，惟子许初心。\n独日窥行色，疏星散别襟。\n无言亦不可，愁绝为知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47001,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别王九如 其二","author":"释今无","text":"有酒君且醉，醉来语话长。\n天性此时见，离情各自伤。\n萤微飞易远，霜薄气难当。\n不是无期别，山云信渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47002,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁孝廉敦五公车北上辱书见辞诗以送之 其一","author":"释今无","text":"对月高怀策，开缄念远行。\n征裘万里色，岭树九秋声。\n綵笔丰城气，虬珠合浦明。\n知君鹏举志，原不为时名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47003,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁孝廉敦五公车北上辱书见辞诗以送之 其二","author":"释今无","text":"君家旧簪笏，似舅岂云虚。\n事业旧麟阁，文章新石渠。\n芦沟匹马外，御苑惠风纡。\n遥忆飞花处，何人念倚闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿汪水部汉翀 其一","author":"释今无","text":"道交君若此，相看岂计年。\n薤丛频自绿，桃实静还鲜。\n衣舄乘云久，襟期对月悬。\n茂陵书著就，潇洒一儒仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿汪水部汉翀 其二","author":"释今无","text":"金盘浮玉液，五日得先沾。\n觉性閒犹在，时情老自严。\n门容乞士到，迹共野云恬。\n万古春光满，殷勤为一拈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送余立人归江宁寿其尊人余澹心","author":"释今无","text":"塞上书归日，吴门雪落时。\n言寻高士宅，远共白云期。\n流水逢游子，吟诗得白眉。\n柳条兼鹤算，持赠慰庭帏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答陈乔生","author":"释今无","text":"十年未相见，随处见君诗。\n食檗心常苦，看山眼独疲。\n片云清竹院，骤雨涨鱼池。\n每想同居士，谈禅及此时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿张进若","author":"释今无","text":"已饱烟霞气，犹餐日月芒。\n骑驴疑制纸，叱石可成羊。\n鬓绿春江水，文凌朔漠霜。\n痴龙珠一粒，小劫未为长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄贺吕明府宸铭","author":"释今无","text":"仙郎异绩成，清操彻玉京。\n犊留淮土重，凫坐邺侯轻。\n人爵青云蔚，天姿白雪明。\n行当入参政，雅量复相惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47010,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郑襄孙归安肃","author":"释今无","text":"上客邯郸至，炎天粤峤归。\n路长裘马旧，心壮水云肥。\n木叶催高树，征帆挂落晖。\n相逢几回笑，禅意赠君微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47011,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿刘内史奇公","author":"释今无","text":"大业千秋在，灵椿八百高。\n堂深天外雪，风壮海门涛。\n烛为娇歌艳，觞传鹤羽劳。\n名香吾欲祝，髣髴听云璈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47012,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠李婉若","author":"释今无","text":"冰霜骨自健，经史性生成。\n每爱临风语，常期过寺行。\n暗花绚梦笔，爽气阔秋城。\n何必玄晖辈，山僧始有名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47013,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈焦源还山阴","author":"释今无","text":"曾领苍梧部，今归庾岭风。\n声名人口里，事业鬓丝中。\n高论真难得，清操道已穷。\n兰亭一盂水，迟我暮年逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":47014,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]