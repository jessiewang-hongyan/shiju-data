[{"title":"送曹能始还闽中（各拈古诗一句，分赋七体，以次成篇）分赋得李白诗湖清霜镜晓","author":"王嗣经","text":"归客金陵道，霜帆梦镜湖。\n天秋水衣敛，海曙日轮孤。\n幔卷波纹縠，舟凌露藻珠。\n潮平光稍白，风定浪还无。\n清映冰花薄，澄涵锦树铺。\n鸟来分水碧，人去乱汀菰。\n贺监风流在，临风酹一觚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5890,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中集清凉寺送梅子马赴楚曹能始还闽","author":"柳应芳","text":"客路东西莫厌长，七闽原自隔三湘。\n离人不道俱千里，一夜相思梦两乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5891,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬别二首 其一","author":"梅蕃祚","text":"楚客怨青蘋，吴侬爱紫莼。\n扁舟难共载，羞杀渡江人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5892,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"人日送范东生还吴澹然之燕 其一","author":"臧懋循","text":"客居还送客，人日更愁人。\n江树停残雪，沙禽赴上春。\n笙歌吴苑酒，裘马雒京尘。\n相念不相共，音书空复频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5893,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"人日送范东生还吴澹然之燕 其一","author":"柳应芳","text":"无端人日胜，兄弟对离觞。\n草霁遥开色，梅寒细作香。\n江猿含北思，塞雁系南行。\n欲共临歧送，春波两岸长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5894,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"人日送范东生还吴澹然之燕 其一","author":"王嗣经","text":"共沾人日醉，那谓客程分。\n早树呼莺友，晴沙恋雁群。\n梦交南北路，情作去留云。\n管取秦淮柳，连枝好赠君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5895,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"臧晋叔希林阁赋得雨中钟山春望 其一","author":"柳应芳","text":"春早城东连骑来，雨中延眺北山隈。\n气衔远岫朝初合，阴结重林昼未开。\n融雪并沾驰道柳，和风争落寝园梅。\n雕窗不闭朱帘卷，坐待晴光陌上回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5896,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"臧晋叔希林阁赋得雨中钟山春望 其一","author":"王嗣经","text":"风光帝里入韶年，紫阙丹山霁景悬。\n绕禁柳容开羽葆，傍陵岚翠结炉烟。\n催花气暖先蒸雨，消雪岩空渐迸泉。\n曾是高皇布时令，至今犹自发春偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5897,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"臧晋叔希林阁赋得雨中钟山春望 其一","author":"程可中","text":"天成云阜扆宸居，东望春回王气余。\n浅碧露痕经烧后，嫣红随意着花初。\n波纹卷縠冰还裂，山黛如鬟树自疏。\n一自文皇迁鼎后，至今辇道未曾除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5898,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得千山红树送姚园客还闽 其一","author":"柳应芳","text":"萧萧浅绛霜初醉，槭槭深红雨复然。\n染得千林秋一色，还家只当是春天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5899,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得千山红树送姚园客还闽 其一","author":"潘之恒","text":"秋岸繁华景，红霞万树春。\n西风无限意，吹尽送归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5900,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得千山红树送姚园客还闽 其二","author":"潘之恒","text":"落叶萧萧路，秋风湖上波。\n到家红树少，不怨客愁多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5901,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得千山红树送姚园客还闽 其一","author":"陈邦瞻","text":"江南九月霜暗飞，秋光春色两依稀。\n万树欲丹疑湿雾，千山如醉带斜晖。\n画史含情拂轻缟，解作秋妍秋不老。\n自识晴云慕锦林，莫疑赤烧连衰草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5902,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得千山红树送姚园客还闽 其二","author":"陈邦瞻","text":"此时游客正天涯，此际离肠忽忆家。\n听绝啼莺娇映绿，愁看飞鹜齐落霞。\n闽天杳杳接江路，酒罢送君从此去。\n想得遥窥荔子丹，尚疑题叶销魂处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5903,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得千山红树送姚园客还闽 其一","author":"王嗣经","text":"秋山何处无红树，君归独向秋山去。\n霜锦千章照客衣，林霞一片随行屦。\n几曲云林到武夷，幔亭高处坐题诗。\n南天气暖无冰雪，直到春花忆此时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5904,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柳","author":"杜大成","text":"千株杨柳翠逶迤，袅袅烟丝风细搓。\n莺啭市桥牵客思，马嘶官道促骊歌。\n水边腻欲堆金缕，花外轻堪度玉梭。\n汉苑隋宫俱寂寞，古堤草满夕阳多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5905,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书愁","author":"杜大成","text":"愁多奈可度残春，浮世荣枯总未真。\n细雨梦中憔悴质，落花影里寂寥人。\n山僧乍见仍怜瘦，野鹤长随不厌贫。\n独抱遗经卧空谷，恐妨容鬓涅缁尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5906,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次陈荩卿生辰述怀","author":"方登","text":"不屑投时好，年光寄薜萝。\n著书人借读，种竹鸟飞过。\n有兴诗筒满，无钱酒债多。\n丹枫与湖水，相映醉颜酡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5907,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"顾懋高移居","author":"方登","text":"卜筑城隅地，无营闲读书。\n移花红雨堕，洗竹翠云新。\n帘卷迎初燕，樽开款故人。\n闭门题句好，未是虎痴贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5908,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚坐","author":"方登","text":"日入群动息，萧然坐草堂。\n树暝晚烟合，花收夕露凉。\n白发催年暮，青灯照夜长。\n林端新月出，松影过邻墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5909,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自述","author":"方登","text":"人生各有志，而今得遂初。\n但挥池上墨，不简案头书。\n山云茶屋暖，海月竹窗虚。\n香巷多芳草，春风吹敝庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5910,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偶成","author":"方登","text":"昼长山更寂，无客到柴扉。\n诗成一叶落，酒醒孤云飞。\n推窗竹子瘦，把钓鱼儿肥。\n参透穷通理，谁言吾道非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5911,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋晚","author":"方登","text":"秋晚行堤上，书声在茅屋。\n月出不逢人，风来弄修竹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5912,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日漫兴","author":"方登","text":"悬岩绝壑春云满，亭子无人鸟自啼。\n昨夜雨飞寒未解，桃花零落石城西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5913,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立秋后夜起见明月","author":"胡宗仁","text":"深夜见明月，渐低西南隅。\n光华射虚檐，照我床头书。\n开函见细字，历历如贯珠。\n老眼未能读，惆怅坐庭除。\n风生梧叶鸣，光景殊萧疏。\n昨方入秋序，清凉便有余。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5914,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄鸟日来啼","author":"胡宗仁","text":"黄鸟弄美响，日啼檐间树。\n檐树多佳阴，覆我庭前路。\n主人懒出门，坐卧送宵曙。\n若云此中非，黄鸟亦应去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5915,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓闻寒鸟兼呈远客","author":"胡宗仁","text":"霜林栖鸟冷，曙听语檐间。\n争盼朝暾出，移羽就其暄。\n篱外犬忽吠，有客至我门。\n问客何能早，云从远道还。\n命仆烧松火，炊黍慰劳烦。\n而我尚慵卧，见客生愧颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5916,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闲居寄友","author":"胡宗仁","text":"家住青溪曲，春深花竹迷。\n君来若相问，直过石梁西。\n屋壁峰阴合，门篱槿叶齐。\n萧然半迂事，课水灌园畦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5917,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"林茂之新居","author":"胡宗仁","text":"客舍何常定，三年迹屡迁。\n今来营一室，形胜石门前。\n地僻幽岩列，池平野水连。\n知余日相过，短榻不须县。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5918,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岁暮送姚园客自白下往吴越","author":"胡宗仁","text":"逼岁难禁出，白门犹客中。\n寒生夜山雪，晴卜曙江风。\n花落竹堂静，烟消石屋空。\n并州望音信，莫久滞邮筒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5919,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜坐","author":"胡宗仁","text":"篝灯常独坐，瀹茗与摊书。\n残月半窗白，寒星彻夜疏。\n不眠增昼短，延漏惜冬余。\n此意自终古，中怀未忍虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5920,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"园家","author":"胡宗仁","text":"茅屋野人家，种桑还种麻。\n翠畦飞乱蝶，红药报孤花。\n苏旱望新雨，卜晴占暮霞。\n闲时留客坐，酒向坞西赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5921,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春晚喜晴","author":"胡宗仁","text":"高树风疏欲散阴，坐来爽气渐能深。\n渚云乍去犹拖水，山月初生不过林。\n有鹤日闲眠古石，无人时到抱清琴。\n明朝双屐寻芳去，花坞乘春看翠岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5922,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻乌","author":"胡宗仁","text":"乌声谁喜闻，日啼白门树。\n愁来删树枝，认得白门路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5923,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻蛩","author":"胡宗仁","text":"秋夜寒蛩语，凄凄孤月明。\n空床自难寐，不但百愁生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5924,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"坐月","author":"胡宗仁","text":"明月为我至，终夜与徘徊。\n犹恐双扉启，清光欲去来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5925,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"桃叶曲","author":"胡宗仁","text":"桃叶渡头桃叶春，家家桃叶斗妆新。\n不知何处初来客，未省吴姬会笑人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5926,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊行","author":"胡宗仁","text":"每出幽寻杖短藜，无穷胜事惬幽期。\n村村野老柴门里，日对云山自不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5927,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮烟","author":"胡宗仁","text":"送客归来息树根，萧疏枫叶掩柴门。\n暮烟未即全遮眼，犹露桥西一两村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5928,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊行","author":"胡宗仁","text":"郊原负杖趣无穷，洞壑阴深细路通。\n村雾浓来时变雨，江云飞处忽成风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5929,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨后","author":"胡宗仁","text":"阴阴春日暖风轻，新水溪湾到岸平。\n宿雨湿山深树暗，夕阳开浦远山明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5930,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"茂之乞画楚山图余将游武林走笔戏答","author":"胡宗仁","text":"片帆已挂晓须开，无奈游情日与催。\n欲画楚山青万叠，待余行看越山来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5931,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上看山","author":"胡宗仁","text":"江上看山分外青，更怜山畔有云行。\n因之认熟桥西路，孤杖无劳藉友生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5932,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨夜宿王孟起山庄话旧","author":"张正蒙","text":"山堂闻夜雨，隔牖洒长松。\n渍草悲蛩语，浸苔冷鹤踪。\n林喧和叶下，涧响杂村舂。\n不倦连床话，怜君意转浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5933,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日卧病溪上怀饶士骏","author":"张正蒙","text":"偃卧青溪上，闲愁入病中。\n露华侵夜簟，风子落秋桐。\n白白千丝鬓，哀哀四壁蛩。\n所期乘兴客，孤棹几时通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5934,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东郊","author":"张正蒙","text":"东郊栖息久，老至谢逢迎。\n秋雾沉山白，寒流拍岸清。\n葛巾还自正，茅屋不须营。\n小摘畦边菜，常留共友生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5935,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立秋夜溪闻笛有怀程孺文","author":"张正蒙","text":"相思意不尽，迢递且登楼。\n玉笛梅花夜，银床梧叶秋。\n开帘片月上，傍水一萤流。\n今日萧条色，怜君万里游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5936,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日王孟起山庄","author":"张正蒙","text":"天末商飙起，家家闻捣衣。\n砌虫经候响，篱豆及秋肥。\n自是机心息，宁知世事违。\n邻僧有高致，日暮扣岩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5937,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"溪上秋思","author":"张正蒙","text":"穷巷故人少，衡门暇日多。\n凉风时着树，衰叶欲辞柯。\n生事只如此，幽心谅匪它。\n乃知溪上乐，把酒对渔蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5938,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秣陵馆夜对张山人","author":"张正蒙","text":"秋风山馆夕，一榻近灯前。\n共话忽深夜，相看非少年。\n斗垂天末树，磷出雨余田。\n亦有茅檐下，饭牛人未眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5939,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日卧病","author":"张正蒙","text":"隐几荒斋寂，深知偃卧情。\n新方随药简，久病喜秋清。\n掩径流云色，穿林响叶声。\n无人见惆怅，白发一重生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5940,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上早起有怀侯师之","author":"张正蒙","text":"江流无日夜，客路渺东西。\n雾接寒潮上，天连晓树齐。\n闻虫思寂历，过雁惜书题。\n何日长干道，烦君驻马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5941,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"溪上","author":"张正蒙","text":"自识茅茨趣，风光合在兹。\n柳青春雨润，山白晓云迟。\n幽意居偏得，闲身懒更宜。\n忘机溪上鸟，来往日无期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5942,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日即事有怀黄任甫","author":"张正蒙","text":"开门凉气入，默默坐移时。\n积雨逢初霁，斜阳照短篱。\n交秋桐落早，闰月菊开迟。\n朋好遥相忆，清尊何所期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5943,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬日闲居二首 其一","author":"张正蒙","text":"僻居心远矣，闭户日萧然。\n一水带寒月，孤村幕夕烟。\n贫惟尊酒在，诗岂众人传。\n却忆蒙庄子，冥搜内外篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5944,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬日闲居二首 其二","author":"张正蒙","text":"夜永衾孤拥，檐深月半窥。\n霜村鸡唱早，风树鹊栖迟。\n旧社嗟摇落，新诗记别离。\n挑灯坐不寐，无梦到天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5945,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日杂咏","author":"张正蒙","text":"孤村秋雨暗，万井暝烟迷。\n邻杵时飘响，林鸦不住啼。\n茅茨惭野老，灯火对山妻。\n因笑病庄舄，空劳楚执圭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5946,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江阁","author":"张正蒙","text":"寂寂重扉掩，悠悠倦客情。\n江深当五月，阁迥接层城。\n细雨莺声润，微风水气清。\n科头坐长日，讵羡世间名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5947,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏至对雨柬程孺文","author":"张正蒙","text":"堂开垂柳下，默默坐移时。\n岁序一阴长，愁心两鬓知。\n雨檐蛛网重，风树雀巢欹。\n惆怅无人见，深杯空自持。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5948,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初夏园林即事","author":"张正蒙","text":"夏入园林好，欣逢霁景明。\n药阑香醉蝶，柳岸绿迷莺。\n道在心逾逸，情闲迹自清。\n夕阳红欲尽，一抹暮山横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5949,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春暮淮上遣兴有怀恩公","author":"张正蒙","text":"水漫秦淮旧钓矶，一竿每与俗情违。\n垂垂密柳莺啼早，寂寂重扉客到稀。\n绿暗桑林蚕叶老，青连药圃兔苗肥。\n焚香欲就蒲团坐，钟磬沉沉隔翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5950,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"溪上居","author":"张正蒙","text":"小结衡茅避市喧，寒流觿觿抱孤村。\n扉悬白板心犹远，几隐乌皮道自存。\n傍岸渔舟分爨火，倚窗明月引开樽。\n寂寥何限幽栖意，不识风光似陆浑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5951,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"溪閤坐雨招胡国珍陈用甫二丈","author":"张正蒙","text":"背郭衡门迥，栖迟一径幽。\n隔帘风挟雨，虚阁晚生秋。\n水鸟日堪狎，村醪客可留。\n不嫌成简略，烦为过溪头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5952,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日移居六首 其一","author":"周晖","text":"只隔秦淮路，清幽与市分。\n溪声数番雨，鹤梦几重云。\n古研临池洗，名香扫石焚。\n客来方坐定，鸟语恰殷勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5953,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日移居六首 其二","author":"周晖","text":"蹇士何须赋，幽人不厌寻。\n有时忽大笑，无事只长吟。\n闻道晚知浅，结交贫觉深。\n涧边芳草色，消尽一春心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5954,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日移居六首 其三","author":"周晖","text":"负郭久无田，幽居仅数椽。\n绿尊堪累月，青镜不藏年。\n客至渔樵半，狂来笑语偏。\n周颙有猿鹤，尚在北山颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5955,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日移居六首 其四","author":"周晖","text":"垂柳绿依依，烟萝护竹扉。\n酒醒双燕语，病起乱花飞。\n绣涩芙蓉剑，轻便薜荔衣。\n转因贫与懒，渐觉昔年非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5956,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日移居六首 其五","author":"周晖","text":"最怜佳丽地，萧散惬幽情。\n不著《潜夫论》，无求处士名。\n莺啼催小饮，鹤步伴闲行。\n欲结村中社，题诗报友生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5957,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日移居六首 其六","author":"周晖","text":"春风花事过，空翠落垂藤。\n白版扉常闭，鸟皮几独凭。\n半酣疑有得，多病掩无能。\n一室何萧索，分明似野僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5958,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬日杂兴二首 其一","author":"周晖","text":"失路无知己，青山是可人。\n高僧留半偈，侠客笑长贫。\n开口哭何事，掀髯怪此身。\n只因错料事，寂寂老乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5959,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]