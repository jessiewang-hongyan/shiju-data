[{"title":"送江比部视广东学","author":"王世贞","text":"久羡江淹笔，仍扳陆贾车。\n别怀唯尔赋，新论是谁书。\n鸠署残星外，羊城明月初。\n岁寒须自保，鸿雁正愁予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初秋独游张园五首 其一","author":"王世贞","text":"小筑谢公墅，东邻习氏池。\n野夫还一造，秋暑忽何之。\n过雨添新瀑，悬崖逗晚飔。\n莓苔任沾湿，长啸坐支颐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初秋独游张园五首 其二","author":"王世贞","text":"景物乡心在，诗篇病骨苏。\n流霞散醽醁，飞雪破雕胡。\n日月行双镜，乾坤自一壶。\n抚膺予稍适，朋旧未堪呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初秋独游张园五首 其三","author":"王世贞","text":"海外戎王麦，风前石国榴。\n火珠红乍吐，栗玉翠还浮。\n物自频堪摘，人胜几度游。\n雕栏太平里，曾是曲阳侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初秋独游张园五首 其四","author":"王世贞","text":"席绮千门月，台阴百尺松。\n园林私野色，邸第改秋容。\n卤莽时人赏，飞扬我辈逢。\n且须?一醉，湖海战心浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初秋独游张园五首 其五","author":"王世贞","text":"季子慕奇尚，少文耽卧游。\n生平骄尔辈，端合置沧洲。\n此地适相遇，新篇高自酬。\n遂令林泉表，时见云霞流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答明卿 其一","author":"王世贞","text":"自汝移金马，风尘日更悲。\n一身饶抗疏，万事寄论诗。\n青史名谁定，朱弦调转疑。\n宦情非不薄，天地去何之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答明卿 其二","author":"王世贞","text":"国步群才后，天威百战间。\n衣冠衔宠过，兵革置身艰。\n高议宁排闼，微名且抱关。\n即论杯酒外，何物暂开颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立秋夕与明卿过子相 其一","author":"王世贞","text":"久自淹烦暑，科头兴不赊。\n相携九秋色，一醉故人家。\n节序频深警，文章各未涯。\n谁将宋玉辨，付尔楚狂誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立秋夕与明卿过子相 其二","author":"王世贞","text":"清尊玳瑁发，高馆湛卢鸣。\n且黜人间语，凭骄秋外声。\n异时心竞折，流俗态相惊。\n回首驱公事，纵横任两生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"时事有感 其一","author":"王世贞","text":"闻道三吴血，犹腥大海涛。\n运筹人自异，推毂帝频劳。\n白羽军符峻，黄金甲第高。\n普天嗟玉石，吾计屈蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"时事有感 其二","author":"王世贞","text":"娇小私相命，牵衣哭路傍。\n几时堪翠靥，何物是红妆。\n綦履春风薄，掖庭秋夜长。\n尧年如有赖，微质等朝霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送交河簿徐生","author":"王世贞","text":"婆娑淹圣世，偃蹇寄微官。\n立马滹沱夕，鸣琴大陆寒。\n汝才宁尉足，古道向人难。\n枳棘中原在，风尘稍自安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐","author":"王世贞","text":"清秋思不极，掩卷坐沉吟。\n自决浮生计，谁探异代心。\n物情穷可见，吾道拙相寻。\n不为存骚雅，曹刘岂至今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜","author":"王世贞","text":"砧杵关心甚，篝灯引寐迟。\n不才余自恕，未老世频移。\n星斗疏堪摘，天河莽下垂。\n喧喧渐车马，兹意欲看谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顾舍人使金陵还松江","author":"王世贞","text":"汝岂因鲈脍，吾曾识凤毛。\n青云归暂得，白雪和谁高。\n海色钟山雨，秋声笠泽涛。\n南征有诸将，为语圣躬劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜过明卿分韵","author":"王世贞","text":"万柝秋声傅，千门月色摇。\n楚吟频诮凤，吴语乱争枭。\n物议安余薄，时才益尔骄。\n生平一尊酒，落魄累清朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即席分韵送肖甫","author":"王世贞","text":"高会几人共，潸然问所之。\n吾曹殊未已，世路渐难期。\n词赋云霄阔，经纶日月欺。\n三巴还百濮，姓字仗谁知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"骤寒","author":"王世贞","text":"久自安絺绤，俄惊挟纩催。\n暴雷收未稳，骄霰突如来。\n喜怒高天迸，焦枯下土摧。\n稍闻誇燮理，吾道但堪哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即席赋得梨分韵无字","author":"王世贞","text":"汉广偶萍实，南中饶木奴。\n上林还见品，大谷未全无。\n高露屑金掌，寒冰飞玉壶。\n长卿故游倦，消渴暂应苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜明卿见过迟子相不至适陆秀才之裘来小饮分韵 其一","author":"王世贞","text":"谁堪同夜色，客有尚风尘。\n斗酒月中醉，寸心天外陈。\n薄游归黯淡，小语破沉沦。\n吾眼饶青白，容他礼数嗔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜明卿见过迟子相不至适陆秀才之裘来小饮分韵 其二","author":"王世贞","text":"对坐乌皮几，何来白角巾。\n诗篇宁尔道，尊酒亦吾人。\n总未妨知己，居然念所亲。\n岂应狂简外，别自有雷陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬子与 其一","author":"王世贞","text":"汝去愁真宰，新诗就不难。\n岂因兵计折，翻仗世途安。\n鼎足谁先下，琴心且自弹。\n要盟一寸地，矫首蓟门寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬子与 其二","author":"王世贞","text":"伦辈宁狂者，诗篇好问之。\n千秋何尔态，万象岂余私。\n左袒青云夺，中原白日垂。\n可关儿女计，嚄唶受人悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬子相考功","author":"王世贞","text":"宴坐尚书省，时才屈指中。\n西来李襄国，不数汉扶风。\n名岂缘吾大，人今向尔工。\n莫令湖海上，寥廓见冥鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜报国寺明卿见访有作","author":"王世贞","text":"别思诸天尽，临岐但冁然。\n片云依锡住，残月借灯传。\n施客盂兰饭，逢僧贝叶编。\n醉馀还更酌，吾意未逃禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠大川上人","author":"王世贞","text":"白马归来后，经翻定几篇。\n向承西竺问，宁印北宗传。\n转梵天音合，降心佛日偏。\n不须寻圣谛，与尔各随缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上","author":"王世贞","text":"偶为湖上酌，已异城中觞。\n自失凫鹥暇，时来花草香。\n更衣报寒食，立马爱斜阳。\n复指从西去，祗园春正长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"约于鳞游西山不至","author":"王世贞","text":"就约神飞动，青云未易窥。\n岂无堪并马，只是自吟诗。\n物态吾宁薄，山灵尔向知。\n转应疑夙昔，风雨太行期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与于鳞别二三子即席分韵","author":"王世贞","text":"不辞杯酒醉，山水尽君操。\n去住他人并，行藏异代劳。\n中原莽星斗，大陆骤风涛。\n尚有刀环色，能令汉日高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吕光化","author":"王世贞","text":"遇尔何称病，凄然自越吟。\n五噫明世事，三刖盛年心。\n故旧绨袍晚，文章布褐深。\n同车有中散，不惜奏瑶琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"王世贞","text":"驿使书相问，愀然不可禁。\n吞声微禄过，削迹畏途深。\n主父千金口，龙阳百岁心。\n野人何所道，归钓楚江阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏鹰","author":"王世贞","text":"群族宁妨汝，睢盱动杀机。\n决云寻嗜去，惊电逐呼归。\n风雨扶衡击，乾坤纵饱飞。\n亦知终鼎俎，辛苦为谁肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余以使事出至蓟门时事大变明卿被谪 其一","author":"王世贞","text":"岂谓边陲远，风光到自嗟。\n帝京新世事，郎署旧天涯。\n傲骨穷堪长，狂名晚更加。\n任他车马地，风雨向人誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余以使事出至蓟门时事大变明卿被谪 其二","author":"王世贞","text":"诗自先生事，名劳异日论。\n众看真长物，老至惜空言。\n河岳西来转，星辰北望尊。\n尔曹知有尽，那可不销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余以使事出至蓟门时事大变明卿被谪 其三","author":"王世贞","text":"除目无劳问，时才滚滚过。\n积薪吾意远，推毂物情多。\n不尽青云色，何来大海波。\n故园有丛桂，怜尔正婆娑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余以使事出至蓟门时事大变明卿被谪 其四","author":"王世贞","text":"倏忽精灵变，浮生未可几。\n向知愁贝锦，谁复记牛衣。\n雨露宁荣悴，风云各是非。\n斐然二三子，戒尔盍言归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答子相考功","author":"王世贞","text":"变后书相问，仓皇拭泪看。\n物情殊恍忽，吾道转艰难。\n蜂目无劳睨，蛾眉敢自安。\n荧荧夜光在，莫使照人寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子与有使事赋此问之","author":"王世贞","text":"汝屈辞官计，犹衔奉使荣。\n但伸明主法，无害小臣名。\n风雨骄难问，江河幸未争。\n独馀愁病客，春色老边城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"明卿由给事外谪贻书见报怅然有答","author":"王世贞","text":"怪尔缘狂谪，书来转更狂。\n一官任湖海，十口厌文章。\n后进吾俱畏，浮名众亦妨。\n不须歌九辨，春雪满三湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔阳有怀于鳞却寄 其一","author":"王世贞","text":"春郊望不尽，飞动意难禁。\n地转漳流阔，山连蓟日深。\n安危吾长物，贫贱尔初心。\n薄俗宁无畏，高斋且细吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔阳有怀于鳞却寄 其二","author":"王世贞","text":"莫问除书意，风尘彼一时。\n折腰君自若，鞅掌我何辞。\n客计深怜晚，诗名未易卑。\n吴门耦耕地，烽火受人疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻谮 其一","author":"王世贞","text":"薄谮元非假，高名敢遽攀。\n未归惭地下，且住看人间。\n湖海藏烽色，云霄递客颜。\n五噫何敢咏，挥手出燕关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻谮 其二","author":"王世贞","text":"故旧纷相谓，狂名得已迟。\n卿仍用卿法，吾更爱吾诗。\n枉责元龙礼，虚劳惠子疑。\n吴山青片片，或恐妒归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"骤雨","author":"王世贞","text":"急雨至无赖，高风吹未停。\n苍茫归一气，歘忽走千灵。\n禾耳不愁黑，麦芽无限青。\n乾坤应自若，其奈入沈冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吊故李北平广","author":"王世贞","text":"闻道匈奴骑，犹惊飞将锋。\n马蹄终自老，猿臂欲谁封。\n得一中原重，无双异代容。\n长令草间镝，霜色满卢龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"王世贞","text":"战地穷胡粤，谋臣出汉廷。\n乱离人厌日，疏放客能星。\n禄薄凭相弃，歌深且自听。\n中山酒太恶，三载又劳醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿昌平寺中","author":"王世贞","text":"招提西郭外，邀我暂披襟。\n一雨汰行色，诸天回住心。\n僧来探小品，吾欲老丛林。\n莫问津梁意，人间道路深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上谷杂咏 其一","author":"王世贞","text":"十万嫖姚骑，纵横大漠旁。\n至今闻瀚海，不敢道杨王。\n铁劵埋秋雨，金戈卧晓霜。\n抚髀人自急，高冢下牛羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上谷杂咏 其二","author":"王世贞","text":"尚忆谭家马，骄嘶紫塞中。\n王庭愁汉月，边羽快秋风。\n一战人谁得，孤城地已空。\n不知麟阁上，寂寞渐谁功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上谷杂咏 其三","author":"王世贞","text":"海内兵戈遍，兹方可晏然。\n生儿恒守舍，与鬼不分年。\n马失来时道，雕盘战后天。\n城中七万户，箫鼓旧喧阗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上谷杂咏 其四","author":"王世贞","text":"彍骑名非少，司农日不供。\n黄金仍道路，白羽转从容。\n自昔乘春障，何人念夕烽。\n饱飞诸节度，宁羡彻侯封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孟夏上谷署中梦客携商山四皓图令余赋之","author":"王世贞","text":"尚忆商山聘，千秋卧未深。\n兵戈留地肺，羽翼转天心。\n衰矣紫芝咏，惜哉黄鹄吟。\n岂应龙变化，来去杳难寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病 其一","author":"王世贞","text":"病岂长途事，仍劳药饵扶。\n未饶诗寂寞，且厌酒模糊。\n入塞身初属，论兵气未苏。\n犹闻羽书至，战血满三吴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病 其二","author":"王世贞","text":"羽檄成兹病，人间药物赊。\n纵归犹是客，小憩暂为家。\n世事老难必，吾生愁未涯。\n欲从询上帝，浩荡斗间槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜遇子相城西同宿 其一","author":"王世贞","text":"遇尔不自意，骤回双眼青。\n立谈过深雨，把酒尽残星。\n此夜真同醉，明朝又独醒。\n亦知吾道在，那敢怨飘零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜遇子相城西同宿 其二","author":"王世贞","text":"天地事何限，风霜吾自雠。\n如何三月别，顿尽百年愁。\n未易蛾眉老，何当骏骨留。\n停鞭又挥手，斗气浅幽州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"碧云寺逢王元肃","author":"王世贞","text":"岂谓招提境，逢余万里归。\n故人歌出塞，游子泪沾衣。\n烽火垂成劫，衣冠未息机。\n去留俱不可，执手意翻飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答于鳞 其一","author":"王世贞","text":"向来怜影意，岂谓欲腾骧。\n吾党无中驷，君才老太行。\n别筵人又改，借箸策谁长。\n莫作悬车问，浮沉总不妨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答于鳞 其二","author":"王世贞","text":"为问长安态，纵衡日与新。\n好龙兼废似，应马遂为真。\n但自称知己，相留让众人。\n乘桴余敢后，沧海浩无津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄潘德元","author":"王世贞","text":"十上书空就，荷衣太识君。\n倦游谗白雪，多路薄青云。\n客况难深语，乡书渐怯闻。\n还应赋秋兴，或可慰离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨后河间道中","author":"王世贞","text":"驱传稍出郭，川原郁菁葱。\n初晴树犹雨，薄暮蘋自风。\n鱼鸟俱有造，云霞一何工。\n澹然忘其往，宁悲途路穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自安州改陆泛小艇趋保定即事五首 其一","author":"王世贞","text":"岂谓驱车地，长年问鄚州。\n席回风四面，珠迥月中流。\n剩室新鲛杼，危城隐蜃楼。\n鸣榔更伊轧，顿起故园愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自安州改陆泛小艇趋保定即事五首 其二","author":"王世贞","text":"旷望天无际，能令客思醒。\n雨拖双柱白，山抹半螺青。\n小酌扶吟啸，孤帆破杳冥。\n如何未摇落，飞叶洒风汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自安州改陆泛小艇趋保定即事五首 其三","author":"王世贞","text":"大泽昼多雾，北风天又阴。\n坐围山似发，看远树如簪。\n倏忽渔樵计，艰危道路心。\n怪来听鼓枻，稍类越人吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自安州改陆泛小艇趋保定即事五首 其四","author":"王世贞","text":"高原出残黍，雨色似蒹葭。\n搔首云徐叶，回桡浪欲花。\n鱼龙更故宅，蛙黾竞生涯。\n银汉翻应浅，难呼使者查。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自安州改陆泛小艇趋保定即事五首 其五","author":"王世贞","text":"万壑中原汇，诸方泽国迁。\n急流趋割地，远势拍兼天。\n真宰何儿态，冯夷又帝权。\n未须惊野哭，甲子是尧年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书怀 其一","author":"王世贞","text":"燕雀将风甚，蜩螗计日吟。\n眼衰频入态，发短不胜心。\n黯淡安争席，徘徊罢鼓琴。\n故园戎马意，萝薜太难禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书怀 其二","author":"王世贞","text":"节序流萤色，风尘病客杯。\n壮怀依事改，衰鬓先年来。\n自忍穷途味，翻悲异代才。\n微官去不果，众毁任相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]