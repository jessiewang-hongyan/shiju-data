[{"title":"与方侍御步天宁寺分韵得松字","author":"王世贞","text":"为惜招提近，扶醒信短筇。\n回风争万铎，落日逗孤松。\n禅语时时得，秋山处处供。\n祗怜方侍御，犹有皂囊封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王和仲还吴","author":"王世贞","text":"黄金空插汉，词客岂雄飞。\n铗忆何门是，绨怜旧侣非。\n秋山双骨立，沧海一身归。\n若过烟霞地，为余扫钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新城道中","author":"王世贞","text":"马首今何适，萧然爱此身。\n夏霖迁古道，秋色佐归人。\n稍觉黄沾柳，时看白点蘋。\n任它风雨态，不解令伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滕县作","author":"王世贞","text":"齐楚今何在，滕犹旧日名。\n浮云双战地，落日一空城。\n野旷犹堪井，山贫自不争。\n遗编二策在，终是鲁书生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送虚白上人主竹塘寺","author":"王世贞","text":"去住元无系，师今定若何。\n坐推狮子吼，塔许雁王过。\n白社经翻早，青山锡占多。\n已知香积供，难少病维摩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄明卿使君再觐 其一","author":"王世贞","text":"述职诸侯礼，梯航可厌频。\n峥嵘仍岳牧，偃蹇似波臣。\n梦入钧天旧，恩沾湛露新。\n如逢明主问，莫拟汉家薪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄明卿使君再觐 其二","author":"王世贞","text":"汝厌承明后，于今两报功。\n请歌诸国乐，谁似七闽风。\n霜益鱼符老，天开象魏雄。\n明堂当计吏，第一是吴公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹子会试 其一","author":"王世贞","text":"罢醉枫桥酒，乾坤别自轻。\n如云偕计吏，捧日向承明。\n不必论三献，无何遂一鸣。\n平津晚来贵，曾是鲁诸生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹子会试 其二","author":"王世贞","text":"紫极春将动，黄河冰自开。\n请看题柱者，谁是斲轮才。\n剑暖初辞匣，金寒旧筑台。\n甘泉倘有赋，圣主受釐回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠方子还里","author":"王世贞","text":"不谓文园侣，柴门趁病身。\n将军无揖客，故国有归人。\n调忆朱弦旧，愁催白发新。\n奚囊数行在，知汝未全贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海浮子自滇归迂驾过访值余他出怅然因赋此寄怀","author":"王世贞","text":"十载诗相忆，乾坤鬓共苍。\n岂期中散驾，来自宠王乡。\n凤不题蓬荜，星虚聚草堂。\n何时蒜山翠，花雨对传觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送龚大理出教授严州二首 其一","author":"王世贞","text":"小史轻儿掾，诸生爱郑虔。\n掷他廷尉牍，还我广文毡。\n月冷铜官阁，云分石佛泉。\n好将孤剑气，高并客星悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送龚大理出教授严州二首 其二","author":"王世贞","text":"千峰建德合，一水桐庐流。\n白简翻相为，青袍可自由。\n门因问字启，客爱解颐留。\n倘逐羊裘钓，知君有直钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"倦酒","author":"王世贞","text":"春山何限青，春酒日冥冥。\n旧社能相命，清时渐爱醒。\n高斋亲药裹，镇日检茶经。\n纵有刘生颂，睢盱不要听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐广文先生过饮","author":"王世贞","text":"即看春事速，忍使赏心违。\n白首时情见，青衫旧德稀。\n催来花竞手，藉罢草沾衣。\n最爱斜阳外，扶藜缓自归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送僧归摄山","author":"王世贞","text":"诸方参欲尽，始悟买归航。\n祗是心堪了，原无法可将。\n雨侵江令石，云据远公房。\n惟有春来后，居然花草香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"久旱得雨","author":"王世贞","text":"枯已吾苗甚，愁深岁事论。\n疾雷翻地轴，飞汉写天门。\n鼓楫幽从诣，为农道转尊。\n寄声诸父老，一饭亦天恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顾季狂见过狂谈竟月於其行也诗以赠之 其一","author":"王世贞","text":"双眼中原合，初从故国开。\n雌黄月旦口，雄白古今才。\n碣石将天去，巴江引雪来。\n嗒然吾隐几，尔辨亦悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顾季狂见过狂谈竟月於其行也诗以赠之 其二","author":"王世贞","text":"久矣墙东避，俄惊羊仲从。\n一贫诗作祟，百战舌为锋。\n汝自谈非马，吾宁好似龙。\n祇应抛麈尾，杯酒日从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乞归不允 其一","author":"王世贞","text":"罢归安计拙，衰至怯恩深。\n自饮终天泪，谁伸去国心。\n一官堪屡掷，千载欲平沈。\n见说箕山畔，云霞未易寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乞归不允 其二","author":"王世贞","text":"风尘何意味，物色到山家。\n麈尾聊须掷，羊皮敢向誇。\n出真成小草，得亦是空花。\n陵谷须臾事，吾生未可涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题赠徐常甫卷后","author":"王世贞","text":"知君是通隐，赏藻亦吾曹。\n节自披裘著，名因结袜高。\n一经元汝在，三管欲谁操。\n旧有南州榻，春风共浊醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上别杨都督瞻美子念道振诸君","author":"王世贞","text":"此别不成远，如何挥涕频。\n酒分南北路，身是去留人。\n兰省羁难弟，柴门立老亲。\n十年高枕在，那忍付风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日赵司农刘水部邀游云龙山放鹤亭同子与赋 其一","author":"王世贞","text":"地属黄楼守，樽开画省郎。\n大风来芒砀，飞壒捲河梁。\n鹤不归残照，人今醉异乡。\n冯栏一翘首，天地渐苍茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日赵司农刘水部邀游云龙山放鹤亭同子与赋 其二","author":"王世贞","text":"帻为登高岸，亭因眺远孤。\n河流天不尽，山色雨频扶。\n千古双雄略，中原一病夫。\n阮生广武叹，感慨亦吾徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十五夜济宁池亭别子与","author":"王世贞","text":"月自中秋满，人从此会离。\n由来最圆夜，翻是欲亏时。\n玉魄斜穿树，金波细溢卮。\n清光转应好，脉脉待看谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中山道中","author":"王世贞","text":"一笑复一嚬，此来宁系身。\n少为强项吏，老作折腰人。\n与醉中山酒，聊偷故国春。\n浮云天北在，瞻眺欲伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余旧游魏郡日有双鱼之馔今绝不可得问之则河徙故也戏成一章","author":"王世贞","text":"十载叨游魏，双鱼馔事宽。\n鸾刀催霰舞，象箸压霜寒。\n沧海欲陵陆，黄河能钓竿。\n思归别有念，不借蒯缑弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阜平道中","author":"王世贞","text":"马足时陵竞，颠崖古道横。\n山从一涧坼，水夺两崖鸣。\n径路疑欲尽，人烟俄自生。\n夜深见灯火，三户是孤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与故关张将军谈旧事有感","author":"王世贞","text":"太息时才老，殷忧战地深。\n毋谈旧开府，吾听忽沾襟。\n卖剑中年事，伤弓此日心。\n唯应解严后，归钓五湖阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄寺署中偶成","author":"王世贞","text":"马纵知严解，鸦归觉讼虚。\n放衙居士服，隐几道人书。\n市远沽无酒，池清钓避鱼。\n一官何足忌，千载不关渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为戚都督乞教士","author":"王世贞","text":"寇盗忧三辅，安危咏大风。\n飞书玄菟塞，学剑白猿公。\n稍夺萑苻胆，宁希细柳功。\n干城念汝在，吾事五湖东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余携大名魏生至顺德复得二赵生论文日久酒间有赠","author":"王世贞","text":"二赵俱赵产，魏生复魏人。\n已欣照乘色，重以连城珍。\n再刖恒泣楚，完归翻过秦。\n沾沾余自得，不作暗投论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同年故刘侍御德纯枉驾行营对酌有感往事因赠刘戍穷边始归","author":"王世贞","text":"十年濒死境，两地倦游身。\n今日中山酒，真成隔世人。\n戍楼谈后月，野店醉馀春。\n最是堪留处，更筹何太频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秩满三载移牍有叹 其一","author":"王世贞","text":"踯躅今三辅，婆娑旧一官。\n原无出谷想，不验触藩难。\n下考吾能注，头衔自懒看。\n未须啼谢豹，物意总阑残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秩满三载移牍有叹 其二","author":"王世贞","text":"厌说青齐旧，依稀十二年。\n薄游鸡肋味，多难马蹄篇。\n故吏俱先达，斯文别有权。\n衰慈殊未悉，岂少太湖田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕张山人分韵是日有浙藩之报 其一","author":"王世贞","text":"除岁逢除目，寒归客未归。\n年华落日尽，节序少年非。\n得汝当蓝尾，惭予恋紫衣。\n那堪酩酊后，乡思独翻飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕张山人分韵是日有浙藩之报 其二","author":"王世贞","text":"浊酒那堪颂，椒花尔兴新。\n自怜迟暮意，初作量移人。\n云迫中原晚，霜含故国春。\n一年唯此夜，莲漏莫教频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张参议肖甫由广西入贺得书有寄","author":"王世贞","text":"已分鸿书断，谁凭驿使来。\n星从南极至，天向北辰开。\n王会干官礼，嵩呼万寿杯。\n君家金鉴录，况是曲江才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"礼部诸曹丈携尊万松庵","author":"王世贞","text":"把袂堪吾党，鸣珂起倦身。\n相逢散花地，俱是握兰人。\n薄酒交从厚，清言具不贫。\n春卿芳署里，自昔和阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答杨中丞伯谦时以巡抚山西移病归","author":"王世贞","text":"双鱼衔尺素，知尔贲丘园。\n一雨卷龙德，千烽骄雁门。\n赐环明主事，推毂异时恩。\n为问云台上，丹青谁更尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张尚宝叔养尚宝前御史以言事罢起按二辅尝首荐予","author":"王世贞","text":"霄汉重游地，风波百折身。\n一官新尚玺，三辅旧埋轮。\n霜色凌清禁，天颜许近臣。\n独惭虚剪拂，矫首属车尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过于肃悯公墓岁复为己巳公立大功之日距今两甲子矣","author":"王世贞","text":"正统逢今岁，边尘日暂蒙。\n乾坤三己巳，社稷一于公。\n不作青衣辱，依然黄屋崇。\n祁连赐冢地，石马汗秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入南屏山路","author":"王世贞","text":"一入南屏路，悠然与世疏。\n游人柳枝曲，禅客藕花居。\n暖气催鸣蛤，泉声跳伏鱼。\n双壶挂篮笋，佳处莫教虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"始访前奉化令徐徵君 其一","author":"王世贞","text":"避世虽君事，高名可遂忘。\n未过徐稚宅，虚表郑公乡。\n萝径春从覆，蓬门日转长。\n还应却卤簿，小艇共沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"始访前奉化令徐徵君 其二","author":"王世贞","text":"彭泽不爱酒，江州无奉钱。\n远山将入供，残日佐谈玄。\n坐徙空庭晷，凉生高树蝉。\n指君东壁挂，借我北窗眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"始访前奉化令徐徵君 其三","author":"王世贞","text":"小筑城南地，诛茅苦未齐。\n还闻绿萝馆，幽托白云栖。\n别岫宽猿宿，空林恣鸟啼。\n无心隐大小，随意迹东西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜与惟敬浮玉岛饮","author":"王世贞","text":"山色深於染，湖光澹却无。\n地真排玉案，人似入冰壶。\n莫倚珠崖广，还怜碣石孤。\n布帆看不尽，幽兴自吾徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄皇甫子循佥事","author":"王世贞","text":"籍甚时名在，翛然晚境长。\n五言唐大历，群从鲁灵光。\n白苧多新曲，青袍少旧行。\n近闻宽胜事，箫鼓出横塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"季俸不至而故人日有来者戏成一章","author":"王世贞","text":"官閒去乡近，罢案且婆娑。\n家酿饮垂竭，旧书看易过。\n庭乌公事少，檐鹊故人多。\n尽自堪藏拙，其如负进何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠杨二先辈","author":"王世贞","text":"韦门经是业，荀氏德为星。\n勋烈开鳣座，诗书自鲤庭。\n蝉联三绶紫，雁序一衫青。\n好就河东赋，吹嘘入帝廷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孙鸿胪於群从中官薄而诗佳授予满卷因成以赠","author":"王世贞","text":"亦知群从贵，眉白转怜渠。\n掾岂一言得，名应第五如。\n镜湖宽赐沐，禹穴纵紬书。\n谁辩郊居字，新篇定启予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病骥","author":"王世贞","text":"病骥从他赎，依然去服箱。\n已知无伯乐，何必要田方。\n舞枥贪飞将，呼刍忆大荒。\n人间原未识，天上宿为房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄少卿刘翁世龙","author":"王世贞","text":"万死孤忠在，千秋一疏遥。\n主恩留大耋，天意见清朝。\n泌水犹堪乐，绵田肯受招。\n中兴有奇事，金紫听渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴兴杂兴十首 其一","author":"王世贞","text":"倦骨风流减，清时月旦新。\n湖山堪卒岁，案牍动移旬。\n拙宦甘除目，虚名苦趁身。\n此方色犹菜，忍说郡厨贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴兴杂兴十首 其二","author":"王世贞","text":"卤莽天心过，萧条国士知。\n一官堪自免，再出竟何为。\n粝饭供残牍，篝灯助小诗。\n不烦期马革，端合号鸱夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴兴杂兴十首 其三","author":"王世贞","text":"接天唯白水，不枉唤湖城。\n桑月宴游少，茶山租税轻。\n秋冰瀹莼菜，晴雪鲙鲂羹。\n出入青油舫，真成画里行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴兴杂兴十首 其四","author":"王世贞","text":"为嫌十口累，伴影独寒灯。\n出暂呼官长，归仍似野僧。\n得来那一实，受处亦无凭。\n莫拟讴谣赠，身今少爱憎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴兴杂兴十首 其五","author":"王世贞","text":"吴兴古名郡，宦路亦清幽。\n苕冷尚书社，蘋稀刺史洲。\n地偏朝事绝，俗美寓公留。\n独愧乌程酒，虚名似督邮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴兴杂兴十首 其六","author":"王世贞","text":"湖山閒即出，风雨却归来。\n薄宦终诗草，藏名是酒杯。\n折腰斯世责，揽鬓异时才。\n物意吾能解，毋烦白简催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴兴杂兴十首 其七","author":"王世贞","text":"旧事停车得，遗风掌故传。\n鱼租钓台渚，火耨疁山田。\n乌鬼秋常放，蚕姬夜不眠。\n唯惭讼庭内，不得施蒲鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴兴杂兴十首 其八","author":"王世贞","text":"寄语诸乡曲，清贫好自誇。\n山田供老母，月俸上官家。\n荡口携来酒，天池寄得茶。\n止赢苕岘胜，饱看不为奢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴兴杂兴十首 其九","author":"王世贞","text":"掩卷将何道，凄其归思浓。\n名微真马走，官拙自龙钟。\n岁月辞何峻，乾坤老渐容。\n浮云众鸟去，落落一高松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴兴杂兴十首 其十","author":"王世贞","text":"上书知不报，解绶且谋归。\n嚄唶堪巾帼，婆娑忆布衣。\n酒如清渭水，莼似北山薇。\n薄晓诗名贱，于今未忍挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武林遇李太仆归省有赠 其一","author":"王世贞","text":"车从都何甚，风尘意不关。\n文宁狗监贵，官是马曹閒。\n薄有莼鲈兴，那因桂玉还。\n青门四明客，早晚向仙班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武林遇李太仆归省有赠 其二","author":"王世贞","text":"閒客平津邸，仍游七子场。\n歌成迁幸舍，赋上谢赀郎。\n天自游燕近，山从入剡长。\n云霞护青雀，送汝过钱唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送阃帅狄君入贺万寿","author":"王世贞","text":"庚午王正月，嵩呼万国同。\n波臣上金鉴，天子宴彤弓。\n仙露回颜紫，卿云挟绶红。\n还应柏梁和，骠骑有雄风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周恭人悼亡 其一","author":"王世贞","text":"婉丽兼三德，辛勤佐一官。\n即知丹茀好，曾断素机寒。\n桂魄销何易，兰魂返更难。\n那堪悼亡鬓，此夜欲如潘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]