[{"title":"感秋","author":"潘光统","text":"高楼独上海天长，枫叶芦花自水方。\n一夜新凉催白雁，几家残杵隐清霜。\n才名落落心难系，世事悠悠鬓易苍。\n南国只今频羽檄，可堪鼙鼓满渔阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古 其一","author":"潘光统","text":"辛苦驱驰瘴海滨，逢厓遗恨欲沾巾。\n田家义士宁臣汉，鲁仲高风不帝秦。\n井澳旌旗空落日，平章波浪尚愁人。\n千秋喷薄淩霄汉，犹是英雄气未申。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古 其二","author":"潘光统","text":"祥兴国脉仅奄奄，海上奔亡自景炎。\n万里何人归马革，九渊无地挽龙髯。\n心存死难应千折，事去焚香更一拈。\n尽瘁共怜三相国，慈元依旧对宸严。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄文德承","author":"潘光统","text":"岞崿高且长，云霞带修陆。\n间有神仙人，悠然在空谷。\n高视轹今古，修词媲坟竹。\n中年结冥契，遐音赠金玉。\n侧身日长望，戚戚转颦蹙。\n兴言欲奋飞，沉吟徒踯躅。\n庭前有芳兰，绿叶散清馥。\n白露已成霜，灼灼黄金菊。\n采之遗所思，将以写心曲。\n路远莫能致，馨香自结束。\n轩车不可驱，四顾成局促。\n出门见飞鸿，掩洟缄尺牍。\n愿为云端月，流照入君屋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕陈忠甫见过夜话 其一","author":"潘光统","text":"天涯惊巧夕，乡国兴情增。\n旅食同僧饭，翻经借佛灯。\n高梧初索莫，西岭转崚嶒。\n羞涩囊空尽，何堪在五陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕陈忠甫见过夜话 其二","author":"潘光统","text":"物候催残暑，飘零得旧游。\n双星河汉夕，一叶蓟门秋。\n缮性依禅室，归心忆钓舟。\n绮纨非所好，宁敢傲王侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和黎职方冬至日别梁舍人还朝","author":"潘光统","text":"岁晏离心苦，含情对绮筵。\n尊开南至日，帆送北征船。\n鸿雁江天杳，梅花驿路妍。\n分襟从此去，心折五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎惟敬携酒见过迟董述夫张来聘诸子不至","author":"潘光统","text":"延益开轩待，清歌爱客听。\n馀寒犹腊雪，疏树带春星。\n世事堪长啸，才名忌独醒。\n美人期不至，明月自中庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洪光寺","author":"潘光统","text":"桂薪怜上国，瓢笠访东林。\n阅树知僧腊，拈花见佛心。\n素书犹未授，白发忽相侵。\n已悟无生理，微官任陆沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏同黄益作从叔干周舍弟肇恩儿豫集梁仲登别馆得稠字","author":"潘光统","text":"愁病思朋好，言从河朔游。\n闭门烟水阔，远树暮云稠。\n岸帻初逢夏，披襟恍似秋。\n著书穷亦得，岂为赁舂留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋望","author":"潘光统","text":"粤王楼阁引飞峦，别苑离宫草树残。\n正朔已非秦日月，朝台犹忆汉衣冠。\n风生禾黍樵歌歇，秋入关河夜柝寒。\n閒倚青萍时极目，不知何处是长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日同欧桢伯过诃林访邓毓元梁彦国","author":"潘光统","text":"严霜昨夜掩苍苔，竹院萧然一径开。\n持律欲寻支遁去，谈禅真为戴颙来。\n花宫日落催寒磬，莲社人归问酒杯。\n吟眺已忘山路远，兴随烟月放歌回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜过海珠寺","author":"潘光统","text":"雪残江上水如天，重过空门一系船。\n小隐欲寻中阁去，閒身先借上方眠。\n裁诗夜乞翻经火，煮茗寒分供佛泉。\n满眼风尘欺短鬓，无如初地学参禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和张山人苏给事厓山十咏","author":"潘光统","text":"厓门峭削半侵天，亡国遗踪倍可怜。\n云树尚疑宫扇影，海氛犹似御炉烟。\n珠襦埋没空山里，玉殿荒凉逝水前。\n一自翠华流落后，至今陵木怨啼鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游蒲涧因过鹤舒台","author":"潘光统","text":"丹灶烟销掩绿苔，求仙何处访蓬莱。\n阜乡亭下空遗舄，蒲涧泉边尚有台。\n鹤驭已随龙驷去，青山还倚白云开。\n衰颜最忆神楼散，一匕谁分入酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春同邓君肃陈垣卿黄幼章陈士鹄梁仲登集黎惟仁山楼","author":"潘光统","text":"晴窗閒共蹑丹梯，一览诸峰万木低。\n孤磬响闻天井外，残莺声送夕阳西。\n泉分石涧聊堪煮，酒有邻家不用携。\n十载青藜曾共对，故人今已直金闺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饯叔宝约游罗浮答诗促之","author":"潘光统","text":"萧条无地散离忧，何处风烟是虎丘。\n远道莫酬青玉案，尺书犹到白蘋洲。\n云停岭树频翘首，月满江城各倚楼。\n闻说南来求大药，山灵先已候罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花赋别赠黎惟仁之京","author":"潘光统","text":"离亭歌罢促征鞍，白首交情作别难。\n词赋人推题柱客，江湖天远钓鱼竿。\n尊中竹叶三冬暮，岭外梅花一骑寒。\n却笑清时招骏晚，高台今始筑长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同杨祠部懋功游摩诃庵","author":"潘光统","text":"红尘十万入招提，花木阴阴可杖藜。\n三径风烟人世外，五陵秋色帝城西。\n青山欲共深公买，翠竹多逢阮籍迷。\n一卧云房心便息，更从何处觅丹梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕过黎惟敬宅守岁","author":"潘光统","text":"风尘冉冉岁华徂，傲吏归心寄五湖。\n旧社曾同开竹径，异乡犹得共屠苏。\n杜陵三礼年迟暮，燕市千金事有无。\n洛涘已知成拙宦，李膺元自忆莼鲈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集梁思伯宅送黎惟敬得空字","author":"潘光统","text":"北岳云山望不穷，离心何处托飞鸿。\n金茎气色绯烟外，碣石旌旗落日中。\n前席旧承宣室召，出关今值虏尘空。\n即看万国来包匦，不羡葡萄入汉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卢允传同过舍弟肇恩野人庐","author":"潘光统","text":"烽烟何处散幽忡，共向幽居访桂丛。\n繁影阶移青竹日，微凉池泛绿荷风。\n閒看世事浮云外，老寄诗名浊酒中。\n试问当筵词赋客，清才谁复似卢鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳前一日过欧崙山馆中谈西樵之胜分韵得风字","author":"潘光统","text":"华馆淹留歌伐木，孤城砧杵度新鸿。\n客谈半夜当筵月，谁共明朝落帽风。\n云谷秋深泉更白，天湖霜冷叶初红。\n烟霞十里期难赴，雅约何年得再同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伤春","author":"潘光统","text":"物候半春色，飞花带雨愁。\n重杨千叶密，独鸟一声幽。\n简出缘多病，忘机久狎鸥。\n十年空落落，万事只悠悠。\n身贱谁青眼，时危自白头。\n干戈横郡郭，生计且渔舟。\n偃蹇功名薄，蹉跎岁月流。\n朋游多赤牍，吾道合沧洲。\n价远黄金骏，歌还白石牛。\n言寻商岭曲，行问富春裘。\n雪调偏难和，明珠耻暗投。\n泥涂宁久辱，晚岁感能收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺怨","author":"潘光统","text":"幽人畏人知，深闺独闭时。\n莫令秋月入，照见妾空帷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登楼望海上战舰","author":"潘光统","text":"旌旗海上飐寒烟，南北伤心有岁年。\n莫道少陵多涕泪，鼓鼙今日是秦川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小除夕郭乐周小酌舟中","author":"潘光统","text":"簌簌寒风霜满林，数株疏柳暮烟沉。\n黄河日夜波声急，不似思乡一片心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"横槎小隐和潘西畴韵","author":"叶春芳","text":"野色映湖芳，行藏付一航。\n按琴看鹤舞，把酒对鸥尝。\n景外尘寰远，吟边岛屿长。\n昔人曾市隐，谁道是真狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登谢惕斋处处台","author":"叶春芳","text":"清时谁信有遗才，卜筑幽居处处台。\n变态风云难点缀，忘机鸥鸟任徘徊。\n诗从象岭千峰出，花向丰湖十里开。\n堪笑西湖老居士，谈玄讲易也时来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端午夕宿峡江饮同舟诸子","author":"黄砻","text":"客路怜佳节，鸟飞留篆沙。\n茅柴扣野店，笑语惊林鸦。\n拚醉心犹醒，放歌帽欲斜。\n莫言蒲馔恶，星斗落孤槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次七级","author":"黄砻","text":"春水何消闸令为，柳边幸有酒家旗。\n呼童甫买他乡醉，又被东风当面吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入陜忆故园","author":"萧敬德","text":"晓发孤帆暮未收，微风吹度陇西头。\n山含韦曲连村静，水绕函关泛月流。\n蝶梦夜频归故国，鸿声时复报新秋。\n闻道潮阳正征战，捷书何日到商州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村行","author":"黎天启","text":"初离青荔浦，即到绿蘋滨。\n缓屐随群鸟，閒亭得主人。\n松阴抽野菜，竹叶脍江鳞。\n风俗犹馀古，云中拟结邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"于村路寻得江岸幽处","author":"黎天启","text":"石绕村坳一径斜，又沿芳草出江涯。\n烟生积水欲为雨，风到閒枝亦作花。\n僧带野云归古寺，鸟衔山翠落人家。\n川源有路皆仙隐，好向渔翁买钓槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和茅少溪寓会城次杜宪使韵","author":"林大章","text":"单车南海驻江城，景色行边水月明。\n几处楼台三岛迥，万家杨柳一川平。\n长安日近鸾书焕，粤岭天高鹗影横。\n翘首朗宁瞻郡政，讴歌应似此方情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"廓然楼和次峰韵","author":"林大章","text":"孤屿楼高峙碧天，人间风景正堪怜。\n山开翠璧排千嶂，水引长江注百川。\n驻马曾留刺史节，梦槎重系使君船。\n仙踪石上今犹古，一度登临一纪年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春游即事","author":"林大章","text":"閒携鸠杖出林皋，几伴同穿鹤氅袍。\n野兴为耽山水趣，道情犹带酒诗豪。\n禅关僧结缘中果，仙路人看洞口桃。\n邂逅更逢流水客，弦声松下泻春涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和伍抑斋用韵","author":"林大章","text":"半幅寒衾一卷毡，昔年挑过岭云颠。\n亦知悃愊非时好，难作脂韦取世怜。\n回首烟霞逢道侣，寄情水月伴吟仙。\n与君采采南山蕨，胜却当时愧俸钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夕写怀","author":"林大章","text":"园林昨夜拂清飙，银汉秋高玉宇寥。\n月下有怀诗共约，山中无事俗全消。\n金风自与群芳遍，玉露还将百卉凋。\n闻说西郊仙境近，杖藜应去一逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和白沙先生菊花","author":"林大章","text":"紫艳初移自涧滨，幽怀更对白纶巾。\n楚云别去遥相忆，欲折寒香寄远人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和白沙先生菊花","author":"林大章","text":"重阳菊绽九江滨，彭泽风清独岸巾。\n千载又开庐阜径，秋英还遇古今人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"廓然楼和次峰韵","author":"林大章","text":"胜游正拟暮春天，清兴犹堪点也怜。\n祇为古今同乐事，便携朋辈到晴川。\n登楼望处云连树，倚棹歌时月满船。\n仿佛舞雩风韵在，不知今昔是何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和白沙先生梅花","author":"林大章","text":"寂寂山斋远俗尘，疏梅时对静中人。\n无言已解天机妙，况露春痕几点新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题樾墩书屋","author":"林大章","text":"白鹭洲前碧水湾，谁开风景异人间。\n江心地夹双乔树，海上波浮一点山。\n天设画图堪赏胜，书储今古足怡颜。\n扁舟嘉会无多路，正属江门第一关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟蔡琰北归","author":"罗见麟","text":"寥落中郎后，残生窜殛馀。\n惊看南过雁，羞逐北旋车。\n莫按胡奴伯，犹传魏主书。\n身名终莫赎，千载恨单于。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漂母祠","author":"罗见麟","text":"一饭相怜良不易，千金为报更何难。\n天生豪杰终扶汉，谁在尘埃豫识韩。\n阿母淮阳祠貌古，王孙云梦主恩残。\n登台一掬伤心泪，洒向西风木叶乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵自咏","author":"梁以蘅","text":"一径萦回上翠微，琼楼高拥万山围。\n携琴客去常悬榻，问字人来或叩扉。\n山静依稀闻叶落，天空迢递见鸿飞。\n长安车马多岐路，倦鸟投林且自归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚至平望驿欲行阻风有怀吴中所知","author":"梁以蘅","text":"江云漠漠水迢迢，去越孤舟逐浪摇。\n微月尚堪乘晚棹，回风故遣息寒桡。\n正思吴地人方迩，为问枫桥路岂遥。\n此夜客肠翻欲结，高栖几处莫吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新结小茅亭","author":"梁以蘅","text":"新结小茅亭，彷若在空翠。\n阒寂为柴门，竟日无人至。\n篁叶风萧萧，日夕更森邃。\n道经时一展，澹泊饶古意。\n野人性疏阔，颇与世人异。\n聊此避尘俗，亦是时共弃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和陈少参春日郊游","author":"梁以蘅","text":"野老从西挈榼来，山肴村酒一时开。\n也知此具元非恶，相对共成一醉回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答林南江二首 其一","author":"梁以蘅","text":"徙倚棂轩前，萧散更悽恻。\n凉风入我户，促织居我壁。\n诗节忽变迁，感此意何极。\n嗟我同心友，千里会一夕。\n握手初论交，不辨主与客。\n雅志慕古人，历历见肝膈。\n鲍叔欢在今，平仲何必昔。\n常恐大鹏飞，一朝复离析。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答林南江二首 其二","author":"梁以蘅","text":"世人竞多策，所挟皆九九。\n吾策良未售，遭时宜禁口。\n所得虽邱山，浮云竟奚有。\n胡然事干谒，自同台厮走。\n反性非自然，吾宁贫贱守。\n立德固有端，存诚真户牗。\n谁能秉孤贞，勉尔操持久。\n一为利所驱，彫丧先榆柳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉寄兄","author":"梁以蘅","text":"兄弟此为别，江山几度愁。\n猿啼千里夕，雁叫一声秋。\n颜色何因觅，音书仍未收。\n天涯共多难，别绪更悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遣怀","author":"梁以蘅","text":"十年雅意少相如，堪笑乾坤共索居。\n行乐忽逢欢有酒，弹歌休道食无鱼。\n天涯会见杨雄宅，案上惟馀老氏书。\n小槛凉风此时入，故园杨柳忆萧疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春访马嵩高草亭留饮","author":"梁以蘅","text":"步履寻春访草亭，东园嘉树蔼青青。\n忽闻席上娇歌发，时有枝头好鸟鸣。\n自是陶潜偏爱饮，何妨阮籍未全醒。\n即看日暖和风至，近拟提壶出近坰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜杂咏三首 其一","author":"梁以蘅","text":"久立候月出，有雨东南来。\n须臾天一碧，望见浮云开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜杂咏三首 其二","author":"梁以蘅","text":"玉露滴泠泠，竹竿垂袅袅。\n万籁空中寂，孤鹤云间矫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜杂咏三首 其三","author":"梁以蘅","text":"树影落新池，鱼行动碧树。\n有鹤掠人来，忽然乘风去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日同诸子兰亭宴集","author":"梁以蘅","text":"胜会不可常，良时耻幽独。\n今日天气佳，相与上林麓。\n历涧黄鸟鸣，随风幽兰馥。\n雨馀曲水流，泉声韵丝竹。\n念彼千载人，旷然遗高躅。\n今兹挥一觞，欣对亦自足。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感秋和钱紫山","author":"梁以蘅","text":"病客独吟江上山，卧看红叶对柴关。\n风来已觉桃笙冷，雨过惟馀苔藓閒。\n堂上虫声喧坐榻，城头月色照沙湾。\n少年许国心犹在，感叹于今鬓欲斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨晴过小圃","author":"梁以蘅","text":"园林旬始涉，秋径水潺湲。\n积雨欣初霁，凉风吹远天。\n寒山含夕照，孤竹霭馀烟。\n暂息茅亭下，醉吟疏柳前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄东郭子","author":"梁以蘅","text":"日出泛南塘，怅然望东郭。\n天长一鸟飞，金陵树漠漠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题黎氏隐居","author":"梁以蘅","text":"闻道幽人卧草庐，衣冠曾是昔贤居。\n闭门已有潜夫论，负郭宁无长者车。\n静扫落花随晚径，閒看流水傍秋渠。\n兰台金匮幽求尽，还觅人间未见书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游小金山","author":"吴广","text":"飞崖突立郁中洲，四壁霞光拥玉流。\n须信业林真别岛，始知尘世总浮沤。\n鱼因听偈频依藻，鸟为忘机故近舟。\n自笑烟霞终有分，将谁骑鹤共遨游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊达奚司空次苏应机原韵 其一","author":"陈仕俊","text":"岂知流落送生涯，肠断归帆去转赊。\n晓望可堪迷旧国，夜台谁信是真家。\n精魂已化三生石，幽恨还成百结花。\n并与胥涛同积忿，海门朝夕自声嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]