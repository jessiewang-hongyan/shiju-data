[{"title":"得同亭杂咏 其七","author":"霍与瑕","text":"无事太从容，清宵坐得同。\n好风来桂圃，明月照藜涌。\n林影筛衣碎，花香入酒醲。\n莫歌丛桂树，人在小山东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和区逵鸿见示村居之作 其一 东庄","author":"霍与瑕","text":"行乐复行乐，东游得此庄。\n逢春多逸兴，近水有幽香。\n绿柳风初暖，青梅味可尝。\n冰山成的事，何处问金张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和区逵鸿见示村居之作 其二 南圃","author":"霍与瑕","text":"夏日过南圃，榕阴接地苍。\n草亭还可坐，石榻不胜凉。\n荔子缘堤熟，荷花隔水香。\n更多幽赏伴，渔艇系垂杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和区逵鸿见示村居之作 其三 西园","author":"霍与瑕","text":"闭关谢尘鞅，静见古人风。\n野水浮鸥碧，丛林结子红。\n烟花供我老，文字送谁穷。\n新酿秋来熟，千杯作圣中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和区逵鸿见示村居之作 其四 北径","author":"霍与瑕","text":"一径青林外，孤村绿水间。\n寒梅欺雪白，乌桕落风丹。\n莫以严凝候，而生憔悴颜。\n管灰吹厚地，天道有循还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明月吟赠两湖黄都督北归 其一","author":"霍与瑕","text":"明月出东岑，松梢散远阴。\n光连沧海玉，影碎碧波金。\n隔水望无极，高秋寒不禁。\n旧知千里别，悽断百年心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明月吟赠两湖黄都督北归 其二","author":"霍与瑕","text":"浔州山阁外，一见识英奇。\n兵法传司马，军心乐子仪。\n等威隆外阃，声望震边夷。\n看看麒麟上，腰间未止犀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"明月吟赠两湖黄都督北归 其三","author":"霍与瑕","text":"元戎上玉京，驱马迅长征。\n筹定百蛮服，戈挥五岭清。\n人安儒将雅，天借福星明。\n十载瞻承惯，无因可报琼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆弟","author":"霍与瑕","text":"青山莺转初，翠竹护离居。\n人远八千里，吾衰六十馀。\n五云仍北望，三月又春徂。\n寂漠无俦侣，时耘荒圃蔬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送叶养直归龙山 其一","author":"霍与瑕","text":"多艺复多材，公真焉学来。\n屠龙空有技，附凤乃无媒。\n岁月催人老，烟花到处开。\n两京将走遍，孤剑独徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送叶养直归龙山 其二","author":"霍与瑕","text":"水村借宁宇，远近浥英标。\n盗似逢鹯雀，人称逼鼠猫。\n网罗兼众技，箫管亦多娇。\n草泽遗雄骏，弓旌谁为招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送叶养直归龙山 其三","author":"霍与瑕","text":"西石终吾隐，东皋与尔登。\n笑谈花底坐，丝管竹间腾。\n羊仲联三径，龟书抵十朋。\n年来閒讨论，时得问多能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送叶养直归龙山 其四","author":"霍与瑕","text":"篆隶侵西汉，图书映泰阶。\n五星悬指掌，千岁坐推排。\n直道离弦矢，清标倚壑梅。\n德滋知裕后，丹桂已根荄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶题","author":"霍与瑕","text":"同亭存石磴，古木亦清幽。\n永日未徂暑，凉风暗递秋。\n蓟北音书断，填南羽檄稠。\n杞人头半白，且得卧沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"升平乐","author":"霍与瑕","text":"缺月出东山，鸡鸣人度关。\n平安争趁市，歌啸振清湾。\n米惯三钱价，衣誇五裤斑。\n知是贤侯在，闾阎免苦艰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋前二夕闻歌","author":"霍与瑕","text":"近秋风气好，入夜暑微消。\n女伴歌声合，娥眉月影娇。\n密林时落叶，曲涧远通潮。\n光霁渺无极，谁同倚玉箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"括易送中丞滕少松公祖陟留都 其一","author":"霍与瑕","text":"九五当乾驭，黄裳被冕旒。\n天风申巽命，昼日接康侯。\n锡马膺藩宠，从龙展壮猷。\n即看交泰合，雷雨满皇州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"括易送中丞滕少松公祖陟留都 其二","author":"霍与瑕","text":"十载不家食，天衢观国光。\n包鱼知硕量，射隼著锋芒。\n井井宏经济，乾乾日赞襄。\n大君宜有命，三锡倍辉煌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"括易送中丞滕少松公祖陟留都 其三","author":"霍与瑕","text":"含章承帝宠，资斧镇南中。\n蹇蹇王臣节，谦谦君子衷。\n后庚新积习，先甲振颓风。\n我自窥观者，欣瞻衎食鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"括易送中丞滕少松公祖陟留都 其四","author":"霍与瑕","text":"包荒匡泰运，凭河属上公。\n蔚文腾变豹，仪羽翊飞龙。\n鼎耳资铉壮，王庭羡栋隆。\n定知裁辅烈，丰日永当中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"括易送中丞滕少松公祖陟留都 其五","author":"霍与瑕","text":"需郊开祖帐，旅觯盍朋簪。\n怅望违铉玉，无因繫柅金。\n贯鱼茅拔汇，鸣鹤子和阴。\n倘束丘园帛，如兰尚可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侍甘泉师谒四贤祠 其一","author":"霍与瑕","text":"百代真儒共此祠，溪蘋涧藻具威仪。\n三香手献烟如缕，一脉心传道若丝。\n古洞浮岚青霭霭，山堂芳草绿依依。\n春深风月无人领，渺渺微躯谁与归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侍甘泉师谒四贤祠 其二","author":"霍与瑕","text":"高山千载瞻前哲，庭宇经营信有心。\n门户森然廊寝异，阶除宛似奥堂深。\n虹垂两涧清殊派，屏展诸峰碧万寻。\n终古秉彝应不泯，同祠配享匪斯今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻甘泉师翁游南岳归志喜","author":"霍与瑕","text":"只影天南无伴侣，九旬两度下西泷。\n壮年风韵今犹是，良夜月明歌更长。\n衡岳白云添五色，江门清派满三湘。\n湖南豪杰多能者，衣钵今归何处乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄何麓池临江通府","author":"霍与瑕","text":"不侍巾函叶几凋，音书疏断水迢迢。\n百年夏日多离别，三叠秋风空寂寥。\n细柳湾中怜泽丽，寒梅岭外苦天遥。\n逢人若问三城迹，薇蕨春肥暂侣樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题月塘","author":"霍与瑕","text":"绿水满塘春更好，四时有月秋偏光。\n塘因得月塘踰静，月为临塘月倍良。\n塘月几宵人剧饮，月塘千里我怀将。\n何时重酌塘边月，一曲高歌月下塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈章山参政见示咏雪佳作奉和 其一","author":"霍与瑕","text":"夜檐滴沥已全消，晓看西天复乱飘。\n半是云花半是雨，亦迷烟树亦迷桥。\n不妨远路坭途滑，赖有东山屐齿高。\n寄语天边青女使，邯郸遗步颇称牢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈章山参政见示咏雪佳作奉和 其二","author":"霍与瑕","text":"春来玉女行春令，碎剪瑶花落九天。\n河汉有云连水岸，江南无地不风烟。\n樵夫阻冻晨撑户，钓叟凌寒晓拂船。\n山郭寂寥无的事，偷閒高枕且安眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈章山参政见示咏雪佳作奉和 其三","author":"霍与瑕","text":"历乱痴云雪更扬，狂风回舞庭中央。\n疑非杨柳何多絮，似是梅花祇少香。\n人在水晶仙界里，鹤栖蓬岛玉山阳。\n良时好景真无价，谁伴高贤举兕觥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六月姚江舟中","author":"霍与瑕","text":"山阴寄迹馀旬日，宦海归帆已挂秋。\n瘦梦不成银汉落，清风徐到夜江悠。\n展禽自分安微秩，楚客何因赋远游。\n堪笑狂夫狂似旧，今人犹唱古时讴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊丈亭寄翁见海中丞 其一","author":"霍与瑕","text":"去岁招携过小亭，一冬景物可幽情。\n为寻方外烟霞侣，却值人间月旦评。\n笑语移时疑俗态，溪山千古订新盟。\n自怜野鹤身常瘦，只影凌风天外行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊丈亭寄翁见海中丞 其二","author":"霍与瑕","text":"孤松山畔影亭亭，有客盘桓独抱情。\n古瑟自传流水调，新诗应与国风评。\n且看云雨膏中野，肯把寒泉忘旧盟。\n半醉将来天欲晚，寥寥远道少人行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜九弟闭关结伴苦学","author":"霍与瑕","text":"忽惊时序迅轮回，长啸东风立晚台。\n花影渐稀春事足，书声何处夜窗开。\n论文当日饶高手，渴睡经年愧腐才。\n知尔从来骨相别，故寻仙侣上天台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青梅闺怨","author":"霍与瑕","text":"懒把蚕桑对夕晖，倚门长望每依依。\n半山红照日将晚，一树青梅郎未归。\n无限风光春满院，不胜幽恨月盈扉。\n逢人试问渠消息，犹自江头醉石矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜立春 其一","author":"霍与瑕","text":"东风早见送青牛，南市烟花更满楼。\n玉树丹霞春浩浩，碧灯明月思悠悠。\n冰壶一色真仙界，珠海何人结胜游。\n分付仙郎催鹤驾，凌空今夜到扬州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜立春 其二","author":"霍与瑕","text":"沧海无波百卉苏，东皇分暖到明都。\n风光是处多佳丽，月色空中半有无。\n闹市轻烟横翡翠，通衢急管碎珊瑚。\n春灯春酒行春令，拚倒银缸一百壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜立春 其三","author":"霍与瑕","text":"元夜灯花何绮丽，迎春士女更婵娟。\n几回白眼偷怜玉，三绕青牛乱著鞭。\n月下偏携耽酒伴，杖头多带买花钱。\n晚街好处寻吾乐，肯把春风让少年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读莱轩感事之作走笔漫书","author":"霍与瑕","text":"从来春雨浃旬阴，何事伤春独苦吟。\n念载燕云徒浪迹，清时流水少知音。\n不龟自分澼絖手，搏虎早灰冯妇心。\n且趁雨馀勤种树，明年桑蔗或成林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀梁云端时连雨七旬矣云端西游三旬矣","author":"霍与瑕","text":"芳草凄凄古粤州，王孙何事太淹留。\n春风独赋桃花什，西水曾归一叶舟。\n到处江山新入眼，离居风雨故添愁。\n何时晴霁还相过，莫遣千红送乱流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登雨青楼","author":"霍与瑕","text":"巍然相府雨青楼，有客来登最上头。\n千里山河穷短目，几家烟火淡新秋。\n清谈自觉狂多谬，懒病祇凭酒暂瘳。\n回首北天重倚望，五云依旧护神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和韵送时庵陈子归广右","author":"霍与瑕","text":"芳庭对酌思沉沉，一幅琅玕万古心。\n碧海归舟云树远，东风回驭落花深。\n惜春漫作黄鹂调，恨别聊为白雁吟。\n知尔凤毛成五色，朝阳时复听徽音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻唐子妙阳出宪狱喜而赋此","author":"霍与瑕","text":"古今绝唱鹧鸪调，天地生成倚马才。\n十年龙剑埋丰狱，一夜鸾箫到史台。\n物外风光三岛月，掌中造化九天雷。\n好将南海神仙树，移向云边倚日栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎氏旌节荣奖 其一","author":"霍与瑕","text":"寒少衣裳饥少粱，青春茹苦守空房。\n三千世界贞心在，半百年华悲恨长。\n独鹤将雏窠朗月，慈乌傍母宿清霜。\n霜寒月冷秋风起，满院飘丹桂子香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎氏旌节荣奖 其二 代少石兄作","author":"霍与瑕","text":"戢翼鸳鸯正在梁，孤村寡妇一茅房。\n几穿葛屦秋风紧，独剪银灯冬夜长。\n清泪暗将添锦水，断魂何处堕明霜。\n天门此日开青眼，桂子兰花奕叶香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"走笔奉和陈唐山见怀之作","author":"霍与瑕","text":"十年浪迹始归樵，草径山堂故寂寥。\n影落清溪幽思足，梦残寒簟旧交遥。\n春风处处催啼鸟，野水家家趁插苗。\n好景好春须好伴，漫将鱼信寄春潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居奉答诗社列位老伯见怀之作 其一","author":"霍与瑕","text":"閒倚晴窗物色熙，三城音信近来稀。\n忽惊赵璧隋珠入，疑是阳春白雪飞。\n绿藓有文封断砌，金蝉初蜕振新衣。\n太平此地真诗社，端为诸公先启扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居奉答诗社列位老伯见怀之作 其二","author":"霍与瑕","text":"为寻佳胜趣偏酣，更向烟霞古洞南。\n小朵幽花临水岸，长条野葛护云庵。\n山中茹草群麋鹿，风外传笙几鹤骖。\n一味清真聊自适，不知人世有肥甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉怀弼塘尊师古林尊丈二首 其一","author":"霍与瑕","text":"清歌一曲思熙熙，唱入南山和者稀。\n老鹤高栖松桧稳，饥凫低趁稻粱飞。\n百年地步谁绳武，千仞冈头独振衣。\n自笑狂夫疏懒旧，三竿红日尚关扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉怀弼塘尊师古林尊丈二首 其二","author":"霍与瑕","text":"断魂芳草送春残，谁寄春诗自水南。\n杏树坛边新雨泽，梅花村里旧云庵。\n明时天际翔威凤，野老山中忆去骖。\n肯订翳门关上约，碧溪薇蕨有馀甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉怀素予刘尊师 其一","author":"霍与瑕","text":"三十年前此拜师，祇今风景尚依稀。\n春霭每随山上下，晚霞时与鹭低飞。\n松阴昼永风生袂，桂影秋深香染衣。\n兰水潼关龙起后，白云封尽旧柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉怀素予刘尊师 其二","author":"霍与瑕","text":"九龙曾忆侍巾函，歌向溪西复水南。\n十里清阴松引路，几家篱落草连庵。\n独宿自怜松顶鹤，廿年人断广州骖。\n应嫌风味山中淡，玄酒太羹淡亦甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦西北二江大水伤稼 其一","author":"霍与瑕","text":"清入西郊景色熙，无端新潦稻花稀。\n拍天巨浸兼潮涌，远浦归舟带雨飞。\n野水乱浮凫鸭阵，东风时洗鹭鹚衣。\n诘朝定有晴明日，且唱山歌掩晚扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦西北二江大水伤稼 其二","author":"霍与瑕","text":"经月阴霾势未残，冲烟聊尔过山南。\n盈科水碎无穷玉，断阵云迷几处庵。\n尽日东风扬远驭，浮天西潦阻归骖。\n涧底老龙眠正稳，不知霖雨是谁甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄家书南京偶题书缄","author":"霍与瑕","text":"年年天北递离忧，此日城西思倍愁。\n正拟封书凭雁翼，又逢挝鼓竞龙舟。\n乔椿锁翠皆无恙，棣萼舒红亦寡俦。\n一报安宁一惆怅，漫将情绪咽歌喉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和友竹见寄兼致谢怀 其一","author":"霍与瑕","text":"秋尽南郊阵阵风，微凉微暖万方同。\n招邀喜有高贤伴，掩霭何妨细雨濛。\n绿野天低阑槛外，朱楼人在画图中。\n清尊且罄瓶还续，夜半狂吟意未穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和友竹见寄兼致谢怀 其二","author":"霍与瑕","text":"急韵长篇字字微，八旬老子世间稀。\n九河远泻龙门水，三岛遥披鹤羽衣。\n入眼明珠何灿灿，挥毫和玉故依依。\n行春骢马春行乐，还许纶巾坐钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜饮孟两峰宅论学","author":"霍与瑕","text":"我亦樵西一草亭，引来秋水作围屏。\n孤山月朗心寥寂，千壑云深路杳冥。\n漫把清歌当酒唱，细传芳调与公听。\n高声夜半惊闻远，稍放低柔意愈平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕阴雨次日雷风更烈","author":"霍与瑕","text":"佳人脉脉更亭亭，閒倚轩辕作画屏。\n应为牛郎频隔岁，故将鸾镜掩空冥。\n天河泻恨云偏恶，风雨倾愁夜忍听。\n十二万年年一会，不知何事未能平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入三里同吴州守王县尹观凤化城二首 其一","author":"霍与瑕","text":"山为楼阁石为台，驱马登临首重回。\n野水横舟从客渡，好风吹雨过溪来。\n千年洞在人空老，几日春归花自开。\n感慨有馀新月上，一尊喜得两公陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入三里同吴州守王县尹观凤化城二首 其二","author":"霍与瑕","text":"夕阳车马到林邱，环眺荒城起远愁。\n人在右江仍入洞，节逢端午失操舟。\n山风次第吹云散，涧水当门带月流。\n浴罢童冠三两辈，细听榕下纳凉讴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿三里山家","author":"霍与瑕","text":"元公开府控西州，伐暴招携赖壮猷。\n八寨从风无吠犬，四山明月有啼鸠。\n星辰影淡银河静，海宇凉生玉露浮。\n画角五更催出洞，不知何日重来游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迁江道中偕陈尹月下","author":"霍与瑕","text":"小队灯笼引客行，丹山碧草染衣轻。\n绣裳三度来公子，白马多骄见后生。\n一路啸歌风韵雅，千峰光霁月华清。\n迁江此夜留篇咏，故事他年或者成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五月望日至雷塘大水始涸忆在邕州曾为李侍御言太阴犯毕豕将涉波今乃城市游鱼鳖也","author":"霍与瑕","text":"暮春三月侍邕州，漫说星文似可愁。\n几见太阴偏犯毕，堪怜洪水正横流。\n自嗤捧土难援溺，肯信乘桴好远游。\n故国不知今底事，观澜谁坐四峰楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十六日偕胡余二守登柳州南楼小酌","author":"霍与瑕","text":"寻乐而今更莫迟，青阳辞候已多时。\n遥看楚水无穷去，独倚南楼有所思。\n驾鹤山前云淡澹，伏龙城畔草离离。\n三杯二守同清暇，千古风流应在兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":13191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]