[{"title":"曹溪杂咏 其三","author":"释通岸","text":"底事消閒日，衡茅适性灵。\n引泉通药坞，滴露写茶经。\n野鸟分中食，岩花落净瓶。\n最怜秋雨后，洗出数峰青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹溪杂咏 其四","author":"释通岸","text":"石径久延伫，还期逋客过。\n林深秋气早，山静月明多。\n胜事杳难说，幽怀其奈何。\n所思不可见，孤磬出烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹溪杂咏 其五","author":"释通岸","text":"老衲时耕稼，为居近给园。\n茅茨十亩地，烟火数家村。\n野饭炊晨熟，溪舂入夜喧。\n寻常牧牛去，应不犯苗根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏史","author":"释通岸","text":"楚国有和璧，秦王欲得之。\n偿以十五城，君臣徒自欺。\n壮哉蔺相如，奉使无游移。\n一介西入秦，怒发且裂眦。\n完璧竟先归，嬴政空尔为。\n屈身避廉颇，状若非男儿。\n智勇何其全，英风千载垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽湛然社兄","author":"释通岸","text":"忆尔同游日，清风动给园。\n应机皆有作，离幻竟无言。\n双树啼寒鸟，空山闻夜猿。\n寥寥千古意，此际不堪论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹溪杂咏 其一","author":"释通岸","text":"颇适庄生乐，逍遥自不同。\n独醒诸梦远，多病万缘空。\n戏舞沙边鹤，徐来水面风。\n何人将紫竹，吹弄月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹溪杂咏 其二","author":"释通岸","text":"急雨涨溪流，晚晴山更幽。\n渚清喧饮鹿，风过起眠鸥。\n响入千岩应，波腾众壑浮。\n月明烟水外，深夜有渔舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹溪杂咏 其三","author":"释通岸","text":"所嗟褦襶苦，扰扰几时休。\n未识邯郸梦，徒怀杞国忧。\n齐奴终齿剑，飞将不封侯。\n输却寒山子，孤峰枕石头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西南驿候潮","author":"释通岸","text":"旅客听潮发，依微野望中。\n霞明山吐月，江静水连空。\n远岸嘶寒马，晴山叫断鸿。\n莫挥杨子泪，岐路任西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜宿峡口","author":"释通岸","text":"客途逢日暮，维舸傍岩西。\n隔岸灯初起，前湾渔正归。\n乱帆惊鸟宿，疏柳间萤飞。\n远岫推云出，波涵天四围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖舟中同诸子分赋","author":"释通岸","text":"扁舟疑入画图中，波面楼台柳外风。\n眼底韶华三月尽，天涯朋旧一樽同。\n莺声隔岸邀歌扇，花影连湖卧钓翁。\n幽赏未停烟树瞑，玉轮飞出海门东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白鹅潭望大通寺","author":"释通岸","text":"微茫烟浪接平沙，棹入幽深处处花。\n天阔恍疑非世界，岸回方觉有人家。\n帆前细雨春将尽，云外疏钟日已斜。\n征客此时还怅望，离离芳草遍天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠觉庵居士","author":"释通岸","text":"尘踪扰扰世途间，何以先生日掩关。\n一径野云车马绝，满林华雨桔槔閒。\n惟将白业冥真性，不学丹经驻玉颜。\n挥麈倘容方外侣，论心长傍月中还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登飞来寺与熊楚伯梁井卿分赋","author":"释通岸","text":"灵岳何年帝子游，遗踪閒得共冥搜。\n千寻怪石看疑堕，万壑长松听欲流。\n寺记齐梁馀断碣，人思李郭有虚舟。\n凭高久坐烟霞晚，一笑真成汗漫游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中偶怀梁丙孺","author":"释通岸","text":"混迹人间三十年，故林归去且随缘。\n谁知曲枕流云外，却落虚名浊劫前。\n经罢有琴弹夜月，禅馀无事笑秋烟。\n伤心偶忆龙华侣，零落荒池旧种莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"永泰寺挽宥上人","author":"释通岸","text":"年来几度得招寻，拟结茆茨共息心。\n雨过密林怜旧约，月明翛竹想閒吟。\n鹤归似响云中锡，人去空留壁上琴。\n石火电光非久燄，秪应遗恨暮云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水帘台","author":"释通岸","text":"寒瀑挂幽岩，霏霏自千尺。\n恍讶水晶帘，清映太古石。\n有美临高台，瞻云终日夕。\n俯视尘寰中，劳生何役役。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苍雪崖","author":"释通岸","text":"凿翠兮岩阿，萧森兮清昼。\n独往疲烟霞，长啸出宇宙。\n览胜拟山阴，安禅似灵鹫。\n焉得同心人，冥栖此林岫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹溪杂咏","author":"释通岸","text":"晓起澹何营，神閒境亦清。\n草深骄狡兔，花暖醉雏莺。\n琴几岚光润，萝轩旭照明。\n涣然光宇内，随处是无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题瑩心泉","author":"释通岸","text":"一脉灵渊秘，千秋镇若斯。\n光涵明月夜，清与白云期。\n远洽藏春坞，平分浴鹤池。\n悠然心赏处，尘世未曾知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题肤功雅奏图","author":"释通岸","text":"笑拥貔貅百万师，陈前重睹受降时。\n风云壮护明王诏，日月光悬大将旗。\n庙算等閒空羯塞，天威只尺对龙墀。\n赤松游首功成后，岂负匡山旧社期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游浴龙池","author":"释道丘","text":"探幽穷涧底，尽处泻寒流。\n梯磴寻奇绝，扪萝上石楼。\n山花香易采，野果棘难求。\n雨过侵衣湿，还山日未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄博山首座雪大师","author":"释道丘","text":"夺得吾师肘后符，宗门牢落赖匡扶。\n镆铘横按非誇手，宝镜高悬正是渠。\n聚散缘繇谁变异，往来何假雁传书。\n玄沙白纸三缄密，千里同风井觑驴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入关漫作","author":"释道丘","text":"苍苍云木万山秋，一入禅关念总休。\n已信此身俱是幻，宁知何物更堪求。\n凤鸣谷响心原寂，竹翠花黄境自幽。\n不二门开谁荐得，净名争肯按牛头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠雁木堂李烟客曾宅师诸公结社参究四首 其一","author":"释道丘","text":"般舟三昧舍安逸，吾佛翘勤七日立。\n猛然截断小胡床，一个蒲团何待七。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠雁木堂李烟客曾宅师诸公结社参究四首 其二","author":"释道丘","text":"白马青牛随去住，西竺先生何所遇。\n唯然一贯自销融，万象之中身独露。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠雁木堂李烟客曾宅师诸公结社参究四首 其三","author":"释道丘","text":"女大须婚男大娶，团栾谁解无生句。\n眼底眉毛始放开，脚头早跨三台步。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠雁木堂李烟客曾宅师诸公结社参究四首 其四","author":"释道丘","text":"手握木蛇曹氏女，道人本色无刀斧。\n嘉州大像吃黄莲，陜府铁牛满口苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新创云顶山房","author":"释道丘","text":"不风流处也风流，占得湖山云顶头。\n若问云山何境界，门前有水到端州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云顶上脊","author":"释道丘","text":"脊梁竖起庆云中，龙象仝登最上峰。\n才插一茎周梵刹，溪声山色几重重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鼎湖筑关房上脊","author":"释道丘","text":"云顶新秋筑小房，脊梁竖起露堂堂。\n眉问别具摩醯眼，触处逢渠绝覆藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莲华洞","author":"释道丘","text":"四望莲峰涌插天，寰中洞古尚依然。\n龙吟虎啸皆清籁，石径苔生满地钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庆云顶","author":"释道丘","text":"按下云头好看山，高低峰顶绝跻攀。\n翻身拶出虚空骨，云自閒来水自潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"狮子峰","author":"释道丘","text":"踞地翻空露爪牙，惊群不动更吒沙。\n弄来几出金毛上，眼底迷麻看转差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伏虎罔","author":"释道丘","text":"伏虎岩前早已降，献花猿鸟不相妨。\n锡飞响应空山谷，月映寒潭彻底光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"袈裟田","author":"释道丘","text":"袈裟曾效此田衣，日用犁耕自不饥。\n清净乞求能活命，脂膏消落法身肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浴龙池","author":"释道丘","text":"金躯曾借龙池浴，洗出尘中特达人。\n夺得骊珠头角露，神通些小莫能陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞鹅岭","author":"释道丘","text":"飞鹅岭上翠微深，极目烟波万木阴。\n赶起一群飞不散，依依还在绿森森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"啸天龙","author":"释道丘","text":"俱胝一指笑天龙，童子循涂没路通。\n拈过司南针一转，穿山透地巧施工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤来山","author":"释道丘","text":"双凤来仪拥翠微，好音和雅乐雍无。\n太平无象真清泰，山静犹然上古时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"象回岭","author":"释道丘","text":"驯象回涂不着钩，得优游处且优游。\n逢人懒说三三话，白醭从教上觜头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其一","author":"释弘赞","text":"佛祖真宗绝掩藏，溪声不断为宣扬。\n丛兰抽蕊点山径，叠嶂排云护草堂。\n邻老病虚频夜醒，行童痴重惯时忘。\n人来欲借无缝塔，为道好皮莫剜疮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其二","author":"释弘赞","text":"素云晴锁万峰秋，丹嶂危居一比丘。\n活得百年犹是气，悟无少法不如沤。\n鴳鹏休互嗤高下，椿菌何须论短修。\n教意宗乘莫我识，砂锅蔬熟笑无油。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其三","author":"释弘赞","text":"鸟韵花香春自闹，窗閒林寂道如宜。\n一条楖栗逢溪度，半卷楞严倚树披。\n高下随平田有在，玄黄忽略马何为。\n菩提妙法非空色，缘念未忘被物羁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其四","author":"释弘赞","text":"数拟出山访故人，松门观鹤每逡巡。\n自閒白社荷衣老，不是黄农木食民。\n秋夜小亭怀蚬子，西风磐石梦驴唇。\n真成独往空千古，一抹溪光姓字沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其五","author":"释弘赞","text":"太虚终本无明晦，万象都来一镜空。\n松坞昼清人倚树，岩台秋好月和风。\n总休计彼居迷悟，不必从予较达穷。\n听彻溪声千叠响，只今道与太峰崇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其六","author":"释弘赞","text":"傍崖筑屋远层城，满瓮莲花物外情。\n渔父莫知幽涧趣，樵童安辨隐人名。\n轻霜草榭芳桐老，暴雨松坡紫菌生。\n一笑古今成梦事，几回禅起独经行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其七","author":"释弘赞","text":"事得无心理自圆，松声草色现成禅。\n石头何意硬成佛，鳌足空闻直拄天。\n月被云遮光不下，水因槎碍涩难前。\n一时尘刹俱空去，谁辨中间与二边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其八","author":"释弘赞","text":"天地未应同我阔，何妨山里石岩岩。\n懒随云水出人世，乐爱烟萝住草庵。\n撼木风生饥虎怒，酿花酒熟老猴酣。\n閒閒较历娑婆国，无似枯禅百不谙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其九","author":"释弘赞","text":"世上人谁识浑金，聊携瓶锡入荒岑。\n拓来瘦地三馀亩，苫得虚斋两半寻。\n壅有疑情劳面壁，苦无閒步访山阴。\n悟迷由汝无多事，独自盘桓朗夕吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其十","author":"释弘赞","text":"寂寂寥寥似可依，坦然尚觉去时非。\n碧光匝岭客尘断，翠色盈轩道意微。\n风怒晚林摧敝叶，月怜秋冷为长晖。\n坐来竹露成珠颗，犹自听泉未掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其十一","author":"释弘赞","text":"毁誉不干欣厌尽，尘缘终省到茅斋。\n嚼苗辨药神应畅，临水观经意自佳。\n暖谷护花云袅袅，疏林饫果鸟喈喈。\n沧桑任变寰中事，一榻高眠万虑埋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其十二","author":"释弘赞","text":"半兼禅律半耕樵，自昔携筇不限桥。\n活句每从苦究得，光阴多为懒磨消。\n白翻远岫衔花去，黑起深潭怒雨飘。\n故我住山忘宠辱，一龛高卧傲神尧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其十三","author":"释弘赞","text":"秪许閒云伴佛衣，逍遥物外与谁归。\n落花满涧思樵药，寒日半山歌采薇。\n入户青猿依磬定，出林黄鸟破烟飞。\n人间世事多如幻，六代繁华今已非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊居","author":"释元觉","text":"生年当五十，行乐敢蹉跎。\n白发数茎落，青山几度过。\n寒云沉药圃，晴日出江波。\n偶听邻翁语，秋田欲剪禾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古镜","author":"释元觉","text":"匣中藏已久，一见一回新。\n有象知谁识，无言止自亲。\n空秋潭底月，深夜定中身。\n莫讶风尘掩，从来会照人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈乔生之青原访药地禅师","author":"释元觉","text":"黄门才子久知归，古寺寻僧愿不违。\n世事已将云影灭，道心先向瀑泉飞。\n舟铺卧簟滩声满，叶尽寒山野烧微。\n从此石房休自掩，夜禅深雪到人稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀陶握山","author":"释元觉","text":"数椽茅屋面江洲，江水滔滔背郭流。\n病骨几年随野鹤，閒情终日在孤舟。\n一溪清响残荷雨，万树新黄落叶秋。\n遥忆故人何处所，片云高挂碧山头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄俊升大士招同雪槱和尚放舟海珠寺分赋","author":"释元觉","text":"剖出神珠纵泳游，水天空阔胜南洲。\n光摇碧渚连云汉，气漾春波撼海楼。\n未渡五仙疑石化，曾拈一苇共鸥浮。\n台前雅集三生话，风起潮声见九秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归鼎湖作 其一","author":"释元觉","text":"大道原无住，斯行亦偶然。\n片帆悬渡口，孤棹入湖天。\n山色留前古，溪声送暮年。\n江心应有月，松际几时圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归鼎湖作 其二","author":"释元觉","text":"世事多留难，山心谁与期。\n行当衰老日，况值乱离时。\n定水呈空色，闲云寄所思。\n故交应有念，前路莫迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题宝积寺","author":"释元觉","text":"乱馀山路少人行，古寺閒花满径生。\n铁铸真僧重过火，土颓金像不知名。\n石幢有咒云常护，香阁无基草自平。\n头白樵夫频向说，十年岩壑罢春耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送蔡伯昭归潮阳兼游罗浮","author":"释元觉","text":"先生归去更何之，牢落残年是别时。\n投老有心求至道，旁人何事怅临岐。\n仙洲漫采长生药，石洞应留旧日诗。\n归去灵山深处隐，閒云来往定何期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次樊长文孝廉游鼎湖韵","author":"释一机","text":"浮生閒未得，随步陟湖峰。\n径曲疑无地，山深何许松。\n花开明远峤，溪响间疏钟。\n正好逢僧话，高春逼暮容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其一","author":"释一机","text":"经年不出户，一榻日高眠。\n有相非关我，无心莫问禅。\n山花开复落，窗月缺还圆。\n新构茅斋起，云来占半边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居 其二","author":"释一机","text":"世情谙已熟，长揖入山林。\n道远无人问，诗成只自吟。\n半生圆泽石，一调伯牙琴。\n尽付东流去，沉埋直至今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈少庵之楚谒所知","author":"释愿光","text":"粤国千山外，言扬楚水舲。\n送君出江口，黄叶满津亭。\n树色寒云梦，秋声落洞庭。\n故人一相见，吟眺九疑青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白云谣","author":"释函是","text":"昆崙在人间，盼望疑青霄。\n盈盈瑶池觞，良遘忽崇朝。\n旦暮不可再，白云空迢迢。\n王者岂真乐，仙人徒见招。\n悠远非山川，举足抟扶摇。\n叹息古今事，犹传天子谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周穆王答歌","author":"释函是","text":"玉台距东土，一瞬分天人。\n予归岂勿顾，诸夏多人民。\n含餔帝力忘，百姓谁疏亲。\n觌面看踌躇，万年犹若今。\n袅袅瑶流响，亭亭玄圃云。\n相见不相知，迢遥空梦魂。\n抗手谢青鸟，毋劳翘昆崙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]