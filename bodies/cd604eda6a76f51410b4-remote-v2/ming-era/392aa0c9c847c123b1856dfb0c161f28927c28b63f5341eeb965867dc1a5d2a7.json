[{"title":"河上行","author":"郑善夫","text":"白雁噭噭思朔方，乌衣逐逐度河隍。\n河间草树色焜黄，淮西二月春悲凉。\n北风惨懔日无光，洪涛簸天不可航。\n晨风不食百鸟藏，妖虬怒鲸连山长。\n途遥日暮雨沾裳，临河欲渡愁无梁。\n散发狂夫何郡郎，箜篌弦绝声不扬。\n侧身天地夜未央，愁燕愁粤热中肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19415,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"发京邑迷路投宿黑庄","author":"郑善夫","text":"东省多年病，南冠百念灰。\n关山一怅望，天汉独归来。\n行野蒲稗晚，过村笳鼓哀。\n迷途更几许，愁绝望乡台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19416,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"放船","author":"郑善夫","text":"柂楼下急浪，去险在毫端。\n已识篙师巧，方忧蜀道难。\n此溪防罔象，何日避风湍。\n颇羡玄真子，清时把钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19417,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泗上","author":"郑善夫","text":"总总衣冠地，方冬生事繁。\n牛羊散迥野，烟火接长村。\n薙藿农人聚，分瓜稚子喧。\n如何恶官府，凿破此淳源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19418,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对湖二首 其一","author":"郑善夫","text":"㬒㬒玄阴日，团团照水隈。\n鲸波动霄汉，鼍鼓挟风雷。\n地尽青山杳，天寒白鸟回。\n轻帆未相失，自此访蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19419,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过彭城怀旧二首 其一","author":"郑善夫","text":"自有干戈后，年年向此过。\n乾坤未解甲，江海且增波。\n拊剑心逾壮，经时鬓易皤。\n渭南无梦到，终是卧烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19420,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过彭城怀旧二首 其二","author":"郑善夫","text":"忆昔此避地，诸君慰我多。\n别来淹日月，望尔邈山河。\n洒泪山阳笛，关心陇水歌。\n犹闻杀长吏，飘泊复如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19421,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吕梁","author":"郑善夫","text":"葱岭昆崙外，吕梁天地间。\n淜腾终赴海，咆吼欲颓山。\n力转鱼龙窟，秋生虎豹关。\n平生历险阻，对此泪潸潸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19422,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"悼刘宓","author":"郑善夫","text":"宓也归何处，营魂不可招。\n只疑天地阔，竟作死生遥。\n苦海风涛壮，炎方罔两骄。\n伤心卧佛寺，秋雨自兰苕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19423,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"得思道消息二首 其一","author":"郑善夫","text":"闻汝还家后，逢时俶扰初。\n艰难仍被寇，墨绖却离居。\n边徼犹多故，山园未可锄。\n棠陵幸襄事，亦得慰区区。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19424,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"得思道消息二首 其二","author":"郑善夫","text":"近逢黄吏部，报尔在三衢。\n志士伤泥滓，南州困猰㺄。\n时危离索久，岁晚帛书无。\n却忆吴门约，萧条愧病夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19425,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"牛首","author":"郑善夫","text":"牛首有佳致，方冬亦自奇。\n同云封地轴，积雪糁松枝。\n谷响传钟磬，山昏泣罔魑。\n凭高俯王土，何意有旌旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19426,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归来","author":"郑善夫","text":"不作东曹属，归来巾屦幽。\n岂能效舐痔，聊且避牺牛。\n玉木深防病，瓶罍未省忧。\n此邦虾菜贱，家室暂淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19427,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"进衣","author":"郑善夫","text":"何处避冰雪，频怀负日暄。\n未衰筋力惫，独立布衣存。\n列子愁居郑，袁安早闭门。\n粤南多爽气，归去牧鸡豚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19428,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"兵起","author":"郑善夫","text":"自有西江乱，流民起带刀。\n操差尽孺弱，杀戮到耆髦。\n敌馘时犹献，军需日更骚。\n长缨未得请，无计罢鞬櫜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19429,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"钱塘","author":"郑善夫","text":"万山赴海国，众水汇钱塘。\n王气千年歇，湖声八月长。\n世传浑罔两，天巧亦荒唐。\n稍待凉风发，乘槎问彼苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19430,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事","author":"郑善夫","text":"即事春相近，回船日日操。\n微阳留朔雪，久旱失溪毛。\n衢府风烟改，常山斥堠高。\n危途疲薾客，汨汨向蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19431,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"严州","author":"郑善夫","text":"小传清江并，孤城碧嶂防。\n土宜多竹柏，民业但耕桑。\n稻熟还官得，山深伐木长。\n经过数州郡，淳朴见兹乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19432,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梨关","author":"郑善夫","text":"梨关不可上，战格屹云端。\n闽浙乾坤别，风烟道路难。\n堤防莫暂废，戎马未全安。\n谩想先皇日，车书达百蛮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19433,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王参知赴阙","author":"郑善夫","text":"大参行赴阙，兴落富春前。\n六月楼船雨，千山传马烟。\n白云留故国，綵服媚南天。\n知尔宁亲后，屏营金鉴篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19434,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画鹰","author":"郑善夫","text":"似欲飞腾起，星眸势可招。\n平生酣白战，远志碍青霄。\n竹兔何愁得，林貙不敢骄。\n无由配鸾凤，勿以比鸱枭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19435,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆近夫","author":"郑善夫","text":"吴门相失后，书札各茫然。\n巢父终东去，刘郎重北迁。\n双凫赴魏阙，独鹤下青田。\n未见风尘净，怀君涕泪边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19436,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汨汨","author":"郑善夫","text":"汨汨伤秋鬓，依依欲暮年。\n钓矶沧海上，布被白湖边。\n避地亲朋弃，忧时梦寐牵。\n无家杜陵老，且结草堂缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19437,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梧儿初学语","author":"郑善夫","text":"梧儿生六月，孩笑识人情。\n得汝愁俱破，于人眼尽青。\n暂时闻学语，何日见趋庭。\n尔祖能看我，回头涕泗零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19438,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"伏雨","author":"郑善夫","text":"沥沥犹鸣旦，凄凄欲作寒。\n晚禾翻恶湿，后土故长乾。\n敝屋久僵卧，凶年甘粝飧。\n持觚向人世，未得脱艰难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19439,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"至日","author":"郑善夫","text":"至日风色好，粤南霜信遥。\n地卑饶瘴气，春近茁寒条。\n汶水昔独往，淮南谁见招。\n林栖岁华晏，难免鬓萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19440,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬日草堂小集","author":"郑善夫","text":"近郭风霜浅，寒天草木稠。\n敝庐元僻野，高马漫淹留。\n岂是草玄宅，能回访雪舟。\n生逢圣明世，未敢杜交游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19441,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜吾惟可访少谷兼怀方令","author":"郑善夫","text":"旧国冥心久，良朋见面初。\n同为避地客，独叩草玄庐。\n花鸟三春暮，乾坤百战馀。\n迩来方拙牧，衰疾复何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19442,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乌石惟可同游","author":"郑善夫","text":"道山秀盘石，春半更婵媛。\n海水双江入，岩花二月繁。\n衰容防草昧，故老问桃源。\n怜尔南游思，风烟数断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19443,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寒食","author":"郑善夫","text":"至后百五日，堂斋风雨深。\n越乡寒作食，溟海气长阴。\n身事南阳役，神京北望心。\n采薪缠日月，发已不胜簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19444,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早秋龙门舟中","author":"郑善夫","text":"艓子小于叶，早秋江上行。\n风波千古转，天地几时平。\n病骨怜沧海，凡才耻圣明。\n不眠闻短吹，故国亦飘零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19445,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿象山西坞二首 其二","author":"郑善夫","text":"秋云不称意，肤寸每成霖。\n漏日翻东壁，随风湿远岑。\n腰镰野外急，燐火晚来深。\n入夜增萧索，千林猿狖吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19446,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄潘逸老","author":"郑善夫","text":"东湖潘逸老，守晦十馀年。\n久病文园枕，长贫杜曲田。\n形骸非故我，天地有真诠。\n愿汝支离德，閒居读内篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19447,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"海滨书所见","author":"郑善夫","text":"北里万馀户，渔樵更种田。\n打鱼乘水得，伐木上山便。\n禾黍栖南亩，牛羊被远阡。\n生涯未为少，何意尽颠连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19448,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卧病少谷山中","author":"郑善夫","text":"伏枕东山晚，闭门黄叶幽。\n竹书遗问岁，蝉语易深秋。\n散地朋情见，明时家食羞。\n唯应习农圃，草野得淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19449,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"今夕","author":"郑善夫","text":"蓟门城下月，今夕定如何。\n白骨凌沙砾，黄尘控骆驼。\n羽书疲传置，边马失关河。\n天子方宵旰，孤臣泪已多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19450,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"授衣","author":"郑善夫","text":"秋草倏已歇，鸣蛩欲近床。\n北风吹鬓发，九月进衣裳。\n抱病仍多事，逃空未损光。\n黑貂今久敝，摇落岁寒妨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19451,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岊上送时行赴阙二首 其一","author":"郑善夫","text":"王粲江湖兴，幡然为国谋。\n故山随意去，残照尚谁留。\n身事齐门怨，天家漆室忧。\n萧条倍怜汝，岁晚拂吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19452,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岊上送时行赴阙二首 其二","author":"郑善夫","text":"念尔复赴阙，迢迢思昔年。\n鸡盟尽豪杰，天论老风烟。\n病向沧江卧，书无白雁传。\n平生鹦鹉赋，万一故人怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19453,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"草堂","author":"郑善夫","text":"岁事日将晏，草堂今苟完。\n天风吟竹叶，海月皓柴门。\n藜苋还高志，经纶有故园。\n何能谢贫贱，氛祲在乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19454,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄林荆门","author":"郑善夫","text":"暮年沧洲客，恸哭向穷途。\n春草生归思，秋风慰病夫。\n青毡后命达，白发此身癯。\n八月衡山去，期君出五潴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19455,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答安黄门","author":"郑善夫","text":"怜君下峡水，寄我郢中吟。\n白雪音调远，黄牛风浪深。\n林丘心独苦，岁月病长侵。\n胶漆知何地，迢迢鸿鹄心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19456,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"读鹦鹉赋","author":"郑善夫","text":"读罢鹦鹉赋，吾怜祢正平。\n识机宁入网，远害转伤生。\n名在心形累，时危鼎俎烹。\n异时一掬泪，洒向武昌城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19457,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江上别道宗兼怀何仲默","author":"郑善夫","text":"却向江头别，潸然感物华。\n林泉移岁月，霄汉变云霞。\n伏剑亦骇俗，出门宁顾家。\n寄言何水部，迟尔折梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19458,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽王生","author":"郑善夫","text":"吾乡论后进，尔最擅词场。\n十八人间世，三千弟子行。\n辕驹未竟步，石火不馀光。\n忆昔邢居实，秋风太惋伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19459,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送伍方伯入觐","author":"郑善夫","text":"尊翁吾从祖，同第甲申年。\n论世鲰生愿，通家令子贤。\n春风虚木榻，王事重楼船。\n命薄徐高士，栖栖不受怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19460,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻涛","author":"郑善夫","text":"涨海饶孤寐，春山淹去归。\n鱼龙永夜急，波浪远天违。\n孤志存舟楫，清时卧钓矶。\n尘机久已息，何事白鸥飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19461,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋同高宗吕传木虚城东步月有怀京华旧游","author":"郑善夫","text":"朗月团秋社，凉风薄岁寒。\n故乡谁独健，永夜此同看。\n邻篴伤今昔，山杯尽肺肝。\n长安旧朋侣，搔首五云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19462,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南关","author":"郑善夫","text":"度陇心忽折，殊方梅柳春。\n兵戈近满眼，书剑老随身。\n世有阮籍泪，道应原宪贫。\n愁闻更选士，东土已风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19463,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金山纪游二首 其一","author":"郑善夫","text":"双眼无空阔，长江会百灵。\n吴门对海定，淮树贴天青。\n钟动鼋鼍窟，云生鹳鹤庭。\n中流有孤志，鼓枻下沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19464,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金山纪游二首 其二","author":"郑善夫","text":"㶁㶁中泠水，东游与散愁。\n楼台通海雾，岁月送江流。\n好事怜司马，逃空想惠休。\n献花缘尚浅，心折过扬州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19465,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阻济上","author":"郑善夫","text":"叔伯何多日，关山烽火明。\n病妨风土恶，身与岁时征。\n丧乱怀先帝，艰危有我生。\n向来刘越石，意气不能平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19466,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀金山","author":"郑善夫","text":"我爱金山寺，洪波万顷开。\n乾坤留柱石，沧海失蓬莱。\n曝日鼋鼍出，抟风鹳鹤回。\n中泠洗心处，极目意悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19467,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"此夕","author":"郑善夫","text":"时危长伏枕，月好自临关。\n斥堠连吴越，烟尘犯海山。\n民穷久欲乱，师老未成班。\n此夕姑苏酒，酣歌不破颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19468,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"双雁","author":"郑善夫","text":"双雁为人得，阶前相向鸣。\n已辞关塞远，犹带网罗惊。\n宦情一片影，客泪五更声。\n侧目窥秋隼，风烟异性情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19469,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对雪答太白山人","author":"郑善夫","text":"天地忽改色，六花风乱投。\n翛然翠袖薄，加我草堂幽。\n照水梅自媚，闭门君不忧。\n玄机正无极，将汝醉乡游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19470,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岁暮哭近夫二首 其一","author":"郑善夫","text":"南国青琐闼，东山白板扉。\n三年不相见，两地思依依。\n遂有幽明隔，谁云夭寿微。\n江东送望眼，空复暮云飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19471,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岁暮哭近夫二首 其二","author":"郑善夫","text":"宁知是永别，七月有书来。\n即死还忧国，皇天亦妒才。\n世衰元气散，君逝玉山颓。\n沧海垂纶客，冥心若死灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19472,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"海门","author":"郑善夫","text":"落日绵亭岭，茫茫何所之。\n山川沦沆漭，天地撤藩篱。\n脱屣未相失，放瓢聊自怡。\n扶桑弱水外，东望拂虹蜺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19473,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"将至鲤湖道上","author":"郑善夫","text":"瑶宇青峰顶，芒鞋白鸟边。\n风泉轰九鲤，云木薄诸天。\n尚子终当去，庞公最可怜。\n玄房今夕里，謦咳接群仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19474,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鲤湖三首 其一","author":"郑善夫","text":"到此意了了，春湖接未妨。\n薄云长恋洞，名草不辞香。\n月色寒侵阁，滩声夜近床。\n神仙真可学，吾即傲陶唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19475,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鲤湖三首 其二","author":"郑善夫","text":"铁嶂垂天堑，石门修水关。\n古松蟠极地，小鸟立惊湍。\n玉笛何由听，真乘未即安。\n芝田会心处，漫忆紫金丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19476,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鲤湖三首 其三","author":"郑善夫","text":"何处遁天韬，烟霄首独搔。\n山川进奇崛，天地入萧骚。\n病骨怜芳草，烦心愧白袍。\n东隅紫气盛，偏薄上仙曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19477,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日经白沙王氏庄","author":"郑善夫","text":"王子躬耕处，柴门碧树团。\n云松飞鹳鹤，风涧引波澜。\n父老壶觞得，儿童礼数宽。\n西坡水麦熟，麋鹿下安安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19478,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄王时行佥宪二首 其一","author":"郑善夫","text":"隐约王佥宪，为官近越州。\n久无烽火警，能把甲兵休。\n清远神仙所，君王锡宴游。\n时平占福地，不用觅丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19479,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄王时行佥宪二首 其二","author":"郑善夫","text":"囊山分手去，正值暮春时。\n蒲柳看衰䬃，风尘且别离。\n岭南人事少，海上雁书迟。\n炎瘴还消息，无劳罢酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19480,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄充之华亭","author":"郑善夫","text":"鳌峰衰病至，岁月莽蹉跎。\n不识松江曲，鲈莼意若何。\n朋情音问阔，师道课程多。\n预报经过日，秋风偃败荷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19481,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄郑方伯山齐","author":"郑善夫","text":"昔日莆阳役，春山共采芝。\n郑虔犹逐客，贾傅自明时。\n潦倒莺花切，提携酒馔随。\n难忘何氏宅，汎爱木兰陂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19482,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻汀漳罢兵二首 其一","author":"郑善夫","text":"整整汀漳戍，群凶复听招。\n频闻洗兵马，不见返渔樵。\n猰㺄终难狎，貔貅漫独骄。\n皇情近忧豁，氛䘲若为销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19483,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻汀漳罢兵二首 其二","author":"郑善夫","text":"羽书传上国，牙帐拥诸侯。\n别峒分戎马，前锋失火牛。\n果谁知要害，漫尔历春秋。\n只道书生策，能分主上忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":19484,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]