[{"title":"代作许寿诗","author":"王立道","text":"清溪一派五湖通，云影波光十里同。\n老人洗髓初成道，为访当年河上公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题扫雪煎茶图 其一","author":"王立道","text":"素质渐沦浮蟹眼，绿尘初瀹映娥眉。\n一杯漱入枯肠里，尚忆思成禅诏时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题扫雪煎茶图 其二","author":"王立道","text":"由来风味此中优，翻为羊羔锦帐羞。\n不如僵卧蓬庐者，自是名臣第一流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"帝京歌 其一","author":"王立道","text":"一自文皇破虏还，蓟门天险压秦关。\n候骑不窥云中郡，屯田直至纥干山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"帝京歌 其二","author":"王立道","text":"帝座分明照冀州，妖星从此霣旄头。\n皇图永似西山固，圣泽黄河万古流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"帝京歌 其三","author":"王立道","text":"天戈漠北静胡沙，帝里长安通狭斜。\n中贵多骑大宛马，都人爱种洛阳花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"帝京歌 其四","author":"王立道","text":"滹沱易水接卢沟，千古渔阳说上流。\n圣王一统开华夏，佳气常朝五凤楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"砺峰上元燕会卷和韵 其一","author":"王立道","text":"宁亲归去隔仙家，灯火长安望转赊。\n社里新诗应寂寞，天涯明月共光华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"砺峰上元燕会卷和韵 其二","author":"王立道","text":"火树凝辉玉漏迟，胜游偏记上元时。\n不嫌身在蓬瀛外，綵服清觞亦自宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长至日寄弟口号 其一","author":"王立道","text":"故乡风土未全非，老大儿童乐事稀。\n尚忆鸡鸣相唤起，膝前拜舞试新衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长至日寄弟口号 其二","author":"王立道","text":"满路清霜逗客衣，五更初点放朝归。\n才微袜线知无补，心著寒灰不共飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长至日寄弟口号 其三","author":"王立道","text":"节至亲朋常满堂，邀欢尽日对壶觞。\n不因独坐长安邸，肯信阳回景渐长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽钱母","author":"王立道","text":"狸首歌残海树秋，熊丸空转夜深愁。\n板舆寥落安仁赋，瑶水虚无阿母游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑞鹤仙 寿谈守教母六十","author":"王立道","text":"薰风初入幕。\n禁城隈，缭绕朱栏画阁。\n杨柳枝枝弱。\n绿阴中，遥映满阶红药。\n萱花吐萼。\n爱北堂、春光如昨。\n清昼永，人在瑶池深处，安排春酌。\n恰有蓬瀛仙客。\n羽服翩跹，云车煜爚。\n玉壶丝索。\n玳筵前，觥筹错。\n芳尘动，正见妙舞清歌，尽日承颜为乐。\n想莱綵潘舆，兹事古今寥廓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉蓬莱 寿陈子宣父七十","author":"王立道","text":"初日上珠帘，乳燕双飞，垂杨风软。\n游丝捲尽，有莺声娇啭。\n绿遍东城，红稀南陌，偏称人游衍。\n花外楼台，柳边歌管，乍开芳宴。\n况老景欣逢太平时，满目韶华，莱衣缱绻。\n麻姑相讯，道蓬莱水浅。\n人生七十，古来真鲜。\n愿沧海桑田，从今再变。\n寿域无期，华筵常展。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临江仙 寿姚申甫父","author":"王立道","text":"渊明未老赋归来，赢得清风两袖。\n田园三径浑如旧。\n桂子满中度，已擢双枝秀。\n长君鸾诰喜重荣，绣服光辉清昼。\n黄花秋晚浮新酎。\n驷马入高门，愿上千春寿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临江仙 吴尚质寿母","author":"王立道","text":"芙蓉露滴秋江冷，黄花欲满东篱。\n雁行历历海云低。\n想重闺明月，正屈指归期。\n春风初喜兰芽茁，齐眉燕婉芳菲。\n锦屏银烛映仙卮。\n年年欢此会，应不羡瑶池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"满庭芳 题来雁词两首 其一","author":"王立道","text":"绛阙冬初，瑶阶月满，仙宫恰喜新成。\n螭碑鸿笔，帝命属春卿。\n石上丹书珍重，许微臣、并勒御名。\n缟衣人，来从何处，恍惚梦魂惊。\n听斋宫漏彻，家童踯躅，特地传声。\n有翩翩鸣雁，夜集前楹。\n可道事都非偶，皇恩重、物兆先迎。\n自而今，禁垣清切，日见被光荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"满庭芳 题来雁词两首 其二","author":"王立道","text":"沙塞风凄，潇湘云暖，横空多少成行。\n随阳南去，待春更回翔。\n何事偏离故侣，含声戢、翼下君堂。\n堪爱是，月明三五，烛影对寒光。\n况翩翩缟服，依依清梦，歘达君傍。\n道群分，类聚二语分明。\n那时刚承恩数，穹碑书、托姓名香。\n渐陆重，看今日兆，染翰待君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浣溪沙 顾隆吉索寿周君六十","author":"王立道","text":"杨柳风柔燕子斜。\n江南春色正繁华。\n画楼弦管是谁家。\n冉冉歌声迎落日，盈盈舞影乱流霞。\n千年重见碧桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌夜啼 寿茹母七十词","author":"王立道","text":"二月春添富贵，千秋人对芳菲。\n朱颜绿发金尊里，笑道古来稀。\n柳外歌传金缕，花前舞衬斑衣。\n瑶池宴是承欢处，此日报春晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浣溪沙 代寿陈乡人","author":"王立道","text":"花满江城月满楼。\n玉卮金缕共相酬。\n主人华发未盈头。\n心远不妨游市井，身閒端可傲王侯。\n人间何处是丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉蓬莱 冯尹父母双寿词","author":"王立道","text":"喜金鱼乍绾，玉节更颁，功名都就。\n归老田园，松菊浑如旧。\n往日中元，恰逢初度，又小春时候。\n天降长庚星，垂宝婺齐膺眉寿。\n堪羡君家，满庭玉树，数枝丹桂，谁论谢窦。\n牛刀试割，百里贤声骤。\n片片白云，东去乡园，迢递频回首。\n綵衣遥拜，两袖清风，一杯春酎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卫津别意送萧四泉","author":"任环","text":"卫水秋空霁，仙郎别棹移。\n悬知西土慰，应动滑台思。\n仗剑宁辞酒，临岐且赋诗。\n晋云犹未远，倾耳听鸣丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别栗健斋二首 其一","author":"任环","text":"的发当何日，孤踪寄远城。\n念归良独苦，闻别不胜情。\n野渡留江艇，风烟款客程。\n知君怀缱绻，须我一杯倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别栗健斋二首 其二","author":"任环","text":"客晤何曾久，他乡却忍离。\n君能开好抱，我亦不相思。\n陇树云千里，江门酒半卮。\n山川从此隔，鱼雁莫教迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭归孝子","author":"任环","text":"迎盗思安母，狼心未转移。\n黄尘犹乞免，白刃已甘随。\n饮恨应怜父，传家岂待儿。\n何当枭贼首，为尔复雠私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"道中即事","author":"任环","text":"杯酒酌江天，风晴日可怜。\n危桥平地出，孤塔半空悬。\n石缺烟云补，村虚草树连。\n谁家芦荡里，撑出小渔船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上嘉定城隍 其一","author":"任环","text":"戎马长驱后，何当旱魃连。\n火云空片片，云泽竟玄玄。\n却负苍生望，还期大有年。\n也知诚未至，神不为予怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上嘉定城隍 其二","author":"任环","text":"庭穴蚁何处，长空燕不来。\n正须潮湿础，又见月盈台。\n汗背翻成雨，劳心已作灰。\n何当瞻拜际，一洒润苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上嘉定城隍 其三","author":"任环","text":"西云不作雨，东起亦成空。\n水落三江外，民忧四野中。\n天心真默默，神听却聪聪。\n愿以狂生齿，将来换岁丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上嘉定城隍 其四","author":"任环","text":"戾政干阴谴，招灾自有因。\n要知狂子罪，不在细民身。\n神奉天诛赏，灵来雨海滨。\n但令彫瘵起，还作十分春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金山九日","author":"任环","text":"佳节逢重九，孤踪寄海涯。\n自怜犹墨绶，多病已黄花。\n欲问南来雁，那堪此际笳。\n夜深眠不得，移枕听慈鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺李八泉同年拜南台侍御","author":"任环","text":"花封尚忆甘棠客，绣斧终持铁面郎。\n尘净紫衢骢振野，声流金阙凤鸣阳。\n赤心片片酬天子，公议明明列谏章。\n寄语狐狸深莫避，埋轮原为去豺狼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代人勉诸生二首用宋萃夫韵 其一","author":"任环","text":"学业难成贵强之，机非由我更由谁。\n但将百倍功能到，纵是中材气也移。\n黄卷高谈仁杰案，青灯深墨范生帷。\n丈夫努力须年少，老大徒悲较已迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代人勉诸生二首用宋萃夫韵 其二","author":"任环","text":"读书须读没书书，活水源头趣有馀。\n莫向口头求强记，要于心上得安居。\n养成良贾深藏器，便是清朝大载车。\n体用一原吾道在，圣贤名教岂传虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐山人","author":"任环","text":"青囊未识已惊回，翻忆当年事可哀。\n藏玉有城依祖去，寻龙无处觅君来。\n离宫寸地培馀荫，坎首分金空木杯。\n但愿清风寒彻底，不妨身卧首阳台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题人扇景","author":"任环","text":"不向江头作济船，却来山下卧云烟。\n柳阴碍日吟风细，草色侵阶带露妍。\n岂是偷閒消白昼，秪因回首识青天。\n年来尘梦多惊险，休怪先生抱石眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观河","author":"任环","text":"昔年闻说黄河险，此日孤篷冒险来。\n地涌狂澜风雨骤，天驱惊浪虎龙催。\n源开星宿当何处，水到沧溟定不回。\n日暮潮生迷彩鹢，安流时仗济川材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"道中","author":"任环","text":"策马山头几逐驰，放船江上转危疑。\n长途险作三千里，一日愁生十二时。\n佩剑漫随淮浦月，望云空忆草堂卮。\n年来归兴浓于酒，况复秋风动所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别史鹤峰","author":"任环","text":"冰壶秋水绝无疵，倾盖论心两不疑。\n海国云深春送酒，江天月白夜谈诗。\n转官见说还台省，别客那堪此日时。\n公到庙堂应问及，东南时事莫深词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海上停舟风雨连朝有作","author":"任环","text":"怪雨惊风冥不休，潮来汐至总深愁。\n糊涂日月归樽酒，潦倒行藏付短舟。\n大造几时分霁色，浮生何处觅安流。\n乘槎泛叶者谁子，任尔飘然物外游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄南岑","author":"任环","text":"晋水吴山路渺漫，几于清夜梦相看。\n天边落雁千金重，海上驱兵六月难。\n高会久虚王子席，浮名何用大夫官。\n斗南日日频回首，目断秋空意未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海上夜征次解都阃","author":"任环","text":"雨馀伏枕听潮声，不寝因怜月色清。\n槎泛星河秋作客，剑横沧海夜谈兵。\n初陈云鸟三军阵，已奠江山万里城。\n夷窟分明消虎豹，东南依旧见承平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张㠠山","author":"任环","text":"旅邸相逢惜别筵，江南江北杳经年。\n琴张流水黄池月，剑挂秋风白马天。\n君有奇才消异变，我无长策净氛烟。\n尘愁离恨知多少，独立荒台正惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日","author":"任环","text":"九日有台登不得，一官于我竟何为。\n病怜黄菊人千里，愁对西风酒半卮。\n潮退小桥分乱水，霜严寒鸟择深枝。\n悠悠世路空南北，兀兀江头且赋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张石川野航之作","author":"任环","text":"芦花汀畔独移船，一曲沧浪兴杳然。\n已付世情流水外，遂令心事老江边。\n鱼吹细浪侵书帙，燕落香泥缀酒筵。\n便与先生甘订约，乘槎直欲访青天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大柳道中","author":"任环","text":"大江东去日西流，匹马冲寒役役游。\n千里山川原梦幻，百年身世自萍浮。\n萱堂月冷霜华满，沧海尘埋蜃气游。\n运甓有心乌怨在，朔风回首倍离忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代人贺门生进学","author":"任环","text":"喜尔游庠为尔忧，几番凭日费心筹。\n三军重敌着孤剑，万里惊涛藉短舟。\n战罢太平方是福，渡时安稳未为休。\n泮池一窍通蟾窟，折桂还须到上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和仇雄川幽居十咏 其一 扫室","author":"任环","text":"风尘遍海涯，一室焉能扫。\n帚柄愿持来，廓清天下好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和仇雄川幽居十咏 其二 焚香","author":"任环","text":"地僻青山拥，人间白昼长。\n草堂无个事，终日瓣心香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和仇雄川幽居十咏 其三 读史","author":"任环","text":"淳风悲日短，天意竟何如。\n怕到浇漓处，令人长叹吁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和仇雄川幽居十咏 其四 涤砚","author":"任环","text":"荡漾前溪水，萍开自不妨。\n蛟龙吞作雨，玄泽满天香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和仇雄川幽居十咏 其五 观画","author":"任环","text":"霜绡才半幅，描写尽中华。\n城郭山林里，穷愁未有涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和仇雄川幽居十咏 其六 鼓琴","author":"任环","text":"瑶琴空石几，肠断未成声。\n听待他年鼓，熏风指下清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和仇雄川幽居十咏 其七 移榻","author":"任环","text":"松涛度晚风，泉窦流閒月。\n移榻对天光，不知清兴发。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和仇雄川幽居十咏 其八 养花","author":"任环","text":"种筠酬彩凤，栽树养甘棠。\n更欲葵心吐，山居镇日忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和仇雄川幽居十咏 其九 酌酒","author":"任环","text":"严冬风力重，寒谷鸟声幽。\n把此太和春，愿分天尽头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和仇雄川幽居十咏 其十 烹茗","author":"任环","text":"扫雪撼庭梅，烹茶折槛竹。\n清生腋底风，香润林间屋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冠","author":"任环","text":"昨见尔蓬头，飞飞乱于草。\n网网一束来，今日方看好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"字","author":"任环","text":"淑德归清议，华称亦大箴。\n愿言思义处，深顾命名心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽黄节妇","author":"任环","text":"清血流天地，花躯老甲兵。\n野塘岩下士，一日遂知名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冠","author":"任环","text":"今古大经敦首礼，圣贤名教责成人。\n修齐自是男儿事，头上休空负此巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢董千兵面药","author":"任环","text":"颜面增光感德深，从今尘垢不相寻。\n年来也备些儿药，暗室时时学洗心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿人七十","author":"任环","text":"红尘飞不到心头，七十年来真自由。\n醉数又来花甲子，蟠桃三熟是春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"剑","author":"任环","text":"霜刃棱棱星斗寒，玉楼生粟几回看。\n万人学敌浑閒事，只有心兵克退难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜访郑颠仙","author":"任环","text":"仙子云巢驾碧台，市城深隐即蓬莱。\n玄关不惜山人扣，夜半应惊鹤梦回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海上漫成二首 其一","author":"任环","text":"蓬影翻风弄酒杯，浪花飞雪点书台。\n一声鼓角鱼龙动，天党山人驾海来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海上漫成二首 其二","author":"任环","text":"枕上时闻风雨声，蓬飞天际一毫轻。\n不知声在孤悬里，却为旁舟作险惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"示尔孝等二首 其一","author":"任环","text":"昔年走马燕山道，今日驱兵沧海涯。\n三尺龙泉书万卷，丈夫何处不为家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":8226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]