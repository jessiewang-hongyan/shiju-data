[{"title":"元宫词（一百三首） 其八十三","author":"周宪王","text":"鹿顶殿中逢七夕，遥瞻牛女列珍羞。\n明朝看巧开金盒，喜得蛛丝笑未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18374,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其八十四","author":"周宪王","text":"春情只在两眉尖，懒向妆台对粉奁。\n怕见双双莺燕语，杨花满院不钩帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18375,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其八十五","author":"周宪王","text":"白露横空殿宇凉，房头捣洗旧衣裳。\n玉栏金牛西风起，几叶梧桐弄晚黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18376,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其八十六","author":"周宪王","text":"健儿千队足如飞，随从南郊露未晞。\n鼓吹声中春日晓，御前咸着只孙衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18377,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其八十七","author":"周宪王","text":"天马西来自佛郎，图成又敕写文章。\n翰林国语重翻译，袄鲁诸营赐百张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18378,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其八十八","author":"周宪王","text":"低绾云鬟浅淡妆，从来阁内看诸王。\n只缘谨厚君心喜，令侍明宗小影堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18379,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其八十九","author":"周宪王","text":"二弦声里实清商，只许知音仔细详。\n阿忽令教诸伎唱，北来腔调莫相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18380,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其九十","author":"周宪王","text":"纤纤初月鹅黄嫩，浅浅方池鸭绿澄。\n内苑秋深天气冷，越罗衫子换吴绫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18381,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其九十一","author":"周宪王","text":"凶吉占年北俗淳，旋烧羊胛问祆神。\n自从受得金刚戒，摩顶然香告世尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18382,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其九十二","author":"周宪王","text":"内中演乐教师教，凝碧池头日色高。\n女伴不来情思懒，海棠花下共吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18383,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其九十三","author":"周宪王","text":"大宴三宫旧典谟，珍羞络绎进行厨。\n殿前百戏皆呈应，先向春风舞鹧鸪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18384,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其九十四","author":"周宪王","text":"兴圣宫中侍太皇，十三初到捧垆香。\n如今白发成衰老，四十年如梦一场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18385,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其九十五","author":"周宪王","text":"莴苣颜色熟樱桃，树底青青草不薅。\n生怕百禽先啄破，护花铃索胜琅璈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18386,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其九十六","author":"周宪王","text":"昨朝进得高丽女，太半咸称奇氏亲。\n最苦女官难派散，总教送作二宫嫔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18387,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其九十七","author":"周宪王","text":"宝殿遥闻佩玉珊，侍朝常是奉宸欢。\n要知各位恩深浅，只看珍珠罟罟冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18388,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其九十八","author":"周宪王","text":"元统年来诏敕殷，中书省里事纷纭。\n昨朝传出宫中旨，江浙支盐数万斤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18389,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其九十九","author":"周宪王","text":"谷雨天时尚薄寒，梨花开谢杏花残。\n内园张盖三宫宴，细乐喧阗赏牡丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18390,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其一○○","author":"周宪王","text":"新颁式样出宫门，不许倡家服用新。\n伎女紫衣盘小髻，乐工咸着戴青巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18391,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其一○一","author":"周宪王","text":"梦觉银台画烛残，窗前风雪满雕栏。\n为嫌衾薄和衣睡，火冷金垆夜半寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18392,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其一○二","author":"周宪王","text":"圣心常恤叆焉贫，特敕中书赐绢银。\n分得不均嗟怨众，受恩多是本朝人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18393,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其一○三","author":"周宪王","text":"晓灯垂焰落银缸，犹自春眠近小窗。\n唤醒玉人莺语滑，宝钗敲枕理新腔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18394,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其一○四","author":"周藩王宫辞","text":"春殿牙签万轴馀，香匀风细绿窗虚。\n侍儿临罢诚斋帖，函出先呈女较书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18395,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其一○五","author":"周藩王宫辞","text":"萧萧修竹映池寒，分汲银瓶灌牡丹。\n报道花朝开内宴，竞持金剪绕朱栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18396,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其一○六","author":"周藩王宫辞","text":"夜来行乐雁池头，侍女分行秉烛游。\n唱彻宪王新乐府，不知明月下樊楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18397,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其一○七","author":"周藩王宫辞","text":"丛生桂树后山幽，花石犹传宋代留。\n宫媪引来岩际望，蔡河春浪拍天浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18398,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宫词（一百三首） 其一○八","author":"周藩王宫辞","text":"吹台南下令婆坟，忆昔从王掌秘文。\n今日绮罗何处是，野花啼鸟自纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18399,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送名医凌汉章还苕三首 其一","author":"秦康王","text":"微恙年来不易攻，远烦千里到关中。\n寻常药饵何曾效，分寸针芒却奏功。\n絷马未能留信信，趣装无奈去匆匆。\n一尊酒尽伤离思，目断南鸿灞水东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18400,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送名医凌汉章还苕三首 其二","author":"秦康王","text":"术传卢扁字钟王，底事来游便趣装。\n熟路也知车载稳，清时何用剑生铓。\n鸡鸣函谷三更月，枫落吴江两岸霜。\n归到苕溪寻旧侣，画船诗酒水云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18401,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送名医凌汉章还苕三首 其三","author":"秦康王","text":"柬书孤剑别西秦，红树青山泼眼新。\n千里风尘双短鬓，五湖烟水一闲身。\n梦回孤馆寒砧急，望入遥空候雁宾。\n料得纪行多赋咏，云笺无惜寄阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18402,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"钧天曲","author":"朱诚泳","text":"飞游郁罗境，稽首东王公。\n开轩临法座，置酒燕灵宫。\n紫云歌玉女，琼浆酌金童。\n挥刀麟脯细，入箸鸾膏空。\n凤箫声袅袅，鼍鼓鸣逄逄。\n投壶起天笑，吹律回春融。\n燕罢百神散，乐阕万舞终。\n归来倚馀醉，凭虚驭刚风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18403,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"折杨柳","author":"朱诚泳","text":"灵州城下柳，多被官军窃。\n犹馀拂地条，更苦行人折。\n无复眼窥春，不见花飞雪。\n今君赴玉关，将何赠离别。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18404,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陇头吟","author":"朱诚泳","text":"万里奔驰陇头水，日夜呜呜乱人耳。\n黄沙白草两茫茫，怕听水声愁欲死。\n一从结发戍凉州，铁甲磨穿已秃头。\n儿孙养得谙胡语，不如陇水解东流。\n几度临流磨剑首，水浊谁怜刃伤手。\n何当乘隙奏肤功，笑取侯章大于斗。\n肯学李陵生服降，甘饮陇水臣他方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18405,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上皇三台","author":"朱诚泳","text":"沈沈漏几更，辗转不胜情。\n南内凄凉处，梧桐夜雨声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18406,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨白花","author":"朱诚泳","text":"杨白花，随风无定止。\n飘然一去太无情，飞度江南几千里。\n可怜落水化浮萍，浮萍无复随风起。\n宫中美人连臂歌，此情不断如春水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18407,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上邪","author":"朱诚泳","text":"上邪，我欲与君相知，永久无休期。\n马生角，慈乌头白。\n天柱折，地维缺，华岳兀。\n天地无日月，乃敢与君绝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18408,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春词 其四","author":"朱诚泳","text":"海棠枝上鹊声乾，罗幕重重护晓寒。\n初日半林珠露重，脆红无数压阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18409,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题王舜耕画 其一","author":"朱诚泳","text":"翠壁丹厓淡夕曛，往来麋鹿自成群。\n仙家住在空青外，只隔桃花一片云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18410,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜 其二","author":"朱诚泳","text":"秋声溢耳不堪听，燕坐高斋户半扃。\n霁月满窗明似昼，梧桐如雨下空庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18411,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武功道中","author":"朱诚泳","text":"五原三畤隔西东，此地人言是武功。\n杨柳池塘科斗水，杏花村店酒旗风。\n农耕绿野春台里，客在青山罨画中。\n日暮官程催去马，树头微雨正濛濛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18412,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日","author":"蜀成王","text":"明窗长昼独从容，单袷闲来坐暖风。\n朱户柳晴莺未语，闲阶苔净蚁相从。\n茸茸草色吟边绿，灼灼花筹酒里红。\n春事近来浑不管，杨花飘泊画楼东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18413,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其一","author":"蜀成王","text":"无语凭栏珠泪潸，双眉蹙蹙锁春山。\n可怜空长彤宫里，一世光阴半世闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18414,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其二","author":"蜀成王","text":"半掩残灯半掩明，前生薄幸在今生。\n凄凉最苦秋宵永，风冷阶虫伴雨鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18415,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其三","author":"蜀成王","text":"静院深深昼悄然，几时好梦得扪天。\n此生莫恨因缘浅，还有来生五百年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18416,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其四","author":"蜀成王","text":"鸾镜生尘十载多，羞看娇影舞婆娑。\n残脂剩粉无人扫，随水流来涨御河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18417,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其五","author":"蜀成王","text":"觚棱月上晚岚空，影透房栊冷帐中。\n孤枕萧条魂梦断，满腮红泪湿西风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18418,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其六","author":"蜀成王","text":"青春一去岂重来，转毂韶光日夜催。\n三百六旬空怅望，朱门经岁不曾开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18419,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其七","author":"蜀成王","text":"玉露侵阶点翠苔，金波穿牖共徘徊。\n潜身坐倚梧桐树，待学吹箫等凤来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18420,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其八","author":"蜀成王","text":"空有华堂十数重，等闲不复见君容。\n俄听玉辇声才过，恨却监宫急急封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18421,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其九","author":"蜀成王","text":"五云高护凤楼深，风度时来断续音。\n楼上君王自听得，尽知合院动秋砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18422,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其十","author":"蜀成王","text":"睥睨鸦喧曙色明，丽谯隐隐尽钟声。\n各宫装束焚香候，只恐君王道院行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18423,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其十一","author":"蜀成王","text":"默默心情向阿论，纤腰瘦怯画中人。\n良辰美景番成恨，忘却新春与旧春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18424,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其十二","author":"蜀成王","text":"君王翌日宴长春，霖雨迷漫泞土尘。\n特令满宫来魇止，一时悬挂扫晴人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18425,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其十三","author":"蜀成王","text":"春景流莺语渐稀，倚窗抚景泪沾衣。\n廉纤微雨蒙蒙拂，零落残花片片飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18426,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其十四","author":"蜀成王","text":"向暖嬉游笑语欢，宫官忽道过金銮。\n传呼声急人皆避，尽闭窗棂纸隙看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18427,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其十五","author":"蜀成王","text":"银床雨滴伴苍梧，香烬孤窗暗鸭炉。\n湿气生寒人迹少，紫苔重叠满金铺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18428,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其十六","author":"蜀成王","text":"粉翠沉埋岂自由，空房独守几时休。\n风凋叶落宫墙内，知是人间又报秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18429,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其十七","author":"蜀成王","text":"新观玉历识正初，泰运三阳蔼帝居。\n御座今安圆阁子，谊中欲置女尚书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18430,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其十八","author":"蜀成王","text":"禁宫宫女三千室，多下朱帘昼掩窗。\n为避春光羞独见，花间恨杀蝶飞双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18431,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其十九","author":"蜀成王","text":"城外晴风卷薄尘，传言都道踏青人。\n繁华满目开如锦，惟此宫中不见春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18432,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其二十","author":"蜀成王","text":"绮窗垂柳影婆娑，长日花砖未肯过。\n六院不通人语寂，一双缡鹆巧言多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18433,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其二十一","author":"蜀成王","text":"北斗阑干夜未央，金炉侍女更添香。\n穿窗月射鸳鸯枕，半隐灯光在小床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18434,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其二十二","author":"蜀成王","text":"独卧空床倦不言，半扃疏牖面南垣。\n低檐雾锁黄昏候，投宿寒乌逐对喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18435,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其二十三","author":"蜀成王","text":"内池春水鸭头绿，上苑晨花猩血红。\n蜂蝶丛花鸳戏水，一齐著意向东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18436,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其二十四","author":"蜀成王","text":"漏残鸡唱曙光时，壁月穿花影渐移。\n欲画愁眉羞对镜，黄鹂飞上万年枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18437,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其二十五","author":"蜀成王","text":"宫墙西望对残霞，结阵翩飞绕暮鸦。\n帘幕飘摇风动处，有情双燕自归家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18438,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其二十六","author":"蜀成王","text":"绿竹翛翛隔短墙，黄昏凄雨洒潇湘。\n梦回窗掩银釭冷，蟋蟀声中秋夜长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18439,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其二十七","author":"蜀成王","text":"人人都道得神仙，那得郦阳甘谷泉。\n何似上阳宫监好，长门春老不知年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18440,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其二十八","author":"蜀成王","text":"淅淅凄风匝凤帏，琐窗那得见晴晖。\n廉纤微雨侵阶湿，嗝嗝横空啄木飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18441,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其二十九","author":"蜀成王","text":"金锁重门静院空，翠华一去寂无踪。\n玉楼歌吹随风断，满地桐阴泣泪红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18442,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词一百首（今录三十首） 其三十","author":"蜀成王","text":"白雪漫漫积禁堤，夜寒宫月照玻璃。\n晓来宫女喧看处，扫向盘中捏狻鹥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18443,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"步虚词二首 其一","author":"肃靖王","text":"瑶坛深处磬声微，羽客朝元午夜归。\n杳杳三山青鸟过，翩翩双舄彩凫飞。\n岛间月色明珠树，洞里丹光透玉扉。\n剑佩几回翔碧落，天风吹冷六铢衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18444,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"步虚词二首 其二","author":"肃靖王","text":"彩霞琪树共氤氲，七色班虬驾鹤群。\n玉佩冷摇沧海月，霓裳晴带绛霄云。\n碧桃花绽春方永，金鼎丹成火自焚。\n清夜朝元向天阙，空歌声在始清闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18445,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]