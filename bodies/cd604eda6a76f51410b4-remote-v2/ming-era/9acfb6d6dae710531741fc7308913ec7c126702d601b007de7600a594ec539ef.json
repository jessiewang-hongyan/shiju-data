[{"title":"任公祠","author":"王稚登","text":"萧萧遗像锁荒祠，尚忆孤身百战时。\n诸葛事繁那得久，留侯貌弱到今疑。\n绛帷香气衣冠暗，石栋斜阳薜荔垂。\n曾是当时骑马地，烟中往往见旌旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5159,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"癸亥元日","author":"王稚登","text":"残腊阴阴雨满城，今朝元日是新晴。\n酒楼日冻南山雪，柳岸天寒远墅莺。\n宝剑千金五陵侠，银筝一柱十年情。\n从来王粲多流落，问舍求田只未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5160,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新春感事","author":"王稚登","text":"信有清风不厌贫，吹帘入幌转相亲。\n红颜薄命空流水，绿酒多情似故人。\n服药难辞星入鬓，闭门长与竹为邻。\n黄金散尽真堪惜，前日亲知是陌尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5161,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"种豆","author":"王稚登","text":"庭下秋风草欲平，年饥种豆绿阴成。\n白花青蔓高于屋，夜夜寒虫金石声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5162,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"华阳洞（采真篇）","author":"王稚登","text":"百亩丹厓秀玉屏，山深日暗昼冥冥。\n黄冠指路香先入，蜡炬穿云火半青。\n仙家白鹿行千里，洞口青天似一星。\n安得真人开石壁，云中鸡犬洞中听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5163,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"看梅过玄墓山中二首（以下梅花什） 其一","author":"王稚登","text":"人似梅花瘦，舟如兰叶长。\n青山十亩白，流水一春香。\n种密人难入，开齐夜有光。\n苔枝容我折，野老不嗔狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5164,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"看梅过玄墓山中二首（以下梅花什） 其二","author":"王稚登","text":"桥外花开日，分明雪作图。\n不将他树杂，未有一家无。\n多处半青嶂，香时过太湖。\n浊醪元易得，市远亦须沽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5165,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上梅花歌四首 其一","author":"王稚登","text":"家家山色对春湖，日日春风听鹧鸪。\n门前杨柳藏鱼市，屋上梅花当地租。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5166,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上梅花歌四首 其二","author":"王稚登","text":"山烟山雨白氤氲，梅蕊梅花湿不分。\n浑似高楼吹笛罢，半随流水半为云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5167,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上梅花歌四首 其三","author":"王稚登","text":"虎山桥外水如烟，雨暗湖昏不系船。\n此地人家无玉历，梅花开日是新年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5168,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上梅花歌四首 其四","author":"王稚登","text":"闻道湖中是两梅，尽山千种一时开。\n估客片帆春雨里，载将香气过湖来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5169,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"支硎寺看梅听僧家吹笛","author":"王稚登","text":"梅引何郎兴，山余支遁名。\n寒泉似陇水，僧笛学羌声。\n一雨花林寂，无人山殿清。\n年年二三月，繁丽不堪行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5170,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"天平道中看梅呈陆丈","author":"王稚登","text":"新春日日雨霏霏，雨后寻春愿不违。\n花近翠微苔作树，人行香径雪生衣。\n折从野岸俱无主，开入僧家尽掩扉。\n谁似丈人能好事，冲风踏冻不言归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5171,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新秋饮顾汝所斋中夜归作（以下《燕市集》，嘉靖甲子）","author":"王稚登","text":"青槐树树烟，客舍苑墙边。\n羸马饮秋雨，短衣行暮天。\n芙蓉思故国，蟋蟀感流年。\n何事长相见，归来又惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5172,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉答汝南公","author":"王稚登","text":"平津阁上夜题诗，绣牍亲裁与项斯。\n字比宫云俱五色，情将禁柳共千丝。\n袖中携出香偏入，马上看时月故随。\n自是阳春元寡和，莫言寒屋报书迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5173,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中寄顾汝和舍人","author":"王稚登","text":"花间小雨湿衣轻，夜半思君隔凤城。\n尚食宫监邀翰墨，射声校尉识书名。\n斋庐西畔濡毫待，香案前头捧砚行。\n汉武若言封禅事，茂陵今已著书成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5174,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答袁相公问病二首 其一","author":"王稚登","text":"斜风斜雨竹房寒，云里蓬莱枕上看。\n愁过一春容鬓改，吟成五字带围宽。\n书生薄命元同妾，丞相怜才不论官。\n泣向青天怀烈士，古来惟有报恩难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5175,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答袁相公问病二首 其二","author":"王稚登","text":"形骸土木佛灯前，黄阁情深有梦牵。\n喘似吴牛初见月，瘦如辽鹤不冲天。\n诗题半作逃禅偈，酒价都为买药钱。\n知己未酬徒骨立，一生孤负佩龙泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5176,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"将游甬东王青州伯仲见过作（以下《客越志》，嘉靖丙寅）","author":"王稚登","text":"主人出门去，客子入门来。\n主人为客留，若下花前开。\n借问客谓谁，东海王青州。\n一双明月珠，夜照沧溟流。\n人言王家太戆直，灌夫醉骂程不识。\n我谓王家无世情。\n孔融尔汝祢正平。\n烈士肝肠铁一片，安能尽逐时人面。\n时人面好心如云，白衣苍狗须臾变。\n问我马何白，问我车何素。\n知君兄弟有心者，我为悲辛述其故。\n前年射策游都下，腰佩蒯缑骑瘦马。\n黑裘半敝难告人，朱门欲谒无知者。\n汝南相公识我早，握手交欢尽倾倒。\n此日郗超真再生，当时项斯何足道。\n吟成五字愈头风，奏罢一篇称丽藻。\n寻常未遇不自怜，及至相逢方觉好。\n倾都闻知声啧啧，紫闼金门皆接席。\n殿中荐作校书生，桥上推为题柱客。\n刀环筑开司隶门，马蹄阑入金吾宅。\n灞陵醉尉不敢呵，半夜弹筝洛阳陌。\n从来人事有变迁，从来结交无百年。\n我既还家相公没，长斋绣佛学逃禅。\n贝树为庵深巷里，芙蓉起塔小堂前。\n翟公门第寒如水，薛公宾客散如烟。\n千金宝剑何人是，一束生刍若个边。\n今朝絮酒兼炙鸡，明日千山与万溪。\n别君不是无双泪，留向陈蕃墓上啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5177,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宗将军战场歌十首 其一","author":"王稚登","text":"月黑耕人语，隔河见白马。\n知是精灵归，来向庙门下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5178,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宗将军战场歌十首 其二","author":"王稚登","text":"河边枯髑髅，金镞射为窟。\n入时何太深，碎骨始得出。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5179,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宗将军战场歌十首 其三","author":"王稚登","text":"围中鼠雀尽，城里日传餐。\n为鬼已灭贼，何时灭贺兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5180,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宗将军战场歌十首 其四","author":"王稚登","text":"本谓江南乐，佩刀居帐下。\n渔阳饮飞士，无一生还者。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5181,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宗将军战场歌十首 其五","author":"王稚登","text":"将军空血战，中丞深闭门。\n桐乡城北路，流水没孤屯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5182,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宗将军战场歌十首 其六","author":"王稚登","text":"故剑不可收，姓名刻剑匣。\n瑟瑟白杨根，虚空葬金甲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5183,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宗将军战场歌十首 其七","author":"王稚登","text":"射尽白羽箭，战士不肯去。\n春来草痕赤，旧日留血处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5184,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宗将军战场歌十首 其八","author":"王稚登","text":"有家全募士，无骨可封侯。\n负却生时相，班超是虎头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5185,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宗将军战场歌十首 其九","author":"王稚登","text":"结发为飞骑，相从霍冠军。\n征南诸将士，枯骨论功勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5186,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宗将军战场歌十首 其十","author":"王稚登","text":"沙场大黄弩，将军在时射。\n贼人得之惊，一挽一百石。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5187,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟中与建初话旧","author":"王稚登","text":"十载行藏半未齐，闻君论旧益凄凄。\n汗从何晏朱衣拭，书觅羊欣白练题。\n歌是《竹枝》容易和，泪成珠子不轻啼。\n干将已是徐君剑，明日扁舟下剡溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5188,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石门曲三首 其一","author":"王稚登","text":"采桑复采桑，蚕长桑叶齐。\n妾住石门东，郎住石门西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5189,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石门曲三首 其二","author":"王稚登","text":"蚕成桑叶空，门前青绩长。\n一半织郎衣，一半结鱼网。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5190,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石门曲三首 其三","author":"王稚登","text":"卖丝家复贫，哭解红罗襦。\n将丝贯妾泪，可得作明珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5191,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"塘栖","author":"王稚登","text":"水阔雨溟溟，飞帆去不停。\n人声两厓断，鱼市一江腥。\n云已辞吴白，山初到越青。\n侯生数行泪，千里吊玄经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5192,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"钱塘夜泊","author":"王稚登","text":"孤舟三日雨淙淙，夜泊钱家旧建邦。\n桑过石门青拂枕，水经靧李黛含窗。\n六桥花尽休携酒，五月潮平好渡江。\n此去报恩惭烈士，匣中龙剑气难降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5193,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陆丈移官海丰丞","author":"王稚登","text":"官舍有余清，无言政未成。\n头从湖上白，水在橐中轻。\n过鲁无鱼食，归吴借马行。\n簿书期傥暇，一问济南生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5194,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"李舍人孤山草堂坐雨","author":"王稚登","text":"笋舆行过断桥来，楼上银罂水上开。\n白鸟数行犹似鹤，青山五月已无梅。\n雨昏不辨丝千缕，湖绿浑疑酒一杯。\n几欲题诗题未得，舍人元是谪仙才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5195,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠顾杭州贞叔","author":"王稚登","text":"才高谁识顾君平，身着青袍世所轻。\n杨柳不曾湖上看，芙蓉元在幕中生。\n马头云断家山色，官舍潮连夜雨声。\n流水白云心尽折，丈夫辛苦为微名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5196,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"紫阳庵丁真人祠","author":"王稚登","text":"丹壑断人行，琪花洞里生。\n乱厓兼地破，群象逐峰成。\n一石一云气，无松无水声。\n丁生化鹤处，蜕骨不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5197,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"会稽道中","author":"王稚登","text":"江东名郡古无双，处处青山照玉缸。\n竹箭一流明客枕，芙蓉两岸夹船窗。\n清猿夏断稽山庙，急雨朝平孝女江。\n此地何须叹沦落，买臣头白始为邦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5198,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭袁相公二首 其一","author":"王稚登","text":"泪痕如雪荐生刍，千里风尘酒一壶。\n伯道遗孤安得有，中郎少女亦曾无。\n麒麟乍刻惟新冢，乌鸟空啼是别雏。\n生事萧萧何必问，坂田硗石半无租。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5199,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭袁相公二首 其二","author":"王稚登","text":"鹤飞蝉蜕总成尘，欲报明珠未得伸。\n山上杜鹃花是鸟，墓前翁仲石为人。\n黄肠诏出东园赐，白骨家余南巷贫。\n为问翟公门下士，死生谁个见情真？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5200,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中同诸君游东钱湖","author":"王稚登","text":"乱厓层壑水粼粼，一见渔舟一问津。\n修竹到门云里寺，流泉入袖雨中人。\n地从南渡多遗恨，湖比西家亦效颦。\n酒似鹅黄人似玉，不须深叹客途贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5201,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"平望夜泊四首 其一","author":"王稚登","text":"鱼鳞成石量，桑叶论斤卖。\n珍重丝网难，家家月中晒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5202,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"平望夜泊四首 其二","author":"王稚登","text":"雨多杨梅烂，青筐满山市。\n儿女当夕餐，嫣然口唇紫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5203,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"平望夜泊四首 其三","author":"王稚登","text":"月下压酒声，将船系杨柳。\n明日到家近，不须沽一斗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5204,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"平望夜泊四首 其四","author":"王稚登","text":"店傍栽紫薇，颜色斗江霞。\n我家庭下树，归日正开花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5205,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"还家作","author":"王稚登","text":"游子江东倦行役，还家登堂草盈尺。\n花枝三树四树红，头发一丝半丝白。\n囊中犹自有残钱，尽买杨梅饱食眠。\n门外幸无骑马客，清香细雨佛灯前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5206,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"增翟丈四首（以下《燕市后集》，隆庆丁卯） 其一","author":"王稚登","text":"翟公方得意，结客何纷纷。\n冠盖填巷中，一一皆青云。\n芳兰虽被锄，未尝易清芬。\n胡为平生交，落落不相闻。\n门外寡辙迹，暮雀空成群。\n昔亦一翟公，今亦一翟公。\n世情如浮云，朝异夕不同。\n路傍桃与李，芳菲竞春风。\n不如南山柏，青青岁寒中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5207,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"增翟丈四首（以下《燕市后集》，隆庆丁卯） 其二","author":"王稚登","text":"英雄不可测，屈伸随其时。\n以彼英雄人，亦俟英雄知。\n白龙为鱼服，群鱼反见嗤。\n君昔处东海，浮沉人不言。\n翩翩游帝京，宾从多华轩。\n五侯奉下风，七贵皆扫门。\n黄金白玉璧，赠者不为恩。\n璧以前为寿，金以置酒樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5208,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"增翟丈四首（以下《燕市后集》，隆庆丁卯） 其三","author":"王稚登","text":"君怀一片心，皎如春江月。\n推心置人腹，安得有胡越。\n双锷雌雄龙，报恩未出匣。\n季布诚小诺，朱家非大侠。\n我昔游燕山，丞相礼为宾。\n世皆重丞相，非重幕中人。\n今来丞相亡，相弃如飘尘。\n惟君重意气，不改平生亲。\n悠悠世上交，焉知雷与陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5209,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"增翟丈四首（以下《燕市后集》，隆庆丁卯） 其四","author":"王稚登","text":"长安多青楼，月出吹笙竽。\n上有倡家妇，下有酒家胡。\n十五十六人，双双笑当垆。\n齐姬善击鞠，燕姬善摴蒲。\n左挟外黄女，右拥邯郸姝。\n美玉不为白，胭脂不为朱。\n天然芙蓉花，颜色与世殊。\n与君各青鬓，及时为欢娱。\n安能局促行，学彼辕下驹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5210,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"志哀寄吴氏二首 其一","author":"王稚登","text":"翾翾枝间雀，谯谯委道傍。\n上为鸺纻啄，下为蝼蚁伤。\n仁者过其侧，拾之归青箱。\n饲以黄金花，五内皆馨香。\n疮痍日以平，羽毛日以长。\n朝栖主人门，夕宿主人堂。\n此雀衔玉环，将以报主人。\n一朝婴世难，主人归黄尘。\n徘徊空庭间，肝肠多苦辛。\n扰扰行路子，此情安可陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5211,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"志哀寄吴氏二首 其二","author":"王稚登","text":"鹰鹯击众乌，众鸟无能为。\n胡然坠蓬藋，自损风云姿。\n虽称六羽翮，零落何所施。\n蜂虿小有毒，螫人人不知。\n昔为众鸟畏，今为众鸟欺。\n既言覆其巢，又已攫其儿。\n覆巢犹且可，攫子当如何。\n哀哀三黄口，泣血纷滂沱。\n好生上帝德，无乃伤天和。\n谁为诉九阍，三面去网罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5212,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"碧云寺月出赠朱十六短歌","author":"王稚登","text":"燕山一片月，夜照白莲花。\n千里万里同为客，三人五人齐忆家。\n与君俱是悠悠者，意气相逢不相下。\n平原侠士能斗鸡，邯郸才人堪换马。\n明星落木乱纷纷，同向山中卧白云。\n秋风乍起黄花塞，明月初生青草坟。\n齐门弹瑟相知少，汉庭执戟郎官小。\n渐离筑傍流水立，干将剑上青虹绕。\n才子风流多落魄，青楼狭邪善谐谑。\n赵玉刻就箜篌柱，蜀绘裂作秋千索。\n禅灯绣佛夜厌厌，半醉能歌阿鹊盐。\n朱公大笑黄金尽，三十青衫一孝廉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5213,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送孙明府之崇明","author":"王稚登","text":"昔年芸歌侣，凫舄向南征。\n官俸鱼租入，衙斋蜃气成。\n问程看日出，到海听鸡鸣。\n地僻无官长，何须束带迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5214,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王和仲归吴门","author":"王稚登","text":"三载都门客，秋风忆故山。\n楚云装共薄，燕草鬓同斑。\n歌逐无鱼断，身随一雁还。\n祇应留滞者，别泪易潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5215,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"驾幸太学恭述","author":"王稚登","text":"璧水钧天乐，桥门卤簿车。\n秋风清道早，朝雨洒尘疏。\n检礼惟行菜，谈经亦坠鱼。\n不知稽古士，献纳更何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5216,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"迎春日集华光禄斋中","author":"王稚登","text":"椒盘出五辛，下马拂黄尘。\n千里周南客，明朝汉苑春。\n草生将去路，花待欲归人。\n君有陶潜禄，犹胜季子贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5217,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日都门看早朝二首 其一","author":"王稚登","text":"春日满皇都，春云乍有无。\n五更齐玉佩，万户共桃符。\n天出临轩语，山当绕殿呼。\n欲知王会礼，先问汉鸿胪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5218,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日都门看早朝二首 其二","author":"王稚登","text":"万国尽朝宗，天门发鼓钟。\n楼成五干鹊，阙是两芙蓉。\n赋待凌云荐，书堪计日佣。\n不如随仗马，犹得近飞龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5219,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十三日看灯市","author":"王稚登","text":"香气与人烟，纷纷侠少年。\n花过楼外看，灯出市中悬。\n若个春无怨，谁家夜可怜。\n可知爱惜月，趁未十分圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5220,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"碧云寺泉上酌酒与朱十六","author":"王稚登","text":"云中流下不胜清，石濑溅溅只自平。\n宛转浮杯人不醉，潺湲到枕梦难成。\n分厨已足千僧汲，出寺能为十里声。\n同是黄尘骑马客，与君相对濯冠缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5221,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻警","author":"王稚登","text":"交河十月水潺潺，虏骑秋高过黑山。\n六郡平时元近塞，一夫谁个可当关。\n云中太守须重起，日逐贤王未肯还。\n空抱平胡二三策，书生无计谒龙颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5222,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]