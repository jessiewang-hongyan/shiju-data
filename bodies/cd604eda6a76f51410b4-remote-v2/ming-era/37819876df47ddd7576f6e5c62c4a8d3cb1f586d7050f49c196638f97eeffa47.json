[{"title":"会梁幼宁冯稚谟潘胤源黎缜之黄元卿梁璘叔何襄武李伯襄伍国开黎君献诸子送游罗浮之作","author":"欧必元","text":"杖底奇踪物外誇，逢人胜事有丹砂。\n香馀葛令岩前草，采罢师雄梦里花。\n绕树飞禽常五色，下山明月照千家。\n归来社事酬新句，似带峰头片片霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎缜之过饮澹圃","author":"欧必元","text":"开门邀上客，把臂入长林。\n不有求羊辈，安知嵇阮心。\n地幽尘渐远，竹密径疑深。\n况共一尊酒，翛然洽素襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁羲年屡讯余病且有见和书怀之作赋答","author":"欧必元","text":"萧条三径积苍苔，溪上柴门断往来。\n懒不下床经一月，醉凭挥手送千杯。\n五噫暂尔逃名隐，七发堪怜作赋才。\n病里诉弦君莫听，恐惊风雨重徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘生","author":"欧必元","text":"平生重然诺，一饭未曾忘。\n结客倾三辅，雄心在四方。\n千金等瓦砾，七尺任风霜。\n为问绳枢子，何如侠骨香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"紫骝马","author":"欧必元","text":"带月饮长城，临风嘶汉营。\n身经百战后，名以十年成。\n不傍将军泣，偏从伯乐鸣。\n朝来看蹀躞，肠断猎胡缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"关山月","author":"欧必元","text":"三秋空雾烟，万里吊婵娟。\n寂寂闺中望，迢迢塞上圆。\n梦隔应难到，霜寒况不眠。\n何须琵琶曲，笳鼓亦凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"折杨柳","author":"欧必元","text":"一经霜雪后，摇落不成丝。\n万里歌杨柳，千门唱竹枝。\n赠郎沾絮手，羞妾画时眉。\n何羡垂条早，空怜攀折迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荡子从军","author":"欧必元","text":"飞扬出苏城，辛苦事幽并。\n拚尽英雄骨，输谁荡子名。\n但知谋国事，不复顾家声。\n藉甚图形阁，麒麟总未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邯郸贫女","author":"欧必元","text":"十载工蚕织，邯郸是妾家。\n开帘拜新月，低首惜容华。\n东壁难分照，西邻但落花。\n纵令嫁胡虏，不敢怨琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采莲曲","author":"欧必元","text":"采莲朝暮去，徒事挹香芬。\n心苦那如妾，蓬飘莫是君。\n渔舟沿浦入，人语隔溪闻。\n最恨无情水，东西两岸分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长门怨","author":"欧必元","text":"昼长悲酷夏，夜静怨残春。\n鸾镜羞看面，蛾眉最误人。\n恩随流水远，愁逐枊条频。\n月色千阶满，谁家弦管新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陶少府懋仁挽章","author":"欧必元","text":"风雨萧萧古白杨，七哀何处不心伤。\n魂依越鸟声犹切，泪比鲛人恨更长。\n三径旧荒无滜菊，千年遗地有甘棠。\n莫将交态疑生死，请诵君家自挽章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送潘光禄子朋使汴还朝二首 其一","author":"欧必元","text":"主恩偏宠汉臣才，奉使行看拥传回。\n入洛潘安名并美，游梁枚乘赋应裁。\n逍遥立尽嵩山雪，折赠心悬庾岭梅。\n若向都门论鞭弭，黄金谁为筑燕台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送潘光禄子朋使汴还朝二首 其二","author":"欧必元","text":"岳色罗浮旧有名，牂牁长绕粤王城。\n交南莫羡充庭贡，合浦犹悬夜月明。\n未定杀青他雨事，空深浮白此时情。\n临岐最畏闻江笛，一曲关山何处声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春同陈贵博泛舟因忆族兄羽仲","author":"欧必元","text":"落日放小船，春花媚眼前。\n山高云出树，岸阔水浮天。\n但取青尊醉，何妨白昼眠。\n萋萋江上意，池草梦空悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答罗友国","author":"欧必元","text":"岁隔嗟音讯，春来恋物华。\n别君能几日，两度开梨花。\n旧好纷如雨，新诗字带霞。\n相思不见处，明月映窗纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37422,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再寄屠仪部纬真先生二首 其一","author":"欧必元","text":"太史常占紫气连，知君已变姓名传。\n寻仙定策卢敖杖，载妓应无范蠡船。\n海上书邮何日至，歌中乐府近成编。\n人情俗态都销尽，独有词锋未断缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37423,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再寄屠仪部纬真先生二首 其二","author":"欧必元","text":"中原回首事堪多，漫说人间有大罗。\n岱岳星临移白日，昆崙天尽拆黄河。\n三都赋就看谁待，七叙书成奈尔何。\n生不邀灵求一字，枉教慈氏说降魔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37424,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄答伍长卿","author":"欧必元","text":"与君俱失意，一别隔清秋。\n落日竹窗下，怀人天际头。\n焚香犹觉懒，操笔已含愁。\n欲采芙蓉去，寒江不自由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37425,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫怨二首 其一","author":"欧必元","text":"银汉清秋夜正长，天街寒色白如霜。\n妾身愿托长门月，夜夜应随玉辇光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37426,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫怨二首 其二","author":"欧必元","text":"蛾眉偏妒合欢宫，汉主当年事不同。\n今日君王犹未识，枉教团扇怨秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37427,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中得何叔子龙友书问却寄四首 其一","author":"欧必元","text":"臈近山梅欲放时，看花无地不相思。\n愁中乍别怜三月，江上何缘寄一枝。\n肝胆自销尘客梦，风云应共故人期。\n开缄欲语情偏剧，对月长吟水部诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37428,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中得何叔子龙友书问却寄四首 其二","author":"欧必元","text":"高馆华灯夜夜过，竹阴萝月醉颜酡。\n飞扬竟付尊前发，涕泪翻从别后多。\n莫笑酒狂辞入社，虚教谈辨有悬河。\n只今把剑无聊赖，安得同君和铗歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37429,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中得何叔子龙友书问却寄四首 其三","author":"欧必元","text":"自从诸子各离居，门外蓬蒿掩敝庐。\n乐饵仅扶皮骨在，世情应共鬓毛疏。\n愁肠未理三冬业，空谷宁投片字书。\n不是感君怜意气，一时同调有谁如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中得何叔子龙友书问却寄四首 其四","author":"欧必元","text":"萟苑风流几弟兄，握中谁更擅连城。\n淮阴信是无双价，骠骑何惭第五名。\n倚马向曾操健笔，挥戈今见夺前旌。\n昂藏七尺看俱在，与尔同驱万古情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卧病村居寄李四伯襄","author":"欧必元","text":"经时萧瑟卧江村，乱竹长楸自闭门。\n幸不为贫销侠骨，所怜因病益愁魂。\n江枫落处溪溪叶，寒月光时夜夜尊。\n沉醉思君君弗见，高阳虽在可谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步韵奉和明府倪公经家虞部故居之作","author":"欧必元","text":"东阁官梅旧有名，霜寒门外一枝横。\n看花欲拟同心赋，闻笛犹悬异代情。\n已向青山怀谢脁，还将白璧问虞卿。\n君侯虎视中原日，风雅循良共著声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37433,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小除夜潜舟出清溪","author":"欧必元","text":"扁舟乘夜出，恋恋水云间。\n雾涌天为海，江迷树作山。\n年虽犬马长，心愧鹭鸥閒。\n不敢向人语，兹行何日还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37434,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"任山人玉明招同郑司理诸君游山余以风雨不果赴","author":"欧必元","text":"十年看汗漫，浪迹寄江湖。\n入社惭居士，登高愧大夫。\n烟霞迷短径，风雨散平芜。\n赖有新题在，村醪可再沽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37435,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈山人景文归自蜀中将韩宪副叔捷书问至留宿斋中","author":"欧必元","text":"书邮悲万里，今日喜逢君。\n鸟道犹堪画，猿声不可闻。\n缄题疑带雨，宪府若连云。\n莫问风尘事，谈诗坐夜分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37436,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张明府端孟以茂名最入五羊阻风江上先枉诗见寄奉答二首 其一","author":"欧必元","text":"经年常抱病，一榻寄岩隈。\n见说双凫至，能飞尺素来。\n开缄销岭雪，把赠折江梅。\n袖里看明月，俱从合浦回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37437,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张明府端孟以茂名最入五羊阻风江上先枉诗见寄奉答二首 其二","author":"欧必元","text":"弹琴邑宰日，况是政初成。\n欲奏清商曲，先传白社声。\n惊飙疑振木，流水若含情。\n不遇知音侣，兹弦那复鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37438,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁进士器圃出宰景陵","author":"欧必元","text":"才子新为令，承恩出沔州。\n波翻湖上月，气结蜃中楼。\n自和阳春曲，将无赤壁游。\n所欣循吏泽，风俗未全偷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37439,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答王百谷见讯十韵","author":"欧必元","text":"家住罗浮下，梅开万树春。\n扬州官是阁，水部句还珍。\n自失歌燕市，唯知问海滨。\n微名尘外世，现迹幻中身。\n交儗生前定，情缘死后真。\n斯人不可作，吾道岂沉沦。\n碑有中郎想，文非到溉嗔。\n三年坟草宿，七字锦囊新。\n高谊应酬剑，卑栖厌负薪。\n竹林风度在，莫笑阮家贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37440,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中宿篇送朱少襄入燕","author":"欧必元","text":"君不见中宿峡前飞来寺，十九之峰称福地。\n浈水徐看两岸流，禺山夹对双屏峙。\n古来怪迹此地多，门深树密垂藤萝。\n洞中秪合寻孙恪，石上犹闻想达磨。\n五色榴花香复歇，千寻金锁沉还绝。\n天巧宁能夺物工，地灵应预开人杰。\n近日朱生颇好奇，十年飞梦应幽期。\n寻山不惮登陟远，开凿能穷造化私。\n竹里邀僧堪结夏，池边留客频传斝。\n读书几载不出门，作赋宁推扬与贾。\n一朝天子下诏书，雄心直慕承明庐。\n出山不必作小草，侯门不必曳长裾。\n此去长安千万里，功名富贵徒为尔。\n白首谈经未释褐，高名虚挂人间齿。\n丈夫得意自骞腾，有诗可赋山可登。\n醉舞腰间三尺剑，千秋事业几人曾。\n尊酒送君粤南国，春月春花等闲乐。\n綵笔纵堪题凤凰，故山谁更思猿鹤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37441,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭刘道子十绝 其一","author":"欧必元","text":"少小乡闾雅负奇，挥毫立就万言诗。\n希心太古操元韵，更骂吴趋作竖儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37442,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭刘道子十绝 其二","author":"欧必元","text":"科斗兼穷禹穴文，坐中醉笔自缤纷。\n不书公子罗襦带，定写佳人白练裙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37443,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭刘道子十绝 其三","author":"欧必元","text":"风流萟苑顾长康，遗技看君复擅场。\n笔底惊人今已绝，向来屏障失辉光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭刘道子十绝 其四","author":"欧必元","text":"史乘还推属校雠，七星岩畔志端州。\n人间未尽如椽笔，天上俄成白玉楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭刘道子十绝 其五","author":"欧必元","text":"何事公荣取世讥，刘伶犹及竹林期。\n从来礼法难拘束，笑杀高阳轻薄儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭刘道子十绝 其六","author":"欧必元","text":"朝朝暮暮醉青楼，何似谈家姊妹愁。\n一自行云过巫峡，倦颜衰态为谁留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭刘道子十绝 其七","author":"欧必元","text":"白虹山下社莲开，强为攒眉赴几回。\n今日纵饶春酒熟，尊前那复见君来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭刘道子十绝 其八","author":"欧必元","text":"尺素频来墨未乾，斋头时得奉清欢。\n灯前试检题纨迹，风雨冥冥那忍看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭刘道子十绝 其九","author":"欧必元","text":"高堂泣罢白头时，寡鹄啼霜怨更悲。\n玉树未传天上种，蕙兰应自借连枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭刘道子十绝 其十","author":"欧必元","text":"管弦喧处盛繁华，第五台前月未斜。\n歌舞散时箫鼓歇，笛声空自听邻家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送岭西兵宪李公参藩豫章十二韵","author":"欧必元","text":"萟苑推先达，名家擅八闽。\n汉庭曾射策，兰署久容身。\n重寄绥南服，权分宪海滨。\n霜威行部肃，雨泽沥岩新。\n宪命兼藩命，词臣作岳臣。\n星分三楚地，旆指五湖春。\n立就诗千首，能挥酒一均。\n题名工翰墨，石刻斗嶙峋。\n宾从庾开府，风流贺季真。\n儿童迎竹马，父老待征轮。\n赐履薇垣省，鸣珂帝座宸。\n召归应四岳，调燮任垂绅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答族叔原禹冬日见讯","author":"欧必元","text":"经旬不出户，懒与病相宜。\n璞是荆人泣，狂仍小阮痴。\n云寒归浦晚，菊劲爱霜迟。\n寥落看如此，劳歌招隐诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中襄事先大父母夜起有感","author":"欧必元","text":"松杉漠漠夜啼乌，人静山空月色孤。\n谢尚秪应思散骑，张凭宁敢讶苍梧。\n鹿门旧隐看犹在，马鬣新封好似无。\n寸草未将酬祖德，吞声一夕泪仍枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸卯岁除作八韵","author":"欧必元","text":"云霞开曙色，海国动微春。\n愁自今宵去，年随明日新。\n风光聊自异，乡俗未全真。\n柏酒从家宴，椒盘忆故人。\n观心应不住，夙业岂无因。\n忤世非关傲，怀忧未为贫。\n狂来须自得，事去任时嗔。\n仰视三千界，毗邪无此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕黄伯舆招同关少璋梁羲年族叔原兰族兄羽仲从弟子敬赏玉兰花席上赋玉兰歌","author":"欧必元","text":"柏叶椒花次第开，酒徒词客如云来。\n主人盘盛白玉馔，五色金丝斗胜裁。\n中有玉兰花似雪，迎风含态姿超绝。\n轻盈似带三湘云，微漾疑窥五夜月。\n平生不入里人筵，今日醉君酒十千。\n皓齿红颜不足羡，白衣苍狗殊堪怜。\n莫嗟世界易陷缺，莫笑法轮易旋转。\n人生何必论兴衰，天地能禁几寒暖。\n玉兰朝开绚綵霞，无奈东风三月斜。\n尊中有酒不能醉，呜呼，不见玉兰花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春招傅贞甫邓伯乔戴安仲智上人村游","author":"欧必元","text":"青门频有约，白社岂无期。\n不负渊明酒，应怀远公诗。\n荒村馀橘柚，春水对鸬鹚。\n颇惬幽人契，长吟正在兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"族叔孚伯以诸生请老七十馀得赐爵一级","author":"欧必元","text":"环桥冠带自辉煌，萟苑当年亦雁行。\n南阮向谁誇硕果，北窗时见傲羲皇。\n宅边市近馀虾菜，溪上田丰足稻粱。\n垂老渐多文字癖，赋成休问鲁灵光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠高州文学黄尊元","author":"欧必元","text":"海国题诗寄雁群，双飞春断不堪闻。\n怀中纨扇思江夏，望里毡堂忆广文。\n潘岭药从千岁鍊，浔阳源自九江分。\n诸生门下多玄草，寂寞谁堪儗子云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送傅逊之先生宰容县","author":"欧必元","text":"翩翩傅毅自名家，三仕犹乘八桂楂。\n抛却广文新苜蓿，种多潘令旧桃花。\n山童入市供絺葛，溪女临流浣缝纱。\n安得与君从吏隐，更寻勾漏觅丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送傅贞甫随任苍梧十四韵","author":"欧必元","text":"送君南浦上，离思不堪听。\n秣马途方戒，骊驹唱欲停。\n春流涨江峡，细雨湿扬舲。\n烟是千家暝，峰疑九处青。\n断肠销泪竹，鼓瑟怨湘灵。\n化俗思题柱，移山好勒铭。\n青橦裁女服，绿发趁沙汀。\n月澹江笼雾，天高夜聚星。\n家怀羊是石，诗学鲤趋庭。\n鲁国中牟宰，苍梧左氏经。\n鸿飞遵北渚，鹏运徙南溟。\n万里空抟角，千秋尚典刑。\n但知愁异域，不必叹飘零。\n今夜尊前酒，应无有独醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜怀罗伯图","author":"欧必元","text":"孤灯同枕簟，别后不胜悲。\n事已看如此，心应君独知。\n閒窗微雨夜，江阁落梅时。\n欲共杯中约，翻成梦里疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"讯唐寅仲先生病起","author":"欧必元","text":"不到青门久，闻君善闭关。\n病非销白发，贫为买青山。\n溪静花丛发，林深鸟自闲。\n玄言酬永日，忘却数来还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林少府从周之任句容","author":"欧必元","text":"秣陵从宦地，少府讼庭閒。\n跃马新林浦，寻仙句曲山。\n云连三竺外，人在六朝间。\n何日乘风去，茅君同往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄元一游苍梧","author":"欧必元","text":"乡庐同学日，二十已馀秋。\n及此伤春思，何堪送远游。\n江花邀客骑，明月下梧州。\n是处多红粉，题诗莫上楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"幻上人何龙友梁羲年挟陈吴诸少过饮澹圃族祖经季叔原禹原涑兄羽仲弟子敬嘉实席上同赋","author":"欧必元","text":"桥畔柴扉半不扃，当春风雨昼冥冥。\n玄谈客坐生公石，奇字人非扬子亭。\n傍沼阴垂新柳绿，登楼疑望远山青。\n酣歌况复倾诸少，小夜谁能忍独醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送别何龙友","author":"欧必元","text":"艳艳江上华，郁郁园中草。\n垂垂杨柳丝，睆睆鸣春鸟。\n容华不可常，但恐秋露早。\n物理匪所欢，人宁誇美好。\n聚散自有期，麋鹿应难保。\n与子为弟兄，高衢各振藻。\n徘徊四海间，谁能喻怀抱。\n努力爱良时，忧心令人老。\n嘉会在千秋，荣名乃至宝。\n勖哉同心人，别离勿复道。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"族弟嘉祝以未冠称诗偶读其新作致怀","author":"欧必元","text":"绿鬓吾家美少年，新诗字字可谁传。\n临风莫更思康乐，对草宁无忆惠连。\n兴似春花愁带雨，情如丝柳弱含烟。\n闭门不省寻芳事，独对南窗伴月眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]