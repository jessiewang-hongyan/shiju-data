[{"title":"青霞樵者赠助甫","author":"宗臣","text":"何处樵人拾古沙，石门风雨闭桃花。\n相逢为制秋江笠，摘尽峰头万片霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感遇五首 其一","author":"宋登春","text":"燧后教火食，沿代利欲生。\n佃鱼争朵頣，弧矢遂为兵。\n鸿运乃如此，海波讵能平。\n伊畲抱宿性，聊以澹自营。\n眇躯混群有，乘花归无名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感遇五首 其二","author":"宋登春","text":"周道昔沦丧，凤德遽云衰。\n所赖二三子，微言谅靡隳。\n圣代握元化，人文粲葳蕤。\n苍麟在郊薮，朱为翔崇榱。\n我后贵清真，垂衣询无为。\n广成久己去，至道当咨谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感遇五首 其三","author":"宋登春","text":"凉风从北来，骚屑□南林。\n流云掩徂晖，廖廓结重阴。\n感时长□息，矫□发孤吟。\n河冰知路寒，思远知忧深。\n亹亹行采芝，悠悠念所钦。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感遇五首 其四","author":"宋登春","text":"神龙谢鞭策，猛虎辞羁鞅。\n智哉韩公子，功成不受赏。\n灭迹游人间，抱神而孤往。\n千载独不见，令人生遐想。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感遇五首 其五","author":"宋登春","text":"翩翩瑶台容，穆穆孤凤姿。\n口诵紫霞篇，手弄白蟾蜍。\n赠我昆仑图，兼之青都书。\n去去不可留，灭影凌紫虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白马客","author":"宋登春","text":"白马铁连钱，婀娜珊瑚鞭。\n垂冠明月珠，横剑照秋莲。\n笑买燕姬酒，醉歌易水篇。\n咄哉杨子云，白头守太玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白鼻騧","author":"宋登春","text":"䮍騕白鼻騧，婀娜玉鞭斜。\n锦鞯明春陌，银鞍拂柳花。\n经过剧孟饮，留醉阿奴家。\n日暮旋鸣辔，长安有狭邪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫骝马","author":"宋登春","text":"骝马黄金羁，行行赭电驰。\n三春白日晚，六郡良家儿。\n厉剑龙庭北，解鞍铁岭陲。\n归来朝玉殿，犹把汉旌旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游桃源洞二首 其一","author":"宋登春","text":"一曲渔歌何处听，夕阳欲尽万峰青。\n云间采药扶鸠杖，松下调丹注鹤经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游桃源洞二首 其二","author":"宋登春","text":"渔郎何处问迷津，流水桃花小洞春。\n当日避秦人不见，青山曾见避秦人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公子行","author":"宋登春","text":"茱萸锦带绣芙蓉，千金匕首双蛟龙。\n旋唤燕姬招酒伴，城南蹀躞五花骢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古思边","author":"宋登春","text":"井上梧桐春作花，园中苜蓿初藏鸦。\n少妇流黄挑棉字，将军提剑战龙沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"战城南","author":"宋登春","text":"都护轻车出上谷，健儿饮马长城窟。\n将军昨日战城南，风雨萧萧鬼夜哭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雷家奴","author":"宋登春","text":"不识何人美丈夫，赤须碧眼霍家奴。\n公府长揖三千石，归来调笑酒家胡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠襄阳刘近化山人","author":"宋登春","text":"刘生还着旧纶由，汉上相逢又几春。\n高堂尚有双亲在，且莫谈兵西入秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意二首 其一","author":"宋登春","text":"妾意如幽兰，日远自馨香。\n郎心如明月，夜夜灭清光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意二首 其二","author":"宋登春","text":"妾心如朱丝，久在箱箧底。\n愿为锦瑟弦，无人解调理。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"焦仲卿妻","author":"宋登春","text":"城南寒食女还家，燕麦青青草作花。\n使君莫漫来相问，自是长安有狭斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春游曲","author":"宋登春","text":"江南春草芳，江北柳条长。\n玉面城中女，金鞍塞上装。\n长兄游狭子，夫婿孝廉郎。\n夹毂休相问，持乎慎所防。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侠客","author":"宋登春","text":"南山北山射封狐，白马如飞呼韩卢。\n日暮解鞍招酒伴，腰间脱下金□姑。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白鹄篇送顾五","author":"宋登春","text":"翩翩双白鹄，乃从何方来。\n千里一返顾，万里一徘徊。\n不见王子乔，飞鸣有余哀。\n栖托潇湘渚，毛羽何摧颓。\n饥乏琅玗食，凡鸟长相猜。\n愿得同心侣，联翮舞瑶台。\n徙倚琼树间，回首谢尘埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟古送顾季狂游襄阳二首 其一","author":"宋登春","text":"青春驾言迈，江蓠冒青英。\n吴会有狂且，远托高阳生。\n丈夫抱奇志，岂同儿女行。\n近情恐不任，远怀为物婴。\n南国无伯桃，东海少田横。\n结交古道丧，感激何时平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟古送顾季狂游襄阳二首 其二","author":"宋登春","text":"白日照郊墟，晨风凄中怀。\n为子具尊酒，中怀良不开。\n翩翩孤飞鸿，长鸣向我哀。\n执手汉水上，念子何时归。\n生尚崇令德，死即欣泉台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将之吴越别秦中知己","author":"宋登春","text":"寒亭袅袅紫兰枝，曲池两两鸳鸯羽。\n鸳鸯飞去兰池空，青山一别隔千里。\n秦娥抱瑟歌阳春，□□□酒照离人。\n酒清弦□苦，肠断不堪闻。\n我有相思曲，歌竟恐忧君。\n明朝又向东吴去，含情结思满秦云。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孤鹤篇赠李山人","author":"宋登春","text":"瑶台有孤鹤，远下玉山岑。\n厌兹恶木枝，结巢珠□林。\n饥食青琅玕，刷羽扬孤音。\n仙人王子乔，邂逅论素心。\n携手白云间，相知一何深。\n解携在斯须，相忆秖鸣琴。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"久雨小晴遣闷","author":"宋登春","text":"向壁梳头白，开门落叶黄。\n巫山朝雨歇，楚岫莫云长。\n竹屿诗成后，茅檐酒熟香。\n杖藜看菊圃，随挈小壶觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日野眺简徐荆州","author":"宋登春","text":"春问沙棠楫，寒生杜若洲。\n山云巴子国，江雨仲宣楼。\n岁月余华发，飘零随白鸥。\n谁怜能赋客，刘表在荆州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪南乐应教","author":"宋登春","text":"沙市多新馆，章华余旧台。\n细云熏岸柳，残雪照江梅。\n楚舞花钿丽，吴歈宝瑟催。\n清尊宜落日，作赋子云才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二月还江陵草堂","author":"宋登春","text":"昔别草堂在，重来白发新。\n晓窗檠自短，夜雨榻犹陈。\n猿鹤识吟客，琴尊宜故人。\n梅花还其笑，不厌野夫贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村居秋夜即事二首 其一","author":"宋登春","text":"丰草随鸠杖，长林自鹖冠。\n竹风轻袅袅，花露白团团。\n秋晚雕胡饭，夜凉芋栗盘。\n□儿温笑语，来去问加飧。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村居秋夜即事二首 其二","author":"宋登春","text":"树密多栖鸟，池深足跃鱼。\n江云轻葛冷，山月小堂虚。\n寒竹依阑砌，秋花映石渠。\n流萤何意思，故故绕琴书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日江村寄怀顾五","author":"宋登春","text":"水白鱼虾市，天青鹳鹤林。\n露华浥细草，秋气静遥岑。\n子夜吴门调，幽兰楚客心。\n相思眇何许，日暮大江深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹅池留客","author":"宋登春","text":"园果风还落，草虫鸣不休。\n竹深高阁冷，花密小亭幽。\n白帻留云鹤，青藜狎水鸥。\n一尊同客醉，不用典吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑶瑟怨","author":"宋登春","text":"秋风袅袅石兰长，楚姬拭泪红巾芳。\n苍梧帝子去不返，空留瑶瑟泛潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江楼对月怀郑汝推","author":"宋登春","text":"霜枫摇落早猿啼，愁对澄江送夕晖。\n明月楼寒人不见，相思千里楚云飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过夷齐祠寄别襄垣殿下三首 其一","author":"宋登春","text":"春蕨生兮依依，春薇秀兮菲菲。\n怅远人兮□□，□公子兮忘归。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过夷齐祠寄别襄垣殿下三首 其二","author":"宋登春","text":"云扬兮南山，河流兮潺湲。\n怀王孙兮不见，采薜荔兮烹兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过夷齐祠寄别襄垣殿下三首 其三","author":"宋登春","text":"云袅袅兮行春，望帝子兮忧殷殷。\n揽杜蘅兮河渚，结荷衣兮江濆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长平道中早发言怀","author":"宋登春","text":"流目古战场，白日惊飙驰。\n蟏蛸挂虚牗，寒瓜蔓枯篱。\n玄蝉伤白露，青莎被修池。\n佳人理纨素，行子心伤悲。\n童仆严晨驾，驾言涉丹湄。\n羁旅寡良俦，丽泽当依谁。\n谁为黄雀吟，还歌猛虎词。\n利剑恒在腕，壮心安所期。\n流景不可驻，沉叹将何为。\n欲学腾化术，松子久吾欺。\n人生贵适志，知命复何疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"远别离","author":"宋登春","text":"我出雪溪来，梅花落湘楚。\n湘娥忽而笑，留宿鸳鸯浦。\n鸳鸯浦寒月照沙，两情欢极生悲嗟。\n泠泠逝水送月落，夜长起坐歌兰花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别榆关知己","author":"宋登春","text":"促驾远行迈，迢迢事东游。\n纫兰思楚泽，结荷忆吴洲。\n岖嵚遵怕麓，迤逦凌燕陬。\n所历无停迹，居然隘九州。\n投志在道义，脱剑为谁酬。\n念子宿昔交，欲去复淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓忠教真人山房","author":"宋登春","text":"窈窕白云谷，春芝秀几华。\n醉吟沧海月，笑弄渌江霞。\n丹灶开仙馆，瑶城辅帝家。\n何年骑白鹤，万里觅云槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送嘉禾张山大征伯游大梁","author":"宋登春","text":"芳草年年绿，浮云日日征。\n兵戈游子意，桑柘故园情。\n卖赋金何有，着书名未成。\n时无魏公子，谁复重侯嬴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宋中送客归襄阳","author":"宋登春","text":"相送峓门道，重过古驿亭。\n南行春草绿，一望晚山青。\n乡梦梁台雨，羊裘汉客星。\n鹿门今可问，花月正冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伊阙","author":"宋登春","text":"岸坼临无地，崖县欲堕空。\n松门双鸟下，萝径野泉通。\n禹庙荒垣里，河流砥柱中。\n樵歌起林末，似觅饮牛翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日登钧州西台思登洲兄","author":"宋登春","text":"晴沙初度雁，春树早闻猿。\n野店人烟少，孤村霜露繁。\n年华余白发，棣萼远青尊。\n故园河山北，幽怀难具论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊午杪秋示义儿鲸","author":"宋登春","text":"天地羁愁客，江山去住人。\n悲凉十载事，漂泊一纶巾。\n此日知吾老，他乡独尔亲。\n图南未可料，空负故□侯。\n举鞭辞府长，挥手谢时流。\n愿斩敌人首，为君雪国雠。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少年行","author":"宋登春","text":"谁家年少羽林郎，宝马金鞭从武皇。\n新赐腰间白羽箭，弯弓直欲射天狼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"远游","author":"宋登春","text":"红颜辞旧国，华发尚羁人。\n轩冕非吾愿，风尘老此身。\n梁鸿五噫发，子建七哀频。\n玄阁年年闭，花林□旧春。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠会稽刘世儒","author":"宋登春","text":"刘生多气岸，负剑远行游。\n落日三湘酒，烟花七贵楼。\n右军白羽扇，季子黑貂裘。\n我亦淮南客，因逢桂树留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠东岩主人","author":"宋登春","text":"东岩主人东岩栖，岩花开遍岩东西。\n有时自抱一斗酒，醉约山翁弄玉溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巳未腊月寄李逸人","author":"宋登春","text":"天涯流落客，岁暮欲何之。\n风雪主人少，山村童仆饥。\n巳敦宝剑诺，谁赋白驹诗。\n季子裘虽敝，终看佩印时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再送张逸人","author":"宋登春","text":"烧药频留人，读书只闭关。\n半生为北客，万里一南冠。\n颍水春来别，吴山梦里看。\n明年又秋草，张翰几时还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贻上党程户侯","author":"宋登春","text":"击筑醉燕市，跃马佩吴钩。\n白玉酬歌笑，黄金散故□。\n留滞防人面，凄其损客心。\n春来每起早，兰泽一长吟。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠卖药焦老善奕","author":"宋登春","text":"鬓眉七十强，高卧水云乡。\n还卖修琴药，常余养鹤粮。\n橘中无俗着，肘后有仙方。\n我亦餐霞客，金华访牧羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赠顾逸人","author":"宋登春","text":"吴门豪客美且都，十年负剑游嵩庐。\n黄金百镒俱散尽，方衫皂□行长途。\n江陵帝子爱敬客，旋遗裘马驱狂奴。\n花前醉草三都赋，肘后常悬五岳图。\n转眼看天尔何有，回头大笑沧洲孤。\n而今恐有聊城急，还留一只金仆姑。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上元夜走笔戏简呈忠教主人","author":"宋登春","text":"蒲萄酿，玛瑙钟，小姬裙学石榴红。\n任教刻漏咽铜龙，江陵帝子醉春风。\n醉春风乐复乐月，月下行来花下酌。\n一时枚马俱升堂，君平帘下何寂寞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沙津乐","author":"宋登春","text":"二月沙津江水平，吴船楚榜棹歌行。\n高楼夹岸饶商估，小妓街头鬻唱声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周文美还海上","author":"宋登春","text":"与君非宿昔，同病即相怜。\n凄恻登楼赋，悲凉说剑篇。\n客怀江路永，乡梦海云边。\n迟暮身何有，还留贳酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送俞山人还汉阳","author":"宋登春","text":"落日下平原，秋林白露繁。\n独怜长路客，栖托向谁门。\n卖赋金何有，还家舌尚存。\n剑歌空自苦，江汉有芳荪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吴门顾季狂","author":"宋登春","text":"水落荆门晚，风凉岁欲徂。\n且随梁苑客，好着羽陵书。\n天地终怀玉，江山未卜居。\n何时结萝薜，同钓汉川鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书西园水亭","author":"宋登春","text":"夜合含香发，春蒲出水齐。\n年华随短鬓，客计逐幽栖。\n山鹘窥人落，江云拂户低。\n桃花迷处所，错认武陵溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早起","author":"宋登春","text":"临水惭鱼乐，瞻云忆所钦。\n匣中惟宝剑，世上羡黄金。\n留滞防人面，凄其损客心。\n春来每起早，兰泽一长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荆南怀郑汝推","author":"宋登春","text":"吾忆郑交甫，清狂世其痴。\n留金为结客，买剑赠相知。\n慷慨吴公子，悲歌高渐离。\n风尘淹此日，头白欲何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白石歌送吴九升","author":"宋登春","text":"渚宫杨柳春依依，麦城宿雨朝雉飞。\n南山白石何累累，远道之人胡不归。\n我欲念之心苦悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日送张周二子","author":"宋登春","text":"江汉逢诗侣，云霞送酒杯。\n鸟飞巴子国，水落起王台。\n宝剑知吴客，瑶琴识越才。\n昭丘谁更赋，袅袅暮猿哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪夜期顾山人不至","author":"宋登春","text":"涷合渔樵路，扁舟夜不来。\n江头寒雁灭，城上饥乌哀。\n寥落寻仙客，飘零作赋才。\n明朝风日好，花下且深杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钧州除夕","author":"宋登春","text":"柏酒消寒色，灯花坐夜分。\n醉题招隐赋，懒草送穷文。\n春梦周南客，乡心冀北云。\n缑山有仙子，吹篴静中闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]