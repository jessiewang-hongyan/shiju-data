[{"title":"和公实燕台感秋 其一","author":"黎民表","text":"紫塞霜飘雁影孤，荒台斜日下平芜。\n秦封陇华皆归马，禹贡山川尽剖符。\n一代彝章宗典雅，百年风俗落虚无。\n腐儒策蹇蓬蒿里，空忆文皇起壮图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和公实燕台感秋 其二","author":"黎民表","text":"楚客思君赋澧兰，关山迢递梦来难。\n风前白雁飞飞远，霜后丹枫落落寒。\n碣馆三秋愁桂玉，乡书千里比琅玕。\n蓬茆自是烟霄隔，惆怅无因附短翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和公实燕台感秋 其三","author":"黎民表","text":"桑乾千折抱燕台，岂谓天骄饮马来。\n兵气旋销乌鸟乐，阵云初散鼓鼙哀。\n一时猛将多蝉冕，三黜儒生尚草莱。\n卧病衡门秋又晚，几时东阁待重开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和公实燕台感秋 其四","author":"黎民表","text":"岁月升沉销壮心，鬓毛无那百忧侵。\n炎方祇重龙香价，燕市徒捐骏骨金。\n草木凋伤催暮景，风烟萧索变层阴。\n黄花烂熳增愁思，安得琼枝共醉唫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和公实燕台感秋 其五","author":"黎民表","text":"文园遥忆病相如，几度裁诗慰索居。\n西第看花摇綵笔，上林游猎从金舆。\n生逢尧舜功名薄，迹混渔樵计术疏。\n闻道乞身书欲上，圣明应未许悬车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和公实燕台感秋 其六","author":"黎民表","text":"旅食燕台几变秋，才名应愧后时流。\n雁来又值寒砧急，霜落偏惊木叶稠。\n沧海烽烟犹溅泪，杜陵花竹未销忧。\n长安正在浮云外，不为相思重倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读圆觉经","author":"黎民表","text":"中岁驱驰困一经，愧无鲸力破沧溟。\n閒思种树为农圃，病学餐烟养性灵。\n身在尘埃如瞥电，鬓缘愁绪剧繁星。\n年来悟得空王理，止欲除嗔是戒铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同诸贤游矩洲","author":"黎民表","text":"谢公幽兴在云霄，别墅追寻岂惮遥。\n芳柳曲盘深浅水，画船轻送往来潮。\n机心息尽鸥还下，藻思飞时鹤共飘。\n记取临霞欢赏地，后来烟月转空寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邓君肃贻菊","author":"黎民表","text":"穷愁九日偏萧索，别馆清秋祇益悲。\n赤叶已随风外落，绛苞还向雨中移。\n不嫌霜露侵蓬鬓，为爱馨香入酒卮。\n素手折来怜汝意，金茎唫望渺余思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同傅木虚刘安元童仲良游五仙观","author":"黎民表","text":"玉京琳殿海东湄，上客琴尊得共移。\n仙隐已经羊化后，吏情休叹凤衰时。\n池空半落流云影，松古偏馀积雪枝。\n应是丹台曾籍记，喜于莲社结幽期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁戊山人招饮旅馆","author":"黎民表","text":"柏酒椒盘已荐辛，天涯怜尔独逢辰。\n菩提为觅西来种，榆柳重经岭外春。\n风雨几番还秉烛，路岐千里定沾巾。\n干戈此日复满眼，何处飘飘寄此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁戊山人谒先君墓有述答","author":"黎民表","text":"蝉曳疏枝鹤绕林，攀号应废蓼莪吟。\n生刍不负南州约，宝剑多勤上国心。\n指佞尚馀阶下草，将归空有壁间琴。\n平原旧客无人在，今日因君泪满襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太岳仙宫七咏 其一 太和","author":"黎民表","text":"山势盘盘压厚坤，宸居奕奕位大门。\n龙蟠近接三秦胜，鳌负遥连五岳尊。\n丹磴参差悬铁锁，玉京璀璨涌金轮。\n乘麟散发游何处，直以升平报紫元。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太岳仙宫七咏 其二 五龙","author":"黎民表","text":"紫盖峰前下鹤群，羽衣遥挹御炉熏。\n云呈瑞像双鬟玉，帝赐霞裾五色纹。\n星乱石枰当涧隐，风回金磬隔山闻。\n蛰龙一去无消息，怅望经台日又曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太岳仙宫七咏 其三 南岩","author":"黎民表","text":"七十名区卫紫宫，南岩幽胜若为通。\n亭亭仙掌漙清露，叶叶灵衣御晓风。\n山下烟霞常覆鼎，壁间文字半垂虹。\n欹厓可卜无人买，洗钵焚香事远公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太岳仙宫七咏 其四 紫霄","author":"黎民表","text":"轸翼光芒夜夜垂，洞霄峰势入云危。\n窗间下辨金银气，地底潜通日月池。\n玄水当年非禹迹，赤松今日是尧师。\n祇应上界无人到，输与祠官种紫芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太岳仙宫七咏 其五 玉虚","author":"黎民表","text":"目断仙山岂易逢，紫岩回首有苔封。\n三株暗结黄金粟，九渡深盘白玉淙。\n蕙帐别来惊夜鹤，琅璈归去御时龙。\n茂陵自是秋风客，肠断青骡海上踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太岳仙宫七咏 其六 遇真","author":"黎民表","text":"手把丹书侍玉宸，紫髯萧洒出风尘。\n青羊化后犹存石，白鹤归来尚幻身。\n药市当年曾隐姓，花源今日正迷津。\n可怜物色先朝事，应为苍生访隐沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太岳仙宫七咏 其七 净乐","author":"黎民表","text":"绮寮珠缀冠丹丘，翳凤骖鸾在上头。\n窗外月明秦树迥，槛前风急楚江流。\n天门险涩疑无路，地籁凄清直似秋。\n不是文皇亲指画，湘樊安得翠华游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朝天宫追和乔太宰诸名贤韵 其一","author":"黎民表","text":"竹宫松栝昼阴阴，时有鸾骖下翠岑。\n检玉旧传三殿秘，飞章遥向五云深。\n仙都不与浮尘变，浩劫多愁短鬓侵。\n疑是上霄同谪客，几回清梦得披寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朝天宫追和乔太宰诸名贤韵 其二","author":"黎民表","text":"铺金积翠写神州，羽景还开洞壑幽。\n驰道屡经清跸过，侍臣常奉属车游。\n飞光直射蓬莱阙，霁月犹悬翡翠楼。\n自是丹丘人代里，却从东海说瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴而待候选已久辄诗往讯","author":"黎民表","text":"久待公车未拟回，清时难复卧蒿莱。\n穰侯本忌纵横客，枚叔虚称扈从才。\n尽日悲风传旅雁，到江春色落残梅。\n飘零别我青山去，谁共天涯竹叶杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松岩为钮鍊师赋","author":"黎民表","text":"爱汝结室长松阴，白鹤青猿知隐心。\n丹台窈窕丘壑静，紫芝璀璨烟云深。\n月朗似闻木客啸，风起恍听苍虬吟。\n人间埃世不可住，安得枕流清俗襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮饯徐比部宅时吴舍人李比部同集 其一","author":"黎民表","text":"燕京杨柳花飞日，一上春台望苑墙。\n词客喜同金马署，归心遥滞白云乡。\n鸿疏岭峤音书断，骑绕关山别路长。\n?醉此宵应不惜，众人空自隔殊方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮饯徐比部宅时吴舍人李比部同集 其二","author":"黎民表","text":"征骖欲戒暂徘徊，极目风烟惨不开。\n白社别来频有梦，青山归去独无媒。\n遥祠应待河东盖，作赋多逢邺下才。\n谁向天涯慰寥落，封书须为朔鸿裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"镇海楼登望","author":"黎民表","text":"朱甍画栋逼星河，秋色苍然隐薜萝。\n地转青山开越井，天悬流水下牂牁。\n凭栏渐觉清商变，顾影其如白发何。\n鸿雁有怀成怅望，浮云西北晚来多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"童太史仲良席上邂逅方太守禹绩即有诗见贻奉答一首","author":"黎民表","text":"骏足登台众所称，一麾江汉忌能声。\n明时并数邹枚赋，末路谁收李杜名。\n赤日梦悬鹓鹭署，青山家住凤皇城。\n风流郡阁犹如昨，丽藻应深下榻情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别潘少承之京","author":"黎民表","text":"汀洲渺渺怆离情，塞雁随人又北征。\n燕地楼台云外耸，秦淮花柳日边明。\n才华狗监应知己，家世河阳旧擅名。\n此去君门还咫尺，不须回首越王城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何东莞之任江宁","author":"黎民表","text":"三年坐啸远人安，又绾铜章入禁垣。\n秦地山河归内史，汉家星象应郎官。\n草青梦渚悬帆度，日落关门倚剑看。\n此去公卿求识面，无因停棹采芳兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同公实思伯游北郭诸山","author":"黎民表","text":"澄江一道抱城回，霁后丹梯四望开。\n百粤地形云外出，五陵王气日边来。\n残春风景空回首，故国河山谩举杯。\n留滞莫伤生白发，汉庭今待子虚才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同公载公实思伯登白云最高顶 其一","author":"黎民表","text":"青溪千仞出尘氛，振锡还惊虎豹群。\n游客屡窥丹检字，高僧多卧石楼云。\n风生大壑诸峰应，涧落平田众水分。\n招隐卜居原此地，重来休勒北山文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同公载公实思伯登白云最高顶 其二","author":"黎民表","text":"千岩云气混重溟，竹院松扉白昼扃。\n金锡乍飞游鹤去，贝书初诵毒龙听。\n荒台花雨空留碧，阴洞苔文尚带青。\n浮世始知无住著，长生还欲问仙灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同公载公实思伯登白云最高顶 其三","author":"黎民表","text":"沧凉初日上云楼，金地应悲露草秋。\n龙象岂知千仞换，江山虚道百年游。\n岩前散发思高卧，石上看梅得暂留。\n为道远公能结社，东林岁晚一相求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安期岩","author":"黎民表","text":"绝磴阴阴松栝围，仙宫寂寞见霓衣。\n曾传海上青骡去，谩道山中白鹤归。\n霞起远分丹洞色，日生初弄石门晖。\n浮云变化成今古，谁似凌空一舄飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈公聘宪使提五州兵征海寇有作次韵 其一","author":"黎民表","text":"吴城遥望雪初残，又领奇兵过瘴滩。\n龙节夜驰霜月暗，鸾旗阴曳海风寒。\n关山应叹辞家远，恩遇方知报主难。\n预喜铙歌归有日，封章须献五云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈公聘宪使提五州兵征海寇有作次韵 其二","author":"黎民表","text":"牙璋十月下江城，百万军储计不轻。\n推毂屡颁明主诏，临歧先慰远人情。\n梅花竞落来时路，草色初青战后坪。\n闻道庙廊虚席待，肯论乡国念归程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春","author":"黎民表","text":"倦游宁复走风尘，一卧丘园值早春。\n沧海烽烟连百粤，关门云气引三秦。\n江湖岁晚怜飘泊，松竹年来事隐沦。\n幸有习池供逸兴，愿随南亩狎芳辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嬉春曲陈公载索和用韵 其一","author":"黎民表","text":"东风紫陌走骅骝，何似咸阳纵冶游。\n校猎忽经平乐馆，斗鸡还过富平侯。\n霓裳写月初停拍，绮阁临春尽上钩。\n愁极杜陵惟谩兴，新蒲细柳满河洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嬉春曲陈公载索和用韵 其三","author":"黎民表","text":"奏技当年入汉京，缁尘曾逐丽人行。\n金钿控月三千骑，宝帐临风十二筝。\n西第将军留尽醉，东邻词客寄多情。\n茂陵一卧长消渴，犹倚金盘望五城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嬉春曲陈公载索和用韵 其四","author":"黎民表","text":"三星的铄露华光，宛转歌声逐女郎。\n沉水欲销金铪匝，曲璚初卷绣鸳鸯。\n风前调笑思捐佩，陌上含情问采桑。\n惟有扬雄疲执戟，年年空叹鬓丝长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和竹平山人见余庭前桃花","author":"黎民表","text":"庭前桃花开不迟，堤边明月复初宜。\n流莺恰恰坐深树，戏蝶纷纷穿短篱。\n映水红妆仍绰约，临风皂帽故倾欹。\n梁鸿更有挥毫思，好向芳菲倒接篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄王比部元美塞上","author":"黎民表","text":"万里烽烟接塞垣，西风立马望中原。\n浮云尚走陈琳檄，明月还开庾亮尊。\n青草北临沙碛断，黄河秋绕蓟城翻。\n汉庭正是筹边日，谁遣长缨到玉门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘百魁参军脩贡京师事竣还成都","author":"黎民表","text":"仗剑堪嗟行路难，春风一骑发长安。\n愁心万里悬秦栈，壮志三年走汉冠。\n白发自于官序拙，青山不改客途寒。\n相知已向文园卧，飞檄无劳父老看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天津同吴给舍舟中对月","author":"黎民表","text":"独驱嬴马出燕关，咫尺风云敢自攀。\n明月共悬千里外，春阴不散五陵间。\n书生彩笔谋仍拙，诸将黄龙战未还。\n何处忽来杨柳曲，沧江一夜鬓毛斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登直姑城楼","author":"黎民表","text":"吴樯楚舵望中收，西北风烟接上游。\n海气倒垂千嶂远，燕关日抱五云流。\n贾生封事馀双泪，王粲思乡自百忧。\n向夕苍苍洲渚乱，断鸿哀角不堪留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同徐中郎吴给事访李使君郡斋","author":"黎民表","text":"揖客龙门意未轻，北来风雨滞孤城。\n青山不尽檐帷色，浊酒深知傲吏情。\n岂谓汉庭疏汲黯，翻令东海重黄生。\n漫从华发悲留滞，岳牧于今有大名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏五日袁比部携酒访舟中","author":"黎民表","text":"燕京阊阖五云开，袪服晨趋亦快哉。\n萍水敢期仙客棹，榴花还及故人杯。\n西曹词赋留高步，东郭河山得隽才。\n戎马正当挥涕日，可无飞檄自天来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同黄淳甫盛仲交余伯祥过天界寺苇航竹馆","author":"黎民表","text":"东林曾有翠华游，别院风驱万竹秋。\n经品旧从天竺至，禅栖应待许询詶。\n山开气色皇居近，潮转寒声大地流。\n依止空门犹未得，干戈遥动故乡愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集何孔目元朗后亭","author":"黎民表","text":"兵甲黄尘旧路非，相携六月到山扉。\n松间薜荔牵衣过，竹外鹓鸾挟子飞。\n白发尚淹金马署，青云空羡绿荷衣。\n习池共把山公酒，此日应?酩酊归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别仲交伯祥","author":"黎民表","text":"谁怜落魄游千里，尚得长裾狎二豪。\n时论共归江左玉，赋才应折广陵涛。\n当垆夜倚花枝醉，绕树春吟野日高。\n白璧敢轻投赠意，不堪秋雨梦蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀 其一","author":"黎民表","text":"高楼欲上思迟迟，关塞萧条异昔时。\n草木风传金气盛，鼓鼙声入朔云悲。\n管宁东海归何日，梅福吴门去不疑。\n白首烽烟重览古，芙蓉萎绝曲江湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀 其二","author":"黎民表","text":"王气崤函终不改，建章宫殿倏为灰。\n瑶池青鸟犹频降，渥水神驹未拟来。\n丛菊渐荒元亮病，汀兰初歇楚累哀。\n江天鸿雁冥冥去，极目神州首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀 其四","author":"黎民表","text":"旧京形胜郁盘龙，设险曾当百二重。\n组练未收沧海甲，戈鋋犹起白门烽。\n包荒茅服终须问，竹箭空山岂尽供。\n蠢尔鲸鲵看扫灭，属车还拟待东封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀 其五","author":"黎民表","text":"三关羽檄似星流，百万戈船拥上游。\n白昼峡深豺虎卧，青天磴绝旆旌愁。\n孤军铜柱空传捷，苦战昆崙寔未休。\n宵旰此时忧不细，征南诸将莫淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀 其六","author":"黎民表","text":"粤王雄据有离宫，翠竹黄花辇路中。\n五岭山川馀霸气，百年天地变华风。\n沧波日落旌旗动，白露秋高帐殿空。\n庾信江南休作赋，汉家城阙正青葱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀 其七","author":"黎民表","text":"花木栽成带远坰，北山孤绝寄幽亭。\n汉陵岁月移沧海，秦垒风烟断井陉。\n十载栖迟生白发，何人推引上青冥。\n烟波绝把渔竿去，虚拟江湖有客星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀 其八","author":"黎民表","text":"长安旅食岁萧条，金马才人每见招。\n一卧云林淹彩笔，几回沾洒望青霄。\n玉山琼树风尘隔，庾岭梅花驿路遥。\n莫倚甘泉能献赋，衣冠今满紫宸朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石冷为潘新宁赋","author":"黎民表","text":"怜君家住积金阳，海树层层出上方。\n山倚洞天多翠削，窗窥禅月更清凉。\n市喧不到松间枕，瀑水遥添竹外觞。\n何事缁尘淹陆羽，梦回泉石几徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿欧母","author":"黎民表","text":"会稽旧是梁鸿宅，邹邑今传孟母家。\n竹笋自能供白发，橘林应得胜丹砂。\n书传南岳夫人鹤，客问银河织女槎。\n却愧荀陈交谊重，年年来对寿筵花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中过喷玉岩","author":"黎民表","text":"喷玉岩前山翠飞，千丝披拂近人衣。\n青林忽乱蛟龙雨，丹磴长连雪霰晖。\n壶榼动随高士履，桔槔争息丈人机。\n匡庐日暮何如此，醉卧云松未拟归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寻乌利仙人旧迹","author":"黎民表","text":"梦想仙人海上游，欲寻踪迹莽林丘。\n霓裳碧落飞何处，玉趾青山此暂留。\n勾漏丹砂犹未就，蓬莱双舄浪相求。\n峰前明月参差夜，应载鸾笙过十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经山人李子长墓","author":"黎民表","text":"坟前鸟雀啄高枝，过客能传处士诗。\n食肉未为何点累，解酲终笑季伦痴。\n荒山裸葬非违俗，流水浮名尚有碑。\n独鹤不归华表柱，麒麟高冢几累累。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":5936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]