[{"title":"与樾堂子晚步四首 其四","author":"李梦阳","text":"美树沙能秀，高花夏不疏。\n江山百战后，登眺两人初。\n楚月垂鲛泪，燕山涩雁书。\n异时羊续壁，喜接豫章鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55280,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日楚山太华君同登","author":"李梦阳","text":"不入襄阳府，秋山每自来。\n那知楚峰上，还共菊花杯。\n帽落层云迥，风生万壑开。\n却思羊叔子，岘首独悲哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55281,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送郑生南归二首 其一","author":"李梦阳","text":"梁园杯酒罢，江上泛舟归。\n白日孤帆隐，青天一鸟飞。\n路分和靖宅，潮接予陵矶。\n羡尔随玄豹，还山戏彩衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55282,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送郑生南归二首 其二","author":"李梦阳","text":"挂席南风便，烟霞北望深。\n逢人著皂帽，采药鍊黄金。\n五月三江路，扁舟四海心。\n方山有丛桂，谁与结云林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55283,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台书院同边子三首 其一","author":"李梦阳","text":"壶觞聊首夏，文史更孤台。\n地主更来几，登临每复陪。\n径兰迎节秀，岩鸽扑骢回。\n落日凭轩外，苍苍四岳开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55284,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台书院同边子三首 其二","author":"李梦阳","text":"驻赏林红减，登吟野绿围。\n故人率尔遇，时序暗中违。\n气突芒砀断，云低孟泽飞。\n昔贤谁复此，无羡酒酣归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55285,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台书院同边子三首 其三","author":"李梦阳","text":"兴剧攀巍坐，翛然俯日斜。\n亭扶盘石树，崖缀殿春花。\n薜服宾游幰，青衿闪钓槎。\n绸缪不欲别，风野暮鸣笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55286,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"台馆访李秀才濂","author":"李梦阳","text":"李生梁国彦，少小事沉冥。\n春日古台上，独行枫树青。\n花侵映雪壁，鸟下草玄亭。\n野阔看无际，浮云似洞庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55287,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄许监察二首 其一","author":"李梦阳","text":"为问乘骢使，经春北未回。\n句删淇竹写，尊泛邺花开。\n昏晓行山外，风云每自来。\n不知铜雀上，临望几徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55288,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄许监察二首 其二","author":"李梦阳","text":"初拟周三晋，何时巳百泉。\n吏人跳水外，骢马白杨边。\n坐忆孙登啸，行吟卫女篇。\n倒看峰不极，炎日有霜烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55289,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柬黄子二首 其一","author":"李梦阳","text":"约隐情非饰，今归悔即迟。\n田园荒欲尽，亲友半相疑。\n杯酒惟黄子，儒门是白眉。\n可能东郭柳，日往听黄鹂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55290,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柬黄子二首 其二","author":"李梦阳","text":"径菊陶能得，田瓜邵独勤。\n为农消日月，倚杖看风云。\n插柳俄成树，笼鹅忽一群。\n不须忧万事，客至且醺醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55291,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"许君话游感旧四首 其一","author":"李梦阳","text":"几日离泉上，泉香满绣衣。\n坐谈观水事，想见采菱归。\n石柱新留姓，山藜亦借威。\n知君薄朱绂，兴在白云飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55292,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"许君话游感旧四首 其二","author":"李梦阳","text":"泉馆旧曾到，跳珠今若何。\n数年鱼不小，题壁客应多。\n照日输金浪，回风散锦涡。\n君今树菡萏，勿逼古龙窝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55293,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"许君话游感旧四首 其三","author":"李梦阳","text":"亭榭逢君复，源泉改色流。\n喷珠连地涌，仰镜合天浮。\n掇蛤曾兼石，移家欲狎鸥。\n猎心萌自鄙，日往水边头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55294,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"许君话游感旧四首 其四","author":"李梦阳","text":"昔访仙潭鲤，春阴阻独行。\n至今看绝顶，长日有云生。\n尔昨褰帷过，同深把钓情。\n何时掣金鬣，携手万峰晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55295,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬唐礼部见寄二首 其一","author":"李梦阳","text":"万事中年懒，诸人近日疏。\n不忘惟墨客，愿见有音书。\n倚伏休询鵩，生涯且钓鱼。\n问奇终缺酒，不是草玄居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55296,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬唐礼部见寄二首 其二","author":"李梦阳","text":"蹈虎看贤达，攀龙几奋飞。\n长歌百年内，惨淡万情归。\n种竹从过槛，栽桑不虑衣。\n神交古有在，莫遣北鸿稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55297,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠张工部汴上","author":"李梦阳","text":"天意焚宫殿，臣心急栋梁。\n未花辞魏阙，酷暑向咸阳。\n遇我真倾盖，忧时每罢觞。\n尘沙一万里，分手向垂杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55298,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答许监察百泉和章兼泄所感三首 其一","author":"李梦阳","text":"疏迂甘病足，天地合藏身。\n未即辞城市，何缘谢世人。\n恨无山在眼，愿与鹿为邻。\n暑日情真倍，萧萧水石滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55299,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答许监察百泉和章兼泄所感三首 其二","author":"李梦阳","text":"吾门客不到，永昼雀堪罗。\n竹色间巾拂，池凉飐芰荷。\n片云蹙日卷，双燕掠虫过。\n忽忆台端使，诗成只自哦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55300,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答许监察百泉和章兼泄所感三首 其三","author":"李梦阳","text":"睡起看云坐，敲门报吏来。\n受书惊鲤跃，投李得琼回。\n思为源泉剧，辞遵北兴裁。\n不须共林石，三复野情开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55301,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和许监察闻报之作","author":"李梦阳","text":"忽尔西边信，飞传过洛阳。\n几酋齐豕突，何将最鹰扬。\n杀气黄河接，烽烟紫塞长。\n筹兵有谏疏，早晚达明光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55302,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张监察还朝","author":"李梦阳","text":"北极星辰入，山河斧钺归。\n乌争车鹭疾，雨逆盖云飞。\n御柳元摇佩，台花且袭衣。\n圣心虚采纳，忍使谏书希。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55303,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"伏日许君馆亭晚酌二首 其一","author":"李梦阳","text":"暑阁含风暮，林亭透日疏。\n俯池閒白羽，把酒跃金鱼。\n兴触山花发，心同水叶舒。\n孰言台务剧，镇日有琴书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55304,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"伏日许君馆亭晚酌二首 其二","author":"李梦阳","text":"树色寒文簟，池光隐玉壶。\n敞筵真不暑，爱客忽忘晡。\n乌返争栖柏，鱼欢自戏蒲。\n回看阛阓子，天地一洪垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55305,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈左使赴贵州二首 其一","author":"李梦阳","text":"万里洞庭西，秋风入五溪。\n瘴天开斧钺，山驿断虹蜺。\n水出牂牁绕，城深井宿低。\n堂间花树紫，箫鼓阅雕题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55306,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈左使赴贵州二首 其二","author":"李梦阳","text":"郡县收殊俗，封疆托此臣。\n去披炎岭雾，坐使瘴花春。\n獠部知徭赋，夷官学缙绅。\n谁期召伯树，蔽芾五溪滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55307,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早秋监察许君见过","author":"李梦阳","text":"五柳骢偏系，三山雨乍过。\n夏蝉犹咽竹，夕露欲倾荷。\n眷此青云客，怀余白石歌。\n相看恨易晚，灯火发烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55308,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄王赣榆","author":"李梦阳","text":"自汝谪东县，朝朝看海头。\n书才一纸到，别巳十年周。\n日就晚潮落，城浮淮水流。\n知君负楚调，激烈向清秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55309,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄李濂兼呈何子","author":"李梦阳","text":"识汝尘埃际，飞腾步步高。\n许身元稷契，努力更风骚。\n暂亦游香署，终能夺锦袍。\n仲言应过数，万里两鸿毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55310,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄王生","author":"李梦阳","text":"重九书新寄，他时意独伤。\n故山吾别久，篱菊晚谁芳。\n日月徒鸿雁，乾坤尚虎狼。\n松楸围几大，人发泪千行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55311,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬寄徐子秋日登镜光阁见忆","author":"李梦阳","text":"岁晚湖间阁，秋临共尔曹。\n路疑银汉上，身近紫宸高。\n霜色诸天镜，窗风四海涛。\n别离谁复此，槛望独挥毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55312,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠孟明府自桂林量移汶上","author":"李梦阳","text":"少年东邑宰，万里北还人。\n挂巳他时苦，花须满眼春。\n偶逢思宿昔，临别见交亲。\n莫小牛刀试，元为骢马臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55313,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄王子苏州三首 其一","author":"李梦阳","text":"独立望南天，秋空月会圆。\n此时一尊酒，忆尔隔婵娟。\n并马游燕日，孤舟去越年。\n断肠今万里，心折暮江前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55314,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄王子苏州三首 其二","author":"李梦阳","text":"三十乌台使，投冠竟黑头。\n田野是故里，江海有新舟。\n把酒看鸿举，开窗面虎丘。\n不须嘅今古，吾伴鹿麋游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55315,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄王子苏州三首 其三","author":"李梦阳","text":"旧交多鬼录，吾子独仙乡。\n幸自饶强健，何心说庙廊。\n稻输吴郡白，橘足洞庭黄。\n饱饭教儿女，摊书日满床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55316,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄张孟县","author":"李梦阳","text":"同年多出宰，独尔得河阳。\n背郭围王屋，开门对北邙。\n词章前令掩，桃李旧花香。\n何日乘云起，双凫入帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55317,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬徐子春日登楼见寄","author":"李梦阳","text":"三月垂杨合，风花满帝州。\n伊予直北望，尔上几层楼。\n紫塞连天起，黄河抱地流。\n春烟动万里，何处觅前游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55318,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送许监察还朝二首 其一","author":"李梦阳","text":"杯酒岂无友，知音谁复多。\n君今万里去，吾柰好春何。\n路草随轺碧，山莺近驿歌。\n尚思文话地，骢马月中过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55319,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送许监察还朝二首 其二","author":"李梦阳","text":"吾园花烂漫，子特驻骢看。\n偶念明朝别，先违两地欢。\n胜之元执斧，陶氏合投冠。\n去住情俱得，离杯莫放乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55320,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再赠许君","author":"李梦阳","text":"缘岸百花开，楼船三月回。\n人依铁瓮望，鸟避柏乌来。\n礼乐还朝疏，山川画笏才。\n太微遥巳入，新彩近三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55321,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"边君生日来访时近中秋不虞雷雹二首 其一","author":"李梦阳","text":"怪尔生辰日，高轩特过吾。\n秋惊飞雹至，雨逐去云无。\n上寿须君子，同声愧老夫。\n母劳问隐显，乘月有清壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55322,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"边君生日来访时近中秋不虞雷雹二首 其二","author":"李梦阳","text":"雹过天仍雨，庭空晚复雷。\n连床慨往昔，阻马得徘徊。\n暗蕊香宾席，秋灯焰寿杯。\n非君有家庆，肯放夜轺回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55323,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台院阁饯沈子之云南拜怀刘子二首 其一","author":"李梦阳","text":"斗酒重阳后，危楼万里前。\n停云忽蔽地，起鹤故横天。\n斜日留倾盖，疏花影别筵。\n忍看骢马使，遥向碧鸡边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55324,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台院阁饯沈子之云南拜怀刘子二首 其二","author":"李梦阳","text":"岂料吾刘沈，提刑继入滇。\n经过此台上，共醉菊花筵。\n日落杯光动，楼空海色连。\n无论即万里，身世转蓬前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55325,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送侄木甥嘉会试","author":"李梦阳","text":"二子趋南省，同车向北燕。\n苦心冲雁雪，得意伫花天。\n合浦珠光会，丰城宝气连。\n谅怀鹏举志，吐胆凤楼前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55326,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台冬饯翟子三首 其一","author":"李梦阳","text":"野馆逢君日，相逢复惜违。\n暖崖花尚发，冬树果初肥。\n斧钺从天至，家山傍海归。\n悬知称庆处，不独锦为衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55327,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台冬饯翟子三首 其二","author":"李梦阳","text":"邦君荣大礼，星使返三台。\n路指东方入，尊留南郭开。\n馆深私自静，筵暮月还来。\n明日山河异，无言不醉回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55328,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台冬饯翟子三首 其三","author":"李梦阳","text":"为慕梁台胜，纡君驻马观。\n风霜当夜急，楼阁近星寒。\n酩酊犹更独，徘徊数倚阑。\n知君有家国，忍向北云看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55329,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丙子生日答内弟玑","author":"李梦阳","text":"今夜今年聚，谁知骨肉稀。\n汝犹悲燎粥，子岂那于飞。\n对火霜威入，侵杯月色微。\n斗斜灯更续，不是醉无归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55330,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪后寺集夜别王子","author":"李梦阳","text":"僧夜晴游地，月高钟磬闻。\n塔光斜照雪，香气上蒸云。\n客向杯前聚，途于醉后分。\n别离谁不尔，缱绻独斯文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55331,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早春怀上方寺","author":"李梦阳","text":"此寺城中僻，边城野四围。\n青天直塔上，落日称僧归。\n殿古松风入，台春草雪微。\n觅碑吾不懒，所虑鸟惊飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55332,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日过李氏因赠","author":"李梦阳","text":"偶忆孩童日，能禁老大悲。\n向来门巷接，长是酒筵随。\n礼乐儒门旧，风花世路疑。\n不须辞夜饮，春月正逶迤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55333,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送郑生","author":"李梦阳","text":"河水未尽脱，怪尔驾舟还。\n言向金陵去，春登江上山。\n渌波元楚徼，芳草自吴关。\n宝剑男儿在，那忧行路艰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55334,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柬张含","author":"李梦阳","text":"战国侯嬴里，梁园李白杯。\n夏骄惟溽雨，秋弱尚鸣雷。\n病馆经旬滞，归旌万里催。\n别书期早寄，莫俟北鸿回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55335,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"憩长葛端壁寺遇遇使人王卿赍监察毛君诗劄到困顿中口占驰寄亦咎游山之约","author":"李梦阳","text":"远为长葛憩，忽接许昌吟。\n不睹暮云句，那知春别心。\n早花连颍岸，晚日下嵩岑。\n咫尺盟难践，何须问古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55336,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月下柬张含","author":"李梦阳","text":"风餐凉雨过，露坐晚林幽。\n汝对梁园月，孰如金齿秋。\n常星皆北拱，滇海独西流。\n万里清光在，应怀今夜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55337,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张含","author":"李梦阳","text":"明发车南指，滇城更复南。\n秋惊洞庭叶，雪压贵州岚。\n念汝此行远，求官今尚淹。\n保昌山坞侧，好结望京庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55338,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日读王子赴江西时诸曹赠行篇什感赋","author":"李梦阳","text":"接揽江西辔，同怀振铎年。\n匡庐并突兀，鄱水日悠然。\n子进薇花省，子归莲叶船。\n梁园邂逅地，把酒对秋天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55339,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台送张内史侍母还蜀同毛袁监察三首 其一","author":"李梦阳","text":"幸值高秋霁，何愁蜀道难。\n顾瞻知国念，跋涉为亲欢。\n露菊沿江熟，风林过栈寒。\n故园如有梦，应在五云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55340,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台送张内史侍母还蜀同毛袁监察三首 其二","author":"李梦阳","text":"翰苑飞名久，梁园接席初。\n文谈白日下，凉露碧林疏。\n剑阁天真险，巴山锦不如。\n馔亲知尽乐，日日有姜鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55341,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台送张内史侍母还蜀同毛袁监察三首 其三","author":"李梦阳","text":"饮暮不归去，繁台秋正深。\n侍臣轩偶遇，骢马酒同临。\n去国三川路，停云万里心。\n西南雁不到，吾迟尺鱼音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55342,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁丑重九繁台酒集","author":"李梦阳","text":"高会今秋始，重阳逐岁同。\n上台寒日午，开阁古林风。\n且约黄花醉，休嗟白发翁。\n旧游不须问，天际有飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55343,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄王宪使二首 其一","author":"李梦阳","text":"反侧须开县，安危亦仗兵。\n饶山夹岸密，鄱水向秋清。\n部使轻裘入，馀黎里饭迎。\n怪来服从易，为惧靖南名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55344,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄王宪使二首 其二","author":"李梦阳","text":"传尔提刑地，思予揽辔游。\n湖山不改秀，蛇虎向来忧。\n卖剑元能事，褰帷啻此州。\n范公芳未泯，亭在北山头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55345,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄崔内史病还邺","author":"李梦阳","text":"漳浦新归客，文园旧病身。\n乾坤金马外，杖屦碧山春。\n书合虞卿著，耕非桀溺伦。\n汉庭文赋笔，谁及茂陵臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55346,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早春宴黄宅","author":"李梦阳","text":"岐路风花里，乾坤醉眼中。\n事随年共异，春与昔还同。\n相聚今何夕，相看各巳翁。\n夜和杯更暖，休负烛花红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55347,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]