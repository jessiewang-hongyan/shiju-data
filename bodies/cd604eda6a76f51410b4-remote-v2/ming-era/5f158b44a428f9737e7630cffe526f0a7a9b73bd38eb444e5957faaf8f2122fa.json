[{"title":"晋祠祷雨晓行","author":"于谦","text":"晓行数里未天明，路绕汾河听水声。\n斜月带星横远汉，清风传漏报残更。\n中心但愿灵祗格，远道何须父老迎。\n好挽银潢作甘雨，溥沾率土润苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31946,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜四鼓城隍庙合祭群神","author":"于谦","text":"银烛金炉布庙廷，光辉照夜夺繁星。\n共祈霖雨苏群品，普愿天符命六丁。\n造化无私应洞鉴，鬼神有耳亦同听。\n虚空陡觉浓云布，更喜飙轮即渐停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31947,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日公馀","author":"于谦","text":"三边无警静烽烟，客散辕门思悄然。\n池面雨晴荷盖小，庭中日午树阴圆。\n清心闭户看周易，解愠临风鼓舜弦。\n菲薄将何称献纳，两藩旌节漫留连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31948,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庭前葵花盛开诗以赏之","author":"于谦","text":"庭院深沉白日长，群芳无处避炎光。\n独将翠叶承朝露，自吐丹心向太阳。\n夜短不愁花睡去，春归何用蝶飞忙。\n关情相对薰风里，剩把新诗咏锦囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31949,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"并州五月中旬雨未沾足而风气萧然与清秋无异感而赋此","author":"于谦","text":"客怀摇落向并州，五月萧然似九秋。\n午榻清风閒白羽，夜窗寒梦怯黄紬。\n树阴惨地云遮日，岚气飞檐雨入楼。\n离思宦情千万种，都随景物到心头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31950,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"祈雨蔬食","author":"于谦","text":"苜蓿盘中意味长，经旬不近酒杯香。\n亦知厚禄惭司马，且守清斋学太常。\n客底情怀空抑郁，冥中感应岂微茫。\n黄齑百瓮皆前定，助我平生铁石肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31951,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新城请水祈雨有应","author":"于谦","text":"椷香百里叩龙祠，乞得灵泉浸柳枝。\n酌水献花罗父老，吹箫击鼓走童儿。\n神风静默云生石，和气薰蒸雨应时。\n顷刻寰区生意足，从知天地本无私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31952,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病起登楼","author":"于谦","text":"晚来扶病强登楼，迢递山川入远眸。\n紫塞接连沙漠去，黄河还绕郡城流。\n天涯芳草重重恨，风外飞花点点愁。\n往事惊心如梦寐，几回翘首望神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31953,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新柳","author":"于谦","text":"不禁风力强扶持，袅袅楼前舞瘦枝。\n远客临行应著眼，佳人才唱却颦眉。\n飞花未睹漫天雪，弄影先看拂地丝。\n立马树边无限意，黄鹂声在最高枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31954,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过方山","author":"于谦","text":"马蹄历尽万重山，霄汉相离咫尺间。\n白石清泉堪枕漱，丹崖翠壁倦跻攀。\n雨馀林外群芳歇，烟瞑松头一鹤还。\n迢递客途无限意，强将诗句解愁颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31955,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七夕感兴","author":"于谦","text":"烛烬香销夜漏迟，人间天上共佳期。\n女牛有约通银汉，儿女虚传送綵丝。\n月色冷侵丹桂影，露华凉沁碧梧枝。\n客窗孤枕难成寐，卧听谁家玉笛吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31956,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"离京","author":"于谦","text":"亲朋且莫唱离歌，垂老其如远别何。\n白发渐从愁里长，青春半向客中过。\n山寒日落人烟少，月冷江空雁阵多。\n今夜客窗孤枕上，可能无梦到銮坡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31957,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜坐","author":"于谦","text":"银台火冷坠灯花，粉堞霜寒咽鼓笳。\n窗月照来人影瘦，边风吹散雁行斜。\n情多转觉孤怀切，老近生憎两鬓华。\n坐久无聊才就枕，却惊梦里得还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31958,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春昼","author":"于谦","text":"萧条候馆度芳春，暗惜韶光过眼新。\n草色入帘閒白昼，花阴满地隔红尘。\n从知处世若大梦，何用浮名绊此身。\n十里湖边三亩宅，青山应笑未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31959,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渔","author":"于谦","text":"随分生涯一叶舟，利名不到钓竿头。\n桃香浪暖三春雨，木落江空万顷秋。\n渭水西风吹鹤发，严滩孤月照羊裘。\n悠悠往事何须问，酒美鱼鲜醉即休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31960,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"耕","author":"于谦","text":"清时幸作太平民，绕屋田园未是贫。\n数口生涯资五谷，一年辛苦在三春。\n生憎稚子扶犁懒，最爱山妻馈饷频。\n衣食不亏租赋给，幡然何必慕耕莘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31961,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓行","author":"于谦","text":"胧胧淡月带疏星，喔喔残鸡报五更。\n灯火一攒开野店，鼓笳三叠启严城。\n霜凝峻阪鸣驺缓，烧起疏林宿鸟惊。\n风透重裘寒不耐，邮亭驻节候天明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31962,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓清源","author":"于谦","text":"荒城数里半淤沙，衰柳千株集乱鸦。\n道上双驺迎使节，水边一犬吠人家。\n重重山色迷行色，点点霜华入鬓华。\n遥忆江南好风月，客窗清夜梦梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31963,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜寒不成寐起坐观书","author":"于谦","text":"寒夜迢迢恼客眠，更从镫火理残编。\n关情乡国五千里，屈指光阴四十年。\n缥缈帝都红日下，依稀亲舍白云边。\n永怀忠孝何能尽，默默安能守太玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31964,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜坐念边事","author":"于谦","text":"萧然一室如僧舍，秉烛焚香坐夜阑。\n却笑酒酣毡帐暖，谁怜漏永铁衣寒。\n安知天下无三杰，但愿军中有一韩。\n世事关心成感慨，旋移书卷就镫看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31965,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和梅诗二首 其一","author":"于谦","text":"雪中一点笑生春，韫色含香怕惹尘。\n结实须归调鼎手，开花不近冶容人。\n祗缘铁石心肠劲，结得松筠契谊真。\n东阁吟成诗百首，却惊笔力会通神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31966,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和梅诗二首 其二","author":"于谦","text":"一枝邂逅漏先春，不著寰中半点尘。\n铁石心肠贤宰辅，琼瑶肌骨谪仙人。\n独亲和靖能知己，更倩华光为写真。\n此外空山谁是伴，清风明月共怡神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31967,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"塞上即景","author":"于谦","text":"目极烟沙草带霜，天寒岁暮景苍茫。\n炕头炽炭烧黄鼠，马上弯弓射白狼。\n上将亲平西突厥，前军近逐左贤王。\n边城无事烽尘静，坐听鸣笳送夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31968,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜高佥宪病痊口号戏之","author":"于谦","text":"闻君何事病恹恹，镇日焚香不捲帘。\n莫怪药囊尝处苦，还知蔗境老时甜。\n一团清气难随俗，百瓮黄齑足养廉。\n造化小儿从此遁，吉人天相不须占。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31969,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别四川方伯邢景","author":"于谦","text":"十年佐政向中州，一旦超迁宠数优。\n全蜀行沾张咏化，两河未许寇恂留。\n月明巫峡猿争啸，雨过瞿塘水乱流。\n还惜故人成远别，客中无日不登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31970,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立春日感怀","author":"于谦","text":"年去年来白发新，悤悤马上又逢春。\n关河底事空留客，岁月无情不贷人。\n一寸丹心图报国，两行清泪为思亲。\n孤怀激烈难消遣，谩把金盘簇五辛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31971,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏雪","author":"于谦","text":"才聚还消似可疑，天公深意许谁知。\n但令海宇均滋润，不使闾阎起怨咨。\n裁剪六花如有意，斡旋一气本无私。\n登高望远空吟赏，谁和阳春白雪词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31972,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立春","author":"于谦","text":"击罢泥牛物候新，一鞭分与万家春。\n未萌草木先回润，久屈龙蛇渐觉伸。\n对景谩倾银瓮酒，看花遥想玉京人。\n东郊明日迎阳去，蹀躞骅骝踏软尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31973,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立春后寒甚二首 其一","author":"于谦","text":"朔吹号寒激箭锋，初春凛凛似严冬。\n层冰未泮江头水，积雪还迷天外峰。\n閒对青铜搔白发，却思金屋赐黄封。\n关情最是庭前柳，翠黛含颦恨几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31974,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立春后寒甚二首 其二","author":"于谦","text":"坐拥红炉尚怯寒，边城况是铁衣单。\n营中午夜犹传箭，马上通宵不解鞍。\n主将拥麾方得意，迂儒抚剑谩兴叹。\n东风早解黄河冻，春满乾坤万姓安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31975,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春雪","author":"于谦","text":"寒结浓云布晚空，六花撩乱舞东风。\n素娥裁剪无多力，青帝陶镕第一功。\n岁暮祥开三白好，春回瑞应万方同。\n丰年有兆群心悦，题咏应惭句未工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31976,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日怀京师风景","author":"于谦","text":"阊阖风暄瑞霭飘，御沟水满雪全消。\n花迎剑佩趋青琐，柳拂旌旗映画桥。\n一派箫韶仙仗拥，千家帘幕酒旗摇。\n不堪马上春如梦，怅望蓬莱隔九霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31977,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自叹","author":"于谦","text":"平生糟粕数行书，潦倒真成一腐儒。\n天外冥鸿何缥缈，雪中孤鹤太清癯。\n聪明不及顽如旧，少壮无能老更迂。\n览镜自惊还自叹，又添几缕白髭须。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31978,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蚤春登楼遣兴","author":"于谦","text":"千条柳线织春愁，不放韶光入画楼。\n远塞天低云漠漠，长河风静水悠悠。\n十年客路双蓬鬓，万里归心一叶舟。\n南北往来成底事，此身无恙任沉浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31979,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张御史还京","author":"于谦","text":"绣衣东去马翩翩，冀北观风又一年。\n使节遥瞻银汉表，封章先达玉阶前。\n落花飞絮催行色，急管繁弦促别筵。\n老我客中频送客，不堪回首五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31980,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水村","author":"于谦","text":"茅屋三椽徬浅沙，门前蒲柳绿交加。\n凫鹥并宿藏荷叶，蛱蝶双飞绕菜花。\n甘雨一犁滋谷麦，轻烟数里接桑麻。\n晚风天际孤帆客，舣棹来寻卖酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31981,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读脩鍊书偶题","author":"于谦","text":"姹女婴儿只浪传，不知何物是真铅。\n尘寰底处安金鼎，弱水无缘渡铁船。\n玉检谩藏灵宝法，紫阳空著悟真篇。\n死生昼夜皆常理，饥则加餐困则眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31982,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"见白发偶题","author":"于谦","text":"世间白发最无情，才近中年次第生。\n碌碌俄惊四十载，萧萧初见两三茎。\n黄花晚节依然好，金液还丹岂易成。\n贪得由来戒迟暮，何须辛苦事功名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31983,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日即事","author":"于谦","text":"密密榆槐散绿云，萧萧亭馆绝纤尘。\n林莺巧语如留客，梁燕低飞不避人。\n岁月无情催暮景，江湖何处是通津。\n数茎白发笼纱帽，深愧渊明漉酒巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31984,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留别高佥宪","author":"于谦","text":"斯文骨肉最相亲，况复比邻唱和频。\n淡薄年来轻世味，绸缪日久见天真。\n一鞭行色青山暮，两地离情白发新。\n马上思君重回首，落花芳草不胜春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31985,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"太原道中晓行","author":"于谦","text":"星稀月落晓风清，犹听鸡声报五更。\n山势平吞沙漠境，河流曲绕晋阳城。\n天涯何处寻归路，野景无边动客情。\n车骑纵横皆故道，不须候吏远逢迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31986,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐沟道中","author":"于谦","text":"麦陇桑畦远接连，依稀村落动炊烟。\n山溪水漫人喧渡，野寺日高僧尚眠。\n马足联翩疏雨后，客怀寂寞晓风前。\n庭闱缥缈知何处，却望孤云一怅然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31987,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清化镇道中","author":"于谦","text":"琅玕深处翠阴凉，绿树人家水绕墙。\n宿雨润含畦麦秀，南风吹送野花香。\n行人指顾青山远，驻马徘徊白昼长。\n景物虽同民俗异，不胜三叹忆吾乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31988,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟中漫兴","author":"于谦","text":"一叶扁舟驾顺风，黄河九曲路西东。\n沙鸥野鹭飞翔远，岸草汀花点缀同。\n望断归心帆影里，惊回乡梦橹声中。\n推篷独坐无馀事，祗有吟哦兴不穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31989,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初度日感怀","author":"于谦","text":"百事无成两鬓皤，浮生碌碌竟如何。\n开樽庆寿从来懒，抚景兴怀比旧多。\n南极星辰延鹤算，西湖烟雨梦渔蓑。\n门无贺客心如水，卧看窗间日影多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31990,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日行太行山中","author":"于谦","text":"信马行行过太行，一川野色共苍茫。\n云蒸雨气千峰暗，树带溪声五月凉。\n世事无端成蝶梦，畏途随处转羊肠。\n解鞍盘礴星轺驿，却上高楼望故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31991,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日即事","author":"于谦","text":"槐阴凝绿暗阶墀，雨后薰风拂面吹。\n鱼跃乱随新长水，鸟啼争占最高枝。\n纱厨冰簟难成梦，羽扇纶巾渐及时。\n两阃清夷无别事，观书最喜日迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31992,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"许昌怀古","author":"于谦","text":"远树孤城认许昌，偶因风景叹兴亡。\n群心本未忘刘氏，九锡何须假魏王。\n满地烟霏山水晚，一陂秋水芰荷香。\n重论往事知何在，惟有穹碑对夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31993,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过招抚冈","author":"于谦","text":"重嘘炎烬肇中兴，此地曾经募义兵。\n古庙数椽谁下马，崇冈千古尚留名。\n飘风入树林鸦散，宿雨沾泥野草生。\n触景兴怀无限意，不堪回首裕州城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31994,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"余吾道中","author":"于谦","text":"荒村古路人烟少，零落邮亭屋数椽。\n野渡冰生寒雪后，遥山鸟没夕阳边。\n思家怅望频回首，信马徐行懒著鞭。\n归计不知何日定，眼前风景又残年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31995,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再赋严宪副梅花","author":"于谦","text":"莫笑疏花冒冷开，调羹滋味已胚胎。\n数声笛向风前奏，一脉春从天上来。\n清白可能陪雪月，孤高元不惹尘埃。\n暗香真入蛟龙窟，绝胜飘零点翠苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31996,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春寒忆家","author":"于谦","text":"碧纱窗外北风多，镇日轻寒可奈何。\n岁月无情人自老，江山如故客重过。\n桃花深院飘红雨，杜若芳洲泛绿波。\n谩说故园春景好，不堪归计又蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31997,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重过天井关回辙庙","author":"于谦","text":"天井关前策马过，道徬古庙郁嵯峨。\n石留辙迹深如许，道在人心耿不磨。\n残雪初消山似洗，暖风才动鸟如歌。\n自缘景物萦怀抱，莫怪重来感慨多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31998,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长子县与同年彭绣衣会宿而别悠然怀思","author":"于谦","text":"绣衣使者旧同年，文采声华众所传。\n出宪远巡三晋地，行囊不贮一文钱。\n衔杯彼此俱成醉，上马东西各举鞭。\n明日五攒山下路，不堪回首思茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31999,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登楼感怀","author":"于谦","text":"晚来无事漫登楼，曲曲栏干总是愁。\n渺渺乡关何日到，茫茫天地此生浮。\n太行有路东西去，汾水无情日夜流。\n华发苍颜成底事，可能辜负钓鱼舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32000,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈绣衣席上醉归口占一律","author":"于谦","text":"停杯不饮意如何，更漏沉沉夜半过。\n宝篆随风香捲雾，金樽映月酒生波。\n休嫌白发欢娱少，自信青云意气多。\n扶醉归来清兴阔，乘槎直欲泛银河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32001,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻都御史顾公致政有喜","author":"于谦","text":"天上归来两鬓苍，故园草木尽辉光。\n功成却喜恩荣厚，身退从知姓字香。\n林下且消閒岁月，台端犹忆旧冰霜。\n春风诗客从容处，重睹群英会洛阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32002,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻蝉声","author":"于谦","text":"密槐高柳覆华堂，满地薰风白昼长。\n却怪蝉声惊客思，不容蝶梦到吾乡。\n清高最喜含朝露，断续何须怨夕阳。\n蚤晚凉飙天际起，万山秋色又苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32003,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋晚行山西道中","author":"于谦","text":"暮云收尽雨初晴，马首关山路几程。\n落日旌旗迎使节，西风鼓角动边城。\n溪流清见行人影，霜信寒催过雁声。\n最喜田家生事足，村村笑语乐秋成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32004,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日经太行 其二","author":"于谦","text":"路绕羊肠蹑屐跻，万山金碧总堪题。\n举头日月中天近，极目乾坤五岳低。\n自笑盐车骐骥厄，谁怜枳棘凤凰栖。\n欲投古寺禅房宿，喜见僧归落日西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32005,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壁间画潇湘入景","author":"于谦","text":"烟寺微茫几杵钟，渔村斜映夕阳红。\n平沙落雁迷轻霭，远浦归帆趁便风。\n山市微岚孤屿断，江天欲雪暮云同。\n洞庭月色潇湘雨，想像阴晴似梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32006,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"问月","author":"于谦","text":"凭阑笑语问姮娥，时缺时圆意若何。\n底事生成蟾皎洁，谁人种得桂婆娑。\n霓裳旧曲曾传否，玉兔灵丹肯与么。\n不信冰轮高几许，清光能得遍山河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32007,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋风","author":"于谦","text":"萧萧入夜动清商，披拂园林草木黄。\n快意扫除天下热，可人吹送枕边凉。\n荻花枫叶愁江渚，莼菜鲈鱼忆故乡。\n万里碧天云散尽，冲开征雁不成行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32008,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋光","author":"于谦","text":"秋水无痕彻底清，秋山如画更分明。\n雁鸿影里云连塞，砧杵声中月满城。\n映日丹枫辉锦树，傲霜黄菊绽金英。\n不须频上高楼望，此景由来恼客情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":32009,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]