[{"title":"准卿读书僧舍次韵","author":"杨旦","text":"习静耽幽僻，门无五尺童。\n援琴弹古调，挥扇引清风。\n江柳摇村绿，山花倚槛红。\n谈经应坐久，不觉月生东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27906,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新昌道中","author":"杨旦","text":"百里驱驰倦，行行日已西。\n断桥人病涉，危磴马惊嘶。\n春浅寒犹峭，峰回路欲迷。\n岧苕关岭上，极目万山低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27907,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"缙云行台","author":"杨旦","text":"坐久浑忘倦，重门镇日关。\n数株台下柏，千叠案头山。\n校阅何曾暇，驱驰不暂閒。\n丁宁二三子，早折桂枝还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27908,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"祈雨有应","author":"杨旦","text":"久旱妨农务，斋心恳祷时。\n长风振林薄，甘雨遍郊圻。\n天亦从民望，神非贶尔私。\n宦情聊自慰，志喜写新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27909,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过东昌值风雨","author":"杨旦","text":"青帝权旁落，春深尚北风。\n香飘帘影外，梦破雨声中。\n陇麦初抽绿，园花未放红。\n乘流方鼓枻，俯仰思无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27910,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"偶作","author":"杨旦","text":"何处难忘酒，凄风凛客襟。\n长江翻浊浪，白日蔽顽阴。\n秋色千林老，霜华两鬓侵。\n此时无一盏，恨与海俱深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27911,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"会宁道中","author":"杨旦","text":"险路还夷路，长亭又短亭。\n雨潴深涧碧，云抹远峰青。\n景胜诗难写，风狂酒易醒。\n客途晴日少，吾欲讯山灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27912,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"都台莅任","author":"杨旦","text":"内台纲纪地，豸服此初临。\n才薄承恩厚，官高负愧深。\n折冲千里寄，图报一生心。\n邪正题名在，看碑鉴昨今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27913,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"治行","author":"杨旦","text":"从宦虽云乐，离家转觉难。\n关山客程远，雨露圣恩宽。\n酌酒嫌朝醉，收书困夜阑。\n梅花移不得，折向胆瓶看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27914,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"人日晴明","author":"杨旦","text":"海宇占人日，晨光放晓晴。\n云容风外敛，山色日边明。\n灾沴消今岁，清平幸此生。\n乘除天意在，次第望秋成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27915,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乘风小顺发舟","author":"杨旦","text":"挝鼓声初发，扁舟下顺流。\n龙江疏雨霁，瓜步澹烟浮。\n山水迎行旆，风云惬壮游。\n高歌不成调，呼酒酹阳侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27916,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观音阁别意次顾司谏韵","author":"杨旦","text":"江阁凭栏久，停云客到门。\n路回峰欲断，潮落水如奔。\n赠别诗盈卷，开怀酒满樽。\n星槎随使节，霄汉视高鶱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27917,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜过淮安","author":"杨旦","text":"路入淮阴郡，舟航在在通。\n可人千里月，快意一帆风。\n夜静寒犹凛，更深斗正中。\n捲帘催放棹，列炬映江红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27918,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋祀先垄途中口占","author":"杨旦","text":"肩舆侵晓发，日出散林霏。\n木落山容瘦，天空雁信稀。\n孤村流水绕，斜壁断云飞。\n墓祭虽非古，吾亲体魄依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27919,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜坐","author":"杨旦","text":"睡鸭香销月满庭，夜深相对一灯青。\n惊风槭槭辞柯叶，缀露垂垂入户萤。\n孤榻雅宜安警枕，素屏刚好写西铭。\n静中点简吾身事，世路悠悠任醉醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27920,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同寅冯子佩长至陪祀途中联句见示次韵 其一","author":"杨旦","text":"山势巃嵷瑞霭浮，微茫树色五陵秋。\n萦回径路高还下，曲折溪泉断复流。\n野店风寒茶灶冷，荒村日暮酒旗收。\n感今怀古情无限，极目长空动客愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27921,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同寅冯子佩长至陪祀途中联句见示次韵 其二","author":"杨旦","text":"霜华满地印轮蹄，薄酿堪沽可待携。\n一缕晴云生远岫，万幢寒桧护长堤。\n良宵拟借谁家榻，逸兴须留到处题。\n翘首蓬莱应咫尺，烟霏缭绕望中迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27922,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同寅冯子佩长至陪祀途中联句见示次韵 其三","author":"杨旦","text":"驱驰王事独贤劳，北望盘盘石磴高。\n百里风霜朝并马，六陵灯火夜分曹。\n灰飞葭管迎修景，句满奚囊秃紫毫。\n摇曳吟鞭归路晚，宁妨戴月过江皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27923,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜宴归寄谢友人","author":"杨旦","text":"宾主相忘礼数宽，沈沈清夜漏初残。\n纱窗风细银屏冷，锦瑟声微玉指寒。\n囊底无金堪买笑，樽中多酒且追欢。\n归来剩有怀人句，倚遍西楼十二栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27924,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"廖廷陈清明陪祀山行有纪次韵","author":"杨旦","text":"晴光马首散朝暾，松偃虬枝势若奔。\n百卉芬菲三月候，群山拱向五陵尊。\n石田峣崅初耕雨，野寺荒凉半掩门。\n去去山城应不远，青烟起处认前村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27925,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过张茂实主事公署","author":"杨旦","text":"乘閒来访大方家，门掩西风寂不哗。\n竹傍墙阴添稚笋，豆缘篱落吐新花。\n庭无留事休衙早，客有馀情坐日斜。\n娓娓清谈浑未厌，呼童汲井煮新茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27926,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻昕弟秋闱失利诗慰勉之","author":"杨旦","text":"吾子才华自不凡，未应三十尚青衫。\n极知士论推荀爽，惟见乡书荐阮咸。\n云路邅回迷月殿，年光迅速剧风帆。\n祗馀兀坐空斋晚，无限幽怀寄短缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27927,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别丘文元仍次前韵","author":"杨旦","text":"茫茫宦海泛扁舟，载得东风万斛愁。\n谁惜卞和频泣玉，空嗟王粲独登楼。\n翠屏万叠遮闽峤，紫气连空识帝州。\n别后期君无限意，可将身向醉乡游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27928,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日偶成","author":"杨旦","text":"胸中不解著閒愁，公退炉熏伴茗瓯。\n食禄应羞田舍计，藏书宁为子孙谋。\n庭除雨过留残照，帘幕风来送早秋。\n坐久飕飕双鬓冷，呼童整顿旧衣篝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27929,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次吉甫山居韵奉寄 其一","author":"杨旦","text":"流年暗促鬓毛斑，天与高情独爱山。\n藜杖穿云邀鹤去，竹林妨月命童删。\n放开心上功名念，参透寰中义利关。\n回首红尘高十丈，悬知不到翠微间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27930,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次吉甫山居韵奉寄 其二","author":"杨旦","text":"东山草木亦知名，宠辱看来一缕轻。\n乘兴每随流水远，寻幽常有白云迎。\n遥岑过雨青浮黛，弱柳牵风翠拂缨。\n识得淡中滋味好，侯鲭未必胜芹羹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27931,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊坛候驾","author":"杨旦","text":"万柝严更夜未阑，珊珊环佩集千官。\n鹊惊人语移枝宿，马怯霜华立仗寒。\n驰道逶迤通祀殿，崇垣缭绕卫神坛。\n鼓声初静钟声起，天外清光转玉盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27932,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和胡司谏光贞游西山 其一","author":"杨旦","text":"草色青青映客袍，经丘寻壑未辞劳。\n石边流水浮花出，天外危峰拔地高。\n倚马赋诗分险韵，饤盘生菜却邪蒿。\n风光差胜江南否，试为平章一染毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27933,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和胡司谏光贞游西山 其二","author":"杨旦","text":"纵步郊原兴未休，撩人诗景细探求。\n平湖风蹙纹如縠，列嶂岚开翠欲流。\n峭壁留题和藓刻，澹云将雨为花谋。\n何时款段从君后，抖擞尘襟取次游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27934,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闺情次乾叔韵","author":"杨旦","text":"妆阁无人独掩扉，年年病里送春归。\n越罗欲换添香懒，螺黛全消对镜稀。\n薄命自伤同柳叶，多情谁遣下渔矶。\n客途善保千金重，莫为行云误湿衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27935,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中忆再用前韵 其一","author":"杨旦","text":"灾沴潜消乐事厌，寒威转劲火藏炎。\n持杯顿觉芳醪薄，得句时将冻笔拈。\n羽卫森严随白帝，琼瑶散乱妒飞廉。\n欲看雪月交辉处，兀坐空斋不下帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27936,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中忆再用前韵 其二","author":"杨旦","text":"冯夷剪水费工夫，玉殿朝回肃步趋。\n共讶袁安犹闭户，谁怜江革独遗襦。\n状如柳絮因风否，声类春蚕食叶无。\n父老预占来岁稔，赞调元化荷钧枢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27937,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中忆再用前韵 其三","author":"杨旦","text":"谁返东风柳絮魂，一时枯朽尽沾恩。\n漫空解作便娟态，刻地浑无剪烛痕。\n拥彗酷怜和月扫，烹茶拟欲带云吞。\n纱窗此夕明于昼，怪底栖鸡误晓昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27938,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉和京兆兄长雨中留客诸作 其一","author":"杨旦","text":"散彩朝霞雨可占，一庭生意上松髯。\n床头酒滴初分瓮，树杪风微不满帘。\n垂柳飞绵春事老，遥山呈翠晚容添。\n无盐对镜难藏丑，浃背空惊愧汗沾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27939,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉和京兆兄长雨中留客诸作 其二","author":"杨旦","text":"诸公才思总无双，文战谁甘北面降。\n剪烛分题联夜句，呼童煮茗汲春江。\n词源滚滚波翻峡，吟鬓萧萧影照釭。\n坐爱晚凉清不寐，忽惊残月堕西窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27940,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘夔推官","author":"杨旦","text":"穷经不与俗儒同，佐政黄堂喜得公。\n凤阙九重天极北，鲸波万顷郡当中。\n清风好慰蛮黎望，佳政行看狴犴空。\n后夜相思隔烟水，尺书何处附征鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27941,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬乾叔弟","author":"杨旦","text":"杜门不出屡经旬，骨肉天涯有几人。\n只恐多愁宽沈带，何妨无酒漉陶巾。\n半衾幽思徒牵梦，积岁沈疴喜去身。\n休傍他家门户好，可能依旧结芳邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27942,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送吴叔和二尹","author":"杨旦","text":"鹿鸣歌罢识君回，犹忆同随计吏来。\n献赋十年曾待诏，哦松此日独怜才。\n徵科须为生民念，繁剧祇应敏手裁。\n三月莺花春事好，离亭且尽故人杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27943,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和许天锡司谏过李处士山居","author":"杨旦","text":"萝径松关自一家，羡君雅志厌纷华。\n久闻绪论惊霏雪，小筑幽居拟浣花。\n约伴荷锄方斸笋，呼僮支鼎旋烹茶。\n流连不觉忘归去，满地残红落乳鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27944,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄乾叔次原韵","author":"杨旦","text":"天涯踪迹别来疏，姜被生寒思有馀。\n至宝谁能怜楚璞，非才自合老庄樗。\n月明断雁惊孤影，水远双鱼滞素书。\n国恤方殷归未得，故园南望独踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27945,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重九过居庸关","author":"杨旦","text":"叠巘层峦倚晚晴，屹然天设此长城。\n山连雉堞三关险，烽息狼烟万里清。\n何处笑歌酬令节，几人忧乐系苍生。\n凭高不尽登临兴，南望彤云护帝京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27946,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄赠徐德宏分教严州","author":"杨旦","text":"离亭酌酒送君行，发轫青云第一程。\n世际亨嘉吾道泰，心无俗累此官清。\n移家建水梅初放，舣棹桐江月正明。\n为谢故人梁绍甫，缄书莫惜寄同盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27947,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈情归觐得如所请喜而有作","author":"杨旦","text":"客路思亲倍黯然，心旌无日不悬悬。\n八年违养空劳梦，一疏陈情已动天。\n衮衮风尘催去骑，萧萧书剑觅归船。\n承恩幸沐金绯宠，引领诸孙拜膝前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27948,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"途次用王汝洁韵","author":"杨旦","text":"酿雪新寒凛客衣，扁舟载得旧书归。\n波涵月色光相射，帆挟风威势欲飞。\n身外虚名看海市，江边清梦绕神畿。\n八闽望望如天远，定省何堪十载违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27949,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"入京不谒刘瑾又无私觌之礼调补温州有感","author":"杨旦","text":"青天白日此行藏，屈已安能媚左珰。\n十载登朝无寸补，一麾出守有馀光。\n思亲顿觉愁成缕，报国悬知鬓未霜。\n公道式微私贿盛，何时重复旧彝章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27950,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游虎丘山","author":"杨旦","text":"形胜东吴羡虎丘，登山彷佛我曾游。\n讲经台废名犹在，试剑池荒水漫流。\n烟艇江头歌互答，风铃檐外语相酬。\n凭高怀古情无限，极目长空独倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27951,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次王敬止韵","author":"杨旦","text":"分符便向浙东行，于国何尝系重轻。\n蕞尔偏方民力竭，萧然一榻梦魂清。\n年光冉冉惊流转，潮信劳劳惯送迎。\n惟有梅花相慰藉，又将春色到山城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27952,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观迎春百戏","author":"杨旦","text":"箫鼓声中百伎陈，眼看时态一番新。\n村歌野曲浑无调，西抹东涂窃效颦。\n料峭轻寒生翠幕，廉纤疏雨逗红尘。\n太平景象今如此，休向樽前愧负春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27953,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈准卿见和再叠前韵时读书净社寺","author":"杨旦","text":"簿书毛委谩横陈，抚事堪惊种种新。\n禄食谁为明日计，忧怀空寄此眉颦。\n禅房我欲分吟榻，世路君方避俗尘。\n闻说城西风景好，花须柳眼正娇春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27954,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"立春日次韵","author":"杨旦","text":"温饱无心梦亦安，壮怀牢落放教宽。\n江山笑我垂垂老，风雨撩春故故寒。\n宦思若何宜解组，世情如此且加餐。\n东郊按辔看农事，多少穷檐望驻鞍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27955,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨廷采","author":"杨旦","text":"一笑相逢忆昔年，梁间尘榻为君悬。\n半醒半醉花前酒，轻暖轻寒雨后天。\n往事细谈浑似梦，浮生胥晤岂无缘。\n青云更拟同携手，剩借春风送客船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27956,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上元遇雨次廷采韵","author":"杨旦","text":"痴云将雨妒良宵，安得长虹驾綵桥。\n待月不来仙驭远，问天无语帝阍遥。\n风吹柳外寒犹薄，春到人间景更饶。\n坐对梅花成一笑，冷香疏影暗相招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27957,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀归偶书","author":"杨旦","text":"故乡极目渺云山，长啸何当拂袖还。\n缨冕翻为今日累，簿书那得片时閒。\n十年名姓通朝籍，一谪尘寰隔帝关。\n功业无成嗟老大，镜中消得鬓毛斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27958,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重九陪胡侍御游江心寺","author":"杨旦","text":"扁舟棹入水云乡，劫火初销迹半荒。\n华发谁怜陪后乘，黄花何事负重阳。\n郊原过雨群芳剩，燕雀随风万里翔。\n丞相祠前山色好，森森梧竹倚高冈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27959,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游雁宕山次韵","author":"杨旦","text":"鬼斧何年凿地灵，四围山色染衣青。\n乍登绝巘心犹怯，刚脱尘踪眼倍醒。\n花卉一屏初灼灼，风尘双鬓未星星。\n兹游足慰平生愿，醉倚禅床月满庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27960,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游灵岩寺","author":"杨旦","text":"宦途迢递惜年华，野寺行吟日未斜。\n提瓮满分龙鼻水，支铛旋煮雁山茶。\n云开绝壁猿窥果，春到寒岩树著花。\n怪状奇形留胜迹，都将清景付诗家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27961,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴兴舟中次舒大参韵","author":"杨旦","text":"东风吹暖日迟迟，雨足郊原万物熙。\n画舫午炊供菽乳，清江晓汲试茶旗。\n驱驰仕路浑无补，断送春光合有诗。\n窃恐抡才非具眼，道傍樗擽笑工师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27962,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙游有怀准卿奉寄","author":"杨旦","text":"空梁落月思何如，阔别无因问起居。\n春事阑珊残雨外，羁愁襞积五更初。\n江头倚棹帆将卸，竹里行厨酌久疏。\n握手笑谈应不远，聊凭驿使附双鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27963,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"括苍逢旧门隶迎新守因询准卿起居始知卧疾已久诗以写怀","author":"杨旦","text":"千里间关访故人，渴心何止欲生尘。\n放怀可得同今日，卧疾那堪越数旬。\n论古谈今高兴减，批风抹月老天嗔。\n烦君抖擞精神起，共醉东山竹叶春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27964,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观潮","author":"杨旦","text":"江边高阁倚云开，万叠波翻脚底雷。\n暗浪逆冲山口束，怒涛横激海门来。\n凭栏目送孤鸿远，冒险舟看一叶回。\n最恨中流无砥柱，狂澜泛滥满蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27965,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观飞来峰","author":"杨旦","text":"山外飞来有一峰，烟霏深锁翠重重。\n穿云谁凿玲珑洞，倚涧犹蟠诘屈松。\n林樾交阴回俗辙，岩扉半启觅仙踪。\n眼前形胜真奇绝，未必丹青有此工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27966,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"拜岳王祠","author":"杨旦","text":"权奸无状逆天常，和议从容出庙堂。\n朔漠几更新岁月，山河半失旧封疆。\n湖波东注声犹咽，宰木南枝恨未忘。\n忠节凛然千载后，肃瞻遗像炷心香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27967,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈登序班还温陵","author":"杨旦","text":"簪笔螭头侍建章，朝回两袖带天香。\n心无俗虑襟怀净，门掩清风兴味长。\n争为浮名沈宦海，可堪归思绕江乡。\n送君却忆曾游地，清梦时飞九斗傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27968,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送左汝砺宰神木","author":"杨旦","text":"同事南宫忆昔年，分符今又入秦川。\n马谙去路先驱熟，民识邻封旧令贤。\n远岫重重迷晓雾，神松郁郁锁寒烟。\n兹行莫厌边关险，多少疲癃未息肩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27969,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元日候朝","author":"杨旦","text":"东风故故酿轻寒，最喜阳春德泽颁。\n犀甲连云环帝阙，龙媒分队出天闲。\n炉烟缥缈晴光外，扇影参差夕照间。\n去国此心应耿耿，涓埃无补愧朝班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27970,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]