[{"title":"南岳纪游 其十","author":"黄廷用","text":"□似莲形开朵朵，僧家住在藕花心。\n银涛夕泻滋珠蕊，紫雾晴分暖玉林。\n长伴藤萝看虎伏，忽□风雨听龙吟。\n青莲玉井华峰上，安得骖鸾一往寻。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30715,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘潭午节","author":"黄廷用","text":"去年五月离乡国，转眼流华又一春。\n不厌殊方频作客，每逢佳节倍伤神。\n空山旅鬓南州里，落日忠魂楚水滨。\n何必临流悲往事，满江风雨阻行人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30716,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登武当 其一","author":"黄廷用","text":"平生性僻耽名岳，今日探玄有路通。\n绝磴千盘凌过鸟，危栏万丈锁飞虹。\n登天杳在烟霞里，谒圣翛然蓬岛中。\n安得芒鞋分半榻，寻源采药老春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30717,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登武当 其二","author":"黄廷用","text":"太和延袤八千里，天下何如此一山。\n金碧辉煌开帝殿，嵓峦杳霭抱仙关。\n灵鸦万树犹朝暮，神虎千年自往还。\n独立龙泉桥上听，涧流九渡水潺潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30718,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙潭 其一","author":"黄廷用","text":"师兴不雨轸皇情，万乘独先税骑行。\n盥手龙宫鱼鸟避，斋心虎帐鬼神惊。\n千峰雷起含瞑色，百道泉飞迸雨声。\n人意共欢天意得，愿同推戴主群生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30719,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙潭 其二","author":"黄廷用","text":"墨云亭午大于上，倏忽风雷若有神。\n一带江山皆化雨，三秋禾黍转芳春。\n彷徨周旱朝青帝，想像□霖系紫宸。\n岂是终南山上客，秪求真诀作仙人。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30720,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙潭 其三","author":"黄廷用","text":"万年圣泽流天下，云暗鼎湖今几霜。\n水态含青频带雨，峦容积翠绝骄阳。\n骑龙赤汉元图谶，牧马华山此帝乡。\n三箭潭中初一试，从来神武是高皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30721,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠寺丞林肖云函表入贺","author":"黄廷用","text":"亿昨长安逢诞节，叨陪侍从圣人前。\n瑶池龙驭开三殿，文石鹓班祝万年。\n此地瞻天双目断，因君就日寸心悬。\n垂衣高拱彤云晓，拜舞欢声动八埏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30722,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠司寇何沅溪致政","author":"黄廷用","text":"谁说二疏闻汉代，清朝复见一人归。\n春山隐隐新诗社，烟水茫茫旧钓矶。\n逸兴欲寻芳草去，闲情秪伴白云飞。\n分日世路风涛里，曾似先生蚤息机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30723,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠尚仰山巡察苏吴 其一","author":"黄廷用","text":"忆从台省论交旧，踪迹江湖梦亦神。\n渐觉重来知己少，相逢偏爱故人亲。\n明朝揽辔之南国，□□□□□□□。\n□□□□□□□，□□□□□□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30724,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠尚仰山巡察苏吴 其二","author":"黄廷用","text":"□□□□□□□，□□□□□□□。\n□□□何秋草没，荒原枯骨晚鸦多。\n舟中仍习青龙战，车外曾闻白苧歌。\n恩重秪留孤剑在，生平壮志易蹉跎。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30725,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠李中翰给假扫墓","author":"黄廷用","text":"寄荐蘋蘩今几秋，陈情重荷圣恩优。\n黄扉五夜还家梦，白首一心为国谋。\n银汉频承新雨□，春山偏长旧松楸。\n锦衣公子从天下，俎豆光辉香雾浮。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30726,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠矢田王谏议归养","author":"黄廷用","text":"悠悠旌旆逢春色，遥望秦关出凤城。\n献纳久司青琐客，乞归应系白云情。\n悬知百岁为忠孝，愿以一心答圣明。\n何幸及门芳草细，君家元自有蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30727,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠给事方奎山谪休宁","author":"黄廷用","text":"侍臣何事辞丹陛，春水津桥重送君。\n共道隋珠原易辩，谁知楚璞亦难分。\n眼前别绪牵青柳，身外浮名寄白云。\n我自雁峰归凤阙，几时鸣佩复同群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30728,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠祠部陈石溪谪郴州","author":"黄廷用","text":"柳色青青几别离，赠君不觉泪偏垂。\n经年他国调兰日，暮景清朝泣王时。\n晓旆戴星冲楚雁，春帆带雨拂江篱。\n衡湘自昔多迁客，载酒看山且赋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30729,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"司成沈十洲守制家于河之浒丁巳夏佞讯至诸监司招之入城公义不往捐赀觅兵与里人捍禦寇至果不敢犯","author":"黄廷用","text":"避寇人民半入城，淮流呜咽亦含情。\n捐金募士擒生合，仗剑临戎杀气横。\n天上风云应是阵，山阳草木转皆兵。\n两河从此无烽火，何必燕然始勒名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30730,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宝应道中","author":"黄廷用","text":"宝应人家何太苦，今年寇盗两相侵。\n远村近郭青烟尽，剩水残山白昼阴。\n枕藉横尸犹露骨，舟行举目独伤心。\n募兵累岁空糜费，可惜军储百万金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30731,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁巳春日长安","author":"黄廷用","text":"江湖惯作疏狂客，讵意清朝得赐环。\n马上相逢多识面，人间无奈强为颜。\n春来鸟雀过深院，梦里烟霞在故山。\n蛮触可堪空白战，韶华容易鬓毛斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30732,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"琅玡","author":"黄廷用","text":"鸟道萦回岩岫合，人从天上览神州。\n六朝江树犹蒙日，万顷田禾蚤报秋。\n山色半归云洞湿，泉声长绕月溪流。\n于今帝子曾巡御，不似琅玡汗漫游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30733,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉翁","author":"黄廷用","text":"闻道灵均心欲醒，问君何以醉名翁。\n全生天地过臣分，任达江湖与世同。\n春晓山容雕毂外，夕阳鸿影酒杯中。\n酡颜白发偕宾从，为炾黎氓乐岁丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30734,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丰乐亭 其一","author":"黄廷用","text":"由来沃土偏宜稼，一上丰山望可怜。\n半郭树林环涧曲，万箱禾黍负城边。\n春风馌亩欣田畯，秋日分门给社钱。\n忧国至今聊暂减，太平箫鼓乐康年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30735,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丰乐亭 其二","author":"黄廷用","text":"羡此民风何太古，邦人相见每从容。\n田中滞穗堪遗寡，廪衷多稌合庆农。\n酒熟漫寻芳草地，诗成偏在白云峰。\n紫薇泉畔栖霞客，秪有神交一梦逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30736,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"小至雪次韵 其一","author":"黄廷用","text":"参天古柏几重围，苍翠阶前相映辉。\n阳复侵凌梅蕊绽，山空点缀雪花飞。\n纵长晷刻人仍老，不闭关城客亦稀。\n顾我年来双鬓改，逢人岁晚寸心违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30737,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"小至雪次韵 其二","author":"黄廷用","text":"拥书公暇独徘徊，连日江云黯不开。\n倏尔寒山铺玉树，无端平地起瑶台。\n奇当错落全成胜，巧至乘危半忽摧。\n安得负薪岩薮者，频闻黄竹自天来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30738,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁巳九日同寅卿卢涞西戴晋庵登高四首 其一","author":"黄廷用","text":"丰山之上何崔嵬，皇祖曾提甲士来。\n此地恰当龙虎会，隔江遥指凤凰台。\n六朝形胜归真主，百代风流属俊才。\n不必尊前论往事，黄花绿鬓暗相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30739,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁巳九日同寅卿卢涞西戴晋庵登高四首 其二","author":"黄廷用","text":"倚云亭馆郁崔嵬，飞盖交轩的的来。\n吹帽风高怜地主，授衣日落望乡台。\n江淮犹冒鲸鲵苦，关塞谁兼虎豹才。\n不觉感时翻溅泪，流华容易镜中催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30740,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁巳九日同寅卿卢涞西戴晋庵登高四首 其三","author":"黄廷用","text":"晓霁攀萝缘石磴，翠微高处有仙家。\n紫薇泉远堪成酿，黄菊山深尚未花。\n御气凌风天北极，因声过雁海南涯。\n去年京国酬佳节，转盻滁阳又岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30741,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁巳九日同寅卿卢涞西戴晋庵登高四首 其四","author":"黄廷用","text":"旅泊江湖经几载，行踪何处不为家。\n仙郎欲醉须臾酒，神女偏悭烂熳花。\n遥忆故人依日下，谁怜游子在天涯。\n山前草木伤摇落，尚有茱萸湿露华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30742,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蒋侍御毅所尊公以大尹致政寿日寄贺","author":"黄廷用","text":"忽传海外来青鸟，行庆杯中映紫霞。\n芳草伴人频作客，白云何处倍思家。\n已知陶令归餐菊，犹似潘郎学种花。\n遥想鹿门当此日，含情游子在天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30743,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"门士俞应和出守处州道由滁阳留之信宿志喜 其一","author":"黄廷用","text":"秦越关川何阻绝，明珠梦里已先投。\n春风入彀元非偶，秋日登台亦壮游。\n野旷天低山月蚤，云归洞湿石泉流。\n西湖从此堪乘兴，历览东南王气浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30744,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"门士俞应和出守处州道由滁阳留之信宿志喜 其二","author":"黄廷用","text":"乘舟访戴下山阴，风雨官斋细论心。\n万里驱驰怀尺剑，百年交谊重兼金。\n寻幽径里黄花暮，言别尊前绿酒深。\n明日悠悠旌旆杳，远惭张翰独知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30745,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游琅玡寺用韵","author":"黄廷用","text":"帝子当年来避暑，古城今秪见僧家。\n净心谁复能明果，说法空传有献花。\n白发数茎知旅况，青山一片是生涯。\n留欢恰值秋容晚，更儗春游玩物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30746,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次蒋侍御重阳后病起登丰山韵 其一","author":"黄廷用","text":"司马著书应病暍，起来徐步上高峰。\n帘栊近月低相映，洞壑归云远更浓。\n白日不悬车下景，青年那复镜中容。\n当筵喜有琼瑶赠，何处山城杳暮钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30747,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次蒋侍御重阳后病起登丰山韵 其二","author":"黄廷用","text":"秋杪升高同谢眺，天南缥缈起云峰。\n若迷桂岭乡心远，莫为湘江客思浓。\n皂盖逢人如有问，青山何处不相容。\n请看陶令开三径，敢儗王公食万钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30748,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再叠前韵答蒋侍御 其一","author":"黄廷用","text":"自昔东南多王气，龙翔凤翥叠层峰。\n天回日月金风冷，地切星辰玉露浓。\n帘外青歌添逸兴，灯前妙舞若为容。\n豺狼夜里争相避，隐隐江村野寺钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30749,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再叠前韵答蒋侍御 其二","author":"黄廷用","text":"一声过雁涵云影，指点长江江上峰。\n莫苦病魔寻药去，且乘酒兴对花浓。\n汉朝霜简推公雅，晋代风流说仲容。\n月下归来清梦绕，与君长乐听疏钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30750,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"惜花","author":"黄廷用","text":"好花难种不长开，每到开时旧雨来。\n心赏几?□夜醉，兴来翻惧晚春催。\n胭脂点缀高盈树，锦绣纷披乱作堆。\n去日已多浑似梦，欲留无计独徘徊。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30751,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次户侍霖原侄孙赠翰撰环江还朝韵 其一","author":"黄廷用","text":"共次夔龙舜日边，曾将礼乐献三千。\n暂违天上游名岳，岂是人间作谪仙。\n魏阙承恩仍玉笋，汉宫缓步复金莲。\n独惭山寺牵缨冕，芳草萋萋花满川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30752,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次户侍霖原侄孙赠翰撰环江还朝韵 其二","author":"黄廷用","text":"直北星辰望不穷，明朝策马各西东。\n尊当霞绮含斜日，篷寄江舟带晚风。\n回首不堪离别处，论心仍在梦魂中。\n何缘桑梓联姻娅，况复官阶几地同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30753,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丰山同侍御蒋毅所别翰撰陈环江再叠前韵 其一","author":"黄廷用","text":"瑶花琪草未为穷，春日寻芳水涧东。\n独步绝峰斜带日，谁言高处不禁风。\n孤云过鸟青霄上，远树浮烟碧落中。\n别后此心君自见，百年交谊几人同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30754,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丰山同侍御蒋毅所别翰撰陈环江再叠前韵 其二","author":"黄廷用","text":"花鸟春深思亦穷，芳游何日不西东。\n云边乍吐千山月，江上翻生万壑风。\n道宇全藏岩岫衷，人家半在驿楼中。\n从今此地知谁伴，复得论交尊酒同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30755,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"巡江周监察及溪按滁志喜 其一","author":"黄廷用","text":"一别都门意不忘，忽承星驾下滁阳。\n云间幽径看山远，雨□新泉入酿芳。\n见说甲兵皆武库，流辉翰墨动文昌。\n乘舟若向江东去，试问离情孰短长。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30756,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"巡江周监察及溪按滁志喜 其二","author":"黄廷用","text":"昭代赖君持汉典，豸冠绣服一南巡。\n扬帆江上鲸鲵远，揽辔山中花木春。\n共道皇情徵草莽，谁能物色出风尘。\n从来楚璞应难辩，莫讶荆人识未真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30757,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁巳岁除在滁前此丙辰在京乙卯在衡州志感","author":"黄廷用","text":"三年守岁各殊方，京国湖南总帝乡。\n宦迹半生成潦倒，客怀随地转疏狂。\n即看腊雪开梅坞，亦有春风到草堂。\n不识故园同此夜，灯前儿汝几回肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30758,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柏子漂 其一","author":"黄廷用","text":"丰山迤逦来何许，山下一潭广且深。\n中有五龙能作雨，旱时三日洒为霖。\n当年驻跸多神贶，昭□祠宫出帝心。\n宸笔奎文光汉碣，共传柏子是桑林。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30759,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柏子漂 其二","author":"黄廷用","text":"昔人传此蟠龙地，龙德正中不少留。\n夹日翔云飞太液，乘雷兴雨润芳洲。\n恩波岁及三千界，神彩宵悬十二楼。\n欲荐蘋蘩何所问，一泓秋水古祠头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30760,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"城南泛舟","author":"黄廷用","text":"吕梁不见浪花浮，荡桨城南破客愁。\n陵谷变迁驰白日，英雄代谢付东流。\n桓山愚穴巢狐兔，濉水无情浴鹭鸥。\n惟有苏公堤尚在，舟人指点说黄楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30761,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次太保东湖公陈雷梦语","author":"黄廷用","text":"东望湖深总渺茫，那堪临老别情长。\n忽闻鸿雁蜚声远，复苦风霜入骨凉。\n珥笔至今惭太史，疑珠原不愧穹苍。\n知心尚有陈雷在，一读新诗一断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30762,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次郑都谏壶阳赠言 其一","author":"黄廷用","text":"今日承恩得赐归，久知性与俗相违。\n冥鸿作伴声何眇，寒月窥人色自辉。\n南盻溪山乘小艇，岁栽兰桂绕重扉。\n别君万里思君处，目断青霄王树依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30763,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次郑都谏壶阳赠言 其二","author":"黄廷用","text":"一鄂长安始息机，恰逢小雪带风飞。\n即遵绿渚登仙棹，不见红尘上客衣。\n转觉春来随意适，休言岁晚与心违。\n几人白首青云外，来往江头坐钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30764,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙冈张年兄分别德州赋二律 其一","author":"黄廷用","text":"京师一别几相失，坐忆前程得见君。\n月下传书犹隔岸，晓来晤语到斜曛。\n百年萍梗何时合，万里关川此日分。\n预卜太平调鼎暇，登楼遥望越山云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30765,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙冈张年兄分别德州赋二律 其二","author":"黄廷用","text":"与君曾醉琼林酒，回首芳春三十年。\n却忆论心匪旦暮，可堪分手各云烟。\n冰胶尽舫离情合，风拂行旌别绪牵。\n未必此生无再会，壶公缩地为谁缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30766,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"总制胡梅林西湖作主","author":"黄廷用","text":"焚香欲祷湖山明，亭午云开雨下晴。\n半捲珠帘青嶂合，双牵锦缆碧波轻。\n水边低见旌旗影，花外遥闻甲马声。\n围玉上公能爱客，偏于疏散倍留情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30767,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西湖","author":"黄廷用","text":"十年不到西湖上，今日来游春较迟。\n芳草乍随幽兴发，白云应结素心知。\n两高胜迹几经主，万朵梅花可为谁。\n妒杀山光与水色，销魂多在夕阳时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30768,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日中丞刘带川过榕城新筑","author":"黄廷用","text":"劳君一上仲宣楼，举目风尘动客愁。\n插竹未曾开蒋径，诛茅岂是爱荆州。\n汉官剪綵呈春燕，周代尚青迓土牛。\n聊摘黄楫传腊酒，人传小队浣花头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30769,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"榕城春日","author":"黄廷用","text":"自从五月入江城，犹滞故园三日程。\n万里驱驰还是客，百年行止总浮生。\n夜来每系松楸梦，春到宁忘杨柳情。\n安得干戈不阻绝，归人搔首乐升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30770,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿福州郡侯吴定泉","author":"黄廷用","text":"治行于今谁第一，使君偏德我邦人。\n越城累岁传铜虎，汉室从天锡玉麟。\n海上鲸鲵争避远，山中草木喜行春。\n请看载道焚香者，都祝高牙控八闽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30771,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送通判陈质庵归省兼谒选","author":"黄廷用","text":"讵意相逢成远别，尊前不觉倍离情。\n潘舆正值春花丽，菜彩偏添昼锦明。\n懒与白云同出岫，肯因芳草滞行程。\n知君未展雄飞志，试听歌人作牧声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30772,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠分守沐任斋入贺万寿 其一","author":"黄廷用","text":"原野黍苗含雨露，南薰一曲入离觞。\n谁怜岁月邻蛟室，独蹑星辰上帝乡。\n玉佩声摇文石润，金函光动御炉香。\n殿东谢食鹓班定，袖里民风疏几章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30773,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠分守沐任斋入贺万寿 其二","author":"黄廷用","text":"一自衮衣东土日，他乡俱是欲归人。\n何缘海角逄知己，犹得山中寄此身。\n隔岁鲸鲵皆远迹，四时花木始生春。\n于今复作朝天客，目断斗枢梦里神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30774,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"贺莆尹徐季林诞辰 其一","author":"黄廷用","text":"黄花篱畔开如绣，何必河阳学种花。\n沧海无波滋雨露，阳春有脚及桑麻。\n瑶琴一曲调明月，绿酒盈尊注彩霞。\n日食俸钱殊不愧，年年秋色度韶华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30775,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]