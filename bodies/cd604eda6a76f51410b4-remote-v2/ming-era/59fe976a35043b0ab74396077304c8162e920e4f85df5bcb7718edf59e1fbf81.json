[{"title":"飞来寺胜景古迹 其十五 凝碧湾","author":"朱士赞","text":"寺古临浈水，波澄映碧山。\n夜来泛钓艇，清磬动前湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺胜景古迹 其十六 伏虎楼","author":"朱士赞","text":"驱虎人何去，移文碑尚留。\n精英元耿耿，山鬼夜悲愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺胜景古迹 其十七 半云亭","author":"朱士赞","text":"最高元古寺，此地半云亭。\n未了登高兴，须从此一经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺胜景古迹 其十八 登钟楼","author":"朱士赞","text":"潭深难觅锁，寺古尚悬钟。\n万籁清宵寂，惊人晓暮中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32433,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺胜景古迹 其十九 登绝巅","author":"朱士赞","text":"欲逞穷高志，跻攀最上头。\n千峰似忽小，一线水东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32434,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺胜景古迹 其二十 纪胜游","author":"朱士赞","text":"江潮频古峡，峻岭异云蒸。\n当有钟灵者，清朝起翼冯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32435,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山寺","author":"朱士赞","text":"昨夜祥光耀碧台，仙风拂拂自蓬莱。\n波涛忽谩兼天涌，击楫中流首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32436,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阙题","author":"朱士赞","text":"十九峰头问去来，人间福地失蓬莱。\n中流漾月清波碧，万岫凌云瑞气嵬。\n幻事已随猿鹤化，胜游况值海潮回。\n相知满地天涯暮，便欲移舟傍钓台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32437,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白泡潭","author":"朱士赞","text":"浈水东注日，银浪忽成堆。\n岂有中流柱，盘旋水自回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32438,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归猿洞","author":"朱士赞","text":"逐队长归去，玉环遗此山。\n千秋传异事，吾意有无间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32439,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出山","author":"朱士赞","text":"奉檄非余志，山灵愿未违。\n暂时通仕籍，何日遂初衣。\n一为红尘役，其如紫蕨肥。\n迟回弗忍去，魂绕瀑泉飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32440,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滕王阁","author":"朱士赞","text":"洪都飞阁俯江开，画栋凌空逼上台。\n当日登楼人已往，千秋寻胜客重来。\n地邻彭泽风斯远，天入衡阳雁未回。\n帝子飞仙何处去，浮云遥隔万山嵬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32441,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游海珠寺谒李忠简公祠 其一","author":"朱士赞","text":"一洗中流万斛尘，清风高捲绛帏春。\n时危不避牵裾疏，宋末犹存报主身。\n剩有勋名归太史，长留灯火荐芳萍。\n菊坡门下推多士，衣钵如公有几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32442,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游海珠寺谒李忠简公祠 其二","author":"朱士赞","text":"玉曙词章绝学难，先生千古此登坛。\n风裁何处霜同肃，权贵于今骨尚寒。\n珠寺考钟鸣夜月，越江飞浪障东澜。\n哲人遗像瞻依在，步武谁弹柱后冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32443,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜朱邑侯新任","author":"黎兆麟","text":"明府登车气象新，澄清山海不胜春。\n儿童竹马欢相接，无复当年佩犊人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同蔡抉辉夜月登侯岭","author":"余寅亮","text":"高寄嶙峋望远空，九天风露散溟濛。\n遥连碧落星堪指，拟泛秋槎路可通。\n乍觉笑谈惊宿鹤，不知明月上枯桐。\n谁言子晋吹笙处，缥缈仙踪约略同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上感怀","author":"陈瑞章","text":"已知短发怯寒风，转盼孤城枕寺东。\n宇内声名惟祖逖，眼前谈笑亦王通。\n梅花几片随江白，云树参差落叶红。\n浩浩乾坤春意到，何缘狂客独飘蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江边夜泊","author":"梁存让","text":"不知何处泊，倚棹近三更。\n天远秋无尽，江寒月有声。\n鸣虫萦断梦，归雁系离情。\n把酒愁孤饮，残杯照短檠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江行秋兴二首 其一","author":"梁存让","text":"已无人唱大江东，滚滚奔涛逼远空。\n世界是非尘劫后，英雄今古浪淘中。\n半壶浊酒浇残夜，十幅轻帆蘸晓风。\n明识宦游春梦里，有谁说破向孤蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江行秋兴二首 其二","author":"梁存让","text":"烟波深处暂停桡，直上高楼挂酒瓢。\n万里天风吹远碧，一江秋雨助寒潮。\n狂搜断碣怀千古，醉向空山问六朝。\n回首乡关云树隔，惊闻黄叶下萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月下怀弟存诚","author":"梁存让","text":"万里秋声度雁群，三年离梦绕归云。\n何当化作天边月，夜夜清辉照见君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白菊","author":"梁存让","text":"冉冉真疑堕素云，清芬玉质可离群。\n秋来閒品陶家种，不染铅华独有君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏雪","author":"梁存让","text":"看山莫笑野云閒，五岳峰头自往还。\n倘被天风吹得起，也应霖雨到人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄金台","author":"梁存让","text":"矗矗凌云百尺台，燕昭好士亦雄才。\n却疑珠履谈天客，半为黄金两字来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兰","author":"陈岳","text":"僻地知谁问，无人亦自芳。\n雨馀轻弄色，风细远生香。\n已入琴中趣，还徵梦里祥。\n嗟予交托久，一化两相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和安溪祖闻寇 其一","author":"陈岳","text":"老年人似锁笼雕，减却凌霜意气骄。\n万里无由瞻北阙，一缄谁拟及东朝。\n秋风白苧宁衣越，晚节黄花不属姚。\n凉月望来清露冷，直容看彻九重霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和安溪祖闻寇 其二","author":"陈岳","text":"月前孤雁影双飞，坐对谁知此意微。\n老去落残潘令鬓，瘦来宽尽沈郎衣。\n愁闻笳管清商调，閒赋蒹葭白露诗。\n输与一筹还范蠡，解将西子赚夫差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别李中书","author":"李恺","text":"几度过逢幸识荆，嘉君彤管侍承明。\n同根气谊千钧重，忤世功名一纸轻。\n愧向宜阳聊出牧，辱从文水枉麾旌。\n归来细检琼瑶赠，翘首西吴倍怆情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重建迎翠楼志成喜步陈琴轩宗伯前韵","author":"梁兆奇","text":"飞楼新搆绝纤埃，极目风烟万里开。\n芳树摇青分影至，远峰浮翠逼衣来。\n六朝文物还今古，千载山河入酒杯。\n閒倚危楼娱昼永，檐花散落点苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀何友竹师步来韵","author":"梁兆奇","text":"双鱼急寄海门秋，每诵新诗重我愁。\n世路百年孤愤赋，烟波六月五湖舟。\n芹池桃李春常在，庾岭云霓暮不收。\n试问玲珑岩上月，清辉曾续几人游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘堉水公祖视篆代还","author":"梁兆奇","text":"刘宠声名自汉宫，一钱清誉可谁同。\n几年政在文翁上，三月途分鲁国中。\n莞水兰荃饶雨露，穗城桃李蔼春风。\n主恩莫谓天涯远，行矣燕台跃紫骢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步韵答卫勉斋文学","author":"梁兆奇","text":"空谷兰开夜自香，蒹葭秋色露为霜。\n高情客有淇园赋，多病人疏剡水航。\n郢上雪飞三楚暮，江间鸿下一天长。\n陆离盘错知何售，摇落砧声动晚凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淮阴道","author":"陈鸣阳","text":"淮阴聊览胜，长剑倚寒汀。\n漂母祠何在，王孙草自青。\n假齐空有恨，灭楚可谁铭。\n一种萧条色，秋风泗上亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花落","author":"陈鸣阳","text":"姑射寒梅树，年年斗雪芳。\n声翻秦女笛，飞点汉宫妆。\n凉月侵琼朵，微风度暗香。\n幽闺春寂寞，无奈断人肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卧病柬憨山禅师","author":"陈鸣阳","text":"倦游关塞客，一病几经旬。\n慧日存吾性，浮云寄此身。\n闭门蛩闹夜，欹枕鸟啼春。\n最爱南邻伴，郫筒问字频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白雁","author":"陈鸣阳","text":"黄芦飘朔气，白雁度江皋。\n玉塞传书远，银河结阵高。\n秋霜凌竞翮，明月妒奇毛。\n莫向征人妇，楼头五夜号。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水月寺","author":"陈鸣阳","text":"古刹浮沧海，窗开面面空。\n楼台疑蜃气，帘幕逼蛟宫。\n兔魄閒波面，鱼舠度镜中。\n坐深忘色相，谁复叹飘蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洞中春日","author":"陈鸣阳","text":"玉洞借高轩，春阴日掩门。\n鸠拖残雨去，莺喜乍晴喧。\n花落迷樵径，苔深印屐痕。\n路歧芳草色，空自怅王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上泷","author":"陈鸣阳","text":"一片征帆度楚西，艰危泷垄即天梯。\n风抟舴艋群鸿戏，水击寒潭万马嘶。\n短褐经秋歌扣角，蒯缑长夜拂闻鸡。\n不堪烽火传西檄，满地苍生困鼓鼙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柳江","author":"陈鸣阳","text":"几度秋光上客容，佩刀犹自网蛛封。\n晨趍月冷关山笛，夜泊风悽野寺钟。\n怪石倚天攒剑戟，古槎临水漾虬龙。\n无端总被山灵笑，五岳行行少定踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同吴伯玉谢元瑞集苏锡元公署得林字","author":"陈鸣阳","text":"载酒探玄二仲临，官閒城市亦山林。\n坐中清曲频赓和，世上黄金自浅深。\n雪拥骊驹仙客路，春啼黄鸟故人心。\n人生解有千年业，肯向尊前叹陆沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄鹤楼","author":"陈鸣阳","text":"书剑飘遥楚水滨，危楼聊且驻征轮。\n续凫有客惭崔颢，跨鹤凭谁似昔人。\n朗月芙蓉千里玉，东风杨柳万家春。\n胜游莫问前朝事，一慨兴怀泪满巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺情 其一","author":"陈鸣阳","text":"露冷凌波步不前，流萤相扑自年年。\n妾身未必齐纨扇，不待秋来已弃捐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闺情 其二","author":"陈鸣阳","text":"床前蟋蟀吟寒月，力倦砧声犹未歇。\n塞北征夫路几千，梦魂夜夜长飞越。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡龙骧水磨苍精剑","author":"陈鸣阳","text":"十载飘零尚客星，秋风歧路短长亭。\n龙堆旧斩楼兰剑，一借龙骧洗血腥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜宿白云洞","author":"张鸣韶","text":"何处逃名侣，云栖夜讨论。\n断崖悬石榻，明月拥芳尊。\n吹笛惊螭梦，留诗剥藓痕。\n平生重幽兴，仙境倍销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游白云洞赠何子明","author":"张鸣韶","text":"岧峣山色倚天开，幽思云中不易裁。\n千尺悬崖藏窟宅，半空飞瀑撼风雷。\n炉烟远带晴霞落，剑气高淩北斗回。\n最爱草原人独暇，问奇应拟更重来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒李忠简公祠","author":"张鸣韶","text":"高台晴倚玉芙蓉，灏气遥连海上峰。\n名第先朝留翰墨，芳传昭代见仪容。\n重溟日丽文长在，断壁云深藓自封。\n千载衣冠还此地，满天波影吼鱼龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺","author":"郭光宇","text":"一水横流千里碧，双峰高插半云偏。\n疏疏岸竹千秋律，故故榴花几度禅。\n尘世樊笼俱幻迹，山中采药自忘年。\n望穷岛外风帆远，矫首云霄羽欲骞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠郑抚夷兄弟平茶山寇","author":"蓝守柄","text":"蹂残村落万魂惊，敢意分梨洗甲兵。\n今日功成谁得似，汉家二霍早知名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏新辟邑城","author":"严讷","text":"捧檄劳劳入不毛，城开百雉倚云高。\n昔年麟石都开瘴，今日星岩亦种桃。\n花市即看新第宅，野田重理旧蓬蒿。\n我来观感兴风化，到处逢人说卖刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏新辟邑城","author":"岑毓","text":"十里风烟辟草莱，炎方今幸太平开。\n汉庭已羡南阳治，粤岭重看渤海才。\n豺虎蒿原知远敛，燕鸿耕陇且飞回。\n专城保障从兹日，伫见勋名列上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题黉宫景","author":"朱淳","text":"圜门济济士衣冠，日丽光涵泮影间。\n藏豹雾中山崒嵂，卧龙溪上水潺湲。\n封泥五岭非秦吏，鸣玉千峰见汉官。\n从此宫墙翘首望，五云祥彩是长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵","author":"刘津","text":"春晴载酒一登台，指点河山落日回。\n万顷波翻楼橹接，极天云静画图开。\n忧时每忆批鳞疏，惊代争传倚马才。\n不谓圣朝全盛日，亦令迁客渡江来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠岩亭","author":"刘津","text":"步屧出幽林，岩欹积翠深。\n烟含孤磴折，云乱一溪阴。\n古树闻初偈，逃禅称静心。\n尊前遮莫醉，未怪早抽簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠岩亭六首 其一","author":"刘津","text":"翠岩何窈窕，近阁频清游。\n趺坐岩头石，松风吹不休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠岩亭六首 其二","author":"刘津","text":"支策过禅栖，苍云澹幽壑。\n诸天问上乘，花雨空中落。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠岩亭六首 其三","author":"刘津","text":"花龛高挂天，飞影不著地。\n鸣铎下虚空，谁悟岩头意。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠岩亭六首 其四","author":"刘津","text":"野寺鸣钟晚，斜晖敛翠微。\n牛羊下曲径，吾自澹忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠岩亭六首 其五","author":"刘津","text":"仙子矞云衣，采得金花草。\n服食身欲飞，朱颜不能老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠岩亭六首 其六","author":"刘津","text":"口弄碧玉管，凉飔飒飒轻。\n翱翔碧云里，招得董双成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古","author":"叶士卿","text":"海门斜抱大江流，千古乾坤寄一丘。\n不有真人开日月，谁令遗庙祀春秋。\n苔封玉籀残僧护，藓蚀金鱼堕泪收。\n无限英魂招不得，年年空听杜鹃愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题九成台","author":"邓维循","text":"一从晦迹懒登临，君考遗文惬素心。\n题壁有人留好句，索居无侣抱孤琴。\n云霞变幻迷朝夕，身世浮沈任古今。\n惟有禅心与秋月，清光长伴我閒吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"承召乡饮不赴和陈黄两茂才联赠韵","author":"王綵","text":"郁郁穷居志独行，只缘狂野更衰颜。\n名浮有忝英才荐，性僻何堪世教关。\n惭效冠裳登圣域，惯随蓑笠入樵山。\n凭君为我专辞谢，揖逊趋跄自觉难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠王君日斋见召乡饮","author":"陈敬、黄如黄","text":"正月十三江上行，荣赍盛典俨天颜。\n礼迎耆硕鳌台表，声重誉髦太学间。\n有美衣冠瞻洛社，无瑕璧玉耀商山。\n日来华宴趋跄处，宾主东南见二难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度岭谒曲江庙","author":"苏景熙","text":"斯人不可见，遗像肃青山。\n似掇星辰履，如趋鹓鹭班。\n蘋蘩严俎豆，伏腊俨容颜。\n庙食千秋事，高风未易攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和邓玄度元夕前四日集珠江话别舟中玩月元韵","author":"苏景熙","text":"春回大地草偏青，乍对狂歌酒半醒。\n文起自应倾北斗，气酣直欲簸南溟。\n月华星彩浮樽满，龙笛鸾笙彻夜听。\n明发不须愁往别，埋轮久已候都亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和韩孟郁将归诗三首 其一","author":"苏景熙","text":"将归徒倚北山岑，寂寂寒蝉愁暮阴。\n江上浮云空自好，涧边白石为谁吟。\n美人一水芙蓉隔，何处孤樽风雨深。\n安得同君共杯斝，嗒然散发卧长林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和韩孟郁将归诗三首 其二","author":"苏景熙","text":"莽莽天涯游子心，貂裘敝尽少黄金。\n燕台一去几消息，湘水无情自古今。\n穷途不作阮藉哭，抱膝聊为诸葛吟。\n且共佯狂发长啸，故山遥瞩暮云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和韩孟郁将归诗三首 其三","author":"苏景熙","text":"闻君归筑南山颠，囊中奈何无一钱。\n清泉白石足懒性，流水浮云出世缘。\n七尺头颅元自赘，百年天地拚相捐。\n栖心物外寄幽爽，凉风高枕北窗眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]