[{"title":"野意四首 其四","author":"黄衷","text":"细竹缭垣问隐居，水荒休叹食无鱼。\n已分月令青榆火，合请溪翁紫甲蔬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"食红梅","author":"黄衷","text":"错落青林摘火珠，牙根滋味厌甘腴。\n瓦盆可共无朱老，付与寒山返哺乌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山僧饷春茶","author":"黄衷","text":"种日曾锄九月霜，摘来犹带露华凉。\n一奁饷我真禅味，烹出天花满座香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戒药","author":"黄衷","text":"案头方技传，缅想华陀翁。\n薏苡空留语，蘘荷不奏功。\n归春悬夏首，转日过隅中。\n笑杀游蜂队，纷纷蔓草丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"象樽","author":"黄衷","text":"南夷良冶手，巧范象为觞。\n拟海由中洞，投醪任鼻香。\n青牺依古制，白兽借型光。\n倾盖邀鹦鹉，虚怀避凤凰。\n寒温兼委纳，清浊总?扬。\n惯见金钗坠，尝从锦瑟傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李大尹寄白鹇","author":"黄衷","text":"谁致苍梧薮，还登绿野台。\n日中朱脸丽，花外雪翎开。\n顾影鸳非偶，扬姿鹭或猜。\n不鸣惟耿介，小立暂徘徊。\n玄素雕笼献，文章品服裁。\n拜嘉须有赋，无那谪仙才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酴醾始开俄有窃取者因小咏","author":"黄衷","text":"未恨亏红蔟，情知妒艳妆。\n拂烟条已委，含雾蒂犹香。\n莺怨春风薄，蜂嗔俗客狂。\n祇堪同把玩，可忍重迷藏。\n入酒芳应减，裁诗调自扬。\n秾华心思尽，散发对筼筜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"茉莉花","author":"黄衷","text":"新换南薰叶，曾移旧雨科。\n眼前春事晚，池畔夕香多。\n精白馀清韵，轻盈夺素娥。\n蛮中红蕊本，不种水云窝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答梅国翁","author":"黄衷","text":"开缄千里散清愁，快剧祥飙飏旅舟。\n独客几年虚短刺，须公一起振横流。\n孤怀直引金鳌閤，远睫时悬镇海楼。\n璧月满天谁共赏，江边频度雁声秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"追悼篇","author":"黄衷","text":"炎海于南维，泱漭瀰八裔。\n琼岛秘万灵，磅礡华夷际。\n异气钟西洲，天然灿明睿。\n千里神驹骧，赤霄鸾侣?。\n词锋敌四方，礼学魁两制。\n释褐趋辟雍，民曹仕初筮。\n宝矿晶必腾，玉彩廉不刿。\n老吏骇发铏，儒英缔深契。\n南归奉滫髓，再阅纪元岁。\n婆娑古榕阴，东山迹非翳。\n翻然箕踞轩，复绾省郎盭。\n文武宪外台，三沛薇垣惠。\n全齐距南楚，遥引金汤势。\n暂列留都卿，选望仍北隮。\n大疏总机宜，群公仰匡济。\n思循四序功，遂鼓五湖枻。\n虞罗少冥鸿，缨组有蝉蜕。\n江湖切素怀，山水时小憩。\n指峰讶中摧，吁嗟哲人逝。\n邦家怅典刑，道脉失根蒂。\n惟二丈夫子，晚喜仲也艺。\n忍读赠褧篇，一字迸一涕。\n缅想筠溪翁，德业鸣并世。\n社祀崇二贤，斯文讵论替。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙午秋八月朔沃泉裕斋二宪伯命酒矩洲奉谢二绝句 其一","author":"黄衷","text":"飞盖亲劳折简来，绮樽遥傍野堂开。\n十年病骨容扶掖，散弄幽樊燕雀回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙午秋八月朔沃泉裕斋二宪伯命酒矩洲奉谢二绝句 其二","author":"黄衷","text":"西林卜筑小菟裘，攲枕槐风答四休。\n一座笑谈霏玉屑，不知烦暑尚争秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵酬沃泉","author":"黄衷","text":"花映溪桥柳映堂，百年养拙此何乡。\n翠觞不减黄封醥，皓首从酣白战场。\n避影自依芳樾静，耽幽同步绪风长。\n光阴无限吾人得，世上还谁号太忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵酬裕斋","author":"黄衷","text":"数椽虚拟少城堂，半落寰中半落乡。\n桑树鸡声邻北垞，苇林渔唱过西场。\n乾坤漠漠冥心早，今古滔滔寄恨长。\n采菊东篱堪小约，总随蜂蝶一时忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日期沃泉裕斋壁山矩洲小集席上和裕斋二首 其一","author":"黄衷","text":"幽兴惟于熟处便，未烦奇幻想壶天。\n龙山宾从如流水，谁解风琴奏汉边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日期沃泉裕斋壁山矩洲小集席上和裕斋二首 其二","author":"黄衷","text":"丝衫纱帻各轻便，举白呼红送晚天。\n萸菊香中浑一笑，閒人风月本无边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"越日沃泉追和旧作见贻次韵奉答兼简裕斋壁山二首 其一","author":"黄衷","text":"暂凭歌笑接堂堂，榕叶阴连大隐乡。\n九日登临堪蔗境，百年悲喜付优场。\n客分庆马杯深浅，僮竞风鸢线短长。\n欲借鲁戈挥落景，入城舆从莫教忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"越日沃泉追和旧作见贻次韵奉答兼简裕斋壁山二首 其二","author":"黄衷","text":"高轩重枉过溪堂，小墅将题俟德乡。\n雪藕旋教翻雁浦，槟榔遥记趁龙场。\n当歌未羡金钿丽，改调应知铁笛长。\n逸兴此中元不浅，催花何处鼓声忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"君马黄","author":"黄衷","text":"君马黄，臣马骊，黄马立仗骊马驰。\n朔风吹碛，百草变衰，汗沟凝血长苦饥。\n将军纵辔放鸣镝，空中一响无遗迹。\n上有盘云雕，下有化虎石，为君更发旋鞦?。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青青河畔草","author":"黄衷","text":"青青河畔草，迟迟万里道。\n道远苦多岐，感忆心已懤。\n驱马齧霜荄，结筏泛黄潦。\n狼居誓必封，龙堆期一扫。\n马牛风不及，谁为寄安好。\n幸抑金玉怀，飞鬒蓬花早。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陌上桑","author":"黄衷","text":"艳质不自惜，采桑上南陌。\n秦楼多鹿姝，见者潜夺魄。\n耀颊明珠珰，淩波发纤蹐。\n语笑讵轻酬，中心秉贞白。\n红蚕罢新浴，柔桑始可摘。\n倾筐早已盈，归伴暂离掷。\n问言何太勤，献茧著礼籍。\n女事贵必躬，寄谢车马客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蜀国弦","author":"黄衷","text":"雪泛锦江水，垂丝绽红蕊。\n愁借郫筒消，欢逐巴歈起。\n倚剑一夫关，驰车九折难。\n豪门迎重客，绿绮夜中弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王子乔","author":"黄衷","text":"乘黄螭，宾赤日，遗世佳期七月七。\n学凤篸?不可攀，玄宫璀璨缑氏山。\n缑氏山，高切云，风雷澒洞随氤氲。\n上有混沌子，不见空相闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"君子行","author":"黄衷","text":"造化爱修名，君子况金玉。\n静默貌若愚，粹美良可掬。\n谊交古水寒，数面芝兰馥。\n持吉恒谦谦，遗荣匪碌碌。\n动息悬气机，休戚关国俗。\n景星岂常辉，神虬不可畜。\n伟哉蘧大夫，千载嘉耻独。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕歌行","author":"黄衷","text":"天作燕都栖太一，霱云尽拥重光日。\n西山灏气郁嵯峨，辽海洪涛壮呼吸。\n沃野环畿千里春，弦歌比屋诸生习。\n红筵杂剧递新声，紫袖佳晨联绮陌。\n辇贝驼金混九门，通衢十二朱甍密。\n东南菽帛隘漕渠，绝域梯航走庭实。\n年少雕鞍蹴鞠场，白头绿醑团栾室。\n憧憧行旅不赍粮，处处圆扉虚系桎。\n漠陲明月净穹庐，蚩尤雾淡莺花馝。\n貔貅百万罢秋防，深闺那解牵衣泣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"难忘曲","author":"黄衷","text":"双燕诧孤鸾，照影发彩舞。\n那知镜里姿，不是山中伍。\n明月上白榆，宛宛素娥语。\n感此徒星霜，寂寞兰蕙雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野田黄雀行","author":"黄衷","text":"丹鸾应瑞图，翱翔必明世。\n玄鹤骖上仙，近阅动千岁。\n不见田间雀，微翎匪鲜华。\n一步恣一啄，蓬蒿足为家。\n君子有远操，洞幽察其微。\n鸾衰怅鹤老，嗟嗟黄雀肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"门有车马客行","author":"黄衷","text":"结发游京洛，契谊文武资。\n高谈酌谟典，语次贯握奇。\n道希裨世主，功希垂鼎彝。\n中岁抱沈癖，言归守茅茨。\n茅茨鸡斗争，俄报异客徕。\n传呼震林薄，夹道罗旌旗。\n彤幨隐华毂，襟藻盘文螭。\n升堂肃宾礼，光辉威凤姿。\n问客从何来，早晚发京师。\n问今乃何适，诏殿西南夷。\n推贤共踊跃，追旧同嗟嘻。\n呼儿具小酌，苦以忽忽辞。\n慕乐不能款，内愧蒸须眉。\n再拜出门阈，执袂且依依。\n殷勤复致语，念此晨星稀。\n终期保令德，缄报勿相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南弄效李贺体","author":"黄衷","text":"江楼拂柳融烟轻，金钗按曲节秦筝。\n虾须帘内屈卮举，鹦鹉梦中传吉语。\n燕掠芳尘逢旧侣，吴樯近泊桃花墅。\n越客春衫来楚楚，捎得鱼缄过湘渚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白综述歌效王建体","author":"黄衷","text":"吴宫步锦妍光属，照夜明珠当华烛。\n新宠蛾眉号爱卿，舞衣如雪掌中轻。\n春莺宛转应翔燕，瑶环振蹑芙蓉生。\n霞觞未歇欢如许，斗柄斜河月过午，博劳叫曙酴醾坞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻李壁山还自苍梧雨中奉讯","author":"黄衷","text":"潦漫槎头钓伴稀，龙门高韵苦相违。\n旧题白雪何人和，独泛苍梧几日归。\n苔径不教收雀网，虹湖偏惜褪莲衣。\n浮云名迹那堪忆，蔬粝论文道岂非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊居寄邓曾二有道二首 其一","author":"黄衷","text":"漠漠玄云结午阴，江樊犹绽兔葵心。\n迎潮白鹭翩翩舞，选树黄鹂款款音。\n市上方袍闻施药，门前稚子报携琴。\n纶巾不着从萧散，独抱离骚学楚吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊居寄邓曾二有道二首 其二","author":"黄衷","text":"几从尘外混神翁，洛社衣冠浪自同。\n杖策雅堪垂竹帛，咏歌谁共溯雩风。\n清吟肯惜筠筒满，纵饮宁辞玉斝空。\n委巷十年虚伏枕，未应无路请屯蒙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏至矩洲书事","author":"黄衷","text":"西林朱景初迎至，结夏清禅亦未过。\n红糁落花三径雨，绿翻荣稼一川波。\n将雏燕舞晴偏媚，求友莺声晚更和。\n贷粟溪农休涕泪，寰中乐事本无多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答豫斋二首 其一","author":"黄衷","text":"杨阴祇觉浦团稳，地僻何烦小队过。\n独载接䍦缘混世，几逢罗袜为淩波。\n谈馀尘梦那堪省，静里天倪也自和。\n高会莫辞先进酒，请看坐下渐人多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答豫斋二首 其二","author":"黄衷","text":"争枝乌鹊寻常见，探水舂锄几度过。\n窃荷化工馀日月，懒追炎海旧风波。\n池萍鱼戏金淩乱，露槿蝉鸣笛应和。\n避暑谩誇公主洞，岂知清韵竹林多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答沃泉二首 其一","author":"黄衷","text":"少陵青眼鸬鹚到，漫叟生嗔褦襶过。\n已许杨枝能度曲，谩誇桃叶解横波。\n酒分莲注香逾古，风戛松琴韵转和。\n敢向明时轻拂袖，只缘天付野情多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答沃泉二首 其二","author":"黄衷","text":"遥峰个个排檐秀，蛱蝶翩翩拂槛过。\n龙性屯云长作雨，道心明水镇无波。\n湖光忽瀁天光动，花气犹含淑气和。\n奉忆函关牛背老，一编遗我至言多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再和答沃泉","author":"黄衷","text":"雨战林塘烦暑退，携觞谁为问奇过。\n杖腾细竹萦回路，座对轻鸥浩荡波。\n谈剧诗书还磊落，味深藜藿亦调和。\n悬车犹赴苍生急，西臬应知济物多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"飞鸿亭盆池千叶莲开孤艳可玩赏以小句","author":"黄衷","text":"贪看蒸霞艳，堪餐滴露芳。\n低飞防燕蹴，旅至恼蜂狂。\n剪缬千披蕊，凝脂独缀房。\n并头人共惜，谁道野鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贱生石塘周子以诗为寿次韵奉答","author":"黄衷","text":"早衰清世愧称贤，渔籍闲名浪得先。\n花隐山房分绿野，鹤临风浦梦青田。\n曾无酒数依金谷，祇有诗狂学玉川。\n看罢残棋惟袖手，贮君荣路策勋年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵与石塘论学","author":"黄衷","text":"曾于邹鲁想多贤，至道从天辨后先。\n静胜高禅修白业，专同玄客守丹田。\n溯流何啻风千里，悬悟真看月一川。\n隐几头颅惭潦倒，幸教鸣世属英年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓兴二首 其一","author":"黄衷","text":"偶逐人间戏剧游，却荒员峤旧沧洲。\n别来白玉田应熟，会见黄河水倒流。\n瑶草岂曾须雨露，琪花犹自阅春秋。\n天庖剩有青霞液，幸洗孤怀万古愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓兴二首 其二","author":"黄衷","text":"诸天缥缈入云门，浪遣华镳踏市喧。\n梦里和南多旧侣，壁间留偈总真言。\n长松石隐维摩室，蔓草金微舍利园。\n法眼只堪观物幻，道身宁为坐花尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋园晓涉","author":"黄衷","text":"心期徂暑净林郊，引杖荒莓绿未抛。\n鸠唤苍凉仍选树，鹤盘寥廓岂怜巢。\n云梢个个添新筱，风曼累累笑系匏。\n粗粝不馀还岁月，一篇秋水老衡茅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题苏碧厓渔樵问答图","author":"黄衷","text":"太古识奇逸，厥惟渔与樵。\n溪山此邂逅，款语递昏朝。\n问樵从何来，神山道迢迢。\n屈指数五岳，掌上扬峦㟽。\n钝斧格熊豹，肯问猲与獢。\n扶桑讵足采，邓林几回凋。\n烟霞饱素癖，攲枕调山魈。\n闻君樵风远，谱陈渔乐饶。\n群溟泳九有，天池剧逍遥。\n举网罩明月，星辰纷荡摇。\n灵鳅毙巨壑，彗孛应层霄。\n蚌蛤自么族，弦望占盈枵。\n吾方證玄化，谁云慕鲿鲦。\n公乎珍此本，胜社知何朝。\n闲堂对盘薄，颢气浮纤绡。\n謦欬宛历耳，眉须宛仙标。\n林姿澹转媚，欻见祛烦歊。\n毋庸浪开箧，燕石争琼瑶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冼少汾新岁见怀和答二首 其一","author":"黄衷","text":"鹤园佳胜别沧洲，鱼鸟惭予未泛舟。\n二十四龛涵妙月，只攲高枕恣神游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冼少汾新岁见怀和答二首 其二","author":"黄衷","text":"偶从方外访瀛洲，半在筠筇半在舟。\n一树扶桑春似海，白头思杀御风游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲观绯桃简李璧山二首 其一","author":"黄衷","text":"池上丛桃似献新，绯英灼灼竞青春。\n闲堂对客岂无具，近社携醪也自醇。\n隐树流莺时扑蝶，葺巢回燕惯逢人。\n襄阳耆旧那堪问，李白曾惊笔有神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"矩洲观绯桃简李璧山二首 其二","author":"黄衷","text":"春园力倦对春华，不独绯桃满树花。\n溪老绕林求木耳，山僧挈笼馈茶芽。\n交垂碧草鸥前业，隔断黄尘世上家。\n未见鸣雷回蛰候，已闻新水斗轻蛙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春庭独思","author":"黄衷","text":"是处春风转物华，总难装点澹生涯。\n衰颜被酒融融煖，病眼摊书款款斜。\n笔格银钩残薤叶，砚台铜滴旧虾蟆。\n数茎阶下忘忧草，燕子天长也见花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏龙兰二首 其一","author":"黄衷","text":"挂壁怜葱茜，龙名不浪呼。\n讵能辞雨露，且免混泥涂。\n根抱阴晴候，神疑变化俱。\n随风香亦古，端可狎潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏龙兰二首 其二","author":"黄衷","text":"艳蕊春何去，苍藤只黯然。\n无言那有恨，托意似孤骞。\n萝蔓终相惜，蓬心谩自旋。\n未须齐物化，隐几对陈篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57020,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿周荔湾和狮山韵","author":"黄衷","text":"渭滨曾记入占年，何似歌钟宴列仙。\n道士传丹封赤篆，舞儿拖锦出红筵。\n紫霞杯泛鹅黄苾，白雪诗缄鹄素鲜。\n只有乔松堪致祝，春光长在众芳前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57021,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛亥夏四月己卯与李璧山游桥山因览首丘璧翁有作次韵一首","author":"黄衷","text":"车驱清晓露，磴蹑翠微天。\n绿野风何远，朱明火未然。\n高歌尘外客，纵博橘中仙。\n更拟乘秋兴，来分煮石烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57022,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王岱麓中丞以诗见贻次韵奉答五首 其一","author":"黄衷","text":"岱岳标东海，精融间古才。\n贤流凭羽翮，泰道倚胚胎。\n斥鴳虚怜鷟，繁星尽拱台。\n共嗟仙籍吏，暂下五云来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57023,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王岱麓中丞以诗见贻次韵奉答五首 其二","author":"黄衷","text":"世济西平美，蝉联琬琰劳。\n蛟龙风雨壮，雕鹗海天高。\n谈笑随挥麈，经纶仰坐曹。\n悬知盐坂骏，鸣向九方皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57024,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王岱麓中丞以诗见贻次韵奉答五首 其三","author":"黄衷","text":"驱驰纡五岭，扬论剧三韩。\n冲况多虚席，辉光一翥翰。\n乘巇徵履素，逊硕任心丹。\n昭代贤为宝，行看拂豸冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57025,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王岱麓中丞以诗见贻次韵奉答五首 其四","author":"黄衷","text":"暑随新雨净，凉是绪风馀。\n白氅来时服，青箱旧日书。\n稍甘南味馔，谁扫锦溪除。\n逸气方溟渤，瀰茫掠孟诸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57026,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王岱麓中丞以诗见贻次韵奉答五首 其五","author":"黄衷","text":"感激辞明主，从容慰粤人。\n奚囊皆袭綵，藻鉴不欺尘。\n叶景封灵荚，循年阅古椿。\n索居仍老癖，端愧接芳邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57027,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岱麓再和见酬率尔赓答五首 其一","author":"黄衷","text":"委蛇东省步，磊落建安才。\n信有龙遗蜕，虚疑鹤化胎。\n奇探过禹穴，胜纪想天台。\n寄谢谈经子，匡衡正鼎来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57028,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]