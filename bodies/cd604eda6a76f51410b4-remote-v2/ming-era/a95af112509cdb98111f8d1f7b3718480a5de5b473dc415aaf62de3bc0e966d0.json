[{"title":"送刘少尹赴兴州经历三首 其一","author":"卢楠","text":"宸极沾仙籍，双凫别尚方。\n何如魏宾客，不减汉循良。\n大府宜方器，牙门足荐章。\n材高岂伏枥，万里见乘黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30795,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘少尹赴兴州经历三首 其二","author":"卢楠","text":"潘岳花封宰，陈琳将幕材。\n檄文传万垒，列宿近三台。\n怅望蓟门路，深怀河朔杯。\n君王求骏骨，待诏上燕台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30796,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘少尹赴兴州经历三首 其三","author":"卢楠","text":"大府元戎骑，长驱引万群。\n共迎刘记室，喜得郤参军。\n燕月排弓影，边霜缀铠文。\n知君娴庙略，一啸洒天氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30797,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜奉怀王凤洲比部","author":"卢楠","text":"独坐秋城夜，长歌忆凤游。\n帝乡临紫浦，仙吹下炎洲。\n早食琪玕树，西巢云绮楼。\n无缘近苞彩，慰此别离忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30798,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄上徐龙湾比部","author":"卢楠","text":"相思木叶落，迢递起重哀。\n瀚海云初断，卢龙秋正来。\n惭无国士报，独忆凤城隈。\n坐令生华发，临风一痛哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30799,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠王少府封君水亭","author":"卢楠","text":"长啸下江阁，披襟即水亭。\n鱼龙静秋浪，舟楫倚寒汀。\n且失干戈苦，还依社稷灵。\n夜来看紫气，光满少微星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30800,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠王龙池别驾","author":"卢楠","text":"晋石分青嶂，龙池抱紫台。\n秋风动鳞甲，白日发云雷。\n太液涛休险，昆明势欲回。\n何当洗兵马，万里绝氛埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30801,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日同王大伾董右坡张㠠山陆梦洲孟龙川登大伾山览黄河故道得温字","author":"卢楠","text":"五月随仙舄，凌风势欲鶱。\n却思乘海鹤，翻忆听秋猿。\n石树穿云冷，岩花散酒温。\n大河犹在眼，何必问昆崙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30802,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西岩","author":"卢楠","text":"西岩双柏树，犹自倚青坛。\n旧识洪河险，曾经大壑寒。\n龙鳞剥雷雨，鹊干泻风湍。\n回首思梁栋，还惊际会难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30803,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题杨太尉挥金幅幛","author":"卢楠","text":"独忆关西老，挥金气尚奇。\n江河流浩瀚，天地渺端倪。\n谏草危时恨，亭皋绝代悲。\n由来图绘意，不尽史臣词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30804,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画葡萄","author":"卢楠","text":"汉使寻源后，蒲萄满旧宫。\n如何尺素里，枝叶往时同。\n滚露衔空碧，抟烟射小红。\n谁能贮万斛，远寄日华东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30805,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠谢山人四溟","author":"卢楠","text":"春桂绿华滋，芬芳合待时。\n君今饵玉叶，聊以驻仙姿。\n拟著三湘赋，深题五岳诗。\n相期共方眼，为觅葛洪陂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30806,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游成皋王城南园见水石渔艇","author":"卢楠","text":"不作江南客，空馀江上山。\n水同明月静，石似白鸥閒。\n仙径松萝外，渔舟芦荻间。\n相看浑忘却，无复住人寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30807,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出塞","author":"卢楠","text":"城门伐鼓日欲堕，西山返照入平芜。\n玉关秋动气横塞，交河霜冷夜弯弧。\n健儿风吹白豹障，将军雪压金仆姑。\n昼传羽檄连云戍，夜发精兵到海隅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30808,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"慈寿宫","author":"卢楠","text":"汉宫罗列倚云霄，凤翥龙飞积翠遥。\n东瞰扶桑延日观，西连雪岭入寒宵。\n皇舆拜舞临黄道，仙仗缤纷觐紫朝。\n诸将谩劳繁鼓角，至尊今已奏箫韶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30809,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"浮丘精舍","author":"卢楠","text":"卫河东岸浮丘高，竹舍云居隐凤毛。\n遂有文章惊董贾，岂无名誉驾刘曹。\n秋天散步青山郭，春日催诗白兔豪。\n醉倚湛卢时一啸，长风万里破洪涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30810,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书长春观二首 其一","author":"卢楠","text":"万里天风海水高，三山不动驾群鳌。\n青霄漠漠闻鸾啸，白日翩翩见鹤翱。\n岩下琼浆留卫叔，山中瑶草寄卢敖。\n怀纡金紫人不见，日日吹笙对碧桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30811,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书长春观二首 其二","author":"卢楠","text":"天门日出海云蒸，碧殿霞绡山气层。\n嬴女吹箫乘夜月，茅君骑鹤下秋灯。\n金茎玉露生华发，紫极丹书接上升。\n缑氏山头一挥手，几观沧海变崚嶒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30812,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠李金吾口号","author":"卢楠","text":"汉家飞将李将军，三十承恩靖虏氛。\n马蹀金微横朔气，箭传青海动燕云。\n阴风漫捲贤王阵，大雪长躯突厥群。\n未信封头县鹊印，已颁新使焕龙文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30813,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七夕","author":"卢楠","text":"去年七夕登浮丘，今年七夕客燕州。\n仙槎独忆银河水，桂树谁看玉露秋。\n叶下井床惊别泪，虫吟花槛送深愁。\n平生自信庾开府，怀抱于今赋远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30814,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽杨六坡推府","author":"卢楠","text":"草阁谈玄不复闻，山阳锻后涕交纷。\n十年辞藻汉京事，万里乡关秦塞云。\n尹喜传经空汝待，王乔飞舄竟谁群。\n荒坟静锁伾山麓，日暮遥悲渭水纹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30815,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夜寓大名寄孟龙川","author":"卢楠","text":"忽忆襄阳孟浩然，风流名与太湖连。\n沙材远近青春酒，山舍周回白石田。\n何处椒花能媚颂，他乡綵胜舞随筵。\n思君独步清漳曲，南望魂销倍怆然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30816,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"古意","author":"卢楠","text":"汉苑春繁锁缛纱，银窗娇小护仙葩。\n朝云袅袅行清晓，落月娟娟见玉华。\n湘女漫弹瑶瑟怨，天孙遥忆紫烟槎。\n使君五马何轩豁，伫望郊端柘影斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30817,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠关中陈一泉广文二首 其一","author":"卢楠","text":"汉辅金墉百二关，千秋王气锁南山。\n忠良苦忆萧陈侣，豪俊还生泾渭间。\n会有文星通帝座，岂愁仙履缀鹓班。\n春宫苜蓿何辞长，凤陛圭璋可待攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30818,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠关中陈一泉广文二首 其二","author":"卢楠","text":"魏阙恩光落上台，龙门宾客会群才。\n太玄无愧侯巴诵，九辨何劳宋玉哀。\n江汉秋容松叶澹，宫墙春雨杏花开。\n明时拟有石渠诏，翰苑惊看补衮裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30819,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆昔寄钱同野弟","author":"卢楠","text":"忆昔读书住石城，青天对落两山横。\n江潭夜傍鱼龙宿，轩牍晨看日月生。\n多病浸淫汉司马，著书忧愤赵虞卿。\n匡庐旧约空回首，肠断清宵泪湿缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30820,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿沙口赠王北沙二律 其一","author":"卢楠","text":"谷口寒云拥北沙，柴门深锁待春华。\n楚骚自合千人诵，汉水犹县八月槎。\n贾谊匡君频痛哭，扬雄识字著名家。\n相逢愧我垂双鬓，潦倒青鐏海日斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30821,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿沙口赠王北沙二律 其二","author":"卢楠","text":"魏郡西连沙口原，故人高卧倚晴轩。\n黄鸡碧酒须多事，楚些吴歈可细论。\n豺虎空村当落日，鱼龙入夜漫孤翻。\n自愁骑马冲寒塞，古木萧森起断猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30822,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日奉怀谢四溟逸人兼酬往日见寄之作","author":"卢楠","text":"邺中词客古今才，千里秋深发兴哀。\n陶令行藏只尽醉，孟嘉容止独清栽。\n山萸细细团风袅，园菊亭亭带雨开。\n白首思君何处望，烟云苦忆魏三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30823,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉和王大伾侍御题周紫泉东山草堂二律 其一","author":"卢楠","text":"石壁巉岩一径幽，漫随杖屦访林丘。\n嵇康不负山阳隐，谢傅能忘淝水筹。\n日落沧洲时伫望，天寒桂树且淹留。\n徵书旦暮驰秋陇，拟取高名别代收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30824,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉和王大伾侍御题周紫泉东山草堂二律 其二","author":"卢楠","text":"海门秋动青澶麓，天畔风高白草堂。\n太傅松楸高下见，绣衣旌节往来常。\n窥轩细筱娟娟碧，截壁孤云袅袅长。\n薄暮翠微归兴懒，暂随流水一挥觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30825,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"震冈集留别","author":"卢楠","text":"城阙秋还白露清，十年怀抱与君倾。\n弹琴细忆嵇中散，痛哭犹怜阮步兵。\n绝巘松枝元自峻，经时花蕊为谁明。\n开鐏莫负中宵赏，别去愁看银汉横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30826,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日怀钱同野","author":"卢楠","text":"象魏独怜秋气清，苦垂冤颈且长缨。\n背巢寒鸟经年别，出塞风云尽日横。\n鲍叔衣冠频怅望，襧衡词赋已吞声。\n沧洲忆汝伤心极，坐啸惊看白发生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30827,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送林越山广文之石城尹二首 其一","author":"卢楠","text":"粤海炎洲气未疏，高凉快爽此安居。\n蔡肜有待殊方诏，虞诩终收太史书。\n茂岭秋深才见雁，廉江水缓自生鱼。\n慎时努力加餐饭，返浦看乘白鹭车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30828,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送林越山广文之石城尹二首 其二","author":"卢楠","text":"汉节遥分南海边，天风猎猎拥楼船。\n苍梧云尽山如戟，合浦春回树若烟。\n占岁岂应缘戍日，兢歌何用胜于阗。\n遐陬亦是藩王室，赖尔文翁治化贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30829,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠徐少尹","author":"卢楠","text":"岧嵲中山插泰清，断岩西影下层城。\n弹琴不去人吏散，岸帻何劳官长迎。\n绵竹土风今变态，黑山盗贼敢横行。\n樗材惭愧河阳赋，坐起青霄望弁缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30830,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赴理大名道中感李有池惠粟之作","author":"卢楠","text":"关塞遥怜霜露清，燕云漠漠锁层城。\n邹阳不尽十年泪，鲍叔犹深万古情。\n秋水鱼龙休怅望，春风燕雀赖生成。\n酬恩欲拟愁难赋，坐叹空垂白发茎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30831,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻比郡李沧溟出守顺德书此寄上","author":"卢楠","text":"汉署仙郎何处求，高旌知驻古邢州。\n渔阳久待张君淑，河内争迎郭细侯。\n旧日石门曾拒垒，此时铜马莫轻谋。\n畏途远附青云翼，慷慨长唫寄壮游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30832,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"立春前夜宴张㠠山明府宅","author":"卢楠","text":"城柝传闻客子夕，清樽一发便宜人。\n巴江水汎云边腊，㠠岳天开雪后春。\n避地衣冠从懒慢，惊时花鸟自逡巡。\n愧知张翰留颜色，拟许卢敖隐钓纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30833,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"醉后射鱼宿罗山人草堂","author":"卢楠","text":"南射沧溟十丈鱼，碧潭摇影动清虚。\n太行远望仙人嶂，淇水斜临高士居。\n晓傍枫岩留客饭，夜归萝径即吾庐。\n何时共策清藜杖，为觅中山白鹿车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30834,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观妓即席走笔","author":"卢楠","text":"楚女东邻未是过，秋来休似隔银河。\n香鬟小学平阳舞，艳曲低翻子夜歌。\n弄日鸳鸯窥绮幔，偷春蛱蝶趁花罗。\n大堤此夕堪肠断，回首犹怜逝水波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30835,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"旧黄河道中有怀张㠠山明府","author":"卢楠","text":"黄河渡口旧飞湍，白马东连瓠子滩。\n夏后山川馀断石，汉皇巡幸咽回銮。\n寒沙滚滚龙蛇动，晚日萧萧雁鹜乾。\n慨古思君易摇落，秋风更送紫骝鞍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30836,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠罗月岩推府迎侍还万安二首 其一","author":"卢楠","text":"汉京仙客知名早，佐郡惊看漳水濆。\n南楚花明莱子服，西山树送狄公云。\n高秋大泽龙地隐，落日寒江鼓角闻。\n最是少微干象纬，天风先报洞庭君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30837,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠罗月岩推府迎侍还万安二首 其二","author":"卢楠","text":"燕塞霜空万木摧，楚乡烟净锦帆回。\n洲如白鹭天边落，山似青螺海上来。\n孙晷兰舆元水国，曹家仙赋在铜台。\n南云北渚休相忆，紫诰金泥次第开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30838,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登南城楼有感兼怀荀前川","author":"卢楠","text":"独上高楼四望明，海天愁色起纵横。\n黄云不断飞孤雁，杀气遥连偃月城。\n未讶健儿能陷虏，早闻白羽尚徵兵。\n封侯知有荀公达，好向中朝事请缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30839,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山雨五首 其一","author":"卢楠","text":"日落石窗时，林花起幽色。\n不敢窥蛟龙，雨昏潭影黑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30840,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山雨五首 其二","author":"卢楠","text":"朝看山作云，暮看山作雨。\n幽人期不来，踟蹰望江树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30841,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山雨五首 其三","author":"卢楠","text":"秋水作鸣涛，泻入秋山下。\n大石横绝梁，小石流空野。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30842,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山雨五首 其四","author":"卢楠","text":"峡雨昼不绝，暝烟沉孤嶂。\n徘徊山中人，苔藓生衣上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30843,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山雨五首 其五","author":"卢楠","text":"门前黄冈陂，能长青琅玕。\n夜来溪雨恶，流作白石滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30844,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"示从弟桥三首 其一","author":"卢楠","text":"鸿雁隔春水，鹡鸰宿浅沙。\n翻飞共迟暮，终尔栖云霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30845,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"示从弟桥三首 其二","author":"卢楠","text":"吾家白玉树，璀璨已横枝。\n尽可参霄汉，莫教伤别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30846,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"示从弟桥三首 其三","author":"卢楠","text":"莫向苍山宿，苍山古木横。\n风动连枝影，凄其伤尔情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30847,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄高贞庵明府二首 其一","author":"卢楠","text":"陇水鸣幽咽，陇山不可攀。\n何缘牵梦到，夜夜绕秦关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30848,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄高贞庵明府二首 其二","author":"卢楠","text":"陇坻千万里，怅望使人迷。\n愿作青鹦鹉，能言向陇西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30849,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别冀康川进士口号","author":"卢楠","text":"秋风七月动燕关，云散金台游子还。\n欲上高楼重愁思，海涛东望阻天山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30850,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"长春观二首 其一","author":"卢楠","text":"瀛海青云见帝丘，玉光浮动五城楼。\n茅君借我山中鹤，飞上天门看九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30851,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"长春观二首 其二","author":"卢楠","text":"紫极清坛道士家，閒骑白鹿弄云霞。\n萧台旖旎金光草，春殿虚无玉树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30852,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云中曲八首 其一","author":"卢楠","text":"将军羽箭射天山，闪日旌旗出汉关。\n夜月欲开青海嶂，秋风先到白龙湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30853,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云中曲八首 其三","author":"卢楠","text":"元戎幕府倚天开，将校星躔四下回。\n汉垒天成标汉旆，云州日转作云台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30854,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云中曲八首 其六","author":"卢楠","text":"大将遥分西顾忧，鱼肠宝剑雪花流。\n阴风漫捲贤王阵，白纛看麾木叶楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30855,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云中曲八首 其七","author":"卢楠","text":"黄须羽帽破乌桓，丈八蛇矛血未乾。\n边马尽归元帅幕，蕃刀赠与故人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30856,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云中曲八首 其八","author":"卢楠","text":"白马青裘海上来，自言家住古秦淮。\n封侯未遂为人下，沙漠横行恐见猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30857,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戏赠于山泉","author":"卢楠","text":"楚王宫殿锁寒晖，瑶草金花匝四围。\n十二巫山觅不见，满天云雨湿仙衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30858,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠卫川居士","author":"卢楠","text":"卫川南望多白云，沧州落叶各纷纷。\n何时笑入烟霞去，醉里常随麋鹿群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30859,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王旴山还保定","author":"卢楠","text":"君去青山挹紫氛，我亦南还弄彩云。\n相逢美酒不成醉，别去空怜落雁群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30860,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋兴漫成六绝句 其一","author":"卢楠","text":"壁峭江深云物明，沙村秋气转初清。\n出门散着双蓬鬓，醉舞酣歌太放情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30861,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋兴漫成六绝句 其二","author":"卢楠","text":"天外晴山色不移，苑边衰柳驻游丝。\n沙平细履无人见，恰似青春二月时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30862,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋兴漫成六绝句 其三","author":"卢楠","text":"绝巘寒藤垂古月，秋江过雨湿仙花。\n柴门幽兴尤堪赏，遍遣银壶赊酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":30863,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]