[{"title":"送吴绣衣还朝","author":"于谦","text":"观风俱是客，君去我何时。\n暮景春三月，离情酒一卮。\n远归真可喜，漫醉不须辞。\n珍重同年谊，应劳别后思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31879,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日客中谩兴","author":"于谦","text":"客怀虽寂寞，春意自堪怜。\n草色翠如织，花枝红欲燃。\n鸣鸠疏雨后，啼鴂暖风前。\n翘首天涯路，韶光又一年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31880,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山行","author":"于谦","text":"望极群峰远，行穿一径幽。\n云从树杪起，水绕竹根流。\n酒旆摇村舍，钟声出寺楼。\n多情林外鸟，巧语答鸣驺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31881,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"客途春阴","author":"于谦","text":"薄云和日色，底事弄阴晴。\n驻马空回首，鸣鸠不住声。\n东风吹野草，暮霭起山城。\n扰扰长途倦，逢人即问程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31882,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜雨二首 其一","author":"于谦","text":"和气成甘雨，沾濡意转深。\n一犁通地脉，万物识天心。\n花柳滋春意，山川起夕阴。\n农夫咸喜悦，点滴直千金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31883,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜雨二首 其二","author":"于谦","text":"花外锦鸠啼，催来雨一犁。\n眼前生意足，头上暖云低。\n红透花枝重，青涵草色齐。\n明朝出城郭，走马踏春泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31884,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋晚山行","author":"于谦","text":"日落千山暝，风高万木凋。\n深沟通曲径，独木架危桥。\n客路空迢递，离情转寂寥。\n驿楼看渐近，时听马萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31885,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋暮汴中述怀","author":"于谦","text":"汴城秋节暮，候馆客愁新。\n京国驰情久，家山入梦频。\n塞鸿愁月夜，篱菊惨霜晨。\n借问归何日，浮名绊此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31886,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜晴","author":"于谦","text":"久雨晴偏好，群芳各斗妍。\n柳浓莺恰恰，花暖蝶翩翩。\n风景逾三月，韶光直万钱。\n寻春无限意，缓著紫丝鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31887,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春后归兴","author":"于谦","text":"雨洗乾坤净，群峰露翠微。\n水清鱼自见，花谢蝶还稀。\n零落惊春暮，蹉跎与愿违。\n耳边山鸟语，劝我不如归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31888,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"太行山中晓行","author":"于谦","text":"月落日未出，东方隐又明。\n云连怀庆郡，雾绕泽州城。\n道路淹归计，关河动客情。\n故乡不可见，搔首望神京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31889,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自叹","author":"于谦","text":"白发太无情，年来次第生。\n官清存晚节，才薄负虚名。\n秋雨黄河水，春风碗子城。\n巡行知几度，候吏厌逢迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31890,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偶得","author":"于谦","text":"地僻尘嚣远，公馀兴未清。\n过门无俗辙，闭户有书声。\n宾从皆时彦，谋谟尽物情。\n菲才叨重寄，何以答升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31891,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"漫题屋壁","author":"于谦","text":"卜得幽居好，秋来景倍佳。\n堂虚先得月，城近每闻笳。\n雨洗苍梧叶，风吹白藕花。\n门前无列戟，错认野人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31892,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日即事","author":"于谦","text":"风静林塘好，波光一鉴开。\n金鱼穿绿藻，翠竹映苍苔。\n幽草锄还长，驯禽去复来。\n时清公事简，冠盖日徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31893,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜雨","author":"于谦","text":"日入千山黑，层云搆夕阴。\n一声雷送雨，万国土成金。\n品物回生意，闾阎诵好音。\n天公应有在，知我爱民心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31894,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨后散步","author":"于谦","text":"小园疏雨歇，散步快幽情。\n行处苍苔滑，吟边绿草生。\n薄云还掩映，初月未分明。\n抚景聊成趣，尘烦喜暂清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31895,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"延津县","author":"于谦","text":"县治萧条甚，疲民疫病多。\n可怜官失职，况是岁伤和。\n空廪全无积，荒田更起科。\n抚安才智短，独立奈愁何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31896,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"塞垣纪兴","author":"于谦","text":"寒云迷古塞，积雪照平川。\n境外风尘静，楼头鼓角传。\n庙堂勤远略，节钺镇穷边。\n巡抚应多暇，乘骢袅玉鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31897,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日述怀","author":"于谦","text":"塞垣霜信早，北雁往南飞。\n水冷莲房老，林疏木叶稀。\n有官居鼎鼐，无地觅庭闱。\n何限关心事，临风一叹欷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31898,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除夕","author":"于谦","text":"今宵是除夕，明日又新年。\n爆竹惊残梦，寒镫照独眠。\n风霜催腊尽，梅柳得春先。\n抚景情无限，那能不怅然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31899,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送御史莫资本还南京","author":"于谦","text":"碧云开霁色，黄叶作秋声。\n仗节还乌府，承恩出凤城。\n宦途期远大，宪度喜澄清。\n浊酒不堪饮，题诗慰别情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31900,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得玉泉垂虹","author":"于谦","text":"巨灵劈石迸流泉，万丈虹霓著地悬。\n怒捲风雷趋瀚海，细分脉络贯长川。\n千岩溅沫云应湿，一鉴澄空月正圆。\n宝瓮谁能酿春酒，称觞献寿祝尧年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31901,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得琼岛春云","author":"于谦","text":"玉垒金城七宝台，絪缊佳气自天开。\n长依瑞日迎车辇，每逐仁风被草莱。\n轻带春阴花外度，清随曙色柳边回。\n广寒宫殿承恩处，曾睹龙文接上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31902,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初冬客途感怀","author":"于谦","text":"小雨冥冥不湿衣，饥鸢高贴野云飞。\n南来北往河山迥，秋尽冬初草木稀。\n半夜还家归梦好，十年为宦客情微。\n故园茅屋收成后，啄黍黄鸡想正肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31903,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和余吾驿壁间诗","author":"于谦","text":"煌煌使节下并州，俯仰乾坤豁远眸。\n万里关河迂马足，十年风雪敝貂裘。\n北连河朔风尘静，东望都门瑞气浮。\n车骑纷纷催晓发，一声鸡唱五更头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31904,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初度","author":"于谦","text":"碌碌庸庸四十馀，因逢初度转踌躇。\n腰黄久负金为带，头白惊看雪满梳。\n剩喜门庭无贺客，绝胜厨传有悬鱼。\n清风一枕南窗卧，閒阅床头几卷书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31905,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与顾赵范三绣衣晚酌醉后偶题","author":"于谦","text":"临风长啸岸乌纱，宾主相忘醉眼花。\n千里逢人俱是客，十年持节未还家。\n欲将海水添杯量，却笑秋霜入鬓华。\n酒醒更阑成独寐，梦魂依旧绕天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31906,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自叹","author":"于谦","text":"鬓花斑白带围宽，窃禄无功久旷官。\n岸帻耻为寒士语，调羹不用腐儒酸。\n逢人只说还家好，垂老方知济世难。\n恋恋西湖旧风月，六桥三塔梦中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31907,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"客中感怀","author":"于谦","text":"十年踪迹厌红尘，功业无成白发新。\n梦里不知身是客，觉来惟有影相亲。\n夕阳衰草梁园暮，细雨閒花沁水春。\n马足经行今几度，溪山应笑未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31908,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"还京述怀","author":"于谦","text":"眉间黄色应归期，正值清秋八月时。\n封事预需当宁问，音书先慰倚门思。\n宦情落落从来懒，吏牍纷纷欲去迟。\n好在故园三亩宅，功成身退是男儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31909,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜归兴","author":"于谦","text":"华月行空流素光，星辰隐隐动寒芒。\n烟销宝篆金垆冷，水咽铜壶玉漏长。\n望断乡书无过雁，牵成离恨有啼螀。\n敝庐只在吴江上，莼菜鲈鱼入梦香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31910,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日客怀","author":"于谦","text":"年年马上见春风，花落花开醉梦中。\n短发经梳千缕白，衰颜借醉一时红。\n离家自是寻常事，报国惭无尺寸功。\n萧涩行囊君莫笑，独留长剑倚晴空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31911,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登楼书兴","author":"于谦","text":"公暇登楼立彩旃，客怀抚景倍凄然。\n千家绿树苍烟外，数点青山落照边。\n暮景侵寻欺病骨，秋霜容易上华颠。\n自知不是经纶手，附郭须营二顷田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31912,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除夕夜坐感怀","author":"于谦","text":"秉烛焚香坐不眠，夜长难到五更天。\n怀人此际隔千里，为客明朝是十年。\n远道风霜嗟老矣，故园梅柳想依然。\n椒盘献岁知谁共，独把金杯对影传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31913,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送吴绣衣还朝","author":"于谦","text":"平明走马入京畿，杨柳飞花点绣衣。\n山外有山频入望，客中送客转思归。\n红云高拱天门邃，绿树深藏驿路微。\n渡却黄河知己少，临岐杯酒莫相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31914,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过中牟鲁恭祠","author":"于谦","text":"长民曾羡鲁恭贤，民物熙然各遂天。\n境外遗蝗徒扰扰，桑间驯雉自翩翩。\n闾阎风俗犹前日，史传声华纪昔年。\n寄语郎官勤抚字，循良衣钵要人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31915,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻甘州等处捷报有喜","author":"于谦","text":"露布星驰上玉京，三边战气一时平。\n人间玉石铭勋业，天上银河洗甲兵。\n罴虎有劳咸进秩，烽烟无警可安生。\n从今海宇风尘静，庙算应知出圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31916,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"叹贾平章废宅","author":"于谦","text":"豪华汨没几星霜，废宅空遗孔道徬。\n鼠迹印尘盈故榻，燕巢经雨落空梁。\n紫云歌断人千古，金谷花残梦一场。\n世事兴衰总如此，啼鸦不必怨斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31917,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过五攒山","author":"于谦","text":"五攒山下路盘旋，曲阜崇冈远接连。\n十里邮亭数椽屋，几家村落一丘田。\n林梢日没僧归寺，涧底冰消鹿饮泉。\n诗思多从鞍马得，骅骝不用苦加鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31918,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"盘陀驿道中","author":"于谦","text":"群峰尽处是盘陀，小径纡回乱石多。\n风约閒云难作雨，渠分流水不成河。\n门开野店群鸡唱，花发春山百鸟歌。\n一段好怀无著处，令人对景费吟哦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31919,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"遣怀","author":"于谦","text":"才离汴水又并州，马上光阴易白头。\n出处每怀心耿耿，是非谁较论悠悠。\n貂裘不畏三冬雪，燕颔终封万里侯。\n珍重晚来风景好，黄花老圃殿高秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31920,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春风","author":"于谦","text":"荡漾无端入画堂，帘栊微动昼初长。\n暖催花底莺声滑，轻拂檐前燕翅忙。\n酒醒香尘凝座榻，梦回芳草满池塘。\n飘扬不解留春住，又逐鞦韆度粉墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31921,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆晋祠风景且以致望雨之意","author":"于谦","text":"悬瓮山前境趣幽，邑人云是小瀛洲。\n群峰环耸青螺髻，合涧中分碧玉流。\n出洞神龙和雾起，淩波仙女弄珠游。\n愿将一掬灵祠水，散作甘霖遍九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31922,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜宿山馆书怀","author":"于谦","text":"萧然山馆似僧房，三尺寒檠一炷香。\n风捲松涛清入梦，窗涵月色冷侵床。\n倦来不觉良宵短，明发从教去路长。\n但愿两藩民物阜，不知何处是他乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31923,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"薇垣春晓为山西王大参赋","author":"于谦","text":"漏渴铜龙报晓衙，月钩犹在紫薇花。\n分藩任重数千里，化笔春回百万家。\n香爇雕盘笼睡鸭，镫辉青琐散栖鸦。\n相看旦气清如水，坐待金乌出海霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31924,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春水","author":"于谦","text":"东风鼓浪散轻冰，万顷玻璃一望平。\n白鸟下来分细谷，锦鳞惊跃破浮萍。\n临流画阁图中见，载酒楼船镜里行。\n安得天瓢都挽取，化为甘雨润苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31925,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆璚英","author":"于谦","text":"璚英一别已三年，梦里常看在膝前。\n婉娩性情端可爱，娇痴态度亦堪怜。\n诵诗未解知音节，索果惟应破俸钱。\n白发双亲在堂上，关心为尔更凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31926,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"连日灯花鹊噪漫成","author":"于谦","text":"夜看银台吐绛花，晓闻灵鹊噪檐牙。\n民安足遂中心愿，年壮何妨到处家。\n得失纷纷随梦蝶，公私扰扰付鸣蛙。\n晚香好在东篱菊，相伴秋霜入鬓华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31927,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪霁之夕闻檐溜有声因赋","author":"于谦","text":"人皆愁听客中雨，我独喜闻窗外声。\n报国常怀丰稔念，关心不是别离情。\n沾濡最爱滋群品，点滴何妨到五更。\n倏起披衣成兀坐，焚香读易候天明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31928,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阅武","author":"于谦","text":"圣主当天致太平，守臣阅武向边城。\n一川花弄旌旗影，八面风传鼓角声。\n羽镞穿云誇电疾，戈矛映日斗霜明。\n三军锐气能如此，会缚戎王献玉京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31929,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"嗽疾达旦不寐","author":"于谦","text":"寒疾攻人寐不成，惺惺欹枕候天明。\n十朝九病非无药，一刻千金浪得名。\n恋阙心驰京国路，思亲肠断武林城。\n男儿此外无他事，莫笑浮名绊此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31930,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"天门山","author":"于谦","text":"天门山峙近西偏，屹立芙蓉翠插天。\n六月冈峦飞雨雪，四时草木吐云烟。\n鸟飞不过岩头石，人渴难寻涧底泉。\n安得六丁施斧凿，滔滔车马信平川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31931,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观书","author":"于谦","text":"书卷多情似故人，晨昏忧乐每相亲。\n眼前直下三行字，胸次全无一点尘。\n活水源流随处满，东风花柳逐时新。\n金鞍玉马寻芳客，未信吾庐别有春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31932,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"落花","author":"于谦","text":"半随流水半随尘，断送韶光恼杀人。\n蜂蝶有情悲寂寞，园林无处觅精神。\n眼前红雨飘零尽，阶下苍苔点缀新。\n分付家童莫轻扫，醉眠还胜锦为茵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31933,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"飞絮","author":"于谦","text":"飘飘随意点轻裘，播荡东风不自由。\n乱逐红尘迷客路，轻随綵燕入歌楼。\n梁园飞雪惊春梦，渭水斜阳送客愁。\n莫向樽前苦惆怅，绿阴还在粉墙头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31934,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"交城道中","author":"于谦","text":"峰峦重叠树微茫，回首清源道路长。\n僧屋数椽临野水，人家一半住山乡。\n龙归洞口云烟湿，麝过林间草木香。\n随处停骖问民俗，不知归鸟背斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31935,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孝义县怀古","author":"于谦","text":"茫茫烟树绕孤城，千载犹传孝义名。\n郭巨墓荒春草合，比干台古野烟生。\n落花飞絮迷征旆，剩水残山恼客情。\n鞍马悤悤无限意，不堪回首暮云平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31936,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过韩信冢","author":"于谦","text":"蹑足危机肇子房，将军不解避锋铓。\n成功自合归真主，守土何须乞假王。\n汉祖规模应豁达，蒯生筹策岂忠良。\n荒坟埋骨山腰路，驻马令人一叹伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31937,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过皋陶庙","author":"于谦","text":"明刑弼教佐雍熙，千载嘉谟仰士师。\n故里凄凉遗旧冢，穹碑剥落倚荒祠。\n虞廷法立人无犯，后世民生伪益滋。\n庙貌幸存神未泯，赓歌犹得想当时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31938,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过夏县挽司马文正公","author":"于谦","text":"破瓮机锋岂偶然，活人手段自髫年。\n闾阎稚子知司马，海宇群黎仰涑川。\n出处遂关时治乱，死生难免世推迁。\n苍松劲柏环祠墓，凛凛清风在目前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31939,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"平阳分司","author":"于谦","text":"槐柳如云覆院墙，清和天气日初长。\n雨馀阶砌苔应滑，花落池塘水自香。\n谢客只容风入户，捲帘閒放燕归梁。\n吏民清肃文书简，吟对群峰坐画堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31940,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观登科录感兴","author":"于谦","text":"圣主垂衣御九重，群贤汇进万方同。\n文明启运天垂象，豪杰乘时气吐虹。\n柳汁染衣新样绿，花枝映面醉颜红。\n当年我亦曾遭际，涂抹于今避下风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31941,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初度日","author":"于谦","text":"年年马上度生辰，老景偏攻客里身。\n白发无能酬圣主，清宵有梦觐双亲。\n仙家漫说延龄术，尘世应无不死人。\n脩短荣枯天赋予，一官随分乐清贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31942,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"王大参以春景诸作见遗赋此以答","author":"于谦","text":"乌府联镳忆旧游，新诗慰我客边愁。\n胸中生意由天造，笔底行云似水流。\n清唳喜闻空外鹤，浮名笑破水中沤。\n何时共遂归田计，千里邮筒迭唱酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31943,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初度自责","author":"于谦","text":"每逢初度益凄然，却讶增年是减年。\n济世愧无书满腹，投閒何待雪盈颠。\n关山迢递迷归路，岁月淹留费俸钱。\n任重才疏成底事，西湖岂乏钓鱼船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31944,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望雨","author":"于谦","text":"赤日行空暑气浮，炎风簸土几时休。\n云霓久渴斯民望，廊庙当分圣主忧。\n旱魃剿除消沴气，神龙鼓舞起灵湫。\n挽将天上银河水，散作甘霖润九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31945,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]