[{"title":"避暑姚馆漫题 其三","author":"曹于汴","text":"千年华表草中埋，八百篯翁亦去来。\n抛却金环总一律，尽他二竖莫徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南游八首 其一","author":"曹于汴","text":"庐山面目何为真，我来问取山头人。\n山人住惯等平地，脉脉无言锄白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南游八首 其二","author":"曹于汴","text":"为观瀑布登高阁，悬流百仞空中落。\n山僧不见雪花飞，指点岩头说旱涸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南游八首 其三","author":"曹于汴","text":"文殊台上惟月明，水中有石声铿鍧。\n这番公案凭谁剖，还是石声是水声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南游八首 其四","author":"曹于汴","text":"白鹿无踪古洞幽，仍登绝岭豁双眸。\n紫阳笑指条山曲，一样淙淙涌碧流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南游八首 其五","author":"曹于汴","text":"千丈神妖繫铁柱，年来逃向灵台住。\n凭遣千兵擒不来，不持寸刃驱将去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南游八首 其六","author":"曹于汴","text":"一溪绿水一林松，五柳先生宅此中。\n天遣生成晋处士，非将饥饿博高踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南游八首 其七","author":"曹于汴","text":"佛子金身三丈五，袒肩垂手观下去。\n莫怪当年著眼高，等閒岂识群生苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南游八首 其八","author":"曹于汴","text":"访仙台上石崔嵬，人道餐霞去不回。\n果向深山更深处，温良何故进丹来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会堂和杨晋庵先生勉学诗七首 其一","author":"曹于汴","text":"此道何时不大明，青霄无奈片云生。\n几回欲扫扫不得，不扫凭谁代若行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会堂和杨晋庵先生勉学诗七首 其二","author":"曹于汴","text":"为是为非我自明，每从暗里泪痕生。\n会堂度度得良药，欲策驽绵勉强行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会堂和杨晋庵先生勉学诗七首 其三","author":"曹于汴","text":"同此天真同此明，宛如一镜罗群生。\n烦君提我迷途里，沂水河边好共行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会堂和杨晋庵先生勉学诗七首 其四","author":"曹于汴","text":"还得原来恁地明，无边真趣自生生。\n何须著力相防检，水自流兮云自行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会堂和杨晋庵先生勉学诗七首 其五","author":"曹于汴","text":"眉宇薰人乍欲明，须防鄙吝别来生。\n利名根蒂缚人急，口说难凭且去行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会堂和杨晋庵先生勉学诗七首 其六","author":"曹于汴","text":"颐解蓬开未是明，譬如击石火光生。\n可怜击罢依然石，到此令人猛欲行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会堂和杨晋庵先生勉学诗七首 其七","author":"曹于汴","text":"果然明尽却无明，到得真明万照生。\n千古良知孩提子，孩提刚是任天行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸢飞鱼跃","author":"曹于汴","text":"鸢鱼吟罢此心开，色色如斯莫更猜。\n窗草驴鸣同意思，古人才是诵诗来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张霁春谈棋诗","author":"曹于汴","text":"茫茫今古大棋枰，兴败输赢局局争。\n毕竟有时双歇手，回头一笑枉生情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"简会中同志","author":"邹元标","text":"急开眼，谨贴身。\n乾坤内，做个人。\n学不疑，功不真。\n疑不问，气不振。\n际嘉会，乘青春。\n鱼有水，德有邻。\n宜黾勉，莫因循。\n年年会，日日新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别友","author":"邹元标","text":"迢迢觅道，与道背驰。\n归而求之，自有馀师。\n朋友切切，兄弟怡怡。\n大心体物，敬以自持。\n实有诸已，信予匪欺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仁文书院 其一","author":"邹元标","text":"父母生我，耳聪目明。\n能思能索，手持足行。\n至道难闻，宁虚此生。\n乘时勉学，敢告同盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仁文书院 其二","author":"邹元标","text":"先立其大，在识本心。\n时时默识，海里寻针。\n把柄在手，点铁为金。\n有鹤在林，遗我好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仁文书院 其三","author":"邹元标","text":"大明中天，千载一时。\n无参意见，无涉支离。\n卓彼先觉，示我良规。\n上帝临汝，心实严师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仁文书院 其四","author":"邹元标","text":"英贤济济，聚首一堂。\n商搉疑义，剖晰毫芒。\n凤毛麟趾，规圆矩方。\n日新月盛，笃实辉光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其一","author":"邹元标","text":"咬得菜根，百事可成。\n不负天子，不愧苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其二","author":"邹元标","text":"咬得菜根，可以躬耕。\n无忝庭训，贻亲令名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其三","author":"邹元标","text":"咬得菜根，进退惟轻。\n舍我斯退，用我斯行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其四","author":"邹元标","text":"咬得菜根，物不能撄。\n如霆斯震，我心不惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其五","author":"邹元标","text":"咬得菜根，与世无争。\n所至虚舟，坦坦平平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其六","author":"邹元标","text":"咬得菜根，高卧柴荆。\n何必崇膴，布衣也荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其七","author":"邹元标","text":"咬得菜根，义利严明。\n为世之瑞，为国之祯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其八","author":"邹元标","text":"咬得菜根，万善皆诚。\n塞于天地，心迹双清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其九","author":"邹元标","text":"咬得菜根，扶危定倾。\n首阳人远，匪弟伊兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有惠予菜图者予悬之斋头日夕爱之书俚言自勖 其十","author":"邹元标","text":"咬得菜根，顺事无情。\n味虽澹薄，其中有精。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"家训","author":"邹元标","text":"诗咏多福，易言馀庆。\n积善之家，罔不繁盛。\n眇予小子，厕名士绅。\n愧无实德，裨补君民。\n未能治国，愿教吾家。\n敷诚布衷，寂听无哗。\n凡我宗人，无忽予言。\n洗心涤虑，培根达源。\n敬奉天地，孝养双亲。\n与其浊富，宁守清贫。\n勿利货贿，嘱托上官。\n小民叫冤，尔心何安。\n输赋无讼，迹绝公室。\n尊宪守约，终鲜差失。\n里闬姻党，情谊无涯。\n富贵轮流，转眼虚花。\n出入以度，惟公惟平。\n夜半叩门，尔心不惊。\n永言孝思，世德作求。\n我语谆谆，我心悠悠。\n毫釐不差，神明临汝。\n良心不昧，三复斯语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"默庵和尚","author":"邹元标","text":"莽莽谭禅，谁否谁得。\n有喙三尺，横恣胸臆。\n真学道者，先须一默。\n甘苦自尝，无徒耳食。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书刘生卷 其一","author":"邹元标","text":"手开斯卷，剖晰玄微。\n芝兰并馥，珠玉联辉。\n愧我不学，启口知非。\n冥心冥心，尚杜德机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书刘生卷 其二","author":"邹元标","text":"圣远言湮，浑浇淳漓。\n意真词繁，道德背驰。\n问子痛痒，子必自知。\n曰孝曰弟，归有馀师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"示昆弟","author":"邹元标","text":"告我诸弟，予猎浮名。\n忆昔负遣，万死一生。\n圣主恩深，归卧溪衡。\n萧萧华发，绝知屏营。\n人间毁誉，羽毛斯轻。\n惟此簧鼓，世比蛙鸣。\n水田之麓，可以躬耕。\n岂无好我，示我周行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勖从子","author":"邹元标","text":"勖哉诸子，无汨尔真。\n诜诜轮轮，难得者身。\n修身维何，蹈道履淳。\n彼佻者子，自堕沈沦。\n耽于酒色，比于匪人。\n时移运失，受此艰辛。\n光阴驹隙，黾勉青春。\n纵尔不思，当念尔亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题许给谏广易通","author":"邹元标","text":"归善杨少宰，卓哉百世贤。\n一从观化后，南望几呜咽。\n挺然赖夫君，研易续新编。\n易道通三才，谁能得其全。\n明珠并瓦砾，随地有真诠。\n达者须识取，一勺即深泉。\n矫揉非大道，神圣以天然。\n寄语会心人，素琴本无弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复真书院睹雪蓬旧隐处","author":"邹元标","text":"不见雪蓬久，今见雪蓬屋。\n图书留四壁，白驹贲空谷。\n高风人去远，遗响振林木。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别曾舜徵仪部 其一","author":"邹元标","text":"结发为兄弟，恩爱永不离。\n羽翮既差池，几度长相思。\n一见一回老，悲喜不自持。\n所嗟津途远，问道何多歧。\n前驱日已暮，策足可迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别曾舜徵仪部 其二","author":"邹元标","text":"君处衡之南，我处湖之西。\n悠悠一水间，辽阔渊与泥。\n言笑方衎衎，征马苦长嘶。\n一间若未达，犹堕千劫迷。\n莫年戒在得，圣训岂无稽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"涉沅湘歌","author":"邹元标","text":"浩浩湘江水，终朝不断流。\n天地有穷处，水流无时休。\n东没千顷田，西荡百沙洲。\n桑田曾几换，历尽几春秋。\n青青红颜子，忽忽尽白头。\n问之何能尔，光阴不暂留。\n试看臂鹰手，力能取公侯。\n一朝忽倾否，白骨委荒丘。\n俯仰天地间，身世如蜉蝣。\n堪怜昏昏者，拘拘如楚囚。\n所以洙泗叟，耻为寝食谋。\n逝者叹如斯，川上坐相求。\n所以碧玉老，一生阳春楼。\n背汗虽未收，木绵被重裘。\n先哲开我蒙，惟有濂溪俦。\n汉唐不知此，思之仍含羞。\n学术苦未力，终夜犹多愁。\n万物皆备我，汲汲当猛修。\n典籍如汗海，役役如倒牛。\n吐辞即为经，莫把六经抽。\n白云满涧户，归袂风飕飕。\n顺理为穷达，无心羡勋猷。\n撒手悬崖坐，海岱一腔收。\n可生亦可死，身外复何忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有儒生思南胡精邵尧夫数学持李同野大参书谒予赠之以诗","author":"邹元标","text":"圣学本无言，言者即不知。\n大道本无思，有思属外驰。\n荣华寻常耳，今古更共之。\n贫贱信所遭，富贵亦有时。\n鹍鹏元万里，鹪鹩自一枝。\n万里元非远，一枝亦非卑。\n嗟嗟寰中士，扰扰竟何为。\n局蹐一生耳，徒令达者嗤。\n置身五行外，庶不负男儿。\n君更勿念我，久矣玩庖羲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"参知蒙山陈先生八十","author":"邹元标","text":"金玉为公资，松柏为公质。\n少年谒金门，端笏扶天日。\n未老先悬车，半榻斋金栗。\n道容穆以睟，洗心藏于密。\n忘道复忘名，世味悉荡潏。\n士林瞻北斗，泰山何崒嵂。\n望云空遥祝，畴能入公室。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"示郑天台山人","author":"邹元标","text":"身在三才中，学超象数先。\n有相终为幻，无为本自然。\n问予何所事，饥餐与倦眠。\n流云閒出岫，栖鸟倦飞还。\n万物皆如此，谁能悟真诠。\n我欲杜吾口，忘言玄更玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独对亭书怀次王阳明先生韵","author":"邹元标","text":"几从江上过，危峰坐中见。\n清秋披蒙茸，始得陟崇巘。\n诸贤聚一堂，图书已识面。\n忆昔迷歧路，困衡不善变。\n博文并格物，留情经与传。\n于今两寘之，深荷圣衷眷。\n古人弃糟粕，用为来者劝。\n素琴本无弦，了心何足辩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中偶吟四首 其一","author":"邹元标","text":"人皆笑拙宦，我独乐有馀。\n浮气日以敛，性天日以舒。\n名者不祥器，况复窃高誉。\n洗心力澄汰，庶不负居诸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中偶吟四首 其二","author":"邹元标","text":"巀嶪白云司，乃在玄武滨。\n湖中有佳果，四时常鲜新。\n昔年产明珠，灼烁光四邻。\n今乃伏泥滓，一望常悲辛。\n堤上松愈好，日暮隐龙鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中偶吟四首 其三","author":"邹元标","text":"予性本刚方，予度甚汪洋。\n片言切名理，服膺讵敢忘。\n泰华难尺度，沧溟岂斗量。\n嗟彼夸毗子，咄咄徒刚肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中偶吟四首 其四","author":"邹元标","text":"我钦邓宗伯，高斋绝轮鞅。\n贫难供菽水，潜身卧草莽。\n一朝膺特命，贤关振韶响。\n簉迹夔龙间，游心羲皇上。\n学问窥天人，玄珠得象罔。\n念予性孤贞，高轩时来往。\n拟卧西山曲，疑义共欣赏。\n予本澹荡者，一见心惝恍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂兴简同志 其一","author":"邹元标","text":"予性本跌宕，投閒性所宜。\n济济青衿士，设礼强为师。\n忆昔文中子，抗颜年少时。\n予学本蹇浅，模范无足仪。\n古有青蓝语，辞让亦何为。\n敩学元相长，矢心共提撕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂兴简同志 其二","author":"邹元标","text":"大道茫茫尔，孝友是根荄。\n利欲戕贼之，正路成蒿莱。\n濯足沧浪水，轩举泰山隈。\n高卑皆自取，孺子得予怀。\n人生多陷溺，平旦良心开。\n良心虽几希，达之贯三才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂兴简同志 其三","author":"邹元标","text":"洙泗微言绝，濂洛扬其徽。\n我明诸大儒，鲁阳戈正挥。\n世儒纷口耳，中心昧是非。\n泰山千仞冈，予其欲振衣。\n鸢鱼察上下，至理无显微。\n冥心复冥心，谁其杜德机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂兴简同志 其四","author":"邹元标","text":"大镛列东序，横击乃有声。\n彼物为妖者，不叩而斯鸣。\n孔门称善问，竟以大儒名。\n有疑斯有问，有问斯乃成。\n教然后知困，予任良匪轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂兴简同志 其五","author":"邹元标","text":"昔谒庐山师，一见相提携。\n嗜利蔽天性，斯言予诵之。\n父母同天地，因利失孝慈。\n兄弟本同气，因利失和怡。\n贫乃士之常，颜宪有良规。\n愿言二三子，冰霜慎自持。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂兴简同志 其六","author":"邹元标","text":"彼美池中鱼，队队何活泼。\n彼美林间鹿，一草相呼掇。\n宇宙原同胞，八荒皆我闼。\n矧我同心人，忍自相秦越。\n迢迢千里道，得侣斯不躠。\n为语同心人，斯道相濡沫。\n长吟伐木诗，慰我中情豁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂兴简同志 其七","author":"邹元标","text":"涧水何瑩彻，仁峰何巃嵷。\n弦诵比邹鲁，先辈多淳风。\n处则躬孝友，出则懋清忠。\n史书扬其烈，高风激予衷。\n年来古道丧，随俗而圆通。\n我资禀庸愚，耐可守颛蒙。\n藩篱须自固，一德以初终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂兴简同志 其八","author":"邹元标","text":"诸生事佔毕，朝夕圣贤书。\n六经何浩瀚，汗牛与充车。\n古人骨已朽，言语皆土苴。\n吾能得其精，经史糟粕馀。\n斲轮解我意，请观无极初。\n年华如流水，勿自负居诸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂兴简同志 其九","author":"邹元标","text":"文章千古事，壮夫比彫虫。\n彫虫虽小技，斯文岂易工。\n今人竞词藻，古人性灵通。\n性灵既以通，源泉滋不穷。\n六经文章伯，无语不鸿濛。\n笔可参造化，谁与领春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂兴简同志 其十","author":"邹元标","text":"圣贤亦有过，此心在自知。\n但能洗心改，便是得师时。\n昔为屠沽子，撒手證菩提。\n昔日蒙不洁，沐浴帝监兹。\n仲由喜闻过，卒为百世师。\n人心良炯炯，无为蹈自欺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒居杂兴 其一","author":"邹元标","text":"尘途争捧檄，皇皇曰为亲。\n苟遂犬马事，而坠百年身。\n曾子能养志，颜生重归仁。\n岂无负米者，扬亲亿万春。\n家有圣善母，七十共艰辛。\n容我衡门老，朝夕共鲈莼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"閒居杂兴 其二","author":"邹元标","text":"万乘原非重，一芥不为轻。\n茅茨即广厦，沟渎亦沧溟。\n翩翩复翩翩，振衣我何营。\n至理已跃如，岂必證无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]