r/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58243,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"史知山纳妾以翠珉斝为贺","author":"顾璘","text":"碧玉雕螭斝，鲜于翡翠毛。\n美人春夜饮，芳晕渍樱桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58244,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"定公房小画二首 其一","author":"顾璘","text":"斲来东海骨，长惹老龙争。\n写作如来供，犹含风雨声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58245,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"定公房小画二首 其二","author":"顾璘","text":"洗尽尘埃色，湘江暮雨馀。\n谁将明月影，留照草堂虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58246,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对菊","author":"顾璘","text":"野客爱寒芳，经旬再举觞。\n名花不在色，美酒独宜香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58247,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阻浅拨闷十首 其一","author":"顾璘","text":"船腹沉泥尾生坼，风日更燥莫禁当。\n鸬鹚鸂?喜川涸，滩上衔鱼来去狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58248,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阻浅拨闷十首 其二","author":"顾璘","text":"白昼风号夜不休，那能寸水为人留。\n千艘并注江湖想，万室兼怀云汉忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58249,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阻浅拨闷十首 其三","author":"顾璘","text":"上闸闭水绝涓滴，下闸水生辄复开。\n我舟公然阁平地，碧波银浪曷从来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58250,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阻浅拨闷十首 其四","author":"顾璘","text":"七十二泉元自多，水曹疏导力如何。\n宋公不作陈老死，沙满涓涓黑马河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58251,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阻浅拨闷十首 其五","author":"顾璘","text":"尺水无柰众相争，大官高艑鼓先鸣。\n估人漕卒且安坐，勿谓尔曹舟重轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58252,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阻浅拨闷十首 其六","author":"顾璘","text":"万方舟楫赴天门，表颂椒宫庆至尊。\n海若纵无波泛辙，云师须遣雨翻盆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58253,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阻浅拨闷十首 其七","author":"顾璘","text":"三日不下一闸门，几时端可到清源。\n老夫白饭尚可饱，漕卒赤拳谁可论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58254,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阻浅拨闷十首 其八","author":"顾璘","text":"正月楼船发古杭，三春■棹汶河傍。\n未愁绿酒追行乐，却恨班衣远故乡。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58255,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阻浅拨闷十首 其九","author":"顾璘","text":"吴苑出门春草萋，汶川行色柳依依。\n故园蔷薇绝堪赏，候水阻风归未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58256,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阻浅拨闷十首 其十","author":"顾璘","text":"岸头古柳绿丝轻，傍石系舟非我情。\n黄鹂不知客愁思，时来底枝送春声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58257,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苦热绝句十首 其一","author":"顾璘","text":"斋中五月暑太甚，纵到天南知不如。\n岂是衡山移岱岳，东蒙分与祝融居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58258,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苦热绝句十首 其二","author":"顾璘","text":"作书海上讯龙公，耐可停舟烈日中。\n天外洗尘须法水，波心清暑借离宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58259,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苦热绝句十首 其三","author":"顾璘","text":"家住江南古帝城，江风长夏绕门生。\n不知头白缘何事，两月官舟触夜行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58260,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苦热绝句十首 其四","author":"顾璘","text":"迎风观上天如水，寒露台前月似霜。\n好待甘泉新赋就，持归此地献君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58261,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苦热绝句十首 其五","author":"顾璘","text":"原尘勃勃草全稀，林木炎炎鸟不飞。\n纵酒须逃十日饮，乘风那挂一絺衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58262,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苦热绝句十首 其六","author":"顾璘","text":"赤云西拥火为峰，红日东驱烛作龙。\n闻道峨眉多积雪，若为飞去荫长松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58263,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苦热绝句十首 其七","author":"顾璘","text":"周武殷汤在眼中，今王圣德古人同。\n禾枯即洒桑林雨，道暍仍嘘柳下风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58264,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苦热绝句十首 其八","author":"顾璘","text":"西照人家昼掩门，船窗浑是暑风屯。\n清川沸作汤池热，凉樾蒸为火树繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58265,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苦热绝句十首 其九","author":"顾璘","text":"云中夜滴金茎露，天上冬藏玉井冰。\n安得九重怜肺病，一时传赐解炎蒸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58266,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苦热绝句十首 其十","author":"顾璘","text":"葵扇桃笙湘竹床，捲帘高卧汗如浆。\n何如赤鲤澄波冷，不及玄蝉密树凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58267,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"积雪楼上把酒四首 其一","author":"顾璘","text":"高楼映雪雪生光，云外神仙白玉堂。\n枉杀相如新赋就，定从何处谒梁王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58268,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"积雪楼上把酒四首 其二","author":"顾璘","text":"雪满空林万木寒，玉峰巉■倚楼看。\n银瓶酒绿狐裘热，六六文窗夜不关。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58269,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"积雪楼上把酒四首 其三","author":"顾璘","text":"楼上题诗满砚冰，城头残雪晃疏灯。\n瑶台月白青云冷，下有寒潭漾列星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58270,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"积雪楼上把酒四首 其四","author":"顾璘","text":"啾啾寒雀拂檐来，榾柮炉深欲作灰。\n雪上红缨高大过，王孙西去猎黄台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58271,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"公宇纳凉四首 其一","author":"顾璘","text":"庭树重重拂院西，更无残日透帘闱。\n胡床一片堪吟啸，却付馀阴众鸟啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58272,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"公宇纳凉四首 其二","author":"顾璘","text":"散发乘风怯病身，出门途路触黄尘。\n每愁入夏妨高兴，不似青春解著人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58273,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"公宇纳凉四首 其三","author":"顾璘","text":"跋涉山溪气郁敲，日中生恐鬓毛焦。\n南薰忽借閒庭爽，羽扇冰浆总不消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58274,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"公宇纳凉四首 其四","author":"顾璘","text":"不愁赤日绕檐来，但取清风洒面开。\n尘事尽抛心似水，使君何必愧无怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58275,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偶题","author":"顾璘","text":"云连树色千嶂合，雨挟泉声一道飞。\n尽有山林溪涧趣，好将佳境畅天机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58276,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟入天津","author":"顾璘","text":"天际乱山横暮霭，水边乔木起秋风。\n扁舟欲过聊停棹，明日京尘便不同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58277,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"村居","author":"顾璘","text":"山回水合树成村，不是桃源是鹿门。\n但有扁舟能送酒，莫言人世五侯尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58278,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再过仲木舍对菊四首 其一","author":"顾璘","text":"旧摘黄花半已稀，重来相对莫言归。\n瓷罂绿酒深如海，判取新霜点客衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58279,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再过仲木舍对菊四首 其二","author":"顾璘","text":"陶令旧无栽秫地，杜陵新借浣花堂。\n白衣绿酒今重至，翠盖金钱晚更芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58280,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再过仲木舍对菊四首 其三","author":"顾璘","text":"岁寒心事特相亲，莫怪留连倒葛巾。\n夜半苦吟寒烬落，锦屏愁杀按歌人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58281,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再过仲木舍对菊四首 其四","author":"顾璘","text":"露渚芙蓉次第残，风林桂树不胜寒。\n青霜素月萧条地，独有黄花耐晚寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58282,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月夜饮九峰山人快园二首 其一","author":"顾璘","text":"露橘霜榴接叶存，古藤修竹覆阶繁。\n谁家池馆深秋后，能遣高歌尽玉尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58283,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月夜饮九峰山人快园二首 其二","author":"顾璘","text":"桂树檀栾荫小山，夜深留客不知还。\n池头月起光如镜，更为殷勤照醉颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58284,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丽江同萧侍御作二首 其一","author":"顾璘","text":"笑共江妃采采霞，锦袍乘月坐浮槎。\n桃花两岸知何处，中隐秦人数百家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58285,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丽江同萧侍御作二首 其二","author":"顾璘","text":"圣主乘龙日好文，高贤簪豸起青云。\n长才渐入麒麟画，雅兴犹悬鹿豕群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295