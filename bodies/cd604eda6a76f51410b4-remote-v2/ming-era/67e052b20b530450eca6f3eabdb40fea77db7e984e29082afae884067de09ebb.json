[{"title":"送静渊上人南还","author":"李英","text":"折柳仍南渡，拈花自北归。\n紫衣看独往，白社又相违。\n江练春题句，山垆夜掩扉。\n思君何处梦，遥傍楚天飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送程太学无过归省新安二首 其一","author":"李英","text":"谈经名冠鲁诸生，侠气翩翩宝剑横。\n何事今朝成去住，五陵芳草不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送程太学无过归省新安二首 其二","author":"李英","text":"承颜归去意如何，白岳黄山隐薜萝。\n此日江淹犹赋别，太行城上夕阳多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送程上舍虞仲归省新安","author":"李英","text":"春鸿飞欲尽，何处望新安。\n送尔扬鞭去，还家戏綵欢。\n山霞裁作佩，陂竹选成竿。\n吾亦将归客，沧洲老鹖冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱博士以礼上人画竹索题二首 其一","author":"李英","text":"南来长干僧，解写江陵竹。\n有斐德不孤，为君诵淇澳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱博士以礼上人画竹索题二首 其二","author":"李英","text":"高阁日盘桓，来从雪里看。\n谁知广文馆，偏有翠琅玕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访何元贞不值马上口占","author":"李英","text":"万木凋零夕照间，萧萧朔气下边关。\n雪中骑马咸阳客，犹似山阴访戴还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题张光禄纪游画卷六首 其一 琼楼观海","author":"李英","text":"辽阳使者日临关，公子趋庭望海山。\n倚马挥毫铭已勒，恰如张载剑门还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题张光禄纪游画卷六首 其二 曲江游眺","author":"李英","text":"汉家宫殿曲江头，更向慈恩寺里游。\n应是金钱曾诏赐，玉笙瑶管醉高秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题张光禄纪游画卷六首 其三 皋兰观猎","author":"李英","text":"白草黄沙羽猎齐，将军鏖战马频嘶。\n筹边已断匈奴臂，百万蒐田大夏西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题张光禄纪游画卷六首 其四 金陵怀古","author":"李英","text":"谁似南游美少年，扁舟桃叶渡头烟。\n乌衣朱雀今何在，惟有长干古寺禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题张光禄纪游画卷六首 其五 虎丘访僧","author":"李英","text":"吴王宫里树啼乌，伍子祠前草亦芜。\n头白山僧忘说法，剑池西畔梵堂孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题张光禄纪游画卷六首 其六 仙宫祝寿","author":"李英","text":"稽首清都宝殿前，五云晴日丽中天。\n三呼犹似嵩山下，长为君王祝万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王运使赴长芦","author":"李英","text":"冠盖萧骅骝，仙郎赋远游。\n玉珂辞帝里，朱戟过沧洲。\n海色千门曙，春烟万树浮。\n早成盐铁论，国计借良筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮访杨茂才客馆","author":"李英","text":"星霜老却一荷衣，回首穷途万事非。\n旅食逢君怜岁序，羁栖久客待春归。\n孤琴短剑寒相傍，白石清泉梦自飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚辰人日书怀","author":"李英","text":"虬潜怀旧隐，雁字久沈冥。\n又值人为日，堪怜客是星。\n穷愁双眼白，下走一衣青。\n木榻谁相问，辽东愧管宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬杨茂才见访","author":"李英","text":"上苑春初暖，重逢话故山。\n佣书君自匿，投袂我将还。\n马磨频资客，牛车待出关。\n飞云高绝处，他日忆跻攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答傅生","author":"李英","text":"昨得南来札，开椷字字愁。\n苍茫关树尽，迢递汉江流。\n朔雪家何处，秋风客买舟。\n辄思云卧好，焉敢负罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬容彦存见访","author":"李英","text":"乘兴谁知是子猷，过存意气忽千秋。\n边歌雪后空芦管，客计春深尚蒯缑。\n何事乾坤多感慨，自堪闾里共沈浮。\n酒泉不似佣书日，莫向班生论拜侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠聂丈人二首 其一","author":"李英","text":"何来长啸蹑云烟，囊似韩康卖药年。\n自昔灞陵无二价，相逢谁解识神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠聂丈人二首 其二","author":"李英","text":"山中大药几时成，黄帽青鞋入汉京。\n休怪儿童惊异貌，共传三耳是先生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕","author":"李英","text":"风尘六载客京师，寥落丹岩桂树枝。\n七夕每逢长□□，双星何事怨将离。\n多愁宋玉难成赋，短鬓潘郎渐有丝。\n江汉苍茫秋色里，闺门犹自滞归期。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀","author":"李英","text":"荒斋客已六年逋，故国山川梦寐俱。\n双膝每勤参大士，一编宁解著潜夫。\n谁怜久病癯如沈，独有交游侠似朱。\n却望秋江南去路，烟霞堪自老头颅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酌别友生","author":"李英","text":"新丰市上少年场，握别垆头忆故乡。\n莫谓李生贫彻骨，赠君惟有剑如霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋风","author":"李英","text":"故国椷书绝塞鸿，关山何地不秋风。\n军符南入兵戈里，虏骑东来涕泪中。\n拙计烟霞思束楚，浮生沧海叹飘蓬。\n登楼颇似荆州日，王粲淹留赋独雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬朱子厚方永叔二公子见寄","author":"李英","text":"公子翩翩气自豪，梅花双使念绨袍。\n何来乐府传鱼素，并向词林识凤毛。\n家出南阳连郏鄏，名标北斗起风骚。\n抠衣一望三千里，嵩少崚嶒月色高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与黄表兄夜话","author":"李英","text":"高楼玉笛朔风惊，落魄长安弟与兄。\n中夜饭牛羞宁子，几年投笔学班生。\n天涯已倦驱车走，海上将归把钓行。\n搔首乡书遥阻绝，渔樵何日罢谈兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛巳元日对酒作","author":"李英","text":"凤历初开日，春风宽客怀。\n浮生元草莽，纵饮自茅柴。\n落羽八千里，行歌十二街。\n飘然吾欲去，丘壑蹑芒鞋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再酬朱子厚方永叔二公子见寄","author":"李英","text":"青云桐柏卧烟萝，二妙芳名谢氏多。\n南陌看花应并驾，西园飞盖共高歌。\n听莺尚待华阳馆，椷鲤频传□□□。\n以我侠游消岁月，江湖偏自忆渔蓑。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访曾参军留酌遇冯朱二山人同集","author":"李英","text":"参军高兴剧，醉客酒如渑。\n意气论千古，风流冠五陵。\n朱家名自侠，冯衍赋偏能。\n不厌貂裘敝，恒阳共一登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭芳弟二首 其一","author":"李英","text":"荆树庭前别，北来音信稀。\n无论生是寄，只道死如归。\n鹤发家何在，鸰原事已非。\n关山燕粤隔，忆汝但柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭芳弟二首 其二","author":"李英","text":"骨肉伤凋谢，泉台杳奈何。\n逢时仍梦寐，葬地且烟萝。\n明月三江水，扁舟一钓蓑。\n凄其怜大被，夜夜泪痕多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出京留别诸君子","author":"李英","text":"一出关门诵五噫，山川迢递欲何之。\n不堪独客牛车送，祇为双亲鹤发垂。\n白社解携行复恋，青春作伴去无疑。\n别来倘念罗浮隐，须托鳞鸿慰所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"德州晚酌","author":"李英","text":"岳色晴堪望，平原夕照长。\n沈冥思曼倩，纵饮问嵇康。\n何处缁尘客，还山薜荔裳。\n河船鱼鸟近，摇笔赋沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"徐州览眺","author":"李英","text":"汴泗千秋地，飞艘向此行。\n河更春涨起，山隐暮云平。\n疏柳南归梦，征鸿北望情。\n天涯劳尺素，迢递隔神京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淮阴夜泊","author":"李英","text":"淮水日悠悠，南征达楚州。\n荒凉何代郡，飘泊此□舟。\n漂絮曾施食，持竿亦拜侯。\n孤城欹枕卧，一夜听东流。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵赠陆秀才无从","author":"李英","text":"怜君偃蹇老诸生，海内论才有大名。\n白云一时称寡和，绨袍终古见交情。\n山居玩世嵇中散，道路还家阮步兵。\n十载旧游重把袂，竹西亭畔楚云平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡江","author":"李英","text":"长江那可渡，白浪渺秋烟。\n歌后犹持楫，愁来一扣舷。\n飞帆晴树外，归鸟夕阳边。\n飘泊知何处，渔灯傍客眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵客馆秋日写怀","author":"李英","text":"西风飒飒白云秋，病后飘零感敝裘。\n一骑乍从燕市下，十年仍作秣陵游。\n移舟□醉垆头酒，问月频登江上楼。\n喜得南来家渐近，不堪归梦过罗浮。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日陆山人华甫见过夜集得歌字","author":"李英","text":"双剑频能合，羁栖思若何。\n佩萸酬令节，酌酒一高歌。\n雁字秦关远，牛衣洛下多。\n灯前君且醉，行乐在烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访无着上人","author":"李英","text":"吴市吹篪客，閒来伴衲衣。\n似因玄理妙，益觉俗尘非。\n落日停沧海，寒云拥翠微。\n竹垆煨芋栗，谈笑坐忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答方永叔见寄","author":"李英","text":"斋署青灯下，飞书见远情。\n登楼瞻岳色，隐几听江声。\n明月双鸿过，西风孤剑横。\n忆君多慷慨，千里结幽盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得朱子厚书却寄","author":"李英","text":"迢递南阳使，慇勤报尺书。\n仙山君驾鹤，宾馆我歌鱼。\n风雨青萍气，烟霄白水居。\n西园高宴日，飞盖更何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白下逢张太学幼于","author":"李英","text":"淮南一别不相闻，茂苑深栖最忆君。\n龙卧剑池藏紫气，鸾飞钟阜啸青云。\n乍惊蓬鬓飘霜色，共向茅斋坐夕曛。\n自昔才名称绮岁，风流何但汉终军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"普德寺寻悦上人不遇","author":"李英","text":"□中怀净土，犹隔几尘沙。\n金界风烟色，珠林日月华。\n悟来云是影，讲后雨为花。\n何事支郎去，疏梅一树斜。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游报恩寺访恩上人","author":"李英","text":"蹑屧登金地，逢师一语同。\n此生元似幻，无色不成空。\n慧日开灵境，慈云护法宫。\n未须谈六代，禅藻在江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日即事","author":"李英","text":"无家吾已惯，岂但似山僧。\n延客不沽酒，呼童或煮冰。\n茅斋空四壁，蒯剑照孤灯。\n独有罗浮梦，依然在曲肱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀静修上人二首 其一","author":"李英","text":"支郎词赋不群才，双树林中白社开。\n匹马解携江左去，相思多在凤凰台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀静修上人二首 其二","author":"李英","text":"溪头三笑别时情，蓟北江南万里程。\n独有八行凭塞雁，心随明月过西京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠万山人未夫","author":"李英","text":"海内论骚赋，君如楚大夫。\n驰驱称上乘，名姓冠西都。\n梦与湘江远，身随汉月孤。\n袖中双剑在，人识是昆吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将发金陵逢卢部掾达成饮别","author":"李英","text":"世情何必论炎凉，卮酒君能典鹔鹴。\n久向粤南怀陆贾，偶来江左得周郎。\n功名尺寸烟霄外，桑梓交游水石傍。\n磊落泥涂唯我拙，归心今在白云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度岭","author":"李英","text":"舍舟横浦度梅关，匹马驱驰万仞山。\n却忆鹿门妻子在，犁锄蓑笠待人还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪上","author":"李英","text":"溪上西风吹鹖冠，家贫归计强承欢。\n谁知阙下佣书者，又向沧浪理钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游浮邱","author":"李英","text":"一叩朱明户，天南此地孤。\n白云开薜荔，秋色散蘼芜。\n蒲涧谁名汉，诃林不属吴。\n赐归荣秘监，何但镜为湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋德庆舟中同欧黄苏诸君子玩月","author":"李英","text":"漓江水南下，海甸月东升。\n野客坐仍立，林猿牵欲行。\n团圞爱光景，萍梗恋良朋。\n念此绸缪夕，柁楼沈醉凭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入南江口至罗定值病遂东下","author":"李英","text":"西游忽两月，何事滞津途。\n牛马身空老，烟霞病未苏。\n朝餐足野蕨，晚酌觅江鲈。\n值此西风发，扁舟过五湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊厓门吊古","author":"李英","text":"宋家飘泊到厓门，终古令人一怆魂。\n此际征帆不可渡，满天风雨下黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初至大麻山中呈欧黄陈赵诸樵长","author":"李英","text":"褐衣犹愧老明时，肮脏何人念鬓丝。\n沧浦钓竿今暂舍，麻山樵斧复相随。\n入林猿鹤迎新侣，到处烟霞似故知。\n蹑峤凭高一长啸，苍茫秋色海天垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊子春日督学郭公招游罗浮值患足疮不及往怅望赋此","author":"李英","text":"敢云禽尚婚嫁毕，五岳以下拟游纵。\n虚度一万六千日，无缘四百三十峰。\n只今浮江望綵鹢，忆昔登岱佩苍龙。\n值此春光未能往，怅然海水心朝宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得王使君裕参书却寄三首 其一","author":"李英","text":"使君风雅世间稀，薇省芳尊醉布衣。\n綵笔题诗辞粤峤，至今山色有光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得王使君裕参书却寄三首 其二","author":"李英","text":"陆贾装轻亦汉臣，五羊人吏送江滨。\n量移诏下趋东郡，司理扶风第一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得王使君裕参书却寄三首 其三","author":"李英","text":"塞鸿南下过秦关，万里椷书慰老颜。\n欹枕松窗明月夜，梦云飞绕太行山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初开酒馆承欧黄苏李诸词客过辱篇什酬答一首","author":"李英","text":"堪怜六十烟岩老，忆昔西游旧故知。\n入社久从词客赋，谈天曾有尚书期。\n敝貂归卧贫无似，涤器当垆胡所为。\n但有群才题下走，风流不减五陵时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕旅泊石湾杨明壮携酒见过舟中","author":"李英","text":"江乡晚泊叹飘蓬，载酒劳君慰寂寥。\n总为生涯羁逆旅，共看灯月庆良宵。\n笙歌到处人同乐，春色盈津柳独骄。\n草莽山林当盛世，清泉白石老渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日游永泰寺","author":"李英","text":"东山开宝地，方外有良缘。\n偶与许洵辈，来参支遁禅。\n晴光分翠岱，春色满诸天。\n不尽贪幽兴，松林锁夕烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明日谒先考妣墓","author":"李英","text":"独抱终天恨，思亲泪未乾。\n坟茔一沾洒，风木几摧残。\n日落猿声急，云愁山色寒。\n泉台封闭后，形影梦中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题青白菜图赠铁生","author":"李英","text":"传家青白凛寒冰，种得畦蔬积雪层。\n闻道三公曾不屑，灌园何但似于陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题崇恩茂异卷","author":"李英","text":"逸士名偏重，风流似鹿门。\n一时推硕隐，万里拜皇恩。\n白发家多庆，青霞道自尊。\n高堂荣綵服，颂客满前轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送盛泰甫还无锡","author":"李英","text":"浪迹大江湖，长安旧酒徒。\n散金交态尽，抱剑客情孤。\n张翰思归切，虞翻感滞无。\n明朝关外骑，飞梦到三吴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李上舍谒选入京","author":"李英","text":"翩翩公子谒金门，元是忠贞太仆孙。\n自昔西京功业盛，赤心知尔报君恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]