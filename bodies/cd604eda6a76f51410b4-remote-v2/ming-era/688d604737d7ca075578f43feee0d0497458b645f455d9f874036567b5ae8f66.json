[{"title":"秋怀 其十六","author":"王元俸","text":"两见芙蓉映水开，孤城游客独徘徊。\n壮心暗逐高歌尽，吟苦频惊白发催。\n门掩残阳鸣鸟雀，寺临秋水见楼台。\n微茫淡月钟声下，潦倒新停浊酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其十七","author":"王元俸","text":"竹冈藤树小跻攀，未报深恩鬓已斑。\n凿壁犹怜前日事，望云空见暂时閒。\n烟霞正值萧条候，亲友相逢梦寐间。\n多病独愁常阒寂，半帘初日未开关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其十八","author":"王元俸","text":"秋山铙吹拥登台，摇落谁怜作赋才。\n柳巷任疏容马入，残花怅望向人开。\n别来朋旧长相忆，客里风霜暗自催。\n酒罢消愁消不得，隔篱呼取尽馀杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其十九","author":"王元俸","text":"眼前今古泪交颐，天远楼高宋玉悲。\n满院落花从覆地，旧山残烧几侵篱。\n风飘玉笛凄初断，云破霜鸿欲度迟。\n纵有芳尊心不醉，更应无处展愁眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其二十","author":"王元俸","text":"生涯心事已蹉跎，敢向明时叩角歌。\n游客寂寥缄远恨，故园零落泣沧波。\n晴云古木月初上，残角山城晚更多。\n旧里若为归去好，破斋残径闭烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游洞岩","author":"王元俸","text":"年光自感忆蹉跎，不着方袍爱绿萝。\n万壑烟霞秋后到，半天鸾鹤梦时过。\n竹间驻马题诗去，石上横琴得醉多。\n流荡此心难共说，因牵俗累欲如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜泛舟","author":"王元俸","text":"满船明月浸虚空，荡漾清光一望同。\n半世行藏浑是梦，十年尘事只如风。\n参差草色迷蓑艇，狼藉蘋花上钓筒。\n添得五湖多少恨，夕阳江上正飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五坡祠谒文信国","author":"陈言","text":"吾道终无一日遗，太邱亡社此存祠。\n扶持千古纲常处，剥尽五阳元气时。\n天有星辰为肖貌，地将溟渤作尊彝。\n须知养士功成后，汉寝唐陵不共悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将抵任与映日叙别","author":"黎新之","text":"且自沾微禄，谁其怀好音。\n青云存旧业，白发忤初心。\n世路信浮梗，生涯只素琴。\n翻嫌台鼎上，荣辱递相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"僦馆河南","author":"黎新之","text":"一堤如画舫，四面水帘清。\n野树攒烟岛，寒涛撼古城。\n渔归荒浦寂，鸥泛晚潮轻。\n爱此称吟意，兼之少送迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古琴","author":"黎新之","text":"梧桐委匣何零落，冷韵依稀留太朴。\n寥寥元指閟虚鸣，脱却声闻见本情。\n山水清音元自寂，不于其动于其息。\n鸟啼花落写幽真，凄清淡漠能移人。\n纷纷里耳行须侧，听处求声声不得。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"津口登舟","author":"李殷鼎","text":"戒涂常畏险，去去复登舟。\n峡口云无定，津前水自流。\n孤篷横落日，客梦迫残秋。\n暝色浑无际，寥天望转幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次羚羊峡","author":"李殷鼎","text":"向晚群嚣息，移舟傍水隈。\n岩花迎露落，林鸟御风来。\n野寺钟声歇，荒村客思哀。\n推篷看明月，舟子莫相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别季美","author":"李殷鼎","text":"话别江头江水清，骊歌野笛送行旌。\n可怜萍迹春云似，无奈兰心夜雨倾。\n千里山河他日恨，百年天地此时情。\n欲知魂梦相于处，白鹿窗前看月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀梁唤期","author":"李殷鼎","text":"绿阴野色竞相鲜，几度怀君最可怜。\n一自河梁相隔别，至今鱼雁两茫然。\n雨馀云树春芳满，月朗关山客梦悬。\n万里相思情转剧，不堪回首动经年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"李殷鼎","text":"长空一色碧玻瓈，宝篆香销弓月迷。\n徙倚自怜衣被薄，寒烟深雾锁窗西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹤洲渔唱","author":"吴文扬","text":"烟霞渺渺水茫茫，短笛扁舟杂遝行。\n一曲咿哑调夜月，数声欸乃入沧浪。\n沙边矶石渔家傲，江外松涛鹤梦长。\n醉卧秋风吹不散，满蓬月色水云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游香炉庵","author":"李三英","text":"溪容青雀舫，路转白蘋洲。\n及岸松杉引，入山薜荔留。\n鹿门终不负，鹤诏尚须酬。\n无限登临意，聊为汗漫游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游洪山寺","author":"李质","text":"洪山佛殿晓鸣钟，蹑蹬登临叩远公。\n绿水西来演不二，青莲南涌透禅宗。\n天花乱落芙蓉外，龙藏深涵咒钵中。\n我欲步虚超上乘，却惭尘梦未能空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飓风","author":"李质","text":"一段虹霓出海隅，八风如战雨倾衢。\n楼头绿树连根拔，陌上青秧贴水枯。\n正拟望秋差有庾，那思卒岁更无襦。\n推窗一望天初霁，早有年排说晚租。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登灵光寺栖感秋","author":"贺南凤","text":"独上高楼思何穷，况复秋光入望中。\n术未能仙曾远地，天将可问莫书空。\n悬怀最是云□白，游目偏惊树叶红。\n漫对苍苍千岁柏，珊然笑傲与谁同。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和远览韵","author":"钟宪","text":"此乐先生真异趣，乘闲来玩忘此情。\n幽深涧壑泉滢洁，一洗令人器宇清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读书台","author":"谭澄","text":"一代英才百代雄，唐朝清誉圣朝同。\n忠诚谏疏心惟切，山斗文章道自崇。\n地涌涧泉随处乐，天生崖石岂无功。\n当时过化今犹盛，赫赫名垂宇宙中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读书台","author":"廖兴","text":"吟迹岩空覆绿苔，俄然天地此高台。\n颓波力障心常在，荣政周除雪后来。\n景仰光风山独秀，绪馀遗泽水深回。\n后车可继资贤令，伟伟乾坤更看谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒韩先生书台次韵","author":"陈祯","text":"昌黎一去此山虚，却喜遗风尚绪馀。\n吟迹苔封微见字，坐痕云冷已无书。\n乾坤有意来斯老，草木生香记后车。\n百世之师真我信，特从台下一抠趋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠寺 其一","author":"冯元基","text":"长歌游宝地，延步爱清晨。\n烟气笼青阁，晴光转绿蘋。\n城边楼枕海，竹外鸟窥人。\n古殿焚香外，白云心所亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠寺 其二","author":"冯元基","text":"野寺江天阔，萧疏台殿凉。\n青林依石塔，危槛等飞樯。\n暝色生寒树，滩声聒夕阳。\n看心兼送目，都使俗情忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"增江道中","author":"冯元基","text":"芳草碧凄凄，斜阳向客低。\n竹光摇古道，树色绕长溪。\n酒每村中醉，诗多骡背题。\n离家虽未久，又听子规啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乡旋留别区吉先朱昌藩","author":"冯元基","text":"归心虽已切，未忍即离群。\n不觉三春暮，相将歧路分。\n花间馀落日，竹外隐行云。\n却惜莺声好，明朝空独闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫花溪道中作","author":"冯元基","text":"山北山南路正长，东风吹送野花香。\n数声啼鸟知春雨，一路归人背夕阳。\n溪水长年流不尽，岭云终日变无常。\n身逢胜迹应难遍，游思萧条转易伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白云洞","author":"曾君棐","text":"不知云瀑处，隔岭隐轻雷。\n峭壁排天出，垂虹捲雨来。\n石床荒积藓，瑶草入流杯。\n即此堪遗世，山阿多桂材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日山斋作寄山舟","author":"程煜","text":"窸窸风动帘，潇潇雨在竹。\n蒲柳抽春妍，窗扉媚新绿。\n幽人了无事，得饱睡便足。\n梦醒卧村童，书声出茅屋。\n开门即青山，山山啼啄木。\n此时珠海边，江波何许绿。\n相望千里遥，离愁断相续。\n何日一归舟，孤灯对床宿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种竹","author":"程煜","text":"小园种桃复种松，中间隙地宽数弓。\n种蕉惹雨李惹虫，欲种绿竹摇清风。\n覆以黄土灌以水，数日嫩绿抽葱葱。\n明年箨卸新荫浓，低垂量得遮书窗。\n窗中冰簟四时碧，林下桃花三月红。\n桃花落尽信风急，松声竹声摩碧空。\n閒人时来竹根下，一香一茗携一童，卧读离骚人不逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"樊文宗复来督学志喜","author":"李梦熊","text":"夹道皇华列锦茵，转移文运仗词臣。\n才量玉尺恩逾旧，命拜金门宠自新。\n爱日未遑工戏綵，谈风长此懔书绅。\n一条水署交相庆，两度珊罗擅席珍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠恩平开平陵水三明府","author":"李梦熊","text":"豸史风流盖世才，偶于棘院仰鸿裁。\n量同珠海标三杰，清比冰壶搆众材。\n竹马芳名传岭表，弦歌雅化上春台。\n牛刀小用恩逾大，好把桃花满县栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东山寺","author":"陈式琜","text":"散步东山寺，飘飘欲御风。\n神閒千偈觉，心静万缘空。\n涧水窥潜鲤，天涯没远鸿。\n悠然何所寄，乐在忘言中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"普陀岩","author":"陈式琜","text":"闻道西山好，灵岩深几重。\n晨光紫气合，暮霭赤霞封。\n落叶藏幽径，微风送晚钟。\n欲知清净理，此地是南宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西园夜饮","author":"陈式琜","text":"古树带烟萝，池塘生绿波。\n名花槛外见，修竹水边多。\n名士持觞酌，佳人联袂歌。\n留连尽一石，休问夜如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹灶 其一","author":"黎必升","text":"欲待将来问渡人，风帆不动石常新。\n独怜尘世谁能载，鉴水流花空自春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹灶 其二","author":"黎必升","text":"乘云仙去隔烟霞，古灶荒凉夕照斜。\n岁岁春归苔藓碧，何人为觅旧丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝光塔","author":"张晓","text":"浮图九级俯江流，乘兴抠衣豁倦眸。\n万里雄风吹短袖，四山疏雨澹高秋。\n星辰半自长空落，云气低联远岫浮。\n回首尘寰烟树隔，犹疑飞鸟傍云游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"墨池书院","author":"李元若","text":"闻说名家有墨池，喜今开对笔山奇。\n撑云倒影池塘里，错疑前峰洗笔时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"失题","author":"黄兰","text":"虚度韶光八十秋，倦飞山鸟已还休。\n惭无袜线缝华衮，自剪蓑衣俯碧流。\n尺素免教来使急，閒心刚被野云留。\n更怜筋力难为礼，愿借溪山隐白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜次陈次卯韵","author":"柯元楫","text":"露重花梢滴有声，閒庭人静听残更。\n相思最怕楼头月，照入空床梦不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊萧廉泉阖门殉节","author":"光容","text":"保康城头悲风起，一万贼兵渡江水。\n姚家伪帜白云屯，斯民如汤沸未止。\n但令满耳闻呼号，大尹何在开门逃。\n白头老尉更楼坐，芒干牛斗有霜刀。\n选择健儿躯干好，痛哭陈词严征讨。\n臣职卑小臣力微，三里孤城涂肝脑。\n圣主有臣臣有子，与妻及妇同日死。\n天意犹存八岁孙，生自森严戈戟里。\n次子匍匐东粤来，痛收忠节遗支骸。\n沙场莫笑征行苦，几见微官著大才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黎求，南海人。事见清康熙《禺峡山志》卷三阙题","author":"黎求","text":"方丈借山区，灵峰即二禺。\n寻泉清嶂断，藉草白云俱。\n岩树摇楼榭，窗烟冷狖鼯。\n坐怜神物变，惆怅对江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阙题","author":"刘礿","text":"扪萝不足惮，策杖独言从。\n数里闻流水，双林过午钟。\n天花点石静，海树入窗重。\n梵理吾将达，因兹问法宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瑶林","author":"朱谨","text":"森壁郁苕林，一一琼瑶色。\n时有古仙人，临风吹铁笛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山寺","author":"朱良机","text":"野寺春回积雪消，半晴天气漫停桡。\n映阶碧草香犹湿，照眼榴花暖自娇。\n客计祇凭孤剑在，帝京北望此心遥。\n美人有约沧洲外，拟抱阳春和玉箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阙题","author":"陈应奎","text":"峡山山水称奇胜，万壑烟笼禅宇靓。\n双峰削出天门寒，一泓绿绕神仙境。\n何年古殿自飞来，参差楼阁凌空开。\n朱甍入云莽欲坠，山光树色相崔巍。\n福地人间传十九，疏钟朝暮螭龙走。\n层峦蹲踞隐蓬莱，猿环犀锁应疑否。\n我来飞锡问其真，孤高直上迥无尘。\n酣歌一笑振林木，昙花乱落明芳春。\n抠衣直欲访安期，云根煮石烹琼脂。\n和光洞口窥禅定，争奈舟师促去岐。\n古来丈夫何定处，得意江山随去住。\n胜地应教待再来，片帆且逐天风去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阙题","author":"曾道约","text":"峡寺临江出，丹梯断复连。\n鹭飞惊涧瀑，猿啸破松烟。\n□□□梁□，亭□忆稚川。\n扁舟无限兴，归路碧寥天。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同梁肯新云中侄游阴那山寺","author":"黄华","text":"叠嶂凌空结化城，探奇共喜值新晴。\n山房月出夜摩界，云壑泉飞太古声。\n猿鸟中宵随衲定，松杉亭午伴经清。\n庭前柏子青青色，今昔何人同作盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿阴那山寺","author":"梁日暾","text":"青青不了路横斜，满目清幽应接奢。\n树色溪声高士意，山光云影梵王家。\n岭猿含果僧供食，细雨添泉佛送茶。\n从此身心皈正觉，三生长御白牛车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题江山胜览图","author":"颜宗","text":"万里湖山万里天，水光云影自悠然。\n日升旸谷浮金晕，春满堪舆蔼瑞烟。\n隔垄骑牛吹牧笛，横江拖网取鱼船。\n将军昔与盟诗社，索写无声胜辋川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古 其一","author":"何治","text":"无怠无荒，四夷来王。\n怠而荒矣，厓山其亡。\n厓山兀兀，厓水汤汤。\n天地其长，日月其光。\n鉴前者失，愿献我皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古 其二","author":"何治","text":"兴亡事往山河在，潮汐天然日夜回。\n一个是谁成就得，三公仁自舍生来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古 其三","author":"何治","text":"庙门高倚夕阳开，古木苍藤猿啸哀。\n金阙汴京何处所，慈元宫殿长蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古 其四","author":"何治","text":"五更有数符难易，四广逢厓势易穷。\n独抱春秋昭大义，分明夷夏见孤忠。\n巍巍古庙晴天外，历历遗墟夕照中。\n这莫沈沙销铁戟，海云烟月属渔翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"话竹庵守岁","author":"谭云鸿","text":"孤灯禅榻两相支，风晓长松雪压篱。\n穷惯不劳送五鬼，罪缘终合骂三尸。\n一年将尽怜杯滴，万事无成泣鬓丝。\n深感乞钱苏司马，拟随春屐问时时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"松江塔阁","author":"汤铉","text":"梅岭昔既营，梅水何年瀹。\n万派会松江，众流资锁钥。\n翠屏千仞合，丹嶂五丁凿。\n鸦髻峙西华，阴那拟岱岳。\n笃生斯异人，山斗称文学。\n弱冠冠粤东，秋风抟鹏鹗。\n仰视奎壁光，俯瞰东井络。\n乃知文章府，墨食以谋度。\n肇建兹灵图，芙蓉真秀削。\n欲借巨灵手，倒擎写碧落。\n玉峰映紫霞，金碧纷相错。\n鬼斧与神工，驱蛟兼徙鳄。\n如彼螺子川，金牛相喷礴。\n文光既射斗，宝剑初淬锷。\n雁塔既题名，始得丹涂艧。\n巫筮仕古帝，居政声何卓。\n岭南夫子名，鸣琴以振铎。\n秩满晋司农，四海皆饶乐。\n晋阳操月斧，五云生朱襮。\n天子召平台，万言皆谔谔。\n鸾坡视御草，玉署翻红药。\n讲幄近少微，青宫侈铜鹤。\n会遭阳九运，完节归岩壑。\n胜会集耆英，结社亦仿洛。\n烟雨隐垂纶，田园甘藜藿。\n身退名益重，道高辞好爵。\n悠悠二十年，遗像留杰阁。\n嫩绿上苔阶，香篆饶帘箔。\n我来勤瞻谒，音徽宛如昨。\n灏气返大虚，元英满广漠。\n严陵一钓台，千载终有托。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"松江塔诗","author":"吴秋","text":"岚烟起处万松低，秀矗轮尖便不齐。\n抒写性灵应独上，提携童冠许同侪。\n声传云外惊人铎，影落秋空涤砚溪。\n绕塔桂花红杏树，丰标如许尽分题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有赠","author":"宋巘","text":"猎猎旌幢拥自东，云中江树访归篷。\n天留一代成勋业，人共千秋诵孝忠。\n醉里捲波看臂血，灯前拂剑吐骄虹。\n清时共济多卿衮，肯负苍生卧尉公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏红梅","author":"刘孟海","text":"寒梅□□月，色映绛霞流。\n点额凝脂堕，娇妆傅粉羞。\n醉容临玉镜，朱袖拂琼楼。\n莫遣关山笛，西风吹暮愁。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古 其一","author":"张同祁","text":"江上徘徊未罢兵，南来愁傍帝星明。\n殊方合有兴王地，异港翻摧大将营。\n冻雨欲分洟泪色，秋涛先起佩环声。\n不缘孤愤间关尽，夜夜能兼海气浾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]