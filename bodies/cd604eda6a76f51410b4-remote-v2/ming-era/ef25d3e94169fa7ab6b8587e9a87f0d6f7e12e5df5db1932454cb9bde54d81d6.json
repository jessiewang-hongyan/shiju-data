[{"title":"题倦绣图","author":"郑文康","text":"暖笼双袖亸云鬟，绣出鸳鸯带笑看。\n侍女不须猜倦倚，玉纤冰冷怯针寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题烂柯图","author":"郑文康","text":"一局棋残已烂柯，仙家岁月信难过。\n衣衫最是轻柔物，不识当时烂几何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜故人子至","author":"郑文康","text":"百年茅屋几秋风，已见高门在眼中。\n况尔累累尽英物，高曾元是汉于公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题黄生文稿","author":"郑文康","text":"不识黄家玉树枝，偶于草藁见文辞。\n若非沈老同庵里，那得诸生有项斯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梅花送沈太守之广州","author":"郑文康","text":"笑乘五马向南天，一路仁风卷瘴烟。\n心比梅花更清白，任教人说有贪泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题小画","author":"郑文康","text":"杨柳村西野路荒，渡头风急水如汤。\n客行不用忧狼虎，只恐逢人变虎狼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宗能寓夏氏馆暑夜以诗招之","author":"郑文康","text":"故人清话类清标，清似清风月下飘。\n不及清风能自至，故人须待寄诗邀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江行逢渔父","author":"郑文康","text":"衣食年年半有无，冷风寒雨在江湖。\n长贫不为官家课，尽送黄公旧酒垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题倪元镇双树小景","author":"郑文康","text":"百年片纸非朋贝，湖海收藏墨未昏。\n金谷园中千万树，不知留得几株存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题菖蒲","author":"郑文康","text":"抱持清节任清癯，独笑山花醉似泥。\n欲寄杨家旧知己，问谁驿使过关西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题云山小隐","author":"郑文康","text":"远山云白近山青，竹里芽斋水上亭。\n常恐城中官客至，带将尘土污阶厅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27146,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读张骞传","author":"郑文康","text":"汉家西域是谁开，博望功成事可哀。\n断送壮夫知几许，换将胡物过东来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读归去来辞","author":"郑文康","text":"折腰懒向督邮前，归去还耕栗里田。\n身到元嘉将十载，梦魂只在义熙年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江乡","author":"郑文康","text":"江乡酒熟黍离离，莼菜鲈鱼正及时。\n堪笑同行门外客，月明乌鹊叹无枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题刘龙洲像","author":"郑文康","text":"长髯广额酒杯深，人物孤高月下岑。\n七尺微躯三寸舌，江湖形迹庙堂心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野云","author":"郑文康","text":"野云如水涌如汤，飞向遥天入渺茫。\n人说野云闲似我，看来翻觉野云忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀叶与中 其一","author":"郑文康","text":"石浦桥头少保家，有田有宅有船车。\n芙蓉黄菊开将遍，白酒莼羹稨豆茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀叶与中 其二","author":"郑文康","text":"十亩金潼隔市廛，水香地暖草如烟。\n奉思庵外长松下，明月清风不用钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀叶与中 其三","author":"郑文康","text":"新买斋居近学宫，传家书籍尽堪容。\n北窗又有娱情物，三里青山百丈峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题邵启南橘轩","author":"郑文康","text":"橘叶青青橘柚黄，药垆茶灶尽生光。\n宽衣大袖秋香里，一卷灵枢不下堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题邵启南橘轩","author":"郑文康","text":"自古神仙事渺茫，郴州橘井渐遗忘。\n家传只用君臣药，不惯单行施疗方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀孙绍先","author":"郑文康","text":"兄弟当家子若林，情怀偏向酒边深。\n里中恶少多相侮，不设机关半点心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送查若庸下第东还","author":"郑文康","text":"读书不为科名读，若说科名误此生。\n请看草庐初读起，便知专不为科名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送查若庸下第东还","author":"郑文康","text":"浮名得失何须较，实学盈虚当自强。\n君有长才长十倍，好于十倍更增长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日偕龚工部过杨氏东郭草亭","author":"郑文康","text":"小小茅亭下，阴阴柳树多。\n町畦接城郭，花卉近阳和。\n阁老题诗在，游人载酒过。\n坐听灌园者，时唱太平歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过南溪翁庄","author":"郑文康","text":"嘉树绕崇垣，清流映筚门。\n治生余粟帛，供祭足鸡豚。\n诗酒闲情寓，衣冠古制存。\n时时逢野老，共话长儿孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"城南夜集","author":"郑文康","text":"明月照高秋，城南昨夜游。\n行厨依绿树，长席近河流。\n鸥梦芙蓉渚，渔灯杜若洲。\n荒闲尽堪乐，何必酒家楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白屋","author":"郑文康","text":"白屋无媒地，春来乱草深。\n席门风自动，圭窦日长阴。\n袖有匡时策，诗皆治世音。\n一朝登紫阁，慎莫变初心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏封君草堂","author":"郑文康","text":"埋骨荒山下，于今已廿年。\n两雏双白璧，三世一青毡。\n高行乡人诵，遗经弟子传。\n惟余手栽树，长对草堂前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"屯田","author":"郑文康","text":"海上无烽火，兵夫半入屯。\n田庐皆得业，鸡犬自成村。\n社饮翁归舍，春耕妇守门。\n不知戎马苦，同荷主君恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"敲棋所","author":"郑文康","text":"对客谈兵处，松风绕涧阿。\n一枰消日月，尺地起干戈。\n世路机心险，人情局面多。\n莫教轻下着，一错更无何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代妹宜君哭彭余璋","author":"郑文康","text":"配偶是前缘，从君未五年。\n两周虽有子，半世已无天。\n大义身徒在，深恩骨可镌。\n吾家旧诗礼，敢负柏舟篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送彭伴读复任","author":"郑文康","text":"藩府旧仙郎，居官鬓已苍。\n晨兴时伴读，朝退谩徜徉。\n残雪皆征路，寒山总异乡。\n平生遂良愿，长得事贤王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云山","author":"郑文康","text":"客路多岐阻，经春复到秋。\n云山千里目，风树一天愁。\n雁影将心远，江声带泪流。\n明年寒食饭，归去洒松楸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张知县之崇明","author":"郑文康","text":"怜君新作宰，邑在海东头。\n家近书频寄，官闲印早收。\n鱼盐盈市肆，芦苇绕汀洲。\n多少疮痍者，悬悬待尔瘳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"思乡","author":"郑文康","text":"高堂有华发，何为贪远游。\n每逢吴下客，频问海东头。\n宦达固云乐，余生何足谋。\n累累城下冢，见说尽王侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭邑宰郑尊生","author":"郑文康","text":"痛哭尊生老，双亲尚在堂。\n负心淹薄宦，遗恨付诸郎。\n彩戏乐难再，锦封恩异常。\n断魂招不返，先已到襄阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭邑宰郑尊生","author":"郑文康","text":"痛哭尊生老，荥阳共祖姬。\n谬看如拱璧，相爱若连枝。\n恺悌三年政，和平十卷诗。\n自怜多病者，和泪敛君尸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中 其一","author":"郑文康","text":"戊午京闱榜，题名得颇先。\n授官十载后，赐告七年前。\n箧贮陈情藁，囊存历俸钱。\n君恩深未报，病枕夜无眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中 其二","author":"郑文康","text":"先子多名誉，人称伟丈夫。\n病奄千日久，命向一朝殂。\n封殓烦邻友，扶持付老奴。\n此心遗恨在，双眼渐成枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中 其三","author":"郑文康","text":"群妹皆同母，诸甥日渐多。\n每从宾塾散，频向舅家过。\n聚立年相若，同行气总和。\n情怀好伤感，棠棣不成歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中 其四","author":"郑文康","text":"三子虽豚犬，相看抵万金。\n父书期尽读，母线要关心。\n靖节留诗久，徐卿种德深。\n二公歌咏在，一夜一长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中 其五","author":"郑文康","text":"宋驾南辕日，移家海上峰。\n华原非谬谱，显肃是同宗。\n世有儒书业，门无酒保佣。\n余生敢忘本，书姓必开封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中 其六","author":"郑文康","text":"从小称知己，当场总善文。\n八闽廉宪副，独石老监军。\n气味芝兰合，飞翔燕雀分。\n近来消息杳，惆怅赋停云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中 其七","author":"郑文康","text":"先祖留遗业，山中有敝庐。\n从教妻子累，肯负圣贤书。\n太守知贫薄，尚书问起居。\n若非守清节，谁暇枉轩车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中 其八","author":"郑文康","text":"七尺堂堂貌，蹉跎鬓欲秋。\n读书期事主，杖策望封侯。\n正大胸中学，凄凉眼下愁。\n老天如有意，未必此生休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中 其九","author":"郑文康","text":"病发风前叶，红颜雨后花。\n闭门思义士，看剑想仇家。\n久断宾筵酒，频供石鼎茶。\n草堂虽矮小，日日望京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中","author":"郑文康","text":"四十当强仕，年来顿早衰。\n发将须共白，手与足同痿。\n风雨烧灯早，晴明就枕迟。\n愁怀凭纸笔，写出尽成诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病剧再韵 其一","author":"郑文康","text":"百岁居人世，归休相后先。\n莫嗟将死际，请看未生前。\n蹠老固多寿，石郎空富钱。\n余生已如此，玄谷欲长眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病剧再韵 其二","author":"郑文康","text":"一癖成坚物，四年为旷夫。\n自矜春未晚，谁道岁将徂。\n头似坐禅衲，面如行丐奴。\n青天降时雨，还可润焦枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病剧再韵 其三","author":"郑文康","text":"敛含固塞束，濩尸良意多。\n遭丧惟俗信，讲礼有谁过。\n古制思收复，今人事议和。\n最怜相送丑，前路拥笙歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病剧再韵 其四","author":"郑文康","text":"邹鲁诗书语，精如百炼金。\n古来三宝意，亦说众生心。\n唐室沙门盛，中原地狱深。\n蔓延不可解，搔首独呻吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病剧再韵 其五","author":"郑文康","text":"最爱藏身处，崇丘背远峰。\n哀哀羊叔子，表表郭林宗。\n刻志钱宜备，穿山力可佣。\n行将营一室，期与万年封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病剧再韵 其六","author":"郑文康","text":"谬忝科名后，操觚学缀文。\n心思韩吏部，梦寐鲍参军。\n草藁随年积，门生每卷分。\n恐遗身后丑，一火上凌云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病剧再韵 其七","author":"郑文康","text":"里有狂巫宅，人争夜叩庐。\n语言凭祟说，符篆代神书。\n左道恬无畏，嘉名每自居。\n西门悬望久，何处候轩车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病剧再韵 其八","author":"郑文康","text":"花老不禁雨，草衰偏怕秋。\n绕山新土冢，满眼旧王侯。\n大数有时尽，细君终夜愁。\n回头笑相告，饮泣且须休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病剧再韵 其九","author":"郑文康","text":"四时都市酒，二月洛阳花。\n日日常为念，年年只在家。\n婢丸灯下药，僧送火前茶。\n到此方令悟，无心老岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病剧再韵","author":"郑文康","text":"百药都尝过，连年不救衰。\n艾经三日壮，身觉十分痿。\n拥被坐更永，听鸡嫌曙迟。\n自缘无睡苦，不是爱吟诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自笑","author":"郑文康","text":"自笑乖崖子，乖崖与众违。\n年荒饭不足，病久客来稀。\n检历伤人老，调羹喜菜肥。\n明年当五十，只恐未知非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清逸","author":"郑文康","text":"溷杂岂我事，奔趋非我能。\n身如临水鹤，心似出家僧。\n入竹雪堪听，采花蜂可憎。\n夜来读无逸，不厌浊油灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽徐老翁","author":"郑文康","text":"百岁实难致，近之能几人。\n平生方寸地，到老一腔春。\n文献当时族，衣冠太古民。\n从今后来者，何处望清尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郡庠生赴部","author":"郑文康","text":"泮水游歌日，于今已十年。\n蹉跎天府榜，迢递客乡船。\n岁月当强仕，文章得正传。\n高山须仰止，只在范庄前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和鬼仙诗五十韵","author":"郑文康","text":"忆昔初通贽，鸡盟订自天。\n姓名虽久识，邑里各相悬。\n倾盖衷肠合，分襟梦寐连。\n奇才骇神鬼，浮议谤迍邅。\n翠羽悲鹦鹉，红颜落杜鹃。\n瘦因粱肉减，忙为艺文缠。\n暑阁朝横膝，寒斋夜耸肩。\n扇摇倭国纸，被拥日南绵。\n宝玉深藏璞，骊珠暗在渊。\n未逢宣室召，甘向茂陵眠。\n经史心俱醉，王公眼尽怜。\n长庚重孕白，司马复生迁。\n踪迹多方到，风波几处全。\n反躬思寡悔，搔首动追愆。\n路口弹长铗，江心补漏船。\n自缘三岛谪，敢望九霄骞。\n雅操坚如石，生辰薄似砖。\n四时恒旸若，双眼独醒然。\n燕寝凝香处，清霜点鬓年。\n词章夸敏捷，篆籀擅穷研。\n梦绕江湖上，身依客旅边。\n韬光封镜匣，病缓佩弓弦。\n孤比悬崖竹，清同出水莲。\n放歌来树底，舒啸立山巅。\n命仆呼声煦，逢人礼貌虔。\n烟霞成痼疾，笔砚是良田。\n到处诗名播，谁家酒债牵。\n楼船妆雪洞，白马覆红毡。\n缨濯沧浪水，茶烹义井泉。\n土抔挥镪楮，木偶视豪权。\n哕哕丹山凤，行行陆地仙。\n蓬瀛三万里，锦绣几千篇。\n厌俗常居寺，谈空惯问禅。\n善书修殿记，不受卖文钱。\n误爱予多幸，相过意每专。\n时从鸡黍约，共话结交缘。\n畏饮杯浮毒，雄谈鼎沸煎。\n书筒疏未久，讣札报何遄。\n仙子形骸蜕，台郎道义坚。\n敛含依法制，冠履择新鲜。\n精爽还乡里，悲愁满市廛。\n贞妻浑欲死，令女半成颠。\n天泣霜华降，风号树影偏。\n仙班仍入籍，灵性了无眩。\n神逐鸾箱下，幡随鹤驾旋。\n药方真索隐，诗句愈钩玄。\n海鸟归华表，门生扫墓阡。\n沉沉寒食雨，澹澹夕阳烟。\n已说登佳境，无劳叹逝川。\n招魂今日赋，遗事后人传。\n正直聪明者，皇天不负贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉天殿早朝","author":"郑文康","text":"禁城漏尽九门开，喔喔鸡人报晓来。\n烛影遥连堂上乐，鞭声三衮殿前雷。\n群阴伏地天颜喜，万岁呼山御辇回。\n文武满朝忠与义，谩夸贾至有诗才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正统己未会试中副榜辞授教职特蒙俞允","author":"郑文康","text":"一官辞谢冒严威，圣主恩深特赐归。\n鹤发有缘重聚会，鹓班无分得留依。\n九重宫阙瞻天近，千里家山见雁稀。\n非厌广文毡冷澹，恐教尘满老莱衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠道者","author":"郑文康","text":"曾向仙坛赴远招，手持符箓下云霄。\n谁人叶县双飞舄，何处秦楼一段箫。\n垆鼎有丹传弟子，江湖无路觅松乔。\n从君愿借降魔剑，斩尽花间月下妖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观林松谷遗像","author":"郑文康","text":"晋人书法盛唐诗，曾向人家屡见之。\n故老怕谈参政事，诸生痛哭授经师。\n华亭城外松连谷，文笔峰前树掩祠。\n遗像宛然多岁月，仰瞻还动后人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遗民","author":"郑文康","text":"县城南去渺江津，烟水沧洲杜若春。\n百亩园田供祭享，几家鸡犬聚比邻。\n功名不入闲边梦，鸥鸟如知物外身。\n不是圣朝徭役简，岂容林下有遗民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甫里留别管金祝韩唐诸君子","author":"郑文康","text":"甫里繁华照市明，况多人物负才名。\n青春诗酒平时社，白昼弦歌到处声。\n唐士昔居元有宅，吴王此地旧无城。\n行随流水登归棹，一路居民识宋清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]