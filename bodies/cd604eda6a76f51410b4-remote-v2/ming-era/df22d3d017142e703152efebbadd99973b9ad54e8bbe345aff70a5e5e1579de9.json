[{"title":"从军行二首 其二","author":"吴世忠","text":"围合孤城势已危，少年胆气更输谁。\n一挥晕散天边月，知是渔阳豪侠儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5489,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送方二敬之北游","author":"吴世忠","text":"新制貂裘称体轻，试装宝剑已雄鸣。\n黄河至后无舟渡，独跨骅骝冰上行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5490,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得美人斗百草","author":"唐汝龙","text":"结伴荡春思，啼莺袅绿枝。\n分行拾瑶卉，列坐盛光仪。\n作态抽茎疾，含娇出叶迟。\n众中嬴一算，花下独扬眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5491,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠樊三","author":"唐汝龙","text":"杨家长矛法入神，传向关西尔独真。\n万朵梨花飞月晕，东吴敌手未逢人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5492,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟薄帷鉴明月","author":"孙良器","text":"晕泻深闺影，帷中怅独眠。\n隔帘钩并曲，入手镜俱圆。\n初疑含薄雾，翻似拂轻烟。\n离别经秋暮，盈亏自岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5493,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过姑苏有感","author":"孙良器","text":"东吴城外尽烽烟，百姓流移半在船。\n为问秋风旧来雁，稻粱今有几家田？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5494,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上","author":"范如圭","text":"江上西风雨复晴，菰蒲深处钓丝轻。\n何人隔岸吹长笛，杨柳秋江一夜生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5495,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠查叟","author":"吴锦","text":"曾逐钟生侍武皇，鹍弦扈从猎长杨。\n归来两鬓纷如雪，曲曲新声总断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5496,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上赠美人","author":"郑玄抚","text":"琵琶新曲转声迟，停棹中流日暮时。\n细雨可怜红袖湿，愁云偏惹翠眉垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5497,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋闺","author":"汪日梦","text":"秋风望塞，征夫何日归？\n新凉抛纨扇，沈忧减裙围。\n鸿雁西北来，哀哀乞寒衣。\n裁缝宵独坐，红烛对清辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5498,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山行","author":"汪日梦","text":"涧道散寒流，衡沙漫田亩。\n妖狐行野碓，风叶满舂臼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5499,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"天上谣","author":"詹斗文","text":"千尺仙台冰玉轩，云中鸡犬寂无喧。\n桂花浑白如人世，露湿霓裳冷不翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5500,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄张淑","author":"詹斗文","text":"艳舞娇歌张淑家，相思相隔海东涯。\n齐王城下寻常见，笑折杨枝雪白花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5501,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铜雀台","author":"邵正己","text":"寂寂铜台望，飘飘幔帐悬。\n君王遗令日，是妾断肠年。\n舞影伤罗绮，歌声咽管弦。\n西陵松柏冷，日夕锁寒烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5502,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"官词","author":"邵正己","text":"月转梧桐夜渐阑，长门寂寞觉秋寒。\n临风欲奏相思曲，抱得琵琶不忍弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5503,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送金景茂之凤阳","author":"李敏","text":"骢马紫丝缰，征人向凤阳。\n天形入淮泗，树势引濠梁。\n古亳元汤业，新丰本汉乡。\n皇陵瞻王气，盘郁一苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5504,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题流口吴逸人山居","author":"李敏","text":"岩泉鸣翠微，流口旧渔矶。\n市远修琴去，云深采药归。\n窗扉树鸡栅，篱落晒牛衣。\n世事无心理，长镵老蕨薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5505,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春晓","author":"李敏","text":"草阁临春浦，蓬扉惊曙鸦。\n水明残夜月，云傍隔溪花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5506,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岳墓","author":"陈有守","text":"过庙仍瞻墓，寒林气郁森。\n西湖莽埋没，中土日销沈。\n五国杜鹃梦，千城都护吟。\n未须追古愤，延伫重伤心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5507,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日过大云寺","author":"陈有守","text":"出郭蹑云岑，祇园淡午阴。\n林疏风叶下，坛窈雨花深。\n石室僧初定，金堂梵欲沉。\n寥寥方外趣，殊了去来心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5508,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"紫骝马四解 其一","author":"汪淮","text":"谁家白面郎，跨下紫骝马。\n䟤跋踏落花，骄嘶绿杨下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5509,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"紫骝马四解 其二","author":"汪淮","text":"黄金络马首，白玉作马鞭。\n盘旋不肯去，墙外看秋千。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5510,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"紫骝马四解 其三","author":"汪淮","text":"绣袜空中起，湘裙风外飞。\n倒垂倭堕髻，妒杀路傍儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5511,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"紫骝马四解 其四","author":"汪淮","text":"为问马上郎，墙高复几许？\n海青不上天，那得天鹅去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5512,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹西","author":"朱曰藩","text":"望望行宫地，遥遥大业年。\n山光连古寺，水调尚遗篇。\n软缆千花妓，迷楼五色烟。\n繁华何可吊，高树起秋蝉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5513,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠子长二首 其一","author":"朱曰藩","text":"泽国鱼龙气，征途冰雪文。\n悲歌过燕赵，一吊望诸君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5514,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠子长二首 其二","author":"朱曰藩","text":"万柳围团殿，飞花引御舟。\n棹歌双彩女，催过洗妆楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5515,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄程自邑","author":"朱曰藩","text":"一代空同子，人人愿执鞭。\n赠君诗满箧，恨我见无缘。\n绿水蓬池上，黄华艮岳颠。\n平生高李遇，徒感昔游篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5516,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄程自邑淮上","author":"朱曰藩","text":"梁苑沙墩路几千，客情冷落逼残年。\n兔园宾酒樊楼妓，一曲琵琶欲雪天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5517,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上送友人还吴门","author":"朱曰藩","text":"湖上桃花瞥眼娇，鸱夷舟稳卧吹箫。\n谁能载得西施去，却弄吴王送女潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5518,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孟夏二十七日行田杂歌三首 其一","author":"朱曰藩","text":"草阁南东霁海烟，万家耒耜雨余天。\n更怜村妇多新饷，潮落平沙蛤蚌鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5519,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孟夏二十七日行田杂歌三首 其二","author":"朱曰藩","text":"雨过青坪不见人，剪茸新鹿白如银。\n数声鼓笛丛祠近，知是祈年赛水神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5520,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孟夏二十七日行田杂歌三首 其三","author":"朱曰藩","text":"田田荷叶太湖西，千队鸳鸯掠水低。\n却似吴娘机上见，绿罗初?锦茸齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5521,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鸡笼山房雨霁","author":"朱曰藩","text":"客楼睡起西日曛，钟山曳曳拥归云。\n镜中岛屿后湖出，花外池台上苑分。\n何处攀龙光禄宴，当年怨鹤草堂文。\n残英尽及东林醉，莫遣流莺醒后闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5522,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"枕流桥避暑口号","author":"朱曰藩","text":"竹床花簟坐萧闲，好是侬家销夏湾。\n谁道屏风无九叠，彩云飞作洞庭山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5523,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"楼鸦","author":"朱曰藩","text":"年年银汉桥成后，楼上昏鸦接翅归。\n御史府中栖未稳，倡家树里听应稀。\n绿垂槐穗藏朝雨，红入莲衣浴晚晖。\n春去秋来浑底事，只输鸿雁塞门飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5524,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"桥上纳凉即事口号","author":"朱曰藩","text":"上林献赋恨空回，水驿冰鲜夜半催。\n枕上笙箫听渐近，杨梅卢橘过江来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5525,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中元日斋中作","author":"朱曰藩","text":"陶枕单衾障素屏，空斋独卧雨冥冥。\n辋川旧拟施为寺，内史新邀写得经。\n窗竹弄秋偏寂历，盂兰乞食信飘零。\n年来会得逃禅理，长日沈冥不愿醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5526,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对雨柬徐杨二先辈","author":"朱曰藩","text":"长安飞雨洒轻埃，万户千门画里开。\n雾树稍迷蓬阁观，烟丝犹袅建章台。\n故园红药谁同赏，旅榻青苔客不来。\n莫怪残春倍惆怅，一山风景各衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5527,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清明扬州道中忆王端公","author":"朱曰藩","text":"江花江草净春烟，北望空怀乘兴船。\n水国人家种杨柳，清明士女竞秋千。\n客厨未乞龙蛇火，旅食频催犬马年。\n遥想风流王柱史，西台银烛柘枝颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5528,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陆子还洞庭","author":"朱曰藩","text":"五月江门暑气鲜，水祠箫鼓赛龙船。\n最怜别权当官路，不碍归云入洞天。\n楼阁两山摇碧落，杨梅千涧泻红泉。\n葛裙纱帽吟长夏，莫拟平原赴洛篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5529,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮罢逍遥馆作","author":"朱曰藩","text":"沙溪雨过渐通潮，新涨朝来拍小桥。\n九曲湖堂藏窈窕，数株门柳伴逍遥。\n时鱼馔客烹芦笋，海鹤惊人起稻苗。\n饮罢中庭不成寐，夜阑河汉正寥寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5530,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七夕雨","author":"朱曰藩","text":"阁道中宵急雨鸣，遥怜牛女渡河情。\n吴台惊鹊飞来重，长信流萤洗后明。\n不谓金壶能续漏，祇缘玉箸剩沾缨。\n江湖亦有佳期隔，愁见兰涛混太清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5531,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄答王子新","author":"朱曰藩","text":"两家父子擅风流，江左相看三十秋。\n徐庾争吟玉台体，王谢久阔乌衣游。\n客夜红灯何处酒，病山黄叶隔年楼。\n西洲风恶船难系，空遣多情怨莫愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5532,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋闺怨","author":"朱曰藩","text":"合欢树上乌欲栖，空房织锦窦家妻。\n遥遥夜夜谁能奈，三三五五并相携。\n镜花对影惭双笑，烛泪分行伴独啼。\n莫道回文能妙绝，阳台云雨隔安西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5533,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"隋堤柳","author":"朱曰藩","text":"兴道里前杨柳新，萧娘攀望独伤神。\n怜侬正好留侬住，若个沄他遭个春。\n红颊忍抛妆罢泪，翠蛾常带睡余颦。\n龙舟风起花如雪，三月扬州梦里春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5534,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"家园种壶作","author":"朱曰藩","text":"春柳半含荑，春鸠屋上啼。\n弱苗何日引，长柄得谁携。\n瓠落非无用，鸱夷爱滑稽。\n挥锄不觉倦，新月在楼西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5535,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋发","author":"朱曰藩","text":"秋发不盈握，秋蓬仍苦飞。\n何须五日沐，自信九阳晞。\n病觉星星改，心从种种违。\n汉家方尚少，素领愧朝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5536,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"筝","author":"朱曰藩","text":"日者西园宴，云和独未收。\n弦张鹍转急，柱促雁相求。\n靡靡萦怀恶，纤纤绕指柔。\n多情如有待，庭树莫先秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5537,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"七月望夜亭上","author":"朱曰藩","text":"城外重湖已合围，双流分月泻青辉。\n积阴遂见秋风起，行潦休惊海水飞。\n袅袅银河低案户，涂涂玉露稍沾衣。\n季鹰元不营当世，岂为鲈鱼始忆归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5538,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日闲居作","author":"朱曰藩","text":"双树苍苍玉不如，牵风弄日庇闲居。\n床前竹冷新铺簟，架上梅过自曝书。\n散骑直庐谁偃息，平津客馆久丘虚。\n种瓜莫道东门近，肯为鸣驺暂倚锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5539,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玉河堤见新月","author":"朱曰藩","text":"垂杨东下转金沟，忽讶纤纤并马头。\n班殿未秋宁似扇，秦楼初晚正如钩。\n双蛾映水遥传恨，一掬当窗不揽愁。\n谩道南州歌蕙草，薄情元不为封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5540,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"临春曲","author":"朱曰藩","text":"阁上张星旧在天，阁中璧月夜仍圆。\n云欹宿鬒初临镜，风砑乾红未襞笺。\n两臂舞钗金阿那，一声歌树玉婵娟。\n君王万岁欢无极，肯信江花易夕烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5541,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠沐太华兼忆升庵杨公","author":"朱曰藩","text":"濯锦江边霞满天，博南山下草如烟。\n相逢偷把刀环视，肠断孤臣谪九年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5542,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"燕薁引","author":"朱曰藩","text":"上林苑西重阴垂，汉家马乳秋累累。\n群臣未拜金盘赐，正是文园病渴时。\n尝言逾淮橘为枳，淮南亦种燕薁子。\n一朝偶患齐后疟，七日方寤赵简乐。\n起来燔极华池干，菱藕堆盘懒咀嚼。\n何人旋摘此逼侧，冰丸入口生颜色。\n不用玄珠罔象求，翻疑舍利菩提得。\n淮南陇右限川梁，燕薁蒲萄味各长。\n底事千金通大宛，空劳斗酒博西凉。\n诏中但见夸珍味，席上谁能延乐方。\n乐方久甗樽罍燥，亲故仳离那可道。\n流年时物感《豳风》，拘方服食依农草。\n忆曾弱冠客安西，醉里亲尝掩露时。\n囊盛莫致敦煌种，浪说天南生荔枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5543,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感辛夷花曲","author":"朱曰藩","text":"昨日辛夷开，今朝辛夷落。\n辛夷花房高刺天，却共芙蓉乱红萼。\n小山桂树犹连卷，五湖荷花空绰约。\n连卷绰约宜秋日，端居独养征君疾。\n高枝朵朵艳木莲，密叶层层赛卢橘。\n山鬼已见驾香车，文人应是梦彩笔。\n辛夷辛夷何离奇，照水偏宜姑射姿。\n萧晨东海霞光烂，玄夜西园露气滋。\n檀心倒卷情无限，玉面低回力不支。\n见说东都便露坐，惟应御史沄风吹。\n此花爱逐东风暖，故人逸韵嵇中散。\n山阳闻有合欢斋，石湖亦筑辛夷馆。\n袅袅岩栊碧树圆，纷纷涧户香花满。\n坞里王孙旧路长，卷中裴迪新诗短。\n新诗已旧不堪闻，江南荒馆隔秋云。\n多情不改年年色，千古芳心持赠君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5544,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过陈思王墓","author":"朱曰藩","text":"美人曾感鱼山响，千古高情寄白杨。\n洛浦锦衾徒烂熳，邺宫铜爵久荒凉。\n诗成独赠同门友，势去潜悲异姓王。\n隧道风填飞藿满，争教来者不心伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5545,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寒食","author":"朱曰藩","text":"水满春湖花满城，况逢寒食雨初晴。\n花深不碍秋千出，水阔从教舴艋行。\n午憩旗亭分杏酪，夜归饧市有箫声。\n多情一树山梨白，小立柴门待月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5546,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"滇南七夕歌忆升庵杨公因寄 其一","author":"朱曰藩","text":"一宵争抵一年长，犹度金针到绣床。\n天下真成长会合，昆明池上两鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5547,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"滇南七夕歌忆升庵杨公因寄 其二","author":"朱曰藩","text":"彩袖飞来山上山，小楼金马堕云鬟。\n柰花满地无人扫，二十年前菩萨蛮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5548,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"滇南七夕歌忆升庵杨公因寄 其三","author":"朱曰藩","text":"锦窠何必夺丘迟，毕竟还他蜀锦奇。\n近日锦官空擅巧，博南山下乞蛮姬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5549,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"广心楼绝句为杨升庵赋 其一","author":"朱曰藩","text":"楼西鹦哥树，单栖铁鹦哥。\n儿童作蛮语，花鸟入滇歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5550,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"广心楼绝句为杨升庵赋 其二","author":"朱曰藩","text":"停云独倚阑，扣门问来使。\n云是张公子，永昌送诗至。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5551,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泾西杏花杂兴 其一","author":"朱曰藩","text":"张村赵村与吴村，千古空牵艳客魂。\n墙东一树秾如锦，莫怪先生独闭门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5552,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泾西杏花杂兴 其二","author":"朱曰藩","text":"成都才子玉堂仙，一谪南中三十年。\n锦树烘春枝袅月，夜来新梦到连然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5553,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泾上夕眺柬友人","author":"朱曰藩","text":"台下平池池上花，春风无日不山家。\n红藏坞壁攀危磴，绿浸阑干系短查。\n小市渐沽寒食酒，中林长隔美人车。\n夕曛也恋西枝好，不管城头已暮鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5554,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵何元朗罢官之作","author":"朱曰藩","text":"千古钟山拥晋京，门前淮水为谁清。\n即看江令还家日，不作平原羁宦情。\n异代风流草市宅，故园离乱柘林莺。\n东田见说堪行乐，莫怪经旬懒入城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5555,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泾上西斋书怀寄吴兴一庵唐丈","author":"朱曰藩","text":"连朝零雨掩柴关，树色苍苍别院间。\n倦倚小童呼鹿鹿，戏抛残果乞山山。\n淹留出岫云心懒，拓落当窗石性顽。\n惟是采真秋兴逸，白蘋长梦霅溪湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5556,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题和王子新","author":"朱曰藩","text":"葱菁玉树宫槐陌，婀娜纤腰杨柳枝。\n多病心情寒食后，小楼风雨落花时。\n阳台永夜难为梦，洛浦微波可寄词。\n何许鉴侬心独苦，朝来青镜有垂丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5557,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"云中乐","author":"朱曰藩","text":"塞门杨柳未经霜，锦帕貂裘马上妆。\n带得相思出关去，银钗岭上断人肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":5558,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]