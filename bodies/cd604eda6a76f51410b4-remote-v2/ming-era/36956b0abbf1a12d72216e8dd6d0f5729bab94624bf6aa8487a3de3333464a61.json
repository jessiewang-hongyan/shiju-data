[{"title":"久旱微雨复霁","author":"王世贞","text":"初热乍减阴霏霏，喜剧便?呼醉归。\n千峰忽展雨脚瘦，双耳暂停雷信稀。\n碧树五陵愁气色，红尘九陌故翻飞。\n疏帘小簟浑何恨，遮莫田家秋事微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈二刑部出守彰德","author":"王世贞","text":"自爱陈家好弟昆，季方才调更无伦。\n旧看冰檗能持法，新着金绯稳称身。\n邺水楼台横绕晋，太行关树远浮秦。\n登临会有搴帷思，河上风流见古人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋日子相考功投诗见怀且拟郊游之约有答","author":"王世贞","text":"斋居初坐日斜时，树色馀霜春较迟。\n岂谓持衡青鬓客，翛然更忆白云司。\n人间得句名甘晚，海内论文心自知。\n君问垂鞭芳草意，五原车马未堪追。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"休沐偶成自嘲 其一","author":"王世贞","text":"都门柳稀寒食烟，十日自枕春风眠。\n喜啄乌鹊故相恼，怯飞梨花翻剧颠。\n已多拮据长吏骂，未敢造次承郎筵。\n诗篇积渐有满卷，可否东家充酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"休沐偶成自嘲 其二","author":"王世贞","text":"问汝刺促何所图，马曹懒否能支吾。\n北枝南鸟意殊左，长铗短歌秋转孤。\n欲呼愚公未白发，拟作醉士无青蚨。\n汝道挂冠亦易尔，五见咸阳春草枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凌汝成工部自南来见过小酌喜赠","author":"王世贞","text":"三年禄食素心违，忽漫相逢思欲飞。\n盏酒且谋今日醉，盘餐聊当故乡归。\n天昏紫塞连戎马，日落黄河闪铁衣。\n世事不堪频向说，仙曹留省似君稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同于鳞子与夜过子相","author":"王世贞","text":"纷纷残月照欹冠，酒盏狂催殊未阑。\n银钥夜驰街色动，玉绳秋散羽声寒。\n乾坤句就轻为别，湖海谈深欲废官。\n调笑吾从方朔后，陆沈人岂岁星看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立秋夕与谢山人孙徐李吴四比部登宣武城楼共得秋字","author":"王世贞","text":"客有相过选胜游，西山爽气满城头。\n尊前白破双鸿瞑，笛里黄催一叶秋。\n万户清砧新夜色，六宫团扇故年愁。\n登高幸不逢摇落，逃暑仍惊暑乍收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠按察张使君铎","author":"王世贞","text":"南师幕府奏龙韬，飞传遥惊渡不毛。\n日净五溪回组练，月明三辅泣弓刀。\n军前结客黄金尽，城上看烽太白高。\n君去封留帷幄里，凤池应许重挥毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弘慈寺薄暮登藏经阁","author":"王世贞","text":"雨霁祗林步屧新，上方台殿郁嶙峋。\n诸天入暝原无相，双树凌空不受尘。\n清磬忽传迷后旨，慧灯谁引幻中身。\n微官宿障如堪脱，长以斋心礼化人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分赋得六宫秋月怨拈韵得纨字","author":"王世贞","text":"金井梧桐露未乾，卧看斜月在云端。\n空悬秦帝江心镜，祇并班姬掌上纨。\n笙鹤自穿花底度，璧蟾孤映泪痕残。\n由来天阙霓裳冷，不信人间有合欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汝成工部还留都","author":"王世贞","text":"曳履方陪阊阖班，劳歌更拟及秋还。\n乾坤岁计安危里，伯仲天涯去住间。\n明月雁声连蓟苑，寒云旌色满钟山。\n停舟借问鸣珂宅，樽酒黄花未破颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初抵京承子与携汪魏二君夜过分韵得江字","author":"王世贞","text":"此夕逢君倒玉缸，千门月色迥临窗。\n隔年杯酒心犹壮，近眼篇章意未降。\n北去鼓鼙填瀚海，南来旌甲满沧江。\n欲论后会谁能数，愁杀寒钟更几撞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送史佥事兵备邠泾","author":"王世贞","text":"汝过崆峒剑色开，轻裘千骑拥登台。\n旄头夜向黄河出，汗血秋从西极来。\n置阵自传司马法，折冲真有卧龙才。\n只今燕代论攻守，沙海风生画角哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄梁公实时病告南海","author":"王世贞","text":"汝病矫矫不可驯，予游圉圉常依人。\n罗浮不尽古今色，大庾长先天地春。\n落日万里各异态，明月三秋时一轮。\n已闻凤歌失自料，况乃鸿断转伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"回龙观","author":"王世贞","text":"玄都飞阁倚崇墉，天子当年驻六龙。\n岸柳春娇宫女学，岩松秋忆大夫封。\n烟花万户垂宸极，云物诸陵拱帝峰。\n处处离宫俱望幸，不堪衰草入边容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蔡子木守衡州","author":"王世贞","text":"少年为郡肃清修，京洛相携赋壮游。\n一去蔡邕谁倒屣，可堪王粲独登楼。\n插天衡岳层层碧，绕郭湘江细细流。\n莫向秋风悲日远，长沙今得比中州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜吴山人过访村居","author":"王世贞","text":"出塞吹笳马上听，蓟原春草又凋零。\n相逢门巷淹今雨，垂老江湖混岁星。\n醉后放歌双眼白，愁时拂袖万山青。\n何当谢却人间累，五两追携下洞庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄吴舍人明卿","author":"王世贞","text":"忆尔含香供奉班，书题腊日到江关。\n沨沨诗句云霄里，落落吾侪天地间。\n别思孤琴临大泽，生涯双屐满青山。\n汉宫秋湛仙人掌，沆瀣文园好自攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送饶兵宪迁湖广参政","author":"王世贞","text":"牙旗金鼓殷如雷，行省旋移楚甸开。\n大海秋涛公檄静，湘江春雪锦帆来。\n褰帷地尽归鸿色，摇笔人惊咏鹉才。\n临发佩刀还解赠，知君名已动三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄子与","author":"王世贞","text":"至后今年雪未匀，江南梅柳剧含春。\n自缘衣食犹关世，仅有篇章肯向人。\n沧海渔竿容独把，白云华省更谁亲。\n闻君日逐荆卿饮，击筑长歌渐隐沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜陆秀才之裘吴山人扩见访分韵得看字","author":"王世贞","text":"娟娟孤月起林端，剥啄何人稚子欢。\n幸有文章公辈在，向来车马世途看。\n云容白破千家晓，海气青回万井寒。\n醉里疏狂吾故态，莫将杯酒问衣冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"履善比部归自岭右赋此问之","author":"王世贞","text":"闻君八月下牂牁，铜柱天荒使者过。\n桂岭风来秋色早，盘江水合瘴烟多。\n夷童夹道誇椰酒，蛮女穿花出棹歌。\n向识子云奇字擅，近来词赋更如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送詹簿家兄之南京","author":"王世贞","text":"十载公车疏上迟，始分鸾掖置留司。\n钟山月向鸿边出，瓜步帆从树杪移。\n过省春云停纵酒，开帘秋色映弹棋。\n殷勤好就吴都赋，江表如今问左思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周宪副之云南","author":"王世贞","text":"主恩君已三持节，益部声名异日传。\n汉署共瞻骢马使，夷荒今上白狼篇。\n严旌昼指昆明日，宪府秋开越巂天。\n好见折冲尊俎上，近来南北并风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄皇甫子循别驾","author":"王世贞","text":"十载寒星汉署孤，一麾秋兴满江湖。\n阶前结草成书带，阁里看山是画图。\n未论折腰羞从事，曾因倒屣识潜夫。\n殷勤去雁如相访，已逐高阳旧酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答黄山人","author":"王世贞","text":"少日曾闻叔度贤，过逢穷巷更萧然。\n挥毫秀自云霞发，裋褐名从海岳悬。\n此道直论千载后，微才肯任众人前。\n酣歌意气频开眼，冠盖长安太可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"癸丑元日有感","author":"王世贞","text":"蓟苑闻钟谒帝关，火城遥散五云间。\n鱼龙自集甘泉馆，鹓鹄仍虚紫殿班。\n万里瞻依空使节，十年朝请隔天颜。\n只今醉逐田翁社，问尔曾携醽酒还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄侍郎朱公二律 其一","author":"王世贞","text":"楚天南望鹿门开，急榜眠鸥总未猜。\n大泽春云怀璞卧，高江寒月弄珠回。\n风尘厚禄多惭色，泉石清时有异才。\n岂为王生曾结袜，汉庭争问释之来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄侍郎朱公二律 其二","author":"王世贞","text":"蓟门车马竞斜晖，投劾何人早息机。\n十载春阴留棘寺，九秋兵色避荷衣。\n别来天地论心阔，自昔云霄握手稀。\n凭向武陵贻玉案，芳波或恐涨渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游虞山拂水岩 其一","author":"王世贞","text":"厉屐凭车思转豪，侧身吟望鬓重搔。\n风岩昼激诸天雨，阴壑寒生万树涛。\n行逐渔樵驯野计，卧看江海入秋毫。\n维摩近有招提在，苏晋如今醉欲逃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游虞山拂水岩 其二","author":"王世贞","text":"郁盘苍翠有千株，绝顶肩舆兴自扶。\n天辟陡崖如拥剑，风回飞瀑尽含珠。\n山僧偈向巢间发，湖妓妆从镜里铺。\n逢胜便思云卧稳，未须投暝问樵夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张通政宇清周比部济叔沈进士子善饯予昆山有作","author":"王世贞","text":"共携尊酒上崔嵬，娄水秋潆匹练回。\n万井夕阳看自敛，九峰云色坐频来。\n披襟啸逐天风落，倚盏狂惊河汉摧。\n握手将归何所赠，诸君应有大夫才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登金山 其一","author":"王世贞","text":"山秋木叶翠将收，憩棹扶携到上头。\n天柱中悬南北影，海门西拒古今流。\n层云锡响空王坐，落月珠明帝女游。\n便欲休餐旬日住，千帆风色使人愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登金山 其二","author":"王世贞","text":"青螺潋滟水晶盘，斗削风烟面面看。\n地涌楼台千蜃结，天回波浪六鳌蟠。\n山形自挟秋云壮，海色遥将曙日寒。\n恍忽龙宫吟啸起，何人玉笛倚栏干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"师道太史兼直外制赋此寄之","author":"王世贞","text":"十载扬雄赋已奇，始来西掖拜恩时。\n铜扉夜色宣麻早，阁道春阴视草迟。\n赐沐不言温室树，裁篇空忆上林枝。\n山东父老须臾在，汉诏还应下赤墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄云鹄抑之二给事","author":"王世贞","text":"蓟苑朝回朔思催，故人相见且衔杯。\n持螯一醉星杓转，并马千门雪色来。\n赐对实前明主席，为郎虚有大夫才。\n谁怜淮水兼天涌，望断黄金旧筑台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠杨仲芳武选","author":"王世贞","text":"当时尔拜尚书郎，天子宵衣问朔方。\n一疏中兴回日月，百年恩谴薄风霜。\n宛城昼闭名王马，汉壁晨驰大将床。\n突兀黄金秋色里，复看前箸借明光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"维扬遇吴明卿舍人汎舟夜酌","author":"王世贞","text":"簪笔晨辞出帝都，相逢白雪满长途。\n当年别思堪今古，此夕狂歌更有无。\n隋苑鹊声翻禁柳，邗沟月色破平芜。\n酒阑忽忆山中客，击筑歔欷调转孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中同思伯明卿登芜城阁","author":"王世贞","text":"堤上高楼逼绛河，芜城秋色拥嵯峨。\n天低雉堞窗中起，雨挟帆樯镜里过。\n别后踟蹰佳会少，狂来跌宕众人多。\n不堪西北凭阑望，欲指浮云一啸歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题子相芙蕖馆 其一","author":"王世贞","text":"汝筑玄亭倚钓矶，矶边菡萏剧芬馡。\n窥帘个个红妆出，惊榜双双翠羽飞。\n明月波翻吴女曲，西风凉入楚臣衣。\n石湖花发应无限，迟晚兵戈画鹢稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题子相芙蕖馆 其二","author":"王世贞","text":"倚郭澄波香气浮，芙蕖花满大堤头。\n云间岳坠仙人掌，海外风来太乙舟。\n近槛碧筒堪自醉，谁家白苧起中流。\n接䍦予亦能颠倒，天末蘋霜动远愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和郡丞任侯海上之作","author":"王世贞","text":"天拥鲸鲵贾怒奔，地当牛女正妖氛。\n千村燐发遥疑烧，叠岛烽来上属云。\n鼓角长横吴郡邑，楼船益置汉将军。\n知公羽扇能挥敌，樽俎何人并策勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赠任侯","author":"王世贞","text":"天外帆樯截海来，只今谁是伏波才。\n帷中借箸星频转，鹢首鸣弓月乍开。\n战后修期裁露布，名成褒德上云台。\n蒿莱尽起褰帷色，词客何须赋七哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日风阻郑家口","author":"王世贞","text":"野戍秋高鼓角哀，萧萧木叶走黄埃。\n横驱浊浪蛟龙斗，复掩深林虎豹来。\n短发霜风欺落帽，异乡天地畏登台。\n祗应诸季茱萸酒，妒杀黄花傍汝开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"逢刘卫辉谈守事甚苦遂作","author":"王世贞","text":"斗酒相逢大道傍，故人黄绶羡为郎。\n褰帷夜踏朝歌月，负弩晨驱牧野霜。\n逢迎罄折颜常赤，案牍支离鬓易苍。\n予滞汉廷无所效，敢同长孺薄淮扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠尹生 其一","author":"王世贞","text":"当年结客度居延，一骑曾惊敌陈穿。\n匕首长寒燕市雨，旄头不断蓟门烟。\n青春射策当三殿，黄石传书定几篇。\n自是嫖姚新领部，单于秋祭莫临边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠尹生 其二","author":"王世贞","text":"入朝初着鵔鸃冠，白马雕弧夹道看。\n久见中原倾剧孟，兼闻少府识任安。\n枝头杨叶飞星过，匣里莲花映日寒。\n閒逐孤儿春草猎，独身西去斩楼兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒夜同顺甫过子与适于鳞书到","author":"王世贞","text":"斗酒相过蓟苑东，高台雪后问来鸿。\n苍茫客思看人尽，辽落书题握手同。\n不独声名多抱恨，即论刀笔几称雄。\n春几易水登车日，谁为悲歌起大风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴韬之浙阃","author":"王世贞","text":"向来军事早知名，淮海云帆指帝京。\n燕卒尽饶都护饷，越人争下伏波营。\n晨趋幕府衣冠集，秋拥牙旌组练明。\n况是征南能跨札，几人儒将有干城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈郎中汝忠督学山西","author":"王世贞","text":"当时谏草动长安，回首风尘行路难。\n郎署祇怜青琐隔，使车还拥绛帷看。\n河汾雪净诸生候，并代风回万马寒。\n知尔论文多暇日，欲飞长檄下呼韩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日病中书怀","author":"王世贞","text":"散帙高秋病骨清，科头聊复罢将迎。\n眠过半壁丝丝影，坐数空林叶叶声。\n末路行藏难任性，中年哀乐易关情。\n东邻判负黄花约，酒债朝来颇渐轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄袁荆州丈兼问周水部","author":"王世贞","text":"汝逐何逊沱江边，百花芳洲生紫烟。\n春风露冕失千载，郢雪高歌横一天。\n平生酒徒众所厌，散入海宇名俱传。\n倘问为郎杨执戟，又随车马竞新年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答茂秦","author":"王世贞","text":"黄河春草白茫茫，驿使封题粲几行。\n争问剧辛来自赵，颇传枚乘老游梁。\n淮南客赋云为树，汉署鸿归月似霜。\n莫笑故人甘宦拙，岂容卿秩卧长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送从子汝钦仪部赍玺书旌鲁王","author":"王世贞","text":"汶水风来锦席张，春涛雪后淼茫茫。\n梁园客蹑三千履，汉诏侯赍十九章。\n坐有谈天来碣石，游题飞霓赋灵光。\n独怜痴叔羁栖晚，周易床头业已荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访茂秦有感茂秦时与李顺德有隙索书不得","author":"王世贞","text":"上客梁园赋转工，相逢忽忆帝城东。\n停杯句就乾坤别，回首人怜道路同。\n每饭岂能忘钜鹿，尺书虚已问冥鸿。\n亦知彼地张陈迹，怅望千秋洒泪中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄郎中守抚郡","author":"王世贞","text":"仍辞汉闼剖符年，露冕停辉散楚天。\n推案涛声灵谷雨，捲帘秋色五峰烟。\n人称内史惟康乐，汝去徵书定颍川。\n一自西曹违玉树，谁能不诵暮云篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘子成兵备贵州 其一","author":"王世贞","text":"忆昨爽鸠初徙署，共誇才气世无双。\n曾令万马回长啸，更筑三城拟受降。\n明月独悬黔岭节，白云高拥洞庭艭。\n谁为同舍题诗侣，愁对飞花倒玉缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘子成兵备贵州 其二","author":"王世贞","text":"看君燕颔必腾鶱，百越诸夷总汉天。\n此去兵符铜虎授，向来文字鳄鱼传。\n山连贵竹星常少，地入盘江雨自偏。\n闻道悬军犹楚甸，两阶今是舞干年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同诸君饯子成怅然有感盖予以前岁是月使归","author":"王世贞","text":"杯酒当年倚玉鞍，故人歌饯各萑兰。\n吴洲暮郁青萍色，郢里春停白雪寒。\n海内旌旗愁不断，道傍车马态相看。\n何当符传翻驱汝，纵有雄心此际难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王尚宝册封徽藩","author":"王世贞","text":"华省声名接上台，几论天笑近臣开。\n三王赐策曾亲定，九殿颁符自捧来。\n人似淮南多道术，地邻梁苑集英才。\n知君旧擅灵光赋，席右无烦授简催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送子与祀康陵","author":"王世贞","text":"佳城葱郁锁楸梧，武帝神游定有无。\n金榜星辰千岭逼，翠旗风雨万灵趋。\n俱传骏足留瑶海，亦有龙髯堕鼎湖。\n此日词臣空洒泪，献陵春望已模糊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":10732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]