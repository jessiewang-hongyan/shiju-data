[{"title":"东园八景 其七 棋枰","author":"王佐（汝学","text":"尝怀橘中叟，无忘六斛尘。\n输赢同一梦，当局是何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东园八景 其八 竹屏","author":"王佐（汝学","text":"薄采潇湘骨，寒天障物华。\n世珍云母石，我爱款冬花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桐乡八小景大蘋洲","author":"王佐（汝学","text":"光风泛州渚，草暖花乱开。\n归田无别业，此是种花台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小蘋洲","author":"王佐（汝学","text":"小小一芳洲，白蘋花自炫。\n知心采蘋者，安得常相见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东皋古木","author":"王佐（汝学","text":"老树三百年，郁郁含风雨。\n巨蠹穴其心，对此伤南渡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西渚寒滩","author":"王佐（汝学","text":"寒泉下触石，淙淙䀨昏晓。\n野田分上流，昨夜水声小。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南涧云泉","author":"王佐（汝学","text":"野涧近芳洲，寒泉绕石流。\n时看云出石，相对隐人幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北林烟树","author":"王佐（汝学","text":"北林无别景，早晚笼烟树。\n时闻山鸟声，亦足幽人趣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"聚景园","author":"王佐（汝学","text":"鹏鴳适所适，自觉世界宽。\n花柳满乾坤，只在眉睫间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幽景塘","author":"王佐（汝学","text":"山回泉脉细，地衍水痕平。\n好景不须多，会意心自清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王汝弼归宁夏","author":"王佐（汝学","text":"灵州西望是阳关，休唱阳关惨玉颜。\n珍重赠君无别物，袖中惟有贺兰山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观太极图","author":"王佐（汝学","text":"一轮明月浩无边，落影千川处处圆。\n在地有川皆有月，月轮元自不离天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈仪宾来鹤亭","author":"王佐（汝学","text":"三山凝望绿云遥，羽客乘轩不用招。\n还有秦楼鸾凤侣，殷勤明月夜吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李太白醉图","author":"王佐（汝学","text":"天子呼来醉似泥，王孙宠遇世应希。\n可怜只献清平调，不说当年国步非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春兴","author":"王佐（汝学","text":"花满闽天足绮罗，可人情兴是春和。\n日长公馆清如水，坐倚胡床听鸟歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"双鹊图","author":"王佐（汝学","text":"世逢贞观景熙熙，温树春风借一枝。\n纵使君王却祥瑞，物情终景恋明时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵归兴","author":"王佐（汝学","text":"我欲归耕海上村，便寻归路问吴门。\n兔园册子今应在，期与邻翁话日曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"歌风台","author":"王佐（汝学","text":"大风声激涕沾襟，勇似韩彭可再寻。\n帝子既为家国计，猛夫亦有子孙心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杜鹃花","author":"王佐（汝学","text":"春山琪树绿交加，蜀帝残魂怨月斜。\n啼血满枝无着处，春风吹作艳阳花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"姜文博冻鹊图","author":"王佐（汝学","text":"傅说版筑舜畎亩，纥千山头乃生处。\n画工故作双鹊图，雪满江天立枯树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄表侄唐濂伯必周","author":"王佐（汝学","text":"别后令人鄙吝萌，每临风月即伤情。\n枕戈待旦君知否，不为功名为祖生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"唐必周解元墓","author":"王佐（汝学","text":"洗马桥东水泊津，野田荒陌草如茵。\n他时若问田边墓，五岭南来第一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭倪氏姐","author":"王佐（汝学","text":"手思尚右一心悬，鬓已成灰百念捐。\n岂为侬琼兄弟少，此情虽过是天然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南昌刘氏愚溪","author":"王佐（汝学","text":"鸥外消沉智巧机，水光云影澹相宜。\n闲来曾过愚公谷，莫有渔樵问答诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杜甫游春图","author":"王佐（汝学","text":"曲江官殿昼沉沉，细柳新蒲伤客心。\n天宝拾遗情思苦，蹇驴驼醉不胜吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安庆黄氏松隐","author":"王佐（汝学","text":"高人无处隐逃真，来傍长松涧底眠。\n几度清风松际起，自将吟响节钧天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄谢信丰尹何宗实","author":"王佐（汝学","text":"鬼啸雨兮猩啼烟，行客孤羁心自怜。\n乡曲故人相慰籍，得留双眼看青天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"远归","author":"王佐（汝学","text":"行李摇摇日向斜，前山烟雨是吾家。\n马头一点归来喜，开到寒灯几夜花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归舟四咏 其一","author":"王佐（汝学","text":"十室今无四五家，遗民犹自种桑麻。\n南侬不管人肥瘠，子夜吴歌到月斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归舟四咏 其二","author":"王佐（汝学","text":"万顷晴波浸月明，江天风露寂无声。\n今宵计到邳州泊，又是孤舟一驿程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归舟四咏 其三","author":"王佐（汝学","text":"花月当年燕子楼，花飞月落几春秋。\n佳人何处埋黄土，留得荒坟管客愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归舟四咏 其四","author":"王佐（汝学","text":"当年望气识真龙，举玦何频向沛公