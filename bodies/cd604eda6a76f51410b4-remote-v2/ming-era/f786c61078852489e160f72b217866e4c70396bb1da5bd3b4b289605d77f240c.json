932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题萧师孔乐庵","author":"湛若水","text":"师孔号乐庵，此庵有何乐。\n若了寻常心，心庵半忘却。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题曲庄","author":"湛若水","text":"玉流本自直，屈曲随城陴。\n如玉人何在，年年流玉澌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题山西王内泉号","author":"湛若水","text":"内泉是我泉，外尘飞不到。\n飞尘一点无，心泉本浩浩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题乐平方子月窗三首 其一","author":"湛若水","text":"窗中不见月，月到窗生白。\n感应有无几，试问窗中客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题乐平方子月窗三首 其二","author":"湛若水","text":"试问窗中客，此作何转语。\n光霁只在人，人人有灵府。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题乐平方子月窗三首 其三","author":"湛若水","text":"人人有灵府，过化尔风霆。\n何处更仰泉，万物自流形。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书赠户曹曾罗江","author":"湛若水","text":"罗江水滔滔，君才极雄逞。\n愿请终军缨，去系单于颈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜外孙吴仲科戒酒","author":"湛若水","text":"尔贤云戒酒，戒酒惟尔贤。\n大禹恶其旨，其兴也勃焉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病剧言","author":"湛若水","text":"挥手谢小儿，吾欲观大化。\n当尽便须尽，何用复悲诧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题天关别画赠陈补之衮","author":"湛若水","text":"分手临对影，形似犹狐疑。\n抚影重怀人，能生别后思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吕奉朝舍人来省北归干前程","author":"湛若水","text":"南风苏病骨，出送奉朝行。\n世德前程在，吹墟上帝京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题陈郎主清别号","author":"湛若水","text":"主清一以清，为洗世间浊。\n君家石䃱流，千丈从天落。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题吴郎克容东白号","author":"湛若水","text":"东方之既白，睡仙方展眉。\n夕惕无遑逸，不息纵天机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题恒彰侄新居堂壁","author":"湛若水","text":"恒彰新润屋，门对我瀛洲。\n孙茁兰芽华，应知代代侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"翼励侄节夫茂夫秀夫洁夫兄弟同居共爨诗以引之","author":"湛若水","text":"节夫兄弟好，曾题孝友门。\n阖门三十口，共爨到儿孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重送何生良夫还桂阳","author":"湛若水","text":"千里出求仁，足迹弥三广。\n归来无一事，宝在灵台上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答桂阳朱则之欧启河得白石壁澄潭作仰泉楼喜而赋之二首 其一","author":"湛若水","text":"白石映心白，临潭千仞高。\n崖头撒手去，著步得无牢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答桂阳朱则之欧启河得白石壁澄潭作仰泉楼喜而赋之二首 其二","author":"湛若水","text":"心似澄潭水，潭底日涓涓。\n即此观生得，何须更仰泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"致仕归舟过燕子矶留题刻石","author":"湛若水","text":"初飞锡杖出人间，前度游人今度閒。\n中夏劝农曾过此，新秋窈窕题诗还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叠韵酬洗奕倩","author":"湛若水","text":"长啸声闻塞两间，纷纷万有到来閒。\n淹留廿载成何事，空载大江明月还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再叠韵","author":"湛若水","text":"江阁临江指顾间，江涛卷天江阁閒。\n更有破舟淩万里，也能到岸得生还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿借眠庵题壁四首 其一","author":"湛若水","text":"我与名山有夙缘，今宵何宵此借眠。\n中天月欲近人语，莫是天上谪来仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿借眠庵题壁四首 其二","author":"湛若水","text":"延缘延缘且延缘，百尺空中抱月眠。\n一榻未曾分尔我，人间天上只凡仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿借眠庵题壁四首 其三","author":"湛若水","text":"自知凡骨非仙缘，玉佩珊珊聒我眠。\n三更月底排云出，尽是蓬莱妙众仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿借眠庵题壁四首 其四","author":"湛若水","text":"一笑人间已了缘，白头随处曲肱眠。\n道流火候无消息，忘助閒时不是仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题张公洞","author":"湛若水","text":"千奇万怪不可睹，混沌死矣谁凿之。\n若使公能回造化，不将混合此何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题甘泉精舍","author":"湛若水","text":"山下涓涓石下泉，惟应与尔洗心言。\n先生已在忘言处，一任滔滔赴大川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"据延祐残碑复名甘泉洞亭曰甘泉亭诗","author":"湛若水","text":"残断摩挲延祐碑，甘泉石下岂人为。\n祇应题复甘泉洞，笑共山灵一语之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"巡鹾高侍御崶走三十里顾予浙江驿相信殷勤诗以酬之","author":"湛若水","text":"骢马追寻浙水滨，百年怀抱见谁真。\n探囊欲报长生药，只恐囊中药未神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶书与武夷宫连道士庆泽","author":"湛若水","text":"擢歌歌罢夜燃灯，烧竹煎茶待我清。\n久欲黄冠归一曲，借眠今日得无情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再访南岩僧家二首 其一","author":"湛若水","text":"岩里僧禅二十家，岩前春夏万株花。\n岩花落尽僧无□，不道鸦归日又斜。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再访南岩僧家二首 其二","author":"湛若水","text":"禅定诸僧终未了，更须长钟作生涯。\n若教心了亦自足，肯羡钟鸣鼎食家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登储潭庙临潭水观大树二首 其一","author":"湛若水","text":"十八滩穷十八叹，危途历尽此登临。\n天地笑歌乃何意，储潭潭水不如深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登储潭庙临潭水观大树二首 其二","author":"湛若水","text":"习礼当时曾伐木，蔽亏日月失阴晴。\n不知曾有神仙过，试问祠前老树精。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"道过南康乡人陈衮世寓于此持大字乞言捉笔答之","author":"湛若水","text":"人情博爱殊乡人，烱烱双眸大笔神。\n收拾精神还性学，老怀能不为君欣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南康门人郭瑞旧为崇安令有治声以不得于巡按一旦弃去予与奕倩访武夷意其为山主至则行矣及过此因其求言诗以见情","author":"湛若水","text":"武夷东道是何人，山得贤侯山愈神。\n强项折腰人不见，山中荣木自欣欣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观庾岭白猿洞","author":"湛若水","text":"振衣千仞出梅扃，万仞铁桥归濯缨。\n异类莫言无感应，白猿出洞也来迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠方时素杨君极王子敦还乡","author":"湛若水","text":"沧溟水月照君清，相逐鹏程万里行。\n要识秋风无限意，不留分榻坐朱明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卜黄龙不遂上卜天华","author":"湛若水","text":"当年我卜黄龙坡，山木未深云未多。\n直向天华蹑天路，飞云影里放天歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卜黄龙旧作","author":"湛若水","text":"飞云千丈阁空濛，一枕横交四百峰。\n春景醉人归不得，欲离烟火住黄龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠伍春山别驾之岳州二首 其一","author":"湛若水","text":"山锁千寻云万寻，铁江深与铁桥深。\n钧丝袅袅收良夜，又动离歌送客吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠伍春山别驾之岳州二首 其二","author":"湛若水","text":"戚里相从四十秋，心期南岳许同游。\n清风把赠看明月，一路随君到岳州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱明夜坐久雨喜见月色","author":"湛若水","text":"山月圆明照八方，祇应云雨蔽清光。\n拥衾独倚朱明坐，中夜蟾光已到床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"度黄龙登天华视四贤祠行窝之筑二首 其一","author":"湛若水","text":"双眺银河落九天，合流隔断彩云边。\n天华别在黄龙上，两栋茆椽一缕烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"度黄龙登天华视四贤祠行窝之筑二首 其二","author":"湛若水","text":"宿雾初牧好景开，觉山临夜有碑来。\n四贤后地无分别，司马行窝御史台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将游南岳至东家铺念计程途作","author":"湛若水","text":"北风浩浩捲征衣，南岳苍苍入翠微。\n去去五峰弄明月，寥寥鞭凤祝融西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游罗浮肩舆上望黄龙洞寄怀庞弼唐二首 其一","author":"湛若水","text":"天华白屋黄龙里，隐隐飞云两栋悬。\n居士旧曾开板筑，幽期须共了前缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游罗浮肩舆上望黄龙洞寄怀庞弼唐二首 其二","author":"湛若水","text":"云起含阳也共门，乾坤一体本浑浑。\n合将一点程门意，四百峰头月下论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入黄龙洞口迟王石屏黄门戴角峰侍御口占","author":"湛若水","text":"劄劄肩舆相后先，闻君尚在一把莲。\n行行十步九回首，及早相将到洞天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天关小酌姚泽山侍御","author":"湛若水","text":"天关今日为谁开，白日青天豸史来。\n鸟为放歌花为舞，为公初举乐民杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜廖子峻堂教崔来修司训至清霞洞","author":"湛若水","text":"有人款款扣柴关，两马冲云夜到山。\n秉烛呼童办茶果，泠泠清话到更残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登青霞冼子潘子读书台有感","author":"湛若水","text":"青霞洞里读书台，台外风光为尔开。\n山月于今几圆缺，两贤何事未归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观青霞讲座石有感","author":"湛若水","text":"觉山一去浙东游，讲座寥寥对晚愁。\n山石不知时节改，台前溪水自东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]