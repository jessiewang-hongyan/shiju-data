[{"title":"浮亭夜集寄华故人","author":"林鸿","text":"南亭高馆薜萝深，此夜思君万里心。\n乡国旧游多怨别，云山何处独登临。\n寒芜落雁天低树，野戍平沙烧隔林。\n尊酒相逢还寄意，也应知我一沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜会林南宫闻李生弹筝","author":"林鸿","text":"浮亭簪盍醉吟逢，高调鸣筝此夜同。\n月隐青丝闻乱叶，霜空瑶柱度飞鸿。\n湘灵锦瑟愁停鼓，子晋鸾笙愧未工。\n况有周郎歌白雪，兴来那放酒樽空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮亭夜集","author":"林鸿","text":"纵酒閒亭歌复悲，那堪春草思离离。\n朱门按剑谁先达，沧海论心愧后期。\n郭里莺声惊雨歇，津边柳色向坡垂。\n题诗寄远无持赠，偏忆追陪到习池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮亭夜集赠黄二","author":"林鸿","text":"江淮千里久思君，高馆相逢兴不群。\n孤烛青灯人共醉，澹河疏雨夜初分。\n心怀慷慨空悲梗，世事飘飖秖似云。\n良会未穷簪盍意，莫因归兴又纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送仲彬胡公之荆南","author":"林鸿","text":"华馆清谈酒未醺，春风送客又离群。\n高堂念别情先切，把袂同心迹暂分。\n征旆还辞闽峤月，布帆轻飏楚江云。\n悬知别后空梁梦，应有新诗最忆君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人之京","author":"林鸿","text":"江亭客散敛馀晖，忽听离歌泪满衣。\n沧海惊蓬浮世在，青春得桂少年稀。\n梅边飞雪行人度，雨外空江去雁微。\n明到长安春更好，五陵花柳正依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人之海南","author":"林鸿","text":"殷勤斗酒送君行，一曲骊驹对粤城。\n秋草愁心同北望，夕阳去路独南征。\n寒山月落青枫晚，野戍霜空白雁晴。\n年少功名应苦节，临流未可濯长缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洽公房送林敏","author":"林鸿","text":"珠宫客到夕阳时，西望乡园欲泪垂。\n芳草不堪多卧病，青山何事又分离。\n高原暮火行人尽，积雨长天去雁迟。\n暂醉一杯乘兴地，对君谁复忆凄其。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送余司马归晋中","author":"林鸿","text":"骢马朝来欲渡河，官城把袂惜蹉跎。\n沧洲旧业惊蓬断，白马流年倚剑过。\n梨叶烟村行客少，鹧鸪陵苑夕阳多。\n天涯相忆知何处，空有愁心对酒歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送逸人之岭南","author":"林鸿","text":"把酒离筵江上青，水亭客散雨冥冥。\n心怀远道频看剑，迹向南天秖类萍。\n孤驿城头晴见树，片帆海上夜浮星。\n知君此去堪乘兴，何必临岐涕泪零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林十一归山","author":"林鸿","text":"青门长笛起愁声，沧海离杯感故情。\n宾馆芰荷清夜语，乡山砧杵暮秋行。\n浮云北去无踪迹，旅雁南归有弟兄。\n莫叹蹉跎向年少，古人白首尚躬耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李安之建安","author":"林鸿","text":"绿槐宫树一蝉声，歧路相看万里情。\n对酒谩因愁远别，临流还可濯长缨。\n孤帆夜火洲边驿，澹月疏星柳外城。\n遥想溪山更乘兴，閒居独羡子云名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀林外史","author":"林鸿","text":"骚人别去易蹉跎，门掩浮亭长薜萝。\n北阙才名嗟放逐，西镛亲友念经过。\n醉题候馆桐花早，归梦乡山夜雨多。\n料得登临多胜事，南州词赋复如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"会林南宫宅怀郑二","author":"林鸿","text":"閒吟秋草思无穷，却喜亲朋此夜同。\n外史閒亭欢对酒，浮丘沧海暗惊蓬。\n疏砧候馆空江上，远火人家积雨中。\n别后深怀书信否，天涯愁绝送飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次镡津呈董书记","author":"林鸿","text":"楝花时候忆同游，况复怀君此泊舟。\n千里归心逢臈尽，几家落日倚门愁。\n山钟杳杳前朝寺，烟水悠悠古建州。\n何事相思不相见，尔来应被白云留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与任本立","author":"林鸿","text":"长河二月柳阴阴，客舍看春感越吟。\n和气不应消白发，寒灰终未变丹心。\n湘潭雁去江蓠远，夕照莺啼谷树深。\n共道长卿归卧病，青山应笑又投簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送马秀才下第归江南","author":"林鸿","text":"嗟君失意赋归休，家在沧洲忆旧游。\n灞上柳条牵客怅，江南草色向人愁。\n山城落日寒吹角，水国连天夜泊舟。\n莫叹青春误年少，古来白首未封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送客归江州","author":"林鸿","text":"悠悠草色醉离樽，送子东归欲断魂。\n洛社分携孤剑去，浔阳耆旧几家存。\n湓江浪白潮通海，楚地山青柳在门。\n若见别来相识问，风波此日不堪论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送薛居士和州读书","author":"林鸿","text":"西风征雁去翩翩，闻道携书泛楚船。\n左氏赋成曾十载，董生帷下又三年。\n读书小馆山当户，旧业巢湖水作田。\n圣代秖今逢掖贵，莫令岁月易流连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人入蜀","author":"林鸿","text":"江亭把酒唱离歌，游子扁舟发汝沱。\n草色到江知地尽，猿声入峡觉山多。\n水流深向荆门出，栈道遥从树杪过。\n去去蜀中应计日，相思明日复如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿淮浦寄司空文明","author":"林鸿","text":"思君深夜百忧新，淮浦东头问去津。\n千里楚天初度雁，两河明月未归人。\n从风自叹成黄叶，临水空思采白蘋。\n知己飘零有如此，旧游那复洛阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登馀干城","author":"林鸿","text":"醉向东风览物华，江山谁使后人嗟。\n苍烟古垒危三户，白发遗民更几家。\n城上当时谁驻马，云中落日有啼鸦。\n登临莫用怀今古，愁绝湖桥酒幔斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贾谊宅","author":"林鸿","text":"少年何事到长沙，此处翻成谪宦家。\n地湿楚乡秋雨后，草深甲第夕阳斜。\n清湘东去人空吊，盛世南迁众所嗟。\n我亦为君长太息，懒将书剑客天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春江上逢兵曹","author":"林鸿","text":"望君江浦草离离，马上相逢泪欲垂。\n赋就张衡虽不乐，途穷阮籍复何之。\n山含碧树莺啼早，雨散江亭客去迟。\n暂醉一杯乘兴地，风流莫道昔年时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"积雨辋川庄上","author":"林鸿","text":"短褐山中荷筱时，东菑风雨共栖迟。\n久从野老田间饷，深负林僧竹下期。\n梨叶烟村闻布谷，桃花潭水隐鸬鹚。\n悬知别墅安农意，此外馀生空尔为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬畅当寻嵩山麻道士","author":"林鸿","text":"少室寻真羡独经，唯应大道本无形。\n龙飞水殿晴驱雨，鹤绕天坛夜礼星。\n望气远临关树紫，看山空对药炉青。\n那应一问烟霞思，愿得长游且驻龄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答马秀才","author":"林鸿","text":"学书学剑事悠悠，况是栖迟未白头。\n顾影夕阳空北望，惊心大火复西流。\n乱山背水孤城晚，独树临关一叶秋。\n君亦尚为南郡客，遍题尺牍问穷愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚次鄂州","author":"林鸿","text":"孤城吹角水漫漫，近夕波摇舟次滩。\n峡口砧声江上度，武昌树色月中看。\n南天渺渺怀人远，北斗苍苍向客寒。\n流落水云千万里，不知何处是长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题方壶墨竹","author":"林鸿","text":"明月高悬白玉盘，仙人居处近虚寒。\n一枝凤尾金风里，清露时时滴石坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"下山寻朱继","author":"林鸿","text":"携琴载酒远寻君，石径人稀日半曛。\n纵醉也须山上去，莫教閒却半床云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄周隐者","author":"林鸿","text":"卜筑深依野鹿群，姓名何用世人闻。\n平生身外无馀物，只有秋山几片云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄三山旧游","author":"林鸿","text":"自怜风月酷吟身，十载三山不负春。\n岂意凌霄台下路，看花饮酒属他人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放归言志","author":"林鸿","text":"君门乞得此身閒，野树烟江一棹还。\n收拾旧时诗酒伴，远寻僧舍入秋山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之镡城留别冶城诸彦 其一","author":"林鸿","text":"冬青花外雨霏霏，半湿征鞍半湿衣。\n此去孤舟无伴侣，空江惟有白鸥飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之镡城留别冶城诸彦 其二","author":"林鸿","text":"十载吟秋卧翠微，三年宦薄日边归。\n玉华花鸟应相送，依旧闽南一布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之镡城留别冶城诸彦 其三","author":"林鸿","text":"知己相携欲别难，白波春草路漫漫。\n剑潭谁道无明月，不似清泠把酒看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之镡城留别冶城诸彦 其四","author":"林鸿","text":"荔子花开海雨晴，分㩦同下越王城。\n从来送别多愁怨，惟有青山忘却情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之镡城留别冶城诸彦 其五","author":"林鸿","text":"舟停桂棹骑停辕，落日江头酒一樽。\n谁道剑溪非远别，碧波青草总销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪山春晓","author":"林鸿","text":"香雾濛濛湿翠霞，半帘残月到仙家。\n野桥初过莺声晓，乍见春溪水涨沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江亭初夏","author":"林鸿","text":"依依绿荇动薰风，极浦帆边望不穷。\n最爱凭高上江阁，一时清兴与谁同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"野馆秋声","author":"林鸿","text":"淅沥寒声处处疑，空庭寥阒月明时。\n萧萧卧听生秋思，草木凋零人未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阴崖雪霁","author":"林鸿","text":"阴林雾气晓来分，峭壁寒光射岭云。\n一自投簪归去后，此身牢落与谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题李白问月图","author":"林鸿","text":"玉杯问月乾坤窄，綵句吟秋鬼魅愁。\n千古神游何处在，若非蓬岛即瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀 其一","author":"林鸿","text":"女螺江上送兰桡，长忆春纤折柳条。\n归梦不知江路远，夜深和月到红桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀 其二","author":"林鸿","text":"骊歌声断玉人遥，孤馆寒灯伴寂寥。\n我有相思千点泪，夜深和雨滴红桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀 其三","author":"林鸿","text":"残灯暗影别魂消，泪湿鲛人玉线绡。\n记得云娥相送处，淡烟斜月过红桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀 其四","author":"林鸿","text":"素馨花发暗香飘，一朵斜簪近翠翘。\n宝马未归新月上，绿杨影里倚红桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀 其五","author":"林鸿","text":"春衫初试淡红绡，宝凤搔头玉步摇。\n长记看灯三五夜，七香车子度红桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀 其六","author":"林鸿","text":"溶溶春水漾琼瑶，两岸菰蒲长绿苗。\n几度踏青归去晚，却从灯火认红桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀 其七","author":"林鸿","text":"一襟离恨暗魂消，閒却鸣鸾白玉箫。\n燕子不来春事晚，数株杨柳暗红桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀 其八","author":"林鸿","text":"伤春雨泪湿鲛绡，别雁离鸿去影遥。\n流水落花多少恨，日斜无语立红桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀 其九","author":"林鸿","text":"绮窗别后玉人遥，浓睡才醒酒未消。\n日午捲帘风力软，落花飞絮满红桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀 其十","author":"林鸿","text":"三千客路动行镳，远别归来兴欲飘。\n秖恐凤楼人待久，玉鞭催马上红桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀 其十一","author":"林鸿","text":"玉阶深露滴芭蕉，独倚屏山望斗杓。\n为惜碧波明月色，凤头鞋子步红桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏怀 其十二","author":"林鸿","text":"云娥酷似董妖娆，每到春来恨未消。\n谁道蓬山天样远，画阑咫尺是红桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽沙阳朱氏 其一","author":"林鸿","text":"青楼十二敞银屏，长记生前几醉醒。\n今日重来人不见，七峰犹似黛眉青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽沙阳朱氏 其二","author":"林鸿","text":"珠沉玉殒两茫茫，十里溪流与恨长。\n依旧春山花似绮，不知何处瘗兰香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽沙阳朱氏 其三","author":"林鸿","text":"二十年来一梦归，楚台秦馆事应非。\n春魂想化西园蝶，犹向碧桃花下飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽沙阳朱氏 其四","author":"林鸿","text":"绿杨两叶想眉颦，谁写新诗咏性真。\n一自朱楼人去后，莺花不似旧时春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽沙阳朱氏 其五","author":"林鸿","text":"玉露幽兰忆泪泫，殡宫幽暗夜如年。\n空馀旧日香奁句，一度悲吟一怅然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽沙阳朱氏 其六","author":"林鸿","text":"青鸾影断杳难回，暝掩红颜向夜台。\n可惜玉楼空鹊镜，也随罗绮葬寒灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽沙阳朱氏 其七","author":"林鸿","text":"舞袖何年化作云，玉箫声断凤离群。\n春风似惜泉宫恨，片片吹花落古坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽沙阳朱氏 其八","author":"林鸿","text":"兰销桂蠹雨初晴，寂寂泉宫夜不明。\n闻说七峰山下水，至今流恨也吞声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽沙阳朱氏 其九","author":"林鸿","text":"柳台花榭寄尘踪，名籍蓬莱第几宫。\n晚出人间风露表，佩声夜夜响瑶空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绿杨燕 其一","author":"林鸿","text":"上国䌓华画里看，绿杨紫燕斗春阑。\n金河堤上朝回路，最是飞花扑玉鞍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绿杨燕 其二","author":"林鸿","text":"千株积翠浓如墨，两岸䌓华事已非。\n残燕不知春已去，斜风细雨故飞飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题宋故宫御屏芍药","author":"林鸿","text":"雨晕霞绡粉绘香，品流应得亚花王。\n五侯池馆春如梦，无复䌓华似洛阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题竹 其一","author":"林鸿","text":"醉墨淋漓湿未乾，拂云双玉倚秋看。\n别来嶰谷空林月，几度凄凉篴里寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题竹 其二","author":"林鸿","text":"南山野老种琅玕，锦箨初翻烟雨寒。\n尽是伶伦裁凤管，芸窗留得一枝看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画松","author":"林鸿","text":"长风萧飒起毫端，雪干苍苍几岁寒。\n黑入太阴云雨合，就中疑是老龙蟠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画竹","author":"林鸿","text":"玉节娟娟老雪霜，苍梢势欲拂云长。\n南风昨夜吹烟雾，添得虚堂六月凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊屈原","author":"林鸿","text":"汨罗东去水滔滔，吊古临流诵楚骚。\n千载独醒惟有子，古今醉死尽英豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮别友","author":"林鸿","text":"笔砚相从又一年，今晨判袂各纷然。\n临岐不用嗟离别，明德相期贵勉旃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":54619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]