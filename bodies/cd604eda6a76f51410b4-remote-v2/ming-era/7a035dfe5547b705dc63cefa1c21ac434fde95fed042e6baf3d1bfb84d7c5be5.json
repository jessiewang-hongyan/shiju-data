[{"title":"江南乐八首代内作 其八","author":"徐祯卿","text":"江南道里长，荆襄在何处。\n闻郎昨夜语，五月潇湘去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10266,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陇头流水歌三叠代内作 其一","author":"徐祯卿","text":"陇水呜咽流，各自东西下。\n生男不下堂，生女弃中野。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10267,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陇头流水歌三叠代内作 其二","author":"徐祯卿","text":"下陇磨剪刀，刀涩指爪柔。\n将刀断割水，那用东西流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10268,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陇头流水歌三叠代内作 其三","author":"徐祯卿","text":"陇水鸣不止，似闻阿儿语。\n出门不见人，肝肠断绝汝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10269,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"少年行","author":"徐祯卿","text":"生长在边城，骑射有声名。\n召募河源去，长屯都护营。\n登山望敌气，间道出奇兵。\n十决推雄战，连呼拔虎旌。\n云中息刁斗，天上扫欃枪。\n坐弄胡笳月，梅花陇水清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10270,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"从军行五首 其二","author":"徐祯卿","text":"贰师将军初出师，横行十万羽林儿。\n隔河追斩呼韩将，乌垒高悬太白旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10271,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"从军行五首 其三","author":"徐祯卿","text":"五垒神兵下玉门，倒倾西海蹴昆崙。\n轻车夜渡交河水，斩首先传吐谷浑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10272,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"从军行五首 其四","author":"徐祯卿","text":"调笑胡王坐玉鞍，蛇矛丈八奋如湍。\n天子戎衣遥按剑，将军直为斩楼兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10273,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"从军行五首 其五","author":"徐祯卿","text":"青天碛路挂金微，明月洮河树影稀。\n胡雁哀鸣飞不度，黄云戍卒几时归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10274,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"平陵东行","author":"徐祯卿","text":"共工触天补女娲，后羿射之摧九乌。\n君不见泰山之高屹天柱，有时东崩海水枯。\n秦人筑长城，东笞夷貊北击胡，开阖地户天下枢。\n九关虎豹下食人，髑髅飞血昏风尘，四海望之威天神。\n亦有荆轲起报雠，裂眦向天天为愁。\n拔剑一呼走万乘，快哉壮士谁与俦。\n儒生抗眉论尧舜，敛手待烹良可羞。\n上卿执圭古所侈，鲁生弃之若敝屣。\n鸿毛轻死为二桃，笑杀田疆与冶子。\n龙蛇消息各有时，白石落落人岂知。\n季布髡为奴，范雎乃是粪下儿。\n一朝云雷起屯厄，挥刃脱缚扬高眉。\n我今伛偻困蝼蚁，吹沙吸呷若鲋鲤。\n牛涔蠕蠕岂足活，河伯向我誇秋水。\n夜梦凭云忽上天，倾山倒海作龙渊。\n天门中开绕赤电，霓旌雷车导我前。\n空山飒飒走霹雳，草木摧拉飞炎烟。\n丈夫未足哀困穷，仰叹白日回英风。\n不能鼓行青海上，亦当击剑于咸阳之市中。\n宁学锄麑触槐死，羞言投阁仕莽公。\n吾悲夫二子之死也，诚如寒蚓之与秋蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10275,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"燕京四时歌 其一 春","author":"徐祯卿","text":"天柳垂丝拂建章，银冰千片落金塘。\n烟花万国行人度，遥指蓬莱春日光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10276,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"燕京四时歌 其二 夏","author":"徐祯卿","text":"暑殿金泉枕碧山，清凉楼阁五台间。\n赤日不行葱岭北，雪花长绕玉门关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10277,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"燕京四时歌 其三 秋","author":"徐祯卿","text":"蓟门桑叶落滹沱，代北浮云鸿雁多。\n莫向云中传尺素，空将明月对嚬蛾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10278,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"燕京四时歌 其四 冬","author":"徐祯卿","text":"葡萄新酒泼流霞，十月燕山雪作花。\n天子后庭誇玉树，昭君胡服拂琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10279,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词七首 其一","author":"徐祯卿","text":"君王无事日临戎，韎韐亲调白玉弓。\n千骑红袍齐扈跸，臂鹰遥出建章宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10280,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词七首 其二","author":"徐祯卿","text":"千场搏戏未言回，鱼钥重重向暮开。\n遥听云中催羯鼓，君王何处打毬来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10281,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词七首 其三","author":"徐祯卿","text":"剑舞戎歌乐未休，煌煌芝火五城楼。\n班姬独卧昭阳殿，却捲珠帘望女牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10282,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词七首 其四","author":"徐祯卿","text":"十五承恩侍衮旒，宫中初拜大长秋。\n见说上林陪羽猎，君王同著紫云裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10283,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词七首 其五","author":"徐祯卿","text":"兴庆池头漏未阑，梨园弟子曲将残。\n花前更进凉州伎，无那西宫月色寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10284,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词七首 其六","author":"徐祯卿","text":"驰道毵毵御柳垂，春风挟弹羽林儿。\n武皇亲御长杨殿，敕与龙驹控鬣骑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10285,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟古宫词七首 其七","author":"徐祯卿","text":"狗监离宫承宴欢，掖庭通晚不回銮。\n那能夜夜长门里，银烛薰衣待漏残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10286,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂谣四首 其一","author":"徐祯卿","text":"夫为虏，妻为囚。\n少妇出门走，道逢爷娘不敢收。\n东市街，西市街。\n黄符下，使者来。\n狗觫觫，鸡鸣飞上屋。\n风吹门前草肃肃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10287,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂谣四首 其二","author":"徐祯卿","text":"坏我民居田，树子桐与槚。\n桐槚何青青，素车不得下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10288,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂谣四首 其三","author":"徐祯卿","text":"狐彭彭，兔逐逐，反顾奔以北。\n弯弓来，弯弓来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10289,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杂谣四首 其四","author":"徐祯卿","text":"沼我乎逵兮，筑子之栖兮。\n木槿陨落，巢安归兮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10290,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"古意二首赠刘子 其一","author":"徐祯卿","text":"空为郢中客，不见郢中吟。\n美人高堂上，自奏山水音。\n帝子葬何处，潇湘云正深。\n寂寥谁共赏，江上独伤心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10291,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"古意二首赠刘子 其二","author":"徐祯卿","text":"楚妃一失宠，独宿楚江阴。\n虽念容华落，终怜缱绻心。\n闻说章台畔，畋游欢自淫。\n今日宫中事，不言谗妒深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10292,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠王渊之","author":"徐祯卿","text":"君不见十月狂风吹白雪，长安城中地欲裂。\n朱门酒炉红炙天，空里琼花旋消灭。\n由来都国盛繁华，青云络绎满仙车。\n浪说黄金赐寒士，争言白璧谒侯家。\n骄矜意气遥相羡，片善朝推蒙夕荐。\n待诏虚沈金马门，传宣直上麒麟殿。\n王郎濩落尔何求，千里乘驴被黑裘。\n空论作赋称才子，未肯低眉事贵游。\n知君不得逢杨意，终愧明时老督邮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10293,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答顾郎中华玉","author":"徐祯卿","text":"昔居长安西，今居长安北。\n蓬门卧病秋潦繁，十日不出生荆棘。\n牵泥匍匐入学宫，马瘦翻愁足无力。\n慵疏颇被诸生讥，虚名何用时人识。\n京师卖文贱于土，饥肠不救齑盐食。\n去年作吏在法曹，月俸送官空署职。\n床头一瓮不满储，囊里无钱作沽直。\n归来困顿不得醉，儿女荒凉妇叹息。\n今年调官去懊恼，苦笑先生禄太啬。\n釜中粟少作糜薄，白碗盛来映肤色。\n丈夫但免沟壑辱，日饮藜羹胜羊肉。\n平生富贵亦何有，羸躯幸自弛耕牧。\n但愿时丰民物安，官府清廉盗贼伏。\n人歌鼓腹厌粱菽，先生虽病甘苜蓿。\n一朝雷雨濯亨衢，坐见诸公执中轴。\n先生翛然卷怀退，茆斋归向南山卜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10294,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"入沛","author":"徐祯卿","text":"落日遍草色，游子入沛乡。\n如何缅兹土，能令心慨慷。\n道逢守津吏，问客来何方。\n一为陈风俗，三叹久傍徨。\n前者贰尹家，会客具酒浆。\n遣吏出市物，吏私入己囊。\n尹讯卑以纡，吏言伉以张。\n回身赴入河，尹慑亲扶将。\n矫矫鸷悍风，重忿复轻亡。\n由来英雄气，傥荡出芒砀。\n余听此言立，侧想《大风》章。\n抚剑一为歌，春宇无精光。\n原野厉长飙，飞鸟不遑翔。\n瞿瞿蟋蟀叹，悽恻感陶唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10295,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"彭蠡","author":"徐祯卿","text":"茫茫彭蠡口，隐隐鄱阳岑。\n地涌三辰动，江连九派深。\n扬舲武昌客，发兴豫章吟。\n不见垂纶叟，烟波空我心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10296,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"在武昌作","author":"徐祯卿","text":"洞庭木叶下，潇湘秋欲生。\n高斋今夜雨，独卧武昌城。\n重以桑梓念，凄其江汉情。\n不知天外雁，何事乐南征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10297,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓下庐山","author":"徐祯卿","text":"下山鼯鼠啼，藤竹使人迷。\n多谢东林月，殷勤过虎溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10298,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登支硎山楼迟游侣","author":"徐祯卿","text":"谷寺怜幽密，兹楼表丽观。\n烟云塞壑动，竹树入门寒。\n独往迷前径，凭高迟所欢。\n时闻有清磬，遥出暮林端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10299,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长陵西望泰陵二首 其二","author":"徐祯卿","text":"昔送宫车出，长悲西雍门。\n今来寒食节，独望灞陵园。\n杳杳仙城闭，萋萋封树繁。\n当时侍从客，恸哭几人存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10300,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日游眺三绝句 其一","author":"徐祯卿","text":"频年摇落寄边州，无赖今晨强出游。\n从教乌帽欺人发，不耐黄花乱客愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10301,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日游眺三绝句 其三","author":"徐祯卿","text":"西门沙丘颓欲崩，思望芒山强自登。\n正愁陇树模糊甚，更著浮云蔽泰陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10302,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浙江驿下作","author":"徐祯卿","text":"自叹南浮客，崎岖驿岭遥。\n川途澹斜日，钲鼓远扬桡。\n水势含沧海，山形折落潮。\n夷墟不可问，徒使旅心摇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10303,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送友二首 其一","author":"徐祯卿","text":"瓜生葛薪下，缘蔓义相因。\n人生交结故，婉娈自谐亲。\n交义谅不远，戚若同株根。\n勿采棘下瓜，棘伤多苦辛。\n不惜伤者苦，但恐株荄分。\n念当与子别，恻恻伤我神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10304,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留别边子","author":"徐祯卿","text":"我车驾言迈，将子城之隅。\n岂无他人亲，婘㜻心自知。\n握手一为叹，忽忽从此辞。\n驱车何迢迢，迢迢复迟迟。\n匪我车轮迟，行子有所思。\n登高望河水，河水何瀰瀰。\n褰裳欲涉之，俛首以踟蹰。\n孤杨生河干，袅袅何差差。\n民生失俦匹，恻尔令心悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10305,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送士选侍御","author":"徐祯卿","text":"壮士乐长征，门前边马鸣。\n春风三月柳，吹暗大同城。\n卢沟桥下东流水，故人一樽情未已。\n胡天飞尽陇头云，唯见居庸暮山紫。\n羡君鞍马速流星，予亦孤帆下洞庭。\n塞北荆南心万里，佩刀长揖向都亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10306,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送范静之迁威州五首 其一","author":"徐祯卿","text":"吾怜范巨卿，悃愊不邀名。\n作吏竹林下，清风讼狱平。\n与君同得罪，独窜夜郎城。\n万里巴江水，相思猿狖鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10307,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送范静之迁威州五首 其二","author":"徐祯卿","text":"闻上巴江峡，黄牛峡最迟。\n君听流水意，何似陇头悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10308,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送范静之迁威州五首 其三","author":"徐祯卿","text":"尔向巫山日，瞿塘春可怜。\n柳丝娇绿水，白雪媚阳天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10309,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送范静之迁威州五首 其四","author":"徐祯卿","text":"玉垒为糟蘖，巴川即酒泉。\n乘舟捉明月，直到女牛边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10310,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送耿晦之守湖州","author":"徐祯卿","text":"远下吴江向霅川，高秋风物倍澄鲜。\n鵁鶄菰叶翠相乱，锦石游鳞清可怜。\n邮渚挝频津吏鼓，渔歌唱近使君船。\n吴兴岘山足胜事，汉水襄阳空昔贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10311,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送萧若愚","author":"徐祯卿","text":"送君南下巴渝深，予亦迢迢湘水心。\n前路不知何地别，千山万壑暮猿吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10312,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"青门歌送吴郎","author":"徐祯卿","text":"吴郎醉嗜长安酒，落魄自言为客久。\n走马频看上苑花，回鞭几折青门柳。\n青门曈曈鱼钥开，乳燕游丝相逐来。\n柳下雕鞍留别袂，花间酒盏覆苍苔。\n浮云去去辞城阙，芳草连天那可歇。\n野店春风听早莺，关河晓树悬新月。\n千里淮流双画桡，广陵驿前逢暮潮。\n落日帆归扬子渡，青山家对伯通桥。\n吾家流水元非隔，宛转胥台通巷陌。\n草长难寻仲蔚居，林深不见陶潜宅。\n清溪屋下可垂纶，复有莼羹足献亲。\n君归倘食冰丝鲙，为念羁栖塞北人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10313,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别献吉","author":"徐祯卿","text":"尔放金鸡别帝乡，何如李白在浔阳。\n日暮经过燕赵客，解裘同醉酒垆傍。\n徘徊桂树凉飙发，仰视明河秋夜长。\n此去梁园逢雨雪，知予遥度赤城梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10314,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送友人还吴","author":"徐祯卿","text":"阳月随阳雁，遥从塞上来。\n北人江北望，不见陇头梅。\n坐下杨朱泪，吟为庄舄哀。\n聊传数行札，千里送君回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10315,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送萧少府","author":"徐祯卿","text":"矫矫双凫塞陇分，武夷残雪半春云。\n玉洞只愁仙隐去，洛阳花下不逢君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10316,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送顾马湖孔昭四首 其一","author":"徐祯卿","text":"巴东明月巴西歌，两岸梅花羌笛多。\n一曲停桡双泪落，猿声三峡若为过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10317,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送顾马湖孔昭四首 其三","author":"徐祯卿","text":"锦水由来胜若耶，兰桡三月汎桃花。\n巴儿见客能歌舞，蜀女明妆笑浣纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10318,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"安南歌四首送沈使君 其一","author":"徐祯卿","text":"借问炎交路若何，片帆南指广州过。\n知君怕见桄榔树，近岭猿声日渐多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10319,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送方山人","author":"徐祯卿","text":"严子滩头花落时，水清云碧净涟漪。\n孤舟相逐飞花去，一日看山到武夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10320,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送盛斯徵赴长沙","author":"徐祯卿","text":"昔愁越巂千峰仄，转入巴渝万里赊。\n岂料圣恩怜贾谊，犹烦佐郡出长沙。\n蛮中瘴远三湘水，江畔春逢十月花。\n遥听岳阳楼上笛，可能回首忆京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10321,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"唐生将卜筑桃花之坞谋家无赀贻书见让寄此解嘲","author":"徐祯卿","text":"余昔攀白日，虹蜺干紫庭。\n浮沈帝座侧，无人知岁星。\n侧侍公车无所欢，聊骑天马出长安。\n南下苍江浮七泽，还携谢客弄波澜。\n青倪中开秀庐岳，瀑布洒入千峰寒。\n冥冥仙气贯南斗，直欲凌身烧大丹。\n回裾西拂巫山浦，浩荡欢心间云雨。\n归来欲奏楚王书，汉主上林方好武。\n黄金不遇心自吁，白璧无媒翻见侮。\n昨日结交燕少年，酣歌击筑市中眠。\n正逢天子失颜色，夺俸经时无酒钱。\n入门百结鹔鹴尽，笑立文君明镜前。\n却思旧日高阳侣，黄公酒垆何处边。\n天下绨袍谁不怜，郤卿未具山中橐，何人为买剡溪田。\n唐伯虎，真侠客。\n十年与尔青云交，倾心置腹无所惜。\n击我剑，拂君缨。\n请歌《鹦鹉篇》，为奏朱丝绳，胡为扰扰苍蝇之恶声。\n我今蹭蹬尚如此，嗟尔悠悠世上名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10322,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄华玉","author":"徐祯卿","text":"去岁君为蓟门客，燕山雪暗秦云白。\n马上相逢脱紫貂，朝回沽酒城南陌。\n燕山此日雪雰雰，祗见秦云不见君。\n胡天白雁南飞尽，千里相思那得闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10323,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"驾出南郊退简边乔二太常","author":"徐祯卿","text":"斋殿銮舆下，郊宫凤野开。\n霜戈迎日动，芝盖拂云来。\n辇道前旌直，钩陈翼骑回。\n甘泉枚朔侍，词赋接仙才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10324,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日怀李郎中及边熊二君子五首 其一","author":"徐祯卿","text":"秋兴因高赋，雄才忆省郎。\n山川思不极，云树莽葱苍。\n对酒知时变，看花恨别长。\n如何霜后雁，犹未达潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10325,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过乔侍郎省中因怀献吉","author":"徐祯卿","text":"东掖当年署，长廊故柳斜。\n久辞陈子榻，重谒谢公衙。\n厅事垂蛛网，高檐噪晚鸦。\n风烟那可忆，飘泊惜瑶华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10326,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀往二首 其一","author":"徐祯卿","text":"昔我逢休景，结交共云翔。\n秦客穆脩矩，鲁生蔚令章。\n同声展言笑，四座发芬芳。\n北牖湛清酒，明月出西方。\n广署灭流尘，兰灯扬朱光。\n极意连篇翰，良夜殊未央。\n欢宴丰时豫，千秋焉可忘。\n流光一朝绝，抚膺增慨慷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10327,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀往二首 其二","author":"徐祯卿","text":"穴虫测序改，客鸟知时晏。\n严风振中野，凝霜薄飞观。\n褰裳启东户，河星出有灿。\n耿耿不遑寐，沈思汨回乱。\n何以终遥夕，明灯且濡翰。\n自我违之子，菀藻绝流玩。\n郢斤不存目，流俗耻垩墁。\n块处空堂中，谁为发言粲。\n感嘅申微词，伫立倚长叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10328,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偶述二绝句 其一","author":"徐祯卿","text":"圣人嘉礼在元年，内使新从十道还。\n欲遣鸾仪迎月姊，禁中宣敕会金钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10329,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]