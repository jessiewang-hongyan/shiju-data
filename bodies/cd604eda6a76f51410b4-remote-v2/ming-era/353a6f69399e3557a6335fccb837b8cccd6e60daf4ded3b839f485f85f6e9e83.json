[{"title":"吴母太夫人哀词","author":"谢榛","text":"城上乌啼正夜分，归魂遥逐楚江云。\n故园春笋空成竹，冷雨凄风不忍闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邹子序见过有感","author":"谢榛","text":"湖上青山旧业存，橘花春冷白沙村。\n遥思社日邻翁醉，燕子飞来空闭门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春宫词","author":"谢榛","text":"笙歌长在玉楼东，月上千门春不同。\n莫怪画图欺汉帝，昭君何限老深宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋宫词","author":"谢榛","text":"内苑秋风木叶残，班姬曾为赋齐纨。\n六宫何处无愁思，不断阴虫泣夜寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃花","author":"谢榛","text":"溪上蒸霞千万枝，隔林黄鸟愿春迟。\n不催洞里秦人老，解使宫中汉女悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"红梅","author":"谢榛","text":"西方仙子服丹砂，幻作江天第一花。\n未合上林凝暮雪，偏宜大庾映朝霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬贾子修见寄","author":"谢榛","text":"客子孤吟逼岁残，停云缥缈正西看。\n赵襄城郭千山外，一骑书来雨雪寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漳河雨后","author":"谢榛","text":"隔林咿轧来渔舠，白鹭背人飞不高。\n却讶衡漳一夜雨，几家村落生秋涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮秋溪上即事","author":"谢榛","text":"秋深露冷荻花间，沙岸无人鹤自还。\n坐据清流一片石，西风不动钓丝閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀范尧卿","author":"谢榛","text":"老来黄鸟更愁闻，两度春风不见君。\n书到日南心万里，碧鸡山下有停云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张户部道卿还省中","author":"谢榛","text":"离筵歌罢动清飙，直北关河入望遥。\n日暮飞帆向天际，不知暗度海门潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15146,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴二少陆归洞庭山省亲 其一","author":"谢榛","text":"游子惊心岁暮归，箧中时检旧斑衣。\n白头应念齐城客，春动江湖雁北飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴二少陆归洞庭山省亲 其二","author":"谢榛","text":"鹤发相辉堂上人，吴天遥望瑞云新。\n洞庭酒熟梅花发，同醉沙村几树春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游苏门山不果柬蔡侍郎","author":"谢榛","text":"胜事良辰多偶然，苏门萝月客心悬。\n忽惊枕上来风雨，疑是空山听百泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春宫","author":"谢榛","text":"花间御水照春心，几处恩波自浅深。\n多少蛾眉争买赋，相如应是厌黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄文五峰","author":"谢榛","text":"半醉吴歌何处游，白云寄意不胜秋。\n乘风欲落秦淮水，遮莫寻君傍酒楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄门人王少海秀才","author":"谢榛","text":"归去还从支道林，秣陵游览壮吴吟。\n雨花台上谈禅夜，水月虚涵妙悟心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚登沁州城有感 其二","author":"谢榛","text":"客子登临望野田，铜鞮城上月初悬。\n清光偏照农家妇，织得春衣办税钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐进士子绳谪建阳少尹 其一","author":"谢榛","text":"长亭别酒见平生，越水吴山去国情。\n欲采江蓠何处泊，一帆秋雨听潮声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐进士子绳谪建阳少尹 其二","author":"谢榛","text":"九霄宫阙绛云垂，上有仙人谪武夷。\n三十六峰争秀色，秋风莫负幔亭期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐进士子绳谪建阳少尹 其三","author":"谢榛","text":"建溪城外有仙坛，梅福山空落月寒。\n不向清朝学仙尉，还依北斗望长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐进士子绳谪建阳少尹 其四","author":"谢榛","text":"望浙峰头秋叶彫，望京楼上断鸿遥。\n应思旧日看花处，走马卢沟第一桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐进士子绳谪建阳少尹 其五","author":"谢榛","text":"九日潭空龙独眠，三春雷雨建阳天。\n荔枝花发啼黄鸟，闽海迢遥望日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘将军赴南都","author":"谢榛","text":"江风吹棹送人寒，一剑横秋秖自看。\n应过淮阴吊韩信，月明曾照汉家坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈驾部锡卿还钱塘省亲 其一","author":"谢榛","text":"司马旌旗下九重，三江秋色上芙蓉。\n故乡南去四千里，云外遥看天柱峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈驾部锡卿还钱塘省亲 其二","author":"谢榛","text":"朝浮扬子潮声远，夜泊芦花月影孤。\n应念倚门今白发，长风吹梦到西湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈驾部锡卿还钱塘省亲 其三","author":"谢榛","text":"白云千里故园心，海上青山辨武林。\n燕雁度江天渺渺，吴枫接岸日阴阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈驾部锡卿还钱塘省亲 其四","author":"谢榛","text":"片帆飞去拂云霞，月满中秋应到家。\n人在长安望南国，隔江春信寄梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王梦白归吴次韵 其一","author":"谢榛","text":"八月浮云满帝畿，长江风送一帆归。\n皋桥无限黄花酒，莫遣秋霜上客衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王梦白归吴次韵 其二","author":"谢榛","text":"朝度海门生白波，天涯知己惜无多。\n清秋忽忆山中侣，谁伴横塘采芰荷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王梦白归吴次韵 其三","author":"谢榛","text":"击楫高歌气不群，秋风吹落大江云。\n黄金台上初归客，白鹤桥西旧隐君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王梦白归吴次韵 其四","author":"谢榛","text":"张翰东归尚黑头，石湖重理旧渔钩。\n不知人对燕山月，笛里梅花独夜愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲 其一","author":"谢榛","text":"月出春江照芳芷，思君梦度潇江水。\n花里朱扉向晓开，双双蛱蝶正飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲 其二","author":"谢榛","text":"池亭独坐愁落晖，欲采芰荷制君衣。\n一寄天涯当自悟，君身不染风尘色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送皇甫水部之荆州 其一","author":"谢榛","text":"闻道美人荆楚行，片帆风色度江城。\n夕阳欲下复何处，九十九洲芳杜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送皇甫水部之荆州 其二","author":"谢榛","text":"襄阳小泊访山公，樽酒心期异代同。\n江上楚声听不尽，铜鞮争唱月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送皇甫水部之荆州 其三","author":"谢榛","text":"郢都南去渺烟涛，遥忆风流何水曹。\n日暮乱山秋色里，采兰应傍楚江皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送皇甫水部之荆州 其四","author":"谢榛","text":"烟沙漠漠水淙淙，估客千帆入汉江。\n天畔高楼动秋兴，白云红日坐开窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送皇甫水部之荆州 其五","author":"谢榛","text":"大江千折蜀中来，西望黄牛烟雾开。\n知尔登临最能赋，至今庾信有高台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五岳吟 其一","author":"谢榛","text":"海东黄鸟送书来，欲上天门把玉杯。\n万壑风云随杖履，狂歌醉舞汉王台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五岳吟 其二","author":"谢榛","text":"南岳夫人寄紫芳，清秋约我过衡阳。\n祝融峰上踏歌去，二十五溪烟水长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五岳吟 其三","author":"谢榛","text":"漠漠秦云望欲迷，好乘鸿鹄过关西。\n盘容铁索三千丈，玉女峰头日月低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五岳吟 其四","author":"谢榛","text":"恒岳孤高天外看，悬崖如削路盘盘。\n夜来梦落通玄谷，白石苍藤月色寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五岳吟 其五","author":"谢榛","text":"汗漫中原逸兴浓，洛阳南去访仙踪。\n杖藜长揖浮丘伯，五色云垂太室峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞下曲 其一","author":"谢榛","text":"都护防边旦夕劳，秋来天子赐征袍。\n何当净扫黄龙塞，白日飞霜上宝刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞下曲 其三","author":"谢榛","text":"穷边寒日惨无光，沙草连天走白狼。\n百战健儿争射猎，秋风跃马黑山阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞下曲 其四","author":"谢榛","text":"风吹榆柳作寒声，直北龙沙一望平。\n云压旌旗飞暮雪，将军坐啸受降城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞下曲 其五","author":"谢榛","text":"朔云黯淡古今愁，十月交河冻不流。\n铁马无声关塞静，征夫月下唱梁州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漠北词 其一","author":"谢榛","text":"大漠萧萧黑水流，健儿七月换羊裘。\n骆驼背上吹芦管，日暮长风动地秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漠北词 其三","author":"谢榛","text":"石头敲火炙黄羊，边女低歌劝酪浆。\n醉杀留犁不知夜，鹞儿岭下月如霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漠北词 其五","author":"谢榛","text":"碧眼贤王出打围，角鹰欲下兔如飞。\n一瓢芦酒驱寒色，雪满西山夜不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漠北词 其六","author":"谢榛","text":"译使燕京纳贡回，春风相送过榆台。\n单于无事耽歌舞，夜敞穹庐海月来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春别曲","author":"谢榛","text":"鸂鶒双飞下野塘，别情无那楚天长。\n官桥柳外青骊马，百尺游丝送阿郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大梁杂兴 其一","author":"谢榛","text":"梁孝池台迹已陈，邹枚去后复何人。\n黄鹂百啭日西下，柳外长烟依旧春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大梁杂兴 其二","author":"谢榛","text":"独登高塔俯中州，一线黄河天外流。\n坐倚半空成浩啸，白云南去见嵩丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大梁杂兴 其三","author":"谢榛","text":"三老遗踪在吹台，好风华月为谁来。\n骚人意会千年上，半醉掀髯坐石苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大梁杂兴 其四","author":"谢榛","text":"飞楼缥缈暮云间，上有红妆竟日閒。\n遥望玉骢驰九陌，魏家公子射雕还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大梁杂兴 其五","author":"谢榛","text":"梁国河山草树空，英雄异代气相同。\n侯生慷慨无馀恨，独立夷门啸晚风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜闻笛","author":"谢榛","text":"天空月白见峰峦，桥下泠泠秋水寒。\n长笛惊回老蛟梦，道人独倚石栏杆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"屈原","author":"谢榛","text":"放逐孤臣泪满缨，离骚当日寄深情。\n汨罗江上愁云起，万古蛟龙气不平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昭君","author":"谢榛","text":"龙荒夜半起悲风，坐悔容颜傲画工。\n一曲琵琶残月落，愁看孤雁入秦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春词 其一","author":"谢榛","text":"云鬟高结靓妆新，白玉屏开光照人。\n莫为桃花怨风雨，牡丹亭上有馀春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔翁","author":"谢榛","text":"青竹竿头一钓丝，高风应与子陵期。\n夜深醉卧秋江上，梦绕芦花明月知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔妇","author":"谢榛","text":"自嫁渔郎不解愁，月高横笛楚天秋。\n江村杨柳浑摇落，何处佳人独倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送窦子南还","author":"谢榛","text":"家住江南建业城，春风归去片帆轻。\n凤凰台上重登眺，白日浮云万古情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古怨","author":"谢榛","text":"邯郸少妇美容光，嫁与燕京游侠郎。\n白璧黄金买歌舞，不知风雨断人肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中观芍药醉赋","author":"谢榛","text":"山亭芍药正花开，白石栏边对酒杯。\n醉折红芳还起舞，天风忽送彩云来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿香山","author":"谢榛","text":"深夜无眠风露清，天移北斗坐间横。\n幽人不作红尘梦，月照空山鹤一声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游洪光寺","author":"谢榛","text":"岭外云霞开暮晴，半天风落万松声。\n于今莲社谁为主，遥望庐山无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻箫","author":"谢榛","text":"谁弄玉箫当晚风，凄凄袅袅入高空。\n苍梧月出凤凰叫，千山万山秋气中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"溪上杂兴 其一","author":"谢榛","text":"日暮孤村买浊醪，沧浪歌罢兴逾豪。\n芦花如雪点秋水，白鹭背人飞不高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"溪上杂兴 其二","author":"谢榛","text":"有客逍遥水石间，西风不动钓丝閒。\n渭川老子终多事，空外孤云自往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"度齐岭","author":"谢榛","text":"石树苍苍碧汉齐，日高荒野乱鸦啼。\n樵夫遥指天坛路，绝岭重云西更西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"本公房","author":"谢榛","text":"满山寒色万株松，天外遥传日暮钟。\n但见檐前起云雾，不知钵底卧蛟龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中即事","author":"谢榛","text":"万里同云鸟不飞，出门寒色上人衣。\n谁家公子能驰马，雪满长安射猎归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周秀才归钱塘","author":"谢榛","text":"美人南去采芳兰，春色偏宜江上看。\n天竺峰头读书处，白云长自傍人寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上曲寄少司马苏允吉 其一","author":"谢榛","text":"海日高临塞上城，汉家诸将久屯兵。\n断云飞去辽天阔，北望燕然万古情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上曲寄少司马苏允吉 其三","author":"谢榛","text":"边柳萧条带落晖，长城北去是金微。\n健儿跃马西山下，射得双狼雪里归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上曲寄少司马苏允吉 其四","author":"谢榛","text":"孤月高高照朔荒，戍楼吹笛满天霜。\n三秋杨柳飘零尽，此夜征夫总断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":15214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]