[{"title":"夜访圆通庵上人","author":"刘献翼","text":"春风怀夙约，踏月过禅林。\n花落无人迹，径幽且独寻。\n水通到门路，云识入庵心。\n万物辉今夕，悠悠笙磬音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宏化寺","author":"刘政","text":"塔铃高响白云间，日对孤僧迥自閒。\n品茗不知相话久，半山残照晚禽还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"彭峒山","author":"刘政","text":"选胜孤峰聊独上，绕峰怪石坐来閒。\n忽然暗响发幽谷，无数飞泉乱出山。\n远水暮烟浮冉冉，近人归鸟语关关。\n临风辄忆待秋月，夐立苍茫不肯还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南荒行寄潘子朋王百谷","author":"梁有谦","text":"南荒三月海势重，一鼓洪涛万丈耸。\n颠舟倒石谁禁当，群龙出没诸蛟拥。\n天地昏黑风怒号，淘河愁企雁嗷嗷。\n孤吟者谁行复立，五湖何处求其曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱将军夜宴","author":"梁有谦","text":"绮席欢清夜，双姬况妙龄。\n轻风回舞袖，凉月转歌屏。\n楼带池光白，尊兼五色青。\n不须今夕酒，何以慰飘零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食书怀","author":"梁有谦","text":"花飞过寒食，赏静向烟皋。\n隐有随窥豹，居愁懒挈鳌。\n弃繻非我意，射策待儿曹。\n纵有徵书辟，真同介子逃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观猎","author":"梁有谦","text":"手挽玉雕弧，腰悬金仆姑。\n壮夫齐袒裼，猛兽绝奔趋。\n绿草连罝结，朱旂掩日晡。\n将军欢一醉，星月满归途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次横山","author":"梁有谦","text":"系马村家日又曛，海偏风俗转愁闻。\n居人半葬鲲鳅腹，黎贼长依虎豹群。\n怪石青天仍滴雨，峦山白昼亦霾云。\n南来忽堕思家泪，并作杨朱洒路分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客居","author":"梁有谦","text":"居杂东人合浦傍，海深春月混微茫。\n一身过懒行还卧，两鬓禁愁短又苍。\n窗迫不妨风雨剧，地蒸先爱水云凉。\n婆娑自怪无家客，怅指西平是故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"永安元夕忆林徐二子","author":"梁有谦","text":"灯夕烟花好自亲，秋千蛮女踏歌频。\n绝怜短鬓看佳节，随意低头忆美人。\n酒里竞孤千里月，风前虚度九枝春。\n年来不浅飘零色，小傍诗名老葛巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"欹枕答朱郡丞","author":"梁有谦","text":"思家欹枕懒看春，似是莺花厌客贫。\n千古穷愁终在我，百年傲骨强依人。\n临书绝爱来禽旧，对酒先怜射兽新。\n索处凄凉歌一曲，南中回首晚伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻警柬唐寅仲张仪仲何幼超曾人倩四子","author":"梁有谦","text":"干戈西北羽书通，词客忧时感慨同。\n鬓短懒窥秦女镜，力欹愁挽楚人弓。\n三都拟就年时外，五岳虚悬偃卧中。\n极海此身犹越鸟，九天翻翼愧胡鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀谭山人","author":"梁有谦","text":"慷慨徵君鬓已斑，谈仙虚拟驻春颜。\n大名不籍诸生起，两疏真轻一死还。\n未分此身非马革，曾提双剑出燕关。\n如今垂翅无侯骨，自戴黄冠老一山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄赠翟将军宇大西征 其一","author":"梁有谦","text":"十载辽阳战不分，天西兵气黯蛮云。\n凭君先度牂牁去，取次飞传露布文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄赠翟将军宇大西征 其二","author":"梁有谦","text":"短发萧萧鹖是冠，独将词赋老江干。\n停杯却忆西征路，一片青山战后寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白云洞","author":"梁有谦","text":"石室东悬瀑布西，阴崖清昼有鼯啼。\n嗟愁散发流觞后，自剔荒苔认旧题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"皇城燕","author":"李桂","text":"皇城燕，皇城燕。\n朝朝暮暮时相见。\n去年哺子白玉阶，今年落羽黄金殿。\n双双斜掠东风飞，不识春光几回换。\n天门十二去还来，香泥时涴龙盘砚。\n可怜鹦鹉解能言，十年不见昭阳面。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨白花","author":"李桂","text":"杨白花，花开白如雪。\n东风一夕入帘笼，摇荡春心度芳樾。\n御沟流水无回时，长条尚绾重门月。\n三十六宫离恨长，不随明月同圆缺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上","author":"李桂","text":"鲤鱼风起荻花秋，露压蒹葭水不流。\n何处津亭夜吹笛，白云溪月总关愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"览镜","author":"陈守一","text":"缘何愁绪剧，览镜鬓如斯。\n面目空相识，肝肠那得知。\n云霞怜幻影，松柏愧芳姿。\n独有天边月，清光似旧时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苍梧夜泊","author":"陈守一","text":"野旷依村宿，人稀狎鹭群。\n客心江上月，身世席边云。\n远寺疏钟到，孤城急漏分。\n舜峰在何处，访古恨空闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"旅夜","author":"陈守一","text":"谁怜漂泊客，江上忆归时。\n生事杯中过，愁容镜里知。\n凉风侵草阁，残月上花枝。\n寂寞何曾寐，空山听子规。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题何季玉香积厨","author":"陈守一","text":"居士解逃禅，行厨傍竹边。\n炉分煨芋火，窗泛煮茶烟。\n施鸟损残供，留僧结净缘。\n百年持此戒，终不忍烹鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过古将军墓","author":"陈守一","text":"宿草何年墓，残碑委路头。\n江风摧大树，萤火散空秋。\n有地藏蝼蚁，无人吊髑髅。\n早知身易朽，应不博封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋萤","author":"陈守一","text":"古槐深巷夕，明灭见萤飞。\n委化常依草，惊霜乍点扉。\n羞随蛾赴焰，幸借月同辉。\n便欲囊归去，閒窗伴下帷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早梅","author":"陈守一","text":"一枝初破蜡，几树尚含霜。\n片月增清影，微风损暗香。\n不愁羌笛怨，恰讶汉宫妆。\n未忍轻攀折，留看入梦长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送智上人还曹溪","author":"陈守一","text":"为忆曹溪路，飘然一锡还。\n云霞堪自老，生死不相关。\n地僻逢人少，岩虚伴月閒。\n无能解尘缚，瓶钵日追攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移居郊西喜社中诸子见过","author":"陈守一","text":"不能舍流俗，溷迹半丘林。\n宾客衣冠少，牛羊村巷深。\n采葵犹未熟，修竹渐成阴。\n一种清贫趣，留君话素心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送智海太空二上人入山","author":"陈守一","text":"丛桂秋山晚，思归忆鹿麋。\n来携方上友，去割世间悲。\n丈室孤峰远，弥天一苇移。\n风流惊二朗，禅藻胜诸师。\n水尽情方惬，山穷力未疲。\n袖藏唯贝叶，肩荷只藤枝。\n翠竹开三径，莲花礼六时。\n寒泉当户落，香饭隔松炊。\n凿沼时栽药，穿篱或折葵。\n他时同把臂，休讶入林迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送春 其一","author":"陈守一","text":"杜宇催残花更开，声声恰动掌中杯。\n眼看一树垂杨色，欲绾春光那得回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送春 其二","author":"陈守一","text":"柳畔花边醉复醒，乾坤消息不曾停。\n明朝莫道春归去，芳草窗前照旧青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"种柳","author":"陈守一","text":"细雨微风已弄丝，门前小憩和陶诗。\n黄莺亦解添幽兴，日午频来坐小枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄智上人","author":"陈守一","text":"旧社匡山兴颇深，往来幻迹日相寻。\n和光久矣无人识，遂却寒岩自老心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石室山居 其一","author":"陈守一","text":"朝闭松关晚放参，白云深处礼瞿昙。\n杖藜散步无人伴，独自归来月满庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石室山居 其二","author":"陈守一","text":"山阴道士木兰桡，载得松花酒一瓢。\n邀我绿荷深处饮，月明撑过彩虹桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石室山居 其三","author":"陈守一","text":"扫石岩头坐月明，啸吹横笛响秋清。\n一声散落千峰雾，惊起长空独鹤鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"豪士得倾城歌","author":"邝思诰","text":"一女不能庇，帝王浪得名。\n何如豪侠士，千载流芳声。\n千载谁人不重色，纷纷攘夺丛戈戟。\n绿珠含笑堕高楼，市上齐奴甘绝馘。\n谁知近代有林郎，英英结客少年场。\n押衙古生坐西席，茅山道士燕东厢。\n就中虞侯须鬓赤，锦鞯朱汗藏锋镝。\n飞星排闼入辕门，柳返章台完赵璧。\n柳色尚依依，林郎恋画眉。\n彩毫幻出弯弯叶，翠袖翻馀袅袅枝。\n翠袖弓鞋入高阁，邀朋纵酒成欢乐。\n堕珥遗簪不是淫，绝缨灭烛聊为谑。\n客散月初明，花间兴可乘。\n茉莉口含金掌露，葡萄乳浸玉壶冰。\n邂逅风流不易识，须眉莫向尘中觅。\n文君自许暂当垆，肯使相如终四壁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"促促曲仿李益体","author":"邝思诰","text":"促促何促促，停梭当户哭。\n敢怨萧郎游，空嗟汉武黩。\n寒侵塞上铁衣单，愁断闺中丝莫续。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"真娘墓仿白居易体","author":"邝思诰","text":"落红桃，生碧草。\n虎丘寺畔牛羊路，行人道是真娘墓。\n雨过花钿一径迷，风起松涛万壑凄。\n昔日真娘歌舞地，只今惟有杜鹃啼。\n杜鹃啼，声哽咽。\n冢中人，枝上血。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对酒吟仿崔国辅体","author":"邝思诰","text":"年年勤种秫，酿得山中酒千斛。\n醯鸡似解主人欢，先报罗浮春已熟。\n独醒千古未为长，朝生暮死谁言速。\n堪笑昂藏八尺躯，不及瓮头一微物。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮 其一","author":"邝思诰","text":"空斋悬暮景，脉脉向谁嗟。\n总为甘吾拙，非关用物奢。\n明霞供晚嚼，苦茗荐春芽。\n自顾囊羞涩，无钱向酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮 其二","author":"邝思诰","text":"人人营岁事，吾独任吾真。\n似犊儿堪爱，如泥妇不嗔。\n促襟时见肘，举甑欲生尘。\n咄咄何须怪，寻常士是贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迎至","author":"邝思诰","text":"阴尽阳将复，邀欢万国同。\n变音司乐府，添线试春宫。\n有意梅迎腊，如知柳待风。\n登台遥伫望，载笔纪年丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"彩花树","author":"邝思诰","text":"连夜开文杏，先春发艳桃。\n非关催羯鼓，多是剪并刀。\n蕊结蜂难入，枝摇燕误高。\n家家争彩胜，邀赏醉香醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日与克念翠岭上人游滴水岩","author":"邝思诰","text":"青骡遥忆白云乡，与客寻真路杳茫。\n玉舄漫留亭上迹，金函谁发石中藏。\n悬崖水滴千年薤，别涧蒲吹九节香。\n便欲乘风生羽翼，醉来空自笑秦王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠医士刘怀川","author":"邝思诰","text":"几年修炼谢尘寰，大事因缘出世间。\n自养黄芽居紫府，人栽红杏遍青山。\n济生何用肱三折，不死全凭药九还。\n我亦云中曾煮石，逢君同得驻朱颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蛙鼓","author":"邝思诰","text":"青草池塘是汝家，不辞风雨为催花。\n填填似振将军旅，点点如传县令衙。\n乐府自堪当两部，渔阳谁更会三挝。\n公私知尔成何事，镇日华林聒水涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食信宿何季玉舟中","author":"邝思诰","text":"坐爱濠梁夜不还，兴情多在水云间。\n节过寒食空惊眼，人对冰壶亦解颜。\n漫忆宫烟传往事，且看渔火起前湾。\n知机自得扁舟乐，何用藏名隐故山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日歌者月姬招饮舟中赋谢得招字","author":"邝思诰","text":"桃花洞口女郎招，块垒胸中一石浇。\n饭比胡麻传碧涧，浆如云液送蓝桥。\n波回日暖萦金缕，水调风轻度玉箫。\n自古英雄好相识，虬髯红拂事非遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雁字步顾太史韵 其一","author":"邝思诰","text":"忽睹云间开玉牒，似经禹穴发金函。\n轻烟染就缣犹湿，淡月书成蜡未缄。\n拟向先天寻画一，敢从尘俗学题凡。\n离离清影楼头过，少妇停针泪满衫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雁字步顾太史韵 其二","author":"邝思诰","text":"行行伦序第相挨，岂为冲寒肯暂乖。\n凤彩乍从天畔列，龙文时向日边排。\n载书云物年来异，点染秋空晚更佳。\n欲采芙蓉江上寄，美人曾否袖中怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日承惺堂曾年伯招同智上人张少益泛舟步季玉韵赋谢","author":"邝思诰","text":"蒲艾迎嘉节，葵榴向午天。\n感时堪赋赏，对景合流连。\n冻雨围山带，南潮没阪田。\n雄心随竞渡，雅意寄芳筵。\n畅矣湘灵瑟，兼之怀水仙。\n朱符驱虐暑，彩缕系长年。\n宝筏推先济，星轺讶早悬。\n非嫌朝市味，为忆越中鲜。\n勇退看回棹，临波叹逝川。\n岂因人解脱，不受俗牵缠。\n故旧论交谊，高僧结净缘。\n且听歌水调，莫问续骚篇。\n海色哉生月，江容晚簇烟。\n独醒吾岂敢，归兴共陶然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠歌妓","author":"邝思诰","text":"秋波频转意迟留，半是含娇半是羞。\n白苧裁成新按拍，几回夺得锦缠头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜曲 其一","author":"邝思诰","text":"春城此夕竞繁华，绮结金铺几万家。\n南市争看新火树，西园犹恐失桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜曲 其二","author":"邝思诰","text":"秃襟小袖紫罗鲜，结束龙阳解取怜。\n口嚼槟榔簪茉莉，月明花下戏鞦韆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜曲 其三","author":"邝思诰","text":"神羊观外张灯市，彩燕游龙百样妆。\n独有邻家新娶妇，寄钱人买两鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜曲 其四","author":"邝思诰","text":"紫姑箕转异香焚，邻女相期卜素心。\n几度含羞娇不语，指环笼袖拜深深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何季玉游罗浮 其一","author":"邝思诰","text":"闻道罗浮四百峰，吾生多病少行踪。\n君行到处须勤访，莫遣山灵笑懒慵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何季玉游罗浮 其二","author":"邝思诰","text":"为觅浮山竹叶符，青鞋布袜入仙都。\n朗吟足当灵符术，何事真形五岳图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何季玉游罗浮 其三","author":"邝思诰","text":"翠羽梅花梦不同，令人遥忆赵师雄。\n君今欲去缘何事，一醉前村酒肆中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何季玉游罗浮 其四","author":"邝思诰","text":"山外仙居接太微，铁桥中隔又疑非。\n行行拾得金光草，莫向桥西住不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渔父词","author":"邝思诰","text":"七尺长竿八尺丝，懒将香饵钓鲲鲕。\n夙盟象罔鸱夷侣，绿水青山是便宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病起答阿银校书","author":"邝思诰","text":"轻薄青楼浪得名，病来傲骨已全轻。\n齐盟不敢争牛耳，空愧虬髯号长兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古","author":"叶菁","text":"行宫落落碧山椒，往事茫茫玉辇遥。\n故垒风回残虎啸，荒祠雨过老龙朝。\n千秋精卫愁沧海，一曲湘灵泣洞萧。\n知是英魂长不散，倚篷休作楚人招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游厓山","author":"叶菁","text":"孤舟昔繫海门石，尘世俄惊十二年。\n白浪已空宋折戟，绿杨惟有蜀啼鹃。\n慈元殿古寒烟合，永福陵孤昃日悬。\n牧竖不知亡国恨，一声羌笛过南阡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湘江","author":"叶菁","text":"湘江周遭远近山，竹枝犹染昔时斑。\n红梅关外家千里，黄鹤楼前月一弯。\n客况那堪花落候，瓜期应待雁初还。\n渔人江上数声笛，却笑游踪尚未閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚泊兰清江","author":"叶菁","text":"九派江流荡远空，夕阳斜影在孤蓬。\n尽抛世事浮云外，犹忆家乡暮雨中。\n弱柳垂条生暖翠，落花飞片带残红。\n钟声忽起来何处，野寺前山一径通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访南宗故居","author":"叶菁","text":"水似曹溪碧一湾，诸山儿立古禅关。\n烟开兰畹入芳气，霜下枫林透醉颜。\n尘世几何逢胜迹，暮年赢得老僧閒。\n黄梅衣钵今犹在，谁遣菩提断宿攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":32629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]