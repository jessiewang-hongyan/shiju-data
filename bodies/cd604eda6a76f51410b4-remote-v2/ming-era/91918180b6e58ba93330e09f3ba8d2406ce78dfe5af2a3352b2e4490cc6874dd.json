[{"title":"醉过子与余魏二君在坐","author":"王世贞","text":"诸君促席未，吾醉只堪眠。\n稚子私相命，行杯竞欲前。\n虚堂启素月，流水待朱弦。\n㗳尔不能答，炯然心所怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中偶成 其一","author":"王世贞","text":"滴雨过深睡，浑迷午候长。\n宿鸦为暝色，收霓更斜阳。\n静得琴书理，明添竹树光。\n物情聊共适，吏事许相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中偶成 其二","author":"王世贞","text":"此际江南雨，粼粼起绿波。\n为农应更乐，罢耒即长歌。\n蚁竞煨尊汎，鱼誇受钓多。\n长安流潦甚，车马暮经过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得仲蔚所寄乱后诸诗有感","author":"王世贞","text":"避地乾坤小，愁身岁月遥。\n荣华酿兵革，丧乱饱渔樵。\n隐士紫芝曲，朝廷黄竹谣。\n异时真愧汝，薄禄总难消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中徙居承子与诗问即答 其一","author":"王世贞","text":"蛟龙不自制，驱雨遍神州。\n岂辨两仪色，争奔千穴流。\n吾谋惭垤蚁，世路薄巢鸠。\n赖有黄门咏，能消独客愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中徙居承子与诗问即答 其二","author":"王世贞","text":"炼石功难就，行云事颇真。\n桥如竞牛女，室已让鲛人。\n急难朋情见，流离客思新。\n江湖满天地，未敢问垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻警 其一","author":"王世贞","text":"羽檄中原旧，戈船下濑新。\n梦牵兵后信，心死战馀人。\n缓急俱时见，安危况老亲。\n飞扬诸侠少，或恐爱风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻警 其二","author":"王世贞","text":"寇盗方如猬，何时望息肩。\n风烟昏大海，战伐党高天。\n有信迷凶吉，无家总后先。\n不堪车马地，肉食共愁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻警 其三","author":"王世贞","text":"怕询开府使，秋鬓雪添无。\n母弟俱依越，妻孥尚隔吴。\n愁憎双眼在，拙弃一身孤。\n奋欲长缨请，终军竟弃繻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻警 其四","author":"王世贞","text":"闻道黄金募，新屯海上兵。\n败亡谁后殿，剽掠敢横行。\n战血鼋鼍集，愁魂鸟雀惊。\n欲归无寸土，何敢论浮生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻警 其五","author":"王世贞","text":"寇却馀皇上，师逢槜李伤。\n海波吹欲立，云日照俱苍。\n实恐游麋鹿，何言异虎狼。\n中原天渐小，吾计尚茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"询吴舍人病 其一","author":"王世贞","text":"汝但栖金马，声名未陆沉。\n宦情秋事薄，卧病白云深。\n自反三湘吊，弥坚百代心。\n高斋对玉轸，寥落为知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"询吴舍人病 其二","author":"王世贞","text":"懒朝初谢病，青草闭门长。\n去俗为齐语，矜人笑楚狂。\n寸心天未折，孤愤世频妨。\n浊酒如相命，和歌燕市傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐偶成 其一","author":"王世贞","text":"湖海频惊信，乾坤可置身。\n且谋今日酒，能保异时人。\n骨肉名空在，田庐迹已陈。\n急难双饱眼，未敢视经纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐偶成 其二","author":"王世贞","text":"塞垣摇白羽，京辇斗黄金。\n亲计难归拙，君恩畏转深。\n一生垂失路，万态总违心。\n仅有文章在，名山恐陆沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病答明卿 其一","author":"王世贞","text":"伏枕一身事，胡为相念深。\n此生须觅汝，终古在知音。\n地缓垂枯骨，天扶未展心。\n茫茫大鹏海，变化或难寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病答明卿 其二","author":"王世贞","text":"得汝怜贫惫，新诗慰藉多。\n病添仍药饵，身在且兵戈。\n拙信乾坤戏，狂堪日月多。\n无劳骇容鬓，吾已会高歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"于鳞赠梨酒","author":"王世贞","text":"香擅中山酒，甘分大谷梨。\n已非兹土易，况乃故人赍。\n雪压漕漕滴，霜雕颗颗齐。\n便须供老母，未敢及荆妻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"简茂秦","author":"王世贞","text":"旷荡长安陌，飘然一老翁。\n壮怀千古在，衰态众人同。\n衣食心难尽，干戈计未工。\n回车竟何适，勿哭世途穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送马挥使运饷还吴","author":"王世贞","text":"仲孺名家子，楼船转饷师。\n星霜过客传，天地老军麾。\n才自铜符发，恩凭玉剑知。\n汉功谁第一，不复数搴旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄子与 其一","author":"王世贞","text":"严城淹驻节，飞雪捲淮波。\n此地唯予先，新诗任汝多。\n论交失宇宙，把酒异山河。\n倘念高阳侣，春风掩户过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄子与 其二","author":"王世贞","text":"早晚辞桐柏，春来到霅无。\n万山青待汝，一雁迥愁吾。\n高步才难发，横行思转孤。\n仗谁消日月，为计亦江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"简余德甫","author":"王世贞","text":"胡为数请急，不受尚书期。\n药裹翻馀事，藜床扫为谁。\n壮心来折节，懒性失耽诗。\n我但携琴造，君无厌酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实 其一","author":"王世贞","text":"梁生不可作，吾道迥堪悲。\n吴市无双隐，函关失五噫。\n泪应枯德操，骨好傍要离。\n白日霾将黯，珠沈合浦时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实 其二","author":"王世贞","text":"但惜金兰远，宁知玉树摧。\n赋留中使问，魂逐大招来。\n浩荡心难掩，飘零业未灰。\n何劳验天意，白首世人才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实 其三","author":"王世贞","text":"翘首南荒外，孤云重黯然。\n所悲缘异地，谁谓不同天。\n簪绂辞贤路，文章损盛年。\n未须烦墨守，吾及见玄传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实 其四","author":"王世贞","text":"草色罗浮满，茫茫不可寻。\n乾坤闻笛赋，山水断弦心。\n大业中途阻，雄才半陆沉。\n呼儿检书札，读罢细沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实 其五","author":"王世贞","text":"客语骑鲸事，谁伤赋鵩篇。\n苍梧坠白日，大庾瘴高天。\n吾道有千古，斯人无百年。\n青门一抔土，寂寞定谁贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实 其六","author":"王世贞","text":"脩文应不薄，汝厌世途游。\n白马巨卿在，青萍季子酬。\n人间总长夜，岭表忽先秋。\n任识忘情语，纵横泪未收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实 其七","author":"王世贞","text":"欲草名山志，飘然沧海滨。\n诗篇难睹老，丹灶却添贫。\n已自乘元气，那能忆故人。\n暂飞辽海鹤，或恐是前身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实 其八","author":"王世贞","text":"白璧埋辉照，青云委路岐。\n斯文或后死，未老竟安之。\n敢任昌言续，无惭有道辞。\n令名兼寿考，今古总难期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实 其九","author":"王世贞","text":"当年太阿剑，拂拭有光辉。\n出狱果何意，延津还一飞。\n星辰元不没，河岳自相依。\n吾复怜雷令，人今识者稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实 其十","author":"王世贞","text":"西郭招提外，临溪一笑轻。\n诸天应有听，五子尚寻盟。\n震旦谁相启，恒沙汝独行。\n春云空尽日，驻马不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄于鳞 其一","author":"王世贞","text":"远树太行壮，乱流漳水深。\n风云来染翰，河岳映披襟。\n鞭弭中原约，车书异代心。\n并驱吾岂敢，或可效知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄于鳞 其二","author":"王世贞","text":"春日邢台上，独吟千古愁。\n鼓行人自失，磬折尔何求。\n宦恐诗名忌，才宁吏事收。\n西来书一纸，吾病欲全瘳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张职方谪判镇江 其一","author":"王世贞","text":"画室宵衣切，公车昼草频。\n论兵人自胜，飞捷事谁真。\n放逐容明主，艰危失大臣。\n还应伏波幕，书记礼崔骃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张职方谪判镇江 其二","author":"王世贞","text":"郡阁凭扬子，公馀试一临。\n江山百战色，南北异时心。\n敌恐矜天堑，谁当任陆沉。\n艰难根本地，相赠泪沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"止酒 其一","author":"王世贞","text":"物色何麇至，穷愁忽猬兴。\n此生甘磊磈，吾党让凭陵。\n天地骄相束，风云黯自仍。\n降心堪入社，绝口羡如渑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"止酒 其二","author":"王世贞","text":"岂不卑醒态，其如惜病何。\n衰颜渔父对，白眼酒人过。\n世事穷堪老，诗篇倚更多。\n春来空烂漫，吾计独蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竺上人六月闭关禅诵精进书此勉之 其一","author":"王世贞","text":"闻师初解夏，一钵与绳床。\n幡影白云静，钟声清昼长。\n霞餐有禅悦，水观生微凉。\n请看降心后，依然花草香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竺上人六月闭关禅诵精进书此勉之 其二","author":"王世贞","text":"维摩丈室外，苔藓自经旬。\n岂以薰脩业，能坚忍辱身。\n觅心不可得，缚汝竟何人。\n好去门前路，清溪涨色新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏游张氏山亭 其一","author":"王世贞","text":"岂必在丘壑，居然无俗尘。\n曲肱乌皮几，垫角白纶巾。\n万象各有媚，孤云愈见亲。\n野人骤得此，野性讵能驯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏游张氏山亭 其二","author":"王世贞","text":"丛林鸟雀傲，委巷渔樵通。\n回看一卷石，坐失千华嵩。\n藤萝行秋色，桧柏宿天风。\n投足岂在广，会心浩无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏游张氏山亭 其三","author":"王世贞","text":"微微动幽籁，簌簌涤广除。\n石梁属䆗窱，磴道藏威纡。\n觞飞竞谋速，饮至不愿馀。\n无烦具主礼，已自称吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏游张氏山亭 其四","author":"王世贞","text":"改席临幽壑，披襟当绝颠。\n苔钱乳窦嵌，云叶金波穿。\n伏虎蕴盘攫，脩鳞坼蜿蜒。\n箕踞一长啸，寒声千树传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏游张氏山亭 其五","author":"王世贞","text":"宴坐盘石上，澹然忘所归。\n片云逗松顶，隙月沾人衣。\n蠕蠕宿羽动，稍稍澄露微。\n尊酒欣有托，尘言晤来稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答寄子成佥事","author":"王世贞","text":"京洛时人地，蛮荒制府开。\n楚天看欲尽，朔雁去能来。\n间阔将成老，艰危未易才。\n中原稀瘴疠，兵甲暮堪哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复与诸君游张氏园 其一","author":"王世贞","text":"休沐时相过，犹言惜未频。\n风尘馀此地，山水更何人。\n高咏销兰烬，清辉掩桂轮。\n冰盘荐沈绿，不道故侯贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复与诸君游张氏园 其二","author":"王世贞","text":"散地容疏放，微名罢讨论。\n酒徒余渐老，诗道尔谁尊。\n抵掌回高睨，披襟就大言。\n狂来据盘石，星斗乱堪扪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复与诸君游张氏园 其三","author":"王世贞","text":"不必誇幽胜，唯应事事宜。\n秋阴生桧早，暝色赴花迟。\n侍立颜如玉，争论肉胜丝。\n君看广陵散，何异郢中词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复与诸君游张氏园 其四","author":"王世贞","text":"洗却侯家态，胡床仅薜萝。\n莺花吾暂主，鸡黍客贪过。\n雌霓飞梁挂，雄风岸帻多。\n寻幽更移席，兴到即为歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复与诸君游张氏园 其五","author":"王世贞","text":"烦暑辞高栋，严更起丽谯。\n坐寒云母障，词艳雪儿调。\n物性幽堪狎，时情短易消。\n祗言乘月散，策马曙光摇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大雨 其一","author":"王世贞","text":"曜灵避晴汉，丰隆鞭疾雷。\n鳌驱海水立，鹏击天风来。\n百卉竞含态，孤根虞见摧。\n为霖空自许，板荡世堪哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大雨 其二","author":"王世贞","text":"昨岁还兹日，燕京雨故多。\n纵横成陆海，簸荡决天河。\n日月终无恙，阴阳任自摩。\n未须疑号令，或为洗兵戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄曹云南","author":"王世贞","text":"封事人堪老，长沙席未前。\n试论骢马客，谁更碧鸡天。\n放逐君恩并，淹留国士偏。\n南滇六月息，待汝击风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中庭二红梅三月盛开赋此志感 其一","author":"王世贞","text":"三月梅仍发，聊争烂漫红。\n无能待霜暮，强起受春风。\n色恐群英妒，枝怜几日同。\n吾宁载尊酒，寂寞灞桥东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中庭二红梅三月盛开赋此志感 其二","author":"王世贞","text":"杜曲花俱艳，庭梅艳更新。\n人看等桃杏，汝自绝松筠。\n不语风前色，多愁雨后颦。\n那知山雪里，别有更精神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兴至","author":"王世贞","text":"兴至时拈句，狂吟意颇安。\n纵稀吾辈赏，不藉众人看。\n捲席千山暮，垂天列宿寒。\n茫茫远道思，徙倚坐凭阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄张宇清先生 其一","author":"王世贞","text":"闻汝苕溪社，乾坤与胜缘。\n云生屐齿路，春挂杖头钱。\n碧晕千山树，红妆万顷莲。\n探游更奇绝，未许世人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄张宇清先生 其二","author":"王世贞","text":"何地堪肥遁，斯人自不群。\n杯倾若下月，帆落洞庭云。\n煮石青精饭，临池白练裙。\n为郎未云贵，尺素许相闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张汝玉郎中移病归 其一","author":"王世贞","text":"送尔卢龙城，秋风葭菼鸣。\n仙曹谁玉树，御苑自金茎。\n彩鹢长河色，疏砧野戍声。\n东南一抹处，惨淡暮云横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张汝玉郎中移病归 其二","author":"王世贞","text":"秋霜枫叶酣，清泪一尊含。\n战鼓关山北，征帆日夜南。\n离情恨车马，归计入耕蚕。\n满目同愁病，迟归应自惭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日再游韦园仍用前韵 其一","author":"王世贞","text":"春事携尊尽，清溪倚杖看。\n山容薜荔古，水气桃花寒。\n仗饮扶馀醉，为欢别起端。\n如能念狂简，吾岂任簪冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日再游韦园仍用前韵 其二","author":"王世贞","text":"身世吾今醉，乾坤尔辈逢。\n褰裳采兰芷，奏曲起鱼龙。\n返照杯频得，浮烟阙自重。\n莫嗔归骑缓，花底爱行踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉后有感 其一","author":"王世贞","text":"春至偏宜醉，醉来心转长。\n看花那辨色，斗草不成芳。\n癖就终为懒，忧多转若狂。\n何时敛轻楫，随意钓沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉后有感 其二","author":"王世贞","text":"去日未云久，征途方畏难。\n客能骄白发，身转羡黄冠。\n雨雪愁边阻，关山战后看。\n殷勤仗一醉，莫放酒肠宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄答峻伯","author":"王世贞","text":"殷勤吴季子，尺素为予言。\n春水初平霅，兰舟直到门。\n星归豫章驾，人卧桃花源。\n独有新诗就，谁堪细讨论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"未明赴公署即事","author":"王世贞","text":"侵晓赴公署，聊将馀梦辞。\n马蹄破残月，松影战微飔。\n宿雾人语出，孤灯生事知。\n还袪在喧态，嗒尔寄遐思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中报国寺访张有功不遇","author":"王世贞","text":"垂鞭叩古寺，寒玉满层柯。\n疑是梅花发，其如冰雪何。\n美人旷孤馆，顾我重关河。\n忽有牟尼对，诸天离思多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病甚后见舍弟至","author":"王世贞","text":"病间吾逢弟，馀生汝得兄。\n乍惊衰后态，差识变馀声。\n黯淡杯仍却，踟蹰烛屡更。\n时时咎吾党，词笔太峥嵘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]