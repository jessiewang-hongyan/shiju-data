[{"title":"癸丑冬至泷上感怀","author":"邓云霄","text":"那堪行役日，正值闭关时。\n水落滩泷险，风高舟楫迟。\n谁添绣里线？\n空长鬓边丝。\n剥复无穷尽，浮生只自疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泷险","author":"邓云霄","text":"高流奔急峡，一转一回新。\n日夜闻风雨，艰危泣鬼神。\n水花舷上棹，泡影幻中身。\n行路难如此，年年有问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸丑季冬过黄州柴羽元方伯胡存蓼张玄中两宪副招游赤壁时江风不可以舟同酌苏祠台上得五首 其一","author":"邓云霄","text":"洪流吞绝壁，危堞挂长虹。\n一睹江山丽，方知词赋工。\n野烟低晚照，旧恨问东风。\n欲写前朝事，凭栏想像中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸丑季冬过黄州柴羽元方伯胡存蓼张玄中两宪副招游赤壁时江风不可以舟同酌苏祠台上得五首 其二","author":"邓云霄","text":"三分堪一笑，两赋足千秋。\n成败浑如梦，山川尚带愁。\n潮来疑战鼓，叶落想残舟。\n多少英雄泪，长江不尽流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸丑季冬过黄州柴羽元方伯胡存蓼张玄中两宪副招游赤壁时江风不可以舟同酌苏祠台上得五首 其三","author":"邓云霄","text":"昔人浮一叶，我辈上层台。\n斗酒兼鱼至，东山送月来。\n雄风催作赋，霜气避传杯。\n郢调今还几，因君问楚材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸丑季冬过黄州柴羽元方伯胡存蓼张玄中两宪副招游赤壁时江风不可以舟同酌苏祠台上得五首 其四","author":"邓云霄","text":"乘舟能犯斗，倚槛亦摩霄。\n道士如相遇，飞仙或可招。\n台高堪抱月，夜静忆吹箫。\n叹息词人去，江城倍寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸丑季冬过黄州柴羽元方伯胡存蓼张玄中两宪副招游赤壁时江风不可以舟同酌苏祠台上得五首 其五","author":"邓云霄","text":"一瞬成陈迹，乾坤大转轮。\n江山非属我，风月偶随人。\n乘兴骑孤鹤，毋劳吊逐臣。\n安知今夜客，不是德云身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游黄州赤壁有怀海内旧社诸子　二首 其一","author":"邓云霄","text":"笑倚千寻壁，还如醉客容。\n火攻推上将，笔战让词锋。\n往事台前水，离心江上峰。\n长怀集文彦，刻烛探骊龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游黄州赤壁有怀海内旧社诸子　二首 其二","author":"邓云霄","text":"汉水鸭头绿，临江兴倍长。\n丹枫寒映壁，白露暮为霜。\n对酒夜将半，美人天一方。\n无由寄征雁，明发指衡阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赤壁谒大苏祠问而吊之","author":"邓云霄","text":"妙高前日事，试问是耶非。\n便可呼金粟，何须梦羽衣。\n当时作赋去，几岁御风归。\n夜夜江灵泣，狂涛打石矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮过长安驿有感","author":"邓云霄","text":"长安无梦到，此驿号长安。\n不遇迷津苦，谁知望阙难。\n日随心共远，岁与鬓同残。\n更尽湖南路，群山拥汉官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮十六日大雪夜行衡山道中","author":"邓云霄","text":"残冬寒作阵，半夜远游身。\n雪坠花千片，云沉月一轮。\n问更呼驿吏，分酒劳舆人。\n茅屋多琼树，谁知村落贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲寅永郡元日","author":"邓云霄","text":"去岁还今岁，郴州又永州。\n乾坤元客舍，身世与云浮。\n薄宦好藏拙，携家且缓愁。\n年来心事澹，湘水共悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食雨","author":"邓云霄","text":"孤城细雨中，惆怅度佳节。\n禁火食犹寒，思乡心转热。\n花兼春共老，世与人相阅。\n何事不归来，官闲好藏拙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明又雨","author":"邓云霄","text":"层云暗远郊，骤雨打虚牖。\n无计护残花，何心簪弱柳。\n春游滞泥泞，旅况消杯酒。\n昨日酿葡萄，床头馀数斗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衙斋清旷独缺名花玺卿周元汀缮部屈钟湘各贻我牡丹一本喜赋","author":"邓云霄","text":"伤春无意绪，脉脉近花朝。\n佳客能相赠，花王不待招。\n纤腰垂绿袖，醉颊晕红潮。\n曲槛怜相并，江东大小乔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝午后忽晴坐含清阁","author":"邓云霄","text":"常疑天似漏，青帝懒司花。\n岂料喧灵鹊，还能转日车。\n芳菲明绿野，点缀倩红霞。\n最爱斜阳外，遥村四五家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午睡","author":"邓云霄","text":"莺慵燕又懒，春睡午偏浓。\n世事看双枕，仙方授五龙。\n香消金□□，帐冷水芙蓉。\n童子呼茶熟，斜阳已下舂。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悲长城","author":"邓云霄","text":"征夫三十万，总为筑城来。\n挥泪无乾土，舂声起旱雷。\n春闺人入梦，霜碛骨吹灰。\n万古长城下，愁云暗不开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏朝阁望","author":"邓云霄","text":"清晨登小阁，爽气似新秋。\n风静炉烟直，园深鸟语幽。\n楚山和雾睡，湘水夹霞流。\n望望芳洲外，遥怜不系舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"遥村","author":"邓云霄","text":"野水落田鸣，遥村雨后清。\n老农方敮耒，好鸟又催耕。\n饷馌甘藜藿，占年验晦晴。\n家山有黄犊，一轸故园情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暑雨新霁登阁眺望","author":"邓云霄","text":"霁望天如洗，山川一片新。\n清江遥影阁，凉气自侵人。\n火宅寰中地，冰壶世外身。\n晚来晞短发，华月更相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暑夜起坐","author":"邓云霄","text":"昼有北窗眠，宵还倚槛前。\n月凉天似水，城静漏如年。\n浴想黄姑渚，舟思太乙莲。\n徘徊惜清景，休促烛龙鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"看仆锄园灌蔬","author":"邓云霄","text":"簿领全休暇，科头傍竹林。\n犹存学圃意，颇异拔葵心。\n抱瓮看僮仆，忘机亦汉阴。\n挥锄谁不顾，瓦砾视黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暑坐咏怀","author":"邓云霄","text":"退食午多暇，偷安厌日长。\n小堂开绝巘，幽桂夹丛篁。\n湘簟铺寒玉，纱帷卷薄霜。\n南薰调一曲，吾欲贾馀凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"啖藕","author":"邓云霄","text":"虚堂爽气澄，嘉藕破炎蒸。\n忽听刀裁玉，翻疑夏造冰。\n甘香消渴吻，皎洁辟飞蝇。\n为报湘流女，毋劳唱采菱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲寅六月苦旱祈祷二首 其一","author":"邓云霄","text":"暗洒疮痍泪，悲歌云汉诗。\n那堪望霈候，已过濯枝时。\n永日烦巫祝，中宵验毕箕。\n潇湘通水府，无路问玄夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲寅六月苦旱祈祷二首 其二","author":"邓云霄","text":"旷宇云屯火，清江浪沸汤。\n苍生呼涸辙，赤帝转骄阳。\n金石将焦铄，风沙屡作狂。\n儿童纷拜舞，何不学商羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋书怀","author":"邓云霄","text":"一叶下梧梢，微凉入远郊。\n乡山梦里到，岁月客中抛。\n宦况秋偏淡，尘容镜代嘲。\n蒹葭迎早露，天末忆贫交。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小著","author":"邓云霄","text":"自笑儒兼吏，芸窗竹影中。\n雄心消跃马，幽兴寄雕虫。\n钴鉧潭前月，愚溪树里风。\n寂寥长对此，染翰当书空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"邓云霄","text":"庭梧凋一叶，忽到授衣时。\n懒妇未鸣杼，寒虫已络丝。\n城高霜信早，夜永漏声迟。\n旅况须沉醉，黄花满竹篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芝城甲寅除夕对表舅钱荆石守岁","author":"邓云霄","text":"剪烛酌深夜，山城寂不哗。\n冬春分岁色，梅柳竞年华。\n北斗频瞻阙，南云苦望家。\n愿持千日酒，得免二毛嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谷日立春喜晴","author":"邓云霄","text":"好鸟语高枝，东风转日迟。\n流年催白发，生菜妒青丝。\n岁色晴明里，农祥宴喜时。\n独怜新彩胜，不照故园卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归兴诗六首 其一","author":"邓云霄","text":"世路纷惊眼，瞿塘更孟门。\n缴还腰下组，归去谷中村。\n桂树堪招隐，桃花欲问源。\n从今三径草，不敢怨王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归兴诗六首 其二","author":"邓云霄","text":"龙性谁能降，鸥盟自可亲。\n好将湘上水，一洗马前尘。\n蕙帐眠山月，荷衣伴角巾。\n罗浮峰四百，猿鸟已迎人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归兴诗六首 其三","author":"邓云霄","text":"岂为疑蛇影，吾其料虎须。\n生来无媚骨，故态本狂奴。\n仙境多羊石，南溟胜镜湖。\n何妨携雨管，窗下著潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归兴诗六首 其四","author":"邓云霄","text":"故乡今已到，更有醉中乡。\n儿解腌蒲俎，妻能录酒方。\n朝朝九酝里，日日七贤旁。\n莫笑馀全懒，栽花雨后忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归兴诗六首 其五","author":"邓云霄","text":"一村如斗大，烟月颇无边。\n已创祝鸡栅，还开放鹤田。\n浦沙堪系艇，鱼鳖不论钱。\n直到归耕处，方知沮溺贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归兴诗六首 其六","author":"邓云霄","text":"竹园吾旧里，改号小柴桑。\n松菊径还在，壶觞日更长。\n云边闻吠犬，花下问渔郎。\n谁似清都客，惟留鹿鹤粮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽孝廉张无名二首 其一","author":"邓云霄","text":"衙署连床语，曾扳十日留。\n才回衡岳驾，忽作岱宗游。\n琪树标清骨，丛兰陨早秋。\n云中还载笔，知有玉为楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽孝廉张无名二首 其二","author":"邓云霄","text":"壮志一抔土，馀香侠骨存。\n平生好结客，今日几过门。\n赋鵩年华促，招魂怨思繁。\n巫阳不可问，风雨暗天阍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻尹禺阳下第愁病赋此代柬招过剧谈","author":"邓云霄","text":"易下刘蕡泪，秋思怯早凉。\n萧条怜病骨，烦恼问医王。\n雨过石坛净，风轻砌药香。\n高斋堪对语，烂醉是仙方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林坦之北上春官","author":"邓云霄","text":"鹪枝予偃息，鹏运子夷犹。\n执手肝肠热，扬帆江海秋。\n新花看上苑，旧榻冷南州。\n京贵如相问，人今理钓舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙卯季秋十九日周剑云尹和石周石林载酒集予天坐轩鼓吹乘潮访祁恒季绿水园招祁伊吾同酌弄月江上酣剧而返得二首 其一","author":"邓云霄","text":"主人元习静，酬对了清言。\n门恭俗尘远，琴书世业存。\n松风寒泛酒，江练澹浮轩。\n不是求羊辈，谁过蒋诩园？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙卯季秋十九日周剑云尹和石周石林载酒集予天坐轩鼓吹乘潮访祁恒季绿水园招祁伊吾同酌弄月江上酣剧而返得二首 其二","author":"邓云霄","text":"明月美清夜，金波拂棹流。\n风霜缠急管，天地肃高秋。\n向若醉还语，飞仙挟共游。\n玉绳低可缀，倩汝暂维舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送尹禺阳应贡北上三首 其一","author":"邓云霄","text":"百花迎马首，北上正乘春。\n京国游偏壮，琴书箧未贫。\n九霄瞻日月，寸管达枫宸。\n再献天人策，临轩下问频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送尹禺阳应贡北上三首 其二","author":"邓云霄","text":"长安在日下，有梦到春明。\n忽作临河别，遥悬恋阙情。\n逢时鹏路阔，玩世钓舟轻。\n燕市多朋好，因君一寄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送尹禺阳应贡北上三首 其三","author":"邓云霄","text":"亦曾叨里选，尚忆北游年。\n岂料予投劾，方看尔着鞭。\n乡心珠海月，旅况蓟门烟。\n可念离居者，归程在雁先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春晚","author":"邓云霄","text":"幽亭浮彩翠，宴坐只焚香。\n花静闻蜂语，人闲觉燕忙。\n世情这里淡，春日为谁长。\n疏懒元吾性，非关学列庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送沈青海归四明","author":"邓云霄","text":"四海知音少，三杯语别长。\n诗名推雁字，侠气动鱼肠。\n自笑烟霞懒，怜君客路忙。\n归舟花拥棹，好醉若耶旁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日积雨应季伟陈治甫周贵谔李伯修载酒过小斋池上酌赋","author":"邓云霄","text":"扫径愁冲雨，论文快聚星。\n门多载酒客，人愧草玄亭。\n护烛低垂幔，飞觞走建瓴。\n小池云雾里，疑有老龙听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋闺晓思","author":"邓云霄","text":"凉吹度深闺，窥窗片月低。\n征人三载别，思妇五更啼。\n积泪浮孤枕，繁霜叫晓鸡。\n寸心灰未冷，夜夜梦辽西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村中秋泛","author":"邓云霄","text":"积潦浩无际，人来狎钓翁。\n放船宜落日，破浪信长风。\n葭菼霜华外，村原水气中。\n转疑空阔处，或与五湖通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜池边坐月","author":"邓云霄","text":"静对秋宵月，弥清物外心。\n池光浮木榻，竹影扫瑶琴。\n钟罢千门寂，河低五夜深。\n候虫知节序，唧唧亦长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自笑","author":"邓云霄","text":"泉石元良友，巢由亦外臣。\n老因诗度日，闲以酒藏身。\n自笑狂非妄，谁怜懒是真？\n闭门尘事少，踪迹似逃秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王右仲过紫烟玩月周贵谔同酌","author":"邓云霄","text":"楼台延二妙，风月正双清。\n共坐红尘外，如邻白玉京。\n高谈吹爽籁，疏漏滴严城。\n借问沉眠者，宁知秉烛情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆鹤诗","author":"邓云霄","text":"悔将双羽客，博得一云屏。\n罨画摩寒玉，霜衣忆素翎。\n高楼中夜起，清唳隔林听。\n何事关人意，仙禽旧姓丁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月到床","author":"邓云霄","text":"四照轩棂敞，疏帷透月明。\n乍眠肌骨冷，永夜梦魂清。\n戏泛金波浴，如听玉杵鸣。\n谁云天路远，咫尺是瑶京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱漫兴次李烟客韵四首 其一","author":"邓云霄","text":"傲骨逢时拙，悬车四载馀。\n逍遥思化国，清寂得仙居。\n洞閟真人录，碑存太史书。\n翛然谐独往，高枕即吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱漫兴次李烟客韵四首 其二","author":"邓云霄","text":"潮生丹井满，折苇可为舟。\n欲识神仙意，还同江海鸥。\n未穷三岛路，权作五湖游。\n何处多灵草，吾先向祖洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱漫兴次李烟客韵四首 其三","author":"邓云霄","text":"独占郊原胜，平临水石分。\n岩含三秀草，门对十洲云。\n风静停幡影，人来混鹿群。\n只疑棋伴里，或有紫阳君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱漫兴次李烟客韵四首 其四","author":"邓云霄","text":"亭台询往事，相国旧行春。\n莲社推诗长，銮坡作帝宾。\n荣名终白首，澹泊是玄津。\n再检谪仙籍，天南近几人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊午清明旗峰踏青因忆客岁是日携常湘云赋春游篇往事东流共增感叹二首 其一","author":"邓云霄","text":"共有杖头钱，同鸣郭外鞭。\n平芜初歇雨，嫩绿远连天。\n游兴看簪柳，春声乍听鹃。\n桃花思往日，对酒一潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戊午清明旗峰踏青因忆客岁是日携常湘云赋春游篇往事东流共增感叹二首 其二","author":"邓云霄","text":"绿阴团翠幄，白袷染红霞。\n宴笑宜长日，从容数落花。\n行厨非宿火，洗碗试新茶。\n馀兴还酣畅，城南问酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飓","author":"邓云霄","text":"飓母挂残虹，飙轮战雨工。\n呼号万窍怒，箕荡四方风。\n急恐南溟覆，遥怜海舶空。\n招魂何处角，声咽黑云中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"团碧亭前两石池新成水藻鲦鱼颇供静玩","author":"邓云霄","text":"夹镜双池碧，花阴俯玩□。\n涟漪涵石丈，升斗贷波臣。\n濠濮阶前地，江湖世外身。\n何须七里濑，始可慰沉沦。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暑夜晓起","author":"邓云霄","text":"沧凉夜气清，侵晓坐虚亭。\n雾重花犹睡，风多鹤渐醒。\n六街尘已动，三径户还扃。\n莫怪人驰逐，羲和亦不停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]