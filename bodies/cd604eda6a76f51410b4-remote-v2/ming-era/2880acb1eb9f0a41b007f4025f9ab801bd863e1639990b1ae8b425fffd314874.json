[{"title":"三月初诣祖父母父母各墓所 其四","author":"林熙春","text":"金狮玉简锁棉洋，母氏栖神是故乡。\n天马当前鞍一轴，云龙数下诰三章。\n百年已竭和熊苦，今日方彰却鲊良。\n春暮不催风雨至，对扬甫毕见天浆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送揭阳何明府告归侍养 其一","author":"林熙春","text":"为问仙郎鼓玉琴，清时何事便抽簪。\n榕人莫遂攀留计，只为椿林岁月深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送揭阳何明府告归侍养 其二","author":"林熙春","text":"到处逢人口是碑，思莼且未及瓜期。\n高山流水赓馀韵，何武原垂去后思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送揭阳何明府告归侍养 其三","author":"林熙春","text":"三公一日是襟期，岭月随君樵水湄。\n珍重长途千万里，清华指日待拗螭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送惠来杨明府行取","author":"林熙春","text":"海上光芒羡湛卢，循声远播达皇都。\n一腔似水悬冰鉴，两袖拂云拥玉壶。\n花树有年曾集雉，柏林指日可栖乌。\n知君雅负澄清志，策马长安夹道呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感时诗","author":"林熙春","text":"瓦陈红荔与青梅，故俗于今若浪推。\n法酝必从吴浙至，珍羞每自海洋来。\n羊金饰服三秦宝，燕玉妆冠万里瑰。\n焉得棕裙还旧俗，堪羞大袖短头鞋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送如愚上人归五子山","author":"林熙春","text":"山开五子儗芙蓉，持钵南游三径松。\n贝叶声闻堪伏虎，莲花光现可降龙。\n汉仙一脉飞来锡，渔父多心叹转篷。\n五子曾能绳五祖，归从何处问真宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送尚玺曾九虚还朝","author":"林熙春","text":"绣衣奉使戏莱衣，万里趋朝四牡飞。\n路入西江迎老父，秋来明月映旌旂。\n堂中鹤发殷勤嘱，殿上龙颜咫尺依。\n况喜旧游呈玉玺，伫看新命拜金扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿张惺初","author":"林熙春","text":"四十馀年已续貂，相看华发老渔樵。\n弟兄弓挂虽逾月，次第筵开祇数朝。\n斗向秋中杓正转，月当朏后景偏矫。\n玉釭酒养千年柏，焉问步兵酒更饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿黄玉田","author":"林熙春","text":"龙门际会幸攀龙，况复桑蓬并挂弓。\n让我初秋宁谓弟，多君五日敢言兄。\n薇垣雅负东山望，枫陛常悬洛社风。\n数载萍分今始合，何妨尊酒醉花丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送孙匪莪之黔守安顺","author":"林熙春","text":"久擅天台仙吏名，宁从推毂祇专城。\n黔南烽炽思龚遂，阙北恩疏待士行。\n指顾山河劳借箸，亿千貔虎赖提衡。\n愿君努力宽宵旰，旦暮除凶奏凯平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贱辰何匪莪寄诗次韵奉谢","author":"林熙春","text":"揭阳焉望洛阳溪，白发从公两地齐。\n小阮翩翩光丈席，佳儿咄咄噪深闺。\n已誇著作名山重，更羡清恬御笔题。\n弧矢愧悬劳记忆，虬龙纸尾胜飞鹥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潮阳陈父母惠诗次韵奉答","author":"林熙春","text":"海滨何幸借玄綦，肝胆于今一旦披。\n骥足方驰云似锦，鸾音初奏羽为仪。\n已知吴水波馀润，益信棉城花更奇。\n召杜繇来推国士，青山千载慰襟期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送白守戎暂返雷阳","author":"林熙春","text":"海上波恬却有因，祇从白起是前身。\n旌旂闪烁龙蛇阵，号令风霆虎豹臣。\n数载枕戈方报主，一朝分袂转愁人。\n圣朝正切思贤将，愿斩单于更画麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送饶平邓父母守真安","author":"林熙春","text":"翩翩仙吏擅玄晖，太守除书自太微。\n清夜韩江传鳄徙，秋风蜀道见凫飞。\n辟莱千里须持斧，挟纩三军赖解衣。\n应远家猷君努力，肯遗宵旰恋慈闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋暑江上少憩","author":"林熙春","text":"虽云海外际昌辰，无柰炎蒸困此身。\n本为人嚣方匿影，讵期天怒转惊神。\n江中雷雨鱼龙跃，舟里啚书僮仆亲。\n即幸乾坤开霁色，可能旦夕不迷津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孝廉李咸池就先茔结倚云庐栽竹种黍为适余同长公登憩得近体二首 其一","author":"林熙春","text":"卜筑岩阿儗草庐，肯当清世浪居诸。\n白云深处思无限，绿水流时兴有馀。\n栽就苍筤供玉矢，培成和黍荐天厨。\n公车久识真人气，未许山中只著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孝廉李咸池就先茔结倚云庐栽竹种黍为适余同长公登憩得近体二首 其二","author":"林熙春","text":"凤皇山麓凤皇游，五色翩翩下扁舟。\n幸有林泉供笑语，更饶金玉助诗喉。\n相携双陇占佳气，独蹑高峰领上游。\n桥梓已胜燕市价，可能还忆醉乡侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上诞日","author":"林熙春","text":"秋江一苇凤栖岑，犬马逢希又五临。\n漫说今朝为挂矢，敢云三载已抽簪。\n时艰每切忧时虑，主圣常悬恋主心。\n子姓且随欢聚首，何妨发兴一杯斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"封孺人李母百岁挽诗","author":"林熙春","text":"五朝闺阃即瑶池，恩自神宗圣祖貤。\n住世百年甘少一，欲留馀庆与孙枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄养吾归临川","author":"林熙春","text":"星斗胸罗独抗颜，说忠说孝满人间。\n归欤杖履华山去，家问客从何处还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北山潘驿宰为年友潘雪松先生侄以忆祖母致政归喜赋五绝送之 其一","author":"林熙春","text":"曾于尚玺识前修，犹子东来试督邮。\n未及瓜期腾今誉，秋风一起便思刘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北山潘驿宰为年友潘雪松先生侄以忆祖母致政归喜赋五绝送之 其二","author":"林熙春","text":"不贪鸡肋动行吟，岭外犹存畏垒心。\n最羡监司标实录，棘中有桂铁中金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北山潘驿宰为年友潘雪松先生侄以忆祖母致政归喜赋五绝送之 其三","author":"林熙春","text":"五斗虽微亦主恩，那堪鹤发系慈孙。\n白云千里今朝合，不换三公慰倚门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北山潘驿宰为年友潘雪松先生侄以忆祖母致政归喜赋五绝送之 其四","author":"林熙春","text":"昔有劳臣羁北山，宁如今日北山还。\n多君也是投閒者，愧杀君房忙未閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北山潘驿宰为年友潘雪松先生侄以忆祖母致政归喜赋五绝送之 其五","author":"林熙春","text":"劳尔逢迎鬓未银，飘然拂袖岂知贫。\n谁云津吏无高致，林下于今见一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郡丞莫瑞明归楚省觐","author":"林熙春","text":"海上波恬赖指挥，相讶何事羡鲈肥。\n久知傲骨轻黄绶，暂向双眉戏綵衣。\n推毂即今称卓异，赐环指日下纶扉。\n虽然行李寒于水，赢得明珠掌上归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿伯兄肖翁双眉二十四韵","author":"林熙春","text":"乾坤何日不絪缊，惟有秋来清气淑。\n牛女相期岁一周，鹊桥为渡天河缩。\n此时会合喜融融，人间乞巧争驰逐。\n吾兄是日挂桑弧，共羡生庚为专禄。\n生当巧节性非巧，老而抑抑无边幅。\n忆昔少年食贫时，吾兄舌耕母顾复。\n有时兄耕予欲耕，吾兄惟劝予力读。\n比予子衿兄未休，即叨一第犹缩缩。\n尝入楚闽憩衙斋，每云无负古良牧。\n家食承欢也怡怡，路上逢人说恂穆。\n布素每经数十年，出入犹然减从仆。\n积寸累铢供国税，儿孙株守咸式谷。\n世态炎凉似险巇，不与雷同争转毂。\n屡宾乡射屡逡巡，郡邑得闻不得目。\n更有俭勤推嫂氏，祇今踰入犹操作。\n因之合室仰淳风，相师织衽为雍睦。\n诞辰家庆集称觞，堂上双眉馀百六。\n始知甘苦有乘除，苦尽甘来算不错。\n啬而必寿信有之，寿考繇来先五福。\n愧我徐行可勉持，愧我燕诒渐匪夙。\n阶前服食悦纷华，不似吾兄事悃愊。\n回思积德已百年，孝弟诗书为忠告。\n用是长歌不讳贫，返朴还醇绵世族。\n吾兄太朴今犹存，八千椿树为兄祝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁卯八月五色云见潮东南","author":"林熙春","text":"卿云五色现潮东，万里浮光想亦同。\n凤啸山河瞻翼凤，龙飞天地庆从龙。\n瑶华泛斗笼梧树，瑞气凝秋绕桂丛。\n已卜贤书应出类，定知廷对集群雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜潮秋捷","author":"林熙春","text":"婆娑姮女桂花庄，散与瀛洲满地香。\n天上宿星缠岭表，云台豪俊集潮阳。\n况逢双阙门楣峻，更有盈阶桃李芳。\n一自昌黎千载后，满江风雨见龙翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊辰元旦","author":"林熙春","text":"元年元日为春日，岁去岁来幸泰来。\n天自春阳开世运，人从泰道庆台莱。\n贞元复际三元历，献岁群称万岁杯。\n岭外老臣翘首望，明良千载咏康哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惺初约修褉事不赴","author":"林熙春","text":"永和遗迹渺难探，千载风流属太函。\n犬齿衡茅逢七七，龙飞日月际三三。\n友生有约期心赏，只尺何缘觌面谭。\n可是张华能醉客，逋仙笼鹤为辞酣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜潮春捷","author":"林熙春","text":"万里泥金捷似飞，瀛州十日快春闱。\n神龙御世新皇极，逸骏乘时拥帝畿。\n斗北七星还踰一，潮东间气最为奇。\n祥云正为人文兆，努力相期答衮衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"亦斋即事 其一","author":"林熙春","text":"吟哦斋里固斋哉，舟上吟哦是亦斋。\n月影浮摇帆影荡，风声遥动橹声谐。\n沙汀鸥鹭皆成趣，海峤烟尘也壮怀。\n更涉啚书为度日，此身不觉在天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"亦斋即事 其二","author":"林熙春","text":"亦斋本是涉川器，暂以琴书寄兴游。\n不羡帆樯多锦缆，宁甘飘泊一虚舟。\n编摹自觉忘鱼鸟，吟弄何妨问斗牛。\n况有考亭真迹在，忍教孟浪负前修。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侄元英远访回羊城诗以送之兼致勉私","author":"林熙春","text":"江天秋爽满瀛州，小阮回车作胜游。\n珠海光连金玉气，龙门路接凤凰洲。\n匣中干莫宁终闭，囊里琴书自有投。\n愿尔亢宗倍努力，无令鹤发叹淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠斗垣邓君归虔 其一","author":"林熙春","text":"曾入天台啖几桃，满天风雨任挥毫。\n高冈种得梧桐树，梧上于今有凤毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠斗垣邓君归虔 其二","author":"林熙春","text":"自许逃名隐画图，频年浪迹遍江湖。\n为予貌得皤皤发，一点灵台貌得乎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊辰十一月廿一日夜梦有令禁私宰余谓合家久不啖牛肉遂拈一诗诵其事睡觉只忆起语二句枕上足之辄成一律","author":"林熙春","text":"元良御极重群生，堂下栎椒恩亦并。\n郊社牺牲皆俎共，乾坤风雨一犁耕。\n虽然历世鞭箠苦，幸有明时爱护宏。\n自勘吾家原守戒，不忘梦寐续诗成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊辰除夕","author":"林熙春","text":"天假馀年逢七七，曾玄递抱发垂肩。\n虽邀汤饼堪频集，敢望箕裘得几传。\n偶以萑苻填岭海，顿今桑梓染风烟。\n即看宵遁宁人力，此夕何妨卧榻眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己巳元旦","author":"林熙春","text":"九五龙飞今逾岁，八千里外戴尧天。\n三更鼓角催新箓，此日融和胜旧年。\n颂启椒花归主圣，尊开柏叶集孙玄。\n自兹旦旦同声祝，天保南山寿不骞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上元雨","author":"林熙春","text":"元夕繇来星月辉，如何此夕转霏微。\n蛟游赤海犹翻浪，鸷伏青山未解围。\n天悯炎荒生雨露，人逢啬运吝珠玑。\n更阑霄汉俄开霁，歌舞踟蹰不忍归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"俊士初试竟日雨","author":"林熙春","text":"英雄始战听鸣钟，清夜闻雷兴转浓。\n笔下纵横云致雨，砚中变化雨乘风。\n终朝淅沥添吾趣，千载文章荡此胸。\n韩渚须臾传涨满，伫看鳄徙起蛟龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韶石谢公祖以三台荐晋宪长仍镇潮州七月廿一夜梦赋五言近体志喜醒只忆颈联二句枕上足之次早为开镇日也","author":"林熙春","text":"下车方数月，仗剑靖疆场。\n露布连三省，天章寄一方。\n劳君盟细柳，报主献长杨。\n此日辕门辟，苍生喜若狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大司马申玄渚远讯次韵奉答","author":"林熙春","text":"一从附骥羡空群，此日中枢典六军。\n系籍四朝耆硕重，铭勋两世古今闻。\n身承帝问欢如水，胆落天骄遁若云。\n宗社有灵悬带砺，相期翊戴圣明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与梧守谢荩衷二首 其一","author":"林熙春","text":"仙郎出跨五骅骝，百粤西来第一州。\n墨绶昔年歌召杜，黄堂此日快君侯。\n铁城表树山南峻，玉洞风云水北流。\n司马勋名君莫让，圣明综核重边筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与梧守谢荩衷二首 其二","author":"林熙春","text":"朱轮千里控名缰，十万熊罴待糗粮。\n茂畹芳兰骄桂岭，盈阶玉树焕梧阳。\n刑清无用尝鱼鳄，化洽偏宜集凤凰。\n旦暮飞凫朝魏阙，遥祈清望宴明光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟岳阳楼寄嘲黄鹤","author":"王应斗","text":"飞阁游仙事本奇，汉滨千载动群疑。\n徒传费老遗踪处，不见刘林堕羽时。\n芳草仍娇洲上碧，梅花谁放笛中枝。\n看君独壮矶头水，八百洞庭知未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟黄鹤荅嘲岳阳","author":"王应斗","text":"都将仙迹点江滨，云鹤休论幻与真。\n若道一飞成渺漠，也同三醉混风尘。\n伤心秋水湘娥怨，刺目君山太白嗔。\n纵是巴陵无限酒，几时能中独醒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟洞宾为二楼解嘲","author":"王应斗","text":"曾向蓬莱解剑装，孤飞爰指白云乡。\n洞庭巨浪连江汉，岳渚轻烟接武昌。\n月下总饶吟兴健，风前同引笛声扬。\n清光一抹无遐迩，莫听双楼说短长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑维公之任鄱阳","author":"王应斗","text":"解缆鄱江四十秋，孤云犹接水天浮。\n俄闻梓里飞仙旆，似摄芝岑入梦游。\n隔代子文无旧政，乘时潘岳有新猷。\n愁颜半为并州悴，几度怀人雪满头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日饮藻萃二男宅时新立门向口占落之 其一","author":"王应斗","text":"生事同鸠拙，贻谋任鹊安。\n地偏容膝好，天喜辟门宽。\n满道酣春色，长河助笔澜。\n面山名有取，紫诰矗云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日饮藻萃二男宅时新立门向口占落之 其二","author":"王应斗","text":"不但悠然见，南山巳在门。\n凭栏青满野，揽袖翠盈轩。\n弦管多生树，莺花尽侑樽。\n幽怀一以破，对户忆君恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上巳独酌","author":"王应斗","text":"不话开元事，奚论晋武年。\n水能依涧曲，觞复共谁传。\n闭户看修竹，微唫佐野弦。\n黄鹂偏逸兴，啼破柳花天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题邹氏盆景四绝 其一 盆松","author":"王应斗","text":"尺寸能含百丈姿，巉岩犹喜托根奇。\n堪知细叶迎风夜，不减孤涛绝顶时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题邹氏盆景四绝 其二 盆柏","author":"王应斗","text":"方盘如沼立苍宫，短劲凌霜阅岁寒。\n自是武侯祠畔种，半株子尺可同看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题邹氏盆景四绝 其三 盆竹","author":"王应斗","text":"霭霭云梢拂翠屏，笙簧日向此君听。\n石家枉□珊瑚胜，不及苍莨一尺青。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题邹氏盆景四绝 其四 盆梅","author":"王应斗","text":"瑶华低放小窗间，雪干冰枝不用攀。\n巳把数茎当庾岭，何须千本说孤山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汪中子任弋阳丞","author":"王应斗","text":"凤翥何妨借棘栖，西江治谱正堪携。\n清风两世遗芝峤，白发孤舟下葛溪。\n丞况可知廉似许，宦情犹信懒如嵇。\n蓝田自有徵书到，莫恋双松日品题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿陈石岸六十","author":"王应斗","text":"指数悬孤距十年，今来相次拥华颠。\n乘羊我欲充前导，控鹤君须著后鞭。\n嗜古日酣扬子宅，卧游时泛米家船。\n逋踪不羡安期隐，文酒逍遥是大仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬寅秋举光孙藻男出癸卯春举显孙萃男出缅思古人中兄弟接武者惟程伯淳正叔皆生楚地皆以壬癸年向二稚生庚之符也随口十六韵手示儿曹以志家庆即拟之非伦何伤焉","author":"王应斗","text":"昔予丁丑冬，一月举二子。\n节应嘉平初，相距越旬耳。\n是时计父年，四十四龄始。\n韶光忽以迈，予既七十矣。\n隙驹夫何常，人生一弹指。\n两儿并及壮，举子若相俟。\n去秋与今春，厥岁为壬癸。\n天叙两孙行，依次射蓬矢。\n老夫对之狂，挲摩溢私喜。\n缅怀千载上，竞述二程美。\n亦生壬癸年，历系森可纪。\n吁嗟黄口雏，敢与先贤拟。\n维兹岁干符，益应动仰止。\n兴发成孤吟，挥毫授侧理。\n异日捧遗章，庶几念前轨。\n古人泣祖砚，奋力著芳史。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮冬李剑华郡伯有事通城道经崇邑赋赠一首","author":"王应斗","text":"飘然仙驭出江城，点点卿云马首生。\n雪意朝凝车上色，梅花夜落笛中声。\n可知按部多鸾集，谁复凭山有兔营。\n独喜双旄风雨静，桃源鸡犬得无惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]