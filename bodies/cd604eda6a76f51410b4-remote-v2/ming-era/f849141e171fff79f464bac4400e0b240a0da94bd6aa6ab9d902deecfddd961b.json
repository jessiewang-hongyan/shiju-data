[{"title":"次同年赵侍御阻雨韵五首 其三","author":"薛瑄","text":"瑶树西风透客怀，早秋凉雨压尘埃。\n行台壁上留佳句，知是同年揽辔来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5163,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次同年赵侍御阻雨韵五首 其四","author":"薛瑄","text":"壁上留题见好怀，旋将征袖拂尘埃。\n浪游不得逢知己，阻雨今朝独后来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5164,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次同年赵侍御阻雨韵五首 其五","author":"薛瑄","text":"境入桃源喜满怀，分司衙里绝尘埃。\n绣衣壁上题诗日，正是随车好雨来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5165,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"桃源晓行","author":"薛瑄","text":"隔江烟树晓模糊，纵有丹青画不如。\n且喜桃源风景好，山行不厌路崎岖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5166,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿界亭驿","author":"薛瑄","text":"山月娟娟满户庭，秋虫唧唧四边鸣。\n一杯强饮不成乐，坐听山童打二更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5167,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"辰溪次赵子裕韵二首 其一","author":"薛瑄","text":"尽日山行不厌迟，肩舆随处爱秋溪。\n路回忽见江头县，风景清幽兴不迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5168,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"辰溪次赵子裕韵二首 其二","author":"薛瑄","text":"辰阳已觉雁书迟，满目云山接五溪。\n秋夜一杯江县酒，醒来乡思不曾迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5169,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"益阳山行遇雨","author":"薛瑄","text":"云林漠漠雨凄凄，节节危桥曲曲溪。\n可是青骢行处稳，满山红叶衬秋泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5170,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中度风门岭","author":"薛瑄","text":"肩舆千仞历峥嵘，朔雪寒云杳霭中。\n远近东西浑不辨，只疑犹未辟鸿濛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5171,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"靖州道中溪水清驶可爱","author":"薛瑄","text":"石淙急泻响奔雷，溅沫跳珠雪涌堆。\n正苦荒山劳降陟，且随流水共萦回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5172,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"池边笋生","author":"薛瑄","text":"绿锦池塘春已深，池边青笋欲成林。\n贪看物理添新趣，不管滔滔岁月侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5173,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"遣兴","author":"薛瑄","text":"永日霜台与众疏，相亲惟有圣贤书。\n绿云满院苍苔合，自喜能兼吏隐居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5174,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔阳春日杂咏六首 其一","author":"薛瑄","text":"满庭落叶似深秋，好鸟鸣时地转幽。\n坐对青山才咫尺，会登绝顶望中州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5175,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔阳春日杂咏六首 其二","author":"薛瑄","text":"风起杨花满院飞，翠屏门外送清辉。\n蛮中好景非吾土，春燕来时客未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5176,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔阳春日杂咏六首 其三","author":"薛瑄","text":"两年三度客黔滨，前是秋冬后是春。\n新绿满庭清昼永，好风时复送香尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5177,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔阳春日杂咏六首 其四","author":"薛瑄","text":"弱柳新梅荫户庭，好山门外列青屏。\n间关幽鸟鸣春昼，宛似家山把酒听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5178,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔阳春日杂咏六首 其五","author":"薛瑄","text":"睡起霜台似水清，晚春风日弄新晴。\n笑看蟢子频频集，却忆人家望客情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5179,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔阳春日杂咏六首 其六","author":"薛瑄","text":"驻节黔中改岁华，四山重叠绕天涯。\n空庭独坐听鸣鸟，拂面春风吹柳花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5180,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔阳山中十首 其一","author":"薛瑄","text":"景好宁知是异邦，竹篱茅舍枕沧江。\n吏情更有山林趣，绿树门前画戟双。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5181,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔阳山中十首 其二","author":"薛瑄","text":"星轺玉节万山深，到处溪流足茂林。\n雨过瘴烟清似洗，蛮荒不减壮游心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5182,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔阳山中十首 其三","author":"薛瑄","text":"尽日江行路不迷，沟塍水满稻秧齐。\n参天绿树茅茨小，何处人家叫午鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5183,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔阳山中十首 其四","author":"薛瑄","text":"山青云白楚天涯，驻节山中白昼迟。\n纵是无边清兴好，知音谁与和新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5184,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔阳山中十首 其五","author":"薛瑄","text":"江村地僻草萋萋，小阁閒登日欲西。\n风景不殊云木秀，只嫌中有鹧鸪啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5185,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔阳山中十首 其六","author":"薛瑄","text":"清和时节似中州，江绕茅堂尽日幽。\n官况不羁情散诞，坐看云影自悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5186,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔阳山中十首 其七","author":"薛瑄","text":"宦情不改读书情，閒爱山林兴致清。\n随意时时写佳句，却嫌行处有虚名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5187,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔阳山中十首 其八","author":"薛瑄","text":"竹椽茅屋江边静，永日惟应鸟雀飞。\n云白天青山万叠，霜台远客正思归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5188,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔阳山中十首 其九","author":"薛瑄","text":"花木时光总不穷，青山叠叠水重重。\n欲寻真宰元无迹，祗见苍苍一气功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5189,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黔阳山中十首 其十","author":"薛瑄","text":"草阁南风分外凉，看山面水据胡床。\n宦情萧散知何益，身在江湖忆帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5190,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"四月望夜院中作","author":"薛瑄","text":"月照芭蕉叶上明，小阑干外竹林清。\n一襟风露凉如洗，似有新秋在户庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5191,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对雨遣兴简陈侍御七首 其一","author":"薛瑄","text":"秋雨通宵尽日鸣，柏台双沼涨皆平。\n绿荷袅袅欹香柄，细看明珠泻未停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5192,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对雨遣兴简陈侍御七首 其二","author":"薛瑄","text":"曲阑干外芰荷香，秋雨来时水满塘。\n喜与同年骢马客，水心亭上共持觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5193,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对雨遣兴简陈侍御七首 其三","author":"薛瑄","text":"南荒久与故人疏，邂逅同年一月居。\n共指小塘荷叶底，水添秋雨欲生鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5194,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对雨遣兴简陈侍御七首 其四","author":"薛瑄","text":"同年持斧到南荒，笑指关山满路霜。\n一月沅州城里往，听风听雨喜连床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5195,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对雨遣兴简陈侍御七首 其五","author":"薛瑄","text":"君恰来时我欲归，沅江秋雨正霏霏。\n鹓班若问新消息，为说清霜满绣衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5196,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对雨遣兴简陈侍御七首 其六","author":"薛瑄","text":"绿萍如锦盖青池，池面高荷静不移。\n閒爱小亭听雨坐，恰如湘水系舟时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5197,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对雨遣兴简陈侍御七首 其七","author":"薛瑄","text":"同年喜有绣衣人，沅水相逢意气亲。\n我去君留莫惆怅，边氓快睹晓霜新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5198,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"襄阳雪中杂咏六首 其一","author":"薛瑄","text":"扁舟南渡汉江来，阻雪连朝住宪台。\n莫道铁冠官况冷，琼瑶庭下已成堆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5199,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"襄阳雪中杂咏六首 其二","author":"薛瑄","text":"乌台南面郡城高，城外诸山雪乱飘。\n胜迹欲追羊叔子，会从岘首踏琼瑶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5200,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"襄阳雪中杂咏六首 其三","author":"薛瑄","text":"空阶密雪下无声，叶落层层盖已平。\n尽日戟门清似水，端居谁与论诗情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5201,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"襄阳雪中杂咏六首 其四","author":"薛瑄","text":"堂台高敞四虚寒，窗外萧萧竹万竿。\n一夜霜风鸣到晓，散为清响满人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5202,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"襄阳雪中杂咏六首 其五","author":"薛瑄","text":"襄阳城外雪纷如，散入江流片片虚。\n乍有却无迷望眼，只疑神女弄明珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5203,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"襄阳雪中杂咏六首 其六","author":"薛瑄","text":"少年曾读浩然诗，襄汉风流百世师。\n今日雪中清兴好，论文翻恨不同时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5204,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"芭蕉","author":"薛瑄","text":"夫君本自一心空，舒卷如何叶未穷。\n自是根株通大化，故教有象显无踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5205,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"靖州月夜杂咏五首 其一","author":"薛瑄","text":"一节三年久在边，天威咫尺玉阶前。\n靖州城里清宵月，应与家山一样圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5206,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"靖州月夜杂咏五首 其二","author":"薛瑄","text":"参差林影受风斜，坚坐胡床爱月华。\n凉露在庭清似水，不知今夕是天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5207,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"靖州月夜杂咏五首 其三","author":"薛瑄","text":"城外清江城上楼，满城明月似深秋。\n忽思昌子虽痴小，也念阿爷尚远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5208,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"靖州月夜杂咏五首 其四","author":"薛瑄","text":"未有涓埃荅九天，漫叨官廪过年年。\n静思仕学多违性，搔首能无愧往贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5209,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"靖州月夜杂咏五首 其五","author":"薛瑄","text":"三百年来新郡邑，七千里外古蛮荒。\n无私好是中天月，布满清辉一样光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5210,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏夜闻钟","author":"薛瑄","text":"翠帷藤簟竹方床，孤枕慵便五夜凉。\n梦里不知身作客，忽疑钟响是家乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5211,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卢溪冬夜五首 其一","author":"薛瑄","text":"几度官船过武溪，匆匆都未有留题。\n今来驻节当寒夜，绛烛红炉兴不迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5212,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卢溪冬夜五首 其二","author":"薛瑄","text":"曲曲清江节节山，霜台分外朔风寒。\n寸心祗与梅争白，颇觉苍颜称铁冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5213,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卢溪冬夜五首 其三","author":"薛瑄","text":"江县萧条岁欲除，溪山寥落野人居。\n九重时复行宽令，使者徵求忍蠹渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5214,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卢溪冬夜五首 其四","author":"薛瑄","text":"夜深风雪响侵门，绣被熏来睡正温。\n忽念中林有樵者，独惭馀煖未能分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5215,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卢溪冬夜五首 其五","author":"薛瑄","text":"久客霜风入缊袍，壮心犹倚剑吹毛。\n武溪溪上乌台夜，猛虎一声山月高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5216,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重题五友五首 其一 竹","author":"薛瑄","text":"长日无风亦自清，疏篁况复满秋声。\n几回睡醒窗前月，疑是瑶阶佩玉鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5217,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重题五友五首 其二 兰","author":"薛瑄","text":"几载栽培雨露深，好风披拂正关心。\n瑶琴一曲凭谁写，惟有宣尼解此音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5218,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重题五友五首 其三 莲","author":"薛瑄","text":"朝来微雨湿胭脂，并倚新妆照绿池。\n莫使香尘涴颜色，深情还有正人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5219,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重题五友五首 其四 梅","author":"薛瑄","text":"花正开时节已过，祗留清影弄檐阿。\n潇湘千里客归去，想忆花时思更多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5220,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重题五友五首 其五 菊","author":"薛瑄","text":"未到高秋有别情，新丛簇簇傍阶生。\n归心不待花重发，留与新知作眼明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5221,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"董公二首 其一","author":"薛瑄","text":"席捲三秦赤帜东，力陈大义讨元凶。\n董公筹略应无敌，萧相虚当第一功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5222,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"董公二首 其二","author":"薛瑄","text":"纷纷豪杰欲兴刘，缟素应为第一筹。\n何事元功盟带砺，丹书不到董公侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5223,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又题五友五首 其一 竹","author":"薛瑄","text":"三年乌府长琅玕，粉箨新梢次第看。\n今日成林足风雨，坐听清响彻云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5224,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又题五友五首 其二 梅","author":"薛瑄","text":"红白双梅户外横，看花看叶兴俱清。\n今秋只恐归期近，重叠题诗寄别情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5225,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又题五友五首 其三 莲","author":"薛瑄","text":"镜里芙蓉一色开，高荷倚醉好风来。\n采芳谁识心如洗，持赠聊同驿使梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5226,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又题五友五首 其四 兰","author":"薛瑄","text":"几岁南州老铁冠，霜台底物可为欢。\n祗应九畹滋新种，时采幽香满把看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5227,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又题五友五首 其五 菊","author":"薛瑄","text":"簇簇新丛傍宪台，台端有客日徘徊。\n归期若在花前发，留向新知次第开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5228,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀沅州五友五首 其一 竹","author":"薛瑄","text":"劲节虚心独耐看，霜台三载伴清欢。\n今朝朔北遥相忆，谁与萧萧共岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5229,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀沅州五友五首 其二 梅","author":"薛瑄","text":"正是花时远别离，绮窗应已发新枝。\n蓟南腊月霜如雪，相对长吟有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5230,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀沅州五友五首 其三 菊","author":"薛瑄","text":"几簇芳根遍小台，自呼童子看浇培。\n沅江回首深如许，纵有清香亦自衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5231,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀沅州五友五首 其四 兰","author":"薛瑄","text":"频除恶草惜佳丛，笑采幽香岁岁同。\n一自沅江骚佩远，小阑谁倚看光风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5232,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀沅州五友五首 其五 莲","author":"薛瑄","text":"方塘红锦日熹微，绝爱天葩照客衣。\n几赋新诗去雕饰，相思重觉赏心违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5233,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又怀五友五首 其一 莲","author":"薛瑄","text":"谁识当年周茂叔，爱莲别是一般心。\n沅州宪府花如锦，回首蛮山万叠深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5234,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又怀五友五首 其二 菊","author":"薛瑄","text":"铁冠不受晚风寒，采得幽香静处看。\n幸自托根今得所，栽培应有露团团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5235,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又怀五友五首 其三 兰","author":"薛瑄","text":"九畹曾怀楚客骚，不堪沅澧去人遥。\n多情只有当时佩，别后清香尚未消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5236,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又怀五友五首 其四 梅","author":"薛瑄","text":"红白沅州有二梅，年年长是近春开。\n飘廊点砌今谁惜，祗有东风扫石苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5237,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又怀五友五首 其五 竹","author":"薛瑄","text":"柏台清绝爱疏茎，踏影攀枝绕砌行。\n卫水舟中风雪夜，梦回疑是打窗声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5238,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"博浪沙","author":"薛瑄","text":"大眼由来视独夫，恳怀忠义报凶渠。\n英谋已自输曹沫，只恨当时中副车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5239,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"院中杨柳","author":"薛瑄","text":"去日庭中始见栽，既成林后客归来。\n春风摆尽轻狂絮，留得清阴满宪台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":5240,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]