[{"title":"读陆民望墓铭","author":"邵宝","text":"爱君不能荐，深负百年知。\n吴越观风地，秦淮步月时。\n清脩堪立传，敦厚称为诗。\n读罢南沙诔，悽然泪欲垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿徐封官","author":"邵宝","text":"老拜封官命，归来发未皤。\n巷深尘事少，园小野情多。\n久视天终定，初生日又过。\n寿君无长语，击节远游歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐怀东庐子","author":"邵宝","text":"有客经梅里，东庐兴若何。\n万寻青壁远，一径绿阴多。\n白日羲皇梦，沧浪孺子歌。\n新凉且明月，下榻候相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"文玉咏吾石次韵荅之","author":"邵宝","text":"有物元如此，无材柰尔何。\n云高千仞小，山静一拳多。\n新刻磨崖字，遗声击磬歌。\n不须袍与笏，意到即相过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日怀史敏甫","author":"邵宝","text":"灯夕何须卜，阴晴月在天。\n怀君将缩地，别我又经年。\n泾上晚独立，梅花春可怜。\n惠然如在即，重咏惠山泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慰秦国英哭子","author":"邵宝","text":"哭子情无极，慰君伤我心。\n幽魂青嶂远，老泪碧潭深。\n麟趾空占梦，椿庭正惜阴。\n荒亭重延伫，天道竟难寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿知微山房","author":"邵宝","text":"一宿山中寺，王郎两月情。\n榻云春坐煖，窗月夜看晴。\n茗供新分水，钟声远隔城。\n知微请题画，政及我诗成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发文正公吊书后有作 其一","author":"邵宝","text":"子在心常北，吾归道未南。\n书从春后绝，恸岂病馀堪。\n诗兴江山老，忧怀岁月酣。\n百年函杖地，犹许梦中参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发文正公吊书后有作 其二","author":"邵宝","text":"平生一瓣香，今日托人将。\n鸿雁南来少，风尘北望长。\n回天曾有笔，济海竟无航。\n留得遗文在，星辰夜夜光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发文正公吊书后有作 其三","author":"邵宝","text":"漫识金山酒，公因赏识人。\n忧为天下地，笑返雪中春。\n山色言增重，泉评意出新。\n北行人渐远，愁见水粼粼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卢侍御师邵言文正公除夕之梦","author":"邵宝","text":"梦里题诗处，悠悠万古心。\n凤衰吴岳远，竹老楚江深。\n南极星方照，西涯月竟沈。\n绣衣能语我，歌苦不成音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻钱伯川讣","author":"邵宝","text":"伯川俄大病，哀甚哭无辞。\n未毕慈亲养，空勤圣主期。\n湖山春正尔，风雨夜何其。\n更忆新亭上，高文记两知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中写野景","author":"邵宝","text":"雪应初春少，龙分昨夜灵。\n瀑长疑落汉，槎远欲浮星。\n沙鸟兼云白，风萍泊岸青。\n渔船投酒市，吹笛过前汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨霁和文玉 其一","author":"邵宝","text":"雨霁诗初至，朝来鹊有灵。\n老农频望岁，野史亦占星。\n风水萦新碧，云天露少青。\n五湖堪一望，高阁瞰鸥汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨霁和文玉 其二","author":"邵宝","text":"霁景还天道，吾诗亦性灵。\n槛浮少陵水，堂倚太邱星。\n城日低仍白，村烟远更青。\n客愁殊未已，云隐隔溪汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨霁和文玉 其三","author":"邵宝","text":"连日愁多雨，还谁歌雨灵。\n已看船入市，安用驾冲星。\n葵掩庭中赤，蒲添石上青。\n何时步新月，策杖过沙汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王同知之处州","author":"邵宝","text":"伊昔曾游地，今还送故人。\n舟横吴浦晚，驾转丽阳春。\n山静南无粤，星明北有辰。\n不须论展骥，天子重臣邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨学正之安陆","author":"邵宝","text":"老臆吞云梦，于今在眼中。\n楚材元有望，湖教故多功。\n山色连平野，江流入半空。\n谁为三鳣颂，夫子又关东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送伍御史汝真之广东","author":"邵宝","text":"煌煌岭南节，迤逦过江东。\n岁月驰驱里，山川感慨中。\n有天还北斗，何草不秋风。\n如见王宜学，相思道病翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与王子春夜坐","author":"邵宝","text":"君来下我榻，大热得清风。\n夜色高低树，秋声远近蛩。\n诗曾惊鹤老，数已动枫翁。\n万卷吾堂在，烦君校异同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湛空为僧作","author":"邵宝","text":"京尘如海水，明眼本来空。\n折苇流沙北，扶桑断石东。\n百年无梦后，万象不言中。\n瓜步还西上，庐山问远公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐有怀浦文玉","author":"邵宝","text":"哭子身仍病，怀君我亦伤。\n江湖秋欲老，风雨夜初长。\n鹤梦芜汀远，蛩声草砌凉。\n兼葭空独赋，愁寂不成章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄薛石泉","author":"邵宝","text":"此叟何如者，山中有石泉。\n润生晴谷雨，光动夜潭天。\n鉴影空坡老，题名重羽仙。\n岁寒吾道在，须记定交年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月一日同诸友行山中 其一","author":"邵宝","text":"晚秋逢霁景，山寺恣幽寻。\n霜树丹犹浅，寒潭碧正深。\n竹垆鸿渐茗，松榻颖师琴。\n亭上还高眺，悠然万古心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月一日同诸友行山中 其二","author":"邵宝","text":"龙阜秋云外，微茫径可寻。\n鸥情沧渚远，松影白云深。\n风逼重阳帽，泉流太古琴。\n草亭春色远，犹是浴沂心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为潘复轩题画","author":"邵宝","text":"两山藏古寺，一道泻清泉。\n老衲偏知路，高松不计年。\n桥通采蘋涧，林起煮茶烟。\n更爱王中舍，长谣庐岳篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海洲菊花庄小燕","author":"邵宝","text":"黄花方对酒，有客复鸣琴。\n此老归来兴，今吾病起心。\n落英曾物色，疏越自声音。\n久熟江头路，桥东更可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汪司成器之燕二泉精舍器之为予作精舍记先是三日寄至","author":"邵宝","text":"一杯山馆酒，十载岁寒心。\n病起怀君切，文成望我深。\n江湖方远历，丘壑且幽寻。\n已办题名石，公来始自今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕感怀","author":"邵宝","text":"病后逢除夕，灯前感壮心。\n梅花万古色，云树一庭阴。\n客去仍悬榻，歌成复听琴。\n蘧瑗思寡过，千载有知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送秦国瞻赴应天判","author":"邵宝","text":"南国今丰镐，东郊旧毕陈。\n保釐资一德，相恊赖诸臣。\n城险瞻维石，江深渡有津。\n谒陵真对越，适野极咨询。\n汉史闻书凤，周风想赋麟。\n转输民力竭，湔涤圣恩新。\n牧苑曾归地，乘舆亦济人。\n羽仪看筮渐，棠憩听歌豳。\n日月光偏近，山川气孔神。\n吾贤应妙简，尹伯况同寅。\n此日栖鸾地，他年燕鹿宾。\n省台虚席在，珍重报君身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题余立夫扇次企斋","author":"邵宝","text":"乞得尘途未老閒，却因多病负看山。\n春来拟作吟诗社，一月同君十往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次见素翁送子 其一","author":"邵宝","text":"雪馀诗到病夫惊，素老丰姿纸上盈。\n笑折梅花伴孤咏，海风吹月不胜清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次见素翁送子 其二","author":"邵宝","text":"爱才成癖谓公偏，吐握曾闻古下贤。\n嗟我怀人无所报，一罂将汲惠山泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次见素翁送子 其三","author":"邵宝","text":"劝驾南来雪满山，到吴先慰病中閒。\n而翁爱我时飞劄，更有清言在梦间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次见素翁送子 其四","author":"邵宝","text":"庭训看来字字真，老于吟咏转精神。\n沧洲吾道平生语，不道苍生望在身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次见素翁送子 其五","author":"邵宝","text":"策名方际风云会，问道须从水陆宜。\n山下出泉庭训在，百回千折定东之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次见素翁送子 其六","author":"邵宝","text":"久矣闻君一见之，雪消东渚晚舟移。\n百年家学重敷对，臣子孤忠天地知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次见素翁送子 其七","author":"邵宝","text":"用世无能且病身，却劳长者寄书频。\n慈闱春酒堪时献，岁有山田亦未贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕知微馈泉先是有怀因附之","author":"邵宝","text":"两罂泉水一童来，向日茅堂午正开。\n谩谓清风无可报，雪中诗为寄僧裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"睡起偶书 其一","author":"邵宝","text":"虚堂午热睡不得，听客高吟公甫诗。\n诗当好处却恐睡，正是隔帘风动时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"睡起偶书 其二","author":"邵宝","text":"人言心静不愁热，凉风不来凉意来。\n从今夜夜有月色，更爱草堂南向开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日奉次涯翁老师 其一","author":"邵宝","text":"独坐心情病后长，已教童子任耕桑。\n采新时为高堂献，西自山乡东水乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日奉次涯翁老师 其二","author":"邵宝","text":"一枕羲皇午梦长，有诗不敢和柴桑。\n燕山青绕今京洛，却指程门望帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为华文远题画次顾东江","author":"邵宝","text":"松枝落落骨栾栾，风动寒泉更好看。\n湖上幽居故相近，他年曾此赋斯干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即席题扇","author":"邵宝","text":"同向山中试茗来，松风高阁倚崔嵬。\n兴酣别院寻僧去，却爱幽花满路开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扑蝶图","author":"邵宝","text":"花雨初晴日正东，游虫各自领春风。\n狂童不识庄生意，漫把閒情逐梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题竹送李司训","author":"邵宝","text":"送客将归歌复歌，诸生攀挽欲如何。\n竹枝把作松枝赠，岁晚相看思更多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灯市追和钱希翁","author":"邵宝","text":"独向三桥静处行，松棚落落带春星。\n城中月是山中月，一有灯光分外清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为葛元兆题扇","author":"邵宝","text":"青藜为杖葛为巾，采采山中百草春。\n歌罢紫芝还自和，九峰残日未逢人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴心远惠新茗重以盆蕙走笔谢之","author":"邵宝","text":"题书正为山翁问，忽报山翁使者来。\n坐有香风起何处，山中花在盎中开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏荅许东庐 其一","author":"邵宝","text":"春晚天涯有所思，诗来刚值落花时。\n青青竹笋真如玉，珍重还教棘护篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏荅许东庐 其二","author":"邵宝","text":"主人心远客来稀，剥啄声知是也非。\n问讯何如还道甫，数行书与一童归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏夜足成春日之句","author":"邵宝","text":"春风门巷冉泾西，兴到新诗漫自题。\n鹏翼顺风沧海梦，桃花流水碧山栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"棕蒲 其一","author":"邵宝","text":"棕榈根老久应捐，漫托昌阳为引年。\n露下高天秋涧冷，山中人作水中仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"棕蒲 其二","author":"邵宝","text":"棕本栽蒲故有之，水边石畔斗新奇。\n相逢若问通仙否，直待形容变尽时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再韵 其一","author":"邵宝","text":"老朽判为世所捐，定交今喜得青年。\n清泉白石非君事，行作蓬莱顶上仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再韵 其二","author":"邵宝","text":"蓬莱路远未能之，水上枯槎也自奇。\n剑佩森森人似玉，群仙初谒太清时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次南沙谢菜","author":"邵宝","text":"敢誇异种出云南，老圃新畦也自堪。\n击节有谁知此味，介君能辣白能甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠周含山","author":"邵宝","text":"五年佐邑平如水，更有馀功及我泉。\n何地含山君莫问，两般疆宇一般天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉次涯翁先生写真 其一","author":"邵宝","text":"万古勋名百岁身，古人风采在今人。\n丹青纵有如神笔，难写胸中一点春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":46770,