[{"title":"五亩园十八题为姚举人作 其十 放鹤坡","author":"徐庸","text":"放去逾三岛，归来下九天。\n绿坡春草细，彷佛似青田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五亩园十八题为姚举人作 其十一 一角轩","author":"徐庸","text":"轩居只数椽，一角横池水。\n城中车马尘，那得来窗几。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五亩园十八题为姚举人作 其十二 环堵室","author":"徐庸","text":"萧萧环堵室，绝似野人居。\n作此藏脩□，晨昏称读书。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五亩园十八题为姚举人作 其十三 洗砚池","author":"徐庸","text":"片石□清流，光生即墨侯。\n临池今有兴，正好试银钩。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五亩园十八题为姚举人作 其十四 围棋墅","author":"徐庸","text":"小墅列楸枰，铮铮落子声。\n多君无敌手，曾点得先名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五亩园十八题为姚举人作 其十五 竹下厨","author":"徐庸","text":"竹下开庖所，延宾得所宜。\n寻鸡供黍馔，不使负幽期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五亩园十八题为姚举人作 其十六 梅边屋","author":"徐庸","text":"满室暗香浮，梅边列经史。\n调羹自有时，待结枝头子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五亩园十八题为姚举人作 其十七 玩月台","author":"徐庸","text":"玉露滴广庭，登台玩明月。\n白凤忽飞来，脩□夜翻雪。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五亩园十八题为姚举人作 其十八 横琴室","author":"徐庸","text":"三尺云根石，七弦焦尾琴。\n清风生指下，弹出古人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪霁登钤山","author":"严嵩","text":"千峰积瑶素，寰宇映空明。\n仙人好赤脚，独蹑层冰行。\n叠石疑琼岛，高楼思玉京。\n劲风仍振木，朗月已辉城。\n永夜山中宿，山泉松涧鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登郡城南楼见仰山迟游侣","author":"严嵩","text":"楼压春城迥，山连晓雾寒。\n身高百林上，兴绕一峰端。\n盘踞开雄镇，登临耸钜观。\n所欢犹未至，惆怅凭栏干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"览游大仰山宿东溪方丈二首 其一","author":"严嵩","text":"夙驾踰城廓，决策戒行游。\n良朋欣屡集，积潦况初收。\n鸣鸟盈芳甸，嘉树蔽层丘。\n览籍眷名迹，兹焉获所求。\n披榛陟危磴，拂石漱寒流。\n暝投东溪宿，密竹僧庐幽。\n松岭露微月，苍苍烟露浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"览游大仰山宿东溪方丈二首 其二","author":"严嵩","text":"城中望灵山，缥缈隔云雾。\n沿回至山麓，山形始呈露。\n大仰摩青穹，鸟道不可度。\n邓仙与木平，隐若森拱护。\n岚烟迷近远，明霭变朝暮。\n伊余猿鹤姿，探赏惬幽愫。\n岩峦纷合沓，一步屡回顾。\n徘徊青莲宇，延伫古松路。\n缘葛或褰崖，飞泉亦当户。\n永念区中人，畴能息尘务。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仰山置酒","author":"严嵩","text":"春游入古寺，息驾在山阿。\n不饮杯中物，其如山色何。\n泉声间钟磬，草色上烟萝。\n向夕岚霏起，诸峰猿啸多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大仰寺","author":"严嵩","text":"珠林胜境隔人寰，古树高花隐石关。\n流水声中一犬吠，白云深处数僧閒。\n龙潭路黑烟常覆，螭首碑荒字已斑。\n明日驱车入城去，却从尘里望山间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仰山寻郑谷书堂","author":"严嵩","text":"遗墟那复辩，岩石但苍莽。\n遐想嘉遁年，云霞结真想。\n馀辉贲草木，秀句在穹壤。\n泠泠韶濩音，千秋宁绝响。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒古庙二首 其一","author":"严嵩","text":"缘回数里道，盘互百重山。\n攀林兴不极，沿流趣自閒。\n云度肩舆里，花明丛竹间。\n神宫藏阒寂，龙井锁潺湲。\n时见林中侣，相携采蕨还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒古庙二首 其二","author":"严嵩","text":"兹山饶灵异，古庙极巍崇。\n下有千尺漂，深黑蟠蛟龙。\n兴云雨暵岁，阖境歌神功。\n神功既莫测，民祀当无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出仰山","author":"严嵩","text":"逶迤遵石磴，怅望别云松。\n老僧不出户，斋阁自鸣钟。\n钟声在山间，客子出山去。\n细雨湿春衣，新寒入高树。\n此中风景断尘凡，回看翠壑锁烟岚。\n刘郎不记来时路，千树桃花隔水南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过长陂","author":"严嵩","text":"长陂鸟鸣初日暄，游子度岭穷攀援。\n行寻歇马访新庙，望近蟠龙识古村。\n春深尚喜林花盛，雨后忽惊溪水浑。\n野老相邀具鸡黍，解鞍时复过柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阻雨不得登蟠龙","author":"严嵩","text":"溪上风雨来，飒飒篁竹乱。\n油云翳层峰，对面隔霄汉。\n鸟道纡百盘，龙门在天半。\n佳期恨缅邈，寒望增凄断。\n下马憩林居，一顾屡长叹。\n自无飞仙术，安得凌绝观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"途中晴","author":"严嵩","text":"山游苦奔峭，会意乐有馀。\n大仰寻真隐，蟠龙回我车。\n湿云收绝壁，高柳媚清渠。\n陂岸生新水，期来坐钓鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蒙山石门梁孟敬先生隐处","author":"严嵩","text":"东蒙擅奇秀，万仞削苍壁。\n阴崖閟浮云，旸谷曜初日。\n遥思石门叟，长歌倚岩室。\n岁远迹已陈，春草绿如积。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泛舟","author":"严嵩","text":"泛舟无俗情，水送复山迎。\n江色迷朝霭，松阴转午晴。\n稳依危石缆，深傍绿芜行。\n吾已忘机事，沙鸥莫漫惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钤阁对雨","author":"严嵩","text":"白雾涌岩扉，回飙吹客衣。\n万松鸣雨急，孤阁到人稀。\n眺迥迷前浦，凭高失翠微。\n惜春今已晚，虚负采山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钟山游眺","author":"严嵩","text":"可怜春岸飞鸥鸟，又见春山长薜萝。\n峰势插江溪路小，峡门横石水声多。\n平沙觅句看云立，极浦回舟载酒过。\n见说此溪多钓伴，月明来听扣舷歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钤阁秋集","author":"严嵩","text":"钤冈高楼足大观，况逢晴日倚栏干。\n竹林啼鸟关幽事，石磴松风生昼寒。\n病身自喜逢秋健，携手聊寻尽日欢。\n万事浮生空役役，拟从山客借蒲团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登宜春喜","author":"严嵩","text":"沙清江练绕城回，霜净花枝拂槛开。\n山阁昼閒宜对酒，病身秋尽始登台。\n潇湘木落闻猿啸，彭蠡云长见雁来。\n郡僻渔樵堪卜隐，时危戎马转兴哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东溪晴泛","author":"严嵩","text":"钟峡出秀浦，碧潭无限清。\n日浮江色动，舟蹴浪花轻。\n盘石思垂钓，沧浪爱濯缨。\n沿洄意未极，川暝月华明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江皋","author":"严嵩","text":"岩溜漰渀雨，风松淅沥涛。\n远峰晴木暗，清夏暑云高。\n问节菖蒲近，观农稼穑劳。\n微吟未归去，落日照江皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊行","author":"严嵩","text":"沙路平如掌，郊行吟望赊。\n山围四野碧，河抱一村斜。\n松径入僧寺，草屋见渔家。\n春风几日到，村园桃李花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洞灵观","author":"严嵩","text":"玉女已仙去，仙丘尚此中。\n龙吟山洞雨，鹤舞石坛风。\n异代流传久，浮生梦觉同。\n还寻炼丹处，云水夕阳空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东堂新成 其二","author":"严嵩","text":"无端世路绕羊肠，偶以疏慵得自藏。\n种竹旋添驯鹤径，买山聊起读书堂。\n开窗古木萧萧籁，隐几寒花寂寂香。\n莫笑野人生计少，濯缨随处有沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赐告","author":"严嵩","text":"春去复秋至，愁多与病连。\n屏居臣分浅，赐告圣恩偏。\n阙望长回首，岩栖不记年。\n时闻起桴鼓，未暇枕书眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晨起","author":"严嵩","text":"枕畔闻啼鸟，觉来春思閒。\n行药过石壁，倚槛望云山。\n馆阁缪通籍，林园深闭关。\n殷勤谢知旧，频遣惜朱颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日","author":"严嵩","text":"春日宜春睡，梦醒时冁然。\n处身无远略，忧世但长年。\n池湿青莎雨，莺啼绿树烟。\n近知理俗事，学种南山田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读易","author":"严嵩","text":"径转频移柳，斋荒自补茅。\n过从无俗客，迂僻少深交。\n先雨鹳鸣垤，知风鹊构巢。\n行藏吾已任，莫问易中爻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感述","author":"严嵩","text":"结茅楚水枫林下，拥膝长吟任此身。\n一官系籍逢多病，数口携家食旧贫。\n溪圃秋深菊容淡，石田春暖药苗新。\n时危献纳思无术，怅望中原伤战尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有喜致醉","author":"严嵩","text":"三十年过方有子，却论情事集悲欢。\n总叨先德宜昌后，每为身愁欲废官。\n琴书他日期堪付，堂构兹丘幸苟完。\n庭中翠竹红葵色，乘醉邀宾秉烛看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春晓歌","author":"严嵩","text":"鸡喈喈，鼓逢逢，晨旸熹，春雾濛。\n揽衣启户候晴色，山头云兴转深黑。\n花潭柳屿空复期，蹑屩携壶难自得。\n瓦沟急雨鸣彻宵，征人在途泥没腰。\n忽忆此时京国侣，策马披毡趁早朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜宴歌","author":"严嵩","text":"璚酒清。\n蕙肴盈。\n锦镫瑶席张四楹。\n华歌妙舞百伎呈。\n夜行游兮悦明星。\n奉君玉觞前致诚。\n上天垂休惠我明。\n黄河之水今再澄。\n天鸡鸣。\n海乌升。\n愿君举觞且留情。\n乐哉时乎方太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙亥年雪","author":"严嵩","text":"燕京雪花大如手，寒冱江南未尝有。\n近来江南雪亦如燕京，前年豫章东抵鄱湖冰。\n路珉争传耳共骇，故老创见心犹惊。\n今年大雪连三日，陌上深踰二三尺。\n葭管春回气转寒，柴门暮扫朝仍积。\n朝飞暮积无已时，四野浓云一色垂。\n共道城中愁桂玉，虚从江畔觅花枝。\n阴阳自古皆常度，物候今看却殊故。\n瞽史何由讯咎徵，病夫默坐忧时事。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"霰","author":"严嵩","text":"野霰朝仍集，山云冻不收。\n家贫念藜藿，寒至想衣裘。\n戎马多征檄，江波有钓舟。\n短歌成独醉，聊得坐消忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"伐园中木","author":"严嵩","text":"松柏储栋梁，枣栗充豆笾。\n樗榆竟何益，历历蕃中园。\n叶大苦蒙翳，材枉空挛蜷。\n能令地脉耗，亦使阳和偏。\n呼童砺斤斧，爨燎供炊烟。\n去莠植嘉谷，斩茅秀兰荃。\n栽培与倾覆，在理固宜然。\n不材世所弃，剪伐何足怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨后南池","author":"严嵩","text":"鸣雨夜不止，春波漫绿塘。\n细浪摇孤屿，广岸映回墙。\n乍宜添水槛，还能受野航。\n蒲荷纷擢秀，槐柳俨成行。\n虚疑泛瀛岛，深拟对濠梁。\n临流兴不极，日暮歌沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日閒居","author":"严嵩","text":"卜筑远阛市，虚堂近高林。\n池塘新雨过，夏木绿以阴。\n初日照前牖，咿嘤语鸣禽。\n听之颇怡悦，足慰静者心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对雨","author":"严嵩","text":"暮霭起前壑，白雨映中林。\n曲池通爽气，高馆足秋阴。\n把帙引眠思，焚香清道心。\n庭边有老树，萧瑟伴閒吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕閒居对雨","author":"严嵩","text":"一雨洗炎嚣，高斋坐寂寥。\n繁声傍竹近，寒色映空遥。\n颇袭图书润，还沾枕席飘。\n兴幽忘盥栉，巷僻谢招要。\n兰晓光逾碧，荷秋叶互凋。\n未须挥短箑，凉意晚萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊园","author":"严嵩","text":"柴扉在深木，无人昼不关。\n山围修竹罅，泉鸣乱石间。\n倚杖玩苍翠，临风听潺湲。\n一瓢挂高树，日暮灌花还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观雨作","author":"严嵩","text":"东峰雨色绕前溪，野树江船望欲迷。\n卷幔忽惊山雾入，近村长听水禽啼。\n清怜松菊长茅屋，深爱湍流满稻畦。\n故人门巷隔车辙，多病青尊不可携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"斋中读书","author":"严嵩","text":"柳径柴门辟向东，竹垣高树引清风。\n林中送客行常远，屋里看山兴不穷。\n唯须药物供身病，且爱闾阎属岁丰。\n世事浮云那足问，此生?老蠹鱼丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望钤山","author":"严嵩","text":"郭东草堂无俗嚣，画屏静对青岧峣。\n暮灯隔树影明灭，霜钟吼空声振摇。\n莲秀虚疑太华出，桂幽实爱小山招。\n为贪鹤背思千里，拟接虹梯问九霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观冯式窦禹钧事述咏 其一","author":"严嵩","text":"还妾当年不计赀，一商阴德世难之。\n状元已报神人送，邻里来谈梦兆奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观冯式窦禹钧事述咏 其二","author":"严嵩","text":"定数难移岂信然，但修人事可回天。\n窦郎梦得先灵告，三纪延年五桂传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夕黎君见寻","author":"严嵩","text":"兰舟远汎故情欢，柳径相邀月色寒。\n贫居市近能呼酒，懒性人逢不整冠。\n黄花醉可簪乌帽，水槛閒宜弄钓竿。\n不是同心念幽独，碧山那得共君看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中丞刘公卢洲宴集公子与予姻也","author":"严嵩","text":"东郭筑堂好，中丞载酒来。\n杯长烧烛坐，门正逐江开。\n琼树欣相倚，霜威许见陪。\n还知绿野醉，真胜习池回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江馆闻雨","author":"严嵩","text":"江迥风连屋，庭喧雨到床。\n寒声杂松竹，远势动潇湘。\n幕燕翻应湿，林花落尽香。\n问奇那有酒，春棹易相将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿雁洲","author":"严嵩","text":"山登极巑岏，野适忽夷旷。\n清涧屡寒涉，绿畴弥晚望。\n水亭荷芰开，园屋云松傍。\n应怜雁洲宿，绝胜剡溪访。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登高值雨留山舍","author":"严嵩","text":"未遂观奇愿，来过静者居。\n涉溪云逐马，下榻雨鸣除。\n公子携松酝，乡人馈鲤鱼。\n山寒春漏永，莫遣绿尊虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集刘大别业","author":"严嵩","text":"别业春山里，松筠开翠微。\n文觞坐群客，此会昔应稀。\n涧雨桐花湿，楼晴燕子飞。\n主情殊未已，乘醉出荆扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜友人至","author":"严嵩","text":"下马柴门日已曛，灯前悲喜话同群。\n空江岁晚无来客，远道情深独见君。\n瓦瓮细倾山郭酒，藜床閒卧石堂云。\n莫言古调秪自爱，且诵新篇慰我闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋陈大参分司同杨太仆宴","author":"严嵩","text":"凉夕逢秋半，仙杯坐漏长。\n未须延桂魄，卿月在薇堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕东堂同傅馆长兄宿","author":"严嵩","text":"纸窗银烛雨声前，草屋寒栖共老仙。\n不觉对床中夜语，青绫仍似玉堂年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钤阁同刘子集咏","author":"严嵩","text":"树引肩舆入，山当对酒吟。\n泉流一壑响，云度数峰阴。\n兹地尘境绝，逢君坐语深。\n谁言簪绂者，同有薜萝心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"应和见寻","author":"严嵩","text":"逶迟松桂林，之子能相寻。\n远道惊长别，幽期感素心。\n楚台临月迥，章水渡烟深。\n何物酬佳兴，风窗弹玉琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将赴京作","author":"严嵩","text":"七看梅发楚江滨，多难空馀一病身。\n阙下简书催物役，镜中癯貌愧冠绅。\n非才岂合仍求仕，薄禄深悲不逮亲。\n此日沧波理征棹，回瞻松柏自沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将赴京登郡城春台作","author":"严嵩","text":"浮生奔走遍尘埃，重对乡山病眼开。\n北望几回仍赴阙，南还今日始登台。\n袁江晴抱星辰下，燕雁寒冲雾雨来。\n攀磴俯林坟极目，抽毫作赋叹非才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]