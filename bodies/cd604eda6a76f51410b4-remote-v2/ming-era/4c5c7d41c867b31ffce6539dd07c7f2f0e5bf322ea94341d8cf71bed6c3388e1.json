[{"title":"岭南杂录三十首 其十一","author":"汪广洋","text":"鱼盐蛮蜑托为生，狭路逢人便弄兵。\n见说官曹巡逻急，卖刀买犊也归耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其十三","author":"汪广洋","text":"谩把金钗品价高，荔枝端不让樱桃。\n若教李白谙风味，甘分南州脱锦袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其十四","author":"汪广洋","text":"澹白轻红斗剪裁，紫薇终不占先开。\n如今烂漫炎天里，剩有春风座上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其十六","author":"汪广洋","text":"南海庙前花草新，波罗垂实雨频频。\n遐荒只爱求奇气，两两来看种树人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其十七","author":"汪广洋","text":"云色蛮笺傲薛涛，斗南楼上海天高。\n都将陆贾千年事，付与江淹五色毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其十八","author":"汪广洋","text":"凉风吹雨海门来，一洗蛮烟瘴雾开。\n回望帝京家万里，懒教人下越王台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其十九","author":"汪广洋","text":"花覆禅房刻漏迟，妙香浮动碧莲池。\n月明风细菩提落，想是南能出定时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其二十","author":"汪广洋","text":"海上安期去不来，石门花落又花开。\n几时相约骑黄鹄，烂醉秋风玉镜台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其二十一","author":"汪广洋","text":"白云山上白云飞，腾达年来与愿违。\n鹤发慈亲应记忆，岭南游子几时归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其二十二","author":"汪广洋","text":"啸弹长铗出秦川，又入蛮乡扫瘴烟。\n寄语凤凰台上客，别来五见月团圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其二十四","author":"汪广洋","text":"玉液池边夏木青，石屏台上晚风轻。\n道人心静不知暑，默坐焚香待月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其二十五","author":"汪广洋","text":"越盐如雪赛吴盐，藷蓣初肥竹笋甜。\n何事眉山苏太守，只将双蟹较团尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其二十六","author":"汪广洋","text":"罗浮山下葛洪家，遗履轩前尚种花。\n邓岳早能参妙契，也从勾漏觅丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其二十七","author":"汪广洋","text":"村团社日喜晴和，铜鼓齐敲唱海歌。\n都道一年生计足，五收蚕茧两收禾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其二十八","author":"汪广洋","text":"海隅风俗似朱陈，嫁娶从来只近邻。\n椰子槟榔供纳采，祖孙头白每相因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其二十九","author":"汪广洋","text":"不输租税不忧贫，缚屋边崖浅洞人。\n争捕蚺蛇邀远客，旋浇糟粕送比邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登清远峡飞来寺四首 其一","author":"汪广洋","text":"暂拟兰舟访隐沦，子规何事劝行人。\n满山松柏云来往，谁道王维画逼真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登清远峡飞来寺四首 其二","author":"汪广洋","text":"入峡阴阴出峡晴，峡流端似镜般平。\n玉环玩世谁收得，万壑千岩月自明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登清远峡飞来寺四首 其四","author":"汪广洋","text":"几年不上雨花台，胜景寻常入梦来。\n如此江山好楼阁，峡中图画自天开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"樵逸诗二首为徐徵士赋 其一","author":"汪广洋","text":"石室棋残鹤梦醒，自添沈水注茶经。\n山中岁晚知无事，还傍松根斫茯苓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"樵逸诗二首为徐徵士赋 其二","author":"汪广洋","text":"手把枯桐倚绿萝，白云深处少人过。\n春风一曲猗兰操，应是牛山美木多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝词三首 其一","author":"汪广洋","text":"涧水泠泠清见沙，妾心如水谅无他。\n愿言莫学杨花薄，一逐东风不恋家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝词三首 其二","author":"汪广洋","text":"守近东窗弄玉梭，织成阔幅翠绞罗。\n殷勤持赠裁春服，莫遣缠头买笑歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝词三首 其三","author":"汪广洋","text":"三百六十滩水清，桃花春涨近来生。\n催归不待临岐语，昨夜子规啼到明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淳安棹歌二首 其二","author":"汪广洋","text":"镜里青山画不如，临溪日日望郎书。\n数间茅屋住近水，十个松舟时打鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东吴棹歌四首 其三","author":"汪广洋","text":"玻璃冷浸洞庭山，霜竹攒攒橘柚斑。\n垂发吴娃笑相语，官船不似钓船閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东吴棹歌四首 其四","author":"汪广洋","text":"画桨经过碧浪湖，水晶台阁翠云铺。\n蓝田空老王摩诘，肯信江南有画图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兰溪棹歌三首 其一","author":"汪广洋","text":"凉月如眉挂柳湾，越中山色镜中看。\n兰溪三日桃花雨，夜半鲤鱼来上滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次濛?","author":"汪广洋","text":"濛?滩头六七家，野蒿成树竹如麻。\n儿孙不解躬耕耨，日日烟波理钓槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜过宝应驿","author":"汪广洋","text":"短篷风急雨声多，浓墨堆云水拍河。\n坐久不闻钟鼓报，向人数问夜如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚过青河驿","author":"汪广洋","text":"溯流西望渺如烟，黄帽齐将百丈牵。\n日暮雨来风浪恶，隔河挝鼓换官船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"补牛尾八阕乐歌辞 其一 载氏","author":"张孟兼","text":"彼民之初生兮靡慝。\n彼熙载兮不知不识。\n彼一人兮操要会以立极。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"补牛尾八阕乐歌辞 其二 玄鸟","author":"张孟兼","text":"鸸之来，民迎禖矣。\n鸸之归，民财阜矣。\n相甲历以制宜，之子兮勤施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"补牛尾八阕乐歌辞 其三 遂草木","author":"张孟兼","text":"而萌肇茁，而汇弥稷。\n乃攘乃剔，蕃其质。\n中我宫室，中我琴瑟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"补牛尾八阕乐歌辞 其四 奋五谷","author":"张孟兼","text":"种之嘉，播乃畬。\n出而作，赵其镈。\n仓斯千，祝百年。\n乃昭率育，乃游鼓腹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"补牛尾八阕乐歌辞 其五 敬天常","author":"张孟兼","text":"聿康回自神兮，彼天折其柱。\n维民彝俶乱兮，畴日监而在兹。\n乃维其斁，乃安其度。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"补牛尾八阕乐歌辞 其六 达地功","author":"张孟兼","text":"若掘大象兮，调太鸿。\n乘精拱默兮，耳目内通。\n维率九寰以承流兮，顺轨从。\n风亮天工兮，一人斯隆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"补牛尾八阕乐歌辞 其七 依地德","author":"张孟兼","text":"彼奠而靡隳兮惟厚。\n取财而勿匮兮，惟百耕者馀饩宿陇首。\n俾我不武，法其阴德。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"补牛尾八阕乐歌辞 其八 总万物之极","author":"张孟兼","text":"眷群生，气莫阏。\n芸万百，一何轕。\n应不求兮，聚必夺。\n绍物开智兮，一物胥达。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古诗十首 其一","author":"童冀","text":"弱龄抱高尚，雅志在丘园。\n胡为坐维絷，偪侧城府间。\n穷年守铅椠，严程如作官。\n日晏甫朝食，冬裘春不完。\n达生贵适意，讵敢求晏安。\n永怀沮溺徒，躬耕非所叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古诗十首 其二","author":"童冀","text":"穷巷谢轮鞅，寂寞如荒村。\n闭门十日雨，不知绿阴繁。\n编简久息意，况复谋琴尊。\n日晏倒衣起，竟夕坐前轩。\n孙生亦闭户，董子不窥园。\n嗟我独无为，愧此岁月奔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古诗十首 其三","author":"童冀","text":"端居澹无营，穷巷守环堵。\n食罢何所为，临池听疏雨。\n秋风入庭树，柯叶已非故。\n人生无百年，玄发忽改素。\n有酒且作乐，勿为浮名误。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古诗十首 其四","author":"童冀","text":"宿雨霁清晓，绿阴布庭隅。\n开轩缅遥岑，好鸟鸣相呼。\n兹辰岂不佳，揽衣步前除。\n仰睇云中鸢，俯羡渊底鱼。\n物性各有适，吾生谅何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古诗十首 其五","author":"童冀","text":"空斋阒无事，焚香坐清晨。\n客至惟清谈，客去常杜门。\n兹辰偶惬意，驾言出城闉。\n昔游岁未殚，今来已徂春。\n冉冉四序换，种种双鬓新。\n盛年不重来，俯仰愧古人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古诗十首 其六","author":"童冀","text":"豫章生道傍，拱把寻斧斤。\n樗栎老空山，百岁长轮囷。\n良材世所用，蚤与忧患邻。\n恶木处散地，乃得全其真。\n出处慎所择，君子惧失身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古诗十首 其七","author":"童冀","text":"梧桐树西掖，濯濯青琅玕。\n春风一披拂，翠叶敷云端。\n高枝集凤鸟，卑枝宿鹓鸾。\n清秋下白露，摧折同艾菅。\n本非岁寒质，零落何所叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古诗十首 其八","author":"童冀","text":"蓺菊庭阶下，草盛菊不蕃。\n物性各有时，勿怨雨露偏。\n严霜被萧艾，始见金英繁。\n托形寓宇内，荣悴非一端。\n穷达安所遇，庶以全吾天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古诗十首 其九","author":"童冀","text":"结发业坟典，志尚希古人。\n区区守章句，坎壈愧此身。\n洙泗道已远，伊洛行复湮。\n岁月不我与，五十恐无闻。\n君子贵达道，志士斯求仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古诗十首 其十","author":"童冀","text":"天地大无外，伊人处其中。\n寸心具万善，上帝所降衷。\n胡为汨利欲，扰扰昧始终。\n修名不早立，甘与草木同。\n圣贤亦何人，令德垂无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂诗四首 其一","author":"童冀","text":"叔孙制朝仪，高论倾汉庭。\n绵蕞习野外，礼乐何由兴。\n东鲁致诸儒，两生独不行。\n岂不达时变，阿世非人情。\n周公昔制作，乃待治化成。\n用舍固有命，出处良不轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂诗四首 其二","author":"童冀","text":"昔有汉阴叟，抱瓮日灌畦。\n凿隧入古井，功寡力巳疲。\n桔槔暂俯仰，薄之乃不为。\n区区叔世事，有械皆危机。\n斯人不可作，吾将谁与归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂诗四首 其三","author":"童冀","text":"翟公罢庭尉，宾客如晨星。\n一旦复拜官，夹道相逢迎。\n署门亦颇隘，外物何重轻。\n四序更代谢，日月有亏盈。\n天运且如此，况复时世情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂诗四首 其四","author":"童冀","text":"原宪守环堵，穷巷席为门。\n赐也相卫归，结驷从华轩。\n迂辔偶见过，握手道殷勤。\n穷达各有命，贫病安足论。\n君子贵行道，毋为羞贱贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"盛生诗","author":"童冀","text":"盛生德茂者，家世乃儒绅。\n厥兄舍铅椠，吏牍期致身。\n微文偶失愤，密网无纵鳞。\n逮系岸狱中，藁瘗荒江濆。\n生时奉菽水，升堂拜慈亲。\n泣血叩首路，弗惮千里勤。\n干戈犹在目，道路蕃棘榛。\n崎岖霜霰途，涉历踰十旬。\n间道负骨归，号恸惊四邻。\n先垄幸可祔，差慰地下魂。\n穷冬十二月，积雪遍郊原。\n上天忽敷祐，列岫明朝暾。\n窀穸甫安厝，浩荡风雪昏。\n天人良不远，一念至理存。\n我思天壤间，手足惟弟昆。\n周公称上圣，管蔡乃流言。\n舜象本同生，谋谟盖都君。\n前圣且不免，况复后世人。\n惟生诗礼家，孝义耳所闻。\n赵礼昔让肥，艰难贼推仁。\n缪彤痛自挝，诸妇感天伦。\n淮南自贻戚，斗粟悲汉文。\n陈思咏豆萁，魏帝伤同根。\n喟彼叔世士，相视越与秦。\n死丧孰孔怀，阋墙诚寡恩。\n我作盛生诗，庶使薄俗敦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴贞媛诗","author":"童冀","text":"贞哉王氏妇，结发从所天。\n百年奉箕帚，中道成弃捐。\n白首会一死，甘心即九泉。\n婉婉桃李花，随时竞春妍。\n漂泊风雨中，零落岐路间。\n死者奚所憾，永为生者怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"效何水部一首","author":"童冀","text":"看梅东阁上，遥忆帝京时。\n梁园雪未下，华林春已归。\n香飘鳷鹊观，影落天渊池。\n已伤白发暮，敢怨清光迟。\n陇首成异域，何用寄相知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"效阴常侍一首","author":"童冀","text":"荆楚三年别，巫峡千里遥。\n彩鹢阻去棹，乌鹊望仙桥。\n山云自含雨，江水不成潮。\n柳长谁共结，花残复易飘。\n阳台空作望，暮暮还朝朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"效李长吉一首次中孚韵","author":"童冀","text":"白露下百草，庭阶陨红兰。\n愁肠剧车轮，夜夜相回环。\n青灯照鱼目，梦向交河还。\n枕冷珊瑚枝，不知双涕潸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宋徽宗秋林野雀","author":"童冀","text":"君不闻虞廷盛时凤来仪，圣贤饬戒惟时几。\n又不闻商宗肜日雉雊鼎，君臣遇灾克修省。\n古来理乱良靡常，居安虑危邦乃昌。\n我闻宣和全盛日，廊庙怀安事游逸。\n三边不动无烟尘，四海徵求到花石。\n紫宸退朝清昼閒，霜林好鸟声间关。\n乘閒适意一挥洒，岂意流落传人间。\n海上盟寒朔风急，辽水经年断消息。\n青城月冷乌夜啼，一枝莫遂鹪鹩栖。\n嗟乎虞廷凤，商鼎雉，千载何人知此意。\n日落梁园鸟雀悲，龙沙或冇清梦归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"跋文丞相遗墨","author":"童冀","text":"有宋科第三百年，季年得士惟文山。\n文山一身能许国，精忠日月行中天。\n我观德祐颠沛日，国势驶若东逝川。\n又如膏肓久沉绵，虽有和扁无由痊。\n公时崛起岭海壖，手执忠义为戈鋋。\n疲氓弱卒不满千，壮气直欲吞全燕。\n仓卒一跌振复颠，鸷鸟婴网宁高骞。\n大酋箕踞叱使前，膝不可屈身可捐。\n敌国均礼古所传，骄气竟折忠义言。\n渡淮粒食不下咽，天意未许为癯仙。\n白马系组轵道边，碙川崖山复颠连。\n此身悔不东海填，燕狱甘心坐拘挛。\n四阅寒暑相推迁，少康不作志莫宣。\n赍恨白日埋九泉，我尝读公吟啸编。\n三复遗墨涕泗涟，古人逝去如云烟，公死不朽奚憾焉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘氏二子诗","author":"童冀","text":"君不闻卞壸二子真孝子，以身殉父从父死。\n又不闻刘璹二子家被兵，以身捍父同父生。\n一生一死幸不幸，同博千秋万古名。\n身亦何所有，子职所当为。\n独怜彼寇心，天理曾不亏。\n呜呼人心天理曾不亏，毁常败俗夫何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方壶道人山水歌","author":"童冀","text":"吾闻瀛海中有方壶山，琼台银阙非人寰。\n秦皇汉武不可到，何人醉梦游其间。\n乃是龙虎山中学仙子，十年辟谷餐芝髓。\n青天白日无羽翰，肉重骨凡飞不起。\n云涛浩渺烟苍茫，海天万里遥相望。\n神交意会忽有得，身外万事俱亡羊。\n归来醉吸三斗墨，净洗胸中旧荆棘。\n解衣盘礴反闭关，日对云林写萧瑟。\n尔来得名三十春，眼高四海空无人。\n残缯断楮落人世，夜光明月作奇珍。\n君不见乐善堂中三尺纸，开眼应须论万里。\n自言曾是挥洒时，飒飒风烟生笔底。\n祗今此境绝代无，却向君家看画图。\n平生三岛惜未到，拭目始见真方壶。\n方壶之山果何处，咫尺波涛隔烟雾。\n欲从坡老借飞车，钓竿一拂珊瑚树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方壶?书张伸举承旨海上所寄长律见贻因次其韵","author":"童冀","text":"古人制车观转蓬，学剑偶得白猿翁。\n孰知牺卦本心画，不待龙图出贝宫。\n人言造字始仓颉，我意定礼由姬公。\n乾坤玄象焕昭晰，浑沌白昼开溟濛。\n川流山峙俨高下，日升月没恒西东。\n自然书法良亦显，何物世俗拘未通。\n纷纷墨池疲岁月，往往白发犹儿童。\n长安高僧笔成冢，北邙大官碑作丛。\n斯冰以来少正体，曹郐而下多变风。\n呕心苦购墓中物，刮目未睹吴下蒙。\n钩摹点勒事剽窃，毫分缕析论拙工。\n仲尼阳虎貌则似，叔敖优孟行不同。\n岐山周鼓昧真赝，泗水夏鼎迷始终。\n岣嵝云深宵露湿，峄阳火烈寒烟空。\n鸿都石经变愈下，苦县枣刻肥失中。\n壶也独出超万汇，凤兮一鸣瘖百虫。\n胸中况复有丘壑，物外久已无樊笼。\n蹇予涉世遘多难，学道劳生讵有功。\n一卧山林秋草绿，十年湖海战尘红。\n从公千里访真诀，守雌毕竟谁知雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人之金陵","author":"童冀","text":"六代繁华地，东南第一州。\n此身虽未到，清梦已先游。\n月淡乌衣巷，天青白鹭洲。\n何时一樽酒，同看大江流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]