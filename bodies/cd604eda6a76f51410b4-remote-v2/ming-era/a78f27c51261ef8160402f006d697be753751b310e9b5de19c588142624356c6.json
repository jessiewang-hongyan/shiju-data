[{"title":"虞美人第二体","author":"齐景云","text":"双涡红晕檀霞满。\n钿镜横波远。\n宿妆无奈是春前。\n刘郎洞口谢娘船。\n思无边。\n鹌鹑啄破赪桐叶。\n云掩圆蟾截。\n小楼回首绿烟迷。\n微风半夜揭珠帏。\n认郎归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53004,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"减字木兰花 题日涉园","author":"翁孺安","text":"白云深处。\n帘捲画楼含暮雨。\n玉树歌残。\n野鸟心闲独自看。\n门摇杨柳。\n高士纶竿今在否。\n尚想分题。\n林外烟岚翠不齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53005,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鹧鸪天","author":"翁孺安","text":"三月听莺绿已肥。\n香车常趁落红归。\n道旁蝴蝶能相逐，梦里鸳鸯不肯飞。\n惜别去，思依依。\n绣床犹剩舞时衣。\n博山熏透无人语，院落沉沉冷夕晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53006,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长相思 秋怨","author":"黄鸿","text":"倚栏杆。\n步栏杆。\n鹈鴂三更枝上寒。\n如何桂影圆。\n记难难。\n话难难。\n那堪清漏唤邯郸。\n啼红烛未残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53007,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"菩萨蛮 梦中咏梅","author":"黄鸿","text":"雕栏十二幽香腻。\n分明睡在罗浮里。\n风动晓妆前。\n残云冷翠钿。\n花花何处问。\n向晓愁来近。\n横枕一张琴。\n琴心曲里凭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53008,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六言 其四","author":"顾清","text":"阑干欲过还留，绿肥新涨溪流。\n花落游鱼影乱，风和鸣鸟声柔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53009,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六言 其五","author":"顾清","text":"涉世已知踰限，读书元自不多。\n幸可浇花种竹，还思列戟鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53010,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六言 其六","author":"顾清","text":"霄汉九重云日，江湖万里风烟。\n田父相逢偶语，今年大是丰年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53011,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六言 其七","author":"顾清","text":"游丝将堕复举，好鸟急过遗音。\n总是少年光景，只多往事关心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53012,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六言 其八","author":"顾清","text":"为爱夕阳晴好，不知行过秋亭。\n墙角桃花片片，枝头梅子青青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53013,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张子翼江亭饯别四首送太史王忠铭北上应和 其三","author":"王弘诲","text":"万里遥分建水筵，百年初结女萝缘。\n合欢喜借蓝田誉，投赠应惭白雪篇。\n宇内君亲情并极，天涯儿女意多牵。\n何当姻娅过逢地，昼锦屏开孔雀边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53014,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张子翼江亭饯别四首送太史王忠铭北上应和 其四","author":"王弘诲","text":"风尘南望雁鸿劳，每忆新诗别后高。\n弄月几回寻钓艇，聚星何处对临皋。\n扶摇碧海看鹏背，接武青云待凤毛。\n中散知君疏懒甚，可能书札寄山涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53015,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻滇贵道阻问瑞芝中丞二首 其二","author":"汤显祖","text":"鬼气临参不肯降，时时兵甲问南邦。\n天开贵竹当雄楚，地拥西台接丽江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53016,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂诗","author":"朱綝","text":"天寒苦日短，白露变为霜。\n行行出门去，周道悠且长。\n衰草被荒郊，阴云翳重冈。\n俯观溪流涸，仰视鸿雁翔。\n岂不怀所思，慷慨热中肠。\n乃知四时间，代谢本寻常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53017,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月下独步有感","author":"朱綝","text":"白月在青天，照见地上影。\n城荒鼓角悲，露重衣裳冷。\n草砌蛩乱呼，松巢鹤频警。\n徘徊复彷徨，发我心内省。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53018,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题黄花驿观湘亭","author":"朱綝","text":"湘水清可观，新亭翼弘敞。\n面江瞰空阔，据地得高爽。\n远树杂烟霭，断岸连筱荡。\n雁影堕微茫，渔歌荅清响。\n三闾不可吊，兰佩空想像。\n二女时出游，翠盖移惚恍。\n繄予颇好古，到处寄幽赏。\n眝目更如何，澄波涤尘鞅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53019,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拳毛騧歌次王汝玉韵","author":"朱綝","text":"李唐天厩拳毛騧，蹙踏倒影凌飞霞。\n侯家神骏岂遗种，遍身细缬旋螺花。\n端阳射柳辕门道，紫燕身轻拂柔草。\n镂膺虎韔锦障泥，响马群中看表表。\n得隽归来红日西，汗沟珠血濡霜蹄。\n解鞍滚罢起喷振，奚奴牵入垂杨堤。\n南陌观花宜按辔，戏共王孙簇芳骑。\n乌衣朱雀足追游，自古金陵说佳丽。\n皇风万里清关河，尚方兵仗绣不磨。\n騧兮騧兮免负戈，日日朝天鸣贝珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53020,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出鬼门关","author":"朱綝","text":"北流仍在望，喜出鬼门关。\n自幸身无恙，从教鬓总斑。\n昔人多不返，今我独生还。\n回首琼山县，昏昏瘴雾间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53021,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄伯礼兄长","author":"朱綝","text":"春来见绿树，日夜忆连枝。\n梦断一千里，愁连十二时。\n鹡鸰飞雨急，鸿雁度云迟。\n无柰音书绝，其如鼓角悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐有感","author":"朱綝","text":"夜分灯烬漏声迟，掩卷茫然不自支。\n三月莺花春去后，半窗风雨客愁时。\n相如未遂题桥志，季子犹持刺股锥。\n辛苦人生成底事，姓名留得世间知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过洛社留寄李耕隐","author":"朱綝","text":"故人近住林之东，相望草堂云气中。\n旧时松竹想无恙，暇日琴樽谁与同。\n作赋应能继潘岳，隐耕元不让庞公。\n过门不入非为慢，两鬓尘埃愧转蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中过韶州","author":"朱綝","text":"船下韶泷日欲晡，四山云起景模糊。\n沙鸥冲雨频来去，汀树迷烟半有无。\n作客又惊三月暮，思家其柰一身孤。\n愁怀浩浩浑如醉，独倚篷窗听鹧鸪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题赵师吉梅林生卷","author":"朱綝","text":"金华山人有梅癖，托物自号梅林生。\n欲唤师雄谈醉梦，恨无和靖结诗盟。\n笔端幻出先春意，胸次包含太古情。\n我亦从来松竹操，愿言与子保幽贞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画梅别卷","author":"朱綝","text":"虞君潇洒本天真，绝似梅花玉树春。\n调鼎声名知有在，可人风度更无伦。\n冰霜凛凛能孤立，桃李纷纷总后尘。\n他日相思渺何许，巡檐一笑一情亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝歌送萧月潭","author":"朱綝","text":"子期逝矣谁知音，堪舆茫茫劳我心。\n石坛后夜好明月，忆尔琴中飞佩吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题淘金驿","author":"朱綝","text":"淘金驿前春色多，红桃绿柳映清波。\n江南独客悲时序，柰此东风淡荡何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过君山","author":"朱綝","text":"昔人曾与白云游，我欲登临一写忧。\n风满征帆停不得，烟波回首思悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题五羊驿","author":"朱綝","text":"尉陀归汉忆当时，千古犹誇陆贾辞。\n今日蛮夷俱向化，我来无语独题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过庐山","author":"朱綝","text":"庐山万丈倚青冥，翠壑丹崖列画屏。\n不得维舟恣游览，尘埃满面愧山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋旭庵","author":"曾爟","text":"晨光散馀霭，大明丽东方。\n伊人慎修为，从容整冠裳。\n四檐萃虚白，开卷思遑遑。\n寸阴惜轻逝，宴安当预防。\n天君贵操存，待旦知自强。\n矫首对初晖，盎然乐无央。\n孰云虎臣裔，践迹能升堂。\n勖哉勿异途，黾勉趍周行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"捣衣曲","author":"曾爟","text":"捣衣复捣衣，空闺月冷风凄凄。\n风前高下声零乱，客中听得偏肠断。\n断肠应折大刀头，破镜上天过一秋。\n更深力尽闻私语，夫戌边城几寒暑。\n新衣岁岁寄征人，寄到边城衣不新。\n客行虽远有归日，久戌何时见家室。\n愿令今古无别离，夫耕妇织常相随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西旅献獒图为居止善赋","author":"曾爟","text":"非熊非貙声豪雄，蹄高四尺行追风。\n武王戎衣定天下，西旅献来名更隆。\n止戈归马称平治，校猎沙场供祀事。\n太保胡为戒后王，应恐禽荒坠先志。\n獒搏鲜肥乃其职，嗾以噬人翻乱国。\n阎公绘画岂无心，欲使当朝防失德。\n阎公状物妙入神，龙眠效之尤逼真。\n玉堂松雪善模拟，三贤造车同一轮。\n披图细玩非花草，铁画银钩书法好。\n居公慎勿示常人，留作传家子孙宝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老龙引子归潮图","author":"曾爟","text":"海门秋气横江来，怒涛殷地如奔雷。\n苍龙教子习潮势，排风喷雪烟云开。\n忆昔深潭事冲举，直上穹霄轻一羽。\n曾嘘数滴翻瓢浆，散作九州三日雨。\n只今回顾思潜踪，引子不敢施神通。\n却愁幼小易飘忽，一瞬万里天无功。\n我闻灵物多奇异，潜飞大小皆随意。\n画师恐是张僧繇，写向生绡若真致。\n龙今育子犹世人，古来有欲皆可驯。\n何当重起豢龙氏，爱养留作商岩臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荅朱文粲","author":"曾爟","text":"南风送好音，珍重比南金。\n寂寞经年别，凄凉万里心。\n弊裘仍恋体，华发已盈簪。\n谁识乡关念，时时动越吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜偶成","author":"曾爟","text":"陇上俄闻梁父吟，异乡情绪独难禁。\n寸锥未脱囊中颖，断木谁修爨下琴。\n夜雨惊残归国梦，秋风催动捣衣砧。\n欲凭樽酒忘羁恨，酒后那知恨转深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠云教授","author":"曾爟","text":"谁传礼乐继前王，庠序昭回草木香。\n汉道欲昌书再挟，秦灰未冷德先凉。\n千年庙貌乾坤大，万古人伦日月长。\n共喜皋比开讲席，伫看池上集鸾凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠日本僧演此宗","author":"曾爟","text":"达摩居嵩九载期，此宗寂寂有谁知。\n生从日本精三藏，老向云南礼六时。\n香满墨池临旧帖，花明春坞咏新诗。\n别来应有惊人句，好寄东风慰所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄友人","author":"曾爟","text":"与君离阔十年馀，两过江滨候起居。\n咫尺犹如千里别，飘零不寄一行书。\n何时夏口同倾盖，此日王门好曳裾。\n若问故人何似者，鬓丝今已不胜梳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题倪云林画","author":"曾爟","text":"梁鸿溪上草堂幽，红叶黄花几度秋。\n回首云林人不见，西风落日思悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄素轩公","author":"周昉","text":"行马纵横禁谒时，不干声色尚文辞。\n深藏结绿千金剑，少试抽黄七字诗。\n聚远有楼堪纵目，在官无事且开眉。\n欲知王谢人家乐，霁月光风蔼墨池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题江南秋晚图","author":"韩宜可","text":"钱塘江头潮汛来，我时放棹胸次开。\n西风萧萧木叶脱，夕阳渐低沙鸟回。\n划然一啸海天碧，吴越两山云尽白。\n图中风景偶相同，嗟我胡为久行役。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冯虚子歌","author":"韩宜可","text":"冯虚子，清且脩，藐观万物如浮沤。\n金茎一柱出天表，青田孤鹤横高秋。\n大鹏抟风九万里，下视尘寰渺烟水。\n蜃楼缥缈危接天，夜半月明常独倚。\n四方上下随所之，茫茫积气将焉依。\n居无室庐辙无迹，鳌背岂有三山为。\n空中鸡犬刘安宅，我亦因之寄遐适。\n飞光浩浩不少留，回首人间非宿昔。\n列子禦风已千载，庄生化蝶今安在。\n水中漉月亦好奇，管里窥天竟无底。\n太虚太虚问不应，银河耿耿凝寒冰。\n丹台紫府不可登，愿归大化何由冯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和王太原中秋韵","author":"韩宜可","text":"未忍他乡死便休，每依南斗望中州。\n青天有月来今夕，白发无家度几秋。\n客计空弹冯子铗，愁心长倚仲宣楼。\n明年此会知何在，且赋新诗纪远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王格心考满","author":"韩宜可","text":"冠盖纷纷晓出城，城头送别若为情。\n青云莫谓归年少，白石从来缔旧盟。\n芳草东风沙上马，碧山迟日柳边莺。\n子今休恨先华发，千载犹闻丙少卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酒船图","author":"韩宜可","text":"春波桥头水半竿，画船如马触狂澜。\n平生常恨江湖小，醉卧不知天地宽。\n隔岸好山青隐隐，环洲芳树绿漫漫。\n悬知贺监归来日，一曲晴光五月寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五华山图","author":"韩宜可","text":"五华之山山上头，俯视江东如浮沤。\n岂无四万八千丈，亦有五城十二楼。\n翠蕖影落中天晓，玉柱光含大地秋。\n何日相从陪杖屦，西风林下一长讴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小景","author":"韩宜可","text":"春色来何处，桃花路欲迷。\n为言垂钓者，中有武陵溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"韩宜可","text":"西风洞庭波，落日苍梧野。\n挈兹瑶芳枝，将以遗行者。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画梅","author":"韩宜可","text":"湖西开遍梅千树，正在东风十日前。\n月落参横谁是伴，数声孤鹤叫清妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"韩宜可","text":"山上白云如水流，隔溪红叶蚤知秋。\n几年不复南柯梦，独坐西风看白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瑶台玩月","author":"王景","text":"瑶台台上秋月明，瑶台台下秋水清。\n道人持杯待月出，气压泰华吞沧溟。\n嫦娥靓妆倚东井，碾破琉璃几千顷。\n兴来吸尽金叵罗，舞袖裴徊弄清影。\n衷肠激烈问青天，何似当年李谪仙。\n迢迢云海望不极，不知天上今何年。\n玉阶桂花下如霰，瑶光欲堕明星烂。\n微霜漂漂沾人衣，城上乌啼知夜半。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗盘书屋","author":"王景","text":"罗盘山色连青冥，罗盘花开春满城。\n迩来文轨遍南服，搆得书屋山之扃。\n中有牙签三万轴，隶古漆书联汗竹。\n琬琰新收汉石经，黉序亦开唐白鹿。\n要将礼乐化殊方，夜深弦诵声琅琅。\n已闻文翁教岷蜀，此邦更在岷之阳。\n岷山之水向南流，织女机丝涵素秋。\n岂徒风气开太朴，终看德化齐中州。\n罗盘书屋世无有，今度有书垂不朽。\n不是莲花幕下宾，安得文光贯南斗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"剑阁图","author":"王景","text":"剑阁云栈高嵯峨，嘉陵江水扬清波。\n神扃鬼凿閟幽阒，秋风古道无人过。\n一朝日华忽西被，宇宙淋漓荡元气。\n霆轰飙举神龙逝，山川草木皆生意。\n乃知世道有晦明，蜀山万仞如砥平，圣人在位四海清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画扇","author":"王景","text":"二仪开混沌，一气蕴精灵。\n石乳通龙井，天风老鹤汀。\n江山自吴楚，寰宇际沧溟。\n便欲抛尘俗，寻真向草亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺西平侯大人平越州","author":"王景","text":"元戎承制扫蛮方，踏遍先王旧战场。\n又见孔明擒孟获，何殊充国破西羌。\n捷书入奏风云动，凯骑扬尘日月黄。\n圣主万年垂大统，海山无地不梯航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"王景","text":"闻说蓬莱水已枯，懒从海上拾珊瑚。\n山前石烂云生母，天际禽飞雪作姑。\n三尺清冰雷焕剑，一杯元气长房壶。\n此中尽是琼林侣，何事年来不寄书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画草木奇峰","author":"王景","text":"苍虬飞上天，鳞鬣堕深麓。\n长风吹不起，散作千山绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画马","author":"王景","text":"天上房星烛地寒，故教骏骨落人间。\n如今纸上空形影，曾在秋风十二闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采莲曲","author":"楼琏","text":"妾学采莲莲始花，花颜与妾争春华。\n妾有朱铅为郎饰，不学尔花徒弄色。\n秋霜一夜花无主，妾忆行郎泪如雨。\n暗卜行郎何日归，定是莲房结子时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送别","author":"王汝玉","text":"绿水滟汀洲，风起江南秋。\n烟波有孤客，关河生远愁。\n远愁那足说，惜此芳华歇。\n日暮淡忘归，蘋花怅难撷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题修竹美人图","author":"王汝玉","text":"兰膏香腻盘云绿，愁锁春山黛痕蹙。\n天寒日暮悄无言，翠袖盈盈倚修竹。\n修竹无心亦有情，竹花结实珠繁萦。\n秦楼人去綵鸾杳，湘江种得相思成。\n相思有种何时歇，竹上年年怨离别。\n千古魂消怨不消，泪红染成鸳鸯血。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湘竹箫歌为赵丹林赋","author":"王汝玉","text":"君家洞箫天下奇，碎红乱点香淋漓。\n浓如丹砂沁冰肌，淡似猩血凝璚枝。\n持来世人莫能识，疑是秦王女儿之所贻。\n几回吹向霜江晓，皓月不明风悄悄。\n一声卷入碧云中，惊散飞鸿落天表。\n君不见重华去兮归路遥，二女泣向湘江皋。\n江皋之竹竹间泪，万古千年长不消。\n我将挟君携此同上黄鹤楼，醉弄一曲离鸾秋。\n曲终飞度洞庭去，试听苍梧猿夜愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春晓美人图","author":"王汝玉","text":"梨花埭上鸡鸣早，十二璚楼天乍晓。\n东风不动绿杨丝，云母窗空春悄悄。\n银屏复帐掩鲛绡，遮断蓬山海路遥。\n鬓乱钗横双凤亸，玻瓈枕上不胜娇。\n谁将鹦鹉偷调弄，惊散瑶台合欢梦。\n金盘仙掌日华高，小苑花枝露痕重。\n小玉薰残苏合香，临鸾先学理新妆。\n合欢欲起愁无力，满院绿阴春昼长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]