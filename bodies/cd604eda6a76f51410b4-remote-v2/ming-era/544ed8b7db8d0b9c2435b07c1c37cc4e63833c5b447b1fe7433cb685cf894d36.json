[{"title":"京兆进春次王汝温韵","author":"杨旦","text":"唱彻鸡人进土牛，司仪双引殿东头。\n扇开雉尾聆天语，帘捲虾须觐帝旒。\n地脉暖融春意动，日华辉映晓寒收。\n皇恩浩荡先畿甸，次第和风遍九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27971,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"廿五日奉别诸寮移午登舟","author":"杨旦","text":"同寮眷眷故情长，胜日名园乐未央。\n赠别忽惊诗满卷，开怀莫厌酒盈觞。\n半篙新渌浮春舫，一片轻帆挂夕阳。\n归卧篷窗成不寐，隔江灯火正昏黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27972,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"礼部视事","author":"杨旦","text":"遥瞻双阙拜恩光，秩亚春官愧赞襄。\n吏隐不嫌疏案牍，庭参却笑杂缁黄。\n松梢雨过苍髯秀，竹楠风来翠葆凉。\n退坐小斋清似水，一帘晴日映红芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27973,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"退食偶书","author":"杨旦","text":"燕居如此亦佳哉，地湿莎青绝点埃。\n片席且移花底坐，清风时傍竹间来。\n滥叨厚禄颜空汗，斜倚晴窗句谩裁。\n最是暮春天气好，公庭吏散独徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27974,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游清凉山次乔宗伯韵","author":"杨旦","text":"雨馀山色散晴空，古寺逶迤曲径通。\n暇日偶陪诸老后，上方今喜一樽同。\n凭高眺远诗怀壮，佳景芳时乐事丛。\n宾主相忘因坐久，莲房荐酒擘青葱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27975,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游灵谷寺次乔宗伯韵","author":"杨旦","text":"偶寄尘踪此地行，试倾俗耳听泉声。\n避烟野鹤穿云去，倚槛山花映酒明。\n饾饤殽蔬供小酌，平章风景写馀情。\n迟留不觉归来晚，十里松阴接古城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27976,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游东山次王司马韵","author":"杨旦","text":"云破晴光散远山，老天今日亦开颜。\n绿垂岸柳晚风定，红落林花春事閒。\n散步偶随孤鹤去，浩歌宁逐白云还。\n针砭俗耳挥弦管，静听泉声戛佩环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27977,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"分水道中","author":"杨旦","text":"潋滟波光映碧空，画船如泛水晶宫。\n俄惊巨浸吞平陆，却喜轻帆引顺风。\n两岸垂杨迎棹绿，夹堤新枣压枝红。\n浮云敛尽天如洗，点点遥山夕照中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27978,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夕和乔白岩韵","author":"杨旦","text":"新写桃符换旧厅，留都昆季叹晨星。\n行年老矣头将白，知我谁欤眼共青。\n曦驭倏驰徒守岁，儿曹忽报又添丁。\n妨贤亟欲投簪去，世路悠悠笑独醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27979,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送叶上舍定还建宁","author":"杨旦","text":"成均卒业赖薰陶，谁共离亭醉楚醪。\n三月莺花春事好，千山风雨客程劳。\n梯云更拟秋攀桂，继晷何妨夜续膏。\n亲友相逢如见问，一官无补愧清高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27980,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"临清舣舟值雨","author":"杨旦","text":"柳外风来雨脚斜，好山刚被白云遮。\n新凉散暑穿云幕，小涨移舟出浅沙。\n鱼贯帆樯千里运，蜂房户牖万人家。\n繁华堪赏还堪恨，满目芳菲乱野花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27981,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李珍分教徐州","author":"杨旦","text":"才华蚤岁播芳誉，新沐恩光入古徐。\n山抹晴云青杳霭，雨肥官柳绿扶疏。\n优游绛帐谈经后，感慨黄楼览胜馀。\n吾弟相逢凭寄语，归期准拟在冬初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27982,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨智任绍兴知事","author":"杨旦","text":"客路莺花又暮春，恩光今喜映簪绅。\n浙东胜处称兹郡，幕下通才见此宾。\n管辖好存纲纪在，糺绳那眩是非真。\n不妨官舍清如水，荐剡行看达紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27983,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"庆都行台次林粹夫韵","author":"杨旦","text":"宿负天教向此偿，驱驰远道笑奔忙。\n山头雨过云犹湿，柳外风和日正长。\n冗语欲书嫌疥壁，疏帘不捲为留香。\n微名蜗角知何用，今古悠悠梦一场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27984,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"定州行台次粹夫韵","author":"杨旦","text":"扰扰轮蹄路四通，山川兹郡亦称雄。\n麦畦过雨翻晴浪，柳径迷烟袅暮风。\n景况尽收诗卷里，愁怀都付酒杯中。\n行台夜锁青灯静，閒把遗编校异同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27985,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新乐行台次壁间韵","author":"杨旦","text":"宪节西行此暂停，重门无事昼常扃。\n台前古柏垂垂绿，雨后遥山故故青。\n万里关河嗟远道，半生踪迹叹浮萍。\n今宵谁与占乾象，指点中天识使星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27986,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜宿行台","author":"杨旦","text":"微风忽送雨纤纤，一枕凉生睡正甜。\n旋忆缊袍开故箧，时闻馀溜泻空檐。\n公庭吏散初喧鹊，燕寝香凝不捲帘。\n明日阴晴浑未定，灯花试向夜深占。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27987,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"磁州道中","author":"杨旦","text":"风扫顽阴雨脚收，轺车西去路悠悠。\n荒台半圮空陈迹，疑冢相望尚故丘。\n千古英雄谁竹帛，一川花鸟自春秋。\n不堪回首斜阳外，惟见漳河绕郡流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27988,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"百门泉次旧韵","author":"杨旦","text":"高下亭台远近山，百泉觱沸绿阴间。\n幽寻更拟穿云去，纵赏何妨戴月还。\n鸟恋故巢回倦翼，风沦止水避尘颜。\n安排佳句酬清景，却笑偷閒未得閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27989,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望岳次石司徒韵","author":"杨旦","text":"紫翠重重列画屏，人间何处著丹青。\n擎天一掌扶红日，拔地三峰擘巨灵。\n松暗药炉无火伏，苔深仙洞有云扃。\n兹行奇绝真堪纪，静听飞泉带雨泠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27990,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观雁塔","author":"杨旦","text":"岿然古塔倚青霄，胜览何妨去路遥。\n名氏销沈怀往哲，规模宏壮忆前朝。\n四檐倾侧危将坠，乱瓦横斜凛欲飘。\n惆怅曲江成陆海，淡烟空锁绿杨桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27991,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"永寿行台","author":"杨旦","text":"苦雨连宵厌客心，山风无力散秋阴。\n痴云叆叆弥层巘，脱叶萧萧下远林。\n抚景空惭诗思涩，浇愁全仗酒杯深。\n年来勋业羞看镜，遮莫霜华两鬓侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27992,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"静宁行台次壁间韵","author":"杨旦","text":"百二河山惬壮游，悠悠旌旆又偏州。\n简书有限催程急，风雨多情为客留。\n红叶满林秋色老，翠屏千叠晚烟收。\n桑弧蓬矢平生志，胸次何须著点愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27993,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过山丹","author":"杨旦","text":"笑携书剑过山丹，拂面风来送晓寒。\n流水带冰穿断岸，游尘随马上征鞍。\n绝怜塞外从军苦，始信人间行路难。\n况值仲冬天气好，归鞭指日望长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27994,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过函谷关","author":"杨旦","text":"函关遗址依稀在，涧水东流日夜声。\n世代有兴还有废，英雄埋骨不埋名。\n终童何事将繻弃，令尹犹能望气迎。\n四海车书今一统，漫劳行客候鸡鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27995,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"户曹视事","author":"杨旦","text":"关河迢递又金陵，八座崇高愧滥登。\n各省曹分官属盛，群胥鳞次簿书仍。\n廪无馀积将何赖，例有新条尚可凭。\n严立法程徵宿负，陈红应共百川增。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27996,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"退居偶书","author":"杨旦","text":"瀹茗焚香退食初，萧然一榻地卿居。\n雪消屋角松容瘦，日转檐牙桂影疏。\n曲几拂尘翻旧牍，空廊下鹊散群胥。\n位高禄厚将何补，不素餐兮重愧予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27997,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次林宫保见寄留别诸公诗","author":"杨旦","text":"客怀端不为秋悲，大老翻然去国时。\n衰凤谩劳狂叟叹，狎鸥宁向海翁疑。\n人归雁后应非晚，春到梅边尚欠诗。\n他日安车远相召，那能不出踵龙夔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27998,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归留都寓邸","author":"杨旦","text":"虚名逐逐等浮槎，节序推移感物华。\n梁上小巢初乳燕，墙头垂柳已胜鸦。\n庭无俗客诗怀好，门掩清风宦况嘉。\n笑撚吟髭成短韵，诗喉新试武夷茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":27999,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送寇中丞天叙巡抚宣府","author":"杨旦","text":"历扬中外蚤驰名，豸绣煌煌壮此行。\n最喜长才临重镇，悬知骄子避先声。\n沙头酒尽离亭晚，江上帆开画鹢轻。\n海内转输民力困，烦君一念系苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28000,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈少宰见示游牛首山诗次韵书边中丞卷","author":"杨旦","text":"谁幻山形俨若牛，登临酷爱午风柔。\n遥看树杪横青黛，小憩林阴拥碧油。\n后乘未随清兴远，旧游如梦乱峰遒。\n兹行奇绝真堪纪，逸驾应攀沈隐侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28001,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送吴?历满南还","author":"杨旦","text":"蚤年芹泮抱遗经，胄监薰陶更老成。\n共喜姓名登选牍，试看簪绂蹑云程。\n江头雨过群峰秀，蘋末风来一棹轻。\n愧我欲归归未得，送君南去若为情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28002,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"武城闻致仕之命偶书","author":"杨旦","text":"北客忽传新命下，中流急放一舟还。\n浮名已谢云霄外，公道犹存天地间。\n老遣情怀聊藉酒，閒携杖屦即登山。\n应知此外无馀事，寂寂松阴昼掩关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28003,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过钱塘江","author":"杨旦","text":"孤帆带雪过钱塘，山倚银屏水漾光。\n浦溆萦回江曲折，楼台高下月微茫。\n舟移别岸潮初上，风透疏棂夜未央。\n仕路悠悠惊岁晚，归心随梦到家乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28004,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游归宗岩","author":"杨旦","text":"山灵知我要山行，敛尽浮云放晓晴。\n已辨芒鞋穿鸟道，才倾俗耳听泉声。\n神剜鬼凿无馀力，月榭风棂有许清。\n忽忆五年前到此，依稀如梦不分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28005,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次壁间韵","author":"杨旦","text":"紫翠周遭面面峰，天然形胜众山宗。\n纵横兽伏林间石，天矫龙蟠屋角松。\n假榻每依云共宿，抱琴时有鹤相从。\n题诗人远嗟陈迹，极目秋空思万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28006,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次孙谦生子诗以志喜","author":"杨旦","text":"峭寒帘幕怯晨兴，览镜丝丝鬓雪增。\n闭户何妨常谢客，开颜今喜又添曾。\n德储先世钟馀庆，梦兆维熊协吉徵。\n谩笑老夫无所遗，吾家清白世相承。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28007,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜得家书","author":"杨旦","text":"一春顿觉信音稀，梦绕家山夜夜归。\n慈母书来无别语，丁宁未许脱朝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28008,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画牛图 其一","author":"杨旦","text":"东风吹老绿杨枝，可是春郊罢耒时。\n带雨细龆原上草，夕阳归路向迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28009,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画牛图 其二","author":"杨旦","text":"南亩功成便退身，中流游泳任天真。\n牧童何处空江晚，清世应无扣角人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28010,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀柔道中","author":"杨旦","text":"春风树树乱啼鸦，镇日山行未见花。\n田野萧条村落静，土桥茅屋两三家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28011,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白马关","author":"杨旦","text":"怪石巉巉水乱流，柳匀新绿弄春柔。\n满陂芳草眠黄犊，风景居然似建州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28012,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小圃即事","author":"杨旦","text":"池馆围春曲径通，虚檐掩映绿阴中。\n入门顿觉风光别，几树桃花隔竹红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28013,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东墅杂咏","author":"杨旦","text":"东风帘幕燕来初，习静偏宜水竹居。\n曲曲栏千时倚遍，一池新绿漾游鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28014,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"移居盘门","author":"杨旦","text":"盘门静僻暂移家，楼枕寒流寂不哗。\n怪得近来天气好，春光先已到梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28015,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乐清道中","author":"杨旦","text":"移文先报雁山灵，暂谢喧嚣向此行。\n盛境也须游历遍，莫教风雨妒春晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28016,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"金华山水暴涨登舟有作","author":"杨旦","text":"空江波浪渺无涯，茅屋深林四五家。\n却讶扁舟穿木杪，山城回首隔梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28017,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"趋朝","author":"杨旦","text":"霜华满地寒犹薄，月色半窗天未明。\n衮衮红尘行十里，东华门外正残更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28018,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"廿九日宿蔡村河下","author":"杨旦","text":"才过蒙村又蔡村，几家灯火正黄昏。\n舟中亦有饶风味，买得河鲜侑晚樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28019,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"二月朔日宿桃花口","author":"杨旦","text":"扁舟暂泊桃花口，矮屋低垣数十家。\n童子忽惊春水涨，晚潮随浪散平沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28020,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过高邮湖","author":"杨旦","text":"湖光潋滟映晴空，渔艇如梭织晚风。\n一缕青烟林外起，何人结屋翠微中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28021,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"河西登车","author":"杨旦","text":"水浅胶舟不可行，肩舆百里困风尘。\n劳劳仕路嗟无补，岸柳江花冷笑人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28022,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早起读古诗用韵写怀","author":"屠侨","text":"仲夏天郁蒸，梅雨苦不歇。\n何处望高堂，清晨梳白发。\n为客已如家，经年不以月。\n生涯谋道疏，身世逐尘没。\n何当凌风举，两手挥巨阙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28023,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大庾岭","author":"屠侨","text":"路出南安南，上岭复下岭。\n盘旋山谷间，飞鹜烟云境。\n览秀目不穷，吸清心自省。\n滔滔名利途，对此愧幽屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28024,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小梅岭","author":"屠侨","text":"我爱山中行，盘屈自有情。\n方偶涧松阴，又分溪竹清。\n石屏锦绣幅，云壑笙竽声。\n何当遇幽人，与结烟霞盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28025,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"平谷南山早行","author":"屠侨","text":"与山违日久，忽遇洒我神。\n黄鸟出谷鸣，悠然江南春。\n晴峰倚崔嵬，空翠来氤氲。\n盘旋山壑里，不见人间人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28026,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"作马厩","author":"屠侨","text":"草草立四围，骥良不以厩。\n寸地千里心，牢笼自天授。\n凡物必有居，美恶岂其覆。\n嗟彼席珍人，薜萝穷陋巷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28027,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白羊堡夜宿","author":"屠侨","text":"早发居庸城，暮宿白羊馆。\n朔风喧急柝，寒月为我伴。\n重山关隘阻，列戍旗台满。\n我皇复修文，单于正来款。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28028,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中漫书","author":"屠侨","text":"北游倦客归隐宜，东山旧券还吾持。\n红尘隘路机始息，白首馀日天所私。\n林壑夙心去靡靡，川源远路行迟迟。\n季鹰适意正如此，鱼菜扁舟同尔为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28029,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"居庸察院和韵","author":"屠侨","text":"龙飞汛扫三尺铁，修补前人幅员裂。\n大明钟鼓振边头，寂莫胡笳寒咽雪。\n关城月白明贡道，穷戍千山子孙老。\n吁嗟险阻固以形，愿望君王德不小。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28030,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送樊本明东归歌","author":"屠侨","text":"城头画角疏清晓，鸟弄玄亢声碎小。\n行人夜别指氐旋，早起房栊送茫渺。\n一春辜负行乐心，千里写遗春尾吟。\n笔端箕敛春还好，斗酒与君行处斟。\n牧牛竖儿歌我过，饷田妇女肩相荷。\n虚林日薄轻雾黄，危崔燕补旧巢堕。\n客意云边室家远，村舂花外墙壁浅。\n梵王门盛耀宸奎，部娄野旷当绝巘。\n偷閒饮兴忻胃饱，自愧宵衣常照昴。\n阳关唱毕嘱舟航，觜觿赠以代襟抱。\n忽漫相逢参与商，愀然沸我乡井肠。\n阴惨阳舒鬼神疾，君来君去杨柳长。\n前程星火莫谩忒，此意弛张须自得。\n有怀简点南风翼，发轸终筵堪记忆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28031,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚晴漫述","author":"屠侨","text":"青天寥廓行白云，一时夕景开晴曛。\n清风院宇荡炎燠，高枝鸟雀鸣欢忻。\n我坐花前北檐下，仰天看云心欲驾。\n虚空燕举掠微茫，须臾月出溪昏夜。\n黄金宝殿丽岧峣，西来诸山锦障朝。\n时雨时晴盛王理，殷勤仰止唐虞遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28032,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"兄弟同诸侄江饯","author":"屠侨","text":"我行入南海，舟发甬东潮。\n宦懒时从失，情牵路任遥。\n秋深江月白，风急客衣飘。\n缱绻家人意，酣歌斗酒饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28033,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登灵源寺","author":"屠侨","text":"南山北山曲，东寺西寺连。\n天设幽遐地，僧分自在缘。\n岩潭伏龙虎，钟磬出云烟。\n为有重游日，题诗记此年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28034,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访永乐废寺","author":"屠侨","text":"空山寺已废，寂莫枉登临。\n古殿馀茅屋，残僧倚暮林。\n溪桥自流水，云树伴孤岑。\n兴废乾坤事，因兹感慨深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28035,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十月五日过馀干阻风野泊","author":"屠侨","text":"风逆江头坐，维舟野竹边。\n荒村无物色，落日少人烟。\n尽室忧途夜，疏灯照客眠。\n一钩新月白，光景为谁怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28036,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小溪驿南行野泊","author":"屠侨","text":"蔓草清溪岸，斜阳独系舟。\n苍烟数家晚，锦树一江秋。\n凫鸭沙相并，松篁涧自幽。\n乡村有官法，鼓柝夜无忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28037,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]