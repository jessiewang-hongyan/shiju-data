[{"title":"读邯郸野老卫河谣小述三首 其二","author":"孙承恩","text":"老人诗句不支吾，为泣民穷泪眼枯。\n何当录上献天子，便是当年郑侠图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读邯郸野老卫河谣小述三首 其三","author":"孙承恩","text":"天时人事互差池，肉食谁知念阻饥。\n不用观风广咨度，但看壁上老人诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"殷墟","author":"孙承恩","text":"风木萧萧落叶多，牛羊日晚下平坡。\n狡童千载神游处，来听当年麦秀歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扁鹊墓","author":"孙承恩","text":"医圣从闻术有神，千年冢骨已飞尘。\n荒原落日西风里，犹有纷纷乞艾人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同襄阳守张士弘过习家池六首 其一","author":"孙承恩","text":"襄阳传得谪仙歌，江水无情落逝波。\n千古昔人行乐地，谁知今日我来过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同襄阳守张士弘过习家池六首 其二","author":"孙承恩","text":"风木萧萧落日曛，四山残霭乱江云。\n习家池上聊停节，一酌清泉对使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同襄阳守张士弘过习家池六首 其三","author":"孙承恩","text":"习家池馆汉江滨，长岁清泉蘸碧云。\n时移事往人何在，今日风流属使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同襄阳守张士弘过习家池六首 其四","author":"孙承恩","text":"山翁醉倒习家池，欢饮儿童翁不知。\n今日使君情更别，只来啜茗赋新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同襄阳守张士弘过习家池六首 其五","author":"孙承恩","text":"习家池上野花开，昔日衣冠今草莱。\n为问汉江江上月，几见山翁几醉来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同襄阳守张士弘过习家池六首 其六","author":"孙承恩","text":"襄阳小儿歌复咻，笑道使君稀出游。\n不是使君少风致，民艰谁识使君愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林山驿小坐口号三首初咏误谓临水故复足之 其一","author":"孙承恩","text":"地名临水原无水，只有风尘扑马鞍。\n却忆草堂三泖上，日临苔石弄潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林山驿小坐口号三首初咏误谓临水故复足之 其二","author":"孙承恩","text":"门外清流涨碧深，更多林木贮秋阴。\n何处邮亭有如此，为我斯须净客心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林山驿小坐口号三首初咏误谓临水故复足之 其三","author":"孙承恩","text":"仰看云鸟俯看鱼，林下从来得自如。\n即教此地堪娱赏，敢废王程一驻车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏答降箕青莲仙八首 其一","author":"孙承恩","text":"瀛海茫茫不可期，令威千载再来时。\n神仙踪迹谁能测，只有中天明月知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏答降箕青莲仙八首 其二","author":"孙承恩","text":"骑鲸人去几千秋，六合真成汗漫游。\n蓬莱阆苑何不住，更为人间岁月留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏答降箕青莲仙八首 其三","author":"孙承恩","text":"汉江江水故依然，抱月犹疑水底眠。\n可是耽诗馀习气，更来洒翰任人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏答降箕青莲仙八首 其四","author":"孙承恩","text":"飞行八极藐三山，万里凌风剑气寒。\n往迹眷怀犹一日，每过襄郢故盘桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏答降箕青莲仙八首 其五","author":"孙承恩","text":"凤翥鸾翔挥彩毫，天才千古仰诗豪。\n湖湘此日抄传遍，怪得新来纸价高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏答降箕青莲仙八首 其六","author":"孙承恩","text":"青莲居士谪仙人，风雅吾生仰后尘。\n喜奉新诗如謦欬，更将明月认风神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏答降箕青莲仙八首 其七","author":"孙承恩","text":"欲问先生觅大还，浮名绊我愧尘颜。\n区中甲子频惊换，自是仙家瞬息间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏答降箕青莲仙八首 其八","author":"孙承恩","text":"我厌浮名思碧山，公离蓬岛到人间。\n若教换却输公去，常与群仙相往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆儿病","author":"孙承恩","text":"几岁携家住帝畿，故园终日费心思。\n无端今日襄江上，回首长安忆病儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"看打鱼","author":"孙承恩","text":"江上观鱼倚钓滩，长风尽日荡微澜。\n好奇自是吾人僻，贪得鱼鲜不顾寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观鸬鹚捕鱼二首 其一","author":"孙承恩","text":"画舫开筵酒共传，鸬鹚出水得鱼鲜。\n莫教鼓吹惊飞去，立在滩头不上船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观鸬鹚捕鱼二首 其二","author":"孙承恩","text":"一叶波心棹小航，鸬鹚没水觅鱼忙。\n舟人拍手相惊笑，衔得鱼来尺许长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别友人吴春洲六首 其一","author":"孙承恩","text":"草阁衔杯记昔年，仕途荏苒各风烟。\n天寒落日沧江上，一笑相逢亦偶然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别友人吴春洲六首 其二","author":"孙承恩","text":"早岁相同万里心，到来踪迹亦浮沉。\n问君宦味今何似，一片青毡得岁深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别友人吴春洲六首 其三","author":"孙承恩","text":"听雨篷窗夜不眠，焚香剪烛共谈玄。\n因君忽忆脩文者，回首当时一泫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别友人吴春洲六首 其四","author":"孙承恩","text":"滥窃无能敢自欺，一官君已负心期。\n莫将踪迹论轻重，须看风波到岸时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别友人吴春洲六首 其五","author":"孙承恩","text":"寒夜空斋旧话长，不知襄郢是他乡。\n王程忽漫还分手，明日思君又一方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别友人吴春洲六首 其六","author":"孙承恩","text":"把臂相看惊白头，乡心日逐水东流。\n故园松竹闻无恙，迟子相归续旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公署偶述","author":"孙承恩","text":"古署深深闭曲房，客来不语对焚香。\n从言寒日经檐短，无事閒中亦较长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郢城道中即事","author":"孙承恩","text":"茅屋参差逐地成，高冈平陇见层层。\n若教竹木添蒙密，便是山阴道上行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有歌李太白泛洞庭湖诗拟赋三首 其一","author":"孙承恩","text":"袅袅秋风生白波，洞庭水深鸿雁多。\n露华湿衣欲归去，奈此满天明月何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有歌李太白泛洞庭湖诗拟赋三首 其二","author":"孙承恩","text":"湖上风传白苧歌，渚蒲汀柳共婆娑。\n与君赊取长沙酒，载将明月泛烟波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有歌李太白泛洞庭湖诗拟赋三首 其三","author":"孙承恩","text":"洞庭南去接潇湘，鸿雁来时天雨霜。\n目极湖心云雾里，只疑此处见英皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"并附家居泛白龙潭诗三首 其一","author":"孙承恩","text":"湖上凉风两袖生，满天星斗浸空明。\n一叶扁舟随所适，只疑今夜上天行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe4