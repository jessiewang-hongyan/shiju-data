[{"title":"送周斗垣参知入贺二首 其二","author":"董其昌","text":"谒帝恩华倍陆离，若为游子怆临岐。\n名高鼎吕熊驰后，诏赐彤弓虎拜时。\n狂客家风蓑笠在，壮夫心事宝刀知。\n同人但进千秋镜，不用牢愁拟楚词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郭宪副天谷入贺万寿二首 其一","author":"董其昌","text":"骊歌声里重踟蹰，为忆当年寄事馀。\n兼隐自开秋宪府，祝釐行指太清居。\n枫宸尚忆明光草，桃观难消月旦书。\n十载鱼肠空在袖，烟波何处式吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郭宪副天谷入贺万寿二首 其二","author":"董其昌","text":"冰壶玉尺迥无俦，清切持衡照九流。\n吏部文章悬北斗，史公留滞暂南周。\n天阶蓂荚千秋镜，幕府芙蓉八咏楼。\n圣主祈年颁瑞后，新恩定向旧人求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送唐存忆漕台还朝二首 其一","author":"董其昌","text":"新恩入典羽林军，好及清朝几策勋。\n淮海咽喉资挽粟，黄河璧马见敲云。\n即今吴甸骊驹御，恰值尧阶瑞草芬。\n何以赠行孤剑在，匝中时动斗牛文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送唐存忆漕台还朝二首 其二","author":"董其昌","text":"花骢北首五云隈，柱史承恩切上台。\n方简禁兵天策府，重瞻宸衮柏梁台。\n名高绣斧风霜肃，绩画旂常日月开。\n四海交情今自见，直词谁似孔融来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘侍御还朝二首 其一","author":"董其昌","text":"休蒲风采重明廷，又见花骢指帝京。\n三辅澄清需揽辔，九流人物待持衡。\n能无广论嗣公叔，夙有昌言轶更生。\n野史若为光祖道，祗凭班管纪勋名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘侍御还朝二首 其二","author":"董其昌","text":"昼绣萧然似荜门，经年鹏息素风存。\n安危正倚中台切，绣斧今看诏墨温。\n宦路玄黄棋局异，边陲赤白羽书繁。\n忧时敢有龙文赠，不待封章请帝阍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李易斋还朝","author":"董其昌","text":"惟将野服问仙槎，送远登临兴不赊。\n令节最怜青女月，英标犹带赤城霞。\n天门日近晨摇佩，秋省寒生午散衙。\n为报同人相讯者，五湖烟水巳浮家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱机山宫允还朝","author":"董其昌","text":"詄荡天门马首瞻，王程不为简书严。\n共言匡鼎还东观，遂有商霖出传岩。\n身切云霄亲日表，光分奎壁应星占。\n临岐何限弹冠意，漫把金华旧事拈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱比部永白还朝","author":"董其昌","text":"天际明霞拥使车，桃椎岂得问樵渔。\n弓裘自踵文昌履，竹简将成太史书。\n试拂龙泉依斗极，且含鸡舌奉宸舆。\n心知慷慨云霄别，也觉江淹赋不虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱衣白比部为尊人讼冤事竣还朝送之","author":"董其昌","text":"遄归不为锦衣游，壮尔春秋大复雠。\n疏有青霜含楚些，誓将白水拂吴钩。\n寒原得句梅花骑，渃日分襟橘柚洲。\n輶史若为酬帝问，五湖亦自起边愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘含赤中舍还朝","author":"董其昌","text":"城南别业胜河阳，又以严程指建章。\n宵直舍人还凤阁，秋征游子恋鲈乡。\n輶轩载笔书成帙，兰殿宣麻诏几行。\n见说九重勤昼接，从官容易睹垂裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送詹郡侯浚源","author":"董其昌","text":"香署专城四十强，吴都奏最汉循良。\n宁知海曲鲈羹美，遥接西川雁序长。\n五色晴云依魏阙，九皋清响动明光。\n临岐且莫歌骊驭，漫咏中和颂一章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张璇源郡侯入觐","author":"董其昌","text":"两都词赋两岐歌，神爵循良此更过。\n吾土风谣非旧日，几年江海不生波。\n趋朝人地双龙贵，上计行装一鹤多。\n野老临岐无限意，酬知惟有颂中和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35242,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张符禺吏部","author":"董其昌","text":"天门新辟日曈昽，茂宰先承湛露浓。\n巳见玺书褒卓傅，更将玉尺倚林宗。\n千秋良史看驯雉，九品何人鉴画龙。\n若向河梁听骊唱，鸣琴清响满花封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35243,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李素我侍御北上二首 其一","author":"董其昌","text":"迎秋骊御指神京，皇路将因揽辔清。\n东海泱泱循吏诵，西台凛凛直臣声。\n殿中风采古前席，柱后霜棱见里行。\n共说鹓班有孤凤，九苞瑞羽一时呈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35244,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李素我侍御北上二首 其二","author":"董其昌","text":"徵书敦趣抗高旌，应为三年试一鸣。\n元礼故如松谡谡，干将耻作铁铮铮。\n望中狄舍云飞岭，到日尧庭荚散英。\n何事临岐偏意气，补天端慰杞人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35245,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送瞿稼轩黄门应召北上","author":"董其昌","text":"瞳矇日丽大明宫，妙选才贤应诏同。\n凫舄旧标循吏传，凤毛洵美谢家风。\n昌辰瑞草尧阶上，首路梅花古驿中。\n献纳久怀天下计，封章一出掖垣空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35246,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱敬韬水部","author":"董其昌","text":"高歌骊御向秋旻，直北天门詄荡分。\n帝为遗羹怜考叔，身当叱驭答明君。\n积来风力鹏初起，再入云司雁后群。\n留取薜萝修竹径，容吾时注紫虚文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35247,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨学博弘聚北上","author":"董其昌","text":"结束征镳指帝京，眉山昆岫两峥嵘。\n东方尽奏三千牍，上国高悬十五城。\n正尔劻勷勤策士，莫将表饵当谈兵。\n曲江旧侣知馀几，却喜君家有士衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35248,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送贺使君","author":"董其昌","text":"祖道仍开卧辙馀，倾都惆怅意何如。\n太丘有子真惟肖，嵩岳生申果不虚。\n眼见淳风还畏垒，心惭通德表岩居。\n野夫未有酬知日，一卷中牟传可书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35249,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周观察斗垣二首 其一","author":"董其昌","text":"东方千骑拥楼船，执法星随北斗悬。\n正尔犁庭勤庙算，须君解网及汤年。\n鹊湖不减西湖胜，岳色遥看海色连。\n四履山川供啸咏，可能时寄穆如篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35250,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周观察斗垣二首 其二","author":"董其昌","text":"霜鸿声里动骊歌，惜别难将别赋摹。\n大海尚存知己在，阳春未许和人多。\n帝师城下寻黄石，野客衡门掩绿萝。\n宪府勋名悬日月，重瞻宫衮岂蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35251,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李伯襄太史封秦藩二首 其一","author":"董其昌","text":"持节俄将视草虚，策文仍是史公书。\n人从真气沾星使，槎泛天河上斗墟。\n明月小山丛桂侣，新秋一叶剪桐初。\n离心巳托南征雁，能到罗浮问起居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35252,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李伯襄太史封秦藩二首 其二","author":"董其昌","text":"崆峒倚剑意如何，故里题桥载笔过。\n百二山河磐石重，三千溟海积风多。\n不将昼锦先分矢，欲赋无衣激枕戈。\n当宁筹笾方仄席，邺侯勋业肯蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35253,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送侯六真侍御按黔时黔有兵事侍御兼视师之命二首 其一","author":"董其昌","text":"夜郎氛祲未全消，使者单车万里遥。\n自昔长缨曾请借，即今铜柱拟重标。\n阴符圯上书三卷，令甲明廷诏六条。\n圣主宵衣眷南顾，舞干何日罢征苗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35254,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送侯六真侍御按黔时黔有兵事侍御兼视师之命二首 其二","author":"董其昌","text":"绣衣持斧拥旌旄，戎马间关气益豪。\n报国肯回王子驭，詶知频拭吕虔刀。\n皂囊弹事风霜笔，羽扇谈兵虎豹韬。\n行矣捷书宜早奏，汉家麟阁五云高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35255,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许周翰备兵井陉二首 其一","author":"董其昌","text":"惜别离驹缓自歌，主恩经岁未蹉跎。\n称诗巳变吴风古，凭轼今麾赵帜多。\n乡思昼閒分岱色，边声秋劲走滹沱。\n江南亦有莲花府，竹马他年意若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35256,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许周翰备兵井陉二首 其二","author":"董其昌","text":"文武声光秉宪多，离歌频自颂中和。\n鲈乡不复知鱼嗜，蓬径时闻有鹤过。\n京雉五云看日近，关榆千障似星罗。\n慨慷欲绣平原否，闻道装中只五紽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35257,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郭希所符丞之金陵二首 其一","author":"董其昌","text":"閒门昼掩静如僧，俗态过从病未能。\n岂有玄言堪倒屣，漫劳虚左愧先登。\n千秋不灭孤忠疏，百折弥高隐吏名。\n我亦慨慷希大雅，忘年恰喜受交曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35258,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郭希所符丞之金陵二首 其二","author":"董其昌","text":"偶召将无忆股肱，忽看飞盖又金陵。\n渺然人物行犹及，题过江山兴复乘。\n交臂不堪燕市失，离心祗对玉壶澄。\n即今京国风尘里，若个清标似玺丞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35259,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送章公觐水部之任清江","author":"董其昌","text":"同是天涯旅梦身，若为尊酒送情亲。\n樯连江海分曹重，云近吴山戏綵新。\n不浅庾公乘兴好，还如何逊咏诗频。\n应多无恙轻帆不，秋水蒹葭一迟人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35260,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王伯高广文令南安","author":"董其昌","text":"双旌雪后度江关，仙吏风流迥莫攀。\n士仰昌黎同北斗，吾从小谢忆东山。\n路经剑浦双龙合，春入琴台一鹤閒。\n纵是官衙清若水，怀人倘寄荔枝还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35261,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蒋塞玉之任贵竹","author":"董其昌","text":"望入河桥万里情，千山寒色是王程。\n黔雁古道猿为侣，贵竹遗风象解耕。\n徼外纪纲雄汉节，车前拜舞杂蛮声。\n非君识得贤劳意，说著南中旅梦惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35262,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送万元白工部廷杖归洪都","author":"董其昌","text":"惊看血溅九重门，蹇蹇肝肠奉至尊。\n天地保持终不死，雷霆摧折岂无恩。\n冬曹物色高嵩华，南浦秋光秀澧沅。\n故里凤孤垂四纪，居然竞爽典型存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35263,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蔡元岗清卿奉使还里","author":"董其昌","text":"画鹢曾随瀫水涯，春明联事太常斋。\n咨诹边塞心偏苦，啸咏吴山梦亦佳。\n何限龙摅留赤牍，暂时鹏息寄青鞋。\n还朝好及酬功日，卢矢彤弓曰汝谐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周纂唐黄门予告归中州","author":"董其昌","text":"清蒲何事补山龙，皂服绨衣说汉宫。\n直节嶙峋看齿马，乡心迢递付冥鸿。\n千峰秀接嵩花室，五月炎消郢雪中。\n明主怀贤方侧席，肯容姬衮久居东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送冯琢庵宗伯二首 其一","author":"董其昌","text":"帝宠端臣拜庆时，恩华舄奕照东淄。\n凤毛总揽双茎秀，鹏息聊为六月期。\n子舍舞衣朱绂贵，春宫横卷黑头师。\n最怜尺五云霄近，芳岁从容引寿卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送冯琢庵宗伯二首 其二","author":"董其昌","text":"端臣将父御车年，有诏东华设醴筵。\n可但冯家论鲁卫，须知太史自谈迁。\n商山羽翼何当就，天禄图书取次编。\n最是中朝劳属望，都门未许大夫贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送阮黄门圆海省觐南归","author":"董其昌","text":"冲皇优诏重留行，堂上朱颜太健生。\n岂为调高犹和寡，谁能全注转神清。\n梦归巳执元方御，介寿还携颖叔羹。\n鹏息繇来期六月，都门离别为君轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林兼宇简讨","author":"董其昌","text":"玉节初颁下直庐，天涯岐路意何如。\n应多胜赏供诗句，不为归程滞简书。\n丝竹声中翻孔壁，荔枝花下度潘舆。\n预愁后夜长安月，那有清言慰索居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送章阳东归省","author":"董其昌","text":"珠林幸见一枝荣，无限慈帏意气生。\n待诏早承休浣命，舞衣遥慰倚闾情。\n鸰原秋冷燕丹水，乌喃春携颖叔羹。\n莫以孤臣难叱驭，板舆何处不王程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林仰晋司徒","author":"董其昌","text":"丹诏优乘六传行，都门冠盖一时倾。\n因君今日归与意，始信千秋达者情。\n事贮左垣传马史，人将北斗望羊城。\n繇来兴替关黄发，伫看蒲轮及老更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送叶少师归闽四首 其一","author":"董其昌","text":"倾都蔼蔼集歌骊，勇退三朝帝者师。\n熟釜铭功詶太传，黄金铸像忆鸱夷。\n午桥梦到悬车日，庚度秋清击榜时。\n父老相呼看归相，年来忧国鬓成丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送叶少师归闽四首 其二","author":"董其昌","text":"天边纳履动星辰，再入中书再乞身。\n山甫旧来饶补衮，任公何事早收纶。\n风传宦路轻金注，业有仙岩一玉宸。\n最是陛辞臣主意，直须良史巧摹真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送叶少师归闽四首 其三","author":"董其昌","text":"铉鼎功成释负担，飘然落叶等抽簪。\n常将不尽还天上，别有无穷在斗南。\n布袜青鞋仍几几，云关雾幌亦潭潭。\n东华赐诏彤弓宴，去国馀忠手一函。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送叶少师归闽四首 其四","author":"董其昌","text":"东山再出为苍生，公衮还初无限情。\n纵有庄周蝴蝶梦，能忘彭祖雉头羹。\n丹书进御终毗圣，攲器看来欲诫盈。\n踵武夔龙都好在，冲皇端拱泰阶平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱麟武大宗伯还会稽","author":"董其昌","text":"刺天何事有群飞，抗疏还山病亦非。\n俄尔甘盘称旧学，贤哉疏傅返初衣。\n海门秋薄胥涛壮，石纽书翻禹篆微。\n圣主宠行多异数，可知熊梦到渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑方水大宗伯归江右","author":"董其昌","text":"文昌归昼意何如，诏赐黄金六传车。\n惣为冥鸿心甚远，非关龙颡记犹虚。\n星从河曙占奎壁，剑拂秋清薄斗墟。\n等是横经当直者，冲皇频问郑尚书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郑庶常峚阳","author":"董其昌","text":"犹有英僚访漫翁，春宵觞咏月朦胧。\n祗应开径延求仲，不待寻声识郑崇。\n名著青蒲臣似矢，家传繁弱子为弓。\n云山依恋俄然事，闻道燕都巳筑宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送宋封公归齐","author":"董其昌","text":"表海重闻有太公，莺花千里送归鸿。\n因看练影临吴苑，又带琴声过鲁宫。\n南极一星辉岱麓，高岗三凤瑞河东。\n方知碧落旌幢会，即在鸣珂里第中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李太守思弦二首 其一","author":"董其昌","text":"霏霏烟雨逐征篷，御李依然梦想中。\n岂是塞翁真失马，笑看弋子慕冥鸿。\n还珠无复疑前史，积玉留将继国风。\n今日倾都攀别意，可知名手绘难工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李太守思弦二首 其二","author":"董其昌","text":"曾从黯淡听滩声，不似离歌怆别情。\n万里讵妨鸥浩荡，九关何限虎纵横。\n云来吴会春偏早，剑去延津夜几鸣。\n谁谓河梁摇落尽，一时咸诵汉西京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送萧九生方伯二首 其一","author":"董其昌","text":"左辖高名九牧钦，行装无鹤亦无琴。\n天书虽掞循良最，史笔仍摽独行林。\n他日爱人兼爱树，昔贤留犊尔留金。\n倾都祖帐骊驹路，却向禅宫见远心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送萧九生方伯二首 其二","author":"董其昌","text":"能将落叶等投簪，身试臞肥战巳酣。\n四岳云开飞斗北，两峰秋爽憩湖南。\n时逢尧舜为方伯，归事羲皇亦子男。\n见说衮衣思吉甫，可容踪迹久江潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送乔裕吾黄门","author":"董其昌","text":"夕郎何事厌承明，结束征衣节候更。\n汲孺在庭推直道，虞卿捐印见交情。\n关山岁晏黄河阔，边塞春深白草生。\n总是离愁心折处，壮君骏马太纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许使君","author":"董其昌","text":"维扬淮海锡圭馀，雅爱焚香把道书。\n拙宦十年苍水使，论交半亩碧山居。\n蠙珠总逐廉泉出，龙性真于俗态疏。\n任是风尘满天地，可能磨泐许公渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送袁微之之唐藩","author":"董其昌","text":"相国风流去见思，君谈白马又称师。\n悬知蝌蚪雠今日，绝胜邹枚授简时。\n怀人倘下陈蕃榻，吊古应歌梁父词。\n莫以京尘同宛洛，吾将重订海鸥期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴明谷还乡","author":"董其昌","text":"频将乡思上层楼，又送归鞍易水头。\n岂是途穷同阮籍，若为市隐失韩休。\n烟霜植目枫林远，独鹤迎门桂树幽。\n何处怀人最凄断，斜阳一片太湖秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王纯伯乡丈","author":"董其昌","text":"忽闻齐语变吴歈，游子归来意气殊。\n羽客山川犹记旧，马卿骑从一何都。\n七襄河汉行清浅，三伏炎蒸任有无。\n不为尘沙缓征旆，知君身寄长房壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广陵道中送戴振之表弟南还","author":"董其昌","text":"一夜春随客共归，莺花岐路意多违。\n天涯结客同修褉，物候催人几换衣。\n壮士悲歌孤筑远，离堂风雨暮钟微。\n可堪添入江淹赋，回首随堤柳絮飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广文有之任彭城者诗以赠行","author":"董其昌","text":"傲吏翛然隐射宫，星轺迢递又徐东。\n荆湖云散千峰火，萧沛秋生大国风。\n梦到吴门寻旧社，閒登汉垒笑时雄。\n亦知不尽谈经意，绪论还期虎观中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]