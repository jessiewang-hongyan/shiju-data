[{"title":"寿宫保韩质庵翁 其二","author":"林俊","text":"云水逢亨际，褒书领圣情。\n四朝余一老，三事汝孤卿。\n牢醴由天下，山庄有使迎。\n频仍真异数，鱼鸟见还惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13435,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东轩 其一","author":"林俊","text":"夜半见海日，轩深不动尘。\n简编前得晓，花草易为春。\n戚属时天宠，仙家自世人。\n交游惊老大，松鹤倍精神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13436,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东轩 其二","author":"林俊","text":"地禁春来早，风柔不作寒。\n星华当面出，桑影上帘看。\n玉树传仙种，金吾拜主官。\n朱樱承内赐，擎出紫瑛盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13437,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"腊月下旬值雪","author":"林俊","text":"一冬怀屡结，三白梦长悬。\n野色同云外，寒声落照前。\n赭山容尽换，冻海腹逾坚。\n瘗璧璇坛净，明书大有年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13438,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"癸未元日志感 其一","author":"林俊","text":"老及何能壮，心多可自由。\n感时成小出，揣分合真休。\n底里年华识，行藏药裹谋。\n一机环复外，鱼水梦沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13439,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"癸未元日志感 其二","author":"林俊","text":"主少名何谢，臣衰意自怜。\n立当三代上，遇晚十年前。\n礼乐从朝论，刑书愧俸钱。\n弼谐诸老在，拄杖对青天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13440,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元日书事","author":"林俊","text":"银烛散青烟，椒花落绮筵。\n草堂应旧雨，客舍是新年。\n未帖宜春胜，犹传守岁篇。\n西斋话凉月，刚后两回圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13441,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书感呈少师石翁 其一","author":"林俊","text":"历服灵长会，艰虞镇定身。\n天休当此日，国是属何人。\n大手弥纶地，洪钧发育辰。\n金鸡传诏下，枯槁遍为春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13442,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书感呈少师石翁 其二","author":"林俊","text":"主圣开昌运，臣劳效匪躬。\n功高元不赏，道大亦难容。\n钟鼎完名外，衣冠老泪中。\n慰留天地德，残梦逐东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13443,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"芝草","author":"林俊","text":"紫玉阿房种，青霞洞府英。\n孕祥峰五癸，观象日三庚。\n长养元阳护，孤芳弱肉争。\n汉庭书上瑞，深谷漫藏名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13444,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"教周 其一","author":"林俊","text":"诗礼甄陶下，居然土木人。\n几缘通汝慧，仅未失吾真。\n学苦终能变，心专自有神。\n愚柔功百倍，力久待知新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13445,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"教周 其二","author":"林俊","text":"气质元庸下，诗书况若仇。\n满盈吾故惧，巽懦汝终忧。\n及远期前步，终迷怪下流。\n玉成在贫贱，莫漫贵家羞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13446,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭三江宫傅 其一","author":"林俊","text":"循墙深敛戢，岣嵝类寒微。\n位极公还命，名完世独归。\n竟陵传大玉，台斗赋缁衣。\n笠泽阴晴外，平芜带远矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13447,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭三江宫傅 其二","author":"林俊","text":"匪石心还壮，如虹气渐微。\n别来黄鹄伴，赋得紫芝归。\n凤阁传遗表，麟袍感故衣。\n祝天酬百顺，烟水欠鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13448,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭三江宫傅 其三","author":"林俊","text":"化及形神异，心多气力微。\n凤衔中诏下，鹤伴旅魂归。\n岩菊空修谱，江荷枉制衣。\n鲈乡还往日，鸥鹭暗前矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13449,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭三江宫傅 其四","author":"林俊","text":"亡琴怜旅息，绝笔寄公微。\n脩短元前定，哀荣此大归。\n易名题处额，就木赐时衣。\n秋水吴莼约，湖风冷故矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13450,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送蒋子云守南阳","author":"林俊","text":"节概西曹彦，文章太守临。\n朴忠元故俗，风雅自遗音。\n探虎时看壮，悬鱼迹许寻。\n五朝稽德在，如玉又如金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13451,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠王应时 其一","author":"林俊","text":"穷愁收蚤遇，艰大寄孤生。\n行谊传京国，词华动海城。\n旅魂天正黑，枯泪夜曾明。\n回雁西风急，含凄数驿程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13452,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠王应时 其二","author":"林俊","text":"北极悬深恋，东行感至尊。\n自怜臣计迫，不道吏书繁。\n力尽还伤往，心多更食存。\n百蚕能一叶，人纪信须敦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13453,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送祝虚斋子师谟令南丰","author":"林俊","text":"接席缘终欠，传心学许同。\n龙飞符上瑞，鸡割寄南丰。\n朴质名家训，敦庞太古风。\n不禁兵燹地，百意念民穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13454,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠阎泉川","author":"林俊","text":"事激言逾壮，居夷性转谙。\n日将辞阙下，天与看滇南。\n卑散藏深地，冲虚悟往庵。\n曲成关造物，兹意重谁谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13455,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"溪阁写怀 其一","author":"林俊","text":"溪阁閒烟水，樵渔答是乡。\n诸峰会平野，老树纳初阳。\n鱼鸟风云气，林邱海岳肠。\n回澜宽买榜，松桂亦吾庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13456,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"溪阁写怀 其二","author":"林俊","text":"雨啬麦犹短，春寒荠始青。\n过墙梅似豆，应候草如蓂。\n岁积瓶中记，官征火处听。\n俯流心自领，无语答川灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13457,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云庄偶怀 其一","author":"林俊","text":"石屋忘年纪，霜松记十围。\n壮容惊变尽，迂叟是真归。\n局小一庄足，名逃百世希。\n山盘开野水，新雨蕨芽肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13458,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云庄偶怀 其二","author":"林俊","text":"风雨睡曾着，幽明重百心。\n龙归先有洞，鹿触故成林。\n遗蜕忧时遇，孤庐恍夜临。\n更阑销烛短，凉泪落衣襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13459,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云庄偶怀 其三","author":"林俊","text":"野寂含幽意，神衰著饱眠。\n丹成淹日月，树老怯风烟。\n里耳声华异，山人礼数偏。\n世坌期谢绝，无路属夤缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13460,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云庄偶怀 其四","author":"林俊","text":"立海风涛壮，漫山草木稠。\n厓虚云一寄，洞古径通幽。\n事适仙翁左，身随野鹿游。\n仰高名故在，吾老意悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13461,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"农夫苦 其一","author":"林俊","text":"草露耕常早，鸡声曙起东。\n星流天过白，日出海翻红。\n栉发催牛饭，编篱放鸭笼。\n一区酬事分，辛苦不言功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13462,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"农夫苦 其二","author":"林俊","text":"戴星凭出入，独力强支持。\n正苦催租急，翻悬散种迟。\n地硗收转薄，岁熟喜还悲。\n稠粥猥情事，来尝未有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13463,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三慰篇 其一","author":"林俊","text":"穷年淹散宦，甫月侍清班。\n野旷云平出，林孤鸟共还。\n买山曾有具，涉世本无官。\n写易青峰下，樵流识故颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13464,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三慰篇 其二","author":"林俊","text":"御风来海郡，解佩下仙班。\n上德乾坤大，时贤旦暮还。\n觅音二仲径，过岭大苏官。\n终局吾流分，名高不愧颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13465,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云庄漫语 其一","author":"林俊","text":"景奇山独占，吾道不终穷。\n玄鹤心千里，青牛地几弓。\n回澜芳渚月，归袖舞雩风。\n三影塘前见，依然似瀼东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13466,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云庄漫语 其二","author":"林俊","text":"云寄谁留在，山深不记年。\n树根行暗壁，石隙逗晴烟。\n碧雨松为盖，沧洲海化田。\n时平慰迟暮，馀日理陈编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13467,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过真馆 其一","author":"林俊","text":"少华幽栖处，青霞几静功。\n松脂传辟谷，羽服舞回风。\n小有仙都观，清虚紫极宫。\n五芝前道路，荒棘桂花丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13468,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过真馆 其二","author":"林俊","text":"少室秘青烟，空流了道玄。\n玉书方外检，鸿宝枕中篇。\n吐纳曾留诀，神仙祗谩传。\n晚晴看逝水，篝火梦三川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13469,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"素洞偶成","author":"林俊","text":"突兀层云上，青梯百丈馀。\n幽阴疑穴处，亢爽胜楼居。\n薄有苍精气，犹存古篆书。\n质风锼凿外，浑沌副逃虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13470,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云庄感事 其一","author":"林俊","text":"咄嗟成感遇，深窈谢人寰。\n宿鸟馀残梦，归云已故山。\n衣冠今寂寞，岭海路间关。\n凭藉乾坤力，同时许赐环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13471,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云庄感事 其二","author":"林俊","text":"待尽嗟何及，居閒意独申。\n如神昭圣武，无事扰庸人。\n礼乐都俞会，肝肠报荅身。\n纲常终定在，虚己听重陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13472,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄何燕泉少宰 其一","author":"林俊","text":"来盈占候燕，失爱问前鱼。\n世有千金璧，公犹万卷书。\n仙踪移旧国，廨宇类幽居。\n树影閒庭月，晴光满太虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13473,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄何燕泉少宰 其二","author":"林俊","text":"帝宸方发曙，卿月下层霄。\n野色高低树，江声来去潮。\n碧山容露冕，瘦鹤认风标。\n相忆回澜夜，渔歌第几桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13474,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再寄燕泉 其一","author":"林俊","text":"老至食无味，人间梦未清。\n数更成夜寂，来雁带秋声。\n海国书难寄，山堂月转晴。\n美人江上路，伐鼓看潮生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13475,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再寄燕泉 其二","author":"林俊","text":"交游心转结，离别梦相牵。\n南岳应千仞，东华仅隔年。\n星辰违听履，风景类登仙。\n读罢希文记，高楼思渺然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13476,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"招白庵丰太史口占 其一","author":"林俊","text":"迥野行梧竹，从天降凤凰。\n世谁三昧手，客有四明狂。\n后学还蓍蔡，中朝自纪纲。\n海峰重系恋，春色又归航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13477,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"招白庵丰太史口占 其二","author":"林俊","text":"世缘深摆脱，道味故相亲。\n驭鹤来仙侣，烹葵预主人。\n碧霞寻野寺，青雨湿山巾。\n北极肝肠共，清霄入梦频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13478,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨亟溪流百丈赪山为市者失千金偶成 其一","author":"林俊","text":"雷雨分霄亟，溪流四望交。\n熊应蛟并穴，鹜与鹊争巢。\n没舍留残脊，沈洲见断茅。\n江心愁外寺，虚阁且僧庖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13479,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨亟溪流百丈赪山为市者失千金偶成 其二","author":"林俊","text":"雨积疑天漏，溪高诧陆沈。\n赪山劳竟岁，袖手失千金。\n豺虎深时见，风涛乱敢寻。\n楚弓还楚得，子母漫经心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13480,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"回澜","author":"林俊","text":"回澜放晴夜，虚敞足清游。\n野旷月临水，天低星近楼。\n村醅隔萝径，樵笛下溪舟。\n挂席高寒外，心多可自由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13481,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿山","author":"林俊","text":"洞壑通幽径，香蒲养静庵。\n几传修白业，一宿悟玄谈。\n老坐瓦完愧，时怀舍退惭。\n曲阑春未暮，花日尚红酣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13482,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和寄丰太史原韵 其一","author":"林俊","text":"直院随金马，清班缀赤凰。\n忽先怀疏入，竟蹈引裾狂。\n孝理关名教，王猷翊世纲。\n河神风己北，转息送归航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13483,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和寄丰太史原韵 其二","author":"林俊","text":"雷霆身独犯，风鸟梦相亲。\n似有仙留诀，时传语动人。\n大官黄醥酒，少室白纶巾。\n俎豆閒兵略，雄心拭剑频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13484,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"久雨次雪斋 其一","author":"林俊","text":"阻绝几曾出，艰虞念远村。\n衾裯空夜市，桂玉断晨飧。\n如马风涛壮，鸣蛙野水浑。\n一晴酬岁望，脉脉重谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13485,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"久雨次雪斋 其二","author":"林俊","text":"床褥动弥月，檐声不断流。\n何时见山色，于我若云游。\n瓶粟尽穷日，窠雏委漩沤。\n不因炎德会，风雨暗行秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13486,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次张方伯两山登麻姑山","author":"林俊","text":"踏云看直上，万象入搜罗。\n鹤驭昔曾到，仙关近若何。\n蓬莱行复浅，瑶草拾还多。\n五老峰前社，时时梦一过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13487,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郭侍御世重以言落职兼程慰其母安人","author":"林俊","text":"沥血匡时疏，回肠慰母情。\n江山连故郡，昏晓戒兼程。\n升落等残梦，艰危剩此生。\n精忠良柱史，暂尔圣人氓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13488,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春候","author":"林俊","text":"九十阴晴半，丹青画作殊。\n发生良自异，造化本无拘。\n野水梅初豆，僧厨笋正酥。\n葛巾閒载鹤，独楫老江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13489,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋候","author":"林俊","text":"萸菊感物候，星河自古今。\n最怜清欲绝，重觉梦相寻。\n范老先忧记，元公太极心。\n亏成浑事外，吾意在吾琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13490,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"有怀","author":"林俊","text":"岁局临青野，星台切紫墀。\n传心严虎豹，辨色引旌旗。\n主圣臣贞会，河清海晏时。\n大廷兴礼乐，接武重皋夔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13491,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"丹桂","author":"林俊","text":"凉入金风利，香浮玉树幽。\n月移天上种，名动世间秋。\n炎德文昌盛，丹砂火候柔。\n赏心惭酒分，晴倚水西楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13492,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜起","author":"林俊","text":"长夜睡曾著，行庭思转清。\n城乌临远曙，楼雁过高晴。\n客子木绵敝，居人水火争。\n时平盛禾黍，一饱答西成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13493,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"二泉秋月相忆并及无书次答 其一","author":"林俊","text":"露重夜如沐，秋高意转深。\n江湖千里月，吾汝两翁心。\n影落岩前桂，情移海上琴。\n附书元不薄，末疾故相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13494,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"二泉秋月相忆并及无书次答 其二","author":"林俊","text":"离合天为限，交游思许深。\n秋声行木秒，月色到庭心。\n老大消残局，亏成托素琴。\n小山丛桂在，咫尺绝幽寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13495,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"有感","author":"林俊","text":"野水归云薄，林花应候新。\n松枝留海日，衣袖落京尘。\n社会闻村鼓，仙班拱帝宸。\n一邱谋老地，耕凿太平民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13496,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠周谏议两山 其一","author":"林俊","text":"少室留云在，方壶日到初。\n地炉烧野笋，麦饭荐溪鱼。\n澹老传封事，班生得例书。\n卷舒吾道在，烟水话樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13497,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠周谏议两山 其二","author":"林俊","text":"野梅香正结，素洞暖初开。\n扫径閒云识，从天旧雨来。\n棘篱催过酒，沙鹤引登台。\n人意仙灵会，披衣坐紫苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13498,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"萧侍御两湖纡道云庄短章为别 其一","author":"林俊","text":"薜荔巢居小，青骢柱史临。\n怀虚贪得士，调绝副知音。\n风雅酬前话，云泥结素心。\n酸咸浮迹外，纡道故相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13499,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"萧侍御两湖纡道云庄短章为别 其二","author":"林俊","text":"白笔簪逾劲，青萍价旧高。\n分行八巡使，特枉四程劳。\n鸡黍延山月，鱼龙壮海涛。\n乾坤无限在，吾老分林皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13500,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再用前韵答周两山 其一","author":"林俊","text":"逸才追白后，近作胜黄初。\n殷篆存辛枕，周篇别亥鱼。\n谏垣时有疏，政府故无书。\n剜肉医疮会，犹容竭泽渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13501,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再用前韵答周两山 其二","author":"林俊","text":"别况久逾积，孤怀重一开。\n梅传疏白后，山送远青来。\n审像凌烟阁，披衣步月台。\n杜门深简出，阶老绿莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13502,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"修省志喜","author":"林俊","text":"宣室求言诏，虞廷献纳篇。\n遇灾容有此，责己重无前。\n国步风神壮，途谣雅颂传。\n漏声朝百辟，蜡炬引经筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13503,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夕次山斋韵 其一","author":"林俊","text":"更始三元盛，穷宵一例除。\n寓形空老大，阅岁属孤虚。\n海郡传新历，桃符易旧书。\n浪仙劳酒脯，诗草谢芟锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13504,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]