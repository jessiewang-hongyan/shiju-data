[{"title":"山水图为造士陈叔能书","author":"王恭","text":"屋上群峰旧隐居，澹云凉月午窗虚。\n满庭芳草人稀到，半亩黄精手自锄。\n积水断桥寒鸟外，夕阳鸣磬夜霜初。\n泮林莫羡苏门啸，未许寻山共结庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34747,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"辛巳九月邑大夫率僚佐及群士燕六平峰","author":"王恭","text":"薜萝迢递隐仙都，簪佩登临载玉壶。\n关树早霜秋外落，奥河寒笛雁边孤。\n红泉翠壁人皆醉，绿酒黄花晚更须。\n此会明年谁最健，重寻山水采茱萸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34748,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉和国子先生郑孟宣退朝听莺之作","author":"王恭","text":"蓬莱佳气满瑶京，禁柳青青听曙莺。\n辇路乍闻千啭晓，春风遥度万家声。\n近随天仗和鸾驭，散入云门间玉笙。\n不独清平歌此调，高台还有凤凰鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34749,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书闽郡照磨江右曾公秩满之京便道省亲卷","author":"王恭","text":"欲赋莱衣未有期，且将簪弁恋明时。\n三年考满孤琴在，千里宁亲一鹤随。\n建水暮帆钟杳杳，楚城寒雁树离离。\n过家暂醉西江酒，莫遣都门疋马迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34750,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈乐舞省墓归闽复还天京","author":"王恭","text":"宫县声绕凤台春，万舞雍容对玉宸。\n华表忽惊千岁别，恩波遥借一归人。\n边淮独树斜连海，故陇寒楸远入闽。\n莫向尘中成久别，太平天子重明禋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34751,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题姑苏王仲瑚松陵展墓图","author":"王恭","text":"花县宁亲著綵花，松陵回首念荆扉。\n乡心正逐吴云断，离思偏逢朔雁稀。\n丘陇蓬蒿随处没，边头风雪几人归。\n明朝疋马姑苏道，遥望松楸入翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34752,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题玉融郑伯勋龙江环翠楼","author":"王恭","text":"旧游西上久从官，何事楼居尚考槃。\n近郭雨深千树绕，沧波云尽数峰寒。\n帘前落叶兼秋听，笛里飞鸿拂曙看。\n好是瑞岩僧磬晚，满衣清露更凭栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34753,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玉融潘原润将义葬其师黄山陈平叔一日持广赙集过予愧贫不能助遂赋此以赠之","author":"王恭","text":"布衣相对两忘贫，共忆黄山泪满巾。\n高士姓名因有传，中郎书籍与何人。\n墨池雨冷苔空积，笔冢秋深草自新。\n惆怅一杯何所寄，唯应高谊独悲辛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34754,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"简曾伯刚","author":"王恭","text":"逢君倾盖转销魂，多少离心不忍论。\n白首异乡无旧业，青山衰草闭閒门。\n关河夜雨频惊梦，雕鹗秋风久负言。\n莫向樽前同感慨，旧游能有几人存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34755,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"屿南宿别贡士林执中","author":"王恭","text":"红烛离堂酒半醒，骊歌今夕若为听。\n故人好是身随桂，浮客空嗟迹类萍。\n花屿晚钟湖上别，凤台春树梦中青。\n应知昼绣长林下，白首还来到玉瓶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34756,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"癸未元日简龙门高漫士","author":"王恭","text":"喜得春回共酒期，醉来持镜转堪悲。\n年惭伯玉知非晚，身笑相如见遇迟。\n衰鬓又逢残腊后，劳生几度改元时。\n遥怜小隐龙门下，应对椒盘独咏诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34757,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠林士仁服阕赴京师","author":"王恭","text":"秋衾铜辇梦来稀，墨绶新县映赭衣。\n风木不堪寒夜听，寒鸿偏向别时归。\n晴天入楚千峰出，积水边淮独树微。\n想到凤台朝觐后，宦游何处念春晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34758,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题萧将军家藏山水图得青字","author":"王恭","text":"十年身被白云留，见尽青山到白头。\n微雨数峰孤磬夕，半林残火几家秋。\n风波不系袁宏棹，鱼鸟相怀谢尚游。\n闻道将军戎暇日，偏能看画想沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34759,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"越山秋色送秦校尉还观海军","author":"王恭","text":"稽峰閒望赤城标，霞气苍茫水雾消。\n独树过江吴地尽，断云归海楚山遥。\n空林木叶惊秋雨，极浦鸿声带晚潮。\n相约买舟寻贺老，知君终事霍嫖姚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34760,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送林叔仁计阶之京","author":"王恭","text":"泮林官满欲趋朝，况值金门早见招。\n粤国青山江上别，秦淮秋水雁边遥。\n砧催帝苑霜初落，马度官城叶渐飘。\n若得浮丘书信便，为言衰老尚渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34761,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠林汉孟赴召天京","author":"王恭","text":"七峰岩下旧逃名，何事輶轩赴上京。\n白首相逢萍梗别，青山谁共薜萝情。\n疏烟野火丹阳骑，远树春风白下莺。\n想到都门知己在，南宫西掖有逢迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34762,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题吴景元江皋云卧","author":"王恭","text":"宦游西上正纷纷，何事江皋独卧云。\n梦里杜兰随意绿，镜中鱼鸟向人分。\n潮归沙馆当窗见，渔唱枫洲卷幔闻。\n身外浮名都不系，唯应林叟得逢君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34763,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和林孔逸见寄之作","author":"王恭","text":"西岩爽气乱峰头，此地曾陪静者游。\n雨霁珠林芳草遍，春深兰若落花幽。\n清池白石俱禅意，野服黄冠半道流。\n自愧浮生无住著，飘然江上一孤舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34764,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送刘监生还京","author":"王恭","text":"官船一棹大江流，才子还京赋远游。\n帆带夕芜依御苑，梦随凉月到家楼。\n长淮雁影催寒曙，近郭砧声报晚秋。\n此度金门应早达，莫令乡舍久淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34765,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送浮丘郑先辈被命重赴京师","author":"王恭","text":"丹阳京口暝烟收，几度劳歌送客游。\n吴岳晓连秋雨碧，御河寒带雁声流。\n衣冠召对金门里，文翰周旋玉案头。\n闻道汉庭深顾问，承平不遣贾生忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34766,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别林孔逸从蓟丘军","author":"王恭","text":"越城砧杵暮纷纷，多少閒情此送君。\n别路寒山惊落叶，深秋孤雁忍离群。\n苏门日照霜中树，羌笛寒凄塞上云。\n闻道汉南曾独立，也将书剑去从军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34767,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄凤池故人钟大","author":"王恭","text":"谷口遥钟半掩门，疏灯空馆住荒村。\n棕榈叶上惊新雨，砧杵声中忆故园。\n多难未销豪杰气，长贫难荅旧交恩。\n凤池月色歌钟里，应念残山独听猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34768,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书延平王将军闽山胜览卷","author":"王恭","text":"远携兵印镇南州，山水青青马上游。\n玉帐醉看华顶溜，雕弓閒挂剑潭秋。\n双溪树底泉声合，九曲花边瘴雨收。\n自是承平多胜事，七闽应许擅风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34769,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄沧洲狂客","author":"王恭","text":"三年憔悴得君怜，君上青云益惘然。\n客里思乡何日到，天涯见月几回圆。\n未期岁晚同携手，预恐新正对别筵。\n贫贱独惭无可赠，临岐空忆绕朝鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34770,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉荅陈沧州","author":"王恭","text":"白发沧洲似者稀，瑶华应愧寄林扉。\n每怜独客如萍梗，更有何人惜布衣。\n梧叶满庭残暑退，青山对酒小凉归。\n莫愁璧水音尘远，早晚关河候雁飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34771,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄刘大","author":"王恭","text":"閒宵灯里梦刘郎，梦觉还惊是两乡。\n孤馆几回江上月，流年空度镜中霜。\n青蒲野水林扉静，黄鸟山亭酒瓮香。\n遥想丘园多乐事，也应飞札慰离伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34772,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留别黄山周氏兄弟","author":"王恭","text":"候馆逢霜落叶深，更堪憔悴对青衿。\n荒村野水残阳路，远树孤云故国心。\n绝地也怜频送酒，情多谁忍更分襟。\n惠连群从皆清俊，别后相思总解吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34773,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"文笔山房为延平郡造士朱员赋","author":"王恭","text":"文笔山深隔翠微，清晖迢递映书闱。\n门临绝涧逢人少，帘捲孤峰见雁飞。\n四壁泉声喧午梦，半檐藤影落秋衣。\n镡津自昔多才俊，词翰如君世所稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34774,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽黄山周正卿","author":"王恭","text":"与君相识便相知，却叹相逢最后时。\n沧海几回明月夜，黄山终负薜萝期。\n秋风野水寒猿断，落叶荒原吊客悲。\n遥想泉台今不恨，传家应有凤毛奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34775,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书番阳戴氏侍萱堂卷","author":"王恭","text":"乐平才子旧知名，曾是清朝被宠荣。\n萱草别来应有梦，白云频望不胜情。\n关河迢递娱亲舍，铜绶淹留近海城。\n他日锦衣归省去，故园鄱水有馀清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34776,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"欧阳明府江上草堂","author":"王恭","text":"青原山上草堂开，竹杖黄冠日往回。\n雨过新潮低卷幔，云连孤嶂落衔杯。\n闻棋每忆林间榻，静钓还思石上苔。\n佳政秪今人共说，未应陶令赋归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34777,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题晦之城南秋堂","author":"王恭","text":"汾阳孙子久忘机，万卷经书隐翠微。\n闭户不知秋叶落，卷帷时见白云飞。\n岩花色映乌纱帽，涧水声寒薜荔衣。\n想是过庭趋讲暇，也应城市往来稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34778,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题郑浮丘碧蕉书馆","author":"王恭","text":"郑老心閒却忘官，泮林唯对碧蕉閒。\n盈轩色映乌纱帽，拂几凉生苜蓿盘。\n半榻秋声寒外落，一帘幽梦月中残。\n杜陵野老时相问，应遣题诗叶上看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34779,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玉融陈氏怡怡堂","author":"王恭","text":"魏帝连枝不共荣，淮王斗粟若为情。\n风霜况是同根蒂，骨肉应怜好弟兄。\n山色晓帘沙雁白，海天秋屿雪鸪鸣。\n合欢也似姜肱被，长奏埙篪酒共倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34780,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题江山烟雨图","author":"王恭","text":"梦渚苍苍入楚烟，岳阳南面雨如悬。\n人家寂历青枫外，仙峤空濛独雁边。\n飞阁迥临闻笛处，微钟遥到钓鱼船。\n孤帆莫向潇湘浦，云暗苍梧水泊天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34781,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵答黄嗣杰","author":"王恭","text":"满林乌桕飘残臈，独客关心漫倚楼。\n几处移家惊落叶，十年归梦在孤舟。\n青塘野鸟当窗白，积雨寒山卷幔幽。\n何似董湖高隐处，朝朝巾舄与同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34782,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题郑克曼复睢阳军手卷","author":"王恭","text":"绿发辞乡白发归，远因行役问庭闱。\n离心又惜连枝别，愁思仍随独雁飞。\n汴河霜落寒砧早，梁苑烟空晚树稀。\n行到洛阳秋色后，柳营长是忆春晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34783,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题澹游雨竹图","author":"王恭","text":"孤舟凉雨楚溪头，叶叶寒声镜里秋。\n湘水夜传金奏响，郢云朝拂玉英流。\n空香暗逐王孙梦，残粉深关帝子愁。\n鸣凤不来春杳杳，为谁遗牒向中洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34784,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送粮长林思器赴召京师 其一","author":"王恭","text":"王贡曾稽夏禹篇，汉庭输饷独推贤。\n遐方已献编民数，大姓应操赋粟权。\n千里山河趋魏阙，一帆秋水入吴天。\n枫墀若听纶音后，归兴西风白雁前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34785,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送粮长林思器赴召京师 其二","author":"王恭","text":"酒尽沙头白玉瓶，海云关树远行经。\n孤舟落叶丹阳渡，残笛秋风白下亭。\n三楚人烟天外小，六朝山色雁边青。\n怜君此去应观国，行听韶音到广庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34786,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送林思隐之金陵","author":"王恭","text":"布衣何事欲朝天，螺渚霜空见发船。\n闽树晓关分楚泽，越城寒火接吴烟。\n白门酒熟谁同醉，华馆灯孤笑独眠。\n阙下名公多旧识，莫令归兴后春前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34787,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同沧洲翁答高漫士兼寄高牧隐","author":"王恭","text":"多病文园兴未休，沧洲鱼鸟待君游。\n花边复扫留徐榻，矶畔空期访戴舟。\n渤海诗名今独步，蓝田牧兴世争求。\n悬知牧隐风流在，共醉清晖半占秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34788,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"耿将军具庆堂","author":"王恭","text":"曾逐嫖姚立战勋，汉庭方识耿将军。\n千钟已遂荣亲愿，一剑常思报主勤。\n花拂莱衣春尚早，月明姜被夜初分。\n东吴此乐应稀少，忠孝于今几处闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34789,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日寄王介轩先辈","author":"王恭","text":"林下萧条隐角巾，黄花时节忆同人。\n陶潜解印宁辞倦，苏晋长齐岂是贫。\n华发流年看独变，青山明月梦来频。\n近闻筹谷多仙赏，忘却沧洲野水滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34790,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄林彦衡训迪嘉禾","author":"王恭","text":"欈李山川接上腴，鱼盐粳稻满东吴。\n横经不道官犹冷，禄薄还堪酒屡沽。\n霜落乡林思旧橘，秋深江郭忆寒鲈。\n绨袍别后情何限，莫惜新吟寄野夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34791,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵答王介轩 其一","author":"王恭","text":"曾是天池缀晓班，绣衣行郡远人欢。\n秋风忽梦柴桑柳，故畹还歌楚泽兰。\n匣里吴钩谁复羡，尊前郢曲和皆难。\n佳期忆在来清馆，共对榕霜五夜寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34792,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵答王介轩 其二","author":"王恭","text":"懒慢唯应漉酒巾，鹑衣无计合时人。\n一瓢陋巷谁能问，四壁秋风独忘贫。\n北阙青云随梦远，西山明月忆归频。\n卜邻幸与沧洲近，又欲移家住海滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34793,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送郁判官秩满之天官","author":"王恭","text":"东胶冠盖旧称贤，佐郡曾分刺史权。\n官署到来应似水，礼闱今去独朝天。\n家临故苑长洲树，钟度寒山半夜船。\n遥想五云霄汉上，从容又赋帝京篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34794,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书王明府家庆","author":"王恭","text":"几年戎马怅分飞，此日君恩赐独归。\n张掖寒云行处满，鲁城霜雁别来稀。\n西江买棹寻花县，南国趋庭换绿衣。\n官满他年应昼绣，吴门乡树碧依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34795,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠邑造士陈汝登之军中","author":"王恭","text":"汉家烽火在边庭，才子西行独请缨。\n自是寸心怀补报，也将孤剑学从征。\n天门久欲陈三策，沙漠今看论五兵。\n莫对泮林愁此别，他年还著锦衣荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34796,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"典幕席上同高漫士奉和王尹元旦密州忆子诗","author":"王恭","text":"张掖何人独冠军，远随征骑入边尘。\n天涯柏酒愁中断，寒尽椒花客里春。\n鲁国山河应独望，甘州风物更谁亲。\n斑衣此日棠阴下，骨肉何须叹越秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34797,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉寄龙门高漫士牧隐二先辈","author":"王恭","text":"玩宇平临半占峰，清晖遥映翠微松。\n云来鸡屿应还倦，鸟下龙门去亦慵。\n池草任随吟处长，江花偏待醉时逢。\n十年自笑无家别，谁念沧浪远寄踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34798,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽陈方山先辈","author":"王恭","text":"七闽冠盖盛繁华，白首温陵独寄家。\n爱客尚悬高士榻，隐居唯种故侯瓜。\n归魂杳杳乡林晚，旅榇迢迢驿路赊。\n谁料别来成叹逝，九原长望使人嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34799,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄别陈志鸿罢官归高凉 其一","author":"王恭","text":"解印行歌出将营，千军流泪共含情。\n邹阳书上谁称屈，王粲才高赋谩成。\n天连故国铜鱼远，霜落寒江白雁鸣。\n自愧神交惊此别，不堪离恨更沾缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34800,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄别陈志鸿罢官归高凉 其二","author":"王恭","text":"得官何似罢官閒，闽海秋风一骑还。\n五岭黄茆通驿路，百城寒水接乡关。\n离心不醉霜中柳，归梦应寻鸟外山。\n闻说旧游多鹗荐，未应空老薜萝间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34801,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浮丘郑公国子助教余病不能饯寄诗以别 其一","author":"王恭","text":"成均典教遂忘机，圣主恩深许暂归。\n疋马又从江上别，孤舟还向雁边微。\n初霜落叶惊吴苑，夜火寒砧入帝畿。\n自笑不才逢盛世，故山空老薜萝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34802,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浮丘郑公国子助教余病不能饯寄诗以别 其二","author":"王恭","text":"荒居病起对空林，邻笛谁堪折柳音。\n白首襟期惊是梦，沧波离别惜同心。\n梨关月出鸿声小，笠泽天寒骑影深。\n遥想圣朝多雨露，未应官冷解朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34803,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题松山司警余公海城春意","author":"王恭","text":"曾劳弓剑事边尘，复绾铜章领徼巡。\n匹马向经吴地雪，一官遥寄越城春。\n莺花水镇朝衙静，虾菜江乡夜逻频。\n三载铨闱应不负，定知霄汉沐恩新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34804,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠琉球典簿程氏赐归番易","author":"王恭","text":"冠带趋朝沐宠光，曾将声教化夷王。\n扶桑东际非吾土，彭蠡西流是故乡。\n白首还家江上骑，青山独对雪边房。\n悬知陆贾风流在，不羡裴家绿野堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34805,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈履中侍大父入京","author":"王恭","text":"君家大父远朝京，念尔辞家侍此行。\n绿酒红亭西上路，白云乡树故关情。\n孤帆夜落秦淮水，双阙时闻禁邸莺。\n莫道重闱今别去，乡人遥待锦衣荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34806,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽江山陈仲晋","author":"王恭","text":"墨绶新悬鬓己皤，宦游西上易蹉跎。\n青山竟掩孤坟在，浮世仍传并秀多。\n门柳不堪愁里赋，琴台谁忍醒时过。\n愧无公子鱼肠剑，挂向空林野树柯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34807,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送闽藩从事考满","author":"王恭","text":"西游怅饮气偏豪，多少同声惜户曹。\n别路断鸿将去棹，乱山残雪送征袍。\n蓬莱春近莺声早，阿阁云开凤影高。\n明到五门朝觐后，相思空有梦魂劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34808,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠陈逸民","author":"王恭","text":"万事忘机一布裘，似君宜向古人求。\n秋风几度惊双鬓，夜梦无应到五侯。\n多暇兴来犹散帙，老年身倦少登楼。\n蔡家尚有文姬在，对酒当歌且莫愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":34809,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]