[{"title":"送月空上人四首 其二","author":"孙承恩","text":"惨淡乾坤动杀机，海邦经岁战尘飞。\n功成今日还归去，独向山中补衲衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送月空上人四首 其三","author":"孙承恩","text":"一锡飘然似野云，禅衣犹似带征尘。\n公家将卒成何用，却教山僧立战勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送月空上人四首 其四","author":"孙承恩","text":"云山归去扫烟萝，行役都忘岁月过。\n尽敛从来雄烈性，蒲团终日礼弥陀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重午会客自慰","author":"孙承恩","text":"细缕菖蒲满泛杯，劝君乐饮莫辞推。\n贴天风浪江湖里，几个舟行得善回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与友人求竹本","author":"孙承恩","text":"老去归来卧白云，诛茆端欲植苍筠。\n岁寒倚雪当论世，子有千竿合为分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴之山还姑苏三首 其一","author":"孙承恩","text":"踪迹江湖不惮劳，壮怀随处托风骚。\n即看上国游观去，会说东吴纸价高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴之山还姑苏三首 其二","author":"孙承恩","text":"潞河东去水瀰瀰，绿满汀洲草色齐。\n客邸风尘留不得，江南春雨待君题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴之山还姑苏三首 其三","author":"孙承恩","text":"野鹤浮云绝系牵，石田茅屋故多缘。\n荷衣不带京尘去，诗卷长留洛下传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王母蟠桃图为中丞张明崖母夫人寿六首 其一","author":"孙承恩","text":"指点蓬瀛东复东，云车风马往来中。\n豫知王母霓旌降，昨夜青禽有信通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王母蟠桃图为中丞张明崖母夫人寿六首 其二","author":"孙承恩","text":"鹤背扶摇九万风，眉山深处有仙宫。\n黄封携得深杯献，人面蟠桃相映红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王母蟠桃图为中丞张明崖母夫人寿六首 其三","author":"孙承恩","text":"沴气才消喜气回，高堂寿酒劝深杯。\n婺星已见联南极，执法还身接上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王母蟠桃图为中丞张明崖母夫人寿六首 其四","author":"孙承恩","text":"高门世德有遗踪，锦水灵山秀出公。\n老我无闻空碌碌，却教惭愧忆先翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王母蟠桃图为中丞张明崖母夫人寿六首 其五","author":"孙承恩","text":"宴喜堂中酒满觞，膝前沾洒湿宫裳。\n平倭伟绩全忠孝，我亦通家与有光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王母蟠桃图为中丞张明崖母夫人寿六首 其六","author":"孙承恩","text":"青鸟飞来道意真，江南已是太平民。\n还将宴喜称觞酒，醺作乾坤大地春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赐金志感","author":"孙承恩","text":"病废归来轸圣心，干戈积岁老愁深。\n先庐燬尽儿孙在，自幸朝廷有赐金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张明厓中丞有惠代柬谢","author":"孙承恩","text":"圣主恩深赐已馀，更叨大府惠何如。\n多脩善药扶衰病，剩与儿孙助买书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画册 其一","author":"孙承恩","text":"青山矗矗水舒舒，想见郊原霁雨初。\n绝似三高亭上望，人家依约树枝疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画册 其二","author":"孙承恩","text":"青山涧底结阴阴，老大还无用世心。\n张洞西边煮茶灶，山灵虚闭白云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画四首 其一 秦楼月","author":"孙承恩","text":"长风发。\n中宵莽莽吹林樾。\n吹林樾。\n疏翎整翮，思游天末。\n青山逸态真奇绝。\n九皋梦想华亭月。\n华亭月。\n一声清唳，海天空阔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画四首 其二 点绛唇","author":"孙承恩","text":"桄榔云深，生来南国多珍丽。\n翠花金羽。\n反得为身累。\n弦管歌凝，俛嘿含幽意。\n秋风起。\n云山迢递。\n无计能飞去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画四首 其三 生查子","author":"孙承恩","text":"江南泽国秋，野水连天净。\n日落渚沙明，霜老菰蒲冷。\n欲下复徘徊，顾侣声相应。\n带月渡银塘，照见双栖影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画四首 其四 卜算子","author":"孙承恩","text":"斜日透疏林，惨惨郊原暮。\n猛气雄心敛莫施，郁郁如含怒。\n紫塞暗秋云，目断阳台路。\n会见拂拂抟九天，草莽空狐兔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"百字令 其一 寿夏桂洲阁老和坡翁韵","author":"孙承恩","text":"林钟律应，又秋早、宵起试占云物。\n箕昴呈祥灿午夜，南极光联奎壁。\n浩渺江流，崔巍庐阜，更皎洁瑶台雪。\n乾坤灵气，一时钟此人杰。\n此日寿域宏开，沉檀然兽鼎，瑞烟飘发。\n看雄据豪吟，染霜纨、龙蛇飞灭。\n宫酒淋漓，渐玉山微倚，酡颜乌发。\n祝公遐算，直同天上明月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"百字令 其二 寿夏桂洲阁老和坡翁韵","author":"孙承恩","text":"上天纯佑，为社稷、生此中兴人物。\n巨器宏才更风流，挺立千寻绝壁。\n冠世文章，包人度量，襟抱同冰雪。\n试论今日，何人堪比奇杰。\n还羡秉笔黄扉，笑谈机务了，英猷横发。\n仰止皋夔，树芳声、千古谁能磨灭。\n退食逶迤，开怀延国士，吐餐握发。\n望公何似，碧天永夜孤月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"百字令 和韵赠翟石门阁老","author":"孙承恩","text":"奇才间气，应不是、三代后来人物。\n学海文林，曾览尽、禹穴泰山鲁壁。\n星斗胸罗，烟云笔涌，不拟赋梁园雪。\n勋名德望，中朝共仰瑰杰。\n此日位列三台，从容弘化理，佐天生发。\n雅范光仪，愧颛蒙、鄙吝为公消灭。\n世路纵横，尽风尘扰扰，不侵毫发。\n碧潭秋水，骊龙独抱明月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑞鹤仙 寿陆东湖尊堂太君","author":"孙承恩","text":"薰风飘绮户，正景属熙明，节当重午。\n高堂拱贤母，看华发童颜，又逢初度。\n遥空昨夜，灿南极、辉联宝婺。\n寿筵开、杂遝笙歌，古鼎沉檀烟吐。\n争睹。\n有子英贤，纡朱腰玉，作皇家心膂。\n云霄接武。\n满庭前，兰桂森如许。\n綵绒新绾长生缕。\n曲按南飞旧谱。\n待海筹、一百添齐，从头再数。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洞仙歌 次韵寿顾太恭人","author":"孙承恩","text":"薰风解愠，正葛衣轻透。\n绮席初行争献酒。\n有令子、金带绯袍两孙，玉立沸笙歌，共向北堂称寿。\n荣养谁能似，屈指春秋，更六岁慈龄届九。\n最喜是孙曾、保姆新擎，娱老眼、男东女右。\n近王母、传书已名注长生，为报君知，君须信否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺新郎 舟中值重午","author":"孙承恩","text":"客路风尘恶。\n叹匆匆、节临重午，不堪牢落。\n却忆故园当此日，虚馆朋侪对酌。\n拟胜会、追踪河朔。\n翘首帝都红日近，望白云、亲舍天寥廓。\n肠欲断，心飘泊。\n江心旧事流传昨。\n我欲将、兴亡作鉴，悃诚谁托。\n惆怅灵均今已矣，水底英魂寂寞。\n又谁辨、醉醒清浊。\n感事羁怀频吊古，抚乾坤、浩气空盘薄。\n歌短调，发长噱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺新郎 六十初度自寿","author":"孙承恩","text":"初度今朝又。\n叹匆匆、年华逝水，岂堪回首。\n道老而今真是老，花甲已周之候。\n钟鼎勒、此生何有。\n圣世虚叨风云会，春卿崇重惭虚谬。\n只此志，誓无负。\n朝来独把梅花嗅。\n笑尘容、落寞萧条，与花同瘦。\n俯仰乾坤箕裘事，喜有龙儿凝秀。\n抱迂拙、从来如旧。\n欲把年筹重再数，不知天意还从否。\n聊自适，且斟酒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洞仙歌 中秋无月和徐少湖","author":"孙承恩","text":"广寒宫冷，望杳蓝桥路。\n无奈婵娟被风妒。\n驾长梯、扫开云翳，放出冰毬，又秖恐、海底骊龙抱住。\n有良朋三五。\n漫倒芳尊，且教迟回唱金缕。\n洗梧桐露下、衣袂生凉，漏转层城未归去。\n已?此度负佳期，看明岁、今宵会伊何处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洞仙歌 十六夜对月","author":"孙承恩","text":"银蟾皎洁，万里清辉满。\n云翳长风尽吹散。\n想天公、也自知我昨夜无聊，还赐与，通宵尊前吟玩。\n海门龙起立，我亦狂来，醉舞婆娑影凌乱。\n恐嫦娥笑我、华发苍颜，不悟流光暗中换。\n从言有月即中秋，恁乐事、赏心不须分判。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清江引 其一","author":"孙承恩","text":"篷窗雨来声洒洒。\n静听心神快。\n持杯怅远人，厌世羞尘壒。\n吾将乘桴浮碧海。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清江引 其二","author":"孙承恩","text":"篷窗雨来人未寝。\n早已知寒信。\n暂借酒留春，无奈霜堆鬓。\n兰缸幽幽频落烬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清江引 其三","author":"孙承恩","text":"篷窗雨来声可数。\n洒壁还飘户。\n香醪且自斟，佳句谁同赋。\n离愁黯然怀极浦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清江引 其四","author":"孙承恩","text":"篷窗悄然闻夜雨。\n淅沥无时住。\n飘萧风送来，倏忽还吹去。\n前溪水深添几许。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清江引 其五","author":"孙承恩","text":"篷窗雨声长复短。\n半是风吹乱。\n鹧鸪巫峡中，杜宇潇湘岸。\n平生壮游今已懒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清江引 其六","author":"孙承恩","text":"篷窗雨来声滴点。\n惹起情无限。\n春风杨柳枝，流水桃花片。\n我思美人南浦远。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清江引 其七","author":"孙承恩","text":"篷窗雨声纷复整。\n飘忽全无定。\n频添霜雪髭，渐减风云兴。\n病来瘦容羞对影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清江引 其八","author":"孙承恩","text":"篷窗雨来鸣屋瓦。\n良友同佳话。\n浮生固有涯，老健应无价。\n镜中朱颜何处也。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清江引 其九","author":"孙承恩","text":"篷窗雨声鸣复绝。\n小酌消长夜。\n聊将忘世纷，且共耽清暇。\n人生百年谁是者。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清江引 其十","author":"孙承恩","text":"篷窗雨馀还袅袅。\n静听吾情好。\n弦中山水音，笛里关山调。\n明朝小庭生碧草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清江引 其十一","author":"孙承恩","text":"篷窗雨来声渐响。\n默坐心虚旷。\n萧萧丛竹间，簌簌梧桐上。\n灞陵潇湘真髴髣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清江引 其十二","author":"孙承恩","text":"沉沉雨深当夜午。\n爽气浮轩户。\n情忘水竹居，梦断长安路。\n洗胸中从来尘与土。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清江引 其十三","author":"孙承恩","text":"耳边萧萧还袅袅。\n风雨同时到。\n前村烟花微，远寺钟声杳。\n可人不来添静悄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清江引 其十四","author":"孙承恩","text":"兰灯摇摇秋夜永。\n淅沥生清听。\n平添烟水深，洗濯苔矶净。\n朝来吾将乘钓艇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清江引 其十五","author":"孙承恩","text":"风声雨声连四野。\n萧散篷窗下。\n一杯聊自持，万虑无萦挂。\n长安道中泥没马。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄莺儿四首 其一 风","author":"孙承恩","text":"阵阵扫浮埃。\n汎虞弦，上楚台。\n飘飏兰蕙吹罗带，残云捲开。\n明月送来。\n赵家姊妹难禁耐，透人怀。\n千金无买，宋玉赋应裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄莺儿四首 其二 花","author":"孙承恩","text":"绰约见婵娟。\n颤巍巍，百种妍。\n慇勤多费东君剪，欲言不言。\n端详可怜。\n含颦凝思如幽怨，看嫣然。\n春心无限，偎倚在、晚风前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄莺儿四首 其三 雪","author":"孙承恩","text":"万里正同云。\n看飘扬，密更匀。\n素鸾皓鹤来无尽，灞桥苦唫。\n梁园倒樽。\n蓝关马足行难进，转缤纷。\n天寒地凛，妆出个、玉乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄莺儿四首 其四 月","author":"孙承恩","text":"冉冉上遥天。\n散清辉，满大千。\n霓裳缥缈清虚殿，更筹正传。\n玉人未眠。\n栏杆十二凭来遍，对婵娟。\n莫教云掩，我欲醉西园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度自寿十三首 其一 中吕玉娥儿","author":"孙承恩","text":"初度今朝。\n灿祥光，寿星高照。\n宝鼎内、自把香烧。\n感亲恩，歌帝德，愧微躯难报。\n逝水滔滔。\n数年筹、吾生已老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度自寿十三首 其二 佳乐歌","author":"孙承恩","text":"短发日飘萧。\n镜里朱颜渐槁。\n览今怀古，此生吾岂瓜匏。\n忧心如捣。\n抚乾坤，世故多颠倒。\n到如今、雅志多违，惭负了、地厚天高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度自寿十三首 其三 赤颗桃","author":"孙承恩","text":"敢忘了、当年鞠育恁劬劳。\n过庭诗礼曾学。\n敢忘了、圣明作养滥与时髦。\n词林讲幄，忝贰春曹。\n我则是、素餐窃位曾无效。\n俯惭庸碌，仰愧贤豪。\n我则是、寸心惟有天知道。\n长日里、翘首仰青霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度自寿十三首 其四 佳乐歌","author":"孙承恩","text":"迢遥千载看孤标。\n门庭不惹尘嚣。\n家人称寿吸霞觞，沾洒宫袍。\n掀髯长笑。\n记当年、驰骤誇英妙。\n愧疏慵、老大无闻，漫说甚、回铿寿夭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度自寿十三首 其五 童子嬉","author":"孙承恩","text":"我也曾、皇华将命驰南徼。\n保守着、贞心雅操。\n我也曾、刍言仰进荷恩褒。\n陈道德，比轩尧。\n我也曾、两番南北持文柄，为国拳拳简俊髦。\n兢业惭微藐。\n端的是、一心报主，期不负清朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度自寿十三首 其六 促鸟音","author":"孙承恩","text":"我不能、潝潝卑卑，我不能、轩轩矫矫。\n岸乌纱，白日高悬。\n扪丹心，孤忠独抱。\n流行坎止信吾遭。\n景先哲，究羲爻。\n利名关、豪杰都迷，能几个、邯郸梦觉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度自寿十三首 其七 满庭芳","author":"孙承恩","text":"吾行潦倒，疏慵成癖，不任煎熬。\n忆当年家食，将宠辱都抛。\n草堂中，听雨坐深宵。\n篷窗下，待月观潮。\n兀自揣，玉阶金阙无缘到。\n荷圣主、垂仁用草茅。\n因此上、八座幸虚叨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度自寿十三首 其八 三煞","author":"孙承恩","text":"享厚禄，已馀饶。\n只有个、终天一念，忍听风木悲号。\n那更扊扅，人一去，音尘杳。\n鹡鸰声断，死生骨肉，暗自魂消。\n愁绪千条。\n兀的是、一时凑着。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度自寿十三首 其九 青歌儿","author":"孙承恩","text":"恰便似、蓦地浮云，弥天不扫。\n恰便似、独茧春蚕，抽丝不了。\n并州剪，剪不断、野草根苗。\n展转无聊。\n回首迢迢。\n心旆摇摇。\n顾影萧萧。\n续世承祧。\n嗣子知学，有息垂髫。\n膝下痴娇。\n贤否何若叶爻。\n难期料。\n也只是、把苍天祷。\n浮荣身外，从今日、便可一笔勾销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度自寿十三首 其十 夕游蝶","author":"孙承恩","text":"藩篱斥鴳翔，鹏翼上扶摇。\n任天机、总是逍遥。\n空花界、那有坚牢。\n逞春风、争妍竞耀。\n霎时间、水逝云飘。\n纵双眸、大观今古，我则是、无语首频搔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度自寿十三首 其十一 步微楼","author":"孙承恩","text":"鬓堆霜，不可消。\n日行天，不可招。\n望故国桑梓，关心云霄。\n倦翼江海归桡。\n宠辱之门，盈虚之数，行藏之道。\n常言道、宦海风波，到不如、从吾所好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度自寿十三首 其十二 夕游蝶","author":"孙承恩","text":"我则想、投盟泉石，我则想、舒啸林皋。\n向三江、把钓丝，寻五岳、去游遨。\n原是那、野鹿山猱。\n志本在、长林茂草。\n天壤内、真乐陶陶。\n洗胸中、从来冰炭，百年事、吾休问，尽付与儿曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初度自寿十三首 其十三 收音","author":"孙承恩","text":"茫茫宇宙何时了。\n摆脱尘缘任所超。\n万里江天鸿鹄矫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其一 盘古","author":"孙承恩","text":"厥初洪荒，浑沌一气。\n爰有圣神，莫究其自。\n手斡日月，划开乾坤。\n万汇攸始，拓我化原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二 伏羲","author":"孙承恩","text":"羲皇圣神，开物成务。\n画卦造书，文字之祖。\n神明以通，造化以宣。\n万世道统，兹其发源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]