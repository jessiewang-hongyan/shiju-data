[{"title":"和区宫允寄示太液池闻雁之作","author":"卢龙云","text":"灵洲通艺苑，仙液类词源。\n晓直趋常早，宸居静不喧。\n鹓鸿时并集，霄汉近孤骞。\n何似群鸣者，荒烟傍海村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答康孟担二首 其一","author":"卢龙云","text":"双鱼何处达，沧海夜生潮。\n九漈灵源渺，三山驿路遥。\n交神俱翰藻，迹混半渔樵。\n字字投珠玉，缄书乏报瑶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答康孟担二首 其二","author":"卢龙云","text":"清淑回闽海，词才近若云。\n登坛谁竞赏，空谷汝先闻。\n拙宦成漂梗，知交久断群。\n山阴如弭棹，邀月更论文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋霖大作兼疾风竟日感赋三首有引 其一","author":"卢龙云","text":"山下城如斗，千家共结庐。\n风生潮怒后，雨挟海波馀。\n谷口奔成潦，溪声溜决渠。\n临流三五户，犹恐复为鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋霖大作兼疾风竟日感赋三首有引 其二","author":"卢龙云","text":"百雉沿山麓，穿城导众流。\n金汤宁恃险，摇落早知秋。\n拔木风逾劲，翻盆雨未休。\n小民虞及溺，难自听沉浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋霖大作兼疾风竟日感赋三首有引 其三","author":"卢龙云","text":"何意抱关者，翻操造物权。\n剖藩方远险，疏滞得防川。\n顺水行无事，康居乃重迁。\n未论关禁弛，且幸已图全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送从弟少乘还乡二首 其一","author":"卢龙云","text":"握手他乡别，繁霜拂剑花。\n官贫腰但折，旅逐鬓将华。\n嘲白宁甘寂，怀黄未可誇。\n归与荒径外，先为卜宜瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送从弟少乘还乡二首 其二","author":"卢龙云","text":"海滨留滞日，分袂况斯时。\n远道无由息，他乡有所思。\n世情憎宦达，吾意虑归迟。\n事业将看汝，东篱早咏诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻谤答林于玄","author":"卢龙云","text":"芳草年年绿，桃今几度花。\n好移青雀舫，去傍白鸥沙。\n新水烟初净，名山雾不遮。\n世情君莫问，趺坐对南华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读郑参知传","author":"卢龙云","text":"先生天下士，墓木已苍苍。\n寒后知松柏，群中有凤凰。\n君王思汲黯，岭海念桐乡。\n堪笑当年事，萋菲亦似簧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答陈子东","author":"卢龙云","text":"少年追昔日，观国早为宾。\n廿载称牛马，何时问鬼神。\n世多轻傲吏，吾自佩先民。\n却喜归三径，花间任葛巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽郑文学","author":"卢龙云","text":"自古天难问，盈虚未可论。\n斯人去已远，遗业至今存。\n萧艾春同长，鱼龙夜不喧。\n层霄看羽翮，何日见腾骞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答林士岩","author":"卢龙云","text":"世事皆观奕，流年总掷梭。\n悲欢恒易老，得丧定谁多。\n沧海终须变，浮云任自过。\n同仇知汝切，无用赋脩戈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"抵家后答林君勉二首 其一","author":"卢龙云","text":"昔居滨海地，日上望乡台。\n一自离萍梗，相安弃草莱。\n无能思养拙，清论付程才。\n喜尔还追忆，椷书特远来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"抵家后答林君勉二首 其二","author":"卢龙云","text":"鼓棹出江湾，风涛动旅颜。\n愤难甘蹈海，愚或笑移山。\n翘首烟霄外，论心意气间。\n雄文终遇合，且傍舞衣班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋苏叔大招同张仪仲集玄畅堂","author":"卢龙云","text":"伏日炎蒸尽，秋阴爽气鲜。\n莼鲈因客久，鸡黍幸君怜。\n意自酣馀畅，谈从物外玄。\n坐中能赋者，莫诵四愁篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"康孟担至自闽","author":"卢龙云","text":"百折闽溪水，归来始就安。\n菊苗荒再绿，荔子熟逾丹。\n世网从添密，诗盟自不寒。\n喜君能命驾，杯酒复同欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"姜生磻支自闽来请传其贞母董孺人特嘉勉之赋别二首 其一","author":"卢龙云","text":"世远龙峰下，诗书泽未寒。\n始缘家不造，转觉路俱难。\n事往悲黄鹄，恩来待紫鸾。\n有怀知罔极，休恐误儒冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"姜生磻支自闽来请传其贞母董孺人特嘉勉之赋别二首 其二","author":"卢龙云","text":"吏隐孤城日，诸贤忆论文。\n山间遍桃李，海上几风云。\n虎口惊初定，羊肠望已分。\n远天来独鹤，应是出鸡群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日","author":"卢龙云","text":"廿载婴尘网，今方物外游。\n閒居聊自赋，世路岂深忧。\n梦返隍中鹿，机閒海上鸥。\n阳回春事足，吾道本沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"康山人以新刻锦囊寄示兼有诗劝驾赋此答之","author":"卢龙云","text":"自得幽居趣，无心复汉关。\n林泉偏浪迹，猿鹤与同閒。\n世态风尘外，知交梦寐间。\n著书诚羡汝，堪为副名山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠日者邓生","author":"卢龙云","text":"我自谙齐物，而君善阅人。\n林塘新雨净，帘肆一家春。\n墨妙多徵贵，谈高解逐贫。\n百钱都市日，何异此藏身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老人星","author":"卢龙云","text":"天上年何极，长瞻寿有星。\n五云连碧落，万里映珠庭。\n处士潜光久，贤人聚德馨。\n由来俱借耀，千仞烛高冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆罗浮兼寄何使君二首 其一","author":"卢龙云","text":"屡爽罗浮约，山灵或笑人。\n林泉堪浪迹，岩洞几经春。\n五鹊时还集，千花岁并新。\n寒梅如有待，迟暮转相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆罗浮兼寄何使君二首 其二","author":"卢龙云","text":"山色年年好，难逢地主贤。\n帷搴朱洞外，榻下铁桥边。\n剩有登楼月，俱无警堠烟。\n安民多渤海，游骑喜相连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郑别驾督鹾还西粤兼柬薛使君二首 其一","author":"卢龙云","text":"有美家声旧，能忘吏事劳。\n官淹庞统骥，佩羡吕虔刀。\n早识驹千里，争看凤一毛。\n临岐方怅别，西望岭云高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郑别驾督鹾还西粤兼柬薛使君二首 其二","author":"卢龙云","text":"自返闽江棹，相逢却有君。\n风尘俄握手，花月几论文。\n吏隐鱼盐混，心知道路分。\n交亲如问讯，烟水鹭鸥群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊居八咏 其一 廓处堂","author":"卢龙云","text":"草野自寥廓，茅堂此隐沦。\n傍林驯鸟雀，开径剪荆榛。\n道路风尘息，烟霞岁月新。\n浮云随去住，别有一家春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊居八咏 其二 善息斋","author":"卢龙云","text":"岁月疲奔走，归来却就安。\n吾庐知自爱，世路识俱难。\n偃仰但怀土，风波始息湍。\n图南嗟羽翼，聊作一枝看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊居八咏 其三 酿秫斋","author":"卢龙云","text":"万事无过酒，壶觞日可亲。\n岩耕多种秫，村酿足娱宾。\n滴处愁随破，呼来态转新。\n醉乡于此觅，花落自成茵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊居八咏 其四 众芳亭","author":"卢龙云","text":"不厌蓬蒿满，孤亭杂众芳。\n竹如三径绿，桂似小山苍。\n薋菉宁芜秽，松梅自雪霜。\n琴樽聊寄适，未拟百花庄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊居八咏 其五 濯尘轩","author":"卢龙云","text":"款段来城郭，缁尘不可挥。\n避喧循野径，访隐到林扉。\n曲水堪修褉，沧浪此振衣。\n风埃满天地，洞户有清晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊居八咏 其六 洗墨池","author":"卢龙云","text":"雅爱临池诀，风流忆二王。\n毫端宁有彩，诗里祗添狂。\n洗砚冲鱼沫，操觚染树香。\n小亭宜醉墨，云影落方塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊居八咏 其七 覆奕台","author":"卢龙云","text":"玩世皆观奕，为园独有台。\n移枰依竹树，坐石拥蒿莱。\n先后宁遗算，输赢莫浪猜。\n解围常竟日，荜户约重开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊居八咏 其八 投辖井","author":"卢龙云","text":"林泉偏引兴，杖屦喜相同。\n玩世多浮白，伤春几落红。\n棋弹花外雨，翰染竹间风。\n甘寂宁遗俗，留宾比孟公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳前一日林希平民部招饮丛桂山房时桃花与菊并开亦奇事也诗纪之二首 其一","author":"卢龙云","text":"未约龙山饮，先攀桂树丛。\n人俱白社客，地似碧云宫。\n菊艳今应紫，桃花亦自红。\n阳和偏有意，晚暮喜春同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳前一日林希平民部招饮丛桂山房时桃花与菊并开亦奇事也诗纪之二首 其二","author":"卢龙云","text":"地主多招赏，花神故献奇。\n林风吹旷莽，海月照涟漪。\n秉烛因清夜，移樽傍曲池。\n茱萸明日酒，孰与此中宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九月既望陈勋卿招同穆王二令公登龙津逍遥楼望西樵诸山既暮移酌于东轩就月漫赋二首 其一","author":"卢龙云","text":"未尽登高兴，深樽正可亲。\n篱花初满径，秋月更重轮。\n野俗看仍朴，康谣听转新。\n莫疑双剑合，此地是龙津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九月既望陈勋卿招同穆王二令公登龙津逍遥楼望西樵诸山既暮移酌于东轩就月漫赋二首 其二","author":"卢龙云","text":"出郭陪幽赏，临高望故山。\n桑麻驯雉地，烟水钓鱼湾。\n舄欲淩风起，车留载月还。\n客游吾已倦，偏恋狎鸥閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谭太学以春明赴选其诸子于先冬十月开宴为寿索赠二首 其一","author":"卢龙云","text":"衣马追游地，春风念五陵。\n梅花今似雪，竹叶况如渑。\n诣阙书初就，贻家庆转增。\n图南多健翮，天路总骞腾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谭太学以春明赴选其诸子于先冬十月开宴为寿索赠二首 其二","author":"卢龙云","text":"欲赴弹冠庆，贪欢舞袖斑。\n裁诗俱白雪，对酒倍朱颜。\n志壮曾题柱，经传岂度关。\n南山他日颂，留待锦衣还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对菊忆杜句云每恨陶彭泽无钱对菊花因用钱字","author":"卢龙云","text":"菊花何太妍，摇落暮秋天。\n幽意真相惬，孤芳剧可怜。\n对吟堪竟日，服食更延年。\n但喜东篱满，何须复问钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读重明纪异录二首有序 其一","author":"卢龙云","text":"大夫将母日，纯孝格旻天。\n久视留难老，重明岂偶然。\n手中还密线，镜里任华颠。\n逐子西征后，亲看展骥年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读重明纪异录二首有序 其二","author":"卢龙云","text":"传家勋节茂，德聚感仙灵。\n露浥萱逾秀，云开婺转荧。\n阶庭重戏綵，里闬更垂青。\n母视从天视，应教护晚龄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张明府六载考绩二首 其一","author":"卢龙云","text":"六载张君政，讴歌遍海乡。\n楚材工制锦，汉署待含香。\n泽普花封雨，名高柏府霜。\n中朝徵异等，早晚觐明光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张明府六载考绩二首 其二","author":"卢龙云","text":"薄海真多幸，琴鸣几度花。\n量留因保障，召对首清华。\n绣斧频推毂，铜章两及瓜。\n持衡需启事，知不负皇家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至后为李茂才兄弟寿母","author":"卢龙云","text":"节是书云后，堂开献寿初。\n海邦符鲁颂，洛涘引潘舆。\n爱日欣长至，承欢集庆馀。\n层霄三凤羽，应渐送吹嘘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瘿木杯有引","author":"卢龙云","text":"劲质依山涧，何心匠石知。\n成能非强饰，致用出离奇。\n浮处皆为白，行来但诉迟。\n金罍堪并列，玉醴总相宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春十日陈明佐勋卿招同诸公观灯","author":"卢龙云","text":"令节今宵始，宾筵此会高。\n城开新菡萏，酒满旧葡萄。\n笔为同声试，杯逾隔岁豪。\n主人兼爱客，清夜不知劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠孙户侯","author":"卢龙云","text":"名家推汗血，天路识霜蹄。\n推毂才雄擅，弃繻英妙齐。\n虎头铜柱外，猿臂玉关西。\n今日麒麟阁，功成待尔题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答友人客夜见贻","author":"卢龙云","text":"揽衣起难寐，孤灯见客情。\n春寒淹夜坐，细雨到天明。\n怀土悲王粲，忧时类贾生。\n好文当主圣，何日识君名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为刘茂才寿其伯隐君","author":"卢龙云","text":"小隐蓬为径，同游竹是林。\n冬桃千岁实，春酒百年心。\n经暇时娱綵，樽开满盍簪。\n兴来因小阮，徙倚复长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送穆令公入觐二首 其一","author":"卢龙云","text":"辑瑞由虞典，分符藉楚材。\n鸣骖俨上路，应宿近中台。\n海国烟消日，山程雪霁梅。\n圣朝方久任，多是赐金回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送穆令公入觐二首 其二","author":"卢龙云","text":"五凤祥云拥，双凫瑞色浮。\n玺书辉紫殿，锦服照黄州。\n郡国谁高第，关山自壮游。\n重来念竹马，莫恋梓乡留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太学兄弟自闽来访答和二首 其一","author":"卢龙云","text":"上客皆金友，名家自玉人。\n登龙难并拟，命驾喜相亲。\n设类穆生醴，交逾公瑾醇。\n乡心且莫切，作伴待青春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘太学兄弟自闽来访答和二首 其二","author":"卢龙云","text":"拟赋从军乐，翻成访旧来。\n莫思身外事，且覆掌中杯。\n爱客深投辖，怀人更酌罍。\n谁当吹玉律，幽谷动寒灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜","author":"卢龙云","text":"冬夜何如永，寒天未肯明。\n穿帘残月影，欹枕远鸡声。\n仙梦宁关达，微吟自解酲。\n倦眠翻起早，难待日东生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为俞生初诞子作二首 其一","author":"卢龙云","text":"海日当长至，门弧应瑞开。\n凤雏宁世出，龙种自天才。\n窦苑方称桂，王家旧植槐。\n登筵多玉果，任醉酒千杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为俞生初诞子作二首 其二","author":"卢龙云","text":"种玉知何始，徵兰在粤城。\n充闾初有子，当户此为兄。\n练影天中见，珠光掌上生。\n多男何俟祝，次第识英声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蟠桃图","author":"卢龙云","text":"嘉树何年植，花殷实渐成。\n蒸霞先海色，和露足春荣。\n液美灵岩髓，香分汉苑茎。\n与君持介寿，驾鹤伴吹笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感事二首 其一","author":"卢龙云","text":"阅世逢之子，艰危记并驱。\n祇知明得意，未解识穷途。\n显晦殊先后，升沉定有无。\n至今樽酒外，何地著潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感事二首 其二","author":"卢龙云","text":"自许风尘上，乾坤眼底空。\n红颜翻易掷，白眼转相同。\n逐客书难问，长门赋未工。\n为君思往事，真负气如虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁宪父馆于罗太学家董叔远冯文孺有作次和","author":"卢龙云","text":"上客非高馆，何缘见爱才。\n南州逢榻下，北海仗樽开。\n翰墨论心富，莺花逐赏来。\n主人方梦鸟，堪杂夜明苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孙氏先茔嘉瓜二首 其一","author":"卢龙云","text":"异矣孙钟墓，相传孝可嘉。\n感符人化鹤，祥协地宜瓜。\n玉井无须羡，朱陵总浪誇。\n绵绵比周瓞，他日庆逾赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孙氏先茔嘉瓜二首 其二","author":"卢龙云","text":"改卜茔新兆，泉台傍鲁坡。\n山川随地胜，雨露得天和。\n积石根元美，东陵事若何。\n诸孙能嗣业，应比故侯多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答罗尊生","author":"卢龙云","text":"阅世知音少，何因遇子期。\n每看高士传，愧勒北山移。\n艺苑交如石，流年鬓易丝。\n霜蹄开道路，历国总称奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为黎学博题琴书图二首 其一","author":"卢龙云","text":"当年谢羁勒，一径返烟萝。\n散帙娱清暇，鸣弦续咏歌。\n广陵传后少，禹穴秘中多。\n扰扰红尘者，相看意若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]