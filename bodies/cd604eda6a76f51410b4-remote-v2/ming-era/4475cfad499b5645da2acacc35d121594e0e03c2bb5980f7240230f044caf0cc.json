[{"title":"过浙值揭榜","author":"钟芳","text":"去浙甫一纪，重过似有期。\n榜收新俊彦，文厌旧筌蹄。\n渊跃舒鳞甲，天游脱絷羁。\n明年春宴罢，红杏绕金堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次","author":"钟芳","text":"秋霁江初杀，归桡慰所之。\n波摇银汉动，掔引石堤移。\n四际云山曙，南来鸿雁稀。\n浮生成底事，惭愧鬓丝丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹阳来尹送至吕城惜别","author":"钟芳","text":"感旧今如昔，那堪会复离。\n莲舟忘坐久，燃烛爱归迟。\n十载江湖梦，寸心天地知。\n多君无限意，星月共清漪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠崖杂咏次韵七首 其一","author":"钟芳","text":"万里望宸极，地远天亦荒。\n玉节劳咨度，银潢隔渺茫。\n鲋喁濡沫下，狐跃虎貙傍。\n皇仁本无间，迟子诞敷将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠崖杂咏次韵七首 其二","author":"钟芳","text":"孤岛沧瀛外，优优政俗宜。\n九天覃濊泽，中谷少仳离。\n藤布三秋税，香粳半夜糜。\n绕城箫鼓闹，同乐际清时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠崖杂咏次韵七首 其三","author":"钟芳","text":"洪炉钧鼓铸，沧海混华夷。\n离正春长燠，波平碧映曦。\n风花嫣瑞霭，鱼鸟恣晴熙。\n为访蛟人室，明珠或见遗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠崖杂咏次韵七首 其四","author":"钟芳","text":"宪节南溟重，霜威自昔闻。\n笑谈挥九伐，呼吸定三军。\n列阵秋腾海，高锋夜彗云。\n如何鼪鼯辈，扬臂怒新君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠崖杂咏次韵七首 其五","author":"钟芳","text":"塞檄飞星候，江梅破腊初。\n旌旗严虎队，樽俎答鱼书。\n自昔恣群螫，何殊豢众狙。\n伸威如有待，山海效储胥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠崖杂咏次韵七首 其六","author":"钟芳","text":"迢迢黑子地，矫矫汉官仪。\n剑盾擅长技，貔貅攒健儿。\n平越有故事，伏波端可师。\n柔桑惮蚕食，翘首望清夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠崖杂咏次韵七首 其七","author":"钟芳","text":"鹏化图南地，何须问北溟。\n倚楼观海立，开户放云行。\n俗混鸥堪狎，机亡虎可婴。\n浮生本无系，泉石有馀情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送崖州邓掌教会试次林节推见泉韵□□","author":"钟芳","text":"沧海中原隔，亲朋音信疏。\n云龙端羡子，灯火独亲予。\n秋宇搏修翮，灵襟多古书。\n名高金阙晓，联步玉阶除。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日","author":"钟芳","text":"青帝回銮候，瞻依向紫微。\n轩辕新凤历，章甫旧儒衣。\n物色先春好，星光拂曙稀。\n古今呼吸里，默默对清晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送祝照府","author":"钟芳","text":"世态森矛戟，官屯是命屯。\n怜君动归思，老我倍伤神。\n蹈险思忠国，投闲为爱身。\n九峰丹灶在，去炼玉池津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬至次顾洞阳韵","author":"钟芳","text":"阴极阳初复，机微帝实临。\n玉衡宵渐短，凤吹兴难任。\n浑噩羲黄世，希微太古音。\n茫茫炎海上，谁识顾和心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林节推见泉","author":"钟芳","text":"世望重三山，三年海屿间。\n鱼喁怜涸泽，犀照夜愁澜。\n冰鉴清秋彻，桁杨白昼闲。\n奏功金阙曙，喜色上龙颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"霜节","author":"钟芳","text":"使轺离索久，窗户入凄凉。\n场圃淩霜筑，宾鸿何处翔。\n越裳天伐寝，兰畹国馨扬。\n咫尺雷阳地，闲赓白雪章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"颐贞轩为龙孔锡题","author":"钟芳","text":"野老长生诀，翛然异羽流。\n鼎亨白石烂，庭撼碧湖秋。\n列曜双推毂，千春一转眸。\n灵雏自轩揭，飞去集蓬丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重过钓台","author":"钟芳","text":"采薇歌歇后，严濑激清波。\n帝子自知己，客星将谓何。\n道轻周衮黼，节系汉山河。\n回首商岩老，应惭定策讹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭邵端峰 其一","author":"钟芳","text":"直木无曲影，亨暌信所如。\n镳联欣茹拔，仆正陋臣谀。\n浪迹南仍北，潜机哲亦愚。\n人琴俱泯泯，老泪湿霜须。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭邵端峰 其二","author":"钟芳","text":"南省旧同袍，输君气格豪。\n高名齐岱岳，美实富蟠桃。\n俎豆儒风旧，江闽化泽饶。\n哀衷何处奠，重嶂隔云涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小遣","author":"钟芳","text":"杜老愁无那，中原多鼓鼙。\n乾坤今泰定，杖屦合愉夷。\n溪涨凫鹥浴，春归燕雀知。\n桃花趁时节，新放两三枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庆成宴","author":"钟芳","text":"大祀明朝御建章，天颜俨若对穹苍。\n班联紫陛龙颜近，袖染銮坡玉液香。\n四海车书归辇毂，百蛮酋长列冠裳。\n遭逢无地堪图报，愿拟冈陵与寿长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西山晚霁","author":"钟芳","text":"雨过轻阴满玉堂，西山晚眺思茫茫。\n日垂残影低平树，山拥寒峰半出墙。\n野渚归乌银汉净，好风嘶马玉堤凉。\n戍楼鼓角黄昏后，列宿遥连帝座光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕有感","author":"钟芳","text":"除夕前年已去家，今年除夕在京华。\n万山积雪断归雁，双柏隔窗栖乱鸦。\n节序不情看过隙，浮名无蒂漫蒸沙。\n思乡有梦无缘到，银烛销红斗柄斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"坐槐阴偶书","author":"钟芳","text":"人事推迁可奈何，纷纷蝼蚁上南柯。\n功名频看匣中镜，岁月真如机上梭。\n蜀魄有怀终陨血，寒鸦无力欲填河。\n坐深庭院浑忘倦，凉露沾衣感慨多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王廷和尹邵武","author":"钟芳","text":"声华与子接封疆，同缀云霄鹓鹭行。\n在璞谁知和氏璧，鸣琴初试宓生堂。\n都城日暮千峰断，宇县春回万萼香。\n野鸟不知离别恨，联翩飞起向斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿钱封君七十一","author":"钟芳","text":"一真老人人不识，心远朝市依烟霞。\n爱山无侣自成癖，教子有书常满家。\n白简秋风光世泽，紫泥新宠焕天葩。\n古稀已过从头数，又见寒梅亠度花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽李典籍","author":"钟芳","text":"我昔京华旅食时，曾于甥馆识依稀。\n浮踪又作三年梦，羁旅俄惊一榇归。\n云暗函关家尚远，剑沉延泽愿多违。\n孤坟寂寞秋声里，松柏阴阴起夕霏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚午冬次金陵遇邢景阳北上 其一","author":"钟芳","text":"秣陵寒雨暗疏林，舟泊江湄肃气深。\n久旷每疑双鲤断，再逢各讶二毛侵。\n酒酣人与苍烟暮，雁过声随返照沉。\n脂牵未应稽逆旅，燕室今又筑黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚午冬次金陵遇邢景阳北上 其二","author":"钟芳","text":"江晚朔风号树林，独烧银烛坐更深。\n冬林更比秋林薄，霜色偏随月色侵。\n雁有先几知冷暖，鸥随流水自浮沉。\n愁艖强绊终摇飏，索醉惟应罄橐金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"正心楼","author":"钟芳","text":"层楼涵碧拥孤城，八面玲珑混太清。\n堂奥定从卑处达，经纶元自静中生。\n星河气展皇王业，草木春呈造化情。\n满眼风光熏欲醉，主翁犹自唤惺惺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛未羁州贼扰齐鲁汴豫间总制马公不能制改命陆司马以边兵破之","author":"钟芳","text":"坐拥罴貅百万雄，驱除无策笑元戎。\n三边少借防胡卒，一战全收破竹功。\n泪合烟霞闾闬定，星摇河济舳舻通。\n鲸鲵忍筑车书地，徭赋惟应贷阨穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和侯景德舟中偶成 其一","author":"钟芳","text":"天戈挥霍霁清秋，快我长帆万里游。\n慝气尽随霜气殄，瑞光高并日光浮。\n室家再合收残泪，禾黍新炊汲浊流。\n纪述未须濡栗尾，欢声今已动神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和侯景德舟中偶成 其二","author":"钟芳","text":"舟泊江隈几夕秋，去年今日正同游。\n窥篷斜月娟娟静，占水轻鸥两两浮。\n自幸兼葭依玉树，却惭浊水混清流。\n明朝举棹南风便，扣舷长歌上帝州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":294,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和侯景德舟中偶成 其三","author":"钟芳","text":"蒲苇萧萧江月秋，毛鱼鹿角出波游。\n望依北极龙颜近，笑指东溟蜃气浮。\n引缆冲风劳伍伯，开樽向晚合儒流。\n百年剧笑能多少，□□□□□□州。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":295,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和侯景德舟中偶成 其四","author":"钟芳","text":"一声孤雁鸣高秋，无人为吾秉烛游。\n捣衣隔江声袅袅，沽酒入市云浮浮。\n周业方隆丹凤集，圣谟何在碧川流。\n兴来最爱天心月，一掬光芒遍九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":296,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和侯景德舟中偶成 其五","author":"钟芳","text":"数曲清商草树秋，拿舟又作玉京游。\n浊泾清渭倩谁辨，覆雨翻云伤俗浮。\n江晚菊花千顷暗，夜寒枫叶一川流。\n寻幽欲逐罗浮去，胜景全输百二州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":297,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和人择胜亭诗四首 其一","author":"钟芳","text":"群峰拖翠叠云坰，下有涪翁一草亭。\n风送鸟声来枕细，水流松影出池清。\n阳春到处恰盈掬，生意满前如列星。\n物外呶呶闲扫却，静焚兰茝诵心经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和人择胜亭诗四首 其二","author":"钟芳","text":"诗坛鼓铎振中坚，翡翠兰苕未足传。\n学苦固应成个是，数奇只合守吾玄。\n谷风吹树花争笑，孤屿浮空月倒悬。\n无事扶筇睇清昼，野田秋水落胎仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和人择胜亭诗四首 其三","author":"钟芳","text":"漠漠江浔一小亭，谢官归老鬓星星。\n梅和雪色侵闲幔，雁杂凫翁印浅汀。\n青紫千重身外物，乾坤一叶水中萍。\n眼前好景只须醉，不用玄霜衬鹤龄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和人择胜亭诗四首 其四","author":"钟芳","text":"皤翁懒与世推移，结得山亭强自支。\n倦对枫林高枕卧，兴穿杨径小车随。\n天连碧沼云连壑，瓮有新醅案有诗。\n吟到兴亡凄切处，寒江沈檄吊鸱夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和石宗海进阶韵","author":"钟芳","text":"辞禄归来十数年，回看朝市隔天渊。\n丘园独坐心如铁，杯酒半酣人似仙。\n蚤岁声名瞻北斗，老年词翰涌原泉。\n承恩长抱乌号痛，一诵宸章一惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邓子几之南都刑部主事","author":"钟芳","text":"公署同君作比邻，爱君寥廓似秋旻。\n马缘共牧浑忘主，仆为频来也觉亲。\n清吹催人离凤阙，断云牵恨渡龙津。\n石头春暖圜扉静，独倚晴峦咏白蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"写怀","author":"钟芳","text":"进耽朝市疑徇物，退爱皋原为洁身。\n遇主禹躬三过急，得师颜乐一瓢贫。\n世情似弈翻新局，牍案如麻积幻尘。\n白首抱官成底事，故园桑梓正萧森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶咏 其一","author":"钟芳","text":"案牍顿劳真俗务，精魂耗尽竟何功。\n八千里外炎蒸地，五百年前烈士风。\n失志文皇遗董贾，得时虞帝擢夔龙。\n伊谁卒负苍生望，咄咄还书几字空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶咏 其二","author":"钟芳","text":"颜乐轲忧久隐沦，关闽续后又荆榛。\n眼中人物有臧否，世上声名半假真。\n末学每因诗作累，苦心思与德为邻。\n梦醒刊落繁枝叶，一室愔愔玉自温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲戌夏过潮州谒韩文公庙","author":"钟芳","text":"砥柱当年屹倒澜，一官遥谪瘴江干。\n臣身未死心终赤，佛法如灵骨不寒。\n逢乱常多逢治少，得民容易得君难。\n津头落日天涯暮，敬为先生一驻骖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和思抑韵 其一","author":"钟芳","text":"清曹元自少拘牵，静掩重扉检故编。\n夜永短檠销烛泪，日高新火动榆烟。\n春连四际江山好，人共一轩花鸟便。\n芹曝何曾裨尺寸，只将丰稔祝尧天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和思抑韵 其二","author":"钟芳","text":"刚肠不受百柔牵，今古兴亡手自编。\n洗髓元无丹灶术，照书旧有杖藜烟。\n醉依南斗皇风阔，坦向东溟腹笥便。\n万事只堪供一噱，不须搔首问苍天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和思抑韵 其三","author":"钟芳","text":"柳外离旌渐觉遥，旅魂寥落为君销。\n贤科甲乙联双翮，世路升天共一条。\n纶綍新从天上召，佩环重合殿东朝。\n祠曹好是如邮舍，藉此阶梯荐紫霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙亥春送上舍严仲弘归高明","author":"钟芳","text":"漠漠春云晓树苍，江东门外着归航。\n三年灯火金陵旧，二月风涛玉峡长。\n乡国高垣遮牡蛎，野田新课入禾粱。\n到家随处堪行乐，身外浮名且未忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春寒和林考功韵 其一","author":"钟芳","text":"坐看炉火旋成灰，散帙离披懒自堆。\n积块半乾淩更合，顽阴未破雪重来。\n漏传高阁两三点，梦绕炎洲千百回。\n赖有罗浮春满瓮，便须沉醉莫停杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春寒和林考功韵 其二","author":"钟芳","text":"阴曀漫山山更高，长江一色合云涛。\n寒欺茅屋鸡声咽，雪衬莓阶鹤步牢。\n尺素共传新得句，重绵犹着旧时袍。\n乾坤妙理君须会，已觉南柯欲试桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"思抑送敦夫留宿江口","author":"钟芳","text":"晴江流水碧汤汤，不似先生别思长。\n廿里远来寻客舫，通宵相对话僧房。\n道如在我行藏好，人遇知心宠辱忘。\n他日酒筹花下计，凉州魂梦隔他乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜闻鸡和韵","author":"钟芳","text":"窗外雪花如月明，隔墙远近闻鸡声。\n半疑半信五更梦，欲归未归游子情。\n事知定分闲愁少，心不藏机客虑平。\n每及曙光盘膝坐，细从嘘吸验生生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲春日和韵","author":"钟芳","text":"城上登临切斗牛，江山为尔一迟留。\n春风不染衰翁鬓，卮酒难销壮士愁。\n结垒燕儿依故主，放舟渔父觅安流。\n眼中好恶谁能定，且托馀情赋玉楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李蕃分教合浦","author":"钟芳","text":"残暑全消石径斜，客舟维缆舣江沙。\n教分珠浦还同省，路入琼台却近家。\n闲倚风烟横夕望，自培桃李斗春花。\n酒酣不尽扳留兴，更倒双瓶送落霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和沈绣衣韵 其一","author":"钟芳","text":"寒日登楼惨不欢，茫茫愁思入无端。\n乐输颜巷能知少，声断虞琴欲续难。\n山小夕阳当户过，天空秋色隔江看。\n头颅半白成何事，满地丹枫岁又残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和沈绣衣韵 其二","author":"钟芳","text":"邂逅逢君辄尽欢，爱君丰采动台端。\n诗频愈觉交情洽，思苦方知得句难。\n不尽韶光眉上展，及时勋业镜中看。\n西风玉漏传高阁，一曲悲歌蜡炬残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"具庆重封卷","author":"钟芳","text":"恒岳精英占独多，古稀将近鬓同皤。\n重颁帝命回鸾鹊，喜溢宾筵艳绮罗。\n兰畹继沾馀庆远，瑶觞双映寿颜酡。\n微风入座林塘静，醉学仙人拍拍歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽沈淑人","author":"钟芳","text":"夫君宦业陟崇班，垂老长捐恨独难。\n逮下不惭江有汜，倦飞尤羡鸟知还。\n未亲鼎养馀悲在，已就菟营暮景闲。\n按诔摛词浑不尽，白杨烟雨自漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨景瑞归揭阳","author":"钟芳","text":"画舸风恬羡独还，徘徊相送碧云湾。\n江湖魏阙诗囊里，君宠亲恩跬步间。\n卓荦高名联棣萼，幽栖清胜足溪山。\n请看陌上垂杨树，叶叶知秋减故颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送卢上舍","author":"钟芳","text":"槐市通名入选曹，西风吹棹动江皋。\n眼中桂海沧波杳，天外钟山紫气高。\n樽俎旧怀倾里闬，丘园新兴合渔樵。\n须知乐极忧还极，渴甚三农雨未郊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽邹使君","author":"钟芳","text":"自甘丘壑大江隈，阀阅遥从宋季来。\n先世精忠遗笏在，晚年光宠画堂开。\n瑶台已化千年鹤，松径常封十亩苔。\n日暮中庭话儿女，秋风乔木不胜哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽钟封君","author":"钟芳","text":"一筇高卧海天涘，花木森森覆菉陂。\n万轴有书传子姓，秋毫无事扰公私。\n菟裘委顺心何憾，豸绣贻光福不迟。\n地远无缘分执绋，短歌聊用寄予悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和梁武选叔永韵","author":"钟芳","text":"细推物理溯源头，孟浪浮名可自由。\n春色未阑还共赏，蛾眉今老不须修。\n云依芳树元非定，莺啭新声或似求。\n独掩书斋坐昏暮，不知寒雨涨江流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]