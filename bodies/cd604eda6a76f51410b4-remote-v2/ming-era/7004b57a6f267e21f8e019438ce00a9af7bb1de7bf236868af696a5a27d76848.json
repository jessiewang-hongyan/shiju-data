[{"title":"苦热","author":"胡奎","text":"溽暑经旬懒出门，风亭水榭亦昏昏。\n徒闻露下黄姑渚，漫想冰生玉女盆。\n筠簟不教眠得稳，蔗浆犹觉饮来温。\n故人病起应相忆，何日从容共晚尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄枢上人","author":"胡奎","text":"上人年少解言诗，应是前身本姓支。\n多病养成丘壑志，学书临得庙堂碑。\n萝窗翳翳云封屋，茧纸重重墨满池。\n想得山中三日雨，煮茶烟起落花时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵 其一","author":"胡奎","text":"黄花翠竹带清溪，方外诗名惠远齐。\n铁钵夜分鲸海月，袈裟晴污燕巢泥。\n三生石上今重见，百丈峰头拟共跻。\n闻道御前宣教旨，天花如雨散龙墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵 其二","author":"胡奎","text":"支许论诗已有年，还同食蜜味中边。\n题名正喜芭蕉写，入定从教薜荔缠。\n暮雨疏钟高阁外，秋云短锡故山前。\n相过只说无生话，似觉浮生绝世缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬直方居士 其一","author":"胡奎","text":"髯翁经夏稀相见，绝爱清容似我兄。\n好采紫芝娱晚景，更栽红杏待春耕。\n长安女子应知姓，庐阜仙人早得名。\n从此草堂三日雨，相过莫厌绿苔生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬直方居士 其二","author":"胡奎","text":"自笑读书长闭户，每逢清友即同游。\n柴门可是妨人扫，斗酒还能与妇谋。\n任尔雨晴来看竹，从渠雪夜竟回舟。\n风流此意谁能识，赖有忘机海上鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬直方居士 其三","author":"胡奎","text":"墨池昨夜水生波，换得山阴道士鹅。\n盖世文章今有几，传家书谱已无多。\n休粮服得霞千片，握发盘成雪两螺。\n拟借白云分半榻，醒时言笑醉时歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬直方居士 其四","author":"胡奎","text":"鹤背东来不待招，云裳霞佩思飘飘。\n语言已觉无烟火，襟度还能振泬寥。\n近海玉楼天不远，当阶珠树雪初销。\n此中别有箕山趣，莫为风声即弃瓢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采莲女","author":"胡奎","text":"小小兰舟棹晚凉，双双新浴锦鸳鸯。\n舞回叶底春无力，笑入花间水亦香。\n妾恨恰如莲菂苦，郎情应似藕丝长。\n娉婷却笑东家女，换得明珠论斗量。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鞋山 其一","author":"胡奎","text":"一叶青莲堕碧波，美人不见奈愁何。\n天边有月羞弓样，水底无尘污袜罗。\n五老著来云气湿，小姑行处露花多。\n足音未许人间识，蹴蹋风涛几度过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鞋山 其二","author":"胡奎","text":"曾忆兰舟问二姑，何年只履堕晴湖。\n满江波浪流不去，小龙女儿穿得无。\n只许足音闻谷口，不教踪迹混泥途。\n至今想见凌波袜，隔水盈盈不受呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日东园即事 其一","author":"胡奎","text":"小园今日春意动，风目正东来草堂。\n萱草渐抽书带绿，柳条都酿曲尘黄。\n鸟声近屋啼偏好，雨点沾衣湿不妨。\n稚子下阶频指点，去年种竹已过墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日东园即事 其二","author":"胡奎","text":"东园检点旧生涯，春色多情到我家。\n谷雨前头移菊本，清明时节看梨花。\n但求北郭多收秫，何待东门更种瓜。\n今夜月明吹玉笛，笑呼儿女进流霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄东冈贾徵君","author":"胡奎","text":"三月三日雨晴初，东望东冈无鲤鱼。\n杜陵爱酒自多债，太传治安还有书。\n洛中牡丹少閒地，江上燕子识吾庐。\n木兰丹擢桃花水，颇怪近来踪迹珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东园春日","author":"胡奎","text":"检点小园无别事，清晨汲水自浇花。\n蔷薇碧引风前蔓，芍药红抽雨后芽。\n可是野情忘世故，正缘春色属诗家。\n山僧野老时相遇，分送菩提寺里茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄硖山人","author":"胡奎","text":"碣石岩前有隐君，草堂分得半间云。\n两湖月色当窗见，万壑秋声隔树闻。\n墨沼寒通丹井水，银床暗护紫苔纹。\n此身迥出烟霞表，长倚青霄看鹤群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕忆京中小弟","author":"胡奎","text":"明朝岁事又更新，应簉鹓行拜紫宸。\n鳷鹊观前还见雪，脊令原上况逢春。\n花占蜡炬怜今夕，酒进屠苏少一人。\n池草梦中深念汝，寄来诗句莫辞频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"双孔笛","author":"胡奎","text":"混沌谁分浊与清，凿开空翠太分明。\n有声本自无声出，二气还从一气生。\n碧海水寒龙并语，瑶台月白凤谐鸣。\n依稀黄鹤楼中听，吹落梅花雪满城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过贡秘书墓","author":"胡奎","text":"只今学士总奔波，不似先生葬薜萝。\n眼见蓬莱成海水，身骑箕尾上星河。\n开元供奉江南少，天禄词臣地下多。\n回首敬亭秋色远，山青云白奈愁何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西翠楼为郭医作","author":"胡奎","text":"北郭仙人十二楼，好山多在屋西头。\n凉阴晚送窗前雨，爽气朝迎笏外秋。\n翡翠半帘分太华，凤凰双琯下昆丘。\n安期定有如瓜枣，我欲相寻海上游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽高处士 其一","author":"胡奎","text":"阿翁手种春松树，预卜佳城已十年。\n将老便寻身后计，有儿能守墓傍田。\n晚凉就竹安茶具，春水当花放酒船。\n如此风流今绝少，一回西望一潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽高处士 其二","author":"胡奎","text":"忆昨相寻高处士，回舟醉蹋藕花风。\n三年别梦来溪上，一个閒身在墓中。\n故老只今俱寂寞，浮生方信是虚空。\n哀歌写罢缄双泪，秋叶离离夕照红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"失鹤","author":"胡奎","text":"仙人骐骥谁能驭，鍊得丹砂顶渐红。\n不见将军来射石，却瞋童子惯开笼。\n梦閒一曲沧洲月，声断三山碧落风。\n从此竹林无伴侣，洞箫吹彻綵云空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋惠山泉送张徵君之无锡","author":"胡奎","text":"往年曾识惠山人，遗我灵泉一味真。\n水品评来称第一，茶经著就已千春。\n也知陆羽曾分汲，信有梁鸿共卜邻。\n此去茅斋休煮雪，山瓶还许寄来频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题倪元镇画","author":"胡奎","text":"往年曾访天随子，烟树微茫过太湖。\n雪色寒鲈临水买，翠毛春鸟隔林呼。\n只今图画浑相似，如此家山住得无。\n皎皎白驹空谷里，令人搔首忆潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春雨","author":"胡奎","text":"今朝占得正东风，春在江南好雨中。\n六琯气从温室候，八方云与泰山通。\n调和草色相将绿，沾洒花枝取次红。\n茅舍一瓢生菜酒，自题春帖纪年丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过吴江 其一","author":"胡奎","text":"江上凉生白苧袍，荻花枫叶晚萧骚。\n长虹饮涧天在水，怒雷劈山风送涛。\n地势混茫通九泽，风流今古属二豪。\n收帆暂向枫湾泊，唤索吴姬压小槽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过吴江 其二","author":"胡奎","text":"第四桥头夕照红，收帆买纸谢龙公。\n酒从今夜赊明月，船待来朝借顺风。\n树色苍茫晴雨外，江光明灭有无中。\n今来古往东流水，无限閒情逐去鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和友人韵","author":"胡奎","text":"西望东冈首重回，菩提山在白云堆。\n乌衣燕去无华屋，碧眼僧来有劫灰。\n往事茫茫何足较，流年衮衮莫相催。\n梨花又过清明节，载酒无由得暂陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和黄应奉巧夕书怀","author":"胡奎","text":"凉云如练坐来收，此夜家家望女牛。\n列宿总随天北转，明河不共海东流。\n铜龙漏转三更月，白雁声传两地秋。\n笑卜蛛丝凭远信，有人相忆凤凰楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐玩月","author":"胡奎","text":"紫薇花满月团团，今夜三更最好看。\n碧海飞来银作阙，青云高处玉为盘。\n蛟龙应有含珠泪，兔臼宁无换骨丹。\n独据胡床吹短笛，苧袍风露不胜寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上","author":"胡奎","text":"三湘南去别情多，不唱吴歌唱楚歌。\n夜雨滴乾斑竹泪，春风吹老白蘋波。\n瑶琴谁和巴人曲，锦字空劳织女梭。\n却喜沅陵酒价贱，愁来犹得遣诗魔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日和应先生韵","author":"胡奎","text":"白发秋深莫浪悲，有酒且醉高阳池。\n百年知几从古少，一日不见令人思。\n醉来子细看萸佩，兴剧风流歌柘枝。\n洪范桥西浣花老，得钱相觅肯教迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼断臂禅师","author":"胡奎","text":"禅机山头一臂禅，幽居长在白云边。\n已超世网三千劫，不出山门二十年。\n坏衲朝阳松下石，春茶活火竹根泉。\n法身毕竟无来去，只履还应到五天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游鸡鸣寺","author":"胡奎","text":"夜半鸡鸣海日红，凭虚涌出梵王宫。\n绀园树色朝含雨，宝塔铃声昼撼风。\n飞锡神僧西域至，散花天女上方通。\n曾闻翠辇登临处，御墨留题紫翠中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杜弘道之襄阳","author":"胡奎","text":"西阁馀寒入毳袍，一尊送别思劳劳。\n路逢寒食花偏好，船压春江水正高。\n汉女堤边歌芍药，习家池上醉蒲萄。\n谷城令尹如相问，为说刘郎又种桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄宋纪善","author":"胡奎","text":"锦里先生两鬓丝，曳裾天府际昌时。\n经筵虎豹分重席，墨沼龙蛇见大旗。\n白雪久传梁苑赋，清朝新睹汉官仪。\n挥弦赖有知音在，欲把黄金铸子期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和贾徵君韵 其一","author":"胡奎","text":"不见故人今半年，寄我好诗情绪牵。\n朱弦泠泠有古调，玉树濯濯当春妍。\n前身可是韩京兆，此地曾逢贾浪仙。\n梦绕钟声寺前月，推敲两字至今传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和贾徵君韵 其二","author":"胡奎","text":"忆昨放舟相见时，系䌫宅前杨柳丝。\n别来晴云碧冉冉，看过秋叶红离离。\n茶煎雪水同谁吃，书到柴门有梦知。\n晴日半窗初睡起，水仙花畔和君诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和贾徵君韵 其三","author":"胡奎","text":"想见南窗日上时，硬黄茧纸写乌丝。\n兔敲玉臼丹应就，蛇避金尊影已离。\n司马时多文字渴，伯休谁遣姓名知。\n流年又及春盘菜，一度停云一赋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次郭先生韵","author":"胡奎","text":"南郭先生久不来，草堂日日向南开。\n笋已长成高过竹，花都狼籍半为苔。\n渴心谁慰病司马，诗债先偿曲秀才。\n闻道放舟苕水上，看山自倒白螺杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什 其一","author":"胡奎","text":"丹凤衔图振羽仪，六龙扶驭跃天池。\n紫垣月转通明殿，黄道星环太乙旗。\n宝鼎香烟穿柳细，金壶漏点出花迟。\n相如词赋真无敌，行见成都驷马驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什 其二","author":"胡奎","text":"清朝文轨万方同，人在金瓯覆橐中。\n五色丝纶颁凤阙，千年珠贝出龙宫。\n碧桃红杏当霄见，若木榑桑与海通。\n寄谢紫薇山下客，穷经慎勿叹头童。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次复柬先生纪行之什 其三","author":"胡奎","text":"未明司钥启晨阍，冠盖如云谒九门。\n百谷水归东海大，八方星拱北辰尊。\n鸡鸣紫禁宫花合，马度金河御柳繁。\n此日儒冠蒙锡赉，白头歌咏荷洪恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晨兴七宝山有作","author":"胡奎","text":"晨起登高望八荒，金霞承日上榑桑。\n潮头白处腾蛟鳄，天目青来舞凤凰。\n万井人家烟漠漠，诸天觉路海茫茫。\n长斋绣佛心如水，消得梅花昨夜霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题瞻云图","author":"胡奎","text":"望望高云不可攀，乡心都在画图间。\n门前白处皆苕水，屋上青来是弁山。\n食禄正思三釜养，买舟未省几时还。\n狄公勋业遗千载，莫待冯唐鬓发斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨判簿考绩如京","author":"胡奎","text":"我识关西好子孙，河源九派出昆崙。\n半生华发频看镜，秋夜黄金不到门。\n一曲离歌心事远，三年政绩口碑存。\n无端又向明朝别，手把茱萸泛绿尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄将军分镇台城","author":"胡奎","text":"夜半鸡鸣海日晴，将军东指亚夫营。\n山临华顶天逾近，星应台垣地最灵。\n总道张骞曾泛海，况逢黄石共谈兵。\n冬来若有长安使，只寄黄精与茯苓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海昌八咏 其一 海门洪涛","author":"胡奎","text":"一花初起白龙堆，万骑长驱石壁开。\n碧海有山都是雪，青天无雨只闻雷。\n秋高鸿鹄排云去，夜静蛟龙出穴来。\n借问乘槎向何处，五云咫尺是蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海昌八咏 其二 五祠古桧","author":"胡奎","text":"灵祠双桧郁葱葱，秀色浑如在鲁东。\n竽籁半空来凤吹，波涛中夜撼蛟宫。\n碧云团盖天门近，翠雾当窗日观通。\n会有神明扶正直，奇材真与栋梁同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海昌八咏 其三 紫峡秋云","author":"胡奎","text":"两峡亭亭拱翠微，白云漠漠澹秋晖。\n飞腾碧落从龙去，点缀青松待鹤归。\n夜度钟声来梵阁，朝浮岚气湿僧衣。\n会须化作商家雨，可是无心出岫飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海昌八咏 其四 顾况书台","author":"胡奎","text":"紫微之峰林壑幽，顾况台前曾一游。\n千年古寺白云外，一个长松丹井头。\n僧借翻经凉月夜，童来扫叶夕阳秋。\n明朝别后登临处，惟有书声杂涧流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海昌八咏 其五 葛洪丹井","author":"胡奎","text":"闻道仙人句漏令，烧丹此地学长生。\n林光每散金银气，石髓犹含日月精。\n仙药九还为白雪，灵泉一勺胜金茎。\n不须更借三山鹤，便碾飙轮上玉京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海昌八咏 其六 安国禅灯","author":"胡奎","text":"白头僧说唐朝寺，舍利犹存率堵波。\n师子座空无所住，犀牛扇破竟如何。\n灯悬海月慈光近，铎振天风梵呗多。\n最爱平原好孙子，时来坐石看曼陀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海昌八咏 其七 张许双庙","author":"胡奎","text":"睢阳太守清源令，衮冕巍巍共一祠。\n节重长淮坚守日，功高灵武中兴时。\n汗青不泯忠臣传，太白长悬大将旗。\n圣代春秋严祀典，祠臣鹄立见光仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海昌八咏 其八 虹桥夜月","author":"胡奎","text":"渴虹饮涧不曾收，化作飞梁卧碧流。\n银汉水分天上下，白莲花出海东头。\n鹤归华表吹笙夜，龙献明珠解佩秋。\n载酒长安三十里，醉呼鹦鹉更停舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄峡川杨司征","author":"胡奎","text":"我爱关西好孙子，紫微山水足遨游。\n千家树色双峰晓，万壑钟声六寺秋。\n渔唱樵歌通槜李，龙光剑气属扬州。\n老夫尽有登临兴，载酒能来倚暮楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春","author":"胡奎","text":"申年春自申时到，万物申申总向荣。\n南亩已沾三日雨，东皇能赐一朝晴。\n历颁夏正乾坤大，斗指寅方海宇清。\n白发野人瞻气象，五云高处泰阶平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题玉绣毬花 其一","author":"胡奎","text":"蕊珠宫女夜回鸾，一色流苏玉作团。\n琪树想从天上见，琼花曾向月中看。\n当场蹴起三春暮，信手围来二尺宽。\n却怪朝来万蝴蝶，随风飞舞碧阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题玉绣毬花 其二","author":"胡奎","text":"蕊珠宫女夜回鸾，玉琢流苏满画阑。\n偏称彩丝悬昼影，错教罗袜立春寒。\n翠云欲坠风扶起，粉蝶交飞雪作团。\n却笑美人惊堕马，琼花不数广陵看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游峡山寺 其一","author":"胡奎","text":"山气英英结紫霞，上方台殿布金沙。\n曾寻竺国俱胝石，因识唐朝顾况家。\n龙献珠来天欲雨，鹤随丹去井无砂。\n两年不到题诗处，想得枇杷又著花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游峡山寺 其二","author":"胡奎","text":"枇杷著花当仲冬，紫薇郎在紫薇峰。\n一尊明月南湖棹，两峡清霜六寺钟。\n茶具入林还傍竹，经台坐石更看松。\n此时何限登临兴，满抱风流属贺公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游峡山寺 其三","author":"胡奎","text":"雨后看山罨画同，挥毫不数米南宫。\n半生丘壑藏来久，一段烟霞写得工。\n绝顶鸟飞空界外，右肩僧袒夕阳中。\n悬知意匠经营苦，东望停云思不穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送富天源长老","author":"胡奎","text":"二月雪消春水肥，慧云上人明日归。\n杏花飞送官河棹，木兰染成田相衣。\n东海蛟龙长听法，南湖鱼鸟静忘机。\n何时共话三生石，坐听钟声出翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":56278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]