[{"title":"山中秋夜感兴 其十六","author":"王渐逵","text":"学圣人人共一班，每当粘滞廓清难。\n欲知跬步还千里，诚意津头仔细看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其十七","author":"王渐逵","text":"此心通道更无穷，休咎由来应不诬。\n此学千年多不讲，却从悬想着功夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其十八","author":"王渐逵","text":"圣门仁礼立双轮，表记檀弓语更真。\n我爱关西传此脉，独将遗教觉斯人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其十九","author":"王渐逵","text":"常于感应验中和，动处过时静亦过。\n若是深居资讲说，岂知禅定有头陀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其二十","author":"王渐逵","text":"威仪宣著有灵符，义理分明在扩充。\n立本若为真自了，却如盆上觅栽松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜感兴 其二十一","author":"王渐逵","text":"声音之学久相违，养德陶心自不支。\n不见齐门驱御速，却于韶乐识婴儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜李三洲自蜀回 其一","author":"王渐逵","text":"领略名山得更奇，仙姿灵质夙深期。\n青城道士多相识，新写参同注疏归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜李三洲自蜀回 其二","author":"王渐逵","text":"煦闰春风满面生，无人知是内丹成。\n好将少海菖蒲诀，为向罗浮刻石经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜李三洲自蜀回 其三","author":"王渐逵","text":"互萝深处一缄驰，惠我崔公剑阁词。\n读罢倚楼长注目，绿阴青子映朝晞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜李三洲自蜀回 其四","author":"王渐逵","text":"独携琴鹤下城都，文藻飘飘众所孚。\n万里桥边逢杜甫，百花潭胜锦江无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜李三洲自蜀回 其五","author":"王渐逵","text":"蕃羌险阨仗雄才，图画凭君展次开。\n懒向筹边楼上望，赞皇心事已全灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜李三洲自蜀回 其六","author":"王渐逵","text":"墟郊尚识棋盆市，颓壁重留八阵矶。\n知是武侯千载契，满船空贮晋公碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜李三洲自蜀回 其七","author":"王渐逵","text":"牛李维州议更纷，西洋羌僰亦吾人。\n遥知干羽敷王化，应有相如谕蜀文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜李三洲自蜀回 其八","author":"王渐逵","text":"越山诗社未曾榛，野老萧萧扫翳云。\n嬴得春来风景好，满林花鸟候词人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄蒋道林思南狱","author":"王渐逵","text":"衡岳孤且高，亭亭祝融峰。\n屹立镇南纪，瞻依世云同。\n美人居其下，云萝漫相封。\n安得一见之，我心则以降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"思武陵","author":"王渐逵","text":"武陵与世隔，千年隐奇迹。\n桃花满涧渠，渔父不相识。\n美人慕皇王，秦晋若喘息。\n安得问其源，翘首空叹惜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦游飞云寄伦右溪","author":"王渐逵","text":"三峰上界共跻攀，灵境仙都异世凡。\n碧落浴时天亦水，白头堆处浪为山。\n石楼斜拂星辰舍，玉洞平临虎豹关。\n回首中原何处觅，齐州九点缀人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王岱麓李三洲携酒过访诗以谢之三首 其一","author":"王渐逵","text":"朱火忽旋驾，园林荐秋姿。\n旬日昼掩关，顿觉来者稀。\n倏闻扣我门，远客有好怀。\n腆辞申雅宴，肴酌遥相携。\n班荆慰岑寂，兴溢席屡移。\n窈窕历层径，纡回缅幽扉。\n但言欢契谊，酒到不复辞。\n宁惜今辰醉，为君尽深卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王岱麓李三洲携酒过访诗以谢之三首 其二","author":"王渐逵","text":"古人重倾盖，那惜相知新。\n去者日以隔，来者日以亲。\n何意白首交，乃作行路人。\n远迹爱丛莽，养痾越台滨。\n曲肱阅尘鞅，于今得见君。\n庭荫列嘉树，日夕谛玄文。\n粗疏多谬误，所愿在率真。\n四海皆兄弟，何必比与邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王岱麓李三洲携酒过访诗以谢之三首 其三","author":"王渐逵","text":"芳荔荫石桥，丛篁翳高旻。\n徜徉豁幽况，不辨主与宾。\n骈榭临曲池，文槛连幽山。\n时运苦乖蹇，浊世难与言。\n共得醉中乐，讵为醒者陈。\n避諠寡所谐，谢俗常闭门。\n安得来二仲，解我心烦愠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李三洲一首","author":"王渐逵","text":"七月林亭初送暑，经秋荷渚尚馀花。\n子猷兴好还堪过，崔灏诗成不用加。\n灯火楼台悲管吹，茑萝门外少尘沙。\n清时乐事如相待，不见城南奏暮笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和王岱麓一首","author":"王渐逵","text":"移家遥傍翠微开，委巷真成避地来。\n癖病淹留虚岁月，清秋怀抱向楼台。\n携壶每爱依芳社，席地何妨散绿苔。\n多谢右丞情独至，殷勤杯酒故相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云顶","author":"王渐逵","text":"飞云杳何许，疑是祝融宫。\n石室自昏晓，太虚惟渺濛。\n瑞气多浮夜，凉云半碍空。\n会当凌八极，来此搆芳丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"轩辕宫","author":"王渐逵","text":"轩辕已仙去，空有故宫遗。\n石榻自秋草，云岩半夕晖。\n涧水疑玄调，山花尚翠帷。\n峰头旧时月，应照鹤同归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱明洞","author":"王渐逵","text":"骑鹤东回驻翠岑，空山还破寂寥音。\n寒云锁断溪头路，瑶草年来满涧森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青霞谷","author":"王渐逵","text":"青霞先生不识名，漉中大醉栖岩扃。\n道人见之抚掌笑，疑是狂客来四明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铁桥","author":"王渐逵","text":"狂客狂来不费招，瑶池春宴夜闻箫。\n醉馀不记归时路，犹跨青牛过铁桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄龙洞","author":"王渐逵","text":"洞里寻真得暂过，淡烟荒草蔓寒坡。\n乖龙不起应成癖，满目晴云柰尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠李道人","author":"王渐逵","text":"寻幽几度遥成访，采药东来尚未还。\n一笑相逢在何处，石楼西畔碧云湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访湛甘泉莲花洞","author":"王渐逵","text":"两至南乡岭，未识莲花洞。\n万古秘玄机，一朝显诸用。\n江山郁冲融，星斗遥以控。\n泉翁起南海，神鬼故呵从。\n大地不爱宝，灵境自歆贡。\n架壑栖霞扉，凌虚敞烟栋。\n杖屦得跻攀，长风复相送。\n身世浮太虚，恍惚如寐梦。\n萝浮去咫尺，沧海杳一纵。\n安得架长虹，飞云日相共。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访甘泉小华山 其一","author":"王渐逵","text":"小华峰顶一振衣，空山烟雨漫霏霏。\n须臾日出海天静，点缀罗浮看更奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访甘泉小华山 其二","author":"王渐逵","text":"古今贤哲起高风，五百人间未易逢。\n寄语希夷莫耽睡，华山今又属泉翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访甘泉书院 其一","author":"王渐逵","text":"甘泉宫是祝融宫，一脉昆崙贯始终。\n何处至人栖隐地，石台烟磴识仙踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访甘泉书院 其二","author":"王渐逵","text":"灵泉清彻注玄关，灏气元精共往还。\n直作川原归海去，不将尘滓混人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望罗浮和甘泉韵四首 其一","author":"王渐逵","text":"历遍堪舆未畅怀，直从沧海见斯涯。\n山当午会千年出，谁向三峰上界来。\n真诰谩将符录主，万灵应护洞天开。\n凭公为写丹青幅，四百峰头取次裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望罗浮和甘泉韵四首 其二","author":"王渐逵","text":"即看积翠向天中，已见飞流映日红。\n控鹤未须游八极，骑羊真欲御泠风。\n龙精隐伏空疑雨，星使依栖尽化松。\n莫讶轩辕归太逼，稚川先已住高峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望罗浮和甘泉韵四首 其三","author":"王渐逵","text":"廿年藏息傍岩隈，转眼光阴得许催。\n共叹浮生元是幻，应知历劫不为灰。\n烟霞落寞林中影，花鸟流连掌上杯。\n认得此山真面目，朱明开辟待君来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望罗浮和甘泉韵四首 其四","author":"王渐逵","text":"衡阳不数祝融峰，势接天门第几重。\n图影漫寻途以失，青苍凝望兴偏浓。\n欲从蝴蝶窥玄洞，喜有梅花认旧踪。\n记得石楼溪畔路，铁桥横处夹双松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"神游飞云诗和方西樵韵 其一","author":"王渐逵","text":"箬竺藤蓑自野人，野人应许是前身。\n向来更有罗浮赋，只恐山灵记不真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"神游飞云诗和方西樵韵 其二","author":"王渐逵","text":"傍花随柳自吾人，不是栖迟乞病身。\n试向孔门看事业，由来曾点属谁真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"神游飞云诗和方西樵韵 其三","author":"王渐逵","text":"蹑向天根始识人，先天何处觅安身。\n飞云顶上三更月，照得梅花色相真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"神游飞云诗和方西樵韵 其四","author":"王渐逵","text":"漫游曾忆属猪年，道士传惊是谪仙。\n记得三峰云外路，烟萝深处即诸天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"神游飞云诗和方西樵韵 其五","author":"王渐逵","text":"世路蹉跎感岁年，梦中招隐是何仙。\n遥应不负山灵约，早晚移家入洞天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"神游飞云诗和方西樵韵 其六","author":"王渐逵","text":"一堕尘踪已廿年，归来犹得伴群仙。\n舞鸾迥鹤知何世，瑶草琪花别有天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四贤祠用方西樵韵","author":"王渐逵","text":"四贤吾所慕，杖屦一跻游。\n祠宇云中见，仪形梦里求。\n绝学应难继，澄心可自酬。\n伫看山下水，赴海漫东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甘泉青霞书院用白沙韵","author":"王渐逵","text":"洞古飞霞迥，峰高万壑临。\n榛蒙嗟此道，开辟见吾心。\n蕙帐鹤长守，春堂花自深。\n山灵如听讲，故故簇幽岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵金牛洞歌","author":"王渐逵","text":"公骑金牛我黄鹄，云霞翩翩互相逐。\n铁桥东去望三山，暂憩峰头成小筑。\n金牛金牛柰尔何，函关紫气时相过。\n关门令尹知谁是，日暮飞云空自歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洗少汾读书台","author":"王渐逵","text":"孤台风月想高情，静入青霞适性灵。\n惟有山泉知此意，至今犹作读书声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天华宫用甘泉韵","author":"王渐逵","text":"蓬莱古仙阁，天华闻妙香。\n两涧流石髓，一歃充饥肠。\n我爱轩辕生，卜筑山之阳。\n时主不能致，浩然天一方。\n至今御园柑，犹复栖鸾皇。\n昔我往从之，铁桥亘且长。\n朝宴夜乐洞，夕宿金沙庄。\n烟霞驻羲望，倒景怜清光。\n安得谢世人，山中日相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云顶再用前韵 其一","author":"王渐逵","text":"沧海目初纵，清宵势欲临。\n人间无此客，天下共论心。\n闽越青还断，燕齐望更深。\n却怜旸谷日，夜半照孤岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云顶再用前韵 其二","author":"王渐逵","text":"南极仙灵隩，幽跻得更临。\n天应遗秘景，吾以慰初心。\n密荫连云暗，分流赴壑深。\n神游吾有纪，镌向碧苍岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水濂洞用洗少汾韵","author":"王渐逵","text":"容与步丹巘，逶迤转瑶石。\n飞声林杪度，玄韵岩端出。\n霏微绝禽鸣，莽荟暗浮迹。\n萧然独凝伫，万虑况空寂。\n初疑雨藏山，迟听风生壁。\n源泉神鬼呵，渊窅洞不测。\n临流发长啸，馀响杳无极。\n凌空散羽翰，逸思敞胸臆。\n众山何累累，俯瞰失群垤。\n日慕薄言旋，帘开月虚白。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和西樵出山韵","author":"王渐逵","text":"回首朱明意若何，石楼潜听步虚歌。\n黄龙锁断梅花路，只恐游人到不多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜甘泉西樵皆卜居罗浮","author":"王渐逵","text":"白日红尘事已非，几人曾此赋栖迟。\n濂溪若暇应重访，八甫不来空寄诗。\n山为仙灵元自秘，地当辽绝故堪奇。\n金牛路接青霞近，缥缈楼台慰所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别周云厓远游十首 其一 武夷山","author":"王渐逵","text":"枯楂遥望识仙踪，大隐屏开一棹通。\n莫向幔亭歌九曲，虹桥消处暮烟重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别周云厓远游十首 其二 烂柯山","author":"王渐逵","text":"石桥南去水萦连，缥缈青霞一洞天。\n逢着双童思故里，莫耽棋局变桑田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别周云厓远游十首 其三 富春山","author":"王渐逵","text":"锦绣峰头荒薜萝，空馀尘滓漫江波。\n相逢为谢羊裘老，只恐年来染钓蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别周云厓远游十首 其四 天台山","author":"王渐逵","text":"梦入天台迹未芜，双峰楼阁接天孤。\n凭君一滴清溪水，为写丹霞万丈图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别周云厓远游十首 其五 会稽山","author":"王渐逵","text":"女童五百归沧海，甲楯三千入土城。\n君向会稽山上望，路人应指禹王陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别周云厓远游十首 其六 衡岳","author":"王渐逵","text":"火德自当荆楚望，离明上直祝融宫。\n相逢晞发峰头坐，九点齐烟俯瞰中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别周云厓远游十首 其七 终南山","author":"王渐逵","text":"南山曾读退之诗，梦里依稀一见时。\n太白武功俱在望，欲乘黄鹄更相期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别周云厓远游十首 其八 青城山","author":"王渐逵","text":"蜀之迢递接青城，灵境仙都万古扃。\n七十洞中逢羽士，好求符箓觅长生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别周云厓远游十首 其九 西华山","author":"王渐逵","text":"日月岩边莲欲丛，芙蓉峰顶露初浓。\n数声鸣鹤秋空静，惊起希夷一梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别周云厓远游十首 其十 岱宗","author":"王渐逵","text":"日观远含沧海气，东皇遥控齐鲁封。\n不须更觅封禅迹，黄叶萧萧石径重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和郡守简一川韵二首 其一","author":"王渐逵","text":"古刹莺花迷洞口，上方钟磬出林间。\n千峰好月人同醉，半榻白云僧与闲。\n自合烟霞供逸性，欲从炉鼎驻朱颜。\n罗浮昨夜思玄梦，翠羽霓裳列两班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和郡守简一川韵二首 其二","author":"王渐逵","text":"岛屿孤标传海外，东南奇胜迥人间。\n楼台隔水深深映，猿鹤依人故故闲。\n梵劫已空云老相，江山曾识大苏颜。\n迁臣过客遥相感，儒雅风流自一班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒苏东坡祠","author":"王渐逵","text":"危栏曲径自逶迤，独挈荃衡酒一卮。\n宋室昔尊王氏学，鳌峰今拜长公祠。\n灯涵莲炬人归晚，枫冷林皋鹤梦奇。\n遥识此生如幻化，登临谁复问禅师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠灵洲云山师","author":"王渐逵","text":"纷纷名利逐波移，半为登临一强时。\n认得小金真色相，绿阴亭下卧云师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别孙德谦节推四首 其一","author":"王渐逵","text":"陟彼灵鳌峰，振衣上东皋。\n连蜷敞高盻，郁木扬清涛。\n故人向五云，飘举跻华高。\n何以慰我怀，宠德日已褒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别孙德谦节推四首 其二","author":"王渐逵","text":"麾旄弭南国，融风揭时休。\n蜚声动寰极，懿德讵能俦。\n观风日云远，眷彼康衢讴。\n我欲采以遗，因之达明旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":1275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]