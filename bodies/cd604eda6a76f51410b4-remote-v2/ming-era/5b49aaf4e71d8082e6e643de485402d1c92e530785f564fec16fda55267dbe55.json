295f79689","path":"明_2.csv","pointer":43073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十二绝句送敬美弟闽中学政 其十二","author":"王世贞","text":"右丞虽则恋清幽，五短元应让蜀州。\n记取玉矾书内句，莫容堂印挂心头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送肖甫司马于清洋江口","author":"王世贞","text":"清尊红烛暂为欢，临到分携醉醒难。\n纵有冰壶心一片，伴君终是怯长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再送伯玉至清洋口","author":"王世贞","text":"君携胡建我曹丘，各拥双株玉树秋。\n两地客星分不得，清洋中半是鸿沟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三送与绳至奣子","author":"王世贞","text":"两岸朱衣送宰官，中流衲子话团圞。\n自怜不了能仁字，归卧杉龛萝月寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四送明卿夜宿玉龙桥","author":"王世贞","text":"玉龙桥下水纵横，迭鼓回帆断续声。\n城头一片昆山月，多少人疑子晋笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五送本宁观潮南浦","author":"王世贞","text":"平原十日未从容，流水千重意万重。\n欲对乡人夸共载，仙舟自有郭林宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六送桢伯于城西关","author":"王世贞","text":"毋轻画省老冯郎，带銙生花艾绶黄。\n记取他年一奇事，岭南还策汉贤良。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用前例送家弟敬美视闽中学然至北水关而止盖余已徙居乡故也","author":"王世贞","text":"眼枯无泪意茫然，谢傅凭何遣暮年。\n若使弹成白翎雀，便应生断琵琶弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乡进士邹道甫以严君之命借听于余余实无得也不忍逆其意以二绝酬之 其一","author":"王世贞","text":"子云有字何须问，摩诘无言转更难。\n请看佛堂方丈地，丛丛忍草蔓栏干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乡进士邹道甫以严君之命借听于余余实无得也不忍逆其意以二绝酬之 其二","author":"王世贞","text":"髻里明珠当自知，无端贫里叩贫儿。\n北邙山下千堆土，葬尽神仙不解悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黎丘大王以手书及诗画见投寄谢并赠得六绝句 其一","author":"王世贞","text":"由来龙种尽权奇，七步陈王已唤迟。\n今日西园多应教，可能偏少仲宣诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黎丘大王以手书及诗画见投寄谢并赠得六绝句 其二","author":"王世贞","text":"修竹梁园兴有余，墨华长染马卿裾。\n怪来遍被千金赐，习得家王凤尾书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黎丘大王以手书及诗画见投寄谢并赠得六绝句 其三","author":"王世贞","text":"让帝虬髯三叶孙，汝阳眉宇尚天人。\n宫花不落砑光帽，羯鼓能催万树春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黎丘大王以手书及诗画见投寄谢并赠得六绝句 其四","author":"王世贞","text":"芙蓉迭迭冠霓旌，千乘贤王春豫情。\n道是麻姑山色好，便呼麟脯寄方平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黎丘大王以手书及诗画见投寄谢并赠得六绝句 其五","author":"王世贞","text":"鹅溪百尺茧丝宽，手写淇园万玉寒。\n移赠王生悬四壁，谁能触目不琅玕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黎丘大王以手书及诗画见投寄谢并赠得六绝句 其六","author":"王世贞","text":"惭愧何郎通隐名，长斋礼佛诵无生。\n纵然博得诸王饷，不乞嵇家旧酒鎗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠医者马道人","author":"王世贞","text":"谁似燕中马自然，药囊蓑笠但随肩。\n生憎董奉多牵系，不爱人间卖杏钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送元驭阁老二十里桥同前例得一绝句","author":"王世贞","text":"一叶轻舠破绿蘋，惊看蓬底两纶巾。\n道人却有分携泪，丞相何无祗候人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏十六首 其一 梵王桥","author":"王世贞","text":"隐隐红桥拂地开，徐徐蟾魄染青苔。\n诸天幻出金银相，色界天王尽下来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏十六首 其二 小祗林","author":"王世贞","text":"佛日初开大地阴，虚疑长者买祗林。\n翛然一片浮云过，欲问黄金何处寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏十六首 其三 藏金阁","author":"王世贞","text":"会得参同两渐和，庄生昨夜访维摩。\n若教更会真空意，万卷函经一字多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏十六首 其四 小罨画溪","author":"王世贞","text":"轻篙刺水澹忘归，狼籍残红处处飞。\n犹让当年霅中棹，两山空翠扑人衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏十六首 其五 磬折沟","author":"王世贞","text":"湾环轻泚似金沟，宛转洄沿客自留。\n两岸芙蓉相对发，即令无酒不悲秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏十六首 其六 金粟岭","author":"王世贞","text":"罢翻经卷旋呼杯，为爱天香桂子开。\n醉后飞花满巾帻，真成金粟卧如来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏十六首 其七 省获亭","author":"王世贞","text":"新■瓮底嘈嘈鸣，西邻稻垄黄云平。\n老夫眼饱腹亦饱，田家酒家虚得名。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏十六首 其八 缥缈楼","author":"王世贞","text":"独立缥缈之飞楼，又看浮云天际头。\n洞庭西峰九千尺，尺鴳不碍逍遥游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏十六首 其九 大观台","author":"王世贞","text":"日脚低垂雾半笼，虞山一抺有无中。\n划然长啸天风起，扫尽浮云现碧空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏十六首 其十 超然台","author":"王世贞","text":"巉岩百尺俯澄潭，天水相和共蔚蓝。\n小坐自然尘外境，日斜无意下西弇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏十六首 其十一 潜虬洞傍水窦","author":"王世贞","text":"小小空明远似无，泠然一水自萦纡。\n潜虬相唤不肯出，为惜胡髯径寸珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏十六首 其十二 绾奇台","author":"王世贞","text":"小台犹绾双弇奇，试问台奇台不知。\n游人到此意忽忽，半学杨朱悲路岐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏十六首 其十三 月波桥","author":"王世贞","text":"两弇中断有桥过，水束微风也自波。\n最好姮娥辉玉臂，莫容游擢搅青螺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏十六首 其十四 古廉石","author":"王世贞","text":"戍削风棱无媚姿，主人瞻拜具冠衣。\n乍可郁林将压载，那容汉女作支机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏十六首 其十五 壶公楼","author":"王世贞","text":"壶公饮酒酒初干，谁道壶中天地宽。\n幻出楼台成五色，飞来日月是双丸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弇园杂咏十六首 其十六 玉玲珑","author":"王世贞","text":"压尽千峰耸碧空，佳名谁并玉玲珑。\n梵音阁下眠三日，要看缭天吐白虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青玉笋即锦川峰之佳者并蜀锦也","author":"王世贞","text":"百尺排空玉笋青，山人端不负山灵。\n谁分望帝陵前锦，自是当年役五丁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"散花峡","author":"王世贞","text":"长年鼓棹穿岝崿，恰值春阑藤花落。\n一花堕帻酒一杯，懊恼东风不作恶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蟹螯峰","author":"王世贞","text":"毕郎左手偶一失，遗螯千秋化为石。\n当空怕遣酒星知，摄向微垣佐琼液。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":43110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]