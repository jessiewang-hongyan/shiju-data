[{"title":"下皋杂咏 其二","author":"黄仲昭","text":"山径荒凉月上时，郡僚奔走迓监司。\n道人引水浇畦罢，坐燎松明改旧诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其三","author":"黄仲昭","text":"豪气衰年未尽降，每因世事热衷肠。\n山庄来往惟农父，长话桑麻心自凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其四","author":"黄仲昭","text":"十亩山田种稻粱，茄秧新乞自邻乡。\n虽无钟鼎供游燕，且免红尘请谒忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其五","author":"黄仲昭","text":"何处偏宜养性灵，无端野趣在林扃。\n开帘犹恨前邻树，遮却遥山数尺青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其六","author":"黄仲昭","text":"山庄谁道不䌓华，桃李逢春解著花。\n秋至未应全落莫，芙蓉新种已抽芽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其七","author":"黄仲昭","text":"春雨初过水满川，神祠箫鼓正祈年。\n我来亦欲随乡俗，急典春衣入社钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其八","author":"黄仲昭","text":"春风一夜到桑麻，嫩叶柔枝渐次加。\n晓起喜闻童稚语，新移丹荔亦萌芽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其九","author":"黄仲昭","text":"一川桑柘隐烟霞，黄菊苍松自一家。\n更喜舍南添隙地，开渠占断白鸥沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其十","author":"黄仲昭","text":"日食何须鼎肉腴，新栽杞菊已扶疏。\n小池更引清溪水，春雨应添数尾鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其十一","author":"黄仲昭","text":"残书读罢启房栊，散步东风遣病慵。\n门巷翛然篱落矮，隔邻遥见夕阳舂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其十二","author":"黄仲昭","text":"未甘奔走混风尘，买断青山学隐沦。\n牟麦登场蚕作茧，林泉终老未须贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其十三","author":"黄仲昭","text":"芳村疏雨送微凉，倚杖村南看插秧。\n真趣满腔谁与语，起呼尊酒酹柴桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其十四","author":"黄仲昭","text":"尘寰无日是安居，喜遂山林寄一区。\n读易倦来无外事，闲看梁燕哺新雏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其十五","author":"黄仲昭","text":"丽日和风雨乍过，一丘一壑足婆娑。\n薄田有粟身无恙，天地私吾亦已多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其十六","author":"黄仲昭","text":"兴到展书谈舜禹，倦来拂枕卧烟霞。\n个中无限悠然趣，绝胜霜台晓放衙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其十七","author":"黄仲昭","text":"性与时违事事差，生涯只合付桑麻。\n看来富贵由天倖，传到儿孙有几家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其十八","author":"黄仲昭","text":"乡民水旱苦相仍，征敛无期立取盈。\n我亦呼儿急称贷，令人惆怅忆阳城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其十九","author":"黄仲昭","text":"苍松黄菊才三亩，流水柴门自一家。\n却悔平生都失计，坐听官鼓踏霜华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其二十","author":"黄仲昭","text":"辋川佳胜古来稀，犹欠吾庄一段奇。\n丹荔子栽今结实，薰风满树绛囊垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其二十一","author":"黄仲昭","text":"近日山君猛且饕，踰垣入屋攫牲牢。\n宋均不复生今世，谁遣深山灭迹逃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其二十二","author":"黄仲昭","text":"世途得丧见交情，径路萧萧草自青。\n惟有梁间双燕子，年年依旧访柴扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其二十三","author":"黄仲昭","text":"性癖情知与世殊，秪应归卧故山庐。\n山中亦有经纶事，朝课耕桑夕校书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋杂咏 其二十四","author":"黄仲昭","text":"闲来事事觉从容，始信山林可养慵。\n悔杀昔年成底事，红尘鞭马听朝钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠三山太守唐侯廷贵","author":"黄仲昭","text":"闽江缥缈漾晴波，争似君侯惠泽多。\n玉雪襟怀涵霁月，冰霜崖谷转阳和。\n闾阎不识催租吏，田野时闻击壤歌。\n圣代循良应有传，姓名指日入编摩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽温方伯琮","author":"黄仲昭","text":"使君一梦蹑仙踪，闽海家家辍相舂。\n廊庙有人思贡禹，泉台无路起元龙。\n紫薇花㡳春风老，棠树阴中草色浓。\n一束生刍从此别，蜀山回首暮云重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题林君叔孟秀远亭二首 其一","author":"黄仲昭","text":"系马幽亭久未旋，亭前景物各争妍。\n倚天晴翠千峰出，绕郭苍烟万井连。\n花影乱侵徐孺榻，莺声巧和伯牙弦。\n因君欲买西邻地，风月平分过暮年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题林君叔孟秀远亭二首 其二","author":"黄仲昭","text":"小亭新结傍幽蹊，窗户平临翠筱齐。\n宿雨收残山霭湿，浮云飞尽海天低。\n树连睥睨参差见，花隐房栊咫尺迷。\n安得笔端生五色，尽收佳景入新题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题渊明像","author":"黄仲昭","text":"典午乾坤已莫支，一官岂为督邮辞。\n壮怀激烈无由写，尽付东篱浊酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题刘伶像","author":"黄仲昭","text":"百年纵酒乐天真，荷插青山处处春。\n莫怪先生终日醉，乾坤谁是独醒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和惠安张大尹登最高峰韵二首 其一","author":"黄仲昭","text":"海天森列总云峰，尽在仙郎眺咏中。\n圣主牛刀教暂试，不须凝望紫宸宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和惠安张大尹登最高峰韵二首 其二","author":"黄仲昭","text":"绕邑谁当第一峰，兹峰独出万山中。\n何时麾却尘寰穴，来借岩阿半亩宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨竹二首为林信传赋 其二","author":"黄仲昭","text":"笼葱翠玉擅风标，白石清泉伴寂寥。\n安得伶伦裁凤管，五云深处和箫韶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"文峰书楼为陈文珍赋","author":"黄仲昭","text":"亭亭文笔玉嶙峋，下有层楼回出尘。\n四壁芸香浮汗简，三更藜焰逼穹旻。\n元方别驾声华旧，小阮黉宫教泽新。\n寄语云仍宜努力，莫教家学负前人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南溪别业次韵","author":"黄仲昭","text":"刺桐花下有华堂，别买溪南数亩庄。\n旋剪荆榛开町疃，更添亭馆带林塘。\n春岚压地苔花湿，暑雨蒸林荔子香。\n自笑一生缨冕累，无缘来共白云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林云山盆梅九月盛开魏竹溪有诗次韵二首 其一","author":"黄仲昭","text":"□□□处有盆梅，九月寒花的烁开。\n占取孤标寻菊□，挽将春意入秋来。\n天教早实调金鼎，人喜扬芬满柏台。\n三弄瑶琴豪兴发，未应何逊擅吟才。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林云山盆梅九月盛开魏竹溪有诗次韵二首 其二","author":"黄仲昭","text":"江南腊月见疏梅，此树高秋已盛开。\n东阁酒醒惊雪早，罗浮梦觉讶春来。\n西风入户香浮几，凉月当空影满台。\n欲为花神重作赋，广平人去愧非才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋俱乐亭扁 其一","author":"黄仲昭","text":"十载山庄没草莱，小亭今日喜新开。\n呼童痛洗亭前竹，要放南山翠色来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋俱乐亭扁 其二","author":"黄仲昭","text":"满目云山俱是乐，古人心与我心同。\n纷纷宠辱多忧患，真乐谁知在此中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋俱乐亭扁 其三","author":"黄仲昭","text":"开亭近对九龙山，人在千林紫翠间。\n造物于吾多所靳，惟应山水不吾悭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋俱乐亭扁 其四","author":"黄仲昭","text":"十年失脚走危途，天赋吾真半已芜。\n今日看山亭上坐，悠然始复见真吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋俱乐亭扁 其五","author":"黄仲昭","text":"亭前无地著尘氛，云外青山山外云。\n颇幸名途抽脚早，山灵犹未作移文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋俱乐亭扁 其六","author":"黄仲昭","text":"九龙山势郁嵯峨，翠入帘栊爽气多。\n读罢残书无一事，闲调绿绮和樵歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋俱乐亭扁 其七","author":"黄仲昭","text":"亭外群山翠绕檐，看山终日坐钩帘。\n东南天际浮云尽，又喜壶山露一尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋俱乐亭扁 其八","author":"黄仲昭","text":"列岫多情争秀丽，野花随意放芳妍。\n化工还有些儿欠，背却西淙瀑布泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋俱乐亭扁 其九","author":"黄仲昭","text":"烟云变幻多奇态，风月清妍无尽期。\n莫道吾亭欠华彩，天然图画列阶墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下皋俱乐亭扁 其十","author":"黄仲昭","text":"潇洒林亭仅数椽，包罗风景迥无边。\n夜来微雨兼秋至，彻骨清寒疑欲仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题仙溪陆世徵活水亭次郡守丁石崖韵 其一","author":"黄仲昭","text":"亭前静坐暗闻香，活水流花入小塘。\n闻说个中长若此，幽奇不独在春阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题仙溪陆世徵活水亭次郡守丁石崖韵 其二","author":"黄仲昭","text":"宣父当年叹逝川，眼前道体浩无边。\n与君说到渊微处，须向源头一放船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庆郑敏善先生年八十应诏冠带","author":"黄仲昭","text":"年跻八秩未龙钟，又沐清时宠渥隆。\n华发谩添乌帽雪，酡颜不藉锦衣红。\n已看敬老循周典，还见优贤有汉风。\n况遇圣明弘治日，蒲轮早晚召申公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送司训郑先生启善之任","author":"黄仲昭","text":"万里巴川育俊髦，一身许国不辞劳。\n明朝无复聆清训，今日休辞醉绿醪。\n猿啸溪头惊客梦，山横马首助诗豪。\n传经绛帐应多暇，一曲瑶琴夜月高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己未端午同吴继学方子大诸君游东岩二首 其一","author":"黄仲昭","text":"名途十载抱离忧，此日重欣结胜游。\n山色不随人事改，烟光似为客来收。\n底须身外论丰约，且向尊前共唱酬。\n薄暮微凉城上路，也随时俗看龙舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己未端午同吴继学方子大诸君游东岩二首 其二","author":"黄仲昭","text":"炎歊何处涤尘忧，共约东山寺里游。\n一鸟不鸣山更寂，千林增翠雨初收。\n老身犹喜康强在，佳节须将酩酊酬。\n请看群龙纷竞渡，谁怜野水有横舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题墨菊一首为延平通守金孔深赋","author":"黄仲昭","text":"楚楚黄花绝可人，晓来含露色尤匀。\n莫教轻泛柴桑酒，留取芳泉寿剑民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"黄仲昭","text":"萧然一室无馀物，短剑孤琴是旧知。\n闲里偏嫌人事扰，梦中亦怯世途危。\n久违故旧缘多病，断送光阴赖有诗。\n天命穷通皆一定，且倾尊酒不须悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别东岩偶成三首 其一","author":"黄仲昭","text":"东岩一到觉心清，便与高僧共结盟。\n宝地不堪今又别，山光树色总含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别东岩偶成三首 其二","author":"黄仲昭","text":"世事纷纷役此身，林泉无计日相亲。\n山灵应笑今归去，依旧胸中万斛尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别东岩偶成三首 其三","author":"黄仲昭","text":"斜阳惆怅别招提，吟逐寒云度虎溪。\n黄鸟似知人欲去，苍松枝上尽情啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马嵬三首集句 其一","author":"黄仲昭","text":"直北关山金鼓振，英雄无策庇婵娟。\n一朝艳质化尘土，明日何人拾翠钿。\n风散綵云飘碧落，苔生辇路湿苍烟。\n明眸皓齿今何在，满眼梨花哭杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马嵬三首集句 其二","author":"黄仲昭","text":"千里佳期一夕休，空馀涕泪洒清秋。\n魂归辽海云迷树，梦断江城月满楼。\n毛骨已随天地老，江山空结古今愁。\n长生殿古生青草，七夕何人望斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马嵬三首集句 其三","author":"黄仲昭","text":"潇潇疏雨响残除，壮士吹笳惨不舒。\n白玉帐寒鸳梦绝，蒲萄衾冷夜窗虚。\n碧鸡祠下杜鹃叫，白帝城边古木疏。\n海阔天高不知处，蓬莱何日候仙车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"姑苏怀古二首集句 其一","author":"黄仲昭","text":"吴王醉处十馀里，燕语莺啼空断肠。\n霸业已随烟烬灭，泪痕滴透碧苔香。\n彩鸳静占银塘水，密雨斜侵薜荔墙。\n惆怅无因见范蠡，五湖烟浪正茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"姑苏怀古二首集句 其二","author":"黄仲昭","text":"西施去泛五湖舟，万紫千红梦已休。\n故国尽消龙虎气，残蝉如说古今愁。\n桂房椒壁蕙兰老，金沓瑶琴鹿豕游。\n故事悠悠不可问，往来惟见水东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和林君时恭山居韵四首 其一","author":"黄仲昭","text":"春入池塘草色新，吟边鱼鸟觉情亲。\n雨馀涧水流花出，恍惚桃源洞里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和林君时恭山居韵四首 其二","author":"黄仲昭","text":"入夏林端荔子新，开尊时与故人亲。\n有时笑傲苍松下，闲看红尘得意人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和林君时恭山居韵四首 其三","author":"黄仲昭","text":"小槽酿出绿醪新，溪叟山翁笑语亲。\n吟对黄花无别事，悠然尘外一闲人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和林君时恭山居韵四首 其四","author":"黄仲昭","text":"万壑千峰积雪新，闲中诗酒镇相亲。\n兴来独步溪桥月，笑与梅花作主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题老子授尹喜道德经图","author":"黄仲昭","text":"叹息淳风日已沦，深探性命著微言。\n当年不授关门尹，万古谁知道德尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题张良进履图","author":"黄仲昭","text":"天挺人豪遇下邳，留侯遂作帝王师。\n秦关百二山河破，应是胚胎进履时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题钟吕传道图","author":"黄仲昭","text":"传得壶天却老方，茫茫八极任翱翔。\n颓龄若使真能制，大济苍生总寿康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题张咏谒陈希夷图","author":"黄仲昭","text":"坠驴大笑西归去，买断华山一段云。\n浮世知心独张咏，无边风月欲平分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题子期听伯牙鼓琴图","author":"黄仲昭","text":"不因钟子独知音，山水徒然托意深。\n千古高风招不返，伤心弗忍抚瑶琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题扇面小景","author":"黄仲昭","text":"阴阴绿树散清凉，扶醉同消夏日长。\n一段溪山看不尽，浩歌相对任斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题钓台图","author":"黄仲昭","text":"光武中兴网俊才，先生晦迹隐蒿莱。\n云台寥落成榛莽，万古犹传旧钓台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]