[{"title":"阻雨凤翔官舍咏竹二首 其二","author":"郑岳","text":"秋暮雨凄凄，开轩万竹齐。\n震雷惊笋迸，积雾压枝低。\n嶰谷伶伦杳，湘江帝子迷。\n岐山回首近，还待凤凰栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15823,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清水道中","author":"郑岳","text":"百里关山隔，千林气候分。\n霜华飞冉冉，木叶坠纷纷。\n日照云根湿，溪回草气芬。\n涧泉流细响，雨过更堪闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15824,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"棘寺后轩芍药盛开邀诸同寅小酌","author":"郑岳","text":"棘台当昼永，药圃过春残。\n对客偶多兴，凭轩一试看。\n蛾眉分黛绿，鹤顶妒琼丹。\n开落年年事，芳根阅岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15825,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"通州道中奉柬费湖东石熊峰贾南坞三阁老","author":"郑岳","text":"出昼经三宿，吾行未厌迟。\n群公期出祖，满卷重贻诗。\n天地开晴旭，山川耀远姿。\n去途净如洗，尘土岂容缁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15826,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中忆华山","author":"郑岳","text":"昨日观西岳，奇峰面面环。\n境幽将独往，兴尽更迟还。\n雨色冥濛外，钟声杳霭间。\n使归仍过此，直欲步孱颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15827,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"野宿","author":"郑岳","text":"浃旬长苦雨，今夕月生光。\n影动晴峰雪，寒凝碧瓦霜。\n盘飧罗野蔌，鸡犬静村庄。\n重引还山兴，题诗寄草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15828,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"见冰","author":"郑岳","text":"野次凌晨发，前旌阻乱滩。\n峰岩度陇峻，气候近边寒。\n涧浅冰先结，泥深冻未乾。\n北归愁雨雪，迢递望长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15829,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"北坛夜坐","author":"郑岳","text":"出郭谢尘鞅，幽虚复此轩。\n神清浑少睡，心远不闻喧。\n树影寒欺烛，蛩声暗到门。\n晨朝助明荐，端坐欲忘言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15830,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日泛舟木兰二首 其一","author":"郑岳","text":"南郭晓初霁，维舟曲岸傍。\n踏青林莽净，修禊水云长。\n汀雾晴犹湿，潭花落更香。\n木兰知不远，渔唱隔沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15831,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日泛舟木兰二首 其二","author":"郑岳","text":"萝径登溪阁，凭虚一啸吟。\n鸟声林屋迥，树色石坛深。\n春晚催农事，人间养道心。\n绝胜风雪夜，迢递访山阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15832,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西洲偶成","author":"郑岳","text":"瓜圃秋延蔓，粳田晚种苗。\n三农逢稔岁，一饭答清朝。\n野旷炎威散，人閒世虑消。\n受廛吾计定，不待小山招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15833,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黄伯固起大理寺丞得枯株类石爱而藏之戏题","author":"郑岳","text":"自分委沟壑，岁深始一遭。\n主人爱奇古，此物出林皋。\n斑剥深纹断，崚嶒老气豪。\n坐看长芝菌，生意未萧骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15834,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湘源别妹婿陈德昭还莆","author":"郑岳","text":"旅馆年光暮，殊方意绪长。\n束装辞五岭，并棹下三湘。\n残雪分歧路，飞云认故乡。\n三年废甘旨，为我慰慈堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15835,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿石泉寺修先墓感怀二首 其一","author":"郑岳","text":"石泉旧名寺，废坠亦堪哀。\n岩桂春开落，溪云日去来。\n基荒选佛阁，草没雨花台。\n世界归空寂，乾坤几劫灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15836,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿石泉寺修先墓感怀二首 其二","author":"郑岳","text":"曲涧依高坂，荒墟带远林。\n封培六世垄，跋涉两山岑。\n湖海多年梦，松楸此日心。\n昊天何可极，老泪洒衣襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15837,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈生南还","author":"郑岳","text":"榆柳散轻烟，春风又别筵。\n帝乡逢故侣，客思入新年。\n镜里冰霜色，囊中锦绣篇。\n小西湖上月，相望几回圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15838,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次前韵送陈山人还莆","author":"郑岳","text":"素纸落云烟，书名动四筵。\n卜居元共巷，别路已经年。\n逸少笼鹅兴，公孙舞剑篇。\n古碑随处见，笔意更清圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15839,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴门卧病承同年王敬止枉顾","author":"郑岳","text":"药饵扶馀病，江山负赏心。\n闭门怜独卧，枉驾遇知音。\n泽国雁声早，吴门秋色深。\n稍须精力健，同上虎丘岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15840,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"嘉兴遇同年胡静庵亚卿夜话","author":"郑岳","text":"我即南归路，君当北上时。\n方舟侵夜话，聚首积年期。\n兵柄难操切，宦途多崄巇。\n平生重节槩，出处复奚疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15841,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重阳日经车盘驿","author":"郑岳","text":"迢递车盘道，闽关望不赊。\n四年怜作客，万里喜还家。\n树隐山含雾，溪明水印沙。\n重阳风日好，一任葛巾斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15842,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"淇县道中","author":"郑岳","text":"一雨炎歊净，轻阴匝柳堤。\n津亭流乱水，辙迹陷深泥。\n馀润宁翻井，荒原尽举犁。\n农家休叹晚，犹及饷蒸藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15843,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜感怀寄邵二泉宗伯二首 其一","author":"郑岳","text":"悄悄空庭暮，啼乌集子城。\n疏灯悬夜雨，落叶散秋声。\n遁迹元无累，忧时独系情。\n何当逢北使，款语及升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15844,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜感怀寄邵二泉宗伯二首 其二","author":"郑岳","text":"天道开皇极，人心望太平。\n八蛮俱入贡，四海且休兵。\n献纳多英俊，谋谟足老成。\n何当变新局，快意较输嬴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15845,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乙酉除夜二首 其一","author":"郑岳","text":"荏苒岁云暮，悠悠此夕除。\n城闉人语寂，灯火夜堂虚。\n娱老樽馀醁，诒谋架有书。\n春来身尚健，绿野课耕锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15846,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乙酉除夜二首 其二","author":"郑岳","text":"去国归舆论，还家值岁和。\n高谈成濩落，宿计任蹉跎。\n椒叶熏人醉，梅花照鬓皤。\n奚囊检诗课，较与去年多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15847,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"拟古何处难忘酒二首 其一","author":"郑岳","text":"何处难忘酒，春风欲暮时。\n虫鱼荒素业，钟鼎负前期。\n白社风烟古，沧洲药草滋。\n此时无一盏，奚以慰支离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15848,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"拟古何处难忘酒二首 其二","author":"郑岳","text":"何处难忘酒，间关世路难。\n虚名惭海内，孤迹滞江干。\n燕避重帘远，花经宿雨残。\n此时无一盏，寂寞对谁看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15849,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽王廷玉乃父","author":"郑岳","text":"岂无死绥志，恸哭向阴山。\n失险六师破，冒围一士还。\n仪床衣尚赤，墓道草空斑。\n边衅何人启，忠魂绕汉关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15850,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽王存敬郡公","author":"郑岳","text":"海内名流少，嗟公又梦楹。\n飘零千里道，恸哭万家城。\n山谷留诗句，乖厓足治声。\n棠梨花发处，南国有遗情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15851,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽故守潘公舜弦","author":"郑岳","text":"别郡初传讣，因风远寄悲。\n检田民不扰，判案吏难欺。\n叔度来时颂，何公去后思。\n千年舆论定，名宦列高祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15852,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西郭经故友陈如宾墓二首 其一","author":"郑岳","text":"德言犹在耳，洒泣忽经春。\n川岳收光气，冰霜老素臣。\n手营坟域近，祀托族枝亲。\n物论从前定，乾坤只一真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15853,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西郭经故友陈如宾墓二首 其二","author":"郑岳","text":"考亭遗道脉，落落竟谁扶。\n独立凌千古，清风振八区。\n圣心怜最苦，时论病犹迂。\n俯仰怀知己，空山一束刍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15854,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李大理仲阳邀游白水塘夜宿泛波楼有作","author":"郑岳","text":"开轩临北渚，见月上东溟。\n爽气生衣袂，清光溢户庭。\n映空塘水白，隔岸海峰青。\n夜静微波起，浮槎犯斗星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15855,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答林侍御时献招饮流泉","author":"郑岳","text":"开荒临野浦，结屋俯流泉。\n地僻何曾俗，人閒即是仙。\n银丝鱼脍美，锦箨笋芽鲜。\n雨后添新绿，前溪可放船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15856,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚秋社会溪阁二首 其一","author":"郑岳","text":"溪阁重游地，秋光欲尽时。\n石崖悬瘦影，岩桂媚幽姿。\n野阔云俱敛，波深鸟独知。\n黄家有盆树，向晚看尤奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15857,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚秋社会溪阁二首 其二","author":"郑岳","text":"胜游成屡约，俗事苦相妨。\n叠石横沙渚，清溪进野航。\n稻香仍候雨，木落始知霜。\n节物时时变，难禁鬓发苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15858,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"约游次林都宪孚可韵","author":"郑岳","text":"雨深花落尽，泥湿燕来新。\n拙性多违物，馀年早乞身。\n胜游怀独往，俗事苦相因。\n在处存调燮，微斟竹叶春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15859,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日邀社友泛舟","author":"郑岳","text":"逸老成嘉会，今来又一周。\n寒声催落叶，月色近中秋。\n感物时应变，劳生事已休。\n沧浪歌鼓枻，天地一虚舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15860,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暮春社会东山樵舍","author":"郑岳","text":"樵舍东山近，僧岩北郭深。\n多时成契阔，晦日试登临。\n春暮花争发，林深鸟一吟。\n尘寰应迥隔，聊共涤烦襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15861,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿弘慈寺","author":"郑岳","text":"暝色下城闉，禅关隔素尘。\n竹枯含旧冻，梅放漏先春。\n臧否从时论，行藏识古人。\n羁栖犹未定，瞑坐养吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15862,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"诞日谒先考妣墓","author":"郑岳","text":"九我恩难报，悽然感诞辰。\n松楸今日泪，天地此生身。\n壮志消蓬矢，休祥负绂麟。\n一杯酹黄土，肸蚃不无神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15863,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"榕台","author":"郑岳","text":"过眉方竹杖，扶醉上榕台。\n万木横空绕，群峰到海回。\n桑麻怀栗里，笙鹤隐蓬莱。\n结社谁同调，白莲花正开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15864,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"避暑梅庄","author":"郑岳","text":"门巷埋深辙，轩楹俯浅山。\n百年馀此日，万事近衰颜。\n漆室空忧世，鹿门独闭关。\n物情各有适，日暮鸟飞还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15865,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日梅陇书事","author":"郑岳","text":"步屣仍扶杖，抛书独凭阑。\n凝烟迷野望，积雨酿春寒。\n麦陇抽新绿，花枝缀渥丹。\n韶华不觉换，犹作去年看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15866,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蒲坂构祠书事","author":"郑岳","text":"故里心长系，新祠喜落成。\n好山当面立，流水入怀清。\n文献开先裔，公侯复始情。\n衰年头重白，力尽此经营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15867,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜宿月峰兰若","author":"郑岳","text":"道心常自适，尘界讵能迷。\n榆景偶多暇，禅林时一栖。\n钟声风断续，树影月高低。\n万有皆虚寂，晴窗闻晓鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15868,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"首春邀邻曲二三友游梅陇兼卜新兆旷然有怀二首 其一","author":"郑岳","text":"小丘聊试卜，高下屡移筹。\n造物藏深巧，人生图永休。\n决渠分麦陇，趁雨种松楸。\n鸡黍堪供客，无妨信宿留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15869,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"首春邀邻曲二三友游梅陇兼卜新兆旷然有怀二首 其二","author":"郑岳","text":"岁华惊忽改，草构喜新成。\n邻舍旧俦侣，吾家老弟兄。\n登临寻宿约，欢笑慰平生。\n明日归城市，悠悠无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15870,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日山中杂咏三首 其一","author":"郑岳","text":"避俗寻幽壑，度閒课小诗。\n城中消息断，林下起居迟。\n农事邻翁话，机心野鹤知。\n峰头云忽变，薄暮雨来时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15871,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日山中杂咏三首 其二","author":"郑岳","text":"一春常苦旱，入夏望犹悭。\n薄午雷方震，通宵雨未阑。\n溪流分远碧，草色变新斑。\n田父驱牛出，檐鸠唤妇还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15872,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日山中杂咏三首 其三","author":"郑岳","text":"岁俭人方困，春深力未齐。\n平洋初插莳，高陇欲翻犁。\n雨色连村暗，檐声入户低。\n丰年兹可卜，满意是山栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15873,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日梅陇杂咏二首 其一","author":"郑岳","text":"树杂常遮日，墙低不碍风。\n高眠三伏静，宴坐一尘空。\n齿豁仍愁痛，鬓疏更觉蓬。\n渭滨老渔钓，无意梦非熊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15874,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日梅陇杂咏二首 其二","author":"郑岳","text":"地旷无拘碍，林虚转寂寥。\n蛛丝悬近户，鸟语隐深条。\n多病依农亩，馀生荷圣朝。\n独惭无厚德，閒福恐难消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15875,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟夜二首 其一","author":"郑岳","text":"寂历江村暮，归舟欸乃歌。\n千峰含宿霭，一水漾清波。\n挥烛驱蚊去，钩帘待月过。\n老夫兴不浅，端坐夜如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15876,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟夜二首 其二","author":"郑岳","text":"日敛江光暝，风寒水气凉。\n舟帆低著岸，月色近临床。\n感慨仍多事，栖迟自一乡。\n古今徒俯仰，两鬓已成苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15877,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓发建溪","author":"郑岳","text":"夜雨添新涨，傍舟与岸齐。\n漫滩浮乱石，叠嶂夹危溪。\n夷险心无累，行藏道岂迷。\n故园觉清旷，更好结幽栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15878,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"八月二十四日雨雪二首 其一","author":"郑岳","text":"门径绝行踪，晨鸡复暮钟。\n断桥深阻客，积潦久妨农。\n阴结三秋雪，寒生八月冬。\n茫茫真宰意，欲问苦无从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15879,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"八月二十四日雨雪二首 其二","author":"郑岳","text":"仲秋交雨雪，父老道前无。\n粟穗登场少，麦花触冻枯。\n乾坤存燮理，民物重艰虞。\n昨夜传飞檄，河西更戒涂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15880,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"马嵬","author":"郑岳","text":"割爱苦不早，临危奈若何。\n闻铃斜谷道，埋玉马嵬坡。\n宝靥销残粉，霓裳失旧歌。\n千年亡国地，惆怅一经过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15881,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"华州郭汾阳故里","author":"郑岳","text":"汾阳旧居里，乃在华山阿。\n列岫疑分垒，攒峰类偃戈。\n孤忠扶日月，百战奠关河。\n善处功名际，萋斐奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15882,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秦州","author":"郑岳","text":"成周仍祀益，非子始封秦。\n列国舆图尽，西戎霸业新。\n山川犹故国，宇宙一浮尘。\n杜老侨居处，诗篇尚有神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15883,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天津纪胜","author":"郑岳","text":"万国舟航会，诸河渤澥通。\n星躔环极北，兵卫控京东。\n人逐鱼盐利，天开形势雄。\n时平仍设戒，永不动戈戎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15884,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九鲤湖","author":"郑岳","text":"拥被宿云馆，神清梦亦安。\n水声喧夜雨，山气挟春寒。\n檐箔明星度，溪芗白露团。\n神仙隐名姓，厓上不须镵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15885,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林见素出殡感伤二首 其一","author":"郑岳","text":"云庄还旧隐，寿水复新阡。\n宅兆青山改，精灵白日悬。\n乾坤收正气，朝野失名贤。\n身后无遗表，恩波隔九泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15886,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林见素出殡感伤二首 其二","author":"郑岳","text":"乔岳颓乡望，悲风动士林。\n三孤酬晚遇，再疏遂初心。\n归老同投笏，论文每盍簪。\n追思丽泽处，执绋泪沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15887,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈石峰出殡感伤","author":"郑岳","text":"輀车垂素幕，欲发故迟迟。\n雨湿铭旌冷，风寒鼓角悲。\n青丘成永别，白首失相知。\n物论从前定，无惭郭泰碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15888,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"方松厓出殡感伤","author":"郑岳","text":"六桂传芳韵，二难振羽仪。\n平生多节槩，吾道有光辉。\n十里佳城在，三生旧话非。\n客途曾梦我，迢递劝君归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15889,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和汝仪招游溪阁韵","author":"郑岳","text":"溪舫临门系，茅堂背阁开。\n岁从忙里过，春向老边来。\n严韵赓新句，醇醪酌浅杯。\n烟光延夕景，留兴未能回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15890,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次翠庭折柬招饮韵","author":"郑岳","text":"泥雨愁方困，缄书喜见招。\n亭台荒积藓，松桂发新条。\n有酒须倾倒，无诗恐寂寥。\n慇勤催早赴，语仆戒晨朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15891,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠杨子丰尹河源","author":"郑岳","text":"理郡名犹在，移官事颇奇。\n人生应有分，世路亦多歧。\n素节看逾壮，丹衷谅不移。\n罗浮高倚剑，越井净流卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":15892,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]