d192fe5294295f79689","path":"明_1.csv","pointer":35091,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"高廷礼水墨二图 其一","author":"王恭","text":"龙门醉后墨壶倾，京国遥传北苑名。\n今日玉堂相梦夜，花昙春树更含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35092,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"高廷礼水墨二图 其二","author":"王恭","text":"重林茅舍清溪口，山人醉倒黄精酒。\n峰头昨夜春雨多，起拂萝衣听寒溜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35093,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偶题林本清界画","author":"王恭","text":"云里仙台别望遥，三花飞近水精桥。\n秋山未下麻姑鹤，虚负璚楼品玉箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35094,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"钱舜举羽毛 其一","author":"王恭","text":"娇鸟双飞恋浅红，乐游原上晓嘶骢。\n别来已少看花伴，空对芳菲落画中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35095,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"钱舜举羽毛 其二","author":"王恭","text":"我惜钱郎粉墨奇，莫将花鸟让徐熙。\n湘帘几度银灯夕，只讶菱歌太液池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35096,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题林遵性临方壶墨竹","author":"王恭","text":"我惜琳琅若故人，一回行见一回亲。\n谁家拓得方壶影，醉眼看时只悟真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35097,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"墨兰三图 其一","author":"王恭","text":"去国谁惊蕙草秋，几回馥郁向中洲。\n只今泽畔行吟处，湘水无情也解愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35098,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"墨兰三图 其二","author":"王恭","text":"翠叶瑶花凉露飞，山林谁共爱芳菲。\n花时莫更纫为佩，满目秋风楚客稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35099,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"墨兰三图 其三","author":"王恭","text":"三月微霜九畹寒，断香残粉思漫漫。\n多情公子今何处，白首空歌澧有兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35100,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书李白问月","author":"王恭","text":"银瓮閒倾采石春，水天凉月夜无尘。\n如何翠辇西行处，凝碧池头照别人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35101,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"高太史墨竹","author":"王恭","text":"乍见琳琅忆澹游，恍然金薤想湖州。\n谁将史籀临池法，醉扫湘江几叶秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35102,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书补之墨梅","author":"王恭","text":"杨家墨妙世间稀，曾是明光敕赐归。\n今日画图流落处，断香残粉思依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35103,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅花城留别 其一","author":"王恭","text":"此会明年未有期，便将轻别作长离。\n多情莫学千金水，才满空江又落时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35104,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅花城留别 其二","author":"王恭","text":"腊日山城见雪初，故人别后会应疏。\n沙头无日无来雁，相问从今秪寄书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35105,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"方氏日趣轩","author":"王恭","text":"端居适清暇，爱此林中屋。\n晼晚田圃间，优游会心目。\n春风始萌达，秋草萋已绿。\n玄蝉号树枝，岁事已闻促。\n始自感物候，终然媚幽独。\n物淡境自忘，心閒意方足。\n浮荣岂不顾，安命良无欲。\n缅怀柴桑人，临风伫芳躅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35106,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张良进履","author":"王恭","text":"嬴君震六合，侯国日已隳。\n区区相韩心，忠愤不得施。\n道逢庞眉叟，感激心内知。\n屈体但长跪，忍性能自卑。\n丈夫有远略，小节宁顾之。\n慇勤袖简册，可为王者师。\n终然辟谷去，永与赤松期。\n秪今圯桥道，千载令人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35107,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"纪梦","author":"王恭","text":"假寐登九疑，遥遥见湘君。\n文螭与赤豹，飒沓何纷纷。\n掩瑟泣幽怨，行招虞帝魂。\n青枫洞庭气，白雨潇湘昏。\n銮舆覆华盖，招摇烂垂云。\n我见未及跪，六龙忽飞奔。\n欲陈腹中事，哽咽不得言。\n觉来北窗曙，月落啼清?。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35108,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"逢楚上人","author":"王恭","text":"客有紫霞想，行寻白云峰。\n自期名仙会，适与高人逢。\n邂逅展良晤，优游企高踪。\n丝桐属清响，石林闻霜钟。\n旬时积阴霭，海色浮空濛。\n清旦丽初旭，孤帆别匆匆。\n秋山绿萝月，何日与君同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35109,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"稽山怀古","author":"王恭","text":"遥遥稽山云，淡淡镜湖水。\n云水两无心，千秋亦相似。\n忆昔金门人，黄冠此山里。\n恩荣□□□，但得遂初志。\n兰亭何岧峣，修竹犹深邃。\n欲识斯人居，寂寞山阴是。\n我来吊遗踪，临风写幽意。\n恻怆更何言，落日猿声起。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35110,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得凌霄花寄友人","author":"王恭","text":"凌霄产朱夏，因依郁青苍。\n引蔓絓高树，垂阴近中堂。\n炎风媚朝景，暑雨湿红芳。\n容华难久恃，采折空自伤。\n欲寄同心者，道远川无梁。\n谅非松柏操，伫立徒慨慷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35111,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日过周六园林因有茶瓜之会","author":"王恭","text":"盛夏日方永，端居忆登临。\n同袍四五辈，共爱嘉树林。\n一径入幽僻，苍苍群木阴。\n脱巾坐石榻，拂石弦五琴。\n泠泠涧泉水，婉婉山鸟音。\n荤酒亦易致，茶瓜非外寻。\n以兹有佳趣，聊用忘归心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35112,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书云山小景","author":"王恭","text":"岩壑昨夜雨，千峰霁朝色。\n白云何方来，相对澹孤寂。\n人烟带长林，僧宇邻蛟室。\n落景天际帆，青山鸟边宅。\n思同静者论，相期在萝薜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35113,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春夜怀同袍友","author":"王恭","text":"春夜不能寐，起坐弹吾琴。\n泠泠七弦上，感激怀知音。\n微雨半帘静，孤灯千里心。\n故人不可见，况此别来深。\n幽期讵可即，梦里能相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35114,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人中秋闱归莆中","author":"王恭","text":"治世竟先达，英材惟陆机。\n秋闱况得意，复忆家林归。\n落日江上别，凉风吹客衣。\n壶山郁葱倩，莆水清涟漪。\n为言到家日，未几登王畿。\n无令得桂手，虚负看花时。\n谈笑青云上，谁念山中期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35115,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"樵父词","author":"王恭","text":"生不适州县，采薪南山岑。\n穷年事登陟，辛苦力不任。\n濯足清涧水，息肩垂萝阴。\n落日晚独还，微风动讴吟。\n唯应鹿门隐，可以谐我心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":35116,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]