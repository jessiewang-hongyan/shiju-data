[{"title":"江村卷为吴太学题","author":"胡应麟","text":"新安江色近，一曲抱村幽。\n日暖蘼芜岸，风恬杜若洲。\n亭台通鹤径，篱落系渔舟。\n四百滩头路，将因到子猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题张文仲母孀节卷","author":"胡应麟","text":"截发甘扃户，同心怅结缡。\n百年蒿里梦，五夜柏舟诗。\n熊胆含辛日，鸳衾入梦时。\n斑衣张仲在，好为赋瑶池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过皦生斋中即席题","author":"胡应麟","text":"萧然一凭几，兀坐万缘空。\n旧茗犹含绿，新梅半著红。\n山疑摹北苑，石拟赠南宫。\n好觅金波句，清尊后夜同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别章敏学","author":"胡应麟","text":"青丝绾朱榼，追送潞河浔。\n寂寞穷途泪，支离故国心。\n晨炊投古戍，晚宿寄荒林。\n何限浮云色，双龙入梦深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同徐文明六客集竹里馆时余太学为主人","author":"胡应麟","text":"屈指春光半，寻芳兴未穷。\n竹溪偕六逸，花墅挟双童。\n剧饮妨归骑，清歌落断鸿。\n遥看燕市月，冉冉入帘栊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入长安路逢徐文明苍头持新作见贻和答","author":"胡应麟","text":"轻寒策羸马，䠥?向风尘。\n筑问燕山社，帆留潞水津。\n浮沈金騕袅，飞动石麒麟。\n纵目春明外，花朝万树新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过徐文明邸适陈长芳在坐作","author":"胡应麟","text":"款段春风里，频游兴独狂。\n抽毫寻孝穆，卧榻对元方。\n云似飞天姥，霞疑挂石梁。\n芙蓉双灿烂，乍夜梦干将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"载过曹能始时能始入长安余暮留斋头翌日题诗壁上","author":"胡应麟","text":"夜扫陈蕃室，春云绣褥温。\n敢言龙卧榻，无复凤题门。\n西笑非吾事，南迁亦主恩。\n长门会题赋，汉武欲消魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡静父携盒过大槐寺作","author":"胡应麟","text":"拂曙青丝榼，提携潞水东。\n为寻芳草色，重到大槐宫。\n老干排丹壑，疏枝碍碧空。\n黄梁炊渐熟，千劫梦魂中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野寺别于凤鸣李惟朴两生","author":"胡应麟","text":"寻幽来古寺，霁色傍禅栖。\n剑岂双龙隔，门难一凤题。\n夕阳高枕外，新月乱帆西。\n共惜天涯别，何妨醉似泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠汪生","author":"胡应麟","text":"暂卸东山屐，言乘汎海航。\n遗书观鲁甸，古乐问齐方。\n白氎敧高座，红妆醉曲房。\n踏歌潭水畔，人识姓为汪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿吴隐君希学七秩","author":"胡应麟","text":"君平曾寄蜀，尹喜尚留秦。\n杏植三千亩，桃偷七十春。\n壶中长宇宙，屐底半星辰。\n白日飞鸡犬，无劳颂大椿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再游大慈岩三首 其一","author":"胡应麟","text":"仄径攀萝薜，明霞挂石梁。\n危崖常堕虎，怪石尽成羊。\n绿筱千林合，青松半壑藏。\n云房遗象古，恍惚见齐梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再游大慈岩三首 其二","author":"胡应麟","text":"不倦探奇足，名山到处寻。\n笋舆回谷口，萝殿出云心。\n绝壁千松挂，高空万籁沈。\n不知傅大士，何代布黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再游大慈岩三首 其三","author":"胡应麟","text":"径草重重绿，岩花处处红。\n猿声山寺合，鸟道石房通。\n峭峡行无际，平畴望不穷。\n世缘吾欲断，耸翮上天风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侍御叶公初度赋柬四章 其一","author":"胡应麟","text":"白鹿梯仙境，青牛柱史台。\n东华晴旭现，南极瑞云来。\n玉蕊凌苍柏，金茎映绿苔。\n黄封将湛露，潋滟出蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侍御叶公初度赋柬四章 其二","author":"胡应麟","text":"豸绣辉瑶席，鸾笙奏玉除。\n红云三岛近，白露九秋馀。\n祝颂填宫观，讴歌沸里闾。\n西泠木兰棹，花色拥芙蕖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侍御叶公初度赋柬四章 其三","author":"胡应麟","text":"曙色重关外，湖山列寿觞。\n桂圆犹八月，菊吐渐重阳。\n紫凤新辰极，青凫旧上方。\n天风何处落，一曲度霓裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侍御叶公初度赋柬四章 其四","author":"胡应麟","text":"绣斧清朝出，光生大海涯。\n梅盐徵相国，柏酒送仙家。\n舄履排青汉，衣裳逗紫霞。\n钱塘十万户，箫鼓沸蒹葭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴山人吴时为桃花会","author":"胡应麟","text":"丰乐桥边路，相逢鬓未皤。\n形骸长土木，梦寐半云萝。\n洞口铭题鹤，池头帖换鹅。\n桃花飞欲尽，晓发奈愁何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题胡京孺三缄斋","author":"胡应麟","text":"玉麈挥仍置，金人戒不忘。\n谭宁空稷下，辩已诎华阳。\n塞兑遵玄圣，冥心对上皇。\n白圭晨起诵，三复意何长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林孝廉以黄尧衢书至并新诗投赠报以此章","author":"胡应麟","text":"席帽戴残阳，翩翩白面郎。\n登龙年尚少，系马日偏长。\n万卷窥藜阁，双钩合草堂。\n寄声黄叔度，夜雪待孤航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永叔坐中戏赠奕者郑童","author":"胡应麟","text":"十五侍王郎，盈盈坐隐囊。\n雄思驰虎穴，险欲控羊肠。\n玉洞青霞丽，金庭白日长。\n毋怀陆郎橘，高跨赤龙翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿陈翁","author":"胡应麟","text":"大隐聊城市，青霞渥妙颜。\n一壶悬海岱，双屐占湖山。\n绕砌兰芽茁，当楼桂魄閒。\n中宵占紫气，已到穆陵关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"午日访吴文仲使君适湖上燕集寄柬二律 其一","author":"胡应麟","text":"午日寻芳候，千秋祝圣年。\n楼船浮别岛，箫鼓列长筵。\n紫翠仙城出，丹青梵刹悬。\n金阊折垂柳，何似越门前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"午日访吴文仲使君适湖上燕集寄柬二律 其二","author":"胡应麟","text":"骑吹千山外，招寻总胜游。\n蒲觞飞别墅，桂楫竞中流。\n日涌江心镜，霞增海上筹。\n天颜欣咫尺，一望翠云裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次日集明府斋头长君文学侍坐","author":"胡应麟","text":"依然五杨柳，丈室卧东皋。\n海岱骄鸿翼，林塘狎蟹螯。\n飞觞春色浅，秉烛夜谈高。\n冉冉凌云气，池头著凤毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狄参戎邀集园亭观女剧即席赋 其一","author":"胡应麟","text":"将军西第燕，奏伎郁金堂。\n樊素先登席，秦青正绕梁。\n巫云飞绣褥，楚雪照罗裳。\n不尽淳于兴，留髡夜正长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狄参戎邀集园亭观女剧即席赋 其二","author":"胡应麟","text":"飘飘青鸟使，晨迓白鸥群。\n艳舞偏倾国，娇歌尽遏云。\n江深桃叶度，滩远竹枝闻。\n不分黄花色，霜前扑画裙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"罗生馆中阅伎作 其一","author":"胡应麟","text":"逆旅愁无赖，良宵兴若何。\n纤腰呈楚舞，稚齿发吴歌。\n院落飘红雾，楼台驻绛河。\n扁舟拉西子，蚤晚若耶过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"罗生馆中阅伎作 其二","author":"胡应麟","text":"为探倾城色，聊停上汉槎。\n兴移金谷树，春满玉台花。\n益寿怀差壮，安仁鬓未华。\n异时云水约，珍重越溪纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同方上舍集施山人二首 其一","author":"胡应麟","text":"旅况新年接，乡心故国同。\n吟犹怀洛下，语渐识齐东。\n径草初回绿，园桃欲放红。\n朝携双蜡屐，南陌斗春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同方上舍集施山人二首 其二","author":"胡应麟","text":"柏叶孤城蚤，梅花绝域迟。\n暂将春雪兴，同醉暮云时。\n白练毫飞洒，青灯剑陆离。\n吴歌夜阑发，星斗堕敲棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王将军邀集西园赋时大雪初霁","author":"胡应麟","text":"将军西第近，曳履暮追游。\n不夜开瑶圃，先春宴玉楼。\n月窥庭树上，云逐剑花流。\n片石燕然顶，嵯峨待紫骝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张博士过访赋赠二首 其一","author":"胡应麟","text":"世业明经旧，家声作赋隆。\n四知传汉代，三绝擅唐宫。\n匣剑芙蓉丽，盘飧苜蓿穷。\n何人问奇字，旬月坐春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张博士过访赋赠二首 其二","author":"胡应麟","text":"萧然广文邸，半榻拥青毡。\n著述河汾后，抠趋泰岱前。\n虚堂时系马，高座几悬鳣。\n咫尺侯芭在，花时过酒船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周新之","author":"胡应麟","text":"久事元戎幕，新辞上客行。\n雪深离瀚海，潮落到钱塘。\n射虎矜衣窄，歌鱼笑铗长。\n小乔妆阁畔，计日望周郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汪生归大鄣","author":"胡应麟","text":"客邸怅离群，连天木叶闻。\n囊琴凄鹤调，匣剑隐龙纹。\n野冻黄河雪，山昏白岳云。\n严陵吾旧宅，一讯孔圭文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河遇陈子卿同饮胡瀫元斋头即席赋梅花下","author":"胡应麟","text":"白社元同调，清风忽故人。\n荆高逢易水，干莫照延津。\n谒帝心期壮，封侯骨相贫。\n梅花斋阁底，沈醉异乡春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈生出所藏半照及匕首乞诗为离合作五言律","author":"胡应麟","text":"惜别佳人意，酬知列士肠。\n妆台分凤影，宝匣现龙光。\n莲锷谁同铸，菱花意对藏。\n乐昌何日返，见汝合干将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵别驾","author":"胡应麟","text":"参军曾入幕，别驾复移舟。\n渌水莲花隔，清溪杜若留。\n莺声吴甸晓，骑火粤山秋。\n好作师雄梦，罗浮问旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日胡茅两生访王至卿携妓东郊藉草畅饮迨暮泛舟从北郭归","author":"胡应麟","text":"拂曙蓟门东，寻芳入乱红。\n园梨娇堕雪，堤柳净含风。\n逸气双钩并，清歌一棹同。\n盈盈美人意，怅别夕阳中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠唐山人二律 其一","author":"胡应麟","text":"暂辍严陵钓，悬壶向紫宸。\n仙茎携沆瀣，帝座问星辰。\n白苧新燕客，青囊旧越人。\n昆明泉万斛，花里试垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠唐山人二律 其二","author":"胡应麟","text":"綵笔神飞动，青囊术有无。\n看松留泰岱，采药望天都。\n雾引车前鹿，云迎舄下凫。\n异时沧海色，千古属潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和吴茂先悼亡","author":"胡应麟","text":"王生驰梦日，潘令悼亡年。\n雨灭巫峰外，云沈洛水前。\n笑言孤枕共，形影一灯悬。\n好借文成术，纱厨望昼眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"于凤鸣携酒慧觉禅寺作","author":"胡应麟","text":"寻幽偕赋客，古刹乱云傍。\n优钵千花净，菩提一树芳。\n谈天游净乐，扫地坐清凉。\n欲共寒山衲，西归不二乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠真头陀","author":"胡应麟","text":"南州来赋客，北苑问高僧。\n佛土穷三界，人天度七陵。\n孤云晨拓钵，大雪夜传灯。\n便欲逃禅去，风幡證惠能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赋同吴生","author":"胡应麟","text":"问法来方丈，清斋供野蒲。\n高禅逢普化，古佛现毗卢。\n大悟三乘彻，真空一念无。\n那能将宝筏，咫尺济归途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"座中赠吴隐君","author":"胡应麟","text":"梵刹金银布，人天下夕阳。\n菩提千界净，荷芰六时芳。\n渺漫恒河筏，蹉跎劫海航。\n凭君畏垒下，一授卫生方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠郑生","author":"胡应麟","text":"卜居仍海峤，门巷一壶悬。\n采药陶弘景，迷花孟浩然。\n星垂漳水钓，月引卫河船。\n纵目金华顶，群羊正熟眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴生谈鲁连台在辽城东北未有题咏余素高其节侠即席赋此","author":"胡应麟","text":"巀嵲高台畔，犹传侠客名。\n千秋馀故垒，片札下坚城。\n晚日残花坠，寒云蔓草平。\n谁言蹈东海，风驭入蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴希学斋头鹦鹉学语慧甚戏赠此章","author":"胡应麟","text":"似汝聪明质，谁将闭玉笼。\n乡心驰陇右，野语狎齐东。\n倚竹身全翠，餐桃颊倍红。\n秦宫三十六，一一诉春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠耿中官","author":"胡应麟","text":"萍梗淮圻北，桑弧碣石东。\n心长悬魏阙，疏屡入隋宫。\n色相三途幻，因缘四大空。\n侯鲭频日餍，拂袂近春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送倪明府","author":"胡应麟","text":"烨烨兰阴里，铜符羡昼游。\n鸣琴聊寄傲，岸帻正风流。\n桂折罗浮顶，梅探庾岭头。\n黄金台百尺，独步伫骅骝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠盛明元昆仲时余将卜居葛湖之傍以诸子翩翩雅尚有足依者焉 其一","author":"胡应麟","text":"盛世埙篪合，翩翩逸兴同。\n六龙齐颍上，三凤倍河东。\n玉树联花萼，琼枝压桂丛。\n沧浪分一曲，肯著杜陵翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠盛明元昆仲时余将卜居葛湖之傍以诸子翩翩雅尚有足依者焉 其二","author":"胡应麟","text":"高门怀伯仲，上座集贤豪。\n对列三珠树，同挥五色毫。\n披襟怜尔辈，结袜愧吾曹。\n老大才名尽，惟应把浊醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题湖上方舟四首 其一","author":"胡应麟","text":"桂楫漾沙棠，朱栏十尺强。\n三舟联锦缆，四柱簇牙樯。\n障日青油丽，凌风翠黛狂。\n洞箫明月底，一曲和沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题湖上方舟四首 其二","author":"胡应麟","text":"平湖秋色净，一舸系蒹葭。\n懒搆思光宅，堪浮少伯家。\n窥帘鸣鹳鹤，掠槛度鱼虾。\n竟夕看明月，无劳促曙鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题湖上方舟四首 其三","author":"胡应麟","text":"薄暮方舟集，芙蓉次第寻。\n台惊浮水面，亭似压波心。\n雅称苕川钓，偏宜笠泽吟。\n浮休定何日，一壑畅幽襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题湖上方舟四首 其四","author":"胡应麟","text":"湖上暮云稠，青丝荡碧油。\n移舟过巨石，浮筏向中流。\n拟作张骞泛，真同郭泰游。\n余将挈佳丽，日醉大堤头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"盛母孀节诗为思达思弘题","author":"胡应麟","text":"盛世高孀节，光增婺女奇。\n志坚初矢日，年倍未亡时。\n片玉怀中抱，双珠膝下遗。\n桃花三月近，戏彩傍瑶池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠云涛祝生所狎美人也","author":"胡应麟","text":"翠袖拨箜篌，居邻八咏楼。\n云偷巫峡曙，涛占曲江秋。\n经卷王姬诵，诗笺薛媛留。\n何妨祝融氏，同赴烂柯游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"思齐夜出杨瓜佐酒稍异常者讯之知杨姥得诸异人即席赋此","author":"胡应麟","text":"何代贻嘉实，累累越水涯。\n称名同邵圃，问姓是杨家。\n五色萦丹洞，三浆烂紫霞。\n异时营子母，萝蔓日交加。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠李广文","author":"胡应麟","text":"旧国天都近，新斋婺女悬。\n彩飞江令笔，青挟郑公毡。\n三洞云携屐，双溪雪放船。\n无誇沈侯句，苜蓿诵嘉篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送柳使君之南雄","author":"胡应麟","text":"五马趁西风，朱幡气槩中。\n淮阳移长孺，蜀郡待文翁。\n梅发新邮使，棠飞旧寓公。\n罗浮峰四百，蹑屐遍秋空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王廷尉还东阳","author":"胡应麟","text":"昼游兰渚上，花色艳簪裾。\n旧翥双凫舄，新驰驷马车。\n红云燕日近，绿水婺星虚。\n藉藉张廷尉，高门葺故居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送沈明府之江右","author":"胡应麟","text":"五马昼飞扬，双龙照夜光。\n公庭高岳底，官廨大湖傍。\n旧宴虚平乐，新恩出建章。\n为知良吏传，藉藉赞龚黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮秋病肺梦中作时有鼓盆之变 其一","author":"胡应麟","text":"微霜九月朔，一病罢登台。\n熟睡蝉声里，柴门午不开。\n茶烟萦翠筱，药裹翳青苔。\n兀兀巢居子，尘心且未猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]