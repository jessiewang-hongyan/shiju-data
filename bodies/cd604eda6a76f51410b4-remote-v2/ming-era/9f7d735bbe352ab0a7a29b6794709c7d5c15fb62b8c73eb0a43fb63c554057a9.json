[{"title":"送陈大谏献绩北上","author":"孙承恩","text":"奏绩趋枫陛，停骖别草堂。\n三年多献纳，千载属明良。\n风节云霄上，忠诚日月傍。\n临岐何所效，挽手赠干将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曹大谏献绩","author":"孙承恩","text":"北阙闻名日，南都会面年。\n才高青琐地，人诵白云篇。\n烟霁花明驿，江春水接天。\n长歌倚黄鹄，送子兴飘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送傅光禄献绩","author":"孙承恩","text":"春晚日沉沉，长风野色阴。\n人趋温室树，名著汉官箴。\n圣主求贤切，苍生望治深。\n台衡行且致，愿一沛甘霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上阻风二首 其一","author":"孙承恩","text":"极目风涛壮，浑疑地轴浮。\n鸟飞惊半堕，蛟舞惬深游。\n吾道将无措，天心欲示留。\n家园渺何许，回首不禁愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上阻风二首 其二","author":"孙承恩","text":"出处应谁主，吾行可自由。\n如何一江隔，翻作半旬留。\n云色连天暝，涛声蹴地浮。\n安恬应有日，任我渡中流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答沈凤峰二首 其一","author":"孙承恩","text":"沈子趋朝日，同予被命年。\n幸兹联桂楫，忽漫阻淮船。\n望已秋台重，文将北斗悬。\n经旬阻谈笑，逸思邈云川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和答沈凤峰二首 其二","author":"孙承恩","text":"落日怀人切，沧波鼓楫迟。\n我承丹陛命，君赴白云司。\n健翮终雄奋，疲驽已倦驰。\n忽承琼玖赠，裁答愧芜辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德州晚泊","author":"孙承恩","text":"落日沧波上，孤城舣客槎。\n风声回绝岸，月色漫平沙。\n宿鸟频移树，残灯细吐花。\n中宵愁不寝，归思浩无涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中见燕","author":"孙承恩","text":"斜日迎风弱，轻看掠水低。\n天涯渺长路，春晚足融泥。\n洲上时同憩，柳边还独迷。\n小堂多旧垒，如去任教栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕群飞向南诗以送之","author":"孙承恩","text":"恋土知非意，随春亦晚谋。\n如何当此日，尚自傍人舟。\n屋旧多栖托，巢存或是不。\n不嫌主人出，好去为相留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再吟送燕","author":"孙承恩","text":"念汝南飞去，怜吾正北行。\n相看异乡日，忽动故园情。\n梁旧栖无改，泥新葺易成。\n祇愁主人出，莫为捲帘迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜行二首 其一","author":"孙承恩","text":"月出波光净，吾舟且自行。\n危樯逐影去，远火带星明。\n清世原无警，他乡亦故惊。\n不闻有人语，数自问前程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜行二首 其二","author":"孙承恩","text":"人语知舟近，吾行赖不孤。\n如何当梦觉，犹未尽前途。\n月落行偏涩，崖高远费呼。\n劳人窃自愧，此意不能无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮许龙石学士园亭短述三首 其一","author":"孙承恩","text":"桂楫依沙渚，茅堂共酒卮。\n经年劳注想，此日慰深思。\n槛竹吟风细，流云渡苑迟。\n尘襟喜披豁，坐久欲忘辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮许龙石学士园亭短述三首 其二","author":"孙承恩","text":"天上归来早，城偏卜筑幽。\n孤亭凌日起，高树接云浮。\n睹凤人争快，登龙士愿收。\n宁亲容暂尔，未许遂优游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮许龙石学士园亭短述三首 其三","author":"孙承恩","text":"地迥尘喧隔，林深暑气微。\n移樽临曲槛，烂酌对斜晖。\n世事浮云变，交游屈指稀。\n百年会能几，分手重依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张玉溪院中四咏 其一 小山","author":"孙承恩","text":"垒筑当年事，崔嵬俨作山。\n漫言三岛胜，同峙两仪间。\n松屿春云合，萝庭夜月閒。\n知公登览际，逸兴邈尘寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张玉溪院中四咏 其二 方沼","author":"孙承恩","text":"忆昔到池上，观莲有数公。\n疏泉通汉苑，作赋陋唐宫。\n逸兴迟新碧，微吟伫晚风。\n须知消息理，莫谓色为空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张玉溪院中四咏 其三 蔷薇屏","author":"孙承恩","text":"小植丛丛密，名称类省薇。\n凭渠聊作障，莫用乱钩衣。\n仄径条应缚，暖风花自飞。\n故园遥忆汝，三载赏心违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张玉溪院中四咏 其四 紫藤花","author":"孙承恩","text":"寂寞群芳歇，兹花晚著花。\n低丛深隐雀，老干曲盘蛇。\n袅袅上缘物，鲜鲜滥拟霞。\n风霜摇落后，为尔怅韶华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再和玉溪四咏 其一","author":"孙承恩","text":"清切无尘地，陂陀小有山。\n聊兹契幽趣，顿似出人间。\n鹤憩心同静，云栖意自閒。\n张衡多藻句，流诵遍区寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再和玉溪四咏 其二","author":"孙承恩","text":"池上莲栽密，年华不负公。\n香分巴子宅，色夺梵王宫。\n滥滥蘸清泚，袅袅泛光风。\n昔游如可继，欢赏莫教空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再和玉溪四咏 其三","author":"孙承恩","text":"虚庭藉屏障，绾束有蔷薇。\n纵少才当局，应怜色染衣。\n月明增旖旎，雨过正芬菲。\n孤松不成荫，物理固相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再和玉溪四咏 其四","author":"孙承恩","text":"春风发群卉，也复到兹花。\n石根斜引带，树杪乱藏蛇。\n深夜垂清露，遥香散彩霞。\n幸兹无剪伐，聊与度年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再叠玉溪四咏韵 其一","author":"孙承恩","text":"玉署原非俗，瀛洲合有山。\n秀钟红日下，势接白云间。\n花落午风寂，鸟啼春意閒。\n九衢车马闹，仙境隔人寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再叠玉溪四咏韵 其二","author":"孙承恩","text":"捡押风光别，勾稽岁月公。\n即看青玉案，涌出白云宫。\n小盖高擎露，微香暗逐风。\n幽怀寄篇什，逸思欲凌空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再叠玉溪四咏韵 其三","author":"孙承恩","text":"石家锦步障，玉署障黄薇。\n繁花迷睡蝶，香雾袭春衣。\n乐为遮风日，聊资赏郁菲。\n秪愁春事歇，转眼又相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再叠玉溪四咏韵 其四","author":"孙承恩","text":"曲附延高蔓，浓攒满眼花。\n心惟依桧柏，状不拟龙蛇。\n袅袅摇明月，霏霏团紫霞。\n群芳各竞秀，尔独殿春华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈石亭早梅之什","author":"孙承恩","text":"才见阳和转，相将风信催。\n似搀春色至，特向主人开。\n景较兔园早，诗同何逊才。\n独怜亭上石，欠我共徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送太学生邹子开南还","author":"孙承恩","text":"文采尔翩翩，穷经正少年。\n来游上国日，归及早秋天。\n孤楫悬西照，寒枝咽露蝉。\n好寻桑梓乐，还咏鹡鸰篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘启明赴泰宁尹","author":"孙承恩","text":"问尔官何向，驱车入晋阳。\n郊原淡烟日，旌旆肃风霜。\n民隐怀绥切，边陲保障良。\n勉旃树勋业，云路看高翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和夏桂洲喜瑞雪二首 其一","author":"孙承恩","text":"喜见飘零雪，应知兆有年。\n银花分霁色，琼树借春妍。\n泱漭浮光气，冥濛接远天。\n重玄昭默佑，一德鉴精虔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和夏桂洲喜瑞雪二首 其二","author":"孙承恩","text":"上苑同云布，遥空瑞雪飞。\n千林琼作障，万雉玉成围。\n地合知天近，山明讶夕晖。\n忧民勤圣主，神鉴若无违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈二尹部运还松","author":"孙承恩","text":"驿路速归旌，薰风五两轻。\n征输多茂绩，抚字有贤声。\n省稼星轺遍，哦松公署清。\n繄予桑梓念，送子重关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送熊文德尹剑南沙县","author":"孙承恩","text":"送子之官去，天高风露凉。\n好看循吏传，未觉簿书忙。\n省俗花村静，鸣琴白日长。\n先公遗迹在，肯为奠椒浆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"使郢出京西玄宗伯复饯","author":"孙承恩","text":"夙奉交情厚，朝承宠饯勤。\n情知非久别，谊自惜离群。\n莽莽朔风厉，萧萧秋日曛。\n明晨回首望，烟树隔红云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早发","author":"孙承恩","text":"晨起披星出，冰霜凛在襦。\n凄风欺旧幌，病骨藉重狐。\n北望瞻天汉，南飞感月乌。\n须臾曙光动，迤逦见长途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早发微雨随霁道中即事","author":"孙承恩","text":"密雨洒长路，行云上客衣。\n才看沾霢霂，旋复露熹微。\n墟市人来集，林坰鸟渐飞。\n忘机双属玉，立在碧苔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驻节萧寺","author":"孙承恩","text":"小憩皇华节，閒瞻琪树林。\n不逢僧说偈，欲问佛安心。\n昼暝长廊静，香消古殿深。\n坐深还促驾，容易日西沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邮亭早饭","author":"孙承恩","text":"莽莽冲寒候，茫茫度板舆。\n孤亭聊小憩，病体得微舒。\n风物乡心切，盘餐野饭馀。\n檐前有饥雀，乞食下庭除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜行","author":"孙承恩","text":"深夜苦催发，人行语不哗。\n林乌惊列炬，候骑听鸣笳。\n历历星垂野，澄澄月布沙。\n忽闻山犬吠，知是有人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南阳道中","author":"孙承恩","text":"靡靡川原接，萧萧征马鸣。\n西风吹叶下，残日抱林明。\n吊古悲歌动，伤时幽愤生。\n苍茫时极目，依约见孤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭谒显陵","author":"孙承恩","text":"宇宙钟灵地，先皇剑舄藏。\n万神严翊卫，千古閟玄堂。\n江汉输源远，匡庐引脉长。\n中天瞻北极，缭绕五云翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭谒潜邸","author":"孙承恩","text":"肃穆瞻皇宇，岧峣切紫霄。\n彤庭白昼静，桂寝瑞烟飘。\n天启飞龙地，虹流诞圣朝。\n万年徵往牒，四海戴神尧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"都司公宴","author":"孙承恩","text":"太府皇宫侧，孤城晓日东。\n名僚全楚盛，高会此时同。\n台迥旌旄列，霜清鼓角雄。\n酒阑还别去，锦袖倚微风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆石泾中丞邀饮王总戎园亭","author":"孙承恩","text":"胜会高宾集，名园幽兴多。\n野亭藏雨竹，仄径入烟萝。\n几席香萦篆，笙簧鸟送歌。\n更怜贤地主，不醉亦虚过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邀石泾夜酌","author":"孙承恩","text":"暂屈中丞驾，还怜老子迂。\n霜清城角响，月过竹窗虚。\n款语多乡思，盘餐愧客厨。\n扳留须尽兴，莫问夜何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴荪塘携酒夜过","author":"孙承恩","text":"白下当年别，清尊此夕同。\n簿书君屈骥，衰鬓我成翁。\n岁月蹉跎里，乾坤感慨中。\n话长不知倦，落尽烛花红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王周二生移酒夜过","author":"孙承恩","text":"寂寞竹台夜，欣承二妙过。\n城头起严柝，屋角挂明河。\n劝酒怜渠厚，论文益我多。\n看君才具美，蹭蹬欲如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"五泉中丞南江宪副招饮席上口占","author":"孙承恩","text":"把袂年华改，通家契谊深。\n不缘今日会，空负别来心。\n竹院霜晨肃，山城海日阴。\n世途终感慨，相对一长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮黎仰止宅","author":"孙承恩","text":"霁景江天豁，层轩野望开。\n云烟嗟往事，歌吹送深杯。\n明世思耆硕，湖湘老俊才。\n病躯还久坐，东道有高怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驼村大巡邀饮","author":"孙承恩","text":"天上来文旆，湖南傍法星。\n层楼敞高宴，短晷落虚庭。\n深酌欢能尽，悲歌醉喜听。\n还言情未惬，更约坐山亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏作留别青莲二首 其一","author":"孙承恩","text":"神游临汉沔，星轺亦郢城。\n奇事一朝见，斯文千古情。\n仙书劳每赠，瓣香心独诚。\n回首兰江上，日日白云生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏作留别青莲二首 其二","author":"孙承恩","text":"玄圃辞仙侣，瑶宫驾海鲸。\n风云供笑咏，湘汉结精英。\n眷我言归日，贻诗怅别情。\n怀君何处望，明月大江横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饭何老家","author":"孙承恩","text":"缭绕重冈去，数家村落中。\n门多达官辙，主有古人风。\n城市身稀到，田畴岁屡丰。\n野情无适契，短述赠山翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿古寺","author":"孙承恩","text":"古寺何年辟，皇华亦偶来。\n疏风禅榻静，寒夜竹窗开。\n扰扰浮生世，悠悠浩劫灰。\n中宵眠不稳，羁思转难裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早入天寿山值微雨二首 其一","author":"孙承恩","text":"晓踏桥陵路，沉沉雨在林。\n青山埋白日，黄殿肃玄阴。\n功德垂无尽，精英俨若临。\n无能酬覆载，空愧暮龄侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早入天寿山值微雨二首 其二","author":"孙承恩","text":"日月环陵寝，烟云庵桧松。\n千年遗秘剑，万壑拱神龙。\n寂寞仙游远，氤氲王气重。\n轻雷来倏忽，挟雨过前峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张阳峰山行诗五首 其一 五佛寺","author":"孙承恩","text":"雅爱名山胜，春游惜未曾。\n幽怀渺何已，倦足尚堪登。\n欲问无生偈，还寻出世僧。\n风尘出汩没，秪益病颜增。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张阳峰山行诗五首 其二 梅花洞","author":"孙承恩","text":"缥缈罗浮境，虚明小有天。\n低枝横挂月，古石暗生烟。\n地迥尘喧隔，名标世代传。\n无从究开凿，漫自说桑田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张阳峰山行诗五首 其三 弘光寺","author":"孙承恩","text":"小尽登山兴，来投古寺深。\n乱云迷鹫岭，清昼发鲸音。\n世事真同幻，霜华渐上簪。\n迷方聊解悟，惭愧百年心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张阳峰山行诗五首 其四 登岩顶","author":"孙承恩","text":"绝磴扳缘上，凭虚得大观。\n振衣翔物表，决眦入云端。\n日落乡心碎，天空剑气寒。\n莫言虚日力，聊适野情欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张阳峰山行诗五首 其五 洞口","author":"孙承恩","text":"回合连千障，谽谺豁两门。\n地幽春自老，云护昼长昏。\n细路纡吟屐，浮岚袭酒尊。\n时应猿鹿过，石藓印蹄痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和张龙湖山行","author":"孙承恩","text":"冬霁郊原静，天开水墨屏。\n疏林出茅屋，寒日翳云汀。\n逸思迢玄览，长歌入紫冥。\n山中少尘事，僧户昼长扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送全九山太史使鲁藩","author":"孙承恩","text":"冰雪岁云暮，西风折柳条。\n皇华重文德，藩邸挹台杓。\n剑气冲晨雾，恩光遍鲁郊。\n玉堂推宿学，伫望早还朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登燕台","author":"孙承恩","text":"九月燕台上，凭空眺望赊。\n神都王气合，故国白云遮。\n日落猿声急，风高雁影斜。\n羁怀正无那，况复听悲笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感故园和马西玄韵三首 其一","author":"孙承恩","text":"我有藏脩地，层轩接素波。\n病躯宜旷寂，幽意缔松萝。\n京国年经别，荒芜日渐多。\n素心原有约，吾敢负烟蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感故园和马西玄韵三首 其二","author":"孙承恩","text":"自别幽栖地，无时忘故山。\n不知岩桂发，虚负草堂閒。\n江海迟归思，风尘益病颜。\n鸿看矫矫，羡尔政难攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感故园和马西玄韵三首 其三","author":"孙承恩","text":"我忆幽栖地，萧然水竹居。\n野情聊取适，薄分敢求馀。\n中散惟便懒，河汾拟著书。\n素怀渺无限，不独为鲈鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":36824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]