[{"title":"纪梦二首 其二","author":"湛若水","text":"度关便有利名心，夜梦何山洞更深？\n可是山灵先报我，春风回首得幽寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26719,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过南安峡江下滩多石 其一","author":"湛若水","text":"昨闻上峡江水浅，今朝下峡江水深。\n日夜滔滔亦何逼？\n不尽似我朝宗心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26720,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过南安峡江下滩多石","author":"湛若水","text":"积雨冥冥溪涨高，春风下峡双鸣桡。\n莫道下滩容易在，下滩篙比上滩牢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26721,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过徐州谒闵祠三首示周生荣朱兼寄州守陆生时望掌教周生易 其一","author":"湛若水","text":"孝心一念亦无多，德行三千擅首科。\n不赖源泉涓滴在，争看积累沛江河？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26722,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过徐州谒闵祠三首示周生荣朱兼寄州守陆生时望掌教周生易 其二","author":"湛若水","text":"稚年孝友自天成，达变全经孰与能？\n放眼直从千古看，重华经变可同称。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26723,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过徐州谒闵祠三首示周生荣朱兼寄州守陆生时望掌教周生易 其三","author":"湛若水","text":"数言全母出真诚，兼善无妨见父明。\n惭愧听听国多妒，祠前三叹绕阶行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26724,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵王司马斋居尝冰之作而扩其义寓感慨焉","author":"湛若水","text":"乍喜传冰济郁蒸，少间战战复兢兢。\n却因细嚼凌阴后，犹忆春初履薄冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26725,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"走笔题双松卷","author":"湛若水","text":"壬子联诗共乃翁，酒杯塘口夜灯同。\n金陵忽遇双松子，彷佛髯翁在眼中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26726,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朱明洞闻松声众观有五色禽之集","author":"湛若水","text":"正便幽寂尘嚣绝，又恼松涛聒耳多。\n五色禽来还夺日，主人翁者问如何？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26727,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送徐苍岩卿授阴阳还西洲","author":"湛若水","text":"甘泉洞府入云齐，板筑当年尔共跻。\n训宰峨冠今昼锦，苍岩归去西洲西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26728,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"因督学寄霞山蔡方伯巨源","author":"湛若水","text":"雁荡天台天上境，吾将因之观无何。\n凭即为报霞山老，我若来时取路过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26729,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"临归与吴介夫话旧","author":"湛若水","text":"忆年壁水青竹林，诸贤兀坐溪云深。\n而今讲院苍苔满，钟磬无声只尔心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26730,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"作表滕西江寿官成定山祠因以留别","author":"湛若水","text":"古人冷澹今人轻，定山栋宇是谁成？\n八十年来勤礼义，西江月色照君情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26731,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题陈郎中哀挽卷并跋尾一首","author":"湛若水","text":"菊坡乡里许谁伦，圣祖龙飞第一人。\n天造英雄多伏死，先生明哲不谋身。\n谴严日远心空赤，战苦云深箭不神。\n若与睢阳留宇宙，寓坟何必更招魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26732,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南岳之怀秋暮愈切道远囊空何日发轫谩作呈知己","author":"湛若水","text":"西游忽忽过秋深，北风萧萧吹客襟。\n破锦囊中金一缕，瘦藤枝外石千寻。\n丹霞露啄无炊粒，紫盖冥栖谢结阴。\n便欲五峰寻故宅，白头未了百年心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26733,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"韵次元默夜在楼下时将游罗浮","author":"湛若水","text":"天高海阔片帆孤，好与青山作画图。\n闭户经冬愁阒寂，逢君满意说江湖。\n飞云割得如堪共，白鹤招来不受呼。\n百尺崖头看进步，乾坤此事属吾徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26734,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同元默弟罗浮次韵东所","author":"湛若水","text":"青冥连袂度虹桥，足到千峰意尚遥。\n白鹤闻笙来月洞，紫霞炊玉供晨朝。\n本无经济誇长往，已许渔樵蚤见招。\n万丈飞云咏东所，云和声里间箫韶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26735,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"马上又呈元默弟前韵","author":"湛若水","text":"白鹤仙人跨鹤来，洞门遮道谩何谁。\n旧传瑶笛无吹处，近得云衣自剪裁。\n风引钟声来隔岭，鸟腾花影度荒苔。\n中岩一诀堪留意，尽与丹山领却回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26736,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"马上望罗浮","author":"湛若水","text":"影到东溟青不了，天来南极迥无前。\n百年意绪长依寺，一路歌声欲彻天。\n紫翠对云迷古洞，风光随马舞吟鞭。\n约君大石楼前月，对景无诗只醉眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26737,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"飞云顶次韵元默弟","author":"湛若水","text":"玉洞一山齐北极，铁桥有路到青天。\n正开天眼东南阔，细袅崖烟锦绣妍。\n举盏倒迎沧海日，放歌醉拍洪崖肩。\n与君永结无情契，分与罗浮一半烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26738,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别元默弟还龙江","author":"湛若水","text":"岁晚藤梢谁与传，乾坤未了看山缘。\n千峰踏遍还知我，百炼归来且闭关。\n九万里鹏看展翅，三千年凤共和鸾。\n西云影落西樵月，一幅青天两钓船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26739,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新春试笔","author":"湛若水","text":"新岁题诗发兴新，新梅枝上太撩人。\n三元甲子周天日，一十六回弘治春。\n天上经纶知有自，人间竿木小随身。\n强颜欲索慈颜笑，毛义终惭捧檄频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26740,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵元默游萝峰寺","author":"湛若水","text":"乱水泠泠而北出，诸山靡靡以傍围。\n一蒲古寺僧无语，独树交花莺自啼。\n有客吟诗一石上，无边春色隔林迷。\n请君更上峰头看，回首人间步步低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26741,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵元默弟登黄云","author":"湛若水","text":"天来紫府人非世，山到黄云草亦香。\n桃雨坠红春事晚，竹风摇翠午衣凉。\n鸟鸣独树溪当面，樵语千峰路更傍。\n两马联翩何处客，酒瓢高挂与诗囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26742,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过梅关同元默忆以道大理","author":"湛若水","text":"花如得意明秋旭，云似无心度晓风。\n策马舍舟吾不系，群山赴海此称雄。\n宫槐转日游人过，古寺吟诗忆尔同。\n不厌陈登湖海气，几时都下醉郫筒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26743,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望匡庐同元默定白鹿之游","author":"湛若水","text":"湖水之阔阔莫收，庐山之高高莫俦。\n青连百越诸天近，影落东溟海若愁。\n驿下风湍深驻桨，山腰樵路曲沿流。\n明朝两马冲云去，十载心期一日酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26744,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游白鹿洞","author":"湛若水","text":"十亩堂开旧典刑，诗成白鹿也来听。\n群山靡靡水争出，独树荒荒鸟自鸣。\n烟散香炉浮俎豆，苔生漱石上檐楹。\n废兴独有人心在，五百年来拜后生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26745,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"毛献清殿元乃婿王世芳年十八领乡荐会试下第因留毕姻于毛氏以孟秋还太仓","author":"湛若水","text":"弃繻略比终军少，折桂初逢素女游。\n且逐鹿车归海曲，还如萧史别秦楼。\n冰清玉润终辉映，白璧明珠岂暗投。\n他日尚书传仲默，几年南国咏雎鸠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26746,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠伦伯畴使安南","author":"湛若水","text":"天语亲承出禁廷，五云光映赐衣明。\n便从北斗趣南斗。\n少借魁星作使星。\n铜柱珠崖迎汉节，春王正月到沧溟。\n乾坤大地春风转，应说年来海效灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26747,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿冢宰致仕三原王先生","author":"湛若水","text":"正色朝端三世望，长生箓里九还灵。\n尚书自昔千珠斗，西极而今应寿星。\n洛社有图传大老，石渠随笔点残经。\n年颜汉使烦相问，或者前身是伏生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26748,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送赵黄门奉使祭告辽楚二府得便归省","author":"湛若水","text":"赤社诸藩亲帝裔，黄门兼使旧名流。\n明禋册祝龙飞载，至德馨香花萼楼。\n裾曳楚云湘水阔，赋成梁雪郢烟收。\n过庭不着莱衣舞，昼锦称觞未白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26749,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠郑克新同年奉命采实录拟由南宁达云南得便省亲","author":"湛若水","text":"拟谢三川趋五岭，别从宁外向云中。\n六年亲舍今虚远，四月王程亦自同。\n日照白龙明昼锦，天随金马舞春风。\n网罗放失名山下，胜览还收史外功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26750,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠张澹轩携子养病南归上海同年九苞乃尊也","author":"湛若水","text":"高士传中知仲蔚，大丘车里著长文。\n班衣随地将莱子，昼锦还家问铁君。\n海鹤避人翻逐子，樯乌冲浪忽穿云。\n莫将药裹妨诗兴，夹岸春光到楚分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26751,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送西溪张都宪之南都总督粮储","author":"湛若水","text":"乡里名家殊未央，典刑真见曲江张。\n共忧天下军储重，肯谢江南会计忙。\n后辈旧传姬老舄，多年曾拜德公床。\n金陵春色浓无奈，可许新诗寄锦囊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26752,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵潘黄门出关宿坡垒之作","author":"湛若水","text":"水承山管了公程，驻节关西憩晚晴。\n已信众星能拱极，谩劳仪卫盛陈兵。\n春风到处人争睹，雨露来时草亦荣。\n欲寄归心随出日，中天下直是神京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26753,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵潘黄门市桥之作","author":"湛若水","text":"五色云中渡鹊桥，九天露下浥星轺。\n地穷朱鸟心犹壮，程尽冥鹏意尚遥。\n珠树西将求硕果，扶桑东去挹孤标。\n不堪母念思方切，欲报君恩愧未饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26754,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"用韵奉答学士毛白斋先生","author":"湛若水","text":"即看几几仪形外，也到休休乐善时。\n陋识岂能酬远业，高情兼已拜新诗。\n逢人只说苌公学，知己长怀鲍叔思。\n裁得尺书凭寄与，天空日短雁来迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26755,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵潘黄门谒伏波祠","author":"湛若水","text":"始定南旌拟过祠，春蘩此日进吾卮。\n飘风薏苡明珠贝，积藓勋名蚀鼎彝。\n世且英雄皆庙食，公于冠履有维持。\n乘舟三叹重回首，得意藤萝剪阿谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26756,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日次韵潘黄门奉怀朝会诸公","author":"湛若水","text":"此日五云扶帝座，同时万国祝尧天。\n春风先到金茎动，景运遥看斗柄旋。\n心逐火轮瞻雉尾，眼欺云墨起蛟涎。\n不陪天上群仙会，留滞周南万里船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26757,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵答东所张先生","author":"湛若水","text":"共将蓑笠谢冠缨，中岁犹污一第名。\n金马有官藏曼倩，成都无地隐君平。\n邯郸我了人间梦，声誉君归使者旌。\n亦恐乖崖久閒散，时方救火得无情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26758,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张东所与潘黄门用涯翁韵往复予因用韵言别三水","author":"湛若水","text":"从容已了皇华事，兼与江山询胜名。\n海岛或因逢葛老，金华方许访初平。\n联翩双舫酬诸作，出没千峰见一旌。\n暂且分携应不易，相亲难割到离情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26759,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"用韵留别东所张先生","author":"湛若水","text":"种种元非为请缨，弄丸来往只无名。\n杞人徒自忧天坠，禹域空闻说地平。\n天上风云劳梦寐，世间贤哲几弓旌。\n多君赠处临岐意，我欲酬君岂世情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26760,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿谏议祠次韵余子华太史兼呈郑伯兴朱守中二进士","author":"湛若水","text":"辉辉灯火照寒椽，袅袅炉香驻晚烟。\n一卧正祠非白屋，对坛供奉是青莲。\n心将胜事诸贤共，影度斜阳两袂连。\n莫道岁寒诗景恶，碧崖苍柏自相鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26761,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉和守中谒泰陵有感","author":"湛若水","text":"乌号曾是小臣来，又听悲歌动我怀。\n亲见彩云扶日上，谁能赤手挽天回。\n群忧极处思孤笑，方寸伤馀尚百哀。\n闻道阳回今日始，龙门遥忆曝春腮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26762,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和郑伯兴上陵三首 其一","author":"湛若水","text":"郁郁诸陵浮地起，恢恢玄极倚天开。\n虚传龙驭宾天府，实见麒麟卧草莱。\n望阙众星同绕斗，吟诗一客独登台。\n楚歌郢曲多遗调，试续离骚不可哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26763,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和郑伯兴上陵三首 其二 次陪祭茂陵韵","author":"湛若水","text":"北极高齐天寿山，何当与尔同追攀。\n五岳拱如尊帝义，诸峰攒作效颦颜。\n共怜福地藏玄苑，信有神山出世寰。\n正忆都城珠斗下，镜光吟望几凭阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26764,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和郑伯兴上陵三首 其三 次韵陪祀泰陵","author":"湛若水","text":"羁思那堪更感时，忽传诗句到阶墀。\n普天吾欲一流涕，率土谁能咏孝思。\n天运去来浑不管，阳回草木也应知。\n临风无限攀号意，独立斜阳疋马迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26765,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游罗浮四首 其一","author":"湛若水","text":"闻歌一夜动幽怀，直踏飞云万丈崖。\n翠霭浮云白日暝，虹桥有路青天来。\n三月二月春之半，千山万山花正开。\n笑问仙源杳何许，云涛浩浩不堪裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26766,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游罗浮四首 其二","author":"湛若水","text":"飞云渺渺来空洞，洞口桃花虚映红。\n瑶笛长吹千里月，霓裳轻飏五铢风。\n玉堂回首即天府，黄石归来是赤松。\n静啸空山人不见，石楼烟袅麻姑峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26767,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游罗浮四首 其三","author":"湛若水","text":"老鹤阅世山之隈，花开花落愁相催。\n举头世事都春梦，叹息人间几劫灰。\n随世功名悲弄影，流形天地小浮杯。\n要知此外无穷在，莫道曾登绝顶来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26768,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵送顺之赴试","author":"湛若水","text":"昨宵桂影照君床，定领秋闱第一香。\n不尽乾坤閒事业，且将文字小揄扬。\n云龙有会开金榜，风雨无妨护锦囊。\n卧病烟霞独惆惕，送君无语到行藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26769,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病起次韵林见素司寇颂主上秉烛视朝经筵之作兼呈诸老二首 其一","author":"湛若水","text":"五云深处寸心悬，掖外垣西尺五天。\n每见诸公调玉烛，也曾一日侍经筵。\n赓歌直忆千年上，致主须归一德前。\n谁道有虞非此日，明朝更理南风弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26770,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病起次韵林见素司寇颂主上秉烛视朝经筵之作兼呈诸老二首 其二","author":"湛若水","text":"露立千官列宿悬，高张银烛照中天。\n玉炉烟转奎文地，赤舄班趍御讲筵。\n旭日尚须云气拥，瑞光先动紫微前。\n诸公幸有调和手，善治行看更改弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26771,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壬午秋有鹤降于吏部庭见素翁和白岩诸公有作予亦步韵二首 其一","author":"湛若水","text":"月作衣裳云作行，秋高毛翮引风长。\n自天降兆非无意，此地恩波定益瀼。\n赋性莫须求净土，乘轩孰与在江乡。\n遗音种种虞罗者，愧尔谋身实善藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26772,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壬午秋有鹤降于吏部庭见素翁和白岩诸公有作予亦步韵二首 其二","author":"湛若水","text":"小黠纷纷笑大痴，高标插翅与群疑。\n鹳行误戴丹砂子，燕尾兼衣白雪谁。\n独立可忘三岛日，长鸣欲彻九天时。\n主人况有梅花月，饮啄尤堪自蹑追。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26773,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵奉赠宗伯毛三江致仕","author":"湛若水","text":"手翊飞龙起在田，策勋三让尚皇然。\n广论大礼群公独，冥汉高标一羽偏。\n累疏许归天子圣，满城都叹大夫贤。\n也应多谢经旬病，行李春光欲暮天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26774,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵见素司寇送大廷尉郑山斋先生之陕右二首 其一","author":"湛若水","text":"江右相逢记昔年，谁将只手欲扶颠。\n素翁自尔同云卧，圣主招来上钓船。\n昨夜法星辞帝座，秋光评品带秦川。\n愁闻司寇归休疏，未到丕时得稳眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26775,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵见素司寇送大廷尉郑山斋先生之陕右二首 其二","author":"湛若水","text":"偶因舒啸别长亭，未得哺糟耻独醒。\n袖里双龙须此耀，人间只眼向谁青。\n大经大法皆皇道，公是公非即性灵。\n万里长城在君手，磨崖他日待镌铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26776,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵少司马李公初度之作","author":"湛若水","text":"岳降逢辰甫及申，谁家此日产麒麟。\n折冲尊俎皆文雅，贤誉辉光在缙绅。\n好事每从初度见，风花又领一番新。\n祈天永命惟平格，我欲相期几百春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26777,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次前韵和李司马武试之作","author":"湛若水","text":"重重罗网自天申，谁道中原没凤麟。\n自昔将军不好武，于今介胄等垂绅。\n棘围琐闼论文细，耀德观兵发政新。\n记得兼资神祖语，还期皇祚过千春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26778,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"李宫谕母太淑人八十寿诞","author":"湛若水","text":"四世同筵寿益奇，孙曾拜舞随儿嬉。\n司徒寿盏称王母，戏彩贤郎是帝师。\n同贺亲宾皆胜侣，齐歌圣善更新诗。\n定应来岁貤金玉，供帐年年渐改为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26779,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿乔白岩冢宰","author":"湛若水","text":"天官堂中开寿筵，长庚正照垣西偏。\n上当北斗调元气，兼与皇图祝大年。\n再造乾坤机务重，上元甲子宰衡贤。\n门前桃李应无数，好近先生寿酒边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26780,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送杨石斋少师致仕","author":"湛若水","text":"赤日亲擎照两仪，功多违众是危疑。\n名家独步三杨后，天柱俄惊一角移。\n归路竟须从老马，惜花时复看新枝。\n未愁行处春芳暮，犹在春阴乍半时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":26781,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]