[{"title":"送屯部伍中郎守永昌","author":"欧大任","text":"使者铜符去，犹劳奉汉条。\n槟榔秋罢贡，琥珀岁宽徭。\n花洞千家氎，兰津万里桥。\n政成新乐府，听尔奏中朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答朱可大以徐迪功集见况","author":"欧大任","text":"即有徐昌谷，吾来后此公。\n书宁半袁豹，赋敢敌杨雄。\n赤骥风云上，苍虬海岳中。\n朱游折人角，家学是宗工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜同李比部黎司勋黄李二进士集金舍人宅和得比部二韵 其一","author":"欧大任","text":"似有新丰酒，寒宵不厌过。\n言从鸡树密，诗爱凤池多。\n积霰花为界，沉云玉作河。\n乡心同万里，醉亦粤人歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜同李比部黎司勋黄李二进士集金舍人宅和得比部二韵 其二","author":"欧大任","text":"金郎侍从后，宾客响然臻。\n海内推词伯，尊前得酒人。\n风生雕鹗气，雪净犬羊尘。\n此夕欢何极，空惭老角巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄蔡判官伯华","author":"欧大任","text":"谪吏书成否，闽中已四年。\n丹砂江客赋，斥卤海王篇。\n鸡犬看茅舍，儿童榜钓船。\n主恩曾不薄，咫尺五云天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁明府孔适谪闽盐官","author":"欧大任","text":"煮海功非细，牢盘有幕司。\n一轺劳跋涉，万灶问疮痍。\n子荔红云宴，官梅白雪诗。\n时看天仗里，双舄入彤墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"腊日张平叔谢仲毓姚子阶董体仁陈叔维过集斋中得杯字","author":"欧大任","text":"雪后铜驼净，劳君步屧来。\n祈年平乐观，饯岁浊醪杯。\n绣褥花犹隐，银罂药未开。\n长卿消渴久，何以答群才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪后顾叔潜自晋陵至得花字","author":"欧大任","text":"把袂三年别，怜予鬓欲华。\n尊前池似玉，帘捲雪成花。\n诗句江南月，衣装海上霞。\n相逢羞拙宦，久巳惯无家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王中郎希文恤刑山西","author":"欧大任","text":"春送长安客，平反借使车。\n大河波已息，姑射雪何如。\n王畅庭无讼，邹阳狱有书。\n泣辜明主泽，计日到参墟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘仲修一产二子","author":"欧大任","text":"盛德麟为子，名家凤有雏。\n从来荣五桂，谁得似双珠。\n汉代文长茜，唐宗楚大夫。\n应知传世业，经学在燕都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送余进士明复司法常州","author":"欧大任","text":"江南容易别，且醉胡姬楼。\n策马看芳草，听莺过远邮。\n雨深杨子渡，花傍晋陵舟。\n三尺君持去，归时汉殿秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朱中郎子得守怀庆次其留别韵二首 其一","author":"欧大任","text":"邸吏惊相报，朱郎佩郡章。\n愿停今日骑，更进故人觞。\n露冕太行碧，登楼浊浪黄。\n和歌君又去，底事老华阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朱中郎子得守怀庆次其留别韵二首 其二","author":"欧大任","text":"七年三送汝，久客怅分离。\n官喜专城早，春深卧阁宜。\n沁园邀月夕，济渎看山时。\n应有河阳作，邮筒好寄诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡伯良赴河内便还蕲水","author":"欧大任","text":"游燕栖未定，入洛兴偏赊。\n河内看明月，天坛扫落花。\n莼羹吴客句，菰米楚人家。\n知有幽期在，朱陵吸紫霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘别驾应虞赴松江","author":"欧大任","text":"大邦资画诺，岂但汉功曹。\n学以家传贵，名因吏隐高。\n九峰开晓色，三泖泛春涛。\n已待王祥起，何人赠佩刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过董山人馆题壁","author":"欧大任","text":"二十年前客，君犹困一经。\n竹仍开径绿，山自下帷青。\n临帖窥秦篆，题碑学汉铭。\n何人能引荐，西看少微星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"茅平仲南归寿母","author":"欧大任","text":"家开幔亭宴，园侍板舆游。\n海枣秦时色，江鲈晋代秋。\n佳儿欢寿母，颂客集名流。\n可是茅容学，长安遇介休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘子乔自塞上返汴中","author":"欧大任","text":"握槊渔阳下，刘生气不平。\n人谁求剧孟，客岂失祢衡。\n任侠何论贱，谈兵不用名。\n吹台高李在，归去扫柴荆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辽后妆楼为雷雨所败有述","author":"欧大任","text":"遗踪深阒寂，异代久崔嵬。\n自昔琼为岛，犹传壁是台。\n上都荒屋社，废阁弃山隈。\n井画多存藻，阑雕半渍苔。\n凝丹随日转，积翠亘天开。\n林殿黄图胜，宫池太液回。\n脂曾波共腻，镜与月俱摧。\n花尚窥妆发，鸾仍学舞来。\n千秋馀草木，一夕逐风雷。\n河岳云俱幻，烟霜劫有灰。\n秦年骊谷在，汉日柏梁灾。\n不用留殷鉴，周基万岁培。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽高封君六韵","author":"欧大任","text":"学省荣封典，恩从阙下颁。\n教方推石氏，年颇似商颜。\n翳论深藏箧，儒名老闲关。\n颐情三釜食，真宅四明山。\n薤露栖丹旐，松风洒白纶。\n何时华表上，如见鹤飞还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答张元易扈驾还见过","author":"欧大任","text":"旧直东华省，西行扈从劳。\n供随周日膳，赐有汉宫袍。\n荐熟调陪俎，分麾傍建櫜。\n官推三署长，家出五陵豪。\n鼓吏名偏起，铙歌曲自高。\n扬旗归辇毂，腾吹下林皋。\n岂谓颜光禄，能寻谢法曹。\n双童装韎韐，一骑入蓬蒿。\n握管题新句，挥觥醉浊醪。\n知君工奏赋，游幸待王褒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邵氏园饮十韵","author":"欧大任","text":"选胜名园入，寻芳上苑旁。\n水从穿渭小，山似像崤长。\n绣卉新成幄，银冰乍满塘。\n嫩篁千亩绿，秀桧一林苍。\n烟散窗前色，风飘院里香。\n芬菲移御宿，歌舞过平阳。\n凤曲遮团扇，莺簧送羽觞。\n宴酣金谷墅，心远陆浑庄。\n纷拥雕鞍出，归来壁月光。\n五陵宾客地，偏愧少年场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黄说仲","author":"欧大任","text":"朗士何方至，东南喜得朋。\n游燕宾馆筑，入洛客舟乘。\n旧学传宗伯，名家出杜陵。\n墅开金谷水，窗对玉壶冰。\n丽句霞偏绮，清言月共澄。\n大涡沧海倒，委羽白云升。\n佩请羞焉敢，琼投报未能。\n秋风怜去住，应记法堂灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"程将军挽诗","author":"欧大任","text":"素封金紫贵，车骑一何都。\n华族惟修礼，将军本好儒。\n玉麟三殿诏，铜虎五兵符。\n白发官宁羡，黄山老自娱。\n儿更名郡绶，家泛小溪䒀。\n岁月槐先植，园林草未芜。\n题阡新宰木，寄奠愧生刍。\n綮戟空瞻切，含悲向酒垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁二日陈博士伯符邀集永上人精舍同余水部君房沈比部箕仲魏太常懋权姜计部仲文赋得六韵","author":"欧大任","text":"献岁诸郎会，弥天此地逢。\n日中蒲馔进，春到苜盘供。\n客坐频传斝，僧来独扣钟。\n谈诗禅是境，问法性为宗。\n三舍吾曾避，双林尚许从。\n不须楼百尺，久已拜元龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送鸡泽徐明府","author":"欧大任","text":"授邑曲梁泽，君行笑割鸡。\n地雄漳水北，城倚太行西。\n赵璧衔山出，燕驹向月嘶。\n戴星秋省稼，禦雪夜装绨。\n百廪黄金堰，千家白马堤。\n分符仍重寄，塌羽未卑栖。\n才子怜徐干，诗名似万齐。\n恩偏移内甸，游不号愚溪。\n酒送双蓝尾，书成几赫蹄。\n陆沉犹有客，相忆在铜闺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈以清赴岭南藩幕","author":"欧大任","text":"随牒到官舍，王程行自催。\n暖烟沾碧柳，春雨熟黄梅。\n五渡峡中过，三江天际来。\n沧波通灏溔，炎峤郁崔嵬。\n关重秦时戍，楼平汉日台。\n幕中迎印绶，署里扫莓苔。\n海市珠为寺，山醪玉作垒。\n歌残花袅娜，客散月徘徊。\n赵尉称藩地，陈琳记室才。\n粤吟归有日，北望兴悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘仲修园赏牡丹苏以时袁景从李袭美同赋花字得十韵","author":"欧大任","text":"西园宁待约，为有洛阳花。\n疏柳张新幔，垂萝拂小车。\n人归盘谷日，春似曲江涯。\n凝紫云停久，披香露引斜。\n翠骄霜海萼，红笑雪山茶。\n溪浣重重锦，城开片片霞。\n席茵怜国色，池籞冠京华。\n酒爱刘伶颂，诗传谢监家。\n呼童维夕马，留客到昏鸦。\n纵遣歌声送，依然在绛纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题杂画四首 其一 蝴蝶","author":"欧大任","text":"倦雨宿南葑，穿烟起西□。\n栩栩乐何如，犹然漆园梦。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题杂画四首 其二 螳螂","author":"欧大任","text":"绿条茂阴时，冠角奋其臂。\n齐侯一回车，勇士如云至。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题杂画四首 其三 蜻蜓","author":"欧大任","text":"见尔芙蓉沜，点水款款飞。\n黄头棹船去，半湿轻罗衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题杂画四首 其四 海螺","author":"欧大任","text":"云浮海蛎房，日烘蒲蠃甲。\n依然汝南陂，不似桂阳峡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题成勋部所藏尤求画十首 其一","author":"欧大任","text":"青障矗林霏，白云映江水。\n何人出世心，嗒然隐吾几。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7330,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题成勋部所藏尤求画十首 其二","author":"欧大任","text":"晓烟澹岩户，石涧一桥渡。\n望中云术遥，似是升真路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7331,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题成勋部所藏尤求画十首 其三","author":"欧大任","text":"鹿场何者栖，虎溪未为僻。\n松根煮茗时，山斋待幽客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7332,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题成勋部所藏尤求画十首 其四","author":"欧大任","text":"霞起冠岭色，瀑下飞空寒。\n兴公如未赋，胜绝谁能看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7333,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题成勋部所藏尤求画十首 其五","author":"欧大任","text":"霜树寒犹劲，风涛急未流。\n高亭天畔色，寂寂半江秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7334,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题成勋部所藏尤求画十首 其六","author":"欧大任","text":"远树云屯深，平芜鸟飞急。\n春色过棕亭，江天片帆入。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7335,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题成勋部所藏尤求画十首 其七","author":"欧大任","text":"何人一出手，钓得四十九。\n天寒鸿雁来，川净鵁鶄走。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7336,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题成勋部所藏尤求画十首 其八","author":"欧大任","text":"红扑章台路，翠滴灞陵树。\n马上少年郎，西向长安去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7337,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题成勋部所藏尤求画十首 其九","author":"欧大任","text":"山深豹子林，江迥桐君阁。\n客来抱膝谈，悠然在庐霍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7338,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题成勋部所藏尤求画十首 其十","author":"欧大任","text":"龙起雨方注，虹横瀑更飞。\n谁令丘壑士，无意恋荆扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7339,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其一 玄览楼","author":"欧大任","text":"躧步登兹楼，冥心白云里。\n智慧想不生，吾以观无始。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7340,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其二 振藻斋","author":"欧大任","text":"窗间白凤飞，窗里青藜过。\n客来问著书，君自高齐坐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7341,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其三 素心居","author":"欧大任","text":"南村素心人，颇就陶徵士。\n长歌归去来，昨非觉今是。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7342,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其四 阳和洞","author":"欧大任","text":"山人鍊九阳，晞发朝如沐。\n何处学长生，石上采昌歜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7343,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其五 蔷薇曲","author":"欧大任","text":"谢家明月里，曲曲是芗林。\n不用东山妓，云停翠幄深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7344,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其六 山矾障","author":"欧大任","text":"春深人始归，已见花如霰。\n日夕东风吹，飘飏云母扇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7345,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其七 丛桂阿","author":"欧大任","text":"何年金粟树，留客怜樛枝。\n淮南招可隐，一咏小山词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7346,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其八 香玉丛","author":"欧大任","text":"房栊深几许，濛淡梨花月。\n有酒且共持，莫待飘成雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7347,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其九 柳竹巷","author":"欧大任","text":"垂杨深巷中，密筱空林曲。\n门开栗里烟，酒送湘江渌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7348,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其十 芙蓉堤","author":"欧大任","text":"夹堤千树锦，留得拒霜开。\n采之何处寄，还待涉江来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其十一 湘云径","author":"欧大任","text":"潇湘一片云，春深箨龙长。\n唯有裘与羊，支筇日来往。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其十二 晚香径","author":"欧大任","text":"岩鞠有黄华，寒香霜下秀。\n江州酒不来，采之满衣袖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其十三 总芳径","author":"欧大任","text":"旖旎万花谷，一径绾其口。\n尽容问字人，不妨日携酒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7352,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其十四 大雅山居","author":"欧大任","text":"有待觉为烦，委休已堪老。\n雅音未寥寥，书带千年草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7353,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其十五 牡丹台","author":"欧大任","text":"买得洛阳花，飞来赤城霞。\n谁云山步障，不似子云家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7354,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其十六 桃李园","author":"欧大任","text":"金城树成锦，青绮花如练。\n河阳解归人，夜夜春园宴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7355,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其十七 松月台","author":"欧大任","text":"月上徂徕前，疏松影在地。\n偶寄聊一适，婆娑漆园吏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7356,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其十八 长生池","author":"欧大任","text":"会心岂在远，此有濠濮想。\n烟开鱼戏来，春动鸥波长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7357,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其十九 友芳桥","author":"欧大任","text":"沧漭西池下，芙蓉荫渠水。\n几曲赤阑桥，门似高阳氏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7358,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其二十 清修草阁","author":"欧大任","text":"城带禦儿溪，林出皋亭巘。\n先生不下楼，风篁引云栈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其二十一 心远处","author":"欧大任","text":"道可羲皇上，心惟寥廓间。\n所以采菊人，悠然见南山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其二十二 淩霄石","author":"欧大任","text":"阁前到公石，独立良亦难。\n何限淩霄花，冰霜共严寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其二十三 长林石丈","author":"欧大任","text":"削成一峰尊，嵚崟势无敌。\n千秋大吕亭，青入岱宗色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其二十四 听溜石","author":"欧大任","text":"竹间鸣濑长，泠泠七弦响。\n漱石枕流谁，松风助幽赏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7363,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"友芳园杂咏为吕心文作二十五首 其二十五 长林石几亭","author":"欧大任","text":"湘中琳琅碧，岳顶莲花白。\n隐几深竹中，嗒尔天游客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7364,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送于殿讲可远谢病还东阿","author":"欧大任","text":"讲幄西清学士班，绿槐丹陛侍龙颜。\n病从金马新辞阙，焚却银鱼自闭关。\n精舍渐生书带草，世家原在谷城山。\n东归玉舄春无恙，欲共青骡海上还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7365,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]