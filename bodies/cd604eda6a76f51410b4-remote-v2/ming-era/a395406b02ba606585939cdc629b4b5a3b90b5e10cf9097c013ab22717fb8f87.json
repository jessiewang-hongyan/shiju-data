[{"title":"题三洲章先生小景 其一","author":"朱浙","text":"海上丹山碧树村，依稀风景似桃源。\n春深古路无来往，负崦人家静闭门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题三洲章先生小景 其二","author":"朱浙","text":"簇簇沙头系短篷，招提深处暮闻钟。\n板桥不渡苍苔滑，漭漭江潭烟雨中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观竞渡和韵","author":"朱浙","text":"壶公山下作端阳，素舸欢呼斗欲狂。\n我亦临流同吊古，湘累骨冷已千霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"友人惠山中小诗谢之 其一","author":"朱浙","text":"疏屋高檐两角垂，山中新制倩谁为。\n莫言软熟无刚操，试著龙山到耐吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"友人惠山中小诗谢之 其二","author":"朱浙","text":"十摺还将一幅裁，卷舒妙理转堪猜。\n轻罗小制偏疏散，天马山前归去来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"友人惠山中小诗谢之 其三","author":"朱浙","text":"青镜尘濛久未磨，为渠索照口先呵。\n自怜憔悴孤臣影，两鬓秋来白较多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题与湖南应城易生","author":"朱浙","text":"数口飘零寄海滨，长途甚处是行津。\n麦舟发付何轻易，未必今人异古人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题邓旂山掌教奖劳轴","author":"朱浙","text":"考德久崇钦世业，抡材端合应时须。\n典司风化宁卑秩，教授苏湖是巨儒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"草堂前芙蓉正吐口占数绝为别 其一","author":"朱浙","text":"芙蓉花发暗柴门，几日相看不出村。\n地远清溪童更懒，自留盆水饷花根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"草堂前芙蓉正吐口占数绝为别 其二","author":"朱浙","text":"天付秋花一种奇，草堂清淡正适宜。\n三春桃李虽多态，曾是秋风几度吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"草堂前芙蓉正吐口占数绝为别 其三","author":"朱浙","text":"清霜一夜老蒹葭，墙角芙蓉渐著花。\n犹忆昔年江上看，西风吹梦客思家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"草堂前芙蓉正吐口占数绝为别 其四","author":"朱浙","text":"楚水吴山未了因，匆匆魂梦客边身。\n拒霜已是何年种，刚得今朝作主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"草堂前芙蓉正吐口占数绝为别 其五","author":"朱浙","text":"不耐清秋怀远途，草堂坐觉旅怀孤。\n捲帘月上芙蓉影，便是人间送别图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春夕","author":"李舜臣","text":"日夕散车骑，揽辔每委迟。\n署松纷翠霭，宫柳何菀斯。\n入门纤月上，宿鸟满庭枝。\n微风振遗凛，暮色正凄其。\n客心易为感，万念咸在兹。\n岂无芳草色，祗足搅归思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日怀归","author":"李舜臣","text":"陶令赋归辞，漆叟称达生。\n揆余企高䠱，颇亦悦幽情。\n永惟故山日，桃李此时荣。\n萋萋原上草，粲粲园中英。\n翠茎浮涧藻，丹葩艳山樱。\n疏池纳文鲤，伐木候春莺。\n阳泽今岂异，抚物阻神京。\n昔人叹非土，能不念吾耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早春忆故园","author":"李舜臣","text":"往兹荐禫日，朱明甫南移。\n青青原麦秀，袅袅陌桑枝。\n家世本农业，曾读耕田诗。\n丰皋饷童仆，薄往阅耘耔。\n剪茨开旧圃，命板成曩基。\n脩杨郁近岸，翠柏荣前墀。\n木实纷丹碧，蔬挺何葳蕤。\n晨鸡夕自入，夏蝉秋始悲。\n别来岁云暮，又见春草滋。\n兴言念故宇，感激能无思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有怀故园亲族","author":"李舜臣","text":"昔予遘天祸，负葬归东州。\n寒暑倏流易，三载捷更筹。\n微息幸犹续，壮志嗟已休。\n譬之凝霜草，衰枯在九秋。\n又似不材木，托根于林丘。\n遭逢圣人朝，岩穴拔淹留。\n遂忘不肖躯，感激昨来游。\n故园日已远，荒垄谁为耰。\n亲族忽若遗，有怀安所投。\n兹身虽千里，梦寐常相求。\n王程限南北，归路何悠悠。\n不能似高鸟，去来云中由。\n俯仰觉心伤，泪下如泉流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复除户部","author":"李舜臣","text":"吾往被沉痾，乞归向桑梓。\n蹉跎狗马躯，残生得无死。\n迂愚偶自忘，将身仍上北。\n去国二载馀，王正忻至止。\n威仪睹汉官，百尔瞻君子。\n不有贤豪人，岂复知吾鄙。\n当涂辟持衡，低昂定尝拟。\n顾惟朽钝姿，徙官亦有以。\n犹惧不克任，中心宁自理。\n不见昔时贤，遭逢尚如彼。\n贾傅哭长沙，中郎锢边里。\n释过且兼兹，叨蒙讵有涘。\n犹窃紫宸班，亦友青云士。\n省署复多暇，得不废书史。\n窃比鹪鹩枝，取适惟容趾。\n敢希大隐名，晦迹云朝市。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别高子业","author":"李舜臣","text":"今上始龙飞，中兴如日旭。\n文物何休明，忠贤尽来复。\n殊方献白环，嘉气瞻黄屋。\n生逢泰阶平，偶窃南宫录。\n君时独少年，为众所属目。\n翰墨已纵横，威仪亦肃穆。\n手自握兰荪，犹似钦余馥。\n因弹贡公冠，果枉山涛牍。\n九万拟层霄，随君忽遐■。\n晨趋建章班，夕散司衡局。\n明时重交游，暇日相徵逐。\n欢言讵足珍，意气乃多淑。\n上欲窥鸿濛，直溯羲皇朴。\n其次称诗书，颇惭马迁独。\n作赋准班扬，舒词迈阮陆。\n遥遥十载心，悠悠久未副。\n分手自曩兹，开颜亦昨倏。\n微志不及申，薄游遂再辱。\n何知此为别，去住俱迫促。\n惟有慰相离，荣名能自勖。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻言简高子业","author":"李舜臣","text":"白日丽层空，鹓雏逝有适。\n饥鸢啄其下，区区虞见迫。\n腐鼠岂其珍，徒尔声相嚇。\n人生有定姿，宁与浮名易。\n亦有灌园人，三公弃如掷。\n寸心苟不察，殷忧复何益。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨夜","author":"李舜臣","text":"八月风露清，雨落犹如注。\n浃旬今不休，无乃神龙怒。\n衾裯早已寒，蹉跎未能去。\n弃置自千秋，人生贵有素。\n纷纷轻薄儿，莫以贤豪故。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"直省忆蓝玉甫时渠在系","author":"李舜臣","text":"省宿良幽旷，抚已忽多阙。\n为问夜何其，长河还未没。\n孤愁当此时，惆怅难可歇。\n事变信何常，弃捐成倏忽。\n幽拘复在兹，念子每惊骨。\n子今无羽翼，归欤当曷月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有感","author":"李舜臣","text":"洴澼或难免，机槔不可为。\n岂不贵所用，工拙有相宜。\n当津游上才，皎皎扬英姿。\n伊予山野人，微尚殊支离。\n下翔限斥鴳，归捧惭西施。\n不如脩初服，从此遄还期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太宰乔公送行诗时吐鲁番入寇","author":"李舜臣","text":"梦寐锡宸衷，台衡属上公。\n苍生安石在，衮职仲山工。\n万壑深沧海，繁星烂碧空。\n兵戈今老去，逖矣哲人风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送丁德卿出守抚州","author":"李舜臣","text":"康乐临川日，江山属壮游。\n羡君今出守，于此复鸣驺。\n地以红泉胜，亭馀碧涧幽。\n遥知词赋手，千载揖风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜归","author":"李舜臣","text":"怜此归来晚，萧萧夜色深。\n月明孤鸟宿，秋急乱虫吟。\n名薄劳萋斐，心疏滞绂簪。\n因思郎署里，贤俊昔如林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"验封署芍药独不开花","author":"李舜臣","text":"群芳时欲歇，惜此独荒凉。\n自昔名元美，当春意故藏。\n无人知艳色，何事吝清香。\n翻被东园树，因风笑尔狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚归","author":"李舜臣","text":"匹马冲烟落，荒阶渐月移。\n正多桑梓意，无奈蕙兰衰。\n浮滞秋将杪，长愁鬓欲丝。\n依墙惟数菊，过此亦难支。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"不寐","author":"李舜臣","text":"夜气凉如水，羁心耿似星。\n风鸣应落树，月上欲侵棂。\n去住身皆拙，迟回计不停。\n明朝从季主，试向卦中听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒醒","author":"李舜臣","text":"何限摧心事，常因醉里轻。\n扳欢随近舍，纵饮托同声。\n尚忆凭人入，应多宿鸟惊。\n沉昏知可戒，稳卧偶吾情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再调考功","author":"李舜臣","text":"已作还乡计，秋风却病躯。\n清时登片善，华列及吾迂。\n岂有温如玉，翻疑暗似珠。\n由来山鸟性，不愿九韶娱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕庭中怅然有怀吴文济御史时渠将有闽中之行","author":"李舜臣","text":"金气当轩肃，苍烟使舍幽。\n下阶聊独往，倚树忽千忧。\n名逐群芳晚，心摧落日秋。\n所亲仍别去，炎德指南州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴文济入闽","author":"李舜臣","text":"行色将南指，君恩向阙辞。\n拂霜蓬且转，明日酒难持。\n去国能无惜，分襟复在兹。\n直须春草遍，始是解装时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"尝酒","author":"李舜臣","text":"岂是葡萄酿，祗凭玉露斯。\n愁多须此仗，禄薄本相宜。\n束带陶将去，登楼粲有思。\n何言顽与圣，更尽手中卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄任元朴","author":"李舜臣","text":"去国今二载，犹传谏诤名。\n圣朝非尔弃，时俗乍相倾。\n迹向陶丘敛，书从梁狱明。\n平生欲何似，岁暮卧山城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夕吴文济御史见访","author":"李舜臣","text":"出省惟公暇，深居每独思。\n故人骢马客，薄暮菊花卮。\n月正清秋满，霜裁变露为。\n非君兹枉驾，何限使吾悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄刘叔正蜀中","author":"李舜臣","text":"剑阁青山外，都门紫气边。\n相看俱万里，分手已三年。\n去国是何日，浮槎想近天。\n念从众君子，交结昔何妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问答 其一","author":"李舜臣","text":"吾有沧州兴，兼闻贝锦诗。\n秋风轻棹发，期月省郎辞。\n夜织看星转，春耕候雨施。\n何如群智里，忧苦意长疲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问答 其二","author":"李舜臣","text":"忆在东山日，看君智似高。\n顷缘趋召至，应为念归劳。\n稼穑闻尝学，桑麻手所操。\n由来玄豹质，多在雾中韬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄报家兄吾有归志","author":"李舜臣","text":"此处故人稀，缁尘况满衣。\n祗缘五斗重，滋觉寸心非。\n海上鸥堪狎，天边雁欲飞。\n终当亲稼穑，白首共山扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻言","author":"李舜臣","text":"岂是蛾眉者，时闻谣诼諠。\n从来多不免，如我复何言。\n冠盖惭新识，渔樵悔故村。\n东南如假翼，归路一朝翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊坛候驾","author":"李舜臣","text":"金扉启禁垣，火树照平原。\n警跸鸣空下，旌旗夹路翻。\n一龙蹡日驭，百兽舞云门。\n岁岁甘泉上，瞻迎万乘尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠黄时庸 其一","author":"李舜臣","text":"海岱惟吾土，生才每不群。\n承明今谒帝，意气始知君。\n叔度陂千顷，箫韶奏九闻。\n仍看作者志，直欲继斯文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠黄时庸 其二","author":"李舜臣","text":"阙下初心醉，堂中共目成。\n映尊梅未尽，承步草新生。\n白雪听歌郢，甘泉见赋京。\n吾承骚雅后，何限慰交情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"城隅别某","author":"李舜臣","text":"匹马送将违，心摇正欲飞。\n好依官道柳，且傍老莱衣。\n草藉清尊满，花馀故树稀。\n平生君共我，独自夕阳归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日姚氏园候客","author":"李舜臣","text":"尝从宾席末，闻道郭园名。\n之子舟将泛，兹吾盖少倾。\n花明娇日色，鸟作弄春声。\n便可留今夕，应多满月情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日饮兰亭章石室时与黄李二子同坐","author":"李舜臣","text":"共到兰亭饮，仍因石室留。\n如何城市里，亦有洞岩幽。\n泛鼎疑烟宿，当窗似涧秋。\n俄闻莺响发，无乃谷中求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入朝逢李子西御史联步","author":"李舜臣","text":"乌动秋河彻，鸡鸣夜漏空。\n楼烟霜更紫，海色曙全红。\n星落千官骑，天开万户宫。\n此时趋禁阙，正与故人同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓起","author":"李舜臣","text":"微步出前墀，东方欲曙时。\n残花犹带露，宿鸟忽惊枝。\n饮酒身多病，看梳发有丝。\n未应迂谬迹，还寄省郎为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"直省","author":"李舜臣","text":"向夕风烟迥，空庭鸟雀馀。\n尘襟还役物，暝色正愁余。\n发有星星改，名将日日疏。\n因思郎署里，未若托吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄黄时庸浙中","author":"李舜臣","text":"昭代今词客，东江复此行。\n山闻霞似色，湖忆镜为名。\n严濑千岩迥，枚涛八月惊。\n天台仍胜绝，随意畅高情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得某汝宁书","author":"李舜臣","text":"南国棠为舍，斯人玉作书。\n知君思远道，犹我怨离居。\n去住身皆客，山河岁渐除。\n念从花下别，早已树头疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"待赵景仁不至","author":"李舜臣","text":"曾许过邻舍，朝朝望至曛。\n人应天路杳，鸟复夕庭纷。\n月迥光初满，霜清气略闻。\n羁心愁对此，何况正思君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李子西出按宣大 其一","author":"李舜臣","text":"拂晓动危旌，严垂指北平。\n烽烟还未靖，骢马故遄征。\n二镇雄天邑，千山亘石城。\n直劳前箸借，已夺右贤精。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李子西出按宣大 其二","author":"李舜臣","text":"万里长城险，三秋太白明。\n雁关天上启，狐岭雪中行。\n斧钺垂寒色，钲鼙壮朔声。\n要令沙漠外，遥惮汉贤名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李子西出按宣大 其三","author":"李舜臣","text":"清边知有志，慷慨赴戎行。\n沙碛行荒塞，风云控朔方。\n角弓弯汉月，铁骑猎边霜。\n万里狼烽靖，归来凯奏长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李子西出按宣大 其四","author":"李舜臣","text":"塞草郁何丰，边尘望不穷。\n龙沙连海上，鸟道入云中。\n悬斧三军肃，扬旌六郡雄。\n伫闻飞檄至，他日幕南空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上","author":"李舜臣","text":"秋风边塞上，飞檄忽纵横。\n独将三军出，分为四道行。\n阴山锋始接，瀚海帐皆倾。\n缚得名王至，声驱右北平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许亨甫以其父大司徒公命省其祖母","author":"李舜臣","text":"爱子窥颜色，趋庭问所思。\n望中云共远，阶下草方滋。\n晓日明金骑，春风吹绿枝。\n还闻临别去，遥附万年卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送崔懋言赴顺庆太守","author":"李舜臣","text":"雪落朔风凄，寒光逼马嘶。\n征途天共远，到日草方萋。\n春色行花县，烟波下篆溪。\n无为叹非土，遥逐夜猿啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省中晓起偶有所思","author":"李舜臣","text":"在公常夙夜，出户偶徘徊。\n忽忽严更彻，纷纷曙色开。\n禁钟清晓月，宿露滴庭槐。\n鸟有鸣相和，人皆去不回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"缓步庭中","author":"李舜臣","text":"倏忽怅无娱，空庭步自虞。\n本无黄绶意，偶忝赤墀趋。\n草色萋闲径，莺声满上都。\n何当乘此去，散发故山隅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶从诸公走马通惠河边","author":"李舜臣","text":"南陌苦多尘，相从出水滨。\n微风摇浦树，晴日暖洲蘋。\n彼鸟犹求友，群鸥似狎人。\n悠然磐石上，一叟正垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"通惠河","author":"李舜臣","text":"碧水澹晴空，桃花夹岸红。\n溪流坰畔合，城阙渡头雄。\n浩荡来何极，苍茫逝不穷。\n应从御沟去，长绕凤皇宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阙左候朝","author":"李舜臣","text":"清光想玉旒，曙色望瀛洲。\n鹏海蒸霞出，龙池入月游。\n南熏荣绿树，北斗挂丹楼。\n顾忝金门籍，朝朝此薄留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨晴","author":"李舜臣","text":"宿雨霁丹晖，高天出翠微。\n花如新濯锦，草似偶含玑。\n残雾凭楼宿，轻霞度阙飞。\n莺歌应满树，兰气渐通扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同赵景仁游邵氏郊园","author":"李舜臣","text":"出郭共追寻，因君谐夙心。\n忽如金作谷，兀尔石成岑。\n径转青萝曲，溪流绿树阴。\n亭台纷可悦，今日始窥临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":4934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]