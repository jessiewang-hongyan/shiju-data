[{"title":"明妃曲","author":"欧必元","text":"白塞烽烟起，寒云野戍横。\n望断胡天月，长照汉家营。\n花钿滋别泪，琵琶调苦声。\n冶色宁容保，君王爱罢兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝社中赏花","author":"欧必元","text":"寻盟开社日，春事更相宜。\n围绿添疏径，新红满旧枝。\n微风香暂歇，积雨艳还迟。\n况值诗成后，如泥醉不辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春初见月同李伯熙赋","author":"欧必元","text":"新春初见月，清影破愁霖。\n漾水光犹淡，悬枝树半阴。\n远山如画黛，竹院对弹琴。\n忽动鸣春鸟，喈喈求好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨宿石门","author":"欧必元","text":"绿草临平岸，渔舟遍大堤。\n雨中邻火暗，云外远峰迷。\n蓑笠时堪负，家醪恨少携。\n歌声何处发，山店野桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒六祖禅师","author":"欧必元","text":"久坐但参禅，风幡任往年。\n欲知不二法，别自有三天。\n慧火乾坤尽，皈心海月悬。\n西来无所事，何用七灯传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵州山寺独酌","author":"欧必元","text":"为访名山至，非因礼佛来。\n衣冠曾此地，烟雨独衔杯。\n风起潮初长，林深雾不开。\n狂歌发归兴，短棹亦徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜度羚羊峡","author":"欧必元","text":"离家方四日，行已望端州。\n峡水无潮汐，江云有去留。\n闻猿知是岸，见月始维舟。\n萍梗俱如此，忘机任白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十六夜赵氏园亭玩月得轻字","author":"欧必元","text":"一岁秋过半，池亭月更明。\n疏烟笼柳淡，寒露湿衣轻。\n坐久微云掩，谈高浊酒倾。\n穷交二三子，真见古人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄元卿过访村居二首 其一","author":"欧必元","text":"为农传世业，颇似鹿门居。\n近市能沽酒，临溪易得鱼。\n经年无过客，今日始停车。\n不厌幽栖简，墙阴待著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄元卿过访村居二首 其二","author":"欧必元","text":"喜得中宵饮，因闻鸡犬喧。\n烟萝三亩宅，水竹数家村。\n剪烛供吟兴，烹茶续话言。\n未能留信宿，安敢望平原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"田都护兆祥来薰堂宴集","author":"欧必元","text":"将军开宝第，上客荐雕盘。\n柳自营边合，花从槛外看。\n有言皆脱俗，无剑不登坛。\n醉后歌长铗，归来且莫弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵洲寺遇翁水部之官","author":"欧必元","text":"已辞珠海曲，言赴秣陵春。\n星是郎官旧，诗传水部新。\n握兰香渐远，折柳赠还真。\n今日祇林下，尊前别故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三水夜泊","author":"欧必元","text":"舟维沙渚外，邑近水岩阿。\n傍海居民杂，悬崖古木多。\n犬声吠篱落，月色浸烟波。\n向晚闻渔唱，推蓬发浩歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"胥江晓发","author":"欧必元","text":"编茅知海市，种竹远成村。\n风紧帆樯急，林深鸟雀喧。\n官船争早发，庐巷未开门。\n为问频来往，谁言利涉烦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得泉声咽危石","author":"欧必元","text":"叠嶂望方平，江流势欲倾。\n悬崖一片立，长日万山鸣。\n落叶催风急，挥弦待月明。\n禅心与客意，对此共澄清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题孔阳宗侯依隐亭二首 其一","author":"欧必元","text":"山色自苍苍，亭依万竹傍。\n栽应同渭水，赋或儗梁王。\n制萚冠非小，临风韵更长。\n清秋明月夜，同伴薜萝裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题孔阳宗侯依隐亭二首 其二","author":"欧必元","text":"朱邸王侯宅，青门处士家。\n笔床供翰墨，手泽识瑶华。\n昼卧宜疏雨，窗閒爱晚霞。\n淮南有鸿宾，不川羡丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林叔宝还鲤湖","author":"欧必元","text":"寄居东郭寺，颇似著潜夫。\n旅病怜鸡骨，乡心梦鲤湖。\n风尘疑后会，霜雪满前途。\n若问人天果，能参半偈无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠番禺陈令公","author":"欧必元","text":"贲禺亦瘴乡，海气接扶桑。\n令已飞双舄，人今跨五羊。\n辛盘调玉露，火树杂珠光。\n共听弦歌遍，春来或下堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王山人德操还姑苏 其一","author":"欧必元","text":"探奇趋石室，有约问罗浮。\n岂谓寻仙杖，翻成访戴舟。\n身依行客苦，情为故人留。\n语及经时别，中年怕远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王山人德操还姑苏 其二","author":"欧必元","text":"花开三月春，柳赠一离人。\n别听鹧鸪曲，归应麋鹿亲。\n工诗缘骨瘦，买药益囊贫。\n倘订游吴约，枫桥愿结邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠莆中方伯谏","author":"欧必元","text":"相逢湖海士，把臂竹林欢。\n驹自称千里，人今羡二难。\n已能诗里史，犹作画中看。\n寥落风尘意，朱弦总未弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别康季修六年已忽从大将军度岭喜遇海上 其一","author":"欧必元","text":"乍晤即分离，追欢无几时。\n风尘一把袂，湖海六年思。\n剖腹凭江鲤，临风想桂枝。\n秦淮舟去后，消息杳难期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别康季修六年已忽从大将军度岭喜遇海上 其二","author":"欧必元","text":"相看惊别久，相见梦魂中。\n肝胆虽如昨，鬓眉稍不同。\n练裙书渐老，横槊赋逾工。\n惜此绸缪意，尊罍莫放空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游蒲涧梅花寺 其一","author":"欧必元","text":"杖策返罗浮，烟霞事事幽。\n饮思清涧水，行续白云游。\n野寺封苔古，寒林落叶秋。\n稍分僧茗啜，竟日可淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游蒲涧梅花寺 其二","author":"欧必元","text":"地以千秋胜，田因近日还。\n僧收数亩粟，聊驻半年山。\n牛系柴门外，人归夕照间。\n菖蒲无处采，赢得片时閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莆阳给谏戴公枉临斋中","author":"欧必元","text":"荒亭三径长芙蕖，何物朝来长者车。\n疏草旧传青琐闼，干旌今枉白云庐。\n檐空种竹深成巷，窗静来禽宛傍书。\n盛世亦知无缺补，归朝封事问何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲午元旦","author":"欧必元","text":"旭日瞳眬达曙光，江城霁色散严霜。\n南来气候占春早，北望星辰待漏长。\n自识传家裘是业，何如卒岁茇为裳。\n微才更有椒花颂，敢上君王万寿觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄郑明府承孟","author":"欧必元","text":"绿鬓归来已息机，持竿终傍钓鱼矶。\n折腰吾道无今古，销骨人间有是非。\n海内青云谁竞长，歌中白雪自翻飞。\n欲寻谷口栖真处，暂向江城望少微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杜晋夫游勾漏","author":"欧必元","text":"二月桃花舒小红，一尊聊饯粤台东。\n已知逃市非梅福，无奈寻仙待葛洪。\n何处春光云雾里，望来山色画图中。\n綵毫能志西游胜，白石高题第几峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虞部公挽章四首 其一","author":"欧必元","text":"逍遥八十丈人翁，东观谈经擅汉宫。\n自昔迂狂辞水部，遂令疏懒绝山公。\n广陵涛涌声犹壮，廷尉罗张客尽空。\n一代风云虽遇合，遗书犹在茂陵中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虞部公挽章四首 其二","author":"欧必元","text":"贤哉祖帐出都门，赐老宁忘圣主恩。\n白雪调高名已重，青山家在道逾尊。\n窗临曲水群鸥散，花落蘧园独鹤翻。\n文藻江山今寂寞，千秋屈宋竟谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虞部公挽章四首 其三","author":"欧必元","text":"寻仙历下已凋零，江左风流事杳冥。\n粤失秘书琴已绝，家亡虞部不堪听。\n楼虚万卷非生白，业在千秋有杀青。\n鞭弭旧游看顿尽，中原唯望少微星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虞部公挽章四首 其四","author":"欧必元","text":"衣冠同出杜陵庐，文济年来礼法疏。\n未有赋才称矍铄，敢劳名姓代吹嘘。\n书藏客自归金穴，丹熟人能步玉虚。\n已向风尘谙幻迹，山阳何必泪沾裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日饮李良甫龙池社","author":"欧必元","text":"薄暮寻山倒接篱，忽乘清兴问佳期。\n高阳宾从疑湘浦，落日儿童胜习池。\n竹影疏村千树暝，月临江水一舟移。\n归心不觉秋霜怯，争似浮槎问海湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送良翰王孙还豫章兼寄孔阳诸宗侯","author":"欧必元","text":"孤剑冯陵已十年，风雷离合各茫然。\n湖间日月鸿冥回，海上金银蜃气连。\n刘政未悬中垒阁，张融羞问孝廉船。\n君家鸿宝谁堪授，愿寄淮南桂树篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄黄国博先生","author":"欧必元","text":"虎观谈经气自豪，避人三径长蓬蒿。\n十年坛坫归牛耳，一代词名有凤毛。\n病去风尘忘世态，狂来天地失吾曹。\n东篱花下曾称寿，倘许重过进浊醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄赠张幼于丈二首 其一","author":"欧必元","text":"欧冶张华剑未分，望来同现七星文。\n虚埋丰狱尘中气，自拂要离冢上云。\n蕙草一株聊可寄，梅花三弄不堪闻。\n何时拟共操莲舫，桃叶江头独问君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄赠张幼于丈二首 其二","author":"欧必元","text":"高名当日竟谁尊，侠气翻令大雅存。\n客散侯赢虚左席，人疑司马卧文园。\n朅时身世抛三亩，何物乾坤寄一尊。\n若到吴门看匹练，罗浮春色在中原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀苏考甫","author":"欧必元","text":"风波一失傍樵渔，社燕宾鸿各自疏。\n排闷强高浮白兴，避人聊借草玄居。\n风前书札寻常至，眼底交游涕泪馀。\n咫尺江乡如可问，衡门应望吕安车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜山行","author":"欧必元","text":"寒宵共逐寻芳侣，杖策穿林鸟道斜。\n月暝空山无吠犬，雪迷芳树欲飞花。\n行看橘柚开三径，望尽云松隐数家。\n就此卜栖那可得，居人指点说桑麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁酉除夕立春","author":"欧必元","text":"今宵除夕春意动，物色参差殊可怜。\n竹径草堂聊自适，椒盘生菜为谁传。\n诗篇久傍江湖里，贫贱长驱岁月前。\n心折此时无一寸，懒将怀抱问流年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春饮酒","author":"欧必元","text":"善开朱杏已迎春，懒啭黄鹂唤几巡。\n老大渐悲双短鬓，徉狂羞作独醒人。\n非关阮籍穷犹哭，自是陶潜醉后真。\n二十六年生计拙，恐应无地问垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"傅逊之先生以明府量移交学南归久候命不下作此慰之","author":"欧必元","text":"百里曾歌茂宰贤，初归三径尚依然。\n飞凫久望云中日，失马宁知塞上年。\n自去毡坛缘可结，由来宣室事空传。\n驱车不为王尊出，弟子何人授太玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬高比部正甫","author":"欧必元","text":"见说词坛海内豪，雄心君已定鞬櫜。\n七言自拟高詹事，三尺何如谢法曹。\n疏旷欲题鹦鹉赋，风流谁起凤凰毛。\n盐车未解腾骧意，一入孙阳价遂高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日同朱季美刘季德刘道子黎缜之僧觉道黄元卿开社虹冈招朱叔祥卢元明区启图不果赴喜闽中李启元诸子后至","author":"欧必元","text":"新开莲社粤台东，授简词人赋并工。\n竹下弟兄何处隔，天涯朋旧一尊同。\n露华恍自疏桐落，山色疑窥夕照中。\n禅理更酬支遁座，佩萸犹傍菊花丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄区太史公","author":"欧必元","text":"十年簪笔侍彤庭，尚忆东林旧隐情。\n玩世似将宾戏论，异时谁擅子虚名。\n西山雪色寒犹媚，南海珠浮夜更明。\n汉主近来祠太乙，侍臣何用望金茎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄王伯谷先生二首 其一","author":"欧必元","text":"鞭弭中原五十春，凭陵一剑岂依人。\n纵趋丞相厅中试，羞作诸侯幕里宾。\n侠气直须齐慎到，斋心差拟学王珣。\n六桥风月阊门柳，匹马还惊梦后身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄王伯谷先生二首 其二","author":"欧必元","text":"出世逃名结小亭，斋头半偈可谁听。\n春前芳草家家绿，雨后吴山处处青。\n笔札未应终玩俗，菩提能悟即抛经。\n词华更总禅栖理，屈指如君惘自停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虹冈社赏梅","author":"欧必元","text":"千树梅花绕郭开，一时词客并登台。\n初疑舞雪罗浮过，更似凌波洛浦回。\n清婉未听愁里笛，芳菲独入掌中杯。\n白虹山下年年赋，尚忆吾家水部才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答刘季德元日雨中过酌之作","author":"欧必元","text":"淑气千林遍草莱，洗天风雨试轻雷。\n冲泥策马今朝至，艳李迎春昨夜开。\n三径云烟能供客，一尊柏叶莫停杯。\n非君旧好怜同调，纵有新题肯共裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日虹冈社集","author":"欧必元","text":"人日年年景色鲜，今年人日转堪怜。\n几家风雨断肠处，无数梅柳争春妍。\n篇诗渺渺浮名外，车马纷纷大道前。\n柏叶酒清休放盏，况有佳人醉舞筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送督学陈公参藩晋陵二首 其一","author":"欧必元","text":"旬宣新命出承明，曾是儒宗起大名。\n周室向来尊讲幄，汉家无事盛谈兵。\n梅花自绕春申水，玉节高临泰伯城。\n赐履倘勤明主诏，中兴元自重阿衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送督学陈公参藩晋陵二首 其二","author":"欧必元","text":"诸侯开幕总临戎，明月閒窥避暑宫。\n海上兵戈连白塞，中原王气望青葱。\n留宾自下陈蕃榻，观乐宁忘季子风。\n况是登高能作赋，词臣今在大江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游七星岩二首 其一","author":"欧必元","text":"磴道逶迤百给来，名山况复枕崧台。\n三花并倚诸天出，七曜初从一径开。\n玉乳倒悬阴洞石，瑶封长护白云苔。\n求仙不是寻常事，暂儗烟霞对举杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游七星岩二首 其二","author":"欧必元","text":"避暑携尊自爽然，上方楼阁倚云巅。\n奔雷骤雨无常态，叠石重岩有别天。\n但得长吟消永日，不知残碣是何年。\n莲香十里真堪采，欲觅湖间载酒船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周宪副先生入贺因上疏将其太夫人归养会稽遥有此寄","author":"欧必元","text":"自携金鉴入枫宸，柳色莺花处处春。\n白日高悬将母疏，红尘不染宰官身。\n非关心逐尧天远，但可书藏禹穴新。\n寂寞师门犹万里，更从何处度迷津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送瞿睿夫先生还楚","author":"欧必元","text":"轻舟租舫满江皋，归梦应悬万里劳。\n别去祇堪遗缟带，穷来偏自恋绨袍。\n七哀迁客悲吴土，九辨词人续楚骚。\n天地故教饶落魄，风尘双眼健吾曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张子远还新安","author":"欧必元","text":"负笈从师入粤年，忆归初上汎湖船。\n乡心已折刀头约，别思仍同海月悬。\n倡道久知尊马帐，发硎初自出龙泉。\n桓谭新论何时就，已自人间授太玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日邓刺史德咸招同柯起之刘季德刘道子万伯文饮朱季美竹凉亭","author":"欧必元","text":"名园围近市廛间，酒伴词人日往还。\n竹里云归团绿影，城头过雨出青山。\n开尊兴剧谈锋折，入座凉生茗椀閒。\n车马向多门外迹，可能容易掩柴关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄黄山人","author":"欧必元","text":"问尔浮生近若何，夫君高谊古人过。\n座中客散黄金尽，镜里愁添白发多。\n末路酒杯无去住，忧时谈笑有风波。\n唯馀数亩柴桑地，日暮题诗挂薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张端孟之官茂名","author":"欧必元","text":"曾题纨扇寄相思，闻尔双凫集凤池。\n江左司空元博物，河阳仙令雅能诗。\n山围古郭听猿夜，秋入荒郊省敛时。\n莫以才名誇治行，延陵犹有大夫祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伏日同赵丕显傅贞甫赵丕振李伯襄饮岑克懋云谷山斋","author":"欧必元","text":"藤萝高掩竹间门，避暑相从更避喧。\n郭里青山围近屋，望中烟树远成村。\n谈因醉剧纵横出，交以情真肮脏存。\n身世冷然忘去住，不妨移席枕松根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"呈明府倪公 其一","author":"欧必元","text":"楼台高拥赤城霞，海上初停八月楂。\n门下美材收竹箭，县中新种是桃花。\n汉京北望频飞舄，勾漏南来不为砂。\n自昔太玄经可授，岂因奇字识侯芭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杂诗 其十","author":"梁以壮","text":"万事从中来，有酒可解忧。\n云烟变倏忽，微阳照西楼。\n步兵乞校尉，供奉市上留。\n人前趋不急，风尘伤貂裘。\n醉卧不复忆，空庭飞白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":37146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]