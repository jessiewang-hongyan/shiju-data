[{"title":"饮郭都谏别墅 其二","author":"区元晋","text":"花径呼童扫，柴扉为客开。\n忽惊仙犬吠，云外一车来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2705,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采桑","author":"区元晋","text":"二蚕应未熟，桑下午提篮。\n忙杀罗家女，何人复驻骖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2706,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顺昌县途中用壁间韵感述 其一","author":"区元晋","text":"秧萎忧严寒，蛙骄喜绵雨。\n溜声听转长，霁色望偏苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2707,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顺昌县途中用壁间韵感述 其二","author":"区元晋","text":"近市轻烟浮，晨炊日已晏。\n醒来看黄粱，犹似梦中饮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2708,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顺昌县途中用壁间韵感述 其三","author":"区元晋","text":"归榻彗南轩，行歌日已晏。\n君看五斗米，不作渊明饭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2709,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李与厓诗人客怀之作 其一","author":"区元晋","text":"把酒竹当扉，伴吟花映席。\n春光荡四隅，此是邺侯壁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2710,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李与厓诗人客怀之作 其二","author":"区元晋","text":"矮屋不安门，花香长满席。\n小蛮斗新影，和月倚素壁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2711,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题惜花春起早","author":"区元晋","text":"晨起理蛾眉，寸心花无发。\n含情诉东风，犹恐韶光疾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2712,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题爱月夜眠迟","author":"区元晋","text":"未忍罗带解，蟾光满绣扉。\n情深听玉笛，声隔粉墙儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2713,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题掬水月在手","author":"区元晋","text":"妾心如水月，掬浣圆个个。\n欲寄黄华戍，春深无雁过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2714,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题弄花香满衣","author":"区元晋","text":"小蛮扳紫翠，香雾湿罗衣。\n点滴留痕在，伤春心自知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2715,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题赵东台写钟潭泉手卷画 其一","author":"区元晋","text":"暖日抽芦荻，柔风杨柳花。\n春江浓似酒，何处问渔家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2716,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题赵东台写钟潭泉手卷画 其二","author":"区元晋","text":"我爱中宪翁，墨花洒数柳。\n千载陶渊明，高风谁复右。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2717,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和答潘晴川漫兴韵 其一","author":"区元晋","text":"客来东郭履，坐我北窗琴。\n应契无弦处，同冥水月心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2718,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和答潘晴川漫兴韵 其二","author":"区元晋","text":"倒予云液瓮，报尔紫琼琴。\n醉里无拘束，回观太古心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2719,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新舫初登用古诗韵 其一","author":"区元晋","text":"三夏千年戒，春秋几字连。\n扁舟还广览，应吊古厓天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2720,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新舫初登用古诗韵 其二","author":"区元晋","text":"舟维芳草合，棹繫暮云连。\n野思生繁笛，閒愁入远天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2721,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新舫初登用古诗韵 其三","author":"区元晋","text":"西岭夕阳度，新江秋水连。\n蓼花何处笛，声动白鸥天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2722,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新舫初登用古诗韵 其四","author":"区元晋","text":"古屋秋风里，当同鲁仲连。\n空尊搔白发，环堵坐青天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2723,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客枉小舫游叙叠韵 其一","author":"区元晋","text":"雨过津如拭，云低岛欲连。\n仙舟同李郭，遍适海门天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2724,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客枉小舫游叙叠韵 其二","author":"区元晋","text":"伊昔芙蓉梦，于今花影连。\n情深看宿鹭，分我枕中天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2725,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山居","author":"区元晋","text":"我屋云山下，柴扉也不扃。\n竹根釐犬吠，不为鹿麋惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2726,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙溪","author":"区元晋","text":"龙溪深且清，下有老龙鸣。\n龙鸣水怪静，不似水禽声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2727,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"公出驻节陶太守池馆踰宿徙居行台 其一","author":"区元晋","text":"秋色覆琼宇，寒花转白蘋。\n檐晴喧瑞雀，藻密隐祥鳞。\n山石堆云远，池涧引泉新。\n混混无止息，级级故峋嶙。\n长吟时顾影，伴峙且欹巾。\n流行敢混俗，卓立自超群。\n野旷多奇趣，境清无纤尘。\n主人开绿野，五马驾朱轮。\n英风凌苍汉，壮志御青云。\n竹帛恒自矢，声华应耻论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2728,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"公出驻节陶太守池馆踰宿徙居行台 其二","author":"区元晋","text":"圣世锡云厚，遐邦望正频。\n尚祈一掬蕴，化作万家春。\n薄暮轩前酌，清歌还几巡。\n微酣问胥史，共称使君仁。\n荒城能驱虎，云阁定图麟。\n闻斯舆论美，已领居停恩。\n所交在雅谊，市道安足云。\n努力崇令绩，声光遍四垠。\n明发别兹境，良觏知何辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2729,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵表兄曾大尹见寄","author":"区元晋","text":"万里金门归，拜命重悚侧。\n陟岵役非劳，分符思自剧。\n贱子本迂疏，阅时滋颇僻。\n六马气难调，一豹事讵识。\n深惧专城寄，尚乏扛鼎力。\n我父紫薇翁，桓桓政超特。\n甘棠播馀荫，寿国留方脉。\n后进者何人，遗训敢渝易。\n清秋看飞鸿，翱翔无止息。\n愿言驾征骖，乘时布先德。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2730,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜思","author":"区元晋","text":"永夜不能眠，渴思邻墙酒。\n琼浆轻压刍，馨雰扑户牖。\n须知卓公狂，不失醒时守。\n醉分瓮底春，兴超豪侠右。\n流莺啭幽谷，玄蝉鸣新柳。\n东风满林峦，扶藜羡野叟。\n旅囊笑屡空，供具成乌有。\n明发重踟蹰，欲携二三友。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2731,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晨起二首 其一","author":"区元晋","text":"晨起怯衣单，山瓶频呼酒。\n旭日出岩峦，灵辉射窗牗。\n平生负暄心，炎凉肯渝守。\n野人诚戋戋，爱主故无右。\n霜意老梧桐，春光透桃柳。\n岁时感推迁，生业问田叟。\n征输极频烦，室家空诸有。\n因思拙阳城，千载为良友。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2732,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晨起二首 其二","author":"区元晋","text":"经明弦诵呕哑满，风暖梨棠门巷香。\n操持冰檗久弥厉，当道交称叠剡扬。\n经纶自合调元鼎，膏泽旋应遍八荒。\n闻道求言方侧席，五云翘首补天裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2733,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春访宗家园行","author":"区元晋","text":"日暖田芜鸟雀翻，田家相饷曝朝暾。\n雨馀桑柘连社曲，日睛鸡犬散山村。\n萦回草色带屐痕，寻芳还访宗家园。\n宗家翠锁桃千树，自比武陵旧隐处。\n心随流水共悠然，兴逐飞云留不住。\n碧梧丹凤今何时，莫向游人笑来去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2734,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦旱行","author":"区元晋","text":"祝融尸职待行云，亢阳遍野骄如焚。\n泉乾断涧青苗槁，日永黄尘白昼昏。\n古来祈祷先六事，天远凭谁达帝阍。\n君不见十风五雨谷穰穰，粒米狼戾输太仓。\n公家租毕庾有馀，鼓腹熙熙化日长。\n愿驱旱魃不为虐，早沛甘霖遍八方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2735,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"流花桥怀古 其一","author":"彭世潮","text":"霸业繁华事已空，江山如旧画图中。\n仙城日月留秦照，珠海云霞忆汉风。\n渔艇棹歌归柳绿，野田烟景葬桃红。\n美人千古香魂在，粉腻随花出渚东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2736,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"流花桥怀古 其二","author":"彭世潮","text":"旧桥流遍百花香，霸业消沉惜艳妆。\n登眺岂怜秦地尽，游人多感汉台荒。\n三城雾起归渔舫，夹岸风清送夕阳。\n惆怅兴亡今古事，暮钟微日照横塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2737,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题 其一","author":"彭世潮","text":"风雨三春梦正饶，西陵芳草恨遥遥。\n萧条秋髻看将白，零落诗魂欲待招。\n旧事易随灯烛灭，新愁难向酒杯消。\n年来光景空低首，夜月寒江共寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2738,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题 其二","author":"彭世潮","text":"诗事未酬良夕债，酒杯空冷落花枝。\n门前水向东流急，塞外霜归北雁迟。\n难折柳丝持赠别，漫书桐叶寄相思。\n自从一谢閒亭梦，雨雨风风总未知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2739,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花 其一","author":"彭世潮","text":"一春憔悴有谁知，斜捲珠帘吊落曦。\n愁见暮烟埋碧玉，恨随风雨葬胭脂。\n六朝文物轻回首，千古繁华半皱眉。\n离合悲欢俱是泪，迷魂应逐杜鹃飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2740,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"落花 其二","author":"彭世潮","text":"槛外西风一夜侵，飘飘那忍更相寻。\n感逢绝处诗谁胜，愁到浓时酒自斟。\n莺逐断烟啼北郭，蝶拖残月过东林。\n因君检点兴亡事，不觉踌躇费朗吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2741,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠友","author":"彭世潮","text":"曾从小阮知名久，莫怪相逢发浩叹。\n一介尚能严取与，半生那得免饥寒。\n诗为性命吟来易，舌作生涯老去难。\n三尺瑶琴一杯酒，为君沉醉为君弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2742,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋风词","author":"彭世潮","text":"昨夜西风撼我扉，不愁吹叶落梧枝。\n祇愁吹到头颅上，短发星星见二丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃花曲","author":"彭世潮","text":"细雨胭脂洒易匀，东风吹落涧边春。\n多情我亦怜芳者，几度逢君欲问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤凰台","author":"尹邦宁","text":"凤社屯冠盖，风光挹舞雩。\n形骸天地外，今古笑谈馀。\n树静阴常合，春浓乐与俱。\n披襟何洒洒，携手咏归欤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠戴宾竹","author":"尹邦宁","text":"吾食可无肉，吾居偏近城。\n此君日相访，幽抱时一倾。\n蒲团独岁晚，世路多尘缨。\n花影隔林动，何曾笑讶迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游小金山","author":"曾贯","text":"灵洲金作柱，郁水镜为邻。\n轶浪吞瓯楚，危楼入汉秦。\n近窥狐兔窟，高瞰蜃龙唇。\n寂寞东坡老，繁花空复春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日珠江宴集","author":"赵鹤随","text":"江心珠石起孤根，擎出金莲敞法门。\n圆月肖形常作侣，青山如带若为垣。\n竞奇蓬岛仍依郭，差胜湖西更傍村。\n海藏龙宫托灵赐，五云呈瑞见朝暾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游小金山","author":"赵鹤随","text":"长安倦客幸归舟，笑上金鳌控海楼。\n姓字未通僧识面，禅心无愧佛张眸。\n坡翁玉带留金界，云老圆光射斗牛。\n明日红尘又成市，却随鸿影度清秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阙题","author":"赵鹤随","text":"龙津风致富江春，万丈丝纶一葛巾。\n云影诸天归画幅，传家谁谓羡黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"圆通阁","author":"邓浩","text":"下马入山寺，空林秋气豪。\n佛灵迹在石，僧老耳垂毫。\n松倚西风瘦，峰衔北岭高。\n绝尘惊物静，弥觉一生劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游阴那名胜","author":"郑弘彝","text":"珠宫云护四山围，人宿花台剑气晖。\n夜静清闻天籁发，月深啼断涧猿稀。\n寒江隐隐疏钟放，霜树潇潇落叶飞。\n顿觉吾生萍梗泊，将因此地制荷衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游灵光寺","author":"李尚理","text":"为寻野趣叩禅扉，路入桥南近翠微。\n地静惟铺青草色，山高岂碍白云飞。\n昙花贝叶来僧榻，萝月松风满客衣。\n似此幽光真个好，何妨临水坐苔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游西竺寺","author":"李尚理","text":"路入清幽野趣长，漫云仙驭此翱翔。\n一泓深壁千秋古，万木悬崖六月凉。\n何处天成蓬岛景，几人身到水云乡。\n从今留咏鸣珂去，岁岁湖光印斗光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"粤秀山","author":"岑万","text":"极目扶胥一水隈，三山如拥五羊来。\n歌楼菊径皆刘迹，野草秋风满汉台。\n人语渐随烟市合，征帆犹傍夕阳开。\n萧疏僧舍青松外，忽听樵歌首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜宿五层楼","author":"岑万","text":"山城矗矗绮筵开，杰阁谁抡巨栋材。\n一水浮涵孤屿出，群山遥拥五羊来。\n夜看北斗星辰丽，却忆中天华岳回。\n天上台衡正虚席，东人惟恐衮衣来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后海珠登眺 其一","author":"岑万","text":"秀色东南海欲浮，李公墩上一维舟。\n潮平水漫鸬鹚石，树杪云生翡翠楼。\n野释向人挥短麈，红尘满眼隔长洲。\n登瀛自是殊风致，黄木湾前渔笛秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨后海珠登眺 其二","author":"岑万","text":"北望迟回白玉京，束书孤剑赴江城。\n暮云芳树浑无极，秋水蒹葭空复清。\n绿野未须频缱绻，东山犹自策勋名。\n诸公衮衮为元辅，礼乐无劳鲁两生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒忠简公祠饯长子用宾赴池郡二首 其一","author":"岑万","text":"江间片石最称雄，莲宇璇房岛屿中。\n别酒却缘催解缆，老怀浑似逐飞蓬。\n风随乌鹊凉生袂，雨洗银河色映空。\n期汝策名原不细，文溪吾土有高风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒忠简公祠饯长子用宾赴池郡二首 其二","author":"岑万","text":"临流仗剑是英雄，绮席青尊一水中。\n送汝云霄天万里，念予衰朽鬓双蓬。\n可人秋色还长昼，极目征帆挂远空。\n莫惮九华山路险，但携琴鹤晓凌风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蒙惠节菊小诗申谢","author":"岑万","text":"春风夜合连宵话，黄菊禅房带雨开。\n尘榻几年烟树杳，仙踪何处木兰回。\n浮生色相人皆老，异日瞿昙招不来。\n已订宝陀山寺约，一尊应上妙高台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺","author":"岑万","text":"石门天设险，一水护青湾。\n地轴雄南海，云峰丽北山。\n阴阳互推荡，日月时往还。\n寺僧闻客至，倒屣开松关。\n抚景询旧迹，登临爱兹山。\n愿从安公子，啸傲烟霞间。\n君看慧猿归，解赠诃陵环。\n如何巫山女，朝暮理云鬟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺 其一","author":"岑万","text":"地僻秋仍暑，江回积雨深。\n安生长独往，帝子竟何心。\n香火诸天上，藤萝两岸阴。\n慈航似许借，惠远在高岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺 其二","author":"岑万","text":"空门临水曲，兀坐亦如如。\n览秀情何极，凭高兴不虚。\n云烟随兔颖，缃素起龙鱼。\n忽悟禅宗旨，清朝懒曳裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺 其一","author":"岑万","text":"飞来何处是茫然，直拟蓬莱第一天。\n客入扪萝空慧眼，僧呼烹茗汲清泉。\n水声澎湃鱼龙隐，山色参差霄汉连。\n我欲凭阑歌一曲，恐惊云外旧啼猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺 其二","author":"岑万","text":"碧水遥从天际来，两山疑是巨灵开。\n啼猿归处流云湿，客子来时画角哀。\n黄鹄青冥人共语，疏林清磬鹤初回。\n上方更借绳床坐，閒对松萝一举杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古行路难效骆宾王","author":"岑万","text":"君不见汉家漠北多王庭，胡儿百万窥边城。\n烽火终宵烟焰起，羽书结辙缤纷行。\n龙韬太社传纶綍，虎将中军严鼓钲。\n挥戈止日长城窟，带甲连云细柳营。\n星斗迢迢回北极，风雨凄凄暗南国。\n青鸢旗映紫貂裘，白马辔拥黄金勒。\n雷轰电掣驱前骑，鹏运鹰扬开右翼。\n燕然山上杀声连，雁门塞下汉威宣。\n军令五申浮玉斝，皇恩三锡照金莲。\n暑往寒来惊六琯，歌台舞榭音书断。\n三春梅柳别情多，千里相思衣带缓。\n行路难，吹剑高歌栖贺兰。\n愿将功列麒麟阁，一任衾横翡翠寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋江玩月歌王静斋中舍时在舟中","author":"岑万","text":"今夕此何夕，弄月江上秋。\n秋江水清浅，上有黄芦洲。\n黄芦洲月来天上，倒景却向银河流。\n把酒问明月，清光今几何。\n如何今年景，还比去年多。\n去年看月坐空阁，今霄看月临素波。\n波光月色两相射，与君玩之发商歌。\n斟美酒，百千巡，鹔鹴解换玉楼春。\n竹间村犬吠狺狺，山风飒飒吹残云，渔笛一声愁杀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春有怀庞弼唐","author":"岑万","text":"洛社频虚席，云山路更赊。\n春来已隔岁，腊尽且还家。\n霜实传红橘，香酥泛紫霞。\n石龙风转急，何处是仙槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠江留别伦彦周诸公次韵","author":"岑万","text":"扶胥雨霁鹤初回，秋水清风梵宇台。\n迁客谁怜游海曲，凭虚吾欲入天台。\n人间锦瑟宁须鼓，江上芙蓉独未开。\n珍重临风数杯酒，归期先约陇头梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿龙泉再用简州韵","author":"岑万","text":"芙蓉云帐望中微，碧树青莎静掩扉。\n万里蓬萍叹飘转，廿年衣马未轻肥。\n楼台几处人吹笛，砧杵谁家夜捣衣。\n青鸟不来乡国异，关河回首重迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":2771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]