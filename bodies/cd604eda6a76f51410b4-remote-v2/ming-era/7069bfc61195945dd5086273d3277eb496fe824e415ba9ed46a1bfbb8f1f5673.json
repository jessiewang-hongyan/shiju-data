[{"title":"题苏廷尉子仁写程征君君衡北溪幽居图","author":"朱多炡","text":"新安溪水清绝尘，轻舠下可数鱼鳞。\n溪边直钓非渔父，溪畔幽居有逸民。\n风扫波文绉成縠，雨过溪毛细于发。\n欲雨先嘘白岳云，层波碎泻黄山月。\n廷尉先生今虎头，赠君䌟纸写沧洲。\n只知看画矜幽胜，忘却身从画里游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6233,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙沙","author":"朱多炡","text":"龙沙驻跸地，皇祖纪南征。\n草昧君臣定，壶浆父老迎。\n平临章贡水，远视灌婴城。\n今古雄图在，低徊落照明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6234,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄答恩公时闻友人盛仲交之讣","author":"朱多炡","text":"江左贫支遁，南州病许询。\n书工短长说，梦觉去来因。\n康字先生谥，斯文后死身。\n不知盛览赋，零落属何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6235,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送龙君御北上","author":"朱多炡","text":"蓟北三千里，扬帆复此行。\n水程时序易，身计羽毛轻。\n玩世安穷达，移官任圣明。\n离心并芳草，日夜为君生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6236,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日怀张羽王","author":"朱多炡","text":"言旋南岳驾，又作蓟门行。\n尊酒不为别，河梁空复情。\n一官羁万里，十口寄孤城。\n日暮春云起，相思处处生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6237,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七月七日晒书中庭得吴明卿书报谢","author":"朱多炡","text":"扪腹非经笥，中庭曝旧书。\n殷生惭半豹，楚使慰双鱼。\n季曲存加饭，绸缪问卜居。\n欲知旋袖地，近得比园庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6238,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过永叔郊居 其一","author":"朱多炡","text":"王郎读书处，何异辋川庄？\n竹舞风梢乱，葵烹露叶香。\n哦诗迷鹿柴，洗研据渔梁。\n久坐春阴合，倾杯送夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6239,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过永叔郊居 其二","author":"朱多炡","text":"雄鸠啼不歇，客散近黄昏。\n蜡屐粘香絮，单衣绣雨痕。\n炊烟寻去径，社鼓望前村。\n半道牛车至，争驰入郭门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6240,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀姚匡叔时在岭南","author":"朱多炡","text":"老去高游兴，南方不可居。\n新愁攻短发，清泪染长裾。\n吊影烽烟里，全生瘴疠馀。\n梅花空满眼，珍重岭头书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6241,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"池上纳凉履方履中二侄挟琴携酒索临禊帖醉后并示堚儿","author":"朱多炡","text":"小阮发清兴，绿尊能为携。\n池头千个竹，烟月使人迷。\n琴罢思焦尾，书成损赫蹄。\n酣呼居语尔，慎勿贱家鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6242,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"邀邓太素欧于奇周孟修卢时行陈彝甫但和叔汪于海张明用彭次嘉王显之魏伯饶辟疆同集贤士湖上","author":"朱多炡","text":"湖山看不厌，秋尽最宜人。\n枫叶经霜醉，蘋花过雨新。\n萦回盘马客，潇洒好鹅宾。\n携手论文处，行藏已出尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6243,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"衷诚孺姜尧章载酒邀何主臣同饮","author":"朱多炡","text":"穷巷满春泥，松醪特为携。\n谁怜子桑户，自恼太常妻。\n蜗篆苔纹厚，蚕眠薤叶齐。\n颓然聊取适，相送及鸡栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6244,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"智公在永宁寺检藏","author":"朱多炡","text":"玄度翻经后，支郎卓锡馀。\n莲花重结社，蕉叶与供书。\n半偈参香象，千函校鲁鱼。\n此中如断酒，那得住篮舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6245,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送闵寿卿之金山","author":"朱多炡","text":"游客去欲尽，送君濒岁除。\n身投开士宅，口授异人书。\n卧榻禅灯古，吟窗水月虚。\n时临洗研处，芳讯付双鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6246,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送沈子健之馀杭薄","author":"朱多炡","text":"苕水分西浙，馀杭更向西。\n邮餐供海错，县鼓候潮鸡。\n风壤吴趋接，征徭茧簇齐。\n由拳纸价贱，乡信日堪题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6247,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同赵汝迈漆中甫二太史宿张明成司业东郊别墅分赋四章 其一","author":"朱多炡","text":"水宿客程厌，渡江聊系舟。\n交凭缟带结，饮约布衣留。\n野馆琴书暇，田园草木稠。\n因君解悬榻，他日记南州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6248,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同赵汝迈漆中甫二太史宿张明成司业东郊别墅分赋四章 其二","author":"朱多炡","text":"徙倚步郊坰，西山黯翠屏。\n春醪曲尘绿，晚饭烛花青。\n小隐丛生桂，浮踪一聚萍。\n疾邪焉用赋，甘学古沉冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6249,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同赵汝迈漆中甫二太史宿张明成司业东郊别墅分赋四章 其三","author":"朱多炡","text":"荒鸡警人语，倦鸟飐风枝。\n枕膝高眠稳，惊心起舞迟。\n调元期未晚，求试计非时。\n总有忧生感，忘言各自知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6250,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同赵汝迈漆中甫二太史宿张明成司业东郊别墅分赋四章 其四","author":"朱多炡","text":"丹霞朝蔽日，零雨暮为霖。\n白日歌长夜，青绫共旧衾。\n阶空檐濑咽，城远鼓声沈。\n兰叶前溪满，搴芳寄此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6251,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送方元素会黎秘书葬还里","author":"朱多炡","text":"往棹凉风发，归装淑景温。\n河山酣畅地，翰墨死生恩。\n负局轻逾岭，怀铅尚及门。\n伤心兼恨别，欲赋已销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6252,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和芾斯兄问疾之作","author":"朱多炡","text":"伏枕残花尽，开门坠叶深。\n膏肓竖子策，生死弟兄心。\n原上声犹急，池头句可寻。\n相怜越庄舄，不作楚人吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6253,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别俞羡长还江东","author":"朱多炡","text":"昔寻吴市隐，邂逅虎丘筵。\n今理南州榻，予栖白社禅。\n风遍别时便，月苦病中圆。\n后会江湖外，苍茫定几年？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6254,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病中得馀灵承书","author":"朱多炡","text":"少别愁怀积，微躯朔气侵。\n疟来君子病，书展故人心。\n慰藉烹双鲤，支持戏五禽。\n山中如见月，疑策素车临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6255,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"酬从侄郁仪元长德操","author":"朱多炡","text":"经年向壁卧，挺动入春宜。\n谈虎魂销后，惊猿痛定时。\n新抄病梨赋，久废咏怀诗。\n忽见阶庭雪，因惭和曲迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6256,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"酬履方履中履直伯大四侄问疾诗","author":"朱多炡","text":"予有幽忧疾，沉冥四序移。\n蚁声听若斗，蛇影见还疑。\n竹下闲游屐，花间罢赌棋。\n亲交如问讯，未死汝南痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6257,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"移居 其一","author":"朱多炡","text":"屋上青山半隔城，门前林木有馀清。\n林连北郭藏春色，水过东家作雨声。\n薄禄藜羹堪养老，闲身竹素最钟情。\n人嘲寂寞扬雄宅，自笑《玄经》草未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6258,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"移居 其二","author":"朱多炡","text":"几车书籍重新迁，绕架殷勤手自编。\n一世蠹鱼同出入，千秋鸿宝足留连。\n挥毫隔竹萧萧雨，洗墨临池澹澹烟。\n熟读《离骚》还痛饮，颓然犹藉古人眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6259,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"长至日内集分阳字","author":"朱多炡","text":"缇室飞灰月转阳，闭关兄弟且持觞。\n共书云物惊时改，祇益穷愁与日长。\n旋袖一为鸲鹆舞，称诗三复鹡令章。\n阿奴不预人间事，岁岁承颜在北堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6260,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初春寄唐惟良使君","author":"朱多炡","text":"春风庾岭兴何如，落尽梅花未见书。\n人日能无常侍句，屏星不定使君车。\n孤台灌木催黄鸟，二水流澌泮鲤鱼。\n莫笑邺都才力尽，胡床东壁待应徐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6261,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"熊茂初请假还蜀过幻景庵言别同孔阳弟酌之限歌字","author":"朱多炡","text":"十笏家开窣堵波，宰官乘兴入烟萝。\n狂来击钵词锋起，醉后摊书梵字多。\n不定重逢为日远，即论少别奈愁何。\n休将白社埙篪调，听作瞿塘《滟滪歌》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6262,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"问巍甫侄疾","author":"朱多炡","text":"海上何人说禁方，科头长似懒嵇康。\n穿林雨暗茶烟绿，隔院风微药草香。\n转向病中怜故旧，谁从身后定文章。\n闭门不问春多少，看静飞花坠满床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6263,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同刘问之启明弟郁仪元长德操渫之侄毂两儿伯垒泽弘孝穆侄孙步出郊园料理欢喜庵饮贤士湖上","author":"朱多炡","text":"二月郊原草树平，水边重赋丽人行。\n逃禅有地诗称社，负郭无田笔代耕。\n波暖镜花含笑态，林喧簧鸟窃脂声。\n相逢园客忘机事，转洽年来抱瓮情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6264,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送顾朝肃出守虔州","author":"朱多炡","text":"暂息青骢驾紫骝，竹符新剖治虔州。\n署中望阙孤台耸，江上行春二水流。\n气候不齐连岭海，土风相杂半闽瓯。\n停车试问廉泉在，要识澄清顾醴侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6265,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"司寇临海敬所王公阅视三镇远以图说见遗赋诗二章为报 其一","author":"朱多炡","text":"鸣笳伐鼓出居庸，凭轼边城万骑从。\n每饭未尝忘巨鹿，一编今已尽卢龙。\n行专阃外纾筹策，归向尊前论折冲。\n莫道书生无剑术，箾中霜色吐芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6266,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"司寇临海敬所王公阅视三镇远以图说见遗赋诗二章为报 其二","author":"朱多炡","text":"一望重关塞草枯，主恩持节视防胡。\n九边烽火褰帷净，三镇军声指掌呼。\n上谷去天低倚剑，黄河如带稳飞刍。\n平收聚落风沙色，并入山阴笔阵图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6267,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"曝书画见故人梁思伯遗翰不胜怀旧之感","author":"朱多炡","text":"逼除行舸系江干，盘礡津津到夜阑。\n雨雪漫题诗閤去，河山遂隔酒垆寒。\n延陵有剑徒心许，南海无珠作泪弹。\n素练淋漓裙数幅，悲来开箧几回看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6268,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上益王","author":"朱多炡","text":"睿德隆公族，英才丽本支。\n三雍陋河间，七步浅临淄。\n潇洒游仙咏，从容乐善辞。\n问遗偏宠渥，锡予倍恩私。\n手敕家人礼，亲贤国士知。\n纶言天只尺，宫扇墨淋漓。\n九子罗圭冕，诸王属屏维。\n具瞻龙种贵，悉览凤雏仪。\n夜照青藜杖，秋荣桂树枝。\n虚车名并美，拥彗节逾卑。\n丹洞穿兔苑，麻源到雁池。\n瓜筵文玳瑁，药碗妙琉璃。\n大火西流候，长庚正耀时。\n茹茅京氏《易》，松柏楚元诗。\n鸟爪羞麟脯，神功酿蚁卮。\n遥遥颂磐石，黄发以为期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6269,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送徐朝直水部奏绩入都","author":"朱多炡","text":"新凉澈徂暑，徒御戒宵征。\n烟柳辞鸠署，星榆集凤城。\n书名注上考，联步切西清。\n衮职期山甫，金钱计水衡。\n九门迟漏箭，三殿缓钟声。\n待旦应多暇，抽毫赋《二京》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6270,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同张明成司业饮管子安使君舟中申旦而别各赋一诗","author":"朱多炡","text":"未妨关法急，来就使君期。\n胜算藏彄戏，遍师刻烛诗。\n闻歌两岸近，荡桨百壶移。\n野烧侵沙灭，疏钟渡水迟。\n西山半衔月，南浦暗流澌。\n旅雁啼更彻，樯乌讹尾时。\n江空人籁息，衣冷曙霜欺。\n极乐无朝夕，轻装动别离。\n脂膰秣五马，前路满旌麾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6271,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送雷元亮赴国学","author":"朱多炡","text":"浦口馀春水，舟前换夏云。\n黄骊低度曲，绿蚁易成醺。\n去鼓桥门箧，行谈虎观文。\n晓鞍宫月引，宵枕禁钟闻。\n纨扇窥裁雪，虞弦听奏薰。\n但教逢得意，宁复叹离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6272,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送高汝谦廉访之蜀","author":"朱多炡","text":"叱驭王程急，何辞栈道难。\n刀州开宪府，剑阁拥词坛。\n一水萦巴字，层城壮锦官。\n鱼尝丙穴美，书发酉阳看。\n风采名先动，霜威暑亦寒。\n褰帷谕父老，争睹惠文冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6273,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送朱茂倩秀才由贵竹趋滇南省觐奉柬当路诸公","author":"朱多炡","text":"英妙鲁诸生，趋庭肯计程。\n所思官舍远，不惮鬼方行。\n前渡清湘水，先闻苦竹声。\n动人猿狖啸，劝客鹧鸪情。\n杂处风随异，夷居语未明。\n天低庄蹻垒，山隘武侯营。\n庶卉惟分色，昆虫莫辨名。\n祥龟符赤寨，天马濯龙坑。\n入贡来驯象，临流想石鲸。\n几年方偃革，无事习佳兵。\n渐化诸酋俗，新安六诏城。\n一人今有庆，孤旅夜无惊。\n重镇须公等，修涂荷太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6274,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"降夕咏怀二首 其一","author":"朱多炡","text":"白屋多强仕，朱门屈壮夫。\n万端皆落后，不独是屠苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6275,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"降夕咏怀二首 其二","author":"朱多炡","text":"意气因寒劲，生涯与岁穷。\n蓬蒿憔悴地，明日也春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6276,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答客","author":"朱多炡","text":"问我何因学酒禅，才呼米汁便流涎。\n凭君舁入莲花社，醉里机锋醒不传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6277,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠满公","author":"朱多炡","text":"土木形骸满月容，尽教髭鬓雪茸茸。\n不知夏腊今如此，清隐庵前手种松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6278,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别何主臣之金陵兼柬欧水部","author":"朱多炡","text":"桂树来攀雪满枝，芙蓉去采月临池。\n凭将蝉雀新团扇，与乞江东水部诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6279,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送梁传之从襄阳将母南还","author":"朱多炡","text":"夫人城外汉江平，逐子南回五两轻。\n路出鄢邙频雨雪，头槎鱼贱笋初生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6280,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王姬还芝城","author":"朱多炡","text":"蘼芜芽碧柳丝黄，来往扁舟就沈郎。\n一掬宫亭清浅水，凄波不怨洛川长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6281,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖口县","author":"朱多炡","text":"湖水澄清江水浑，江烟湖霭易黄昏。\n请看湖口江心月，一片寒光照县门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6282,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清明湖上","author":"朱多炡","text":"湖畔行吟日未斜，四年三度客天涯。\n不知鶗鴂惊飞去，穿破来禽满树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6283,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过馀干","author":"朱多炡","text":"馀干城头云泊天，琵琶洲下水如弦。\n推篷理咏随州句，落日平沙似往年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6284,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"不寐","author":"朱谋堚","text":"雨绝梦无情，灯帏恍惚明。\n馀香收病室，高枕压愁城。\n树动窗含影，钟来屋接声。\n更阑拥衾坐，侧耳听鸡鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6285,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"旅居独夜","author":"朱谋堚","text":"吟苦竟忘寐，一灯孤影人。\n溪楼连夜雪，山县隔年春。\n水碓响空涧，石床生薄尘。\n寒更过桥去，还向酒家亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6286,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白下集沈生予明府席上赋得春草","author":"朱谋堚","text":"芳杜夺幽色，秦淮客路遥。\n青莲邀笛步，绿锁赛工桥。\n柔雨生三径，残烟认六朝。\n梦归南浦里，几个别魂消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6287,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病间寄徐无染兵宪","author":"朱谋堚","text":"西风黄叶病沉沉，尚忆衔杯不废吟。\n我渐老来如烛影，君凭官去肯灰心。\n时尝药碗知寒苦，月醉篮舆爱夜深。\n别后同游常入梦，蒋家幽径许谁寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6288,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夕袁太守招集衙斋","author":"朱谋堚","text":"宵无郡事有闲情，为问山经几日成。\n石榻澹云孤客梦，帘栊疏雨一官清。\n灯明草阁惊虫响，烟逼茶铛阻鹤行。\n向说匡家秋不尽，满檐寒瀑漱松声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6289,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日郊行","author":"朱谋堚","text":"荒刹虚亭古墓平，幽闲地上一僧行。\n初疑废井人烟绝，又见丛林佛火生。\n夹道白杨翁仲影，绕篱红杏子规声。\n芳魂艳魄增惆怅，日拥沙堆半过城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6290,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋晚熊二仲纾喻二宣仲见过窳园小坐","author":"朱谋堚","text":"入林消受片池风，并坐秋阴话未穷。\n黄堕病梨霜露下，红稀捻柿夕阳中。\n会心客近窥鱼鸟，顾影人间数雁鸿。\n二仲偶来棋一局，垆香铛茗不曾空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6291,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨卧","author":"朱谋堚","text":"不睡爱听雨，雨声听不明。\n莫能新梦去，怕有旧愁生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6292,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"就鹫峰寺宿同喻宣仲王曰常郭伏生作","author":"朱谋堚","text":"鹫岭幽僧借竹房，薰笼茗碗坐绳床。\n夜长何必求归梦，冻雨疏灯话故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6293,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠康侯弟","author":"朱谋㙔","text":"羡君三十早登坛，电戟霜戈走笔端。\n秀句惊人时戛玉，清言对客总如兰。\n题回酒颂非缘醉，赋就郊居肯借看。\n几度西堂春草梦，殊令康乐作兄难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6294,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访康侯弟郊园","author":"朱谋㙔","text":"郊居绝似沈休文，戢羽藏鳞远世氛。\n堂下紫兰新过雨，檐前绿树半侵云。\n酌来茗饮多清韵，谭到图书得异闻。\n不为爱闲能到此，祇缘累月惜离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6295,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题黄贞父玉版居","author":"朱谋㙔","text":"为访莲花漏，因成玉版居。\n攒峰开步障，古木架精庐。\n将客青霞上，论文紫月馀。\n一端萧散意，犹作换鹅书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6296,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"甲寅春日江村即事三十首 其一","author":"朱谋㬜","text":"北郭携家野岸东，山猿出槛鹤辞笼。\n朱门华屋身先避，白石清泉计未穷。\n子已哀殇空字犬，妻能偕隐亦如鸿。\n亲知莫讶林扉远，只隔轻帆十里风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6297,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]