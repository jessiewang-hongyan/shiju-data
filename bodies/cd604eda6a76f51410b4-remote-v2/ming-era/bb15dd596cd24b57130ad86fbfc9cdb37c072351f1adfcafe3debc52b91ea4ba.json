[{"title":"寄章都护四首 其二 题投辖馆","author":"孙继皋","text":"公子敬爱客，尚书期奈何。\n华灯灿甲馆，绮席明银河。\n车辖每投井，羽觞还促波。\n空传孟尝侠，弹铗有悲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄章都护四首 其三 题烟驾园","author":"孙继皋","text":"为园驻烟景，人道小江南。\n不乏禽鱼趣，兼之树石参。\n边春花自发，泉古酒同甘。\n径造那能得，逢君竹下谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄章都护四首 其四 题城南别业","author":"孙继皋","text":"玉塞去天遥，花仍杜曲娇。\n角巾私第日，干羽圣人朝。\n门已施行马，家元擅插貂。\n颇闻求宿将，君拟霍嫖姚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿袁睎我方伯尊翁","author":"孙继皋","text":"汝南月旦数诸袁，盖世风标尔自尊。\n向以文章雄郡国，不将纶綍傲丘樊。\n微吟花影春萦社，半醉江声夜到门。\n共指衡山堪献寿，郎君新此建朱幡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄思老宅集社分得丝字","author":"孙继皋","text":"春城社散已经时，夏日寻盟对雨宜。\n似洒山阳思旧泪，未知河朔纳凉期。\n层阴欲堕侵单袷，重午才过恋五丝。\n光景易流人易老，相逢沉饮不须辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顾少玄太学游淮阳","author":"孙继皋","text":"曾闻五月惯披裘，底事冲炎赋远游。\n岂为淮南招隐士，生怜河朔客诸侯。\n甘罗城古秦云杳，漂母祠空楚水流。\n日晚烟萝相送出，片帆江岸去悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月六日大雷雨贾弘老东第新成社集得烝字","author":"孙继皋","text":"治第新成锦树层，况逢雷雨破炎烝。\n翻惊燕雀愁相失，似挟蛟龙怒欲腾。\n几道西山银泻瀑，一时南亩绿低塍。\n醉馀便逐鸥群去，水涨潮平暮可罾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龚毅老南园社集赏佛桑花荷花各咏七言近体一首 其一 佛桑花","author":"孙继皋","text":"仙艳谁从岭外移，柔条六月缀花奇。\n蒸霞定压祇园树，浴日疑分碧海枝。\n朱槿差堪窥色相，石榴那敢斗容姿。\n寄言陌上提筐女，莫误春风摘叶时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龚毅老南园社集赏佛桑花荷花各咏七言近体一首 其二 荷花","author":"孙继皋","text":"莲叶平池花乱开，桥通宛转水潆洄。\n艳呈朝采迷妆镜，香咽凉飔度酒杯。\n太液似闻妃子笑，若耶不见美人来。\n行歌翻罢江南曲，秋老衣裳好共裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月七日顾云山太守园亭社集酷暑日下舂而散因赋","author":"孙继皋","text":"午暑不可耐，那能须夕凉。\n空思片雨集，怕见双星翔。\n觞罢日将阁，客归河未梁。\n问何慵乞巧，儿女笑牵裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠通州守张聚徵","author":"孙继皋","text":"身都千骑领东方，海国行春满路光。\n人自楚材来郢上，名同汉吏起渔阳。\n重歌麦垄双岐似，旧憩棠阴百里强。\n共道下车偏得岁，却愁天阙去含香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠顾武陵有感其兄少司马公","author":"孙继皋","text":"身堪拥褐老，心与流云期。\n骠骑名何减，虎头人自奇。\n彩毫知转健，斑鬓尚如斯。\n几度山阳泪，看君欲暗垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈封翁全庵","author":"孙继皋","text":"早将踪迹寄烟霞，燕翼经传众所誇。\n令子今为单父宰，贤人曾聚太丘家。\n玄湖九里仙源近，紫诰双龙帝宠奢。\n自是得全偏得福，野夫何处望声华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送曾吴县","author":"孙继皋","text":"讼庭芳草傍吴宫，驿路征车辑玉同。\n枫陛天高朝正月，花封人远待春风。\n三年绩最讴歌外，万岁声长拜舞中。\n宴罢阁门催转对，为陈民力尽江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙午十一月内侄张世卿茂才宅桂花盛开因赋 其一","author":"孙继皋","text":"老桂飘香晚更奇，重开不怕朔风吹。\n请看璧月临长至，可让中秋午夜时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙午十一月内侄张世卿茂才宅桂花盛开因赋 其二","author":"孙继皋","text":"一种天香学士家，栽时尔祖侍金华。\n不缘孙子重攀折，那得寒堂再作花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿张廉水","author":"孙继皋","text":"烟霞曾共列仙期，名姓何妨女子知。\n身著布衣行侠远，肘悬金盒贮方奇。\n閒时采药腰镰去，醉里看花荷锸随。\n鸿术自来侔宰相，白头不羡梦非螭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿丁吏部母","author":"孙继皋","text":"板舆亲御下天阊，宫锦莱衣舞未央。\n家近三山桃正熟，筵开八月桂初香。\n霞觞自酌仙人酒，水镜长临婺女妆。\n争祝异恩他日在，回班谁不拜高堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄酬李宛平内乡","author":"孙继皋","text":"京兆田郎题柱名，相逢我未厌承明。\n几陪韦杜春同醉，一别荆吴岁屡更。\n丹地不萦归客梦，沧江难忘故人情。\n尺书传字来何处，愁听流莺树里声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林司理应召北上","author":"孙继皋","text":"几年丹笔凛秋霜，秋水今看是橐装。\n此去攀辕倾泽国，向来推毂动岩廊。\n讼庭过雨甘棠长，谏省生风疏草香。\n望入五云谁不羡，雍雍鸣凤待朝阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送商司理应召北上","author":"孙继皋","text":"征旆秋摇指帝都，留鞭垂涕万人呼。\n亦知待诏公车满，且掇腰章大府趋。\n听讼几年依赤棘，陈言何日拜青蒲。\n太平事业诸贤在，安稳閒身狎五湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋后二夜乘月渡五里湖","author":"孙继皋","text":"月出湖波白，乱流山势斜。\n榜人能辨树，仙客拟乘槎。\n宿鹭惊还定，明蟾阙亦华。\n此中幽胜别，老去好浮家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上生日同丘士行诸友赋","author":"孙继皋","text":"生朝五湖畔，系艇故人俱。\n礼佛投僧舍，寻山问野夫。\n病还馀狗马，閒尽狎鸥凫。\n村酒聊堪寿，秋风吹荻芦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿吴兴李参知父母","author":"孙继皋","text":"雪廨官梅开满园，金绯称庆日初暄。\n著书人未离函谷，采药家元近鹿门。\n柏叶预传新岁酒，薇花高映大夫轩。\n山城万口歌恩遍，并入春声介寿繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"社集以龚岳伯故中废累月矣元夕前一日施囧伯寻盟焉爰赋一律纪兴时严侍御初入社","author":"孙继皋","text":"笛里山阳曲未终，灯前里社兴还同。\n春蓂应月开将满，火树侵星望若空。\n在野归人曾颂駉，入林佳客况停骢。\n因怜芳夜愁心减，一倍衰颜照酒红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题董太史画","author":"孙继皋","text":"苍厓古寺白云封，上有天池写玉龙。\n想得高人濡墨处，閒心一片挂芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重九前一日同王元穆山中送吴允兆北游即席分赋 其一","author":"孙继皋","text":"老骥自千里，曰游天一方。\n乡愁缘俭岁，别酒近重阳。\n野霁云全白，山寒菊未黄。\n为欢黯离思，相劝慎风霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重九前一日同王元穆山中送吴允兆北游即席分赋 其二","author":"孙继皋","text":"晴旭满秋城，秋筵此送行。\n孤帆乡路远，一剑客囊轻。\n坐石看云午，浮波待月生。\n词坛去堪主，休冷野鸥盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送范东生世兄楚游","author":"孙继皋","text":"移家结客散千金，促驾怀人七泽深。\n授得征衣当九月，弹将别绪在孤琴。\n高秋兰茝寒江色，积水菰芦故国心。\n回首白云看不极，西风吹梦太湖阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邑丞郭汉虹还益阳","author":"孙继皋","text":"上书不达赋归来，空橐何妨载石回。\n臣自当诛曾出位，众皆欲杀可怜才。\n三年水国将漕苦，十月风江拍浪哀。\n但不负丞休亦得，几枝残菊媚寒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春夜同彭兴祖山人集沈茂才宅得阴字","author":"孙继皋","text":"奋雨还谁问，方春喜客寻。\n烟霞千里色，杯酒十年心。\n公子怜芳草，幽人恋故林。\n醉归无不可，残月落城阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过茅孝若留饮同彭兴祖作","author":"孙继皋","text":"弭棹聊相慰，投车意独深。\n三年孝子泪，十日古人心。\n风雨空庭急，烟霞众壑阴。\n乐章能自写，思尔近祥琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周中丞怀鲁晋督河 其一","author":"孙继皋","text":"一疏曾回大陆沉，恩波真共五湖深。\n安邦世仰经纶手，吁阙天临痛哭心。\n冠弁星流娇柳色，旌旗云拥闪棠阴。\n百城何限春耕者，释手攀辕思不禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周中丞怀鲁晋督河 其二","author":"孙继皋","text":"更镇重悬大府章，行河此去筑宣房。\n台前旧识朱公柏，陌上新留召父棠。\n夜静蛇龙初匿影，春回鸿雁尽随阳。\n锡圭正际垂衣日，宅揆还看总庙廊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春仲小园社集分得虾字","author":"孙继皋","text":"遗荣无梦侍金华，幽事閒身一壑奢。\n齿分暮年增犬马，心怜春水长鱼虾。\n数声黄鸟求偏切，十里青山望不遮。\n社酒渐堪寻胜赏，东风早破碧桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黎别驾","author":"孙继皋","text":"三年佐郡此江湄，五岭天遥黯去思。\n按剑尚怜明月在，拂衣还与白云期。\n康邦绩载舆人颂，猗亩心悲巷伯诗。\n酌水送君君自爱，重来迎竹看群儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题张民部抱关问寝图","author":"孙继皋","text":"仙郎分署俯沧洲，寿母临觞映白头。\n云满关门频望气，萱荣堂背自忘忧。\n香添五夜供温被，箸进重闱佐执筹。\n燕喜莺迁谁得似，宁亲体国荷恩优。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张民部吴关得代擢长其曹还朝","author":"孙继皋","text":"及瓜传诏下新除，拜宠雍容领篆初。\n画省持筹关国计，赤囊飞羽动边书。\n握兰却望春晖远，起草频惊夜漏疏。\n民力东南君自见，忧危还喜诵衣袽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王元祯太学别余久矣一日谒余山堂遂赴留都试赋二绝句送之 其一","author":"孙继皋","text":"风尘不记别君年，烟雨重逢思渺然。\n试问交游湖海遍，何人能觅孝廉船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王元祯太学别余久矣一日谒余山堂遂赴留都试赋二绝句送之 其二","author":"孙继皋","text":"太学诸生旧有名，青衫彩笔老纵横。\n白门秋榜看题字，荆璧今翻上殿行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王元祯应留都试得船字","author":"孙继皋","text":"孰使唾壶缺，转怜经笥便。\n时名快晚达，行色动秋先。\n紫气钟陵树，苍烟梦泽船。\n高堂看擢桂，老亦倚婵娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"摄山投岳上人房","author":"孙继皋","text":"停策寺已暝，入门山更深。\n月来疑速客，云卧喜投林。\n访药扶衰态，巢松寄远心。\n尘踪转自惜，老始遂幽寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和朱兰嵎太史韵赠万休上人","author":"孙继皋","text":"山前明月佛前灯，石自无言水自澄。\n欲向空门闻妙义，渡江初到踏芦僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中林园别范五兄","author":"孙继皋","text":"入林竹翠滴人衣，更有垂杨野水围。\n园比辟疆容径造，楼同王粲忆将归。\n梦回几度生春草，歌罢频应看夕晖。\n信美总怜吾土远，别君无限思依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":20999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张孝廉弦所应南宫试","author":"孙继皋","text":"征车轧轧晓闻鸡，长路风烟去不迷。\n文字早知辉玉藻，姓名新许押金泥。\n春袍绿映宫前柳，夜阁青分杖底藜。\n望望五云天北极，曲江谁拂旧时题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠蔡观察遇庆沾恩 其一","author":"孙继皋","text":"玉节朱衣作镇年，金函紫诰荷恩偏。\n江明组练风烟净，阙演丝纶日月悬。\n文武万邦归宪式，燕贻三世见承传。\n牙旗开府新除近，雨露重看下九天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠蔡观察遇庆沾恩 其二","author":"孙继皋","text":"频年普庆国恩纡，再世疏荣品服殊。\n赤手向烦支半壁，苦心新得奠三吴。\n鲸波大海全消浸，麟阁中朝好画图。\n欲拟清风腾巷颂，野人何以贲吁谟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得五云多处是三台送许令公应朝","author":"孙继皋","text":"三台星朗五云鲜，万国朝正向九天。\n陛拥郎官元列宿，台书太史总非烟。\n玑衡望里祥光合，环佩声中瑞霭缠。\n曳履旧惭曾践斗，随君心到玉皇前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邢小槐户部","author":"余继登","text":"寒蝉吟落叶，凉秋忽已徂。\n鸿雁纷南飞，游子怀故庐。\n如何我故人，严装方戒涂。\n忆昔结殷勤，与子两相于。\n披心见情愫，慷慨意有馀。\n何以喻绸缪，譬彼双飞凫。\n天风起蘋末，同心而异趋。\n一凫厉羽翰，翱翔向天隅。\n一凫悲其群，翘首相鸣呼。\n岂无盈樽酒，迟子以须臾。\n对之不能饮，涕下沾我裾。\n会合知有时，柰此音徽疏。\n千里若比邻，斯言安得如。\n愿言加餐食，努力恢良图。\n上以报天子，下以慰离居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独酌","author":"余继登","text":"花下倒新篘，明月来相对。\n醉忘花影重，却疑月影碎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿米坤泉户侯七十米二子伯举武进士仲举进士","author":"余继登","text":"秦陇推名族，燕京领佽非。\n家贫缘爱客，宦薄为知机。\n旷达今谁并，寿年古亦稀。\n仙郎文武彦，榆景自光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿少司徒王见峰公七十公原以终养家居者","author":"余继登","text":"葵藿原倾日，桑榆转慕亲。\n祗缘寸草意，早乞老莱身。\n静久忘簪绂，情恬爱角巾。\n朝端曾让德，闾里尽归仁。\n参伯誇难弟，中丞有嗣人。\n无营神自王，不竞性弥醇。\n骏誉推三达，鹤龄始七旬。\n莫言今白发，遂尔厌红尘。\n世事多新态，君王忆旧臣。\n应知虚鼎席，伫见下蒲轮。\n致主心仍壮，匡时道益振。\n东山高卧起，曳履上星辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瀛洲亭对雨","author":"余继登","text":"五月苦炎热，瀛洲亭亦然。\n千林忽过雨，双溜看飞泉。\n萍翠无停梗，荷珠不定圆。\n新凉生坐席，庭草尽堪怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"短歌送廉庵之狄道","author":"余继登","text":"少年与君友，君气薄青云。\n胸藏六甲术，书著五千文。\n壮年慕君义，与君结婚姻。\n君志不得遂，坎坷难具陈。\n近日共君醉燕市，知君磊落犹如此。\n晚拜一官狄道丞，西去乡关数千里。\n前年敌骑入临洮，杀气惨淡阵云高。\n鬼火燐燐遍原野，至今谈者犹魂销。\n惟君闻之气转豪，壮怀直欲凌云霄。\n请缨宁肯让终子，大将或恐非嫖姚。\n送君行，饮君酒，丈夫金印须悬肘。\n马头皂盖且辉光，腰下吴钩正鸣吼。\n饮君酒，赠君诗，一语一杯君莫辞。\n金城迢迢在何处，日行日远遥相思。\n相思但望关山月，犹似长安对酒时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读史 其一","author":"余继登","text":"王孙昔未遇，垂钓在江干。\n腰下鹿卢剑，夜夜冲星寒。\n朝受丞相知，暮登大将坛。\n坛上隆准公，回席愿交欢。\n嗟哉绛灌徒，怒发自冲冠。\n拔城始授邑，捕寇方拜官。\n譬彼南溟翼，万里振羽翰。\n枋榆有斥鴳，抢地但仰观。\n世事良若斯，志士空长叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读史 其二","author":"余继登","text":"公孙年六十，犹是孝廉身。\n射策偶见收，遂为侍从臣。\n主爱诈亦忠，赫赫侯平津。\n长孺不解事，区区论积薪。\n淮阳久不调，壮志竟沉沦。\n空令千载下，为尔泪沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭泊阳王丈 其一","author":"余继登","text":"君是当年王子乔，忽乘鸾鹤上云霄。\n蓬壶自有神仙侣，空为英魂赋大招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭泊阳王丈 其二","author":"余继登","text":"湛湛清心玉不如，姓名蚤已荐贤书。\n可怜九待公车诏，依旧青衫未破除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭泊阳王丈 其三","author":"余继登","text":"与君偕计上燕台，裘马纵横亦壮哉。\n君志未酬今已矣，埙篪独奏不胜哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭泊阳王丈 其四","author":"余继登","text":"楼成白玉白嵯峨，欲借修文君柰何。\n回首乡园频洒泪，故人零落已无多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭泊阳王丈 其五","author":"余继登","text":"怪君日日拚沉醉，只爱沉酣不爱醒。\n今日浇君君醉否，悲风吹雨昼冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭泊阳王丈 其六","author":"余继登","text":"白马青袍事事新，君家兄弟更无伦。\n那堪一夜西风恶，鸿雁行中少二人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":21017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]