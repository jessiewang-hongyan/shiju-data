[{"title":"云山图为王廷实题","author":"刘泰","text":"溪沙白白树青青，溪上人家户半扃。\n渺漠寒云迷鸟道，瀰漫新水断凫汀。\n长竿我欲来垂钓，短锸谁招去采苓。\n梦寐未能忘旧隐，抗颜尘俗愧山灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29750,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观耕为徐景辉赋","author":"刘泰","text":"村村落落杏花风，起视耕夫绿野中。\n雨应双鸠田上下，犁随一犊路西东。\n暖分榆火晨炊妇，凉送壶浆昼馌僮。\n黾勉莫辞勤苦力，全家衣食在农功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29751,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄馀杭张景饶","author":"刘泰","text":"可是庞公懒入城，隐居无事乐閒行。\n埋头蠹简方成学，适意鱼竿岂钓名。\n山绕洞霄千朵秀，水来天目一支清。\n岁华冉冉春期近，应对寒梅感旧情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29752,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽阴阳正术沈克永","author":"刘泰","text":"相地占天两鬓皤，忽闻观化奈愁何。\n眼前故旧知心少，身后文章诔行多。\n庭院鹤鸣空夜月，江湖鸥散冷秋波。\n贤郎早受青囊诀，籍籍时名起浙河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29753,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贺隆竺昙住玛瑙寺","author":"刘泰","text":"玛瑙坡前古道场，上人高坐据猊床。\n麈谈佛法三乘妙，香祝皇图万岁长。\n夜永黄猿啼月色，春明白露点湖光。\n何时借我高层阁，饱看青山到夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29754,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冰雪轩为汪廷俊赋","author":"刘泰","text":"雪洁冰清色混融，开轩晏坐玉华中。\n掬波洗砚流澌白，扫絮烹茶活火红。\n夜半交辉惟皓月，春来解冻有条风。\n呼儿简点梅消息，已漏寒香在水东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29755,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贺法相寺住持海纳庵","author":"刘泰","text":"湖上招提信少双，翠微楼阁白云窗。\n耳闻古佛遗真像，眼见高僧竖大幢。\n衲挂紫藤惊鼠窜，钵分沧海毒龙降。\n怀香欲叩毗尼藏，寸莛临钟不易撞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29756,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贺张天锡生子","author":"刘泰","text":"兰房昨夜蔼祥氛，天锡佳儿自不群。\n一角白麟真有种，九苞丹凤岂无文。\n桑弧蓬矢阍人设，玉果犀钱座客分。\n试听啼声知国器，添丁谁说事耕耘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29757,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄费廷用","author":"刘泰","text":"幽人住处远尘嚣，境绝轮蹄逸兴饶。\n不饮市无赊酒券，能吟家有贮诗瓢。\n竹欹每见双仪凤，江近应闻两度潮。\n记得春时茶宴散，杏花斜日望仙桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29758,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄永庆寺达上人","author":"刘泰","text":"问讯江干白足僧，妙龄传得祖师灯。\n苦吟竹里肩山耸，晏坐萝间性海澄。\n染翰勇磨千锭墨，看云閒拄一枝藤。\n黄尘笑我劳行役，拟借清凉散郁蒸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29759,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚翠轩为叶景芳题","author":"刘泰","text":"隐君轩外有寒松，元是徂徕秀气钟。\n独立不倾风雨势，后彫能抗雪霜容。\n采花日暮防惊鹤，种子年深恐化龙。\n老去巳无丁固梦，掩关高卧绿阴浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29760,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"菊窗为郭应物赋","author":"刘泰","text":"窗外年来都种菊，葛巾藜杖足优游。\n青虫蠹叶疏疏雨，黄蝶迷花淡淡秋。\n把酒从教陶令醉，餐英不识楚臣愁。\n何时约我疏篱下，坐对南山共倡酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29761,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪庄为邬益之赋","author":"刘泰","text":"龙蛇深蛰鸟深藏，冻合乾坤雪满庄。\n昼暝可无风助势，宵明应有月争光。\n功誇李愬平淮策，兴切王猷访戴航。\n此际胸襟如洗瀹，行探春信野梅香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29762,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日偕友游梵天寺","author":"刘泰","text":"十载不登江上寺，旧栽松树拂云长。\n非因避俗来空刹，正爱谈玄坐石床。\n幡外日移双塔影，麈边风递杂花香。\n问僧谁作兹山偈，犹是前朝苏雪堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29763,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠学徒玑上人","author":"刘泰","text":"墨名儒行隐云林，门掩黄埃深复深。\n东鲁遗书多贮腹，西乾妙法早传心。\n一窗梅月清吟思，满院松风续梵音。\n浅学我非韩吏部，不劳文畅苦相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29764,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"一篷诗酒为王世祥赋","author":"刘泰","text":"诗兴翩翩酒兴豪，一篷吴下盛游遨。\n歌声激烈蘋风细，醉影欹斜柳月高。\n碧水鱼龙惊洗盏，白沙鸥鹭避挥毫。\n天才海量俱无敌，到处人人识锦袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29765,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初秋遣怀","author":"刘泰","text":"商飙一剪入帘帷，共说今年气候迟。\n桐子坠青惊旧梦，豆花含紫待新诗。\n囊空底用干元振，貌寝徒劳问客师。\n几欲登临看秋色，高僧未有白云期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29766,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵秋雨感怀","author":"刘泰","text":"积雨连朝天地阴，门前谁遣鹤轩临。\n寒摧砧杵残秋尽，老约头颅暗雪侵。\n黄偃一丛篱菊重，碧添三尺野塘深。\n腐儒无力鞭红驭，独抱时忧耿耿心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29767,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵九日登吴山","author":"刘泰","text":"良辰载酒不虚行，天拔胥山入凤城。\n簪菊莫嫌乌帽重，佩萸还喜绛囊轻。\n长风送雁秋逾净，斜日团鸦晚更晴。\n自幸登临无老态，漫扶双足放眸明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29768,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日登宝峰","author":"刘泰","text":"锦绣湖山画不如，良辰登眺驻肩舆。\n人生百岁苦难足，秋色一天清有馀。\n鹭散汀洲惊我啸，雁和霜露寄谁书。\n感时怀古愁无限，都仗金樽酒破除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29769,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雁荡秋风","author":"刘泰","text":"碧波凉冷雁来天，又报秋风一信传。\n淅淅绿彫初脆柳，萧萧红谢巳残莲。\n飘飏牧竖投村笛，断送渔郎入浦船。\n多少江湖倦游客，鲈鱼莼菜忆归田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29770,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日湖上 其一","author":"刘泰","text":"笙歌窟里无穷景，老我从游学少年。\n但信玉骢穿翠径，谁惊白鹭入苍烟。\n暖风欲飐簪花帽，春水初高载酒船。\n笑指涌金门外路，几时罗袂再重连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29771,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日湖上 其二","author":"刘泰","text":"西子湖头风日佳，春衣初试踏晴沙。\n长堤画舫依杨柳，小店青旗映杏花。\n笑里握阄机变化，狂边题句字欹斜。\n晚来不尽登临兴，一路莺声送到家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29772,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹林书屋为周宗秀作","author":"刘泰","text":"满林高竹荫苍苔，竹里藏修户半开。\n翠叶团光凝晓露，玉芽含味待春雷。\n地偏似与三湘接，诗好多邀二仲裁。\n闻道枝头有嘉实，九苞丹凤几时来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29773,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵廷用初夏写怀","author":"刘泰","text":"感时又过一年春，穆穆南薰霁景新。\n杨柳小园莺鷇早，荼蘼深院蝶来频。\n门无白纸催租吏，座有黄金买赋人。\n何幸生居尧舜世，湖山拟待老吾身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29774,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九月望日登宝峰次韵","author":"刘泰","text":"玉瓶载酒傍湖行，共指中峰劝我登。\n老去簪花羞雪鬓，倦来扶足喜霜藤。\n六桥客醉笙歌窟，三竺僧归紫翠层。\n晴好雨奇吟不尽，古今苏子擅才能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29775,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠下天竺衡上人","author":"刘泰","text":"芳年得度荷恩荣，圆顶方袍法苑英。\n天雨宝花修六忏，地存灵石悟三生。\n循岩鹿印春泥迹，倚树猿交月夜声。\n我亦相过曾借宿，蹋云亲送扫云迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29776,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日与客登馀杭寡山","author":"刘泰","text":"好风吹我上层峦，吴越江山画里看。\n独步青云酬夙志，群来白雁送新寒。\n诗袍夺锦才无敌，酒斝飞金量尽宽。\n却笑陶潜归去晚，空糜五斗缚微官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29777,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清芬书室为周德辉题","author":"刘泰","text":"一室能专静学功，炉熏不断火微红。\n砚池暖滴蔷薇露，书卷凉开茉莉风。\n郑圃无人知列子，汉庭有客荐扬雄。\n永怀燕寝凝香句，独许先生雅趣同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29778,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送钟钦礼还上虞","author":"刘泰","text":"豆花风起动归心，取别匆匆出武林。\n韫椟宁无求价玉，探囊剩有买山金。\n鸥边白雨敲秋点，鸦际苍烟结暮阴。\n会面偏难分手易，两情深似越江深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29779,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与客西湖行乐","author":"刘泰","text":"湖西山水名天下，有客乘春作胜游。\n白骑踏花银络脑，青娥舞雪锦缠头。\n幡幢影里高低寺，弦管声中远近楼。\n如此风光莫虚度，人生只合老杭州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29780,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日与客登宝峰","author":"刘泰","text":"踰湖秋晚上方游，兰棹遥停白鹭洲。\n云破觚棱金雀现，雨馀涧水玉虹流。\n紫檀爇鼎僧延款，绿醑浮杯客献酬。\n醉后陶然忘荷锸，疏狂我亦晋时刘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29781,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泛湖值雨简费廷用","author":"刘泰","text":"湿云遮断好峰峦，斗酒呼来且尽欢。\n养鸭人家春水满，落梅天气午风寒。\n君醒陡觉衣裳薄，我醉宁知宇宙宽。\n閒却银筝多少曲，红楼船上几时弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29782,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西湖秋泛为费宗裕题","author":"刘泰","text":"湖水㴠秋分外清，兰舟荡漾入空明。\n香消冷瓣红蕖坠，雪飐晴丝白鹭惊。\n老眼看山聊舣棹，小鬟催酒不停筝。\n胜游岂独坡仙辈，落日西风无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29783,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宴集次费宗裕韵","author":"刘泰","text":"涌金门外新亭好，得共群贤尽日娱。\n白藕褪花秋欲近，绿筠交叶暑全无。\n衣浮爽气龙收雨，镜破澄光鹭点湖。\n回首凤城扶醉入，漏声催晚急铜壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29784,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴山看雪呈郁士端","author":"刘泰","text":"天人剪水落云端，直上危坡纵远观。\n万竹无声银凤立，千峰有势玉龙蟠。\n已将奇事占麰麦，更揽清华入肺肝。\n谁倚东风吹短笛，梅花初放不禁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29785,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖曲行春次沈用滨","author":"刘泰","text":"巾子峰头葛岭西，盘回白石净无泥。\n莺吭暖送春声滑，鹭翅晴翻雪影低。\n红瘦岩花飘满路，绿肥湖水受诸溪。\n大家留取金钱百，拟约明朝酒再携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29786,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日游宝峰分得秋字","author":"刘泰","text":"共买肩舆郭外游，登高快我豁吟眸。\n天包沧海欲穷处，人立青山最上头。\n万木总含霜露气，一壶浑遣古今愁。\n南来新燕斜成字，写出西风澹澹秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29787,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次聂大年游净慈寺","author":"刘泰","text":"步联苔蹬翠层层，方外幽寻我最能。\n虎视不惊团射客，鸥閒常送过湖僧。\n支那蹋遍无双寺，临济传来有一灯。\n话久顿忘饥渴想，诗怀清似玉壶冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29788,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏东坡赤壁图","author":"刘泰","text":"黄州迁客气如虹，夜放扁舟吊两雄。\n东下火攻吴卒锐，北来阵战魏师空。\n白沙折戟荒凉外，绿酒芳樽感慨中。\n烂醉不知天地老，江流终古浩无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29789,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏芙蓉","author":"刘泰","text":"一树临秋水，红颜美少年。\n开迟君莫怨，犹在菊花先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29790,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏燕","author":"刘泰","text":"解补梁间垒，能寻花下门。\n春来与秋去，莫负捲帘恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29791,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访友人张仁厚","author":"刘泰","text":"乘閒访隐君，黄叶路斜分。\n惊犬知生客，穿篱吠白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29792,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题雪竹","author":"刘泰","text":"雪霁湘川绝点埃，冷枝寒叶脆难开。\n舜妃昨夜游何处，骑得翩翩白凤回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29793,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚景便面为沈仲明作","author":"刘泰","text":"上方楼阁隐烟霏，风递钟声出翠微。\n隔水冷霞红不散，残光斜照两人归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29794,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小景 其一","author":"刘泰","text":"隔岸峰峦过雨新，桃花水暖碧潾潾。\n谁家艇子閒来往，只载春光不载人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29795,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小景 其二","author":"刘泰","text":"绿树阴阴覆野亭，绿波漾漾没沙汀。\n短藜记得寻幽处，一路莺声酒半醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29796,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小景 其三","author":"刘泰","text":"云溪一带净无沙，门对青山是我家。\n两日不来亭子上，东风开过紫藤花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29797,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"红梅翠竹","author":"刘泰","text":"罗浮仙子访湘君，翠袖涓涓映茜裙。\n江月半痕归去晚，玉容春透酒微醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29798,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"芭蕉","author":"刘泰","text":"翠怯春寒叶未高，玲珑石畔托根牢。\n晓来记得题新句，露湿先生紫兔毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29799,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清溪放棹图","author":"刘泰","text":"溶溶新水碧於苔，风静菱花几个开。\n小艇不知何处客，载将秋色过溪来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29800,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"横笛图为卢宏景题","author":"刘泰","text":"矗矗峰峦过雨新，暖风吹绿半溪蘋。\n从来不识尘劳事，输与船头弄笛人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29801,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杏花画眉","author":"刘泰","text":"粉红花放满枝春，嫩色柔香过雨新。\n啼鸟一声庭院晓，隔窗催起画眉人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29802,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"鼓琴图","author":"刘泰","text":"不向王门作从伶，独横焦尾坐云汀。\n钟期老去知音少，弹与秋江白鹭听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29803,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春溪放棹图","author":"刘泰","text":"淡淡春风作嫩晴，柳条金软未胜莺。\n何人点破春溪色，载酒来寻白鹭盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29804,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日同项宗彝蒋文伟赋","author":"刘泰","text":"湖上韶光似酒浓，踏花重觅旧游踪。\n东风知我看真景，轻约春云过两峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29805,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"约苏文定泛湖","author":"刘泰","text":"西湖山色两清奇，况是梨花酒熟时。\n整顿兰舟载春去，莫教鸥鹭笑来迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29806,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题芍药","author":"刘泰","text":"绿阴庭院巳非春，红药翻阶露朵新。\n绰约娇姿谁得似，天风吹下卫夫人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29807,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋葵","author":"刘泰","text":"露华闪闪照秋林，谁把红芳暗博金。\n白露不凋霜不剪，也知中有向阳心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29808,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"墨菊","author":"刘泰","text":"自是中黄第一家，雁来时节傲霜华。\n如何秋色无人管，移向龙泉道士家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29809,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄吴百户东升","author":"刘泰","text":"墨花香满砚池头，尽说能书老户侯。\n顾兔分毫迟授管，冷金纸上字双钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29810,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上诸作 其一","author":"刘泰","text":"峰峦远近玉崔嵬，竹压柴门午未开。\n卧拥青绫迎送懒，洛阳县令不须来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29811,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上诸作 其二","author":"刘泰","text":"晓来冰柱结檐牙，篱外疏梅破一花。\n铁箸自挑黄独火，苦吟谁识老刘叉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29812,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上诸作 其三","author":"刘泰","text":"岁晚滕神故作威，剪冰裁玉不停飞。\n痴儿禁得双骹冷，独立梅边待鹤归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29813,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上诸作 其四","author":"刘泰","text":"断冰漾漾立閒鸥，偶尔看山到渡头。\n浊酒一壶随处醉，老夫不典鹔鹴裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29814,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上诸作 其五","author":"刘泰","text":"登楼四望白模糊，直北天高是帝都。\n想得征西貔虎士，玉门关外破匈奴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29815,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上诸作 其六","author":"刘泰","text":"东家酒熟纻旗悬，费尽床头子母钱。\n贵贱交游元不少，夜深谁泛剡溪船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29816,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上诸作 其七","author":"刘泰","text":"白战诗成砚己冰，案头饥鼠乱窥灯。\n支离瘦影跏趺坐，好是人间戴发僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29817,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上诸作 其八","author":"刘泰","text":"随风杂霰落萧骚，破屋难禁一尺高。\n翻忆少年歌舞梦，美人金盏进羊羔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29818,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪中登楼望湖上诸作 其九","author":"刘泰","text":"梦骑白凤挟飞仙，下视齐州九点烟。\n赋就晓寒残月里，觉来忘却衍波笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29819,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]