[{"title":"山枣驿夜坐","author":"严嵩","text":"溯岭路岐仍渺渺，拍林风雨更朝朝。\n清溪傍竹听萧瑟，小驿燃灯坐寂寥。\n湘浦叶飞惊岁晚，钤山家在忆书遥。\n垂垂一树梅花白，赖尔能将旅思消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兴安县 其一","author":"严嵩","text":"兴安城郭枕高丘，湘漓水分南北流。\n万里桥头风雪暮，不知何地望神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兴安县 其二","author":"严嵩","text":"破屋古松喧夕籁，远峰寒雾起层阴。\n梅花两岸漓江水，岁晚相随到桂林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白竹铺","author":"严嵩","text":"午饭车停白竹铺，寒旌马度黄茆冈。\n江分二水湘漓外，路绕孤城雨雪傍。\n峦洞云霞隐僻绝，野田松竹连青苍。\n遥看溪嶂怜佳境，却畏风烟叹异乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公安何公大古令睢宁有致雨灭蝗瑞麦三异政令子方伯君廷佩请予赋诗","author":"严嵩","text":"中牟循吏绩，江陵长者言。\n如闻何令事，不愧古人贤。\n为政宁求异，躬行可格天。\n棠留睢水上，碑照岘山前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"两广大都宪杨公母夫人寿词杨太师文敏之孙也","author":"严嵩","text":"中丞绣斧移南粤，寿母霞觞宴北堂。\n贞史百年刊阃范，相门三世引书香。\n祥晖映海扶桑近，春色临阶玉树长。\n何止庭闱奉牲鼎，待看勋业在旂常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太府宴","author":"严嵩","text":"峰攒锦石当轩秀，雾隐晴花拂槛高。\n鼓角声中催送酒，松杉影里借挥毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"官署梅花一株盛开","author":"严嵩","text":"只怪幽香生别院，不知春色在南枝。\n绕树百回吟看汝，天南日暮酒醒时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题双松卷","author":"严嵩","text":"庭中双松树，柯叶何青青。\n岁晚岩居子，相期来斸苓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋胡明府归乐堂","author":"严嵩","text":"燕粤风埃万里馀，羊肠历尽始回车。\n竹泉萝月皆幽事，桂岭星岩仍故庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喻大行宗之静藩祭葬别赠","author":"严嵩","text":"宗藩勤恤典，汉使下彤墀。\n云捧青霄节，山开碧殿祠。\n桂江题句胜，藤浦系舟迟。\n闻有慈帏别，重歌四牡诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晨观风洞登叠綵楼历拱辰亭亭为镇守傅中贵所创岩峦奇耸千里在目诸巡院有诗予辄次韵是日介行登赋不尽兴也 其一","author":"严嵩","text":"孤亭绝嶂倚南天，碧树苍崖共莽然。\n八桂云山供作赋，群公尊俎坐筹边。\n严城鼓角传清曙，落日帆樯出断烟。\n王事未能穷胜览，北风摇楫下湘川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晨观风洞登叠綵楼历拱辰亭亭为镇守傅中贵所创岩峦奇耸千里在目诸巡院有诗予辄次韵是日介行登赋不尽兴也 其二","author":"严嵩","text":"苍茫寒雾起遥天，岁晏凭高思渺然。\n夜发仙槎南斗外，春瞻御座綵云边。\n湘源水色浮晴雪，桂岭花枝拂瘴烟。\n莫怪题诗惜幽赏，子长奇兴在山川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题风洞","author":"严嵩","text":"宁知岩洞古，平临阛阓中。\n梵阁开丹鹫，仙梯蹑彩虹。\n遥峰晴吐雾，阴磴静含风。\n安能赋招隐，来扳幽桂丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题虞山庙","author":"严嵩","text":"重华千载后，遗庙在南夷。\n弦想薰风奏，庭思凤鸟仪。\n断碑苔藓合，幽洞薜萝垂。\n髣髴移仙驾，乘云度九疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虞山宴别 其一","author":"严嵩","text":"山隐韶音洞，江横舜帝祠。\n旌旄勤出饯，岩石借题诗。\n客路春梅色，湘洲碧草辞。\n都忘去程暮，留赏更传卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虞山宴别 其二","author":"严嵩","text":"赠言纷授简，祖席迥临城。\n奉使怜遐域，群公荷别情。\n漓波经地险，桂树向冬荣。\n胜会知难再，相思一寄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮次灵川怀寄大参师舜宪副天益二乡丈 其二","author":"严嵩","text":"他乡相见故人稀，听唱骊歌欲湿衣。\n数酌犹临碧水坐，两舆空指暮林归。\n池台月浸薇堂影，绣斧霜传桂岭威。\n长路题书祝餐饭，壮图勋业莫相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕全州少司徒梅轩蒋公邀集少傅敬所公之兄也致政宫傅张公泾川在座有诗次韵二首 其一","author":"严嵩","text":"除日他乡倍忆家，聚星高会转宜誇。\n能堪黄阁留宾席，正赖清尊遣岁华。\n青蕙色淩阶下雪，玉梅香破腊前花。\n烟霜旅棹催晨发，已报春风动水涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕全州少司徒梅轩蒋公邀集少傅敬所公之兄也致政宫傅张公泾川在座有诗次韵二首 其二","author":"严嵩","text":"台阁勋名重帝家，不因荣盛有矜誇。\n那知守岁逢椒颂，却喜登堂咏棣华。\n吟就谢池怜梦草，醉归唐苑忆看花。\n履端更有明朝庆，皇泽春阳总未涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元旦全州行庆礼","author":"严嵩","text":"燎火通宵设，轩车拂曙来。\n星随双节动，雪映百廛开。\n圣寿齐嵩华，春阳遍草莱。\n翠华天北极，应指塞垣回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日燕宫傅泾川公第用韵 其一","author":"严嵩","text":"午桥来访晋公家，重德高名岂浪誇。\n开径竹松便逸隐，登堂山水占清华。\n宜春总换桃符帖，趁俗先传彩胜花。\n愿借柏觞增五福，直从沧海咏无涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日燕宫傅泾川公第用韵 其二","author":"严嵩","text":"碧潭青嶂绕千家，风景真堪对客誇。\n海内衣冠尊洛社，天南旌节驻皇华。\n春从阴谷潜回律，雪应丰年密宱花。\n他日胜游那可再，系帆重醉粤江涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拜詶泾川公见赠","author":"严嵩","text":"曾随玉署瞻先达，愧谒龙门已后时。\n往事殷勤劳晤语，非才流落负心知。\n湘山夜雨留觞久，漓浦春波放棹迟。\n别后双鱼难定觅，但吟佳句一相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发湘江","author":"严嵩","text":"人日移舟湘水岸，东风吹浪散寒阴。\n城边柏叶留春酌，沙际沧浪清客吟。\n咽村小径通渔浦，石壁回溪映竹林。\n时向舟人问佳境，前程几处费登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石期驿逢李明府","author":"严嵩","text":"清苦东安令，心期得共论。\n官看铜绶贵，贫惜布袍温。\n野树依峦嶂，春江对驿门。\n天涯一携手，风雨送离尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早霁与计使君泛湘江遂登望岳亭观武侯庙新成 其一","author":"严嵩","text":"倚棹江天豁，移尊草阁幽。\n到窗分岳翠，当槛泻烝流。\n春至花经眼，秋深月满楼。\n使君时对客，诗兴绕沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早霁与计使君泛湘江遂登望岳亭观武侯庙新成 其二","author":"严嵩","text":"川接烝湘会，城临栋宇开。\n武侯今寂寞，公为扫莓苔。\n世远怀龙卧，江春识雁回。\n天涯山水郡，落日进馀杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予少孤多病恒有忧生之嗟今年四十矣日月于迈禄不逮养学未有闻使经衡山适遘初度矢痛申情爰成兹咏焉 其一","author":"严嵩","text":"婉娈为童子，父母不暂离。\n出门十顾望，恒恐儿寒饥。\n受气素薄弱，既长犹尪羸。\n多疢贻亲忧，焉保黄发期。\n庸知四十载，老大生须髭。\n中朝玷荣禄，出使万里归。\n公厨饭白粲，文锦褰华衣。\n衣食岂不美，亲养弗可追。\n初度临兹辰，怆恻有馀悲。\n海波逝莫回，悲伤竟何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予少孤多病恒有忧生之嗟今年四十矣日月于迈禄不逮养学未有闻使经衡山适遘初度矢痛申情爰成兹咏焉 其二","author":"严嵩","text":"饬驾辞桂岭，弭棹越江湘。\n我行几何时，巳涉万里疆。\n万里岂漫游，王命肃所将。\n咨询遍原隰，登眺穷崖冈。\n闻昔太史公，足迹好瑰奇。\n东游探禹穴，南浮踰九疑。\n山川激壮气，一以昌文章。\n赧予诚薄陋，怀古意慨慷。\n男子始生朝，弧矢悬门堂。\n眷言四方志，岂必怀故乡。\n眷彼孤黄鹄，矫翮云天翔。\n啾啾茅檐下，燕雀空榆枋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予少孤多病恒有忧生之嗟今年四十矣日月于迈禄不逮养学未有闻使经衡山适遘初度矢痛申情爰成兹咏焉 其三","author":"严嵩","text":"弱龄不量力，高视慕前俦。\n学道思理人，洗心念寡尤。\n奄忽踰四龄，此志但悠悠。\n聪明异前时，行业不加修。\n抱册时呻吟，宁免遗忘忧。\n雕虫技何补，食粟颜堪羞。\n中夜起长叹，反躬时内省。\n宣父戒无闻，漆雕惭未信。\n勋业弗及时，白发忽生鬓。\n嗟彼万里道，中途可旋轸。\n愿言加餐饭，努力桑榆晚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归次醴陵","author":"严嵩","text":"悠悠驻双骑，翼翼抗前旌。\n云物媚清旦，山水映孤城。\n平野楚烟碧，高峰松雪明。\n客愁浑欲失，巳入故乡程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慧力寺","author":"严嵩","text":"古道苍松转，重洲碧水连。\n桥传伏马地，台忆读书年。\n客舫平沙倚，禅灯夕嶂悬。\n驰驱愧尘鞅，栖息叹何缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"移疾慧力方丈呈郡中诸君子 其一","author":"严嵩","text":"城市谁能此地游，石堂禅榻借深幽。\n藤萝月上诸峰静，楼阁风回古木秋。\n病身偶似维摩室，客思应同王粲楼。\n巳惜浮萍自流转，却扳丛桂更淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"移疾慧力方丈呈郡中诸君子 其二","author":"严嵩","text":"漫怀陶谢与同游，怅惜青山古寺幽。\n江县羽书频报警，石门萝薜自宜秋。\n孤城片月闻吹角，落日千峰对倚楼。\n潇水驿亭舟楫地，异时尊俎记相留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"不寐","author":"严嵩","text":"羽檄连宵至，徵兵列郡闻。\n乾坤遂戎马，云日更炎氛。\n食禄宁辞难，临危好策勋。\n灯残僧阁夜，孤枕百忧纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜至太平观 其一","author":"严嵩","text":"暝色山径入，钟声林杪来。\n道人惊客至，烛下松门开。\n瑶席凝芳篆，琳馆绝浮埃。\n尘襟藉消豁，天明车骑催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜至太平观 其二","author":"严嵩","text":"群仙朝上帝，高居俨太清。\n玉池泉不涸，玄圃树长荣。\n剑作苍龙跃，笙同彩凤鸣。\n倘因值灵药，此地问长生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈节推久在南昌寄赠","author":"严嵩","text":"郡阁萧条昼掩扉，窗中林岫待玄晖。\n东湖亦是桑乾水，应望袁山日忆归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈侍御原习","author":"严嵩","text":"木落岁年晚，空江忽到公。\n世途千辙异，高论一尊同。\n怀玉幽人志，缨冠国士风。\n重溟隔南纪，瞻望渺行骢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郡内逢春","author":"严嵩","text":"春日春台宜引望，万家城郭庆春新。\n彩幡花胜巧随俗，柏叶梅枝清傍人。\n离离雪树开晴旭，冉冉风烟度野津。\n还沾郡邸宾筵醉，转觉乡园物候亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卢洲宴集值雨赠罗使君","author":"严嵩","text":"名园邀客绿尊开，红旆行春五马来。\n江迥波声喧几席，山寒雾色隐楼台。\n庭中翠荫延修竹，林下幽芳折老梅。\n为报青阳布新令，满城甘雨使车回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过双龙寺","author":"严嵩","text":"入谷岚霏重，开门松寺深。\n滩流万木罅，萝拥众峰阴。\n溪鹭仍寒浴，潭龙或夜吟。\n楚地多风雨，春山不可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山行赠仁甫 其一","author":"严嵩","text":"万峰云度壑，孤寺雨鸣溪。\n马渡溪前水，疑怜锦障泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山行赠仁甫 其二","author":"严嵩","text":"共宿东窗中，下宵雷雨闻。\n风尘迟双剑，好为拭龙文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄仁甫","author":"严嵩","text":"篁木翳深岭，独行千嶂间。\n溪山正奇绝，霖潦倦跻攀。\n闻子渡前壑，日暮临河还。\n相思阻幽梦，一夜雨潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题黄氏池亭","author":"严嵩","text":"黄生池阁清，独宿怡我情。\n高窗延雾色，曲涧绕泉声。\n邻里閒能过，鸥鱼近不惊。\n永学溪中钓，宁求世上名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨望","author":"严嵩","text":"高楼集飞雨，半入空濛间。\n梅痕低映水，草阁暝依山。\n境寂浑饶睡，杯深忽破颜。\n五岭愁难望，烟中凝翠鬟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠张秀才","author":"严嵩","text":"吾爱张明府，承家不乏贤。\n芳兰临谢砌，白璧照蓝田。\n暮雪明书幌，春莺对别筵。\n天池待鸣凤，綵翼看腾骞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日游石乳洞 其一","author":"严嵩","text":"跻险遘灵室，赏胜得仙溪。\n紫泉飞作雨，玉髓积如泥。\n暂驻心魂爽，重寻岩径迷。\n拟结丹霞想，来从静者栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日游石乳洞 其二","author":"严嵩","text":"地隐林峦秀，春馀草木芳。\n古岩宜置酒，清溜忽沾裳。\n有象名难具，无言趣转忘。\n未云欢赏罢，歌吹送残阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游洪阳洞","author":"严嵩","text":"二仙何代隐岩阿，涧绿山青长薜萝。\n尘世总经桑海变，丹丘长占水云多。\n天台到拟逢桃实，石室归疑烂斧柯。\n思向此中寻静侣，因牵俗累欲如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"彬江罗使君宴别","author":"严嵩","text":"乳洞初旋盖，邮亭复此筵。\n夜歌临浦月，春赏寄云泉。\n宾从滁山醉，风流岘水传。\n所嗟牵远役，安得重延缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"师俭堂","author":"严嵩","text":"山泉野饭聊今夕，金谷铜驼非故时。\n随缘自有数椽足，题俭真成一字师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"双溪","author":"严嵩","text":"宛似名山入武溪，花源仙艇记还迷。\n春圃剪蔬逢客至，午窗丸药听莺啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题龙封君颐贞卷","author":"严嵩","text":"学道人未识，端居遗俗纷。\n云龟导真息，玄豹养深文。\n履坦自多吉，逃名世却闻。\n当时读易处，幽室洒兰芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萧氏凤山别业","author":"严嵩","text":"卜筑傍幽深，烟霞费远寻。\n窗喧石涧水，槛落翠峰阴。\n巢鹊依新主，溪花发故林。\n应招白云侣，终日伴閒吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郡学罗守新肄乐请予观赋","author":"严嵩","text":"朅闻金丝奏，洋洋黉舍中。\n迹类观周庙，神疑游泽宫。\n徵师来独远，享圣礼攸崇。\n兹郡惭遐僻，居然邹鲁风。\n伟哉贤守化，不羡蜀文翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阅武亭置酒","author":"严嵩","text":"山拥宾筵翠，城围将垒高。\n霜天清鼓角，云日丽旌旄。\n箭迅穿鸿鹄，杯香擘蟹?。\n取醉自兹别，临岐赠宝刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓登春台 其一","author":"严嵩","text":"楼阁山寒里，肩舆冲晓来。\n仲冬群木下，初日万峰开。\n平野何寥邈，层城亦壮哉。\n予心慕奇胜，欲别更登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓登春台 其二","author":"严嵩","text":"山暝烟岚合，城高睥睨齐。\n攀跻兴不极，旷望意还迷。\n风壤荆吴际，星文翼轸西。\n遗祠深木里，来客拜昌黎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33497,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和唐侍御晚登春台","author":"严嵩","text":"春台夕上兴犹奇，落木苍苍白日迟。\n行傍径梅诗自好，坐看松嶂榻频移。\n江城揽辔霜威迥，山阁开尊月色宜。\n莫为浮云望天际，恐增愁思倚阑时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33498,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓登春台用韵","author":"严嵩","text":"翠岭烟开楚望奇，绿江天尽鸟飞迟。\n松彬覆郭泠风起，楼阁当空淑景移。\n岩树故因时序改，山云岂与俗情宜。\n双峰寂寂应相对，怅忆高人独往时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33499,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惠上人房","author":"严嵩","text":"绝壑闻流水，香床住半天。\n林间飞盖入，松下看云眠。\n谷鸟知春候，昙花识静缘。\n冥心遗所适，岂必定中禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33500,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏夜府公辱过","author":"严嵩","text":"山月照庭际，如传松桂神。\n到门银烛远，当席锦袍新。\n自惜迂疏旧，多惭宠顾频。\n荒居寡承奉，小酌愧情真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33501,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬罗使君仰山之招","author":"严嵩","text":"开缄见月生幽思，清晓雨声翻屋来。\n千峰古木啼猿处，空忆题诗坐石苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33502,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]