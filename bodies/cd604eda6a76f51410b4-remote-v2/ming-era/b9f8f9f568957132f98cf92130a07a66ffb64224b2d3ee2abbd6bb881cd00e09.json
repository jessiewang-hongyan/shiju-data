[{"title":"即事","author":"吴与弼","text":"环堵萧然隔世尘，日长惟有简编亲。\n青衿髦士时能访，出处谆谆话古人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9315,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓起即事","author":"吴与弼","text":"人心秉至灵，胡为自狼狈。\n十年磨一镜，渐觉尘埃退。\n清晓旭日升，竹树欣相对。\n欲记丹青图，斯意恐难会。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9316,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黄广文为仆趣装","author":"吴与弼","text":"客子去莫留，故人情不浅。\n离合焉足论，事业宜加勉。\n恒令此志存，会见长材展。\n贤圣以为师，任重而道远。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9317,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黄广文城外送别","author":"吴与弼","text":"迢递步暑来，高情重为别。\n匆匆话莫穷，努力男儿节。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9318,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿渐岭","author":"吴与弼","text":"漠漠暮林横绿野，澄澄秋水映红云。\n远来客舸依沙岸，独犬一声何处村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9319,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赤壁怀古","author":"吴与弼","text":"今日题诗处，明朝迹又尘。\n不知江汉水，流尽几多人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9320,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大冶山中","author":"吴与弼","text":"客路逢人问，前程去已迷。\n唤回琴剑侣，斜度小桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9321,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重访盛山人","author":"吴与弼","text":"舍馆曾留宿，园林今更过。\n米嫌秋熟少，苗叹雨伤多。\n寄远书应达，移居事若何。\n秋风凉冷后，有待碧山阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9322,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢家埠舟中即事","author":"吴与弼","text":"忆昔扁舟久寓居，客中风景自能摹。\n重来几换人间节，佳兴如今却胜初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9323,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次梅根","author":"吴与弼","text":"风色萧萧生暮寒，月明催棹下奔湍。\n孤舟系稳更相劳，又得长江一日安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9324,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中即事","author":"吴与弼","text":"缃帙收来霜夜分，月中犹见打鱼人。\n始知各有平生分，勤苦方能立此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9325,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荻港舟中","author":"吴与弼","text":"寒芦漠漠夜澄澄，云尽霜天月倍明。\n欲问个中深浅兴，青灯孤映读书声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9326,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟次芜湖寄友","author":"吴与弼","text":"地迥天清芦雁呼，西风残照泊芜湖。\n远书不尽悠悠意，努力人间大丈夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9327,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"述怀","author":"吴与弼","text":"平生踪迹惯飘蓬，短棹从教西复东。\n借问乡园从别后，一旬清思属中庸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9328,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"偶述","author":"吴与弼","text":"十年勤苦学求仁，品汇纷纭未识真。\n惟有一般堪自笑，行藏酷过古人贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9329,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中观书忆诸生","author":"吴与弼","text":"灯火夜常半，工夫日又新。\n滥追先进躅，频忆故山人。\n冻竹那妨雪，寒梅自有春。\n此生何处达，天地即吾仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9330,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别史仪部","author":"吴与弼","text":"清誉闻来熟，高情交更深。\n青灯连夜话，黄卷百年心。\n斯道何难入，深功贵自任。\n匆匆惭赠纻，惆怅托狂吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9331,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别李凤仪","author":"吴与弼","text":"途逢浑似梦，惊定始开襟。\n万里又分袂，几时重盍簪。\n诗书仍努力，穷达莫殊心。\n邈尔云山外，频频忆旧吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9332,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访叶别驾","author":"吴与弼","text":"消息犹难得，逢迎更敢期。\n宁知为客际，重悉久要辞。\n剪烛嫌更短，连床愿别迟。\n欲投迂阔分，舍此复何之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9333,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠丁太常","author":"吴与弼","text":"别驾侨居处，频过不觉疲。\n喜通仪部好，更辱太常知。\n贱子惭何算，明公贵有为。\n圣途如指掌，努力妙年时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9334,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿黄茅潭隔港","author":"吴与弼","text":"日夕北风起，停桡未有涯。\n横江欣得伴，和月宿芦花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9335,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"偶述","author":"吴与弼","text":"欲遵君子业，名教贵昭融。\n能事参天地，元基慎独功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9336,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"板桥客夜","author":"吴与弼","text":"达得浮生去住轻，江楼遇夜旅魂清。\n远书作罢孤灯静，霜月凄凉雁数声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9337,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除日书怀","author":"吴与弼","text":"一岁生涯不离书，明年行止更何如。\n男儿挺拔今犹古，百倍工夫正属渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9338,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夜次唐人诗韵","author":"吴与弼","text":"青灯幽户照无眠，高兴吟哦正浩然。\n一岁平安私自幸，进脩踊跃入新年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9339,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西轩即事","author":"吴与弼","text":"冻消残雪早春回，幽户条风任往来。\n黄卷玩馀閒卧后，满窗春色数枝梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9340,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观梅","author":"吴与弼","text":"梅花满眼感怀新，正月俄惊十日春。\n花落更开开更落，小窗忙杀读书人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9341,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬友人 其一","author":"吴与弼","text":"物物由来根太极，等閒那得识其真。\n浮生三十端虚度，扰扰俱为梦里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9342,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬友人 其二","author":"吴与弼","text":"贫居尽日掩柴关，黄卷青灯不敢閒。\n克己转知前日妄，希贤愈觉古人难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9343,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"感兴","author":"吴与弼","text":"浮生岁月易蹉跎，交谊知心苦不多。\n几欲开怀难觅伴，只应怀古独高歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9344,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠黄经历先生","author":"吴与弼","text":"竹屋长无雁，花封偶盍簪。\n雨窗宵并榻，雪案昼同吟。\n往事浑如梦，清欢暂称心。\n明朝踏晴色，归思各云林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9345,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题琴乐轩","author":"吴与弼","text":"花县东南里巷深，高轩清乐属瑶琴。\n绿阴帘幕閒中世，明月阶除静里心。\n松韵正幽孤鹤唳，海涛初定老龙吟。\n山中亦有无弦趣，茅屋何时肯一寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9346,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦亲","author":"吴与弼","text":"夜夜春天梦，依依只在亲。\n山中有茅屋，何日溯归津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9347,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题三友图","author":"吴与弼","text":"桃李春晴锦万堆，萧然谁数竹松梅。\n不因处士开新画，雪里何从表异材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9348,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"严亲寄家谱至","author":"吴与弼","text":"门外欢声送喜来，天边家谱到山开。\n音尘已隔半年后，乐极犹疑是梦回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9349,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南轩夜坐","author":"吴与弼","text":"庭前诗已成，云间月未没。\n入户启南轩，无拘转真率。\n草木发天香，遥夜清人骨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9350,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉寄黄浩中先生","author":"吴与弼","text":"十年两度侍西轩，细语倾心夜不眠。\n浮世别离疲野马，几回怀古独云天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9351,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月夜","author":"吴与弼","text":"迢迢良夜月澄秋，万象清严风露幽。\n安得人心亦如此，廓然欲尽理周流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9352,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅竹轩","author":"吴与弼","text":"莲塘南畔碧山连，梅竹幽深着小轩。\n接席好风晴满径，隔帘香雪夜浮天。\n题诗兴绕赓歌际，读易心游未画前。\n佳致几时期我共，为君细和白云篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9353,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暂宿新居","author":"吴与弼","text":"青山白云里，旷然露平陆。\n峰峦森远近，涧溪罗屈曲。\n辛丑杪秋中，相基蒙吉卜。\n明年闰月冬，于焉结新屋。\n癸卯建未初，移居遂所欲。\n藩篱虽未稠，斗室聊自足。\n露坐天宇凉，语笑偕僮仆。\n共想古昔来，谁人此曾宿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9354,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东轩即事","author":"吴与弼","text":"公事缠弥旬，寸心靡敢放。\n岂惟学古难，人欲诚易荡。\n昨宵拟见官，风雨不成往。\n偶此东窗下，暂然閒俯仰。\n遍阅旧时吟，静思新志向。\n疑似寔自蒙，伊谁一指掌。\n洙泗迹既陈，洛闽且绝响。\n安得同志人，灵台期共养。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9355,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十一月朔旦枕上作","author":"吴与弼","text":"立志成人自稚年，中间卤莽实堪怜。\n如今转觉人须学，截日严程造白坚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9356,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夕","author":"吴与弼","text":"慷慨临除夕，蹉跎又见春。\n一年非不学，何日是成人。\n经事才还广，潜心理渐真。\n微吟增感激，名教定书绅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9357,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"伤农家","author":"吴与弼","text":"秋谷应多减，春炊固转艰。\n频闻寒雨里，采蕨满深山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9358,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十二月十四日绝句 其一","author":"吴与弼","text":"弊庐风雨何曾蔽，衣食田园给更悭。\n积病寒窗尘满眼，始知无怨实为难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9359,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十二月十四日绝句 其二","author":"吴与弼","text":"始知无怨实为难，至乐谁如孔与颜。\n误把古人轻易看，精脩从此可容閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9360,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十二月十四日绝句 其三","author":"吴与弼","text":"精脩从此可容閒，勘破当年义利关。\n随处动心兼忍性，何忧不到古人班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9361,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十二月十四日绝句 其四","author":"吴与弼","text":"何忧不到古人班，只把遗经子细看。\n学久自然查滓化，心斯广矣体斯胖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9362,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"惧衰","author":"吴与弼","text":"少壮空缠疾病过，光阴况复迅如梭。\n蹉跎容易入衰境，此德此身将奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9363,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寒疾未醒兼困于疮废书默咏朱子及陆象山兄弟鹅湖倡和诗僭次其韵","author":"吴与弼","text":"先哲高风悉所钦，考亭朱子益留心。\n沧溟浩浩吞诸水，泰华巍巍失万岑。\n理极研精无窔奥，形纯践履更深沉。\n微躯每恨生来晚，空慕声容隔古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9364,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夜","author":"吴与弼","text":"一年程课更如何，轻薄还因感慨多。\n明日又逢新岁月，几时能出旧巢窠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9365,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元日","author":"吴与弼","text":"回首流年一梦间，静思身世立应难。\n工夫百倍须深勉，莫把光阴当等閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9366,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"正月十九夜枕上作 其一","author":"吴与弼","text":"自叹生来后圣贤，下流入道苦难前。\n何由养得中和性，乐以忘忧理浑然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9367,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"正月十九夜枕上作 其二","author":"吴与弼","text":"乐以忘忧理浑然，后生岂易造斯言。\n敛然下学无他法，一味深功克性偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9368,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书所得","author":"吴与弼","text":"荆棘场中二十年，中间回首实堪怜。\n欲从何处求心性，日用由来总是天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9369,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟宿陶婆湾","author":"吴与弼","text":"夜半扁舟梦不成，细将心绪绎平生。\n人伦有道何能尽，展转无端感慨情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9370,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠九韶","author":"吴与弼","text":"绿萝溪上旧儒家，脩竹乔松去市赊。\n南亩秋风多熟黍，东园夜雨总肥瓜。\n圣贤指示方应密，师友相期路不差。\n孝友一门斯是政，读书声里老生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9371,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜读康节先生诗后作","author":"吴与弼","text":"田圃工夫日破除，小窗灯火夜诗书。\n月华皎洁云轻后，夏景清凉雨霁馀。\n百体无拘知气泰，一尘不累识心虚。\n从今莫惜慇勤学，好古方能屡起予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9372,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦傅秉彝","author":"吴与弼","text":"一别那胜岁月深，浮沉世务阻相寻。\n分阴痛惜平生志，梦里犹悬怅怏心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9373,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"午枕","author":"吴与弼","text":"枕簟清凉午梦浓，觉来鸠语太从容。\n寸心似水无纤浪，认取邹书夜气功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9374,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏夜","author":"吴与弼","text":"月色婵娟夜正凉，偶然徐步稻花傍。\n篱多竹树饶清荫，池满芙蕖有暗香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9375,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄九韶","author":"吴与弼","text":"幽窗遗籍自朝昏，尽日红尘不到门。\n顽钝淬磨还有益，新功频欲故人闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9376,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月夜","author":"吴与弼","text":"凉月清襟抱，閒吟气正和。\n熟思刚暴性，旦昼梏亡多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9377,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜读后对月","author":"吴与弼","text":"青灯读倦阁遗编，见月多情又不眠。\n欲识此心虚妙处，沉沉户牖嫩凉天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9378,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"省己","author":"吴与弼","text":"希贤事业愧庸才，煅炼磋磨志愈乖。\n世泽厚深流庆远，道心连日得悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9379,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月夜","author":"吴与弼","text":"云尽天心月正圆，可人清景属南轩。\n满怀今古那能寐，缓拭枯桐理舜弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9380,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"变化气质消磨习俗","author":"吴与弼","text":"由来气质已偏枯，俗染弥深愈失初。\n于此不加鏖战勇，却从何处着工夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9381,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观旧稿","author":"吴与弼","text":"十载飘零无定栖，两年幸隐此山扉。\n诗书渐觉添新得，心性还应胜旧时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9382,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄题戴氏水竹居","author":"吴与弼","text":"胜日来良朋，相招出茅屋。\n壮观穷名山，所历清心目。\n山人白云端，苍翠罗脩竹。\n鹤发笑相逢，坐谈此君熟。\n苔径递幽阴，轩楹净如玉。\n尘虑蝉已蜕，道心露新沐。\n主宾偶一契，题诗惬素欲。\n徘徊话别迟，夤缘看未足。\n归卧梅窗云，馀兴犹可掬。\n何当载酒来，重寻咏淇澳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9383,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"有悟","author":"吴与弼","text":"困穷拂乱力难胜，天意分明增不能。\n思到此心收敛处，聪明睿知自然生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9384,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夜 其一","author":"吴与弼","text":"不惑无闻大圣辞，如今秪有五年期。\n譬犹万里关山路，驽足应须日夜驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9385,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夜 其二","author":"吴与弼","text":"驽足应须日夜驰，丁宁莫枉一男儿。\n工夫彻后开眉看，万里青天月出时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9386,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元日","author":"吴与弼","text":"去年程课略加勤，今岁深期日日新。\n万事何如吾道重，丁宁莫枉此生身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9387,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"遣闷","author":"吴与弼","text":"讲学无功德不脩，不才甚矣可无忧。\n青春回首今何在，堪叹人生易白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9388,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"发舟弓家渡","author":"吴与弼","text":"囊书喜上省亲舟，千里山川尽旧游。\n家庆新欢堪计日，前程渐次减离忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9389,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠傅秉彝","author":"吴与弼","text":"洗墨池边春草长，重来怀旧意茫茫。\n蹉跎容易青春晚，秋鬓能禁几点霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9390,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清苦吟","author":"吴与弼","text":"清苦丈夫志，风霜善自持。\n阳和非不爱，义命贵安之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9391,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]