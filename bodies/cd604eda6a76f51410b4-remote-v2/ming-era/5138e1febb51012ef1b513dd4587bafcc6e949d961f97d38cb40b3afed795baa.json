[{"title":"寒瀑洞怀旧","author":"成鹫","text":"山翁住向人间久，冷落云林直至今。\n磴道尚堪重著屐，石床谁复更横琴。\n千章古木经残烧，一线清泉下浊涔。\n剩有风流在樵牧，隔桥吹笛学长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题李子长先生墓","author":"成鹫","text":"谁把高名榜翠微，先师亲笔写泉扉。\n白沙门下多牙笏，黄叶堆中一布衣。\n古道静观宜往复，大贤遗泽尚依稀。\n清风留在山南北，社日儿郎荐蕨薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过白沙先生祠故址","author":"成鹫","text":"荒祠不复布琴尊，往事惟凭故老言。\n东海日高开讲席，西樵山色接江门。\n石房细语虚闻响，庭树无枝老见根。\n独有枯禅经过此，问君谁是好儿孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次黄鼎泊岸二日临崖坐石北风怒号江水豗激远兴翛然","author":"成鹫","text":"红蓼洲边枫叶丹，满船风雪一僧閒。\n言寻密约盟明水，先寄孤心到远山。\n行似奔波年共逝，坐当磐石性同顽。\n及时吸取西江去，得入泷中便掩关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西行阻兵复归小漫山霍西牛过宿诉别","author":"成鹫","text":"行脚出门归亦客，閒身到处主中宾。\n萍踪未定逢知己，蜡烛无多别故人。\n江水长流寒不冱，云山弥望远生皴。\n临岐指点泷西路，君但能来莫问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过崧台感旧 其一","author":"成鹫","text":"百川曾此一朝宗，荒殿犹存碧藓封。\n野渡水寒朝饮马，江城云起昨从龙。\n千秋离黍歌三阕，半夜苍梧梦九重。\n自是六朝僧去后，逋臣多少作山农。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过崧台感旧 其二","author":"成鹫","text":"趋庭记说崧台事，应诏曾瞻十二旒。\n焚草再陈忧国疏，吟诗多上阅江楼。\n手存旧泽惟鸲鹆，心有殊恩但蒯缑。\n谁念夕阳风在树，有人持钵过端州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"抵西宁宿翠林庵与秋霜本源二师乡人冼云中夜话","author":"成鹫","text":"閒云西并片帆飞，路入东林为蕨薇。\n曲径日斜行子至，隔山斋罢老僧归。\n班荆有客同乡水，洗钵何人话翠微。\n今夜无弦弹得好，月轮刚照十三徽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将入下城信宿翠林庞卯君以诗见招用韵次答","author":"成鹫","text":"拟向青山作老樵，晚投孤寺宿松寮。\n遥知地主曾悬榻，难别林僧为过桥。\n拾得偶来劳见讯，八公能隐不须招。\n明朝结束寻君去，稳系腰间五石瓢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至下城赠庞卯君","author":"成鹫","text":"今来见面胜闻名，不枉泷西十日程。\n得与王生初结袜，却教任子独沾缨。\n玄谈每喜当前席，生计悬知在下城。\n但得半间茅屋住，荷锄言就鹿门耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"下城洞晚眺","author":"成鹫","text":"云路千岐水一涯，诸峰合作青莲花。\n檐低远荫迎斜日，门对奔流送断槎。\n石窦自舂临瀑碓，坑田长转出云车。\n山翁招手溪桥去，指点寒皋好种瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过梅砰赠湛慈老师","author":"成鹫","text":"远公卜筑得幽奇，削取巉岩作坦夷。\n碧甃牵泉通一线，青山邻郭阻千岐。\n石门高峻人稀到，梅子酸甜独自知。\n手植万松将荫屋，想君从此撤籓篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游云窝赠中介大师","author":"成鹫","text":"平阳师子高高坐，万仞峰头一个僧。\n引水入房分绕药，磨刀临涧不饶藤。\n枯椿谷冷花先雪，冻雨檐孤溜易冰。\n却笑昨宵低处望，也将残烧作禅灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄本师","author":"成鹫","text":"本师眠食今安否，某甲行藏别有因。\n堂下肯容担板汉，山中甘作结茅人。\n一卷怪石顽成癖，两角肥牛牧渐驯。\n惭向罗浮寻旧约，年年空负洞门春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长至日与诸公集翠林寺晚过香雪庵分赋","author":"成鹫","text":"沉沉钟鼓动微阳，山寺逢君即故乡。\n未满百年常苦短，才添一线便为长。\n林间留客环深翠，雪里寻僧得妙香。\n何用吹灰发天籁，笛中无孔有宫商。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿西竺禅院与僧夜话","author":"成鹫","text":"閒身随处息征蓬，静掩禅扉话不穷。\n百结水田孤烛底，一区金地万山中。\n潭光洞牖呈初月，竹韵垂檐答响风。\n几欲诛茅深谷去，芒鞋踏破不如公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归途宿龙华寺与无尽六如师滋庄居士夜话","author":"成鹫","text":"经过此地许重来，旧路依然十日回。\n一片閒云归暝岫，千峰圆月印香台。\n心同石溜寒偏细，目与松窗夜并开。\n独拥孤衾对玄度，山风吹雪下庭梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿龙井庵与博峰师夜话师欲留予住弥勒阁","author":"成鹫","text":"难得高僧对茗谈，石林不惜此重探。\n火分破灶烟犹湿，泉入斋厨味转甘。\n到处泥牛随分纳，他年木佛许同参。\n夜堂莫讶无言说，月满长空水满潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春漫兴","author":"成鹫","text":"那可逢春未有诗，好春况与客心宜。\n泥牛直去无寻处，水鹤何当得见时。\n老眼生花书渐废，新毫添雪镜先知。\n朝来欲就东风问，芳草年年忆著谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春偶成寄泷中诸子","author":"成鹫","text":"莫倚幽居耳目清，难消山色与溪声。\n忍辜良晤长依寺，那得馀閒更入城。\n野水渡牛微见迹，春风啼鸟不知名。\n分明一幅诗中画，只恐僧繇邈不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"尘","author":"成鹫","text":"太虚一气自溟濛，野马终朝只御风。\n群动无端成辐辏，微躯难免处樊笼。\n窗通彼阕常生白，路入长安便觉红。\n古镜不劳频拂拭，个中原有梵王宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"烟","author":"成鹫","text":"热不因人浊处清，积空成色自分明。\n嵩山破灶当机堕，古庙香炉觌面呈。\n宿火传将微有燄，轻风随去本无情。\n年年二月逢寒食，消息还归折脚铛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"烧","author":"成鹫","text":"南村野老祠刍狗，山鸟衔灰自爇林。\n半壁电光深入石，一星槐火竟流金。\n白牛假道归涔黑，玄鹤摩空落影沉。\n谁识枯桐心已死，独蒙尘土待知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"影","author":"成鹫","text":"世外枯禅物外身，阴晴随地别疏亲。\n相期白首为知己，共对青山只此人。\n好客不来嫌我懒，侍儿多去为僧贫。\n最怜孤烛幽窗底，寂寞因君见主宾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"响","author":"成鹫","text":"屐齿过桥轻的的，石棱斗水碧潺潺。\n就林说籁谁倾耳，入谷闻声独破颜。\n比竹自鸣凭自和，清商随去复随还。\n松风满地无人买，化作洪涛出万山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迹","author":"成鹫","text":"草色青青与胫齐，终年不过远公溪。\n重拈旧话参驴脚，未得閒身逐马蹄。\n山径用来微有路，桃花开日渐成蹊。\n凭他检点经行处，白足分明不到泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠林除夕即事 其一","author":"成鹫","text":"推倒虞渊赤羽鸟，晚堂钟鼓报年徂。\n村童爝竹惊憨犬，野鼠偷灯嫁小姑。\n寒绽水田三尺线，坐深檐雨一团蒲。\n山中自了无庚甲，夜夜胡床火满炉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠林除夕即事 其二","author":"成鹫","text":"去腊郡斋今野寺，半生萍梗似蘧庐。\n住山未觉寒将尽，为客方知岁易除。\n野老索偿文字债，乡僧劝习佛陀书。\n明年得遂投閒计，土面灰头学运锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠林元旦","author":"成鹫","text":"云里开门四望低，早莺啼遍乱峰西。\n远钟出郭仍归寺，宿雨添泉尽赴溪。\n心树渐枯同古桂，鬓花潜长逐新荑。\n春来莫道无筋力，一日还应灌百畦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"走马灯","author":"成鹫","text":"来时衮衮去匆匆，结束狂心付化工。\n大火聚边多跃冶，只轮车上一征蓬。\n圆机静会当方寸，冷眼旁观笑热中。\n今古交驰争似此，纷纷人在纸屏风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归韦涌答龙媒兄韵","author":"成鹫","text":"辞家千里远寻师，行脚归来只暂时。\n久去弟兄成主客，重经乡路改平陂。\n青山有约宁相赚，白首能来尚未迟。\n闻说欲酬男女债，待完婚嫁与君期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何不偕再入吴门","author":"成鹫","text":"老大登临兴未阑，吴门风物去重看。\n青春作伴三千里，白发行吟十八滩。\n乡月到江成独照，家山背岭失孤峦。\n前途夷险君应熟，莫更临岐说路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林向超还北流幕因柬谢合脚公明府","author":"成鹫","text":"归时上巳去春深，怅别前山日又沉。\n黑土久增凋弊叹，青油空负治安心。\n棋当斗劫须留谱，琴到更张始辨音。\n自古神仙多吏隐，丹砂勾漏不忍寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送罗喜人行商交南","author":"成鹫","text":"嗟君岂合老风尘，一曲骊歌勿复陈。\n自挽役车投黑齿，更资章甫适文身。\n萍蓬正值干戈地，书剑难消寂寞春。\n到处若逢阳翟贾，不知奇货属何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"从泷西还亦庵庞卯君见赠赋答","author":"成鹫","text":"看看宝主太难分，千里长空不住云。\n多谢居亭曾爱客，无端归路又逢君。\n违山几日思新蕨，到处深春长野芹。\n旧业泷西好回首，早抛城市伴耕耘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归隐罗浮留别陶握山罗戒轩","author":"成鹫","text":"入山踪迹恐人知，一笑相逢是别时。\n苦海看谁先到岸，长途怜我始分岐。\n贫惭轵里能将母，老怪柴桑亦恋儿。\n底事累君良不浅，未应还索赠行诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初入罗浮寄呈石洞本师","author":"成鹫","text":"万事皆休岂复疑，美中不足但违师。\n眼前耕凿无关道，心在耰锄渐废诗。\n坐对潺湲通语默，历穷岑巘得平夷。\n主人欲问罗浮事，荆棘当门花满篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄家山诸子","author":"成鹫","text":"当时梦见醒来说，今日罗浮是昔渠。\n在世可堪成孟浪，入山方解惜居诸。\n高窗临树床头鸟，细石通泉屋角鱼。\n旦夕到来观不足，依稀忘却八行书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答天藏大师送行之作","author":"成鹫","text":"谩从世外惜离群，百八声钟到处闻。\n去路晓冲沧海日，计程东指洞门云。\n三家村里呈新话，品字柴头检旧文。\n安得支公似明月，石楼吟望便逢君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠钝庵师","author":"成鹫","text":"梦里初醒勿复云，水边林下恰逢君。\n溪深杓柄长如许，路远芒鞋费几文。\n竟发大心成佛见，不留细语遣人闻。\n相期共指孤峰宿，莫旷閒房半住云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"补衲","author":"成鹫","text":"粪埽周遮体自亲，当时宜称总前尘。\n纫将弱线长三尺，绽得生衣重七斤。\n祗有水田知夏腊，更无寒暑管冬春。\n一池荷叶家风在，漫对儿孙说古人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过华首台","author":"成鹫","text":"人生那得四百岁，一岁罗浮住一峰。\n去日转多来日少，南山游遍北山同。\n倚檐双瀑晴天雨，夹路千松暑月风。\n地主不收僧借去，古台移向洞门东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老人石","author":"成鹫","text":"坚性何妨高处蹲，閒身归去总无村。\n风云月露酿元气，草木昆虫依本根。\n大地几回成昼夜，诸峰相见即儿孙。\n当时曾笑生公石，不点顽头更囫囵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄茎鉴二子","author":"成鹫","text":"白云西望数峰青，咫尺家山在户庭。\n蜾赢嘱儿当类我，猕猴怜子谓宁馨。\n物情痴绝堪长叹，诗句吟来只自听。\n身健报恩终有分，此间随地得参苓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"里正索租戏赠","author":"成鹫","text":"闻说罗浮好住禅，我来恰恰是荒年。\n少生坑稻多生药，饥杀山僧饱杀仙。\n枵腹难偿行脚债，空囊还欠入官钱。\n思量更欲移居去，只种黄精不种田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"博罗晚眺","author":"成鹫","text":"天外高风扑面吹，花黄草白动秋思。\n寒城西望空斜日，逝水东流无尽时。\n游子重来还问路，閒僧一过便留诗。\n罗浮何事不归去，笑杀道旁驱犊儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄下城庞卯君时予将有朱崖之行","author":"成鹫","text":"终日怀人在翠微，下城云树想依稀。\n江通锦水凭鱼寄，路入青山鹤纵飞。\n三顷秫田临古岸，数椽茅屋对斜晖。\n明朝我向朱崖去，回首泷中便当归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归自罗浮过铁城诸子述洞天之胜","author":"成鹫","text":"年来莫讶到城稀，才别罗浮昨日归。\n渡海呈山云出袖，当人说瀑冷侵衣。\n礼随筋力容疏放，心似颠毛渐细微。\n良晤未知频得否，秋风孤鹤又南飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题曹茂才新筑","author":"成鹫","text":"一个閒身去复还，读书声里款重关。\n江城旧别人三载，隙地新添屋半閒。\n草自离披应任长，竹凭疏密不须删。\n眼前真乐凭郡取，窗外明蟾郭外山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归韦涌宿月衣庵与谢邺门话别","author":"成鹫","text":"近时诗句少人弹，未惜逢君语夜阑。\n高阁重来寻旧梦，危襟初拥试新寒。\n去随云水家何在，共老风尘别亦难。\n他夕朱崖相忆否，一天星月路漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别弟","author":"成鹫","text":"远亲几岁阻承欢，又作孤鸿渡海澜。\n学道蹉跎闻道晚，负恩容易报恩难。\n高堂娱老荆花茂，客路逢秋布被单。\n贫贱弟兄无可嘱，各将薇蕨劝加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿月衣庵留别家山诸子","author":"成鹫","text":"参遍诸方便掩扉，浮生多恐与心违。\n言寻海岳终难住，暂寄僧房便当归。\n独鹤去时天浩渺，群鸥宿处水依微。\n茫茫大地同为客，莫笑秋蓬远近飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠罗戒轩为子湛娶妇","author":"成鹫","text":"相看老大忆儿童，记得当筵蜡烛红。\n在世与君皆有子，故人先我已称翁。\n三心未了閒堪惜，五岳能游计许同。\n他日云山携手处，不知谁早得痴聋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日发汾水","author":"成鹫","text":"纸鸢夹岸走儿郎，正好登高又别乡。\n南地授衣逢九月，西风移棹过重阳。\n远书到日愁无雁，衰鬓经秋渐有霜。\n家在罗浮归不得，年年空负菊花黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登灵山寺汲泉试茗","author":"成鹫","text":"三年两过灵山寺，今日初尝峡口泉。\n井脉但凭岩叟说，茶经曾记岳僧传。\n一身病肺嗟岐路，千里归心向洞天。\n自笑不如清涧水，时时流傍碧峰前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上秋晓","author":"成鹫","text":"天光云影两参差，江上推篷见日迟。\n霁色千峰明剑戟，秋风一枕对涟漪。\n寒岩危绿兼霜坠，野水低花杂果垂。\n何事故山憔悴客，冷吟终日忆东篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经旧战场望海怀泰山道士","author":"成鹫","text":"高凉兵后见荒榛，赵璧犹存汉帜新。\n东海蹈来秦自帝，扶馀归去国无人。\n丹须久伏胎方圣，龙在能藏用乃神。\n欲向蓬山寻旧隐，天风吹路暗征尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿惮长驿即事","author":"成鹫","text":"惮长长路少人行，斥卤西连锦伞城。\n灶客煮盐分野烧，田家炊黍馌秋成。\n海涛近枕偏相聒，山月离乡分外明。\n倦客耽眠天又曙，门前咿喔役车声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅录道中","author":"成鹫","text":"何堪毂击复肩摩，一片閒云此地过。\n乡国别来风土异，市门开处里儿多。\n青山路夹黄茅店，黑齿人披绿箬蓑。\n添得吟僧诗兴好，晚凉无那扣轮歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿梅录江上有怀","author":"成鹫","text":"旧游回首似风萍，留得閒鸥占浅汀。\n云鸟阵存沙碛暗，水犀军散野燐青。\n溪翁钓罢潮初上，市客歌残酒未醒。\n怀抱此时消不得，又随孤月下沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自英利抵徐闻一径迂回延袤百里万木蓊蔚百卉错绣身入其中如处翠幕从林隙见日已及亭午道俗殊情匪欣则怖古称仙源辽邈人境隔绝武陵之后未曾有也诗以纪胜","author":"成鹫","text":"二时天气异寒温，百里人烟隔晓昏。\n涧底转雷车错毂，林端见日叶归根。\n兰侵蔓草香偏满，藤冒高柯子并繁。\n可惜桃花鸡犬地，一通人境失仙源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"会同客夜寄山中诸子","author":"成鹫","text":"故国离居动几旬，他乡两见月华新。\n灯前细读怀中字，雪后频归梦里人。\n宾雁未来秋已过，朔风不到海先春。\n却怜华发催年暮，独向南天寄一身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠崖除夕与吴谓远广文守岁有怀山中诸子","author":"成鹫","text":"烛边吟苦县更催，画尽炉头欲冷灰。\n马齿一年随腊去，鸡声半夜送春来。\n孤衾笑就青毡宿，明镜愁缘白发开。\n今夕故山应共讶，岁残不见寄书回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":49548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]