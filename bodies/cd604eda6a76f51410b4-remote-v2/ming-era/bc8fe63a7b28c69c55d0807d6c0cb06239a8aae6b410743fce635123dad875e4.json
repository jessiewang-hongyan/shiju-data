[{"title":"即事","author":"吴与弼","text":"磊落群峰彻晓云，柴关閒出为晴曛。\n逢人偶学占秧候，活水渠边手自分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9392,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"昼坐外南轩","author":"吴与弼","text":"南窗北牖透晴光，花木参差日正长。\n举目无非幽赏处，不知何地是仙乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9393,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"绝句","author":"吴与弼","text":"竹户风光软，花轩清昼迟。\n苍苔人迹绝，净几独吾伊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9394,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"閒趣","author":"吴与弼","text":"野水云山隔市尘，日凭閒散养吾真。\n茅庐周匝多芳树，行处清香暗袭人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9395,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦觉作","author":"吴与弼","text":"静夜迢迢独觉时，寸心凝敛绝邪思。\n聪明睿知何从出，作圣之功信在斯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9396,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"纱陂","author":"吴与弼","text":"长潴石罅冰，广浣溪中雪。\n清风生夜寒，泓澄浸秋月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9397,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大同峡","author":"吴与弼","text":"秀峙交翠屏，清冷响寒玉。\n谷鸟时一鸣，苍苔此幽独。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9398,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓起","author":"吴与弼","text":"夜气春融和，曙光晴皎洁。\n漠漠碧云端，斜露清霄月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9399,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"罗家园","author":"吴与弼","text":"湛湛芳草池，翛翛碧霄竹。\n倚竹漱春流，清气满幽谷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9400,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李家山","author":"吴与弼","text":"携琴兼载酒，童冠偕跻攀。\n浩歌碧云里，落日松风寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9401,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"徐家山","author":"吴与弼","text":"大路临青山，苍苔荫清樾。\n几度纵芒鞋，送宾此为节。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9402,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石泉","author":"吴与弼","text":"石泉千古名，悠悠四时绿。\n清洁乃素心，白云一茅屋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9403,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东陂","author":"吴与弼","text":"迢迢透长源，滔滔流昼夜。\n几曾瞑目听，应悟安行者。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9404,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东窗诵陶诗","author":"吴与弼","text":"时和风雨调，绿畴日滋长。\n吾意良淡然，晴窗坐虚敞。\n竹荫连琴书，幽苔隔尘鞅。\n流诵徵君辞，伊谁嗣清响。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9405,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"偶书","author":"吴与弼","text":"倦出寻常止茅屋，妄想潜消思寡欲。\n但恨青山云未深，更欲移居问穷谷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9406,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"枕上作","author":"吴与弼","text":"为学旷锄犁，事农疏典籍。\n学弛心性芜，农惰饥冻逼。\n二者贵兼之，庶几日滋益。\n奈何疾病缠，蹉跎旦复夕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9407,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事","author":"吴与弼","text":"独步孤村去，从容玩我书。\n稻苗时雨后，山色晚晴馀。\n性也何曾染，心兮此正虚。\n归来带明月，夜兴更何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9408,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"灯下作","author":"吴与弼","text":"日日劳筋骨，心中未免疑。\n细思贫贱理，素位合如斯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9409,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠黄徵士","author":"吴与弼","text":"卧疴白云中，苦心正怀旧。\n忽枉故人盼，青山得携手。\n晴窗坐南薰，薄言劝春酒。\n眷然惜离群，问答殊未久。\n荒村多寂寥，还能重来否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9410,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"写怀","author":"吴与弼","text":"意绪依依万感馀，羸躯应向死边苏。\n哀歌欲写难成调，几傍霜檐对月孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9411,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬夜枕上作","author":"吴与弼","text":"遥忆当年学立身，兢兢常恐暂埃尘。\n孤风自许追千古，特操何曾让一人。\n因病简编寻旷弛，离群践履转逡巡。\n中宵忽感平生志，回首空过七十春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9412,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与学者戴舆","author":"吴与弼","text":"茕茕失怙未能言，鞠育劬劳仰母怜。\n稍及成童知择善，才邻弱冠已忘眠。\n镜当尘积光难缉，车向途艰势易颠。\n从此更敦千古志，躬行心得好拳拳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9413,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自叹","author":"吴与弼","text":"少年不学浪悠悠，老大无成空隐忧。\n寄语青春强健客，及时黄卷好埋头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9414,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄李子俨","author":"吴与弼","text":"杨柳城头乱絮飞，慇勤客舍再逢时。\n山中有约遂何日，羁思悠悠谩寄诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9415,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"感怀","author":"吴与弼","text":"静把平生一细思，可堪桃李不胜吹。\n何能挽得千溪水，净洗灵台一片私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9416,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙窟渡拜先曾祖楚江先生墓","author":"吴与弼","text":"青山远入避红尘，遗魄千秋此水滨。\n荒陇凄凉重拜日，细从诸老问前因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9417,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"迁居小陂","author":"吴与弼","text":"小陂桥畔记吾庐，七载经营今陟居。\n一片灵台无别想，孜孜惟是圣人书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9418,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜坐","author":"吴与弼","text":"古道寥寥不易寻，秋风杨柳感人深。\n虚堂寂静无言处，黄卷青灯求夜心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9419,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬夜怀古 其一","author":"吴与弼","text":"二帝三王隆至治，皋夔周召和应同。\n斯人何幸生斯世，一体君民瑞气中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9420,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬夜怀古 其二","author":"吴与弼","text":"孔孟孳孳论要道，颜曾公万实同心。\n满门师友更酬酢，此乐当时知几深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9421,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬夜怀古 其三","author":"吴与弼","text":"濂洛关闽道中兴，游杨黄辅一时生。\n大明日月当中丽，多少祥云与景星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9422,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"昼寝觉作","author":"吴与弼","text":"病思昏昏午梦还，熟思历试鼻应酸。\n欲知松柏孤高处，须向隆冬雪后看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9423,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀孔御史 其一","author":"吴与弼","text":"曾向严亲旧稿中，睹君尺牍语舂容。\n知予大过深增惧，几度相思细省躬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9424,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀孔御史 其二","author":"吴与弼","text":"几度相思细省躬，可堪名胜耻无穷。\n欲求实胜何由得，黄卷须加百倍功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9425,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晨坐东斋","author":"吴与弼","text":"寂养资良宵，清晨趣应好。\n芳露盈华园，碧岚霭春阜。\n虚斋独危冠，晴光烂窗牖。\n一玩谦亨辞，冷然涤心垢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9426,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"閒兴","author":"吴与弼","text":"贫居日寡营，动息得自眕。\n时课诸生馀，还共儿童哂。\n出门望旧山，缘篱探新笋。\n归坐夕风清，闲情寄瑶轸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9427,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次学者韵","author":"吴与弼","text":"欲说男儿事，奇功未易收。\n灵台须静养，物理贵精求。\n岁月忽向晚，关山阻且脩。\n分阴宜痛惜，驱策莫迟留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9428,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暇日偶成","author":"吴与弼","text":"寸心如水淡无波，四体安舒一气和。\n有客到斋终日话，怀开应喜善人多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9429,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病中枕上作 其一","author":"吴与弼","text":"一念之微须致精，公私王霸要分明。\n毫埃丝垢宜揩尽，刚立成心大路行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9430,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病中枕上作 其二","author":"吴与弼","text":"纤私涤尽未为难，要识时中是孔颜。\n此个路头何处问，苦心空使鬓毛斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9431,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病中枕上作 其三","author":"吴与弼","text":"律身须礼不容疏，公以治心其庶乎。\n二者没身而已矣，不知人世有荣枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9432,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新居即事","author":"吴与弼","text":"幽赏平生志，安居此庶几。\n青山环远近，碧水带东西。\n接舍惟樵径，连云只稻畦。\n遗经閒恣阅，心迹总高栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9433,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"改过","author":"吴与弼","text":"四十应当成德时，中心何更有他岐。\n其终也已宜深察，剔拔毋令利暂縻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9434,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"即事","author":"吴与弼","text":"养病私欣得自由，日长卧看鲁春秋。\n悠然咏到忘言处，一枕清凉午梦幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9435,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"省己","author":"吴与弼","text":"此心一失栽培力，几向穷途不自持。\n静里反躬深省处，风霜却是进脩资。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9436,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"处困","author":"吴与弼","text":"遇着艰难须用心，毋令放下便沦沉。\n此关若得千里透，信有人间百鍊金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9437,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄曰让祈门训导","author":"吴与弼","text":"优游新趣佳山水，仰止前谟近圣贤。\n六籍日须鞭策进，寸心幸莫利名牵。\n杏坛铎晓光风满，蕙帐琴寒霁月悬。\n从古男儿当自奋，剩将事业答青年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9438,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬夜步月怀刘悦学先生","author":"吴与弼","text":"读罢閒吟缓出庭，月华如昼院澄澄。\n恍思玩易京师夜，曾向吾师学看星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9439,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"枕上偶成","author":"吴与弼","text":"为学如登万仞山，层崖须用小心攀。\n前头尽有无穷趣，只是工夫不断难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9440,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬至夜枕上作","author":"吴与弼","text":"深造工夫靡敢悭，近来又透一重关。\n心思只在圣贤上，梦寐不离文字间。\n斯道极知颠倒易，一身痛惜把持难。\n微吟又是阳生后，细省迷途驾速还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9441,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"昼寝觉作","author":"吴与弼","text":"渺然方寸经纶本，万感谁怜此地危。\n欹枕细思敦艮旨，几人曾向吉中归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9442,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄罗秀才","author":"吴与弼","text":"衰谢无才甘陆沉，何烦青眼特遥临。\n驩欣便若平生好，慷慨深投半百心。\n莫逆尚期清夜话，有怀先寄白头吟。\n卜居愿与嘉谋恊，早向春风听好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9443,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中堂即事","author":"吴与弼","text":"灯明几净室清幽，满眼图书托士流。\n涤砚闲书新得趣，廓然泰宇澹何忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9444,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夕","author":"吴与弼","text":"拥罢寒炉小酌馀，挑灯又近古人书。\n一枝粗定身多幸，此地应逢两岁除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9445,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元日纪梦","author":"吴与弼","text":"为学平生慕至真，孜孜明德与新民。\n朝来枕上添新喜，梦里犹深激劝人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9446,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜读","author":"吴与弼","text":"疾风吹雨霰交飞，独拨寒炉夜半时。\n喜得诸生清苦共，小窗之外尚吾伊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9447,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"诵晦庵诗次韵","author":"吴与弼","text":"诛茅遂幽独，惬此林壑清。\n太和酿群卉，天香满衣缨。\n病躯无馀事，先人富遗经。\n自陪二三子，明窗共经营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9448,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"待月西斋","author":"吴与弼","text":"远爱云山近竹林，芸编堆里更瑶琴。\n时行时止凭谁说，待月西斋自养心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9449,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓枕作","author":"吴与弼","text":"少年意气凌秋霜，直欲追古豪杰参翱翔。\n老去何知万事旷，空令感激增悲伤。\n呜呼古人及之良不易，后生慎勿轻流光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9450,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"温楚歌","author":"吴与弼","text":"上国曾传此调清，经年多故忘当丁。\n虚堂永昼重温处，吟到多情是故声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9451,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"门外閒坐","author":"吴与弼","text":"习静生憎损病心，晚凉门外独横琴。\n呼童细剔溪头树，为爱青青云际岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9452,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"独步偶成","author":"吴与弼","text":"暂出孤村纵野踪，晚凉归咏更从容。\n盈眸好景新晴后，人在乾坤清气中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9453,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题唐山书阁","author":"吴与弼","text":"流俗滔滔利是趋，居家高阁独储书。\n绝韦远绍前人绪，丽泽频来长者车。\n香雨芸窗春杳杳，清风兰砌日舒舒。\n小陂茅屋应相近，时喜诸郎问鲁鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9454,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"私","author":"吴与弼","text":"一念私才起，风波势便增。\n若非鏖战勇，方寸几时平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9455,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"分","author":"吴与弼","text":"万事须由命，劳苦徒丧廉。\n若非安得分，尽快未能恬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9456,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"名利","author":"吴与弼","text":"眼前名利日纷纭，扰扰何由得性真。\n置却身心贫富外，始知世有出尘人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9457,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"苦热观晦庵诗集","author":"吴与弼","text":"炎热侵陵梦少安，茅檐无地可盘桓。\n绝胜黄卷多冰雪，朗诵令人骨髓寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9458,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"读罢枕上喜而有作","author":"吴与弼","text":"读书进处心私幸，更把精灵祷上天。\n愿假数年无病困，尚当努力继前贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9459,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"枕上默诵中庸稍悟一书大旨喜而赋此","author":"吴与弼","text":"句习章燖几十年，其于统会每茫然。\n一朝似得优游力，击节深叹圣嗣贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9460,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"至日感怀","author":"吴与弼","text":"屡醒长更梦，频添暮景愁。\n盛时刚易失，多病苦难瘳。\n长困荆榛境，终非鸾凤俦。\n徘徊当令节，休复慨前脩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9461,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"临流瞑目坐","author":"吴与弼","text":"物外元无我，閒中别有天。\n临流时抱膝，此意向谁言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9462,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄叶郎中","author":"吴与弼","text":"洁居万事愧吾徒，十载猖狂一薄夫。\n贫病不胜书课减，怠荒常是力行疏。\n愁来无地堪容足，老去何时可复初。\n忽辱高明千里念，题诗遥望独长吁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9463,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"枕上作","author":"吴与弼","text":"仁者无怨尤，节士多饥寒。\n至理无定在，君子随时难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9464,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"连珠求药归道中作","author":"吴与弼","text":"问药归来出白云，轻身随处玩馀春。\n会心偶记前贤咏，得自由时莫厌贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9465,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀旧","author":"吴与弼","text":"意曾弥月寓东坪，童冠相亲八九朋。\n月色满帘天似水，书声彻晓院如冰。\n贤关总拟争先入，尘鞅何期竟久萦。\n愧我只今空白发，不堪回首负平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9466,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜牧","author":"吴与弼","text":"凉气萧萧露满衣，碧天如洗月如规。\n浩歌一曲孤村寂，绿树阴中牧犊归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9467,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"讲罢偶成","author":"吴与弼","text":"万事应须任所遭，胼胝农圃敢辞劳。\n西斋讲罢心如水，又对凉天霁月高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9468,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东窗偶成","author":"吴与弼","text":"虚窗寂寂隔红尘，踪迹虽贫乐甚真。\n法帖谩陶閒里趣，高眠时养病中神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":9469,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]