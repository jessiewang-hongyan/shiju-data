[{"title":"高士颂九十一首 其二十七 颜回","author":"黄省曾","text":"颜氏之子，不怍簟瓢。\n心斋白日，志迥青霄。\n圃衣田食，大圣游交。\n鼓琴蓬荜，可以逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其二十八 原宪","author":"黄省曾","text":"原生匮盝，室侵风雨。\n薄炊经旬，彫裘历纪。\n友赐荣华，骖騑萃止。\n闻剖病贫，终身含耻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其二十九 汉阴丈人","author":"黄省曾","text":"丈人治圃，搰搰其劳。\n赐焉逢觏，进说为槔。\n前陈后诘，反覆见嘲。\n风波全德，私语其曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其三十 壶丘子林","author":"黄省曾","text":"至哉壶子，列老下趋。\n龙藏郑圃，真与道俱。\n侧闻玄语，宣发希微。\n载陈生化，继述黄书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其三十一 老商氏","author":"黄省曾","text":"老商树教，列寇下趋。\n居门七载，席始相携。\n眼耳都融，叶干忘机。\n乘风枯槁，得道而归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其三十二 列禦寇","author":"黄省曾","text":"禦寇隐郑，四十馀年。\n台衡大馈，顿首拒焉。\n麾使悟妻，保体消愆。\n軿风驻世，表箓蓬仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其三十三 庄周","author":"黄省曾","text":"庄周傲世，洸洋寓言。\n文穷万妙，学守一玄。\n戏游自快，国聘难延。\n浩然就尽，弗避乌鸢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其三十四 段干木","author":"黄省曾","text":"干木自晋，萍寓西河。\n群贤分组，树介岩阿。\n千乘登门，跳跃逃徂。\n腾光韦素，耿照弗磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其三十五 东郭顺子","author":"黄省曾","text":"灏灏东郭，动展如天。\n清虚应物，独抱自然。\n迷窥高弟，欲述难言。\n文侯失志，爵国可捐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其三十六 公仪潜","author":"黄省曾","text":"鲁慕公仪，崇阶以钓。\n授意孔思，乃非诚到。\n面返君言，高陈友操。\n考槃弗谖，毕景怡道。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其三十七 王斗","author":"黄省曾","text":"卓荦王斗，抗节齐门。\n衮衣奔走，至训希闻。\n方聆?规，省过以承。\n聊扬五彦，境庶咸宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其三十八 颜斶","author":"黄省曾","text":"特哉齐斶，剧折庙堂。\n上陈二帝，下举三王。\n宾师靡诺，形神恐妨。\n终身不辱，野箓有光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其三十九 黔娄先生","author":"黄省曾","text":"黔娄物表，著撰存志。\n却相鲁公，辞卿齐使。\n捐世萧条，敛衾弗备。\n贤矣配人，以康为谥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其四十 陈仲子","author":"黄省曾","text":"陈仲遐情，于陵□玩。\n輖饥觅李，螬食过半。\n楚相敦求，山妻了算。\n遂嫁云踪，锄丁自窜。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其四十一 渔父","author":"黄省曾","text":"楚老垂竿，渔于烟水。\n族氏无彰，鳞鬐自举。\n偶觌三闾，开敷数语。\n击棹扬歌，冥潜何许。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其四十二 安期生","author":"黄省曾","text":"安期高蹈，疗俗千祀。\n绿海孤游，朱颜常驻。\n挥璧阜亭，酬舄始帝。\n去矣银台，永遗尘世。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其四十三 河上丈人","author":"黄省曾","text":"伯阳倡教，嗣流河上。\n句疏章钩，宣机□象。\n战世纷纭，玄心坦荡。\n鹤发葆真，仙民景向。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其四十四 □臣公","author":"黄省曾","text":"臣公贵阀，或拥旄旌。\n独穷玄□，不滑神精。\n兵墟故国，蓬转扬声。\n教承瑕翕，振铎千龄。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其四十五 盖公","author":"黄省曾","text":"嬴末龙争，奋图封拜。\n伟矣盖公，迟栖东海。\n无为教参，齐方底泰。\n衍辅汉庭，玄风犹在。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其四十六 四皓","author":"黄省曾","text":"皇皇四老，同襟齐志。\n远虞蓝田，芝粮萝被。\n弗凿天真，重归地肺。\n隆准膺图，空劳聘币。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其四十七 黄石公","author":"黄省曾","text":"何者老翁，托名黄石。\n蚤鉴留侯，脱履令拾。\n玉韬金版，授之不惜。\n定帝谋王，谷城留迹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其四十八 鲁二徵士","author":"黄省曾","text":"姬鲁两生，孔庭遗学。\n叔孙佐命，仪声乃作。\n谓方荆棘，难兴礼乐。\n弗纳玄纁，翱飞寥廓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其四十九 田何","author":"黄省曾","text":"商瞿授易，桥馯周孙。\n子庄嫡继，孔脉绳绳。\n一移客土，四嗣俱兴。\n亲劳万乘，造拜轨经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其五十 王生","author":"黄省曾","text":"硕以王生，道研轩李。\n斐尔张公，素交一臂。\n袜解虚庭，趋风敬系。\n凡百华裾，悉高廷尉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其五十一 挚峻","author":"黄省曾","text":"京兆伯陵，□峰屏躅。\n太史腾书，兴言报复。\n知足无虞，守玄袪辱。\n居士灵祠，春秋自续。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其五十二 韩福","author":"黄省曾","text":"北郡韩福，洁白修躬。\n博陆调鼎，乃下旌弓。\n疾稽中驿，帛奖幽踪。\n荷衣鸠杖，陶陶令终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其五十三 成公","author":"黄省曾","text":"成公全朴，称谓不传。\n途遭玉辇，峻峙幅边。\n□归方外，克免帝愆。\n书郎乃遣，茅户乞言。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其五十四 □丘望之","author":"黄省曾","text":"安丘丈人，中林自命。\n龙位来师，豹潜逾劲。\n岐业周流，老编删定。\n振教玄玄，道家衡镜。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其五十五 宋胜之","author":"黄省曾","text":"胜之敦孝，聚居风动。\n力施衰白，食损姻众。\n附姊饔飧，拒兄录用。\n独综弦歌，羲光是弄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其五十六 张仲蔚","author":"黄省曾","text":"仲蔚遐轮，景卿并辙。\n洞探乾曜，兼长椠业。\n阖户栖神，荆楱掩绝。\n尘鉴何知，馨光不灭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其五十七 严遵","author":"黄省曾","text":"君平卖卜，子云所师。\n?文是阐，乃作指归。\n牧不可屈，钱常有馀。\n真人淡泊，亶哉匪虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其五十八 彭城老父","author":"黄省曾","text":"彭城老父，陆沉皓首。\n炎鼎将移，麟搉凤蹂。\n吊哭低回，曾非侪友。\n薰膏之规，哲士宜守。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其五十九 韩顺","author":"黄省曾","text":"世道交丧，子良隐息。\n宁极青山，耻歌白石。\n求于井蛙，责之负笈。\n兔戮狐收，泰然林泽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其六十 郑朴","author":"黄省曾","text":"谷口子真，甘恬秉默。\n非服弗服，非食弗食。\n不荅徵车，为农草泽。\n吁嗟法言，撰其玄德。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其六十一 李弘","author":"黄省曾","text":"仲元所居，俗用拭新。\n授之百里，非其素情。\n中途遁绝，卒老高深。\n先英评许，未悉玄真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其六十二 向长","author":"黄省曾","text":"子平上哲，赋德渊冲。\n玩辞观象，损退自崇。\n伉男俪女，家务不综。\n周攀五岳，禽老是同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其六十三 闵贡","author":"黄省曾","text":"仲叔高栖，藏宝迷国。\n一介弗取，卓然贞白。\n□牒司徒，寄形安邑。\n枯槁当年，风流九域。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其六十四 □霸","author":"黄省曾","text":"儒仲处英，放独新世。\n光武中兴，守礼不试。\n草覆野耕，甘于沈翳。\n贤室高明，济成遁事。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其六十五 严光","author":"黄省曾","text":"吁嗟子陵，少与龙潜。\n飞腾天位，书玉连连。\n北军亲就，内榻同眠。\n富春之滨，客星皎悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其六十六 牛牢","author":"黄省曾","text":"君直峻守，耻交万乘。\n清夜片言，终身为信。\n卯金复兴，币玉不应。\n葆盖煌煌，遵庐慰问。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其六十七 东海隐者","author":"黄省曾","text":"隐者閒旷，避世沧瀛。\n其友树节，乃饵华缨。\n进轻退促，举动不经。\n交携长绝，时议所钦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其六十八 梁鸿","author":"黄省曾","text":"伯鸾者何，脩远之子。\n介耻攀龙，贫资畜豕。\n仰颂逸民，庶追芳趾。\n贞配孟光，骨埋吴土。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其六十九 高恢","author":"黄省曾","text":"高恢总发，道德是求。\n伯鸾齐志，泉石胥游。\n东飞西驻，歌以写忧。\n形容万里，远蹈同流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其七十 台佟","author":"黄省曾","text":"孝威特迈，税趾武安。\n兽居土室，不愿弹冠。\n郡公温劳，有语足宽。\n终龄超遂，大璞得完。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其七十一 韩康","author":"黄省曾","text":"伯休谢俗，斸药青冥。\n通都树价，细女举名。\n飘然改业，遐蔽霸陵。\n佯随国聘，俄蹈虚真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其七十二 丘欣","author":"黄省曾","text":"季春傲俗，自矜无伍。\n国守逢迎，翩翩凤止。\n宠禄尘如，清言烂吐。\n鄙尔扶风，谁攀冠屦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其七十三 矫慎","author":"黄省曾","text":"仲彦鸾扬，孤翔不娶。\n友牍殷勤，淡无应□。\n□岛寻仙，还家告逝。\n复见他邦，的然灵异。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其七十四 □棠","author":"黄省曾","text":"季卿懿资，弘通卜艺。\n超峙区表，弃荣绝利。\n庞守来瞻，默形三谕。\n凤色鸿姿，图传乡地。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其七十五 挚恂","author":"黄省曾","text":"挚氏之恂，光于祖德。\n博贯无伦，幽潜不惑。\n声薄九霄，经传四国。\n乐矢弗谖，空劳物色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其七十六 法真","author":"黄省曾","text":"高卿宿学，门众纷如。\n功曹面却，孤峻所希。\n再荐知己，四下鸾书。\n杳然长绝，德撰穹碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其七十七 汉滨老父","author":"黄省曾","text":"汉滨老父，操锄沔上。\n翠华雷动，不屑瞻仰。\n台臣屈问，理辩如响。\n俯首含羞，匆匆尘鞅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其七十八 徐稚","author":"黄省曾","text":"孺子清妙，超绝代俗。\n屡辟鸿臣，不瑕皎玉。\n万里赴丧，炙鸡茅束。\n以力粥饘，安安自足。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其七十九 夏馥","author":"黄省曾","text":"八顾夏馥，不通纨绮。\n抱影烟霞，灰情辟举。\n秦网载张，天形遂毁。\n客作将终，固迎归止。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其八十 郭太","author":"黄省曾","text":"介休林宗，行师伯彦。\n庐膳常虚，躬衣不掩。\n察观乾象，怀珍高卷。\n有道之碑，扬光竹简。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其八十一 申屠蟠","author":"黄省曾","text":"子龙尚节，抗论生枯。\n博经举贽，殡友浮河。\n榜标初炽，独叹坑虞。\n巢依梁砀，得以安歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其八十二 袁闳","author":"黄省曾","text":"汝南夏甫，杜门深处。\n日朝母氏，挥绝宾侣。\n科头自放，不闲俗礼。\n长歌白驹，逍遥桑梓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其八十三 姜肱","author":"黄省曾","text":"伯淮英朗，经通纬治。\n四海抠衣，多齐孔氏。\n□使图形，幽房韬被。\n碧海浮桴，青州逃世。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其八十四 □宁","author":"黄省曾","text":"宁也何自，管仲之孙。\n片金弗顾，割席远歆。\n龙德既显，豹隐是徵。\n甘心玄寞，郡阁图形。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其八十五 郑玄","author":"黄省曾","text":"康成蚤颖，博极群典。\n得五马门，大道是勉。\n几授尊高，杯崇温俨。\n八尺之躯，终焉闭敛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其八十六 任安","author":"黄省曾","text":"定祖儒流，世有赞言。\n披求迁传，感激仲连。\n性情咸得，出去忧缠。\n清虚无染，圭组永捐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其八十七 庞公","author":"黄省曾","text":"庞公真隐，志凌冰雪。\n弗慕荣华，自宁巢穴。\n遗与人殊，身于世绝。\n茹秀鹿门，欣怡云月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其八十八 姜岐","author":"黄省曾","text":"子平幼孤，俞俞守道。\n功曹爰致，托疾以报。\n守计劫迫，尹邮宣救。\n牧豕调蜂，天涯啸傲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其八十九 荀靖","author":"黄省曾","text":"八龙矫首，里署高阳。\n叔慈抚化，物外游翔。\n终身肥遁，至宝含章。\n玄昭二谥，永世遗芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其九十 胡昭","author":"黄省曾","text":"胡昭高尚，不事袁曹。\n陆浑之下，耕诵逍遥。\n乐亭相誓，由免奔骚。\n群贤递荐，巳入冥寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高士颂九十一首 其九十一 焦先","author":"黄省曾","text":"孝然奇士，少避白波。\n食草啜水，露寓于河。\n色妹翳体，伐国谬歌。\n饥寒待尽，风节高峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二陶赞二首 其一","author":"黄省曾","text":"陶潜渊明，浔阳柴桑。\n宅有五柳，偃息北窗。\n亲老家贫，自解祭酒。\n州辟主簿，躬耕不就。\n刺史檀君，道济□候。\n梁肉之馈，麾而不受。\n弦歌彭泽，耻彼折腰。\n归□来兮，我歌且谣。\n故人延之，过必停车。\n留钱二万，悉送酒家。\n琴无素弦，菊有黄华。\n义熙为文，年书晋氏。\n永初以来，唯云甲子。\n至于元嘉，噫先生逝。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二陶赞二首 其二","author":"黄省曾","text":"弘景通明，丹阳秣陵。\n读葛洪书，志于养生。\n终身不娶，朗目秀形。\n齐高汲引，朝请朱门。\n挂服神武，诏给松芩。\n立馆句曲，隐居代名。\n读书万卷，尤明五行。\n人歌丑木，表至新林。\n梁武资给，朱砂黄金。\n吉凶征讨，靡不咨询。\n山中宰相，参候公卿。\n集注者何，论语孝经。\n告逝而逝，香气氛氲。\n其谥维何，贞白先生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游槜李城赞","author":"黄省曾","text":"禹枝稷裔，密为邻奠。\n王泽替夷，师革乃擅。\n宗隳七七，霸成一战。\n往业俱销，遗墟慨见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]