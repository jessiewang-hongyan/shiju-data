[{"title":"为僧朗碧天题扇寄人","author":"史鉴","text":"玉篪峰下雨来时，索我闲吟寄远诗。\n蕉叶满庭松子落，竹林啼鸟豆花垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10606,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题僧善权画","author":"史鉴","text":"倪迂死后犹存画，权袖图成更有诗。\n头白云卿重题品，董元曾是巨然师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10607,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"邦彦饮湖上暮归过保叔大呼求见因赍酒出寺饮之以诗送别","author":"史鉴","text":"半山遥听故人歌，枉驾能为晚寺过。\n饮酒莫辞还秉烛，重来花事恐无多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10608,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"断桥分手次刘邦彦韵 其一","author":"史鉴","text":"日暮桥边酒棹回，更因残唱送馀杯。\n人生易老春光暮，能为看山几度来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10609,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"断桥分手次刘邦彦韵 其二","author":"史鉴","text":"近水人家半掩扉，两山楼阁尚斜晖。\n断桥无数垂杨柳，总被游人折渐稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10610,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"子昂兰","author":"史鉴","text":"国香零落佩纕空，芳草青青合故宫。\n谁道有人和泪写，托根无地怨东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10611,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"口号","author":"史鉴","text":"黄鸟嘤嘤柳絮飞，送君无计伴君归。\n一春买遍金陵酒，落尽红香万绿肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10612,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悼轩公","author":"史鉴","text":"东风吹雪沁春泥，曾倩吴僧半榻栖。\n惆怅重来不相见，野禽飞上曲阑啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10613,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悼轩公三首 其二","author":"史鉴","text":"青山无数海无涯，城郭逶迤带岸斜。\n宿草寒云迷望眼，不知何处葬袈裟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10614,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"悼轩公三首 其三","author":"史鉴","text":"东楼共倚雪初深，静夜名香伴醉吟。\n今度风光又如旧，千家灯火閟春阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10615,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴廷晖水榭二首 其一","author":"史鉴","text":"花蹊柳浪带回溪，碧簟眠风近鸟啼。\n芰荷出水青青小，频语行舟棹过西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10616,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴廷晖水榭","author":"史鉴","text":"溪声到枕惊春梦，露气入帘生夜寒。\n自起开门看明月，和花移过曲阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10617,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题僧扇二首 其一","author":"史鉴","text":"湖水泠泠山日低，上方台殿古城西。\n春游记得前年事，醉卧竹房听鸟啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10618,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题僧扇二首 其二","author":"史鉴","text":"乌啼花落自年年，古寺依然野水边。\n惆怅旧游零落尽，几多心事不如前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10619,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"刻丝牡丹","author":"史鉴","text":"中原新尚女真黄，姚魏含羞怨夕阳。\n谁挽春风上机杼，又随番使过钱塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10620,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"塞下曲 其一","author":"史鉴","text":"城下黄河城外山，羌儿骑马唱歌还。\n碛西亦有闲花草，莫信春光不度关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10621,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"塞下曲二首 其二","author":"史鉴","text":"衰草茫茫古塞平，昔人曾此筑长城。\n西风吹卷胡尘起，吹入中原损汉兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10622,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张方洲","author":"史鉴","text":"草浅花娇溪水新，东风酿作野亭春。\n相思明日重来此，只见花枝不见人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10623,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题扇","author":"史鉴","text":"水绕青山去复回，有时浮送落花来。\n东风吹乱垂杨柳，欲倩游人为解开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10624,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上暮归","author":"史鉴","text":"鸭群呼去水云空，香滴荭花露气浓。\n僧寺茫茫看不见，暮烟生处忽闻钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10625,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和答吴廷晖 其一","author":"史鉴","text":"竹径阴阴厚绿苔，荜门长日未曾开。\n春风是处皆花柳，那得閒心去看来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10626,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和答吴廷晖 其二","author":"史鉴","text":"一春多雨更多风，犹有残花茂草中。\n纵使君来不堪赏，冷香和露泣微红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10627,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴鸣翰湖上 其一","author":"史鉴","text":"红尘不到三山远，家住蓬壶镜里天。\n隔浦落花双屐雨，过门流水一溪烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10628,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄西杭钮进之","author":"史鉴","text":"西湖湖上水初生，重叠青山接郡城。\n记得扁舟载春酒，满身花影听啼莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10629,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春陪陈太常西湖宴集","author":"刘英","text":"六桥柳色翠迷津，画舫迟移送酒频。\n醉眼不知三月暮，赏心又度一年春。\n莺谐急管催歌板，燕蹴飞花堕舞裀。\n年少莫将行乐误，坐中半是白头人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10630,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春兴","author":"刘英","text":"一天微雨送清明，岁岁逢春不快晴。\n近水人家多养鸭，依山楼阁早闻莺。\n子期不用黄金铸，颜驷空嗟白鬓生。\n惟有东风一尊酒，朝朝相对药阑倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10631,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵姚公绶舟中夜话","author":"刘英","text":"银烛楸枰对弈棋，乌丝茧纸更题诗。\n月明邻舫人眠早，鼓绝江城漏下迟。\n断饮顿忘犀首乐，放怀偏笑虎头痴。\n朝来欲别应难别，未了山中笋蕨期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10632,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"载酒过湖","author":"刘英","text":"寒食清明次第来，紫苞红萼裹池台。\n东风似与人商量，最好花教最后开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10633,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次沈陶庵题石田有竹庄韵","author":"刘英","text":"爱汝东庄多种竹，旁人错认是湘川。\n敲门僧立秋阴里，避雨猿啼屋角边。\n最喜谈诗挥白拂，间因憩树濯清泉。\n相过定与髯张约，同棹轻舟破暝烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10634,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪夜招文永嘉宗儒饮承宗儒和诗再答","author":"刘英","text":"同云漠漠护深斋，兴到从教漏点催。\n寒色照人知霰集，疏花有喜傍灯开。\n平生漫说诗千首，一饮还能酒百杯。\n明日雪晴山满目，更开溪阁待君来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10635,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宝峰僧楼看沈启南画因怀画中诗人存殁","author":"刘英","text":"寻僧重上宝峰楼，对景兴怀不自由。\n东海伤心诸老散，西湖回首十年游。\n摩挲旧画题新句，惭愧青山对白头。\n空负梨花一尊酒，无人共载木兰舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10636,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上元十三夜","author":"刘英","text":"近喜元宵雪更晴，千门翠竹结高棚。\n珠帘半卷将团月，玉指初调未合笙。\n新放华灯连九陌，旧传金钥启重城。\n少年结伴嬉游去，遮莫鸡声下五更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10637,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十四夜","author":"刘英","text":"灯光渐比夜来饶，人海鱼龙混暮潮。\n月照梅花青琐闼，烟笼杨柳赤阑桥。\n钿车过去抛珠果，宝骑重来听玉箫。\n共约更深归及早，大家明日看通宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10638,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十五夜","author":"刘英","text":"一派春深送管弦，九衢灯烛上薰天。\n风回鳌背星球乱，云散鱼鳞璧月圆。\n逐阵马翻尘似海，踏歌人盼夜如年。\n归迟不属金吾禁，争觅遗簪与坠钿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10639,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次沈陶庵题石田有竹庄韵","author":"沈宣","text":"休文家在阳湖住，湖有璟绩似渭川。\n险韵刊诗留节下，凉阴牵梦堕鸥边。\n无人厌俗狂题凤，有客敲门共饮泉。\n负我十年开径入，相思空隔满林烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10640,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次陈沧洲重阳韵","author":"张渊","text":"置却功名土苴间，沧洲长与白鸥闲。\n到门秋水当天坐，绕屋芦花带雪关。\n明月满川惟载鹤，清江一笛正看山。\n只惭碌碌东西者，赢得流年损壮颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10641,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋兴次韵","author":"张渊","text":"识来三十四年非，珍重山林短后衣。\n龟背刮毛惭我拙，虎头食肉任人飞。\n老亲种种垂秋发，旧屋萧萧淡夕晖。\n办得浮家明日去，五湖处处是渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10642,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题白石翁画虞山古桧","author":"张渊","text":"虞山老桧三株青，斗坛半掩招摇星。\n道人丹成化鹤去，三桧夭矫飞龙形。\n是谁手植经千载，曾见昭明读书在。\n几回天上葬神仙，不独人间变桑海。\n古人今人绕树行，古今人去树长生。\n乃知劲气合元化，不与凡木争枯荣。\n长洲老石好异者，百里携杯游树下。\n浩嗟天下有树此树无，我去此树何人图？\n三日经营双眼力，满空苍翠移真迹。\n鹤骨虬筋左纽文，雷裂霜皴古秋色。\n日暮袖归归不得，满山风雨山灵惜。\n居然赠与卧云人，长啸寒风生石壁。\n于乎！\n石君诗画天下知，此笔尤为天下奇。\n劝君风雷当掩户，恐化蛟龙擘空去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10643,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵沈陶庵题有竹庄","author":"张渊","text":"爱汝石田茅屋好，依然风物似斜川。\n白蘋洲渚沧江外，红树园林夕照边。\n艇子打鱼偏趁月，山童洗药每临泉。\n老夫欲问东家住，分取瓜畴数亩烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10644,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题林和靖秋深二帖与石田同用坡韵","author":"张渊","text":"乾坤悠悠书两幅，墨光深照西湖渌。\n人间番覆似浮云，此纸完全如璧玉。\n少陵瘦硬真入评，右军姿媚宜云俗。\n想当援笔对梅花，谁用官奴寒把烛。\n自然心画得天妙，一字百金酬不足。\n乃知形貌列仙癯，石带烟霞山少肉。\n岩岩气节高百世，奚假文章身后录。\n东坡去后古祠荒，月下不闻迎送曲。\n遗迹君家岂偶然，天遣清风激修竹。\n凭君开卷望孤山，三灌蔷薇咀秋菊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10645,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题林君复二帖用坡韵","author":"陈颀","text":"我昔孤山访遗躅，春暖西湖泛晴渌。\n山头草树不荒凉，知是先生此埋玉。\n念初茅庐结构完，长吏频顾惊流俗。\n就中薛李最忘形，湖上夜归曾秉烛。\n先生自乐味道腴，此怀何尝忘不足。\n惟当吟咏苦嚘咿，役扰心兵削肌肉。\n诗成又复恐惊世，辄毁不使相誊录。\n谁知造化难尽藏，千古骚坛传妙曲。\n亦有遗墨落人间，留在剡藤并楚竹。\n见其瘦硬想其人，似对灵均餐落菊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10646,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题石田小景","author":"陈颀","text":"齐女门北古塘斜，岸苇无穷杂蓼花。\n此地往来应惯熟，借书常到邺侯家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10647,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白沟次东之金台韵（又见《储柴墟集》）","author":"黄云","text":"西山郁高寒，青绕燕代阔。\n我行春已深，絮纩尚未脱。\n平生四方志，眼底才圭撮。\n区区白沟河，编简不能剟。\n经涞流渐广，赴海倾莫遏。\n欲渡仍徘徊，缅怀开运末。\n兹惟辽晋疆，终古抱嗟咄。\n天公愤余腥，老雨夜来泼。\n堂堂十六州，幅员一朝割。\n桑君漫周旋，国旱尔为魃。\n中原杀戮尽，胡忍犬美括。\n哀哉黄龙府，回首饭无钵。\n横流到靖康，戎马屡南跋。\n往事勿具陈，忧竞猝难豁。\n居人讳言兵，唯记粘与曷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10648,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"萧斋坐雨感怀书事二首 其一","author":"黄云","text":"三月琴川四月还，虞山佳处尽跻攀。\n曾于拂水岩头望，一塔烟中认玉山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10649,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"萧斋坐雨感怀书事二首 其二","author":"黄云","text":"残书遍阅就窗明，少畅闲情赖鸟声。\n断送春归花事了，一番细雨绿阴成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10650,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"唐伯虎","author":"黄云","text":"走马春城遍绿烟，挥金随处拥婵娟。\n自家花样天机杼，笑领蓬莱第一仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10651,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"日夕","author":"黄云","text":"寂居山之阿，木叶明返照。\n阴厓凝晚色，余霞尚鲜耀。\n远心望烟海，孤兴凌仙峤。\n归牧驱牛马，溪船罢渔钓。\n闭门归动息，默以领众妙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10652,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"常熟致道观七星桧","author":"黄云","text":"琴川古迹得纵观，七桧象斗罗仙坛。\n真人手植自梁代，燧人之火不及钻。\n成形成象两昭应，斟酌元气其无端。\n阴敷古殿覆玉座，星宫瞻天肃圣颜。\n侍女左右更修洁，仙袂欲举垂云鬟。\n坚贞铿戛悟玄理，至文无文朴反顽。\n深根穿散福地脉，万牛挽之并力难。\n雷雨藏蓄太阴黑，骨节显露莓苔干。\n偃仰诘屈更披折，矫若撑拄郁若盘。\n猿臂争攫凌险绝，鹤形孤高梳羽翰。\n大小斧劈惜皴裂，赤皮含生细叶攒。\n萧森夜拂箕尾动，耸拔昼涵湖腹宽。\n索绹绞纽互联络，风涛鼓舞交苍寒。\n角崩爪秃龙虎斗，鲲化海翻鹏快抟。\n鬼神出入倏忽际，厥状诡异穷莫殚。\n时逢有道天锡瑞，甘露履降和井丹。\n真人上仙念下土，架虬归来乐盘桓。\n浩歌适应金石响，楼居合共朝霞飧。\n酒泻天瓢不可挹，与山并峙青巑岏。\n仙标出尘几千丈，拟作蓬莱玉树看。\n傲兀阅世间荣瘁，卦之剥复时危安。\n铜驼荆棘仍变故，其上日月跳双丸。\n蜀柏犹能尊汉统，岱松宁免污秦官。\n青牛已随紫气远，孔桧系道遭摧残。\n偶然托迹仙境静，此后历数知如干。\n毕宏韦偃久绝笔，白石老子图冰纨。\n我生好古聊纪咏，豪奇安得追苏韩。\n置像亦如楚颂橘，石厓磨镌垂不刊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10653,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"林先生官舍新成","author":"黄云","text":"燕雀纷来贺落成，成行花竹表官清。\n邻家或过墙头酒，山木频啼谷口莺。\n雨涨碧溪春浪细，日斜青壁晚霞明。\n一醒一醉胡然异，怀抱寻常得尽倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10654,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再次韵","author":"黄云","text":"济时勋业已无成，堆案图书境界清。\n黄落素秋归社燕，绿阴朱夏语流莺。\n宦情自向衰年薄，山色还同故国明。\n混迹渔樵真吏隐，日携吴酒对君倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10655,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴江王氏月湖","author":"黄云","text":"水云千顷浩无边，萧爽微芃扫翳烟。\n海底鱼龙还出没，夜深河汉亦澄鲜。\n倒披宫锦淋漓醉，快展湘云放浪眠。\n逸兴遄飞鸥梦远，流光孤洁照沉渊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10656,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中书事","author":"黄云","text":"病里仍愁四十过，学书学剑两蹉跎。\n白翻野饭炊粳稻，绿染秋衣制芰荷。\n远道西风吹客鬓，空江暮雨湿渔蓑。\n村醪急办青钱买，儿女灯前且笑歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10657,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题春草图","author":"黄云","text":"野烧痕回一雨过，村童放牧散平坡。\n祢衡洲畔埋愁远，建业城边积恨多。\n谁见夜深嘶石马，那知岁久没铜驼。\n江淹赋别魂销处，春水遥连漫绿波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10658,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次吴工部夜集韵兼述鄙意","author":"黄云","text":"脱帻掀髯折堕簪，语长真似吐丝蚕。\n乞身岂待三宜去，养寿应无七不堪。\n屈产昔曾空冀北，人生只合住江南。\n赓诗赖有梅花主，吟处宜题退隐庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10659,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日书事寄吴水部德徵","author":"黄云","text":"夏木垂阴覆小堂，图书生润日消长。\n遗音过耳栗留语，余馥清心薝卜香。\n懒仆畬田耕卤莽，顽儿越户步踉跄。\n行吟坐睡多闲适，自至南风足午凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10660,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和唐愚士会稽怀古诗三首 其一 铸浦次韵","author":"戴冠","text":"耶溪不须深，产铜当自名。\n堇山不须高，产锡当自灵。\n上有云雾合，下有蛟龙争。\n昔人此铸剑，分明载图经。\n六丁互烹炼，百妖失依凭。\n汀蒲露纤锷，猎猎刚风生。\n渚莲挺长铗，濯濯垂朱英。\n尚疑雌雄合，时觉波涛惊。\n秋霜生杀气，秋波湛虚清。\n星斗忽在地，光芒射浮萍。\n佩之临四夷，惊落旄头星。\n请之斩邪佞，伊谁敢纵横。\n但恨无张华，穷渊夜冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10661,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和唐愚士会稽怀古诗三首 其二 严子陵墓次韵","author":"戴冠","text":"君臣垂令名，千载不偶然。\n先生固尚志，光武亦下贤。\n斯人化去久，惟有丘陇存。\n髑髅已成泥，清风播椒兰。\n先生汉之龙，当与造化旋。\n胡为抱明珠，终身堕深渊。\n云台空自高，视之若轻烟。\n归耕富春山，高卧无迍邅。\n服我羔羊裘，还君鵔鸃冠。\n脱去金笼头，不受牧者鞭。\n滩水清见石，客星长在天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10662,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和唐愚士会稽怀古诗三首 其三 沃州山次韵","author":"戴冠","text":"我从天姥游，层云荡胸臆。\n遥见海上山，天际青历历。\n俯视崖下松，一一骈拇直。\n飞鸢凌长风，欲度忧折翼。\n洞黑不敢前，恐有蛟龙匿。\n霞明石室丹，泉挂水帘白。\n兹游足奇观，此见太古色。\n初疑补天余，炼成五色质。\n又疑天柱折，遗此数千尺。\n倚空何崔嵬，卓地亦奇特。\n昔贤隐兹山，至今人爱惜。\n辽辽千载下，隐者何寂寂。\n山川固依然，世变良可恻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10663,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿迁","author":"陈蒙","text":"古邑临河水，昏鸦噪县门。\n四方争集市，三户自成村。\n禾黍秋风陇，牛羊落日原。\n客愁千万种，辛苦向谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10664,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题石田翁赠朱守拙小景","author":"陈蒙","text":"野藤刺水竹篱斜，落尽东风枳壳花。\n日午不闻茶臼响，春城买药未还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10665,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻笛","author":"陈蒙","text":"落尽梅花雪满庭，故园杨柳梦中青。\n羌儿马上传来曲，今夜关山月里听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10666,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"风雨中忆含桃","author":"薛章宪","text":"含桃摘后已无多，更耐风狂雨横何。\n纵有绀跗垂弱蒂，分无丹颗缀柔柯。\n朱唇失绛羞樊素，赪颊啼红泣苎萝。\n想见流莺正无赖，应同老子共悲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":10667,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]