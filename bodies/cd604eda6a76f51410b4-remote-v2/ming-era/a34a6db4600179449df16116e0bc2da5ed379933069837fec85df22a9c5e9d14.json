[{"title":"侍泉翁尊师游罗浮步韵","author":"霍与瑕","text":"仰止罗浮积岁年，今来得拜洞中仙。\n一双木屐踏歌遍，始觉诸天总一天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出都门口占别家兄","author":"霍与瑕","text":"偷得南楼半月閒，营车驿马又间关。\n欲知后夜相思处，银汉星河月一弯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊淮","author":"霍与瑕","text":"月白沙明春满天，抱将明月伴春眠。\n从来马上艰难曲，不入江南浪子船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"慕溪黎子别号也父曰一溪故曰慕溪云 其一","author":"霍与瑕","text":"千树桃花蘸武溪，东风芳草绿萋萋。\n重来踪迹无寻处，肠断渔郎思欲迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"慕溪黎子别号也父曰一溪故曰慕溪云 其二","author":"霍与瑕","text":"碧溪洞里水潆洄，红树枝边花乱开。\n出洞再来迷旧路，满山惟有绿封苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"楼居书怀","author":"霍与瑕","text":"大隐金门独上楼，东风翘首蓟阳州。\n美人学制机中锦，尽日不成祇自愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游罗浮和宝潭十绝 其一","author":"霍与瑕","text":"乱峰四百远开屏，重蹑丹崖短屐轻。\n无限风光谁管领，白云红树接沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游罗浮和宝潭十绝 其二","author":"霍与瑕","text":"十年江畔老容颜，吟弄云山水石间。\n此日罗浮寻旧约，同袍欣共浥清澜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游罗浮和宝潭十绝 其三","author":"霍与瑕","text":"流水高山空自音，子期伤碎伯牙心。\n天华回首西樵外，隔断寒江万顷深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游罗浮和宝潭十绝 其四","author":"霍与瑕","text":"罗浮山下似鸿濛，身在半晴半雨中。\n笑向梅花村口过，一声清唱太豪雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游罗浮和宝潭十绝 其五","author":"霍与瑕","text":"篮舆冲雨陟间关，百里莎茵送往还。\n寄语王孙莫归去，春风今始到青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游罗浮和宝潭十绝 其六","author":"霍与瑕","text":"四贤祠下盖如飞，迢递东风雨色微。\n斗酒只鸡山叟共，亦邀元老顾柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游罗浮和宝潭十绝 其七","author":"霍与瑕","text":"梅花开尽又桃花，谁向桃源更问家。\n此是桃源最佳处，春深云水足生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游罗浮和宝潭十绝 其八","author":"霍与瑕","text":"读书台畔碧桃花，春归摇落半溪霞。\n冼郎归去知何在，欲问深山吠犬家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游罗浮和宝潭十绝 其九","author":"霍与瑕","text":"信脚青霞碧涧前，不知身世在诸天。\n岩头一宿饶清梦，睡碎梅花实可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游罗浮和宝潭十绝 其十","author":"霍与瑕","text":"藤蓑洗雨翠重重，舞月披霞到太空。\n身远尘凡三万里，是水晶国是苍穹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迎春示冯秀才","author":"霍与瑕","text":"春日迎春春事殷，春诗裁付小冯君。\n春花春柳春如许，不著春鞭将送春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋堂独坐","author":"霍与瑕","text":"小坐山堂月上迟，木犀香断菊离披。\n寒蝉抱露声如咽，人不悲秋秋自悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别馆都春 其一","author":"霍与瑕","text":"天孙别院锦成云，占断明都万有春。\n一样东风花几种，不堪啼鸟更撩人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别馆都春 其二","author":"霍与瑕","text":"春园日暖莺声好，春殿月明花影低。\n楚客伤春浑未赋，东风那得送春归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别馆都春 其三","author":"霍与瑕","text":"花枝照水檠红艳，荷叶凌波送远香。\n春去几时春自在，晚风聊此纳新凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别馆都春 其四","author":"霍与瑕","text":"蟋蟀池塘风阵阵，凤凰箫管夜沉沉。\n城西未落三更月，春恨谁缄万里心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别馆都春 其五","author":"霍与瑕","text":"亭台霁雪月如银，谁道阳和布未匀。\n好趁梅花装彩胜，长官明日此迎春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别馆都春 其六","author":"霍与瑕","text":"四明仙子好留题，勾押春风入院齐。\n我亦旧时梁苑客，心随春事到江西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清溪夜泊","author":"霍与瑕","text":"清溪山驿夜维舟，沙白江寒带月流。\n知到故园馀照在，有无人上盍簪楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"濛?","author":"霍与瑕","text":"二更山月照江清，十五以来夜夜明。\n遥想雁行俱得意，静虚堂上答歌行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曲江","author":"霍与瑕","text":"日日蒹葭绿满船，不堪秋色浩无边。\n江深路远思乡苦，更见三更月上天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曲江谒先师甘泉精舍","author":"霍与瑕","text":"翩翩黄蝶不知秋，还伴征人岭外游。\n最是横经旧时地，寂寥荒草满山愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚泊","author":"霍与瑕","text":"青草黄茅尽日閒，画船吹角度秋山。\n晚江又逐渔翁伴，九里十三抛口湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦旱","author":"霍与瑕","text":"禾黍高低尽欲焚，谁将清恨诉苍旻。\n扁舟十日韶江道，如许山川不作云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻鹧鸪","author":"霍与瑕","text":"昔年春山闻鹧鸪，今年秋山闻鹧鸪。\n廊庙江湖行尽得，不知軥格为谁呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步韵送古林何老先生北上 其一","author":"霍与瑕","text":"讲学南昌又几秋，忽惊丹诏下青楼。\n江门风月伊周业，山自巍巍水自悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步韵送古林何老先生北上 其二","author":"霍与瑕","text":"五彩龙文瑞气横，少年天子御天行。\n定知宴语从容后，询遍闾阎困苦情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步韵送古林何老先生北上 其三","author":"霍与瑕","text":"谁云京国路迢迢，一道长虹驾玉桥。\n正是风云新际会，好将霖雨答清朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步韵送古林何老先生北上 其四","author":"霍与瑕","text":"先觉天民何处归，纷纷谏柳尚多违。\n知公论政论人外，别有忘言杜德机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步韵送古林何老先生北上 其五","author":"霍与瑕","text":"长风万里起沧波，画舫行春喜气多。\n堪羡道人无一事，浩歌清夜对姮娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步韵送古林何老先生北上 其六","author":"霍与瑕","text":"登山临水太从容，踏尽寒梅岁律终。\n管领春风归帝里，也曾披拂到蒿蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步韵送古林何老先生北上 其七","author":"霍与瑕","text":"病来纱帽半封蛛，回首交游叹耳馀。\n风力羡公抟九万，翻云为扫过空虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步韵送古林何老先生北上 其八","author":"霍与瑕","text":"春深珠海郁洲前，莎暖凫鹥对对眠。\n茂育祇今谁妙手，新诗题寄思茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"豁然楼燕集 其一","author":"霍与瑕","text":"绿野堂开绿水滨，烟花三径足清真。\n蓬莱东去无多远，我欲从公一问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"豁然楼燕集 其二","author":"霍与瑕","text":"凤凰山色正苍苍，背郭流光到小堂。\n有客频来开野宴，主人应不厌清狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12957,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"豁然楼燕集 其三","author":"霍与瑕","text":"连日重登大隐堂，浃旬阴雨见微阳。\n花枝浥露乌啼慢，人不伤春春自伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12958,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"豁然楼燕集 其四","author":"霍与瑕","text":"烂熳芳园燕子忙，为愁春事已将相。\n三旬积雪初晴霁，乱把香坭上画梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12959,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠微歌 其一","author":"霍与瑕","text":"千山过雨春寒薄，梅花吹落秋枫阁。\n半仙来往几多时，相思树底鸬鹚勺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12960,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠微歌 其二","author":"霍与瑕","text":"翠微村远云容薄，肩舆渺渺孤山阁。\n山翁打猎晚归来，野味纵横倾大勺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12961,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠微歌 其三","author":"霍与瑕","text":"插秧儿女春衫薄，远望官人齐手阁。\n芝山莫更往东行，潮水涨溪妨午勺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12962,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠微歌 其四","author":"霍与瑕","text":"自嗤涉世才疏薄，盘城有样雄投阁。\n未老蒙恩归去来，绿竹红蕖引清勺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12963,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺高明尹 其一","author":"霍与瑕","text":"满轮皓彩飞明镜，乌啼夜半千山静。\n城上传更鼓角齐，叩关行旅候鸣鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12964,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺高明尹 其二","author":"霍与瑕","text":"南海高明接近邻，每闻行客说神君。\n一堂风月人如玉，四野农桑簇新绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12965,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺高明尹 其三","author":"霍与瑕","text":"新成雁塔照黉宫，千秋万岁耸文峰。\n帝城春昼花如绮，多是公门杞与李。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12966,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中吟 其一","author":"霍与瑕","text":"二月多烟三月风，山花多是满冈红。\n一囊收取春光尽，付与奚奴寄大同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12967,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中吟 其二","author":"霍与瑕","text":"读易灯残咽草虫，唱歌閒步月明中。\n秋山静夜无人过，一犬时惊桂子风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12968,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜登樵 其一","author":"霍与瑕","text":"凄风溢九霄，夜步陟西樵。\n水落江寻丈，山空月寂寥。\n秋气兼寒暑，松声散远遥。\n美人隔烟渚，相思不可招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12969,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜登樵 其二","author":"霍与瑕","text":"陟陟冲云路，行行度石桥。\n月光分树影，岚气合山腰。\n独步乾坤静，浩歌海岳摇。\n水晶仙界近，应须到上霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12970,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜登樵 其三","author":"霍与瑕","text":"园林经岁别，怀抱入秋深。\n乘潮频鼓楫，带月一登临。\n久旱泉全涸，微霞树半阴。\n逍遥云路外，寒风忽以侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12971,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜登樵 其四","author":"霍与瑕","text":"千峰明月遍，只影入山孤。\n人远庐犹在，秋深草半枯。\n登堂歌璧韵，开阁检图书。\n睹物怀无限，清霜寒切肤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12972,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"下第自遣","author":"霍与瑕","text":"十载无知己，三旬下第身。\n春风堪堕泪，杨柳总伤神。\n归去云山好，重来岁月新。\n未须愁落魄，祇恐负经纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12973,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五月五日奉鄮翁韵即事","author":"霍与瑕","text":"沧海波扬急，狼烟处处同。\n事无一刻暇，人在百忧中。\n喜奉青门玉，凉生绿野风。\n悠然发孤笑，云物满长空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12974,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"催鄮西赏莲兼谢祈晴见奖之作 其一","author":"霍与瑕","text":"绿野曾陪宴，清尊谁复同。\n园林花欲尽，时序夏方中。\n芰荷将出水，竹叶好乘风。\n莫待秋飙起，荒池映远空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12975,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"催鄮西赏莲兼谢祈晴见奖之作 其二","author":"霍与瑕","text":"祈麦晨参罢，殷忧独绕庭。\n乱云增夏水，连雨怨宵星。\n燮理真惭负，迂疏几醉醒。\n民间多苦曲，凄断不堪听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12976,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五月十五日奉鄮翁韵","author":"霍与瑕","text":"白圭连三复，狂起舞中庭。\n逸调琴流水，豪光剑射星。\n怀人南郭畔，居士眼常醒。\n欲寄采莲曲，知君听不听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12977,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侍诸老游城用韵 其一","author":"霍与瑕","text":"谬忝东陲寄，乞言大老庭。\n长城增气象，高阁聚文星。\n笑语皆模范，风流半醉醒。\n欲将幽谷调，传与世间听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12978,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侍诸老游城用韵 其二","author":"霍与瑕","text":"公暇陪欢宴，朱楼枕洞庭。\n两三明月伴，多是老人星。\n朗朗踏歌去，微微酒半醒。\n漫将千古瑟，弹与子期听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12979,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春粤山怀弼塘庞尊师","author":"霍与瑕","text":"破帽冲云旧，枯藤著脚牢。\n双清松伴鹤，十载榻横皋。\n烟雨迷寒树，春风送晚涛。\n扁舟人不至，空使我心劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12980,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜林泛舟","author":"霍与瑕","text":"相府开新宴，仙城集贵游。\n画阑凭绿水，诗舫泛清秋。\n荷叶风香细，芝兰气味柔。\n酒酣馀慷慨，击楫发江讴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12981,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瑞雪","author":"霍与瑕","text":"雪应炎风地，寒深瘴海天。\n同云敷薄霰，瑞霭满垓埏。\n草木含芳润，山川漱紫烟。\n五百昌期在，无论大有年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12982,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春十一粤秀山社会 其一","author":"霍与瑕","text":"新岁浃旬晴，中宵月更明。\n岩崖流浩彩，林薄郁孤清。\n谁奏关山曲，偏添恨别情。\n丹心千万里，随尔挂燕城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12983,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春十一粤秀山社会 其二","author":"霍与瑕","text":"南国春先到，东风日日来。\n微云收五夜，初月傍三台。\n倒影移山径，流光泛石台。\n嫦娥应爱酒，每每落深杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12984,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"武夷图三昔歌 其一","author":"霍与瑕","text":"昔闻武夷胜，此见武夷图。\n九曲渔郎杳，千峰鸟道孤。\n放舟滩妥贴，映阁树扶疏。\n洞里谁招隐，吾今欲卜居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12985,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"武夷图三昔歌 其二","author":"霍与瑕","text":"昔年紫阳子，曾赋武夷篇。\n玉女临丹壑，莲花插九天。\n桃源无别洞，蓬岛有真仙。\n久断寻芳约，临风思惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12986,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"武夷图三昔歌 其三","author":"霍与瑕","text":"昔年湛夫子，曾订武夷游。\n高歌翻九叠，逸响震千秋。\n步步竭吾力，岩岩纵远眸。\n祇今怜岁晚，依旧阻丹邱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12987,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"走笔和海山舍弟订来樵之约 其一","author":"霍与瑕","text":"是中堪避地，何处更求仙。\n绿水青山表，残春落照边。\n燕归芳草候，莺语落花天。\n四老知来否，相思日似年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12988,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"走笔和海山舍弟订来樵之约 其二","author":"霍与瑕","text":"樵西古圣地，云岩旧有仙。\n紫姑丹井畔，乌利碧云边。\n远意三山岛，芳踪七洞天。\n不知骑鹤过，更得几千年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12989,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题节孝卷为邓母谭氏","author":"霍与瑕","text":"有客携诗卷，深山访谪仙。\n大书冰玉操，掩映柏舟篇。\n松有贞心在，花看桂子妍。\n昭哉勖嗣服，庆善引绵绵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12990,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邵少湄折柬有楼台将送暑凉露报新秋之句用何诗飘洒欣然余怀走笔答之 其一","author":"霍与瑕","text":"楼台将送暑，关塞已迎秋。\n夜绕星河耿，朝看叶露浮。\n芙蓉花底坐，丹桂树边讴。\n对酒清谈永，凭君消远忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12991,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]