[{"title":"村居怀张公子","author":"何吾驺","text":"美人天际隔烟波，落寞其如索处何。\n芳草易添公子恨，雪舟何日故人过。\n雨迷云物关河险，霜落山门景色多。\n最是梅花江上望，不胜清怨挂云萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谢鸣明还楚","author":"何吾驺","text":"春到春归不奈情，望夫山下有人行。\n去怜黄鸟三春色，归按梅花五月声。\n翡翠襟中兰有梦，芙蓉帐底月初生。\n逶迤莫问桑间妇，吹彻秦箫梦里迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈愈章","author":"何吾驺","text":"三年洗尽离愁字，却到君行更断肠。\n梅福转逃名姓隐，严陵归钓水云乡。\n烛花未落登楼梦，夜月偏怜载酒航。\n解缆垂杨春并往，浓烟深树怅苍茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒仙蜕丁野鹤","author":"何吾驺","text":"閒云晴日护空庐，遗蜕翛然万象疏。\n须发尚存那是幻，尘埃不动总成虚。\n山中丹熟留烟灶，华表人归想道书。\n谁去谁来真野鹤，月明潮落事何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁杪寄怀友人","author":"何吾驺","text":"岁晏风寒念索居，羊城尊酒近何如。\n官穷不厌私囊涩，宦薄空嗟友谊疏。\n月落纸窗怀共被，雪残棐几忆同书。\n传来满幅加餐字，未了灯前作蠹鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁巳过听潮阁见徐校书感念陈同年","author":"何吾驺","text":"明眸皓齿发纤歌，醉眼看花奈乐何。\n红粉十年犹似玉，黄粱一梦已残柯。\n江边击楫追鸿雁，湖上裁衣忆芰荷。\n不听山阳夜中笛，谁知司马泪痕多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜宿环翠楼","author":"何吾驺","text":"散帙虚窗秋叶飘，万山如寐野云遥。\n漏随流水销三楚，风度空明怅六朝。\n梦入罗浮疑化蝶，书开石室正观潮。\n刘晨莫讶游仙事，咫尺还应上绛霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同李伯襄登香山最高顶","author":"何吾驺","text":"巉岩万仞渺云端，纵屐凭陵天半看。\n似有昆崙衣羽客，欲寻东岳洗头盘。\n行行悬壁跻峰易，去去迷烟出路难。\n衣履翩然空里举，疑君拾得玉琅玕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏赠伍长卿及其从弟桢卿","author":"何吾驺","text":"君家鸿藻擅清词，群从谁教和竹枝。\n风悄疏棂寒促膝，霜残红叶夜弹棋。\n却疑灵运池塘梦，还似高唐暮雨时。\n伐木诗成应自好，故人秋月枉相期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同诸馆丈赋讯倪武双年兄病二首 其一","author":"何吾驺","text":"维摩丈室借袈裟，棋子閒敲日半斜。\n玉女不须来捣药，仙人亲为教餐霞。\n每悬共步松间月，相待同烹雪片茶。\n买酒十千君卧病，梅花落尽又桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同诸馆丈赋讯倪武双年兄病二首 其二","author":"何吾驺","text":"萧瑟胸生八月涛，画船箫鼓想挥毫。\n稳床吴楚江声入，扑被昆崙黛色高。\n客卧未应骄曼倩，官穷原不叹离骚。\n朝来起色看春陌，草色如烟欲上袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送同年彭紫岳出按关中","author":"何吾驺","text":"揽辔登车泰象开，洮河奔放始闻雷。\n七年辇下葵心苦，万里城头凤影回。\n去日和风吹铁面，到时秋气肃乌台。\n离情一片悬骢马，疏草还看傍日来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日同区启图集李伯襄太史宅","author":"何吾驺","text":"艺苑当年兴未孤，何来风物共茱萸。\n他乡白雁尊前度，故国黄花梦里纡。\n望气迥悬欧冶剑，登门高并李膺驱。\n寒深索和阳春曲，九月关山雪满途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕李伯襄陈集生崔芝林过余守岁拈银烛朝天紫陌长用四平声 其一","author":"何吾驺","text":"河光寒影渐生新，更傍今宵酌故人。\n梦去还疑居木石，望来宁复辨金银。\n异时踪迹吾多懒，同调知交尔任真。\n约略敝衣堪卒岁，十千酤酒候明春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕李伯襄陈集生崔芝林过余守岁拈银烛朝天紫陌长用四平声 其二","author":"何吾驺","text":"今夕何夕漏迢迢，却忆先皇泪未消。\n绕殿风云开盛世，阖城花烛彻清朝。\n同时漫步夔龙后，促坐宁论乡国遥。\n容易主恩难报称，纷纷飞雪度残宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕李伯襄陈集生崔芝林过余守岁拈银烛朝天紫陌长用四平声 其三","author":"何吾驺","text":"长安门巷鼓阗阗，爆竹千家送去年。\n催我渐看称老大，凭君无计问神仙。\n凤池彩笔随朝丽，麟阁鸿名许世传。\n就里东风先一醉，篱烟堤柳总生怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕李伯襄陈集生崔芝林过余守岁拈银烛朝天紫陌长用四平声 其四","author":"何吾驺","text":"十年铅椠共词场，别后风烟各渺茫。\n南海聚星占百里，圣朝开泰首三阳。\n鸣珂待奏贤臣颂，刻漏先传侍史香。\n葱郁斗间雄气满，不妨灯下引杯长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘青岳太史使朝鲜","author":"何吾驺","text":"龙飞九五应昌期，旷世明良有所思。\n口代天言迥禁苑，身将皇极履边陲。\n江繁宿雨孤舟夜，山暝春烟匹马时。\n尽道朝鲜看日出，即今南极五云垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄宫庶韩若海先生","author":"何吾驺","text":"春来清梦不曾閒，几到罗浮疏影间。\n蓟北未堪论往事，朱明先许借家山。\n笥笼黄绢丝纶草，门拥绯衣玉笋班。\n容易半年秋色早，可无雪夜款元关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步韵答少司空张元中座主","author":"何吾驺","text":"老臣忧国岂求怜，闭户经时独黯然。\n欲乞閒身三亩宅，曾叨廉吏大官筵。\n于人何意同公瑾，过客无心访仲连。\n积雪门深留命酒，还从函丈贶高篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邱毛伯御史请告还里","author":"何吾驺","text":"才子新袍獬豸文，著将名姓肃朝氛。\n一封借沐三江水，匹马贪看五老云。\n在握灵蛇明夏火，出群孤翮入秋雯。\n等閒词赋名山业，疏草当今正忆君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋过延津屈鹏洲太史招饮枣山别业","author":"何吾驺","text":"凉飔拂拂敞华筵，太史招携选胜偏。\n绕径但随灯影入，穿林时为柳条牵。\n政逢匹马欢投地，似有双龙夜烛天。\n取醉直教忘尔汝，松亭初露枣山烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋意","author":"何吾驺","text":"几年不见长安月，重见长安月色光。\n宫瓦碧滋新治第，冠簪华对旧为郎。\n异时欢笑疏砧外，何处歌声白雁乡。\n为买元膏晞短发，清朝鹓鹭好相将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安尘 其一","author":"何吾驺","text":"微微不觉入人衣，广陌俄惊面目非。\n似傍大官骑转合，宁因高纛拂来稀。\n生憎总自生怜起，欲别还愁欲见微。\n莫讶纷纷同度劫，临风无恙是恩晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安尘 其二","author":"何吾驺","text":"飞飞何意苦逡巡，君自长衢揽辔频。\n未为蛾眉宽一顾，偶逢零雨半伤神。\n周旋每淡思乡梦，荏苒多销报主身。\n颇怪喧传豪杰手，风前拂尽不繇人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初冬李小湾姜箴胜罗萸江三宗伯姚孟长宫庶王季重国子集马园同赋得江字","author":"何吾驺","text":"联镳清夜乐无双，罄解腰间佐玉缸。\n兴剧未应输北海，情深宁俟激西江。\n霜疏孤柳还低阁，月隐寒钟乍满窗。\n上客尽醒容潦倒，当歌欲泛五湖艭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日同孔玉横姜燕及倪鸿宝黄石斋集高梁桥台馆分赋","author":"何吾驺","text":"飙轮飞盖借閒身，遂有高梁破锦茵。\n出郭泉流银汉近，过桥柳色玉条新。\n斜连殿角阆风晚，坐忆江南绿树春。\n日落红绡归骑疾，搴帷无处避芳尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"姜箴胜前辈招同李小湾罗萸江二宗伯文湛持姚孟长二宫詹米仲诏太仆王遂东国子分赋","author":"何吾驺","text":"频吟白雪动庭柯，折柬招寻许和歌。\n酒色碧如琼岛月，茶香况煮太湖波。\n春容耐可牵衣袂，逸事何妨拟薜萝。\n海内襟期君不薄，风前容易掷流梭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日马伯起区启图戴公纶过邸中时方雩祷清斋竟日","author":"何吾驺","text":"对是珠江载酒朋，青蒲绿艾过餐冰。\n敢因令节宽雩戒，赖有高贤话旧能。\n时事关心还吊往，等閒去俗亦称僧。\n何年梦识长安会，元著超超得未曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别长发弟孝廉","author":"何吾驺","text":"三十年馀世外盟，长安握手愧为兄。\n每怜浊酒寒留宿，一折柔条雨送行。\n话尽家山都梦后，重来马首看云生。\n半堂积雪堪相托，新市桥边我去耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安种竹二首 其一","author":"何吾驺","text":"直为公馀梦绿滋，种花何似种修枝。\n疏篁自许飘尘外，独立全非入俗姿。\n偶向凤池班玉笋，聊教金殿绘脩眉。\n夜来风雨推窗急，带雪敲门伴咏诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安种竹二首 其二","author":"何吾驺","text":"长安买竹取途赊，移得琅玕莫问家。\n小可支撑饶劲草，了无色味度繁花。\n碧姿不共芙蓉醉，直节难同御柳斜。\n我自与君成密友，饱餐霜雪阅年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"内阁阶砌牡丹为宣庙赐植三首 其一","author":"何吾驺","text":"上苑何心谢四邻，移栽黄阁带云根。\n旧游尚识宣皇赐，新绿纷披圣主恩。\n含笑迥悬香国梦，乍开试醉玉堂尊。\n自天雨露春如海，未可人间灌溉论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"内阁阶砌牡丹为宣庙赐植三首 其二","author":"何吾驺","text":"朝罢繁香玉一丛，鸣珂径转碧朣胧。\n天家不羡秾华气，璧府全消贵近风。\n寡和九重金阙迥，同枝百尺玉桥东。\n碧纱何处名花友，得似丹心向日红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"内阁阶砌牡丹为宣庙赐植三首 其三","author":"何吾驺","text":"一觌羲农绝世知，敢因颜色入宫私。\n石家绛蜡浑无梦，唐苑沈香漫有思。\n欲拟芙蓉怜晚艳，更栽芍药怅繁枝。\n丝纶片席华林会，攀赏还看绝妙词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月下白丁香","author":"何吾驺","text":"雨过疏林洗淡妆，碎笼明月簇幽香。\n清辉忍借王孙草，素影偏深越客裳。\n蝴蝶梦回犹带粉，婵娟春尽未销霜。\n夜深不辨葳蕤锁，欲上瑶台扫雪光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水仙花","author":"何吾驺","text":"天与文心漾碧鲜，如兰逾觉素情偏。\n静疑洛浦波间出，逸在耶溪舞态前。\n蝶欲比轻嫌传粉，竹将为友耐生烟。\n春风几处王孙草，自怅尘容不似仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋海棠","author":"何吾驺","text":"逸品无如秋海棠，别施颜色绝常妆。\n叶将满掌偏无俗，花自飞仙不为香。\n雨过殷红开冉冉，霜疏醉粉静庄庄。\n溪山素女嫣然笑，岂羡春宫锦瑟行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日署中梅花","author":"何吾驺","text":"家山万树最离奇，上苑凭看此一枝。\n火里独饶冰作骨，寒深偏喜雪为姿。\n重帏窥影难销傲，复阁浮香别有思。\n不是借炎催梦早，调羹应向鼎中炊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋黄芍药","author":"何吾驺","text":"药栏色色碧初馡，更剪轻槐入锦机。\n宫瓦晓晖摇锁甲，御袍斜积荫名妃。\n淡开池上笼鹅入，学舞楼头绘鹤归。\n未许牡丹题好友，莫矜宫粉尚新衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"净业寺莲花","author":"何吾驺","text":"红尘面面送皇都，净业亭头别一区。\n胜景不曾离北郭，清光如已到西湖。\n绿荷叶下维舟小，只萏花边望月孤。\n可有宰官身是佛，采莲洲畔拥跏趺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红梨花","author":"何吾驺","text":"玉梨带雪每同看，何处轻绯护粉寒。\n春暮樱桃犹著脸，东风杏子若为丹。\n敲残檀板留红泪，洗落胭脂照碧栏。\n莫使庄周为蝶去，乍惊绛雪夜漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春城寒雨感赋","author":"何吾驺","text":"偶翻琴韵感清尘，楚水吴山未易论。\n细雨春城杏花落，轻风南陌柳条新。\n人间不觉周为蝶，心短毋烦路问津。\n半幅潇湘寒食尽，十千酤酒忍辞频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日即事和陈秋涛年兄","author":"何吾驺","text":"九日餐英忆故山，美人新句破愁颜。\n上尊屡逐韶光老，好景偏输白昼闲。\n杯底月华时自照，鬓边秋色不堪删。\n几年枫叶芦花梦，醉倚东篱酒浪殷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋别区象先观察出都二首 其一","author":"何吾驺","text":"十年载酒话前盟，每向长安洽弟兄。\n弹剑未销风雨合，挥杯其那暮烟生。\n犹馀瑞霭迎宵仗，独拥閒云出晓城。\n天下同心人易老，建牙何处可谈兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋别区象先观察出都二首 其二","author":"何吾驺","text":"交游渐散酒人旁，谁复深情共醉乡。\n捧檄今为观察使，题诗曾忆尚书郎。\n烟消砌雪寒逾白，骨老冈梅瘦转香。\n底事只今歌不得，长风吹送凤兮狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄玉崙少宰招同李小湾宗伯陈秋涛宫詹韩月峰国子集定园","author":"何吾驺","text":"偶然乐事到衔杯，浅浅轻波喜溯洄。\n故国山川同入梦，帝乡云物乍登台。\n蝉声若为朋簪好，花信如因笑语开。\n极目苍烟看不尽，城南车骑夜深回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"米仲诏招集漫园三首 其一","author":"何吾驺","text":"层楼四望海天多，北斗檐开太液波。\n酒熟湖烟频借色，寒轻花气迥当歌。\n移尊月自窥人上，近槛仙应解佩过。\n若为曙钟催子夜，不知春思湛庭柯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"米仲诏招集漫园三首 其二","author":"何吾驺","text":"世路漫漫去复过，漫从帝里课松萝。\n浓香不散陶潜菊，柔翰其如逸少鹅。\n似送西山供案入，欲驱南海那云多。\n最怜半踏芳洲舫，衣袂翻然接绛河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"米仲诏招集漫园三首 其三","author":"何吾驺","text":"几载行吟问汨罗，为楼秋水及恩波。\n偶来醉舞能邀月，无恙湖山许放歌。\n暗径度春芳阁转，斜窗低汉晚云过。\n寻盟肯订寒深夕，雪满青轩著钓蓑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆亨宇以风鉴自温钱二阁老幕中至","author":"何吾驺","text":"岂有持梁剌齿肥，宰官如现丈人机。\n但令夜抱九仙骨，肯羡朝披一品衣。\n面目西来真亦幻，云山南去是耶非。\n鹓鸾腐鼠都休问，来岁于今归未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出都二首 其一","author":"何吾驺","text":"岫云舒卷半无因，八载丹衷未易陈。\n岂有薄言逢彼怒，敢云微罪负皇纶。\n恋家去妇终何补，脱叶悲风枉自嗔。\n从此谁为鸣仗马，一哉宫府赞洪钧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出都二首 其二","author":"何吾驺","text":"孤忠望阙重依违，寂寂琴书皓雪飞。\n十里如云偏恋别，百年多病喜言归。\n圣明别殿方脩政，臣子荒郊已息机。\n最是行边几望月，思君夜夜减清辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出都留别倪司成鸿宝二首 其一","author":"何吾驺","text":"当行飞雪冻寒侵，是夕把君诗细吟。\n若为泰交增赤泪，如追携手发孤心。\n浮云千古何须恨，多垒四郊谁独深。\n路出芦沟还好月，待看天上起凝阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出都留别倪司成鸿宝二首 其二","author":"何吾驺","text":"快为归去痛相离，不语看君可那思。\n士亦有心宁好爵，时方酣意遂幽期。\n孤弦流水馀三弄，绝壁高山有一枝。\n努力圣朝容洗耳，赤松何用访芝眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诸友长新夜饯","author":"何吾驺","text":"雪在都门月度桥，青天若为友人邀。\n半肩乍卸忧时担，双耳初闻彻夜箫。\n携手祇应增笑笑，倾尊何用怅迢迢。\n非鱼非我谁知乐，到晓难为作黯销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31658,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖游什四首 其一","author":"何吾驺","text":"不见西湖二十年，重来还似剡溪船。\n新添绿柳苏堤月，半幅孤亭鄂庙烟。\n箫鼓送残都逝水，豪华如梦又前川。\n扁舟岂必功成后，乞得閒身也自仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31659,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖游什四首 其二","author":"何吾驺","text":"浮云恩怨错分明，担苦推閒煞有情。\n送出五湖看月色，时过三竺听松声。\n古贤只解留风节，道眼何曾问利名。\n饱食诸天香积寺，但凭鼎足好调羹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31660,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖游什四首 其三","author":"何吾驺","text":"在处征舠和别棹，独留勺水荡名区。\n南来北去疑閒局，潭影山光互画图。\n欲吊忠魂过武穆，试凭清影访林逋。\n湖山不为閒游赏，含意何堪付酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31661,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖游什四首 其四","author":"何吾驺","text":"载酒湖山日未休，深情偷暇买方舟。\n因兹早谢丝纶出，到此真同李郭游。\n带雨尚过灵隐寺，淩风长啸藕花洲。\n携家盍寄云深处，况有高朋下榻留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31662,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游天竺诸峰因喻醒拙开府见讯并及","author":"何吾驺","text":"天竺参禅最上头，香风拂拂近瀛洲。\n湖光似练浮虚阁，春柳如烟载雪舟。\n到此定知心了世，从来一任海为沤。\n山僧亦道忧时事，开府何曾上庾楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31663,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上饶使君关蓬石永丰使君高贞复邀集观泉亭 其一","author":"何吾驺","text":"疏风零雨使君过，更洒泉亭话薜萝。\n杯试诸方弥勒乳，盆倾一勺洞庭波。\n谭心忧乐成歧路，触景安危发浩歌。\n极目春城花事好，拚将千日醉颜酡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":31664,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]