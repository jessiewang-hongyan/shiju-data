[{"title":"京师寓廨三首 其二","author":"高启","text":"几夜频听雨，经春不见花。\n蘼芜青渚燕，杨柳白门鸦。\n拙宦危机远，工吟癖性加。\n闲坊车马少，不似住京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16705,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"京师寓廨三首 其三","author":"高启","text":"寂寞过芳时，幽怀只自知。\n袖无投相刺，箧有寄僧诗。\n鼠迹尘凝帐，蛙声雨到池。\n疏慵堪置散，不敢怨名卑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16706,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送舒征士考礼毕归四明","author":"高启","text":"寄语关门吏，休轻尚布衣。\n叔孙聊应召，周党竟辞归。\n赤日京城远，苍烟海树微。\n送君还自叹，老却故山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16707,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送周复秀才赋行李中一物得纨扇","author":"高启","text":"不画乘鸾女，应怜素质新。\n霜机惊落早，风麈尚挥频。\n席上曾歌怨，窗间或掩颦。\n何如为君子，远路障埃尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16708,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送流人","author":"高启","text":"汉条应偶触，蛮俗未能谙。\n海近风多飓，山昏瘴似岚。\n行冲哀甸虎，食畏蛊家蚕。\n乡国何年返，县知老日南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16709,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠张省郎","author":"高启","text":"汉署早为郎，长游凤沼傍。\n鸡知壶水候，马识火城光。\n每载趋曹笔，时熏直省香。\n边书无一羽，冠盖得翱翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16710,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送宿卫将出守邓州","author":"高启","text":"中郎身领仗，宿卫在承明。\n旧射双雕落，新乘五马行。\n红云遥魏阙，白水近穰城。\n好劝诸年少，春来卖剑耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16711,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甘露寺","author":"高启","text":"胜地江山壮，名林岁月遥。\n刹藏京口树，钟送海门潮。\n月黑龙光发，天清蜃气销。\n何当寻狠石，闲坐话前朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16712,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大驾亲祀方丘选射斋宫奉次御制韵","author":"高启","text":"奠壁方坛晓祝釐，豹竿风动从灵祗。\n献符多士歌昌运，扈跸诸蕃睹盛仪。\n郊射贯侯初复古，汾祠获鼎未云奇。\n山川效静年多谷，神答皇心定有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16713,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉迎车驾享太庙还宫","author":"高启","text":"鸣跸声中晓仗回，锦装驯象踏红埃。\n半空云影看旗动，满道天香识驾来。\n汉酎祭余清庙闭，舜衣垂处紫宫开。\n礼成海内人皆庆，献颂应惭自乏才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16714,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚登南冈望都邑宫阙二首 其一","author":"高启","text":"落日登高望帝畿，龙蟠山下见龙飞。\n云霄双阙开黄道，烟树三宫接翠微。\n沙苑马闲秋猎罢，天街车斗晚朝归。\n明朝欲献升平颂，还逐仙班入琐闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16715,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚登南冈望都邑宫阙二首 其二","author":"高启","text":"秦金不厌气佳哉，紫盖黄旗此日开。\n残雪已销缡鹊观，浮云不隐凤凰台。\n山如雊下层层出，江自巴中渺渺来。\n六代衣冠总尘土，幸逢昌运莫兴哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16716,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉天殿进元史","author":"高启","text":"诏预编摩辱主知，布衣亦得拜龙墀。\n书成一代存殷鉴，朝列千官备汉仪。\n漏尽秋城催仗早，烛明春殿卷帘迟。\n时清机务应多暇，阁下从容幸一披。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16717,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日陪诸阁老食赐糕次谢授经韵","author":"高启","text":"叨陪讲席按词曹，晓禁霜花点素袍。\n院贮图书西掖静，云连宫殿北山高。\n故园莫忆黄花酒，内府初尝赤枣糕。\n最爱凤毛今复见，便令池上一挥毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16718,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送沈左司从汪参政分省陕西汪由御史中丞出","author":"高启","text":"重臣分陕去台端，宾从威仪尽汉官。\n四塞河山归版籍，百年父老见衣冠。\n函关月落听鸡度，华岳云开立马看。\n知尔西行定回首，如今江左是长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16719,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴僧日章讲师赴召修蒋山普度佛事既罢东归送别二首 其一","author":"高启","text":"万人拥坐听潮音，宝刹曾迂玉驾临。\n佛法晓敷三藏秘，帝恩春及九原深。\n钟山坐处花频雨，练浦归时树欲阴。\n拟问楞伽嗟已别，楚江飞锡暮沉沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16720,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴僧日章讲师赴召修蒋山普度佛事既罢东归送别二首 其二","author":"高启","text":"故乡未解识清容，却在金陵阙下逢。\n中禁曾分斋钵饭，上方时叩讲筵钟。\n一帆细雨迢迢浦，半塔斜阳霭霭峰。\n相送师归忽多感，飞云亦恋旧依松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16721,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清明呈馆中诸公","author":"高启","text":"新烟著柳禁垣斜，杏酪分香俗共夸。\n白下有山皆绕郭，清明无客不思家。\n卞侯墓上迷芳草，卢女门前映落花。\n喜得故人同待诏，拟沽春雨醉京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16722,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金陵喜逢董卿并送还武昌","author":"高启","text":"兵后匆匆记别离，两年音问不相知。\n武昌楼下初来日，幕府门前忽见时。\n上国花开同醉少，大江潮落独归迟。\n莫嗟握手还分手，此会从前岂有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16723,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送易左司分省广西","author":"高启","text":"朝廷特念远民深，画省分官出桂林。\n油幕乍开依汉节，卉衣时到贡蛮金。\n四时花发山多暖，半日岚开市尚阴。\n虞帝祠前黄竹里，相思莫听鹧鸪吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16724,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王检校珣赴北平","author":"高启","text":"十年同舍客京华，看遍龙河寺里花。\n才进史书朝日下，便纡官绶去天涯。\n平芜远塞秋驱骑，衰柳遗宫晚噪鸦。\n莫道穷边成久别，待君归草玉堂麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16725,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"京师秋兴次谢太史韵","author":"高启","text":"柳外秋风起御河，京华客子意如何。\n伎同北郭知应滥，俸比东方愧已多。\n梁寺钟来残月落，汉宫砧断早鸿过。\n不材幸得同趋阙，几度珊珊候晓珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16726,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送祠江渎使者","author":"高启","text":"源发岷峨万里通，函香迢递问斋宫。\n神驰白马灵光近，祝奉玄牲礼秩崇。\n驿下换船潮涌日，庙前沉璧水回风。\n重烦使者徼多福，南国无疵黍稌丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16727,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送叶判官赴高唐时使安南还","author":"高启","text":"铜柱崖前使节过，贡随归骑入京多。\n一官暂遣陪成瑨，片语曾烦下赵陀。\n晓拜赐衣辞绛阙，秋催征棹渡黄河。\n政余好赋登临咏，闻说州人最善歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16728,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"衍师见访钟山里第","author":"高启","text":"风雨孤舟寄一僧，远烦相觅到金陵。\n青衫愧逐尘中马，白拂看麾座上蝇。\n事去南朝犹有恨，梦归北郭已无凭。\n文章何用虚叨禄，只合从师问上乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16729,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄题安庆城楼","author":"高启","text":"层构初成百战终，凭高应喜楚氛空。\n山随粉堞连云起，江引清淮与海通。\n远客帆樯秋水外，残兵鼓角夕阳中。\n时清莫问英雄事，回首长烟灭去鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16730,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送郑都司赴大将军行营","author":"高启","text":"上公承诏出蓬莱，立马风烟万里开。\n赐履已分无棣远，舞戈还见有苗来。\n牙前部曲多收绩，幕下宾僚更倚才。\n后夜军门知子到，郎星应是近三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16731,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送朱谢二博士进贺冬至表赴京师听宣谕毕还吴","author":"高启","text":"驿骑双驰捧绿章，都门逢旧喜洋洋。\n小儒方幸瞻天近，远使初来贺日长。\n仗下丹墀晴雪尽，朝回紫陌晓尘香。\n承宣归去难留驻，乞报平安到故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16732,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送丕上人还四明育王寺","author":"高启","text":"解夏还寻旧寺栖，满船黄叶过长溪。\n袈裟影入秋山远，舍利光悬夜塔低。\n鹅识讲时常绕听，猿知定后不惊啼。\n却惭扰扰尘中客，觉路如今去尚迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16733,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送吴生赴汴省其父指挥","author":"高启","text":"都亭槐雨净朝埃，彩服逢秋试剪裁。\n定远未归双节在，孝廉初去一船开。\n城依梁苑烟中闭，河绕隋堤树里来。\n家庆拜余寻旧迹，夕阳骑马过繁台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16734,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"客舍夜坐","author":"高启","text":"楼角声残锁禁城，灯花半落夜寒生。\n啼鸦井上惊风散，残雪窗前助月明。\n清世莫嗟人寂寞，中年渐怯岁峥嵘。\n酒杯诗卷吾家物，客裹相亲倍有情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16735,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送郑山人听宣谕后归东阳","author":"高启","text":"閤门传诏山人拜，清晓蓬莱望彩霞。\n布褐朝天才赴阙，蒲帆带雨又还家。\n沈侯咏罢楼沉月，婺女妆残庙掩花。\n无限朝廷仁恤意，殷勤归向老农夸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16736,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春来","author":"高启","text":"客愁拟向春来减，春到愁翻倍旧时。\n走马已无年少乐，听莺空有故园思。\n日光皛皛浓熏草，风力扬扬缓堕丝。\n辟历沟南酒家路，共谁来往问花枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16737,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送贾文学以郡荐赴礼部试毕归吴","author":"高启","text":"匹马都门候晓开，吴公新荐贾生来。\n郡中方待传经业，阙下先称射策才。\n寒食杏花江店雨，春衣柳絮驿程埃。\n惭予东掖叨陪讲，难把长干送别杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16738,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"休沐日期衍公游北山不果独卧斋中","author":"高启","text":"休沐欣逢一日闲，拟邀禅客共登山。\n两筇未许寻萝径，孤枕应须掩竹关。\n历历远峰尘土外，萧萧深屋草莱间。\n安眠却胜清游乐，觉看斜阳燕子还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16739,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送内兄周谊还江上","author":"高启","text":"忆奉纶音趋赴朝，曾烦远送过枫桥。\n云山方恨成睽阻，雪夜俄来件寂寥。\n吴苑疏钟沉晚树，楚江归雁逐寒潮。\n情亲海内如君少，敢惜离魂为一销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16740,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜闻吴女诵经","author":"高启","text":"云窗月帐散花多，闲读金经夜若何。\n娇舌乍弹莺学语，芳心已定井销波。\n尼师曾教青莲偈，女伴徒为《白苎歌》。\n听处若迷空色相，应须愁杀病维摩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16741,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送赵史君致仕归别业","author":"高启","text":"久仕江湖白发长，今年得许乞身章。\n吏收封印朝辞郡，人贺悬车晚在乡。\n家箧已添新著稿，官衫未歇旧熏香。\n南风别墅初归处，应坐肩舆看种秧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16742,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游南峰寺有支遁放鹤亭","author":"高启","text":"每向人间望碧峰，石门今得问幽踪。\n路缘风磴泠泠策，寺隔烟萝杳杳钟。\n窗下鸟来多堕果，亭前鹤去只高松。\n一龛愿借依香火，莫道诗人非戴颙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16743,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵杨署令雨中卧疾","author":"高启","text":"双桐分荫晓池清，乍喜新晴觉病轻。\n蛛曳林风吹欲断，鹭经沙雨洗偏明。\n吟多稍怯临窗写，卧久浑忘出市行。\n不道春归逾一月，起闻歌鸟尚疑莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16744,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送胡簿之阳朔","author":"高启","text":"几年桂馆去人稀，白发怜君独远违。\n过海定寻回估舶，出京才脱旧儒衣。\n祠羞荔子传巫语，县闭榕阴放吏归。\n亦欲居夷嗟未得，漫看鸿鹄向南飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16745,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒甫里祠","author":"高启","text":"衣冠寂寞半尘丝，想见江湖独卧时。\n遁迹虚烦明主诏，感怀犹赋散人诗。\n钓鱼船去云迷浦，斗鸭阑空草满池。\n芳藻一杯谁为奠，鼓声只到水神祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16746,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送恩禅师弟子勤归开元寺","author":"高启","text":"山衲经寒补杂缯，白云高寺遍寻登。\n法身已见浮来佛，宗旨曾传化去僧。\n归过江城谁施饭，定依旧院自悬灯。\n明朝应恨千峰阻，欲问楞伽已不能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16747,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"辞户部之命东还始出都门有作","author":"高启","text":"诏贰民曹出禁林，陈辞因得解朝簪。\n臣材自信元难称，圣泽谁言尚未深。\n远水江花秋艇去，长河宫树晓钟沉。\n还乡何事行犹缓，为有区区恋阙心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16748,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归吴至枫桥","author":"高启","text":"遥看城郭尚疑非，不见青山旧塔微。\n官秩加身应谬得，乡音到耳是真归。\n夕阳寺掩啼乌在，秋水桥空乳鸭飞。\n寄语里闾休复羡，锦衣今已作荷衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16749,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送徐山人还蜀山兼寄张静居","author":"高启","text":"我因解绂远辞京，君为修琴暂入城。\n偶尔相逢春酒熟，飘然忽去暮烟生。\n山头学啸犹闻响，世上留诗不写名。\n西涧烦询张静者，年来注《易》几爻成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16750,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄题内弟周思敬野人居","author":"高启","text":"野人何处是幽栖，闻在天随旧宅西。\n半屋图书春落蠹，一村花柳昼鸣鸡。\n分泉自给烹茶水，待雨惟耕种药畦。\n日暮扁舟欲相访，恐惊鸥鸟过前溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16751,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐记室谪钟离归后同登东丘亭","author":"高启","text":"同上高亭一赋诗，喜逢君是谪归时。\n不然此日登临处，应望天涯有远思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16752,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"将赴金陵始出阊门夜泊二首 其一","author":"高启","text":"乌啼霜月夜寥寥，回首离城尚未遥。\n正是思家起头夜，远钟孤棹宿枫桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16753,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"将赴金陵始出阊门夜泊二首 其二","author":"高启","text":"烟月笼沙客未眠，歌声灯火酒家前。\n如何才出阊门外，已似秦淮夜泊船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16754,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟次丹阳驿","author":"高启","text":"沽酒来寻水驿门，邻船灯火语黄昏。\n今朝始觉离乡远，身在丹阳郭外村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16755,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"正月十六日夜至京师观灯","author":"高启","text":"天街争唱《落梅》歌，绛阙珠灯万树罗。\n莫笑游人来看晚，春风还似昨宵多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16756,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜闻雨声忆故园花 其一","author":"高启","text":"帝城春雨送春残，雨夜愁听客枕寒。\n莫入乡园使花落，一枝留待我归看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16757,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早至阙下候朝","author":"高启","text":"月明立傍御沟桥，半启宫门未放朝。\n驺吏忽传丞相至，火城如昼晓寒销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16758,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日寄张祠部","author":"高启","text":"乌衣巷口燕来时，杨柳风多纮酒旗。\n远客金陵游伴少，看花惭比去年迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16759,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"左掖作","author":"高启","text":"小殿珠帘散柳丝，东宫初退讲筵时。\n不材未敢修封事，把笔闲题应教诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16760,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中登天界西阁","author":"高启","text":"青山楼阁楚江东，身在苍茫晚色中。\n故国自遥难望见，不关春树雨溟蒙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16761,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴中亲旧远寄新酒二首 其一","author":"高启","text":"双壶远寄碧香新，酒内情多易醉人。\n上国岂无千日酿，独怜此是故乡春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16762,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴中亲旧远寄新酒二首 其二","author":"高启","text":"为念春来客思悲，欲教一醉对花枝。\n那知饮量新来减，不似江亭看妓时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16763,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿圆明寺早起","author":"高启","text":"客起灯前梦尚迷，满楼残月晓风西。\n应知野寺非山店，只听钟声不听鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16764,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送郭省郎东归二首 其一","author":"高启","text":"金陵儿女踏春阳，金陵客子正思乡。\n一杯况复春将去，目断飞花江水长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16765,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送郭省郎东归二首 其二","author":"高启","text":"桃叶渡头闻唱歌，孤帆欲发奈愁何。\n君归是我来时路，山水无多离思多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16766,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四月朔日休沐雨中","author":"高启","text":"送春风雨苦潺潺，得告今朝免缀班。\n卧听鸠啼花落尽，此身如在故园间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16767,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送哲明府之新淦","author":"高启","text":"花落春衫试剪裁，石头城下楚帆开。\n凭谁为报清江吏，麦雉鸣时县令来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16768,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"逆旅逢乡人","author":"高启","text":"客中皆念客中身，唯汝相逢意更亲。\n不向灯前听吴语，何由知是故乡人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16769,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄丁二侃","author":"高启","text":"江头斜日草初薰，日断归鸿隔楚云。\n旧日因居相近住，每思家处独思君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16770,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题虞文靖公书所赋鹤巢诗后","author":"高启","text":"玉堂罢直发如丝，华盖当头戴笠时。\n丁令去来沧海变，人间零落鹤巢诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16771,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戴叔鸾入夏江山图","author":"高启","text":"归隐初辞荐辟章，西风黄叶满车箱。\n青牛只识山中路，不是无心向洛阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16772,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]