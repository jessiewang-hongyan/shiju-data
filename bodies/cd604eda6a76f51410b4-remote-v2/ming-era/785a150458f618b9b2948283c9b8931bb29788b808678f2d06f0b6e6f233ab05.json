[{"title":"相逢行赠孔员外","author":"陈鹤","text":"白马绾青丝，华鞭控锦羁。\n蹀躞黄金陌，照耀绿杨枝。\n来自鄞江道，还过越溪水。\n相逢碧荷畔，共入花间语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4024,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"太仓除夕席上呈友人","author":"陈鹤","text":"频年惬远游，岁晚独牵愁。\n底事故乡泪，偏当今夜流。\n柔风将报柳，残烛更明楼。\n君醉且休别，同予送晓筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4025,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊京口望金山寺","author":"陈鹤","text":"南徐一片石，千古柱中流。\n绕树开僧舍，缘空结梵楼。\n疏灯明水底，落月挂潮头。\n向晚禅钟起，风吹到客舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4026,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜坐见白发寄别朱仲开张瓯江","author":"陈鹤","text":"坐久北风起，江声带远沙。\n客愁初到鬓，乡梦不离家。\n林静无残叶，灯寒有落花。\n怀君夜难寐，别绪转如麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4027,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过唐荆川太史隐居","author":"陈鹤","text":"惟君爱嘉遁，结屋向江村。\n远月长随棹，残潮自到门。\n心无时事累，家有古风存。\n已得川中乐，都忘河上言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4028,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与沈使君风雨泊河桥夜半使君先发余沿路追寻不及赋诗见怀","author":"陈鹤","text":"相逢驿西路，交深难别离。\n市桥同水泊，风雨独何之。\n江黑一帆没，夜寒孤梦迟。\n仙踪无处觅，推枕益凄其。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4029,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送朱东武北上","author":"陈鹤","text":"落日照湖水，残杯催别离。\n常年分手处，寒柳半无枝。\n才老宦方达，时清贫正宜。\n君当谢南亩，休与白云期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4030,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送袁节推奏绩北上","author":"陈鹤","text":"斜日半帆明，西江浪正平。\n风云双阙路，吴越两乡情。\n树绿沉山影，天空落雁声。\n孤舟渔浦夜，共语一灯清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4031,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题杨法部容闲阁","author":"陈鹤","text":"阁傍江城外，窗开云水间。\n只因尘境远，自觉主人闲。\n日落见归鸟，月明看远山。\n移船候潮至，相送野僧还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4032,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戚龙渊过山中","author":"陈鹤","text":"关路几年别，秋霜两鬓多。\n高谈卑世态，远涉识风波。\n艺绝惟名在，身贫奈壮何。\n为君沽斗酒，聊复慰蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4033,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送周雨山还金陵","author":"陈鹤","text":"戚戚在歧路，茕茕归邺都。\n病多双鬓换，天远一身孤。\n晚饭到吴市，秋吟向野芜。\n扁舟今夜月，难遣客愁无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4034,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄金子坤","author":"陈鹤","text":"思君不可见，渐觉岁年过。\n世事犹如此，生涯近若何。\n天长红树没，雨后乱山多。\n何日金陵道，相携一和歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4035,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送施虎泉北上","author":"陈鹤","text":"看君上马负长戈，北去关山路几何。\n世变文人轻武甚，时平国士向边多。\n西河未可淹吴起，南海终须遣伏波。\n明主怜才此推毂，莫因霜鬓叹蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4036,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金子坤话别","author":"陈鹤","text":"驿路孤亭含落晖，绿芜风暖燕频飞。\n城头潮上酒初歇，江畔月明人独归。\n才滞莫疑天道远，路贫方觉世情非。\n凄凉十二年来事，惟有临歧泪染衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4037,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"曹娥江寄京口诸友人","author":"陈鹤","text":"曹娥江上浪如花，数幅蒲帆过浦斜。\n烟际乱山明落日，树中古庙带残霞。\n乾坤故旧劳魂梦，客路星霜换岁华。\n鸣雁满天无信息，相思一夜遍天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4038,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卧病双溪山馆见月寄张有功","author":"陈鹤","text":"溪边桑柘映双流，病里萧条赋四愁。\n坐雨几宵方见月，别君一日已成秋。\n山深倦鹊犹依树，风静飞萤自上楼。\n托迹文园须共遣，莫因乡国叹羁留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4039,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武林答张文东见过","author":"陈鹤","text":"雨余落日满临安，病况逢君得暂宽。\n抱玉已经三献后，还家又值一春残。\n时违自觉君恩远，客久方知世路难。\n国事于今用长剑，镜中绿发未须看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4040,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿莫水部官署答蒋南泠张瓯江见过","author":"陈鹤","text":"北风吹雪满征鞍，西度关门岁欲残。\n越国云山千里梦，官亭花竹几回看。\n天连海上明河没，霜白城头片月寒。\n深夜逢君论世事，酒酣重把剑珠弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4041,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"古意","author":"陈鹤","text":"千家砧杵乱城头，新月微明江水流。\n床外蛩鸣偏出夜，风前白苎不宜秋。\n愁连天汉无鸿雁，梦到关山见戍楼。\n芳草不青莲子落，征夫何事好长游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4042,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春暮入芜城过真州感赋呈蒋南泠诸公","author":"陈鹤","text":"两月芜城醉酒尊，逃炎复入海西村。\n去年芳草又重绿，旧日故交无半存。\n风景只添江郭柳，月华还认旅人门。\n逢君且诵别来句，时事到今难尽论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4043,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武林送章佥宪之广西","author":"陈鹤","text":"宪节翩翩向法台，遐荒万里瘴烟开。\n圣王化久文身尽，粤服人和白雉来。\n膏岭日寒风似雪，牂牁雨过水如苔。\n断肠极目他乡外，簪佩何年返上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4044,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题赠陶氏觐湖村居","author":"陈鹤","text":"摇波修树玉同清，隔树虚楼水共成。\n桂楫兰桡穿镜出，春歌暮管傍花行。\n月如彭蠡湖中挂，云似潇湘浦上生。\n但得长年怡杖屦，那论此地胜蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4045,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除夕前一日与骆行简吕南夫张候中沈纯甫蟾山晚宴有作","author":"陈鹤","text":"岩边树色隐丹扉，日下仙舆度翠微。\n水落尽如雷电过，山回俱作凤凰飞。\n星台似结仙人掌，云路疑通织女机。\n幽赏不殊椒酒会，合欢须并月骖归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4046,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戚龙渊游闽八载归乃移家武林冒暑过越访予山中因留半月别去","author":"陈鹤","text":"八载游闽今始归，形容半是语全非。\n萍踪已有妻孥托，旅食犹怜故旧稀。\n睡去衣裳孤月满，醉来图画乱云飞。\n与君山阁逃炎热，临别还留壁上题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4047,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"炎居苦俗因入萧山养病张子成郊园","author":"陈鹤","text":"炎天病起厌逢迎，借尔深山且避名。\n偶对野翁忘出处，暂随农侣话阴晴。\n林猿乞果时穿木，海月窥人夜过城。\n赖有流泉能灌圃，隔窗时见药苗生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4048,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"旅馆病起奉寄近山白崖诸公","author":"陈鹤","text":"新桥客舍俯横塘，柳色千门路转长。\n却病且须辞酒伴，习闲还欲借僧房。\n日高花气蒸书案，风过潮声到石床。\n巷陌春深芳草绿，故人车马在何方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4049,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨二檀闻人北江二臬副过山中值余他出乃自移二石坐竹下待之少顷余还邹草陵亦至遂开樽相话日尽而别","author":"陈鹤","text":"海上初乘李郭舟，东来又作北山游。\n自怜散迹随云出，却喜闲身为竹留。\n日转菊篱花未吐，江寒梧树叶先流。\n廿年岁月交游在，共对清樽半白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4050,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"隐迹吴市答谢诸友","author":"陈鹤","text":"往来吴市且藏名，乞食空门学野僧。\n晓泛独先湖口日，夜归长傍酒家灯。\n时危有梦依山谷，身病无书问友朋。\n世路茫茫何处是，关河西望涕重增。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4051,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"风雨梦金陵诸旧社","author":"陈鹤","text":"乱离漂泊滞天涯，托迹空门不当家。\n病里音书非故旧，夜深风雨梦京华。\n褰裳觅句行南陌，并马看春过狭斜。\n睡醒蒲团寒漏断，半庭蕉叶杂江沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4052,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吹笛因怀友人","author":"陈鹤","text":"玉笛横吹入夜分，中天华月度流云。\n苕川两岸春风起，飞尽梅花不见君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4053,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"池上听陈老琵琶","author":"陈鹤","text":"夜深池上弄琵琶，万里银河月在沙。\n莫向樽前弹《出塞》，只今边将未还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4054,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张伯纯还关中","author":"陈鹤","text":"怜君独棹渡黄河，西北山川入雍多。\n料得到家春未至，马蹄半在雪中过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4055,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张舍人还永嘉","author":"陈鹤","text":"几年相忆在京畿，一遇吴门便拂衣。\n君似舟前夜潮水，才临江口又西归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4056,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"真州访谭子羽","author":"陈鹤","text":"海上寻君路半迷，画船如入武陵溪。\n桥回流出桃花水，应有人家在树西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4057,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿沈漂阳沙棠舟中","author":"陈鹤","text":"风回城阙夜闻笳，水转南桥万柳斜。\n忽见沙棠舟上月，却令游子怨离家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4058,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王龙阜谏议北上","author":"陈鹤","text":"东去春潮到驿门，半江风雨近黄昏。\n自来知己难为别，不是殷勤恋酒樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4059,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏梅","author":"陈鹤","text":"黄沙万里塞云闲，腊尽交河戍未还。\n但见梅花飞落尽，不知羌笛满关山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4060,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题谢汝湖冢宰美人卷次金太史韵","author":"陈鹤","text":"隔花翻曲月临墙，欲觅知音懒斗妆。\n拨尽相思不成调，御沟流水乱人肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4061,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登金山","author":"陈鹤","text":"瓜州霜落雁初飞，铁瓮城寒树渐稀。\n南国兴亡在何处，金山残月夜潮归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4062,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日寄怀吴受斋史元登龚应峰三子","author":"陈鹤","text":"一住长安信渐稀，离心付与雁同飞。\n出门愁见垂杨树，长尽新条尚未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4063,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄孙石云","author":"陈鹤","text":"绿树青霞昼不分，水边书阁净迎曛。\n知君正在山中住，雨过长生石上云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4064,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊行漫兴","author":"陈鹤","text":"山桥野店酒盈卮，拄杖无钱欲典衣。\n日暮杨花太无绪，随风却自渡江飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4065,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中寄吴珠川使君","author":"陈鹤","text":"池上花香酒欲醒，雨添草色上中庭。\n与君未踏湖西路，几夜春山入梦青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4066,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人还蜀","author":"陈鹤","text":"久游江国草萋萋，万里家山落日迷。\n幸有归心似明月，今宵先度蜀川西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4067,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿润州半月再入金陵留别姚麓居道纪","author":"陈鹤","text":"半月斋居道士家，碧桃千树吐春霞。\n今朝送别江边市，马上停鞭看落花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4068,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游无相寺","author":"陈鹤","text":"玉辇曾经野寺中，宸书犹在翠华空。\n断碑世远无人识，落日莺啼古殿风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4069,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送袁山人还广陵","author":"陈鹤","text":"月出潮生江倒流，别离无奈又逢秋。\n吴江枫叶红千树，一夜随风满客舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4070,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"饮秋涧隐居夜归值雪有作","author":"陈鹤","text":"独行长路俨如僧，水滴檐牙半是冰。\n归到空园人已尽，雪花穿户打残灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4071,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄杏台郎","author":"陈鹤","text":"杏花台上月华新，见月长思花下人。\n今夜莫孤花月意，明朝风雨又残春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4072,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送秦子登入金陵","author":"陈鹤","text":"日暮逢君在路歧，短藜临水立斯须。\n休言江上相思否，今夜月明君自知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4073,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题项秀溪半华山房","author":"陈鹤","text":"溪上道人幽思长，堂开东郭引青阳。\n日斜开户看山色，十里泉声半在床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4074,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题画","author":"陈鹤","text":"饭牛归去趁东风，柳色山光绿映红。\n世事兴亡在何处，夕阳江畔笛声中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4075,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题荷寄施虎泉","author":"陈鹤","text":"三秋湖舫话离群，百里还家傍海云。\n今日耶溪秋信至，抽残荷叶未逢君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4076,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"花间杂咏","author":"陈鹤","text":"流云影乱欲凝空，杨柳丝柔不曳风。\n调入春林人不见，乳莺啼出万花中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4077,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游天竺寺有怀谢康乐","author":"李奎","text":"秋光澹岩岫，入谷闻晨钟。\n白云嵌紫芝，峰朵开芙蓉。\n林香昼自结，夹道罗长松。\n沙广草烟薄，溪深花露浓。\n梵岭郁飞鹫，咒潭降毒龙。\n闲禽互交语，道侣时相从。\n久矣悟空寂，斋心礼金容。\n精庐隐暮色，蔬食修珍供。\n还憩崖亭上，永怀高人踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4078,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西湖舟中","author":"李奎","text":"春半出门春可怜，黄鹂隔岸啼春烟。\n垆头沽酒饮不醉，更向西湖呼酒船。\n葡萄荔枝酒色红，银缸金碗须臾空。\n但令一醉卧明月，莫使醒眼看春风。\n凤凰山头春草绿，金牛湖上花成簇。\n日落歌声水面来，画栏笑倚人如玉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4079,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"古柏行","author":"李奎","text":"虞山古柏几千岁，根盘节错罗星文。\n灵气常悬白日雨，疏枝乱洒青天云。\n霜柯露干了不识，半是苍苔半成石。\n石上犹存古镜光，青萍未拭芙蓉色。\n我来八月秋气浓，月明满地蟠虬龙。\n赤脚大叫不忍去，长风吹落虞山钟。\n天生异物讵可测，呵护常闻鬼神泣。\n岩壑宁教无此材，岁寒然后知松柏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4080,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阳春曲","author":"李奎","text":"三月江南春草芳，水边柳丝百尺长。\n流莺乍啭千金堰，紫燕双栖文杏梁。\n家家曲里调鹦鹉，处处箫声引凤凰。\n凤凰台上花争发，翡翠楼前鸟并翔。\n别有蓝桥通蕙渚，更怜斜狭接横塘。\n横塘女儿多艳妆，锦琴瑶瑟为谁张。\n能歌《白雪》留人醉，不管春阳断客肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4081,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上","author":"李奎","text":"锦帐开桃岸，兰桡系柳津。\n鸟歌如劝酒，花笑欲留人。\n钟磬千山夕，楼台十里春。\n回看香雾里，罗绮六桥新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4082,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与客游北山偶过普福寺寻葛洪丹井","author":"李奎","text":"古寺随缘到，云霞晚自闲。\n僧房开竹里，仙路入花间。\n斜日明秋水，薄烟凝暮山。\n偶探勾漏迹，惆怅欲忘还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4083,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏湖上新柳","author":"李奎","text":"依依弱柳不胜春，袅袅垂条向水滨。\n奈可轻盈愁少妇，岂堪攀折赠离人。\n烟消翡翠眠初起，风折鸦黄舞乍新。\n犹喜芳心未成絮，肯将眉黛向人颦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4084,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"入峡源庵中读书","author":"周东田","text":"扰扰倦行迈，复此秋气阑。\n寒流深峡路，落木晓霜山。\n乞火邻烟远，读书孤屿闲。\n相求有幽鸟，飞入短楹间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4085,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"客夜","author":"周东田","text":"弃置仍为客，言归久未能。\n素枝霜树月，独夜草虫灯。\n河汉秋来坼，关山梦到曾。\n明朝对青镜，应见鬓丝增。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4086,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"箭月歌","author":"王寅","text":"谁剪海犀革，一尺如月圆。\n锦绦挂东壁，时或生紫烟。\n上画胡奴驰铁骑，白草经霜枯满地。\n貂袄回头臂两弓，远望双飞皂雕至。\n此物怀当弱冠年，高插庐子城东边。\n射罢周瑜冢头坐，常浇绿酒呼重泉。\n抱书十度金陵走，丈夫蹭蹬终不偶。\n没羽徒夸射虎人，毛锥负却穿杨手。\n摩挲此物敝埃尘，感慨从前一怆神。\n道旁裋褐成衰丑，谁识飞扬跋扈人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4087,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"关山月","author":"王寅","text":"落日收风色，边城望月华。\n年年随汉将，夜夜到胡沙。\n貂帐流光冷，龙旂卷影斜。\n此时正愁绝，那忍更闻笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4088,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送郑信之游大梁","author":"王寅","text":"南客辞乡邑，遥随北雁归。\n春风寒似腊，吹雪湿征衣。\n书剑过淮水，关山望宋畿。\n铜驼旧游路，花柳正芳菲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4089,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"燕市酒垆曲","author":"王寅","text":"白发嗤多事，狂游入上都。\n敢怀执辔者，可有卖浆徒。\n何处容弹铗，常来独倚垆。\n悲歌稀酒伴，不是一钱无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4090,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿喜峰口墩楼","author":"王寅","text":"万里秋风暮，华夷到此分。\n几年望紫塞，今日宿黄云。\n片月临关见，孤军击柝闻。\n燕歌争劝酒，强饮不成醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":4091,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]