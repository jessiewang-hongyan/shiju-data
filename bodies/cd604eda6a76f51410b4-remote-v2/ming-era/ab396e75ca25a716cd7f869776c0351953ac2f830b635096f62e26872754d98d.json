[{"title":"次韵李宫允梦弼二首 其一","author":"潘希曾","text":"春色今年稍较迟，赏心犹自托深期。\n绿情红意无消息，漫和阳春一阕词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58897,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵李宫允梦弼二首 其二","author":"潘希曾","text":"两日东风作意吹，柳稍黄浅绿回迟。\n疏慵颇怯红尘陌，羸马探春独不疲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58898,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追挽王正郎先生","author":"潘希曾","text":"洛下风流忆昔贤，投簪当路正青年。\n贤劳旧著司徒绩，退隐新登太史编。\n化去迹陈猿鹤怨，读残书在子孙传。\n千年嵩岳收灵气，洒泪徒劳吊九泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58899,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"追挽王宪副先生","author":"潘希曾","text":"拟赋招魂欲断肠，曾于髫丱挹威光。\n乘骢尚忆同先子，附骥偏怜得季方。\n翰苑才名元独步，柏台风度更流芳。\n高坟宿草年华去，怅望空惭一瓣香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58900,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵咏徐秋官厅事槐柏二首 其一","author":"潘希曾","text":"西曹清景属槐堂，酒兴诗情取次偿。\n细蕊缀黄临短槛，新梢抽绿过东墙。\n午阴谩喜先秋桂，春色何妨后野棠。\n日永风清官事了，羡君挥麈据胡床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58901,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵咏徐秋官厅事槐柏二首 其二","author":"潘希曾","text":"夭乔满目孰媸妍，偃蹇寒姿特可怜。\n空谷移根天自别，古堂分影地逾偏。\n终于晚节知君子，不向春风竞少年。\n剩与诗家添好兴，四时苍翠锁云烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58902,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠陈司训洁之浦江","author":"潘希曾","text":"人物从来说浦阳，斯文未丧有书香。\n年来后学多狂简，事在先生为主张。\n宝婺夜晴风月好，龙门春静薜萝长。\n绝怜官舍邻予舍，千里因君话故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58903,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"盆荷次韵李宫允二首 其一","author":"潘希曾","text":"坐困炎蒸百事慵，对花犹觉野情浓。\n亭亭不尽淩波意，淡淡初回晕酒容。\n眼底西湖非幻景，尊前泰华有奇峰。\n绿漪清浅香风细，爱护仍愁急雨舂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58904,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"盆荷次韵李宫允二首 其二","author":"潘希曾","text":"赏心吟事病来慵，尚爱荷香一味浓。\n翠盖偶倾如故好，红妆微笑为谁容。\n出尘已绝三千界，过雨空疑十二峰。\n更谢主人能好客，留连不觉醉高舂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58905,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿司空陕西李公","author":"潘希曾","text":"关西自昔盛贤豪，晚节如公一世高。\n八座勋名垂竹帛，七旬风月老林皋。\n眠云华岳仙为侣，屑玉蓝田露作膏。\n笑看斑斓环膝下，年年介寿进春醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58906,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵李宫允赏莲四首 其一","author":"潘希曾","text":"骚坛意气许同袍，百战如公一世豪。\n花畔相携容易醉，又知公瑾本醇醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58907,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵李宫允赏莲四首 其二","author":"潘希曾","text":"纳凉深院怜荷静，共折荷筒当酒杯。\n十二阑干明月转，酒酣花睡两忘猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58908,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵李宫允赏莲四首 其三","author":"潘希曾","text":"酒傍芰荷香自别，肉兼丝竹调还高。\n晚来暑退堪行乐，坐待银河洗发毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58909,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵李宫允赏莲四首 其四","author":"潘希曾","text":"碧荷凝露夜凉新，命酒催诗第几巡。\n痛饮狂歌花事了，我犹忘我岂知人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58910,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望云图为张掌科季升题","author":"潘希曾","text":"东华尘土红作堆，生绡咫尺青山开。\n山头秋气洗天碧，惟有白云閒往来。\n临风引领者谁子，思亲梁公无乃似。\n谏议平生忠孝心，依稀写出丹青里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58911,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张主政用载之南京","author":"潘希曾","text":"秋风送新凉，垂杨荫官道。\n载酒城东门，话别何草草。\n嗟君璠玙资，特达知名早。\n观光上国春，奏赋长杨晓。\n俄承公府檄，独理金陵棹。\n周官重空土，经济摅远抱。\n燕山何迢遥，江流殊浩渺。\n南北不可期，使我怀忧悄。\n愿言崇令德，永以慰交好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58912,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠王处士","author":"潘希曾","text":"幽人家住西湖曲，晓集芙蓉夕餐菊。\n湖光山色怡心神，七十康强面如玉。\n一朝乘兴汗漫游，遍历齐鲁穷燕幽。\n素衣不惯缁尘涴，片帆归去天风秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58913,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄赠钟处士","author":"潘希曾","text":"富川云水草堂深，想见先生抱膝吟。\n献玉未明和氏泣，绝弦谁识伯牙心。\n渔舟小泛沿荷浦，书卷閒开傍竹阴。\n搔首日高犹散发，更无魂梦到朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58914,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送童贰守栗卿之姑苏","author":"潘希曾","text":"十年萍梗事堪嗟，犹喜相逢鬓未华。\n州县岂宜清庙器，诗书元自大方家。\n黄花暂醉离亭晚，鸿雁同征去路赊。\n回首吴江枫落夜，诗成须向故人誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58915,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送杜司训世良之丰县","author":"潘希曾","text":"丰沛英雄入彀来，春风桃李待栽培。\n千金久负屠龙艺，一笑重经戏马台。\n云暗楚天鸿雁杳，酒酣燕市菊花开。\n分携话及乡邦事，二十年前首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58916,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵张亚卿寓怀见寄","author":"潘希曾","text":"抱瘵秋欲暮，閒居寡朋俦。\n当轩理朱弦，聊以写我忧。\n明月忽在袂，好风如相求。\n神交有形外，曲终不待酬。\n轮蹄纷九逵，役役无时休。\n谁能谢来往，颇厌红尘浮。\n蔼蔼篱下菊，气味何芳柔。\n采之遗所思，庶为遐龄谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58917,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵荅李序庵","author":"潘希曾","text":"搔首流年万事新，交游赢得故情真。\n未论车马来今雨，直许金兰到古人。\n邀月酒杯频入夜，傍花棋局不沾尘。\n多君满腹琅玕在，阊阖终须次第陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58918,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阁老石淙杨公司空鹤山李公都宪东皋王公为同年之会予以年家子与席奉次石淙公韵二首 其一","author":"潘希曾","text":"台星瑞世累朝来，鼎立春风寿域开。\n宿德已为天下老，流芳还拟岁寒梅。\n题名三百元同榜，入会儿孙几举杯。\n乐事也知须尽兴，疏帘迟日任西颓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58919,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阁老石淙杨公司空鹤山李公都宪东皋王公为同年之会予以年家子与席奉次石淙公韵二首 其二","author":"潘希曾","text":"四海通家有自来，登堂今日绮筵开。\n试看当鼎调和手，都是先春馥郁梅。\n盛世喜成嘉会礼，后生叨进旅酬杯。\n三山并峙真堪范，竟日酣歌玉不颓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58920,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊祀分献四渎坛二首 其一","author":"潘希曾","text":"列炬薰天蔟紫坛，露华星彩溢虚寒。\n五云望切威严地，四渎名叨奠献官。\n礼乐雍容三代盛，精诚感格百神欢。\n遭逢未有涓埃报，拟赋甘泉寓责难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58921,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊祀分献四渎坛二首 其二","author":"潘希曾","text":"寰区润泽荷神功，登祀郊坛礼数崇。\n篚帛敬将从水色，篝灯高照切云红。\n石龛幽邃香烟表，碧殿玲珑树影中。\n对越再三分献罢，格天一德仰宸衷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58922,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"半隐王先生挽词","author":"潘希曾","text":"半隐先生本席珍，懒从三聘试经纶。\n此身已逐忘机鸟，有子还为瑞世麟。\n命服再膺荣昼锦，林泉终老遂天真。\n斜阳宰木今如许，剩有高风激后人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58923,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿蒲庵王封君八十","author":"潘希曾","text":"白发乌纱陆地仙，逍遥心迹寄林泉。\n蟠桃有待三千岁，甲子重过二十年。\n阅世方曈超色界，长生灵药在丹田。\n老莱膝下能儿戏，更向黄堂启寿筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58924,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蓝都宪生祠","author":"潘希曾","text":"仗钺收秦陇，成功归庙廊。\n金汤恩不浅，俎豆报何长。\n古柏隆中庙，甘棠召伯乡。\n封侯一时贵，未许望宫墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58925,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蓝都宪凯旋卷","author":"潘希曾","text":"笳鼓动欢雷，王师出塞回。\n鹰扬元帅勇，鼠窜众凶摧。\n露布三秦晓，风清万里埃。\n等閒尊俎地，真有折冲才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58926,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送蓝都宪升南京刑侍","author":"潘希曾","text":"分陕劳开府，留都诏促装。\n苏公终式敬，召伯孰能忘。\n西峙秦山重，东流汉水长。\n更悬天下望，调鼎在岩廊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58927,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初游醉翁亭次韩太卿庭方韵","author":"潘希曾","text":"久忆环滁胜，登临忽此亭。\n席分溪石润，酒带酿泉馨。\n院静禽时语，松深露昼零。\n古人那可作，聊诵壁间铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58928,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游琅琊寺不果次韵荅曹少卿汝学","author":"潘希曾","text":"名山闻说好亭台，千里怀游未果来。\n空羡暮云归老衲，竟留中路憩苍苔。\n泉迷庶子清难濯，岭望磨施翠不开。\n明日追陪了心赏，输君先我已三回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58929,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪晓次韵","author":"潘希曾","text":"朝来寒气透重衣，雪压茅檐半掩扉。\n院落光生花满树，池塘清绝玉为矶。\n舟横西涧无人渡，帘捲丰山断鸟飞。\n竟日拥炉官事简，诗成高兴转崔巍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58930,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丙子冬至次韩信山韵","author":"潘希曾","text":"天地阳回又此辰，履长馀庆仰皇宸。\n年华滚滚波同逝，官寺寥寥山作邻。\n冻合砚池从阁笔，暖生茶灶任添薪。\n滁阳细酒堪消日，拭眼梅花对早春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58931,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立冬日有怀京师诸友","author":"潘希曾","text":"东皇消息到江梅，鼓吹郊迎晓色开。\n五日新正浑醉里，百年残梦又春来。\n他乡綵燕随缘看，何处云鸿寄劄回。\n料得故人多健在，寻芳联辔满金台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58932,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"人日雪","author":"潘希曾","text":"入春二日逢人日，占岁宜晴苦不晴。\n冻雨作花还六出，终风吹冷竟三更。\n羊羔荐酒浑多事，蟹眼烹茶渐有声。\n访戴未能馀兴在，朗吟空对夕窗明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58933,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"廨舍梅久不开戏述","author":"潘希曾","text":"山城春到一旬强，墙角官梅尚未香。\n索笑几回虚杜老，惊时今已负何郎。\n空怜冻萼凝红蜡，安得南枝出靓妆。\n商鼎有须应忌早，故含元气混群芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58934,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"数日梅犹未开叠前韵","author":"潘希曾","text":"经冬相对意差强，半月东风未放香。\n远信不堪传驿使，幽期如待探花郎。\n日斜篱落贪春睡，月冷黄昏怯晚妆。\n为尔兴怀怀作恼，强裁诗句荅年芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58935,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵曹霜厓梅开见寄","author":"潘希曾","text":"霜葩初见隔墙枝，尚及新正未是迟。\n寒气袭人朝梦破，暗香牵兴晚吟宜。\n情多怕弄风前笛，病起思倾月下卮。\n我屋一株仍冷蕊，却疑春色与君私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58936,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅始开叠前韵","author":"潘希曾","text":"梅花照眼忽枝枝，冠绝中园不论迟。\n香远自缘冰雪助，格高偏与水云宜。\n临芳合有金声赋，送酒何惭玉液卮。\n湖上孤山应更好，偏舟终拟遂吾私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58937,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中梅花盛开","author":"潘希曾","text":"雪中留滞雨中开，二月相逢是晚梅。\n横水一枝仍韵在，闭门终日忽春来。\n眼怜冷艳移时立，心醉幽香命酒陪。\n正恐阴云妨月色，不教疏影到亭台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58938,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次日仍雨叠前韵","author":"潘希曾","text":"怀抱经春不自开，晓窗风雨正愁梅。\n香魂避湿应归尽，粉艳惊吹易落来。\n铁石广平心故在，湖山和靖兴难陪。\n阴晴等尔吾游倦，为汝须登月下台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58939,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵曹霜厓园梅为风所苦","author":"潘希曾","text":"寄语逋翁莫漫悲，风狂未损好花枝。\n芳宜送酒何愁落，香欲沾衣不惮吹。\n乍点宫妆凭小试，渐成鼎味待深知。\n繁华摆落尤奇绝，月夕来看豫作期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58940,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游琅琊","author":"潘希曾","text":"十里琅琊气郁葱，峰回路转兴难穷。\n禅房驾壑临清泚，石磴梯云到碧空。\n钟阜一卷烟霭外，长江疋练渺茫中。\n千年帝子留奇观，多少游人感慨同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58941,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"叠前韵荅曹霜厓","author":"潘希曾","text":"华裾几度望青葱，咫尺西邻眼欲穷。\n拄杖竟妨春雨湿，谈棋谁伴草堂空。\n青山半落閒愁里，白日都消断简中。\n薄暮诗来天渐霁，尚期歌咏一樽同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58942,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"曹霜厓以诗谢茗并致佳酒次韵","author":"潘希曾","text":"春睡昏昏颇泥人，叩门诗到日加辰。\n愧无琼玖偿投李，赖有交游托饮醇。\n馈茗敢誇阳羡胜，分醅真出酿泉新。\n枯肠醉里还堪润，月夕风晨此兴均。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58943,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"即事","author":"潘希曾","text":"滁上烟峦翠绕城，悠然相对转愁生。\n花枝几树初经眼，风雨连宵太薄情。\n上国交游书久绝，故园心事梦难成。\n等閒病起春过半，曳履池边看晚晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58944,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春风","author":"潘希曾","text":"底事春风喜叫呶，乍闻南陌忽东郊。\n重茅捲去随羊角，古木摧残堕鹊巢。\n料峭不禁轻酒力，飘零馀恨付花梢。\n寻常少出愁吹倒，多半韶光睡里抛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58945,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"即事四首 其一","author":"潘希曾","text":"江北江南一望中，便将迟早判春风。\n江南二月桃开尽，江北梅花正作丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58946,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"即事四首 其二","author":"潘希曾","text":"梅花狼藉杏花开，妆点山窗送酒杯。\n数日留连成底事，不知春色暗相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58947,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"即事四首 其三","author":"潘希曾","text":"每恨逢花易别离，不因雨打即风吹。\n亦知后会明年事，南北东西未可期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58948,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"即事四首 其四","author":"潘希曾","text":"故人见梦话平生，醒后依稀不自明。\n高阁日斜消息断，垂杨一树语流莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58949,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南郭","author":"潘希曾","text":"南郭青山映草堂，两年春梦落滁阳。\n空惭伯问新恩命，误入欧公旧醉乡。\n忧极江湖天渺渺，兴阑花鸟雨茫茫。\n日长人静惟危坐，消尽幽轩几炷香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58950,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄赠朱良矩改令丹阳","author":"潘希曾","text":"暂别仙班绾县章，泌阳期月又丹阳。\n恢恢馀地牛刀底，籍籍才名豸绣场。\n夜雨十年空梦寐，暮云千里益凄凉。\n江头香草堪纫佩，已觉流芳自此长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58951,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题太仆廨舍","author":"潘希曾","text":"官寺东头数亩宫，两年栖息足帡幪。\n白云户牖群山合，绿水池塘曲径通。\n花木不殊吾土好，茅茨犹有古人风。\n天涯吏隐惟迂拙，满壁题诗不务工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58952,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"携酒过曹霜厓即席次韵","author":"潘希曾","text":"经旬阴雨妨乘兴，此日壶觞径款门。\n万里风烟行处乐，几年离合梦中论。\n閒将象局消长昼，漫逐莺声过小园。\n醉倒竹根应不恶，明朝重到看生孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58953,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵荅韩信山","author":"潘希曾","text":"短鬓逢春不称搔，衙回聊免簿书劳。\n诗偿我债千篇少，楼羡君家百尺高。\n敢谓杜陵浑漫兴，亦知王粲未为豪。\n来朝作意同登眺，柳外花边任所遭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58954,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"遣兴","author":"潘希曾","text":"好诗莫苦吟，好棋莫贪著。\n苦吟徒劳呕出心，烂柯祗为贪棋错。\n诗以写我情，棋以拨我闷。\n意匠心兵不自持，斲丧真淳起争论。\n君不见三千风月醉一生，十九岐路谁能明。\n何如虚室坐终日，一洗烦恼令神清。\n孔删羲画不啻足，超然且与吾心盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58955,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"花柳吟","author":"潘希曾","text":"飞花满路春风香，柳条弄日鹅儿黄。\n如此风日亦可喜，趁逐儿女如颠狂。\n花香欲与兰争馥，柳黄渐似柏枝绿。\n为佩为梁自有真，往往风流托空谷。\n琅琊山椒一杯酒，坐我深春亦何负。\n吁嗟此意空寂寥，眼底纷纷醉花柳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58956,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"曹亚卿第赏梨花","author":"潘希曾","text":"梨花盈盈雪一树，照日不消半含露。\n香气氤氲百和馀，隔墙暗逐东风度。\n桃夭杏艳多名园，春深狼藉空愁烦。\n醒心忽到池塘路，疑是江梅初返魂。\n休将一枝看带雨，长门掩泣谁为主。\n莫待溶溶月满庭，素娥心事尤孤苦。\n快哉君家今日晴，酿泉之酒花边倾。\n更饶齿颊有张谷，梦回犹足消馀酲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58957,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵信山太卿重葺竹所","author":"潘希曾","text":"竹窗零落苍苔合，无复潇湘风雨枝。\n阶下锦绷才几个，凭君长养看猗猗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58958,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵韩太卿春昼见寄","author":"潘希曾","text":"一官閒散共天涯，忽忽春风已落花。\n不为绿苔怜踏破，杖藜终日话君家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58959,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春深二首 其一","author":"潘希曾","text":"落红无数委东流，狂尽杨花风亦休。\n春色老来堪爱处，绿阴门巷似清秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58960,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]