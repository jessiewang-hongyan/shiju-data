[{"title":"伯元明府招集小桃源 其一","author":"韩日缵","text":"朱绂宁堪恋，青山此卜居。\n一辞彭泽宰，遂拟武陵渔。\n洞口桃迷径，门前柳拂车。\n羡兄清境惬，吾亦欲焚鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伯元明府招集小桃源 其二","author":"韩日缵","text":"缘溪忘远近，忽已到山樊。\n阡陌斜侵郭，田池曲抱源。\n鸟歌窥绮席，松籁答清言。\n谷口渔人艇，停桡寂不喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伯元明府招集小桃源 其三","author":"韩日缵","text":"古屋青嵓畔，空林明月初。\n图书兼汉篆，鸡犬是秦馀。\n木客谙人语，园丁进野蔬。\n兴来欣命酌，莫遣绿尊虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伯元明府招集小桃源 其四","author":"韩日缵","text":"几载池塘梦，到来春草斑。\n对兄频得句，为我一开颜。\n堞雉当轩出，沙鸥伴客閒。\n问津重指点，流水正潺潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二十七日孝廉兄复载酒溪泛 其一","author":"韩日缵","text":"未惬溪边兴，重期触热来。\n竹阴移短棹，荷气送行杯。\n渡古云迷径，岩虚昼起雷。\n风澜殊不恶，一鸟掠波回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二十七日孝廉兄复载酒溪泛 其二","author":"韩日缵","text":"漫言沾湿好，倚棹醉花间。\n滴沥听疏竹，苍茫对远山。\n催诗岩雨急，把酒岭云閒。\n几处清溪曲，寻源殊未还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊集","author":"韩日缵","text":"无计销长夏，携樽对此开。\n松涛狂似雨，桂酒绿于苔。\n短榻时依树，微阴正送梅。\n凉飙如有意，飖飏向人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送二弟秋试 其一","author":"韩日缵","text":"握别欣兹夕，飞腾意转雄。\n珠光还媚泽，剑气已成虹。\n负笈携秋卷，开樽对晚峰。\n菲菲庭草色，待尔继家风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送二弟秋试 其二","author":"韩日缵","text":"送尔珠江去，悠悠有所期。\n腹充书可曝，心苦砚能知。\n渥水驹千里，郗家桂一枝。\n秋风看得意，佳讯慰慈帷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送龙太守上计 其一","author":"韩日缵","text":"白鹤峰前郡，高居百尺层。\n门庭清似水，寮吏凛如冰。\n买犊风能易，悬鱼早见称。\n坡仙遗址在，公暇亦堪凭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送龙太守上计 其二","author":"韩日缵","text":"廿载仍为守，褰帷噩水滨。\n鹏图还自矫，龙性讵能驯。\n俸禄不妻子，讴吟乃士民。\n但追循吏迹，遮莫叹前薪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送龙太守上计 其三","author":"韩日缵","text":"万井同讴颂，中和布乐声。\n岭云需大泽，江月促严程。\n执玉行何遽，还珠政已成。\n榕溪清见底，可以濯君缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送龙太守上计 其四","author":"韩日缵","text":"此去朝正月，才来匝一期。\n未须攀去辙，相与计还期。\n枫陛沾新渥，棠阴护旧枝。\n赐车高丈许，旋慰郡人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春先一日陪王虞石侍御饮西湖即席赋 其一","author":"韩日缵","text":"湖色澄如练，鱼龙亦避骢。\n气凌苍壁峻，心似碧霄空。\n道泰三阳转，时和八蜡通。\n追欢逢令节，幸遘衮衣东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春先一日陪王虞石侍御饮西湖即席赋 其二","author":"韩日缵","text":"不是欣同赏，其如胜地何。\n濡毫山借丽，洒泽水增波。\n淑气催玄籥，薰风入浅莎。\n霜威人所惮，今已布阳和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题导舆洞为李若回别业盖取潘黄门板舆奉母之义乃兄中丞所命 其一","author":"韩日缵","text":"园亭开胜地，扫径奉慈颜。\n树背萱长茂，池前草已斑。\n捧舆过竹下，调膳出花间。\n水石留连处，相将带月还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题导舆洞为李若回别业盖取潘黄门板舆奉母之义乃兄中丞所命 其二","author":"韩日缵","text":"半榻烟云拥，千峰爽气攒。\n顾将青嶂色，长奉北堂欢。\n绕径时生笋，循陔更采兰。\n中丞同献寿，为弟尔应难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"懒","author":"韩日缵","text":"自哂懒成癖，幽栖独结茅。\n酒钱贫亦得，诗兴病来抛。\n白日少尘事，青云谢故交。\n扶藜随所往，月色在松梢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"盛德生医士过访","author":"韩日缵","text":"一卧榕溪晚，谁为问索居。\n江边吴客棹，箧里越人书。\n使我刀圭习，于君酒盏疏。\n年来病是懒，可藉药能除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚申元日试笔 其一","author":"韩日缵","text":"我从休沐后，献岁已更三。\n簪绂心偏远，斓斑态转憨。\n导舆时藉草，绕膝或分柑。\n采采兰堪撷，循陔每自南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚申元日试笔 其二","author":"韩日缵","text":"腊残已掷旧，朝旭喜呈新。\n自觉春归好，那惊岁去频。\n条风宽酒力，软节畅花神。\n彩仗烟霄上，沈情郁未申。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孝兼兄水亭夜酌四首用马时良扇头韵 其一","author":"韩日缵","text":"诛茆新辟境，折简促鸣驺。\n依水真成胜，凭轩即当游。\n榕阴移短榻，莲渚系轻舟。\n一室堪遐眺，岚光傍席浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孝兼兄水亭夜酌四首用马时良扇头韵 其二","author":"韩日缵","text":"庭芳交晚色，池草媚春容。\n烟羃应迷竹，涛来欲听松。\n溪云深此夕，水榭飒如冬。\n杯酒宁嫌数，乘閒即过从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孝兼兄水亭夜酌四首用马时良扇头韵 其三","author":"韩日缵","text":"雁行时逐队，鸥社喜相亲。\n瓶荐榴花剧，樽开竹叶新。\n百年同逆旅，数日迭为宾。\n愁见三春莫，觥筹莫厌频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孝兼兄水亭夜酌四首用马时良扇头韵 其四","author":"韩日缵","text":"林木居然异，琴尊复此游。\n月华临近沼，天翠隔前丘。\n胜会凭诗畅，良宵拚醉酬。\n新荷才贴水，蔟蔟复悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题曾泽卿侍御永济桥 其一","author":"韩日缵","text":"高堰凌通术，飞梁架急湍。\n形疑螮蝀合，势似螭龙蟠。\n跨去鼋无力，鞭来石有瘢。\n斜阳溪水畔，清影倒阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题曾泽卿侍御永济桥 其二","author":"韩日缵","text":"迤逦东山路，桥成压古堤。\n星文连粉堞，虹影入清溪。\n策驷曾题柱，观鱼或杖藜。\n济川君自裕，利涉遍群黎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读车丈人大軱集有感 其一","author":"韩日缵","text":"久矣宦情薄，其如赋兴豪。\n飞文丽绮縠，落笔捲波涛。\n身逐风尘老，心耽楮墨劳。\n时名原不竞，非欲借诗逃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读车丈人大軱集有感 其二","author":"韩日缵","text":"生计从寥落，豪情自慨慷。\n一官诗是祟，万态酒堪忘。\n醉卧流觞处，吟当梦草堂。\n永嘉王谢迹，吊古独傍徨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读车丈人大軱集有感 其三","author":"韩日缵","text":"世态原苍狗，吾生只蠹鱼。\n拟骚称惜诵，作赋是閒居。\n任积中山箧，慵题别驾舆。\n从知拙者效，端合叹归与。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读车丈人大軱集有感 其四","author":"韩日缵","text":"十年仍吏隐，终日坐书淫。\n馀唾羞王李，高情托尚禽。\n毁难销傲骨，归恰称閒心。\n赖有新编在，名山未陆沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过邓伯乔水亭夜酌 其一","author":"韩日缵","text":"地爱依林僻，亭因傍水幽。\n卜邻才数日，托契已千秋。\n兴剧谈非马，机忘狎是鸥。\n墙头堪过酒，聊作醉乡游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过邓伯乔水亭夜酌 其二","author":"韩日缵","text":"凉飔飏林际，相对坐清幽。\n赏惬孤灯夕，炎袪五月秋。\n芸窗供老蠹，莲渚浴轻鸥。\n结想同濠濮，凭轩即当游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏五黄元卿招同韩孟郁邓伯乔赵裕子饮渌水草堂","author":"韩日缵","text":"径辟炎氛隔，亭馀水木清。\n求羊宁我辈，浮蚁为君倾。\n倒景千林出，迎风一榻轻。\n须拚十日饮，才惬数年情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过薛伟干吹藜馆留题","author":"韩日缵","text":"阶前森玉树，何物尽宁馨。\n挟策犹萤案，吹藜忆鲤庭。\n隔帘山鸟啭，窥牖晚峰青。\n鼓棹过荀里，惊传聚德星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贲禺曾文卿甫总角能诗能大篆能画赋赠一律","author":"韩日缵","text":"小友吾欣托，仙才尔自殊。\n虎头痴欲绝，鸟□□能摹。\n彩笔花应妒，清姿酒或扶。\n数人凭荫映，今夕且相娱。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丹枫","author":"韩日缵","text":"枫叶红于染，津亭耐岁寒。\n青岚烟未罩，赤烧火初残。\n不是迎霜老，应为向日丹。\n冬林秋色在，正好隔江看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚泊鸥潭","author":"韩日缵","text":"偶此泊鸥潭。\n矶头傍古岩。\n鸥群閒自戏，潭影净于蓝。\n远渚晴岚润，孤舟夕照衔。\n机忘相上下，狎尔羽毵毵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠罗建昌","author":"韩日缵","text":"风扑雪披猖，苍茫接大荒。\n行过艾子国，幸袭令君香。\n驿树含残冻，城乌噪夕阳。\n闾阎熙乐岁，爆竹趱年芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"德安道中大雪 其一","author":"韩日缵","text":"征路难逢霁，侵晨踏雪来。\n有田皆种玉，无树不成梅。\n疲马冲泥怯，饥乌阻冻回。\n风霜良已厉，款语劳舆台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"德安道中大雪 其二","author":"韩日缵","text":"霏霏寒絮色，平野入空冥。\n鸟道皆成素，虬松独露青。\n溪边迷鹭影，云际失峰形。\n借问庐山道，褰帷且暂停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中过东林寺 其一","author":"韩日缵","text":"驱马庐山曲，冥濛不见山。\n雪疑扃岫幌，人自扣禅关。\n偶觅虎踪去，仍披鹤氅还。\n远公如可访，溪水尚潺潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中过东林寺 其二","author":"韩日缵","text":"桥下溪声急，微茫乱远钟。\n半山云压寺，深院雪欹松。\n涧落何年瀑，烟藏若个峰。\n灵山缘未了，他日许相从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望天池寺","author":"韩日缵","text":"杳霭天池寺，庐山第几峰。\n御题丹碣重，荒径紫烟封。\n鸟没云无迹，僧归雪有踪。\n不辞屐费齿，惆怅隔林钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖口望瀑布次张曲江韵","author":"韩日缵","text":"飞瀑从天下，悬石净晚氛。\n飘时全似雪，滴处半和云。\n风断珠还缀，涛来松并闻。\n湖光纤翳尽，佳气坐氤氲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上","author":"韩日缵","text":"几日维烟渚，凄凄动客怀。\n短蓬从雪打，古岸有云埋。\n天地晴难料，风波性渐谐。\n江边留亦得，鸥鹭本吾侪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醒心亭","author":"韩日缵","text":"兹亭何独醒，勺水自泠然。\n醒醉浑无著，风流自昔贤。\n醉元不在酒，醒亦岂关泉。\n顾以醉中意，还为醒者传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大店驿时轮蹄络绎邮吏多逋感而赋此 其一","author":"韩日缵","text":"荒墟村市远，门巷半榛芜。\n但讶高轩过，宁知我马瘏。\n追呼一何怒，喘息未全苏。\n中使传仍急，天边尺一符。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大店驿时轮蹄络绎邮吏多逋感而赋此 其二","author":"韩日缵","text":"亦知罢困甚，其奈客程何。\n未遂单骑去，居然拥传过。\n村墟新杞棘，帝里旧山河。\n目击萧条状，餐钱愧已多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"濠上","author":"韩日缵","text":"烟郭新晴后，春流解冻初。\n漆园今可作，濠上意何如。\n不辨身非蝶，宁知我是鱼。\n临渊观逝者，此乐亦蘧蘧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夹沟道中","author":"韩日缵","text":"迢迢烟莽路，村落几家馀。\n山鸟迎征盖，溪云上客裾。\n松声风里度，柳眼雪中舒。\n把耜谁家妇，蒿莱半不除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宋明经授易彭城有道士也其门人祀之索赠一章","author":"韩日缵","text":"伊人振芳躅，恰是郑公乡。\n古籍频供枕，寒茅颇映堂。\n饔飧资弟子，卦象契羲皇。\n门下传经者，谁窥赐也墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夫子手植桧","author":"韩日缵","text":"梁木讵云坏，而今一桧垂。\n灵根真不死，神理永如斯。\n纵有秦灰焰，还依鲁壁滋。\n所钦遗泽在，犹似手栽时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将母途中 其一","author":"韩日缵","text":"捧檄情无限，慈闱六十强。\n征途频日月，衰境怯风霜。\n笋绕村篱下，乌啼驿舍傍。\n黄河鱼正美，且荐老亲尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将母途中 其二","author":"韩日缵","text":"值此严寒候，板舆时自将。\n星檐调夕膳，月砌促晨装。\n问寝重绵薄，分甘野簌香。\n候人将进酒，先著老莱裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄梁石楼明府","author":"韩日缵","text":"为问石楼老，楼居近若何。\n社开双梵古，歌出五噫多。\n世路怜浮梗，生涯羡碧萝。\n秋来篱菊好，相忆滞鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读张见平题豫让桥","author":"韩日缵","text":"千载辽阳鹤，苍茫不可寻。\n遥知持斧意，不负漆身心。\n塞外鸣笳断，桥边度马深。\n无惭国士报，读此益沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过临颍","author":"韩日缵","text":"幸值唐虞代，犹悬旷士思。\n瓢轻聊可挂，屣敝讵难遗。\n颍水宁留染，鹪林尚有枝。\n翛翛尘外意，谁与问襟期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"余与李伯襄宫允俱有桐封之役伯襄自上党竣事还相遇汝南喜而有赋 其一","author":"韩日缵","text":"易水君先发，相逢复汝坟。\n行过九折坂，踏破万重云。\n节并丹霄下，茅从两地分。\n南行堪比袂，无事叹离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"余与李伯襄宫允俱有桐封之役伯襄自上党竣事还相遇汝南喜而有赋 其二","author":"韩日缵","text":"别后时相讯，联镳幸此辰。\n羁怀俱异地，偶聚得同人。\n雪砌分题遍，寒宵贳酒频。\n王程余未尽，羡尔自繇身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与李伯襄宫允同发汝南余晚至真阳迟伯襄不至邮吏云中途止宿民舍诗以讯之 其一","author":"韩日缵","text":"相迟久不至，相望意空频。\n星驾朝同发，寒灯夜独亲。\n差池怜羽翼，去住任风尘。\n今夕翛翛意，松筠自作邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与李伯襄宫允同发汝南余晚至真阳迟伯襄不至邮吏云中途止宿民舍诗以讯之 其二","author":"韩日缵","text":"邮吏传音至，荒郊滞客轮。\n襜帷云气冷，鸡黍野情真。\n场藿堪维骑，村醪暂入唇。\n田家如借问，莫道是王人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄州山行见竹","author":"韩日缵","text":"颇惬山行意，仍馀看竹情。\n峰盘之字径，樱有此君名。\n色带晴岚翠，声兼石濑清。\n经过莫问主，懒性厌逢迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄家楼寄宿田家 其一","author":"韩日缵","text":"山行看欲晚，投宿到田家。\n茅屋侵云气，绳床染雪花。\n盘中供簌笋，门外即桑麻。\n问客何方至，辚辚驷马车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄家楼寄宿田家 其二","author":"韩日缵","text":"村烟藏复嶂，绕屋是新畬。\n寥落才三户，敦庞自一家。\n罍空从妇乞，客至向邻誇。\n爆竹欢儿女，犹能竞岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桐封之役余与谢沛霖大行共事豫章大行兼程趋事余病羸每独后书引奉讯","author":"韩日缵","text":"寒风方应节，候雁共南翔。\n夜度湘江月，晨飞荻浦霜。\n相将欣结阵，每逐不成行。\n自怯排云力，江天路正长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻李伯襄宫允至黄家楼亦问余旧主人寄宿","author":"韩日缵","text":"诛茅傍翠壑，三五自为邻。\n不是逢迎惯，何缘止宿频。\n门前金马客，天上谪仙人。\n孔父曾过此，栖栖亦问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孔家龙道中","author":"韩日缵","text":"献岁王正月，寻春楚四郊。\n柳芽舒旧缕，梅蕊吐新苞。\n岳气衡庐接，寒流汉沔交。\n阳和今已遍，林鸟亦啁啁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]