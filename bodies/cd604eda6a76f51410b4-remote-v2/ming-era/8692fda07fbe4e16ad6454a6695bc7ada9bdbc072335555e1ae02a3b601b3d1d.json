[{"title":"厓山吊古 其二","author":"张同祁","text":"朝事艰危转见遭，只将哀些重挥毫。\n肉缘赵氏孤应切，目满遗弓远自劳。\n乱世君臣虚石画，青天龙虎散旌旄。\n只今窑鳖滋苔藓，日落苍茫寒暮涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓山吊古 其三","author":"张同祁","text":"赵家诸将气如虹，多难能堪辇路中。\n组练久虚军戍垒，楼船俄卸帝王宫。\n天亡血食传先庙，水战身歼仰数公。\n大洗腥风承圣主，不须含恨在江枫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东安城陈太保祠陈璘像赞","author":"阙名","text":"将军磊落出人群，历尽疆场百战身。\n天子正开麟阁待，勿言臣鬓已垂银。\n解甲归来贼垒空，凯歌旌散酒旗风。\n主恩未报身还在，血战谁论第一功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石人耸翠","author":"阙名","text":"起立中霄护碧苔，耸身直欲谢氛埃。\n擎天柱地应长在，未许居人作谶猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石坂晴岚","author":"阙名","text":"百峰山头石坂潭，雨兴云雾晴飞岚。\n廖公芳迹已千载，真人此地时扪参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铜鼓春涛","author":"阙名","text":"海晏春潮高接天，蛟龙吹浪拍山巅。\n暖风更拥洪崖雾，飞作越南万井烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文径吊古","author":"阙名","text":"汴宋炎灰散海云，翠华踪迹不堪闻。\n大忠争说文丞相，千载谁知义士魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"龙溪仙蜕","author":"阙名","text":"神仙之事何渺然，龙溪蜕骨至今传。\n此去蓬莱应几许，寻真采药定何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤山石室","author":"阙名","text":"紫阳真人久不作，勾漏丹砂那可餐。\n吾将炼药向石室，身骑彩凤觅琅玕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苏渡怀贤","author":"阙名","text":"钟鼎丹成骨已仙，东坡空唤渡头船。\n我来二老俱陈迹，绿水青山尚俨然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"静斋","author":"康麟","text":"高人尚幽独，卜筑淡无营。\n道在贫何病，心闲梦亦清。\n山光当镜落，草色入帘青。\n仰止巢由者，千秋垂令名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日有怀柬李公子","author":"康麟","text":"金陵淹旅食，况复岁华深。\n隔枕一声雁，离人千里心。\n青灯寒照影，白雪苦牵吟。\n赖有贤公子，时来叩赏音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夜有感","author":"康麟","text":"旅馆萧条岁事阑，独凭杯酒强为欢。\n家林闲舍三年别，客路梅花几度看。\n春意又从今夕暖，宦情还似旧时寒。\n催人光景如流水，莫遣秋霜点鬓端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚渡扬子江","author":"康麟","text":"浩浩长江晚正晴，仙舟如画一毫轻。\n空中云接高低树，镜里天浮上下星。\n锦缆牵风归鸟断，兰桡摇月睡龙醒。\n三更候吏津头立，笳鼓声中道姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过淮安","author":"康麟","text":"官船清晓渡淮安，满目风情入画看。\n衰柳冻含江雪暝，早梅香逐水云寒。\n酒沽绿市朋簪合，人忆青楼客况难。\n王事驱驰当自勉，不须回首更盘桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟至鲁桥遇雨有怀戏绩子明旧句","author":"康麟","text":"风雨潇潇暗鲁桥，兴怀其奈酒初消。\n瑶琴有恨惭司马，金屋无情锁阿娇。\n宾雁稀疏音信杳，楚天空阔梦魂遥。\n何时得遂三生约，来向秦楼听凤箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游兴化寺","author":"康麟","text":"一入招提境，浑忘尘世踪。\n昙花飞扑马，法雨洒降龙。\n台殿丹青古，林峦紫翠重。\n香朝常供佛，齐午不鸣钟。\n梅蕊晴薰雪，葭灰暖逼冬。\n追陪人杂遝，语笑气从容。\n鹿女衔花献，山僧煮茗供。\n静中闻一鸟，幽处见双松。\n览胜贪如画，谈玄悟彼宗。\n题诗纪良会，红日转西峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬至感怀","author":"康麟","text":"客里逢佳节，骎骎百感招。\n瞻云亲舍远，望阙玉宸遥。\n道否凭阳泰，愁多仗酒消。\n何时风力便，鸣佩再趋朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫词","author":"王司彩","text":"璚花移入大明宫，一树凝香倚晚风。\n赢得君王留步辇，玉箫吹彻月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日","author":"冯银","text":"坐对北窗凉，晴空日正长。\n柳深莺语滑，花落燕坭香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画","author":"冯银","text":"青云乔木古，翠竹远山青。\n昨夜东风暖，池塘草未生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春","author":"冯银","text":"绿暗红稀春已深，东风吹度小墙阴。\n凋荣何恨人间事，独倚幽窗数过禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端阳竞渡","author":"冯银","text":"端阳竞渡楚风存，疾较飞凫夐出群。\n棹起浪花飞作雪，竿飏旗彩集如云。\n一时豪杰追卢肇，千载忠魂吊屈君。\n两岸红裙笑俚妇，那知斗草独笼芸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏蝉","author":"冯银","text":"身高吸霄瀣，羽薄趁仙风。\n自奏清商曲，泠泠山水中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题吹弹歌舞图 其一","author":"丘夫人","text":"谁家有女颜如玉，手持几竿昆崙竹。\n镂金编云一片形，含商弄羽千般曲。\n一声迟，晓起丹山彩凤啼。\n一声疾，夜半孤舟嫠妇泣。\n一声喜，秦楼仙侣同飞起。\n一声悲，异时忠臣乞食归。\n十分妙趣真无比，良工写入霜缣里。\n时人莫道是无声，仙声不入凡人耳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题吹弹歌舞图 其二","author":"丘夫人","text":"中虚外实木一片，抱向佳人怀里见。\n玎玎珰珰几点声，细细粗粗四条线。\n一声清，半夜天高万籁鸣。\n一声浊，八月秋风落群木。\n一声苦，昭君马上啼红雨。\n一声欢，妃子宫中洗禄山。\n风流画史龙眠老，笔端写出心机巧。\n劝君莫道是无声，有声不似无声好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"德庆望夫水诗","author":"林瑞鸾","text":"一片幽思尚未平，碧溪流水日盈盈。\n何年却化辽城鹤，还向人间唤一声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄余玉馨表妹 其一","author":"陈云仙","text":"往年同学换鹅经，冰镜无尘玉有馨。\n织锦才高推独步，落梅妆好对双清。\n春朝携手看花发，秋夜凭肩待月明。\n别后相思烟水隔，海棠红绽想仪形。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄余玉馨表妹 其二","author":"陈云仙","text":"忆别分携在柳阴，奇山上望象山岑。\n手牵玉藕丝难断，口嚼青茶苦自禁。\n古镜不磨难见面，银缸未点尚留心。\n寥寥孤馆同谁语，芭雨桐风几夜深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄外","author":"陈云仙","text":"去时尔语尚云云，去后音书总不闻。\n残黛懒描三月柳，乱鬟愁理一梭云。\n可堪林际鸠呼妇，颇奈天边雁叫群。\n难得相逢容易别，机丝何用织回纹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江行","author":"陈云仙","text":"止为偷闲狎鹭鸥，扣舷歌唱出沙洲。\n又从别浦寻幽兴，观采荷花女伴游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日怀外","author":"陈云仙","text":"木栏杆外思依依，目断天涯去雁飞。\n心欲裁书何处达，诗题红叶泪沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"美人看剑","author":"陈云仙","text":"试取妆前玉匣开，光铓秋水迫人来。\n风尘可与儿夫佩，漫道儿夫得意回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古","author":"余玉馨","text":"西陆起凉飙，高梧坠秋叶。\n出户闻寒蛩，开窗见明月。\n美人天一方，伤情又离别。\n离别有所思，梦寐恒见之。\n凛然松柏操，瑩如冰玉姿。\n为言持贞素，值晤自有期。\n欢会未及终，怅尔闻晨鸡。\n亭亭东方树，渐觉含朝辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日有怀","author":"余玉馨","text":"朝露摧百草，秋光忽元暮。\n黄花缀短篱，红叶辞高树。\n西风飒然来，萧条及庭户。\n疏枝寒蝉咽，晴宵征雁度。\n对兹万感生，幽意无人诉。\n关山阻且长，惆怅天涯路。\n思之不可见，延伫劳心愫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春寄夫君","author":"余玉馨","text":"海棠浅插金壶水，短笋穿苔突鸦觜。\n飞尽杨花困正多，壁间尘阁閒焦尾。\n屏山迸落云母光，砚池黑点龙煤香。\n朱帘捲春春不住，绿阴满院生微凉。\n冰弦零落疏飞雁，有美人兮不相见。\n新愁无赖上双眉，写入薰风白团扇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"从家君赴任舟过清远峡","author":"余玉馨","text":"彩鹢凌晨发，蒲帆直向东。\n烧痕经雨绿，败叶带霜红。\n望寺知程近，看山到水穷。\n仙家在何处，时送隔林钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日念征人","author":"余玉馨","text":"炎天霜晚雁来迟，才见黄花放几枝。\n乍雨乍晴重九节，轻寒轻暖暮秋时。\n锦机有字凭谁寄，纨扇无情祇自知。\n欲陟崔嵬望远客，碧云峰影正参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日得书","author":"余玉馨","text":"征人天外怨离居，近接清江锦鲤书。\n明月似环人去后，碧天如水雁来初。\n梧桐叶落频惊梦，菱镜尘封久罢梳。\n愿作飞尘随远道，乘风犹得上君车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惜花春起早","author":"余玉馨","text":"秾绿娇红舒嫩萼，夭桃乍放缃梅落。\n帘幕低垂白玉钩，鞦韆斜挂香丝索。\n金屋佳人睡觉来，侍儿秉烛照兰台。\n九十春光容易老，未明先看牡丹开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"爱月夜眠迟","author":"余玉馨","text":"晚妆不整云鬟卸，梨花院落閒清夜。\n桂影初移画阁东，纱窗斜映蟾光射。\n玉人不寐倚阑干，贪玩冰轮不觉寒。\n银汉星移繁露坠，庭前犹自捲帘看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"掬水月在手","author":"余玉馨","text":"玉盆满注苍龙吐，寒光直射清虚府。\n水月相逢不可分，山河倒影真堪数。\n一泓清彻浸春葱，擎得嫦娥在掌中。\n疑是瑶池仙子伴，故将金镜照天宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"弄花香满衣","author":"余玉馨","text":"春暖东风晓来急，乱红深处佳人立。\n摘将茉莉雪华明，簪得蔷薇露犹湿。\n归来蜂蝶趁成行，郁郁清芬满绣房。\n不用沈檀薰罗绮，锦衾翠袖带馀芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春感怀","author":"余玉馨","text":"九十春光似转篷，半晴天气雾濛濛。\n一池新水今朝雨，满地残花昨夜风。\n画角帘开双入燕，碧消云净断归鸿。\n韶华过眼真堪惜，何日王孙马首东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏夜","author":"余玉馨","text":"微月近前庭，风凉玉露零。\n香眠花里蝶，星坠柳梢萤。\n玉漏频传箭，银河若建瓴。\n徘徊不成寐，起傍小池行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日即事","author":"余玉馨","text":"水涨千江雨，林红一夜霜。\n秋深鹰力健，风急雁声长。\n金井馀阴薄，银床滴露凉。\n飘零白羽扇，犹带旧时香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次陈云仙表姊寄怀原韵首韵乃先君讳也谨更一韵奉答","author":"余玉馨","text":"忆昔分携在玉京，至今罗袖有馀馨。\n才如池草争春绿，人似梅花带雪清。\n违别十年天共远，相思千里月同明。\n夭桃一树临窗发，犹向枝头想旧形。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元宵帘下观游者","author":"余玉馨","text":"十二芳街近晚晴，争排弦管调清平。\n花开火树通宵灿，灯拥鳌山彻夜明。\n月色溶溶莲步速，云鬟冉冉佩声轻。\n遗簪落翠知多少，散逐东风满穗城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"弹琴","author":"余玉馨","text":"閒来独自鼓焦琴，夜静焚香是赏音。\n万里家乡随地远，七弦嘹喨对天吟。\n清风明月襟怀阔，流水高山怨恨深。\n弹到落梅谁会得，楼敲钟鼓坐花阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠寺","author":"余玉馨","text":"隔岸烟花是锦城，水晶宫里有歌声。\n洲边鸥鹭随流至，窗外帆樯破浪行。\n绕槛鱼龙风雨过，拍崖霜雪海潮平。\n江空露冷三秋后，多占人间夜月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏燕","author":"余玉馨","text":"二月园林桃杏开，重来还识旧楼台。\n应知冬向山中蛰，浪说春从海上回。\n冲雨柳塘黏绿絮，掠泥花径带苍苔。\n乌衣旧宅何人住，沧海桑田几劫灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春","author":"余玉馨","text":"风柔南陌草芊芊，渐近清和四月天。\n云净高楼无去雁，雨晴深苑有啼鹃。\n扫除花锦铺苔席，摇荡春光飞柳绵。\n屈指韶华如过隙，可令容易度流年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与姑对弈","author":"余玉馨","text":"听雨开芸阁，看花倚绣楹。\n遣怀棋数局，原不为输赢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日","author":"余玉馨","text":"冬日如春日，池塘水不冰。\n偶来书阁坐，喜见石潇青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"围棋即事呈夫君","author":"余玉馨","text":"重围或是兴王地，一子能当生死关。\n到得功成无着处，机心用尽不如闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"余玉馨","text":"秋声昨夜入梧桐，金井银床影半空。\n捣尽夜衣不成寐，半钩新月一帘风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春闺怨","author":"王氏","text":"东风帘捲画楼西，目断王孙草色萋。\n莺织旧愁穿柳线，燕衔新恨湿花泥。\n梦随流水情添急，眉锁青山翠压低。\n惆怅天涯春欲尽，海棠花落杜鹃啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏闺怨","author":"王氏","text":"锦褪残红色更佳，伤心无语步苔阶。\n忍看竹簟人相倚，羞见莲房子并挨。\n耳断蝉声悲昼永，情随鸳梦到天涯。\n无端抱恨双飞燕，敲拆妆台一股钗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋闺怨","author":"王氏","text":"飒飒金风恨转催，月明霜冷傍妆台。\n解吟画壁蛩添唧，叶卜金钱菊又开。\n翡翠衾单思正邈，芙蓉帐暖梦初回。\n天涯极目排云雁，不见多情一字来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬闺怨","author":"王氏","text":"思入新寒倍怆神，三冬犹有未归人。\n牙床冷浸冰壶月，玉枕香销翠被春。\n梅蕊恨随千点雪，灯花摇落半釭银。\n醉回帐底羔羊酒，谁在天涯念细君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辞姊妹","author":"刘苑华","text":"同作花根叶，复作叶前花。\n花中七姊妹，并蒂复连丫。\n盈盈二八月，引蔓如蓬麻。\n春风时见面，秋月明朱华。\n一旦离长蔓，袅袅天之涯。\n北柯恋南条，风飘素云遮。\n柔条与绿叶，望望长风沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日重游白衣尼庵","author":"刘苑华","text":"黄叶凄风散碧岑，禅关寥寂至于今。\n侬因爱竹重相访，尼亦看经未可寻。\n四面短垣浮野色，数声高鸟入空林。\n闺中暂可停针线，仙梵频闻一洗心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟发罗江问侍女","author":"刘苑华","text":"门前瞬息即天涯，刚是辞家便忆家。\n试问罗江几丫水，送人云里拾春花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"理妆","author":"刘苑华","text":"春来长是为花愁，今日临妆上小楼。\n自理乌云撩绿鬓，好将时样学苏州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辞父受二聘","author":"谢五娘","text":"卓荦黎生先有聘，风流钟子后相亲。\n桃花已入刘郎手，不许渔人再问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柳枝词","author":"谢五娘","text":"近水千条拂画桡，六桥风雨正潇潇。\n枝枝叶叶皆离思，添得啼莺更寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春暮","author":"谢五娘","text":"杜鹃啼血诉春归，惊落残花满地飞。\n惟有帘前双燕子，惜花衔起带香泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏","author":"谢五娘","text":"庭院薰风枕簟清，海榴初发雨初晴。\n香销梦断人无那，听得新蝉第一声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏","author":"谢五娘","text":"啼鸟声中午梦回，篆香重拨已成灰。\n东风似恨春归去，吹送杨花入户来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]