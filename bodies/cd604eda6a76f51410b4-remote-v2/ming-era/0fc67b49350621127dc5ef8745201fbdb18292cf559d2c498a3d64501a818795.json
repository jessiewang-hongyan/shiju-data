[{"title":"夏日漫兴 其九","author":"凌义渠","text":"乡思泽国渺难通，菱芡茭芦候略同。\n百颗无繇持饷远，冰盘初浸麝香红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25555,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日漫兴 其十","author":"凌义渠","text":"昵昵留人独有情，魏家酿法近知名。\n别饶香色添新妙，朝贵相遗只数罂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25556,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日漫兴 其十一","author":"凌义渠","text":"近晓西风作意寒，衰荷夜半泣丛残。\n分明官舍同僧舍，总有繁花不耐看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25557,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日漫兴 其十二","author":"凌义渠","text":"摇唇鼓翅憎蝇多，扇不能驱奈汝何。\n见说城南冤雾黑，新埋战骨未销磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25558,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日漫兴 其十三","author":"凌义渠","text":"率然携榼即为群，共简藏书到日曛。\n依旧尘封兼鼠耗，可知读律不论文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25559,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日漫兴 其十四","author":"凌义渠","text":"祗凭一静远多机，奕旨琴心参较微。\n胜固欣然败亦喜，挥弦不了送鸿飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25560,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"连拔白髭数茎览镜有作","author":"凌义渠","text":"积尘而有身，身为尘所隔。\n相驱故相苦，茫茫日煎迫。\n随身小照子，出入巾笥侧。\n听汝告其诚，为我通颜色。\n有泉竭自中，津津不知歇。\n有盌触手碎，英英护其缺。\n全力敌光阴，输此寸茎白。\n黑白变化间，白多岂胜摘。\n一叶落知秋，风林坐萧摵。\n气候命之然，不霜焉可得。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25561,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"孙太君旌节诗","author":"凌义渠","text":"河水浩浩激平陆，中有清流未全洑。\n持兹匪石一片心，夺却千春红与绿。\n奉姑既婉抚婴慈，了此晨昏足饘粥。\n琬琰名留非所期，祝取重泉声影续。\n自是哀乐关至性，五十年来类转烛。\n领选好用此辈人，隔世隐隐如相勖。\n翘首天门雾色开，海底珊瑚照初浴。\n华表鹤引仙乐至，蒸兰泄桂纷尔族。\n旁人眼热最繁枝，那识从前一枯木。\n枯荣嘘变固其常，唯母永贻孙子谷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25562,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"濠梁渡口","author":"凌义渠","text":"满掬沙尘影，泚然向此中。\n鸥凫随俯仰，厉揭自西东。\n寒暴恒愁雪，帆轻不问风。\n潺湲如可听，孤梦恰能通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25563,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夜符离旅舍 其一","author":"凌义渠","text":"姻友同兹地，有怀各自持。\n荒陂一饭涩，馀俗隔江疑。\n所赖歌吹杳，稍怜杯酒迟。\n客程应未半，华发已丝丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25564,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"除夜符离旅舍 其二","author":"凌义渠","text":"是夜皆难掷，何言旅思凭。\n蹄轮虽暂缓，沙雾此相仍。\n得酒欢童仆，叙年先友朋。\n照来心历历，微灭半床灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25565,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春试偶以他事尼不得与闵园客同行途中恨之","author":"凌义渠","text":"宛尔同追逐，重寻味似长。\n稍期平日意，引憩道途傍。\n有望兼晨夕，将心照雪霜。\n行行入凄澹，不独为离乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25566,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓发河间道中","author":"凌义渠","text":"指屈前途日，翻如望到家。\n早行迷近远，舆梦任欹斜。\n雾压村村路，霜明树树花。\n亦知寒气薄，官柳半藏鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25567,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"采藤花","author":"凌义渠","text":"灌莽纷回薄，孤烟向此澄。\n盈筐秋瑟瑟，过雨绿层层。\n蕊炙新宜脯，香飞远供僧。\n携群终采采，雅意托閒朋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25568,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"补螺庵花影诗示闵园客兼寄潘稚生 其一","author":"凌义渠","text":"壁上互吞吐，延之以隙光。\n稍争势曲折，如对月微茫。\n久视分须蕊，澄心映色香。\n祗愁身渐幻，欲向影边藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25569,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"补螺庵花影诗示闵园客兼寄潘稚生 其二","author":"凌义渠","text":"翻借无穷意，酬兹有尽花。\n风归如乍却，日午看将斜。\n小谑藏机致，浓情失叹嗟。\n与君同忆得，有梦各幽遐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25570,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏至斋居诗","author":"凌义渠","text":"是月阳疑壮，群阴如渐萌。\n还持启闭理，以息阴阳争。\n同患占民事，退藏观我生。\n端居饶静笃，蔬食引虚明。\n欲下诸天影，时闻松柏声。\n苔痕随户掩，鹤梦与风清。\n讵止心魂寂，将无寒暑平。\n近瞻天咫尺，落落寸珠擎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25571,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"皇极殿成宴百官","author":"凌义渠","text":"天心如再朗，岂乐万方同。\n俭德垂深永，慈情及耋童。\n瑞分尧座膳，卑准夏王宫。\n听默辰居北，宣威日在东。\n欣知早敛福，不觉叹成功。\n蓄荩诚靡极，明时许尽通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25572,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蜀客谈蜀事 其一","author":"凌义渠","text":"愁光点点逐妖开，敛魄徵魂遍九垓。\n槌尽玉楼天帝醉，一帆慈影赵洲来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25573,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蜀客谈蜀事 其二","author":"凌义渠","text":"孤人子父寡人妻，帐下歌声杂鼓鼙。\n鬼妾那堪同鬼马，风前犹得暂悲嘶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25574,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蜀客谈蜀事 其三","author":"凌义渠","text":"锦伞红妆故自豪，战酣卸甲注唇膏。\n遥传此事堪图画，不向春笺问薛涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25575,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蜀客谈蜀事 其四","author":"凌义渠","text":"强拈纸笔转生猜，短发低垂恰覆腮。\n豆蔻梢头珍重意，凭郎验取女儿胎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25576,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蜀客谈蜀事 其五","author":"凌义渠","text":"潮痕滟滟绿生烟，山到嘉陵水到湔。\n锦色迷离遮不断，村村知近浴妃泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25577,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蜀客谈蜀事 其六","author":"凌义渠","text":"一话金风失彗芒，凭教士女洗戎装。\n蜀人休诉攀留苦，终古恩威照此方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25578,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠康贞元年丈","author":"凌义渠","text":"耕猎为生苦自持，忍将荣誉割亲慈。\n文从拙处留真性，体在閒中逗远思。\n灏气久知临户牖，仁风自此出櫩茨。\n何来多祉偏宜寿，迪吉维天不可私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25579,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"拟古怨诗 其一","author":"凌义渠","text":"引手得莲子，垂丝跃紫鳞。\n等閒连袂出，何处不如人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25580,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"拟古怨诗 其二","author":"凌义渠","text":"碧桃天上种，幻作金钱花。\n却羡沾恩易，房房映日斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25581,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"拟古怨诗 其三","author":"凌义渠","text":"天然一静女，随例斗长蛾。\n那必人言好，蛾眉洵自多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25582,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"拟古怨诗 其四","author":"凌义渠","text":"莫嫌青梅涩，回味芬且甘。\n君自爱荔枝，飞骑填海南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25583,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"容城早雨","author":"凌义渠","text":"气象乍氤氲，微茫晓未分。\n层云俄水起，远嶂觉雷殷。\n草影沾将湿，蝉声咽处闻。\n停车稍候霁，幽意在初昕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25584,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋月食时舟泊济上","author":"凌义渠","text":"敲铜救月迥含愁，舫泊依然古渡头。\n人意惜惜灯黯黯，可知今日是中秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25585,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贺马邑侯题留考满兼值太孺人初度荣封","author":"凌义渠","text":"春林漠漠草芊芊，绕膝板舆近几年。\n为母以慈能腹众，居官无碍类逃禅。\n遍沾醲味乡人酒，平挹虚怀弟子员。\n已觉自公多暇日，舞衣新试锦文鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25586,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晓发感怀","author":"凌义渠","text":"草草寝兴里，举头檐际看。\n无心申苦意，有梦各艰难。\n雾欲沿溪出，星留配月残。\n问余何所慕，脂辖未容安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25587,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阳谷店","author":"凌义渠","text":"行行墟落晚，倦若鸟投林。\n村酿难成醉，浮凉乍满襟。\n预愁千嶂沓，梦绕绿烟深。\n殊怪秋声早，为来飒飒音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25588,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"长安肆中有拥书甚富而秘不示人诗以异之","author":"凌义渠","text":"古香拂拂手摩挲，为惜牟珠剩几多。\n凭仗血诚通姓字，一编高拥意如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25589,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"㳟遇圣寿雪中朝贺 其一","author":"凌义渠","text":"禁钥沉沉听未终，惊翻初日夜光融。\n输成玉粒三千斛，制出琼绡十二宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25590,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"㳟遇圣寿雪中朝贺 其二","author":"凌义渠","text":"十月轻寒早赐貂，同云覆遍喜先饶。\n几回飞舞迎仙仗，渐近阶墀一半消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25591,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"㳟遇圣寿雪中朝贺 其三","author":"凌义渠","text":"凭将光相问瞿昙，缕缕添长日近南。\n解道六花能比寿，峨眉深处万年龛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25592,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"㳟遇圣寿雪中朝贺 其四","author":"凌义渠","text":"伫看朝晛即曈昽，万国传觞此日同。\n寸草春晖无限意，圣心偏在冱阴中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25593,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚宿尹村见新月","author":"凌义渠","text":"忆向长安别，还随此地亲。\n光从今日始，影若与年新。\n乍觉因春妩，非关对客颦。\n一般愁寂意，留伴未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25594,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梁原铺读沁水张侍御壁间诗","author":"凌义渠","text":"懒将旧恨话残宵，知有遗灵尚可招。\n偶尔题桥怀古意，墨波黯黯未全消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25595,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"人日过沙河县","author":"凌义渠","text":"县以沙为榜，迎风寸寸沙。\n归程轻似雁，驿使几逢花。\n往事碑能记，寒流日已斜。\n丛台知不远，拭眼照繁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25596,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"越州城外山水","author":"凌义渠","text":"爱说越中游，兹游谓未足。\n何缘登历遍，止从近郊瞩。\n有意发其光，接之以冥穆。\n到眼了无倪，浓淡不相属。\n径过寘莫问，关我神明俗。\n背客退而寻，魂情如再续。\n譬若涉异书，一字味徐触。\n髣髴共高士，无言容止肃。\n岂必际秋冬，有怀始伤独。\n颇悟晋人云，周玩不在目。\n岫势未全殊，湖光看旋洑。\n亭台饾其间，一一缀明淑。\n拟将西湖较，霜旦与晴旭。\n同异且莫分，永依山水福。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25597,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自邯郸之磁州 其一","author":"凌义渠","text":"风日朝来爽，山原四望通。\n有怀悲逝水，无语送飞鸿。\n公子侠游窟，佳人纨绮丛。\n参差那可问，一线枕痕中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25598,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自邯郸之磁州 其二","author":"凌义渠","text":"早觉神仙天，何言霸业销。\n台馀烟点点，嶂列翠迢迢。\n宿案谁能了，悲歌差足豪。\n载驰游子意，敢诉去程遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25599,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"茶池 其一","author":"凌义渠","text":"湖山叠若屏，偶作湖山长。\n以兹赠往来，尽日风泉想。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25600,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"茶池 其二","author":"凌义渠","text":"衔碑知有泪，勒颂已难铭。\n强觅茶中味，居然识典刑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25601,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"茶池 其三","author":"凌义渠","text":"莫诧溪头涩，烟峦处处新。\n春风吹不尽，时遇采茶人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25602,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西陵韩城驿不寐 其一","author":"凌义渠","text":"几年灯火傍禅栖，才识桃源路已迷。\n血咯涎枯何所恨，声声聊学子规啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25603,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西陵韩城驿不寐 其二","author":"凌义渠","text":"迢迢村漏夜如何，梦到崎岖听乍讹。\n莫负寒鸡声第一，好教人羡鲫鱼多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25604,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"使竣还里发自蕲上","author":"凌义渠","text":"步步流泉引径斜，竹篱深映两三花。\n暖当蔬甲浓熏麝，烟薄枝头翠作衙。\n已觉乡心从此整，为怜春事几分赊。\n驱车那惜冲风雨，记得归鞭旋及瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25605,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黄梅苦雨","author":"凌义渠","text":"未觉风心善，阴晴候屡猜。\n山山埋照尽，树树抹云来。\n拚睡唯欹枕，拈香净宿埃。\n可知春已老，愁说到黄梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25606,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"皖城署中卧病","author":"凌义渠","text":"剪春风雨何豪遒，虫鸟尽日声喧啾。\n眼前怪物纷如蛔，或据其胸馆其后。\n天用疾厄为予寿，愧我苦吟成细瘦。\n嗟哉有命蝎为宫，臂股跧弯半幅中，颓然笑忆鸡栖翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25607,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望九华得缘字","author":"凌义渠","text":"色类纷难极，峰峰势蜿蜒。\n名从初地识，景自昔人笺。\n一抹清空气，无边华鬘天。\n嗟予行役倦，与订异时缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25608,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三月三日陵阳雨行","author":"凌义渠","text":"最怜春易暮，宿雨可能收。\n装薄寒犹在，烟轻绿遍浮。\n仆夫敢告倦，孤意自难留。\n望望乡关近，翻成历乱愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25609,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨泊雉城北渚","author":"凌义渠","text":"亦复迎烟泊，寒塘雨漫流。\n绿澄孤舫内，蝉咽五更头。\n对影悄成独，兼风飒若秋。\n丝丝遮不住，所得是浓愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25610,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汎画溪","author":"凌义渠","text":"短棹徐相引，沿洄听所寻。\n山馀藏露态，云幻有无心。\n细树低萦拂，平湾挹静深。\n怅然增兴绪，那问暮烟沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25611,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"无题","author":"凌义渠","text":"托意深深未敢言，回灯乍复忆消魂。\n远山近莫浮眉色，莲子初开隐笑痕。\n可代忘忧书满幅，避人私语月当门。\n孤情恰共兰心婉，欹笔凝思坐小轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25612,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂感 其一","author":"凌义渠","text":"何处相关觉可怜，眉痕依约晓灯前。\n早知妾命轻于叶，便入欢场也黯然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25613,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杂感 其二","author":"凌义渠","text":"翻因憔悴识容姿，病到披离好自持。\n欲订同心愁决绝，花开风里不多时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25614,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柳枝词 其一","author":"凌义渠","text":"一枝低趁却沾尘，不耐封姨作色嗔。\n好把愁丝收拾尽，章台容易逐他人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25615,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柳枝词 其二","author":"凌义渠","text":"几度更衣未忍辞，回眸那敢说恩私。\n乍思怜母还怜婿，背立无言独忖时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25616,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再同逸卿小集","author":"凌义渠","text":"及尔徘徊久，閒云似此心。\n预闻愁折柳，何可听鸣砧。\n拥髻神先悴，迟杯意共愔。\n所嗟霜露晚，珍重托秋深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25617,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初寒学为险句 其一","author":"凌义渠","text":"落落自朝昏，残阳逗远村。\n百虫早缄口，萤翅尚游魂。\n虚室添幽响，荒畬杂烧痕。\n石栏蕉半折，掀顿也频烦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25618,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初寒学为险句 其二","author":"凌义渠","text":"树瘦麻姑面，花癞戚姬身。\n有望皆髡顶，无方辟藓尘。\n鬼车鸣类哭，饥隼怒而蹲。\n咄咄将何许，垂头但饮醇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25619,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"灯市歌 其一","author":"凌义渠","text":"眼迷真赝底相蒙，傍午喧阗僦几丛。\n断竹焦桐随意识，镂脂画卵总输工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25620,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"灯市歌 其二","author":"凌义渠","text":"双扉昼键寂无悰，缓辔邀群信所从。\n免得归来添惋惜，唐碑晋帖可曾逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25621,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"灯市歌 其三","author":"凌义渠","text":"南妆强学黛重描，月下逢迎手并招。\n夜色天街澄似水，低头早过第三桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25622,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"灯市歌 其四","author":"凌义渠","text":"翻得升平调若何，烛香影里醉婆娑。\n任教百戏随宜闹，也遣春宵点缀多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25623,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南还舆中有作","author":"凌义渠","text":"不免驰驱苦，恬心与徜徉。\n尘因雨后减，日似客程忙。\n早映红参白，新条绿渐苍。\n常嫌睡欠足，未拟梦家乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25624,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"芳兰怨 其一","author":"凌义渠","text":"合欢明月讵须论，梦入湘沅乍返魂。\n无可篆心香一点，将何寄远泪重痕。\n早嫌腕弱宁辞拙，为怯风多许护存。\n掷向道傍薪共束，衔恩未敢冒称恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":25625,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]