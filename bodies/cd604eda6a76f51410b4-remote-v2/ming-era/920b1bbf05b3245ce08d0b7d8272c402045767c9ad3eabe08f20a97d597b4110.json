[{"title":"朴庵先生何公哀挽八章 其七","author":"程敏政","text":"曾受清朝御史封，华颠乌帽见真容。\n坟前更竖苍崖石，待取鸾书下九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47540,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朴庵先生何公哀挽八章 其八","author":"程敏政","text":"敕葬恩深动一时，松楸长系百年思。\n几筵况有奎文在，不用人歌薤露诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47541,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送庄孔旸年兄赴南京吏部郎中","author":"程敏政","text":"北来南去太匆匆，出处关时道未穷。\n林下有诗长教我，朝行无力为留公。\n韦斋吏署遥相踵，茂叔郎衔亦偶同。\n一雨洗尘青更好，定山才隔大江东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47542,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"桐隐为龚凤赋","author":"程敏政","text":"曾向吴门识大龚，喜君继隐托孤桐。\n荐书那复干知己，篆刻争誇似乃翁。\n竹院隔邻秋兴足，葑溪当径午尘空。\n君王旧有招贤操，正在南薰几曲中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47543,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"故礼部侍郎东嘉章公哀挽","author":"程敏政","text":"早参仪部识人龙，长荷先生降礼容。\n林下黄花方采采，墓前芳草忽茸茸。\n生荣有客同三省，死谏何人犯九重。\n千载怀贤忧国意，临风谁说涕无从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47544,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乔烈妇","author":"程敏政","text":"侍郎家范肃于霜，义动幽闺耻未亡。\n身绝素帏风黯惨，魂随丹旐日苍凉。\n祠前岁晚松逾劲，陇上春来草亦香。\n太史为书佳传在，千年留激懦夫肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47545,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"许由弃瓢图为廷殷侄题","author":"程敏政","text":"心寂何妨响万瓢，弃心生处胜狂涛。\n耳尘暂灭心尘起，却恐先生见未高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47546,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游锦衣章千户彦广园亭 其一","author":"程敏政","text":"雨后园亭秀逼人，偶来忘却宦游身。\n竹林气爽宁知暑，槐幄阴浓不受尘。\n酒发旧醅春滟滟，果尝新摘露津津。\n晚凉无限濠梁兴，独瞰芳塘数巨鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47547,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游锦衣章千户彦广园亭 其二","author":"程敏政","text":"抗尘松柏翠为亭，夹路蔷薇锦作屏。\n盘谷人家兼绂冕，辋川风物中丹青。\n诗囊泻处真谁壮，屐齿归时亦自馨。\n地主分花频订约，尽开荒圃候园丁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47548,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题大理王卿墨竹","author":"程敏政","text":"断缣一幅潇湘秋，笔趣彷佛文湖州。\n坐觉清风满人耳，洒然六月登江楼。\n主人重是王子猷，琅玕直节非时流。\n岁寒长共此君约，红紫纷纷何所求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47549,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李宗仁太守赴延安","author":"程敏政","text":"麟符分部岁华多，汉吏谁优政事科。\n直北朝廷瞻紫极，迤西封域近黄河。\n忧民屡听芝泥诏，乐土终传麦秀歌。\n珍重范韩勋业地，旧题崖石待重磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47550,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送卢文渊进士赴兖州推官","author":"程敏政","text":"黄甲才人领郡刑，由来钦恤重虞廷。\n薰风拂棹催登路，甘雨随车待过厅。\n万卷读来需法令，一方行日按图经。\n他时不负功名地，咫尺尼山入望青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47551,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵题竹鹤老人画","author":"程敏政","text":"林间二客妙无语，溪上一航随所之。\n江山偶尔兴不浅，谁说丹青老未奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47552,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"行台春意 其一","author":"程敏政","text":"年年新竹破苍苔，清拂江南旧柏台。\n不道停云高兴发，却从江北寄春来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47553,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"行台春意 其二","author":"程敏政","text":"纷纷红绿委黄尘，入眼琅玕秀逼人。\n劲操不随霜雪改，行台长占四时春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47554,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"行台春意 其三","author":"程敏政","text":"风前无数翠鸾翔，粉箨初翻细细香。\n公暇留题诗满幅，后人应比召公棠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47555,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"行台春意 其四","author":"程敏政","text":"春雷殷殷动江村，头角峥嵘遍石根。\n回首一湾溪上路，为君归思绕篁墩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47556,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠工部祝惟贞员外三吴治水还朝","author":"程敏政","text":"几年人议白茅塘，此日功归粉署郎。\n来往共誇新水利，疏通谁识旧河防。\n舜廷取次看行赏，吴地从今不奏荒。\n底用勒铭江畔石，东南遗老颂声长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47557,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西园作假山成约诸僚友小酌","author":"程敏政","text":"三年不见青山面，百计荒园小作山。\n新竹乱栽浑飒爽，秀峰高垛亦孱颜。\n谁家景出丹青上，终日身当紫翠间。\n等是太平樗散吏，一尊相约共娱閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47558,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"慕萱","author":"程敏政","text":"阶前五月萱花吐，日日见花如见母。\n对花不觉双泪垂，安得花前彩衣舞。\n人言种花忧可忘，孝子之忧江水长。\n花残却有再开日，暮雨萧萧空北堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47559,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"双鹤图为汪东曙题","author":"程敏政","text":"长风划然起林末，远近岚光翠如泼。\n虬髯倒捲怒涛翻，谷应川鸣海天阔。\n双双忽见青田君，振翮一声高彻云。\n溯风拟先鸿鹄举，争食宁甘鸡鹜群。\n手抚玄裳莫飞去，入眼分明有奇趣。\n丹青定自薛公传，题品惭非少陵句。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47560,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"终慕","author":"程敏政","text":"邢侯昔总海上军，将星一夕沉秋云。\n名郎克肖武且文，陟岵之念忘朝曛。\n幕府新开向西浙，喜乘楼船旧旌节。\n举目愁登阅武堂，寄治僧房寸心结。\n海波东逝无回川，嗣侯之孝人争怜。\n移却忠勋报明主，听取人歌终慕篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47561,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"维则轩","author":"程敏政","text":"寒日下乔木，回风动前轩。\n忆当亲在时，于兹奉寒暄。\n一朝事变作，白玉埋荒园。\n墓庐忍栖息，三回见正元。\n瀼瀼春露寒，凛凛秋霜繁。\n伤哉罔极恩，恨不同九原。\n归来过庭处，阶草青更蕃。\n载诵下武篇，感激思圣言。\n高楣揭华榜，求仁示南辕。\n勖尔子若孙，永矢当勿谖。\n云山高崒嵂，涧水鸣潺湲。\n相望不可即，泪下空澜翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47562,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽王端之","author":"程敏政","text":"君来古歙曾过我，寒日松梅话小轩。\n我到钱塘还访子，暖风花竹宴名园。\n笑谈追想如三宿，魂梦那知隔九原。\n哀些慰君君莫恨，紫霄雏凤待高鶱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47563,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清明拜扫远祖兵马","author":"程敏政","text":"亭皋东半匝松杉，百世英灵此秘缄。\n古迹未亡知县突，坚珉犹刻领军衔。\n司尊泻露浇坟土，殉剑飞虹贯石岩。\n支下闻孙今白首，亢宗无力愧朝衫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47564,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"永思为夏璋赋","author":"程敏政","text":"亲恩诚罔极，子孝在终慕。\n乾乾奉豆登，戚戚感霜露。\n烱然一寸心，万古如旦暮。\n悖德者谁子，上帝均所赋。\n多君揭华扁，常目若大寤。\n田渚督耕渔，川陆市泉布。\n时时见请益，往往行却顾。\n此心亦何心，宁以势迫故。\n卓哉紫阳翁，美此歙州路。\n民生多秀良，子得固有素。\n敬身则天民，保族谨王度。\n庶焉副所思，芳声踵前步。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47565,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"文灿宪长亲家将赴任广东病中无由往拜书此奉别","author":"程敏政","text":"碧山红叶路参差，宪节行当九月时。\n五岭使轺萦宦辙，一方民瘼重监司。\n官清岂解持端砚，主圣无烦贡荔枝。\n多病不堪临远别，浮云空系故人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47566,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"汪敦善以詹簿弟春草图索诗强赋一绝不忍复观也","author":"程敏政","text":"满地菲菲绿涨春，多情长践落花茵。\n谢家风物依然在，不见临池染翰人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47567,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望云思亲图","author":"程敏政","text":"朝看云出壑，暮见云归山。\n庭闱怅何许，人子伤朱颜。\n当年绕亲舍，千里念行役。\n今兹绕亲茔，三时泪沾臆。\n里儒为作记，良工绘新图。\n虽知一念性，十室惭非夫。\n夷之亦何人，亚圣特相勉。\n老我宁失言，珍重望云扁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47568,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"文夫还婺源","author":"程敏政","text":"多病劬书感二毛，喜渠同志为书劳。\n聊将简册酬斯世，一任高贤笑我曹。\n谱恊欧苏先绣梓，文徵殷夏几挥毫。\n山堂与订重来约，莫待西风入缊袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47569,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"积庆堂","author":"程敏政","text":"总说堂名太腐生，几家不愧此堂名。\n心田垦熟收三倍，义垒功深筑九成。\n揭日片言垂训足，履霜千古戒人明。\n吟场莫恨悭诗料，满耳乡评即颂声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47570,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪林为岩镇汪道隆赋","author":"程敏政","text":"夜下三尺雪，晓起惊尘空。\n万木森玉立，平原失西东。\n有客来骋望，如在琼田中。\n名园渺何许，飘萧竞春红。\n感之思欲飞，浩浩凌天风。\n何当拾瑶草，挈我苍髯翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47571,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"约黄司训汝彝","author":"程敏政","text":"数茎白发感流年，三秀灵芝在目前。\n何地与君堪一语，云岩高处绝尘缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47572,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"画菖蒲为汪进士乃尊赋","author":"程敏政","text":"拳峰秀岋岋，清池下泠泠。\n上有菖歜苗，瘦夺莓苔青。\n人言九节根，食之制颓龄。\n云谁染毫素，一登君子庭。\n琴书浥清气，几席来馀馨。\n重此百阴韭，更数千荚蓂。\n愿致安期生，相随住岩扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47573,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山臞 其一","author":"程敏政","text":"宦途长忆旧山薇，名迹无劳问是非。\n稽古例应吾辈瘠，匡时天遣福人肥。\n手栽紫朮堪供酒，体称青荷欲制衣。\n循吏嘱君三十载，却从遗老试松围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47574,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山臞 其二","author":"程敏政","text":"每于山泽爱儒仙，貌瘦心腴事果然。\n露饱枯肠尘外客，雪清吟骨匣中贤。\n羲经笔录三分注，膳谱囊封十字缠。\n他日浮丘堪问道，一箪容与鹤分田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47575,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄赠嘉兴丞","author":"程敏政","text":"苕霅频年水利多，移官新宠向嘉禾。\n庭当雪后双松在，路及春前一棹过。\n久说老成堪佐令，早祈丰稔罢催科。\n馆甥无限驰情处，赠别言萎奈老何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47576,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月桂图","author":"程敏政","text":"天风肃庭宇，玉鉴悬清秋。\n霏霏金粟香，湛湛金波流。\n郗林亦何常，志士方黑头。\n须知汉庭对，卓彼蟾宫游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47577,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"方侍御到京后寄题梅一绝并咏宪台梅三律勉和二篇 其一","author":"程敏政","text":"瘦骨冰容不耐寒，春花开落任悲欢。\n天留一树清溪上，正为山人喜静观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47578,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"方侍御到京后寄题梅一绝并咏宪台梅三律勉和二篇 其二","author":"程敏政","text":"胜地清空绝四邻，东皇先报一枝春。\n愔愔香气侵衣冷，的的铅华入镜匀。\n谁道广平非赋手，直应和靖是花神。\n山园亦有孤芳咏，恰借君为压卷人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47579,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿汊川宗人隆八十","author":"程敏政","text":"古颜真似涧松苍，玉立还同野鹤长。\n当代仲车从耳瞆，有时弘景亦瞳方。\n小宗不愧端明谱，晚境仍题慎德堂。\n指日诏书优大老，为君先致九霞觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47580,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王济秀才还建德祖居祁门","author":"程敏政","text":"草堂初识面，文采重王郎。\n新稻香炊白，疏桐叶坠黄。\n家声出江左，归梦绕池阳。\n莫起并州叹，祁山是故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47581,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送武康郭令","author":"程敏政","text":"武康贤令数时髦，坐理朱弦不种桃。\n六事屡当旌异选，三年何止簿书劳。\n缙绅有待推华毂，父老无烦拥画桡。\n竹马况闻先业在，看君名迹重铨曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47582,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿叶时显","author":"程敏政","text":"佳辰开宴水云居，白发朱颜七十初。\n太华峰头仙致藕，小焦山下客停车。\n梅花破玉输春早，蓂荚留青报岁除。\n延寿想君家法在，不劳重检卫生书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47583,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠陆彦功医士","author":"程敏政","text":"林杏飞香拥一廛，往来多羡好心田。\n谱分歙邑留先业，方自忠州得世传。\n医国有名曾赴召，活人无算不论钱。\n蹇予多病劳君久，为客题诗感昔年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47584,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"慎德堂","author":"程敏政","text":"孙君仁宾名，一室揭慎德。\n高堂伤沦亡，恨莫报罔极。\n时时瞻云思，往往泣对客。\n兹焉趋吾庐，启卷冀教墨。\n吾观咸宾言，子字适可摘。\n名居兼名身，外内两竭力。\n中心期无惭，百作讵有忒。\n爰同书诸绅，庶足示孝则。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47585,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄赠江西段大参同年","author":"程敏政","text":"皂盖风行绝点埃，湛恩近自日边来。\n除书驿报新薇省，夹路人迎旧柏台。\n南郡去思随处见，西山晴色望中开。\n九重侧席夔龙选，他日还应简异才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47586,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋林书屋为汪尚文赋","author":"程敏政","text":"四时佳致拥山房，却到西风趣更长。\n日谢故人来旧雨，夜便灯火入新凉。\n丹枫炫彩摇书几，金桂飘香点笔床。\n有待石林霜气肃，听君瑶瑟鼓清商。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47587,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"族人抑昏更名诗","author":"程敏政","text":"昏昏勇当抑，明明力当希。\n顾名一自勖，往哲思同归。\n逸士号无党，贤人称去非。\n相望富溪月，旅夕扬清辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47588,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿祁门宗彦用仁七十","author":"程敏政","text":"七十年华鬓未皤，寿觞行处客来多。\n五峰挺秀钟仙桂，一里常丰数善禾。\n世德正分忠壮谱，贤名宜入孝廉科。\n薰风为致长生曲，古调深惭击壤歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47589,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十月廿六日病以酒下木香散立愈","author":"程敏政","text":"何处堪寻却老方，等閒只有太和汤。\n调中即是仙丹母，行血真为圣药王。\n八节寒温都可禦，一时忧喜便相忘。\n莫将安乐窝中老，错比南朝达士狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47590,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"守约","author":"程敏政","text":"守书作书蟫，守金亦金虏。\n中有守约人，居然迈凡伍。\n三省孰知要，一俭更师古。\n华扁揭轩斋，箴规仰邹鲁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47591,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"方侍御受敕有诗见寄奉酬 其一","author":"程敏政","text":"早年文价重燕山，桓鲍心期伯仲间。\n出按远提乌府印，侍朝常肃紫宸班。\n龙墀奏绩衣冠拥，凤敕推封雨露颁。\n天子圣明先纳谏，济时勋业趁朱颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47592,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"方侍御受敕有诗见寄奉酬 其二","author":"程敏政","text":"玄英诗骨老云岩，衣钵分明付阿咸。\n写景尚随莲社约，观风何愧柏台衔。\n珠流丙夜光难定，鹤唳清秋韵不凡。\n健草如能慰衰朽，新篇无惜惠泥缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47593,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"友竹轩","author":"程敏政","text":"劲质亭亭迥不群，雨斑晴绿更多文。\n平生独立谁知己，一日相期得此君。\n盟好自甘同晚节，世情从薄似秋云。\n南山却望高沙路，已觉清风两地分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47594,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"棣萼联辉楼","author":"程敏政","text":"东阁有高楼，为问谁所营。\n人言蜃湖裔，家声重蚺城。\n环居数百指，中有三弟兄。\n相将若鼎峙，敦此手足情。\n朝读楼上书，埙篪日和鸣。\n夜宿楼下床，共被如姜生。\n坐令阋墙者，望望惭分荆。\n贤哉太史氏，华榱揭新名。\n斯人去已远，友义垂休贞。\n子孙袭遗矩，学祖龙门程。\n感彼棠棣花，春风益敷荣。\n我昔会宗谱，君家实同盟。\n荏苒十六年，老大嗟尘缨。\n蓉峰翠如染，星水涵空明。\n何时一登眺，揽衣坐前楹。\n对花说往事，载赋鸰原行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47595,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"远上寒山诗意图为汪镒题","author":"程敏政","text":"偶尔拈来语更工，景随天出爱唐风。\n白云红叶寒山句，早被人传入画中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47596,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题自写墨梅","author":"程敏政","text":"墨本流传四十秋，不堪重省少年游。\n山堂雪后摩挲处，赢得寒花照白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47597,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"侄垲本一名字诗","author":"程敏政","text":"小阮书来求字说，篁翁属汝在躬行。\n杂然为学圣所戒，洿处作基那得成。\n立志要同莘上尹，遗书休负洛中程。\n一缄不尽千里意，珍重先公手命名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47598,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游黄山约二三知旧","author":"程敏政","text":"三十六峰天下奇，廿年空尔卜游期。\n丹梯欲上扪参处，石罅还寻炼药池。\n诗刻定应谁赋好，山灵莫笑我来迟。\n一尊约与君同去，正值天空木落时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47599,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"将发值雨柬同游者","author":"程敏政","text":"戒严同作看山行，寒雨萧萧欲败盟。\n肯为移文回俗驾，直须钟鼓报新晴。\n千峰尽洗供开画，百涧争流待濯缨。\n奇兴不忧霜径险，促装先赋一诗成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47600,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"予与文远为黄山之游太守王公至古城相饯俾歌工二人侍行卫使又送鼓吹四人盖恐入山荒寒藉此以破幽寂也道中赋诗用备解嘲","author":"程敏政","text":"州将来从细柳屯，郡侯同饯古城村。\n鼓笳直遣充前导，丝竹分随有赏尊。\n勾曲胜游宁此过，轩辕遗迹到今存。\n半生少慰烟霞癖，王谢风流敢并论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47601,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"潭渡过黄孝子家","author":"程敏政","text":"路当溪口净无沙，正及前朝孝子家。\n石表旧阡存劫火，树围新庙锁烟霞。\n遗芳焯焯青编在，世事悠悠白日斜。\n来往客途惊岁晚，临风无计荐香茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":47602,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]