[{"title":"禽言四首 其一","author":"朱应辰","text":"泥滑滑，雨霏霏。\n雨深没行路，泥溅游子衣。\n浣衣无人勿复道，天寒路黑将安归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14767,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"禽言四首 其二","author":"朱应辰","text":"提胡卢，三三两两晴相呼。\n邻家有酒还能沽，明朝趁晴看花去，去年杏花知在无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14768,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"禽言四首 其三","author":"朱应辰","text":"婆饼焦，小麦黄熟长齐腰。\n刈麦作饼婆为喜，岂料南山日日雨。\n雨多麦损不可食，虽欲婆嗔那复得。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14769,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"禽言四首 其四","author":"朱应辰","text":"脱布裤，阴雨漫漫雨将暮。\n千声万声唤归妇，妇归忽生怒。\n妇去有归处。\n明日雨声干，匆匆还逐去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14770,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜","author":"朱应辰","text":"鼓角动谯楼，星河烂不收。\n梧桐双井月，砧杵一城秋。\n坐久销清夜，时危易白头。\n旧游零乱尽，归兴满南州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14771,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秀野轩诗","author":"徐达左","text":"春风十里翡翠屏，玉遮对峙蛾眉青。\n清泉白石杂花竹，天放画图钟地灵。\n高人开轩当此景，酌酒赋诗白日静。\n四檐风作翠涛声，八窗帘卷晴霞影。\n我亦托迹耕渔间，结屋读书湖上山。\n抱琴访子从兹始，布袜青鞋相往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14772,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"简虞胜伯","author":"阮孝思","text":"巷南巷北稀相见，奈彼村头泥泞何。\n入手酒杯嗟有限，经心春事苦无多。\n窗帘花影听莺语，明月箫声唤鹤驮。\n近报太湖新水阔，几时鼓枻共君过？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14773,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄许澜伯","author":"张扆","text":"水泊山栖分自甘，我留君去意何堪。\n几回雨雪三槎上，强半莺花五坞南。\n宰木空惭归远梦，扁舟犹忆载余酣。\n从今莫惜频相顾，灯火虚斋迟笑谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14774,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠张隐君（时隐君留张南村家）","author":"许观","text":"漫披华什咀余甘，欲报琼瑶愧不堪。\n一自返舟后，几回飞梦石湖南。\n莺花敢续迎春句，灯火空陪入夜酣。\n茶气拂帘清簟午，想应宾主正高谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14775,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题燕龙图楚江秋晓卷","author":"卞同","text":"初月澹微茫，猿啼楚江晓。\n恬风展波镜，千里泻弥渺。\n起语船上人，惊飞岸边鸟。\n行装乱填委，徒御争纷扰。\n川后弭安流，天吴沕深窈。\n阴霾敛遥翳，目断秋旻杳。\n响枻节歌长，翔帆逗风小。\n人生等萍寄，奔涉何时了。\n旅思协悲端，羁情重忧悄。\n忠沉不可见，水吊鸣寒筱。\n回首噭湘累，苍山乱云绕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14776,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"倪云林画","author":"卞同","text":"云开见山高，木落知风劲。\n亭下不逢人，斜阳淡秋影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14777,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄陈原性","author":"袁养福","text":"漫客狂游去不归，柳深江碧莫春时。\n十年客梦连宵雨，万里山行满箧诗。\n南浦草多离恨远，青楼人去雁来迟。\n何妨脱却风尘吏，日日街头醉似泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14778,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白雁","author":"顾文煜","text":"万里西风吹羽仪，独传霜翰向南飞。\n芦花映月迷清影，江水涵秋点素辉。\n锦瑟夜调冰作柱，玉关晓度雪沾衣。\n天涯兄弟离群久，皓首江湖犹未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14779,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次郑季明和袁子英纪梦韵二首 其一","author":"张著","text":"雉扇徐开动葆幢，绿裙净色剪湘江。\n珊瑚鸣佩还深院，鹦鹉忘言隔小窗。\n篆试沉香云作阵，杯传侍女玉成双。\n夜深回想蓬莱远，脉脉幽情不易降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14780,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次郑季明和袁子英纪梦韵二首 其二","author":"张著","text":"盈盈罗袜步轻移，紫绣衣裳杂凤缡。\n金碗香酥来玉液，冰盘鲜帟出银丝。\n晚行花底闲寻佩，夜坐灯前笑赌棋。\n最是酒醒春思寂，月华初上海棠枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14781,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次郑季亮避乱归城韵","author":"张著","text":"乱余城郭未全空，春事浑非旧日同。\n何处笙歌留粉黛，几家楼阁绚青红。\n幽花无主愁经眼，好鸟多情苦避弓。\n谁似归来耕谷口，荷锄细雨立东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14782,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋兴","author":"张著","text":"故园东望海西头，幽事长怀九月秋。\n竹几山明浑见画，槽床酒熟不知愁。\n霜寒粳稻肥黄蟹，水净芙蓉映白鸥。\n随分耕渔聊自适，无端垂老向延州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14783,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次陈敬德卜居河阳韵二首 其一","author":"张著","text":"渐老逢春可奈何，清狂不似旧时多。\n银瓶送酒青丝络，翠袖穿花白苎歌。\n故旧祇今成远别，从游何日重相过。\n河阳桃李余三月，应想茅堂傍涧阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14784,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次陈敬德卜居河阳韵二首 其二","author":"张著","text":"山窗曾记酒樽同，醉量豪于渴饮虹。\n江海遗愁空惜别，文章小技倦加工。\n云低雁宕家何在，花暗天台路不通。\n同是漂零归未得，又惊春尽馆娃宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14785,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早朝次陈同文韵","author":"陶振","text":"日华初转万年枝，蓬莱殿影迟。\n十万貔貅环紫禁，三千鹓鹭拜丹墀。\n河东客献扬雄赋，海外臣降陆贾词。\n要识中原新气象，黄河清浅已多时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14786,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题云林赠琛长老画","author":"陶振","text":"山中乔木已无多，留得残株在涧阿。\n诗绝岂能忘惠远，画工犹自忆祗陀。\n短篁风起秋先觉，灵石苔生雨乍过。\n我喜幽寻到禅寂，兴来同作《考槃》歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14787,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游泗州龟山寺","author":"陈璧","text":"龟山寺里访遗尘，铁佛苔封丈六身。\n追蠡有铭稽甲子，支祈无害念庚辰。\n渡淮独鸟斜斜日，送客飞花渺渺春。\n暂倚高风一回首，白云如海正愁人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14788,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题彦皋莼轩","author":"陈璧","text":"芙蓉花冷烟雨雨，鲤鱼风生紫莼渚。\n轩前秋容浩无主，江人倚楫烟中语。\n纤茎采香光漉漉，冰丝齐穿水晶绿。\n莼有羹，菰有米。\n彩衣捧寿阿母喜，平生宦情一杯水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14789,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玉仙谣（同杨孟载和阮孝思作）","author":"金文徵","text":"紫皇宫阙开中天，鸾书昼下邀群仙。\n神霝玉斫新蹄圆，蹀躞上送双婵娟。\n虹垂桥，云沓路。\n鞭敲风，驭腾雾。\n宝幢金节相后先，宛在银河影边渡。\n侍儿颜色春花明，照耀十二楼五城。\n飘飘宫徵相谐鸣，按歌齐唱《升天行》。\n《升天》未成曲，愁压巫山绿。\n朝朝暮暮湘水深，湘妃帝子徒劳心。\n东飞乌，西飞兔，海变桑田知几度？\n烛龙肯缓羲和辔，流光应向人间住。\n流光不住将奈何，坐令蛾黛秋霜多，手摩铜狄嗟蹉跎。\n人生谁似学仙好，翠扫鬓华长不老，下视寰垓入烟草。\n岧峣琼台梦，要眇丹霞姿，旁人可望不可追。\n佩环一落空中响，世上犹存千载思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14790,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中感怀","author":"史颐","text":"白日西飞水自东，乾坤浩浩恨何穷。\n无梯可觅姮娥药，有术难乘御寇风。\n啼声春雨里，青山万点酒杯中。\n王孙去后多芳草，肠断江南鹤发翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14791,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乱后送人归越","author":"朱升","text":"百战一身存，生还独有君。\n越山临海尽，吴地到江分。\n暮郭留晴霭，荒林翳夕曛。\n归途当岁晚，霜叶落纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14792,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送僧归南岳寺","author":"朱升","text":"山路花香上衲衣，云深南岳一僧归。\n尘生古像开寒殿，风度闲房掩夕扉。\n踏雨棕鞋苔藓滑，炊香野饭稻粱肥。\n禅余犹转千声偈，总有游人得见稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14793,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登岳阳楼","author":"包圣","text":"春城携伴共跻攀，极目风烟惨淡间。\n桂岭北来还有瘴，洞庭南上却无山。\n江通巴子三千里，云锁湘娥十二鬟。\n为语游人莫吹笛，潜龙渊在月波湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14794,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄侄公翰","author":"包圣","text":"弥旬苦局促，扰扰曷能止。\n鸣琴不成调，摊书聊复已。\n风定荷气清，日出茶烟紫。\n烦襟望一舒，开轩俟吾子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14795,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋与杨氏诸昆季泛舟鹅津","author":"周翼","text":"八月十五夜何其，鹅湖漾舟人未归。\n水生金浪兼天涌，云度青冥傍月飞。\n鸿雁沙寒微有影，芰荷秋冷不成衣。\n故人一去渺何许，黄鹤旧矶今是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14796,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"周履道征赋梧桐月","author":"周翼","text":"云卷清秋画角悲，梧桐满地月明时。\n斜穿翠叶通银井，化作金波落砚池。\n青女喜惊乌鹊梦，素娥偏惜凤皇枝。\n故人有约来何暮，独立云阶影渐移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14797,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过扬州","author":"王惟允","text":"华屋朱帘十万家，春风吹尽旧繁华。\n留连野色惟残蝶，应答江声有乱蛙。\n明月楼前沽美酒，蕃釐观里看琼花。\n我来谩忆曾游处，立尽斜阳一叹嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14798,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"琴剑歌送龙子高提学之闽","author":"张筹","text":"君不见王郎赠君龙泉之剑可三尺，彩缑消磨土花蚀。\n又不见桂子赠君神凤之琴无一弦，锦囊零落珠丝县。\n千年旧物连城璧，持至京都人未识。\n黄尘压埃冰塞川，几何不坠同瓦砾。\n龙君张其弦，淬其锷，凤忽有声龙露角。\n都人聚看走相传，齐瑟吴钩俱寂莫。\n昔君韬光谁见知，亦如琴剑尘土时。\n文章焕烂云锦机，脱颖不啻囊中锥。\n得官归来东海涯，二物无恙还相随。\n相随又下闽南路，我作长歌送君去。\n日暮三山不见云，文星一点天低处。\n五月初来花满城，榕阴驻马听啼莺。\n荔枝新劈江家绿，翠杓银罂莫暂停。\n白日易西匿，江水无回波。\n请君载舞王郎之剑，弹桂子之琴，歌我之歌。\n故人之情不我极，千里相思奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14799,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题美人春睡图","author":"张筹","text":"春睡才醒粉褪腮，香尘不动下阶来。\n画阑曾倚东风笑，向晚樱桃一半开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14800,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菌子诗追和杨廷秀韵","author":"史迁","text":"松花冈头雷雨急，坡陀流膏渍香汁。\n新泥日蒸气深入，穿苔破藓钉戢戢。\n如盖如芝万玉立，紫黄百余红间十。\n燕支微匀滑更湿，倾筐盛之行且拾。\n天随杞菊谩苦涩，采归芼之脱巾笠。\n桑鹅楮鸡皆不及，嫫姑天花当拱揖。\n盐豉作羹炊玉粒，先生饱饭踏晓日，更遣樵青行负笈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14801,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"简王原翚","author":"史迁","text":"东郭道人才大奇，置身散地任支离。\n阿谁或讶嵇康懒，此老真成济叔痴。\n白日放歌杯在手，青春作梦草生池。\n《辋川图》是传家谱，留得当年绝妙辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14802,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"漫兴四首 其一","author":"史迁","text":"贫居村坞长无事，谁复能过野老家。\n只有春风太情重，小桃深巷也开花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14803,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"漫兴四首 其二","author":"史迁","text":"休怪狂夫出处轻，孟郊还解以诗鸣。\n瓦瓶盛酒渔樵话，野草江花亦慰情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14804,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"漫兴四首 其三","author":"史迁","text":"瀼东烟树杜陵家，百尺深潭似浣花。\n布袖龙钟筇竹杖，也胜裘马在天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14805,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"漫兴四首 其四","author":"史迁","text":"好风轻雨趁轻雷，一洗山川罨画开。\n谁道衡门无过客，春深还有燕飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14806,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春六首 其一","author":"史迁","text":"东郭老人双鬓皤，春事告终知奈何。\n坐断小窗风正恶，送将几阵落花过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14807,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春六首 其二","author":"史迁","text":"先自花残故相恼，况值雨声催客愁。\n狂吟夜半睡不得，起待清晨梳白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14808,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春六首 其三","author":"史迁","text":"白头老子愁底事，正坐送春无一钱。\n偶被黄鹂故牵引，却向绿阴窗下眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14809,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春六首 其四","author":"史迁","text":"绿阴窗下春草碧，无数柳花吹近床。\n一双蝴蝶总无赖，飞到小阑还过墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14810,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春六首 其五","author":"史迁","text":"夕阳在山月已白，人生几何春复秋。\n华裛叠鼓岂无谓，莫怪西园清夜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14811,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春六首 其六","author":"史迁","text":"舞衣歌扇久寂寞，白雪时时梦里听。\n可怜春色别人去，能得花前几醉醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14812,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"高陵篇","author":"史迁","text":"炎刘昔丧乱，天实厌其德。\n桓桓孙豫州，起义申讨贼。\n降年曾不永，有子迈前烈。\n伯也英雄姿，一战基霸业。\n仲氏善谋断，鼎足跨扬越。\n神器固有归，付畀必豪杰。\n开国五十年，光明比先哲。\n赫赫乘鸿休，配天享褅。\n后王过荒淫，邦国用殄绝。\n园陵日隤圮，碑版亦摧缺。\n精爽犹神明，历载未磨灭。\n阴风或飞扬，古怪凭异物。\n尝闻父老言，往往荡舟出。\n当时珍玩器，尽数遭发掘。\n枯骸穴蝼蚁，尘沙任狼藉。\n至今吴城南，过者感叹息。\n世无贤方伯，伊谁命修殖。\n俯仰无百年，草木同朽卒。\n浩歌《高陵篇》，临风动悲泣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14813,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"姑苏钱塘怀古诗次韵六首 其一","author":"潘牧","text":"吴都富且艳，翠袖倚层台。\n歌吹凌春色，旌麾驻越来。\n繁华忽消歇，珠玉风中埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14814,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"姑苏钱塘怀古诗次韵六首 其二","author":"潘牧","text":"青山瘗宝剑，草偃千秋墓。\n金凫入夜飞，玉漏沉寒露。\n转盼陵谷迁，非徒铁垆步。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14815,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"姑苏钱塘怀古诗次韵六首 其三","author":"潘牧","text":"句践尝胆日，坚锐不谓无。\n一朝献西子，越兵成大呼。\n回睇长洲苑，千秋生碧芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14816,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"姑苏钱塘怀古诗次韵六首 其四","author":"潘牧","text":"青山翔凤皇，紫气绕吴关。\n玉泉湛若镜，灵鹭飞不还。\n重瞳在何许，泪洒莫能攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14817,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"姑苏钱塘怀古诗次韵六首 其五","author":"潘牧","text":"翠华竟南渡，遗民不复都。\n长城乃自坏，黄龙孰能屠。\n空令二宫泣，五国怨啼乌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14818,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"姑苏钱塘怀古诗次韵六首 其六","author":"潘牧","text":"尚父拥玉节，锦衣当昼行。\n辉光照闾里，千载英风生。\n至今牛斗下，还瞻紫气横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14819,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秀野轩诗 其一","author":"田耕","text":"门掩雨余苔，时因看竹开。\n客闲棋响罢，犬吠履声来。\n云冷埋琴荐，花繁近酒杯。\n高情与幽思，只是觅诗材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14820,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秀野轩诗 其一","author":"周衡","text":"背郭幽居如画里，断林春水绿回环。\n树连烟外啼猿寺，门对湖中过雨山。\n送客马嘶清荫去，钩帘鸟度乱花还。\n十年奔走风尘际，肯借凭阑一日闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14821,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秀野轩图","author":"瞿庄","text":"高士闲门日日开，远山如发水如苔。\n几时蜕却尘中鞅，布袜青鞋屡往来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14822,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题慧麓秋晴图","author":"瞿庄","text":"清游尝饮惠山泉，客里披图思惘然。\n尚忆信安祠外柳，萧条犹带汴堤烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14823,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"来鹤诗赠周玄初","author":"徐良言","text":"九天执法大玄卿，稽首焚香礼玉京。\n借得魏君骐骥到，恰如萧史凤鸾鸣。\n翩翩绕树香烟近，历历横江夜气清。\n欲向群中留一只，相将过海到蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14824,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"周玄初祷雨诗","author":"朱友谅","text":"道人鞭龙出潭底，黑云一片山头起。\n仰看红日不见光，黑龙头摇白龙尾。\n有时登坛步七星，一呼一吸成雷霆。\n白波翻空海水立，银河落地天瓢倾。\n去年京师祷雨雨辄至，大田小田总霶霈。\n定知夜半拜封事，自有精诚感天地。\n王公贵人知其贤，屈师阐教来琴川。\n今年旱魃又为虐，禾稼半死民熬煎。\n县官投词庶人跽，道人受命应且喜。\n笑书铁牌役海鬼，疾驱一百五十里。\n甘泉龙居万丈深，神符召集如飞矢。\n今朝雨脚来自南，半是吴江四桥水。\n顶山有龙名太白，口噀湖水成甘泽。\n道人驱龙喝龙出，五雷使者闲不得。\n龙兮龙兮，一噀日失色，金蛇电掣光千尺。\n再噀山气黑，飘风盘旋步沙砾。\n上天有宝不爱惜，喷下骊珠千万石。\n两龙行雨势未休，须臾潦水平田畴。\n疲农入城报沾足，道人一笑山云收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14825,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鹤林诗","author":"刘纲","text":"鹤林羽士金门客，旧辟丹房炼琼液。\n手栽千树虬髯松，坐对两山虎头石。\n白云昼静豁岩扉，湿翠满阶生紫芝。\n瑶琴自奏涧湍响，银河直挂瀑泉飞。\n鼎垆存火烹铅汞，灵药成苗几时种。\n皓鹤翎梳雪翳林，碧桃花落霞飘洞。\n琳宫累阙想蓬莱，叠嶂连峰紫翠堆。\n丹光穿壁如红日，应有仙人骑鹤来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14826,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送周焕文从唐伯刚之吴兴","author":"陈缉","text":"碧澜堂下即吴兴，十里芙蓉绕石城。\n山简归时应倒载，条侯醉后尚谈兵。\n蘋洲雨过秋闻雁，橘里春深晓候耕。\n事简好将樵唱曲，水精宫里坐吹笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14827,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜怀明本","author":"陈缉","text":"溪声淅沥起蒹葭，溪水潺潺漱白沙。\n大地星流还化石，小窗灯冷不成花。\n江淮峰火三千里，城郭人民八九家。\n避地欲寻张博望，月明沧海汎灵槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":14828,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]