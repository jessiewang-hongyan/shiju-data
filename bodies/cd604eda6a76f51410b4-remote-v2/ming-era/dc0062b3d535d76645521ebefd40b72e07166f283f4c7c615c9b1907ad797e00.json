[{"title":"挽萧以忠主事二首 其一","author":"苏仲","text":"十年黄甲两年官，怪的风流一转丸。\n旧物已将还造化，有生真不愧衣冠。\n百年事业得几许，一点烟云过眼看。\n万里蜀山何处是，旅魂归路北风寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽萧以忠主事二首 其二","author":"苏仲","text":"黍炊未熟功名事，尘世先遗梦奠悲。\n杨柳江寒灵榇远，雪山风急旅魂迟。\n箕裘赖有传家子，国事还看太史碑。\n欲奠临流一杯酒，不胜挥泪洒天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"镇抚司和题韵","author":"苏仲","text":"沈沈永夜一灯寒，归雁声嘹鼓角残。\n岁月尽随愁里过，风花都付梦中看。\n宁甘世上方头号，敢叹人前曲背难。\n不是圣恩天广大，孤臣万里敢求安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元宵","author":"苏仲","text":"春向融融景向鲜，物丰时泰是今年。\n煇煌灯月交相映，锦绣人家共斗妍。\n笛弄鼓挝花坞外，男歌女唱彩楼前。\n病夫欲写升平颂，付与唐虞击壤篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"完节堂妇姑两世俱同守志","author":"苏仲","text":"二十孀居度岁年，凄风寒雨夜灯前。\n甘心化石山头望，决志沈珠海底眠。\n教子果能成子志，养姑争得似姑贤。\n风声两世生门户，留与人间太史编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"效白乐天放言体二首 其一","author":"苏仲","text":"决要求名终是辱，直须致富必成殃。\n无缘到底应难合，有分元来不用忙。\n月到望期还自满，花逢春景自生香。\n安身却是谋生地，何必区区漫作狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"效白乐天放言体二首 其二","author":"苏仲","text":"富比周公安足羡，贫如颜氏亦何忧。\n千年老鹤终须尽，半日蜉蝣亦自休。\n只著虚心随付与，岂容逐物浪干求。\n有中无有无中有，有有无无水上沤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送毅夫还乡","author":"苏仲","text":"雪消云捲暖融融，曙色都门欲晓钟。\n绿酒半醮杨柳月，紫骝嘶断杏花风。\n春山富贵供诗兴，上国风流入梦中。\n回首乡园休眷恋，男儿湖海是豪雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"苏仲","text":"老年归梦恋溪山，恨逐浮名去不还。\n势利于人竟何有，风光过眼等皆闲。\n一心灰冷寒炉后，万事雪消春水间。\n除却酒杯无了日，不知身世在人寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁卯除夕二首 其一","author":"苏仲","text":"岁月无情万事慵，江山依旧此门风。\n人知薄分惟安分，官到穷时不送穷。\n仰面君亲无报答，强颜天壤敢从容。\n从头历数今年事，无日无忧过梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁卯除夕二首 其二","author":"苏仲","text":"饮罢屠苏兴未终，几人相对烛摇红。\n儿童听镜还同俗，老子焚香只省躬。\n客送桃符无好句，人逢新历喜春风。\n衣冠整顿明朝起，万寿君王拜舞中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李国瞻婿","author":"苏仲","text":"冰玉相辉宇宙间，师生翁婿古来难。\n晦翁日月吾何及，仲默规模子可攀。\n细阅封缄如见面，遣来欢伯可怡颜。\n寻常养就行天步，人买千金马首看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和洪尚书见寄谒诸葛庙韵二首 其一","author":"苏仲","text":"欲把君臣大义张，行藏都为正纲常。\n新祠落落祥云护，古柏阴阴夹道傍。\n汉鼎未归心不死，帝禅犹在义难忘。\n若将三国人才论，北斗孤高万古香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和洪尚书见寄谒诸葛庙韵二首 其二","author":"苏仲","text":"虎啸龙兴动战尘，草庐高卧便超群。\n决将壮志扶真主，誓把孤忠对鬼神。\n只手擎天开土宇，一方垂统正君臣。\n请看渭水堂堂阵，成败焉知不属人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拨闷二首 其一","author":"苏仲","text":"有酒不饮漫安排，有诗不作谓何哉。\n未知光景十年后，莫负春风两面开。\n大笑古今闲计较，听从天地敢疑猜。\n人生百计都归尽，骨有千金亦化灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拨闷二首 其二","author":"苏仲","text":"郁结填胸强自排，乐天如我有何哉。\n且将心地宽些著，把个眉头大展开。\n纵酒放歌寻我事，随风步月免人猜。\n英雄千古今何在，借问曾经几劫灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吊简斋兄","author":"苏仲","text":"白发垂眉见此翁，逼人和气蔼春风。\n天生长者遗斯世，我问儿童也爱公。\n七十有孙供眼底，百年无事卧山中。\n天堂果有君先得，敢把蜉蝣论始终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至天津有怀陈正郎学之先生","author":"苏仲","text":"曾忆横经泮水秋，碧霄先我得遨游。\n官同粉署君前辈，职守天津我继休。\n江阁诗情来渐远，河豚风味已全收。\n维舟此日城南道，还说当年事事优。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送同年何宗泽行人还乡","author":"苏仲","text":"勤劬灯火君同我，济会风云我共君。\n天上看花连日醉，人间偷眼赐衣新。\n青山济济荣归路，白发垂垂笑倚门。\n祝寿声中人起舞，鼓挝催唤酒杯频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和苏州林太守招降海寇韵二首 其一","author":"苏仲","text":"披拂春风散晓霜，从来仁者敢谁当。\n戢戈自我人人悦，买犊归田处处忙。\n增灶不劳虞诩计，鏖兵真笑纪明狂。\n大书刻石凭谁手，高揭乾坤镇此方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和苏州林太守招降海寇韵二首 其二","author":"苏仲","text":"仁作春风义作霜，滔天巨寇等閒当。\n也知疥癞终无害，何用兵戈更许忙。\n一纸飞书存大信，几人投死敢为狂。\n古为心战如公得，谁羡先锋取胜方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用陈石斋对酒韵寄故乡诸友","author":"苏仲","text":"我爱山中宅一区，半生风月笑谈馀。\n花间鸟到知人意，树底风来得我娱。\n历览江湖千载兴，懒拈灯火十年书。\n白头偶入鹓行里，争奈屠牛术已疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和韩昌黎贬潮州诗韵","author":"苏仲","text":"不根之论本无天，没溺聪明到几千。\n白首飞章元卫道，赤心扶世岂知年。\n文章远继轲尼后，声绩还居董贾前。\n素抱死生如芥蒂，是谁收骨道途边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和从弟叔诚见寄韵","author":"苏仲","text":"清白传家一脉同，雁行天远各西东。\n身居城市尘嚣境，心在烟霞隐逸宗。\n大器羡君超晚景，非才惭我出南宫。\n十年梦里犹如昨，青草湖边卜化工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲庵","author":"苏仲","text":"人间年事顿消除，风月山中爱此庐。\n花下每留邀客酒，窗前空有课儿书。\n门封碧藓韶光度，帘捲幽阶竹影疏。\n此外莫言无点事，寻僧时遣小行车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事","author":"苏仲","text":"景入朱明物候丰，杖藜扶我看花丛。\n暗窥黄雀依林蜢，啄破鹪鹩捲叶虫。\n萱草傍池花淹露，芰荷出水叶迎风。\n心闲便觉全无恙，况在乾坤浩荡中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿段处士","author":"苏仲","text":"传得人间不老方，朗吟风景是行藏。\n碧桃洞里寻幽迹，翠柳阴中卧石床。\n放鹤有时随杖屦，傍花无日不壶觞。\n崆峒莫访长生诀，静处须知自履常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕有怀先陇用陈大理韵","author":"苏仲","text":"钟鼓声喧彻九衢，洞箫吹月正愁予。\n千年风木无穷恨，两载松楸别故居。\n有酒不沾三尺土，逢人难寄九泉书。\n东风洒向天涯泪，罔极恩深报答疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈石斋饮酒韵","author":"苏仲","text":"狂夫不饮亦狂歌，饮到狂时可奈何。\n不管舞残沧海月，那知抖破白云蓑。\n胸中浩气高腾汉，笔下长才倒注河。\n我欲间公真事业，经纶都在酒杯多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张西溪先生之任南都","author":"苏仲","text":"元老归来鬓已星，天恩初下众心倾。\n南都地重风霜冷，柏府台高日月明。\n淮树两行连彩鹢，吴山千点拂游旌。\n曲江已启开元治，岭海他年共著名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓼花和韵","author":"苏仲","text":"挥毫曾记昔年游，每爱幽葩傍素秋。\n可是水仙遗骨骼，只随烟月伴沧洲。\n江山识面扁舟客，天地无心老钓裘。\n我亦分明湖海士，轻红留照木兰舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄谢周天统先生惠以银鱼","author":"苏仲","text":"冰肌雪骨且敷腴，水族中间可少渠。\n沧海未离珠母穴，寒潭曾共玉龙居。\n水晶宫里真堪荐，白璧盘中品绝殊。\n疏懒郎官兼老病，此君何事到吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过杨子山留饮适遇黄司谏送诗索和因继韵偶成","author":"苏仲","text":"遗经莫问我筌蹄，午梦惊回日已西。\n花下酒香愁易破，镜中人老事多迷。\n流风到我成痴汉，全德何人更木鸡。\n祇为宫卑容得懒，曲肱真可枕头栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄从侄景贤掌教","author":"苏仲","text":"天高风急雁声微，秋思撩人不可羁。\n酒盏异乡逢夜月，菊花怜我去年诗。\n惭无经济酬明主，浪把文章换布衣。\n慰我老怀贤辈少，眼中吾侄早声驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈石斋寻梅","author":"苏仲","text":"几个寒鸦点雪陂，先生驴背晓初时。\n相携野寺寻知己，索笑横塘续旧诗。\n得意每忘山远近，冲寒不怕酒醒迟。\n那知此夜前村月，瘦影香中更几枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庄定山先生最爱石洞老师南山花也北山花之句因继以诗予不揣亦和其韵续貂之愧所不辞焉","author":"苏仲","text":"骨瘦魂清雪月斜，溪梅花亦岭梅花。\n乾坤物我虽吴粤，气味风流自一家。\n公傍草堂歌白雪，我邀山月酌流霞。\n卧林更许收诗草，得拜门墙一日嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己巳春日试笔","author":"苏仲","text":"箫鼓声中岁律新，负疴高卧草为茵。\n床头稚子还扶我，屋角梅花似笑人。\n少接亲朋疏礼貌，久淹尘土晦稽神。\n年年病枕凭谁向，是药无功是命屯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄舍侄方武","author":"苏仲","text":"百年门户颇凋残，群从昌披到此难。\n扛鼎自怜吾力薄，登途须望汝舆闲。\n支援大厦千章木，消遣沈疴百炼丹。\n莫道出门容易事，老夫曾闭十年关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明有感","author":"苏仲","text":"朝霞隔坞桃夭占，暮雨平田细草侵。\n天外莺花三月景，岭南云树几年心。\n松栽半拱新坟白，石刻封苔古墓深。\n泪洒东风相借问，纸钱曾挂到山岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"途中书所见","author":"苏仲","text":"匹马轻鞭渡浅沙，乱鸣春鸟杂群鸦。\n鸱鸢喙下争残鼠，荆棘丛中啄腐蜗。\n向日小桃花放眼，笼烟荒草欲抽芽。\n无端老兴随春去，笑杀春风长野花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓吴中西察院有怀","author":"苏仲","text":"老年为客久侵寻，更到秋来恐不禁。\n官舍冷如僧舍冷，吴人音异粤人音。\n愁多岁月青天外，梦里江湖白发侵。\n烟雨一声南海雁，几人相问碧山岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺顾氏母七十有五","author":"苏仲","text":"人到稀年万一中，稀年富贵更奇逢。\n楼台明月笙歌闹，罗绮春风笑语丛。\n玉斝祝辞香缥缈，蟒衣趋拜烛摇红。\n花间不管韶光去，岁岁南山对酒缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和韵送陈子居被贬之任","author":"苏仲","text":"天作之数自有初，吾人安敢操乘除。\n怡然就道蔡元定，大笑出门陈子居。\n飘瓦打人真偶尔，藉茅持世岂嫌疏。\n大开双眼前头路，春酒春花送客车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57497,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏歌童并谢王都督","author":"苏仲","text":"绣帷携出玉芙蓉，半面春风笑向侬。\n绝世风流西子媚，自天妆点小乔同。\n歌声浏湸娇莺语，舞态轻翻落雁容。\n莫问娉婷是真否，酒□今夕十分浓。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57498,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和潘元博送行韵","author":"苏仲","text":"载酒翻劳饯晓行，天涯朋旧故乡情。\n笛声怕弄云间曲，山色愁看柳外旌。\n壮志可堪妻子计，归途宁为锦衣荣。\n寻常去住非无事，今古人间也善鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57499,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"种花","author":"苏仲","text":"偷得清閒半日光，薙荒除草接花忙。\n新怀蒋诩开幽景，老梦林逋逐暗香。\n雨过滑泥牢著屐，月临疏影近移床。\n东风许弄年光兴，拍掌儿歌可侑觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57500,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别从游诸生偶作","author":"苏仲","text":"蠹简终年屋数椽，可堪函丈拥诸贤。\n衣冠岁月虚游走，天地文章敢自专。\n何处炉锤功化妙，古今糟粕浪相传。\n人心万古羲皇易，不是杨雄敢议玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57501,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吊邹汝愚先生","author":"苏仲","text":"谁将公论洗乾坤，落落长沙见此人。\n肝胆信知如烈日，彼苍何意薄青春。\n天涯收骨孤儿幼，客路扶舆阿妇贫。\n了却平生无限事，风流都在盖棺晨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57502,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴明府之成都别驾","author":"苏仲","text":"濯濯长江万里清，淄尘难染素衣轻。\n孤琴月底辞单父，匹马花间又锦城。\n佐政龚黄还老练，献筹尧舜是峥嵘。\n乾坤内事多如许，暂向郫筒酒细倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57503,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭张文厚","author":"苏仲","text":"造化无私信有无，死生之事亦糊涂。\n儒林这样真男子，大块何堪此丈夫。\n流泪枕边孀妇老，伤心膝下凤儿孤。\n交游勿谓无知己，絮酒荒山我是乎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57504,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲中偶成","author":"苏仲","text":"掩耳人间道屈伸，眼前游赏满腔春。\n筋骸及老凭藜杖，口腹甘贫乐菜根。\n行处有花须纵酒，静时无地不看云。\n逍遥便是仙家诀，问我丹方此最真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57505,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答李士敬用见寄韵","author":"苏仲","text":"二十投交五十来，几回倾倒泻襟怀。\n先生独步端无及，我辈知人不是乖。\n奈把真龙惊俗眼，也曾操瑟献齐街。\n丈夫烈烈悬星斗，不是萤灯照草荄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57506,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻吴生景勤讣","author":"苏仲","text":"老眼门墙尽日看，衣冠如子亦须难。\n那知天地昂藏样，若个蜉蝣早暮间。\n夜雨几年灯火债，西风遗迹纸窗残。\n彭殇自古从天定，说与涟洳白首乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57507,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张公子省亲之南都","author":"苏仲","text":"昂昂匹马张公子，路入东风紫翠岑。\n椿府久悬南海梦，萱花应慰倚门心。\n两朝太仆声光远，千载传家世系深。\n戏彩到时还浪兴，秣陵风景纵君吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57508,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和柳子厚登柳州城楼诗韵","author":"苏仲","text":"意气淩空望八荒，不胜愁思寄沧茫。\n文章本拟追韩范，面目何曾识孔墙。\n一自失身从训注，难为倾海洗肝肠。\n平生罪悔都无及，徒把篇诗怨异乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57509,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中偶作","author":"苏仲","text":"遭际风云起海涯，赤心谋国已忘家。\n扣囊正欲扶公道，补衮无能敢自誇。\n病骨久淹三月里，衰颜今作几分加。\n驰驱未了平生愿，全仗通神药鼎嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57510,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和卢伯居佥宪督风诗韵","author":"苏仲","text":"紫猊香袅阅来封，倒泻人间锦绣胸。\n直到天机流出处，绝无人力巧为容。\n艰危顾盻斯文重，乡里情怀此日逢。\n绝唱如君何处得，低头叉手拜高风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57511,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和周天统韵","author":"苏仲","text":"春花秋月别经年，偶拜车尘便跃然。\n星斗仰观开老眼，酒杯无尽话前缘。\n长江滚出流新句，虚室生光照彩笺。\n诵到君辞难释手，是居王后是卢前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57512,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次陈推府偶成韵二首 其一","author":"苏仲","text":"谁将生计问陶朱，我恐陶朱术亦疏。\n五贼天生难剿克，一毫身外敢奔趋。\n山瓢雅可闲斟月，烟艇何妨日钓鱼。\n自谓身轻成晚计，故园秋菊共茱萸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57513,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次陈推府偶成韵二首 其二","author":"苏仲","text":"今古斯文共一家，如君丰度可人誇。\n弛张局里真无恙，活泼天机岂有涯。\n竹叶别留春意好，蒲帆高挂夕阳斜。\n相看欲了无穷话，何日同归理钓槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57514,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得书报从弟时际高科喜而成作","author":"苏仲","text":"粉窗湔手阅来书，夺锦如龙信不虚。\n得路已嗟先镊白，逢时应羡早纡朱。\n承恩愧我心何及，种德如君庆有馀。\n接武寄声同自出，万人争睹是传胪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57515,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈掌教留饮代简奉谢","author":"苏仲","text":"青州从事久不遇，岭表边炉岂偶开。\n邹鲁有声谁善继，雷陈交义我非才。\n篝灯夜雨斯文席，锦绣春风送客杯。\n老兴正浓禁不住，五更魂梦又飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57516,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒范文正公祠","author":"苏仲","text":"停骖道左谒公祠，读尽磨崖想旧时。\n终岁庙堂无驻足，百年功业竟西陲。\n事方诸葛人犹讶，世不商周我自知。\n千载汗青如日月，祇缘夷简半公私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57517,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]