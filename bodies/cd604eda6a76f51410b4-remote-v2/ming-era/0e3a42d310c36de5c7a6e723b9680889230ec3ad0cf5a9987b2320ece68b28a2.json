[{"title":"后芳素轩四首 其一","author":"王世贞","text":"夏阴无不可，饰我轩中容。\n枕簟渐相媚，琴书时自慵。\n萍间尺咫月，竹隙两三峰。\n更有会心处，招提来夕钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后芳素轩四首 其二","author":"王世贞","text":"剥啄都不应，饭余贪昼眠。\n卿仍卿礼法，我与我周旋。\n偶适鱼鸟性，渐谐花竹缘。\n挥毫得小语，不解唤诗篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后芳素轩四首 其三","author":"王世贞","text":"兴来呼蜡屐，去踏雨余山。\n恋此枪榆境，仍楗薜荔关。\n浮云时一憩，倦鸟复相还。\n觞咏信云美，犹然妨我闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后芳素轩四首 其四","author":"王世贞","text":"欲谋高枕路，聊引一编书。\n乍可为蝴蝶，那能老蠹鱼。\n竹阴侵径合，蕉影入窗疏。\n却笑遑遑者，何烦责宰予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为姚卞山题临云阁","author":"王世贞","text":"知君是姚合，小咏满菰城。\n飞阁千山表，流云四面生。\n时时润几席，往往卧檐楹。\n莫学通明吝，相为贮一鎗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"爱上人自天台还襄阳福严寺送之","author":"王世贞","text":"尔傍天台宿，能扬智顗风。\n襄阳好名刹，耆宿有安公。\n楚越浮踪并，人天慧眼空。\n莫将无住意，容易问庞翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"俞比部拿舟迹予过浒墅同陟慧山投诗见赠辄尔倚答","author":"王世贞","text":"第许同舟在，何论倾盖迟。\n久知饶节槩，况尔吐心期。\n水作弦中语，山为画里诗。\n莫疑深缱绻，眼底待看谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"颜廷愉执弟子礼过余而不饮酒得一律送之","author":"王世贞","text":"生无束修贽，愧尔号门人。\n卮酒不肯御，形神安得亲。\n衰输啖名客，病爱乞骸身。\n五彩行当就，扶摇抟九旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"唐子两司锡学前后八年矣迁教授岳州以行锡诸生碑之以志去思","author":"王世贞","text":"聊携杏坛席，去上洞庭船。\n碑洒阳城泪，官深夏禹年。\n名缘却贽重，诗为解颐传。\n一问君山酒，何如第二泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林司谕教授广信","author":"王世贞","text":"藉甚林夫子，移官与众同。\n乍新青雀舫，依旧素王宫。\n才吐牛刀割，文争斗剑雄。\n时偕柳常侍，一咏白蘋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太宰袁公抑之同访虎丘得二首 其一","author":"王世贞","text":"偶逢袁粲屧，重访王珣庐。\n并老偏余甚，长贫不子如。\n叨为启事客，终愧绝交书。\n搔首斜阳下，萧萧两鬓疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太宰袁公抑之同访虎丘得二首 其二","author":"王世贞","text":"栩栩同仙舫，遥遥指佛庐。\n寻常一醉地，三十五年余。\n和靖台频圮，生公石自如。\n人生几坚脆，罢酒更踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再呈袁公二首 其一","author":"王世贞","text":"一时同被命，两疏各祈归。\n白发宁论是，青山可见非。\n看君眠处稳，愧我战余肥。\n何物酬知己，倾筐有蕨薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再呈袁公二首 其二","author":"王世贞","text":"长者先投客，鲰生敢自禁。\n拂衣吾辈事，推毂古人心。\n何胤辞偏巧，樊英隐未深。\n三山名胜地，或谓可浮沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓从北门舟发入弇园即事","author":"王世贞","text":"小艇傍江城，紞紞过五更。\n朝光澹月色，人语杂鸡声。\n不寐神偏爽，无营思转清。\n松关一启钥，禅坐与经行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李本建乡进士以其兄本宁大参之状来请铭其母匡得五言一律赠之","author":"王世贞","text":"冲寒孝廉舫，来问议郎碑。\n密竹辉彤管，新文愧色丝。\n俱怜五凤曲，同作一乌悲。\n绝胜周侯母，唯余义庆知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得何仁仲远讯且以蜀笺索采芳洲新咏为作数语","author":"王世贞","text":"芳洲生杜若，楚畹滋幽兰。\n采摘不辞早，馨香虞渐阑。\n美人侑缣素，密意比琅玕。\n若语吴王径，千秋蝶梦残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送僧游五台","author":"王世贞","text":"见说中台北，长飞六月霜。\n诸天尽烦热，此地独清凉。\n处处金刚窟，人人妙吉祥。\n老夫在方内，高枕亦羲皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题摄山舍利塔","author":"王世贞","text":"昔我问阿育，驱神作道场。\n如何震旦国，重见铁轮王。\n变幻从僧语，依微尽佛光。\n那堪事势尽，千古但苍凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"千佛岩","author":"王世贞","text":"仲璋感先志，诸王贪夙因。\n雕锼惭伎俩，刊削减嶙峋。\n千佛本非佛，一身犹幻身。\n云门拈出后，黄面少精神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙潭驿即事","author":"王世贞","text":"欲寻龙起处，正值雨来时。\n天地陡然合，江山相斗奇。\n兴高那畏湿，心远任登危。\n呼得宜城酒，呻吟且咏诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明日谒孝陵步屧而下稍就肩舆抵观音门即事作","author":"王世贞","text":"不尽钟山紫，能令步屧便。\n涛声柏树杪，晓色桃花前。\n娇女怯上冢，贫家轻禁烟。\n后湖如练白，第少橛头船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观音阁诸公饯别袁抑之太宰","author":"王世贞","text":"万仞削不尽，千秋留至今。\n长江天地带，清梵海潮生。\n岂以皈依念，能销怅别心。\n扁舟夕阳外，巢许意何深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜小阁同陆公与绳宿奉呈一首","author":"王世贞","text":"寂尔对孤月，翛然余两翁。\n乍惊天眼阔，恍睹色身空。\n不饮从醒好，无言与悟同。\n由他暂时路，也是一家风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侍御荆使君邀登北固作 其一","author":"王世贞","text":"京口借名镇，兹游良壮哉。\n六朝天北顾，万古水西来。\n潮压金鳌小，云低铁瓮开。\n亦知饶感慨，吾岂大夫才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侍御荆使君邀登北固作 其二","author":"王世贞","text":"为挹三山紫，聊陪一马骢。\n峰奇向背日，江阔往来风。\n雨色将衣重，霜威付酒融。\n谁言识荆晚，不负白头翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同诸公游高坐寺登雨花台","author":"王世贞","text":"此地昔高坐，诸天尽雨花。\n我来当落日，万壑竞蒸霞。\n小供维摩饭，时呼阳羡茶。\n不须频竖义，睥睨有归鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与诸公过瓦官寺作食","author":"王世贞","text":"一径新兰若，千秋古佛场。\n晨钟梵纲肃，午饭茵陈香。\n游兴偶然洽，尘劳应暂偿。\n翻嫌二碑在，能益老僧忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曹子晋有狭邪之游以余一言而绝扁舟特造白下见谢壮其意留之十日乃去身心家国之感别自有之不以子晋也","author":"王世贞","text":"末路解绳迹，少年多侠游。\n生能学周处，吾岂厌曹丘。\n十日丹阳酒，三江白版舟。\n故园无限泪，黯淡不成收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉送大司徒王公入贺万寿","author":"王世贞","text":"嵩岳将传响，明河可问津。\n锦帆悬日月，朱履蹑星辰。\n陛下唐虞主，司农社稷臣。\n倘陈金鉴录，须及茧丝民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄生季文论诗有赠","author":"王世贞","text":"怜生初负笈，业已厌儒冠。\n莫谓成风易，须知和雪难。\n一吟头可白，九转灶方丹。\n但有千秋在，何烦世眼看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆成叔出新诗俊丽甚然多平康巷中语走笔戏赠且以为风","author":"王世贞","text":"烟月清溪里，风流白苎辞。\n玉台编后出，银字管中吹。\n六代才难尽，三山景尚奇。\n毋令小谢后，寂寞使人悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"齐王孙仲望邀游清凉寺因成一律兼简陆生","author":"王世贞","text":"淮桂偏招隐，齐门不爱竽。\n鹿裘行处是，龙种看来殊。\n并蹑东山屐，双倾从事壶。\n高斋足幽赏，携得士衡无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"友雅堂为省亭宗侯题 其一","author":"王世贞","text":"不以朱弦贵，悠然山水期。\n千秋余尚友，二雅乃吾师。\n夙有文堪会，都无俗可医。\n自怜非长者，辙迹废追随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"友雅堂为省亭宗侯题 其二","author":"王世贞","text":"大雅久不作，知君夙尚深。\n屏除阿堵物，清得刹那心。\n有地非金埒，无弦祗素琴。\n正平未牢落，北海晚知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭从子一鸣茂才","author":"王世贞","text":"竹林无小阮，老泪独潸然。\n贫与生相守，愁从死暂捐。\n肆多赊酒券，囊少卖文钱。\n哭逝人皆有，啼饥更可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王承父雨夜过我高斋贻诗颇致鸰原之感聊尔奉酬","author":"王世贞","text":"一片钟山雨，能令旅思惊。\n边鸿方唳影，谷鸟偶嘤鸣。\n已自乖兄弟，能无藉友生。\n相留小时住，收我泪纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄山人说仲故文毅公大宗伯石龙公后也投诗示余别去依此为赠","author":"王世贞","text":"司空通德里，宗伯右文朝。\n自尔毛仍彩，能令木转乔。\n虹为沧海钓，霞是赤城标。\n此日黄金错，投余愧报瑶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云间徐生故同年少司寇公之少子也挟其艺应试南都乞余诗赠之","author":"王世贞","text":"孺子南州彦，徐卿第几雏。\n家声仍雁塔，国艺向鸿都。\n西弄花堪摘，长干酒可沽。\n如过爽鸠署，能记履声无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿陈医箕仲父也","author":"王世贞","text":"家是朱陈里，名同秦越人。\n谈诗身外业，颂酒性中真。\n客种畲山杏，僮收泖水莼。\n有儿何必问，孺子岂长贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慰吴翁晋失利","author":"王世贞","text":"春官日讨论，本意欲还醇。\n文苑翻成厄，儒林未睹真。\n家声三礼旧，诗法五言新。\n莫以杨朱泪，轻沾建业尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马从甫别六年矣以诗投赠余诗转佳而复不第走笔慰之","author":"王世贞","text":"别汝六年强，居然荷芰裳。\n虬髯生自赤，鲸力句逾苍。\n纳履乌衣巷，呼舟朱雀桁。\n公孙无厌苦，垂老始贤良。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乞骸待命于长至不能行礼自嘲","author":"王世贞","text":"漫劳宫监诘，何病不朝天。\n奉寝生来懒，拈妆祗自怜。\n妒应无可妒，妍则几时妍。\n任有羊车梦，那从到枕边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"亡弟大事皆赖曹氏甥子念今来视我金陵无何告别垂泣送之 其一","author":"王世贞","text":"衰年无限泪，握手便纵横。\n玉折兄怜弟，珠联舅愧甥。\n欲教轻作别，除是学无生。\n一片秦淮月，还悬亚字城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"亡弟大事皆赖曹氏甥子念今来视我金陵无何告别垂泣送之 其二","author":"王世贞","text":"生怜石头水，大似渭阳波。\n谊以穷交重，诗从外氏多。\n酬恩唯有泪，当泣且为歌。\n亦解金陵好，如吾不住何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送故人汪禹乂之子尧卿谒宁国尹使君","author":"王世贞","text":"禹乂以穷死，寄悰风与骚。\n诸儿尽舒俨，孽子是枚皋。\n小赋不堪饱，薄游空自劳。\n非君贶金错，那得剪蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶得桃花坞而竹逾胜遂成一律","author":"王世贞","text":"不知何氏坞，花竹事仍偏。\n半岭绿于染，千村红欲然。\n任呼司马醉，翻得长官怜。\n咫尺渔人地，毋妨与世传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"于江头送别少司寇李公时公合抚楚弼刑之绩凡六年矣","author":"王世贞","text":"送君重报政，为我尽离觞。\n不竞薪从积，无名草更芳。\n豸冠三楚日，鹴署九秋霜。\n唯有联班者，沾衣惜雁行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同大司马吴公少宗伯李公饮桃花坞分韵得花字","author":"王世贞","text":"绮作王孙障，金为帝里家。\n何如韦曲地，只种武陵花。\n暝夺村村晓，晴蒸树树霞。\n明朝写团扇，桃叶未堪夸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再同二公登雨花台仍用花字","author":"王世贞","text":"高坐同支许，清言胜永嘉。\n忽秾平野色，犹似讲坛花。\n岸帻和风狎，移床返照斜。\n将何消酩酊，乞得老僧茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"莆田林茂才远哭太常亡弟访我金陵书行卷赠之","author":"王世贞","text":"闽天万里棹，来叩娄江浔。\n封树门人泪，生刍国士心。\n汝能存墓剑，吾自感人琴。\n为语酬知地，春风在上林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送廷尉王公听调还济宁","author":"王世贞","text":"吴公拜廷尉，治行汉臣钦。\n何自中山箧，能移慈母心。\n避言臣节苦，休沐主恩深。\n我亦栖栖者，聊为泽畔吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同乡杨太宰吾宗少廷尉路户部沈比部袁参军王司训会饮赵中贵园亭分韵得风字","author":"王世贞","text":"楼倚仍吾土，筵开傍帝宫。\n莺花二月半，虾菜一尊同。\n获侍关西震，叨为吴下蒙。\n吾家阿咸辈，大有竹林风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送路起部考绩北上","author":"王世贞","text":"龙文舒郁浡，鹤骨挺昂藏。\n使节冰霜劲，留垣日月长。\n仓曹人物志，国计度支郎。\n早晚山公启，高名满建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈季迪先辈失第归遣信相问赋此慰之","author":"王世贞","text":"夫君抱玉琴，宛尔千秋心。\n举世称复古，何人真赏音。\n从他和雪寡，且莫还山深。\n不见金陵子，翩翩赋上林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何司农静吾迁尚宝丞","author":"王世贞","text":"廿载鹓鸾侣，三朝骨鲠臣。\n赐环宽雨露，尚玺切星辰。\n虎口凭谁脱，羊肠肯自论。\n莫将黄发意，轻傍少年人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈博士擢贰汀府","author":"王世贞","text":"可知丁字水，能迓使君船。\n案牍成风手，功名半刺年。\n庭饶书带草，阁长广文毡。\n识得弦歌意，新蒲不作鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送喻少极参军迁长北中军幕","author":"王世贞","text":"而父龙为友，今君鹤在群。\n箕裘汉司马，礼乐晋中军。\n卫府芙蓉幕，吴钩菡萏文。\n一尊相送罢，惆怅隔江云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沈孺休感曹生仲行高谊乞余诗以报得五言二章与之 其一","author":"王世贞","text":"曹丘宁任侠，其意乃怜才。\n得士风尘里，恍然云雾开。\n浮沉不改诺，缓急岂论财。\n所以千秋墓，犹传羊角哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沈孺休感曹生仲行高谊乞余诗以报得五言二章与之 其二","author":"王世贞","text":"贫士易为德，穷途难报恩。\n将予片言赠，拟作千金论。\n逐客惊新诏，归人怯故园。\n唯应五噫客，偃蹇伯通门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马将军海盐之役以力战殉节特诏进世官二阶赐祠春秋飨祀弗绝其子总戎君建勋持重廉惠有大将风可谓世美矣因并及之","author":"王世贞","text":"一代马新息，英风飒至今。\n能将裹革事，了却据鞍心。\n乐府歌都护，孤儿备羽林。\n清源务持重，不爱肘间金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张仪部佥蜀宪","author":"王世贞","text":"未泊东吴棹，先占益部星。\n文章留白下，斧钺动青冥。\n好践刀州梦，还期剑阁铭。\n聊将竹枝曲，一与使君听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侍御黄仁甫以厥考新溪公之赠与母熊太孺人之封也扁其堂曰皆恩而不佞系之诗","author":"王世贞","text":"北堂多媚日，西垄有悲风。\n忽睹青鸾诰，双飞下紫宫。\n荣枯人理别，生死帝恩同。\n欲识移忠意，南床白简中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风阻瓜步辱李季宣先辈破浪过访与饮过扬州始别","author":"王世贞","text":"雪迭千寻浪，风横一叶舟。\n我惭羊叔子，君似郭遐周。\n久不逢泥饮，翻令爱石尤。\n欲将无赖意，相与问扬州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舒司马要饮天妃宫后桥亭水月佳甚畅而有作 其一","author":"王世贞","text":"淮水宽余浸，丹桥抱古亭。\n双虹横断续，一鹭立空。\n高论时相藉，轻觞不肯停。\n从他明月色，难掩使君星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舒司马要饮天妃宫后桥亭水月佳甚畅而有作 其二","author":"王世贞","text":"地主能延客，天妃亦让宫。\n广陂偏受月，积水自成风。\n感旧深杯后，忧时细语中。\n黑头勋业在，慎莫问藏弓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":41856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]