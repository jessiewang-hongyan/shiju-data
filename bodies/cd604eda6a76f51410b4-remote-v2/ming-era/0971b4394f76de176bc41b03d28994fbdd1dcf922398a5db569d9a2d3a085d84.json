[{"title":"大塘书屋为蒋世钦中书","author":"林光","text":"闲窗面面罩云烟，刚占人间小洞天。\n梦里陶然醒水月，眼中何处不鱼鸢。\n寻春晚履真堪步，拂袖青山是几年。\n料理平生端的意，小车何厌百花前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莲塘书屋为娄侍御","author":"林光","text":"城市尘氛亦厌无，碧云深树草堂孤。\n虚檐白月真堪看，临屋青山不用呼。\n午夜星辰瞻北极，深春桃李散南都。\n闲窗倘有寻归思，敢献吴江一箸鲈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"休隐轩","author":"林光","text":"休隐何妨额小轩，深垂白发看流年。\n婆娑不了闲滋味，云在青山水在渊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别张后府兼素","author":"林光","text":"土窗茅屋断知闻，十五年来谢世氛。\n云水至今还恋我，江湖何处更逢君。\n留连细剪方斋烛，潦倒愁看北冀云。\n再拜先生无可话，一杯留嚼野夫芹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自发潞河至郭县水浅舟胶聊成短什","author":"林光","text":"村醪何处许深倾，诗思瞢腾唤未醒。\n天际浮云终不定，眼边疏柳为谁青。\n漕渠浅浅流春绿，午枕频频聒运丁。\n万顷玻瓈一轮月，几时还我弄沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"叶青居","author":"林光","text":"卖韭见村童，推窗正倚篷。\n浮沙崩细浪，乱絮舞晴空。\n吏懒陶彭泽，诗催陆放翁。\n客怀吾欲语，吹断酒旗风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"土门晚泊","author":"林光","text":"归袂飘飘举，轻帆冉冉来。\n幽花封岸觜，白日照沙堆。\n旷志酬千古，虚怀贮一杯。\n平生双短鬓，何处洗尘埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河西务阻风三首 其一","author":"林光","text":"絮飞沙走几曾休，归棹狂南每顶头。\n自信江湖容我老，不知天意欲谁留。\n浮名未有毫毛盖，真乐刚寻十五秋。\n风土东吴应不恶，拟携妻子作仙游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河西务阻风三首 其二","author":"林光","text":"尘氛驰逐兴全休，短发从渠白满头。\n密网沙边犹自设，冥鸿天际去难留。\n狂云无计成时雨，归路真愁入晚秋。\n风伯如今谁敢讼，神情空傍斗边游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"河西务阻风三首 其三","author":"林光","text":"大块尘沙滚未休，篷窗痴坐任科头。\n酒杯恋我醒还醉，鸥鸟窥人去复留。\n镜里行藏周卦画，枕边熏业鲁春秋。\n五风十雨能如愿，傍柳寻花极胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登连窝","author":"林光","text":"俯仰春风礼法场，白衫还作野人装。\n终朝乱耳逢骄卒，尽日无诗负锦囊。\n万里乡关天自远，两行官柳日偏长。\n南风每每能相阻，歌枕篷窗也未忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"良店道中二首 其一","author":"林光","text":"堤柳千株拥道傍，南风拜舞不胜狂。\n篷窗辗转吾何语，一瓣闲烧铁面香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"良店道中二首 其二","author":"林光","text":"北往南来几许舟，风沙官柳日悠悠。\n不知一线漕渠水，多少行人白了头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"下邳","author":"林光","text":"篇诗曾记咏留侯，二十年来亦浪游。\n黄石老人今在否，北风吹我过邳州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忧旱","author":"林光","text":"半晌飘时雨，轰雷几夕昏。\n未酬苏旱意，也受一凉恩。\n散步看云脚，沈吟对麦孙。\n青青野莙荙，满径为谁繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四月二十八日狂风大作","author":"林光","text":"靡靡千舟废，呜呜万嗷号。\n人心空自骇，风伯也须劳。\n黑发从今变，黄埃逼汉高。\n闲窗谁氏子，歌枕梦魂劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将至德州短述二首 其一","author":"林光","text":"身在俱为乐，途穷亦不嗔。\n南风休滞我，堤柳尚迎人。\n零乱波翻玉，鬅鬙鬓欲银。\n乾雷无雨意，再拜祝江神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将至德州短述二首 其二","author":"林光","text":"画鹢来官舫，黄牛守野童。\n麦苗今渴雨，舟子莫呼风。\n书役夫催急，流亡室半空。\n平生忧国意，无语向山东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过固城","author":"林光","text":"宿雨含千柳，微凉变一川。\n官衙趋小吏，箫鼓闹鲜船。\n烟雾挥盈纸，风云思满天。\n呼童买南酒，不惜杖头钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"电火","author":"林光","text":"电火时惊目，雷车正辗空。\n敢祈连夜雨，且杀逆头风。\n麰麦枯将爇，山冈老欲童。\n天瓢留一滴，搔首向苍穹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别同官林汝惇","author":"林光","text":"今古奇逢尽偶逢，临岐欲话不曾终。\n残山剩水无人占，薄禄微官与子同。\n会见冰壶涵夜月，且教桃李醉春风。\n铁桥粗识罗浮路，真个期君着一筇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"下吕梁洪二首 其一","author":"林光","text":"闪闪奔流一线斜，横波沈石乱如牙。\n凭谁寄语操舟子，出入艰危莫浪誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"下吕梁洪二首 其二","author":"林光","text":"电走星驰亦骇人，点篙移柁捷如神。\n细看水手争长技，坐我安流自在身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"彭城汉高庙","author":"林光","text":"石榴花发庙门扃，偶读残碑识庙名。\n香火可能留汉祖，江山依旧是彭城。\n百年老兴还双履，千古争棋亦几枰。\n坐我槐阴新沐罢，凉风淡淡葛衣轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中小酌听宁永贞别驾说武夷","author":"林光","text":"耳边频送棹歌音，九曲真源我欲寻。\n先哲偶谈朱仲晦，深杯时泻密林檎。\n闲窗一枕天教睡，蓬岛诸峰梦亦深。\n不道凡身是仙骨，拜官还有谢官心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夹沟闸写怀","author":"林光","text":"金钱不博皂囊诗，杯饭何曾谢乞儿。\n京酒鲜催游子醉，年华争谓鬓毛丝。\n遥遥泰岳瞻应远，采采蒌蒿步更迟。\n万里亲庭天一角，夕阳翘首不胜思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题寄寄亭","author":"林光","text":"寄寄亭前物，来观寄寄身。\n草花应自得，云水任吾真。\n白月能留照，深杯别有春。\n乾坤俱旅寓，何处是天根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白泮河鲙鲤小酌","author":"林光","text":"万里东南客子归，南风无日不吹衣。\n白洋河内霜鳞美，老瓦盆中雪鲙飞。\n碧水黄沙晴可浴，大羹元酒愿休违。\n坐高淮北团团月，不把浮云怨落晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"扬州郡守招饮同李侍御观杂剧","author":"林光","text":"紫李黄瓜杂酒卮，南风葛袂正披披。\n浮生本亦如闲戏，卖械今真骇健儿。\n潦倒且拚文字饮，输赢不了古今棋。\n江山兴味元无际，太守殷勤索我诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨子湾偶赋","author":"林光","text":"杂剧喧阗谢耳边，晚风凉气正翛然。\n青茭插剑森依岸，白雨跳珠正满川。\n角角水鸡初叫处，腾腾杯酒未醒前。\n分明一段闲滋味，写入扬州短短篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游金山寺","author":"林光","text":"黄埃不改眼中秋，此日金山又繫舟。\n地拥长江吞巨海，天教绝景镇中流。\n烟云苾洌尝龙井，身世依稀在蜃楼。\n欲话无生真境界，钟声不动水光浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石门写怀","author":"林光","text":"晚风吹袂晚山前，久坐松根忆去年。\n本为微官轻去就，祇因慈母重留连。\n还思叔子趋涪日，细嚼渊明饮酒篇。\n落尽残花存故实，此生自断不须天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平轩二首 其一","author":"林光","text":"世路崎岖不作难，将迎未断是危艰。\n闲窗暗袖持衡手，只把灵台一镜看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平轩二首 其二","author":"林光","text":"高山休刬海休填，眼界平来恰自然。\n君若不拘形迹看，鸢鱼随处有天渊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别丰城王节之明府赴京","author":"林光","text":"红烛青樽不作疑，相逢相别更相期。\n专城小试栽花手，曾咏江门一老诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵州晚泊与舍弟克明小酌","author":"林光","text":"杯酒连船看水流，一轮明月照灵洲。\n德云不省今谁是，却忆东坡对子由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次峡山","author":"林光","text":"浮云不掩洞中天，入画人撑入画船。\n妻具黄鹂浇酒子，儿歌白雪向山巅。\n风流与可闲烧笋，自在尧夫只弄丸。\n何处合教尘梦醒，万株烟树枕头边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发浈阳峡","author":"林光","text":"科头篷底望江湾，日在东林月在山。\n风物满前谁是主，钓船撑上钓丝滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过英德","author":"林光","text":"英州城子大如斗，怪石边流作牛吼。\n石屏南山索品题，却笑东坡好游走。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿太平滩","author":"林光","text":"濛濛黑雾四低迷，缆繫黄茅日正西。\n何处思亲肠欲断，太平滩下鹧鸪啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观音山","author":"林光","text":"谁挥仙子剑，斫断过溪山。\n铁壁立千仞，丹房隐半闲。\n悬崖栖老鹘，滴乳蘸洄滩。\n万古留奇胜，丹青写亦难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上三坂滩","author":"林光","text":"舟子挐舟日叫号，北风吹面利如刀。\n欲知世路难还易，三坂滩头看着篙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五婆城","author":"林光","text":"五婆山下路，不见五婆游。\n只有边城水，常涵一镜秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清溪道中偶述","author":"林光","text":"天地君臣义莫逃，乘田委吏圣躬劳。\n江流对我何须急，山势迫人空自高。\n本乏长才供盛世，宁惭败絮拥绨袍。\n千周不厌囊中易，懒向西风步楚骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"弹子矶","author":"林光","text":"何须赤壁对黄州，只欠东坡一夜游。\n安得身轻如过鸟，随风飞上弹矶头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蒙?道中四首 其一","author":"林光","text":"十里五里寒滩，千山万山灌木。\n异香处处清流，谁别曹溪一掬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蒙?道中四首 其二","author":"林光","text":"滩恶石根齿齿，山深树映婆婆。\n短景寒霜十月，南船北上风多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蒙?道中四首 其三","author":"林光","text":"船头薄暮搔首，野烧不省何山。\n犬吠村舂乍急，林疏贩籴人还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蒙?道中四首 其四","author":"林光","text":"渔灯乍明乍灭，灌莽无际无边。\n识破曹溪水口，何疑虎榜山前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曲江怀相国","author":"林光","text":"高堂鹤发正如丝，家近洪州合请时。\n阅世公应知事早，栽花吾敢怨春迟。\n开元小试经纶手，韶石堪镌相国碑。\n留得榄山香一片，白云何处是仙祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"返照","author":"林光","text":"返照千林酒一卮，晚山刚对弄雏时。\n眼中触处成真乐，身外浮名总不知。\n元亮贫来还乞食，尧夫老去只游嬉。\n行云流水无穷意，老树精应不作疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"课儿","author":"林光","text":"摇落溪山欲暮时，軥辀声里雾迷迷。\n手中残卷堪延我，篷底烧灯旋课儿。\n自古箕裘谁不忝，浮生伎俩总如斯。\n私情未敢祈天运，笑咏柴桑觅栗诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平湖病目有感 其一","author":"林光","text":"言闻莱妇念俱灰，短札凭谁寄玉台。\n俯仰一身空自笑，昏花两眼几时开。\n偷閒总道微官好，向老何堪百病催。\n矮屋颓檐供熟睡，梦中慈母嘱归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平湖病目有感 其二","author":"林光","text":"呼儿扶病过墙隈，百种奇花我欲栽。\n老鹤亦知栖此地，蛰虫能不待春雷。\n回观不了天机妙，痴坐深存造化胎。\n外暗只疑天送老，金鎞休傍眼中来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠李野云","author":"林光","text":"官居偏繫海东遥，云水中人欲见招。\n千里君能来得得，一毡吾正坐寥寥。\n磁瓶未醉平湖酒，春雨初肥枸杞苗。\n却忆秋曹林待用，何时握手话良宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题雪梅","author":"林光","text":"阴云忽忽散溪头，偃仰寒梢露屈虬。\n却把幽香埋腊雪，独留清梦在罗浮。\n瘦筇又挂千峰月，秃笔初回两眼秋。\n仙鹤不来冬夜永，道人何处倚江楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平湖官署修补示督役者二首 其一","author":"林光","text":"持铎频回首，乘桴未有缘。\n痴儿愁露处，病叟愧多言。\n井浅泥浑水，墙低树隐檐。\n桄榔庵亦好，苏子乐南迁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平湖官署修补示督役者二首 其二","author":"林光","text":"风烟聊顾指，府檄下多时。\n蚊蚋攻三伏，鹪鹩借一枝。\n经严工土役，法恕鲁侯僖。\n著述非程子，龙门敢索基。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"露坐","author":"林光","text":"当湖来暑月，坐我小池边。\n欲酌樽无酒，闲吟思满天。\n晓荷初贴水，豇豆正垂烟。\n者树精应在，林梢奏一蝉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祷雨","author":"林光","text":"一滴天飘水，雷车仰疾驱。\n官僚虽有罪，赤子本无辜。\n忍见苗将槁，翻愁海亦枯。\n处高卑合听，万口正号呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉谢王判府惠米","author":"林光","text":"寻常爱诵后山诗，却笑贫官解忍饥。\n何处还逢赵郡使，亦留青眼照寒微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平湖病中思南归六首 其一","author":"林光","text":"青铜闲拂试，照见白须髭。\n浮世催人老，空山灭迹迟。\n云林归倦翮，霜雪悴寒枝。\n欲问商山路，疗饥有紫芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平湖病中思南归六首 其二","author":"林光","text":"掩卷千年不，沈吟不作疑。\n几看空袖手，未了着残棋。\n始复存消息，乾坤有合离。\n金鎞时括眼，莫受翳瑕欺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平湖病中思南归六首 其三","author":"林光","text":"冬卧愁襟薄，跏趺付一卢。\n难将衰病骨，更听夜啼乌。\n地暖思南海，情真有旧徒。\n飘然决归策，争只为莼鲈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平湖病中思南归六首 其四","author":"林光","text":"萧然茅屋下，云水自因依。\n短履穿松去，前村摘豆归。\n竹风恬隐几，山月静披衣。\n胡事驱驰久，尘氛有是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平湖病中思南归六首 其五","author":"林光","text":"不识栽花地，花时解恼人。\n空留看花眼，闲却故园春。\n坡老门冬酒，林宗折角巾。\n逍遥天壤内，吾亦任吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"平湖病中思南归六首 其六","author":"林光","text":"乐土思南海，归休道未穷。\n木绵衣亦暖，延寿酒偏浓。\n细雨扶留绿，熏风荔子红。\n儿孙依老母，欢笑一堂中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和沈别驾元节 其一","author":"林光","text":"采采红芳步更迟，睡酣尘榻掩荆扉。\n白头空有青山债，仰见飞鸿又北归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和沈别驾元节 其二","author":"林光","text":"树杪阴云看渐消，尚堪扶病到溪桥。\n道人未有伤春意，却仗苍龙玉一条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别袁分教","author":"林光","text":"病骨伶俜己莫支，送君扶病更江湄。\n湖山尚瞩他时目，云树偏催此日诗。\n聚笑一堂非偶事，相看两鬓各成丝。\n寒梅却有藏春意，雪里休疑折赠迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]