[{"title":"春游与谢都尉二首 其一","author":"张元凯","text":"柳市裁春服，花郊费酒钱。\n家贫不事事，行乐自年年。\n黄鸟催提榼，青衣佐刺船。\n未须投逆旅，芳草正堪眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28935,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春游与谢都尉二首 其二","author":"张元凯","text":"春草绿盈盈，飞英扑马轻。\n秦楼临曲水，谢客是宣城。\n柳弱丁年态，花娇子夜情。\n升平无汗马，都护听流莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28936,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"滕村访姜太史二首 其一","author":"张元凯","text":"逶迤桃李径，骀荡自阳春。\n祭酒门如水，江干雨似尘。\n苔生陶甓润，花发董帷新。\n何事登封日，犹閒礼乐臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28937,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"滕村访姜太史二首 其二","author":"张元凯","text":"玄亭耽寂寞，春雨碧氤氲。\n竹净轩窗色，兰滋几席芬。\n人伦郭有道，时命李将军。\n莫便营东墅，苍生孰舍君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28938,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"焦山旸公房二首 其一","author":"张元凯","text":"孤绝江之岛，栖迟隐矣身。\n迷花翚似绮，在藻鲚如银。\n高枕流云覆，清言白日沦。\n山中许玄度，支遁好为邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28939,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"焦山旸公房二首 其二","author":"张元凯","text":"山径缘苍渚，松寮掩翠微。\n断崖犹鹤碣，三诏尚渔矶。\n衣楚青荷叶，江明白板扉。\n临流当洗耳，鸥鹭不惊飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28940,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠朱别驾","author":"张元凯","text":"毖慎曾无匹，西京石建如。\n每移青玉案，恭展紫泥书。\n善政遗三辅，浮名谢二疏。\n通家能畜我，早晚侍安车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28941,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答许主簿","author":"张元凯","text":"马曹一主簿，七十尚栖迟。\n簪笔推先辈，悬车怅后期。\n倾交霍去病，仰给郑当时。\n年少余官薄，何然动尔思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28942,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"子夜","author":"张元凯","text":"花柳发韶年，妆成子夜妍。\n弄箫成艳曲，调瑟岂哀弦。\n翡翠巢金埒，鸳鸯扑锦缠。\n不将银烛灭，看取玉人怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28943,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"骝马","author":"张元凯","text":"紫骝元异种，剪拂倍光辉。\n但遣衔金勒，何知有铁衣。\n骄嘶承顾盼，踠足恋芳菲。\n笑杀征西骑，沙场百战归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28944,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴氏园寓二首 其一","author":"张元凯","text":"落落燕山路，劳劳楚客身。\n莫寻弹铗伴，且作灌园人。\n白眼谁堪傲，青樽自慰贫。\n桃源今负郭，借住岂缘秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28945,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴氏园寓二首 其二","author":"张元凯","text":"高柳拂清池，名花开自迟。\n染猩山踯躅，堆雪野酴醾。\n亭子留行李，园丁烹伏雌。\n再听浑不厌，隔水啭黄鹂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28946,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠钱功甫二首 其一","author":"张元凯","text":"潦倒经生业，凄凉国士心。\n愁容非酒病，憨态为书淫。\n再刖荆人璧，空悬燕市金。\n魏其宾客尽，怪尔独相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28947,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠钱功甫二首 其二","author":"张元凯","text":"薄宦唯吾拙，诸生尔独贫。\n他年文苑传，今日士林人。\n蚀字真如蠹，牵衣故作鹑。\n未须嗟濩落，晚贵最平津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28948,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归客","author":"张元凯","text":"寂寞丘园卧，休论战胜肥。\n云英流几席，山翠湿裳衣。\n梅福辞人役，桐江有客归。\n海鸥飞且止，相对已忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28949,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐园","author":"张元凯","text":"绿径依山转，朱楼抱水斜。\n台前五松树，云里九莲花。\n缥缈疑仙馆，玲珑象主家。\n金昌亭下路，标起赤城霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28950,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和子念移居四首 其一","author":"张元凯","text":"花雨燕泥香，绸缪牖户傍。\n昔移唯破砚，今徙益匡床。\n赋草多鹦鹉，衣囊少鹔鹴。\n自能贫任侠，孰谓醒而狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28951,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和子念移居四首 其二","author":"张元凯","text":"为爱蓬蒿宅，悠然绿水涯。\n长贫室悬磬，解笑女如花。\n剧孟初豪举，袁丝旧狭斜。\n十年浑借住，回首伯通家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28952,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和子念移居四首 其三","author":"张元凯","text":"长日罢樵苏，青林听鹧鸪。\n无诗不似舅，有论即潜夫。\n岸帻流云度，闭门芳草敷。\n敢劳迁幸舍，肯浪哭穷途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28953,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和子念移居四首 其四","author":"张元凯","text":"未以穷愁逼，因为时态怜。\n对人唯嗒尔，阅世更茫然。\n痴叔元非黠，狂奴固自贤。\n输吾弄杯勺，岁月只高眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28954,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东乡舟中即事二首 其一","author":"张元凯","text":"西风潮不上，河浅路逾赊。\n藻尽鱼依苇，陂荒雁啄麻。\n丹砂枫树叶，白雪木棉花。\n故国犹羁思，停舟问酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28955,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东乡舟中即事二首 其二","author":"张元凯","text":"日落停桡处，天寒穫稻时。\n樵苏机下妇，筐蟹泽中儿。\n马枥馀残豆，鸡埘傍短篱。\n黄花霜后在，不负野人卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28956,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除夕二首丙子 其一","author":"张元凯","text":"黑貂身作苦，白雪鬓何辞。\n怀璧匹夫罪，亡金同舍疑。\n世情颜远识，时事楚狂知。\n四十明朝是，无闻敢自嗤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28957,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"除夕二首丙子 其二","author":"张元凯","text":"不尽栖迟意，还深儿女情。\n隐何论大小，术已厌纵横。\n敝帚藏家重，寒灰置道轻。\n不须吹玉律，春傍酒杯生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28958,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"弇山园席上二首 其一","author":"张元凯","text":"倒着接䍦长，山游与葛彊。\n溪流如罨画，柳色自沧浪。\n卜夜芳卮溢，乘春藻翰香。\n子渊新著述，秖是颂明良。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28959,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"弇山园席上二首 其二","author":"张元凯","text":"安石营新墅，高阳总旧游。\n鸥边横短棹，花际涌高楼。\n河朔弥天饮，蓬壶缩地游。\n孟尝门下客，偏我黑貂裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28960,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"越溪庄二首 其一","author":"张元凯","text":"幽径花如浣，閒门柳更垂。\n山边韦氏曲，湖上习家池。\n会意禽鱼乐，忘言桃李枝。\n兰亭幸无恙，犹似右军时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28961,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"越溪庄二首 其二","author":"张元凯","text":"允矣幽人宅，悠然山水区。\n隔花深避世，负郭薄存租。\n园竹三千个，墙桑八百株。\n步兵恒信宿，暂止泣穷途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28962,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中逢顾山甫不得过访","author":"张元凯","text":"山人以山字，在世辞世諠。\n不改箪瓢乐，而为风雅言。\n庞公鹿门宅，陶令柴桑园。\n地僻杳难到，白云空飞翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28963,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"楞伽寺读书","author":"张元凯","text":"常住无人识，诸僧日与驩。\n并嫌留短发，何意恋微官。\n岁月穷千卷，行藏老一箪。\n草堂青嶂合，春雨响琅玕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28964,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同毛仲章玄墓山食樱桃","author":"张元凯","text":"湖水净如练，禅扉昼亦关。\n白云流绿竹，朱果照青山。\n鸟见无人下，僧闻有客还。\n筠笼满相送，何必禁园颁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28965,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"至日同傅吴令石湖觞咏二首 其一","author":"张元凯","text":"长至传杯永，阳舒坐啸开。\n飞霞同出寺，落日又登台。\n皂盖乘箕下，青山拥彗来。\n书云诸彦事，谁似大夫才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28966,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"至日同傅吴令石湖觞咏二首 其二","author":"张元凯","text":"问俗五湖傍，扁舟小队藏。\n忧心悬赤子，淑气动青阳。\n漪藻忘冰候，岩花迟岁芳。\n不缘仁政异，山水倍生光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28967,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送沈居士泛海礼补陀山二首 其一","author":"张元凯","text":"居士独乘桴，灵山绝世孤。\n风涛空里籁，岛屿镜中图。\n大海元清净，浮生任有无。\n明州阿育塔，光现照归途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28968,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送沈居士泛海礼补陀山二首 其二","author":"张元凯","text":"宝筏沧溟渡，皈依妙相前。\n海潮殷梵呗，花雨翳空烟。\n幡借鲛人织，灯因龙女传。\n此中闻最上，见在福无边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28969,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过张幼于曲水园因赠二首 其一","author":"张元凯","text":"家近馆娃宫，为园曲水通。\n忧时怜贾谊，治郡忆吴公。\n春雨竹间绿，流泉花下红。\n一樽今古意，不尽鸟言中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28970,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过张幼于曲水园因赠二首 其二","author":"张元凯","text":"不仕人犹贵，逃名事岂赊。\n久将忘月露，渐以寄烟霞。\n覆瓿无非草，如椽总是花。\n五车亲著述，何羡邺侯家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28971,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岁暮二首 其一","author":"张元凯","text":"残岁风兼雨，畸人病且贫。\n镜丝俄染素，甑草欲栖尘。\n常是不得意，何如无此身。\n但牵良友约，春到笑歌新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28972,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岁暮二首 其二","author":"张元凯","text":"风雨漂摇日，将雏止旧巢。\n仅能存故步，何恤失前茅。\n金尽僮违约，官休客善嘲。\n五湖春草绿，吾岂系吾匏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28973,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题傅吴令斋榻","author":"张元凯","text":"棐榻聊爰处，蒲团半借禅。\n梦将蕉鹿辨，德以木鸡全。\n欹枕看山月，披襟嗽石泉。\n好携青琐去，莫问管宁穿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28974,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题徐氏悟香庵","author":"张元凯","text":"香界同兰若，经函借苾刍。\n花枝生灭幻，云影去来无。\n忍行全依草，慈心遍及乌。\n不须重舍宅，此有小浮屠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28975,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赏海棠次韵","author":"张元凯","text":"海棠开烂漫，华馆共徘徊。\n色受群芳妒，香因太艳摧。\n枝枝供丽曲，朵朵劝深杯。\n恍惚花神驭，巫山行雨回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28976,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"牡丹下夜集","author":"张元凯","text":"绮窗云半护，香气雾相和。\n为惜春光尽，翻怜夜色多。\n客欢方太剧，花态转微酡。\n欲迟朝霞至，明星奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28977,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春雨","author":"张元凯","text":"垂垂春雨密，黯黯暮云低。\n莺湿翻寻谷，花残自委泥。\n青山违抗迹，绿酒洽幽栖。\n五柳门前水，依然与岸齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28978,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闭关","author":"张元凯","text":"余本餐霞客，曾无爱独醒。\n蹇修元迕俗，灵鉴自沉冥。\n竹帛春云散，荣华早露零。\n闭关谁最善，颂酒得刘伶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28979,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金昌亭送客","author":"张元凯","text":"客子欲分袂，离亭恋夕曛。\n楼台吴泽国，舟楫楚江濆。\n树外白云断，城隅绿水分。\n萍浮千万里，何地更逢君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28980,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题公瑕丈觉海山居","author":"张元凯","text":"林栖依觉海，云构接支硎。\n斜谷缘畴转，回岚抱宇青。\n花枝疑杜曲，流水学兰亭。\n为爱鹅群好，曾将换道经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28981,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江村同方山人子服过寒山寺访旭上人","author":"张元凯","text":"旷适柴桑叟，栖迟萧寺邻。\n贫家春酒绿，细雨杏花新。\n澹虑全轻物，忘机不畏人。\n远公能好客，因尔得相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28982,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上归","author":"张元凯","text":"野寺垂杨外，湖陂乱苇间。\n翠含千树雨，青露一痕山。\n果熟喧童口，桑稠碍女鬟。\n渔舟小如叶，载我洞庭还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28983,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄晋陵吴生","author":"张元凯","text":"永夜寒吹角，江天独倚楼。\n以君怀璧罪，同我戴盆忧。\n雁影吴关断，兰芳湘渚留。\n长安联辔日，曾与酒人游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28984,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"芝玉北归与小饮","author":"张元凯","text":"余抱三时疢，君归万里遐。\n马蹄霜路草，人鬓雪山花。\n雉堞栖残照，鱼梁度断霞。\n金昌纵凋落，醇酎可频赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28985,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山甫长倩过慰作","author":"张元凯","text":"坐叹尊无绿，行歌园有桃。\n燕山曾送别，楚水又离骚。\n月白清猿近，天寒旅雁高。\n可怜张仲蔚，不得住蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28986,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送幼于之南都","author":"张元凯","text":"洛邑今江左，当年我再过。\n每经桃叶渡，爱听竹枝歌。\n绿树丹阳渺，青山白下多。\n未须重吊古，时事近如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28987,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日有怀子念","author":"张元凯","text":"萧瑟清商候，长怀沧海君。\n把杯重问月，染翰几停云。\n桂向淮山老，兰从楚泽分。\n独愁萍散处，漂乱白鸥群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28988,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"嘉则丈过吴值余抱奇疾而罹叵测也辱长篇慰劳率尔为答情见乎词时辛巳六月三日二首 其一","author":"张元凯","text":"每动良朋叹，偏伤逆旅魂。\n病居葑菲体，家住虎狼村。\n贫也如悬磬，天乎尚戴盆。\n秖令心尽死，翻讶舌常存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28989,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"嘉则丈过吴值余抱奇疾而罹叵测也辱长篇慰劳率尔为答情见乎词时辛巳六月三日二首 其二","author":"张元凯","text":"岂是乾坤窄，还疑日月偏。\n邹阳书在后，乐毅谤居先。\n行间金乌有，图存酒可全。\n此邦黄鸟什，羞与故人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28990,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟次","author":"张元凯","text":"转蓬犹日暮，落叶满河梁。\n楚地愁来速，吴乡梦去长。\n浪翻千片月，人静一船霜。\n不尽孤征意，山猿与断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28991,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"留客","author":"张元凯","text":"草舍邻萧寺，柴门隐竹丛。\n榻容徐孺借，杯许故人同。\n乱水秋逾碧，孤芳晚更红。\n前溪垂钓处，已在月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28992,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄远","author":"张元凯","text":"锦字三秋隔，萍踪万里浮。\n秪凭新月旦，无损旧风流。\n眉黛张京兆，腰肢沈隐侯。\n文园多病后，好寄鹔鹴裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28993,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"水上","author":"张元凯","text":"短棹菰芦出，长谣水上闻。\n山青才歇雨，湖白欲生云。\n浪转鸥无迹，沙回藻有文。\n渚兰随可采，宁待楚人分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28994,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"傅吴令初度","author":"张元凯","text":"茂宰行春遍，芳辰初度临。\n飞凫双赤舄，鸣凤一瑶琴。\n不尽风云色，俄成桃李阴。\n萱花在东郡，偏系使君心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28995,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿沈道士馆","author":"张元凯","text":"信宿玄都境，逍遥十二楼。\n蓬莱非远道，鸾鹤不多俦。\n明月悬为佩，春云覆作裘。\n碧桃千万树，挟尔凤笙游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28996,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"千手观音庵","author":"张元凯","text":"寻尺袈裟地，依然列梵筵。\n高城分碧柳，勺水得青莲。\n幻化孤云变，声闻独鸟传。\n会瞻千佛手，一指借通禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28997,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金昌亭偶述","author":"张元凯","text":"锦浪逐兰桡，桃花映画桥。\n巫山魂欲断，洛水影偏娇。\n倚醉斜云髻，临风曳雾绡。\n当年溱与洧，芍药戏相要。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28998,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄客","author":"张元凯","text":"客梦天南树，乡心海北楼。\n悠悠流水恨，寂寂落花愁。\n道路孤蓬转，容华清镜投。\n鲤鱼书一札，早晚过江州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28999,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"燕居","author":"张元凯","text":"衡门聊偃息，泌水可忘餐。\n黄鸟林中听，青山江上看。\n云流石几净，花落竹房寒。\n短发偏宜散，何须制箨冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29000,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"豹孙宅赏芍药花","author":"张元凯","text":"芍药何夭艳，丛开绕翠帷。\n差堪比西子，真不愧南威。\n映斝光生玉，侵衣色尽绯。\n彩云看不散，迟日共流辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29001,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上方寺后港观荷","author":"张元凯","text":"芙蕖浮潋滟，鸥鹭乱汀沙。\n信是招提境，偏开净土花。\n练光摇白羽，杯影泛青霞。\n归棹何须急，明星出若耶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29002,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山家赏菊","author":"张元凯","text":"傍篱开种种，临水故娟娟。\n艳岂从人爱，幽偏得我怜。\n杯深倾叶底，巾折堕花前。\n吾直师元亮，沉冥不问年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":29003,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]