[{"title":"登沙堤新筑钓台次石翁韵","author":"方献夫","text":"一台筑石江心起，风月先生钓且吟。\n此是江门旧衣钵，当时分付意何深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高氏祖庙诗 其七","author":"湛若水","text":"于弘有庙，有庙孔贲。\n厥孙维谁，秋卿之贰。\n秋卿之贰，大都之宪。\n维贤孔嘉，厥品维二。\n都宪曰嘻，匪则友机。\n维祖华亭，维考光禄。\n维述庵公，是训是廓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答侍御朱君诗 其二","author":"湛若水","text":"酌彼泉水，其泉泚泚。\n其泚维何，有源其涘。\n其源维何，众卑之归。\n卑以受善，维天下溪。\n其善其察，涓涓始达。\n漙博渊泉，渊深天阔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日叙同社","author":"区越","text":"葛衫纱帻自西屏，病起寻幽怕远行。\n荒树乌啼惊曙色，小园花落怨风声。\n山蔬野蔌聊供具，一日三秋几合并。\n留得一壶春酿在，高歌还属老先生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新覆重茅诸君子以诗酒相贺赋谢 其一","author":"区越","text":"暂覆重茅傍竹阴，焉知来者不如今。\n百年事外机尤浅，二亩城中分过深。\n绀碧数蛙衰老药，琼瑶满壁故人心。\n梧桐种得留栖凤，纵有高枝不作琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙州诗 其一","author":"湛若水","text":"龙之山不兴雨云，山中之人不可以论。\n乌用如城矻高旻，祇可以障南氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙州诗 其二","author":"湛若水","text":"龙之水亦流束荆，水阳之氓不可以情。\n乌用如堑流深溟，惟可以洗甲兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蛇虎颂 其一","author":"湛若水","text":"猗灵乎虎，无争幽人之所。\n虎也不争，夫何世之情，不如彼虎之灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蛇虎颂 其二","author":"湛若水","text":"吁仁乎蛇，无嗔居士之家。\n蛇也不嗔，夫何世之人，不如彼蛇之仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九龙颂 其一","author":"湛若水","text":"一龙乘云，九龙在田。\n一龙全身，九龙潜渊。\n龙德之潜，其潜正中，吁嗟乎龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九龙颂 其二","author":"湛若水","text":"一龙将雨，九龙处处。\n一龙来宇，九龙避所。\n龙德之让，其让正中，吁嗟乎龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德州吟 其二","author":"湛若水","text":"大风起南冥，吹我德州旗。\n霾云蔽白日，白日无光辉。\n阴晴固有定，丰隆亦奚为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游湘湖","author":"湛若水","text":"始闻湘湖胜，三夜梦见之。\n先拈龟山香，乃敢陟湖堤。\n旁湖山气合，山与云天齐。\n渐进迷远近，逾深遂忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮南雄张太守忠爱堂即席赋","author":"湛若水","text":"置酒高堂上，广乐陈前墀。\n清风迎度曲，白云生舞衣。\n俳优虽云假，情至感欢悲。\n使君播惠和，千里同谐嬉。\n乃可乐斯堂，乐之无忸怩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画","author":"湛若水","text":"一鹊宿高枝，三鹊鸣且飞。\n三鹊若得志，一鹊若无为。\n一鹊养奇翅，九万君得知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贞阳吟","author":"湛若水","text":"浈阳汇清深，两岸山千寻。\n倒景覆东壑，返照他山林。\n野筱摇壁动，山芭弄风吟。\n悄然兴我思，愧负泉石心。\n南冈挂鹿冠，长流濯尘襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲戍正月十七日潘仲鲁黄门诸友游金华双龙赤松诸洞二首 其二","author":"湛若水","text":"开岁新阳候，微雪初晴天。\n空峒霭朝晖，石榻生寒烟。\n独木度危壑，千峰隔尘寰。\n閒同二三子，淩厉寻神山。\n群英播芳秀，奇葩吐清妍。\n真源杳何许，日夕憺忘旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用原韵酬姜仁夫兼柬董道卿四首 其一","author":"湛若水","text":"我本增城子，家实在天山。\n持此观化意，遨游乎人间。\n游居以一视，忙处有真閒。\n土木长兀兀，佩玉自珊珊。\n涓流赴大海，星火势必然。\n寄语远游子，游心夙当还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用原韵酬姜仁夫兼柬董道卿四首 其二","author":"湛若水","text":"还此远游念，即事乃名山。\n鱼泳深渊底，鸟飞霄汉间。\n此理盈宇宙，万变心自閒。\n登山索美玉，入海寻名珊。\n自兹皆外求，我言然不然。\n至宝本固有，何必徒往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用原韵酬姜仁夫兼柬董道卿四首 其三","author":"湛若水","text":"往还等妄虑，谁能不同天。\n天枢寂不动，万事如云烟。\n异哉狂驰子，乃欲出人寰。\n垂涎探宝藏，脱迹蓬莱山。\n耳能听丝竹，目能辨蚩妍。\n天灵参我前，宇宙相周旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用原韵酬姜仁夫兼柬董道卿四首 其四","author":"湛若水","text":"周旋至南极，弭节金华天。\n道逢同心子，班荆坐野烟。\n凭高一舒啸，直欲小八寰。\n八寰皆我闼，何处是故山。\n霭霭晴岚翠，灼灼春花妍。\n千秋风浴意，乐矣忘言旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬姜仁夫用阳明韵见赠兼怀阳明四首 其一","author":"湛若水","text":"榜夫晨理棹，行人难久留。\n悲管三四动，注目临溪楼。\n昨为饮会地，一旦如三秋。\n流光逝不停，一去永不收。\n幽兰发汀渚，灵芝秀崇丘。\n因风遗远馥，聊以消我忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬姜仁夫用阳明韵见赠兼怀阳明四首 其二","author":"湛若水","text":"我忧难且陈，具陈忧愈长。\n寸心托短札，道远不可将。\n隆思盈怀闼，浩浩谁能量。\n上士厌糠籺，狗马饫高粱。\n芝兰翳草莽，荆杞生高堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬姜仁夫用阳明韵见赠兼怀阳明四首 其四","author":"湛若水","text":"险阻思安土，乐天安可忘。\n念彼同怀子，暌别令心伤。\n天地尚回转，日月会有常。\n咫尺乃千里，何况道路长。\n滁云耿悬榻，婺雨暗山房。\n摩挲旧题句，中夜梦连床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题风木馀思卷为前工部今刑部主事张君公载父","author":"湛若水","text":"昔为都水使，今为贯城星。\n问是谁氏子，诗礼闻过庭。\n传家一忠孝，孝感有足徵。\n先君居庐日，供花发于瓶。\n无情尚可格，况以通神明。\n伊人久已逝，乡里有流声。\n开卷为再拜，永言风木情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠内侄袁汝进掌教候官","author":"湛若水","text":"尔考贤明府，于我内弟兄。\n辍铎宰名邑，早时解簪缨。\n嗟子实贤似，秋闱起传经。\n两拜广文毡，候官自连城。\n端确吾所爱，闻礼由过庭。\n去振传家铎，风声播八闽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将游观音阁诸胜途中","author":"湛若水","text":"朝出平子门，朔风吹我衣。\n欣然得閒情，荒村稻畦畦。\n仰视云间雁，木落犹南飞。\n感我故园念，秋深客未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊望送南京王大理汝温升北少司马","author":"湛若水","text":"羲和驭短景，昏中正昴星。\n修途翳积雪，长河合层冰。\n客行焉汲汲，召命有严程。\n旧握棘寺符，今摇司马旌。\n明皇重孝理，兵刑亦匪轻。\n折冲在尊俎，万里有长城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊子三月二日取道毗陵同梁壶山携葛涧周卫诸生游张公洞遂憩茂潭别院","author":"湛若水","text":"乐事分行役，矧兹及暮春。\n携我诸友生，沿流问真源。\n独行罨溪渚，澄心茂潭渊。\n举袂引天风，飘忽扫浮云。\n窈窕访名洞，怪石罗前陈。\n苟非有自胜，谁能不伤神。\n鬼幻亦云凿，天工何太勤。\n顾谓二三子，反观而自然。\n前行诣虚敞，高明生冥玄。\n入室贵三昧，升堂庶有闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将游句曲洞天以公程促还南雍寄曹宪佥时范","author":"湛若水","text":"怅望三茅峰，公程妨迂陆。\n令我归璧水，夜夜梦句曲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游胜泉寺","author":"湛若水","text":"驱车暂出郭，已远朝市喧。\n更寻万泉源，洗我耳中尘。\n岂止耳中尘，因可清心神。\n安得挽天瓢，一洗世间氛。\n尘氛既已尽，天地皆回春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芳懋堂","author":"湛若水","text":"尔家昆山旁，昆山多琳琅。\n神彩曜天地，后先互相光。\n闻有五色鸟，习习来回翔。\n凤毛今三世，羽翼日以长。\n名门与山高，高榜芳懋堂。\n堂前何所有，兰桂交芬芳。\n主人世积善，嘉祉流无疆。\n孙曾传豸斧，云仍执谏章。\n正直以忠厚，鹰鹯为鸾凰。\n何以为芳懋，家学世孔臧。\n何以学孔臧，凤德兰桂香。\n此学自元凯，济美今高阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同诸贤登高甘泉山 其二","author":"湛若水","text":"泉山一方高，其高能几何。\n不能千尺耳，罗浮之丘阿。\n罗浮自海岸，万丈突巍峨。\n以顶等高卑，未知孰为多。\n此山系望远，地位累坡陀。\n此山可远望，紫气腾冲和。\n望之已可爱，而况来登歌。\n即事既已高，万丈如吾何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王廷评俨考绩之京","author":"湛若水","text":"往年竹园席，之子亦观光。\n时违事已远，伟器但昂藏。\n落笔中书召，中军棘寺郎。\n上最上天去，彩云朝玉皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送大司成陈琴溪之南雍 其二","author":"湛若水","text":"圣人临雍思南国，思得司成司礼乐。\n谓君德化犹在人，君之南行当不薄。\n亲承诏旨出明庭，春明门外春花生。\n花光一路送君行，明年君北还相迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓楚云台赠汤民悦二首 其一","author":"湛若水","text":"驻马梅村坞，何心问钓船。\n别来浑梦寐，那更此延缘。\n伯氏论知己，孤灯记昔年。\n白龙秋望里，还约酒杯传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓楚云台赠汤民悦二首 其二","author":"湛若水","text":"武陵当日路，谁问打鱼船。\n风日非人境，烟霞谢世缘。\n白云来小卧，丹诀问长年。\n一笑日将莫，江山画影传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠汪东之与继子袭职归徽州","author":"湛若水","text":"汪子江湖客，因人观国光。\n明朝烟艇去，相忆齐云长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送范应祥州判赴任安陆","author":"湛若水","text":"翩翩贤别驾，展足来帝乡。\n已见呈甘露，他年看凤凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次潘黄门人日韵三首 其二","author":"湛若水","text":"人日占晴候，元亨乃时行。\n宿雾停风合，疏云漏日明。\n三阳开景运，两度昧明生。\n欲讼雨师去，巫咸其上征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿周中府使归适太夫人华诞","author":"湛若水","text":"即有登堂义，贤郎两定交。\n因知熊胆教，不谢棘心谣。\n春酒开眉寿，华辰驻使轺。\n班衣与锦绣，随意舞飘飖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送少司寇惕庵张廷献之京","author":"湛若水","text":"司寇初仪制，看花忝上林。\n勋名随位盛，企慕与年深。\n抚俗全威德，明刑在恤钦。\n年劳报当宁，更为达呻吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送南京宫幕王公子拜官归寿母","author":"湛若水","text":"而翁吾榜秀，不见久云亡。\n贤嗣新宫幕，名门复发光。\n历言维老母，八帙在高堂。\n衣锦归荣寿，何如公寿章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠侍御沈子京刷卷两广十二韵","author":"湛若水","text":"柱史才名旧，驰声自龀童。\n五湖分秀气，一桂出高丛。\n堕地应超足，依麻却有蓬。\n彩毛殊似凤，玄学蚤参雄。\n伯乐惭高识，骅骝有逸踪。\n程文须世轨，诗派是家风。\n玉节飞霜重，纶音宠渥隆。\n行吟江左右，直指岭西东。\n发擿无遗秘，爬梳胜发蒙。\n清谈挥案牍，馀泽及疲癃。\n绣豸承家旧，传车过里荣。\n三年司耳目，必有报重瞳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翁存道宪副赴荆湖兵备八韵","author":"湛若水","text":"威弧将肃气，岁晚下荆州。\n戎马论兵地，才能壮国猷。\n洞庭春水阔，衡岳宿云收。\n云移图阵外，水满舳舻浮。\n舒啸登楼夕，赋诗横槊秋。\n运筹南北会，胜制楚吴头。\n营月宵堪迥，狼星夜合愁。\n风流元漫叟，经略尔追求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寿孙老夫人七十华诞诗十四韵","author":"湛若水","text":"得拜夫人懿，门楣与岳高。\n冰清辉斗极，玉润映天曹。\n咏葛芳先播，歌荇夙已芼。\n眉齐孟光敬，手绩穆姜劳。\n洁事帷粢盛，供脩在茧缫。\n五州襄抚镇，一德相夔皋。\n梱内成宾礼，庭中有凤毛。\n纬嫠忧在室，菜妇惬同牢。\n八座传闺范，三朝受帝褒。\n霞帔金紫绶，珠翟鹤云袍。\n寿域开江国，清谣尽世髦。\n曾孙嬉广宴，天姥效微醄。\n仙掌公分露，瑶池母降桃。\n想应称兕处，万舞并摇翿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶题南安王家楼上","author":"湛若水","text":"鸟飞兔走几将迎，映阁秋光江濑鸣。\n尔欲无心吾亦尔，出门莫问弃繻生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"双寿为陆元静亲","author":"湛若水","text":"乌纱珠翟映清宁，尔屋堂边两洞庭。\n樽俎湖山开寿域，长庚天姥听吹笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送宋有台中丞抚蜀","author":"湛若水","text":"斧钺遥临峨岭动，风声雷令自天来。\n西夷亦入文翁化，小队寻花月几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"先期史恭甫来同游茅山家人已迎至镇江矣月十二日也意其连夜归报速来予已到山二日至望之暮犹未至岂为泥雨所阻欤或赈饥之务未暇欤未可知也因作二诗唁之 其一","author":"湛若水","text":"恭甫铨曹期不来，兴高迹滞令人猜。\n鸣鞭走马通宁报，捷径冲泥冒雨回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用前韵送司马莪峰先生考绩癸巳十一月十六日","author":"湛若水","text":"莪峰相见服俱青，怀抱经纶是大经。\n署事初筵随接篆，论心倾盖已忘形。\n历扬勋业瀰中外，笑比迂儒愧径庭。\n此去报君兼鲁政，更看北斗耀文星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿少司空姚先生","author":"湛若水","text":"东泉先生吾低头，去岁倾盖公生秋。\n造父轻车仍熟路，庖丁芒釰不全牛。\n早将文苑开闽桂，每见先声遁虏酋。\n方驾清流欺逝水，欲从高步陟尼丘。\n司空简在咨畴若，报政应同府事修。\n骥子超先空北冀，凤雏联翼瑞西周。\n喜逢初度春方半，遥想华晨乐未休。\n试问当筵谁戏彩，贤郎系藉在瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"走笔答柯双华佥宪","author":"湛若水","text":"双华笔端语，读之乱心绪。\n何如待高秋，相约祝融去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题湛渎桥","author":"湛若水","text":"何年姓此渎，天设岂无因。\n五百年来我，题诗过暮津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题吴颐山大参蠡南精舍图","author":"湛若水","text":"精舍生吾兴，披图不自堪。\n回辔上船去，长留忆蠡南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酌惠泉二首 其一","author":"湛若水","text":"天一元生我，来看第二泉。\n平生观海意，此际更渊渊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酌惠泉二首 其二","author":"湛若水","text":"我屋甘泉洞，泉甘亦自同。\n独怜生海外，题品未曾逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"走笔谢王嘉兴护送之使","author":"湛若水","text":"未论通家好，先闻刺史贤。\n独惭二百使，空赋五言还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过分水岭书所见","author":"湛若水","text":"水性本平止，胡乃生怒涛。\n势亦不得已，前石后流驱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题官山阁老图","author":"湛若水","text":"阁老辞天府，归来即广居。\n知公自良贵，何处觅吾□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题石泉精舍图","author":"湛若水","text":"紫云在云外，幽居紫云里。\n空谷烟萝深，深藏配君子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题求志堂","author":"湛若水","text":"志在焉用求，求之无定方。\n不求求便得，何处是他乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题善养堂","author":"湛若水","text":"辞禄善吾养，无论尹氏贤。\n何如养吾善，兼以事吾天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"口占赠西岭秦子由之任呈迈","author":"湛若水","text":"有客秋到山，山高月色大。\n持赠明府行，相随到呈迈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题自师堂二首 其一 处静","author":"湛若水","text":"在静而无静，在动而无动。\n试问动静神，处者谁人用。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题自师堂二首 其二 润崖","author":"湛若水","text":"山泽形相隔，一气本相通。\n若识山崖体，方知泽润功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":57907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]