[{"title":"立秋后感","author":"张澯","text":"金盏银盘丽短墙，秋来依旧菊花香。\n有时闭户避桃李，孤负一春无酒尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫词答孙南城","author":"张澯","text":"从新梳洗插宫花，欲伴君王作紫霞。\n银烛夜深人不语，几回飞梦到官家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"独坐","author":"张澯","text":"菊花原不待秋开，自对东篱自举杯。\n莫把轻枝斗风雨，重阳问我赋归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀英太守天彝广行不至 其一","author":"张澯","text":"酌罢潇滩酒，登楼日日心。\n是谁过剡棹，想杀月华临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀英太守天彝广行不至 其二","author":"张澯","text":"萧萧惊落木，飒飒响秋风。\n无数闺人恨，凝眸数过鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀英太守天彝广行不至 其三","author":"张澯","text":"芳草连天碧，苍烟满眼飞。\n离心正断绝，独宿倩谁知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":682,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀英太守天彝广行不至 其四","author":"张澯","text":"雪焰飘飘舞，梅魂默默催。\n一心随斗柄，特地望春回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":683,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次龙桥方棠南郊陪祭韵","author":"张澯","text":"天子祀南坛，龙光一道寒。\n街墀临月姥，花柳覆仙官。\n候驾旌旄拥，焚柴衮冕看。\n至诚闻监格，雅颂表心丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":684,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"官桥秋笛","author":"陈洸","text":"垒石为桥数百春，恍疑乌鹊驾河津。\n尘中车马经行古，舆上规模制作新。\n得意共称题柱客，怜才谁识授书人。\n清宵惟有桓伊笛，三弄梅花月下频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":685,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南海歌渔","author":"陈洸","text":"海外浓烟忽渐收，扁舟一叶泛中流。\n落霞孤鹜齐飞处，极浦遥天一色秋。\n断续棹歌风里发，高低渔唱月中酬。\n细看渭上鹰扬者，岂肯埋名到白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":686,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"双忠庙","author":"陈洸","text":"灵威恒著万年容，香火于今尚爇红。\n死节睢阳人有几，效忠唐室世难同。\n云雷百战须眉壮，安史千军瘴疠空。\n古庙已昭山麓上，不辞杯酒酹英风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":687,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"温泉","author":"谢誉","text":"一鉴沧浪照眼鲜，脉通何处暖生烟。\n古今浩浩烹明月，昼夜沉沉煮碧天。\n沸作春涛翻起峡，碎分山影浸长川。\n何人洒落携童冠，歌濯尘缨坐石边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":688,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读易亭","author":"胡宗奎","text":"石公读易不求文，精言于今义薄云。\n山谷有君人杰至，竹林无籁鸟声频。\n窗前草木阴阳理，窝外云峰卦象纹。\n烟锁九原茅塞路，瓣香何处吊英魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":689,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南山","author":"胡宗奎","text":"层峦南峙景宜人，今古登唫类李绅。\n岛上观澜知道体，酒中联句适情真。\n鸣弦峰峻星辰近，读易亭幽蓍草新。\n忘势贤侯同众乐，熙熙风月葛天民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":690,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"榕水流声","author":"刘汉","text":"古榕潮汐地，百折绕平田。\n吞吐涵明月，盈虚漾碧天。\n养源宗楚令，知味契伊川。\n赋罢临流兴，曲肱一枕眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":691,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题莫状元祠","author":"陈锭","text":"浩浩冲冲横九州，精神默契在瀛洲。\n宸聪注意垂清问，云汉扶摇拱冕旒。\n策献万言方启沃，梅调九鼎尚虚留。\n虽然亲老归心速，千古丝纶贯斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":692,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访越塘次前韵","author":"方茂夫","text":"游得禅心事事休，满将风月载扁舟。\n已穷海水不到处，又访云山欲尽头。\n烨烨紫芝铺晓露，飞飞红叶点深秋。\n人间境界知多少，更许浮生几度游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":693,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访波亭次先祖旧游韵","author":"方茂夫","text":"垂老清溪念不休，漫随烟水放扁舟。\n江山笑指空陈迹，童稚今看半白头。\n渔笛自归横浦月，菊花遥望故园秋。\n百年细记尊前话，泪落吾翁惜旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":694,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李与可应贡北上","author":"方茂夫","text":"相送一尊酒，游子万里心。\n倚剑白日暮，长啸春江深。\n自矜屈宋俦，未登词赋林。\n丈夫立功名，何计尺与寻。\n鸾凤会轩翥，岂终鸡鹜群。\n行当献奇策，台已筑黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":695,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别王阳明先生","author":"方茂夫","text":"洛下风流已屡更，望中歧路苦纵横。\n轻车未见驱前辈，剩语徒闻病后生。\n今古一机空自信，乾坤变眼为谁明。\n虚斋话转松萝日，却恨天涯盖晚倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":696,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西郊寻梅","author":"方茂夫","text":"白发青藜乌角巾，梅花随处自留人。\n疏枝冷蕊原无意，野水荒山别有春。\n懒去生涯诗作课，病来行乐酒相亲。\n狂歌醉倒花间卧，不是罗浮梦里身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":697,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读巽川集","author":"梁希鸿","text":"巨鲸怒吸海江枯，为问曾增纸价无。\n午夜茅斋烧蜡炬，令人无意读三都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":698,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送翟兰谷之任藤县教谕","author":"李希说","text":"吾道堂堂日月中，乾坤随处满儒风。\n十年北斗斯文望，今日西藤学者宗。\n雨化山川全出色，春添坛杏愈加红。\n不须去打苏湖板，自有无言造化功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":699,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灵山寺和濂溪韵","author":"陈江","text":"山斗仰韩千古在，释儒相访未全非。\n曾闻更有相忘者，解带江门换衲衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":700,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊熊飞将军六首 其一","author":"彭絅","text":"六飞湖海困风尘，岭表孤臣泪湿巾。\n温峤未还须念国，仲连宁死不归秦。\n英雄举事应难料，管见窥人恐未真。\n惭我独无金藏愤，一篇函草亦空陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":701,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊熊飞将军六首 其二","author":"彭絅","text":"血战江城万鼓催，悲风特地起泉台。\n从前富贵称廊庙，此日纲常系草莱。\n铜岭夜残鸡舌远，曲江秋晚鹤声哀。\n山堂集取蝉蛙语，狐笔他年一例裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":702,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊熊飞将军六首 其三","author":"彭絅","text":"四广三闽一掷梭，更谁回首问铜驼。\n檐乌恋主南来少，旧燕依人北去多。\n一死纲常归草莽，百年忠义励山河。\n荒村日落游魂杳，夜有丁零啼月过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":703,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊熊飞将军六首 其四","author":"彭絅","text":"风雨猖狂海若飞，江山惨淡月光微。\n六更已尽知无策，一羽腾空肯浪依。\n大节自能摧去就，么魔谁敢妄排讥。\n閒来几向山灵问，野草荒村对落晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":704,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊熊飞将军六首 其五","author":"彭絅","text":"海宇倾颓尽陆沈，此身羞与共乾坤。\n春秋大义千年在，夷夏纲常一死存。\n华表有山能引鹤，人间无庙可栖魂。\n品题愧乏宣尼笔，独立西风一欠伸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":705,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊熊飞将军六首 其六","author":"彭絅","text":"山河飘泊水流淙，万里君臣共一艭。\n肉食谁能支北虏，草茅公独奋南邦。\n已知运去中原陷，未肯身为左衽降。\n回首康王能渡马，滔滔流恨满长江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":706,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贞节莫孺人三首 其一","author":"林士元","text":"早岁离鸳侣，晨昏强自持。\n个中惟欠死，此外更何思。\n盟誓山丘重，贞心天地知。\n昭照青史内，千古令名垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":707,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贞节莫孺人三首 其二","author":"林士元","text":"偕老平生愿，那堪丧所天。\n妆台春梦冷，玉颊泪痕鲜。\n劲节丹心炳，孤身白发坚。\n彤庭旌节下，奕祀姓名传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":708,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贞节莫孺人三首 其三","author":"林士元","text":"一自良人逝，冰霜苦自持。\n红颜身不死，白璧行无疵。\n镜里铅华谢，胸中铁石期。\n覆舟身不没，节孝有天知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":709,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送周清溪先生福州司训","author":"林士元","text":"周君金锡姿，煅炼承趋庭。\n靖江辅以立，武昌翼以行。\n工曹仗涵煦，兰玉播休声。\n教子听鹿鸣，云端高鶱腾。\n知君不出家，岿然四教成。\n父母称其孝，友弟称其兄。\n崚嶒邓林树，皎洁昆山珩。\n古学贵践实，今人多近名。\n至尊惟道德，轩冕铢尘轻。\n遥知勤秉铎，乐育鲁诸生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":710,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭周岳父追忆前事 其一","author":"林士元","text":"我本樗栎姿，供奉冰玉清。\n言念八岁时，与公未识荆。\n高声读孟子，防马践田滕。\n公来予起揖，作意问姓名。\n手揭明堂章，询我王政行。\n予既诵之遍，讲义亦粗明。\n公大为叹息，兴宗良后生。\n荆钗甫二岁，已属桃夭情。\n先君重交谊，即此订昏盟。\n山头亦红叶，他年故事增。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":711,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭周岳父追忆前事 其二","author":"林士元","text":"自鹿车共挽，欣叨进琼庠。\n文场声誉起，期予破天荒。\n庚午年大比，秋闱举于乡。\n计偕将北上，厚赠充行装。\n爱我如所生，期望大显扬。\n甲戌捷南宫，慰公与高堂。\n啧啧听人言，称公眼力长。\n职授行人司，乞假归称觞。\n方图报寸草，谁料厄黄杨。\n悠然乘化去，曷禁心悲伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":712,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过丈人墓有感而作","author":"林士元","text":"泰山叹其颓，遗蜕埋黄阳。\n宿草覆如被，封石磊若堂。\n凄其追往行，忠信笃耕桑。\n贻子孙以安，远慕襄阳庞。\n昔别公尚健，勉我事君忠。\n今归公不见，凄凄白杨风。\n胜地龟浮水，长眠首丘东。\n年年坟前拜，渐长二孙龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":713,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽冬官周务斋先生三首 其一","author":"林士元","text":"归与远行棹，拜君新构堂。\n隔语尚款款，卧病原在房。\n谓言不日好，并坐叙喧凉。\n何竟朝闻讣，凄兮夕感伤。\n君上尚有母，膝下未生郎。\n平生忠孝节，一夜共琴亡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":714,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽冬官周务斋先生三首 其二","author":"林士元","text":"少小共闾闬，抱璞自绮龄。\n君年十一二，诵读通五经。\n靖江知令器，爱拟玉生庭。\n督学称佳士，高翔振凤翎。\n果尔南宫捷，部曹扬芳馨。\n谁知藜阁暗，天上陨文星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":715,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽冬官周务斋先生三首 其三","author":"林士元","text":"同友天下士，断金二人心。\n君心如日月，流光照我襟。\n共期百年内，事业耀亢参。\n何遽骑箕去，黯淡白云深。\n我如孤飞鸟，求友慕遣音。\n小豚依玉树，蒹葭托寸忱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":716,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游蜂叹","author":"林士元","text":"日出蜂乱飞，花落春初歇。\n夜来风雨多，枝头子初结。\n徘徊青山隅，群芳宁可掇。\n欲向泥中求，犹恐蒙不洁。\n物态无终穷，天道有生灭。\n功成身乃退，何事中肠热。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":717,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立鹤篇","author":"林士元","text":"西台岁云徂，独立抚孤松。\n仰盼丹关回，情眷玄鹤恫。\n玄鹤如诉言，感之恻余衷。\n冥鸿遵北渚，振鹭集西雍。\n飞扬各乘运，翩翩厉高空。\n洁身岂离群，澹素乃无庸。\n留踪破苔绿，露滴悬朱红。\n永唳奋清夜，朗月何虚融。\n照此哀怨深，耿耿殊未穷。\n亨嘉多夙遘，屯溺鲜英雄。\n形以落魄臞，长鸣向苍穹。\n愿祈圆景光，恒与今日同。\n月不去天上，鹤不老樊中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":718,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"樵溪行送郑一鹏给谏","author":"林士元","text":"淜湃水流云雾中，江翻急浪奔长虹。\n君侯览之动高思，悠然若破冯夷宫。\n投鞭断河洛，挂剑倚崆峒，松舟桧楫乘长风。\n棹歌依依明月小，帆影落落青天空。\n三山郑子好狂者，夷游海内靡所同。\n羡君高雅，为君和衷，百年意气多豪雄。\n宓琴奏西响，乔舄度南鸿，飞飞野雉春桑中。\n君胡为乎去岁朝京师于千里，拜舜华而九重。\n答兰陵之嘉命，奏蒲长之肤功。\n扁舟信于迈，落日吾追踪。\n万山云来意不极，一尊酒尽情无穷。\n君亦不能语，吾亦不能从。\n忽闻前峰战雷雨，乍惊别浦吟蛟龙。\n琅邪叟，渔阳童，群走江上呼明公。\n寇恂胡为不吾借，天阍高叫谁能容。\n长辞竟尔此黎赤，使我闻之为中激。\n民愚而神岂易得。\n道傍更有牵情者，杨柳依依漫垂碧。\n丈夫所志在经国，期使四海皆衽席。\n百里原非人贤居，鸾皇岂可终栖棘。\n汎三江，浮七泽，爱尔骞腾万里翮。\n吁嗟乎，别离可悲，长何足惜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":719,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠竹园隐者","author":"林士元","text":"寂寂江村路，何烦命驾过。\n羊求忘地速，松竹到门多。\n野外常无酒，田间别有歌。\n洗杯深酌处，落日在沧波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":720,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕立秋值雨","author":"林士元","text":"尊前红雨飞南山，坐隔牛女河之间。\n越岁佳期应自合，一望萧瑟总虚还。\n萤垂碧草疏帘静，燕入深红画栋间。\n漫指白云浮故国，忽因清梦落朝班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":721,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游滴水岩","author":"林士元","text":"露磴盘纡郁万岑，碧山飞映翠华临。\n鳌飞玉栋浮云烂，鹊隐琼岩封雪深。\n石顶有泉时滴滴，洞门无日昼阴阴。\n簿书多暇偏乘兴，潦倒尊中月满簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":722,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送诸生小试遇雨","author":"林士元","text":"电掣雷鸣酣野战，水吟龙啸郁云兴。\n山南月暗全无路，岸北沙明仅有灯。\n海内英豪今并起，江中波浪此凭陵。\n商霖散满焦枯发，野色新添万里青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":723,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日王龙津观物园","author":"林士元","text":"碧苔山深草堂絜，王子情□野兴悠。\n修竹烟霞凝玉扃，万松风露接清秋。\n放歌剧饮不尽意，落日出林还泛舟。\n山童载酒更呼酌，天畔雷鸣翻白鸥。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":724,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吕梁洪","author":"林士元","text":"吕梁洪险亦奇观，峭壁惊涛走万滩。\n楚缆吴樯天上度，朔云燕树镜中看。\n日黄山阁湖光皱，雪白江村草色寒。\n隔岸鞦韆喧不歇，桃花开遍曲阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":725,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日阻风部中限韵","author":"林士元","text":"白昼日黄天欲浮，燕城三月似高秋。\n涛生宫掖沙惊树，花覆苑墙春隐楼。\n朝马不嘶金勒断，塞鸿无路到关愁。\n却思丰沛有遗恨，猛士彫残蔓草稠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":726,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈子达院中赏榴限韵","author":"林士元","text":"露冷天阶银烛清，绛榴飞影斗间横。\n繁花媚已酬嘉节，多病愁兼剧世情。\n十里层台齐月上，三城悲角绕云生。\n与君未是清狂客，莫漫金尊尽夜倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":727,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚斋谒张永南翰读归复简此","author":"林士元","text":"宿雨不潦羲伯驭，晚凉堪曳玉堂裾。\n朱帘静度燕山色，碧构清涵太史书。\n倾盖几回瞻相业，虚襟终日对文儒。\n临风漫省瑶华造，欲报琼英愧不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":728,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻警和顾以新三间三首 其一","author":"林士元","text":"辽海风波偃将旗，狂奴操刀弄潢池。\n游鱼釜热应难久，缚虎笼深恨不支。\n营垒十年空节钺，羽书千遍乞王师。\n请缨有志长沾臆，击节终军喜尔为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":729,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻警和顾以新三间三首 其二","author":"林士元","text":"百年辽左号精兵，负险谁知气益横。\n一鼓日中飞炮火，三军帐下拔霓旌。\n不闻西贼忧韩老，犹自长沙哭贾生。\n近事大同姑勿论，往年甘肃悔行成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":730,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻警和顾以新三间三首 其三","author":"林士元","text":"六月王师晓出征，将军李广旧知名。\n燕然今去承推毂，天讨由来是应兵。\n万里若能褫逆胆，此生真不愧虚行。\n乘时勒石非难事，急为长杨一请缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":731,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中立秋","author":"林士元","text":"三伏初收展病扉，夜深风露漾霏微。\n碧梧已应金空落，大□新随斗指飞。\n燕倦客思违绿野，莲知老至退红衣。\n玉箫万里堪肠断，何处沧洲映紫薇。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":732,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乐耕堂","author":"林士元","text":"源头活水溢平川，桃色花香总自然。\n海上疑成真世界，人间谁信不神仙。\n棋惊宿鸟摇深竹，歌遏行云入九天。\n良会莫教轻住别，每逢流水惜芳年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":733,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"倭犯钟司徒墓雷震遁去","author":"林士元","text":"既归三尺乐斯堂，况有金函玉匣藏。\n谁谓盖棺占定事，犹遗赫怒庇重冈。\n丹忱贯石茔俱古，赤电明心山亦苍。\n千载智愚都幻化，到来贤哲自洋洋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":734,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题峡山飞来寺","author":"林士元","text":"峡中奇胜拟蓬莱，想是当年欲建台。\n天恐此方穷土木，故令神物特飞来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":735,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贞节周母孺人","author":"林士元","text":"宝镜鸾分四十年，魂飞孤冢锁云烟。\n冰霜节操共姜苦，铁石肝肠令女坚。\n万古纲常天地久，一生贞白鬼神怜。\n朝廷有意敦流俗，早晚褒书下九天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":736,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]