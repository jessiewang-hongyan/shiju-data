[{"title":"送袁上舍归岭南 其一","author":"王弘诲","text":"远道离离芳草铺，万家春色满皇都。\n谁将明月移归棹，一片乡心落五湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送袁上舍归岭南 其二","author":"王弘诲","text":"野色苍茫入望微，春风到处送征衣。\n王孙不似花无赖，新向金台得价归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送袁上舍归岭南 其三","author":"王弘诲","text":"一冬卧雪有袁安，归梦应怜客子难。\n想到越南春睡足，不知何似蓟门寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送袁上舍归岭南 其四","author":"王弘诲","text":"十载红尘识面初，谢家玉树更谁如。\n春来梦后池塘句，俱属风前塞雁书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南三名相 其一 张文献","author":"王弘诲","text":"庾岭开门拜始兴，开元风度至今称。\n东南一自公爰立，伊吕千秋几嗣登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南三名相 其二 崔清献","author":"王弘诲","text":"东海北海龙潜起，何如南海凤孤骞。\n平生亦有□门梦，欣慕何缘为执鞭。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南三名相 其三 丘文庄","author":"王弘诲","text":"张崔二献称唐宋，丘起琼台辅圣明。\n千载斯文闻后死，几人吾党续先生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泰山杂咏 其一 日观峰","author":"王弘诲","text":"五夜峰前曙色浮，曈曈先出海东头。\n拟将赤手扶羲驭，早向人间照九州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泰山杂咏 其二 玉皇顶","author":"王弘诲","text":"缥缈丹梯入九重，玉皇于此秘灵踪。\n寻真直上朝元殿，身在蓬莱第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泰山杂咏 其三 大夫松","author":"王弘诲","text":"二世河山已改移，五株犹冒受封时。\n昂藏似愧虚名污，贻笑商岩四紫芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泰山杂咏 其四 桃花峪","author":"王弘诲","text":"流水晴悬碧涧霓，桃花春似武陵溪。\n东方自拟随王母，纵少渔郎路不迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泰山杂咏 其五 丈人峰","author":"王弘诲","text":"高标孑立向天门，气象岩岩仰止存。\n五岳曾闻岱宗长，诸峰应是丈人孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五老观梅图为温陵林和之题 其一","author":"王弘诲","text":"暗香疏影占春华，名擅西湖处士家。\n不及竹林觇五老，压尽人间万树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五老观梅图为温陵林和之题 其二","author":"王弘诲","text":"大庾关门折赠时，东皇消息透寒枝。\n簪花紫帽知多少，野老无忘此日期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京上元歌 其一","author":"王弘诲","text":"宝马香车意气骄，春城游冶斗妖娆。\n星衢月市行应遍，一刻千金是此宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕京上元歌 其二","author":"王弘诲","text":"山拥游鳌繫綵绳，云盘飞凤护雕棱。\n中天一道风雷动，知是宫中正赏灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"止止庵拜白真人像","author":"王弘诲","text":"琼琯千秋有至人，朝元来此会群真。\n堂开止止标玄诀，凡质何缘景后尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"紫阳精舍怀古","author":"王弘诲","text":"洙泗遗编续建安，斯文元气障狂澜。\n棹歌此地流馀韵，郢曲从知和者难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜饮水晶庵","author":"王弘诲","text":"坐拥芙蓉隔岸浮，杯涵沆漭吸寒流。\n水晶宫里人如玉，铁笛飘飘海月秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放鹤亭","author":"王弘诲","text":"山人昔向云龙隐，此地还遗放鹤亭。\n佳赏百年寻旧迹，磨崖回首乱峰青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石佛寺","author":"王弘诲","text":"兜率岩前开宝刹，辟支洞里现文殊。\n青山不尽空中相，明月长悬顶上珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望湖亭","author":"王弘诲","text":"幽亭半面俯崔嵬，槛外波光一镜开。\n何处旧游偏得似，白云孤倚妙高台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天游峰","author":"王弘诲","text":"天游峭壁削成屏，铁嶂排空万仞横。\n一曲清溪峰外转，恍如银汉绕金城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙掌峰","author":"王弘诲","text":"仙掌岧峣北斗傍，遥从太华斗寒芒。\n九霄承露寻常事，万古天门捧日光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水帘洞","author":"王弘诲","text":"幽洞悬流作雨飞，一帘冰瀑溅珠玑。\n懒从玉女添妆镜，故向松关掩石屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游南华","author":"王弘诲","text":"卓锡泉边护法龙，宝坊丛里振南宗。\n寻师一叩西来意，云在青天鹤在松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"逍遥洞","author":"王弘诲","text":"洞口人家生事饶，桃花春水木兰桡。\n红妆绿鬓谁家女，隔树偏窥半面娇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望东林","author":"王弘诲","text":"看山尽日费幽寻，丹壑云房处处心。\n自是莲池无慧远，非关载酒避东林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉簪花 其一","author":"王弘诲","text":"疑是花神夜出游，花间晓堕玉钗头。\n佳人拾处春相惜，斜插云鬟傍翠楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉簪花 其二","author":"王弘诲","text":"何处佳人竞晚妆，素钗斜倚曲栏旁。\n月明应讶花无影，风细时闻玉有香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"林章叔送状元红荔枝赋谢","author":"王弘诲","text":"榴火丛中削玉团，一林红锦万人看。\n年年桃李争春色，谁似君家小状元。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝 其一","author":"王弘诲","text":"一骑红尘笑贵妃，冰盘玉椀溅珠玑。\n紫绡轻点胭脂额，剥啄声中春事微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝 其二","author":"王弘诲","text":"荔子丹兮报状元，宫罗轻剪玉肌寒。\n杏园走马泥金信，何似红尘骑里看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠王南薰","author":"王弘诲","text":"潦倒堪从孔北海，渊源并溯鲁东丘。\n握兰相对怀深旨，倚剑光芒射斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题胡墨溪小像","author":"王弘诲","text":"褒衣博带俨仪形，诗礼家传对过庭。\n宝鼎香烧环玉鸭，呼儿燕侍抱遗经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题 其一","author":"王弘诲","text":"侍立樽前粉黛香，阳台飞梦到襄王。\n使君自有閒情赋，不为司空错断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题 其二","author":"王弘诲","text":"芙蓉帐暖燕双栖，杨柳风凉莺语迷。\n娇傍海棠春睡足，娥眉偏向楚宫低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻蝉","author":"王弘诲","text":"曾闻清介饮琼浆，更听寒声急可伤。\n谩道绿杨深处隐，也应回首顾螳螂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嬴惠庵十景诗为邓元宇将军赋 其一 莲峰映水","author":"王弘诲","text":"藕花洲上感飘蓬，依约残妆媚晚风。\n何事轻盈还照步，西方生处水晶宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嬴惠庵十景诗为邓元宇将军赋 其二 湖光涵月","author":"王弘诲","text":"烟波荡漾莫愁湖，人去台荒月影孤。\n悔比嫦娥应记取，封侯较羿不如夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14120,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嬴惠庵十景诗为邓元宇将军赋 其三 云屏拥翠","author":"王弘诲","text":"山拥云屏似九疑，行人下马问洪祠。\n鹧鸪声里琼台暮，黯淡千秋两地思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14121,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嬴惠庵十景诗为邓元宇将军赋 其四 石窦泉香","author":"王弘诲","text":"季子坡翁怀古间，松楸石窦水潺湲。\n源源本本钟情处，家在泉南第几山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14122,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嬴惠庵十景诗为邓元宇将军赋 其五 八月星槎","author":"王弘诲","text":"盈盈秋水恍银河，登泛时随八月槎。\n织女支机君莫问，人间往事已蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14123,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嬴惠庵十景诗为邓元宇将军赋 其六 三春农务","author":"王弘诲","text":"年年黍稷纪惟馨，布谷催农尽日听。\n寂寞一区香火地，千秋血食飨岩扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14124,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嬴惠庵十景诗为邓元宇将军赋 其七 虹桥飞瀑","author":"王弘诲","text":"长虹捲瀑雨花飘，缑岭从谁听玉箫。\n千载琼浆何处捧，空疑仙子度蓝桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14125,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嬴惠庵十景诗为邓元宇将军赋 其八 古洞生烟","author":"王弘诲","text":"洞口斜阳海气蒸，茫茫宇宙想神凝。\n境非吾土终惆怅，不见温陵见万陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14126,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嬴惠庵十景诗为邓元宇将军赋 其九 层岩晚眺","author":"王弘诲","text":"游魂嬴惠两相依，徙倚层峦吊落晖。\n千载彭殇一抔土，牛山何必泪沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嬴惠庵十景诗为邓元宇将军赋 其十 石室仙踪","author":"王弘诲","text":"石门幽鸟语关关，仙子游踪不可攀。\n总为伤情无尽处，年年合浦叶飞还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕子楼","author":"王弘诲","text":"为忆青楼春望违，美人应泣燕于飞。\n可怜红粉俱销尽，不见人归见燕归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄楼","author":"王弘诲","text":"澶涧无复昔年流，厌胜城东事已休。\n惟有寓公留胜迹，至今烟景尚黄楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题木谷岭奇石补炼东南事有无，中天倚柱白云孤。端衣未下元章拜，纳履先占圯上符。●全粤诗卷三八五峡山寺","author":"王弘诲","text":"缥缈烟霞四望开，仙人此地有楼台。\n玉环已化猿踪隐，丹灶犹存鹤驭来。\n溪上碧桃和露种，洞中瑶草傍云培。\n扪萝路入青霄近，欲伴前山帝子哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白云山","author":"王弘诲","text":"一上名山石磴悬，禅宫高倚翠微巅。\n江波泱漭晴还雨，海雾苍茫断复连。\n缑岭似乘鸾鹤下，仙槎遥自斗牛旋。\n不须方外寻真诀，自是人间别有天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"罗浮山","author":"王弘诲","text":"何处神仙四百峰，丹梯万仞削芙蓉。\n瑶台积翠临旸谷，铁涧飞泉泻玉淙。\n丹洞云深留鹤驭，澄潭秋涨蛰蛟龙。\n七飞拟鍊超尘劫，桂父安期信可通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠岩","author":"王弘诲","text":"苍翠似经娲后炼，昂藏肯受秦王鞭。\n岩瞻壁立风尘表，端笏谁当拜米颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游南华寺","author":"王弘诲","text":"几载斋心学上乘，入门觉路羡初登。\n梦回欲解无生义，犹愧曹溪一宿僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同蒋明府游玉柱岩得莲字","author":"王弘诲","text":"洞凿玲珑入，岩窥宛转穿。\n壶天标玉柱，大地涌金莲。\n会拟兰亭客，杯分阆苑仙。\n何当邀鹤驾，即此谢尘缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"通天岩","author":"王弘诲","text":"胜地开三岛，通天有一门。\n涧幽穷禹迹，村远閟秦源。\n宛转穿萝憩，空濛煮石餐。\n悠然绝尘想，相对已忘言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玲珑岩绝顶三首 其二","author":"王弘诲","text":"飞阁悬崖俯万寻，灵岩对酒落峰阴。\n仙人窟宅还高下，幻迹熹微自古今。\n龙虎尚馀丹鼎气，鸾凰时度紫霄音。\n沧洲满目堪乘兴，莫问蓬莱路浅深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玲珑岩绝顶三首 其三","author":"王弘诲","text":"巉岩幽壑敞招提，蹑蹬穿林路不迷。\n茗椀香花随佛供，白云苍霭护禅栖。\n东林载酒渊明在，西竺同心慧远携。\n五十三参年已近，可能大意悟曹溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游石钟山","author":"王弘诲","text":"坡仙自昔好奇者，月夜乘舟绝壁下。\n石钟有记留兹山，寥寥千载知音寡。\n我来倚棹彭蠡傍，连朝风逆阻帆樯。\n探奇吊古寻苏迹，轻舠霄日归云房。\n巨灵雕锼役鬼斧，嵯岈谲怪张龙虎。\n回光倒影浸玻璃，雪窦风扃互吞吐。\n窾坎镗鎝若有声，鲛宫隐隐大镛鸣。\n瀛箫冯鼓纷相续，洞庭张乐拟韶韺。\n元也水经语不尽，渤乎聆音未深辨。\n一从坡仙更品题，山水文章同不泯。\n鲰生好古志每勤，蹉跎念载营朝昏。\n天时人事始相值，胜游千古追龙门。\n因思遇合亦偶尔，世间万事皆如此。\n曾闻海外多奇珍，何必苏钟与韩鼓。\n是非悠悠且莫谈，寄谢坡仙怀二子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题群龙图","author":"王弘诲","text":"吁嗟真龙不可见，人间画龙犹争羡。\n倏忽纵横如有神，咫尺沧溟浮素练。\n俨然耸壑昂青霄，冲波拔浪江天高。\n巉岩同禀至阳粹，峥嵘头角出洪涛。\n一龙翘首扬其鬐，奋身直上拿空虚。\n一龙曳尾出渊沄，回身转脊何逶迤。\n三三两两峙相探，含珠吸水风沙暗。\n是时元气湿濛濛，河海漭沆山泽通。\n禹门天地云雾里，白昼雷霆行地中。\n嗟呼神物变化不可穷，胡为酒酣相视不改容。\n乃知丹青巧为此，潜以翰墨偷天功。\n君不见紫云墨龙绕帝阈，笃生真主符乾祝。\n夜来黄袍军中呼，横戈中原如破竹。\n又不见南阳卧龙起草中，三顾益州隆准公。\n八阵图开扶汉鼎，指挥吴魏分雄雌。\n云龙际会原非偶，攀鳞附翼古来有。\n祇今鱼水幸相逢，天上夔龙自先后。\n我闻好龙称叶公，真龙闻之降其宫。\n近来画者洞微子，神龙现相来相从。\n精诚感通理或有，劝君着意为点瞳。\n会须一夜破壁去，九天霖雨霈苍穹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题御医陈小山墨梅","author":"王弘诲","text":"我闻小山自昔多种杏，何时笔底化为梅。\n兴来肘后试盘礴，千葩万卉同时开。\n始疑大庾分清樾，复讶扬州观中发。\n冷蕊疏疏半带烟，寒梢袅袅时笼月。\n怜予海上梅村人，对此悠然乡思新。\n多病须君惟药物，何期更赠一枝春。\n见说君家世业钱塘口，为问孤山放鹤诗人今在否。\n好将佳句集毫端，一笑檐前酒一斗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟题玄兔应制","author":"王弘诲","text":"窦绘传明视，爰爰意态轻。\n奇毛含水色，异孕吐星精。\n质岂千年变，衣疑六入成。\n匿光蹲桂树，鍊药捣芝茎。\n白露濡蟾魄，苍烟歛玉衡。\n同文符卜筮，存野逐干城。\n献瑞来安阜，驯游入镐京。\n君王今万岁，特此进长生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻砧","author":"王弘诲","text":"秋夜谁家妇，寒砧隔院声。\n含风时断续，带月共悽清。\n乱杵疑无力，传衣独有情。\n单于闻出塞，何日暂休兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日对雪简白甫","author":"王弘诲","text":"一春已过半，六出尚恢恢。\n舞絮疑侵柳，飘花似饯梅。\n冻含娇鸟涩，光妒艳阳回。\n何处堪乘兴，幽兰忆楚才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕宴集","author":"王弘诲","text":"帝里秋开宴，天孙晚渡河。\n共怜今夜雨，偏为别来多。\n落月移妆镜，轻云散绮罗。\n人间与天上，惆怅意如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重登金山","author":"王弘诲","text":"再到金山上，凭栏四望时。\n乾坤留胜迹，岁月感前碑。\n雾雨江天暗，风波去路危。\n急流看勇退，吟眺动深思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋长安感怀","author":"王弘诲","text":"客馆新秋至，空庭一叶飘。\n晚蝉鸣树近，归雁倚空遥。\n乱后乡书断，愁来浊酒销。\n故人多意气，秉烛对深宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自天竺度岭至五云寺询莲池上座不遇","author":"王弘诲","text":"龙宫临水国，鸟道入云萝。\n野旷江湖迥，松深风雨多。\n息心依净域，疲足僵眠窝。\n遥忆东林社，攒眉未易过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"避乱山居即事","author":"王弘诲","text":"驻马山前路，江村事事幽。\n野花开橘柚，林鸟叫軥辀。\n地迥偏宜寂，时和早报秋。\n田家熟鸡黍，劝我数能留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]