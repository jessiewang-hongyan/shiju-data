[{"title":"送史郎中潜回京","author":"曹义","text":"郎官粉署旧儒绅，暂作皇华出使人。\n宝敕才赍来白下，兰舟又棹去通津。\n都亭暑退蝉声急，驿路秋高宦况新。\n此去故交如问及，樗材无补负皇仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠谢参政之任浙江","author":"曹义","text":"久作天官粉署郎，才华烨烨姓名香。\n一朝膺荐归舆论，三秩荣升荷宠光。\n飞檄未曾临白下，欢声先已动钱塘。\n藩垣明到须勤政，他日还期列庙廊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刑部郑亚卿父诞日","author":"曹义","text":"八襄年逾鹤发新，新正人遇降生辰。\n班衣膝下罗儿女，贺客堂前总缙绅。\n玉斝谩斟千日酒，蟠桃喜热一番春。\n亚卿巳受褒封诰，寿算还期过大椿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱御史考绩","author":"曹义","text":"三年报政上金台，祖饯冠缨总俊才。\n别酒江亭须尽醉，促程弦管谩相催。\n绣衣到处霜风凛，画舫行时雪浪开。\n此去应知书最考，天香两袖日边回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题香竹卷为谢亚卿作","author":"曹义","text":"宝树君家旧有名，一盆香竹又天生。\n芬芳不让芝兰臭，馥郁浑同梅菊清。\n凤尾影摇空翠湿，虬枝晴拂瑞烟轻。\n谩将截作伶伦管，吹向虞庭叶凤鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽吏部邹司务祖","author":"曹义","text":"碧落愁云掩少微，鹿门人去事多违。\n白云窗户闲茶灶，绿柳池塘冷钓矶。\n尘世独留清节在，士林空叹故交稀。\n金鹅山下牛眠处，埋玉封高对夕晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题云谷卷","author":"曹义","text":"云谷深沉几许宽，先生于此日盘桓。\n石床影落琴书润，岩壑阴生枕簟寒。\n醉卧松窗春昼永，行吟花径夕阳残。\n也知恤匮多隐德，先世曾闻拜好官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨都宪仲子本道还朝","author":"曹义","text":"使节遥从天上来，轰然声势动春雷。\n腰间剑气冲牛斗，白下衣冠讶俊才。\n客馆才同尊酒会，江亭又见画船开。\n九重到日询民事，为说恩波被草莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小竹","author":"曹义","text":"阴连湘浦晚，翠滴雨声寒。\n莫讶丛生小，终期宿凤鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小扇梅花为吴友赋","author":"曹义","text":"梦里罗浮路，依稀竹外村。\n一枝春色动，清气满乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题扇两人偶坐似清谈者","author":"曹义","text":"不辨宾与主，谁知是与非。\n夕阳相对坐，应是话投机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对雨看晚唐柳中庸江行诗戏和遣兴","author":"曹义","text":"黄芦满汀洲，白雁投江渚。\n何处远归人，征帆带飞雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花扇为双四兄赋","author":"曹义","text":"不踏西湖路，于今又几年。\n清风明月夜，还忆老逋仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"油扇父亲要诗","author":"曹义","text":"畏日作炎蒸，襟怀藉尔清。\n杖藜林木下，几度伴吟行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白扇白梅为思聪赋","author":"曹义","text":"庾岭春初动，孤山雪未消。\n玉人无处觅，风外暗香飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏题小扇诸侄各争先以讨走笔以荅之各回物状形十首 其一","author":"曹义","text":"野树映晴川，舟横古渡烟。\n分携如不忍，相顾意留连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏题小扇诸侄各争先以讨走笔以荅之各回物状形十首 其二","author":"曹义","text":"书屋临江次，波光带树流。\n扣门无俗客，济渡有孤舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏题小扇诸侄各争先以讨走笔以荅之各回物状形十首 其三","author":"曹义","text":"晴峰飞翠霭，烟树隐尘区。\n何处幽闲客，相逢看画图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏题小扇诸侄各争先以讨走笔以荅之各回物状形十首 其四","author":"曹义","text":"云树凌晴汉，书亭俯碧流。\n问津人已远，闲却济川舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏题小扇诸侄各争先以讨走笔以荅之各回物状形十首 其五","author":"曹义","text":"岁晚经湘浦，堪收入画图。\n雪馀凝望处，一片玉模糊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏题小扇诸侄各争先以讨走笔以荅之各回物状形十首 其六","author":"曹义","text":"行藏随所遇，用处绝欹尘。\n若问平生伴，清风是故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏题小扇诸侄各争先以讨走笔以荅之各回物状形十首 其七","author":"曹义","text":"扶策出林坰，同行畅野情。\n依依重回首，相似听泉声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏题小扇诸侄各争先以讨走笔以荅之各回物状形十首 其八","author":"曹义","text":"林密鸟声柔，山深云影浮。\n若人爱清致，扫石对溪流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏题小扇诸侄各争先以讨走笔以荅之各回物状形十首 其九","author":"曹义","text":"云壑森烟树，扁舟钓夕阳。\n平生谁是侣，鸥鹭日徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32468,"sha256":"ed4816f919f