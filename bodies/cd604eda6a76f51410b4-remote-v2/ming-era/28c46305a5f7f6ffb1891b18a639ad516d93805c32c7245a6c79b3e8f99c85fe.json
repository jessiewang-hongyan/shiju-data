d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹧鸪","author":"罗亨信","text":"斑斑文羽类山鸡，曾记诗人旧品题。\n春暖平原生育盛，碧坡芳草任依栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸲鹆","author":"罗亨信","text":"丹荔生香弄色深，飞来抛掷铁衣禽。\n江南地暖栖虽稳，何似翱翔向上林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白头","author":"罗亨信","text":"雨熟林擒半压枝，白头回首立多时。\n生来自有山翁态，不羡珍禽学画眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51048,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山狐","author":"罗亨信","text":"桃腮抹粉带轻红，山鸟调音向晓风。\n忆昔登龙桥上过，间关曾听语雕笼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51049,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画四景 其一 春景","author":"罗亨信","text":"青山隐隐白云深，溪上茅堂古木阴。\n阅罢残编清坐久，数声啼鸟隔幽林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51050,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画四景 其二 夏景","author":"罗亨信","text":"乔松耸翠绿阴浓，仙客携琴策短筇。\n欲访知音何处是，楼台远在碧云中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51051,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画四景 其三 秋景","author":"罗亨信","text":"风气萧森柳叶黄，倚阑极目海天长。\n白云飞处亲庭在，缩地何由到故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51052,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画四景 其四 冬景","author":"罗亨信","text":"笑撒丝纶百尺轻，偶逢樵父话生平。\n忘机不觉归来晚，独棹孤舟载月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51053,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题平沙落雁图","author":"罗亨信","text":"霜入枫林叶半秋，几行征雁落荒洲。\n殷勤带得平胡信，玉塞参军未白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51054,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题兰蕙同芳图","author":"罗亨信","text":"兰蕙依依并吐芳，风来庭砌散幽香。\n君家兄弟端堪比，祚胤应期百世昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51055,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画赠晏千户","author":"罗亨信","text":"苍茫山色映书楼，论史谈经日未休。\n见说禹门春浪暖，好期变化勿淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51056,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画寄邬玄中","author":"罗亨信","text":"石榴雨绽珍珠颗，山鸟风梳翡翠翎。\n遥忆故人千里外，画图聊寄别离情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题竹寄邬玄中","author":"罗亨信","text":"种得潇湘玉数竿，朝回几度倚阑看。\n仙翁别后平安否，写赠应期共岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题墨梅寄邬玄中二首 其一","author":"罗亨信","text":"罗浮仙子美丰姿，历尽风尘染不淄。\n倩得陈玄图玉貌，题封远慰故人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题墨梅寄邬玄中二首 其二","author":"罗亨信","text":"不随桃李媚春风，独抱幽贞誓始终。\n岁晏天寒无伴侣，令人却忆赵师雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题少保黄先生赠孙教授竹","author":"罗亨信","text":"广文离思浩难禁，少保乡情似海深。\n为赠凌云丹凤羽，相期永感岁寒心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题大理丞李奎双喜","author":"罗亨信","text":"朝罢归来日未斜，庭前灵鸟噪喳喳。\n新恩应自天边至，吉兆先将报主家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题墨梅写怀","author":"罗亨信","text":"玉骨冰肌铁石肠，相逢几度月昏黄。\n别来京国无知己，独抱孤贞傲雪霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梅月双清","author":"罗亨信","text":"罗浮仙子美丰姿，铁石心肠只自知。\n今夜月明谁是伴，嫦娥端可共襟期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题春草","author":"罗亨信","text":"薤叶青青间缘莎，争妍竞秀满平坡。\n春深不改蒙茸色，自是恩承雨露多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51065,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画莺","author":"罗亨信","text":"簪笔当年侍玉京，掖园屡听晓莺声。\n归来乡国看图画，无限心情在凤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画虎头","author":"罗亨信","text":"健笔伊谁写虎头，风生林壑气如秋。\n将军伟貌人争讶，伫睹荣封万里侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题安晚轩","author":"罗亨信","text":"将军素志在林丘，壮盛先为晚节谋。\n衣锦好看归去日，重开三径乐优游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题栖竹轩","author":"罗亨信","text":"筑亭来伴碧琅玕，苦节清修傲岁寒。\n好截伶伦双凤管，月明吹向彩云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明日云中分院偶成","author":"罗亨信","text":"清明节届日迟迟，三叠绵衣体不离。\n岭表此时摇画扇，桑乾河水尚流澌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答同年翟彦荣所寄韵","author":"罗亨信","text":"坐把南山翠作堆，故人别去重徘徊。\n同年交好情偏厚，时寄新吟慰客怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"依陈副都所寄韵三首 其一","author":"罗亨信","text":"驱驰遐峤雨经春，晓镜惊看白发新。\n独羡内台贤执宰，抚安深慰陇西人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"依陈副都所寄韵三首 其二","author":"罗亨信","text":"别后悠悠叹暌违，帝乡何日共言归。\n臂翰不到长安道，赋罢停云思欲飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"依陈副都所寄韵三首 其三","author":"罗亨信","text":"执法由来映列星，远持玉节镇边城。\n尽看霖雨回枯槁，不负仁皇付托情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和靖观梅","author":"罗亨信","text":"瑞叶飞花玉作林，幽香寒逼似难禁。\n举杯为赠孤山叟，底事凭阑苦独吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕","author":"罗亨信","text":"泪痕如雨恨如丝，肠断银河欲渡时。\n儿女不知离别事，只言今夕是佳期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"琼州茉莉轩","author":"王克义","text":"游客凭栏趣最宜，构轩兀坐看花枝。\n含英沁露微醺际，吐卉当风送馥诗。\n蓓蕾似于邪党妒，清香偏与正人期。\n繁华眼界空千里，茂叔渊明怎得知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓬莱春晓歌","author":"王克义","text":"碧云初散扶桑树，六龙已驾羲和驭。\n海上神山晓色分，琪花瑶草湿香雾。\n双双彩凤栖梧桐，嗈嗈相应朝阳东。\n四海苍生尽苏息，万国如在春风中。\n忆得当年来上国，棘围鏖战文场屋。\n琼林宴罢醉扶归，不让当时步瀛客。\n厥来出宰十八年，于今捧诏还朝天。\n上林春色正明媚，百花灿烂争芳妍。\n自喜生逢尧舜世，愧乏涓埃酬圣帝。\n吟咏非才丹泪垂，强作狂歌歌舜治。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游七星岩","author":"阮惟良","text":"偷閒閒步上星岩，去去清风捲客衫。\n万丈烟霞归眼界，一重门洞又机缄。\n高低石磴仙留迹，红紫奇花鸟乱衔。\n醉把茅龙题翠壁，白云玄鹤满松杉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阙题","author":"苏聪","text":"故乡逢胜地，一岁几登临。\n云物空来去，山川自古今。\n涛惊霢霂雨，鸟乱夕阳音。\n坐得禅中趣，幽怀不可任。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其九","author":"郑义","text":"天工剪雪作花神，案上枝头雅态真。\n六出省裁成五出，古人题品到今人。\n黄须酿作蜂腰蜡，素质难沾马足尘。\n定有香魂游禁苑，因风点作寿阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花百咏 其六十九","author":"郑义","text":"逋翁得句有诗神，坡老情缘讽咏真。\n百岁芳名千古树，满天清气一閒人。\n梁园对雪谁知己，洛浦淩波迥出尘。\n且赋新诗如作画，分明笔底暗生春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夜泊淮安","author":"陈英弼","text":"中秋良夜泊淮壖，露冷风清月满船。\n千古共传今夕好，一年争似此时圆。\n桂枝看冷蟾宫近，玉宇云消宝镜悬。\n好景独怜空自负，蓬窗攲枕且高眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄蚝冈彭先生","author":"陈英弼","text":"蚝冈冈畔草堂深，办亩方塘绕竹阴。\n座上清风生玉麈，涧边流水杂瑶琴。\n芳樽自得閒中乐，佳句尝从醉里吟。\n笑我宦游淹岁月，江湖赢得雪盈簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠戴竹林","author":"王德宾","text":"茅屋依山石径斜，卜邻只是两三家。\n门迎橘柚朝含雨，院拥桑榆晚带霞。\n耕凿有方铭屋壁，干求无策记窗纱。\n轩南隙地如分我，共学东陵老种瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠戴竹林","author":"陈良弼","text":"玉井峰前种紫芝，日偕君子话襟期。\n身閒赢得心如水，岁晚宁辞鬓似丝。\n架满琴书鸣夜烛，庭森荆桂丽春晖。\n芹羹鲫脍葡萄酒，每向良朋一解颐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游罗浮","author":"李亨","text":"二山合璧耸层霄，此日登临眼界饶。\n树色苍茫如罨画，泉声清亮似鸣韶。\n麻姑峰外琼为馆，织女河边铁作桥。\n未服神丹蜕凡骨，此生尘虑已都销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃源洞","author":"李亨","text":"流水桃花出洞香，通津不用问渔郎。\n采芝昔有秦人隐，歌凤今无楚客狂。\n鹤舞霓裳供逸兴，鹿衔山果荐仙觞。\n也知此地堪游乐，刘阮何须到异乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花村","author":"李亨","text":"向日曾游大庾岭，今朝喜到梅花村。\n梅花几树山下发，翠羽数声林外喧。\n师雄曾入黄粱梦，宋玉难招白雪魂。\n最是晚凉多逸兴，水寒烟淡月黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游罗浮","author":"李亨","text":"独上罗浮第一峰，眼前胜概浩无穷。\n东瀛海岛微茫外，南粤山川指顾中。\n采药客归仙鹤舞，烧丹人去石楼空。\n凭高两腋轻风起，便欲飘然访葛洪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"罗浮山 其一","author":"李亨","text":"十二芙蓉天作开，烟霞净裹翠成堆。\n鹿衔花向林边过，龙带云从树杪来。\n最爱壶中开日月，何须海上访蓬莱。\n翛然自觉清毛骨，直欲凌风溯上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"罗浮山 其二","author":"李亨","text":"危峰削壁郁岧峣，贝阕珠宫隐泬寥。\n月映梅花来素女，风鸣松桧奏仙韶。\n高吟只恐惊银汉，扶醉还能度铁桥。\n闻道蟠桃今已熟，定应青鸟远相招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题莫状元祠","author":"蒙端","text":"莫道封川千仞山，状元风采有谁班。\n天边月桂年年在，不是神仙孰敢攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌石潭","author":"彭森","text":"倚棹江边日欲沉，帝乡翘首五云深。\n多情独有中天月，照见寒潭与我心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石镜","author":"谭寿海","text":"一拳水石傍山隈，好似菱花一样开。\n万古地天为玉匣，千寻山岳作瑶台。\n清光不受淄尘涅，古意任教苍藓陪。\n不用世间勤拂拭，倬然云汉自昭回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"按滇南怀锦江旧业 其一","author":"陈鼎","text":"青骢嘶出岳阳城，万里风帆过洞庭。\n两岸晓烟应自散，满江春浪若为平。\n行云有意随天白，芳草无情到处青。\n我有离愁千万斛，凭谁寄语入新兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"按滇南怀锦江旧业 其二","author":"陈鼎","text":"家住城南锦水堤，白沙翠竹绕柴扉。\n芭蕉叶底藏春色，荔子枝头带夕晖。\n惆怅几回频入梦，寂寥千里但思归。\n不知我种门前柳，长大于今几尺围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新兴杂咏晚枫霞洞","author":"严贞","text":"漠漠平林减翠容，夕阳西照树生红。\n归鸦乱点山前日，飞鸟横冲汉外风。\n宦况尽随秋色淡，人心不似野情浓。\n村翁三五浑无事，共坐松阴说岁丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阙题","author":"赵纯","text":"持节南巡过峡山，停舟聊尔一跻攀。\n千岩岚气浮苍碧，万壑松风响佩环。\n梵刹静涵江树迥，禅扉深锁白云间。\n漫题不尽登临兴，翘首京华咫尺间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游虎邱山","author":"梁本","text":"胜日寻芳到虎邱，踏春艳冶赛风流。\n金貂侠客悲遗迹，翠袖游人簇绣毬。\n芳草萋萋歌舞地，长江浩浩帝王州。\n兴亡今昔何须问，且向樽前数刻留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]