[{"title":"题鹅溪书屋","author":"林光","text":"曾向鹅湖着两眸，鹅溪书屋又谁修。\n频年未了惟诗债，尽日堪看是活流。\n庭草翠深空阁雨，梦魂凉浸碧山秋。\n瘦筇莫厌溪桥僻，朝市尘氛易白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉别徐郡侯怀柏先生考绩之京","author":"林光","text":"老我行藏欲话难，先生麾节别吴?。\n风云会处声光远，势分忘来礼数宽。\n预有忠勤书最绩，尚留恩意及卑官。\n支离不敢秋江饯，却把诗篇写肺肝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿大乘寺","author":"林光","text":"招提昨梦应延我，舴艋今朝却为谁。\n松桧形容犹未改，梅花消息尚堪疑。\n尘庵寂静偏宜睡，僧榻跏趺忽有诗。\n烧罢黄龙香一线，佛前灯影照琉璃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟张泾汇示诸生","author":"林光","text":"苍田红树入霜天，独立船头思渺然。\n诸子欲谙云水性，试留双眼看晴川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁未平湖重九日","author":"林光","text":"村醪何处亦堪赊，天宇初晴景最佳。\n黄菊未开重九节，老夫惟对木犀花。\n狂挥秃笔诗盈纸，步遍青莎月满衙。\n却忆去年今日酒，滥陪骢马醉元沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重九叠韵改犬子时表稿","author":"林光","text":"重阳无酒亦须赊，此夕烟云景最佳。\n篱菊乍开今日眼，木犀犹放晚秋花。\n闲观宇宙逢双鬓，指点风光坐一衙。\n不识江门今日酒，许谁同醉白鸥沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"景庵","author":"林光","text":"名题金榜桐乡令，何处烟云寄此庵。\n六一风流真可慕，端溪山水果无惭。\n瘦筇短履何曾厌，怪石奇岩自错参。\n识破利名关是梦，振衣归去面澄潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别李邑宰","author":"林光","text":"我笑思归未得归，君今先我上渔矶。\n韭芽香嫩供春饼，桑枣林疏步夕晖。\n拍拍千杯延杂剧，酣酣一枕饫轻肥。\n三竿日上门犹闭，懒与儿曹管是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"林居鲁人京过槜李往饯不遇留此识别","author":"林光","text":"春风过眼又芳菲，斗酒追寻愿适违。\n优诏迁官君合处，衰年多病我须归。\n新蒲细柳皆诗料，淡雾浓云信笔挥。\n白首相期还洗耳，何曾卧病泣牛衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题周文郁暴日台","author":"林光","text":"剪棘诛茅次第修，百年身计此中收。\n见成好饭能供子，入望高人正倚楼。\n炙背三冬仍傍母，蒙头一枕胜封侯。\n莫嫌幽僻东涌地，且看南溟昼夜流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侍御袁德纯挽三首 其一","author":"林光","text":"昨暮长风送客悲，满庭飞霰杂忧疑。\n谁催侍御归长夜，欲叫苍天一问之。\n垂老真诚君未改，到头青白我能知。\n豺狼未殄身先殒，应有高人解勒碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侍御袁德纯挽三首 其二","author":"林光","text":"徒传岭海净妖氛，搔首西风哭暮云。\n二十年来心共照，三千里外讣初闻。\n君明大义曾期我，我有狂言亦嘱君。\n掩抑乌台他日意，几时和泪滴孤坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"侍御袁德纯挽三首 其三","author":"林光","text":"西屯幽壤可曾扃，又报龙川坠德星。\n浮世尘头偏易白，皇天老眼为谁青。\n愁生瘴海风声改，梦断乌台雨泪零。\n不独岭南公论在，太平人口是碑铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻有上荐剡者","author":"林光","text":"微官成懒散，荐剡孰开陈。\n亨泰逢清世，支离笑病身。\n双眸回宇宙，千载几君臣。\n舒卷床头易，空庭草自春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读冬曹林居鲁荐疏有感","author":"林光","text":"贫贪微禄养，辗转未能归。\n经史频留眼，行藏愧炳几。\n春回花自笑，天远鹤孤飞。\n读罢虞衡疏，林风荡葛衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽林从信佥宪","author":"林光","text":"八壶山下信多贤，何处泷冈觅旧阡。\n夜月啼乌仙有疏，春风南国士无缘。\n难将拙笔描真像，欲置生刍到墓前。\n莫问百年修短事，凤毛霄汉正翩翩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"福源寺偶赋","author":"林光","text":"不嫌荒寂南禅寺，斜日肩舆偶独来。\n古树迎人僧径僻，秋光如水稻花开。\n寻常薄酒留真偈，三两青衿恰侍陪。\n识破华严无一字，更容何物入灵台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题包翁双庆卷","author":"林光","text":"人间称意事难逢，六十年来却受封。\n甲子又添新日月，乌纱聊饰旧形容。\n间寻二仲开醇酎，笑引诸孙弄瘦筇。\n李径桃溪春似海，更留青眼看长松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郡守沈元节招饮当湖和沈刚夫秀才","author":"林光","text":"笑把当湖作故乡，话投诸阮总贤良。\n氤氲春色催人醉，夹杂汀花入酒香。\n几许扁舟来我辈，满前生意为谁芳。\n湖南一点星浮水，安得层楼揖太阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"德藏寺和嘉兴徐郡守题壁 其一","author":"林光","text":"佛子阶除处处幽，一凉如水入深秋。\n林花欲放堪浇酒，身事无端更倚楼。\n青草蒙茸随雨化，白云缥缈自天游。\n蒲团试问安禅老，可识人间半点愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"德藏寺和嘉兴徐郡守题壁 其二","author":"林光","text":"法镜留将法眼观，松风细细动波澜。\n僧床佛阁聊供睡，龙马图书掩不看。\n杯饭寻常忘我老，匣琴容易向谁弹。\n知心却有东篱菊，不择先生是小官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋当湖文庙赏月","author":"林光","text":"平分秋一半，步入圣宫墙。\n心照中天月，杯衔碧玉浆。\n木犀熏湛露，蟾阙晕祥光。\n羽化疑今夕，飘然上彼苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿湖隐方翁","author":"林光","text":"科头向南亩，七十四回春。\n不信乌纱帽，能荣白发人。\n稻苗看正熟，村酒酿来醇。\n又见诸孙子，幽居各买邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏题当湖山月池","author":"林光","text":"他时谁捧土，蕞尔便名山。\n陈迹浮烟没，先生一笑看。\n雨馀蛙吹满，秋霁鹤忘还。\n却有当湖月，频过水石间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游德藏寺四首 其一","author":"林光","text":"频年来德藏，莫发老夫诗。\n秋兴乘今日，禅林索旧碑。\n荒池空偃月，杂树屈虬枝。\n欲话无生事，圆机却是谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游德藏寺四首 其二","author":"林光","text":"好景多魔在，僧贫寺半荒。\n径深蒿艾密，墙矮薜萝长。\n僻地成痴坐，秋林正夕阳。\n难穷清气味，一瓣广南香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游德藏寺四首 其三","author":"林光","text":"缓缓纡吟步，青莎叠砌间。\n官无文案累，身似老僧间。\n蝉奏冬青树，云藏薜荔关。\n心源端解了，何处觅深山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游德藏寺四首 其四","author":"林光","text":"大隐留斯地，喧中寂本佳。\n雨肥苍耳色，秋老决明芽。\n佛了三生幻，僧防一念差。\n经函千万卷，苦海浩无涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛当湖八首 其一","author":"林光","text":"青青湖畔草，泛泛波中鸟。\n杯酒入烟云，断隔秋天杳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛当湖八首 其二","author":"林光","text":"闲持一杯酒，移艇傍疏竹。\n白鸟忽飞来，湖田雨初足。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛当湖八首 其三","author":"林光","text":"数声采莲歌，秋波杳如海。\n不遇种莲人，安得莲堪采。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛当湖八首 其四","author":"林光","text":"湖水荡渔舟，渔舟戏湖水。\n烟波日相寻，何时清见底。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛当湖八首 其五","author":"林光","text":"白雨乱跌珠，汀云散还聚。\n凫鹥出菰蒲，迎船飞故故。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛当湖八首 其六","author":"林光","text":"迟迟游子舟，点点波心雨。\n沿流入回溪，坐当秋竹舞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛当湖八首 其七","author":"林光","text":"烟火几渔家，边湖夹疏树。\n扁舟三五人，坐入秋天暮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛当湖八首 其八","author":"林光","text":"细雨洒深竹，轻烟罩孤屿。\n倏然坐迟暮，欲语不能语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自庆五十和顾能见赠五首 其一","author":"林光","text":"百年今已半，天与一官闲。\n名忝师生分，恩同骨肉间。\n黄花亲寿斝，歌鸟祝南山。\n老负斯文托，如今更厚颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自庆五十和顾能见赠五首 其二","author":"林光","text":"百年今已半，宏治适时雍。\n岂厌儒官小，均陶大化中。\n乾坤春未老，鱼鸟思何穷。\n圆转天机活，吾今亦尚同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自庆五十和顾能见赠五首 其三","author":"林光","text":"百年今已半，天意苦栽培。\n地僻人过少，春深花自开。\n光韬云里月，香淡雪中梅。\n此意神仙会，王乔鹤不来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自庆五十和顾能见赠五首 其四","author":"林光","text":"百年今已半，身外总浮云。\n开径延三益，飞觞醉十分。\n皇天回斗柄，南极照斯文。\n无限难言意，逢君欲告君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自庆五十和顾能见赠五首 其五","author":"林光","text":"百年今已半，更作万年期。\n且了男儿事，宁求举世知。\n秋林初返照，篱菊正开时。\n满引杯中酒，还吟自庆诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶述三首 其一","author":"林光","text":"木犀香亚几枝低，尽日花边坐欲迷。\n何处棹歌声转急，缓寻幽草更前溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶述三首 其二","author":"林光","text":"乘田委吏不辞低，五百年来几醒迷。\n一脉还寻洙泗水，异香流处是曹溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶述三首 其三","author":"林光","text":"坐入深更月向低，天灵一点照群迷。\n何人不奈秋光好，时送歌声过北溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题两浙旬宣卷","author":"林光","text":"天心仁爱圣明朝，阴沴频年未尽消。\n眼底名藩参浙水，马前春意遍童谣。\n潜鳞涸辙需甘泽，赤子穷檐望使轺。\n何处覆盆光未照，紫薇花下更逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕自勉","author":"林光","text":"我来当湖滨，坐阅五除夕。\n年光倏流电，半百过瞬息。\n俛仰畴昔时，抚景恒自惜。\n遑遑若追忘，万里摇鞭策。\n圣途虽云远，壮心如铁石。\n仰钻日复日，寸累仍铢积。\n晨飧未及饱，夕寝宁安席。\n云胡远今时，自恕还自适。\n颓颜无复少，短发日向白。\n天衢浩无涯，进寸殊退尺。\n古来圣贤人，未免遭穷厄。\n顾肯当尘途，掷此千片璧。\n念我意中人，耿耿明寸赤。\n持此一杯酒，自讼还自责。\n丈夫志千古，讵忍为形役。\n百年能几时，逆旅栖过客。\n煌煌照红烛，感此岁除迫。\n杳然兴遐思，四顾樊笼窄。\n晴露有佳花，狂风无健翮。\n俭德勤自修，舒卷床头易。\n乾坤重担子，知上谁肩脊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉寄彭从吾亚卿乞致仕养亲","author":"林光","text":"曾持寸赤达公文，允领微官本为贫。\n七十年馀慈侍下，三千里外梦归频。\n遗羹直欲尝君食，刻木何如事活身。\n九万谁云天听远，海滨今日遇名臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铁佛寺次夏大卿见赠韵","author":"林光","text":"来过铁佛寺，风雨半旬馀。\n僧阁鸣琴籁，蜗牛走篆书。\n云霞双眼在，天地一舟虚。\n未尽他年语，还寻长者庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓铁佛寺时奉藩檄总修两浙实录","author":"林光","text":"佛子轩窗隔翠微，微官何地更相宜。\n梅花月照杯传处，坞竹烟深履步时。\n闲里风光描不尽，静中鱼鸟看成痴。\n凡才未悟春秋旨，却与名藩管是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"承彭亚卿从吾顾纂修局","author":"林光","text":"节声恬不到云隈，松径肩舆忽一来。\n尽日喜闻经济话，如今真识栋梁材。\n僧厨也解供蔬食，属吏何妨捧酒杯。\n燕语莺啼春似海，百花犹待几时开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"承陈谢二侍御顾纂修局","author":"林光","text":"松桧森罗一径斜，绣衣联辔入烟霞。\n尽教春意回枯槁，未遣秋霜着早花。\n喜傍云山开眼孔，细烹泉乳泛茶芽。\n僧轩半晌非容易，无限风光被物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵张太守述怀见寄三首 其一","author":"林光","text":"史馆依僧寺，三春谢市嚣。\n翻然来好句，端足慰无聊。\n济世君心赤，贪山我兴饶。\n崇卑各有分，期不负当朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵张太守述怀见寄三首 其二","author":"林光","text":"万虑日忉忉，偏能变二毛。\n闲官聊自适，大冶任甄陶。\n千里寄非小，诸侯位本高。\n云龙终有会，应不续离骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵张太守述怀见寄三首 其三","author":"林光","text":"小荷擎雨盖，正是夏初时。\n日日看云脚，行行傍野池。\n花前聊引酌，兴在辄题诗。\n无限悠然意，升沈问不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹间偶赋","author":"林光","text":"春去禅林绿已肥，竹间杯酒亦相宜。\n漆园本是逃名吏，懒向琅玕刻小诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铁佛寺偶成","author":"林光","text":"三径五径疏竹，千株万株乔松。\n游子贪看铁佛，忘却南北高峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游南屏偶题雨庵卷","author":"林光","text":"君庵偏爱雨，我却喜晴来。\n晴雨休相泥，朱颜一笑开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴方伯入京","author":"林光","text":"宿雨尘途洗更清，恰逢方伯入神京。\n千年共祝今明圣，四海欢呼颂太平。\n流水有情催画鹢，青山无数导霓旌。\n微官久在春风里，不用临期叙别情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游西湖二首 其一","author":"林光","text":"眼傍西湖忽有诗，湖山应讶我来迟。\n十年倏尔成何事，一笑茫然似故知。\n细柳新莺迎画舫，丹楼碧阁漾清漪。\n凭谁为秉王维笔，貌出闲官酩酊时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游西湖二首 其二","author":"林光","text":"千首西湖合与诗，东风花信任迟迟。\n陶然云水三春意，似有凫鸥几个知。\n镜面湖光含曙色，佛头山子醮清漪。\n何能卜筑孤山下，一日频游十二时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游虎跑寺二首 其一","author":"林光","text":"尘鞅无缘脱俗羁，肩舆一笑任行迟。\n绿肥晴日浮光晕，凉淡晨烟罩碧漪。\n泉韵又添今日兴，松阴犹记昔年诗。\n繁花过眼开还落，只有青山似旧时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游虎跑寺二首 其二","author":"林光","text":"骏骨从来不受羁，蹉跎真愧烛几迟。\n松风尚忆吹残梦，泉影还看弄碧漪。\n涧鸟静听游子语，林僧争乞老夫诗。\n摩挲松径寻碑迹，却忆东坡抚掌时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"涵碧亭为陈侍御","author":"林光","text":"边池亭子构来新，水色山光入梦频。\n伯氏闲情呼仲氏，后人高致绍前人。\n春随鱼鸟看何厌，景幕烟霞写未真。\n惟问三山贤柱史，几时凭槛看丝纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"楚使来聘二首 其一","author":"林光","text":"斯文衡鉴愧多贤，云水天催未了缘。\n衡岳风光劳梦想，洞庭秋色可谁专。\n直期心醉千山景，不用诗留万口传。\n何处明珠偏照乘，试留吾网白重渊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"楚使来聘二首 其二","author":"林光","text":"三千里外币书来，老眼湖南又一开。\n游走自知山有债，搜求谁道世无才。\n微官薄禄终何补，大地名花本欲栽。\n半幅秋帆乘远兴，洞庭江汉梦相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿严州天宁寺 其一","author":"林光","text":"官閒我亦何拘碍，又向天宁一借眠。\n风雨净除三伏暑，梦魂凉浸万山烟。\n窗临木杪宜仙枕，地隔溪流断俗缘。\n寄语频游严少府，几人参破野狐禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿严州天宁寺 其二","author":"林光","text":"浮生半日閒难得，已借僧床十日眠。\n建茗几烹严子濑，牙香初散富春烟。\n诸侯传食端堪愧，山水嬉游是夙缘。\n杯酒未将疑老衲，醉中元亦有真禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":51657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]