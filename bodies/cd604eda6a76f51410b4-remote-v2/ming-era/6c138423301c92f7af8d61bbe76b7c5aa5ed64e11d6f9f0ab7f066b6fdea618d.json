[{"title":"宫词一百七首（录七十首） 其五","author":"宁献王","text":"宵旰常存为国心，大庭决政每亲临。\n退朝镇日凭绨几，御笔常书丹扆箴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18158,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其六","author":"宁献王","text":"天鸡初报五更筹，万户帘旌控玉钩。\n合殿报传妃子过，御香先到凤墀头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18159,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其七","author":"宁献王","text":"银潢斗转挂疏棂，翡翠窗纱夜未扃。\n三弄琴声弹大雅，一帘明月到中庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18160,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其八","author":"宁献王","text":"忽闻天外玉箫声，花下听来独自行。\n三十六宫秋一色，不知何处月偏明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18161,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其九","author":"宁献王","text":"钧天迭奏昆明池，桃花春暖鱼龙嬉。\n残妆洗作胭脂水，流出宫墙污燕泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18162,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其十","author":"宁献王","text":"十二银屏十二峰，一峰一个绣芙蓉。\n东风吹醒阳台梦，人在珠帘第几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18163,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其十一","author":"宁献王","text":"宫花著雨渐应稀，柳絮因风不肯飞。\n恰似太真春睡重，玉容娇惰不胜衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18164,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其十二","author":"宁献王","text":"昨夜梅花漏蚤春，和香和月弄精神。\n休教玉笛三更奏，惊起含章梦里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18165,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其十三","author":"宁献王","text":"暖日烘晴淑气嘉，春风先发上林花。\n莺朋燕友时相得，似识东城帝子家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18166,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其十四","author":"宁献王","text":"霁天旭日敞金扉，和气氤氲满禁闱。\n宝殿昼长帘幕静，牡丹花下蝶交飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18167,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其十五","author":"宁献王","text":"翡翠空间云母屏，宫娥夜坐数流萤。\n月华淡淡清无暑，笑把瑶笙学凤鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18168,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其十六","author":"宁献王","text":"太液池中翻翠荷，小娃学唱采莲歌。\n画船不系垂杨下，尽日随风漾碧波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18169,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其十七","author":"宁献王","text":"一点芳心足未休，两般心事上眉头。\n杨花不逐风前舞，偏趁游丝系旧愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18170,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其十八","author":"宁献王","text":"溶溶庭院梨花月，风静时闻笑语妍。\n今夜婕妤犹带酒，秋千蹴破柳间烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18171,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其十九","author":"宁献王","text":"宝妆蝉鬓亸金翘，露下铜盘月影遥。\n春思逼人眠未稳，閒开棋局度清宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18172,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其二十","author":"宁献王","text":"秋来处处捣衣声，小院梧桐月正明。\n促织絮寒霜气白，隔墙谁弄紫鸾笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18173,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其二十一","author":"宁献王","text":"学画娥眉弄晚妆，娇羞无语暗思量。\n新来未识龙颜面，偷揭珠帘看上皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18174,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其二十二","author":"宁献王","text":"镇日无人独掩门，梨花月上又黄昏。\n空余孤枕不成寐，拨碎琵琶弹泪痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18175,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其二十三","author":"宁献王","text":"曲阑开遍紫薇花，晓日曈昽映彩霞。\n几处笙歌鸣别院，不知圣御在谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18176,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其二十四","author":"宁献王","text":"玉阑干外木犀开，应是西风昨夜来。\n宫女不知清露重，折花偷插凤凰钗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18177,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其二十五","author":"宁献王","text":"海棠亭上月华明，一夜东风酒半酲。\n隔帘鹦鹉学人语，恰似君王唤小名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18178,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其二十六","author":"宁献王","text":"屈指颦眉叹岁华，总将心事付琵琶。\n不堪弹到关心处，蝴蝶双飞上鬓花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18179,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其二十七","author":"宁献王","text":"庭梧秋薄夜生寒，谁把箜篌别调弹。\n睡觉满身花影乱，池塘风定月团团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18180,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其二十八","author":"宁献王","text":"小院飞花春昼长，竹阴移午上琴床。\n等闲不鼓《求凰操》，怕使六宫人断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18181,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其二十九","author":"宁献王","text":"自蒙君宠到昭阳，衣袖犹闻宝串香。\n半倚朱门久凝睇，和愁和月待昏黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18182,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其三十","author":"宁献王","text":"深院日长瑶草生，重门不见幸车行。\n落花为怨东风急，一夜春归到帝京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18183,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其三十一","author":"宁献王","text":"柳色偏承雨露恩，也将青眼暗窥人。\n可怜不解东风意，仍把柔条绾旧春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18184,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其三十二","author":"宁献王","text":"杏雨纷纷满径迷，穿帘燕补落花泥。\n衔将春色归巢去，辜负莺儿枝上啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18185,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其三十三","author":"宁献王","text":"自入长安帝子家，一年一见紫薇花。\n花开花落年年事，不管愁人鬓又华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18186,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其三十四","author":"宁献王","text":"拥衾欹枕暗伤心，起坐窗前弄玉琴。\n曾使君王痛怜惜，曲中犹写《白头吟》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18187,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其三十五","author":"宁献王","text":"重重帘幕掩流苏，花下相携倒玉壶。\n报道停斟半含醉，踉跄起舞倩人扶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18188,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其三十六","author":"宁献王","text":"寒蝉泣露曳秋声，杨柳枝头淡月明。\n半掩笼门怕关上，今宵犹恐幸车行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18189,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其三十七","author":"宁献王","text":"池塘骤雨打新荷，点点如珠似泪多。\n纵把金针穿不得，几回搔首奈愁何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18190,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其三十八","author":"宁献王","text":"夜半兰房春守宫，龙膏香浥紫金筒。\n封绡一点春无已，几度花开不减红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18191,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其三十九","author":"宁献王","text":"素梅有意为谁香，故出宫墙作淡妆。\n昨夜梦魂清入骨，觉来斜月到椒房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18192,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其四十","author":"宁献王","text":"幽花竹下自芬芳，旋摘琼葩带露香。\n收拾风光妒春色，六宫从此学新妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18193,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其四十一","author":"宁献王","text":"庭树团团作翠阴，夜凉清话坐更深。\n无端感起闲愁思，弹到梅花月满琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18194,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其四十二","author":"宁献王","text":"魫鱼窗冷夜迢迢，海峤云飞月色遥。\n宫漏已沉参倒影，美人犹自学吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18195,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其四十三","author":"宁献王","text":"懒把金针绣凤凰，睡窗绒缕暗留香。\n支颐半晌心如醉，倚遍阑干待晚妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18196,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其四十四","author":"宁献王","text":"彩胜双双斗凤钗，薄罗金缕燕花牌。\n宫中先得阳和气，知是春从天上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18197,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其四十五","author":"宁献王","text":"重帘不卷下琼钩，户户迎风雪打头。\n时有笑声来别院，故知宫女笑藏阄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18198,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其四十六","author":"宁献王","text":"一夜瑶花满禁阶，晓来旭日映西斋。\n宫人团雪作狮子，笑把冰簪当玉钗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18199,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其四十七","author":"宁献王","text":"歌扇金书御制诗，桃花风软鹧鸪枝。\n舞回体态娇无力，绝胜当年唤雪儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18200,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其四十八","author":"宁献王","text":"金碧团屏面面开，琴书盈几列平台。\n晚凉偷把琼箫弄，忽报銮舆圣驾来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18201,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其四十九","author":"宁献王","text":"雕檐蟾魄度罘罳，蛛网呈祥坠喜丝。\n知是昭阳有恩泽，灯花昨夜结红芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18202,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其五十","author":"宁献王","text":"寒蛩唧唧草间鸣，唤出新秋无限情。\n霜露满天红叶老，有人愁听捣衣声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18203,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其五十一","author":"宁献王","text":"旋研花露试新妆，惹得游蜂上下狂。\n羞把香纨扑蝴蝶，对人佯整薄罗裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18204,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其五十二","author":"宁献王","text":"一自承恩入建章，为怜妾貌侍君王。\n殿头自此书名字，日日联班近御床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18205,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其五十三","author":"宁献王","text":"新选昭仪进御来，女官争簇上平台。\n宫中未识他名姓，都把花名作字猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18206,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其五十四","author":"宁献王","text":"宫女新传御制词，人人争唱斗歌时。\n娇嗔不识伊州谱，错把腔儿念作诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18207,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其五十五","author":"宁献王","text":"小立东风半掩门，杨花扑面也亲人。\n妾心已作沾泥絮，不化浮萍到水滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18208,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其五十六","author":"宁献王","text":"银汉沉沉玉漏迟，一钩斜月上花枝。\n恰似徐熙新扇面，美人欢笑共题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18209,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其五十七","author":"宁献王","text":"寂寂重门夜泬寥，天风时送御香飘。\n三十六宫秋月白，美人花下教吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18210,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其五十八","author":"宁献王","text":"赴宴归来酒正酣，半嗔半喜又羞惭。\n向人佯笑不成语，推卷罗衫理玉簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18211,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其五十九","author":"宁献王","text":"掬面东风酒晕浓，频将罗扇掩羞容。\n抬头只恐君王见，佯把金针花下缝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18212,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其六十","author":"宁献王","text":"效颦常锁远山愁，蹙损东风翠黛羞。\n笑贴鬓钿双玉燕，一天秋思上眉头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18213,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其六十一","author":"宁献王","text":"谁剪吴江一幅绡，巧裁宫样缕金袍。\n妖娆偏称腰肢小，每向龙墀侍早朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18214,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其六十二","author":"宁献王","text":"沉沉庭院夜如何，坐看黄姑织女过。\n月下偶然应识面，谁知人世有嫦娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18215,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其六十三","author":"宁献王","text":"上苑寻芳挹翠华，东风先到帝王家。\n宫娥不识春归去，争插庭前芍药花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18216,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其六十四","author":"宁献王","text":"近来娇怯不胜衣，瘦损春风玉一围。\n落尽海棠春又暮，绿杨枝上燕于飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18217,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其六十五","author":"宁献王","text":"远山凝翠叠青螺，秋水芙蓉映碧波。\n门外晚晴无限意，梧桐叶落已无多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18218,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其六十六","author":"宁献王","text":"金莲步步响回廊，未到先闻宝串香。\n知是六宫妃子至，殿前嘹亮奏笙簧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18219,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其六十七","author":"宁献王","text":"月奁金镜绮窗寒，云母屏开五色鸾。\n宝篆有香椒壁静，一帘红雨杏花残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18220,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其六十八","author":"宁献王","text":"翠盘金缕绛纱笼，银烛荧煌照汉宫。\n应制草词书细字，灯花报喜吐殷红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18221,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其六十九","author":"宁献王","text":"禁城春色又将过，岁月于人奈老何。\n不向镜中添白发，玉颜犹胜旧时多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18222,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词一百七首（录七十首） 其七十","author":"宁献王","text":"辇路飞花满翠阴，数年无复幸车临。\n独有海棠枝上月，几番圆缺到如今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18223,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟洪武宫词十二首 其一","author":"黄省曾","text":"君王新拱虎龙都，万户千门天上图。\n不似六朝繁粉黛，内宫聊选备承呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18224,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟洪武宫词十二首 其二","author":"黄省曾","text":"六院沉沉六观傍，西宫紫殿起中央。\n夫人别与兰闺贮，尽饰金笼彩璧箱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18225,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟洪武宫词十二首 其三","author":"黄省曾","text":"鸡鸣天子下床梯，内直红妆两队齐。\n阊阖虎头门大启，春星犹带紫宫低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18226,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟洪武宫词十二首 其四","author":"黄省曾","text":"金铺玉户月流辉，宝座瑶堂映紫衣。\n圣主观书居大善，三更龙辇未言归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18227,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟洪武宫词十二首 其五","author":"黄省曾","text":"内花园里动春游，四面参差五石头。\n玉砌琳阶储碧水，龙葭吹向小亭留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18228,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟洪武宫词十二首 其六","author":"黄省曾","text":"君王蚤起视千官，金灶争催具凤餐。\n红粉珠盘排欲进，再三擎向手中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18229,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟洪武宫词十二首 其七","author":"黄省曾","text":"云檐排比玉妃房，户户俱铺紫木床。\n圣后从来勤内治，不教偷懒杂沉香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18230,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟洪武宫词十二首 其八","author":"黄省曾","text":"凿教金井受天光，小小银瓶挂玉床。\n此是圣人新制度，诸宫各院尽相当。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18231,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]