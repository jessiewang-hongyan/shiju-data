[{"title":"黯淡滩","author":"谢宗鍹","text":"乘流贪迅急，冒寒冲晓雾。\n闽江信清驶，趋海势遥注。\n坤轴恐其弱，巨石相撑拄。\n诡诞如鬼工，禹凿未经夙。\n齿利侔剑戟，槎枒龈腭露。\n窟压老蛟蟠，涛奔健马赴。\n震荡惊雷吼，崩坼盘涡怒。\n篙师脱颖手，箭疾鲜还顾。\n素闻骇吕梁，侧想淩滟滪。\n平生仗忠信，遇险当不惧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过祖堂","author":"谢宗鍹","text":"讲席临轩爽，苍山四面围。\n草香游鹿涧，云触定僧扉。\n悟法无真幻，劳生有是非。\n逢幽良可住，心事尚多违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北上经青齐间郡邑残破触目怆心漫成四首 其一","author":"谢宗鍹","text":"乱后从于役，劳歌慰远程。\n废墟无客过，荒垄少人耕。\n白骨横秋野，黄蒿没古城。\n停鞭增怆恻，我马亦悲鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北上经青齐间郡邑残破触目怆心漫成四首 其二","author":"谢宗鍹","text":"格斗今春苦，长驱径渡河。\n城池空溅血，将帅漫横戈。\n丁壮充俘馘，金绘付梱驮。\n伤心摇落候，此地独经过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北上经青齐间郡邑残破触目怆心漫成四首 其三","author":"谢宗鍹","text":"雄都千万户，寥落数家存。\n鸡犬灾犹及，衣冠祸更紧。\n人生几欲尽，天意固难论。\n野老纷前泣，将陈语复□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北上经青齐间郡邑残破触目怆心漫成四首 其四","author":"谢宗鍹","text":"虽然鼙鼓息，途次尚腰弓。\n残烧枯桑外，愁阴大泽中。\n妖狐啼白日，新鬼哭秋风。\n道侧仳离者，时时掩袂逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"由断桥至孤山","author":"谢宗鍹","text":"十里泛遥碧，迟行领略全。\n轻寒犹勒雪，空澹自为烟。\n鹤去山中墓，人来湖上船。\n梅花如补种，韵事亦堪传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冷泉亭","author":"谢宗鍹","text":"泉当亭际满，暗涧送声迟。\n源远无寻处，山空欲落时。\n清泠醒酒梦，恬淡沁诗脾。\n学士留题日，高风别在兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别许钦翼","author":"谢宗鍹","text":"言归还滞此，如鸟未安枝。\n复作经年别，同含失路悲。\n越歈翻绿水，楚赋重香蓠。\n明月此宵意，孤光当为谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"避地","author":"谢宗鍹","text":"战斗黄尘起，蚩尤气塞空。\n邮书经月断，野哭万家同。\n荆棘惊身窜，诗书叹道穷。\n兴朝方剪逆，用钺望元戎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿影江阁","author":"谢宗鍹","text":"孤峰临静夜，松露滴微凉。\n短烛成诗捷，遥钟引梦长。\n沸泉新茗味，澄月远江光。\n赢得閒僧共，迟明底事忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游牛首山","author":"谢宗鍹","text":"身历方知胜所闻，遥看青碧竞纷纷。\n游情欣倦随行变，物象高低触望分。\n寺古松杉明积雪，路幽巾舄湿寒云。\n千崖万壑无人处，带雨留题剔藓纹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天津","author":"谢宗鍹","text":"河冰未合雁初征，楼橹防秋古堞平。\n自失三韩辞属国，独参四辅拱神京。\n风悲戍鼓疏还续，日落江帆隐复明。\n氛祲冥冥遥入望，海天兵气浩横生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韩淮阴祠","author":"谢宗鍹","text":"大将威名烈士肠，酬恩一饭未尝忘。\n登坛特识归真主，蹑足危机在假王。\n绛灌堪羞宁玉碎，英彭同尽惜弓藏。\n当时成败休轻议，青史传疑亦渺茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夕次京口言怀","author":"谢宗鍹","text":"误攻文字落名途，未脱青袍鬓已疏。\n十月三江犹浪迹，一家五岭少来书。\n海门孤戍鸣寒角，瓜步残潮见夜渔。\n南北干戈愁战血，时危焉敢问安居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王龙光话旧","author":"谢宗鍹","text":"十载风烟滞故园，相看华发映青尊。\n论诗慷慨歌黄雀，把剑纵横讲白猿。\n世路多难何地免，交情久薄几人存。\n知君正有匡时策，未向沧江老钓缗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜湖新篁坞歌","author":"谢宗鍹","text":"湖外有山城不隔，山光湖光两相借。\n湖以藏坞人不知，岛与湖波合冥漠。\n岛中之人坐清晓，但见千里万里白。\n湖所尽处无非山，历历去身不盈尺。\n由岛测湖乃无边，山立其外高反逼。\n似将凝峙佐空旷，上者苍寒下沉碧。\n环岛为居竹閒之，茏葱一丘靡留隙。\n孤烟袅袅镜中浮，日出波沸岛皆赤。\n离离菰蒲香满湖，湖面鸟飞去无迹。\n游人共指销夏澳，六月无风自萧槭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"憩通衢官梅阁怀李谷平","author":"谢宗鍹","text":"先朝折槛见危言，九死曾滨逐客魂。\n汉室竟能收贾谊，南荒终不老虞翻。\n烟浮古驿青通市，雨歇寒山翠到门。\n谁谓广平心似铁，种梅犹解护芬温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和揭阳冯明府感旧诗二首次韵 其一","author":"谢宗鍹","text":"黛螺销尽殒蛾眉，油壁青骢岂再期。\n只道千金人似玉，翻怜一缕命如丝。\n王家无复迎桃叶，白傅真成别柳枝。\n应忆巫峰何处是，春灯夜雨梦还疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和揭阳冯明府感旧诗二首次韵 其二","author":"谢宗鍹","text":"返魂无计觅残香，泉路人间总断肠。\n夜月珠归迷合浦，春风花落恼河阳。\n玉钗化后空留燕，瑶瑟无声冷泣凰。\n去住因缘俱莫问，空花看换眼前光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游陈氏东皋别业同欧嘉可黎美周陈园公","author":"谢宗鍹","text":"荷照新陂柳十围，葛衫轻试晚凉稀。\n观濠惠子元同约，看竹王猷屡未归。\n坐即邀僧分野翠，吟常并鹤到斜晖。\n墨香记取留题处，蕉影青摇白板扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望飞来寺","author":"欧芬","text":"一望知难尽，扁舟溯峡来。\n碧幢双径隐，绀殿半云开。\n梵语乘风过，香烟到树回。\n高峰如可至，何日正登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过富阳忆何明府","author":"欧芬","text":"布帆淩晓发钱塘，趁得严风到富阳。\n山势逶迤将入汉，江流曲折始通杭。\n难忘问字扬雄宅，尚忆鸣琴单父堂。\n半枕梦魂犹不定，泪痕零落鬓丝傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊扬州忆先虞","author":"欧芬","text":"扁舟归驻广陵城，回首遥空隔汉京。\n地控淮徐漕路转，天连吴越海云平。\n高天夜月仍闻笛，琼观春风但记名。\n最忆往年家水部，官梅重有古人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽黄象坤","author":"欧芬","text":"客星一夜失江津，无复溪头理钓纶。\n抱璧向惭频献楚，寻源今似永逃秦。\n丹青业在堪垂世，白玉楼成易促人。\n社里姻盟皆可恋，未听邻笛已沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送壶公兄之循州","author":"欧芬","text":"垂杨芳草竞菁葱，溪阁离尊日照红。\n人向侯蠃虚左席，客从鲍靓挹仙风。\n乘潮怅望随飞鹢，访胜如何托画熊。\n翘首层峦三百六，相思多在铁桥东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄壶公兄","author":"欧芬","text":"清溪南望海云东，春暮分携又朔风。\n草带霜华淹客路，梅看琼蕊梦仙宫。\n烽烟两地知无恙，雨雪孤尊久未同。\n昨日缄题劳念我，鹤峰霞影入行中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春郊","author":"欧芬","text":"东皋青接陇，南亩绿连云。\n万井桑麻合，千村桃李分。\n岁时寒食暮，风雨夕阳曛。\n野馆青帘出，江亭玉笛闻。\n王孙芳草路，游女石榴裙。\n何处城隅曲，提筐遇使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈醴源夫子旋里","author":"张琚","text":"春辞五岭去，公向八闽归。\n明月照官路，梅花飘素衣。\n风尘终不染，宦海早知几。\n自买三间屋，云深鹤护扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈醴源泉夫子过访旋溪书屋喜赋","author":"张琚","text":"榕阴深处一堂开，日倚栏干望几回。\n旧雨不逢排闼至，先生今为看花来。\n碧桃红杏飘书带，水色山光入酒杯。\n听得成连琴数曲，仙风引我到蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游明山 其一","author":"张琚","text":"散发青松下，日莫望羽客。\n驾鹤来不来，飞泉落岩石。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游明山 其二","author":"张琚","text":"幽禽啼一声，遥遥四山静。\n不见樵客归，苍麇出樵径。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"静室","author":"张琚","text":"帘卷斜阳见几峰，一溪流水逝溶溶。\n山僧不到柴门掩，惟听春鸠叫绿榕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒严先生祠 其一","author":"李楩","text":"雨雪归舟泛碧天，布帆轻稳客称仙。\n滩头人寂瞻遗躅，祠下潭空忆往年。\n盖代经纶传渭壑，一竿烟水绘涛笺。\n先生不钓千秋誉，悔着羊裘几未先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒严先生祠 其二","author":"李楩","text":"寒冬雪积白云窝，高士祠前诵短歌。\n止水潜鳞嬉浪远，层崖逸翮宿烟多。\n真人位定通辰极，客宿光然亘曲阿。\n出处无心君自悟，南山有鸟北张罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒严先生祠 其三","author":"李楩","text":"恁大乾坤恋一丘，归来长啸富山秋。\n台悬此地凭伸足，浪蹴何人稳着裘。\n过客浮踪颠鹿梦，逝川变态避渔舟。\n起君千载垂纶手，钓取鲸鲵战血休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒严先生祠 其四","author":"李楩","text":"龙蟠蠖伏总英雄，当日严刘意见同。\n应自茅庐曾定策，其如坚卧不言功。\n徵来素友惊天象，归去扁舟驾晓风。\n戴笠乘车平等事，古人丘壑傲王公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒严先生祠 其五","author":"李楩","text":"话旧清宵两不猜，遐心空谷自徘徊。\n汉宫花草经灰劫，严氏江山只钓台。\n映雪晴岚邀客至，浴波水鸟瞰人来。\n一竿揭揭烽烟净，定策群公未易才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒严先生祠 其六","author":"李楩","text":"故人天子乍成欢，刘季当年忆拜韩。\n司榻漫猜星犯座，披裘早觉暑生寒。\n自来良猎怜烹犬，是处清沦快伐檀。\n月满空山酣睡足，神仙富贵不相干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒严先生祠 其七","author":"李楩","text":"高踪追诵躁心安，千仞层层一笑看。\n白露求人咨榻好，红尘拍面上车难。\n王风雉兔悲投网，孺子沧浪许濯冠。\n历历桐君都看到，临渊肯作羡鱼观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒严先生祠 其八","author":"李楩","text":"归计蹉跎渡浙东，苍苍葭浦溯初衷。\n中原旗帜真人见，空谷烟霞乐事终。\n欲洗流泉成小隐，懒从劫火数英雄。\n一竿愿向先生乞，斗酒鲈鱼访醉翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒严先生祠 其九","author":"李楩","text":"老卧高台自夙缘，无疆风月不须钱。\n峰峦对出临无地，云水相依乐有天。\n隔浦渔歌喧晓日，窥关鹤影戏朝烟。\n几先一着惟君早，采石江头憾谪仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒严先生祠 其十","author":"李楩","text":"龙斗中原争一先，鸿冥天际静求全。\n临流不羡鲈鱼脍，避世还寻海岛缘。\n云壑勒铭惭后辈，磻溪猎梦自前贤。\n我来台上君千古，泛泛澄潭月满川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游阴那山","author":"李楩","text":"五峰青削瞰罗浮，咫尺岚光冻欲流。\n幽壑有天皆作瀑，痴云无地不成楼。\n石留藓字还能读，雨冷藤花觉易秋。\n薄暮月钟随叶渡，遥同僧影静山陬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洪晖吉使君招游阴那山和韵","author":"李楩","text":"少年携笈押危峦，老忆晴云岫里看。\n出谷莺声遥唤友，趋城笠汗迫输官。\n山深樵子迟新步，溪涨渔人溯旧欢。\n幽事堪寻君许伴，乳鸥曲曲待前滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪行","author":"李楩","text":"少不惬幽况，因之舍棹行。\n径幽看鸟迹，竹暗得泉声。\n野烧痕初绿，溪烟涨正盈。\n閒心谁到此，驻屐听新莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"失题","author":"李楩","text":"采药空山归不归，扣门声更雨声围。\n隈檐两杏垂枝入，故弄拳珠点客衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感讽篇","author":"梁佑逵","text":"予少颇晰美，苦为女郎齿。\n十五出从师，邂逅西邻女。\n相感上秦楼，当筵蒙锦被。\n春色腻如云，白縠笼烟紫。\n宝钏响锒铛，明珠挂当耳。\n空房挺华光，援琴横自起。\n怵惕且自陈，黄泉永相矢。\n岂曰匪思存，中怀良独尔。\n宋玉虽好色，言宁孤人子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"思归引","author":"梁佑逵","text":"杖剑万里游，崎岖窘高步。\n中怀多不平，于焉思返顾。\n献策会无成，不如守坟墓。\n折剑铸为镜，鉴予襟与素。\n引镜比张良，状貌同好妇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈集生太史","author":"梁佑逵","text":"孟秋凉气至，蟋蟀鸣虚牖。\n惊飙撼庭柯，落叶日以厚。\n居人若在行，况乃行当久。\n揽衣起徬徨，出门送我友。\n丈夫志四方，所惜非分手。\n勉旃赴前途，爱子琼与玖。\n勿以门第高，弃捐葵藿偶。\n勿以声名溢，而忘夙所负。\n富贵不足矜，所期在不朽。\n贱子不习谀，素心聊用剖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"木棉花歌","author":"梁佑逵","text":"长虹漠漠澹黄昏，绛节云中拥万神。\n霞标初建城头上，甲光向日开金鳞。\n光摇夹岸迷颜色，大树将军谁者识。\n一望平原若火燎，疑是田单破燕日。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采莲曲","author":"梁佑逵","text":"托根同佳藕，何须妒并妆。\n生憎子结后，强半是空房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄雀行","author":"陆卿","text":"飞飞黄鸟，所求饮啄。\n巡厥残场，私为至乐。\n踊跃转盼，壁壁剥剥。\n鸿鹄飞过，相顾惊愕。\n心妒口诅，愿其中邈。\n焉知鸿鹄兮，志在千里。\n鸿鹄高飞兮，燕雀已矣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鞫镜词","author":"陆卿","text":"昔人思见面，一见便知心。\n慷慨输肝胆，唯诺轻千金。\n尔我时相见，心乃藏深深。\n当面言笑合，情犹隔重襟。\n岂惟隔重襟，邈若峰与岑。\n外洁得毋秽，外贞得毋淫。\n外平得毋陂，外霁得毋阴。\n外通得毋塞，外人得毋禽。\n两两亲熟间，屡变岂所任。\n所贵笑貌同，内无商与参。\n间或岁月移，稚老弗能禁。\n笑貌则有改，勿改个中仁。\n今与尔约曰，敬听勿因循。\n载伪劳且拙，朴小不敢臣。\n华实弗相掩，照形兼照神。\n如其不然者，弃尔等灰尘。\n掷碎铸为剑，专诛负心人。\n人面日趋古，人心日趋今。\n愿言保初终，髯戟何森林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓齐昌危秀才斋庭前有古梅索予咏之","author":"陆卿","text":"此树如老僧，中空而外槁。\n积雪裂其肤，离披势潦倒。\n生意次第舒，疏花向背好。\n酸风欲透肌，皓月若披缟。\n幽人形影亲，狼籍弗忍扫。\n俯视众卉间，失色生烦恼。\n时去浮华尽，一朝难自保。\n所以高士姿，识时贵在早。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋旅","author":"陆卿","text":"夜雨响芭蕉，竹屋摇如纸。\n中有痴绝翁，相忆人千里。\n老翁痴复痴，放响入双耳。\n滴滴滴到心，由心渐人髓。\n蟋蟀气将喑，芙蓉香欲死。\n灯影化成烟，茫茫斗室里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端州郊楼遣病","author":"陆卿","text":"病起眺寒林，林塘楚楚净。\n云疲懒出山，竹傲横穿径。\n小艇泛秋花，孤翎掠水镜。\n闲情感夕佳，入眼幽光靓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古松篇","author":"陆卿","text":"矫矫岁寒姿，欲存天地骨。\n怒号气作涛，孤直髯如戟。\n内有珀万年，疑是苌弘血。\n奇态若拿云，无心偶留月。\n樵子不敢攀，得辞斧斤伐。\n嗟呼，委身失所恒遭刖，杞梓梗楠等榾柮。\n桂煎漆割同肥腯，千古高风让薇蕨。\n只今秀林防摧折，藏形直宜类株橛。\n鳞老成龙心似铁，庶免蚁巢与蛇穴。\n谁谓肯终天年赉志殁，一朝求材在仓卒，乃出任庙廊梁栋显掀揭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春雨中过荷村访舒菊泉夜宿吴仲书山房","author":"陆卿","text":"竟造幽人室，春光肯负余。\n花慵如出沐，柳曳似经梳。\n坐久逢梅落，棋深听子疏。\n松风留好梦，酒醒满床书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步韵答郭尔兴","author":"陆卿","text":"吾亦清狂者，为君操古琴。\n乾坤双眼白，风雨一灯深。\n芳草暮云隔，美人幽梦寻。\n梅川花候冷，凭几发微吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日怀喜年叔兼讯傅由庚","author":"陆卿","text":"夙具山居僻，桃源不易逢。\n一犁春后绿，几树宅边红。\n敢曰非穷士，居然有古风。\n更闻金谷近，酒债未从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渫园","author":"陆卿","text":"小窗幽且洁，高卧是良谋。\n门掩炉烟定，风来花气浮。\n松阴三径寂，竹响数竿秋。\n剥啄伊谁子，名僧一刺投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上不寐","author":"陆卿","text":"百感填胸弗自由，新诗敢拟到随州。\n古云抱石疑生蒂，衰柳垂堤若系舟。\n月意将残魂化水，虫吟渐壮气兼秋。\n渔蓑此日从飘泊，生计惟堪问白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":38233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]