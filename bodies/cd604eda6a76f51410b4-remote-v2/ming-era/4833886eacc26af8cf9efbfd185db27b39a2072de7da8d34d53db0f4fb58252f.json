[{"title":"陶公福地","author":"郑廷鹄","text":"五岭迢迢拥福山，陶公盘郁海云间。\n寒潭夜雨苍龙吼，曲水春风彩凤还。\n竹径石边看独塔，草亭峰外送双鬟。\n仙台不秘长生药，蒲节松花可驻颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉龙泉","author":"郑廷鹄","text":"玉龙回首碧池前，空谷泠泠启大川。\n石砌初通蘋藻雪，锦题新挂茑萝烟。\n仙源别是通秦岛，古峙何常问汉年。\n要识山灵有神应，商霖今日传岩篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十二岁自省","author":"欧阳建","text":"自古圣狂两路歧，算来原是错毫釐。\n群居博奕有谁省，终日遨游祇自痴。\n孔孟曾颜皆可法，关闽濂洛总当期。\n如今身入宫墙里，尽改前愆与往非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十四岁自省","author":"欧阳建","text":"义利两歧千里隔，算来原是差毫釐。\n百千倍力今须尽，十四年前顿觉非。\n事业光明皆地步，身心修省是男儿。\n从今识破贤愚路，明道希文好自期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十六岁与督学张公联吟","author":"欧阳建","text":"酒了瓷瓯局了棋，竹床风静打眠迟。\n漏声到耳更三点，梅影横窗月一枝。\n四海萍踪今夜定，半生事业两心期。\n凭谁为剪邻鸡舌，更与从容话片时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九岁赠星士梁月溪","author":"欧阳建","text":"平星玄妙月溪多，算我名标己卯科。\n今日果然科己卯，天机无亦奈公何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京行别宗族","author":"欧阳建","text":"一自抠衣拜广庠，粤城城下肄文章。\n卯年始幸登科第，辰岁还期饮御香。\n好唱骊歌辞族老，敢将行旆久篁庄。\n遥思飞报宫花日，父老应知喜气扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赴春闱","author":"欧阳建","text":"睡起篁庄日已红，方知鞅掌是途中。\n帆飞荻港江河阔，马度梅关霜雪浓。\n未尽风光行且北，祇因流派别于东。\n丈夫不与匏瓜伍，湖海奔波鱼化龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京都闻砧","author":"欧阳建","text":"砧杵声声过短篱，一声高处一声低。\n画蛇几许惭添足，梦蝶多时苦弄衣。\n黄菊有花非我里，青山无恙待人归。\n行行争奈千千舍，欲学天门八翼飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京都怀父生诞","author":"欧阳建","text":"秋风八月利如刀，收拾先冬旧缊袍。\n却忆严君初度庆，应嗟游子远方劳。\n两回惭负三春梦，万里空瞻五岭高。\n甘旨他年何处是，欲从天表觅仙桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京都怀母生诞","author":"欧阳建","text":"无情岁月又中秋，天色苍苍月色幽。\n今日佳辰思母老，两年何事住皇州。\n稚妻解进茱萸未，诸妹能供苦茗不。\n想极夜深凭几卧，梦魂飞到粤山头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京都怀双亲诞 其一","author":"欧阳建","text":"赚我平生识一丁，故园动隔八千程。\n四时恰好中秋景，二老方逢此际生。\n春酒介眉惭古意，秋花盈眼荡金城。\n蟠桃欲仗西王母，青鸟殷勤为寄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京都怀双亲诞 其二","author":"欧阳建","text":"客厨向晚菜羹甜，细细风来淡月兼。\n南极星辉何处野，北堂人捲此窗帘。\n霞杯酒愧斯今酌，海屋筹将几度添。\n假寐梦魂缭绕去，罗浮天外万峰尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春闱下第托渔父吟","author":"欧阳建","text":"秋风飒飒浪飘飘，蓑笠惯披坐不忧。\n一意自怀鱼可得，三更谁想饵空投。\n且撑秃艇湾沙嘴，暂把渔竿插滩头。\n直待江回春水暖，巨鳌无信不吞钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"下第閒题","author":"欧阳建","text":"十年辛苦未曾閒，笑指青云咫尺间。\n富贵不从人所愿，功名却与命相关。\n诗书再把从头读，论策还将著意删。\n料想广寒丹桂在，高枝留待我来攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠聂龙灵归","author":"欧阳建","text":"乾坤汗漫达人游，入望神京岂惮劳。\n灯火芸窗皆地步，马蹄槐市足英豪。\n三秋月照黄花艳，五岭云飞白气高。\n我欲留君君欲去，半更棋局半挥毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画鹊","author":"欧阳建","text":"何处人工夺化工，描将双鹊入梨枫。\n羽毛成矣无今古，远近看之有淡浓。\n欲颉欲颃宜化印，从天从地不羁笼。\n主人有喜君知否，都在无言颊舌中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和叔虚所","author":"欧阳建","text":"丹崖赤壁石岩岩，明月梅花结此龛。\n诸葛庐中龙待雨，渊明门外柳堆岚。\n清溪炼法还堪伍，白酒传杯已过三。\n多少谢情吟不尽，松梢千丈耸山南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邑侯陈肖鹤","author":"欧阳建","text":"圭峰千丈耸冈城，令尹三霜振政声。\n淑气转钧乡荜暖，瑶池滴露邑桃荣。\n风吹旗旆龙蛇动，日映剑芒海岳明。\n无计可攀青雀轴，夜看台斗到三更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送肖鹤陈邑侯五首 其一","author":"欧阳建","text":"郎官拜日我瞻星，曾见祥光动禁城。\n琴酝春风千古照，剑磨秋水十年瑩。\n单车到处能绥寇，一德孚时不用兵。\n宪眷有言荣衮冕，黄云何计久飞鸰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送肖鹤陈邑侯五首 其二","author":"欧阳建","text":"吩咐儿童好种花，春风可是遍天涯。\n贾琮作郡祇如此，龚遂为官已到家。\n绿树丹霞飞老鹤，深山穷谷蛰妖蛇。\n等閒欲继餴饎咏，却愧安能手八叉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送肖鹤陈邑侯五首 其三","author":"欧阳建","text":"圭江南下水粼粼，荡涤冈州十载尘。\n墉隼自潜安用武，釜鱼翻活肯忘恩。\n霾云飞去山头露，皓月照来天骨真。\n千古循良应有传，翁乡之后更何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送肖鹤陈邑侯五首 其四","author":"欧阳建","text":"人心有感自和平，应是潢池已寝兵。\n村径春深无犬吠，稻田烟暖有牛耕。\n朱弦坐鼓南薰调，白简过朝北阙城。\n何处相思情不尽，夜看台斗到天明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送肖鹤陈邑侯五首 其五","author":"欧阳建","text":"十年灯火曳南滨，最喜今朝却大同。\n豹变可能成革武，兔爰谁复赋王风。\n柏台论定三台白，花县春深万树红。\n预卜燕山山下月，绿衣炫耀马青骢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何邑侯","author":"欧阳建","text":"官船欲发鼓鼕鼕，一载何因得谢公。\n日出梧冈鸣老凤，雨来桃浪起真龙。\n剑光凌乱台星动，琴调清高玉宇风。\n他日相逢何处是，东华门外马青骢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诸弟启馆","author":"欧阳建","text":"古木森森喜鹊鸣，延师启馆习儒经。\n吹开桃李春风暖，遍照江山午日明。\n鲁酒对君头未白，芳邻接我眼常青。\n叮咛诸弟须勤学，好梦池塘春草生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读书无油诗以自叹","author":"欧阳建","text":"嗟尔边孝先，胡为坦腹眠。\n囊萤无腐草，映雪岂霜天。\n凿壁邻尤远，燃藜木更坚。\n迩来风雨夜，惊枕亦徒然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠少年甄姓","author":"欧阳建","text":"五百年来住此村，梅花妆点雪芳芬。\n柴门旧少贤人扫，太极分经孺子论。\n曾子大贤还儆省，周公元圣亦忧勤。\n从今再勉三年力，四海人应识得甄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望弟省行未归","author":"欧阳建","text":"应束担头几卷书，归来灯火共三馀。\n名扬宦海皆文字，锦出吴宫尽紫朱。\n春草池塘生夜梦，珠江云树动朝旴。\n家园未必无松薤，欲学当年董仲舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"京都端午夜坐","author":"欧阳建","text":"欲睡欲醒睡又醒，天风吹鼓两三声。\n碧桃红杏何时沃，紫水黄云想处清。\n病卧祇看岐伯论，侨居何减杜公情。\n谁家吹笛仍撩我，五月梅花落满城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送马拯同年归娶","author":"欧阳建","text":"江树青青江水长，锦帆南望试新凉。\n黄麻映日肩头宠，丹桂飘风岭表香。\n重庆堂前呈彩舞，三周轮上隐瑶妆。\n与君且饮金华酒，到得云山橘欲黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送卢梦扬同年归娶","author":"欧阳建","text":"风捲长空积雨收，青天白日送行舟。\n虬龙万里腾虹剑，蘋蓼千花映彩斿。\n金屋贮将春昼暖，银河济渡夜光浮。\n缘知青琐重游地，槐棘阴浓景未秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登第归泊清溪","author":"欧阳建","text":"少留归棹清溪酒，轻送松琴元日风。\n岸上衣冠纷拜节，行边书剑任飘篷。\n群鸡咿喔茅檐午，孤鹤翱翔海气通。\n笑指吾庐应咫尺，而今不被白云笼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜棠下宗族来","author":"欧阳建","text":"篁庄初泊下溪船，木念遗根水念源。\n六一风声还我旧，三千礼乐又谁门。\n豪雄都内曾何族，乔木人间祇故园。\n又喜藩篱今剖破，山亭百拜谢诸尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和林邑侯梦乘槎游","author":"欧阳建","text":"良宵一枕梦奇游，踏上槎头上下流。\n青雀黄龙仙子样，白蘋红蓼道人秋。\n朝廷有道清炎海，造化无私荡不周。\n知是我公还有梦，乘槎旬日到天头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送北上","author":"欧阳建","text":"风捲长空宿雾晴，天高海阔送君行。\n人多到底方如意，事得向前好寄声。\n瓜葛情深难作别，蒹葭秋老不移情。\n相思两地无言处，坐数山城长短更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送别","author":"欧阳建","text":"圣道无涯谁得之，循循上达老天知。\n千年脉络英贤续，百折江河砥柱支。\n今日共吟依韵句，移时谁掇打头枝。\n笑看世事无凭处，且步阳关递酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭莫萃庵","author":"欧阳建","text":"我哭夫君哭不哀，夫君舍我入泉台。\n传家有子真贤也，负郭田园亦盛哉。\n瓮底饮馀当日秫，墙头吟剩隔年梅。\n鸣蝉不解游人意，还自声声送咽来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元旦","author":"欧阳建","text":"玉炉香袅笔毛濡，元旦诗骚鼓角摧。\n十载未穿维翰砚，一壶得中步兵厨。\n雪并残臈归刍狗，风引韶光到草庐。\n翘首白云三千里，江公多似郭公愚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦雨","author":"欧阳建","text":"城头鼓角漫无声，城里康庄小艇行。\n河伯欲吞山作泽，龙儿无亦蠢非灵。\n盆莲开待羲皇白，庭草翻愁茂叔青。\n想是阴晴天有意，五云光处见分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠双寿卷","author":"欧阳建","text":"北天遥祝八千里，南极腾光七十年。\n椿树撑云常郁郁，萱花迎日自妍妍。\n閒来白日相依在，老去朱颜尚未迁。\n乡里不悭行苇赋，贤郎将买渡江船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢清爱五首 其一","author":"欧阳建","text":"节寿堂深百堵旋，摩挲尺五是青天。\n狂生踯躅寻常路，舅氏孤高七十年。\n锦绣看花堆槛外，弦歌闻鸟和檐前。\n道中尽有无穷趣，惟见桃源洞里仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢清爱五首 其二","author":"欧阳建","text":"满径松花双鸟旋，魂香烟冷入壶天。\n琴音清亮亭才午，棋局纵横日亦年。\n鱼泳鸟飞云外物，金浆玉醴画图前。\n洛阳自是将三八，袖有青蛇欲学仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢清爱五首 其三","author":"欧阳建","text":"胜游锦里眼花旋，世外文章物外天。\n望压东亭真长者，时瞻南极祝华年。\n名田负郭科从薄，钓艇横江棹向前。\n乘鹤驾龙多浪语，诸郎驷马即群仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢清爱五首 其四","author":"欧阳建","text":"春风次第向人旋，笑指文昌问老天。\n云赋逢杨应有日，穷途哭阮亦多年。\n久翻禹浪鱼高奋，暂到秦关马欲前。\n会看蒙山得仙诀，羡门开口便成仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢清爱五首 其五","author":"欧阳建","text":"白酒新篘向客旋，东君豪放是谁天。\n沙抟宦海三千界，香汹泥涂十六年。\n北斗光腾云汉表，西山壁立栋梁前。\n瀛洲早许投双足，愿作排来第九仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赞节寿五首 其一","author":"欧阳建","text":"旁搜列女漫周旋，路出城西别有天。\n三五纲常皆步步，依稀龟鹤自年年。\n已推粉黛还身外，却见斓斑舞膝前。\n剩有紫霞杯玉案，华阴何事觅神仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赞节寿五首 其二","author":"欧阳建","text":"饱看熹微斗柄旋，玉冠高顶是皇天。\n妇人自笑嗤男子，造化从渠派岁年。\n金女曾来如有约，共姜之外更无前。\n也应跳入蟠桃会，学得云笙和月仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赞节寿五首 其三","author":"欧阳建","text":"时光流转玉衡旋，母寿千筹子二天。\n菊水和甘堪此泊，梅花香冷是何年。\n芳名皓日留身后，世事浮云顿目前。\n试问绿华能此否，半为贤母半为仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赞节寿五首 其四","author":"欧阳建","text":"不管世情似磨旋，丹心刚有不移天。\n松筠凌雪三千丈，房闼流芳五百年。\n日会乌衣翔臂上，时看青鸟舞阶前。\n尘埃谢绝春长在，疑是蓬莱第一仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赞节寿五首 其五","author":"欧阳建","text":"春雨秋花共转旋，玉炉香袅拜青天。\n浮生有志皆随梦，中壸无书不记年。\n贤母未应居孟后，诗人安敢列卢前。\n贺筵当日龙觥处，滚滚还谁作醉仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赴任清流晚泊宁都河","author":"欧阳建","text":"举目望天东，故园隔万重。\n来行数百里，作伴两三童。\n月暗河波白，电腾林彩红。\n清宁离不远，愿借满帆风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"福建巡按攒入秋闱试士","author":"欧阳建","text":"行行奉命攒催程，渔父无知问姓名。\n数日未应亲舍远，百年惟爱太阶平。\n天风大辟千人扇，海岳长悬万里灯。\n舟子不知行客计，闽城桃李向谁青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠主簿","author":"欧阳建","text":"秋水蒹葭老，晚晴流更清。\n兰舟向淮海，花县涤琴声。\n一命堪沾物，三年定显名。\n有时看鸂鷘，个个浴河汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赞荣寿匾额","author":"欧阳建","text":"岭表昭垂阿母名，寿筵时震管弦声。\n地曹有善休祥远，天道无私雨露零。\n桃笑三偷金屋蔼，酒浮千日玉船轻。\n喜看香篆烟蛇袅，袅入斑斓舞袖馨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赞存耕毛君号","author":"欧阳建","text":"卧老青山五十年，稻田不种种心田。\n谁云寸地少生计，须信仁人多福缘。\n用尽机关嫌俗子，等閒潇洒似神仙。\n从今门闬还高大，好看儿郎驷马鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赞我桥号","author":"欧阳建","text":"山涧涓涓不断流，一桥风月肺肝收。\n梅花点句春和我，竹叶陶情老到头。\n管甚阴符授圮上，欲缘石柱过罗浮。\n知君不放虹云卧，生怕栏杆碍斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赞莲所周君号","author":"欧阳建","text":"长夏莲生且渐舒，是谁向此独恬愉。\n孤根郁郁何神也，半亩青青最妙欤。\n红瓣飞时忙粉蝶，绿波皱处戏金鱼。\n花神最爱周夫子，五百年前两度俱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赞西圃号","author":"欧阳建","text":"何处清幽圃筑西，一帘风月四山低。\n梅花戏雪春模样，酒兴撩诗道范围。\n青眼辟从天外放，白云轻傍帽檐齐。\n高斋独抱焦琴坐，漫听松声百鸟啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赞龙所号 其一","author":"欧阳建","text":"龙所芳名祇羡君，云端物表自精神。\n韬光认作池中物，点眼愁惊壁下人。\n韩愈门前唐室梦，孔明庐暖汉家春。\n祇因解负庖羲画，说到于今剩得亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赞龙所号 其二","author":"欧阳建","text":"清虚一所卧人龙，寄傲人龙迈古风。\n懒向云霄布霖雨，乐从山水觅仙踪。\n当年诸葛还承召，今日欧阳不受封。\n深得三槐王祐趣，欲留来裔作三公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋次韵","author":"欧阳建","text":"水为月之精，月乃天之镜。\n除却春夏节，惟秋得金令。\n金水相生焉，光辉故井井。\n一年几中秋，达人所以兴。\n家酿浮玉壶，山芋烹铁鼎。\n金谷诗将成，彭泽醉欲醒。\n最爱赵知微，识破天形影。\n共登天柱山，不愁仆马病。\n出门无复碍，绰绰任所骋。\n玄鹤一声过，此机谁与领。\n天上有圆光，人间无穷境。\n耳听霓裳歌，手握玉麈柄。\n五百负元回，三万乾坤迥。\n因此良月夜，浩然生万景。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺希周得子","author":"欧阳建","text":"今朝横棹溪南下，偶值三兄产玉儿。\n欲识个儿到底处，五云呈色我来时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和溪南","author":"欧阳建","text":"溪南老大兴何如，散诞琴书乐海涯。\n多病几时堪策马，风花吟遍始还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":8936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]