[{"title":"石头秋望","author":"邓云霄","text":"秋原眺望闲，远目遍江关。\n河影摇城堞，吴云入楚山。\n风高帆半落，书去雁空还。\n正值莼鲈节，渔歌起近湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孟冬二之夜吴翁晋孙燕诒过访","author":"邓云霄","text":"萧疏梧竹里，还似广文官。\n客至踏纤月，帘开怯晚寒。\n篆烟浮烛细，蒲俎引杯乾。\n何物堪留坐，论诗到建安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郭张虚还崇德","author":"邓云霄","text":"白下相逢处，犹歌蜀道难。\n无官舌尚在，有泪剑同弹。\n棹返五湖远，帆冲片雪寒。\n奚囊多锦字，好当万金看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜邀韩孟郁过宿赋得席上三物刻烛共成三首 其一 盆石","author":"邓云霄","text":"座有烟霞气，三峰迥不群。\n烛摇如挂月，香散欲蒸云。\n倚岱曾称丈，临湘或号君。\n晚来堪一倚，为我解馀醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜邀韩孟郁过宿赋得席上三物刻烛共成三首 其二 盆竹","author":"邓云霄","text":"湘妃摇绿袖，一夜到庭隅。\n未可为龙杖，偏宜待凤雏。\n微风吹缥缈，清籁入虚无。\n错认兰亭会，流觞对酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜邀韩孟郁过宿赋得席上三物刻烛共成三首 其三 盆松","author":"邓云霄","text":"岁寒风飒飒，帘外倒飞霜。\n爱尔龙鳞嫩，移之石几旁。\n㔉苓持斧远，偃盖拂云长。\n总是他年事，从君觅异方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮书怀二首 其一","author":"邓云霄","text":"饥凤不吸粟，耻同鸡鹜肥。\n丈夫傲骨在，意气排云飞。\n五斗羞微禄，三冬未授衣。\n寄言陶处士，岁晏愿同归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮书怀二首 其二","author":"邓云霄","text":"暄和风日好，晓上酌霞楼。\n闾巷如塍错，轩车若水流。\n感时堪一笑，吊古起千愁。\n何处期鸾鹤，西山最上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和苏汝载雪诗四首 其一","author":"邓云霄","text":"积素接华裀，光浮白氎巾。\n凤城疑不夜，花木竟先春。\n姑射来仙子，瑶池见舞人。\n徵歌何处好，偏爱郡中新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和苏汝载雪诗四首 其二","author":"邓云霄","text":"试问前朝事，兴亡竟若何。\n陈宫久寂寞，玉树尚嵯峨。\n冻集城乌静，风回夜柝多。\n诗成何所赠，应付雪儿歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和苏汝载雪诗四首 其三","author":"邓云霄","text":"薄暮寂无哗，同云冷万家。\n不闻吹玉笛，但见落梅花。\n翠失梁园竹，晶凝剡曲沙。\n三杯催作赋，字字是瑶华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和苏汝载雪诗四首 其四","author":"邓云霄","text":"正忆长门冷，还伤绝塞寒。\n窥帘同泪落，倚剑拂花残。\n貂帽何时赐，羊车入梦看。\n寄言新燕尔，此际异悲欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己酉除夕同苏汝载守岁","author":"邓云霄","text":"名香手自焚，虚室坐氤氲。\n客是他乡聚，年从残烛分。\n头颅空老大，鸡鹜耻同群。\n明日探春去，相期弄白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春早","author":"邓云霄","text":"春早馀寒在，西园未看花。\n病为断酒客，懒拒卖书家。\n闭閤观空理，无心玩物华。\n参禅今渐熟，但欠制袈裟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题张大理荣赠册","author":"邓云霄","text":"荀里曾占瑞，韦经真胜金。\n箕裘三代业，风木百年心。\n紫府回鸾诰，玄台捧玉音。\n当因家庆远，转觉主恩深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"修褉日苏汝载介绍林茂之昆玉过我西园小酌同赋","author":"邓云霄","text":"和风吹嫩绿，有客到西园。\n留坐非关酒，论交不在言。\n琴书当昼静，蜂蝶入花喧。\n畅矣群贤会，清池绕蕙荪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠山中隐者","author":"邓云霄","text":"一屋带云局，萧然万虑清。\n山泉入厨灶，石乳煮藜羹。\n月静猿规帐，林疏鹤伴行。\n却嫌居未僻，樵子尚知名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病起伤春","author":"邓云霄","text":"性以闲逾懒，神缘病后清。\n风来还有信，花落太无情。\n不浅芳郊兴，难寻漉酒生。\n西园数株柳，聊坐一听莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻虏大入辽阳","author":"邓云霄","text":"不见雷霆怒，悲风白日阴。\n谁传寒外箭，空费帑中金。\n鬼哭川流血，春归燕在林。\n江南佳丽地，莫忆翠华临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来双白鹤","author":"邓云霄","text":"乘风同矫翮，瘦骨是胎仙。\n别去冰弦怨，归栖珠树连。\n吹闻缑氏岭，寒忆帝尧年。\n可笑人间世，累累自墓田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天界寺十咏 其一 疏钟","author":"邓云霄","text":"高高带云敲，疏越更镗鞳。\n古殿吼长鲸，空房醒老衲。\n声摩山欲动，响歇岩还答。\n夜阑梵呗寂，月照竹间榻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天界寺十咏 其二 清磬","author":"邓云霄","text":"割来罗浮石，洗以泗滨水。\n清冷击云根，飘萧拂尘耳。\n翻经猿鸟集，演法人天喜。\n勿言音韵微，更探无声始。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天界寺十咏 其三 古钵","author":"邓云霄","text":"莫测降龙处，中涵沧海深。\n愿将无漏水，洗我有为心。\n但受香厨饭，休承长者金。\n词人幽兴发，一击起高吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天界寺十咏 其四 妙香","author":"邓云霄","text":"一缕若无烟，飘飖度微眇。\n劫火岂能烧，慈云自相绕。\n不从气味入，远出鼻根表。\n过院几人闻，心清方了了。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天界寺十咏 其五 莲灯","author":"邓云霄","text":"大放白毫光，红莲火中发。\n迢迢照诸天，朗朗烛细发。\n添油如江河，扬焰并日月。\n慧者代为传，妙明永无歇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天界寺十咏 其六 蒲团","author":"邓云霄","text":"容膝岂求馀，趺跏终日夕。\n面壁寂无言，观空了不隔。\n阶前莓苔深，户外蛛网积。\n直至十年后，点头是顽石。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24776,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天界寺十咏 其七 法鼓","author":"邓云霄","text":"天乐晚相和，阗阗发高奏。\n试听海潮音，亦带灵鼍吼。\n新雷绕广殿，宝雨飞晴昼。\n馀响遍大千，修罗息其斗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24777,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天界寺十咏 其八 风铎","author":"邓云霄","text":"殿阁凭虚构，檐牙紫翠分。\n风回惊怖鸽，铎响落层云。\n山晓烟中见，林昏雨外闻。\n居高声更远，羡尔出尘氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24778,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天界寺十咏 其九 锡杖","author":"邓云霄","text":"伏虎在床前，携行处处禅。\n云林亦何意，去住本随缘。\n霞外卓随鹤，山根拄出泉。\n许询对支公，亹亹几绝倒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24779,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天界寺十咏 其十 松烟","author":"邓云霄","text":"疏松石路小，烟霭复周遭。\n翠鬣如新沐，苍鳞泛白涛。\n鸟归迷故树，僧过湿方袍。\n既到空王宇，秦官莫自高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过俞君宜天界寺斋中爱其窗前丛竹漫赋","author":"邓云霄","text":"爱君窗下竹，萧瑟起清风。\n积爽延秋入，流阴荡暑空。\n翠涛翻枕簟，珠佩绕房栊。\n梦醒衣裳冷，疑游湘水东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新秋登回雁峰","author":"邓云霄","text":"城郭晚苍苍，蝉声送早凉。\n薄游同逐客，作赋拟哀湘。\n乡信南来断，江流北去长。\n高峰尔何意，不遣雁随阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"橘井观二首 其一","author":"邓云霄","text":"入户衣裳冷，傍檐苍翠阴。\n主人已跨鹤，芳树尚悬金。\n缥缈游仙路，迟回恋母心。\n真源知几许，看取井泉深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"橘井观二首 其二","author":"邓云霄","text":"空明澄碧甃，恍惚见丹砂。\n谁悟一泓里，遥连三岛涯。\n闲心同酌水，隐吏可餐霞。\n愿折庭前叶，浮为海上槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"婕妤怨","author":"邓云霄","text":"秋水落芙蓉，秋风冷团扇。\n君王素綦绝，草色玉阶遍。\n发堕云满肩，愁来雨沾面。\n谁将好明月，夜夜昭阳殿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荆妻剥笋为供戏赋示之","author":"邓云霄","text":"衙斋客不到，竹里失群贤。\n且剥班龙尾，来参玉版禅。\n铜铛澄涧水，厨火杂山烟。\n庑下还如此，烦君举案前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初度值先慈讳日中夜感叹成四十字","author":"邓云霄","text":"马齿看将老，春愁黯未醒。\n半生疑发白，三仕尚银青。\n落月风吹树，啼乌夜绕庭。\n蓼莪歌更苦，肠断不堪听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬子清明","author":"邓云霄","text":"每逢簪柳日，却忆上坟时。\n雨露亲恩重，松楸节序移。\n春残无北雁，客泪洒南枝。\n多谢啼鹃意，吾归未有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"后园课仆艺植","author":"邓云霄","text":"小园新雨霁，深草乱鸣蛙。\n旭日移帘影，光风转物华。\n地偏宜小隐，宦拙学农家。\n谁道青门远，儿童已种瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四月十五月食半轮","author":"邓云霄","text":"明明三五夜，正好舞霓裳。\n何处麒麟斗，翻为蟾兔伤。\n宝奁愁半掩，桂影澹无光。\n可是嫦娥懒，才成半面妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅雨","author":"邓云霄","text":"十日黄梅雨，萧条竹外扉。\n冷然披白袷，倏矣化缁衣。\n尚怯春寒在，还怜酒伴稀。\n开樽聊一笑，赖有鳜鱼肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虚亭","author":"邓云霄","text":"独坐不知久，虚亭澹入禅。\n风恬薰柳醉，云懒倚山眠。\n宦况半盂水，斋心一缕烟。\n回头问身世，疑在散花天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕前二日焚香夜坐听张无名侍儿吹箫","author":"邓云霄","text":"吹箫延爽籁，一半是商音。\n清夜寥寥永，长河澹澹阴。\n篆烟浮月上，凤曲度云沉。\n试问停梭女，能忘弄玉心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜雨","author":"邓云霄","text":"绝塞闻茄泪，虚窗听雨心。\n共牵千种恨，并是一悲音。\n已厌宾鸿叫，还添蟋蟀吟。\n乡关凭梦去，莽莽水云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"万岁节","author":"邓云霄","text":"拜舞天门晓，红云极望深。\n北风吹广乐，南国若闻音。\n仙掌秋澄露，祥光镜铸金。\n湘江长北向，可比远臣心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖塘","author":"邓云霄","text":"芳草满湖阴，人家隔碧浔。\n留连鱼鸟语，澹荡水云心。\n浅立长堤上，微闻横吹音。\n采莲欲有赠，惆怅楚江深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出塞曲","author":"邓云霄","text":"结交连六郡，负羽殉王师。\n主将方尝胆，男儿誓裹尸。\n鐎声静虎落，剑气喷龙旗。\n警夜寒难寝，阴山雨雪时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜梦","author":"邓云霄","text":"斗帐睡梅花，霜华隔牖纱。\n疏钟遥拂曙，残梦乍离家。\n镊白形容老，还丹日月赊。\n却嫌眠兴剧，思饮建溪茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孟冬同陈袁诸子泛舟入郴","author":"邓云霄","text":"楼船纤锦缆，箫鼓散江天。\n此夕潇湘上，人看李郭仙。\n卷帘初上月，流水入鸣弦。\n试问波间鸟，应知隐吏贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"永兴道中人家","author":"邓云霄","text":"一径穿林杪，群山护竹扉。\n秋高禾黍熟，日暮牛羊归。\n窗外浮云度，厨前瀑水飞。\n平生丘壑意，对你益忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送西席陈玉阳携年儿南归二首 其一","author":"邓云霄","text":"肝胆久相照，吾儿即若儿。\n趋庭惭问礼，立雪得严师。\n绛帐春风早，青灯夜漏迟。\n谁能弹别鹤，正值岁寒时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送西席陈玉阳携年儿南归二首 其二","author":"邓云霄","text":"旅况万山中，凄清谁与同。\n留连一夜话，稍觉四愁空。\n薄宦看孤剑，离人怨断鸿。\n绨袍无限意，前路雪兼风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐","author":"邓云霄","text":"吏散重门闭，闲斋暮雀过。\n卷帘引新月，笼烛辟飞蛾。\n砌冷黄花瘦，城高白露多。\n真成栖隐地，不必问云萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郴阳署中冬夜","author":"邓云霄","text":"夜坐篆消烟，素心谁与传。\n衙斋倚云外，箕颍即阶前。\n月挂猿栖树，鸿啼霜霁天。\n冷然如有得，此地本宜仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郴阳珠雪季冬二日后十三日立春","author":"邓云霄","text":"万壑风云壮，鸣珠打牖纱。\n寒应催腊变，怪不作春花。\n署冷独眠鹿，城孤只噪鸦。\n宿炉残火在，绿酒不须赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郴阳癸丑元日","author":"邓云霄","text":"乾坤车盖里，日月转双轮。\n三载官仍旧，今朝岁又新。\n悠悠长作客，事事不如人。\n已占深山住，何须羡隐沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春猎户献虎","author":"邓云霄","text":"昔日食官马，今朝逢猎人。\n金睛宁烁电，玉爪不妨身。\n杀气消长啸，寒山入早春。\n持将劝元恶，勿与祸为邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕郴民数百人各持灯献看鱼龙曼衍颇慰岑寂","author":"邓云霄","text":"张灯元旧俗，冒雨且冲泥。\n杂沓鱼龙戏，荧煌火树齐。\n山歌声上下，野舞影东西。\n节序同民乐，孤城且暂栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕曲回文学梁陈体","author":"邓云霄","text":"冰开暖水绿，午夜赏春华。\n灯捧蟾宫月，火衔莲炬花。\n绳危袅利屣，埒小斗轻车。\n朋好联歌宴，渑如酒味嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜雨","author":"邓云霄","text":"卧起自徐徐，闲情任卷舒。\n馀寒正月里，微雨五更初。\n绿遍湘南草，鸿回岭外书。\n朝来问詹尹，再卜几年居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏东园鹊巢","author":"邓云霄","text":"星月频惊夜，南飞欲傍谁？\n占风来善地，择木得高枝。\n阴雨难侵牖，春虫足哺儿。\n年年秋报喜，牛女有佳期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春晴","author":"邓云霄","text":"残云消雨脚，晴日丽东轩。\n扫地还除湿，焚香更助喧。\n蝶蜂狂欲舞，桃李静无言。\n草色交行径，翻疑仲蔚园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟春闺晓起","author":"邓云霄","text":"春深节气柔，独夜贮春愁。\n欹枕钟敲梦，开檐月在钩。\n栏花怜并倚，林鸟语相求。\n女伴催妆竟，招邀淇上游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"正月晦日晴","author":"邓云霄","text":"久雨沉山郭，苔衣上半墙。\n晴云噪乌鹊，晦日足风光。\n把酒春愁破，摊书午梦长。\n东园花正好，蜂蝶不须忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"下泷暴潦忽涨险过吕梁定后戏笔","author":"邓云霄","text":"潦涨翻惊险，装轻自觉夷。\n浮生元有命，蹈水信无私。\n傲骨寒崖并，贞心鬼物知。\n悠悠看出峡，对酒夕阳迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"下泷后逢午日韶阳观竞渡","author":"邓云霄","text":"危泷天上落，小艓片时过。\n幸不填鱼腹，那堪吊汨罗。\n双龙腾暮雨，两岸激洪波。\n酌罢敲韶石，临风奏九歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归里恭谒先墓","author":"邓云霄","text":"游子天涯返，松楸大几围。\n腰横新束带，肠断旧斑衣。\n怪鸟如人哭，凄风拂泪飞。\n还惊云日暗，错认梦中归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题卢元明白云楼","author":"邓云霄","text":"楼居原夙好，便可挟飞仙。\n尽眺大千界，还看尺五天。\n山河思往事，城郭阅流年。\n为问安期子，何时驾鹤旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端溪舟中听雨与陈永平对酌","author":"邓云霄","text":"客有迷津叹，那堪暮雨时。\n篷声兼棹响，云脚带帆移。\n节序催新历，壶觞对故知。\n茫茫今古事，流水只如斯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":24819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]