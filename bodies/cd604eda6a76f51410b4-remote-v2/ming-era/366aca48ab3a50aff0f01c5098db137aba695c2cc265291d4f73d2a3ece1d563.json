[{"title":"登天池山一首","author":"黄省曾","text":"芳序携觞榼，名山洽胜游。\n鹳巢加翠岫，龙象隐金楼。\n眺得尘劳解，来思坐卧留。\n平生采芝意，愧我未能酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登见海亭一首","author":"黄省曾","text":"孤亭标紫汉，高眺俯苍茫。\n绿雨残空色，黄尘阔海光。\n山微疑瞩岛，树远恍看桑。\n挂席须明发，波臣酹一觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒老君庙一首","author":"黄省曾","text":"伯阳怀大道，肖貌此山中。\n七色瞻灵气，三元仰圣风。\n庭松疑指树，殿像恍犹龙。\n安得如关尹，仙文一讨穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同王胡二总戎登淮安新城一首","author":"黄省曾","text":"淮海登飞观，欢言解客劳。\n湖含千舸阔，风引二城高。\n岁酒殊乡对，春鸿霁雪飘。\n故人情倍昔，天末慰凄寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客中闻歌一首","author":"黄省曾","text":"芳草王孙路，惊逢蟋蟀秋。\n听歌人下泪，把酒月临舟。\n云鸟随归翼，烟潮趁夕流。\n乡闺有思妇，此际想登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望虎丘一首","author":"黄省曾","text":"故苑返长洲，轻舠过虎丘。\n塔悬无隐树，云映不藏秋。\n香径红莲浦，金亭紫雾楼。\n自怜为客久，翻觉似初游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北固一首","author":"黄省曾","text":"北固转南川，丹徒挹紫莲。\n柳风含画鹢，芳草接长天。\n客尽黄金橐，魂消宋玉篇。\n故乡回首忆，明月送清弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秦淮客思一首","author":"黄省曾","text":"客馆傍朱桥，萧辰柰寂寥。\n柳随乡思挂，雁逐旅魂飘。\n秘宇崇云复，瑶城宝月销。\n江帆行色动，明发待归潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入京一首","author":"黄省曾","text":"四十抱山龄，三千入紫京。\n绿帷希董子，玄笔效扬生。\n自叹麒麟志，人传鹦鹉名。\n沉珠倘收取，愿尔作周祯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日客路一首","author":"黄省曾","text":"秋帆岂不疾，白云行处长。\n山川过几日，犹未到吾乡。\n闺里忆来雁，客中悲下霜。\n遥知旧林菊，寂寂自孤芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵夕咏一首","author":"黄省曾","text":"亮月殊乡满，疏萤旅阁辉。\n并悬心独耿，同寄影难飞。\n千里芙蓉枕，三山薜荔衣。\n故园虚引望，终夕梦魂归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵七夕一首","author":"黄省曾","text":"淅沥江楼雨，冥荧旅榻灯。\n乡心生白发，秋气逼青绫。\n楚酒淹浮蚁，吴歌忆采菱。\n捣砧闻帝国，佳夕寝还兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秦淮舟次对月一首","author":"黄省曾","text":"秋舸秦淮系，长杨夹霭清。\n忽看天上桂，来向客杯生。\n引剑参星色，闻歌杂雁声。\n陆台龙跃远，芳若对含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"毗陵午雪一首","author":"黄省曾","text":"北上逢穷岁，凝云九汉同。\n送舟冰是浪，吹面雪为风。\n玉树延成路，琼花坠作空。\n寄言羲御者，愿借一轮红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张湾发舟一首","author":"黄省曾","text":"驱马谢长安，言遵路水干。\n初于驾帆日，即起迨家欢。\n吴日悬归思，燕云送旅餐。\n王孙芳草绿，随路得行看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有怀一首","author":"黄省曾","text":"羁客思悠悠，临觞难解忧。\n江淹悲是别，宋玉恨非秋。\n时频明月换，春在桃花流。\n始知封侯贵，不换别家愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入齐地阿城闻蝉一首","author":"黄省曾","text":"朱夏玄蝉响，微风翠柳斜。\n禀应神府露，餐以帝孙霞。\n果荫陈王宅，桐疏虞子家。\n应为齐女唳，此地自清嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新闸晓行一首","author":"黄省曾","text":"征子戒晨鸡，津人鼓闸鼙。\n绿流沿翠鹢，红日起杨堤。\n汶上山相接，师庄水渐低。\n长天芳草岸，犹使客心迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四明观鱼舶出海一首","author":"黄省曾","text":"日落不避海，舟行皆向空。\n骈帆春浪绿，分席岛霞红。\n采药鸾丘上，候鱼龙窟中。\n江桥观去舶，不觉笑歌雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春初元旦在淮归又值五日一首","author":"黄省曾","text":"休矣泛黄河，怀哉动楚歌。\n一年予作客，二节此中过。\n椒叶空言颂，龙舟不弄波。\n他乡催物候，芳草积程多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"界首乘夕进帆高邮一首","author":"黄省曾","text":"西月坠长波，宵风利涉多。\n川光涵暝树，帆影直明河。\n牛斗初同野，劳欢不异歌。\n旅灯眠复起，时问路如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜述一首","author":"黄省曾","text":"暑解蘼芜带，风攲薜荔冠。\n夕山红日迥，秋水白云宽。\n客影侵吴野，游心掇楚兰。\n今宵明月色，犹作异乡看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓大佛寺一首","author":"黄省曾","text":"烟装恣冥览，浪迹拟云孤。\n地迥栖金寺，天春弄玉壶。\n闭门常卧岛，伏槛日临湖。\n时讶朱轮客，花林问隐夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"越江春泛一首","author":"黄省曾","text":"越中浮画鹢，芳候得嘉游。\n江碧云光定，林红春色流。\n客情兼燕影，琴兴更花洲。\n落日山阴道，悠然思故丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"溧水步至观堂假宿一首","author":"黄省曾","text":"秋水理归棹，徒行向溧阳。\n林愁红日尽，山苦白云长。\n客影随他骑，乡心过野芳。\n喜看村馆近，聊得举孤觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"溧阳旧县桥转至深溪一首","author":"黄省曾","text":"旧县久沦没，孤桥仍倚波。\n林坰罢城郭，洲岛接藤萝。\n静下仙人鹤，閒浮道士鹅。\n清溪深百尺，浩渺一舟过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拂水岩一首","author":"黄省曾","text":"水碧回空沸，泉香出壑微。\n云中含作雨，日里映成珠。\n远润龙芝草，轻沾杜若衣。\n本从银汉落，故作恋河飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重至拂水岩一首","author":"黄省曾","text":"窈窕仙山壑，泠风驭再过。\n此来新眺改，翻使昔情多。\n岁月宜琴驻，烟云任酒酡。\n更怜牛女夕，矶露委秋河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡淮二首 其一","author":"黄省曾","text":"落日渡淮口，孤帆挂杳然。\n舟前即沧海，树外但长天。\n橹声随棹曲，浊水间明川。\n渐看灯火近，夜泊酒垆边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡淮二首 其二","author":"黄省曾","text":"几日转回澜，黄波千里看。\n过淮风土别，入口意悰欢。\n贳酒芳樽继，明灯宝炬残。\n今宵五行枕，秪觉梦魂安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵客馆行药至乌衣巷转至秦淮青溪上一首","author":"黄省曾","text":"秋草延回陌，寒波流古溪。\n往时歌舞地，竹树使人迷。\n漠漠新烟泛，关关幽鸟啼。\n钟山遥望里，佳气满金闺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江闻笛一首","author":"黄省曾","text":"晓日度春潮，晴江媚柳条。\n挂帆沧海近，闻笛旅心摇。\n望处但无尽，济时何寂寥。\n彩霞天末起，疑是赤城标。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平凉歌一首","author":"黄省曾","text":"予闻秦陇地，山水秀中华。\n北落人烟近，羌夷笑语哗。\n仙人迷宝砦，边士戍莲花。\n谁在崆峒里，幽栖餐紫霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宴虞山招真治来云阁荅邓子文度一首","author":"黄省曾","text":"邓子儒林秀，婆娑六艺场。\n定居文学传，奚忝子游乡。\n古树藏云暗，空坛抱月凉。\n逢君十年外，樽酒意偏长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"盛子携酒城中为宴一首","author":"黄省曾","text":"中丘无俗鞅，多尔问荒涂。\n海岳人孤蹈，蓬蒿宅半芜。\n诗唯百一就，酒乃十千沽。\n月代东城客，西飞送夕舻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋日集顾子桐阴馆一首","author":"黄省曾","text":"绿竹旧为林，高梧新作阴。\n海棠既扬态，芭蕉复展心。\n况有云日弄，宛然岩壑临。\n萝轩迟澄月，天外暮霞沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"种竹一首","author":"黄省曾","text":"绿竹何年植，萧森翳碧林。\n琴边嵇宅满，酒畔习池深。\n月与澄秋影，云来助夕阴。\n长歌吾一倚，忽起凤凰心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日送程自邑汴游一首","author":"黄省曾","text":"宋都浮玉殿，黄帝具茨山。\n羡尔寻游地，长歌蹑屩攀。\n雁来罗绮歇，龙去白云閒。\n感激梁园里，秋风动旅颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人之徐州一首","author":"黄省曾","text":"五月宜江棹，清樽送远游。\n客衣轻白葛，去路引芳洲。\n草碧枌榆社，莺啼燕子楼。\n砀山云气歇，怆矣寄新讴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和栗应宏送张子言游北岳一首","author":"黄省曾","text":"我客长安日，君攀紫岳云。\n饯琴挥鹤绪，离剑把星文。\n傲掇金膏药，狂呼赤鲤群。\n桃花明月馆，千里忆高芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顾伯刚令馀姚一首","author":"黄省曾","text":"新擢侍含香，还除花县郎。\n近霄分帝泽，成宿接天光。\n北出薇垣外，南移牛女傍。\n他时想凫舄，遥瞩海霞长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送丘道人之曹县访师一首","author":"黄省曾","text":"旅鹢辞胥浦，探车入景山。\n岱云摇缅意，齐鹿对高颜。\n玄水珠将觅，黄舆金再还。\n此行逢紫气，应在尹公关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送萧解元子雍北上一首","author":"黄省曾","text":"门停剡溪棹，萧史特相过。\n揽辔有黄鹿，藏笼无白鹅。\n秋云来禹穴，寒月向清河。\n轩冕归相访，西山看薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蔡羽归西山一首","author":"黄省曾","text":"山闻如日观，君宅与云齐。\n西子澄湖在，毛公仙处迷。\n霜飞春草歇，月出夜猿啼。\n何日攀登遂，扬帆震泽西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蔡师古客武陵一首","author":"黄省曾","text":"日照岘山古，云归襄水春。\n青青洞庭草，千里引游人。\n崔井酒初熟，桃源花又新。\n羡君人代里，江汉得垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送惠生之太和一首","author":"黄省曾","text":"春色饶江舸，仙山觅太和。\n翠台孤日动，金殿五云多。\n汉水桃花泛，襄城燕子过。\n习家池尚在，为我寄清歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郡守戴公督学山东一首","author":"黄省曾","text":"青兖名州古，仙旌此地行。\n紬书周玉版，著录鲁诸生。\n岱岳云霞阔，尧祠日月清。\n经过逢胜迹，题咏有馀情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈侍御逅谪合浦一首","author":"黄省曾","text":"白笔簪来好，金门谏所希。\n凤凰虽铩翼，骢马有光辉。\n岁晏衔离酒，灯前恋别衣。\n暂为千里别，鸡赦拟言归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太白山人卜筑苕溪草堂诗以送之一首","author":"黄省曾","text":"西塞玄贞子，清风世所希。\n草堂君卜筑，千载影相依。\n乌蜀青山绕，桃花白鹭飞。\n时时有佳兴，明月啸云扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨进士令贵溪一首","author":"黄省曾","text":"灵山龙虎地，单父有荣除。\n青琐初登闼，朱鸾遂拥车。\n荆南推远器，田界撰新书。\n会见芳声达，乘骢耀里闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄山人归休宁一首","author":"黄省曾","text":"戚家希素德，文族隐高搴。\n紫芳金洞掇，升诀羽人传。\n吸景移尘骨，餐砂引世年。\n昌亭聊贳酒，分鹢饯长川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕送程子一首","author":"黄省曾","text":"自得黄山客，追随青眼稀。\n如何人北去，翻值雁南飞。\n远道开秋色，长河混日辉。\n夷门歌啸好，那可废思归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送田兵部归闽一首","author":"黄省曾","text":"嘉月停兰舸，金亭狎凤群。\n江回茂苑日，天吐鹿台云。\n暂喜流萍聚，先愁折柳分。\n何时携紫镜，同揖武夷君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人之汴一首","author":"黄省曾","text":"别思临宵雨，离樽傍早春。\n苑舟江外湿，河柳客中新。\n列炬催行色，题书间酒巡。\n梁园三月里，忆汝对花辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送谢海州纯奔丧还建宁一首","author":"黄省曾","text":"霜月巳临寒，怜君觅故山。\n孝思方尔剧，旅况若为閒。\n岁去图仍壮，愁来鬓益残。\n著书还忆子，应在墓庐间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送中书舍人王子永入京一首","author":"黄省曾","text":"秘掖文台旧，趋墀属少年。\n旭承鸡树月，花直凤池烟。\n八銮陪翊圣，五字草称贤。\n此去金门里，何殊玉苑仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赋杨花送别子永一首","author":"黄省曾","text":"绿缛昌亭柳，飞花引望悽。\n入歌参白雪，飘路学金堤。\n坠逐离琴乱，纷添别思迷。\n春风吹客意，同绕洞庭西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送道流入九华山访真士一首","author":"黄省曾","text":"念尔云装客，寻仙石照门。\n虬鸾思欲御，日月厌为樊。\n圣院参神侣，真峰访道言。\n桃花沿棹处，毋得更迷源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顾中舍汝嘉之京一首","author":"黄省曾","text":"青岁入金闺，皇家直报鸡。\n锦从天上赐，衔是圣人题。\n旧国离琴奏，春城别马嘶。\n行行何所赠，但有剑如霓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蔡行人子木使楚藩四首 其一","author":"黄省曾","text":"置酒此胥台，征铙晓吹催。\n山川离处瑟，形影别中杯。\n远树参愁挂，流潮杂绪洄。\n遥持绿水曲，去入楚门开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蔡行人子木使楚藩四首 其二","author":"黄省曾","text":"旷岁一谐逢，兰弦并咏风。\n还将千里别，劳我寸心中。\n草积王程绿，花飘客思红。\n云骖黄鹤地，兹有凤跄同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蔡行人子木使楚藩四首 其三","author":"黄省曾","text":"天节下金门，皇情眷玉藩。\n綵旒恭国典，珠匣惨王园。\n孔树山朝色，鹥舆泉夜恩。\n渚宫将楚挽，孝理佐弥敦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蔡行人子木使楚藩四首 其四","author":"黄省曾","text":"藻局承赍板，盘城进礼珂。\n三湘迎赋草，七泽润文波。\n宠露龙㡛浃，恩风玉座多。\n松门弦吹举，当有便房歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蔡子木再过草堂言别一首","author":"黄省曾","text":"征幰数言过，高情狎薜萝。\n好鸥从不厌，临凤羡宜多。\n门占五云聚，人在七林科。\n独叹今兹别，其如千里何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送方士入西山一首","author":"黄省曾","text":"大泽浮三翼，探源不谓遐。\n绿空萦柳叶，红水弄桃花。\n掌上仙人露，窗中玉女霞。\n馔麟将酒处，谁是蔡经家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邢君赐还彰德一首","author":"黄省曾","text":"珠玳王门客，南征自邺台。\n购图千里至，将雁九秋来。\n未解脂车倦，寻开饯祖杯。\n殷勤报双鲤，附取溯河回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送皇甫子循黄州推府一首","author":"黄省曾","text":"迢遥邾子国，此地拥朱轮。\n言携吴苑藻，去赋楚江春。\n赤壁云霞古，香垆气色新。\n倘过湘水上，应忆吊原人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邹礼部谦之入楚一首","author":"黄省曾","text":"五月吴门客，相逢不可留。\n客堤芳草换，行树暖莺流。\n江远摇归思，山长寄别愁。\n楚天迷送眼，云处忆携舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送罗纶还长安一首","author":"黄省曾","text":"送子长安去，南山归考槃。\n原间日欲落，江上春犹寒。\n溯河将纡轸，入关应始欢。\n吴云何缥缈，将分犹共看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]