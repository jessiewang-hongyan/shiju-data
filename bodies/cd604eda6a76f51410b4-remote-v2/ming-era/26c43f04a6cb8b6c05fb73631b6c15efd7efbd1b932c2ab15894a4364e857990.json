[{"title":"巢林和尚","author":"田登","text":"披衲投金地，谈空湛远心。\n生涯翻贝叶，踪迹寄巢禽。\n法鼓喧朝梦，昙花雨夜吟。\n几因观色相，物物自萧森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29376,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游仰天寺","author":"田登","text":"上方天日近，下界水风幽。\n泉合千山脉，蝉空四壁秋。\n僧床林影黑，佛顶电光流。\n相对浑疑梦，浮生一过舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29377,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卫辉道中","author":"田登","text":"黄土冈头路，炎蒸势欲焚。\n樵枰秋涧石，牧笛比干坟。\n野阔蝉鸣树，天空山吐云。\n故人樽酒别，怅望午风薰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29378,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"彭幸庵尚书致政","author":"田登","text":"息驾秋风兴，閒身未老年。\n宦情风扫叶，心事日行天。\n魏阙风阴暮，秦山花鸟妍。\n行藏如有论，屈指道公全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29379,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨邃庵先生致政","author":"田登","text":"云物动高秋，离亭注别愁。\n世纷凭塞马，心迹寄江鸥。\n雷雨明周旦，溪山待许由。\n相看风浪急，独喜上扁舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29380,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春游","author":"田登","text":"曲曲沿芳径，纷纷点落花。\n莺声随远岸，雁影落平沙。\n薰入游人醉，青归去鸟赊。\n伤春回远眺，落日暮山斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29381,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黄鹤楼","author":"田登","text":"飞阁枕江皋，仙人跨海鳌。\n潮回留岸阔，云去见天高。\n春色看晴树，秋风鼓夜涛。\n登临开远眺，长啸五陵豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29382,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岳阳楼","author":"田登","text":"渺渺洞庭波，君山翠拥螺。\n江空含月小，地剩得天多。\n寒色征鸿阵，秋风返棹歌。\n湘灵不可问，落日下烟莎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29383,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿鱼山","author":"田登","text":"鱼山留晚棹，寂寞坐更深。\n暗浪喧舟腹，寒灯映水心。\n颓风堕墨泪，高调忆钟琴。\n江树识人思，萧萧寄远吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29384,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九峰寺","author":"田登","text":"云树拥山头，林声杂乱流。\n篆沈僧昼寂，门掩佛灯幽。\n残黛花惊雨，高吟蝉诉秋。\n登临横远望，身世拟轻鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29385,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"临湘道中","author":"田登","text":"望远尘襟阔，林深去马迟。\n雨喧春圃绿，风动晓山吹。\n鼓浪鱼惊饵，拖声蝉过枝。\n山灵如有意，花鸟慰春思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29386,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蒲圻道中","author":"田登","text":"积雨湘江暗，林深云满蓑。\n苍山奔夜涧，老树引春萝。\n白雪纷鸥鹭，青钱点芰荷。\n客心归未遂，肠断楚山莎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29387,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咸宁道中","author":"田登","text":"南望山陂驿，山连草树幽。\n水云浮幻象，烟雨结春愁。\n花绽猩唇血，泉分燕尾流。\n午薰民愠解，蚕老麦花秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29388,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游玉泉寺","author":"田登","text":"秋日玉泉寺，水喧山腹深。\n石泉喷白雪，岩树插青簪。\n幻合烟花梦，凄飞风叶吟。\n喧嚣共幽寂，无复解钟琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29389,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"华容道中","author":"田登","text":"秋树千林合，幽塘一径通。\n云开山秀近，萍落水天空。\n鸟下苍烟食，人眠翠竹宫。\n闾阎民隐切，愁苦望春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29390,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九溪山行","author":"田登","text":"蹑屩跻天庭，旅车逐井陉。\n鹤巢云窦白，竹引石泉清。\n潭黑蛟方蛰，峰高猿亦惊。\n亭亭山木拱，野老不知名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29391,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"归州峡","author":"田登","text":"城堞势凌空，江流百折东。\n云蒸神女峡，春沁楚王宫。\n民屋高低见，山花寂寞红。\n夜深奔浪恶，风雨撼苍穹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29392,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"巴风","author":"田登","text":"山腰盘复道，高下住人家。\n物色冬青树，时新谷雨茶。\n枫团凝远盖，泉落缀惊蛇。\n记得旋舟日，东风桃李花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29393,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"远安山行","author":"田登","text":"荆门复西下，山僻水声幽。\n民屋云中结，泉声石上流。\n农桑春不扰，鸡犬夜忘忧。\n却忆观风日，庚辰岁暮秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29394,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚驰应城","author":"田登","text":"午发刘家隔，黄昏入应城。\n暮烟渔火暗，秋色野帆轻。\n雁阵西风夜，星缠南浦晴。\n远心簪冕挂，扰扰负平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29395,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和薛君采王政功德寺韵","author":"田登","text":"飞锡超三昧，谈空寂万缘。\n祥云停祗树，法雨暗诸天。\n化鹤春巢翠，降龙夜咽泉。\n劫尘归幻梦，功德两愀然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29396,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"少年行","author":"田登","text":"晓色繁华动，微风燕子忙。\n万钱无下箸，百妓有专房。\n弦管春声细，楼台秋夜长。\n星沈更漏彻，犹逐梦魂香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29397,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过隐者庄","author":"田登","text":"幽轩停白昼，心古万缘轻。\n春壑花争放，澄潭浪不生。\n云山当近户，风雨望高城。\n归去渊明社，欣欣木正荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29398,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨希仁起复总兵官","author":"田登","text":"胡马横霜塞，彤庭诏剪颇。\n重颁新斧钺，迅扫旧山河。\n细柳将军令，天山壮士歌。\n龙城降处剑，休带血痕多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29399,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"刘孔林宾相饯别","author":"田登","text":"款酌延长夏，论交重远心。\n云开青嶂晚，鸟下□芜沈。\n内苑红妆妓，南薰绿绮琴。\n夜凉更秉烛，一任主情深。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29400,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜纳凉","author":"田登","text":"暑退蝉鸣秋气清，傍檐枯坐旅愁并。\n香沈夜榻疏灯暗，云捲晴空孤月明。\n覆载敢忘犬马报，江山终结鹭鸥盟。\n天涯此日还为客，后夜清光何虚盈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29401,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次泾毕渡小憩山寺","author":"田登","text":"霏霏烟雨促寒旌，野寺柴关暂息征。\n石洞坐苔僧补衲，沧浪伫马客湔缨。\n㳙㳙瀑布分空翠，寂寂归鸿唳晚晴。\n更上高原回首望，痴云宿雾两山平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29402,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次安定","author":"田登","text":"星槎渺渺逐行云，骚客情悰入雁群。\n寒日人过天水郡，高原秋老隗嚣坟。\n民居土穴冬应暖，秋垦青山昼正勤。\n风俗淳庞犹太古，莫教全璞易深文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29403,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次潜麻湾","author":"田登","text":"萦纾鸟道上潜麻，白草黄云映晓霞。\n一节中郎还朔漠，千年柱史度流沙。\n雉飞东胜随秋烧，梅落西风倚暮笳。\n弹铗壮心期未遂，数声长啸雁行斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29404,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次红城","author":"田登","text":"同云积雪伴寒征，遥捧纶音绝漠行。\n万里关梁催晓梦，残更鼓角壮秋声。\n刍粮起伏依山寨，兵卫森严入夜城。\n拭尽征袍尘土梦，夜深霜冷月华明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29405,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"边夜","author":"田登","text":"红尘无日憩奔忙，万里河梁客思长。\n鬼哭空濠秦将士，碑沈衰草汉文章。\n民谙风土遵王度，天简河山壮帝疆。\n吟罢晚钟清夜永，疏林月影浸寒霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29406,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"入朝","author":"田登","text":"舜庭鸾凤仪皋契，薰入南风奏管弦。\n宫殿雨晴高燕雀，冠裳春暖去貂蝉。\n长安抱鼓思张敞，江国登楼忆仲宣。\n愿祝遐昌神祚永，无穷春色下尧天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29407,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"感中原","author":"田登","text":"中原遥望暮云连，杀气沈沈恨满天。\n野老裹瘢埋战骨，佳人抆泪湿华钿。\n庄园烧尽馀丘土，桑柘荒残宿野烟。\n吏畏官军频驻劄，夜深横索里人钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29408,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"报国寺和张子醇同年韵","author":"田登","text":"兴满禅林坐日长，漫拈吟笔写山房。\n草含梅雨传新绿，人醉松风话晚凉。\n碧篆款飞僧昼静，红尘空逐宦心忙。\n百年莫惜杯中物，岐路令人易断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29409,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游西山寺再用前韵","author":"田登","text":"水僻山深路转长，攀萝沿磴到僧房。\n危桥石抱村流急，古殿鹤巢嵓树凉。\n百计巧思蚕更拙，片时春梦蚁空忙。\n凭君莫动登楼思，故国山河易断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29410,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"瞻华山","author":"田登","text":"巨灵危峭峙金天，俯瞰群山脉脉连。\n东岱北恒分保障，秦皇汉武历封禅。\n金城秀绕三峰翠，玉井花开十丈莲。\n盛世褒封应有自，愿教灵异产多贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29411,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元宵","author":"田登","text":"太平文物重春宵，驾海鳌山万烛烧。\n绝壁火云光烂熳，交花玉树影飘飖。\n朱门豪气横金马，绣幕春风浮玉翘。\n鼓角高寒明月午，暗尘风静夜天遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29412,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日即事","author":"田登","text":"斜风细雨入林深，寄傲南窗对远岑。\n花放晓风红作阵，柳翻春水绿成阴。\n酒因地僻难成醉，天为诗豪剩赏心。\n梅子传黄桑柘绿，困人天气思沈沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29413,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"残春即事","author":"田登","text":"晚春斜日草堂暄，车马稀迟独掩门。\n彭泽柳遮元亮宅，东山花发谢安墩。\n经谈往事心惟旧，客话浮生酒在樽。\n独坐寒斋风雨夕，鸟啼花落又黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29414,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日午坐","author":"田登","text":"午风驱暑昼庭凉，古木阴阴夏日长。\n兰馆雪纷千缕白，麦畴云散一川黄。\n夜光暗绕青藜杖，吟笔晴看古锦囊。\n高卧北山坚不起，莫教猿鹤怨山芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29415,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吉道行出知莘野","author":"田登","text":"飘渺云山接素秋，除书今喜牧樊州。\n看碑口炙思羊祐，驻马心诚拜武侯。\n霜月夜悬乡国梦，春风晴散井闾愁。\n莫言棘枳成幽独，寄取梧冈引凤游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29416,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"约胡重器王子章陈大用三僚长游城北寺","author":"田登","text":"镳联晓色入空林，殿阁森沈草树阴。\n云壑老禅归昼寂，石林高鸟自春吟。\n幡幢渺渺尘寰隔，风雨萧萧法相深。\n片日浮生真幻梦，浑忘身世有华簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29417,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日赴友人饮","author":"田登","text":"临轩高宴雨初收，一叶梧桐万境秋。\n鸟带夕阳归草树，雁拖寒色下沧洲。\n诗赓琼玖人依竹，酒泛歌钟风满楼。\n玉宇高寒心更切，江湖廊庙总关愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29418,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬日友人携酒至留饮","author":"田登","text":"野人携酒过山城，溪蔌林殽醉瓦瓶。\n霜树萧萧枯叶战，云川漠漠暮烟征。\n兴来杖履寻丹壑，老去诗篇伴短檠。\n从此不知人事改，栏花庭草任枯荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29419,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"慈恩寺吊古","author":"田登","text":"慈恩塔畔曲江路，坐想人文盛集时。\n断碣秋深苔长绿，废园春老树无枝。\n三川禾黍王侯第，四壁龙蛇今古诗。\n惟有南山浑似旧，数峰青影自参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29420,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游仰天寺","author":"田登","text":"梵宫金碧隐山隈，古殿深沈老碧苔。\n万颗珠玑岩溜下，一庭罗绮槛花开。\n天空霜月千山晓，秋引松风万壑哀。\n晓起凭栏瞻望处，彩云丹树巳成堆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29421,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新乡道中","author":"田登","text":"伏城风雨杂烟冥，野店柴关半不扃。\n五月地横千里赤，十年官负一袍青。\n帝京草木沾周泽，人海英雄泛楚萍。\n唾手功名今偃蹇，几因尘土鬓毛星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29422,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"保定道中雨晴","author":"田登","text":"柳塘春水泛鸣蛙，咫尺云山近帝家。\n绿野桑麻新雨露，春城弦管旧烟花。\n令谙卓茂循良传，人逐张骞使者槎。\n远道夕阳归去晚，隔林啼鸟送征车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29423,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云山烟水图","author":"田登","text":"楼阁隐烟迷野望，枫林落木动秋容。\n水通云窦倾寒玉，山入潭心倒碧峰。\n彭泽柳庄风雨暗，严滩钓石藓苔封。\n长杨五柞春光好，应让云山第一重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29424,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"织锦回文图","author":"田登","text":"玉关人远戍烟迷，别思惊心寄锦题。\n合浦月明珠蚌泪，洛阳春晓绮莺啼。\n书凭白雁牵愁迥，梦绕黄云入塞低。\n独喜孟光偕老约，百年鼓瑟赋荆藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29425,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蒲圻道中","author":"田登","text":"湘江风露引征车，入岫穿林玩物华。\n山水禁宽无贡赋，翠微烟密有人家。\n雨舂春稻黄云熟，日照飞泉白练赊。\n何处一声樵牧笛，飞飞落尽野棠花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29426,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"刘尧夫宪副升广东大参","author":"田登","text":"十年独守皋陶法，今日应分召伯棠。\n五岭春风鸣翡翠，九溪秋色上桄榔。\n马援铜柱风声远，陆贾新书计虑长。\n莫把天南论绝塞，鼎钟勋业在遐方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29427,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送客","author":"田登","text":"时事历多艰，愁心千万结。\n把袂对斜阳，相看不忍别。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29428,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"巴东峡中","author":"田登","text":"去时冰雪深，归来桃李艳。\n短棹羁春愁，云深江路暗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29429,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"未央饯行","author":"田登","text":"汉业追千载，别筵重一游。\n相看成俯仰，寥落满襟秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29430,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"平定道中","author":"田登","text":"十日山行今日尽，山风猎猎山云近。\n解道前途是坦行，一望那知山更峻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29431,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"获嘉道中","author":"田登","text":"山城雨过青山晓，杨柳池塘风线袅。\n帝城北望苦无多，漠漠烟云丹凤渺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29432,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渔父词","author":"田登","text":"长江渺渺烟波绿，罢钓渔翁船傍竹。\n摸鱼换酒月明归，醉倚纶竿春睡熟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29433,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初朝","author":"田登","text":"宫柳含烟晓日晴，太平天子御承明。\n晓钟阊阖开仙仗，次第班行引凤鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29434,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"思乡","author":"田登","text":"屈指光阴春复秋，乡心国思两牵愁。\n行云流水无情思，每到花时不上楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29435,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和虎谷王先生韵","author":"田登","text":"百年公论分明日，几度人情反覆间。\n独有空山飞鸟倦，不因风雨解知还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29436,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"美人寓意","author":"田登","text":"玉人春望隐蒹葭，金凤簪云鬓绾霞。\n薄暮倚栏横翠袖，东风吹雨惜残花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29437,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"巴东峡行","author":"田登","text":"晓泊孤舟春水生，远滩双棹布帆轻。\n消魂一觉乡心梦，卧听四山风雨声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29438,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"远安山行","author":"田登","text":"枫林啼鸟杂村舂，晓色征鞍寄远踪。\n不尽溪声寒水碧，四山霜叶幻秋容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29439,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿香籍寺","author":"田登","text":"紫翠烟消石径斜，半湾茅屋是僧家。\n禅心不动楚山碧，落尽萧萧松荻花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29440,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿香绿寺","author":"田登","text":"索莫秋林烟雨中，枫岩盎盎水漴漴。\n衡阳雁杳寒云隔，惆怅半山霜叶红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29441,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿玉泉寺","author":"田登","text":"宦海尘踪逼岁忙，霜清月冷到僧房。\n孤灯岑寂山更寂，一榻篆烟秋夜长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29442,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬光泽王召饮","author":"田登","text":"霜台独夜月明时，邂逅无缘醉酒卮。\n遥想玉人当此夕，醉吟红烛困秋思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29443,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书紫荆关龙华铺壁二首 其一","author":"田登","text":"溪云初起山围带，寒雨斜飞风络丝。\n猿鹤不谙尘俗共，惊闻人语上高枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29444,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书紫荆关龙华铺壁二首 其二","author":"田登","text":"九天运转三阳泰，一节霜寒万灶军。\n烽火不惊春野静，戍楼空照夕阳曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29445,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖上词","author":"田登","text":"鸡鸣茅店曙烟高，望望乡关别思劳。\n梦合乍惊蝴蝶散，一江风雨撼惊涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":29446,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]