[{"title":"哭江进之 其二","author":"袁宏道","text":"案有君遗迹，时时动我悲。\n梦中呼白也，卷里哭微之。\n骨似凝冰石，心如静水池。\n太玄那得比，嘱累有佳儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭江进之 其三","author":"袁宏道","text":"一笑凌云去，高寒自少尘。\n骚魂皆楚鬼，吊客尽秦人。\n作诔倾南国，移书诅北辰。\n斯文凋丧尽，何用死麒麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭江进之 其四","author":"袁宏道","text":"偏是佳人少，鸺鹠日日鸣。\n应刘皆早世，晁贾竟虚生。\n雪涧寒当户，渔梁怒满城。\n怜才与惜宝，天似未分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭江进之 其五","author":"袁宏道","text":"蜀魄悲鸣后，巫猿叫啸初。\n峨嵋徒有黛，巴水不成书。\n女鬼行云侍，仙邻卖卜居。\n浣花溪上叟，情切旧乡庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭江进之 其六","author":"袁宏道","text":"好手经炉冶，匡时正老成。\n文通才未尽，元静职犹轻。\n妖作长沙鵩，帐空澧水萤。\n花源留迹处，莎草背阶生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭江进之 其七","author":"袁宏道","text":"节节来余梦，溪云湖柳边。\n浪仙神尚瘦，米芾鬼犹颠。\n花国恣题品，珠宫任纂编。\n閒时出谐史，一笑谑诸天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭江进之 其八","author":"袁宏道","text":"湘水濯魂清，纷纷兰芷生。\n桃花仙路艳，薜荔鬼衣轻。\n喜去朝虞帝，悲来过屈平。\n沙萝村口上，夜引瞿童行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭江进之 其九","author":"袁宏道","text":"作者心良苦，悠悠世岂知。\n近俳缘矫激，取态任斜攲。\n江阔无澄浪，林深有赘枝。\n向人言似梦，无计解愚痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭江进之 其十","author":"袁宏道","text":"薄俗好检点，因循愧少箴。\n只疑如豆目，未达似空心。\n琴败孤音绝，林荒破宅深。\n期君一百载，只字双南金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周观国还会稽兼寄陶周望兄弟 其一","author":"袁宏道","text":"江流澎湃处，一曲是官衙。\n小邑城三里，荒垣市几家。\n斗湖曾载月，浪柳也吹花。\n局蹐真如茧，能禁念若耶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周观国还会稽兼寄陶周望兄弟 其二","author":"袁宏道","text":"且莫听啼魂，烟岚路亦昏。\n山连内史宅，水到贺公门。\n晓月兰桡市，春风黛绿村。\n个年题壁处，霜洗旧苔痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曾雷二太史过柳浪用杜韵 其一","author":"袁宏道","text":"云岚深几曲，五月气犹寒。\n月下兼花下，林端史水端。\n愁来诗监押，老至道遮阑。\n识得岁身计，尘劳也自安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曾雷二太史过柳浪用杜韵 其二","author":"袁宏道","text":"劝我早经营，三山海上城。\n亦如怜素女，其那忤方平。\n青鸟曾经约，丹台也注名。\n竹枝江上雨，难道是无情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄平倩久无书有僧自蜀来传其厌世余不信数日后陶周望书来云闻平倩有疾且求消息于余余谓小修曰必无他诗以志之","author":"袁宏道","text":"积雪峨嵋路，三年渺去鸿。\n岷江惟有浪，巫峡祗闻风。\n惊绝西僧语，愁深太史筒。\n子瞻定不死，吾已料天公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西来僧云平倩初病痹今已痊复志喜","author":"袁宏道","text":"西望嘉陵信，迢迢半影鸿。\n黄州元不死，白傅已无风。\n小近临邛黛，新开郫酒筒。\n僧言真实否，吾欲让庞公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日同龚散木能者崔晦之邹伯学李子髯携妓泛舟和尚桥 其一","author":"袁宏道","text":"白舫形如鹄，青娥姓是卢。\n衣香泥翡翠，扇影怯鹈鹕。\n石竹和人籁，山花爇野炉。\n遥看十里水，一片芙蓉湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日同龚散木能者崔晦之邹伯学李子髯携妓泛舟和尚桥 其二","author":"袁宏道","text":"试说鸳鸾侣，何如鸥鹭群。\n溪光描翠黛，竹影写罗裙。\n云日鱼鳞气，霞波雉尾文。\n鹤飞冲树起，天半一声闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起独坐","author":"袁宏道","text":"荒草绿如烟，何秋不可怜。\n病家无客至，小犬亦高眠。\n开帙寻诗料，添衣缺酒钱。\n闭门读庄子，秋水马蹄篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起偶题 其一","author":"袁宏道","text":"对客心如怯，窥铜只自怜。\n负暄疏败发，发箧理残篇。\n名岂儒冠误，病因浊酒痊。\n浮生喻泡影，何以乐青年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起偶题 其二","author":"袁宏道","text":"独坐真成闷，孤砧急暮声。\n乾坤偏恶道，世路几狂生。\n骚雅原无命，湖山剩有情。\n一丘何不可，身外即浮萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起偶题 其三","author":"袁宏道","text":"强欲亲暾日，无那怯晓风。\n缠绵悲二竖，坐起仗双童。\n世路他如梦，浮名我失弓。\n一番三径里，秋菊又成空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起偶题 其四","author":"袁宏道","text":"不断青云梦，难堪白发情。\n跳梁山鬼妒，落莫酒人轻。\n色界身终苦，无生学未成。\n浮沤能几许，枉自觅枯荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花朝即事","author":"袁宏道","text":"雨过庭花好，开尊亦自幽。\n不知今夕醉，消得几年愁。\n一朵新红甲，四筵半白头。\n久知行乐是，老矣复何求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江涨","author":"袁宏道","text":"滟滪三冬雪，潇湘五月波。\n疾流翻地转，远势触云过。\n县尉临江祭，巴人下水歌。\n世平无孟珙，父老恨如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事","author":"袁宏道","text":"俗态有如此，谁云道不贫。\n黄金贵贱士，乌帽是非人。\n公叔绝交甚，东方慢世真。\n浮云看物理，浪迹混风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋扇","author":"袁宏道","text":"濯濯齐纨素，团团明月辉。\n舍羞王氏女，失宠汉宫妃。\n出入心犹在，炎凉态已非。\n自甘藏箧笥，不敢触寒威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日泛舟","author":"袁宏道","text":"泛泛鵁鶄近，深深雀鹳闻。\n空潭不受暑，野竹半捎云。\n公子收行盖，佳人晒舞裙。\n垂杨乱荇藻，日色冷纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得李宏甫先生书","author":"袁宏道","text":"似此瑶华色，何珠空谷音。\n悲哉击筑泪，已矣唾壶心。\n迹岂焚书白，病因老苦侵。\n有文焉用隐，无水若为沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬菊","author":"袁宏道","text":"众芳无不改，篱菊晚犹开。\n护叶多编竹，怜香自剪莱。\n惊心寒节破，载酒故人来。\n忽忆东篱叟，狂歌试举杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江行","author":"袁宏道","text":"霞彩收晴色，澄波媚夕晖。\n饥鹰奔树冷，沙樢触人飞。\n墩叟迎儿出，乡童负犬归。\n少年饶酒力，何事怯寒威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登台","author":"袁宏道","text":"登台当此日，潦倒尽馀驩。\n古木何年有，林花尽日寒。\n霞来鳞作市，山晚气成澜。\n去去沧江暝，狂歌兴未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕前八日","author":"袁宏道","text":"每恨年光驶，东风又一时。\n入门花自媚，出谷鸟先知。\n宦去嵇康懒，情来育长痴。\n无为愁暮景，幽意在南枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐别彭子","author":"袁宏道","text":"寂历严更漏，凄其旅客情。\n倾肠谈近事，屈指数游程。\n寒气冲筵入，乡心冒酒生。\n经年事奔走，名利一无成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"社中","author":"袁宏道","text":"宿昔城南约，苍茫十载情。\n交游悲喜尽，文字揣摩成。\n古屋繁阴入，空阶冻鸟行。\n终年雅搦管，辛苦是书生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小斋","author":"袁宏道","text":"情至观无始，愁来宝奈何。\n蠹行粘败粉，燕起触檐罗。\n往事惟长啸，新知一放歌。\n鹓雏虽饿死，不与雀争多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"迎九","author":"袁宏道","text":"节物何堪问，流光转自哀。\n世情搔首过，秋色闭门来。\n才子新开社，参军旧有台。\n菊花才作药，迟尔共衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆蟹","author":"袁宏道","text":"鄂州为客处，紫蟹最堪怜。\n朱邸争先买，青楼不计钱。\n昔年桐乳下，今日菊花前。\n咫尺晴川水，无由见尔鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日同龙君超君善家伯修郊外小集","author":"袁宏道","text":"避却红尘子，晴郊共举杯。\n踏云穿宝阁，立马问金台。\n古木无心长，杂花不定开。\n东南饶胜友，喜与二郎来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿村中","author":"袁宏道","text":"古木攒幽壑，丛篁蔽小祠。\n篮舆村犬吠，罗服野人疑。\n稻熟家家酿，山香处处诗。\n田翁强解事，款款具威仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"示社友","author":"袁宏道","text":"所至成三笑，居然似七贤。\n社开正始后，诗数中兴年。\n一代称同轨，千秋欣执鞭。\n古来藏二酉，不必大都传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同邹伯学过崔晦之村庄","author":"袁宏道","text":"携得城中友，联镳把臂来。\n探阄人踊跃，问姓俗疑猜。\n邻酒无因至，霜花有限开。\n一丘荒楚里，门户蔽蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周尚宝左迁海澄典史 其一","author":"袁宏道","text":"羯虏终无赖，馀波横及人。\n清时骄魍魉，平地蹶麒麟。\n去国宁辞谤，投荒幸有身。\n边筹终及尔，勿复叹沉沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周尚宝左迁海澄典史 其二","author":"袁宏道","text":"几度青门抑，荣枯送尔行。\n庙谋何日定，边事仗谁成。\n名以批鳞重，恩因市虎轻。\n知君心独苦，万死亦关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周尚宝左迁海澄典史 其三","author":"袁宏道","text":"十年声籍甚，一日去长安。\n作赋元投楚，为文欲吊韩。\n云开龙首出，雨过鳄溪寒。\n到处青山好，何忧行路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日江上小集","author":"袁宏道","text":"物色千林换，江声四面澜。\n脱冠酬胜节，呼酒贺新寒。\n童子携方罫，庖人进鲙盘。\n秋郊如醉里，潇洒一凭栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"袁宏道","text":"尘世无暇日，孤馆有馀情。\n黄金铸知己，青编列友生。\n事佛心难定，学仙道不成。\n去去双田下，兄弟事耦耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊行同龚散木能者邹伯学","author":"袁宏道","text":"高柳藏山寺，杂花缀水滨。\n青溪六七里，白帢两三人。\n钟釜蚊䖟过，烟霞鹿豕邻。\n箕踞亦是礼，何必取冠巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉鱼李太清书斋","author":"袁宏道","text":"尚有青云旧，谁云白首新。\n孤尊相对日，万死可怜身。\n曝衲惊黄鸟，开轩跳紫鳞。\n名臣何必贵，衰腐据要津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日邹伯学园亭","author":"袁宏道","text":"几坐无俦侣，观空绝想尘。\n床头高士传，花下上皇人。\n养鹤移茶灶，怜鱼辍钓纶。\n蒙庄去已久，斯意竟谁陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日即事 其一","author":"袁宏道","text":"一官因懒废，万事得禅逃。\n岁月谈空老，风尘拂袖高。\n贫交殊面背，薄俗厚皮毛。\n不解和光指，空斋坐郁陶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日即事 其二","author":"袁宏道","text":"闷即摊书读，长年一腐儒。\n开门残雨过，攲枕片云孤。\n世事输棋局，人情转辘轳。\n浮生宁曳尾，断不悔江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日同龚能者崔晦之邹伯学纳凉李子髯斋中高柳下","author":"袁宏道","text":"高柳著溪烟，团团翠可怜。\n空街摇白水，疏日冷青钱。\n原宪贫非病，维摩疾是禅。\n居然城廓里，一种小林泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶题","author":"袁宏道","text":"得句题蕉叶，裁冠费笋皮。\n宦情三不可，禆理百无知。\n野馆繁栀子，晴窗语燕儿。\n谢安何小草，相业仅能棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄沈介庵","author":"袁宏道","text":"不谓晴川阁，同时失此人。\n龙门吾有意，鱼服尔何神。\n封事惊来草，除书怪积薪。\n和光古有语，好得耐风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初秋","author":"袁宏道","text":"负俗将无傲，閒居合有秋。\n骄阳犹避鹊，小雨亦呼鸠。\n中散交多绝，司空宦总休。\n明知悲冉冉，何苦不沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴 其一","author":"袁宏道","text":"少年多浪迹，老大合幽栖。\n事业卑牛口，生涯尚马蹄。\n避人嘲自解，隐几物难齐。\n每忆山中友，秋来好杖藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫兴 其二","author":"袁宏道","text":"独往吾何有，狂痴世所怜。\n一身书蠹后，万事酒杯前。\n礼乐从先进，交游附少年。\n昨来益自喜，信口野狐禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江崩及城","author":"袁宏道","text":"城郭荒如许，迁来得几时。\n江通夔子国，潮打武侯祠。\n六代馀封在，三分故里疑。\n焉知深谷底，不有万山碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄散材","author":"袁宏道","text":"只觉秋悲苦，那堪别赋工。\n予瞻南去雁，尔望北来风。\n寒日疏篱菊，清霜落井桐。\n江湖夕照里，登眺许谁同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄杨敦初 其一","author":"袁宏道","text":"野树吟秋日，江云送目初。\n百年谁命驾，两地且传书。\n潘岳功名薄，庄生吏体疏。\n禅心知不减，挥麈近何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄杨敦初 其二","author":"袁宏道","text":"万事传经懒，官閒且自由。\n闭门无不可，得秫更何求。\n玄草扬云宅，清时王粲楼。\n莫言工作赋，此地易悲秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆弟 其一","author":"袁宏道","text":"万里南征路，扁舟去不来。\n赋投鹦鹉水，诗上凤凰台。\n天地穷相傍，云霄蹇自哀。\n千秋无汉武，司马一庸才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆弟 其二","author":"袁宏道","text":"骤传伏枕去，转觉泪沾巾。\n短发三江棹，孤蓬四海人。\n文章妻子怪，姓字友朋嗔。\n兄弟皆衣紫，君胡命苦辛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆弟 其三","author":"袁宏道","text":"去住非无谓，蹉跎似不羁。\n亲朋尽欲杀，知己半相疑。\n独我能青眼，因君是白眉。\n东来书一纸，读罢泪如丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登高有怀","author":"袁宏道","text":"秋菊开谁对，寒郊望更新。\n乾坤东逝水，车马比来尘。\n屈指悲时事，停杯忆远人。\n汀花与岸草，何处不伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过古寺","author":"袁宏道","text":"红桥过雨润，黄叶会霜稀。\n古殿催金榜，空塘落水衣。\n畏人寒鸟窜，护法老龙饥。\n醉语兼禅语，都非第二机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿僧房","author":"袁宏道","text":"夜雨沉清磬，霜林起暮鸦。\n莲台三品叶，佛果一时花。\n觉路昏罗縠，禅灯黑绛纱。\n早知婴世网，悔不事袈裟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆弟 其一","author":"袁宏道","text":"尚有他乡客，那堪两地春。\n文章聊玩世，儒墨竟疑人。\n别后山川换，愁来岁月新。\n沧江一万里，浊酒向谁陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆弟 其二","author":"袁宏道","text":"东去交多少，南询兴有无。\n高天鸿鹄举，世路马牛呼。\n骚雅命难达，江湖迹易孤。\n步兵虽嗜酒，倘亦恨穷途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"异僧","author":"袁宏道","text":"买印支公僻，输瓶座首能。\n咒言听似鸟，梵字写如藤。\n托钵施仙饭，支床面佛灯。\n一身犹不用，何处有三乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":44877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]