[{"title":"杨明府两湖德咏 其一","author":"沈守正","text":"孝女祠边望锦舟，弦歌忽送武林秋。\n一江南北如衣带，今日讴歌昔日愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨明府两湖德咏 其二","author":"沈守正","text":"关西今见汉循良，引水虚堂化瑟张。\n父老不须忧蔽芾，它年堤柳是甘棠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹤冢","author":"沈守正","text":"刺眼青山入酒杯，花神月魄满高台。\n陡然一啸浮云外，为问双魂来不来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山房堂牡丹 其一","author":"沈守正","text":"山中九锡笑无多，奇石清泉木叵罗。\n一捻嫣红撑午日，不知姚魏更如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山房堂牡丹 其二","author":"沈守正","text":"粉晕红潮俨向人，雨晴晴雨养花神。\n六桥急管芳非尽，此地能留十日春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山房堂牡丹 其三","author":"沈守正","text":"千古争传供奉诗，三郎灰烬巳多时。\n纵无妃子倾城笑，不使花王听旧词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和长蘅画柳扇诗","author":"沈守正","text":"西湖十里柳如丝，爱煞轻烟暮雨时。\n为问风流谁得似，李郎小笔舞腰肢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中柬仲美","author":"沈守正","text":"愧我无人废蓼莪，邻家社饮足高歌。\n平阳小队霓裳舞，闲过秋风却为何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠湖州康半刺 其一","author":"沈守正","text":"吴兴旧事足弦歌，争比康侯义问多。\n地尽鄣西开化日，天移闽海作恩波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠湖州康半刺 其二","author":"沈守正","text":"千载相传佐郡难，颍川声绩起河南。\n冰壶映彻无涯际，人拟苕溪夜月看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠湖州康半刺 其三","author":"沈守正","text":"两岐麦秀稻花秋，打鸭船随问俗舟。\n何事儿童迎竹马，至今惟说郭并州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠湖州康半刺 其四","author":"沈守正","text":"口碑无日可销沉，岘首山高霅水深。\n笑杀襄阳邹从事，秪将姓字寄登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦长蘅","author":"沈守正","text":"故人踪迹在何处，一簟凉生冉冉来。\n暖送问寒如昨日，不堪秋色满高台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦谷王","author":"沈守正","text":"□梁落月白如霜，水深浪阔鱼龙狂。\n广州去此五千里，一夜三回梦举觞。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代人挽外舅","author":"沈守正","text":"敢云冰玉腾高誉，十载提携梦见之。\n愧我哭翁无长物，满庭霜霰一行诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书金相士册","author":"沈守正","text":"口似悬河野鹤形，蒯缑短剑挟丹经。\n自知不是封侯骨，空负先生两眼青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"相者","author":"沈守正","text":"千仞胸怀七尺身，蒯缑又逐帝京尘。\n刚成自是谋王手，唐举何曾善相人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采莼 其一","author":"沈守正","text":"西湖四月烟水平，采莼艇子狎波轻。\n紫丝牵得山衔日，竞学渔歌欸乃声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采莼 其二","author":"沈守正","text":"步兵偶尔忆山林，尚自风流说到今。\n不知千里如何味，直待鲈鱼江水深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答金浦凡惠画","author":"沈守正","text":"西子湖头春草生，越王台畔暮霞明。\n知君块磊无从寄，不博当年画苑声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄柴嘉定","author":"沈守正","text":"嘉果车行夹路香，练川今作小河阳。\n太冲亦爱花如锦，未敢蒙头过魏塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟古三首 其一 拟行行重行行","author":"陆深","text":"悠悠日将远，思君心甚迩。\n所嗟异居处，同生不同里。\n别离既以苦，会合谅以难。\n逝川期东海，行云恋故山。\n自知去日貌，难比旧时颜。\n出门即远道，两雪纷浩浩。\n潦泥缁素衣，安得白日照。\n矫首念征人，忧伤易终老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟古三首 其二 拟西北有高楼","author":"陆深","text":"层楼一何巍，亭亭切云霄。\n绮疏缥缈间，栏楯匝周遭。\n不知谁居中，哀怨逐风飘。\n为言本邯郸，关河望迢迢。\n区区怀苦心，三载非一朝。\n援琴以写之，意重丝难调。\n初为阳春曲，再行鼓山高。\n妙音本绝世，赏识何寥寥。\n思为双黄鹄，比翼与俱翱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟古三首 其三 拟孟冬寒气至","author":"陆深","text":"岁盈易寒风，旷野何萧条。\n深居戒远趾，四壁亦飘摇。\n阳和日已往，阴冱日已骄。\n门外远书至，启函知故交。\n慰我以好音，期我以明昭。\n感兹殷勤意，千载讵能销。\n素心抱愚衷，欲吐还自韬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀三首 其一","author":"陆深","text":"越人挟燕石，买之曰千金。\n和氏抱荆玉，至死悲不任。\n燕石媚光彩，举世倾所钦。\n彼璞一粗砺，在中诚难谌。\n不惜大宝湮，伤哉和氏心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀三首 其二","author":"陆深","text":"鸿鹄非雠人，挽弓欲射之。\n蜻蛉亦何意，儿童解黏丝。\n人生寄一世，毁誉安所期。\n高树多天风，高台多赫曦。\n贞白苟不亏，岂能随崇卑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀三首 其三","author":"陆深","text":"试歌清庙篇，馀音遏流云。\n千人掩耳过，万人不为闻。\n转歌后庭曲，和者日纷纭。\n已矣何足论，吞声泪沄沄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别徐昌国二首 其一","author":"陆深","text":"北风起天末，送子城东闉。\n愿言迟数里，款款得具陈。\n我有一端绮，持以赠夫君。\n不愿为黼黻，不愿为裤裈。\n愿为平居服，昏旦常相亲。\n垢敝忍弃捐，爱惜情如新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别徐昌国二首 其二","author":"陆深","text":"北风吹我襟，望子不得见。\n跂立恨足短，泪落迸如霰。\n草树摇寒凉，二曜急流电。\n游子在路岐，襦薄马悲颤。\n未明戒先驱，薄暮苦后殿。\n空谷多松柏，念此步不进。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南望水涩舟不得去同行者谋就陆戏成自慰","author":"陆深","text":"春江多柳花，风起花还飞。\n夕阳敛飘荡，委地相因依。\n行止谅有数，蚤暮同所归。\n百年总行旅，安用长歔欷。\n羲和无东回，安乐诚几希。\n眇焉泣岐子，人远事己非。\n飘飘山水间，志愿良不违。\n朝多清风来，暮多繁星辉。\n古称太史公，千载钦嘉徽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和赵类庵灯花","author":"陆深","text":"诵君灯花篇，值我灯花灿。\n旖旎欲浮香，敷披似春半。\n圆朵竞霞呈，岐枝误星散。\n娱玩夜三更，迟回肠九转。\n献祥谅无私，凉德歌有腼。\n南郊礼将成，预兆明庭宴。\n无藉春风吹，偶见春风面。\n影摇画屏斜，蕊堕银檠乱。\n君才本天妙，况复论交淡。\n游戏赋灯花，膏馥人犹厌。\n丽藻凌六朝，高风驾前彦。\n倘许望后尘，铅椠从兹办。\n寒灯复作花，政尔从人愿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邯郸县南见捋柳芽充饥者","author":"陆深","text":"青青杨柳树，弩眼学窥春。\n春风渐暄妍，品汇一以新。\n如何遭采折，捋之叶屯屯。\n初疑摘早茗，尤恐识未真。\n问此胡为尔，荅云疗饥贫。\n芽茁本可茹，何暇辩芳辛。\n既免私家竞，复有官道遵。\n连朝断烟火，持此抵八珍。\n地炉酌野水，拾樵煮清淳。\n幸将糠秕杂，撑腹藉轮囷。\n去秋淫潦厄，今春点差频。\n焉知岁年计，聊度旦暮身。\n呜咽语难了，泪落如可纫。\n见此三叹息，临岐倍伤神。\n黎民有菜色，何况等木皴。\n道路正供亿，一日须万缗。\n民腹已如此，民力那堪论。\n王政先茕独，汉治资良循。\n天恩倘可乞，咫尺当重陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"俨山精舍晚意","author":"陆深","text":"风蝉咽翘林，江鸥泳别渚。\n云霞变初秋，焦枯慰时雨。\n岂乏凌冲志，蓬瀛渺何许。\n兀坐当轩楹，凉飙满衣苧。\n中炯常晏如，外纷亦屡拒。\n会心适寡谐，顾影闻独语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风雨夜拥炉防警楫儿从傍屡作啼思","author":"陆深","text":"野居宁免惧，所恨乏兼赀。\n鸡犬偶不宁，儿女成悲啼。\n青毡有旧物，绿林多健儿。\n昨闻东西陌，颇受狐鼠欺。\n明灯守长夜，风雨正凄其。\n岂云网可漏，无乃岁阻饥。\n春阳正骀荡，民物方皞熙。\n愿言寄当路，莫惮催科迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗三首 其一","author":"陆深","text":"四叙若鳞次，君子感变迁。\n昨日夏热酷，今夕秋月鲜。\n凉飙振天末，草树失故妍。\n元鸟逝不返，苍鹰厉高鶱。\n苟无豳风人，何以卒岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗三首 其二","author":"陆深","text":"古井春无泉，槁木夏无枝。\n仲尼叹粪土，诗人咏德基。\n中夕起坐叹，叹息将奚为。\n去者日己远，来者安可期。\n不见令名士，监古乃得师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗三首 其三","author":"陆深","text":"敝帏殉老马，恩义贵有终。\n三良从下世，黄鸟哀国风。\n蚁穴堕太山，蛆流毒桓公。\n弃置万夫望，忧来不能穷。\n浩歌当永夕，沉思夜将中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元旦日蚀","author":"陆深","text":"白日众阳宗，王正四序首。\n况此月初吉，食之亦孔丑。\n故老相惊嗟，百年未曾有。\n颇闻文皇时，兹事亦匪偶。\n当其君臣会，灾祲岂能久。\n宋公才一言，荧惑乃却守。\n于今太阳厄，从申直至酉。\n群僚萃南宫，簪组纷前后。\n台史报初亏，稽首再三扣。\n元臣跪伐鼓，申救情独厚。\n高高若罔闻，啖食未满口。\n乍疑璧微缺，忽若镜中剖。\n须臾如月初，恍欲露星斗。\n惨淡不可辨，氛霾互缠纠。\n天人会相通，垂戒固不苟。\n吾闻月掩日，其事果然否。\n无乃阳道衰，遂为阴所走。\n月本傅日行，代明得称耦。\n倘使日景亏，月光安所受。\n其事或渺茫，吾欲徵神瞍。\n载观春秋书，一一各有取。\n下土虮虱臣，惭无捧日手。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨夜无寐泛然成篇","author":"陆深","text":"海隅苦卑暑，溽润恐违生。\n思凌千仞冈，一眺白玉京。\n玉京多仙侣，招邀有深情。\n餐啖皆淳和，被服何轻盈。\n俯视尘中世，朝夕竞浮荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"听雨","author":"陆深","text":"摵摵入苇际，萧萧自檐楹。\n幽居忽复旦，迥野薄江城。\n偃息从兹始，尘鞅讵能婴。\n园田被膏润，琴书有馀清。\n浮生本未定，誉毁等阴晴。\n聊有盈觞酒，独酌慰幽情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴人以巨舰载湖石至雨中阅之","author":"陆深","text":"濛濛江天雨，遥遥湖水船。\n谁施巨灵斧，擘此青数拳。\n缥缈呈夏云，婵娟隔春烟。\n虽乏卫公识，偏怀米生颠。\n蹇予颇好奇，有癖在林泉。\n肩舆度壑暝，孤榜逐溪缘。\n品视剔苔藓，摩挲计雕镌。\n遄归亦乘兴，卧游裁短篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓楼寄储芋西","author":"陆深","text":"天低岁云晏，故乡复侨居。\n与子共巷陌，相望一水馀。\n瓦屋正鳞次，石桥亦虹舒。\n心亲物无碍，会数意犹疏。\n乾坤本逆旅，日月自居诸。\n来此饮名酒，相携校诗书。\n华发不可变，功名等为虚。\n及时须行乐，政恐不待予。\n申章示同志，聊以酬遂初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题茁兰","author":"陆深","text":"滋兰茂九畹，灵雨茁其芽。\n和氏抱荆璞，以身明不瑕。\n芳泽贵自保，物色宁有涯。\n但使臭味同，岁晚何足嗟。\n猗猗关西彦，风流如谢家。\n光辉媚幽岩，旖旎剔芬华。\n温恭君子持，令德戒纷姱。\n岂乏桃李姿，贞白世所嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洗竹","author":"陆深","text":"兰以当门锄，竹缘太密洗。\n托身苟失所，彼美徒漫尔。\n郊居时雨馀，茅芜手自启。\n好风来林端，烦曦荫树底。\n生事虽甚微，粗足办盐米。\n会心即交游，异姓等兄弟。\n吾行迫始衰，聊复勤四体。\n伐檀讥素餐，相鼠歌有礼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月朔晨兴","author":"陆深","text":"落叶纷可扫，客行殊未归。\n大化无停运，倦翼多卑飞。\n凌寒怀执热，抚序悲授衣。\n物候变南北，世故有依违。\n晦朔成代谢，所嗟知者稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒汉高庙","author":"陆深","text":"元冬曜白日，旷野吹大风。\n旅行齐楚交，密与丰沛通。\n磊磈半亩丘，乃有高皇宫。\n堂堂赤帝子，仪像居当中。\n天运苟不极，未肯生英雄。\n一时风云会，百辈皆王公。\n野人守敦朴，香火祈年丰。\n那知千载上，行天乘六龙。\n丈夫事真主，圣人优百工。\n感叹复感叹，岂必非遭逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别汪天启同年","author":"陆深","text":"借问何所悲，相知新别离。\n掩袂各挥涕，步步不得辞。\n恐堕儿女情，挥酒尽一卮。\n念我同门友，高举振羽仪。\n东西各有过，与子愿独偕。\n意多觉别促，情亲身不违。\n仰视白日速，嗟此道上泥。\n久要四海志，岁年空路岐。\n慷慨发我歌，我歌当向谁。\n谅子重察识，会面知有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过黄宪墓","author":"陆深","text":"当年自无营，千古如识面。\n安用金石坚，始知仪秦贱。\n晓行襄江滨，残月堕西堰。\n溟濛草露晞，屃赑标题见。\n相从牛医来，古意倘未变。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陆太宰水村也适轩咏怀","author":"陆深","text":"地即大隐胜，材集补天馀。\n达人秉高尚，讵云朝市拘。\n覆庇本四海，俯仰托兹庐。\n云石自流峙，吹嘘及根株。\n命觞沿径曲，凿泉当坐隅。\n遂使耳目旷，颇胜丝竹俱。\n心融境斯一，理适情自娱。\n载理闻鹤谱，时临换鹅书。\n藏胸富丘壑，佐世登唐虞。\n疏品荷陶铸，莼鲈思踌躇。\n室迩人甚远，歌啸日正舒。\n贱子获听履，自负龙门如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐昌谷湖南纂修","author":"陆深","text":"取友在异世，贵此肝胆通。\n与子同乡国，笔砚亦屡同。\n一别岁月速，那得不匆匆。\n宵戒一觞酒，起视夜方中。\n追子恐弗及，缪绸叙难终。\n夹居长安道，参商各西东。\n况兹万里隔，目断双飞鸿。\n江湄长芳草，郁纡伤我衷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏蚕食叶图为康修撰德涵作","author":"陆深","text":"啖叶势未已，谋生意何愚。\n但知厌其腹，宁知用其躯。\n恩深报必厚，功高祸与俱。\n物理固若此，感叹将焉如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张太史常甫得予告","author":"陆深","text":"闻子有远役，我心己南悲。\n菀彼桑与梓，藐在天一涯。\n恨无双羽翰，高飞镇相随。\n持此一寸心，隐抑讵当知。\n宵起步广庭，天高列星迟。\n人生有会合，世故多别离。\n别离勿复道，但问别者谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗","author":"陆深","text":"览镜难自持，容颜岂常好。\n秋高风露劲，黄落纷弱草。\n岂无长生药，驰心违至道。\n净宇澄垢怀，冥观契元造。\n迟回三十年，念此苦不早。\n瑶池与元圃，微风荡芝草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钓台","author":"陆深","text":"双台切高云，碧溪下长风。\n本怀恋比邻，长啸辞王公。\n把钓已忘鱼，入梦犹非熊。\n人境有旧庐，客星动高穹。\n江山自朝夕，禽鱼或西东。\n朝市各取适，出处俱自躬。\n岂曰万户侯，非此一亩宫。\n咄嗟保厥始，优游慎所终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉华杂咏三首 其一 蓬壶","author":"陆深","text":"群仙历万劫，三山乘六鳌。\n琪树连瑶草，珠宫贝阙高。\n归来玉华子，新制六铢袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉华杂咏三首 其二 碧香阁","author":"陆深","text":"雨洗碧色鲜，风来清香远。\n田田既堪悦，亭亭若可饭。\n幽期当南轩，微波坐成晚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉华杂咏三首 其三 问月台","author":"陆深","text":"月出青山外，浮云为扫开。\n缺圆缘底事，弦望孰相催。\n有言俱不省，流影照高台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿佑圣观候明发","author":"陆深","text":"宦业祗簿领，游目旷林泉。\n偶此山阴雪，来冲窦中烟。\n新阳一以长，天道会好还。\n招邀复材彦，探讨事幽元。\n初遵潜虬壑，还过种玉田。\n曲槛俯跃鳞，盘空堕飞鸢。\n时闻林端磬，几遇云外仙。\n相将愿有遂，所适期无前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武城观涨因忆陈后山五月一雨凉中宵大江南之句情景悠然援毫有述","author":"陆深","text":"长河五月雨，一夜十尺强。\n大星映南斗，微风生蚤凉。\n坐此景物畅，怀彼路阻长。\n人生百年内，弦望倏相将。\n苟非金石固，动静各有常。\n大化无停息，仰视河汉光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安山道中晚棹","author":"陆深","text":"洋洋水波逝，水钦川上怀。\n遂将去齐鲁，明当度江淮。\n远役谢尘鞅，高居理茅斋。\n沙田二三顷，婉娈东海涯。\n芳春景物丽，夕阳襟抱佳。\n耕读有遗轨，长使愿无乖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题陈光禄惟顺迎暾书舍二首 其一 鹭岭","author":"陆深","text":"白鹭斜行下，青山百里长。\n登高一以眺，风物近潇湘。\n谢安如可起，飞去逐鸾凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]