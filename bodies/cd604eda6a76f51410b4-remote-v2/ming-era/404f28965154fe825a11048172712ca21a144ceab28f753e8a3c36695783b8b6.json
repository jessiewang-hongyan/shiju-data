[{"title":"挽袁太玉八律 其二","author":"邓云霄","text":"寥寥眼底旧交稀，邻笛三声易湿衣。\n春草堂空人已去，玳梁泥落燕还归。\n名悬千古遗文在，石记三生往事非。\n纵有游魂恋慈母，桑榆斜日澹春晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽袁太玉八律 其三","author":"邓云霄","text":"联翩冠盖盛豪华，里号鸣珂世共誇。\n却解虎符辞玉篆，来随渔父泊鸥沙。\n游丝牵尽风前絮，逝水流残雨后花。\n试问仙踪指天际，十洲三岛是君家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽袁太玉八律 其四","author":"邓云霄","text":"疾革偏逢腊尽时，漫劳春信到南枝。\n骑鲸客去月沉浦，斗鸭栏倾水满池。\n作诔莫凭无鬼论，哀歌真属有情痴。\n庄生寝说知何意，只为当年少惠施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽袁太玉八律 其五","author":"邓云霄","text":"江上茅斋碧草春，波光面面隔红尘。\n闭关未厌参禅寂，谢客还嫌问字频。\n傲骨生前如铁石，孤坟殁后倚松筠。\n那能移得梁鸿冢，与汝空山作近邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽袁太玉八律 其六","author":"邓云霄","text":"便便腹笥五车书，博览三冬富有馀。\n邺架谁能窥李泌？\n茂陵空老病相如。\n野磷似点燃藜火，残卷重披走蠹鱼。\n时有行人暗挥涕，隔江遥望好楼居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽袁太玉八律 其七","author":"邓云霄","text":"论文结社竞风骚，挥笔西垣片月高。\n白眼尊前频对垒，黄垆泉下忆持螯。\n归魂忽暗千山雨，馀恨还驱八月涛。\n欲赋大招裁楚调，已闻猿鸟哭林皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽袁太玉八律 其八","author":"邓云霄","text":"微明梁月晓钟时，展转怀人入梦思。\n可叹无儿同伯道，还怜有女胜文姬。\n蒹葭倚玉姻情重，蒲柳迎霜暮景悲。\n浮世百年谁不死？\n流传惟藉郭家碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"茂名李曰辅春日过镜园赋酬","author":"邓云霄","text":"幽溪密树静垂纶，雨后长堤草色新。\n好鸟枝头如唤友，閒花径底喜迎人。\n壶觞野酌堪乘兴，鸡黍山家未厌贫。\n向晚横塘荡双桨，水云摇澜镜中春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送婿卢新元入北雍秋试","author":"邓云霄","text":"旧游还忆桥门水，送别春江无限情。\n柳拂莺黄随缆转，波翻鸭绿映杯清。\n当年种玉成琼树，此日登台入凤城。\n勋业承家须努力，踏歌休逐少年场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题李曰辅清沧园兼颂名家济美且近仙居","author":"邓云霄","text":"名园傍水称清沧，浩浩江如世泽长。\n乔木迁莺时睍睆，仙人骑鹤共翱翔。\n花团锦幄迎朝旭，月涌金波进晚觞。\n自笑疏狂老泉石，无缘缩地到高凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚午清明日感时事作","author":"邓云霄","text":"久卧林泉阅岁时，近来消息转堪疑。\n落花飞絮春如梦，旧火新烟节暗移。\n窗户空闻喧燕雀，郊门谁复决雄雌。\n当年赌墅人何在？\n不为君王解劫棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新制小艓覆以翠幕暮春泛水镜池","author":"邓云霄","text":"玩弄轻舟学水仙，雨馀波影更澄鲜。\n盈盈人坐池中练，队队鱼行镜里天。\n翠幕迎风穿柳线，玉壶沽酒倩荷钱。\n凭谁为唱留春曲？\n一部蛙声万树蝉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬姑苏门人陈古白寄怀之作步来韵二首 其一","author":"邓云霄","text":"白头交谊岂应疏，岁岁传书问遂初。\n怜汝雾藏南谷豹，何时风起北溟鱼？\n廿年宦拙甘栖遁，三径花深自扫除。\n牢落閒门惟鸟雀，倚楼遥待吕安车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬姑苏门人陈古白寄怀之作步来韵二首 其二","author":"邓云霄","text":"登高匹练望吴门，犹有知心数子存。\n老去长悬怀友梦，病馀惭未报君恩。\n胡尘东北将侵震，王气西南莫向坤。\n湖海元龙饶侠骨，上书曾著几千言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哀水祸二首 其一","author":"邓云霄","text":"炼石那能补漏天，忽看沧海在桑田。\n城池半入鲛人宅，楼阁俄消蜃市烟。\n遥望波涛思禹绩，允将世界比尧年。\n颓垣处处无馀物，只有荒苔为布钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哀水祸二首 其二","author":"邓云霄","text":"摇艇冲涛去觅尸，孤儿寡妇泪淋漓。\n蓬头纷向残云哭，雨脚还添薄暮时。\n叹息贫民空有骨，翻疑造物本无知。\n干戈又报征输急，满目疮痍可向谁？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿周石林七秩又一四首 其一","author":"邓云霄","text":"才名南斗两相高，草圣诗仙老更豪。\n碧眼身轻三岛鹤，彩云光映五铢袍。\n纵横放笔休临帖，感慨狂歌只续骚。\n便欲携壶来痛饮，对君心已醉醇醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿周石林七秩又一四首 其二","author":"邓云霄","text":"奇石崚嶒簇作林，疏狂偏得米颠心。\n书成龙卷临池墨，赋就人惊掷地金。\n白社但推诗律细，丹炉谁识道门深？\n招携共驾冰轮去，露宿梅花四百岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿周石林七秩又一四首 其三","author":"邓云霄","text":"高步翩翩健若飞，鹖冠堪衬芰荷衣。\n厨烹石髓邀人食，鬓插琪花带月归。\n踪迹近随河上老，烟霞久息汉阴机。\n试从椿树论年岁，莫问栽松大几围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿周石林七秩又一四首 其四","author":"邓云霄","text":"乔梓人呼大小王，兔毫辉映凤毛长。\n堂前已种忘忧草，肘后曾传辟谷方。\n列坐贤星连锦席，行杯宝月落天香。\n百年胜事逢秋半，度曲宜歌夜未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病足书怀二首 其一","author":"邓云霄","text":"谢客经秋不下堂，徐行择地亦安康。\n生来既乏逢迎骨，老去无心闹热肠。\n捷足有人争逐鹿，覆车终是叹亡羊。\n静观世上劳劳者，始觉蒲团意味长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病足书怀二首 其二","author":"邓云霄","text":"祸水沉烟灶产蛙，征舶何日免贫家？\n医疮剜肉犹堪惜，抱膝支床敢自嗟。\n未制篮舆寻白社，欲随渔父宿苍葭。\n郊园岂是安身处，已报江乾盗似麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨馀遣兴","author":"邓云霄","text":"诗朋酒伴经过少，荒径无心待马蹄。\n槛外花枝如选妓，林间鸟韵即分题。\n凉添美睡三竿日，晴减长堤几尺泥。\n何处新波堪开艇？\n茅溪潮接浣花溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李父母入觐兼归省三首 其一","author":"邓云霄","text":"名家宦谱世传清，琴鹤图书伴去程。\n人望龙门秋水远，舟移羊石锦帆轻。\n五年雨露攀辕泪，万里关山恋阙情。\n自是君亲恩并重，彩衣先入阖闾城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李父母入觐兼归省三首 其二","author":"邓云霄","text":"珊珊苍佩谒明光，待漏听鸡夜未央。\n圣主临轩咨抚字，使君奏牍注循良。\n赐金更喜颁春宴，簪笔还期补衮裳。\n寄语桑间旧驯雉，共随鸣凤向朝阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李父母入觐兼归省三首 其三","author":"邓云霄","text":"把酒临歧话别难，且携雄剑对君弹。\n长城谁纵胡儿马？\n短发仍冲壮士冠。\n池上夔龙徒拊髀，军中韩范几登坛。\n时危各展经纶手，早上金门策治安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送顺德黄令公入觐","author":"邓云霄","text":"洪河流润到岩扉，怅望趋朝彩鹢飞。\n万国诸侯皆执玉，九重圣主正垂衣。\n防边名将今谁是？\n能吏如公古所稀。\n请剑擒王他日事，旄头应避法星辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送新会黄令公入觐","author":"邓云霄","text":"圣人课吏坐明堂，又报征兵救朔方。\n国步艰危龙阙远，臣心激切马蹄忙。\n北门专倚莱公钥，东粤长垂召伯棠。\n惜别河梁重翘首，五年邻烛借馀光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬李定夫过访镜园次韵","author":"邓云霄","text":"深树幽溪抱径斜，竹阴凉借翠云遮。\n隐居结客开莲社，胜侣分题散笔花。\n叔宝临风人似玉，安仁归路果如麻。\n晚将明月随君去，更赠芳郊一片霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得月华秋朗","author":"邓云霄","text":"非烟非雾散祥光，潋滟金波入玉觞。\n五石倩谁修月户？\n七襄今夕见霓裳。\n庆云拖锦笼丹桂，宝镜团花捧素妆。\n对景正宜裁谢赋，吹灰休更学淮王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日戏咏铁马四首 其一","author":"邓云霄","text":"房星坠地逢欧冶，炼出青骢与紫骝。\n匣里双龙曾并铸，云中八骏许同游。\n㧿金喷玉秋偏急，振鬣嘶风夜不收。\n似有寒声应刁斗，巡边戈甲几时休？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日戏咏铁马四首 其二","author":"邓云霄","text":"玉关人去年年梦，铁马秋来夜夜鸣。\n绝域正悬长别泪，悲风又送断肠声。\n响侵捣练楼前月，心绕吹笳塞外营。\n思妇纤腰消瘦尽，还闻飞骑取龙城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日戏咏铁马四首 其三","author":"邓云霄","text":"春深柳径接桃蹊，那得骄嘶出大堤。\n千里如闻誇捷足，九衢空忆踏香泥。\n檐前常系青丝鞚，楼外时翻碧玉蹄。\n试听清声想琼佩，晚妆人倚画栏西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日戏咏铁马四首 其四","author":"邓云霄","text":"连城风动影横斜，谁信名驹在渥洼？\n劲骨不肥春苜蓿，哀音如咽汉琵琶。\n疑将苍竹批双耳，更剪乌云罩五花。\n神物若能同剑化，锦鞯应得到流沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽四川资阳学博简念蒙会兄","author":"邓云霄","text":"冷落青毡白发多，长途薄宦久蹉跎。\n浮生总付邯郸梦，归榇还惊滟滪波。\n藜阁烟灯消夜火，松邱风雨泣寒萝。\n西垣旧是论文地，掩泪伤心不忍过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊园秋思","author":"邓云霄","text":"芳郊竹石晚延凉，幽思盈盈一水长。\n燕去渐收秋后扇，鸿来遥送鬓边霜。\n芙蓉低照横塘镜，薜荔新裁野老裳。\n何处秋声最堪听？\n月明渔笛满沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感旧","author":"邓云霄","text":"两都旧社几人存，消息朦胧入梦魂。\n白发想非前日貌，玄亭或作别家园。\n暮云春树关山远，蒿里松邱涕泪繁。\n肠断六桥堤畔路，梅桹花落月黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁伯珩持陈太史书过镜园为馀写照赋赠二首 其一","author":"邓云霄","text":"久耽泉石厌簪裾，相访何烦太史书？\n五色挥毫曾梦鸟，半生弹铗不歌鱼。\n丹青一幅传神笔，日月双轮送客车。\n可叹容颜随岁改，更从何处访真如？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁伯珩持陈太史书过镜园为馀写照赋赠二首 其二","author":"邓云霄","text":"避人踪迹似墙东，万事无心问塞翁。\n醉里疏狂逢画圣，图中意态夺天工。\n烹茶味滴松萝乳，点行声敲竹石风。\n试探本来真面目，寒潭明镜总清空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日郊居戏作八音诗","author":"邓云霄","text":"金风荐爽咽寒蝉，石枕凄清称午眠。\n丝发萧萧人似鹤，竹窗漠漠雨如烟。\n匏樽酒浸青田核，土灶蔬参玉版禅。\n革尽火云泛秋水，森兰堂下浪连天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊居把钓步周贵谔初度韵二首 其一","author":"邓云霄","text":"临流还挈小蒲团，泛艇何如坐石安。\n笠屐不扶灵寿杖，林泉先挂进贤冠。\n潮来鱼拜双溪浪，雨过虹垂百尺竿。\n酒熟鲈肥莼菜美，醉眠惟许浦鸥看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊居把钓步周贵谔初度韵二首 其二","author":"邓云霄","text":"赋就郊居野兴长，渔歌牧唱递称觞。\n饵沉秋水催鲜脍，蛤吠平田送晚凉。\n白堕数缸堪纵饮，黄云万顷又登场。\n可怜社鼓村村急，暂释农人半日忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感秋","author":"邓云霄","text":"木落天空玉露飘，冰心不与叶同凋。\n一区偃仰容双膝，三仕浮沉历四朝。\n蚌蛤盈虚皆应月，海鸥来往自随潮。\n何人悟得行藏理？\n丛桂秋山岂待招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚午九日病足愁坐贞元毓庭过酌二首 其一","author":"邓云霄","text":"愁病柴扉昼不开，无情节序又相催。\n兵厨酒报新篘熟，陶令花迎旧客来。\n鸟雀窥门秋似水，鲸鲵翻海浪如雷。\n遥怜仗钺临戎者，閒暇还登戏马台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚午九日病足愁坐贞元毓庭过酌二首 其二","author":"邓云霄","text":"抱膝聊为梁父吟，忧时空郁杞人心。\n凄凄霜露催黄菊，浩浩烟波聚绿林。\n忍见颓城围破屋，愁闻哀角杂寒砧。\n醉乡别有清平界，好向中山古洞寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"霜降日砍脍作三首 其一","author":"邓云霄","text":"持竿坐石本忘机，笑尔溪鱼自献肥。\n丝卷银鳞秋水冷，刀裁玉片晓霜飞。\n挥杯遥酹青腰女，罢酌寒添白袷衣。\n漫道莼鲈动乡思，宦游今见几人归？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"霜降日砍脍作三首 其二","author":"邓云霄","text":"醉来万事不关情，颇爱盘堆雪脍清。\n秋爽自宜尝俊味，朝餐兼得解馀酲。\n钓鳌东海人难到，弹铗侯门世所轻。\n那似严滩一竿竹，寒江长映客星明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"霜降日砍脍作三首 其三","author":"邓云霄","text":"快心何必荐江鲜，感物悲秋意惘然。\n人羡嘉鱼鱼羡饵，霜催寒水水催年。\n已看野鹤如疏鬓，且与渔郎结净缘。\n寄语白龙莫轻出，抱珠潭底且高眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋杪听鸡夜坐","author":"邓云霄","text":"梦阑酒醒漏迟迟，正是闻鸡起舞时。\n三唱繁声通蕙帐，半轮斜月挂梧枝。\n秋高又报边烽急，霜落遥怜曙角悲。\n想像宵衣烦圣主，庭燎应问夜何其。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈直轩孟冬日过访镜园话旧","author":"邓云霄","text":"室迩人遐叹索居，相过发变十年馀。\n雄心未展屠龙手，往事徒看解梦书。\n燕市旧游思击筑，镜园寒水对观鱼。\n交情岁晏深想念，残菊还停长者车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽西席袁五慕","author":"邓云霄","text":"廿载交情老益敦，伤心生死隔朝昏。\n青灯风雨常联榻，绛帐儿孙并在门。\n东郭贫来空有骨，南柯梦去竟无言。\n哭君正值严冬日，黍谷寒深未易温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽故茂才陈古民表弟","author":"邓云霄","text":"垂髫灯火共芸编，辛苦萤囊六十年。\n怅望龙溪伤逝水，凄凉莲社隔重泉。\n仙踪只合留双舄，傲骨何须问一钱。\n空馆寥寥无旧客，哭君肠断绝交篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清明日雨歇泥深竟阻郊游尹冲玄载酒集朝爽台彭周两君同赋","author":"邓云霄","text":"落花啼鸟报春深，载酒高台散爽襟。\n芳草连天无近远，淡云笼日半晴阴。\n冲泥未了登山兴，改火偏惊阅岁心。\n可爱栏前数株柳，年年嫩色似黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"社集镜园泛舟观涨二首时米贵多盗 其一","author":"邓云霄","text":"扁舟载酒出江滨，日映红霞霁景新。\n共泛狂涛誇海若，谁怜涸辙济波臣？\n忘机鸥鸟时呼侣，破浪鲸鲵不避人。\n欲坐莲花访蓬岛，扶桑东去是通津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"社集镜园泛舟观涨二首时米贵多盗 其二","author":"邓云霄","text":"远村返照明还灭，近浦沉沙浅复深。\n积潦正愁侵白屋，饮虹那得吐黄金。\n浪花高蹴银河动，云叶低垂彩鹢阴。\n赋就观涛归路晚，和歌如听水龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽温敏之二首 其一","author":"邓云霄","text":"春江帆影挂斜晖，别泪曾沾病客衣。\n万里燕台虚北望，千金骏骨竟南归。\n才华梦笔名还在，功业凌云计已非。\n野蝶不知人羽化，蘧园花落尚纷飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽温敏之二首 其二","author":"邓云霄","text":"准提高阁冷窗纱，犹有閒僧转法华。\n旅榇艰难过庾岭，游魂消瘦似梅花。\n高堂肠断趋庭鲤，古木巢空返哺鸦。\n奉佛生天身后事，西天觉路是君家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得啼鹃促落红","author":"邓云霄","text":"蜀鸟催归客未归，离愁如梦雨如丝。\n声声啼血含新恨，点点飘红别故枝。\n正爱春园披锦绣，谁怜花国冷胭脂？\n楼前千里王孙草，肠断东风嫩绿时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛木兰堂观竞渡","author":"邓云霄","text":"长日深杯泛木兰，清溪几曲到江乾。\n浪翻银屋双龙斗，雨送金风五月寒。\n拾翠人归环佩湿，采芳潮落杜蘅残。\n閒心不竞如流水，欲向东溟理钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青霞君有陨珠之痛赋此慰之","author":"邓云霄","text":"悲君心绪乱如麻，泪洒西河两鬓华。\n流浪死生浑是梦，蘧庐天地属谁家？\n破愁全藉杯中物，割爱休寻镜里花。\n烦恼何方能解脱？\n且将空相看恒沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五日城外观竞渡有两妓自来侍酒时米贵观食龙舟不至凄然有感二首 其一","author":"邓云霄","text":"雨中楼阁锦模糊，江上游龙近有无。\n度曲可怜人似玉，挥杯堪叹米如珠。\n扁舟只合携西子，狂客何心吊左徒。\n群盗未销横海剑，五丝空佩辟兵符。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五日城外观竞渡有两妓自来侍酒时米贵观食龙舟不至凄然有感二首 其二 又戏作艳曲追欢至夕","author":"邓云霄","text":"牙樯锦缆趁平潮，神女飞来不待招。\n龙舸虚传隋殿脚，阳台今见楚宫腰。\n歌声遥泛高低浪，妆影斜通宛转桥。\n箫鼓夕阳归棹晚，一弯新月又相邀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]