[{"title":"别于鳞子与子相明卿十绝 其七","author":"王世贞","text":"徐卿抗疏拟烟霞，白笈青鞋兴未赊。\n我系渔舟问苕霅，玉箫吹破碧桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别于鳞子与子相明卿十绝 其八","author":"王世贞","text":"罗浮秋至重嶙峋，漳水寒流月色新。\n南北归来俱自好，不知裘马倦游人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别于鳞子与子相明卿十绝 其九","author":"王世贞","text":"褰裳去采汉江兰，日暮江深春水寒。\n欲寄一枝君自赏，傍人应作艾萧看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别于鳞子与子相明卿十绝 其十","author":"王世贞","text":"当年季子去归吴，缟带谁遗别思孤。\n十二国风论欲尽，大帆明月满姑苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别弟 其一","author":"王世贞","text":"别时携手上河梁，两岸相看即异乡。\n独立苍茫归骑晚，春来月色倍如霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别弟 其二","author":"王世贞","text":"鸣铙叠吹凤池头，玉勒金羁控紫骝。\n无那别时言不尽，逢人日日问青州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"见挟弹者偶作","author":"王世贞","text":"黄衫挟弹市人看，杨柳阴中百舌寒。\n日暮建章秋色里，不知何处落金丸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事三绝 其一","author":"王世贞","text":"阖闾城外闪旌旗，荡寇楼船十万师。\n为问幕中诸上客，何人不揖羽林儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事三绝 其二","author":"王世贞","text":"欲提长剑斩长鲸，归拥春农海畔耕。\n纵有微勋麟阁上，柏梁先逊侍中名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事三绝 其三","author":"王世贞","text":"护军旌传有光辉，马首黄金意气归。\n挑尽机头红女泪，又劳天子赐春衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顾子行员外谪判太平五绝 其一","author":"王世贞","text":"天门秋色挂帆开，候吏遥从采石来。\n醉着锦袍明月下，千年人道谪仙才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顾子行员外谪判太平五绝 其二","author":"王世贞","text":"晋朝姑孰接秦关，饮马淮流一线间。\n今日中原无插羽，不妨词客醉龙山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顾子行员外谪判太平五绝 其三","author":"王世贞","text":"客路仍闻送逐臣，与君那得不沾巾。\n秋云桐柏离帆影，霜落丹枫两地新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顾子行员外谪判太平五绝 其四","author":"王世贞","text":"楼船叠鼓大江流，别驾新开南豫州。\n四郭春骄罗绮色，向来仙客不知愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顾子行员外谪判太平五绝 其五","author":"王世贞","text":"公檄寒稀郡事饶，试陪宾从上凌歊。\n只今惟有黄山月，犹似蛾眉恨未消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扬州访张有功不值 其一","author":"王世贞","text":"遥闻李白在扬州，银瓮葡萄晚自愁。\n曲罢广陵人不见，萧条枫叶映寒流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扬州访张有功不值 其二","author":"王世贞","text":"当时恩谴异长沙，春见唐昌两度花。\n幕府夜来频问帖，玉鞭金勒向谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝应湖 其一","author":"王世贞","text":"波摇匹练界长空，天阔千帆处处风。\n入雾楼台先暝黑，隔林枫叶后霜红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宝应湖 其二","author":"王世贞","text":"长天漠漠水淙淙，鼓吹中流引画艭。\n南人过此看不足，北人即怕莫推窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12116,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻子相归不能待寄之","author":"王世贞","text":"桐柏江头春雁稀，故人闻向日边归。\n扁舟欲系遥相待，万户清霜夜捣衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12117,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送家兄君美复之江右幕职 其一","author":"王世贞","text":"滕王高阁枕江开，万里涛驱雪色来。\n幕府只今谁上客，知君旧有子安才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12118,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送家兄君美复之江右幕职 其二","author":"王世贞","text":"东湖水铺如镜平，百花洲上百花明。\n宫袍小舫醉歌去，笑杀襄阳空得名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12119,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送家兄君美复之江右幕职 其三","author":"王世贞","text":"紫薇省中花正芬，任他公檄自纷纭。\n不妨傲吏乌皮几，卧看西山生白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12120,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送家兄君美复之江右幕职 其四","author":"王世贞","text":"吴江花发暮春衣，暂逐童冠一醉归。\n君去正如彭蠡雁，年年还向蓟门飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12121,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送家兄君美复之江右幕职 其五","author":"王世贞","text":"香垆峰畔紫烟生，铁柱观头雷雨明。\n麻姑仙人数相过，倘到吴门好寄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12122,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暑中戏简谢时臣索画庐山障","author":"王世贞","text":"亭午湘帘暑未残，谩劳朱李荐冰盘。\n须君貌寄庐山障，卧对飞流万尺寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12123,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事偶成 其一","author":"王世贞","text":"阊阖兵戈乌夜啼，蓟门禾黍雉朝飞。\n北人愁北欲南去，南人愁南不敢归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事偶成 其二","author":"王世贞","text":"不分朝回只晏眠，春逢雨雪压花天。\n邻家禁酿罢开市，赢得囊中无酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜明卿舍人至口号","author":"王世贞","text":"昨夜承明万井开，露寒星斗共崔嵬。\n虚将紫气归燕石，自有荆人抱玉来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄临清方符处士因问讯犹子元焕茂才元焕善书工新声 其一","author":"王世贞","text":"春风锦缆三千舶，夜月朱薨十万家。\n侠客新传方处士，彩毫题遍石榴花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄临清方符处士因问讯犹子元焕茂才元焕善书工新声 其二","author":"王世贞","text":"君家小阮不可当，春日骑驴辞帝乡。\n醉后曲裁梁苑月，兴来裙掩墨池霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"还吴初抵阊门夜泊独坐有怀","author":"王世贞","text":"十载时时问故乡，归来朋旧又相忘。\n城头弦月乌栖曲，疑是幽州万树霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘲吴舍人新娶","author":"王世贞","text":"汝去含香露未乾，欲凭春破紫微寒。\n片帆飞尽潇湘雨，十二峰头黛色残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题西滨隐君","author":"王世贞","text":"隐君家住大河西，杨柳双桡水拍堤。\n明妆落日浣纱女，夹岸桃花春欲迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赠子与十绝 子与行余既以长歌饯别矣临岐怅然飞龙之乖隔羽翼之无从也因复为十绝以吴音度之栈马踯躅行徒掩涕矣 其一","author":"王世贞","text":"问余何事滞燕京，击筑徐卿大有情。\n此日悲歌向谁和，凉风千树起秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赠子与十绝 其二","author":"王世贞","text":"白虹高属蓟门秋，风暝滹沱水逆流。\n自是别离关气象，不须开匣问吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赠子与十绝 其三","author":"王世贞","text":"东吴王生太可怜，别汝洒泪西风前。\n一榻梁间都不下，自瞪双眼看青天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赠子与十绝 其四","author":"王世贞","text":"秋深桐柏水曾波，明月轻帆鼓吹过。\n倘遇少文烦致讯，卧游山色不胜多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赠子与十绝 其五","author":"王世贞","text":"吴王台下水漫漫，榆柳萧条兵气寒。\n无那兴来催棹去，到时应自忆长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赠子与十绝 其六","author":"王世贞","text":"灞陵车马断行尘，狂客新丰酒见亲。\n抵醉不曾交片语，只今谁是语中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赠子与十绝 其七","author":"王世贞","text":"太湖南坼贮烟霞，山绕菰城十万家。\n归路莫愁云色占，飞流千尺泻桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赠子与十绝 其八","author":"王世贞","text":"罨画溪头秋水多，红妆百叠剪青罗。\n醉后遍题莲叶句，兰舟翻入女儿歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赠子与十绝 其九","author":"王世贞","text":"寂寥扬子著书年，谁似桓谭与太玄。\n心赏共期千古在，莫教零落借人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再赠子与十绝 其十","author":"王世贞","text":"李生骑马向邢台，拥传君仍去未回。\n一柱天孤撑震荡，千岩日堕失崔嵬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送表兄卢生南归 其一","author":"王世贞","text":"大江南去水茫茫，到日秋风为解装。\n栖鸟渐閒人渐少，不知何处是家乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送表兄卢生南归 其二","author":"王世贞","text":"白云无尽片帆飞，樽酒踟蹰涴客衣。\n不为别离生感慨，故园今日尚能归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画赠别王使君","author":"王世贞","text":"杯酒踟蹰日易曛，青山处处惜离群。\n莫言秋色难分赠，君自青云我白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"走笔二绝赠弈者刘生 其一","author":"王世贞","text":"曾陪太傅东山墅，不向君王赌郡符。\n敲罢一枰何所道，片帆秋色满江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"走笔二绝赠弈者刘生 其二","author":"王世贞","text":"金沟清泚楝花香，一局逢君坐夕阳。\n莫向秋风誇石室，人间岁月野夫长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12146,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠苏洲","author":"王世贞","text":"此翁不知何许人，醉墨漓漇若有神。\n夜半酒醒寻不见，满天风雨散龙鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"于鳞寄太行诸篇走笔以谢","author":"王世贞","text":"太行峰色党青天，刺史搴帷紫气前。\n中夜星辰低摘尽，忆余飞赠蓟门烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜半醉过子相","author":"王世贞","text":"北斗下卓河西流，先生醉歌吟未休。\n不为长安一片地，何人能破古今愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠文都昌","author":"王世贞","text":"挂帆南去楚天赊，大庾峰头明月斜。\n我赠白云仙尉去，书来应报折梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别李邢州宗考功徐比部吴给事诸君时方有三辅之役 其一","author":"王世贞","text":"浊漳西坼未安流，大麓千岩风雨愁。\n五马过题春已遍，犹闻使者下邢州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别李邢州宗考功徐比部吴给事诸君时方有三辅之役 其二","author":"王世贞","text":"金河杨柳未堪齐，马首传觞白日低。\n侠客自来轻别甚，醉乘虹雨蓟门西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别李邢州宗考功徐比部吴给事诸君时方有三辅之役 其三","author":"王世贞","text":"塞云吹尽出榆关，不断冰天指掌间。\n应是尔曹高兴发，忽惊飞雪捲燕山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别李邢州宗考功徐比部吴给事诸君时方有三辅之役 其四","author":"王世贞","text":"未从燕市赋招魂，东海虚明孝妇冤。\n尔道行春三辅遍，萧条秋色老中原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别于鳞还邢州 其一","author":"王世贞","text":"白云寒锁郡斋深，人道朝天不可寻。\n总为股肱驱传去，仍劳明主赐黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别于鳞还邢州 其二","author":"王世贞","text":"石门高峡沙丘台，紫马春停天地开。\n无限北风吹不到，万家明月待君来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别于鳞还邢州 其三","author":"王世贞","text":"葡萄美酒玉壶寒，写向离筵泪并残。\n纵有隋珠高月色，不知中夜向谁看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别于鳞还邢州 其四","author":"王世贞","text":"蓟门挥手各风烟，并马中原别思悬。\n我欲东观辽海日，烦君西拄太行天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上巳与赵宪副郊游赵取小妇由关中适至口占戏之 其一","author":"王世贞","text":"秦中好女胜罗敷，翡翠为裳香作车。\n不用相逢问夫婿，东方千骑上头居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上巳与赵宪副郊游赵取小妇由关中适至口占戏之 其二","author":"王世贞","text":"千金西去买娉婷，万树梨花敛色迎。\n闻道燕京誇祓禊，让君先赋丽人行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卢龙署中偶成","author":"王世贞","text":"朱帘翠箔过杨花，睡起中庭日未斜。\n却似深闺娇小妇，楼头痴坐怨天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西山道起苍兔草中逐之不得","author":"王世贞","text":"马头苍兔剪春风，一线光腾杳霭中。\n落日平原青草色，不知鹰隼为谁雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卢龙署中有寄","author":"王世贞","text":"山城小雨鹧鸪啼，杨柳辞寒绿正齐。\n我梦春闺独不见，怕乘云雨问辽西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮欧阳镇朔即事有赠 其一","author":"王世贞","text":"琵琶曲按古凉州，急管清尊玳瑁愁。\n劝尔军中高太白，秋来应挂郅支头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮欧阳镇朔即事有赠 其二","author":"王世贞","text":"旌旗春偃白龙堆，教客休停鹦鹉杯。\n歌舞未残飞骑出，月中生缚左贤来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮欧阳镇朔即事有赠 其三","author":"王世贞","text":"欲从铃阁借前筹，姑衍条支一剑收。\n尔自虎头飞食肉，不教猿臂羡封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮欧阳镇朔即事有赠 其四","author":"王世贞","text":"曼缨白马下双雕，降敌辕门气不骄。\n为问浑邪能骑射，可如新帅霍嫖姚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过怀来罗将军驻兵因赠二绝 其一","author":"王世贞","text":"碧山无限锁龙堆，羌笛胡笳汉使哀。\n日暮春风鸣白羽，知君突骑射雕回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过怀来罗将军驻兵因赠二绝 其二","author":"王世贞","text":"将军按甲古妫川，万马骄嘶苜蓿天。\n但使王庭能绝幕，未劳车骑勒燕然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄紫荆龚都督二绝 其一","author":"王世贞","text":"牙旗高拥黑云间，匣里并刀龙雀环。\n夜夜胡笳吹落月，秋声不敢近燕山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄紫荆龚都督二绝 其二","author":"王世贞","text":"关头画角锁残霜，十万奇兵易水傍。\n却恨单于穿塞去，不教飞将取金章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过于鳞郡斋分赋十二体","author":"王世贞","text":"千峰西北拥岧峣，立马寒云豫让桥。\n俱道挂冠同指掌，不知山色为谁骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卫河夜汎 其一","author":"王世贞","text":"卫河秋望接天回，大艑高帆拥月来。\n为问乘槎诸汉使，几人元是谪仙才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]