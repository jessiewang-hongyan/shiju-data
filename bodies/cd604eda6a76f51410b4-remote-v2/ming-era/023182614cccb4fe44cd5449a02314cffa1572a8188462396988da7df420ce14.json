[{"title":"桃源方士诗","author":"无名氏","text":"隔江人唱《浪淘沙》，月上梧桐影未斜。\n客到浔阳谈往事，青衫无泪湿琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6363,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"痴颐子绝句二首 其一","author":"无名氏","text":"幔亭峰下寒云外，流水飞花送小舠。\n夜宿山房清不寐，紫箫吹彻月华高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6364,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"痴颐子绝句二首 其二","author":"无名氏","text":"赤壁玄堂水火交，青山旋绕白云坳。\n枕琴卧诵《黄庭》罢，新月钩帘傍鹤巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6365,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴下人诗","author":"无名氏","text":"仆夫不识路，踌躇路傍久。\n寒风吹衣襟，落日照马首。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6366,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"越僧诗","author":"无名氏","text":"寄将一幅剡溪藤，江面青山画几层。\n笔到断厓泉落处，石边添个看云僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6367,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"芭蕉士女诗","author":"无名氏","text":"独立徘徊意若何，羊车声已过銮坡。\n黄金屋里春风面，不及芭蕉雨露多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6368,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"牧牛图","author":"无名氏","text":"海宇升平卖剑时，漫劳筋力事东灾。\n林阴沙际多春草，不羡文身太庙牺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6369,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题松雪画马","author":"无名氏","text":"塞马肥时苜蓿枯，奚官早已著貂狐。\n可怜松雪当年笔，不识檀溪写的卢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6370,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画","author":"无名氏","text":"结宇蕉阴桐径边，浮名无用世间传。\n高情剩有闲中趣，写出青山不卖钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6371,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西湖八景诗 其一 冷泉猿啸","author":"无名氏","text":"冷泉亭下北山陲，曾见雌雄共引儿。\n惯听山僧朝说法，能随木客夜吟诗。\n松坡日暖人游后，蕙帐风寒鹤怨时。\n惆怅遗音无处觅，竹鸡啼老野棠枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6372,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西湖八景诗 其二 浙江秋涛","author":"无名氏","text":"怒挟西风势未休，滔滔何处觅安流。\n青山隔岸分吴越，白浪排空混斗牛。\n铁箭有灵来昨日，素车遗恨已千秋。\n晚来试倚樟亭立，枫叶芦花满眼愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6373,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"潇湘八景诗 其一 潇湘夜雨","author":"无名氏","text":"长空冥冥雨飞急，坐我扁舟浮梦泽。\n湘水风生万窍号，昭潭云起千山黑。\n旅魂寂历秋灯明，耳根已熟江湖声。\n人生多忧亦多情，中宵白发满头生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6374,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"潇湘八景诗 其二 洞庭秋月","author":"无名氏","text":"纤云不动金波浮，玉浮万里开清秋。\n青山一发渺无际，天影落镜星河流。\n中流无人万籁寂，夜深往往鱼龙出。\n何人长笛在扁舟，水远天长露华白。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6375,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"潇湘八景诗 其三 渔村落照","author":"无名氏","text":"湘江雨歇湘山明，千村万落开新晴。\n急持袯襫挂屋角，时闻款乃烟中声。\n烟中日影交凌乱，晚霞一抹斜阳岸。\n网得鲈鱼不入城，柳外旗亭酒堪换。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6376,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"潇湘八景诗 其四 平沙落雁","author":"无名氏","text":"荒陂日落沙渚黄，新霜十里菰芦苍。\n沙平水落云影薄，雁飞漠漠江茫茫。\n江寒天远西风急，沙上霜晴爪痕湿。\n月明不怪雁奴惊，江湖何处无矰缴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6377,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"盘山石刻诗","author":"无名氏","text":"盘山高巍峨，半入青云里。\n中间最上峰，更向天边起。\n行行白石崖，六月不知暑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6378,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蓟州桃花寺壁诗","author":"无名氏","text":"旧有桃花树，人呼寺故云。\n石危秋鹭上，滩远夜僧闻。\n汲井连黄叶，登台散白云。\n烧丹勾漏令，无处不逢君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6379,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"银山诗","author":"无名氏","text":"银山本在北，万丈青云梯。\n晓见居庸雪，银山忽在西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6380,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"高平碑刻诗","author":"无名氏","text":"载酒欲寻江上月，出门无路水交流。\n黄昏闷倚东风立，看去东风独地愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6381,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石空山寺题诗","author":"无名氏","text":"叠嶂玲珑竦石空，谁开兰若碧云中。\n僧闲夜夜燃灯坐，遥见青山一滴红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6382,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"祈泽寺诗","author":"无名氏","text":"研池满座落花香，墨透纤毫染汉章。\n静卧纳衣雪似水，高悬纸帐月如霜。\n杯浮野渡鱼龙远，锡振空山虎豹藏。\n幸对炉烟坐终日，煮茶清话得徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6383,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南浔祇园寺赠老僧诗","author":"无名氏","text":"清溪通笠泽，地以水为乡。\n竹青三日雨，僧白一头霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6384,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"庵壁诗","author":"无名氏","text":"急忙简点破袈裟，收拾行囊没一些。\n袖拂白云归洞口，肩挑明月绕天涯。\n可怜松顶新巢鹤，却负篱根旧种花。\n再四叮咛猫与犬，休教流落俗人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6385,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云阳爰书诗 其一","author":"无名氏","text":"长河银汉两漫漫，今夕夫君共木兰。\n一道风沙怜弱质，千秋意气讶冲冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6386,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云阳爰书诗 其二","author":"无名氏","text":"白鸥远没汀洲晚，绛烛高烧子夜阑。\n此去封侯君事毕，红颜还作白头看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6387,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朝云集句诗七言律诗 其一","author":"孙蕡","text":"家住钱塘东复东，偶来江外寄行踪。\n三湘愁鬓逢秋色，半壁残灯照病容。\n艳骨已成兰麝土，露华偏湿蕊珠宫。\n分明记得还家梦，一路寒山万木中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6388,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朝云集句诗七言律诗 其二","author":"孙蕡","text":"妾本钱塘江上住，双垂别泪越江边。\n鹤归华表添新冢，燕蹴飞花落舞筵。\n野草怕霜霜怕日，月光如水水如天。\n人间俯仰成今古，只是当时已惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6389,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朝云集句诗七言律诗 其三","author":"孙蕡","text":"三生石上旧精魂，化作阳台一段云。\n词客有灵应识我，碧山如画又逢君。\n花边古木翔金雀，竹里香云冷翠裙。\n莫向西湖歌此曲，清明时节雨纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6390,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朝云集句诗七言律诗 其四","author":"孙蕡","text":"东望望春春可怜，江蓠漠漠荇田田。\n绕篱野菜飞黄蝶，糁径杨花铺白毡。\n云近蓬莱长五色，鹤归华表已千年。\n梦回明月生南浦，泪血染成红杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6391,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朝云集句诗七言律诗 其五","author":"孙蕡","text":"浮云漠漠草离离，泪湿春衫鬓脚垂。\n秋水为神玉为骨，芙蓉如面柳如眉。\n钟随野艇回孤棹，蝉曳残声过别枝。\n青冢路边南雁尽，问君何事到天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6392,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朝云集句诗七言律诗 其六","author":"孙蕡","text":"身前身后事茫茫，恼断苏州刺史肠。\n猿带玉环归后洞，君骑白马傍垂杨。\n鹤群长绕三株树，花气浑如百和香。\n惭愧情人远相访，为郎憔悴却羞郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6393,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朝云集句诗七言律诗 其七","author":"孙蕡","text":"孤月无情挂翠峦，金炉香烬漏声残。\n云收雨散知何处，鬓乱钗横特地寒。\n去日渐多来日少，别时容易见时难。\n明朝有约谁先到，青鸟殷勤为探看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6394,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朝云集句诗七言律诗 其八","author":"孙蕡","text":"杏花疏雨立黄昏，金屋无人见泪痕。\n短鬓欲星愁有效，此身虽异性常存。\n关门不锁寒溪水，环佩空归月夜魂。\n倚柱寻思倍惆怅，夜寒皴玉倩谁温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6395,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朝云集句诗七言律诗 其九","author":"孙蕡","text":"万紫千红总是春，登临一度一思君。\n舞低杨柳楼心月，香湿梨花梦里云。\n风景苍苍多少恨，阴虫切切不堪闻。\n思君今夜肠应断，书破羊欣白练裙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6396,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朝云集句诗七言律诗 其十","author":"孙蕡","text":"零落残云倍黯然，一身憔悴对花眠。\n南园绿草飞蝴蝶，落日空山怨杜鹃。\n天若有情天亦老，月如无恨月长圆。\n此声肠断非今日，风景依稀似去年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6397,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集句七言绝句诗 其一","author":"孙蕡","text":"舞衫歌扇旧因缘，万事伤心在眼前。\n云物不殊乡国异，夭桃窗下背花眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6398,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集句七言绝句诗 其二","author":"孙蕡","text":"烟笼寒水月笼沙，谁信流年鬓有华。\n燕子衔将春色去，梦中犹记咏梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6399,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集句七言绝句诗 其三","author":"孙蕡","text":"青山隐隐水迢迢，客梦都随岁月消。\n惟有别时今不忘，水边杨柳赤阑桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6400,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集句七言绝句诗 其四","author":"孙蕡","text":"杜陵寒食草青青，长诵《金刚般若经》。\n雨冷云香吊仙客，梦中同蹑凤凰翎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6401,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集句七言绝句诗 其五","author":"孙蕡","text":"远水寒山石径斜，宫前杨柳寺前花。\n红颜未老恩先断，莫怨东风当自嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6402,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集句七言绝句诗 其六","author":"孙蕡","text":"与君别约记杭州，山外青山楼外楼。\n屈指别来今几载，愁心一倍长离忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6403,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集句七言绝句诗 其七","author":"孙蕡","text":"旅馆寒灯独不眠，湘波冷浸一枝莲。\n何时最是思君处，月落乌啼霜满天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6404,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集句七言绝句诗 其八","author":"孙蕡","text":"欲写愁肠愧不才，依稀犹记妙高台。\n问馀别恨知多少，巴蜀雪消春水来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6405,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集句七言绝句诗 其九","author":"孙蕡","text":"紫烟衣上绣春云，一树繁花对古坟。\n辛苦无欢容不理，半缘修道半缘君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6406,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集句七言绝句诗 其十","author":"孙蕡","text":"春愁冉冉带馀酲，珍簟银床梦不成。\n知子远来应有意，酷怜风月为多情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6407,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集句七言绝句诗 其十一","author":"孙蕡","text":"光阴卒卒一飞梭，怨入东风芳草多。\n旧枕未容春梦断，秦霜楚雨暗相和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6408,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集句七言绝句诗 其十二","author":"孙蕡","text":"身前身后思茫茫，秋菊春兰各吐芳。\n惭愧情人远相访，为郎憔悴却羞郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6409,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集句七言绝句诗 其十三","author":"孙蕡","text":"白袷玉郎寄桃叶，金鞍骏马呼小妾。\n翠眉蝉鬓生别离，南园绿草飞蝴蝶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6410,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集句七言绝句诗 其十四","author":"孙蕡","text":"野棠开尽飘香玉，细柳新蒲为谁绿。\n忽忽穷愁泥杀人，逢人更唱相思曲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6411,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集句七言绝句诗 其十五","author":"孙蕡","text":"瞿塘嘈嘈十二滩，绕船明月江水寒。\n欲随郎船看明月，游丝落絮春漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6412,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其一","author":"李桢","text":"花压栏干春昼长，清歌一曲断君肠。\n云飞雨散知何处，天上人间两渺茫。\n已托焦桐传密意，不将清瑟理霓裳。\n江南旧事休重省，桃叶桃根尽可伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6413,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其二","author":"李桢","text":"魂归溟漠魄归泉，却恨青娥误少年。\n自是桃花贪结子，只应梅蕊故依然。\n风流肯落他人后，哀乐犹惊逝水前。\n何事黄昏尚凝睇，孤灯挑尽未成眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6414,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其三","author":"李桢","text":"寒蛩唧唧树苍苍，城上高楼接大荒。\n午夜漏声催晓箭，六街晴色动秋光。\n满庭诗景飘红叶，此地悲风愁白杨。\n舞袖弓鞋浑忘却，人间惟有鼠拖肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6415,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其四","author":"李桢","text":"云想衣裳花想容，青春已过乱离中。\n功名富贵若长在，得丧悲欢尽是空。\n窗里日光飞野马，岩前树色隐房栊。\n身无彩凤双飞翼，油璧香车不再逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6416,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其五","author":"李桢","text":"应笑无成返薜萝，年年惆怅是春过。\n时攀芳树愁花尽，寒恋重衾觉梦多。\n桂岭瘴来云似墨，蜀江风澹水如罗。\n人生富贵须回首，世事无几奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6417,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其六","author":"李桢","text":"家在寒塘独掩扉，高情雅澹世间稀。\n不将脂粉沈颜色，惟恨缁尘染素衣。\n归目并随回雁尽，离魂潜逐杜鹃飞。\n东风吹泪对花落，惆怅朱颜不复归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6418,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其七","author":"李桢","text":"有时颠倒著衣裳，万转千回懒下床。\n艳骨已成兰麝土，蓬门未识绮罗香。\n汉朝冠盖皆陵墓，魏国山河半夕阳。\n满眼波涛终古事，离人到此倍堪伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6419,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其八","author":"李桢","text":"一寸相思一寸灰，且将团扇暂徘徊。\n月明古寺客初到，风静寒塘花正开。\n绿水青山虽似旧，红颜白发递相催。\n无情不似多情苦，肯信愁肠日九回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6420,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其九","author":"李桢","text":"形容变尽语音存，地夐难招自古魂。\n闲结柳条思远道，欲书花叶寄朝云。\n窗残夜月人何在，树蘸芜香鹤共闻。\n今日独经歌舞地，娟娟霜月冷侵门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6421,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其十","author":"李桢","text":"烽火年年报虏尘，每回回首即长颦。\n明眸皓齿今何在，异服殊音不可亲。\n几树好花闲白昼，数株残柳未胜春。\n狂风落尽深红色，水远山长愁杀人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6422,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其十一","author":"李桢","text":"弦管遥听一半悲，罗衾滴尽泪胭脂。\n鸟啼花落人何在，节去蜂愁蝶未知。\n鵩上承尘才一日，雪残岩鹊亦多时。\n绿云斜亸金钗坠，独立苍茫自咏诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6423,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其十二","author":"李桢","text":"烟郊四望夕阳曛，世路干戈惜暂分。\n内屋金屏生色画，粉霞红绶藕丝裙。\n蒹葭淅沥含秋雨，铜雀荒凉锁暮云。\n旧业已随征战尽，独留青冢向黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6424,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其十三","author":"李桢","text":"愁心一倍长离忧，到处明知是暗投。\n雨尽香魂吊书客，夜深灯火上樊楼。\n山中老宿依然在，槛外长江空自流。\n明月易低人易散，寒鸦飞尽水悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6425,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其十四","author":"李桢","text":"叶满苔阶杵满城，登高望远自伤情。\n琼枝璧月春如昨，冰簟银床梦不成。\n往事悠悠增浩叹，清愁苒苒带馀醒。\n岂知一夕秦楼客，肠断绿荷风雨声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6426,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其十五","author":"李桢","text":"芙蓉肌肉绿云鬟，泣雨伤春翠黛残。\n歌管楼台人寂寂，山川龙战血漫漫。\n千年别恨调琴懒，几许幽情欲话难。\n回首旧游真是梦，寒潮惟带夕阳还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6427,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其十六","author":"李桢","text":"一见清明一改容，每惊时节恨飘蓬。\n风尘荏苒音书绝，人物萧条市井空。\n荒埭暗鸡催晓月，野花黄蝶领春风。\n玉环飞燕皆尘土，只有襄王忆梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6428,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其十七","author":"李桢","text":"处处斜阳草似苔，野塘晴暖独徘徊。\n侍臣最有相如渴，欲赋惭非宋玉才。\n弦管变成山鸟弄，屟廊空信野花埋。\n情知到处身如寄，莫遣黄金谩作堆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6429,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其十八","author":"李桢","text":"落落疏星满太清，寒江近户漫流声。\n长疑好事皆虚事，道是无情还有情。\n且尽醁醽消积恨，休将文字占时名。\n秋来见月多归思，斜倚薰笼坐到明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6430,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"月下弹琴记集句诗二十首 其十九","author":"李桢","text":"绕门清槿绝尘埃，白石苍苍半绿苔。\n酒力渐消风力软，桃花净尽菜花开。\n一泓海水杯中泻，万里铭旌死后来。\n世上英雄本无主，争教红粉不成灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6431,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]