[{"title":"咏史 其一","author":"王立道","text":"昔闻陆大夫，声誉倾西都。\n诗书牖明主，将相钦良图。\n解橐庭下散，击鲜里中娱。\n本期乐当年，宁复忧妻孥。\n名位不可常，多财还自愚。\n惜哉绛灌徒，功成何区区。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史 其二","author":"王立道","text":"馆陶主人翁，洛阳卖珠子。\n散金买声名，宠爱倾戚里。\n翩翩东方生，滑稽何其鄙。\n一朝辟戟言，万乘逡巡起。\n雄略代所希，举俗憎逆耳。\n坐令狐鼠骄，白日游都市。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题石厓卷二首 其一","author":"王立道","text":"蚤岁慕探历，浪迹游江湘。\n朝溯洞庭波，夜发汉水阳。\n汉水日东逝，鸿雁多南翔。\n感此惜馀景，驾言返故乡。\n徙倚桂枝晚，夷犹春草芳。\n开林发幽峭，陟巘披遐荒。\n寒芜被广隰，阳葩耀崇冈。\n市隐岂云易，岩栖聊徜徉。\n赤松与王乔，末路期相将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题石厓卷二首 其二","author":"王立道","text":"连峰何㠝岏，深谷自逶迤。\n境阻尘虑绝，眺迥物趣奇。\n有时发清啸，四山生寒姿。\n天际征鸟疾，木杪惊猿窥。\n回飙激长林，浮云乱层溪。\n宇宙意自豁，簪组复何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为王允宁赠妇四首 其一","author":"王立道","text":"肃肃整晨驾，行行出秦中。\n百里日复舍，暮天多寒风。\n岂不惮雨雪，王事縻我躬。\n念此如宿夕，胡然隔春冬。\n矫首望西南，双双见飞鸿。\n飞鸿有羽翼，天路将安从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为王允宁赠妇四首 其二","author":"王立道","text":"北征日以远，远道衣裳单。\n春风薄天涯，闺中常自寒。\n辛勤理机杼，日夕掩重关。\n上堂亲饭姑，下堂不能餐。\n离离芳树枝，脉脉终无言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为王允宁赠妇四首 其三","author":"王立道","text":"东城十二楼，迢迢青云端。\n盈盈谁家子，灼灼桃李颜。\n朱唇扬妙曲，宝瑟流哀弹。\n三叹有馀音，一顾倾城观。\n信美匪吾思，秦声故所欢。\n寸心常不隔，所恨旷周旋。\n愿言保菅蒯，令德良独难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为王允宁赠妇四首 其四","author":"王立道","text":"黄鹄千里游，燕雀巢屋梁。\n小人事龌龊，丈夫志四方。\n念子畴昔言，沈思激中肠。\n赫赫盛明时，群贤并翱翔。\n朝趋铜马门，夜直金华堂。\n韩郑互推毂，贡生弹其冠。\n所期崇令名，室家自辉光。\n无为儿女仁，慊慊怀故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪屏为赵考功赋","author":"王立道","text":"佳人爱南麓，卜筑拟东山。\n地胜非因选，岩幽自可攀。\n海成人耳抱，石缀雪肤斑。\n高下鸟留道，逶迤龙作关。\n昔称万夫险，今共一川閒。\n蛮市喧林际，夷歌出谷间。\n峰疑巫峡里，水似武夷湾。\n久忆沧洲侣，聊从青琐班。\n江花几开落，溪月自潺湲。\n鱼鸟丘中赏，风尘天畔颜。\n山阴空寄兴，安石未应还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿益上人房","author":"王立道","text":"流览及兹辰，盘纡陟崇巘。\n冥色下岩扉，鸟啼前林晚。\n凉风起松杪，溪云自舒卷。\n幽期一以惬，相对各忘返。\n倚石听樵语，持经共僧饭。\n试问山中人，何如逢惠远。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚还别墅","author":"王立道","text":"筑室负东阡，开门望禾黍。\n水流满新塍，连畴何瀰瀰。\n日色时隐见，湿虹卷残雨。\n蓑笠垄上儿，牵牛饮清渚。\n折芦行且吹，两两前村去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初发乡邑别亲知","author":"王立道","text":"揆已惭蹇拙，蚤为尘网婴。\n弥年谢朝列，稍得任吾真。\n游息偶耕钓，琴书澹馀清。\n林园变时序，端居念王程。\n整驾倏晨迈，耿耿辞密亲。\n匪嗟倦行役，曾是忧缁磷。\n永怀千里道，中情难具陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问故园","author":"王立道","text":"倦游无素业，溪上聊避喧。\n因兹役风尘，转复思丘樊。\n兰径日以合，桂枝秋正繁。\n斜景度书幌，鸟鸣窥前轩。\n谷口迹已芜，北山意弥敦。\n华组不足羁，允怀明主恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南村一首","author":"王立道","text":"我逢南村人，为问南村路。\n杳悄入萝薜，依微辨烟树。\n日出散鸡豚，春至营农圃。\n邻里数相过，壶觞自成趣。\n城市独何为，车尘满朝暮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀朱数畴","author":"王立道","text":"吾兄东南秀，矫矫青云姿。\n弱龄弄芳翰，玄文吐奇思。\n一经夏侯学，廿年董生帷。\n雅志古人会，独行俗士疑。\n献赋未云遇，踠足清明时。\n骥齿嗟已至，旷波千里期。\n何当逢伯乐，为君解纻衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萱节图为俞汝承题","author":"王立道","text":"有草目以萱，英英倚孤岑。\n皎皎岁寒节，风霜讵能侵。\n北堂宁以清，耿耿怀素心。\n一朝结芳实，蓺之琼树林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邵氏贞孝卷","author":"王立道","text":"结发事良人，婉娈方及时。\n何意忽弃捐，百年旷前期。\n镜破难复合，鸾孤不成飞。\n一死宁自惜，念此乳下儿。\n辛苦理织纴，伶仃母心悲。\n抚儿儿有成，宗祀幸不隳。\n清冰出寒潭，白璧扬光辉。\n风声动里闾，高门郁崔嵬。\n斯名吾何心，节苦良独知。\n黄鹄有遗歌，千载令人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"履端诗馆试","author":"王立道","text":"天行有终始，贞元若连环。\n玄冥顿穷辔，勾芒行其官。\n万物回春姿，八荒同熙然。\n王正启休历，时龙蹑乾端。\n群材仰明哲，蔼蔼共跻攀。\n结绶金马门，论道云台间。\n努力图不朽，失时空自叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏怀","author":"王立道","text":"解薜游京洛，登朝袭华组。\n拙疾寡所谐，一心事明主。\n寓言或玩世，为行多泥古。\n巧宦宁寂寂，学步终踽踽。\n徒惭短绠汲，强作长袖舞。\n子云安执戟，相如荣负弩。\n徇禄祗自疲，谋道良有取。\n卒岁何悠游，永愿营农圃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁未岁病起入都有怀里中诸友作药名诗贻之","author":"王立道","text":"微尚甘草莱，桂枝自淹留。\n爰附子年情，谬寄生人忧。\n半夏涉长道，天门足荫休。\n迢迢望南星，远志成倦游。\n藤萝蔓荆扉，杞菊荒深秋。\n防已挂尘网，遄当归旧丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸟名","author":"王立道","text":"皇居肃凤城，迢递干云霓。\n孔盖凌风翔，翠帱纷绮缬。\n伊余慕休名，雀跃趍前哲。\n射隼幸逢时，鸿飞下羁绁。\n差池背雁行，委蛇滥鸳列。\n弹冠侈鵔鸃，含香重鸡舌。\n自怜鹪鹩枝，徒惭鸴鸠拙。\n关雎咏清化，凫鹥际盛烈。\n眷言守忠贞，宁复辞缁涅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"草名","author":"王立道","text":"早为芸阁吏，丛兰春复秋。\n吾道随卷葹，诛茅溪水头。\n送客蘼芜径，采芳杜若洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二首 其一","author":"王立道","text":"独树生穷谷，枝干何离奇。\n本无廊庙用，误为匠石知。\n斤墨既错陈，青黄亦互施。\n虽云托华屋，宁复山林姿。\n龙扰失其神，坐令燕雀疑。\n玉成世所宝，大璞还自亏。\n造物固其然，岂得尤工师。\n翻羡不材者，终年养华滋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂诗二首 其二","author":"王立道","text":"征途与日长，逶迟及春暮。\n山川异土风，心赏邈难遇。\n言念中田庐，幽期久沦误。\n临流怀在涧，攀林忆芳树。\n极浦瞩去帆，平原羡归羽。\n回沿穷昏旭，逼侧谢坟素。\n遥负北山文，空拟归田赋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书馆述怀","author":"王立道","text":"凉秋肃金气，玉露凋青林。\n微风拂虚牖，萧然吹我襟。\n感此时序易，岁月何侵寻。\n邺侯架万卷，诸葛一长吟。\n儒生事稽古，志士多苦音。\n我昔仰尼父，斯文以为任。\n哲人久云萎，传之回与参。\n参乎唯一贯，回仁三月心。\n观海登泰山，由来高且深。\n夜央不能寐，耿耿宁自今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"论交","author":"王立道","text":"青青大田麻，蓬生满其中。\n弱丝附直干，缠绵得所从。\n古人重友生，资彼丽泽功。\n倾盖一相知，白首此心同。\n谁言淡如水，君子贵有终。\n乾糇起愆怒，习习多谷风。\n平生握手欢，笑语藏机锋。\n利合谊还厚，势尽情自穷。\n歌彼伐木诗，怆然感予衷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"盆榴","author":"王立道","text":"嘉木来安石，移根向玉堂。\n亭亭倾翠盖，隐隐孕红妆。\n叶润初晞露，花迟解待阳。\n层阴清昼气，奇艳夺天香。\n尺土能滋干，三春独掩芳。\n匡庐多紫萼，南国重朱房。\n旖旎时凭槛，纷敷共映觞。\n时无橐驼子，养树说谁长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春郊即事","author":"王立道","text":"柔风吹绿野，灵雨下桑田。\n泥泥花间露，霏霏草上烟。\n鸣鞭蓟门道，弭节燕台边。\n芳树连丝障，垂杨拂锦鞯。\n未能游曲水，时复问温泉。\n地迥山川静，天高宫阙连。\n相将瑶瑟鼓，共醉羽觞传。\n白日恒随转，青春自可怜。\n咏归禁城暮，聊续名都篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"捣衣篇","author":"王立道","text":"玉关萧索尽，音尘不可期。\n黄姑织女星，远耀隔天阶。\n露气侵兰桂，秋风吹鼓鼙。\n佳人理端素，坚砧杵声哀。\n一声一惆怅，一声一垂洟。\n妖蟾惊幽姿，寒蛩相依啼。\n风飘膏兰歇，月照纤云皑。\n纨成阒潜闼，张燧候剪裁。\n初缝合欢扇，中装骠姚衣。\n骠姚重功名，勒石燕然台。\n妾悲难重陈，呜咽泉流知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏污渠鹤","author":"王立道","text":"华表归何日，乘轩事已非。\n终朝独含垢，所幸脱虞机。\n失侣频看影，长鸣似诉饥。\n空馀出尘意，皎皎向寒晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙三首 其一","author":"王立道","text":"仙人住玉京，累劫道初成。\n指树元非姓，餐松偶得名。\n龙嘘云盖引，虎奉岳图迎。\n相待天台路，何时返赤城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙三首 其二","author":"王立道","text":"玉室书名久，清溪得道初。\n赤文河上箓，鸿宝枕中书。\n龙吐烧丹火，鸾骖度海车。\n偶来华表上，终与世人疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙三首 其三","author":"王立道","text":"何年海上客，移住缑山岑。\n未辨云霞色，先闻鸾凤音。\n山神供石髓，童子问琴心。\n一谒紫皇去，仙踪不可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"前汤庵","author":"王立道","text":"僻地多逢寺，秋花满石坛。\n僧閒缝衲坐，客到出门看。\n失姓离群久，躬耕乞食难。\n清言殊未厌，车马去长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送严节推","author":"王立道","text":"佐郡声名久，辞家道路难。\n那堪今日去，犹是昔年官。\n旌节先春度，爰书入夜看。\n君平能自卜，留滞不须叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈守之任沂州","author":"王立道","text":"馀春随五马，千里去长安。\n羡子成刀梦，从人问鸟官。\n花迎新佩绶，草长古雩坛。\n政美偏多暇，言追点尔欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"许院判挽歌二首 其一","author":"王立道","text":"越人生死术，何事不长年。\n仙迹壶中隐，神方肘后传。\n遗忠犹药石，故里自风烟。\n应是轩农佐，相将去九天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"许院判挽歌二首 其二","author":"王立道","text":"医国早称良，金门数献方。\n忽闻骑鹤去，无复入鹓行。\n洗药春流咽，藏舟夜壑光。\n长安今罢市，相恨失韩康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送益上人南归","author":"王立道","text":"苦行不求知，清吟祗自怡。\n来寻白马寺，去作紫衣师。\n弟子邀升座，山人觅赠诗。\n还思渡杯处，明月满须弥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡友","author":"王立道","text":"握手几论文，高才夙所闻。\n将因厌尘网，早已谢人群。\n日短风云驶，山空芝蕙焚。\n不堪重挂剑，宿草满孤坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正月雪和韵","author":"王立道","text":"长安春后雪，犹自兆年丰。\n万里鸿归处，千门晓望同。\n气融疑湛露，质薄故冲风。\n莫羡梁园赋，应怜东郭穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒三忠祠","author":"王立道","text":"寥落遗忠像，杉松古殿阴。\n兴亡问流水，哀怨动鸣禽。\n志厄当年会，神垂异代歆。\n独临车马道，应识往来心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日閒居三首 其一","author":"王立道","text":"我本陆沈久，幽栖意自宜。\n心清知俗远，地僻讶春迟。\n种竹先留径，移花欲傍池。\n门前剡溪棹，来往更无期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日閒居三首 其二","author":"王立道","text":"习静因成癖，春来常闭关。\n山人留药去，稚子借书还。\n读传希高士，攻辞愧小山。\n犹牵青琐梦，供奉紫宸班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日閒居三首 其三","author":"王立道","text":"市隐不违亲，移居正及春。\n未能从白社，稍得谢缁尘。\n僦地但栽秫，钓鱼唯煮莼。\n时逢河曲叟，笑我独长贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画","author":"王立道","text":"结宅千峰里，真堪与世违。\n云来似招隐，鸟下为忘机。\n花径缘溪窄，茶烟带雨霏。\n有时还隐几，应是灌园归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村居感兴三首 其一","author":"王立道","text":"芳树含春风，鸣禽乱晴日。\n藜蒿欲满园，扫除唯一室。\n閒情共水云，生计耽书帙。\n时无问奇人，悠然独抱膝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村居感兴三首 其二","author":"王立道","text":"翩翩高世情，悠悠避时计。\n筑室近樵渔，乘春树兰蕙。\n虽无求仲邻，亦有君平艺。\n不学同时人，献赋空靡丽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村居感兴三首 其三","author":"王立道","text":"出郭车马稀，况复园林好。\n言念当涂人，翻悲灌畦老。\n青琐久已疲，玄文近能草。\n澹然荣利间，何如乞身早。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜唐应德见访别墅二首 其一","author":"王立道","text":"学隐畏逢人，郊扉绝四邻。\n时多讥偃蹇，子独念交亲。\n奇树行相问，幽兰坐共纫。\n还因漉酒便，一解陶潜巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜唐应德见访别墅二首 其二","author":"王立道","text":"閒居澹时好，日倚槁梧吟。\n幸枉空虚足，重闻山水音。\n沧波投迹远，玄理寄言深。\n野服君能惯，从来多道心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日溪上偶成","author":"王立道","text":"本无羡鱼意，聊复上苔矶。\n坐惜青蘋晚，行攀碧树稀。\n儿童喧钓艇，鸡犬狎邻扉。\n近喜桑麻好，迎霜早授衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚起偶成","author":"王立道","text":"晚起独悠然，云山满目前。\n常疑身是隐，早觉性通禅。\n座引清心月，池分洗耳泉。\n故园翻似客，草色又经年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋居用唐人韵得五首 其一","author":"王立道","text":"平生轩组意，不为慕轻肥。\n身世夔怜蚿，风尘犬吠衣。\n微官百指累，旧业五湖归。\n怪得驱驰久，秋来双鬓稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋居用唐人韵得五首 其二","author":"王立道","text":"本为悲摇落，还因厌俗尘。\n次公酒狂士，方朔谪仙人。\n偃仰四空壁，周旋一垫巾。\n眼前无长物，非是拙谋身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋居用唐人韵得五首 其三","author":"王立道","text":"四户啼螀乱，秋阴欲上阶。\n菊花收作枕，草蔓缉成鞋。\n得句先书壁，因琴别置斋。\n溪云与山月，总不费安排。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋居用唐人韵得五首 其四","author":"王立道","text":"重来北山客，却愧草堂灵。\n窈窕郑生谷，寂寥扬子亭。\n检山收地志，盥手阅心经。\n长日看逾短，秋声入夜铃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋居用唐人韵得五首 其五","author":"王立道","text":"木落随寒雨，林开际远天。\n水纹摇簟竹，秋气入琴弦。\n倚树禽相语，班荆鹿共眠。\n机心日以尽，自讶骨如仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送骆质夫谢病归湖州和王允宁二首 其一","author":"王立道","text":"闻君旧隐处，正傍太湖滨。\n课树收柑子，浇松养茯神。\n秪缘身病累，转觉道情真。\n何日重开径，求羊卜尔邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送骆质夫谢病归湖州和王允宁二首 其二","author":"王立道","text":"高卧山围屋，幽吟竹绕町。\n斗鸡新续句，相鹤旧传经。\n一鸟波间白，千峰雨后青。\n相怜少同病，怪尔室常扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕雨二首 其一","author":"王立道","text":"汉渚邀灵匹，幽盟此夜寻。\n盈盈唯一水，暮暮更为云。\n洒道流馀润，扬波荡夕氛。\n含情愁雨绝，随泪点罗裙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕雨二首 其二","author":"王立道","text":"灵鹊翻占雨，神京似灌坛。\n迎针丝乱度，映烛泪先残。\n机石新含润，河梁欲下湍。\n寻源海上客，昏黑路应难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]