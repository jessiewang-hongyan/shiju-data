[{"title":"奉和数畴兄对酒自叹之作 其二","author":"王立道","text":"忆骑竹马逐诸儿，忽道行年四十踰。\n谋食一身长畎亩，起家三世总文儒。\n青山对酒从吾好，华毂倾人笑自驱。\n世路只今多险塞，与君试学北山愚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和数畴兄对酒自叹之作 其三","author":"王立道","text":"时序惊心又素秋，此心应得几宜休。\n微官出入庄生蝶，散帙纵横王子筹。\n物累秪馀琴鹤在，道心唯共水云谋。\n年来苦热缘多病，又向山中半月留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"数畴兄以病阻看花之约作诗见遗次韵答之 其一","author":"王立道","text":"经时卧病觉春才，犹喜名花迟尔开。\n好客暂虚文举座，新诗先睹马卿才。\n渐惊落絮侵棋局，故引游丝罥酒杯。\n我亦文园同病侣，更留述作待君来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"数畴兄以病阻看花之约作诗见遗次韵答之 其二","author":"王立道","text":"烂熳芳园此日才，春风小径为君开。\n一枝早占倾城色，四韵空惭倚马才。\n野外不妨频纵棹，病馀应喜数飞杯。\n刘郎旧是多情者，可待名花落尽来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"数畴兄以病阻看花之约作诗见遗次韵答之 其三","author":"王立道","text":"春深饶睡梦回才，接得诗筒枕上开。\n莫讶相如非病客，须知太白是仙才。\n洛阳更长名园价，金谷空馀罚酒杯。\n点缀春光应不惜，一花乞与一诗来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日再过顾氏清溪别业因和洞阳韵","author":"王立道","text":"秋水蒹葭思不禁，扁舟重繫此溪阴。\n犊眠疏草犹迷径，鹤哺新松欲满林。\n采药常嫌惊鹿迹，山中初服野人心。\n旧来渔父多相笑，一别江湖霜鬓侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泛湖游漆塘诸山再次前韵","author":"王立道","text":"湖上秋风病未禁，兴来真欲到山阴。\n渔蓑乱结汀洲草，樵径香分橘柚林。\n远谷采薇随鹿迹，閒岩投果见猿心。\n放歌未尽空回棹，落日增波忧思侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"追送陈澄江用章水东韵 其一","author":"王立道","text":"两月相逢已隔年，翩翩征袂忽离筵。\n青春剑佩明秦岭，细雨桑麻绕涑川。\n莫恨一麾犹出守，须知五马亦峨然。\n傅岩今日经行处，更访当年版筑贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"追送陈澄江用章水东韵 其二","author":"王立道","text":"炉省追陪忆往年，留连何必对芳筵。\n封陈亦自须蒲阪，借寇还宜念颍川。\n故国春光难忘却，清灯心事共犁然。\n使君异政屏风在，况有当时能荐贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题龙江","author":"王立道","text":"江桥一别思如何，楚水燕山岁月多。\n云雾只疑龙化去，梦魂常逐雁来过。\n江妃夜出收遗佩，海估春经惜逝波。\n好似当时题柱客，浮云空负采菱歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万梅庵诗","author":"王立道","text":"结庐不托桃李场，罗浮村畔孤山阳。\n疏窗影落一枝瘦，虚室风吹千斛香。\n烟壑霏霏来暝色，湖波渺渺动晴光。\n江南应得春意早，折寄无妨驿路长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕忆诸弟和沈原约韵","author":"王立道","text":"灯火楼台皓魄圆，客心何事忆当年。\n鹡鸰飞处情多绪，鸿雁来时书几传。\n春夜月如秋夜冷，燕山云与越山连。\n谁家更奏思归曲，无奈愁肠万丈牵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日郊行","author":"王立道","text":"冀北初秋暑尽消，无端风雨木萧萧。\n野农罢饷还倾筥，贾客愁寒半挟貂。\n雁碍浮云时缓度，草迎微露更先凋。\n何人四望踌躇立，多病应无辱圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同序翁邵园赏菊赴李蒲汀之约用旧韵","author":"王立道","text":"几年闻说邵家园，今日黄花对绿尊。\n水阁山亭斜肖郭，柳蹊松坞曲成村。\n登高直倚林梢槛，向夕仍开竹外轩。\n莫谓丝纶有馀暇，太平箫鼓藉君恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和与新见赠韵一首","author":"王立道","text":"高阁层轩野水西，白云长此护幽栖。\n买田祗为开三径，莳药还须满百畦。\n春去林中花自发，客来竹下鸟先啼。\n夜游何事频携烛，明月纷纷随杖藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏夜同唐应德王道思寻顾与新清溪别业主人追至设燕","author":"王立道","text":"扶疏嘉树荫清流，卜筑曾闻顾虎头。\n乘兴不须题凤字，逃空聊复上渔舟。\n忽逢名胜尊前集，好伴沈冥物外游。\n湖上秋风芳杜晚，月明相忆仲宣楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒于肃悯墓祠","author":"王立道","text":"整顿乾坤事已休，冥心东市更何求。\n亦知圣主能怜旧，无那书生欲拜侯。\n一木空悲支大厦，两旗犹见度中流。\n岳祠相望湖南北，长共忠魂地下游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邹学士赴南京","author":"王立道","text":"摇山仙馆接瀛洲，稷下名儒早见收。\n玉笋暂随鹓鹭入，金陵重忆凤凰游。\n传经鹤禁恩犹渥，问道鹅湖意始酬。\n莫爱江山久留滞，伫看明主待谋猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送鸿山殿读归省","author":"王立道","text":"珥彤几岁共仙庐，羡子承恩下玉除。\n春昼正宜新赐服，山房更检旧藏书。\n梦回北阙陈情后，歌倚南山献寿初。\n我亦高堂凝望久，不堪千里独离居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长至日忆诸弟","author":"王立道","text":"冬至阳生春欲回，天涯节序思难裁。\n自怜北地常逢雁，为望南云独上台。\n玄草已甘吾寂寞，綵衣须共尔徘徊。\n去年此日还相忆，携手前溪问野梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆昔吟赠华鸿泉之金陵","author":"王立道","text":"忆昔秦淮桥上游，绿槐垂穗正宜秋。\n燕飞不记乌衣巷，水满微分白鹭洲。\n北阙晴云常冉冉，东山斜日自悠悠。\n风流谁是今安石，惆怅苍生独倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孟冬陈戚畹第会同年有述","author":"王立道","text":"甲第晨开簇锦鞍，同时休沐帝恩宽。\n形容不改登科旧，樽俎还追锡宴欢。\n漫拟新诗赓伐木，相逢明世喜弹冠。\n招寻岂为酬良月，应共芳情保岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏紫薇花","author":"王立道","text":"紫薇开处觅蓬瀛，深院层轩拂晓晴。\n绚烂只疑春色在，葳蕤偏傍日华明。\n丝纶阁下人谁伴，虚白堂中韵未成。\n祗恐秋风不相假，缓吟深酌对寒更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日试笔","author":"王立道","text":"阊阖东风送旧符，氤氲佳气绕皇都。\n金吾千仗如云拥，玉佩同声向晓趍。\n春令已从今日布，物华应与去年殊。\n侍臣下直明光殿，紫禁传宣又赐酺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花朝感兴","author":"王立道","text":"疏雨轻风湿晓烟，曲江春色倍堪怜。\n新蒲细柳行宫里，语燕啼莺御道边。\n拟向尊前销客思，更于花下惜芳年。\n明时事业非无赖，扬子何为独草玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"院中红杏","author":"王立道","text":"天公何意属青阳，留却繁红殿众芳。\n仙圃岂应须鼓发，淄林时复见琴张。\n朱栏露重欹晴锦，翠箔风微浥晚香。\n羡尔倚云真得地，野花空自落东墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郑泰陵诗","author":"王立道","text":"千林松桧郁相回，永夜风生浣海哀。\n万国昔曾瞻气象，五云空复护崔嵬。\n古来凤鸟长难至，天上龙髯定不回。\n苦忆焚香赐第日，报恩真愧济时才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至日长陵陪祀","author":"王立道","text":"长陵西接黄花镇，白雪苍岩夜色遥。\n阴殿衮龙犹在目，往时松柏已干霄。\n总闻一怒风尘起，想见千官迁次朝。\n怅极两京兴废事，小山何意起渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题文岩画端","author":"王立道","text":"远山近山澹空翠，天风迢迢吹薜荔。\n溪边野桥石乱倚，林扉昼扃花满地。\n主人独归如有迟，黄精饱饭松醪醉。\n山深不解名与利，练袍芒鞋了生事。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西苑春晴","author":"王立道","text":"二月韶光满帝城，上林啼鸟报新晴。\n依空袅袅游丝静，极望萋萋芳草平。\n风煖昭阳翻翡翠，波融太液浴鵁鶄。\n回看夹路花齐发，应待銮舆向此行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宫柳","author":"王立道","text":"占尽芳菲春暮天，昭阳柳色倍堪怜。\n千条晓湿金茎露，几树晴低青琐烟。\n暗叶藏莺娇自语，飞花蹴燕舞还颠。\n宸游到处成欢赏，又见朝来三起眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟圣驾祀陵毕奉圣母汎舟西湖应制","author":"王立道","text":"凤辇逶迤环紫极，春明雨露动宸思。\n遍修祖祀桥山冢，更侍慈颜太液池。\n原陵回望衣冠道，汾水空惭箫鼓辞。\n神圣于今兼顺孝，相如欲赋苦才迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻雁","author":"王立道","text":"漏转更深月满楼，雁飞远送一声秋。\n联翩晓起芙容苑，三五寒迷芦荻洲。\n古塞离云常漠漠，空山落木共悠悠。\n潇湘自是饶梁稻，应为随阳向帝州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"午日驾幸西苑侍游有述","author":"王立道","text":"薰风澹荡上阳楼，西望昆明积雨收。\n艾叶菖花迎凤辇，兰桡桂桨过龙舟。\n当年虚羡明良会，此日恭陪伴奂游。\n帝德如天时正午，微臣何以颂鸿休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏陆节之 其一","author":"王立道","text":"早闻通藉金闺里，谢病还携旧金紫。\n行年七十苦好吟，满卷新诗放翁似。\n洞房鼓瑟奴婢歌，秋月春镫欢更多。\n自羡名园常负郭，不须尘陌逐鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏陆节之 其二","author":"王立道","text":"扁舟暝逐使君行，已是归帆一月程。\n恩诏多惭优浅薄，风期独喜托才英。\n江回故国春迎棹，星聚清尊夜倚琼。\n我亦天涯同病客，翻怜司马滞江城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏怀","author":"王立道","text":"路难词客几时还，坐对荆扉手自关。\n深树鸟鸣春寂寂，空墙花落晓班班。\n两都献赋惭新宠，五老藏书忆旧山。\n□□□□□□□，子云莫自惜才悭。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春雨二首 其一","author":"王立道","text":"霏微初洒润，霢霂自知时。\n上林千万树，树树有新枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春雨二首 其二","author":"王立道","text":"渰渰来天际，津津溜苑墙。\n还腾百川水，一雨遍遐荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊原春望二首 其一","author":"王立道","text":"行行穷远陌，冉冉度香车。\n未就王孙饮，聊看田父锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郊原春望二首 其二","author":"王立道","text":"莺啼燕树合，水漫渚蒲新。\n春归不须恨，化域自常春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詹司训守贞义训卷","author":"王立道","text":"早慕共姜节，还誇孟母贤。\n尔来授经处，应废蓼莪篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂花十三首 其一 葵","author":"王立道","text":"卧病违朝谒，依然向日心。\n不见清溪上，葵花一院深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂花十三首 其二 罂粟","author":"王立道","text":"野人悬磬室，那得粟千罂。\n且共搴芳实，无须惜落英。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂花十三首 其三 鸡冠","author":"王立道","text":"迎风如欲斗，彻曙不知啼。\n旧得尸卿术，栽花总似鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂花十三首 其四 蝴蝶","author":"王立道","text":"本来百虫身，堕入诸花趣。\n有情与无情，常爱中园住。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂花十三首 其五 金钱","author":"王立道","text":"山人卖卜归，满砌正芳菲。\n不堪悬竹杖，留取市荷衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂花十三首 其六 蔷薇","author":"王立道","text":"密蕊与繁枝，参差间竹扉。\n红芳虽自媚，绿刺罥人衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂花十三首 其七 剪春罗","author":"王立道","text":"昔闻綵作花，花却春罗似。\n欲觅剪刀痕，尽付东风里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂花十三首 其八 石竹","author":"王立道","text":"丰茸斗春色，枝叶何娟娟。\n弱质难栖凤，从教香麝眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂花十三首 其九 玉簪","author":"王立道","text":"擢颖疑瑶华，攀条乱素手。\n酣歌不自聊，助予一搔首。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂花十三首 其十","author":"王立道","text":"秋园金气应，含素向栏干。\n莫作朝簪比，唯宜戴箨冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂花十三首 其十一 长春","author":"王立道","text":"长伴百花开，不共百花老。\n误却送春诗，只疑春正好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂花十三首 其十二","author":"王立道","text":"碧树攀欲尽，黄鸟啼正歇。\n一花复一花，常如二三月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂花十三首 其十三 白芙蓉","author":"王立道","text":"抱质宜素秋，开花如白槿。\n对尔好玄谈，何郎新傅粉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂草八首 其一 兰","author":"王立道","text":"清芬惬幽抱，手自植中林。\n不须滋九畹，聊此对同心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂草八首 其二 萱","author":"王立道","text":"芳丛杂芝蕙，称此北堂幽。\n为园自可乐，那必尔忘忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂草八首 其三 书带","author":"王立道","text":"地惭扬子宅，草似郑公乡。\n书卷年来废，空翻白日长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂草八首 其四 绣墩","author":"王立道","text":"百花春色里，一径鸟声中。\n偏称游人坐，壶觞谁与同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂草八首 其五 千年运","author":"王立道","text":"朝菌无晦朔，此草自千年。\n万物枯荣理，凭栏一慨然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂草八首 其六 菖蒲","author":"王立道","text":"托根长水石，正与幽人宜。\n更看成九节，服食比华芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂草八首 其七 凤尾竹","author":"王立道","text":"紫文何葳蕤，采采露华滋。\n不向高冈上，常依白石墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏园中杂草八首 其八","author":"王立道","text":"寂寞含清露，葳蕤荫紫苔。\n尾长无羽翼，不得上仙台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏菊十首 其一 梅花菊","author":"王立道","text":"彭泽高人里，孤山处士家。\n清明迥相映，草树亦交花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏菊十首 其二 万卷书","author":"王立道","text":"生涯万卷书，何似营农圃。\n散帙向晴檐，中有诸花谱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏菊十首 其三 御袍黄","author":"王立道","text":"霜黄上林草，天子欲更衣。\n六宫齐望幸，红紫漫成围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏菊十首 其四 金盏银台","author":"王立道","text":"常年老瓦盆，珍重花神意。\n白衣人不来，对尔聊成醉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏菊十首 其五 蜂房","author":"王立道","text":"秋香初破蕊，游蜂日来往。\n还愁蝴蝶竞，结窠花枝上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏菊十首 其六 鹅毛菊","author":"王立道","text":"弱羽缀芳枝，离褷傍水涯。\n欲识此花品，唯应逸少知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏菊十首 其七 楼子红","author":"王立道","text":"天工潜结构，朵朵叠红英。\n为是登高助，偏宜楼子名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]