[{"title":"灯夕悼感 其二","author":"王彦泓","text":"城隅草树响悲风，一点纱灯耿殡宫。\n记得昔年烟月下，红莲双引到园中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30094,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"灯夕悼感 其三","author":"王彦泓","text":"此夕灯前奠枣脩，缟衣群婢上空楼。\n羡人桩束灯街走，闷向灵筵泣不休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30095,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"灯夕悼感 其四","author":"王彦泓","text":"椒浆浅注勿盈卮，糕碗仍添蜜一匙。\n曾是向来调药惯，意中甘苦只侬知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30096,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"灯夕悼感 其五","author":"王彦泓","text":"遗男婚娶最关怀，垂死叮咛尚百回。\n今夜香烟灯影裹，可知新妇点茶来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30097,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"灯夕悼感 其六","author":"王彦泓","text":"浓熏小像炷牙香，步月邻娃过影堂。\n曾执绣缄称弟子，独揩清泪两三行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30098,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"灯夕悼感 其七","author":"王彦泓","text":"云母灯球施佛前，前春买得映床悬。\n羸姿侧卧搴帏赏，无分仍看第二年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30099,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白山茶插髻甚可观因书二绝 其一","author":"王彦泓","text":"玉茗先生迥出尘，语言无处不清新。\n琼花风度钗头见，更觉堂名绝可人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30100,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白山茶插髻甚可观因书二绝 其二","author":"王彦泓","text":"第一人簪第一花，风吹花叶雾鬟斜。\n看来姿韵超天下，当得临川丽句夸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30101,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"骊歌二叠送韬仲春往秋陵 其一","author":"王彦泓","text":"平居愁绝怕清闲，却到临岐集百端。\n别后极知当作恶，跟前犹冀一追欢。\n殷勤舟去迎桃叶，慷慨杯闲舞蔗竿。\n从此故人疏笔砚，断肠吟出阿谁看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30102,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"骊歌二叠送韬仲春往秋陵 其二","author":"王彦泓","text":"怜君辜负晓衾寒，和暖和香上马鞍。\n村落莺花寻醉易，野桥风月减衣难。\n联翩好句车中获，澹宕晴山帽侧看。\n传语冰心顾家妇，露葵烹好劝加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30103,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春暮减衣","author":"王彦泓","text":"风汩残阳雨拂帘，晚春衣服减还添。\n难消素手为缝绽，那得闲心问织缣。\n病肺未能疏酒盏，诗肠无奈近香奁。\n孤吟赢得无聊在，试倩南华下一砭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30104,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无绪 其一","author":"王彦泓","text":"繁华白日怯登临，宴坐焚香午院深。\n中酒心情频卧起，酿花天气乱晴阴。\n怀人瞥见难重觅，得句随忘懒更寻。\n空寄石榴双叶子，隔帘消息正沉沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30105,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无绪 其二","author":"王彦泓","text":"春来无伴与猖狂，书卷聊支白日长。\n寒尽蕙花犹几剪，雨前茶叶不多枪。\n客呈便面题新句，婢掣搔头拨晚香。\n偶忆洛神风席逸，粉笺临得十三行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30106,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"偶成","author":"王彦泓","text":"晚晴相唤浣罗衣，惆怅春波没石矶。\n忽觉风吹歌笑近，南邻游女画船归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30107,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感事","author":"王彦泓","text":"幽栖不合在墙东，尚有尘喧到耳中。\n浊酒价低春店满，村伶伎尽夜场空。\n染须耆老窥邻艳，露肘儒酸炫族公。\n终是贵人能解事，白楼亭院换青红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30108,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"城楼暝望","author":"王彦泓","text":"鱼鳞波面夕阳微，旋见游船续续归。\n酒后笙歌催急拍，城根灯火唤开扉。\n孤扬傍水疑人立，病叶零风似蝶飞。\n明旦出游晴得否，月轮添晕几重围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30109,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙山所见","author":"王彦泓","text":"满山新叶绿初肥，三月群莺正乱飞。\n花片总粘游子屐，藤梢偏罥美人衣。\n球场试马盘三匝，毯席呼卢坐一围。\n莫为酒酣嫌耳热，垂杨低路逆风归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30110,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"六叔以扇命画","author":"王彦泓","text":"男儿安在有家为，一喝成卢颇自奇。\n倒橐尚沽千里骨，当垆犹看远山眉。\n嗣宗未许儿同调，武子元知叔不痴。\n留取紫罗香佩在，阿元相就赌围棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30111,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"窥处","author":"王彦泓","text":"窥郎眉眼任郎窥，似喜如羞又怕疑。\n巧笑正宜花掩映，狂心全被酒扶持。\n辛勤袖我三年字，取次酬卿十索诗。\n递与玉彄犀合子，阿娘当面不教知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30112,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和端己韵 其一","author":"王彦泓","text":"斗茶庭院喂蚕天，薄袖单衫似去年。\n末接语言当面笑，暂同行坐夙生缘。\n狂生易得风流罪，好女难参月上禅。\n暗地忆人终觍腆，若为呈露向君前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30113,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和端己韵 其二","author":"王彦泓","text":"添助情欢是别离，雪泥花雨坏佳期。\n醒成消渴那因酒，画出娉婷赖有诗。\n浴室笑言樊昵侍，闺房风格济尼知。\n由来心醉倾城处，早在凝颦薄怒时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30114,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和端己韵 其三","author":"王彦泓","text":"游丝摇曳燕飞翔，漾絮浮花正满塘。\n髻样翻新应爱短，情函道旧不嫌长。\n离魂路有云千叠，隔泪人如水一方。\n最是不堪情味处，残春时节更残阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30115,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"又次前韵","author":"王彦泓","text":"宽衫松鬓态飞翔，缓踏春莎过柳塘。\n风恶倍怜宜主瘦，波平谁辨宓妃长。\n乌丝好赠蝇头字，素面何施獭髓方。\n人去远犹回望见，高楼西角立残阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30116,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘灵 其一","author":"王彦泓","text":"戏仿曹娥把笔初，描花手法未生疏。\n沉吟欲作鸳央字，羞被郎窥不肯书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30117,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘灵 其二","author":"王彦泓","text":"玉指新传小忽雷，凌晨已按两三回。\n明知阿母娇怜甚，频唤梳头不肯来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30118,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘灵 其三","author":"王彦泓","text":"妆成浴手卸金彄，女伴孜孜看不休。\n一样绣针花剪手，怪他偏自会梳头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30119,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘灵 其四","author":"王彦泓","text":"看镜徘徊影自怜，关心消息在今年。\n风情领略非容易，天付儿身若个边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30120,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湘灵 其五","author":"王彦泓","text":"新春初唱想夫怜，记拍亲钞在粉笺。\n难字幼年曾读过，班姬书内第三篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30121,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日","author":"王彦泓","text":"幽人长夏倦梳头，数纸南华足散愁。\n善舞那如羊叔鹤，恶书才似郑家牛。\n里儿自不知元亮，市女谁敖识伯休。\n休问一生穿几屐，卧看图画当闲游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30122,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"澄江客兴","author":"王彦泓","text":"匹练江光洗客愁，杜康桥畔几追游。\n吟余落日过茶馆，睡美凉风在竹楼。\n违俗诗文从嫚骂，寄人书札任沉浮。\n乡园无屋归心懒，拟借张融岸上舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30123,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"纪遇","author":"王彦泓","text":"曾向长陵小市行，买花帘下见卿卿。\n娇嗔不爱同心结，痛惜那拚割臂盟。\n误逐春风穿别院，怅逢佳月隔重城。\n含桃一咽寻常事，销断狂魂目乍成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30124,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"小集","author":"王彦泓","text":"水洁花寒院宇清，眼波帘下远逢迎。\n依微芗泽留髡饮，郑重葵羹为客烹。\n觍腆故嫌移烛影，身轻犹怯下楼声。\n筵前不尽端相意，更近残灯一看明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30125,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"小试失意自遣","author":"王彦泓","text":"国士那争月眼评，未应萧飒减欢情。\n有才轻艳真为累，作计疏狂不近名。\n酒肆不疑惭阮籍，春城无处忆韩翃。\n浮荣本自关心浅，未息尘机为夙盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30126,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归后有赠","author":"王彦泓","text":"消渴归来倦长卿，东风吹鬓远逢迎。\n低眉意绪愁难掩，落魄风标瘦可惊。\n宁藉福缘酬密爱，已甘欢分折才名。\n忍言妾面羞郎面，敢笑前人不及情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30127,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"栎园姨翁幽楼久矣忽走京都人咸以宦情疑之余独知其不然也既而为荆川先生请谥朝奏疏夕报可客复有进议者曰『此时陈乞一荫得旨如寄耳』嘐然曰『吾驰走黄尘为先公易名两字耳今幸邀主恩归报家庙安能更贪羁绁为故山猿鹤笑耶』飘然策骑归逍遥林下余窃怪向之疑者真以腐鼠意鹓雏也记之以诗得转韵四十八句","author":"王彦泓","text":"中丞骏誉馨兰芷，一代文章推正始。\n致身霄汉更夷犹，敛手经纶综百史。\n晚扫鲸鲵靖海尘，扶桑清晏豁疏襟。\n大星空伴忠魂赏，光焰何曾敌铄金。\n圣明旷世搜麟凤，蠹简残编百朋重。\n四部兼麈丙夜观，八编特赏经时总。\n李牧功名异代思，贾生筹策文孙用。\n日月昭回冥漠光，风云掩映缥缃动。\n落落名孙饶祖风，赐书千卷寄雍容。\n歌凝鸾凤歌箫碧，醉怨棠梨落藓红。\n奇文弱冠人传诵，侠窟骚坛争引重。\n潘岳家风首述诗，陆机世得先陈颂。\n千里孤装触雪行，不求身贵谒公卿。\n清评曾向清时吐，名世真儒伫易名。\n圣主从前劳寤寐，览书未半催宣赐。\n不用词林旧例沿，云章亲定襄文字。\n问俗方求乐毅孙，披文亟录端明裔。\n岂知骨性自烟霞，冥鸿早巳飘然逝。\n松桂浓芬满旧山，酒轮茶臼掩柴关。\n肯将马灯尘千斛，换却渔竿水一湾。\n幅巾东路秋莼美，惟有狂吟颂天子。\n傲骨难投世网中，才名不藉家声起。\n家庙焚黄享礼成，不嫌野服拜明纶。\n从来相业山中事，衣白何妨是散人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30128,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岁暮客怀","author":"王彦泓","text":"无父无妻百病身，孤舟风雨阻铜墩。\n残冬欲尽归犹懒，料是无人望倚门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30129,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新正闭户独坐端已屡许相寻不果余惟与曲生作缘因寄同人","author":"王彦泓","text":"一树梅花伴索居，东风时为扫庭除。\n清吟不喜安难字，适意聊因想误书。\n冲雪客来仍返棹，乘风仙过暂持裾。\n床前几度销魂饮，刚费瓜犀一石余。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30130,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"烧香曲 其一","author":"王彦泓","text":"闭户留香计绝痴，微烟未动隔帘知。\n剪灯几榻寒相守，听雨房拢暗最宜。\n卧待衣篝氲未了，坐看银叶透还迟。\n谢娘衵服经三浣，一味浓芬似旧时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30131,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"烧香曲 其二","author":"王彦泓","text":"新寒跨火小屏前，画绔文綦绝可怜。\n赏聚不烦烧鹊脑，病怀端自怕龙涎。\n鸭炉好与欢同誓，犀合仍留字纪年。\n只有香烟与侬似，一条孤细随如弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30132,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"余旧诗悉已遗忘而韬仲皆为存录展阅一过觉无端往事交集胸怀怅然久之因呈四韵","author":"王彦泓","text":"不堪重对旧诗篇，潦倒欢场二十年。\n多为微辞猜宋玉，敢持才语傲非烟。\n春风鬓影弹琴看，夜月歌声隔巷怜。\n今日掩门梅雪下，药炉声沸卧床前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30133,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"训婢","author":"王彦泓","text":"收书拂扇叠诗笺，敌得灵光赋一篇。\n浴砚定须频换水，炙香宜令慢生烟。\n未妨帘下窥侯白，只莫泥中恼郑玄。\n休厌酒阑亲涤缶，卓文君也在垆边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30134,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"独居有怀","author":"王彦泓","text":"春袍方退一重线，又是森寒酿雨天。\n酒后肌添银粟冷，意中人似玉梅妍。\n麻姑肯惜人搔背，汉主羞看婢胁肩。\n花影一瓶香一榻，不妨清绝是孤眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30135,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病疮作楚戏书自遣","author":"王彦泓","text":"汤沐无时类水淫，蹒跚坐起笑还颦。\n佳人未怪肌生粟，烈士何伤腹有鳞。\n鬻技易售龟手药，论交难得嗜痂人。\n焉知小疾非佳事，养护疏慵又一春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30136,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"不善治生又最懒于报谒客有咎余疏放者四韵答之","author":"王彦泓","text":"莫笑书淫并水淫，生涯端的似蹄涔。\n男儿岂耐车中闭，病骨唯堪砚北吟。\n老后莫应销逸气，贫来浑未灭狂心。\n凭君觅个当垆处，断送床头卖赋金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30137,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠妙音尼本白下歌姬，新披剃于阳羡山中","author":"王彦泓","text":"散朗万情回不群，翠鬟判得一緺云。\n钗钿脱奉旃檀座，纨绮裁装贝叶文。\n茗碗近添禅悦味，舞衫新换戒香熏。\n潮音梵唱声清妙，旧曲如今不耐闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30138,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"代答","author":"王彦泓","text":"净却情根净发根，笑看刀下翠纷纷。\n辞家偶尔来青嶂，喜客犹能赠白云。\n世上合离沙鸟迹，面前啼笑水风纹。\n春心久作寒灰死，艳曲何妨一再闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30139,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答平陵宋似濂","author":"王彦泓","text":"芳兰竟体总堪怜，宋玉还饶赋几篇。\n豪士未妨兼妩媚，男儿安在负须髯。\n高奇嗜酒嵇中散，佻达能歌沈下贤。\n把臂自然风味合，不关家世是同年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30140,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"示莲社学人","author":"王彦泓","text":"休恃蒲团坐几春，酒坊淫肆勘才真。\n吞针始耐调魔女，嚼饭无妨与解人。\n香瓣价同千世界，莲花轮广百由旬。\n空王彼岸庄严处，求许枯禅得问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30141,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"有女郎手写余诗数十首笔迹柔媚纸光洁滑玩而味之 其一","author":"王彦泓","text":"笔砚精良映绮疏，瘦琼人作瘦筋书。\n古钗妙迹看来似，黄绢妍词愧未如。\n疏懒未成投芍药，清新先荷赏芙蕖。\n从今吟得关心句，一望枝娘柳下居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30142,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"有女郎手写余诗数十首笔迹柔媚纸光洁滑玩而味之 其二","author":"王彦泓","text":"无聊私咏隔天涯，不道吟哦到齿牙。\n江令诗才犹剩锦，卫娘书格是簪花。\n长将睡压香浓染，怕被娘窥独半遮。\n想得笑和桃叶语，羡伊根蒂属王家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30143,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"贺生文战不利愤懑悲骚托之好内以自发摅竟得疾不起比余再过其居凄凉触目即所最欢昵者亦不复在燕子楼矣因怅然书其壁上 其一","author":"王彦泓","text":"翔龙折翼性难驯，判向柔乡顿此身。\n奇药剩堪娱一夕，同栏何止浴三人。\n当时缥帙香沾粉，此日麻筵饭杂尘。\n欲觅窈娘重问讯，凤窠飞散别枝春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30144,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"贺生文战不利愤懑悲骚托之好内以自发摅竟得疾不起比余再过其居凄凉触目即所最欢昵者亦不复在燕子楼矣因怅然书其壁上 其二","author":"王彦泓","text":"花间歌酒旧同群，烂熳风情独数君。\n寝次故持欢镜照，病馀犹出异香分。\n谁知国士终埋玉，早见神娥尽变云。\n今日席间谁认得，旧时家令沈休文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30145,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题","author":"王彦泓","text":"夜饮朝歌昼未眠，轻狂全是倚娘怜。\n妮他细语挑针线，替我排愁肄管弦。\n夜月不移欢枕畔，春山长坐酒垆前。\n何当荑玉亲磨墨，立到琉璃砚匣边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30146,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"感旧游","author":"王彦泓","text":"迷藏斗酒旧成群，夜夜潜游抵夜分。\n罚盏任冤偏后醉，奇香虽秘得先熏。\n筝娘乞句留钿带，箫史求书展练裙。\n无限断肠踪迹处，坏墙风雨绣苔纹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30147,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和叔冽韵二首 其一","author":"王彦泓","text":"掠面东风了不寒，倚楼晴望绿漫漫。\n携茶拟过莺鹭馆，被酒留看斗鸭阑。\n勾引黑甜开卷便，消磨白日戒诗难。\n明朝决计湖桥畔，春色抛人似走丸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30148,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和叔冽韵二首 其二","author":"王彦泓","text":"欲露相思未敢先，笑容含忍益嫣然。\n看调石黛添眉翠，喜插玫瑰湿鬓烟。\n障袖立时风冉冉，持裙浣处水溅溅。\n情深岂怨横陈晚，领略魂迷眼角边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30149,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再和叔冽","author":"王彦泓","text":"梅花应恨旧盟寒，路隔溪塘过雨漫。\n尘眼暂教书浣濯，闲愁全恃酒遮阑。\n新诗韵险赓宜稳，妙友神交晤转难。\n赖有啸歌生活在，不能驰骤逐金丸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30150,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重有感用叔测韵","author":"王彦泓","text":"仅喜他人不我先，此诗才读便愀然。\n素娥计险思奔月，紫玉愁深恐化烟。\n残夜枕函香泽满，隔年衣袖唾花溅。\n一生长羡金泥蝶，颤向钗边与镜边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30151,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄怀端己白门 其一","author":"王彦泓","text":"知君愁绝在都城，不向轻烟淡粉行。\n泪点寄来悲灼灼，口脂封去慰莺莺。\n道衡署句归来晚，徐淑题诗病甫轻。\n应到避风台畔坐，薄施膏粉待逢迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30152,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄怀端己白门 其二","author":"王彦泓","text":"客怀难耐日初长，马影斜阳踏几坊。\n花下玉杯尝苦笋，灯前银叶试甜香。\n愁来但祷清溪庙，醉后无忘紫佩囊。\n为觅绣鞋金缕样，倒提纤手学南唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30153,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄怀端己白门 其三","author":"王彦泓","text":"难将蜜意嘱飞鸿，寄尽相思不语中。\n枕上鹊声浑未验，桥南龟兆几回同。\n神方驻景仙家药，新嫩娇黄病后容。\n更奉办香多宝塔，半天灯影照江红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30154,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄怀唐云客读书阳羡山中 其一","author":"王彦泓","text":"鹤伴经行虎结邻，古藤幽竹翳苔纹。\n朝凭水槛十峰雪，昼锁岩扉一屋云。\n远浦上灯高阁见，下溪鸣橹半山闻。\n西崖木末孤亭上，定有书声达夜分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30155,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄怀唐云客读书阳羡山中 其二","author":"王彦泓","text":"翠崖红树压层层，精舍山腰唤即应。\n游屐暂逢挑菜女，诗筒偶附采茶僧。\n风掀小艇长歌去，雨滑危梁倚醉登。\n信步不忧归径黑，水边乞得罩鱼灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":30156,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]