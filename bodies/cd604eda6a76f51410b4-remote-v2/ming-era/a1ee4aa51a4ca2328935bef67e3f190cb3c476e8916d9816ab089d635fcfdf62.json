[{"title":"题戴文进画菊","author":"李东阳","text":"黄花开满院前坡，醉杀西江计汝和。\n忽见钱塘著色画，不知秋色较谁多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23564,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"菊","author":"沈周","text":"秋满篱根始见花，却从冷淡遇繁华。\n西风门径含香在，除却陶家到我家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23565,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"缺题","author":"戴君恩","text":"芳丛晔晔殿秋光，娇倚西风学道妆。\n一自义熙人去后，冷烟疏雨几重阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23566,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"缺题","author":"申时行","text":"冷艳疏枝擢素秋，结茅相对转清幽。\n摘来自喜簪蓬鬓，只恐黄花笑白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23567,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"缺题","author":"于若瀛","text":"黄花应不插朱门，自合移根老瓦盆。\n露委烟斜看不足，呼儿长夜倒芳尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23568,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"缺题","author":"陆氏","text":"澹云微雨暮秋天，为爱黄花带晚烟。\n闻说名园千百种，愿分秋色到篱边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23569,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏鸡冠花","author":"何栋如","text":"日下飞来孰可俦，云中养就气偏柔。\n懒施金距当雄敌，为戴霞冠慕远游。\n独立莓苔閒伴鹤，卑栖蘋藻静群鸥。\n何如化作幽人梦，啼破三湘万古愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23570,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏水仙花","author":"屠隆","text":"娟娟湘洛净如罗，幻出芳䰟俨素娥。\n夜静有人来鼓瑟，月明何处去凌波。\n萧疏冷艳冰绡薄，绰约风鬟露气多。\n直是灵根堪度世，妖容知不傍池荷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23571,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"水仙 其一","author":"陈淳","text":"玉面婵娟小，檀心馥郁多。\n盈盈仙骨在，端欲去凌波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23572,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"水仙 其二","author":"陈淳","text":"荒圃淑气回，寒柯发光泽。\n下有白玉花，玲珑映深碧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23573,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题水仙","author":"李东阳","text":"澹墨轻和玉露香，水中仙子素衣裳。\n风鬟雾鬓无缠束，不是人间富贵妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23574,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"水仙二首 其一","author":"杜大中","text":"玉貌盈盈翠带轻，凌波微?不生尘。\n风流谁是陈思客，想像当年洛水人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23575,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"水仙二首 其二","author":"杜大中","text":"灵雨濛濛幻态轻，惊魂想像逝怀倾。\n愿将玉佩遥相逐，脱骨逍遥水上人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23576,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"水仙花","author":"张新","text":"玉质金相翠带围，霜华月色共辉辉。\n江妃方欲凌波去，汉女初从解佩归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23577,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"水仙花","author":"孙齐之","text":"碧江香和楚云飞，销尽冰心粉色微。\n乍向月中看素影，却疑波上步灵妃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23578,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"樱桃","author":"高启","text":"密绿映圆红，枝头的的同。\n熟迎梅实雨，落值柳花风。\n美女名偏称，流莺啄未空。\n忆曾春荐后，捧赐出深宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23579,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"樱桃","author":"黄正色","text":"塞外含桃五月红，一尊相对晚来风。\n高情不在羲皇下，清梦常牵江水东。\n荐庙久虚支子位，承恩敢望大明宫。\n诘朝又值蒲觞会，须信人间似转蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23580,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"樱桃","author":"王士骐","text":"小鸟枝头啄欲残，美人珍惜捲帘看。\n霞烘的的珊瑚碎，露洗垂垂琥珀寒。\n素面相逢浑似醉，朱唇半吐欲成丹。\n若教纤手和烟折，也胜官家赤玉盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23581,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"樱桃","author":"陈继儒","text":"药栏春尽少花开，叶底朱樱若个猜。\n熟后雨弹红玉破，生前烟捧绿珠来。\n唇脂清浅疑无骨，风味温柔别有胎。\n鹦鹉莫教轻啄碎，掷他年少满车回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23582,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赐杨梅","author":"李东阳","text":"官河催载满船冰，五月杨梅入帝京。\n沁齿不知红露湿，到诗偏助玉堂清。\n名从傅鼎遥分派，价比隋珠亦称情。\n再拜文华门外地，讲筵恩重若为荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23583,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨梅","author":"吴宽","text":"五月果初熟，枝头鹤顶丹。\n欲知甘冷好，千颗荐冰盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23584,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赐枇杷","author":"李东阳","text":"尚方珍果赐新尝，分得江南百颗黄。\n远道不妨经月暑，冷枝疑带隔年霜。\n龙笺帖罢名初散，翠笼开时手亦香。\n归领君恩荐家庙，不禁清泪满衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23585,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"纪赐枇杷","author":"吴宽","text":"吴船入贡溯江涛，分赐儒臣幸此遭。\n卧病谩思新橘柚，退朝休赋旧樱桃。\n珍奇未惜初加惠，浅薄无能莫效劳。\n箬笼晓来倾泻处，金丸错落骇儿曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23586,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东丘兰若见枇杷","author":"高启","text":"落叶空林忽有香，疏花吹雪过东墙。\n居僧记取南风后，留个金丸待我尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23587,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"枇杷","author":"沈周","text":"谁铸黄金三百丸，弹胎微湿露漙漙。\n从今抵鹊何消玉，更有饧浆沁齿寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23588,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"频婆果","author":"曾棨","text":"异果曾因释老知，喜看嘉实出京师。\n芳腴绝胜仙林杏，甘脆全过大谷梨。\n炎帝遗书惭未录，长卿多病独相宜。\n由来南土无人识，那得灵根此处移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23589,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢送橄㰖","author":"马德澄","text":"美人抱瑟自姑苏，佳果盈笼赠客需。\n味淡冰桃清较胜，色侔玉枣脆偏逾。\n入唇香嫩含鸡舌，启齿甘回吐凤酥。\n更为高歌声沸耳，相从啜茗启醍醐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23590,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"葡萄次韵二首 其一","author":"李东阳","text":"采采西林白露团，一时清赏故人欢。\n萧条四十年前事，又向谁家卷里看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23591,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"葡萄次韵二首 其二","author":"李东阳","text":"西土葡萄别样团，谪居聊此写清欢。\n荔支香水谁高下，且与诗人一例看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23592,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"葡萄","author":"沈周","text":"秋棚昨夜黑风呼，鬼泪滢滢泣不枯。\n明日担夫晓街上，一筐新味赏明珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23593,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"若虚夜馈送瓶枣","author":"李东阳","text":"异代神仙事不赊，如瓶丹枣胜如瓜。\n多情馈客诗兼远，急脚携筐步半斜。\n内苑不劳方朔射，西邻还有少陵家。\n白头正有分甘兴，先向高堂一荐茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23594,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏枣","author":"王象晋","text":"蓐收司契物华新，累累丹苞日可亲。\n汉帝殿前曾郑重，吕仙亭下诧奇珍。\n味逾石蜜甜偏永，红迈朱樱色莫伦。\n怪道仲思名姓著，好同玉李供枫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23595,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢送木瓜","author":"丘浚","text":"经霜著雨玉枝疏，除却宣城总不如。\n久入神农为药品，曾从孔子见苞苴。\n味涵玉液酸仍涩，囊蹙金砂实不虚。\n深感故人相赠与，此情何以报琼琚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23596,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题石榴","author":"王谷祥","text":"榴房拆锦囊，珊瑚何齿齿。\n试展画图看，凭将颂多子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23597,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石榴二首 其一","author":"陈淳","text":"未摘霜前实，先看雨后花。\n名应出西海，颜岂论东家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23598,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石榴二首 其二","author":"陈淳","text":"蜡蒂团赪玉，文英簇绛绡。\n秋来结佳果，珍味不须调。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23599,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石榴","author":"沈周","text":"张骞带得西来种，中秘千珍及万珍。\n一个臭囊藏不尽，又从身外覆精神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23600,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢屠公送新榛","author":"吴宽","text":"七月辽阳已降霜，簪头落地野榛香。\n三年不到燕山下，又喜频将玉颗尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23601,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黄泽辞","author":"李攀龙","text":"皇之麋，其马八骊，皇人委蛇。\n皇之水，其马騄耳，皇人受祉。\n皇之曲洛，其马沃若，皇人薄薄。\n皇人孽孽，其马喷雪，我心如结。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23602,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白云谣","author":"李攀龙","text":"白云在天，山陵逶迤。\n率彼东土，诸夏间之。\n将子能来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23603,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"瑶池谣","author":"李攀龙","text":"白云在山，亦洽而野。\n予归三年，将顾见女。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23604,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南山歌","author":"李攀龙","text":"南山白石白离离，尔牛之角何其悲。\n车下短衣歌者谁，国有叔牙当见知。\n佐命伯王独后来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23605,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"越人歌","author":"李攀龙","text":"山有隈兮江有汜，歌拥枻兮见王子。\n揄修袂兮披长云，举绣被兮风纷纷。\n蒙诟耻兮心靡它，君不知兮可奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23606,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"采葛妇歌","author":"李攀龙","text":"卧下之薪何绸缪，欲寐不寐思寇雠，我今采葛以遨游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23607,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"易水歌","author":"李攀龙","text":"缭天兮白虹，萧萧兮北风。\n壮士怒兮易水飞，羽声激兮云不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23608,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"垓下歌","author":"李攀龙","text":"从美人，拥骏马，涕从横兮垓之下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23609,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"大风歌","author":"李攀龙","text":"大风沸兮云薄天，驱万乘兮纷来旋。\n纷来旋兮沛之宫，士桓桓兮福攸同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23610,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋风辞","author":"李攀龙","text":"秋风萧萧兮白云晶晶，草木黄落兮鸿雁于征。\n兰可佩兮菊可餐，遗佳人兮汾之干。\n挟飞龙弓下中流，横大波兮放远游。\n灵偃蹇兮翳日来，憺容与兮纷裴徊。\n顾帝京兮何壮哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23611,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天马歌","author":"李攀龙","text":"天马下阊阖开，汗以血騑离哉。\n河之精龙之子，视浮云无万里。\n绝流景蹑遗风，今安驾幸回中。\n天马徕从西极，经千里归有德。\n天马徕竦予身，挟飞电化若神。\n天马徕循东道，承灵威服帝皂。\n天马徕岁执徐，陕四海将安如。\n天马徕出峤山，逝昆仑排玉关。\n天马徕龙为友，北击胡驱群丑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23612,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李夫人歌","author":"李攀龙","text":"去邪来邪，就而视之，纷何被被其徘徊。\n寤邪梦邪，就而视之，包红颜其弗明。\n步傩傩者谁邪，就而视之，风何萧萧其蔽帷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23613,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陇上歌","author":"李攀龙","text":"陇上壮士乘䯀骢，带桑鞬服挟秦弓。\n七尺大刀搏白虹，丈八蛇矛盘怒风。\n战始三交失大刀，且荡且走亡其曹。\n弃我䯀骢岩中逃，为我谓乌为客豪。\n陇上之水流潺潺，壮士一去不复还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23614,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蹛林歌","author":"李攀龙","text":"单于庭，阴山下，汉家和亲刑白马。\n刑白马，祭龙城，今年蹛林大会兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23615,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其一 朱鹭","author":"李攀龙","text":"朱鹭猎其缨，茄下行。\n鱼在梁，纵复横。\n鹈何飞，濡其羽，上书谏其主。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23616,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其二 思悲翁","author":"李攀龙","text":"思悲翁，凤凰安宿阿阁中。\n夺我美人，思悲翁。\n凤凰飞上天，枭子拉沓随转蓬。\n狗逐狡兔走，取尔枭子食枭母。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23617,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其三 艾如张","author":"李攀龙","text":"艾而张罗罗若云，中有黄雀呼其群。\n毛羽摧颓离哉纷。\n山出黄雀山嵯峨。\n鸿鹄绝四海，君亦难为罗。\n我欲从之谗言多，鸿鹄徘徊奈雀何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23618,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其四 上之回","author":"李攀龙","text":"上之回，萧关开。\n以待边，单于台。\n勒兵十八万，羽林材。\n振大旅，鬗长驰。\n詟匈奴，臣月支。\n朝诸侯王甘泉宫，郡国受计福来同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23619,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其五 翁离","author":"李攀龙","text":"拥离趾中，可筑宫。\n兰用葺之，艾尔蓬。\n拥离趾中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23620,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其六 战城南","author":"李攀龙","text":"战城南，走城北，转斗不利号路侧。\n谓我枭骑，且行出攻。\n宁为野乌食，不逐驽马徘徊蒲苇中。\n水深黝黝，蒲苇骜骜。\n乌亦自不去，客亦自不豪。\n梁以集，乌子五，乌母六。\n禾黍不食攫腐肉，愿为忠臣何可覆。\n伤子良臣，良臣诚可伤。\n远道之人，枯骨何葬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23621,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其七 巫山高","author":"李攀龙","text":"巫山高，自言高。\n江水深，自言深。\n勿复相思，君有他心。\n山以蔚蔚，水以汤汤。\n何用度之，石用梁。\n徘徊远望，泣下沾裳。\n愿托黄鹄，东归故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23622,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其八 上陵","author":"李攀龙","text":"上陵亦诚美，下津以尚羊。\n问客从何来，自言水中央。\n芰荷为君衣，芙蓉为君裳。\n木兰为君佩，江蓠间杜蘅。\n铜池之芝以九茎，光华烛天披金英。\n凤凰之集，乍开乍合，蜚览上林，曾不知日月明。\n赤翅之鸿，翁杂相随。\n白雁何蔚蔚，云为车，风为马。\n游阊阖，守谒者。\n五色露，何泥泥。\n乃在仙人金掌中，凝如膏，美如饴。\n愿奉我主饮，延年万岁期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23623,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其九 将进酒","author":"李攀龙","text":"将进酒，称我觞。\n纷佳哉，以浩倡。\n心所作，未尝闻，徘徊三叹一为君。\n君之臣明四时和，国有良工悉索歌。\n观者不苦奈子何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23624,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其十 君马黄","author":"李攀龙","text":"君马黄，臣马骊，二马异体同权奇。\n徘徊四海美人子，二马相得以千里。\n故东非我东，西非我西，南非我南，北非我北。\n驾如六飞龙之翼，路訾邪，谓何览。\n遨游安终极，二马视驽马。\n局促食辕下，将以问驭者。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23625,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其十一 芳树","author":"李攀龙","text":"芳树如此之蔚蔚，上有黄鹄以翱翔，下饮兰池鸣锵锵。\n二而为侣，三而为行。\n芳树拉杂黄鹄伤，秋风萧萧思其乡。\n妒人之子妒杀我，君有它心无不可。\n黄鹄高飞亦有罗，目欲顾之奈乐何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23626,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其十二 有所思","author":"李攀龙","text":"有所思，乃在燕山隅。\n何用问遗君，大秦明月珠。\n结以连理带，荐以合欢襦。\n又何问遗君，青丝系玉环。\n可直千万馀，翠羽绍缭之黄金错其间。\n闻君有它心，拉杂其珠摧其环。\n摧其环，临高台。\n反袂以障之，当风扬其灰。\n从今以往，勿复相思。\n若复相思，有如此珠，有如此环。\n非我可为，鸡鸣狗吠。\n我视兄嫂，不言谓何。\n东方须臾高奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23627,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其十三 雉子","author":"李攀龙","text":"雉子斑如此之趋跄跄，雄来蜚从雌拉沓曳水集于梁。\n目以顾之，蔚蔚冥冥，艾而张罗，雉子知得奈我何。\n王孙有罗以雉子，黄鹄之罗当千里。\n驾以南，驾以北。\n朝行出遨游，暮从美人食。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23628,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其十四 圣人出","author":"李攀龙","text":"圣人出，应熛怒，赫炎精。\n文教洽，武功成。\n寒暑德，河海清。\n驾六龙，何騑离。\n圣人哉，圣人御天以调之。\n日月星辰和四时，郡国吏功上所治。\n君之臣明远如期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23629,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其十五 上邪","author":"李攀龙","text":"上邪。\n我欲与君同心，乐以不可禁。\n相思绍缭，谗言罔极，大驾六龙处天侧。\n日月出入沧海中，妒人之子难为工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23630,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其十六 临高台","author":"李攀龙","text":"临高台，望江水，江水之流以千里。\n黄鹄知得高蜚止，愿遗香草美人子。\n关弓问鹄从何来，我主万年亦诚哉。\n禾黍不获鹄何食，遨游四海安终极。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23631,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"铙歌 其十七 远如期","author":"李攀龙","text":"远如期，宜四海。\n皇帝日月所置，有甘露三载。\n单于自归大佳以万人，稽首陛下北藩臣。\n左右贤王奉国珍，谒者令引之乡殿陈。\n橐佗拉沓，就羽蒙戎。\n酪酒乃是阏氏之所饮，駃騠生自余吾中。\n将进酒，顾其豪，挠以留犁径路刀。\n何用赐之，黄金犀毗，赤绨锦袍。\n扶伏沮泽，曾不知天子神灵。\n从今以往，但居光禄塞下不愿归庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":23632,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]