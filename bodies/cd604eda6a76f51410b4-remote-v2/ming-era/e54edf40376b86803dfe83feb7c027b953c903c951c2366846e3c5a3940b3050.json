":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慧山书院十五咏 其六 海天亭","author":"邵宝","text":"兀坐山亭下，悠然海上天。\n归墟无尽藏，须记始流年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慧山书院十五咏 其七 超然堂","author":"邵宝","text":"梦中得嘉名，卅载乃斯宇。\n珍重病馀身，优游荷天予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慧山书院十五咏 其八 吟松个","author":"邵宝","text":"风来松有声，洒洒当左个。\n我吟本无心，松亦何心和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慧山书院十五咏 其九 咏竹个","author":"邵宝","text":"新栽竹数竿，竿竿挺苍玉。\n我歌竹和之，步转阑干曲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慧山书院十五咏 其十 泉斋","author":"邵宝","text":"出山如在山，名斋敢忘本。\n鉴里看青天，不为泥沙混。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慧山书院十五咏 其十一 点易台","author":"邵宝","text":"有象本通玄，义不在句读。\n道人坐高台，忘言对苍岫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慧山书院十五咏 其十二 滴露泉","author":"邵宝","text":"滴滴出石间，初疑松上露。\n点易日有程，还应周天度。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慧山书院十五咏 其十三 两知亭","author":"邵宝","text":"天涯一归客，海内两知音。\n万古泉声在，应知此老心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慧山书院十五咏 其十四 瘗卷邱","author":"邵宝","text":"吾道方施行，怀之不胜卷。\n故物穴名山，虹光起遐眷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慧山书院十五咏 其十五 望阙岩","author":"邵宝","text":"东南海一隅，天阙勤望眼。\n登拜想氤氲，殿上香炉篆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕勋侄送红酒","author":"邵宝","text":"红酒桃花色，东风吹更鲜。\n将情来旧宅，送喜入新年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣暑四事 其一","author":"邵宝","text":"清泉白石子，置之古铜簋。\n泉出此山中，石来汉江水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣暑四事 其二","author":"邵宝","text":"两峰泻寒泉，石庵得意笔。\n悬之堂西偏，白日风萧瑟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣暑四事 其三","author":"邵宝","text":"净扫席间地，周旋仅函丈。\n矮几置中央，坐爱垆烟上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣暑四事 其四","author":"邵宝","text":"楛槎种菖蒲，盆水半欲没。\n露珠上叶稍，爱尔仙灵物。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨坐","author":"邵宝","text":"初春烟雨似梅天，墙角梅花尚索然。\n病客有情常梦野，閒人无事漫占年。\n永萦浅碧连城外，草送轻青到槛前。\n闻道忧民新令尹，几回骑马劝耕田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忽忆江西湖南时风景用前韵","author":"邵宝","text":"漫道吴天似楚天，四时风雨一萧然。\n滕王阁下维舟地，黄鹤楼中听笛年。\n春色渐回梅放后，秋声应尽雁归前。\n东山屐在堪乘兴，閒送清泉下石田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中寄浦文玉用前韵","author":"邵宝","text":"风雨无端莫问天，新编读罢自欣然。\n寸心敢谓能千古，一话真应胜十年。\n江郭鸠声春笠外，山窗梅影暮灯前。\n明朝独上鹅湖棹，回首蘼芜满野田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日无绪泉亭书院俱缺一至次浦文玉山行用杜韵","author":"邵宝","text":"仲春风日尚微寒，两月多愁懒戴冠。\n雨后花催连夜赏，雪中山忆隔年看。\n云开平野还盘谷，石转清流更激湍。\n物色有馀情绪少，几时慈壸报平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春水寿王郡侯","author":"邵宝","text":"怀李楼前春水深，郡公多暇重登临。\n长江对我一杯酒，白日在天千古心。\n笔无留翰汉老吏，诗有馀才唐正音。\n年来初度未须祝，手植甘棠新作阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送顾行人与新","author":"邵宝","text":"奉使真随八月槎，南风五月又辞家。\n松花露溢离亭酒，石子泉将客路茶。\n北极朝廷瞻象魏，中原藩省赋皇华。\n明年再揽澄清辔，独听民谣到海涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"久雨","author":"邵宝","text":"熟尽黄梅雨不休，出门何处觅沧洲。\n势倾底柱河全泻，气塞归墟海逆流。\n圃史空传葵有日，田家长叹麦无秋。\n渺然舟楫吾安往，古华山前一倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜","author":"邵宝","text":"月流云窦影庭柯，今夜风于昨夜多。\n我病未堪空酒在，秋声如此奈愁何。\n人言每信天无漏，世事真看地有波。\n三叹朱弦谁听者，几回击节杜陵歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野色","author":"邵宝","text":"黄泥桥西溪岸斜，东风吹水拥溪沙。\n杜陵药饵长随我，韩子诗书正满家。\n何处不看悬磬室，有人还着替舟槎。\n涣然亭外当时路，只隔南涯与北涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜宿惠山精舍","author":"邵宝","text":"惠山草堂秋夜清，道人夜坐听泉声。\n中庭不见古松影，西岭却遮新月明。\n一里松庵期信宿，十年鹿洞梦孤征。\n明朝藜杖须将去，从我閒行三两生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得如山和章再用前韵","author":"邵宝","text":"落日空山钟磬清，隔溪时听棹歌声。\n小桥再渡觉身健，高阁一登增眼明。\n望极江湖云北去，梦回岁月雁南征。\n黄花亦是秋风客，尽办寒香对老生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日过国臣弟南庄","author":"邵宝","text":"凤皇墩下扣柴关，篱落黄花手自攀。\n适野亦堪酬令节，避高应不到名山。\n情多更欲临流坐，兴尽真?载月还。\n最喜晚来风色定，小桥回首碧湾湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄顾台州华玉","author":"邵宝","text":"秋晚怀人思欲荒，东南江水隔钱塘。\n山高故近台三象，郡僻真悬海一方。\n他日曾看周砥柱，何时能剪召甘棠。\n观风定有新诗句，愿托王生为寄将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新春","author":"邵宝","text":"庭草犹枯渐有情，檐声如雨雪初晴。\n缘江积冻朝寻径，匝市浮烟午出城。\n风信巳非前九烈，月华应为上元明。\n梅花两树香如许，误道诗人在冉泾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得章司成枫山先生书","author":"邵宝","text":"司成书自道卿传，千里枫山越四年。\n风雨梦从初起处，江湖心在未归前。\n数盘谷可容君筑，万里门曾泊我船。\n闻说临风多感慨，乾坤回首一茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊寅八月以容春集托乔司马寄王中丞虎谷越岁司马以集还因得中丞之讣","author":"邵宝","text":"隔岁书回不拆封，惊闻虎谷失髯翁。\n风骚辽阔遗音在，江汉萧条老眼空。\n壮志欲从汾左右，清声曾动陜西东。\n七年又洒柴墟泪，屈指交游俯仰中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"守溪公惠洞庭新茶侑以长句奉谢","author":"邵宝","text":"洞庭春茗过湖来，阁老新诗手自裁。\n锡谷泉应将撱石，玉川风欲问蓬莱。\n竹垆纵有僧堪借，梧几曾无客与陪。\n何日山中寻旧约，莫釐高处一登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼沈提学休翁","author":"邵宝","text":"江东回首复湖南，到处春风许我参。\n万里无槎心独往，千钧有笔力能堪。\n凤皇台远空魂梦，黄鹤楼高绝笑谈。\n最忆牵衣相别地，碧瞳如水鬓䰐鬖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松坛午坐与送茶诸僧","author":"邵宝","text":"竹里风来生昼凉，况逢时节近端阳。\n也知城外尘能少，却道山中日更长。\n云壑飞泉频倚杖，松坛磐石漫焚香。\n老僧供茗浑忘味，好向嵩峰问溥光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答姜士元用舒国裳韵","author":"邵宝","text":"归舟不见急流难，曾向严滩濯我冠。\n何处世情非滟滪，几时尘梦不漪澜。\n山中松子秋还落，海上桃根晚更蟠。\n遥想栖贤云雾里，定依北斗望长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用杜韵寄李剑州","author":"邵宝","text":"病馀岑寂向林邱，消息欣传李剑州。\n蜀道巳通今四海，禹疆还识古诸侯。\n孤城力起千家市，短劄情随万里舟。\n我亦旧游忘未得，梦魂长绕紫薇楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答陈宪使文鸣过访不遇","author":"邵宝","text":"黄梅雨过绿秧齐，日向山庄路不迷。\n万里仙槎还海上，十年清梦几湖西。\n太行碑刻看新打，岳麓书签忆旧题。\n谢客也知非此客，却教泉酿负蒸藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"文鸣报书久不至","author":"邵宝","text":"江船连夜发蓉湖，三宿封书报尚无。\n夏榻梦魂便客少，晚舆游兴对僧孤。\n惊风骤雨常怀楚，丽水佳山又过吴。\n欲向诗囊问奇句，瓜州回首渺烟芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和乔司马三首 其一 梅花水","author":"邵宝","text":"梅花不见见清痕，何处还堪索笑言。\n云影逗风俱澹荡，波声流月自潺湲。\n湖山韵绝弦长断，洛浦香销佩独存。\n春到江南无限树，不须临水赋招魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和乔司马三首 其二 观音山","author":"邵宝","text":"观音阁下江水深，阁上丹崖知几寻。\n安能羽翼一飞上，独凭阑干时放吟。\n鸟去却留云栈影，潮来还起石钟音。\n十年老眼今如梦，遥为岩翁重此临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和乔司马三首 其三 鸡鸣山","author":"邵宝","text":"钟山西引一峰高，云磴盘纡步不劳。\n画里楼台复钟鼓，望中城市有林皋。\n江流入海初奔放，世路怀人更郁陶。\n却倚崔嵬发长啸，松风何处起秋涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏吏部于中以谏除名访予里第予避暑山中闻而赋此","author":"邵宝","text":"南归吏部一方巾，冉水东头访病人。\n万里孤槎浮海梦，片言九死报君身。\n风从远道来应好，暑向深山避却真。\n从此著书应满室，草堂深闭楚江春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舒翰林国裳过锡病不能来其人来言之","author":"邵宝","text":"病客舟中不著巾，山中而我亦怀人。\n平生温饱元非志，万死艰危尚有身。\n风力南溟看独近，潮声东海听初真。\n也知梦转沧江晚，正想胪传玉殿春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万汝信与国裳同舟用韵再寄","author":"邵宝","text":"一封书上几沾巾，道路争传国有人。\n云雾政勤瞻斗念，风波还重渡江身。\n吴门晚树舟边近，楚泽秋兰佩后真。\n却忆匡庐弦诵地，五峰回首不胜春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚凉","author":"邵宝","text":"晚凉幽兴为谁多，闻道灵旗巳渡河。\n露咽微吟还蟋蟀，雨添新韵到蕖荷。\n窗前梦醒风初定，枕上诗成月己过。\n从此炎蒸应尽退，不须频问夜如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄莫如山","author":"邵宝","text":"五更梦醒忆南沙，只尺天分路两涯。\n诗草往来凭稚子，春光深浅问梅花。\n节临雨水初飞雪，路阻山泉未试茶。\n画里西湖皆幻景，似闻高兴在东家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得如山和章兼荷踏雪见过用前韵","author":"邵宝","text":"雪后相过屐印沙，美人望不在天涯。\n九峰西照双溪水，万树东风一夜花。\n天台客去方燖橘，阳羡书来未寄茶。\n留得山翁曾共醉，数杯今雨对诗家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张汝立","author":"邵宝","text":"别来风雨梦初醒，两对山中春草庭。\n江汉无情衰可墨，春秋有法简能青。\n笔将点易劳君送，琴欲赓歌起我听。\n闻道儒台虚席在，何时尊酒海天亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送施克和之平乐","author":"邵宝","text":"行尽潇湘问吏邮，青山回处古昭州。\n自知宦寓应如水，谁道刑官便是秋。\n身在江湖频望阙，道经岳鄂两登楼。\n三年宪召君当起，莫指苍梧赋远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱昌言赴顺宁经府","author":"邵宝","text":"万里滇南郡幕行，先从水道问邮程。\n乾坤何往非臣所，朝夕难违是子情。\n晚日每看山外影，寒江犹听雾中声。\n独怜泰伯祠前别，数点梅花照眼明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜冬官钱士弘访予惠山草堂","author":"邵宝","text":"公来犹记十年前，我在山中正浚泉。\n陆羽水经应入妙，卢仝茶力漫通仙。\n閒边梦亦寻常见，病后诗曾一再传。\n他日风雩还有约，沧浪歌罢采金莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杭方伯世卿登我龙山不克奉陪","author":"邵宝","text":"百里荆溪十载违，相逢谁道旧情非。\n病如梦里予初寤，画在诗中子亦归。\n两地青山歌响应，一星南极望依微。\n凭君再订登高约，听罢沧浪共振衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]