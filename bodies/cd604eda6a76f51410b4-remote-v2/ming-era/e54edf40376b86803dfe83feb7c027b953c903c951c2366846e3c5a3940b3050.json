[{"title":"蒙斋 其一","author":"邵宝","text":"涓涓山下水，日夜游从东。\n策杖临流者，曾闻说圣功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蒙斋 其二","author":"邵宝","text":"有美道乡孙，学道如学海。\n海水即吾泉，山下真源在。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冉泾书院十二咏 其一 曾侍亭","author":"邵宝","text":"归养荷天恩，孔训闻自少。\n不敏请事斯，如闻提耳诏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冉泾书院十二咏 其二 容春阁","author":"邵宝","text":"一堂容万卷，长忆鹤翁诗。\n高阁日增崇，老至不自知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冉泾书院十二咏 其三 燕居亭","author":"邵宝","text":"客退解冠裳，坐我北轩下。\n我铭揭西楹，时时一瞻顾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冉泾书院十二咏 其四 存一斋","author":"邵宝","text":"先民递传恭，惟一益亲切。\n斋居诵新铭，敬对不敢亵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冉泾书院十二咏 其五 嘉树亭","author":"邵宝","text":"吾庭有嘉树，种自容春翁。\n百年益封殖，人歌召南风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冉泾书院十二咏 其六 八角台","author":"邵宝","text":"斋前垒石台，台有八卦象。\n山中点易时，如坐兹台上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冉泾书院十二咏 其七 兰畹在","author":"邵宝","text":"滋兰自骚人，香草以比德。\n九畹如井田，惟馨亦充塞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冉泾书院十二咏 其八 思濂沼","author":"邵宝","text":"莲有君子德，爱多知者鲜。\n净植起香风，污泥任浅深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冉泾书院十二咏 其九 光霁桥","author":"邵宝","text":"观莲忆濂翁，因得风月趣。\n忽然光霁生，乃在过桥处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冉泾书院十二咏 其十 静深径","author":"邵宝","text":"新竹依旧径，竹长径益深。\n青春白昼永，爱尔君子心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冉泾书院十二咏 其十一 圭冕二石","author":"邵宝","text":"石出东野山，其形各有似。\n如冕复如圭，堂名称曾侍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06