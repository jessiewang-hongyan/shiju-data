[{"title":"荔枝词三十首寄张子白杨鬯侯 其十五","author":"成鹫","text":"兴在林泉不在山，道情物态两相关。\n旁人莫问垂垂子，树老枝高未易攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50298,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝词三十首寄张子白杨鬯侯 其十六","author":"成鹫","text":"只争生熟不争先，宁羡西园出水莲。\n越宿犹堪充净供，此心曾已许金仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50299,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝词三十首寄张子白杨鬯侯 其十七","author":"成鹫","text":"送客无端过板桥，彤云低亚最高条。\n入林更有明朝约，一饱何须不折腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50300,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝词三十首寄张子白杨鬯侯 其十八","author":"成鹫","text":"远不深山近不郊，独存贞实宿林坳。\n风中硕果云中鹤，露顶丹砂共一巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝词三十首寄张子白杨鬯侯 其十九","author":"成鹫","text":"此身只合老江皋，旁挺偏宜寄托牢。\n绿暗红稀君莫惜，鹅潭烟雨足风涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝词三十首寄张子白杨鬯侯 其二十","author":"成鹫","text":"闻香见色便辞柯，体露金风奈若何。\n何似色香无觅处，烟霞堆里独婆娑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝词三十首寄张子白杨鬯侯 其二十一","author":"成鹫","text":"夏云如火煮仙砂，白雪黄芽罩绛纱。\n僧老空林非所羡，碧天长日送流霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝词三十首寄张子白杨鬯侯 其二十二","author":"成鹫","text":"删枝落叶塈倾筐，犀角无尘玉有香。\n一味酸甜尝已遍，馀甘留待赤松尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝词三十首寄张子白杨鬯侯 其二十三","author":"成鹫","text":"葛洪仙令在朱明，采药餐霞道已成。\n东海日高丹火熟，赤虬朱凤尽登瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝词三十首寄张子白杨鬯侯 其二十四","author":"成鹫","text":"绛帷高坐客谈经，藜火光分拟易亭。\n三百颗来供一饱，主宾双眼为谁青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝词三十首寄张子白杨鬯侯 其二十五","author":"成鹫","text":"何须赤脚踏层冰，细嚼徐吞得未曾。\n枝叶消归无用处，不妨还核与山僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝词三十首寄张子白杨鬯侯 其二十六","author":"成鹫","text":"古洞归猿在上头，攀枝摘果引群猴。\n书堂寂寞谁家子，曾记开元旧事否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝词三十首寄张子白杨鬯侯 其二十七","author":"成鹫","text":"松皋多种蜜来檎，掩映桃花共一林。\n即此阜财还解愠，不须重理五弦琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝词三十首寄张子白杨鬯侯 其二十八","author":"成鹫","text":"赤瑛擎出白鹅潭，持赠殷勤为盍簪。\n大果未收先小果，不妨猿鹤许分甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝词三十首寄张子白杨鬯侯 其二十九","author":"成鹫","text":"当人大嚼不伤廉，来自袛园定免嫌。\n饱食若教愁内熟，盘中还有水晶盐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荔枝词三十首寄张子白杨鬯侯 其三十","author":"成鹫","text":"家珍不别圣和凡，千里封题寄丈函。\n却恐外人知此味，叮咛牢记口三缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李静庵广文还仁化学署兼怀前广文郭元修暨旧游诸子 其一","author":"成鹫","text":"浮图杰阁锦江头，曾记鹓行狎野鸥。\n前有林宗后元礼，送君还拟嗣同舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李静庵广文还仁化学署兼怀前广文郭元修暨旧游诸子 其二","author":"成鹫","text":"夜来有梦到仁阳，旧社重开逸兴长。\n君见宗雷凭寄语，相思人在水云乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题醉翁","author":"成鹫","text":"不问贤人与圣人，青州从事镇相亲。\n杖头剩有馀钱在，买得春山葬伯伦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送圆音禅友主席丹霞 其一","author":"成鹫","text":"海云山色海幢潮，到处门庭未寂寥。\n猿鹤无心恋城市，不妨龙象远相招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送圆音禅友主席丹霞 其二","author":"成鹫","text":"怡山受请独归迟，祖席无人强自持。\n法社垂秋非所惜，风生庭树倍兴悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送圆音禅友主席丹霞 其三","author":"成鹫","text":"难忘封树在丹霞，吹火因风赖作家。\n犹胜三年庐墓赐，手栽灵楷不生花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送圆音禅友主席丹霞 其四","author":"成鹫","text":"没藏身处却藏身，不为人时正为人。\n我欲似君难得似，肯因离合别疏亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送圆音禅友主席丹霞 其五","author":"成鹫","text":"别路山川首重回，双池到日藕花开。\n当初不枉曾相许，亲见丹霞掩耳来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送圆音禅友主席丹霞 其六","author":"成鹫","text":"凭君寄语海山樵，咫尺丹梯路未遥。\n独立孤峰人已老，秋风迟我过虹桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送圆音禅友主席丹霞 其七","author":"成鹫","text":"凭君寄语锦江渔，曾见华亭识得渠。\n歌罢沧浪相忆否，水清难免是无鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送圆音禅友主席丹霞 其八","author":"成鹫","text":"凭君寄语谷阳休，临别吟诗记得否。\n从此居亭应有主，不愁无地牧顽牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送圆音禅友主席丹霞 其九","author":"成鹫","text":"凭君寄语锦岩僧，磴道尘封尚拟登。\n高枕卧游人不信，梦魂长绕石房灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送圆音禅友主席丹霞 其十","author":"成鹫","text":"凭君寄语马专城，久别还应记得名。\n一自寒梅虚信施，至今鼠腹尚彭亨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送圆音禅友主席丹霞 其十一","author":"成鹫","text":"凭君寄语到仁阳，千里何曾异一堂。\n两地青山同白发，昨来如染再来霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送圆音禅友主席丹霞 其十二","author":"成鹫","text":"凭君寄语旧同参，密约难忘楚讱庵。\n曾否入山烦指点，意中人在白鹅潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊汾水闻琵琶社题 其一","author":"成鹫","text":"野渡停桡月满船，江声渔榜杂鼗弦。\n玉环去后无消息，古调还须叚老禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊汾水闻琵琶社题 其二","author":"成鹫","text":"万古乌孙一片云，云头传语到横汾。\n微情欲诉风吹去，散入江波处处闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50330,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泊汾水闻琵琶社题 其三","author":"成鹫","text":"不知弹者为谁弹，一曲嘈嘈十指寒。\n唤起同舟听胡语，前程多恐是桑乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50331,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题陈颐堂影一韵三绝 其一","author":"成鹫","text":"手持白拂出风尘，默坐松阴转法轮。\n渠坐道场君在市，相看何事不如人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50332,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题陈颐堂影一韵三绝 其二","author":"成鹫","text":"三千世界眼前尘，百八菩提手上轮。\n去伴文殊采灵药，世间那得有閒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50333,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题陈颐堂影一韵三绝 其三","author":"成鹫","text":"西樵山色隔红尘，东海朝朝见日轮。\n踏上大科峰顶望，高山还有更高人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50334,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽黔阳吴芥舟明府 其一","author":"成鹫","text":"黔阳消息近何如，曾否闻歌忆接舆。\n一曲阳春难和郢，定携诗卷问三闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50335,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽黔阳吴芥舟明府 其二","author":"成鹫","text":"一芥轻舟去似梭，洞庭咫尺足风波。\n祗应系缆坳堂上，大地平沉柰若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50336,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽黔阳吴芥舟明府 其三","author":"成鹫","text":"岭树多风陟屺频，梦魂长绕倚闾人。\n臣心自恨丹霄远，失意愁惊白发亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50337,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽黔阳吴芥舟明府 其四","author":"成鹫","text":"薏珠不免局中疑，棠树长留去后思。\n公论在人君信否，请看三楚有丰碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50338,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽黔阳吴芥舟明府 其五","author":"成鹫","text":"已闻天语下恩纶，何事时清有逐臣。\n真处不妨看到幻，幻中原不碍吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50339,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽黔阳吴芥舟明府 其六","author":"成鹫","text":"六月飞霜黯不开，遥闻仙姥下瑶台。\n慈乌独向庭隅泣，斜日惊心野鸟来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4c