ath":"明_3.csv","pointer":50346,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽黔阳吴芥舟明府 其十三","author":"成鹫","text":"佳儿去日口仍黄，苴杖扶来七尺强。\n优孟衣冠如可学，寝丘遗泽未应荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50347,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽黔阳吴芥舟明府 其十四","author":"成鹫","text":"花开正值落花辰，底事无成却有因。\n因咽未应长废食，重来须记劝餐人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50348,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李陈二子赴中宿 其一","author":"成鹫","text":"南国芳菲共一丛，夭桃秾李挹清风。\n河阳欲问栽花地，乔樾当门是狄公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李陈二子赴中宿 其二","author":"成鹫","text":"龙驹并辔别仙羊，万里秋空疋练长。\n一顾定知声价重，主人原是昔孙阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李陈二子赴中宿 其三","author":"成鹫","text":"三尺青桐七轸丝，匣中流水有遐思。\n鸣琴单父今知己，不用黄金铸子期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李陈二子赴中宿 其四","author":"成鹫","text":"击楫闻鸡并著鞭，车书同轨更同天。\n阳春有脚无遐迩，到日宁忧雨露偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50352,"sha256":"d