b94cc","dynasty":"明"}},{"title":"送刘块然还里 其五","author":"成鹫","text":"诃风骂雨撒痴顽，才鬼诗仙共往还。\n珍重丰干莫饶舌，文殊原不是寒山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘块然还里 其六","author":"成鹫","text":"去本不去君且去，留非久留予暂留。\n前期若问迹删老，云在蒲团月在舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽硕堂老人十章历序平生相遇之缘 其一","author":"成鹫","text":"四十年前早识翁，铁门帘下挹清风。\n章缝把结投衙去，昨日高谈是梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽硕堂老人十章历序平生相遇之缘 其二","author":"成鹫","text":"三十年来觐本师，见翁方恨识翁迟。\n杂华林下曾相许，负荷深惭石洞儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽硕堂老人十章历序平生相遇之缘 其三","author":"成鹫","text":"罗浮归日执心丧，提奖全辜老法王。\n落节删枝成败种，不承当也却承当。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50363,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽硕堂老人十章历序平生相遇之缘 其四","author":"成鹫","text":"海内归来礼国恩，祖庭收拾领儿孙。\n龙山山色今犹昨，祗树秋高不忍论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50364,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽硕堂老人十章历序平生相遇之缘 其五","author":"成鹫","text":"手辟名园作报资，法堂明月接清池。\n一回相见一回老，入室升堂知是谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50365,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽硕堂老人十章历序平生相遇之缘 其六","author":"成鹫","text":"高峻门庭不易登，每逢寒食谒尊僧。\n狂歌薤露逢蒿里，即事分题记得曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50366,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽硕堂老人十章历序平生相遇之缘 其七","author":"成鹫","text":"不住深山住破庵，风波咫尺阴鹅潭。\n迷津欲渡无舟楫，几度缄书问指南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50367,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽硕堂老人十章历序平生相遇之缘 其八","author":"成鹫","text":"住来频见荔枝红，密约分明问祖翁。\n真净不来乡果熟，陈琳无檄愈头风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50368,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽硕堂老人十章历序平生相遇之缘 其九","author":"成鹫","text":"江城禁火复登堂，相顾怆然为滥觞。\n慧命如丝谁断续，老成凋谢倍增伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50369,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽硕堂老人十章历序平生相遇之缘 其十","author":"成鹫","text":"青莲普化已生天，又见篅庵下法筵。\n大寂光中逢石洞，为言顽石罢参禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50370,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和家葆羽见过韵 其一","author":"成鹫","text":"偶从物外识人豪，鸣鹤求声出九皋。\n自是欲閒閒便得，不妨烟雨一停篙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50371,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和家葆羽见过韵 其二","author":"成鹫","text":"漫将朴樕比琼枝，出处同根各异时。\n乔木干霄葵卫足，云泥相见笑攒眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50372,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题刘让夫明府行乐图十二 其一","author":"成鹫","text":"错节盘根任所天，大行山顶静鸣弦。\n无端谱作思亲操，纵有南薰也冷然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":50373,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]