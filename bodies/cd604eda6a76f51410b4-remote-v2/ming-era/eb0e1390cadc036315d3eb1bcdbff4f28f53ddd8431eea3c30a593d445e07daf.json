56":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题菩提叶上画山水 其二","author":"王绂","text":"五湖烟水一扁舟，来往忘机共白鸥。\n得兴何须好东绢，漫将霜叶写清秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题翎毛画 其一","author":"王绂","text":"草色烟光染翠衣，暖风晴日一双飞。\n几番啼向山窗外，清梦初回曙色微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题翎毛画 其二","author":"王绂","text":"谷粟丛边锦羽斑，中心多竞貌安閒。\n少年不惜千金重，胜负惟凭一斗间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题翎毛画 其三","author":"王绂","text":"平田漠漠雨晴时，每报农家布谷迟。\n性拙自甘丛薄下，从教别鸟立高枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题翎毛画 其四","author":"王绂","text":"原野萧萧落木秋，芃芃禾黍满西畴。\n微躯不识南溟远，蓬藋飞鸣且自由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日朝回为陈秀才写竹因题","author":"王绂","text":"丹阙凤来初日上，九苞文彩动天颜。\n池头捉笔随摹写，只得云霄彷佛间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"种竹 其一","author":"王绂","text":"喜得栽时及早春，宿泥独带藓痕新。\n担头挑取来城市，一路清风扫俗尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"种竹 其二","author":"王绂","text":"昨夜春雷始发声，翠鞭应有玉芽生。\n老夫自笑衰年近，尚欲阶庭看锦绷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"种竹 其三","author":"王绂","text":"节间常带粉痕香，玉立亭亭凤尾长。\n最喜客来吟啸处，茶烟飞度翠阴凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"种竹 其四","author":"王绂","text":"节操坚贞耐岁寒，客窗相对结清欢。\n夜深风起珊然响，犹复萧疏入梦看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"种竹 其五","author":"王绂","text":"翠影生阴雨露新，泠泠如玉净无尘。\n衡门自此休教闭，待取清狂直造人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"种竹 其六","author":"王绂","text":"密叶初抽凤尾齐，纷纷苍雪点春泥。\n遥知客到应非俗，好句无妨节上题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"种竹月馀稍觉憔悴恐有不安意用前韵慰之 其一","author":"王绂","text":"东风无处不阳春，小草皆承雨露新。\n底事独含憔悴色，多应不乐近嚣尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"种竹月馀稍觉憔悴恐有不安意用前韵慰之 其二","author":"王绂","text":"不作风声即雨声，客窗萧索可怜生。\n凭君切莫怀乡土，随处何妨弄锦绷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"种竹月馀稍觉憔悴恐有不安意用前韵慰之 其三","author":"王绂","text":"春泥过雨落花香，根下行鞭想渐长。\n正好峥嵘露头角，休教俗眼笑凄凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"种竹月馀稍觉憔悴恐有不安意用前韵慰之 其四","author":"王绂","text":"欲持杯酒慰清寒，作底含愁不尽欢。\n当领主翁珍重意，特回青眼为君看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"种竹月馀稍觉憔悴恐有不安意用前韵慰之 其五","author":"王绂","text":"满城桃李斗芳新，车马春风紫陌尘。\n君独胡为存苦节，饥虚休学采薇人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"种竹月馀稍觉憔悴恐有不安意用前韵慰之 其六","author":"王绂","text":"扬州骑鹤理难齐，雨后来看两屐泥。\n相慰固惭无别物，新诗千首为君题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠余生同伦","author":"王绂","text":"忆我当时别故邱，若翁携汝送行舟。\n而今十载重相见，子正青年我白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"写竹寄王仲渊","author":"王绂","text":"几度相思目断云，乡心无那惜离群。\n殷勤寄语诸亲旧，衰貌年来似此君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四时绝句寄题皆山轩 其一","author":"王绂","text":"燕飞帘幕日初长，面面青山出短墙。\n昨夜春归风雨送，满渠流水落花香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四时绝句寄题皆山轩 其二","author":"王绂","text":"岚光飞翠入帘楹，枕簟生凉暑气清。\n公退日斜新浴罢，坐看峰影过州城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四时绝句寄题皆山轩 其三","author":"王绂","text":"屋外青山画不如，屋头高树影扶疏。\n晚来宾退轩窗静，一榻秋声夜读书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四时绝句寄题皆山轩 其四","author":"王绂","text":"雪飞林壑晓初晴，坐对琅玕眼倍明。\n却忆夜来清梦里，满空鸾鹤上瑶京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为家兄以中写归乐图并赋诗以寄","author":"王绂","text":"半生行役走风尘，年老还家乐更真。\n遥想岁时欢聚处，可能相念未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄乡中诸亲旧","author":"王绂","text":"几番相忆强悲歌，久客京华奈老何。\n莫怪年来倍惆怅，白头亲旧已无多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"写竹寄赵叔平","author":"王绂","text":"君家修竹绕轩居，一别而今十载馀。\n闻说锦绷新意好，旧时根本恐萧疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆故妻","author":"王绂","text":"悼亡又是十年馀，男已成婚女已归。\n翻觉而今悲更切，客中穿尽旧缝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"续毁璧辞","author":"胡俨","text":"云凭凭兮结暝，镜台空兮夜逾永。\n毁璧兮殒珠，殚素丝兮绝柔领。\n薄命兮不如无生，朱弦断兮流哀声。\n念殇子兮泉之扃，有女弱兮嗟娉婷。\n山高高兮上有石，身不化兮长太息。\n星霜易兮时屡迁，旧种繁花今就实。\n命之薄兮心之悲，谗罔极兮我姑慈。\n事朝夕兮或乖缺，蒸藜弗熟心知之。\n有飑风兮回飔，环佩委兮乱陆离。\n圆灵兮仰覆，矢死兮不渝。\n泪浮斑兮筼筜殒，璧之毁兮椟之韫。\n日轮回兮不可以企斯，抚蟾兔兮桂魄隐。\n忆夫君兮驾瑶轸，惜往日兮思途近。\n魂已逝兮情孤，抱深恨兮匪良图。\n觅泉台兮窅以默，天宇澹兮怀哉拮据。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游蓟门","author":"胡俨","text":"鸡喔喔兮扬翘，暾将出兮天宇高。\n烟冥冥兮既敛，芳菲菲兮承条。\n矫予游兮蓟门，睹佳气兮氤氲。\n纷扶疏兮轮囷，忽眇眇兮无垠。\n青帘兮绣箔，恍飞仙兮绰约。\n吹竹兮弹丝，扬清声兮入寥廓。\n倏回风兮度曲，披红芳兮骇绿。\n渺佳期兮浩荡，照绮罗兮华屋。\n鸟鸣兮交交，车辚辚兮驷骄，聊逍遥兮游遨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访石鼓","author":"胡俨","text":"有石兮鼓形，质礧礧兮坚贞。\n始柔祇兮孕璞，实圆灵兮陨星。\n玉人兮追琢，刓方兮就规。\n越千祀兮不泯，羌神物兮司之。\n謇周道兮寝微，宣中兴兮奋发。\n天戈兮四挥，肆南征兮北伐。\n徐方兮载安，猃狁兮摧残。\n方召兮桓桓，暨补衮兮仲山。\n文谟兮武烈，流二雅兮咏歌。\n铿鍧兮炳耀，昭耿耿兮不磨。\n繄端拱兮法宫，四海聿兮来同。\n选徒兮行狩，吉日兮车攻。\n岐山巀兮苍苍，纷旗旐兮央央。\n?马兮既?，?弓兮斯张。\n儦儦兮速速，矢激兮?蜀。\n■■兮员员，君子来兮逌属。\n汧殹兮沔沔，鳗鲤游兮重渊。\n充庖兮登俎，??兮絜鲜。\n麀鹿兮雉兔，左?趋兮右顾。\n君子兮逌乐，䟏䟏兮孔庶。\n?■兮既平，天子兮永宁。\n康驾兮申策，言还兮镐京。\n左右翼兮委蛇，联赤芾兮光陆离。\n臣籀兮再拜，瑑丹兮流滋。\n粲星斗兮错落，与云汉兮昭回。\n珊瑚晔兮腾彩，玉树春兮菲菲。\n环佩锵兮鸾凤飞，鼎鼐蔚兮蟠蛟螭。\n诞纪功兮刻石，亘终古兮无极。\n历岁华兮既远，半苔斑兮藓蚀。\n苍烟兮荆棘，雨淋漓兮日炙。\n野烧兮年年，亦何悲兮?画。\n既不偶兮弃损，复宛转兮流传。\n嗟以形兮见役，乃幸获乎天全。\n巍巍兮璧雍，鼓钟兮雍雍。\n庇广厦兮深覆，惟日觌兮圣容。\n甘从事兮击埽，宣人文兮无穷。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登金台","author":"胡俨","text":"登高丘兮骋望，耿余怀兮太息。\n昔人兮眇绵，嘅千古兮一日。\n彼七雄兮虎斗。\n肆游谈兮辐凑。\n捭阖兮纵横，嗟仁义兮莫救。\n列馆兮筑宫。\n有来兮充充。\n诒谋兮未远，哀望诸兮不终。\n苟士修兮信美。\n岂千金兮能致。\n戋戋兮贲丘，何衒玉兮求贳。\n曦亭亭兮野苍。\n风萧萧兮落木黄。\n鸟群飞兮争栖，鸿冥冥兮高翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒文丞相祠","author":"胡俨","text":"大厦兮既颠，岂一木兮能全。\n惟夫子兮遑遑，冀不负兮所天。\n天茫茫兮曷讯，彼覆餗兮何心。\n志佗傺兮不白，泪浪浪兮盈襟。\n脱虎口兮危疑，羌中道兮失路。\n风尘兮?洞，心郁抑兮谁诉。\n乘桴兮浮海，波漫漫兮汪洋。\n渺灵修兮何许，云冥冥兮山苍苍。\n搴旗兮空坑，期王室兮再匡。\n忽豺虎兮充斥，嗟赤子兮流亡。\n朱崖兮景从，义旅兮奋张。\n何时运兮迫阨，肆披猖兮见絷。\n矢死兮弗渝，哀夷齐兮不食。\n拘囚兮累累，慷慨兮陈词。\n从容兮就义，日惨惨兮风悲。\n遗祠兮黉宫，俨肃肃兮令容。\n神逍遥兮八极，骖白螭兮驾青龙。\n流耿光兮天地，与造化兮焉穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望居庸","author":"胡俨","text":"望军都兮穹窿。\n雄关峙兮居庸。\n苍翠兮蒙茸。\n纷苒苒兮凌风。\n城巍巍兮两山。\n临玉塞兮跨高寒。\n车辚辚兮结驷，风萧萧兮木叶殷。\n淙悬崖兮珊珊。\n恍鸣琴兮清弹。\n闻仙人兮昔降，遗玉枕兮不刊。\n召韩生兮肃之，乃顾余兮一粲。\n驾黄鹄兮高飞翔，薄层云兮入霄汉。\n皇风畅兮八极。\n荡胡尘兮灭熄。\n邀浮丘兮赋诗，歌四海兮宁一。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过卢沟","author":"胡俨","text":"洪流兮桑干。\n汨盘折兮潆湾。\n架石梁兮横波，濑浅浅兮激湍。\n白石兮齿齿，际平沙兮浩漫。\n揽余辔兮东驰，望天门兮九关。\n云飞飞兮来迎。\n水泠泠兮山青。\n回飙度兮远响生。\n木薆薆兮鸟鸣声。\n余欲讯兮九河。\n碣石峙兮嵯峨。\n渺沧海兮无极，恍凌风兮浩歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吊望诸君墓","author":"胡俨","text":"税余驾兮盐沟，见崔嵬兮高丘。\n招遗老兮问讯，曰夫子兮宅兹幽。\n方金台兮筑宫，贤彬彬兮来同。\n何夫子兮好修，亦驱驰兮向风。\n振长策兮高举，下齐城兮建瓴水。\n时不可兮淹留，忽中道兮易轨。\n謇遑遑兮宵征，顾交绝兮不出恶声。\n俾反戈兮相噬，心不忍兮辞诚。\n孤子吟兮抆泪，放子逐兮离忧。\n自古兮如斯，嗟夫子兮抑又何尤。\n春草兮烟浮，野苍苍兮云稠。\n吊夫子兮虽功美之不就，亦墓在良乡垂誉兮千秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]