[{"title":"孙万春挽词","author":"孙一元","text":"西风起天末，惊失少微星。\n问字人初去，燃藜火尚青。\n竟眠藤树樾，难起草堂灵。\n偶过西州路，令人涕泗零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观鱼","author":"孙一元","text":"步屧石池上，观鱼坐短蒲。\n翻萍银拨刺，吹浪雪模糊。\n沙白云光净，日斜岛屿孤。\n濠梁相对处，吾亦偶忘吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浩啸","author":"孙一元","text":"浩啸竹林间，来过湖水湾。\n晚花馀色净，双鹤照衣閒。\n用拙思深隐，时危惭独还。\n狂歌聊自得，随意弄潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发漕河","author":"孙一元","text":"初日浮高树，清鸥散浅沙。\n挂帆湖水上，闻笛野渔家。\n岸坼菰蒲合，云迷山郭斜。\n芳洲动幽兴，自起采蘋花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁暮","author":"孙一元","text":"身世马虺隤，索居不用媒。\n恩多贫曝日，吟苦饥鸣雷。\n冻鹊迟迟下，晴梅鼎鼎开。\n诗书娱此夕，吾意老山隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日王氏池亭一首","author":"孙一元","text":"别浦渔歌近，临流水槛开。\n主人时杖屦，斜日在莓苔。\n沙净新篁出，亭幽群鸟来。\n习池风景异，喜有葛强陪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大善寺赠惠上人","author":"孙一元","text":"访客溪边寺，惠休解爱才。\n高吟时野兴，小坐引春杯。\n翠壁云光薄，青林雨气开。\n会当忘物我，相对碧山隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过黄勉之明水草堂","author":"孙一元","text":"去去草堂远，怀人藜杖过。\n青林散山霭，翠壁吹江波。\n竹里鸠声切，吟边野兴多。\n相看皆道气，白日卧云萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同吾进士谨游陈遂初湖上草堂","author":"孙一元","text":"野径山光里，草堂湖水傍。\n开樽临绝壁，岸帻俯沧浪。\n虚渚秋光净，高云晚木凉。\n同游得朋旧，歌罢兴偏长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮惠宪副北屏别墅","author":"孙一元","text":"对酒清溪上，闻歌杳霭间。\n竹光酣晚日，云影动秋山。\n好鸟移时下，名园尽日閒。\n主人爱潇散，野客不知还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄郑继之","author":"孙一元","text":"少谷平生友，青云半载离。\n岂忘吴地客，不寄雁门诗。\n啸傲定何日，经纶须此时。\n后期解朱绂，同饱九茎芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访许进士台仲九杞山中二首 其一","author":"孙一元","text":"山水经年别，樽罍十日留。\n柴门沙月动，木榻海云流。\n同爱名山隐，难忘帝国忧。\n何时解朱绂，一笑共沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访许进士台仲九杞山中二首 其二","author":"孙一元","text":"下榻山中夜，论交海上村。\n百年同意气，双泪独乾坤。\n木叶风江乱，秋灯雾树昏。\n沧洲终自好，白首钓鱼䑳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"溪堂落成邻渔以箬笠草蓑见遗","author":"孙一元","text":"卜筑苕溪上，幽居景自赊。\n杜陵今避地，庞老喜移家。\n石榻青霞满，山樽白月斜。\n邻翁惠钓具，云水足生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"尚书许公挽词","author":"孙一元","text":"四海哀良弼，百年忆老成。\n西风吹画翣，落月照丹旌。\n相绂怀当日，戎冠识旧名。\n我为天下念，回首一沾缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南轩下梅数花初放对酒尽日","author":"孙一元","text":"春日南轩下，数花梅已香。\n疏枝通月色，淡影接溪光。\n忽忽小诗就，悠悠孤兴长。\n会须怜独立，对坐领年芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆氏永思堂","author":"孙一元","text":"堂在溪流上，门开云树中。\n青禽回野日，黄叶引山风。\n何日烟霞地，来寻桑苧翁。\n把酒坐终夕，回首茨门东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同凌时东邵文化沈邦魁饮戴山大石上","author":"孙一元","text":"载酒问山寺，寻幽过远林。\n残霞依水净，新月隐杯深。\n坐久频移石，歌长得赏心。\n青春元自好，归棹有高吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭吾惟可","author":"孙一元","text":"前年近夫死，今日汝云亡。\n泉石音容外，乾坤涕泪傍。\n才名悲造物，星汉失文章。\n吾道竟谁语，寥寥孤梦长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫笔用姑苏文秀才韵","author":"孙一元","text":"翛然脱尘累，浩汗竟何之。\n千里云山梦，十年江海诗。\n鱼龙酣白日，鸿鹄自清时。\n著眼观群化，长歌酒一卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜不寐","author":"孙一元","text":"虫声破孤寐，起坐转萧骚。\n白露星河近，西风雁背高。\n江山泣吏卒，天地入旌旄。\n老眼苍茫外，长吟首独搔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜雨","author":"孙一元","text":"寒柝声初急，残灯燄不修。\n长吟闻夜雨，独客卧江楼。\n节物东山念，朝廷西鄙忧。\n惊风振丛薄，迷雁失滩洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"枕上漫尔成诗","author":"孙一元","text":"枕上三更梦，愁多记不分。\n长天低野树，茅屋带星文。\n月色万里静，江声永夜闻。\n武夷犹汗漫，宗社想诸君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题爱日楼","author":"孙一元","text":"高楼奉亲处，日色满檐牙。\n寿祝灵椿树，诗歌丹棘花。\n绿樽侑几席，白发悦年华。\n春霭阶庭内，兰孙又茁芽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"脩竹亭","author":"孙一元","text":"脩竹何年种，虚亭散翠阴。\n清风自长夏，赤日避高林。\n袅袅山云净，娟娟溪雾深。\n地偏人不到，来往动高吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠殷近夫靖江二十韵","author":"孙一元","text":"霄汉瞻多士，君才滞一方。\n青袍走吏卒，白马照江乡。\n学与前贤翼，名应后辈光。\n文锋膏鸊鹈，政理卧桁杨。\n吴楚疮痍地，乾坤战伐场。\n孤城危此日，哀笛动清商。\n万里忧南服，群凶睨海疆。\n轒辒防破取，号令极飞扬。\n涕为黎元堕，心应末俗伤。\n风云看变合，形胜认低昂。\n谋食同鸡鹜，危身破犬羊。\n农间留武备，帝上演天潢。\n丧乱哀孙楚，宾朋忆郑庄。\n独怜清咏苦，每爱剧谈长。\n去国烟云异，故园橘柚荒。\n土风犹未习，水味只新尝。\n鸟尽沧波阔，天低落日黄。\n子情惟浩荡，吾志正悲凉。\n岁晏舟樯阙，途穷菉葹芳。\n犹怀西北念，梦寐耿难忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"近夫雨中载酒夜访","author":"孙一元","text":"夫子多高逸，为官解爱贤。\n冲泥山径里，访我桂丛边。\n不废清时兴，还开文酒筵。\n寒枝通宿鹊，细雨湿浮烟。\n盘出银丝鲙，诗歌渔父篇。\n草堂元自僻，华烛更成妍。\n绝胜习池饮，接䍦倒载还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送别彭冲老","author":"孙一元","text":"论交非一夕，去路惜匆匆。\n鸟尽暮云碧，天低落日空。\n风尘千里别，灯火一舟同。\n句得劝杯处，春归吹笛中。\n江山我亦老，天地子何穷。\n万事已残醉，百年终短篷。\n案留青玉在，剑蚀土花红。\n客里哀王粲，戎间识吕蒙。\n昂藏各有意，搔首看飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"居定慧禅院","author":"孙一元","text":"高眠云中寺，道路久费攀。\n生涯依老宿，幽事远尘寰。\n窗晴药裹遍，榻静图书环。\n残叶下平阪，荒烟翳潺湲。\n懒久厌文字，静多生道颜。\n短童立晚吹，野色上柴关。\n境适物已化，语忘机自閒。\n门前桂应熟，去去秋满山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"田园卜居","author":"孙一元","text":"明时有遗逸，学稼老田园。\n荷锸云千顷，归耕月满村。\n郊原随步屧，田父共开樽。\n引水蔬成亩，编篱花映门。\n竹边行鸟雀，桑下散鸡豚。\n晴日行看稼，白头坐弄孙。\n年丰占木德，春到验梅根。\n农事时相较，岁功日自论。\n徵科吏未扰，耕凿俗相敦。\n看结田神社，蹋歌笑语温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴兴浮碧亭","author":"孙一元","text":"浮碧亭前湖水平，拍槛呼酒双眼明。\n青天不动钓丝捲，白鱼入手渔舠轻。\n悲风万里动南纪，落日一望摇东瀛。\n沙鸥野鹜少机事，道人亦有沧洲情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卜居一首柬甘泉山人","author":"孙一元","text":"岁晚卜居草堂静，长日晏坐人迹稀。\n梅花不开冻云合，雪片忽堕山鹊飞。\n春杯到手何意味，江风隔岸吹客衣。\n归来道路不须问，云谷丈人还可依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春来两月懒不读书萧然无一事","author":"孙一元","text":"少喜读书今懒读，下床过午头乱蓬。\n青山满楼晏坐处，落日半江元气中。\n看花听鸟了物意，寻诗把酒酬春工。\n风前忽自发一笑，十年梦落沧洲东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得彭济物总制书","author":"孙一元","text":"白马行营照暮春，风流文采一时尊。\n辽阳灯火夜谈剑，梁苑词人今在门。\n闻道经时头尽白，还知百战气犹存。\n寄书为慰南州客，卧病独吟江上村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辛未中秋携张逸人僧龙玉升显东明西湖泛月吹笛饮酒登望湖亭扶醉漫兴","author":"孙一元","text":"一望晴烟破暝幽，湖天滟滟月初浮。\n旋携斗酒呼邻父，小有蔬盘上钓舟。\n笛咽水龙中夜冷，杯摇河影万山秋。\n人间回首悲何事，欲览清光最上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岳武穆王祠","author":"孙一元","text":"誓死从来建大勋，长驱虎旅荡边氛。\n中原故旧今馀几，四海相看独有君。\n吾道千年元气丧，皇图万里一江分。\n至今风断黄龙府，铁马犹嘶战后云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓬窗","author":"孙一元","text":"静启蓬窗发孤啸，天风四檐吹昼晴。\n乱石横泉自经纬，幽兰老桂时争清。\n诗书端坐了节序，山林无事完姓名。\n夜深魍魉向人拜，薜荔女萝衣分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送彭济物赴阙","author":"孙一元","text":"斗酒长歌赋远游，客心无赖揽衣裘。\n西风老雁啼残夜，虚馆青灯梦九州。\n一路江山随指顾，万方时瘼要分忧。\n功成天上归来日，还觅沧浪旧钓俦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋晚登镇海楼","author":"孙一元","text":"楼上轻云散女陴，楼前狂客独支颐。\n江当夕照半添色，诗与秋山两斗奇。\n木叶无言时序暮，尘寰多事杖藜知。\n只应又被渔郎笑，雨细风斜归去迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上别吴廷高约明年同游严陵钓台","author":"孙一元","text":"一曲离歌日欲晡，寒云漠漠乱蘼芜。\n晚风江上人初别，黄篾楼中酒漫沽。\n冻树裹花春有迹，暮林无叶月平铺。\n明年准拟桐江去，共访严陵旧钓徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登吴山绝顶望钱塘江潮","author":"孙一元","text":"独倚危岑岸接䍦，晚潮初上练痕齐。\n乱挝鼍鼓妖蛟舞，倒捲银山海日低。\n弓弩千年人去后，帆樯万里望中迷。\n凭谁唤起眉山老，为诵钱王庙里题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同顾九和侍讲郑继之户部顾与成正郎殷近夫县令泛太湖作军中乐酒酣赋诗","author":"孙一元","text":"洞庭秋老翠陂陀，景物恢奇望里过。\n石柱天风回鹳鹤，海门波浪见鼋鼍。\n帆樯万里怜渔父，鼓角中流和棹歌。\n独倚蓬窗浑不醉，浮云西北意如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠鹤","author":"孙一元","text":"为爱使君双舞鹤，杖藜相过水云乡。\n入门瘦影当窗见，隔树閒行共我长。\n碧海青天怜昨梦，朱琴瑶月斗圆吭。\n他年结屋罗浮上，万树梅花待汝翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻江阴解围喜而独酌烂醉","author":"孙一元","text":"好音慰我静风尘，漫喜呼儿笑语新。\n夏武有诗歌盛代，江山无恙着高人。\n短蓑月下形应古，白酒床头计未贫。\n安得尽闻烽火息，一瓢长醉太平春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与施邦直过南野堂访陆如昆侍御游道场山泛碧浪湖临别书此","author":"孙一元","text":"一笑长髯意已投，角巾相对草堂秋。\n看山载酒青藜健，笼鹤寻僧尽日游。\n浮世事多悲去鸟，野人道在只沧洲。\n他年寄迹来南墅，小结芳邻水竹幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚晴独眺升山绝顶","author":"孙一元","text":"石磴天风笑语清，扪萝直上思犹轻。\n断虹收雨青山出，白鸟弄波斜日明。\n迹学渔樵成久业，身随麋鹿长高情。\n兵戈满眼真何意，只漫蓬蒿过一生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"避俗","author":"孙一元","text":"避俗年来学养慵，惟怜猿鹤日相从。\n閒看流水孤筇往，偶与归樵一径逢。\n老去形骸无长物，清留门户有高松。\n空教使者求颜阖，知入云山第几峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游西湖","author":"孙一元","text":"虎旅将军功业新，也来林下放歌频。\n几年天地伤多事，此日江湖合有人。\n菱叶乱迎青雀舫，波光忽动白纶巾。\n君王若念南征意，乞与西湖寄此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十五夜与汝盛泛舟湖中再叠前韵","author":"孙一元","text":"西湖雨过荷气新，船头对坐言笑频。\n清樽到手有真意，明月堕地延高人。\n一双沙鸟忽近座，无数岩花吹满巾。\n两江事业不须问，来伴渔樵终此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陪李参戎汝盛游胜果寺酒酣登月轮峰望钱塘江潮","author":"孙一元","text":"閒来野寺寻幽事，扶醉登临兴更豪。\n山脚遥分云树碧，海门初上浪花高。\n坐当落日吟偏壮，望入中原首重搔。\n投老要穷奇绝处，不妨随地混渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠徐廷应","author":"孙一元","text":"老翁白首负奇好，来往江湖称地仙。\n野鹜沙鸥各解事，青莼紫鳜宁论钱。\n月明满地夜呼酒，山色半帆秋放船。\n偶过海门访啸父，相逢各诵云烟篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌啼","author":"孙一元","text":"乌啼野树岁将暮，满眼菉葹行路艰。\n老我秪应依白堕，几人犹未识青山。\n百年知己长镵在，万事无心拄杖閒。\n独倚高原望明月，隔云黄鹤几时还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和刘元瑞参政夜归见寄","author":"孙一元","text":"林下轻凉惬素裾，雨晴薄暮景偏馀。\n闭门句好香残后，捣药声高月上初。\n世上风尘元自厌，山中静业未全疏。\n他年杖屦来寻我，同在罗浮顶上居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至日携搕登道场山","author":"孙一元","text":"瞥眼风尘岁屡迁，椒盘柏酒自留连。\n半生作计閒为上，到处论交山最贤。\n好句忽成黄叶寺，小舟漫倚白鸥天。\n松声泉语无人会，独坐岩头意已传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和文徵明除夜见寄","author":"孙一元","text":"节序惊心每忆家，小窗无奈客愁赊。\n风前布褐穷难送，梦里江湖鬓未华。\n香滑春盘堆菜甲，煖分岁酒媚椒花。\n浮云西北应还念，坐对寒灯夜画沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月波楼为陈子鱼题","author":"孙一元","text":"危楼溪上倚层空，住近仙人白兔宫。\n浪静鱼龙眠挂影，夜凉河汉动秋风。\n钩帘弄钓沧洲上，开槛洗杯清镜中。\n他日乘舟听吹笛，我来相访水云东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王与时方伯顾与成参议见访山中","author":"孙一元","text":"柴门车马藩侯重，下榻高谈尽日欢。\n笑我风流丘壑相，对君倒着竹皮冠。\n山中芝草阑干长，石上松阴空翠寒。\n记得晦翁诗句好，一川风月要人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日简王与时方伯","author":"孙一元","text":"九月江南风色幽，狂歌长日爱林丘。\n酒杯且拟东篱醉，汗马未收西国忧。\n鸿雁鸳鹅俱自逸，芦花枫叶各知秋。\n眼中今有王夫子，曲槛新开看水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春晚归山中草堂","author":"孙一元","text":"生涯未了乌藤杖，裹足茅茨年复年。\n报答清朝浑是句，破除尘事总宜眠。\n生来白石仙人分，老结碧山学士缘。\n剩有一裘行带索，等閒懒坐野狐禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李剑州白甫","author":"孙一元","text":"发船挝鼓使君行，望里连云栈阁横。\n此日黎元犹在念，十年格斗喜初平。\n铁堂峡绕秦山远，玉垒峰连汉水清。\n更喜文翁今在蜀，此行须见治功成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孟秋十六日孙道甫范文一昆仲邀予同汪进之京兆方质夫逸人泛舟西湖二首 其一","author":"孙一元","text":"云移洲渚树回湾，来泛湖光十里閒。\n逸客风流同白帻，道人诗句说青山。\n天留晚景平波上，鸥落渔家乱竹间。\n此意与君须领略，菰蒲明月棹歌还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孟秋十六日孙道甫范文一昆仲邀予同汪进之京兆方质夫逸人泛舟西湖二首 其二","author":"孙一元","text":"载酒同寻白鹭湾，相看一笑意犹閒。\n残霞隔水宜诗句，归鸟度云见晚山。\n谢氏宾朋牛者上，岑家兄弟渼陂间。\n醉歌小海无人和，独与渔郎泛月还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿归云庵","author":"孙一元","text":"沙清竹碧鸥出飞，野老候余开石扉。\n暮云捲雨日初落，木叶满山风乍稀。\n酒杯入夜意自好，篝灯向人寒相依。\n穷幽览胜乃吾事，坐爱名山忘独归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":2612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]