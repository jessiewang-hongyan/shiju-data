[{"title":"詶奚元启六首 其四","author":"张弼","text":"东风迟日美虚徐，扑面黄尘不自如。\n闭户细看诸葛傅，援毫漫榻右军书。\n白头老父音书杳，青眼故人踪迹疏。\n遥忆乡园松水上，海棠花发燕来初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶奚元启六首 其五","author":"张弼","text":"诗逋催促不容徐，恰遇春来兴浩如。\n句里烟霞摩诘画，窗前风雨老颠书。\n杜鹃心苦形容瘦，鹦鹉才高礼法疏。\n昨夜西斋吟未了，寒鸦飞散晓钟初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詶奚元启六首 其六","author":"张弼","text":"周师南下昔平徐，闻道雷霆势莫如。\n争似皇明崇礼乐，尽投戈甲事诗书。\n天临黄阁延三老，昼永青宫坐二疏。\n何幸微臣也遭际，云衢发轫致身初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漳南丘陇图为莆田周梁石赋","author":"张弼","text":"累累荒冢对孤岑，回首漳南抱痛深。\n草露松风千里梦，秋霜春雨百年心。\n谁为马鬣封新土，空有鹃声恋故林。\n试向咸阳原上望，汉家陵墓亦消沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答李秋官廷美","author":"张弼","text":"一从失脚下烟萝，都为浮名受折磨。\n尘土无情淹客思，沧江何处和渔歌。\n敝裘悬桁浑如貉，蒸瓠堆盘亦当鹅。\n赖有床头孤剑在，未应不及化龙梭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李廷美过以右军贶予用韵自嘲","author":"张弼","text":"颠张妙迹古藤萝，我欲临之墨枉磨。\n断石每怜脩褉帖，飘风深愧谪仙歌。\n数行障墨浑如蚓，万纸堆床岂直鹅。\n自笑平生真蹇拙，天孙何日付金梭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏台怀古仍用萝韵呈陆孟昭员外","author":"张弼","text":"吴国危机出苧萝，于今尘迹亦消磨。\n行人不识楚门怨，商女还能子夜歌。\n香径白杨啼野鸟，花洲绿水付群鹅。\n虎丘山色依然在，应笑繁华去似梭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵简全聪二上人","author":"张弼","text":"同著缁衣遁绿萝，晋书唐律共磋磨。\n僧中今见大小朗，世上争传长短歌。\n适意岂无千里骏，听经应有一双鹅。\n偷閒欲结东林社，须得蔬盘贮水梭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用□寄林亨大 其一","author":"张弼","text":"引蔓高枝笑女萝，元龙豪气未消磨。\n赤贫何必逢人说，清兴时还对酒歌。\n五夜客愁闻蟋蟀，九天风信送驾鹅。\n男儿须了人间事，不信流光一掷梭。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用□寄林亨大 其二","author":"张弼","text":"霜风凋尽故山萝，为客空将铁砚磨。\n白日光阴忙里□，紫霞心想醉时歌。\n画将雕虎翻成狗，写得长鹥懒博鹅。\n无奈昨宵归梦急，三江孤艇去如梭。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和韵答丘时雍主事","author":"张弼","text":"三百遗篇最苦心，早魁金榜醉琼林。\n东风马首花成阵，明月楼心柳亸阴。\n丰采动人孤鸑鷟，文章传世万珠琳。\n年来袖得秋台笔，时送阳和入舜琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江","author":"张弼","text":"杨子江头几问津，风波如旧客愁新。\n西飞白日忙于我，南去青山冷笑人。\n孤枕不胜乡国梦，敝裘犹带帝城尘。\n交游落落俱星散，吟对沙鸥一怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送罗应魁调官福建","author":"张弼","text":"江右衣冠此丈夫，才于玉陛听传胪。\n百年事业丹心苦，万世纲常赤手扶。\n郭隗台前折疏柳，考亭祠下埽寒芜。\n问渠荣辱升沉事，天际浮云自有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈士贤御史督学南畿","author":"张弼","text":"晓辞清跸沐殊恩，金阙东头赐玉樽。\n岂为宪臣虞醉饱，要令文教布乾坤。\n渊渊洙泗有流派，渺渺江淮无点浑。\n更喜春风报消息，几多桃李在公门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林三同年调官","author":"张弼","text":"堂堂翰苑三君子，侃侃伊用一辈流。\n日月当天容直道，雷霆震地肯低头。\n衡湘路远何须惜，州县官閒且自由。\n寄语南闽旧提举，此生端不愧同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次杨编修维新闻喜韵 其一","author":"张弼","text":"喜气朝从驿使来，金函桂籍到容台。\n千人入试百人中，两弟登科一弟魁。\n都下群公誇竞秀，关西诸子总奇才。\n黄封内酝须多领，更向春风听荐雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次杨编修维新闻喜韵 其二","author":"张弼","text":"韦编同见伏羲来，鼎立春风画卦台。\n杨叶巳穿三叶破，梅花还占百花魁。\n凤皇池上文章伯，鸳鹭行中柱石材。\n愧我无能惟渴睡，梨床鼻息殷如雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宜兴好寄弋阳尹李端卿兼简诸公 其一","author":"张弼","text":"吴中山水宜兴好，曾在京华得饱闻。\n踪迹十年嗟未到，风烟一壑要平分。\n笋镵茶焙铜官雨，荷盖兰舟洴浰云。\n更问东坡田可赎，便教儿子早耕耘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宜兴好寄弋阳尹李端卿兼简诸公 其二","author":"张弼","text":"故人宦辙各西东，欲到荆南恐未逢。\n地主何须寻李尹，洞名原自属张公。\n红灰酒美衣须当，紫竹箘肥诗自工。\n有个墨翁应识我，谩凭把笔记行踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅坞草堂为陈鼎赋","author":"张弼","text":"先生懒逐世浮沈，高卧吴山万玉林。\n醉赏风霜摇落景，静窥天地发生心。\n影横疏箔诗先就，香扑晴窗帖漫临。\n我欲放舟乘好兴，老逋仙迹拟同寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书字卷后寄江西陈佥宪","author":"张弼","text":"岁事蹉跎巳过春，听风听雨坐兼旬。\n迢迢云梦千馀里，惨惨风涛几处津。\n张旭可能工字者，洪乔不是寄书人。\n思君两鬓如霜草，何日京华更卜邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登辽阳镇东楼","author":"张弼","text":"步上高城更上楼，凭阑一望思悠悠。\n山如图画催吟兴，海作杯棬荡醉眸。\n箕子故封今异域，管宁旧隐是何州。\n遥闻胡马时南牧，未请长缨愧白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复过榆关登兔儿山作","author":"张弼","text":"马首遥看兔耳山，归程又复度榆关。\n蘼芜欲茁冰初泮，桃李未开春巳阑。\n扑扑黄沙欺黑帽，翩翩白日换朱颜。\n留连不尽东风意，客邸痴儿正望还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠萧黄门子仪凤","author":"张弼","text":"玉树亭亭萧二郎，金声楚楚继书香。\n摄衣道左朝迎马，烧烛堂前夜举觞。\n绿树高崖熊献白，碧波浅濑蛎输黄。\n醉来向我论书法，野雉家鸡漫自狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆同年会寄章黄门元益","author":"张弼","text":"春来都下同年会，我在天涯独自吟。\n花好空劳元白梦，黍香孤负范张心。\n征鸿渺渺述残雪，啼鸟嘤嘤隔远林。\n归到曲江春尚在，一枝红杏劝重斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐氏赏铜丝灯","author":"张弼","text":"太平京国万家灯，东巷徐家最有名。\n金网漏光华月小，绣幡拖影綵云轻。\n尊前何用蛾眉舞，笔底能令鬼胆惊。\n试问去年同赏者，天涯星散不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送秦武昌复任","author":"张弼","text":"隼旟遥驻汉江滨，江草江花总是春。\n苏子堂空仍有月，庾公楼在却无尘。\n九天雨露随归马，七泽波涛纵淍鳞。\n会筑沙堤迎太守，汉庭黄霸是何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游永平开元寺","author":"张弼","text":"盘盘幽径寻山寺，碌碌征轮得暂停。\n滦水知春冰半黑，平山消雪草微青。\n乾坤浩荡身如寄，今古升沈梦未醒。\n更上高台东北望，弯弧直欲射狼星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德州遇诸同年","author":"张弼","text":"德州南下水如烟，忽报青帘绣柱船。\n旧太守逢新太守，老同年见小同年。\n官程有限难留久，情绪多端话不全。\n分手匆匆空怅望，野云沙树夕阳边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"淮安雪夜","author":"张弼","text":"自怪平生酒量悭，舟中无事可消閒。\n杂书数卷看来厌，名纸千翻写付还。\n蓬背雪声何飒杳，床前灯影半阑珊。\n瓦垆砂罐空相对，谁在春风醉梦间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"约毕尹游淮上西湖","author":"张弼","text":"欲驾东吴万里船，西湖来赏绿杨烟。\n我?三日酬诗债，君费千金买笑钱。\n酒气蒸霞眠毕卓，墨花洒雨舞张颠。\n便从淮水归京国，五色云中觐九天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜雨独坐怀范季方","author":"张弼","text":"四檐风雨一篝灯，脉脉怀君思不胜。\n龙厩未收千里马，鹑笼却锁九霄鹰。\n何时玉斧重修月，今日青毡漫坐冰。\n回首东风旧游处，花开花落总无凭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"司马庄饮饯适遇生辰","author":"张弼","text":"今年初度五十四，寿酒相将别酒同。\n綵服儿孙群拜舞，白头兄弟各西东。\n春光澹澹风吹柳，寒意亭亭雪在松。\n莫忽马村庄上醉，未知何日更相逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游天平山谒范文正祠","author":"张弼","text":"让王城外事幽寻，独拜天平万石林。\n忧乐有言终不负，经纶未了奈销沈。\n乾坤正气依然在，西北惊尘慎莫侵。\n欲问义田无恙否，夕阳归马一沉吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"镇海楼望金山","author":"张弼","text":"春晴催我上层城，望望金山入杳冥。\n树影连云孤鸟没，涛声撼地万鼍鸣。\n乘槎嗟我头先白，送酒怜君眼独青。\n博陆旧祠还在否，也应宿莽语猩猩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登金山寺楼","author":"张弼","text":"第一江山第一楼，年来频得纵清游。\n盘云苍隼如相识，煮茗缁衣苦欲留。\n笔底风云摇海岳，壶中日月送春秋。\n古今多少登临者，何事哀吟动客愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿江楼梦驾部旧寮","author":"张弼","text":"身卧烟波江上楼，梦寻粉署旧交游。\n吏围巳散饭初下，王事方论著久留。\n隔座□声槐转午，满庭诗景竹鸣秋。\n觉来却算云泥隔，共笑谁怜独客愁。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒山海关武宁王庙","author":"张弼","text":"堂堂燕冀旧山川，沦没胡尘五百年。\n圣主龙飞重汛扫，元勋虎阚共周旋。\n金汤控带华彝限，玉帛来朝道路便。\n建此丰功垂万世，令人俛仰思茫肰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵写怀","author":"张弼","text":"缙云郎署独衰迟，跛鳖难追八骏驰。\n人道戆怀如汲黯，天生讷舌愧张仪。\n吴钩苔绣凭谁砺，燕石珍藏只自奇。\n岭海一麾甘出守，莼鲈又切故园思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赣州姜太守","author":"张弼","text":"甲厂尘街挟册游，黄花二十四回秋。\n一轮五马山前月，千里九龙江上楼。\n豪兴未除湖海气，流年不管庙堂忧。\n前宫正是沧洲吏，定有甘棠在道周。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江西","author":"张弼","text":"江西籓府住江东，水远山回气槩雄。\n蛟井不妖同邑井，雕风虽有让文风。\n滕王高阁烟霞古，徐孺孤亭草树浓。\n岁月催人游不尽，夕阳淡淡雨濛濛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滕王阁次韵","author":"张弼","text":"滕王高阁楚江崖，此日来游夙愿谐。\n远近山川供酒案，古今人物在诗牌。\n乾坤有意留陈迹，岁月无情感壮怀。\n欲借梅仙黄鹤去，五云深处拜尧阶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送丘一诚省亲之京","author":"张弼","text":"旅馆西风见小坡，依然文思捲黄河。\n青云北去乾坤大，沧海南来道路多。\n照雪短檠那可弃，倚天长剑正须磨。\n趋庭若问南安守，铁汉楼头浩浩歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中看瀛奎律髓","author":"张弼","text":"消閒偶看宋唐诗，今古浑疑是一时。\n养气浩然成骨格，铸词聊尔助丰姿。\n浑融合让擎天手，巧妙生憎奉溺儿。\n卷外万篇收不得，白云青障绿连漪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄杨维新学士","author":"张弼","text":"闻君红颊映乌髭，老我清江照鬓丝。\n独守庚申君得法，同生乙巳我为雌。\n一灯旧借东邻照，万里今悬南国思。\n紫阁彤庭严密地，便风休寄故人诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答前任金伯温太守 其一","author":"张弼","text":"路入章江清更幽，棠阴满地说君侯。\n昔年作郡淹黄霸，今日升堂愧仲由。\n戟院鹤鸣松露夜，山田雉雊麦风秋。\n仙裾巳在蓬莱顶，犹顾尘寰赋旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵答前任金伯温太守 其二","author":"张弼","text":"南海黄相远见分，几回细嚼苦思君。\n孤莺愁坐萧萧雨，老隺高飞渺渺云。\n花判最能明国法，草书何足张吾军。\n一尊庾岭梅花月，共醉清风却舞裙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠礼部王希曾","author":"张弼","text":"郡厨今日灶新支，正值中秋明月时。\n万里故人天上至，一尊清酒客边持。\n天时正合留人醉，诗句都非媚灶词。\n却问三郎在南国，姮娥能付桂花枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送弘宜会试","author":"张弼","text":"出守南安便道归，治装送尔赴春闱。\n舟车到处须防险，爵禄随天每慎微。\n直道巽辞真要诀，权门利路是危机。\n传家数出惟清俭，富贵休忘著布衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢史掌教送金盘露一壶","author":"张弼","text":"泮林新置酿春炉，分我金盘露一壶。\n自分独醒遭俗骂，须教沈醉倩人扶。\n郡厨剩有芝园菜，乡思空悬笠泽鲈。\n却笑曹参真寂寞，隔墙谁与和歌呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠新建大尹陆廷玉","author":"张弼","text":"西江城下南安棹，问我东吴小陆郎。\n书札绸缪乡信远，壶觞烂熳故情长。\n阖间尽醉春如酒，藩臬文推月照霜。\n几度公馀骑瘦马，滕王阁上看朝阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄龙太守先生","author":"张弼","text":"秣陵珂马晋陵舟，三十年来忆旧游。\n浩气不随秾李艳，清风常共大江流。\n韩公未老齿先豁，杜子多愁鬓巳秋。\n我欲相寻问真诀，崆峒道士肯点头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和广东按察使闵朝英韵 其一","author":"张弼","text":"到处清风瘴疠分，有人传是紫阳君。\n心澄沧海一轮月，思入罗浮万项云。\n宪府旧推名御史，诗坛今得大将军。\n野人欲献行厨味，雨过山溪鳖长裙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和广东按察使闵朝英韵 其二","author":"张弼","text":"尔祖当年爱尔深，尔将成就祖消沈。\n我今白发空垂泪，尔正青年要尽心。\n辛苦一兄支世业，参差诸弟向儒林。\n立身事主无多说，忠厚清脩是好音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈佥宪粹之书报弘宜中会试","author":"张弼","text":"故旧书来报我知，二郎今亦上云梯。\n文章白玉阶前献，姓氏黄金榜上题。\n移孝要从今日始，立心当与古人齐。\n天恩世世何能报，但祝皇明亿万期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病愈示弘宜","author":"张弼","text":"自喜年来药有灵，吟髭添黑眼添青。\n兴来漫写三千字，性懒难穷十一经。\n豚犬也叨登甲第，马牛何以报朝廷。\n濂溪台上能容我，弄月吟风几醉醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈公甫寓寺连日不见寄之","author":"张弼","text":"何事今朝阻笑谈，凄风寒雨暗江南。\n百年事业知多少，九月光阴又廿三。\n绿酒且教人酩酊，黄花似笑鬓䰐鬖。\n晚晴还过周台宿，细与崆峒道士参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与陈公甫饮有怀贺克恭给事庄孔阳司副","author":"张弼","text":"章江禅院雨声秋，绿水黄花话旧游。\n贺老旷怀应我念，庄生高论许谁酬。\n乾坤古气双龙剑，江海长风万里舟。\n去雁来鸿无信息，夕阳孤倚斗南楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵詶刘职方时雍","author":"张弼","text":"冷落黄花巳过秋，远书忽到念同游。\n风云万里官须做，尘土三边志欲酬。\n落日高台谁举烛，西风野渡自横舟。\n萍踪虽远心常近，倚遍元龙百尺楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送韩推府入觐","author":"张弼","text":"韩侯入觐驾轻艭，满载图书沂大江。\n两月行程风款款，九天膏泽雨淙淙。\n谩收庐阜归诗卷，倒捲淮河入酒缸。\n老我旧游俱在望，壮心飞舞未能降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄建昌太守秦廷韶","author":"张弼","text":"老守题诗寄少游，天涯几度断鸿秋。\n丹心自许乾坤识，白发谁怜岁月流。\n莼菜关情千里外，杜鹃惊梦五更头。\n章江北至云南去，独倚斜阳铁汉楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闰中秋","author":"张弼","text":"乾坤似爱太平年，一半秋光去复旋。\n玉斝重斟今夜月，金笺还和旧诗篇。\n留连丹桂浮香地，担阁黄花冒雨天。\n闻道广寒人喜甚，秋来两度庆团圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重九喜雨","author":"张弼","text":"重阳入夜雨声多，刚为吾民洗瘴痾。\n不用萸囊修故事，先从蔀屋庆天和。\n清尊狼籍登山兴，黄发媻娑击壤歌。\n况是甲兵都洗尽，乾坤无处不恩波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]