[{"title":"己未元夕曲八首 其三","author":"邓云霄","text":"春夜千金价未高，十千一斗市春醪。\n已开芳宴延珠履，肯惜翻杯污锦袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26127,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己未元夕曲八首 其四","author":"邓云霄","text":"绮罗队队踏芳春，士女宫妆态转新。\n十里灯烟团紫雾，六街龙脑散香尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26128,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己未元夕曲八首 其五","author":"邓云霄","text":"市桥桥畔月偏多，谁戛流云发浩歌？\n天上繁星连绣陌，栏前轻浪接银河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26129,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己未元夕曲八首 其六","author":"邓云霄","text":"吹箫明月醉迷楼，廿四桥边忆旧游。\n今夕河梁看夜市，可怜风景似扬州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26130,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己未元夕曲八首 其七","author":"邓云霄","text":"隋宫剪彩未须誇，火树能开顷刻花。\n更羡秋千绳百尺，牵回璧月莫西斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己未元夕曲八首 其八","author":"邓云霄","text":"丰年灯景倍风光，歌管千门夜未央。\n郭北已开驰马埒，城南新敞打球场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其一","author":"邓云霄","text":"万国朝元捧圣君，烟开仙掌暖氤氲。\n九天初上重光日，三殿长飞五色云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其二","author":"邓云霄","text":"北斗低垂倚禁城，南山当殿更分明。\n合宫共祝齐天寿，鸣佩遥闻动地声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其三","author":"邓云霄","text":"夜半君王八骏回，云璈仙管递相催。\n瑶池剩有青鸾使，侍女休歌赤凤来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其四","author":"邓云霄","text":"兽集长杨几万蹄，君王校阅御园西。\n妾身不惮当熊立，懒向楼头看斗鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其五","author":"邓云霄","text":"玉辇看梅爱淡香，宫中皆学寿阳妆。\n冰肌玉骨亭亭远，何用双蛾若许长？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其六","author":"邓云霄","text":"太一祠前散晚霞，满坛灯烛映鸾车。\n九枝斜挂重输月，独炬偏开四照花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其七","author":"邓云霄","text":"君王斋戒集灵台，玉露金茎不满杯。\n宫里琪花千万树，那能承露一齐开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其八","author":"邓云霄","text":"跪风太液折红莲，百尺龙舟水拍天。\n曲罢乘风欲飞去，绉裙还得号留仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其九","author":"邓云霄","text":"千年花树忆仙家，好向双成学种花。\n红颊绯袍镇长在，肯将秋色换春华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其十","author":"邓云霄","text":"宫中雨露本无私，何意偏开向日枝？\n闻道侍臣开讲幄，多陈樛木咏螽斯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其十一","author":"邓云霄","text":"上苑秋千笑语同，湘裙罗袜远行空。\n昔传妙舞能擎掌，今见仙姬解御风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其十二","author":"邓云霄","text":"团扇轻摇水殿凉，巧裁明月绣鸾皇。\n不愁盛暑催香汗，只恐薰风不久长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其十三","author":"邓云霄","text":"年来种竹傍琼轩，浮碧垂阴满院门。\n旭日自宜停凤侣，东风还待长龙孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其十四","author":"邓云霄","text":"百花宿雾暖犹含，蜂蝶纷纷晓已酣。\n欲写春山入眉黛，近来云气蔽终南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其十五","author":"邓云霄","text":"百丈崇台接太清，低枝月桂挂檐楹。\n今朝宫监逢人说，亲听嫦娥叹息声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其十六","author":"邓云霄","text":"花阴翠辇转迟迟，宫扇低回碍柳枝。\n怪底才人不轻折，君王偏念发生时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其十七","author":"邓云霄","text":"白茅方士奏灵符，十亩斋宫四面湖。\n好借琴高金色鲤，妾将骑去问麻姑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其十八","author":"邓云霄","text":"残柳萦烟锁翠眉，御沟流去杳无期。\n纵然红叶能传信，不及东风嫩绿时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其十九","author":"邓云霄","text":"凤楼初阅献俘回，赐宴功臣画阁开。\n从此琵琶消怨调，燕支新进美人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其二十","author":"邓云霄","text":"铜壶银汉水相连，宫漏微茫落远天。\n点点繁声那得尽，故将长夜续如年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其二十一","author":"邓云霄","text":"人在蓬莱阆苑中，由来弱骨有仙风。\n莲花不染空潭水，何用防閒托守宫？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其二十二","author":"邓云霄","text":"承殿花深斗鸭栏，红云绿树倒微澜。\n鸳鸯鸂□纷相逐，谁侍龙颜倚槛看？","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其二十三","author":"邓云霄","text":"报道歌楼怒偃师，六宫长袖尽迟疑。\n圣人正奏虞韶乐，学士休裁舞马词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其二十四","author":"邓云霄","text":"梦中据腹是苍龙，醒后遥闻万户钟。\n记得银屏隐香雾，高唐回首恨云封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其二十五","author":"邓云霄","text":"生来歌舞自能谙，旧住扬州傍绿潭。\n忽听采菱翻艳曲，令人肠断忆江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其二十六","author":"邓云霄","text":"休沐经旬半理妆，唤随歌队过平阳。\n游丝百丈牵官树，底是春情似个长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其二十七","author":"邓云霄","text":"玉华斗帐近承欢，宝枕携来号六安。\n细雨和风自然暖，不知帘外有春寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其二十八","author":"邓云霄","text":"年年修褉浣平沙，太液烟波驻翠华。\n已遣少儿争斗草，更教宫女作司花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其二十九","author":"邓云霄","text":"上元烟景逐年新，幻出金鳌捧紫宸。\n火树万花光似昼，何须剪彩贴宜春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其三十","author":"邓云霄","text":"云母屏风滤月光，凉于秋水白于霜。\n深宫寂寞如琼宇，莫遣清辉到玉床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其三十一","author":"邓云霄","text":"温泉暖室养花枝，二月新瓜已怪迟。\n谁道青皇入清禁？\n南墙幽草未曾知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其三十二","author":"邓云霄","text":"芙蓉锦带拂菱花，宝靥双双斗丽华。\n不畏秦台能照胆，却疑明月是依家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其三十三","author":"邓云霄","text":"飞萤过尽锦屏空，烺烺双星一水中。\n自是君恩若流火，秋来长夜在西宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其三十四","author":"邓云霄","text":"独立银塘夜寂寥，芙蕖相倚背风飙。\n秋深自解宽衣带，不为君王好细腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其三十五","author":"邓云霄","text":"懒将薄命苦悲伤，天地无心莫较量。\n唐苑恩光看放蝶，晋宫车驾本随羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其三十六","author":"邓云霄","text":"春日晴曛锦绣堆，相期女伴上歌台。\n琐窗妆罢看蟢子，已报君王中使催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其三十七","author":"邓云霄","text":"金屋沉沉懒探春，玉阶行倦坐花茵。\n将雏命侣双飞燕，打落青虫故中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其三十八","author":"邓云霄","text":"裸游新馆映清波，长夏凉风澹绮罗。\n日晚散归金锁合，月明肠断夜舒荷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其三十九","author":"邓云霄","text":"桂宫初见羽旗还，愿乞馀丹驻妾颜。\n不惜妾颜薄西日，长承君寿比南山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其四十","author":"邓云霄","text":"尘流阿阁怨閒居，弥子龙阳乐有馀。\n今日不须誇矫驾，他年终见泣前鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其四十一","author":"邓云霄","text":"射蛟鞭石总荒唐，翠辇频年到海旁。\n谁识神仙无定寄？\n宫中亦有杜兰香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其四十二","author":"邓云霄","text":"淡云笼日醉花天，红雨侵阶点绿钱。\n宫柳春来如妾懒，昼长无事但三眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其四十三","author":"邓云霄","text":"判断春光太有情，柳眉桃颊笑相迎。\n也知殿角新雷响，不及君王羯鼓声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其四十四","author":"邓云霄","text":"夜来急雨春风喧，霁后梨花满院门。\n试向上林听百舌，始知鹦鹉未多言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其四十五","author":"邓云霄","text":"宫中寒食赐金钱，共对饧糕忆往年。\n可怪御厨犹禁火，玉堤芳树自含烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其四十六","author":"邓云霄","text":"下来蚕室缫新丝，心绪缠绵春日迟。\n不及采桑南陌女，双蛾何用似人眉？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其四十七","author":"邓云霄","text":"照影池边绣领斜，踏青同步御沟沙。\n昭仪欲佩宜男草，嘱尔先栽夜合花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其四十八","author":"邓云霄","text":"淋池流水日汤汤，清泪犹随出禁墙。\n已见西风生殿角，不须制曲更招商。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其四十九","author":"邓云霄","text":"黄姑渚畔夕流深，牛女相期此夜心。\n共道天孙因巧误，懒排瓜果学穿针。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其五十","author":"邓云霄","text":"凝碧池边玉笛声，长生殿里结盟情。\n愁心欲向弹棋写，只恐心中自不平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其五十一","author":"邓云霄","text":"遥传辇度万年山，漫倚东风想佩环。\n细数落花无限恨，心随流水到人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其五十二","author":"邓云霄","text":"东风送暖动轻绡，新创秦楼待品箫。\n闻道侯家尚公主，玉书先遣凤凰招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其五十三","author":"邓云霄","text":"琐窗秋尽度流萤，谁道长门次掖庭？\n日日焚香兼洗钵，只须朗诵法华经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其五十四","author":"邓云霄","text":"谁对螭头近御筵？\n迩英帘下集群贤。\n起居注罢簪彤管，女史频催索彩笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其五十五","author":"邓云霄","text":"东君回驭百花阑，万户春深莺舌残。\n魏紫姚黄都赏遍，沉香谁更倚阑乾？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其五十六","author":"邓云霄","text":"尚衣初进縠纱裳，夏树阴阴送嫩凉。\n羞把双眉裁柳叶，乱丝飘荡过南墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其五十七","author":"邓云霄","text":"渥洼神骏自西方，一入天冰苜蓿香。\n莫怪新妆梳堕马，君王昨日御乘黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其五十八","author":"邓云霄","text":"中元佳节月华清，懒拍银盆弄化生。\n莫信官门才咫尺，还如弱水绕层城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其五十九","author":"邓云霄","text":"春朝太液暖溶溶，新水微茫混碧空。\n晓雾飞为神女雨，长桥化作美人虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其六十","author":"邓云霄","text":"梨园弟子郁金裙，法曲声高响入云。\n月里曾教青女习，人间莫遣李模闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其六十一","author":"邓云霄","text":"影蛾池畔月如霜，水碧沙明杜若香。\n宫女回波歌楚调，却疑行幸到潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其六十二","author":"邓云霄","text":"露重参横春夜迟，不眠斜倚万年枝。\n花影正须留月姊，花心正好媚风姨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其六十三","author":"邓云霄","text":"愿随王母步天庭，扫地时窥玉札经。\n揲罢舞衣浴明水，霞冠秋礼一坛星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其六十四","author":"邓云霄","text":"朝来池面静无风，绕岸楼台落镜中。\n不信鳌头擎贝阙，请看波底有龙宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其六十五","author":"邓云霄","text":"谁家巧女上鸳机？\n才见柔桑又叶飞。\n南国绮纨新入贡，侍儿相劝易寒衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其六十六","author":"邓云霄","text":"砧声别院响沉沉，蛩透纱窗鹊绕林。\n惆怅秋衿凉吹入，君王空赐辟寒金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其六十七","author":"邓云霄","text":"月冷珠帘彻底清，银床冰簟梦难成。\n秋空万里无云气，桐叶翻阶作雨声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其六十八","author":"邓云霄","text":"群鸡队队锦翎张，玉案旁边立贾昌。\n角胜何须金作距？\n禽心亦自妒专场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其六十九","author":"邓云霄","text":"上林秋尽兔狐肥，游猎平原驾末归。\n细草有心承玉佩，新霜莫遣湿龙衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其七十","author":"邓云霄","text":"属玉双飞太液池，采莲宫女画船移。\n莲房颗颗看相并，若个心中不带丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古宫词一百首 其七十一","author":"邓云霄","text":"白苧声高秋夜长，谁移明月在昭阳？\n层台彩女罗衣薄，舞罢盈盈两袖霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]