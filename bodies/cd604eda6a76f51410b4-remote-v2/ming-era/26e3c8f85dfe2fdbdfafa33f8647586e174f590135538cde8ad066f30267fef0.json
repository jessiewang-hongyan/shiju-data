[{"title":"得明卿书却寄二首 其一","author":"宗臣","text":"逐臣西去楚云长，犹有音书到帝乡。\n莫讶开函龙气满，知君六月过濠梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得明卿书却寄二首 其二","author":"宗臣","text":"忆为秋风满敝裘，计程应醉百花洲。\n如何径作潇湘去，洲上芙蓉日夜愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬朱丈得萝字","author":"宗臣","text":"射阳湖上春水多，射阳湖北长青萝。\n君归莫向湖中卧，恐有蛟龙不得过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬峻伯得屋字","author":"宗臣","text":"山人十载出山屋，手把瑶枝骑白鹿。\n风雷一日走千里，双龙夜夜愁天目。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬助甫得送字","author":"宗臣","text":"白云忽向黄河送，黄河至今不敢涷。\n尽道河中走蜀龙，只今席上行秦凤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"相逢曲","author":"宗臣","text":"千骑东来紫电生，西风吹雪满胡缨。\n将军且莫千恩泽，闻道单于未罢兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬助甫二首得楚圻二字 其一","author":"宗臣","text":"君昔驱龙下三楚，湘妃汉女愁江渚。\n岂有高歌散白云，至今老树作人语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬助甫二首得楚圻二字 其二","author":"宗臣","text":"赤珠射斗牛欲圻，相逢疑是鲛人宅。\n忽然洒酒作江湖，明月长吹千里碧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题方懋藩邸中小石","author":"宗臣","text":"仙人鞭石过沧溟，片碣千秋落此亭。\n昨夜白龙驱不去，天风吹出武夷青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"明月曲同峻伯助甫席上赋得深字","author":"宗臣","text":"飞来明月挂千林，满地霜华吹客心。\n故国鱼龙何处卧，白云愁杀楚江深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得歌字","author":"宗臣","text":"露下金茎吾自歌，与君终夜踏天河。\n可怜一片长安月，曾向江门照薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得书字","author":"宗臣","text":"吾欲驱龙走太虚，为君赤手摘蟾蜍。\n天台三十六峰梩，何限仙人把素书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得虹字","author":"宗臣","text":"蓟门朔雪乱天风，风落千家走白虹。\n马上月明挥不去，知吾夜夜醉新丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新春赠李司封子藩用助甫韵五首 其一","author":"宗臣","text":"李白逍遥供奉班，高歌白雪向人间。\n未须采作长安曲，恐有青春不入关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新春赠李司封子藩用助甫韵五首 其二","author":"宗臣","text":"绿玉仙人截海过，石梁千尺驾鼋鼍。\n相逢赠我金光草，处处青山愁薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新春赠李司封子藩用助甫韵五首 其三","author":"宗臣","text":"鸣环踏月拾婵娟，双剑惊逢北斗前。\n紫气朝来垂马首，何人不作五陵烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新春赠李司封子藩用助甫韵五首 其四","author":"宗臣","text":"海南巨浪抱群星，海上愁云日夜停。\n岂谓芙蓉春不度，短箫吹破万峰青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新春赠李司封子藩用助甫韵五首 其五","author":"宗臣","text":"春风走马玉华东，腰下明珠浸碧空。\n疑是罗浮山上月，为君终日控长虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜月怀明卿二首 其一","author":"宗臣","text":"逐客音书久不闻，天风吹断楚江云。\n相思惟有长安月，拾得婵娟难寄君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜月怀明卿二首 其二","author":"宗臣","text":"处处青枫急暮砧，万山秋色怨瑶琴。\n美人只隔湘江水，江上浮云愁我心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正月十二日夜同助甫过李子藩赋二首得湖西二字 其一","author":"宗臣","text":"杯中明月醉屠酥，南去晴云夜可呼。\n闻道五陵歌玉树，家家拾得紫珊瑚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"正月十二日夜同助甫过李子藩赋二首得湖西二字 其二","author":"宗臣","text":"紫箫吹散夜乌栖，万户春星隰马蹄。\n玉女霓裳知有曲，春风莫到帝城西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得子与书寄赠四首时子与驻节句曲 其一","author":"宗臣","text":"闻君遥住三茅峰，峰上传书遗白龙。\n携得江南春色到，开函飞出紫芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得子与书寄赠四首时子与驻节句曲 其二","author":"宗臣","text":"春云控马入华阳，千尺晴虹跨石梁。\n倘遇赤松歌夜月，知君十日醉玄霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得子与书寄赠四首时子与驻节句曲 其三","author":"宗臣","text":"何处高歌踏紫氛，袖中瑶草白纷纷。\n夜深忽弄昆仑笛，惊破仙人五色云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得子与书寄赠四首时子与驻节句曲 其四","author":"宗臣","text":"贞白祠前扫赤霞，大江明月走晴沙。\n天风吹落阳春曲，散作千门杨柳花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠方隐君六首 其一","author":"宗臣","text":"隐君家在九华山，夜夜春风吹佩环。\n双袖白云留不止，化为龙气满天关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠方隐君六首 其二","author":"宗臣","text":"碧溪之上何者矶，银河倒夹青天飞。\n中流短笛弄明月，惊起玉鳌无处归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠方隐君六首 其三","author":"宗臣","text":"日日骑云向武夷，芙蓉千尺插天池。\n池边白鹿春无数，叱向高岩耕紫芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠方隐君六首 其四","author":"宗臣","text":"山中高卧六十霜，青云为佩霞为裳。\n南溟六月赤虹起，群仙跨之来翱翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠方隐君六首 其五","author":"宗臣","text":"九鲤湖边黄石家，安期之枣大如瓜。\n割来酿作昆仑酒，醉杀桃源万树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠方隐君六首 其六","author":"宗臣","text":"洞箫吹破岭云高，玉女峰前采碧桃。\n三十六天风露冷，临行解赠赤霜袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"峻伯夜过迟助甫不至各赋嘲之","author":"宗臣","text":"胡云片片乱胡霜，匹马东吹明月光。\n何处美人期不至，汉家歌舞在平阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"席上留别高伯宗四首分韵 其一","author":"宗臣","text":"仙人掌上别金茎，霜冷十家醉月明。\n天外武夷君莫问，春风无限蓟门情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"席上留别高伯宗四首分韵 其二","author":"宗臣","text":"万里江花拂石桥，孤槎去弄广陵潮。\n云中倘遇昆仑子，寄尔秦时碧玉箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"席上留别高伯宗四首分韵 其三","author":"宗臣","text":"大江南去片帆轻，江上浮云日夜征。\n回首帝乡春色远，万家杨柳为谁生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"席上留别高伯宗四首分韵 其四","author":"宗臣","text":"振策天风下七闽，当歌愧尔楚江人。\n夜深忽鼓湘灵瑟，处处梅花愁远春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv