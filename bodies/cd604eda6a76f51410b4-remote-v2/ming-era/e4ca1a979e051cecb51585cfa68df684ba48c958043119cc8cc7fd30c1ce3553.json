it":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5022,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答刘宗道别后见寄","author":"欧大任","text":"浔阳别后叹离居，雁尽谁期更有书。\n西去潇湘八千里，前途何处望双鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5023,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"豫章留诸公二首 其一","author":"欧大任","text":"贵家公子玉鞭长，下马相逢大道傍。\n日暮衔杯怅离别，不堪烟雨折垂杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5024,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"豫章留诸公二首 其二","author":"欧大任","text":"南浦楼前风色新，主人送别玳筵春。\n他时若上滕王阁，为念江湖万里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5025,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日豫章游览十首 其一","author":"欧大任","text":"襟江带湖古豫章，西望西山磐石梁。\n松门石镜不可到，天际孤帆烟浪长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5026,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日豫章游览十首 其二","author":"欧大任","text":"南控蛮荆作重都，滕王高阁天下无。\n洪州自昔蛟龙穴，章水今为鱼鳖湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5027,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日豫章游览十首 其三","author":"欧大任","text":"章江门外江水西，南浦亭前春日低。\n桂楫兰桡恣容与，晚风摇过斗门堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5028,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日豫章游览十首 其四","author":"欧大任","text":"市汊渔父豢鸬鹚，芦下挐音来不迟。\n却怜榉柳留江畔，自在蜻蜓立钓丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5029,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日豫章游览十首 其五","author":"欧大任","text":"江头三月雨不止，新水昨添一尺强。\n鸂鶒鹳鹅夜相唤，鄱湖东下乱潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日豫章游览十首 其六","author":"欧大任","text":"商帆估楫太留连，晓来打鼓齐开船。\n直下浔阳三百里，莫愁家在石城边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日豫章游览十首 其七","author":"欧大任","text":"城边酒楼帘昼垂，吴姬楚女斗腰支。\n金鞭折柳不肯下，愁杀江南游侠儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日豫章游览十首 其八","author":"欧大任","text":"千枝杏花高照门，脩竹夹池如兔园。\n自昔西江尊帝子，只今南国奉王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日豫章游览十首 其九","author":"欧大任","text":"春晴彩绣簇湖边，百花洲前更可怜。\n白马青丝三月路，棠梨杨柳万家烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日豫章游览十首 其十","author":"欧大任","text":"千花万花日暮飞，石头渡西江舸稀。\n无钱取醉禁愁得，芳草如烟人未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱湖歌九首 其一","author":"欧大任","text":"苍茫水府大江关，万里西来楚蜀间。\n彭蠡若为云梦泽，匡庐应作剑门山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱湖歌九首 其二","author":"欧大任","text":"南北波涛相对愁，水犀军士向南州。\n英雄割据今何在，惟见江湖日夜流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱湖歌九首 其三","author":"欧大任","text":"西出岷山入海东，章江今汇一湖中。\n玉简曾逢苍水使，石铭犹见紫霄宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱湖歌九首 其四","author":"欧大任","text":"江左楼船伐汉时，鄱阳南下遽班师。\n百战将军曾庙食，至今遗老想旌旗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱湖歌九首 其五","author":"欧大任","text":"康郎山下羽旄开，六军齐唱凯歌回。\n高皇神武雄千古，苏竣卢循伪汉才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱湖歌九首 其六","author":"欧大任","text":"庐岳风烟从古开，御碑传诏九重来。\n天池锦绣丹青合，五色云缠白鹿台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱湖歌九首 其七","author":"欧大任","text":"浔阳九派合溟濛，浪击雷翻天地中。\n贾客渔翁恣来往，帆樯倾仄势连空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱湖歌九首 其八","author":"欧大任","text":"楚女绣襦鸣赵瑟，越人箫鼓唱吴歌。\n珍珠象齿由来贵，估贩宁论万里波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鄱湖歌九首 其九","author":"欧大任","text":"湓浦城边桑落洲，匡山斜对庾家楼。\n扬澜左蠡连天远，鸂鶒鸬鹚无数游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵览古","author":"欧大任","text":"石头踞虎已千年，铁锁沉江事可怜。\n惟有南朝旧歌舞，至今犹在绮罗边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]