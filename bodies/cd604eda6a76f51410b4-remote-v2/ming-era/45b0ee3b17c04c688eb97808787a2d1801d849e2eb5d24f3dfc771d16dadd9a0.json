[{"title":"中元日刘觐国携生鱼过小署对酌赋","author":"邓云霄","text":"床头斗酒为君留，良夜烹鲜小院幽。\n弹铗久无堂下客，持竿空忆海边舟。\n乡心遥对青门月，时序还同赤壁秋。\n莫道银鳞空玉碗，折葵烧笋足赓酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中元夕秦城感怀二首 其一","author":"邓云霄","text":"繁华零落旧长安，遥忆唐宫斗合欢。\n令节中宵开玉殿，化生清水弄银盘。\n霜摧蒲柳红颜尽，草翳园陵白露寒。\n最爱城头月如镜，美人曾照倚栏干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中元夕秦城感怀二首 其二","author":"邓云霄","text":"秦封千里号名藩，帝子王孙玉叶繁。\n宾客几人同邺下，池台空说拟梁园。\n云阶月户秋先到，九陌三条夜不喧。\n谁信古来歌舞地，惟闻砧杵闹中元。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜听雨旅思无聊戏作喜雨愁霖两章觉悲喜由人非关雨也因之有悟 其一","author":"邓云霄","text":"剪烛虚堂玉漏清，西风吹雨过高城。\n土龙昔日愁枯立，垤鹳今宵喜共鸣。\n麦垄渐沾功德水，檐花翻作管弦声。\n征输近苦青苗急，好倩云雷洗甲兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜听雨旅思无聊戏作喜雨愁霖两章觉悲喜由人非关雨也因之有悟 其二","author":"邓云霄","text":"萧条梧叶雨中疏，有客悲秋感慨馀。\n流水百年看逝者，寒灯五夜叹归欤。\n飘摇雁帛沉乡信，警急狼烟报羽书。\n自笑无能同烛武，欲将勋业问樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日雨中同三司诸公集朱邸园池赏菊菊具黄紫二种","author":"邓云霄","text":"登高已阻南山雨，把菊还传北海觞。\n地似梁园兼邺苑，花如魏紫并姚黄。\n风摇华烛轻吹帽，歌戛层云急绕梁。\n座有山公多逸兴，芳池还得号高阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳后一日署中听雨看菊二首 其一","author":"邓云霄","text":"菊花还似故园黄，遥忆东篱水竹旁。\n着雨繁英如有泪，悲秋迁客岂无肠。\n羁栖远国身仍寄，磊落雄心老更狂。\n久矣淫霖连朔晦，虚疑风雨妒重阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳后一日署中听雨看菊二首 其二","author":"邓云霄","text":"凄凄暮雨滞南鸿，冷翠幽香对菊丛。\n三径已荒摇落后，半生多在别离中。\n自甘署冷容官拙，敢谓诗穷得句工。\n赋罢愁霖乡思苦，迢遥飞梦海门东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登雁塔","author":"邓云霄","text":"凭高指顾旧皇州，两腋风生快壮游。\n大漠远分夷夏界，荒烟深贮古今愁。\n俯看白雁皆南度，谁挽黄河更北流？\n叹逝忧时双泪尽，登临不独为悲秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孟冬同三司诸公游伯闻宗侯颐园二首 其一","author":"邓云霄","text":"百转千盘锦石斑，亭台高置彩云间。\n簪裾梁苑邹枚侣，词赋淮南大小山。\n雾拥芝房穿洞入，月寒苔磴踏霜还。\n翩翩飞盖酣清夜，怅望王孙独掩关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孟冬同三司诸公游伯闻宗侯颐园二首 其二","author":"邓云霄","text":"前朝陵阙入荆榛，朱邸重开结构新。\n山壁巨灵藏曲折，石驱东海斗嶙峋。\n园林自写诗中画，丘壑堪容世外身。\n闻道八公时在席，不知虚左属何人？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长至值家慈寿日","author":"邓云霄","text":"朝来云物待书祥，游子瞻云更望乡。\n葭管先回南国暖，槛梅应照北堂觞。\n百年惟祝人难老，一线初添日渐长。\n梦到家筵供雪笋，灯前儿女列成行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"万寿节","author":"邓云霄","text":"名藩礼乐遵周典，外服威仪肃汉官。\n电绕虹流双阙晓，嵩呼华祝万方欢。\n葵心愿学随阳雁，仙掌难攀捧露盘。\n闻道长安红日近，可怜人在旧长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜诸僚长过集小斋雄谈竟夕","author":"邓云霄","text":"雨雪霏霏冷绛毡，相过结伴共谈天。\n读书远愧三冬足，雄辩谁居五鹿前？\n隐吏正谐方外语，俸钱堪给酒中仙。\n主人留客宜清夜，鹤性从来不爱眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和程鹿蘋年兄望辋川忆蓝桥二律 其一","author":"邓云霄","text":"辋川旧迹留天地，更有新篇泣鬼神。\n山水性情谐独往，裴王同调自相亲。\n唱酬尚忆诗兼画，今古空悲世阅人。\n来者为谁堪一笑，却疑游客是前身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和程鹿蘋年兄望辋川忆蓝桥二律 其二","author":"邓云霄","text":"巫山入梦竟虚传，洛浦逢人亦惘然。\n争似琼浆才一酌，直从天路化双仙。\n凤凰定逐吹箫侣，杵臼应留种玉田。\n寄谢多情栏下水，清波肯到鹊桥边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别诸僚长","author":"邓云霄","text":"离亭近在渭城边，未唱阳关已黯然。\n海内弟兄怜旧侣，客中霜雪又新年。\n凌风欲整回溪翮，问渡惭无饮马钱。\n历尽艰危还胆气，烦君相赠绕朝鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别刘觐国","author":"邓云霄","text":"失路孤踪附雁行，相逢同调又同乡。\n论诗一字推敲细，纵饮千场戏谑狂。\n正喜牙弦弹雅韵，忍听陇水切离肠。\n临歧莫折残霜柳，岁晚松枝好寄将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别程鹿蘋年兄三首 其一","author":"邓云霄","text":"看花并马气干云，落羽谁怜雁失群？\n仕历三朝仍故步，途经九折颇如君。\n工诗且作留穷赋，捷径羞裁乞巧文。\n话别愿留风格在，长安裘马任缤纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别程鹿蘋年兄三首 其二","author":"邓云霄","text":"论文柏署夜啼乌，还似当年旧酒徒。\n刻烛诗成骄白帝，驱车天远指苍梧。\n关河度腊寒风急，梁月怀人古驿孤。\n部下仙都勾漏近，寻丹迟汝鼓洪炉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别程鹿蘋年兄三首 其三","author":"邓云霄","text":"世局时情日向新，况兼戎马起边尘。\n迂疏懒挟齐门瑟，偃蹇空嗟汉代薪。\n七尺尚存饶侠骨，百年有尽岂谋身。\n君看跃冶翩翩者，得似淮阳卧治人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伯闻宗侯招饯即席赋别","author":"邓云霄","text":"兽炭兰肴酒复清，异乡同调最关情。\n谁怜品竹弹丝夜？\n已奏离鸾别鹤声。\n向暖南枝思庾岭，怀人北斗指秦城。\n贤书近日多龙种，叹息王孙滞旧京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洛阳除夕","author":"邓云霄","text":"素衣变尽岁仍除，京洛风尘感慨馀。\n三士功名今若此，千秋词赋定何如。\n于时自乏纵横䇲，忧国难陈痛哭书。\n明发乘春上中岳，三花树底问仙居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿少林寺访雪居上人因订曹溪之游","author":"邓云霄","text":"万山深处听流泉，古寺逢僧结净缘。\n折苇已从江北渡，浮杯欲问岭南禅。\n松花糁玉传香饭，蕙帐留云伴独眠。\n夜静悠悠绝尘想，梦随新月到西天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题博望驿","author":"邓云霄","text":"驿楼明月影徘徊，应照沙城骨变灰。\n叛将半随胡虏去，寻源谁似汉臣回？\n龙媒何日随天仗？\n苜蓿空看饲老骀。\n试听鼓鼙思壮士，始知博望是边材。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过新野遇吴门戚不磷山人言依马太史卜居此地忆余作令定交越廿载矣穷途旅食相对泫然留赠三章永怀旧好 其一","author":"邓云霄","text":"宦拙诗穷各自伤，相逢歧路总亡羊。\n豪狂未改双眸白，格律仍随两鬓苍。\n入蜀杜陵长作客，依楼王粲苦思乡。\n衔杯不尽绨袍意，此夕还须脱鹔鹴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过新野遇吴门戚不磷山人言依马太史卜居此地忆余作令定交越廿载矣穷途旅食相对泫然留赠三章永怀旧好 其二","author":"邓云霄","text":"虎邱山寺太湖船，灯下壶觞月下弦。\n洲有百花春似锦，官轻五斗令如仙。\n风流尚忆酣歌日，事往惊非少壮年。\n试探奚囊搜旧草，买山犹剩几文钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过新野遇吴门戚不磷山人言依马太史卜居此地忆余作令定交越廿载矣穷途旅食相对泫然留赠三章永怀旧好 其三","author":"邓云霄","text":"南飞乌鹊月明中，叹息高枝尚朔风。\n执手匆匆同逆旅，论心咄咄但书空。\n暮年有地堪投老，久客无文可送穷。\n明发襄阳重回首，怜君隐处近庞公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕前二日过隆中访马康庄太史九逵计部昆秀留酌别业","author":"邓云霄","text":"隆中佳气郁菁葱，胜地重来访二龙。\n留客筵前邀宝月，清言堂上歇歌钟。\n花生火树芙蓉艳，春入金尊琥珀浓。\n得附名家称伯仲，埙篪同调共噰噰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"襄阳元夕怀马康庄九逵昆季二首 其一","author":"邓云霄","text":"樊城灯火郭门西，汉水星桥接大堤。\n芳宴谁开青玉案，新歌已换白铜鞮。\n春宵到处明如昼，醉客相逢半似泥。\n为近章台游宴地，至今花月使人迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"襄阳元夕怀马康庄九逵昆季二首 其二","author":"邓云霄","text":"开尊何必习池傍，却笑山公未是狂。\n宝马香车尘正合，千金一刻夜偏长。\n时过除夕逢元夕，客在襄阳忆洛阳。\n阅尽繁华冠盖里，更谁能似白眉良。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"习家池","author":"邓云霄","text":"世远池荒尚有亭，山翁去后竟沉冥。\n江光不改鸭头绿，树影长浮竹叶青。\n往日儿童歌客醉，近来时俗忌人醒。\n君看举世醺如梦，岂独高阳是酒星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西又西","author":"邓云霄","text":"秦城回首塞云黄，又挂征帆入瘴乡。\n松菊无缘留我住，海鸥应更笑人忙。\n戈船下濑愁闻笛，函谷听鸡忆履霜。\n却怪长庚太无赖，年年邀客到西方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桂郡逍遥楼和谢在杭司长时苦旱炎甚","author":"邓云霄","text":"谁道宜人独桂林，依然炎赫欲流金。\n催科暗洒疮痍泪，祷雨愁听鼓角音。\n九万抟风堪扇暑，三千击水即为霖。\n逍遥楼上重回首，此日图南意转深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桂江舟中读谢在杭集却寄","author":"邓云霄","text":"瀹茗新烹第一泉，泠泠漱齿诵瑶编。\n却疑桂水乘槎客，忽入波斯载宝船。\n顾盻中原多下驷，凭陵大国少先鞭。\n长驱此日逢勍敌，与汝平分半壁天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梧城七夕守道曾年兄招饮北楼","author":"邓云霄","text":"燕京曾伴广寒游，还忆浔阳月下舟。\n桂籍弟兄元旧侣，梧城杯酒又新秋。\n风波失路谁青眼？\n岁月无情易白头。\n休倚危栏羡牛女，客星今夕亦绸缪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕醉归感怀又赋","author":"邓云霄","text":"牛女星躔粤水湄，梧江银浦接涟漪。\n问津懒作明河赋，得巧还输捷径儿。\n龙气渐消虞帝冢，蛮烟长覆柳侯祠。\n谁怜迁客迎凉夜？\n肠断南山五色芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中元夕招守道曾年丈系龙洲泛月","author":"邓云霄","text":"粤水秦关隔几重，闲云一片似孤踪。\n往时对酒怜弹铗，此日烹鱼更系龙。\n石激江声喧急雨，月移杯影落群峰。\n预愁后会悲前事，痛饮宜听晓寺钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜读曹能始集却寄兼怀谢在杭","author":"邓云霄","text":"铃阁西风入夜清，闲披雅调想高情。\n霞衣迥立云中客，凤吹遥传世外声。\n仕路十年仙共谪，秋心千里月同明。\n逍遥楼下江如练，谁对玄晖弄晚晴？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浔江中秋八首 其一","author":"邓云霄","text":"字子浮踪任转蓬，停桡把酒酹江风。\n百年当遣杯长满，五夜何曾月再中。\n水绕牂牁蛮瘴恶，烟沉铜柱汉营空。\n愁来日日邀欢伯，岂独滁阳有醉翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浔江中秋八首 其二","author":"邓云霄","text":"秋色平分雨后天，黄涛落尽水澄鲜。\n官闲未奉张骞使，吏隐堪乘范蠡船。\n古驿榕阴迎倚棹，荒村虾菜不论钱。\n遥怜芳草斜阳外，闲却青青放鹤田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浔江中秋八首 其三","author":"邓云霄","text":"晚凉星月静相亲，谁道孤舟少四邻？\n汉女江妃浑旧识，眠鸥宿鹭喜依人。\n林飘金粟香风细，露濯芙蓉锦浪新。\n寄语江花好妆饰，秋来白帝正西巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浔江中秋八首 其四","author":"邓云霄","text":"建瓴奔浪向端溪，南去乡关路不迷。\n兰桨影摇天上下，玉轮光遍粤东西。\n滩声迸落寒岩瀑，潮信难期半夜鸡。\n试把浔江比珠海，星槎应在碧云梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浔江中秋八首 其五","author":"邓云霄","text":"滔滔不尽古今愁，且向前溪问钓舟。\n云水无心容泛宅，莼鲈何事独宜秋。\n龙宫大管谁偷弄？\n鲛室明珠几暗投。\n惆怅芦花看渐老，莫教飞上丈人头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浔江中秋八首 其六","author":"邓云霄","text":"司马琵琶泪满裳，古今迁客两浔阳。\n朱弦红袖悲前事，月白江清总断肠。\n恋暑流萤犹带火，迎秋宾雁未啼霜。\n枫林静狎渔舟宿，蟋蟀声声夜正长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浔江中秋八首 其七","author":"邓云霄","text":"经行秦粤万重关，久客悲秋鬓尽斑。\n人世难容双白眼，畏途奚啻百乌蛮。\n江湖有梦怀明主，橘柚无媒忆故山。\n叹息镜园双桂树，西风寥落竟谁攀？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浔江中秋八首 其八","author":"邓云霄","text":"秦城明月满南楼，去岁今宵忆旧游。\n酒泛边风霜入袖，歌弹龙剑气横秋。\n浮生聚散孤鸿影，往事凄凉一叶舟。\n试问渭城堤畔柳，阳关唱后几人留？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朗宁阅武","author":"邓云霄","text":"袖中黄石是仙经，欲向燕然续旧铭。\n叠鼓勒兵翻屋瓦，流星驱炮转雷霆。\n阵环铁壁阴云黑，气压铜标落日青。\n且檄越裳供雪雉，更催飞将取龙庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朗宁署中九日","author":"邓云霄","text":"缭垣苔古树苍苍，柏署寒生九日霜。\n蓬鬓尽随迁客白，菊花犹似去年黄。\n烽烟人梦秦城暮，羽檄关心粤徼长。\n谁暇登台看戏马，直将鸣镝落天狼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"调兵","author":"邓云霄","text":"黔兵已报破安庄，蠢尔交夷敢跳梁。\n飞将忽腾天上阵，长缨终击日南王。\n令传玉帐惊鱼鸟，月照辕门缚犬羊。\n好向武陵求笛谱，伏波遗迹未全荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乌蛮滩谒伏波庙","author":"邓云霄","text":"风波满眼滩声恶，世路因君倍感伤。\n谤箧珠玑疑薏苡，云台名姓掩椒房。\n据鞍人去乾坤老，标柱功垂日月长。\n一曲南征还记否？\n戍楼横笛正吹霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游勾漏洞","author":"邓云霄","text":"曾闪牙旗扫鬼门，又携龙杖探真源。\n寻丹人忆仙中吏，抱朴书传意外言。\n石乳滴床含雾冷，药炉留火入冬温。\n松间老鹤如人语，知是先生几代孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿岳丈海月赵翁八秩又一二首 其一","author":"邓云霄","text":"趺坐忘言道气深，清风明月照虚襟。\n肯寻丹灶延年药，独抱青莲不染心。\n世上蜩螗喧可厌，云中鸡犬静闻音。\n丈人兴寄谁能会？\n知在梅花四百岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿岳丈海月赵翁八秩又一二首 其二","author":"邓云霄","text":"有倩求仙学葛洪，向来传得鲍家风。\n乘龙曾许青云上，跨鹤堪从碧海东。\n酒进霞觞开艳菊，书归桂水托宾鸿。\n休嗟斗室才容膝，人拟蓬莱第一宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桂江冬雨舟中作","author":"邓云霄","text":"荒原满目叹蘼芜，冬暖天南草半枯。\n望去边声传赤羽，愁来云物暗苍梧。\n年残风雨孤舟暮，宦薄宾朋一字无。\n行路苦难归未得，鹧鸪何意更相呼？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桂江舟中寄挽故粤西学宪樊孟泰二首 其一","author":"邓云霄","text":"折柳还思北上年，俄闻归榇已新阡。\n素车白马追何及，吊鹤啼鹃意惘然。\n幽闼月寒疏桂影，清门风静扫榆钱。\n弥留正在黄梅路，魂去应归五祖禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桂江舟中寄挽故粤西学宪樊孟泰二首 其二","author":"邓云霄","text":"消渴那堪驿路尘，茂陵多病竟沉沦。\n岂无浩气骑箕尾，亦有遗编泣鬼神。\n校士粤西虚宪府，修文地下待词臣。\n从今白社诗筒断，郢曲谁当属和人？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自笑","author":"邓云霄","text":"百丈危滩溯上流，畏途逐客增烦忧。\n癖诗不知老将至，拙宦自取人何尤。\n夜眠戍柝敲远梦，晓坐朔风欺敝裘。\n自笑劳生倦行役，经年官舫随渔舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日微雨集逍遥楼看颜鲁公碑二首 其一","author":"邓云霄","text":"百雉雄城象郡开，凭高吊古共徘徊。\n烟深八桂迷秦树，草暗三江失汉台。\n庄叟逍遥空说海，颜碑剥落半藏苔。\n停杯一话兴亡事，风雨沉沉暮角哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日微雨集逍遥楼看颜鲁公碑二首 其二","author":"邓云霄","text":"风急松涛满古城，感时临眺若为情。\n黑云只合催诗赋，微雨那能洗甲兵。\n岭外山川多旧垒，楼头笳鼓入边声。\n戈般明发南征路，懒向湘流吊屈平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日过来乐胡瞻明大参王天虞参戎招集郊外荷池亭上避暑时胡诗先成","author":"邓云霄","text":"庭前山色似环滁，肯许狂夫尽醉无。\n潇洒园池开玉镜，清凉人世坐冰壶。\n香风锦浪宜三伏，越唱吴歌忆五湖。\n闻道昭潭龙睡稳，谁能先手探骊珠？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]