[{"title":"罗甸曲贵州道中 其六","author":"杨慎","text":"林间山胡鸟，声声啼我前。\n何似故园里，花亭闻杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关岭曲贵州 其一","author":"杨慎","text":"倦枕愁鸡鸣，问郎今日程。\n中路不可宿，长途须早行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关岭曲贵州 其二","author":"杨慎","text":"北登鸡公背，南望象鼻岏。\n相逢试相问，往来定谁难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关岭曲贵州 其三","author":"杨慎","text":"关索岭，四十三盘高。\n前有安龙菁，行人莫辞劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关岭曲贵州 其四","author":"杨慎","text":"老鸦关，仰树间。\n灵卜西去何当还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蜻蛉谣","author":"杨慎","text":"蜻蛉川，硪碌野。\n铁菁穷崖，飞鸟不下。\n魋结成群行，白日腥风洒。\n系我氂牛驱笮马，金鸡庙前无行者。\n使君坐紫城，枹鼓卧不鸣。\n苍山平，洱水清。\n守犬无夜惊，行商达天明。\n白羽蠹，青苗生，南山踏歌北山耕。\n愿留使君住，只愁使君去。\n畏途前番君不闻：高车驷马亦使君，劫商毋下殷车轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新春始泛歌 其一","author":"杨慎","text":"螳螂川水青如苔，漕溪寺花红满台。\n韶光满眼莫惜醉，几个扁舟乘兴来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新春始泛歌 其二","author":"杨慎","text":"白沙渡口几人家，红粉当垆青旆斜。\n梁上新巢早留燕，门前垂柳暗藏鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悲酸行","author":"杨慎","text":"少日多欢悰，老境足悲酸。\n悲酸一何易，欢悰一何难。\n游子久不归，憔悴羁南冠。\n亲庭隔千里，梦中路漫漫。\n年来转漂泊，居处无恒安。\n征马常苦瘦，旅席常苦寒。\n有客过我门，劝我强加餐。\n春阳正发育，覆载本自宽。\n穷途谢好音，白意于青翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蒙鸠篇","author":"杨慎","text":"辞家乡，去亲爱。\n远从军，万里外。\n日暮旷野，霜风冻我。\n有夫行恻，营巢寄所。\n蒙鸠语老鸱，摘巢抨去之。\n老鸱言：此鸟是凤凰，抨之恐不祥。\n但可嚇去之，不令在我傍。\n凰止凤飞，羽毛摧颓。\n五里一返顾，十里一徘徊。\n山川嵯峨，嵚岑隐阿。\n且饮晨露，飧朝霞。\n祸无常门，福无常家。\n咄嗟呼，伤哉谓之何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青蛉行寄内 其二","author":"杨慎","text":"燕子伯劳相寺眠，牵牛织女别经年。\n珊瑚宝树生海底，明星白石在天边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遥夜吟","author":"杨慎","text":"明发叶榆城，瞑逗兰津渡。\n超忽类飞翰，往来如织路。\n仆痡马亦黄，簪短带复长。\n天高行谁问，日暮坐自伤。\n鸿飞畏逢罗，虎饥正出柙。\n寒流泚玄冠，凉风吹白帢。\n子有负俗累，予乃投荒人。\n暌形而比影，异习仍同尘。\n晤言能几朝，契阔还叠夕。\n浪迹苦难并，嘉会良易掷。\n翻忆在滇海，翻思在连然。\n嬥歌花馆醉，清梵云房眠。\n丹荧耿遥夜，乌臼聒五晓。\n相望不可晨，咫尺限云杪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舞姬脱鞋歌题画","author":"杨慎","text":"潘妃睡起冷金沙，弓鞋半脱双鸾斜。\n越罗袜衬齐纨素，彩霞摇裔香生步。\n旱路金蕖白日娥，芝田洛浦凌微波。\n曳霜回雪下平地，琉璃滑泽春云腻。\n花松玉软娇无力，天公一笑生春色。\n宝兰困倚殢?跚，小玉双成扶不得。\n起来翘翠踏方尘，妆台搦镜重梳匀。\n人间绝世谁相并，月钩下斗缃钩新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南中晓寒曲","author":"杨慎","text":"南中异节候，北陆戒裘炉。\n夜冻玉朴遫，朝寒金毕逋。\n可念无衣客，谁徵褰与?。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙编行荅禺山","author":"杨慎","text":"北极军书一羽过，南交氛祲九真多。\n金潾铜柱天王地，象渚龙编瘴海波。\n渭曲屯田愁葛亮，关中馈饷急萧何。\n岚开比景鸢低水，风度鸣沙马喷陀。\n自许将军回白日，谁凭壮士挽银河。\n腾峰浴铁朝乘陡，下濑楼船夜戢戈。\n翡翠越裳近消息，麒麟汉阁远嵯峨。\n婆婆横吹惊杨柳，晔晔商声响薜萝。\n隐豹文韬须雾泽，荒鸡舞困且渔蓑。\n欣闻幕府收才彦，伫立衡门听凯歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"莋马行","author":"杨慎","text":"莋马出滇西，青金护凿蹄。\n朝骖过归雁，夕驾轶昆鸡。\n蹀雪工升甗，陵云欲舞梯。\n流星迸石齿，讶道火龙飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"葵镜吟赠右溪","author":"杨慎","text":"蜀葵与唐镜，同节复争鲜。\n蜀葵终向日，唐镜每羞天。\n卉木异情性，造化均陶甄。\n安得指佞早，重植尧阶前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"烟丸歌赠制墨毛道士羽周","author":"杨慎","text":"鸡足烟丸古松心，龙眠惜之如惜金。\n玄霜遥分玉兔窟，碧髓近挺青蛉岑。\n茅犀截角光自照，柏麝却脐香太侵。\n鸿崖羽人故多幻，鹤驭明朝那可寻。\n莫辞为我涴霞襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后缓声歌","author":"杨慎","text":"泽藏之山，必有陆沉之波。\n物或反其常，君将柰之何。\n雌骁难为雄，斧小不胜柯。\n心之忧矣歌且讹。\n复思入淮之爵，必有飞海之鳐。\n披枝且害心，繁实多陨条。\n吐珠谁不含，曼䎼能无招。\n心之忧矣歌且谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"罗甸吟","author":"杨慎","text":"苴兰方号鬼，贵竹甸名罗。\n牛涔枉称海，骏坂犹题坡。\n林馀楚筚辂，?识汉牂牁。\n久戍劳行恻，天高柰若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"笠泽弄三解为潘参藩父寿 其一","author":"杨慎","text":"蜀城东望笠泽云。\n轮囷摇曳青氤氲。\n万里从龙持献君。\n将献君，先过里。\n攒凤笙，歌燕喜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"笠泽弄三解为潘参藩父寿 其二","author":"杨慎","text":"五津东下仙舟轻。\n三泖凉波秋水平。\n景丁南极中宵明。\n中宵明，玄景焕。\n展国容，拜家宴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"笠泽弄三解为潘参藩父寿 其三","author":"杨慎","text":"莺湖小雪梅照天。\n鲈?莼豉酒如泉。\n锦袍起舞白华篇。\n白华篇，丹桂曲。\n祝千龄，绥百禄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹙郎行","author":"杨慎","text":"茈泽鹙郎唼雏鸭，惊飞鸳鸯逐鸭鵊。\n翠袖啼春幽凤奁，红丝穿露空鸾柙。\n碧眼胡儿乱驰鸨，三五红颜片时老。\n今日盈盈滇海花，明旦萧萧陆凉草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"田家喜晴谣","author":"杨慎","text":"玉女投壶玉皇侧，海童拖霖海天黑。\n风花闪日日笑云，云气烘为雀头色。\n须臾变作楼梯天，黄绵袄出晒破砖。\n茅檐夜望黎星没，芦絮飞残水生骨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古怨","author":"杨慎","text":"游树正丰茸，清防深几重。\n金星长乐漏，璧月景阳钟。\n扫粉赵飞燕，捲衣秦祖龙。\n妆成独不见，倾国为谁容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"补皋鱼风木吟为黄月坡政使赋","author":"杨慎","text":"晨风摇摇，有鸟朝嘲。\n不息终朝，予心孔劳。\n夕风习习，有鸟夜㖡。\n不息终夕，予心孔棘。\n树欲静兮，风则起矣。\n子欲养兮，亲则巳矣。\n枯鱼衔索兮，蠹何泣矣。\n养之不逮兮，祭何及矣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"楚竹吟","author":"杨慎","text":"便娟之脩竹，寄生乎江潭。\n葳蕤上防露，泠泠下来风。\n那知竹与柏，虚塞两异心。\n蓬矢射犀草，箘落委荒林。\n夏首西浮远，涔阳南望深。\n大招自抽怨，小歌徒悲吟。\n天高何傩问，斯情匪斯今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游女行","author":"杨慎","text":"东风春正韶，南浦美人娇。\n下蔡君休问，上官谁敢邀。\n折花斜宝珥，映水正金翘。\n娉婷惜未嫁，应待逐文箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖艳曲","author":"杨慎","text":"素足踏金沙，波摇半臂霞。\n东风湖滟好，疑是孟珠家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江艳曲","author":"杨慎","text":"交甫江皋见，刘晨洞里逢。\n可怜?踏雁，不用髻盘龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"思远道","author":"杨慎","text":"章丹请辍舞，秦青且罢歌。\n佳人上宫出，俪婺复倾娥。\n夜月光如练，春江纹似罗。\n所思在远道，朱颜谁为配。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹浪词为刘珥江赋 其一","author":"杨慎","text":"新结茅斋近少城，清流映带更多情。\n幽怀似怪王维少，柳浪何如竹浪清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3115,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹浪词为刘珥江赋 其二","author":"杨慎","text":"青岚帚扫紫筠烟，垂露珠零绿粉天。\n最美仙郎能缩地，筼筜谷在锦江边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3116,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹浪词为刘珥江赋 其三","author":"杨慎","text":"一部清商竹啸风，三霄碧纛舞晴空。\n披襟巳在珠宫上，宋玉兰台赋漫雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3117,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹浪词为刘珥江赋 其四","author":"杨慎","text":"锦箨花绷护笋根，龙孙蛇祖启风门。\n对青好续涪翁赋，滴露研朱挂月村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3118,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹浪词为刘珥江赋 其五","author":"杨慎","text":"众窍为嘘万窍号，调调未定见刁刁。\n画风雄笔君须继，北海南溟捲紫毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3119,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹浪词为刘珥江赋 其六","author":"杨慎","text":"鸾暮笼烟还漏月，凤晨防露更来风。\n宽闲不似城中地，水碧金膏五百弓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3120,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹浪词为刘珥江赋 其七","author":"杨慎","text":"一节为船碧海通，十洲三岛访仙翁。\n乘风破浪非坐事，好在垂天万里蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3121,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴楚行","author":"杨慎","text":"神女巫山上，西施越网中。\n朝云迷楚国，夕露满吴宫。\n舞榭青枫树，歌台绿蕙丛。\n伍员魂巳断，宋玉赋休工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3122,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"涉江采芙蓉","author":"杨慎","text":"沉沉秋江水，灼灼芙蓉花。\n叶叶凌清霜，枝枝明朝霞。\n娟娟东邻子，采采惜芳华。\n昔时赠同心，今日悲天涯。\n欲寄苦无因，向风长叹嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3123,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代古日出行","author":"杨慎","text":"晨登石峦望，浮云何相羊。\n飘风自东来，若木回其光。\n景曜薄万里，下界犹养凉。\n曾崖自郁郁，芳茝含春霜。\n草虫一何微，感物鸣其傍。\n天池有黄鹄，一举知圜方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3124,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵菊篇效陆平原","author":"杨慎","text":"灵菊植幽崖，擢颖凌寒飙。\n春露不染色，秋霜不改条。\n三泉漱玄根，九阳晞素苗。\n衡星散光晶，香气何飘飘。\n东林生玉树，西畹生兰翘。\n懿此葳蕤茂，感彼芸黄凋。\n采为仙人食，千载通一朝。\n金童酌霞醴，神女弹云璈。\n顾视西王母，翠发如陵苕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3125,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扶南曲 其二","author":"杨慎","text":"愁窥绿绮琴，弦涩不成音。\n镜里春春貌，窗前夜夜心。\n临卬人去远，离梦绕花阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3126,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲 其一","author":"杨慎","text":"金莲作杵琼瑰砧，蛟龙艳锦鸳鸯衾。\n并刀未剪燕霜落，何日征衣到沙漠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3127,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲 其二","author":"杨慎","text":"昼漏迢迢春滟滟，草如柔罽花如焰。\n白日红窗恨转多，个侬无计奈春何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3128,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲 其三","author":"杨慎","text":"汝南鸣鸡乌臼鸟，强颜饶舌催天晓。\n残妆相送泪阑干，月帐云屏生晓寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3129,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌栖曲 其四","author":"杨慎","text":"月华二八星三五，丁丁漏水鼕鼕鼓。\n相思相忆阻河桥，可怜人度可怜宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3130,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宛转歌","author":"杨慎","text":"明河拂愰月栖檐，惊乌号林萤入帘。\n美人遥夜歌宛转，罗衣不襞宫黄浅。\n愁听更漏转分明，紞紞楼头五鼓声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3131,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梁白纻舞歌 其一","author":"杨慎","text":"仙人六著帝台棋。\n高张洞越吹参差，二八递代三商移。\n含娇吝彩閟容仪。\n流云不度华星迟。\n炉火九微镫九枝。\n腾觚飞爵朱颜怡。\n传空引满客忘疲。\n满堂不语心相知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3132,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梁白纻舞歌 其二","author":"杨慎","text":"英英白纻雪色光，机杼出自寒女房。\n裁作舞衣双袖长，吴娃魏粲自相将。\n宛转顾步双鸳鸯，俨若星月舒其芒。\n?如结旌体如翔，秋药被风兰袅香。\n回身再拜捧瑶觞，千秋万岁侍君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3133,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桂湖曲送胡孝思","author":"杨慎","text":"君来桂湖上，湖水生清风。\n清风如君怀，洒然秋期同。\n君去桂湖上，湖水映明月。\n明月如怀君，怅然何时辍。\n湖风向客清，湖月照人明。\n别离俱有忆，风月重含情。\n含情重含情，攀留桂之树。\n珍重一枝才，留连千里句。\n明年桂花开，君在雨花台。\n陇禽传语去，江鲤寄书来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3134,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阻风曲罐子矶作 其一","author":"杨慎","text":"峭石惊矶横浦口，朔风半夜蛟龙吼。\n一枕波涛万里心，江水客愁谁浅深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3135,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阻风曲罐子矶作 其二","author":"杨慎","text":"行人夜唱江南曲，巴歈楚㱔遥相续。\n声声怨暝复愁更，诉尽离情天未明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3136,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阻风曲罐子矶作 其三","author":"杨慎","text":"啼猿峡口江流远，回雁峰前沙碛晚。\n水驿梅花开未开，缄情千里寄阳台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3137,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幡幡中林叶别内兄黄峻卿","author":"杨慎","text":"幡幡中林叶，迢迢语离别。\n离别不可亲，相思隔南津。\n南津首北路，莽莽入烟雾。\n夙昔欣芝兰，痾体成欢颜。\n只恋携手好，岂知行路难。\n前有一樽酒，弦歌清商曲。\n行子唱骊驹，主人弹别鹄。\n别鹄影悠悠，寄音下西州。\n一言展契阔，再言申绸缪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3138,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江干行答禺山","author":"杨慎","text":"吴娃江干采芙蓉，陈王洛浦赋游龙。\n忽惊绣带香风起，渐觉罗裳珠露浓。\n不绿织女星边见，定是嫦娥月下逢。\n逢君荐枕对襄王，别君解佩悲交甫。\n青云窈窕曼声歌，绿水回环垂手舞。\n鸾歌凤舞无双人，燕岁莺年二八春。\n百末兰生延夕漏，九华采灯烂晴昼。\n金屏花里活秦宫，宝帐香中隐韩寿。\n回黄转紫返复间，得新捐旧须臾后。\n旧人颜色昔曾新，新人恩爱行当旧。\n旧人红袖泣前鱼，新人翠羽缀燕裾。\n阿娇怨赋金难买，苏蕙回文锦不如。\n浊水清尘坐长叹，空留可怜谁相于。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3139,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华烛引","author":"杨慎","text":"六螭税驾眠虞渊，三爵行栖珠树烟。\n云毋疏窗花作地，茱萸绣帐锦为天。\n铜芝抱蒂复缠柯，金藕相萦共吐荷。\n虹贯彩翚迎雨歇，蜜催香焰送风过。\n桂华漏促频销麝，兰烬天寒不畏蛾。\n徐吾东壁机丝少，郢相南方书误多。\n菖蒲传酒座欲阑，碧玉舞罢罗裳单。\n留云影射荆王枕，泫一光摇汉帝盘。\n揽带盈盈君不见，脱缨脉脉两相看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3140,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又别拟制一篇","author":"杨慎","text":"紫霞西没白日阴，兰膏明烛洞房深。\n蛾飞迥向莲台度，萤爝平临桂炷沉。\n鹤露雁霜惊早寒，寸心斗酒奉君欢。\n火齐蟠烟全的皪，铜荷垂烬半阑干。\n座中碧玉好名倡，清曥曼㫽烂齐光。\n烛花剪作双胡蝶，蜡泪融成两凤皇。\n便面障眉扫蛾绿，搔头坠鬓渲鸦黄。\n绮结交窗窗拂曙，金鉔销香香满絮。\n星翻汉回柰若何，顾影徘徊送君去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3141,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关山月","author":"杨慎","text":"迢迢贱妾隔湘川，杳杳征人戌朔边。\n分弓营对珠龟缺，挂镜台临玉兔圆。\n紫塞风烟白登接，黄河波浪黑山连。\n何时空外婵娟影，来照楼前歌舞筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3142,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"足唐人句效古塞下曲","author":"杨慎","text":"长榆塞上接龟沙，碎叶城边建虎牙。\n夜夜月为青冢镜，年年雪作黑山花。\n苏武白头持汉节，文姬红泪泣胡笳。\n可怜苜蓿迷征马，谁见蒲桃入内家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3143,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕歌行柬程以道","author":"杨慎","text":"玄羌白狄起边埃，翠眊朱綅选将才。\n玉弩惊天连马邑，金精埽旦过龙堆。\n甘泉宫里兜零举，疏勒城边汲绠摧。\n射虎瞑中闻暗吼，落雕云外坠清哀。\n五千深入冲寒雪，十万横行殷霁雷。\n杨柳先春旗叶展，芙蓉不夜剑花开。\n锦车持节夫人至，贝带韬弓骄子回。\n逐北朝移行幕府，受降秋上古轮台。\n青楼月对庚方出，紫塞风从丑角耒。\n拟缚名王歌杕杜，肯思中妇咏条枚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3144,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题唐人闺秀慰帛图","author":"杨慎","text":"碧梧叶落红闺晚，玫砧敲月催金剪。\n重重海帘银蒜垂，曲曲山屏皂罗展。\n广储悬月月初临，缇幕染霜霜已深。\n禁㾕铢衣围夜玉，嵯峨宝髻辟寒金。\n云毋箱开同心锁，钴鉧香浮九微火。\n秦篝齐缕斗纷华，蜀锦吴绫分婀娜。\n熨帛由缯忆远行，遥遥夜夜不胜情。\n百层妾住垂花坞，万里君居碎叶城。\n垂花碎叶音尘隔，春去秋耒感行迹。\n深闺心断结蚕书，绝塞眼穿无雁帛。\n明烛兰膏照独眠，蛾眉曼㫽为谁妍。\n试看裴羽相思夕，何似徐吾共绩年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":3145,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]