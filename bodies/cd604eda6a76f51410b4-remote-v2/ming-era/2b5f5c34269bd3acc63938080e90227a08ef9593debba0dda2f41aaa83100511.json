[{"title":"登飞来寺后高岭至眺虚岩","author":"李孙宸","text":"芙蓉万仞削云浮，峡水回看一线流。\n灵鹫飞来仍下界，仙猿归去杳丹邱。\n振衣两腋罡风举，纵步双眸浩劫收。\n莫道空门千虑息，尚馀探胜兴难酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山留别何太史及两家诸从","author":"李孙宸","text":"若为看山始出山，几回名胜并追攀。\n占星尚拟高阳聚，跨鹤同窥上界还。\n客路燕云看杳杳，离心峡水共潺潺。\n升平事业还君在，多病怜予鬓已斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韶石芙蓉驿舟中邂逅戴安仲旋别","author":"李孙宸","text":"握手相看喜欲狂，旅怀聊得叙离觞。\n春风蘅杜萦游佩，落日芙蓉恋客装。\n侠气尚馀腰下锷，年华空讶鬓边霜。\n路岐共惜分飞去，犹自怜予万里长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阻风南康何郡丞招游庐山白鹿洞","author":"李孙宸","text":"丹梯万仞上虚无，几度经行入望孤。\n祇为风波淹画舫，翻便杖屦到蓬壶。\n云边欲采三珠树，涧底时逢九节蒲。\n不是使君心似水，可能踪迹混江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚步栖贤桥至籋云桥","author":"李孙宸","text":"飞虹横跨断崖深，成玉淙淙泻绝岑。\n喜向云中逢捷路，饱听空外送清音。\n碣侵苔藓铭难认，僧老烟霞胜共寻。\n兴剧未愁催落日，已看凉月出松林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白鹿洞","author":"李孙宸","text":"胜地扳跻亦胜缘，宫墙遥在白云边。\n斯文何代开榛莽，日月千秋见讲筵。\n绝壑奔流虹自偃，经春芳草鹿犹眠。\n临风不尽怀贤恨，松籁萧萧起暮天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠张郡丞理滕县事","author":"李孙宸","text":"佐郡勋名两地传，兼符真羡吏为仙。\n邑原东鲁弦歌旧，人是阳城无字年。\n鸿雁渐还中泽集，妖氛长净绿林烟。\n倦游独自惭消渴，犹费临邛重客筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滕署感怀","author":"李孙宸","text":"荒城下马已黄昏。\n驿馆萧萧不闭门。\n郭外桑麻才有径，人家鸡犬未成村。\n几时中泽还哀雁，独客空斋听断猿。\n怀土忧时纷百念，夜阑聊自倒深尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滕署喜雨赠张使君","author":"李孙宸","text":"久怜旱魃苦东菑，遂有甘霖及我私。\n驿馆乍凉思卧簟，阶除平泛讶成池。\n郊原土滑驱牛疾，关路坭深过马迟。\n闻道平州歌颂遍，愿将谣俗入陈诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滕县闻留雍之命遂自夏镇觅舟回南漫赋","author":"李孙宸","text":"一身北走又南游，解却征鞍上小舟。\n踪迹乍同江上梗，心情仍愧泽边鸥。\n回看道路浮云隔，此去山川王气收。\n国子先生官自冷，逢迎那得到沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁祭斋宿","author":"李孙宸","text":"龙舟山下敞三雍，圣代师儒祀典崇。\n地傍宫墙瞻肃穆，气连城阙郁青葱。\n箫韶奏格瑶坛外，环佩群趋翠幄中。\n向晓礼成斋禁罢，卿云犹自绕厢东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登摄山最高峰","author":"李孙宸","text":"路出层云最上头，居然天外纵双眸。\n芒鞋竹杖同幽事，白雁黄花趁好秋。\n六代寝园芳草没，千山钟磬夕堤收。\n年来宦况浑如水，肯惜空门此夜留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早自栖霞过燕子矶钟放舟返城","author":"李孙宸","text":"罢眺栖霞出紫霄，又扶筇杖陟岧峣。\n烟云未改峰头色，林水兼谐濠上招。\n雁阵远摇芦渚影，龙吟不动海门潮。\n流连莫厌频呼酒，明月波心待晚桡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈明卿自吴门见访诗以别之","author":"李孙宸","text":"宦辙南来似梗浮，故人何意远相求。\n长江正望吴门练，九月先移剡雪舟。\n霜落枫林千里梦，夜凉鸿雁一天秋。\n干戈世路同增感，不独尊前有别愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜陈路若戴安仲过集","author":"李孙宸","text":"怜君新况托江湖，为访名山过旧都。\n偶向故人下尘榻，朅来长夏坐冰壶。\n森森竹径炎蒸远，戛戛松涛夜色孤。\n雅会随缘复随地，未须归梦到枌榆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同侯晋阳司马程六无山人游牛首山 其一","author":"李孙宸","text":"篮舆迢递历枫林，绀宇琳宫尽可寻。\n双阙插云天结搆，万山环寺气萧森。\n谁言佛子还留窟，自是空门无住心。\n归骑未应催落日，杖藜同过献花岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同侯晋阳司马程六无山人游牛首山 其二","author":"李孙宸","text":"名山高倚白云寒，杖底跻攀法界宽。\n共爱官閒多胜赏，转怜秋尽更盘桓。\n层峦叠翠空中见，二水三山掌上看。\n携得玄晖诗句否，登临犹自忆长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李伯熙过访雍署留酌","author":"李孙宸","text":"交游落落旧莲池，握手同君又一时。\n事忆十年多似梦，会怜千里本无期。\n开轩水槛偏留月，对客篱花尚满枝。\n自是合离关气象，尊前沈醉未须辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄董恩白先生","author":"李孙宸","text":"金马曾从避世喧，劳君坛坫属櫜鞬。\n三年尺素怜沧海，千里风期偶白门。\n祇谓延津神自合，谁言别墅望逾尊。\n江东不尽论文思，日落云间易断魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初冬郭给谏携诸同年游一线天回酌后湖亭","author":"李孙宸","text":"朔吹萧萧万木鸣，胜怀偏称薄寒生。\n山开一线疑天小，洞隐重岩碍石横。\n寺远欲迷归客路，江长时送断鸿声。\n淹留更醉湖亭酒，莫遣青山笑宦情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恭迎恩诏步林少宗伯韵","author":"李孙宸","text":"五色芝函下九天，君王有道庆初绵。\n海从献瑞知重润，历应颁新卜万年。\n到处恩波寒谷暖，题来宸翰墨花鲜。\n远臣不尽瞻天思，北极三星喜耀前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29422,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除前五日与六馆诸君宴集请院","author":"李孙宸","text":"南来薄宦叹居诸，忽漫流光逼岁除。\n槐市暂收间讲席，松轩旋扫集簪裾。\n寒销柏叶传杯暖，春入梅花带雪疏。\n最是圣恩隆学府，诸君应已兆鳣鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29423,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日次林宗伯先生韵 其一","author":"李孙宸","text":"龙飞六载开新朔，半百浮生又见春。\n家在青山常有梦，身婴紫绶漫随人。\n莺知节候迁乔早，梅濯冰霜著意新。\n最是旧京风物好，可容追赏共芳辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29424,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日次林宗伯先生韵 其二","author":"李孙宸","text":"春光遥忆凤凰池，万物朝元又一时。\n官署萧閒春漠漠，江山晴暖日迟迟。\n莺雏尚涩风前语，柳色将偷腊后枝。\n夜雪渐消剡曲水，可谁移棹慰相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29425,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日雍署对酒漫成","author":"李孙宸","text":"暖入钟山梅柳新，客怀吟对倍相亲。\n尊前未剪花为鬓，胜里先看日是人。\n鸿雁不传乡国字，韶华空老宦游身。\n东风几夜吹归梦，又忆江南起钓纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29426,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与诸同年游燕子矶二首 其一","author":"李孙宸","text":"盘郁钟山翠万重，还从波面起孤峰。\n澄江尽蘸秋林色，落日时传晚寺钟。\n云净高天来雁鹜，霜寒大壑隐鱼龙。\n吾将从此谢尘鞅，鹤驭逍遥似可逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29427,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与诸同年游燕子矶二首 其二","author":"李孙宸","text":"空王台殿入烟霄，香雾濛濛晚未消。\n肯使高谈杂城市，直分清啸与渔樵。\n尘心顿拟皈三乘，老衲犹能说六朝。\n日暮千山松籁起，满江吹送紫鸾箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29428,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初冬邀同林少宗伯林少司成吉祥寺探梅","author":"李孙宸","text":"铁干疏枝类偃虬，绝胜春色满罗浮。\n几年不作师雄梦，今日真陪和靖游。\n冰雪未销姑射艳，风光深锁上方幽。\n谁怜寂寞江南客，容易看花到白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29429,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈石渠刑部出守重庆","author":"李孙宸","text":"政谱家传自太邱，一麾还向蜀山头。\n巴流几折江成字，栈道子盘鸟亦愁。\n乱后疮痍犹太起，逋馀鹰隼几时收。\n需君到霈随车雨，刀剑行看买犊牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题吴尔达尚宝匏谷","author":"李孙宸","text":"闻君归卧四经春，花磴云窝几处新。\n不为市朝销肮脏，翻从丘壑借嶙峋。\n鸾皇自合归霄汉，猿鹤何须怨主人。\n遮莫勋名钟鼎后，菟裘先已就松筠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得伍国开书寄答兼讯有开","author":"李孙宸","text":"三秋一别各参商，燕去鸿来路渺茫。\n双鲤见遗中有素，长河欲渡恨无梁。\n竹林妒尔还高卧，宦味怜予已厌尝。\n闻道惠连诗更好，春来曾几梦池塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与诸同年探郊梅晚酌灵谷寺","author":"李孙宸","text":"闻道春风陌上柔，可堪经月废春游。\n纷纷宝瑟催黄鸟，处处垂杨引绛驺。\n六出花飞仍带雪，千林雨歇乍鸣鸠。\n村南郭北寻都遍，还共移尊到上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29433,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同林少宗伯林少司成游灵谷寺","author":"李孙宸","text":"暖香新绿满东林，雅会真谐物外心。\n定里风幡传妙偈，空门山水送清音。\n花光艳日留人醉，莺语将春入柳深。\n兴洽未须归骑促，晚来松磴共登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29434,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别林少宗伯次韵二首 其一","author":"李孙宸","text":"春曹卿月接清辉，遂有馀光照虎闱。\n佳句几遗青玉案，奇游同款白云扉。\n尘途已恨分龙剑，乡梦犹怜阻钓矶。\n南国绣裳宁久住，遵鸿计日见公归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29435,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别林少宗伯次韵二首 其二","author":"李孙宸","text":"宦迹金陵拥绛旃，耽游时挂杖头钱。\n官閒自爱烟霞地，恩重惭依日月边。\n倚剑前途怜紫气，沾裳何处和朱弦。\n宣麻早晚看君入，莫漫离怀怆别筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29436,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日与客登凭虚阁","author":"李孙宸","text":"杰阁登临志暮烟，城头落木正萧然。\n六朝风物斜阳外，千里乡心过雁前。\n雪净湖光纷入槛，星涵璧水欲连天。\n金陵作吏真同隐，烂醉更阑未儗旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29437,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次和祝京兆留别二首 其一","author":"李孙宸","text":"春风桃李正芳妍，忽见除书下日边。\n宫秩量增新紫绶，经帷仍拥旧青毡。\n十年京尹声原重，此日麟符赐定先。\n正是明堂需柱石，迟君重和柏梁篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29438,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次和祝京兆留别二首 其二","author":"李孙宸","text":"鸡山春暖白云封，东序多閒听鼓镛。\n拄笏每怜朝爽气，登台遥见夕阳舂。\n暂分萍水星为客，终合延津剑是龙。\n师表幸逢京兆在，长馀声教被三雍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29439,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵汪景谟招同程六无李烟客诸子赏刘园牡丹","author":"李孙宸","text":"姚魏虚劳绝代誇，寻常栏槛见繁华。\n汉宫醉后凝香露，洛浦归来绚彩霞。\n芳散满园仍自贵，春残别院若为赊。\n何须琼观怀琼树，自是人间第一花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29440,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻锦州报捷识喜 其一","author":"李孙宸","text":"羽书又复棘关门，一日三驰动至尊。\n壁垒乍新牙帐色，□□旋遁旄头魂。\n西□款议真无赖，关内雄兵枉自屯。\n自是书生偏报主，登坛宿将总空言。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29441,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻锦州报捷识喜 其二","author":"李孙宸","text":"东临□海望扶桑，□□□□□□□。\n赖有孤臣揖顶踵，遂令危垒矻金汤。\n牛椎幕府军初壮，乌落城头敌夜亡。\n知尔论功辞上赏，旄头直儗落欃枪。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29442,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻锦州报捷识喜 其三","author":"李孙宸","text":"伤心旧事弃全辽，风鹤惊魂未可招。\n总为逃臣轻国法，虚令□□□□□。\n丸坭已见封函谷，铜柱行看立汉标。\n从此银河兵甲洗，忠良天遣翊清朝。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29443,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题和李烟客韵 其一","author":"李孙宸","text":"夜长愁听子规啼，谢得黎明又听鸡。\n懒采芙蓉羞并蒂，怕惊鸀鳿爱双栖。\n柳绿飘絮怜沾雨，花纵辞枝肯堕坭。\n得似天台山下水，逐郎重到种桃蹊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题和李烟客韵 其二","author":"李孙宸","text":"虚传雪棹到山阴，未有相思命驾寻。\n兰佩尚留芗泽汗，松笺难写岁寒心。\n春风吹面欺愁脸，夜月穿帏怯素衾。\n不信侯门深似海，向来鱼雁怪消沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淮上午日逢韩绪仲宗伯挈赵裕子之官南院 其一","author":"李孙宸","text":"炎风拂拂榴花阴，落日逢君万里心。\n佩有茝兰堪赠客，话缘桑梓更披襟。\n天边倚剑双龙合，海畔开樽片月深。\n系臂岂烦丝五缕，江湖今有岁星临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淮上午日逢韩绪仲宗伯挈赵裕子之官南院 其二","author":"李孙宸","text":"杨柳青青泗水滨，感时能不念嘉辰。\n一官无定如孤鹤，千里何期会故人。\n乍向交游惊短鬓，翻怜岐路老閒身。\n不须更作投湘赋，怀土忧时已怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟过武侯高卧处二首 其一","author":"李孙宸","text":"沙岸炎风起夕阴，武侯遗迹未消沈。\n偏安肯竟三分业，两表谁怜六出心。\n野老来耕梁父地，江涛犹作卧龙吟。\n经行莫洒英雄泪，鱼水君臣自古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟过武侯高卧处二首 其二","author":"李孙宸","text":"抱膝长吟意自如，何期龙卧挂吹嘘。\n半犁烟雨三分鼎，八阵风云一草庐。\n汉上军屯心自苦，辕门星陨运全徂。\n君看五丈原前月，犹照纶巾下碧虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"济上遇陈明卿夜集古南池","author":"李孙宸","text":"柳风拂拂濯低枝，客路开怀又一时。\n千里故人怜邂逅，十年宦迹愧支离。\n清池锦石偏留月，凉夜虚亭好覆卮。\n不作寒喧相对语，深谈应自见襟期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送别萧伯懋之南掌院时有内子之戚借道还里","author":"李孙宸","text":"我从白下初还阙，君复乘轺问旧畿。\n不为季鹰思鲙去，可知潘岳悼亡归。\n夜寒帝里星文动，天远吴门练影微。\n词苑故交能复几，才禁清梦逐帆飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴生白大司寇还里兼讯其从子来王","author":"李孙宸","text":"冥鸿天外渺难攀，天上初悬曳履班。\n张翰岂缘莼菜去，留侯原为赤松还。\n丹心五夜长情阙，紫气三秋复度关。\n别墅围棋人好在，横山应复比东山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"院署偶成","author":"李孙宸","text":"松竹萧萧小院寒，傍檐霜雪向人残。\n阴阳岁暮催偏疾，乡国天涯望转难。\n岂有微才供楮墨，谬从中秘领衣冠。\n渐鸿于木终非地，何日冥冥纵羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日客中有怀","author":"李孙宸","text":"木叶飘飘风怒号，帝城秋色太萧骚。\n愁中无伴同看菊。\n客里登楼亦当高。\n怀土不堪逢候雁，餐英聊自醉新醪。\n粤台尚在庾关外，独倚危栏首重搔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之南礼答同年杨士载赠别二首 其一","author":"李孙宸","text":"谬陪玉署领群英，独向钟山理旧盟。\n鸡肋一官怜浪迹，嘤鸣千里别同声。\n梅花不隔怀人梦，葵藿宁忘恋主情。\n自是南枝巢越鸟，看君阿阁凤凰鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之南礼答同年杨士载赠别二首 其二","author":"李孙宸","text":"莺花春日满长安，禁苑追趋几度看。\n忽尔分携干气象，漫劳惜别赠琅玕。\n亭中玄草传经易，江上仙舟共客难。\n一水石头双鲤在，相思未远慰加餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春暮重过济上步月","author":"李孙宸","text":"扁舟重泊济河湄，散步行吟又一时。\n驿馆两看江上月，风尘新换镜中丝。\n南飞乌鹊惊枝绕，北望关山吹笛悲。\n翻忆去年携手侣，几回圆缺滞天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题回文","author":"李孙宸","text":"香焚静夜每愁春，泪湿寒衣远寄新。\n肠断晓云孤度楚，帛传宵雁几归秦。\n觞倾月照花开早，箔捲风回燕语频。\n长恨客心伤逝水，忙来怪逐幻中尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"生日偶成酬韩孟郁见赠","author":"李孙宸","text":"忽忽流光五十驰，是非真觉逐年知。\n所经荣贱都非我，误绊风尘好为谁。\n蒲柳未秋零已早，菊松有约赴难期。\n与君且醉他乡酒，莫遣繁忧上鬓丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送倪禺同南少司农解官还蜀","author":"李孙宸","text":"三伏炎蒸雨乍收，隔江遥送木兰舟。\n乡心渴望蛾眉雪，客路愁牵杜若洲。\n佐计几年宽竭泽，投閒随处有盟鸥。\n即看天地仍烽火，未许东山蜡屐游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕后二日承晓湘家门侄自东官携同门诸子佳什见寄因答四韵 其一","author":"李孙宸","text":"萧瑟新秋感索居，停云相望意何如。\n清风辄自思玄度，一壑谁应过幼舆。\n避世漫依金马署，忧时难上洛阳书。\n冥冥江海归鸿远，目极扁舟忆钓鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕后二日承晓湘家门侄自东官携同门诸子佳什见寄因答四韵 其二","author":"李孙宸","text":"为官閒似住山人，秋水秋云老此身。\n一镜独怜潘岳瘦，千金难买马卿贫。\n天涯落叶惊残梦，城外西风起暗尘。\n试问文林诸社友，几时同探武陵春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]