[{"title":"酒品前后二十绝 其十八","author":"王世贞","text":"波如竹色酒如波，劝客仍倾翡翠螺。\n纵醉欲抛抛不得，教人无柰忆时何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其十九","author":"王世贞","text":"顾家酒如顾家妇，玉映清心剧可怜。\n嗣宗得醉纵须醉，未许狼籍春风眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酒品前后二十绝 其二十","author":"王世贞","text":"酒母啾啾怨夜阑，朝来玉液已堪抟。\n黄鸡紫蟹仍肥美，与汝相将保岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省坐无赖阅杂册花草禽鸟凡十六色各成一绝漫题其后 其一 凌霄花","author":"王世贞","text":"枝牵蔓转叶纷纷，数朵蔫红学出群。\n盘石托根君莫笑，只言身自致青云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省坐无赖阅杂册花草禽鸟凡十六色各成一绝漫题其后 其二 金钱花","author":"王世贞","text":"日落千缗散漫垂，华清初浴太真儿。\n请看师相城西邸，应是河阳满县时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省坐无赖阅杂册花草禽鸟凡十六色各成一绝漫题其后 其三 杨花","author":"王世贞","text":"六代愁深金粉词，一溪春涨曲尘丝。\n柔条已是无拘管，惭愧东风特地吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省坐无赖阅杂册花草禽鸟凡十六色各成一绝漫题其后 其四 薜荔","author":"王世贞","text":"一片苍崖万古秋，高天翠色晚俱浮。\n自从谢傅东山别，未许交情到白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省坐无赖阅杂册花草禽鸟凡十六色各成一绝漫题其后 其五 萍","author":"王世贞","text":"洞庭天阔月横斜，浪打风惊自叹嗟。\n少日风光君莫问，至今情性似杨花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省坐无赖阅杂册花草禽鸟凡十六色各成一绝漫题其后 其六 虞美人草","author":"王世贞","text":"才听歌声舞不休，楚宫犹记旧风流。\n相逢莫奏乌骓曲，肠断秋江万古愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省坐无赖阅杂册花草禽鸟凡十六色各成一绝漫题其后 其七 百舌","author":"王世贞","text":"千回睍睆复莺丁，不向东风自一鸣。\n何似侬家卑脚鸟，此生长技自呼名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省坐无赖阅杂册花草禽鸟凡十六色各成一绝漫题其后 其八 山鸡","author":"王世贞","text":"莫怪殷勤学凤皇，祇因毛羽有文章。\n驺虞已自新颁朔，平虑于今复拜郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省坐无赖阅杂册花草禽鸟凡十六色各成一绝漫题其后 其九 鹊","author":"王世贞","text":"早过长信报平安，晚向昭阳效合欢。\n天上只誇频送喜，不知双翅落金丸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省坐无赖阅杂册花草禽鸟凡十六色各成一绝漫题其后 其十 子规","author":"王世贞","text":"络纬唤织朝从暮，布谷催耕雨复晴。\n汝道不如归去好，可将耕织了平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省坐无赖阅杂册花草禽鸟凡十六色各成一绝漫题其后 其十一 鹤","author":"王世贞","text":"引吭长鸣动九霄，丹砂冠顶白云翘。\n自从名唤仙禽后，鳅鳝吞声恨不消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省坐无赖阅杂册花草禽鸟凡十六色各成一绝漫题其后 其十二 白头翁","author":"王世贞","text":"严霜种种映颠毛，莫更嫌人赋老饕。\n处处珍苞浑欲尽，可辞罗网入蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省坐无赖阅杂册花草禽鸟凡十六色各成一绝漫题其后 其十三 鹧鸪","author":"王世贞","text":"西山罝网弥天去，北极苍鹰掠地来。\n日夜怨啼行不得，雄心一片已成灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省坐无赖阅杂册花草禽鸟凡十六色各成一绝漫题其后 其十四 燕","author":"王世贞","text":"曾逐东风入紫微，晚抛江海滞乌衣。\n空誇万里封侯颔，还傍人家门户飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省坐无赖阅杂册花草禽鸟凡十六色各成一绝漫题其后 其十五 八哥","author":"王世贞","text":"偶听春声墙外枝，雕笼惆怅立多时。\n分明细语传鹦鹉，总为聪明欲怨谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"省坐无赖阅杂册花草禽鸟凡十六色各成一绝漫题其后 其十六 啄木","author":"王世贞","text":"空林长日自敲訇，一扫千章蠹尽清。\n闻道柏台乌更好，不知何事但吞声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张州守归蜀 其一","author":"王世贞","text":"攀辕泪洒大河干，把酒毋歌蜀道难。\n倘遇贤兄京兆问，秋霜不改惠文冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张州守归蜀 其二","author":"王世贞","text":"五马春风鬓尚玄，忽闻平子赋归田。\n吴江岂是无驯雉，子午山头响杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张州守归蜀 其三","author":"王世贞","text":"挂冠归去一身轻，瑶草华阳洞里耕。\n仙令祇今多少在，丹成凫鹤自来迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张州守归蜀 其四","author":"王世贞","text":"万里桥下水连天，桥系东吴万里船。\n应有旧时松菊在，不妨杯酒傲霜天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄明卿邵武四绝 其一","author":"王世贞","text":"樵岚山头云欲飞，家家竹马樵川矶。\n为道新年多气色，樵阳太守拜恩归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄明卿邵武四绝 其二","author":"王世贞","text":"十年车马傍星霜，不向仙池忆凤皇。\n高阁祇今题卧治，怪来长孺薄淮阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄明卿邵武四绝 其三","author":"王世贞","text":"蛾眉一向掩秋尘，惭愧沾恩雨露新。\n拭泪暗将残镜照，玉颜还是旧时人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄明卿邵武四绝 其四","author":"王世贞","text":"海内居然七子名，莫教踪迹拟王生。\n莲花肯作干将色，身在光明藏里行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松法师示微疾须陈米作粥侑以小诗","author":"王世贞","text":"自是庵罗树下身，现将微疾欲明真。\n莫疑香积盂中米，居士原来有胜因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郡城方戒严晓上人以疑被杖下狱作此慰之","author":"王世贞","text":"岂有沙门蓄四兵，空将四大施黄荆。\n还他业后无馀事，身在四禅天下行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏屏居山亭与国手刘君对奕倦偶拈长庆集得一绝句云红旗破贼非吾事黄纸除书非我名唯共嵩阳刘处士围棋赌酒到天明时郡将以倭警出师而刘君姓与事有相合者因戏书赠之仍和二绝于后 其一","author":"王世贞","text":"角里先生无远略，嵩阳处士有棋名。\n若教兵法从君授，指点安危分外明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏屏居山亭与国手刘君对奕倦偶拈长庆集得一绝句云红旗破贼非吾事黄纸除书非我名唯共嵩阳刘处士围棋赌酒到天明时郡将以倭警出师而刘君姓与事有相合者因戏书赠之仍和二绝于后 其二","author":"王世贞","text":"自从抛却军符后，唯爱穷身不爱名。\n敲到半枰心便懒，夕阳閒坐小窗明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存没口号十六首 其一 徐比部以言","author":"王世贞","text":"屈指中朝请剑年，主恩明白赐归田。\n春来秦望山头好，大有长安白日悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存没口号十六首 其二 汪中丞玉卿","author":"王世贞","text":"晚日论交汪玉卿，挥毫彷佛见西京。\n沾沾白雪无前辈，寂寂青云要主盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存没口号十六首 其三 梁比部公实","author":"王世贞","text":"罗浮秋色妒归田，南海精灵南斗悬。\n遗藁一编王勃后，怪来男子可无年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存没口号十六首 其四 吴中丞峻伯","author":"王世贞","text":"海岱秋风送逐臣，尚留双泪染征轮。\n自从金印能悬肘，肯数人间不利人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存没口号十六首 其五 俞宪使德甫","author":"王世贞","text":"一官才显复途穷，白简无心也未公。\n闻道豫章秋色里，萧条归橐不禁风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存没口号十六首 其六 张考功助甫","author":"王世贞","text":"易水东头广柳车，看君殊似鲁朱家。\n只今无限穷心在，羞涩双龙匣里花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存没口号十六首 其七 魏济南顺甫","author":"王世贞","text":"济上诸侯才且贤，能将玄草及生传。\n山人自爱名山好，不爱区区一世怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存没口号十六首 其八 李亳州伯承","author":"王世贞","text":"李生宦拙如潘岳，健笔纵横卒未休。\n晚得一城如斗大，又教青绶在前头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存没口号十六首 其九 张佥宪肖甫","author":"王世贞","text":"蜀中男子张君嗣，曾共燕山作酒徒。\n今日独吟江水畔，可能相为一愁无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存没口号十六首 其十 卢山人少楩","author":"王世贞","text":"十年城旦赭为衣，仍向侯门骂坐归。\n死去只知文苑字，到来依旧识人稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存没口号十六首 其十一 谢山人茂秦","author":"王世贞","text":"黄河船畔曳裾人，转眼东风万事新。\n穷病布衣全似汝，只残诗笔尚如神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存没口号十六首 其十二 徐宪使汝思","author":"王世贞","text":"自抛符节请归耕，腰下吴钩解不平。\n忍死为名频见嘱，不知田叟久逃名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存没口号十六首 其十三 刘中丞子成","author":"王世贞","text":"使君投笔走风尘，一战黄金自绕身。\n今日汉阴烟色里，可无翻羡灌园人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存没口号十六首 其十四 张太仆有功","author":"王世贞","text":"再厌承明鬓未苍，翩翩浊世有张郎。\n生前无地容他酒，一死翻然侠骨香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存没口号十六首 其十五 许长史殿卿","author":"王世贞","text":"梁园朝暮拥笙歌，犹有音情问薜萝。\n口嘱去人无别语，不多饮酒读维摩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存没口号十六首 其十六 顾山人季狂","author":"王世贞","text":"十劳鳞羽访空山，莫怪裁书九不还。\n布帽遮头腰挂网，可堪名姓到人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠淮阳中丞王公子虞入户部六绝 其一","author":"王世贞","text":"千帆飞粟接天流，淮海长鲸一夕收。\n纳取伏波金印去，只教单拜富民侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠淮阳中丞王公子虞入户部六绝 其二","author":"王世贞","text":"桃花李花互争新，柳叶柳枝俱路尘。\n唯有苍虬自霄汉，不关霜雪不关春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠淮阳中丞王公子虞入户部六绝 其三","author":"王世贞","text":"吴侬赛社乞年丰，更有丰年喜报侬。\n吴郡旧时贤太守，玺书新入大司农。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠淮阳中丞王公子虞入户部六绝 其四","author":"王世贞","text":"维阳佳丽古时名，桐柏江清到底清。\n赠取中丞压载石，莫教青雀避风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠淮阳中丞王公子虞入户部六绝 其五","author":"王世贞","text":"青天秀出南岷山，万古长留白雪閒。\n闻道山头山色改，欲施霖雨遍人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠淮阳中丞王公子虞入户部六绝 其六","author":"王世贞","text":"曾劳尺素访青萝，回首风尘感慨多。\n任是司空能候气，不将孤剑傍星河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别吴子充","author":"王世贞","text":"布帆犹带楚云寒，樽酒相逢桂未残。\n明发又为千里别，故乡今日是桑乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏赠华甥起龙 其一","author":"王世贞","text":"新郎玉润眼中稀，五日严程便促归。\n若使异时驱传过，肯教回马款柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏赠华甥起龙 其二","author":"王世贞","text":"莫将公礼恼田家，才得三杯帽已斜。\n任尔文章能似舅，酒狂随分减些些。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小祇园六绝 其一","author":"王世贞","text":"隆福寺西新种竹，啸雨萦烟几万条。\n野夫昼玩兴未已，夜半来眠竹畔桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小祇园六绝 其二","author":"王世贞","text":"茅斋雨过秋云鲜，一饱匡床自在眠。\n不用经行与檀施，生来元是辟支禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小祇园六绝 其三","author":"王世贞","text":"藏经阁前四青松，白云顶宿根苔封。\n自怜霜雪尝应遍，依旧空山作卧龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小祇园六绝 其四","author":"王世贞","text":"绿杨斜馆曲尘丝，也解将情供别离。\n欲识此中无染处，白莲花在放生池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小祇园六绝 其五","author":"王世贞","text":"夹浦芙蓉相映红，拒霜黄菊又丛丛。\n总为穷秋费妆点，春来色相已成空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小祇园六绝 其六","author":"王世贞","text":"清晨手写一函经，舍利毫端已似星。\n但使有僧能过诵，不妨鱼鸟共来听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜雨","author":"王世贞","text":"酒力初消梦未成，空阶滴雨到天明。\n不须身在阳关外，白发应添四五茎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题陆山人募缘诗卷","author":"王世贞","text":"人间岂少嘉宾在，惆怅谁营剡下资。\n何似只携诗卷去，五湖烟雨伴鸱夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"调郭山人","author":"王世贞","text":"回首苍黄剑色分，中原豪杰正思君。\n自从追取青鞋去，且向吴山领白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题邵将军海上战功图","author":"王世贞","text":"吴钩欲截海天流，捷奏明光凯未收。\n何事白茅能夜发，一言先拜富民侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏为舍弟题竹赠王生","author":"王世贞","text":"阿猷到处遍寻汝，为许相将保岁寒。\n最是潇湘一水外，乍晴乍雨耐人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠玉庵上人","author":"王世贞","text":"少日经行晚坐禅，曾教舌本吐青莲。\n而今一字无寻处，饱饭松风任意眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山人戏为三空禅师云过去未来何劳子空子能空一切见在乎师无荅山人代曰檀越饥否且吃午斋去","author":"王世贞","text":"谁云见在本来空，门外犹青万古峰。\n荠菜乍香藜饭熟，留君且受午时供。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慰伴松上人疾","author":"王世贞","text":"长松叶底一绳床，瘦影凌兢额渐霜。\n抛却此身谁受病，不劳三界访医王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈生作大字用布帛随手为之此法出江南李后主号撮襟书生不知也","author":"王世贞","text":"新裁犊鼻似相如，祇合临池兴有馀。\n年少莫谈惊座事，几人能爱撮襟书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病卧池亭丙夜起坐即景有感 其一","author":"王世贞","text":"昼卧虚堂夜起行，朦胧斜月透疏棂。\n无端借得东邻水，一曲江州诉到明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病卧池亭丙夜起坐即景有感 其二","author":"王世贞","text":"一沟流月碧潺潺，翠竹苍梧相对閒。\n枕簟乍凉人似玉，可怜无梦到巫山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]