le":"秋日园居口号六十章 其十一","author":"张萱","text":"少女欲来飞硙蠓，窗前已觉林花动。\n怀橘亭中秋雨新，喜有前林黄熟桶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其十二","author":"张萱","text":"西园自是墙东隐，惊看砑帽簪红槿。\n舞向街头更不休，笑破傍观閒口吻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其十三","author":"张萱","text":"散发时惊松露浣，泥满芒鞋月中浣。\n问侬何意好登临，秋色撩人不暇懒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其十四","author":"张萱","text":"秧马不骑牛解韅，草黄日会秋原狝。\n老□此日足肥甘，雉羹鹿炙山豚脔。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其十五","author":"张萱","text":"□□方休还荷蓧，万斛秋光飞木杪。\n牛羊夕下返□来，閒倚柴门数归鸟。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其十六","author":"张萱","text":"小有园林秋不浅，曾徼白帝回青眼。\n三径未荒丛菊存，安得陶潜同授简。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其十七","author":"张萱","text":"披裘曳杖歌西颢，宋玉悲秋空懆懆。\n长寿宫前遇老樵，伴我罗浮拾瑶草。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其十八","author":"张萱","text":"科头閒倚长松坐，渔父携鱼寻白堕。\n相招一醉蓼花洲，对月同眠书画舸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其十九","author":"张萱","text":"墨沈流香笔能饱，午夜撚须常至卯。\n尽将残唾还前人，幸免少陵日厮炒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其二十","author":"张萱","text":"终南山人毁蛛网，笑引落花拂帘幌。\n西风为我惜馀香，飞向西园茵席上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其二十一","author":"张萱","text":"闭户据梧肘生柳，休烦钻一能观九。\n但令一日足千秋，何必千秋垂不朽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其二十二","author":"张萱","text":"一顷豆萁秋万顷，莫言竹下行厨冷。\n疗饥尚可宿舂粮，客来更有鸣牙饼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其二十三","author":"张萱","text":"途穷不用门题凤，三益径开无二仲。\n负瓢独往亦□归，曾否□人说春梦。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其二十四","author":"张萱","text":"半生匿迹茅茨迥，藜藿肠中无肉酩。\n采采顷筐满蕨薇，带月归来泥没胫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其二十五","author":"张萱","text":"谁从山烧分萧艾，问水休清沙石濊。\n却喜亲人鸟与鱼，时时索我形骸外。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其二十六","author":"张萱","text":"衰老百罹无计避，广平门户真为累。\n园公何事梦魂惊，夜半敲门石壕吏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其二十七","author":"张萱","text":"枫丹芦白溪如锦，恰受航中人昼寝。\n停桡系竹竹吹风，戛玉敲金常警枕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其二十八","author":"张萱","text":"荷锸刘伶痴小瘥，一壶犹向柴车挂。\n酒泉已竭酒星低，醒眼留看閒世界。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其二十九","author":"张萱","text":"风车雨队花为阵，满地落红何足吝。\n园丁已报竹平安，莫向芙蓉城问讯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其三十","author":"张萱","text":"午雨满园秋霮䨴，薜荔可衣兰可佩。\n天公有意茁此徒，一饭常兼三十菜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其三十一","author":"张萱","text":"杯中有物由天运，产在家人何必问。\n园公苦乏杖头钱，取醉时赊裴姥酝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其三十二","author":"张萱","text":"玉板枯禅羹玉糁，扫花铺作披香毯。\n邻酤夜户却早关，老圃酒狂乘月撼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其三十三","author":"张萱","text":"幽怀无尽秋无限，不问人间旦复旦。\n一醉閒眠午梦醒，诗成可判秋光案。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其三十四","author":"张萱","text":"五月已看新谷粜，农家愁叹官家笑。\n新征将及老园公，带汗腰镰刈蓬藋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":19094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居口号六十章 其三十五","author":"张萱","text":"无数溪山供指点，登楼盘礴时挥染。\n峨峨洋洋笔底