[{"title":"冬日登镇海楼","author":"区大枢","text":"楼上登临日，玄冬岁色归。\n千重林叶落，万叠岭云飞。\n野雉馀衰草，城乌下晚晖。\n谁令身转剧，湖海意多违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"行乡书所见","author":"区大枢","text":"旅馆凌朝出，前峰日正昕。\n征旗翻晓角，行盖带春云。\n池竹经冬美，园梅逼腊芬。\n舆中看稚子，歌舞若为群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄刘约我","author":"区大枢","text":"白驿维舟处，章江揽袂心。\n如何一水别，翻作两龙吟。\n绿树螺川远，苍烟庾岭深。\n幽兰虽有曲，谁为写瑶琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏游杜园","author":"区大枢","text":"野兴从君发，名园仲夏过。\n洞深经日小，岭近积云多。\n酒气来兰蕙，箫声出芰荷。\n最怜招隐地，倚杖即岩阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岳阳公署作","author":"区大枢","text":"别署倚巴丘，重湖郭外浮。\n苔荒残壁古，木落满庭秋。\n雁度南楼远，乌啼北院幽。\n空阶时独立，偏动越乡愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚泊溇江即事","author":"区大枢","text":"日落晚崦黄，前溪泊去航。\n析薪临水次，汰米倚滩旁。\n猿狖凭崖啸，熊罴出洞跄。\n淮南招隐后，春草复茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初岁诣兴国寺","author":"区大枢","text":"开岁即宜人，风光到处春。\n山明残雪映，野绚早霞新。\n庭柏回苍干，林篁转绿筠。\n最怜香鹫赏，佳气坐氲氤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和瑞侄雁字诗兼有勉意 其一","author":"区大枢","text":"瀚海风高紫塞抟，遥瞻健翮锲云端。\n史籀直向虫书觅，皇颉空于鸟迹观。\n字倚类形分隶草，文从霄汉揭琅玕。\n掞天竟属如椽手，莫但窗前瞥羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和瑞侄雁字诗兼有勉意 其二","author":"区大枢","text":"同歌宝鼎重咸京，复睹奎文镂泰清。\n一画已从行处出，六书仍向阵边呈。\n排云五色鸾笺下，垂露千重薤叶生。\n玉检何须探往策，联翩今已报瑶琼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玄帝宫在七星岩上","author":"区大枢","text":"绕壁穿萝翠转浓，前峰历历插芙蓉。\n地标七曜维玄象，帝自三天降黑龙。\n洞鹤孤飞横绝岛，岩云高捲挂长松。\n已看仙路红尘远，还羡关门紫气重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋登崧台书怀","author":"区大枢","text":"踏阁攀林暇日游，荒阶榕叶满庭秋。\n烟消石室如图列，潦尽牁江似练流。\n密树繁阴藏古驿，片帆悬影挂高楼。\n汀兰渚芷犹堪撷，欲寄伊人不可求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南还舍弟送至报国寺登毗卢阁遥指乡路","author":"区大枢","text":"丹宫还傍凤城跻，首路那堪问解携。\n鸿雁暂于初地集，骊驹偏向忍林嘶。\n苍茫岭树孤云断，迢递关城落日低。\n南极朱鸢馀万里，不胜乡思晚凄凄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕中感秋","author":"区大枢","text":"有客悽悽厌薄游，可堪鶗鴂更鸣秋。\n卢龙塞上云初敛，玄兔城边月正流。\n永漏凄清传北阙，凉飔萧瑟度南楼。\n因悲素节催年暮，况复天涯久滞留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"追和汪公干塞上逢妓","author":"区大枢","text":"锦鞯玉勒步芳尘，貂帽罗襦坐绣茵。\n桃李谁云非绝代，燕支更复可怜人。\n乍逢虚拟江滨艳，转盼还惊塞上春。\n似是戎王献方乐，琵琶如月抱中新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安秋夜听砧","author":"区大枢","text":"秋闺夜静捣衣裳，袅袅砧声出洞房。\n带月影疏燕塞柳，随风飘落蓟门霜。\n愁看烽火音书绝，欲寄关山道路长。\n不信去时闱已缓，试凭宵梦到辽阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同宫允弟侍御弟游西樵","author":"区大枢","text":"圭组岂必厌，烟霞兴自浓。\n西樵一片石，待我三人踪。\n往攀南山桂，来倚东溪松。\n菖蒲何烂漫，鹤蕊复蒙茸。\n隐雾随玄豹，行天策玉龙。\n倘从茅氏后，还冀匡君逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲冬阅武","author":"区大枢","text":"习战乘冬仲，临场谬阅师。\n威伸先号令，武奋选雄奇。\n猛士缨胡曼，材官服汉仪。\n六钧弓并彀，七扎铠齐披。\n霜雪明戈戟，风雷飏帜旗。\n队分鱼鸟阵，屯列虎熊麾。\n朱鹭声阗震，紫骝光骤驰。\n白猿腾妙伎，红鹄破玄思。\n曲直徒虽布，方圆表屡移。\n容门开地水，守险翼城池。\n摝铎前茅往，鸣铙后纛随。\n旌优宁泯灭，罚劣岂参差。\n日落千山暮，烟飘万壑飔。\n啼乌归壁垒，皓月照营陲。\n二卫疆边楚，三苗坏属夷。\n不虞须有戒，无事固应持。\n俎豆曾闻矣，韬钤近与而。\n谁云兵可偃，未雨咏周诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春柳","author":"区大枢","text":"园柳正春荑，俄看叶已齐。\n迎风为浪弱，带雨逐人低。\n望远枝堪折，飘空絮欲迷。\n愁将千缕结，思向万条睽。\n露浥青郊陌，烟沉绿水堤。\n妆台临镜画，绣阁拂帘跻。\n弄影娇莺啭，垂阴过马嘶。\n依依怀往路，郁郁想中闺。\n征客归来见，那堪作别啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏繁华","author":"区大枢","text":"旭日丽容光，春风发艳香。\n问年方小史，媲貌胜龙阳。\n铅粉冰肌白，金丸柘弹黄。\n锦屏开玉镜，绣被覆牙床。\n宠至乘堪矫，怜深袖可忘。\n燕姬翻见妒，郑女自空伤。\n麝气无重馥，兰菲讵再扬。\n预愁桃李节，衰落在芬芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渡京口江望金山寺","author":"区大枢","text":"宝筏京江渡，灵峰旦鹫来。\n惊涛潆石下，飞塔荡空回。\n水面分天堑，波心结蜃台。\n潮声驱梵铎，海势涤嚣埃。\n吼浪蛟龙息，寻巢鹘隼猜。\n六朝悲散漫，万劫仰崔嵬。\n击楫频年误，迷津此日开。\n临观虽未暇，心赏已悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻飞来古寺","author":"区大枢","text":"香刹出诸天，扳跻磴道缘。\n松篁蒙岭密，猿狖跃峰联。\n积藓行防踬，垂藤接虑牵。\n林昏疑虎伏，壑静似龙眠。\n孤磬岩间发，明灯树杪然。\n飞腾驱白象，结构拥青莲。\n探讨今辰得，皈依夙愿便。\n晚来催解缆，乘月下江烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食客中作","author":"区大枢","text":"寒食三春已暮天，燕中春景最堪怜。\n林花渐发迎迟日，花柳初新媚早年。\n台上斗鸡还竞长，埒旁走马复争先。\n舞楼按节升鸾屣，歌榭流声入凤弦。\n九陌风香来蹴鞠，四郊云影落鞦韆。\n美人留客欢无极，公子邀宾乐未旋。\n中禁不须传旧火，朱门已自试新烟。\n谁教羁客逢兹日，独抱炎心郁未然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与客约过常公禅房 其一","author":"区大枢","text":"地僻应忘岁月，林幽自足烟霞。\n老僧静披多叶，童子閒扫落花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与客约过常公禅房 其二","author":"区大枢","text":"闭户都无诸染，梦香只有四禅。\n树底谁惊宿鸟，风前共听鸣蝉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与客约过常公禅房 其三","author":"区大枢","text":"终日结跏丈室，六时诵念花龛。\n空馀枥嘶骏马，别有丛发优昙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与客约过常公禅房 其四","author":"区大枢","text":"解带行经竹院，开襟坐傍香台。\n绿砌重披蕙草，黄金偏落秋槐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夷门","author":"区大枢","text":"夷门监者旧藏名，公子邀欢执辔迎。\n上客莫惊虚左遇，报恩谁得似侯嬴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小金山","author":"钟维诚","text":"妙高台上访禅关，翠拥层峦喜胜攀。\n琪树苍苍环郁水，灵洲隐隐见鳌山。\n孤僧林下春芽熟，客子尊前秋露乾。\n醉倚危楼俯沧海，此身疑在五云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别建昌诸父老","author":"蔡存仁","text":"黄花满地竞秋晖，老稚相呼送主归。\n鸡犬可无惊夜月，牛车曾已遍岩扉。\n田家旨否心尤切，辕下攀援忍遽违。\n圣代循良今孔迩，好将忠敬效缁衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与诸寅丈游南溟","author":"蔡存仁","text":"春暮晴云散远空，喜随杖履入蓬宫。\n万家烟火青山合，百尺楼台碧嶂中。\n涧水穿萝归印月，石梁倚汉透灵崇。\n夜来醉罢禽相乐，满袖香风拂落虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钓台","author":"梁鹤鸣","text":"老去逃名何所为，渔蓑常向水云披。\n竿头高挂一轮月，泽畔轻移百丈丝。\n烟雾直寻巢父乐，江湖无复子牟思。\n不知严濑谁能似，十里龙湾九曲池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金洲山","author":"梁鹤鸣","text":"水面孤峰控上游，灵岩怪石列沧洲。\n障回海角千寻浪，劈破江心万里流。\n荡月鱼舠随左右，忘机鸥鸟自沉浮。\n乘舟取醉扪崖上，五岭风烟一望收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晏斋居次黎君醇韵 其一","author":"傅敏功","text":"暮色偏无赖，羁栖旅思深。\n积薪虚岁月，多病欲山林。\n冉冉凄瑶草，悠悠掩素琴。\n所怜松柏意，不受雪霜侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁晏斋居次黎君醇韵 其二","author":"傅敏功","text":"寒林芳卉歇，孤梦白云悬。\n竹色含霜苦，花阴浥露偏。\n霞杯浮月下，吟笛落风前。\n谁问迷津者，幽居自岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游七星岩","author":"傅敏功","text":"虚岩缥缈七星开，入望晴云拥翠来。\n一壑龙门浮日月，千家烟树隐楼台。\n石悬片乳擎珠雨，风送飞花落酒杯。\n不必凌空听凤曲，人间亦自有蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江行用唐人韵","author":"傅敏功","text":"放舸寒江未拟回，千家烟树隐楼台。\n片云红似镜中出，列岫青从峡里来。\n华发漫从游子兴，清尊偏向故人开。\n梅花已报春消息，双屐能忘印绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孙肖延极谈樵山之胜以诗见贻次答","author":"傅敏功","text":"天外群峰障海西，烟花杳杳望应迷。\n洞开一径云侵袂，瀑挂千寻玉作梯。\n荒藓合时留断碣，清尊行处换新题。\n孤村岁晚游人少，木落寒山但鸟啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓寺馆寄怀谢钟吉","author":"傅敏功","text":"忆自南归岁两徂，避喧时复问浮屠。\n春深岩岫云常湿，病卧柴门客渐无。\n笛里梅花虚倚听，愁中竹叶且酣呼。\n怀人千里琪坛夜，梦断湖山片月孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送友人还莆阳","author":"林培","text":"腊月风凄凄，独坐对图史。\n有客叩我门，揖言归故里。\n故里莆之阳，壶山连九鲤。\n主人结茅庐，郁郁溪山里。\n一笑天籁鸣，下笔烟云起。\n养就双羽翰，咫尺云霄拟。\n何以赠君行，汀兰与江芷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闽中除岁恭祀先大夫祠","author":"林培","text":"凛凛岁云暮，独坐嵩山阳。\n雨散忽开霁，山色郁苍苍。\n俯听流泉鸣，仰视飞雁翔。\n悠悠陟岵思，怆然热中肠。\n我父昔宦兹，讲学慕羲皇。\n化被蚩蚩氓，升此大道堂。\n盈盈一水间，弦诵声洋洋。\n宦业未三年，奄忽梦黄粱。\n内顾徒四壁，行道为悲伤。\n青衿思令仪，俎豆青山旁。\n肇禋三十载，庙貌何昂藏。\n我来初奉蒸，骏奔萃冠裳。\n徘徊不忍去，洒扫在堂皇。\n感此岁时心，奠此椒与浆。\n勖哉隆德兴，继序永不忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李飞云","author":"林培","text":"江风烟树两悠悠，有客乘槎上帝州。\n袖里骊珠光自动，匣中龙剑气先浮。\n海横五岭添行色，柳拂三城带别愁。\n郑老青毡元不薄，知君才是古人俦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答林云源","author":"林培","text":"风急岧峣笑整冠，千山木落敝裘寒。\n澄清忆汝能鞭弭，矍铄何人解据鞍。\n梦入蒹葭秋月笛，澜回菡萏雪花滩。\n只今世事纷如许，廊庙何时起吕端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答洪孺成姻家兼呈赵二守","author":"麦应中","text":"短棹先君发，孤飞影自迟。\n遥怜孤客路，独对远山眉。\n错落灯前雨，悲凉别后诗。\n春光随处待，不负蓟门期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"琅琊寺同韩伯仪赋","author":"麦应中","text":"琅琊山色照滁州，乘兴因君次第游。\n揽辔飞泉随马足，开尊明月出峰头。\n诸天上下慈云合，万壑烟岚古树浮。\n欲到穷崖问遗迹，断碑芜没不知秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山行","author":"麦应中","text":"王孙归路草萋萋，落日青山失旧蹊。\n直道未应行不得，鹧鸪何事向人啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蓬亭晚眺","author":"麦应中","text":"杪岁蓬亭道，临流眺夕阴。\n碧云千嶂合，暝色一江深。\n客思催寒棹，乡心折暮砧。\n远天无限意，聊自发长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仲弟用登","author":"麦应中","text":"忆别池塘秋又过，王孙春草竟如何。\n鸰原落日迷芳杜，雁浦西风怨绿莎。\n梦里青山空落泪，愁中白石共谁歌。\n故园好为栽松菊，野兴年来五岳多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集陈辅德候潮亭闻洪孺成出都","author":"麦应中","text":"百尺楼前花欲飞，天涯游子竟谁依。\n春风西北无消息，海色东南有是非。\n白璧此时还按剑，黄河落日易沾衣。\n共言骏骨千金尽，不信骅骝志独违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿冲虚山房","author":"韩鸣凤","text":"挥手谢人世，飘然物外情。\n白云吟处断，丹火意中明。\n扫石卧花影，扣弦和鹤鸣。\n得归招隐地，谁复爱浮名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花村怀东坡","author":"韩鸣凤","text":"天汉桥西雪里村，昔年仙迹到今存。\n峰头白鹤留形影，洞口梅花写梦魂。\n剪碎山云飞锦字，呼来江月坠芳尊。\n青苗有意不归去，啼鸟野花空掩门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙女石","author":"韩鸣凤","text":"云雨烟消石磴香，不随丹阙舞霓裳。\n山云结辔骖黄鹤，崖竹编笙弄紫凰。\n缑馆月寒收别韵，蓝桥花老坠残妆。\n多情宋玉将词赋，巫峡台空枉断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寥阳夜饮","author":"韩鸣鸾","text":"夜饮寥阳殿，明月何娟娟。\n举杯邀明月，形影似相怜。\n酒满月在手，酒尽月还天。\n步月醉欲卧，明月来床前。\n醉时在交欢，醒后各茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤皇谷","author":"韩鸣鸾","text":"凤皇鸣高冈，旷世一见之。\n翻身耀朝日，自顾羽毛奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白水山佛迹岩午坐","author":"韩鸣金","text":"青山白水两依依，尘世何缘得息机。\n题壁久封苔藓字，寻幽新制芰荷衣。\n泉飞素练悬今古，洞隐丹砂有是非。\n安得溪流变春酒，矶头潦倒日亡归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读义马传有感 其一","author":"韩鸣金","text":"救主当年羡的颅，谁知殉主有龙驹。\n哀鸣祇为冤魂诉，立毙还将正气扶。\n伏刃厕桥伤国士，改鞍衢路愧庸驽。\n古来多少捐生事，得似庵前就义无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读义马传有感 其二","author":"韩鸣金","text":"思气操戈世道彝，我观义马实堪悲。\n脊鸰原上哀声急，紫燕茔前只影移。\n隅目忍看流血泪，霜蹄那复逐风驰。\n犬猴忠义传青史，千古骅骝载传奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石洞","author":"韩鸣金","text":"结屋随幽境，真成一洞天。\n寒流听洗耳，怪石坐挥弦。\n客到湖光净，庭空树影悬。\n俗缘怜未了，吟望独遒然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青霞洞","author":"韩鸣金","text":"散步觅丹丘，青霞晚更幽。\n楼居人已远，赋就我还留。\n隔树閒云度，当檐宿雨流。\n登临殊未惬，更欲跨苍虬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孤雁失群歌","author":"袁应文","text":"灯火栖迟共几秋，当时意气凌嵩邱。\n一朝分散成漂梗，我滞南粤君皇州。\n皇州世路当清夷，拔茅连茹汝其时。\n长安卿相多年少，联辔青云勿复疑。\n只今吾年已三十，谈笑风云岂无及。\n几年霜刃掩清光，逢人耻作穷途泣。\n一樽酒酌暮江头，群雁高飞一雁留。\n哀鸣嗥嗥失其侣，众宾对此增离愁。\n烦君努力佐明主，吾将散发弄扁舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过大夷滩","author":"袁应文","text":"舟人热汗如雨翻，十日三过大夷滩。\n有身不为驱王事，孰使奔走于其间。\n滩流湍急滩石顿，屹上知苦真难下。\n惊疾舟师戒之哉，远道之人胡为来。\n过兹险恶途，茫然心悲哀。\n吁嗟大夷及小夷，吼如猛兽胡为之。\n安得凿山五千仞，划汝凶顽为坦夷。\n吾家有溪名温塘，不冲不激且平常。\n任汝两夷自为险，不用拂枕归吾乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度关行","author":"袁应文","text":"长途苦热不肯雨，晨起汗汗已如注。\n仆夫瘁矣行路难，叠嶂连云拥深树。\n其言此是仙霞关，闽浙东西渺蔼间。\n关前鸣锣走父老，问之何事多愁颜。\n答言大旱当炎暑，手摸禾根热于煮。\n山前麻豆眼见焦，高町难望收禾黍。\n官粮私债何所恃，儿饥妻寒难作主。\n记得去年耕熟时，千疮百孔尚难支。\n春才挨过正望夏，夏旱如此将安施。\n县官有命祷龙潭，烈日岂敢辞跻攀。\n路途使君相借问，说尽民情心亦惭。\n吁嗟邂逅止山陬，听尔诉说情何由。\n我来入闽非浪游，受命分念苍生忧。\n古来大暑比酷吏，安得甘霖一夕至。\n洒尔田畴皆活足，更洗征途无暑气。\n珍重父老莫惨悽，圣主中兴方有为。\n天鉴明德兴大化，肯助旱魃施严威。\n慰别父老向前路，溪流切切犹似诉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]