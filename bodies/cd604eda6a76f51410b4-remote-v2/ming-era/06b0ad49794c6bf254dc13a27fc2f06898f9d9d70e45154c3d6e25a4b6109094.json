[{"title":"顾朗生山人以四诗见贻赋答 其二","author":"胡应麟","text":"意气尘埃外，心期梦寐间。\n一尊违白社，十口共青山。\n桂树幽人赋，莲花国士颜。\n倘怀天姥雪，拂石候柴关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顾朗生山人以四诗见贻赋答 其三","author":"胡应麟","text":"极目皋桥客，长歌扣玉壶。\n天藏林屋远，云压洞庭孤。\n卜筑仍三径，浮家任五湖。\n试探吴市女，能识姓名无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顾朗生山人以四诗见贻赋答 其四","author":"胡应麟","text":"不谓菰芦畔，频年见伟人。\n高天容荷锸，大海傍垂纶。\n一壑心长恋，千秋业未贫。\n异时双剑合，谁谓白头新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄谢宗伯何公四首 其一","author":"胡应麟","text":"十载瞻台座，三春佐秩宗。\n文章空左马，礼乐擅夔龙。\n邺下才偏盛，河南誉日崇。\n殷勤大玄草，犹记昔相从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄谢宗伯何公四首 其二","author":"胡应麟","text":"灿烂遗编在，峥嵘大雅留。\n黄河龙马出，紫阁凤凰游。\n李薛年谁少，徐边誉岂俦。\n不辞扳逸驾，世业在瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄谢宗伯何公四首 其三","author":"胡应麟","text":"少日游金马，平生近玉宸。\n中天回雨露，绝域望星辰。\n咳唾千秋迥，吹嘘万象春。\n惭无杜陵句，池上赞丝纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄谢宗伯何公四首 其四","author":"胡应麟","text":"尚忆梅花下，飞觞醉玉堂。\n先春大庾月，达曙广陵霜。\n鬓惜年来短，情偏别后长。\n绨袍今古泪，寂寞洒沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒食夜集邦相署中分韵得吟字","author":"胡应麟","text":"荏苒逢佳节，招携见苦吟。\n乾坤双剑色，湖海一麾心。\n柳密陶公署，花閒宓子琴。\n兰陵今夜月，百里为谁深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又得卮字","author":"胡应麟","text":"万古山城畔，风流见此时。\n署元方朔隐，亭更子云奇。\n片月窥帘下，疏星抱席移。\n袛应双白眼，兀坐把深卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题大司空潘公芝林二首 其一","author":"胡应麟","text":"烨烨钟灵草，青葱发涧阿。\n九光呈玉叶，三秀挺瑶柯。\n滴露滋苔藓，蒸云映薜萝。\n蚤知王佐出，寝殿有兴歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题大司空潘公芝林二首 其二","author":"胡应麟","text":"丹崖藏淑气，白日涌灵葩。\n百本俱擎露，千林竞照霞。\n瑶池仙母住，勾曲羽人誇。\n宁似商山客，成功翌汉家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻裕卿卧病有怀","author":"胡应麟","text":"茆屋何年借，柴扉尽日扃。\n已无人和雪，谁问客为星。\n病骨留东海，雄心付北溟。\n暮云回首处，寂寂万山青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得何仁仲书","author":"胡应麟","text":"旧事燕台下，看花汝亦狂。\n双鸿俄越峤，匹马竟潇湘。\n赋就人千里，书来泪八行。\n向来神女约，早晚到高唐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题元旦早朝卷","author":"胡应麟","text":"玉殿春风起，金门曙色通。\n佩声千柳外，旗影万花中。\n凤历颁群后，鹓行列上公。\n阳春才一曲，拟献大明宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题大阅卷","author":"胡应麟","text":"剑佩中天出，旌旂大漠开。\n风传青海戍，雾捲白登台。\n列阵卢龙动，翻营涿鹿回。\n九边销燧色，横吹莫兴哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜诸子过集","author":"胡应麟","text":"岂是谈玄宅，偏令问字过。\n客当莲社满，人比竹林多。\n霁月流丹嶂，飞星度绛河。\n毋悲秋夕永，散发向藤萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄刘子大金吾","author":"胡应麟","text":"玉禁康侯宠，金吾上将荣。\n潜消三辅侠，坐偃百蛮兵。\n夜月雕弓满，秋霄画戟明。\n共誇游猎暇，时入建安盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀刘观察仲脩","author":"胡应麟","text":"几夜怀高适，当年赋上林。\n高虹流击筑，朗月堕鸣琴。\n客散谁燕社，人归自越吟。\n西山暮楼殿，极目蓟云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄宫詹陈公二首 其一","author":"胡应麟","text":"执戟元中秘，鸣珂更上公。\n云霞流紫殿，日月扈青宫。\n磊落燕台骏，飘零越峤鸿。\n台垣何处切，五夜望寒空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄宫詹陈公二首 其二","author":"胡应麟","text":"建礼抠趋近，延英进读劳。\n露漙金掌重，云敛玉绳高。\n苑树萦朱绂，宫花落彩毫。\n尚思燕市夕，浊酒坐持螯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭康裕卿五首 其一","author":"胡应麟","text":"摇落龙蛇岁，天南坠客星。\n寒灯孤月白，遗冢万山青。\n永闭高人宅，谁题处士铭。\n伤心旧朋辈，十载递凋零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭康裕卿五首 其二","author":"胡应麟","text":"宿草孀妻奠，遗编稚子留。\n山阳愁听笛，剡曲恨回舟。\n九死还初服，三生记旧游。\n踟蹰季札剑，日夜梦东瓯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭康裕卿五首 其三","author":"胡应麟","text":"忽跨辽东鹤，谁瞻蓟北鸿。\n云山藜杖在，天地草堂空。\n陇树经时碧，原花著处红。\n终令石门谷，千古号愚公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭康裕卿五首 其四","author":"胡应麟","text":"漂泊南游日，峥嵘北上年。\n狂名悬楚越，侠气动幽燕。\n大雪行歌外，长虹击筑前。\n向来携手客，老泪尽江天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭康裕卿五首 其五","author":"胡应麟","text":"垂髫游洛邑，识面记燕城。\n问赋惊文考，投诗谒正平。\n大鹏犹宿契，老骥忽悲鸣。\n地下梁鸿在，应酬碣石盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日送人之彭城","author":"胡应麟","text":"柴门乔木下，送汝一含杯。\n大泽秋声早，长河曙色开。\n阴风韩信庙，紫雾汉王台。\n后夜芒山气，谁寻吊古才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为邦相题蕉石图图","author":"胡应麟","text":"寒蕉依怪石，仙液贮铜瓶。\n日夜孤根老，冬春片叶青。\n风疑摇凤尾，雨欲化龙形。\n恍对张勾曲，星冠坐草亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王长公寄惠集序赋谢四首 其一","author":"胡应麟","text":"字字风霜色，缄题向草庐。\n百年双涕泪，万古一吹嘘。\n附骥名难尽，屠龙业未虚。\n异时歌九辨，宁敢忘三闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王长公寄惠集序赋谢四首 其二","author":"胡应麟","text":"漶灭书生刺，迢遥国士恩。\n片言犹海峤，三赋已乾坤。\n道岂中原丧，交宁异代论。\n尚拚双鬓在，垂白子云门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王长公寄惠集序赋谢四首 其三","author":"胡应麟","text":"家学三王上，时名二李前。\n江河趋大壑，日月并高天。\n业已回长夜，名犹借少年。\n代兴聊一钵，默默少林传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王长公寄惠集序赋谢四首 其四","author":"胡应麟","text":"刻鹄纷难辨，鸣蛩独见知。\n左迁元命世，扬马快同时。\n一字人堪老，千秋客自迟。\n会携孤剑色，东海傍要离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送金大参入滇","author":"胡应麟","text":"除目下枫宸，飞旌动去尘。\n共看金马客，遥问碧鸡神。\n草色穷南服，花香梦北辰。\n到时薇省宴，犹记六桥春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄董太史二首 其一","author":"胡应麟","text":"作赋俱青鬓，携书共赤墀。\n我怀三秀草，君夺万年枝。\n鸾鹤甘泉殿，鱼龙太液池。\n当年六桥柳，能记共含卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄董太史二首 其二","author":"胡应麟","text":"世事甘余拙，时才羡尔长。\n读书同左史，执戟异东方。\n雾拥金门色，天回玉陛香。\n深惭潞河鲤，万里到沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人之黔中","author":"胡应麟","text":"匹马冲寒雾，孤城问瘴烟。\n花深罗鬼地，箐密夜郎天。\n野戍传诸葛，丛祠赛谪仙。\n五溪相望处，白日坠飞鸢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人游边","author":"胡应麟","text":"严冬武林驿，一骑问京华。\n大野霜飘树，长城雪作花。\n櫜鞬迎属国，剑佩逐轻车。\n早夺天山地，铭功入汉家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题东皋园亭卷","author":"胡应麟","text":"近卜东皋墅，推窗面面山。\n榻悬双树底，亭锁万花间。\n白鹤回孤啸，苍龙问大还。\n异时丛桂发，尊酒定同攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张山人楚游","author":"胡应麟","text":"岩穴凭谁问，飘然赋远游。\n风高云梦笛，月满洞庭舟。\n短刺携孤客，长裾狎五侯。\n蛾眉亭下泊，饱看荻花秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南屏逢沈李二生谈道因约余游天台口号戏赠（）","author":"胡应麟","text":"越国奇男子，吴中伟丈夫。\n游心出蓬艾，把臂入菰芦。\n龙虎蟠金鼎，鸳鸯语玉壶。\n天台八万丈，指点向虚无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集李景颖出土瓜佐酒成赋二章 其一","author":"胡应麟","text":"司理耽奇甚，甘瓜荐味长。\n飞霜匀玉质，重露浥琼浆。\n碧荔唐宫重，丹桃汉殿祥。\n何烦方朔盗，袍袖溢芬芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集李景颖出土瓜佐酒成赋二章 其二 赠孙国梁","author":"胡应麟","text":"谈玄吾不厌，问字尔相寻。\n兴逸飞流赋，情高漱石吟。\n春郊联玉勒，夜阁拥瑶琴。\n二仲翩翩在，何烦觅向禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题性天真孝卷","author":"胡应麟","text":"焚香星月下，一脔冀亲延。\n讵意挥刀日，才同扇枕年。\n孤诚回大造，至性彻重泉。\n莫以昌黎论，雌黄孺子贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潘翁九秩诗为望之茂才作","author":"胡应麟","text":"玉醴汎蓬池，琼枝焕陆离。\n玄纁迟伏胜，带索异荣期。\n种橘盈千顷，栽花但一篱。\n不知柯几烂，犹阅洞中棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题中丞滕公武夷精舍图","author":"胡应麟","text":"精庐聊十尺，坐啸建溪湄。\n暂挂中丞笏，閒挥太傅棋。\n野花苍鹿献，林果白猿持。\n惆怅流风逝，徒瞻大树遗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李内翰入都","author":"胡应麟","text":"一骑冲寒发，梅花照客颜。\n乱云扬子渡，残雪皖公山。\n旧直青绫被，新恩白玉环。\n夜来前席梦，光到紫宸班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李允达二首 其一","author":"胡应麟","text":"底事翩翩客，长怀落落愁。\n骥心犹五夜，鸡肋已三秋。\n犊敝相如裤，貂残季子裘。\n长门售何日，少妇绕机愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李允达二首 其二","author":"胡应麟","text":"失意真怜汝，沾衣向薜萝。\n屠龙人未识，买骏客频过。\n投笔徒为尔，焚舟竟若何。\n千秋吾道在，异日较谁多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴郡金公应照令吾邑凡后先六载清风卓操绝代无伦黉士慕其遗爱将举祀名宦不佞恭窃门下敬赋二章 其一","author":"胡应麟","text":"当年武城令，故国近三吴。\n睿识悬冰鉴，清标瑩玉壶。\n琴遗何处鹤，舄化异时凫。\n磊落循良传，千秋更有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴郡金公应照令吾邑凡后先六载清风卓操绝代无伦黉士慕其遗爱将举祀名宦不佞恭窃门下敬赋二章 其二","author":"胡应麟","text":"素丝传苦节，彩笔擅瑶华。\n彭泽门藏柳，河阳县带花。\n云霄馀宦辙，江汉逝仙查。\n寂寂谈玄者，空悲隔绛纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜宿黄季主对奕决赌金伯韶为点筹酣饮达曙题壁间","author":"胡应麟","text":"念汝能悬榻，令余忘忆家。\n香凝燕邸雾，烛袅汉宫霞。\n仄径眠孤鹤，虚檐集乱鸦。\n今宵橘中卧，极乐在天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送僧还赤城","author":"胡应麟","text":"春游秦苑外，夏返越台傍。\n片石幽期远，千峰别梦长。\n危杉饥鹘堕，古柏病猿藏。\n问讯寒山子，题诗遍佛堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿狄明叔园亭二首 其一","author":"胡应麟","text":"閒来种瓜墅，门巷半垂藤。\n石室藏金匮，星台控玉绳。\n茶招阳羡客，饭供雪山僧。\n下榻余将卧，清宵话大乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿狄明叔园亭二首 其二","author":"胡应麟","text":"自是词人社，虚疑上将坛。\n清香浮画戟，异味荐雕盘。\n五色瓜萦砌，千株橘绕阑。\n黄梁炊渐熟，饱饭话邯郸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再过狄明叔园","author":"胡应麟","text":"咫尺将军第，重来日未衙。\n径添何氏竹，畦蔓邵侯瓜。\n曲榭微生月，层楼半纳霞。\n一枰堪度世，何地更吾家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐廉访之虔州","author":"胡应麟","text":"为羡虔州路，依然借寇行。\n关西群吏送，岭北大僚迎。\n日拥雕戈艳，霞飘画毂明。\n五羊天咫尺，高眺粤王城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"破山寺老衲夜谈作","author":"胡应麟","text":"一径入苍翠，飞云袅袅屯。\n危亭标木末，古刹翳松根。\n海月时窥牖，山风日扫门。\n凭呼野衲至，信宿共芳樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过张伯起幼于园中二君各出小影索余题即席赋二首 其一 伯起","author":"胡应麟","text":"乾坤长啸客，林壑自由身。\n蚤辟东山墅，閒垂北海纶。\n新声传子夜，丽管握阳春。\n我亦思逃世，貂裘再敝秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过张伯起幼于园中二君各出小影索余题即席赋二首 其二 幼于","author":"胡应麟","text":"何年醉玉京，谪籍下蓬瀛。\n方外唐徵士，江东晋步兵。\n鹖冠云气入，龙剑雪花明。\n异日投竿去，毋令帝座惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次瓜步张别驾留酌署中","author":"胡应麟","text":"栏杆明月下，萝薜暮纷纷。\n翠杓调甘露，香厨供彩云。\n含毫春半入，剪烛夜平分。\n更喜朝来约，三山跨鹤群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日游大慈岩作","author":"胡应麟","text":"薄暮肩舆到，归樵处处逢。\n万寻开峭壁，千级上危峰。\n树杪禅关出，萝阴梵刹重。\n何当专一壑，绝顶卧长松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"姬人有从行岩上者蹻捷之甚戏赠此诗","author":"胡应麟","text":"偶逐天台客，桃花照玉颜。\n绣裙时绾雾，罗袜惯登山。\n岭月生眉黛，峰云动髻鬟。\n不因刘阮至，那得共追攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题祝无殊栖云轩","author":"胡应麟","text":"小筑兰阴下，幽居瀫水濆。\n八窗全受月，一榻袛栖云。\n竹杖占龙气，蒲团卧鹿群。\n何人日携酒，相对草玄文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽吴封翁四章 其一","author":"胡应麟","text":"阀阅崇三世，丝纶贲九重。\n行高黄叔度，名重郭林宗。\n茂苑新枫落，苏台宿草茸。\n异时双庑下，谁问伯鸾舂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽吴封翁四章 其二","author":"胡应麟","text":"高踪悬石户，古行郁泉台。\n海月长鲸去，天风大鸟来。\n河南传治行，邺下绍词才。\n世泽今何限，无烦叹草莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽吴封翁四章 其三","author":"胡应麟","text":"剑色丰城閟，书香茂苑长。\n题铭符季子，树碣副中郎。\n阁翳新玄草，斋繁旧白杨。\n明珠遗集远，光照玉涵堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽吴封翁四章 其四","author":"胡应麟","text":"绿野承先世，苍生付象贤。\n恩波填越海，涕泪咽吴天。\n薤露丹旌外，松风素旐前。\n袛应门下客，长废蓼莪篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送僧游越东","author":"胡应麟","text":"穷年持戒律，行脚遍蒿莱。\n碧海浮杯度，青山蹑屩来。\n天台方广寺，雪窦妙高台。\n匣底兰亭帖，相传自辩才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘广文擢北司马诗送之","author":"胡应麟","text":"汉殿移官入，燕台谒帝行。\n敦诗元郤縠，议礼旧荀卿。\n海国朝霞丽，江城霁雪明。\n题书频寄忆，翘首北鸿征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]