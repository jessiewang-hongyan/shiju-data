[{"title":"阴那祖师手植柏","author":"李以贞","text":"风霜不折参天枝，兵火难烧溜雨皮。\n长向莲台乞古佛，年年甘露洒慈悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶吟","author":"李以贞","text":"时逢离乱学樵渔，身在逃名只读书。\n几日沉吟门懒出，也教猿鹤见人疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漫兴","author":"李以贞","text":"儿曹朗朗读书声，少妇传梭轧轧鸣。\n我有会心都閟响，托将秋月一天清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海月","author":"易训","text":"海门人坐夜三更，万里潮来月又生。\n历乱江山还共照，微茫天地渐分明。\n珠光水荡鱼龙窟，野旷风摇雁鹜声。\n便欲乘槎穷绝岛，南溟秋望不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"坡山别业","author":"易训","text":"荒山风味澹，颇惬野人居。\n素食荐薇蕨，高眠枕道书。\n絺衣轻夏末，绛叶随晴初。\n久已辞车躅，门前草懒锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送一公还山","author":"易训","text":"师今何处去，相送出林间。\n一路随芳草，寻钟归旧山。\n猿声深涧冷，云影上方閒。\n后夜如相忆，松门且莫关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"兴陵","author":"易训","text":"白云漠漠覆层峦，独上荒陵掩泪看。\n抔土未乾人盗去，寝园无主火烧残。\n回肠暗应猿声断，落日愁添垄色寒。\n惆怅西郊寒食节，春风谁与荐芳兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夕怀陈四","author":"易训","text":"雨馀山色易黄昏，入望无穷是海云。\n一院落花才别我，半林新月未逢君。\n浅深萤影愁中见，断续虫声夜后闻。\n遥忆空江寥寂甚，陶然应狎白鸥群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟夜","author":"黄居石","text":"雨遏云痕重，江宽暑气消。\n橹摇乡梦破，风送客心遥。\n仄岭衔山月，轻帆顺去潮。\n蓬窗间独倚，虚度可怜宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"日映苍松图","author":"黄居石","text":"谁写虬松迥出尘，朝阳晴映晓云新。\n千寻干耸三冬色，半亩阴凝一洞春。\n阆苑风高侵鹤梦，蓝田霜冷老龙鳞。\n旁依玉树茏葱美，异日荣封莫问秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋雨","author":"黄居石","text":"疏帘飒飒似潇湘，入望云山忽渺茫。\n芦荻响寒喧隔岸，芙蓉香老湿横塘。\n潜供晓睡过僧院，暗送秋怀上客床。\n四野沉溟重九近，东篱愁杀御衣黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清凉台","author":"黄居石","text":"清凉台畔怯登临，金谷园荒野色侵。\n风曳舞衣云尽散，露寒歌扇月空沉。\n千年艳骨埋秋藓，一片香魂泣暮林。\n莫道娉婷容易死，明珠难买坠楼心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花","author":"黄居石","text":"小小村旁曲曲川，半株奇特倚孤烟。\n山中隐者形多古，世外佳人骨欲仙。\n疏影晚笼沽酒店，暗香晴落钓鱼船。\n频搔鹤发閒看汝，落落春怀又一年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀仙志","author":"赖镜","text":"水月空花见色身，蛾眉鸦鬓总镂尘。\n等閒红袖香销后，元是青莲自在人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江行","author":"赖镜","text":"苍茫云树晚，一舸荻花秋。\n切切虫鸣岸，萧萧月满舟。\n孤怀逾浩渺，病骨却迟留。\n是处山如画，聊为解旅愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浔州道中","author":"赖镜","text":"悠悠千里道，江上复斜曛。\n不恨长为客，空悲老未闻。\n山迷罗叶水，路逐柳城云。\n异境从兹得，乡心早已分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居 其一","author":"赖镜","text":"野老独藜杖，溪边看水流。\n好花开眼底，何事到心头。\n月落柴门晓，露深松径秋。\n东邻有鱼父，梨黍每相留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居 其二","author":"赖镜","text":"山晚云栖屋，林深月满篱。\n数声寒鸟静，一片夜虫悲。\n多病逢人少，长贫愧母慈。\n年侵不可觉，祇有鬓毛知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈牧止游吴","author":"赖镜","text":"片席萧萧带晚烟，暂离亲舍客吴天。\n闲云细护谈经处，远水平浮访戴船。\n白岳泉听春雨后，寒山诗就夜钟前。\n君行到处人争识，肯恋江湖滞岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题李十一新筑","author":"赖镜","text":"小筑依村好，房郎幽处添。\n爱山思垒石，避树却低檐。\n纤草萦衣带，闲枝挂月廉。\n晚凉催煮茗，诗句味陶潜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"失题","author":"赖镜","text":"一尘都不染，能事是昌黎。\n古道人谁到，名山君所跻。\n烽烟今日息，花鸟仲春齐。\n何幸高凉地，连年驻马蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题松色山光图","author":"赖镜","text":"松色山光静翠屏，高居春掩绿萝扃。\n青牛紫气龙为道，编贝悬珠岁是星。\n湖海十年醒旅梦，云霄今日羡鸿冥。\n佳晨共进延年酒，弟劝兄酬殊未停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为李炤生诞日作","author":"赖镜","text":"园林风物转清妍，篱径连朝逗紫烟。\n君遇佳晨偏傲菊，我生之日亦开莲。\n幽香并倚人如玉，醉墨从呼米是颠。\n未信一枝栖便稳，时来风翮善飞骞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄觉长老二首 其一","author":"赖镜","text":"吾师神宇奇，老貌展长眉。\n未熟便留客，禅馀不废诗。\n半畦中岁足，一衲百年披。\n永夜蒲团上，窗虚月浸池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄觉长老二首 其二","author":"赖镜","text":"二十年来别，怀师一夜谈。\n夜餐无别法，冷暖自家谙。\n遥忆经行处，盈盈珠水南。\n手栽松柏子，晚翠影毵毵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别屈翁山次原韵时翁山方赴雁门挈家还里","author":"麦郊","text":"结交怜独早，聚合苦无多。\n日月载愁去，风尘如别何。\n太行无易辙，沧海有回波。\n去去更相勖，此心遑及他。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偕黄耀之潘子霖曾笃卿登金紫峰","author":"张在瑗","text":"夷歌处处唤愁襟，懒向珠林听梵音。\n天地不堪还寄傲，江山何意复登临。\n谁将桂树仍招隐，肯信桃源可重寻。\n且喜一觞时一咏，悠悠天外和龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖山居 其一","author":"叶挺英","text":"地僻故人稀，莓苔多鸟迹。\n文峰耸日边，宝剑横山侧。\n陟屺仰功勋，瞻云思竹帛。\n穷经苦蠹鱼，何日售荆璧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖山居 其二","author":"叶挺英","text":"壑外泉声冷，林间鸟韵幽。\n蝶翻红蓼岸，云涌翠山楼。\n白露千岩碧，黄花一径秋。\n月明何处笛，趁入涧溪流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送澹师还丹霞","author":"叶挺英","text":"半幅清言作意裁，如来藏里示莲胎。\n他生念我空中相，此地逢师劫后灰。\n不分月移罗带水，其如秋到雨花台。\n丹霞欲共閒云去，日夕惊心白发催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄黄泰泉","author":"汤日祥","text":"会日无多别日多，只今无奈老衰何。\n杖藜谁与听莺啭，尺素空题托雁过。\n天遣象城来画辖，月临牛海动烟蓑。\n僻门深巷时时闭，愧负邻翁为剪萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"紫水渔舟","author":"高曰琏","text":"数间茅屋闻溪芷，散发渔翁卧居此。\n日暮钓舟自往还，云白山青水光紫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝月台避暑晚归","author":"区绅","text":"郭外林深爽气催，凌云楼阁八窗开。\n振衣高御风生腋，卷幔宽迎月上台。\n古树荫连堤畔色，疏星影动汉边回。\n三更分我雠书处，露滴松梢落茗杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"失题 其一","author":"韩宗礼","text":"碧山风雨长离忧，湖海烟尘恨未收。\n有客扣镡歌六月，何人击楫渡中流。\n数声鼓角斜阳暮，两地飞鸣鸿雁愁。\n庾信江南哀不断，更堪王粲赋登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"失题 其二","author":"韩宗礼","text":"经旬雷雨蛟龙起，入梦云生虎豹屯。\n四海羽书飞白日，十年戎马跃中原。\n但闻苏武辞金阙，不见班生入玉门。\n紫塞黄榆千万里，沈阳花月欲消魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠黄处士诗","author":"陈伯蕃","text":"峨峨万仞冈，磊磊千寻石。\n泠泠百丈泉，幽幽隐士宅。\n隐士夫如何，逃名而晦迹。\n岂乏英雄姿，矢志在松柏。\n空谷多秋风，须眉一夜白。\n有酒不盈樽，有几不盈尺。\n念无天下士，中怀常愤迫。\n孤虹贯长天，如或见衷赤。\n予自远方来，邂逅快所获。\n相将出白云，相对谈今昔。\n今昔事既殊，怆然起痛惜。\n东山未为大，西山宁为窄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠郑抚夷兄弟平茶山寇","author":"饶希镇","text":"莫诧持干十万雄，火楼巨石一齐攻。\n窜身未得终焚死，砰磕难登二霍功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"北帝宫","author":"刘琚","text":"石门深锁几重重，独叩禅关印北宗。\n拔地三千空下界，离天尺五仰高峰。\n笔花入梦疑飘桂，砚水兴波信有龙。\n漫与山僧留半偈，题诗尚许碧纱笼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"摘星岩","author":"区庚明","text":"芸馆依岩筑，书窗倒壁悬。\n祇应搜绿字，岂是老青毡。\n石畔花铺锦，云头鹤渡仙。\n夜来灯影射，直与斗星连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅月双清","author":"郑韺","text":"君不见铁石枝头灿玉霞，暗花浮动山人家。\n诗翁骑驴问消息，处士养鹤成丹砂。\n又不见蟾蜍踏过清虚府，听彻霓裳羽衣舞。\n琴声错落来西厢，掉影杳落下南浦。\n九重碧落浮清光，万顷连云映疏影。\n乾坤灏气清可人，月下仿佛梅花神。\n姮娥为报东皇信，一枝占断江南春。\n与君秉心同岁寒，春花秋月无情看。\n轩居寂寞夜吟苦，朔风凛凛吹阑干。\n华光道士画无敌，双清写就千金值。\n几回洞府露真传，元恐诗人不曾识。\n驿使传来赠与君，冀君志节超等伦。\n梯云鼎羹世稀有，对此还思效古人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄魏季子翠微山","author":"彭睿埙","text":"闻道桃源可避秦，卜居有地托闲身。\n猿抛野果欺生客，鹿过溪斋狎熟人。\n笋为经冬尝覆雪，柳因种子得留春。\n何时共醉山中酒，见月方知明月旬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村中看红叶作","author":"彭睿埙","text":"树亦令人艳，冬红始见奇。\n叶为诗者色，霜乃画之师。\n知与醉乡近，望将花事疑。\n归□同此况，共赏夕阳迟。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"失题","author":"彭睿埙","text":"芳郊独偃息，高枕咏朝昏。\n送客偶出户，看云或倚门。\n田芜接平野，木落见前村。\n最爱幽居侣，时来共快论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄觉上人","author":"彭睿埙","text":"寺门多种竹，别后几枝斜。\n所见人皆老，何曾春耐华。\n猿抛穿磴果，鸟踏落琴花。\n旧补寒山衲，前年著到家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜罗澹峰司李石湖与黄君简高望公分赋","author":"彭睿埙","text":"晚霞零乱雨初收，露柳风蝉昨夜秋。\n闻说元规偏爱月，肯容王粲赋登楼。\n谁言有策堪经世，不拟将心更养愁。\n何处少年吹玉笛，欲回天地入孤舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送同人周藻思从龚舍人含五太史入都门","author":"彭睿埙","text":"倚天长剑截云孤，盖世雄心半有无。\n醉后剧谈犹激烈，暮年风月属江湖。\n灵岩镌石留黄绢，古碣荒台辨赤乌。\n好把新诗频唱和，新诗声价满皇都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮山","author":"彭睿埙","text":"相传疏凿有奇封，削出江南第几峰。\n寺枕湍流何代月，僧归闲倚汉时松。\n神丁开后无金甲，洪水流来断玉龙。\n却笑山灵浑似梦，天涯常与系萍踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"失题","author":"彭睿埙","text":"石室月既满，青林人未眠。\n带月步溪水，白云长在天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"失题","author":"彭睿埙","text":"别业藏幽胜，苔深人迹稀。\n秋声残叶乱，晚色断烟飞。\n世事看棋局，生涯问钓矶。\n知音有山水，相对共忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自题竹石图","author":"彭睿埙","text":"未见管夫人，妄传其笔势。\n毋令识者看，世间之通弊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将之金陵舟次古虞侯关","author":"余晋祺","text":"如梭舴艋逐仍留，家有慈亲亦远游。\n作客一身轻似燕，依人万事拙如鸠。\n已无税课酬关吏，剩有琴书度素秋。\n遥望金台春尚早，遐心先寄古虞侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其一","author":"王元俸","text":"百年身世似飘蓬，门掩黄花一径通。\n雨过悬崖霜叶坠，雁归沙渚夕阳空。\n閒知有味心难肯，老去悲秋赋转工。\n无限故人头已白，怀思应在月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其二","author":"王元俸","text":"最团圆处是中秋，好月那堪独上楼。\n尘世总经沧海变，烟波仍驻古今愁。\n芙蓉欲绽溪边脸，鬓发还应雪满头。\n笑倚阑干吹铁笛，夕阳惟见水空流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其三","author":"王元俸","text":"庭锁荒芜独夜吟，茂陵扶病卧西林。\n素书千载留孤影，碧落片云生远心。\n水落平沙低度雁，月当高竹见栖禽。\n寒衣处处催刀尺，又听西风一片砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其四","author":"王元俸","text":"日下繁香不自持，红泉翠壁薜萝垂。\n鹤和云影巢高树，蝉曳残声过别枝。\n万古风尘供醉咏，一轩秋雨对僧棋。\n分明更想残宵梦，暗指遥山学画眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其五","author":"王元俸","text":"十里蒹葭雨尽收，坐深河汉傍人流。\n萤低夜色栖瑶草，柳送乡心入酒瓯。\n山石断云迷旧路，石门斜日到林邱。\n芙蓉帐冷孤舟暮，怅望空怜季子裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其六","author":"王元俸","text":"年来踪迹近何如，依旧风尘一客裾。\n江塔眺山青入佛，池荷覆水暖依鱼。\n逢人耻作千金赋，杰阁空藏二酉书。\n世事浮云何足问，起挑残烛独踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其七","author":"王元俸","text":"道似危途动即穷，寂寥谁与此身同。\n三秋落木清霜下，万点流萤秋草中。\n绛叶从朝飞着夜，苍苔因雨却成红。\n往来欲学张奇翰，南渚未明寻钓翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其八","author":"王元俸","text":"每到高斋强展眉，閒身事少只题诗。\n石床扫叶安茶冷，渔浦惊风下钓迟。\n客路远依红树宿，深山长与白云期。\n潸然回顾难消遣，花落月明空所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其九","author":"王元俸","text":"江亭野色静年芳，节序催人昨夜霜。\n秋馆残池荷叶歇，柴门临水稻花香。\n半溪细雨敲寒竹，万里沙鸥弄夕阳。\n取次花丛懒回顾，海天愁思正茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其十","author":"王元俸","text":"重叠愁肠只自知，多情兼与病相宜。\n寒泉泻意琴三尺，花影横窗月一枝。\n为客正当传雁日，前程况是听猿时。\n山行水宿水知远，空向沧江梦所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其十一","author":"王元俸","text":"丘壑偏宜隐者居，萧疏短发映清渠。\n从来裘马饶攀桂，不道山林笑学竽。\n花覆残棋人散后，酒醒孤枕雁来初。\n茫茫归路在何处，空有西风锁敝庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其十二","author":"王元俸","text":"数亩池塘近杜陵，西岩一室映疏藤。\n水声入夜静堪听，山色逢秋始可登。\n松下恋巢寒雨鹤，溪边扫叶夕阳僧。\n尘冠却挂知閒事，移住中峰再上层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其十三","author":"王元俸","text":"山城静土隔尘寰，高敝吟轩近钓湾。\n水露沙头无客泛，春来江上几人还。\n烟波惨淡戎衣满，花鸟微沾岁月閒。\n衰飒不堪频对镜，鬓毛殊改旧时斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其十四","author":"王元俸","text":"年少风流去不回，红颜白发递相催。\n误攻文学身空老，潦倒乾坤酒数杯。\n何处马嘶残麦长，一声蝉送蚤秋来。\n牵情景物堪惆怅，独抱瑶琴扫石台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其十五","author":"王元俸","text":"不知何处写离忧，剑气徒劳望斗牛。\n山色遥连云树晚，溪声凉傍客衣秋。\n情多莫举伤春目，句妙相容隔岁酬。\n故国别来桑柘尽，前程惟有一登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]