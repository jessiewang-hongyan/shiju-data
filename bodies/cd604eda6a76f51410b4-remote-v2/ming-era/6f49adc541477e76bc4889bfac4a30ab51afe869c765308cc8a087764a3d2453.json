[{"title":"郑怡山春和楼","author":"周伦","text":"路断平桥己廿冬，登楼频梦昔遗踪。\n江云绕栋经时薄，山色回春到处浓。\n入户再看新垒燕，隔溪还荫旧栽松。\n晨昏试扣长生诀，门对高谈得易逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28720,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春前一日晴","author":"周伦","text":"历改新年十日赊，春阳今到野人家。\n琼葩著雨当轩放，丝柳含风舞岸斜。\n不语翩翩筵上燕，长开灼灼胜中花。\n西园试笔聊呼酒，川上晴光动日华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28721,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"招王诗人雪塘过小园看梅","author":"周伦","text":"阖闾词客来娄曲，楚楚梅花照碧浔。\n白发素心浑不改，疏枝冻蕊自能禁。\n孤山此日为幽伴，浣水何时听细吟。\n花径东风长日扫，莫愁荒草步难寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28722,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫词","author":"周伦","text":"相唤檐前度，嘤嘤柳外莺。\n寒衣裁未就，忽断剪刀声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28723,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"踏田夜归遇雨","author":"周伦","text":"萧萧禾黍荻芦横，一望湖光廿里程。\n夜半归来眠不得，北窗风雨带秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28724,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访熊道芳不遇","author":"周伦","text":"雨深泥滑马蹄艰，策力行行到馆边。\n深锁绿杨人不见，鹧鸪啼断夕阳天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28725,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题南坦扇画","author":"周伦","text":"天畔松风捲夜涛，朱衣坐看月轮高。\n分明吏隐梅花水，此意凭谁报水曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28726,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蚕","author":"周伦","text":"箧笥开来纸半张，星星万点浴蚕香。\n须臾涌出烟云黑，却问东邻摘稚桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28727,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"莼菜","author":"周伦","text":"无日江湖不梦思，秋风七月是归时。\n何人解得张翰意，百尺柔条送紫丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28728,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荅周秋汀","author":"周伦","text":"老去诗篇字字工，苍头长日送诗筒。\n夜来我亦惊诗梦，声落秋山寺里钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28729,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"悼亡","author":"李承芳","text":"后圃镜如圆，前圃方如席。\n戴畚忘饥劬，擳发免涂泽。\n树株工安排，雁鹜行比立。\n从宦未几时，高柯隐长戟。\n物在乃人亡，食甘惟种核。\n薤露何易晞，春风总无色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28730,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀侍御马君思进","author":"李承芳","text":"蜀道通天上，长安近日边。\n夫君在何处，魂梦苦相连。\n诗句人传道，恩私骨拟镌。\n湖南多旧迹，春草自年年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28731,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄湖广宁湖寺僧原亮","author":"李承芳","text":"心自寒灰者，身犹火宅栖。\n龙眠归钵底，虎负过溪西。\n旧雨禅林在，新松梵宇齐。\n长风递仙呗，出世入岩溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28732,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"閒书用石室韵","author":"李承芳","text":"懒似三眠柳，娇痴吝转腰。\n偶移蹊径步，聊赴野云招。\n卉服染山翠，茶烟抹水消。\n个中多药石，休觅鹿门遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28733,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李攻仪真省父用青莲公江上吟韵","author":"李承芳","text":"百分一棹空琼舟，唱将雏曲江水头。\n蛾眉月光扫半淡，鹢羽风势疾还留。\n子等待成千里骥，叔兮拚作一沙鸥。\n骨透烟霞疑出世，门传组绶积崇邱。\n放笔兴酣摇五岳，佩纫容臭耀中州。\n膝前为答尊翁道，山泉莫合江波流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28734,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"莆田柯容甫遗诗次韵奉答","author":"李承芳","text":"求閒天肯为公赊，尘外翛然别有家。\n卧月静凭仙篆石，吟风缓曳短辕车。\n菊餐篱落和清露，荔熟园林咀绛霞。\n流水慰君应不浅，钓矶旋觉石棱加。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28735,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春雪次息阴韵","author":"李承芳","text":"盈盈端叶倚云开，挟得高寒入地来。\n冰咽桃花浮断涧，风弹柳絮被妆台。\n潇湘雁去恩尤薄，巴蜀波生信不回。\n郢上更谁歌此曲，典君为客独高哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28736,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"石翁寄诗奉和见情","author":"李承芳","text":"仙界诗篇我得歌，苓脂丹鼎斸松萝。\n典刑奇服离尘甚，魂梦长风度海多。\n寺属免归聊复尔，樵夫庭拜尚蹉跎。\n一槎恸哭教焚却，曾涉前年浦口波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28737,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"都堂沈公寄诗白沙示世卿世卿偕余奉和","author":"李承芳","text":"达人不例苦吟人，浑浑唐风转逼真。\n薜荔山村询野逸，芙蓉秋水绘诗神。\n仙台玉笛梅花月，民舍罗纨树色春。\n我赴东吴吟社约，拟从东老结东邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28738,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宪副沈公赐答前韵再重申和","author":"李承芳","text":"山中习静未忘言，响接渔樵野曲喧。\n鹤迹引来寻药径，龙髯香抱种瓜园。\n树阴娱客频蹲石，山色随僧半堕原。\n满户晴云团盖宿，填阶黄叶任风掀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28739,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄天与谢经历","author":"李承芳","text":"玉树晴云倚碧空，谢家高格古今同。\n閒时诗味梅边雪，清世官资柳下风。\n苔衬山光侵屐绿，花流溪曲泛觞红。\n春风不恨江南北，梦渺池塘草色中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28740,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再次陈石翁韵","author":"李承芳","text":"水调歌联孺子歌，红蘅碧杜衬烟萝。\n惟应方寸尘须洗，敢负沧浪水独多。\n僧偈或参温阒寂，道书閒读慰蹉跎。\n沙鸥亦是云烟翼，荡荡青天浸绿波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28741,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"依韵和答雷敏秀才","author":"李承芳","text":"色色烟花染透身，诗家今喜得新邻。\n无机理即堪忘我，不朽名应却累人。\n茶臼敲风松叶响，酒杯邀月竹根陈。\n杜陵吟苦方成圣，百遍推敲莫厌频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28742,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送成都谢掾","author":"李承芳","text":"楚国芙蓉折露妍，赠诗色借蜀江笺。\n文章日事乘槎使，书画虹光上峡船。\n客路山青知己合，公庭水淡足人眠。\n相逢多是云霄贵，犹礼岩泉石榻禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28743,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仙师山祖庄栽田次韵大崖 其一","author":"李承芳","text":"山墅为防栫棘篱，石田攻苦勾茆茨。\n宗公敦实贻谋旧，孙子滋华食报迟。\n髦士固从农子出，白民因感圣王知。\n挥毫亦著扶犁手，击壤狂歌乐不支。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28744,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仙师山祖庄栽田次韵大崖 其二","author":"李承芳","text":"代食独怜禾是宝，祈年众幸稼如茨。\n戴星往驾鸡声早，吟月归鞭马意迟。\n啄拨毕逋资腹饱，唤林布谷属心知。\n宁为若辈赢馀计，聊展先公拜扫支。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28745,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答人","author":"李承芳","text":"家住青山鄂渚东，江楂曾宿虎溪中。\n峰标莲色孤僧致，诗度松声五老风。\n羁旅吟期游汗漫，渔樵懒得话英雄。\n凫鹥既醉波光醁，白石沙边卧老翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28746,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"抱子卿弟长儿赋得鸣皋鹤志喜","author":"李承芳","text":"流憩仙筇昼景迟，庭阶怡盼箨龙儿。\n莺声娇弄春蹊暗，蛟影夷延秋水疑。\n桂出一枝山更媚，蒲成九节石应奇。\n而翁易授精微旨，汝伯诗为远大期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28747,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与成都外郎石天祐","author":"李承芳","text":"黄公山下茆蹊瞑，杜老江干草阁寒。\n蜀客诗名原楚产，涪翁谱迹拟都官。\n游心万里天连水，乘兴孤舟雪涨澜。\n归去上言两知己，济衰应寄九华丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28748,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈先生弟艮山还莆田","author":"李承芳","text":"雁行高翮排黄鹤，鱼岳崇邱借卧龙。\n仙踏秋槐催卷近，神资春草泽诗浓。\n天推行色青相远，云结离情翠且重。\n九万里程惟一日，五千卷牍足三冬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28749,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇画","author":"李承芳","text":"岩石云封道士家，满蹊青桂落寒花。\n山童依帚那能扫，也爱残香醉露华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28750,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林见素致仕寄诗就用奉别","author":"李承芳","text":"黄公山意足逶迤，寄傲婆娑树数枝。\n最是寒风落岩桂，黄金多助瓮头资。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28751,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"县主及诸公因事赴臬还寄意","author":"李承芳","text":"江上歌吟一棹轻，却疑身界狎蓬瀛。\n瑶琴也度梅花调，黄鹤来听月下声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28752,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵寄呈孔公老守","author":"李承芳","text":"曲曲芦湾钓艇轻，红尘浑是隔沧瀛。\n捲芦自制清笳曲，吹入云天落雁声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28753,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"久不得酒","author":"李承芳","text":"夜吟北斗挂檐阴，朝步东篱菊色深。\n叹息黄公山下水，渔人不唱汨罗音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28754,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆大崖","author":"李承芳","text":"摇摇天外剧心旌，鸿雁南飞又北征。\n五岭三湘春草绿，东风宜有杜鹃声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28755,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"到洪山","author":"李承芳","text":"山待情人人故来，柴桑心迹却相猜。\n殷勤嘱付新番雨，为补经行半损苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28756,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"下山","author":"李承芳","text":"一段风情画得来，悠悠道是虎溪回。\n仙人来往仍无迹，笑看僧堂香篆灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28757,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李息阴遗衣以窄复还之诗以见意","author":"李承芳","text":"山云段段映襟裾，城市凡情得扫除。\n回首太颠沧海上，一篇还累退之书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28758,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次大崖韵寄呈严丈人","author":"李承芳","text":"梦里鸦声扑晓阳，枕边流水夜浪浪。\n丝竿一点严滩月，家学渔樵不断香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28759,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和雷敏秀才","author":"李承芳","text":"梦魂化蝶寄流楂，飞绕江蘋漠漠花。\n长笛一声惊忽醒，蛟龙窟畔有人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28760,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"广东徐佥宪朝文寄扇索诗于上次韵奉答","author":"李承芳","text":"何物仙家为我归，珊瑚支瘦玉容肥。\n江天当暑梅花落，漫引寒风白鹤飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28761,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"子卿买田池次韵大崖","author":"李承芳","text":"山下平田田上池，不妨沮溺是吾师。\n缟衣淡月婆娑影，笑领山妻归去时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28762,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黄公山房约会卿不赴","author":"李承芳","text":"放艇黄公山钓台，香风十里芰荷开。\n看云昼倦独眠觉，点点残鸦晚树回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28763,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望会卿值风","author":"李承芳","text":"门前咫尺路行难，骇浪乘风欲荡山。\n宛转肠回如九坂，拟随飞鸟过前湾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28764,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游仙诗","author":"田汝?","text":"瑶池列仙真，俛视凌苍苍。\n下有洪波驰，上有浮云翔。\n飞甍罗赤霄，悬栱拂鸣珰。\n珠箔流素烟，海天照琼浆。\n飘飘弄云霞，袅袅翻霓裳。\n须臾已千祀，邈矣曷能忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28765,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"旅夕醉眠河张口","author":"田汝?","text":"醉脱紫貂裘，高眠酣素秋。\n觉来楹外望，山月挂银钩。\n低头无宝剑，霜花流赤燄。\n为学万人敌，锋铓久韬敛。\n尚父老垂纶，孔明龙卧人。\n一旦师王者，宁复常贱贫。\n我今何偃蹇，薄海意难挽。\n杨朱岐路悲，阮籍穷途返。\n咄咄行路难，行行歌考槃。\n吞声寻赵魏，立马望燕韩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28766,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太白楼宴集","author":"田汝?","text":"沇水流百折，遥将淮泗通。\n凭阑俯澄练，千丈湛长空。\n一线西北来，窈窕入齐东。\n中流连万艇，天际引孤篷。\n秋风忆张翰，把钓想任公。\n共将千里目，遥送两征鸿。\n飘飘归海裔，望望去无穷。\n如何羁旅人，安得羽翼丛。\n乘云访赤松，登天揽六龙。\n为我驻玄发，鍊液美姿容。\n身将黄鹤侣，心与白云从。\n岂能学长卿，犊鼻归临邛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28767,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏怀","author":"田汝?","text":"白云不归山，冉冉落窗牖。\n蛟龙未上天，且在潢污走。\n嗟尔风云徒，本是尘埃叟。\n尚父辞棘津，嚣嚣向渭滨。\n倾城齐拍手，笑杀朝歌人。\n青发照青波，箓竿悬锦鳞。\n一丝引周祚，寸饵钓商辛。\n风期感梦寐，神与文王亲。\n非熊载后车，八百衍经纶。\n革命回天地，宁知属贱贫。\n当年竟不偶，谁信席上珍。\n际会有朝晏，咄嗟伤我神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28768,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜归","author":"田汝?","text":"夜从城市归，儿女欢相依。\n村巷犬争吠，柴门灯火微。\n栖鸡在树枝，牛羊返郊畿。\n禾黍幸登场，非稔亦非饥。\n自兹输官馀，聊足以免饥。\n饥渴不足惜，还喜愿不违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28769,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"紫团山人歌","author":"田汝?","text":"紫团山人并州客，北走燕云南梦泽。\n壮志真翘海岱云，逸思生风追李白。\n迩来访我梁王台，花朝月夜倒金罍。\n凭高醉拟菟园赋，吊古谁怜司马才。\n知君学是子云流，甘泉献赋未蒙收。\n三年独绕荆山哭，四海空持宝剑游。\n弹铗青门聊系马，看花紫陌暂登楼。\n几经笛里关山月，尽是苏卿六国愁。\n五月黄河漭浩浩，扣舷送子伤怀抱。\n白浪龙门倒雪山，黄云碛石连烟草。\n千载论交有孟韩，山高天远忆重欢。\n临岐把袂何为赠，对酒惟歌行路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28770,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫人入道","author":"田汝?","text":"妾身自侍昭阳殿，锦幕云屏朝复晏。\n艳舞云飘绮席香，娇歌声断金壶箭。\n金壶箭涩漏声寒，闷倚?筝不忍弹。\n凤凰钗冷云鬟湿，翡翠罗轻玉骨单。\n红楼紫殿春将暮，卢橘杨梅委墀路。\n玉兔西沈不复东，可怜春色花朝露。\n朝露才晞霜霰濛，梧桐金井落秋风。\n妾身自念非金石，敢望君恩岁岁同。\n君恩自古谁能保，愿请瑶池弄瑶草。\n吸露餐霞学驻颜，青蛾皓齿年年好。\n珠帘绣箔锦云绦，侧想钧天奏玉璈。\n暗解同心鸳帐结，竟随玄圃凤群翱。\n凤翱飞入碧云里，可怜呜咽宫前水。\n宫水东流竟不还，玉阶琪树空连理。\n殷勤再拜嘱宫官，好向宫中奉御欢。\n异日丹成升碧落，尚迎金跸共骖鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28771,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"公子行赠葛长伯东归","author":"田汝?","text":"隋杨凋绿阴，梁菊绽黄金。\n游子朝来返东鲁，况兼鸿雁扬哀音。\n哀音噭噭断河流，齐川公子醉悲秋。\n锦绣山河游北宋，烟花楼阁俯东周。\n公有长才不自衒，异骨崚嶒白玉面。\n六籍胸藏滚巨涛，万言笔扫如惊电。\n朅来结客梁王台，二三子者梁之才。\n朝游五帝三王囿，暮猎齐梁萟苑开。\n天马戏，骕骦騕袅非凡驷。\n麟阁云台貌岂难，蒲梢月国来非易。\n我适高山采药旋，闻君远别神愀然。\n吴钩宝剑耀秋烟，为君沽酒夕阳天，白鼻騧鸣柳丝牵。\n柳丝牵，行且休，阳关三叠遏云流。\n伫看万丈垂丝处，早掣金鳌碧海头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28772,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题鲍氏旧山隐逸卷","author":"田汝?","text":"庐江佳丽都，旧山绝奇胜。\n少小遨游弱冠违，梦回往往云萝径。\n身羁韩魏未还家，汴水梁园乐未涯。\n春色隋堤摇万柳，月明嵩少采三花。\n三花采却觐仙都，松子王乔启秘图。\n神游叠嶂迷三楚，兴绕苍岩瞰五湖。\n花戴紫芝随意折，酒挈银瓶不用沽。\n银瓶醉倒旧山头，苦忆当年憩此邱。\n迂纡萝磴鹿呦呦，窈窕峦光翡翠游。\n烟霞魂梦几时酬，归去倘求云壑侣，与君齐跨二苍虬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28773,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"滨川草堂","author":"田汝?","text":"五月麦秋禾黍高，草堂虚豁对江皋。\n归来不挈东山故，日夕长吟弄彩毫。\n太丘风格本殊调，经纶卷作碧溪钓。\n富贵只将草露看，醉来独倚云松啸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28774,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"圆明寺晓坐","author":"田汝?","text":"晓起净香焚，禅床坐入薰。\n花灯三界寂，钟磬九天闻。\n阶集苔前雨，窗留钵底云。\n迷方如有悟，愿此脱纷纭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28775,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠庄生省觐归江南","author":"田汝?","text":"庄生归省觐，九月下扬州。\n秋水孤帆远，白云天际流。\n岭猿惊客梦，枫叶战乡愁。\n为报南华老，逍遥海上游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28776,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠郁子南归","author":"田汝?","text":"离歌动竹扉，客子振征衣。\n遥忆吴江上，霜清鲈正肥。\n山中三径好，天外片帆归。\n只恐波涛阔，鱼竿拂少微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28777,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登太白酒楼赠别张大","author":"田汝?","text":"楼对群山起，人随世代迁。\n不知千载下，更得几人传。\n孤鹜迷荒泽，哀鸿下浦烟。\n辞君挂席去，淮海弄潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28778,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太白楼赠肖斋呼子孟","author":"田汝?","text":"二豪临眺罢，千古擅风流。\n我辈同登日，江山万里秋。\n风烟淮海色，舟楫故园愁。\n把酒凌倒影，长歌忆旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28779,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南京过旧内 其一","author":"田汝?","text":"寂寞金铺闪，参差玉陛留。\n苑荒梁殿阁，草绿晋山丘。\n圣武归中夏，神功启帝州。\n可怜御河水，呜咽向东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28780,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南京过旧内 其二","author":"田汝?","text":"草创开皇极，雄图近紫微。\n云留三殿锁，水带六朝扉。\n芳草回罗绮，幽花闭禁闱。\n玉阶春欲暮，犹自蝶翻飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28781,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"客有为余远求金字莲华经者作此酬之","author":"田汝?","text":"仙人求梵筴，远致紫金莲。\n潦水明秋日，寒山带夕烟。\n苍松迷阁道，白马度云天。\n归去山堂里，应参佛印禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28782,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寓京元真观酬史大梅","author":"田汝?","text":"二月都门柳，柔条巳拂金。\n相逢述旧事，契阔几传音。\n野寺松窗月，江天竹坞琴。\n向来行乐地，追想意难任。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":28783,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]