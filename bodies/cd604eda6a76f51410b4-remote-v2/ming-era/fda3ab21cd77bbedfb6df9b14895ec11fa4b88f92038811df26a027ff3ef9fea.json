[{"title":"题戴文进莺啭鱼游图 其一","author":"张萱","text":"蒲芽初茁柳丝长，荡漾春波照海棠。\n怪底鱼儿皆出听，枝头日暖奏莺黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题戴文进莺啭鱼游图 其二","author":"张萱","text":"荒林野水纵春寒，出谷潜渊处处安。\n莫道上林春色好，须防香饵与金丸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题无名氏金碧山水 其一","author":"张萱","text":"万仞巑岏浸碧湍，掤罾赌墅对江干。\n撅头船子茅亭客，到底机心总一般。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题无名氏金碧山水 其二","author":"张萱","text":"山静昼长棋一枰，忽闻隔岸卖鱼声。\n祇须沽酒从渔父，莫问枰中绌与赢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题唐伯虎寒山清晓图即用其韵 其一","author":"张萱","text":"凉色溪边嶊万木，晴岚树杪接层霄。\n开帘自觉烟霞满，不用扶藜过石桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题唐伯虎寒山清晓图即用其韵 其二","author":"张萱","text":"青山自是栖黄发，白日虚传步赤霄。\n老我数椽秋色里，便同高宴会虹桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题钱叔宝上方春景图 其一","author":"张萱","text":"上方名刹石湖东，宝马兰桡处处逢。\n曲磴千盘云不锁，春光应在最高峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题钱叔宝上方春景图 其二","author":"张萱","text":"当年吏隐日徜徉，惯逐春风到上方。\n岸柳溪桃应记忆，可能梦里觅刘郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题唐伯虎夜雨重泉图 其一","author":"张萱","text":"四处春雷起蛰龙，群山万壑玉淙淙。\n飞泉一夜添千斛，总为烟鬟洗秀容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题唐伯虎夜雨重泉图 其二","author":"张萱","text":"山南山北雨翻盘，聒耳泉声白昼寒。\n欲向空林较晴雨，扶藜须对晚霞看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题钱叔宝秋瀑图 其一","author":"张萱","text":"天绅百尺挂瑶岑，有客閒携绿绮琴。\n暂向桥边同谛听，不须重按越溪吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题钱叔宝秋瀑图 其二","author":"张萱","text":"绝栈悬崖水激车，白云深处有人家。\n登楼最喜微霜度，染得枫林一树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题周东村山水 其一","author":"张萱","text":"独鹤不舞琴不弹，阶前童子借书还。\n亭幽昼永添香篆，麈尾閒携步曲栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题周东村山水 其二","author":"张萱","text":"碧梧影落碧溪浔，峭壁当亭翠欲淋。\n閒却丝桐有何事，高山流水本希音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题宋初阳松窗读易图 其一","author":"张萱","text":"茅檐竹壁护松枢，独手韦编老自娱。\n悟到先天无一画，为销长日故伊吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题宋初阳松窗读易图 其二","author":"张萱","text":"层峦复嶂倚天开，个个长松手自栽。\n掩卷呼童忙扫径，问奇佳客过桥来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题倪云林筠石乔柯图倪有诗其上即用其韵 其一","author":"张萱","text":"老碧疏松共岁寒，幽怀惟向此君宽。\n萧萧数笔倪元镇，幻出林峦秀可餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题倪云林筠石乔柯图倪有诗其上即用其韵 其二","author":"张萱","text":"山空木落白云寒，咫尺溪山万里宽。\n为忆云林清閟阁，烟霞满纸正堪餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题王孟端墨竹用韵","author":"张萱","text":"风流儒雅帝王珍，墨妙千秋好共论。\n可惜一枝才半副，凤毛麟角总堪存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题文休承折枝梅花图 其一","author":"张萱","text":"东皇着意散琼瑶，管领阳和尔独饶。\n谁折一枝传老笔，却勾春色满冰销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题文休承折枝梅花图 其二","author":"张萱","text":"檀心玉质雪精神，桃李争妍总后尘。\n月下香魂留半影，已知绝代有佳人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题周之冕牡丹双雉图 其一","author":"张萱","text":"绮石崚嶒玉露漙，名花擎出五云团。\n为寻牧犊援琴处，免得三郎带笑看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题周之冕牡丹双雉图 其二","author":"张萱","text":"疆疆须避艾如张，见妒都因锦作裆。\n莫逐骁媒争麦垄，且呼伏雉傍花王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题张元春秋山策蹇图 其一","author":"张萱","text":"数椽高傍碧崔巍，万叠矗云一径开。\n乱石溪边人策蹇，不知何处看山回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题张元春秋山策蹇图 其二","author":"张萱","text":"临流老树影交加，曲磴穿林日欲斜。\n却喜健蹄归路熟，洞门犹未锁烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题董玄宰见赠九岳长青图 其一","author":"张萱","text":"遥闻十岳镇齐州，结发曾期汗漫游。\n却笑白头犹未到，窜身惟在一罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题董玄宰见赠九岳长青图 其二","author":"张萱","text":"披图何事首重搔，为忆名山入梦劳。\n万仞芙蓉青九点，年来紫气为谁高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题董玄宰见赠九岳长青图 其三","author":"张萱","text":"婚嫁犹羁愧向禽，室中惟鼓少文琴。\n众山已觉能相应，何必游踪再讨寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题董玄宰见赠九岳长青图 其四","author":"张萱","text":"当年游兴最飞骞，杖底烟霞已饱餐。\n一壑一丘堪自老，于今九岳即西园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题钱叔宝归渔图 其一","author":"张萱","text":"湖光滉漾岸萦回，隔岸归渔笑语来。\n若得织梭沐挂壁，恐令白日走风雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题钱叔宝归渔图 其二","author":"张萱","text":"渔家茅舍柳阴浓，桥影双双一镜中。\n人已收罾□拽网，想应忙趁鲤鱼风。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题唐伯虎山水 其一","author":"张萱","text":"地僻秋凉客到稀，僧雏何事帚频挥。\n庭空可是云常满，恐傍蒲团冻不飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题唐伯虎山水 其二","author":"张萱","text":"野寺危桥锁碧湍，岑楼僧定白云寒。\n三时礼拜三时扫，莫遣尘根惹讲坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题居士贞仿倪云林小景用士贞及文休承韵 其一 用居韵","author":"张萱","text":"流云绝壁逗微风，万顷烟光淡欲空。\n不为扁舟寻范蠡，生涯原在钓车中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题居士贞仿倪云林小景用士贞及文休承韵 其二 用文韵","author":"张萱","text":"市尘烜赫高千丈，烟水苍茫自一区。\n心地总输孤棹客，清凉不用六壬符。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又题居士贞小景 其一","author":"张萱","text":"秋色满荆扉，白发青山生事微。\n镇日听泉惟兀坐，忘机踪迹人间觉渐稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又题居士贞小景 其二","author":"张萱","text":"黄叶任纷飞，今昔休论是与非。\n童子何来桥半渡，琴归应奏哀蝉送落晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题杨不弃仿倪云林山水 其一","author":"张萱","text":"南宫米颠不复作，此去倪颠能几何。\n我亦有时弄颠笔，不知颠处较谁多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题杨不弃仿倪云林山水 其二","author":"张萱","text":"我谓杨君能芾瓒，君言张史胜阴何。\n老我一生犹见少，如君百辈不为多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题谢樗仙泉石馀清图 其一","author":"张萱","text":"云根礧砢水铿鍧，曾与烟霞共结盟。\n一段秋光浑沁骨，沧浪何必濯尘缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题谢樗仙泉石馀清图 其二","author":"张萱","text":"寒云冉冉抱幽姿，满壑琮琤韵更奇。\n砺齿前来还洗耳，出山须记在山时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题沈启南雄鸡图","author":"张萱","text":"野菊初开秋色鲜，窗间作语已堪怜。\n于今何事噤无语，总为幽人好午眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题沈启南问寝图 其一","author":"张萱","text":"莪蒿露结叶初乾，白首莱衣岁若干。\n此日开图空掩泣，终天无复梦魂安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题沈启南问寝图 其二","author":"张萱","text":"□滴黄垆血未乾，洗牏犹忆跪江干。\n谁怜文隐□□□，满树栖乌不敢安。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁巳三月十一日乘涨过鸿华庵偶成六绝题壁 其一","author":"张萱","text":"梦入鸿华已数年，才来半日即回船。\n蔡纯死后马生老，怪底张奴不悦禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁巳三月十一日乘涨过鸿华庵偶成六绝题壁 其二","author":"张萱","text":"半幅蒲帆一刹那，为乘新涨始经过。\n登楼嘱付降魔杵，莫逐诗魔与酒魔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁巳三月十一日乘涨过鸿华庵偶成六绝题壁 其三","author":"张萱","text":"我头不剃剃心花，六十年来只在家。\n善眼仙人如问我，今年今日到鸿华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁巳三月十一日乘涨过鸿华庵偶成六绝题壁 其四","author":"张萱","text":"狂涛啮断绿榕堤，水没横桥草欲迷。\n我是辟蛇新行者，前林鸠鸟不须啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁巳三月十一日乘涨过鸿华庵偶成六绝题壁 其五","author":"张萱","text":"柴桑久矣攒眉去，康乐犹然合掌来。\n堤断岸崩沙喷雪，昙花休斗浪花开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁巳三月十一日乘涨过鸿华庵偶成六绝题壁 其六","author":"张萱","text":"人人尽醉声闻酒，日日争焚解脱香。\n为问鸿华老庵主，可曾相识转轮王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题宋石门山水","author":"张萱","text":"看山坐石閒挥麈，结伴穿林复抱琴。\n珍重故人千里意，却从天外觅知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五石匏告成用玄真子韵志喜 其一","author":"张萱","text":"万顷烟波一叶飞，春江新涨荻苗肥。\n风满笠，露盈衣，桃花深处问津归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五石匏告成用玄真子韵志喜 其二","author":"张萱","text":"披蓑却笑子陵裘，鼓枻谁同范蠡舟。\n休截浪，莫从流，不须欢喜不须忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五石匏告成用玄真子韵志喜 其三","author":"张萱","text":"绿水青山白发翁，山南山北水西东。\n两枝桨，半帆风，人间何必泣途穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五石匏告成用玄真子韵志喜 其四","author":"张萱","text":"园公何事笑声欢，睡饱才醒饭饱餐。\n鱼又上，网初乾，舟入寒潭不怕寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五石匏告成用玄真子韵志喜 其五","author":"张萱","text":"澄江如练月华圆，枫叶芦花岸岸连。\n才得酒，便开船，遨游今正挟飞仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题沈启南小幅山水 其一","author":"张萱","text":"野情自密世情疏，万壑千崖一草庐。\n永日小楼坐秋色，奇人相对读奇书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题沈启南小幅山水 其二","author":"张萱","text":"柴门秋净树阴疏，肃肃宵征造友庐。\n共向深山无别计，晤言惟有数行书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读两侑丈人说及见和鸿华庵诗却赠 其一","author":"张萱","text":"不烧铅汞不参禅，说到双修便乐天。\n七十耆龄今又八，肉身菩萨地行仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读两侑丈人说及见和鸿华庵诗却赠 其二","author":"张萱","text":"君是诗禅我酒禅，莫论成佛与生天。\n四时诗酒四时共，却被人呼两个仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题吴仲圭墨竹 其一","author":"张萱","text":"梅花道人何太奇，墨戏往往秋淋漓。\n成竹胸中已十丈，萧萧只写两三枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":18901,"sha256":"dc0