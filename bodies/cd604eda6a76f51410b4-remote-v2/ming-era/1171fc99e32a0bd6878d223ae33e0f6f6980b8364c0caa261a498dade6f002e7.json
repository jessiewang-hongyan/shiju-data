[{"title":"金阊访沈嘉则旅馆","author":"黎民表","text":"棠舟并舣越来干，庑下何人识伯鸾。\n买鹤俸钱谁为借，笼鹅经卷手曾刊。\n功名荏苒看双鬓，歧路奔忙误一官。\n紫气东门长不断，罗浮梯阁几回看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日陈使君德基招同李季常饮吕氏园亭得华字","author":"黎民表","text":"秋风有路别京华，犹滞吴江万里槎。\n刻烛共题三径菊，解貂曾对五陵花。\n烟生竹屿深停翠，霜净枫林晚带霞。\n赖有使君能载酒，篮舆来过野人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同陈德基胡进士李季常同集吕心文园亭","author":"黎民表","text":"黄尘车马鬓成斑，三月君能掷印还。\n花下琴尊常迟客，望中云气尚临关。\n休论藜杖携青琐，好去丹砂鍊玉颜。\n万里鸥波元浩荡，可无招隐五湖间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同卓诚甫李季常黄公绍谒林和靖墓","author":"黎民表","text":"封禅无书上汉庭，生平不负北山灵。\n七言丽句传书史，千古清风剩草亭。\n湖上秋风维客棹，山前落日下南屏。\n梅花白鹤无消息，水自潺湲草自青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄潘司空","author":"黎民表","text":"行水司空旧擅名，紫宸飞疏报功成。\n扬旌五岭烽初熄，转粟重溟浪不惊。\n卧治未须论汲黯，传经终是待匡衡。\n扫门无复窥东阁，高倚罗浮梦月卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同李季常泛吴江","author":"黎民表","text":"才名吾敢羡同舟，五岳真成结伴游。\n笠泽菰蒲连楚望，芜城烟月梦扬州。\n江边霞气多成雨，驿路黄花并作秋。\n名姓幸无津吏识，罻罗高鸟至今愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉答李蟠峰司寇","author":"黎民表","text":"玄冕朱衣玉雪颜，黄麻将下已还山。\n千年合应龙沙谶，八座频虚凤阙班。\n谈笑已收黄石略，烽尘不动玉门关。\n江湖犹自干星象，身在芜城紫气间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送喻邦相之任兰溪","author":"黎民表","text":"绝足当时见过都，酒杯相聚复江湖。\n浮生一笑庄周马，光宠仍飞叶县凫。\n城外春流遥似瀫，望中仙峤尽如壶。\n功名更奋青霄翼，不负凌烟阁上图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨懋功同朱巍甫佳甫携酒过览胜楼","author":"黎民表","text":"南浦从来伤别地，高楼吟望更沾襟。\n千门月色渔榔静，午夜风江酒盏深。\n明烛却添游女恨，绝缨谁识楚臣心。\n萧条孺子湖边路，此去朱弦绝赏心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用晦宗侯偕赵脩甫刺史过访","author":"黎民表","text":"病后何人思越吟，江楼尊酒惬追寻。\n王孙丽句能千首，豪客华筵直一金。\n隔岸烽烟邀举扇，西山凉月照披襟。\n文章千古应同调，谁道交情异浅深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"爽台为朱子深宗侯赋","author":"黎民表","text":"梅尉丹崖对面开，更怜花竹夹池栽。\n秋衣夜染星河灿，曙色初浮沆瀣杯。\n黄鹄醉来招不下，紫芝歌罢首重回。\n是非已付浮云外，难忘梁园咏雪才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"唐别驾惟良招同康山人蒋进士集郡斋","author":"黎民表","text":"一下青云路万重，梦回偏忆五陵钟。\n西曹起草名犹在，北阙封书手自慵。\n远道欲归逢暮雨，客愁相对点干峰。\n丹砂此去寻勾漏，江海瑶华不易逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送康裕卿还东瓯时赴唐别驾之招","author":"黎民表","text":"客心残岁两相催，故国东看斗柄回。\n一榻每依僧舍下，五言多向郡斋裁。\n滩声隐坐常惊梦，愁色连天独上台。\n纵有梅花千万树，岂能长铗不归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"豫章逢王敬美入贺","author":"黎民表","text":"龙沙鼓吹引行驺，不作平原十日游。\n下士敢因县榻重，故人宁为解衣留。\n江霞欲变千峰雪，篱菊初残九月秋。\n不是王程虚物色，卿云遥待郢歌酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄曾以三大司马","author":"黎民表","text":"郢中高步有阳春，纳履频年侍紫宸。\n莲座昔为同社客，夷门今愧报恩人。\n中朝礼数优专席，四海升平寄一身。\n莫道云泥今绝隔，梦中犹得拜车尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经曲江寄怀黄清江","author":"黎民表","text":"芙蓉秋色雨中微，几欲寻君始愿违。\n青史待书高士传，沧波终避弋人机。\n心如越鸟还争翥，山是梅花本解飞。\n为报曹溪禅宿在，香林灯火定相依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张肖甫中丞","author":"黎民表","text":"回首风尘洺水杯，感时思旧不堪裁。\n山川险阨曾持节，帷幄畴咨实藉才。\n白首馀生甘伏枥，黄金无梦更登台。\n功名竹帛千年事，惟愿翘贤阁再开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄许石城太常","author":"黎民表","text":"芸阁休论青史在，竹林应未觉途穷。\n中朝月旦谁知己，海内灵光独数公。\n著述尚闻传颂酒，衣冠何地复趋风。\n挥金自是升平乐，却讶新亭事不同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留馀堂为潘司马赋 其一","author":"黎民表","text":"华堂飞敞自留馀，昭代争誇奕叶舒。\n共指王槐呈绿荫，偏令谢树照清居。\n窗开翡翠迎春霭，帘卷烟云洒碧虚。\n自是承家名不忝，韦玄勋誉可谁如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留馀堂为潘司马赋 其二","author":"黎民表","text":"青山曾拟卧龙居，草阁仍留满架书。\n万石家风元独擅，关西经学定谁如。\n鸾书每拜君王赐，锦里重迎使者车。\n丰草崇兰皆雨露，莫言三径不留馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读书堂","author":"黎民表","text":"昔贤曾选幽栖地，小筑还依此洞天。\n二水远从云外落，千山半向槛中悬。\n流霞似护青编古，綵笔犹传白雪鲜。\n未许閒居耽作赋，凤纶先下五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芝林","author":"黎民表","text":"霅水毗山恰耐看，春风仙麓五芝盘。\n瑶光乍散丛氛紫，玉晕初围万叠寒。\n秀缬齐房誇盛美，瑞含商岭协扳欢。\n知君惟有探奇兴，一曲应传和者难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"毗山草堂","author":"黎民表","text":"湖上晴开万卷楼，清时谁解卜菟裘。\n龙溪双练云边合，震泽千帆雨外收。\n抗疏几辞金马诏，题诗多在白蘋洲。\n沧浪纵有乘槎兴，无奈中原正借筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"逢姚山人","author":"黎民表","text":"结客长安兴已孤，寸心元自向吾徒。\n谁从世外传鸿宝，惟羡仙家隐玉壶。\n短褐尚能频说剑，明灯犹忆醉呼卢。\n因君更问华阳事，昔日金笼尚在无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发樟亭寄卓澄甫","author":"黎民表","text":"不为除书始问津，天涯消息断行尘。\n家家爆竹新迎岁，处处邮签转泥人。\n桑苧已收三径纪，綵花虚度五陵春。\n来鸿往燕应相笑，何事狂歌越水滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"唐观察招饮天书道院","author":"黎民表","text":"一出关门马首东，岂知交在片言中。\n浮沈莫问青藜杖，身世行依紫极宫。\n鸣玉昔联南省步，和歌真有郢人风。\n青林铙吹沈沈夜，阮籍何须叹路穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西庄耕云堂新成陈太守同诸子过访用韵 其一","author":"黎民表","text":"三径频来藉碧苔，一区吾岂草玄才。\n旋呼白鹤为童子，笑指春江是绿醅。\n隔岸黄尘休举扇，西山晴色好登台。\n金门错忆浮生事，何似林中酒一杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西庄耕云堂新成陈太守同诸子过访用韵 其二","author":"黎民表","text":"谢家池馆半蒿莱，话旧重斟竹下杯。\n渔艇夜随双涧入，荜门晴向五峰开。\n求田计总输秦客，张乐人犹指汉台。\n不是北山迷出处，烦君骑马到苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谷隐亭为郑明府作","author":"黎民表","text":"三径初开倚少城，万花中带一池清。\n传家本擅司农学，避世谁沽谷口名。\n壁上苔生閒钓具，竹间星乱有棋枰。\n莫言神武抽簪早，自是蓬蒿少送迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送梁孔适诣阙","author":"黎民表","text":"津亭过雨散炎埃，画舫青帘薄暮开。\n太史定占凫舄至，清时争待鹤书来。\n螭坳对奏迟高步，龙井经游想骏才。\n曾是竹林琴酒客，能无垂白望燕台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赵太史招游浮丘山 其一","author":"黎民表","text":"委佩朝来出汉宫，暂将踪迹托冥鸿。\n扫门曾识登龙客，采药今为负局翁。\n岭外素琴随一鹤，斗间文剑化双虹。\n周南不用嗟留滞，矫首燕台气郁葱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赵太史招游浮丘山 其二","author":"黎民表","text":"解印南归问五湖，昔游风月未曾孤。\n閒携天禄青藜杖，来坐仙人白玉壶。\n碧海蓬莱今又浅，丹砂勾漏岂全无。\n前身恐是浮丘伯，胜事重逢蒋大夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游浮丘移酌心远亭次陈公载韵","author":"黎民表","text":"郭外名山卜筑新，草堂花径亦相邻。\n三休竟老王官谷，四皓虚称汉室臣。\n金液方中迷日月，桔槔机上偃丝纶。\n五龙莫更誇高卧，恐有徵书到隐沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少参漆公太史赵公过浮丘 其一","author":"黎民表","text":"负郭初开一径荒，丹丘云气尚微茫。\n松间更有潮通井，坛畔谁知石化羊。\n太史探书经禹穴，群公持斧靖炎方。\n疏才幸际升平日，不逐青螺去故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少参漆公太史赵公过浮丘 其二","author":"黎民表","text":"阁道丹梯驾泬寥，青松飞盖影相交。\n尊前共揽苍精佩，花下同趋绛节朝。\n紫气关门仍不散，赤松天路肯相邀。\n楼船已息重溟浪，策杖何时过野桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邓君肃陈亮夫任夫林开先诸子招饮水竹居","author":"黎民表","text":"夜来新水到柴扉，鸣雨空阶滴渐微。\n词客清尊开别墅，佳人纨扇画双飞。\n沙边宿鸟闻歌起，江上征帆入暮归。\n车马长安尘似海，不如乘醉卧渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄余德甫观察","author":"黎民表","text":"不向清时滞一官，青山绕屋薜萝寒。\n蔬盘菜妇能供给，玄草诸生许借看。\n交态人今多侧目，赋才君莫羡登坛。\n长途洒泪非儿女，秪恐梅花驿路难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄贞湖瀑泉兼简少玄默庵","author":"黎民表","text":"片帆南去过轻鸿，百里龙沙一瞬中。\n别后有心如白水，尊前无树不丹枫。\n浪游岂为营金橐，罢秩何人丐玉龙。\n一夜西堂应有赋，扁舟明月赏心同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日赵太史招集浮丘听笙亭同祁羡仲邓德咸林开先三孝廉赋得山字","author":"黎民表","text":"持节初营海上山，金银楼阁出人间。\n仙衣七日乘风下，玉管双飞载月还。\n浊酒休论身外事，丹砂能驻镜中颜。\n采真恰遇瑶台客，后夜云车未可扳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿黄明府六十一","author":"黎民表","text":"三径归来际盛时，长生仙箓此初披。\n尊前起舞多琼树，林下徵歌半紫芝。\n蕉鹿休论循史传，柴桑常赴野人期。\n五羊城下春如海，遥指蓬莱问楫师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东莞杨明府义叔诞日","author":"黎民表","text":"星轺计日赴燕台，青鸟衔书海上来。\n三礼才名高鼎甲，专城风采映中台。\n璇房花发鸣琴处，瑶水春深献寿杯。\n白首文园深属望，殿东持橐待雄裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送少参漆公还朝","author":"黎民表","text":"霜清木叶下庾关，却指金茎杳霭间。\n官列琐闱知地重，功收溟海见时艰。\n仙山多暇方联步，宣室无端又召还。\n北阙恩深犹未报，因君长梦紫宸班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送梁贡元北上","author":"黎民表","text":"青袍何事滞蒿莱，雨世谈经有俊才。\n手托骊珠堪自惜，箧携龙剑待谁开。\n游踪暂琐崧台月，客路先探庾岭梅。\n东阁至今犹荐士，明堂三礼待新裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵太史还兰溪","author":"黎民表","text":"朱衣衔命下金銮，到处人倾执法冠。\n瘴海烽烟臣节苦，文园休沐主恩难。\n归装应折梅花去，关吏频将紫气看。\n一榻羲皇清梦醒，依依红日近长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄唐惟良","author":"黎民表","text":"莫道分符不暂閒，五更无吏唤追班。\n尊前岭树连宫阁，门外春涛喷雪山。\n万里身为迁播客，几人名在是非间。\n长杨羽猎还今日，应遣词臣入汉关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十六夜同黄幼章邓德咸林开先饮梁少嘉镜林","author":"黎民表","text":"何事良宵与愿违，林塘春色琐柴扉。\n烟花金谷成寥落，车马长安有是非。\n明月避人深隐雾，绪风无赖更吹衣。\n此身已在云罗外，犹羡冥鸿纵意飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中过浮丘怀太史","author":"黎民表","text":"苍茫佳气望中收，想像仙人驾彩虬。\n独鹤不知春事晚，清溪长共白云流。\n尘途已息庄周马，物外谁追葛令游。\n惆怅王孙归去后，鸬鹚鸂?满汀州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿何明府母八十一","author":"黎民表","text":"海上谁开献寿卮，北堂高宴起参差。\n飞鸾每逐云軿下，舞鹤还同彩袖垂。\n举案岂能忘旧节，弹琴今更有佳儿。\n春风正是芳菲日，开遍桃花第一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王用吾观察之贵竹","author":"黎民表","text":"伏波铜柱早登坛，新命仍加执法冠。\n千里风声传木夹，三年冰雪寄珠官。\n人从益部占星入，雨过碉房倚马看。\n莫道殊方频历试，循良先著御屏端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄陆六亭宪使","author":"黎民表","text":"京洛苍茫揽客裘，风前长啸拂吴钩。\n马卿车骑辞梁苑，杜甫诗情在阆州。\n暮雨几经沽酒肆，江花犹满著书楼。\n杖藜便拟从君去，不恨相逢是故侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"故人李季常汪公干自维扬来访志喜用季常韵 其一","author":"黎民表","text":"中原迢递阻山河，蓬径谁知二仲过。\n江路正怜新涨满，风期遥指白云多。\n尘中旧恨千杯失，箧底新诗几字讹。\n何事冥鸿招不下，肯来千里问烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"故人李季常汪公干自维扬来访志喜用季常韵 其二","author":"黎民表","text":"竹下翻然念友生，炎方应不惮征行。\n帆前韵石盘千磴，海上金银望五城。\n薏苡鍊来堪却老，鹧鸪啼处若为情。\n知君汗漫心无已，肯以羊裘客帝京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郭郡牧还闽中","author":"黎民表","text":"江干经岁罢垂纶，应为罗浮入梦频。\n烽火故园双别泪，莺花千里独吟身。\n长途健步犹存马，末路卑飞总畏人。\n九曲风烟青雀舫，不知何处有迷津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李比部伯任使闽中","author":"黎民表","text":"桂树丛中共酒杯，又逢持节故乡来。\n金闺通籍三株秀，白社题诗八斗才。\n离席暂因歌舞缓，王程争待简书催。\n汉廷不为淮南事，愿播薰弦向九垓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋傅逊之见过小楼","author":"黎民表","text":"短榻疏灯对浊醪，朱弦切切为君操。\n铜龙细咽孤城思，银汉晴翻万里涛。\n鸿雁将归书懒寄，芙蓉销落兴无聊。\n佳人白苧休相怨，共倚南楼看月高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送汪公干还新安","author":"黎民表","text":"天涯双璧喜相投，不为金装万里游。\n丹荔梦回千嶂雨，白鱼归及五湖秋。\n明珠满载鲛人泪，虹月偏随估客舟。\n玉舄未留沧海上，能无悬榻待南州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答李季常新秋寓海西社寄怀","author":"黎民表","text":"策杖初从石室回，暮云相望海西台。\n穿针楼上新停烛，避暑林中共举杯。\n风土橘州差可隐，山川炎峤几能来。\n鸡坛近日无争长，尽道青莲有俊才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七星岩","author":"黎民表","text":"白玉楼中贮列仙，浮来沧海是何年。\n风云半出窗前地，日月双悬袖里天。\n苔杂雨花侵坐榻，涧含春溜入平田。\n轻舟欲采芙蓉去，触散芳湖九点烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉虚宫","author":"黎民表","text":"蓬莱千仞削孤根，玉座遥瞻黑帝尊。\n细草繁花秋滴露，彤云紫雾画当门。\n天河近向怀中泻，鳌极遥从掌上翻。\n知驾麟车何处去，满山凉月啸清猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"流霞岛","author":"黎民表","text":"一径才通鸟道微，千峰元气此中归。\n天倾西北谁曾补，山近蓬莱亦解飞。\n石镜看为阴洞月，紫萝化作白云衣。\n卧龙不省人间事，风雨时来濯钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端州","author":"黎民表","text":"桂岭西来是上游，坚城笳鼓镇雄州。\n将军旧拥楼船下，使者曾乘锦石游。\n短筏半多输竹户，长裾亦有采莲舟。\n风流江汉何如此，不为无鱼叹蒯缑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事","author":"黎民表","text":"姑射仙人玉雪肌，九华天上遇灵妃。\n鍊成金骨能轻举，飞去瑶台竟不归。\n一代词臣争点笔，千年华表定沾衣。\n人间转觉沧桑异，不信乘鸾有是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石室山寄沈纯甫","author":"黎民表","text":"石室经奇久未回，因思许靖向南来。\n刺桐花拥蛮姬醉，白芷歌传逐客哀。\n漓水半黄遥入海，楚山将暮一登台。\n羊何旧好虽能赋，不共流霞竹下杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]