[{"title":"己亥元日寓舍独坐对雨","author":"叶子奇","text":"清坐无憀独客来，一瓶春水自煎茶。\n寒梅几树迎春早，细雨微风看落花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15129,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"复次仲修韵","author":"叶子奇","text":"春风村巷淡如秋，细雨和云点点愁。\n正是别魂招不返，落花流水下溪头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15130,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寨上过重九","author":"叶子奇","text":"客子光阴似水流，西风吹老菊花秋。\n今年不用登高去，人在青山最上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15131,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"壬寅重九","author":"叶子奇","text":"白雁风高落木洲，人间岁月水东流。\n山城又是当吹帽，数点黄花冷淡秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15132,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题张原琛蓬窗","author":"叶子奇","text":"银丝鱼鲙碧芹羹，曾记扁舟越上行。\n今日小轩风味似，满川风雨看云生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15133,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"县舍即事","author":"叶子奇","text":"朝日开衙暮散衙，略无一刻及春华。\n偶过县舍坡陀外，随分春风领菜花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15134,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"岳州歌","author":"叶子奇","text":"绿波晴漾白鼍池，郭外人家有酒旗。\n客思独如杨柳树，春风愁绪万条丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15135,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿白羊湖","author":"叶子奇","text":"客思官程意转迷，湘江南去草萋萋。\n待寻无树人家宿，免得中宵谢豹啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15136,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寓玉清观","author":"叶子奇","text":"径草微微护浅沙，小山丛竹玉清家。\n牵牛延蔓无多碧，点缀秋光一两花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15137,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长沙水陆洲","author":"叶子奇","text":"长沙城西湘水流，客来城下系孤舟。\n隔江几树残杨柳，留与啼乌伴白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15138,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南唐故址","author":"叶子奇","text":"唐主宫垣集暝鸦，垣边几座野人家。\n尚余一片繁华地，宜种红蓝内苑花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15139,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"天岳新居二首 其一","author":"叶子奇","text":"道院僧居相与邻，绿阴门巷不生尘。\n落花飞絮无情绪，只解年年断送春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15140,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"天岳新居二首 其二","author":"叶子奇","text":"茅斋新卜小山东，野竹盘根旧有丛。\n柔绿近抽三两个，便能摇影向春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15141,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初日","author":"许继","text":"扬辉启群阴，升耀昭万象。\n迢遥羲和驭，驾龙复东上。\n海波方照灼，岩霏尽开朗。\n遂令一羽微，飞飞亦求养。\n冥行固云众，谁此悟昏妄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15142,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"澄渊","author":"许继","text":"水色本明照，况此静以深。\n泓澄几千顷，流汞凝玄阴。\n空光碧天合，倒景青山沉。\n默鉴不遗物，至虚宁受侵。\n愿言寄潜玩，湛然契明心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15143,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"遣兴","author":"许继","text":"世道日云降，何人激颓流。\n于时竞靡靡，去古良悠悠。\n鸿鹄有高志，一举横九州。\n藩篱日云广，燕雀方啾啾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15144,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜坐","author":"许继","text":"焚膏继短晷，坐此寒夜深。\n不意片楮间，乃见古人心。\n旷怀浩四海，内视不满襟。\n山空霜月白，猿鹤流清音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15145,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送希直游金华","author":"许继","text":"良会古所惜，光景不可留。\n故人今有行，出门复悠悠。\n晨鸡号远陌，行色满道周。\n恻怆意莫宣，慷慨意难酬。\n愿言力古训，所贵德业优。\n千里从明师，岂徒事远游。\n川原渺何极，仰止在山丘。\n余生学苦晚，贤哲忽我尤。\n顾乏驰骋力，重增离别忧。\n遥遥金华道，逸驾邈难俦。\n瞻望两相失，从君去无由。\n愿为东南风，吹上八咏楼。\n愿为云端月，照彼双溪流。\n君情谅不违，我心复何求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15146,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟远游篇","author":"许继","text":"朝涉沧海水，莫上三神山。\n洪波千万里，扬帆出其间。\n阳侯弄神怪，半空舞层澜。\n载驱龙与螭，复御鱼与鼋。\n万怪共奔逐，百灵相后先。\n潮生秋月白，潮落晓日殷。\n因攀榑桑枝，沐发挂余冠。\n仙人观我食，玉女朝具餐。\n清啸引长望，冰光流素寒。\n飓风夜来息，但见水吞天。\n回望齐州土，窅霭空云烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15147,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重过潘氏隐居","author":"许继","text":"刻诗新篁上，粉节吹幽香。\n密林若广厦，万斛含昼凉。\n阴草涧芳洁，古苔石老苍。\n谅无答清景，咏言示不忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15148,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜宿期王修德不至","author":"许继","text":"城西挂纤月，夜色回春径。\n出门候所思，花露沾衣净。\n悠悠醉馀意，寂寂静中听。\n灯暗清漏初，烦愁乱孤兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15149,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夕书怀","author":"许继","text":"高空生夕凉，秋意入河汉。\n驰云若奔驷，明月隐复见。\n天机感众物，夜色掞深院。\n鸣叶响萧飕，吟虫发清怨。\n追思童稚日，膏火事黄卷。\n抚迹今已非，虑深志亦倦。\n颓波惜迁运，往节阅惊电。\n浩浩古人心，庶于静中见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15150,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"村中晚兴","author":"许继","text":"微吟循清流，长眺际遥缡。\n山秋云气深，野晚日色浅。\n危柯凉似振，时稼熟初偃。\n一念故林居，情随飞鸟远。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15151,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜二首 其一","author":"许继","text":"夕凉满庭户，悄悄林下宿。\n蛩韵连废阶，萤光映深竹。\n虚怀感末事，往节惊瞬目。\n起舞明灯前，驱愁泻醽醁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15152,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜二首 其二","author":"许继","text":"短檠照幽榻，秋气夕逾爽。\n雨止风叶鸣，天清候虫响。\n嗜古思有为，困学愧无长。\n往已来不闻，抚心徒偃仰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15153,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀友","author":"许继","text":"高台多凉风，朔气横莫云。\n黄金与时尽，骏骨为灰尘。\n荒烟走狐兔，落日蔽棘榛。\n感慨百代下，谁是悲歌人。\n平沙漫浩浩，黄流去沄沄。\n远游谅已倦，归踏江南春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15154,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜宿净土寺","author":"许继","text":"山空吹夕风，暑尽生夜凉。\n禅宫极清掞，天籁过虚堂。\n烟钟悄已寂，华月未流光。\n玉绳带银汉，夜色耿穹苍。\n暗汲石崖溜，时闻瑶殿香。\n触景自不寐，卧听金琅榼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15155,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"竹林王氏索题 其四 下岭樵歌","author":"许继","text":"石磴缘苍苍，负薪下层峭。\n歌声相应发，山木闪残照。\n近惊幽谷响，远答清猿啸。\n欸乃江上音，烟波岂同调。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15156,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜归","author":"许继","text":"夜归人已卧，山月犹在户。\n惊鹊翻暗丛，哀鸿响遐渚。\n风虚籁静壑，霜肃气澄宇。\n顾影忽兴怀，孤身在羁旅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15157,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中有怀","author":"许继","text":"入春几晴光，物意转萧涩。\n冰雪寒尚余，云阴昼常集。\n清晨林端望，两目纵所及。\n白水天际浑，青山雨中湿。\n飞来双幽鸟，复向花上立。\n心赏不可同，何以舒怏邑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15158,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪","author":"许继","text":"山花寒不开，庭雪晓还积。\n江南十日春，东风未相识。\n萧条新柳姿，清浅故池色。\n日晏启荆扉，迢迢迟来客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15159,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜坐","author":"许继","text":"雨歇宵影澄，天清月华素。\n空山秋欲来，凉意先在户。\n萧萧林樾风，泫泫幽篁露。\n草虫亦何知，含凄感迟莫。\n深思无与言，美人隔江浦。\n迢迢银汉章，无声自西去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15160,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"结交行","author":"许继","text":"识人人识己，腾口自相誉。\n誉至毁亦随，忧患安能去。\n庞公不入城，孔明拜床下。\n识士不欲多，乃是知人者。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15161,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中夜闻风雨满林明旦即为重九情之所至辄见乎辞","author":"许继","text":"梦觉清夜分，林塘响风雨。\n虚怀怯病枕，展转心自语。\n重阳适兹日，兴感眷时序。\n柔道方汇征，嘉名固宜与。\n嘹嘹冥鸿翔，摵摵凉叶委。\n抚迹徒有悲，抽思谩无绪。\n登高候明发，新寒薄衡宇。\n黄花满山篱，采采怀俦侣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15162,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日登山","author":"许继","text":"处喧久忘静，临旷始怀真。\n步登千仞冈，眷兹九秋辰。\n余滓澄广泽，薄氛散高旻。\n浮空白云远，冠日丹霞新。\n海屿互出没，天峰秀嶙峋。\n清眸穷四遐，逸兴荡八垠。\n兴怀慨前古，一瞬迹已陈。\n无令东篱菊，静笑悲秋人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15163,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨望","author":"许继","text":"萧摵木叶声，惨淡山云愁。\n郊扉度清夏，一雨惊凉秋。\n茆茨望不见，苍莽非旧丘。\n羁情信怏怏，世事良悠悠。\n行人夕已稀，耘者方未休。\n烟深语俦侣，草上驱羊牛。\n畚锸岂不劳，志愿无外求。\n所以沮溺徒，不为尧舜忧。\n岁功叹已矣，慨然怀绿畴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15164,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对雨","author":"许继","text":"沈沈时雨积，冥漠晦平莽。\n卧起人事閒，临轩坐虚敞。\n繁林滴馀润，曲池散清响。\n去家徒有思，出门亦何往。\n山深乱云合，村暝孤烟上。\n飞鸟望不还，空愁结遥想。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15165,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自双溪将还家月夜有怀作","author":"许继","text":"月圆当今夕，客还候明旦。\n天空影自流，道远情犹闲。\n徘徊清辉间，乔木夏阴散。\n凉亭萤暂歇，阴沼蛙方乱。\n匡床寝不寐，病骨劳展转。\n青灯照愁心，幽花为谁灿。\n鸡鸣起促驾，路出烟林畔。\n半生羁旅踪，江山浩兴叹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15166,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"石林道中","author":"许继","text":"客行石林道，还顾望海门。\n日午蜃烟灭，雄涛浩浑浑。\n鱼船集远步，百里腥风昏。\n岸绕野塘色，潮吞沙渚痕。\n危岭过九折，前登畏崩奔。\n鸟啼怨山雨，山深伤客魂。\n旧历宛如昨，夏木今已繁。\n路难欲自慰，沽酒溪前村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15167,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓度范家滩","author":"许继","text":"鱼梁障清湍，水落滩面阔。\n天风石籁秋，数里声聒聒。\n晨涉思揭厉，川广畏难越。\n浦口人不闻，扁舟远如月。\n寒波望空雾，晓岸指毫末。\n新曙野始分，清凉木先脱。\n别离既含戚，遇景聊暂悦。\n初旭转沧溟，彤霞丽云阙。\n回瞻极迢递，凌步多曲折。\n前念青山行，采芝养高节。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15168,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋蛛网落叶","author":"许继","text":"秋气感木叶，故林飘坠时。\n不成栖蔓草，还复缀蛛丝。\n屡舞凉风得，高悬落照宜。\n多情似留恋，可奈已辞枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15169,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自遣","author":"许继","text":"独坐还长眺，高歌祗自听。\n雨中苗尽绿，烟外树重青。\n病久怜形瘦，愁多畏酒醒。\n芙蓉将烂熳，采采忆江汀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15170,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病中作","author":"许继","text":"风雪年将尽，山林客未还。\n消磨尘世事，留得病身闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15171,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梦游庐山歌","author":"胡奎","text":"我有紫霞想，梦游匡庐峰。\n仙人凌绝顶，手掉金芙蓉。\n芙蓉亭亭九天上，叠嶂腾腾涌波浪。\n五色云中白鹿鸣，三更海底金鸡唱。\n悬崖瀑布从天来，匹练倒界青天开。\n高人似是陆脩静，邀我石磴行莓苔。\n九江秀色可揽结，欲跨长鲸捉明月。\n望断蓬莱青鸟书，琪花落尽无人折。\n飞身上挹香炉烟，坐我九叠屏风前。\n翻然拜手招五老，一笑彷佛三千年。\n松风泠泠吹梦觉，鹤背高寒露花落。\n早知此境隔尘凡，只合栖神向丘壑。\n何人写此江上山，云山与我心俱閒。\n明当会碾飙轮去，长谢时人竟不还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15172,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"北上行","author":"胡奎","text":"食蜜不知苦，衣葛不知寒。\n今晨出门去，始知行路难。\n惊飙吹断蓬，沙碛何漫漫。\n羸马缩如猬，霜花大于钱。\n夜涉黄河冻，舟行不得前。\n君肠辘轳转，我肠车轮盘。\n王事有严程，去去勿惮烦。\n弯弧落旄头，飞箭定天山。\n会赋《铙歌》曲，论功万里还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15173,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送徐千户之甘州","author":"胡奎","text":"春寒初试越罗袍，不惜千金买宝刀。\n马援橐中无薏苡，张骞槎上有蒲萄。\n昆崙西去黄河远，函谷东来紫气高。\n何事相逢又相别，陇云边月梦劳劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15174,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江边柳","author":"胡奎","text":"朝送木兰船，暮迎征马鞭。\n非关离别苦，生长在江边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15175,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽员外张士谔 其一","author":"胡奎","text":"二仙坊里张员外，头白相逢只论诗。\n今日过门君不见，小楼春雨燕归迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15176,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题芦雁飞鸣宿食图","author":"胡奎","text":"草草书空不作行，相呼相唤过衡阳。\n芦花月冷应无梦，啄尽寒沙一夜霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15177,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿田家","author":"胡奎","text":"村北村南社鼓声，閒寻父老说升平。\n孤镫也识离人意，落尽寒花却再生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15178,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"墨窗为越人赵撝谦赋","author":"管讷","text":"女娲立极断鳌足，羲画之先无刻木。\n始观鸟迹制文字，夜鬼哭天天雨粟。\n篆隶变化生八分，行草复作何纷纷。\n六书古制既茫昧，载籍况遭秦火焚。\n后之作者不可数，形声寥寥眇千古。\n更论得法神妙间，自信临池心独苦。\n君居于越文献邦，家藏金石书满窗。\n磨穿青州老未已，万斛巨鼎畴能扛。\n吴兴宗人已物故，浙河东西谁独步。\n君今有志继绝学，砥柱中流见孤注。\n剡溪百番冰雪光，玄霜一斗松煤香。\n满堂宾客看挥洒，风雨飒飒龙鸾翔。\n我嗟涂鸦手如棘，屡欲从君问奇画。\n君还许我载酒来，我捧千钟劳君笔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15179,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓起","author":"管讷","text":"真馆晓晴初，官清远尘俗。\n怡然对简编，庶矣忘荣辱。\n遥峰拥归云，高城澹微旭。\n落尽冬青花，江南雨新足。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15180,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"独坐","author":"管讷","text":"独坐茅堂上，长吟不下床。\n乱书堆几席，疏雨过陂塘。\n野燕冲帘入，汀花度水香。\n应须存晚计，次第学耕桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15181,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"发新河次韵","author":"管讷","text":"自忝王门禄，频年此地过。\n秋风回远道，暮雨宿新河。\n白浪鸥边小，青山雁外多。\n客杯相慰藉，一酌总恩波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15182,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓发雷港","author":"管讷","text":"月暗投寒港，天明发晓途。\n鹭应寻宿侣，雁已误更奴。\n霞映沿汀蓼，霜枯倚岸芦。\n彭郎矶尚远，隐隐一山孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15183,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭先师樗隐先生","author":"管讷","text":"痛哭刘夫子，如今隔九泉。\n感恩惟我在，卓行许谁宣。\n汉向犹今系，梁纡复后贤。\n家声俱溢耳，才望孰齐肩。\n百氏遭渔猎，群经费讨研。\n大镛知在序，巨笔信如椽。\n美玉虽居璞，明珠必媚川。\n荐章何恳恳，束帛竟戋戋。\n东壁星辰表，西清雨露边。\n班陪黄阁老，名厕玉堂仙。\n礼乐皆新制，方舆有续编。\n宣麻应内命，行李忽南迁。\n汉节冲蛮雨，黎歌入瘴烟。\n客庖鱼米贱，商舶象犀联。\n省檄官将调，邮书讣遽传。\n龙蛇虽起起，鸾鹤定翩翩。\n有客书铭碣，何人给墓田。\n禺山云若惨，谷水月空圆。\n雨泣悲鹦鹉，风魂托杜鹃。\n哲人其逝矣，小子独凄然。\n膏馥多沾丐，愚蒙赖勉旃。\n斯文因汨没，吾道亦迍邅。\n踵接才虽劣，心丧礼自专。\n每伤酾酹爵，况忍读哀篇。\n感激千愁外，号呼百拜前。\n不知双眼泪，何日断潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15184,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"尹母行","author":"管讷","text":"云间尹母年十七，嫁夫三年夫病卒。\n舅姑在堂儿在褓，自分茕茕守空室。\n家贫何以为生理，纫缝得钱奉甘旨。\n门外春风自往来，寒心一寸如灰死。\n东家议姻张绮筵，西邻通媒续断弦。\n有山可移志不改，冰霜凛凛心逾坚。\n孤儿今年三十五，教养成人应门户。\n舅姑百岁俱寿臧，华榜旌书照乡土。\n九峰三泖清且奇，柏舟泛泛淞之湄。\n吾乡风俗有如此，终古不愧尹母诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15185,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵答朱孟辨见寄","author":"管讷","text":"十日春无一日晴，闭门听雨不胜情。\n江华偏向愁边发，池草多从梦里生。\n西北星摇天不动，东南潮落海如倾。\n却怜臣甫忧时切，夜夜遥瞻北斗城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15186,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宴徐氏楼","author":"管讷","text":"高宴徐家池上楼，座中宾客总风流。\n东城美酒休辞醉，南国佳人自解愁。\n晴日游丝当户落，暖风香篆近帘浮。\n归时不用三公马，短棹春波正满洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15187,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和内兄金士廉清明日答张应辰见过 其一","author":"管讷","text":"雨晴江路少尘沙，有客寻春到水涯。\n风细游丝低著草，日斜归鸟乱穿花。\n青山几处无新冢，乔木何人是故家。\n倩得盘游春髻子，东风日日好将车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15188,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清明感怀二首 其一","author":"管讷","text":"十年宦学楚江滨，老景垂垂上此身。\n插柳忽逢三月节，看花又过二分春。\n青山风雨多新鬼，白发江湖少故人。\n东忆墓田千阜下，可堪回首一沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15189,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过皖城吊余忠宣公","author":"管讷","text":"元戎百战守孤城，千里蚍蜉绝援兵。\n保障有方文且武，简编无愧死犹生。\n神来遗庙乘云气，鬼哭空江杂雨声。\n尚忆李侯并达帅，一时忠义属科名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":15190,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]