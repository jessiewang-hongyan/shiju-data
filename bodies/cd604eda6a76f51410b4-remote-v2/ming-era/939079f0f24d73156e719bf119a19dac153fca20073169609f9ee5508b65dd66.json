[{"title":"壶天八景 其二 松间拨阮","author":"邓林","text":"呼童扫石坐清阴，四缕宫商起月琴。\n流响遏云凝不散，松风琴瑟和馀音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壶天八景 其三 敲冰弄月","author":"邓林","text":"镜池凿破晚冰坚，寒月光摇水底天。\n谁捧玉盘无定准，明珠荡漾不胜圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壶天八景 其四 石上鸣琴","author":"邓林","text":"绿阴何处好鸣弦，玉几天成不假镌。\n山水满怀终一曲，泠泠泻下□石边。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壶天八景 其五 华渚神踪","author":"邓林","text":"试问青冥跨鹤仙，经游华渚是何年。\n风云长护三生石，留得遗踪尚俨然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壶天八景 其六 雕笔仙","author":"邓林","text":"回廊藓笔绣深清，春蚓秋蛇取次行。\n对此令人心好古，煎灯深夜看黄庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壶天八景 其七 深院棋声","author":"邓林","text":"二仙闲坐玉屏开，剥琢声随别院来。\n帘幕重重关不住，瑶阶瑞鹤也惊猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壶天八景 其八 幽林鸟韵","author":"邓林","text":"时禽花底弄芳春，彷佛宫商入调匀。\n啼转长□声渐远，错疑仙乐度青云。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题堂都帅画羊羔","author":"邓林","text":"泽国风霜十九年，子卿和雪啮寒毡。\n疾羝不向斯时乳，令我披图意惨然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马","author":"邓林","text":"濯罢清泠不受羁，圉人鞚上绿杨堤。\n龙媒自是天闲种，留待孙阳一品题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鹿","author":"邓林","text":"采采云根五色芝，高山深谷路逶迤。\n千年苍鹿驯如马，献与仙翁一只骑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"牛","author":"邓林","text":"名园红紫谩多般，争似君家黑牡丹。\n富贵也须知稼穑，此图留与后人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画马送友人还乡","author":"邓林","text":"竹批两耳四蹄霜，冀北群空见一良。\n追电蹑云方有志，肯眠芳草华山阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题春江送别卷","author":"邓林","text":"莺啼燕语瘴江春，为客他乡别故人。\n此景此情相感处，丈夫无泪亦伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜泊南昌二首 其一","author":"邓林","text":"朔风吹雪满貂裘，汗漫天涯学远游。\n万种愁怀无处遣，移舟来近酒家楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜泊南昌二首 其二","author":"邓林","text":"楼上笙歌沸夜阑，楼前帘幕护春寒。\n曲衣聊博一宵醉，慰我齑盐十载酸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题春山枯水图","author":"邓林","text":"昨夜春雷动四遐，纷纷群卉尽萌芽。\n蛰龙也□深渊梦，飞出苍崖露爪牙。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题携琴访友图","author":"邓林","text":"柴门深入洞中开，石路崎岖半是苔。\n料得故人非畏险，独扶藜杖抱琴来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题渊明归来图","author":"邓林","text":"十载驱驰半九寰，热官犹道冷官闲。\n自惭不似休官者，白眼林泉看世间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中","author":"邓林","text":"听尽长更绛腊残，窗纱战破晓风寒。\n婴儿也解怜爷病，时到床前学问安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王上舍使还","author":"邓林","text":"玉骢嘶雨过河桥，鞭袅东风驿路遥。\n旋旆真从天上去，凤凰台下听箫韶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓闲亭","author":"邓林","text":"先生寄傲向林坰，自得湖山物外情。\n闲把考槃歌一阕，松风瑟瑟有馀清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"听泉","author":"邓林","text":"洗耳清泠万虑消，灵台无地著尘嚣。\n此情难与时人说，直欲凌风访子乔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慎友斋二首 其一","author":"邓林","text":"素交难与利交谋，特地开轩慎所求。\n覆雨翻云知几处，长江淡淡只东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慎友斋二首 其二","author":"邓林","text":"弹冠结绶总无心，流水高山一操琴。\n我亦平生轻市道，题诗相与说知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存乐堂二首 其一","author":"邓林","text":"堂上双亲寿且康，堂前兄弟雁排行。\n人生此乐由天致，应是君家世泽长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"存乐堂二首 其二","author":"邓林","text":"玉友金昆奉二亲，一门和气蔼如春。\n升平乐事家家有，谁似君家此乐真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过严子陵钓台二首 其一","author":"邓林","text":"红尘紫陌倦驱驰，绿水青山费梦思。\n无限五湖烟月趣，钓鱼台下一题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过严子陵钓台二首 其二","author":"邓林","text":"百尺荒台枕碧流，徵书曾此起羊裘。\n羊裘不是鹓班侣，只合归来伴白鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虎豹豺狼四画为杨百户题虎","author":"邓林","text":"锯牙钩爪利如锋，一啸寒生万壑风。\n徒手搏来羊犬缚，虎雄争似虎臣雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"豹","author":"邓林","text":"似虎非貔猛有威，擒獐攫兔疾如飞。\n虞人喂饲须令饱，沙苑秋高要打围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"豺","author":"邓林","text":"青蝇玷玉谗难辨，金索缠身食不甘。\n□彼谮人投畀汝，须教一饱内婪酣。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狼","author":"邓林","text":"花阴眠食不惊人，爱汝山林性已驯。\n慎莫跳梁当道立，都亭亭畔正埋轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山茶山鸟","author":"邓林","text":"百卉缄寒久矣哉，山茶独向雪中开。\n多情何处园林鸟，为惜孤芳特地来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海棠画眉","author":"邓林","text":"日上园林宿雾消，海棠睡起正妖娆。\n幽禽也是风流物，浓画双眉故斗娇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石榴黄莺","author":"邓林","text":"风流公子着金衣，赏遍韶华未肯归。\n万绿园林红一点，又来此处惜芳菲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"双雉","author":"邓林","text":"不羡山梁饮啄肥，宁同牧子叹双飞。\n五文愿借天孙巧，移上虞廷补衮衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送友人还乡","author":"邓林","text":"朔风吹雁雁南飞，有客还乡逐雁归。\n我欲从之无羽翊，黄金台下立斜晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鸡鸣山","author":"邓林","text":"荒山夜月叫荒鸡，千载唐王驻跸时。\n今日翠华重过此，朝阳好听凤来仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洋河","author":"邓林","text":"洋河东去接庐沟，奔赴长淮入海流。\n不是鲤鱼红尾短，便传好信到南州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桑乾河","author":"邓林","text":"咸阳贾岛客并州，更渡桑乾赴远游。\n我有千程乡国路，归心亦赴水东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙门山","author":"邓林","text":"双凤搏云翠辇高，从臣惟恐圣躬劳。\n马头万点青山小，极目胡沙眇一毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云林清隐为朱晟赋","author":"邓林","text":"吾家住在白云乡，竹树阴阴护草堂。\n此景若从图画看，可人惟有米元章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题山水画送人归羊城二首 其一","author":"邓林","text":"粤山千叠水千寻，桑梓长悬别后心。\n珍重丹青三昧手，为人满意写云林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题山水画送人归羊城二首 其二","author":"邓林","text":"数椽茅屋锁烟霞，君住苍崖第几家。\n卖药修琴归去晚，东风开遍碧桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题金尚书所藏画四首 其一 石榴山鹊","author":"邓林","text":"黄雀风长雨洗枝，花残莺老已多时。\n红榴满树鸣山鸟，别是园林一段奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题金尚书所藏画四首 其二 海棠班鸠","author":"邓林","text":"红日三竿照海棠，睡痕犹浸露华香。\n弄晴鸠妇来何处，唤醒酣春梦一场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题金尚书所藏画四首 其三 杏花画眉","author":"邓林","text":"华粉春衣染淡黄，看花因到午桥庄。\n娥眉不为东风画，蝶使风媒莫浪狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题金尚书所藏画四首 其四 梨花鸲鹆","author":"邓林","text":"红紫酣春醉复醒，洗妆谁把玉壶倾。\n寒泉可是能言鸟，为向东风说此情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题寒岁三友图","author":"邓林","text":"伐木歌残友道轻，利交门巷密如萍。\n岁寒有约人何在，使我披图眼独青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题墨菊送乡友南还","author":"邓林","text":"风满长林雨满城，重阳时节送君行。\n故园三径知存否，一幅秋香万里情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题四景山水 其一","author":"邓林","text":"春山无伴独相寻，欲觅知音听鼓琴。\n翠壁苍崖千万仞，人龙虽见白云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题四景山水 其二","author":"邓林","text":"水光山色映楼台，浓绿园林绝点埃。\n我有浮瓜沉李约，隔江人泛酒船来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题四景山水 其三","author":"邓林","text":"秋山风月有馀清，秋水船如镜里行。\n此景别来今十载，画图相对不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题四景山水 其四","author":"邓林","text":"万籁无声夜气顽，六花飞白满溪山。\n冲寒小艇来何处，可是王猷访戴还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题四景画 其一","author":"邓林","text":"东风吹暖入荷衣，忽忆家山笋蕨肥。\n功业未成玄鬓改，他乡虽乐不如归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题四景画 其二","author":"邓林","text":"困人天气日初长，临水亭台分外凉。\n纵倚风窗终日睡，也无一梦到名场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题四景画 其三","author":"邓林","text":"白云红树隐峰峦，曾记南阿赋考槃。\n此景别来归未得，西风写向画中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题四景画 其四","author":"邓林","text":"朔风吹雪晓漫漫，共住京华几岁寒。\n乡国梦成君别我，相思好把画图看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画小景","author":"邓林","text":"北辙南辕二十年，更无清梦到林泉。\n青山红树西风里，赢得披图一洒然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题蔡务小景","author":"邓林","text":"欢溪遇雨水沄沄，十里青山半是云。\n无限伯牙琴里趣，草堂何处访徵君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题赏菊画","author":"邓林","text":"三径秋来发兴新，柴桑去后属何人。\n于今未是休官日，聊向西风看写真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观梅","author":"邓林","text":"百卉封寒未敢开，南枝昨夜占□魁。\n暗香疏影□□□，留待孤山处士来。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弃瓢图","author":"邓林","text":"红尘不到白云关，洗耳清溪万虑闲。\n一自风瓢捐弃后，惟夜留月照箕山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题待渡小景","author":"邓林","text":"行人意似江流急，舟子心如白鸟闲。\n无限短长亭外路，不知何日到家山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题枯木竹石二首 其一","author":"邓林","text":"漆园樗散不为材，嶰谷参差玉未裁。\n匠石伶伦何处去，披图令我思悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题枯木竹石二首 其二","author":"邓林","text":"南风吹老碧琅玕，双凤毰毸奋羽翰。\n百尺珊瑚生海底，可人移傍玉屏看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题进士郑良所藏画二首 其一 折梅枝","author":"邓林","text":"春到江南几许时，东风未报故人知。\n陇头便使何当发，欲折馨香寄一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题进士郑良所藏画二首 其二 悬崖梅","author":"邓林","text":"十里湖堤未放春，寒崖惊见一枝新。\n风吹琼佩飘飘举，疑是瑶台月下人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梁仲高所藏俞汉远古树木竹","author":"邓林","text":"毰毸凤羽拂云寒，屈曲珊瑚出海蟠。\n不是词林挥翰手，凭谁传与世人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨梅","author":"邓林","text":"东风桃李不禁看，故约南枝共岁寒。\n只恐庙堂求鼎实，高楼吹笛汝心酸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春草图","author":"邓林","text":"生意欣欣满目前，乾坤大德信无偏。\n池塘昨夜经春雨，对此令人忆惠连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅月图","author":"邓林","text":"白凤参差驾玉輧，姮娥夜访许飞琼。\n广寒宫阙应寥寂，万斛天香散月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题沈斌所藏画三首 其一 独立相思鸟","author":"邓林","text":"相思无奈意凄凄，不见同心不敢啼。\n红叶谁家连理木，归来独借一枝栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题沈斌所藏画三首 其二 梅仙","author":"邓林","text":"罗浮仙子玉无瑕，醉我东邻卖酒家。\n夜半梦回人不见，空馀斜月照梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题沈斌所藏画三首 其三 桂仙","author":"邓林","text":"霓裳舞罢倚阑干，十二重阍闭广寒。\n金粟花开香万斛，不知谁共素娥看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画竹二首 其一","author":"邓林","text":"十年无梦到湘江，惊见图中玉一双。\n好似黄陵洲畔过，淡烟疏雨倚蓬窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画竹二首 其二","author":"邓林","text":"淇澳猗猗玉万竿，和烟和雨翠成团。\n城中真是无闲土，两个犹从画里看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夷齐采薇图","author":"邓林","text":"死生旦暮理之常，休叹斯人饿首阳。\n叩马数言虽不用，君臣大义凛如霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿陆道士雪窝","author":"邓林","text":"东阁劳君为我开，梅花纸帐绝纤埃。\n夜凉一枕游仙梦，骑鹤吹笙遍九垓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]