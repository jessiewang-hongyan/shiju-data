[{"title":"七夕何龙友马伯起过集分赋 其一","author":"李孙宸","text":"留滞金门未儗回，旅怀聊得附衔杯。\n音书南国秋仍阻，爽气西山客共来。\n可有鹊桥兹夕渡，空怜砧杵万家催。\n饶他乞尽天孙巧，懒拙都无河汉媒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕何龙友马伯起过集分赋 其二","author":"李孙宸","text":"高飙几夕露华浓，朋旧天涯尚可从。\n共向女牛怜夜色，不随杨柳怨秋容。\n饮拚尽兴倾家酿，话到投机触矢锋。\n醉后莫愁归路滑，与君横被听晨钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送罗东觉民部司饷卢龙","author":"李孙宸","text":"客舍黄花暮色寒，送君伐鼓度桑乾。\n三年文酒论心洽，九月风霜入鬓残。\n功在汉庭推转饷，名高兰省待弹冠。\n圣明宵旰还今日，莫向燕山叱驭难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游□□□寺次王季重韵","author":"李孙宸","text":"病废寻幽岂兴阑，招邀回我以花残。\n欲医俗眼惟春色，为趁游踪冒晓寒。\n野岸秾华偏搅恨，禅房凄寂亦留欢。\n迟回莫问岩城漏，立马犹倾酒盏宽。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又留题僧房","author":"李孙宸","text":"一入禅扉法界宽，形忘宾主自为欢。\n松涛俨听诸天籁，禅室偏留二月寒。\n花弱转嗔春色重，鸟喧如笑客情阑。\n清斋不禁陶潜酒，一醉山堂钟磬残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又同前题稐李大廷尉筼谷韵","author":"李孙宸","text":"万紫千红路杳漫，芳冈引眺未应残。\n三花寂倚诸天出，二水平从一掌看。\n竹径鸟啼春有恨，禅房雨过暮馀寒。\n不妨小酌分斋供，信好空门礼法宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郭菽子北上过白门见访","author":"李孙宸","text":"三仕犹堪寄白门，千秋吏隐意谁论。\n熟官久已违清署，上客还能共绿尊。\n漫向词林矜翰藻，且缘桑梓话乡园。\n看君双翼垂天起，肯为萍飘断旅魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送傅大司马得旨还里 其一","author":"李孙宸","text":"杖履年来奉旧畿，歌骊忽漫送将归。\n中枢地重卿为月，初服心悬黻作衣。\n海上貔貅悬指画，尊前裘带恋清晖。\n可堪春暮秦淮道，折尽长堤柳絮飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送傅大司马得旨还里 其二","author":"李孙宸","text":"简练材官十成兵，东南半壁壮长城。\n忧时未尽匡时画，去国还留报国情。\n暂许林间开绿野，可知海内望苍生。\n分携共洒新亭泪，莫漫归寻鸥鹭盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别伦五知曾息庵","author":"李孙宸","text":"忽忽征蓬又揽衣，感君相送出渔矶。\n山中尚有双龙卧，海上虚劳乘雁飞。\n世局真怜棋不定，主恩深荷日同辉。\n无论当为苍生起，宵旰清朝忍自违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度岭仍用前题壁韵","author":"李孙宸","text":"秋色苍茫万里开，长途匹马重迟回。\n乡心回首无梅寄，客思冯高见雁来。\n秦帝凿馀通贡道，陆郎归后有朝台。\n山花山鸟如相识，未负临风独举杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贵池舟中中秋夜月 其一","author":"李孙宸","text":"未秋先已期今夕，今夕清光岂等閒。\n野旷始知秋有色，人閒偏觉月相关。\n云边几字鸿声度，雾里一灯渔艇还。\n景物总供良夜赏，莫将留滞怨江山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贵池舟中中秋夜月 其二","author":"李孙宸","text":"遥空万里净埃氛，几度菰芦起雁群。\n海上月华原自别，夜深秋色已平分。\n素娥秘殿虚灵药，仙侣幽期隔彩云。\n此际清光人尽望，霓裳一曲许谁闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十六夜月","author":"李孙宸","text":"月好能留一夜清，还凭江海畅高情。\n轮亏天上何曾见，照向人间未减明。\n霜露气兼笳管发，关山影落雁鸿惊。\n欲知羁客愁多少，一夜孤舟白发生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十七夜月","author":"李孙宸","text":"秋色连宵隔凤城，羁人恋月转多情。\n开尊少倩华灯待，倚槛旋看皓魄生。\n红叶满江游子梦，碧云何处玉箫声。\n风涛未定明朝事，便欲浮槎问太清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十八夜月","author":"李孙宸","text":"银汉无声玉露漙，扁舟夜夜水云宽。\n三分素魄轮初减，万里清江照未残。\n橘柚岂忘乡国思，松醪能续弟兄欢。\n不知秋色还深浅，几夕西风木叶丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十九夜月","author":"李孙宸","text":"几夜秋光老，扁舟苦滞淫。\n每怜青桂影，飘向绿波沈。\n兴与碧云隔，愁将黄叶深。\n推窗还命酌，弃醉发微吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二十夜旅怀","author":"李孙宸","text":"月赏已云遍，风狂殊未休。\n我心忘去住，天意苦淹留。\n对酒难成醉，听鸡易起愁。\n因□寄京国，肯负菊花秋。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄逢永之当阳司谕","author":"李孙宸","text":"十年彩笔冠词场，却领青毡入楚乡。\n雨雪乍怜今日别，关山先念异时望。\n登台定奏雄风赋，怀古重歌白雪章。\n知是肃皇汤沐地，千秋王气满宫墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"汤母六十","author":"李孙宸","text":"长夏荆溪敞寿筵，斗坛西望礼群仙。\n萱明白发光垂地，锦作斑衣赐自天。\n荐有蟠桃来石洞，馔供江鲤出金泉。\n钟山子舍春同远，几部铙歌琅管传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠朱瞻御都阃","author":"李孙宸","text":"六郡韬钤若个优，还从经术擢名流。\n长缨不负山东妙，高第居然金殿头。\n释褐便赝专阃寄，登坛坐见瘴烟收。\n高皇汤沐歌风地，组练光寒万里秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"用韵答黎君选兼送其之任潮阳","author":"李孙宸","text":"春风花柳散河桥，远棹初停雪欲销。\n千里乍逢疑聚梗，一官无定类栖鹩。\n雄文重见溪鱼徙，雅望还同北斗标。\n华发分携能不念，尺书未远石城潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送区宪副捧贺事竣还粤","author":"李孙宸","text":"忆从文酒散燕京，几咏蒹葭未寄情。\n北阙重来新献寿，南枝偏恋旧同盟。\n花将弄蕊催愁发，柳未成丝亦赠行。\n高第只今需内简，肯容重袭桂江蘅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳兖州道中","author":"李孙宸","text":"小雨寒生九月天，客裳沾洒思翛然。\n秋于行路偏逢好，赋儗登高何处传。\n荷芰霜残犹浥露，柳条冬近暂为烟。\n不知三径荒芜后，尚有黄花几朵妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送仁伯弟南归","author":"李孙宸","text":"情为相依万里轻，送归那得不关情。\n经时未觉在羁旅，临发方知远弟兄。\n别酒荷风销午暑。\n到家梧露落秋声，宦情我自閒如水，好辟山田待耦耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚雨","author":"李孙宸","text":"酷热长安罢送迎，纤纤一雨晚风轻。\n当窗竹叶回残绿，照眼榴花依旧明。\n尚喜庭稀案牍事，差嫌门近殿呵声。\n半酣睡去月初上，枕簟微凉梦亦成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠别黎美周南还","author":"李孙宸","text":"白下朝来鹊噪阗，石城俄系孝廉船。\n十年旧德河山邈，一日通家意气先。\n彻骨总无凡格韵，行囊惟有近诗篇。\n衰迟送别非閒事，不尽停云思黯然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其一 一东","author":"李孙宸","text":"春到园林著几丛，春光俄在有无中。\n成阴易满千围绿，有恨难留一点红。\n天女散来都不著，封姨庇后已归空。\n所经节候成追忆，二十四番花信风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其二 二冬","author":"李孙宸","text":"澹妆一自谢华浓，膏沐非无不为容。\n早识飘残今日雨，何如采去昨朝蜂。\n寥寥锦瑟三千户，寂寂阑干十二重。\n他日芳魂纵可托，因缘无处觅前踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其三 三江","author":"李孙宸","text":"嫣然几朵失当窗，无复高烧照玉缸。\n梦托云行归楚峡，句传枫落冷吴江。\n谁怜织锦诗千首，独往听鹂柑一双。\n衰贱也甘同腐草，閒情飘荡未教降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其四 四支","author":"李孙宸","text":"开时原较别家迟，今日差留三两枝。\n漫惹垂杨牵别恨，祇凭流水谢相思。\n我心早悟即空理，世眼无劳隔岁期。\n还向枝头重致语，岁寒霜雪好维持。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其五 五微","author":"李孙宸","text":"春尽閒庭昼掩扉，海棠零落杏花飞。\n殿前班女朝辞辇，宫里秦王夜捲衣。\n未免欢场终一别，祇怜飘处不同归。\n芳魂愿化相思树，连理连枝近日辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其六 六鱼","author":"李孙宸","text":"锦障雕阑宴赏馀，山家犹是看花初。\n合欢酒仗诗为妁，擘柳风前雨已疏。\n士女穿林攀惋惜，游人归骑踏踟蹰。\n登楼更送遥遥望，无数春愁一啸舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其七 七虞","author":"李孙宸","text":"何心大地自春敷，谁解东皇事有无。\n残蕊辞条飞欲尽，长林携酒约应虚。\n千林烟雨鹃啼暮，一曲关山笛吹孤。\n但悟空花原不著，莫从尘世问荣枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其八 八齐","author":"李孙宸","text":"摇摇成幰画楼西，片片飞花委大堤。\n便可还归众香国，不妨聊伴浣沙溪。\n世情只任怜耶妒，幽恨都难笑与啼。\n何处留春春得住，一尊犹有客重携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其九 九佳","author":"李孙宸","text":"每到花时意况佳，漫疑春色在山斋。\n未模锦障归高帐，且放芳茵布小阶。\n为报深恩楼分坠，肯拚薄命骨同埋。\n绿阴何必秾华减，游侣还堪其写怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其十 十灰","author":"李孙宸","text":"香尘杂遝未沾埃，肯为飘零溷野莱。\n薄倖东风嫁不得，多情流水逝还来。\n即看稀到穿林蝶，那得仍停在手杯。\n一片游情好收拾，柴门从此未须开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其十一 十五删","author":"李孙宸","text":"绕树迎檐手自攀，芳华一别几时还。\n隔山染黛眉生彩，近水浮波瀔有斑。\n迟暮莫深公子怨，清虚欲儗道机閒。\n菀枯荣谢须臾事，便好求丹学驻颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其十二 十六先","author":"李孙宸","text":"何处送春不可怜，人事物情俱黯然。\n纵有连夜天工手，能那一朝东风颠。\n翻将此日忆昨日，岂有来年异依据。\n风光尚留满眼醉，明霞轩轩月娟娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其十三 十七萧","author":"李孙宸","text":"东皇疑是嫁红绡，回首朱栏片片飘。\n自为情慵御妆洗，非关树静苦风摇。\n文姬赋就胡笳拍，史氏吹停凤女箫。\n从此心情吾亦改，顿嫌繁蕊爱疏条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其十四 十八肴","author":"李孙宸","text":"相怜相嫟俄相抛，深情如许委荒郊。\n堕露飘共萍水散，因风起或空中交。\n吹浪在藻鱼戏嚼，寻荒过邻蜂仰捎。\n幽居不解惜春事，尚白尚玄总可潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其十五 十九豪","author":"李孙宸","text":"岂有探春兴不豪，飘零无那首重搔。\n花羞玉女宁长妒，果掷潘郎已二毛。\n晚谢肯缘依锦槛，纷飞亦自稳篱蒿。\n十年寂寞江淹梦，五色虚疑入彩毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其十六 二十歌","author":"李孙宸","text":"伤春老去意如何，寂寂香尘冷绮罗。\n岂为迟徊贪粉黛，若缘轻扬恋枝柯。\n衰迟兴味归枯槁，少小娇憨顿耗磨。\n莫向风前吹玉笛，不堪重听落花歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其十七 二十一麻","author":"李孙宸","text":"窗前索莫几枝斜，隐几翛翛感岁华。\n轻贱岂难辞玉砌，娇羞恨未惯风沙。\n便依莲座观清净，怕到园林起叹嗟。\n何必无双亭好在，至今犹自说璚花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其十八 二十二阳","author":"李孙宸","text":"高楼慵上客心伤，望望华林半就荒。\n闻说仙人佩留玦，可能公主额添妆。\n轻同飞絮因风乱，弱伴游丝学舞长。\n若道返魂真有树，愿从西海问奇方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其十九 二十三庚","author":"李孙宸","text":"老去相捐亦世情，楚骚还赋落秋英。\n卢传砑帽山香曲，宁复园林铃索声。\n露湿未教辞蒂早，风微何惜试身轻。\n诗肠鼓吹还无恙，去听前溪满树莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其二十 二十四青","author":"李孙宸","text":"累累结子何青青，怜香惜玉事杳冥。\n忘忧已愧树背草，纪历敢附阶前蓂。\n词客诗筹还堪赋，玉人歌管未许停。\n吾意亦复不可败，长醉空林不愿醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其二十一 二十五蒸","author":"李孙宸","text":"春光去矣不可乘，无端愁绪忽忽增。\n□□□□□□□，□□□□□□□。\n□□□□□□□，□□□□□□□。\n□□□□□□□，□□□□□□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其二十二 二十九盐","author":"李孙宸","text":"岂有鸾胶续可粘，铺筵藉几晚逾添。\n锦霞散处座纷映，香雨飞来客共沾。\n雕玉佩中收绣被，避风台畔捲珠帘。\n升沈世态多如此，莫笑冯唐汉署淹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"唐操江落花诗三十首李临淮先有属和余兴不自已遂悉次其韵 其二十三 三十咸","author":"李孙宸","text":"缓步寻春到碧岩，感时溅泪湿青衫。\n每归桃洞鱼同入，为献仙人鹿解衔。\n飞幔忽惊金菊帐，点船虚认阿摩帆。\n子规莫是情痴者，流血啼春口未缄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春闺曲 其一","author":"李孙宸","text":"燕子衔香坭，结巢寻旧屋。\n何事浪游人，经年客海曲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春闺曲 其二","author":"李孙宸","text":"送君出门前，门前有芳草。\n莫将红粉楼，不及长安道。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春闺曲 其三","author":"李孙宸","text":"春雨夜来多，春潮添几尺。\n今朝江口望，或有南归客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜伍国开有开同诸从过宿小楼以酒态美如嵇叔夜诗才清似沈休文为韵赋十四绝 其一","author":"李孙宸","text":"朔风猎猎吹，蓬鬓萧疏久。\n不用惜流年，且尽杯中酒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜伍国开有开同诸从过宿小楼以酒态美如嵇叔夜诗才清似沈休文为韵赋十四绝 其二","author":"李孙宸","text":"醉来礼法疏，白眼从人怪。\n吾自适吾真，岂能调世态。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜伍国开有开同诸从过宿小楼以酒态美如嵇叔夜诗才清似沈休文为韵赋十四绝 其三","author":"李孙宸","text":"爱月忘夜寒，焚香对酒美。\n醉后拥衣眠，闻鸡还欲起。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜伍国开有开同诸从过宿小楼以酒态美如嵇叔夜诗才清似沈休文为韵赋十四绝 其四","author":"李孙宸","text":"露下衣裳冷，邀欢子夜初。\n援琴试新曲，山水意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜伍国开有开同诸从过宿小楼以酒态美如嵇叔夜诗才清似沈休文为韵赋十四绝 其五","author":"李孙宸","text":"日短欢难尽，青尊夜更携。\n烂醉无相讶，风流旧阮嵇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜伍国开有开同诸从过宿小楼以酒态美如嵇叔夜诗才清似沈休文为韵赋十四绝 其六","author":"李孙宸","text":"望月捲珠帘，窗风灭银烛。\n一榻下陈蕃，千秋见鲍叔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜伍国开有开同诸从过宿小楼以酒态美如嵇叔夜诗才清似沈休文为韵赋十四绝 其七","author":"李孙宸","text":"窗外走星辰，光寒相注射。\n似有老人来，燃藜照此夜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜伍国开有开同诸从过宿小楼以酒态美如嵇叔夜诗才清似沈休文为韵赋十四绝 其八","author":"李孙宸","text":"同君踏明月，吾更探琼枝。\n情深不忍寐，刻烛限成诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]