[{"title":"同方明府夜集沈监丞宅 其一","author":"欧大任","text":"偏喜从车骑，言寻晚径香。\n星前犹单父，池上即高阳。\n秉烛觞宁算，题诗漏正长。\n未须疑卜昼，难得此宵良。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5728,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同方明府夜集沈监丞宅 其二","author":"欧大任","text":"结构初成日，予来赋考槃。\n江霜飘皂盖，林月射银鞍。\n图史苏司业，宾朋管幼安。\n秋容娱佚老，扶醉几回看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5729,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邵进士还馀姚","author":"欧大任","text":"冻浦岂堪别，戒舟先有期。\n沙鸿迎客过，园竹待君窥。\n雪暗梅梁石，江深孝女祠。\n北来如奏赋，须及射熊时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5730,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱仲开黄定父吴孝父邵长孺管建初邹君植陆无从过饮得名字","author":"欧大任","text":"漆园容吏隐，江海一尊情。\n醉里星犹聚，歌中雪有声。\n解貂怜意气，看剑赠生平。\n岂是邯郸侠，空多结客名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5731,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周公瑕自济上见过","author":"欧大任","text":"尔作山东客，新从历下来。\n中原怜数子，落日一登台。\n揽辔关门气，飞书幕府才。\n不堪广陵别，沙际乱鸿哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5732,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴克之还歙因游浙中","author":"欧大任","text":"新安百里水，直下浙江流。\n故人从此去，相送淮南秋。\n杨柳落已尽，蟪蛄鸣更愁。\n何时一书札，西寄广陵楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5733,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日同金在衡姚伯子李鸣卿集陈伯春别业得青字","author":"欧大任","text":"木榻长留客，寒栖一草亭。\n纳云窗欲白，经雪竹偏青。\n避世容高卧，随人畏独醒。\n因君心更远，何异在林坰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5734,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春后二日雪","author":"欧大任","text":"飒飒海云残，星沉万户寒。\n春从前日至，雪向此宵看。\n发短簪偏冷，囊空酒易乾。\n洛阳宾客地，且得卧袁安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5735,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黑将军邀泛舟送黄判官雪中不得赴","author":"欧大任","text":"浮舟不相送，飞旆便离群。\n河雪鱼争避，江春雁独闻。\n蓝田防醉尉，瓠水忆将军。\n意气惟看汝，飘零更策勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5736,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"学舍除夕","author":"欧大任","text":"淮海望乡遥，残年尚此宵。\n宫花簪胜在，官烛簇盘烧。\n白发思含菽，青毡一颂椒。\n追趋惭笔札，何补圣明朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5737,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西园牡丹宴集 其一","author":"欧大任","text":"国色广陵新，西园约屡申。\n驱驰虚胜赏，风雨度芳晨。\n玉佩频迎客，红妆尚待人。\n莺声君试听，犹似曲江春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5738,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西园牡丹宴集 其二","author":"欧大任","text":"幽兴春偏剧，名园酒更催。\n看花潘令约，领客习池来。\n露蕊三江争，云根五岳开。\n石栏丝管急，秉烛未能回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5739,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晦日姚唯之茅平仲管建初蒋子夏陆无从饮斋中得春字","author":"欧大任","text":"花飞杨子津，君寻斋中人。\n芍药不可赠，樱桃何太匀。\n红兰楚客醉，白苧吴歌新。\n明月扁舟上，相思江南春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5740,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日泰州光孝禅房柬王子慎方允治 其一","author":"欧大任","text":"丈室隐茅茨，清斋缮性时。\n教曾黄石许，心果白鸥知。\n习睡憎便腹，谈诗畏解颐。\n悠然怀二子，风雅得吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5741,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日泰州光孝禅房柬王子慎方允治 其二","author":"欧大任","text":"鸣磬海楼东，栖禅亦此中。\n伏牛千古事，驱马众人同。\n过郢歌谁和，游齐瑟自工。\n所期飞锡去，从尔御泠风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5742,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠范子宣","author":"欧大任","text":"高秋建礼直，羡尔奉明君。\n典客如韩暨，摛词亦范云。\n山斋天玺帖，江雨海鹏文。\n傥有相思字，西风寄雁群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送通州葛秀才赴举","author":"欧大任","text":"铜鞮葛公子，逢掖鲁诸生。\n淮海推能赋，江津返独行。\n剑鸣秋气早，马跃暮云平。\n看尔持双璧，秦人待客卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄俞仲蔚","author":"欧大任","text":"一苇不可渡，忆君东路遥。\n霜清江阁夕，叶落海门潮。\n旧业通儒素，深栖颂圣朝。\n书成千古事，应足老渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆周汝砺","author":"欧大任","text":"都亭一以别，闻尔在毗陵。\n白袷初归客，青山不负丞。\n持醪因嫩菊，擘蟹爱寒蒸。\n从此秋风艇，江南忆季鹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳后一日陆华甫蒋子夏吴子化陆无从邵长孺集斋中得南字时华父将渡江","author":"欧大任","text":"九日忽已过，还来卷幔谈。\n烟波迷泗口，木叶下淮南。\n岩菊初成径，山醪不满甔。\n相将堪一醉，容易隔江潭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答郭膳部笃周见怀 其一","author":"欧大任","text":"典礼趋东省，亲逢主好文。\n注书推郭象，识字过杨云。\n旧苑长杨赋，中原细柳军。\n此时劳尺素，何处挹清芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答郭膳部笃周见怀 其二","author":"欧大任","text":"使者秋相问，北来飞骑书。\n天长淮树小，江冷蓟鸿疏。\n白发愁难遣，黄花饱有馀。\n登台望京阙，千里独踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄范于公祠部兼讯王百谷","author":"欧大任","text":"曾忆为郎久，祠官秩更清。\n握兰趋建礼，起草直承明。\n有梦寻东省，何人念长卿。\n王褒今待诏，因尔寄同声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邵长孺还休宁因寄金惟良","author":"欧大任","text":"岁晚宁亲去，椒盘忆弟昆。\n黄山苍雪路，练水白云源。\n松菊自荒径，儿童今候门。\n西行逢处士，为我问梁园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴志道董文蔚见过","author":"欧大任","text":"残帙朝犹检，寒斋午始开。\n径为三益待，客自四明来。\n积霰梅花阁，飞霞竹叶杯。\n愧君酣赏意，烧烛未能回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王仲房以书遣慧光上人订栖霞之约赋此奉答","author":"欧大任","text":"摄山吾未到，先识白眉僧。\n瓶汲千江水，堂开七祖灯。\n饮泉君早悟，住岳我偏能。\n幸寄东林疏，抠衣叩上乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠写生刘山人还会稽","author":"欧大任","text":"早已传家学，奇游更擅能。\n英风多写鹘，误笔乍为蝇。\n江左名先著，山阴兴颇乘。\n扁舟劳尺素，知尔渡西陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送庐州别驾郭子坤擢淮王长史","author":"欧大任","text":"庐江推治行，历下识吾徒。\n裾向何门曳，舆曾大府趋。\n芝山瞻霍岳，淮水过鄱湖。\n知尔淩云赋，风流在汉都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张羽王赴黎平","author":"欧大任","text":"一官三佐郡，谪宦更牂牁。\n暮雨传双泪，春莺听九歌。\n黔中秦道路，徼外汉山河。\n兰佩还堪赠，临湘忆汝多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送苏子川奉使还京","author":"欧大任","text":"剡水舟初返，邗江雨忽开。\n暂为金马使，曾是步兵才。\n驿下淮流出，尊前酒色来。\n难将羁客赋，因尔奏蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀关中王生","author":"欧大任","text":"闻君住岳久，生计未全疏。\n石磴秋犹湿，松苓日自锄。\n沉冥无所问，服食更何如。\n知有山涛举，稽康莫报书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠吴孝甫","author":"欧大任","text":"夫君何所梦，白云千古愁。\n霜飞淮南草，月落潇湘秋。\n凤鸟望不至，琅玕何处投。\n临风双泪断，为寄西康州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邵长孺之楚归父榇","author":"欧大任","text":"送送不得远，鸟啼君奈何。\n襄园扶旅榇，郢路一悲歌。\n哀些招魂迥，沉碑堕泪多。\n故山成冢树，相忆在烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送中父过赵并游潞下","author":"欧大任","text":"结束西游去，江淮共此尊。\n璧终辞客邸，裾自曳王门。\n夜雪漳河骑，春花潞子园。\n吕安曾佐锻，莫负竹林言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄谢茂秦","author":"欧大任","text":"邺下使空返，潞南书更难。\n祇应劳远梦，何以报加餐。\n宾客平原散，衣裘上党寒。\n行藏君莫问，吾自老江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李宗夏挽词","author":"欧大任","text":"巫阳吾欲问，魂去不堪呼。\n精卫沉沧海，刍灵送孟诸。\n阶荒珠履散，铭掩白云孤。\n挂剑酬心许，应知客在吴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送顾计部还京","author":"欧大任","text":"漕河风雪后，使者入燕关。\n边饷疲诸郡，军符走万山。\n腊将尊酒尽，春共佩刀还。\n法从多词客，思君豹尾间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王中丞挽歌 其一","author":"欧大任","text":"麟阁图空在，龙城战已危。\n死绥何所望，投杼竟深疑。\n风惨将军树，云愁太白旗。\n主恩昭洗日，应不恨鸱夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王中丞挽歌 其二","author":"欧大任","text":"数奇军失路，落日哭苍天。\n楚些招魂夕，吴钩赐葬年。\n战犹思钜鹿，冢已像祁连。\n部曲伤心处，松楸万树烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠月上人","author":"欧大任","text":"山中见自性，趺坐已多年。\n桐帽钟陵月，茶垆白乳泉。\n谈经参涧鹿，裁衲学溪田。\n乞法君何去，祇园即是禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆元德久客宜兴顷以篇什见寄岁晚怀之","author":"欧大任","text":"尔昨荆溪去，栖迟已数年。\n自称三洞长，不问五湖船。\n寄橘深秋后，含椒献岁前。\n两乡俱作客，搔首向江天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀靳师道","author":"欧大任","text":"铁瓮城边路，怀人径寸心。\n夕鸿前浦远，春雨大江深。\n笔札留东观，风云在上林。\n游閒知爱客，飞盖日相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁庆伯同思伯北上","author":"欧大任","text":"茱萸湾下路，送送故乡人。\n载酒听黄鸟，浮舟过绿蘋。\n玄成经笥学，司马使轺臣。\n共向长安去，承恩紫禁春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过高邮寄柳彬仲","author":"欧大任","text":"问驿高沙馆，思君玄草亭。\n花能连帐绛，山自入帘青。\n隐几官如水，扬帆客是星。\n朱弦双琐在，难向柳侯听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淮阴驿逢童子鸣管建初北上","author":"欧大任","text":"扁舟吾暂系，把袂尔何期。\n斗酒相逢处，天涯问所之。\n淮阴人罢钓，吴市客吹篪。\n遇合千秋事，君王正好奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漂母祠","author":"欧大任","text":"落日淮阴市，萧萧一庙存。\n絮曾何处漂，饭自此时恩。\n楚驿下春鸟，韩山啼暮猿。\n平生知己泪，感激念王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"叶茂长伏日见过以朱明府诗相示","author":"欧大任","text":"河朔千年客，藤萝六月亭。\n君能怜惨淡，吾自爱沉冥。\n病色秋涛笔，穷交浊酒瓶。\n楚名翁子学，南去更传经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴存甫溪亭","author":"欧大任","text":"新安江上客，卜筑古邗西。\n选石安棋局，临流倚杖藜。\n花源舟自入，竹径酒曾携。\n颇有王猷兴，相寻似剡溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陈亮夫","author":"欧大任","text":"起家推世业，去矣谒宸旒。\n鸟下蓬莱日，鱼翻太液秋。\n朝廷恩不细，胄子礼偏优。\n经笥君无忝，扶阳汉列侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5776,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张伯起求志园分赋得采芳径","author":"欧大任","text":"开径游从少，芳菲今正繁。\n山多董林树，岸似武陵源。\n世岂堪成傲，人谁共避諠。\n何时伧父过，花发醉西园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5777,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻吴孝甫游杭州","author":"欧大任","text":"钱唐知欲渡，何日过姑苏。\n揖客裘偏短，寻僧艇亦孤。\n江梅居士宅，烟草女儿湖。\n秋晚能来否，松醪待尔酤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5778,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李太仆孝甫省觐兼寄宾甫 其一","author":"欧大任","text":"数马曾持策，谁言太仆豪。\n还家张挚宅，赠客吕虔刀。\n白露迎青舫，丹山待綵毫。\n翩翩冠盖地，能不念吾曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5779,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李太仆孝甫省觐兼寄宾甫 其二","author":"欧大任","text":"因尔知难弟，能诗调更高。\n归逢四明雪，应问广陵涛。\n枕里留鸿宝，腰间指孟劳。\n他年西候去，长揖白云袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郑祖钦令海盐","author":"欧大任","text":"同舍君为宰，荒斋我尚留。\n江淮千里涨，吴越万家秋。\n槜李通湖岸，盐官傍海楼。\n主恩需计吏，归拜富民侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题魏子贞石葵草堂","author":"欧大任","text":"爱君簪弁里，丘壑白云情。\n秀石连峰出，高花向日明。\n诵诗趋幼子，问字揖诸生。\n有约寻天目，相将杖屦行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张幼于自白下过广陵见访","author":"欧大任","text":"惟上秋将尽，高天鸿雁哀。\n挂帆杨子色，载酒秣陵来。\n山雨沾书阁，江枫落弩台。\n十年思见汝，莫负故人杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送周象贤迁襄王傅","author":"欧大任","text":"鼓枻游襄汉，风流在此时。\n山馀王粲井，城背习家池。\n授简千秋赋，持觞七子诗。\n长裾君且曳，荐引上彤墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杜伯理诸寅夜过","author":"欧大任","text":"稍适过从兴，俱忘请谒劳。\n江淮今盛府，宾客有吾曹。\n浊酒篱花冷，清歌海月高。\n自怜官舍里，苜蓿半蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伯理见邀同蔡德玄魏子贞夜集","author":"欧大任","text":"高阁冠簪会，江阳夜雁声。\n征鞍非剡水，跃剑似丰城。\n风雪帷犹下，关山骑欲行。\n他时怀此夕，何限薜萝情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题石庵图","author":"欧大任","text":"三峰曾削出，一室此为尊。\n箭栝初通路，琅玕尚满园。\n斋应题雪浪，铭自勒云门。\n载酒人能至，宁辞问字繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何叔节归耕茭湖之上陆华甫为其作图索余题句","author":"欧大任","text":"赐归还食力，百顷有茭湖。\n草阁千村远，藤蓑一艇孤。\n著书称太傅，持论似潜夫。\n予亦烟波客，秋风忆钓鲈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"发广陵遇雪李员外枉饯周园","author":"欧大任","text":"粤客同飞盖，园曾几度游。\n淮西吾自去，江左尔还留。\n雪密枫林暮，天遥露掌秋。\n独怜朋好散，谁上李膺舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒泗州祖陵","author":"欧大任","text":"陵庙方冬荐，祠官彻晓催。\n地当淮水会，山自岱宗来。\n亚圉家初造，玄王祚已开。\n圣朝歌祖德，二雅入南陔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"濠梁雪中答李仓部送酒","author":"欧大任","text":"故国浈江上，他乡此驻旌。\n尺书飞水驿，斗酒下山城。\n喜剧深杯送，酣来短句成。\n雪天难会面，三谢省郎情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过凤阳谒皇陵","author":"欧大任","text":"御碑开万古，文考德光辉。\n启运艰难早，乘时历数归。\n宫为银海涌，云似鼎湖飞。\n陵阙标河岳，中都本帝畿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿州望八公山","author":"欧大任","text":"淮南昔好道，稽首八公迎。\n白日飞光驻，黄金大药成。\n鹤軿邀远举，鸿宝恋长生。\n山下闻鸡犬，云霞空寄情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"固始谒许忠节祠","author":"欧大任","text":"太史铭家庙，忠先表乐陵。\n天青秦血洒，月白楚魂凭。\n帝自诛刘濞，神今飨泰烝。\n羽林恩不细，霄汉翊中兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次固始逢李文学讯曾比部子玉","author":"欧大任","text":"西曹今直省，信有故人传。\n白雪高歌里，青春浊酒前。\n为郎非得意，作客况长年。\n我更羞行役，微官未息肩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄张肖甫时备兵天雄 其一","author":"欧大任","text":"久忆铜梁客，曾传剑阁铭。\n留屯漳水白，倚垒太行青。\n尊俎临沙麓，风云出井陉。\n南来新入部，何处望双星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]