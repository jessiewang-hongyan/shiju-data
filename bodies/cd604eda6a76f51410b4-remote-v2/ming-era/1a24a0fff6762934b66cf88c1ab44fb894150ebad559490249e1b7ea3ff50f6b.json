[{"title":"寄何州牧","author":"庞尚鹏","text":"陇头谁寄一枝春，草绿江深忆故人。\n西蜀甘棠明月远，苍梧烟雨画楼新。\n人间自昔多豺虎，屋漏应知有鬼神。\n时看前亭看戒石，好将严训独书绅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12030,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"代邹麦二公酬和谭别驾寄怀","author":"庞尚鹏","text":"江梅生子芥生孙，野树临溪水绕村。\n常遣儿童开竹径，不因风雨掩蓬门。\n夜閒草屋忘悬榻，春到瓜畦喜灌园。\n乘兴山阴能放棹，雪晴携酒醉朝暄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12031,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀海村家兄次韵谭别驾","author":"庞尚鹏","text":"风涛飘泊自相依，天涯春望何时归。\n江乡已负梅花约，庭院今看燕子飞。\n采药忽惊双鬓改，闻猿应恨故乡违。\n一尊待酌池亭月，万树丛阴上钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12032,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵酬苏眉山寄赠","author":"庞尚鹏","text":"远水空林羡一丘，春晖萱草共忘忧。\n浮名已恨藏身拙，薄技何能为国谋。\n宦海风涛三尺剑，帝城雷雨万家秋。\n长公元是瀛洲客，天上夔龙结胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12033,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"水亭落成次韵酬和谭别驾","author":"庞尚鹏","text":"绿阴清昼水云居，百尺林塘一鉴虚。\n山远直将天作画，溪深休道食无鱼。\n江光潋滟春潮长，树色参差径路纡。\n初学灌园新雨足，邵平瓜地更何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12034,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵酬和戴筠台太守","author":"庞尚鹏","text":"十载相逢赠佩刀，长亭尊酒气偏豪。\n天连海市潮初长，风动棠阴月正高。\n剡曲扁舟重访戴，浔阳五柳独称陶。\n悠悠世路浮云外，一醉何心独反骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12035,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵雨中遣闷兼七夕过从和双台星野二兄","author":"庞尚鹏","text":"秋早雷声撼远村，东风排屋雨翻盘。\n三更洗出南楼月，七夕吹开北海尊。\n锄径莫教延俗客，操觚谁为赋高轩。\n床头新酒今初熟，况有东园旧菜根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12036,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小构落成次韵酬和周云谷","author":"庞尚鹏","text":"卜筑芳村枕水涯，一尊常对四时花。\n长江浴日明金佩，远树屯云拥翠华。\n清簟疏帘高士榻，石桥流水野人家。\n巡檐更觉青天近，重忆星河泛斗槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12037,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋值七夕同乡燕会酬和卢方伯","author":"庞尚鹏","text":"白头相聚浣花村，坐久浑忘苜蓿盘。\n万树秋声回落日，九天凉雨送清尊。\n鹊桥缥渺银河路，庭竹萧森绿雪轩。\n此日纷纷论乞巧，天工沉默总忘言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12038,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"简谭见日昔年以布衣远游曾上书阙下时论伟之","author":"庞尚鹏","text":"飘飘文藻擅名流，倚剑胸藏五岳秋。\n万里江涛青雀舫，九衢风雪黑貂裘。\n临池洗砚奎光动，草奏惊人国史收。\n更欲钓鳌称巨客，直从天上试金钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12039,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵谭山人登城楼寄怀","author":"庞尚鹏","text":"浮云散尽见孤峰，飒飒城头起暮风。\n羡尔登楼瞻渤海，与谁骑鹤跨崆峒。\n秋深古戍边声急，春早银河斗柄东。\n信宿江村谈往事，十年踪迹叹飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12040,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居和卢方伯","author":"庞尚鹏","text":"与君同住百家村，长采新蔬荐野盘。\n夜雨江楼频下榻，石亭秋圃更移尊。\n逃禅早结栖云侣，问字常开读易轩。\n海内旧游零落尽，倚天弹剑向谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12041,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和谭别驾用杜律秋兴韵四首寄怀刘跃衢年兄","author":"庞尚鹏","text":"一夜清霜满禁林，江皋云树独森森。\n轻飙入户逢新霁，凉月浮阶送晚阴。\n万里江湖灯火梦，百年天地岁寒心。\n故人相望蒹葭外，长听秋声促暮砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12042,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卢方伯移舟过小亭","author":"庞尚鹏","text":"僻居同在水云间，休道乘舟取醉难。\n河汉夜凉星采合，蒹葭霜早雁声寒。\n寻花懒入长春苑，载酒时过白鹭滩。\n多少游人归未得，青山空对画图看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12043,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和友人怀溪园","author":"庞尚鹏","text":"把酒长亭月上时，满湖秋景画中诗。\n天边云静星河远，海曲鸡鸣鼓角悲。\n短径黄花牵别恨，东山瑶草寄幽思。\n何缘共泛溪头棹，绿树阴中向晚移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12044,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄谭见日","author":"庞尚鹏","text":"秋气萧森草木疏，忆君重过水云居。\n休将玄鬓歌弹铗，长向青藜问校书。\n世态江河忘百折，茅斋风日惜三馀。\n浮名尽付沧洲外，司马何劳赋子虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12045,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠江夜泛","author":"庞尚鹏","text":"百尺江楼拥女墙，几行归雁渡潇湘。\n沙村见月晚潮急，海寺闻钟秋夜长。\n远树溟濛藏野寨，银河迢递隔牛郎。\n扁舟莫动卢敖兴，鼓枻还寻水竹乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12046,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日村居","author":"庞尚鹏","text":"谁家横笛倚楼吹，门巷春深草木知。\n世态浮云多感慨，村翁杯酒共襟期。\n心閒肯厌谋生拙，性懒从教见事迟。\n为喜浔阳在邻曲，日闻莲社赋新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12047,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠去雁","author":"庞尚鹏","text":"千仞翱翔瞰八方，衡阳山外即他乡。\n经秋梦断胡尘远，归路心随云汉长。\n风急龙沙飘雪翮，月高秦陇渡河梁。\n邮亭见尔南来日，清海城头百草黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12048,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春燕","author":"庞尚鹏","text":"信宿韶光几度新，乌衣门巷已成尘。\n画堂去住常如客，草屋栖迟不厌贫。\n一别岂能忘故主，重来犹得寄閒身。\n社前为报丰年兆，谷口应逢郑子真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠归雁","author":"庞尚鹏","text":"南来冲雨度三湘，北去飘飘恋故乡。\n懒学啼乌栖苑树，喜随鸣凤向朝阳。\n黄云朔漠同千里，秋水蒹葭各一方。\n我欲寄书怀定远，至关门外早回翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"写怀二首 其一","author":"庞尚鹏","text":"海翁相对问年华，紫陌春风万树花。\n竹外小桥频送酒，溪边新水细烹茶。\n林塘古木通幽径，山郭斜阳带晚霞。\n粗粝一盂能自适，天台何处觅胡麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"写怀二首 其二","author":"庞尚鹏","text":"乾坤浩荡本无言，信宿春风已到门。\n地远最宜山色近，林幽偏爱鸟声喧。\n游仙自古人何在，借剑当年舌尚存。\n白日闭门閒未得，直愁车马破苔痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"村居感事寄所知","author":"庞尚鹏","text":"烟村迢递隔江城，避地应须更避名。\n雁足帛书云外至，凤池春草梦中生。\n曾搜往牒看花谱，欲驻衰颜仗酒兵。\n当世共知怜范叔，绨袍谁忆故人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读庞德公传","author":"庞尚鹏","text":"结庐岩曲谢招寻，几树松萝满地阴。\n无路执戈排乱贼，与谁披褐卧芳林。\n人间空忆安危语，陇上宁知去住心。\n千载鹿门山下路，武侯相见亦沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过田家有述","author":"庞尚鹏","text":"儿童遮道问来程，笑插江花拥袂迎。\n门扫藤萝如有约，地连桑梓岂无情。\n梨尊细倒邻翁醉，箬笠高悬世虑轻。\n月白沙村归路晚，杖藜人在画中行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钟心瞿道长欲枉顾作此招之","author":"庞尚鹏","text":"瞬息年光似水流，蓬莱山下几春秋。\n仰天大笑云垂地，击筑高歌月满楼。\n偃蹇喜逢金马客，逍遥谁识醉乡侯。\n扁舟不负东游兴，载酒同过谢脁洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望白云寄城中诸公","author":"庞尚鹏","text":"延伫高峰万仞梯，翠屏环绕万山低。\n龙拖云幄天连海，风起松涛月满溪。\n蒲涧寻僧看卓锡，帘泉呼酒共燃藜。\n江村正忆游仙客，欲访安期谁为携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠方进士之任慈利","author":"庞尚鹏","text":"廿载驱驰道路长，前旌今始渡衡阳。\n江城露冕山川秀，花县褰帷草木香。\n春雨平原苏久旱，朝晖寒谷借馀光。\n争看天际双凫起，五色云中侍玉皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望西樵和卢方伯","author":"庞尚鹏","text":"极目丹梯最上层，春回佳气散炎蒸。\n九龙昼起千山雨，万壑寒生六月冰。\n井底何年通巨海，松阴无地著閒僧。\n高峰若有飞来日，藉草穿云共臂鹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午睡","author":"庞尚鹏","text":"一簟春风醉兀然，不须长借酒家眠。\n最宜树色窥帘入，休管蛛丝隔幔牵。\n心远神驰黄鹄外，梦回身寄白云边。\n何年高枕希夷峡，不用华山僦屋钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬黄东明博士","author":"庞尚鹏","text":"百花红紫竞幽香，卜筑新成绿野堂。\n慷慨拂衣还岭海，太平欹枕醉陶唐。\n天回蓬岛千山月，风送炎洲六月霜。\n身外豪华何足问，汉廷谁复论金张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈古洲表弟诗来多感慨就韵寄酬","author":"庞尚鹏","text":"万事浮云敢浪言，与君尊酒笑灯前。\n升车肯负题桥志，挂剑曾轻负郭田。\n白笔昔惭亲凤幄，玄冠何意插貂蝉。\n时来莫叹冯唐老，皓首还逢汉主怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬杨胪山兼寄姚柏庵","author":"庞尚鹏","text":"青鬓翩翩结壮游，看花春满曲江头。\n九天雷雨双龙喷，万里烟云一剑收。\n看镜未须论晚达，著书应不为穷愁。\n却怜戎马伤心日，回望中原独倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冼秋官日录","author":"庞尚鹏","text":"寡和曾闻白雪歌，杜门删述晚尤多。\n草玄已撤眠云榻，乞巧争传制锦梭。\n岁晏苔衣环石榻，月明池藻漾苍波。\n青山千载留君住，崖石留题不忍磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆亡弟次韵","author":"庞尚鹏","text":"少耽青史逐名流，何意修文地下游。\n忍听悲歌闻薤露，不堪乘醉过西州。\n有怀填海嗟何及，无力回天可自由。\n却忆夜堂谁共语，数声啼鸟万山幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻曹谏议抗疏改官次韵书感话","author":"庞尚鹏","text":"颓流谁更问回澜，涉世空劳作说难。\n短褐有怀怜杞国，尺书无路达长安。\n谏垣敢避雷霆近，帝德原同天地宽。\n明烛卷帘看疏草，忽惊炎海夜生寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬交亲枉过","author":"庞尚鹏","text":"江村烟水望中分，绿树芳阴百鸟群。\n倚竹窥园曾避客，得鱼呼酒喜逢君。\n寻幽常藉溪边草，持赠偏多陇上云。\n共向北山留短榻，免教猿鹤笑移文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和邹明府登何太仆定性楼","author":"庞尚鹏","text":"仰扪南斗倚高楼，俯视长江天际流。\n三岛尽从城里见，五湖疑向月中游。\n閒床听雨金鸡晓，短阁栖云碧树秋。\n东望剡溪风雪夜，可谁乘兴共移舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻宫车晏驾怆然书感","author":"庞尚鹏","text":"惊传遗诏下江村，忍向邮亭问改元。\n紫禁何年回御辇，孤臣无地报深恩。\n遗弓怅望龙髯远，负扆争看帝座尊。\n相国古来重伊傅，先朝耆旧几人存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈右崧大守将赴京过予晚酌","author":"庞尚鹏","text":"金井梧桐叶正稀，漫劳车马款荆扉。\n天高海岳含秋色，风起桑榆送夕晖。\n对酒不堪闻羽檄，忧时谁复念宵衣。\n争看威凤翔千仞，好向朝阳览德辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"萤","author":"庞尚鹏","text":"淡月疏星天气凉，飞飞长似逐人忙。\n风高便入金鳌阁，雨暗还来绿野堂。\n谁笑浮生同腐草，夜看青史借馀光。\n相逢若问行藏事，莫怨人间白昼长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"百舌","author":"庞尚鹏","text":"百鸟谁能辨姓名，翩翩鸾凤喜和鸣。\n如何盖日频相语，似为前身怨未平。\n词客共怜鹦鹉赋，行人休问鹧鸪声。\n若教倚树深藏舌，应笑攒眉过此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谭永明中秋枉顾谈时事因及高堂白发感而赋此","author":"庞尚鹏","text":"曾忆当年赋远游，马前明月几中秋。\n披襟正忆都亭梦，倚剑宁忘国士忧。\n翠竹江村频下榻，晚山斜日共登楼。\n应怜寸草心长在，莫向风尘早白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陪陈忠甫饮谭别驾宅用韵","author":"庞尚鹏","text":"万里层阴暗赤霄，鼎湖霜冷草萧萧。\n惊传夜猎还西内，怅望鸡鸣视早朝。\n三殿日高丹扆在，九原云断翠华遥。\n飘零独有湘皋恨，愁对秋风拂早貂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对新月怀卢方伯往金山登高","author":"庞尚鹏","text":"扁舟何处访松楸，日落长江急暝流。\n林壑风高天似水，星河霜冷月如钩。\n山间篱落黄花坞，海上芙蓉白雁秋。\n试问青莲李居士，几时还向竹溪游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日溪山野望折简邀同游","author":"庞尚鹏","text":"海上孤城急暮砧，霜凄枫叶气萧森。\n豪吟懒读长门赋，稳卧谁论季子金。\n芳草荆扉生计拙，青山明月主恩深。\n烽烟不入渔樵路，共醉湖亭十亩阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵酬和关紫云过访草堂","author":"庞尚鹏","text":"平生文藻擅江东，犹向青山访谢公。\n彩笔凌云誇作赋，石亭移榻笑书空。\n竹梧池馆寒烟碧，风日桑榆照照红。\n怅望西京谈往事，数声羌笛月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜友人过访","author":"庞尚鹏","text":"曾骑白鹿访仙踪，飒飒东风吹短蓬。\n石室閒居聊自遣，竹根高卧许谁同。\n溪边有路通愚谷，陇上何人问德公。\n斗酒夜谈天路远，万方秋思满壶中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈丹泉枉顾别后寄怀","author":"庞尚鹏","text":"东山曾订十年期，翠竹江村入梦思。\n世路正怜投檄早，故园偏恨见君迟。\n牢笼天地心犹壮，呼吸烟霞鬓未丝。\n欲向云房借飞舄，便从华岳访希夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"迓陈洛南尚书致仕","author":"庞尚鹏","text":"海上青山识贵臣，御炉香染赐衣新。\n黄扉共忆还家日，黑发应怜报主身。\n南北频年劳梦寐，渔樵何计静风尘。\n洛阳司马归来早，不是名园独乐人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠何广文之任乐昌","author":"庞尚鹏","text":"草绿邮亭露正稀，弹冠重拂旧儒衣。\n地连衡岳春风早，花发韶阳彩燕飞。\n北郭云霞开绛帐，东园松菊觐朝晖。\n即看海上文星耀，五色中天贯紫微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠医师","author":"庞尚鹏","text":"悬壶长揖玉堂仙，细饮尝甘橘井泉。\n神农往矣不可问，华佗妙处谁能传。\n采药玄岩降虎豹，烹丹石鼎生云烟。\n共论医国回天手，调燮须从未病年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日寿家慈用韵","author":"庞尚鹏","text":"翩翩青鸟侍琼筵，王母瑶池席更前。\n长奉板舆回日毂，早持鲈脍进江鲜。\n春晖万里明萱草，荆树千花荫玉田。\n曾忆太行山下路，拥旌悬望白云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜喜晴","author":"庞尚鹏","text":"千金一刻此良宵，积雨初晴乐事饶。\n白兔影寒横紫塞，玉楼光动逼丹霄。\n人间灯火鳌山近，天上风云辇路遥。\n正喜太平巡幸少，广陵何地驾虹桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日泛海值风雨","author":"庞尚鹏","text":"偏喜青春作伴游，雨中谁驾李膺舟。\n天低水郭藏深树，风急沙汀起白鸥。\n草色渐看三月景，潮声先到百花洲。\n临流洗耳人何在，莫向高山问许由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日山房次韵和陈洛南尚书","author":"庞尚鹏","text":"绿阴丛里浣花村，懒性朝来学灌园。\n地僻烟霞藏竹坞，夜凉风雨到柴门。\n敢论宣室虚前席，犹记黄封赐上尊。\n自爱閒林专一壑，树声长送水潺潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"度岭谒张文献次韵","author":"庞尚鹏","text":"立马重登丞相祠，岩头高阁五云垂。\n中原早识胡雏乱，大驾何劳蜀道思。\n天送荆州风雨梦，世传金鉴帝王师。\n虬松似指长安路，岭上年年发北枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读佛书","author":"庞尚鹏","text":"却恨前身不是僧，当年谁许共传灯。\n轮回世外三千界，业障人间百万层。\n出定慈云开慧日，坐忘炎海结春冰。\n澄心本属吾儒事，面壁空斋对惠能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日怀陈洛南尚书","author":"庞尚鹏","text":"艳阳池馆夏生寒，偏喜清时共挂冠。\n夜雨高吟频遣寄，稻田新熟愿加餐。\n交游转觉蓬山远，魂梦犹惊蜀道难。\n最是故园风景好，满天明月似长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕前二日检佛书寄怀卢方伯","author":"庞尚鹏","text":"法林持钵听龙吟，萧瑟凄风送暮砧。\n对境肯教忘梵语，逢人曾遣寄乡音。\n天浮海虹秋声动，云掩郊原雨气深。\n乞巧楼前新月好，待君乘兴共登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸酉中秋忆前辛酉兹夕锁院校文","author":"庞尚鹏","text":"鸣鹄凌风欲上天，夜凉星斗望中悬。\n若教法眼空尘世，休向词垣数岁年。\n紫陌豪华俱梦幻，故人南北各风烟。\n屠龙绝技终何补，谁逐虚名乞世怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园中秋思用韵和卢方伯","author":"庞尚鹏","text":"秋声迢递到江滨，鱼鸟相看意转亲。\n云净林塘天似水，月移河汉夜留人。\n壶中信有金丹在，头上从教白发新。\n平地风涛何足问，东山曾许藉閒身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":12092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]