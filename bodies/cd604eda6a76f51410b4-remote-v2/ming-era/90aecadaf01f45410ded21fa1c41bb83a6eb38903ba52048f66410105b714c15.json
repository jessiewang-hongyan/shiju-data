[{"title":"送李二尹复任枣强","author":"邓林","text":"青年平岁上天梯，名在黄金榜上题。\n梁栋终归廊庙用，凤鸾暂向棘林栖。\n红亭劝酒歌三叠，绿野行春雨一犁。\n他日政成膺鹗荐，好来同听早朝鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周升及第荣归","author":"邓林","text":"南闱较艺辟贤关，鏖战文场捧檄还。\n琼宴醉酣花婀娜，亲庭归舞锦斓斑。\n朝云暮雨江南景，员峤方壶海上山。\n莫负故人霄汉约，早来鸣佩接清班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑文著别弟还家省父","author":"邓林","text":"昨宵梦绕漆园椿，晓起那堪对白云。\n作客不如归故里，趋庭便欲见严君。\n百盘世路羊肠曲，九派江流燕尾分。\n惆怅二难相别处，碧天寒雁正呼群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观诸贡士就试","author":"邓林","text":"圣朝四海同文日，士子三年大比时。\n总谓风云宜进步，那知衡鉴不容私。\n周垣设棘防严密，内院分经较阅迟。\n愿得真才辅明主，万方臣庶乐雍熙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弥封","author":"邓林","text":"桥门新水绿生漪，犹带春冰入砚池。\n笔陈横斜风雨作，题缄深密鬼神疑。\n方当圣主求贤日，正是儒臣报国时。\n浅陋屡陪衡鉴末，但存公道答相知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐","author":"邓林","text":"铜龙漏下鼓初严，群动无哗睡正甜。\n明月窥人穿瓮牖，薄寒欺我透筠帘。\n宦情暂向公馀遣，诗思多从坐久添。\n试问灯花何太喜，恩波揭晓定重沾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早起","author":"邓林","text":"西窗月晓迥沉沉，帘幕低垂院宇深。\n琴几睡寒金篆鸭，井床啼彻绿衣禽。\n海棠顿醒酣春梦，葵藿同倾向日心。\n忆在凤池当此际，天香满袖听纶音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题唐太守云水巷","author":"邓林","text":"吴山万朵玉芙蓉，君住苍崖东复东。\n触石云从林杪起，穿岩泉与海门通。\n九霄已遂从龙志，千里新成润物功。\n追想旧游归未得，弦琴为尔写松风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"兰室为前人赋","author":"邓林","text":"闲倚东风玩国香，碧蕤漙露湿荷裳。\n□□□□岁寒友，此日重登君子堂。\n沅芷有芳同气味，蜀桐无谱自宫商。\n题诗再订金兰约，贫贱之交不可忘。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴江长桥图","author":"邓林","text":"东南水患说姑苏，谁作飞梁锁太湖。\n馀势直从江海泄，奇功疑有鬼神扶。\n疏林隐约渔村远，巨浸微茫钓艇孤。\n老我登临犹未远，临风嬴得一披图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽刘处士","author":"邓林","text":"身前欲立百年基，身后俄成一局棋。\n痛哭阿爷并阿丈，可怜佳妇与佳儿。\n漆灯永照长眠处，世事休论未死时。\n若向堂封歌些曲，石人无泪也含悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽汤处士","author":"邓林","text":"百年世故倦营营，梦熟黄粱唤不醒。\n委巷朝传蒿里曲，空山夜泣草堂灵。\n佳儿欲养悲风木，先友论交叹晓星。\n我有兴时冠盖约，可怜耆旧早凋零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽伍骥处士","author":"邓林","text":"鹤发初添感岁华，俄闻君死发如鸦。\n此生修短谁能料，往事凄凉我独嗟。\n墓石恐无人秉笔，籯金幸有子承家。\n一杯恨掩面山土，宿草年来几度花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽嘉遁黎先生","author":"邓林","text":"西风拂面泪潸然，哭为斯文一问天。\n倏去忽来谁予夺，有才无寿孰拘牵。\n梦回圆泽三生石，笑破昌黎五鬼船。\n寿夭穷通何必较，只今犹是未□前。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭从弟惟清","author":"邓林","text":"旅邸淹淹抱病身，逢予哭子倍伤神。\n攒眉灯下愁如织，分手江头泪满襟。\n望汝成名光我祖，奈天无意在斯人。\n劬劳未报身先死，肠断高堂白发亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"剑江书屋","author":"邓林","text":"自牧先生隐者流，买书筑室大江头。\n文光半夜腾奎壁，剑气常时贯斗牛。\n未信无官居鼎鼐，悬知有子学箕裘。\n购求不管籯金尽，直欲声名等邺侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出京赴谪所","author":"邓林","text":"曾将方寸质神明，亦有封章达帝廷。\n葵藿素心空自赤，乾坤老眼为谁青。\n一身去国风中叶，万里携家水上萍。\n最恨君亲俱未报，闲愁博得鬓星星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入杭","author":"邓林","text":"游遍江湖未到杭，不知人世有天堂。\n六桥花柳丹青画，九陌楼台锦绣妆。\n北米南柴誇物产，朝歌暮燕乐时康。\n逐臣何幸蒙宽恤，到此浑忘见异乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"僦屋里仁坊","author":"邓林","text":"谪居何处好逍遥，仁里深深远市嚣。\n夜色满帘湖上月，秋声到枕海门潮。\n上林鹓侣空相忆，南浦鸥群苦见招。\n覆载无私天地德，暂容閒散在渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起","author":"邓林","text":"夜凉如水梦魂清，病体今朝渐觉平。\n下榻倚阑成久立，出门移杖欲闲行。\n贫来只有青毡在，老至难禁白发生。\n百岁几何开口笑，强吟聊遣□中情。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄同寮胡司封","author":"邓林","text":"舜日尧天被八垠，顾余无地可容身。\n谗邪未许投豺虎，正直何缘信鬼神。\n风烛心灰犹有泪，市交头白只如新。\n吟成不敢高声颂，千里缄封寄故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠张考功起复","author":"邓林","text":"风虎云龙庆会秋，庙堂方急栋梁求。\n东山已为苍生起，老范宁忘天下忧。\n当代儒林推独步，昔年郎署忆同游。\n疏慵自分湮沈老，莫误常何说马周。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恒斋","author":"邓林","text":"雷风相薄卦为恒，有客斋居揭此名。\n观象直穷言外意，守玄深得静中情。\n鸟啼花落时光改，雨覆云翻世故轻。\n我有满怀松柏操，欲来同结岁寒盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"友竹为钱塘邵士亨赋","author":"邓林","text":"俗交翻覆似波澜，晚节谁同守岁寒。\n自与此君为莫逆，长教童子报平安。\n故情时逐清风至，古调频将绿绮弹。\n我亦后园求仲侣，烦将青眼一相看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送福建祝副使入觐","author":"邓林","text":"九重城阙郁崔嵬，万国诸侯玉帛来。\n江汉朝宗归海纳，明良庆会自天开。\n仪韶彩凤鸣阿阁，捧日红云接上台。\n朝罢论功颁宠锡，应知雨露满头回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"台州程太守贤京国旧游也考绩相遇于钱塘叙旧之馀赋此识别","author":"邓林","text":"西风搔首雪盈颠，邂逅惊看各问年。\n老我一身难报国，嗟君五马又朝天。\n居民有裤歌廉范，坐客无毡叹郑虔。\n此去功名知远大，相思常在五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乾坤一草亭为江都罗谨文赋","author":"邓林","text":"乾坤纳纳浩无穷，万有都归逆旅中。\n两物鴳鹏谁大小，百年乌兔自西东。\n琴书晓润红蕖雨，窗户秋含翠蓧风。\n此际好怀何处看，吟边遥忆浣花翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"罗江八景","author":"邓林","text":"见说罗江景最幽，渔樵耕牧任优游。\n偶将佳话传江海，便有新诗入唱酬。\n绀宇月明钟韵远，画桥风细柳丝柔。\n仙槎若许乘潮到，先到祠前谒故侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴山书屋为钱塘蒋祉赋","author":"邓林","text":"市嚣何处着书声，山转城南不断青。\n花飏春红来砚沼，岚浮暖翠入帘屏。\n为儒有幸逢昭代，擢第应须趁妙龄。\n我有他年云路约，题诗为谢草堂灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郑良载父勉子诗韵","author":"邓林","text":"皓首纷如羡壮夫，喧啾群里凤雏孤。\n功名已许青年得，骨鲠悬知绝代无。\n胪韵声声传殿陛，云梯步步接天衢。\n一经不与籯金换，始信而翁识远图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和瞿宗吉见赠诗韵","author":"邓林","text":"抱琴无处觅知音，萍水那期偶盍簪。\n试拂朱弦□古调，胜将罗带结同心。\n陈遵爱客常投辖，□□□□□□金。\n□□□□□□□，□□□□□□襟。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"静斋为仁和任安赋","author":"邓林","text":"閒居城市澹无营，客去柴门尽日扃。\n车辙不从□□过，书声惟有近邻听。\n筠帘半卷尘凝榻，蔓□□生翠满庭。\n久静由来当一动，伫看鹏运起沧溟。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"爱萱堂为仁和陈敬赋","author":"邓林","text":"□□因筑树萱堂，万叶千花长砌傍。\n吁日凤凰□□淡，梳风鹦鹉翠翎长。\n板舆慈母春行乐，綵衣□儿日献觞。\n为问南陔如可续，□□□和□□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"致政□□□□子","author":"邓林","text":"致政归来两鬓霜，可堪哭子泪汪汪。\n钟情政自悲王衍，无嗣真宜悯卜商。\n问寝屏帷秋夜永，过庭踪迹雨苔荒。\n劬劳未报生身德，想在泉台恨更长。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽石泉陈处士","author":"邓林","text":"山风吹冷薜萝衣，泉石膏肓不可医。\n丹鼎久遗龙虎诀，碧梧栖老凤凰枝。\n徒闻天上招长吉，无复琴边遇子期。\n欲起彭殇问修短，九原瞑目恐无时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻馀姚黄大尹美政以诗寄之","author":"邓林","text":"见说姚江令尹贤，公堂无事日鸣弦。\n六曹井井遵成法，四野熙熙乐有年。\n利器已从盘错辨，长材终向庙廊迁。\n九重宵旰忧民切，暂屈牛刀割小鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和唐元祯镇越堂诗韵","author":"邓林","text":"城中崛起卧龙堆，城外诸峰唤欲来。\n天造无馀千里国，云连勾践九成台。\n月明绛节吹箫过，春尽朱幡冕露回。\n生聚日繁疆土辟，鸟田宁复有□莱。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乐静堂为春长馆羽士陆处勤赋","author":"邓林","text":"蓬门一径入烟霞，云是山阴道士家。\n除地作坛朝紫极，拥炉看火炼丹砂。\n鹅群只换羲之帖，蟹眼时烹陆羽茶。\n我亦人间无事者，故来同赏碧桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠萧山苏大尹","author":"邓林","text":"太薇移次郎星见，执法来为百里侯。\n笔下霜寒惊吏胆，琴边善政起民讴。\n功名不负男儿志，宵旰能分圣主忧。\n他日循良如见传，萧山端可继中牟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游静慈寺分韵得冬字","author":"邓林","text":"客况萧条逼暮冬，远寻方外散尘踪。\n路从西子湖头入，人在香山寺里逢。\n看到梅花吟正苦，沽来竹叶味偏浓。\n老僧旧是斯文友，嬴得相过不厌重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永思堂","author":"邓林","text":"生我劬劳德未酬，百年岁月去如流。\n羹藜季路思何及，风木乐鱼恸未休。\n南涧采蘋供俎豆，西山酌酒酬松楸。\n堂前因种啼乌树，啼得慈乌也白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪堂二首为慈溪孙璚赋 其一","author":"邓林","text":"雪花堆白满阶除，有客开窗夜读书。\n只欲清光辉简册，不知寒气袭襟裾。\n闭门僵卧成何事，披氅闲行谩自如。\n年少寸阴须竞取，肯辞勤苦废三馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪堂二首为慈溪孙璚赋 其二","author":"邓林","text":"映雪先生迹已遐，肯堂重为令孙誇。\n香芸插架开千叶，玉树临阶缀六花。\n璀灿光中书半启，吾伊声里鼓三挝。\n蹇予曾主程门者，抚卷题诗兴转嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送两浙朱运使考绩二首 其一","author":"邓林","text":"春早江南柳未生，送君无物赠君行。\n寒松自有凌霜操，秋水元来彻底清。\n煮海坐看成政绩，朝天伫见沐恩荣。\n临风莫叹头如雪，廊庙登庸属老成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送两浙朱运使考绩二首 其二","author":"邓林","text":"江心春水漾仙槎，江上春风吹柳花。\n劝酒阳关方再叠，发船画鼓已三挝。\n五云楼阁神京壮，万里烟霞仕路赊。\n故旧相逢如见问，骅骝无力服盐车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50497,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠小儿科胡医士","author":"邓林","text":"种杏年来已作林，知君利济及人深。\n婴孩疾痛未能语，父母爱怜空有心。\n大德两仪生万物，神丹一匕直千金。\n旅途相遇无由报，谩把新诗满卷吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50498,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东瓯送别","author":"邓林","text":"五雨摇风宿雨晴，万艘鸣橹海潮平。\n楼台烟树东瓯景，山水舟车北客程。\n绿酒红亭销别恨，银笺彩笔写离情。\n明时正亦需胶鬲，未许鱼盐老此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50499,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游南屏不偶","author":"邓林","text":"兰佩荷裳竹箨冠，清癯无奈朔风寒。\n饭堂钟罢来何晚，雪夜舟回兴已阑。\n俗状尘容劳意马，天光云影动情澜。\n石头有路终须到，共听吾师说六观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50500,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖山饯别送杭庠皮司训","author":"邓林","text":"三年作宦在钱塘，曾共湖山醉几觞。\n今日独为千里客，何时重上百花航。\n吟边风月诗名旧，望外关山仕路长。\n贵贱穷通从此别，交情珍重莫相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50501,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送彭参议父归崇明诗二首 其一","author":"邓林","text":"篮舆就养到薇垣，共羡君家五福全。\n令子才名方显日，先生寿算古稀年。\n归心夜切松楸梦，行李朝登罨画船。\n作客何如乡土乐，莼羹香美鳜鱼鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50502,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送彭参议父归崇明诗二首 其二","author":"邓林","text":"青衫乌帽鬓如霜，人是金闺老夕郎。\n行李远来因念子，归心难系为思乡。\n雪晴江岸梅初放，岁晚河桥酒正香。\n祖帐莫辞同一醉，明朝云树杳相望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50503,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钱塘杨仲和画梅赞","author":"邓林","text":"罗浮仙子玉为肌，姑射神人练作衣。\n隔竹传香风细细，当窗藏影雪霏霏。\n广平赋就名尤重，和靖诗成和者稀。\n谁为写真传不朽，杨郎妙笔夺天机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50504,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访都司郝经历","author":"邓林","text":"曾侍同朝听玉音，行藏回首叹升沉。\n长才又入元戎府，往事空悬逐客心。\n四海交游谁可托，孤山风月自成吟。\n寻盟欲下通名刺，犹恐侯门似海深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50505,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"章亚卿徐通政奉使交阯还次钱塘会于公馆赋诗赠之三首 其一","author":"邓林","text":"瘴雨收晴毒雾开，星轺远自日南回。\n皇华每动征夫念，薏苡无劳谤者猜。\n八桂云横山似画，三湘露落水如苔。\n可人多少途中景，想有新诗取次裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50506,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"章亚卿徐通政奉使交阯还次钱塘会于公馆赋诗赠之三首 其二","author":"邓林","text":"天子恩威被四夷，廷臣衔命远驱驰。\n王风浩荡烟岚熄，春意昭苏草木知。\n马援镇蛮摽柱日，赵陀朝汉筑台时。\n使还休更言边事，干羽雍容舞玉墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50507,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"章亚卿徐通政奉使交阯还次钱塘会于公馆赋诗赠之三首 其三","author":"邓林","text":"圣主弘推一视仁，轺车万里远颁恩。\n蛮酋俯伏天威重，命使昂藏国体尊。\n摽柱宁劳分地界，乘槎直许到河源。\n纤毫不带归时物，为洗千年薏苡冤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50508,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访道题湘江吴都挥使令","author":"邓林","text":"至人风采邈难扳，何意相逢梦寐间。\n黄石故来寻孺子，青牛暂为驻函关。\n朝霞夕露餐三秀，坎永离铅炼九还。\n得道须来言辟谷，君亲恩义重如山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50509,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"永思堂为前人赋","author":"邓林","text":"三载裹麻制易终，百年孤露恨难穷。\n劬劳未报生身德，富贵长思汗马功。\n纵使天荒并地老，誓全子孝与臣忠。\n题诗拟续南陔什，只愧才疏语不工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50510,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽黄淑人","author":"邓林","text":"数字荣封写绛罗，淑人归柩故山阿。\n闺门懿行看铭笔，道路哀声听挽歌。\n贤母自当随子贵，遐龄不享谓天何。\n紫薇花露朝朝滴，孰与劬劳血泪多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50511,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"越溪渔乐为源善余大尹赋","author":"邓林","text":"我家住在海门关，只隔君家水半湾。\n泥泞相邀骑马去，潮平共看打鱼还。\n白鳞鲙细供春酒，红尾羹香奉晚餐。\n鹏运扶遥归未得，披图聊尔一开颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50512,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题刘司训集美手卷","author":"邓林","text":"纱厨髹几净无埃，宝篆清香锦帙开。\n墨迹远从先世得，诗筒多自翰林来。\n青毡旧是传家物，大手真成补衮才。\n珍重平泉佳草木，百年留与子孙培。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50513,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别漳州关通判","author":"邓林","text":"禁钟声里五更残，鸣佩曾联玉笋班。\n老我作官鱼上竹，多君判郡笔移山。\n黄金已尽难为客，旧学相推祇厚颜。\n会别匆匆情未已，承恩□长□南还。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50514,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]