[{"title":"沙门岛四首 其二","author":"孙蕡","text":"白银堆里涌仙台，岁晚登临亦壮哉。\n妖蜃吐烟成海市，巨鳌擎石作蓬莱。\n金蕤翠羽空中见，贝阙珠宫水底开。\n凯奏北旋应有日，同游俱是济时才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沙门岛四首 其三","author":"孙蕡","text":"立占沧溟碧玉簪，蜃楼高过百花岩。\n兴来落笔才无敌，老去从戎力尚堪。\n诗卷长年留海内，梦魂清夜绕江南。\n纶音早晚需前席，日望登莱使者骖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沙门岛四首 其四","author":"孙蕡","text":"沙门沧洲洲上山，九河碣石高巉岩。\n云来气通巫女峡，月出光映蓝田关。\n宫前彩凤驾车下，祠底白龙行雨还。\n浴凫飞鹭沙阳立，疑是青琐晨朝班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与谢县丞坡山联句","author":"孙蕡","text":"几年来作交州客，今日方登第一楼。\n万顷烟波涵碧落，四山云气蔼清秋。\n瑶台鹤驾排空下，石室丹光傍井浮。\n蓬岛依微天路近，凌风直欲访丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送董文启出宰江夏","author":"孙蕡","text":"委佩晨看拜玉除，西游真食武昌鱼。\n王孙碧草秋无际，仙掌金茎露下初。\n今日才名须卓茂，当年词赋说相如。\n登临若对南楼月，待尔宾鸿寄尺书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽李樵云","author":"孙蕡","text":"相国灵舆閟九京，桓桓松柏表佳城。\n风云已际兴王运，雨露偏伤孝子情。\n一代文章遗汗简，千秋彝鼎勒勋名。\n平原宾客今谁在，独泻椒浆带泪痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"红菊二首 其一","author":"孙蕡","text":"龙山九日宴斜曛，万朵秋香散彩云。\n醉岸纶巾对芳物，西风应识旧参军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"红菊二首 其二","author":"孙蕡","text":"灵均且莫怨清醒，楚水朝云炫落英。\n宿酒未平佳节过，西风吹帽最多情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨菊二首 其一","author":"孙蕡","text":"熹微衡宇露初乾，九月江南动早寒。\n肺气暂平新断酒，天香零落醒中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨菊二首 其二","author":"孙蕡","text":"三径松门掩翠萝，白鹇飞去晓霜多。\n天随艇子无人共，寥落寒香奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"红梅二首 其一","author":"孙蕡","text":"瑶池王母阆风西，夜宴群仙锦绣帏。\n月落参横天向曙，醉骑丹凤绕湖归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"红梅二首 其二","author":"孙蕡","text":"丹青学写寿阳姿，艳杏仙花嫩柳枝。\n犹记醉邀何水部，淮西歌吹旧台池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48497,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨竹九首 其一","author":"孙蕡","text":"洞庭春尽水溶溶，锦瑟轻寒起卧龙。\n行客欲投苍水佩，乱云遮断九疑峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48498,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨竹九首 其二","author":"孙蕡","text":"谁拈秃笔写凄迷，乱石横江碧玉低。\n犹记画船初泊岸，落花时节郭公啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48499,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨竹九首 其三","author":"孙蕡","text":"虹光云影绿参差，赤壁艅艎晚更移。\n春雨乍晴烧玉版，鲥鱼上水鳜鱼肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48500,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨竹九首 其四","author":"孙蕡","text":"阳云台下曲江头，一径笙箫万顷秋。\n莫向晚凉歌白纻，碧丛深处有钩辀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48501,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨竹九首 其五","author":"孙蕡","text":"秋寒万玉倚云青，青入君山白凤翎。\n偷得云和千载曲，夜深吹与老龙听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48502,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨竹九首 其六","author":"孙蕡","text":"昨夜春雷震楚山，箨龙惊觉锦斑斑。\n蛾眉老客禅心在，应化横江老鹤还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48503,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨竹九首 其七","author":"孙蕡","text":"岩上烟消见日光，歌声遥隔水云乡。\n渔翁莫汲清湘绿，留取高枝宿凤凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48504,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨竹九首 其八","author":"孙蕡","text":"澧水春阴午未消，寒梢低护木兰桡。\n天涯风物馀空翠，应是英皇泪点飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48505,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"墨竹九首 其九","author":"孙蕡","text":"葳蕤万玉晓撑风，应是清溪野水东。\n更画接篱颠倒着，嫩凉添我绿阴中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48506,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王孙图二首 其一 挟弹","author":"孙蕡","text":"谁拈金弹倚青骢，鞍面开元结束同。\n好似华清二三月，绿阴笼仗入离宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48507,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王孙图二首 其二 听鸟","author":"孙蕡","text":"东风驰道直如弦，琪树春阴护马鞯。\n从幸少年初赐锦，数声啼鸟落花前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48508,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宣和枯木翎毛","author":"孙蕡","text":"上林芳树蔼崇宣，澹墨疏翎腻粉笺。\n何似白榆栖冻雀，萧萧风雪满祁连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48509,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"折枝桃花图","author":"孙蕡","text":"扁舟独上武陵溪，花暗渔郎路欲迷。\n忽见画图惊一载，东风憔悴一枝低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48510,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃花白炼","author":"孙蕡","text":"沅江江口武陵溪，翠影红香粉翅低。\n为向东风烦寄语，莫将春色到安西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48511,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨妃出浴","author":"孙蕡","text":"浴罢温泉体未乾，敛襟非为玉肌寒。\n胡儿一掐痕犹在，只恐三郎着眼看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48512,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨太真对镜图","author":"孙蕡","text":"舞鸾金背隐清光，中有开元堕马妆。\n一线枕痕春色浅，夜来知是梦渔阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48513,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梨园按乐","author":"孙蕡","text":"白雪飞香玉作城，霓裳度曲按新声。\n东风吹醒渔阳梦，一段春愁画不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48514,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村妪牛图","author":"孙蕡","text":"玉环迷恨马嵬坡，出塞明妃泪更多。\n何似阿婆牛背稳，春风一曲太平歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48515,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昭君五首 其一","author":"孙蕡","text":"莫怨婵娟堕虏尘，汉宫胡地一般春。\n皇家若起凌烟阁，功是安边第一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48516,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昭君五首 其二","author":"孙蕡","text":"晓来毡帐理铅华，对镜偷怜复自誇。\n如此玉颜君不顾，更从何处选良家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48517,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昭君五首 其三","author":"孙蕡","text":"阊阖龙鳞开玉陛，嫖姚马影度旌旗。\n谁怜汉道升平日，是妾漂流薄命时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48518,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昭君五首 其四","author":"孙蕡","text":"回使殷勤莫寄辞，君王此去苦相思。\n容华自昔能倾国，只为风沙远别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48519,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昭君五首 其五","author":"孙蕡","text":"玉颜啼泪湿胡沙，东望长安不见家。\n月满穹庐愁似海，强将心事付琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48520,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题葡萄","author":"孙蕡","text":"骊龙弄影照高秋，万斛明珠露气浮。\n还忆玉人歌舞散，紫驼银瓮出凉州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48521,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂画十首 其一","author":"孙蕡","text":"曾记东林信杖藜，远公门对石桥西。\n长松月落猿声歇，赢得青山似虎溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48522,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂画十首 其二","author":"孙蕡","text":"罗浮山水沧江曲，水连清溪树连屋。\n旧雨仙翁乘兴去，荔枝应过杨梅熟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48523,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂画十首 其三","author":"孙蕡","text":"溪云漠漠树宛宛，不是三湘定辋川。\n花气晓迷桃叶渡，虹光夜贯米家船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48524,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂画十首 其四","author":"孙蕡","text":"小瓮松花已泼醅，缚柴门子夜长开。\n天寒动有王猷兴，应放清溪夜艇回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48525,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂画十首 其五","author":"孙蕡","text":"惊涛一叶海门关，秋浅吴风未着斑。\n千载宦游今有画，澹烟斜日小孤山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48526,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂画十首 其六","author":"孙蕡","text":"不见扁舟采芰荷，天风何处度清歌。\n芒鞋此日云门寺，应是鉴湖秋水多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48527,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂画十首 其七","author":"孙蕡","text":"望湖亭上倚清秋，水落吴城树色幽。\n何日松巢招五老，九江同泛钓鱼舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48528,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂画十首 其八","author":"孙蕡","text":"爱此名山似蜀中，山如斑笋树如龙。\n瞿塘几日漩涡小，欲驾扁舟访赤松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48529,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂画十首 其九","author":"孙蕡","text":"沾恩几载入承明，云冷渔矶白鹤盟。\n忽见新图被山恼，欲辞簪组乞归耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48530,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂画十首 其十","author":"孙蕡","text":"白鹭洲前野艇归，钓鱼矶上绿杨垂。\n人间野况都如画，奈此穷生薄禄为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48531,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四皓图","author":"孙蕡","text":"只合餐芝老万山，谁教鹤发动龙颜。\n蛾眉对酒歌鸿鹄，怨入商于紫翠间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48532,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画梅四首 其一 风","author":"孙蕡","text":"游龙扶风飞上天，明珠万斛争春妍。\n师雄醉梦飒惊觉，罗浮月堕西湖边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48533,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画梅四首 其二 烟","author":"孙蕡","text":"梨花香冷月阴阴，青女横陈万玉林。\n绣箔珠帘人不见，相思无地着春心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48534,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画梅四首 其三 雪","author":"孙蕡","text":"小国佳人窈窕娘，春风环佩素绡裳。\n千年独抱灵均怨，夜结明珰献楚王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48535,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画梅四首 其四 月","author":"孙蕡","text":"仙楼十二敞春风，千树桃花似锦红。\n瑶水玉娥清宴罢，素鸾归去月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48536,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松","author":"孙蕡","text":"双松如盖倚云长，曾忆匡山问草堂。\n拂石坐来龙影湿，半陂春雨茯苓香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅","author":"孙蕡","text":"天风吹堕白霓裙，五岭云深路不分。\n千丈玉阶寻步袜，碧床香落始知君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"尝草图","author":"孙蕡","text":"蒺藜勾吻总青青，惭愧春山草木荣。\n几欲骑龙叩天阙，绿章祈雨护黄精。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舞马图","author":"孙蕡","text":"露鬣风鬃锦彩鲜，登床胡旋更翩翩。\n青骡祇识连云栈，不解衔杯献御筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其一","author":"孙蕡","text":"海内才名五十年，圣恩荣许晚归田。\n金华父老如相问，曾是瀛洲第一仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其二","author":"孙蕡","text":"新赐宫衣雪色如，归荣况及早春初。\n公卿祖帐都门外，人道风流似二疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其三","author":"孙蕡","text":"二十馀年侍禁闱，趋朝常早晚归迟。\n春坊一掬临分泪，记得垂髫受业时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其六","author":"孙蕡","text":"万丈文光北斗悬，清名不独域中传。\n东夷买得潜溪集，已向扶桑石上镌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其八","author":"孙蕡","text":"几逆龙鳞进治安，朝回只说圣恩宽。\n小儒日侍丝纶阁，不得囊中奏稿看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其九","author":"孙蕡","text":"令子内庭书制诰，佳孙复作序班郎。\n一门三代沾恩泽，更着锦衣归故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其十二","author":"孙蕡","text":"盖世文章未是雄，真纯卓有古人风。\n赐金长是沽春酒，醉杀邻家桑苧翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其十三","author":"孙蕡","text":"乞与山童润笔钱，归时正及早春先。\n玉堂分取薇花树，种在双溪浅水边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其十五","author":"孙蕡","text":"不用黄牛教子孙，为儒三世受君恩。\n却将视草堂前笔，归去题诗水竹村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其十六","author":"孙蕡","text":"山僧野客莫相过，碑板人间刻已多。\n从此黄庭不须读，自开池水养群鹅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其十七","author":"孙蕡","text":"荣归诏许老山坰，火枣交梨养性灵。\n秘府图书翻阅尽，却从方士借丹经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其十九","author":"孙蕡","text":"后学无师误少年，在于蕡也更堪怜。\n联班欲上陈情表，留取先生住讲筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其二十一","author":"孙蕡","text":"祖考荣封宠数优，君王亲为制词头。\n临流好起云章阁，高压清风八咏楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其二十二","author":"孙蕡","text":"羽衣来自大江西，打得旌阳铁柱碑。\n闻道珊瑚缠乐石，碧潭清夜老龙嘶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其二十三","author":"孙蕡","text":"建业钟残禁漏稀，九重天上早朝时。\n玉堂清署风霜冷，常恐先生入奏迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其二十四","author":"孙蕡","text":"凤翥龙飞御制文，人间未见墨花新。\n恩荣独为词林重，亲向宫门赐老臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送翰林宋先生致仕归金华二十五首 其二十五","author":"孙蕡","text":"晚出金闺望故乡，芙蓉峰影月苍苍。\n归途跨得银鞍马，原是天闲小乘黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓居传小楼怀以成","author":"孙蕡","text":"故人何处舣兰舟，谁念西窗客滞留。\n赖有嫦娥怜寂寞，流光偏照读书楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临清轩题壁","author":"孙蕡","text":"思君几日不相见，特向城南问隐居。\n巢鹤不惊流水静，一炉香炷数编书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆得四首 其一","author":"孙蕡","text":"忆得垂髫少小时，青灯黄卷日相随。\n于今放浪江湖上，一段閒情总付诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆得四首 其二","author":"孙蕡","text":"忆得初年不解愁，药栏花径日风流。\n临池书罢黄庭帖，走马城南觅旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆得四首 其三","author":"孙蕡","text":"忆得栖迟泉石间，衡门无事锁常关。\n日长书困南窗下，燕子惊回梦里闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":48562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]