4d8e9316029b79","dynasty":"明"}},{"title":"留犊图","author":"张宁","text":"人道时苗事，怀廉不近情。\n犹胜尸素去，行李属归程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7842,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"葡萄","author":"张宁","text":"闻道乘槎客，相携到汉庭。\n何缘尝草日，先自入医经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7843,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小景","author":"张宁","text":"风漾钓丝轻，兰舟不碍行。\n一声长笛晚，江静月孤明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7844,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"沈石田山水为于景瞻题","author":"张宁","text":"溪山阒无人，凝泊如有待。\n满眼古清秋，舟轻不堪载。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7845,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"向汝隆画鸡冠花扇图","author":"张宁","text":"十年归旧隐，不听蚤朝啼。\n却向蓬蒿里，昂藏对竹栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7846,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林良花鸟二首 其一","author":"张宁","text":"竹树晚凄凄，天寒相傍栖。\n春风疏雨歇，飞上画楼啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7847,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林良花鸟二首 其二","author":"张宁","text":"宿食共相投，枯荷野渚秋。\n平生急难意，何用急时求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7848,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"向汝隆云山图","author":"张宁","text":"烟树双溪晓，云霞万壑春。\n不知林径里，谁是草玄人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7849,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹石图送宣天然","author":"张宁","text":"白石一拳小，脩篁数叶多。\n万山冰雪里，试看此如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7850,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题幽鸟","author":"张宁","text":"上苑花如锦，雕笼翡翠新。\n脩篁邻野树，啼鸟一般春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7851,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宋太子墨竹二绝 其一","author":"张宁","text":"御墨龙香出内庭，几枝疏影拂前星。\n当时粉绘多零落，惟有寒梢似旧青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7852,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宋太子墨竹二绝 其二","author":"张宁","text":"想见青宫拂素丝，清风雅操玉参差。\n一般翰墨归人世，还有章怀太子诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7853,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄故知二首 其一","author":"张宁","text":"潮落平沙小棹移，雨晴烟柳远含滋。\n非熊好梦知何日，回首沧洲动远思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7854,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄故知二首 其二","author":"张宁","text":"秦溪山色绕林扉，积雨初晴野树微。\n故旧相逢元有约，海鸥何事复惊飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7855,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日寄刘世亨侍御","author":"张宁","text":"去年重九共追游，今日西风两地秋。\n遥想登高南望远，茱萸满眼不胜愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7856,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏梅二首寄沈孟渊 其一","author":"张宁","text":"断肠诗思满江南，别后姿容总一般。\n料得林逋惯相惜，肯教寂寞过春寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7857,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏梅二首寄沈孟渊 其二","author":"张宁","text":"孤根春暖雪初消，香满西湖第六桥。\n最是怀人窗下意，怕看明月上寒梢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7858,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和魏侍御雨中见寄五首 其一","author":"张宁","text":"秋来日日望天晴，晓雨初收晚又阴。\n乡思较来千倍苦，满庭衰草候虫吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7859,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和魏侍御雨中见寄五首 其二","author":"张宁","text":"客怀牢落向秋深，诗酒浑无往日心。\n何处寒砧且停手，近来情绪已难禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7860,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和魏侍御雨中见寄五首 其三","author":"张宁","text":"云开乍觉雨声乾，落日登临望眼宽。\n白发双亲应念我，悔将书剑入长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7861,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和魏侍御雨中见寄五首 其四","author":"张宁","text":"落落惟应鲍叔知，逢时仍抱失时悲。\n长杨宫殿新成赋，欲献犹疑是古词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7862,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和魏侍御雨中见寄五首 其五","author":"张宁","text":"双鬓逢秋病转多，野田风雨欲成河。\n鹊巢不是当年好，天上佳期近若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7863,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"彦敬山水","author":"张宁","text":"万壑千峰一道通，震雷声里掣飞龙。\n诗人莫赋三千丈，五老峰高未易穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7864,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"飞鸣宿食四雁 其一","author":"张宁","text":"孤云寒影共悠扬，塞北江南万里长。\n最是日斜疏雨歇，半拖秋色到衡阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7865,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"飞鸣宿食四雁 其二","author":"张宁","text":"白羽横空落未休，一声风露九江秋。\n不知谁是愁中客，梦断天涯十二楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7866,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"飞鸣宿食四雁 其三","author":"张宁","text":"旅食天涯不计年，离离禾黍满秋田。\n江湖野味多如许，露饮风餐只自便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7867,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"飞鸣宿食四雁 其四","author":"张宁","text":"黄芦苦竹晚萋萋，风静寒塘自在栖。\n边塞有书归未得，夜深无梦到辽西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7868,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画四首 其一","author":"张宁","text":"朔风吹雪满天涯，景物依依逼岁华。\n见说孤山春意蚤，欲将清兴赋梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7869,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画四首 其二","author":"张宁","text":"沙碛春深苜宿肥，锦鞍新卸远行归。\n胡儿不敢窥边郡，手挽弓梢看雁飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7870,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画四首 其三","author":"张宁","text":"不用青衣马上扶，苍松白石即吾庐。\n太平时节家家醉，不是高阳旧酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7871,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画四首 其四","author":"张宁","text":"小队喧呼禁路声，百花随马玉山横。\n醉中尚忆青楼约，分付前叮缓㘘行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7872,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"园梅盛开二首 其一","author":"张宁","text":"暖透孤根雪乍消，冰花万点缀寒条。\n寻幽欲寄山中客，忘却西湖有断桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7873,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"园梅盛开二首 其二","author":"张宁","text":"记得罗浮入梦时，遗芳不减旧丰姿。\n今朝童子推窗看，报道西风雪满枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7874,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王修撰雊鹆图","author":"张宁","text":"不用高飞逐走蓬，鸣鸠乳燕自相从。\n日斜庭院春声歇，一树樱桃细雨中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7875,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题馀不春社诗二首 其一","author":"张宁","text":"五风十雨荷皇天，桑满墙阴稻满田。\n记取年年寒食节，大家先办赛神钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7876,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题馀不春社诗二首 其二","author":"张宁","text":"白叟黄童半醉醒，酒阑连袂踏歌行。\n百年盛事先珍重，为写新诗托姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7877,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"画犬","author":"张宁","text":"金铃不动夜沈沈，足下生氂氄亦深。\n庭院风閒帘帨静，戏随蝴蝶吠花阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7878,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林溪六景 其一 东林夜月","author":"张宁","text":"风静猿啼月满山，东林夜色共人门。\n柴门正与清光对，分付山童且莫关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7879,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林溪六景 其二 前村牧笛","author":"张宁","text":"草绿平原春雨歇，花残曲径夕阳明。\n朝来暮去年年似，吹散荣华是此声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7880,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林溪六景 其三 后浦渔歌","author":"张宁","text":"欸乃新声度远汀，烟消日出树冥冥。\n年来悟得沧浪意，长近西堂竹下听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7881,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林溪六景 其四 蓉溪秋水","author":"张宁","text":"溪头寒水没沧洲，溪上芙蓉一色秋。\n远道西风人不见，采芳空倚木兰舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7882,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林溪六景 其五 花村酒旆","author":"张宁","text":"寥寥一犬吠柴扉，花飏东风淡落晖。\n行客不须重借问，寻春时有醉人归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7883,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"林溪六景 其六 溪桥残雪","author":"张宁","text":"日暖风寒野色昏，危梁半露水添痕。\n行吟索共梅花语，春在寒梢剩几分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7884,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仙女图二首 其一","author":"张宁","text":"碧空云净石坛清，自启琅函拜月明。\n一道灵风王母降，山童莫认许飞琼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7885,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仙女图二首 其二","author":"张宁","text":"蕊珠经罢玉香消，白鹤来时树影摇。\n环佩一声人不见，满天风露月中霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7886,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"罗浮梦","author":"张宁","text":"月落参横夜五更，荒园睡觉不胜情。\n铅华满世皆春梦，赢得罗浮野梦清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7887,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"仙女图","author":"张宁","text":"谢却红尘学道妆，黄庭一卷日初长。\n小真未解清虚意，时折閒花供石床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7888,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画三首 其一","author":"张宁","text":"瀑布穿云出涧碨，行人指点似天台。\n琼楼玉宇迷前路，惟有桃花逐水来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7889,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画三首 其二","author":"张宁","text":"松桧阴沈积雨馀，凉飙荐爽入郊墟。\n小窗孤榻青灯夜，疑是昌黎训阿符。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7890,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画三首 其三","author":"张宁","text":"杳霭昏黄夜泊船，鹧鸪声里雨如烟。\n秋风不见平安信，梦断湘江又十年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7891,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]