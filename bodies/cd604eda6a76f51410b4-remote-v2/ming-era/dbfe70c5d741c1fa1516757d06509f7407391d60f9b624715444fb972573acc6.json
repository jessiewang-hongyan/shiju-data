[{"title":"雨中观云阳秀色","author":"顾璘","text":"灵峰出云昼濛濛，秀色不与他山同。\n望之紫翠拂天起，宛转数叠青屏风。\n单车飘飘转山麓，寒水盈盈带冰绿。\n冠缨相傍尘自清，十里搴帷意难足。\n灵药定隐韩伯康，白石或放初平羊。\n待余捐佩游五岳，此地愿借开丹房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57193,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋云阳绝句拟作灵光亭","author":"顾璘","text":"玉琢云阳练折溪，虚无灵气隐虹霓。\n山川未许含光燄，化出天宫太乙藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57194,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"车中杂言十首 其一","author":"顾璘","text":"前鱼弃龙阳，馀桃罪子瑕。\n请看恩易尽，毋矜色胜花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57195,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"车中杂言十首 其二","author":"顾璘","text":"虎背危可骑，龙鳞逆堪折。\n宛转母子间，亦掉茅焦舌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57196,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"车中杂言十首 其三","author":"顾璘","text":"西域开何益，雄哉汉武才。\n殷勤谕父老，书生非本怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57197,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"车中杂言十首 其四","author":"顾璘","text":"耕莘起三聘，钓渭载后车。\n遇合非汤文，终然老农渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57198,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"车中杂言十首 其五","author":"顾璘","text":"本无戒饮意，累月断开壶。\n怪得阮嗣宗，祗念黄公垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57199,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"车中杂言十首 其六","author":"顾璘","text":"山鸟啄山果，飞鸣高下丛。\n适性乃真乐，岂羡黄金笼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57200,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"车中杂言十首 其七","author":"顾璘","text":"事向动中至，思从静馀生。\n昼夜每递代，内境何由清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57201,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"车中杂言十首 其八","author":"顾璘","text":"一日脩一事，王官森如林。\n逝矣运甓子，谁哉念分阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57202,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"车中杂言十首 其九","author":"顾璘","text":"穷岩数椽屋，名姓系王民。\n穷年办租税，不见官府仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57203,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"车中杂言十首 其十","author":"顾璘","text":"襜帷稳于榻，行炉火微温。\n不知外寒暖，侧听舆人言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57204,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新晴","author":"顾璘","text":"积雨寒生冻，新晴令借春。\n日穿深树白，雪点远峰新。\n马足偏宜道，狐裘不恋人。\n崔巍衡岳上，堪礼祝融神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57205,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自叹","author":"顾璘","text":"自叹百年客，离尘复入尘。\n关山南徼路，风雨独行身。\n向物情俱淡，还家梦已频。\n须知千白璧，难买一阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57206,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"安仁晓发","author":"顾璘","text":"扬旌伐鼓晓匆匆，三五明星碧汉东。\n寒日映霜浮白雾，长林穿谷起鸣风。\n舟车路绕天涯遍，簿领期催岁序终。\n苦竭衰羸元不惜，祗愁民社竟无功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57207,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"看山词","author":"顾璘","text":"生在江南地，始游湖南山。\n江南看山山在地，湖南山在青天间。\n高者大岳衡山灵，散为诸山无尽青。\n天门玉帝窥彷佛，旌节导引龙鸾形。\n飞泉喷薄石齿齿，洞房窈窕云冥冥。\n忽然浩荡开巨壑，万顷波涛摇洞庭。\n邈哉鬻熊开国年，昭平丧乱殊纷然。\n伍员申胥小竖子，国运兴败随之迁。\n仲尼书社竟难就，白公岂知日月贤。\n接舆识威凤，乃歌灵德衰。\n河滨鸣犊不相待，却望龟蒙归去来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57208,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒岳神庙 其一","author":"顾璘","text":"万山如马赴湘沅，衡岳超腾势独尊。\n派别昆崙蟠楚蜀，位均嵩岱奠乾坤。\n车书一统提封远，云雨诸方德泽存。\n七十二峰高屏翰，天皇元自重南藩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57209,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒岳神庙 其二","author":"顾璘","text":"九成台殿神居迥，百里松杉石道赊。\n海内名山惟五岳，天南星汉此孤槎。\n来随使节脩禋祀，愿祝威灵保帝家。\n主器皇储新定位，千秋万岁乐无涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57210,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登祝融峰宿上封寺 其一","author":"顾璘","text":"人间长望祝融峰，天上今登赤帝宫。\n山势总朝星极北，海门遥见日华东。\n清严辛借千林雪，浩荡真披万里风。\n莫笑题名岩石畔，高情聊尽百年中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57211,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登祝融峰宿上封寺 其二","author":"顾璘","text":"芒屩桃筇踏紫岑，蔚蓝天外快幽寻。\n烟霄逼近星临大，海色微茫日出深。\n下界俯看惟一气，浮名回首澹无心。\n神仙总谓非灵骨，岩穴真看敞素襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57212,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登祝融峰宿上封寺 其三","author":"顾璘","text":"冰雪高岩树半残，罡风侵夜不胜寒。\n斋临老衲翻经石，步上仙人礼斗坛。\n望远正须峰万丈，探奇何惮路千盘。\n清欢窃荷皇天惠，强健衰年最所难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57213,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上下诸峰间作 其一","author":"顾璘","text":"紫盖峰头弄白云，朱陵洞口谒玄君。\n湘妃竹点苍梧泪，神禹碑传玉薤文。\n未遂著书藏石室，空嗟提剑傍人群。\n中林散发何由得，徙倚西岩到日曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57214,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上下诸峰间作 其二","author":"顾璘","text":"蓝舆晓御八风轻，重叠青山接续迎。\n画壁倚空看石势，玉琴喧涧得泉声。\n人疑天上重开地，峰向云中自现名。\n试傍紫霄瞻绛阙，崔巍如见九重城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57215,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上下诸峰间作 其三","author":"顾璘","text":"岩松挺挺大夫身，石涧泠泠静者神。\n云盖不迷韩刺史，书堂曾隐李山人。\n英贤旧迹风俱逝，旌节初游雪正新。\n唤取邹阳吹暖律，愿教寒谷转阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57216,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上下诸峰间作 其四","author":"顾璘","text":"丹山碧水傲仙真，绝涧荒途隔世尘。\n道学共尊胡父子，衣冠能避晋君臣。\n长镵采药知何日，白发游峰有夙因。\n肯许移家分一壑，为君当面解朝绅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57217,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上下诸峰间作 其五","author":"顾璘","text":"南岩元居大火功，霜寒松桂自青苍。\n穿林马踏烟霞色，煮涧茶分药草香。\n天畔星缠窥翼轸，雪馀风景忆朱张。\n衰残万事皆慵懒，独有登临兴尚狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57218,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上下诸峰间作 其六","author":"顾璘","text":"玉书金箓纪先贤，野老都无一二传。\n石上剜苔寻古刻，岩阴开雪引灵泉。\n销沈盛事堪长叹，料理閒情只自怜。\n问讯邺侯三万轴，不知埋向若峰前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57219,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"方广寺 其一","author":"顾璘","text":"寒溪十里带残晖，古木阴阴一径微。\n僧饭汲泉和雪煮，客堂明烛见云飞。\n田开白石分千叠，山拥青屏匝四围。\n行尽衡峰多佛宇，无如此地好归依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57220,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"方广寺 其二","author":"顾璘","text":"一宿霞门便出山，泉声雪色送君还。\n金书尚荷君王宠，石髓难医俗士颜。\n洞府逍遥尘土外，冠裳惭愧去留间。\n武皇亦说捐妻子，何事吾人过尔悭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57221,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"往来道中漫兴 其一","author":"顾璘","text":"青山夹道引行舆，百叠屏风步步殊。\n雾窟尽容玄豹隐，风林时听白?呼。\n赋传台岭行仍远，啸比苏门兴更孤。\n安得龙眠李居士，写余衡岳访真图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57222,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"往来道中漫兴 其二","author":"顾璘","text":"糁径清霜午未消，背岩寒日照难交。\n天分福地藏朱鸟，地拔危峰出紫霄。\n虞舜巡来群后会，祝融居处百灵朝。\n江湖满眼千山小，始信人间五岳高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57223,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"往来道中漫兴 其三","author":"顾璘","text":"壮观平生属此游，快心真胜拜通侯。\n虚空秀岭呈丹凤，陆地仙人隐率牛。\n木食草衣那送老，酒瓢诗版暂忘忧。\n不知曲曲寒溪水，洗耳何人据上流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57224,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"往来道中漫兴 其四","author":"顾璘","text":"登山不自见奇峰，平地方怜紫翠重。\n石壁半含残雪冷，烟林斜映夕阳浓。\n深溪绝岸危桥接，古洞无仙乱草封。\n问法拟投兰若宿，回风先报隔林钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57225,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"往来道中漫兴 其五","author":"顾璘","text":"水木相牵野念兴，草堂归梦绕钟陵。\n久知白石饥堪赖，况说青山盗不憎。\n老陟乌台真失计，生图麟阁本非能。\n锄瓜壅芋生涯在，底用求田向越僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57226,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"往来道中漫兴 其六","author":"顾璘","text":"晴峰早布雪迎人，归路仍飘雨浥尘。\n地主莫言乘暇日，山灵真为借佳辰。\n穷高一览乾坤小，志怪初惊耳目新。\n信道宣尼登泰岳，吴门白马望皆真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57227,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"衡台对雪有怀","author":"顾璘","text":"衡山吹雪散瑶华，且喜湖南岁事嘉。\n云暗高峰回旅雁，水寒平野噪饥鸦。\n殊方腊尽仍为客，好景情多倍忆家。\n江左故人金帐底，听歌谁肯念天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57228,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"排山晓发","author":"顾璘","text":"五更吹角起征夫，百里传餐戒晚厨。\n乌府自惭成忝窃，熊轓那敢惜驰驱。\n尘埃长远云生榻，瘴疠全消雪满须。\n惠爱倘闻千里洽，江湖从遣一身孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57229,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冒雪往会钱邢二使君","author":"顾璘","text":"五更吹角起，征夫均有程。\n祗今湘水棹，何异剡溪情。\n瑞采千林雪，皇华万里旌。\n天涯分袂意，留语记芝城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57230,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"祁阳道中雪 其一","author":"顾璘","text":"南雪常传到地消，湘东今见踏琼瑶。\n水铺练带平争白，树簇银花静不摇。\n野色倍添梅萼宠，土膏先动草心骄。\n天涯莫自伤迟暮，早报丰穰慰寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57231,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"祁阳道中雪 其二","author":"顾璘","text":"潇湘之景清且妍，雪中行吟更可怜。\n乱峰插地万圭出，高鸟背云孤鹤鶱。\n连林古木各生意，一望江天弥素烟。\n惜哉相如未始见，作赋漫为梁园传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57232,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"熊罴岭望雪","author":"顾璘","text":"熊罴岭头望雪花，千林万壑玉交加。\n若为扫尽浮云色，夜拥狐裘看月华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57233,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜至祁阳以录囚行","author":"顾璘","text":"篝火荧荧夹道明，夜江寒浸百家城。\n天王不弃南荒远，直布阳和及死生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57234,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"祁阳怀故通参程德和","author":"顾璘","text":"特达千人俊，醇良万石君。\n遗书留学阁，宿草满荒云。\n后辈推耆旧，南曹奉德薰。\n颇伤身后事，不愧墓前文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57235,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题笑岘亭","author":"顾璘","text":"浯山窃笑岘山碑，也自磨厓向水涯。\n陵谷变迁皆瞬息，不缘金石有名垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57236,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"污尊","author":"顾璘","text":"元公古天民，污尊表其德。\n堂堂刺史身，甘隐漫郎宅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57237,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元颜书院用钱给事韵","author":"顾璘","text":"元颜惊代杰，精爽结灵云。\n运屈英雄力，山垂琬琰文。\n皇图天自远，世变雪徒纷。\n倚杖看碑客，悽然仰德芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57238,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"漫郎宅用邢侍御韵","author":"顾璘","text":"炯炯舂陵作，丹心白日明。\n几人能体国，遗爱在专城。\n使节临湘楚，心香仰法程。\n看公流浪迹，宠辱底须惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57239,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"辱奉钱邢二使君高山寺留别","author":"顾璘","text":"别思凭高集，征途向粤遥。\n岭梅春候转，湘浦雪痕消。\n斧钺随王命，蛮夷拱圣朝。\n澄清联辔去，双璧听新谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57240,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朝阳岩奉饯钱邢二使君","author":"顾璘","text":"水府攀跻险，云房结构重。\n晴筵移瓮蚁，胜侣得人龙。\n古刻曾谁在，今游不易逢。\n黄昏仍秉烛，明发有离踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57241,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十二月念六日出永州值迎春新霁","author":"顾璘","text":"江城鸣鼓晓迎春，霁日和风应候新。\n苍帝早矜时令正，紫微元握斗枢均。\n梅花弄粉相将出，柳眼舒青太剧真。\n曝背老翁皆报罢，莫愁穷谷有悬鹑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57242,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"全州唐宗周文世范访于芝城行台","author":"顾璘","text":"雪后扁舟拨棹来，湘江何减剡溪怀。\n灯前软语浓于酒，庭下春光早报梅。\n棠树尚留听讼处，柳山长忆读书台。\n殷勤白首相逢地，不尽行台五夜杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57243,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"澹岩题石","author":"顾璘","text":"玄云结宇，白日回光。\n神灵所辟，仙真斯藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57244,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游澹岩","author":"顾璘","text":"楚南多名洞，澹岩绝幽奇。\n崇山豁中空，石壁支云欹。\n匪伊神灵凿，讵备房栊施。\n夹径周窈窕，盘折乃尽窥。\n天窗白日皎，百用宛相宜。\n初闻避世士，倾家乐兹移。\n世往祗虚宇，好事纷游嬉。\n森罗尽深刻，漫读知为谁。\n唯输振代豪，屹尔高名垂。\n以兹叹物理，不朽由人为。\n微生亦蛙黾，难与千古期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57245,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"潇江泛舟入道州","author":"顾璘","text":"潇江清且驶，舍车泛轻舠。\n稍恬荡漾趣，暂谢登顿劳。\n石脚插潭腹，危峰叠争高。\n牵夫不可度，孤猿攀树号。\n滩水日倾泻，触石怒成涛。\n游鱼掷影过，尾赤惮所遭。\n绝流百具备，嗟尔将焉逃。\n信哉法网密，民生始嗷嗷。\n周公有令典，无取斯鞅曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57246,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁酉除日道州作二首 其一","author":"顾璘","text":"驱驰惊道远，衰白感年除。\n浮世皆为客，他乡亦可居。\n酒杯从仆进，风物向春舒。\n眷恋残更漏，挑灯展旧书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57247,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁酉除日道州作二首 其二","author":"顾璘","text":"老来怜岁月，除夕每题诗。\n正自悲摇落，那堪怨别离。\n家园繁节物，耆旧俨光仪。\n赋就宜春帖，淋漓映户施。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57248,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戊戌元日道州作二首 其一","author":"顾璘","text":"圣寿冈陵固，蛮荒岁序新。\n熊轓随使节，虎拜庆王春。\n礼乐周天洽，阳和播物均。\n愿明四门目，照尔万方人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57249,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戊戌元日道州作二首 其二","author":"顾璘","text":"潇水碧于玉，潇山青满天。\n褰帷临胜地，驻节度新年。\n岭近梅花盛，林和桂叶妍。\n空庭无讼牒，端坐咏诗篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57250,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舂陵怀古二首 其一","author":"顾璘","text":"道丧馀千载，天南得异人。\n玄图开太极，绝学指迷津。\n庭草长交翠，池莲不断春。\n愿因风月地，潇洒挹公神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57251,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舂陵怀古二首 其二","author":"顾璘","text":"舂陵贼退作，洒血示中襟。\n狼狈干戈际，勤惓禹稷心。\n溪清甘寄宅，运去阻为霖。\n工部惟良语，仁贤痛至今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57252,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"全州蒋司空景明来会于道州白鸡营","author":"顾璘","text":"虎榜同袍旧，鱼书隔岁盟。\n关山千里驾，鸡黍百年情。\n容鬓非前少，勋名属晚成。\n湘南谢安石，早出为苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57253,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新晴","author":"顾璘","text":"献岁晴偏好，新晴暖即随。\n树怜迟旭映，草爱惠风吹。\n远岫分青霭，平池荡绿漪。\n缘原车马健，偏与省方宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57254,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月岩","author":"顾璘","text":"灵岩象唯月，盈昃巧为妍。\n正揭团圆影，旁分上下弦。\n龙开厓畔石，日转窍中天。\n雕琢须神力，伊谁测帝先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57255,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"人日宁远山行三首 其一","author":"顾璘","text":"人日轻云漏日华，高山晴景应吹笳。\n东皇挈取阳和气，散满衡湘十万家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57256,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"人日宁远山行三首 其二","author":"顾璘","text":"万岭千峰蔽楚天，盘厓石路马啼穿。\n秦人住向桃源里，犹想重华问俗年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57257,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"人日宁远山行三首 其三","author":"顾璘","text":"上下邮程祗在山，白云苍雾苦跻攀。\n閒情独被梅花觉，引领春风破客颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57258,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谷日桂阳山行雨","author":"顾璘","text":"谷日风兼雨，农家抱岁忧。\n占书期不验，王政戒先脩。\n野色抽寒麦，春声唤暝鸠。\n行人本田父，荷笠爱驱牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57259,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郴州十三夜试灯","author":"顾璘","text":"今夕何夕春灯明，此乡何乡非我城。\n物华满眼各殊态，月色映阶无限情。\n梅花乍逢已烂熳，萱草欲发初分明。\n却忆故园诸酒伴，锦屏围夜坐吹笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":57260,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]