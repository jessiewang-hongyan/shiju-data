[{"title":"过隋故宫二首 其二","author":"欧大任","text":"金雁波沉彩树凋，汴河东入广陵遥。\n倚窗曾赋风前楫，惊枕空悲梦里雕。\n宝帐烟花迷陇月，锦帆云雨听江潮。\n吴公台下雷塘路，多少高楼怨玉箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送丁户部庸卿谪延平","author":"欧大任","text":"昔从燕市怅离群，何意邗江复送君。\n半刺独怜千里去，悲歌宁遣众人闻。\n天垂碣石看孤雁，日落长安隔五云。\n谁念为郎头已白，七闽今逐仗波军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小至日院馆督试诸士和苏端公","author":"欧大任","text":"阳律将回玉琯风，吹嘘今在柏台中。\n杨州幸拜单车早，汉殿谁如八使雄。\n大国诗从歌卫得，诸生论颇借秦工。\n悬知推毂归朝去，门下何人似孔融。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王氏兄弟扶侍还关西","author":"欧大任","text":"云拥仙翁羽节开，大家新赋并堪裁。\n天空华岳青莲出，日射关门紫气来。\n白发骑牛何处过，玉笙驻鹤几时回。\n茅家兄弟西归后，还忆玄洲海上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄朱灌甫宗尉","author":"欧大任","text":"苍茫秋色满中原，千骑如云飞盖尊。\n自笑谈高留稷下，未缘虚左过夷门。\n鸣笙此地连缑岭，修竹何年傍兔园。\n不为游梁称赋客，汉家经术重王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王内翰绍传请告还琼州省觐","author":"欧大任","text":"梅花岭上有秦台，万里南征作赋才。\n乘传路寻铜柱去，趋庭人自玉堂来。\n天边渺渺龙楼迥，海上冥冥蜃阁开。\n紬史名家谁健笔，北扉持橐待君回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答关伯玉","author":"欧大任","text":"雪中孤骑过津头，忽忆江南旧酒俦。\n讲肆且将留马队，隐君宁得问菟裘。\n山梅腊尽谁开阁，海雁春来尚满洲。\n五斗折腰君莫笑，十年书剑在罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送莫子良大参入汴","author":"欧大任","text":"诏下家园起谢公，东京今勒保釐功。\n山河分陕歌棠早，宾客游梁赋雪雄。\n紫气函关行部内，白云嵩岳出封中。\n青春傥折三花树，持献君王万寿宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜同方明府集天宁寺阁","author":"欧大任","text":"禅堂邀客酒如霞，列炬光中散夕鸦。\n云涌珠宫千劫火，天开银阙万人家。\n卷帘淮海皆成玉，吹笛江城半落花。\n闻道碛西胡骑过，此时边将出龙沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元日雪晴","author":"欧大任","text":"庭中寒色映朝衣，夹仗春风似禁扉。\n珠缀偶从淮树望，玉鳞先傍汉宫飞。\n登台天女花难见，授简词人赋亦希。\n执戟小臣容上寿，曾闻方朔侍彤闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日同方明府尊经阁课诸生","author":"欧大任","text":"皂盖行春一骑回，翩翩衿佩待君来。\n壁池水绕朱琴净，书阁风迎绛帐开。\n天禄五经寻故事，明堂三礼待雄才。\n竞看桃李生新色，燕谷谁知玉律催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王氏园同文德承吴孝观玉兰花","author":"欧大任","text":"素艳何年出苧罗，西园春色过江多。\n汉滨欲请风前佩，洛浦曾淩月下波。\n翠羽忽惊梅萼梦，璚花犹听竹西歌。\n洗妆更有持觞客，芳草天涯奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻方侍御德新按关西以谏事放还","author":"欧大任","text":"恩深逐客赋南征，太白苍苍匹马行。\n直以孤忠酬圣主，岂将谏草慰平生。\n秦台汉畤悲歌日，陇雪洮云遗世情。\n君自九华支一枕，夜来飞梦入承明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀徐子与读书山中","author":"欧大任","text":"阙下曾思侍从臣，风尘不到五湖春。\n且从茅氏开金涧，谁为徐卿送玉麟。\n浊酒可能容我辈，浮名未肯傍时人。\n钓船亦有夷犹兴，何处汀洲采白蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卞园赏牡丹","author":"欧大任","text":"阊阖春来汉诏宽，淮南草木总含欢。\n云中朱簿围丝障，月下华林引翠冠。\n紫灞烟光留客饮，赤城霞色照人寒。\n清歌半似西游侣，那得花前不醉看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻王元美诣阙上书","author":"欧大任","text":"行乞当年雪满途，衔冤怜尔叩阍呼。\n天乎曹氏融何罪，世有山涛绍不孤。\n国士只今收涕泪，馀生宁得傍江湖。\n征西部曲思公子，请为君王北射胡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"资政书院试士答卫杨州","author":"欧大任","text":"授简三原后院东，南阳爱士似王公。\n衣冠坐满凝香处，桃李阴连讲幄中。\n洛守自能求贾谊，蜀人谁不颂文翁。\n江淮自昔推经术，何论文章一荐雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泰州光孝寺阁怀五台山秀上人","author":"欧大任","text":"青骡东去久无踪，谁道人间有赤松。\n孤阁云帆京口寺，万家烟树海陵钟。\n白榆历历今何远，玉舄翩翩不易从。\n欲问真如慰岑寂，禅房明月在千峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答吴道南","author":"欧大任","text":"江头百里尺书劳，甓社湖边白雁高。\n梦落舟航寻夜雪，病携宾从看秋涛。\n移家颇种先生柳，闭户应深仲蔚蒿。\n短发萧萧思见汝，几回扶策望西皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄致政太宰咸宁王公","author":"欧大任","text":"渭水秋风白发新，廷中曳履识元臣。\n共传一代摛文笔，自许三朝报主身。\n天禄书成题姓字，东都人去偃经纶。\n挥金知有盈觞酒，倦客何由一到秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨州得小孙潘少承椷诗寄贺喜而有作","author":"欧大任","text":"五年奔走客燕都，老作江阳一腐儒。\n忆母家园惭负米，抱孙官舍喜悬弧。\n旧书颇解藏三箧，清酒谁能送百壶。\n惟有故人诒秀句，独留明月似秦珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送余太史还朝","author":"欧大任","text":"千里趋还供奉班，御炉烟里觐龙颜。\n紬书东观秋槐里，劝讲西清昼漏间。\n几奏登歌归乐府，何年史记托名山。\n柏梁盛事空相忆，只有淮南桂可攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹西亭送沈二十八北游","author":"欧大任","text":"醉把吴钩赠别离，行逢汉主好文时。\n布衣且待公车诏，奏赋先蒙狗监知。\n马饮桑乾流水急，诗题碣石片虹垂。\n相逢若问江都客，萧瑟秋风自下帷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答伦大理绍周见怀","author":"欧大任","text":"淮南蓟北久离居，双鲤迢迢尺素书。\n梦入竹斋欹枕后，诗成棘署按章馀。\n閒知出世心偏快，老去干时术已疏。\n同舍惟君今侍从，碧云千里思何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋日卧病答黄希尹约游大明寺不赴","author":"欧大任","text":"苜蓿斋中一病身，井桐叶坠报萧晨。\n枉期车马携尊酒，虚负烟霞笑角巾。\n谢客能寻开社事，远公还待折腰人。\n秋风九曲西池约，为扫隋家辇路尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王兴化子慎应诏还户部","author":"欧大任","text":"汉家凫舄本仙踪，秋色翩翩向九重。\n江县万花行处遍，河堤千柳别时浓。\n为郎白首逢停辇，谒帝彤扉梦听钟。\n闻道去思留片石，昭阳犹似岘山峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀潘少承","author":"欧大任","text":"登楼何处望吾乡，书札经年鬓欲苍。\n莫以江都怜董相，谁能洛涘学潘郎。\n海边暮雨枫千树，淮上秋风雁几行。\n彩笔青云须努力，蹉跎容易老星霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泰州九日登望海楼怀梁公智黄幼章","author":"欧大任","text":"把菊偏惊久客情，淮河西下蓟鸿声。\n楼船万里沧波涌，砧杵千家朔吹生。\n绝塞频年犹住牧，故乡多难未休兵。\n君看天地干将气，不为悲秋泪满缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵驿送王元美兄弟归吴中","author":"欧大任","text":"孤臣去国意何如，客路秋风广柳车。\n双阙恩曾怜狗马，五湖归不为鲈鱼。\n江头颇问观涛赋，霜后应题寄橘书。\n从此东南思二美，暮天搔首一踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黄淳父见寄","author":"欧大任","text":"萧瑟君怜楚调同，篇诗遥寄海楼东。\n五湖心共飘蓬远，十载名因说剑雄。\n倚仗柴门看暮雨，挥毫江馆送秋鸿。\n西阊北固风烟接，从此相寻钓艇中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日阁上集","author":"欧大任","text":"五岳嵯峨秋色新，修然高阁出风尘。\n孤鸿日杳中原路，浊酒天全傲吏真。\n落帽谁容趋府客，佩萸偏忆住山人。\n青云欲借卢敖杖，莫笑支离一病身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄李郡博子荩","author":"欧大任","text":"先朝释褐省郎中，谪宦犹居白雪堂。\n齐客风流推稷下，鲁儒文学在吴乡。\n衔鱼已听诸生报，割肉曾闻侍从狂。\n东望姑苏秋雁渺，尺书何日到江阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过归安丞殷君旧读书处","author":"欧大任","text":"陶公非但爱吾庐，泛览流观十载馀。\n映雪古梅开户牖，哦松新水绕阶除。\n传家箧里三坟字，散帙林中二酉书。\n问讯当年居士宅，只今驷马在门闾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁卯九月十七日同汪山人黄中舍集杨汝德园赏菊是日牡丹忽开一花江北深秋未见寒色然亦异矣为纪一诗","author":"欧大任","text":"江上园林片片霜，君家暖艳照山房。\n似怜傲吏归彭泽，故遣佳人出洛阳。\n绕院三千黄蛱蝶，临池七十紫鸳鸯。\n淮南宾客逢今日，歌吹宁辞送百觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广陵遇蔡职方元卿","author":"欧大任","text":"燕阳经术似河汾，汉署风流尚见君。\n金在曾求千里足，剑沉谁识七星文。\n词人海上青云色，迁客淮边白雁群。\n何事相逢贪握手，西来消息几时闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文寿承见过同游平山堂得中字","author":"欧大任","text":"燕台芳草思何穷，谁道维扬此会同。\n海上涛声生赋后，江南山色落杯中。\n楚天高映三城雪，朔气长飘万里风。\n还共题诗秦博士，醉来双目送飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀方明府上许京师","author":"欧大任","text":"河梁征骑不能攀，忆尔追趋鹓鹭班。\n日出晴云开北阙，雪消春色满西山。\n垆烟缥缈彤墀上，佩玉参差綵仗间。\n召对亦知明主意，江阳人望赐金还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄汪中丞伯玉","author":"欧大任","text":"楼船百万旧征南，闽海风涛久已谙。\n谁为伏波怜薏苡，空劳渔父问江潭。\n灯前自拂青萍剑，松下今抽白玉簪。\n只恐鸣驺将入谷，未容精舍事瞿昙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李于鳞补浙宪并简徐使君子与二首 其一","author":"欧大任","text":"十载归耕历下田，门生多是石渠贤。\n儒林经术推师授，宪府声华借使权。\n登阁涛飞沧海雪，挥毫霞起赤城天。\n飘零赋客频收召，行见甘泉侍从年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李于鳞补浙宪并简徐使君子与二首 其二","author":"欧大任","text":"君家越观望秦稽，揽辔今寻甲楯栖。\n使者宁知荣绣斧，词人应自问丹梯。\n扁舟先向苕边过，斗酒还从箬下携。\n后夜不须占太史，德星高映五湖西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答沈汝渊","author":"欧大任","text":"江门一苇果谁功，海内名儒更有公。\n皓首诗书齐祭酒，白衣岩穴汉司空。\n入门看竹家家雨，临涧听松日日风。\n谁谓俗尘俱不染，翛然唯许此心同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送戚总戎","author":"欧大任","text":"翩翩北去拥双旌，受诏新屯细柳营。\n骠骑暂劳平虏策，楼船曾识伏波名。\n三边烽燧先飞檄，万里风云独请缨。\n司马斋中推第一，穰苴门户世谈兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"汪禹乂吴膺之李鸣卿吴虎臣朱道光邬汝翼诸子集斋中得杯字","author":"欧大任","text":"摄山采药始能回，邗上繁华尚欲开。\n卷幔烟霞千嶂落，挥毫宾客五湖来。\n清言已下高斋榻，斜日还衔浊酒杯。\n奇字自惭无可问，悬知三径长莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"顾季狂见过即还吴中","author":"欧大任","text":"西来何意共持觞，十载知名自大梁。\n过赵竟辞双璧赠，入关宁用百金装。\n三江艇在谁相问，五岳书成尚未藏。\n闻道伯鸾将欲隐，皋桥流水是吴乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送衡仲还家兼报明叔经季","author":"欧大任","text":"长亭官柳拂征鞍，淮海炎天过雨寒。\n路出江湖怜尔去，家贫升斗为亲欢。\n鲊惭鱼吏缄封远，珠谢鲛人泣报难。\n马上风尘君自见，归从二季学持竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠朱在明省觐还靖江","author":"欧大任","text":"典客中朝事事新，思归应为白头亲。\n十年献赋谁知己，四海论交见几人。\n侠似朱家还自蔽，美如孺子岂长贫。\n江皋纵有菰蒲地，高卧宁容侍从臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王百谷还吴下","author":"欧大任","text":"隋堤千柳噪鸣蝉，细雨轻帆溽暑天。\n问驿尔寻文学馆，渡江人识孝廉船。\n隐囊但可馀双笔，拄杖宁知有百钱。\n归去吴门犹是客，赁舂谁似伯鸾贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬周公瑕见过","author":"欧大任","text":"相逢意气酒垆傍，薄宦宁知俸一囊。\n繁露书难追董相，醇醪交自得周郎。\n朝朝苜蓿年堪老，处处芙蓉秋可裳。\n且共扁舟公路浦，莼鲈吾亦忆江乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"徐子与王元美见过招陆无从同集斋中","author":"欧大任","text":"渡江先约住芜城，二子中原念我情。\n博士业能传楮大，酒人游自爱荆卿。\n不知豸绣飘霜色，忽有骊珠傍月明。\n燕市狗屠君更访，风尘何处可藏名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李鸣卿邀游韩氏山亭","author":"欧大任","text":"缥缈飞楼出井干，千山隔水绕阑干。\n何来方丈□难引，忽涌罗浮雪并寒。\n帆过城头春浪长，亭开天半白云残。\n飘飘便可支筇去，万树梅花醉里看。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨中送王仪部敬美并寄李太史子田","author":"欧大任","text":"榜枻看君泛小舲，宁容奏记出都亭。\n世有后苍今典礼，人思刘向去传经。\n广陵雨后涛俱白，建业春残草尚青。\n太史何因留滞久，新莺还共省中听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张鸿与解台州","author":"欧大任","text":"三年出守赤城阴，归去宁论旧赐金。\n沧海秋风渔艇小，罗浮春雨酒杯深。\n吴钩还傍词人色，荆玉谁明逐客心。\n露冕天台曾一赋，夜来千尺白龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨运判量移青州别驾三首 其一","author":"欧大任","text":"通籍移家阊阖边，为郎深藉主恩偏。\n悬金早遇燕台日，止辇曾逢汉署年。\n迁客五噫宁忍去，诸生九辩已先传。\n只今谁似君侯贵，赐履分明海岱前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5918,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨运判量移青州别驾三首 其二","author":"欧大任","text":"烟芜萧瑟满邗城，共识参军作赋情。\n何处惊涛愁暮色，谁堪落叶送秋声。\n离人隋苑歌杨柳，候吏齐都引旆旌。\n十二山河凭轼外，沧洲宁许白鸥盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5919,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨运判量移青州别驾三首 其三","author":"欧大任","text":"煮盐东海是青州，君理淮鹾更此游。\n今日坐谈师尚父，何年归拜富民侯。\n山连渤海孤城雪，台拥琅琊万里秋。\n若念广陵宾从胜，枚乘还在曲江头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5920,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻岭南海寇警急寄陈德基袁茂文","author":"欧大任","text":"军中何事角声悲，赵尉台高落日迟。\n乱后江山犹涕泪，梦中楼橹半旌旗。\n渔樵实恐诛求尽，征戍深防道路危。\n慷慨知君能谕贼，莫令边将请王师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5921,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜官军已逐海寇寄黄公补公绍","author":"欧大任","text":"苍茫五岭半烽烟，幕府欢声露布传。\n沧海几年徵弩士，番禺诸将会戈船。\n军储邕筦宵偏急，杀气卢城秋可怜。\n忆尔登楼长啸后，曼胡缨自曳江天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5922,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴虎臣还新安陆无从同往为黄山白岳之游因赠二子并上汪中丞","author":"欧大任","text":"远游宁得恋交亲，落魄江南二子贫。\n谁解弓旌求国士，仅闻鱼鸟待诗人。\n溪头烟水青丝笮，岳下秋风白葛巾。\n中令閒居深结客，也应投辖似陈遵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠致政大司马四明张公","author":"欧大任","text":"仙人海上似卢敖，银阙回瞻日月高。\n绿发昼移青雀舫，白云春拥赤麟袍。\n西京枢筦新投老，南国歌辞早命骚。\n玉箭金芝持欲赠，十洲曾不隔烟涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡比部之留都胡公前御史左迁司理量移今职 其一","author":"欧大任","text":"杨州法署见才华，獬豸从来善触邪。\n直指八闽曾奉使，曲台三礼自名家。\n箧携书富多藏竹，环赐恩深未及瓜。\n佳句今推何水部，知君东问忆梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡比部之留都胡公前御史左迁司理量移今职 其二","author":"欧大任","text":"宁同迁客著离骚，江左鸣珂赋更豪。\n孤阁湖光玄武署，六朝秋色白云曹。\n城边雪霁骖騑远，阙下星悬象魏高。\n一出承明天万里，先朝侍从忆王褒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡比部之留都胡公前御史左迁司理量移今职 其三","author":"欧大任","text":"十载乌台疏几行，法曹今喜接词场。\n池因彩舰尝停辔，观为琼花一举觞。\n斋阁诸生疑蜀郡，股肱二辅似淮阳。\n征西官属江头望，回首金陵近帝乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]