[{"title":"拟古宫词二十首 其二十","author":"黄省曾","text":"君王蓦地蹙龙颜，左右仙姝锁翠山。\n舞罢阿翘河满子，传宣赐与紫金环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上曲四首 其一","author":"黄省曾","text":"八月秋深边马肥，塞魂空逐雁□飞。\n苍茫落日黄沙外，犹自提兵斗合围。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上曲四首 其二","author":"黄省曾","text":"大将新悬铜虎符，迢迢青海走□于。\n雕鞍坐踞浑无事，天阔秋鹰正可呼。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上曲四首 其三","author":"黄省曾","text":"放猎胡沙控紫弦，草深狐兔走祁连。\n秋空昨夜旄头落，为卷旌旗破左贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上曲四首 其四","author":"黄省曾","text":"塞雪皑皑春未消，将军千里破天骄。\n羽书昨夜飞金阙，应得君王赐紫貂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨柳枝词四首 其一","author":"黄省曾","text":"去岁今时别泪飘。\n夫君留向玉关遥。\n春风似为相思妾，吹动天涯万柳条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨柳枝词四首 其二","author":"黄省曾","text":"千载姑苏送客时。\n金昌亭畔柳如丝。\n于今一树无人种，怕与春风管别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨柳枝词四首 其三","author":"黄省曾","text":"白马金羁人未回。\n翠条仍自挂妆台。\n黄鹂莫作藏身处，一入丝中遣不开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨柳枝词四首 其四","author":"黄省曾","text":"巫峡巫山锦树春。\n垂杨垂柳著行新。\n东风不是贪飞絮，为觅天涯未见人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采莲曲三首 其一","author":"黄省曾","text":"怀人朝把紫笺裁。\n暂向荷花锁黛开。\n正是妾心愁剧处，鸳鸯两两莫教来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采莲曲三首 其二","author":"黄省曾","text":"团扇遥将明月裁。\n莲舟掩映一花开。\n风前羞杀芙蓉色，莫是阳云感梦来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采莲曲三首 其三","author":"黄省曾","text":"缃裙新借彩云裁。\n正值芙蓉玉沼开。\n不为名花同妾色，画船宁泛月明来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣闷一首","author":"黄省曾","text":"南池北苑柳皆□，未见花前把酒卮。\n倩汝长条挽春住，还人酩酊艳阳时。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山僧以枸杞椒芽初笋为肴饭我一首","author":"黄省曾","text":"芳椒采自青岩细，神杞求之紫洞新。\n谓道郤超斋一五，竞将山蔌供山人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望西塞山小步一首","author":"黄省曾","text":"西塞山前秋暮时，行行歌把碧松枝。\n鳜鱼白鹭玄真兴，流水桃花空尔思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上二首 其一","author":"黄省曾","text":"高人开宅白云中，锦浪桃花有棹通。\n好月为留清夜色，直将春水拟明空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上二首 其二","author":"黄省曾","text":"艳柳芳湖袅绿烟，春流长映白云天。\n鸳鸯鸂鶒催清泛，宛似乘槎北斗边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同郁大夫白子泛舟石湖登高四首 其一","author":"黄省曾","text":"水净霞明玉镜开，方平叨驾藻舟来。\n脱冠太守逢高彦，爱杀清歌戏马台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同郁大夫白子泛舟石湖登高四首 其二","author":"黄省曾","text":"重九苏台登暮秋，毗陵公子神仙流。\n黄英一束无人送，楚客偏多冉冉愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同郁大夫白子泛舟石湖登高四首 其三","author":"黄省曾","text":"芳草青青西子湖，南天鸿雁未高呼。\n吴人弦管喧佳节，一道花江带舳舻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同郁大夫白子泛舟石湖登高四首 其四","author":"黄省曾","text":"转岸回溪近五湖，烟霞驱向碧流铺。\n綵云未化淹歌舞，争道高阳旧酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同屠比部张仪部集万都阃公署四首 其一","author":"黄省曾","text":"芙蓉北阙倚钟山，细柳连营紫雾间。\n日月常悬江海静，飞龙马放绿郊闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同屠比部张仪部集万都阃公署四首 其二","author":"黄省曾","text":"大将青庐直禁宫，高贤驻马玉杯同。\n柳垂阊阖千章绿，云涌蓬莱万片红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同屠比部张仪部集万都阃公署四首 其三","author":"黄省曾","text":"白鹭洲边踏马来，青龙山下绮筵开。\n南云结取为张幕，北斗携将作献杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同屠比部张仪部集万都阃公署四首 其四","author":"黄省曾","text":"五云红日昼蝉鸣，宛宛高杨翠染成。\n鹦鹉杯衔银月上，仙人缥缈想吹笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜偕高令公次登惠山饮第二泉一首","author":"黄省曾","text":"落日惠山生紫烟，参差龙刹俯江天。\n清觞碧草金岩上，潇洒春空挥五弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蔡子归西山一首","author":"黄省曾","text":"子胥江上君逢我，泰伯祠前我送君。\n君卧西山那得见，令人长望洞庭云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张子言适越二首 其一","author":"黄省曾","text":"陆剑巴琴动远游，隋珠和璧映沧洲。\n观吴无复鸳鸯殿，泛越空寻翡翠楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张子言适越二首 其二","author":"黄省曾","text":"平子才高三辅希，客星南逐五云飞。\n愁歌玄赋名何早，紫岳丹丘兴不违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别友一首","author":"黄省曾","text":"绿柳堤边别马嘶，离云惨淡结秋虚。\n愿将芳草相看泪，化作□江双锦鱼。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华二宅作一首","author":"黄省曾","text":"残灯银烛共清筵，午月催人尚不眠。\n绿酒莫辞今夕醉，桃花重到是明年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卧病草堂送客之金陵二首 其一","author":"黄省曾","text":"我谢金陵八月秋，归来行药草堂幽。\n怜君迥泛秦淮舸，揽取红霞寄碧流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卧病草堂送客之金陵二首 其二","author":"黄省曾","text":"震泽遥连白鹭洲，白云千里映高游。\n它乡不忍看鸿雁，奈尔哀音玉枕流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"裒次何仲默集有感一首","author":"黄省曾","text":"薇省鸾台何舍人，扬芬振藻凤池新。\n秪缘把钓依黄鹄，不及弹冠狎紫麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吕城逢皇木二首 其一","author":"黄省曾","text":"雪陇涓涓添水涨，风旗旆旆谨王共。\n眼看碧岸千牌木，未觉深岩万仞松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吕城逢皇木二首 其二","author":"黄省曾","text":"沧江碧海常输筏，东岱南衡不吝材。\n谁把张华图献取，千门万户一时开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜发秣陵一首","author":"黄省曾","text":"秋垂江柳绿烟齐，客路芳花踏马蹄。\n早拟归心似明月，今宵先度虎丘西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵楼上一首","author":"黄省曾","text":"我在金陵百尺楼，秋河高映玉杯流。\n若教明月家山度，为寄长安此夜愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至天津一首","author":"黄省曾","text":"天津渡口海潮生，远树微茫片月明。\n帆影初收芳草岸，金钱买酒直沽城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天津鱼一首","author":"黄省曾","text":"红堞东连绿海滨，方城突丽是天津。\n南浮北泛停凫棹，不费银钱得紫鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水燕一首","author":"黄省曾","text":"江上王孙綵鹢归，翩翾芳鸟弄乌衣。\n长林脩竹谁嫌汝，不畏狂飙掠浪飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"途中咏蔬一首","author":"黄省曾","text":"四女树边分碧韭，裴家园里折青薇。\n身同洛上神龙卧，心似商山避鹄飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阻风二首 其一","author":"黄省曾","text":"长安旅夕隔芳帏，千里思教一日归。\n柰尔天风不相念，南舟争似北帆飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阻风二首 其二","author":"黄省曾","text":"愁边绿水疑添远，客里青山似倍长。\n日日飞心总归去，不如身到郁金房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴歌七首 其一","author":"黄省曾","text":"金铺玉户散烟沙，露径风墟吹远霞。\n尚忆吴宫全盛日，锦帆西子拥如花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴歌七首 其二","author":"黄省曾","text":"紫麋黄鹿上苏台，玉洞仙姝去不来。\n一片当时金殿月，露花烟草照秋杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴歌七首 其三","author":"黄省曾","text":"绮门红日八风开，天象文移江海隈。\n一泛五湖君子甲，馆娃花阁掩云苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴歌七首 其四","author":"黄省曾","text":"五山六合采金英，花殒莫耶宝剑成。\n龙雨久随神物去，千将千古有雄名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴歌七首 其五","author":"黄省曾","text":"峥嵘四座折椒丘，转见要离烈士流。\n惨日愁云酬一死，金华公子伏吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴歌七首 其六","author":"黄省曾","text":"孙子谈兵天下无，并驱黄石与阴符。\n鸾姬凤女残星剑，水火堪教红粉趋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴歌七首 其七","author":"黄省曾","text":"滕玉兰宫化綵云，珠襦金鼎国西坟。\n青山机发黄泉闭，白鹤苍生不忍闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻吕生琵琶一首","author":"黄省曾","text":"琵琶萧瑟动华轩，春草遥悲青冢魂。\n当日明君心里事，千歌百调岂能言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏扇上花一首","author":"黄省曾","text":"名芳新染赤城霞，月下灯前尽可誇。\n莫怪飞飞来粉蝶，春风今日正吹花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏梅一首","author":"黄省曾","text":"芳枝临向玉台春，月蕊云华与岁新。\n总道金樽开绣户，风前不见咏花人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水仙花一首","author":"黄省曾","text":"玉蕊冰花不可齐，光云瑶草伴萋萋。\n浑疑粉蝶风前泛，宛似江妃月下迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月二日客途逢亡内期日二首 其一","author":"黄省曾","text":"汝向泉台已匝年，月遗明镜翠遗钿。\n人间万里音堪寄，独有黄垆雁不传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月二日客途逢亡内期日二首 其二","author":"黄省曾","text":"去年愁里客京华，今日逢期不在家。\n桂醴兰肴□里奠，遥悬泪眼洒天涯。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东阁尘宾幕, 西征愧赋才。 月明笳鼓切,今夜为谁哀由丹阳入京","author":"夏完淳","text":"万里山河拱旧京，楚囚西去泪如倾。\n斜风衰柳丹阳郭，细雨孤帆白下城。\n残梦忽惊三殿报，新愁翻觉一身轻。\n从军未遂平生志，遗恨千秋愧请缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜感怀","author":"夏完淳","text":"登楼迷北望，沙草没寒汀。\n月涌长江白，云连大海青。\n征洪非故国，横笛起新亭。\n无限悲歌意，茫茫帝子灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"生平口号","author":"夏完淳","text":"生平无计更依刘，短发蒙茸愧楚囚。\n十载莺花迟暮客，三春烟雨别离愁。\n浮生碟梦庄周榻，壮志鸱夷范蠡舟。\n同学少年零落尽，飘然江海一沙鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆侯几道云俱兄弟","author":"夏完淳","text":"春城烟雾晓阴阴，俯仰斜阳吊古今。\n万里河山犹故国，九京风雨自同心。\n欲知其主观司隶，未见孤儿属羽林。\n鹤唳华亭人没后，河桥一阕泪沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六哀诗 徐冢宰石麟","author":"夏完淳","text":"忠襄老成人，夙昔抱明哲。\n秉钓右天子，贞简懋嘉节。\n沧海副车空，平陵鼓声绝。\n五朝有遗则，景光亘千叶。\n遗恨楚社亏，秦仇竟未雪。\n高山流清音，一往风益烈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日避难疁东柬智含","author":"夏完淳","text":"昨夜秋风起洞庭，三山落木晓风轻。\n亲朋相态浑如梦，湖海生涯敢独醒。\n我已无家随汗漫，知君愁坐独俜伶。\n故人频洒河桥泪，南国招魂感鹡鸰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"毗陵遇辕文","author":"夏完淳","text":"宋生裘马客，慷慨故人心。\n有憾留天地，为君问古今。\n风尘非昔友，湖海变知音。\n洒尽穷途泪，关河雨雪深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对月忆南行者","author":"夏完淳","text":"自拜南州使，清光几度看。\n沧洲天际晚，芳草月中寒。\n属国思归汉，嫖姚拟筑坛。\n不知江上雁，何日到长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鱼服","author":"夏完淳","text":"投笔新从定远侯，登坛誓饮月氏头。\n莲花剑淬胡霜重，柳叶衣轻汉月秋。\n励志鸡鸣思击楫，惊心鱼服愧同舟。\n一身湖海茫茫恨，缟素秦庭矢报仇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭吴都督","author":"夏完淳","text":"知己功名尽，伤心叩九阍。\n余光留日月，遗恨满乾坤。\n湖海门生谊，荆榛国士恩。\n滔滔江水阔，万里独招魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"柬半村先生","author":"夏完淳","text":"乐今竟如此，王郎又若斯。\n自羞秦狱鬼，犹是羽林儿。\n月白劳人唱，霜空毅魄悲。\n英雄生死路，却似壮游时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读《三子合稿》","author":"夏完淳","text":"十五成童解章句，每从先世托高轩。\n瘐徐别恨同千古，苏李交情在五言。\n雁行南北夸新贵，鹢首西东忆故园。\n独有墙头怜宋玉，不闻九辩吊湘沅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄迹武塘赋之","author":"夏完淳","text":"逢花却忆故园梅，雪掩寒山径不开。\n明月愁心两相似，一枝素影待人来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏吏杂感口号","author":"夏完淳","text":"黄金台下雨茫茫，云梦悲歌满大荒。\n凭吊兴亡千古事，风流燕楚二昭王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送客金陵二首 其一","author":"夏完淳","text":"山光无限水悠悠，古苑花明月满楼。\n送君马上休回首，玉笛三声一叶秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送客金陵二首 其二","author":"夏完淳","text":"此去离亭半夕阳，乌啼旧阕夜荒茫。\n滔滔江水无情极，明月秦淮水一方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中忆邵景说寄张子退","author":"夏完淳","text":"登临泽国半荆榛，战伐年年鬼哭新。\n一水晴波青翰舫，孤灯暮雨白纶巾。\n何时壮志酬明主，几日浮生哭故人。\n万里飞腾仍有路，莫愁四海正风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":38805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]