[{"title":"风寒济南道中兀坐肩舆不能开卷因即事戏作俳体六言解闷数之政得三十首当唤白家老婢读之耳 其三十","author":"王世贞","text":"富不如贫魏击，生不如死曹涂。\n片语千秋万古，两袖三江五湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即景二首 其一","author":"王世贞","text":"平林鸟惊新月，小巷犬吠松声。\n主人酉酒未解，稚子也倦逢迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即景二首 其二","author":"王世贞","text":"斜阳远山一抹，流水桃花几湾。\n橛头受风欺住，缸面且自偷闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉后放言 其一","author":"王世贞","text":"快哉老伶荷锸，至竟还输一筹。\n死亦不须埋我，教他蚁乐鸢愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉后放言 其二","author":"王世贞","text":"神仙自有官府，朝市翻誇隐沦。\n何用为渠评骘，醉乡且住逡巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉后放言 其三","author":"王世贞","text":"杖头一瓢共饮，但醉莫问姓名。\n无才无德老子，半痴半黠先生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉后放言 其四","author":"王世贞","text":"秫田七百斛米，屈指未了残年。\n东家新篘正熟，耐可瓮畔酣眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟行即景","author":"王世贞","text":"落鸦千点万点，流水一湾两湾。\n渔灯南垞北垞，鸟道前山后山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢吴总兵赠白苧帏","author":"王世贞","text":"不须元帅武帐，敢学中郎绛帏。\n领取新秋白苧，睡醒瑶台露晞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其一","author":"王世贞","text":"一贵一贱转眼，得意失意片言。\n丈夫自管六尺，莫拟轻受人恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其二","author":"王世贞","text":"眷属偶然萍聚，此身亦是蓬飘。\n从他千古万古，何异明朝昨朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其三","author":"王世贞","text":"为问夹毂周道，何如耦耕老农。\n六州铁铸成错，一尺布尚可缝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其四","author":"王世贞","text":"谷秕不如稗成，贵死不如贱生。\n东家送丧鼓吹，西家嫁女哭声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其五","author":"王世贞","text":"在山亦名小草，辞钓却唤阳鱎。\n何似一群鸾鹤，饱吃鳅鳝翀霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其六","author":"王世贞","text":"小人请学为圃，愚公始爱移山。\n不至终身钱孔，似胜天下辙环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其七","author":"王世贞","text":"刘项蜗角千里，彭聃蜉蝣片时。\n唯有腾腾酒睡，唤作小劫须弥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其八","author":"王世贞","text":"右丞辋川胜地，少傅履道新居。\n此生大堪假息，身后岂必吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其九","author":"王世贞","text":"法书名画古鼎，诗卷茶垆酒鎗。\n人呼六一居士，自号乌有先生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其十","author":"王世贞","text":"试茶初动蟹眼，临帖更画乌丝。\n啜罢冷淘槐叶，微吟双调柘枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其十一","author":"王世贞","text":"姓名琬琰四海，文字金石千秋。\n秖堪曳尾沙畔，那可跨鹤扬州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其十二","author":"王世贞","text":"湖田未论厚薄，颇堪伏腊之资。\n吾意无可不可，世途已而殆而。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其十三","author":"王世贞","text":"车公一言拜相，司马三赋为郎。\n既与此人同世，取舍更自茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其十四","author":"王世贞","text":"握管颇成快事，衔杯差不让人。\n何曾在下援上，亦否辞富居贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其十五","author":"王世贞","text":"重权一佩六印，巧宦十至九卿。\n八十日陶彭泽，福薄苦要归耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其十六","author":"王世贞","text":"时事十羊九牧，世情暮四朝三。\n莫忧深源难起，自信中散不堪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其十七","author":"王世贞","text":"有子万事非足，无官一身不轻。\n仙人自来忍辱，居士难矣净名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其十八","author":"王世贞","text":"脩罗怨为兵刃，调达谤作笙歌。\n大梵天宫自在，光明不照娑婆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其十九","author":"王世贞","text":"黄雀入水为蛤，青鸠乘春化鹰。\n升沈偶然所遇，强弱岂尔之能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成不复伦次共得廿首复作长山道中故事耳 其二十","author":"王世贞","text":"踰冠已叨银艾，三十谬领金绯。\n总就回波六字，唯向君王乞归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梅卷赠虚上人 其一","author":"王世贞","text":"罗浮寒玉千树，折赠阇黎一枝。\n欲识西来真意，暗风吹到军持。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梅卷赠虚上人 其二","author":"王世贞","text":"陇头玉笛吹遍，哀响不到僧家。\n为问阿师微笑，世尊拈示天花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏题 其一","author":"王世贞","text":"词林岂必阳九，世路自足朝三。\n鸡肋弃之有味，羊肠欲上不堪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戏题 其二","author":"王世贞","text":"蹉跎颜驷双鬓，落魄高阳一身。\n弹章亦合文苑，除目终疑酒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再题 其一","author":"王世贞","text":"三十年前涂抹，二千里外折腰。\n磨蝎当宫合贱，雕虫小技谁骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再题 其二","author":"王世贞","text":"临邛负弩小事，长沙赋鵩胡云。\n那用争他绛灌，归来笑拥文君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阻风黄石矶 其一","author":"王世贞","text":"桃叶江南江北，桃花千山万山。\n捲帘但看白浪，沽酒不减朱颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阻风黄石矶 其二","author":"王世贞","text":"长江宛如白龙，怒起鳞甲千重。\n唯是江头山色，居然不改芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叠字峰","author":"王世贞","text":"千尺霞笺灿烂，数行云篆横斜。\n莫惊此峰叠字，西去水亦成巴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金鼎峰","author":"王世贞","text":"十年文火武火，一夕星飞雾飞。\n惆怅云台夜色，子春独自东归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云母岩","author":"王世贞","text":"朵朵傲风云叶，层层薄日霜华。\n传得彭篯飧法，移来此地为家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黑虎岩","author":"王世贞","text":"何事山君变服，弭首玄武行宫。\n不忧西华白帝，可怕东海黄公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白龙岩","author":"王世贞","text":"朝来卵色初动，白云四驰不宁。\n疑是玉龙行雨，满山鳞甲峥嵘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱砂岩","author":"王世贞","text":"毋烦安期遣信，何用勾漏远寻。\n方寸不生凡火，大地尽作黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"歘火岩","author":"王世贞","text":"五十馀年清净，一念歘火缠纠。\n却似班生投笔，虎头燕颔封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"皇后岩太子岩","author":"王世贞","text":"太子宛如悉达，皇后亦似摩耶。\n一卷西来勘罢，五斗无复生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"妙花岩","author":"王世贞","text":"六铢姹女天衣，贪散天花不归。\n我醉露眠岩侧，满身花雨霏微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万松亭","author":"王世贞","text":"苏门山人坐啸，华阳隐居卧游。\n嘈然数部鼓吹，犹自传响山头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙泉观","author":"王世贞","text":"摩天群峭石骨，护壁万绿松髯。\n过桥泉声忽怒，破窦风意时尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乌鸦庙","author":"王世贞","text":"不学淮南鸡犬，一时相随上天。\n试问丛祠受赛，何如江畔迎船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仙棋石","author":"王世贞","text":"山中烂柯樵者，世上负局先生。\n最是圣凡难别，欲烦橘叟题评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"双溪涧","author":"王世贞","text":"一泓蟹眼吐沫，双涧燕尾分流。\n人道渭清泾浊，俱从天柱西头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"飞云涧瀑布涧","author":"王世贞","text":"急淙瀑布千丈，飞云冒絮百重。\n更许餐霞煮石，山人衣食从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天池","author":"王世贞","text":"天上莫疑银汉，池底亦自青天。\n白云徐动玉皱，明月初起珠圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郧中杂言八首 其一","author":"王世贞","text":"晨兴两塸脱粟，逼暮三杯浊醪。\n幸不妨他黄卷，犹堪拖故紫袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郧中杂言八首 其二","author":"王世贞","text":"乍雨乍晴天色，自开自落花枝。\n蚁浮谁宾谁主，蛙吹为公为私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郧中杂言八首 其三","author":"王世贞","text":"上书时时不报，往事忽忽自嗔。\n腰间有骨为祟，眼底无计藏身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郧中杂言八首 其四","author":"王世贞","text":"郧山排坐西入，汉水绕郭东倾。\n话来颇令神爽，饱看何曾眼明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郧中杂言八首 其五","author":"王世贞","text":"涂鸦半成梵字，为蠹三食仙名。\n虞初稗官使者，摩诘竺乾先生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":11999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郧中杂言八首 其六","author":"王世贞","text":"晚得一城斗大，云胡不游汉堤。\n见说宜城酒薄，小儿未解铜鞮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郧中杂言八首 其七","author":"王世贞","text":"无才痴顽老子，强学解事小儿。\n吾末如之何也，胡不归去来兮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郧中杂言八首 其八","author":"王世贞","text":"雨馀残果自堕，日落倦鹊争喧。\n手携南华一卷，不妨坐待黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"殿前曲二首 其一","author":"王世贞","text":"磁垣铁甲散晨光，香篆微芬金凤凰。\n武帐日迟风自捲，君王昨夜幸昭阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"殿前曲二首 其二","author":"王世贞","text":"鸿箓瑶簪叩宝坛，云璈凤管簇回銮。\n月明千片芙蓉影，蝉鬓凉生七叶冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"莫愁乐","author":"王世贞","text":"细娘家在大江头，总为工欢字莫愁。\n月明低按关山曲，何处行人不泪流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平阳伎 其一","author":"王世贞","text":"杨柳堤边控紫骝，葡萄新锦费缠头。\n春灯遍照平阳舞，不信流黄一段愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平阳伎 其二","author":"王世贞","text":"玉为歌管簇雕栏，锦作莲花捧翠盘。\n一片新妆惊月色，万行琼树雪中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨三首 其一","author":"王世贞","text":"空城甲第与云齐，海燕无人不肯栖。\n隔巷长干春十五，银筝偏唤一行啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨三首 其二","author":"王世贞","text":"闻道边关乐事多，前庭蹋鞠后庭歌。\n不知刁斗声中月，曾照流黄锦上梭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺怨三首 其三","author":"王世贞","text":"三殿论功拜彻侯，平阳歌舞一时收。\n无端却是刀环月，更遣文君赋白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西宫怨二首 其一","author":"王世贞","text":"露井香生百合开，夜深明月在青苔。\n春风自怨葳蕤锁，那有西宫玉辇来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西兴词","author":"王世贞","text":"留君无计恨匆匆，尽酒停杯曲未终。\n船到西兴潮已落，明朝还起石尤风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青楼怨","author":"王世贞","text":"轻风细剪越罗寒，红泪徐倾蜡凤残。\n一曲停筝还自语，不知春思为谁弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青楼曲二首 其一","author":"王世贞","text":"驰道高騣赤电飞，横担蜀锦斗鸡归。\n新丰酒薄人难醉，夜半犹歌金缕衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青楼曲二首 其二","author":"王世贞","text":"姊妹争誇夫婿殊，众中单道不曾输。\n千兵队里明金紫，腰下寒光玉辘轳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12015,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从军行八首 其二","author":"王世贞","text":"马首垂杨折送行，酒阑长揖宝刀横。\n军中最是多兄弟，不唱阳关第四声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12016,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从军行八首 其三","author":"王世贞","text":"朝来分隶李轻车，揖客辕门意自如。\n超距翘关三十万，何人领取豹韬书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12017,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从军行八首 其四","author":"王世贞","text":"夜深邻帐送胡笳，三月春寒雪作花。\n吹尽关山杨柳曲，壮心元自不思家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12018,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从军行八首 其五","author":"王世贞","text":"奇兵十万击匈奴，谷蠡屠耆未拟俘。\n对阵夺将金勒马，独身生致北单于。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":12019,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]