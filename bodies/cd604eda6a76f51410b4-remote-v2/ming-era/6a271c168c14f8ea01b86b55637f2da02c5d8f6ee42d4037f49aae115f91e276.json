[{"title":"金华山杂咏八首 其五 芙蓉峰","author":"胡应麟","text":"万仞嵯峨雾色重，青天谁削紫芙蓉。\n扶筇恍忆西游日，玉女盆边第一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金华山杂咏八首 其六 赤松涧","author":"胡应麟","text":"鹿田西下接鱼矶，千顷寒流照客衣。\n薄暮乱山风雨过，不知潭底玉龙飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金华山杂咏八首 其七 紫薇岩","author":"胡应麟","text":"文采曾惊六代豪，紫薇深锁白云高。\n何人为启藏书穴，摇落青山伴彩毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金华山杂咏八首 其八 石羊峰","author":"胡应麟","text":"绝顶寒云挂玉清，三山何处有蓬瀛。\n乘风自叱群羊起，不向黄冠道姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"调安茂卿时安携妓湖上","author":"胡应麟","text":"一舫朝移入画图，亭前苏小斗摴蒱。\n徘徊十里春湖色，忘却吴松旧钓鲈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄祝鸣皋","author":"胡应麟","text":"落魄长安旧酒徒，五陵花色劝提壶。\n别来肝胆凭谁问，一片霜华照辘轳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上寓目","author":"胡应麟","text":"猎猎轻风试碧蹄，群儿相逐段桥西。\n不知何处双鸳度，十数金丸落大堤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过吴门不及入访喻邦相寄怀四绝 其一","author":"胡应麟","text":"锦缆牙樯出太湖，楼船箫鼓入皇都。\n那堪此夜吴阊外，断雨凄风问客途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过吴门不及入访喻邦相寄怀四绝 其二","author":"胡应麟","text":"越国山川处处留，吴门花月更优游。\n何人不道神仙吏，四百楼台任意游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过吴门不及入访喻邦相寄怀四绝 其三","author":"胡应麟","text":"燕寝凝香画戟开，云间太守旧怜才。\n萧然一榻黄堂畔，飞骑时迎二陆来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过吴门不及入访喻邦相寄怀四绝 其四","author":"胡应麟","text":"玉尺银条照座明，鲈鱼乍夜到江城。\n秋风斜日长亭畔，更向何方作步兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河渠歌十首为大司空潘公作并奉怀前大司空朱公 其一","author":"胡应麟","text":"大海波涛静不流，长堤云雾似龙游。\n千秋玉帛朝仙苑，万国车书会帝州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河渠歌十首为大司空潘公作并奉怀前大司空朱公 其二","author":"胡应麟","text":"鼓吹连天发棹歌，旌旗耀日午风和。\n波摇柳色通淮甸，水泛桃花入潞河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河渠歌十首为大司空潘公作并奉怀前大司空朱公 其三","author":"胡应麟","text":"宝应堤成不避风，高邮湖远若行空。\n由来饷事今年蚤，四月楼船尽过洪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河渠歌十首为大司空潘公作并奉怀前大司空朱公 其四","author":"胡应麟","text":"大圣曾闻出泗州，司空重起镇淮流。\n河开砥柱三千丈，殿锁琅珰亿万秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河渠歌十首为大司空潘公作并奉怀前大司空朱公 其五","author":"胡应麟","text":"铁骑云屯汉武年，翻愁瓠子变桑田。\n何如此日新梁就，南控长淮北控燕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河渠歌十首为大司空潘公作并奉怀前大司空朱公 其六","author":"胡应麟","text":"六月边头未请粮，河西已到万馀皇。\n欢声欲沸三关士，满载嘉禾出太仓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河渠歌十首为大司空潘公作并奉怀前大司空朱公 其七","author":"胡应麟","text":"锦缆牙樯照碧天，黄旗十道晚风前。\n山樱未入吴姬口，乍日中官已进鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河渠歌十首为大司空潘公作并奉怀前大司空朱公 其八","author":"胡应麟","text":"朝行齐鲁暮淮徐，沐雨栖风志屹如。\n业就耻方徐内翰，功高不数宋尚书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河渠歌十首为大司空潘公作并奉怀前大司空朱公 其九","author":"胡应麟","text":"三十年来治水劳，白头犹自驾轻舠。\n河边莫漫誇千骑，海上曾闻钓六鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河渠歌十首为大司空潘公作并奉怀前大司空朱公 其十","author":"胡应麟","text":"随山刊木两司空，万古勤劳夏后同。\n试听河堤行客语，朱公一去有潘公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"抵淮上友人邀饮狭斜迫归不能舣棹","author":"胡应麟","text":"新水黄河没钓矶，一帆高挂暮云飞。\n红妆十万无颜色，笑杀当年杜紫薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别苏别驾南归四首 其一","author":"胡应麟","text":"邂逅相逢兴独豪，平原十日醉葡萄。\n风前忽奏阳关曲，别泪千行堕宝刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别苏别驾南归四首 其二","author":"胡应麟","text":"红粉清源十万妆，亭亭高髻绿罗裳。\n那能不滞狂夫兴，满目飞云是太行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别苏别驾南归四首 其三","author":"胡应麟","text":"桃花新水木兰桡，挥手离人出画桥。\n何处相思偏入梦，嶓江飞雪越江潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别苏别驾南归四首 其四","author":"胡应麟","text":"才大君犹困执鞭，书成余亦倦游年。\n惟应匣底湛卢色，夜夜双飞北斗前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄季玉还楚四首 其一","author":"胡应麟","text":"一棹依然入五湖，数声长笛楚山孤。\n岳阳楼上高回首，何处长安旧酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄季玉还楚四首 其二","author":"胡应麟","text":"神如秋水玉如颜，赢得殷郎唤阿环。\n若向黄陵祠畔过，莫教风雨妒湘山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄季玉还楚四首 其三","author":"胡应麟","text":"电影霜蹄八骏材，盐车犹自困蒿莱。\n亦知龙种元西极，不向黄金恋故台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄季玉还楚四首 其四","author":"胡应麟","text":"布帽垆头扑旧尘，貂裘愁杀蓟门春。\n洞庭湖上南归雁，莫忘芙蓉寄远人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"憩白牛精舍梦游湖上听歌作并寄郭鸿胪","author":"胡应麟","text":"翛然文室卧楞伽，一枕江南兴未涯。\n三十六陂春水色，画船箫鼓载吴娃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"食河豚","author":"胡应麟","text":"鼠肝虫臂任乾坤，修短茫茫一气论。\n绝粒五旬身尚在，何妨残喘食河豚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河豚味在诸鱼之下仅腹中腴可赏昔人目以西施乳亦稍誇矣余骤食此鱼颇有声过其实之叹戏题一绝以俟定论物固有遇不遇也","author":"胡应麟","text":"掩映银盘白玉壶，质如鸡卵味如酥。\n若将西子胸前较，未必鸱夷泛五湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"记十八九时章二宅中食江鲚狂饮剧醉豪兴欲飞迄今二十馀年再过瓜洲食此此物风味不减畴昔乃余发则种种不复能作少年态矣","author":"胡应麟","text":"玉盘金缕按霓裳，曾倚瓜洲作酒狂。\n二十馀年重下箸，一生江鲚几回尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鲚鱼水族中佳品也江淮惟二月有之故亦谓时鱼昔人恨鲥鱼多骨此物鳞刺尤多余酷重其风味每食必尽数盘座中戏题此绝","author":"胡应麟","text":"最爱鲜鳞出素波，金盘玉箸荐银梭。\n人生事事元堪恨，岂独鲥鱼骨太多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江一绝","author":"胡应麟","text":"一片归心付倦游，碧桃花尽大堤头。\n沧洲不借凌风舸，二月春江似箭流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过晋陵欲访朱在明安二茂卿云在明以先一日往京口矣十载之期竟左成约殊怅怅也","author":"胡应麟","text":"萧萧风雨一帆开，恨杀篙师捩柁回。\n不信习家池上饮，十年长是梦魂来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再寄文仲一绝","author":"胡应麟","text":"千峰回合碧云迟，想像吴阊日暮时。\n何日双柑寻旧约，一尊湖上听黄鹂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜过长安酒楼作","author":"胡应麟","text":"垆头飞雪万家寒，琥珀香吹白玉盘。\n歌罢落梅天渐晓，不知门外是长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜读献吉仲默廷实昌谷于鳞诗漫兴五首 其一","author":"胡应麟","text":"回首开元八百秋，莫将蹊径细追求。\n巨灵自有移山力，手擘黄河万里流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜读献吉仲默廷实昌谷于鳞诗漫兴五首 其二","author":"胡应麟","text":"自得西方最上诠，莲花千仞扑青天。\n由来騕袅鸣銮足，可作风螭步骤传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜读献吉仲默廷实昌谷于鳞诗漫兴五首 其三","author":"胡应麟","text":"北地申阳各俊流，中原名誉本鸿沟。\n当时误作攀鳞客，王后卢前特地愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜读献吉仲默廷实昌谷于鳞诗漫兴五首 其四","author":"胡应麟","text":"肝胆平生献吉闻，金丹炼就肯离群。\n时人浪自开门户，点染高流入墓文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜读献吉仲默廷实昌谷于鳞诗漫兴五首 其五","author":"胡应麟","text":"七字高华一代知，若为诸体遍称奇。\n犹龙莫讶宣尼赞，自是难忘问礼时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采菱曲十二章 其一","author":"胡应麟","text":"风情老去似徐娘，犹逐王孙负锦囊。\n莫驾轻车残雪里，人间无处觅萧郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采菱曲十二章 其二","author":"胡应麟","text":"碧衣长袖伴瑶琴，欲拟方回更自矜。\n学得新诗明月底，含羞不肯向人吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采菱曲十二章 其三","author":"胡应麟","text":"十院名花院院开，高悬明镜在瑶台。\n碧空万里天如洗，飞挟娉婷夜半来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采菱曲十二章 其四","author":"胡应麟","text":"红颜二八定谁如，三十专房宠未除。\n头白楚宫看似旧，登车何用泣前鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采菱曲十二章 其五","author":"胡应麟","text":"风神秋水照华筵，怪得王孙掌上怜。\n惆怅后庭花底月，凭阑回忆破瓜年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采菱曲十二章 其六","author":"胡应麟","text":"绣帽罗衫恰称身，绿丝布裤最撩人。\n愁中开府看如扫，梦里司空认未真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采菱曲十二章 其七","author":"胡应麟","text":"那曾调笑问当垆，惯向书斋直唾壶。\n蓦地閒行寻不得，画廊东角斗摴蒱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采菱曲十二章 其八","author":"胡应麟","text":"焚香懒著鵔鸃冠，长日东君带笑看。\n好是绿窗明月夜，潜身行傍曲阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采菱曲十二章 其九","author":"胡应麟","text":"旧识花卿在锦城，相逢高唱少年行。\n那堪回首东风恶，吹送青帆入四明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采菱曲十二章 其十","author":"胡应麟","text":"玉雪肌肤姑射仙，天涯挥手剧堪怜。\n明年定挂山阴雪，人在阳明赤水天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采菱曲十二章 其十一","author":"胡应麟","text":"玉树相辉照画屏，朱陈遗事最堪凭。\n含啼却笑文君拙，不遣相如聘茂陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"采菱曲十二章 其十二","author":"胡应麟","text":"十年声动大长秋，一笑如花越水头。\n为有薛家红线在，何须重上木兰舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送董大之会稽","author":"胡应麟","text":"风雪离人下灞桥，长歌不断董娇娆。\n梅花两岸清溪色，船到西兴正落潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再别惟效观察一绝","author":"胡应麟","text":"阳台题罢复琴台，夙昔风流擅楚才。\n君到川南相忆处，海棠烦寄一株来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄观察陈座师","author":"胡应麟","text":"千骑西南最上头，雪山晴色照吴钩。\n高牙大纛行春暇，满酌郫筒酹武侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入晋陵复不及访朱在明怅然复寄此诗","author":"胡应麟","text":"廿载飞书醉白沙，乱山寒色限孤查。\n南园一夜西风急，无数江蓠尽落花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"枫桥夜泊梦与房仲诸君欢饮达旦觉而怅然寄此","author":"胡应麟","text":"玉立红妆照画船，终朝寒梦不成眠。\n风流何处王公子，落尽莲花玳瑁筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上酒楼听歌王检讨敬夫汪司马伯玉二乐府及张伯起传奇戏作 其一","author":"胡应麟","text":"光阴百岁迅流霞，一曲东篱擅马家。\n何似翰林新水令，秋风迁客走天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上酒楼听歌王检讨敬夫汪司马伯玉二乐府及张伯起传奇戏作 其二","author":"胡应麟","text":"水云深处木兰航，白雪纷飞大雅堂。\n莫向五湖寻旧迹，于今司马在郧阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上酒楼听歌王检讨敬夫汪司马伯玉二乐府及张伯起传奇戏作 其三","author":"胡应麟","text":"掩径频年侣博徒，阳春堂上白云孤。\n才闻北里歌红拂，又见东园演窃符。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠梨园邵生","author":"胡应麟","text":"艳舞娇歌向月明，金钗罗袜斗轻盈。\n何缘饱听花卿曲，今日钱塘是锦城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幼识歌者何生一别廿载相对怃然为题一绝","author":"胡应麟","text":"回首高阳二十年，何戡重对各潸然。\n渭城是处殷勤唱，遮莫明朝送画船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆以修挐舟饯别至魏湾执手恋恋闻某直指垂至乃发迄今令人怅然偶值清源鸿便辄题二绝寄苏并讯易惟效蔡景明 其一","author":"胡应麟","text":"脉脉盈盈一水头，何须七夕笑牵牛。\n秋来两地如相望，夜色天街万里愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆以修挐舟饯别至魏湾执手恋恋闻某直指垂至乃发迄今令人怅然偶值清源鸿便辄题二绝寄苏并讯易惟效蔡景明 其二","author":"胡应麟","text":"四倍平原饮酒期，牵衣犹自恨临岐。\n遥知送客河梁后，不向襄阳倒接䍦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄亭四绝为邑文学祝宗旦题从其子树勋请也 其一","author":"胡应麟","text":"缥缈千峰列翠屏，八窗云气透疏棂。\n遽然一枕南华梦，别有乾坤在草亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄亭四绝为邑文学祝宗旦题从其子树勋请也 其二","author":"胡应麟","text":"科头箕坐一亭空，白眼青天送断鸿。\n几许豪华驹隙内，何人先觉大槐宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄亭四绝为邑文学祝宗旦题从其子树勋请也 其三","author":"胡应麟","text":"高峰攒翠落精庐，五斗颓然不愿馀。\n举白持螯应自快，著朱骑马定何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄亭四绝为邑文学祝宗旦题从其子树勋请也 其四","author":"胡应麟","text":"风潭百顷和沧浪，坦腹遽庐万事忘。\n睡起秋山扪虱坐，不知斜照堕胡床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武林送吴山人北游","author":"胡应麟","text":"雪里钱塘一棹孤，送君寒色满长途。\n黄金台馆三千尺，曾伴荆高作酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":18951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]