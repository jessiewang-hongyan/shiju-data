[{"title":"访友人道中作","author":"岑徵","text":"寒塘梅节忆招携，十里山程信杖藜。\n独客路迷残雪里，故人家住乱峰西。\n孤烟发处茅檐出，黄犊归时返照低。\n垂兴不知筋力倦，拟将清话到鸣鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅关宣文诗集有赠","author":"岑徵","text":"新诗满帙是琅玕，掩户焚香镇日看。\n老去才名甘退舍，后来风雅渐登坛。\n江皋结佩须兰芷，云路高飞待羽翰。\n我有伯牙流水引，万松深处为君弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"城南 其一","author":"岑徵","text":"城南西畔郁金堂，曲槛斜通宋玉墙。\n按谱巧翻金缕曲，背人偷试内家妆。\n弱菱不碍鸳鸯戏，细雨难消豆蔻香。\n恨字书成无处寄，春风如梦柳丝长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"城南 其二","author":"岑徵","text":"莫愁湖上误春潮，惆怅高唐暮雨遥。\n团扇枉图秦女影，纤罗空约楚宫腰。\n欢心好似春花谢，妾泪难随蜡炬销。\n消息浪传桃叶渡，碧江流水夜迢迢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶成","author":"岑徵","text":"寂寞穷秋对落英，柴门深曲隔车声。\n君平卖卜空身世，梅福为佣变姓名。\n四海岂忘鸿鹄志，九州潜听蛰龙鸣。\n天涯处处同芳草，留待王孙伴客程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答何节生问讯之作","author":"岑徵","text":"问余行止近如何，秋雨裁书报薜萝。\n阮籍疏狂原不减，李颀佳句本无多。\n空山老病侵年鬓，歧路风尘阻笑歌。\n莫讶双鱼频不到，海门愁望渺烟波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赴潭州宿桂阳废驿","author":"岑徵","text":"桂江北望渺无涯，前路迢迢日又斜。\n山转翠屏高下地，竹围烟火两三家。\n行人渴问当垆酒，疲马寒嘶古驿花。\n闻说去程难计日，岳云迷处是长沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湘阴夜泊与陈熊左分赋","author":"岑徵","text":"洞庭叶下水增波，客子维舟近汨罗。\n粤峤音书连岁绝，楚天魂梦入秋多。\n霜飞雉堞哀笳发，月照芦洲旅雁过。\n遥望巴陵烽火隔，荒鸡啼彻奈愁何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湘潭晚春寄耒阳胡使君","author":"岑徵","text":"花落鹃啼日欲曛，白蘋洲畔怅离群。\n东风绿遍章台柳，夜雨寒生梦泽云。\n避地小陵犹寄食，依人王粲谩从军。\n春深塞雁皆还北，书札何因报使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中湘寒食","author":"岑徵","text":"杜宇声残换物华，断魂原不为思家。\n不堪逆旅逢寒食，况复愁中对落花。\n沅浦有怀捐佩玦，楚歌无调变龙蛟。\n朱弦欲抚难成曲，水咽临湘起暮笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中湘除夕同陈熊左","author":"岑徵","text":"雨雪潇潇鬓易疏，天涯流落过居诸。\n三湘两度逢除夕，溟海经年不寄书。\n酒歇夜深毛褐短，更阑灯尽纸窗虚。\n明朝詹尹开龟策，握粟同君问卜居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶成","author":"岑徵","text":"骏骨千金事已遥，高台无复望燕昭。\n频年夹寨师将老，几处敖仓米渐消。\n每向齐庭愁鼓瑟，暂从吴市学吹箫。\n何须极目思乡国，王粲忧多不易销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕","author":"岑徵","text":"一生生计总成虚，垂老无闻悔读书。\n日月又过三百六，行藏空度五旬馀。\n来时似戏还成梦，往事如棋拚一输。\n瓜地久荒儿女长，明年春早好教锄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除前二日雨中陈五席上贻杨郎时杨值东里之厄将有远行并此赠别","author":"岑徵","text":"阴云漠漠雨漫漫，旅食谁怜范叔寒。\n披葛岂能依到溉，杖藜还得过苏端。\n魂销南浦人将别，魄落三城岁欲残。\n尘世波澜君饱历，未应长铗向人弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曾澹只先辈馆端州 其一","author":"岑徵","text":"邮亭低折绿杨枝，风满帆樯酒满卮。\n百里羁栖非远客，暮年亲友重临歧。\n春江梦里迎桃叶，夜雨宫前赋黍离。\n咫尺漓江书易寄，旅愁频遣故人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曾澹只先辈馆端州 其二","author":"岑徵","text":"想到崧台泪暗零，背人开匣抚青萍。\n当春鲁酒休辞醉，入夜胡笳不可听。\n肠断子山应作赋，心违刘向且传经。\n铜驼一夜荆榛雨，寒食端州草又青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄何节生","author":"岑徵","text":"小园苔藓漫阶除，憔悴行吟叹索居。\n谷口烟销微雨歇，柴门风煖落花初。\n听鸡每忆论心夜，怀袖犹存隔岁书。\n裘马游梁空有约，茂陵消渴滞相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梧州旅次寄怀诸同社","author":"岑徵","text":"遁迹穷荒念陆沉，素书遥讯粤城音。\n思君始有还乡梦，傍母全销作客心。\n南海天低鸿雁杳，苍梧秋老白云深。\n归途莫问三春草，欹枕胡床罢越吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湘潭周家园牡丹 其一","author":"岑徵","text":"领袖东风压众芳，休怜魏紫与姚黄。\n温泉未洗杨妃汗，异域新传贾女香。\n月下荧煌垂绛袖，风前绰约舞霓裳。\n中湘二月名园里，肯把春光让洛阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湘潭周家园牡丹 其二","author":"岑徵","text":"旭日晴霞态倍妍，画堂西畔赤栏边。\n六宫粉黛群相妒，二月芳菲尔占先。\n锦绣漫劳文士笔，胭脂徒费画工钱。\n东皇最是相怜秘，异色名香不许传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湘潭周家园牡丹 其三","author":"岑徵","text":"片片轻霞护绮寮，浓华应许擅春朝。\n妆成魏苑誇潘发，醉后华清笑楚腰。\n欲向梦魂传彩笔，谁从深院出红绡。\n三春易向兰皋发，料得湘累恨亦消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜朱吉子归自蜀中","author":"岑徵","text":"蜀门万里赋归哉，几月行程返粤台。\n别久故人疑梦见，路难游客自天回。\n频从密坐询行迹，愁向寒灯问劫灰。\n去住无成俱老大，酸辛同过十年来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄梁山人","author":"岑徵","text":"云谷村边古寺西，数椽茅屋称幽栖。\n閒随野衲分茶叶，时引春泉灌药畦。\n兰芷旧贻湘水佩，桃花长记武陵溪。\n十年犹作青山梦，鸡犬陂塘路不迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠叶少年","author":"岑徵","text":"年来蓬鬓满秋霜，羞上风流侠少场。\n书练许谁同大令，问津疑得比刘郎。\n甘时莫惜馀桃味，暖处应分绣被香。\n不厌老成人潦倒，为君传与驻颜方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贻阳山王令","author":"岑徵","text":"屠龙才技试烹鲜，湟水鸾翔近十年。\n父老共传为政美，县邻同道使君贤。\n春花不种河阳树，流水空闻单父弦。\n最是昌黎当退食，肯容区册到堂前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绿珠渡","author":"岑徵","text":"葭菼苍苍博水沱，昔年鱼媵美人过。\n渡怜薄命输桃叶，村有芳名胜苧萝。\n双角峰留眉黛谱，清溪声咽懊侬歌。\n行人惆怅生离处，金谷东流恨若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠黑户部","author":"岑徵","text":"五夜香添画省中，风流人羡旧司农。\n亲承密旨来南服，频遣边机达九重。\n百粤烽烟销德化，三年溟海沐仁风。\n书鱼罢上驰封事，一为陈诗叹小东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶成 其一","author":"岑徵","text":"半枕邯郸梦未真，频年空老化衣尘。\n当杯莫惜如泥醉，览镜明知到骨贫。\n屋角寒梅才谢腊，陌头芳草又逢春。\n风光过眼浑无定，一曲狂歌鬓似银。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶成 其二","author":"岑徵","text":"移山有志同愚叟，失马无心拟塞翁。\n安得人情平似砥，莫疑天道曲如弓。\n从来南雁终归北，肯信西流不向东。\n独有文园多病客，闭门还却落花风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日奉答关尚士见怀之作","author":"岑徵","text":"南村谁与赏奇文，月旦评中接令闻。\n越陌枉存怜索处，折麻持赠慰离群。\n妙龄鬼语推长吉，垂老玄言谢子云。\n唯有郊居人未识，定携新赋一寻君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红白各半莲花 其一","author":"岑徵","text":"定知移种自仙家，红白中分两色花。\n气聚阴阳终配位，幻来金火合抽芽。\n神丹半就馀银汞，玉臂分明系绛沙。\n华岳高峰残雪遍，一边晴覆晚天霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红白各半莲花 其二","author":"岑徵","text":"露华犹在日初曛，菡萏丛中独出群。\n赵后身边来赤凤，素馨田畔宴红云。\n氤氲入座幽香合，绰约凌波两色分。\n莫羡霓裳羽衣曲，一枝浓艳总输君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红白各半莲花 其三","author":"岑徵","text":"异色同苞世所无，半涂铅粉半施朱。\n莫因霜鬓求勾漏，伫见彤云在藐姑。\n似画西南分地势，暂将离兑出河图。\n不须白水占王气，应兆真人佩赤符。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红白各半莲花 其四","author":"岑徵","text":"云霞片片水中开，樊素红绡手共栽。\n春雪半封丹凤穴，夕阳斜照白龙堆。\n寻常素绚虚成象，造化文章信巧裁。\n最是汤池新浴罢，玉盘初进荔枝来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红白各半莲花 其五","author":"岑徵","text":"急买丹铅付画师，从来花谱不曾知。\n玉壶赐与灵芸泣，赤汗传教虢国骑。\n纸帐夜寒添蜡炬，明霞秋晚蘸涟漪。\n西南两叶文鱼戏，粉蝶蜻蜓未许窥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"红白各半莲花 其六","author":"岑徵","text":"淡妆浓抹总天工，两象收归一气中。\n太白青霜明紫阁，洞庭秋水下丹枫。\n临池对影奇生偶，背面闻香色是空。\n偏袒袈裟频喻法，欲从高座證归宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿石制军 其一","author":"岑徵","text":"锡马彤弓出尚方，褰帷衔命镇炎荒。\n烽烟两道销黄钺，士女三年化衮裳。\n开府声华瞻北斗，重臣家世本南阳。\n霜风不动辕门静，云汉昭回海日长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿石制军 其二","author":"岑徵","text":"秋高边海迥无尘，声教覃敷有世臣。\n南国巡行同召伯，东郊为政借君陈。\n歌钟待锡承丹券，宵旰无劳慰紫宸。\n长白中嵩佳气并，累朝藩翰又生申。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿石制军 其三","author":"岑徵","text":"枌榆系籍盛朱轮，三锡殊方秉大钧。\n万里东南分节制，两年山海静烟尘。\n鸣条风歛秋雷薄，触石云生化雨新。\n南极近临牛女次，青天遥望紫微辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿","author":"岑徵","text":"尘世何年谪岁星，玉为神骨鹤为形。\n时逢茅氏开秦腊，定有麻姑访蔡经。\n丹诀著成藏石室，古槎閒坐对沧溟。\n山中甲子都忘却，惟有梅花记丙丁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿琼州吴总戎","author":"岑徵","text":"禁城宿卫羽林郎，天语亲承镇海疆。\n两代分符仍虎竹，一家专阃并龙骧。\n军麾暇整蛮烟静，寰宇休明海日长。\n云汉昭回南斗灿，年年长对紫微光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿吴母张太君","author":"岑徵","text":"云母溪边是谪居，前身系籍在蓬壶。\n冲星旧配丰城剑，照乘长光赤水珠。\n天上玉龙衔宝箓，云头青鸟授真符。\n绮筵谁荐香华膳，知是麻姑与鲍姑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠额子老","author":"岑徵","text":"百蛮开府贤从事，数载前筹副德音。\n名署皂囊书凤诰，赋摛玄藻重鸡林。\n尊中常满招融客，门下何烦散薛金。\n咫尺荆州浑未识，澧兰空自发长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏至与何孟门吴山带佩公谓远琬若潘亦庶泛舟柳波涌泊草屩庵前分赋得田字","author":"岑徵","text":"庵门相望是花田，风景宜人好泊船。\n潮水绿侵杨柳岸，晚霞红入荔枝天。\n僧逢旧识供香茗，客有新词被管弦。\n乐事良辰难并得，大家沉醉暮钟边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"琼州春日席上贻李方水梁彦腾吴谓远三广文","author":"岑徵","text":"韶华荏苒岁方新，相对城南莫厌频。\n故里虽遥忘作客，广文强半是交亲。\n青云任奋天池翼，白首重逢海国春。\n到处春盘供苜蓿，深杯聊醉落花辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日过王问溪山庄将为多异岭之游","author":"岑徵","text":"路入桃源客易迷，秋风驴背赴招携。\n青山待我寒云外，白社寻君负郭西。\n卜地依山三径曲，种梅垂屋万枝低。\n淹留幸有南村好，幽赏何须到虎溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋王问溪山庄宴集庭梅忽开花两朵时主人将卜期纳宠分韵各赋","author":"岑徵","text":"茅亭秋半共飞觞，惊见南枝两朵香。\n舟楫正传桃叶渡，雪花先待寿阳妆。\n冲寒有意何妨早，索笑巡檐岂厌忙。\n羡尔山庄饶胜事，薄游端不负秋光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与王问溪约游多异岭不果","author":"岑徵","text":"中秋借得蹇驴骑，拟向名山共赋诗。\n清梦几年寻胜事，白云何意负幽期。\n尘缘未尽非关俗，松月虚悬欲待谁。\n游约更期黄菊节，岂宜重惹北山移。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴谓远广文还会学署","author":"岑徵","text":"去岁乘春返五羊，又逢春信别家乡。\n青毡九载人犹少，白发中旬日正长。\n旅食旧烦分苜蓿，留题曾记满宫墙。\n相思有梦频来往，水驿山程路不忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读书诃林答远布上人见赠","author":"岑徵","text":"牢落风尘事事慵，戒坛东畔息行踪。\n老依佛火消千劫，寒并梅花过一冬。\n两地分吟西郭月，隔城交听上方钟。\n瑶华折赠惊流徵，且摘兰苕报远公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题 其一","author":"岑徵","text":"黄陵庙口月明时，湘北湘南唱竹枝。\n竹枝唱到无声处，湘水南流向九疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题 其二","author":"岑徵","text":"章台传下楚宫妆，五色罗裙匝地长。\n自是南隅秦氏女，不将游冶作东方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题 其三","author":"岑徵","text":"越客初浮五石瓠，潇湘水咽洞庭湖。\n巴陵暮雨行人绝，莫上君山听鹧鸪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题 其四","author":"岑徵","text":"东家儿女过西家，相约长堤去浣纱。\n共说采菱声调急，一齐连臂唱杨花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题 其五","author":"岑徵","text":"阴风猎猎下微霜，鸿雁南来趁稻粱。\n飞到南天天尽处，浪传飞不过衡阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题 其六","author":"岑徵","text":"十三学织紫罗裳，十五裁成金凤凰。\n姨妹行中称独步，不须重绣野鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"季札庙","author":"岑徵","text":"三让依然有祖风，金阊俎豆万年同。\n虎丘山上吴光冢，衰草离离一望中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"林和靖墓","author":"岑徵","text":"放鹤亭边问隐沦，寒梅不似去时春。\n孤山三尺残碑在，犹是西湖旧主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒岳武穆墓 其一","author":"岑徵","text":"朱戟成行马鬣前，垄头云气接朱仙。\n椒浆不是黄龙酒，滴到泉台也枉然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒岳武穆墓 其二","author":"岑徵","text":"棠梨雨歇过清明，折取江蓠荐岳茔。\n料得九原重抱恨，六陵弓剑在冬青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒岳武穆墓 其三","author":"岑徵","text":"春深湖畔草芊芊，牧马成群踏墓田。\n松柏更无南北向，亭亭陵上直参天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广州书所见 其一","author":"岑徵","text":"粉项轻沾马汗尘，盘蛇缠额箭衣新。\n知渠本是南蛮妇，近习辽音学骂人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广州书所见 其二","author":"岑徵","text":"手持酥酪背琵琶，犹似依稀认得他。\n莫是樵南山市见，紫姑祠畔卖新茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"琼州寄答何不偕 其一","author":"岑徵","text":"两逢春信滞蛮乡，一曲停云入梦长。\n除却思君无个事，桄榔阴下校医方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"琼州寄答何不偕 其二","author":"岑徵","text":"广文海外半同乡，苜蓿经春得饱尝。\n君亦惠城曾饱过，惠城争似海南香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"琼州寄答何不偕 其三","author":"岑徵","text":"一封书寄到崖州，见说乘桴到此游。\n琼岛故人齐引领，碧云遥望海天秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖 其一","author":"岑徵","text":"罗绮香风水面回，翠云如黛镜中开。\n繁华景物难双比，直得吴山立马来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":40216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]