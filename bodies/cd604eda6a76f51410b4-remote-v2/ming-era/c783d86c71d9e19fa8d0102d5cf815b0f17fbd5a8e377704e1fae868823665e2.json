[{"title":"赋得寒山寺送别","author":"高启","text":"枫桥西望碧山微，寺对寒江独掩扉。\n船里钟催行客起，塔中灯照远僧归。\n渔村寂寂孤烟近，官路萧萧众叶稀。\n须记姑苏城外泊，乌啼时节送君违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16915,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻朱将军战殁","author":"高启","text":"江浦戈船赤帜稀，孤军落日陷重围。\n镜中蛇堕占应验，牙上枭鸣事已非。\n残卒自随新将去，老亲空见旧奴归。\n闻鸡此夜谁同舞，西望秋云泪洒衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16916,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送何明府之秦邮（何，淮东人。已三为县令）","author":"高启","text":"马前风叶助离声，楚驿都荒不计程。\n一令尚淹三县事，几家曾见十年兵。\n夕阳远树烟生戍，秋雨残荷水绕城。\n父老不须重叹息，君来应有故乡情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16917,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过野寺次韵徐廉使琰旧题","author":"高启","text":"使节城东按部回，曾将从吏到香台。\n秋林数骑萧萧去，晚泽孤鸿噭噭来。\n萝雨湿衣溪路转，柏风吹烛殿门开。\n当年物色难留与，题壁惭无子美才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16918,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送荥阳公行边","author":"高启","text":"风卷双旌雪覆鞯，远骑白马出行边。\n兵驰空壁三千帜，客宴高堂十万钱。\n屏里旧图鱼复阵，灯前新注《豹韬篇》。\n功成他日论诸将，只有荀郎最少年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16919,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"娄江寓舍喜王七隅见过却送还郭","author":"高启","text":"送君只过孝廉桥，不似君来访我遥。\n路未同归鸿杳杳，门方孤掩竹萧萧。\n远愁忽与钟声至，残醉微兼烛烬销。\n莫道扁舟难重过，寒江日日有回潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16920,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送叶卿还陇西公幕兼简周军咨","author":"高启","text":"落石关城动鼓笳，远游怜汝尚无涯。\n壮身谩托三公府，归梦难寻万里家。\n投驿暮山灯照叶，待潮秋渡棹粘沙。\n军中记室能相问，只说愁吟对菊花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16921,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西坞","author":"高启","text":"空山啄木声敲铿，花落水流纵复横。\n松风吹壁鹤翎堕，梅雨过溪鱼子生。\n尚有人家机杼远，更无尘土衣裳轻。\n斜阳已没月未出，樵子归时吾独行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16922,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过海云院赠及长老","author":"高启","text":"衲拥寒云老一丘，游方无梦转悠悠。\n茶香吹过前林晚，菜叶流来别涧秋。\n旧拂讲余悬壁上，残经定后落床头。\n紫藤坞里归逢雪，煨芋曾烦慰客愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16923,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送钱塘守","author":"高启","text":"繁华莫叹异升平，到郡初烦露冕行。\n幕下吏书催署字，湖中妓舫歇歌声。\n潮来两渡皆侵岸，日落诸山半入城。\n休沐南屏烦一到，松间寻我旧题名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16924,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张山人见访留宿草堂","author":"高启","text":"夕阳欲没静沙墟，喜子能来慰索居。\n生事萧条惭客里，交情契阔叹兵余。\n买鱼急唤临江艇，炊黍深开映竹厨。\n屈指故人能几在，莫辞同醉卧田庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16925,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陪临川公游天池","author":"高启","text":"骑马寻幽度岭迟，老僧不识使君谁。\n门开红叶林间寺，泉漫青山石上池。\n残果已收猿食少，枯松欲折鹤巢危。\n壁间不用题名字，无限苍苔没旧碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16926,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"客舍岁暮","author":"高启","text":"空江寒雨送凄凉，离舍无多即异乡。\n井臼尚勤惭德曜，音书未至忆平阳。\n心轻别岁凭年少，梦喜还家及夜长。\n自笑病来词赋拙，懒从枚叟客游梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16927,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上晚眺怀王著作","author":"高启","text":"渡头西望足离情，晚水寒山雪后清。\n鸥立断冰流渐远，鸦随残照去还明。\n渔人笛过风生浦，估客帆回树隔城。\n范蠡祠前春意动，思君欲放酒船行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16928,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答徐七记室病中作","author":"高启","text":"空斋孤枕积书间，清瘦怜君变旧颜。\n累少亦忧今日乱，病多应赖此身闲。\n朝辞邻友看花去，晚候家僮买药还。\n知是苦吟犹未废，水边深树掩柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16929,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游云岩值雨","author":"高启","text":"深殿幽廊映竹开，鸟声忽断雨声催。\n藓生偏上题诗壁，花落还临说法台。\n林下闻钟诸客散，涧边汲水一僧来。\n晚晴更好看山色，西阁凭阑独未回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16930,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿张氏江馆","author":"高启","text":"极浦荒云一棹行，远投江馆驻宵程。\n客中得酒衔悲喜，乱后逢人说死生。\n木叶未空寒鸟聚，海潮欲上曙鸡鸣。\n政怜此地无惊扰，归梦如何又入城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16931,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李使君镇海昌（州有双庙）","author":"高启","text":"海风千里卷双旌，按辔初闻属部清。\n人杂岛夷争午市，潮随山雨入秋城。\n鸣狐不近睢阳庙，突骑犹屯广利营。\n肯扫帐中容我辞，夜深燃烛卧谈兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16932,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋得惠山泉送客游越","author":"高启","text":"云液流甘漱石牙，润通锡麓树增华。\n汲来晓冷和山雨，饮处春香带涧花。\n合契老僧烦每护，修经幽客记曾夸。\n送行一斛还堪赠，往试云门日注茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16933,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄题张著作菁山隐居","author":"高启","text":"霞映青山似赤城，归栖闻已谢时名。\n半湖残雨收虹影，几树斜阳带鸟声。\n竹下逢僧投杖揖，萝间候客抱琴行。\n平生应笑王夷甫，末路方言少宦情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16934,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送胡孝廉布东游","author":"高启","text":"春色偏伤楚客心，日斜芳草鹧鸪吟。\n山遮故国千重影，云度长江一片阴。\n少妇自挑灯下锦，诸侯谁赠橐中金。\n送行只恨华觞浅，不似同袍别意深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16935,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送任兵曹赴边","author":"高启","text":"少年耻着惠文冠，幕下时时把剑看。\n官烛未销鸡送晓，军笳忽动马嘶寒。\n关连远树征途迥，塞接霜芜战地宽。\n见说长平门下客，奇材唯有一任安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16936,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日江居写怀七首 其一","author":"高启","text":"每看摇落即成悲，况在漂零与别离。\n为客偶当鲈美处，思兄正值雁来时。\n天边暝为秋阴早，江上寒因岁闰迟。\n莫把丰姿比杨柳，愁多萧飒恐先衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16937,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日江居写怀七首 其二","author":"高启","text":"葭菼连秋渺渺长，归舟犹叹滞江乡。\n客衣欲冷邻机急，农事初成野饭香。\n千里断云随雁骛，半村残照送牛羊。\n有愁不解登高赋，空使频回宋玉肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16938,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日江居写怀七首 其三","author":"高启","text":"舌在休夸术未穷，且将踪迹托渔翁。\n芙蓉泽国弥漫雨，禾黍田苗掩冉风。\n身计未成先业废，心怀欲说旧交空。\n楚云吴树无穷恨，都在萧条隐几中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16939,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日江居写怀七首 其四","author":"高启","text":"风尘零落旧衣冠，独客江边自少欢。\n门巷有人催税到，邻家无处借书看。\n野虫催响天将夕，篱豆垂花雨稍寒。\n终卧此乡应不憾，只忧飘泊尚难安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16940,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日江居写怀七首 其五","author":"高启","text":"桑苎翁家次近居，人烟沙竹自成墟。\n移门欲就山当榻，补屋唯防雨湿书。\n贫为湖田长半没，拙因世事本多疏。\n当时亦有求名意，自喜年来渐已除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16941,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日江居写怀七首 其六","author":"高启","text":"丧乱将家幸得全，客中长耻受人怜。\n妻能守道同王霸，婢不知诗异郑玄。\n借得种蔬傍舍地，分来灌菊别池泉。\n却欣远迹无相问，一棹秋风笠泽边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16942,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日江居写怀七首 其七","author":"高启","text":"秋塘门掩竹穿沙，为客邻酤未易赊。\n闲里壮年惭白日，愁中佳节负黄花。\n渔村霭霭缘江暗，农径萧萧入圃斜。\n薄俗相轻吾敢怨，鲁人犹自笑东家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16943,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄倪隐君元镇","author":"高启","text":"名落人间四十年，绿蓑细雨自江天。\n寒池蕉雪诗人画，午榻茶烟病叟禅。\n四面荒山高阁外，两株疏柳旧庄前。\n相思不及鸥飞去，空恨风波滞酒船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16944,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与杜进士寅登白莲阁对雨","author":"高启","text":"远愁高树共离离，风逆潮声上浦迟。\n海客市中烟起处，江僧阁外雨来时。\n船归杳霭唯闻橹，店隐苍茫不见旗。\n回首南朝今几寺，可堪重咏牧之诗？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16945,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与侄常游东庵","author":"高启","text":"水树围庵绿几层，阴中敲户昼登登。\n十年重到犹为客，半日才闲且访僧。\n旧履尘生趺后席，乱幡风纮供余灯。\n高斋对作忘言坐，此事堪怜汝亦能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16946,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢周四秀才送酒","author":"高启","text":"不忍醒愁只欲眠，几日花发自江边。\n欲沽百钱未易得，忽送一壶真可怜。\n梳头好鸟语窗下，洗盏流水到门前。\n今朝得醉已无恨，不使春光空一年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16947,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"上巳有怀","author":"高启","text":"春寒浑未减征衣，愁对佳辰坐掩扉。\n江上琴书留滞久，水边车马祓除稀。\n闲园细雨梅花落，废苑平芜燕子飞。\n欲觅凉亭会中友，几人边谪未能归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16948,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐记室贲北归见访南渚复送还城","author":"高启","text":"初辞楚泽到吴村，访旧嗟君古道存。\n欲治匆匆归后计，难留款款坐中论。\n雪迟似让梅先白，月早如愁树已昏。\n此别终非前别远，孤舟江上莫销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16949,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"被召将京师留别亲友","author":"高启","text":"长送游人作远行，今朝还自别乡城。\n北山恐起移文诮，东观惭叨论议名。\n路去几程天欲近，春来十日水初生。\n只愁使者频催发，不尽江头话别情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16950,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过故将第","author":"高启","text":"甲第如云紫陌东，当年得意负边功。\n美人笑客登楼上，假子将兵卫阁中。\n深计谩夸三窟固，游魂难返九原空。\n门前车马今谁到，零落槐花向晚风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16951,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中寄刘沈二别驾","author":"高启","text":"漠漠春寒水绕城，谁家可作看花行。\n一杯不得三人共，二月都能几日晴。\n梦逐莺声风外断，愁兼草色雨中生。\n画船载妓南湖上，不似年时放浪情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16952,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁校书见招晚酌","author":"高启","text":"正坐羁愁不自聊，远烦舟楫暮相邀。\n江悬落日犹三尺，风折垂杨定几条。\n流水入花村杳杳，幽人对酒屋翛翛。\n此乡不得君同客，应是春来更寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16953,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅花六首 其二","author":"高启","text":"缟袂相逢半时仙，平生水竹有深缘。\n将疏尚密微经雨，似暗还明远在烟。\n薄暝山家松树下，嫩寒江店杏花前。\n秦人若解当时种，不引渔郎入洞天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16954,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅花六首 其三","author":"高启","text":"翠羽惊飞别树头，冷香狼藉倩谁收。\n骑驴客醉风吹帽，放鹤人归雪满舟。\n淡月微云皆似梦，空山流水独成愁。\n几看孤影低徊处，只道花神夜出游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16955,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅花六首 其四","author":"高启","text":"淡淡霜华湿粉痕，谁施绡帐护香温。\n诗随十里寻春路，愁在三更挂月村。\n飞去只忧云作伴，销来肯信玉为魂。\n一尊欲访罗浮客，落叶空山正掩门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16956,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅花六首 其五","author":"高启","text":"独开无那只依依，肯为愁多减玉辉。\n帘外钟来初月上，灯前角断忽霜飞。\n行人水驿春前早，啼鸟山墙晚半稀。\n愧我素衣今已化，相逢远自洛阳归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16957,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅花六首 其六","author":"高启","text":"断魂只有月明知，无限春愁在一枝。\n不共人言唯独笑，忽疑君到正相思。\n歌残别院烧灯夜，妆罢深宫览镜时。\n旧梦已随流水远，山窗聊复伴题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16958,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观军装十咏·胄","author":"高启","text":"黄金胄虎头，乍免走豪酋。\n还有从容处，纶巾按垒游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16959,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观军装十咏·铠","author":"高启","text":"丝串镂文银，高城日照鳞。\n擐来曾搅阵，一镞不伤身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16960,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观军装十咏·纛","author":"高启","text":"发乱野牛惊，神专大将营。\n师行当祃祭，坛卜戮番生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16961,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观军装十咏·刀","author":"高启","text":"大食购千金，妖精泣太阴。\n灯前开匣看，无限许君心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16962,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观军装十咏·弓","author":"高启","text":"燕角号良材，楼烦劈未开。\n秋风悬臂出，何处一鸧来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16963,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观军装十咏·箭","author":"高启","text":"流星逐飞羽，镞利能穿札。\n三发定边归，箙中休满插。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16964,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观军装十咏·麾","author":"高启","text":"彩帛曳长虹，悠悠卷塞风。\n三军齐陷阵，应在一挥中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16965,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观军装十咏·矛","author":"高启","text":"画干似蛇长，谁论半段璟。\n日斜亲斗罢，高宴卓沙场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16966,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观军装十咏·袍","author":"高启","text":"雕锦剪花团，三边总认看。\n寻常不肯着，风雪念兵寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16967,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观军装十咏·马","author":"高启","text":"罗帕覆春风，连鞍赐有功。\n蹄高骑得称，身出万军中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16968,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渊源堂夜饮","author":"高启","text":"悬灯照清夜，叶落堂下雨。\n客醉已无言，秋蛩自相语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16969,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和陈左司夜泊桐江","author":"高启","text":"月出钓台树，长滩秋更喧。\n浑如宿巫峡，唯少一声猿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16970,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过师子林","author":"高启","text":"雨余鸟语凉，斜阳竹深见。\n频来非看花，借读《高僧传》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16971,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过旧送别处","author":"高启","text":"前时送画船，西港柳株边。\n别处愁犹在，鸳鸯不肯眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16972,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀陈寅山人时居西山昭明寺","author":"高启","text":"闻看西涧月，秋阁与僧开。\n正是相思夜，钟声君处来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16973,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"略上人房竹","author":"高启","text":"幽筱半梢横，山窗纮月明。\n上人禅定久，不怕有秋声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16974,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别吕隐君","author":"高启","text":"孤舟晚溪口，欲去重回首。\n不忍别青山，况此山中友。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16975,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"隔帘闻歌","author":"高启","text":"叶逐散声飞，湘云隔妓衣。\n谁能偷卷看，认是小丛非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16976,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄氏延绿轩","author":"高启","text":"葱葱溪树暗，靡靡江芜湿。\n雨过晓开帘，一时放春入。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16977,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"端午席上咏美人彩索钗符二首 其一","author":"高启","text":"臂头长命缕，百结更双蟠。\n怕有痕生肉，教依玉钏宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16978,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"端午席上咏美人彩索钗符二首 其二","author":"高启","text":"灵篆贮纱囊，熏风绿鬓傍。\n从今能镇胆，不怯睡空房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16979,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江寺雨中访杜二","author":"高启","text":"几日缆归舟，同君野寺游。\n旧怀言未尽，不是雨相留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16980,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜从兄远归","author":"高启","text":"闻汝归舟到，相迎只恐迟。\n方当见时喜，还忆别时悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16981,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寒夜与家人坐语忆客中时","author":"高启","text":"茅屋夜灯青，竹庭寒雪白。\n不对室中人，依然去年客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16982,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上漫成","author":"高启","text":"春色到江滨，江花树树新。\n行吟憔悴客，谁道亦逢春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16983,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中过玉遮山二首 其一","author":"高启","text":"松头急风回，飞雨不到面。\n何处豁清愁，千山一人见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":16984,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]