[{"title":"赐观灯诗五首　永乐二十年正月十五日进 其一","author":"邓林","text":"上苑春如画，东风夜不寒。\n月从今夕满，灯许万人看。\n鳌背三山耸，天边列宿攒。\n金吾那有禁，行乐任盘桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赐观灯诗五首　永乐二十年正月十五日进 其二","author":"邓林","text":"月影移宫扇，灯光烛御筵。\n鱼龙呈百戏，笙鹤会群仙。\n花发连枝树，人游不夜天。\n华夷欣共乐，万寿祝尧年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赐观灯诗五首　永乐二十年正月十五日进 其三","author":"邓林","text":"欲识鳌山趣，先从境界论。\n佛来西域远，星拱北辰尊。\n乐事生田野，欢声蔼禁垣。\n太平端有象，稽首荷君恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赐观灯诗五首　永乐二十年正月十五日进 其四","author":"邓林","text":"白叟挈黄童，观灯紫禁中。\n恩从三殿出，乐与万方同。\n天近瞻华衮，年登谢化工。\n太平歌一曲，沉醉倚东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赐观灯诗五首　永乐二十年正月十五日进 其五","author":"邓林","text":"弱水还琼岛，星桥驾碧虚。\n九重天近处，一岁月圆初。\n胜景看逾好，新诗画不如。\n微臣逢盛事，献颂愧才疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"耕隐","author":"邓林","text":"绿野春三月，黄童雨一蓑。\n有田真可隐，无事懒相过。\n社日鸡豚富，丰年黍稌多。\n醉来天地阔，一曲太平歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"象城送别","author":"邓林","text":"骢马去骎骎，新诗触景吟。\n凉风飘桂子，晴日转棠阴。\n亲舍关山远，天涯雨露深。\n两言忠与孝，赠别重黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑上舍","author":"邓林","text":"南浦清风起，西山宿雨收。\n人还天上节，潮送海门舟。\n朋旧皆青眼，郎官正黑头。\n回朝膺显擢，努力继前修。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄司仓","author":"邓林","text":"送客游京国，情深不忍分。\n柳条牵画舸，椰酒注离樽。\n骥足康庄路，鹏程翰海云。\n都门如到日，鱼雁好相闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送举人陈玄泰","author":"邓林","text":"王国生多士，陈生寔俊豪。\n十年穷六籍，一钓有连鳌。\n蓬岛着着近，云梯步步高。\n应知廷对日，恩雨沐蓝袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题张主事族谱","author":"邓林","text":"令祖黄堂倅，贤孙粉署郎。\n名门多宦达，世业有书香。\n汴水源头远，眉山谱法良。\n笑人忘所自，下马哭汾阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平黎卷为张宪副赋","author":"邓林","text":"小丑动边烽，名卿事折冲。\n鸟蛇初入阵，狐兔顿潜踪。\n一统乾坤大，三春雨露浓。\n潢池卖刀剑，依旧业耕农。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕三首 其一","author":"邓林","text":"七夕如常夜，双星故隔河。\n浪传牛饮渚，谁见袜凌波。\n天上人难识，世间巧自多。\n欲将圆缺意，对月问嫦娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕三首 其二","author":"邓林","text":"迢递天河路，飘摇博望槎。\n仙郎犹有妇，荡子可无家。\n度日忧王事，逢秋感岁华。\n乡心成百折，城鼓已三挝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕三首 其三","author":"邓林","text":"夜久银河转，天空玉露零。\n遥怜儿女辈，独看斗牛星。\n雁断沉书浦，萤流拜月亭。\n何当乘兴去，共蹑凤凰翎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月十五夜对保安对月二首 其一","author":"邓林","text":"万里关山月，看看四度圆。\n多情照孤寂，无酒对婵娟。\n在处鸣砧杵，谁家度管弦。\n城南多思妇，此际未成眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月十五夜对保安对月二首 其二","author":"邓林","text":"练练飞明镜，亭亭转玉盘。\n山河微有影，蟾兔不胜寒。\n塞外犹为客，闺中正倚阑。\n清光随处有，千里思同看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夜保安对月二首 其一","author":"邓林","text":"久客逢佳节，幽怀满素襟。\n一年今夜月，千里故乡心。\n酒谩和愁饮，诗聊遣兴吟。\n谁家思寄远，风外起清砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夜保安对月二首 其二","author":"邓林","text":"风露满天清，今宵月倍明。\n姮娥如有意，羁旅亦多情。\n河汉双星隔，关山一雁鸣。\n胡为叹离索，且把玉壶倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭先兄三首 其一","author":"邓林","text":"雁断家无信，兄亡弟不知。\n怪来频入梦，添得苦相思。\n眼暗观云处，心伤见月时。\n孤灯坐深夜，无语泪交颐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭先兄三首 其二","author":"邓林","text":"半百宁云寿，诸孤况尚孩。\n老天徒有眼，嘉木不为材。\n吊鹤盘云下，啼乌入夜哀。\n谁怜千里雁，孤影独徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭先兄三首 其三","author":"邓林","text":"江上与兄别，岁阑期我归。\n众雏随母去，孤雁念群飞。\n屈指三秋隔，回头万事非。\n故山松下泪，何日一沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽玩梅梁处士","author":"邓林","text":"薤露声初咽，梅花玩已荒。\n鹤遗华表恨，天减户微光。\n种德根株茂，承家胤嗣昌。\n高名垂不朽，太史有铭章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和杭庠陈司训惟成见赠诗韵二首 其一","author":"邓林","text":"日月双飞鸟，乾坤一大窝。\n人生真似寄，发绿顿成皤。\n景物江南好，诗朋座上多。\n但令尊有酒，不乐复如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和杭庠陈司训惟成见赠诗韵二首 其二","author":"邓林","text":"瀚海收鹏运，蓬麻托鴳窝。\n容身天地阔，搔首鬓丝皤。\n恋阙心常赤，还家梦亦多。\n君亲多未报，无计奈愁何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和钱参政示子诗韵四首 其一","author":"邓林","text":"子弱宗祧重，千金一发悬。\n未能成汝学，常恐辱吾先。\n客路青云外，家山夕照前。\n万金书半纸，无雁请谁传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和钱参政示子诗韵四首 其二","author":"邓林","text":"闻汝灯窗下，工夫颇用心。\n逢人知问字，对谱解弹琴。\n好作儒林秀，休嗟学海深。\n吾家称世阀，乔木正阴阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和钱参政示子诗韵四首 其三","author":"邓林","text":"归心何所似，沧海日东之。\n念汝逾三载，逢人寄一诗。\n层忧填肺腑，多病损容仪。\n始信黄金尽，能令壮士悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和钱参政示子诗韵四首 其四","author":"邓林","text":"生长逢昭代，羁栖愧此身。\n有官居牧伯，无德报君亲。\n积善由先世，传芳属后人。\n家藏书万卷，子孙未为贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泰然窝","author":"邓林","text":"一窝如斗大，容膝尽宽舒。\n俗客无来辙，天君有广居。\n凝尘留几格，蔓草满庭除。\n多少闲中趣，吟风弄月馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题陈怡云竹轩　和全室尚人韵","author":"邓林","text":"种竹十馀个，开轩三两楹。\n满庭留野色，无地着嚣声。\n世际文明会，人高月旦评。\n凤雏看已长，佳实几时成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别严斋","author":"邓林","text":"四海皆兄弟，如君有几人。\n利轻缘义重，交久见情真。\n风雨连床夜，莺花对酒晨。\n一杯从别后，此意与谁陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清风楼为金文鼎题王孟端写竹","author":"邓林","text":"与可千竿竹，休文八咏楼。\n江山随处景，烟雨自然秋。\n俗士绝交往，词人工唱酬。\n留题寄幽赏，毛发冷飕飕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉会楼为司封陈郎中叔刚赋","author":"邓林","text":"楼倚青山起，门临绿水开。\n雕甍连碧筱，文砌护苍苔。\n空翠当窗落，清光入牖来。\n卷帘延众雏，扫榻净纤埃。\n天尽群峰小，江空一鹤回。\n烟霞成隐趣，风月壮吟怀。\n欢饮无声伎，论文有俊材。\n邺侯书插架，北海酒盈杯。\n久负云梯约，缘非作赋才。\n留题寄幽赏，抚卷兴悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽福建钱参政","author":"邓林","text":"德政名方岳，才华蔼士林。\n寿年胡不永，天道信难谌。\n大梦黄粱熟，高春白日沉。\n诗书成往事，忠孝负初心。\n继志孤儿幼，埋魂九地深。\n脩途回辙迹，旧雨散朋簪。\n少日论交义，他乡感讣音。\n招魂歌楚些，有泪湿衣襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽吉水李处士　分水梁丞德固之父","author":"邓林","text":"令子名成日，高堂禄养时。\n俄生风木感，忍诵蓼莪诗。\n浮世真如梦，青山夙有期。\n烟霞俱失色，猿鹤共含悲。\n薤露声酸楚，藜云路险巇。\n游魂招不返，远讣报何迟。\n耆旧中洲彦，碑铭太史辞。\n言言皆德范，留与后人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上天竺游回道上与　陈、夏、毕、朱、马、祝、郑　联句","author":"邓林","text":"夜宿招提境，晨辞佛国山。\n马回知路熟，客去喜僧闲。\n梵刹钟初歇，人家门尚关。\n幽禽鸣上下，曲涧响潺湲。\n露拂衣裾湿，苔侵屐齿斑。\n白云横洞口，红日射林间。\n湖水玻璃瑩，霜枫玛瑙殷。\n物华怜景好，诗思愧余悭。\n要尽登临兴，宁辞步履难。\n扶持劳仆从，宝石更跻攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送方太守之官南宁","author":"邓林","text":"宫罗新制紫袍轻，满袖天香出禁城。\n云路朋侪青眼别，炎方父老白头吟。\n黄堂宣化仁风远，绿野行春瘴雨晴。\n千载龚黄称善治，好崇勋业继芳声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送孔贰尹之官上林","author":"邓林","text":"郎官光彩拂层霄，闻说承恩出圣朝。\n万里天涯鹏路阔，一鞭行色马蹄骄。\n黔黎日化弦歌盛，绿野春耕雨露饶。\n邻邑故人应有待，临风洗耳听民谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送都昌李县丞","author":"邓林","text":"酒尽沙头双玉瓶，江空岁晚动离情。\n三千客路风云远，方寸臣心日月明。\n奏最枫宸嘉茂绩，恩流花县说芳名。\n悬知宠秩□迁处，紫绶双垂出凤城。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠李县丞升浔州经历","author":"邓林","text":"郎官才美旧哦松，又著黄堂赞画功。\n两地民心怀惠泽，一襟忠气贯晴虹。\n清浔湛月秋无底，白简凝霜笔有锋。\n早展经纶登要路，虞廷补衮待夔龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽乡友汤有宗先辈二首 其一","author":"邓林","text":"千里天涯感讣音，临风一恸泪盈襟。\n追思前事总成梦，欲吊芳魂空有心。\n午院尘生徐稚榻，夜窗弦绝伯牙琴。\n萱堂更有高年母，想在泉台恨亦深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽乡友汤有宗先辈二首 其二","author":"邓林","text":"年来送别渡头津，行卷题诗墨尚新。\n契阔几何成永诀，交游未老失斯文。\n水寒矶畔鸥盟散，月冷天南雁影分。\n我有殊方知己泪，随风挥洒象冈云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题汪志昂江湖乐趣","author":"邓林","text":"江湖有客来相访，示我江湖乐趣图。\n鹍海鹏□天浩渺，蛮烟蜑雨景模糊。\n蜗名不慕情偏淡，□□相亲机自无。\n欲买扁舟从所适，尘烦未脱□□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠许斋归南雄","author":"邓林","text":"戎门隐者旧知名，湖海分携岁月更。\n重见倏惊头半白，相看还喜眼双青。\n云飞大庾归心远，水落清浔去棹轻。\n嗟我客中长送客，骊驹一曲不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送同年陈时懋分教罗城","author":"邓林","text":"春闱战捷各西东，萍水那知邂逅逢。\n云路朋侪推祖逖，河汾弟子仰王通。\n秋堂风露吟毡冷，晓案齑盐道味浓。\n去去莫嫌边徼远，只今文轨万方同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题南宁宁指挥松桂轩","author":"邓林","text":"高轩静对柳营开，嘉木曾和雨露栽。\n龙蛰嘘云从地起，兔灵分种自天来。\n一庭晚翠笼毡帐，万斛秋香落酒杯。\n文武元戎襟度雅，定应谈笑奠南垓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴郡太守之官","author":"邓林","text":"龙楼报彻晓筹鸡，拜下除书湿紫泥。\n列爵已看荣五马，推恩正好惠群黎。\n离筵不醉霜天酒，行卷多留翰苑题。\n闻说东吴忧水患，早留遗□□□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南宁傅同知望云思亲二首 其一","author":"邓林","text":"家山迢递隔湘云，望若庭闱思若奔。\n得禄未荣三釜养，有生难报百年恩。\n蓼莪赋罢心如织，衣线看来眼欲昏。\n回首黄堂霜月暮，慈乌啼处不堪闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南宁傅同知望云思亲二首 其二","author":"邓林","text":"嗟君感物念高堂，宛似梁公在太行。\n望去难穷千里目，愁来空断九回肠。\n东乌西兔亲年老，北辙南辕客路长。\n同是劬劳恩未报，题诗感我成滂□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"棠阴清题赠南宁黎推府","author":"邓林","text":"黎侯听讼倚甘棠，讼简空馀白昼长。\n铺树绿阴春意蔼，满怀清思笔花香。\n仁民已见虚囹圄，故国行看任栋梁。\n传语邑庠多大雅，为诗系美召南章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆友人张自牧久客邕州二首 其一","author":"邓林","text":"人落江空又暮秋，故人底事久遨游。\n黄尘千里异乡路，明月半篷何处舟。\n计利徒贻妖鬼笑，归田早为厥孙谋。\n吟馀一送凭高目，瘴雨连天风满楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆友人张自牧久客邕州二首 其二","author":"邓林","text":"半世飘蓬鬓已霜，营营复尔为谁忙。\n归田未说家山好，作客宁辞道路长。\n问信故人时共语，候门童子日相望。\n重阳已近无消息，又负黄花一度香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病起","author":"邓林","text":"识破雕弓未是蛇，兰灯昨夜缀金花。\n九天雨露回昌运，几处溪山换物华。\n香散秋云书隐蠹，诗题霜楷墨林鸦。\n吏人也为公家喜，拂拭青毡待坐衙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自述","author":"邓林","text":"懒结车船送五穷，此生贫富任天公。\n故人谩自怜原宪，妖鬼何须笑伯龙。\n半职敢忘君泽厚，一钱未有客囊空。\n年来学得经邦术，欲整麻衣见九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"羊城友人梁俊民以诗寄赠余余因次韵以答之","author":"邓林","text":"霜毫云茧照松烟，静倚幽斋草太玄。\n宇宙无垠归阖闾，壶山有石任盘旋。\n身闲肯问公家事，客至惟输酒店钱。\n笑我奔驰徒扰扰，春泥和雪满靴毡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄梧庠诸广文","author":"邓林","text":"西来久别诸文学，霭霭停云思若缄。\n秋迥眺眸穷渭北，夜凉飞梦绕江南。\n坐隅只有高人榻，门外常多长者骖。\n安得此身能插羽，日趋函丈听清谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题使安南给事中思亲卷","author":"邓林","text":"騑騑四牡载驰驱，星使南征入瘴区。\n五岭不穷官驿路，万金难买故园书。\n丹心自许长怀国，白发那堪独倚闾。\n诏赐归宁应有日，且勤王事莫踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题乡友聂长义沧浪轩四首 其一","author":"邓林","text":"天书未召沧浪客，且筑沧浪旧隐居。\n荻渚潮回幽地窄，竹檐云卧小窗虚。\n溪人采绿春相问，沙鸟忘机日与俱。\n见说西邻犹可卜，欲来撑酒看芙渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题乡友聂长义沧浪轩四首 其二","author":"邓林","text":"莲子塘西草尾湾，幽亭风致隔尘寰。\n莓苔浥润归青壁，杨柳分阴与画阑。\n春满一犁江上雨，晚横双黛海门山。\n沧浪歌罢无人和，白鸟飞来相对閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题乡友聂长义沧浪轩四首 其三","author":"邓林","text":"忆昔寻幽碧海隈，槎仙拉我到蓬莱。\n路从黄荻州边过，潮自乌潴巷口来。\n把酒凭阑山似画，濯缨临岸水如苔。\n晚晴一曲西风笛，凉月飞光满钓台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题乡友聂长义沧浪轩四首 其四","author":"邓林","text":"树带斜阳水满矶，卷帘又见钓船归。\n美人笑隔荷花语，稚子闲将竹笛吹。\n半点嚣尘无路入，一般意味有谁知。\n品题如欲穷幽胜，须待岑参到渼陂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴二尹之官交阯二首 其一","author":"邓林","text":"石渠小假出沙堤，堤路新晴多马蹄。\n道是群贤辞上国，直从五岭入蛮溪。\n交情欲话心如织，别酒初斟思已迷。\n遥想旅途相忆处，黄茅满地鹧鸪啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴二尹之官交阯二首 其二","author":"邓林","text":"将军马上凯歌还，绝域尘清宇宙宽。\n铜柱山河皆郡县，雕题人物总衣冠。\n均施雨露回枯槁，广播耕桑惠馁寒。\n闻道九重深有意，都将此责付郎官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":50390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]