[{"title":"松岩八景 其三 方塘水活","author":"张吉","text":"芳草何时歇，落花春自飞。\n悠然憺忘食，游子川上归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50565,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"松岩八景 其四 叠嶂云閒","author":"张吉","text":"云山知几叠，山静云亦迟。\n道人衣带润，伸脚打眠时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50566,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"松岩八景 其五 岩桂秋香","author":"张吉","text":"朝眠岩顶云，莫醉岩底石。\n岩花不知老，香堕几千尺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50567,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"松岩八景 其六 岭松冬秀","author":"张吉","text":"纷纷儿女态，敢与丈人谋。\n独有苍髯叟，寒山共白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50568,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"松岩八景 其七 溪滨奇石","author":"张吉","text":"君航洞庭日，仗剑割云根。\n欲识蛟龙恨，年年风雨痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50569,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"松岩八景 其八 山顶灵泉","author":"张吉","text":"客问此何山，清泉流不已。\n答云古香炉，飞入星源里。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50570,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵留别白沙先生 其一","author":"张吉","text":"归棹破沧潮，遂成千里别。\n亭亭玉台峰，回首心应折。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50571,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵留别白沙先生 其二","author":"张吉","text":"江门千树花，红白纷点缀。\n我登碧玉楼，笑领几茎去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50572,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵留别白沙先生 其三","author":"张吉","text":"先生下堂来，伛偻答我拜。\n白日当户庭，春光浩无外。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50573,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答李子长雨中遣怀 其一","author":"张吉","text":"山僧豆雨熟时，留得先生几日。\n眼中谁与为徒，面面青山涌出。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50574,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答李子长雨中遣怀 其二","author":"张吉","text":"汲涧冷分山月，唫川影弄溪云。\n著处风光如此，分明物外乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50575,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答李子长雨中遣怀 其三","author":"张吉","text":"翛翛万竹禅龛，冉冉孤云石壁。\n不是鼾声若雷，怎得先生消息。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50576,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答李子长雨中遣怀 其四","author":"张吉","text":"叹息崇朝阴雨，半为花靥销魂。\n试学结趺端坐，超然便到黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50577,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"茅林八景为姜太守题 其一 大山拥翠","author":"张吉","text":"芳草蘧蘧蝶梦，碧云杳杳鸡声。\n恰好幽人睡起，一来一往心情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50578,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"茅林八景为姜太守题 其二 曲港拖蓝","author":"张吉","text":"流水湾回几曲，伊人宛在中心。\n静对绿漪滟滟，笑捐黼黻文章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50579,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"茅林八景为姜太守题 其三 林溪渔钓","author":"张吉","text":"细雨斜风弥月，剩水残山几分。\n醉卧白头浪里，茫茫烟草黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50580,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"茅林八景为姜太守题 其四 禅寺晓钟","author":"张吉","text":"冉冉轻云几叶，弯弯缺月半规。\n坐断清宵何许，烟钟长短来时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50581,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"茅林八景为姜太守题 其五 龙潭秋月","author":"张吉","text":"我忆茅林深处，泠然一掬寒湫。\n山月娟娟相照，何人独抱清秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50582,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"茅林八景为姜太守题 其六 牛陇春云","author":"张吉","text":"一犁泽泽东郊，捲得飞云千尺。\n孟浪裁为舞衣，拂拭尧天春色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50583,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"茅林八景为姜太守题 其七 竹轩诗兴","author":"张吉","text":"欲识苦吟心事，公髭日断几茎。\n幽竹翛翛绕屋，閒中月色风声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50584,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"茅林八景为姜太守题 其八 芸馆书声","author":"张吉","text":"先生终日忘餐，细嚼古人糟粕。\n欲觅道腴一真，休与筌蹄相约。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50585,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三洲岩寻濂溪先生题刻不获","author":"张吉","text":"洞里游人几度，纷纷石刻俱存。\n夫子独寻未见，空归暮雨江村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50586,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠同事吴顺德献臣赴永州","author":"张吉","text":"江心一见一胡卢，谙练君应过野夫。\n不是湖南聊共饭，昆崙顶上洗行厨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50587,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟中读吕和叔四子言志诗","author":"张吉","text":"般般剪制皆春服，曲曲溪山尽舞雩。\n点也胸中宽似海，休将勺水席讴歈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50588,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和吴茂贞大理见寄舟中感兴三绝 其一","author":"张吉","text":"经如造化妙难窥，生长收藏自四时。\n若语本原澄彻处，寒潭秋月正适宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50589,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和吴茂贞大理见寄舟中感兴三绝 其二","author":"张吉","text":"阿奴执役供家政，问有能声亦纪纲。\n二氏大为吾道蠹，彼疏斯粺敢相方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50590,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和吴茂贞大理见寄舟中感兴三绝 其三","author":"张吉","text":"是处江山是处天，饥来吃饭饱时眠。\n声音笑貌都消尽，心似寒灰不入禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50591,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和琼台丘先生题陈希夷长睡图","author":"张吉","text":"已逢真主御乾坤，敢问孤儿寡妇们。\n聊与钓台为敌手，百年高枕华山云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50592,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浯溪","author":"张吉","text":"唐亭不见枕浯溪，仅见峿台溪水西。\n一啸度香桥外去，山禽仍近古碑啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50593,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送林少参赴京报政","author":"张吉","text":"记得中都烂漫游，春兰秋菊满囊收。\n公今万里看花去，笑上东风十二楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50594,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"康总戎惠袜偶值偏将献功戏赠一绝","author":"张吉","text":"丰茸软滑雪弯弯，踏雪方惊雪不悭。\n鼠穴已空酣笑罢，阳和旋逐脚跟还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50595,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7