[{"title":"九日有怀","author":"丘浚","text":"寂寞重阳节，篱边菊未开。\n倚门空怅望，不见白衣来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲居杂咏","author":"丘浚","text":"鼎鼎百年间，谁人未老闲。\n古心惟自得，尘事少相关。\n风定一花落，帘开双燕还。\n箪瓢随处有，不是故希颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村行","author":"丘浚","text":"万里劳行役，驱车趁晚晴。\n鸦边残照远，雨外断虹明。\n山径高低路，村舂远近声。\n隔林人语寂，一犬吠相迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村居","author":"丘浚","text":"郭外幽居好，桥边水径斜。\n红飘桐井叶，黄落菜园花。\n浅浅浴凫水，团团宿鹭沙。\n板扉青布旆，记取旧东家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜泊近渔舟有感","author":"丘浚","text":"渔舟何处泊，浅水荻花边。\n风月全家乐，江湖到处田。\n烹鱼邀贾客，乞火与邻船。\n自笑谋生拙，临渊却尔怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚泊","author":"丘浚","text":"风定帆初落，篱根泊晚晴。\n寒潮随月上，秋水共天清。\n隔竹见灯影，横江闻鹤声。\n有怀愁不寐，坐数驿楼更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜到山庄","author":"丘浚","text":"草径直穿园，溪流曲绕田。\n村春应谷响，炊米散林烟。\n雨过池添水，云开树露颠。\n主翁闻犬吠，迎客出门前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽全州蒋隐君友人蒋良之父","author":"丘浚","text":"高人厌世氛，一夕敛天真。\n花落閒庭晚，鸟啼空谷春。\n药囊馀旧剂，茶灶冷香尘。\n埋玉湘江上，悲风起白蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书房四幅为新河许生作 其一","author":"丘浚","text":"镇日掩书窗，心閒万境忘。\n汲泉烹苦茗，添火试沉香。\n琴韵清宵远，诗声白昼长。\n青编长在手，倦倚竹方床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书房四幅为新河许生作 其二","author":"丘浚","text":"一室清如洗，翛然绝俗嚣。\n字临春景蚓，画辨午时猫。\n烟净芸香细，风微竹汗消。\n还期太乙老，藜杖烛清宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庐山瀑布","author":"丘浚","text":"何处飞泉好，庐山自昔闻。\n悬空一水立，蓦地两山分。\n直泻崖前月，平沾树杪云。\n源头如可到，乘兴访匡君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题金山寺","author":"丘浚","text":"岷江万里下，梵刹半空开。\n吴树风吹断，淮山水荡回。\n潮声杂钟磬，波影动楼台。\n千载张公子，题诗会雨来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人日有怀","author":"丘浚","text":"七日逢人好，三年作客赊。\n塞云晴度雁，城日晓翻鸦。\n雪化经冬水，梅开隔岁花。\n欲归归未得，惆怅惜年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早朝 其一","author":"丘浚","text":"落月傍西山，初开虎豹关。\n铜壶龙滴水，朱户兽衔环。\n玉佩趋驰道，香烟拂近班。\n去天才咫尺，不敢望龙颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早朝 其二","author":"丘浚","text":"曙色催仙仗，祥光绕禁闱。\n门开双象侍，钟动万鸦飞。\n江汉宗沧海，星辰拱紫微。\n疏愚亦何幸，每日近清辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人入蜀","author":"丘浚","text":"嗟君万里去，孤棹下云安。\n地湿天常漏，时清道不难。\n江流春泛雪，滩石午生寒。\n如过临邛令，琴心莫浪弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"都下逢友人问讯","author":"丘浚","text":"京国忽相见，苍茫问起居。\n如何三载别，不寄一行书。\n共讶鬓毛改，自怜生计疏。\n故人应笑我，未得赋归欤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题空上人方丈","author":"丘浚","text":"地僻少风尘，僧居即隐沦。\n烟霞方外境，水月定中身。\n长日饭留寄，夕阳钟送人。\n他年如结社，还许醉相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日客友","author":"丘浚","text":"云海欢游地，别来今几何。\n壮心随日减，归思入秋多。\n细雨滋苍藓，寒风剪败荷。\n有怀谁与共，搔首短长歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中有怀","author":"丘浚","text":"风雨昼冥冥，闲愁不自宁。\n只宜长日醉，何可片时醒。\n花落隔帘数，鸟啼攲枕听。\n愿言头蚤白，归去候农星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋晚答友人","author":"丘浚","text":"朝罢归常早，官闲客自希。\n少书随处借，多病与时违。\n访旧怜俱老，逢人厌说归。\n伤心秋又暮，未寄北堂衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杜侍御出宰英德","author":"丘浚","text":"墨绶绾铜章，还乘下濑航。\n重沾新雨露，犹带旧风霜。\n官舍依山浅，溪流到海长。\n邑人遥为喜，令尹得张纲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洞庭图","author":"丘浚","text":"八月潮面阔，天低地尽浮。\n四山通潦水，万里聚重楼。\n木杪仙人过，云中帝女游。\n何时乘雅兴，徙倚豁吟眸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕","author":"丘浚","text":"岁去何劳守，春来不用追。\n明朝想今夕，便是隔年期。\n岁月添中减，人情黠处痴。\n元正与除夜，相去几多时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"丘浚","text":"往事今如此，前途巳可知。\n但求身健在，屡遇岁丰期。\n自分为人拙，谁来问我痴。\n朝回高枕卧，梦见孝文时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过峡山飞来寺","author":"丘浚","text":"三过飞来寺，今朝始一登。\n恍疑山是客，顿悟我曾僧。\n钟响出幽壑，猿声啼古藤。\n本无来与去，明日问南能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有谈龙太初沙诗者或谓其有体无用因足成之","author":"丘浚","text":"茫茫黄出塞，漠漠白铺汀。\n鸟去风平篆，潮回日射星。\n筑堤连相府，度碛到龙庭。\n闻道西河里，漂流不暂停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送谪宦者放还扬州","author":"丘浚","text":"晓日都门道，西风酒一卮。\n几年悲玉后，万里赐环时。\n古水前朝寺，残花后土祠。\n淮南风景好，归去莫教迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送友人涂景旻下第归五羊","author":"丘浚","text":"晓日都门道，春风酒一杯。\n为怜君独去，却忆我同来。\n杨柳春堪折，芙蓉秋始开。\n临岐凝望邈，目断越王台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱忱之弟","author":"丘浚","text":"南人不识重，况此北风吹。\n桑梓久违后，弟兄相见时。\n归云孤度影，老树短垂枝。\n一别又万里，重来未有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送梁叔方行人养病还岭南","author":"丘浚","text":"使节行初返，君恩许暂还。\n聊为六月息，且得几年闲。\n白绕飞云舍，青连过海山。\n自怜家更远，临别忆乡关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚适","author":"丘浚","text":"向晚乘残兴，穿林透水隈。\n林空客鸟过，树动觉人来。\n山戴云头日，风传涧底梅。\n村居多石磴，步步踏苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅溪处士挽章","author":"丘浚","text":"惆怅清溪上，梅飘雪后枝。\n茶烟无鹤避，梁月有人思。\n披氅经行处，巡檐索笑时。\n空馀陈迹在，风雨草离离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"两后过访友人山居","author":"丘浚","text":"竹杖穿云过，柴扉冒雨开。\n好山如洗出，幽鸟似呼来。\n感旧哀丝结，开怀醉玉颓。\n人生欢会切，欲去重迟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感旧偶书","author":"丘浚","text":"忆昔欢游处，青林蓊翠茅。\n竹皮消旧粉，榔腹解新苞。\n沙暖鸡乾浴，泥稀燕湿巢。\n故人谁复在，梦里或神交。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题南华寺大鉴禅师","author":"丘浚","text":"佛法来东旦，禅宗肇岭南。\n一溪香气水，万缕藕丝衫。\n结子花开五，先人枣示三。\n心灯受弘忍，梵派演瞿昙。\n山髻青螺耸，波心碧玉涵。\n众流归大海，孤月印寒潭。\n蔼蔼花云煖，瀼瀼法露甘。\n未回烟水棹，空费葛藤谈。\n奏乐皇冈石，读书张相岩。\n也知祖堂近，无暇一登参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日即事","author":"丘浚","text":"晴日花开蝶拍，暖风柳畔莺声。\n沂水咏歌气象，前川随傍心情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋思","author":"丘浚","text":"水落浅滩石出，霜冷疏林叶丹。\n天外数声过雁，人在高楼倚栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江行","author":"丘浚","text":"翠竹白沙村径，落霞飞鹜江天。\n倚杖夕阳影里，闲看江上归船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即景","author":"丘浚","text":"天通屋漏生白，日映纱窗透明。\n扫地焚香坐处，湛然心地清平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客窗三景次友人韵 其一 黄昏","author":"丘浚","text":"明月欲上未上，乌鸦东飞西飞。\n物类皆知所憩，何事游人未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客窗三景次友人韵 其二 半夜","author":"丘浚","text":"漏滴铜壶恰半，月到天心正圆。\n人在子规声处，几回欲眠不眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客窗三景次友人韵 其三 五更","author":"丘浚","text":"楼上更传五点，邻家鸡叫三声。\n正是销魂时候，倚床坐待天明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"厢房前有一桧树夏热甚向晚散堂闭门倚之而坐颇有林间之趣","author":"丘浚","text":"午睡醒来无事，斜阳转过松阴。\n倚树科头箕踞，宛然身在山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过梅关题张丞相庙","author":"丘浚","text":"平生梦想曲江公，五百年来间气钟。\n行客不知经世业，往来惟羡道傍松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题希夷长睡图","author":"丘浚","text":"坠驴一笑便归山，衾枕乾坤分外宽。\n一汴二杭闽又广，依然春梦未曾阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春闺怨 其一","author":"丘浚","text":"春雨池塘草发芽，春风庭院柳飞花。\n韶光尚有归时节，何事游人未到家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春闺怨 其二","author":"丘浚","text":"旧岁花残今又开，去年人去几曾来。\n不知明岁花时节，人在天涯回未回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意 其一","author":"丘浚","text":"帘幕沉沉窣地垂，重门十二掩斜晖。\n慇勤更把残机理，待剪征夫寄远衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意 其二","author":"丘浚","text":"独守空闺不自怜，怜郎岁晚尚防边。\n秋来莫作还家梦，妾貌于今异少年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题小景","author":"丘浚","text":"石桥流碧水潺湲，千树桃花万叠山。\n谩道仙家有灵药，看来终不似人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚感","author":"丘浚","text":"寒鸦日日晚投林，却忆山家隔万岑。\n岂是不归归未得，暗风吹泪落衣襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为林学士题十二红画","author":"丘浚","text":"丹杏香边翠竹中，幽禽两两立东风。\n不知毛羽红多少，却得人呼十二红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送樊景瞻河南大参","author":"丘浚","text":"天光近处地蒲青，记得君王问贾生。\n谩向河南望河北，碧天凉露滴金茎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送冯副使士定之广东宪台 其一","author":"丘浚","text":"百雉层城雁翅开，阴阴古柏拥霜台。\n登台正好频西望，千里荒烟接野莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送冯副使士定之广东宪台 其二","author":"丘浚","text":"春风不到海边天，喜见皇皇使节鲜。\n料得吴儿心似铁，不妨多饮石门泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送冯副使士定之广东宪台 其三","author":"丘浚","text":"家在天南地尽头，白云归处海悠悠。\n君行是我家居处，莫谩逢人叹远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春寒","author":"丘浚","text":"九十春光将过半，凄凄犹似旧冬天。\n依稀记得江南景，小扇轻衫戏水边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过某氏园亭有感","author":"丘浚","text":"危墙荐棘锁重关，不许游人取次攀。\n一夜西风零落尽，牛羊成队下空山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经旧游有感","author":"丘浚","text":"当年同醉习家池，歌舞流连醉不归。\n今日独来墙外望，亭台依旧主人非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南行途中见北人","author":"丘浚","text":"旅食京华数十春，饱谙霜雪惯风尘。\n南来忽见幽燕客，还似当年遇越人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客中夜雨","author":"丘浚","text":"旅馆秋风夜雨声，思家愁路忆神京。\n寒蛩亦似知人意，相伴哀吟直到明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题程彦实尚书晴洲卷 其一","author":"丘浚","text":"举世昏昏梦里过，晴明时少晦时多。\n一生日月光中老，闲向沙头弄碧波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题程彦实尚书晴洲卷 其二","author":"丘浚","text":"少居河北老江南，风月随身到处参。\n最是芳洲晴景好，泥融沙煖水光涵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题程彦实尚书晴洲卷 其三","author":"丘浚","text":"一片溪山景最奇，空濛潋滟两皆宜。\n青天白日好归去，不待沾裳湿足时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题傅岩图","author":"丘浚","text":"何事君王感梦频，骑箕天上有星辰。\n自从版筑形求后，惟见丹青画美人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题钓台","author":"丘浚","text":"祚终四百巳无汉，滩历千年尚姓严。\n终古祠堂钓台侧，水光山色拥高檐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题墨梅","author":"丘浚","text":"老龙半夜飞下天，蜿蜒斜立瑶阶里。\n玉鳞万点一齐开，凝云不流月如水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松月","author":"丘浚","text":"素蛾夜驾玉蟾蜍，来访云亭五大夫。\n十里人家总惊讶，老龙擎出夜明珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题虞美人墓","author":"丘浚","text":"自古英雄数霸王，喑呜叱咤万人亡。\n只消几句悲凄语，柔尽平生铁石肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春思","author":"丘浚","text":"晖晖初日照窗明，风定飞花落地轻。\n境静不闻人语笑，隔林莺啭一声声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史","author":"丘浚","text":"万人丛里击龙车，说道民愚却不愚。\n天下简编焚毁尽，圮桥依旧有遗书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小景","author":"丘浚","text":"行过山边又水边，眼中非树即寒泉。\n囊琴谩道樵青抱，流水高山不在弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题寄南华寺 其一","author":"丘浚","text":"达摩传得藕丝衫，浮海东来到岭南。\n人向西回法东转，曹溪溪上建伽蓝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题寄南华寺 其二","author":"丘浚","text":"佛法兴从汉永明，始传四十二章经。\n当时未有禅和子，纵有花开子未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]