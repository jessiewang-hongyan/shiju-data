[{"title":"山房石上产芝","author":"薛始亨","text":"中岁好服饵，导引或休粮。\n偶然趺坐处，忽自产芝房。\n采采金枝郁，亭亭玉蕊光。\n因之念园绮，翘首五云旁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山夜","author":"薛始亨","text":"萧萧凉雨过，云汉气鲜澄。\n落叶空山馆，孤琴永夜灯。\n病来常谢客，贫后懒寻僧。\n独有天涯梦，忘情愧未能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西江怀陈元孝衡岳青城之游","author":"薛始亨","text":"渺然秋水上，瑟瑟芦花汀。\n孤唱闻渔榜，繁忧剧夜星。\n三湘怀揽结，西蜀叹沉冥。\n梦里寻君处，芙蓉万刃青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送汪琼州觐省兼怀族叔","author":"薛始亨","text":"驱车辞上国，渡海觐庭闱。\n二月祥风至，孤帆背雁飞。\n政清驯卉服，禄养着莱衣。\n因念吾家籍，竹林何日归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端水送梁翀斧归龙江","author":"薛始亨","text":"之子逌然笑，言归十亩閒。\n予亦烟波客，时时思故山。\n短蓑乘早雨，孤艇入前湾。\n永夜悬明月，君应放白鹇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠温觉斯先辈","author":"薛始亨","text":"夫子富九丘，平生万里游。\n江湖杯杓健，风雨笔床秋。\n黑齿迎藜杖，文身笑蒯缑。\n名山题咏处，白首兴悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石城乐","author":"薛始亨","text":"向夕寒风急，城边细雨过。\n洞房留上客，曲宴夜垂罗。\n嫩蕊花前艳，雏莺叶底歌。\n怜君归骑动，莫似隔明河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客中即事","author":"薛始亨","text":"九月岭霜高，乡心正郁陶。\n龟逢贺监解，琴向子期操。\n雁语连归路，猿啼近客舠。\n谁知老缝掖，还有赠绨袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"毛子霞过山中相别","author":"薛始亨","text":"草间来结驷，斜日照前津。\n换米留官长，披蓑揖故人。\n百年生死泪，四海弟兄亲。\n别后加餐饭，无令白发新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬黄山人耀之","author":"薛始亨","text":"自从归谷口，竹户几回开。\n白日落秋叶，玄言披草莱。\n故书经蠹阙，夜馆听猿哀。\n隐几问南郭，何居若死灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜闺情","author":"薛始亨","text":"夜合庭前馥，佳人掩袂歌。\n幽香为谁媚，弱态不胜罗。\n就枕连宵永，开轩畏露多。\n盈盈华烛泪，催尽盛年过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答杨仪部","author":"薛始亨","text":"岁晏沧江上，闻君新拜官。\n容台周礼乐，画省汉衣冠。\n一卧予将老，孤蓬梦欲阑。\n乘车宵路迥，犹忆故人欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经乱后喜逢徐子","author":"薛始亨","text":"自君南亩去，予亦归山阿。\n故旧半凋谢，相逢醉且歌。\n癯因新病后，老觉别年多。\n耽懒知成癖，生涯奈若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"景二席上谈罗浮名胜","author":"薛始亨","text":"夫子谈山水，四筵倾耳听。\n况复扶藜杖，当年采茯苓。\n披衣谢逋客，长啸入青冥。\n今夕人间月，梅花笑独醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚出寻梁海曲","author":"薛始亨","text":"江上初有月，独行寻故人。\n虫声出露草，渔火隔烟津。\n门有归农过，家为废圃邻。\n夫君颜色好，长啸倚丛筠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"桃花","author":"薛始亨","text":"桃花开正浓，弱柳拂金墉。\n家本秦川女，台连云雨峰，昏虫飞玳瑁。\n晓雀出丰茸。\n却笑狂夫婿，吴音解道侬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓入东溪","author":"薛始亨","text":"清溪闻诵经，茆舍溪边扃。\n野艇出朝雾，寒墟落曙星。\n禽声山悄悄，花影水泠泠。\n试扣伊人户，蓬蒿更满庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岩上人庵玩月","author":"薛始亨","text":"钟罢月已上，僧扉向月开。\n天际微云净，风前晚汐来。\n扫石对趺坐，灭烛临高台。\n好添筇笠影，相伴夜窗梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得松月夜窗虚","author":"薛始亨","text":"风轩萝影白，翻浪落寒枝。\n向夕愁披幄，中庭独望时。\n露侵开镜色，霄近拂云姿。\n幽赏谁应共，危巢野鹤知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆十岁时尝从先子入武夷山","author":"薛始亨","text":"小时如梦里，官舫泊名山。\n弱葛缘霄路，陵苕拂佩环。\n峰殊三十六，水竟九重湾。\n手泽成龙杖，仙源渺莫攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客舍寒食","author":"薛始亨","text":"寒食吾乡土，无饧不禁烧。\n梨花淹客舍，春草梦西樵。\n愁处啼莺断，归期落絮飘。\n天涯一杯酒，风雨暗河桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溪上","author":"薛始亨","text":"长林春鸟唤，人事隔溪烟。\n偶与邻翁约，潮平上钓船。\n夕阳沽酒处，远岸落花天。\n白发酡颜好，狂歌阅岁年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南园","author":"薛始亨","text":"南园文酒社，昭代几人倡。\n尔雅推前辈，风流继盛唐。\n草深方躅泯，席冷古弦张。\n谁念沿洄者，睪然叹汪洋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱子茂茅亭新成和陈草庵","author":"薛始亨","text":"茅亭原不俗，况与草庵邻。\n城郭人民异，园林天趣真。\n江鱼浮岸夕，海燕入帘春。\n馀欲逃烦溽，松风对主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜咏梅花","author":"薛始亨","text":"寒风泛华薄，纤月影娟娟。\n正读美人赋，空伤迟暮年。\n芳情怀远道，清梦惬孤眠。\n谁忍闻羌笛，江城向晓天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朱锡鬯还秀水兼讯其令叔子葆 其一","author":"薛始亨","text":"经年不出户，何处送情人。\n芳草天涯路，杨花暮雨津。\n登楼惟一醉，到舍未残春。\n好向名山里，长埋作客轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朱锡鬯还秀水兼讯其令叔子葆 其二","author":"薛始亨","text":"予生任狂直，古道重箴规。\n举世劳相嫉，孤怀敢自疑。\n谬承结交好，岂但以文词。\n归对东山客，香囊更赌棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚晴","author":"薛始亨","text":"春山连夕雨，野岸百花生。\n与客过南浦，扁舟及晚晴。\n白波分洫细，翠甲绕畦平。\n乡土欢时序，长谣慰耦耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵云端是先子读书处","author":"薛始亨","text":"先子方盛时，名山此下帷。\n才应当世用，心与古人期。\n庐墓不复起，故书那忍披。\n空庭有猿鹤，哀慕旧音仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登西樵山大科峰见日台","author":"薛始亨","text":"淩晨思骋望，绝巘陟秋空。\n旭日出沧海，高台来远风。\n楚天归雁早，岭水趁帆东。\n乡国干戈里，吾将访葛洪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"碧玉洞作","author":"薛始亨","text":"飞瀑与云齐，云边倒接溪。\n秋声落河汉，日色映虹霓。\n石濑晴沙浅，江潮雨岫低。\n琴中碧玉调，何似此凄凄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜","author":"薛始亨","text":"蟋蟀鸣空廊，山中蕙草芳。\n楼台过疏雨，河汉落微霜。\n冉冉岁将晏，悠悠夜正长。\n自怜贫女绩，谁为振馀光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀公羽山人","author":"薛始亨","text":"秋风鸣旧林，万里故人心。\n感此萧条色，何如关塞阴。\n未栖珠树鹤，久废石床琴。\n古道无时赏，松扃待尔寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏柳蝉戏赠侍儿","author":"薛始亨","text":"柳影入金波，蝉声向夕多。\n翠眉长自扫，玄鬓奈卿何。\n月下纤腰舞，风前刻羽歌。\n洁身抱微尚，怜惜为倾柯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日閒居","author":"薛始亨","text":"秋入琴书爽，山斋耳目清。\n井边双柚实，墙外万松声。\n野服修黄老，微词托墨卿。\n从来人事拙，原不为逃名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海幢寺礼空隐和尚受记","author":"薛始亨","text":"龙边参法席，沙界现祇林。\n古佛再出世，逢人直指心。\n钟声江渺渺，幢影月沉沉。\n榻下亲承记，前因感涕深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送魏和公之琼南","author":"薛始亨","text":"春城孰云乐，日日折垂杨。\n识面苦不早，离思何太长。\n住山厌薇蕨，浮海倦津梁。\n万里图南翼，持君三月粮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中即事","author":"薛始亨","text":"石径无泥滓，雨过一渠清。\n返照摇庭宇，寒烟起槛楹。\n废书人宴坐，得食鹤徐行。\n借问经秋事，萧萧竹籁鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖上","author":"薛始亨","text":"草色连湖水，悠悠白日低。\n烟波不可度，春鸟几朝啼。\n相思遵北渚，骋望踏长堤。\n夜梦佳期处，云生归路迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠朱未央","author":"薛始亨","text":"朱子篆朱文，高名天下闻。\n诗成头欲白，兴会酒微醺。\n倾耳谈前席，新眉画细君。\n交游尽萧索，结绶几时云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答蔡鍊师","author":"薛始亨","text":"予幼好奇术，年来无所营。\n一壶常坐卧，虚室少将迎。\n白石歌中烂，黄金赋里成。\n待逢尧舜世，方拟学长生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与杨生约入顶湖山分得兴字","author":"薛始亨","text":"端居念予友，强半已为僧。\n所贵敦微尚，何论得未曾。\n披衣从此始，携手及晨兴。\n朔气严霜早，频年叹履冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韩玉灵夜过小饮梅下得花字","author":"薛始亨","text":"素月通罗幌，巡檐忽见花。\n佳人能惠顾，幽梦破天涯。\n雪早芳情涩，参横瘦影斜。\n岁寒应共尔，莫惜赠瑶华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"巫山之阳香溪之阴明妃神女旧迹存焉","author":"薛始亨","text":"风流江汉地，朝暮雨云深。\n不入阳台梦，谁怜青冢心。\n对君还有赋，遇主恨无金。\n溪水香犹在，愁予学楚吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"容州岁暮怀故园诸友","author":"薛始亨","text":"久客虮攒褐，隆寒户冻蝇。\n纸窗风雨夜，香篆帐帷镫。\n有泪如檐溜，无眠对寺僧。\n遥怜故乡腊，文酒几良朋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉祝本师在和尚","author":"薛始亨","text":"滴滴曹溪派，流风宝象林。\n百花衔鸟遍，初地引人深。\n德造层层塔，经翻字字心。\n欲知无量寿，不坏似黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意","author":"薛始亨","text":"寒郊落日映雕戈，猎骑吹笳尽渡河。\n故里葵生金井干，空城雀啄玉山禾。\n闺中梦逐啼莺断，塞上书凭旅雁过。\n归到酒泉已头白，从军偏是少年多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄鹤楼","author":"薛始亨","text":"橘皮留迹漫烟霞，倦倚孤城骋望赊。\n云梦暮天迷七泽，洞庭秋水接三巴。\n碧潭摇落依依柳，玉笛吹残片片花。\n黄鹤不还鸿又过，茫茫乡路鬓将华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"粤台怀古","author":"薛始亨","text":"龙川霸气起秦馀，魋结王封入汉初。\n飞辇已迷芳草径，高台犹枕落花渠。\n春归燕语新巢湿，日暮莺啼古殿墟。\n几度楼船钟鼓歇，萧萧江畔见樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太息","author":"薛始亨","text":"先生玉貌自非庸，义士能辞卖塞封。\n斜日坐隅占鵩鸟，浑天丸发验铜龙。\n颜衰漫指吴门练，醴去羞将楚市舂。\n碧简谁窥蝌蚪字，綵毫曾向梦中逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漫兴","author":"薛始亨","text":"万井苍茫起野烟，风吹城下草芊芊。\n自娱粤吏曾箕踞，痛哭书生为倒悬。\n云散不知龙五色，歌成浑似鹤千年。\n道傍暮雨愁沽酒，花落春残怨杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"崧台留别邝湛若","author":"薛始亨","text":"榕阴夹陛拥千官，旅食重逢范叔寒。\n吹律忽惊啼鴂舌，曳裾曾笑沐猴冠。\n苍梧西上烽烟直，大庾南窥塞草残。\n贫贱鲁连惟蹈海，片帆天际夕漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒马伏波祠","author":"薛始亨","text":"黄金散尽着羊裘，慷慨怜君有少游。\n一别井蛙归上国，七腰银艾镇西州。\n云台不欲椒房及，石室终令马革酬。\n铜柱至今堪堕泪，飞鸢跕跕瘴江秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游都峤寄曹中秘","author":"薛始亨","text":"京华醉别策疲驴，湖海频年忆脍鱼。\n羁旅每称王命论，故人新有绝交书。\n三江露冷侵愁鬓，八月残荷笑曳裾。\n为报陆沉金马客，临邛秋早病相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀刘客生都宪","author":"薛始亨","text":"曾诏金商对皂囊，弹琴有客感螳螂。\n独持汉约难封吕，不蹑齐平听假王。\n旧国鸟啼瑶水月，严关鸡唱刺桐霜。\n侧身西望长安远，为寄愁心到夜郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日送毛子霞还毗陵至中宿而别","author":"薛始亨","text":"岭水愁看十载分，吴山归去咏停云。\n垂杨满道嘶征马，芳草连天送使君。\n人向五湖春雁后，烟横中宿夜猿闻。\n辉光何日寻愚谷，还集芙蓉倚夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上有怀高望公","author":"薛始亨","text":"老向真僧识本心，狂来山鬼助悲吟。\n春风自泛桃花水，明月长悬枫树林。\n仗节岂能忘蹈海，披裘应不取遗金。\n翩翩堪羡游梁客，寂寞成都绿绮琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄诃林止言上人","author":"薛始亨","text":"倦客萍踪峡水分，青枫亭畔怅离群。\n西江落叶同明月，南亩人归隔暮云。\n门掩深秋虞苑冷，阁临遥汉越台曛。\n相思独把东篱菊，上界钟声迥未闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚寅除夕与温觉斯吴幼更守岁花田旅次得华字","author":"薛始亨","text":"老去方知惜岁华，故人流落共天涯。\n盘飧白酒醉还酌，纸帐青灯寒吐花。\n墐户农归犹旧腊，江城戍晓半悲笳。\n芙蓉枕畔殊萧索，乡国依依北斗斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄在犙和尚","author":"薛始亨","text":"南园飞雪与师逢，信宿难留树下踪。\n千叶贝多香阁曙，一枝藤杖旧山冬。\n定中花落归岩鸟，咒罢云生入钵龙。\n昨梦远公沽酒社，空江残月度疏钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠女道士姚蝉仙","author":"薛始亨","text":"风御鸾骖控太清，连宵秋彻步虚声。\n紫坛鸣佩封章秘，玄鬓胜冠拜舞轻。\n欲赋为云惭宋玉，漫劳入梦见飞琼。\n刀圭自捣神仙窟，百感遥遥对月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重经罗季作大夫池馆","author":"薛始亨","text":"投簪东郭有名园，乱后空馀旧址存。\n叔夜自成高士传，巫咸难予大夫魂。\n白杨鸦噪生台晓，秋草虫悲舞榭昏。\n泪落忆君曾倒屣，十年谁复识王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭邝湛若中秘","author":"薛始亨","text":"五色肝肠绝世姿，名花怪石剩憨痴。\n鼎铭笔阵功将告，书拟文园稿已遗。\n白眼人犹憎阮籍，黄金谁为赎文姬。\n秋风古洞栖迟地，禾黍油油故老悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭邝无界","author":"薛始亨","text":"曾于词赋许生平，三十潜修不近名。\n覆醢可怜由也死，引棺难致巨卿情。\n欲传遗稿寻馀烬，谁托诸孤出乱兵。\n玉貌不因排世难，高秋何事坐围城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟宫人入道","author":"薛始亨","text":"歌舞筵空出建章，旧恩犹怯奏霓裳。\n朱颜未减芙蓉色，玄鬓新抛翡翠妆。\n松露夜翻云袂湿，桂旂秋拂石坛香。\n乘鸾不羡吹箫侣，为阅扬尘海上桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬崔千上朱培筠","author":"薛始亨","text":"红颜不早遇浮丘，尘世蹉跎已白头。\n孤榻久怜山狖夕，短蓑长伴野鼯秋。\n调高郢雪应难和，路握隋珠怯暗投。\n犹赖故人心赏在，每开蓬径待羊求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诞日家宴","author":"薛始亨","text":"罗拜儿童一笑欢，糟糠堂上劝加餐。\n身存敢叹添华发，世外堪容戴箨冠。\n壁里诗书经劫火，云中鸡犬待还丹。\n闲情每逐春风醉，莺语槐阴听未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀祖心禅师","author":"薛始亨","text":"东城忆别木樨秋，谁料袈裟作楚囚。\n丁令枉教身化鹤，图澄真觉石为鸥。\n乌衣群季伤膏野，白足孤踪笑首丘。\n明月玉关人万里，只应南雁识边愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":39905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]