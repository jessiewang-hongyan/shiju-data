n":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵忆甘泉先生","author":"张天赋","text":"酌酒狂歌对万山，乾坤浩荡几何关。\n罗浮老鹤应相待，何日乘风自楚还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜有感","author":"张天赋","text":"寒蛩无限闹空街，唤起离人枕上怀。\n到此方知离别苦，玉人今夜泪香腮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏题壁间","author":"张天赋","text":"几遍龙门点额来，青灯依旧坐书台。\n蟾宫有路终须到，未许时人笑短才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜有怀 其一","author":"张天赋","text":"弦断无缘拨好音，风前吟咏感怀深。\n此情吹入姮娥耳，应起寒酸一样心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜有怀 其二","author":"张天赋","text":"妆台人去月茫茫，默坐无聊已断肠。\n惟有寒蛩知此苦，终霄助予叹凄凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜有怀 其三","author":"张天赋","text":"金风淅淅夜迢迢，四壁蛩声自寂寥。\n展转不成蝴蝶梦，腹中似有断肠刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"勉儿曹","author":"张天赋","text":"少年休恃少年误，我亦从来做少年。\n失着一鞭向前去，望洋今日叹流连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"勉生","author":"张天赋","text":"榴子红兮荔子丹，旧年端午又重还。\n勉旃蚤展云凌志，莫待秋霜点鬓斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"总司考送广州府发落出门自慰","author":"张天赋","text":"且喜苍天秋未残，黄花还放世人看。\n寒梅更有春消息，谈笑封侯应不难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送泰和萧汝阳归因上福欧阳价","author":"张天赋","text":"饯送人龙值一阳，梅花何日报春光。\n蜀江人问行藏事，野服无拘坐叶冈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵李白石主事爱梅亭对梅花绝句十首录六 其一","author":"张天赋","text":"花种寒梅是大家，万千红紫向谁誇。\n乾坤正气凌今古，莫把寻常看此花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵李白石主事爱梅亭对梅花绝句十首录六 其二","author":"张天赋","text":"枳棘原非鸾凤巢，构巢聊藉数根茅。\n眼前风景依稀别，香满乾坤月满稍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵李白石主事爱梅亭对梅花绝句十首录六 其三","author":"张天赋","text":"寒梅香动月初辉，面面山光逼四围。\n最喜春风解人意，时穿花里入柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵李白石主事爱梅亭对梅花绝句十首录六 其四","author":"张天赋","text":"占断江南第一春，无边清洁可人亲。\n几回谩向花前立，香逐风来折角巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵李白石主事爱梅亭对梅花绝句十首录六 其五","author":"张天赋","text":"看花何必问东风，直向花前会大同。\n认到忘言真妙处，孤根夐立是豪雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵李白石主事爱梅亭对梅花绝句十首录六 其六","author":"张天赋","text":"一枝刚趣夺春元，唤转阳和到沁园。\n此去调羹当大用，万年人仰是孤根。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过江门因思白沙先生","author":"张天赋","text":"石门流水出江门，一酌浑如酒半醺。\n袖带暗香人未解，月明移棹动溪云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋雪次滁州孙环山进士韵 其一","author":"张天赋","text":"飞花流出空中现，四野平铺不见垠。\n五出浑然同一白，眼前谁作认花人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689"