79689","path":"明_3.csv","pointer":3811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋雪次滁州孙环山进士韵 其八","author":"张天赋","text":"煖阁高歌兴自漫，逼人风景更谁观。\n封姨也有姮娥巧，碎剪琼花片片寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋雪次滁州孙环山进士韵 其九","author":"张天赋","text":"舞倦天风白满楼，阒然谁不为埋头。\n多情惟有梅花月，添得新妆不带愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋雪次滁州孙环山进士韵 其十","author":"张天赋","text":"琼花飞遍满皇都，顿觉人间素练图。\n寒透黑貂风力峻，穷厓何以得回苏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"骤雨偶成","author":"张天赋","text":"笑登亭子拨开云，山色湖光带酒吞。\n天雨岂颛留客饮，故添湖水两三分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郑友山邀游惠州西湖","author":"张天赋","text":"坡老于今五百年，西湖风景尚依然。\n桃花柳叶东西岸，云影波光上下天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次广州黎练溪韵四首录一","author":"张天赋","text":"水绕柴门几曲湾，葛巾野服对青山。\n日招老鹤庭前舞，偏喜婆娑破醉颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"捐俸助脩灌江桥公出过题","author":"张天赋","text":"碧天清晓出南郊，鸡犬桑麻景物饶。\n笑我未能乘驷马，浪吟聊寄灌江桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀陶涟洲大尹公","author":"张天赋","text":"病卧蓼床欲断魂，花开花落自黄昏。\n白云界限西河水，明月梅花梦扣门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衢州宿赵献公祠","author":"张天赋","text":"半生作事可天知，夜必焚香告所为。\n云外高祠山水绿，青天琴鹤日相随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青山茅屋","author":"张天赋","text":"浩荡乾坤白昼閒，数椽茅屋傍青山。\n无忧仙子知何处，王母瑶池宴未还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题长乐城门吊桥","author":"张天赋","text":"花压江城春日暄，一方按堵尽忻然。\n万年桥下清清水，秋月光涵午夜天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒中有感","author":"张天赋","text":"天地谁能共始终，无穷甲子自流通。\n平生亦有狂吟弄，祇恐消磨酱瓿中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答直庵罗君过访","author":"张天赋","text":"覆雨翻云世讲微，新门旧户混高低。\n直庵不厌秋光冷，对酌黄花酒满卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈朴庵","author":"张天赋","text":"红尘界断白云关，不上天朝拜将坛。\n应是百年人事毕，黄金突兀对青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"勉陈孙婿子信","author":"张天赋","text":"石有峰分下有泉，涓涓觱沸喜清涟。\n行看到海无留碍，润泽周流遍八埏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻黄墨泉建墨池书屋三首 其一","author":"张天赋","text":"墨池旧有翰林堂，世远荆蓁迹已荒。\n闻说贤哉今复古，落成何日共徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻黄墨泉建墨池书屋三首 其二","author":"张天赋","text":"落成何日共徜徉，池水如云翰墨香。\n最喜孟郊老邻舍，更誇山谷旧声光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访宗厚兄不遇","author":"张天赋","text":"几度多君空过我，今朝还我又虚行。\n满庭风草皆吾道，对此披怀即主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒吕梁祠关云长庙","author":"张天赋","text":"中山炎烬一星红，全仗吹嘘结义风。\n风雨吕梁祠上竹，令人千古仰孤忠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"百鸟图","author":"张天赋","text":"朝阳鸣凤集梧桐，众鸟纷纷共主翁。\n且喜一图今满百，生生不已到无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题潘松峰节母","author":"张天赋","text":"笑杀男儿枉读书，朝臣秦楚暮臣吴。\n何如一醮终无异，潘母堂前烈丈夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙卯种神光山阴路松总事","author":"张天赋","text":"叶冈冈上树成丛，分种神光十八公。\n分付游人无剪伐，绿阴满路引清风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"复种神光山柏一绝纪之","author":"张天赋","text":"白发重来旧胜游，更裁松柏助清幽。\n伫看黛色参天日，擎起神光射斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒中口号","author":"张天赋","text":"困倦无聊懒作诗，高山音调少人知。\n欲将心向渔郎说，何处江头好钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"表弟黄伯㴋来学一月告辞诗以送之","author":"张天赋","text":"兰室分香归墨池，梅花从此有君知。\n担头满载皆吾道，莫负南庄一月师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸卯冬出行之北赴选夜宿林头晓发一绝","author":"张天赋","text":"行行信步到林头，满眼神光夜未收。\n一笑出门天地晓，广寒指日桂香浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次素庵兄韵","author":"张天赋","text":"雨洗槐枝绿放黄，可人秋色孰担当。\n天风打扫青云路，吹送双飞折桂郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"命名三首 其一 讳家仁","author":"张天赋","text":"一国仁兮自一家，一家仁又岂由他。\n直须我与仁为体，克复工夫莫减些。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"命名三首 其二 讳家让","author":"张天赋","text":"自家不让教谁让，我让期他让甚么。\n最此一关能达却，后头功效尽居多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"命名三首 其三 讳家喻","author":"张天赋","text":"汝欲喻家先自喻，一人颦笑万人模。\n在师遗有修身诀，取法躬行是丈夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"建浏阳浮桥成","author":"张天赋","text":"华表临流夹峙雄，横江铁索系青龙。\n蹇裳仅免行人病，尚赖循良继后功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"尝治事公堂有雀时飞集案上漫吟一绝","author":"张天赋","text":"案上清风绝点埃，等閒时往复时来。\n乾坤物我浑忘却，墙角冲寒喜放梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与广州庠友罗道卿同谒伦白山太史索家君竹小隐序后数日赋一绝以速之","author":"张天赋","text":"万丈龙门未易过，感君指引渡风波。\n海头多少傍人眼，不济于今将若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"时雨","author":"张天赋","text":"阿香一震暗千山，滂沛甘霖九有间。\n啼鸟有情春在在，无边花柳转衰颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自石门发舟晚宿大船坊次日发过平望驿午过吴江县晚抵苏州泊阊门","author":"张天赋","text":"石门越宿大船坊，平望湖开一鉴光。\n午过吴江风力顺，姑苏台下吊吴王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老街八景 其一 汉祠忠节","author":"张天赋","text":"三国争分势力均，汉家正统认谁真。\n匡扶天地知肝胆，庙貌千秋仰虎臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老街八景 其二 朝仪祝寿","author":"张天赋","text":"梵宫时拥九龙楼，海外孤臣拜紫旒。\n翘首嵩呼天万里，履声我欲殿东头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老街八景 其三 书声彻夜","author":"张天赋","text":"黄昏灯火照离明，朗朗吾伊压漏声。\n邺驾积云春不断，家家礼乐户朱程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老街八景 其四 紫薇行署","author":"张天赋","text":"曾展丝纶阁不才，九重分命带春来。\n黄昏独坐谁为伴，花影重重覆绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老街八景 其五 井冽涵秋","author":"张天赋","text":"混混芳泉百尺深，冰壶清夜月浮金。\n天瓢指日王明汲，慰却苍生渴望心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":3851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]