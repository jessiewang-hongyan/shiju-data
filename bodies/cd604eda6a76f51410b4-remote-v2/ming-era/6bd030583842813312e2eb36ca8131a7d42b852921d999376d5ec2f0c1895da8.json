[{"title":"廷试早入左掖","author":"胡所思","text":"左掖廊回月转西，露华犹浥报晨鸡。\n香浮御宇朝仪肃，花映宫袍舞蹈齐。\n凤署弘开翻玉检，霓旌遥引控霜蹄。\n谬惭执简螭头下，对罢天门日未低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和贾舍人早朝大明宫","author":"胡所思","text":"紫宸初启碧天长，鹓序瑶阶曙色苍。\n拜舞衣冠瞻舜日，昭回文物焕尧章。\n光生宝扇分鸾影，烟袅金炉燃兽香。\n共际明时诸宰辅，五云深处侍天王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠徐合川南归","author":"胡所思","text":"忆昔西城少小时，相看发发渐成丝。\n荒村览胜曾联榻，上国观光喜共驰。\n乡绪几随流水去，别情都付酒杯知。\n临歧未得同归棹，把袂殷勤一赋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏白鹤花","author":"胡所思","text":"白鹤花开八月秋，冰姿雪质玉雕锼。\n联芳宛若排云雁，翔集还如戏水鸥。\n华表乍归霜皎皎，青田无梦夜悠悠。\n烟花嫩逐扬州去，飞向琴堂伴客游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日同黎惟敬泛舟","author":"胡所思","text":"暑雨初晴夏五辰，买舟沽酒穗城滨。\n停桡漫泊珠江晓，弹板高歌玉树春。\n竟日遨游经别墅，凌风摇曳过通津。\n碧花细柳盈归路，尽属扁舟适意人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐有怀仰川并寄二弟","author":"胡所思","text":"灵洲祖席重离群，秉烛狂歌酒半醺。\n天地还谁知此意，江山嗤我负斯文。\n怀君梦绕三江月，忆弟情依五岭云。\n南首北驰无限意，岸梅汀柳共欣欣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"见叶落有感","author":"胡所思","text":"庭树凉侵昨夜飙，晓来落叶响萧萧。\n梧桐影里随风舞，萸菊香中带雨飘。\n黄坠已怜翻短砌，绿阴无复上柔条。\n挺然岁晚看松柏，独抱寒芳未易凋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和黎瑶石寄怀","author":"胡所思","text":"玉树璚花碧径长，武陵人远忆仙郎。\n孤轩对酒情愈重，四月寻春花更香。\n寂寞不堪欹北枕，秾华疑是近东皇。\n飘飘几度关城月，两地相思各一方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春","author":"胡所思","text":"每爱春来便浩歌，芳心其奈异乡何。\n数茎短发閒中理，三载长安梦里过。\n寒谷暖回梅影瘦，霜台春静鸟声和。\n东风吹起豪游兴，何处亭阶月色多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"华岩洞","author":"胡所思","text":"华岩仙去不知年，侠客来游意惘然。\n流水桃花俱幻迹，空馀芳草碧连天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对花","author":"胡所思","text":"南浦枝头花正明，北窗树底散群英。\n花开花落寻常事，肯信东风亦世情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"简水南黎伯亨","author":"粱沛","text":"一岛清风接海霞，水南风景最堪誇。\n上篱薯蓣春添蔓，绕屋槟榔夏放花。\n狞犬入山多鹿豕，小舟出港足鱼虾。\n谁知绝岛穷荒地，犹有幽人处士家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"二月宿小圃山家用唐韵","author":"粱沛","text":"提筐我入采山芝，正是春分二月时。\n涧草雨馀浮绿远，岩花风软送香迟。\n缘崖蹑屐探奇崛，坐树斜身凭曲枝。\n暂借此中閒数日，鹿麋不是老相知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"颂陈浅泉擒寇","author":"黄鉴","text":"海龙快马两渠魁，南北郊原尽烬灰。\n中夜千岩冤鬼哭，三秋万井野棠开。\n一从奇计歼元恶，笑踊长歌满钓台。\n五六年前兵未动，痛思夫子不重来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上凌军门大征德庆两山平","author":"梁崖","text":"握符谁独秉先忧？\n万里□□驻□陬。\n节钺喜逢经国老，干戈□吊泣原幽。\n即看执馘归芹□，未□降幡出石头。\n今日乾坤凭再造，千年遗颂在苏州。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上凌军门大征德庆两山平","author":"陈大政","text":"玺书特授为分忧，十万天兵下粤陬。\n制阃权宜鈇钺重，运筹机入鬼神幽。\n平猺颂满苍生口，启邑功高锦石头。\n万里山河如带砺，千年屏翰壮南州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽陈衍死敌","author":"黎镒","text":"少年长抱请缨才，舞剑鸣弓出草莱。\n铜柱自期军业建，辕门谁料将星颓。\n半千部曲生逾壮，一寸丹心死不灰。\n怅望云台空一梦，英雄千载有馀哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"锦石撑空","author":"谢维申","text":"崚嶒柱石耸云巅，撑住东南半壁天。\n锦障化为虹气去，年年春裹百花鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湾渔唱","author":"谢维申","text":"晚风潭水静悠悠，渔艇閒横对白鸥。\n醉把沧浪歌一曲，满江明月渚云浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王宗伯偕游翠岩亭二首 其一","author":"苏恩","text":"巃嵷回合引丹梯，藓蚀萝悬紫翠迷。\n自是春卿能选胜，摩崖天畔纪游题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王宗伯偕游翠岩亭二首 其二","author":"苏恩","text":"傍石穿林好卜居，十年踪迹倦游馀。\n此身合寄青山傲，静看岩云自卷舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"动星隐钓西南沙","author":"梁可基","text":"蓝川流水杏花初，城市心尘肯到无。\n箬笠蓑衣烟雨去，老翁依旧一狂奴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铜鼓岭","author":"郑敦复","text":"铜鼓经埋讶许年，谁人指在此山前。\n山峰得此应名世，何似相忘混沌天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浴日亭","author":"曾唯","text":"海外尘区别有天，依稀蓬岛落黄湾。\n沧溟万里开金镜，羲驭孤轮涌雪山。\n曝背未能酬壮志，望洋端可洗衰颜。\n登亭漫兴浑无际，极目扶桑指顾间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西郊浮邱寺观午时莲","author":"王昶","text":"君不见图澄幻术施奇咒，钵底花开顷刻就。\n又不见灵彻雕镂运匠心，滴滴含风催玉漏。\n须知巧极是人工，何如武夷曲涧东。\n机缄未易向人启，芳心才吐日当中。\n白如冰玉小如指，叶罕根浮坭不滓。\n君平卖卜正垂帘，黑甜梦破人方起。\n我闻地支之数午为阳，阳舒阴惨本其常。\n又闻五行之位午属火，水生火发奚不可。\n太息濂溪空注图，二五精蕴发所无。\n此花独禀天地正，作说不及胡为乎。\n白昼已过阴霾冱，皎皎澄怀终莫吐。\n从来显晦贵因时，肯与木槿争朝暮。\n吁嗟尧阶蓂荚又何年，晦朔不爽至今传。\n我欲移根归太液，重华相映际中天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游浮邱呈赵太史","author":"陈宏乘","text":"芳郊十里带溪山，仙吏情兼水石间。\n讵但丹砂垂世外，却移玄圃在人间。\n平芜莽莽孤烟断，落日苍苍独鹤还。\n何事桃源重借问，暂来此地远尘寰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文裔龙泉步知县秦志道韵","author":"王震","text":"社延一脉五龙泉，飞汉神龙不及眠。\n要作雨霖苏六合，此泉应占百泉先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瑞椰树分三干并起结实古未有也","author":"王震","text":"椰树由来是直生，云何创见突三茎。\n昂霄竞彩侵云绿，参汉连科弄月明。\n南北杨华都挺秀，春秋舞干总奇青。\n更欣结果齐珠缀，一路添株耸太清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题飞来寺","author":"徐士唐","text":"凝碧湾头舣钓船，扪萝凌绝访诸天。\n晴晖忽散千峰雨，虚谷惟闻百道泉。\n唐宋碑残思幻迹，禺阳仙化是何年。\n登临便欲离尘网，卜筑幽栖学问禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"边上","author":"张佃","text":"夜夜三边动鼓鼙，辽阳烽火达关西。\n风吹马勒寒初起，尘暗龙城日未低。\n原上饥兵攒草卧，碛中新鬼望乡啼。\n李陵一去胡天渺，愁见黄云锁沷溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莲港夜泊","author":"张佃","text":"港口维舟正落潮，北风吹雨夜萧萧。\n故乡此去三千里，归梦不知江水遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"茅斋","author":"张佃","text":"茅斋掩映横塘曲，树隐朝烟鸣野犊。\n丈人睡起忽开门，细雨无声春草绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江村春兴二首 其一","author":"梁汴","text":"寂寂桃花峡，柴门隐士家。\n绕墙多蛱蝶，狎岸半鱼虾。\n地僻多栽竹，园肥可种瓜。\n春晴初倦读，策杖课桑麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江村春兴二首 其二","author":"梁汴","text":"缓步临江岸，徘徊凭古榕。\n天空疏鸟度，矶滑篆苔封。\n野艇同孤棹，斜阳挂远峰。\n豪歌谁和答，隔浦有渔翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登西樵山","author":"梁汴","text":"层峦叠叠拂流霞，步上名峰石径斜。\n沾袂飞泉千点雪，媚人沿涧四时花。\n山腰岚锁云根笋，灶底烟烹铁鼎茶。\n指点平原天地阔，傍林茅屋几人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送徐海石侍御还京","author":"苏尚劝","text":"起草明光日月悬，翩翩金马又长安。\n一天甘雨春同煦，载道清冰夏亦寒。\n万斛才华观补衮，百年交谊庆弹冠。\n凤池此日夔龙集，麟阁勋名取次看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠王赤玄","author":"苏尚劝","text":"荏苒青丝倏已皤，久拚踪迹寄烟萝。\n临流剩有观鱼乐，对酒能无击缶歌。\n花发篁园推健笔，月明池馆舞轻罗。\n槐阴深处荷香细，一曲薰弦兴转多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经谢石潨宅","author":"李秉徵","text":"叹息君家十二楼，楼中歌舞不曾休。\n好花三径相援引，美酒千杯迭献酬。\n一自昆明遗劫火，遂从南阮学清流。\n琴棋彻夜无冬夏，燕雀中庭任去留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别顾白湖","author":"李秉徵","text":"行色匆匆冒晓风，絷维无计挽青骢。\n回头易水骊歌迥，极目吴山马首东。\n两地春愁鱼喷浪，一天秋思雁横空。\n无端莫道阳关曲，添惹微霜入镜中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘掌教归闽","author":"李秉钝","text":"先生何事遽严装，芹泮陶成两鬓霜。\n三载雁稀乡梦远，千江枫叶客思忙。\n登庸已谢岩廊想，饯别谁迟驿路觞。\n满地离情题不尽，翩翩云翮向扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和侍御钟心渠","author":"李秉钝","text":"正色霜台羡国华，庙堂忧急愧匏瓜。\n禁中午夜宽前席，海内文章仰大家。\n汉节雅宜推揽辔，楚歌谁复拟传芭。\n数回梦到书帷地，何日从容话五车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李时郁，南海人。明世宗嘉靖年间诸生。事见明郭棐、清陈兰芝《岭海名胜记》卷三海珠","author":"李时郁","text":"双舄凌风海上山，空中楼阁有无间。\n清秋击鼓冯夷舞，白日弄珠神女还。\n淡淡云霞悬宝地，泠泠钟磬出人寰。\n尘心自觉销来尽，共拟移尊更一扳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游小金山","author":"李时郁","text":"梦入虎溪东，宛然见远公。\n云边思驭鹤，天外忆飞鸿。\n不启琅函秘，无由误法通。\n禅心不可得，秋月湛波中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"泛月入罗浮","author":"李时郁","text":"星槎秋杪泛银河，千里罗浮一夕过。\n独倚西风吹玉笛，碧空凉月万山多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"麻姑峰","author":"李时郁","text":"朱明洞侧挺孤峰，黛色为眉玉作容。\n山上傥趋王母宴，朝来云雨定乘龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来峰","author":"李时郁","text":"耀真曾此聚群仙，谁似飞来七洞天。\n但说峰头多异鸟，不知浮海是何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"聚霞峰","author":"李时郁","text":"五色山头绚彩光，谁言天外即璇房。\n非窥汉殿求丹室，定向瑶池进寿觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黍珠庵","author":"李时郁","text":"一庵深锁铁桥西，庵里明珠似火齐。\n若向仙灵论仙事，鲍家丹女葛家妻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"列仙坛","author":"李时郁","text":"咫尺高峰是太清，月明仙会宴瑶京。\n但从紫府窥直箓，不必人间留姓名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤凰谷","author":"李时郁","text":"岐山今在罗浮侧，皇明恍与周齐德。\n为问西来鸟双青，何似兹山禽五色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青霞谷","author":"李时郁","text":"岩前乱石本嶙峋，洞口桃花片片新。\n流水自鸣丹灶冷，餐霞难觅旧时人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铁桥","author":"李时郁","text":"罗山桥水隔浮山，桥上群仙日在还。\n纵有飞泉流涧底，仙源那得到人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题凤埕八景 其一 东环金石景","author":"黄诏","text":"顾瞻日出冈之东，赤光电烁涵金红。\n谁致赭糖同粪土，天教瓜子作崆峒。\n秋阳烁以真陶冶，涨海陶成卧紫龙。\n百鍊归来未昏黑，还须坡老辟双峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题凤埕八景 其二 南带玉砂景","author":"黄诏","text":"玉种移来到海□，天然佳案在村前。\n高秋入眼飞琼屑，盛夏汤蹄飏璧烟。\n午夜月明满彀见，三春雨浣玷瑕鲜。\n门庭白面多和璞，得遇相知价倍偿。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题凤埕八景 其三 西扃虎屿景","author":"黄诏","text":"耽耽双兽出林形，浮渡湾门内地凭。\n风撼潮头须吻白，月升海底爪牙明。\n舟无蹈尾知常避，人惯如毛探不惊。\n长啸海天文炳隐，咆哮谁道食盐声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题凤埕八景 其四 北枕鸿山景","author":"黄诏","text":"屏帐重重气势鸿，昆崙未上眼眶中。\n尧封保障方如扆，禹迹刊随弯似弓。\n凤嘴有声羞煮海，壶山没石谩回风。\n瀛洲东顾漳南路，北面维藩第一功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题凤埕八景 其五 古峰插斗景","author":"黄诏","text":"卓卓凌云势迫空，孤高不与众峰同。\n尖挥风雨魅星外，顶入东南斗柄中。\n近视高牙开大纛，远瞻臣阙倚崆峒。\n一枝千古斯文笔，留写封章献九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题凤埕八景 其六 碧海连天景","author":"黄诏","text":"观水东南到海滨，波澜万颂渺无边。\n祝融一怒山翻雪，飓母初呈浪拍天。\n日落鱼龙腾雾涌，夜沉星斗弄波妍。\n五湖纵阔难为水，笑却精衔与血鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题凤埕八景 其七 岗气旋清景","author":"黄诏","text":"自谪昌黎到海滨，振经消息岳河新。\n村希青草休烧火，山咸黄茅不避人。\n坤辟民生无夭折，风还海俗有精神。\n如今邹鲁中原地，不是当时五岭民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题凤埕八景 其八 榕阴积翠景","author":"黄诏","text":"乔木阴森聚国族，风韵依稀不记年。\n憩暑影明檠翠盖，印沙叶冗步青钱。\n栖柯鸟隐窥蝉噪，敲石残棋听鹤眠。\n出地云根当欹枕，羲皇人醉日中天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初冬过诃林寺净隐禅房","author":"梁绍裘","text":"莲社风流尚可寻，壶觞应拟就东林。\n旃檀岁久香犹积，薝卜霜凋草半侵。\n五蕴尽从尘外断，三车还听夜来深。\n相逢更问无生偈，一卧青山任陆沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游海珠寺","author":"梁绍裘","text":"何年栖觉树，此地傲沧波。\n三悟超空界，群生溺爱河。\n石龙馀赞叹，瑶岛谩经过。\n何似心珠妙，圆明照大罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜命酌终南山水天炼师于海珠信宿赋此 其一","author":"梁绍裘","text":"共道珠江钜且圆，何如罔象得遗玄。\n骊龙戏去浮波上，神女擎来献佛前。\n屹立狂澜标亿劫，平开胜概入诸天。\n乾坤幻境浑如此，弱水三山恰并传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜命酌终南山水天炼师于海珠信宿赋此 其二","author":"梁绍裘","text":"自性本来无执著，为仙为释更为儒。\n乍看卓锡依珠寺，须信栖神上玉都。\n苦海波涛原浩浩，觉城色相本无无。\n大千世界河沙数，尽入如来一黍珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜命酌终南山水天炼师于海珠信宿赋此 其三","author":"梁绍裘","text":"石龙浩劫度何年，岛屿中流别表天。\n灯火冲霄欢海若，星河留月醉神仙。\n国开极乐吾能到，梦入华胥尔觉先。\n一颗摩尼眇珠黍，三千世界本完全。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小金山送黎秘书还朝","author":"梁绍裘","text":"魏阙瞻天近，灵洲话别初。\n引杯兰气合，临眺佩声徐。\n雅韵端明在，高风秘阁馀。\n由来芳草意，挂席莫踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]