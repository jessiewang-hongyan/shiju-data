[{"title":"晓过双溪道中","author":"王绂","text":"残月欲低溪水明，林香拂拂晓风清。\n鸟从万木阴中响，人在乱山深处行。\n境异自令心独赏，趣幽翻觉句难成。\n不知蜀道几千里，一路吟哦到锦城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26034,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至成都","author":"王绂","text":"京国远来将万里，士民欢悦共讴吟。\n久钦西伯施仁政，终见东平乐善心。\n江带锦城花烂漫，山横剑阁树萧森。\n只今宗社安如石，圣念尤亲九族深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26035,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题杜工部浣花草堂","author":"王绂","text":"浣花溪上草堂前，想像当时思惘然。\n鬓老风尘多自感，身经丧乱复谁怜。\n懒从江夏誇鹦鹉，独向西川拜杜鹃。\n知己惟应有严武，醉言何事又招愆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26036,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武侯庙","author":"王绂","text":"忠义分明两出师，令人读罢想当时。\n躬耕本亦巢由志，襟抱聊将管乐期。\n鱼水一时心已合，风云八阵石难移。\n长星不使营前坠，礼乐重兴未可知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26037,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"相如驷马桥","author":"王绂","text":"相如辞赋拟风骚，浪迹临邛逸气飘。\n犊鼻岂应亲涤器，驷车直欲预题桥。\n才名当世黄金重，志愿凌云碧汉遥。\n富贵如何才满意，白头吟里恨偏饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26038,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬四明王教授彬见赠韵","author":"王绂","text":"君才堪作济川舟，愧我无能鬓已秋。\n江左家声浑寂寞，山阴宗谱尚绸缪。\n经横绛帐崇师道，裾曳金门久宦游。\n正恐相逢又相别，玉瓶同拟醉沙头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26039,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再用韵留别","author":"王绂","text":"西风江上促归舟，落木啼猿总是秋。\n愧我半生多旅寓，怜君一见即绸缪。\n宦情那肯轻同志，乡语偏饶访旧游。\n别后相思重回首，吴云迢递海东头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26040,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬廖纪善去怠赠韵","author":"王绂","text":"文采芙蕖映碧湾，令人相对意忘还。\n官閒得俸惟酤酒，公退钩帘只看山。\n簪笔殿头居纪职，曳裾门下出朝班。\n思君正似仙凡隔，瞻望蓬瀛弱水间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26041,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再用韵留别","author":"王绂","text":"巴渝西上几千湾，才得停桡又促还。\n归路渐看京口树，吟筇难遍蜀中山。\n黄花老我思秋径，白简怜君缀晓班。\n会别人生那中料，信音须仗往来间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26042,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋对月","author":"王绂","text":"皎皎冰轮对客圆，客心相对两堪怜。\n清光此夜异常夜，狂兴近年非少年。\n弟戍边城劳别梦，儿留乡井望归船。\n一家骨肉分三处，应共感怀多未眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26043,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈尚宾还靖州","author":"王绂","text":"嗟余湖海度年华，尔复飘零更可嗟。\n旧业暂归翻是客，异乡重到即为家。\n江连云梦孤帆远，日落衡湘断雁斜。\n后夜月明何处泊，相思回首各天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26044,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中晓望都城有怀诸公","author":"王绂","text":"烟深孤塔是长干，路近都城望眼宽。\n江水今无南北限，山形原作虎龙蟠。\n云开魏阙朝阳满，月落秦淮晓色寒。\n遥想此时天上客，从容鸣佩列朝端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26045,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢惠皮墩","author":"王绂","text":"拜惠仙墩三尺圆，漆成文采瘦藤穿。\n最宜箕踞长松下，又好跏趺绣佛前。\n四体但能安即了，寸心尤觉静相便。\n题诗欲拟琼瑶报，坐对青灯夜不眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26046,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题赠秋林草堂图","author":"王绂","text":"书剑飘飘年复年，感侯相见即相怜。\n行藏只说都由已，穷达宁知却在天。\n远塞关河迷落日，故山庭院锁秋烟。\n多情猿鹤应贻诮，荒却当年种秫田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26047,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为黄侍读赋瑞菊","author":"王绂","text":"秋英特表君家瑞，合蒂联葩色更佳。\n让国夷齐双节在，分金管鲍两心谐。\n霜凝素瓣连环玉，风动芳丛并股钗。\n知是花神意加倍，何妨叠日醉高斋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26048,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼松庵性海师淮","author":"王绂","text":"方外交情师最优，寻常相见即相留。\n蒲团对坐听松雨，茶具同携瀹涧流。\n丈室独存禅榻冷，一灯空照影堂秋。\n固知去住皆虚幻，顾我能无感旧游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26049,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈指挥文懿还常德","author":"王绂","text":"将军先世太丘陈，功著当今号虎臣。\n每效忠勤酬圣主，久持威信服蛮人。\n船冲官渡潮声急，马踏京尘柳色新。\n闻说辕门临胜地，桃花开遍武陵春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26050,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄以中家兄","author":"王绂","text":"客窗无事即思兄，消息传来信且惊。\n万里独归悲丧子，一身谁料老依甥。\n田园尚足供庖廪，杯酒聊将适性情。\n安得乞閒寻旧隐，白头相对了馀生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26051,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄钱汝容","author":"王绂","text":"衣冠楚楚整容仪，吴越云仍第几支。\n应役最勤官府事，逢人多诵鬼仙诗。\n秫收南亩时供酒，烛剪西窗夜奕棋。\n愧我尘途归未得，衡门何日共栖迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26052,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈孟敷归吴中兼简诸友","author":"王绂","text":"绿槐官舍澹朝晖，回首乡山子独归。\n去路秖愁梅雨滞，到家应喜药苗肥。\n青樽旧约呼邻酒，白苧新裁换客衣。\n吴下故人如有问，每惭泉石久相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26053,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送任大参勉之福建","author":"王绂","text":"都亭南望路迢迢，仗拥双旌引去轺。\n官拜大参行外省，人推清誉满中朝。\n风回海舶珠犀集，雨洗闽山瘴沴消。\n服远最宜恩信立，伫听嘉政播民谣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26054,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题竹","author":"王绂","text":"林下萧然拔俗姿，难随花柳竞芳时。\n秋深风雨邀谁听，岁晚冰霜只自知。\n节带粉痕龙骨蜕，叶随清影凤毛披。\n王猷去后高风远，世眼相看总未宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26055,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题赠潘克诚菖蒲卷","author":"王绂","text":"一寸云根九节生，人传尧韭是嘉名。\n曾闻久服身长健，最喜相看眼倍明。\n露带晓光珠滴沥，水涵秋影剑峥嵘。\n题诗记得池亭上，窗几无尘宿雨晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26056,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄内弟赵叔平","author":"王绂","text":"别来不觉又秋风，历想君家在眼中。\n稚子情娇初学语，慈亲年老近加聋。\n新居每对千竿竹，先陇应添几尺松。\n世业喜闻能复旧，休将百万一枭空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26057,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题友竹轩","author":"王绂","text":"梅易飘零松已老，此君交久更多情。\n晚凉移榻就林影，秋夜读书来雨声。\n劲节岂随时俗态，虚心常结岁寒盟。\n王猷未必非知己，直造敲门肯见迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26058,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄邓舜英","author":"王绂","text":"素耽书法又耽诗，眉宇分明玉雪姿。\n共乐琴樽欣有弟，独持门户叹无儿。\n数间茆屋风生榻，千亩禾田水坏陂。\n惆怅别来浑二载，旅窗明月几相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26059,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄潘克诚","author":"王绂","text":"年来潘鬓渐成霜，满架牙签总是方。\n数转曲栏通鹤径，一披低屋养花房。\n贤郎盛暑调汤倦，童子新晴晒药忙。\n闻说家西新买地，半栽蔬果半栽桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26060,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄余彦行","author":"王绂","text":"客边无处寄相思，交谊如君更有谁。\n岂独芝兰沾我辈，久将诗礼及吾儿。\n斋前曲径稠桑合，门外横桥细柳垂。\n乡梦觉来犹历历，不知何日是归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26061,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄古铁先生","author":"王绂","text":"鹤发童颜九十翁，数间书屋住溪东。\n通仙每得悬壶术，遗世长思荷锸风。\n春暖酒醅浮瓮绿，夜深丹火伏炉红。\n别来高致空怀仰，何日从容语笑同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26062,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄德常先生","author":"王绂","text":"杖藜时复到山城，鹤骨清癯步履轻。\n不是里胥催过割，定因官府报开耕。\n黄花绕径秋霜晓，红稻登场宿雨晴。\n闻说近看庄子熟，满群家雁尽能鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26063,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄吕教谕先生","author":"王绂","text":"生平典教老归休，肩背龙钟雪满头。\n圣主特颁新诰敕，朝臣多说旧从游。\n园池雨歇禽鱼静，几秋清竹树幽。\n昨日有书来翰苑，墓铭先欲向人求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26064,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄一瓢余君","author":"王绂","text":"闻君哀毁若为情，骨立萧然鬓雪明。\n井臼秪应劳阃政，箪瓢犹且托门生。\n慈帷惨淡秋灯影，破屋凄凉夜雨声。\n如此孤贫良不恶，轻肥那得免忧惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26065,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄匡世德","author":"王绂","text":"风流应不似当年，镜里愁看雪满颠。\n博具更无豪客对，酒杯聊共细君传。\n久抛租产难供米，旧积房奁尽卖钱。\n肯信多男又多累，一身嬴得日高眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26066,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄浦懒翁","author":"王绂","text":"一幅乌纱两鬓丝，令人常想旧容仪。\n诗名老去尤推重，药术年来更绝奇。\n红杏轩窗春澹澹，绿杨门巷昼迟迟。\n遥知燕处浑无事，水浸雕笼浴画眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26067,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松筠轩","author":"王绂","text":"窗户无尘一径深，古松修竹翠阴森。\n采花为酒落金粉，挑笋作蔬抽玳簪。\n夜月每看祥凤宿，秋风时听老龙吟。\n平生独抱幽人操，谁复岁寒同此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26068,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王经历","author":"王绂","text":"六十难称致仕年，君今独许乐林泉。\n近臣殿陛宣恩旨，朝士都门列祖筵。\n江带去程辞建业，山迎归棹入临川。\n遥知今岁重阳酒，应共比邻醉菊边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26069,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题苍筤池馆","author":"王绂","text":"轩窗开处小池平，翠竹新栽绕径生。\n洗药每惊鱼跃起，扫苔时放鹤来行。\n凉生清籁秋偏早，影动微波月倍明。\n惹得王猷知此处，几番直造不通名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26070,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扈从回京舟中渡江而作","author":"王绂","text":"千里楼船江上还，狂歌醉舞浪花间。\n今宵对酒莫辞饮，明日到京无此閒。\n落日寒潮扬子渡，澹烟衰草秣陵山。\n壮怀不必悲前古，共整鸣珂候晓班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26071,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑尚书致仕","author":"王绂","text":"曳履南宫雪满簪，尊荣重沐圣恩深。\n名成早遂还山计，身退犹存恋阙心。\n车马都门争祖饯，盘餐邻曲共追寻。\n知君孝义传家久，子弟那能惜赐金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26072,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵元日早朝和邹先生","author":"王绂","text":"珊珊珂佩共趋朝，綵仗森严拥戟旄。\n仙乐奏随方物表，天香飘及近臣袍。\n风微玉陛春光早，露湿金茎日影高。\n班退又闻催入宴，宫花簪帽醉葡萄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26073,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和苏检讨先生除夕前一日斋宿翰林","author":"王绂","text":"腊尽重城暮雪残，词垣斋直坐更阑。\n金莲光灿青绫夜，宝鼎香飘玉署寒。\n阿阁喜同威凤宿，明堂遥睹衮龙盘。\n此身幸际升平日，三策何须献治安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26074,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠潘晦初","author":"王绂","text":"都门一笑喜相逢，典却春衣酒肆中。\n且放襟怀同啸傲，莫将眉宇论穷通。\n卧龙蛰后今安在，良马群中久已空。\n老眼到今无著处，醉来江上目飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26075,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈指挥赴甘肃","author":"王绂","text":"家声曲逆传来久，计略尤能每出奇。\n宠命近闻升上将，兵威应见振边陲。\n屯开潴野千营列，猎过祈连万马驰。\n圣代岂惟修武备，要将恩信伏诸夷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26076,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题杏花春色卷","author":"王绂","text":"年来芳杏种成蹊，结得数椽茆屋低。\n草色阶除看虎卧，花明帘幕听莺啼。\n晓天白映梢头月，雨径红粘屐齿泥。\n自是董仙风致在，渔郎休道武陵溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26077,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓发通州望京阙作","author":"王绂","text":"小雨初晴晓雪开，五云深处见楼台。\n山连辽海金城固，春满关河玉辇回。\n星汉共瞻天渐近，衣冠重整客初来。\n欲凭子墨誇雄览，愧乏扬雄献赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26078,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别南京","author":"王绂","text":"紫禁钟残万马奔，晓随仙仗出都门。\n送行不尽亲朋意，扈从深蒙圣主恩。\n日出海霞红散綵，雨添江水绿生浑。\n凭高回首瞻钟阜，王气龙蛇势独尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26079,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"到北京","author":"王绂","text":"才别南京又北京，客途浑是月馀程。\n舟车不觉经行远，冠佩重叨扈从荣。\n广陌遍嘶初到马，上林时听旧啼莺。\n解装且醉都门酒，自庆馀生际盛明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26080,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾侍讲禁中闻莺韵","author":"王绂","text":"绿阴疏雨澹朝霞，紫禁啼莺竞物华。\n声度箫韶偏宛转，地临霄汉绝喧哗。\n才穿琐闼千条柳，又隔薇垣万树花。\n佳唱寄来难即和，只愁贻笑大方家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26081,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和邹侍讲雨后夜坐喜凉有作","author":"王绂","text":"一雨浑无六月炎，御沟流水晚来添。\n近居直院新开第，初试凉衫旧赐缣。\n古鼎香飘风满席，疏帘光射月当檐。\n夜深不觉吟哦久，诗法输君律最严。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26082,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再和前韵","author":"王绂","text":"雨馀琼署不知炎，此夕多君逸兴添。\n灯下展书横一榻，酒边濡翰扫千缣。\n月惊栖鸟争喧树，风约流萤直到檐。\n我欲披襟同露坐，休将礼法待人严。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26083,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三次前韵","author":"王绂","text":"天近都城暑不炎，晚来凉气雨馀添。\n楼台何处秋横笛，机杼邻家夜织缣。\n吟对篆烟凭曲几，卧看银汉傍虚檐。\n翻思褦襶江南日，冠服何繇得整严。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26084,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬朱逢吉先生见寄韵","author":"王绂","text":"圣主銮舆事北巡，山川皆被宠光新。\n荣当扈跸叨清职，忝预丝纶愧昔人。\n丰采未瞻闻誉久，缄题先寄见情真。\n近知松桂凌寒好，毕竟均沾雨露春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26085,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾侍讲题新建秘阁韵 其一","author":"王绂","text":"帝城东望势岧峣，阿阁新成逼九霄。\n玉署近临青琐闼，粉垣新映赤阑桥。\n夜窗灯火明莲炬，春暖笙歌识凤韶。\n谁似相如才独赡，赋成犹觉气飘飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26086,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾侍讲题新建秘阁韵 其二","author":"王绂","text":"新成秘阁耸岧峣，碧瓦朱甍映紫霄。\n翠柳夹栽香辇路，玉栏斜转御沟桥。\n丝纶绚烂文成锦，歌颂铿锵韵协韶。\n定有青藜来照夜，虹光高逐五云飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26087,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题华节妇卷","author":"王绂","text":"偕老曾将百岁期，一朝凶变竟何为。\n微躯只合从夫死，大节宁堪使婢知。\n镜掩青鸾藏钿匣，缳垂白练系雕楣。\n于今同穴埋双柩，连理应生墓上枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26088,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽计生岳胤","author":"王绂","text":"若翁已失平生望，对客无言泪满袪。\n遗墨尚存新著藁，小斋空积旧藏书。\n楼成作记应难测，地下修文恐不虚。\n自古多才偏夭折，茫茫造物竟何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26089,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽张真人","author":"王绂","text":"忆昔瑶京相见日，许同仙籍注清班。\n遽闻驭气游无极，不复焚香授大还。\n笙鹤逍遥三岛上，楼台缥缈九霄间。\n世人空自藏遗翰，邈矣高风不可攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26090,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和祭酒胡先生题种菊韵","author":"王绂","text":"佳菊移从何处来，鬓丝相对共毰毸。\n閒情未得篱边种，老眼长看客里开。\n花吐清香飘满径，根培宿土砌成台。\n高风远慕陶彭泽，诗句应须著酒催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又次闻雁韵","author":"王绂","text":"灯残孤馆独醒醒，断雁那堪此际听。\n老去情怀浑似水，年来踪迹尚如萍。\n一天霜月飞何处，千里关山想宁馨。\n料得豪家无此况，酣歌清夜对娉婷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北京八咏 其一 居庸叠翠","author":"王绂","text":"峰峦叠叠树冥冥，黛翠浮光向日横。\n高耸青霄临北极，遥连紫塞到东瀛。\n路通绝域来番使，天设重关壮帝京。\n四海车书今混一，好磨崖石颂皇明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北京八咏 其二 玉泉垂虹","author":"王绂","text":"树杪潺湲落翠微，分明一道玉虹垂。\n天潢低映广寒殿，地脉潜通太液池。\n遥望直从云尽处，近听浑似雨来时。\n煮茶不让中泠水，陆羽多应未及知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北京八咏 其三 琼岛春云","author":"王绂","text":"蓬岛楼台金碧晖，春云郁郁更霏霏。\n曾为甘雨从龙去，又向朝阳逐凤飞。\n玉几炉烟同缥缈，彤垣花雾共依违。\n从来此地多佳气，五色文成绕禁闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北京八咏 其四 太液晴波","author":"王绂","text":"翠浪粼粼带碧烟，瑶台西畔玉楼前。\n九重地隔人间世，一片秋涵镜里天。\n星斗转时银汉近，芙蓉开处綵云连。\n此身已得随鹓鹭，共沐恩波祝万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北京八咏 其五 蓟门烟树","author":"王绂","text":"雉堞微明散曙霞，重重烟树万人家。\n轮蹄杂遝香尘暗，楼阁空濛酒旆斜。\n翠柳阴边栖宿雨，绛桃繁处绚晴霞。\n都人岁岁清明近，此地寻春竞物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]