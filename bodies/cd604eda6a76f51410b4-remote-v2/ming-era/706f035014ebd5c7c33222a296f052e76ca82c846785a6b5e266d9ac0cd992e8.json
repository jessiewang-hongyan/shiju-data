[{"title":"甲戌正旦朝贺","author":"韩殷","text":"金壶漏尽禁门开，白玉仙舆紫府来。\n双阙薄烟笼菡萏，九重春色近蓬莱。\n花迎剑佩星初落，日照金鸡仗欲回。\n早晚荐雄文似者，悬知独有子云才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元旦赐宴","author":"韩殷","text":"九重丹诏许逍遥，翠管银罂下九霄。\n阊阖迥临黄道正，御衣香散紫霞飘。\n但将酩酊酬佳节，未有涓埃答圣朝。\n矇瞍似知天意喜，玉台和月合箫韶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"廷试即事","author":"韩殷","text":"夹仗旌旗集羽毛，九重春色醉仙桃。\n天临奎壁星辰近，云捲珠帘剑佩高。\n丽日祥烟承罕跸，紫驼银瓮出葡萄。\n扬雄更有河东赋，敷奏明时岂惮劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"从蓬莱宫回庆阁之作","author":"韩殷","text":"五夜疏钟晓箭催，九成初日照蓬莱。\n为乘阳气行时令，更喜年芳入睿才。\n驯鸟不随天仗散，岩花应待御筵开。\n宸游对此欢无极，更取峰霞入酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庆成赐宴","author":"韩殷","text":"玉钥初开众乐攒，芙蓉阙下会千官。\n露分仙掌金茎冷，月射珠宫剑阙寒。\n万里梯航通鸟道，六州蕃落从戎鞍。\n歌钟满座争欢赏，长得君王带笑看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"册封亲王","author":"韩殷","text":"羲和揽辔六龙回，卤薄千官泊虎台。\n阊阖欲开宫漏尽，衮衣初动册函来。\n青编辉映尊前古，玉节从容引上台。\n欲吐妍词誇懿典，自怜终管马卿才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺平湖","author":"韩殷","text":"西河战罢万方清，处处楼台歌板声。\n白马锦鞯来騕袅，玉楼银榜枕岩城。\n风传漏刻星河曙，日照螭头剑戟明。\n从此泰阶平似水，肯教世路日兢兢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"呈一二知己","author":"韩殷","text":"鸾殿分阶翼彩毛，儒冠列侍映东曹。\n云移豹尾旌旂动，山拱龙门日月高。\n瑞气迥浮青玉案，日华摇动爵金袍。\n从宫羽骑多如雨，廊庙由来录旧劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"居官卧病","author":"韩殷","text":"远客悠悠任病身，江潭何处是通津。\n莫愁世事兼身事，却恐閒人是贵人。\n两岸芦花飞晓雪，一年生意属流尘。\n何时脱此尘中鞅，依旧红霞作近邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆归","author":"韩殷","text":"忆归休上粤王台，烧接黄云惨不开。\n晓露风灯易零落，红颜白发递相催。\n残方日落玄猿哭，古戍秋生画角哀。\n从此忧来非一事，寸心争奈不成灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"城楼晚眺适官军出征有感","author":"韩殷","text":"城上高楼接大荒，离人到此倍堪伤。\n阶前老马随秋草，篱外寒花带夕阳。\n南国羽书催部曲，汉宫题柱忆仙郎。\n可怜今夜千家里，离梦杳如闺梦长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"厌乱","author":"韩殷","text":"日日水流西复东，干戈短景去匆匆。\n一身避乱辞乡国，几处移家类转蓬。\n桂岭瘴来云似墨，海门潮上日初红。\n不知何日东瀛变，马足车轮处处通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己巳避寇将适羊城舟抵桂华兵阻未达用李嘉祐京口旅泊诗首句发引率成十首 其一","author":"韩殷","text":"移家避寇逐行舟，离思茫茫正值秋。\n银箭水残河势断，碧空云净火星流。\n机中锦字论长恨，江上青山忆旧游。\n自欲放怀犹未得，客情终日在眉头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己巳避寇将适羊城舟抵桂华兵阻未达用李嘉祐京口旅泊诗首句发引率成十首 其二","author":"韩殷","text":"移家避寇逐行舟，对泣风前类楚囚。\n总为浮云能蔽日，更无鹰隼与高秋。\n山牵别恨和愁断，树失河声绕郡流。\n日暮长堤更回首，云山漫漫使人愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己巳避寇将适羊城舟抵桂华兵阻未达用李嘉祐京口旅泊诗首句发引率成十首 其三","author":"韩殷","text":"移家避寇逐行舟，百感中来不自由。\n秦地故人成远梦，汉家宫阙动高秋。\n云拖雨脚连天去，水带离声入梦流。\n谁念为儒逢世难，寂寥灯下不胜愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"己巳避寇将适羊城舟抵桂华兵阻未达用李嘉祐京口旅泊诗首句发引率成十首 其四","author":"韩殷","text":"移家避寇逐行舟，野水无情处处流。\n人世几回伤往事，愁心一倍长离忧。\n山中夜度空江水，石室烟涵古桂秋。\n惆怅此时频送目，蓼花凄冷露花浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题 其一","author":"韩殷","text":"一自乡关动战锋，楚云沧海思无穷。\n那堪流落逢摇落，不是愁中即病中。\n白玉帐寒鸳梦绝，彩云天远凤楼空。\n此情可待成追忆，巫峡迢迢旧楚宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题 其二","author":"韩殷","text":"巫峡迢迢旧楚宫，灵犀一点若为通。\n几家砧杵秋烟外，一抹青山落照中。\n瑶草秋残仙圃外，缑山云冷凤台空。\n共君莫问当年事，来是空言去绝踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题 其三","author":"韩殷","text":"来是空言去绝踪，峡云无迹任西东。\n应知御史归天上，只在襄王忆梦中。\n立马望云秋塞净，分曹射覆腊灯红。\n须知此恨消难得，云想衣裳花想容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题 其四","author":"韩殷","text":"云想衣裳花想容，来时有迹去无踪。\n缑山碧树青楼月，蓬岛烟霞阆苑钟。\n沙径晓烟浮竹坞，酒家疏雨梦临邛。\n闺中只是空相忆，油壁香车不易逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题 其五","author":"韩殷","text":"油壁香车不易逢，路边戈甲正重重。\n五湖烟景盈归梦，半壁寒灯照病容。\n腊尽山中三尺雪，月斜楼上五更钟。\n无因得荐阳台梦，只有高唐十二峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感遇","author":"韩殷","text":"客舍并州已十霜，不知何处是他乡。\n夜闻猛雨知花尽，昼掩书斋觉日长。\n已托丝桐通密意，又将清瑟理霓裳。\n旧来好事今能记，去岁兹晨捧御床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋闱不遂","author":"韩殷","text":"落魄衿怀不自由，桂花影里沐清秋。\n虽无彩笔都成梦，未信朱衣不点头。\n李迪声华誇浪得，子云词赋倩谁收。\n珠江潭水深千尺，正是鱼龙变化秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南城访故旧居尽易新主有感而作","author":"韩殷","text":"绿杨红杏满城春，柳市南头访隐沦。\n人世几回伤往事，江淮何处不通津。\n青袍似草年年定，世事如棋局局新。\n浅薄将何称献纳，思量名利孰如身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长门怨","author":"韩殷","text":"自闭长门经几秋，泪珠时傍枕函流。\n多情却被无情恼，得宠忧时失宠忧。\n香辇不回花自发，仙娥终去月难留。\n晚来风起花如雪，空逐春泉出御沟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贫女吟","author":"韩殷","text":"东风吹柳日初长，沙苑年来草又芳。\n台榭不兴歌舞梦，蓬门未识绮罗香。\n休将世态悲尘事，但借流尘暗竹房。\n倚柱寻思倍惆怅，为谁清瘦减容光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村居即事","author":"韩殷","text":"绕门清槿绝尘埃，别馆春还草乱催。\n蚕事正忙农事急，桃花净尽菜花开。\n青青野竹题诗去，白白红鱼入馔来。\n四海一家无事日，愿将巴曲赞康哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏杜甫游属","author":"韩殷","text":"青山隐隐水迢迢，却算游程岁月遥。\n清海城头空有月，浔阳江上不通潮。\n窗含西岭千秋雪，家住东城万里桥。\n风景苍苍多少恨，月明云断更谁招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送乡人南还","author":"韩殷","text":"禁城春色晓苍苍，遥见飞尘入建章。\n白首相知犹按剑，青春作伴好还乡。\n万家废井生秋草，一片轻帆背夕阳。\n东道若逢相识问，故人今已赋长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送友人赴官滇南","author":"韩殷","text":"共把离觞向水边，忽看庭树换风烟。\n门前落叶浮秋水，池月枯杨噪晚蝉。\n桂岭瘴来云似墨，碧溪人去水如天。\n长沙不久留才子，应有声名达帝前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风","author":"韩殷","text":"飞廉情性独何奢，尽日飘飘遍海涯。\n肯与雷霆袪号令，惯随霄汉逐烟霞。\n渡江惊起千层浪，落圃吹残万树花。\n任是拂云栖凤竹，却教著处也横斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花","author":"韩殷","text":"二月晴和日正浓，千红万紫斗芳丛。\n晓沾雨露胭脂湿，晚带斜阳日影重。\n上苑移来香有异，洛阳卖去价无穷。\n琼林有分簪乌帽，插在金阶色转浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪","author":"韩殷","text":"岁转鸿钧腊已残，东风吹絮下天关。\n涨添吴楚千江水，压倒秦淮万里山。\n翠竹婆娑银凤舞，苍松辗转玉龙盘。\n不知天上谁横笛，吹落梅花满世间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月","author":"韩殷","text":"皎皎银河缺又圆，恍如明镜下云端。\n影沉湖海蛟龙战，光照山川虎豹寒。\n玉兔频移丹桂茂，姮娥无事广寒闲。\n何时共约扳仙桂，直上云梯万里看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意 其一","author":"韩殷","text":"望望青螺山，迢迢杳烟树。\n岁月忽已迈，寒飙夺霜纻。\n嗟我同心人，飘泊在何处。\n耿耿长相思，弱水难为渡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意 其二","author":"韩殷","text":"高高越王台，隐隐南山路。\n南山风雨多，青桂生幽蠹。\n北雁书不传，青鸟归何处。\n愿把相思心，种作相思树。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张文通","author":"韩殷","text":"五龙去后家学荒，惟君巧性分天章。\n才美不让谢阶玉，风情夐失莲花郎。\n我从蓬底倾心处，别后螺峰杳烟树。\n露草方惊昨夜春，莺花俄忆当年事。\n嗟君肥遁天之涯，东风未见来仙槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓兴","author":"韩殷","text":"画城二月春气和，晴光著树生绮罗。\n锦袍公子挟金弹，朱颜玉女抱青螺。\n云盖高出西城郭，踏青斗草黄陵阿。\n黄头青女一相见，两情摇动知如何。\n此时我亦正年少，戏将凡眼两摩挲。\n谁料红云忽飞下，月宫幻出金嫦娥。\n神骥苍龙并头角，珊瑚玉树交枝柯。\n一朝翻作巫阳别，吁嗟旧约其蹉跎。\n张珙无心见明月，牛郎有梦归银河。\n古往今来只如此，为君翻作多情歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅轩为张五秀才赋","author":"韩殷","text":"温塘溪水清涟涟，数椽旧筑温塘边。\n罗浮仙子尚清适，月中飞佩来翩翩。\n东阁诗呈久已矣，西湖少微今不起。\n神交独有温塘君，冰雪襟期许同美。\n东风一朝天际来，翠禽梦断春徘徊。\n须臾万玉有凋落，骊珠千颗光胚胎。\n黄鸟阴中春万顷，一枝缥缈悬清影。\n倾筐有恨不须歌，从此调羹入商鼎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松溪为东莞袁二处士赋","author":"韩殷","text":"温塘溪上多青山，隐君种松溪云间。\n蛰龙老去不复化，铮铮鳞甲号秋寒。\n下有茯苓二千石，上有菟丝三百尺。\n夜深玄鹤忽飞来，摇弄春光荡空碧。\n花兮可采泉可烹，隐君托迹相忘形。\n客来醉我徂徕酿，还俯沧浪歌濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张大参宋器迁浙江方伯","author":"韩殷","text":"纶音天外至，蹇蹇识孤臣。\n旆指三衢道，恩遗五岭民。\n两藩通雨露，一鹗出风尘。\n勋业须铭鼎，何劳看镜频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈梦祥进士奉使还家","author":"韩殷","text":"春风初上第，便作昼游归。\n别路嗟司马，青云识陆机。\n滩声归海尽，雁影渡江稀。\n南入梅关路，便应开彩衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别徐子明奉使闽浙","author":"韩殷","text":"别酒不停斟，骊驹忽在道。\n送君千里行，踯躅伤怀抱。\n芃芃少女桑，凄凄王孙草。\n君行何日归，对此令人老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送诏弟还乡","author":"韩殷","text":"自君龆龀日，书剑远相从。\n故国十千里，关山一万重。\n蹉跎嗟往事，牢落笑前踪。\n又抱还家梦，云霄几日逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠金万户抵京袭职","author":"韩殷","text":"青春公子气横秋，十五辞家赋壮游。\n云里蓬莱朝魏阙，月中笳鼓梦梁州。\n豹韬早遂承家计，龙剑长怀报国忧。\n炎海只今烽火息，好销金甲事春畴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚发胥江","author":"韩殷","text":"万家烟树隐云幢，桃叶波平夜渡江。\n野艇无人时泛泛，海鸥骄客故双双。\n春愁不发王孙草，归梦徒依玉女窗。\n欲濯沧浪歌一曲，九回肠断不成腔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过飞来寺","author":"韩殷","text":"万朵芙蓉叠翠微，上方迥与世尘违。\n青衣久矣为猿去，白足何年化鹤归。\n山雨逗林飞鸟警，海云低树暮帆稀。\n诸天见说深千尺，乘兴何时振羽衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送袁秉信南归","author":"韩殷","text":"一鹗淩秋振羽仪，探春谁遣故来迟。\n莫怜司马空归日，犹胜刘蕡未遇时。\n远水风烟行处梦，故园花竹别来思。\n凭君莫起陵阳怨，售价连城会有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐子明之官南京刑部","author":"韩殷","text":"玉街春霭晓苍苍，剑佩承恩出建章。\n贾谊无劳怀汉室，子云今已赋长杨。\n白云官署多秋色，折柳空亭半夕阳。\n此去会须专美绩，肯容六月重飞霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送界河梁驿宰父南还","author":"韩殷","text":"东风吹雪柳花飞，江水流澌去路微。\n客枕倦听官驿雨，乡心还忆故山薇。\n红亭绿酒开春宴，银烛金盘映彩衣。\n明发扁舟千里外，阿戎何处望庭帏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南陂行乐图","author":"韩殷","text":"浣花溪上杜陵庄，老去潜夫逸兴长。\n蜡屐行春分野色，篮舆携酒醉湖光。\n窗涵渤澥潮声近，室引薰风暑气凉。\n笑我早缨轩冕累，膏车未许共徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得琼岛春云送戴廷礼还乡","author":"韩殷","text":"仙峰削出玉璘珣，阆苑红云片片新。\n晴带轻烟迎彩仗，暖浮苍蔼护朱轮。\n望中误起河阳恨，梦里还疑楚水春。\n最是六街过雨后，独留青影送行人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上元日感怀寄康文瑞御史","author":"韩殷","text":"京华旅食老风烟，佳节重惊一惘然。\n渠柳尚怜含雪重，宫花先报得春偏。\n酒沽绿市难为醉，诗动新愁不易编。\n惟有蓬莱宫里月，照人清影自年年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偷春词 其一","author":"韩殷","text":"江上年年春草，酒楼处处笙簧。\n春衫绣罗香薄，应有待月西厢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偷春词 其二","author":"韩殷","text":"莲炬重芳人海，画堂好是风光。\n不知今夕何夕，秦镜偷照寒香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自君之出矣","author":"韩殷","text":"自君之出矣，寒尽岁还来。\n妾心如铁石，争向被春催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和叶都堂凯歌 其一","author":"韩殷","text":"衮衣衔命下夷荒，百粤均分日月光。\n神剑昼横江水黑，龙旗春掣海云黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和叶都堂凯歌 其二","author":"韩殷","text":"老将临征识阵云，迅驱虎旅净妖氛。\n腥风吹冷黄金甲，曀日黄翻赤帜文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读剪春灯馀话代田洙和薛涛四时回文词韵春","author":"韩殷","text":"花枝满院朝啼鸟，柳线垂阶晚摆风。\n霞映夕阳斜拂树，雨添春水细滋松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏","author":"韩殷","text":"凉生绿竹温风软，暑涤清流夜气寒。\n香坠荔枝红簇簇，影欺荷盖翠团团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋","author":"韩殷","text":"芦外水声秋瑟瑟，树前山色晓苍苍。\n孤舟一夜惊心客，惨惨长愁独望乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬","author":"韩殷","text":"天连水也云连野，月满关兮雪满城。\n鲜火爇灯红泼泼，疾风飘鬓冷清清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"婕妤怨","author":"江源","text":"甘随团扇弃，无复贯鱼同。\n闻道阳阿燕，君王筑避风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"相逢行","author":"江源","text":"君非秋胡子，妾非采桑妇。\n莫捐囊中金，白头倚门久。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋何曲","author":"江源","text":"廿载嫁萧郎，三年远何娘。\n欲归归未得，秋水没河梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桑中曲","author":"江源","text":"五马骤从东，桑中无路通。\n使君休调笑，君妇恐如侬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":51926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]