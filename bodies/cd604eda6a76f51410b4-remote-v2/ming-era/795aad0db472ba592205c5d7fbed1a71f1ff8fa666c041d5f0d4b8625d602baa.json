[{"title":"游玄福宫","author":"边贡","text":"福地盘青甸，香台倚绀云。\n材分龙藏宝，功就羽林军。\n洞客脩丹箓，山灵护敕文。\n愿资玄教力，千载翊明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17414,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泰陵供事述感五章 其一","author":"边贡","text":"陵墓三年道，重来七月期。\n山河不改色，霜露只增悲。\n世想钦明德，人传顾命辞。\n九龄如帝与，端可致雍熙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17415,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泰陵供事述感五章 其二","author":"边贡","text":"㳟已班虞舜，求贤越武丁。\n心犹在边徼，梦已隔泉扃。\n永作千秋别，虚传七日醒。\n夕庐斋沐所，彷佛见遗形。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17416,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泰陵供事述感五章 其三","author":"边贡","text":"象设徒虚傋，龙游竟不还。\n勋华留率土，精爽寄空山。\n石锢金泉黝，云栖碧殿閒。\n寝园如种竹，应有泪成斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17417,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泰陵供事述感五章 其四","author":"边贡","text":"皇寝居庸近，山深地转饶。\n雄关三镇锁，幽府百灵朝。\n堡堠烽全息，屯兵甲半销。\n帝心遥可识，终古绝天骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17418,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泰陵供事述感五章 其五","author":"边贡","text":"午夜祠钟发，千官集广墟。\n遂看除禫服，那复见宸裾。\n长隧通玄壤，明楼瞰紫虚。\n松阡回望里，风雨泣涟如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17419,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"下陵二首 其一","author":"边贡","text":"露行踰十里，夜黑四岩阴。\n不辨云霞色，惟闻钟磬音。\n堑鸦翻列火，山鬼啸空林。\n欲下西陵路，前沟水正深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17420,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"下陵二首 其二","author":"边贡","text":"窈窈山径僻，喧喧徒御归。\n马逢危石住，灯入古林稀。\n树密全妨盖，云寒半湿衣。\n红门知不远，秋角听依微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17421,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望孝宗陵","author":"边贡","text":"泰陵今在目，突起茂阡西。\n宫殿青霄迥，松杉白日凄。\n坤墟符帝宅，山寿与天齐。\n黍稷明年祀，重来路不迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17422,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"郊坛夜步","author":"边贡","text":"晚步凌高榭，春空月正明。\n星辰临汉畤，楼观俯秦京。\n静夜松飙响，丰年谷日晴。\n同心隔城市，相望转盈盈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17423,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"候驾","author":"边贡","text":"遥闻葆吹声，仙仗下通明。\n地转苍龙道，天临白玉京。\n瑞光同远近，云物半阴晴。\n隐隐行宫启，重关虎豹盈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17424,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"上陵","author":"边贡","text":"卧病长夏晚，出门秋草生。\n聊因上陵日，一寄看山情。\n野水侵平道，寒云覆古城。\n圣君方用武，群盗敢纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17425,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五月七日陪李刘二侍御游宴尹亭","author":"边贡","text":"不到北湖久，重来莲叶青。\n水香还落照，山色自孤亭。\n竹隐尚书榻，窗悬柱史星。\n回舟忽已晚，波上月冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17426,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九月望日同大阳有台二使君泛湖出郭二首 其一","author":"边贡","text":"野眺邻幽旷，移舟出水关。\n上卿双盖迥，渔父一蓑閒。\n坠叶纷飘座，回汀曲抱山。\n芳尊对摇落，不醉可须还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17427,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九月望日同大阳有台二使君泛湖出郭二首 其二","author":"边贡","text":"候火射波光，中流见女墙。\n观楼增突兀，云月递微茫。\n岸接青山近，舟搴绿芷香。\n兴酣忘夜久，歌吹绕林塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17428,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"村舍","author":"边贡","text":"村舍孤烟起，山中朝雨寒。\n丁夫荷锄去，稚子出门看。\n早稼登场圃，秋瓜蔓井阑。\n居然羡閒逸，趋府欲辞官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17429,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山行","author":"边贡","text":"两山开一径，杳杳入云烟。\n仄磴樵人下，危峰野衲禅。\n断鸿愁返照，归马识斜川。\n井邑干戈后，凋零异昔年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17430,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"御帐坪次王伯安韵","author":"边贡","text":"白日天门近，青山御帐空。\n亭虚从眺览，树古自登封。\n过鸟层云上，鸣泉万壑中。\n翠华春不返，惆怅昔人踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17431,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题清乐亭","author":"边贡","text":"老木隐江亭，幽居对锦城。\n榻悬西岭雪，墙度浣溪莺。\n地僻人稀到，心閒梦亦清。\n穷通身外事，何必问君平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17432,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重阳后三日登雨花台","author":"边贡","text":"一片金陵月，荒台对酒看。\n水云霏冉冉，江日隐团团。\n雁早那堪听，花迟未可餐。\n凭轩望乡国，西北近长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17433,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与平厓林豸史泛湖北抵华不注山夜从陆归二首 其一","author":"边贡","text":"浮舟出近郭，落日半溪阴。\n水阔蒹葭净，山寒烟雾深。\n壶觞不尽兴，丝竹有馀音。\n独恨黄花少，犹烦隔浦寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17434,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与平厓林豸史泛湖北抵华不注山夜从陆归二首 其二","author":"边贡","text":"黄昏过别业，却见旧山僧。\n客驾聊云息，乡愁转更增。\n水光浮夜月，林影散秋灯。\n隔苑闻寒犬，高轩醉懒乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17435,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"后三日登龙洞山二首 其一","author":"边贡","text":"海峤烟霞满，登临爱积阴。\n绿苔穿岭滑，黄叶缀岩深。\n宛宛鹿麋径，泠泠泉涧音。\n高人或住此，精舍杳难寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17436,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"后三日登龙洞山二首 其二","author":"边贡","text":"寺古犹存佛，山深少见僧。\n迟徊意不极，去住感偏增。\n树隐青林店，龛明白石灯。\n峭峰吾欲上，未有鹤堪乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17437,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宋驸马园亭访东石谈子遇雨","author":"边贡","text":"却访故人处，遥来公主园。\n湿云蒸锦树，鸣雨过华轩。\n槛近浮鸥接，庭深乳雀喧。\n将求卜居意，相对已忘言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17438,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠周文都","author":"边贡","text":"君乘别驾车，南征千里馀。\n予为燕市客，岁杪意何如。\n日隐川原暮，江涵云水虚。\n新春见回雁，知有秣陵书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17439,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄华山人","author":"边贡","text":"山人归薜萝，迢递两年过。\n道远情无那，秋来兴若何。\n隰霜收早稻，江日曝寒蓑。\n不见云中鹄，空传招隐歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17440,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠何子元二首 其一","author":"边贡","text":"饮马长城窟，西风陇水鸣。\n旌旗连朔气，笳吹咽边声。\n鹿塞秋霜白，龙沙汉月明。\n共嗟班定远，身是一书生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17441,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠何子元二首 其二","author":"边贡","text":"万里穷边使，三秋出井陉。\n金鞍装宝络，斑管代青萍。\n吏识终军貌，人瞻博望星。\n归来市骏马，持节报明廷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17442,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"行子","author":"边贡","text":"行子到京舍，故人消息传。\n钓鱼吹台下，筑室黄河边。\n插架馀千帙，倾囊有一钱。\n古来贤达者，往往在林泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17443,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"彦卿垂示省署述怀之作次韵奉荅 其一","author":"边贡","text":"寂寂荒园午，庭虚不下帘。\n墨池经雨润，厨火隔宵熸。\n壁溜侵湘簟，窗风动越缣。\n灌花亲汲水，童子睡初甜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17444,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"彦卿垂示省署述怀之作次韵奉荅 其二","author":"边贡","text":"官閒仍地僻，宾从少经过。\n睡起看山立，诗成对竹哦。\n小塘云影乱，深树鸟声多。\n坐数秋期近，双星欲渡河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17445,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过双泉寺马文明别业怀寄","author":"边贡","text":"却过双泉寺，因怀马舍人。\n托交空有日，为别动经旬。\n古泽蓼花乱，高原禾黍新。\n秋风吹独马，望尔一伤神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17446,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山中怀白岩二首 其一","author":"边贡","text":"珂马长安道，趋陪几见秋。\n那知迁转地，翻动别离愁。\n光禄诗名远，容台礼数优。\n空山中夕梦，长绕凤凰楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17447,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山中怀白岩二首 其二","author":"边贡","text":"昔奉山陵使，曾同虞殡吟。\n鳌翻沧海变，龙去鼎湖深。\n紫极瞻云地，清霄望月心。\n苍苍松柏里，怀往益沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17448,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀昌谷大理二首 其一","author":"边贡","text":"孺子南州彦，词华早擅场。\n共怜廷尉府，秪益簿书忙。\n宝縼愁鹦鹉，盐车困骕骦。\n何时一艇去，与尔泛沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17449,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀昌谷大理二首 其二","author":"边贡","text":"斋房隐薜萝，野外少人过。\n向月复谁语，看山空自歌。\n城孤戍火乱，地迥北风多。\n惆怅离居夕，相思奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17450,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"白岩将赴北山供祀奉呈","author":"边贡","text":"赋客贪岩壑，登临思渺然。\n出城看落日，驱马入秋烟。\n藓缀陵门棨，蘋香寝庙笾。\n别来曾见说，重补华山篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17451,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"张侍御过访不值谢荅","author":"边贡","text":"有客骑骢马，徘徊恋友生。\n虚烦过茅屋，实已隔山城。\n野僻蓬蒿满，园荒蟋蟀鸣。\n空村中夕梦，相忆倍含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17452,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪后尹亭小集有怀张侍御仲齐","author":"边贡","text":"樽酒故相约，燕游翻不同。\n亭深寒雪在，桥断夕烟通。\n白日行歌里，青山别恨中。\n夜阑车马寂，愁听竹林风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17453,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"尹亭夜集 其一","author":"边贡","text":"忆共尚书饮，兰舟漾渚风。\n芙蓉开月下，箫管入云中。\n鹤唳烟沙远，萤流水閤通。\n重来值摇落，无复往时同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17454,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"尹亭夜集 其二","author":"边贡","text":"晃晃水上月，棱棱沙际风。\n寒星动木杪，远火露烟中。\n城郭千峰对，园林一水通。\n兴移还野酌，留赏夜深同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17455,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"将赴灵岩午憩黄山店示同游诸子","author":"边贡","text":"感时愁不极，出野兴仍高。\n墟野当红药，园林过碧桃。\n水行沙路软，云卧石床牢。\n更喜山翁朴，忘形对尔曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17456,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出黄山村遇霍子闻郡守章柳庵将至灵岩喜而有作","author":"边贡","text":"路转黄山店，人逢霍茂才。\n传呼寺僧出，五马欲东来。\n野水村村响，岩芳树树开。\n浪游双屐齿，沾湿破苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17457,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"由张夏村赴靳庄望同游诸子","author":"边贡","text":"落日过张夏，黄昏投靳庄。\n岭牛将犊下，沙鹤避人翔。\n石径盘青霭，柴门闭绿杨。\n同游忽不见，孤眺转苍茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17458,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"靳庄山馆即事次张侍御仲齐韵","author":"边贡","text":"野馆千峰对，登临日载阳。\n山川气纡郁，天地色凄凉。\n未卜三秋稼，先传二月蝗。\n古村兵燹后，摇落见空墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17459,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出靳村望灵岩寺","author":"边贡","text":"福地灵山表，来游春已深。\n情知百里道，虚抱十年心。\n野树犹含色，鸣禽欲变音。\n花宫瞻望处，烟雾绕青岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17460,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"迟贤亭有怀白泉王子诏盖与余同游泰山而余先王子归也","author":"边贡","text":"树杪游云白，风前落絮轻。\n行蜗上壁篆，斗雀堕檐楹。\n客驾聊言息，仙踪不可明。\n怀人望东麓，逦逦曙烟横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17461,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日卧病寄刘子希尹王子孟宣 其一","author":"边贡","text":"我济富山水，人称名士乡。\n两生俱俊杰，吾道岂荒凉。\n紫禁烟花地，青云翰墨场。\n应须得高步，书札报沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17462,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日卧病寄刘子希尹王子孟宣 其二","author":"边贡","text":"老病东山客，青春意䬃然。\n祗因愁不去，翻与醉相牵。\n草檄怀公干，登楼忆仲宣。\n几时莲叶里，重放北湖船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17463,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"段村候成之佥宪","author":"边贡","text":"客子复迎客，黄昏行古林。\n短墙登吠犬，列火动栖禽。\n对雪三年梦，维舟半夜心。\n他时重相见，佳话比山阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17464,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬河内使粹夫","author":"边贡","text":"忆尔曾金马，予官亦?闱。\n惊风一以振，落羽遂分飞。\n东郡身仍屈，西河信每稀。\n传经与抗疏，心事两相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17465,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"移榻","author":"边贡","text":"卧榻便幽赏，虚廊接瞑移。\n树云低绕栋，阶雨下通池。\n病间琴相得，心劳砚独知。\n商歌激流楚，惆怅北山期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17466,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠萧医士","author":"边贡","text":"览镜叹华发，出门乡路遥。\n客装侵暮雨，归楫渡春潮。\n草绿河阴细，莺啼苑外娇。\n荷锄行采药，还似赤城樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17467,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠方山郑子二首 其一","author":"边贡","text":"江东有狂士，结屋本深山。\n为客风尘外，驰声梁楚间。\n才聆扪虱语，忽作钓鳌还。\n予亦悠悠者，相逢愧尔閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17468,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠方山郑子二首 其二","author":"边贡","text":"好酒耻儒素，谈兵靖塞尘。\n深怜宋中客，宛似晋时人。\n到处不谐俗，一生长任真。\n因君感交态，多少白头新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17469,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠伍文定太守移吉安","author":"边贡","text":"巩洛移官日，荆襄过里年。\n郡符分旧虎，江树听新蝉。\n河内人虚借，关东政久传。\n行经五柳宅，一为吊先贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17470,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元旦","author":"边贡","text":"上日冥冥雨，中宵且未休。\n薄游双剑在，羁宦一身留。\n养鹤怜初志，屠龙悔壮谋。\n著书聊假日，元不坐穷愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17471,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄无锡管尹","author":"边贡","text":"吾爱管明府，理民如昔贤。\n静看申浦月，清饮慧山泉。\n惠化表三异，和声流五弦。\n春风阻携手，相忆思悠然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17472,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荅松月伍中丞见寄","author":"边贡","text":"开閤俯江城，怀人独系情。\n碧云空旧色，黄鸟又新声。\n剑在终相合，舟閒且自横。\n凤凰台上月，孤负一春晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17473,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟泊清江有怀交游诸公二首 其一","author":"边贡","text":"未暖金陵席，还趋玉陛行。\n汉仪欣再睹，虞秩愧惟清。\n雨雪江南曲，关山岁暮程。\n临分约归候，春服早须成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17474,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟泊清江有怀交游诸公二首 其二","author":"边贡","text":"日射江流紫，烟沙冻欲开。\n臈从梅蕊破，春傍雪涛回。\n北斗瞻星入，东风应律催。\n鹓鸾隔朝省，不共上元杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17475,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬朱柱史子宜","author":"边贡","text":"有美中台彦，闻名自国都。\n岂知多难日，识面在江湖。\n地入王畿远，星分客棹孤。\n霜威倘可借，一为保前途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17476,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"斋居同月岩夜坐","author":"边贡","text":"寂寂槐厅晚，端居感岁时。\n雪消山色在，寒退井痕知。\n白战怀苏老，清斋伴子期。\n坐来情转逸，华月照方池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17477,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贺承庵侍史省亲还绩溪","author":"边贡","text":"上疏天门北，驱车海峤东。\n去留真自得，心迹许谁同。\n诗入杜陵室，官追桓典风。\n寿筵家庆好，花对白头翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17478,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汶上寄王工部舜夫二首 其一","author":"边贡","text":"真拟湖边会，言从汶上过。\n岁时鸣鸟变，岐路转蓬多。\n树色连东岳，川流汇北河。\n相思阻欢觏，瞻望恨如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17479,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汶上寄王工部舜夫二首 其二","author":"边贡","text":"幸不逢颜色，真愁吐肺肝。\n祗因哭子瘦，岂是别家难。\n雨麦虚看秀，风梅实抱酸。\n病怀兼逆旅，谁与一盘桓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17480,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄陈石峰中丞","author":"边贡","text":"一别梁园雨，五看秋草疏。\n君为乌府客，我向白门居。\n发短风尘里，心长老病馀。\n江流日东下，何处觅双鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17481,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出郭将访希准郡伯惧暮而返却寄","author":"边贡","text":"驾言江口出，却至水西还。\n远道空回首，重门欲上关。\n断云低白雁，斜日近青山。\n欲采瑶华赠，仙舟不可攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17482,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]