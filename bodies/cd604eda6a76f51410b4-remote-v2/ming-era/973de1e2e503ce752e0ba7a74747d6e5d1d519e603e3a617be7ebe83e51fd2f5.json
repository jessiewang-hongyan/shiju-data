[{"title":"召赴京师别豫章 其二","author":"汪广洋","text":"五年三复被纶音，倚注唯专感激深。\n充国岂疏屯塞策，马周终许报君心。\n风云际会成今古，日月昭融实鉴临。\n历历楚山遥在目，壮歌明发大江浔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠刘秀才归理乡校","author":"汪广洋","text":"江浦风高木落稀，江天云阔雁飞迟。\n正怜张翰思归日，况值文翁领校时。\n左蠡庙前山隐隐，宜春台口柳依依。\n经行得意多题咏，莫惜鸾笺寄凤池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赵待制致仕还会稽","author":"汪广洋","text":"新开湖水水如云，三十年前忆见君。\n京国相逢增感旧，辟雍长得细论文。\n白头喜遂林泉约，紫诰钦承雨露恩。\n遥想到家寻贺老，泊船来去棹晴曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宋景濂承旨致仕还金华 其一","author":"汪广洋","text":"力操铅椠代櫜鞬，赞翊无如子独贤。\n璧水屡游来后学，瀛洲高步领群仙。\n乞归际遇明良日，近侍从容二十年。\n况有儿孙能继武，凤凰池上羽毛鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宋景濂承旨致仕还金华 其二","author":"汪广洋","text":"巾车久不到潜溪，溪上筼筜个个齐。\n玉检金封劳纪述，石田茅屋称幽栖。\n贺公共喜荣归老，疏傅谁言早见几。\n此去东南形胜处，知君一一有新题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钱博士致仕还会稽赠别兼柬赵待制","author":"汪广洋","text":"翰林待制近辞老，国学博士今旋归。\n二贤出处不易得，一代文章属有为。\n祖席都门罗饯礼，大镛东序足生辉。\n若耶溪上春如海，诗笔还当对客挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题宋徽宗寒江归棹图","author":"汪广洋","text":"怪石奇花拥汴都，上皇行乐在蓬壶。\n不将深虑防侵侮，却把閒情托画图。\n野艇风高晴雪重，江天水阔暮云孤。\n断鸿一去无消息，啼杀延秋头白乌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韩国公曹国公暨中山侯等官奉旨诣岳镇海渎行报祀礼早朝赋诗呈别","author":"汪广洋","text":"天仗初齐曙色分，笋班玉立候金门。\n国家报祀循常典，海岳储祥表厚坤。\n龙篆重缄云外去，凤韶九奏月中闻。\n此行端为通幽显，倚注唯应属老臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南残腊遣怀","author":"汪广洋","text":"一麾长忆出南京，万里车书载笔行。\n驿路通关疑陇蜀，人家濒海似蓬瀛。\n三冬地暖花争发，半夜鸡鸣潮又生。\n公馆莫言岑寂甚，草虫啾唧到天明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题清远峡飞来寺","author":"汪广洋","text":"峡里金银佛寺开，老僧传是昔飞来。\n菩提子落云间石，薝卜香飘月下台。\n江涌灵源通海峤，山横古翠接蓬莱。\n愿询往事观碑刻，閒向松阴扫绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次横石赠同行崔检校陈宜武","author":"汪广洋","text":"岭外将军如虎貔，插旌挝鼓锦征衣。\n夕阳在船客未醉，春水满江鱼自肥。\n归路远趋丹阙召，寸心长逐白云飞。\n笑歌历览思何惬，两岸鸟鸣深翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赴召留题英德驿","author":"汪广洋","text":"英德县前多好山，山峰拥翠出云间。\n人家星散盗贼少，官舍日长文字閒。\n江水舂容涵夕景，岸花红白带春殷。\n愧无宋璟匡时策，也自交州奉召还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再过曲江九成台有感","author":"汪广洋","text":"闻说重华巡狩日，六龙遥驻九成台。\n山川高下难为险，风气淳庞自此开。\n渺渺苍梧云在望，嗈嗈丹穴凤曾来。\n令人不尽怀思处，一道澄江碧似苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨澜阻风夜坐","author":"汪广洋","text":"北风吹浪阻归舟，偶为杨澜数日留。\n几席清寒生薄暮，江湖长夏即深秋。\n天低星斗光芒出，月暗鱼龙自在游。\n坐待平明攀曲磴，远从匡阜望神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答西域班右丞诗韵应制","author":"汪广洋","text":"闻君远在氐羌北，露宿风餐志不磨。\n老去岂忘思故里，悲来惟复动高歌。\n三冬沙碛层冰烈，六月天山积雪多。\n对此何为甘寂寞，圣明人物正蒐罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答右大夫陈静斋诗韵","author":"汪广洋","text":"夔龙接武会风云，珍重麒麟阁上人。\n径国正期行素志，读书端不事虚文。\n交游有道陈雷在，公论无私贾董存。\n预拟暮年寻旧约，草堂下近浣花村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题日本画扇应制 其一","author":"汪广洋","text":"戎装两两控骅骝，沙濑风高碧海头。\n画裤轻衣驰白日，雕弓长箭射清秋。\n军容炫耀争先出，地势萦回取次游。\n保守固知宜讲武，当思安集在和柔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题日本画扇应制 其二","author":"汪广洋","text":"驺从如云列满涂，囊盛櫜载走諠呼。\n信知岛屿多殷富，故拟丹青入画图。\n海底珊瑚光耀出，松根琥珀等閒无。\n缅怀楚国何为宝，珍重遗编作范模。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"銮舆春日幸钟山寺","author":"汪广洋","text":"道林灵刹拥祥光，法驾来临日载阳。\n五色云中环雾旆，万年枝上发天香。\n风传鸣鸟笙竽合，石荫垂萝紫翠凉。\n拟对明时歌胜事，愧无词赋续班杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题钟山胜景应制","author":"汪广洋","text":"北山佳气郁葱葱，高处深藏七佛宫。\n松下鹇眠无客到，洞中龙出有云从。\n茶煎紫笋逢支遁，药炼丹砂羡葛洪。\n更欲蹑凫凌绝巘，扶摇大块鼓雄风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋写怀兼柬诸省幕再用过字韵 其一","author":"汪广洋","text":"烂醉新丰市上过，马周岂意有常何。\n中朝自古徵求重，诸老於今际遇多。\n病起风流殊不减，诗成须鬓定应皤。\n东南馈饷蒙恩赐，强欲行闻击壤歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋写怀兼柬诸省幕再用过字韵 其二","author":"汪广洋","text":"玉门关外笑谈过，百战宁论万里何。\n定远收功谁得似，楼兰遗类苦无多。\n赋诗己慰三年别，览镜曾闻一夕皤。\n传道两阶千载舞，岂应专羡大风歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"关中怀古 其一","author":"汪广洋","text":"驻车丰邑镐池东，想像周家帝业隆。\n紫凤碧梧栖正稳，朱弦清庙奏何工。\n分藩终拟蛮畿服，治象初悬魏阙崇。\n习俗更闻勤稼穑，只今谁不颂豳风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"关中怀古 其二","author":"汪广洋","text":"缭绕阿房观阙崇，旌旗五丈建当中。\n万人曾和千人唱，一世焉知二世终。\n水落石鲸埋碧草，露寒金狄泣秋风。\n酒池炙树皆尘土，无复离宫复道通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"关中怀古 其三","author":"汪广洋","text":"未央宫殿七年成，武库宏开列绣楹。\n高祖不忘尝苦战，酂侯终欲厌群情。\n平笼凤阙当秦岭，覆压鲸波撼渭城。\n后世莫加难逆料，建章才就又承明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"关中怀古 其四","author":"汪广洋","text":"唐宫闻说是隋宫，一竭勤劳一享功。\n始信经营能取俭，后来缔构转为工。\n翔鸾栖凤连云表，拾翠承香结绮同。\n风景不殊朝市变，短沙零乱语秋蛩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53644,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偕王伯安登凌歊台","author":"汪广洋","text":"客子不乐登江皋，江上古台百尺高。\n云深辇路窜雀鼠，藤蔓翠壁愁猿猱。\n已闻紫皇驻玉节，况乃白日来秋涛。\n罢歌抚剑下台去，松树满山啼伯劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53645,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答曹秀才","author":"汪广洋","text":"曹君与我近相得，还可访我西城阴。\n固知把臂即为友，最喜识面能论心。\n弹琴屡爱白日静，酌酒一笑青春深。\n况复床头有珠玉，寄声愧乏双南金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53646,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊昌邑逢程照磨","author":"汪广洋","text":"两年不见程广陵，一见照人眉宇青。\n念乱每嗟鱼雁隔，谈诗还喜蛟龙听。\n白门酒好不易得，昌邑山多曾屡经。\n夜分舟子忽长往，令我相忆愁复醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53647,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中次陈检校见寄韵 其一","author":"汪广洋","text":"茂陵客子怕逢秋，百岁长怀千岁忧。\n六代云山归老眼，一江烟水送羁愁。\n西风古调谁家篴，落日轻帆何处舟。\n莫向凤凰台畔立，碧梧鸣鸟不胜幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53648,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"病中次陈检校见寄韵 其二","author":"汪广洋","text":"东湖把酒看明月，胜会於今有几人。\n乡国已非前日富，乾坤空寄一身贫。\n竹西歌吹经年断，江上莼鲈入梦频。\n偶向建龙关北望，碧云秋树拥仪真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53649,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题胡子徵春晖堂诗卷","author":"汪广洋","text":"三月好风江上归，心旌长共白云飞。\n轻舟昼泊慈母庙，芳草煖薰游子衣。\n呼名杜宇为谁泣，入馔鲤鱼空自肥。\n无复登堂拜家庆，祇惭对尔歌春晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53650,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答友人军中诗韵 其一","author":"汪广洋","text":"石城清旦发蒙冲，龙虎旗开剑戟雄。\n鹗渚瘴烟终见扫，吴门佳气亦何隆。\n曹瞒势迫须臾际，宋祖功归指画中。\n会拟劳还行大赉，百川成酒吸长虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53651,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答友人军中诗韵 其二","author":"汪广洋","text":"楼船江上驭飙轮，岂但西南解战尘。\n锦帜插天分列雾，铁衣环日灿披银。\n襄樊只合归王土，雅颂终当赋荩臣。\n幕下从官谁得意，陈琳草檄最清新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53652,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答友人军中诗韵 其三","author":"汪广洋","text":"倚天长剑砍祅星，排斥风云气愈精。\n四海正思来凤鸟，一军深喜咏仓庚。\n澄江白日传飞舰，伐鼓鸣钲撼列营。\n想到匡庐延五老，功成应解乞长生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53653,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠丹阳令白谦","author":"汪广洋","text":"曾闻李白遨游地，多在云阳古县中。\n诗笔夜题丹井月，酒船晴棹练湖风。\n人家隔水深深见，驿路看花处处同。\n今日宦游非昔日，野蒿烟草蔓晴空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53654,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄权都事","author":"汪广洋","text":"忆昔池头倡和诗，相逢曾是去年时。\n每惭司马恒多病，不及扬雄善属辞。\n积雨山城凝怅望，青春幕府重论思。\n想应珂佩珊珊日，芍药当阶午影迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53655,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中夜写怀寄歙郡诸老","author":"汪广洋","text":"冻墨团鸦赋未成，松堂重掩不胜清。\n天寒鹦鹉闻孤寂，月黑虾蟆报二更。\n拥彗正须诸阁老，投簪休拟羡门生。\n朝阳无限梧桐树，丹凤何如为一鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53656,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"使歙谕番阳","author":"汪广洋","text":"五岭苍苍剑插天，肩舆高下似乘船。\n残年止有二十日，沽酒岂无三百钱。\n野碓暝舂喧急水，山樵寒雨隔孤烟。\n秖惭将命恒驰逐，安得雄才配马迁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53657,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"到星源闻子敬王指挥得众心且番阳有归附意赋诗为赠","author":"汪广洋","text":"歙山群倚翠云梯，仰见长城堞雉齐。\n陆抗已闻羊祜德，伏波安受子阳稽。\n松堂夜色摇书幌，板屋寒更送鼓鼙。\n还忆肩舆旧游地，江东形胜似巴西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53658,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉旨咏白?","author":"汪广洋","text":"桫椤阴里捣灵砂，不使黄尘一点加。\n立向月中霜脱颖，行过桂底雪生花。\n赤乌翔集非专美，丹凤来仪足并誇。\n解得长生保贞素，洁身长近玉皇家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53659,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉旨赋天泽润兵渡江之初","author":"汪广洋","text":"采石矶头一苇过，远驱云雾逐星河。\n九江水阔鱼龙盛，万国春初雨露多。\n香挹旗旄纷綵色，恩流草木藉光和。\n洗兵会值崇文教，那用重赓夜宿歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53660,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过云屯滩","author":"汪广洋","text":"萝月纷纷星斗高，云屯滩上听飞涛。\n莫伤蜀鸟多啼血，且喜吴侬惯刺篙。\n风逆溪声悬碧树，雨深崖气入青袍。\n夜长把烛频看镜，只恐年来变二毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53661,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过犬牙滩","author":"汪广洋","text":"犬牙滩上浪喧豗，好似瞿塘滟滪堆。\n云木茏葱含暝雨，石门开豁殷晴雷。\n沙禽引子排船过，野獭衔鱼趁水回。\n惆怅无因慰寥廓，越山相对碧崔嵬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53662,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送唐师宗归金华","author":"汪广洋","text":"桐树花残春昼迟，星源门外送君时。\n到家已是三月尽，别路休辞十日期。\n南省故交烦寄语，东垣遗范慎论思。\n山杯纵饮终难醉，谩托长吟写素丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53663,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过故宫","author":"汪广洋","text":"毁垣遗迹在烟霞，麋鹿群群下浅沙。\n山岭净销龙虎气，野人犹纪帝王家。\n春风玉砌埋荒草，夜月银塘沸乱蛙。\n歌彻黍离情未泯，小禽冲落刺桐花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53664,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过徽州别魏府尹","author":"汪广洋","text":"与君携手凤池东，题遍春阶芍药红。\n况复云山千里别，岂知风雨一尊同。\n少陵老去忧多病，王粲年来喜事戎。\n二十五滩烟水急，几时归棹月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53665,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻邓佥院得徽歙民心喜赋短章兼美魏知府","author":"汪广洋","text":"邓禹经营揽俊良，魏徵匡济事文章。\n二贤往日尊伊吕，历代於今数汉唐。\n图像星联华阁晓，谏书春满御炉香。\n明时况喜云仍在，列传应知倍有光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53666,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐用郭奎韵","author":"汪广洋","text":"江城子夜动悲歌，海内交游近若何。\n愁到寒蛩啼露草，喜占乾鹊下庭柯。\n谢安好为图经济，王粲虚劳叹轗轲。\n与子出门天欲曙，马头斜月淡银河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53667,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答吴左丞见寄登滕王阁诗韵并序 其一","author":"汪广洋","text":"绣阁披云倚暮寒，江城雨雪遍峰峦。\n半空挝鼓三军乐，五夜烧灯万姓欢。\n相国旌旄来隐隐，宾筵珂佩响珊珊。\n重临谩忆追游日，独有阳春和转难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53668,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答吴左丞见寄登滕王阁诗韵并序 其二","author":"汪广洋","text":"雉堞岩岩江水头，芙蓉香净浦云收。\n旧时歌舞空遗迹，此地襜帷重久留。\n历历鸟鸣秋苑树，斑斑人上夕阳舟。\n数峰老翠檐前落，想见当初帝子游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53669,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题许旌阳祠答吴左丞韵","author":"汪广洋","text":"剑气棱棱夜不韬，混涵江水戴灵鳌。\n至人身后勋庸在，新庙云边结构牢。\n荆鄂烟氛终见扫，湘潭魑魅岂容逃。\n春风箫管腾腾日，多士瞻依莫惮劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53670,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过褚矶有感","author":"汪广洋","text":"舳舻谈笑竟成尘，兵气凭陵尚未湮。\n楚霸自知空四海，炎刘谁识定三秦。\n潭心月黑鱼龙伏，岩穴风清虎豹驯。\n唯有经行旧游处，淡烟衰草重愁人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53671,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过黄州有感","author":"汪广洋","text":"甲郡繁华控上流，郡中多半竹为楼。\n楚茆巴橘通王贡，越管秦筝贮客游。\n万灶颠危烟久灭，几人离散骨初收。\n移船夜读眉山赋，一鹤横江月满舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53672,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"快阁","author":"汪广洋","text":"西昌杰阁连城阙，胜日登临足快哉。\n楚岭重遮岚气合，赣江遥递浪声来。\n涪翁诗思排云汉，坡老词华被草莱。\n欲把一尊酹明月，夜深还上最高台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53673,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"使赣谕熊天瑞","author":"汪广洋","text":"舟行到赣数千里，江声泻碧山绸缪。\n将湮未湮断岸出，欲雨不雨晴云浮。\n谢公自足平生愿，司马真成汗漫游。\n明日旬宣应有暇，郁孤台上望南州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53674,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"风雨舟次万安闻赣城未附","author":"汪广洋","text":"汨汨寒江照碧芜，阴阴官树噪童乌。\n一篷风雨留行色，万里云山入壮图。\n马武拔身终仕汉，周瑜仗剑早从吴。\n闭门尊大成何事，惭愧公孙画此谟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53675,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登郁孤台","author":"汪广洋","text":"传报东门橐钥开，缓乘单骑陟层台。\n连营喜动旌旗捲，遮道欢迎父老来。\n云拥龙骧通百越，天垂象纬丽三台。\n赣江流水深千尺，愿激馀波遍草莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53676,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题瑞菊诗卷后并序","author":"汪广洋","text":"我对青山倦著鞭，君垂白发赋归田。\n偶来把臂三千里，却忆题诗二十年。\n零落亲朋逢乱日，萧条松菊委荒烟。\n临风展玩长挥泪，谩想当时思惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53677,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南韶","author":"汪广洋","text":"皇恩旷荡被南陲，岭徼间关遂坦夷。\n谕俗正询司马传，观风当见召公诗。\n山厨和壳蒸粳稻，驿路含浆食荔枝。\n故老不忘乡丈德，年年来祭曲江祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53678,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"远怀","author":"汪广洋","text":"老亲独往京城日，贱子复上西江槎。\n菽水暂虽离膝下，关河可奈渺天涯。\n千岩古木啼鹃鸟，一路东风过楝花。\n遥想小儿初学语，月终应是望回家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53679,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀陈教授并序","author":"汪广洋","text":"于湖春日草萋萋，十五年前忆旧题。\n幸际盛时开幕府，愧无长策及青齐。\n江城四月杨花过，公馆三更杜宇啼。\n念子不眠增感慨，越山迢递水云低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53680,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过高邮有感","author":"汪广洋","text":"去乡已隔十六载，访旧惟存四五人。\n万事惊心浑是梦，一时触目总伤神。\n行过燬宅寻遗址，泣向东风吊故亲。\n惆怅甓湖烟水上，野花汀草为谁新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53681,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]