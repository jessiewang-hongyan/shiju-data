[{"title":"新春报二兄书","author":"于慎行","text":"雁行中断两天分，南浦春声昨夜闻。\n池上梦回千里月，山中人隔几重云。\n雄文未献河东赋，壮略曾观陇右军。\n金马浮沈休借问，只应猿鸟自为群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘太史奉使韩藩","author":"于慎行","text":"名藩带砺主恩恢，使节西游亦壮哉。\n玉署天香三殿迥，桐函春色五云开。\n川连博望乘槎路，地尽轩辕问道台。\n归向高堂行庆酒，斑衣可识尚方裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为人题双寿卷","author":"于慎行","text":"鹿门真隐旧知名，藉甚仙郎汉列卿。\n归院宫云随玉佩，上堂春酒汎瑶觥。\n斗边剑合双龙气，月底箫分两凤声。\n讵假金书传阆苑，且看丹诏出层城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕","author":"于慎行","text":"琪树西风一叶秋，银河清浅月如钩。\n关前玉笛吹新恨，天上金梭织旧愁。\n鸾自飞回人欲尽，鹊曾填处水还流。\n浮踪此际浑无赖，脉脉遥心自倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同馆中诸丈饮谢都尉林亭","author":"于慎行","text":"蓟苑秋高望不穷，主家台榭苑墙东。\n凭阑暝入千峰雨，对酒寒生万木风。\n画角声残龙塞远，玉箫曲断凤楼空。\n先朝邸第多零落，鲁馆依然气色中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕怀诸兄弟","author":"于慎行","text":"九陌笙歌岁又阑，惊人时序汉长安。\n凋萧两鬓池头佩，寂寞三秋梦里兰。\n上苑花从今夜发，故乡书拟隔年看。\n天涯兄弟应相念，绿酒青灯可自欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"禁中春雪","author":"于慎行","text":"五陵芳草欲成丛，雨雪依然满汉宫。\n万里关河销紫塞，九天楼阁冷瑶空。\n西山月出宁知晓，上苑花飞不待风。\n徙倚铜龙正愁思，阳春一曲赋难工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春暮偕沈澄川太史游城南王氏园亭和韵","author":"于慎行","text":"休沐相招盛会偏，宜春苑路草芊绵。\n重城楼阁笼春树，曲岛松萝散晓烟。\n风起花香飘槛外，雨馀山色落尊前。\n由来杜曲多名胜，斗畔犹疑尺五天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"文华殿进讲有述","author":"于慎行","text":"珥笔承恩既有年，论思今复厕群仙。\n春城日永纡清漏，晓殿云深拥细旃。\n袖拂天香开绣简，心迎睿想入瑶编。\n却惭经术元疏薄，献纳无裨荷宠偏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19942,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭代皇上奉祝圣母万寿无疆诗","author":"于慎行","text":"藐质冲龄御大方，慈恩辛苦护垂裳。\n祥开华渚仙源远，庆衍瑶池化日长。\n上食亲调金掌露，舞衣时傍玉炉香。\n承欢幸抚升平会，荐寿鸿仪仿未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19943,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日龙华寺小坐","author":"于慎行","text":"苑西桥畔古祗林，满院松杉昼郁森。\n山色平连三殿影，湖光曲抱五城阴。\n尊前细雨飘仙梵，槛外凉风急暮砧。\n宴坐不知清昼永，一函经咒对沈吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19944,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西苑鳌山恭纪","author":"于慎行","text":"别苑春宵翠殿开，华灯宝炬满蓬莱。\n花分火树千枝落，星转璇仪万象回。\n九陌香尘随地合，六宫歌管自天来。\n恭逢玉烛均调日，愿取三山作寿杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19945,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣迎子冲可大二丈入对","author":"于慎行","text":"旅鬓风尘感岁华，故人今日尚天涯。\n三年梦隔长安月，千里春期上苑花。\n济北鸿声来拥传，湖西雪色隐乘槎。\n即看醉握双龙剑，依旧燕城卧酒家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19946,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子冲可大二君新第同饮朝天宫台上","author":"于慎行","text":"倚马高台兴不禁，垂髫旧侣共登临。\n三山暮雨飞仙阙，万户春花满禁林。\n缥缈箫声云里近，纵横剑气酒边深。\n回思二十年来事，今日吾曹可醉吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19947,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许悟庵鍊师还云翠山兼寄山灵二首 其一","author":"于慎行","text":"旧时曾作小游仙，寄迹灵峰偶偓佺。\n卖药忽从都市见，还丹岂向世人传。\n瑶坛月出浑如水，玉洞花开别有天。\n归去正逢春色老，采芝可傍紫云眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19948,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许悟庵鍊师还云翠山兼寄山灵二首 其二","author":"于慎行","text":"家近名山住亦稀，别来清梦转依依。\n愁生猿鹤花迷径，恨结松萝月上扉。\n青镜空悲游子鬓，红尘偏染仕人衣。\n凭君寄语山灵道，早晚抽簪向翠微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄庠师周介轩先生","author":"于慎行","text":"千里蒹葭水国天，白头博士枕书眠。\n人从对酒青灯夜，事忆谈经绛帐年。\n一札希逢西楚雁，双浆好汎北湖船。\n惭从鲁国诸生后，儒术无成侍禁筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登双寺阁赠金陵怀上人","author":"于慎行","text":"倚马东林访惠休，上方钟磬一登楼。\n千峰夕送花宫雨，万井凉生桂苑秋。\n地向红尘开净土，人皈白社结良游。\n不须却忆飘芦处，江北江南总帝州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张洪阳年兄上南少司成二首 其一","author":"于慎行","text":"西清法从沐恩偏，日日论思捧御筵。\n岂谓廷中摧五鹿，复教门下纪三鳣。\n离声蓟苑河桥雨，别梦秦淮月夜烟。\n十载同游词赋客，只今结绶是君先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张洪阳年兄上南少司成二首 其二","author":"于慎行","text":"离合相看一怆神，百年宠辱梦中身。\n无将建业秋江水，不及长安绮陌尘。\n天畔文星珠斗近，座中时雨绛帷春。\n应知煖席无多暇，乂奉徵书入紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送孙柏潭太史册封唐藩便道省觐","author":"于慎行","text":"射策名高贾洛阳，青春拥传有辉光。\n花迎玉节槎凌汉，叶剪桐圭土胙唐。\n客路千门江上月，主恩三殿署中香。\n非关昼锦偏生色，自是庭帏宠渥长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送盛凤冈太史册封蜀藩","author":"于慎行","text":"宝玉亲颁示展亲，还因谕蜀论过秦。\n云凝阁道青天险，家近关门紫气真。\n玉节遥分三署色，金羁行耀五陵春。\n悬知万里桥边路，共指轩车问使臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题韩敬堂殿讲牡丹石榴画卷时值双寿称觞并呈此瑞","author":"于慎行","text":"仙种何年福地栽，巧分春色艳亭台。\n丹房并倚珠林结，绣萼双依翠幄开。\n味胜绯桃金母醉，花先红药侍臣回。\n合欢正值称觞日，满目天香拂酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送沈少陵太史请告","author":"于慎行","text":"莺燕晴娇禁苑春，冥鸿何意出风尘。\n到来天地伤多事，归去江湖尚有人。\n射策彤庭干气象，上书黄阁想风神。\n敬亭秋色堪高枕，不负萧条报主身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同可大城西寺楼眺望","author":"于慎行","text":"石林香岫锁氤氲，百尺危阑倚落曛。\n双阙湖光涵镜彩，九陵云气吐龙文。\n烟销野色愁中见，风起边声醉里闻。\n谐俗不妨聊对酒，从他尘世自纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观慈寿寺新造浮图","author":"于慎行","text":"凤刹新从佛土标，芙蓉千尺翠岧峣。\n璇题玉甃中天起，法雨昙云下界飘。\n势挟珠林雄禁苑，影分银汉挂烟霄。\n群生福果缘慈祐，辇尽黄金此地销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日登毗卢阁","author":"于慎行","text":"宝界高悬百尺楼，丹梯半上不能休。\n窗临星斗诸天近，壁绕烟霞五月秋。\n迢递群山横大漠，苍茫一气辨皇州。\n凭阑欲起悲歌色，人代何缘此胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日崔明经正思五弟同游韦园","author":"于慎行","text":"韦曲城南晓雾开，炎天深树锁亭台。\n渔舟隐见花间出，鸥鸟浮沈杖底来。\n香散芰荷残过雨，烟飞萝薜冷衔杯。\n帝城风物家乡侣，醉倚青林首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱鞶峰鸿胪之金陵","author":"于慎行","text":"二十年来忆旧欢，相逢斗酒醉长安。\n尊前华发流光易，陌上骊歌别路难。\n江月遥分鳷鹊观，宫云不散鵔鸃冠。\n到来绵蕞开王会，剑佩声中拥汉官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀四首 其一","author":"于慎行","text":"露下天空木叶流，满怀萧瑟一登楼。\n江湖雁影催乡梦，城阙砧声起暮愁。\n万里风尘燕塞远，千门云月汉宫秋。\n红颜华发悲生事，金爵铜驼感壮游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀四首 其二","author":"于慎行","text":"极目高空一雁翔，十年萍迹滞天方。\n芙蓉晓露愁边白，薜荔秋山梦里苍。\n病似相如聊著赋，鬓如潘岳尚为郎。\n凭阑此际浑无赖，日晚寒生画角霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀四首 其三","author":"于慎行","text":"风入疏林月半横，秋声一夜壮心惊。\n柴桑故自饶归兴，中散由来少宦情。\n名利百年身易老，文章千古事难成。\n恩深未报惭明主，苦忆深山桂树生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀四首 其四","author":"于慎行","text":"旧隐林皋几放歌，蓬玄西洞长烟萝。\n清溪日落鱼梁出，翠嶂天长鸟道过。\n醉里白云挥袖满，秋来明月倚阑多。\n不辞便作风尘客，鹤怨猿惊可奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日荅李本宁太史秦中四首 其一","author":"于慎行","text":"西风萧索五城秋，望断秦关感旧游。\n一自宫砖虚日影，至今仙署想风流。\n鸿归上苑书重到，月落枫林梦亦愁。\n闻道龙门连太华，何人得并李膺舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日荅李本宁太史秦中四首 其二","author":"于慎行","text":"斗畔何年少岁星，搴帷聊复试传经。\n关门气自车边紫，太乙藜从阁上青。\n忽见双鱼传札素，疑闻三鳣落阶庭。\n不知玉女峰头座，可许生徒隔帐听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日荅李本宁太史秦中四首 其三","author":"于慎行","text":"憭慄霜天万木声，愁看落叶太纵横。\n青山已自盈秋色，白眼从来冷世情。\n经术但传秦博士，疏狂莫笑鲁儒生。\n加餐郑重劳相念，祗有庭兰梦未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日荅李本宁太史秦中四首 其四","author":"于慎行","text":"千里离愁郁不开，故人佳句傍谁裁。\n秦台凤女箫三弄，汉苑仙人露一杯。\n岁月吾甘梅尉隐，乾坤尔自贾生才。\n春来若有书相问，尺素应知海上回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日书怀奉寄二兄","author":"于慎行","text":"避世年来华发侵，秋情旅思两萧森。\n虚谈仗马当时事，实负冥鸿万里心。\n客里常思陶令酒，愁边几作越人吟。\n天涯兄弟长相忆，明日青山是旧林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答邬汝翼见寄","author":"于慎行","text":"积雨挑灯思不禁，开缄忽见楚人吟。\n芙蓉自抱三秋色，鸿鹄谁知万里心。\n别忆青尊江树杳，梦回明月海云深。\n无劳汉署怀方朔，金马于今总陆沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉旨代撰恭祝圣母万寿二首 其一","author":"于慎行","text":"宝祚恭膺幸有年，为承慈训化机旋。\n东朝共祝增仙算，大内亲趋捧寿筵。\n律转一阳熙舜旦，石将五色补尧天。\n母仪仰见超前古，图史应令万祀传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉旨代撰恭祝圣母万寿二首 其二","author":"于慎行","text":"璇霄南极现祥光，入仗亲称万岁觞。\n宝座三重开内殿，法音九部举东厢。\n华嵩效祝春难老，衮绣承欢日始长。\n愿酌沧溟添寿纪，年年流庆衍天潢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日有怀伯仲两兄","author":"于慎行","text":"一雁横空玉塞寒，疏星淡月倚楼看。\n乡山有梦秋先到，京洛无心兴已阑。\n多病长卿聊罢酒，长贫仲子未弹冠。\n鸰原别恨年年剧，无那浮踪去住难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬至南郊扈从纪述和陈玉垒太史韵八首 其二","author":"于慎行","text":"平明阊阖五门开，法驾骖驔匝地来。\n雷动千乘天厩选，飙驰七校羽林材。\n金支翠盖云中转，紫旆红幢树杪回。\n清跸尚喧双凤阙，前驱已戾九成台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬至南郊扈从纪述和陈玉垒太史韵八首 其三","author":"于慎行","text":"阳灵仙馆翠云端，竹殿清斋礼泰坛。\n阁道霓旌陈虎豹，宫门羽仗簇鸳鸾。\n亲军竞带千金剑，御马齐笼七宝鞍。\n总为天光依较近，温泉午夜不知寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题李棠轩太史风木卷","author":"于慎行","text":"水部才名世所传，平生旧事付新镌。\n青箱累叶承先庆，玉署重辉启嗣贤。\n天上楼成曾有梦，人间鹤去不知年。\n只今陇草悲仙吏，岁岁春风泣杜鹃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"葛端肃公挽章四首 其一","author":"于慎行","text":"朱轮几日下明光，一夜台星遽掩芒。\n名德累朝耆旧尽，风流前辈典刑长。\n百年海岳收灵气，三省官僚纪奏章。\n莫讶台乌来去少，荒原终日咽长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"葛端肃公挽章四首 其二","author":"于慎行","text":"五十年来社稷身，世皇时已画麒麟。\n车行陜潞千家雨，戟拥幽并万里春。\n北极星辰三听履，东山烟月几垂纶。\n九重此日宫悬彻，鼓吹黄肠宠使臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"葛端肃公挽章四首 其四","author":"于慎行","text":"里闬衣冠旧侍公，每从便坐接春风。\n台端剑履容犹在，海上桑田事已空。\n画阁勋名应自远，蘧庐梦觉总难穷。\n不堪片语牛山望，千古英雄涕泪中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中卧病杨庐山至京枉过","author":"于慎行","text":"春城雨雪卧袁安，仙令朝天驻锦鞍。\n万里风尘随聚散，百年湖海见交欢。\n翻疑梦杳罗浮月，好在香分画省兰。\n伏枕烧灯浑未厌，坐来鳷鹊夜光寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨庐山之官盐城","author":"于慎行","text":"宫草含青雪未消，送君斗酒夜迢迢。\n愁边晓月双凫远，醉里晴云五凤娇。\n泽国鱼盐多负海，春城烟雨半通潮。\n只今满目看萑苇，岂藉催科荅圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中朱廷平可大携谈易王生见过书怀","author":"于慎行","text":"宣室情知久荷恩，旅愁无奈泥芳荪。\n十年玉署尘心冷，一片青山素业存。\n病里风云天北阙，春来花树鲁东门。\n欲知朝市浮沈理，季主长安好共论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中乞归怀寄中立王孙","author":"于慎行","text":"银榜仙宫桂满岩，何时雪夜挂孤帆。\n枕中鸿宝新来注，海上鱼书旧日缄。\n千里归心看短剑，百年病骨付长镵。\n王孙苑路今应近，芳草春风点碧衫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"都门留别诸丈","author":"于慎行","text":"不缘多病壮心消，敢向清时远市朝。\n三殿恩华淹日月，十年归梦落渔樵。\n宫云欲散飘衫袖，别酒初醒见柳条。\n最是河梁分手地，桃花潭水碧迢迢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河寄都下旧游","author":"于慎行","text":"承恩霄汉苦思归，祗忆深山长蕨薇。\n去汉梁鸿藏姓字，还邛司马借恩辉。\n身轻已觉愁颜改，战胜应看病骨肥。\n回首金闺多旧好，别时情思各依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘉靖壬戌从三兄无择下第同归有过桃花口诗至万历已夘请告南还复过此地咏兄旧句怅然有感用韵追和","author":"于慎行","text":"廿载津亭唱棹过，依然烟柳夹长河。\n花源尚记来时路，鸿影空怜旧日歌。\n人代三朝看过隙，生涯万事付流波。\n双棠旧馆应无恙，独抚遗编思若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕呈二兄","author":"于慎行","text":"乡闾风土弟兄居，冉冉年光岁又除。\n胜里金花聊共赏，尊中柏叶肯教虚。\n居邻碧海三山路，交绝长安七贵书。\n犹有谢家辞翰在，春山游眺许谁如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庚辰元旦试笔","author":"于慎行","text":"箫鼓初阑旭日开，小庭春色欲重来。\n灵符旧箧金闺赐，宝胜新妆玉剪裁。\n欢洽儿童随笑语，恩深禁阙忆趋陪。\n谁将柏叶调仙酒，为荐君王万寿杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀朱廷平可大兼讯于泽州子冲入觐","author":"于慎行","text":"归来无日不思君，画省风流久未闻。\n上苑鸿声愁处听，长亭春草醉时分。\n双龙自合天边气，五马遥停塞上云。\n莫问同时旧年少，已从樵牧隔人群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄贾石葵廷尉","author":"于慎行","text":"百年踪迹总飘萍，懒向风尘问醉醒。\n卧病梅花江上白，怀人芳草梦中青。\n天悬台馆占卿月，地入江湖隐客星。\n闻道乞归归未得，主恩不负草堂灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日山中有怀赵瀫阳年丈时官南越","author":"于慎行","text":"不关寂寞重相思，心折长安握手时。\n万里铜标人落魄，十年金马事参差。\n眼青杨柳东风日，头白梅花北向枝。\n惟有鲁狂容圣世，五湖烟水足恩私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中书怀荅朱可大廷平二首 其一","author":"于慎行","text":"海水天风莫重论，吾曹交谊向来敦。\n冯驩长铗应犹在，范叔绨袍故自温。\n千里人归孟诸野，十年客散信陵门。\n閒心已绝诸缘累，独有平生未报恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中书怀荅朱可大廷平二首 其二","author":"于慎行","text":"天末怀人思不降，梦回明月满轩窗。\n平生诺重黄金百，国士名齐白璧双。\n君自风尘淹画省，吾甘渔猎光沧江。\n书来正值山间醉，赤脚吹笙卧石淙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]