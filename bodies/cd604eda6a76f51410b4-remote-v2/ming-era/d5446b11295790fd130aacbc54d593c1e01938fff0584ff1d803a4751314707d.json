[{"title":"秋怀柬卫子涵","author":"谢榛","text":"细雨秋山净，寒烟暮野空。\n龙蟠无浊水，凤宿有孤桐。\n世业兵戈后，年光客旅中。\n云林千古意，寂寞几英雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日都下言怀","author":"谢榛","text":"煮药花朝过，中宵坐黯然。\n楼空万井月，树合九门烟。\n多病还词赋，孤怀且岁年。\n沧江有白鸟，来往钓矶边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬马子端","author":"谢榛","text":"若木横西极，鲲鱼鼓北溟。\n壮图双鬓黑，不寐一灯青。\n曙月低花苑，春烟澹石屏。\n上公开阁日，暂尔谢山灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"崔太傅北园同张光禄友衡陈礼部子发闻人礼部元科吴大理希明得诗字","author":"谢榛","text":"胜地成高会，云和度曲时。\n百花明院落，一鸟下台池。\n待月仍呼酒，看山共赋诗。\n凤城春色暮，莫负牡丹期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同内阁张友衡张文光二公饮崔京山园亭","author":"谢榛","text":"锦石高于屋，名香霭若云。\n笙镛间清响，花草杂幽芬。\n人醉瑶京酒，天成紫阁文。\n广除多皓月，改席坐宵分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日崔西峨宅同张水部德杨醉赋","author":"谢榛","text":"日暮重门寂，风凉独树斜。\n一樽元亮宅，万卷子云家。\n白石垂兰叶，清池出藕花。\n水曹同取醉，庭宇落残霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿淇门驿怀孙方伯性甫王宪副廷瞻江少参伯阳","author":"谢榛","text":"驻马淇门夕，堂空暑气徂。\n乱云关树暝，寒雨驿灯孤。\n身计聊时序，乡心复道途。\n何当报知己，秋雁满江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"表兄周平基书至","author":"谢榛","text":"兄弟成脩阻，霜空一雁过。\n桑麻怀故国，烟月梦西河。\n短杖徘徊意，孤樽慷慨歌。\n相思秋又暮，白发竟谁多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄王东畬","author":"谢榛","text":"我游京国去，君向邺城来。\n自拂灯前剑，谁传花下杯。\n停云虚夜馆，落月旷秋台。\n鸿雁飞何处，相思赋七哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日","author":"谢榛","text":"异乡今日酒，无那客愁新。\n风落千林雪，天回万谷春。\n儿童催老大，物候感沉沦。\n何限长堤柳，青青又向人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古意","author":"谢榛","text":"南国动幽思，春洲搴绿芳。\n九嶷云物夕，帝女怨潇湘。\n华月照瑶瑟，灵风吹绮裳。\n那知苦调罢，楚客立苍茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同李汝锡马伯龄游苏门山柬王明府","author":"谢榛","text":"好山同一赏，行坐有莓苔。\n潭上幽花照，樽前白鸟来。\n放歌风振木，起舞月临台。\n欲刻苏门石，惭非谢朓才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨后柬张宗昭","author":"谢榛","text":"雨后小园净，豆花寒更开。\n客中秋序过，灯下雁声来。\n懒慢催诗句，疏狂但酒杯。\n故人期不至，凉月满高台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过山叟","author":"谢榛","text":"栗里堪同隐，濠梁复一过。\n衡门开绿野，石壁带青萝。\n偶共山人醉，閒随牧子歌。\n还怜夜色好，星月湛沧波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜柬张崇德","author":"谢榛","text":"满天风摵摵，木叶下山城。\n夜静群虫响，秋高片月清。\n多方身计拙，无病旅愁轻。\n仲蔚深知己，悠悠江汉情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过仪封呈大司马王浚川","author":"谢榛","text":"行客度河甸，空林寒日初。\n风高脆蒲苇，水落困龙鱼。\n民物诛求际，边陲战伐馀。\n济时须大老，莫恋草玄庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古怨 其一","author":"谢榛","text":"高楼俯江树，楼上有蛾眉。\n旧约空成叹，新愁可诉谁。\n春閒翡翠幕，月冷杜鹃枝。\n荡子复何处，杨花无定时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古怨 其二","author":"谢榛","text":"杨花日飘荡，能复几何春。\n远道宁知妾，流年不待人。\n片云横上国，独鸟下西秦。\n无奈怀君意，清江采绿蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古怨 其三","author":"谢榛","text":"绿蘋时复采，独立转深愁。\n忆昔郎船去，极天江水流。\n玉环应自佩，金谷谩长游。\n可惜铅华落，西风入画楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同双泉清泉涌泉西泉四将军园酌","author":"谢榛","text":"南园鸣布谷，烟雨万家春。\n庭草乱依榻，山云低傍人。\n当歌惟胜地，快意几芳辰。\n醉杀高阳客，花前倒葛巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登城有感奉寄江宁王怀易","author":"谢榛","text":"野风吹客袂，感慨一登城。\n孤鸟日边没，大河天外倾。\n年华悲杜甫，世故老虞卿。\n龙剑应相合，云霄无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河","author":"谢榛","text":"路出大梁城，关河开晓晴。\n日翻龙窟动，风扫雁沙平。\n倚剑嗟身事，张帆快旅情。\n茫茫不知处，空外棹歌声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集孟得之园亭","author":"谢榛","text":"万竹生秋意，林园六月初。\n骚人宜物色，樽酒坐庭除。\n落日横孤嶂，清风满太虚。\n兴高归去晚，池上采芙蕖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日洹上书怀","author":"谢榛","text":"水边沙草合，林外石桥横。\n云漫三秋色，河流万古声。\n野花欺老鬓，林酒胜浮名。\n我爱桐江叟，渔竿不世情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同李元博携酒访岐南道人","author":"谢榛","text":"共向东园酌，葫芦秋正花。\n千畦散流水，万木带飞霞。\n碧海仙人岛，玄都道士家。\n未应骑鹤去，聊此话丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀玉清阁","author":"谢榛","text":"紫阁登临处，秋光入品题。\n窗吞河岳尽，檐压斗牛低。\n客路孤城外，仙坛万岭西。\n浮丘分袂后，望断白云梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀香山寺","author":"谢榛","text":"曾识京西路，名山梵帝家。\n殿高千岭树，地落半天霞。\n空外钟声彻，云边塔影斜。\n老禅相对处，笑指白莲花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱君归都下","author":"谢榛","text":"君来邺城雪，君去蓟门秋。\n生计疏乡信，归期减客愁。\n光阴多道路，慷慨几交游。\n谁识燕歌处，孤云傍酒楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘佥宪才甫北伐","author":"谢榛","text":"七月边烽动，三河兵气扬。\n乘秋发猛士，计日缚名王。\n剑倚云霄迥，旗连海雾长。\n燕然一片石，终古有馀光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杜敬夫有事显陵","author":"谢榛","text":"匹马飞千里，孤帆截九河。\n天南郢州道，月下楚人歌。\n陵庙楸梧冷，江城云雾多。\n万年帝灵在，神鬼护山河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀碧云寺","author":"谢榛","text":"群山开宝地，忆昔杖藜过。\n石洞馀冰雪，岩泉净薜萝。\n虚空尘虑尽，疏散胜缘多。\n欲结东林社，相依老洞阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同邹汝邻张伊梁李元博饮申幼川北园登台醉赋","author":"谢榛","text":"朋好多风雅，园林复此游。\n天边数峰出，台下一河流。\n浦树笼苍霭，霜花照素秋。\n骚人嗅芳意，莫讶为时忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同陈石卿夜酌善应山","author":"谢榛","text":"骚客同今夕，当杯意思閒。\n天风入古树，海月到空山。\n胜赏双林外，高歌万壑间。\n人生竟多事，此地几登攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王中书嘉宾归海陵","author":"谢榛","text":"华发紫薇郎，鸣鞭下帝乡。\n莼鲈新味美，丘垄故思长。\n海国连秋气，江皋带晚芳。\n兴来一鼓枻，谁与咏沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜寄郭黄州","author":"谢榛","text":"久别多遐思，惊心夜半鸿。\n霜飞邺台冷，月照楚江空。\n感慨三秋过，徵求万邑同。\n细侯深有意，聊尔托长风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有怀","author":"谢榛","text":"南国美人别，长怀相见初。\n不传万里信，閒杀九江鱼。\n白发增长叹，黄花伴索居。\n夜深风露下，犹自立前除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄孙尧峰把总","author":"谢榛","text":"同衰不相见，忆昔蓟门逢。\n送别吴帆远，含思燕树重。\n湖光閒鹳鹤，秋色净芙蓉。\n月下长安梦，枫桥夜半钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴下洞庭两山诗客每从予游四十年来凋敝尽矣率成短律用志悲感","author":"谢榛","text":"胜地阖闾国，沧波范蠡船。\n山通转折路，湖抱混茫天。\n丝管春风里，松楸晚照边。\n人家几歌哭，谁尽白头年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张二守鸣远携酒夜过禅房率尔赋赠","author":"谢榛","text":"携酒出偶尔，随意是端居。\n垂老诗犹进，能狂礼不疏。\n兴高云影外，心悟磬声馀。\n每过论三昧，无令禅榻虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄杨中丞伯谦","author":"谢榛","text":"晋俗犹秦俗，君来化自同。\n多忧关大计，两镇得全功。\n雪尽西山迥，云閒朔漠空。\n樵苏幸无事，四野共春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和王侍御沁阳再逢除夕","author":"谢榛","text":"复此岁将尽，乌啼霜满城。\n孤灯千里客，夜半两年情。\n北望边愁剧，西来鬓发更。\n乘春发骢马，犹自问苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钦水部子辰之沛中","author":"谢榛","text":"清标怜水部，南去意何穷。\n树色分淮甸，河流见禹功。\n乱帆春草外，古堞暮云中。\n感慨登台处，萧萧起大风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王行人维藩使汝南","author":"谢榛","text":"仙郎宠命新，向晓发征轮。\n去路梁园雪，归期燕谷春。\n王孙瞻绛节，候吏走黄尘。\n想过仲宣宅，还怜作赋人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄北海冯汝强","author":"谢榛","text":"旷矣青云路，凄其白发年。\n病多还自遣，赋就几人怜。\n三径迷秋草，孤鸿断雪天。\n相期九节杖，定访十洲仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐比部汝思使蜀中 其一","author":"谢榛","text":"何处看春色，江城花鸟繁。\n射洪一樽罢，骚雅几人存。\n日下铜山静，云连赤岸昏。\n更怜陈正字，零落狱中魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐比部汝思使蜀中 其二","author":"谢榛","text":"春草遍三川，征轺入蜀年。\n栈通星使路，岭断夜郎天。\n关塞双旌转，风霜一剑悬。\n劳歌对明月，江上几回圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同李于鳞王元美比部集韦氏水亭得韵二首 其一","author":"谢榛","text":"都门联辔出，此地访烟萝。\n共酌清樽酒，还成白苧歌。\n春云花外度，幽鸟水边多。\n更拟池亭上，相将采芰荷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同李于鳞王元美比部集韦氏水亭得韵二首 其二","author":"谢榛","text":"我来凭水槛，坐久夕阳斜。\n聊复祛尘事，相将揽物华。\n河山百战地，桑柘几人家。\n纵有明春约，还看何处花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春游","author":"谢榛","text":"古道一鸣鞭，苍茫雨后天。\n湖明春草外，寺隐暮云边。\n野浦还垂钓，山房欲问禅。\n客中幽事少，独愧白头年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和王比部元美喜浚人卢楠冤雪之作","author":"谢榛","text":"春从邹律动，近得破愁颜。\n心事孤灯下，年光万死间。\n赋成馀白发，身在有青山。\n共尔烟霞约，飘然去不还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送蒋判官子重之泰安","author":"谢榛","text":"策马齐中道，行当佐郡忧。\n城连岱云起，地接海天浮。\n赋税徵兵日，星霜报国秋。\n有怀时北望，寒雁下河洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱郎中伯邻养疴道院雨中见召赋此答之","author":"谢榛","text":"习静依山侣，同怀复见招。\n三花烟雨隔，一鹤洞天遥。\n寒逼青霞馆，泥深白石桥。\n月明应不负，樽酒听吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送苏子冲之云中","author":"谢榛","text":"翩翩苏季子，征马独嘶风。\n路转河声近，星摇剑气雄。\n旌旗閒塞上，笳鼓静云中。\n试看和戎后，谁收不战功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"季夏夜过郭学士质夫馆得流字","author":"谢榛","text":"客居度烦暑，仙馆得清秋。\n华露凉浮动，明河夜转流。\n思乡还自赋，秉烛且同游。\n潦倒谁招隐，淮南桂树幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同沈禹文周君可二参军集章子吉参军宅时章景南行人至自上党即席赋此","author":"谢榛","text":"使星昨夜转，车骑入长安。\n共喜传觞好，犹言行路难。\n蝉声风外断，槐色雨中寒。\n起舞苍龙剑，光芒几度看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登楼北望怀郭学士质夫李吏部一元","author":"谢榛","text":"李郭风骚匹，登楼独怅然。\n黄花秋满地，白雁夕横天。\n玉阙云霄外，金门日月边。\n疏狂燕赵客，早晚赋甘泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏夜邹参政君哲宅陪饯皇甫别驾得才字","author":"谢榛","text":"磊落闽中彦，沉沦吴下才。\n相看成别赋，一笑且深杯。\n庭暗流萤过，楼明缺月来。\n新丰能几醉，骑马故迟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日大雨","author":"谢榛","text":"小楼动秋意，风雨忽来时。\n暗失黄尘陌，平开绿草池。\n朝閒成久卧，气爽得新诗。\n车马访幽独，冲泥竟有谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣怀","author":"谢榛","text":"天地此生浮，贪名岂道流。\n何为儿女计，徒遣岁时忧。\n取醉江花日，行歌岭树秋。\n向平元有约，南尽白云游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立秋夜有感","author":"谢榛","text":"秋生一叶初，摇落重愁予。\n宋玉悲何晚，嵇康计亦疏。\n星明孤剑动，月白小楼虚。\n为忆同心者，天涯未报书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜石户曹君采宅留别得云字","author":"谢榛","text":"无那天涯别，寒蛩可更闻。\n烛花还对我，尊酒暂同君。\n夜驻西山月，秋生北塞云。\n他时重相忆，惆怅几宵分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张少参子明见过","author":"谢榛","text":"病客掩扉卧，时闻车马临。\n几来燕市里，能识鲁生心。\n独树秋先老，浮云昼欲阴。\n况逢忧国际，谁为访山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"章景南署中对竹","author":"谢榛","text":"谁种此亭竹，当樽一问君。\n相看成野意，自觉远尘氛。\n幽色霜前见，秋声月下闻。\n醉来堪隐几，清梦入湘云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜雪后同王给事以宁集胡进士文澄宅予病先归","author":"谢榛","text":"客醉黄花月，堂开白雪天。\n重城辉夜色，老树夺春妍。\n已负金樽酒，那成宝剑篇。\n病来扶上马，归向小楼眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高比部伯宗宅夜集得清字","author":"谢榛","text":"铜漏夜初涩，冰壶韵转清。\n月澄天汉影，风落禁钟声。\n病里疏身计，天涯得友生。\n后期无定所，江海共含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜同徐比部子与吴舍人明可听张肖甫鼓琴得声字","author":"谢榛","text":"夜过成都客，风流羡长卿。\n壶觞移烛影，山水入琴声。\n庭敞风初断，天寒月更明。\n他时轩冕会，应记薜萝情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘推官子礼之平阳","author":"谢榛","text":"人怜燕市别，才羡洛阳奇。\n春色迎骖动，民情到郡知。\n天低姑射岭，云抱帝尧祠。\n几为看汾水，东流寄所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送卢司业浚卿再赴南都 其一","author":"谢榛","text":"相忆江湖远，相逢京国初。\n羽觞春欲动，宫漏夜何如。\n客久惭怀刺，年衰可著书。\n君仍金马诏，吾竟白云居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送卢司业浚卿再赴南都 其二","author":"谢榛","text":"阳城复南去，岁晚上吴船。\n寒尽秣陵雪，春浮扬子天。\n一官心自远，六代赋同传。\n何异碧山下，萧条著述年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]