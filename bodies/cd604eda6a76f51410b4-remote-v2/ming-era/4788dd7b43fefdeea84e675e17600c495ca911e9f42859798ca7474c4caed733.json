[{"title":"北里新书屋二首 其二","author":"释函可","text":"卜居宁有意，聊以禦寒冬。\n残瓦沿冈拾，低垣带雪舂。\n但将书与共，所贵月能容。\n从此门前路，时添云水踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋尽","author":"释函可","text":"秋光辞我去，还似惜春心。\n野雀翔空响，寒云到地阴。\n不能抒远梦，竟欲罢孤吟。\n自此山门掩，屐声无近林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠无瑕师","author":"释函可","text":"非关学辟谷，少小便忘饥。\n终日半瓢水，长年一衲衣。\n看人只自老，种树已成围。\n来往边城里，常愁白昼飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄姚氏昆仲","author":"释函可","text":"兄弟幽栖处，开门水一方。\n寻诗撑野艇，论易集空堂。\n白昼听蛙吹，青天数雁行。\n岭头三百树，好写寄穷荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄龚韩二子","author":"释函可","text":"平生无半面，祸患每过寻。\n乱肆两枯骨，枯桐一片心。\n道同顽处合，诗向酒中深。\n后夜相思处，开门月满林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿寒还","author":"释函可","text":"何物堪延岁，携将数卷书。\n到门惟有雪，浮海已无桴。\n饥渴三仙字，乾坤一老儒。\n蓬莱如可至，或许曳长裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"左公往堡中有怀","author":"释函可","text":"未必长相见，初离叹索居。\n遥知兄及弟，只有泪如珠。\n踏雪寻诗句，循田得潦馀。\n归时属二子，亟为报僧庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和戴子堡中八咏 其一 北山","author":"释函可","text":"未到山中去，山中一片云。\n无心偏出岫，何事屡移文。\n白鹤犹闻怨，驯麋可与群。\n嵯峨千丈壁，不必勒前勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和戴子堡中八咏 其二 夹河","author":"释函可","text":"苦雨添新涨，怀人在水央。\n双浮天日月，一濯我肝肠。\n泡影流将去，閒愁荡更长。\n卜居应不远，谁与咏沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和戴子堡中八咏 其三 石人","author":"释函可","text":"见说衣冠古，投诗寄问频。\n我心曾匪石，尔貌可为人。\n萝月长相忆，山云乍许亲。\n最怜同伴者，一半是顽民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和戴子堡中八咏 其四 永兴寺","author":"释函可","text":"岂料穷边处，还馀旧宝坊。\n定多山下士，同礼法中王。\n白豕惊清磬，寒猿到画廊。\n他时携竹杖，应许借绳床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和戴子堡中八咏 其五 耕烟","author":"释函可","text":"啮雪固余分，犁云为汝怜。\n何须至寒食，时恐断炊烟。\n带雨将苗种，抛锄枕石眠。\n只愁痴梦里，又到御炉边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和戴子堡中八咏 其六 采蕨","author":"释函可","text":"采采山中蕨，无为席上珍。\n同甘辽海雪，难比故乡莼。\n到壑犹闻禁，盈筐未是贫。\n老僧知此味，好寄莫辞频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和戴子堡中八咏 其七 莲渚","author":"释函可","text":"污泥曾不染，隔浦递幽香。\n何用沾新露，犹然怯晓霜。\n愿生诸佛国，可集野人裳。\n旧社荒芜甚，池塘梦正长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和戴子堡中八咏 其八 观鱼","author":"释函可","text":"子岂知鱼乐，过河泣欲枯。\n未能忘浩荡，暂可免罾罛。\n夜静芦花白，天寒野艇孤。\n愿随风雨去，清梦到江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"看薪夷病","author":"释函可","text":"看看垂死病，悽怆泪沾巾。\n原罪吾居长，论贫尔作邻。\n天全无可否，药尚有君臣。\n莫畏泉台苦，冰河久已亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜薪夷病起","author":"释函可","text":"拚是沙埋骨，欣闻息已苏。\n一毡吞未尽，双眼泪将枯。\n又得吾良友，仍馀尔罪夫。\n从今知死易，镇日好相呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庭前孤雁四首 其一","author":"释函可","text":"缯缴满天地，空门亦有忧。\n暂依庭草宿，敢望渚芦游。\n梦想洲前侣，魂惊塞上秋。\n预愁霜雪苦，不得到罗浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庭前孤雁四首 其二","author":"释函可","text":"可是笼中物，高飞不自繇。\n鼎烹何足恨，纲解转添愁。\n独叫黄沙远，频行竹径幽。\n主人情意重，岂为稻粱谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庭前孤雁四首 其三","author":"释函可","text":"塞草青易白，堂阶日又曛。\n自存湖海志，聊共鹜鹅群。\n俯首随人语，凄声独我闻。\n旧行不可问，肠断万重云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庭前孤雁四首 其四","author":"释函可","text":"仰天如欲诉，侧首听鸣砧。\n影只月常照，力微风易侵。\n祸深曾作字，愁绝少知音。\n久矣云霄黯，何须寄上林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同陈子过新斋感赋","author":"释函可","text":"每过必终日，流离几弟兄。\n土床横茗椀，笑语杂书声。\n佛道尊衣马，天心宠甲兵。\n此时况此地，犹见主人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠邻翁","author":"释函可","text":"乞食固予分，频过亦自憎。\n如何君父子，偏欲饱孤僧。\n饭粳铜匙滑，参泉碧盏澄。\n只兹堪我老，况尔坐高朋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读顾与治书并见怀诗","author":"释函可","text":"一派江涛白，惊生塞上魂。\n乍疑惊瘦影，再读见啼痕。\n旧橐青衫尽，空庭老树存。\n相思频得句，好寄莫辞烦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孟贞寄书不至","author":"释函可","text":"老友偏思尔，容枯骨岸然。\n祇闻寄远字，不见到寒边。\n稚子应看长，空囊谁为怜。\n明春有归雁，莫惜写新篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洁之有志入山索赠","author":"释函可","text":"已知寒塞苦，爱上别峰间。\n挂钵青松古，安禅白石顽。\n尘何关只杖，乱亦到深山。\n未歇狂心在，溪流总不閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋后一日孤雁忽飞去四首 其一","author":"释函可","text":"荒寺聊藏迹，定知非久留。\n庶无鹰隼患，能免雪霜忧。\n矫首辞孤衲，高飞觅旧俦。\n江南兵未戢，珍重荻花洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋后一日孤雁忽飞去四首 其二","author":"释函可","text":"秋至尔先觉，空天翅独横。\n既同艰险过，亦有别离情。\n度塞宜高举，惊人莫浪鸣。\n罗浮如可到，愁绝是孤征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋后一日孤雁忽飞去四首 其三","author":"释函可","text":"本是伤弓羽，还愁罗网撄。\n虽无好处去，犹自惜馀生。\n梦警五更雨，身轻万里程。\n似怜相聚久，连叫两三声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋后一日孤雁忽飞去四首 其四","author":"释函可","text":"上林非夙昔，繫帛亦徒劳。\n尔去从飘泊，余心转郁陶。\n空庭添寂寂，中泽总嗷嗷。\n何日清江海，孤云许共翱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其一","author":"释函可","text":"草草四十载，乾坤一病身。\n腊深颜益厚，祸酷意无瞋。\n性命岂由我，饥寒常累人。\n西邻有二老，谈笑见天真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其二","author":"释函可","text":"西风吹破寺，泥佛坐何年。\n一雁起庭际，数声空唳天。\n远书谁可寄，饱食我方眠。\n禅律浑忘却，安能效磨砖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其三","author":"释函可","text":"世事看亦见，边城忽已秋。\n尘沙必在面，虮虱又缘头。\n欲笑从他笑，多愁总莫愁。\n所知居不远，来往尽风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其四","author":"释函可","text":"吁嗟复吁嗟，谁是无父母。\n守栅供庖厨，入林禦豺虎。\n得生亦暂时，尽死安足数。\n新眼看旧人，自然成粪土。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其五","author":"释函可","text":"盛衰自今昔，佛岂限中边。\n竿木随身戏，针锥任众贤。\n到山先数马，入室但分钱。\n亦有二三子，休嗟吾道邅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其六","author":"释函可","text":"辛苦法王子，深慈将奈何。\n肉残无足食，骨碎可重磨。\n大网嫌鱼漏，高林畏鸟多。\n不如魑与魅，犹自喜人过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其七","author":"释函可","text":"瘦日射枯杨，荒荒欲断肠。\n老狐来瞰室，饿虎易过墙。\n岂为高明误，空遭纸笔殃。\n南中有义士，风雨每同床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其八","author":"释函可","text":"此地暑易尽，家家闻捣衣。\n拽车水牯瘦，击鼓鬼娘肥。\n风景连年是，人情半刻非。\n老僧惟一钵，每日饱方归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其九","author":"释函可","text":"白日只斯须，频年乞海隅。\n罪多识命贱，书到益身孤。\n秉拂寻顽石，题诗答腐儒。\n明知乡国没，仍梦到西湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其十","author":"释函可","text":"北里有遗老，寻诗尚未还。\n定知题落叶，随意到空山。\n白昼全无韵，棋枰久已閒。\n好携秋爽色，一洒户庭间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其十一","author":"释函可","text":"白鹤亦有泪，悲凉与世同。\n要从今日事，稍见古人风。\n笛里声初断，囊中药屡空。\n只留天一线，呼吸可能通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其十二","author":"释函可","text":"侧立向空荒，风吹恨愈长。\n文章宜溷厕，牛骥共禅房。\n不识梅花白，惟誇麦子黄。\n秋来瓜独好，小摘齿牙香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其十三","author":"释函可","text":"老翁时问讯，不死近何如。\n梦里数竿竹，床头一卷书。\n为人终直率，对客怪粗疏。\n午后睡方足，行行过草庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其十四","author":"释函可","text":"可惜团团月，还来绝塞明。\n照人幽近死，到地自无声。\n孤雁忽然过，远钟何处鸣。\n岭南应更苦，夜夜落荒城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其十五","author":"释函可","text":"卫霍名何减，山头旧札营。\n乍闻吹落叶，犹似走残兵。\n原草缠幽恨，河流带哭声。\n最愁秋雨后，燐火向人明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其十六","author":"释函可","text":"未到秋风起，先令破衲寒。\n但拚身一掷，久与世无干。\n日月看倏去，林泉到处残。\n如何昨夜梦，颗颗荔枝丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其十七","author":"释函可","text":"几载望乡信，音来却畏真。\n举家数百口，一弟独为人。\n地下反相聚，天涯孰与邻。\n晚风连蟋蟀，木佛共含辛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其十八","author":"释函可","text":"佛命亦如线，西方有剩莲。\n贝翻成大贾，笙吹比神仙。\n弟子黄金贵，弓裘白日鲜。\n雷同吾岂敢，只合抱沙眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其十九","author":"释函可","text":"沙坡台下土，春老草难生。\n行路践心髓，游魂怯旆旌。\n乌贪天养子，狐拜月成精。\n当日无贫富，锋刀不世情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"沈阳杂诗二十首 其二十","author":"释函可","text":"天地不可必，春风或度关。\n阴山一半揖，遗老共生还。\n杖指乌衣巷，船归黄木湾。\n亲朋未尽鬼，恸哭后开颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦安仲叔","author":"释函可","text":"昨夜分明见，长须叔不痴。\n衣冠非此日，言笑尚前时。\n纵死心方寸，平生酒一卮。\n只愁关路黑，来往得无疲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦蚊","author":"释函可","text":"白日难容汝，群飞欲蔽天。\n愁人频得句，终夜不成眠。\n饿极筋先露，刑馀血尚鲜。\n关东风景异，只此似江边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游七岭寺","author":"释函可","text":"何必入山去，到来非世间。\n巢松孤鹤冷，补衲几僧閒。\n钟磬留清范，岚烟护旧关。\n一溪冰渐解，流水已潺潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留龙泉静室","author":"释函可","text":"入山如数日，又是一春残。\n花信何曾到，松风依旧寒。\n野禽时缱绻，孤月共盘桓。\n始觉边关外，犹然天地宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题易修静室","author":"释函可","text":"虽在名蓝内，孤栖别一枝。\n身贫客自少，地僻病相宜。\n定有云分榻，时烦月照眉。\n我来应不拒，煮雪共疗饥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李公冬日成茆屋四首用韵 其一","author":"释函可","text":"数椽聊自可，欹枕抱书眠。\n窗阔堪延月，茆疏好见天。\n残毡犹马革，点雪即花砖。\n野老频来过，床头起暮烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李公冬日成茆屋四首用韵 其二","author":"释函可","text":"不识长安乐，何如东海隅。\n夜寒闻鹤语，榻短学僧趺。\n兴至诗涂壁，饥来雪满盂。\n西邻迁客在，镇日待招呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李公冬日成茆屋四首用韵 其三","author":"释函可","text":"身閒居自僻，岂必在山阿。\n寒灸青藜火，行吟哨遍歌。\n诗能穷学士，酒亦病维摩。\n向晚西风急，何人著屐过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和李公冬日成茆屋四首用韵 其四","author":"释函可","text":"举世皆兵革，安居自朔庭。\n佛容参米汁，客与论棋经。\n衾薄风侵骨，心空月在扃。\n屡携孤杖去，带雪步荒坰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重和四首 其一","author":"释函可","text":"自是客来少，非关地独偏。\n残棋抛屋角，饥犬卧炉边。\n果赖邻儿送，诗凭野衲传。\n情知无喜事，鹊噪矮檐前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重和四首 其二","author":"释函可","text":"何事长边外，偏多鲁国儒。\n谈经偕野兽，卜筑近枯株。\n窗破残诗补，肌羸薄酒扶。\n不知寒夜梦，还上玉阶无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重和四首 其三","author":"释函可","text":"敝絮蒙头卧，霜风奈若何。\n虚庭迎木客，汲井煮桑鹅。\n适性此云足，容躯不在多。\n小僮存道意，袖手听长歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重和四首 其四","author":"释函可","text":"远碛留天地，无言雪一庭。\n正襟坐古哲，开户看沧溟。\n虎迹任来去，人情半醉醒。\n老僧应不厌，多病怯疏棂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠乐亭秀才","author":"释函可","text":"我苦不得去，君胡为独来。\n无家投大漠，设帐傍荒台。\n客意黄花后，书声白雪堆。\n相逢三两语，涕泪点残灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送苗鍊师入燕","author":"释函可","text":"白日君将去，黄垆我尚留。\n莫言朋友义，能免众生忧。\n残雪填沙碛，悲心满壑沟。\n何时垂鹤翅，尽驾入云游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠五千道者","author":"释函可","text":"只杖凄凄日，论乡独有君。\n辞家一万里，学道五千文。\n礼斗依丹阙，吹笙坐碧云。\n不堪询故老，清泪亦纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得耀寰札","author":"释函可","text":"相见亦常事，相离费苦思。\n翻怜三岁过，未了一生疑。\n函泪遥相寄，关心久已知。\n长安春梦好，犹自绕冰池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同陈子久坐候大翁回","author":"释函可","text":"稚子欢留坐，主人出未归。\n料应无别适，不过扣僧扉。\n时卷携将去，塞炉且共围。\n入门知有客，言笑尽馀晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大雨喜育子远访","author":"释函可","text":"相逢疑隔世，一别五经年。\n莫话乡关事，难禁风雨天。\n寻尸来万里，问道入重泉。\n拗折枯藤杖，沙寒且共眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":45633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]