[{"title":"竹染绿色","author":"徐渭","text":"我亦狂涂竹，翻飞水墨梢。\n不能将石绿，细写鹦哥毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对岸观崖大瀑","author":"徐渭","text":"瀑布挂江北，望者江南猜。\n雪花那不到，霹雳过江来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独钓寒江","author":"徐渭","text":"大海有鲸鱼，五岳其鼻额。\n任公钓不来，烦尔一丝雪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阅书者倚老树","author":"徐渭","text":"尔自作蠹鱼，我不阅一字。\n逢著好树根，抱著枕头睡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪景","author":"徐渭","text":"此际山阴道，啼惟有莫鸦。\n万山无寸碧，何处认梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鱼蟹","author":"徐渭","text":"夜窗宾主话，秋浦蟹鱼肥。\n配饮无钱买，思将画换归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杏燕子","author":"徐渭","text":"玉京红线断，樊素绛唇娇。\n好著鞦韆架，其如不解描。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"写竹答许口北年礼","author":"徐渭","text":"羹鲤稻粱餐，沈思欲答难。\n只裁残拜帖，写竹当春盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"写兰与仙华子","author":"徐渭","text":"仙华学杜诗，其词拙而古。\n如我写兰竹，无媚有清苦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"尖头麻蛰","author":"徐渭","text":"身轻宜歇草，头锐欲钻螺。\n正苦毛锥乏，如侬太软何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蒲桃","author":"徐渭","text":"闻道羌葡萄，家家用醅酒。\n老夫画笔渴，此时堪一斗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张氏别业八首 其一 乐志堂","author":"徐渭","text":"备言志所乐，何关堂与基。\n主人向我道，但看鸟悦枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张氏别业八首 其二 流霞阁","author":"徐渭","text":"阁中餐霞人，绝无烟火色。\n谁宰武陵鸡，来作渔郎食。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张氏别业八首 其三 竹坞","author":"徐渭","text":"题诗竹坞中，竹长时出垣。\n谁能将铁笔，一画牡丹园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张氏别业八首 其四 青莲岛","author":"徐渭","text":"小岛含巨浸，能滋化叶开。\n青莲大如许，跏坐几如来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张氏别业八首 其五 小若耶","author":"徐渭","text":"别沼分湖水，因名小若耶。\n水流有大小，却一样荷花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张氏别业八首 其六 芙渠径","author":"徐渭","text":"大堤绕芙渠，平铺三百步。\n谁云水中花，不甃陆行路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张氏别业八首 其七 浣花桥","author":"徐渭","text":"镜水及苧萝，相望不盈尺。\n郎家浣花桥，妾家浣纱石。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张氏别业八首 其八 水墨轩","author":"徐渭","text":"万顷茫茫处，开轩榻绛州。\n水光自湿研，不用汲池流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃叶渡 其一","author":"徐渭","text":"书中见桃叶，相忆如不死。\n今过桃叶渡，但见一条水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桃叶渡 其二","author":"徐渭","text":"忆渡桃叶时，绿杨娇粉面。\n丈水五石泥，好影照不见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"村家饮","author":"徐渭","text":"新竹巳成蛇尾，秋云乍起龙鳞。\n不雨空啼布谷，乘风且脱纱巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渔家图","author":"徐渭","text":"小练乳儿红袜，斜阳曝网黄芦。\n但得同心夜浦，不愿嫁与秋胡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"列子御风图","author":"徐渭","text":"旬馀身在遥空，一叶枝辞芳树。\n若教风歇青蘋，试问人归何处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吕山人","author":"徐渭","text":"西陵渡头秋水寒，年年岁岁走儒冠。\n不知天姥山中客，十载关门傲长官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":39386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龛山凯歌 其一","author":"徐渭","text":"县尉卑官禄米微，教辞黄绶著戎衣。\n贼中何事先寒胆，海上连年数破围。","collection":"明","notice":"","provenance":{"repo":