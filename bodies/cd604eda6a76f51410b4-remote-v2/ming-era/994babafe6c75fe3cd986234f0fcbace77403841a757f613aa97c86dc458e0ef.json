[{"title":"乾宁八景 其四 神堤烟柳","author":"张缙","text":"河防未就竟沉渊，谁识当年令尹贤。\n惟有春风祠下柳，翠眉长为锁寒烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11043,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乾宁八景 其五 丰台夕照","author":"张缙","text":"寂寞荒台夕照边，居人犹自说丰年。\n太平气象何曾减，禾黍芃芃满大田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11044,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乾宁八景 其六 洪寺晓钟","author":"张缙","text":"残月疏星曙渐分，华鲸乡处隔松云。\n旅途惊断行人梦，野店鸡声次第闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11045,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乾宁八景 其七 范桥古渡","author":"张缙","text":"雨歇飞虹影半天，微茫树树接村烟。\n孤身向晚人争渡，立近沙头语正喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11046,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乾宁八景 其八 龙祠神应","author":"张缙","text":"岁时奉祠不可违，栋宇辉煌照石矶。\n三尺甘霖随处是，满城士庶送龙归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11047,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"资圣寺重光井","author":"张岐","text":"石井荒凉古寺边，偶因凿翠得甘泉。\n断碑剥落埋衰草，犹记将军舍宅年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11048,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜泊流河","author":"刘铉","text":"静海南来百里过，驿亭官舫是流河。\n帆樯遥见悬灯日，时听烟中发棹歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11049,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送都宪张岐镇辽东","author":"吴节","text":"都宪东行镇大辽，手持丹诏下云霄。\n叮咛自觉龙颜近，蹀躞何知马色遥。\n剩有嘉谟同客算，全凭威望压天骄。\n胡尘近扫边疆静，快都鸣珂入圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11050,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"流河驿次韵","author":"谢省","text":"舟楫愁谁语，风波未自知。\n偶逢居共泊，恰与月相期。\n梦忆仙舟会，情忘客路悲。\n论诗意无极，一饮亦吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11051,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泊流河","author":"周正方","text":"乘月步流河，茅檐两岸多。\n归人犹待渡，栖鸟尚争柯。\n尘舆市喧息，风移帆影过。\n洞箫谁按曲，音韵若清和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11052,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚过静海宿流河驿","author":"谢铎","text":"落日风初静，交河水正流。\n居人不知姓，行客且停舟。\n青海鸟飞处，白云天尽头。\n相逢问前路，明日是沧州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11053,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送青县刘明府","author":"马中锡","text":"早春飞舄觐瑶京，又向都亭折柳行。\n天上已沾新岁宠，马头还问旧行程。\n到官桃李花初暖，在路风烟晓正晴。\n此别相逢定何日，依依云树独关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11054,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿流河驿遇宝庆谢太守","author":"李东阳","text":"仰止怀先达，相逢即旧知。\n别离曾有赠，舟楫本无期。\n细雨春灯暗，高歌暮角悲。\n从君问前路，江海得吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11055,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"流河驿怀谢宝庆先生兼怀鸣治侍讲","author":"李东阳","text":"林下春风迥绝尘，天涯旧路独伤神。\n长船载酒官河夜，芳草怀人楚水春。\n应学杜陵寻北郭，兼逢小阮作南邻。\n嗟予忝出皇华使，犹向河边咏伐轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11056,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"流河驿","author":"张旭","text":"流河流不尽，风景望中赊。\n冀北路千里，江南天一涯。\n书沉云外鹤，春老雨中花。\n欲拨穷途闷，凭酒问谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11057,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"兴济阻风速沈方伯时畅饮","author":"王鏊","text":"彻夜阴风河欲冻，扁舟牢碇古河滨。\n南飞坐羡帆归疾，北上惟将梦去频。\n客路寒暄同是客，人生行止岂由人。\n蓬窗孤闷凭谁破，赖有江南曲米春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11058,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望青县","author":"储罐","text":"青县望不极，兼程尽日遥。\n衣从尘里化，春向客边生。\n野饭留荒寺，车吟过小桥。\n西山能慰客，返照故相撩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11059,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青县会别应韶","author":"储罐","text":"西来离思满征裘，拟共髯郎泛此舟。\n诗里刻期须七日，饭时移棹忽中流。\n水风笑语徘徊别，尘海襟期汗漫游。\n千里神交非异事，莫将青县比梁州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11060,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青县舟中对月怀应韶 其一","author":"储罐","text":"潞河依旧向东流，曾共髯郎十里舟。\n何处不看今夜月，关山偏解忆洮州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11061,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青县舟中对月怀应韶 其二","author":"储罐","text":"舟稳湖平睡思深，微茫烟月到天津。\n平生不识秦川路，梦里何由见故人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11062,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乾宁驿","author":"周伦","text":"驿楼风劲卷尘沙，天上楼船向海涯。\n北望官河潮正长，片帆拖影夕阳斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11063,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题兴济张氏累荣册","author":"鲁铎","text":"懿亲昭代托椒房，共说儒家世泽长。\n九有山河光地道，万年历数在天潢。\n冀方泰运缘尧母，周室才难重邑姜。\n戚里候门霄汉上，春风依旧作书香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11064,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"流河驿登舟","author":"何孟春","text":"半村鸡犬驿楼偏，芳树轻阴憩午船。\n林屋燕穿花下雨，篷窗人坐水中天。\n痴儿书簿还多事，老子江湖本夙缘。\n寒渌一㪺堪醉古，愧无佳句托吟笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11065,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"兴济夜泊","author":"史杰","text":"画舫依官渡，天空暮霭收。\n远钟城外寺，近火水边楼。\n暝色连村暗，波光带月流。\n谁将桓氏笛，吹起古今愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11066,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿青县公署","author":"林春泽","text":"江亭寒色净，夜榻水光连。\n远意青山外，孤心白月前。\n生涯真泛梗，客路又穷年。\n深坐烧官烛，闻鸡独不眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11067,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚次流河驿","author":"朱豹","text":"帆飞来远浦，棹舣临荒驿。\n荡荡风起波，昏昏日沉夕。\n钟鸣山寺杳，鸟宿沙汀白。\n亲舍尚迢遥，挑灯未眠客。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11068,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青县别二叔父","author":"汪应轸","text":"浮萍骨肉各天涯，小县孤舟共渚花。\n久别故园浑似梦，偶逢官舍恍疑家。\n婴儿几月牙差长，弟妹三年发并髽。\n何日尘缨同接去，竹林泉石卧烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11069,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青县公馆","author":"夏言","text":"驻节濒江馆，微茫海国连。\n案前飞水鸟，墙角度风帆。\n打鼓闻何郡，挑灯忆往年。\n梦逢明月夕，独坐未须眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11070,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青牛行赠兴济孙封君","author":"邵经邦","text":"南极老人君莫攀，东皇木公畴与班。\n谁人貌得果下叟，青瞳白发酡朱颜。\n鸿胪大人思邈裔，庞基先白孙敖世。\n金殿连姻钟鼎家，玉房通藉椒兰第。\n凤毛麟角斗芳菲，琼枝玉树相交辉。\n燕山灵椿窦氏老，函谷青牛柱下归。\n五千道德闲胸臆，七十寻常皆自得。\n长生久视固有常，善言知足无瑕贼。\n豪华岂足为翁多，盖公清净师参何。\n皇之无他玄与默，会见千世万世人颂青牛歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11071,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青县晓发","author":"浦瑾","text":"垂柳迷归路，飞花引去舟。\n叠峰山错峙，曲岸水回流。\n凫岸晴方举，鱼龙暖欲浮。\n身随吾道在，此外复何谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11072,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"流河纪兴","author":"皇甫涍","text":"凉飙涤残暑，沿岸绿阴多。\n秋色生远海，浮云空九河。\n蝉声杂鸣籁，凫影乱繁波。\n我怀方浩旷，临觞酬短歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11073,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"立秋前二日流河驿作","author":"皇甫涍","text":"流河驿下未逢秋，那堪坠叶似行舟。\n宵窗乍见明波影，蘋末风来客倍愁。\n燕南气殊物候改，叹我驱驰独未休。\n他乡岁月忽易度，故山芳杜空悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11074,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过兴济寺作","author":"皇甫汸","text":"璇宫玉宇先皇赐，福地名都淑女乡。\n一自经营传内史，至今供奉礼空王。\n论恩实冠昭阳里，问水虚疑妫汭旁。\n载过倚舟回落日，暝烟行望柏苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11075,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"虫灾诗","author":"刘迁","text":"夙夜徵车发，侵晓近田庐。\n举手问田夫，今岁田何如？\n田夫前致语，虫食已无余。\n嗟我同妇子，黾勉事新畬。\n三月谷方贵，不食种污菹。\n五月常挥汗，称贷自耘锄。\n七月禾苗起，穰穰望满车。\n忽遭此虫食，昔望今已虚。\n何以供赋税，何以为糇糈？\n妻孥恐不保，谁能守归闾？\n凄凉语不绝，策马入邱墟。\n谷叶尽委地，惟有穗疏疏。\n虫食犹不已，蔓延及草苴。\n无能畀炎火，捉虫强吞诸。\n与其害民命，无宁且食余。\n田夫视亦叹，与之共欷歔。\n殷勤嘱田夫，莫为秋作沮。\n露白已八月，虫死金风嘘。\n努力崇勤俭，糗饭更草茹。\n藨蓘有丰年，不必苦踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11076,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏陈叔阳际槎轩","author":"刘迁","text":"陈生生平好古书，日手一编坐庭除。\n八索九丘披未艾，海内人称老蠹鱼。\n陈生生平怀素心，素心耿耿托孤琴。\n时开绿绮鼓雅操，冷热高飞太古音。\n谢却烦尘爱漱盥，诛茆结屋临河畔。\n沧波澄澄芙蓉鲜，鸥鹭翩翩云影乱。\n孤清厌世作蜉蝣，日日河边看水流。\n安得仙槎傍精舍，我亦乘之过斗牛。\n非兰非蕙香欲浮，不日不夜光盈眸。\n天孙衣我凤文锦，列仙骑我双龙驺。\n丹砂玉屑作珍馐，琼台宝树恣遨游。\n忽忘人间乐马忧，一任尘寰春与秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11077,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏陈叔阳际槎轩二首 其一","author":"王嘉言","text":"名因诗赋垂，家在薜萝丛。\n茅屋千帆过，星槎一水通。\n烟含堤柳翠，波映夕阳红。\n堪比扬雄宅，爰清爰静同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11078,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏陈叔阳际槎轩二首 其二","author":"王嘉言","text":"地僻车尘远，家贫人事稀。\n一轩清且朴，万舸去还归。\n尽日看垂钓，明时尚采薇。\n多君怜墨客，未厌款柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11079,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题阙","author":"林应亮","text":"驿路近津桥，星河接海遥。\n露塘风折苇，沙屿月平潮。\n远火渡头急，疏钟湖外飘。\n那堪凄凉夕，凉景入寒条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11080,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泊舟青县馆赋天外帆一篇","author":"尹耕","text":"天外帆，何翩翩，海鸥沙鹄同流连。\n晴空弄影水花乱，阴昼缚风地轴旋。\n蜀缆吴樯几千里，上濑鸣滩自邻比。\n官网横被垂天云，私艇斜行贫市第。\n官网私艇日来往，为问南风今几两？\n得时真不羡鸿毛，失势终需赖橹桨。\n芦台小邑障江侧，作馆临江阚江色。\n月华渐上箫鼓停，帆集西皋森列戟。\n我来待月升其堂，千旌宛在堂东墙。\n侵晓悠悠自来去，画图何减悬潇湘。\n画图可羡亦可叹，世事人情几更换。\n岸头历历百丈夫，终岁无衣月无粲。\n已牵军器重如山，更放冰鲜疾似弹。\n庙堂尽是舟楫才，谁向江干念荒旱？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11081,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜泊流河驿","author":"于玭","text":"流河滩头夜不寐，海风江雾旅魂惊。\n洪涛漭沆鱼龙影，野戍荒凉豺虎声。\n客路此生浑未了，乡关愁绪迥难平。\n可怜萝月还相照，明发前舟问水程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11082,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青县官舍","author":"冯惟敏","text":"墙断涨沙沉，檐低息土侵。\n洪河流廨下，老树覆成荫。\n北地来文舫，南薰爽客襟。\n长安那复近，去马日骎骎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11083,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次兴济感事留示冯云亭时方不理于口","author":"冯惟敏","text":"归骑迷荒渡，空城枕浊河。\n官闲公吏少，邑小弊民多。\n一叹一回老，三年三度过。\n冯唐吾与汝，勋业近如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11084,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次流河","author":"周天佐","text":"夜泊长流下，西风拂岸初。\n潇潇他树雨，落落此村居。\n柝报山更远，窗涵海月虚。\n农谈萑苇里，秋事竟何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11085,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"流河驿","author":"孟思","text":"帆落风初定，深更泊野滩。\n乡村多是盗，州县若无官。\n水响知鱼跃，潮平觉岸宽。\n中宵愁不寐，天外数星残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11086,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渡青县河二首 其一","author":"朱长春","text":"晨朝渡河冰，飞雪没马足。\n季冬群象晦，天气廓平陆。\n四望无行人，狐兔走且伏。\n宿莽既以稀，安见林与屋。\n俯仰以茫茫，远驾和所属。\n行行仆夫啼，我马伤踯躅。\n北地多苦寒，天道方杀戮。\n所遇物尽残，谁不忧行役。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11087,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渡青县河二首 其二","author":"朱长春","text":"浮云东北驰，遥见晨风征。\n我行日以迈，忧思日以横。\n游子往于役，妻妾寄空城。\n虽无燕婉恋，骨肉有至情。\n谁云不顾私，班马有离声。\n飞雪蔽修岗，北风惨正深。\n停车立望远，泪落如雾淫。\n自古别离人，不见行路心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11088,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"流河道中","author":"吴维岳","text":"垂绶出都门，经旬傍水村。\n新蝉风乍应，高树荫初繁。\n月与飞帆伴，津无候吏存。\n讵知行路里，翻得一逃喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11089,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渡滹沱","author":"李攀龙","text":"滹沱来不极，晓色荡孤城。\n击楫中流过，褰帷下吏情。\n天衔纡岸转，日上大波行。\n独在知津后，风尘见濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11090,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"子与自芦台量移瑞州 其一","author":"李攀龙","text":"题坐高名汉署来，鱼盐小吏混芦台。\n谁怜汝海分符客，自是南皮作赋才。\n老骥霜蹄千里动，佩刀寒色九河开。\n量移休道非知遇，难得君恩一日回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11091,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"子与自芦台量移瑞州 其二","author":"李攀龙","text":"遥传雨露一时新，不负漂零恋主身。\n高卧中原堪有客，雄飞尔辈可无人。\n屏星色动双龙曙，锦水光分五马春。\n诗兴宦情堪并美，南州孺子况为邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11092,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜泊兴济有感外戚张氏故居之地","author":"万士和","text":"恩泽当年冠列侯，只今安在水东流。\n始知热处为投井，谁戒权门是覆舟。\n朝槿发华难到夕，井梧落叶早知秋。\n荣枯本是寻常事，清夜无端莫起愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11093,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日登芦台怀于鳞元美兄弟明卿诸君子二首 其一","author":"徐中行","text":"秋高葭菼大河回，病起层楼雨色开。\n沧海白云陪下榻，中原落日见停杯。\n一官已负陶潜兴，九辩谁怜宋玉才。\n因忆吾侪燕市里，每逢佳节便登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11094,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日登芦台怀于鳞元美兄弟明卿诸君子二首 其二","author":"徐中行","text":"孤城摇落气悲哉，斥卤黄花也自开。\n万里乡心随去雁，九河秋色起登台。\n自怜蓬鬓风尘老，犹忆萸囊汉署来。\n此日衔杯谁不念，飘零天地转堪哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11095,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李缺斋","author":"唐禹","text":"高士岗头晓日晴，峭帆亭下春风生。\n日曛云影潭光丽，风约池芹水气清。\n隐几静馀南国梦，看碑深有岘山情。\n百年古调还朱瑟，桃李无言满洛城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11096,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望海潮 兴济道中","author":"周思兼","text":"苍山烟暝，碧波云淡，画船闲舣蘋洲。\n人坐镜中，棹停天上，扣舷浩发新讴。\n斜日水西头，正莺寻芳树，燕绕红楼。\n谁整雕鞍，拂衣将去更淹留。\n春风旧日遨游，曾雾迷兰枻，雨滞棠舟。\n须信当年，五陵年少，争夸肥马轻裘。\n欲语且还休，问谁家庭院，深锁清秋。\n杨柳无情，也低眉黛助人愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11097,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"念奴娇 青县渡口","author":"周思兼","text":"早春和煦，正宝鞍争道，雕轩盈路。\n远近轻雷喧紫陌，尘暗垂杨古渡。\n一叶扁舟，半篙新水，便凌风轻度。\n光涵云影，数行鸿雁归去。\n回首两岸云填，马嘶人语，况青楼日暮。\n海宇无风波不动，遥望高帆行处。\n缓带轻裘，葛巾道履，有良朋三五。\n江津徐步，夜深重会逆旅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11098,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀故兴济令许伯玉","author":"方逢时","text":"客子赋皇华，乘流泛斗槎。\n暝烟浮远树，凉月动虚沙。\n仙令怀潘岳，尘踪愧孟嘉。\n何人夜吹笛，遗恨满天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11099,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"流河步月","author":"袁表","text":"明月照河洲，露气闻芳草。\n幽村二三家，农事春方好。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11100,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"流河驿晚眺","author":"吴国伦","text":"日落湖光隐，沙寒雨气侵。\n长天送远目，去鸟促归心。\n枫叶早霜下，芙蓉秋水深。\n贾帆飞树杪，渔网集亭阴。\n鸥狎中流楫，鸦栖隔浦林。\n凉飙起高树，一为爽凡襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11101,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青县道中同于明府忧旱","author":"许言诗","text":"千门望雨雨微茫，百丈飞埃接帝乡。\n惆怅马兰当径萎，摧残杨柳对人苍。\n太行日落孤云散，朔漠风光五月凉。\n幸有同官于定国，时艰欲济话联床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11102,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青县堤上别方蕴璋","author":"赵用贤","text":"怜君此别手重携，散发长堤日又西。\n钟鼓千官愁驻马，星辰一夜暗燃藜。\n因风柳絮沾沾起，出浦云帆片片低。\n东道若逢杨得意，可能相对访幽栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11103,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"流河驿","author":"王稚登","text":"青草不生地，黄河空接天。\n香醪供使者，系缆驿门前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11104,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"锦堂春 流河驿送郭黄二春元北试，调得锦堂春","author":"瞿汝稷","text":"共恼河水情薄，教侬不到瑶京。\n却因冰阻逢双璧，情厚是河冰。\n旅次因君忘旅，吾行吾欲沾缨。\n曲江春后逢酒胜，莫更惜君行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":11105,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]