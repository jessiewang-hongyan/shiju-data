[{"title":"送同年朱佥宪骥之广西","author":"韩雍","text":"青年雅望冠中台，荷宠归宁亦快哉。\n亲舍暂分游子去，蛮邦久迓使君来。\n林深丹桂行双节，野近苍梧奠一杯。\n道路逢人莫长叹，庙堂方拣栋梁才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41129,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送同年杨主事益苏松蹈勘旱灾事竣还京意有所讽","author":"韩雍","text":"传得纶音自帝都，东南凋瘵顿然苏。\n忧勤已辩崔峣树，忠节还陈郑侠图。\n满路欢声喧鼓吹，逼人清气湛冰壶。\n回辕莫向关河滞，延伫方期赞大谟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41130,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题寿星庆琴川松溪陈宗盛乃尊竹轩翁","author":"韩雍","text":"小春望日启华筵，初度逢君寿福全。\n花甲数周才过一，椿龄算永定逾千。\n雨滋轩竹枝方盛，霜老溪松节愈坚。\n昨夜行台悬北望，狐南星彩照琴川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41131,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"辛卯午日小宴追忆先朝苏颋人日应制韵录似游击从事诸君","author":"韩雍","text":"午节随銮曾几回，六龙亲御五华台。\n惊看羽骑绯衣度，细睹天颜宝扇开。\n朝退声移苍玉佩，步归心醉紫霞杯。\n金舆一去无消息，此日重逢百感来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41132,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"正月十九日寄弋阳李少卿三首 其一","author":"韩雍","text":"远道輶车日日牵，羡君踪迹似神仙。\n白云万顷陪深隐，红日三竿任晏眠。\n绕座埙篪声迭和，满堂绣綵业相传。\n菲才亦有山林志，未报君恩空怅然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41133,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"正月十九日寄弋阳李少卿三首 其二","author":"韩雍","text":"功成不被利名牵，人慕高风迈谪仙。\n松径昼开教鹤舞，桑林春老看蚕眠。\n一生勋业三朝录，千古文章四海传。\n愧我同心不同迹，弋山东望思悠然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41134,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"正月十九日寄弋阳李少卿三首 其三","author":"韩雍","text":"情绪游丝袅袅牵，错教人望似登仙。\n关山道远何时歇，风雨衾寒到处眠。\n乡梦却嫌鸡唤醒，客愁偏厌漏声传。\n知君此夜浑无此，高拥青绫足宴然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41135,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠李少卿兄渔隐先生二首 其一","author":"韩雍","text":"高卧烟霞一布衣，平生踪迹似君稀。\n邑门无事不曾到，乡社有情常醉归。\n荷斧斫来林笋嫩，引泉灌得药苗肥。\n山中修养年年好，焉得相从便息机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41136,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠李少卿兄渔隐先生二首 其二","author":"韩雍","text":"松花为食草为衣，养道延年过古稀。\n留客必须春色去，登山常伴月明归。\n偏怜野水群鸥好，不羡侯门驷马肥。\n更喜追陪有难弟，晚年投老最知机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41137,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同李少卿游龟峰寺次其韵二首 其一","author":"韩雍","text":"系却兰舟弋水滨，乱云堆里访山门。\n年深古柏多仍在，春后残梅半不存。\n燕尾溪流斜断岸，羊肠路绕曲通村。\n徘徊更爱群峰好，一洗平生两目昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41138,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同李少卿游龟峰寺次其韵二首 其二","author":"韩雍","text":"洞天深处远江滨，路入烟霞是洞门。\n环座好峰千状出，满潭清溜四时存。\n曾磨厓石疑元结，欲咏梅花愧后村。\n搔首何堪自东望，亲闱久矣旷晨昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41139,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送杨宪副宜之广东","author":"韩雍","text":"持节南巡久擅名，拜官重去副群情。\n五羊城下新恩至，驷马车前故吏迎。\n青草瘴消风渐转，黄梅雨歇日初明。\n台端见我同寅旧，为道相思远寄声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41140,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送松江黄郎中琮广西审刑竣事还京","author":"韩雍","text":"持节平反遵圣谟，远人处处动欢呼。\n波吞瘴海穷鳞起，风转炎荒腐草苏。\n归路总誇空薏苡，过乡莫待饱莼鲈。\n好思南顾忧民切，早献当年郑侠图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41141,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王府丞弼起服之京","author":"韩雍","text":"垄树啼残谢豹声，麻衣人换锦衣行。\n连天水上春帆度，捧日云边晓佩鸣。\n京郡齐民怀父母，庙廊虚位选公卿。\n知君此去应遭遇，好罄丹心佐太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41142,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西轩诗为泰和萧孟廉题少师孟勤先生兄也","author":"韩雍","text":"筑得高轩配颖滨，轩中人物异常伦。\n一生义气甘韦布，四海清风动缙绅。\n柱倚残阳吟到景，帘钩新月醉芳辰。\n武山遥背还多趣，太史文章已具陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41143,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题松泉图寿大司寇杨公","author":"韩雍","text":"涧畔孤松涧下泉，清流高节自年年。\n飞空作雨流偏急，向晚凌霜节愈坚。\n一派源源方赴海，千寻郁郁定参天。\n苍生膏泽明堂栋，都望君家祝寿筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41144,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题松鹤寿渔乐陈先生","author":"韩雍","text":"鸡群独立昂藏鹤，涧畔孤撑偃蹇松。\n声动九皋风露夜，节凌三径雪霜冬。\n顶深丹后色应变，脂化苓时阴更浓。\n长岁云林有馀庆，桑轩还进大夫封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41145,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈御史述审刑事竣还京","author":"韩雍","text":"南浦楼前鼓角鸣，朝天人着绣衣行。\n晴波浩荡鱼龙舞，迟日光华草木荣。\n一载平反无愧色，千年遗爱有贤声。\n同乡未得同归去，目送征帆过葑城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41146,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"裕轩为乡人徐文辉题","author":"韩雍","text":"最爱高轩境界幽，轩中人物异常流。\n丰标秀倚灵岩晓，雅量宏吞震泽秋。\n万顷烟霞吟不尽，四时风月醉还留。\n何当拂袖归山去，过此陪君日唱酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41147,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"午日寄杨司寇诗","author":"韩雍","text":"陪观竞渡倚高楼，冉冉流光又六秋。\n为客到今空自感，何人来此可同游。\n蒲觞满引终难醉，萧鼓喧闻未破愁。\n聊写新诗寄知己，江东云树重回头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41148,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宁波周御史父母双挽","author":"韩雍","text":"士行无亏女德充，笃生佳器见登庸。\n人誇偕老同观化，帝念齐贤并锡封。\n七尺冢棺埋对玉，一抔新土种双松。\n幽光更有铭文发，长夜神游总笑容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41149,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿东山寺和九川李少卿韵","author":"韩雍","text":"山可闲登水可临，禅家胜景动长吟。\n水花初摘香移沼，山木渐除风满林。\n海内有人愁盛暑，云中无路散清阴。\n相逢最感频相勉，报国终期罄赤心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41150,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"景泰丙子六月十七日便道与大理少卿弋阳李公游上清明日游仙岩皆赋七言近体诗一章书之翛然亭 其一","author":"韩雍","text":"九载名山五度过，山容霭霭势峨峨。\n洞穿海外飞仙岛，水接天中织女河。\n白鹤盘风秋气近，紫箫吹月夜凉多。\n宦情也动幽栖念，可奈深恩未报何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41151,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"景泰丙子六月十七日便道与大理少卿弋阳李公游上清明日游仙岩皆赋七言近体诗一章书之翛然亭 其二","author":"韩雍","text":"扁舟览胜故人同，胜境分明似画中。\n阴洞满厓无路到，晴岩一窍与天通。\n留传剩见神仙迹，开辟冥思造化功。\n我有乡山归未得，不堪回首白云东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41152,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重游临川疏山寺次旧韵留题","author":"韩雍","text":"一点丹心万斛愁，登山消遣记重游。\n满怀冰雪空三伏，屈指光阴近八秋。\n海内未瞻云气合，天中渐见火星流。\n清风凉雨苏炎旱，我为苍生叩蓐收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41153,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送南城贡士左赞再赴春闱","author":"韩雍","text":"笔阵词锋六馆推，南宫两战未登魁。\n何蕃再省名逾重，维翰重升志不灰。\n飞鹢秋分滕阁雨，化龙春听禹门雷。\n太平桥上乡人众，望尔高车驷马回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41154,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄乡友徐文辉","author":"韩雍","text":"家林幽僻远尘阛，世事浮沉总不关。\n下榻有时延上客，东楼终日望西山。\n醉乡风月情偏好，静里乾坤意自閒。\n独我相思未相见，海天云树锁愁颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41155,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"延常山杨医师炙火诗以酬之","author":"韩雍","text":"浙水西头积庆堂，堂中人物异寻常。\n轩岐妙术传三世，泰华高名动四方。\n丹火暖时薰艾剂，橘泉清处淬针芒。\n相逢莫厌频频疗，海内苍生多病伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41156,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张式之佥都致政既归四明以诗寄予依韵奉酬","author":"韩雍","text":"社稷功成归鉴湖，卧龙踪迹孰能屠。\n自怜投老入佳境，应笑时人行畏途。\n鸣世有声惊墨客，平蛮无愧忆征夫。\n烦君谩赴耆英会，恐有徵书出帝都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41157,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽宁波王司空母张夫人","author":"韩雍","text":"高寿荣恩享北堂，平生德善总非常。\n花封遗爱思贤助，柏府传声颂义方。\n瑶水夜深仙乐动，家园春静板舆荒。\n牛眠冈上新埋玉，多少行人起赞扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41158,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄嘉兴延太守同年","author":"韩雍","text":"共羡嘉兴太守贤，清风善政路人传。\n连城白璧无瑕玷，合郡苍生解倒悬。\n西浙分襟惊数载，南州回首忆同年。\n烦君此去尤珍重，莫让龚黄美自专。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41159,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题湖口上钟岩寺","author":"韩雍","text":"上方风景最清幽，驻却双旌试一游。\n绝壁有岩皆起阁，归僧无路只乘舟。\n天垂庐岳擎孤柱，湖落湘江界合流。\n翘首不堪东北望，思乡又感庙堂忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41160,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李咸章贤良奉使还京 其一","author":"韩雍","text":"相门有客清如玉，圣世徵贤喜得人。\n岭海一麾宣宠命，乡园五彩慰慈亲。\n星河夜静仙槎稳，江月秋高素练新。\n去去青春莫虚负，丈夫功业在经纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41161,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李咸章贤良奉使还京 其二","author":"韩雍","text":"白云飞送上青云，仙子才华信不群。\n双璧已生烟自润，九苞初振锦成文。\n从来豪杰多名世，此去勋劳在致君。\n廊庙忧民如见问，博施无计愧忠勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41162,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同弋阳李少卿宿莲塘寺次古诗韵 其一","author":"韩雍","text":"小小禅房似画船，连床风雨拥寒毡。\n几年受任惭无补，千里论交幸有缘。\n松径云深迷晚鹤，槐庭霜重断秋蝉。\n留题最羡文章伯，嬴得芳名后世传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41163,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同弋阳李少卿宿莲塘寺次古诗韵 其二","author":"韩雍","text":"山寺岧峣倚碧峰，偶来假榻快心胸。\n行营漏起三吹角，古殿香然一扣钟。\n故旧情深欢会合，圣明恩重幸遭逢。\n素餐却念农家苦，烟火东林尚夕舂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41164,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿詹事府唐录事先生","author":"韩雍","text":"经纬文章海内传，才名不数两疏贤。\n青宫初喜承三接，紫诰行看拜九迁。\n墨色帐前罗士子，蟠桃花底醉神仙。\n佳辰不预长生会，山斗遥瞻祝寿筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41165,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送佥都御史余公奉使还京 其一","author":"韩雍","text":"久司风纪位都堂，近拜天恩使故乡。\n玉斧飞霜无玷缺，锦衣行昼有辉光。\n思家梦叶才温席，恋阙情悬又促装。\n奈我同心不同迹，五云翘首思茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41166,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送佥都御史余公奉使还京 其二","author":"韩雍","text":"夜雨西窗始盍簪，春风南浦又分襟。\n论交久契芝兰味，图报相期铁石心。\n桃浪一江行色壮，锦云千里故情深。\n君才自是人中杰，入相行看拜玉音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41167,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送佥都御史余公奉使还京 其三","author":"韩雍","text":"水满春江燕子飞，喧天鼓吹送君归。\n许身报国今谁并，持节还乡古亦稀。\n龙虎风云欣际会，山光草木剩光辉。\n相思后夜瞻霄汉，执法星芒耀太微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41168,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送佥都御史余公奉使还京 其四","author":"韩雍","text":"酒罢西江第一楼，还朝人物异常流。\n作官最重乡邦羡，奉使能分社稷忧。\n此去横班须独对，遥知前席定三留。\n好将民隐条陈尽，为报皇情宠眷优。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41169,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿徐裕轩诗","author":"韩雍","text":"玉雪风姿照美髯，太平初度乐无边。\n天开令节才三日，人祝遐龄又一年。\n自古中原有麟凤，于今平地见神仙。\n知君已得长生术，岁岁歌诗庆寿筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41170,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送胡共之参政赴广东","author":"韩雍","text":"江头樽酒话襟期，君欲南征我北驰。\n十载交游恒间阔，一时相见又分离。\n海天绿树春云望，台阁清灯夜雨思。\n此后重逢问何日，鹍鹏应不久藩篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41171,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清明谒三陵道宿僧寺次姚亚卿韵二首 其一","author":"韩雍","text":"东行联辔扣禅关，楼阁孤撑返照间。\n抚景渐看三月近，寻芳聊趁一时閒。\n风翻冻柳莺声怯，云薄空山雨意悭。\n何事匆匆不遑乐，九重咫尺是天颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41172,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清明谒三陵道宿僧寺次姚亚卿韵二首 其二","author":"韩雍","text":"多年荒寺枕山肩，人厌萧条我独怜。\n市语不喧春鸟哢，梵音初动晚香然。\n数杯浊酒催诗饮，一榻清风伴月眠。\n翘首不堪心事切，红云高处白云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41173,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽刘司寇广衡","author":"韩雍","text":"高步云霄近上台，司刑司宪展多才。\n调元未副苍生望，观化何堪白发催。\n双履无声趋晓禁，五花有迹在秋台。\n东风执绋都门道，目断天南不尽哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41174,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠璇上人南归","author":"韩雍","text":"脱却尘凡守寂寥，远公门下特高标。\n锡飞已占吴山胜，杯度何妨楚水遥。\n南垄蘋蘩春自荐，北堂甘旨昼亲调。\n怜君独遂还乡愿，梦绕江天恨未消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41175,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送叶佥都与中巡抚两广","author":"韩雍","text":"东山强起副皇情，荣拜都堂暂远行。\n重寄一麾兼两镇，先声万里慰群生。\n风恬沧海鲸波净，雨洗黄尘鸟道清。\n自古安边重韩范，终归黄阁佐承平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41176,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽刘詹事宗器","author":"韩雍","text":"词林璧水久蜚英，晚辅春宫重老成。\n操履一生行古道，文章千载占时名。\n调元未见登黄阁，观化俄闻上玉京。\n惆怅东风招不起，懒挥铁笔写乡评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41177,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"松轩为陈詹事安简乃弟题","author":"韩雍","text":"双树亭亭荫荜门，隐君难与世人论。\n七松处士遗风在，五柳先生旧业存。\n洗耳静闻清籁响，科头坐爱碧云屯。\n休徵已叶难兄梦，位接三台拜宠恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41178,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张进士养病回苏州","author":"韩雍","text":"琼林深处正翱翔，忽拜殊恩望故乡。\n桃叶波平归棹稳，柳花风细赐衣香。\n参苓调养回元气，甘旨欢娱慰断肠。\n独我分携重惆怅，海天翘首白云翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41179,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"高邮吴司训升原武教谕乡人也诗以送之","author":"韩雍","text":"手栽桃李满盂城，献绩金门荷宠荣。\n百里儒官司教化，一方人物赖陶成。\n研朱点易芹香暖，捲幔观澜雨气清。\n此去休言官独冷，显扬还儗振家声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41180,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽佥都御史左周器","author":"韩雍","text":"为民为国一生心，晚进中台感激深。\n明主有恩方倚重，怜君无命忽销沉。\n斗山光价流中外，墓道铭章耀古今。\n我有深情招不起，禾川南望引长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41181,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽国子邹检讨","author":"韩雍","text":"栽成桃李满皇都，懒逐风尘走宦途。\n林下一人方入会，山中九老不成图。\n鸟呼笔冢云烟起，□□诗坛草木枯。\n欲问流芳在何处，高冈真有凤凰雏。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41182,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庆左进士赞擢稽勋主事","author":"韩雍","text":"羲献书名屈宋文，春雷声里上青云。\n天官分职非常选，圣主抡才喜出群。\n鸣佩晓听双阙漏，挥毫时叙百僚勋。\n烦君莫负平生志，留取芳名后世闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41183,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄乡友沈文用","author":"韩雍","text":"沈家林馆最清幽，曾伴相知载酒游。\n宦迹北驰才隔岁，乡心南望几经秋。\n芳春桃李开花未，深夜壶觞醉客不。\n羁绊无能寻旧约，题诗聊为主人酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41184,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄乡友陈宗盛","author":"韩雍","text":"客况乡情正不禁，远劳一价送佳音。\n开缄快睹龙蛇字，念旧深知铁石心。\n万里海天春渺渺，半窗风雨夜沉沉。\n相思苦被浮名绊，尊酒何时更盍簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41185,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉送尊师唐先生判金华","author":"韩雍","text":"驿亭清酒汎黄花，旧馆诸生满路遮。\n亲炙久期联玉笋，分违遥送判金华。\n从来儒术堪经世，此去乡心莫恋家。\n早使提封遂康济，趋朝终儗拜黄麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41186,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽徐给事中父太学生","author":"韩雍","text":"花落梅窗香不闻，中年观化出尘氛。\n眉山苏老能传业，太学何蕃未策勋。\n玉洞露寒閒点易，琼楼月满静修文。\n流芳却有推封诏，夜夜龙光照古坟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41187,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"庆陈梅轩封御史","author":"韩雍","text":"鸾书飞舞下天阍，光射东吴孝义门。\n七品一官封子职，十年两世拜皇恩。\n湖山草木增新彩，乡里衣冠庆达尊。\n我有深情不能预，海天空望白云屯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41188,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"具庆堂为程员外宗题","author":"韩雍","text":"秋台绩奏称才良，宠命新颁具庆堂。\n数朵彩云将雨露，两簪苍雪耐风霜。\n光摇金翠瞻天近，景驻桑榆爱日长。\n移孝为忠丈夫事，好摅忠荩答君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41189,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄题何挥使西轩","author":"韩雍","text":"最爱西轩称此心，分明城市有山林。\n石潭倒浸芙蓉朵，竹径斜穿玳瑁簪。\n尘印荒苔人迹少，歌传丛树鸟声深。\n宦游未得陪佳赏，翘首江天想像吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":41190,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]