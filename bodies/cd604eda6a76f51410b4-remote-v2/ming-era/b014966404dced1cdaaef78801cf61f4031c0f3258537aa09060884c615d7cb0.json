[{"title":"陇头吟","author":"于慎行","text":"陇头流水别，凄响自堪惊。\n月散东西影，风传远近声。\n傍侵疏勒道，斜入隗嚣营。\n呜咽归肠断，何时到渭城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19529,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上之回","author":"于慎行","text":"离宫陈上郡，御辇出回中。\n七校长杨北，千官细柳东。\n旄头悬塞月，漏箭杂边风。\n却望单于幕，萧条万里空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19530,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长安道","author":"于慎行","text":"晨光开紫陌，春气耀丹霞。\n月落新丰树，烟笼上苑花。\n金羁京兆马，绣毂富平车。\n侠少逢何阔，相过赵李家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19531,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洛阳陌","author":"于慎行","text":"东都佳丽地，共指斗鸡坊。\n挟弹妖童骑，当垆小妇妆。\n柳花金谷暗，槐影玉沟长。\n愁望飞尘起，骄騧赭汗香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19532,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"折杨柳","author":"于慎行","text":"朱楼临大道，垂柳正依依。\n叶浅低愁黛，花轻上舞衣。\n三河春欲尽，五岭戍初归。\n何地应肠断，关前雪正飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19533,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关山月","author":"于慎行","text":"三五关山月，天空万里秋。\n影含青海动，光度玉门流。\n晓角传军垒，寒烽隐戍楼。\n阴山方接战，且莫视刀头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19534,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅花落","author":"于慎行","text":"肠断金闺妇，愁生画阁梅。\n瑶华风里落，玉树雪前开。\n拂影侵罗袂，飘香上镜台。\n关河春色暮，鹤勒几时回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19535,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨雪","author":"于慎行","text":"阴山征战地，雨雪夜霏霏。\n冻缩胡儿马，寒凝汉将衣。\n范恭疏勒返，苏武漠南归。\n颇怪关门柳，春前作絮飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19536,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长干曲","author":"于慎行","text":"妾住在长干，离居岁欲阑。\n洞庭归客少，浦口去人难。\n雨落吴天暮，云横楚岫寒。\n含情何所待，憔悴碧江湍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江南曲","author":"于慎行","text":"采采白蘋洲，兰桡忆远游。\n日悬云梦阔，天隔洞庭秋。\n风物三湘道，烟波万里愁。\n离居逢岁宴，掩涕倚重楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫骝马","author":"于慎行","text":"宝马蹀皋兰，红尘扑绣鞍。\n追风珠汗落，踏雪玉蹄寒。\n北地春方涩，长城冻未乾。\n一鸣思报主，不取按图看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈春宇太史册封楚藩二首 其一","author":"于慎行","text":"遥遥江浦去，望望洞庭西。\n拥传过三楚，乘槎入五溪。\n潮平津树杳，天阔浦云低。\n想见花源里，渔家路不迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈春宇太史册封楚藩二首 其二","author":"于慎行","text":"持节金闺客，星华并列侯。\n遥分鸾掖色，一作兔园游。\n日暮湘潭雨，天寒梦泽秋。\n岂应歌故里，白雪少人酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张洪阳太史请急南还","author":"于慎行","text":"宁亲承予告，秋尽理行装。\n橐载兰台笔，衣残粉署香。\n酒边燕月近，帆外楚天长。\n旧识张华剑，寒锋起豫章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄送朱可大南还","author":"于慎行","text":"自别春湖去，音书已隔年。\n所嗟千里梦，常在五云天。\n雨色维扬树，江声北固船。\n经过多逸兴，佳句向谁传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同李前峰兵部赵竹里文学集侯氏东墅信宿二首 其一","author":"于慎行","text":"十载谈经地，重来径已荒。\n野花含宿雨，秋草上空墙。\n客送新醅酒，楼悬旧卧床。\n晓凉凭槛立，山色四苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同李前峰兵部赵竹里文学集侯氏东墅信宿二首 其二","author":"于慎行","text":"故人复此地，不醉欲如何。\n世事杯中尽，年华镜里过。\n孤云留阁树，残日挂烟萝。\n惆怅王孙去，门前芳草多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少虚赵丈见过二首 其一","author":"于慎行","text":"上客回高驾，过予松桂林。\n题诗白云暮，对酒飞花深。\n远树浮残雨，高城下夕阴。\n草玄芸阁吏，寂寞此时心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19546,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"少虚赵丈见过二首 其二","author":"于慎行","text":"经春犹卧病，长日掩衡门。\n岂谓山阴棹，能寻谷口村。\n世情双白眼，生事一青尊。\n不浅忘年契，千秋事可论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19547,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜泊有怀","author":"于慎行","text":"月白夜将阑，潮平两岸宽。\n倚舟人语静，过雨树声寒。\n戍鼓城隅觅，船灯水际看。\n所期江路迥，何处采芳兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19548,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天津观潮","author":"于慎行","text":"六月天山雪，寒涛亦壮哉。\n声疑吹地转，浪莫蹴天开。\n估舶迎风住，渔舠弄水回。\n方闻通海运，万橹日边来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19549,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泊潞河驿","author":"于慎行","text":"行尽燕齐道，来从上国游。\n饱经湖上雨，寒泊驿边舟。\n朔气雄三辅，关门控九州。\n五陵十万户，夹岸起朱楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19550,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭沈虹台太史二首 其一","author":"于慎行","text":"故人忽云没，闻报涕汍澜。\n今日吴江冷，当时易水寒。\n青编门下受，丹旐路旁看。\n夜雨玄猿啸，浮生梦已阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19551,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭沈虹台太史二首 其二","author":"于慎行","text":"思君不忍问，河上返孤舟。\n岂是怀沙怨，应非蹈海游。\n花残吴苑暮，鹤唳月亭秋。\n肠断论交地，宫城十二楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19552,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨","author":"于慎行","text":"城夕凉风起，空堂飒似秋。\n片云生远岫，骤雨过重楼。\n暝色阶前树，寒声峡外舟。\n鸥凫何自喜，汎汎满青流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19553,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"告天台为赵瀫阳太史赋","author":"于慎行","text":"邈矣高贤操，清风华胄传。\n畏知严暮夜，考履质青天。\n国史千秋在，家声异代悬。\n只今台上月，犹照旧炉烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偕张洪阳殿读憩龙华寺寺在苑北湖上","author":"于慎行","text":"同过湖上寺，伏日坐清凉。\n云水浮仙阙，松杉荫讲堂。\n雨归莲叶净，风起稻花香。\n小借支公榻，人天午梦长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日进讲和张洪阳年丈韵","author":"于慎行","text":"秉烛趋丹禁，横经侍法筵。\n晓凉生殿阁，旭日动云烟。\n佩委天香散，花深玉漏传。\n非材惭献纳，鹄立细旃前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜雨","author":"于慎行","text":"春来全未雨，一夜雨成霖。\n触石何时聚，崇朝已自阴。\n锦林花气重，金阙漏声深。\n润泽占天造，殷忧慰圣心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕","author":"于慎行","text":"客中逢七夕，片月倚重楼。\n静对星河夜，凉生枕簟秋。\n人间浑是梦，天上亦多愁。\n览镜惊双鬓，空悲岁序流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜","author":"于慎行","text":"虚阁夜沉沉，秋声在树林。\n山中猿鹤梦，客里岁年心。\n露下莲塘冷，萤流薜幌深。\n坐来销万籁，隐几自成吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送怀上人还金陵","author":"于慎行","text":"空门无所住，亦复忆江乡。\n半偈禅心定，孤舟别路长。\n锡飞吴叶冷，笔拂楚花香。\n又向秋山里，钟声闭夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张静峰年兄赴河南别驾二首 其一","author":"于慎行","text":"十年南省客，半刺领东周。\n马向雪中去，人称洛下游。\n关河三辅道，云物二陵秋。\n别思还萧索，寒塘水自流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张静峰年兄赴河南别驾二首 其二","author":"于慎行","text":"承宠无迟暮，褰帷意气生。\n诸侯均揖让，长吏有逢迎。\n郡阁山当户，河桥柳向城。\n三川风日好，偏适宦游情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李敏斋符卿奉使省觐","author":"于慎行","text":"只今三省佩，又下五城楼。\n蓟北霜初落，淮南桂已秋。\n宫云随子舍，卿月引行舟。\n可奈河桥柳，年年绾别愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邹进士南皋谪戍贵阳二首 其一","author":"于慎行","text":"自怜焚草日，却送看花人。\n迢递三危路，飘零万死身。\n长沙悲贾傅，湘水吊灵均。\n总是经过地，将谁采白蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邹进士南皋谪戍贵阳二首 其二","author":"于慎行","text":"纲常千古事，怜尔志如霜。\n首欲阶前碎，珠凭颔下藏。\n有生心尽折，纵死骨犹香。\n不似青莲客，无端谪夜郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送习豫南太史谪居闽中二首 其一","author":"于慎行","text":"渺渺寒江路，君今岁晏游。\n十年池上佩，万里雪中舟。\n仕节人谁识，浮踪水自流。\n含情无可道，不独为离忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送习豫南太史谪居闽中二首 其二","author":"于慎行","text":"对酒不能饮，心悲握手论。\n如何同舍客，忽作远游人。\n世态青云冷，交情白首新。\n还知明主意，宣室待词臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄冯志方博士二首 其一","author":"于慎行","text":"一别褒衣客，今来几岁星。\n吴钩知射斗，鲁壁记传经。\n对酒春云碧，题诗暮雨青。\n向时游赏地，南北各飘萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄冯志方博士二首 其二","author":"于慎行","text":"幽人渺何许，江上旧儒冠。\n客舍蒹葭雨，堂餐苜蓿盘。\n楚天秋水阔，燕阙晓钟残。\n怀袖双纨扇，因风欲寄难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张洪阳殿读待舟潞渚寄送二首 其一","author":"于慎行","text":"昨日横门道，魂消鬓欲秋。\n寸心应未远，尺素已堪愁。\n对酒青灯醉，看花紫禁游。\n离情如潞水，连夜只东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张洪阳殿读待舟潞渚寄送二首 其二","author":"于慎行","text":"归梦春来剧，那堪送远游。\n身悬蜗左角，家在海西头。\n天地才难尽，风尘道不谋。\n河堤杨柳绿，亦欲买归舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春同朱可大廷尉游摩诃庵听无弦上人弹琴因饮南园二首 其一","author":"于慎行","text":"福地开真境，萧辰款梵筵。\n百花春夜雨，一饭讲堂烟。\n妙法旃檀喻，空音绿绮传。\n云床容卧起，随意检诗篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春同朱可大廷尉游摩诃庵听无弦上人弹琴因饮南园二首 其二","author":"于慎行","text":"别有祗园胜，春光象外幽。\n人从莲社饮，地胜竹林游。\n雨色阴萝幌，钟声度石楼。\n不愁归路晚，乘月可淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"告中同可大再游摩诃庵因赠静堂禅师","author":"于慎行","text":"寺忆同游地，联镳许再过。\n人行松院少，云闭竹房多。\n岁月容高枕，乾坤足放歌。\n逃禅吾不厌，病骨本维摩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄庠师周介轩先生二首 其一","author":"于慎行","text":"传经西楚客，垂老意何如。\n湖上十年梦，灯前八月书。\n秋心随过雁，旧事纪衔鱼。\n门下垂髫士，翛翛两鬓疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄庠师周介轩先生二首 其二","author":"于慎行","text":"望望徐方道，怀人白露秋。\n湖光晴载酒，山色暮登楼。\n倦迹看林鸟，閒情寄海鸥。\n红颜殊未老，欲接羡门游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日寄侯少泉参戎黔中二首 其一","author":"于慎行","text":"万里天南极，将军尚枕戈。\n一醒燕市酒，五见洞庭波。\n雾急鸢常堕，江深雁不过。\n东山栖隐地，何日共烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日寄侯少泉参戎黔中二首 其二","author":"于慎行","text":"自尔乌蛮去，寒花几度开。\n萍踪儿女大，华发岁时催。\n别梦随关月，离愁落陇梅。\n年年秋色里，一见尺书来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠谈易王生","author":"于慎行","text":"翛然江上客，读易旧儒生。\n道自青囊秘，名因绿简成。\n汉京谈季主，蜀肆隐君平。\n为叩盈虚理，因探百物情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春半","author":"于慎行","text":"卧病忽已久，閒房鸣素琴。\n徘徊紫芝意，惆怅青春深。\n芳草乱迷径，残花空满林。\n凭轩送高鸟，驰思渺难任。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望鹤","author":"于慎行","text":"缥缈珠庭鹤，翻飞别禁林。\n初盘仙阙远，渐入海云深。\n忍负乘轩宠，应非避弋心。\n瑶台多旧侣，愁绝玉笙音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河西务雨夜","author":"于慎行","text":"归舟今信宿，犹倚潞河干。\n树色春汀暗，鸡声夜雨寒。\n孤帆灯际落，短剑酒中弹。\n明发乘流进，沧波正渺漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漷县道中","author":"于慎行","text":"江草正萋萋，兰桡傍古堤。\n淡烟高树杪，斜日乱帆西。\n陇麦蒸云动，春鸠夹岸啼。\n连朝隔城市，疑入武陵溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天津夜月","author":"于慎行","text":"放舟乘晚浪，伐鼓注归流。\n明月千帆夜，长风万里秋。\n篙师探渡口，津吏指潮头。\n浩荡烟波里，应怜估客游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨柳青道中","author":"于慎行","text":"鸣榔凌海月，捩舵破江烟。\n杨柳青垂驿，蘼芜绿刺船。\n笛声邀落日，席影挂长天。\n望望沧洲路，从兹遂渺然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德州舟中遇李户部两山北上别后却寄二首 其一","author":"于慎行","text":"广川西渡口，倚棹此逢君。\n别久情难喻，欢多酒易醺。\n江声过暮雨，帆影夹残云。\n蹢躅南枝鹊，能堪羽翮分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德州舟中遇李户部两山北上别后却寄二首 其二","author":"于慎行","text":"君登兰省去，予汎镜湖归。\n两桨还相背，双星竟不违。\n心期鸥作侣，生事薜为衣。\n只有空山梦，愁时少雁飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"武城怀古","author":"于慎行","text":"停桡齐赵路，河上见孤城。\n故国佳公子，高台亦已倾。\n川光孤屿敛，暝色片云生。\n呜咽清漳水，千秋恨未平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卧病","author":"于慎行","text":"天地长贫日，风尘卧病年。\n闭门春雨后，欹枕落花前。\n石火应难驻，兰膏莫自煎。\n无生如可悟，吾意欲逃禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"菊花","author":"于慎行","text":"几年京洛客，不对故园花。\n今日重阳酒，还过处士家。\n娟娟霜蕊静，袅袅露枝斜。\n自爱贞心苦，含香阅岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽赵少虚先生四首 其一","author":"于慎行","text":"去矣云林客，伤哉艺苑豪。\n百年双白鬓，万事一青袍。\n道自平生拙，名堪此日高。\n所悲逢圣世，汩没掩蓬蒿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽赵少虚先生四首 其二","author":"于慎行","text":"文雅从兹尽，荣华亦有休。\n吾徒还一涕，尔辈自千秋。\n旧馆青山暮，重泉白日幽。\n惟馀清汶水，长绕墓田流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽赵少虚先生四首 其三","author":"于慎行","text":"十里春风苑，年年出汉关。\n调空高渌水，俗自薄朱颜。\n星彩归天上，玄经播世间。\n乞铭遗札在，一读泪潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽赵少虚先生四首 其四","author":"于慎行","text":"浮沉千古事，无力念鸿钧。\n陵替存吾道，穷愁竟尔身。\n冯唐空自老，原宪不知贫。\n他日山阳路，谁为笛里人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄贾广文年伯兼谢惠毡","author":"于慎行","text":"极目漳南道，相思正杳漫。\n愁时明月近，别后素书难。\n雪暗芙蓉阁，春生苜蓿盘。\n一毡犹寄远，应惜玉堂寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林丈内艰南还二首 其一","author":"于慎行","text":"惨淡归人意，春前问去舟。\n参商初两地，胶漆已三秋。\n雨色低津树，江光隐驿楼。\n庭花多所恨，不是锦衣游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林丈内艰南还二首 其二","author":"于慎行","text":"把袂怜同舍，离愁可奈何。\n定知秋雁少，惟有月明多。\n江上思琼树，风前废蓼莪。\n无令清夜梦，不入旧鸾坡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]