[{"title":"诏赐金海乘凉诗 其七","author":"严嵩","text":"趯台坡转石林斜，更觉清凉一倍加。\n静听鸣莺升别树，远看栖鹭立浮槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34147,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诏赐金海乘凉诗 其八","author":"严嵩","text":"楼台一一明如画，水树重重静若帷。\n人意愿同天意乐，文王台沼本无私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34148,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诏赐金海乘凉诗 其九","author":"严嵩","text":"高松碧殿阴阴覆，曲水金亭宛宛开。\n竟日攀临知未尽，万花深处一舟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34149,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诏赐金海乘凉诗 其十","author":"严嵩","text":"水边龙舰金屏护，树里虹桥翠幰过。\n归去莫言天上事，蓬莱宫阙渺星河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34150,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其一 赐玲珑雕花玉带","author":"严嵩","text":"积素含辉雪色明，尚方宝带琢瑶瑛。\n殿庭赐处皇恩重，光价宁论十五城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34151,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其二 赐金织蟒服","author":"严嵩","text":"宫恩宣赐蟒衣新，玉带金章并在身。\n度德自知难称服，遭时深幸得攀鳞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34152,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其三 赐金嵌宝石斗牛绦环","author":"严嵩","text":"宝环分赐黄金烂，珠颗匀圆石瑰奇。\n如龙水兽疑腾跃，什袭寻常不敢窥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34153,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其四 喜雨赐饮酒又皇女生赐白金彩币","author":"严嵩","text":"直宿殿庐闻好雨，四郊沾足慰宸心。\n承恩既醉宫壶酒，逢喜还分御帑金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34154,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其五 赐香","author":"严嵩","text":"赐来龙挂御奁香，焚向斋庐坐夜长。\n人间尘暑俱消尽，身在钧天玉案傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34155,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其六 赐五味汤寝宫垂花帘下饮之","author":"严嵩","text":"中侍高擎五味汤，垂花帘下赐沾尝。\n如何说得天浆味，喉吻生凉齿颊香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34156,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其七 赐酒馔瓜果等物中官日给敕免具谢","author":"严嵩","text":"翠瓮分醪出上尊，玉盘传膳给朝飧。\n甘瓜脆果频频赐，敕遣诸臣免谢恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34157,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其八 赐花金筒簪之丁香零苓香草万年松凡三被赐","author":"严嵩","text":"丁香折得宫园馥，苓草移来楚泽春。\n青爱万年松色好，君恩又见一回新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34158,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其九 赐画面扇二十四孝人物","author":"严嵩","text":"宫扇新裁素楮清，丹青仍肖古人形。\n挥仁要涤寰中暑，劝孝还同座右铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34159,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其十 赐菡萏一枝","author":"严嵩","text":"太液浮舟花满池，晓红芳湿露浓时。\n云锦万丛谁敢折，特荷金筒赐一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34160,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其十一 赐画扇有木刻海榴罂坠子一罂可寸许穴其腹藏象刻物器一百事工巧异甚","author":"严嵩","text":"燕士刻猴能集棘，艺称工巧古难之。\n请看扇坠木罂子，百件中藏物物奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34161,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其十二 赐画面扇水精蝉坠子","author":"严嵩","text":"玄蝉戢羽不闻声，彩扇绦携刻水精。\n玉露清风俱入手，不知长夏有炎蒸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34162,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其十三 赐睿宗皇帝御书大字八音克谐天光云影于文华殿面授","author":"严嵩","text":"洒翰含春睿墨存，奎光虹彩照乾坤。\n巳钦典乐虞廷训，还诵真儒喻道言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34163,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其十四 赐浑银盘一","author":"严嵩","text":"冰同洁白玉同坚，若比蟾光亦烂然。\n叮咛莫谩题生菜，元奉琼羞在御筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34164,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其十五 赐御制朝泛舟于金海诗一轴","author":"严嵩","text":"锦轴瑶签捧御书，楼船秋日泛龙池。\n吾君不事横汾乐，为忆慈游转益悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34165,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其十六 赐皇祖御注道德经一部","author":"严嵩","text":"道德真文授五千，至人曾忆度关千。\n金函玉字高皇注，万古神谟日月悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34166,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其十七 赐银套杯六小大各异以礼乐射御书数字别之","author":"严嵩","text":"银质金书六字文，酌时随量浅深分。\n贵同玉瓒藏为宝，德比醇醪饮自醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34167,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其十八 赐刻花合香牌子","author":"严嵩","text":"合香牌子黄金缕，佩向衣间蔼异芬。\n宫中总爱宜男意，花下双孩是刻文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34168,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其十九 赐葫芦画八幅","author":"严嵩","text":"水树烟云列画屏，良工高殿写丹青。\n内家每爱葫芦样，宝玩时时对宠灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34169,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其二十 万寿日赐吃面青磁龙盌盛之","author":"严嵩","text":"仁寿宫中称万寿，仰瞻天表祝华封。\n旨传赐吃长生面，捧出蟠花御盌龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34170,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其二十一 赐金箱奇南香带","author":"严嵩","text":"奇南作带赤金箱，钩系双螭白玉光。\n出自昆冈呈宝气，束当朝署散天香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34171,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其二十二 赐独角兽补子","author":"严嵩","text":"兽名独角状犹龙，彩补恩颁组绣工。\n疑有风雷起鳞甲，擘云翻浪欲腾空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34172,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其二十三 赐御用药煮酒一瓶","author":"严嵩","text":"御醴芬香味独珍，一壶宣赐殿头春。\n功可益元存曲糵，药能祛疾备君臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34173,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其二十四 赐御药如意饮五贴谕曰能治百病以八月望日修合","author":"严嵩","text":"按得千金御药方，合时分取桂轮香。\n圣人一体君臣义，百病祛除保寿康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34174,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其二十五 赐骞林茶黄精笋尖皆武当山中所产","author":"严嵩","text":"绿茗黄精玉笋罂，远从湘水贡王庭。\n沾尝一一皆仙品，露乳烟姿孕岳灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34175,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其二十六 赐银豆","author":"严嵩","text":"白金镕铸能为豆，百颗匀圆白雪同。\n若为种在南山下，乞与民间作岁丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34176,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其二十七 赐银八宝亦曰八吉祥锭胜珊瑚犀角珠子名状各异","author":"严嵩","text":"忽惊海藏遗珍贝，见说宫中号吉祥。\n因是玉皇朝绛阙，天花片片落霓裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34177,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其二十八 赐嘉靖钱撰文赏也","author":"严嵩","text":"新铸青铜嘉靖年，圣恩频给撰文钱。\n原非万选词林手，满橐持归一赧然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34178,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭纪恩赐诗 其二十九 赐貂鼠煖耳祀玄机夜寒也又谒陵骑从再赐","author":"严嵩","text":"扈跸监祠夕殿中，满衣星露满墀风。\n春融为我消寒冽，貂帽深恩被紫茸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34179,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月十六日再奉旨金海乘凉舟泛和京山太傅","author":"严嵩","text":"传宣再许内园游，避暑龙池暂放舟。\n菡萏花连千屿锦，梧桐叶报六宫秋。\n便思解绶亲鱼鸟，却恐浮槎犯斗牛。\n涉比巨川期共济，恩同沧海叹难酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和桂翁无逸夜直之作 其一","author":"严嵩","text":"无逸今宵直，还依紫禁高。\n大官频给膳，中使特颁醪。\n坐久销炉篆，寒深益毳袍。\n广庭霜月净，玉兔见秋毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和桂翁无逸夜直之作 其二","author":"严嵩","text":"凤阁诗频出，阳春调自高。\n苑花催染翰，宫月对倾醪。\n学士金莲炬，仙人兽锦袍。\n起居劳圣问，赐札帝亲毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"帝坛入拜次前韵","author":"严嵩","text":"旆转泠风肃，坛开紫气高。\n竹宫燔制币，瑶席奠仙醪。\n月色遥临仗，天香细入袍。\n中央居太乙，五色现灵毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉酬岱屏都尉","author":"严嵩","text":"直庐宵命酌，都尉兴能高。\n主第珍移馔，宫壶玉赐醪。\n地严闻警跸，情洽聚冠袍。\n文雅今谁敌，诗成纵彩毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东阁阅庶吉士卷简同事诸先生","author":"严嵩","text":"东阁抡材奉诏同，柰庭佳气霭云虹。\n御题捧出纶言焕，笔阵驱时白战雄。\n光动夜涛珠出海，暖回春苑凤来桐。\n太平休遇知难报，愿得真贤答圣衷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无逸殿直舍和少师相公韵 其一","author":"严嵩","text":"儤直承明幸接庐，内房新赐更移居。\n大官日逐颁饔膳，中使时常给扫除。\n御案丝纶开玉札，上清文字理金书。\n分明身到钧天上，传和仙歌白雪馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"祷雪直宿苑中奉诏诣都城隍祠行香以子夜将事","author":"严嵩","text":"灯火中宵出苑西，宝香龙札帝亲题。\n北阴朔气催琼雪，上界真符焕彩霓。\n市静斗星还历历，祠深松柏故凄凄。\n九重此夕忧民意，银汉瑶光望转迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海天春晓图歌为桂翁作","author":"严嵩","text":"赪霞紫气摇青葱，曦轮涌出扶桑东。\n鼋鼍腾掀巨鳌踊，光彩下烛冯夷宫。\n洪波浩荡浮元气，浴日涵空漭无际。\n碣石晴吹万里风，方壶晓落中天翠。\n是时青阳宣德泽，千岩众壑皆春色。\n夭桃露屿缝欲迷，芳草烟汀绿堪折。\n悬泉挂壁古松青，香雾环洲桂树荣。\n岛帆溆舶云中见，汉柱秦桥天际横。\n别有仙台杳霭间，丹崖翠谷渺难攀。\n贝阙岧峣凌五岳，银宫晃耀出三山。\n紫芝瑶草纷开谢，鹤驭虹旌自往还。\n中有仙人毛骨轻，还丹玉液鍊初成。\n朝骑白鹿过玄圃，夕咽金精住赤城。\n我本丹丘生，肮脏山泽形。\n混迹縻尘网，束书游玉京。\n蜃市观溟违夙愿，麟洲采药负初盟。\n谁将缣素写雄观，令我一见心眼乱。\n髣髴乘涛泛太瀛，便欲凌风生羽翰。\n主人幽思在云烟，黄扉退食心悠然。\n鸿钧巳属调元手，花甲初逢献寿年。\n年年献寿奉琼筵，大隐金门是列仙。\n日采芙蓉朝帝阙，还看渤澥变桑田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"步虚词 其一","author":"严嵩","text":"高高黄金阙，隐隐白玉楼。\n中有虚皇居，华景荫丹霄。\n朱阳洞明境，青气散空寥。\n寤寐思真域，但觉形神超。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"步虚词 其二","author":"严嵩","text":"绛宫吸灵气，玉诀飞天罡。\n翕尔生光电，依然蹑洞阳。\n赫奕三皇箓，灿烂九霞章。\n飞神朝玉阙，羽盖凌扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"步虚词 其三","author":"严嵩","text":"振佩入琼都，云扉是几重。\n鸾情依日观，凤想结霞峰。\n魂瑩澄真识，心斋清道容。\n五色金光发，相将随赤龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"步虚词 其四","author":"严嵩","text":"凌晨吸丹景，入夜漱玉泉。\n百关弥舒旷，灵台复湛然。\n冥思玄霄上，驰神玉阙前。\n无劳生羽翼，自可揖真仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠童内方庶子","author":"严嵩","text":"赐归乘传倍恩光，水绿山青入楚乡。\n驿路草齐吟驻马，渚亭花发醉留觞。\n诚知笔里驱云梦，早向池边识凤凰。\n望苑宾寮应共待，好持经术辅元良。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送许龙石少宰之南都","author":"严嵩","text":"香案携经直九重，留曹聊复借高踪。\n渡江风送仙舟鹢，望阙云蟠帝宅龙。\n东郡扫松还驻节，北书将橘谩题封。\n旧游回首难忘地，坐倚修篁夕翠浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉次少师桂翁赐宴纪恩 其一","author":"严嵩","text":"凤麟瑞世真贤出，日月光天景运开。\n身辅虞廷兴礼乐，手调商鼎到公台。\n赐筵玉醴频繁送，褒诏龙笺焕烂裁。\n盛典本朝曾几见，百寮回首叹臣哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉次少师桂翁赐宴纪恩 其二","author":"严嵩","text":"圣朝褒礼重元臣，南省衣冠庆此辰。\n农野气和初得雨，帝城花满剩留春。\n玉堂黄阁勋庸盛，翠釜银罂赐泽新。\n历考中书谁似者，直从郭令到公身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再次桂翁乡会即席韵 其一","author":"严嵩","text":"德星明处画堂深，咫尺烟霄喜盍簪。\n扈圣竞瞻阿阁凤，得贤宁羡隗台金。\n西江文献元称盛，东里勋名复见今。\n瑶瑟夜歌催逸兴，彩毫春色动高吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再次桂翁乡会即席韵 其二","author":"严嵩","text":"满座春杯岂厌深，百年嘉会此冠簪。\n却惭葭质叨依玉，永荷洪炉得铸金。\n廊庙声华公振古，虞周礼乐圣逢今。\n吹嘘幸接南宫席，潦倒空赓下里吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再次桂翁乡会即席韵 其三","author":"严嵩","text":"帷幄谋谟帝眷深，殿头鸣玉领缨簪。\n著来锦绣宫裁蟒，捧出骈蕃御赐金。\n促召每闻忙人夜，留欢刚得暇逢今。\n巳陪鱼藻沾恩宴，更惜莺花洽醉吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甬川张公阅仆旧作缪荷奖重次韵为谢","author":"严嵩","text":"老来虚愧度芳辰，童子曾矜得句新。\n赐帛几人论将相，雕虫当日费精神。\n镜中短鬓频添雪，陌上缁衣谩化尘。\n蒲柳体资山泽兴，敢窥时杰画麒麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠槎溪王翁 其一","author":"严嵩","text":"问讯金陵河上居，别来风景复何如。\n群鸥自占溪翁席，驷马能停省客车。\n云树江东频入梦，塞鸿天北漫题书。\n极知泉石身间乐，不向中朝羡佩鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠槎溪王翁 其二","author":"严嵩","text":"远别无因问起居，开函初喜得双鱼。\n镜中华发年何似，湖上扁舟晚自如。\n身健底须求大药，眼明犹复理残书。\n近闻欲返槎溪棹，故里云山乐有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日赐柏叶诗","author":"严嵩","text":"王正启祚，青阳肇历。\n秘苑天开，帝宫晨入。\n帝有纶言，曰庆嘉日。\n爰奉明恩，恭承宠锡。\n其锡维何，惟柏一枝。\n凌霜挺翠，裛露含滋。\n采自玄圃，捧出?墀。\n金筒簪戴，炜烨其光。\n君子有酒，称彼瑶觞。\n坚贞比节，森郁呈芳。\n以勖臣德，以介元祥。\n君子万年，寿考不忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪赐十二绝 其一 赐银牌子刻平安二字","author":"严嵩","text":"银榜颁恩重，椒觞取醉欢。\n新年占百福，天语赐平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪赐十二绝 其二 赐银像生人马并太平牌子四","author":"严嵩","text":"白金作像生，奇巧出新制。\n中有四云牌，欢睹太平字。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪赐十二绝 其三 赐金寿仙二","author":"严嵩","text":"铸就两仙人，黄金不坏身。\n须眉但了了，那记寿乡春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪赐十二绝 其四 赐银孩儿七","author":"严嵩","text":"赐出银孩美，取义在宜男。\n感恩先祝圣，敬效华封三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪赐十二绝 其五 赐新制貂鼠煖耳","author":"严嵩","text":"貂帽频沾赐，今番新制奇。\n传宣宵入直，戴月出宫墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪赐十二绝 其六 赐绒锦护膝一双","author":"严嵩","text":"鲜华新制锦，软煖厚铺绵。\n长跪谢宸渥，造膝玉阶前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪赐十二绝 其七 赐银鱼百尾","author":"严嵩","text":"宝坻产嘉鱼，纤纤白似银。\n贡来供玉食，何意得尝珍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪赐十二绝 其八 赐长春酒每夕一尊","author":"严嵩","text":"直舍灯明里，还摛应制文。\n宵寒霜漏永，赖此助微醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪赐十二绝 其九 赐酒蟹一瓮","author":"严嵩","text":"入手霜螫美，言从海市来。\n甘香分御瓮，约客共春杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪赐十二绝 其十 赐橄榄","author":"严嵩","text":"青果来闽峤，分珍出御函。\n谁知辛苦后，滋味有馀甘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪赐十二绝 其十一 赐御前色丝画人物元宵卓灯一对","author":"严嵩","text":"绘綵双灯烂，分辉自御筵。\n玉堂留盛事，何异赐金莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":34214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]