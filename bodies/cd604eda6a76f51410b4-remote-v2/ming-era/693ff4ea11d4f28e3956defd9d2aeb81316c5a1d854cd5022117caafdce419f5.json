ollection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观道士祈雨二首 其二","author":"唐顺之","text":"巫舞商阳古有之，神灵风雨灌坛时。\n阴阳夑理输谁力，秪遣儿童颂法师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归自金陵宿白土","author":"唐顺之","text":"长路缁尘欲上衣，暂投客馆亦如归。\n不因野老来争席，岂解山人□息机。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬徐养斋尚书见怀之作亦以少颂盛德并为扣关先容云耳二首 其一","author":"唐顺之","text":"卜居秪为谢尘缘，三尺绳床亦稳眠。\n纵是炎天非雪夜，终须乘兴到前川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬徐养斋尚书见怀之作亦以少颂盛德并为扣关先容云耳二首 其二","author":"唐顺之","text":"柴门长日闭青山，薜荔衣裳冰雪颜。\n愧我未能分半榻，药囊书卷共消闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨训导擢曹州掌教二首 其一","author":"唐顺之","text":"传魁之世久知名，君作师儒更有声。\n巳道江东桃李遍，春风还被鲁诸生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨训导擢曹州掌教二首 其二","author":"唐顺之","text":"皋比几岁卧江城，绛帐谈经复此行。\n广文不厌青