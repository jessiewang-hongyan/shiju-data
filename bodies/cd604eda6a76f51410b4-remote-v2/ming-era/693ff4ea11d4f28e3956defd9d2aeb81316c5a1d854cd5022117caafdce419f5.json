nance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠王和尚住善卷","author":"唐顺之","text":"偃柏垂萝古洞春，上人飞锡此何因。\n非关福地寻仙侣，自向青山认法身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自述赠写真毛君","author":"唐顺之","text":"津黑尚余山泽气，委蛇又似列仙臞。\n他年太史征图画，为识乾坤一腐儒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠曹星士一江号","author":"唐顺之","text":"春雨兰陵江草生，江流恰与道心清。\n门前车马日来往，闲坐江城说子平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自述并赠曹君","author":"唐顺之","text":"少读阴符耻未工，青山偃仰渐成翁。\n人间炎冷都忘尽，听话流年一笑中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓起观猫捕鼠","author":"唐顺之","text":"起来隐几坐朝暾，深谢当关早闭门。\n檐角偶欣猫捕鼠，反观尚觉杀心存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画","author":"唐顺之","text":"山空夜静猿一鸣，磴转云深鸟不度。\n幽人何事长独栖，只为此中有佳处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"廉使廖东雩丧后开所惠地黄酒临觞惨然","author":"唐顺之","text":"尺书满箧故人情，想象荒丘宿草生。\n秪余此日开尊意，堪作山阳听笛声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠仪真沙君","author":"唐顺之","text":"葭菼苍苍水国秋，高楼明月古杨州。\n二十四桥云雾里，看君骑鹤上天游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠史君渔沙号","author":"唐顺之","text":"问君何处挂渔蓑，予亦垂纶坐绿波。\n他日相逢应一笑，不知若个得鱼多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"补庵三度惠酒而此番所惠参酒者绝清冽可人虽味甚浓厚而置之杯中淡若无色可谓嘉品因剧饮至醉遂成口号奉谢三首 其一","author":"唐顺之","text":"磁杯写尽只疑空，秋月寒潭意颇同。\n隐几偶然成独酌，夜凉白露满庭中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"补庵三度惠酒而此番所惠参酒者绝清冽可人虽味甚浓厚而置之杯中淡若无色可谓嘉品因剧饮至醉遂成口号奉谢三首 其二","author":"唐顺之","text":"每甘樗散惟须酒，欲补虚赢却藉参。\n瘵疾陶生兼好饮，举杯深见故人心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"补庵三度惠酒而此番所惠参酒者绝清冽可人虽味甚浓厚而置之杯中淡若无色可谓嘉品因剧饮至醉遂成口号奉谢三首 其三","author":"唐顺之","text":"绝无色相倾明水，只有馨香藉白茅。\n此夕饮醇?一醉，恰如把臂与公交。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"食石首鱼又得鲳勒二鱼喜作口号向时石首每至郡鲳勒亦不至也非海氛渐息何以有此 其一","author":"唐顺之","text":"昔年食首又成羹，鲳勒相随亦就烹。\n应是鲸鲵先授首，纷纷水族尽亡生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"食石首鱼又得鲳勒二鱼喜作口号向时石首每至郡鲳勒亦不至也非海氛渐息何以有此 其二","author":"唐顺之","text":"凶状腹前排剑戟，凶谋腹里涨彭亨。\n罟师自有截江网，性命惟堪一箸轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三屯营阅兵蓟镇总兵开府处","author":"唐顺之","text":"股肱北平郡，烽火度辽营。\n特以郎官节，来巡都护兵。\n橐驼参阵□，?篥应军钲。\n三令先庚后，八门死地生。\n妖星枉矢堕，杀气蓐收行。\n象缀吴都燧，羊分宋士羹。\n生羌休近塞，熟虏敢渝盟。\n阅罢时登眺，虹螺忆古城。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自乍浦下海至舟山入舟风恶四鼓发舟风恬日霁波面如镜舟人以为海上罕遇是日行六百五十余里","author":"唐顺之","text":"岛夷频不静，玉节远何之。\n誓清万里寇，敢惮一身危。\n闽卒精风候，吴儿惯水嬉。\n黄头纷百队，白羽扬千旗。\n击鼓灵鼍应，挥戈海若随。\n龙惊冬不蛰，鲛畏昼停丝。\n昨夜波朝怒，中宵云雾披。\n天澄镜光发，风嫩縠纹滋。\n邹衍瀛洲数，庄生秋水词。\n乾坤元莽阔，人世自牵羁。\n已傍渔山泊，还寻马迹期。\n日升看晷转，途变识针移。\n双屿厓门险，半洋礁石奇。\n从来惟贼路，今日有王师。\n待献经营绩，三山勒一碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒夷齐庙二首 其一","author":"唐顺之","text":"未访箕山冢，来经孤竹墟。\n精光犹日月，冠冕肯泥涂。\n国合归中子，心元避独夫。\n千年北海辙，还见盍归乎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒夷齐庙二首 其二","author":"唐顺之","text":"归周仍避纣，渭叟况同襟。\n叩马何饶舌，采嶶还苦吟。\n当年谏武意，昔日事殷心。\n生死知音在，明夷用独深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卢龙行咏田畴","author":"唐顺之","text":"公孙昔日据玄菟，北连蹋顿骋狼顾。\n曹公万里动征师，到此沮洳不得渡。\n田生义侠久知名，驻车虚左亲邀迎。\n屏人慷慨谈心腹，兵家诡道先虚声。\n卢龙小路才一骑，佯言返旆潜度兵。\n夜半遂斩名王首，天矢不折鲸鲵清。\n功成笑掷封侯印，依然被褐返茅荆。\n当时策士如云拥，奇谋却属一书生。\n山川寂历霸图歇，薜萝满眼高踪绝。\n瀚海阴风鼓角悲，燕山寒月挂旌旗。\n秪余今人守塞处，犹似昔人出塞时。\n俛仰乾坤一回首，贤达伏藏何不有。\n不见华阴鬻屐生，□□□原卖浆叟。\n自怜局促畏简书，安得停车访岩薮。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卧病作二首 其一","author":"唐顺之","text":"孤踪原自与时屯，两月郎官半闭门。\n药石番为二孺笑，精华秪觉百骸存。\n鲁门未惯爰居性，楚客愁窥虎豹阍。\n却忆扁舟秋泛处，洞庭木叶水波翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卧病作二首 其二","author":"唐顺之","text":"闲情已觉钓非钓，末路久居才不才。\n烛武本非食肉相，无盐亦被入宫猜。\n雍容佩玉身难置，驰骋兵戈心又灰。\n击剑读书堪自笑，昨非今是好归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至职方作余初释褐补官武选主事今适三十年","author":"唐顺之","text":"画省栖迟已卅年，今来似有再生缘。\n署郎冯叟何言晚，薄望东坡半是仙。\n心事江湖思报主，兵戈南北愧筹边。\n簿书若谓真成懒，日画先天几个圈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再官京师怀赵浚谷中丞","author":"唐顺之","text":"江潭讵意复修门，旧侣京华讶几存。\n迹比孤云难有托，心思公子欲何言。\n太白几时还避昼，鬼方计日想称藩。\n李广雁门今罢守，短衣猎骑正秋原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"严介溪相公见示戊午纪年诗次韵四首奉赠 其一","author":"唐顺之","text":"黄阁成功久宴然，问龄才及卜熊年。\n俯躬忘却丝纶贵，臞貌真疑山泽仙。\n赐直内庭频守岁，献谋前席几回天。\n更待风烟静南北，九重还见锡爰田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"严介溪相公见示戊午纪年诗次韵四首奉赠 其二","author":"唐顺之","text":"精神海鹤羡翩然，一入瀛洲五十年。\n朝野共推黄发老，身名何必赤松仙。\n经纶不废烟霞咏，寝食常严咫尺天。\n岁岁续成时政记，岂同先辈录归田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"严介溪相公见示戊午纪年诗次韵四首奉赠 其三","author":"唐顺之","text":"老臣丰度自凝然，夷使趍朝竦望年。\n帝札不名多署字，岁星应象或称仙。\n膝前款语惊忘食，禁里乘舆讶上天。\n知公不忍庖厨意，九野春回是寸田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"某尝俟食于公语及人与物同之说公慨然有远庖厨之戒故云又黄庭经云寸田尺宅","author":"唐顺之","text":"游丝掖户对悠然，犹似钤山静卧年。\n雅性好文兼好士，修龄非药又非仙。\n夜调羽檄消多垒，昼接龙光切九天。\n自愧樗材虚汲引，秪宜仍旧种瓜田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"密云阅兵作","author":"唐顺之","text":"亭徼逢秋雕羽轻，良家六郡试雄兵。\n一年天险卢龙塞，万炬星飞翼虎营。\n清笳乍歇闻鸣镝，突骑才回见伏旌。\n有道四夷方设守，年年长此护神京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"度潮河","author":"唐顺之","text":"流浅沙明自可怜，未经秋潦转澄然。\n马腹浮河仍饮水，甲光映日更摇川。\n几处穹庐移就草，数家瓯脱曲依泉。\n沿堤犹见青杨柳，秪觉南州乡思悬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游遵化汤泉","author":"唐顺之","text":"绝塞逢秋已觉凉，此中气候讶非常。\n流金每似临三伏，晞发真成向九阳。\n山烟叆叆分朝润，草色青青敌夜霜。\n我亦临流堪一笑，稽生盥浴久相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登喜峰古城时三卫贡马散牧塞外","author":"唐顺之","text":"绝顶孤峰见废关，短衣落日试跻攀。\n三秋豹旅方乘障，万里龙媒正满山。\n候雁似随乡思去，寒花将送使臣还。\n筹边迂薄真无补，空望伊吾抵掌间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓟镇忆弟正之试南都 其一","author":"唐顺之","text":"伏枥衰年久自甘，尔兄迂阔尔偏谙。\n心窥秘算逢人噤，箧贮阴符向夜探。\n犀渚青枫烟际棹，龙沙白草露中骖。\n雁行正笑难如雁，飞去飞来北又南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓟镇忆弟正之试南都 其二","author":"唐顺之","text":"狗马病多经绝塞，棣华室远隔南天。\n每思原上听鸣鹡，始讶山头望跕鸢。\n可以去乎仍恋禄，无能为也更筹边。\n头颅长尽山林骨，木食莎衣信有缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"还姜白二子衣","author":"唐顺之","text":"试整戎装出汉宫，解衣何意故人同。\n野容聊免披颠倒，命服堪将衬黝葱。\n孔阳为映朱旗色，稍敝因经紫塞风。\n今日还君箧笥里，依然摇曳禁垣中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒夷齐庙","author":"唐顺之","text":"为仰风流百世希，长歌招隐坐渔矶。\n昔人何处群麋鹿，此地深秋尚蕨薇。\n征诛揖逊有今古，饿显禄隐无是非。\n但使斯人皆可侣，不妨到处坐朝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月五日顺义道中望阙一首时近万寿节四日也","author":"唐顺之","text":"几时承遣出彤闱，寒暑俄惊节候非。\n霜陨塞门犹葛屦，风凄朔野亦絺衣。\n中秋诞圣金晶会，百里瞻天紫气围。\n日与长安俱近处，莫陪鹓列转依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]