[{"title":"越岭瞻乔卷为易使君仲子题","author":"胡应麟","text":"公子旧翩翩，宁亲羡汝贤。\n瞻乔离楚服，怀橘向吴天。\n柯烂青霞斧，帆飞赤壁船。\n太行他日望，重赋白云篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次日叶孝廉复邀集馆中赋","author":"胡应麟","text":"水亭门外望，朱户万花间。\n逸兴饶金谷，丰肌倍玉环。\n紫骝云杂遝，黄鸟雪间关。\n肯学山阴棹，空成兴尽还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李左辖","author":"胡应麟","text":"皂盖江都旧，朱衣汉殿新。\n云霄回北望，山岳动西巡。\n薇省千花夕，棠郊万树春。\n何人学徐稚，今古接芳尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"剑泉","author":"胡应麟","text":"当年欧冶铸，莲锷夜生花。\n赤电飞延浦，青虹照若耶。\n风期弦上得，意气筑傍赊。\n会挈楼兰首，铭功瀚海涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卫河阻风同张陈两生小饮作","author":"胡应麟","text":"何限萧条色，相看一坐中。\n乍收霞脚雨，仍起石尤风。\n逆浪冲飞鹭，惊沙没断鸿。\n移文岩际满，独此滞征蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登陆行齐鲁赵间二首 其一","author":"胡应麟","text":"望望乡犹隔，行行路转难。\n村醪过曲阜，野饭驻邯郸。\n白堕谁争醉，黄粱任饱飧。\n凭招吕翁至，一问大还丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登陆行齐鲁赵间二首 其二","author":"胡应麟","text":"乍骋思乡目，聊舒逆旅魂。\n牛羊遥隔岸，鸡犬自成村。\n陇麦侵齐甸，山花照鲁门。\n岱峰云咫尺，如迓丈人尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"余从陆至安平镇闻傅伯俊明府先一夕过此怅然有寄","author":"胡应麟","text":"一夜长洲令，双凫跨碧虚。\n徒飞秦观梦，未达鲁连书。\n计吏黄金诏，郎官白玉除。\n鲈乡亭下路，归客倘踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠谢山人","author":"胡应麟","text":"一榻衡门下，萧然共白头。\n长林中散卧，古木谢敷留。\n石室藏孤愤，金庭梦五游。\n剡溪前夜雪，曾否下扁舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"项山人季舆过访赋赠二首 其一","author":"胡应麟","text":"柴门朝雨霁，鸟鹊噪檐牙。\n车马何方客，新来自永嘉。\n去偕沧海月，归指赤城霞。\n迟汝秋风夕，同扳桂树华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"项山人季舆过访赋赠二首 其二","author":"胡应麟","text":"总为寻诗过，难将问字留。\n万峰阳羡色，双艇石湖秋。\n雾拥王孙佩，星随客子裘。\n归来定何日，长倚碧云楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"系航阁为纪旭仁题","author":"胡应麟","text":"嵯峨扬子阁，百尺大江边。\n竹绕谈玄座，花藏问字船。\n捲帘群壑入，敧枕万峰悬。\n夜雪如相过，那能兴尽还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中泠馆为楚宗侯仲和作","author":"胡应麟","text":"胜迹中泠畔，名亭大海头。\n石栏三楚色，金锡九江流。\n谷有康王卧，泉堪陆羽留。\n春芽阳羡熟，一钵许同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"集郭鸿胪听歌","author":"胡应麟","text":"赤栏桥子畔，来过百花丛。\n一径延新绿，孤亭坐落红。\n歌声全度雪，舞态半随风。\n向夕瑶台望，真疑凤下空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"林山人逸民自闽中来访赋赠","author":"胡应麟","text":"野鹤閒云辈，何因独扣关。\n为寻天竺寺，来话武夷山。\n客路松华熟，禅房桂树閒。\n那能待婚嫁，五岳早跻扳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过林生啜茗作","author":"胡应麟","text":"七闽山水尽，仍舣瀫川航。\n一室空林下，长斋叶满床。\n画图传蛱蝶，书札动鸾凰。\n为客烹阳羡，双松正夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄廷评","author":"胡应麟","text":"东阳仙隐吏，八咏万家传。\n政就花连郭，秋成秫满田。\n龙扳新绛阙，鹤舞旧朱弦。\n藉甚王廷尉，君看结袜年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客有自金华诸洞返者穷幽历险所睹甚异余伟其事而赋之以订再游","author":"胡应麟","text":"洞天三十六，奇绝擅金华。\n雪壁盘空上，冰壶抱月斜。\n玉桃千岁实，瑶草四时花。\n瓢笠吾当去，驱羊卧赤霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕台骧首为方元素题","author":"胡应麟","text":"赤骥画桃花，长鸣逐暮笳。\n霜蹄穿大漠，电影涉流沙。\n伏枥心期壮，登台意气遐。\n秋风闲十二，早晚向天家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"毛文学招集命幼子庆郎出见座上赋","author":"胡应麟","text":"何处来英物，娟然玉雪同。\n春山联寸黛，秋水浸双瞳。\n异日徵飞兔，当年忆梦熊。\n看君怀橘去，谁不羡黄童。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王孝廉邀集城西张氏馆即席作","author":"胡应麟","text":"结束问东家，联翩到狭斜。\n绿杨初拥絮，红杏半飞花。\n绣榻笼轻雾，珠帘罩落霞。\n坐来庭树色，冉冉欲栖鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠谢少廉","author":"胡应麟","text":"旧阀知王谢，奇情识鲁连。\n世传如练句，人诵捣衣篇。\n冠鹖馀生事，屠龙入暮年。\n白门桃杏色，次第理吟鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王使君之滇中六首 其一","author":"胡应麟","text":"楼船秋水平，汝向碧鸡城。\n绛殿分符别，黄堂视篆行。\n万山藏贵竹，孤岛辟昆明。\n烂漫东方骑，遥知夹路迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王使君之滇中六首 其二","author":"胡应麟","text":"诏书来日下，行色动江皋。\n卤簿专城贵，旌旗列郡豪。\n檄传巴俗远，诗到夜郎高。\n何处看铜柱，飞扬勒彩毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王使君之滇中六首 其三","author":"胡应麟","text":"铜鱼分绝塞，金马问长途。\n地入三苗险，天悬六诏孤。\n中华传制作，异域上舆图。\n新酿椰阴满，何妨醉百觚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王使君之滇中六首 其四","author":"胡应麟","text":"不堪垂老态，仍对欲分襟。\n杖拟携邛竹，船应载郁林。\n夷歌传白璧，汉诏锡黄金。\n何似长安吏，穷年问陆沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王使君之滇中六首 其五","author":"胡应麟","text":"西南天欲尽，剖竹问罗夷。\n想像千村外，驱驰九驿时。\n山行忘蜀道，水战息昆池。\n卧阁桄榔下，能无咏别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王使君之滇中六首 其六","author":"胡应麟","text":"迢遥丹凤诏，灿烂白狼篇。\n弭盖朝行僰，飞槎夜入滇。\n长途山作地，大泽海为天。\n绝域阳春布，无劳话瘴烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻司马张公萧公讣二首 其一","author":"胡应麟","text":"廿载甘棠爱，千秋大树名。\n断虹燕北路，斜日渭南营。\n部曲清笳送，官僚素旐迎。\n东南天半壁，谁为筑长城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻司马张公萧公讣二首 其二","author":"胡应麟","text":"北里丹旌度，西江素翣回。\n千秋申甫业，一代管鲍才。\n象纬中台坼，风云太华摧。\n袛应庐阜色，名姓共崔嵬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭大中丞滕公八首 其一","author":"胡应麟","text":"间代钟豪杰，嵬然岳降神。\n三朝传政绩，万国待经纶。\n赋就悲题鵩，书成叹获麟。\n何须论夙夜，尽瘁见王臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭大中丞滕公八首 其二","author":"胡应麟","text":"绝学传邹鲁，洪都陋汉唐。\n君王悲大树，父老泣甘棠。\n百万清油底，三千绛帐傍。\n尚思龙起日，风雨动南阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭大中丞滕公八首 其三","author":"胡应麟","text":"羽节吴山驻，貂裘汉殿来。\n诗书三代佐，文武万邦才。\n日惨中丞幕，云寒上将台。\n袛因秦望石，勋业并崔嵬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭大中丞滕公八首 其四","author":"胡应麟","text":"渐觉三台近，俄惊八座空。\n高牙悬落日，大旆飒悲风。\n部曲讴吟外，宾僚怅望中。\n佳城犹郁郁，谁为问滕公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭大中丞滕公八首 其五","author":"胡应麟","text":"甲胄重关静，楼船大海閒。\n勋名韩范后，筹略管萧间。\n月拥丹旌度，云拖素旐还。\n异时灵爽在，长镇武夷山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16497,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭大中丞滕公八首 其六","author":"胡应麟","text":"七台初返旆，九曲罢扬舲。\n琬琰留中秘，辒辌出大廷。\n山川摧间气，海宇泣英灵。\n万古真儒业，重看配考亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16498,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭大中丞滕公八首 其七","author":"胡应麟","text":"尚记抡才日，鸡群识凤毛。\n尘埃援锦瑟，雨雪赠绨袍。\n德并生成大，情兼怙恃劳。\n百年知己泪，遍洒越门涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16499,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭大中丞滕公八首 其八","author":"胡应麟","text":"念载门人籍，千秋国士期。\n长镵惊老大，短褐愧支离。\n宿草孤帆近，生刍一剑迟。\n殊恩何日报，恸绝大江湄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16500,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽马都阃二首 其一","author":"胡应麟","text":"矍铄闻飞将，苍茫失故侯。\n金章新息在，铜柱伏波留。\n已逐沙场逝，宁怀下泽游。\n至今灵爽在，犹自慑壶头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16501,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽马都阃二首 其二","author":"胡应麟","text":"韬略知名旧，封侯泣数穷。\n前茆沈落日，大树飒悲风。\n马革当今羡，鸱夷自古同。\n云台政图画，忍没汉庭功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16502,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"先宜人不幸弃背泣血苫次志哀四章 其一","author":"胡应麟","text":"一夜西风色，俄然到北堂。\n千秋黄壤远，万感白云长。\n寂寞幽兰思，迟回寸草肠。\n夜台无日返，何处报春阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16503,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"先宜人不幸弃背泣血苫次志哀四章 其二","author":"胡应麟","text":"忍忆丸熊事，空馀戒猎言。\n北风频撼木，西日故摧萱。\n玉匣埋孤隧，珠襦閟九原。\n闲居曾一赋，恸哭望高轩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16504,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"先宜人不幸弃背泣血苫次志哀四章 其三","author":"胡应麟","text":"刀尺遗中阃，辎軿向大罗。\n梦回衣线杳，寒入穗帷多。\n夜月沈兰茝，秋风瘁蓼莪。\n流黄叠空篚，触目动悲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16505,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"先宜人不幸弃背泣血苫次志哀四章 其四","author":"胡应麟","text":"骤得西华信，云軿去不疑。\n星冠朝玉阙，雾幄返瑶池。\n白日兰陵暗，清霜薤里迟。\n惟馀嗣宗恨，血泪洒残棋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16506,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠管茂才坤","author":"胡应麟","text":"管子南州杰，飘然此地逢。\n风尘随燕雀，云雾隐蛟龙。\n堂上湘妃曲，溪头越女容。\n一尊何日对，相傍采芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16507,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠赵长吉中舍","author":"胡应麟","text":"何来中秘客，巨笔迥如椽。\n鸟迹羲皇后，螺书大禹前。\n硬黄贞观帖，飞白永和篇。\n奇字吾犹识，能来话草玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16508,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郭生烧一鹅食余甚香美诗以赏之","author":"胡应麟","text":"西园新燕集，东郭旧鹅群。\n炙处逢刘毅，燖时笑右军。\n金盘疑喷雾，玉盏竞倾云。\n更有浑羊设，奇方欲赠君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16509,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿郭金吾","author":"胡应麟","text":"阀阅汾阳盛，簪绅代国留。\n玄关驯独鹤，赤县驻双虬。\n覆局青霞烂，鸣弦白雪流。\n三珠庭下树，冉冉拂琼楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16510,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早春自西掖过访宋忠父作","author":"胡应麟","text":"言寻中禁路，来问列侯家。\n玉座攀云色，金城步日华。\n池烟深锁树，苑漏曲穿花。\n莫笑绨袍敝，长裾半赤霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16511,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"醉卧赵文学榻上蘧然甚适觉赋此章","author":"胡应麟","text":"颓然聊一榻，酣卧碧纱长。\n极乐知仙界，温柔羡帝乡。\n春疑回大庾，赋已就高唐。\n可怪黄粱熟，庄生兴未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16512,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钟天毓南还二首 其一","author":"胡应麟","text":"送汝木兰桡，高天正泬寥。\n枫行扬子岸，柳折灞陵桥。\n丽赋三都擅，狂名六馆饶。\n东溟聊一息，奋翮上扶摇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16513,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钟天毓南还二首 其二","author":"胡应麟","text":"寂寞中涓后，何人问骏才。\n藏书还禹穴，抱赋出燕台。\n大漠新霜下，长河片月来。\n异时重入洛，云色伫蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16514,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠丁文通太学","author":"胡应麟","text":"邂逅咸阳市，干将照白虹。\n新诗传敬礼，旧梦识文通。\n业岂吹竽贱，心犹击筑雄。\n宁亲暂升斗，奋翮待天风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16515,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临淮史夫人挽章四首 其一","author":"胡应麟","text":"令族姬姜并，贤声孟卫流。\n贵从周太保，体敌汉诸侯。\n宝匣飞鸾镜，琼箫咽凤楼。\n预知陶氏冢，新兆卜眠牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16516,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临淮史夫人挽章四首 其二","author":"胡应麟","text":"云軿飞绛阙，哀诏下明堂。\n大树犹撑日，芳兰骤仆霜。\n泉台春寂寞，石室夜苍凉。\n冉冉灵妃佩，乘风度七襄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16517,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临淮史夫人挽章四首 其三","author":"胡应麟","text":"叹息兰闺底，悲风一夜多。\n星芒沉宝婺，日彩断银河。\n跨凤佳期阻，丸熊旧事过。\n钟情潘岳甚，其奈二毛何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16518,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"临淮史夫人挽章四首 其四","author":"胡应麟","text":"宠数颁宸极，恩光备寝筵。\n珠襦藏大隧，玉匣閟重泉。\n懿德丝纶著，芳声竹帛传。\n谈诗怜哲胤，凄断蓼莪前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16519,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题何仁仲园亭二首 其一","author":"胡应麟","text":"采采白蘋洲，三湘欲尽头。\n危栏云梦夕，飞阁洞庭秋。\n渔父持竿过，灵妃结佩游。\n武昌新水发，迟我木兰舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16520,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题何仁仲园亭二首 其二","author":"胡应麟","text":"别馆寄清沙，飞甍触望遐。\n径移湘浦竹，溪浣杜陵花。\n万岫交明月，千林逗彩霞。\n墙东处子丽，莫是宋生家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16521,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甘露园二首 其一","author":"胡应麟","text":"为园近茂陵，甘露遍垂藤。\n月底寒犹坠，风前曙欲凝。\n餐莲疑太华，瀹茗胜中泠。\n试作相如赋，谁云渴未能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16522,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甘露园二首 其二","author":"胡应麟","text":"泠然松竹径，点缀自何年。\n北固昭明寺，中嵩慧可禅。\n寒生金掌外，清注玉壶前。\n好傅何郎颊，朱衣拭更妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16523,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同李惟寅何仁仲集朱汝修观梅花","author":"胡应麟","text":"一尊春兴剧，花下共传筹。\n艳质霜先避，清香月并流。\n诗怜群玉句，人倚仲言俦。\n恍入西湖道，吾家万玉楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16524,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王伯固之临漳","author":"胡应麟","text":"承恩出尚方，跃马向临漳。\n身是王乔族，官邻子晋乡。\n芙蓉周阙紫，松柏魏台苍。\n预听鸣琴日，阳春满未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16525,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴翁升还霅上","author":"胡应麟","text":"河梁樽酒暮，一骑向飞沙。\n旅服惊霜树，归装冒雪花。\n豪游新北阙，艳赋旧东家。\n好去苕溪上，群姬辍浣纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16526,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中过孟韬不值","author":"胡应麟","text":"濩落怀同调，经过问索居。\n雪花行剡曲，云树隔匡庐。\n大业元龙剑，微名尚鹿车。\n不知玄草外，奇字近何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16527,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子玉以大计量移赋慰","author":"胡应麟","text":"三叹崔亭伯，清风玉不如。\n吏情甘惨淡，公府绝吹嘘。\n考署阳城拙，名成谷口愚。\n祇应宣室夜，前席治安书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16528,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻王闲仲得隽燕中志喜二首 其一","author":"胡应麟","text":"阀阅三朝旧，弓裘四世新。\n霜蹄金騕，天种石麒麟。\n桂擢燕山夜，梅标碣石春。\n平康花似绮，结束待车轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16529,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻王闲仲得隽燕中志喜二首 其二","author":"胡应麟","text":"金泥初帝阙，玉树旧王家。\n间气钟三叶，奇葩炫五花。\n追风横大漠，蹑景度流沙。\n宁似吴宫外，穷年学浣纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":16530,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]