[{"title":"偶成","author":"谢榛","text":"乡园尚隔越，寒暑又经过。\n晚计身无补，新交事转多。\n閒时自天地，静处即烟萝。\n白鸟忽飞去，悠然一浩歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14554,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别陈大参粹中二首 其一","author":"谢榛","text":"征骖闻早发，客自塞门归。\n天暝乌栖树，城寒雪拥扉。\n美人仍两地，春梦不相违。\n独赋关山月，茫茫共素辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14555,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别陈大参粹中二首 其二","author":"谢榛","text":"别后缄书少，天骄数往还。\n正忧烽火急，翻羡草茅閒。\n积雪犹平涧，残阳半在山。\n相逢春尚浅，杨柳未堪攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14556,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄太和山何隐君二首 其一","author":"谢榛","text":"弃官依白岳，岁月此栖迟。\n道侣频相过，丹经久自知。\n心閒虎啸处，步缓鹤随时。\n倚杖看晴色，前峰又采芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14557,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄太和山何隐君二首 其二","author":"谢榛","text":"太乙坛前客，桃花十度红。\n幽栖片石定，元气四时通。\n古树邻苍壑，閒云澹碧空。\n能谈非静者，真意几人同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14558,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨后立夏","author":"谢榛","text":"园中绿已暗，寂寞问花神。\n兴托清樽酒，愁欺白发人。\n山城初雨过，天地尚馀春。\n又与东风别，堪嗟羁族身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14559,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送薛逸人归荆南","author":"谢榛","text":"河汾春色过，此别路三千。\n旅梦关山月，乡心风雨天。\n马归湘竹外，城对楚江边。\n去住何须叹，荆王自下贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14560,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄徐水部有和","author":"谢榛","text":"粉署当形胜，虚怀谁似君。\n树凉沙市雨，江白渚宫云。\n鹳鹤翩翩下，帆樯历历分。\n楚童能艳曲，不使水曹闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14561,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北园同孔老赋得风字","author":"谢榛","text":"悠然云在空，此意许谁同。\n身出勋名外，心归恬澹中。\n高楼偏夕照，深竹自凉风。\n试问今秋兴，还添菊几丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14562,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜雨","author":"谢榛","text":"夜来殊不寐，百感古今情。\n道在楚骚重，年衰燕侠轻。\n轩庭回爽气，风雨失残更。\n多少人欹枕，中心别有营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14563,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宋伯镇招饮署中赋得长字","author":"谢榛","text":"绿草夹阶长，凭轩共晚凉。\n鸟声投暝树，霞影蘸清觞。\n兴剧三秋赋，年衰几日狂。\n今宵话离合，风露满衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14564,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨后早起","author":"谢榛","text":"积雨空阶满，开轩幽兴深。\n半窗低晓月，几处苦秋阴。\n已倦人间路，能閒诗外心。\n还憎多此癖，习静老山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14565,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"积雨感怀","author":"谢榛","text":"十月天多雨，霏霏日夜寒。\n西山改气色，北斗失阑干。\n生计门常掩，悲歌灯又残。\n可怜黄菊老，几向病中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14566,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初冬十五夜云洲丈招游东林得僧字","author":"谢榛","text":"皎皎东林月，初看法镜升。\n殿沉中夜磬，松隐上方灯。\n兴剧催银斝，诗成转玉绳。\n地非庐霍胜，天许著名僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14567,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李园暮雪同镇康安庆二王偶成","author":"谢榛","text":"带雪几归鸟，萧然集旧柯。\n树明春意早，庭敞暮寒多。\n绿醑同梁苑，清才并郢歌。\n还期看山色，天外玉嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14568,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜昭觉禅院示万灯上人","author":"谢榛","text":"旧衲灯前补，天寒霜满庭。\n不眠中夜偈，早起半函经。\n慧力刬诸障，禅心通百灵。\n腊同祗树老，春雨又青青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀顾近湖比部","author":"谢榛","text":"莫测文园志，龙光薄海天。\n遥知变化日，稀见老成年。\n客路西淹晋，神州北壮燕。\n白云楼上赋，秋色满高筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄顾彭山别驾","author":"谢榛","text":"建业元佳丽，风流况有君。\n妖童隔花唱，醉客倚楼闻。\n清忆铜台雪，春怜金谷云。\n于今非宦邸，犹试宝刀纹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠田深父","author":"谢榛","text":"气夺三都赋，声驱六代诗。\n春云流碧落，秋月照琼枝。\n独览中原胜，还收太华奇。\n东山有狂客，千里愧相知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西亭中尉雅集","author":"谢榛","text":"骚侣夜同酌，酣歌风月斜。\n古人自风调，今代几名家。\n客久鬓将雪，天寒梅正花。\n谁知献赋意，对尔一长嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吹台吊三贤","author":"谢榛","text":"异代怀三老，风骚尚可亲。\n高名相照耀，片石自嶙峋。\n野旷青云暮，台空碧草春。\n至今遗响在，神鬼泣何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夜潞阳旅馆同冯员外言别得分字","author":"谢榛","text":"客亭逢此夕，樽酒况同君。\n月向中秋满，人从上国分。\n绛河斜度影，白雁远呼群。\n回首淮阳路，相思隔海云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日即事五首 其一","author":"谢榛","text":"八月边烽起，燕关入引弓。\n檄飞三辅道，气激五都雄。\n戍角寒云外，城乌夜色中。\n不知枕戈者，愁绝竟谁功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日即事五首 其二","author":"谢榛","text":"燕赵多愁日，兵戈未定时。\n交游疏旧社，僮仆问归期。\n驿路当秋断，胡笳带月悲。\n晓来惊旅鬓，更益镜中丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日即事五首 其三","author":"谢榛","text":"何时偃甲兵，多难滞燕城。\n寒馆下桐叶，秋风吹雨声。\n贾生今日泪，宋玉昔年情。\n共有龙庭策，谁高麟阁名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日即事五首 其四","author":"谢榛","text":"旅怀方索寞，秋气重萧森。\n兵甲南归梦，妻孥北望心。\n闭城山日在，倚剑野云深。\n独有长安客，时时问捷音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日即事五首 其五","author":"谢榛","text":"叠嶂云仍惨，孤村鸟亦稀。\n共嗟经铁马，谁复守柴扉。\n战地生寒色，征旗乱夕晖。\n还思汉飞将，逐北过金微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴驾部子有奔丧洛中 其一","author":"谢榛","text":"漠南惊候火，洛下报哀音。\n去去思亲泪，迟迟忧国心。\n暮云中岳断，秋雨大河深。\n犹忆老莱服，空瞻松柏林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴驾部子有奔丧洛中 其二","author":"谢榛","text":"数有趋庭梦，秋来益苦颜。\n高原黄叶下，落日素车还。\n发变兵戈后，心摧霜露间。\n啼乌转凄切，泪尽北邙山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对菊","author":"谢榛","text":"东篱何寂寞，不似去年秋。\n菊带凄凉色，人经离乱愁。\n风庭寒影动，霜院晚香流。\n客里重阳过，悲歌独未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"马子端王鼎臣见过因怀崔都尉","author":"谢榛","text":"兵去人心定，相逢话此生。\n乱离俱是客，去住各含情。\n沁水沉鸾影，秦台断凤声。\n眼中惟二子，且复醉燕城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜","author":"谢榛","text":"不见同怀侣，悠然独夜思。\n风凄闻角处，月落倚楼时。\n计拙陶潜酒，心忧阮籍诗。\n千山芳蕙歇，策杖复何之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"芳树","author":"谢榛","text":"芳树花争发，嫣然故向人。\n相看终日媚，一摘暂时新。\n影落金塘水，香飘玉砌尘。\n伤心有琴瑟，寂寞汉宫春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邺下秋怀","author":"谢榛","text":"风尘劳客计，词赋寄乡愁。\n雁避燕山雪，人经邺地秋。\n几年多放浪，万古自沉浮。\n抱膝成孤啸，苍凉月近楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉和崔后渠祭酒见赠","author":"谢榛","text":"碧山留大老，客子几番来。\n砧杵鸣秋郭，风尘上晚台。\n孤怀惟短剑，万事且深杯。\n东阁多贤士，宁遗作赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄靳太守子鲁","author":"谢榛","text":"花发上林时，君行我在兹。\n三春不相见，千里自同思。\n白发留燕市，青蘋寄楚词。\n郡楼应独眺，未拟北来期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题萧鸿胪文萃园亭","author":"谢榛","text":"京国论交久，知君道气存。\n买书无积俸，好客有閒园。\n月近池边榻，云低花下樽。\n偶来堪避俗，何必问桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赵总戎公僎","author":"谢榛","text":"闻道干城将，频年未解颜。\n身危征战后，名定是非间。\n海月窥龙剑，沙云接雁山。\n谁怜赵充国，白首卧榆关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集孙郎中文揆宅赋得月字","author":"谢榛","text":"关山不见月，玉笛未须吹。\n水暗鱼龙窟，云深乌鹊枝。\n开樽成露坐，作赋待秋期。\n还拟梁园夜，邹枚况在兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜同应驾部瑞伯宿三河驿得宵字","author":"谢榛","text":"荒村回远火，古驿驻征轺。\n蓬鬓人间老，萍踪蓟北遥。\n繁星耿秋汉，鸣柝乱寒宵。\n忽忆山中桂，清霜叶又凋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赴石门峡","author":"谢榛","text":"石门西去道，烟色树冥冥。\n秋草地全白，夕阳山更青。\n闻虫惊节序，立马问边庭。\n潦倒还词赋，徒惭两鬓星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石门秋夜有怀","author":"谢榛","text":"歇马空山夕，劳歌塞上归。\n野霜明古剑，峡月冷秋衣。\n坐里蛩螀乱，愁边乌鹊飞。\n酒杯时在手，不与故人挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春雨感怀","author":"谢榛","text":"漠漠春天雨，冥冥晚树花。\n山云迷客路，海燕落人家。\n浊酒聊生计，狂歌任岁华。\n异时怀杜甫，老病滞三巴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日同武元康刘复之杜约夫万金渠流觞","author":"谢榛","text":"城西六月暮，笛里万山秋。\n野水天光净，沙汀日色浮。\n清觞聊泛泛，白鸟任悠悠。\n逸少今千载，何人复胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吕试官宗夔入蜀","author":"谢榛","text":"西蜀有扬马，君才当此行。\n几年怀胜迹，今日慰平生。\n地入黄牛峡，江连白帝城。\n停骖勒铭处，独见古人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"独步","author":"谢榛","text":"野田聊独步，风物漫幽思。\n地迥秋山出，天空暮雨垂。\n石梁閒鹳鹤，水国静蛟螭。\n旷士成衰谢，宁无狗监知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮秋同冯直卿秦廷献李士美游黄花山 其一","author":"谢榛","text":"太行秋色老，步屧一探奇。\n草白高欢殿，山空王母祠。\n飞泉堪倚杖，落日尚挥卮。\n松外浮云去，幽人意独迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮秋同冯直卿秦廷献李士美游黄花山 其二","author":"谢榛","text":"高崖翻槲叶，白日雨声寒。\n共爱秋山好，其如芳蕙残。\n乱云藏怪石，空壑下清湍。\n底事林间鹤，栖栖刷羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮秋同冯直卿秦廷献李士美游黄花山 其三","author":"谢榛","text":"深入黄花谷，高临玉女台。\n迎人千嶂出，随意一樽开。\n寒露垂瑶草，秋风扫石苔。\n子长耽胜绝，猿鸟莫相猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿黄花寺","author":"谢榛","text":"横野千重壁，飞空百丈泉。\n松门临巨壑，石阁架长烟。\n月下惟清梵，林中有静缘。\n此心元不染，秋水照青莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日游清凉山柬孟德用","author":"谢榛","text":"沙暖青蒲出，山晴碧树分。\n琴樽閒傍水，杖屦独披云。\n旷野流春气，高峰驻夕曛。\n芳时不可负，寄语孟参军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北园同刘国藩夜酌","author":"谢榛","text":"花时招酒伴，几度北林游。\n改席依芳树，鸣琴对碧流。\n天高微月出，沙迥断烟浮。\n明日还乘兴，垂竿杜若洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄郭太史质夫","author":"谢榛","text":"直北京华地，仙郎足胜游。\n云低金阙暮，月动玉堂秋。\n草诏传天语，题诗见国忧。\n茫茫湖海上，有客寄渔舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题背面美人图","author":"谢榛","text":"无那琵琶曲，重弹调转凄。\n自伤倾国色，故作背人啼。\n太液秋光冷，长门夜月低。\n流莺何意思，飞过掖庭西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀仙吟","author":"谢榛","text":"海上安期子，飘然与世违。\n三丘来采药，万里蹑云归。\n山鬼窥丹灶，鲛人识羽衣。\n相从渺何许，秋月见馀辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"侠客行","author":"谢榛","text":"五陵豪侠士，意气欲横天。\n出入长耽酒，交游不惜钱。\n斗鸡输宝剑，逐兔落金鞭。\n动说成功易，如今又几年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"塞上曲","author":"谢榛","text":"百战多枯骨，秋高白草深。\n飞雕盘大漠，嘶马振长林。\n柔远君王德，封侯壮士心。\n华夷自有限，边徼莫相侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁香","author":"谢榛","text":"紫花何太媚，静女若为看。\n影动帘栊晓，香沉烟雨寒。\n芳菲心有托，零落思无端。\n一采归金屋，春深莫倚阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒食","author":"谢榛","text":"族次惊寒食，流年鬓有华。\n春风吹燕子，初日照梨花。\n丘垄天边泪，江湖梦里家。\n古来词赋客，拓落但长嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南巡歌二首 其一","author":"谢榛","text":"大道军容肃，中天王气高。\n风云随凤辇，日月动龙袍。\n绿野开三殿，黄河集万艘。\n竟陵恐迟暮，原庙荐樱桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南巡歌二首 其二","author":"谢榛","text":"南楚旌旗合，黄尘走百官。\n天王重巡幸，民物识艰难。\n驰道春风动，行宫夜月寒。\n万年垂拱意，歌颂入长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同冯汝隆万泉山","author":"谢榛","text":"林壑最幽处，乱泉风雨来。\n云中山路转，树里石门开。\n高兴题苍壁，长歌坐碧苔。\n好为猿鹤主，閒醉百年杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题何柏斋侍郎山居","author":"谢榛","text":"茅宇依泉石，游心自太空。\n檐垂松叶露，门掩稻花风。\n世故端居外，天真独卧中。\n平生爱疏广，今古几人同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬五岳山人黄勉之见寄","author":"谢榛","text":"人壮三吴地，天开五岳图。\n神交江月迥，目极海云孤。\n老凤鸣琪树，秋花照玉壶。\n洞庭骚雅会，知尔说狂夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴四首 其一","author":"谢榛","text":"寥落天涯客，谁堪秋气深。\n风烟凄大野，霜日净空林。\n对镜嗟衰白，衔杯任陆沉。\n子云多著述，百代有知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴四首 其二","author":"谢榛","text":"山昏云到地，江白雨连天。\n鸿雁寒无赖，芙蓉秋可怜。\n旅怀须痛饮，世事且高眠。\n京国迷茫外，空歌美女篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴四首 其三","author":"谢榛","text":"啸歌谁会意，风色动严城。\n天夕孤鸿过，山秋万树鸣。\n故人湖海梦，游子岁时情。\n坐惜瑶芳歇，空除又月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴四首 其四","author":"谢榛","text":"地旷糜芜老，庭空蟋蟀寒。\n山河秋瑟瑟，风露夜漫漫。\n白首谁同醉，黄花祗自看。\n吾生真浪迹，沧海一渔竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚秋呈崔后渠侍郎","author":"谢榛","text":"野旷烟岚重，山深杖屦迟。\n菊花留晚色，松树挺寒枝。\n霜下百虫伏，风前孤鸟悲。\n苍生忧悴日，独有老臣知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北塞","author":"谢榛","text":"朔漠名王遁，长城候骑还。\n丁男空郡国，甲士壮边关。\n玉剑横霜冷，雕弓抱月閒。\n于今多上将，谈笑定天山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]