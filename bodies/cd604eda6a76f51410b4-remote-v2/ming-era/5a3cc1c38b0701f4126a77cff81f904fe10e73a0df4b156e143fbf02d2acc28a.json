[{"title":"寄颜惟乔","author":"王廷陈","text":"竟日无欢绪，临风怀所知。\n泥涂今老大，羽翼各差池。\n芳草未堪折，浮云空自驰。\n山中逢岁晏，何以慰相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21742,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜阮子自蜀归寄赠","author":"王廷陈","text":"昔厌蚕丛险，今耽渔浦深。\n狭中乖束带，多病合投簪。\n予慕竹林侣，长瞻枫树林。\n咏怀如有唱，莫惜寄同心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21743,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"遣兴","author":"王廷陈","text":"向人久落落，为计竟区区。\n钓弋秪从好，林庐总冒愚。\n山风吹薜荔，溪月浸菰蒲。\n敢拟高贤迹，聊全不肖躯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21744,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过范德和书屋因出所作见示留赠","author":"王廷陈","text":"谷暖乱莺啼，春晴酒为携。\n芝兰叨入室，桃李自成蹊。\n黄绢人皆奖，青衿孰可齐。\n圣朝经术选，安得久岩栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21745,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十五夜玩月同所知","author":"王廷陈","text":"南楼频迟客，西囿复张筵。\n赏属清宵厌，心从碧汉悬。\n玉轮光始满，纨扇影初圆。\n竟夕浑忘寐，斜晖益可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21746,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"八月十五夜对月独坐","author":"王廷陈","text":"月当三五满，绝胜是今宵。\n夹露兰光湿，含风桂影飘。\n谢客怀空结，西园谁见招。\n徘徊星汉侧，吟咏亦逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21747,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对雪","author":"王廷陈","text":"银霰搴帷集，瑶觞倚槛挥。\n著梅花早落，入柳絮先飞。\n饥鸟不避户，冻云偏坐衣。\n青阳虽稍近，终未胜寒威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21748,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中对雪","author":"王廷陈","text":"朔雪度江楼，萧萧生晚愁。\n轻回青雀舫，密隐白鸥洲。\n游女佩堪掷，宓妃珰可留。\n无媒向空阔，含思对沧流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21749,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日重过曾园","author":"王廷陈","text":"名园重系马，丽日此开尊。\n冻解溪声乱，暄回林气繁。\n转怜花识面，更觉鸟能言。\n秪恐春光尽，留连日易昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21750,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"志感寄京邑友人","author":"王廷陈","text":"弃置已如此，飞翻知几时。\n不材堪比栎，陋质免为牺。\n抗论复谁信，壮图空自悲。\n敢云弦似直，实有发如丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21751,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠舒子二首 其一","author":"王廷陈","text":"亦有振子意，其如吾力微。\n枪榆聊自适，濡沫暂相依。\n吴楚推儒行，风霜损客衣。\n生涯虽濩落，奇气尚翻飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21752,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠舒子二首 其二","author":"王廷陈","text":"一从栖楚地，两见改枫林。\n岐路兴长叹，江山入苦吟。\n交游尽逢掖，登眺几开襟。\n谁谓贫为病，高风益可钦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21753,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜坐","author":"王廷陈","text":"晚林虚白室，净几太玄经。\n养拙关幽独，凝思启性灵。\n空阶沉霁月，县牖内秋星。\n不寐时披户，流飙暗激萤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21754,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江上送吴明府以谳赴沔阳","author":"王廷陈","text":"盘错才能办，明威狱可孚。\n非缘审虞芮，那得泛江湖。\n琴和云间鹤，舄随波上凫。\n简书虽可畏，鱼鸟亦堪娱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21755,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"豫章陈生纪善堪舆诗以赠之","author":"王廷陈","text":"汝擅青乌术，频为黄鹤游。\n山川委情状，岁月傍穷愁。\n善补神功就，能令鬼福酬。\n高踪何所似，漂泊一虚舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21756,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春游","author":"王廷陈","text":"晴日动春沙，乘閒到水涯。\n开颜聊自媚，得意欲谁誇。\n跻磴时扪葛，寻源屡入花。\n江山怜病客，行坐惠烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21757,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉酬皇甫百泉雪中见过留赠之什三首 其一","author":"王廷陈","text":"积雪惟僵卧，冲风故宠临。\n飘扬狂客性，高洁直臣心。\n怀瑾鲜可示，投珠谁见钦。\n赖谙消息理，庶缓白头吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21758,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉酬皇甫百泉雪中见过留赠之什三首 其二","author":"王廷陈","text":"雪里使君至，光增狐白鲜。\n玉珂鸣宛转，瑶草踏夤缘。\n剡曲偶移棹，郢歌堪被弦。\n报琼惭未可，寡和古今然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21759,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉酬皇甫百泉雪中见过留赠之什三首 其三","author":"王廷陈","text":"含香辞汉署，投赋吊湘累。\n白璧竟谁惜，素丝诚我悲。\n岂图当雪夜，聊得协风期。\n丘也君能学，应知涅不缁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21760,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠廖子","author":"王廷陈","text":"嗟尔老风尘，名堪高士邻。\n他乡长作客，异术耻干人。\n月酌江城夕，花吟楚岸春。\n萍踪任流转，随处有交亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21761,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中麓二首为李吏部赋 其一","author":"王廷陈","text":"闻说湖山胜，云霞万壑平。\n登丘望远海，送目寓高情。\n鹏激天风起，乌随晓日生。\n降神元有自，应系百年名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21762,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中麓二首为李吏部赋 其二","author":"王廷陈","text":"回望苍烟合，从中素业留。\n高深开陇亩，伏腊感松楸。\n俯瞰朝暾上，晴看海雾流。\n主人栖省署，魂梦此相求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21763,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠张子","author":"王廷陈","text":"自遂归田卧，何曾入郭行。\n比邻稀识面，州郡秪知名。\n但结渔樵侣，宁关婚嫁情。\n溪潭垂钓处，日见白鸥迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21764,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宁公房对竹","author":"王廷陈","text":"双树谒空王，丛篁隐上方。\n欲窥童子偈，因憩此君堂。\n法雨晴阶湿，香云午院凉。\n招邀竹林侣，同醉给园傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21765,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"遣怀","author":"王廷陈","text":"齿发今非故，沉冥朝复昏。\n扶衰综上药，谢客偃中园。\n通显多相弃，达生聊可论。\n壮心随草莽，末路信乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21766,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"自团江赴黄倏忽望见城郭欣然赋此","author":"王廷陈","text":"野水平侵岸，澄江稳放船。\n橹声杂鼓吹，樯影曳云烟。\n漫逐群鸥后，俄惊百雉前。\n长风如可假，乘夕向遥天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21767,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与数客偶至一所率尔题壁","author":"王廷陈","text":"兹地岂不迩，吾侪今始逢。\n林深睥睨入，径古剪除通。\n壤石无他异，琴尊幸此同。\n一丘虽绝小，心赏独难穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21768,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"对雨","author":"王廷陈","text":"晚岫云全出，春江雨半吞。\n气先占础润，声急讶盆翻。\n檐溜争依户，渠流欲溃垣。\n吾方厌尘垢，天为净林园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21769,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别墅邀宾","author":"王廷陈","text":"与客过林塘，留欢出所长。\n投壶按鲁鼓，弄笛㨿胡床。\n屏迹愚为谷，逃名醉是乡。\n二三同志者，倘肯恕吾狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21770,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚泛","author":"王廷陈","text":"投林众鸟疾，薄暮孤帆开。\n落日似相逐，前山恍自来。\n云霞互明灭，风浪争喧豗。\n待月面洲渚，徒婴逝者怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21771,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访百泉先生 其一","author":"王廷陈","text":"谪居皇甫子，独步帝庭才。\n吏隐门常闭，宾朋径始开。\n求羊非我辈，驱马为君来。\n向夕香风度，泽兰诚可哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21772,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"访百泉先生 其二","author":"王廷陈","text":"怜君公府内，而乃搆幽居。\n暇日频招侣，无时不著书。\n悲歌行自激，直道向人疏。\n放逐空嗟久，谁闻荐子虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21773,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初夏游西山归作","author":"王廷陈","text":"东陆铜浑改，西山石径迷。\n暑轻经夏浅，缓步获高跻。\n列岫映杯小，孤云行几低。\n江天宵色里，客散欲闻鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21774,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈叟 其一","author":"王廷陈","text":"固穷谁得似，汎爱竟何如。\n齐客空弹铗，虞卿枉著书。\n徒劳门驻马，无补釜生鱼。\n寂寞人云苦，君颜日每舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21775,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与二客留酌竹圃","author":"王廷陈","text":"林当大道侧，客出古城隈。\n欲就七贤饮，还邀二仲来。\n鸟声流碧树，人影堕苍苔。\n不必淮南桂，淹留日几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21776,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别业偶题 其一","author":"王廷陈","text":"纷纷车马地，寂寂丘园身。\n始悟閒门趣，非关远市尘。\n入林先稚子，分馔及农人。\n日暮驾言返，凉风吹葛巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21777,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别业偶题 其二","author":"王廷陈","text":"耽晴出今日，待雨耕后时。\n农事岂不苦，褊心良所宜。\n尘衿逢水浣，露坐任风吹。\n散发烟墟里，行歌谁复知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21778,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠别皇甫百泉 其一","author":"王廷陈","text":"怜君辱刀笔，爱客具琴书。\n奇字人堪问，能名孰可如。\n鸟因求友至，羊以败群除。\n饰吏须儒术，应知用不疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21779,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠别皇甫百泉 其二","author":"王廷陈","text":"一从辞上国，每恨寡论文。\n与子时相见，令予日有闻。\n偶来珠复去，暂合剑仍分。\n倘赋相思曲，因风报楚云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21780,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠别皇甫百泉 其三","author":"王廷陈","text":"赤壁嗟流寓，金陵喜量移。\n迟回今日别，迢递夏云随。\n故国三吴接，王宫六代遗。\n之官兼过里，去住惬心期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21781,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠别皇甫百泉 其四","author":"王廷陈","text":"江路指姑苏，兰桡入画图。\n客深谙楚语，家近听吴歈。\n亲爱唯贪聚，君恩实恐孤。\n过庭凡几日，复作省中趋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21782,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日山居即事 其一","author":"王廷陈","text":"市逼村非远，城纡路亦长。\n藤萝青壁树，云鸟翠微堂。\n林日晴多荫，溪风午荐凉。\n北窗时偃卧，人代接羲皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21783,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日山居即事 其二","author":"王廷陈","text":"寂寂郊原室，悠悠野客心。\n苍林鸣鹤起，白石饭牛吟。\n坐玩高云变，留连片雨阴。\n回车山径晚，多露畏相侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21784,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日山居即事 其三","author":"王廷陈","text":"涧古苔长满，林深径复微。\n偶经松竹处，聊挂薜萝衣。\n水鸟窥篱落，山云拂槛飞。\n农人惊节迈，负耒夜深归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21785,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日山居即事 其四","author":"王廷陈","text":"相过嫌俗驾，自赡爱贫家。\n陶令门前柳，秦人洞口花。\n试暄看野马，占曙听林鸦。\n耕稼谁云苦，吾生幸有涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21786,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日山居即事 其五","author":"王廷陈","text":"开门临巨壑，扶杖入平沙。\n雨后桑麻长，风前杨柳斜。\n仰天歌自劳，休陇听农誇。\n应笑禳田者，篝车望已奢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21787,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏日山居即事 其六","author":"王廷陈","text":"寂寞翻为乐，渔樵更可亲。\n林皋无俗务，草泽有閒人。\n秪欲全疏拙，非关慕隐沦。\n偶然随稚子，驱犊古江滨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21788,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别空山陈子","author":"王廷陈","text":"之子忆南州，行行且复留。\n频年悲旅食，五月问归舟。\n守黑虽卑术，谈玄实隽流。\n秋风期返棹，迟汝上江楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21789,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"园中作","author":"王廷陈","text":"林闾先自僻，农圃近相安。\n不树千株橘，犹滋九畹兰。\n放歌山荅响，得酒月留欢。\n就枕夜方寂，空斋闻远滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21790,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"得友人书感而赋此","author":"王廷陈","text":"少日同声者，书来秪数行。\n二毛知阔绝，双鲤恨凄凉。\n久贱亲交弃，无求老态狂。\n世情那可问，明发泛沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21791,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄友人","author":"王廷陈","text":"独立向江天，相思隔暮烟。\n草玄从客笑，衰白故人怜。\n五岳几时去，一丘长晏眠。\n幽怀何所寄，丛桂晚逾妍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21792,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别墅即事 其一","author":"王廷陈","text":"衡宇终朝偃，邻家此径分。\n重林频翳日，积水自蒸云。\n村暝驱牛返，门閒啅雀闻。\n野人休错讶，樵牧本吾群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21793,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别墅即事 其二","author":"王廷陈","text":"杖策携群稚，墟行野色开。\n泉因刳木引，径以逐林回。\n远壑孤烟起，高城片雨来。\n所欣人迹罕，吟啸兴悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21794,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送十一叔入试","author":"王廷陈","text":"竹林频接宴，草泽每怜才。\n匣剑岂终闭，囊琴今始开。\n南图鹏激水，北首骏登台。\n战胜知能事，秋风扬策回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21795,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠东瓯郑磐山兼留其北上 其一","author":"王廷陈","text":"挟册来何地，投诗谒我庐。\n能工四声韵，兼擅八分书。\n貌与葛巾古，心从蓬鬓疏。\n君无羡京洛，且学楚江渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21796,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠东瓯郑磐山兼留其北上 其二","author":"王廷陈","text":"怀宝不获售，栖栖客楚乡。\n词高淩幼妇，篆古逼中郎。\n相士因贫失，依人减醉狂。\n朱颜俗所薄，感激欲沾裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21797,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"翟汝和雅善声诗兼工图画浪迹荆郢高视时人一方缙绅争先迎致潦草点缀价比南金然汝和不屑也今来谒予诗以赠之","author":"王廷陈","text":"翟生负性气，自许更无前。\n对客诙谐捷，评人美刺偏。\n颇为竖儒骂，每荷名公怜。\n图画知非志，无令好事传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21798,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送戴中丞归 其一","author":"王廷陈","text":"落魄郢中客，销魂泽畔吟。\n久捐和氏宝，且伏直生金。\n君勿忧多口，人当谅此心。\n行经武夷下，须上最高岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21799,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送戴中丞归 其二","author":"王廷陈","text":"归去岂不乐，聊为留滞吟。\n竟何污白壁，暂亦铄黄金。\n以我常失意，于君倍感心。\n谗人行且得，安可老云岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21800,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泛鲍塘塘在元祐宫前用颜汉东韵时顾司空袁傅二中贵在坐 其一","author":"王廷陈","text":"锦缆仙源接，银珰帝邸来。\n鵔鸃临水映，鸂鶒触船开。\n秋篴清商发，晴宫紫气回。\n再来桃水路，莫遣世人猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21801,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"泛鲍塘塘在元祐宫前用颜汉东韵时顾司空袁傅二中贵在坐 其二","author":"王廷陈","text":"玄宫金间碧，秋沼水澄清。\n槎泛还依斗，箫鸣且劝觥。\n筠笼持枣献，芳饵得鲂烹。\n鹤驾何由假，招携仗友生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21802,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"生日有感简同馆汉东少泉二子","author":"王廷陈","text":"五十来年是，行藏往日非。\n因之念亲旧，存者亦几希。\n弧矢心犹壮，文章力已微。\n操觚从二子，衰薄藉馀辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21803,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠王生","author":"王廷陈","text":"近识匕山子，居然三楚贤。\n竹林时偃蹇，兰泽恣夤缘。\n莫谓覆盆下，还期扬策前。\n谷回邹子律，乔木看莺迁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21804,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉别大司空顾公二首 其一","author":"王廷陈","text":"公旦营周礼，诸生愧楚材。\n纪详王迹起，阁重帝乡开。\n献岁书从入，乘春节与回。\n园陵望不极，泪尽汉江隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21805,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉别大司空顾公二首 其二","author":"王廷陈","text":"弃置时将晚，疏狂性莫移。\n顷缘外史召，得赴尚书期。\n白雪竟谁和，青云非我思。\n泥涂荷知己，瞻恋不能辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21806,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋石泉赠施子","author":"王廷陈","text":"施生美少年，结庐依石泉。\n掬泉淬宝剑，坐石鸣朱弦。\n自子表孤派，从兹赴百川。\n临流时洗帻，勺水漾青天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21807,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉怀宾云","author":"王廷陈","text":"吾宗贤伯子，未老已悬车。\n黄绶不屑绾，清尊宁遣虚。\n罗伤廷尉宅，书满邺侯庐。\n邻室如堪假，从君此卜居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21808,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋空山赠陈子纪","author":"王廷陈","text":"已乖俗子调，遂结山灵知。\n独往似逃侣，偶来非赴期。\n静闻魍魉啸，动见烟霞随。\n岩洞晚欹仄，言归当勿迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21809,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠戴医","author":"王廷陈","text":"戴医方弱冠，流辈不能如。\n何自授神术，非徒读父书。\n衰残年赖保，延致日无虚。\n尚有耽诗癖，烦君药与除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21810,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]