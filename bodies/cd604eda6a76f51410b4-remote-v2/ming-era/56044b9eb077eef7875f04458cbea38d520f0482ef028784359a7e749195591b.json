[{"title":"积雨郑左二子晚宴","author":"李梦阳","text":"秋深众草皆垂实，两久高墙半湿痕。\n百岁荣枯同逆旅，二仪风雾自黄昏。\n乌鸦树滑时窥屋，泥泞人稀早闭门。\n便合披蓑邀郑左，任从烧烛倒清尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55858,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王生还里","author":"李梦阳","text":"华池避俗屯萤火，往日谈经近鹿场。\n万里飘零余作客，诸生亲炙尔升堂。\n昨来见面生春色，岁暮还家带雪霜。\n怀土力微难并进，强吟临路独凄凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55859,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"逢泰公门徒因寄","author":"李梦阳","text":"垂趐昨年辞帝都，散花今日见门徒。\n乘杯老去还能否，击钵狂来未信无。\n暂止乳莺元逐燕，得时横隼莫惊乌。\n清沙密竹追随地，肠断飞虹月色孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55860,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄华韶州","author":"李梦阳","text":"十年不寄一封书，索处常思万里馀。\n谪宦贾生元独远，抗言刘向果谁如。\n新符海外劳分虎，旧德明中想佩鱼。\n退食昔移青锁步，论文偏过省郎庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55861,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠郑庚","author":"李梦阳","text":"文物江东数歙都，里传贞白似君无。\n门前不种钩衣草，堂上当巢返哺乌。\n为客老年今道路，告归春日复江湖。\n沙溪酒熟儿孙劝，拄杖徐行步绿蒲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55862,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"北行家兄与内弟王实间行侦缓急即如雷霆之下魂魄并褫矧又如饥渴","author":"李梦阳","text":"吾兄泪眼若悬河，内弟尪羸苦更多。\n昏黑同行草莽里，明星独傍邑城过。\n荒山葛藟萦初蔓，空屋荆花满故柯。\n临路断肠俱哽咽，望归携手向烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55863,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄答内弟玑九日繁台见忆","author":"李梦阳","text":"怅别登台逢九日，云闲水落望长安。\n风急愁闻木叶下，秋清泪满菊花团。\n临危始识交亲重，处世空嗟行路难。\n一勺涂鳞终放掷，九天归翼待扶抟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55864,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乔太卿宇宅夜别","author":"李梦阳","text":"竹梧池馆夜偏寒，促席行杯漏未阑。\n燕地雪霜连海峤，汉家钟鼓动长安。\n吟猿见月移孤树，宿雁惊人起别滩。\n二十逢君同跃马，十年回首笑弹冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55865,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别都主事奔丧归","author":"李梦阳","text":"瑶池不听凤凰箫，银汉愁看乌鹊桥。\n海内居亲情并苦，天涯书剑路俱遥。\n阴阴朔塞鸣秋叶，滚钕寒江急暮潮。\n君去会应朝北斗，余归终拟伴渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55866,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜别王检讨","author":"李梦阳","text":"露白秋城角夜哀，朔云边月满燕台。\n仙人阁在银河上，嬴女箫从碧落来。\n江叶自随山叶舞，烛花偏傍菊花开。\n风尘荏苒年华异，莫怪临岐数酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55867,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿江氏","author":"李梦阳","text":"寻山累日山中宿，玉港回镳见尔家。\n世远楼台乔木里，族繁门巷一溪斜。\n深冬野竹犹风叶，细雨檐梅已冻花。\n惆怅哲人今异代，王峰回首碧参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55868,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谷日酬郑屠二省使携酒见访","author":"李梦阳","text":"殊方谷日轩齐过，返照虚窗暖自通。\n短鬓江湖今会少，早春阊阖旧游同。\n越南闽北风烟际，岸柳园梅霁雪中。\n时世艰难须共济，此生杯酒任西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55869,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"滕阁访屠子感赠","author":"李梦阳","text":"章门屡出缘寻子，滕阁留欢晚不回。\n霜落碛洲江渐细，日斜乡国雁还来。\n红巾未信干戈息，白发能禁日月催。\n千古栋云帘亦捲，西山秋色为谁开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55870,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨秋友人见过有赠","author":"李梦阳","text":"时芳巳后重阳雨，摇落深惊昨夜风。\n鸦雀小亭云竹静，蒹葭寒水赣江东。\n诗名海内逢高适，人物吴中有阿蒙。\n数过淹留非纵酒，异乡搔首各飞蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55871,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"较射毕青云峰示诸生","author":"李梦阳","text":"射毕孤峰聊独上，绕峰冬树发孤云。\n天开远岫迟迟见，木落寒江细细分。\n礼乐衣冠先此地，纲常簪组愧斯文。\n亨衢接武寻常事，孝子忠臣百世芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55872,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"发南浦赠人","author":"李梦阳","text":"大寒冰雨何纷纷，晓行日临江吐云。\n得风舲舸故相逐，异港凫鸥还自群。\n浦南蓼洲春欲动，岸西雪山晴未分。\n与君接席向杳霭，吟坐传杯侵暮曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55873,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上逢罗通政","author":"李梦阳","text":"秋乘綵鹢修春服，晓解牙章拜五云。\n三十超迁门下省，迟回瞻恋圣明君。\n烈风江上年垂暮，把酒旗亭袂忍分。\n昼锦故山家庆集，堂开鹤发野梅芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55874,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清江彭君幽居","author":"李梦阳","text":"新霁隔城江色来，僻居春暮径花开。\n当门银杏有千岁，穿叶黄鹂能百回。\n南徼云沙曾杖钺，北山薇蕨且衔杯。\n波深五月鲥鱼至，独钓吟行鸥不猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55875,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题严编修东堂新成","author":"李梦阳","text":"城居市远同村僻，堂构春成属燕忙。\n星槛夜凭斜北斗，日窗朝坐影扶桑。\n问奇颇类扬雄宅，醒酒真轻李相庄。\n喜即系丹临秀浦，恨犹榰笏背钤冈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55876,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泰和南行罗通政舟送","author":"李梦阳","text":"开船日午君俄至，逆水开尊得并船。\n贪数岸花杯不记，巳冲江雨缆犹牵。\n云山楚越相逢地，剑佩京华始识年。\n感昔愿仍还省阁，顾今俱巳静风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55877,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄孟御史谪桂林教授","author":"李梦阳","text":"长沙贾谊君仍远，南涉三湘复九疑。\n虎豹深山聊深雾，蛟龙得雨固须时。\n行藏学阁苍梧夕，鼓角夷城白发悲。\n怅望适荆心岂忝，飘零极海趐非垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55878,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南康至日送韩训导赴湖州推官","author":"李梦阳","text":"黯黯寒冬湖水头，迁官别我向湖州。\n吾道百年逢小至，雪江千里属安流。\n飞腾刑狱官非忝，简拔朝廷意实优。\n见说东南力巳竭，哀矜此外尔何求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55879,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仰头遇友夜泊感赠","author":"李梦阳","text":"舟夜双灯倚碧滩，江云蔼蔼覆春湍。\n中年独觉沧洲稳，直道谁非行路难。\n坐里旌旗环汇泽，花时金鼓发长安。\n时危故国思芳草，懒慢先君得桂冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55880,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"龙沙饯胡子还城","author":"李梦阳","text":"春卿送弟返扁舟，子孟还城设饯游。\n树荫金沙开锦席，花迎楚鸟劝吟瓯。\n平风岸压鼋鼍窟，倒日江明鹳雀楼。\n古木徐亭偏寂寞，醉希凝望水东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55881,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别太华君","author":"李梦阳","text":"自我徘徊襄汉间，秋风倏忽吹襄山。\n鹙鸧竟日乱洲渚，鸿雁孤鸣愁草菅。\n秦路伤心紫芝坼，楚岩回首桂花斑。\n层城月出歌钟满，谁念杨雄独闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55882,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠何君迁太仆少卿","author":"李梦阳","text":"省客新乘卿士车，寻盟特别水云居。\n还朝贾谊元前席，去国虞生合著书。\n贪顾休轻冀野马，祖行亲钓汴河鱼。\n虚疑厄闰春情晚，驿路群花宛宛舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55883,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日赴监察许君之宴同张监察","author":"李梦阳","text":"霜府池亭夏亦寒，捲帘河岳火云残。\n筵开冰动琅玕簟，酒伴瓜行白玉盘。\n蓦石寻花时径往，跃鱼投饵晚留欢。\n孰教逃暑陪骢马，自分清朝老钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55884,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柬赵训导二首赵安边营将家子读易人也 其一","author":"李梦阳","text":"安边坐堡近沙场，白日胡沙惨惨黄。\n彀弩汝兄增品秩，操觚吾子独文章。\n双龙一命新朝阙，三鳝诸生巳报堂。\n授易未容轻管辂，揲蓍端合契羲皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55885,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柬赵训导二首赵安边营将家子读易人也 其二","author":"李梦阳","text":"田园共傍古萧关，舞凤城临斩断山。\n连茹实期王贡上，转蓬俄聚洛河间。\n风尘落叶频惊眼，苜蓿深杯且破颜。\n宋岳魏台俱不没，及秋骑马肯同攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55886,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬和许监察九日对菊之作","author":"李梦阳","text":"风檐落叶随行步，坐近寒花引浊醪。\n久客重阳还细雨，故山他日几登高。\n羁心汴馆频搴蕊，醉眼江门旧送涛。\n愿戢霜威长晚色，剩抽英响续遗骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55887,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬和李子夏日游天王寺见赠","author":"李梦阳","text":"玉皇诸阁锁空寥，夙昔攀缘客互招。\n细细嵩云通佛栱，冥冥河气度僧寮。\n柏潭路古摇晴荔，竹洞城阴掩热椒。\n闻尔昨游吾自阻，碧纱谁并照烟霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55888,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜郑生至自京师传崔陆徐何诸人消息","author":"李梦阳","text":"汝从京国传消息，屈指离吾几换年。\n当日应刘俱老健，朅来燕赵自风烟。\n阳回草木清霜后，岁暮宾朋醉眼前。\n别业旧台携手在，野鸿沙鸟日翩翩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55889,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台冬日喜郑生归集","author":"李梦阳","text":"予从汝去稀过此，即使经过亦惘然。\n乍聚酒杯须落日，久晴腊月有和烟。\n向阳小草纤纤出，傍水浮云宛宛连。\n野立举天昏色起，好横酣眼望三川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55890,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"正月二日台卿李公监察毛公袁公枉驾而顾毛归有作辄次其韵二首 其一","author":"李梦阳","text":"君子三阳元并进，朝廷四海况为家。\n冠弹贡氏非吾愿，星聚荀门敢自誇。\n走洗玉盘深映竹，骄嘶骢马半衔花。\n绿尊未倒归须夜，台柏无言已宿鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55891,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"正月二日台卿李公监察毛公袁公枉驾而顾毛归有作辄次其韵二首 其二","author":"李梦阳","text":"吾生五九笑吾涯，短圃低墙即是家。\n酒熟喜当宾客过，诗成惭使世人誇。\n日临河岳云俱色，春入楼台树自花。\n转盻不堪天地异，得栖无小后啼鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55892,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和毛监察秋登明远楼之作","author":"李梦阳","text":"院锁帘垂白日幽，为谁乘兴独登楼。\n地平嵩岳窗中出，天倒黄河槛外流。\n坐对炉烟云并起，醉摇霜笔树还秋。\n可怜大厦须梁栋，未展那知匠氏忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55893,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪后困酒和王左史","author":"李梦阳","text":"旭日上雪檐溜悬，广文先生犹醉眠。\n床头绿樽巳交卧，解酲复倒囊中钱。\n开门泥泞午活活，有客骑马来翩翩。\n强起梳头煨芋栗，暖杯寒光仍四筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55894,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柬边子变前韵","author":"李梦阳","text":"繁丘草青春可怜，欲往恰值春风颠。\n应门童子不通客，空同先生闲自眠。\n柳长故袅金色缕，梅落尽铺白玉钱。\n安得即游共尔阁，满引香醪花簇筵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55895,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"仲春繁台饮饯醉归口占呈陈边二使君","author":"李梦阳","text":"昼日起风花欲开，过鸿未尽巢燕来。\n看山巳严阳翟驾，群饯复聚梁王台。\n苦云离合每不易，便醉颠倒何嫌猜。\n背阁碧树故袅袅，当筵哢鸟时徘徊。\n不见当年艮岳盛，今日累累青草堆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55896,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日过遂平将军第同李尹","author":"李梦阳","text":"十年不到将军第，一日重来令尹偕。\n春色不改延客阁，芳树尽覆弹琴斋。\n寻香槛蝶娟娟逐，竞暖池鱼宛宛皆。\n晚步鹿葱惊欲放，续游无吝玉为牌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55897,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠王推官相国之子","author":"李梦阳","text":"青年藉甚王推府，得郡吞江复据湖。\n楚楚骅骝当道路，英英秋月坐冰壶。\n三槐旧业承非忝，驷马高门望与俱。\n相国醴筵今更数，在邦无忆鲤庭趋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55898,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"高门堤陈氏别业夏集","author":"李梦阳","text":"门堤平野突崔嵬，幔屋深林石磴回。\n盛世行藏吾学圃，异乡天地此登台。\n冯轩五月凉风入，移席孤城返照来。\n急管暮催杯更进，醉翁非为酒徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55899,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日繁台院阁赠孙兵部兼怀大复子","author":"李梦阳","text":"独马孤城送客回，乱蝉高柳出衔杯。\n晴天河岳今开阁，战地金元晚上台。\n才自筹边期献纳，义犹倾盖愧徘徊。\n何休门客如君几，北望天风万里来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55900,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送杨子还里","author":"李梦阳","text":"曾修书院旴江侧，君去怀予试一游。\n当日水山应更好，别来松桂几经秋。\n谢诗早向麻源觅，颜帖时从庙碣收。\n此外何求惟有醉，背山合起望泉楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55901,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张工副","author":"李梦阳","text":"为官秦邸君西去，因忆简王相遇时。\n池出异莲要作赋，馆开修竹坐传卮。\n龙旂寂寞还云气，鹤驭飘翩秪梦思。\n寄问白头强相国，醴筵吟笔似前随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55902,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏行人赍太皇太后哀诏过此以病淹于郊馆獛为作诗","author":"李梦阳","text":"野馆春云剧暮阴，病臣哀诏此经临。\n君亲敢谓三江远，涕泪悬知万国心。\n风砌独花堪愤闷，雨檐双燕足清吟。\n遐陬每引前星望，赖尔兼程布此音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55903,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"城南新业期王子不至","author":"李梦阳","text":"新园本欲誇王史，竟日城南期不来。\n即使屋荒还五柳，忍令春暮只孤台。\n对人芳药翻翻出，近日浮云细细开。\n巳嘱瓮头封绿蚁，明朝倘许尽馀杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55904,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再期王左史不至","author":"李梦阳","text":"地散官拘此亦希，草堂重约忍偏违。\n元期芍药枝枝赏，忽复葵榴片片飞。\n诸客酒停时望旆，孤城日落尚留扉。\n人生乐事真能几，野立苍云又白衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55905,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"繁台次秦氏韵","author":"李梦阳","text":"一秋今到十贤堂，万事伤心叹渺茫。\n草绿梁台犹殿阁，花残宋苑只宫墙。\n天南星宿元朝斗，崖北灵芝本向阳。\n未老息栖终傍此，预愁人拟卧龙冈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55906,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送田生省母兄如晋","author":"李梦阳","text":"匹马遥冲落日微，万山何处是筵闱。\n途纡沁上花应发，春尽并门雪尚飞。\n临柏乍开荆树阁，傍萱重著不莱衣。\n冯高试望风云气，大驾新从此路归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55907,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄题孤氏苕溪草堂孙是时始有婚事","author":"李梦阳","text":"苕溪之傍何者丘，几时自卜林塘幽。\n巳闻宽田足放鹤，曾否馀钱兼买舟。\n狎人鸂鶒元成偶，近槛芙蓉故并头。\n尘世要留风格在，东南聊作醉乡游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55908,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送毛监察还朝是时皇帝狩于杨河","author":"李梦阳","text":"楚生临水送将归，黎子当筵赋式微。\n天下汝为真御史，百年吾是旧渔矶。\n沙寒白日蓬科转，风起黄河木叶稀。\n此去有书应历上，太平天子本垂衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55909,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送李行人还朝","author":"李梦阳","text":"南使楼船漫北回，西巡车驾歘东来。\n星辰再逐千官入，阊阖重临万国开。\n寒尽旌旗犹拂雪，春新环佩且沾梅。\n虞弦定有薰风奏，伫望阳和遍九陔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55910,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"逢吉生汴上","author":"李梦阳","text":"汴上相逢俱白头，秦中却忆少时游。\n烟花楼阁春风日，锦绣山河百二州。\n未论听莺穿细柳，实因走马出长楸。\n金尊邂逅今宵月，明发仍悬两地愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55911,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郊园夏集别李沔阳","author":"李梦阳","text":"东门惯种邵平瓜，彭泽新成处士家。\n晨起忽嘶花木马，君来同泛柳边槎。\n向人菡萏元随槛，哺子鵁鶄各占沙。\n明发路岐愁把袂，秋风江汉有归艖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55912,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"李沔阳饮后田郑二子复集于斯庄望见陂水骤落众颇讶之","author":"李梦阳","text":"五马柴门夜巳回，二豪尊酒旦重开。\n林乾鸟雀群应喜，水落凫鹥半不来。\n疏懒合收任氏钓，啸歌直慕阮公台。\n亦知河朔非凡辈，逃暑无辞掌上杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55913,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早春酬张客见赠","author":"李梦阳","text":"周王祈雪罢灯游，楚客思乡迥独愁。\n不雨风云常袅袅，入春江汉转悠悠。\n秾花锦石添霜鬓，横笛短箫悲綵舟。\n岐路断肠俱不减，予今搔首为西州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55914,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"田居嘲答李沔阳","author":"李梦阳","text":"郊园自枉君侯车，日日触热寻吾庐。\n柳长风多秪欲睡，瓜成雨来仍用锄。\n远田阴阴立黄鹄，新波双双跳白鱼。\n即令石水泥五斗，岂无五马愁骑驴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55915,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"别熊御史出塞","author":"李梦阳","text":"今夕何夕春风微，把酒长歌春兴违。\n娇莺乳燕黯不语，嫩蕊柔条空自稀。\n都门车骑明朝发，关下行人三月归。\n北望湖沙青草尽，祁连山外断鸿飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55916,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春望柬何舍人","author":"李梦阳","text":"城南春望春可怜，小苑高楼生暖烟。\n几家芳草断肠处，无数落花吹笛边。\n川原萋萋入暮雨，车马骎骎矜少年。\n欲向仙郎誇白雪，阳春久巳绝人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55917,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠张含","author":"李梦阳","text":"孔门诸子接升堂，杜甫交游尽老苍。\n万里南归望秋月，一尊对别逢春阳。\n生儿当如李亚子，有父况作尚书郎。\n肃肃云鸿天路永，樊篱斥鴳莫空翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55918,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题环上人精舍","author":"李梦阳","text":"前月到寺萱草香，今月到寺葡卜长。\n潢潦盈盈旭日动，楼阁洒洒高云凉。\n出门每恨市城隔，浮世空嗟车马忙。\n圆月清秋期重访，即扳留卧赞公房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":55919,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]