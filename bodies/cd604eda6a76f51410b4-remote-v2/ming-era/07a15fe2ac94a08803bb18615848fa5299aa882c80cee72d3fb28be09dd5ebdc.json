8,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卫河道中和丘长孺惜别 其二","author":"袁宏道","text":"拟上青霄别有关，身无健翮莫追攀。\n而今已是孤飞鹤，毛羽摧颓返故山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卫河道中和丘长孺惜别 其三","author":"袁宏道","text":"辞却墙东好里邻，思量来嚼浩衢尘。\n素衣变尽衰容减，到底还他赤骨贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卫河道中和丘长孺惜别 其四","author":"袁宏道","text":"琴绝休悲大小弦，长贫长病岂须怜。\n朝春暮绩生尤苦，争得魂归自在天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卫河道中和丘长孺惜别 其五","author":"袁宏道","text":"陌上秋风吹冷埃，西州门巷转堪哀。\n梨花残落刺桐死，每诣君时哭一回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卫河道中和丘长孺惜别 其六","author":"袁宏道","text":"柔橹轻风觉有情，月高牛渚看潮生。\n江神木客争传语，可是袁家旧阿宏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卫河道中和丘长孺惜别 其七","author":"袁宏道","text":"耗尽雄心鬓亦皤，灞亭无奈尉谁何。\n珊瑚百尺根株老，不信天家无铁罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卫河道中和丘长孺惜别 其八","author":"袁宏道","text":"别泪如倾祗赋诗，更无一物可相贻。\n自矜亦识汾阳老，眼底无君剑竖眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾退如别诗次韵 其一","author":"袁宏道","text":"茂草长林不共栖，孤灯寒箔影凄凄。\n鹧鸪死去犹嫌北，鹦鹉道成必向西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾退如别诗次韵 其二","author":"袁宏道","text":"白傅可能无舞女，高柔那得少贤妻。\n柳浪湖上君来日，把酒唯听一个鹂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁未初度泊池阳自寿兼忆李安人 其一","author":"袁宏道","text":"溪头微雪点疏松，睡起开窗对远峰。\n谁写画图来寿汝，谢家江上九芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁未初度泊池阳自寿兼忆李安人 其二","author":"袁宏道","text":"四十年间大宅身，思量何事不飞尘。\n而今欲学皋桥隐，少却堂前举臼人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中听王姬弹琴","author":"袁宏道","text":"懒把腰肢学小蛮，凉云初月淡垂鬟。\n携君却好青山去，三峡流泉在指间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中看山二仲呈诗一章后来似亦粗能者喜而有作","author":"袁宏道","text":"一生痴计是云烟，五字吟成雪满颠。\n老我已非前赤壁，稚儿所得小斜川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"廿三日至蒲圻谢中丞出迎时年九十二鹤发丹容尚能骑乘真人中瑞也口占二绝以纪其盛 其一","author":"袁宏道","text":"一行旌节万人从，争看前朝老卧龙。\n杞梓楩楠俱朽尽，就中留得两高松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"廿三日至蒲圻谢中丞出迎时年九十二鹤发丹容尚能骑乘真人中瑞也口占二绝以纪其盛 其二","author":"袁宏道","text":"曾看沧海化红尘，云过沙飞阅世人。\n便是圣朝祥瑞物，何须芝草与麒麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢公伯子京兆君时年七十趋走膝下有若稚子凡谢公拜起俯仰皆京兆君扶之","author":"袁宏道","text":"碧瞳红颊照霜明，尚父前头倚杖行。\n七十老翁犹膝下，为人争不羡为兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天宁洲逢老僧一百一岁 其一","author":"袁宏道","text":"一寸眉垂霜覆肩，额光如镜语清圆。\n南山坐阅松株老，不上历头四十年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天宁洲逢老僧一百一岁 其二","author":"袁宏道","text":"开元天子最风流，曾见南巡锦幄舟。\n栾大也知非诳语，老人大父昔同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天宁洲逢老僧一百一岁 其三","author":"袁宏道","text":"问年知得是辰生，甲子校君少一更。\n过去一般无影迹，何妨呼我作同庚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日登王章甫水明楼 其一","author":"袁宏道","text":"经年劳碌马蹄间，久客虽归也不閒。\n争似水明楼上坐，浪花影里看春山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日登王章甫水明楼 其二","author":"袁宏道","text":"云山虽近不相亲，草色烟光各自春。\n君欲读书我从仕，何曾真作看山人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偕王章甫陈公弼登黄鹤楼 其一","author":"袁宏道","text":"江流千顷蹙云烟，楼阁虽高不似前。\n画板朱檐遮取尽，争教容纳好山川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偕王章甫陈公弼登黄鹤楼 其二","author":"袁宏道","text":"两家稚子共追随，似我与君初上时。\n松老石攲楼亦换，可容玄鬓不成丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岘首山观羊叔子堕泪碑","author":"袁宏道","text":"欲知叔子恩多少，但看龟趺碧浅深。\n铜雀台中歌舞妓，那能挥泪到如今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"慱望驿","author":"袁宏道","text":"荒烟残戍几家村，庭锁苍苔古木昏。\n不恨君家开远略，恨君尚未识昆崙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王郡丞邀饮阳和楼 其一","author":"袁宏道","text":"青天一碧翠遮空，浪捲云奔夕照中。\n郭外荷花三十里，清香散作满城风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"王郡丞邀饮阳和楼 其二","author":"袁宏道","text":"十丈朱旗照水殷，家家箫鼓乐江山。\n千峰如画供杯酒，不道清时是等閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中山刘刺史邀饮西溪","author":"袁宏道","text":"碧树深深带水斜，门垂果实类山家。\n携将千日中山酒，来醉西溪六月花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杪秋陪祀山陵同陶孝若黄道元谢响泉入仙人洞洞奇绝去驰道二里许","author":"袁宏道","text":"红叶霜花积几重，青山蜕骨走眠龙。\n伊祈善卷俱陈迹，各向秋云占一峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘲谢道人白须 其一","author":"袁宏道","text":"毵毵霜雪几经春，五十年边未老身。\n借与城西往道士，虚添年岁诳时人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘲谢道人白须 其二","author":"袁宏道","text":"紫陌飞沙扑面行，和烟和雪看春明。\n身无官职家无媵，正好从君颊上生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘲谢道人白须 其三","author":"袁宏道","text":"奼水仙铅积许多，霜根欲茁可如何。\n若教移去乌纱底，?买春煤二百螺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嘲谢道人白须 其四","author":"袁宏道","text":"箧里无钱买地黄，花前雪色照人光。\n晓窗扣齿焚香罢，一盏山中芦菔汤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏潜夫侍御买燕姬为赋合欢诗 其一","author":"袁宏道","text":"黛螺香里惠文冠，消尽青霜铁面寒。\n恰似江南花鸟手，画将树棘傍兰兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏潜夫侍御买燕姬为赋合欢诗 其二","author":"袁宏道","text":"夜深犹未解明珰，争奈呻吟老孟光。\n兰火渐昏衣渐缓，袖花微带橘陈香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏潜夫侍御买燕姬为赋合欢诗 其三","author":"袁宏道","text":"灯前小语背流苏，偷看封章就也无。\n花外日高屏扇掩，府中未省有啼乌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苏潜夫侍御买燕姬为赋合欢诗 其四","author":"袁宏道","text":"西台御史气如云，白简霜飞海外闻。\n归去海棠花下语，却妨鹦鹉作弹文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻阁试题为兰亭修禊图效作二首 其一","author":"袁宏道","text":"分别层溪与远峦，天章寺里雨中看。\n会稽内史风流甚，赖得中朝有谢安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻阁试题为兰亭修禊图效作二首 其二","author":"袁宏道","text":"石榻谁知定武讹，绽纹犹识旧宣和。\n凭君莫话冬青树，添得青山泪许多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送医者黄生谒东诸侯","author":"袁宏道","text":"橘老柑黄不奈何，飘然艇子出烟波。\n而今海上单方几，王不留行一味多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送从军罗山人还大足","author":"袁宏道","text":"老去渐思云水乡，苔斑蚀尽绿沈枪。\n青袍白马翻然去，念取昌州旧海棠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"散木至自公安","author":"袁宏道","text":"江上分携才一年，鬓如秋草面如烟。\n不知老态增多少，但觉头巾阔似前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题送显宗禅师南归 其一","author":"袁宏道","text":"秋来芍药已无枝，老去湖蚕未有丝。\n古井澄澜乾欲尽，阿谁肠断比红儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无题送显宗禅师南归 其二","author":"袁宏道","text":"迦陵命命不同飞，又喜开笼放雪衣。\n莫向甜桃言苦李，羞将远志换当归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花烛诗为顾小侯所建作时所建娶妇巳五年 其一","author":"袁宏道","text":"灯煤和就染双眉，想得春窗欲曙时。\n只为顾家妇大好，五年尚赠合欢诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花烛诗为顾小侯所建作时所建娶妇巳五年 其二","author":"袁宏道","text":"百合香焚百子罗，秋江如面柳如蛾。\n侯家夫婿杨家女，占却人天福许多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广陵曲戏赠黄昭质时昭质校士归 其一","author":"袁宏道","text":"一络青铜一面春，雕阑处处锁朱轮。\n试将校黑分黄眼，品取如花似上人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广陵曲戏赠黄昭质时昭质校士归 其二","author":"袁宏道","text":"绯袍牙带鞠躬迎，认得风骚旧长卿。\n莫似江南韩老子，教他炷艾待门生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广陵曲戏赠黄昭质时昭质校士归 其三","author":"袁宏道","text":"肌香薰透绣罗襦，小立窗前拭粉朱。\n挂起眉图亲与较，果然颜色胜当炉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"广陵曲戏赠黄昭质时昭质校士归 其四","author":"袁宏道","text":"深束腰肢浅蹙蛾，伴娘频促奈他何。\n白罗一尺宽如许，受得巫山雨几多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题潘稚恭小像 其一","author":"袁宏道","text":"当年曾见虎头真，长短浓纤各有神。\n只怪安仁描不似，为他丰骨异时人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题潘稚恭小像 其二","author":"袁宏道","text":"牙光绢上白波重，骨肉调匀粉墨浓。\n若要识他春月柳，还须雪里看王恭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予公贫病无日开颜闷坐舟中口占乞笑","author":"袁宏道","text":"骨如枯竹面如灰，顷刻酸呼四五回。\n人世万千穷恼病，被君包揽上身来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题方医卷方歙人客高邮","author":"袁宏道","text":"儿童每见求甘草，道侣相逢话药方。\n高邮城里寻常去，收得姜芽几许长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公超谷","author":"袁宏道","text":"醉里提壶荷锸还，大伸脚步即登山。\n何如且作收云法，施得清光与世间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"希夷峡 其一","author":"袁宏道","text":"白石青山眼倦开，风云长到枕边回。\n梦中亦有敲门客，报道庄周骑蠂来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"希夷峡 其二","author":"袁宏道","text":"曾挈东皋到酒泉，而今醉国也骖然。\n睡乡若有閒图籍，欲向先生受一廛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"回心石","author":"袁宏道","text":"华顶不高涧不深，一回遗世一登临。\n若为题向长安道，回却朱门紫陌心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"千尺㠉至百尺峡","author":"袁宏道","text":"千仞云中缀一丝，势危那免堕枯枝。\n算来白石清泉死，差胜儿啼女唤时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡孙愁","author":"袁宏道","text":"仄岭东移半尺苔，如何横度碧崔嵬。\n上头若有朝三叟，料得胡孙也喜来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"擦耳岩","author":"袁宏道","text":"过客时时耳属垣，倚天翠壁亦何言。\n欲知悬径歌危甚，看我青苔天面痕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"苍龙岭","author":"袁宏道","text":"瑟瑟秋涛谷底鸣，扶摇风里一毛轻。\n半生始得惊人事，撒手苍龙岭上行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卫叔卿博台","author":"袁宏道","text":"云中转转试钩梯，棋路分明似芥畦。\n便欲与君终一局，只愁石烂水流西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]