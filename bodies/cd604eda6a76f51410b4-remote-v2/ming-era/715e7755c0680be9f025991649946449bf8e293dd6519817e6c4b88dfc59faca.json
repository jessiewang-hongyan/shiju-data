y","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚晴二首 其二","author":"卢龙云","text":"久雨农家厌，新晴野望同。\n楼台多暮色，并映海云红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画四首 其一 琴","author":"卢龙云","text":"已得琴中趣，更操弦上音。\n美哉山泽意，谁解识汾阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画四首 其二 棋","author":"卢龙云","text":"妙用方员里，神机动静间。\n旁观应未悟，当局有馀閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画四首 其三 书","author":"卢龙云","text":"万纪因心画，千言萃圣文。\n总缘笔有彩，随处掞风云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画四首 其四 画","author":"卢龙云","text":"远山看竞秀，近水喜常清。\n最善丹青理，笔端尽物情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝应湖望莲花盛开","author":"卢龙云","text":"积水重湖满，新蒲绿叶齐。\n荷花香十里，宛似若耶溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20750,"sha256":"dc0