[{"title":"即事六首 其二","author":"宗臣","text":"自日频搔首，青山一杖藜。\n星辰千骑入，风雨万家迷。\n有路难舟楫，中天急鼓鼙。\n愁心与芳草，江上共萋萋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29264,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事六首 其三","author":"宗臣","text":"赤羽遥传越，黄霾近接吴。\n夷歌分鼓吹，野哭散蘼芜。\n日落江流急，天高海气孤。\n中原有廉颇，尔辈敢长驱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29265,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事六首 其四","author":"宗臣","text":"虏骑纵横甚，将军转斗频。\n两间迷白昼，万象失黄尘。\n江海遂流血，弓裘岂着身。\n招魂谁与赋，酒泪寄青蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29266,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事六首 其五","author":"宗臣","text":"华夏翻连寇，江淮遂苦兵。\n鲸鲵杨子渡，日月棘门营。\n侠气荆卿剑，雄心汉吏缨。\n尔曹何足虑，流涕此苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29267,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事六首 其六","author":"宗臣","text":"坐叹兵机失，兼忧国计存。\n干戈在淮海，消息已乾坤。\n授钺曾诸将，宵衣独至尊。\n定知哀痛诏，早晚下江门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29268,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄子与明卿元美三子二首 其一","author":"宗臣","text":"同心久相失，羁思近何如。\n星出窥龙剑，天长阻雁书。\n满江纷甲鼓，落日泣樵渔。\n祛住情兼苦，奚方定卜居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29269,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄子与明卿元美三子二首 其二","author":"宗臣","text":"岂乏青云侣，其如白雪盟。\n一分燕楚阔，三见柳梅生。\n眼底簪袍计，身前词赋名。\n放歌当落日，的的为谁明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29270,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄真州张子二首 其一","author":"宗臣","text":"世路惊投璧，君才类握珠。\n谈经深岁月，垂钓任江湖。\n落日千峰紫，长天一剑孤。\n凌风有羽翼，与尔立相须。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29271,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄真州张子二首 其二","author":"宗臣","text":"一望隋堤草，孤吟楚岸花。\n赋成似班马，身在只烟霞。\n夜月怀湘瑟，秋风起汉槎。\n斗间垂气色，吾欲问张华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29272,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元美访我百花洲上夜集四首 其一","author":"宗臣","text":"君来何节钺，秋到正江湖。\n斗窒群星聚，天门二曜孤。\n古人穷抱玉，吾道忌投珠。\n岁晚鱼龙寂，临流未可呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29273,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元美访我百花洲上夜集四首 其二","author":"宗臣","text":"终日不得醉，相看独柰何。\n狂心知尔甚，青眼向人多。\n席已移星月，衣犹挂薜萝。\n兴来歌楚调，雪色满江河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29274,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元美访我百花洲上夜集四首 其三","author":"宗臣","text":"坐对百花落，孤登万里楼。\n醉开吴楚色，狂失凤鳞愁。\n握手青灯少，论心白日浮。\n相思曾往昔，泪逐大江流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29275,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元美访我百花洲上夜集四首 其四","author":"宗臣","text":"双眼人何白，孤怀尔独长。\n相看鸿鹄志，不厌芰荷裳。\n黄菊纷垂露，丹枫莽下霜。\n湖南泛明月，髣髴对潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29276,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐山人还吴二首 其一","author":"宗臣","text":"问君何处去，一骑大湖边。\n久客青春暮，多愁白发先。\n征衣裁薜荔，长剑倚风烟。\n江上波涛急，新诗莫浪传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29277,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐山人还吴二首 其二","author":"宗臣","text":"去住悲生事，乾坤总畏途。\n梅开春到楚，柳折晓归吴。\n倚棹江云乱，传书海月孤。\n知君饶雅思，早晚着潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29278,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜顾二丈来集二首 其二","author":"宗臣","text":"一径阴阴入，孤烟去去斜。\n江亭频载酒，岩桂正逢花。\n吹笛惊黄鸟，持竿散赤霞。\n看君灵气甚，早晚问仙槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29279,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得徐子与书","author":"宗臣","text":"不分黄尘色，稍惊白雁音。\n传书燕塞远，落日楚江深。\n戎马乾坤泪，豺狼道路心。\n闻君持汉节，松下拟抽簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29280,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"简陆子和二首 其一","author":"宗臣","text":"岁月仍吾病，风尘柰尔何。\n青天应自问，白雪向谁歌。\n夜立残砧杵，园行久薜萝。\n相逢恨咫尺，况乃隔江河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29281,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"简陆子和二首 其二","author":"宗臣","text":"握手朱明过，惊心白露漙。\n江平低雁翼，潮落进渔竿。\n野色蘼芜净，秋声蟋蟀寒。\n相思对新月，疑在异乡看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29282,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋遣骑迎沈二丈北庄","author":"宗臣","text":"遥怜沧海上，独对白鸥群。\n客自殊方到，秋看此夜分。\n凌风孤骑远，扫径一鸿闻。\n明月湖南早，君无待暮云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29283,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋无月呈席上诸公二首 其一","author":"宗臣","text":"翩翩携杖至，爱此河中洲。\n不见关山月，空分天地秋。\n鱼龙潭水黑，松桂石门幽。\n瑶瑟何人抱，湘灵未易求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29284,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋无月呈席上诸公二首 其二","author":"宗臣","text":"寂寞自松径，苍茫任草庐。\n高云莽不止，明月竟何如。\n席上频窥酒，盘中仅辨蔬。\n天风如可驭，吾欲摘蟾蜍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29285,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜同李伯章高子明徐养浩泛湖","author":"宗臣","text":"高沙回白鹭，远水到青天。\n棹恐群星乱，杯惊孤月圆。\n秋声来薜荔，夜色净婵娟。\n玉笛君能把，吾将弄紫烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29286,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄山人夜坐","author":"宗臣","text":"日散千峰紫，烟收万树青。\n高云去莽莽，孤月寒冥冥。\n岁序已新雁，江沙空乱萤。\n餐霞真愧汝，徒复问黄庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"无月","author":"宗臣","text":"可怪清秋月，难看永夜辉。\n蟾蜍高不落，乌鹊暗能飞。\n迷径频呼烛，惊寒骤问衣。\n群公未应去，云色渐霏微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客夜","author":"宗臣","text":"岁暮青山远，天空白雁残。\n孤舟凌夜发，长剑共谁看。\n鼓角高城急，星辰大地寒。\n中宵起遥思，仓卒负渔竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陪祀山陵二首 其一","author":"宗臣","text":"阊阖门重启，星辰地一隅。\n寂寥群籁动，惨淡百灵趋。\n剑佩当风乱，松楸上月孤。\n他年神武气，或恐未荒芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陪祀山陵二首 其二","author":"宗臣","text":"石马鸣何日，金凫起别宫。\n关山不改色，天地自相雄。\n惆怅君臣礼，凄凉岁序同。\n泰陵千古泪，一洒翠华东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山陵道中四首 其一","author":"宗臣","text":"处处春云色，相逢上翠微。\n枌榆向人发，鸿雁背天飞。\n列骑松为盖，群峰雾作衣。\n岁华空浩荡，难问故山薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山陵道中四首 其二","author":"宗臣","text":"吾爱天门近，何妨日驭斜。\n愁边归燕子，忧外避龙蛇。\n不辨层崖树，难逢三月花。\n向来胡骑入，满路散悲笳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山陵道中四首 其三","author":"宗臣","text":"路迷人屡问，路险骑常停。\n折柳新能绿，看山近失青。\n峰高天兀兀，泉细日泠泠。\n何处无春色，吾今爱地灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山陵道中四首 其四","author":"宗臣","text":"马迟榆柳径，人指鹭鹓班。\n群帝留弓剑，千官肃佩环。\n风云回紫塞，日月满青山。\n王气中天在，朝朝护汉关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过明卿","author":"宗臣","text":"频来春骑远，最苦夜杯传。\n深语江河在，雄心日月前。\n千秋难自定，万事竟谁先。\n岂作巴渝客，常骄白雪篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29296,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得于鳞书二首 其一","author":"宗臣","text":"重来击筑饮，偏忆和歌人。\n明月漳河夕，梅花碣石春。\n愁难千里破，情到尺书真。\n谁不疑斯道，君当爱此身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得于鳞书二首 其二","author":"宗臣","text":"旧侣淹漳水，新诗寄汉关。\n凤麟千古色，鹓鹭众人班。\n易侧乾坤目，宁开案牍颜。\n蹇帷犹有赋，落日太行山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆弟","author":"宗臣","text":"忽是青春别，难堪白日移。\n江山一弟远，鸿雁尺书迟。\n湖上又芳草，淮南多桂枝。\n池塘尊酒夜，知尔重相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴舍人得子","author":"宗臣","text":"持我百年意，看君一日情。\n人间麟趾少，池上凤毛生。\n桂发燕山色，珠来合浦明。\n他时弄环语，应令楚妃惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实十首 其一","author":"宗臣","text":"当日梁鸿去，青山弄紫烟。\n形容疑好在，消息是谁传。\n鹘鸟岂来舍，龙蛇或值年。\n仓皇不可问，陨涕五噫篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实十首 其二","author":"宗臣","text":"使者春江到，传君隔岁书。\n开函生气色，数字慰踌躇。\n日月孤吟失，山河一病虚。\n皇一深忌汝，竟不免樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实十首 其三","author":"宗臣","text":"徘徊南斗下，历历少微星。\n一夜因风殒，高人遂不醒。\n孤云垂惨淡，万象骤沉冥。\n莫问西樵桂，千秋空复青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实十首 其四","author":"宗臣","text":"罗浮不可望，镇日紫霞封。\n尔把金光草，行吟第一峰。\n惊飙残薜荔，骤雨泣芙蓉。\n恐逐仙人去，青天跨白龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实十首 其五","author":"宗臣","text":"汝去亦何速，人生良已浮。\n苍梧一洒泪，赤石万峰愁。\n才或云霞妒，名非剑佩收。\n知无封禅草，汉使不须求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实十首 其六","author":"宗臣","text":"五子中原得，千秋仅一麾。\n壮心何遽折，吾道益堪悲。\n大海东南去，天风日夜吹。\n独留龙剑在，紫气斗间垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实十首 其七","author":"宗臣","text":"长安曾落日，为尔抱瑶琴。\n一鼓秋云白，潇湘寒色深。\n斯人遂不见，是物可无音。\n坐忆龙门曲，潸然泪满襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实十首 其八","author":"宗臣","text":"少别即成古，相逢岂在今。\n黄河难北注，白日似东沉。\n天地冥鸿志，文章逐鹿心。\n悲风吹大壑，夜夜助萧森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实十首 其九","author":"宗臣","text":"汉省空题柱，文园早闭关。\n生难看白发，死岂负青山。\n天柱浮云色，茫茫去不还。\n肯思黄石侣，万一到人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭梁公实十首 其十","author":"宗臣","text":"浮世谁能免，如君独可哀。\n荒榛满天地，玉树莽尘埃。\n裘马偏穷路，江山不尽才。\n更怜击筑者，萧索蓟门台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏夜同明卿元美游张氏园亭五首 其一","author":"宗臣","text":"尘途忽到此，世事顿相违。\n月色轻随马，松枝乱拂衣。\n相逢青满眼，并对绿成围。\n便作幽栖得，何须问钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏夜同明卿元美游张氏园亭五首 其二","author":"宗臣","text":"倏尔过山雨，萧然对石栏。\n双衣絺绤薄，五月薜萝寒。\n高竹翠难把，新松秀可餐。\n吴歌况在耳，真作故园看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏夜同明卿元美游张氏园亭五首 其三","author":"宗臣","text":"一径杳然入，参差绝可怜。\n古台荒自出，石磴曲相悬。\n林密难窥月，枝高易破天。\n谁能吹玉笛，吾欲弄苍烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏夜同明卿元美游张氏园亭五首 其四","author":"宗臣","text":"太虚何必问，一壑坐相收。\n橘柚山形古，藤萝石壁幽。\n杯疑天外把，人似月中游。\n莫作霓裳曲，翩翩不可留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初夏夜同明卿元美游张氏园亭五首 其五","author":"宗臣","text":"夜色乱相射，幽人那可禁。\n天流孤月白，庭落大槐阴。\n忽起千秋思，能空万里心。\n长吟一汗漫，纤露下衣襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻岛夷将逼湖州寄怀子与二首 其一","author":"宗臣","text":"兵已苍生苦，书仍赤羽愁。\n风吹远海立，潮压太湖流。\n鼓角天应裂，鲸鲵日不收。\n桃花藏战色，慎莫问渔舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻岛夷将逼湖州寄怀子与二首 其二","author":"宗臣","text":"汝在登天目，春来似绿林。\n荆榛黄钺入，烽燧白云深。\n百战江山色，千家陇亩心。\n当年一七首，应或作龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同余德甫吴明卿王元美再游张园 其一","author":"宗臣","text":"为爱林塘好，频从驷马来。\n仅成三日别，复作一尊开。\n桥忆牵衣草，庭思待月梅。\n昔心还卤莽，此夜重徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同余德甫吴明卿王元美再游张园 其二","author":"宗臣","text":"畏客双尊在，留人一榻迁。\n浮云去万里，明月更婵娟。\n细柳风藏碧，新榴夜失妍。\n无能永兹夕，心折薜萝前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同余德甫吴明卿王元美再游张园 其三","author":"宗臣","text":"不尽山灵僻，难持幽思翻。\n星辰莽相照，鸟雀一何喧。\n竹叶传金瓮，松花落石门。\n危峰一长啸，髣髴是昆仑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同余德甫吴明卿王元美再游张园 其四","author":"宗臣","text":"何处阳春调，来同此夕歌。\n地能燕市有，人得楚狂多。\n把盏青天坠，题诗紫石磨。\n一呼去魍魉，词组即江河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同余德甫吴明卿王元美再游张园 其五","author":"宗臣","text":"零露隔金掌，长天转玉绳。\n夜惊群象远，狂得寸心凭。\n高树歌能立，危岩暗可登。\n何当谢尘网，日日白云层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问余德甫病二首 其一","author":"宗臣","text":"浩荡俱燕市，萧条为马卿。\n茂陵拾瑶草，消渴望金茎。\n夕鬓裁诗短，秋云伏枕生。\n南楼今夜月，故向客愁明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"问余德甫病二首 其二","author":"宗臣","text":"独怜青桂侣，高卧白云楼。\n见尔能称病，何人肯倦游。\n星河双杵夕，风雨七陵秋。\n且莫歌芝曲，商山不易求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立秋夜明卿元美来集二首 其一","author":"宗臣","text":"尘心不自好，岁序莽相催。\n风起千门乱，秋随二客来。\n絺衣云共白，纨扇月同开。\n且莫悲摇落，吾惭作赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立秋夜明卿元美来集二首 其二","author":"宗臣","text":"酒至期晨漏，风来破夕阴。\n星辰垂户小，蟋蟀语庭深。\n白眼千年思，青天一夜心。\n并随秋色动，四顾起萧森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅明卿给事二首 其一","author":"宗臣","text":"世事凭谁问，浮生得尔同。\n有心俱欲折，无路不归穷。\n战伐乾坤色，安危将相功。\n君看鸣玉者，楚楚日华东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅明卿给事二首 其二","author":"宗臣","text":"萧然双鬓短，莽矣百忧新。\n白雪孤调世，黄金巧识人。\n势应骇积羽，心或急批鳞。\n遂恐风尘色，难图萝薜身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"明卿宅分得宫字","author":"宗臣","text":"翩翩傲世者，马上落青枫。\n把酒长安月，残秋碣石鸿。\n玄芝纷下蔡，白羽急西戎。\n向夜寒声起，衣然入汉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"德甫明卿元美肖甫夜过时肖甫将有使命矣得来字","author":"宗臣","text":"借问此何夕，秋高冀北台。\n浮云万里去，明月几时来。\n莫惜黄金尽，其如绿发摧。\n相逢不成醉，鼓角道途哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻子培下第赋此寄之","author":"宗臣","text":"怜汝不得意，上书今又回。\n秋风江色暮，愁见菊花开。\n抱玉时堪泣，投珠夜更哀。\n蓟门看白雁，曾否故园来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月骤寒二首 其一","author":"宗臣","text":"颇怪雷仍起，还惊雪乍飞。\n阴阳曾世变，顺逆总天威。\n白马纷传檄，黄龙正合围。\n北风休更急，汉卒夜无衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]