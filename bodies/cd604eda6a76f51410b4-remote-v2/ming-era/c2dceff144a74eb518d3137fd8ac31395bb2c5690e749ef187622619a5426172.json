[{"title":"赠宝藏太师","author":"欧大任","text":"师来京洛久随缘，记腊松枝石榻前。\n兜率天中先四日，无遮会里后千年。\n宝台藏现金轮色，白马经传贝叶篇。\n为问远公诸弟子，双林何似虎溪禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7366,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送胡宪使饬兵天雄","author":"欧大任","text":"西行开府拥旌麾，绣斧人看十载时。\n肘腋最雄三辅地，朝廷今重北门师。\n赵符已得临燕代，汉节曾持过月支。\n回首春明应渐近，莫令虚负曲江期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7367,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答朱兵宪秉器潼关见奇","author":"欧大任","text":"百二关城借使权，河山半在节楼前。\n仙人掌上浮云过，玉女池头片月悬。\n旧好几家留笔札，中原何地问櫜鞬。\n侧身西望骅骝远，沉陆金门祇自怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7368,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺蒙中丞加恩赐诰拜寿太恭人","author":"欧大任","text":"江光岭色起嶙峋，岁岁金书使节新。\n军府共尊中执法，主恩先赉太夫人。\n楼前朝宴笙为凤，海上秋风脯是麟。\n闻道瑶池明月里，西来青雀更逡巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7369,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送雷大将军出镇西夏","author":"欧大任","text":"一代鹰扬出武威，虎头燕颔似君稀。\n马经栈道风为御，箭过天山雪共飞。\n盟府勋名开世阀，玺书银夏总戎机。\n西征自昔封侯地，骠骑归时拜衮衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7370,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谢侍御叔蒙按浙","author":"欧大任","text":"江夏名家一凤毛，使星南斗望偏高。\n赤城不断霞前色，沧海遥飞雪里涛。\n登阁浮云为越锷，据鞍明月似并刀。\n君收竹箭归来日，能忆长安对浊醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7371,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送马宪副睟卿赴滇中","author":"欧大任","text":"关门揽辔意如何，六传秋风使者过。\n诸葛城边临虎豹，叶榆河上驾鼋鼍。\n千峰毡帽吹霞散，万里碉房傍月多。\n开府论功谁第一，竹桥西听博南歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7372,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻冯武选悼爱姬","author":"欧大任","text":"玉颜一夕忽凋零，彩笔曾题满画屏。\n三峡行云眉黛翠，九峰明月鬓鬟青。\n梨花梦远将愁去，桃叶歌残掩泪听。\n白傅多情魂未返，灯寒犹讽佛前经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7373,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送易侍御惟效谪东平判官","author":"欧大任","text":"浮云忽散蓟门天，何处秋风不可怜。\n手版东方车骑日，锦囊名岳岱宗年。\n澄清自许人犹望，画诺因知客最贤。\n岂用路旁称绣斧，使君帷去更高褰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7374,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送江比部士振使关外因归钱唐觐省","author":"欧大任","text":"江淹词赋綵毫新，七叶衣冠况世臣。\n瑞节千山金马使，竹书三署白云人。\n过家因得停车骑，上寿应知望紫宸。\n京洛风流偏待汝，何能不忆五湖春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7375,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴舍人挽词","author":"欧大任","text":"秋风一夕下高原，犹忆先生旧灌园。\n橐笔早辞双凤阙，御车曾访八龙门。\n庭前兰菊应无恙，溪畔凫鸥几尚存。\n想到石麟封墓处，刻铭能颂汉家恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7376,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王员外宗鲁夙精笔法兼习内典辄以玉版纸求书梵经戏为之赠","author":"欧大任","text":"学参天竺久相闻，才子为郎几似君。\n曾共箨冠游梵苑，故烦贝叶写经文。\n讽来慈氏琅函字，笔掩羊家白练裙。\n藏得山阴三五帖，便应溪阁署鹅群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7377,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送喻邦相量移兰溪令","author":"欧大任","text":"江县栽花又一时，问君何似采湘篱。\n十年曾起诸郎草，三署能传水部诗。\n灵洞浮槎多涌雪，兰阴飞磴半临漪。\n分符莫叹劳人地，宣室归来正受釐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7378,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谈思永下第还江南","author":"欧大任","text":"咸阳貂弊出关迟，回首丹霄未易窥。\n晓色楼台长乐树，秋风麟甲定昆池。\n飞腾有路时犹待，摇落何心客自悲。\n剑气尚寒星斗侧，大江南下寄相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7379,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻宗良君侯摩尼斋成","author":"欧大任","text":"一珠持向豫章开，岂用翻经百尺台。\n大德已闻多竺慧，及门何但似宗雷。\n餐风客以名山至，发愿心从净土回。\n弟子虽然犹嗜酒，秫田抛却早归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7380,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日登永上人藏经阁同沈比部箕仲沈虞部少卿陈博士伯符分得开字时王宗鲁张文起二中郎不至","author":"欧大任","text":"阁拥慈云傍阙开，双林如此足徘徊。\n似缘把臂人曾入，岂为攒眉客不来。\n发愿同游依净土，登高作赋借雄才。\n河山并引中原目，谁羡秋风戏马台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7381,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送牛虞部主铁冶蓟州","author":"欧大任","text":"使者东行霜色繁，马头笳吹不胜喧。\n孤城明月无终国，千树秋风古蓟门。\n倚垒黄华开障塞，周阹白冶斥山园。\n汉家金铁通关少，愿借前筹答帝恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7382,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李临淮惟寅邀赏菊同社中诸子夜饮得桥字","author":"欧大任","text":"燕门秋色白门遥，金谷黄花总胜招。\n树急西风连露掌，城横北斗贯星桥。\n角声欲动楼乌起，蜡炬频更擽马骄。\n何限游从工笔札，柴桑归计在渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7383,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"俞舜岳至得刘评事长钦见讯因酬原韵","author":"欧大任","text":"尺书新得故人裁，笈里云霞手自开。\n旧学知从刘向授，虚名宁为郑玄来。\n几闻郢里阳春曲，何处秋风白下台。\n若问讲经同异事，石渠今待汉家才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄屠青浦长卿","author":"欧大任","text":"四明才子建安风，曾向陶郎赋月同。\n谁可谷阳留召父，已闻东海得于公。\n商飙开馆初辞燕，碣石飞书不待鸿。\n五斗浊醪能饷客，问君何日醉新丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠李小侯汝藩","author":"欧大任","text":"虎门曾见绣襜褕，抗手通家愧老夫。\n白发我非秦博士，缁衣君似郑司徒。\n歌中丛桂招能隐，曲里阳春调转孤。\n握管珥貂俱世业，独将名姓冠西都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张武选于皋守成都","author":"欧大任","text":"霜色燕郊横吹声，西南天府借君行。\n交龙曾宠巡边使，五马今成谕蜀名。\n巴子市通邛竹杖，花溪春满锦官城。\n不知剑阁题铭后，何日能来赋二京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至日署中斋居简诸僚","author":"欧大任","text":"官似太常斋未开，春从廷尉府初回。\n曲中兰向梁园入，句里花吹庾岭来。\n候气此时缇是室，书云何处玉为台。\n伫闻三署传新咏，已让群公寡和才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送蔡参军赴真州","author":"欧大任","text":"淮海上游张地图，大江何况涌城隅。\n白沙渡口千帆急，皂角林前片月孤。\n曾下楼船沉铁锁，至今军府握铜符。\n看君岂但芜城赋，掌记才名在两都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王敬美入觐以禁不晤次沈伯英韵","author":"欧大任","text":"奉玺何年绿绶郎，趋朝云自楚人乡。\n鹿皮今荐明堂璧，鸡舌犹含旧省香。\n汤沐我空怀汉邸，笑谈君尚隔燕阳。\n青春倘拜彤弓赐，可是欢逢在建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中早朝","author":"欧大任","text":"夹陛朱衣炫晓霞，鹓行相顾杂霙斜。\n云深丹地浑成玉，日上彤楼尚散花。\n沾帕乍嘶天仗马，凝窗先起禁城鸦。\n閟寒莫奏烟霄曲，睿藻从来出内家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王比部宗鲁守肇庆","author":"欧大任","text":"军城雄寄古端州，虎竹今分圣主忧。\n五裤歌因廉叔至，三枫诗似范云游。\n天开岭峤登楼见，江下牂牁绕郭流。\n便欲移家栖石室，敢将县榻望君侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王宪副敬美入计以病乞休张中丞肖甫与余各赋一诗兼怀长公元美","author":"欧大任","text":"乞身岂为病蹉跎，欲向柴门掩薜萝。\n家近烟霞双草屩，江深风雨一藤蓑。\n岷中客自能携酒，市里人今少和歌。\n谁似二何高士传，琅琊秋色郁嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送袁员外茂文转佥宪赴广西督学","author":"欧大任","text":"西粤千秋大楚庭，潇湘南下更泠泠。\n遂劳远使临丹徼，一出长安望紫冥。\n雪后岭云开阁白，烟深江草入帷青。\n召归傥以春秋对，何但苍梧左氏经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"敕长藩政为茀斯邦侯作","author":"欧大任","text":"大江西下豫章台，朱邸千年帝子开。\n汉代拥旄传诏出，周家剪叶奉藩来。\n人从赤舄尊明德，世以青箱见异才。\n揖客淮南招隐地，小山丛桂更须栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈贞父守光州","author":"欧大任","text":"铜虎符分甲马鸣，双旌遥送使君行。\n黄河南下三千里，浮弋东开十二城。\n宾从只今推大雅，循良宁复数西京。\n怜予曾听弦歌地，何限并州此日情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日同刘仲修李袭美李惟寅邀詹东图康子秀余君房刘伯玄袁景从梅客生胡文甫祁羡仲胡茂承汤义少魏懋权李季宣董元仲集日涉园分得飞字","author":"欧大任","text":"辟疆园里报芳菲，海内词人此会稀。\n白雪从来推寡和，青云犹自羡雄飞。\n林花夜照尊前色，宫锦春披月下衣。\n何限留宾投辖兴，可能无意恋荆扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题胡孟韬匡山读书处","author":"欧大任","text":"负笈中林白鹿前，草堂何但似青莲。\n玄风大士通三昧，金粟如来第几传。\n箫管壁开喧蟋蟀，薪蒸樵后得貂蝉。\n名山西访藏书地，欲上鄱湖月下船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日过蒋奉常","author":"欧大任","text":"丹凤城边紫陌长，容台犹许客登堂。\n湘漓故国连南粤，燕赵他年望太行。\n散吏自趋廷尉府，过江谁作尚书郎。\n汉家礼乐今方盛，七字看君赋柏梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黎伯华登岱后见寄","author":"欧大任","text":"君入名山礼汉坛，几回西笑向长安。\n白云半自封中起，积雪多从石上看。\n仗外旌旗开晓色，江头宫殿护春寒。\n懒朝尚待乘轺客，咫尺应弹贡禹冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张比部文起擢守保定","author":"欧大任","text":"京西雄郡似星罗，三辅名因保障多。\n夕燧不闻通上谷，春流犹自下滹沱。\n车前驯鹿千人望，庭里悬鱼几客过。\n尽道匈奴今远塞，控弦鸣镝更如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬朱兵宪秉器以华岳诸诗三秦石刻见寄","author":"欧大任","text":"金天石削引丹梯，使者书从盾鼻题。\n碑集秦中珠斗灿，笔摇华顶綵云低。\n临关小队閒飞檄，寄驿新诗满赫蹄。\n最忆词人庾开府，风尘何处望函西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张秦二僚长扈驾谒陵","author":"欧大任","text":"骖驔宝马去如飞，法从承恩此际稀。\n九府赐金陵下食，尚方裁锦辇前绯。\n衣冠原庙瞻朱缀，日月桥山拥翠旂。\n扈跸遥知多喜色，汾阴歌吹御船归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送齐黄门惟良册封淮府","author":"欧大任","text":"琐闱人自豫章才，持节花迎驿路开。\n汉使风云千骑下，淮王宾客八公来。\n宫亭湖白涛为国，千越山青玉作台。\n家庆遥知南斗外，可能中夜望三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送卢参军赴两淮转运","author":"欧大任","text":"汉日金堤障大河，使君击楫莫蹉跎。\n淮边蟹稻应无恙，海上鱼盐更若何。\n夜雨人家杨子渡，秋星客醉竹西歌。\n秦川对酒平如掌，去赋深江净绮罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送萧进士以孚饷边因归汉阳省觐","author":"欧大任","text":"五花骢去晓骎骎，恩许宁亲此自深。\n汉上从来荣片玉，荆南谁得似双金。\n合符关吏看星使，护饷材官出羽林。\n归诵元方驰恋赋，白云何限太行心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中答臧进士晋叔因柬余进士君房","author":"欧大任","text":"鞭弭中原几代兴，少年何羡老夫能。\n折腰因米羞彭泽，病肺无书负茂陵。\n客食每思金掌露，斋居长对玉壶冰。\n洛阳纸为西曹贵，更向余郎乞剡藤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送魏季朗赴镇江文学","author":"欧大任","text":"才子今为都讲师，曾将奏牍上彤墀。\n书题京口三山长，工问延陵十字碑。\n苜蓿有官无饱饭，茅柴何处不堪诗。\n竹西尚记缁帷在，江上寻君自可期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日斋居得雨和黄君庆","author":"欧大任","text":"郊禋盛典肃群工，握管多传法署中。\n五月旱荒劳诏旨，万方雷雨过斋宫。\n当窗杏叶添新绿，傍砌葵花放小红。\n何限甘泉供奉客，赋成谁敢似扬雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午日同袁景从李凝伯二中舍集刘观察仲修园中得公字","author":"欧大任","text":"槐阴堂下快雄风，艾叶蒲花映酒红。\n歌妓独能娱谢傅，坐宾谁最似申公。\n内家萧鼓喧阒里，太液楼船想像中。\n闻道至尊深望雨，片云时复过帘栊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文华殿侍班宣广西十寨大捷","author":"欧大任","text":"左掖趋跄步不迟，鸿胪新整汉官仪。\n仗移讲殿开朱户，班引朝簪上赤墀。\n日影觚棱云五色，露光戈戟玉千枝。\n小臣十载看铜柱，山越今欢奏捷时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈膳部子寿朱计部子得携酒见过得留字","author":"欧大任","text":"茅斋竟日少淹留，好事偏能载酒游。\n杞梓荆南逢此客，琳琅湘北似清秋。\n谈深云起三千牍，歌后凉生十二楼。\n便作禽鱼濠濮想，吏情何处是沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送冯鸿胪文在待次南还","author":"欧大任","text":"汉家典谒重句胪，曾向诸儒议石渠。\n三府贤良爰季奏，五侯笔札子云书。\n舟同赋客堪游泛，楼似仙人且燕居。\n交戟幸逢明盛日，岂容蓑笠狎樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谢进士见齐奉命归娶","author":"欧大任","text":"少年得意曲江游，诏许宁亲拥二驺。\n台上吹箫翔綵凤，河边停织待牵牛。\n杏花拂盖燕城晓，桂子飘香海国秋。\n何限主恩荣昼锦，鸡鸣歌后莫淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚辰伏日道馆苦热时归怀不遂戏柬胡聂二山人","author":"欧大任","text":"一官鸡肋尚悠悠，赤日红尘老更愁。\n可怪冷曹偏苦热，非关衰鬓怯逢秋。\n青松荫石山中几，碧浪黏天海上楼。\n抛却清凉君莫笑，灵台还伴董京游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李学宪本宁秦中见寄二首 其一","author":"欧大任","text":"文印亲持走传车，七经教授似相如。\n每从北面争传业，何但西游强著书。\n鳷鹊月华临古甸，芙蓉岳色满精庐。\n可堪玉署回翔客，一出承明十载馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李学宪本宁秦中见寄二首 其二","author":"欧大任","text":"五花飞跃九衢閒，尚隔雍州百二关。\n虎观中开秦日月，龙门东注汉河山。\n黄图宛映台阶象，赤管将趋侍从班。\n方朔陆沉今已久，酣歌铜马望君还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨夜梁祠部持伯宅喜黎司勋伯华至","author":"欧大任","text":"天边处处望乡台，久客相逢亦快哉。\n疏雨忽从京甸过，片云新自岱宗来。\n烹鱼河上频书札，下马灯前共酒杯。\n醉后不知沾湿去，密荷深竹一徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈膳部子寿沈仪部伯英使畿内诸郡","author":"欧大任","text":"三辅东西几驿程，太行山翠扑飞旌。\n洒途雨为诸郎送，入部星占二使行。\n鹊下桥堪通汉渚，凤鸣台自傍秦京。\n洞箫总待王褒奏，早擅南宫作赋名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答梅禹金江上之约并以子宁集见寄","author":"欧大任","text":"书来字字勤加餐，投劾谁知去亦难。\n落月只悬沧海梦，秋风先到蓟门寒。\n岂求白雪人千和，独把明珠万里看。\n春谷泉香堪酿酒，片帆吾自下江干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵酬陆伯生见赠","author":"欧大任","text":"爱君诗句起沉冥，结托烟霞伴酒星。\n三载归心悬海岳，几人揖客重朝廷。\n握从汉署兰空碧，游似山阳竹更青。\n名士一时推入洛，陆家才自出华亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"臧晋叔辞邑得荆州教授因答其乞毡之作","author":"欧大任","text":"闻向金门谢宰官，传经偏乞一斋寒。\n果将绛帐趋南郡，故取纯缁制小冠。\n饮酒读骚差自快，据梧支策未辞难。\n青毡敝矣宁堪送，荆岳岷江赠尔看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7422,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题飞来寺图","author":"欧大任","text":"中宿禅林几度过，跏趺石上访弥陀。\n门开山色荆衡尽，峡束江流骆越多。\n翡翠经春栖枳棘，狝猴深夜挂藤萝。\n游人独把禺阳竹，为问西来意若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7423,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同方武选梁祠部黎司勋携酒过金舍人宅得新字","author":"欧大任","text":"柳市南头可卜邻，若为策马傍风尘。\n且从邺下刘公干，共访樊川杜舍人。\n行散不妨供几杖，醉来谁许吐车茵。\n甘泉万树商飙急，久客应怜白发新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7424,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕同袁光禄黎司勋金舍人朱山人集梁祠部宅得秋字","author":"欧大任","text":"唤班初下紫宸秋，内史尊前暂倡酬。\n八月槎行虚客望，双星桥在起乡愁。\n绝交不似嵇中散，渐老偏思马少游。\n京洛衣冠怜此夕，忍令烟艇待沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7425,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同李袭美寄方永叔","author":"欧大任","text":"年少登坛气已雄，翩翩名字起河嵩。\n儿为谢琰尊安石，家有苏瑰号许公。\n丹穴翔鹓皆似凤，青萍结佩自成虹。\n鼎门日望风云色，橐笔应来直禁中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7426,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]