[{"title":"寄程内翰 其一","author":"钟芳","text":"云物无心信转蓬，迢迢书讯梦魂通。\n衡湘云暗峰回雁，何况鲸波隔万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄程内翰 其二","author":"钟芳","text":"榕叶婆娑满地阴，银缸烧蜡夜沉沉。\n幽人不厌鼪鼯径，月底风过是足音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月","author":"钟芳","text":"娟娟月色丽青冥，光正生时蠹已生。\n不为年年养蟾魄，玉轮应是十分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游永宁寺马上和韵","author":"钟芳","text":"平生事业共青云，邂逅重逢话旧文。\n杨柳歌残清宴罢，夕阳归马带馀醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曲江赓舟中韵","author":"钟芳","text":"水落初痕石满江，白茅濡露拂麾幢。\n中扃晓彻天光合，坐爱泠泠百尺泷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金山帆影为全之作","author":"钟芳","text":"伤心豺虎泪如泔，痛定分睽更不堪。\n伫久江风吹眼黑，却疑山影瘦于帆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏秋桂二绝 其一","author":"钟芳","text":"招摇指酉蝶蜂收，淡白轻红压众柔。\n一种清芬伴明月，莫言生处是南州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏秋桂二绝 其二","author":"钟芳","text":"练服缃裙照翠帷，群夭不敢斗芳菲。\n却嫌梅菊争颜色，先向秋霜冽处开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日书事","author":"钟芳","text":"九日重绵未絮袍，槐头云暗冷萧骚。\n故人知我愁无那，遥遣苍头献枣糕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王母瑶池图为宁波李纪题","author":"钟芳","text":"雪点头颅云作衣，每凭青鸟下瑶池。\n石城金室春何限，都入萱堂献寿卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春","author":"钟芳","text":"绿遍郊原春意阑，幽禽翔集带馀寒。\n斜风吹雨??急，枝北枝南总未安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山行","author":"钟芳","text":"屋后青山晚更苍，竹槽通水灌禾粱。\n材娥不解缠珠翠，遍插荆红当艳妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶咏","author":"钟芳","text":"拱默容容多后祚，水旱不节阴阳错。\n黄纸宽征白纸催，大网疏疏小网数。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丁谓","author":"钟芳","text":"鲸波容易去还来，雷竹飞钱竟作悲。\n到底不须论巧拙，瓦全何似玉成灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题明皇千叶桃","author":"钟芳","text":"金屋重扃贮阿娇，繁阴秾艳隔贤豪。\n年年花溅华清泪，应是蒙尘恨未销。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"画菜","author":"钟芳","text":"畦头晚色涵葱茜，淩寒半捲玻璃片。\n薤盐登品任东风，莫教吹入苍生面。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小舟","author":"钟芳","text":"巨舰乘风意态闲，波涛千顷坐谈间。\n些些舴艋轻如叶，建竹悬蒲也当帆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"公孙弘","author":"钟芳","text":"谀如忠荩险如夷，暗有机权结主知。\n不是万年公论在，弘为全智黯为痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"霍光","author":"钟芳","text":"颠迷宠利任刑威，岂独骖乘兆祸机。\n万口沸腾堪铄骨，反形宁论是和非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与杨澹斋","author":"钟芳","text":"澹斋老去眼昏花，诗句仍挥五色葩。\n何日小轩同漫话，细炊蟹眼试新茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途次","author":"钟芳","text":"高堂垂白忍相违，客思沈沈独掩扉。\n银烛半销更漏尽，不堪风雨夜凄其。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"清远舟中","author":"钟芳","text":"刺桐花发照山红，百丈游丝一叶风。\n舟子不知歌欸乃，齐声伊亚亦争雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漫兴 其一","author":"钟芳","text":"叠叠波纹簇晓寒，江天秋落思漫漫。\n芙蓉不着污泥色，一任游人洗眼看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漫兴 其二","author":"钟芳","text":"附岩花萼淡还浓，占断风光夕照中。\n小艇半横渔父醉，独凭秋色看芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海山遐祝","author":"钟芳","text":"琼楼晴并朝阳阜，海色山光连翠牖。\n亲恩山海同高深，高深更拟亲同久。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有感","author":"钟芳","text":"山南山北殊风候，南自多阳北自阴。\n一夜雷声膏雨遍，桑杨南北共森森。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"艺兰","author":"钟芳","text":"灵苗移自明珠浦，培灌经年花未蕃。\n漫把国书方国器，识之难似种之难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄石安国太守","author":"钟芳","text":"东桥别来几何年，梧江老树迷苍烟。\n作书欲附陇头使，晓起把镜羞华颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨桃花","author":"钟芳","text":"花发缠交碧玉枝，疏风时复露胭脂。\n莫缘幽僻轻颜色，秾绿深藏亦一奇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登第后寄家书","author":"钟芳","text":"南极坤垠是故乡，故乡翘望正茫茫。\n年年秋近归鸿急，一见归鸿一断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春晴","author":"钟芳","text":"雪色寒分粉署光，午云稀薄漏微阳。\n百花无意争春媚，沾著春风各自香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蔷微","author":"钟芳","text":"庭院沉沉醉绛霞，酡颜闲倚翠屏斜。\n开时莫恨春光暮，接续春光是此花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚天露坐","author":"钟芳","text":"火龙嘘焰逼窗纱，细瀹香薷当啜茶。\n倚遍玉楼凉入座，晴空落日看归鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九月饯衍圣公于礼部次夏宗伯桂洲韵 其一","author":"钟芳","text":"未问黄花开未开，主人新酿满云罍。\n凭轩语笑秋容淡，已觉寒香细细来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九月饯衍圣公于礼部次夏宗伯桂洲韵 其二","author":"钟芳","text":"重九华筵倚翠开，盈盈秋思上璚罍。\n疏英不假黄金色，似待群工更一来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九月饯衍圣公于礼部次夏宗伯桂洲韵 其三","author":"钟芳","text":"堂焕丝纶锦障开，耆英仪度古尊罍。\n黄花爱客微含媚，意恐开残客倦来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶咏","author":"钟芳","text":"木公金母自神灵，辟谷延年浪有名。\n任是炼教形似鹤，也须随化入冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"有感","author":"钟芳","text":"如饴荼堇去周原，卢橘逾江性亦迁。\n最爱青青亭上柏，炎风朔雪总森然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张举人济时省亲","author":"钟芳","text":"璚莞春生戏彩堂，文星高映寿星光。\n明年紫陌看花遍，莫惜泥金付雁行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"野景","author":"钟芳","text":"岚色溪光入户来，引筇徐步立兰阶。\n人间不用谈天上，牛背樵歌即吹台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"薏苡酒二首 其一","author":"钟芳","text":"苡珠新酿郁金香，入口能裨岁算长。\n拟洁云垒荐清庙，化为甘雨寿多方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"薏苡酒二首 其二","author":"钟芳","text":"苗疑芦苇实疑珠，浥露涓涓秀有馀。\n不为苍生惠嘉种，当年争有载盈车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"琼州二贤祠","author":"钟芳","text":"远地龚黄岂乏材，化工未始异培栽。\n若为一样甘棠树，红杏日边相映开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大鹏","author":"钟芳","text":"大鹏抟风高切云，海水为立昼为昏。\n风休鹏化杳何许，天光浩浩青无垠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又和漫成四首 其一","author":"钟芳","text":"谈麈顿销夷檄变，思莼忽动故园心。\n南人引领惊相问，为爱甘棠一片阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又和漫成四首 其二","author":"钟芳","text":"微哦昼倚云岑迥，幽眺晴循石径斜。\n怊怅沧波限南北，玉人迢递瘴烟赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又和漫成四首 其三","author":"钟芳","text":"九服异方无异俗，化騑同御故同驰。\n忠球毕竟归东序，户外松风是子期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又和漫成四首 其四","author":"钟芳","text":"汩汩流泉透户斜，葱茏草树隐山家。\n溪桥独步无人语，闲看凫鹥卧浅沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过万安莲塘宿李处士家戏答其诗 其一","author":"钟芳","text":"十年不到万安游，此日重经涨海头。\n偶过莲塘居士宿，古心古貌古人流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过万安莲塘宿李处士家戏答其诗 其二","author":"钟芳","text":"青山逶迤环海口，涛声隐隐春雷吼。\n钓鳌人去玉台空，我来倚杖沈吟久。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天香楼二首 其一","author":"钟芳","text":"奇葩不着烟埃色，静夜清沾帝子家。\n孚感信知同臭味，肯分馀馥遍秾华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"天香楼二首 其二","author":"钟芳","text":"异瑞何曾种得成，德馨升臭达天馨。\n溶溶丹桂秋空影，长照人心一寸明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠徐东园 其一","author":"钟芳","text":"石构嵯峨紫翠重，水环云窦玉玲珑。\n谁知天地方圆象，都在亭池俯仰中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠徐东园 其二","author":"钟芳","text":"云去云来昼不扃，柏盘藤蔓作连屏。\n未须久坐能清俗，才到庭除俗虑清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠徐东园 其三","author":"钟芳","text":"到地垂杨扫碧苔，蓬丘移在聚春台。\n百花烂熳春开遍，更有长春不断开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠徐东园 其四","author":"钟芳","text":"池上风光色色新，鱼知人意亦相亲。\n惯听抚掌浮金尺，竞啄香餈不怕人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"农家","author":"钟芳","text":"牛放平芜绿满郊，小池储水灌新苗。\n夜归醉共妻孥乐，不与陶朱斗富饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"道士","author":"钟芳","text":"玄宫不著幻尘愁，荏苒韶光户外流。\n传得长生龙虎诀，凤笙吹老白频秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮魏国花园","author":"钟芳","text":"桂作浮梁石作山，曲亭回径叠朱阑。\n登游不尽倦还坐，仍是方塘半亩间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送朱都督","author":"钟芳","text":"袖有丹蛇裘紫貂，威名千里折天骄。\n阴山此去干城重，褒诏重重下九霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答林都宪省吾","author":"钟芳","text":"穗城春色艳花容，岁岁春花照眼红。\n我到逢春花不发，一川烟霭泥孤蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周亚夫","author":"钟芳","text":"正气棱棱数抗颜，忠臣巷遇古来艰。\n笑中予戟元非远，只在迟回匕箸间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶咏","author":"钟芳","text":"金陵子月冻色微，阳精黯淡寒无辉。\n休衙食罢展书读，风雨扑窗人到稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐","author":"钟芳","text":"琼南江表更神京，三处相思共远情。\n寒漏递催清夜永，愁襟空对一灯明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏荔枝","author":"钟芳","text":"鲐文轻裹紫绡囊，凤髓清含白玉浆。\n名果世间千万品，合谁先子荐烝尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"百果答","author":"钟芳","text":"桃称王母枣安期，酸苦辛甘各有宜。\n何必荔枝称绝品，鼎钧滋味合兼资。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"回风岭","author":"钟芳","text":"南北风声倩斡旋，回风应是力回天。\n当年洚水生灵垫，恨不移之障百川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马鞍山 其一","author":"钟芳","text":"东皇辙迹遍尘寰，南顾巃嵷一解颜。\n八骏如飞归去急，锦鞯遗在翠微间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马鞍山 其二","author":"钟芳","text":"神驹委步下天闲，霜鬣冰蹄振玉环。\n渴吸长川三百丈，却乘仙仗出云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门","author":"钟芳","text":"宋家全节古今稀，帝后臣工百万师。\n义旐一挥同日死，至今惟表大忠祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"久雨","author":"钟芳","text":"冬雨经春日日来，碧湖新水涨楼台。\n阳和畅后群阴散，百鸟声中万萼开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"候清戎传侍御宿圆觉寺","author":"钟芳","text":"四山如画雨初晴，古木萧森接太清。\n云外楼台方外客，不知人世有蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄家渡","author":"钟芳","text":"黄家渡口云冥冥，双浆荡漾蛟涎腥。\n舟人指点战没处，缘芜片片浮鵁鶄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊祀寓神乐观斋宿题画","author":"钟芳","text":"茫茫何处觅蓬瀛，云水为家万事轻。\n春到柳梢青欲遍，一舸横港醉初醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漫兴","author":"钟芳","text":"斗间光焰焕龙精，蜃伏玄溟气自升。\n亭毒运行闲不得，日星河岳见精灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"紫薇花","author":"钟芳","text":"天孙擘碎彩云堆，散入幽斋作绛帷。\n暑雨渐多蒸溽甚，故乘新霁曝葳蕤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白鹰为沈都阃题","author":"钟芳","text":"莫缘饥饱浪猜详，玉爪霜翎本自将。\n草暖任渠狐免狡，朔风摇落正飞扬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"集庆寺观宋徽宗遗像","author":"钟芳","text":"鼎沸中原宋社亡，萋萋藤蔓掩颓墙。\n山僧留得君王像，翠佩云鬟倚靓妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山行","author":"钟芳","text":"山木青葱倚绛霄，下垂秾荫庇菅茅。\n九秋霜落荣枯变，惹得年年野火烧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙酉乌蛮滩谒伏波庙四首 其一","author":"钟芳","text":"重煽炎光达远夷，归来翻履祸几危。\n蛮滩千仞谁云险，却在城西稿葬时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙酉乌蛮滩谒伏波庙四首 其二","author":"钟芳","text":"帝鉴高齐两曜明，不缘谤箧罪干城。\n全归已爽包尸愿，身比珠犀熟重轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]