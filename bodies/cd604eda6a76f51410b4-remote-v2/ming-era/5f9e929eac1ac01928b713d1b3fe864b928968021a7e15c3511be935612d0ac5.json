[{"title":"中秋雨晴小园夕坐","author":"宋登春","text":"老去虽耽酒，秋来不废诗。\n畦蔬新雨后，茅屋晚晴时。\n谑浪还齐语，蛮歌爱楚儿。\n明朝多酿黍，好待菊花期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29949,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣怀","author":"宋登春","text":"鹤发还齐瑟，鹑衣向楚人。\n年丰儿女瘦，家远弟兄亲。\n懒拙能堪事，逢迎岂性真。\n惟将诗送老，更爱酒长贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29950,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"连日淹雨闭门伏枕新晴后适有诸贵过子茅茨沽酒以慰岑寂","author":"宋登春","text":"久雨秪宜睡，朝来还闭门。\n薄云笼屋角，旭日照篱根。\n倚杖行犹懒，堆书坐欲翻。\n不知秋草碧，绵藐待王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29951,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠焦秀才","author":"宋登春","text":"富贵宜年少，何为长苦辛。\n鲁生原好礼，郢客岂终贫。\n琢玉功须就，凌云气益伸。\n明年书再上，应有下机人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29952,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"沙津妓馆送杨少通渡江南征","author":"宋登春","text":"怜君能骑马，江汉未经过。\n宦薄蛮方远，家贫童仆多。\n朝云怜楚子，桃扇赠韩娥。\n万里相思字，秪应候薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29953,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜访承天寺二蜀僧论禅学","author":"宋登春","text":"箨冠随所适，竹杖复行唫。\n夜月青莲宇，秋风珠树林。\n根尘迷至性，诗酒涴禅心。\n不学无生法，其如老病侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29954,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丛竹洞","author":"宋登春","text":"连竹分清影，接䍦卷洞圆。\n丛疏风淅淅，叶密露涓涓。\n捣药宜晨坐，抛书向午眠。\n谁知幽僻地，自有野人天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29955,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"对酒","author":"宋登春","text":"自古推名饮，而今不复疑。\n少年当适意，况我白头时。\n剑说非良计，酒歌多妙辞。\n丹砂不可食，毕竟尔何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29956,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中遣闷","author":"宋登春","text":"泽国秋云重，江城暮雨寒。\n短衣为客惯，长铗向谁看。\n密竹藏幽径，深松着小冠。\n渚芹亦可荐，何惜老荆蛮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29957,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日同仙居兄饮江陵草堂因忆故园诸弟","author":"宋登春","text":"客泪十年落，乡心九日县。\n登高巴水外，望远楚云边。\n各醉黄花酒，同悲鸿雁天。\n浮骸能几日，而汝且相怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29958,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中晓起","author":"宋登春","text":"习静来山中，长日卧松关。\n川光媚几席，山气清襟颜。\n翩翩双鸟没，袅袅孤云还。\n万物各有适，无营意自闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29959,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中寄龙山兄弟","author":"宋登春","text":"山人多幽姿，栖息宜云壑。\n生平沮溺流，矢与求羊约。\n索居赖琴书，战胜甘藜藿。\n心迹两无疑，百年任苦乐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29960,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙山见访山中诗以贻之","author":"宋登春","text":"公子多道气，跻险赏林泉。\n高酣坐石上，眇若乘云烟。\n俛仰成千古，纵观周八埏。\n谅无松子术，敢冀王乔年。\n安顺委大化，恬愉复自然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29961,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登太和山天柱峰","author":"宋登春","text":"策杖陟峰顶，羽人启金扃。\n冥心观元化，彷佛见岳灵。\n历历指九区，苍苍辩四溟。\n陵谷若波涛，微茫讵可形。\n群动争飞奔，大运无留停。\n仰视浮云征，空虚安可升。\n眇焉此浮骸，何堪为列星。\n愿留不死乡，炼骨引熊经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29962,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮酒四首 其一","author":"宋登春","text":"清流众累集，性悟苦不早。\n身后名有无，生前亦枯稿。\n不赖忘忧物，何以写怀抱。\n刍狗视浮骸，万事皆草草。\n寿命由化迁，金石亦难保。\n敛襟独闲谣，江月上松杪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29963,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日寓唐子承秘书西园","author":"宋登春","text":"杖策步西园，被褐坐东轩。\n孤觞面菊圃，惟闻野鸟喧。\n昨朝秋雨足，菜甲生何繁。\n园丁荷锄去，荒草没篱根。\n南山当面立，晨暮洗心言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29964,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大堤曲","author":"宋登春","text":"白面襄阳儿，素腕大堤女。\n何必芍药赠，日动心相许。\n骝马青丝缰，楼高独延伫。\n女萝附松枝，嬿婉东风里。\n愿为双鸳鸯，泛泛碧池水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29965,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"襄阳怀古","author":"宋登春","text":"襄阳白面儿，惯唱铜踶歌。\n汉水东流去，英雄可柰何。\n羊公石尚在，岘山高嵯峨。\n不见孟夫子，谁传妙句多。\n习池清且浅，双鲤跃春波。\n山风吹幅巾，照影何婆娑。\n登临前后事，水鉴色象过。\n吾将寻鹿门，披云巢松萝。\n下掬石上泉，茹芝消沉痾。\n丹砂多误人，素心望匪他。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29966,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将游衡岳留别李九中","author":"宋登春","text":"洞庭南望草萋萋，江青枫□楚客悲。\n何处思君心最切，雁回峰下寄书时。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29967,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠荆门州卢晋山刺史","author":"宋登春","text":"百战曾收海上功，归来十载半成翁。\n笑携南国如花妾，不觉衣冠有晋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29968,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠杨生惟德","author":"宋登春","text":"我在潇湘君在吴，十年踪迹各江湖。\n蓑衣细雨王侯宅，曾忆荆州旧酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29969,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿紫霄宫月下望蜡烛诸涧","author":"宋登春","text":"千尺峰头明月辉，松盘石磴紫烟飞。\n步虚声落不知处，采药山中道士归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29970,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感兴四首 其一","author":"宋登春","text":"肝臂列为人，自知亦巳幸。\n循性即坦途，求名自贻病。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29971,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感兴四首 其二","author":"宋登春","text":"商贾重财雄，巢许矜志节。\n朴朴同一心，欲辩何由说。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29972,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感兴四首 其三","author":"宋登春","text":"试取百金剑，补履不如锥。\n洪纤各适用，彼此胡相疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29973,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感兴四首 其四","author":"宋登春","text":"方诸能召水，磁石不引金。\n因知天下事，所贵在同心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29974,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"程仁卿从军自蜀还荆州诗以贻之","author":"宋登春","text":"长揖辞开府，悲歌下剑门。\n心长发自短，金尽舌犹存。\n负笈新诗草，披衣旧酒痕。\n锦城贵公子，谁是赵平原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29975,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"襄阳送刘近化山人北游","author":"宋登春","text":"意气重刘生，悲歌万里行。\n宝刀横白刃，骝马络朱缨。\n江汉分南楚，云沙靖北平。\n经过易水上，为我吊荆卿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29976,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月八日贱辰印别驾李方伯觞予命梨园弟子为寿诗以谢","author":"宋登春","text":"昔别信陵门，常思国士恩。\n激商知楚客，流羽辩梨园。\n竹里敕中馔，花间促上尊。\n千金酬一饭，吾亦愧王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29977,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书李右承郭北山房","author":"宋登春","text":"栖托难高卧，行藏且岁时。\n从来燕客放，不怪楚人疑。\n时有青霞想，惭无玄豹姿。\n名山堪蜕骨，不遣报家知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29978,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访华容孙兆孺山人","author":"宋登春","text":"江上逢孙楚，山中问鹖冠。\n秋云玄阁冷，夜雨敝貂寒。\n壮发何时变，衰颜此日看。\n岁华摇落尽，何处有江兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29979,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿玄石山月下望洞庭湖","author":"宋登春","text":"五粒松枝酒，三花道士居。\n山空月愈白，湖阔水同虚。\n腾化术难就，纵横计巳疏。\n欲知投老地，惟有学樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29980,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送兆孺赴岳州府谒李刺史","author":"宋登春","text":"木落章华晚，帆飞梦泽云。\n莫挥长别泪，不是久离群。\n鹦鹉休先赋，兰膏恐自焚。\n诸蘋幸可荐，为我吊湘君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29981,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北归留别兆孺","author":"宋登春","text":"泽国寒仍早，江城木叶稀。\n何人歌杕杜，有客赋无衣。\n沅芷宜修佩，商芝可疗饥。\n相思付朔雁，还共楚云飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29982,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"公安别孙习孺秀才还荆州","author":"宋登春","text":"惆怅孱陵道，江湖雁正飞。\n万山风雪里，匹马郢城归。\n此日哀王粲，何年荐陆机。\n梁园零落尽，垂老欲谁依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29983,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同印别驾游桃川宫寻秦人洞","author":"宋登春","text":"殿阁夕阳外，花源楚水西。\n秦人不可见，洞草尚萋萋。\n九畹心空结，三湘望欲迷。\n探奇犹未极，还下武陵溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29984,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江边旅舍","author":"宋登春","text":"小榻微风入，开帘爱地偏。\n因知童仆好，更觉主人贤。\n客梦江声乱，乡愁夜雨悬。\n明朝秋巳半，又近菊花天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29985,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江陵草堂典赁思寻投老之地","author":"宋登春","text":"裘马荆儿态，茳蓠楚客心。\n纵横术未就，佚老计相寻。\n玉佩遗湘浦，桔槔思汉阴。\n买山须近水，结屋白云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29986,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠浙东王山人","author":"宋登春","text":"白酒时时醉，青山处处缘。\n满囊诗是画，尽室笔为田。\n自道贫非病，人嘲白尚玄。\n明朝到郢上，谁赠杖头钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29987,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寓天门山中思归江陵草堂","author":"宋登春","text":"短墙留鹤泽，衡宇俯龙桥。\n松粒酒应熟，梅花客可招。\n老思芳草卧，闲爱白云谣。\n楚笈行将负，全生事绣萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29988,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同京山郝秀才饮唐子承西园","author":"宋登春","text":"茅屋松间好，柴门花下开。\n芙蓉临水槛，黄菊照尊罍。\n看剑招燕客，论文识楚材。\n溪边双白鸟，相对不相猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29989,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登仲宣楼值雨","author":"宋登春","text":"南国春留客，东风雨扬丝。\n江云迷楚望，野水接松滋。\n红湿桃花片，青回杨柳枝。\n空余怀古意，日暮倚楼时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29990,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书南嵓宫后岩","author":"宋登春","text":"危石临松涧，悬岩启竹房。\n寻仙探玉洞，觅草得金光。\n杯狖隐还见，山精啸复藏。\n惭无辟谷术，丘壑兴何长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29991,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下山小憩南嵓宫作","author":"宋登春","text":"铁锁下松关，琳宫俯石阑。\n采芝临绝巘，投馆记前山。\n林外青牛卧，云中白鹿还。\n重来炼金骨，不复忆人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29992,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寻玉虚宫周炼师","author":"宋登春","text":"水声悬木杪，犬吠隔花源。\n饮涧腾猿坠，争巢健□翻。\n开山逢石□，斸药到云根。\n静爱宜栖士，因窥不死门。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29993,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鲁中挽何鸣岐","author":"宋登春","text":"之子鲁男子，为交老更新。\n犹存悬磬室，不见挂瓢人。\n泗上寻渔父，山中问隐沦。\n凤兮今巳逝，此意向谁陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29994,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄孙兆孺","author":"宋登春","text":"七泽秋生早，三江雁亦稀。\n无人识鬷蔑，有客忆孙挥。\n对酒狂歌发，看山逸兴飞。\n白头见何日，同结薜萝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29995,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高阳池刘杨二山人招饮","author":"宋登春","text":"石径寡林到野亭，中开一槛小池清。\n云山对酒浑无俗，花鸟供诗别有情。\n抚槛观鱼如惠子，当杯说剑让刘生。\n幅巾我亦高阳侣，漫向江头歌楚声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29996,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠杨斗笠","author":"宋登春","text":"江汉何年斗笠翁，丹砂未熟酒瓢空。\n金华不见牧羊子，郢上还邀襄野童。\n宝剑歌残徒自媚，瑶琴凄断与谁同。\n相逢且莫沧州去，为报淮南有桂丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29997,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日晚出荆州南门壕上作","author":"宋登春","text":"蒲稗藏鸭楚水秋，碧云摇海结新愁。\n晚风忽动芙蓉渚，斜日还寻杜若洲。\n白发萧疏歌宝铗，黄金零落恕貂裘。\n梧桐露下自消歇，千里相思明月楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29998,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十三日东永嘉王秉之山人","author":"宋登春","text":"寒竹丛巳橘柚县，短篱茅屋向城偏。\n桂花酿酒秋将半，桐叶题诗月未圆。\n越客还思青海峤，楚鸿又度白云天。\n好山欲买多招隐，袖里曾无子母钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":29999,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泊吴淞海岸观邵将军水军以所获倭奴行酒","author":"宋登春","text":"海戍江城动远旌，栖船载酒楚云平。\n三山我欲寻仙去，万里谁能破浪行。\n碧眼倭奴通汉语，黄须剑卒缦胡缨。\n向予东指嵎峓穴，先□洪涛断巨鲸。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30000,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自楚归访李少卿于濮上","author":"宋登春","text":"十载南冠学楚吟，半生踪迹任浮沉。\n秋风客路冯驩铗，暮雨山堂叔夜琴。\n濮上故人闻独钓，山中丛桂得相寻。\n归来不惜黄金尽，易水歌残壮士心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30001,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日夜集李北山园亭赏菊观妓 其二","author":"宋登春","text":"白露何漙漙，黄华凄以寒。\n北堂闻蟋蟀，南斗正阑干。\n楚客心如玉，燕姬气若兰。\n过降君子宴，磬折尽交驩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30002,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠小妓","author":"宋登春","text":"玉楼花发夜如何，银烛金尊小妓歌。\n白璧恨无酬地主，兰情楚思醉中多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30003,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和同宋山人饮会台庄诗","author":"宋登春","text":"雄图霸业自消沉，旧井荒台蔓草深。\n远树霏微连岳色，高原蜒蜿带河阴。\n野塘秋水庄生赋，沙苑幽兰楚客吟。\n当日牛山空下泪，谁知凄断雍门琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30004,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读金刚经呈李公印正","author":"宋登春","text":"籍草坐环堵，暂诵金仙辞。\n香云流户牗，蔬水静斋厨。\n冥心契玄奥，晨暮忘饥劬。\n有为非妙法，无往即真如。\n河沙喻天地，缘业开群愚。\n我本素心人，担囊来海隅。\n青莲李居士，而有维摩姿。\n随处给孤园，印正灭狐疑。\n白首惜归晚，曹溪路匪迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30005,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自制竹皮冠作","author":"宋登春","text":"睡起筠窗尽日闲，儿童拾箨自裁冠。\n楚因不是山中相，且伴烟霞老岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30006,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬日饮李公西园","author":"宋登春","text":"言访高人庐，聿在古城濮。\n落日衔远山，归禽集乔木。\n楚童叩深扉，猧儿吠丛竹。\n梅花冻愈馨，瑶草寒仍绿。\n前厨办旨蓄，后庭征丝肉。\n谈咏古交编，绪论南华录。\n达生贵自我，君子知止足。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30007,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答赠宋鹅池","author":"宋登春","text":"白首无家别，青鞋掉臂行。\n屠龙空有技，歌凤竟何成。\n濮上寻真隐，山中问达生。\n天涯岁欲暮，徒结紫兰情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30008,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同赋清平阁饮宋山人二首 其一","author":"宋登春","text":"寒日下江蒲，池山列画图。\n凭阑来野色，极目入虚无。\n兰茁春方浅，梅花岁欲徂。\n当垆歌正好，留醉酒家胡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30009,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同赋清平阁饮宋山人二首 其二","author":"宋登春","text":"雾树河源里，寒城濮水间。\n星云低绮席，灯烛媚朱颜。\n美酒淹长夜，纤腰姤小蛮。\n他乡有游子，留滞小重山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30010,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"峄山晚眺","author":"宋登春","text":"侧迭石梁倾，高原邾子城。\n幽泉花覆响，秘洞药长生。\n秋草秦碑没，白云汉畤平。\n鸟还山欲冥，无限旅人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30011,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中书事寄怀濮阳李北山符卿","author":"宋登春","text":"秦汉残书乱不收，笑看双剑倚床头。\n岳云南渡凫山晓，海气西连汶水秋。\n去楚谁怜和玉泣，卧岩无复贯珠求。\n凭高不尽哀歌断，何处逢人问帝丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30012,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自峄山来访李北山","author":"宋登春","text":"山居亦自好，忽动美人思。\n秋水将同赋，停云敢滞期。\n方云心匪石，复念发成丝。\n蹙膝华轩下，一尊共我持。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30013,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题仙人白鹿图为北山公寿","author":"宋登春","text":"东华仙人夸白鹿，手持节旄握宝箓。\n羽扇霞衣风摇摇，须臾万里何神速。\n韩众翩翩前致辞，青莲居士六旬六。\n五娥鳞次进蟠桃，瑶函丹简纪五福。\n寿筵高张濮水滨，华轩乐奏南熏曲。\n常棣园中庆连枝，儿孙膝下走群玉。\n箨冠道士捧琼觞，金粟谪仙抚玄鹄。\n醉中同咏五岳歌，为君□舞情如何。\n千秋万岁意不尽，门下报恩谁最多。\n座中更有齐貌辩，三言为主生荣那。\n意气从来我不少，披图赋诗何草草。\n待君千岁炼精魄，相随还访东华道。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":30014,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]