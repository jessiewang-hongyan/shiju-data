[{"title":"中秘黎公挽词 其四","author":"区大相","text":"此别成千载，浮生感七哀。\n吟诗推我过，把剑觅君来。\n溟海鹏初息，罗浮凤不回。\n岁寒问耆旧，松柏是新栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"始赴东山口杨柳村庄作 其一","author":"区大相","text":"山中朝暮雨，溪上两三家。\n古岸堆榕叶，闲门扫橘花。\n茅茨散鸡犬，林沼涨云沙。\n何恨伤春事，无心恋物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"始赴东山口杨柳村庄作 其二","author":"区大相","text":"经始东山下，萧条素业存。\n源桃犹避世，沙柳自成村。\n远树峰腰驿，孤烟谷口屯。\n山林情岂忝，丘壑道能尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"始赴东山口杨柳村庄作 其三","author":"区大相","text":"废垄千畦韭，清川几树桃。\n入林披壤石，薄采荐溪毛。\n旧俗忧多难，新氓计转劳。\n未堪营一饱，身世有渔舠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"始赴东山口杨柳村庄作 其四","author":"区大相","text":"十亩阴连水，茅檐春雾浓。\n烟霞馀几片，岩壑有千重。\n寇贼虽新息，军储亦旧供。\n异时负薪子，应乞寝丘封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"始赴东山口杨柳村庄作 其五","author":"区大相","text":"瓜地怜兹卜，菟裘无别营。\n刈麻防久雨，祈谷望新晴。\n田父休询姓，山禽不辨名。\n庞公遗后计，独有鹿门耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"始赴东山口杨柳村庄作 其六","author":"区大相","text":"沙田春悯潦，云壑昼伤阴。\n牛羊村径浅，耕凿战场深。\n麛狎眠幽竹，鸥喧坐碧浔。\n遗书犹可读，谁贵满籯金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"始赴东山口杨柳村庄作 其七","author":"区大相","text":"地僻时留径，江深晚泊船。\n岂无陴上宅，实少汶阳田。\n俭穫频供税，丰年或具饘。\n莫将桑梓敬，花树拟平泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"始赴东山口杨柳村庄作 其八","author":"区大相","text":"荆扉颓岸引，蔬圃乱流通。\n包橘无千树，芳兰自一丛。\n暮云丹水北，古峡苍梧东。\n柳外春沙没，哀哀何处鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次洚水口 其一","author":"区大相","text":"满目兵戈后，西来岂胜游。\n箐林皆置堡，洚水始通舟。\n预恐官租逼，常怀歉岁忧。\n请从渤海治，致盗独无由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次洚水口 其二","author":"区大相","text":"篱落新烟少，江村古塞遥。\n长林收夏榷，残烧长春苗。\n颓屋燕双入，微风花乱飘。\n那堪正水宿，城柝复萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"入罗滂水","author":"区大相","text":"井邑新安集，闾阎杂汉徭。\n火耕春伐木，山猎夜归樵。\n潮响蛮溪合，林光瘴峒消。\n直须勤抚字，慎勿困徵徭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出灵羊峡望香炉诸峡山","author":"区大相","text":"香炉复灵峡，信美且吾州。\n伊昔投荒路，今看拥上游。\n猿啼千嶂雨，枫落片帆秋。\n作赋何年客，偏怜风景幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈少珍移居与周少恂相邻寄怀","author":"区大相","text":"二友衡门接，城隅水竹多。\n闲携青玉杖，高和紫芝歌。\n篱落同鸡犬，衣裳杂薜萝。\n端居寡俦侣，寂寞向羊何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋夜 其一","author":"区大相","text":"摇落才兹夕，萧条已不禁。\n下阶闻坠叶，悬树见栖禽。\n未有干时策，长怀出世心。\n谁言骑省客，独受二毛侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋夜 其二","author":"区大相","text":"昔贤虽宦达，犹或念蹉跎。\n况复飘蓬久，其如落叶何。\n冥冥高鸟翮，滚滚逝川波。\n欲拟清商曲，难赓白石歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21864,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初秋夜 其三","author":"区大相","text":"河低天欲曙，孤坐意何长。\n不惜枫林晚，空怜蕙草芳。\n暗投增按剑，夕济限无梁。\n耿耿不能寐，踟蹰中自伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21865,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚投洲寺","author":"区大相","text":"暝色投沙界，幽香入梵林。\n夕流含砌转，寒叶下阶深。\n借榻邻山狖，张灯散渚禽。\n不须谈出世，虚寂长禅心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21866,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洲寺晚望","author":"区大相","text":"寺僻流双绕，山晴绿四围。\n一僧迎客出，群鹭掠波飞。\n潦尽泉声聒，庭空帆影归。\n息心终傍此，非是暂忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21867,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答苏母舅以九日诗见寄","author":"区大相","text":"忽示登高作，悲怀独有君。\n家贫违故里，书远寄秋云。\n地僻山寒早，江空猿啸闻。\n往时落帽兴，愁绝孟参军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21868,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿端溪口","author":"区大相","text":"烟霏生暝色，信宿伴渔樵。\n地静林无瘴，溪喧水是潮。\n落霞连雁足，残烧隔山腰。\n虽听江城笛，何言乡路遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21869,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚过光孝寺禅室","author":"区大相","text":"真谛何时了，微踪暂托缘。\n鸟啼千岁树，霜冷六时莲。\n风叶随吟客，天花对病禅。\n无论空与寂，水月共思玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21870,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得苏母舅东山书问","author":"区大相","text":"牢落悲吾舅，东山合就耕。\n暮题颜远句，遥寄渭阳情。\n草屋营寒事，沙田足晚成。\n贫居闻亦乐，诗酒过平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21871,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游三洲岩 其一","author":"区大相","text":"闻说岩林胜，西浮锦水春。\n云归瑶径失，雨洗石苗新。\n折桂期山客，攀萝蹑羽人。\n居然成独往，何用记来津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21872,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游三洲岩 其二","author":"区大相","text":"洞启烟扉湿，林悬雾磴斜。\n藏书空有穴，封灶久无砂。\n扣石闻天乐，褰衣动涧霞。\n一从灵景秘，春事长瑶华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21873,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张子以五齐录事传见示因赠","author":"区大相","text":"饮客高阳后，随身双玉瓶。\n百年须酿醉，一月几回醒。\n白眼看人事，清酣识性灵。\n君今颂酒德，吾意亦沉冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21874,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋荷同坐客分赋","author":"区大相","text":"过夏红蕖发，亭亭小院幽。\n迎霜花似浣，听雨叶堪留。\n色静金塘晚，香分玉井秋。\n更宜擎月露，持奉液池游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21875,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端州集梁约中园池 其一","author":"区大相","text":"懒挟朱门瑟，归寻绿水园。\n主人解簪组，留客开萝轩。\n树密云迷径，池清竹映村。\n知君乐情志，不负仲长言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21876,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端州集梁约中园池 其二","author":"区大相","text":"名园多胜事，延赏足烟霞。\n片石开云细，回塘避径斜。\n菊含霜后蕊，桃发春前花。\n未觉年芳暮，留欢醉物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21877,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曲江值雪同家兄舍弟","author":"区大相","text":"急雪孤城下，同云万里长。\n客情犹故国，春色渐他乡。\n冷气开炎峤，流光艳早阳。\n纷纷何所拟，诸谢有歌章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21878,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚次始兴江口","author":"区大相","text":"客程行渐北，乡思转悠悠。\n斗下看雄剑，风前揽敝裘。\n渚花飘映月，霜叶洒随舟。\n今夕南征雁，先飞故国楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21879,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭上见梅花","author":"区大相","text":"梅岭候偏宜，梅花岭上窥。\n报瑶人去远，踏雪马行迟。\n驿使春前发，乡心笛里知。\n已从关路北，犹觅向南枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21880,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题大庾岭北驿兼示入计诸使者","author":"区大相","text":"我行竟何事，访古昭王台。\n沧海搏鹏羽，黄金识骏才。\n游燕歌渐起，系越使初回。\n望气何人在，当关报客来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21881,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虔州西津桥作","author":"区大相","text":"生平重游侠，中岁颇艰虞。\n宝剑南来越，雕弓北射胡。\n风云开上国，雨雪壮长途。\n候吏何须问，关门昨弃繻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21882,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游大隆福寺","author":"区大相","text":"驰道开香界，仙宫近紫微。\n泉清龙旧跃，松暝鹤知归。\n画壁荒苔杂，雕阑蔓草围。\n双幡门外直，犹想翠旗飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21883,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"摩诃庵寻僧不值","author":"区大相","text":"杖锡是何适，云霞少定踪。\n咒龙馀钵水，留鹤伴阶松。\n野立看遥嶂，孤吟待暝钟。\n仍闻弟子说，早晚下西峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21884,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"林开先惠练绢袜","author":"区大相","text":"岂料无衣客，尘中步亦仙。\n迷阳思裹足，举趾意缠绵。\n旅食从貂敝，商歌任履穿。\n王生今老贱，谁引汉廷贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21885,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"开先吉士饷酒云自齐东游日所藏发封大釂不觉尽醉","author":"区大相","text":"贻来千日酒，不饮奈愁何。\n穷路惟堪醉，华年渐欲过。\n开樽恋花月，觅侣坐松萝。\n愿以如渑颂，兼之击唾歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21886,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五日同邓希父蒋兆卿宴黄公绍旅寓园亭时微雨初过得鲜字","author":"区大相","text":"撷艾属芳筵，林亭景气鲜。\n蒲觞开石径，桂楫想江天。\n细葛凉风袭，高槐片雨悬。\n殷勤看彩缕，一倍惜流年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21887,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客中九日","author":"区大相","text":"细雨黄花节，秋风竹叶杯。\n异乡谁送酒，何处更登台。\n木落江云暮，天寒塞雁来。\n惟怜三径在，归去剪蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21888,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅庵僧舍阅黎秘书游石室诸篇草隶","author":"区大相","text":"名山支策去，高咏复寻僧。\n妙墨窥中秘，新诗得上乘。\n给从斋后膳，讲忆佛前灯。\n欲共桦皮出，操觚谢未能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄汝纶柳州寻明府弟","author":"区大相","text":"醉发江上棹，西游见白眉。\n看云吟桂水，访古过罗池。\n霜叶随行暮，江鸿独去迟。\n羡君花萼好，到处有连枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮梁氏园亭 其一","author":"区大相","text":"与客搴芳至，林亭云沼间。\n层轩皆面水，密树不障山。\n露染桂枝碧，烟笼菊蕊斑。\n淹留好情影，乘月憺忘还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮梁氏园亭 其二","author":"区大相","text":"乐志惟兹园，长林隔市喧。\n禽声隐翠筱，松色酿清樽。\n夕水芙蓉媚，新霜薜荔繁。\n小童行酒罢，双管月中翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲冬集梁氏园得江字","author":"区大相","text":"曲槛嘶群骑，平池泊小艭。\n岚光迥夕嶂，雁影溯空江。\n竹密烟沉径，藤疏月挂窗。\n清言恋朋好，胜事狎花缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同家兄舍弟谒文昌台","author":"区大相","text":"珠斗近中台，瑶琨拥化台。\n溪疑曲水接，山似梓潼开。\n紫雾花幢引，晴云宝盖来。\n如闻登桂籍，同此荐椒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太平山庵访朱贞吉","author":"区大相","text":"霞踪成独往，弭棹访云林。\n不识王孙路，惟看忍草深。\n香厨分净供，松籁协幽吟。\n却笑征途者，劳劳江海心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南都 其一","author":"区大相","text":"东吴初建国，四海此来同。\n地跨六朝盛，江连三辅雄。\n玉墀留夜月，金殿锁春风。\n正睹周基茂，千龄咏镐丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南都 其二","author":"区大相","text":"襟带河山是，规模南北同。\n铜盘万岁露，玉井两秋桐。\n江汉思明主，乾坤忆旧宫。\n到来歌舞地，犹想太平风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南都 其三","author":"区大相","text":"汉家敦懿戚，周室重尊亲。\n揖让劳明主，艰危仗节臣。\n豪华卑六代，父老望三秦。\n万古钟山气，长瞻旧紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南都 其四","author":"区大相","text":"名都一何绮，钟阜据玄湖。\n万国舟车辏，千官剑佩趋。\n翠华游凤辇，碧殿想龙图。\n盛德兴王地，元为天下枢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南都 其五","author":"区大相","text":"蓬莱閒綵仗，长乐罢霓旌。\n白动吴江直，青连楚岫平。\n暮云双阙凤，春竹万家莺。\n故老思丰沛，抽毫赋两京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日偕同诸年友集于灵济宫","author":"区大相","text":"结驷情多暇，骖鸾路不赊。\n偶携中圣酒，来过上清家。\n解带褰瑶草，倾壶藉洞花。\n相期炼灵液，携手五云车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初读书翰林作 其一","author":"区大相","text":"材馆抡多士，兰台出秘书。\n紫庭储相日，黄阁礼贤初。\n奏技颁银管，披文映玉除。\n淩云自有赋，何必羡吹嘘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初读书翰林作 其二","author":"区大相","text":"旧事弘文馆，新恩翰墨林。\n琼轩开丽泽，天路合朋簪。\n岁月诸儒论，风云列圣心。\n何人种桃李，于此欲成阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初读书翰林作 其三","author":"区大相","text":"虞代收元凯，周廷引庶常。\n今兼文体重，古以事功良。\n礼乐从先进，鹓鸾接末行。\n何当刷毛羽，云路共翱翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送袁文瀫令富阳","author":"区大相","text":"海邑通秦望，春城过阖闾。\n吏才三仕达，宦迹十年疏。\n梅萼孤山雪，桐江隐士庐。\n从来因好客，官俸惯无馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬至前一日斋居对雪 其一","author":"区大相","text":"缇室窥玄籥，清斋席白茅。\n瑶光连北阙，璧彩近南郊。\n砌迥檐花积，风回苑树交。\n天心如可见，已映易中爻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬至前一日斋居对雪 其二","author":"区大相","text":"迎气潜皇泽，飘霙下帝台。\n兆从三白异，瑞应一阳回。\n净色流坛树，轻飞逐管灰。\n明朝郊祀赋，应待长卿才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诸客过集同送舍弟之东明 其一","author":"区大相","text":"努力向明时，悠然眷路歧。\n之官怀弟别，对友念兄离。\n夜雨黎阳树，春风濮水湄。\n明朝棣华咏，应接芾棠诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诸客过集同送舍弟之东明 其二","author":"区大相","text":"季弟难兄誉，仁风在播扬。\n去天郎宿近，行县绶花香。\n丹阙占凫影，青云起雁行。\n顾惭采风史，抽笔伫循良。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谷日雪","author":"区大相","text":"谷日偏宜雪，花天正起风。\n春归瑶圃外，润洒玉田中。\n阁迥飘还集，阶暄落易融。\n螟蝗今岁少，野老喜年丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春长安道上","author":"区大相","text":"双阙丽朝霞，千门竞岁华。\n苑云微带雪，宫柳半藏鸦。\n结驷过平乐，扬鞭赴狭斜。\n春风才几日，先发上林花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得云近蓬莱","author":"区大相","text":"蓬苑与天通，祥云杳霭封。\n杂花开绛阙，接叶映霞峰。\n日袅仙衣丽，风飘御盖重。\n惟应常五色，朝暮自从龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"院中春日 其一","author":"区大相","text":"柳色连金阙，花香过玉楼。\n林亭罗杂树，池馆带新流。\n禽有迁乔望，人多选胜游。\n谁怜看花伴，独自滞瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"院中春日 其二","author":"区大相","text":"夜宿芸香阁，朝游竹素园。\n花枝连苑密，莺语隔林喧。\n对酒开新帙，看云过别轩。\n仙情自有适，何必访桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"院中夏日 其一","author":"区大相","text":"閟馆肃清芬，虚亭出五云。\n石林藏雨气，霞岛辨峰文。\n露影仙茎溢，莲香太液闻。\n携琴扫萝径，闲坐咏南薰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"院中夏日 其二","author":"区大相","text":"官暇抛章绶，朝回向薜萝。\n风鸣幽涧竹，雨歇小池荷。\n散帙鸟声至，窥潭鱼乐过。\n自怜尘境寂，炎夏得凉多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日偕馆中诸友集天宁寺","author":"区大相","text":"帝京重九日，朋旧共开樽。\n地远城西寺，台高蓟北门。\n云光移塔影，山势断河源。\n忽睹南征雁，令予思故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":21917,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]