[{"title":"风雨大作恐伤来麰","author":"朱诚泳","text":"云暗乾坤晓若昏，狂风挟雨类倾盆。\n妨农独念田家苦，减膳缘渠坐掩门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51912,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀道士","author":"朱诚泳","text":"筇竹投来已化龙，世人何地蹑高踪。\n想应暂憩莲峰下，空听云间半夜钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51913,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题鹭鸶画与武功宋知县","author":"朱诚泳","text":"羽衣如雪照银塘，碧藓矶头立晓霜。\n须信飞腾应有日，凤凰池上接鹓行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51914,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵月下听琵琶","author":"朱诚泳","text":"满天星斗转银河，静听霓裳第一歌。\n翻笑江州老司马，青衫空湿泪痕多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51915,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读韩信传","author":"朱诚泳","text":"鸟尽弓藏事可忧，英雄无术为身谋。\n谁知逐鹿功成后，不及留侯与酂侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51916,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无寐夜坐","author":"朱诚泳","text":"阴蛩切切露华浓，树影横窗月满空。\n夜半秋声起何处，西风萧瑟在梧桐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51917,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"老师张先生致政还蜀久无音信忽闻讣报诗以哀之","author":"朱诚泳","text":"解印当年故里归，三千蜀道雁书稀。\n天涯此日闻哀讣，肠断风前泪满衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51918,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"踏雪寻梅","author":"朱诚泳","text":"万里同云雪满天，蹇驴驼醉峙吟肩。\n不知春到梅花否，行遍前川与后川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51919,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"征夫","author":"朱诚泳","text":"忆从结发戍边头，厌见黄沙黑水流。\n极目乡关正愁绝，雁声叫破一天秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51920,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人之江南","author":"朱诚泳","text":"离却山城向水乡，烟波万顷正茫茫。\n悬知吴下多风味，玉鲙金橙醒醉肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51921,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀人","author":"朱诚泳","text":"画阁东头坐晚风，无缘谈笑一尊同。\n人生聚散真萍梗，知在吴中在洛中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51922,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梦游山","author":"朱诚泳","text":"肩舆稳上玉嶙峋，泉石烟霞喜作邻。\n谯角一声催梦破，始惊身世在红尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51923,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀仙吟 其一","author":"朱诚泳","text":"九华灯影灿银缸，十二琼楼叠绮窗。\n夜静月明双凤下，玉箫何处度新腔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51924,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀仙吟 其二","author":"朱诚泳","text":"明月流辉满太虚，仙游一枕梦蘧蘧。\n帐寒云母秋无际，不见青鸾海上书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51925,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀仙吟 其三","author":"朱诚泳","text":"千岁桃花一夜开，赤城霞气满瑶台。\n西池阿母将临驭，先遣双成跨凤来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51926,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀仙吟 其四","author":"朱诚泳","text":"霓裳霞帔晓翩翩，稳驾天风鹤背仙。\n信是玄洲春不老，紫云苍玉满芝田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51927,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀仙吟 其五","author":"朱诚泳","text":"瑶池路隔海天高，阿母春云入绣袍。\n方朔小儿真狡狯，分明三度窃蟠桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51928,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀仙吟 其六","author":"朱诚泳","text":"玉洞春深护暖霞，一溪流水泛胡麻。\n祥风吹动三珠树，顷刻纷开五色花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51929,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀仙吟 其七","author":"朱诚泳","text":"身世飘飘一羽轻，蓝桥无处觅云英。\n满天香雾空濛里，彷佛瑶环步月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51930,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀仙吟 其八","author":"朱诚泳","text":"彩衣童子著青裙，海上傅书驾白云。\n日暮幔亭箫鼓动，曾孙谁见武夷君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51931,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀仙吟 其九","author":"朱诚泳","text":"天风吹散赤城霞，楼阁参差阿母家。\n三岛仙人开宴罢，金盘留得枣如瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51932,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀仙吟 其十","author":"朱诚泳","text":"水晶台殿晃晴光，云母屏开夜月凉。\n两两素娥乘白凤，桂花香里舞霓裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51933,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"怀仙吟 其十一","author":"朱诚泳","text":"蕊珠金帐甲屏连，衣剪春云绣紫烟。\n鹤背刚风秋万里，夜凉飞下九重天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51934,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春寒 其一","author":"朱诚泳","text":"一片阴云翳碧空，娇莺无语怯东风。\n杏桃花近清明节，犹自缄春不放红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51935,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春寒 其二","author":"朱诚泳","text":"一年春信到人间，捲地东风苦作寒。\n燕子不来帘半捲，满庭香雪杏花残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51936,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日即事","author":"朱诚泳","text":"日移花影上帘栊，金鸭烟销火尚红。\n午梦欲成谁唤醒，数声黄鸟赤阑东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51937,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送董生还蜀","author":"朱诚泳","text":"明时空负贾生才，韦布萧然故里回。\n穷达元来真有命，莫因弹铗重徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51938,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜雨晴 其一","author":"朱诚泳","text":"灏气横秋玉露浮，瑶天云静雨初收。\n虚堂添得凉如许，珠箔通宵不上钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51939,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜雨晴 其二","author":"朱诚泳","text":"银蟾万里转长空，玉宇琼楼入望中。\n夜静天香飞满院，纷纷桂子坠西风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51940,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚景 其一","author":"朱诚泳","text":"远水长天浸落霞，隔溪钟动促栖鸦。\n数声牧笛归来晚，烟草茫茫一径斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51941,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚景 其二","author":"朱诚泳","text":"旷野霜酣柿叶红，疏林人静战西风。\n碧天极目雁归尽，一抹青山夕照中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51942,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赤壁图次王世昌都宪韵","author":"朱诚泳","text":"战胜何须说伯功，江湖风景属诗翁。\n洞箫吹起山东月，人在澄波万顷中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51943,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和杨应宁宪副咏雪诗荅翟少参","author":"朱诚泳","text":"调得新声好自弹，雪车冰柱逼人寒。\n薇垣有客能相和，一曲空传下里难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51944,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赏梅","author":"朱诚泳","text":"堕指冰霜岁暮时，梅花消息到南枝。\n暗香疏影真奇绝，不负孤山处士诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51945,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春兴 其一","author":"朱诚泳","text":"满眼春云合又开，名园处处锦城堆。\n丁宁好为张油幕，恐有游人冒雨来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51946,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春兴 其二","author":"朱诚泳","text":"杨柳青青燕燕飞，鞦韆庭院晚风微。\n玉鞭宝马长安道，公子寻春次第归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51947,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春兴 其三","author":"朱诚泳","text":"东风袅袅雨毵毵，怕湿娇莺语欲难。\n剪就罗衣犹未试，杏花天气尚轻寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51948,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜宴词","author":"朱诚泳","text":"凤管龙笙咽画楼，玉阑干外月波流。\n沈沈更鼓欢娱夜，不识人间别样愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51949,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"凉州词","author":"朱诚泳","text":"十载驱驰铁马间，穷追曾过纥干山。\n如今烂醉蒲萄酒，有诏新来闭玉关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51950,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"惆怅词","author":"朱诚泳","text":"江云渭树各西东，尺素无因寄便风。\n好在折梅如见忆，一枝休惜寄关中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51951,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次娄克让宪副咏梅韵 其一","author":"朱诚泳","text":"一种幽芳占早春，雪中谁是看花人。\n暗香疏影吟边趣，祗许逋仙为写真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51952,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次娄克让宪副咏梅韵 其二","author":"朱诚泳","text":"一树寒梅冒雪开，看梅高士未曾来。\n空庭岁晚无聊赖，索笑巡檐日几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51953,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"得马天禄少卿所寄文","author":"朱诚泳","text":"海内风流独数君，寄来辞翰霭春云。\n欲知名下无虚士，细读韩文与柳文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51954,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"招丘仲玉大参弹琴","author":"朱诚泳","text":"怪石当阶露未乾，小轩松竹溢清寒。\n閒来欲洗尘埃耳，莫惜云泉为一弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51955,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"滹沱冰合","author":"朱诚泳","text":"浪说河冰肯信然，流澌不动果冰坚。\n非关天意怜王霸，汉业中兴本在天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51956,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蚕妇","author":"朱诚泳","text":"脂粉无心懒去施，求桑常恐饲蚕迟。\n绮罗多少红楼女，睡熟纱窗日上时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51957,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春迟","author":"朱诚泳","text":"东风酿雪觉春迟，不见鹅黄上柳枝。\n闭户试听三夜雨，满庭芳草绿差差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51958,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初度日思祖母陈太妃","author":"朱诚泳","text":"初度人人绮宴开，我逢初度不胜哀。\n慈颜一去无消息，忍对南山泻寿杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51959,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春睡美人画","author":"朱诚泳","text":"绣罢鸳鸯午睡浓，香销金鸭绮疏封。\n渚宫有梦怜朝暮，飞下巫山第几峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51960,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春恨","author":"朱诚泳","text":"镇日凝妆倚画楼，黛眉蹙损远山愁。\n边尘未息征夫远，只恐青春误白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51961,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东园即事","author":"朱诚泳","text":"绣幄雕阑护晓寒，万千红紫半瓓珊。\n呼童点检春多少，花事相将到牡丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51962,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"红牡丹","author":"朱诚泳","text":"天风吹破锦云团，凉沁胭脂露未乾。\n好似玉环妆束罢，绛罗衫袖拂阑干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51963,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白牡丹","author":"朱诚泳","text":"素娥乘月下琼楼，脱却天香紫绮裘。\n游遍洛阳无伴侣，凌风骑鹤到扬州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51964,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"黄牡丹","author":"朱诚泳","text":"姚家一种殿群芳，不学宫妆学道妆。\n秀毓中央颜色正，品题无忝作花王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51965,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登楼","author":"朱诚泳","text":"閒来不忍倚危楼，一度凭高一泪流。\n极目青山斜照里，寒烟衰草接松楸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51966,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"小景画","author":"朱诚泳","text":"抱琴散步碧山幽，万壑千岩爽气浮。\n一个茅亭无斗大，如何著得许多秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51967,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"明皇摘瓜图","author":"朱诚泳","text":"翠辇间关道暍时，摘来玉手似嫌迟。\n唯应割食甜於密，不记南方贡荔枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51968,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山行 其四","author":"朱诚泳","text":"上方台殿锁烟霞，石磴萦纡路转赊。\n啼鸟无声僧入定，半岩风落紫藤花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51969,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杏花盛开喜而赋此","author":"朱诚泳","text":"二月春阴花信稀，满庭红杏忽芳菲。\n东君有意须加护，莫遣西风忽漫飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51970,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春夜 其一","author":"朱诚泳","text":"金鸭香销绣幕垂，半窗花影梦回时。\n綵竿閒却鞦韆索，月上梨花第几枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51971,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春夜 其二","author":"朱诚泳","text":"铜龙咽水漏声迟，隔坐香风拂面吹。\n烧尽海棠花下烛，挥毫閒和盛唐诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51972,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游山归","author":"朱诚泳","text":"爱山连日作山行，未惬登临负此情。\n归去夜深诗梦里，依稀犹听涧松声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51973,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春社","author":"朱诚泳","text":"参差茅屋燕飞来，农事方兴社鼓催。\n斜日半山林影乱，杏花香里醉人回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51974,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋月","author":"朱诚泳","text":"景色平分一半秋，广寒宫阙素光流。\n嫦娥此夜勤妆束，玉鉴高悬十二楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51975,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晴望","author":"朱诚泳","text":"浮云飞尽碧空长，天末流风洒面凉。\n独倚危楼吟思远，南山秋色两苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51976,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"渊明归庄图","author":"朱诚泳","text":"萧然一室近南山，五柳春风尽日閒。\n归去有辞传信史，至今清节在人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51977,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谕祭祖王陪朝使宿坟所 其一","author":"朱诚泳","text":"天光终始贲丘园，感激鸿仁矢不谖。\n地下先公应有语，九泉无自荅皇恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51978,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谕祭祖王陪朝使宿坟所 其二","author":"朱诚泳","text":"月冷乌啼二鼓过，一灯明灭夜如何。\n怪来欹枕难成寐，风木萧萧感慨多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51979,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游春","author":"朱诚泳","text":"野鸟啼春弄晓晴，水光山色更分明。\n东君似助游人乐，故遣飞花管送迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51980,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮春","author":"朱诚泳","text":"春事阑珊景渐稀，梨花飞尽柳花飞。\n閒门要路皆芳草，惆怅王孙独未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51981,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春雪","author":"朱诚泳","text":"东风吹冷入窗纱，云黯瑶空散玉华。\n咫尺灞桥无觅处，诗人何地问梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51982,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王鸾同知回凤翔 其一","author":"朱诚泳","text":"锦树西风叶半残，罗衣初试未全寒。\n贰车清健骅骝稳，来往康庄未觉难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51983,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王鸾同知回凤翔 其二","author":"朱诚泳","text":"风流别驾一诗人，几度乘车过渭滨。\n见说年来劳抚字，冰壶秋月迥无尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51984,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王鸾同知回凤翔 其三","author":"朱诚泳","text":"怜君走马向岐州，我欲留君不我留。\n银瓮玉醅新酒熟，东篱空负菊花秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51985,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"慰吴元素长史","author":"朱诚泳","text":"北望桑乾道路长，稀年摆脱利名场。\n从来风物关中好，何必云中是故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51986,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日小集","author":"朱诚泳","text":"满径黄花冒雨开，小亭延客共徘徊。\n蒲萄满瓮新醅熟，不用江州送酒来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51987,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠山中道士","author":"朱诚泳","text":"鍊就金丹不出山，世人那得见童颜。\n他年冲举归蓬岛，华表应看一鹤还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51988,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆郁少参","author":"朱诚泳","text":"我在西秦子在吴，澄江千里梦魂孤。\n何时乘兴重来访，共倒花前酒一壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51989,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋江小景","author":"朱诚泳","text":"极目长江万顷秋，石尤风起荡渔舟。\n投竿一叟推篷坐，似为青山半日留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51990,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"伤思吟 其一","author":"朱诚泳","text":"梧桐月冷夜沈沈，云母屏开思不禁。\n坐拥罗衾方睡涩，岂堪别院动秋砧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":51991,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]