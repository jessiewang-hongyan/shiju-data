[{"title":"怜愚诗四十二首 其十三","author":"宋应星","text":"宦竖么么秽浊躬，投缳旅店疾如风。\n官高经略师徒丧，俛首求生贯索中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其十四","author":"宋应星","text":"一人两子算盘推，积到千年百万胎。\n幼子无孙犹不暝，争教杀运不重来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其十五","author":"宋应星","text":"篇章无奈出身何，释褐忘筌弃则那。\n结习他年难洗涤，刊成宦藁摘瑕多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其十六","author":"宋应星","text":"昔年半菽费忧谋，今日千金橐送收。\n止足不生清夜想，蝇营直向死前休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其十七","author":"宋应星","text":"华夷兵合汴城围，应举书生翰墨辉。\n斜虎已逃宫驾乱，腐儒犹整旧襕衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其十八","author":"宋应星","text":"适口滋甘是处生，酸咸得诀有馀清。\n何须越国求珍错，狗欲伤身长嗜萌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其十九","author":"宋应星","text":"为构华居竭智钱，此身许住几多年。\n儿孙奉祝于斯否，从古雕梁不久延。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其二十","author":"宋应星","text":"桐乡近宦一何愚，欲积鎏金百万馀。\n数未盈时冤已集，一夫作难委沟渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其二十一","author":"宋应星","text":"计度升迁俛要津，卑污启事避人陈。\n尊官掌记知多少，冷语闲谈泄漏频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其二十二","author":"宋应星","text":"废阁生涯妄想荧，敲鱼击磬诵残经。\n随求随得欺人甚，失望荒凉梦不醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其二十三","author":"宋应星","text":"升量学问斗量才，欲作神仙结圣胎。\n蛐蚓若能腾雾雨，蛟龙遍地役风雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其二十四","author":"宋应星","text":"通书浅陋撰何人，选择先生道煞神。\n时日若能催富贵，伊家乔梓岂长贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其二十五","author":"宋应星","text":"神州赤县海环瀛，同日同时万口生。\n佣丐公卿齐出世，先生开卷细推评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其二十六","author":"宋应星","text":"世代江山几裂完，随宜田宅且相安。\n经年计较团成片，两子分开局已残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其二十七","author":"宋应星","text":"天垂列象圣遵模，为问还丹事有无。\n万斛明珠难换颗，痴人妄想点金须。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其二十八","author":"宋应星","text":"繁华寂寞转轮间，热闹场中莫久顽。\n闻道盛唐云锦队，回头兵火破潼关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其二十九","author":"宋应星","text":"太平风景四郊安，邻里穷时我亦单。\n五亩宫墙何固有，负刍一至路行难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其三十","author":"宋应星","text":"世间左道孰为凶，最是龙阳泣楚宫。\n禽兽犹明真配合，生人反昧假雌雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其三十一","author":"宋应星","text":"悦爱娇容种性生，视同苴土远人情。\n罗敷自有天分限，妄想繁时剧祸盈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其三十二","author":"宋应星","text":"元宋推寻楚汉时，千秋名姓几盘棋。\n儿孙田宅思牢固，官印私钤策罔遗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其三十三","author":"宋应星","text":"既晓森罗业镜光，侈焚冥镪寄虚堂。\n只言贿赂通阴界，先造繁词奏法王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其三十四","author":"宋应星","text":"清寒原是好名声，误拟羞惭效侈盈。\n勉强风流神不王，困穷无计酿戈兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其三十五","author":"宋应星","text":"良犀美玉巧工雕，议款平酬贵客邀。\n封付儿孙传玩远，未寒四大已萍飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其三十六","author":"宋应星","text":"子孙贤否性相成，作法毋凉尽我生。\n遗嘱絮烦临疾病，何曾片语耳根迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其三十七","author":"宋应星","text":"人生愿欲自无穷，官贵金多百岁中。\n衰相已形功德薄，遗言墓志托名公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其三十八","author":"宋应星","text":"说短谈非遍世间，终身隔耳罔相关。\n才闻传报无多语，烟起心胸火足颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其三十九","author":"宋应星","text":"人到无能始贷金，子钱生发向何寻？\n厉词追索弥年后，生计萧条起绿林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其四十","author":"宋应星","text":"著述诗书吐肺肝，目前身后几人看。\n装成圈点吾徒炫，假序名公识者弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其四十一","author":"宋应星","text":"已信天工有命偕，死生富贵尽前排。\n祈禳谋策纷纭起，信命初心顷刻乖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怜愚诗四十二首 其四十二","author":"宋应星","text":"耳目相同男子官，聪明差异万千端。\n群生尽葬愚公谷，阅尽方知智者难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"知山阴县事阳坡周君先大夫裕州旧治也余以使事至得缔交述先大夫均田之绩父老至今颂之周旋浃月言别黯然赋以志谢","author":"安希范","text":"丈夫重意气，结交自东因。\n接栋成暌隔，千里如比邻。\n相知无久暂，此义难重陈。\n余忝驰驱吏，君属封疆臣。\n一朝幸遇合，片言意各申。\n忻羡美无度，标韵邈殊伦。\n胡威励清操，宓子政化淳。\n增秩宠循良，借寇慰编民。\n闻君桑梓乡，先烈炳若新。\n永言勿剪诗，阡陌思逡巡。\n畴昔通家好，今看肝胆真。\n世态媚颜色，雅道久沉沦。\n勉■策前路，芳躅追古人。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乾元遇李一了江文谷二隐者","author":"安希范","text":"我来访幽人，独入山深处。\n窈窕觏丹崖，神情巳轩翥。\n白云拂我衣，飘飘若飞絮。\n瞥见千树桃，烂熳红霞曙。\n茅庵隐青松，彷佛群仙署。\n中有两三翁，蒲团各箕踞。\n坐久寂忘言，澹然消俗虑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙井访友元王隐君次屠纬真韵","author":"安希范","text":"挟策蹑青苍，空山罕人迹。\n藤萝挂悬漫，古木压危石。\n仰望空翠中，霭霭孤云白。\n山阿靓以深，幽人此栖息。\n烟霞幻奇境，杳与尘世隔。\n松隙辟瓮牖，湖光荡虚壁。\n趺坐一蒲团，心猿调定力。\n欲叩元中元，象罔渺然测。\n清言互酬应，岚气忽云夕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杂咏","author":"安希范","text":"直道世不容，枉已吾所耻。\n枉直贵自辨，得失勿恤尔。\n皎皎虽易污，庸庸亦可鄙。\n宁为韫璞玉，勿作踰淮枳。\n期我同心友，百年共相矢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月既望过圻村访蔡金风适冲寰翁至同登龙山寻幽谷钓台诸胜晚留小酌泛月而归 其一","author":"安希范","text":"凉飙散馀燠，秋光澹山市。\n策杖寻幽人，行行二三里。\n循径既纡曲，缘溪复迤逦。\n小桥路转东，柴门恰临水。\n主人意殷勤，劝客且留止。\n山村无兼味，鸡黍聊可庀。\n适逢邻翁至，相揖色先喜。\n今晨逢渔者，买得鳜鱼美。\n请客过山斋，烹鱼酌村醴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月既望过圻村访蔡金风适冲寰翁至同登龙山寻幽谷钓台诸胜晚留小酌泛月而归 其二","author":"安希范","text":"相携过溪桥，宛转入村径。\n门巷既萧閒，庭户岚光凝。\n小斋幽且清，梅竹翠交映。\n閒抽架上编，疑义互相證。\n楸枰聊角奕，唐突叨屡胜。\n欢情既巳洽，冷语皆可听。\n饮啖颇适意，朋俦竞呼应。\n宾主虽颓然，缥缈发馀兴。\n取道丛竹边，扶筇陟危磴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月既望过圻村访蔡金风适冲寰翁至同登龙山寻幽谷钓台诸胜晚留小酌泛月而归 其三","author":"安希范","text":"岩壑饶幽茜，磴道亦萦复。\n始陟从阴崖，盘旋下阳麓。\n徘徊丛草间，跫然至容谷。\n樵人误指径，荆榛多枳足。\n少傅昔留题，摩藓犹可读。\n寻幽兴转剧，委蛇血湖澳。\n钓台忽回望，奇胜更悦巳。\n高岩似列屏，古洞如夏屋。\n此地若诛茅，居然可卜筑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七月既望过圻村访蔡金风适冲寰翁至同登龙山寻幽谷钓台诸胜晚留小酌泛月而归 其四","author":"安希范","text":"冥搜兴未已，夕阳忽西下。\n湖光展轻縠，霞彩纷相射。\n伫望既忘疲，盘石更可藉。\n良会既巳逢，好景复堪诧。\n迫暝乃言旋，主人固相迓。\n儿童喜奔走，空庭期卜夜。\n鲜脍荐盈□，芳醴酌深斝。\n留宾意何穷，客子重致谢。\n泛月吾欲归，扁舟乞相借。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凊和三日与高存之冒雨入桐城竹坞纪事","author":"安希范","text":"名山得佳侣，胜情倍踊跃。\n轻舆冒雨行，沾湿不为却。\n入谷屡呼奇，谓我得所托。\n谷口田可耕，涧中泉不涸。\n岩岫饶异花，林薄多灵药。\n茶椒被阳坡，芝兰满幽壑。\n竹竿千万个，生计良不薄。\n世情厌冷淡，吾尔耽寂寞。\n速结三间茆，量营一小阁。\n烟霞有奇趣，朝夕饱领略。\n吾将从子居，相与餐葵藿。\n人生更何事，可博山居乐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱君采侍御青莲居","author":"安希范","text":"夙闻苕霅间，山水多清远。\n讵意阛阓侧，蓬瀛忽在眼。\n偶乘一叶舟，沿洄恣游衍。\n轻飙偃菰芦，微波荡菱芡。\n丛篁雄灌木，森蔚盘回转。\n中有伊人居，列户抗遥巘。\n堂宁据胜开，楼榭随宜建。\n高阁俯乔林，群峰历可辨。\n凭栏耳目旷，隐几缥缃展。\n时报黄鹤驾，閒诵青华简。\n客至辄披襟，开尊出丰膳。\n论世谈既雄，参微语尤隽。\n廿载忝交契，老至弥缱绻。\n余兹将卜邻，栖托计非舛。\n更藉地主贤，早为择所善。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"效白香山四虽吟","author":"安希范","text":"吾闻古人云，人苦不知足。\n试歌香山居士四虽吟，似我受用巳奢更何欲。\n发虽短兮尚可束。\n官虽卑兮名未辱。\n囊虽空兮百指饘糜有馀粟。\n子虽愚兮数卷父书犹可读。\n朱颜绿鬓谁能久，官高要路危机伏。\n黄金过斗亦何为，快意无如谢庭玉。\n架上閒抽一卷书，尊中满酌三杯醁。\n读书饮酒乐且多，勿为身外营营自桎梏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石公晓起看日出月落","author":"安希范","text":"我昔曾读弇州伯仲诗，盛称石公日月出没景最奇。\n至今两歌犹脍炙，读之往往神先驰。\n登临自负颇豪逸，入山往往凌崒嵂。\n每携短策冲残暑，屡上危峰观落日。\n缥缈龙山尽大观，未若兹游更奇绝。\n昨宵醉月石公湖畔石，归卧山楼正酣适。\n醉消梦醒鸡乱鸣，照地馀光似霜白。\n摩娑睡眼一搔首，瞥见朱霞射东牖。\n急起凭栏左右望，动魄惊魂叹希有。\n湖光湛湛如凝碧，上下水同天一色。\n若木腾辉桂影寒，日月双悬如合壁。\n羲轮渐远东峰翠，望舒西引如相避。\n金乌鼓翼玉兔顾，相望依依若相媚。\n恍疑神女凌波来，双携明镜临妆台。\n红绡彷佛长裾展，绿縠纡徐舞席开。\n又如宜僚弄丸呈巧技，上下回环终不坠。\n忽然两壁直如衡，不觉双丸若平置。\n长风萧萧扬素波，晶盘隐隐呈青螺。\n遥看天际群峰色，处处岚消出翠蛾。\n天地之间亦大矣，五湖不过三百里。\n乃知见性自无涯，日月升沉只如此。\n倚槛徘徊默有，恍惚此身凌倒景。\n须臾日高月渐没，晓岚犹自侵衣冷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"霍公默留榻新斋索题斋额余以主人不饮而嗜茶为题曰醉茗而系之以歌","author":"安希范","text":"少年饮兴亦颇豪，常苦量浅易成醉。\n狂饮不能倾一斗，百事昏昏半失记。\n中年节饮渐嗜茶，好尚亦因衰壮异。\n顷缘采茶亲入岕，道傍偶尔得胜地。\n其地更逢贤主人，岩山霍氏诸昆季。\n长公公默不善饮，独于茗汁有深嗜。\n念余衰惫困登陟，为余下榻苏劳瘁。\n书斋新构洁且清，欲署斋名乞题字。\n主人嗜茶为客供，采摘收藏得三昧。\n竹垆瓦□手自煎，溪水清于泉第二。\n饮过七椀趣转佳，濯魄凝神便酣睡。\n乃知茶功胜于酒，玉川先生真解事。\n因题斋名曰醉茗，一笑颇全主人意。\n从今便欲谢曲生，尚念此生有风味。\n只恐重逢刘阮徒，搏虎雄心仍攘臂。\n应知啜茗可解酲，二者可兼不可废。\n一壶清醑一壶茶，醉醉醒醒各有致。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用先大夫韵题风树楼壁","author":"安希范","text":"楼临卓锡地，幽境绝尘缘。\n高情寄松竹，藻思入云烟。\n窗影分新绿，池流接远泉。\n悲心感风木，洒泪古碑前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚过山馆","author":"安希范","text":"策杖度西岭，诸峰明落晖。\n乱松群鸟集，野寺一僧归。\n山静钟声近，林深月色微。\n前途烟树合，灯火映柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西林燕集得诗字","author":"安希范","text":"淑景牵芳思，尊开绿水涯。\n机忘鸥自狎，坐久日偏迟。\n草色侵衣袂，林香入酒卮。\n归途霞绮合，醉里就新诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清樾堂夜坐","author":"安希范","text":"密树清残暑，空庭夜色閒。\n吟风蝉韵断，惊月鸟飞还。\n不惜歌金缕，宁辞倒玉山。\n横参犹恋赏，竹露湿潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人日昌平道中晚行","author":"安希范","text":"怅别都门酒，轺车入夜行。\n疏星带远塞，斜月傍孤城。\n寒重人无语，风高马乱鸣。\n遥思传采胜，转觉客心惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阳和道中逢初度","author":"安希范","text":"握节行穷壤，悬弧际旧辰。\n萍踪边地雪，柳色故园春。\n颜为风尘改，年从道路新。\n一觞聊自祝，僮仆且相亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪霁后王相公招饮郊园","author":"安希范","text":"出郭乘初霁，高台列绮筵。\n北临收市邑，南睇俯山川。\n莘野耕春雨，磻溪钓暮烟。\n圣明虚席待，莫负太平年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上元日南林探梅分得生字","author":"安希范","text":"冲寒理游屐，入径破苔行。\n岚气纷纭上，花香断续生。\n沙平鸥乱立，树冷鸟无声。\n为惜芳时过，清尊且尽倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿华容寺次壁间丁元甫韵","author":"安希范","text":"四壁多风雨，萧萧坐觉寒。\n野僧供茗椀，驿子具盘餐。\n地僻人烟迥，年饥邑里残。\n荒村防夜警，孤剑拂檐看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上吴明卿先生","author":"安希范","text":"词坛推定伯，论久属名贤。\n奇字门人问，雄文异国传。\n技惭供执役，交敢冀忘年。\n珍重怜才念，虚烦倒屣延。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬辰礼闱夜集得虚字","author":"安希范","text":"联事逢佑已，邀欢慰索居。\n苦吟红烛短，剧饮绿尊虚。\n柝警严更后，寒生积雨馀。\n相看惜良会，不醉复何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顾季时仪部左迁光州暂归里中赋此代问","author":"安希范","text":"八年经再黜，直道自间关。\n名不随官贬，家因赴谪还。\n中原迎紫气，汝颍狎青山。\n天意高难问，何时有赐环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送孙恒叔比部远谪","author":"安希范","text":"莫怨君恩薄，天王自圣明。\n官卑犹食禄，地远尚全生。\n所愿秉完节，无为负令名。\n临岐更携手，商略只躬耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送谭敬卿比部削籍西归","author":"安希范","text":"分曹非夙契，抗疏偶同心。\n先后蒙严谴，相将及故林。\n新知乍倾盖，岐路忽沾襟。\n但使存吾道，何须叹陆沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"削籍东归留别秣陵诸相知 其一","author":"安希范","text":"主圣恩常厚，臣愚分固安。\n幸蒙宽斧钺，敢复齿衣冠。\n离思萦千绪，私忧起万端。\n须知临别泪，不为恋微官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"削籍东归留别秣陵诸相知 其二","author":"安希范","text":"去国心宁恝，思家眼欲穿。\n虽蒙明主弃，尚得故人怜。\n惜别泪先堕，临岐袂更牵。\n殷勤期后会，未卜是何年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"削籍东归留别秣陵诸相知 其三","author":"安希范","text":"十年惭窃禄，一日效愚忠。\n戆直曾何补，疏狂甘固穷。\n但令图史足，不愧橐囊空。\n欲问归田事，斋心祝岁丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"削籍东归留别秣陵诸相知 其四","author":"安希范","text":"角巾殊不俗，野服雅相宜。\n故里春将半，归帆去未迟。\n宁亲时问膳，抱子慰含饴。\n无限田园乐，长歌陶令辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":35688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]