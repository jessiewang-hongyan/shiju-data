neror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"隐园杂咏十七首 其八 海月楼","author":"黎民表","text":"明月出海底，倒影池上楼。\n清辉不可揽，白露湿衣裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"隐园杂咏十七首 其九 鹅群阁","author":"黎民表","text":"清池浴皓羽，乱此罨画影。\n蘋末来清风，葛巾自慵整。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"隐园杂咏十七首 其十 鸥波","author":"黎民表","text":"白鸥日飞来，止我茄下食。\n不但无机心，回旋似相识。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"隐园杂咏十七首 其十一 柳浪堤","author":"黎民表","text":"金塘澹淡浮，垂柳参差碧。\n千里江南春，移来君几席。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"隐园杂咏十七首 其十二 飞影亭","author":"黎民表","text":"太虚本无色，止水亦长瑩。\n如何桂轮中，忽有山河影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"隐园杂咏十七首 其十三 浮玉桥","author":"黎民表","text":"短桥流不去，回波相激鸣。\n度我幽寻屐，千花隔岸明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"隐园杂咏十七首 其十四 芙蓉馆","author":"黎民表","text":"何年移玉井，开作满池花。\n白鸟凌波去，青天裂片霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"隐园杂咏十七首 其十五 鹤径","author":"黎民表","text":"曲径不用车，通行止孤鹤。\n畏有红尘踪，惊我岩花落。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"隐园杂咏十七首 其十六 萃止居","author":"黎民表","text":"眷然京华游，岁暮心无已。\n寄谢陶柴桑，今朝真已矣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"隐园杂咏十七首 其十七 借眠轩","author":"黎民表","text":"曾作秦淮梦，篝灯对风雨。\n客散春山空，独鹤向人语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别次甫因忆子与 其一","author":"黎民表","text":"疏雨过高城，流云止双阙。\n阴晴千里外，何处看明月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别次甫因忆子与 其二","author":"黎民表","text":"风雨入夏凉，林花开复谢。\n深杯不共持，奈此消閒夜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别次甫因忆子与 其三","author":"黎民表","text":"卤莽风尘者，相逢总问津。\n如何临别酒，重忆远游人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赏菊 其一","author":"黎民表","text":"不用嗟摇落，春风在习家。\n天山三丈雪，犹作满篱花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赏菊 其二","author":"黎民表","text":"疾风吹劲枝，寒月照冷艳。\n独抱岁寒心，林深人不见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"列岫亭以窗中列远岫为韵 其一","author":"黎民表","text":"月与青山对，开门玉作双。\n有时乘倒景，簸弄石蚝窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"列岫亭以窗中列远岫为韵 其二","author":"黎民表","text":"端居不出户，吟啸此亭中。\n石床留夜月，桂树抟秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"列岫亭以窗中列远岫为韵 其三","author":"黎民表","text":"药畦将菊径，整整方成列。\n带经日徘徊，芳蕤露中折。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"列岫亭以窗中列远岫为韵 其四","author":"黎民表","text":"会心不在多，一丘堪偃蹇。\n始笑武陵人，移住花源远。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]