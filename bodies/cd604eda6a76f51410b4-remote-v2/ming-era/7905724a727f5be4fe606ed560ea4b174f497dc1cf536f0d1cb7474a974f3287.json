[{"title":"六月六日天界寺社集诗","author":"邓云霄","text":"避地云山绕寺青，诸君还拟草玄亭。\n论文海内皆兄弟，玩世尊前混醉醒。\n一笑功名如梦鹿，百年踪迹本浮萍。\n秋风已奏思归引，谁向罗浮问客星？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋前五日社集天界寺诸词客分赋金陵名胜送余行余分得白鹭洲探五微留别","author":"邓云霄","text":"二水中分烟渚微，江光如练澹晴晖。\n芳洲自入青莲笔，群鸟犹矜白雪衣。\n沙净伫看连影立，风生散作几行飞。\n怜君心逐洲前水，夜夜随潮送客归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋夜同郑翰卿天界寺玩月","author":"邓云霄","text":"一叶惊秋旅思赊，钟声初歇夜无哗。\n风生虚壑吹灵籁，露湿遥天洗月华。\n杯影动摇青桂阙，池光不辨白莲花。\n下方谁破尘劳梦？\n万户垂杨自宿鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别各垣科长","author":"邓云霄","text":"雪涕中原感慨馀。\n离亭斜日揽君裾。\n南音忍听将归曲，北阙谁收痛哭书？\n梦绕掖垣还有竹，秋回故国岂无鱼。\n他年欲访垂纶地，杜若洲边半亩居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别吴翁晋孙燕诒及诸同志君子","author":"邓云霄","text":"对酒悲歌赋式微，行行重叹故交稀。\n离弦一奏天应老，别鹤三声叶尽飞。\n怀抱何人常按剑？\n路岐怜汝独沾衣。\n山中生事如相问，夜雨秋风长蕨薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过长沙吊屈贾祠","author":"邓云霄","text":"落羽湖南岂壮游，长沙风物黯生愁。\n魂沉大泽招难起，水绕荒祠咽不流。\n斜日寒林闻鵩鸟，空江鼓枻见渔舟。\n从来逐客伤心地，岁岁枫丹不待秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日集黄鹤楼","author":"邓云霄","text":"生茫三楚赤栏前，缥缈遐心绕四天。\n鹤去难招烟外客，醉来还爱酒家眠。\n落梅吹笛仍今日，芳草晴川似昔年。\n可叹善题鹦鹉者，不知人世有飞仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜集岳阳楼","author":"邓云霄","text":"霜华湖影两漫漫，云外清酣共倚栏。\n风急楼台摇蜃气，浪消星斗在银盘。\n岧峣上接三天近，浩淼平吞七泽宽。\n半夜月明闻鼓瑟，湘妃眉黛卷帘看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿岳馆书怀","author":"邓云霄","text":"珊珊剑佩下云边，虚馆华灯坐洞天。\n济胜只凭双蜡屐，买山何用半文钱。\n风传疏磬门初掩，窗绕流泉梦亦仙。\n乞得湖南清绝地，续骚应著远游篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛亥中秋招徐圆海湘流玩月","author":"邓云霄","text":"空水亭亭两镜明，微澜不动夕流清。\n谁传桂阙霓裳曲，来和湘灵鼓瑟声？\n露冷蘅兰秋未老，风恬乌鹊夜休惊。\n扁舟无限骚人意，欲下江潭吊屈平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛亥重阳前一日行部永郡遇雨宿乌符观观白玉蟾驱蟒灵符及吕纯阳真笔诗","author":"邓云霄","text":"潇潇暮雨湿行装，托宿仙宫夜正长。\n自有灵符驱毒蟒，至今灵气护虚堂。\n常怀鹤背人如玉，未就丹砂鬓渐霜。\n叹息登高无限意，天涯明日又重阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祁阳道中逢九日","author":"邓云霄","text":"露洗寒山秋色新，驱车空惹路旁尘。\n白云天外悲游子，黄菊篱边笑主人。\n岁岁难抛三尺组，悠悠虚负百年身。\n莼鲈更比茱萸好，欲向湘江问钓纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒曾植斋先师墓","author":"邓云霄","text":"寒林萧飒锁愁烟，下马新阡忆往年。\n天诔高悬金简字，山灵长护玉堂仙。\n松间月冷眠孤鹤，谷口春残怨杜鹃。\n更过闲斋拜遗像，绛纱琴瑟尚依然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得张无名雁字诗书此报之","author":"邓云霄","text":"衡阳坐叹无来雁，有客偏传雁字诗。\n黄菊东篱谁共醉？\n碧云南国重相思。\n关山千里书归后，梁月三更梦破时。\n欲寄幽兰临楚水，湘灵瑶瑟不胜悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛亥郴州除夕忆家慈舍弟","author":"邓云霄","text":"年年除夕在天涯，宦迹如萍黯自嗟。\n镜里形容看渐老，灯前儿女漫为家。\n北堂佳气依萱草，南国春光入棣花。\n愿倩苏耽云外鹤，乘风归去酌流霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬子元日书怀","author":"邓云霄","text":"微雨蒸霞似曲尘，山城含暖早知春。\n谁移北斗迎新历？\n偶遇东风识故人。\n楚客三年淹旅服，湘江万里老波臣。\n年来无复长安梦，昨夜还惊入紫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衙斋昼长无事扫地焚香一日数次几案净纤尘犹时拂拭泠然自善聊书一章","author":"邓云霄","text":"问君簿领几雍容，剩得焚香扫地功。\n莫遣纤尘侵几案，静看迟日度帘栊。\n官闲好似三眠柳，亭小宜通四面风。\n谁道长安多贵客？\n年年车马在尘中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏题榆钱二首 其一","author":"邓云霄","text":"翩翩南陌又东邻，芳树丛中若有神。\n正值韶光三月节，平分富贵万家春。\n飞空不倩青蚨翼，铺埒轻沾骏马尘。\n买得清风与明月，十千沽酒莫嫌频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏题榆钱二首 其二","author":"邓云霄","text":"淡烟笼日转花阴，高绕秋千度上林。\n试向名园拚一掷，酬他春夜值千金。\n斜穿嫩柳丝长短，细点新荷水浅深。\n莫怨东风漂荡尽，石家池馆亦消沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"楚雨弥旬戏作禁体释闷","author":"邓云霄","text":"冥冥高浪蹴天浮，却怪清湘变浊流。\n石燕迎风偏自喜，龙山吹角几时休？\n香厨烟湿蛙生灶，深院潮生芥作舟。\n谁道楚宫今寂寞？\n襄阳还在梦中游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春夜闻鹃","author":"邓云霄","text":"哀歌中夜叩刀环，又听鹃声落枕间。\n野鸟亦知归去好，宦游曾见几人还？\n搔残两鬓愁如海，啼罢三更月满山。\n惆怅劳劳将半百，朝来徒羡片云闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬子首夏衡郡苦雨城郭闾阎几至陆沉湿气薰蒸十家九病衙斋愁坐脉脉无绪戏作反言拗体诗聊索笑以自解","author":"邓云霄","text":"读罢离骚一问天，今世何世是尧年？\n行云神女太有意，抱瓮丈人宜晏眠。\n翻疑比屋为鲛室，便可骑鱼学水仙。\n休叹群芳垂玉箸，檐花还胜琼花鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嘉晴诗亦作反言拗体","author":"邓云霄","text":"正看蓬岛浮仙城，谁遣烛龙含笑迎？\n黄鹂漫啼风日好，黑蜧犹怨鼓钟清。\n生憎残虹拂银竹，不分返照摇金茎。\n辙底波臣莫愁思，途间流潦尚纵横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏杪夜坐玩月","author":"邓云霄","text":"雨过空阶夜转幽，微凉先送一堂秋。\n静看碧汉摇轻浪，欲泛红莲作小舟。\n桂阙寂寥闻捣药，榆花早晚问牵牛。\n兴来直挟飞仙去，不数人间庾亮楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衡南秋夕有怀陈仪翔年丈却寄","author":"邓云霄","text":"楚水枫林带晚霞，谁怜为客近长沙？\n峰前雁阵三秋断，天上鹓行万里赊。\n愁绝懒调湘女瑟，梦回犹听蓟门笳。\n思君更忆同游地，为问玄都几度花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和梦美人送花诗","author":"邓云霄","text":"宴罢高楼卧锦裀，多情遥赠一枝春。\n翩跹不让行云女，芳艳偏怜化蝶人。\n送去长廊摇玉佩，醒来馀馥染罗巾。\n仙踪定落吴王苑，香径湖边再问津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀陈直轩","author":"邓云霄","text":"燕市栖迟揽敝裘，桥门春水忆同游。\n论心曾对风霜夜，往事俄惊十八秋。\n谁验白虹收楚玉？\n好吹赤电拂吴钩。\n伤离正叹南鸿断，又见潇湘向北流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题五首 其一","author":"邓云霄","text":"绣户阴森似洞天，佯真半喜总婵娟。\n鸾箫不奏人间曲，桂阙空留月里仙。\n共拟倾城酬百万，还闻弱水隔三千。\n宋家墙角垂垂柳，未许金梯架翠烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题五首 其二","author":"邓云霄","text":"阁雨停云暮复朝，潘郎残鬓沈郎腰。\n蓝桥有路终思到，青鸟无情未易招。\n绠断银瓶秋井寂，风敲鱼钥夜钟遥。\n博山火敌霜华冷，沉水名香只自烧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题五首 其三","author":"邓云霄","text":"不是秋期不渡河，珊珊星佩几时过。\n七弦恨谱啼圾雉，一片春情挂女萝。\n梦入花房疑蛱蝶，乞为寒兔近嫦娥。\n东流不顾西飞日，莫遣红兰变绿莎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题五首 其四","author":"邓云霄","text":"曾寄明珰托小鬟，多情回赠玉连环。\n已题红叶随流出，何事朱门带月关？\n微步烟中迷洛浦，修眉湖外望君山。\n轻身自叹输韩寿，咫尺琼枝不可攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题五首 其五","author":"邓云霄","text":"买得相如旧日琴，微风澹荡送轻音。\n通天莫道犀无窍，逐伴应怜凤有心。\n调罢金徽宵漏歇，立残苔径晓星沉。\n凭将河汉倾双泪，添却南溟北海深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖南九歌 其一","author":"邓云霄","text":"石鼓承平久不鸣，空馀台榭映江清。\n胜游旧是风雩地，满院时闻弦诵声。\n波展琉璃澄返照，桥跨䗖蝀报新晴。\n晚招河伯谈秋水，坐待东岩片月生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖南九歌 其二","author":"邓云霄","text":"秋望青苍万里馀，层阴落日渺愁予。\n浮云自敞鹓鸾路，傲吏常依水竹居。\n风过洞庭闻帝乐，月明衡岳梦神书。\n君看泛宅悠悠者，静对轻鸥不取鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖南九歌 其三","author":"邓云霄","text":"词赋千秋自有神，谁从鱼腹起灵均？\n椒浆寄奠丹枫暮，兰佩凄凉绿水滨。\n日远长安多逐客，秋高泽国怨骚人。\n劳歌一曲西风急，遥忆当年郢调新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖南九歌 其四","author":"邓云霄","text":"有客悲秋起四愁，况逢山水号云秋。\n烟中鸟没九疑杳，湖外天低七泽幽。\n帝女香魂长倚竹，王孙芳草漫登楼。\n潇湘空阔堪乘兴，赋得新篇学远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖南九歌 其五","author":"邓云霄","text":"楚酒如饴不可沽，浪传城外有酃湖。\n闲眠已足三竿日，种秫谁供半亩租？\n喜傍名山随倚杖，更听歌鸟劝提壶。\n子廉洞口烟云冷，吾欲因之觅酒徒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖南九歌 其六","author":"邓云霄","text":"横塘疏柳绕长堤，楚客行吟日渐西。\n官懒古来推漫叟，江源南去透愚溪。\n轮蹄远隔中原道，林壑偏宜大隐栖。\n颇似淮阳高卧者，梦回犹怪午时鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖南九歌 其七","author":"邓云霄","text":"怀古思乡对晚曛，亭皋落木不堪闻。\n秋蝉冷咽醒伊笛，野老新耕杜甫坟。\n处处白蘋翻白鸟，山山红树乱红云。\n西风好送离人梦，粤北湖南一岭分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖南九歌 其八","author":"邓云霄","text":"愁怀景物两相关，一日惊秋鬓尽斑。\n雁阵远题天外字，湖光平写镜中山。\n行云冉冉还多变，流水滔滔不暂闲。\n四十年来成底事，生涯应在醉醒间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖南九歌 其九","author":"邓云霄","text":"寥落枫林阅岁年，宦情人事总凄然。\n三湘地湿常飞鵩，九月溪炎尚堕鸢。\n云去苍梧难谒帝，坛寒青玉羡游仙。\n谁云弱水三千远，自有飙轮电作鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"移镇郴阳道中作","author":"邓云霄","text":"楚南烽燧寂无闻，何事频移太乙军。\n笳鼓绕山冲虎穴，旌旗临水散鸥群。\n岩扉僧守千年寺，茅屋人耕一片云。\n堪笑尘途啖名客，劳劳来往愧苏君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏郴署堂前双古松","author":"邓云霄","text":"偃盖回风生夕澜，散衙萧瑟独凭栏。\n雪封千尺龙鳞老，月挂三更鹤梦寒。\n香粉霏微调美酝，瑞烟浮动近仙坛。\n君看气岸高如许，肯向山头羡射干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊嘉鱼赤壁","author":"邓云霄","text":"正对青枫伤旅望，还看赤壁倍潸然。\n二乔不作铜台妓，万舰空飞汉水烟。\n寂寞沉灰波浸月，萧条霸气草连天。\n可怜一片江边石，曾见周郎是少年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"啖荔","author":"邓云霄","text":"前溪水长白鸥飞，荔熟垂垂满钓矶。\n昔日他乡思驿骑，今朝巧笑对宫妃。\n摘来翠袖笼红玉，剖破琼浆溅绛衣。\n一啖已过三百颗，好风凉月憺忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夏日同周昆彦集祁恒季绿水园竹下听雨既醉祁仲鱼适至乘兴酩酊俄晴得月泛舟而返","author":"邓云霄","text":"郭外村原眺望清，江干池馆水云平。\n客来自挟雄风入，雨过微闻漱玉声。\n半醉高阳逢旧侣，放歌华月报新晴。\n乘潮归去兰舟晚，人共沙鸥片片轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺留题","author":"邓云霄","text":"廿年湖海漫夷犹，频过飞来忆旧游。\n往日僧徒还岁月，重来陵谷变春秋。\n犀沉猿去名空在，洞古云深境自幽。\n欲识西方真面目，寒潭不与峡江流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊韩泷宿昌黎庙下感异梦醒闻泷声作","author":"邓云霄","text":"九折风波一叶舠，醉眠还觉梦魂劳。\n怪看皓月闻雷雨，谁遣空岩落海涛？\n远谪何辞烟瘴恶，孤标终仰斗山高。\n夜来亲听昌黎语，只有文章属自操。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过岳阳有怀吕仙","author":"邓云霄","text":"亦曾三醉洞庭旁，未向纯阳乞酒方。\n阅世自怜春梦短，望仙空叹水云长。\n红尘赤日劳奔走，黄鹤青蛇竟杳茫。\n更忆吾家蓬岛近，罗浮东去即扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸丑岁暮沿洞庭沙洲入湖南时微雪欲集气暄成雨回望岳阳楼沉烟雾中追忆旧游星分雨散感赋志恨","author":"邓云霄","text":"云蒸湖气卑还湿，雪洒波光暖却融。\n有客碧油冲暮雨，何人青雀破长风？\n孤城向水萧条里，残腊催年惨澹中。\n最是多情醉游地，故人零落又西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洞庭湖畔吊君山二首 其一","author":"邓云霄","text":"白沙青草曲相连，帝子祠前水拍天。\n环佩孤悬长袅袅，风波不动自年年。\n啼残越鸟三冬雨，恨结苍梧九点烟。\n欲驾危桥荐蘋藻，湖旁顽石不堪鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洞庭湖畔吊君山二首 其二","author":"邓云霄","text":"重奏骚词吊二灵，雾鬟烟鬓望中青。\n冯夷出舞祥风起，龙女辞归古殿扃。\n暗向竹枝垂涕泪，愁开玉镜照娉婷。\n酒香亭下堪求醉，只恐湘娥尚未醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮宿青冈馆闻雨时家眷后来杳无消息","author":"邓云霄","text":"愁云送腊楚天低，儿女关心路转迷。\n家信尚悬千里外，客程遥隔万山西。\n蘧庐托宿怜疲马，风雨残更听晓鸡。\n莫怪柔肠绕关塞，有人今夜倚楼啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"问春燕","author":"邓云霄","text":"软泥香处落花频，千里重来已暮春。\n昔日空梁还旧垒，今年清署是新人。\n飞飞尚忆堂前梦，袅袅如矜掌上身。\n莫学趋炎向华屋，忽看南舍又东邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湘上春","author":"邓云霄","text":"三月山城散锦霞，湘江嫩绿映银沙。\n少年争拥青丝骑，买笑谁过碧玉家？\n歌管隔林调好鸟，胭脂满路踏残花。\n执兰藉草芳尊尽，还道前村酒易赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芝城三日二首 其一","author":"邓云霄","text":"新莺百啭报新晴，队队游人出远坰。\n芳渚几湾成曲水，香风到处是兰亭。\n伤春坐叹三湘晚，怀古难招二女灵。\n最爱落花频点草，软铺裀褥待人醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"芝城三日二首 其二","author":"邓云霄","text":"红桥锦浪度香车，风细游丝自卷舒。\n蒲插水心如捧剑，柳摇波面似湔裾。\n春光对客空骀荡，往事随流付韨除。\n遥忆南天应更暖，田田荷叶绕吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得盈盈楼上女纤纤出素手和马荆阳督学刘望奎太守之作","author":"邓云霄","text":"柳拂轻丝草似裀，楼头思妇晓妆新。\n调弦未写三春恨，褰幌偏骄百媚身。\n玉笋小垂栏外手，秋波遥望意中人。\n紫骝年少空肠断，未许窥帘赋洛神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衙署赏莲","author":"邓云霄","text":"帘卷薰风散晓烟，云軿初下水中仙。\n风翻翠盖香微度，霞染红绡色欲然。\n未理兰舟浮远浦，且将箫管倩鸣蝉。\n今宵定作清凉梦，直到华山玉井边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祷雨有应喜赋","author":"邓云霄","text":"坛上风幡集百灵，层阴回合昼冥冥。\n虚传马鬣沾涓滴，忽讶龙湫涌渤溟。\n雨队弥天号野鹳，檐花入夜湿流萤。\n祈年不独三农喜，牧唱渔歌尽可听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"永郡西门外浮桥","author":"邓云霄","text":"联络方舟贴水平，斜连近郭达遥坰。\n红尘一道浮明镜，碧浪千层走建瓴。\n车马夜阑仙鹤返，玉箫声断老龙醒。\n盈盈河汉同空阔，疑有寒光应七星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孝定皇太后哀词","author":"邓云霄","text":"圣子宵祈太乙坛，上宾环佩已珊珊。\n鼎湖龙驭随先帝，瑶水仙娥引从官。\n一代母仪传史笔，九天慈诏下鸡竿。\n遗恩浩荡如春雨，多少疮痍洒泪看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":25265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]