[{"title":"龙江八景为康佥宪题 其一 南亩农耕","author":"张宁","text":"沃土饶生意，芳村托比邻。\n西城初卒岁，东作又乘春。\n食力真吾事，全生仰至仁。\n此乡深化育，应有带经人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7358,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙江八景为康佥宪题 其二 北山儒隐","author":"张宁","text":"盛世多才逸，山居近市喧。\n不矜高士节，聊托野人群。\n弦诵消寒暑，柴桑见子孙。\n如何冥寂士，薄暮起移文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7359,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙江八景为康佥宪题 其三 石桥秋月","author":"张宁","text":"白石卧沧波，冰轮度玉河。\n地高秋影重，天近夜凉多。\n清赏谁将共，幽怀奈尔何。\n会逢题柱客，同和谪仙歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7360,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙江八景为康佥宪题 其四 龙穴晓云","author":"张宁","text":"神物何年化，行云日霭然。\n灵氛迷石洞，翔影落沉渊。\n岂是无心出，何因有梦传。\n田家镇相望，霖雨自年年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7361,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙江八景为康佥宪题 其五 尖峰樵唱","author":"张宁","text":"云重碧山深，行歌度远林。\n回风传逸响，空谷振流音。\n劳苦还相和，招呼拟共寻。\n闻歌尽回首，谁会买臣心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7362,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙江八景为康佥宪题 其六 横浦渔舟","author":"张宁","text":"疏柳系扁舟，年年水上头。\n雨晴人共发，风急夜相留。\n酒伴多同醉，船居未解愁。\n此生聊复尔，何用著羊裘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7363,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙江八景为康佥宪题 其七 山寺晴岚","author":"张宁","text":"缥缈带春霏，山深野寺微。\n淡随香霭散，浓映雨花飞。\n困鹤惊茶灶，閒僧闭竹扉。\n明朝去游览，拟著薜萝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7364,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"龙江八景为康佥宪题 其八 独冈晚照","author":"张宁","text":"孤绝群山外，斜阳落未沈。\n馀光迷鸟阵，流彩入枫林。\n旷望愁将夕，昏黄思不禁。\n桑榆景犹好，谁肯惜分阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7365,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦刘公瑞","author":"张宁","text":"形影久云绝，连宵频梦君。\n布衣仍潦倒，病发乱缤纷。\n似别惊相见，将言悄不闻。\n平生最深契，梦断一销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7366,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈知县","author":"张宁","text":"共说难兄弟，才华信合并。\n龙光双剑白，鹤梦一毡青。\n擅学诸王字，能通大戴经。\n鸣琴花县日，春满卓公庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7367,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"旧朝靴","author":"张宁","text":"记得初成日，先朝禁直臣。\n动移当辇毂，步履上星辰。\n待漏清霜满，乘春玉镫新。\n旧缝时绽裂，犹有玉阶尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7368,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戊辰中秋日得舍弟归信已至江口","author":"张宁","text":"宦迹茫无际，归期定已闻。\n素怀同月满，积思共秋分。\n汉傅功名异，眉翁骨肉存。\n白头俱永感，临见却销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7369,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴孟章自乐山八景 其一 野仙居","author":"张宁","text":"自有丹丘地，疑逢萼绿华。\n绕门多槲叶，临水尽桃花。\n不类人间世，真成方外家。\n平生出尘想，蓬褐更清嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7370,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴孟章自乐山八景 其二 老农窝","author":"张宁","text":"莘野无馀业，成都有薄田。\n茅檐容犬宿，草具近牛眠。\n炊借邻家灶，烹分土窟泉。\n西成与东作，岁岁此盘旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7371,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴孟章自乐山八景 其三 留云亭","author":"张宁","text":"山近气常聚，林深风漫吹。\n非因朝作梦，因为雨催诗。\n窗幔垂还入，炉薰散不移。\n从龙今出岫，舒卷共相宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7372,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴孟章自乐山八景 其四 得月涧","author":"张宁","text":"一碧净无尘，清秋月满轮。\n天空光乱水，风荡影移人。\n举酒邀何及，登楼赏厌频。\n婵娟长在目，幽绝异通津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7373,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴孟章自乐山八景 其五 引泉渠","author":"张宁","text":"疏凿近山陂，开云导玉脂。\n岸回斜沁圃，石矗细通池。\n溪雨涨来急，野花流到迟。\n因之想清渭，欲访郑当时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7374,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴孟章自乐山八景 其六 青华洞","author":"张宁","text":"地远芳林匝，岩开侧径纡。\n云扉风钥静，罗幔月灯孤。\n偶此寻丘壑，凭谁入画图。\n曾逢异人说，深处似蓬壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7375,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴孟章自乐山八景 其七 紫烟台","author":"张宁","text":"突兀承苍汉，空蒙生紫烟。\n登临飞鸟上，望到夕阳边。\n气接云林洞，光涵月涧泉。\n香炉峰下景，同此类超然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7376,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴孟章自乐山八景 其八 蠹鱼轩","author":"张宁","text":"墨气浓侵辨，虫痕细绕边。\n自因当膝破，无复可人悬。\n竹污消遗简，芸香落断编。\n茶搜并日晒，莫笑腹便便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7377,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云峰东麓","author":"张宁","text":"生孩寻失父，成葬荷尧夫。\n天启三公地，人嗟五父衢。\n西原乔梓合，北陇凤鸾孤。\n想见焚黄日，还应哭幼雏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7378,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山溪晚兴","author":"张宁","text":"树色逢秋淡，山光薄暮佳。\n吟看风堕叶，坐觉水生花。\n野景周遭在，幽情一倍加。\n日斜人不见，惟有过林鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7379,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"翠岩","author":"张宁","text":"松柏连崖岫，轩窗匝薜萝。\n门临苍玉案，人在绿云窝。\n路入三茅洞，行经七叶坡。\n日斜天宇净，空碧罩青螺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7380,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"半閒","author":"张宁","text":"动里心常静，忙中乐自由。\n租庸长预了，子姓早分忧。\n事办多临弈，耕馀便出游。\n何如贾秋壑，名地总虚浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7381,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送侯方伯赴河南","author":"张宁","text":"圣主念生民，雄藩列重臣。\n金章辞玉阙，宝马曳朱轮。\n南粤仁恩在，中区事业新。\n会看嵩岳里，幽谷发阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7382,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赴汀","author":"张宁","text":"频年湖海上，妻子倦相随。\n道在贫非病，才疏远更宜。\n依违真自耻，得丧任时为。\n独有严亲在，临行泪雨滋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7383,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟过富阳","author":"张宁","text":"离家才十日，乡思渐多违。\n江近村居少，山高石路危。\n野人惊客至，水鸟傍船飞。\n何处桐庐县，苍茫对夕晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7384,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登龙游翠光岩","author":"张宁","text":"孤棹舣寒汀，无人独自登。\n积苔迷鸟篆，斜日照鱼罾。\n湍急声如振，崖高势欲崩。\n客游那可驻，云重树冥冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7385,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"严州道中","author":"张宁","text":"云路缘江转，舟行夕照中。\n水清深见石，山近欲挨蓬。\n意与寒林澹，情随野望通。\n閒呼小儿女，到处一从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7386,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云谷草堂","author":"张宁","text":"閒云深谷里，寂寂隐茆庐。\n昼榻疑朝暝，晴檐似雨馀。\n有溪通野艇，无路入安车。\n山犬俄然吠，人来问起居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7387,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宋宗鲁七咏 其一 河渠春涨","author":"张宁","text":"积雨夜初歇，河渠向晓深。\n岸平芳草没，风漾白鸥沈。\n浩荡怀殊泽，澄清共此心。\n龙门知远近，临眺一长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7388,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宋宗鲁七咏 其二 禾黍秋风","author":"张宁","text":"秋风村巷起，禾黍远依微。\n古道无人过，晴空有雁飞。\n已堪酬岁事，应欲问寒衣。\n但得丰年乐，莼鲈慢忆归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7389,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宋宗鲁七咏 其三 柳岸晴烟","author":"张宁","text":"杨柳绿成蹊，笼烟水面齐。\n啼莺深不见，骢马只闻嘶。\n初日光犹暝，回风影渐低。\n吟行易成趣，归路未应迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7390,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宋宗鲁七咏 其四 槐庭清昼","author":"张宁","text":"密树荫虚堂，高林昼日长。\n疏花閒自落，幽梦觉还忘。\n宦达怀先志，栖迟惜众芳。\n栽培各有待，非是学三王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7391,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宋宗鲁七咏 其五 蔬园剪雨","author":"张宁","text":"春山逢夜雨，剪韭入荒园。\n绿润茨菰饭，寒生苜蓿盘。\n时穷聊自给，身在任加餐。\n肉食知谁补，齑盐重尔存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7392,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宋宗鲁七咏 其六 蓬户书声","author":"张宁","text":"幽人读书处，茆屋住林坡。\n灯影留残月，书声隐薜萝。\n风尘谈铗语，烟雨饭牛歌。\n今日青云路，飞腾事若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7393,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宋宗鲁七咏 其七 兰山雪色","author":"张宁","text":"穷阴连朔漠，积雪满山城。\n不辨峰峦气，空闻涧壑声。\n净涵书幌白，寒觉布衣轻。\n怅望平林外，苍茫烟雾横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7394,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三鹭图","author":"张宁","text":"老树寒塘里，孤栖境最宜。\n双行良有待，独立已多时。\n跂足身将下，翘翎眼正窥。\n画图深意别，托物重兴思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7395,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冷斋为僧作","author":"张宁","text":"寂境世缘绝，虚堂人迹稀。\n厨空常遇食，岁尽或留衣。\n窗月澹如水，薜萝沿入扉。\n炎凉自有分，不是学寒微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7396,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登伍公庙东轩小酌","author":"张宁","text":"地迥廛居远，天空眼界明。\n雨来江变色，风急树添声。\n渺渺怀贤思，依依恋旧情。\n酒阑人尽去，犹自立檐楹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7397,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"醉渔","author":"张宁","text":"一棹清江曲，人称是醉渔。\n酣馀逃物色，醒独感糟餔。\n适意聊凭酒，生涯不为鱼。\n陶然云水窟，高枕即吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7398,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"湖山烟雨图","author":"张宁","text":"曾见隐人说，湖山雨亦奇。\n常因游荡冗，独觉静閒宜。\n惨淡玄晖画，苍茫子美诗。\n欲穷幽爽趣，坐待晚晴时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7399,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闰九月张用文宅赏菊","author":"张宁","text":"红芳骄白发，素质笑青娥。\n晚色浓还淡，秋香寒更多。\n赏心能几许，衰节欲如何。\n安得常逢闰，年年两度过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7400,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为王瑞之题梨花图","author":"张宁","text":"西阁睡初觉，东君信已通。\n莺声闭门雨，人影隔帘风。\n病体娇不语，诗愁閒更浓。\n无端肠欲断，云破月朦胧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7401,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹泉","author":"张宁","text":"绿竹荫方洲，泉深竹更幽。\n平安应永茂，沈静自长流。\n秀并孤山晚，清分合涧秋。\n凉风与华月，涵映共优游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7402,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阎文振马嵬八景 其一 杨妃荒冢","author":"张宁","text":"幸极多生变，恩深不到家。\n宁归掖庭狱，得祸后宫斜。\n鬼火消寒雨，魂香散落花。\n犹胜莫皋妇，青冢乱胡沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7403,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阎文振马嵬八景 其二 金城古寺","author":"张宁","text":"主家门第尽，僧寺树林荒。\n色相真成幻，豪华未可常。\n法轮回现灭，劫火变炎凉。\n却笑浮生众，犹因佛老忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7404,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阎文振马嵬八景 其三 北原春意","author":"张宁","text":"东风吹野草，春意忽依依。\n烧迹绿初满，樵痕青尚微。\n雨肥惊发遍，霜重较添稀。\n为尔增惆怅，飞香欲上衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7405,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为沈履德题水仙","author":"张宁","text":"夜玉笼金淡，春罗撷带柔。\n湘皋留佩别，洛浦弄珠游。\n地美姿容净，林孤气韵优。\n无因坐芳艳，聊尔伴吾幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7406,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄陈彦章","author":"张宁","text":"一从分别后，梦想镇悠悠。\n路远知难见，书来看转愁。\n归舟烟月冷，故宅菊花秋。\n物色将离思，年年江水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7407,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪泉","author":"张宁","text":"积素晚逾白，飞流寒更清。\n阳和通地泽，云液晃空明。\n不断平林色，遥闻落涧声。\n最堪清夜永，吟待月华生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7408,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"詹贰教望云思亲卷","author":"张宁","text":"闽海云飞处，严慈隔九泉。\n天涯孤影在，客里寸心悬。\n泪逐回风落，魂随去鸟旋。\n微官是何物，常自别遗阡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7409,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荆妇堕齿有感","author":"张宁","text":"视舌知柔在，论心觉汝良。\n动摇勤吐哺，疏豁厌糟糠。\n未老何嗟及，无儿重此伤。\n平生恩义在，诸妾共沾裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7410,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为严仁远题兰","author":"张宁","text":"共说江皋种，元来是国香。\n援琴人在鲁，糿佩客迷湘。\n古调终难继，高怀不可忘。\n谢庭春事好，三世见流芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7411,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"卧云","author":"张宁","text":"闻有西方士，幽居在白云。\n日高窗漏曙，风静榻馀薰。\n寝息收龙雨，冥栖伴鹤群。\n悠然半间屋，无地著尘氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7412,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"竹庄","author":"张宁","text":"西村耕隐处，菉竹似云屯。\n九曲不知径，千竿方到门。\n幽期分少室，美盛亚淇园。\n为问平安信，传芳见子孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7413,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪江为僧文秀题","author":"张宁","text":"澄静秋来水，苍茫腊后天。\n空花迷浦树，远色见林烟。\n冻绝横流潦，寒无泛浪船。\n夜深清不寐，月到寺门前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7414,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"瀛洲为锡山杨秀才作","author":"张宁","text":"曾到瀛洲路，清孤绝点埃。\n浪香鱼易化，月爽桂长开。\n壮志英雄步，弘文馆阁才。\n升腾各有地，何必扣蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7415,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"爱水","author":"张宁","text":"有美渊源士，名溶字净夫。\n平生慕清润，重尔乐涵濡。\n放浪怜三峡，深沉快五湖。\n由来称知者，情好一尘无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7416,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送吴览用之还休宁","author":"张宁","text":"尊酒分携后，星霜七载间。\n壮怜吾白首，少觉尔苍颜。\n杜曲花时醉，山阴雪夜还。\n来疏归转急，情绪各相关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7417,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅野","author":"张宁","text":"东阁寻诗远，西湖载酒频。\n惟应閒旷处，得老岁寒身。\n地广冰霜伴，天空水月邻。\n不须携杖探，满眼是阳春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7418,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为高宪副题画二首 其一","author":"张宁","text":"草尽白石露，林幽苍藓生。\n不移君子节，如有故人情。\n明月照秋影，凉风吹夜声。\n凤川千亩废，顿觉数竿清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7419,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为高宪副题画二首 其二","author":"张宁","text":"树色逢秋淡，山光薄暮佳。\n吟看风堕叶，坐觉水生花。\n野景周遭在，幽情一倍加。\n怀人不可见，惟有暮归鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7420,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夏大卿西湖六会卷后","author":"张宁","text":"步屧苏堤净，寻玄瑞石遥。\n蓬山小无暑，岩月满随潮。\n宝石登天近，瀛梅候雪消。\n太平游览遍，歌咏记清朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7421,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪屏","author":"张宁","text":"辟凿玄工旧，彰施素质齐。\n天寒云母淡，风静玉花低。\n银烛秋光尽，金闺雀影迷。\n筠床吟对晚，欲与鹤同栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7422,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"芝田为嘉禾医士谈景阳题","author":"张宁","text":"曾到悬壶处，琼芝遍玉田。\n居安灵气聚，济博寿徵全。\n培藉松苓土，滋分石乳泉。\n不耕尝自足，医道本通仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7423,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"桂岩","author":"张宁","text":"峻绝春芳少，高寒晚植荣。\n人如月中下，地胜却林清。\n书榻飘香落，琴坛倒影横。\n岩头有云路，留待看花行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7424,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"知休堂","author":"张宁","text":"世路终无尽，浮生总未然。\n蚤停登峻马，急系下滩船。\n富贵閒方了，功名退始全。\n中山千日酒，不及醒时眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7425,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重过月塘留题","author":"张宁","text":"幽居邻古寺，清兴每堪乘。\n卧榻闻经梵，书窗映佛灯。\n地偏稀有客，门静似无僧。\n十载重相过，空缘却未凭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7426,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乌程贰教李春夫四首 其一 桥门奉侍","author":"张宁","text":"禄养知何日，依亲未可期。\n聊凭菽水奉，得便寝兴时。\n风木丘吾感，公庖考叔遗。\n三年不归者，此意竟何思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":7427,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]