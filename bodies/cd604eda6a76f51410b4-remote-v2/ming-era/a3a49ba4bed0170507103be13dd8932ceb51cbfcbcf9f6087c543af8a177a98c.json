[{"title":"清明","author":"瞿佑","text":"兼旬蹭蹬在京华，又见东风御柳斜。\n客里不甘佳节过，借人亭馆看梨花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13238,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过苏州二首 其一","author":"瞿佑","text":"白莲桥下暂停舟，垂柳阴阴拂水流。\n舞榭歌楼俱寂寞，满天梅雨过苏州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13239,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过苏州二首 其二","author":"瞿佑","text":"桂老花残岁月催，秋香无复旧亭台。\n伤心乌鹊桥头水，犹望阊门北岸来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13240,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秦女吹箫","author":"瞿佑","text":"玉琯双吹引凤凰，曲中同赴白云乡。\n如何后日秦台梦，不见萧郎见沈郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13241,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"王母仙桃","author":"瞿佑","text":"周王汉帝总成空，未及桃花一度红。\n殿上小儿差耐久，等闲三入果园中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13242,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阿娇金屋","author":"瞿佑","text":"咫尺长门有别离，君心宁记主家时。\n黄金作屋成何事，只办相如买赋资。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13243,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"武灵后","author":"瞿佑","text":"浴苑中间杨白华，随风飘泊向天涯。\n悲歌未断肠先断，日落长秋起暮鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13244,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乐昌分镜","author":"瞿佑","text":"送旧迎新可自由，笑啼不敢强包羞。\n熟能耐久如江令，垂老还家尚黑头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13245,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朝云诵偈","author":"瞿佑","text":"春树红颜一掷梭，六如偈里暗消磨。\n主翁不悟荣华过，一笑重烦春梦婆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13246,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"盼盼","author":"瞿佑","text":"亚父冢前秋草合，虞姬坟上暮云愁。\n如何一片彭城月，只照张家燕子楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13247,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"师师檀板","author":"瞿佑","text":"千金一曲擅歌场，曾把新腔动帝王。\n老大可怜人事改，缕衣檀板过湖湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13248,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春莺啭曲","author":"瞿佑","text":"停骖惆怅惜芳时，岭海归来两鬓丝。\n纵使莺声如旧好，绿杨都是折残枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13249,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西湖竹枝词","author":"瞿佑","text":"西子湖边杨柳枝，千条万缕尽垂丝。\n东风日暮花如雪，飞入雕墙两不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13250,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"看灯词二首 其一","author":"瞿佑","text":"傀儡妆成出教坊，彩旗前引两三行。\n郭郎鲍老休相笑，毕竟何人舞袖长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13251,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"看灯词二首 其二","author":"瞿佑","text":"风帘珠翠动纷纷，笑语声喧隔户闻。\n明月满街天似水，不知何处著行云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13252,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春暮","author":"桂衡","text":"忍将愁眼看韶华，桃李无言日月斜。\n晚白菜肥蚕出火，冬青花落燕成家。\n归田谁复如宾馌，入室今惟对影嗟。\n无可奈何聊且睡，不劳春梦绕天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13253,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读瞿存斋剪灯新话作歌","author":"桂衡","text":"山阳才人畴与侣，开口为今阖为古。\n春以桃花染性情，秋将桂子熏言语。\n感离抚遇心怦怦，道是无凭还有凭。\n沉沉帐里昼吹笛，煦煦窗前宵剪灯。\n倏而晴兮倏而雨，悲欲啼兮喜欲舞。\n玉箫倚月吹凤凰，金栅和烟锁鹦鹉。\n造化有迹尸者谁，一念才萌方寸移。\n善善恶恶苟无失，怪怪奇奇将有之。\n丈夫未达虎为狗，濯足沧浪泥数斗。\n气寒骨耸铮有声，脱帻目光如电走。\n道人青蛇天动摇，不斩寻常花月妖。\n茫茫尘海沤万点，落落云松酒半瓢。\n世间万事幻泡尔，往往有情能不死。\n十二巫山谁道深，云母屏风薄如纸。\n莺莺宅前芳草凄，燕燕楼中明月低。\n从来松柏有孤操，不独鸳鸯能并栖。\n久在钱塘江上住，厌见潮来又潮去。\n燕子衔春几度回？\n断梦残红落何处？\n还君此编长啸歌，便当酌以金叵罗。\n醉来呼枕睡一觉，高车驷马游南柯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13254,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日湖中","author":"张舆","text":"风波千顷画船开，吹近芙蓉影里来。\n倒卷彩霞翻舞袖，斜飞白雨溢行杯。\n总宜园冷花无主，苏小坟空草作堆。\n为倩金戈挥落日，秋声莫向树头催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13255,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖上分韵得香字","author":"张舆","text":"晴麓云横万里长，出门步步是春光。\n近湖酒阁多红杏，隔岸渔家尽绿杨。\n箫鼓声寒心自醉，绮罗魂冷骨犹香。\n漫游不是矜年少，嬴得闲情似洛阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13256,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"约可闲老人访王药圃","author":"张舆","text":"明朝寒食风日晴，可闲欲同湖上行。\n先拾玉壶园上翠，却听瑶石山头莺。\n茶铛烦为试新火，杏酪不须和冷饧。\n君若肯将花径扫，日高相与到柴扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13257,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵王志道元夕","author":"张辂","text":"沈水香生宝篆烟，九衢车马正喧阗。\n金莲遍烛三千界，银筝谁弹五十弦。\n天上楼台春靡靡，人间风月夜娟娟。\n少年行乐情怀异，绛蜡笼纱六辔联。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13258,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠陈士宁","author":"张辂","text":"横溪别业锦云乡，红白莲花薜荔墙。\n百事不开心独静，孤云无着兴俱长。\n佳人雪藕供微醉，童子分茶坐晚凉。\n如此好怀谁解写，诗成还让孟襄阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13259,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"病起留别保安诸文士　见西湖志","author":"邓林","text":"两鬓西风吹断蓬，杖藜扶病着秋容。\n菊花浑似诗人瘦，山色不如归兴浓。\n紫塞一杯桑落酒，彤廷五夜未央钟。\n燕鸿岐路东西去，此后相思意万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13260,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春夕旅怀","author":"邓林","text":"万里东风故国情，十年几度凤凰城。\n衡阳雁尽春三月，巫峡猿啼夜二更。\n席上狂言因酒得，镜中华发为愁生。\n静观富贵如云转，拂袖归来任俗争。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13261,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过吴门次萨天锡韵","author":"李昌祺","text":"七泽三江通甫里，杨柳芙蓉照湖水。\n阊门过去是盘门，半掩珠帘画楼里。\n靡芜生遍鸳鸯沙，东风落尽棠梨花。\n馆娃香径走麋鹿，清夜鬼灯明绛纱。\n三高祠下东流续，真娘墓上风吹竹。\n西施去后屧廊倾，岁岁春深烧痕绿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13262,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈郎中重使西域十首 其七","author":"李昌祺","text":"宝带悬鱼服，雕弧挂马鞯。\n皇恩覃万国，虏气静三边。\n瀚海寒生月，崖城暮锁烟。\n欲穷西域事，班范有遗编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13263,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次蒲庵长老韵二首 其二","author":"乌斯道","text":"矫首令人感慨深，浮云蔽日阁曾阴。\n六时花散金银刹，千里尘飞剑戟林。\n经罢看山长独坐，定回倚石自微吟。\n绝怜松下清泠水，好与人间洗渴心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13264,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈郎中重使西域十首 其九","author":"李昌祺","text":"出塞春乘传，投鞭晚下营。\n旋风胡马疾，掣电皂雕轻。\n浩荡穷源志，迢遥奉使程。\n支机如得石，持往问君平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13265,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈郎中重使西域十首 其十","author":"李昌祺","text":"行尽伊吾道，胡天气候殊。\n神僧留白骨，毒草隐玄蛛。\n近水多行帐，穷荒绝远书。\n伫看归觐日，玉勒控宛驹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13266,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿端壁寺","author":"李昌祺","text":"遗构象王宫，荒凉小邑东。\n一灯秋殿闭，孤榻夜窗空。\n饥啮床头鼠，愁吟砌下蛩。\n萧萧黄叶坠，庭树颤西风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13267,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"彭泽县石崖僧房","author":"李昌祺","text":"窗户俯澄潭，龙宫似可探。\n藤萝栖鹘树，瓶锡定僧岩。\n斜日疏疏磬，长风去去帆。\n只应输野衲，长此卧烟岚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13268,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早发小孤山遇风","author":"李昌祺","text":"湖尽江逾阔，舟行路若迷。\n垂杨春寂寂，芳草雨凄凄。\n漩水鼋鼍窟，平沙雁鹜堤。\n风波随地有，何处可幽栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13269,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次襄城","author":"李昌祺","text":"晨铎语西风，衣单怯露浓。\n豆苗遮地黑，柿实照园红。\n晓色苍茫里，秋光惨淡中。\n永怀东汉士，风裁李膺雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13270,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人南归四首 其一","author":"李昌祺","text":"离弦兼楚调，忍向醉时闻。\n连岁长为客，他乡更别君。\n鸥波明夕照，雁字写秋云。\n迢递还乡梦，相随过海门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13271,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送人南归四首 其四","author":"李昌祺","text":"年年长在客，北蓟复南京。\n秋雨沧洲雁，春风采石莺。\n好山环故里，流水背孤城。\n去住无拘系，閒身到处轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13272,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"喜张进士叔豫见宿旅舍","author":"李昌祺","text":"穷巷寂无邻，青灯共故人。\n远声霜下磬，孤影客边身。\n露冷蛩相吊，庭寒月自亲。\n殷勤一瓢酒，更与话酸辛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13273,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"周原幽居","author":"李昌祺","text":"山色蛾眉秀，江流燕尾分。\n乱蝉吟落日，独鹤引归云。\n黄叶溪边树，青帘雨外村。\n兴来留客坐，随意倒芳樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13274,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈生归吉水赤岸二首 其一","author":"李昌祺","text":"清砧兼落叶，总是别离情。\n去路千程远，归舟一叶轻。\n秋云连树暗，寒日映川明。\n亦有沧浪兴，何时共濯缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13275,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送周秀才游长沙","author":"李昌祺","text":"迢递长沙道，萧条晏岁游。\n乱山黄叶寺，孤棹白蘋洲。\n夕鸟冲船过，寒波背郭流。\n毋论卑湿地，贾傅昔曾留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13276,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送戴教授北行","author":"李昌祺","text":"别路三春雨，行舟五两风。\n花香随路减，柳色上衣浓。\n共是青云客，先成白发翁。\n离情如逝水，万折亦朝东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13277,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿废普济寺","author":"李昌祺","text":"青山行欲尽，深树见僧房。\n云气千峰暝，秋声一院凉。\n长藤悬破衲，脱叶覆空廊。\n龙象黄金地，萧萧蔓草长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13278,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拟唐塞下曲九首 其三","author":"李昌祺","text":"铁骑蹴交河，衔枚半夜过。\n雪花凝锁甲，月色冷雕戈。\n黠虏俱亡命，连营尽凯歌。\n至今青冢骨，犹恨与通和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13279,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三月四日即景","author":"李昌祺","text":"忽忽春将暮，俄过三月三。\n草谁怜益母，花自媚宜男。\n乍到寻巢燕，初眠上箔蚕。\n新茶与新笋，乡味忆江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13280,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赋落花","author":"李昌祺","text":"愁红怨粉各依依，树下偏多树上稀。\n总为春光争艳冶，却教夜雨妒芳菲。\n数枝浸水鱼吹去，几片萦林蝶趁飞。\n莫怪东风成薄倖，犹能收拾点人衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13281,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬曾学士子棨见赠复职之作","author":"李昌祺","text":"放逐仍居患难中，三年执役梵王宫。\n病来短发逢秋白，老去衰颜借酒红。\n心似葵花倾晓日，身同树叶感霜风。\n杜陵花竹频生梦，但觉阳春处处融。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13282,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"张舒州家观元承旨危素画像","author":"李昌祺","text":"虞揭凋零玉署空，堂堂至正独推公。\n气全河岳英灵秀，手抉云霞制作工。\n江总归陈翻恨老，贾生鸣汉早称雄。\n丹青似有无穷意，却写南冠入画中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13283,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柳","author":"李昌祺","text":"含烟袅雾自青青，爱近官桥与驿亭。\n春满章台偏婀娜，秋深隋岸最凋零。\n长从苏小门前折，几向龟年笛里听。\n绝胜东风桃李树，飞花犹解化浮萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13284,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"驾幸朝天宫祭星之作","author":"李昌祺","text":"上帝萧台卫百灵，储皇拂曙醮群星。\n清都秘箓开云篆，白昼神雷掷火铃。\n晓露未乾珠树湿，天风微动宝花零。\n叨恩久在南宫里，长从銮舆幸冶亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13285,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孝陵秋日陪祀柬彭赞礼永年","author":"李昌祺","text":"钟山欲晓色苍苍，小辇轻舆出建章。\n苑鹿不惊仙仗过，潭龙故喷御泉香。\n重城隐雾留残月，高树含风送早凉。\n惟有祠官最清贵，时来导驾沐恩光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13286,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送熊生还乡","author":"李昌祺","text":"石头城下柳萧疏，久客怀归念远途。\n乡梦每生钟断后，客愁政在酒醒初。\n扁舟暮雨青衫薄，折苇凉风白鸟孤。\n拟共丘园寻别业，临岐相送独踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13287,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚春郊外七首 其二","author":"李昌祺","text":"柳外轻风拂面来，春忙半是杜鹃催。\n多般野菜参差老，几样林花接续开。\n竹为近阶难迸笋，松因临水易生苔。\n追思往日嬉游伴，聚散如云倍可哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13288,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚春郊外七首 其六","author":"李昌祺","text":"雨外林鸠不住啼，落红狼籍半沾泥。\n秧苗带谷根犹浅，麦干垂花穗已齐。\n鸥下只投荷叶屿，蝶飞多傍菜花畦。\n青山绿水饶诗景，归路扶筇醉懒题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13289,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨柳枝 其二","author":"李昌祺","text":"参差几树瞰长河，树树垂金拂绿波。\n不是秋来易零落，自缘人世别离多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13290,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨柳枝 其三","author":"李昌祺","text":"细叶如眉绿未匀，修眉浑似带愁颦。\n输他桃杏东风里，不管南游北去人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13291,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"客夜闻砧","author":"李昌祺","text":"荒草萧萧郭隗台，清砧明月两堪哀。\n千愁百感多如雨，今夜灯前一并来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13292,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"房山旅舍","author":"李昌祺","text":"枕寒衾冷对孤灯，室似邮亭榻似僧。\n清泪几行揩又落，斜风细雨送残更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13293,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重游龙济寺悼无为能上人","author":"李昌祺","text":"北涉南游二十霜，幻身重到赞公房。\n苔侵素壁松枝偃，独自焚香拜影堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13294,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新安谣三首 其一","author":"李昌祺","text":"新安野老发垂肩，说著先朝泪泫然。\n洪武初年真少事，几曾轻到县衙前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13295,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新安谣三首 其二","author":"李昌祺","text":"垂老频逢岁薄收，秋租多欠卖耕牛。\n县官不暇怜饥馁，唤拽官车上陕州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13296,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新安谣三首 其三","author":"李昌祺","text":"当夫当匠子孙亡，田地荒芜户有粮。\n昨日迤西蕃使过，尽驱妇女赶牛羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13297,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山路谑花","author":"李昌祺","text":"枝头地上总猩红，几树繁开几树空。\n颜色一般荣悴异，谁将此意问东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13298,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中见牡丹","author":"李昌祺","text":"不嫌恶雨并乖风，且共山花作伴红。\n纵在五侯池馆里，可能春去不成空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13299,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重唁山中牡丹","author":"李昌祺","text":"不烦浇灌不烦栽，长过清明谷雨开。\n为问洛阳豪贵客，几家还有旧亭台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13300,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宜阳山中","author":"李昌祺","text":"绿阴重叠鸟间关，野枣花香宿雨残。\n天遣浮云都捲尽，教人一路看青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13301,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"嵩县过端午","author":"李昌祺","text":"老大偏多故里心，一逢佳节一沾襟。\n谁知此日菖蒲酒，又在山城独自斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13302,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"栀子画眉图二首 其一","author":"李昌祺","text":"薝卜初开雪亚枝，枝头好鸟立成痴。\n少年京兆风流处，似汝花间对语时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13303,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"栀子画眉图二首 其二","author":"李昌祺","text":"昔年曾伴董娇娆，长把春山笑倩描。\n今日梁园空见画，鸟啼花落鬓萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13304,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乡人至夜话","author":"李昌祺","text":"形容不识识乡音，挑尽寒灯到夜深。\n故旧凭君休更说，老怀容易便沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13305,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋雨夜闻乡中近事殊可感","author":"李昌祺","text":"得失无心总不惊，秋来偏动故乡情。\n寻常窗外梧桐雨，不似今宵不耐听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":13306,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]