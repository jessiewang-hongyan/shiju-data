[{"title":"禁中斋夜","author":"陆深","text":"寂寂斋心夜气浓，玉河西下凤楼东。\n忽惊凡骨留天上，赖有仙僚共雪中。\n莲漏暗通风力劲，琐窗斜映月痕空。\n大烹本为牛羊荐，鼎鼐调和愧未工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"腊日严寒新制狐裘服之","author":"陆深","text":"六十一回经岁寒，狐裘初试向长安。\n南人不识千金价，北地尤珍一腋看。\n白盗己非前辙远，紫貂虽好策勋难。\n衰慵尚恋君恩重，办得朝趋候夜阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁丑除夕","author":"陆深","text":"门掩虚堂画烛辉，隔宵先自理朝衣。\n冰霜远道临青鬓，星斗中天护紫微。\n岂有涓埃报知己，且将身世付忘机。\n物情自与流年换，今昨无劳论是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别李时元下第","author":"陆深","text":"吴山苍苍共灯火，潞河悠悠即去途。\n乍可后期还磊落，莫因远适悲江湖。\n晴风浪摇四月麦，宿雨帆轻十幅蒲。\n南国诗成须早寄，风尘清梦客楼孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和易钦之游广恩寺","author":"陆深","text":"春日忻逢水西寺，入门无数香烟凝。\n乡园千里远作客，尘土十年终愧僧。\n风光每向閒边见，山色试凭高处登。\n未问西来柏子树，可怜清沼玉壶冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"视牲 其一 厢斋居","author":"陆深","text":"向晚郊坛第几巡，愿储精意奉明禋。\n去来路熟浑忘远，西北山多欲碍春。\n终见牛羊歌帝右，未因鼷鼠变斋晨。\n东风又遍天街草，御辇须怜碧玉茵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"视牲 其二","author":"陆深","text":"槐影参差月满空，桥门云馆锁重重。\n斋心自觉春宵永，瘦骨偏承夜气浓。\n北斗旌旗惊闪烁，南郊圭璧奠从容。\n相如最有凌云笔，恨杀文章草汉封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆良弼调楚雄","author":"陆深","text":"长沙才调贾生同，古郡滇省楚更雄。\n万里驿程山共水，五更心事雨兼风。\n极知骏骨台堪筑，未为齐门瑟转工。\n交契十年情不尽，长安几度别离中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"分题灯下细书寿副宪卢师召乃翁","author":"陆深","text":"青藜火底坐挥毫，犹有蝇头满薛涛。\n似与黄庭传妙诀，还将白练写风骚。\n怀人诗就石湖晓，寄子书成剑阁高。\n见说方瞳今己碧，更从天际送鸿毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清明日半轩前丁香盛开偶题","author":"陆深","text":"小院回廊曲曲深，为谁频结雨中心。\n东风吹到第几信，节序俄惊百五临。\n簇簇紫茸如可咽，萧萧华发岂胜簪。\n故园买去开还早，相伴溪梅水竹林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归途再同林介立经行莲塘","author":"陆深","text":"杨柳芙蕖一径长，未秋先己动新凉。\n尘心到此消应尽，暇日来多尽不妨。\n空翠拂衣山有气，柔芳过雨水俱香。\n千寻万雉金汤地，信有人开吏隐堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林以吉提学","author":"陆深","text":"泥封芝检下青冥，帝辅皇畿重典刑。\n秋满大江双画楫，风随骢马几长亭。\n满蹊桃李含时雨，到处篇章发地灵。\n更向斗南占气象，云开五色见文星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"食菱","author":"陆深","text":"一曲菱歌江上秋，画船归近望江楼。\n北来物色浑如玉，南望乡关第几州。\n风味疑从仙掌堕，水芳曾傍锦云浮。\n岁寒独枉佳人惠，消得相如一片愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"食酥叠前韵","author":"陆深","text":"琼花凝露拂高秋，玳瑁筵前十二楼。\n软滑不须论北塞，温柔元自出南州。\n夜寒锦帐笙歌细，春煖金尊琥珀浮。\n惭愧清寒玉堂客，得闻风味破新愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢顾未斋惠连实叠前韵","author":"陆深","text":"长卿病肺几经秋，药饵频须正倚楼。\n忽枉新篇题玉井，浑如高谊借荆州。\n细倾圆实珠玑乱，尚带清香玉露浮。\n见说功多心独苦，采莲歌罢使人愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叠韵荅柴德美黄门","author":"陆深","text":"藻思芙蓉露下秋，远过王粲赋登楼。\n时焚左掖三千疏，曾定山东一百州。\n独客琴书残腊尽，中天台殿瑞烟浮。\n夕阳无限凭高兴，兴汝同怀北顾愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和俞国昌食鲈再叠秋字","author":"陆深","text":"鲈鱼谁送海门秋，远客思归正倚楼。\n张翰因风辞洛下，东坡乘月向黄州。\n鲙成飞雪银丝细，目断烟波钓艇浮。\n剩有诗筒报知己，且凭斗酒慰羁愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"戊戌元旦早朝","author":"陆深","text":"晓日曈昽映彩霞，先春欲绽上林花。\n侯藩接履朝元旦，圣主垂衣御正衙。\n枫陛天高严虎豹，绣旗寒袭偃龙蛇。\n九重礼乐登三代，四海车书正一家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早朝","author":"陆深","text":"宫井疏钟曙色催，五云百和绕蓬莱。\n优游万国龙颜动，森列千官雉扇开。\n宝鼎赤墀笼晓日，玉音丹陛隐春雷。\n城鸦高拂扶桑景，白玉桥头侍从回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初试羊㲨予有一端藏笥中者十年兹教内馆始制为衣以禦北风感而有作","author":"陆深","text":"萧飒头颅感是非，半生何敢爱轻肥。\n相将岁晚看新制，指点年华亦故衣。\n北郭严凝随瘦马，西州辛苦到残机。\n病来却恐浑憔悴，且试休文旧带围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和宫端后渠玉亭赏莲之作","author":"陆深","text":"玉亭清切五云边，盆沼谁移玉井莲。\n来赏正逢初过雨，倚看须著半含烟。\n何妨绝代称君子，准拟前身是水仙。\n四十年来同榜客，一尊相属醉花前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"叠韵荅严介溪赏莲","author":"陆深","text":"红衣翠盖玉阑边，一曲新凉闻采莲。\n芳润似擎金掌露，清芬疑惹御炉烟。\n主人元是瀛洲客，胜赏真成陆地仙。\n别后难忘定何处，一楼风雨五更前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭谒显陵二首 其一","author":"陆深","text":"曈昽曙色映祥云，台殿岩峦锦绣纹。\n春气正浓连王气，人文逾朗应乾文。\n水知宗海千川合，脉是真龙五岳分。\n愿献周原瓜瓞颂，万年长拥圣明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"恭谒显陵二首 其二","author":"陆深","text":"龙蟠凤翥有馀奇，圣教皇情无尽时。\n华表欲栖千载鹤，灵风常满万年枝。\n桥山弓剑瞻云閟，寝殿衣冠展月仪。\n地接三都元咫尺，天开一统正雍熙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋月下怀高进之","author":"陆深","text":"浦溆虚堂欲暮秋，故人青眼夜深留。\n微风明灭渔舟火，四壁凄清戌角楼。\n身世浑疑非幻境，心期千载有神游。\n庭前忽报中秋月，踏碎花阴未肯休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送方矫亭赴南祠部","author":"陆深","text":"词人南国古来多，乂渡秋江渺渺波。\n两地客怀俱复尔，十年心契奈愁何。\n鸟啼画省常封印，帘捲钟山且对歌。\n后夜黄金台上路，雁书频望下星河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昨弘治辛酉南畿秋试获识吴江钱廷辅廷佐兄弟若联珠骈璧文采映射心窃赏之既别去无从晤言时时往来于怀今嘉靖丁亥夏廷佐以扁舟访予江村始知廷辅方应郡贡去而廷佐先领正德己卯乡荐矣转盻三朝垂三十载而予亦老矣为之感叹次韵奉荅","author":"陆深","text":"秋风一曲伯牙琴，曾和鸣皋鹤在阴。\n别后相思多梦寐，重逢今日是山林。\n大鹏万里须抟海，骏马高台为筑金。\n见说松陵富酬唱，直从皮陆到如今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游储芋西园池乘月夜汎","author":"陆深","text":"峰峦岩壑俯中流，何处三山与十洲。\n新雨不妨泥滑滑，好风先送水悠悠。\n鸥无机事迎人下，客有高怀尽日留。\n向晚星河迷上下，笙歌灯火木兰舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"县衙随班","author":"陆深","text":"幄殿高悬绛节朝，龙纹浮动瑞烟飘。\n地当东海开黄道，仗倚中天切紫霄。\n花县千城临禹贡，华封万口祝唐尧。\n年时正忆胪传里，玉笋金铺具百僚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁暮风雨中发藏书示楫子","author":"陆深","text":"岁寒风雨合江楼，灯火楼头数夕留。\n新命误蒙吾己老，旧书多在子须收。\n星辰万里趣关塞，环佩三朝侍冕旒。\n抱得寸心终许国，未应猿鹤怨林邱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三日雨后登俨然亭","author":"陆深","text":"萧萧竹树夹溪深，一雨初晴长绿阴。\n真意倘违空老大，野芳虽少亦山林。\n好风似旧穿高榻，流水如知绕素琴。\n东去大江知到海，为谁烟浪送归心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄黄希武提学","author":"陆深","text":"忆昔长安夹道居，玉堂黄阁晚来初。\n槐阴满院或共赋，藜火隔窗时校书。\n岁月悠悠成浪迹，烟波渺渺正愁予。\n闻君咫尺骑骢马，病卧扁舟限所如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日楼居","author":"陆深","text":"小楼长日转朱炎，妆裹残书手自签。\n性癖真成文字蠹，官清拟办水晶盐。\n白云出岫来当户，绿树摇风送入帘。\n却喜到门尘事少，始知吏隐信能兼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"火花次杨东滨韵","author":"陆深","text":"巧凭铢两结根芽，暗里机关顷刻花。\n风火阵中疑带雨，楼台影里半为霞。\n催开始信由人力，摇落宁须待岁华。\n文菊瓶梨俱烂熳，好开怀处是还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南溪","author":"陆深","text":"四面溪山如画里，扁舟南下更悠哉。\n薰风五月常先到，梅花一枝偏早开。\n茅作小斋俱背水，月临午夜独登台。\n朝宗万派俱通海，遥向鄱阳一脉来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日山居客至以大风不遂登高因次李空同集韵","author":"陆深","text":"泽国风涛郁未开，长缘病骨懒登台。\n无期远客还能至，有几重阳得再来。\n黄菊自应篱下看，清霜如为镜中催。\n当年空负凌云气，独把茱萸首重回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日斋居对雪","author":"陆深","text":"尽日风云扫不开，雪花如剪下高台。\n几家菜麦春犹浅，何处渔樵晚正来。\n去路欲迷南过雁，馀寒尚阻北枝梅。\n病来辞赋浑忘却，惭愧梁园授简才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中檐外石榴花盛开","author":"陆深","text":"病卧高楼伤客心，隔帘花发昼阴阴。\n朱房宿露辉朝日，碧叶穿云映远岑。\n大椀移栽今满地，茂陵回首欲沾襟。\n一枝为插如年少，愁鬓天涯不上簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中宴庄氏东园留题山亭","author":"陆深","text":"洞中山石俯波光，窗外林花荐野芳。\n况有管弦相映发，尽教风雨佐清狂。\n虚疑四老烟霞地，正是三江云水乡。\n我欲卜邻酬望想，自应团社寄篇章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二日过唐桥庄","author":"陆深","text":"画船如鹢水云遥，閒过南溪五里桥。\n行人渡口出复没，急鸟沙头鸣更摇。\n相携看菊留茅舍，独往寻源随海潮。\n无限高情付江路，林梢落日见渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀","author":"陆深","text":"斜风细雨满蕉窗，芦花蘋花绕大江。\n潮上水痕鱼六六，秋随天远雁双双。\n破除俗累还高卧，韬卷谈锋愿竖降。\n物色若教供指点，青山合比鹿门庞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲申元旦待漏入县斋随班","author":"陆深","text":"楼阁参差一水西，揽衣犹自候朝鸡。\n葭灰巳应三阳转，帝座遥瞻北斗低。\n步入花封和雪动，声传嵩祝倚云齐。\n太平有象君王圣，天保诗篇手自题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春晴登楼","author":"陆深","text":"新晴楼馆拂云开，万瓦含风接上台。\n短晷渐随阳漏长，长江元傍海开来。\n云山叠叠春千里，世事悠悠日几回。\n倚遍阑干思无限，黄金谁筑最高台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凤冈书屋为宁波朱允升赋","author":"陆深","text":"凤凰冈下结幽居，能读先人万卷书。\n手种碧梧深雨露，谁题凡鸟到门闾。\n楚狂空有歌相和，阿阁曾传事巳虚。\n见说上林工奏赋，白头未必老相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六日始晴","author":"陆深","text":"春日常阴到人日，今年人日隔宵晴。\n雍熙有象回天地，鼓吹无能荅圣明。\n江上旧便高枕卧，花间新办小车行。\n东风又动吴波绿，流过閒居独有情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有拳石类灵壁嵌谾可爱作盆池贮之庭中","author":"陆深","text":"湖上青山得共分，映空摇漾绿生文。\n下蟠或有蛟龙窟，高踞疑空虎豹群。\n雨后爱看封碧藓，月明如见吐游云。\n九华雪浪留题品，愿附苍蝇次第闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何雁峰郡伯入觐","author":"陆深","text":"六龙天上中兴年，五马云间早著鞭。\n台阁九霄图画里，衣冠万国冕旒前。\n淮南卧治须台鼎，宣室论才促御筵。\n试向王正占纬候，风云日月满尧天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登南广福钟楼","author":"陆深","text":"百尺阑干围暮钟，江流曲曲卧真龙。\n望穷南亩栖禾黍，天放西风吹菊松。\n落日楼台俱渺渺，浮云舟楫自重重。\n凌空为尽悲秋兴，一上高楼兴转浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晦日出城送葬曹启东宪副","author":"陆深","text":"入云城堞俯危阑，石磴沙堤路几盘。\n满目山光无近远，一番人事有悲欢。\n聊生政可三杯酒，进步何须百尺竿。\n细柳幽花倍惆怅，东风漠漠酿春寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日无聊偶然作","author":"陆深","text":"问余何事每悽然，尺璧光阴阅岁年。\n旧读书今存蠹穴，新缝貂巳剩鹑悬。\n常馀孤枕还乡梦，频乞东家买药钱。\n自信英雄须到骨，业身随处了尘缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别尤宗阳还吴门","author":"陆深","text":"临岐莫怪恨喑喑，投赠天涯纸半函。\n泽国乡音三泖北，江湖夜雨一灯南。\n浮踪去住僧留偈，世味寒温佛饱参。\n归去若逢人问讯，文章何用学春蚕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀都下友人","author":"陆深","text":"梅蒸悬榻昼慵开，徙倚阶除破碧苔。\n短梦空随蝴蝶化，尺书频问鲤鱼来。\n迷人芳草偏留雨，极目浮云忽送雷。\n千里相思多少恨，驱除无计且衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乔白岩太宰家山留题在迩亭","author":"陆深","text":"晋阳文物上卿家，小作江山殿岁华。\n望到白岩明玉雪，由来绿野锁烟霞。\n云窗覆奕传仙谱，石室藏书带相麻。\n同是登临还在迩，远寻何用访丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"廿四日晓发平乐白岩追送山行数十里中途微雨有赠","author":"陆深","text":"山中秋色半阴晴，上相肩舆许并行。\n别有岁年悲短发，老无文墨愧诸生。\n细谈旧事兼新事，遥听松声共水声。\n珍重桑榆最名胜，龙光咫尺是神京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书院池亭忽有玄鹤下集因养于庭","author":"陆深","text":"横空一鹤下危阑，隐隐丹砂变羽翰。\n疑是归鸿须系帛，莫将野鸟误称鸾。\n青田到后云天远，北海从来岁月宽。\n饮啄渐驯宜试舞，客衣偏感化长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东阿道中对雪","author":"陆深","text":"天为山行借雪看，路随天远更漫漫。\n诗成驴背偏如意，病后狐裘少耐寒。\n授简有才怀帝子，折梅无使寄长安。\n惟馀一片郊原兴，白马翩翩兔窟乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈中川秋燕东关寺","author":"陆深","text":"太原城畔东关寺，合让元龙独倚楼。\n回首风烟成隔岁，当时游赏正高秋。\n黄花破帽寒犹恋，紫塞浮云晚更稠。\n今夜灯前闻古调，三巴最苦若为酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发平潭","author":"陆深","text":"流年如水客程遥，又是王正第二朝。\n关塞极天三晋国，风烟入望五云霄。\n名山有副藏迁史，击壤无功颂帝尧。\n千里不妨随騕袅，一枝终自负鹪鹩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送胡汝载丞武昌","author":"陆深","text":"诗律从来彻骨清，哦松端不负兹行。\n星辰南斗占郎位，江汉西来抱县城。\n鹦鹉洲边芳草合，凤凰台上远山晴。\n春明门外冲寒别，欲折梅花重有情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萧海钓文明先生挽诗","author":"陆深","text":"朝野名传翰墨馀，白头空有读残书。\n南荒秋早逢摇落，四海人多问起居。\n塞下当年曾失马，钓丝终岁竟忘鱼。\n八哀此日还成赋，惭愧先生识面疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"连日迟李献吉不至有作","author":"陆深","text":"几日都门长者车，风尘不见正愁予。\n只今对面还千里，何处相思有尺书。\n秋色天涯催客暮，山光楼外为谁舒。\n空歌杕杜回长啸，终愧缁衣叹索居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西堂分韵得新字","author":"陆深","text":"帝里风光属小春，桥门高燕集嘉宾。\n城临北斗看山近，人爱斜阳送酒频。\n忆昔图南同作客，相逢回首各伤神。\n情深浑欲忘归去，怕见楼头月色新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安鸿渐赠诗兼惠红酒狐裘途中和答","author":"陆深","text":"恭承帝遣出词林，珍重高怀抵万金。\n醇酒巳从心醉后，绨袍何止故情深。\n秦关日月时分照，辽海风云忽送阴。\n一路画图随马首，据鞍聊得继高吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":40825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]