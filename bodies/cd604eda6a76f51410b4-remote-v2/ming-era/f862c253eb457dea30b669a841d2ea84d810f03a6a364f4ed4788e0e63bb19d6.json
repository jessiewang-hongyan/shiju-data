[{"title":"题桂阴老人","author":"王汝玉","text":"白玉堂前丹桂发，水晶宫外月轮高。\n坐听清漏浑忘寐，凉露漙漙湿素袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1765,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题池塘野步","author":"王汝玉","text":"曲栏干外暑风清，白葛生凉杖屦轻。\n花隐兰舟看不见，时闻隔浦唱歌声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1766,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"青山白云图","author":"王汝玉","text":"游子殊方清梦远，慈亲瘗玉白云深。\n它年陇上松千尺，高节应同孝感心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1767,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋江晚罾","author":"王汝玉","text":"残阳潋潋照秋波，閒理渔罾下浅莎。\n但使得鱼那怕晚，水村南北酒家多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1768,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"芦汀夜笛","author":"王汝玉","text":"风捲芦花雪满洲，笛声飞送一江秋。\n曲中都是沧浪趣，楚客听来不用愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1769,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画梅 其一","author":"王汝玉","text":"谁将浅黛湿冰魂，褪尽当时旧粉痕。\n却忆故山残雪后，淡烟笼月夜初昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1770,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画梅 其二","author":"王汝玉","text":"谁遣缁尘羃缟衣，江南臈尽淡忘归。\n罗浮梦断梨云远，月映佳人启素扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1771,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题许澜伯扇","author":"王汝玉","text":"十年不上读书楼，天上归来访旧游。\n却喜琴书今有托，莫年从此得优游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1772,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画留别许澜伯","author":"王汝玉","text":"故人喜我远还家，却向溪阴放钓槎。\n且尽樽前一杯酒，明朝相望在京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1773,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题秋林小景","author":"王汝玉","text":"孤筇何处事清游，林壑生凉雨乍收。\n霜叶一枝红未脱，白云深锁乱山秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1774,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈宗述之官西蜀","author":"王汝玉","text":"我从东去子西行，万里桥边万里程。\n白下杨花多似雪，还应难比别离情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1775,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别锡山诸友二首 其一","author":"王汝玉","text":"我将策马入神京，诸子乘舟远送行。\n芳草落花三百里，依依总是故人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1776,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别锡山诸友二首 其二","author":"王汝玉","text":"当筵莫唱渭城歌，此去京华路不多。\n明月相思情更切，西风木落洞庭波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1777,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蕉石图","author":"王汝玉","text":"瘦玉含香黛色新，閒庭昼永悄无人。\n芭蕉展尽丁香结，又是长门一度春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1778,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴彦才画","author":"王汝玉","text":"已将心事付行云，莫问君家瑶草春。\n明日穆陵关外路，亲知应念远行人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1779,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题杏花山鸟","author":"王汝玉","text":"杏花过雨粉香深，老去秋娘瘦不禁。\n惆怅看花人不见，却将春色付山禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1780,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梨花桑扈","author":"王汝玉","text":"桑扈交交拂曙鸣，梨花过雨羽衣轻。\n莫教舞落深窗里，怕遣罗敷晓梦惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1781,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"海棠白头公","author":"王汝玉","text":"海棠花发满东风，猩血妆成万朵红。\n银烛不来烧夜永，春情都付白头翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1782,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题卓迪画","author":"王汝玉","text":"长江一道落青天，北固山高凌紫烟。\n曾记夜凉吹玉笛，海门星斗照楼船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1783,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题荷花","author":"王汝玉","text":"鉴湖烟月不胜春，十里霓裳照水新。\n汀鹭沙鸥俱未识，折芳应误浣溪人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1784,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题高彦敬画和高季迪张来仪韵","author":"王汝玉","text":"贞元大历旧风流，赋尽江南芷若秋。\n何用山阳闻夜笛，水光云影总离愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1785,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅花 其一","author":"王汝玉","text":"看花曾忆少年游，江海狂踪知几秋。\n莫道何郎今老去，未教诗兴减杨州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1786,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅花 其二","author":"王汝玉","text":"长安腊尽已春回，馀雪全消未见梅。\n纸帐夜寒清梦觉，梨云空满画中开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1787,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅花 其三","author":"王汝玉","text":"万山春雪不胜寒，几度曾经载酒看。\n沈醉独眠花影下，任教青鸟自啼残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1788,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题梅花 其四","author":"王汝玉","text":"月色娟娟满禁林，青绫被拥玉堂深。\n宫壶赐酒初醒后，只少梅花伴我吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1789,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画","author":"王汝玉","text":"西风袅袅起林阿，一夜新凉到薜萝。\n人在空江秋影里，青山不似白云多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1790,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题康王渡河卷","author":"王汝玉","text":"北来飞骑疾如风，路隔长河势已穷。\n不有当时神马力，中兴谁办百年功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1791,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"为朱景昭题画竹","author":"王汝玉","text":"西山故宅草离离，留得潇湘绿玉枝。\n莫怪临风倍惆怅，画中尽是故人诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1792,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和靖夜吟图","author":"王汝玉","text":"娟娟霜月夜窗虚，隐几看花乐有馀。\n心事暗香疏影里，平生不作茂陵书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1793,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"普大云水仙","author":"王汝玉","text":"洛浦仙人绰约姿，凌波尘起袜罗时。\n何年化作天花起，来散灵山大会期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1794,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题高彦敬画","author":"王汝玉","text":"轻烟漠漠雨毵毵，风景分明海岳庵。\n北望房山数千里，如何清兴落江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1795,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇与练经","author":"王汝玉","text":"禁苑看花十二年，归来风景总依然。\n当时寿恺人虽远，喜有槐阴绿满前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1796,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题华东湖画","author":"王汝玉","text":"白发东湖一老仙，已乘黄鹤上云烟。\n至今遗墨留人世，清兴横飞太华颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1797,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"渊明把菊图","author":"王汝玉","text":"典午山河已夕晖，却寻三径赋旋归。\n平生心事南山在，不为东篱待白衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1798,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇别顾伯行","author":"王汝玉","text":"我别家乡七月秋，相逢故旧更迟留。\n明朝相忆知何处，遥指蓬山十二楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1799,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画三首 其一","author":"王汝玉","text":"人家隔断水西东，行尽溪桥有路通。\n岩树今朝全绿遍，夜来曾起落花风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1800,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画三首 其二","author":"王汝玉","text":"一别溪头旧钓槎，十年频看凤城花。\n天恩赐告归来日，不识松萝是我家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1801,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画三首 其三","author":"王汝玉","text":"暖雨初收雾尚昏，绿杨深坞杏花村。\n山中少有凡人到，满地春阴不掩门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1802,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹四首 其一 雨涤铅粉节","author":"王汝玉","text":"香露淋漓湿未乾，迎风翠袖不胜寒。\n劝君莫取青青节，留待丹山五色鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1803,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹四首 其二 风摇青玉枝","author":"王汝玉","text":"湘皋春尽玉青青，曾值西风过洞庭。\n碎佩丛铃满烟雨，夜深楚客不胜听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1804,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹四首 其三 凌空势方起","author":"王汝玉","text":"春雷初响蛰龙惊，猛势凌空夭矫横。\n几度山窗亲见处，露华如水月华明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1805,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹四首 其四 得地色不移","author":"王汝玉","text":"忆曾相对琐闱深，制草成时日乍阴。\n粉湿香浓春烂熳，岁寒霜霰岂能侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1806,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"钱塘观潮图","author":"王汝玉","text":"浙江亭上彩云收，二十年前忆旧游。\n正是桂花初发候，月轮飞上海门秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1807,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王孟端画枯木竹石为张继孟题","author":"王汝玉","text":"古木疏篁倚石边，不随桃李斗春妍。\n平生留得冰霜操，别有幽期在莫年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1808,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"严子陵","author":"王汝玉","text":"独将风节冠东京，不向云台列姓名。\n千古严陵滩上月，至今犹似客星明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1809,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"张志和","author":"王汝玉","text":"风蓑雨笠几经春，流水桃花一钓纶。\n身世自甘成两弃，翻然终愧有莘人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1810,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题凤池清影图","author":"王汝玉","text":"粉湿香凝露乍消，湘娥新整翠云翘。\n一春青琐长相对，影转金阶近午朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1811,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"留别吴秀才","author":"王汝玉","text":"重剪青灯叙旧欢，恩深不遣戴南冠。\n平生留得丹心在，拟与贞松傲岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1812,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"红梅","author":"王汝玉","text":"绛罗偷换玉精神，不是西湖旧日春。\n花落莫随流水去，寻源恐误放舟人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1813,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题竹","author":"王汝玉","text":"曾过阳明观下春，山前十里尽苍筠。\n东风吹送云门雨，只听鸣环不见人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1814,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题王汝瑄扇","author":"王汝玉","text":"不向金门谒翠华，一琴一鹤度生涯。\n乱山残雪西湖晓，看遍寒梅万树花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1815,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画","author":"王汝玉","text":"数峰相倚玉成簪，楼阁深沈酒尚酣。\n十日春寒帘不卷，杏花飞雨满江南。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1816,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送唐同知孟廉之任","author":"王汝玉","text":"杨子江头晓发舟，一官新任佐泉州。\n南方民物多凋弊，此去当分圣主忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1817,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题胡给事中画","author":"王汝玉","text":"碧梧翠竹两清妍，阴落閒庭古石边。\n未引丹山仪凤宿，画长盖我读书眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1818,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题东郭草堂次梁用行韵","author":"王汝玉","text":"日下西峰月上初，微烟收尽四郊虚。\n长歌独自还家去，却笑当年读汉书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1819,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太白观泉扇面为周上舍赋","author":"王汝玉","text":"芙蓉五朵插青天，百尺飞流霁雪悬。\n我欲乘槎上天去，不知何处访诗仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1820,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画","author":"王汝玉","text":"仙水仙山有路通，人家遥住白云中。\n一溪春色无人管，流出桃花片片红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1821,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题谢孔昭画","author":"王汝玉","text":"曾共沧浪钓晚风，今朝江上又相逢。\n莫辞同醉船头月，明日烟波各万重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1822,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赐游东苑诗九章 其一 斋宫","author":"杨士奇","text":"严严斋居，清庙之侧。\n高明澄肃，靡雕靡饰。\n帝时恭默，对越秉诚。\n有赫鉴观，锡祚万龄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1823,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赐游东苑诗九章 其二 圆亭","author":"杨士奇","text":"翼翼圆亭，法象上玄。\n至朴不斲，适于自然。\n帝时端居，游思太极。\n茅茨土阶，允配尧德。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1824,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赐游东苑诗九章 其三 方沼","author":"杨士奇","text":"凿方甃池，制仪坤舆。\n㵾乎湛渊，浑涵太虚。\n有丛其植，有群其潜。\n文王灵沼，圣人同心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1825,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赐游东苑诗九章 其四 翠渠","author":"杨士奇","text":"湜湜澄渠，天汉其宗。\n凝如碧玉，衍如翠虹。\n发循宸居，流润下土。\n惟帝德施，周于天下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1826,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赐游东苑诗九章 其五 黛峰","author":"杨士奇","text":"苍乎凌波，如戴神鳌。\n节乎峻严，如瞻崧高。\n上出氿泉，亦时出云。\n惟帝乐之，允契圣仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1827,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赐游东苑诗九章 其六 灵泉","author":"杨士奇","text":"天一所生，而出异源。\n或喷于龙，或跃在山。\n智巧之妙，浑然天成。\n周流畅达，允怡圣情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1828,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赐游东苑诗九章 其七 御苑","author":"杨士奇","text":"群植斯蕃，盎乎凝春。\n中和之推，时育之仁。\n惟帝之仁，始内及外。\n保合太和，爰暨四海。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1829,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赐游东苑诗九章 其八 嘉鱼","author":"杨士奇","text":"喁喁洋洋，以游以泳。\n洪纤异群，咸适厥性。\n爰适得所，莫敢以罟。\n矧帝之氓，而敢以侮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1830,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赐游东苑诗九章 其九 瑞匏","author":"杨士奇","text":"清云布阴，翠虬萦条。\n宛宛双绶，交系于匏。\n至和融□，毓奇斯植。\n表瑞灵苑，式昭帝德。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1831,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"芳桂堂诗为杨御史作","author":"杨士奇","text":"连绻桂树，罗生堂前。\n自我植之，郁其栾栾。\n百卉具腓，高秋始华。\n湛露瀼瀼，芳馨满家。\n有生必荣，岂必在早。\n不与众竞，如彼有道。\n坚贞之节，四时不渝。\n宜尔君子，岁晏同娱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1832,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题雪窗兰","author":"杨士奇","text":"粲粲幽兰，在彼岩阿。\n春阳流辉，惠风布和。\n粲粲幽兰，在岩之下。\n懿彼白石，静言偕处。\n兰生幽深，孰知其芳。\n自我贞素，不知奚伤。\n予怀芳馨，远莫致之。\n援琴弹丝，薄写我私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1833,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题勉仁学士草虫图","author":"杨士奇","text":"种瓜于田，既勤且劬。\n弃瓜于道，遽厌其馀。\n群趋于腐，为蚁斯足。\n虫睨于傍，其亦有欲。\n物各付物，天道流行。\n动植之微，可玩生成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1834,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"云山幽居图","author":"杨士奇","text":"翠岭兮岧岧，白云兮洋洋。\n渺澄波兮滉瀁，交春木兮芬芳。\n息有庐兮济有梁，田可穑兮原可以桑。\n蹇驽足兮周行，时不处兮岁将晏，遵东皋兮聊彷徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1835,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"颜谷辞","author":"杨士奇","text":"山青青兮郁盘，又英英兮白云。\n蔼嘉树兮颜谷，流泸水兮澄源。\n源左右兮上有原田，鱼潜泳游兮禾麻秀蕃。\n谷中之人兮连居接门，一姓盛大兮伯叔弟昆。\n不斲为饰兮朴之惇，夕还诵弦兮画行耨耘。\n嗟嗟夫子兮超哉拔伦，金玉为质兮组绣文。\n握廉秉节兮服义仁，袆椒茝兮有馥其身。\n逍摇徜徉兮以秋以春，胡不永世兮溘飘尘。\n嗟嗟夫子兮身去名存，怀不可见兮空可闻。\n世纷纷兮华薄群，安得硕人兮永亲。\n空望颜谷兮涕泗沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1836,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"培山书屋辞为金学士作","author":"杨士奇","text":"崔嵬兮培山，窈窕兮幽居。\n前峨峨兮芳林，俯溜溜兮澄渠。\n鸟交交兮和鸣，云英英兮敛舒。\n山中人兮采芝，聊栖迟兮恬以愉。\n集夫容兮为衣，杂兰椒兮佩袆。\n列左右兮图书，以旦以夕兮不知渴饥。\n爰稽古兮唐虞，惟孔颜兮吾之师。\n世远兮心同，游志千载兮乐且无期。\n静与动兮有时。\n承景运兮翱翔，登金门兮玉堂，焕云汉兮发天章。\n奉圣君兮九五，弘化理兮道弥光。\n眷山中兮故居，渺予怀兮能忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1837,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"退轩辞","author":"杨士奇","text":"芝橑兮桂户，山阿兮水澨。\n云鳞鳞兮石磊磊，交松萝兮延薜荔。\n华纷纷兮袭予，春之兰兮秋之蕙。\n羌何为兮独往，舒萧散兮泄泄。\n念盛衰兮有时，盍满盈兮豫戒。\n抚年岁兮将晏，日斯征兮月斯迈。\n纷骎骎兮忘归，余何为兮靡止。\n揽吾辔兮旋轸，返吾车兮旧里。\n恬澹兮以休，全之兮终始。\n怀夫子兮高风，邈游心兮千载。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":1838,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]