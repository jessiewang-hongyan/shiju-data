[{"title":"新恩为沂乐廷卿赋二首 其一 晓阙颁书","author":"黄衷","text":"载籍翻中秘，丹青饬化神。\n人文窥万古，名物丽三辰。\n琰琬传先美，芬芳播至仁。\n泰居心乃广，敬止德何纯。\n光彩尧章焕，渊源圣学新。\n玄辞惟理数，大道总彝伦。\n侈赐开芸閤，珍藏累锦茵。\n江阴他夜望，宝气烛高旻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新恩为沂乐廷卿赋二首 其二 春殿读卷","author":"黄衷","text":"月淡鸡人晓，风融象魏暄。\n贤才纷入彀，明主正临轩。\n蕴藉谁三策，包罗若万言。\n贞怀嘉剀切，浩养录雄浑。\n绮靡铺张彻，玙璠品第存。\n题元天翰丽，得俊圣颜温。\n席密孤卿右，恩联八座尊。\n儒荣非一事，特此重时论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"院后桂花","author":"黄衷","text":"烦襟自感零露秋，金粟蕊蕊佳香浮。\n鄂台峻肃称高品，树者无乃多前修。\n北斗城隅月色浅，转觉晓气尤清幽。\n岂惟蜂蝶带痴性，苍髯绕树恒三周。\n我家扶胥古渡口，一种便足光林丘。\n素娥首肯乞仙本，行见紫薇封南州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺坡山子冠","author":"黄衷","text":"皎皎风前玉一枝，三加真见盛威仪。\n宾阶谁更当先辈，梓里吾惭托旧知。\n有子正符将大日，称翁仍是未衰时。\n从今只数欢华地，好挽南溟入寿卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邓侍御文瑞以诗见投次韵奉答","author":"黄衷","text":"端如沃暑挽寒泉，手把清篇揖惠连。\n身际六龙催转日，气逾孤隼快横天。\n狼潜野寨无宵警，吏戢山家有晏眠。\n一自楚台相语后，矩洲谁数读书年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悯雨次巡院韵二首 其一","author":"黄衷","text":"尘缨未许濯帘泉，敢把民忧付十连。\n信有密云难作雨，愧无凉德可回天。\n揽衣每为中宵起，拂枕谁能正昼眠。\n三楚萧条非一日，未应愁瘁过当年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悯雨次巡院韵二首 其二","author":"黄衷","text":"深涧灵湫总涸泉，炎风吹野郢襄连。\n回栏徙倚频瞻毕，静院焚香自吁天。\n旱魃岂堪长作祟，雨师何得更高眠。\n鞭龙早逐滂沱去，社鼓村村报有年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜雨用韵二首 其一","author":"黄衷","text":"山瓶无复注灵泉，沔水云蒸汉水连。\n风马奔腾疑捲泽，雷车澒洞欲掀天。\n操豚市户晨方集，蓄堰溪农夜不眠。\n细检承平储预籍，止留诗案到今年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜雨用韵二首 其二","author":"黄衷","text":"入夜檐声瀑玉泉，三农行见米珠连。\n衰迟似我那关世，精白何人不愧天。\n浊酒家家拚鳖饮，玄潭处处恣龙眠。\n閒人谩有江湖纪，休记随车过楚年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读南坦寄示辞疏二首 其一","author":"黄衷","text":"早从时序托成功，仙骨梅癯兴自雄。\n山水幽期还坦上，风云英望且隆中。\n油幢笑卷三关碧，玉粒亲遗万庾红。\n散发扁舟归未得，清尘遥羡浙西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读南坦寄示辞疏二首 其二","author":"黄衷","text":"出入三朝未二毛，南归琴剑一轻舠。\n鸿私暂乞台臣假，温旨长徵国士遭。\n开社肯劳招六逸，结亭先拟近三高。\n悬知芳思东篱外，何日江邮寄和陶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乙酉冬宴客黄鹤楼用崔韵","author":"黄衷","text":"鄂城自昔登临地，崔咏何年擅此楼。\n总有才华多役役，祇应江水付悠悠。\n天开诗客阴晴景，木落渔家远近洲。\n形胜不殊风物异，谩堪笳鼓散清愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙戌秋与二镇同集用韵","author":"黄衷","text":"豁然一目数千里，不信齐云别有楼。\n雁旅东来吴会近，鹢风西上蜀江悠。\n仙踪石角孤龛月，井税金沙万顷洲。\n却望严城开府地，可胜民瘼浩新愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳后太府北楼赏菊观罩鱼","author":"黄衷","text":"江城初霁重阳雨，暇日同登节镇楼。\n黄菊有情还照眼，茱萸无分最惊秋。\n渔人竞下横池网，客子真怀钓湘舟。\n优剧不妨供小坐，世情方汝更悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出郊","author":"黄衷","text":"命车东出郊，淑景惬远眺。\n桃李虽未华，青麦芒尽耀。\n春泥腻不滑，冻石引泉窍。\n多雨人未虞，一饱行已兆。\n悠悠武穆魂，寂寂黄童庙。\n枯朽随流埃，名且白日照。\n楚才后焉乏，旌纛亦相绍。\n匪无英与贤，芜没谁自料。\n真卿不识面，风云起屠钓。\n君子重行道，岂必尽枢要。\n百年逝水澜，两曜竞丸跳。\n来者吾惧衰，孤怀冀同调。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经羊侯庙","author":"黄衷","text":"开府多英佐，分符此上游。\n雄图恢晋宇，遗德照襄流。\n雪后登临少，碑前感慨休。\n独馀苍岘庙，犹为赛春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风逆","author":"黄衷","text":"襄阳距鄂渚，七日下江程。\n北客乘风便，南船与浪争。\n孤蓬寒火淡，百丈古堤横。\n迟疾终相倚，吾方达此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中夜坐","author":"黄衷","text":"群动已向息，劳劳念倘休。\n寒厨供瀹茗，小仆问添裘。\n且理还家梦，都忘拍岸舟。\n江空月皎皎，端欲恣神游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜泛","author":"黄衷","text":"日高风正猛，江晚浪初平。\n倚棹星辰动，开窗□□□。\n回洲冲雁起，到岸接鸡声。\n暂伴渔人宿，将齐吏隐名。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦","author":"黄衷","text":"愕愕萦虚枕，真从百幻奇。\n未谙周是蝶，稍似兽维狸。\n异感吾何有，符占世亦疑。\n鬼神多戏谑，未把吉凶思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送石亭殿讲","author":"黄衷","text":"十载惊为别，孤标忽暂攀。\n恩华射赤壁，风槩被青山。\n语旧频沾臆，聆新几解颜。\n翰摇奎宿动，舟倚法星还。\n江转龙飞甸，春明虎踞关。\n仙葩仍月窟，伸骏必天闲。\n谩纪经过地，高联侍从班。\n私心长儗□，公服近栖鹇。\n文藻惭吾老，繁芜待子删。\n后期殊未定，浩兴满黄湾。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘执斋刑侍","author":"黄衷","text":"道气看弥重，高怀幸再宣。\n曲江馀契阔，闽海旧周旋。\n抚事追先美，登楼问昔年。\n仙乡滩十八，魏阙路三千。\n出入台端望，平反宪贰权。\n节旄春色净，鹢势汉波沿。\n山水分题在，箕裘统类传。\n才堪君位正，地愧我居偏。\n岁月髭双改，风云梦独悬。\n最难垂老别，徒有酒如泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙头竹杖歌","author":"黄衷","text":"龙头之竹托根深，太和福地苍崖阴。\n五风十雨足喷薄，妙乃百节全坚心。\n南岩大仙雅秘惜，一赠便觉无□□。\n□云金箓记尺度，晦冥出入群邪辟。\n怖邪迂癖□□□，时参几格如嘉傧。\n私怀每计示崇奖，镂铭愿□□工韵。\n君不见太乙真人夜下世，青藜柱到传经地。\n又不见涪翁筇竹枝，驱虎穷山独行路，眼底赤虬须鬣具。\n嗟乎，变化吾不知其处。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪闻","author":"黄衷","text":"岐阳风日足栖梧，翙翙何因到海隅。\n鹪鹖胡为混灵綵，麒麟偏得并祯符。\n声中律吕谁相和，影落关河恐亦孤。\n知子不缘循吏出，祇应明圣比唐虞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得报子章弟落第抵家","author":"黄衷","text":"高秋犹报束书归，千里何时试骏蹄。\n未必红瑜终抱璞，祇缘文锦各成机。\n青霄旧路还鸿渐，云厦谁家却燕飞。\n潜德未涯吾已老，清门须尔有光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发赈","author":"黄衷","text":"南湖北堰漫风埃，野落山樊燕不回。\n何处画图当御献，已无邻粟泛舟来。\n忧勤每问青州策，宴暇真忘浙水杯。\n独奉一函宽恤诏，千仓亲许百城开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答程以道侍御","author":"黄衷","text":"往时南楚触邪冠，义气秋旻讵得干。\n白雪几篇皆隽□，严霜六月更高寒。\n杜陵老自甘闲逸，正叔才堪化治安。\n湖海十年思会面，荆门初把一书看。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石桥驿","author":"黄衷","text":"莽苍千里澹无姿，冻閤层阴雪欲垂。\n荒驿鸡晨催仆发，长途药日许医随。\n逢山特约肩舆缓，束燎应防据馆迟。\n颇怪北风欺病骨，䫿飕终日马前吹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"草店","author":"黄衷","text":"迢遥周道净轻尘，此去荒州始号均。\n几户衡茅犹带雪，两行官柳欲回春。\n儿童惯识朝山客，租赋全轻化国人。\n颇觉楚封真不迩，南雍乡土即西秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太和山","author":"黄衷","text":"万壑珠宫照下方，百年经始戴文皇。\n横林谁认前朝碣，绝嵿时飘异国香。\n功行几尘符道契，精神何地挹灵光。\n圣恩许放宫祠例，愿乞南岩一草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"访黄宪墓","author":"黄衷","text":"道气终窥千顷陂，贤流得拟子渊宜。\n人间师表今安仰，梦里形神倘见之。\n姓氏吾惭江国远，王纲公际汉风移。\n修灵恐逐堂封尽，未奠蘋花空所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观物 其一","author":"黄衷","text":"杏花漠漠随寒雨，桃藿欣欣照早霞。\n无限芳华看不足，只缘多在野人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观物 其二","author":"黄衷","text":"□□结蚓惊雷出，野浍轻蛙得水鸣。\n端策何劳问詹尹，细看蠕动即人生。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观物 其三","author":"黄衷","text":"争巢灌木鹰何鸷，认主深庭燕不离。\n旧社未逢题燕客，五陵思杀射鹰儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观物 其四","author":"黄衷","text":"蒲芽戢戢方披冻，柳眼盈盈忽满林。\n谁采松花南涧曲，莫教黄腻过春深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"楚邸致新茶","author":"黄衷","text":"开籯淡淡楚山馨，入眼纤纤谷雨青。\n便试朝宗江汉水，不烦遥涉为中泠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"平贼拜赐银币志感","author":"黄衷","text":"綵豸夺将云锦丽，内金镂是贡时文。\n虚庸忝窃成功赐，老大多惭学道闻。\n小效敢论裨尺寸，鸿私何有答铢分。\n愿销赤子潢池甲，万国弦歌奉圣君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙戌除岁","author":"黄衷","text":"鄂渚俄惊岁再除，江天雪霁日光舒。\n吏封台印裁红楮，童理官资振素书。\n忆弟自从逢雁后，分年应在听鸡初。\n然松烧纸曾同俗，谁道迂人世事疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日用韵","author":"黄衷","text":"葱葱晓气满庭除，蕙颖兰芽渐向舒。\n短发可堪金胜集，新诗聊纵綵毫书。\n市声不动重城外，人事惟占上日初。\n苍柏两行春雪后，高台清丽转扶疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赵叔鸣西河耘业二首 其一","author":"黄衷","text":"西河得拟杜陵居，丘壑从来道晏如。\n风格有人传白下，诗声此日变黄初。\n峰岩惯作晨参客，潮落时闻晚唱渔。\n清鬓照花君自许，肯抛康济为劬书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赵叔鸣西河耘业二首 其二","author":"黄衷","text":"愿赋斯干颂始营，辋川图画浪先名。\n楼前山自希文借，趣里园同靖节成。\n东野输青留奕史，春风垂绛引经生。\n微才更阻江湖际，未得桐华洞口行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题徐侍御昭德录","author":"黄衷","text":"赤霞黄石想丰神，贲典仍华谢俗身。\n八十莺花馀戏剧，三千礼乐自陶甄。\n人间桑梓蜀威远，梦里江湖楚寿春。\n骢马风声满南国，堂封回首重嶙峋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"江上对月","author":"黄衷","text":"多时江岘雪花迷，初月今宵转汉西。\n洲渚尽看分野色，仆夫犹怯踏霜泥。\n望穷北极青衫湿，思入南乡白首低。\n银烛数残衾亦冷，远林兼送一乌啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"放船","author":"黄衷","text":"楼船箫鼓动江湄，荻火初炎早具迟。\n不独鼋鼍潜静浪，尽教凫鹜弄晴澌。\n清吟未为醑翁旷，孤笑谁堪墨客悲。\n别墅从来西涧曲，梅花几树怅归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"水禽","author":"黄衷","text":"入眼还微眇，柔翰隐淡文。\n能飞终贴水，欲去恐离群。\n雪重江沱冷，秋深露草蕡。\n平畴好莫近，罗网正纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬笋","author":"黄衷","text":"久客谙攻苦，时荒罢茹新。\n谁翻湘渚雪，稍送洞庭春。\n雨露香仍淡，山林味却真。\n勿教频采斸，待看拂云身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灵寿杖","author":"黄衷","text":"大岳先霜古，须弥后劫登。\n鸠形镂绿玉，龙挂引红藤。\n习懒吾成性，扶危尔效能。\n罗浮门户浅，携得上崚嶒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨","author":"黄衷","text":"已从人日雨，漠漠浃旬连。\n漫绿春头草，仍迷夏口船。\n雷声喧浦近，农事悯时先。\n预恐为灾沴，悁悁夜炬前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晴","author":"黄衷","text":"晴日午犹淡，闲园足媚春。\n鸳誇娇影净，蛛放喜丝频。\n晒药嗔童懒，拈杯任我真。\n东门杨柳色，恐怨未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕坐","author":"黄衷","text":"静院还迟日，仍堪簿领馀。\n帘垂鸲鹆语，砌暖海棠舒。\n江汉悲形役，诗书悔性疏。\n苦怀蒲涧曲，无路问何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙戌腊八阻风策口","author":"黄衷","text":"江路邅回还策口，簿书傍午且华颠。\n光阴流转此何日，郡邑嗷嗷非有年。\n隔舸香糜晨馔玉，挟风残雪昼飘绵。\n土阶蓂草孤根老，望断青阳楚岸边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪晴和程侍御","author":"黄衷","text":"萧萧平野散荒烟，微旭将升雪后天。\n下食饥鹰飏草际，呼晴灵鹊掠车前。\n迢遥诗画江山贶，倏忽寒暄造化权。\n已分驰驱从所适，未堪长路况衰年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与竹塘院长拟登太岳诸峰予以病不果","author":"黄衷","text":"积雪经旬喜却晴，平舆冲晓踏澌行。\n洞天自拥青莲胜，尘土空教白眼横。\n丹穴徒闻虚九室，樃花曾道阅三生。\n郧台仗钺长邻此，游兴还堪趁早莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邓侍御洞庭金鲤图歌","author":"黄衷","text":"洞庭之潴八百里，摇星簸日无时已。\n蛟妖蜃怪族各殊，琐碎讵敢窥神鲤。\n曲陵屃屃巨背高，大帜炜炜朱鬐骚。\n金鳞六六足百劫，珍目两两横波涛。\n负舟一听轩辕乐，再驾湘妃返南国。\n还从汨水葬灵均，自是悠然无底壑。\n此物神奇亦相世，得符麟凤称嘉瑞。\n楼船绣斧撼天来，瞥见乃在春湖澨。\n丹青鱍鱍光芒动，画工那许知神用。\n满堂宾客但咄嗟，衰予感旧堪长恸。\n伊昔毅皇岁丁卯，秋旦拿舟发江表。\n正书玄龙矫矫飞，壮观自诧平生少。\n光阴流转如振埃，谛视赤鲤□龙材。\n龙材龙材，慎尔变化谁能猜，江南无处无风雷。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"检南原旧翰哭之","author":"黄衷","text":"零落湘筠箧，清词照眼明。\n百年几长恨，一字数吞声。\n白日蛟螭舞，玄山宝玉横。\n所嗟游息日，随地足寒盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽淩溪子","author":"黄衷","text":"别子洪都日，盘胸藻绣明。\n时花争艳曲，春水送蜚声。\n问讯惊容减，追谈感岁更。\n怕经淮海曲，恐值众芳生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中经王粲楼","author":"黄衷","text":"城上崇楼晚，荆南积雪天。\n苍生阻饥后，白野泬漻边。\n世路遭时短，才华与赋宣。\n胡鹰九霄思，矫翼臂鞲前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄东湖二首 其一","author":"黄衷","text":"东湖若个畔，屴崱火山高。\n花净苍梧雨，松翻碧落涛。\n百年几鹤氅，八座一鸿毛。\n豸骨缘何瘦，曾均出入劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄东湖二首 其二","author":"黄衷","text":"轻帻时迎客，青鞋称谢居。\n窥林惊倦鸟，钓濑得嘉鱼。\n懒问平泉业，劬抄验药书。\n家山看不远，随意命安车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"老至三首 其一","author":"黄衷","text":"老至岂今日，烦忧祇自繁。\n修名纡紫极，短发任黄昏。\n读易嗟何得，知非可复论。\n最嫌春梦浅，不到郭西村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"老至三首 其二","author":"黄衷","text":"三月明朝是，新青万木齐。\n团兵时近举，荒政半轻赍。\n建节终为客，冲樊且放麑。\n庄荀日当席，端不费招携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"老至三首 其三","author":"黄衷","text":"今年江汉上，寒食倍寒衣。\n岂尽风光别，都缘筋力微。\n短篇閒事记，新火谩恩辉。\n千里旗冈路，松楸岁已违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诏使二首 其一","author":"黄衷","text":"驿骑真天下，颁时亦早春。\n大纲罗宇宙，万目灿星辰。\n字字沾枯槁，看看到隐沦。\n愚臣亦何幸，三度播皇仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":56442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]