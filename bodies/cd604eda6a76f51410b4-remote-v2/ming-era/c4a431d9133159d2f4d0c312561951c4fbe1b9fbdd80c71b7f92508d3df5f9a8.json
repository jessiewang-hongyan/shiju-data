[{"title":"次胡仲宣题山房韵","author":"邓雅","text":"涧上渔樵陇上云，此身甘与鹿麋群。\n白云冉冉峰头见，流水泠泠竹下闻。\n崖石倚天犹铁色，莓苔经雨自花纹。\n劳君远寄山中咏，绝胜天葩吐异芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31628,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和何质夫见寄","author":"邓雅","text":"我游群玉烟霞洞，尔爱东桥水竹居。\n两地共怜风景好，十年真与世情疏。\n秋风白酒岩前菊，夜雨青灯案上书。\n多谢向来贻锦字，至今光彩照茅庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31629,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄廖县丞止信","author":"邓雅","text":"远树微茫带白云，可堪离思日纷纷。\n数千里外闻归隐，二十年馀不见君。\n陶令芜田今种秫，杜陵樽酒拟论文。\n何时一访梅花处，坐挹清风惬素闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31630,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"用韵答黎时高","author":"邓雅","text":"白云红树晚晴馀，客子凭阑叹索居。\n摇落又惊时序改，衰迟已觉鬓毛疏。\n囊收枸杞还堪服，架束溪藤久废书。\n多谢故人能下榻，几回高枕似吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31631,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"为曾指挥题汉文帝细柳营劳军图","author":"邓雅","text":"门深细柳未曾开，持节方知大驾来。\n天上恩光明日月，营中号令肃风雷。\n匡扶帝业非儿戏，竦动天颜羡将才。\n千载功名见图画，临风还拂旧尘埃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31632,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"简黎祥叔","author":"邓雅","text":"长身如鹤脸如霞，俯仰乾坤傲岁华。\n京国壮游成旧梦，沧洲小隐似仙家。\n鸣琴夜对尊前月，携杖朝寻洞里花。\n我欲从君玩奇宝，玉堂词翰最堪誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31633,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"洪武壬戌夏六月诏徵天下贤良赴京擢用雅以非才例蒙郡举而适婴疾病乃恳辞既归辱亲故枉问赋此为谢并述鄙怀","author":"邓雅","text":"秋风萧飒鬓毛衰，怀抱无因得好开。\n林壑独栖嗟已老，朝廷三聘愧非才。\n乞归幸遂丘园乐，问讯多烦故旧来。\n谩写新吟谢知己，不妨共醉菊花杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31634,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题严氏水竹居","author":"邓雅","text":"清江江上足田庐，独爱严家水竹居。\n林合翠光浮几席，池分清润到阶除。\n参差夜月栖鸾凤，荡漾春风戏鲤鱼。\n何日临流一题咏，琅玕节下为君书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31635,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春望和黎时高韵","author":"邓雅","text":"俯仰人间岁月流，偶同春望兴悠悠。\n桃花掩映东西岸，烟水微茫上下舟。\n白酒香生茆店里，黄鹂声在树枝头。\n锦袍年少谁家子，走马看花乐未休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31636,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠医师汤谦亨","author":"邓雅","text":"汴梁未住葛溪滨，南渡衣冠子又孙。\n见说医传十六世，不知功活几千人。\n悬壶物外乾坤小，种杏云中雨露均。\n莫向明时甘隐遁，宣和曾著旧功勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31637,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄郭都事就觅藤杖","author":"邓雅","text":"屏山分首经年别，岭海休官几日还。\n富贵已看荣故里，恩威尤喜化诸蛮。\n马援薏苡何须载，陶令金英自可餐。\n老我平生惟隐遁，拟求藤杖共看山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31638,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送永丰曾仲省赴召","author":"邓雅","text":"萤窗苦学擅才名，鹗表横飞被宠徵。\n白发千丝怜我老，青云万里壮君行。\n文章盛代宗西汉，日月中天属大明。\n入觐宜陈治安策，赐官应校石渠经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31639,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄黎子谦","author":"邓雅","text":"抱琴曾访碧山阿，回首西风别恨多。\n谢眺诗情元不减，杜陵肺气近如何。\n投閒慎勿忧馀事，养性偏宜饮太和。\n况喜山中有芝术，不妨频采入烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31640,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送邓吾贯往山东觐省","author":"邓雅","text":"二十年馀隔凊温，三千里外奉晨昏。\n关河不惮驱驰苦，天地难忘鞠育恩。\n卷里赠言劳柱史，山东衣綵拜辕门。\n严君若问家乡事，松菊依然满故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31641,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沧洲秋夜对月","author":"邓雅","text":"长年为客寓沧洲，时序堪惊兴颇幽。\n明月正当书馆夜，西风先动桂林秋。\n乘槎万里思河汉，倚剑三更望斗牛。\n老去尚馀豪气在，浩歌声落大江头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31642,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽曾隐君大雅","author":"邓雅","text":"生长屏山孝义门，两朝文物古风存。\n菊松长日为宾主，诗礼平生教子孙。\n每喜从君论雅道，不堪挥泪吊孤坟。\n伤心最是山头鹤，飞去飞来为失群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31643,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽曾主簿伯曼","author":"邓雅","text":"曾承恩命佐殊邦，多病归田检药囊。\n玉树忍看埋土壤，朱弦无复奏宫商。\n千金子壮心何恨，万卷书存业未荒。\n惆怅旧游今已矣，山房题咏墨犹香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31644,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽廖县丞止信","author":"邓雅","text":"盛时文物晋风流，天上归来雪满头。\n富贵十年成往事，衣冠千古葬荒丘。\n骑龙无复朝双阙，跨鹤犹疑在十洲。\n一曲哀歌两行泪，飘零遗藁付谁收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31645,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题从弟彦彰拥翠楼","author":"邓雅","text":"楼倚东南万叠山，捲帘山势尽回环。\n天开图画烟云里，风引笙竽竹树间。\n词客燕酣歌袅袅，仙人飞过佩珊珊。\n能修五凤誇韩洎，愧我才疏鬓欲斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31646,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"御史丁公子坚与余为金石交而经岁不面殊抱怏怏甲子冬公重游玉笥留旧馆信宿既去余始自外归为之怅然赋诗写情因录奉寄","author":"邓雅","text":"壮节高标御史公，雄文佳句盛唐风。\n飞腾已羡同雕鹗，离别那堪似燕鸿。\n窗外月明梅自发，瓮头春暖酒偏浓。\n无由一遂重论约，翘首东南望葛峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31647,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送姚公奖往吉安府学从丁先生读书","author":"邓雅","text":"螺山云白鹭洲晴，送尔携书赴郡城。\n庠序共谈新礼乐，弦歌仍是旧师生。\n剑藏宝匣光犹见，玉遇良工器始成。\n老我无庸还拭目，图南指日化鲲鹏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31648,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送姚孟才往淮安省亲","author":"邓雅","text":"宁亲远向淮安去，把卷临风索我题。\n岂有才华当世重，深知孝行古人齐。\n江天日落双鸿远，沙草秋高万马嘶。\n圣代祗今多雨露，将车应值放还时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31649,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答石室朱学渊","author":"邓雅","text":"万叠峰峦翠涌波，君居石室兴如何。\n云迷老树栖玄鹤，雨过平池泛白鹅。\n看弈已惊尘世换，卫生犹喜古方多。\n何时一访烟霞里，徙倚丹崖共啸歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31650,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和丁御史子坚夏夜作","author":"邓雅","text":"暗水无声傍竹流，栖禽未定忽啁啾。\n月当虚牖才深夜，风入高松似早秋。\n壮节有怀丁御史，旧家空忆汉诸侯。\n文章黼黻山房重，一榻萧然也自由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31651,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄刘尚书子高","author":"邓雅","text":"几回献赋登青琐，一笑还山卧紫烟。\n诰命已荣天子赐，文章犹重世人传。\n玄都任种桃千树，栗里宜耕秫满田。\n久仰高名誇盛业，却惭疏懒负华年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31652,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和何大韶韵","author":"邓雅","text":"白云深处结茅庐，门掩松筠宿雨馀。\n正尔寻仙游洞府，不知骑马到阶除。\n莓苔未埽经行迹，蕉叶仍留去后书。\n近辱贻诗多好语，始知名下士非虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31653,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈伯良之京","author":"邓雅","text":"蚤岁从师入泮宫，盛年献策吐丹衷。\n九天雨露期沾沐，万国衣冠喜会同。\n用世正须谈礼乐，销兵已见乐耕农。\n朋游阙下如相问，白发萧萧左耳聋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31654,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中和黎时高","author":"邓雅","text":"学道犹疑隔两尘，仙葩采遍万山春。\n丹崖翠壁清高地，野服黄冠自在人。\n跨海未骑千岁鹤，烧丹还养百年身。\n知君亦有求仙意，群玉峰头日可亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31655,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽李次晦","author":"邓雅","text":"曾向天门听佩珂，复归林麓卧烟萝。\n家声旧说西平后，堂构新成玉笥阿。\n止喜菊松娱晚节，不堪岁月抱沉疴。\n翛然一去成千古，四海朋游涕泪多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31656,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答外甥吴克善惠砚","author":"邓雅","text":"吾甥远寄端溪石，留向窗间伴老吟。\n试墨已看生黑雾，传家尤胜蓄黄金。\n一泓润泽含元气，半世研磨用吾心。\n携到玉堂须有分，老人期望后人深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31657,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪中眺望","author":"邓雅","text":"云暗江南万里天，雪寒村落几家烟。\n梅花不辨溪头树，鹤驾虚迎海上仙。\n已喜乾坤消沴气，伫看田野乐丰年。\n闭门不作袁安卧，驴背吟诗拟浩然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31658,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"小楼閒眺","author":"邓雅","text":"江上归来岁又残，倚楼无事祗看山。\n筠松暝合微茫外，雾霭晴分紫翠间。\n静处乾坤真可乐，浮生尘土复何颜。\n举头忽见丹霄鹤，载我游仙也未难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31659,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上归山中访友","author":"邓雅","text":"曾向烟波弄钓船，复归茅屋听潺湲。\n閒情一片宜松竹，白发千丝照简编。\n物外乾坤逢泰运，山中风雪度残年。\n兴来更把枯藤杖，寻访梅花洞里仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31660,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题医师王允中松下对弈图","author":"邓雅","text":"曾向松根斸茯苓，更依松影对楸枰。\n延龄有待三千岁，胜敌何须十万兵。\n动静死生元自识，功名富贵本来轻。\n烂柯莫问当年事，看取金丹九转成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31661,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄姚玄斋兼柬陈学正","author":"邓雅","text":"杏花时节喜相过，蓬鬓萧萧醉脸酡。\n把臂欲留情更苦，掉头不住意如何。\n江山是处堪游览，风月何人共啸歌。\n闻说南邻有幽趣，白云千顷竹成坡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31662,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"姚公观澜被里人诬讼死于金陵作诗哀之","author":"邓雅","text":"双桂楼前不忍过，思君惟有泪成河。\n朋游自此相知少，世事从前未悟多。\n玉笥冷猿啼树里，金陵白骨返山阿。\n一时愤死千年恨，茅茹相连奈否何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31663,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暇日蒙子玉见招得陪诸君子燕饮欢甚大醉中放浪形骸之外而不自知也因自述一诗并作解嘲云","author":"邓雅","text":"六十行年两鬓衰，秋风吹老芰荷衣。\n白云黄鹤堪为友，流水青山总是诗。\n物外游心如太古，人前索笑似婴儿。\n坐中不著疏狂士，那得诸公一解颐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31664,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日","author":"邓雅","text":"去年此日还为客，今岁重阳暂到家。\n黄菊不堪簪白发，西风休更落乌纱。\n新篘蚁瓮何妨醉，旧事龙山亦可誇。\n伫立盖峰千仞表，无穷幽思接烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31665,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"藤杖为友人赋","author":"邓雅","text":"老藤绝胜江心竹，岭表分来九节完。\n落手有声铿爪甲，化龙无意作波澜。\n百年岁月堪扶老，万里山川得纵观。\n亦拟穿云采灵药，相邀拄到九真坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31666,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"采菊","author":"邓雅","text":"客中底事又还家，自引童孙采菊花。\n乱叶不堪兼琐碎，繁英最喜得精华。\n绣囊满衬香生枕，金盏轻浮色映霞。\n明目绝胜餐枸杞，延年何必炼丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31667,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈仲蕙输赋","author":"邓雅","text":"江上梅花万树开，送君东上凤凰台。\n九天阊阖风云会，千里舟车贡赋来。\n雨露无私沾草木，朝廷有道用贤才。\n此行不负青年志，袖惹天香得意回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31668,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽陈敏恭","author":"邓雅","text":"天地同生即弟兄，可怜未识尔先倾。\n白云黄叶空山墓，落日西风过客情。\n往事不堪同幻梦，流泉犹自带哀声。\n从来贤达皆知命，祗恨庭闱隔死生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31669,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梦故妻","author":"邓雅","text":"岁晏江乡梦故妻，梦回愁绝听鸣鸡。\n菱花不照双鸾舞，松月谁怜一鹤栖。\n黄叶故山埋骨地，白头孤枕悼亡诗。\n伤心最是门前水，呜咽长流无尽时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31670,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄永丰教谕戴正心","author":"邓雅","text":"戴君掌教恩江上，正是皇朝全盛时。\n文化今渐极南北，才名久著浙东西。\n云霄万里瞻丹阙，庠序三年坐绛帷。\n但使英才登俊造，莫嗟微禄久淹迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31671,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄石门梁先生","author":"邓雅","text":"山中讲道当隆平，时人共说梁五经。\n诸生长年沐化雨，贱子独夜瞻文星。\n石门天清一鹤远，玉笥云敛诸峰青。\n明年容我操几杖，拟乞文字留芳馨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31672,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上有怀谢检校叔宾","author":"邓雅","text":"江树历历江风清，独立相思无限情。\n功名期子上麟阁，烟波老我寻鸥盟。\n杜陵长吟悲白发，谢安久处忧苍生。\n行看三载脱衰绖，遥望五云朝玉京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31673,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"用何玄之韵寄何叔敬兼柬刘子博","author":"邓雅","text":"渺然离思萦烦襟，思君子兮在云林。\n吹箫石上老蛟舞，采药云中幽鸟吟。\n亭台有酒秋月白，门巷无尘春草深。\n因风为问刘子博，学有馀閒时见临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31674,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄刘宇泰","author":"邓雅","text":"十年不见刘隐居，闭门读尽山中书。\n固知风月满怀抱，还想雪霜侵鬓须。\n江山远隔离思苦，鸿雁不来音问疏。\n何时访我群玉洞，共拂岩花倾酒壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31675,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中对月有怀高文升","author":"邓雅","text":"山月皎皎山风清，石泉竹根流细声。\n故人一月不会面，贱子此夜难为情。\n援琴再弹调更苦，举杯强饮愁还生。\n是身安得生羽翼，奋飞直到文江城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31676,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题吉水王氏山居","author":"邓雅","text":"六月二日游山间，山人为我开云关。\n清风一榻对松竹，明月九霄闻佩环。\n壶觞日娱宾客集，城市不往轩车閒。\n知君养鹿乐栖遁，故我抱琴常往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31677,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柬张伯川","author":"邓雅","text":"同郡能诗张伯川，妙思涌出如春泉。\n昔年曾作刀笔吏，此日复种桑麻田。\n松花酿酒醉明月，荷叶制衣眠紫烟。\n山中风景自可乐，祗恐束帛来戋戋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31678,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵答黎元复","author":"邓雅","text":"幽人卜居谁与邻，坐对青山忘世纷。\n茹芝欲学黄绮辈，生世幸逢尧舜君。\n纶巾鹤氅静观易，茧纸乌丝閒缀文。\n相看又是数年别，事业日进过前闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31679,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠一村道人","author":"邓雅","text":"山中有一村道人，萧然布衲乌纱巾。\n心将白业付孙子，坐对青山忘主宾。\n啸歌终日泉石趣，呼吸太和天地春。\n吾儒妙解三教理，不须更说西来因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31680,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同里姚观澜昆弟新楼诗以贺之","author":"邓雅","text":"姚家兄弟无与俦，前后突兀成高楼。\n棣华春日自相照，燕子东风还独留。\n八窗云气连玉笥，四壁图画看瀛洲。\n若非仙骨宁好此，祝君小住三千秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31681,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"哭同邑何先生敬修因追悼曾侍郎得之","author":"邓雅","text":"前年祖送曾礼部，此日又吊何先生。\n文章传世如不死，德义持身俱可贞。\n五桥流水自呜咽，翠屏落月犹凄清。\n哀歌一曲别千古，二老有知那忍听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31682,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜宿孤山次王永安韵","author":"邓雅","text":"四山阴阴云气昏，杖藜偶出游南村。\n故人邀我启蓬户，清夜置酒盈匏樽。\n菊松泉石自可赏，富贵功名安足论。\n人生所贵在勤学，明日读书还闭门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31683,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"余鼓琴山中常恨无知音者钟期既遇奏流水以何惭乃借大镛韵赋诗一首以写琴中之趣并奉诸君一笑云尔","author":"邓雅","text":"天风萧萧吹树林，石泉泠泠清我心。\n呼儿洒埽旧茅屋，坐石拂拭焦桐琴。\n钟期自可听流水，季子何用誇黄金。\n故人于我喜同调，为君弹作苍龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31684,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"楚王府典宝邓尚忠访余叙宗族之好诗以赠之","author":"邓雅","text":"江风萧萧江树枯，使君走马寻郊居。\n不嫌野老守贫贱，肯同草坐论诗书。\n灯前斗酒暂为乐，天上丹心思远图。\n我家功业著汉代，勖哉善保千金躯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31685,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉饯外舅之襄阳","author":"邓雅","text":"外舅襄阳去，江南草绿时。\n夕阳沙上酒，旧雨卷中诗。\n云断吴天隔，舟行楚岸移。\n浩歌明月上，长啸远风吹。\n到想春将尽，居应地最宜。\n鹿门深草木，汉水净凫鹥。\n庞老神仙宅，羊公德政碑。\n览奇应有作，感旧莫生悲。\n六矢男儿事，千金贾客赀。\n此行虽特达，早发故园思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31686,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题吴仲亨种德堂","author":"邓雅","text":"种德由先世，承家见后人。\n才名终不忝，医学更无伦。\n崖石灵芝秀，庭阶玉树新。\n缘资培养力，始见发生仁。\n焚券非求誉，悬壶足养真。\n衔珠蛇不异，守杏虎常驯。\n浩荡乾坤大，涵濡雨露均。\n清朝荣禄养，堂上綵衣春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31687,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西庵耕叟为姚观海赋","author":"邓雅","text":"南徼风尘久，西庵日月长。\n健儿从战伐，垂老事耕桑。\n蔓草勤须剪，松醪渴易尝。\n把书晴护麦，看雨暮移床。\n翠竹连蔬圃，寒泉带柳塘。\n石阑风淅沥，云谷树苍茫。\n牛犊侵晨牧，豺狼入夜防。\n烟霞成痼癖，神物致休祥。\n庞老身无恙，陶潜兴不忘。\n蒲葵添散逸，筇竹任徜徉。\n了事输租税，无忧足稻粱。\n文寻高士传，诗咏甫田章。\n既识浮生理，须求不老方。\n勖哉加饮膳，击壤待时康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":31688,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]