[{"title":"忆长安十首 其十","author":"俞彦","text":"长安忆，其十忆风波。\n恶口毒肠三面鬼，盈街塞路九头魔。\n行不得哥哥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28582,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望江南 其一 同周长卿、焦不害咏所见","author":"俞彦","text":"流盼处，相对两峰尖。\n扇底不防明月上，轻衫微动晚风纤。\n聊复为郎淹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28583,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望江南 其二 同周长卿、焦不害咏所见","author":"俞彦","text":"寻去路，小径竹林边。\n却似武陵踪自杳，还如雒浦梦相牵。\n空来拾翠钿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28584,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆王孙 其一 本题","author":"俞彦","text":"王孙踪迹惯天涯。\n草绿春归不忆家。\n晚风和月到窗纱。\n惜年华。\n飞絮游丝共落花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28585,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆王孙 其二 春闺","author":"俞彦","text":"晓来春睡未惺惚。\n报道郎归便整容。\n窗外那堪薜荔风。\n恨添浓。\n此后何须入梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28586,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"调笑 其一 无题","author":"俞彦","text":"调笑。\n调笑。\n树上子规频叫。\n声声只劝侬归。\n归去须凭酒杯。\n杯酒。\n杯酒。\n时事不堪回首。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28587,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"调笑 其二 咏草","author":"俞彦","text":"芳草。\n芳草。\n偷促年光易老。\n无端陌上萋萋。\n惯占西东路岐。\n岐路。\n岐路。\n送却王孙无数。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28588,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"如梦令 其一 离别","author":"俞彦","text":"刚道行期还未。\n挨到临头无计。\n手掌大于船，偏少风波做美。\n几许。\n几许。\n又早隔重江水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28589,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"如梦令 其二 离别","author":"俞彦","text":"火样情儿难驻。\n冰样恓惶难拒。\n忍死割将来，步步不如归去。\n难处。\n难处。\n央个梦儿做主。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28590,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"如梦令 其三 早春郊试","author":"俞彦","text":"草绿南原如绣。\n风软月华云骤。\n时得晚林香，昨夜缥梅春透。\n微嗽。\n微嗽。\n惊起避人松鼬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28591,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长相思 其一 秋夜","author":"俞彦","text":"枕初惊。\n酒初醒。\n窗外寒风断续声。\n残灯与梦清。\n月华凝。\n露华明。\n疑有仙娥下玉京。\n乘鸾捧素笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28592,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长相思 其二 拟古","author":"俞彦","text":"折花枝。\n恨花枝。\n准拟花开人共卮。\n开时人去时。\n怕相思。\n已相思。\n轮到相思没处辞。\n眉间露一丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28593,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长相思 其三 拟古","author":"俞彦","text":"是情儿。\n总难支。\n便做铜仙去汉时。\n也须流泪辞。\n竺乾师。\n大悲慈。\n语语教人学勿思。\n如之何勿思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28594,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长相思 其四 崇祯八年正月十八日，贼陷池河。是日枢部发援兵","author":"俞彦","text":"那风魔。\n援池河。\n只是窝蜂与靥螺。\n笑伊知甚么。\n三棒鼓。\n一声锣。\n贼比官人争几多。\n池河还在么。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28595,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"生查子 其一 除夜守岁","author":"俞彦","text":"柏酒与辛盘，共作峥嵘景。\n为惜岁华流，烛跋炉香冷。\n红散绮窗梅，翠泻瓷瓯茗。\n一夜两年人，短鬓双蓬影。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28596,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"生查子 其二 为友寄远","author":"俞彦","text":"家在赤城隈，卿住桃源渡。\n向晚碧云生，迷却天台路。\n青鸟不归来，夜夜双星度。\n花月梦同孤，此恨无人诉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28597,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"生查子 其三 拟孙光宪体","author":"俞彦","text":"淹抑闷青春，拖逗情红泪。\n铸错作心兵，难把愁城碎。\n枕衾余花月，对惯做惺然。\n醉曾问杜康，无此酒，何名类。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28598,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"生查子 其四 拟孙光宪体","author":"俞彦","text":"待拔旧愁根，忽种新愁换。\n晓夜两秋成，四大仓都满。\n减颜红，摧鬓短。\n并不因寒暖。\n曾问越人无，此病何名款。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28599,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"添声杨柳枝 游仙","author":"俞彦","text":"曾伴湘灵碾翠軿。\n下瑶京。\n贪看碧杜与红蘅。\n会群媖。\n夜香云软霞衣薄。\n五铢轻。\n三十六陂空水明。\n晚峰青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28600,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"点绛唇 天台","author":"俞彦","text":"千树桃绯，万年药就灵仙侣。\n芙蓉脂肉。\n霞袂风前举。\n何物凡夫，归向人夸诩。\n重来处。\n乱山无数。\n怅落红如许。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28601,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春光好 闺思","author":"俞彦","text":"花眼媚，柳腰伸。\n正芳春。\n懊恨不曾缘底事，意中人。\n无绪独依孤枕。\n有时愁伴重茵。\n风起絮飞天欲暮，坐含颦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28602,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 其一 听筝","author":"俞彦","text":"燕子矶边潮夜生。\n凤凰台畔柳春晴。\n双鬟低按小秦筝。\n重来南国梅初落，半入凉州月正明。\n行人何事又关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28603,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 其二 晚眺","author":"俞彦","text":"片片残霞紫锦披。\n蒙蒙星气白榆微。\n欲弦新月似浓眉。\n独上层台余怅望，十年心事恨多违。\n旄头何日陨天威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28604,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 其三 拟古","author":"俞彦","text":"浸月楼台带月钟。\n晚风依约到帘栊。\n踏歌人去书屏空。\n宝篆印销金粉她，镜台尘满玉花踪。\n含思含怨寂寥中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28605,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 其四 闺意","author":"俞彦","text":"簧暖笙寒调不成。\n绣鸳鸯底锦衾明。\n一番花信百愁生。\n小立房栊无半语，步移栏干待多情。\n今宵沉醉也还醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28606,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 其五 改参寥诗","author":"俞彦","text":"风蒲猎猎弄轻柔。\n欲立蜻蜓不自繇。\n藕花无数满汀洲。\n五月临平山下路，蚕成衣褛麦成秋。\n人家多住浅溪头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28607,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 其六 集句","author":"俞彦","text":"欲卷珠帘春恨长。\n挑花历乱李花香。\n为谁消瘦减容光。\n独见彩云飞不尽，更教明月照流黄。\n海天愁思正茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28608,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 其七 集句","author":"俞彦","text":"二十余年别帝京。\n水流花谢两无情。\n昔时亲友半凋零。\n案有黄庭尊有酒，醉闻花气睡闻莺。\n焚香洗钵过余生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28609,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 其八 集句","author":"俞彦","text":"抱得秦筝不忍弹。\n诗名往日动长安。\n此中道路古来难。\n莫道蓟门书信少，人情反复似波澜。\n阴符在箧老羞看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28610,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣溪沙 其九 访炼师","author":"俞彦","text":"花里寻师到杏坛。\n养真高静出尘寰。\n机心还逐白鸥闲。\n迸水定浸香案湿，洞门深锁碧窗寒。\n东来紫气满函关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28611,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 其一 临淮道中","author":"俞彦","text":"深秋叶落疑为雨。\n何人不道征人苦。\n林薄又斜阳。\n寒风与路长。\n一声南去雁。\n泪下浑如霰。\n天外秣陵城。\n迢迢魂梦惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28612,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 其二 拟温飞卿体","author":"俞彦","text":"晴花夜灿楼台锦。\n月娥流艳笼香寝。\n相对脸芙蓉。\n春纤捧玉钟。\n传觞残酒共。\n此酒尤珍重。\n沾得口脂余。\n琼浆更不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28613,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 其三 回文诗拟王文甫体","author":"俞彦","text":"朵云沉户横金锁。\n锁金横户沉云朵。\n茫渺信成双。\n双成信渺茫。\n玉如颜素束。\n束素颜如玉。\n曾未梦离卿。\n卿离梦未曾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28614,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 其四 回文诗拟王文甫体","author":"俞彦","text":"伴人孤月黄昏半。\n半昏黄月孤人伴。\n波眼泪时多。\n多时泪眼波。\n怨深萦梦浅。\n浅梦萦深怨。\n君似不销魂。\n魂销不似君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28615,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 其五 回文诗拟王文甫体","author":"俞彦","text":"幕帘钩雨花阴薄。\n薄阴花雨钩帘幕。\n离别动年期。\n期年动别离。\n远山眉翠软。\n软翠眉山远。\n人待不归春。\n春归不待人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28616,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 其六 回文诗拟王文甫体","author":"俞彦","text":"泪行千叠难书寄。\n寄书难叠千行泪。\n无信到关榆。\n榆关到信无。\n小山屏篆袅。\n袅篆屏山小。\n寒露月华残。\n残华月露寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28617,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 其七 别","author":"俞彦","text":"月晴云散人离别。\n别离人散云晴月。\n齐若杜鹃啼。\n啼鹃杜若齐。\n送愁将破梦。\n梦破将愁送。\n难会后来单。\n单来后会难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28618,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 其八 回文诗拟王文甫体","author":"俞彦","text":"敛霞红散行云浅。\n浅云行散红霞敛。\n中可月庭空。\n空庭月可中。\n砌虫阴语细。\n细语阴虫砌。\n灯烬欲残更。\n更残欲烬灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28619,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 其九 晏会","author":"俞彦","text":"酒前欢把柔荑手。\n手荑柔把欢前酒。\n欢不饮杯完。\n完杯饮不欢。\n落梅吹断角。\n角断吹梅落。\n嘶骑夜光微。\n微光夜骑嘶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28620,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 其十 咏梅","author":"俞彦","text":"雪晴飞暗朦朦月。\n月朦朦暗飞晴雪。\n妆点额凝香。\n香凝额点桩。\n玉鳞飘地忽。\n忽地飘鳞玉。\n疏影晚山孤。\n孤山晚影疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28621,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 其十一 寄答","author":"俞彦","text":"美人如月花窗绮。\n绮窗花月如人美。\n风暖度香丛。\n丛香度暖风。\n未通曾展意。\n意展曾通未。\n怜尔得来笺。\n笺来得尔怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28622,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"菩萨蛮 其十二 回文诗拟王文甫体","author":"俞彦","text":"碧烟香袅孤灯夕。\n夕灯孤袅香烟碧。\n长夜奈衾凉。\n凉衾奈夜长。\n月明窥牖缺。\n缺牖窥明月。\n愁别忆还休。\n休还忆别愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28623,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"减字木兰花 苦雨","author":"俞彦","text":"春光无主。\n被底悄寒生夜雨。\n燕子飞来。\n不道梅花尚未开。\n春江已半。\n恁把岁华都送断。\n倩语东皇。\n此后风尘渐可伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28624,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"诉衷情 其一 燕京灯市","author":"俞彦","text":"凤城东畔市灯初。\n春色转皇都。\n红楼满罗珍翠，朱邸列珊瑚。\n金服匿，绣天吴。\n锦氍毹。\n百蛮兽舞，万国凫趋，亿载鸿图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28625,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"诉衷情 温助教 其二 本调","author":"俞彦","text":"缄来侧理。\n忙自启。\n带啼痕。\n看不尽，独立近黄昏。\n憔悴画中人。\n真真。\n衷情谁诉闻。\n闇销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28626,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"诉衷情 魏大尉 其三 游仙","author":"俞彦","text":"瑶池晏罢独归来。\n凌虚百尺台。\n镂月佩，蹑云鞋。\n被记玉宸差。\n绛节质明开。\n宝幢排。\n霓旌队队紫霞裁。\n向蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28627,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丑奴儿 占赠","author":"俞彦","text":"奴儿天与丰姿占，琢玉团酥。\n无可形摹。\n转把奴儿作丑呼。\n神仙队里曾偎揣，目眩魂徂。\n记得模糊。\n待写云英当丑奴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28628,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卜算子 小孤山","author":"俞彦","text":"万里卷潮来，一柱当中撑。\n甚日天公堕宝簪，巧向江心碇。\n乞与小姑奁，不共彭郎饤。\n若到宫亭换晚妆，霞落明于镜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28629,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆秦娥 春思","author":"俞彦","text":"东风薄。\n晓来次第新红落。\n新红落。\n知他何处，任他飘泊。\n人间谁似多情恶。\n些儿放了还担着。\n还担着。\n个中悄悄，恁甘抛却。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28630,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清平乐 良乡道中 天启壬戌","author":"俞彦","text":"征尘扑面。\n两袖余香染。\n消受吾皇恩缱绻。\n惭愧微臣福浅。\n昨朝玉殿传班。\n今宵野戍孤鞍。\n归去躬耕祝圣，其它一事无关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28631,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"更漏子 其一 拟古","author":"俞彦","text":"向前时，怜恰好。\n苦恨情悰较少。\n今已后，奈情何。\n情多恨转多。\n枉周折。\n须把别。\n孤馆晓灯明灭。\n争得似，玉花骢。\n随君浪荡踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28632,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"更漏子 其二 拟古","author":"俞彦","text":"眼波明，眉岫远。\n比玉人儿较软。\n拖绣帔，掩明珰。\n盈盈入画堂。\n风似剪。\n寒侵浅。\n对袖笼香展。\n相问讯，两寒温。\n一番情话新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28633,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"更漏子 其三 惜花","author":"俞彦","text":"惜花深，看永夜。\n愿得迟开迟谢。\n开若早，谢还轻。\n凄凉无限情。\n屏山馆。\n芳池畔。\n要得生香不断。\n梅蕊后，到荼醾。\n栽教次第催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28634,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阮郎归 其一 雪","author":"俞彦","text":"玉真剪水复裁云。\n冰花式样新。\n大千世界总成银。\n天公不畏贫。\n寒自紧。\n意儿温。\n金炉脑麝喷。\n脸霞纤手共芳尊。\n春融有十分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28635,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阮郎归 其二 冬日","author":"俞彦","text":"布袍芒屩着绵轻。\n冬来常是晴。\n画楼西畔晓曦明。\n灵禽三两声。\n争局罢，斗茶赢。\n闲园故故行。\n晚来红烛俊相迎。\n休教歌酒停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28636,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阮郎归 其三 咏茶","author":"俞彦","text":"午槐团影占风轻。\n茶烟缕缕青。\n竹炉汤沸响瓶笙。\n红儿手自烹。\n祛倦魄，引吟情。\n闲中事事清。\n汉宫无用赐金茎。\n相如渴已醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28637,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"阮郎归 其四 夜饮","author":"俞彦","text":"月华楼上彩云交。\n银虬烛缕销。\n雁筝如字列檀槽。\n霓裳散六么。\n苍水佩，紫霞绡。\n近人兰麝飘。\n玉京仙里恣游遨。\n人间无此宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28638,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"画堂春 赠祝","author":"俞彦","text":"画堂春色满氍毹。\n喜晴人意偏舒。\n双成昨夜下清都。\n未返琼裾。\n一任赤龙飞辔，会教青鸟传书。\n小仙人在五云居。\n无限欢娱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28639,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"美人归 此调犯《虞美人》、《阮郎归》，故名有感","author":"俞彦","text":"远山凝黛波凝盻。\n苦海茫无岸。\n袅蹄为铸靥为螺。\n业风吹爱河。\n坠楼人别黄金坞。\n曾上扬州路。\n他生未卜此生休。\n应愁不解愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28640,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"贺圣朝 留春","author":"俞彦","text":"东皇听我多珍重。\n莫便思飞轻。\n得得难来，频频要去，匆匆如梦。\n梨花欲吐香魂动。\n待一杯相共。\n可能张主，免教佳节，雨摧风送。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28641,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"摊破浣溪沙 咏料丝毬灯","author":"俞彦","text":"剪彩冰毬攒料丝。\n鬼工人巧两相资。\n初出毗陵新样子，斗华滋。\n丁缓侯门呈技日，三郎沉醉未回时。\n对此传柑倾一盏，不须辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28642,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"桃源忆故人 有约","author":"俞彦","text":"故人家住桃源径。\n一水盈盈秋静。\n有约不来魂凝。\n孤枕屏山映。\n渔郎自恨仙缘竟。\n风扫落花无定。\n何日刀环期订。\n天上飞明镜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28643,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柳梢青 柳","author":"俞彦","text":"律转柴门。\n瞥然青眼，便欲窥人。\n烟里凝颦，雨中含泪，又是残春。\n渚宫茂苑休论。\n但极目、无非断魂。\n十五桥头，三千殿脚，都已成尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28644,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"河渎神 本调","author":"俞彦","text":"风色静寒塘。\n寒花庙里初芳。\n水光无限拍山光。\n女伴相携信香。\n人生何处担情怨。\n箧里到秋纨扇。\n回施臂间金钏。\n归来无语庭院。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28645,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 其一 警悟","author":"俞彦","text":"祗为人情善幻，顿成世路参差。\n教君凡事且回思。\n莫便眉攒颡泚。\n鼎鼎百年俱尽，皇皇意欲何之。\n归来陶令是吾师。\n不道昨非今是。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28646,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 其二 警悟","author":"俞彦","text":"人世鲜逢开口，一生几见轩眉。\n必求事事福文齐。\n为造物者难矣。\n缺陷何年平满，达人当下都摧。\n天公无计奈何伊。\n不达也须繇你。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28647,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西江月 其三 戏效辛稼轩体","author":"俞彦","text":"昨有客来相访，通名自谓包羲。\n主人坚以未同辞。\n客笑卿当勿尔。\n昔与陶潜高卧，风流千载谁师。\n闻卿学懒且吟诗。\n特地寻盟到此。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28648,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"醉花阴 其一 端午饮清溪阁上","author":"俞彦","text":"谁拯灵均湘水上。\n节物多惆怅。\n痛饮读离骚，杜若江离，总是凄然况。\n姊归曾整行春仗。\n俯仰千秋壮。\n今日拟招魂，酒侣诗朋，醉弄清溪涨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":28649,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]