[{"title":"画 其二","author":"徐庸","text":"小结茅茨涧上村，抱琴高士日临门。\n酒船亦在清江曲，今夜同来罄一樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33091,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画鸦","author":"徐庸","text":"秋水茫茫浅鹭沙，古槐疏柳带栖鸦。\n啼来彷佛琴中夜，一抹炊烟数点霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33092,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"影梅","author":"徐庸","text":"薄薄轻云淡淡烟，雪香深处隐姑仙。\n清容未肯全相露，为恐炎凉有弃捐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33093,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"棠梨竹枝锦鸠","author":"徐庸","text":"棠梨花朵压枝低，两两锦鸠来上啼。\n更有青青君子竹，如何不见凤凰栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33094,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"右军临池图","author":"徐庸","text":"鼠须微纸写蝇头，一幅千金不易求。\n往事偶传图画里，至今犹想晋风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33095,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和门字韵呈娱","author":"徐庸","text":"荣辱升沉岂足论，自穷经史在朝昏。\n老夫肯负平生学，献策定登金马门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33096,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"红梅","author":"徐庸","text":"仙姿绰约世间稀，宴罢瑶台倚醉归。\n几度东风吹未醒，酒香薰透六铢衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33097,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题淡庵画梅扇","author":"徐庸","text":"月里玄霜兔捣成，姑仙一得便长生。\n刀圭又寄?侯眼，颜色于今分外清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33098,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题夏先生竹","author":"徐庸","text":"沧洲西去玉峰高，明远楼中写凤毛。\n一片清风林下起，海天何处看秋毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33099,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠医士","author":"徐庸","text":"杏林春在凤城西，绛雪香中一鸟啼。\n污简古方传道要，青囊神药用心机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33100,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾大尹去思十咏 其一 嵇山甘棠","author":"徐庸","text":"甘棠阴接会嵇山，歌颂声传百里间。\n仁政不须誇召伯，清风千古得追攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33101,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾大尹去思十咏 其二 越台柳色","author":"徐庸","text":"东风吹暖越台春，杨柳依依嫩曲尘。\n雨露有恩原不细，枝条全被发生仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33102,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾大尹去思十咏 其三 耶溪","author":"徐庸","text":"耶溪水似别情深，倚棹中流照寸心。\n款乃一声歌未了，又来吴渚起清音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33103,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾大尹去思十咏 其四 镜水凭楼","author":"徐庸","text":"卧辙扶辕不可留，思君重上夕阳楼。\n镜湖有水过天阔，澄彻同为一片秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33104,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾大尹去思十咏 其五 天柱兴怀","author":"徐庸","text":"晴峰万仞插青□，日照芙蓉宿翳消。\n判笔不摇真可拟，至今民□想高标。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33105,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾大尹去思十咏 其六 云门驻目","author":"徐庸","text":"山绕云门古寺开，郎官祈祷昔曾来。\n诗成走笔题岩石，不下当年老杜才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33106,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾大尹去思十咏 其七 玉笋笼烟","author":"徐庸","text":"天然漠漠有依依，散作寒光锁翠微。\n斜日晚来休拄笏，帝庭看傍衮龙飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33107,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾大尹去思十咏 其八 禹穴瞻云","author":"徐庸","text":"云出青山禹穴空，天南飞处逐清风。\n贮看移向金銮上，便入氤氲五色中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33108,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾大尹去思十咏 其九 石帆杨月","author":"徐庸","text":"月样黄金作浪纹，白莲浮影夜初分。\n流辉立下钱清渡，踪迹当追旧使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33109,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和曾大尹去思十咏 其十 娥江听雨","author":"徐庸","text":"布谷声中送雨声，劝农时节看农耕。\n推蓬正在娥江上，沛泽均沾万物生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33110,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"耕隐","author":"徐庸","text":"喔喔鸡声晓梦醒，心关农事起披星。\n曾闻伊尹劳三聘，又信倪宽带一经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33111,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送卞以和","author":"徐庸","text":"直笔躬操已有年，脩书才就便东旋。\n如何不慰苍生望，又理蓑衣踏钓船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33112,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题王文恭画","author":"徐庸","text":"风度湘云学水流，□床□影□如秋。\n□情最爱银钗女，一曲清歌唱未休。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33113,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"凭栏","author":"徐庸","text":"岸芷汀兰远近香，水边亭馆夏风凉。\n凭栏吟望天无际，几□春山在夕阳。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":33114,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自题画","author":"徐庸","text":"江湖落魄鬓毛皤，老大归来理钓莎。\n闲而小舟吹短笛，一声声是太平歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5