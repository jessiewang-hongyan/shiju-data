[{"title":"春日同于子冲上灵岩寺四首 其一","author":"于慎行","text":"寺自高齐辟，山从岱岳盘。\n云霞千嶂晓，风雨万松寒。\n路绕泉声入，花分鸟道看。\n忽闻钟磬发，作礼叩旃檀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同于子冲上灵岩寺四首 其二","author":"于慎行","text":"为访名山胜，来参梵帝筵。\n烟霞围宝地，龙象拥诸天。\n喻法昙花落，翻经贝叶传。\n朗公今化石，不转谒金仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同于子冲上灵岩寺四首 其三","author":"于慎行","text":"春阴连岳麓，法界满祗林。\n巨壑浮云细，悬崖白日深。\n野僧閒入定，山鸟静多音。\n幸共齐年侣，同皈出世心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同于子冲上灵岩寺四首 其四","author":"于慎行","text":"双峰最高顶，倚杖白云扉。\n树杪看人出，山坳送鸟飞。\n钟声众壑满，香霭下方微。\n三观凭阑得，因风欲振衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄张玉阳年兄汴上","author":"于慎行","text":"我行殊未久，君亦解朝衣。\n世路无工拙，时名有是非。\n莫谈温室树，聊采北山薇。\n梦断夷门道，秋深雁不飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阁夜","author":"于慎行","text":"何处夜色好，月明独倚楼。\n一声长笛起，吹裂万山秋。\n风露凄以冷，星河静欲流。\n怀人不可见，天末眇含愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"云翠山天观和朱可大韵","author":"于慎行","text":"碧山吾欲隐，双屐且随君。\n星斗岩前接，藤萝杖底分。\n泉声浑作雨，岚气稍成云。\n愁对仙坛月，鸾箫午夜闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洪范池和韵","author":"于慎行","text":"何地探灵境，仙泉旧有名。\n天光金镜冷，潭影玉壶清。\n溪鸟依人立，林蝉尽日鸣。\n鱼龙今寂寞，不畏夜珠惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同朱令君泛舟西汀二首 其一","author":"于慎行","text":"旧向沧洲隐，今陪茂宰游。\n笛声催画鹢，帆影挂浮鸥。\n酒对青山暮，歌翻白苧秋。\n花源多少路，随处有渔舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日同朱令君泛舟西汀二首 其二","author":"于慎行","text":"荡漾千峰色，轻舠入翠微。\n凫迎仙令舄，鸥拂野人衣。\n岸柳晴犹湿，江云冷不飞。\n天风乘醉起，吹送月中归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送崔亚沂博士游齐","author":"于慎行","text":"共作名山隐，三秋采蕨薇。\n宁辞今日别，袛恐故人稀。\n斗酒不得醉，白云相与归。\n秋来玄雁度，可向海门飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"楼居","author":"于慎行","text":"楼居非有好，高枕自人间。\n夜色尊前月，春阴槛外山。\n目随归鸟尽，心与片云閒。\n未遣浮名累，虚称善闭关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日閒居","author":"于慎行","text":"空林销永日，不暑亦无喧。\n种药时窥圃，摊书每闭门。\n雨痕侵柱础，苔色上松根。\n此意应谁识，惟偕静者论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东郭草堂即事","author":"于慎行","text":"结庐非异境，负郭少将迎。\n竹屿含云影，松窗落雨声。\n片峰当户出，众鸟隔林鸣。\n宴坐几无念，谁知绝世情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过雨","author":"于慎行","text":"五月不知暑，虚堂飒似秋。\n残虹挂溪水，片雨过城楼。\n远树斜阳驻，深山夕翠流。\n晚凉思枕簟，绝爱北窗幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小楼","author":"于慎行","text":"小楼常有伴，端不叹离群。\n牖纳青溪月，檐飞翠岫云。\n自藏东观草，谁勒北山文。\n最怅霜空雁，寒声静夜闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中东流泉上同可大赋","author":"于慎行","text":"风雨鸣丹谷，林亭倚翠岑。\n一尊今日酒，千里故人心。\n树动三秋色，泉飞万壑音。\n夜凉横吹起，直欲想龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋小岱山对月","author":"于慎行","text":"此夜寒无奈，瑶台近斗牛。\n山名真小岱，月色正中秋。\n影入河蟾湿，光翻树鹊愁。\n只疑参岳顶，笙鹤上宫游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山庄即事","author":"于慎行","text":"逃名天地阔，斗室寄山椒。\n地僻常无客，林深亦有樵。\n饭牛春待雨，放鹤夜闻箫。\n不是淮南隐，淹留未可招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有怀苏八长史","author":"于慎行","text":"三苏称大雅，季子复能文。\n老作诸侯客，名高国士群。\n别心燕塞雨，旅舍鹊湖云。\n家学枚皋在，词坛已策勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"入都再游摩诃禅林","author":"于慎行","text":"为忆青莲社，重寻旧法堂。\n壁题存姓字，阶树阅行藏。\n觉路人天迥，春辉佛日长。\n尔时京落客，曾识雨花香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再至长安见无弦上人移住法藏庵因听弹琴赋赠","author":"于慎行","text":"别来何所住，卓锡自成林。\n幡影香台静，钟声竹院深。\n一花开佛土，半偈定禅心。\n挥手松风里，依然未鼓琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同朱可大起部冯用韫太史同游恩隆观暨侍中园纪事二首 其一","author":"于慎行","text":"常侍先朝贵，仙宫上苑西。\n野分青嶂迥，路入白云迷。\n深树花初发，閒阶草自萋。\n当年供奉地，犹揭旧璇题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同朱可大起部冯用韫太史同游恩隆观暨侍中园纪事二首 其二","author":"于慎行","text":"小有兰亭胜，临流一放歌。\n酒边横落照，花底拂回波。\n何地疏狂少，吾徒聚散多。\n春衣浑欲绿，知是藉烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同馆诸丈城西看花二首 其一","author":"于慎行","text":"别苑惜春残，开尊聚旧欢。\n花间张绮幕，柳外簇雕鞍。\n飞雪歌中度，回风掌上看。\n倚阑浑欲醉，犹索酒杯宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同馆诸丈城西看花二首 其二","author":"于慎行","text":"十载叹西东，欢娱此日同。\n容华青镜里，身世绿尊中。\n花气看无赖，莺歌听不穷。\n何妨归骑缓，蹀躞受东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱可大邀同冯太史饮摩诃庵南园步至钓鱼台夜眺还宿法藏精舍次日观慈寿浮图纪游四首 其一 南园","author":"于慎行","text":"胜会开芳苑，春愁入远峰。\n壶觞连竹树，歌咏起鱼龙。\n花落空林雨，风传别院钟。\n淹留公子爱，移席转从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱可大邀同冯太史饮摩诃庵南园步至钓鱼台夜眺还宿法藏精舍次日观慈寿浮图纪游四首 其二 钓台","author":"于慎行","text":"行歌随步远，已到水云天。\n夜色千峰月，湖光万顷烟。\n衔杯心跌宕，脱帽态蹁跹。\n醉眼迷归径，相看枕腹眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱可大邀同冯太史饮摩诃庵南园步至钓鱼台夜眺还宿法藏精舍次日观慈寿浮图纪游四首 其三 法藏庵","author":"于慎行","text":"何必耽丘壑，居然鹿苑栖。\n片云双树顶，孤月上方西。\n罢酒闻清梵，探诗见旧题。\n归依空品相，不省在招提。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱可大邀同冯太史饮摩诃庵南园步至钓鱼台夜眺还宿法藏精舍次日观慈寿浮图纪游四首 其四 慈寿寺阁","author":"于慎行","text":"隔夜忘醒醉，穷游别起端。\n绀林重驻马，宝阁几凭阑。\n飞刹金银涌，回峰紫翠盘。\n皇都多钜丽，是处有奇观。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月廿八日葛龙池朱讷斋二工部冯琢吾葛凤池二太史同游城西黄侍中园林看花四首 其一","author":"于慎行","text":"不奈连朝病，因看上苑春。\n如何五侯第，又见百花新。\n日映丹霞晕，烟凝绛幄尘。\n狂来无藉在，帻岸白纶巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月廿八日葛龙池朱讷斋二工部冯琢吾葛凤池二太史同游城西黄侍中园林看花四首 其二","author":"于慎行","text":"真赏谁应共，风流是旧欢。\n藏书周太史，襆被汉郎官。\n花气尊中满，松声座上寒。\n相逢休惜醉，春色欲凋残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月廿八日葛龙池朱讷斋二工部冯琢吾葛凤池二太史同游城西黄侍中园林看花四首 其三","author":"于慎行","text":"改席临虚榭，为欢事每奇。\n控弦天苑骑，跳剑内园儿。\n小榻时欹枕，疏帘久对棋。\n稍闻深树里，风送桔槔迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三月廿八日葛龙池朱讷斋二工部冯琢吾葛凤池二太史同游城西黄侍中园林看花四首 其四","author":"于慎行","text":"谁谓长安陌，风尘此地稀。\n山光相映带，野色自芳菲。\n旭日薰歌扇，轻花着舞衣。\n马蹄归欲懒，为送惜春归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同可大用韫登毗卢阁","author":"于慎行","text":"人天标胜境，暇日一衔杯。\n烟树重城合，香花万井开。\n怀乡游子念，作赋客卿才。\n愁见门前道，车尘日夜催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"毗卢阁送可大南旋","author":"于慎行","text":"梵阁俯珠林，龙宫岁月深。\n几人同啸咏，此日复登临。\n画栋含朝雨，青峰起暮阴。\n不堪欢会地，又怅别离心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱大司空挽歌八首 其一","author":"于慎行","text":"有伟生民杰，鸿名日月光。\n三朝熙揆路，八座丽文昌。\n尚想玄圭锡，俄惊白璧藏。\n平生门下士，歌薤不成章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱大司空挽歌八首 其二","author":"于慎行","text":"此日飙轮远，何年画阁开。\n勋猷金匮史，文赋柏梁才。\n故事传西省，遗恩照夜台。\n凄清华表月，不见鹤归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱大司空挽歌八首 其三","author":"于慎行","text":"再领河堤节，三行海国春。\n吏人虔俎豆，父老怆车尘。\n百折风云地，诸艰社稷身。\n祇今渠畔柳，游客亦沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱大司空挽歌八首 其四","author":"于慎行","text":"缅想三朝事，声华似梦中。\n职分虞百揆，爵视汉三公。\n忼慨回天力，酸辛盖世功。\n惟馀秋陇上，萧瑟白杨风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱大司空挽歌八首 其五","author":"于慎行","text":"十载江皋卧，苍生望更频。\n如何三岛梦，忽断五湖春。\n南岳收真气，中朝失旧臣。\n尚方双赐履，犹觉上星辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱大司空挽歌八首 其六","author":"于慎行","text":"真宅归丹府，蓬壶第几城。\n化龙应是剑，跨鹤不闻笙。\n旧戟朱门列，新阡紫气萦。\n元公车服在，馀庆属玄成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱大司空挽歌八首 其七","author":"于慎行","text":"传道松台路，玄冬蜃卫张。\n期门分羽骑，温室出黄肠。\n日月悬天藻，螭龙护帝章。\n从今鹑火次，夜夜有光芒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朱大司空挽歌八首 其八","author":"于慎行","text":"凄凉知已报，旧事总堪愁。\n问字春风馆，传经夜月楼。\n十年违撰屦，一夕叹藏舟。\n惟有延陵剑，堪悬宰树秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浪迹","author":"于慎行","text":"浪迹长安陌，修途日以难。\n河流谁谓广，海水自知寒。\n懒嫚存愚性，婆娑耻贵官。\n春深湖上雨，何处少渔竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日寄题东郭草堂","author":"于慎行","text":"长忆青门郭，芳菲此日殷。\n花开三月雨，春隔万山云。\n夜鹤应谁怨，汀鸥且自群。\n主人有归梦，莫勒北山文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜舟行","author":"于慎行","text":"烟江三五夜，独月引行舟。\n野色推蓬合，波光进艇留。\n银蟾天上湿，乌鹊渚边愁。\n那听楼头笛，怀乡鬓欲秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仪真野泊","author":"于慎行","text":"潮平扬子渡，宿昔系扁舟。\n日落波光敛，天长岛色浮。\n雨侵依岸树，晴见隔江楼。\n咫尺分吴楚，茫茫万古愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"金陵江口夜泊","author":"于慎行","text":"孤舟江上宿，秋梦耿难成。\n片月中流影，千帆夜半声。\n地邻桃叶渡，山近石头城。\n倚舵闻吴咏，偏令旅思生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中家报","author":"于慎行","text":"泽国三千里，题书转自愁。\n乡心河畔草，客梦雨边舟。\n月落维扬夜，江深建业秋。\n归程应未远，时抚大刀头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"魏国东园宴集","author":"于慎行","text":"华馆开名会，高城倚落曛。\n林芳秋过雨，竹翠午侵云。\n洞夹平台入，桥通曲水分。\n太平多宴乐，胜地属元勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天界寺禅房呈讱庵棠轩二丈","author":"于慎行","text":"萧晨游法苑，迥眺出云峰。\n秋色霜前雁，寒声雨后钟。\n酒随陶令醉，谈许惠休从。\n何意风尘地，居然白社踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄仪庭司城邀集冯虚阁","author":"于慎行","text":"振衣山畔寺，载酒寺边楼。\n笛散千峰雨，砧传万井秋。\n地因邀月胜，人拟御风游。\n不尽萧森气，寒江正北流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月八日罗康洲宗伯黄仪庭司成田钟台宫谕习豫南司成会集朝天宫道院","author":"于慎行","text":"仙台邻上苑，路出冶城边。\n暝落珠宫雨，寒飞玉树烟。\n雁来秋水外，人醉菊花前。\n明日还重九，萸觞可更传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西园诸同年夜宴","author":"于慎行","text":"欢剧西园会，衔杯夜色前。\n池塘馀暮雨，竹柏净秋天。\n月出三山树，钟销九市烟。\n良游俱旧侣，把臂惜华年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南曹诸友邀游祖师堂","author":"于慎行","text":"融公栖隐处，遥在翠微巅。\n径折全无地，峰回半有天。\n鸟啼云洞雨，花散石堂烟。\n幸假登高会，同参最上禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"牛首东峰同诸君览眺","author":"于慎行","text":"两峰原自对，万壑远相萦。\n地尽芙蓉阁，岩开薜荔屏。\n江光天际白，山色雨中青。\n不浅凭阑兴，吴歌倚醉听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"青溪","author":"于慎行","text":"鸣珂传旧里，弥望总污莱。\n片雨湖边落，重桥苑外开。\n草荒江令宅，花覆陆机台。\n尚想风流地，空悲异代才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"房侍御邀登观音台","author":"于慎行","text":"杰观俯重台，烟波四望开。\n霞边千树没，杯底片帆来。\n霜月寒相射，云鸿暮转哀。\n滔滔大江水，到海几时回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"摄山夜宿予怀上人","author":"于慎行","text":"十年浑似梦，相见各依然。\n僧腊青山老，诗名白社偏。\n松间对微月，竹里听流泉。\n预怅明朝别，西风送客船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"摄山观无尽禅师入定","author":"于慎行","text":"师今方入定，胜果几时成。\n法向无空灭，心因不住生。\n湿灰犹示相，稿木可为形。\n恍忽莲台上，人天涌化城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"京口赠邬山人汝翼","author":"于慎行","text":"握手秋江上，依然旧布袍。\n十年燕市酒，八月广陵涛。\n侠骨贫逾健，狂歌醉正豪。\n不缘湖海遇，何地见风骚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"京口赠陈从训文学","author":"于慎行","text":"陈生何磊落，一剑向飘零。\n雅好词人赋，休传博士经。\n蘼芜春渚绿，薜荔旧山青。\n莫谓江天远，微垣现客星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"滁阳道中迟李棠轩年兄未至题书驿壁","author":"于慎行","text":"江楼三日别，相逐不相逢。\n回首秋山路，寒云隔几峰。\n乡心朝见雁，行色夜闻钟。\n何地还杯酒，应寻放鹤踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闰月朔日道中忆东园菊","author":"于慎行","text":"今年九月菊，应自敛芳菲。\n秋色未云暮，游子将欲归。\n系心霜露满，凝恨雁鸿稀。\n想到尊前见，寒香正点衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽中立宗侯四首 其一","author":"于慎行","text":"彼美银潢彦，名高鲁国儒。\n藏书淹四部，作赋侈三都。\n日瑩瑶台雪，天沉碧海珠。\n十年怀旧赏，肠断绿云孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽中立宗侯四首 其二","author":"于慎行","text":"谁言天路远，倏尔赋游仙。\n貌忆登龙日，神疑化鹤年。\n墨堂苔藓闭，画阁网丝悬。\n忍望邾城墓，萧萧宰树烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]