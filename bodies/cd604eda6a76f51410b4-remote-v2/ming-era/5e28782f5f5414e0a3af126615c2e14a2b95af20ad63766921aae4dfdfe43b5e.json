[{"title":"古像赞二百零五首 其三 神农","author":"孙承恩","text":"尝谷教民，爰制农事。\n爰有医药，民鲜疵厉。\n养生大端，惟皇之仁。\n泽流无穷，与天地均。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其四 黄帝","author":"孙承恩","text":"帝生神灵，卓冠首出。\n爰制器用，爰造律历。\n天地万物，范围曲成。\n混沌既分，渐登文明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其五 苍颉","author":"孙承恩","text":"上古淳朴，结绳以治。\n有圣者作，始立文字。\n贯彻三才，包括万象。\n通鬼神情，泄天地藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其六 少皞","author":"孙承恩","text":"制治感瑞，乐成大渊。\n以和神人，以通山川。\n淳朴未漓，去古未逖。\n九黎虽顽，莫损至德。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其七 颛顼","author":"孙承恩","text":"智疏以达，德深而静。\n肃清神人，民志以正。\n稽天创历，定时考元。\n夏令式遵，后圣善焉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其八 帝喾","author":"孙承恩","text":"惟德聪明，知远察微。\n执中御世，仁威并施。\n其德嶷嶷，其色郁郁。\n式修厥身，九有咸服。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其九 帝尧","author":"孙承恩","text":"配地博厚，并天高明。\n浑浑莫测，荡荡难名。\n百王之准，群圣之祖。\n日月光华，照彻九土。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其十 帝舜","author":"孙承恩","text":"大孝格天，玄德配帝。\n精一执中，圣学攸始。\n焕乎文章，巍巍成功。\n千万世下，仰瞻无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其十一 大禹","author":"孙承恩","text":"声律身度，左绳右矩。\n地平天成，功在万世。\n治存典则，道叙龟畴。\n稽首明明，示我大猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其十二 启王","author":"孙承恩","text":"启王令善，厥作惟君。\n伐叛饬治，休于前人。\n仁贤誉孚，遐迩承德。\n会朝万邦，光昭简册。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其十三 皋陶","author":"孙承恩","text":"盛德冠廷，伟绩迈世。\n飏言赓歌，陈谟赞治。\n明刑弼教，民用协中。\n风动之休，帝嘉汝功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其十四 后稷","author":"孙承恩","text":"洚水初息，民犹阻饥。\n粒食惟艰，帝用是咨。\n后稷勤民，爰教树艺。\n克配彼天，万世之利。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其十五 契","author":"孙承恩","text":"惟君作民，克绥厥猷。\n逸居禽兽，圣心所忧。\n尔契司徒，敬敷五教。\n牖民天衷，俗用熙皞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其十六 商汤","author":"孙承恩","text":"勇智天锡，宽仁性成。\n允执厥中，勋华是承。\n再辟天纲，复立人纪。\n盘铭之言，圣学之轨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其十七 商高宗","author":"孙承恩","text":"高宗穆穆，肇迹幽潜。\n恭默思道，精诚格天。\n奋伐僭虐，万邦是若。\n王灵濯濯，汤孙不怍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其十八 伊尹","author":"孙承恩","text":"耕莘乐道，升陑行义。\n堂堂天民，以觉斯世。\n主善协一，精义奥辞。\n百圣真传，庶其在兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其十九 傅说","author":"孙承恩","text":"道成傅岩，梦感帝赉。\n启沃数言，学术之大。\n辅德作圣，媲美烈祖。\n庶几阿衡，亦踵其武。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二十 泰伯","author":"孙承恩","text":"周室作兴，笃生圣嗣。\n子不难让，默识天意。\n去国之迹，泯于无形。\n可谓至德，民无得称。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二十一 伯夷","author":"孙承恩","text":"求仁得仁，去国如屣。\n叩马一谏，君臣大义。\n乾坤清气，萃子一身。\n独立万古，邈焉无伦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二十二 周文王","author":"孙承恩","text":"于穆文王，纯一不已。\n道接羲皇，重爻演义。\n神化无迹，至德不形。\n大哉乾元，穹然高明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二十三 武王","author":"孙承恩","text":"赫赫周武，巍巍大君。\n奉天伐罪，访道明伦。\n圣阐其化，皇立其极。\n于惟烝哉，万古承德。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二十四 成王","author":"孙承恩","text":"缉熙圣学，礼隆师臣。\n外抚万邦，内和兆民。\n坤阖乾开，春生秋杀。\n千古巍巍，式仰鸿烈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二十五 康王","author":"孙承恩","text":"恪慎明德，肃恭神人。\n迓天明威，勤咨老臣。\n礼乐陶镕，民俗丕变。\n唐虞太和，千载复见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二十六 周公","author":"孙承恩","text":"穆穆元圣，道光八夤。\n九罭颂德，重译归仁。\n思兼勤施，经制大备。\n太平之业，赉及万世。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二十七 召公","author":"孙承恩","text":"际时明良，弼亮四世。\n敬德之训，圣学斯契。\n公旦夹辅，翱翔两骖。\n甘棠遗爱，百世不谖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二十八 太公","author":"孙承恩","text":"尚父鹰扬，实维王佐。\n行义达道，拯民水火。\n辅德训告，厥有丹书。\n义利之言，万世莫渝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其二十九 管大夫","author":"孙承恩","text":"假仁图霸，尊王斥戎。\n民受其赐，圣与其功。\n治国长才，卓有令闻。\n四维之言，可以为训。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其三十 老子","author":"孙承恩","text":"履柔制刚，执虚御实。\n窥测消长，窃弄阖辟。\n恍惚莫象，变通无穷。\n孔圣所叹，其犹如龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其三十一 子产","author":"孙承恩","text":"郑国听政，贤者惟子。\n辞令之善，酬酢之智。\n以礼治国，诸侯莫加。\n君子道四，圣人所嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其三十二 吴季子","author":"孙承恩","text":"见礼知政，闻乐知德。\n观风列国，无子精识。\n让国全义，挂剑酬心。\n怀哉高风，无古无今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其三十三 孔子","author":"孙承恩","text":"道具太极，化行二气。\n统合群圣，参赞天地。\n删述垂宪，日星炳明。\n立我纲常，万世作程。\n天地非夫子，曷纬曷经。\n生民非夫子，曷范曷程。\n通天地人，为三才主。\n三才有终，夫子之道乃已。\n鲁用夫子，道亦小试。\n天用夫子，道济万世。\n鲁用非天，天用非鲁。\n卒老于行，天意可睹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其三十四 颜子","author":"孙承恩","text":"才优王佐，德跻圣域。\n既见卓尔，亦几无迹。\n明哲天纵，纯粹性成。\n发孔之蕴，后学式程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其三十五 曾子","author":"孙承恩","text":"道悟一贯，功密三省。\n大学一书，圣学要领。\n笃实之资，弘毅之德。\n易箦数言，可验学力。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其三十六 子游","author":"孙承恩","text":"所长擅科，知本之学。\n我思其人，简易宏廓。\n礼乐为政，弦歌成音。\n学道之论，实契圣心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其三十七 伍大夫","author":"孙承恩","text":"尽孝雪耻，竭忠死谮。\n忠孝之心，子则无恨。\n忍小就大，功立名成。\n古烈丈夫，史迁实评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其三十八 子思","author":"孙承恩","text":"学本心传，道原性命。\n唐虞授受，父师讲论。\n三十三篇，广大精深。\n继往开来，非子孰任。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其三十九 孟子","author":"孙承恩","text":"圣远道塞，异端并兴。\n岩岩子舆，三圣是承。\n命世大才，平治之具。\n用宁齐安，三代可致。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其四十 庄子","author":"孙承恩","text":"其心廓廓，其气浩浩。\n万古瞬息，八荒堂奥。\n厌薄仁义，狎侮孔周。\n曲说之雄，异端之尤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其四十一 屈大夫","author":"孙承恩","text":"薰莸殊器，泾渭异途。\n以子洁修，岂容群污。\n义合有权，子弗忍恝。\n此志皎然，争光日月。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其四十二 汉高祖","author":"孙承恩","text":"皇矣高祖，天锡神武。\n一剑兴戎，光登九五。\n坦乎其真，廓乎其容。\n包括英豪，范围之中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其四十三 项王","author":"孙承恩","text":"勇力拔山，猛气盖世。\n经营大业，谓可力致。\n倍义贼弑，攻略肆屠。\n灭德者凶，天亡匪诬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其四十四 汉文帝","author":"孙承恩","text":"穆穆太宗，躬修玄默。\n抚世以柔，化民以德。\n其俗肫肫，其功泯泯。\n三代之后，孰如帝仁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其四十五 汉景帝","author":"孙承恩","text":"帝也维贤，克遵先志。\n谦恭俭朴，恪守无替。\n轻刑薄税，民俗阜康。\n比隆成周，汉道以昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其四十六 汉武帝","author":"孙承恩","text":"盛气当阳，雄才御世。\n嘉乐唐虞，狭小汉制。\n振举百度，征伐四裔。\n烨烨明明，恢我王治。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其四十七 汉宣帝","author":"孙承恩","text":"中宗强明，励精图治。\n布德振威，柔远能迩。\n皇灵赫奕，呼韩来庭。\n配商高宗，汉道复兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其四十八 萧酂侯","author":"孙承恩","text":"佐时兴王，根本重任。\n式赞治平，画一之政。\n谦谦其退，翼翼其恭。\n一代元臣，高朗令终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其四十九 张留侯","author":"孙承恩","text":"报韩徇义，辅汉乘时。\n诛秦蹙项，从容指挥。\n功成身退，愿追赤松。\n大雅卓识，令名无穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其五十 韩淮阴侯","author":"孙承恩","text":"定伯雄图，登坛数辞。\n用兵制胜，霆击风驰。\n成功既高，执义亦固。\n忘期赤松，英雄悔悟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其五十一 曹静侯","author":"孙承恩","text":"少而才能，豪吏健将。\n晚而谦恭，醇德雅量。\n清净为治，刻深匪名。\n配萧并贤，百世尔称。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其五十二 董江都","author":"孙承恩","text":"秦火初熄，典籍尚湮。\n子也杰出，倡始斯文。\n独抱麟经，潜心大义。\n天人三策，治道攸寓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其五十三 东方朔","author":"孙承恩","text":"傲忽玩世，浮沉随时。\n不清不和，匪惠匪夷。\n滑稽自贤，俳优是视。\n讽谏时益，吾差有取。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其五十四 司马迁","author":"孙承恩","text":"博极群书，综统千古。\n豪气孤骞，阔视无伍。\n发为文章，凌高厉空。\n一代奇才，史学之宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其五十五 霍博陆侯","author":"孙承恩","text":"子孟忠实，顾命是承。\n光辅幼帝，赞治太平。\n屹然如山，不震不侧。\n废昏立明，功著汉室。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其五十六 扬子云","author":"孙承恩","text":"扬子好学，研精覃思。\n法言僻涩，太玄深奇。\n著述良勤，拟圣则缪。\n美新何为，名节斯疚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其五十七 汉光武","author":"孙承恩","text":"白水龙兴，光膺宝历。\n日月重明，乾坤再辟。\n慎德勤政，身致太平。\n巍巍成功，匹休西京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其五十八 汉明帝","author":"孙承恩","text":"于惟显宗，亦世其烈。\n宪章慎守，幽枉必雪。\n崇儒养老，文教聿兴。\n增光前人，汉道允升。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其五十九 汉章帝","author":"孙承恩","text":"肃宗恺悌，长者之风。\n政厌苛刻，论从雍雍。\n综缉艺文，服膺帝道。\n厚泽深仁，简册有耀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其六十 严子陵","author":"孙承恩","text":"名节丘山，轩冕尘壒。\n怀仁负义，蕴畜亦大。\n汉室九鼎，桐江一丝。\n凛然清风，悠悠我思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其六十一 邓高密侯","author":"孙承恩","text":"杖策从君，际时风云。\n少年秉钺，克树大勋。\n将略既优，内行亦备。\n名高云台，光辅汉治。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其六十二 马伏波","author":"孙承恩","text":"君择臣使，臣择主从。\n舍彼虺蝮，来依真龙。\n西伐南征，老志愈烈。\n铜柱高标，人仰英杰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其六十三 郭有道","author":"孙承恩","text":"贞不绝俗，隐不违亲。\n言论风旨，贤愚倾心。\n和不辱身，巽不降志。\n我惟其人，夷惠之似。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其六十四 徐孺子","author":"孙承恩","text":"徐子高士，居贫食力。\n贞介益固，明哲允迪。\n君子道丧，群邪煽凶。\n我怀其人，冥冥飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其六十五 蔡中郎","author":"孙承恩","text":"孝行纯备，经学邃深。\n旷世逸才，博物洽闻。\n箴规时政，忠谠恳恻。\n晚节依违，贤者之惜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其六十六 汉昭烈帝","author":"孙承恩","text":"贤矣昭烈，宽厚弘毅。\n崎岖立国，仗信履义。\n推诚任贤，肝胆孚契。\n顾命数词，可训后世。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其六十七 诸葛武侯","author":"孙承恩","text":"文武长才，出处大义。\n俊伟光明，掀揭天地。\n伊吕作配，管晏匪伦。\n三代之后，惟公一人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其六十八 关寿亭侯","author":"孙承恩","text":"勇若一国，敌号万人。\n义气忠肝，贯日凌云。\n英威所加，华夏震仰。\n百世钦崇，神留天壤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其六十九 张翼德","author":"孙承恩","text":"姿貌瑰奇，才具粗猛。\n神矛飙发，万众独骋。\n委质授命，死生靡他。\n国士之风，百世尔誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其七十 魏太祖","author":"孙承恩","text":"老瞒奸雄，才具明略。\n威加海宇，力振山岳。\n魏业巳固，汉鼎潜移。\n比迹文王，吾将谁欺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"古像赞二百零五首 其七十一 钟太傅","author":"孙承恩","text":"元常伟才，开达理干。\n委身魏朝，禆益庙算。\n拳拳肉刑，复古之规。\n纷纷之言，迄无所归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]