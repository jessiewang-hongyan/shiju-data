[{"title":"秋江独钓图 其二","author":"郑真","text":"桐江东望水滔滔，千古风流梦寐劳。\n汉室中兴功莫比，云台未似钓台高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋江独钓图 其三","author":"郑真","text":"白月黄昏听唱歌，沙头人问得鱼多。\n纷纷世事尘迷眼，烟水生涯可奈何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋江独钓图 其四","author":"郑真","text":"家近瀛洲海上滩，渔灯共语夜阑珊。\n三年远作淮山客，秖欲归来把钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题春江送别图","author":"郑真","text":"画船江水漾晴空，迭迭云山锦绣中。\n冠佩入朝宫阙近，莺花三月正春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题宣和重楼合喜图 其一","author":"郑真","text":"乌雀春喧喜事重，天香国色倚东风。\n宫车北望滦阳去，锦绣繁华一梦中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题宣和重楼合喜图 其二","author":"郑真","text":"艮岳当年御辇游，花神有意结重楼。\n谁知天上春风乐，翻作青城一段愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题敬义斋卷 其一","author":"郑真","text":"肃襟清坐自惺惺，玩易焚香倚石屏。\n一片灵台明似镜，天光云影对空青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题敬义斋卷 其二","author":"郑真","text":"青青编简炫春晖，表里工夫世所希。\n妙悟不烦频出户，满街尘土污人衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题敬义斋卷 其三","author":"郑真","text":"别来久不见山阴，想象高秋玉雪襟。\n大手文章劳撰述，百年复见圣贤心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"二月望日潘太守劝农赋绝句用韵","author":"郑真","text":"拍拍清樽绿蚁酣，珍分列鼎饫肥甘。\n太平共此春风乐，笑指天香满翠篮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题欧阳率更九成宫碑赠南昌万玉麟先生来淮海以诗名有子名孟雅知临淮县以实封论事升知泗州云","author":"郑真","text":"洪都仙客佩玲玲，淮海归来双眼青。\n笑指囊中无长物，逢人许看醴泉铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送永嘉支师中分教入京 其一","author":"郑真","text":"千里长淮共驿船，碧空如水水如天。\n即今又送还京去，五色龙光近御前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送永嘉支师中分教入京 其二","author":"郑真","text":"盛时多士出成均，芸屋青灯教席分。\n自有文章成锦绣，殿头释褐奉明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洪贾许索芭蕉作四绝以致意贾府通判尊翁洪府同知尊翁也 其一","author":"郑真","text":"故园曾忆种芭蕉，长日熏风一扇摇。\n爱向淮南分别种，夜深凉雨听潇潇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洪贾许索芭蕉作四绝以致意贾府通判尊翁洪府同知尊翁也 其二","author":"郑真","text":"江南欲寄一椷书，想象清秋午梦余。\n千里客乡风雨候，清清还看绮窗虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洪贾许索芭蕉作四绝以致意贾府通判尊翁洪府同知尊翁也 其三","author":"郑真","text":"天浆滴滴似凝脂，曾看芳葩启瓣时。\n璇宇星稀天欲曙，一杯儗送玉琳璃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洪贾许索芭蕉作四绝以致意贾府通判尊翁洪府同知尊翁也 其四","author":"郑真","text":"浅浅晴泥手欲栽，悬知生意是生荄。\n青旗半卷丹心吐，有待山翁跨鹿来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画梅","author":"郑真","text":"来看南枝与北枝，溪头立雪思离离。\n逢人若问调羹事，须待青青着子时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒夜二绝句简徒县丞 其一","author":"郑真","text":"竹屋寒烧榾柮烟，先生高卧腹便便。\n淮南为问江南客，何似山中夜雪天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒夜二绝句简徒县丞 其二","author":"郑真","text":"淮海风高雁鹜呼，客窗夜半拨寒炉。\n小儿试向灯前问，曾有先朝鸽炭无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画送陈驿丞 其一","author":"郑真","text":"锦绮云霞盼九重，故人来到且从容。\n大材正要为梁栋，笑指桥南百尺松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画送陈驿丞 其二","author":"郑真","text":"奎星高照海天涯，万里车书正一家。\n黼座云开丹陛近，春风顾插御筵花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题梅花","author":"郑真","text":"风流不见琼妃面，欲寄多情语未工。\n山鹤一声天欲晓，寒香浮动月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题陈仲良所藏姚马图","author":"郑真","text":"献凯归来汗血流，将军万里已封侯。\n长安新置飞龙厩，奈汝西风苜蓿秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答夏威原绝句十首 其一","author":"郑真","text":"九重天子正兴文，多士趋朝日见亲。\n谩说黄公华胄在，商山重认采芝人。","collection":"明","notice":"