[{"title":"东庄十八景为匏庵先生赋 其十 振衣冈","author":"吴俨","text":"上冈振衣尘，下冈恐还有。\n不识冈上头，能容结茅否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14423,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东庄十八景为匏庵先生赋 其十一 曲池","author":"吴俨","text":"流水萦林外，回波绕槛前。\n天光与云影，不得直相连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14424,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东庄十八景为匏庵先生赋 其十二 艇子浜","author":"吴俨","text":"垂杨夹古岸，容我寄轻舠。\n莫向江湖里，惊风挟怒涛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14425,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东庄十八景为匏庵先生赋 其十三 紫芝丘","author":"吴俨","text":"青青丘陇上，晔晔紫芝芳。\n众草惊秋色，云根不著霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14426,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东庄十八景为匏庵先生赋 其十四 折桂桥","author":"吴俨","text":"仙桂从谁折，桥名是处传。\n人言吴季子，家住水东边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14427,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东庄十八景为匏庵先生赋 其十五 全真馆","author":"吴俨","text":"家近神仙宅，苍松一径遥。\n閒来弄泉石，无意问参寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14428,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东庄十八景为匏庵先生赋 其十六 续古堂","author":"吴俨","text":"古人已云徂，今人思继武。\n应知后来人，要以今为古。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14429,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东庄十八景为匏庵先生赋 其十七 耕息轩","author":"吴俨","text":"日暮荷锄归，就此轩上息。\n西畴犹未耕，迟我养馀力。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14430,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东庄十八景为匏庵先生赋 其十八 鱼乐亭","author":"吴俨","text":"煦煦依浮藻，遥遥避钓钩。\n濠梁隐君子，知乐不知愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14431,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄俦弟","author":"吴俨","text":"故国青山好，春来梦不真。\n去家虽太近，犹是未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14432,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题陶知州菊庄","author":"吴俨","text":"爱菊因投绂，柴桑亦任真。\n谁知千载后，复有姓陶人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14433,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻李健斋斫窗前双桐诗以唁之","author":"吴俨","text":"斫却青桐树，墙根自少阴。\n流金日应铄，何物助清吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14434,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题扇","author":"吴俨","text":"茅屋藏深树，柴门对远山。\n主人多不出，杖屦得常閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14435,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宿安平驿","author":"吴俨","text":"昔年逢险厄，今夜宿安平。\n流水船前过，微风树底生。\n入云孤鸟影，隔岸一蝉声。\n追忆樯倾日，中宵梦亦惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14436,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集天趣园二首 其一","author":"吴俨","text":"高丘构华屋，物理近人情。\n止水留云影，微风度鸟声。\n委泥花有恨，匝地草无名。\n欲试登山屐，崎岖路不平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14437,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"集天趣园二首 其二","author":"吴俨","text":"爱客频移席，张筵复傍池。\n酒行常引满，坐久不知疲。\n风动花增媚，云开石献奇。\n休文才最富，无藉雨催诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14438,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游观音阁二首 其一","author":"吴俨","text":"石壁临无地，江流激有声。\n樯乌依岸宿，水鸟避人行。\n日度松阴转，风来暑气平。\n要知形胜在，历历问山名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14439,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游观音阁二首 其二","author":"吴俨","text":"极目江波阔，惊心沙岸摧。\n倚岩谁搆阁，断石自封苔。\n水鸟随潮去，风帆逆浪来。\n江山千古恨，尽付掌中杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14440,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄堵乐耕 其一","author":"吴俨","text":"两地无千里，谁能忆旧游。\n李邕归北海，徐稚卧南州。\n月出微云敛，风来宿雨收。\n羡君双足健，独上水西楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14441,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄堵乐耕 其二","author":"吴俨","text":"路僻书难寄，官閒客亦稀。\n卧听黄鸟哢，伫看白云飞。\n月暗燃藜杖，风轻换葛衣。\n南来才一月，无日不思归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14442,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠瀚侄 其一","author":"吴俨","text":"白屋无遗业，青年自立家。\n众皆称汝俭，我独恶人奢。\n客到惟供茗，春来不种花。\n有田仍负郭，著意树桑麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14443,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠瀚侄 其二","author":"吴俨","text":"春夜寒犹峭，门前雪更深。\n老予尝独坐，谢子远相寻。\n共说耕田乐，能谙聚族心。\n大家聊自足，何用积黄金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14444,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送引之黄门两广勘事","author":"吴俨","text":"一别成万里，此怀良黯然。\n鸟声人语杂，山色水光连。\n禦瘴常携药，调琴更解弦。\n清风盈两袖，千古激贪泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14445,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送程瑶","author":"吴俨","text":"一夕金风动，飘然振客衣。\n自知秋尚早，又逐燕先归。\n水落江流急，天寒树影稀。\n独怜城上月，不减旧清辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14446,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"别春","author":"吴俨","text":"九十春光尽，如君惜别何。\n树头花片少，林外鸟声多。\n抚景频移席，怡云独放歌。\n明年知此日，还向客中过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14447,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次师惟明韵","author":"吴俨","text":"西湖岸东畔，上有故人居。\n会数常凭梦，情真少寄书。\n直钩聊作钓，大泽岂忧鱼。\n试问寒潭月，年来虚不虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14448,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻三弟移居城中喜作","author":"吴俨","text":"城郭依青嶂，门墙带碧流。\n出游无十里，来往有孤舟。\n虾菜随时具，诗书不远求。\n已闻开小阁，何必更高楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14449,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书李时馨扇","author":"吴俨","text":"初夏天犹冷，疏帘日渐长。\n读书穷壸奥，问字识偏旁。\n对案常忘食，抠衣屡上堂。\n取青如拾芥，老我有馀光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14450,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题沈克寅扇","author":"吴俨","text":"功名无捷径，学问有阶梯。\n夜寝常看月，晨兴每听鸡。\n要从年少日，思与古人齐。\n老我犹看镜，衰年更噬脐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14451,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题林廷振扇","author":"吴俨","text":"前舟泊沙汀，早发不相待。\n岸口树阴多，天边风色改。\n抚几对青山，何须更沧海。\n同时采珠人，今有几人在。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14452,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"北望","author":"吴俨","text":"烟火千家瘴，霜风十月天。\n群臣不从驾，八骏自巡边。\n日落孤城远，云低朔漠连。\n翠华何日返，黔首得安眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14453,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朝天宫习仪回道中口占一首","author":"吴俨","text":"翠华前日出，戎辂几时还。\n绵蕞依穷塞，嵩呼出远山。\n云迷青琐闼，月照玉门关。\n汉槛嶙峋在，凭谁许一攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14454,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"船窗对月","author":"吴俨","text":"船窗看月出，光彩射人眸。\n水底鱼龙避，林间魍魉愁。\n影分云外树，波动驿边楼。\n五月江湖上，萧然似早秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14455,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李司徒","author":"吴俨","text":"南国佳山水，悤悤未遍游。\n栖霞聊试屐，静海暂停舟。\n道梗谁能进，身轻不用忧。\n劝公无入险，一月住扬州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14456,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送万生润","author":"吴俨","text":"至日关将闭，明朝客欲归。\n一身依棘寺，百里问庭闱。\n水落溪声静，霜寒树影稀。\n故乡如问我，老病不胜衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14457,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻渡江诸亲遇险惊叹有作","author":"吴俨","text":"记得江头别，悤悤又一年。\n船开官渡口，帆落寺门前。\n不守垂堂戒，翻思彼岸悬。\n近传消息到，令我意茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14458,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送唐黄门","author":"吴俨","text":"国计劳神算，边储辍从臣。\n回头青琐近，随路綵衣新。\n庾岭风迎节，清湘月照人。\n此行成万里，樽酒莫辞频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14459,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄王子麟潘惟乔","author":"吴俨","text":"扁舟君送我，恨不送君还。\n雨过添新水，云飞恋旧山。\n客窗长畏病，宦辙几能閒。\n双骑何时到，秋风为启关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14460,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次匏庵先生煨橘韵","author":"吴俨","text":"白雪枝头蕊，黄金叶底团。\n既疑为火齐，复认作冰丸。\n冷热随时改，调和适口难。\n炉中方就灼，掌上复传看。\n软比鸡头肉，圆如鹤顶丹。\n瓤虚还可剖，核小岂容钻。\n追念致来远，还怜味带酸。\n殷勤重乡味，常贮水晶盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14461,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元宵应制二首 其一","author":"吴俨","text":"一年好景上元多，又送春声到踏歌。\n灯照九衢通禁苑，月明双阙近银河。\n虹桥影里龙旗动，琪树阴中凤辇过。\n欢乐不忘民疾苦，皇华远近布阳和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14462,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元宵应制二首 其二","author":"吴俨","text":"玉宇璚楼入望赊，五云长护帝王家。\n鱼龙出没灯前戏，桃李芬菲火底花。\n凤吹声低风力细，云和奏罢月轮斜。\n儿童未识升平象，笑指祥光作晓霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14463,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"国贤宪副见寄次韵二首 其一","author":"吴俨","text":"留都无处不堪游，何独鸡鸣与覆舟。\n澹澹烟笼淮水月，疏疏雨送秣陵秋。\n城边好景看将遍，野外荒祠吊未周。\n已约词林诸老宿，肩舆九月上牛头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14464,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"国贤宪副见寄次韵二首 其二","author":"吴俨","text":"散地偏宜著菲才，清时谁合过江来。\n庭前趁雨移松柏，屋后先秋去草莱。\n纪德谩寻前代石，读书还忆旧时台。\n故人相去无多路，时见虹光烛上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14465,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻石田游荆溪欲观予所藏小画以诗迎之","author":"吴俨","text":"画船未泊五云溪，信息先传满邑知。\n花渐飘零愁置酒，鸟犹啁哳苦催诗。\n莫忧震泽波涛阔，须信南宫笔画奇。\n自扫水边山下路，候公杖屦欲追随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14466,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次石田观画韵","author":"吴俨","text":"锦标玉轴家家重，任耳人多任目稀。\n鉴藻要知颠末在，丹青只论古今非。\n山居幽寂柴门迥，溪渚萧条野鹜飞。\n忽忆平南渡江日，仓黄七帖尚藏衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14467,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"予庄晚步","author":"吴俨","text":"扶筇閒步洛桥东，水色山光迥不同。\n黄鸟引雏青嶂外，绿杨倒影碧波中。\n分秧日近愁无雨，刈麦时来喜有风。\n造物可随人意变，较量笑杀两邻翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14468,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和杨少宰孪子韵","author":"吴俨","text":"屋头不用听灵乌，闻得家人笑语呼。\n夜半灯花长一尺，朝来日影射双弧。\n蓝田种就连城璧，沧海生成照乘珠。\n家学渊源知有自，勿愁参鲁与柴愚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14469,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送周生楷","author":"吴俨","text":"千里寻师到石头，思乡忽上仲宣楼。\n道逢二鸟人争羡，赋就三都志未酬。\n江上芙蓉花试雨，岸边杨柳叶惊秋。\n归帆好趁东风便，昨夜高堂梦远游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14470,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李府丞乃兄某","author":"吴俨","text":"新年莫恨客中过，未有春风到薜萝。\n池草自成非梦得，塞鸿行断奈愁何。\n今宵对月同尊酒，明日中流起棹歌。\n千里相思定何处，夜深独卧翠岩阿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14471,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次东园先生除夕韵","author":"吴俨","text":"爆竹声残夜未央，六阴极处转三阳。\n羲和自有无穷意，凤历因留不尽行。\n去国两年犹昨日，县家百里亦他乡。\n换符祀灶聊随俗，自叹閒官反学忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14472,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送马太守还任","author":"吴俨","text":"儿童竹马候江边，行路人歌太守贤。\n淮海两堧皆赤地，合肥一郡自丰年。\n甘棠树底还听讼，绿柳阴中复课田。\n太史续书循吏传，芳名合置李离前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14473,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次东园先生斋居韵","author":"吴俨","text":"东园新竹有新居，五月长斋此屋庐。\n画省喜瞻红日近，碧山怅望翠屏虚。\n心存国计纡筹策，道在吾身任卷舒。\n宾客到门俱有意，案头勿著绝交书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14474,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次东园先生春雪韵","author":"吴俨","text":"雪花如掌暗长衢，绿树妆成白玉株。\n属国一心惟在汉，将军中夜已平吴。\n忍寒独立阶前鹤，攫食群飞野外乌。\n冻砚连朝未消释，诗翁莫怪有新逋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14475,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送孙少卿","author":"吴俨","text":"殿头供奉老鸿胪，心欲求閒过旧都。\n月请俸钱真不薄，春游山水自堪娱。\n礼成为奏三年绩，家近浑无百里途。\n明日玉阶仙仗外，也应随众效嵩呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14476,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭太皇太后次郑亚卿韵二首 其一","author":"吴俨","text":"地维将缺莫能支，哀诏函封下玉墀。\n任姒德音堪继续，高曹家法可差池。\n外廷不与当时政，中壸还留旧日仪。\n夜夜长秋宫里月，清光惨澹似凝思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14477,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭太皇太后次郑亚卿韵二首 其二","author":"吴俨","text":"万金方药竟难支，臣庶悲号望赤墀。\n长乐春归花满地，影娥人散月当池。\n一朝奄弃三宫养，百世长存九嫔仪。\n圣子神孙哀罔极，春来秋去不胜思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14478,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"环山楼为陈太仆瑞卿作","author":"吴俨","text":"滁阳新起见京楼，楼外青山绕四周。\n春意自催禽鸟乐，浮云不记古今愁。\n树笼月色千家暝，松度风声万壑秋。\n莫道诸峰能掩闭，举头西望是皇州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14479,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿包太守父八十","author":"吴俨","text":"池阳太守年六十，犹有八旬翁在堂。\n白发还为稚子舞，斑衣自学老莱装。\n松高百尺根如铁，菊至重阳花更黄。\n远我不随宾客后，双溪同进紫霞觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14480,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送韩司徒","author":"吴俨","text":"君命临门不敢稽，岁朝就道尚嫌迟。\n春风前引朝天佩，冬日还留去国思。\n西北军兴常告乏，东南民力又堪悲。\n司徒自有生财道，谁谓时艰未可为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14481,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽伏羌伯","author":"吴俨","text":"竹帛曾书大将功，百年威望重西戎。\n战酣塞上云连地，敌退辕前草偃风。\n禦侮自来三策在，杀身曾有几人同。\n至今血染山头石，雨洗年深色更红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14482,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿林廷振","author":"吴俨","text":"平市街东第一楼，主人虽老尚风流。\n六旬下寿明年是，十二同庚与宴不。\n歌吹忽惊梁上燕，起居无藉杖头鸠。\n凤雏稛载来江右，一笑能消万斛愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14483,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿都景章八十","author":"吴俨","text":"已到磻溪感梦时，何心更慕帝王师。\n曾逢仙授长生诀，每遇人吟遣兴诗。\n囊里有钱堪买酒，镜中无发可成丝。\n高年谁似翁强健，日日登临力未衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14484,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次吕太常赏牡丹韵","author":"吴俨","text":"浅红深绿自相承，妆靓何劳粉黛凝。\n种自洛阳城里乞，诗从长庆后来增。\n若誇国色应无敌，欲殿春光恐未能。\n只此尚嫌花富贵，不须更染碧金棱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14485,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"侍家君游牛首登兜率崖次青溪韵","author":"吴俨","text":"老大登临兴尚豪，远随杖屦竟何劳。\n道傍雨洗松根瘦，树杪云连石笋高。\n僧爱孤虚新起阁，鸟嫌峻极不营巢。\n为休足力频思坐，欲问青天首屡搔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14486,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次前韵荅吕太常","author":"吴俨","text":"公负诗中一世豪，朝吟暮咏未言劳。\n衰年莫作青年看，小隐还输大隐高。\n夜静灯残蛾扑火，春归花落燕争巢。\n细评物理应长叹，短发萧萧不耐搔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14487,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送魏都宪","author":"吴俨","text":"奉敕江南仅两年，蜚声已达冕旒前。\n何人为补中丞缺，此日还将旧政传。\n贪贿吏惊先解绶，弄兵人散欲耕田。\n愿公为国持三尺，一岁官应见几迁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14488,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送邦彦学士先生二首 其一","author":"吴俨","text":"散地偏于懒性便，我来君去思悠然。\n出门是处成三昧，视日何人记八砖。\n夜静月移花影乱，春深风度鸟声圆。\n而今每忆当年乐，始信瀛洲别有仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14489,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送邦彦学士先生二首 其二","author":"吴俨","text":"朝阳门不比春明，别远无过是两京。\n名姓尚留东观在，官衔不减北扉清。\n船从白鹭洲边过，马向乌衣巷口行。\n冠盖几人来送别，独予南望不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14490,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]