[{"title":"新移芍药台上","author":"唐伯元","text":"花台春烂熳，芍药可谁同。\n旧蕊交新蕊，深红间浅红。\n妍堆酣晓露，力困倚微风。\n开谢寻常事，浮生信转蓬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16721,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采芳亭喜传长孺同舍至共观芍药因话二顾 其一","author":"唐伯元","text":"采采芳亭伴，采芳亦采真。\n不禁花解语，况对玉为人。\n野筑明星迥，莺声出谷新。\n忽闻过二顾，飞动更须论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16722,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采芳亭喜传长孺同舍至共观芍药因话二顾 其二","author":"唐伯元","text":"二顾何翩翩，耽玄近可怜。\n青云还我贵，白眼好情偏。\n见面从君过，无书只信传。\n宁知花坞里，吏隐亦逃禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16723,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大司马叶丈大中丞周丈同时被谤奉留有寄","author":"唐伯元","text":"司马勋名宇宙间，中丞镇静万人欢。\n遥传塞外空豺虎，共说军中有范韩。\n箧满谤书增倚重，天扶明圣惜才难。\n即看河套天王地，乘胜长驱破可汗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16724,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大司马丈量移南司空屡疏乞归不允忽报大捷喜而集杜","author":"唐伯元","text":"闻道河阳近乘胜，初闻涕泪满衣裳。\n苍花不晓神灵意，扶颠始知筹策良。\n殊锡曾为大司马，老儒不用尚书郎。\n朝廷衮职谁争补，正想氤氲满眼香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16725,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"司马丈乞身未允闻已南归集杜遥寄","author":"唐伯元","text":"想见归怀尚百忧，何时更得曲江游。\n十年戎马暗南国，万里烽烟接素秋。\n可念此公怀直道，焉知李广未封侯。\n杖藜叹世者谁子，天入沧浪一钓舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16726,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周中丞再疏乞归自缙神官军而下号留不已集杜却寄","author":"唐伯元","text":"拖玉腰金报主身，莫云江汉有垂纶。\n扁舟不独如张翰，河内尤宜借寇恂。\n独使至尊忧社稷，早闻黄阁画麒麟。\n致君尧舜须公等，归赴朝廷已入秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16727,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日与诸曹友同登显灵宫阁","author":"唐伯元","text":"高阁崚层俯建章，况逢佳节又重阳。\n秋声不入游人耳，紫气浮来满帝乡。\n发短更苍堪帽落，客多同调趁花忙。\n明年此会知何处，遍插茱萸遍举觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16728,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采芳亭承南罗二长官见招赏菊集诸曹友为补重阳之会","author":"唐伯元","text":"大隐于今混庙廊，翩翩同舍共亭芳。\n深林夕照明栖鸟，曲径人疑绕洞房。\n恼杀黄花仍五色，簪看绿鬓赛重阳。\n谁知玉露凋伤后，更向疏篱作意香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16729,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和任宪使枉驾南岩兼纪湖堤新成","author":"唐伯元","text":"寻花问柳傍湖西，公暇何妨客共携。\n柳色晴娇骢马道，花香春砌长公堤。\n洞穿竹径高低合，人似桃源咫尺迷。\n自有丹梯生羽翼，不须僧话證菩提。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16730,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青居书所见","author":"李良柱","text":"四边闻水声，顿觉烦暑销。\n垂杨何袅袅，引风吹征轺。\n沿溪白石乱，断岸忽通桥。\n居者安耕凿，不知城市嚣。\n我来聊问俗，两两三三樵。\n官语不解听，去去不可招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16731,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜期周比部不至","author":"李良柱","text":"春早尚奇寒，同云雪未残。\n红尘销绮陌，玉树满长安。\n对酒歌黄竹，怀人采杜兰。\n明朝趋大祀，时向夜深看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16732,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灯夕同王宪副周比部话别","author":"李良柱","text":"谈天誇碣石，放夜喜新丰。\n贳酒来冬白，传柑荐海红。\n滇池看去马，桂管有征鸿。\n云省周郎远，深杯话未终。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16733,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郑别驾督饷还松江 其一","author":"李良柱","text":"片帆冲晓发，极目乱蒹葭。\n河上冰应合，风前雁故斜。\n吴侬歌白苧，粤客醉梅花。\n到问云间日，江鲈味正嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16734,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郑别驾督饷还松江 其二","author":"李良柱","text":"相对西山雪，离筵酒意浓。\n几陪趋紫阙，今独泛青龙。\n已副留恂愿，还追字郑踪。\n凤凰明月夜，应亦念疏庸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16735,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜林秋兴 其一","author":"李良柱","text":"曲径驯来鸟，长空任去雕。\n孤亭斜带郭，一水细通桥。\n鸿雁天边急，蒹葭望里凋。\n讼庭人吏散，时且读逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16736,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜林秋兴 其二","author":"李良柱","text":"馀容且莫赠，聊以赠文无。\n日落西风急，天空北斗孤。\n尊前珍橘柚，佩里竞茱萸。\n谁遣高楼笛，吹来月满湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16737,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"镜林秋兴 其三","author":"李良柱","text":"三秋凋玉露，一叶下银床。\n把菊怜同气，看云总异乡。\n敲诗嫌韵险，射覆引杯长。\n砧杵催残月，斜辉没女墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16738,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"韩信城","author":"李良柱","text":"不学淮阴母，难同张子房。\n本为真国士，何用假齐王。\n古庙临流水，荒城锁夕阳。\n断碑零落尽，千古叹弓藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16739,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中苦雨留李太守","author":"李良柱","text":"海立鼋鼍出，同云六月寒。\n蚁封何日启，鹳井不时看。\n五马冲泥至，双尊把袂欢。\n雨工亦太横，行路总嗟难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16740,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"人日登大观楼","author":"李良柱","text":"春晴惟七日，登眺兴应饶。\n残白留梅萼，新青到柳条。\n水光侵绮席，楼势逼丹霄。\n正好寻诗景，重来不费招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16741,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李户曹还金陵兼报最 其一","author":"李良柱","text":"把酒听金缕，扬帆指石头。\n天空低远树，海阔隐孤舟。\n恋阙丹心壮，浮淮白雪优。\n秣陵明月夜，应亦念同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16742,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李户曹还金陵兼报最 其二","author":"李良柱","text":"一片关河月，能牵万里情。\n黄花开酒色，白雁送秋声。\n报政司农最，含香汉署荣。\n淮扬愁苦状，早得幸承明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16743,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安春兴 其一","author":"李良柱","text":"自是天边雨露滋，上林种种品题奇。\n佳人拾翠朝云合，公子乘黄春槛移。\n取醉且须论薏苡，引年何必问松芝。\n双柑斗酒听莺兴，应笑山翁倒接䍦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安春兴 其二","author":"李良柱","text":"乐游原外雪初晴，色换千林鸟乱鸣。\n迟日看花驱绿耳，少年结客薄青萍。\n森森织柳迎梅雨，处处催耕布谷声。\n一自圣明躬籍后，都人指点说升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安春兴 其三","author":"李良柱","text":"徇名徇义一身轻，燕赵豪雄故有声。\n走马斗鸡诸贵业，雕柑镂蛤五侯鲭。\n西山爽气朝来散，北极彤云日下生。\n退食自公惭浅术，綍纶何以答承明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安春兴 其四","author":"李良柱","text":"十年通藉侍神尧，汉署怀香几赐貂。\n银鹘不传清朔漠，金泥屡出宠嫖姚。\n御沟流水销残冻，禁柳迁莺啭弱条。\n正说大官初尚膳，忽闻仙乐下云霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陆山人时馆临淮侯宅","author":"李良柱","text":"底事长安慰索居，莲花池里醉屠苏。\n龙门此日登元礼，狗监何时荐子虚。\n江上久知成隐鹄，尊前谁叹食无鱼。\n五陵结客风流远，应是多回长者车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郝将军督饷云中","author":"李良柱","text":"飞将翩翩出蓟燕，军储十万转输边。\n队经马邑桑乾水，猎向金微鸊鹈泉。\n晓角故残乡国梦，秋风长散玉门烟。\n轻裘自有羊开府，银鹘于今久不传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"省中齐夕同司马年兄咏雪","author":"李良柱","text":"画省森沉静柏乌，欲谈翻觉解围无。\n五轮沙漏传银箭，六出天花点玉壶。\n倦去且看司马赋，渴来想入步兵厨。\n悬知后夜升中际，历历榆光片月孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王台道中","author":"李良柱","text":"路转三华雪正残，春回旭日照林峦。\n刀耕叠巘悬飞溜，水碓孤村据要滩。\n天外七台千丈峭，人间万网一时宽。\n皇华满目催行色，时向延津把剑看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将乐壬午元旦午梦","author":"李良柱","text":"恋阙嵩呼使礼成，五云偏向蓟门明。\n先春柏叶深深把，送腊梅花片片清。\n生杀恐归蕉鹿幻，驰驱都付雪鸿情。\n惊回一枕三华梦，已遍江南万里程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日卢方伯六合楼宴集","author":"李良柱","text":"仙人元自爱楼居，缥缈雕甍倚太虚。\n袅袅千丝陶令柳，辉辉万轴邺侯书。\n樽前雅量难高下，天外浮云任卷舒。\n紫蟹黄鲈都入馔，相逢谁谓食无鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春祀歌 其一","author":"李良柱","text":"都人倾耳候朝钟，争看乘舆出九重。\n云拥翠华时五色，始知天子是真龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春祀歌 其二","author":"李良柱","text":"羽林十万领金貂，日月旂常出绛霄。\n扈从侍臣齐上马，君王亲驭玉逍遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五夜词 其一","author":"李良柱","text":"白鹭黄龙转吐奇，金凫银燕逐参差。\n芙蓉别殿轻烟散，知是蓬瀛不夜时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五夜词 其二","author":"李良柱","text":"燕玉轻盈未破瓜，当筵一舞艳如霞。\n缠头掷出三千锦，知是风流汉戚家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五夜词 其三","author":"李良柱","text":"微雪初销绮陌尘，河桥月色净如银。\n踏歌声逐香风远，多少遗钿堕翠人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"五夜词 其四","author":"李良柱","text":"五陵公子竞豪华，桃李秾妆出绛纱。\n犹恨春宵难置闰，高烧银烛照琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝曲 其一","author":"李良柱","text":"被郊芳草正萋萋，斗酒双柑到处携。\n二曲乱嘶红叱拨，九衢争唱白铜鍉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝曲 其二","author":"李良柱","text":"日射金茎露未乾，禁城红紫万人看。\n衍波倘得蒲生纸，好为宫中赋晓寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝曲 其三","author":"李良柱","text":"攀折柔条酒尽倾，风流张绪少年情。\n饶他白堕春醪绿，且让黄封内酝清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝曲 其四","author":"李良柱","text":"十里香风散晓霞，长安终日斗繁华。\n妆台声价猩猩晕，金屋风流步步花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝曲 其五","author":"李良柱","text":"玉塞朝朝有雁归，羽书应不到金微。\n葡萄酒熟銮奴醉，苜蓿花开苑马肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝曲 其六","author":"李良柱","text":"燕市青青十二楼，曲尘丝里万条柔。\n楚宫宝袜黄金缕，齐楚莲花白玉钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝曲 其七","author":"李良柱","text":"虾蟆陵下酒家胡，六博争雄尽日呼。\n不惜鹔鹴随意解，知他还似长卿无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝曲 其八","author":"李良柱","text":"紫陌啼莺穿弱柳，玉河流水带残冰。\n飞花尽逐游人散，衣马轻肥自五陵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀南园五先生","author":"杨瑞云","text":"迢迢南国有诸君，白社当年结白云。\n笑向乾坤开混沌，漫从岭海见人文。\n花明百越千村晓，水到三山万派分。\n烟月浮邱秋自在，几人把酒挹清芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祖席 其一","author":"杨瑞云","text":"两岸风花赴彩筵，共凭水寺一流连。\n大江波漾骊珠色，沧海僧留梵宇烟。\n冠盖并酣琼岛宴，鱼龙亦识使君船。\n野人醉倒歌钟夜，漫借双林半榻眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祖席 其二","author":"杨瑞云","text":"珠寺依依蜃气蒸，相逢海上几宾朋。\n中流亭榭云随动，四顾苍茫槛可凭。\n石壁千年留赋笔，松花尽日伴闲僧。\n酒阑烟暝天风起，万里离愁为汝僧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祖席 其三","author":"杨瑞云","text":"谁堪行客日匆匆，话别天涯酒正浓。\n万顷波涛浮古寺，两崖云树度疏钟。\n潮生沧海催飞鹢，天转延津看跃龙。\n南北地悬瞻望切，好凭振雁寄行踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小金山","author":"杨瑞云","text":"落落东南旅思曛，淡烟古刹喜同君。\n潮吞江汉帆樯乱，山瞰鼋鼍日夜闻。\n谈笑天中惊过鸟，阴晴杯里转行云。\n最愁两岸青青柳，醉倚春风傍席分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒谢南海神登浴日亭","author":"杨瑞云","text":"入望寒光万里馀，钓舟隐隐浪灯疏。\n山河亦有阳回处，天地何当日浴初。\n千丈长鲸翻浪紫，三更高阁听鸡舒。\n野人乍识扶桑胜，愿作沧江一老渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱八景 其一 紫烟楼","author":"杨瑞云","text":"白云西下敞层楼，楼上仙人丹井留。\n千载九还传火候，轻烟长傍紫霞流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱八景 其二 晚沐堂","author":"杨瑞云","text":"罗浮东望郁苍苍，西带湘漓天共长。\n石似琼瑶水似玉，几回休沐到斯堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱八景 其三 珊瑚井","author":"杨瑞云","text":"泠泠玉乳镜中浮，长带江潮日夜流。\n分到三门成大海，珊瑚能得几人收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16776,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱八景 其四 大雅堂","author":"杨瑞云","text":"当年客振银鱼入，彩笑东南五色开。\n沚水泠泠棠树下，细听风雅起高台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16777,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱八景 其五 留舄亭","author":"杨瑞云","text":"何年跨鹤下浮邱，满地清风水石秋。\n遗下仙人双舄在，孤亭长共白云流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16778,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱八景 其六 朱明馆","author":"杨瑞云","text":"神仙本往朱明洞，来往三城跨五羊。\n千载浮邱池馆在，依依云树湛沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16779,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱八景 其七 挹袖轩","author":"杨瑞云","text":"仙客翩翩不可期，几回御鹤住芳陂。\n云边笑挹浮邱伯，更与洪厓共举卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱八景 其八 听笙亭","author":"杨瑞云","text":"翩翩羽客下蓬瀛，吹动仙簧夜二更。\n亭畔珊瑚桥畔月，得逢学士此听笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺 其一","author":"杨瑞云","text":"一僧岩畔启诸扉，长日便予住翠微。\n路转青冥谁得到，寺经梁晋尚能飞。\n野猿归去烟迷洞，驯鹿衔来花满衣。\n倦枕半云松壑寂，不知身世是兮非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺 其二","author":"杨瑞云","text":"扁舟何处访禅关，袅袅钟声碧落间。\n一水乍寒金锁色，千峰不老白云颜。\n日高众壑僧初起，树挂飞湍客许攀。\n堪笑风尘行役者，几时归计得青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游南华寺值雨","author":"杨瑞云","text":"马首荒凉村复村，曹溪坛树雨中昏。\n菩提不改南华偈，明镜长从下界尊。\n寺里烟岚千障合，岩前钟鼓几僧存。\n千年我到谈真偈，犹有天香落酒尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"盐渎行","author":"杨瑞云","text":"大风卷地海云黄，四野昏黑日无光。\n狐狸白昼置人旁，千家万家尽傍徨。\n壮夫大叫气如狂，蛾眉红粉泪千行。\n盐渎主人把剑问上苍，胡为乎陵谷倒置变态也非常。\n千竿绿竹覆壶觞，有酒难消郁结肠。\n可道颜色百花王，一朝零落蔓草旁。\n轰雷掣电天中央，此时势焰何可当。\n吁嗟晦明事难量，吁嗟晦明事难量。\n霎时间云师风伯避太阳，魑魅恐尔无处藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"行役丁溪逢同年王效勤","author":"杨瑞云","text":"五年难见面，昨夜始逢君。\n画馆低炎日，青尊入海云。\n身危能久借，吏隐任予醺。\n酒后风帆急，骊驹不忍闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜发八宝城","author":"杨瑞云","text":"解缆溪云暮，舟人几度惊。\n一灯宵不寐，孤棹夜趋程。\n雨入重湖白，村因野烧明。\n那堪江畔草，处处傍愁生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"菁湖偕吴曰南泛月得帆字","author":"杨瑞云","text":"四顾湖光白，相携上小艬。\n杯中浮片月，天外落孤帆。\n楚客惊秋早，吴钩傍斗衔。\n当尊那厌数，明发戒征帆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":16788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]