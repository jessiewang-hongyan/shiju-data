[{"title":"陌上见杏花","author":"谢晋","text":"赤阑桥畔粉墙东，杏子花开树树红。\n自是陌头春色好，赏心不与故园同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6774,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日写怀","author":"谢晋","text":"好怀无复似前时，一半春过尚未知。\n惟有白门桥下柳，见人憔悴也颦眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6775,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题郭宗仪半野轩","author":"谢晋","text":"竹树萦回带板桥，一溪流水隔尘嚣。\n成村只有三家近，去郭都无四里遥。\n春雨楼台窗里岫，寒宵更鼓枕边谯。\n湖田渺渺山塘路，烟月平分景倍饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6776,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送任二尹复官吴县","author":"谢晋","text":"考绩曾闻谒紫宸，俄看征棹别江津。\n郎官拜去虽依旧，雨露承来又一新。\n古县花明千树晓，重城柳色万家春。\n知君德化吴民久，风俗从兹想更淳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6777,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋夜坐","author":"谢晋","text":"白昼雨如注，黄昏云渐开。\n冰轮时露影，金气净无埃。\n栖泊从萍梗，情怀付酒杯。\n故山丛桂发，应待远人回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6778,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送金徵士问应书诰荐","author":"谢晋","text":"金卿二十即能文，染翰争誇遇右军。\n用笔不愁穷兔颖，临池惟爱弄鹅群。\n常年闭户稀曾出，一日佳声远自闻。\n忽睹荐章从聘召，为书皇诏锡功勋。\n治装早已辞亲旧，拜手明当谒帝君。\n花底倾来杯欲尽，柳边㩦处袂将分。\n嗟余蠖守依环堵，羡子鹏抟在五云。\n圣代英材超往古，家鸡野䳱任纷纭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6779,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋暮客怀","author":"谢晋","text":"打窗风雨响，天气为催寒。\n菊到重阳绽，人生几度看。\n酒樽须放满，怀抱且教宽。\n渐老无兄弟，谁能救急难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6780,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朝来","author":"谢晋","text":"朝来重览镜，白发渐看生。\n不畏年将老，深忧业未成。\n江山随处景，松菊故园情。\n近喜疏杯酌，抄书得眼明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6781,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋晚","author":"谢晋","text":"久客清溪上，深秋古巷西。\n井梧将落尽，篱菊未开齐。\n门掩潇潇雨，涂深滑滑泥。\n凭轩时引领，触处暮云低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6782,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"孤云","author":"谢晋","text":"才看生石上，倏在太虚中。\n停处长依日，飘来不待风。\n既能无着碍，一任自西东。\n会见从龙去，为霖建大功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6783,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"逢沈以潜","author":"谢晋","text":"何处移来一艇闲，褰衣同憩树阴间。\n自缘别久多情话，不为看山忘却还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6784,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"荅缪撝见寄","author":"谢晋","text":"人间无伯乐，谁识是龙媒。\n君意青云久，吾年白发催。\n大寒推守火，清夜只书灰。\n消渴虽长病，还思露一杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6785,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元日客怀","author":"谢晋","text":"四年元日客京尘，孤馆今朝复见春。\n座上青毡于我旧，镜中华发为谁新。\n屠苏入手思儿辈，萱草回芽忆老亲。\n浇酒愿身从此始，儒冠长作太平人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6786,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春思","author":"谢晋","text":"东风吹雨正帘纤，春色和云压四檐。\n听断莺声残醉醒，杏花香底坐钩帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6787,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪晴","author":"谢晋","text":"瑶华一夜满长安，拂晚鹴裘愈觉寒。\n地接阴涯全积聚，路当阳处尽消残。\n烹茶未许陶家扫，咏絮从教谢女看。\n遥望钟山霄汉际，迥临金阙玉龙蟠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6788,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪晴早行","author":"谢晋","text":"薄雪封双井，层冰冱六街。\n马蹄声蹴蹴，鸡唱韵喈喈。\n寒切诗人骨，晴舒旅客怀。\n何时归旧里，旭日卧閒斋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6789,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"巳丑岁初度","author":"谢晋","text":"缙也东西南北人，年年初度喜逢春。\n却怜父母生吾日，便有乾坤着此身。\n梅萼折来香满袖，蓼莪诵罢思沾巾。\n多情两炬绯罗烛，映席生花报喜频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6790,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春雪","author":"谢晋","text":"腊前未肯呈祥瑞，春至凭谁为剪裁。\n知是东皇均布泽，园林无树不花开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6791,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"瑞香花","author":"谢晋","text":"紫锦香囊细簇攒，开时长得在春前。\n丰姿只许江梅并，不让山樊与水仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6792,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"承天门谢恩值雨","author":"谢晋","text":"随例趋朝拜赐金，俄逢晚雨到琼林。\n布衣不觉重重透，恩泽沾来分外深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6793,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀僧智圆","author":"谢晋","text":"五台山下雪纷纷，谪去孤僧万里身。\n他日蒙恩归旧寺，休将衣钵浪传人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6794,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春寒","author":"谢晋","text":"一冬剩有三春暖，二月都无一日晴。\n雨雪载涂泥滑滑，黄昏犹未断人行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6795,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送韩伯永侍父扈驾之北京","author":"谢晋","text":"六龙扶驾拥旌旄，之子从亲岂惮劳。\n定省常时趋直舍，旨甘随处奉行庖。\n春回辇路生瑶草，日照班衣映绛桃。\n听彻箫韶成九奏，紫垣星拱卿云高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6796,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题卞野夫便面","author":"谢晋","text":"翠幕清风小画船，晚凉移近绿阴边。\n酒酣半倚蓬窗下，閒听吴姬唱采莲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6797,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春宵","author":"谢晋","text":"慱山香袅篆烟移，丝筦无声玉漏迟。\n风动花枝窗外影，半庭明月酒醒时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6798,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送陈耘初任御史","author":"谢晋","text":"太平堤畔柳条黄，讼简乌台日正长。\n骢马乘来朝下早，春云飞入绣衣香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6799,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"斗鸡","author":"谢晋","text":"昂尾高冠芥羽班，几年无敌向场间。\n莫言死斗成何事，供奉朝来赐锦还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6800,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"戊子岁四月十有七日陪金正字问马校理敬游龙江过张茂异书馆二十韵","author":"谢晋","text":"圣节朝会毕，文士豫清暇。\n偶陪二三子，追随石城下。\n忽作龙江游，轻舠得同驾。\n晨风清且徐，川流逝如泻。\n苍茫一苇宽，桅樯万艘隘。\n浦溆多人家，陴塘少蒲稗。\n露晞日已燠，芳景当首夏。\n絺绤换春服，丰姿耀晴野。\n稍稍路将近，行行舟遂舍。\n张生颇好事，态度通閒雅。\n况复有难弟，见客即迎迓。\n趋前致长揖，邀我入庐舍。\n却登池上楼，还眺风边榭。\n槐柳高覆阑，荼?广盈架。\n芸香散缃帙，金碧绚图画。\n清谈殊未极，展席陈罍斝。\n殷勤起相劝，情意美无价。\n欢饮不记筹，酣歌那肯罢。\n坐觉天际岑，沈沈夕阳下。\n匆遽入岩关，钟声促昏夜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6801,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题吴兴薛希贤清远诗卷","author":"谢晋","text":"闻说吴兴地，幽深远市朝。\n千村同泽国，一境断尘嚣。\n四塞山横浦，南浔路带桥。\n衣冠犹尚晋，民物况逢尧。\n蚕趁晴时浴，桑依沃壤条。\n茧丝从旧税，保障减新徭。\n烟暖苔花吐，波寒芟叶销。\n吴姬朝掷杼，估客夜吹箫。\n霜断汉多蟹，风行树有蜩。\n看云凭草阁，听雨卧兰桡。\n野色行常挹，岚光坐可招。\n最怜君住处，更觉趣清标。\n蘋外鸥盟狎，松边鹤梦遥。\n捲帘凉未度，迎扇暑先消。\n逸兴诗千首，閒情酒一瓢。\n源开桃灼灼，门掩竹潇潇。\n翠耸峦融雪，纹生浪激飘。\n传模停采笔，移写费生绡。\n杜牧风流在，玄真逸思饶。\n他年容卜筑，来此老渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6802,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠庶吉士杨宗勖","author":"谢晋","text":"高居深巷有馀清，垂柳阴阴户半扃。\n轩下盆池寒湛碧，阶前湖石翠为屏。\n几年染翰趋青?，长日承颜戏綵庭。\n我欲问奇重载酒，不妨听讲太玄经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6803,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠南昌朱鍊师","author":"谢晋","text":"南昌巍巍紫极宫，楼阁缥缈如方蓬。\n中有一人神气充，道与许逊相恭仝。\n追逐宋伦彭谌宗，名籍早入丹台中。\n鬓髭皓皓颜如童，电光炯炯双青瞳。\n羽衣五綵云霞烘，峨峨冠戴金芙蓉。\n袖藏神剑苍精龙，一挥妖魅俱潜踪。\n呵叱雨师鞭雷公，驱送将吏如奴僮。\n群迷普济德愈崇，下与尘世苏疲癃。\n凌摄梵气邀苍穹，斡旋造化多奇功。\n昨闻游闽访仙翁，山川历览兴莫穷。\n逍遥未欲栖崆峒，还来玉京朝九重。\n相依弟子圜邱东，借榻霞房金碧丛。\n广庭香爇烟洪濛，满座喜气排寒冬。\n我尝问道恭仪容，欣然接引坐高舂。\n致言授我启愚蒙，顿除凡火烧心胸。\n春光淡沲天宇融，倏焉归思如春浓。\n清宵飞梦依岩松，丹炉火伏微生红。\n朝来别去何匆匆，飘然骑鹤凌太空。\n空中环佩声珑珑，招我共往那能从。\n何当远驾洞庭风，膝王阁下重相逢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6804,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"会真诗四首 其一","author":"谢晋","text":"香闺未暝已成妆，坐待残晖下粉墙。\n阿母初眠深院静，魂神多半出西厢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6805,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"会真诗四首 其二","author":"谢晋","text":"漙漙玉露湿庭莎，不觉凉侵袜底罗。\n自是夜深心胆怯，却嫌行处月明多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6806,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"会真诗四首 其三","author":"谢晋","text":"衣褪香肌瘦不胜，侍儿扶至困腾腾。\n莫言良会春宵短，犹胜前时独背灯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6807,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"会真诗四首 其四","author":"谢晋","text":"月淡星微夜渐分，百年心事在逡巡。\n无端侍女频催去，香散空斋不见人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6808,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三忆效香奁体 其一","author":"谢晋","text":"情随飞絮远悠扬，梦绕梨云去渺茫。\n忆得芳卿春睡觉，含羞懒下合欢床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6809,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三忆效香奁体 其二","author":"谢晋","text":"晓莺啼歇曙烟收，花气薰栊日影浮。\n忆得起来相伴坐，绿阴深处看梳头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6810,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三忆效香奁体 其三","author":"谢晋","text":"梨园乐府羡才名，传得庞师指下声。\n忆得小轩明月夜，倚床微醉听鸣筝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6811,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送监生马纯玉归省","author":"谢晋","text":"五载编摩近紫宸，一朝归省出成均。\n马周辞阙丹心在，莱子趋庭綵服新。\n山店酒香寒驻马，江亭月色暮留人。\n东风又绿瀛洲草，回首乡园总是春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6812,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七夕舟次图山渚","author":"谢晋","text":"月映图山暑气收，今年七夕在归舟。\n穿针未及临池榭，乞巧何妨倚柁楼。\n乌鹊尽从今夜去，银河遥接大江流。\n酒醒起坐看牛斗，拟泛灵槎天上游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6813,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送常上人住苏城天王寺","author":"谢晋","text":"巍巍梵刹古宫边，讲席新登况盛年。\n山迥柳桥闻锡振，林开槐市见灯然。\n芭蕉绿上翻经叶，檐卜香飘煮茗烟。\n好对清风挥玉麈，莲花漏底坐谈玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6814,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画","author":"谢晋","text":"石路仙源无尽头，山花漂歇水还流。\n衡门绿树春风里，时见人来杖履游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6815,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题雪梅群鸟图","author":"谢晋","text":"渊上寒多雪未消，雨竿风竹翠翛翛。\n莫言众鸟来喧集，今夜梅花正寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6816,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得千人座送沈寅仲","author":"谢晋","text":"林下盘陀石，山中不记春。\n地看无一亩，客坐仅千人。\n云护平如砥，苔封厚似茵。\n祖筵从座设，欢会在逡巡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6817,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽圆鉴中上人","author":"谢晋","text":"怜师远谪去台山，长路漫漫竟不还。\n身伴孤云埋雪峤，魂随片月到松关。\n声名拟傅高僧里，诗卷空留百世间。\n欲向禅窗歌楚些，那堪双袖泪潸潸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6818,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七夕二首 其一","author":"谢晋","text":"乌鹊成桥处，银河湛欲流。\n月随穿线女，香散曝衣楼。\n天上逢今夕，人间几度秋。\n灵槎如有便，还许客星游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6819,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"七夕二首 其二","author":"谢晋","text":"百子池边灏气清，蛛丝旋绕夕风轻。\n鸾机停赋天孙锦，鹤驾迎吹子晋笙。\n玉露洗开秋万里，银河泻尽漏三更。\n谁家儿女深闺里，乞巧时闻语笑声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6820,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢人惠镜","author":"谢晋","text":"明鍊由来在刮磨，此心如水共君何。\n不因远寄萧斋底，白发那知有许多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6821,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送呆上人住杭皋亭山寺","author":"谢晋","text":"才看白下驻幡幢，又见浮杯渡浙江。\n山峙皋亭清有几，师如荆玉美无双。\n岩前虎伏晨听法，池上龙游夕受降。\n闻说杨梅味偏胜，筠笼满摘寄吟窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6822,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"灯夕后二日雨中盛子勉招饮就宿金文鼎清风楼","author":"谢晋","text":"西园饮散暝烟浮，南市灯昏雨未收。\n归路谁怜狂客醉，出门深感故人留。\n梅飘绛雪香侵榻，竹撼清风翠绕楼。\n残酒醒来浑不寐，独吟诗句拥寒裯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6823,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"辛邜花朝偕沈二秀才壁苏校书复游南郊二首 其一","author":"谢晋","text":"南郊春色好，况复是花朝。\n佳兴随时偶，清游不预招。\n壶觞虽有限，山水益何饶。\n更待清明约，重过白下桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6824,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"辛邜花朝偕沈二秀才壁苏校书复游南郊二首 其二","author":"谢晋","text":"拂晓出都门，长干日已暾。\n闻歌桃叶渡，沽酒杏花村。\n公等文章溢，吾侪道义存。\n佚游非所乐，风咏总堪论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6825,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画次周履道韵","author":"谢晋","text":"竹窗微雨晚尊凉，芸几无鱼帙有香。\n忆得日家邻虎阜，萦迂林木带山塘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6826,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题溪山春雨图为淞江金文鼎赋并画","author":"谢晋","text":"春云作阴知几日，春雨连朝疏更密。\n浦树含滋山气昏，杜若生香溪水溢。\n霜微润物听无声，霢霂如膏似有情。\n多处人家踰冷节，几株榆柳变清明。\n横塘路转林亭侧，贾船渔艇昼停息。\n鹁鸠声静鹧鸪啼，滑滑深泥行不得。\n东山痴客兴尤佳，冒雨从容立水涯。\n短屐缘溪粘碧藓，飞盖张油映绿槐。\n浮沤满汀波不起，唤得渡边舟欲舣。\n应近隔岸野人家，相约晴来看桃李。\n闻说高人住处清，九峰三泖在檐楹。\n还忆东郊劝农日，时将蓑笠饷春耕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6827,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画马","author":"谢晋","text":"发迹断从冀北来，无人不道是龙媒。\n如何饱食天闲粟，犹向平原齧草荄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6828,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三月晦日","author":"谢晋","text":"忍见红惊堕，那堪泪暗垂。\n客怀春尽日，归梦夜深时。\n故国莺声老，他乡鬓影衰。\n破除无别物，终藉酒盈卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6829,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题庄公瑾所画春山林馆图","author":"谢晋","text":"画堂未昼帘高捲，佳树欣荣春意远。\n弄晴天气雨霏霏，几日阴寒风剪剪。\n重屏映烘云母薄，远岫愁横眉黛浅。\n微红轻折短墙桃，新碧暗生閒砌藓。\n春水平堤杜若香，红桥隔岸垂杨软。\n药栏人睡乱啼莺，花径客稀闲吠犬。\n青笼老人漆园吏，平昔丹青共称喜。\n前年作客凤皇州，一室清幽大如茧。\n常时适意恣挥洒，从把襟怀漫舒展。\n人间一幅重千金，直即此图世尤鲜。\n何当置我碧窗前，长日看书自消遣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6830,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清明","author":"谢晋","text":"柳暗春城絮正飞，晓寒犹怯试罗衣。\n尘中车马香风隘，墙里秋千笑语稀。\n炊散榆烟来客舍，香随杏酪到邻扉。\n相逢日暮天街上，无处游人不醉归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6831,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄张德裕","author":"谢晋","text":"余昔在乡里，佳树接芳园。\n今来游上国，复获常讨论。\n当春愔散策，暇日玩清尊。\n幽悰并无托，欲与静者言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6832,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"溪上","author":"谢晋","text":"金飙散林樾，碧筱馀禽哢。\n天净生岑迓，波澄镜湖空。\n渺渺渚鸥前，渔艖夕阳送。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6833,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送苏监生复还家","author":"谢晋","text":"才辞东观入成均，又见治装去谒亲。\n为客情怀如昨日，到京才学胜他人。\n归迟莫讶缝衣旧，志遂应当戏綵新。\n想是今年除夜酒，团栾坐待故园春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6834,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送吴敏学还吴省亲","author":"谢晋","text":"双亲白发老东吴，令子丹心向帝都。\n正及岁寒归故里，不辞雨雪载长途。\n无人似尔情偏厚，有酒如渑兴不孤。\n他日相思凝望处，暮云春树总模糊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6835,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游神乐观","author":"谢晋","text":"烟霞缥缈接钟山，举首天坛只尺间。\n地滑醴泉来玉甃，风飘神乐下仙阛。\n壶中月冷梅初白，洞口松寒鹤未还。\n欲就丹房传秘诀，还从羽客驻红颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6836,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"极目","author":"谢晋","text":"极目吴头水，栖身白下门。\n艰难愁疾病，寥落怕黄昏。\n泣血亲俱殁，传家子独存。\n几年归未得，心事向谁论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6837,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题医士景文伟秋林读书图","author":"谢晋","text":"疏峰澹秋色，远水㴠晴旭。\n梧篁迭映蔚，蒲苇相依绿。\n幽人日无事，览赏澄心目。\n手持轩岐书，步入松斋读。\n时闻伊吾声，浪浪出林麓。\n谁能悟摄生，寡嗜恒自足。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":6838,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]