epo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6534,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻马市讲和诸边晏然识喜 其一","author":"黎民表","text":"陇北辽阳揔乞和，尽驱龙种度黄河。\n一时内厩三千队，应费东吴万匹罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6535,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻马市讲和诸边晏然识喜 其二","author":"黎民表","text":"长堤一望尽如云，沙苑秋开牧马群。\n黄竹漫劳行万里，柳营从此息三军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6536,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻马市讲和诸边晏然识喜 其三","author":"黎民表","text":"敌骑翩翩起朔风，朵颜三卫亦枭雄。\n稿街不是稽传首，应念当年靖难功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6537,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻马市讲和诸边晏然识喜 其四","author":"黎民表","text":"几年宵旰在关门，今日垂衣拱至尊。\n检玉不须升岱岳，泥金应合答玄元。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6538,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅徐汀洲 其一","author":"黎民表","text":"君向淮阳承主恩，予亦扁舟归故园。\n金陵花月何曾见，杀气西街白下门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6539,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅徐汀洲 其二","author":"黎民表","text":"胡床坐啸海风秋，明月关山满戍楼。\n麟阁何人誇彩笔，功名应合佩吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6540,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅徐汀洲 其三","author":"黎民表","text":"青山霜落九溪濆，斋阁风流有使君。\n褰帷欲指金台路，玉女先开五色云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6541,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"荅徐汀洲 其四","author":"黎民表","text":"燕京飞雪正漫漫，十二楼空铁凤寒。\n白首书生随计吏，共邀明月醉长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6542,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴而待守归州 其一","author":"黎民表","text":"洞庭西上蜀江深，两岸青枫映竹林。\n楚舞已歌随使节，猿声何处更沾襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6543,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴而待守归州 其二","author":"黎民表","text":"衰草寒烟过楚宫，荒台犹起大王风。\n风流宋玉应同调，白雪高吟郢国中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6544,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴而待守归州 其三","author":"黎民表","text":"十月江清露冕游，鹧鸪啼处楚云流。\n如花笑倚黄陵庙，日逐长安客自愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":6545,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送吴而待守归州 其四","author":"黎民表","text":"斑竹冈前烟雾开，京台高筑望蓬莱。\n论才却是冯唐老，使酒谁招季布来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","poi