[{"title":"源禅游吴造沈香佛像及诸经，归峨嵋山 其二","author":"袁宗道","text":"曾闻西蜀境，独有大峨殊。\n雪色何年岁，佛光定有无。\n狖声当夜激，鸟道折云趋。\n远觅心初歇，应明系里珠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陶石篑寄书","author":"袁宗道","text":"不见士行久，音容两地疏。\n迢遥千里外，珍重八行书。\n评骘唯山鸟，升沈悟沼鱼。\n袖书那忍置，一诵一踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"结社二圣寺","author":"袁宗道","text":"浮世何多事，祗园早息机。\n定僧惊果落，沙鸟触帆飞。\n香积初分饭，旃檀欲染衣。\n诗坛兼法社，此会百年稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读小修南游稿志喜 其一","author":"袁宗道","text":"怪尔新诗好，居然下里稀。\n眉端沧海色，江上白云衣。\n鼓楫三湘去，携图五岳归。\n能令名利客，一倍宦情微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读小修南游稿志喜 其二","author":"袁宗道","text":"亦有翻飞兴，兹游未可攀。\n所谈客里路，是我梦中山。\n弱羽经年去，孤鳞万里还。\n入春佳事少，见尔一开颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读小修南游稿志喜 其三","author":"袁宗道","text":"调鸡从自得，相马任群疑。\n颇似沈冥者，非徒游侠儿。\n橐装无锡水，竿牍故人诗。\n吾家二三子，如君定白眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"袁宗道","text":"细鸟语高枝，幽斋事事宜。\n香龛安佛像，贝典教妻儿。\n施食檐禽狎，玄谭阶树知。\n道缘应不浅，庞叟是吾师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"桂阇黎收余二十年前题壁诗","author":"袁宗道","text":"是否灯前字，将无醉后书。\n苍茫廿载外，潦倒数行馀。\n色古蒸炉气，文笺蛀壁鱼。\n深惭支遁赏，珍重意难虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"袁宗道","text":"人烟江水上，江上日生波。\n街巷鱼虾满，门庭鸟雀多。\n酒中传佛意，笔底困诗魔。\n已自戢毛羽，何由畏网罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北发","author":"袁宗道","text":"小草真何意，前途事事难。\n骨粗妨礼乐，性懒怯衣冠。\n远志严亲夺，新愁爱弟宽。\n驱驰堪自厌，辛苦为微官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45755,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新野道中","author":"袁宗道","text":"过襄又百里，步步远亲闱。\n不谙座沙趣，焉知仕路非。\n平原江树断，野店楚音稀。\n终作一丘土，何年此道归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45756,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"保安驿道中","author":"袁宗道","text":"此乡经大祲，此路复愁霖。\n怪雀啼村市，饥人窜莽林。\n暝烟连雨脚，云气起山心。\n薄暮昆阳道，行行忧滞淫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过旧叶城有感，是时两弟已行五六日矣，三弟留题荒亭 其一","author":"袁宗道","text":"昔年飞舄处，此日倍酸辛。\n白骨三家市，青燐一水滨。\n异乡均苦乐，兄弟各风尘。\n凄断惠连句，荒亭墨沈新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过旧叶城有感，是时两弟已行五六日矣，三弟留题荒亭 其二","author":"袁宗道","text":"佩犊风犹在，画龙迹已陈。\n有情伤暴骨，无计起枯鳞。\n饱食惭官吏，停车问窭人。\n腐儒甘脱粟，不敢厌劳薪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿古驿","author":"袁宗道","text":"兀兀泥途里，饥羸不可支。\n灯前慰病妇，梦里见亡儿。\n古驿啼新鬼，颓垣走怪鸱。\n细寻题壁处，或有惠连诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登紫云山，是葛仙炼丹处","author":"袁宗道","text":"昔岁曾游此，题诗墨尚新。\n药炉烧芋栗，丹井长荆蓁。\n鸡犬驯游子，壶觞费道人。\n驰驱明日事，暂浣客裾尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮禹州李氏园","author":"袁宗道","text":"古郡溪山郭，名园花竹楼。\n麝香眠野草，翡翠立晴洲。\n安得一生醉，那能十日留。\n公荣定谁似，是客可销忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮雨","author":"袁宗道","text":"卖却日高睡，来踏陌上尘。\n朔风梁苑草，古树浊河滨。\n强作违心语，稀逢有韵人。\n山邮听雨夜，梦里滑车轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河","author":"袁宗道","text":"两度归江汉，重来度浊河。\n尘容三老谙，驿路二旬过。\n霜薄天初朗，风轻晓亦波。\n太行山色近，西望碧嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"高村店大风，店有淇澳绿竹古迹","author":"袁宗道","text":"罡风猎猎下征鞍，十月严霜次骨寒。\n喷石澌沙犹古水，流苍滴翠是新竿。\n寒鸦野店楸林黑，冻马荒亭莎叶乾。\n何似山斋闭关坐，南华摊向火炉看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早发临洺行沙河道中忆两弟","author":"袁宗道","text":"昏昏寒月夜方深，驱马长亭复短亭。\n十里奔风吹积砾，千秋篝火乱残星。\n鞭梢漠北烟沙黑，梦里江南果树青。\n驿路飘零那可问，挑灯何日对原鸰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将抵都门","author":"袁宗道","text":"九年牛马走，强半住江乡。\n狂态归仍作，学谦久渐忘。\n对人错尔汝，迎客倒衣裳。\n只合寻鸥伴，谁令入鹭行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽同年李检讨成甫四首 其一","author":"袁宗道","text":"草草来还去，人间三十年。\n飞扬心慕侠，清峭骨如仙。\n对酒常扶病，逢人爱说禅。\n竹窗寒月夜，忆尔泪潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽同年李检讨成甫四首 其二","author":"袁宗道","text":"十载贫兼病，半生狂与痴。\n钱刀负市井，衣食困妻儿。\n每想灯前谑，犹存扇上诗。\n交情堪白首，缘薄负心期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽同年李检讨成甫四首 其三","author":"袁宗道","text":"白骨归新土，青山闭旧庐。\n苔缘题遍壁，蠹满读残书。\n凤老梧桐死，霜寒橘柞疏。\n佛天畴昔愿，今日定何如？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽同年李检讨成甫四首 其四","author":"袁宗道","text":"泉路飘零久，人间惆怅深。\n有儿非滴骨，觅鬼不灰心。\n虫鼠知谁胜，鸺鹠可寄音。\n无生君所学，忍苦莫悲吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别陶编修石篑四首 其一","author":"袁宗道","text":"日日青门里，棕鞋任所之。\n焚香薰定性，画影锻新诗。\n世事抛唇角，禅功验鬓丝。\n深凭法忍力，一破有情痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别陶编修石篑四首 其二","author":"袁宗道","text":"向说山阴路，千岩与万湍。\n水中城堞见，山顶灶烟寒。\n杭酒来尖舫，湘莼供水餐。\n知君远女色，不上浣纱滩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别陶编修石篑四首 其三","author":"袁宗道","text":"不分陶弘景，松风只自听。\n异乡同改火，法侣怅晨星。\n贺沼蒲稍绿，吼山石孔青。\n良朋君岂恋，同调有原鸰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别陶编修石篑四首 其四","author":"袁宗道","text":"门外正霜飞，何堪送所知。\n愁肠萦远水，别面化枯枝。\n冷澹稀人识，清羸好自支。\n芥针能得几，万里去师资。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮杨刺史园二首 其一","author":"袁宗道","text":"东城最僻处，刺史有新庐。\n近水先生柳，门填长者车。\n菊香熏枕簟，酒气湿图书。\n肝胆灯前尽，都忘倾盖初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮杨刺史园二首 其二","author":"袁宗道","text":"虚堂含夕照，绮席醉良朋。\n绿酒浮鹦鹉，黄花映毾㲪。\n书图随意展，真赝任人评。\n清夜论诗罢，深谈契佛乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送武陵胡元父令瑞昌","author":"袁宗道","text":"怜君为政处，隔水庐山高。\n白鸟飞衔牍，青岚远映袍。\n花风香薄领，蔬圃课参曹。\n好学循良去，休嫌抚字劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郭少参希彦之蜀 其一","author":"袁宗道","text":"欲重金躔地，应资琐闼声。\n天连巴子国，江尽宕渠城。\n蛮府传新檄，賨人候去旌。\n葛山遗迹在，知不愧勋名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郭少参希彦之蜀 其二","author":"袁宗道","text":"如何当此月，车马踏巑岏。\n去楚尚千里，过秦应万盘。\n深山如雪里，古驿出云端。\n三十金绯贵，休嗟蜀道难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻颜尚宝质卿称病有感","author":"袁宗道","text":"燕市饶禅客，如君意最真。\n幽闲泉石趣，清瘦雪山身。\n一榻庭生藓，双趺席聚尘。\n偶称摩诘病，为度夜行人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮颜质卿斋头限韵赋同潘去华 其一","author":"袁宗道","text":"同调复同官，幽斋会二难。\n交情投芥合，礼法解衣宽。\n坐久炉将烬，言多杯屡寒。\n明窗披易注，直作太玄看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮颜质卿斋头限韵赋同潘去华 其二","author":"袁宗道","text":"震旦同参少，长安雅聚难。\n因君道眼别，令我酒怀宽。\n匡坐藤蒲静，幽谈水月寒。\n好将瞿氏说，留付子庸看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月三十夜同萧允升过黄思立斋头","author":"袁宗道","text":"怜君却扫久，为我开清尊。\n一见生狂态，相酬多谑音。\n雨凉轻酒力，秋逼搅诗魂。\n尚有看莲约，犹堪续旧论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同黄思立、赵贞甫集萧允升斋中谈禅甚快，各赠一诗黄太常思立","author":"袁宗道","text":"念我同门友，为郎家益贫。\n萧疏愁世鞅，磊落笑时人。\n供茗瓷瓯洁，添香粉指匀。\n近通无净理，一倍耐风尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"萧赞善允升","author":"袁宗道","text":"耽奇词赋古，养拙友朋疏。\n每退金华直，常翻贝叶书。\n谭宗时契鸟，洗墨畏惊鱼。\n更羡东门达，延陵故不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赵御史贞甫","author":"袁宗道","text":"逸兴文兼酒，玄谈芥与针。\n兰台虽作客，蒲榻早休心。\n定里骑聪马，忙中访竹林。\n知君无不可，那复计升沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日小斋杂兴 其一","author":"袁宗道","text":"室小堪容膝，冥然断百思。\n坐看檐日下，袒受竹风吹。\n苔色流书帙，花光侑酒卮。\n从来中散意，未许外人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日小斋杂兴 其二","author":"袁宗道","text":"尽日掩荆扉，高槐蔽夕晖。\n剩餐菰米饭，宽著稻畦衣。\n密室香难烬，幽栏药易肥。\n不知深谷里，过尽几芳菲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日小斋杂兴 其三","author":"袁宗道","text":"最怜山气爽，徙榻傍窗纱。\n径僻能全草，帘疏不障花。\n无疴常伏枕，小冗为煎茶。\n堪笑东陵客，休官始种瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日小斋杂兴 其四","author":"袁宗道","text":"非傲亦非懒，几月简逢迎。\n笑语消三伏，升沈付五行。\n雨加苍藓色，涛泻绿筠声。\n无端传巷语，清耳赖禅鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日小斋杂兴 其五","author":"袁宗道","text":"空阶经急雨，萧爽夜无哗。\n折柬邀王子，餐钱与赵家。\n颓然对木石，率尔吐云霞。\n酩酊不知出，高楼生月华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日小斋杂兴 其六","author":"袁宗道","text":"调古知音少，行孤起信微。\n清尊浇宿块，黄叶答初机。\n事以忘怀简，身因谢客肥。\n由来耽寂寞，不是贵知希。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过修竹馆赠朱汝修","author":"袁宗道","text":"名理兼文藻，君齐高士踪。\n温醇馀道气，清瘦带诗容。\n乌几竹光映，蜗墙藓晕重。\n开尊坐秋雨，相对兴偏浓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜登楼偶成 其一","author":"袁宗道","text":"凉夜谁堪语，登楼忆所亲。\n无机瓶共我，解事酒随人。\n未老灰心客，初秋病肺身。\n山南田二顷，归计未全贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜登楼偶成 其二","author":"袁宗道","text":"可叹人间事，深杯且自斟。\n啖名多局面，谋国半嗔心。\n露下泫风叶，秋高冷夜砧。\n腐儒无处着，只合住山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月下萧允升、顾开雍集小斋赋此 其一","author":"袁宗道","text":"偶集翻成乐，幽花晚更妍。\n近窗云片薄，过树月光全。\n小筑真同隐，清酣也近禅。\n莫愁沽酒尽，囊内有餐钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月下萧允升、顾开雍集小斋赋此 其二","author":"袁宗道","text":"宇宙信空阔，方外多友生。\n世情到口厌，名障入心轻。\n月写风枝影，人惊夜雀声。\n射堂千亩雪，乘醉更同行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬日斋中即事 其一","author":"袁宗道","text":"小径独相徉，婆娑木数章。\n叶稀邻屋见，根老假山苍。\n酒浊贤人味，衣熏道士装。\n看经心向倦，添火静薰香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬日斋中即事 其二","author":"袁宗道","text":"绳床尽日凭，垒石对崚嶒。\n愁见叩门客，幽如退院僧。\n花藏寻伴鸟，风折罥衣藤。\n检点人间事，疏慵总不能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同黄昭素、昭质及两弟夜饮顾升伯斋中","author":"袁宗道","text":"狭室下帘暖，小窗爱月幽。\n沈香黏大白，诙语跃平头。\n花鸟谈吴事，山川叙蜀游。\n霜光犹可醉，道去即宜浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晨起","author":"袁宗道","text":"竹窗朝受日，棐几对维摩。\n怪石僵枯藓，虬松葺老柯。\n毫冰胶砚薄，檐溜入瓶多。\n此地安禅好，无烦客侣过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺人禅诵甚勤，喜赠二首 其一","author":"袁宗道","text":"应是新年福力增，六时功课胜山僧。\n每持贝叶询难宇，时向蒲团学小乘。\n一缕天风吹梵呗，半轮闺月照香灯。\n却惭庞叟心情懒，拥衲齁齁呼不应。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闺人禅诵甚勤，喜赠二首 其二","author":"袁宗道","text":"高楼终日礼弥陀，天女生来厌绮罗。\n愿以幻身酬半偈，羞将素额涴长蛾。\n绣幡针脚花还密，诵咒乡音字欲讹。\n自是灵山佳姊妹，何缘结伴到娑婆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读李洞诗","author":"袁宗道","text":"才子如君剧苦寒，青衫垂老忆长安。\n奇愁酝酿千篇险，褊性支吾半世难。\n五字赠僧尤峭拔，孤魂吊月应辛酸。\n只馀身后遗编在，世上谁人洗眼看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日闲居 其一","author":"袁宗道","text":"人间何物度朝昏，懒性新来更厌喧。\n除却跏趺惟饮酒，才闻呵殿便关门。\n虚窗月上摹松影，尘榻僧来印衲痕。\n独有盆梅嫌寂寞，故舒丹蕊照清樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日闲居 其二","author":"袁宗道","text":"不才敢拟子云玄，索米金门又一年。\n风味渐随双髻减，天真犹仗一樽全。\n破冰滴砚展笺易，扫地安单夜坐禅。\n闲洗时瓶烹岕茗，故人新寄玉山泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日闲居 其三","author":"袁宗道","text":"人海何妨一粒藏，身闲稍觉昼壶长。\n厌将礼法绳腰骨，且看经钞浇肺肠。\n画里身黏苍壁色，梦中魂染白莲香。\n春来最是城西好，拟共山僧坐绿杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即事","author":"袁宗道","text":"小楼朱几供旃檀，夜引闺人忏法坛。\n净似远公尚剩发，贫如陶令未休官。\n舍完儿女忙何事，典却田园醉不难。\n检点近来痴业少，不随人舌浪悲欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶得放翁集，快读数日志喜，因效其语","author":"袁宗道","text":"模写事情俱透脱，品题花鸟亦清奇。\n尽同元白诸人趣，绝是苏黄一辈诗。\n老眼方饥逢上味，吟脾正渴遇仙医。\n明窗手录将成帙，恰似贫儿暴富时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得残月似新月","author":"袁宗道","text":"一钩曾挂暮霞里，半玦还悬晓雾中。\n醉起忽迷钟早晚，山行误认峰西东。\n从他乌历支干换，且喜蛾眉首尾同。\n安得人生也似月，苍颇皓首又如童。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄主客邀送高户部，时开筵夷馆","author":"袁宗道","text":"仙郎别署饮休辞，春冷何堪送所知。\n羸马冻蹄蹂雪径，饥乌寒距蹴风枝。\n夷笺细字摹唐帖，胡髻尖毡缀汉丝。\n一曲龟兹君莫讶，也堪翻出渭城诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":45812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]