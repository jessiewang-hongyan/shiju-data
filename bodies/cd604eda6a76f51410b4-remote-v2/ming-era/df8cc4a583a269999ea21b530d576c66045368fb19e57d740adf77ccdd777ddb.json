commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50100,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"洪武庚辰八月一日为抚安人民至衣锦乡访安湖书院拜先圣殿谒先贤祠栋宇倾挠廊庑荒茀顾瞻感叹念欲兴修兹焉经始以俟毕工历初十日夜坐挈矩堂新月满庭谩尔兴怀成五言近体十首时儒生钟民敬亦次余韵以纪一时之清兴也 其七","author":"唐文凤","text":"问月月不荅，留云云自行。\n江山应有待，天地岂无情。\n苍狗形须变，青鸾影更明。\n一杯聊复尔，漫听浩歌声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50101,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"洪武庚辰八月一日为抚安人民至衣锦乡访安湖书院拜先圣殿谒先贤祠栋宇倾挠廊庑荒茀顾瞻感叹念欲兴修兹焉经始以俟毕工历初十日夜坐挈矩堂新月满庭谩尔兴怀成五言近体十首时儒生钟民敬亦次余韵以纪一时之清兴也 其八","author":"唐文凤","text":"不尽吟诗趣，徘徊欲二更。\n乱星浮酒瓮，孤月煮茶铛。\n此夜朋徒兴，他乡兄弟情。\n平生仗忠信，抚事不须惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50102,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"洪武庚辰八月一日为抚安人民至衣锦乡访安湖书院拜先圣殿谒先贤祠栋宇倾挠廊庑荒茀顾瞻感叹念欲兴修兹焉经始以俟毕工历初十日夜坐挈矩堂新月满庭谩尔兴怀成五言近体十首时儒生钟民敬亦次余韵以纪一时之清兴也 其九","author":"唐文凤","text":"得酒晓仍饮，寻思夜更哦。\n人心应复尔，吾道竟如何。\n蟾影一池静，蛩声四壁多。\n百年斯道重，未用叹蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50103,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"洪武庚辰八月一日为抚安人民至衣锦乡访安湖书院拜先圣殿谒先贤祠栋宇倾挠廊庑荒茀顾瞻感叹念欲兴修兹焉经始以俟毕工历初十日夜坐挈矩堂新月满庭谩尔兴怀成五言近体十首时儒生钟民敬亦次余韵以纪一时之清兴也 其十","author":"唐文凤","text":"问俗经村落，周行途路难。\n端严元有道，澹泊若无官。\n报国寸心赤，忧民两鬓斑。\n位卑才更拙，谁为达朝端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50104,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和游新吴寺诗韵有小序 其一 黄字","author":"唐文凤","text":"步屧响回廊，庭虚月一方。\n栴檀云弄影，薝卜夜吹香。\n禅定猿窥钵，经残鹤护房。\n明朝觅归路，满地叶飞黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50105,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和游新吴寺诗韵有小序 其二 叶字","author":"唐文凤","text":"招提境清幽，小径萦曲折。\n登高目可舒，揽秀意犹惬。\n石坛花雨飘，琴室松风歇。\n向晚偶题诗，写遍寒蕉叶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50106,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和游新吴寺诗韵有小序 其三 前字","author":"唐文凤","text":"驮经白马寺，创额赤乌年。\n宗续云门法，心参雪窦禅。\n松高留鹤语，树老蜕龙悬。\n长日翻经罢，蒲团礼佛前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50107,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和游新吴寺诗韵有小序 其四 朝字","author":"唐文凤","text":"倚杖閒寻寺，吟诗忽过桥。\n晚山含雨暗，秋水共天遥。\n自愧花封治，难从桂隐招。\n婆婆游世界，钟鼓乐清朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50108,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和游新吴寺诗韵有小序 其五 寺字","author":"唐文凤","text":"涯洲地幽深，寻僧聊小憩。\n名山在寰区，胜境异人世。\n涧寒龙已归，村深虎初逝。\n上方钟磬声，疑是云门寺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50109,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"万安县","author":"唐文凤","text":"小小万安县，潺潺惶恐滩。\n江流章贡水，地接吉筠山。\n产薄赋应少，民稀政自閒。\n为言赵大尹，解任几时还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50110,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"永和镇","author":"唐文凤","text":"永和古名市，益国是家乡。\n窑变胚胎器，街存瓦砾墙。\n山川夺秀色，天地启珍藏。\n寂寞书台在，茫茫春草长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50111,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"螺子山","author":"唐文凤","text":"山名螺子小，苍翠欲参天。\n势压崆峒外，形凝混沌前。\n琳宫浮紫气，梵宇出青莲。\n吾欲投簪绂，归耕老石田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50112,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吉水县","author":"唐文凤","text":"邑号古西昌，相传文物乡。\n栽花令尹宅，擢桂状元坊。\n江泻吉文字，山凝秀色苍。\n晓来春两霁，新绿柳丝长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50113,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"清江镇","author":"唐文凤","text":"镇市清江上，居民栋宇连。\n淮盐堆客肆，广货集商船。\n草色春迷地，波光暖浸天。\n凌晨征棹发，万灶起炊烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50114,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丰城县","author":"唐文凤","text":"小县枕江滨，人家柳色新。\n斗牛空紫气，天地已青春。\n士俗犹追古，民风颇化淳。\n文安今寂寞，千古老儒臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50115,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"徐孺子亭","author":"唐文凤","text":"高士亭今废，遗基俯碧流。\n声名著东汉，人物重南州。\n友致生刍奠，宾延下榻留。\n平生惟食力，禄仕岂曾谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50116,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"望湖亭","author":"唐文凤","text":"一上望湖亭，湖山四面青。\n天开浮碧落，水阔接沧溟。\n蛟窟人怀惧，龙祠客乞灵。\n老年思补报，短发恁星星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50117,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"落星石","author":"唐文凤","text":"女娲曾炼石，上补列星躔。\n遗质传千古，流光下九天。\n龙文犹照日，虹气欲生烟。\n水落年年在，西风几泊船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50118,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖口县","author":"唐文凤","text":"万里长江远，扁舟一叶孤。\n山连彭泽县，水接洞庭湖。\n客市鱼堪买，人家酒可沽。\n丹心频念阙，指日到皇都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50119,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖口观音阁","author":"唐文凤","text":"杰阁枕江浒，登临为落帆。\n天开兜率境，波浸补陀岩。\n僧设伊蒲供，经翻贝叶函。\n村醪浇旅况，吾欲典春衫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50120,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"彭泽县","author":"唐文凤","text":"欲问柴桑里，来寻陶令家。\n菊香无旧蝶，柳色有新鸦。\n云净浮青嶂，潮回拥白沙。\n县街今寂寞，酒贵不堪赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50121,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"马当峡夜泊","author":"唐文凤","text":"夜泊马当峡，潮归龙起风。\n往来千里外，辛劳五年中。\n每叹零丁客，多惭矍铄公。\n天空明月出，故故照孤篷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50122,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"佛指峡阻风","author":"唐文凤","text":"佛指喜名峡，客心惊阻风。\n江山应有待，天地更能容。\n民俗思遗爱，臣心秉至公。\n老年频念阙，矫首五云东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50123,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再留佛指峡","author":"唐文凤","text":"昨日雨犹少，今朝风更多。\n江吞大信水，峡束小孤波。\n万事古如此，百年今若何。\n明当发征棹，沽酒一高歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50124,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"佛指峡舟中见月有感 其一","author":"唐文凤","text":"长江夜景沈，风急扫顽阴。\n鸟鹊高枝稳，鱼龙积水深。\n月藏万古魄，人老百年心。\n抱膝閒吟罢，羁怀苦不禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50125,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"佛指峡舟中见月有感 其二","author":"唐文凤","text":"去县离百日，思乡隔万山。\n民心应久望，月色自长閒。\n江隐蛟螭窟，天开虎豹关。\n姮娥如有意，清影照苍颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50126,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"佛指峡舟中见月有感 其三","author":"唐文凤","text":"阻风愁不柰，见月喜何如。\n蟾影涵苏魄，龙光烛太虚。\n斗间觇紫气，颔下现丹书。\n桂阙群仙降，天香拂袖裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50127,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"佛指峡舟中见月有感 其四","author":"唐文凤","text":"三日留孤峡，风狂浊浪高。\n寸心驰去楫，微命托轻舠。\n阿阁来仪凤，神山载巨鳌。\n五云天阙近，朝罢谒铨曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50128,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"佛指峡舟中见月有感 其五","author":"唐文凤","text":"来日当残腊，归期及暮春。\n眼看今夜月，心切故乡人。\n浪息烦风伯，舟安托水神。\n冯唐何用叹，未误百年身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50129,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"离佛指峡","author":"唐文凤","text":"空传佛指现，不念佛心慈。\n怒浪排空猛，惊风入夜痴。\n峡青花雨坠，江碧柳烟垂。\n此地稽留苦，王程敢后期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50130,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊雷港有作 其一","author":"唐文凤","text":"大江风浪急，雷港暂停舟。\n桅直黏云立，帆轻带雨收。\n苇蒲连浦溆，杨柳暗汀洲。\n每羡渔家乐，谋生不外求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50131,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊雷港有作 其二","author":"唐文凤","text":"雷港沙堆浦，春江浪拍空。\n一时潮信雨，三月石尤风。\n飞退无来鹢，归迟有去鸿。\n故乡朋旧在，何日酒尊同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50132,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊雷港有作 其三","author":"唐文凤","text":"昨日又今日，百年能几年。\n暮云青峡雨，春水白鸥天。\n宁戚歌牛下，昌黎拜马前。\n平生恁流止，志气肯祈怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50133,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泊雷港有作 其五","author":"唐文凤","text":"舟子行舟缓，淹留十月程。\n人心谁会意，王事我关情。\n风暖江波定，云晴浦月生。\n故乡何处是，迢递望徽城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50134,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"横石矶","author":"唐文凤","text":"横石倚渔矶，狂风浪激飞。\n山头云覆帽，地骨草成衣。\n城绕江三面，天连水四维。\n人家柳汀上，沽酒卖鱼肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50135,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吉阳镇","author":"唐文凤","text":"吉阳传旧镇，巡徼复新司。\n烧劵不我责，弃繻当自期。\n江空云幂幂，天阔雨丝丝。\n肯谓吾衰矣，心犹少壮时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50136,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雁汊","author":"唐文凤","text":"小河流雁汊，巨浸接龙湾。\n碧泻九江水，青迎两县山。\n老添新白发，愁减旧红颜。\n酒助诗神壮，挥毫思不悭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50137,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"长枫峡","author":"唐文凤","text":"篙师用力健，帆驶拂云低。\n浪涌长枫峡，沙平短柳堤。\n雨轻鱼性熟，风暖鸟声齐。\n酒醒诗成后，蛮笺手自题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50138,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拿檛石","author":"唐文凤","text":"乱石累堆小，崭岩高丈寻。\n一拳浮水面，千古镇江心。\n鹳鹤栖巢稳，蛟龙宅窟深。\n晚来閒极目，独独自长吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50139,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"马踏石","author":"唐文凤","text":"何年天马下，踏碎石纷纷。\n迹印荥河种，蹄奔沙苑群。\n深涵三月浪，乱点一江云。\n晚泊维舟处，微风酒半醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50140,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"池口镇 其一","author":"唐文凤","text":"迫暮宿池口，维舟舣渡头。\n城依孤嶂耸，水入大江流。\n市小无盐肆，年饥有米艘。\n人生忙底事，閒杀羡沙鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50141,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"池口镇 其二","author":"唐文凤","text":"验劵巡司下，停舟水驿前。\n远山常隐雾，巨浸欲吞天。\n小市鱼虾集，长汀鸥鹭眠。\n旅情何太苦，搔首意茫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50142,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅根市","author":"唐文凤","text":"寂寞梅根市，潮回岸拥沙。\n柳边维客艇，树底著人家。\n山暝云含雨，江晴水映霞。\n晓来篷下坐，开镜整乌纱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50143,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"六百丈","author":"唐文凤","text":"地长六百丈，江阔一千寻。\n章亥足曾步，玄夷梦未临。\n山川古域在，岁月逝波深。\n自是操吴语，何烦效越吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50144,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"铜陵县","author":"唐文凤","text":"见说铜陵县，相传我祖风。\n抱经曾擢桂，授职已哦松。\n水木情何极，江山兴不穷。\n文孙事寻访，父老指遗踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50145,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟过铜陵得风","author":"唐文凤","text":"累日逢狂浪，凌晨得顺风。\n舟轻如驶马，帆快若征鸿。\n鼻祖政犹在，文孙道未穷。\n南京天阙近，王气郁葱葱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50146,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚泊神福镇 其一","author":"唐文凤","text":"镇有将军庙，徐君几代孙。\n操戈忠更切，挂剑谊尤尊。\n虽享千年祀，难招百战魂。\n神灵频锡福，落日大江吞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50147,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚泊神福镇 其二","author":"唐文凤","text":"古镇名神福，将军有庙庭。\n水光浮日白，山色隔江青。\n鱼化长生浪，鸥惊不下汀。\n丁宁一杯酒，此地慰漂零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50148,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚泊神福镇 其三","author":"唐文凤","text":"生居治平世，老遇圣明时。\n日月无私照，江山有后期。\n潮痕添雨见，花信得春知。\n晚泊吟眸豁，微风飏鬓丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50149,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚泊神福镇 其四","author":"唐文凤","text":"水暖沙堆浦，江深浪激矶。\n柳花黏燕薄，芦笋荐鱼肥。\n事业方从拙，生涯计任非。\n怀忠惭食禄，应笑泣牛衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50150,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"荻港","author":"唐文凤","text":"小港纡平岸，长江捲怒涛。\n人心鼠投穴，我志鹤鸣皋。\n阴霭村墟隐，悲风日夜号。\n持衡频考绩，清裁属东曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50151,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"版子矶","author":"唐文凤","text":"分港杀波急，突矶攒石多。\n天寒吼犀兕，浪暖斗蛟鼍。\n东海鞭难塞，南山叩更歌。\n年年形胜在，人世几经过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50152,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月子河","author":"唐文凤","text":"天近星姑渚，江分月子河。\n矶头蹲虎石，沙觜漾鸥波。\n白水连淮阔，青山入楚多。\n往来无阻险，鼓枻一长歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50153,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月子河午泊","author":"唐文凤","text":"河口初停楫，江心又挂帆。\n水光摇去旆，雨气袭征衫。\n薄俗空腾谤，清朝肯畏谗。\n神祠千古壮，高倚石崭岩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50154,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三山镇","author":"唐文凤","text":"镇挹三山耸，江通二水流。\n惊涛捲地起，怒吹挟云浮。\n投檄昌黎伯，乘槎博望侯。\n平生远游志，何日到瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50155,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三山顺风渡江","author":"唐文凤","text":"三山离镇远，一棹渡江来。\n月出鲛人泣，潮归龙子回。\n持心绝思虑，抚事去惊猜。\n向晚情何适，诗成句稳裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50156,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"螃蟹矶","author":"唐文凤","text":"小小鸬鹚艇，团团螃蟹矶。\n客帆朝落影，渔火夜藏辉。\n圩阔稻粱熟，汀长芦叶稀。\n江乡如可隐，吾欲问东归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50157,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和尚港","author":"唐文凤","text":"人传和尚港，春水没渔矶。\n不见浮杯渡，空闻飞锡归。\n鲥鱼三月美，螃蟹九秋肥。\n惆怅玄真隐，衰年与愿违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50158,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"鲁港","author":"唐文凤","text":"鲁港停舟处，相逢故老谈。\n河鱼时泼剌，江燕又呢喃。\n带雨张帆腹，临风拂剑镡。\n百年董狐笔，愤死木绵庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50159,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"枭矶","author":"唐文凤","text":"拳石耸江中，波流四面同。\n今传神显异，昔诧女英雄。\n巴蜀经营远，荆吴割据通。\n魂归思故国，不祀永安宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":50160,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]