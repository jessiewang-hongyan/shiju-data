[{"title":"旅中早秋","author":"孙绪","text":"商飙动凉吹，谁念旅中孤。\n白发二亲景，黄尘千里途。\n家山秋断雁，庭树夜多乌。\n凄凉悲往事，潦倒笑今吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16997,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三忠祠","author":"孙绪","text":"拂袖拜三贤，云霞映暮天。\n孤忠徒自许，一死竟谁怜。\n玄化昭心事，丹诚付简编。\n明禋逢盛世，肸蚃自年年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16998,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"池亭晚坐有怀","author":"孙绪","text":"池上晚成趣，雨馀凉不禁。\n湿云低阁水，痴雾远迷林。\n去马凭谁辨，哀蛩识此心。\n美人在何处，良夜自沈沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16999,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"烂柯图","author":"孙绪","text":"不畏山蹊险，来参国手仙。\n两贤岂相厄，一著竟谁先。\n苔滑经微雨，松声应瀑泉。\n楸枰才半局，柯烂已多年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17000,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"居庸关公署晚眺","author":"孙绪","text":"一径崎岖万岭横，居民无地问农耕。\n霜摧落叶晚山绿，雨溜荒苔秋水清。\n沙鸟远从天外度，寒蛩爱向月中鸣。\n峰峦徙倚休回首，何处孤云是故城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17001,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"苏武","author":"孙绪","text":"汉皇屈指计归期，十九年中事可疑。\n一死从容真细事，匹夫沟渎竟谁知。\n风彫使节丹心壮，雪压河梁绿水澌。\n珍重李陵多问讯，羝羊将乳雁来时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17002,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送范景曦任伴读","author":"孙绪","text":"直节当年振士林，玉堂门下识翁深。\n王家伟望联甥舅，贾傅才名重古今。\n到处溪山供好句，旧园桃李接新阴。\n人生何地非勋业，莫谓青毡负此心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17003,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送友人还济南","author":"孙绪","text":"伐檀踪迹满河干，欲振家声剑自弹。\n侍綵又添冠服好，扫松未觉岁时难。\n舟移汶水愁分郭，酒尽燕山愧识韩。\n向后停云如有什，年年鸿雁到长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17004,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"姚义士为亡友经纪曲尽","author":"孙绪","text":"世态纷纭自浅深，共轻然诺重黄金。\n如君真可同生死，尚友何须论古今。\n百代争看高士传，九原应慰故人心。\n浮云却笑东邻富，终日营营雪满簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17005,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游孙文选伯坚旧圃有感","author":"孙绪","text":"前日来看此众芳，科头相对笑声长。\n联床衷曲成新梦，去国身轻忆旧装。\n千古勋名关道义，几人点检愧行藏。\n閒花真是无情物，争向春风弄晚香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17006,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽黄兵部实夫乃正","author":"孙绪","text":"青鸾飞去夜堂寒，身后身前万虑殚。\n失口有时谈旧事，伤心何日到新安。\n短床衾枕如相念，破釜糟糠不可餐。\n莫羡上林花卉好，一春风雨坐凋残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17007,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"牡丹次韵","author":"孙绪","text":"半捲罗帏识卫娥，东风清露醉颜酡。\n分来天上香犹在，欲问洛阳春几何。\n明媚不须还解语，招摇若为对高歌。\n花前莫惜日沉醉，回首南薰绿树多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17008,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵赠刘文选乃翁大参致政","author":"孙绪","text":"佳雏文彩绚朝晖，老凤云霄已倦飞。\n当宁有思高士去，旧山无恙主人归。\n使车光映行边月，小涧春香梦里薇。\n却忆扶筇寻乐处，回头深愧此朝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17009,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭同年孟汝珍","author":"孙绪","text":"赋罢长杨梦奠楹，尽将经济负生平。\n北堂奄弃三迁教，东野空留一日名。\n物理有心摧俊杰，人生无福是聪明。\n妻儿共抱终天恨，洒泪新阡草正荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17010,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"新朝钟次韵","author":"孙绪","text":"神功陶铸火初停，神物还堪太史铭。\n万籁敛声归大冶，百僚洗耳试新听。\n鸣随仙仗元无戾，气应铜山固有灵。\n叩罢在悬清昼永，班行终见肃仪刑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17011,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寿同年钱士弘七十","author":"孙绪","text":"东湖鱼鸟日悠悠，石火茶烟称钓舟。\n万首古风今七帙，一轮新月欲中秋。\n堂閒绿野饶笙鼓，心远红尘任去留。\n谩道渭姜犹健步，十年前已赋知休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17012,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"省曹夜宿怀周希沂时周亦宿兵曹","author":"孙绪","text":"何人只隔短墙东，咫尺墙头百感通。\n缓坐漫吟秋雨叹，相思深恨暮云笼。\n半生乖蹇谁知己，一代风标愧此公。\n凝望夜阑翻自笑，不知清梦若为同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17013,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送施彦器还台州","author":"孙绪","text":"几载沧江伴白鸥，瀛南蓟北旧同游。\n野云有意终归岫，暮景伤心独倚楼。\n秉烛对君真梦寐，高踪何处最淹留。\n儿童未解经过地，嬉笑争看郭细侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17014,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"代人送张黄门弘至使安南颁正朔","author":"孙绪","text":"蚤将文彩重班行，节映槎星夜有光。\n恩向旧袍添上服，口衔新命到南荒。\n江山改色迎龙集，岛屿同声羡凤阳。\n收拾诗怀问民瘼，归来还入谏垣章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17015,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过沙河舟几覆次陈内翰本初韵","author":"孙绪","text":"旧见沙河自坦途，波涛今日胜彭湖。\n仙舟深愧汉名士，鱼腹将吞楚大夫。\n笔底咏歌成谩兴，眼前生死未须图。\n独怜千里高堂上，新寄平安书到无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17016,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬夜私归省父望家有作","author":"孙绪","text":"村巷无人树有声，皎星寒月照孤城。\n缁尘征橐儿千里，白发高堂夜屡惊。\n膝下承欢真梦寐，灯前细语自丁宁。\n回头莫语燕山道，一品公孤俱浪名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17017,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张二尹赴铨司","author":"孙绪","text":"尘埃无处著诗囊，双耳松风万虑忘。\n墨迹妙传王内史，青袍不负段南阳。\n高谈邃古身如寄，回首疲民思倍伤。\n莫向离筵惜沉醉，卫河东下水茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17018,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送族兄炳分教广灵","author":"孙绪","text":"惜别时时问去程，桑乾西下暮山平。\n缁尘双眼还云树，清夜孤灯此弟兄。\n官舍独寒怜郑老，夷门未许困侯嬴。\n春风桃李看勋业，况复庭槐渐长成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17019,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同年朱宜直号松山","author":"孙绪","text":"树影前山吏隐深，临风磐石坐披襟。\n光含庭院香生昼，寒入郊墟觉苦心。\n万仞不妨高立壁，四方从此望清阴。\n补天柱国如相问，不比凡材满邓林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17020,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黄冈张儒士清河张尹弟也上便宜七十五事既赐施行矣买舟南还搢绅多赋诗 其一","author":"孙绪","text":"笑指书囊望帝都，敝裘孤剑怯长途。\n策能匡世名安用，言入危机迹更孤。\n万里云霄看德业，几人廊庙愧江湖。\n黄冈别墅应无恙，日日春风长绿无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17021,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"黄冈张儒士清河张尹弟也上便宜七十五事既赐施行矣买舟南还搢绅多赋诗 其二","author":"孙绪","text":"楚江孤月水如罗，双桨轻摇自啸歌。\n瑞鹤圆吭鸣赤日，大鸿寒影在清河。\n平沙漠漠山城小，世路悠悠野径多。\n父老莫惊风采异，麻衣曾许拜銮坡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17022,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送赵地官叔鸣","author":"孙绪","text":"珍重平生契谊深，水萍踪迹又分襟。\n时名到处惭同志，易学何人识苦心。\n小试馀才清会计，还看高兴逐登临。\n海天云树今千里，风雨明朝思不禁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17023,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"挽强都宪","author":"孙绪","text":"尽卷经纶地下藏，荒原烟树夜微茫。\n幽冥有恨空长剑，江汉无惭此素裳。\n孤垒终还天未远，一封曾与日争光。\n奇勋随处题名在，过客惟看豸史坊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17024,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送熊绣衣按东广便道省亲","author":"孙绪","text":"一鞭风采过家山，宦境人争羡此还。\n昼锦雅宜供戏綵，霜威暂破为承颜。\n笙歌夜簇驩声永，杖屦春生乐意閒。\n明日便临东广路，琼崖矗矗水潺潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17025,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送焦阁老致仕","author":"孙绪","text":"忍笑投簪出禁林，都门黄叶报秋深。\n苍生其柰东山卧，湖海谁知后乐心。\n舟载夕阳横野渡，堂閒清昼看槐阴。\n钓游旧地俱无恙，藜杖从今得再寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17026,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送刘阁老还乡祭扫","author":"孙绪","text":"清风千里送仙舟，诏许南归拜垄丘。\n满路传呼新使相，三朝勋业旧通侯。\n秋霜落木逢尝荐，昼锦看山是胜游。\n天子临轩方注望，北来旌旆莫悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17027,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送廖彦还琼州","author":"孙绪","text":"南国常悬北蓟思，海天空阔雁飞迟。\n孤航万里心尤壮，绿酒青灯喜可知。\n别调埙篪新按拍，撼庭风雨柰归期。\n水萍踪迹浑閒事，莫向垂杨叹别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17028,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"漫兴","author":"孙绪","text":"尽卷经纶付杖藜，芒鞋一任路多岐。\n风来高树鸟争噪，云满秋山人未知。\n兰桂有怀营北渚，簸扬何计问南箕。\n陇梅驿使无消息，去去奚奴莫太迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17029,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"擂茶","author":"孙绪","text":"何物狂生九鼎烹，敢辞粉骨报生成。\n远将西蜀先春味，卧听南州隔竹声。\n活火乍惊三昧手，调羹初试五侯鲭。\n风流陆羽曾知否，惭愧江湖浪得名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17030,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梅花","author":"孙绪","text":"北雪寒云未可亲，玉容肯受朔风尘。\n月从开后疑无色，天向枝头别有春。\n隔屋冻林还映水，到窗寒影自宜人。\n年来不作调羹梦，荒圃疏篱意最真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17031,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送李公遇少参回憩周溪寺","author":"孙绪","text":"雪消幽径大师房，新茗供棋笑语长。\n南去故人今数里，东家昨夜忆连床。\n坐闻清梵心无累，地隔红尘水亦香。\n明日回思又陈迹，卫河云树晓苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17032,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"莎汀四首 其一","author":"孙绪","text":"霜厓高处听渔歌，日日壶觞藉浅莎。\n沙上凫雏还聚散，渭滨熊兆近如何。\n潮通沧海波声远，地隔红尘月色多。\n双眼不容云树碍，一帘终夜对明河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17033,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"莎汀四首 其二","author":"孙绪","text":"入望青青莎径深，西风落日力难任。\n叶垂清露泽通涧，色暗湘帘山正阴。\n物态有情归地主，化机随处见天心。\n危阑侧近莫喧笑，下有蛟龙时一吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17034,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"莎汀四首 其三","author":"孙绪","text":"门前漳水日东流，水际閒汀草自柔。\n雨后繁枝青似织，风来学舞翠先浮。\n江湖渺渺还忧国，鸥鹭年年共此丘。\n寄与上林花木道，明年春色倍相酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17035,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"莎汀四首 其四","author":"孙绪","text":"断渚新莎日日生，蟠窗侵户总多情。\n晚风双屦苔应识，夜雨孤灯水自清。\n尺地未忘元化在，九天今见泰阶平。\n鸬鹚鹤鹳年年事，不及鹍鹏万里程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17036,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书董子祠壁","author":"孙绪","text":"云满空庭水满渠，颓垣曾见驻安车。\n九天不尽三篇策，繁露无惭一亩居。\n谩说韩彭悲犬兔，肯同马郑注虫鱼。\n茂陵勋业今安在，俎豆春风自有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17037,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送韩宗器","author":"孙绪","text":"鬓如野鹤意如鸿，万籁都归一笑中。\n夜雨对床谈聚散，秋云无蒂任西东。\n青袍不惜连朝醉，素履何惭太古同。\n闻说梦熊消息近，由来天道本如弓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17038,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重游陵县乾明寺","author":"孙绪","text":"不扣禅关三十年，遥岑烟水故依然。\n雀归古堞客方到，虫篆残经僧未眠。\n黄叶一庭秋瑟瑟，清风四壁夜娟娟。\n侯芭渐老知无用，惭愧何人守太玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17039,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"元宵后大雪访吕凤仪次戈宇清李公从马嘉贞联句韵","author":"孙绪","text":"北望衡茅信脚行，向人风雪自多情。\n孤村梅影怜春瘦，穿土萱芽待晚晴。\n斜日平林云渐薄，方塘活水鉴同明。\n鹍程终见归鹓序，未许鸥盟老此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17040,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"诞日宿周溪寺","author":"孙绪","text":"石上残经拥绿苔，鲜飙轻露藉疏槐。\n流光过眼都成幻，逸兴横秋未易裁。\n释氏当年亲抱送，梵宫今日又重来。\n凭君莫话悬弧事，一刻谈空万念灰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17041,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"重游周溪寺感旧","author":"孙绪","text":"拂尘细看旧题名，风景依然百感生。\n一径松萝惊白发，十年林莽愧青萍。\n悠悠往事真成梦，寂寂空门此寄情。\n却忆故人在京洛，湘帘低簇晓堂清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17042,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病中次杨师文见寄韵二首 其一","author":"孙绪","text":"到处轻车压路尘，閒愁如觅妒佳辰。\n溪山千里共明月，风露一庭怜此身。\n花外断鸿新物色，水边骢马认游人。\n陈蕃旧榻应无恙，记得当年吐锦茵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17043,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"病中次杨师文见寄韵二首 其二","author":"孙绪","text":"长铗床头半欲尘，笑谈去岁忆兹辰。\n碧山百感雨风夜，沧海几年萍梗身。\n渴爱江梅凭驿使，兴随沅芷怨骚人。\n何当一醉仙茅酒，共卧林亭绿草茵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17044,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清明夜与诸友围棋观音寺","author":"孙绪","text":"行人侧耳听棋声，败屋残灯夜未平。\n满树风威随白战，半庭月色趁清明。\n冥心似悟门中味，真境堪忘世上情。\n欲向蒲团醒大梦，东林深处问啼莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17045,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再题友人故居用前韵","author":"孙绪","text":"恒山西望隔年馀，何处山椒问起居。\n一曲紫箫还院落，半庭红叶忆衣襦。\n尘缄诗壁萤空度，云满寒塘鹤正癯。\n莫向藜床谈旧事，秋风秋雨自街衢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17046,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬夜宿李乂修太守宅话旧 其一","author":"孙绪","text":"屈指同游四十年，感今怀昔夜潸然。\n共惊岁月奔如电，谩说蓬瀛别有天。\n湖海自怜输陆羽，庙廊谁复似韦贤。\n何如满饮杯中物，醉向藤床抱瑟眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17047,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬夜宿李乂修太守宅话旧 其二","author":"孙绪","text":"怯寒独拥骕骦裘，庭木号风夜未休。\n感客赋成天动色，美人歌罢月如钩。\n园池葱郁看新第，村巷依稀忆旧游。\n别后思君何处是，漳河日日水东流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17048,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬夜宿李乂修太守宅话旧 其三","author":"孙绪","text":"绿酒青灯夜未央，酒酣还忆旧庭堂。\n帘栊扑地晓风细，花木满阶春昼长。\n书剑都归缑氏学，儿童亦识郑公乡。\n年来奔走知何用，一涕汍澜此素裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17049,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汉阴亭题壁","author":"孙绪","text":"菜有新芽药有丛，十年抱瓮小亭东。\n栽培敢借三时力，枯槁终期一雨功。\n烈暑满庭欺枕簟，浮云何处自帡幪。\n世人莫笑生涯拙，才撤机心即古风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17050,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送崔义甫之任汉阳幕 其一","author":"孙绪","text":"画船高岸紫纶巾，白鸟惊飞绿柳新。\n地远共怜家落莫，官卑偏觉路逡巡。\n风生洲渚三湘水，日落江湖万里身。\n莫倚危樯频北望，楚乡云树易愁人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17051,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送崔义甫之任汉阳幕 其二","author":"孙绪","text":"宿雾迷云黯未收，壮心宦况渺难留。\n凌风雕鹗常侵蚤，到日鲈鱼正及秋。\n千里不堪垂老别，一经敢负少年游。\n湖南何处温生幕，江雨潇潇汉水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17052,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭孟子乾行人三首 其一","author":"孙绪","text":"卧病沧江岁月深，每逢京使问佳音。\n乘骢事业期平步，倚马才名竟陆沉。\n一日纷纭惊白昼，孤囊经史忆青衿。\n泉台漠漠空长剑，天宇茫茫自古今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17053,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭孟子乾行人三首 其二","author":"孙绪","text":"双泪阑干麻纻衣，素溪何日再渔矶。\n义当有激身如寄，死可无惭愿竟违。\n鹏翼九天孤众望，龙逢千古话同归。\n旧缄不忍重开读，肠断当年急手挥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17054,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭孟子乾行人三首 其三","author":"孙绪","text":"乘时狐鼠日凭凌，欲借朱云剑未能。\n独抗皂囊辉白日，肯将素履负青灯。\n乾坤回首成今古，陵谷何心自废兴。\n录荫共怜新上舍，踽凉谁念老中丞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17055,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭刘尧卿三首 其一","author":"孙绪","text":"老泪纵横湿佩裾，西风吹雨滴阶除。\n衰年宁受多情累，苦口曾输一得愚。\n江海几年真梦蝶，饥寒每出叹无驴。\n人生回首成陈迹，物理谁当问太虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17056,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭刘尧卿三首 其二","author":"孙绪","text":"秋声淅淅送深悲，往事悠悠只自知。\n四海未家怜立壁，孤村何日再围棋。\n精英彷佛还谈笑，道路喧传半信疑。\n西望停云肠欲断，短檠清泪夜阑时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17057,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭刘尧卿三首 其三","author":"孙绪","text":"绿树青蒲野水滨，萧条僧寺静无邻。\n半床不寐同听雨，一局成功诧有神。\n屈指旧驩才两月，伤心犹记誓三辰。\n他年再过村西路，忍见开樽聪上人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17058,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"漫兴","author":"孙绪","text":"行年五十未知非，漳水滩头独掩扉。\n万里归来双鬓在，一经真与众情违。\n月明古渡渔灯暗，秋尽空山木叶飞。\n今我故吾何必问，望中星宿渐依稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":17059,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]