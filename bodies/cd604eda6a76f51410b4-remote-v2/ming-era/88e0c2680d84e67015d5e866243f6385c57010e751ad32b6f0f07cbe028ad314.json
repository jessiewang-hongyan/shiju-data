[{"title":"送方宪副定之备兵饶州","author":"欧大任","text":"使君千骑出长安，干越新开大将坛。\n番令古城楼橹壮，康郎春浪舳舻寒。\n军容班剑风云起，宾从胡床雪月残。\n遥想雅歌闲对酒，芝山应是几回看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬至斋居后惟敬夜过得残字","author":"欧大任","text":"君从紫阁宿高寒，下直还能访鹖冠。\n惇史书馀云未散，太常斋后雪初残。\n千官肃穆骖鸾辂，万骑周遭傍泰坛。\n闻道星辰环幄殿，侍臣执盖月中看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同文休承顾汝和黎惟敬于虎圈观西域所进狮子","author":"欧大任","text":"禁苑般般绕象舆，伏狮何幸仰宸居。\n风驱林邑千山外，云拥条支万里馀。\n清庙已歌天马曲，君王犹纳旅獒书。\n更闻九译来朝贡，太史编年在石渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲子元日早朝","author":"欧大任","text":"千官催入紫宸班，缥缈炉烟夹仗间。\n晓日洛中新甲子，春风燕甸旧河山。\n凯成骠骑频归阙，诏许呼韩近款关。\n共听太平元会曲，彩云飞处候龙颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经南内","author":"欧大任","text":"沉沉清禁转朱扉，深锁松阴碧石围。\n汉月曾窥青鸟去，朔云先拥白狼归。\n雅翻宫雪璚楼过，龙喷山泉玉殿飞。\n司竹老臣犹望幸，太平无事宴游稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登辽后妆楼","author":"欧大任","text":"綵槛雕阑半已荒，房栊树色隐苍苍。\n年深冻藓迷妆匣，人去秋云锁屧廊。\n玉镜尚悬辽海月，璚花不散蓟门霜。\n三千部落无劳望，鸭绿江头雁几行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上元日望大高玄殿灯火有赋","author":"欧大任","text":"太一祈年肃盛仪，灯前亲拜竹宫时。\n燎烟夕殿皆青玉，法供春筵尽紫芝。\n雍畤旧传周室礼，汾阴今侍汉家祠。\n云霄赋客多如雨，持橐何人独鬓丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送钟公琪改令博白","author":"欧大任","text":"移官因得故园游，津吏先迎郁水舟。\n监郡久知皮氏长，赐书还问偃师侯。\n装轻片石无劳载，山近丹砂且暂留。\n万里登台应北望，题诗须寄蓟门秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送徐别驾赴吉安","author":"欧大任","text":"监郡多闲见吏能，安成山水最堪称。\n黄牛石出疑巫峡，白鹭洲横似秣陵。\n客至高斋悬榻下，诗成燕寝异香凝。\n明年地主应携我，骑马青原更一登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨参军允恭守曲靖","author":"欧大任","text":"五陵冠盖祖行杯，万里楼船晓日开。\n越巂地形邛笮尽，盘江秋色叶榆来。\n客游南部能蛮语，家出西京自楚才。\n诸葛盟坛云树里，褰帷应向此登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林邦阳佥宪赴汴备兵陈州","author":"欧大任","text":"中原谈笑拥青油，吹角河山万里秋。\n猎骑风云生广武，蒐兵旌旆过鸿沟。\n尊前书记知能赋，戏下材官待运筹。\n不是玉关留客久，明年应得拜宸旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送文休承赴吉水文学","author":"欧大任","text":"家学吴门比陆机，一官犹着旧儒衣。\n执经讲肆诸生满，临帖山斋过客稀。\n雪浪每从章浦见，暮霞多入楚城飞。\n石渠金马徵贤日，时倚江云忆禁闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠光禄李少卿请告还缙云省觐","author":"欧大任","text":"班衣归去意何如，诏许仙都得暂居。\n客舍难忘光禄酒，卿家真见缙云书。\n听莺早过双溪水，下马先趋万石闾。\n须忆柏梁台上宴，天涯春色伴还车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送沈祠部以安奉使因归省湖州","author":"欧大任","text":"冠盖都亭揖玉鞭，故人多在蓟门天。\n千山梦寐为郎日，六传风云奉使年。\n綵服朝持新箬酒，白蘋春送太湖船。\n建章莫作经时别，御柳轻摇万树烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄徐子与","author":"欧大任","text":"汝南尊酒送征轮，何事君为去国人。\n汉日将军逢醉尉，楚天渔父识孤臣。\n瑶华独忆飘零远，金埒空闻贵幸新。\n早晚承明应再入，谁容烟艇五湖春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄濮州苏子川子冲兄弟","author":"欧大任","text":"闻君濮上卧烟萝，兄弟才名二谢多。\n玉树春风飞梦远，金茎佳气早鸿过。\n钓台艇畔庄周石，草阁帘前瓠子河。\n倘忆倦游梁苑客，可无书札慰蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王户部宅红梅花","author":"欧大任","text":"东阁名花许共攀，独怜疏影近雕阑。\n彩霞忽散春城色，绛雪犹飞夕照寒。\n梦想海棠巴子树，步随宫柳汉臣冠。\n关山莫遣吹横笛，留待江南醉客看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日同惟敬约卿过弘法寺访翠岩和尚","author":"欧大任","text":"鹿苑西连紫禁天，斋心曾问远师禅。\n五台戒向山中受，双树花从雨后悬。\n昼永鹤行春竹里，年深松偃石窗前。\n许询颇解閒来往，杖锡何妨结静缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同曾选部于野韩虞部子成夜集范职方于公宅","author":"欧大任","text":"匈奴远遁塞烟销，尊俎曾筹万里遥。\n士论总收燕騕袅，将材今数汉嫖姚。\n山公有启傅三署，水部能诗冠六朝。\n独笑荆高狂击筑，醉来犹自问金貂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答王百谷道馆病起对月见怀","author":"欧大任","text":"牍中新草献长杨，渴似相如鬓已苍。\n客去独吟松几月，僧来同掩竹斋凉。\n扁舟远兴因吴语，斗酒高歌学楚狂。\n东阁早闻奇士满，秋风吾有芰荷裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吕比部声甫守庐州","author":"欧大任","text":"虎竹初分霄汉间，庐江小吏候濡关。\n褰帷春雨劳农出，悬榻高斋送客闲。\n云起每从三祖石，鹤来曾过八公山。\n登楼不用怀京邑，早晚承明入计还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送冯屯部信伯补抚州","author":"欧大任","text":"襜帷南去问桑麻，江燕飞飞引旆斜。\n内史台边翻忍草，夫人坛上散明霞。\n铜陵夜月红泉酒，绣幕春风玉茗花。\n太小冯君称汉吏，赐金何日到天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答曾参戎子澄塞上行军见寄","author":"欧大任","text":"都亭别后忆驱驰，大漠听笳汉将悲。\n南去长缨曾自请，北来骠骑一相随。\n官刍召募飞应急，军市酣歌散未迟。\n宾客兰台虽已老，燕然铭笔为君期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惟敬席上喜思伯使还","author":"欧大任","text":"步兵厨里一尊深，闻尔还镳喜不禁。\n使者玉鱼亲走送，故人金马独浮沉。\n弹冠意气谁相许，拄杖烟霞尚可寻。\n醉后莫论烽火事，并州空折白云心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"约卿东巡以灵岩诸诗寄示闻已登岱岳","author":"欧大任","text":"灵岩寺里赋新诗，千骑东方星斗随。\n汉月颇窥三观石，秦云多挂五松枝。\n燕齐有客谈仙诀，禽尚何年住岳期。\n揽辔西风应奏草，玉皇宫阙待亲祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送林维成宰邵阳","author":"欧大任","text":"双旌南去路偏长，秋雁飞时白苧凉。\n城浸烟波皆洞野，花开山郭似河阳。\n竹枝自渡湘妃水，菰米先称楚客乡。\n归赋上林还给札，莫誇云梦献君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十六夜同黎秘书吴侍御梁舍人集梦芝馆听管山人作吴歌","author":"欧大任","text":"千家明月照帘栊，高咏凉天散步同。\n木叶自能飞洛下，秋声先已满云中。\n银河影落词臣酒，玉兔光摇御史骢。\n醉后忽闻歌子夜，禁城钟鼓思何穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李太守实夫罢归闽中","author":"欧大任","text":"驱车落日满河梁，欲别犹堪典鹔鹴。\n把袂几人燕市酒，裁书八月蓟城霜。\n空令白雁随归客，只为青山忆故乡。\n君到南中荣橘柚，应知三径未全荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送姜宪副宗孝之关中","author":"欧大任","text":"清朝侍从有光辉，十载祠官直禁闱。\n绣斧日边新赐诏，油幢关外远宣威。\n三秦豪杰分庭揖，二华烟云绕座飞。\n早向长杨陪羽猎，汉家词赋似君稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答潘少承经赤花海上见怀","author":"欧大任","text":"三载离居忆酒垆，秋深犹自滞燕都。\n谁堪侠气弹孤剑，独有归心寄五湖。\n笛里关山新白发，楼前星斗乱黄榆。\n君看甲子泥涂客，长啸烟中且钓鲈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄佥宪士弘入贺礼成取道南归为太夫人寿","author":"欧大任","text":"紫宸车马出长安，仙掌秋深露已漙。\n金鉴拜陈明主寿，玉觞归献使臣欢。\n家藏桂籍分鸾掖，筵近梅花照豸冠。\n闻道曾孙迎太姥，画图何异幔亭看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日惟敬置酒与张刘管张四山人同赋","author":"欧大任","text":"白云箫瑟一尊开，共佩萸囊上蓟台。\n橘熟题书曾问讯，菊荒为客未归来。\n秋高大漠胡尘净，日落长杨汉骑回。\n惟羡故人今侍从，飘零谁道子虚才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳后一日同古比部黎秘书集张民部宅","author":"欧大任","text":"班生宁望酒泉封，旅食重阳已再逢。\n紫闼梦悬金涧月，白云心寄石闾松。\n故人薄禄多官酿，狂客酣歌待禁钟。\n手把茱萸还强饮，明年何地忆追从。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同黎秘书曾缮部吴侍御万金吾出善果寺访冯侍御","author":"欧大任","text":"封事朝驰玉节孤，青云冠盖满城隅。\n客携擂具迎公子，人向高阳问酒徒。\n白简霜飞千里草，紫驼秋落九关榆。\n燕歌未歇传杯夕，犹识风流在汉都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题玉洞桃花图赠大司空蔡公","author":"欧大任","text":"赤墀委佩更珊珊，五十曾登汉将坛。\n胡骑早闻安石墅，洛师犹忆惠文冠。\n关门紫气何人候，湖水扁舟异日看。\n万树桃花天目上，山炉应熟九还丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李子新还扬州因讯黄定父","author":"欧大任","text":"霜欺季子黑貂裘，金尽长安不可留。\n黯黯离情平谷月，萧萧归骑广陵秋。\n十年生事餐菰米，万里勋名视蒯缑。\n欲寄黄郎无尺素，但凭飞梦过瓜洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋风 其一","author":"欧大任","text":"萧瑟秋风天雨霜，年来书剑半摧藏。\n画眉京兆颇相笑，舞袖长沙空自伤。\n客计未应羞马牧，宦情谁肯薄淮阳。\n心知不待题麟阁，犹得诙嘲陛楯郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋风 其二","author":"欧大任","text":"清切遥看西掖垣，几人荐引登金门。\n龙渊池出斗牛气，凤诏天垂云雨恩。\n醉白渐多嵩洛梦，草玄已老蓬蒿园。\n飘零短褐秋风客，睥睨心期惟酒尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大理潘公雪夜邀同吴侍御黎秘书万金吾集","author":"欧大任","text":"夜深寒色照帘栊，廷尉留宾似孟公。\n且共持觞燕市里，岂论结袜汉庭中。\n秋风城阙闻清角，积雪关山断暮鸿。\n赋客此时惭授简，独能沉醉倚青骢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪夜同陆山人过张司理时张已补外陆将还山","author":"欧大任","text":"寒色千门日易低，为君一过玉河堤。\n月移赵瑟佳人起，雪照吴钩侠客携。\n官阁梅花孤梦后，钓船春草五湖西。\n天涯尺素题何处，好忆燕台疋马嘶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同吴约卿携酒访姚元白于慈仁寺因登毗卢阁得山字","author":"欧大任","text":"秦京久客待君还，鹿苑相携霄汉间。\n地涌飞楼云绕舄，天连孤鸟日衔山。\n高寒并见金茎影，禁近初归玉笋班。\n萧瑟秋风怜庾信，江南何处望乡关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾比部子玉宅同冯侍御黎秘书胡礼曹夜集","author":"欧大任","text":"华发金门隐岁星，知君执戟爱沉冥。\n凤毛家学闻江左，马尾官书在汉廷。\n醉后自能歌白雪，灯前谁共舞青萍。\n郊园赐沐承恩日，曾恋松萝月满亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘评事少脩调望江令","author":"欧大任","text":"雪花燕甸马鞯寒，又送鸣珂出禁銮。\n三礼甲科郎选重，大雷渔长主恩宽。\n且因粳稻移家去，岂谓风尘作吏难。\n闻是尚方曾赐舄，飞凫还望到长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至日同姚元白苏子川黄定父吴约卿张羽王饮黎惟敬宅时元白将还白下羽王将之雷州","author":"欧大任","text":"阊阖阳生积雪光，高城夕送雁千行。\n江南不见梅花使，蓟北空持柏叶觞。\n银烛莫教歌管歇，玉颜应笑鬓丝长。\n风流渐觉词人散，不待他年忆建章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中戴伯常见过","author":"欧大任","text":"晓雪如花片片飘，鸣珂犹复问僧寮。\n人寻洛下无行径，客倦咸阳有敝貂。\n苑树风吹珠错落，禁城山拥玉岧峣。\n冲泥欲跨银鞍去，先访将军第五桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠张司理羽王之雷州","author":"欧大任","text":"酒尽征车不可留，劳君万里拥缇油。\n荔枝熟处江云湿，杉叶飞时海郡秋。\n赋后鹏抟多作浪，尊前蜃起自成楼。\n竹书岁报无冤狱，前席从容待借筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄王仲房","author":"欧大任","text":"闻君久托远游心，浮世行藏自陆沉。\n掌记军中曾入幕，飞书海上亦辞金。\n扁舟夜钓黄湖冷，精舍秋移白岳深。\n谡谡松风何处听，杖藜吾欲一相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答顾玄纬见寄","author":"欧大任","text":"早买山田四十双，扁舟归去老江乡。\n谈禅有客期兰若，看竹何人问草堂。\n世许谷云工笔札，自羞辕固少文章。\n一轺欲访延陵子，天末题书报雁行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洞泉有仙人卢至柔遗迹顾光禄隐居在焉为赋是诗","author":"欧大任","text":"璨山深访羽人居，洞酌亭前寄敝庐。\n流水玉琴挥轸外，秋风金涧听松馀。\n曾攀丘垄乌啼树，尚忆云窗鸟篆书。\n江左周颙归未得，十年猿鹤意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诚意伯刘公宅同群公宴集得孤字","author":"欧大任","text":"东阁梅花照玉壶，上公开宴集城隅。\n汉京授简新词客，燕市衔杯旧酒徒。\n盟府勋名班剑在，中天邸第白云扶。\n长裾不少清狂兴，醉散朱门月色孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴明卿上计至都下","author":"欧大任","text":"使者归来谒建章，郁葱佳气满咸阳。\n禁中乐府歌朱鹭，阙下书生对白狼。\n鸣玉班行收客泪，赐金颜色借恩光。\n子虚颇有相如赋，侍从无劳上汉皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮次韵答施虞部","author":"欧大任","text":"避喧金马即山堂，燎玉空瞻紫禁光。\n把酒病犹逢汉腊，披裘寒自拂胡霜。\n家人椒颂劳相忆，驿使梅花远莫将。\n惟有吟诗何水部，共凭高阁望江乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送徐子明赴苍梧参军","author":"欧大任","text":"跃马都门意气生，飞书骆越旧知名。\n炎洲道路三千里，沧海戈船十万兵。\n岂为故人誇负弩，祇缘多难请长缨。\n伏波门下南征曲，更听袁郎玉笛声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日同文博士寿承黎秘书惟敬集顾舍人汝和宅","author":"欧大任","text":"逢君休沐下东华，邀赏高斋到日斜。\n已道书钞麟趾殿，真看画在虎头家。\n香炉云起匡山石，金灶烟分顾渚茶。\n闻道五陵公子醉，只誇银甲拨琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同项思尧黎惟敬诸君饮顾光禄汝所齐中乃兄汝由直阁汝和舍人皆在会","author":"欧大任","text":"绛蜡金尊夜不寒，岂知今夕在长安。\n步兵厨里酒新熟，拥衲龛前雪未残。\n家有赐书班嗣富，名齐伯仲季方难。\n醉来索笑梅花下，何似扬州水阁看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同惟敬夜过明卿得台字","author":"欧大任","text":"送腊尊醪日日开，明星驱马凤城隈。\n天知汲黯淮阳至，人笑王生渤海来。\n裘剑摧藏惟解饮，风尘荏苒几怜才。\n俸钱莫问今多少，且共酣歌上蓟台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕卧病酬施虞部见召不赴因订早春之约兼呈曾郎中吴韩二员外","author":"欧大任","text":"东省屠苏念故人，席门虚枉使车频。\n愁深白发三年客，梦破青山一病身。\n玉醴想添新岁色，金钱将醉曲江春。\n申公已侧当时目，犹得交欢侍从臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送庞侍御少南出按两浙二首 其一","author":"欧大任","text":"明堂令布履端馀，宪府霜飞按越初。\n沧海潮回收万弩，潢池氛净出单车。\n探碑禹穴多奇字，访士桐江有旧庐。\n八使风流谁得似，西京人望皂囊书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送庞侍御少南出按两浙二首 其二","author":"欧大任","text":"同时学赋羡君成，流落怜子十载情。\n周室主书专柱史，汉家掌故待诸生。\n交游敢望弹冠出，父老应随负弩迎。\n浙水东西怀绣斧，江花那得计王程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"瑞室诗为四明薛子熙赋","author":"欧大任","text":"明经旧署郑公乡，南渡衣冠岁月长。\n野火不惊焦处士，山云常护鲁灵光。\n藤交瀑下窗犹暗，菊散霜前径未荒。\n奇字祇今邻禹穴，高楼还儗并梅梁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"诚意伯刘国桢使楚饯别于孙鸿胪宅得枝字","author":"欧大任","text":"燕台征骑早春时，九陌青青折柳枝。\n玉节星随周使者，朱陵云识汉官仪。\n澧兰尽入词人赋，湘竹宁忘帝子思。\n鸿雁从来飞不到，天涯何处问归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":5545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]