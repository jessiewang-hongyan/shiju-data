[{"title":"过茶园三首 其一","author":"汪广洋","text":"竹鸡花外弄轻烟，桑柘深深雨后天。\n过客曾闻远人说，严州风土半宜绵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过茶园三首 其二","author":"汪广洋","text":"打鼓发船滩上去，健儿群立候晴晖。\n明朝又是严陵道，无数青山尚客衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过茶园三首 其三 读陈都事赠术士铁硬断诗用韵","author":"汪广洋","text":"新逢逆旅酒家仙，濯足常挥子母钱。\n袖得元龙诗句在，数行行草似张颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醉中往往赋巢云颠倒林宗折角巾却喜老怀多放逸敢将奇语动时人","author":"汪广洋","text":"歙中右族老云孙，半百年来住鹿门。\n三日山城好风雪，可能来访浣花村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"席中用赵子常诗韵赠鲁志敏 其一","author":"汪广洋","text":"白发近如春草生，可恨十年成底名。\n鸡鸣拔剑背灯舞，风雨草堂销客情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"席中用赵子常诗韵赠鲁志敏 其二","author":"汪广洋","text":"山城驻马四十日，斗酒日饮飞将军。\n龙居近报有鸣凤，讵可不往求一闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"席中用赵子常诗韵赠鲁志敏 其三","author":"汪广洋","text":"紫阳隐者卧癯鹤，大雪闭门书获麟。\n鲁连高谊在老眼，极意放歌俱绝尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与唐德昭论旧 其一","author":"汪广洋","text":"新闻湖上春水生，可惯兰州载酒行。\n偶遇乡人论旧事，小窗晴日坐闻莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与唐德昭论旧 其二","author":"汪广洋","text":"春风吹花落客愁，湖上酒家多起楼。\n醉斫鲤鱼歌白雪，翻忆十年曾此游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"写兴寄诸友 其一","author":"汪广洋","text":"小字蝇头枉费辞，祗将田赋较公私。\n秋风江馆闻鸡起，不是青绫夜直时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"写兴寄诸友 其二","author":"汪广洋","text":"版籍披寻百两馀，职方诸史进徐徐。\n不眠终夜坐风雨，争似扬雄校鲁鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食过桃花潭观拜扫者","author":"汪广洋","text":"桃花潭上锦模糊，号泣青天海欲枯。\n愧我亲茔在淮土，五年不得洒松酤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬朱伯徽 其一","author":"汪广洋","text":"紫陌山下朱徵士，白发近来垂满肩。\n清晨拄杖出门去，为斸昌阳求引年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬朱伯徽 其二","author":"汪广洋","text":"隐君缚屋万山幽，一日不见如三秋。\n闭门高枕了世事，肯信人间有列侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋思","author":"汪广洋","text":"黄牛洲前黄叶飘，棹人歌断浦云遥。\n柳枝络马閒居士，忆著扬州廿四桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻歌","author":"汪广洋","text":"江上草色碧纤纤，我独近来华发添。\n谁人唱歌多古调，莫是当初昔昔盐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"毗陵道中二首 其一","author":"汪广洋","text":"四境荒凉半是营，百年憔悴几麾兵。\n独骑瘦马长吟者，落日萧萧过吕城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上十首 其一","author":"汪广洋","text":"庐山万八千丈高，江水日夜送波涛。\n看山饮水自成趣，何用长竿钓巨鳌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上十首 其六","author":"汪广洋","text":"江上四月雨绵绵，连日北风何太颠。\n且买活鱼炊晚饭，皖城对岸泊归船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上十首 其九","author":"汪广洋","text":"昔曾将命解戈鋋，一客双江又二年。\n瞻望蓬莱云咫尺，寸心长系片帆前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上十首 其十","author":"汪广洋","text":"内班清切侍金銮，深愧无能负好官。\n万里长风开霁色，举头红日是长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅花图","author":"汪广洋","text":"赣江去国数千里，曾对梅花忆故人。\n今日归来看图画，一枝寒玉更精神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53776,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"百舌","author":"汪广洋","text":"簧舌琤琤巧万端，转令听者觉多般。\n争知阿阁春风里，晓日嗈嗈语凤鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53777,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望梁昭明松林","author":"汪广洋","text":"两江笳鼓竞分争，城郭全非草树平。\n十里茂林无恙色，贵池今日祀昭明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53778,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄王益","author":"汪广洋","text":"独立汀洲采白蘋，暖风晴日正愁人。\n江东倘有平安字，早晚携书愿卜邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53779,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上十首 其一","author":"汪广洋","text":"月射汀沙如雪明，野禽惊聒草虫鸣。\n叮咛今夜看风水，且放官船著岸行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上十首 其六","author":"汪广洋","text":"李阳河畔有人家，鹅鸭鸡豚聚浅沙。\n应是久居生计熟，大张阔网取鱼虾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上十首 其八","author":"汪广洋","text":"大通港口柳如烟，簇簇人家赛辋川。\n候吏颇谙巡逻事，插旗挝鼓送行船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上十首 其九","author":"汪广洋","text":"王事方殷敢后程，抗舟力与北风争。\n乌纱港里樯如棘，直待波平自在行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江上十首 其十","author":"汪广洋","text":"牛渚矶头江月明，倚歌閒答洞箫声。\n夜凉老子兴不浅，自把浊醪时一倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"两梁山","author":"汪广洋","text":"两梁雄跨大江湄，高出云霄控碧漪。\n天遣骑鲸人去后，淡烟恒似锁蛾眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"慈湖矶 其一","author":"汪广洋","text":"溪山素与人事绝，胜地何缘得美名。\n大抵一诚能格物，昆虫草木总为荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"慈湖矶 其二","author":"汪广洋","text":"慈湖矶上白云飞，慈湖矶下游子归。\n祇为年年事奔走，寸心何以报春晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次清河县","author":"汪广洋","text":"淮河水流汨汨清，到县都无二里程。\n兵后人家颇相得，采鱼屯种日为生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过临濠十八里滩","author":"汪广洋","text":"芦荻萧萧吹晚风，白沙如雪阵云空。\n翻思宋祖麾兵后，百二山河破竹中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡石口","author":"汪广洋","text":"斩断灵鳌劈两崖，汤汤淮水自西来。\n信非天遣神工助，大禹何缘凿得开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次定陶县","author":"汪广洋","text":"滔滔急水来西北，落落饥鸢噪晚晴。\n井邑已荒民物尽，行人犹辩定陶城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶题主敬陶参政所论诗经小序后 其一","author":"汪广洋","text":"二十年前绝可嗤，逢人啜啜便言诗。\n只今羞涩无多语，政恐门前匡鼎来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶题主敬陶参政所论诗经小序后 其二","author":"汪广洋","text":"前贤已往后贤来，掇拾遗编要释疑。\n便使李黄今日在，也须三叹有馀师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶题主敬陶参政所论诗经小序后 其三","author":"汪广洋","text":"诗从删后更无诗，美刺还他熟虑思。\n若止誇多名物辨，古人馀憾不无遗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶题主敬陶参政所论诗经小序后 其四","author":"汪广洋","text":"大手文章不费辞，眼明理到自无疵。\n客窗三复忘休寝，细酌清泉夜半时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"济南八月一日闻雁","author":"汪广洋","text":"苦无高阁送晴晖，翰翰阶前柿叶稀。\n我有慈亲在京国，怜渠一一向南飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中清隐图","author":"汪广洋","text":"王屋山前云气多，濯濯水流幽涧阿。\n青松白石有如此，岁久不归生薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题徽宗御制小景","author":"汪广洋","text":"梦觉凉生水殿秋，起拈毫素写沧洲。\n西风底故无情思，吹得黄芦也白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书绵蕝图后 其一","author":"汪广洋","text":"鼎沸才清席未温，肯将礼乐奏君门。\n后来牵合虚文者，未必无疑到叔孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"书绵蕝图后 其二","author":"汪广洋","text":"扶植纲维明大节，折冲俎豆去繁芜。\n今人健羡麒麟书，曾及当时斫柱无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓度关山","author":"汪广洋","text":"岭头丛木碍烟扉，石角枯藤挂客衣。\n杜宇为谁伤远别，满山都道不如归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过虎牢关","author":"汪广洋","text":"衮衮河流隔太行，盘盘关路接荥阳。\n曹瞒已去温侯死，赢得悲歌古战场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过潼关喜得长安","author":"汪广洋","text":"关陜喉襟在必争，一呼谁敢抗前旌。\n华阴父老头如雪，解道黄河此日清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"函谷关","author":"汪广洋","text":"树木阴森虎夜号，行人愁杀路峣岰。\n谁家鸡唱寒烟里，举首东方太白高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"老君谷","author":"汪广洋","text":"老君谷里无人到，云气上天成鹤飞。\n落日长风飞过雨，万松深处有龙归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游玄都观","author":"汪广洋","text":"曲江东畔柳丝长，金碧楼台耀夕阳。\n惆怅种桃人已去，更从何处问刘郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游开元寺","author":"汪广洋","text":"咽咽山蜩噪古槐，阴阴香积锁空斋。\n翻经台上无人到，不见天花下宝阶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游华清宫","author":"汪广洋","text":"雾旆霓旌去不来，阴廊风雨长苍苔。\n宫前只有閒花木，还向骊山脚下开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安晓起闻鹊","author":"汪广洋","text":"帘幕轻风度早春，树枝乾鹊噪清晨。\n若非边报收遗寇，定有家书寄远人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再过崤关","author":"汪广洋","text":"尽说崤陵路最艰，一年犹得两回还。\n姚崇片石孤撑立，寂寞苍烟杳霭间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿益门镇","author":"汪广洋","text":"横鸡岭木撼清秋，关隘连云控益州。\n指点烟深最高处，驿程将近草凉楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过茂陵","author":"汪广洋","text":"落日茂陵衰草寒，马嘶尘起北风酸。\n可怜此地埋仙骨，不见金茎捧露盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咸阳道中","author":"汪广洋","text":"五陵原上路漫漫，瘦马行吟日半竿。\n归思好如南去雁，强冲风色过长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"月夜过马嵬坡","author":"汪广洋","text":"关月明明良夜何，秋风肠断马嵬坡。\n也应不为真妃惜，祇憾当初白骨多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日观太白山雪","author":"汪广洋","text":"日日登高赋远游，偶逢九日转多愁。\n青山也解行人意，遥对黄花共白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过岐山古城","author":"汪广洋","text":"桑柘阴阴盖甫田，驻车安敢任旬宣。\n山城父老来相见，尚道周家八百年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过古桃林","author":"汪广洋","text":"氛翳才消海岳清，万方谁不愿归耕。\n北来喜见桃林野，黄犊斑斑暮雨晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中条山","author":"汪广洋","text":"平沙漠漠草萧萧，一剑宁论万里遥。\n犹愧未偿山水愿，暮冲寒雨过中条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发睢阳","author":"汪广洋","text":"霜重清寒透紫貂，睢阳城外发行轺。\n西风满目芦花白，疑是秋江上早潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过北邙山","author":"汪广洋","text":"北邙山上多青楸，北邙山下有荒丘。\n青楸摇落荒丘在，风雨凄凄狐兔愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过梅关","author":"汪广洋","text":"春深长忆出秦关，寒拥貂裘马上还。\n今日入关春更浅，野花红白草斓斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发凌江","author":"汪广洋","text":"苦竹坡头啼鹧鸪，淡烟疏雨暗平芜。\n过关喜得江风便，日日推篷看画图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄塘驿","author":"汪广洋","text":"天际孤峰生紫烟，江头好月向人圆。\n馆夫争道黄塘近，挝鼓烧灯又换船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浈阳峡","author":"汪广洋","text":"洒面凉风吹酒醒，野猿长啸树冥冥。\n短篷已过浈阳峡，两岸云山不断青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"灌溪上","author":"汪广洋","text":"兰叶青青水满溪，绕溪花落有莺啼。\n天南莫讶无霜雪，二月渐渐麦秀齐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"横石口","author":"汪广洋","text":"江水东流猿夜哀，愀无人迹到苍苔。\n悬崖唯有千章木，时见猿猕抱子来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"连江口","author":"汪广洋","text":"杨柳依依春水生，画船稳载越中行。\n白沙黄竹啼双鸟，相隔湖南又几程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜过回岐驿","author":"汪广洋","text":"乱石滩头发棹歌，断猿啼月夜如何。\n白头司马青衫湿，应比江州泪更多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"锁峡","author":"汪广洋","text":"峭壁摩空转怒雷，江流如束浪如堆。\n东风连日桃花雨，叶叶滩船树杪回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曲江城","author":"汪广洋","text":"曲江门外驻兰舟，目送行云独倚楼。\n风雨满城榕叶暗，岭南二月似三秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西城镇","author":"汪广洋","text":"水际渔家星散稀，沙棠艇子漾晴晖。\n恰如烟外忘机鸟，来去将雏自在飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其六","author":"汪广洋","text":"春意亭凉酒满杯，昔人遗刻尚崔嵬。\n亭前几树黄皮熟，日日莺啼数百回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岭南杂录三十首 其九","author":"汪广洋","text":"山溪款獞爱喧哗，垢面文身到处家。\n试问年年事何事，强弓劲弩旧生涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]