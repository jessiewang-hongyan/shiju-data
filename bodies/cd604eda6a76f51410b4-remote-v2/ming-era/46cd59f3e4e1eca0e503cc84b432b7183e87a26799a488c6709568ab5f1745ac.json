[{"title":"宿建昌县公馆听雨和周玉岩都宪","author":"陆深","text":"五月溪山路，水深云更深。\n溪梁连近麓，帆影掠长林。\n巨浸愁农事，重阴伤客心。\n翻将经济意，时向簿书寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"鄱阳湖","author":"陆深","text":"家居沧海曲，观水入云天。\n斜日番君庙，西风邬子船。\n草封高岸没，波合断山连。\n起击中流楫，秋光满大川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望云居","author":"陆深","text":"道远山初近，天长晚更晴。\n水从星汉落，舟在画图行。\n击楫吴郎计，乘槎汉使情。\n难将物外意，空博世间名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万载冒雨晓发途中次韵 其一","author":"陆深","text":"逢迎南至日，上尽雨中山。\n人过龙行处，云生马度间。\n征旗残画捲，弛担隋樵还。\n阮籍何心者，予方索笑颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"万载冒雨晓发途中次韵 其二","author":"陆深","text":"晓行随落月，细雨暗前山。\n天地阴晴里，风云变态间。\n远装初觉重，湿鸟并知还。\n捲幔峰峦接，丹青有好颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙窝驿","author":"陆深","text":"远道悲游子，春光满驿亭。\n幽花背岩发，芳草上洲青。\n帆影连银海，山形列翠屏。\n何如张博望，光动女牛星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自荥泽渡河","author":"陆深","text":"清晓轻尘湿，长河新水通。\n一宵花信雨，两岸麦秋风。\n禹迹微茫外，鸿沟指顾中。\n七年三问渡，南北更西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初从木罂渡水欣然忘危步入山庵小憩","author":"陆深","text":"病骨难为路，春容半带阴。\n木罂初渡水，山寺不藏林。\n脱险初经险，违心却负心。\n楚云天共远，聊复一登临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过赵州","author":"陆深","text":"当代朝天路，犹馀望汉台。\n地分三晋古，客过万山来。\n霁雪留残照，轻车动早雷。\n望穷天北极，紫气绕蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自下邳晨渡","author":"陆深","text":"残月曙犹上，断冰寒更流。\n风回青雀舫，尘满皂貂裘。\n勋业奁中镜，英雄水上楼。\n行人连日夜，陌上重回头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"汶上","author":"陆深","text":"汶上栖贤地，风尘愧此行。\n天寒日力短，道远旅魂惊。\n不醉任城酒，空怀贺监情。\n浮云亦何意，常为碧山横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西望太行诸山","author":"陆深","text":"白日如送客，青山解迎人。\n半空横叠嶂，万里一孤臣。\n涧积过年雪，风回隔岁春。\n并州虽暂住，难比故乡亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1383,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石铁村乘月行","author":"陆深","text":"片月新秋里，行人山路中。\n晚凉微带露，宿雨尚含风。\n星炬参差列，肩舆窅窱通。\n去程迷远近，时复问西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1384,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阳武道中","author":"陆深","text":"冬日如春暖，河冰断复流。\n尘中藏去马，天际出危楼。\n周道真如砥，行人那可留。\n风霜双短鬓，失计为身谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1385,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"井陉道中雪甚","author":"陆深","text":"井陉天下险，何况雪中过。\n绝壁看云嶂，危桥下玉坡。\n奔腾千驷马，森矗万人戈。\n信有淮阴令，衔枚夜渡河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1386,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"井陉西上故关","author":"陆深","text":"雪艳腾腾长，天容黯黯低。\n千重无路入，一望使人迷。\n日午凭鸡唱，云生傍马蹄。\n山川分赵魏，关路隔东西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1387,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过北关","author":"陆深","text":"旧雨侵泥滑，连朝得晓晴。\n土窑留树荫，山路逐泉声。\n近塞风先劲，中秋月乍生。\n几家田石坂，辛苦望收成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1388,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"定襄雨中","author":"陆深","text":"细雨重门寂，新凉病骨清。\n河山襄子国，关塞代王城。\n独夜闻鸡早，高云过鸟轻。\n断桥题豫让，身后尚留名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1389,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泾阳道中晓行","author":"陆深","text":"古树捎残月，孤灯映远村。\n闻鸡怜旷野，驱马上高原。\n恋主心逾切，安身事不烦。\n东风吹晓梦，只许绕柴门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1390,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题郭复斋太守别署二首 其一","author":"陆深","text":"城上楼台迥，山中日月开。\n眼空人独坐，吏散客频来。\n泉石秋先到，诗篇手自裁。\n隔溪花发处，时有鹤飞回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1391,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题郭复斋太守别署二首 其二","author":"陆深","text":"山水东南郡，经营复此中。\n渚花娇欲语，海鹤舞成童。\n曲径重重月，回阑面面风。\n蓬莱元不远，城外弱流东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1392,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱守忠兼怀山阴旧游","author":"陆深","text":"我昔登南镇，山阴一水东。\n禹功思玉帛，秦刻卧鱼虫。\n古有神仙宅，今传王谢风。\n独怀词赋悔，白发老杨雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1393,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大浪滩","author":"陆深","text":"江水清不澈，秋容雨复晴。\n捲帘闻瀑坐，欹枕看山行。\n密筱缘溪转，长松径壑平。\n人家翠微里，时有白云生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1394,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"玉山西下换小舟乘月","author":"陆深","text":"怀玉溪山路，依稀记昔年。\n秋风南国客，明月下泷船。\n苦爱沧浪曲，谁歌白石篇。\n甘棠是何物，千古使人怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1395,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书龟峰石壁上","author":"陆深","text":"四眺山俱好，入山游兴长。\n群峰更卧起，万木半青黄。\n轻鸟巢孤壁，流泉过叠廊。\n幽期探未极，翻忆巨灵藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1396,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿龟峰","author":"陆深","text":"一宿龟峰寺，登临愿不虚。\n岩花僧定后，山果客来初。\n峭壁时亏蔽，孤云递卷舒。\n愧无康乐手，疑有子长书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1397,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋对月二首 其一","author":"陆深","text":"今夜中秋月，长安向北城。\n高梧云意薄，小草露华清。\n气候关寒暑，天心忌满盈。\n孤亭虚四壁，着意傍人明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1398,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋对月二首 其二","author":"陆深","text":"对酒不成醉，秋光倍可怜。\n照人偏白发，为客况青毡。\n几处关山里，终宵鼓角边。\n未知尘世上，能看几回圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1399,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"至潼关","author":"陆深","text":"潼关天作险，此地复楼台。\n一径云中度，三川日下来。\n东迁周左计，先入汉雄材。\n自有蓬桑志，西南万里开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1400,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"峡江道中暮色","author":"陆深","text":"晓山南国丽，中月复冬深。\n轻露还蒸麓，幽花尚满林。\n北风千叠浪，西崦半帆阴。\n何似湘江路，常悬魏阙心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1401,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪中王嵩野过公馆小酌次韵","author":"陆深","text":"西台梁苑客，南国楚郊山。\n共爱六花舞，如登万玉间。\n平原千骑出，远浦一蓑还。\n萍水萍乡路，相看得破颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1402,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿邯郸","author":"陆深","text":"兼程趋百里，虚馆宿邯郸。\n世事浑如梦，春宵尚带寒。\n古台平雉堞，残月隔雕阑。\n无端是兴废，人共璧俱完。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1403,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十日早朝寒甚","author":"陆深","text":"寒重春犹勒，风回雪未消。\n旂常悬日月，殿阁迥云霄。\n卿相恭寅协，君王视早朝。\n天颜殊有喜，胪唱飏箫韶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1404,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"应制撰颖殇王挽歌四首 其一","author":"陆深","text":"潜德悲天整，馀哀眷帝衷。\n素车明落日，丹旐飏凄风。\n聚散云无迹，彭殇数偶同。\n人间留不得，龙种自龙宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1405,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"应制撰颖殇王挽歌四首 其二","author":"陆深","text":"玉树难为实，璇源本自清。\n未胜桐叶剪，先助薤歌声。\n祖祭公卿集，皇恩父子情。\n堂封千古地，佳气五云平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1406,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"应制撰颖殇王挽歌四首 其三","author":"陆深","text":"瑶圃秋先到，珠林露易晞。\n千官歌执绋，万乘泪沾衣。\n正气苍冥阔，佳城紫翠围。\n多应是神物，华表鹤重归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1407,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"应制撰颖殇王挽歌四首 其四","author":"陆深","text":"皇胤分天派，仙才降帝居。\n如何埋玉日，方及晬盘馀。\n不见东平礼，空传北海书。\n英灵同大造，消息任盈虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1408,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新乡道中","author":"陆深","text":"望国还乡路，南人北客心。\n鬓毛霜欲满，时序夏初临。\n宿雨风尘净，遥山紫翠深。\n苏门精舍近，怅望负幽寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1409,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓发新乡","author":"陆深","text":"落月犹在屋，大星欲浮空。\n旅门人戒晓，官道树含风。\n隐隐共山湿，迢迢卫水东。\n黄河旧行处，指点为谁穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1410,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"淇县道中雨泞","author":"陆深","text":"雨深泥滑滑，一步九跻攀。\n世路分南北，人情念往还。\n湿云萦细柳，龙气隐高山。\n想像歌淇澳，何如蜀道间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1411,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泛黄河","author":"陆深","text":"淼淼望不极，连天送浊流。\n浮沈经塞外，淘洗向中州。\n鸥弄千帆雨，沙明两岸秋。\n灵槎频讯问，乘兴欲遨游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1412,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赴介溪赏雪","author":"陆深","text":"怀乡仍岁杪，喜雪况登楼。\n天地俱生色，江湖足胜游。\n十年依凤阙，此日更狐裘。\n未有阳春调，能为郢客酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1413,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次介溪看牲韵","author":"陆深","text":"辇路金沙涌，郊坛翠甓开。\n定须骑鹤到，唯许视牲来。\n列炬银花发，严更玉漏催。\n上卿仙骨胜，侵晓入蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1414,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨子浚大理得告归岭南","author":"陆深","text":"爱尔不可别，欲留其奈何。\n池塘春草变，山鸟杜鹃多。\n采药仙人侣，缄梅驿使过。\n于公好门第，四海望阳和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1415,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵曹承之留别二首 其一","author":"陆深","text":"旧京千古重，许国一身轻。\n驿路梅初发，都门雪正晴。\n新除分画省，惜别赋春明。\n多少临岐客，于君独有情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1416,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵曹承之留别二首 其二","author":"陆深","text":"南至三千里，东风一棹轻。\n石头城外晓，桃叶渡傍晴。\n客思奚囊重，乡心昼绣明。\n六朝佳丽地，登眺若为情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1417,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张希贤令泗会","author":"陆深","text":"万里古端州，分符作胜游。\n云山通庾岭，风土接罗浮。\n县静仙凫远，楼高瘴雨收。\n未能逢故旧，回雁有高秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1418,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵送李都阃","author":"陆深","text":"山颠与水涯，时见野人家。\n远湖拖白练，新竹长青蛇。\n涧露浮云石，林藏著雨花。\n神仙无别径，此地有烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1419,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邀甬川少宰过报国寺送吕泾野致仕","author":"陆深","text":"赤日都门道，青山故国情。\n风前邀客过，寺里送君行。\n有梦凭清晓，何心计去程。\n秦川一水隔，天远九重城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1420,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟发","author":"陆深","text":"风水本无定，有时能送行。\n西郊不作雨，北望独含情。\n习静怜穿榻，闻歌爱濯缨。\n十年怀旧业，六月遂南征。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1421,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"潞河发舟两日夜始抵和合驿","author":"陆深","text":"快路日千里，畏途肠九回。\n古难当蜀道，今日下燕台。\n柳色连村暗，波光映日开。\n北山如有待，猿鹤未应猜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1422,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"放任城南闸","author":"陆深","text":"风水自顺逆，物情生爱憎。\n任城天设险，湖泊气多蒸。\n相业商岩雨，君恩玉井冰。\n阮途多少意，长啸愧孙登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1423,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十四日放徐州洪逢周一之","author":"陆深","text":"脱险方惊险，思君喜见君。\n高山共流水，覆雨更翻云。\n初过留侯国，行经亚父坟。\n当年谁作计，楚汉欲中分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1424,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"直河晚泊","author":"陆深","text":"落日青山好，舟行复见山。\n楚天穷眺望，河水正潺湲。\n沙岸人争渡，柴扉夜不关。\n向来戎马地，此夕且开颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1425,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"河涨","author":"陆深","text":"轻尘高弄日，新涨急翻江。\n客子难为夜，乡心不可降。\n村沽聊取醉，野调自成腔。\n冥遣怀篇翰，垂帘短过窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1426,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中晚景偶理琴","author":"陆深","text":"密叶隐日脚，微风蹙水纹。\n客心随路远，人语隔溪闻。\n过雨苏秋谷，征旂飏晚云。\n匣琴多古意，移调奏南薰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1427,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晴发","author":"陆深","text":"气爽钟声远，天空鸟影微。\n樯头分曙色，席背引朝晖。\n水乱添新涨，沙明合旧矶。\n田家沾足否，天遣远人归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山庄","author":"陆深","text":"细雨移花果，来禽帖重题。\n山林元有骨，桃李自成蹊。\n林旷传乾鹊，村深报午鸡。\n暖泉如可浴，呼杖小桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"方竹","author":"陆深","text":"仙人九节杖，谁琢玉成方。\n倚石孤棱瘦，捎云列戟长。\n莫将三弄笛，雅制独眠床。\n多少圆机客，轮蹄满道傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪后","author":"陆深","text":"风雪初开野，江潮已到门。\n水深三亩竹，春蚤一墀萱。\n无事偏宜懒，初心苦畏喧。\n不应吴市里，自有辟疆园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长至侍班","author":"陆深","text":"白玉阑干动晓容，凤笙吹律应黄钟。\n侍臣蹑履趋金殿，天子垂衣覆衮龙。\n云里雪花依仗落，炉间香气入帘浓。\n却看下界罗星斗，身在钧天第几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南郊驾出","author":"陆深","text":"南郊清禁锁乾文，时倚斋居望瑞云。\n帝辇欲来香满路，宫门乍启晓初分。\n芝房桂栋圜丘殿，虎旅龙骧太乙军。\n昔日杨雄空丽藻，唯将羽猎奏明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"驾入","author":"陆深","text":"龙旂日射九关开，凤辇风高万乘来。\n皇国山川自迥互，碧空云物尚徘徊。\n依微花柳迎春仗，次第王侯献寿杯。\n汉畤唐封俱鄙陋，虞书周典共昭回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东山草堂一首送东山刘先生致仕","author":"陆深","text":"堂成十载昼扃扉，不负山灵将相归。\n物外渔樵相问答，阶前猿鹤有光辉。\n偏宜夜月凉先到，可忍春云湿未飞。\n想得夜阑还有梦，龙纹时动箧中衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得新莺","author":"陆深","text":"花里新莺高复低，遍身金缕养初齐。\n自来幽谷偏求友，惯领东风试学啼。\n何处王孙停柳外，十年征戍忆辽西。\n上林乔木知多少，他日一枝应借栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋声","author":"陆深","text":"高阁烦襟生远兴，忽闻凉籁动罗帏。\n随风已去传鸣柝，傍月还来助捣衣。\n疑有波涛从地起，独怜乌鹊正南飞。\n长安此夜悲秋客，细数流年感是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴二首 其一","author":"陆深","text":"细雨兼风若有情，树边楼里伴秋清。\n候虫灯火黄昏永，客子衣裳白苧轻。\n魂梦几番偏故国，襟期何处慰平生。\n壁间更与悲团扇，卧听梧桐落叶声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋兴二首 其二","author":"陆深","text":"怅望西山宿雨晴，新凉高阁梦魂清。\n秋于景物三分变，老觉功名一念轻。\n日课就荒诗草少，月支无补俸钱赢。\n长安岁岁逢摇落，宋玉情多鬓易星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日慧昭寺访旧迷道","author":"陆深","text":"不是桃源路亦迷，客心随马自东西。\n萧疏榆柳如前岁，依约楼台记隔溪。\n入寺绪风秋较早，照窗斜日鸟偏啼。\n凭谁指点还归去，头白山僧有杖藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日会通河送客","author":"陆深","text":"京国三年思故国，黄花时节又登台。\n清江水冷鱼龙伏，落日天空鸿雁来。\n忽漫逢人浑似梦，常因送客暂开怀。\n鲈鱼莼菜江东地，不为莼鲈也合回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":1441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]