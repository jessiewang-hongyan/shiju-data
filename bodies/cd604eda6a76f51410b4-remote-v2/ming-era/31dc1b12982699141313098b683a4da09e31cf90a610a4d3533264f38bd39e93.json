[{"title":"送弘阳王丈之南光禄","author":"葛昕","text":"无言建业远，自是帝王州。\n抱玉终还售，怀珠安所求。\n金山纡紫气，皇路拥青斿。\n何处追芳度，行看觐冕旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偕张丈登峄山次韵 其一","author":"葛昕","text":"周鲁纡行径，相将重惠连。\n春山馀客兴，晚树丽宾筵。\n鸟语腾花气，鳞游触芰钱。\n烛残还剧思，玉屑话便便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偕张丈登峄山次韵 其二","author":"葛昕","text":"叠嶂盘旋处，书门一径分。\n树新浥过雨，籁爽逐流云。\n帘水从天落，经声隔洞闻。\n主人意逾适，命酌更成醺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠易海州寅丈","author":"葛昕","text":"海内怀知己，屈指谁更深。\n十年同采谊，一掬为公心。\n我偶中州节，君多鲁国霖。\n班荆恣笑语，感慨旧槐音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"路文园亭","author":"葛昕","text":"有美名园地，停骖一笑临。\n习池留霭日，王榭枕芳浔。\n世事谁鞅掌，吾徒自素心。\n莫谓投簪逸，苍生望正深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李县尹","author":"葛昕","text":"平原劳小试，汉吏竞鸿猷。\n龙阙飞凫去，花城制锦游。\n政清推建德，俗美羡雍邱。\n昼日公庭静，鸣琴意自幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游灵岩寺","author":"葛昕","text":"古寺何岑寂，名山喜更过。\n曲流山外涧，翠倚石中萝。\n贝叶浮禅榻，昙花度鸟歌。\n芳林多乐事，身世欲南柯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将台晚眺和苏馥山","author":"葛昕","text":"紫陌天衢开射闱，衔杯览胜夕阳归。\n千家云树葱茏合，上苑霞光晻映飞。\n塞北方传息战鼓，朔南又报典征衣。\n草离花谢年年暮，回首高台挹落晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠友人任蜀","author":"葛昕","text":"冀北此日空群望，海徼当年驭远名。\n圣主抡才偏保障，遐邦仰化待干城。\n石崖云度三春早，邛水凫飞双舄明。\n天上鹓班离思切，文翁万里震贤声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠全太史使赵过省","author":"葛昕","text":"名藩宠沐分符日，天使承恩出禁闱。\n双佩暂辞金马去，片帆遥向玉河飞。\n赋成梁苑花生笔，舞近南山綵作衣。\n我亦陈情归未得，羡君世美共春晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿王母太淑人","author":"葛昕","text":"碧桃几度海南开，青鸟翩翩云际来。\n人世喜逢周六甲，使君今已近三台。\n葱茏宝树连芳合，灿烂天章取次裁。\n回首高堂同白发，愿言常对百年杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"明宇周丈留云洞次韵 其一","author":"葛昕","text":"曾问留云洞里奇，由来天上使臣稀。\n龙垂钟乳悬犹接，鹊啄岩花落更飞。\n似入武陵迷旧径，欲乘槎木叩支机。\n蛮方思甫归王化，引领枢光卜太微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈春宇太史闻余谈衡山之胜有作因次韵答之二首 其二","author":"梁孜","text":"七十峰头一探奇，素心元与白云期。\n山僧解说谈经石，樵父能传治水碑。\n峭壁迎风苍树合，悬崖蔽日古藤垂。\n寰中胜绝应难赋，搦管多惭白雪词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨冢宰东归 其一","author":"葛昕","text":"熙朝上宰抽簪日，一代题材旷古今。\n赵国完归三献璧，汉庭加锡二疏金。\n桃增万树仙源近，禄永千钟帝泽深。\n感慨都门群祖帐，高风千载剩玄心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨冢宰东归 其二","author":"葛昕","text":"抗疏金门久息机，承恩今始遂初衣。\n庙廊共惜山公隐，海岱欣迎谢傅归。\n绿野堂开春正永，绥山兴剧梦应稀。\n閒身自许烟霞外，赤舄还期曳紫微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邑涯邢公八帙 其一","author":"葛昕","text":"八十年来白发繁，守中漫自说真元。\n乡邦奕代簪缨族，齐鲁名家齿德尊。\n浥水碧波当海屋，犁邱黄石种云根。\n他年轩后行清跸，好上崆峒至道言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"邑涯邢公八帙 其二","author":"葛昕","text":"作伴求羊足隐沦，素书丹灶百年身。\n德培天汉三珠树，庆衍仙班几玉麟。\n皤鬓鹤颜清岳岳，峨冠豸绂乐申申。\n遥知舞綵添筹处，一曲歌鸣万洞春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李丈奉使东藩","author":"葛昕","text":"九重将命出严城，符剖东藩拥传行。\n道载黄华香更远，橐装白雪夜还明。\n霓旌飞度淄河色，丝竹应闻鲁殿声。\n最是寅恭多世雅，津亭何以慰离情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"文所殿下赐韵和答","author":"葛昕","text":"拥节遥临帝子乡，皇华犹自愧星郎。\n一从波浥天潢润，顿觉风生玉殿香。\n金谷春光空秀丽，梁园词赋迈寻常。\n赓歌白雪应难和，一曲巴音对别觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"别崇岗宗侯","author":"葛昕","text":"偶持使节过中州，帝子相看意气投。\n德誉不殊河献侣，诗才堪作杜陵俦。\n草堂醉我青春宴，郊舍怜君信宿留。\n携手高台极目处，神京海甸总悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"韩中丞丰水园","author":"葛昕","text":"稷下仙洲几曲深，千层荷气笼幽岑。\n高松密结藏雄阁，修竹阴森带瑞禽。\n百和香凝清客兴，数峰翠叠远人心。\n乘槎不尽回溪绿，杳蔼烟光海色临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游大慧寺","author":"葛昕","text":"梵宫高插碧天西，绮桧层盘叆叇迷。\n有恨伊人缘底事，雕栏独对雨凄凄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重过泰山 其一","author":"葛昕","text":"几年今复过名山，石磴苔深鸟道宽。\n万壑行云千里树，尘寰俯瞰倚危栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重过泰山 其二","author":"葛昕","text":"偶过小轩逢道士，飘然示我步虚声。\n明月临川风影静，浑忘身在玉虚京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山园春秋 其一","author":"葛昕","text":"戏折桃花带露餐，白云迷合俯回湍。\n轻风萧瑟松阴下，舞玉霓裳入耳寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山园春秋 其二","author":"葛昕","text":"瀛洲方丈与蓬壶，谁道人间此景无。\n三径独开心会处，山光水色足吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春峄山偕对宸张丈","author":"葛昕","text":"闻道山灵异，此日遂登临。\n主人饶逸兴，况复值春深。\n巀嵲千峰矗，浸浔百窦吟。\n禅堂栖古木，桧响带幽禽。\n洞远岩花馥，池明岸芷森。\n陈荀期不愧，何事慕宁歆。\n倾盖馀投分，臭味几知心。\n我怀归北阙，君岂耽山岑。\n努力康皇业，行看雪满簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"易太守席约登东山","author":"葛昕","text":"君自古良牧，我亦葛天民。\n羡君声藉藉，愧我车辚辚。\n山花逐客笑，野鸟傍人驯。\n一谷呈天异，万籁发吾真。\n行李依东道，酣歌偿丽晨。\n执御吾何事，朱幡漫尔屯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周敬所恩纶三锡编","author":"葛昕","text":"河东有三凤，令望昭后先。\n伟哉周氏郎，旷世式蹁跹。\n伯氏璠玙高谱系，更有仲季难兄弟。\n一朝奋翮起天池，次第剖符成锦制。\n汉庭出玺褒明仁，温纶宠命何缤纷。\n父兮母兮兄及弟，袍笏簪裾华如云。\n我幸同寅周仲子，有怀高雅良无已。\n藉诵龙章三锡编，荣光自昔称完美。\n二陆已轶闻，八荀或啬位。\n难封易老失古人，何似世泽亲显被。\n司马家学自可寻，声华落落茂槐阴。\n多君慈孝传家史，忍使忠盟负短簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"李丈椿庭荣寿图","author":"葛昕","text":"老子昔去周，函谷度青牛。\n关尹攀紫气，道德衍千秋。\n翻然忽思游人间，李树复指雍之邱。\n雍邱优游七十载，笑把一筹添沧海。\n鸾停鹄峙何矍铄，青鬓朱颜常不改。\n有子腰金侍紫宸，汝作纳言帝命新。\n事业方辉伊陟谱，奉诏归欢未老人。\n献罢纶綍舞莱服，筵列松乔洛社宾。\n南山献颂当此时，青鸟正栖灵长椿。\n椿年绵邈梅作友，椿庭蓊郁槐当牖。\n和羹若作须梅实，食报咸知种槐叟。\n肆余栎材何足论，生平窃幸登龙门。\n燕山聊寄灵椿颂，颂君世泽满乾坤。\n太史岁岁奏国瑞，老人一星光晨昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"许丈使陕","author":"葛昕","text":"都城祖帐旌旗拥，送君将命如殽陇。\n腰袅嘶风千里间，壶觞落日情种种。\n人生离合最关心，况是相知知更深。\n候馆阳关三唱彻，漫将别思继骊音。\n忆昔承恩同鼓箧，君为成人我髫发。\n与君璧沼游春风，更披春风鼓春色。\n成均卒业归闾里，地邈齐梁任爰止。\n青霄万里冀图南，奋翼扶摇争迅举。\n可怜君先我着鞭，参军枢府望岿然。\n由来司马誇神授，重光奕叶相后先。\n我今筮仕从君列，吁谟犹仗君胥决。\n皇皇使节又南征，鞅掌纷糺谁与协。\n君家世业铭鼎彝，磊落如君亦足奇。\n荣承纶命欢亲侧，雍雍昼锦生春辉。\n丈夫事业不可量，世平主圣身馀壮。\n早来奏绩上承明，箕裘好副明时望。\n君不见长孺正色气不羁，德裕风猷特遇知。\n二子竖立何炳炳，肇基俶轫吾与伊。\n共期努力图掀揭，孰云汲李勋庸非可为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴中丞席有感","author":"葛昕","text":"春风蔼蔼春日暄，肃将王命临梁园。\n梁园景物由来胜，开府至今康万姓。\n忆昔先公曾此署，余方舞象随朝暮。\n风尘荏苒几经年，秉节重游感慨素。\n主翁矫矫誇人龙，开阁满座意豪雄。\n三生不负盱山斗，五夜尊前肝膈剖。\n狂呼长啸发酣馀，倾盖劳君故非偶。\n我歌酒倒樽，我醉月倾轮。\n曾闻嵩岳关贤佐，愿祝君家作甫申。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"景韩堂漫笔五首 其一 橘中老人","author":"卢象升","text":"橘中老人剖而出，壶内仙翁跳而入。\n壶橘原藏世界中，老仙毕竟何所终。\n蛟螭灭没忘大海，鹤鹄鶱翔狎泰岱。\n芥子须弥我自观，四大藏于天地宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"景韩堂漫笔五首 其二 不周之山","author":"卢象升","text":"不周之山头可触，沧浪之水足可濯。\n撼摇天柱蹑洪流，丈夫气骨原千秋。\n我今俯仰何所事，顾影掀须只如此。\n白日升沉无已时，安得长绳一系之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"景韩堂漫笔五首 其三 女娲炼石","author":"卢象升","text":"女娲炼石曾补天，石破天惊苍冥寒。\n九嶷峰头云雾起，天门隐约空濛里。\n列宿高张手可扪，一声长啸彼苍闻。\n恨今顽石不可炼，愿起女娲与相见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"景韩堂漫笔五首 其四 玉垒之云","author":"卢象升","text":"玉垒之云锦江水，出没千年流万载。\n高峰逼汉云为章，浩浩洪流濯我肠。\n等閒未与测深浅，矫首清霄观世变。\n开胸拍手索吾徒，白甫不见吁嗟乎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"景韩堂漫笔五首 其五 愚公徙山","author":"卢象升","text":"愚公徙山逢巨灵，夸父逐日捐其身。\n两人突出奇怪想，一人得志一人倾。\n沧桑谁卜常与变，造物安知假或真。\n赤轮飞驰五岳峙，乾坤饵我一浮生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜坐寄怀","author":"卢象升","text":"买山而隐乃无钱，富可求乎请执鞭。\n六载从官仍四壁，八年叨第也三迁。\n高张白眼惭时态，细检青箱忆旧毡。\n夜告自堪苍冥对，天空灵物亦依然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠常中丞","author":"卢象升","text":"名藩历典几分忧，大府新开藉壮猷。\n万里风云劳击楫，十年江海忆同舟。\n天回白日纾南顾，手挽黄河会倒流。\n绝塞当关人易老，怀君更上月中楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游海螺山","author":"卢象升","text":"重过灵岩思渺然，举杯邀月到山巅。\n浮云聚散知吾意，怪石嵯峨睹别天。\n济胜且论尘外事，逢僧聊话口头禅。\n烟霞寄傲馀今夕，望迥青霄我欲仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登太虚楼鼓琴","author":"卢象升","text":"潇湘逸响水云流，雁阵惊回明月楼。\n偶然登眺呜幽兴，翻为丝桐搅别愁。\n良夜有情应不寐，征途无主为谁留。\n何年得遂初衣赋，归卧深山鹿豕游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"大伾山石佛","author":"卢象升","text":"孤山突兀起层峦，石壁菩提玉掌寒。\n磴拂苍虬千岁老，襟流疋练几回湍。\n禅光若共林光隐，法界原同下界宽。\n应是巨灵曾劈处，芙蓉觌面切云看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望夫石","author":"卢象升","text":"匪石坚贞谁氏妻，芳魂已逐杜鹃西。\n千里时悬关塞目，百年空对远山眉。\n梳云掠雨饶妆点，泣月悲风叹粉泥。\n燕燕莺莺畴作侣，忽闻山峡有猿啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过穆陵关","author":"卢象升","text":"介马临戎壁垒新，连天烽火叹无民。\n挥戈欲洗山河色，仗策思援饥溺人。\n安奠苍生千古事，扫除逋寇八年尘。\n携归两袖清风去，坐看閒云不厌贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过恨这关","author":"卢象升","text":"千古英雄恨这关，疆分豫楚几重山。\n龙泉羽士嫌岑寂，鸟道征人叹往还。\n剑削芙蓉身欲奋，幽栖岩壑意仍閒。\n遐思忠义当年事，历尽江山识岁寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏庭鹤","author":"卢象升","text":"霜姿玉质孰为俦，时向空庭拟胜游。\n与尔乘风霄汉去，眼中不见十三洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏游丝","author":"卢象升","text":"娇难著雨弱随风，似有疑无入望中。\n高拂楼台低绕径，春光牵惹过墙东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋二首 其一","author":"卢象升","text":"静里丝桐猿鹤闻，三秋景色已平分。\n良夜新晴月皎皎，碧霄散尽苍梧云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋二首 其二","author":"卢象升","text":"秋声欲坠露沾衣，天际星河□影稀。\n举酒移尊觞碧落，懒云为我一齐飞。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"画眉","author":"卢象升","text":"玉指轻将两袖分，菱花照出斗弯纹。\n巫山十二堪描写，浅黛斜侵拂鬓云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过黄粱祠","author":"卢象升","text":"曾闻世有卢生梦，我梦卢生即此身。\n今古谁醒复谁梦，吕翁同作梦中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梅归山","author":"卢象升","text":"披星介马身虽顿，拂水捎云意自閒。\n历落层崖最幽处，支公不用买山钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过太平驿","author":"卢象升","text":"谁挽天河洗甲兵，金戈铁马旅人情。\n请缨岂是书生业，倚剑长吟祝太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十骥咏 其一 御赐千里雪","author":"卢象升","text":"疋练飞腾眼界空，白云为窟矫如鸿。\n轻麾羽骑狼烟靖，长驾应推第一功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十骥咏 其二 五明骥","author":"卢象升","text":"历尽关山几万重，渥洼神骏喜相从。\n五明共道非凡品，百战先登果异踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十骥咏 其三 御赐玉顶赤","author":"卢象升","text":"骧首云霄月影庞，胭脂丛里玉无双。\n惊鸿舞燕何堪比，一骑横秋饮汉江。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十骥咏 其四 桃花骢","author":"卢象升","text":"细柳军容昔自奇，六花指点绕旌旗。\n千群战骑争相逐，独向春风顾盼迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十骥咏 其五 豹花骢","author":"卢象升","text":"蔚也其文夺锦辉，中宵欲吼剑光飞。\n瑞质不随玄雾隐，凯歌声彻五花騑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十骥咏 其六 紫骝","author":"卢象升","text":"记得临戎策马初，骅骝紫色映征裾。\n慇勤好为求刍牧，遍历风霜体自如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十骥咏 其七 御赐银青","author":"卢象升","text":"逐影霜蹄赋隙驹，追风铁骨傲征途。\n宁将汗血求金紫，但愿功成列画图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十骥咏 其八 御赐燕色驹","author":"卢象升","text":"叆叇烟云覆碧蹄，朝来天厩暮辽西。\n昨宵逐电分明见，八尺玄虬带障泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十骥咏 其九 御赐赭白","author":"卢象升","text":"玉立亭亭孰与偕，空群逸足藐天涯。\n当场一任玄黄战，騋牝三千独尔佳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十骥咏 其十 菊花青","author":"卢象升","text":"一夕金飙遍九垓，边庭将士诧龙媒。\n孤臣久励凌霜操，唯带秋容马上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺新居一首","author":"卢象升","text":"大都名世士，出处俱不妄。\n不读万卷书，岂足成高尚。\n羡子烟霞骨，身情复奇旷。\n结屋小溪口，溪水清且漾。\n几案自楚洁，轩窗垲以畅。\n晤言一室中，心足千古上。\n讵比子云居，时吹太乙杖。\n我亦勇退者，岂曰恋禄养。\n第以圣明时，未答苍生望。\n区区丘壑怀，念与风尘抗。\n每听诵移文，北山果无恙。\n焉得归去来，依君共相向。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":24743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]