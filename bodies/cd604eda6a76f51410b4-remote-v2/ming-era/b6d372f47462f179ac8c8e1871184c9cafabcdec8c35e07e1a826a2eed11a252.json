[{"title":"懊侬曲 其一","author":"张乔","text":"欢言月时来，月满柳香处。\n却被月愁侬，孤照侬无语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"懊侬曲 其二","author":"张乔","text":"夜虚悄无人，房栊深未入。\n微步伫瑶阶，归来罗袜湿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜夜曲 其一","author":"张乔","text":"忆得少小时，隔别缘侬长。\n认取折花痕，荼薇刺郎掌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜夜曲 其二","author":"张乔","text":"长街灯影明，郎在花棚许。\n群去勿群来，认郎不敢语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"子夜曲","author":"张乔","text":"人人见犹怜，莫漫愁嗔妒。\n整衣出房栊，憨多复停步。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"欢闻歌 其一","author":"张乔","text":"三五踏歌声，心知是郎过。\n侬倚白玉箫，楼上遥相和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"欢闻歌 其二","author":"张乔","text":"坐皱轻罗衫，抱郎枕侬臂。\n郎看双袖痕，为谁染红泪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"妇薄命","author":"张乔","text":"大舅嫁小姑，是宜郎所弃。\n父母若在时，黄金作簪珥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"醒酒歌","author":"张乔","text":"世人多醉者，酒亦不清高。\n未识醉中趣，空为酒所劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读曲歌 其一","author":"张乔","text":"与郎好，犹不及琵琶，时得郎回抱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读曲歌 其二","author":"张乔","text":"嗔郎狡，万愿有穷期，惑郎情不饱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"欢闻变歌","author":"张乔","text":"石可转，欢入他侬宅，侬曾眼中见。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归舟偶述 其一","author":"张乔","text":"枕畔灯明月明，梦里风声水声。\n萍迹浪游乘兴，归舟回首多情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"归舟偶述 其二","author":"张乔","text":"日色朦胧隔雨，烟村浓淡皆山。\n去去来来无定，朝朝暮暮长闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日偕女伴欧琼芝李弱仙邓羽卿过白衣庵 其一","author":"张乔","text":"结伴寻芳破碧烟，款关何必为参禅。\n空门亦有春来意，种得桃花照玉泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日偕女伴欧琼芝李弱仙邓羽卿过白衣庵 其二","author":"张乔","text":"蓦入花关路几丫，浪寻天女访烟霞。\n相逢便合三稽首，愿向云中学散花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日山居","author":"张乔","text":"二月为云为雨天，木绵如火柳如烟。\n烹茶自爱天中水，不用开门汲涧泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黎舍人美周","author":"张乔","text":"春雨潮头百尺高，锦帆那惜挂江皋。\n轻轻燕子能相逐，怕见西飞是伯劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玉兰花","author":"张乔","text":"莫拟轻舟去沅湘，春来殊爱雪枝香。\n东阑柳絮颠狂甚，总向阶前赚谢娘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洞房曲","author":"张乔","text":"芙蓉双脸玉微红，恰在金屏翠幕中。\n蝶翅舞馀春粉热，阑干十二锁香风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝安寄彭孟阳","author":"张乔","text":"有梦花前点酒筹，觉来深院闭风流。\n人间只恨桃源路，不道桃源人更愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶成","author":"张乔","text":"评诗读曲费沉潜，艳绪新词惹恨添。\n自笑错耽佳句癖，又从缃帙见香奁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将离曲 其一","author":"张乔","text":"子夜徵歌特底忙，奈何花月是离觞。\n春江千折牵游舸，若个津头柳线长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将离曲 其二","author":"张乔","text":"香作飞尘玉作烟，轻寒微月养愁天。\n梅花本是江南弄，一叠关山倍可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"绣花蝶寄孟阳","author":"张乔","text":"一幅鲛绡万转丝，入欢怀袖莫教离。\n绣成醉蝶迷香意，似尔痴魂梦到时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白燕","author":"张乔","text":"春风晓梦寒无侣，红绿分明何处所。\n斜过香径少人知，坐爱梨花藏暗语。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日同黎美周苏裕宗曾自昭姚谷符诸子赋得月下梨花双白燕","author":"张乔","text":"杜娘瑞雪何郎粉，清韵凝香不染尘。\n良夜花光联缟袂，风流占断汉宫春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠江送卢都谏还省","author":"张乔","text":"花掖彤云闪画旗，兰舟送酒怨将离。\n河桥别后青青柳，肯为他人轻折枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43479,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"戏赠","author":"张乔","text":"倚阑闲爱绿荷香，笑杀多情面觍郎。\n双眼盻人不肯语，却教池畔看鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43480,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题示彭孟阳 其一","author":"张乔","text":"鸳鸯文彩日相依，水舞花眠漾夕晖。\n如此羽毛深共惜，可能孤逐野鸡飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43481,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"无题示彭孟阳 其二","author":"张乔","text":"生同少伯五湖归，玉骨香魂愿不违。\n妒杀真娘墓前雨，又随神女峡中飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43482,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送彭孟阳游闽 其一","author":"张乔","text":"江头黯黯别魂销，一棹东分怨落潮。\n春事正来人又去，可怜虚度好花朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43483,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送彭孟阳游闽 其二","author":"张乔","text":"邀君小驻也难留，风紧萍开不自繇。\n一舸行踪轻似叶，如何载得两天愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43484,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"感事","author":"张乔","text":"西子湖头并采莲，昭阳宫里便如仙。\n新承恩宠应谁妒，敢学颦眉为乞怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43485,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偶书所见","author":"张乔","text":"江头野鸭太颠狂，乱入荷塘逐藕香。\n莫讶无情任来去，花深原有紫鸳鸯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43486,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新秋作","author":"张乔","text":"山容初瘦月容肥，夜久凉风入翠衣。\n睡破井梧阴两叶，半床清梦一声归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43487,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕 其一","author":"张乔","text":"四角阑干自了然，风吹星宿绕檐前。\n谁家夜冷支机石，但向河桥鹊翼边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43488,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕 其二","author":"张乔","text":"望到今宵喜定嗔，一年此夕说相亲。\n天仙遇合犹如此，何况浮萍握手人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43489,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"双声曲寄孟阳 其一","author":"张乔","text":"重阳啼别妾悲秋，迢递秋心寄远愁。\n天际纸鸢吹断线，回头空忆此风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43490,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"双声曲寄孟阳 其二","author":"张乔","text":"隔纸屏风画紫骊，与卿得见实难期。\n一剂黄蘖兼红豆，苦杀相思只为伊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43491,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"风前睡","author":"张乔","text":"碧阴凉至自开帷，梦破过从近有谁。\n香片乱飞都不扫，入怀翻爱是风姨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43492,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠邻姬与所欢入道","author":"张乔","text":"谁更章台挽柳丝，为怜甘露洒杨枝。\n修成共命迦陵鸟，不似鸳鸯半世痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43493,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春望谣 其一","author":"张乔","text":"十字街头结绮楼，半垂珠箔看春游。\n花前认得金羁马，约鬓帘中笑上眸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43494,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春望谣 其二","author":"张乔","text":"月夜东城门半开，西楼娇女踏歌回。\n新衫若个生光彩，今日迎春进酒来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43495,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蹴燕谜","author":"张乔","text":"纤腰微步玉精神，妙舞轻盈掌上身。\n宠压汉宫生富贵，嬉春倾动百千人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43496,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"离恨曲寄孟阳 其一","author":"张乔","text":"伏枕春寒病转加，游魂难得到天涯。\n无端见面无端别，惭愧庭前并蒂花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43497,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"离恨曲寄孟阳 其二","author":"张乔","text":"剪剪清风冷篆烟，离思萦恨夜如年。\n无端见面无端别，憔悴春怀恼薄缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43498,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"离恨曲寄孟阳 其三","author":"张乔","text":"聚散如云欲恨谁，为寒为暖翠衾知。\n无端见面无端别，愁绝闲香詶咏时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43499,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"离恨曲寄孟阳 其四","author":"张乔","text":"欸细清宵祇自亲，于今欢笑总成颦。\n无端见面无端别，悔不为君绝念人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43500,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"斗草辞和黎美周","author":"张乔","text":"砌下罗裙湿露香，芳茎时复罥衣裳。\n小姨只斗忘忧草，那识怀中有断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43501,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫词 其一","author":"张乔","text":"月自朦胧草自春，粉痕啼损任罗巾。\n君王只向昭阳殿，歌吹时侵愁梦人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宫词 其二","author":"张乔","text":"闲把忘忧绕砌栽，日长无赖得徘徊。\n君恩于妾元非薄，几夜龙舆入梦来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"碧云谣","author":"张乔","text":"麻姑潮至正淹身，休讶浔阳信不真。\n为报赤阑桥道士，红娘留难白夫人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝词送人还吴 其一","author":"张乔","text":"春潮翻海没龙宫，八字帆拖打面风。\n一夜送郎江上去，不教留看荔支红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹枝词送人还吴 其二","author":"张乔","text":"落花寒食送郎时，涩舌莺雏语较迟。\n长歌短曲郎都解，只学郎声唱竹枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漫述","author":"张乔","text":"朱门粉队古相轻，莫拟侯家说定情。\n金屋贮娇浑一梦，不如寒淡嫁书生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜愁曲","author":"张乔","text":"瘦损花枝春病成，灯寒屏暗独愁生。\n相思梦破巫山雨，滴响窗前和泪声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"叹花","author":"张乔","text":"一株繁艳倚风斜，转眼飘零满地霞。\n春限无情愁断送，可怜开落几多花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东洲寄彭孟阳","author":"张乔","text":"吞声死别如何别，绝命迷离赋恨诗。\n题落妾襟和泪剪，终天遗此与君随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画兰","author":"张乔","text":"盈盈秋水写潇湘，欲抱閒情寄澹妆。\n谢却离骚怨公子，云边分得可人香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题竹","author":"张乔","text":"昨夜狂风落叶多，树鸣岂为作哀歌。\n摧残不复唐生梦，赢得官家□□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读恻恻吟","author":"张玉乔","text":"丰调情怀未易窥，荷丝牵结可胜悲。\n香幽韵远含毫字，付与风流作话垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"衣带中诗","author":"三娘","text":"生罹乱世怨芳姿，横惹风波累及姑。\n百计思量惟一死，全姑又得见吾夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺","author":"释慧显","text":"风捲松关长绿苔，无人到此是天台。\n九霄明月峰峦上，猿暮环归洞口哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"半云亭","author":"释慧显","text":"寂寞山中久悟禅，无声花雨湿经筵。\n忽闻松鹤云间唳，天满蟾光午夜圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宝震寺","author":"释惠连","text":"古木森阴可避喧，半檐聊结数苔垣。\n因思白足常参谒，贪看青山不掩门。\n趺坐每依芳草席，倦游懒上碧云村。\n自从粒米须弥破，客至难供菜满盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题肤功雅奏图","author":"释超逸","text":"济世元推出世豪，朝天万里拥旌旄。\n夙生自信通三昧，雄略谁能迈六韬。\n铙吹响传青海捷，阵图辉映紫云高。\n山河带砺应同固，竹帛芳垂汗马劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠虚公还匡庐","author":"释通炯","text":"恋此东林社，应怀出世才。\n刹那诸漏尽，初地一花开。\n飞鸟迎归锡，游龙识渡杯。\n未须怜去住，知为众生来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮光亭夜集","author":"释通炯","text":"观心原是妄，论旧莫生愁。\n麋鹿烟霞晚，鱼龙泽国秋。\n海月不可拾，银河空自流。\n夜凉犹露顶，趺坐竹林幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邓太素还豫章","author":"释通炯","text":"寒岩不出动经年，回首南州意渺然。\n夜月正联高士榻，秋风又上孝廉船。\n珠江缥缈孤帆远，彭蠡苍茫一镜悬。\n归去匡山遇宗炳，为寻莲社旧因缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小金山和陈公子","author":"释通炯","text":"谈禅谁道镜非台，月在中天水自回。\n词客巳看留带去，神鳌重见听经来。\n秋高鸿雁经寒起，霜落芙蓉向晚开。\n陶谢风流知不远，相逢原是济川才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒行偶兴","author":"释通炯","text":"潮回两岸水为天，散步长堤思渺然。\n幽渚自留孤鹤迹，短蓑尝恋白鸥眠。\n山中共喜能逃病，世上谁为未了缘。\n几度踏残双不借，任教人笑懒残禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春喜晴","author":"释通炯","text":"草青沙白竹林幽，杖锡行歌纵远游。\n荒径湿云迷腊屐，小溪新水涨鱼舟。\n花枝袅袅惊蝴蝶，荷叶团团起鹭鸥。\n回首杳然尘世外，坐忘天地一蜉蝣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题肤功雅奏图","author":"释通炯","text":"破虏曾惊出塞年，玺书频沐圣恩偏。\n多时久蕴安邦策，此日无劳下濑船。\n勋业曾归萧相后，壮图应占祖生先。\n名标画阁畴堪并，入望高淩五色烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游悔庵","author":"释通岸","text":"支公幽事更如何，十载冥心在薜萝。\n法演青莲应自得，诗传白雪许谁过。\n名山历历空陈迹，尘海茫茫促逝波。\n贫病几时同一笑，东林禅客已无多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采石谒李祠题峨嵋亭","author":"释通岸","text":"江南雨过群峰青，沙边兰桨时一停。\n青莲居士不可见，千秋空有峨嵋亭。\n峨嵋山月还依旧，昔年曾照樽中酒。\n为问骑鲸飞上天，不知更落人间否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹溪杂咏 其一","author":"释通岸","text":"为爱溪山好，无人只自看。\n万峰青不断，三月雪犹寒。\n乳鹿藏深树，飞凫过远滩。\n兴来谁与晤，长啸碧云端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹溪杂咏 其二","author":"释通岸","text":"经旬不出户，春草任萋萋。\n谷静有猿啸，山深无马蹄。\n岩悬泉竞落，云碍路应迷。\n道者何多事，栽桃亦满溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":43529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]