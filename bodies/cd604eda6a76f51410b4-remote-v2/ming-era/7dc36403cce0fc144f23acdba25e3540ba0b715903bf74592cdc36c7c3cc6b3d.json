/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49824,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其十","author":"黄淮","text":"黄钟应律启初阳，中外臣僚贺履长。\n恭听鸿胪传制旨，大推嘉庆及多方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49825,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其十一","author":"黄淮","text":"内难初平论武功，策勋班爵自宸衷。\n充庭金帛如山积，大赉咸知仰至公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49826,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其十二","author":"黄淮","text":"车驾清晨幸辟雍，亲行释菜振文风。\n儒臣讲罢天颜喜，坐赐龙团侍从同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49827,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其十三","author":"黄淮","text":"斯文仰荷圣明心，诏遣皇华诣孔林。\n园庙焕然新气象，奎光遥映五云深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49828,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其十四","author":"黄淮","text":"读卷亲曾近御筵，导迎黄榜听胪传。\n礼官致语群臣拜，共贺皇家屡得贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49829,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其十五","author":"黄淮","text":"永乐元正春二月，南郊驻跸劝农耕。\n籍田首举三推礼，稚耋讴歌颂太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49830,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其十六","author":"黄淮","text":"圣德巍巍被万方，遐陬异俗总来王。\n宠锡骈蕃仍宴劳，远人何幸拜恩光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49831,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其十七","author":"黄淮","text":"由来朝政重民时，进历年年有定期。\n分赐百官颁宇内，阴阳不忒岁功熙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49832,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其十八","author":"黄淮","text":"仁恩义泽洽民心，钦恤时时降玉音。\n朝野欢呼称万岁，唐虞盛治属当今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49833,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其十九","author":"黄淮","text":"国家贡赋有常程，郡邑均输不取盈。\n蠲贷屡烦优诏下，要令民庶总安生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49834,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其二十","author":"黄淮","text":"先驱传警到前茅，万乘屯云猎近郊。\n报道合围论赏格，又沾恩宴出行庖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49835,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其二十一","author":"黄淮","text":"金阙钟声曙色开，香飘瑞气蔼蓬莱。\n前呵传报人争避，黑面番奴驭象来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49836,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其二十二","author":"黄淮","text":"退朝长日御西清，内阁词臣奉诏频。\n几度从容承顾问，深惭无术赞经纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49837,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其二十三","author":"黄淮","text":"亲拥貔貅百万兵，霆驱电扫鬼神惊。\n沙场瞬息如冰解，塞上风尘自此清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49838,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其二十四","author":"黄淮","text":"笳鼓声中奏凯归，千群面缚隘通衢。\n午门前面听宣奏，大将平南已献俘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49839,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其二十五","author":"黄淮","text":"文渊只在殿东头，奎壁辉光日夜浮。\n插架图书千万轴，又令轺使出旁求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49840,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其二十六","author":"黄淮","text":"编摩有诏集时髦，隐索旁搜不惮劳。\n大典告成呈进了，中官传旨赐宫袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49841,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其二十七","author":"黄淮","text":"五彩祥云起太虚，流辉高映帝王居。\n尧时未必专歌颂，载笔曾叨太史书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49842,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"乙未夏五月初三日夜梦侍朝因追想平日所见成绝句三十八首 其二十八","author":"黄淮","text":"列宿森罗见景星，祥光直与月同明。\n太平有象于今见，垂拱无为人自宁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49843,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]