repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49806,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闷坐","author":"黄淮","text":"终朝闷坐太无聊，病体何堪肉渐消。\n惟有丹心常耿耿，梦中犹忆紫宸朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49807,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜初睡窗棂中见月","author":"黄淮","text":"解衣欹枕未成眠，月色穿窗绝可怜。\n忆昔退朝归去晚，几回立马看婵娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49808,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋热","author":"黄淮","text":"庭梧久矣报新秋，馀热凭陵尚未收。\n安得金风起天末，大驱凉雨涤烦忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49809,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋","author":"黄淮","text":"何处人登庾亮楼，痴云特地妒中秋。\n不堪羁客多愁思，谁道嫦娥也解愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49810,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"归鸦","author":"黄淮","text":"寒鸦朝出暮还归，饮啄相依不暂离。\n堪叹人生多远别，不知何日是归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":49811,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重九前一日同侪者举唐人况复明朝是岁除之句要余仿此赋之","author":"黄淮","text":"梦回孤枕夜更长，月转西楼雁唳霜。\n冷落不禁情思苦，明朝况复是重阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe529429