[{"title":"登怀柔城 其一","author":"唐顺之","text":"塞下孤城古白檀，半临平野半依山。\n秋来亭徼无㷭火，官马千家苜蓿闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登怀柔城 其二","author":"唐顺之","text":"小邑萧条恰似村，日中市井巳扃门。\n山田砂砾希禾黍，只有城西种果园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄花镇拜圣诞","author":"唐顺之","text":"珥貂拗砌曾为吏，握节封强又此行。\n日近长安无百里，星回帝座正三更。\n箫韶律应军中乐，羽卫光摇塞上旌。\n廿载违颜江海远，却因咫尺重含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"介溪相公见赠次韵","author":"唐顺之","text":"不才黾勉从王事，戎马驱驰南北仍。\n意气本非投笔客，生涯聊似出山僧。\n兵谋岂足窥韬豹，国士犹惭赋大□。\n赖有庙谟曾密授，海氛应见计时澄。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"月夜渡蛟门","author":"唐顺之","text":"大洋万里无拳石，却见群山亘海中。\n忽然石壁开双峡，坐觉楼船耸半空。\n岛以户宽延满月，潮缘口窄弄惊风。\n谁能一矢穿蛟窟，秪忆枞阳汉武雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三沙抱病夜坐柬默林督府","author":"唐顺之","text":"领军韦睿本清癯，药裹常随倚剑余。\n日御短衣巡壁垒，夜支倦体阅军书。\n莫愁深苇难搜矱，试算穷巢易扫除。\n虎将眼中谁可仗，伫闻幕府策何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈黄潭东归一首","author":"唐顺之","text":"吾亦欲归让公早，此行不异登仙好。\n试看苦战东海尘，何似高眠北窗晓。\n宦情凫鹤任短长，世事鹊鸠谁拙巧。\n他年约访祝融峰，烂煮青精相对老。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"浙中流言王游击丧师二三千者又闻总督默林公将至太仓诗以自咎并以志喜云耳","author":"唐顺之","text":"兵略元非素所闻，疏才多愧荐书勤。\n自知薄相难成事，共笑狂谋易偾军。\n雄阃岂堪分玉节，岩扉秪合伴松云。\n困山绣斧深悬望，伫看神机静海氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三沙病后夜起玩月书怀","author":"唐顺之","text":"军中元不解衣裳，夜倚危樯歌慨慷。\n巳惯羸躯常食少，从教短发尚心长。\n海能尽月空无水，潮定期风飒有铓。\n不为督师经远涉，何由此地玩清光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28846,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"海上归来病手足疮兼血疾伏枕","author":"唐顺之","text":"瘦骨迂才堪窃笑，岂能万里事横行。\n一身自试妖狐穴，六月深驱瘴海兵。\n陈汤挛痹缘西域，韦睿虚羸为北征。\n我愧古人无万一，却令二病偶然并。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28847,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赴官扬州与左妹夫两弟鹤儿白婿登金山坐禅房一首","author":"唐顺之","text":"衰颜久欲寄名山，江国征师几往还。\n隔水空知恋桑梓，纡筹岂足静夷蛮。\n淮天鹤唳军声壮，海戍乌栖战舸闲。\n纵是维扬迎师急，道人且坐白云关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28848,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题墙子岭公署中偃松署本参将府也","author":"唐顺之","text":"塞垣饱历雪霜寒，直上无枝只屈盘。\n边人自识将军树，我来权唤大夫官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28849,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游汤泉四首 其一","author":"唐顺之","text":"幽都自古号寒门，重纩年年亦不温。\n信有烛龙蟠地底，乱泉喷出火珠翻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28850,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游汤泉四首 其二","author":"唐顺之","text":"坐看池底绚霞光，疑是莲花火里藏。\n借问幻师谁会此，乾坤炉冶炭阴阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28851,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游汤泉四首 其三","author":"唐顺之","text":"戎马驱驰未息鞍，春风沂曲一盘桓。\n试凭活水洪炉暖，暂解儒生彻骨寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28852,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游汤泉四首 其四","author":"唐顺之","text":"万树不知霜信至，两厓时见火云升。\n一就熏蒸聊可喜，久来还想玉壶冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28853,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿七家岭驿次壁间韵","author":"唐顺之","text":"莽莽沙河水，分流亦有涯。\n瓶罂开小市，蓬筚拥寒沙。\n去县无百里，依山仅七家。\n偶然成一宿，聊喜息纷华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28854,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"食蒜","author":"唐顺之","text":"三餐齑粥犹嫌秽，百味荤腥久不尝。\n顷来食蒜如餐密，已换山中一副肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28855,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题丰润寺中古钟","author":"唐顺之","text":"腰下巳磨凫氏舞，顶间仅属禹王堆。\n外国奇文翻不出，山僧道是海中来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28856,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游铁壁","author":"唐顺之","text":"一峰特竦如削铁，古松根透石纹裂。\n我欲峰头看八荒，安得手中凭九节。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28857,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"银山寺说法台","author":"唐顺之","text":"秋山面面翠屏回，孤石支撑说法台。\n想见高僧开口处，诸峰曾与点头来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28858,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"横岭","author":"唐顺之","text":"一畚石与一畚钱，悬绠千寻未及泉。\n吹玉往时犹可诧，汲金此地更堪怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28859,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕公馆忆海上二首 其一","author":"唐顺之","text":"牛女双星隔水明，一年一渡尚心惊。\n天河风浪何如海，海上征人昼夜行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28860,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"七夕公馆忆海上二首 其二","author":"唐顺之","text":"一水盈孟几许遥，犹烦灵鹊为填桥。\n千年精卫空衔石，涨海烟波只自饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28861,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠杨公临刑诗","author":"王遴","text":"仗节多臣子，从容就死难。\n忠怀吞瀚海，义气压衡山。\n魂断关河杳，名存草木香。\n丈夫无别泪，含笑赴云阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28862,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠杨公临刑诗","author":"吴国伦","text":"食禄分忧士，怜君独处难。\n囊头追孟博，断舌继常山。\n雪映心犹赤，风吹骨愈香。\n伤心千古恨，挥泪洒斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28863,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"节母贞女诗并序","author":"杨继盛","text":"母为姑存身未死，姑因嫂节老空楼。\n萱阶花泣百年泪，漆室人含万古愁。\n寂寂风侵机杼冷，阴阴月暗镜台秋。\n从来多少冠裳客，曾似沂阳妇女否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28864,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘苏涯乡兄考绩北上","author":"杨继盛","text":"春树苍苍春浦晴，红亭黯黯送霓旌。\n留连鸟语怜人别，荏苒杨花共酒倾。\n桃坞雨余香气合，锦江潮尽浪痕明。\n烟浮晓巘巑岏碧，霞逐征帆缥缈轻。\n牛渚曲通瀛海泽，缑峰迥倚秣陵城。\n月高鸥在镜中宿，溪涨樯疑天际行。\n牛野分星惊太史，燕云如幕覆神京。\n枫宸报政恩波润，椿座称觞彩袖轻。\n知己渐随流水远，离愁端与削山平。\n论交每惜松颜落，折柳应悲雁序更。\n旅病偏因归客剧，梦思秪为故乡生。\n送君惟有东风泪，点点沾巾无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28865,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送万枫潭少参山东","author":"杨继盛","text":"二月江南气尚寒，石头城外水漫漫。\n云连削壁千屏合，日映离觞两鉴看。\n近渚晴花香细细，傍人风柳絮团团。\n圣朝此际求贤切，补牍还思旧谏官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28866,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽任侍御乃尊二首 其一","author":"杨继盛","text":"巴国指南思定祖，九真遗泽长孙留。\n琴台藓合乾坤老，篆水烟横天地秋。\n寂寂寒云覆陇树，凄凄疏雨暗江楼。\n欲知身后流芳远，今日龙池有豸头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28867,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽任侍御乃尊二首 其二","author":"杨继盛","text":"生刍庐外悲风鸣，一曲哀吟万古情。\n五友亭闲山树暗，三槐堂寂月华明。\n巴人泪落嘉陵水，澄野歌连上蔡城。\n海内知公身不死，南台伯雨振家声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28868,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"扬子江望焦山","author":"杨继盛","text":"杨子有心涉扬子，椒山无意合焦山。\n地灵人杰天然巧，彷佛神游太古间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28869,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送史沱村考绩 其一","author":"杨继盛","text":"十月征车辞建业，三山霜叶照离杯。\n晴烟千里孤城暮，寒雁三声万壑哀。\n水国暮云连渭树，郎官前宿近中台。\n阿戎诗礼趋庭后，为道雷门指日开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28870,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送史沱村考绩 其二","author":"杨继盛","text":"一上离亭几度愁，十年尘梦叹沈浮。\n悠悠月笛山城夕，漠漠寒云江树秋。\n作客南来俱万里，送君北去独孤舟。\n他乡正有思归兴，况复征旌出石头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28871,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送史沱村考绩 其三","author":"杨继盛","text":"官阁不传迁转报，红亭厌咏送君诗。\n昔乘骢老人犹识，旧泣珠还今始知。\n征雁迥随云树没，德星暗逐使旌移。\n彤庭久惜南迁客，共听丝纶出凤池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28872,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送大宗伯两洲王公考绩二首 其一","author":"杨继盛","text":"台斗光芒临紫极，东风行色动江干。\n春归吴苑晴花合，天入燕云晓旆寒。\n礼乐百年开万国，星辰入座肃千官。\n彤庭旧识尚书履，天下苍生属谢安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28873,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送大宗伯两洲王公考绩二首 其二","author":"杨继盛","text":"风送老莺啼禁树，春随红旆过江干。\n文昌夜度三台近，玉剑晴浮五月寒。\n一代云龙虚鼎席，百年礼乐属春官。\n相逢若问留台客，为道归思鬓已残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28874,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿太常汪春谷母七十","author":"杨继盛","text":"南极星临衡岳动，北堂萱映潇湘明。\n汉宫瑶轴封仙检，涂水梅花照楚城。\n海日蟠桃开寿域，天风青鸟下蓬瀛。\n金陵江夏隔千里，西望白云无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28875,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送狄道训导李南峰掌教清水","author":"杨继盛","text":"七载青毡多士服，九重紫诏五云开。\n熙城桃李含春雨，渭水鱼龙惊夜雷。\n怅望德星辞壁野，相思明月照秦台。\n弦歌漫奏别离调，衰柳西风无限哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28876,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同门生五十人游卧龙山寺","author":"杨继盛","text":"出门已觉精神爽，况复阳回宇宙清。\n野树含烟迷寺迥，晴山披雪倚云明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28877,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风送榆钱入户","author":"杨继盛","text":"三月不知春色暮，重门深锁贯城寒。\n东风错认王候院，误送飞钱落枕单。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28878,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻筑外城 其一","author":"杨继盛","text":"万里河山俱帝业，如何谋计只神京。\n备边自是千年计，塞外谁人筑五城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28879,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻筑外城 其二","author":"杨继盛","text":"病急须从标上治，如何缓处用工夫。\n庸医费尽箧中药，待得良医药有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和商中丞狱中生瓜二首 其一","author":"杨继盛","text":"天意昭殊节，犴庭产异瓜。\n可怜成落寞，徒自吐英华。\n疏蔓牵瑶草，幽香杂瑞花。\n苍生悬望切，何事思烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和商中丞狱中生瓜二首 其二","author":"杨继盛","text":"久狱半为家，真同故里瓜。\n行藏俱梦幻，阒寂亦繁华。\n天遗东陵种，云封西域花。\n机心久已息，即此是烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和商中丞朱葵 其一","author":"杨继盛","text":"寂寂朱葵着意栽，相投情景自徘徊。\n每因擎露含珠泣，恐误倾阳带晓开。\n疏影风移摇夜月，晴烟云拥覆西台。\n幽香暗度重华殿，时有游蜂送雨来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和商中丞朱葵 其二","author":"杨继盛","text":"得意葵花斩草栽，暂时相对且徘徊。\n百年殊色因谁瘦，万古丹心向日开。\n不共群花发上苑，却怜异种出燕台。\n老天似惜倾诚苦，欲借夭桃雨露来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和商中丞朱葵 其三","author":"杨继盛","text":"检点红芳荷雨栽，平分清景共徘徊。\n醉倾晴日翩翻舞，笑领天风次第开。\n吟席珠玑超翰苑，德星芒彩动天台。\n西山不减东山兴，佳事还随花事来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏午睡胡敬所年兄因见教作此和谢 其一","author":"杨继盛","text":"逐日课程惟有睡，百年勋业本无心。\n圣君赐我安闲地，好做羲皇世上人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏午睡胡敬所年兄因见教作此和谢 其二","author":"杨继盛","text":"一息若存还报主，万年不死是吾心。\n于今秖合昏昏睡，笑杀当时勋业人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏午睡胡敬所年兄因见教作此和谢 其三","author":"杨继盛","text":"疏懒百年还旧癖，功名此日负初心。\n本来面目频频照，恐落寰中第二人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺狱吏孙东渠母寿","author":"杨继盛","text":"南极星辉莱屿动，北堂萱映海天明。\n百年花老秋风冷，千里云孤暮树平。\n赤圃生烟回紫气，青鸾传诏下黄城。\n题诗增我斑裳恨，几遍停思无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送宋司狱致仕","author":"杨继盛","text":"共说山中好甲子，百年林下见高人。\n醒初幻枕俱为梦，归去此身方属君。\n昏夜法星辞帝座，秋风行色动乾坤。\n西台多少含冤者，一听离歌泪满巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"狱中红苔","author":"杨继盛","text":"寒柝凄凄哀怨绝，阴云黯黯郁愁结。\n西风满地苔痕红，尽是渭囚冤泪血。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"朝审途中口吟","author":"杨继盛","text":"风吹枷锁满城香，簇簇争看员外郎。\n岂愿同声称义士，可怜长板见亲王。\n圣明厚德如天地，廷尉称平过汉唐。\n性癖从来归视死，此身原自不随杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读易有感","author":"杨继盛","text":"眼底浮云片片飞，吉凶消长只几希。\n自从会得羲皇易，始觉前时大半非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日昆峰赐饮拟和刘静修先生九日九饮歌韵体 其一","author":"杨继盛","text":"一饮初歌第一歌，乾坤万物属中和。\n醉乡能发天然乐，况复幽人情兴多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日昆峰赐饮拟和刘静修先生九日九饮歌韵体 其二","author":"杨继盛","text":"二饮停杯歌二歌，西风短发任婆娑。\n四时佳兴俱堪赏，谁道当秋百感多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日昆峰赐饮拟和刘静修先生九日九饮歌韵体 其三","author":"杨继盛","text":"三饮幽人发浩歌，百年风月属予多。\n此身不是乾坤蒂，留我苍天欲若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日昆峰赐饮拟和刘静修先生九日九饮歌韵体 其四","author":"杨继盛","text":"四饮须听第四歌，傍人休笑醉颜酡。\n曾经雪浪翻天涌，风落杯中漫起波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日昆峰赐饮拟和刘静修先生九日九饮歌韵体 其五","author":"杨继盛","text":"五饮起来鼓缶歌，万年宇宙一红螺。\n闲中看破盈虚壳，聚散浮沈总太和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日昆峰赐饮拟和刘静修先生九日九饮歌韵体 其六","author":"杨继盛","text":"六饮将酣豪兴多，仰天长啸奈吾何。\n片云忽暗楼头月，只欲凌虚一拂摩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日昆峰赐饮拟和刘静修先生九日九饮歌韵体 其七","author":"杨继盛","text":"七饮相关乐趣多，风吹万籁尽笙歌。\n区区怀抱俱春意，笑尔高秋奈我何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日昆峰赐饮拟和刘静修先生九日九饮歌韵体 其八","author":"杨继盛","text":"八饮还惊饮量过，疏狂成癖竟如何。\n纵然痛饮珍珠酒，为却愁怀愁转多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日昆峰赐饮拟和刘静修先生九日九饮歌韵体 其九","author":"杨继盛","text":"九饮浑忘披翠蓑，圣明恩厚复如何。\n酿成四海合欢酒，欲共苍生同醉歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题残菊","author":"杨继盛","text":"万树红芳带露残，独怜黄菊对霜看。\n东君不与花为主，一任西风落砌寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"见山 其一","author":"杨继盛","text":"云穿石榻丹书湿，亭枕泉崖白昼闲。\n樽酒相看浑不厌，知君原是见真山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"见山 其二","author":"杨继盛","text":"万里风烟何日尽，百年宇宙几人闲。\n春来应有桃千树，休认天台作故山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"见山 其三","author":"杨继盛","text":"市朝自有武陵趣，一息无心一息闲。\n得意不须登华岳，樽前卷石亦青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":28906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]