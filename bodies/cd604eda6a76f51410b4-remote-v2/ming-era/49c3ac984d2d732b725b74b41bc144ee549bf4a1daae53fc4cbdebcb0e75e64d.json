[{"title":"程处士祠 其一","author":"韩启运","text":"鸿渐云逵远，乡江永有声。\n史传何代信，诗阐异时名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"程处士祠 其二","author":"韩启运","text":"新庙青山肃，丰碑锦字明。\n我来深仰止，翻恋蕨薇情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寓西宁即事","author":"伦应祥","text":"百粤春风拂绛纱，关河四顾尽官家。\n孤城晓瘴开红日，万岭苍松插紫霞。\n渤海垌中叱剑犊，武陵溪畔钓蝗虾。\n何人裹饭墟归后，又向东门学种瓜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仙遇湖寺","author":"卞文载","text":"当年仙遇起湖光，耸岭危峰出上方。\n梵榻虚涵云影碧，禅心清对月波凉。\n花开优钵青莲现，药就金炉石髓香。\n千古灵源独来往，不妨世事几沧桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"状元瑞莲一茎三花","author":"陈义","text":"白莲呈瑞水云东，谁识天公巧用工。\n并蒂亭亭开处异，双花灼灼本来同。\n恍疑秦晋连封国，犹讶娥英偶并宫。\n和气兆祥当此日，群黎咸诵乐年丰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游何茂才御璧园林 其一","author":"梁维栋","text":"蕙圃何年入，重来物色添。\n美花红白错，佳果绿黄兼。\n字问停车久，诗题刻烛严。\n斯游兴不浅，太史或能占。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游何茂才御璧园林 其二","author":"梁维栋","text":"未引习池水，先开蒋径门。\n盖亭茅是瓦，环墅竹为垣。\n鹿向荒篱过，虬从夹树翻。\n种桃应有地，安问武陵源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游何茂才御璧园林 其三","author":"梁维栋","text":"一丘忘拘束，半亩足盘旋。\n山月挂萝薜，松风入管弦。\n杯从苔上酌，醉即花间眠。\n三宿非留滞，清光自可怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重游何茂才御璧园林 其四","author":"梁维栋","text":"乍疑谷口小，旋觉洞天开。\n湖涌池光入，峰飞笔颖来。\n草玄知子独，作赋倩谁裁。\n游罢思离袂，愀然马首回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠郑念惺北上廷试","author":"梁维栋","text":"不少攀龙客，谁称倚马才。\n鹧鸪闻郑谷，骐骥上燕台。\n策自临轩问，疏从保泰裁。\n南恩奎壁灿，视草待君开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甘茂才园林 其一","author":"梁维栋","text":"西郭园林好，编篱自一家。\n江山排锦绣，城市足烟霞。\n弦管莺声出，琅玕凤尾斜。\n客来频载酒，中有四时花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26422,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甘茂才园林 其二","author":"梁维栋","text":"凤岛东南出，鳌鼍西北翻。\n坐从巨石稳，眺以绿阴蕃。\n一水飞长练，三花护短垣。\n春来桃李发，车马岂无喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26423,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答陈茂才子房","author":"梁维栋","text":"幽僻多奇岛，安生即妙缘。\n醒为著述客，醉作活吟仙。\n山鸟传心诀，梅林解渴涎。\n只疑飞动处，别有一天渊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26424,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访欧阳叔侄","author":"梁维栋","text":"玉树双辉映，风流文雅奇。\n青云看气色，白雪拥窗帷。\n把酒谈偏剧，探奇步怅迟。\n归来情不寐，明月为谁思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26425,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴裕众北上","author":"梁维栋","text":"北阙弓旌急，南恩山斗辉。\n舟随春水发，盖逐彩云飞。\n折柳送行旆，看花袭子衣。\n圣躬勤静摄，忍使谏书稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26426,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"促袁柱石过顾 其一","author":"梁维栋","text":"去年频共酌，此日不相过。\n一水原非隔，扁舟汝自磋。\n冠裳虽暂改，意气近如何。\n世事君知否，浮云晚更多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26427,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"促袁柱石过顾 其二","author":"梁维栋","text":"宛宛新醪熟，依依旧客过。\n倾予一斗酒，销却几沉疴。\n归棹风云急，绨袍情绪多。\n定期同信宿，剧有遏云歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26428,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其一","author":"梁维栋","text":"小阁虚窗入远山，苍松修竹递相关。\n天风一振龙鳞动，何处吹箫引凤还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26429,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其二","author":"梁维栋","text":"辟园近阁欲移花，勿漫乘春且种瓜。\n每爱生平能解事，岂图清玩酒杯誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其三","author":"梁维栋","text":"参天榕树绿婆娑，拥砌名花五色多。\n恨少悬珠如斗大，春来急植树波罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其四","author":"梁维栋","text":"晚植蕙兰称赏心，疏茎密叶翠阴阴。\n倚琴香扑朱弦蔼，充袂芳传岁月深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其五","author":"梁维栋","text":"芰荷一出压群芳，翠盖亭亭度晚凉。\n虚直清同三大道，错将颜色拟张郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26433,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其六","author":"梁维栋","text":"珍重藏名世所嘉，瑞香忒自擅声华。\n圣朝不瑞闲花草，纵有奇馨莫浪誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26434,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其七","author":"梁维栋","text":"蔷薇花好刺朋生，带得长春亦纵横。\n莫道锋芒无用处，屏藩今喜得干城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26435,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其八","author":"梁维栋","text":"生平未暇评花品，今夏看榴兴不孤。\n一发丹葩朱寔出，始知渠是锦衣图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26436,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其九","author":"梁维栋","text":"合欢花开晚色饶，光趁明月客怀消。\n相逢且作通宵醉，后夜合离未可料。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26437,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其十","author":"梁维栋","text":"结客囊空强自宽，故移金橘傍阑干。\n世人只羡黄金好，质有真金可静看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26438,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其十一","author":"梁维栋","text":"谁言茉莉香无姿，国色常兼白雪奇。\n假使温公不喜插，也须笑折两三枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26439,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其十二","author":"梁维栋","text":"蒌青带露覆墙端，叶叶云舒仙掌看。\n客至传槟恣小摘，大官不羡蔗浆寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26440,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其十三","author":"梁维栋","text":"月桂奚自植人间，疑是嫦娥仙掌颁。\n高枝未许寻常折，留映上林供客攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26441,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其十四","author":"梁维栋","text":"花名何事唤含笑，似笑才情久寂寥。\n惟有蟠桃能媚客，一枝红映压墙娇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26442,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其十五","author":"梁维栋","text":"清白原同太素质，艳浓即蹈色妆看。\n时人不识本来貌，倒把花光作粉团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26443,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其十六","author":"梁维栋","text":"编篱护菊株株秀，洁白红黄种种齐。\n岂为香颜多种取，岁寒梅竹得平题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26444,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其十七","author":"梁维栋","text":"最爱南枝傲雪材，雪深犹怯太阳来。\n梅能向日白如雪，不枉名为百花魁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26445,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其十八","author":"梁维栋","text":"接径培花意暂欢，那堪蓬草欺多端。\n惜花只令将蓬剪，谁道生机总一般。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26446,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其十九","author":"梁维栋","text":"何生知我频载酒，宗弟爱兄亦命车。\n若欲草玄吾岂敢，幽谈拟敌十年书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26447,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山阁杂咏 其二十","author":"梁维栋","text":"飞飞玄鸟兼黄鸟，灼灼红花间白花。\n安得词人三五辈，共题花鸟纪年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26448,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访单传上人于瀑布霞岛","author":"梁维栋","text":"大人多丽壑，谁此觅奇观。\n一刹从天外，诸峰特地攒。\n泉迎三涧落，瀑洒万珠寒。\n瑞草龙髭似，芳苔鸟篆看。\n月光时隐见，霞色远瀰漫。\n绝壁丹梯险，危巅石磴盘。\n侧身防圻岸，屏息瞰斜湍。\n欲尽诸天胜，旋惊鸟道难。\n攀藤垂一线，入户绕千竿。\n流响俱弦管，林香半蕙兰。\n云松窥定密，霞岛得传单。\n说法天花坠，翻经贝叶残。\n君登能者岸，余访志公坛。\n妙辩驱尘劫，深谈沦腑肝。\n传餐香积远，啜茗露华漙。\n却恨林泉外，苍生未奠安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26449,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又七律","author":"梁维栋","text":"百年胜地隐鼍㟲，谁创禅扉坐涅槃。\n花尽空飞慈雨湿，石阶林立法云团。\n尼珠吐月千山炯，仙梵随风万壑寒。\n一叩玄关尘梦醒，将心何处更求安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26450,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠郑惟超北上廷试","author":"梁维栋","text":"洪濛二气何磅礴，瞰观天地亦寥廓。\n伊谁矫矫出风尘，振羽淩霄齐碧落。\n羡君世代本名流，史刺南恩燕翼稠。\n箕裘饶汝绍前烈，书记翩翩上帝州。\n虹霓直吐三千丈，鹏鹗横飞九万秋。\n生平耻混醯鸡侣，生平肮脏思轩举。\n不作江南老步兵，誓向中州摩壁垒。\n壮志方当强仕时，那须瞬目后扬眉。\n愿君勿作容容态，贾生痛哭君所知。\n只今桑孔遍九服，搜采榷酤时仆仆。\n磨牙吮血竞鹰鹯，煮海铸山恣蛇蝮。\n蛇腹鹰鹯岂忍言，九重万里空无门。\n君去临轩如有问，好摅丹悃解民烦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26451,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又七律","author":"梁维栋","text":"经世惟君第一流，蓟门翘首意悠悠。\n三都佳丽归词笔，万里风云拥去舟。\n长剑直从天外指，至言多在殿中收。\n休嗟白璧逢时晚，正是鸣珂报主秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26452,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过冯兵马子遇叔侄池亭","author":"梁维栋","text":"一池澄霁楼台炯，两槛斜翻星斗寒。\n媚客青山当户入，冲琴流水倚阑看。\n雕粱绣柱围图史，玉树琅玕引凤鸾。\n奕世通家余忝附，往来宁惜马蹄繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26453,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"请何广文长者过赏中秋","author":"梁维栋","text":"拄杖虚誇步月桥，菊松三径足逍遥。\n一尊不浅南楼兴，十里欣看北斗标。\n紫气关门仍未散，玄谈石室敢相邀。\n秋风正好鲙鲈日，况有新诗解寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26454,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"承冯长者过羡草亭用韵","author":"梁维栋","text":"栽荷种竹漫临风，敢道池亭习氏同。\n直以蓬心耽僻外，故开茅屋傍山中。\n一林萝薜天阴落，万壑烟光日驭东。\n同调季伦多逸趣，可无飞锡共谈空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26455,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答何长者预订重阳","author":"梁维栋","text":"人间白雪一箴来，天上素秋九月开。\n短发不须妨落帽，高歌先拟独登台。\n中原桃李经题品，故国黄花赖取裁。\n此日知烦太史占，五云奎壁映山隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26456,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偕冯茂才八人重游碧云岛","author":"梁维栋","text":"西郭峰高俨画图，青莲石壁倚虚无。\n龙归云锦泉中出，雨过风涛树杪呼。\n九节昔曾餐紫洞，八公今复对芳湖。\n振衣更挹天浆去，恐触烟霞片片孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26457,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"淇涟约游碧云岛次韵用答","author":"梁维栋","text":"相思高壑贮烟霞，几度登临忆大家。\n选石久悬云外榻，缄书还报洞中花。\n山阴有兴宁因雪，谷口无忘请泛槎。\n一瞬百年须强醉，挥戈谁为返金鸦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26458,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答阮淇涟","author":"梁维栋","text":"一辞燕赵返故乡，匹马萧萧奔夕阳。\n新冢偶怜涕泪合，故人遥隔海天长。\n东来鱼雁双开瞑，西望松楸几断肠。\n登眺有期禄不逮，满山猿鹤助悲伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26459,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠白鹇","author":"梁维栋","text":"丹凤翔飞久未远，因思好鸟出尘寰。\n文多绣错烟霞合，影静园林燕雀閒。\n饮啄自能追桁桁，飞鸣聊且效关关。\n知君鹦鹉能裁赋，对此长吟兴不悭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26460,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬申中秋龙弟见寄和之","author":"梁维栋","text":"处处飞觞待月明，一年好景此宵评。\n浮云乍改须臾色，天地终留永夜清。\n蒲馆师生称赏集，梁园旧好恨难并。\n清辉顿有南来雁，能带新诗问弟兄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26461,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"己未携诸友预登石坛","author":"梁维栋","text":"挈友飞觞上石坛，诸峰晴霁客怀宽。\n青松涛入笙歌蔼，白雁鸢连稚语欢。\n雨气欲从九月黯，菊花先插万人看。\n醉扶落帽还穿屐，莫问参军与谢安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26462,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登飞来","author":"梁维栋","text":"步入飞来兴不稀，洞灵仙侣此中归。\n犀沉锁没川仍媚，猿去环空石自辉。\n帝子春深书寂寂，祠臣碑堕草菲菲。\n细思万象俱尘劫，那似淩空一锡飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26463,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过曲江张公墓","author":"梁维栋","text":"一抔传道曲江墓，舆论同瞻大洞天。\n银烛高从云外出，玉炉端向冢中悬。\n碑残能识唐朝石，疏在常存金鉴篇。\n惆怅代殊风度远，月明华表鹤蹁跹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26464,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"珠矶怀古","author":"梁维栋","text":"珠玑遗迹动凄其，厌说前朝有徙移。\n旧路人非芳草在，故园春尽落花知。\n梅关峰峭那堪挹，浈水渊深祇自悲。\n恨少贞珉传往事，满途燕雀语参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26465,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梅关怀古","author":"梁维栋","text":"庾岭何人倩五丁，张公不负此山灵。\n千年孔道纡筹策，百代奇勋勒鼎铭。\n不断车书趋北阙，联翩旌宠下南溟。\n黄梅亦是传衣钵，水自分流草自青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26466,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登滕王阁","author":"梁维栋","text":"滕王高阁倚江滨，王去江流独怆神。\n白雪寒侵词客赋，朱阑绣拥豫章春。\n波吞日月浮光远，岛吐烟霞飞翠新。\n回首可怜风雨剧，正思舟楫泪沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26467,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟次樟树闻友人李太始捷报","author":"梁维栋","text":"樟水维舟静夜分，晓传春息满氤氲。\n故人颜色壮三月，词客神情恋五云。\n沧海旧怀鸿雁计，赤霄新睹凤凰群。\n摇心岭表趋班地，天路何人共作勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26468,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大小二姑志作孤","author":"梁维栋","text":"大姑山接小姑娇，玉树江枫翠黛摇。\n野史虚添双烈传，仙灵真锁万宗朝。\n妆前日月乾坤远，海上蓬瀛意念消。\n寄语秦楼云外客，漫劳此地忆吹箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26469,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鲟鳇觜黑夜苦雨","author":"梁维栋","text":"鲟鳇三月动云雷，午夜狂风海上来。\n雪涌寒涛天月暝，波侵危缆客愁哀。\n汪洋谁抱澄清志，沦落深惭舟楫材。\n明发渐看红日近，浮云飞尽彩云开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26470,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒昭烈祠","author":"梁维栋","text":"昭烈祠中忆汉庭，云移鹿走泪零零。\n生怜炎祚分三鼎，死恨曹瞒漏五刑。\n风急尚闻龙战野，月明还睹马摇铃。\n漫将成败英雄论，千古君臣照丹青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26471,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宴诸年丈鸡鸣寺松岛","author":"梁维栋","text":"把酒看花倚翠微，流莺声彻柳依依。\n座间云过青留榻，石上苔生紫湿衣。\n聚久肯忘怀落月，兴长犹自怨斜晖。\n老僧忽起钟声入，远至松林送客归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26472,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送钱年丈归通州","author":"梁维栋","text":"一辞北阙共飞扬，南望成均路渺茫。\n冲雨昔怜车马湿，燃藜今喜斗山光。\n芙蓉烂漫秋江色，客子氤氲故国觞。\n此夕因君频睇目，粤云吴树两苍苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26473,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别苏年丈归鼍阳","author":"梁维栋","text":"秋风飒飒动京华，犹带吴江万里槎。\n剪烛共谈燕市事，解貂同醉秣陵花。\n梅开庾岭初含雪，雁入鼍阳晚带霞。\n莫讶分襟横涕泪，依刘王粲忽思家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26474,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋丁祭宿","author":"梁维栋","text":"千年俎豆逢丁日，万国冠裳戒沐时。\n月白衣明心皎皎，风高气肃意夔夔。\n太牢曾识汉庭礼，玉帛深思昭代仪。\n总为菁莪情转切，微才何以答君师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26475,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"台城怀古","author":"梁维栋","text":"玉辇金宫不复游，柳园草色满城头。\n疏钟鸟雀当今夕，画角旌旗记往秋。\n雨散天花无讲席，山含翠黛独登楼。\n伤心莫问前朝事，落日荒台野水流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26476,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又代浙江李咸峰年丈一首","author":"梁维栋","text":"荒城人倚白云边，不见宸游别殿年。\n芳草愁迷驰辇道，雨花空落讲经筵。\n龙蟠台北开晴螮，鸟下湖南起暮烟。\n最是长堤杨柳色，无关兴废自依然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26477,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"城西野望","author":"梁维栋","text":"满目蘼芜落雁边，吴王城外水连天。\n几家茅屋穿青雨，千树垂杨拂白烟。\n别浦参差归社道，空江来往趁潮船。\n山川依旧人非昔，独对高冈思惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":26478,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]