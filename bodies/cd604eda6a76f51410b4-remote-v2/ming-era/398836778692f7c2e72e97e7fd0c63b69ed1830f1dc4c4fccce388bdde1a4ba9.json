[{"title":"玉山中即景","author":"陈聚","text":"杨柳丝丝一径斜，碧溪循绕野人家。\n东风二月春如海，开遍一山桃杏花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17979,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戏蕳草堂主人","author":"陈聚","text":"嘉树萧森六月凉，上有凌霄百尺长。\n秋风莫剪青青叶，留取清阴覆草堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17980,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵顾仲瑛书杜氏便面 其一","author":"袁华","text":"乳燕初飞藕作花，秋娘二八髻双丫。\n臂韝微露真珠络，疑是钱塘旧内家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17981,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵顾仲瑛书杜氏便面 其二","author":"袁华","text":"细雨微风透碧纱，酒痕横面上朝霞。\n君行不唱阳关曲，听取尊前陌上花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17982,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵 其一","author":"沈明远","text":"溪行仍水宿，夜坐散秋天。\n月出青枫里，乌啼古驿前。\n间关怀枉路，泙漫问邻船。\n想忆同心者，裁诗不待眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17983,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玉山草堂（蜀郡虞集隶颜，遂昌郑元祐为记） 其一","author":"朱熙","text":"玉山主人清且妍，标格噭噭人中仙。\n对花时复得诗句，爱客每能挥酒钱。\n寒镫巢雪歌暖响，春水桃源放画船。\n我将载酒即相觅，与尔醉倒薰风前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17984,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"芝云堂分韵得玉字","author":"顾衡","text":"今日新雨霁，山光净如沐。\n晚香浮水花，秋声在庭竹。\n高堂张绮席，谈笑皆雍穆。\n兴酣杂觥筹，诗成粲珠玉。\n清时多遗才，白驹在空谷。\n今者不为乐，逝者良不复。\n呜呜咽洞箫，袅袅度清曲。\n更待月明生，金尊照醽醁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17985,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"芝云堂分韵得生字","author":"顾进","text":"石根云气暖，坐看紫芝生。\n诗酒共为乐，竹梧相与清。\n仙人同跨鹤，玉女对吹笙。\n过雨添凉思，停杯待月明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17986,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"碧梧翠竹堂 其一","author":"良琦","text":"碧梧翠竹之高堂，乃在玉山西石冈。\n浓阴昼护白日静，翠气夜含清秋凉。\n堂中美人双鸣珰，不独痴绝能文章。\n北海李生共放旷，东林惠远同徜徉。\n张骞乘槎下银潢，奉诏远降天妃香。\n帷中灵风神欲语，坛上五色星垂光。\n舟回鲸涛溯长江，故人宛在江中央。\n入门相见各青眼，花间促席飞霞觞。\n清歌遏云锦瑟张，亦有众宾相颉颃。\n祢衡赋就惊满座，宽饶酒深真醉狂。\n黄河东流雁南翔，轺车明朝归帝乡。\n玉堂掖垣梧竹长，题诗寄远毋相忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17987,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"碧梧翠竹堂 其一","author":"聂镛","text":"青山高不极，中有仙人宅。\n仙人筑堂向蹊路，莺啼花落迷行迹。\n翠竹罗堂前，碧梧置堂侧。\n窗户堕疏阴，帘帷卷秋色。\n仙人红颜鹤发垂，脱巾坐受凉风吹。\n天青露叶净如洗，月出照见新题诗。\n仙人援琴鼓月下，枝上栖乌弦上语。\n空阶无地著清商，一夜琅玕响飞雨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17988,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"避暑湖光山色楼二首 其一","author":"释元璞","text":"回溪断岸柳阴疏，酒舍渔家竹径迂。\n一片湖光暮云隔，荷花荷叶带平芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17989,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"避暑湖光山色楼二首 其二","author":"释元璞","text":"重重楼户燕穿风，曲曲红桥绿水通。\n薄暮钩帘对凉雨，一时秋思在梧桐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17990,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋华亭槜李鲜于伯几篆颜）","author":"释元璞","text":"片玉山西境绝偏，秋华亭子最清妍。\n三峰秀割昆仑石，一沼深通渤澥渊。\n鹦鹉隔窗留客语，芙蓉映水使人怜。\n桂丛旧赋淮南隐，雪夜尝回剡曲船。\n北海樽中常潋滟，东山席上有婵娟。\n紫薇花照银瓶酒，玉树人调锦瑟弦。\n醉过竹间风乍起，吟行梧下月初悬。\n一声白鹤随归佩，何处重寻小有天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17991,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣花馆","author":"袁华","text":"鸭绿波摇舰，鹅黄柳覆堤。\n飞花如白雪，流出武陵溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17992,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣花馆","author":"卢昭","text":"黄柳华香水上衣，褰帘亭上挹春晖。\n兰桡一道微风入，却逐金塘燕燕归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17993,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣花馆","author":"黄玠","text":"江南二月柳条青，柳下陂堂取次行。\n兰杜吹香鱼队乐，草莎成罽马蹄轻。\n小蛮多恨身今老，张绪少年春有情。\n得似东吴顾文学，风前雨后听莺声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17994,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣花馆","author":"岳榆","text":"二月风柔雨霁初，芳塘流水碧珊瑚。\n欲维画舫丝犹弱，稍扑湘帘絮已无。\n微影扬波惊鲤队，新阴分色映鹅雏。\n调筝莫按《阳关》曲，时到藏鸦兴未孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17995,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣花馆","author":"顾达","text":"垂丝拂波迥，沉影带云流。\n莺啼渚烟净，燕飞帘雨收。\n萍开双桨荡，花浮群鲤游。\n东风约朝暖，晞发面轻鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17996,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"浣花馆","author":"卢熊","text":"千步垂杨柳，阴连喜水生。\n华深吹落絮，叶密坐流莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17997,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"口占诗序 其一","author":"袁华","text":"横雨狂风二月馀，柳塘犹未动春锄。\n花明兰渚宜垂钓，月暗芸窗好读书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17998,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"口占诗序 其二","author":"袁华","text":"细雨初晴暖尚微，小亭帘幕护春晖。\n曲尘波动鱼初上，金缕条长燕未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":17999,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"口占诗序 其三","author":"袁华","text":"漠漠轻风雨乍收，方塘水生不胶舟。\n慈乌将子避人去，返照正在柳梢头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18000,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"口占诗序 其四","author":"袁华","text":"春塘杨柳未飞绵，已有清阴覆画船。\n好倩吴姬歌《水调》，不辞有罚酒杯传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18001,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"款歌序 其一","author":"袁皓","text":"秋水芙蓉面面开，锦云低护小蓬莱。\n夜深莫把珠帘下，恐有青鸾月底来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18002,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"款歌序 其二","author":"袁皓","text":"玉人花下按凉州，白雁低飞个个秋。\n弹撒骊珠三万斛，当筵博得锦缠头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18003,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"款歌序 其一","author":"秦约","text":"公子渔庄秋气高，湾湾野水曲塘坳。\n隔林月出车轮大，照见华间翡翠巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18004,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"款歌序 其二","author":"秦约","text":"金菊粉蕖秋水滨，恰如生色画屏新。\n荡舟直过红桥去，小队游鱼不避人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18005,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"款歌序 其一","author":"袁举","text":"红白芙蓉照画屏，秋波如镜照娉婷。\n并头花似双蛾脸，一朵浓酣一朵醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18006,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"款歌序 其一","author":"超珍","text":"绣户芸窗八面开，渔庄酒色净如苔。\n鲤鱼三尺丹砂尾，听得清歌出水来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18007,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"款歌序 其二","author":"超珍","text":"雨后芙蓉霜后枫，渔庄只在画桥东。\n不知前面花多少，映水残霞烂熳红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18008,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"顾玉山园池十有六咏 其六 渔庄","author":"袁华","text":"公子不好猎，小庄濠上居。\n长船载大炬，清夜看义鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18009,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题顾仲瑛渔庄 其一","author":"岳榆","text":"文竿比目出清波，翠袖香醪金叵罗。\n凉月团团当槛白，秋花冉冉隔帘多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18010,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题顾仲瑛渔庄 其二","author":"岳榆","text":"黄华丹树绕渔庄，锦瑟秋风子夜长。\n惊起水禽栖不定，背人飞去不成行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18011,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金粟影（白野达兼善隶颜） 其一","author":"释元璞","text":"幽香栏槛绝低小，浑似毗耶丈室空。\n金粟花浮双树月，白莲香散一池风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18012,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"金粟影（白野达兼善隶颜） 其二","author":"释元璞","text":"每闻天鹤乘云下，莫遣仙姝入座中。\n却愧袈裟留住久，钓船犹系柳桥东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18013,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书画舫（濮阳吴孟思篆颜，杨廉夫为记） 其一","author":"黄玠","text":"扣舷击节起歌呜，一榻横舟小结庐。\n篆籀古文三代上，丹青妙手六朝初。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18014,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"书画舫（濮阳吴孟思篆颜，杨廉夫为记） 其二","author":"黄玠","text":"虹光贯月夜将半，江影涵秋凉有余。\n零落宣和旧时谱，无情汴水正愁予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18015,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"淡香亭 其一","author":"卢昭","text":"玉山佳处野亭分，千树梨花白似云。\n仙袂倚风林下得，淡香和月夜深闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18016,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"淡香亭 其二","author":"卢昭","text":"生憎蛱蝶迷春色，不待狻猊换夕熏。\n西郭东阑已陈迹，总传芳扃重鹅群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18017,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春草池（周雪坡篆颜）绿波亭（吴兴沈明远隶颜）","author":"袁华","text":"为爱玉山好，放舟玉山去。\n绿波亭边春入池，况据玉山最佳处。\n时当二月春正美，曲尘摇波草如绮。\n雨惊残梦未鸣蛙，风漾飞花见游鲤。\n大谢文章迥绝尘，江淹词赋亦清新。\n得句池塘怀别远，伤情南浦送行人。\n何如此亭乐赏适，石脚插入鱼龙宅。\n临流行酒水浮阶，俯槛鸣琴光照席。\n君不见山川极目楚囚悲，北望神州泪满衣。\n又不见昆明一夜飞劫灰，汉代衣冠委草莱。\n但愿无事长相见，春草池头日日来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18018,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春草池","author":"顾达","text":"浮飙偃兰薄，飞烟生水涟。\n红沾雨花湿，翠侵衣桁鲜。\n翡翠晚迷径，蜻蜓酣倚船。\n援笔摅藻思，临流怀惠连。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18019,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"绿波亭","author":"顾达","text":"碧色涨春云，圆文生暮雨。\n稍平杨柳岸，已没鵁鶄渚。\n锦鳞唼萍游，兰棹隔烟语。\n曲栏倚东风，怀人渺南浦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18020,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白云海（范阳卢熊公武篆颜） 其一","author":"瞿荣智","text":"白云深，白云深，白云深护山之心。\n有时随龙去东海，倏焉永宇团秋阴。\n英英不来入我牖，直上璇霄掩箕斗。\n或贯日色流玉虹，或漏雷声堕天狗。\n山人学禅草庵里，静看白云朝暮起。\n此心欲与云俱闲，又逐溪风过溪水。\n纷纷武士尚操戈，格斗东南未决何。\n安得此云化霖雨，洗兵甲，散为玉烛，四海皆阳和。\n云兮云兮如擘絮，奈尔东流复如注。\n山人秪在玉山中，长绕山人草庵住。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18021,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白云海（范阳卢熊公武篆颜） 其一","author":"卢熊","text":"山中山中白云深，丈人看云悟云心。\n挂冠笑傲白云外，结楼面势西山阴。\n琼户璇题玉为牖，朝暮白云栖拱斗。\n下视醯鸡瓮里天，车如鸡栖马如狗。\n昆仑方壶图画里，长风吹云海波起。\n青鸾白鹿满芝田，目送归云心似水。\n惭予执笔此操戈，暮下驰驱将奈何。\n雨雪沾衣去家远，寒谷正待嘘春和。\n此身如云等飘絮，日夜归心水东注。\n负郭能分二顷田，我亦还依白云住。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18022,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南涧听水声送别太古禅师（治）","author":"马治","text":"汩汩石上语，浏浏风中琴。\n清晨南涧流，似是太古音。\n出谷乍喧冗，入林杳深沉。\n后来自相续，前者既难寻。\n问客何缘起，悠悠伤别心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18023,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对新柳","author":"马治","text":"萦萦初月柳，撩乱愁边见。\n阴忆武昌门，高想灵和殿。\n金塘承日映，绮陌迎风转。\n学舞未能休，缨情欲谁眷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18024,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春寒慰瓶中杏花（治）","author":"马治","text":"玉瓶春水晓犹添，红萼无言对卷帘。\n莫为桃花翻自恨，梅花时节更清严。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18025,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻笛声送任掾","author":"马治","text":"柳条拂水已堪折，梅花照□如欲言。\n翻向溪桥成久立，春风吹笛黯销魂。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18026,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晏起","author":"马治","text":"樵牧久已出，惊禽噪初阳。\n寝扉南涧伴，疏竹晓风凉。\n夜永道机熟，秋清人意强。\n居山幸一载，晏起适徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18027,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬前（治）","author":"马治","text":"东斋见微月，露坐稀华星。\n感物增惋伤，怀人在岩扃。\n高情沐垂照，寤寐不遑宁。\n中夜梦良觌，君歌谓予听。\n清商随风起，虚箔转琴泠。\n款密松下室，踟蹰水边亭。\n常时往来处，目击心已冥。\n觉闻西涧流，离合方悟形。\n鸡鸣空山曙，开户竹林青。\n忽枉蓬筚信，芳缄耀云屏。\n凄凄贫贱交，恻恻秋露零。\n昔如双飞鹄，于今两枯萍。\n诗中语再四，年运不暂停。\n道术尚迂邈，焉能事仙灵。\n骑鲸倘可望，同日戏沧溟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18028,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宝粹二上人值两留宿西涧草堂明日赋此以赠（治）","author":"马治","text":"相访竹林茅屋下，不因风雨岂留连。\n栖迟尚辱诸公问，来往深惭二子贤。\n落叶下山逢虎迹，疏钟隔水见人烟。\n旧游空忆钱塘去，闻道如今异昔年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18029,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵酬前（治）","author":"马治","text":"蝉鸣秋雨里，山舍竹林园。\n政尔无来迹，非关久避喧。\n坐看高士传，梦往故人门。\n生意唯萧索，心知自不言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18030,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"读书","author":"马治","text":"窜身丹厓下，灭迹浮云端。\n余事既不闲，冥心以游观。\n读书南山日，秋气浩漫漫。\n悲商扣庭柯，四座鸣风湍。\n已与清景晤，乐哉此盘桓。\n餐和遗糟粕，饮胜入肺肝。\n隐几俄万古，其人梦交欢。\n携手逍遥墟，乾坤欻高寒。\n顾谓尘世子，斯道自平宽。\n胡为在荆棘，方寸生波澜。\n向无问津者，悲尔后来难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18031,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"同赋（治）","author":"马治","text":"岁云暮矣天涯客，今夕能来慰不眠。\n坐久依依思远道，气酣往往说当年。\n春游吴苑君常惯，雪咏钟山我自怜。\n惆怅情悰那再得，荆溪漫有酒盈船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18032,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日试墨二首（治） 其一","author":"马治","text":"竹雪寒声泻，山禽好语来。\n空余腊月酒，拟访石亭梅。\n野水宜舟楫，春云费剪裁。\n从前江海上，今日意悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18033,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日试墨二首（治） 其二","author":"马治","text":"白发形归梦，青灯照隔年。\n远惟诸弟忆，贫幸老人怜。\n四海孤飞鹤，东湖二顷田。\n谁能论心迹，出处事皆天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18034,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"因泉公归蕳王二秀才（治）","author":"马治","text":"泉公相见即言归，因忆王生住翠微。\n诗卷或留禅榻畔，酒船还傍钓鱼矶。\n春来物色偏愁思，老去人情愿息机。\n欲折芳馨遗远者，劳心东逐片云飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18035,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"绝句五首（治） 其一","author":"马治","text":"秋至衣裳薄，思归未有涯。\n得如江巨孝，处处自将车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18036,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"绝句五首（治） 其二","author":"马治","text":"一从蔷薇绿，经秋忆故庐。\n乡书夜来到，只是更愁予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18037,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"绝句五首（治） 其三","author":"马治","text":"有弟天涯隔，无人消息稀。\n何时比鸿雁，一道向南飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18038,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"绝句五首（治） 其四","author":"马治","text":"蚤学屠龙技，三年望有成。\n朝来鉴海水，华发已先明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18039,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"绝句五首（治） 其五","author":"马治","text":"得志有偶尔，居贫方晏然。\n君观纸上墨，一日是千年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18040,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次韵酬前","author":"马治","text":"竹里新泉绕屋除，长年吾得乐闲居。\n道心澹泊诸尘外，山意微茫邃古初。\n风雨满檐松子落，夕阳穿树橘林疏。\n可怜原宪闲来往，犹自生涯不废书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18041,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"食茯苓粥","author":"马治","text":"颇闻学士防风粥，曾吃诗人锦带羹。\n岂谓茯苓宜岁晚，已收粳稻得霜晴。\n腥膻习漫从教洗，禽鸟形残不忌烹。\n饱食未须论月给，石杉偕坐听松声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18042,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次前韵","author":"马治","text":"多罗树下昔徜徉，尘世归来已渺茫。\n犹有狂吟三百首，逢人大笑亿千场。\n西风雪气纷纷白，夜雨河流混混黄。\n忽对青山嗟岁晚，知君纵笔兴难忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18043,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暂违老亲陪履道泛湖归省无锡治","author":"马治","text":"湖口仓忙别老亲，东行且就雨吟身。\n烟波渺似鸿荒世，舟楫轻宜澹荡人。\n几处青山牛马饮，一行白雪鹭鸥驯。\n沙头击鼓曈曈日，知有闲官尚守津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18044,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"玉山主人书画舫","author":"王蒙","text":"乱后重登旧草堂，主人延客晚樽凉。\n风摇竹影书签乱，花落池波砚水香。\n离别顿惊年岁改，梦魂愁杀路途长。\n欲知阮籍何由哭，四海兵戈两鬓霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":18045,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]