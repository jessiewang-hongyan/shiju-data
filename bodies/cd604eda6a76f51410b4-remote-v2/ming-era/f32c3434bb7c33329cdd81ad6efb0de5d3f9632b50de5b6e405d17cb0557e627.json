[{"title":"春日游高座寺二首 其二","author":"顾璘","text":"花发其如逸兴翔，春山酾酒惜年芳。\n台高忽见江流近，寺古惟闻松柏香。\n并游骄马花边去，独啭新莺竹里藏。\n寻壑经秋共忘返，还怜白日转添长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58163,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和望之惜园花尽开之作","author":"顾璘","text":"十日春晴花尽开，一年春事半莓苔。\n疏枝密萼相将盛，粉蝶黄峰莫浪猜。\n漫举金杯当月榭，谁吹玉笛傍霜台。\n芳菲未忍随流水，绕树攀条意独哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58164,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"吴太宰新堂初成有鹊来巢","author":"顾璘","text":"相国新开绿野堂，堂前灵鹊早呈祥。\n来依乔木营门户，欲傍青云化印章。\n幽砌颇宜迎客噪，高檐何碍顺风翔。\n雕梁画栋相鲜地，最爱诗题素璧光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58165,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日顾吏部武祥张兵部惟静携酒过息园重辱佳篇漫谢一首","author":"顾璘","text":"清溪竹径久荒芜，二仲逢春试玉壶。\n即有荆花当户紫，更多萱草映阶铺。\n衰颜屡喜依璚树，秀句时惊落蚌珠。\n高驾往来殊不恶，莫因疏懒厌潜夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58166,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寿姜节举人父母","author":"顾璘","text":"七十二峰如列戟，太湖深护隐君庐。\n家贫莱妇能逃禄，身老庞公不著书。\n生理剩栽岩畔橘，旨甘时荐舍前鱼。\n青春令子方腾踏，云路遥乘驷马车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58167,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠朱铭甫还松江","author":"顾璘","text":"太学贤名众不如，九峰归省老尚书。\n才华独擅三都赋，门阀重高驷马车。\n吴苑天寒收橘柚，松江霜落荐鲈鱼。\n遥知彩服趋庭后，读尽家藏万卷馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58168,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈子文赴广西","author":"顾璘","text":"八桂西瞻岳牧尊，使君持节下湘源。\n星岩风洞山殊秀，雪片霜华地不暄。\n永日赋诗薇阁静，青春行部绣旗翻。\n从来远地多名宦，铜柱犹闻颂马援。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58169,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陈京兆祐乡还南海","author":"顾璘","text":"疏傅悬车缘底事，温公避位本初心。\n蛟龙远适江湖性，鸾凤高辞枳棘林。\n多病逢人求大药，有怀浮海发孤吟。\n移家勿向罗浮住，使者来徵恐莫寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58170,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西爽草堂","author":"顾璘","text":"草堂寄在国门阳，西岭蟠回入户苍。\n含云洞壑泉台迥，碍日松梧露径长。\n岁岁采蘋脩俎豆，重重栽竹护垣墙。\n南州高士今难作，唯听慈乌吊白杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58171,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送王文光宰定海","author":"顾璘","text":"曲江落羽人皆惜，东海分封众所荣。\n喜见疲民投父母，愿因明主致升平。\n花间草长逢驯雉，谷口春归听早莺。\n看取汉家循吏传，独怜卓茂最知名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58172,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"孟中丞命酒息园集诸文士赋一首","author":"顾璘","text":"山人避俗野园开，宪府邀欢载酒来。\n浮杯岂让山阴会，授简还徵邺下才。\n暂遣閒云依绂冕，更呼明月照池台。\n锦筵烂漫唯须饮，画烛阑珊未拟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58173,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登清凉寺后西塞山亭四首 其一","author":"顾璘","text":"霄汉秋高烟雾开，旧京西望一登台。\n皇居迥映钟陵起，海水遥吞鹊镇来。\n半岭颠风频落帽，孤亭斜日更衔杯。\n乾坤转盻皆陈迹，况复浮生白发催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58174,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登清凉寺后西塞山亭四首 其三","author":"顾璘","text":"山阁难禁宋玉悲，六朝遗恨满残碑。\n青山自拥蟠龙势，玉树空传落燕词。\n寒节授衣伤老大，醉乡随钟愧支离。\n歌筵舞妓非前代，文采风流又一时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58175,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"登清凉寺后西塞山亭四首 其四","author":"顾璘","text":"剑化人亡有故城，东来海气带龙腥。\n烟花楼阁三千界，锦绣河山百二形。\n老托神京堪自隐，醉眠秋涧不知醒。\n长江只在朱阑外，莫遣哀歌动杳冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58176,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅开答孟中丞厌客之嘲","author":"顾璘","text":"骢马能过问野梅，柴门何惜向阳开。\n空劳野客巡檐笑，实少高人载酒来。\n地僻谁怀元亮宅，月明深负谪仙杯。\n须知竹下三三径，本为招邀二仲裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58177,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和许隐君游西湖","author":"顾璘","text":"千峰万壑断飞埃，百顷湖光演漾开。\n大块丹青随意得，炎天冰雪傍舟来。\n不禁杨柳牵衣袂，况复荷花近酒杯。\n曾是君王游赏地，采云犹护旧歌台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58178,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"拜岳武穆庙","author":"顾璘","text":"水白云青庙貌明，墓门乔木尽南生。\n天高竟吼三人虎，国破谁摧万里城。\n望断白龙无死所，歌残黄鸟有馀情。\n海波东去厓山远，精卫千年恨未平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58179,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"文徵仲翰院约游西湖不至次韵奉嘲","author":"顾璘","text":"怀君不见动经年，有约犹悭访戴船。\n草阁自含悬榻愧，莲舟终少听歌缘。\n徒闻避俗称高士，未必寻幽损大贤。\n落日倚栏空伫立，海山千点澹苍烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58180,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和许隐君留别","author":"顾璘","text":"丹山碧水古王城，处处登临滞客程。\n幽壑风烟须纵酒，暮年朋旧独关情。\n劳生苦觉沧洲远，别路空馀白发明。\n客里送君秋又至，临岐休怪旅魂惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58181,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"天真寺访薛尚谦因怀伯安王尚书","author":"顾璘","text":"江边寺里为君来，绝璧高亭对酒杯。\n万里海波冲鸟落，半天风雨挟龙回。\n苍松解引寻真路，宿草空伤济世才。\n莫上书堂歌伐木，寒泉呜咽使人哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58182,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"湖寺观雨","author":"顾璘","text":"湿云吹墨溅湖波，急雨翻盆落涧阿。\n江郭众山当面失，寺门孤树柰风何。\n浮生白发馀高兴，暇日清尊且浩歌。\n蓑笠醉归还自笑，晴天曾得几回过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58183,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和刘光禄观潮","author":"顾璘","text":"江楼再上思前事，十度流年指一弹。\n满目波涛还自至，旧时宾客不同观。\n玉龙气涌澄江动，雪练光摇大海宽。\n欲挽灵槎上霄汉，祇愁风露弄秋寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58184,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游三竺后暮泛西湖归城呈汪按察","author":"顾璘","text":"风度疏钟出万山，天成楼阁挂岩间。\n松林落日晖晖白，石涧幽花细细斑。\n脩竹禅房堪载酒，乱峰云树暂怡颜。\n兰舟荡漾西湖水，怅望严城暮始还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58185,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"云居送蔡武库赴南曹有怀故国","author":"顾璘","text":"云寺迢遥来送客，松关缭绕不逢僧。\n堪怜把袂临秋草，转愧斋心对佛灯。\n旅况乡愁依去棹，月华风影乱寒藤。\n高岩总是销魂地，天畔危栏莫尽凭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58186,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"思归和刘介夫中丞","author":"顾璘","text":"寒月满天鸿雁飞，中宵独立明星稀。\n栖迟东省愧官俸，怅望西湖思钓矶。\n采服家园三径远，白头天地一身微。\n才迂岁晚竟何补，早晚孤舤江上归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58187,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日郊行三首 其一","author":"顾璘","text":"条风曳微云，山色差可美。\n日出湖上行，春光满湖水。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58188,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日郊行三首 其二","author":"顾璘","text":"麦垄摇新叶，梅塘泛落花。\n前村天欲雨，云里见人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58189,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日郊行三首 其三","author":"顾璘","text":"白石明春泉，苍林暗春雾。\n马蹄从东来，失却山间路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58190,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄杨太康","author":"顾璘","text":"明月生遥岑，清光转华薄。\n楼上忆君时，秋风动罗幕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58191,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送客归吴","author":"顾璘","text":"草际日华淡，水边云意閒。\n翩翩五陵客，骑马入秋山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58192,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"与陈鲁南","author":"顾璘","text":"浮云淡秋水，落日横暮山。\n与子有幽抱，时在山水间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58193,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"幽人","author":"顾璘","text":"竹静风己归，亭虚云自过。\n幽人了无事，坐玩閒芳堕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58194,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏扇画寄诸故人八首 其一 咏松寄乔白岩光禄","author":"顾璘","text":"青松高千尺，知是何年栽。\n独有憩阴者，时为清风来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58195,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏扇画寄诸故人八首 其二 咏山水寄易后斋进士","author":"顾璘","text":"故乡宛如昨，近郭多池台。\n一别同心侣，无因数往来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58196,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏扇画寄诸故人八首 其三 咏葵寄郭东厓侍御","author":"顾璘","text":"花色亦何贵，画葵爱葵心。\n岂无桃李颜，要非君所钦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58197,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏扇画寄诸故人八首 其四 咏芙蓉寄张南园太常","author":"顾璘","text":"旖旎芙蓉花，荡漾木兰楫。\n相思隔湘水，欲采不可得。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58198,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏扇画寄诸故人八首 其五 咏菊寄潘团山侍御","author":"顾璘","text":"寂寞东篱下，幽花裛露黄。\n自缘寒节至，不是爱秋霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58199,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏扇画寄诸故人八首 其六 咏桂寄王阳明主事","author":"顾璘","text":"明月皎如银，中有丹桂影。\n怀人坐良宵，衣裳露华冷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58200,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏扇画寄诸故人八首 其七 咏芍药寄李崆峒郎中","author":"顾璘","text":"春芳已摇落，一枝开庭阴。\n迟暮不自惜，东风讵知心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58201,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏扇画寄诸故人八首 其八 咏菊寄何白坡中舍","author":"顾璘","text":"寂寞三径下，亭亭带晨霜。\n行人爱嘉色，君子怀清香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":58202,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜汎","author":"顾璘","text":"四冥波浩浩，一苇向空渡。\n月近星斗寒，始识天上路。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06