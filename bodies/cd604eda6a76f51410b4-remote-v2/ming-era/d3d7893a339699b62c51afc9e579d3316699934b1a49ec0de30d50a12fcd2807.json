[{"title":"寄黄六柳","author":"李之世","text":"久辞簪绂返田庐，萝薜森森称隐居。\n地近柴桑多种柳，林疑濠濮足观鱼。\n彤云染翰开金歼，清月焚香叩玉虚。\n此日汉庭求禅草，可云消渴老相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27301,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄何文起","author":"李之世","text":"去矣年华雨鬓侵，芳游何日惬招寻。\n疏桐露引萝轩月，画栋云移碧砌阴。\n曲涧移泉通药圃，当窗列树尽瑶林。\n洞门旧有留题在，缘藓春来知几深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27302,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄张约之读书白云山中","author":"李之世","text":"白云山上白云居，袅袅丹梯万仞馀。\n君自磨厓寻胜迹，何须服食检方书。\n三冬琪树依瑶圃，半夜银蟾傍土除。\n闻道班麟还可驭，凌风聊试碧霞裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27303,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居呈王老师兼寄湛仲宾 其一","author":"李之世","text":"蔓草苍藤次第除，小亭灌木共萧疏。\n驰驱自信无长策，贫病因知恋敝庐。\n时复攒眉过白社，更谁载酒问玄居。\n倦游司马多愁渴，犹向文园赋子虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27304,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居呈王老师兼寄湛仲宾 其二","author":"李之世","text":"叠石为坛竹作林，编茆幽结薜萝深。\n三千客里空长铗，万事邱中有短琴。\n静爱松风醒蝶梦，閒调天籁韵禽音。\n栖迟漫笑儒冠拙，何地江湖不陆沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27305,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居呈王老师兼寄湛仲宾 其三","author":"李之世","text":"落絮游丝片片浮，小园萧索不禁秋。\n衰荷欲卸红妆淡，嫩竹疑含粉黛愁。\n曲沼平添疏雨润，高台独上晚风遒。\n最怜潘岳多情思，不赋閒居亦白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27306,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日园居呈王老师兼寄湛仲宾 其四","author":"李之世","text":"一雨能消暑气残，幽斋晴景更宜看。\n床头堕叶摊书满，槛外飞花扑径寒。\n山色濛濛当睥睨，商声淅淅戛琅玕。\n关河迢递知音隔，独抱丝桐未忍弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27307,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恭陪王老师谒白沙先生祠","author":"李之世","text":"路转丛篁一径分，遗祠肃穆俨江濆。\n閒云不扫苍烟合，湛露长披碧树薰。\n曲坞潭清犹贮月，空阶苔古尽成文。\n宫墙此日堪翘首，蘋藻何人共荐芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27308,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"嘉会楼","author":"李之世","text":"百尺飞楼抗彩霞，荒村篱畔带渔家。\n巡檐老鹤巢朱拱，泛浦春鸥点碧沙。\n庐阜堂空山月静，楚台人去暮云斜。\n惟馀桃李攒芳径，啼鸟年年对落花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27309,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途中杂咏同区季誉 其一","author":"李之世","text":"马迹难消驿路尘，惊看时序物华新。\n流莺出谷初求友，海燕衔坭欲傍人。\n榆荚半霏寒食雨，桃花疑带武陵春。\n杖藜准儗寻芳去，泽畔行吟问楚臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27310,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途中杂咏同区季誉 其二","author":"李之世","text":"无才秖合老盐车，敢向穷愁问著书。\n贫似张仪犹有舌，病怜潘岳未宁居。\n中原游侠千金尽，上苑烟花三月馀。\n共道吴门容大隐，恐伤留滞鬓毛疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27311,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途中杂咏同区季誉 其三","author":"李之世","text":"拂面轻尘捲地遥，杨花点点扑征轺。\n疏槐野火连官舍，断碛残冰没短桥。\n日落荒原人迹少，风生嫩草马蹄骄。\n旗亭处处堪乘兴，拚典鹴裘慰寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27312,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途中杂咏同区季誉 其四","author":"李之世","text":"官衢细柳曲沿堤，晓起冲寒一径迷。\n古木断桥频骇马，疏星茆店忽闻鸡。\n哨林猎火时时出，腰箭行人队队齐。\n同是五陵游侠地，王孙归思草萋萋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27313,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途中杂咏同区季誉 其五","author":"李之世","text":"疲马间关畏路难，每逢村店卸征鞍。\n榆钱杖底宁沽酒，柳絮风前不耐寒。\n一饭侏儒谁欲饱，千金漂母若为欢。\n天南天北无归计，长铗飘零未忍弹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27314,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途中杂咏同区季誉 其六","author":"李之世","text":"晓起登台思惘然，乡书遥滞岭云边。\n悲同倦马频思枥，归似宾鸿动隔年。\n几点残霞明旧垒，数家榆火试新烟。\n青门尚有宜瓜地，何必还山买秫田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27315,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途中杂咏同区季誉 其七","author":"李之世","text":"嫩绿柔红斗晓晖，江南花信未全稀。\n镜前病起愁添鬓，马上春寒未授衣。\n蔓草似连边外色，遥山半入雨中微。\n家园三径知无恙，碧荇苍苔满旧矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27316,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途中杂咏同区季誉 其八","author":"李之世","text":"不尽川原指顾中，凭轩一望思何穷。\n夕阳瘦马明寒影，古木哀猿吟暮风。\n废苑碑残惟卧草，断沟水咽自流红。\n年华滚滚送过鸟，词客登临感慨同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27317,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中遣怀效吴音兼寄方孟旋 其一","author":"李之世","text":"为爱扁舟信往还，一尊临水复看山。\n双双黄鸟迎人语，点点沧波照客颜。\n剩有百钱携杖去，从分半席伴鸥閒。\n笔床荼灶随供具，较胜松房静掩关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27318,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中遣怀效吴音兼寄方孟旋 其二","author":"李之世","text":"水逝花飘稔有情，凌波睇望澹盈盈。\n却怜弱荇牵风转，不厌垂杨拂棹轻。\n山学鸦黄当镜立，江分鸭绿入杯平。\n更谁消受湖中景，十里芳莼一勺羹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27319,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中遣怀效吴音兼寄方孟旋 其三","author":"李之世","text":"昼永人閒睡思浓，沿洄孤棹任从容。\n茶烹雪乳称禅味，饭惜雕胡罢午供。\n拄杖时听群鸟哢，寻山忽讶一僧逢。\n春流处处桃花浪，未信仙源隔几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27320,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中遣怀效吴音兼寄方孟旋 其四","author":"李之世","text":"长日冲波不断流，滔滔送尽几行舟。\n柳条有意垂青眼，江水无情浪白头。\n浮海鸱夷称范蠡，漆园蝴蝶是庄周。\n尘劳传悟三生幻，取醉聊为汗漫游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27321,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"严子陵钓台","author":"李之世","text":"汉祚山河运已移，桐江犹系一纶丝。\n空传帝座占星日，不见羊裘把钓时。\n蔓藓半封前代碣，芳芹徒结后人思。\n可怜流水滔滔逝，来往年华泣路岐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27322,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游郭塘村题壁","author":"李之世","text":"历险乘危倦复登，寻幽那有几人曾。\n涧桥忽断遥攀树，上屋将欹半碍藤。\n楮叶坛边挝社鼓，岂花棚下晒鱼罾。\n农谈真觉尘心尽，愧我移家远未能。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27323,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒居","author":"李之世","text":"昼永柴扉寂不扃，荒墟微日澹栊棂。\n僧过竹院频留偈，客散茶寮自续经。\n鸟语忽从花底哢，渔船閒傍柳阴停。\n幽栖未便忘人世，肯向尊前赋独醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27324,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠张逸人","author":"李之世","text":"象岭桃花几度春，却从流水认芳津。\n蓬莱自隔三千界，沧海难消万劫尘。\n青鸟乍衔青玉检，白云编恋白纶巾。\n从他甲子山中换，依旧烟霞伴主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27325,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬夜刘平子过中林居话别","author":"李之世","text":"淅淅疏林惊暮鸦，涓涓零露滴蒹葭。\n叫云雁起他乡思，泛月人归午夜槎。\n阶冷茶烟清竹色，杯长语澹落灯花。\n龙潭剩有重游约，吩咐山灵护碧霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27326,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同梁山人过访陈宪副有赠","author":"李之世","text":"帘外青山草似茵，閒门车马寂无尘。\n一官荒徼仍移病，千里还家不却贫。\n院里莺声浑是旧，镜前华发总怜新。\n玄亭此日堪携酒，莫厌侯芭问字频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27327,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过水竹洞偶题","author":"李之世","text":"閒馆秋深草色菲，主人懒癖到来稀。\n门添野竹成新径，水过寒塘绕旧矶。\n背石昔移红药老，藉槐刚喜绿阴肥。\n中林亦在溪流里，两地莺声对掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27328,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽王师祖我希公","author":"李之世","text":"万里携家瘴疠俱，一官牢落寄江隅。\n魂归华表人疑鹤。\n梦绕云霄舄是凫。\n尚有生祠遗海峤，谁传哀讯入皇都。\n独怜宦况清如水，悬橐萧萧此问途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27329,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉慰王虞石老师","author":"李之世","text":"一夜灵椿陨玉枝，西风吹梦遍江湄。\n中朝方藉燕然石，瘴海人看堕泪碑。\n马首瞻云空有恋，螭头捧檄转成悲。\n关河望断无消息，边塞迢迢去雁迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27330,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒食斋居何文起将之五羊以书话别怅然赋此","author":"李之世","text":"凉雨如丝草似茵，那堪病起惜芳辰。\n为怜涧芷思公子，况对青山别故人。\n野蝶乍来还乍去，啼鹃疑唤又疑嗔。\n盈盈一带珠江水，祇有双鱼入梦频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27331,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿何廷尉玄谷先生","author":"李之世","text":"拂曙条风应紫宸，莺声初度绮筵新。\n玄冠自识持平吏，彤管曾参著作臣。\n官驿驱邮行赴阙，家山戏綵暂娱春。\n金盘赐有仙人露，玉树分行捧斝频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27332,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中林晚坐同平子拈十四盐","author":"李之世","text":"浪把年华梦里占，五惊秋雁度虚檐。\n窗前落箨时敲户，雨后凉蟾半挂帘。\n暗洫自通千涧入，薄云微露一峰尖。\n俗情休问邯郸枕，与尔忘怀寄黑甜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27333,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁伯静过中林夜话复用十四盐","author":"李之世","text":"野馆凉飔可辟炎，青灯犹喜故人兼。\n阶前绿草全欺鬓，镜里繁霜欲糁髯。\n愁绪每寻欢伯遣，痴心频向梦魔占。\n劳劳门外饶车马，可道潜夫老更潜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27334,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"池中石笋","author":"李之世","text":"休将一点儗蓬瀛，杳杳君山隔洞庭。\n霜后潮痕添晕绿，雨馀苔色带螺青。\n人从镜面窥云窦，鱼啖花阴立翠屏。\n最是凭栏无那处，露荷香送酒微醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27335,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"矶边树","author":"李之世","text":"此树移根几许年，即看沙溜漱涓涓。\n生成拱把知何用，纵作条枚不值钱。\n渔父伐竿寻短橛，儿童掠马望高颠。\n无人消得閒风景，借与山房荫画船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27336,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得移舟扫叶","author":"李之世","text":"才见河流漫石矶，偏嫌黄叶点苔衣。\n轻移舵尾旋开阵，转过风前又合围。\n波面捎来云叠叠，长空掠处羽飞飞。\n林园镇日閒相闹，陡觉秋霜气力微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27337,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"先室生辰有荐","author":"李之世","text":"可道香魂梦未醒，凭将杯酒话年龄。\n帐前烛影难成焰，案上炉烟不断青。\n蛛网拂檐斜入闼，花阴笼日澹移棂。\n夜分无限相思恨，谁报潘郎鬓欲星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27338,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"余方营剩溪梁子鱼携诗过访喜而有赠","author":"李之世","text":"园庐小结傍林梢，蔓草荒丛土一坳。\n性似鱼蛮贪剩水，居同燕子岁营巢。\n非村非郭聊依隐，为白为玄总任嘲。\n闭户以来无胜事，凭君携韵到衡茆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27339,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何文起将营西山别业拉余往观因而有赋 其一","author":"李之世","text":"城里住山独擅奇，买山还订住山期。\n白云窥户知新主，黄鸟投林借旧枝。\n废井觇泉荷锸往，荒阶种石带苔移。\n镌厓未暇穷幽胜，一为烟霞洗俗姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27340,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何文起将营西山别业拉余往观因而有赋 其二","author":"李之世","text":"缘萝折折到柴扃，林自萧森壑自冥。\n依隐自怜芳桂绿，卜邻偏藉古松青。\n溪山佳处宜层阁，登陟疲时可一亭。\n记取池边数片石，品泉留与续茶经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27341,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同文度舍弟閒步青竹园","author":"李之世","text":"疏篁成聚土成坳，半是城居半是郊。\n名编水国非无籍，家住丛林氏有巢。\n沙崩欲坠藤犹结，树冗频删叶又交。\n隔窗梧露垂垂滴，且共研朱点易爻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27342,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初夏小步池亭","author":"李之世","text":"勾管春风又一场，帘栊刚讶绿阴长。\n黄梅子熟连朝雨，白苧衫轻试晚凉。\n草带欲临书幌动，荷钱初汎墨池香。\n残芳冷落无人采，趁著游蜂过短廊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27343,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春杪閒步小园因寄区茂对索花","author":"李之世","text":"每个石头消一坐，池阴深处纳凉时。\n隔云穿过泉无碍，带雨移来树不知。\n窗隙乍开删密叶，溪光欲断补疏篱。\n东皋多少閒春色，剩本从君乞数枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27344,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同区君玉宿白云山","author":"李之世","text":"寂寂虚窗瞰碧岑，孤灯一榻白云阴。\n泉因洗钵来香积，月伴听经到法林。\n露冷松风生涧底，僧閒夜语隔溪深。\n空山秋色无人管，惟有寒螀绕砌吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27345,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚申秋日恭陪王侍御老师往宁阳奉祭太师祠限韵","author":"李之世","text":"千秋流韵使人思，下马城隅拜旧祠。\n召杜堂前歌乐只，冷风亭畔弄流飔。\n山僧迓客开閒院，父老逢人话往时。\n樗散亦叨门下士，一杯明水荐江蓠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27346,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饯王侍御老师于浴日亭用长公韵","author":"李之世","text":"南溟天外几重天，海国神祠占碧湾。\n九译梯航来粤峤，累朝琮璧镇灵山。\n观风此日留高韵，揽辔清时识壮颜。\n独有宫桃沾雨露，偏多离思水云间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27347,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题叶山人溪上新居","author":"李之世","text":"郭外遥遥可辟喧，买居兼得带荒园。\n白蘋浪里藏鱼市，红树中间见酒村。\n小雨邮云来石榻，寒潮送月到柴门。\n常闻采药归家少，墙上人题姓字繁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27348,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同甘存之区君玉游蒲涧次长公韵","author":"李之世","text":"古寺荒凉夕照前，空馀石壁泻流泉。\n行穿宿莽千迷道，却望悬崖一线天。\n涧底有蒲堪服食，山中无榻可安禅。\n依稀似识曾游地，莫是前身白鹤仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27349,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游南华寺 其一","author":"李之世","text":"香泉流出响淙淙，回合宁知翠几重。\n度过盘冈微有径，转寻洞口已无踪。\n山中原亩全归寺，庄落僧徒半力农。\n行列溪桥还五里，遥风先送殿前钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27350,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游南华寺 其二","author":"李之世","text":"山门矗矗临溪水，绀宇森森锁翠微。\n玉检三朝封御敕，金函几世护传衣。\n天花和雨空中落，松子飘霜殿角飞。\n欲识西来真面目，一龛灯影鉴重帏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27351,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜宿黄塘驿","author":"李之世","text":"候馆迢迢未向明，劳人深夜听严更。\n家山故梦犹萦枕，仆马前途已戒程。\n冲雪自怜双鬓薄，肩云休讶一囊轻。\n名场苦海真谁破，屈指庾关五度行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27352,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过东华寺故址","author":"李之世","text":"空江禅院杳无踪，浩劫何年此地逢。\n金像有灵浮浪出，石碑无字半坭封。\n溪边网得前朝钵，海上人收古殿钟。\n十载经游浑一梦，依稀还记寺门松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27353,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"虔州看春","author":"李之世","text":"闹鼓沿街竞晓晨，仙幡綵仗引芒神。\n城头画角吹残雪，水面红楼占早春。\n弦管独喧歌舞处，绮罗争踏冶游尘。\n他乡乐事同杯酒，醉里还惊客思新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27354,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长日","author":"李之世","text":"长日江干苦滞淫，寒潮过雨澹阴阴。\n岂缘世路抽身早，祇为风尘染病深。\n收药时时参本草，思归小小理园林。\n明时未必能终隐，且向青山一问心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27355,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟中漫兴","author":"李之世","text":"去路来程不暂停，十风五雨浪溟溟。\n长江送客头俱白，岸柳窥人眼尽青。\n朝汲分泉浇药臼，夜灯留火煖茶瓶。\n病来差有閒心力，且向篷窗了旧经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27356,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄放生社诸子","author":"李之世","text":"放生曾结万人缘，卜社东皋已一年。\n买蛤自寻鲜市去，施禽多在砌丛边。\n为求邻地安僧灶，早向檀那乞布钱。\n我亦行踪无住著，归来长侍佛炉前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27357,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南昌元旦","author":"李之世","text":"不逐攘攘车马尘，暂随时俗庆年新。\n金钱粗办施僧寺，门板分书给贾人。\n旅馆难逢千日醉，菜盘又见一回春。\n閒身自觉无拘束，万事萧疏总任真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27358,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠小尼师","author":"李之世","text":"刚著麻衣色尚鲜，发痕如黛额珠圆。\n莲花座下参新偈，柳絮丛中悟夙缘。\n上塔烧灯誇趫捷，随班礼佛让轻妍。\n閒来学写华严字，匀蜡和香自碾笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27359,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过虔州访东溟上人不值闻寓潭江赋此寄赠","author":"李之世","text":"多为檀那开讲席，独留弟子扫禅关。\n交游方外情弥重，出世缘中法未閒。\n到处逢人脩净土，观心了不住名山。\n盈盈相望潭溪水，一棹西江载月还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27360,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重登雪浪阁","author":"李之世","text":"朱楼映带绿萝新，指点灵关迹已陈。\n台馆到来浑旧识，江山别后几游人。\n松风送雨吟虚阁，雪浪飞花捲暮津。\n惟有玄潭清似昔，八年重浣客衣尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27361,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠玄真观道士","author":"李之世","text":"玄帝行宫傍斗坛，阴阴翠洒石床寒。\n云边薜荔堪裁衲，月下芙蓉自制冠。\n药本每教童子觅，方书不借外人看。\n年来多病寻真诀，丹药从师乞一丸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":27362,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]