[{"title":"日夕坐泉亭用韵","author":"邵宝","text":"坐深秋日澹娱人，始信西神本有神。\n诗迈寻常知子久，酒开涓滴写吾真。\n雷声渐鼓千峰雨，苗色将回七月春。\n瘗卷邱边话畴昔，江花江草几回新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47428,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"费子美过锡病不能来遣其子来访且索诗遂赋以赠","author":"邵宝","text":"病馀闻荐喜君来，秋卷南归又几回。\n齐瑟未须论往事，燕台终不负良材。\n朝廷礼遇应前席，家世文章自上台。\n江郭萧条惊岁晚，凤凰池上有春雷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47429,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谢朱巡按下问","author":"邵宝","text":"梦忆泉声赋两知，赓歌先得一缄诗。\n雪山轻重公来去，河水清涟我病衰。\n满地江湖容白发，可人风月负青藜。\n平生知己观风使，愿共山中折桂枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47430,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"点易台观泉","author":"邵宝","text":"点易台南滴露泉，石边一穴水精圆。\n方诸未挹天边月，沆瀣虚传海上天。\n白鹤远来云表外，碧窗深隔洞门前。\n晚年对此心常活，何处清凉更问仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47431,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀管司训","author":"邵宝","text":"履违公府十年多，门刺因君两度过。\n老母寿能成旷典，郎君政不负高科。\n晚风海上吹寒菊，秋雨江南熟早禾。\n更爱儒官成绩远，手栽桃李听弦歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47432,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱都事相之云南","author":"邵宝","text":"万里滇南帅阃开，幕僚今喜得英才。\n胸中丘壑供挥染，眼底烟霞任剪裁。\n闭户读书踰十载，出门献赋动三台。\n清时戎政多参画，行见封章起宪台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47433,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阅马迹山记寄西青山人","author":"邵宝","text":"西青山人作山记，搜剔幽隐山灵愁。\n迹缘神马自秦汉，祠追后稷经虞周。\n寻常一水五湖老，七十二峰千古秋。\n分明图画在中沚，美人何处心悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47434,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽素庵李君","author":"邵宝","text":"愚翁风采动华阳，素老相承倍有光。\n灯火梦回吴会远，诗书脉引蜀川长。\n百年棠棣联槐棘，万里江湖即庙堂。\n最恨楚词招不返，澧兰香尽夜茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47435,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈原习巡蜀","author":"邵宝","text":"廿年风采动台端，按节南荒六月寒。\n汉法共推经术吏，周廷元重惠文冠。\n路当险远行何易，时向承平谏独难。\n揽辔观风秋万里，峨眉山月马前看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47436,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次郑司马留别中朝诸老韵","author":"邵宝","text":"公去还于国有禆，清风满路出郊迟。\n乾坤直道春秋在，臣子孤忠庙社知。\n一夕笑谈真不偶，百年行止复何疑。\n二泉亭上山如画，更与诗翁作后期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47437,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄白岩先生","author":"邵宝","text":"东门祖道向西归，又见秋风动葛衣。\n三晋云山今日重，二疏风致古人稀。\n臣忠共识君为圣，今是还知昨未非。\n我病十年难下拜，太行回首思依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47438,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"虚庵陈郡公建道南书院","author":"邵宝","text":"书堂新建古城阴，巨榜高题属意深。\n吾道北南还一脉，斯人今古本同心。\n妙从活水生时得，乐向光风起处寻。\n教思无穷归有道，朱弦休叹少知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47439,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"有怀彭司马","author":"邵宝","text":"司马西归塞雾深，近来才得便风音。\n数千里外停云思，三十年馀伐木心。\n寤寐不忘天咫尺，经纶未了岁侵寻。\n凭君为吊南阳墓，正气曾闻托醉吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47440,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘之达之遂安","author":"邵宝","text":"三载平阳野有歌，重来仍溯浙江波。\n大才小试还如此，旧政新民欲柰何。\n山雨从星秋旱久，海潮应月晚寒多。\n汉廷方重循良吏，五十功名鬓未皤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47441,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"燕俞大参国昌二宜园","author":"邵宝","text":"多时相约看芙蓉，此日嘉园此客同。\n幽径小堂山左右，茂林平圃水西东。\n十年梦落江湖外，两世交通里闬中。\n新制泉巾便野服，迂疏应不笑衰翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47442,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨坐","author":"邵宝","text":"閒居不敢问丰凶，对客惟应赋大东。\n惨淡野情秋望里，凄凉岁事雨声中。\n也知北斗随天转，安得南箕应月从。\n极目江湖云万里，杖藜三叹一衰翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47443,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"两知亭","author":"邵宝","text":"我歌泉和两知音，此是涯翁赠别心。\n吾道在山还在水，斯人如玉复如金。\n高邱远海天无际，旧树新亭日有阴。\n一曲雅歌千古意，欲调宫羽入瑶琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47444,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵送王子春兼简赤城夏先生","author":"邵宝","text":"碧叶黄花送晚秋，旧游回首是今游。\n云兼山水看随路，月带风烟载满舟。\n沧海东来潮信蚤，浙江南去陆程脩。\n赤城居士如相问，尊酒论文恨莫由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47445,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送罗员外","author":"邵宝","text":"病足稀登惠麓堂，公来草木被馀光。\n方传惠泽流州郡，独爱昌言动庙廊。\n秀句已镌泉畔石，清风长满召南棠。\n司徒分领留都计，多少经纶望省郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47446,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次韵寿刘鸿胪","author":"邵宝","text":"望隆卿寺自郎曹，昼锦乡邦驻羽旄。\n六十再看尧陛荚，寻常争赋汉宫桃。\n江湖大观还龙窟，雨露新恩且凤毛。\n东阁先生题赠处，中吴回首德星高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47447,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟作赋鹿草堂于惠山精舍以无忘庐山之游述意二首 其一","author":"邵宝","text":"百年白鹿得奇观，双涧风声六月寒。\n七里每劳千里梦，九峰长作五峰看。\n两知堂近流风在，独对亭高缩地难。\n敢拟峨眉论小大，山连震泽水漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47448,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟作赋鹿草堂于惠山精舍以无忘庐山之游述意二首 其二","author":"邵宝","text":"曾向庐山赋鹿鸣，呦呦千古有馀情。\n钓游地近怜新筑，弦诵风微愧老生。\n点易不知吾发短，听歌还爱此泉清。\n偷閒尚记东曹梦，花柳前川策杖行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47449,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜宿超然堂","author":"邵宝","text":"閒爱孤云静爱僧，山中秋夜兴逾增。\n竹通深径清风足，松倚高坛霁月曾。\n露气侵阶惊蟋蟀，雨声入户避蚊蝇。\n城中望我如天上，青壁丹厓知几层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47450,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夜","author":"邵宝","text":"素娥无力破云阴，云外清虚府正深。\n今月古人空有问，青天碧海亦何心。\n灵槎渺渺应迷道，仙杵沉沉已断音。\n九月中弦秋未尽，一尊还许盍朋簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47451,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十六夜次前韵","author":"邵宝","text":"六旬炎熯两旬阴，月到中秋雨意深。\n天上不违逢满数，人间却负望明心。\n扁舟牛渚空劳梦，一曲霓裳漫赏音。\n佳节莫教容易度，白头今已不胜簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47452,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十八夜山堂见月又用韵","author":"邵宝","text":"坐看夕殿散凉阴，山霭沉沉紫渐深。\n病后逢秋犹有兴，雨馀见月已无心。\n风回近浦留帆影，籁静中峰起磬音。\n醉舞不知吾老矣，桂花还学少时簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47453,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚坐超然堂","author":"邵宝","text":"九月花开菊正黄，今年时物应秋光。\n无诗可拟登高赋，有酒还登望远堂。\n径转东南须策杖，岩朝西北合焚香。\n晚林霁色红犹浅，更待西风一夜霜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47454,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月八日足许州旧句","author":"邵宝","text":"吾衰久矣杖难支，随意青山且赋诗。\n高处登临天亦忌，清时笑傲地应疑。\n许州旧句还须续，庐岳重游不可期。\n愿保丹颜似黄菊，年年同对野人卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47455,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诸友观菊用韵","author":"邵宝","text":"一赏真偿数月忙，晚香篱落爱秋阳。\n花中亦有清时隐，林下能无野老狂。\n浅淡色如酬世务，衰迟心已谢年芳。\n岁寒更拟题诗处，和靖先生别擅场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47456,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽李封君","author":"邵宝","text":"嘉定功馀泮水波，华阳规诲复谁多。\n承休合有台衡者，节惠其如窀穸何。\n江树影连巴国字，澧兰香入楚人歌。\n司空勋业旂常在，应与先生永不磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47457,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"华生云惠我端石侑以诗用韵答之","author":"邵宝","text":"望望端州路几千，客来刚得遇陈泫。\n介心不减居山者，润色如初出水然。\n三岛东溟春渺邈，一星南极夜澄鲜。\n吾斋从此还增重，合寘西涯篆黻前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47458,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"发书于凤山有虚名为累一言因用杜诗起句","author":"邵宝","text":"才微岁晚尚虚名，一夜惊心白发生。\n贫有图书应入梦，老于庐屋未忘情。\n寒凉正值风来朔，霁爽还逢月出庚。\n便作西轩依旧室，馀灰扫尽地初平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47459,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"如山卜隐初成","author":"邵宝","text":"湖海萧条岁月迟，江东谁复问潘葵。\n易台共我双巾葛，吟社添君一杖藜。\n翼健已超尘外网，眼明还看世间棋。\n昨冬先献希龄酒，今日迎长又赋诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"幸庵司马寄节孝堂三大字至","author":"邵宝","text":"三字堂名万里来，旧堂名扁已成灰。\n故人远意真如谶，乙夜融风不是灾。\n活水源头仍里第，德星悬处自书台。\n可怜嘉树多憔悴，春雨来时又着栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"钱元抑专使来唁用前韵","author":"邵宝","text":"唁书远自四方来，独步空阶拨冷灰。\n常慕黄虞皆有政，敢言陈许不闻灾。\n病馀且曳寻诗杖，忙里还登点易台。\n残菊经霜须爱护，免从邻圃乞春栽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠赵羽人","author":"邵宝","text":"两地名山一羽衣，十年踪迹鹤同飞。\n丸中日月旋游度，坛上风雷泄化机。\n仰视三垣何朗历，傍观五岳亦依稀。\n老夫久有游仙兴，何处春风共采薇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"管大夫制云鹤之服恤灾也奉谢二首 其一","author":"邵宝","text":"中冬特制鹤袍新，来问城南失火人。\n降服正脩前古礼，解衣还荷大夫仁。\n行藏自愧名衔重，辞受能忘道义真。\n独掩寒斋感知己，县衙回首不胜春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"管大夫制云鹤之服恤灾也奉谢二首 其二","author":"邵宝","text":"锦袍新制自仁侯，病客逢灾正独愁。\n老钝尚留双石砚，清寒犹问一狐裘。\n伤心事已如云散，象德人还为鹤羞。\n笑杀陈三空忍冻，负暄真欲献宸旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"顾与成送犀带纻履受履还带","author":"邵宝","text":"箧笥逢灾一荡然，故人带履荷相怜。\n欲行我已违初志，在得人还看老年。\n台省无声犹实地，山林有梦岂通天。\n小诗甚愧琼瑶报，又向东邻乞简笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宜兴张天予吊灾志感","author":"邵宝","text":"西溪八月夜乘槎，回首江湖几岁华。\n人事每逢天未定，世途真叹海无涯。\n十年别恨还双鬓，两世交情似一家。\n此日风光君记取，微阳初复有梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送杨东川郎中葬","author":"邵宝","text":"风雨空山瘗玉时，老亲临穴不胜悲。\n死生大矣君臣重，邱垄萧然岁月迟。\n君事已成从我志，我铭未尽诔君辞。\n石门冰雪肩舆险，忍泪题诗慰两儿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"西轩子岁暮东还","author":"邵宝","text":"铁岸帆开忆去年，今年仍发冉泾船。\n閒来为客真知我，老去逢灾不怨天。\n嘉树半枯犹翠叶，清渠无恙自寒泉。\n有诗已寄儒台使，还许携儿了旧编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"天台齐节妇","author":"邵宝","text":"百年心苦保孤难，夜绩空房月影寒。\n针黹旧尝将女史，提携今乃见儒冠。\n名家宅里何时表，节妇仪刑后代看。\n我昔观风曾两浙，台山回首路漫漫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"国英秋日过我精舍","author":"邵宝","text":"淮海秋来逸兴多，因寻奇胜访行窝。\n酒凭野客浮杯劝，诗听邻僧按节歌。\n山日半衔云接树，水风初起涧生波。\n晚经第一流泉处，俯仰乾坤欲柰何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"如山生日避客山中予遇之知其意不敢重违例也惟将以诗","author":"邵宝","text":"南沙避客山中日，我适西来见泊船。\n一衲逶迤传妙句，双松寒翠倚高天。\n儒冠道重初携杖，寿酒情深但酌泉。\n只恐清欢犹未已，吟坛章什不胜编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆王山长时将渡钱塘","author":"邵宝","text":"此日君应渡浙江，海天寒月照船窗。\n久游不作他乡望，老节宁为歉岁降。\n越岸烟消分莽渚，钱塘潦尽露涛泷。\n阿符未了城南课，好趁春潮放晓艭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答冷别驾","author":"邵宝","text":"三代遗风一慨然，横渠私计更须怜。\n聊将松菊栽馀地，漫遣山林病起年。\n今日封疆皆禹服，何时雨露不尧天。\n使君多少甘棠意，都在诗筒未尽笺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"辞巡按发帑之令发书有作呈邑中长贰诸君子","author":"邵宝","text":"珍重霜台念我私，郁攸悔祸岁寒时。\n古人高谊如将见，野老愁心谅亦知。\n宋史不遗师道传，唐风犹载伐檀诗。\n尺书远托南邮吏，再拜情深在一辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春日郊人送小土牛至有作","author":"邵宝","text":"令尹分春到野人，野人庭院本容春。\n解开残冻渠仍活，扫尽寒灰屋乍新。\n白日东风初起艮，青天北斗又回寅。\n鼓腾阳气行时令，四境欢声总是真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次陈御史秉衡","author":"邵宝","text":"六载巢居是此州，诗中牖户愧绸缪。\n也知廊庙多公论，敢为江湖有远忧。\n千里忽逢桓典马，一朝如上李膺舟。\n吹嘘幸赖东风力，寸木应教重万牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"超然堂会饮聊述短句","author":"邵宝","text":"一笑超然上我堂，向来芥蒂已全忘。\n党园四皓非吾座，洛社群英亦此觞。\n江上共惊云散早，山中还爱水流长。\n岁寒更有风霜在，分付梅花作主张。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送过钲用夏方伯韵","author":"邵宝","text":"七月潮江接淼茫，送君孤棹过闽阳。\n倚天奇石高堪仰，载道清风暑不伤。\n藩省右枢还左辖，弟兄秋酌似春觞。\n月明夜夜看南斗，下有文星对远望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"迎春后令君复遣伶人来侑小酌口占","author":"邵宝","text":"迎春小队到门庭，冉里桥边草欲青。\n旧俗新风皆在志，北词南曲总成声。\n大观老去多馀景，微醉年来有别亭。\n更爱令君能俊雅，歌谣行听满山城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春日山中与国臣弟饮泉上","author":"邵宝","text":"夜来风力苦难支，晓爱晴光起海涯。\n春在土膏初动处，寒留雪冻未消时。\n梅花偏是山中早，松骨还于岭上奇。\n醉后一觞泉石畔，漫因老弟再题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人日","author":"邵宝","text":"七日逢人十日春，无端生意政津津。\n庭中碧地初回草，市上青烟半逐尘。\n风雨草堂他客梦，云山藜杖此时真。\n便须乘兴郊行去，望里龙峰画里新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日登莫氏溪山清兴楼","author":"邵宝","text":"笑惊四纪再登楼，画里青山亦白头。\n况我在朝还在野，似渠宜夏复宜秋。\n漏春梅柳原应蚤，负郭林塘本自幽。\n愿与主人同寿域，一年一话海添筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"复司马彭公书后有作","author":"邵宝","text":"万里人来不寄书，简传口语独相于。\n旧堂新构风烟后，远岭孤松雨雪初。\n两字平安身仅免，百年衰病志终虚。\n登山屐在难为着，点易台前一笋舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒玉泉先生墓","author":"邵宝","text":"四十年来吊古心，偶因胜日遂幽寻。\n天留邱垄嗟谁扫，地近廒仓幸不侵。\n百世簪缨遗谍远，五贤俎豆古祠深。\n玉泉两字还须碣，一束生刍有嗣音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"灯夕前二日观灯屏于秦国英紫薇厅","author":"邵宝","text":"人物殊流绘事同，羊皮如纸丽青红。\n桃源洞口仙应幻，天宝宫中女是戎。\n宋代梦连唐代梦，陶家风杂党家风。\n小山磊磊薇厅夜，如见春星树影中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"十四夜观冯佥宪大父戒轩公手制灯屏","author":"邵宝","text":"尊壶左右鼎当中，上有灯屏出祖翁。\n政爱千缸光映月，更闻双管韵乘风。\n一时文字饮方洽，四世姻亲讲未穷。\n忽报山人折梅至，风雩还忆二泉东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杭太仆东卿自滁阳以诗来慰次韵答之","author":"邵宝","text":"十年京国斯文谊，千里滁阳一纸书。\n老去节应惟义重，世间物总是身馀。\n还将旧篆题新树，已作新堂换旧居。\n更有高篇吟且讽，向来愁思尽消除。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄司训致政还广西","author":"邵宝","text":"七年頖水赋菁莪，回首苍梧柰远何。\n贞节平生亲力苦，武阶初命弟情多。\n寄书西去愁仍积，迎养东来乐已过。\n行不可留空怅望，九疑云尽洞庭波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠郴阳何都宪子元巡抚云南 其一","author":"邵宝","text":"昆明池水绝惊波，帝遣巡行意更多。\n汉尉几人能节制，尧封何地不包罗。\n塞逾南岳无鸿到，路比西川有鹤过。\n从此公堂须再筑，向来曾拟召棠歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":47490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]