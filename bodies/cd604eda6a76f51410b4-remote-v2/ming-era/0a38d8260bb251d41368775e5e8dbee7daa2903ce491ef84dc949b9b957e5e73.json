[{"title":"和英玉览柳山图见寄之作","author":"顾璘","text":"昔人弦诵地，古木已如兹。\n惠泽宛犹在，池台空尔为。\n棠花依涧发，薜荔绕墙垂。\n更扫苍厓石，新镌水部诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56632,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻英玉拜南京屯田主事戏寄","author":"顾璘","text":"二月除书飞帝京，屯田新注省郎名。\n亲庭乡国总在眼，把酒赋诗无限情。\n三径盘桓花历乱，九关开阖虎纵横。\n金门大隐无人识，方朔应传笑贾生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56633,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答乔衡州汝修 其一","author":"顾璘","text":"传道衡山郡，棠花满路春。\n寂寥循吏传，将老见斯人。\n玄发丹青地，孤标玉雪身。\n平生倾倒意，绝域为谁亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56634,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答乔衡州汝修 其二","author":"顾璘","text":"鲍叔元知我，陶潜久悟非。\n身经畏途老，梦想故园归。\n失路沾青眼，馀生乞采衣。\n相过知不远，长望岳云飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56635,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄内并示二儿 其一","author":"顾璘","text":"满堂风雨烛花残，独客思归坐夜寒。\n遥想故园当此夕，画楼明月影团团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56636,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄内并示二儿 其二","author":"顾璘","text":"小阁书声夜漏稀，东归潘岳奉慈闱。\n湘南山水虽云美，不及桥阴旧钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56637,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和英玉闻秋佳亭新移怅然作兼简王礼部钦佩","author":"顾璘","text":"秋佳亭子临秋水，伐木新移向近陂。\n小径有时迷客入，长杨无数绕檐垂。\n即看野鹊春来喜，莫怪群鸥晚下疑。\n寄语东邻王礼部，好携樽酒数追随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56638,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答李川甫二首 其一","author":"顾璘","text":"昔予牧大梁，庠序多俊民。\n峨冠列广座，雅论何彬彬。\n思慕信陵义，密尔申交亲。\n输心誓白日，永怀越千春。\n惊风西北起，奄忽暗流尘。\n巾车一何迫，泣别长河滨。\n生死忽乖隔，泪下沾衣绅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56639,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"答李川甫二首 其二","author":"顾璘","text":"南迁度湘渚，湘渚阻且深。\n蛟鱼凌波起，骇浪如高岑。\n岩峦仄无地，草木多毒淫。\n三岁栖绝域，长恐遂幽沈。\n鸣雁自北来，衔书置庭阴。\n开椷览流藻，乃是潇湘吟。\n薄俗昧交义，贵贱异中襟。\n与子绝会面，庶以明远心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56640,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"杨仪宾东皋","author":"顾璘","text":"路转漓江曲，林间逸士家。\n避人成独往，隐几坐无哗。\n舞鹤穿行径，游鱼傍钓车。\n时闻萧史辈，驻此共餐霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56641,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上送马锦衣按事回 其一","author":"顾璘","text":"贞士不可见，凄凉饮冰言。\n徒惭金吾使，万里驰輶轩。\n马君伏波之子孙，西观桐柱迹犹存。\n江上相逢多意气，高歌一曲下湘沅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56642,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上送马锦衣按事回 其二","author":"顾璘","text":"雅歌皇华诗，送行倾玉卮。\n薰风吹船下湘渚，回首谁怜斑竹枝。\n君来安坐人莫窥，判如南山何可移。\n汉庭贤士虽无数，四海偏誇张释之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56643,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初闻望之量移汶上","author":"顾璘","text":"逐客承优诏，宁亲得近居。\n主恩天地大，臣节死生馀。\n鲁邑鸡初割，长沙鵩已袪。\n馀欢兼旧侣，应免葬江鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56644,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上迎望之逆风舟不得进","author":"顾璘","text":"两年望君君不来，渴心捲水生黄埃。\n昨闻津吏报君至，秉烛传更夜无寐。\n晓雨移樽江上迎，南风吹船船倒行。\n五里停篙十里泊，侧听鼓角前湾声。\n君乘画舫荡双楫，涧壑下泻滩流平。\n眼中迟速亦复尔，何况出处关人生。\n万事未须问，会面安可轻。\n与君月出共舟去，山水湘南无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56645,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上感秋呈望之","author":"顾璘","text":"昨日梧叶落，今日蘋花开。\n秋光向人不相贷，客子感物令心哀。\n三湘水阔高云凝，群峰雨馀游气澄。\n岂无清欢待尔至，转恐欲别愁难胜。\n我留绝域更谁依，君望家山只欲归。\n若到襄阳骑马处，闺人应理旧斑衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56646,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别望之兼寄诸相知十首 其一","author":"顾璘","text":"五岭炎蒸地，三年共谪居。\n送君南鲁去，予意独何如。\n大舶依流水，归心指故庐。\n江门今夜月，相对暂踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56647,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别望之兼寄诸相知十首 其二","author":"顾璘","text":"相逢殊不易，相别且从容。\n落日留羁鸟，惊雷起卧龙。\n独吟江路永，多难故情浓。\n回首伤心地，无劳望桂峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56648,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别望之兼寄诸相知十首 其三","author":"顾璘","text":"白发倚门久，清江催棹频。\n荣枯知圣泽，瘴疠脱危津。\n乌鸟心偏苦，骅骝气有神。\n风烟千万里，愁杀未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56649,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别望之兼寄诸相知十首 其四","author":"顾璘","text":"何处瞻飞舄，秋风汶水波。\n黄尘清市井，明月照弦歌。\n宓子非凡吏，宣尼有四科。\n平生霄汉意，摧折未蹉跎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56650,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别望之兼寄诸相知十首 其五","author":"顾璘","text":"直道台端谪，清风岭外还。\n诸生依日月，雅兴发江山。\n痛饮神逾炯，哀歌鬓已斑。\n看君置心迹，浑在古人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56651,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别望之兼寄诸相知十首 其六","author":"顾璘","text":"昔别空同子，封书发豫章。\n君今还汝水，渠已客襄阳。\n苦别交亲老，时名岁月长。\n斯人常坎坷，天意竟茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56652,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别望之兼寄诸相知十首 其七","author":"顾璘","text":"不见边丞久，于今更四年。\n衡湘悲雁绝，台省贺莺迁。\n屡梦攀嵇叔，无诗寄郑虔。\n经过问消息，漂泊已华颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56653,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别望之兼寄诸相知十首 其八","author":"顾璘","text":"旧游纷雨散，京国祗崔何。\n东观摛辞贵，南天洒泪多。\n云深愁问信，月好忆联珂。\n赠别留长句，时时发醉歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56654,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别望之兼寄诸相知十首 其九","author":"顾璘","text":"汶阳临大道，喜近赵东曹。\n窜地传书数，他乡念我劳。\n名高连泰岳，心远折江涛。\n拟共观周礼，无因接誉髦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56655,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠别望之兼寄诸相知十首 其十","author":"顾璘","text":"吾生堪太息，世路易浮沉。\n物色悲游子，风波损壮心。\n同人桂林少，积水洞庭深。\n渺渺伤神极，还愁老欲侵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56656,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日雨中与客饮朱别驾宅","author":"顾璘","text":"閒馆投壶白昼长，桤林鸣雨送飞觞。\n千山湿翠云垂地，万壑平流水映堂。\n尘世几回逢酩酊，瘴乡三伏遂清凉。\n休辞枥马喧东道，爱对庭中短烛光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56657,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠靖江王孙 其一","author":"顾璘","text":"大雅诗书志，高情洞壑居。\n风流宜鹤氅，云气绕鸾舆。\n摛辞过梁宋，召客得应徐。\n投簪吾未老，犹可曳长裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56658,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠靖江王孙 其二","author":"顾璘","text":"紫阁投朱绂，青山卧白云。\n凤笙流秘曲，鸿宝枕灵文。\n近得临邛客，飘然思不群。\n时传古词赋，为我洗尘氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56659,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"快哉行","author":"顾璘","text":"东方日出晓衙集，壮士冲关突然入。\n背负猛虎手强弩，短镞棱棱血犹湿。\n斑文白额委中庭，空闪金眸洒寒泣。\n我嘉壮士饮之酒，拔剑刲羊发仍立。\n观者如墙方笑呼，杀声落日喧城隅。\n众豪复提一虎至，洞胸直贯长蛇殳。\n垂头狼藉类黄犬，猛物失势堪嗟吁。\n快哉二害同日尽，何啻并殛凶饕徒。\n田家儿女开户寝，馀惠况及犬与猪。\n可怜尔虎何太愚，鸷害自古遭神诛。\n尔类好杀终亡躯，胡不早走深岩居。\n转易猛性为驺虞，为民献瑞登王都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56660,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月","author":"顾璘","text":"秋月光如洗，高台夜转寒。\n江流铺雪去，松壁影龙蟠。\n玉兔栖难稳，苍猿泪欲乾。\n楚天多雾雨，坐对判更阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56661,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题张东海草书后","author":"顾璘","text":"绝代风流远，名家草圣传。\n龙蛇馀万纸，鸾凤渺孤骞。\n俊拔归张旭，萧条老郑虔。\n天南看旧帖，三复叹前贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56662,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"挽李将军","author":"顾璘","text":"早穷黄石略，远佐伏波军。\n入幕推英选，横戈策壮勋。\n驱驰仍白首，特达且青云。\n逝水悲雄剑，长星落古坟。\n范增心未已，李广命何屯。\n阀阅遗骠骑，文章起凤群。\n将门收藻色，史阁播清芬。\n偃蹇蓬蒿子，那能百代闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56663,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄上司马白岩乔公","author":"顾璘","text":"北斗枢衡控上都，南台司马握兵符。\n河山地正乾坤位，雨露春融造化垆。\n分陕雅推周有道，戍江应笑晋非图。\n朝廷白发忧相倚，寰海苍生望已苏。\n幕府吁谟趋老将，锦堂觞咏列文儒。\n心当大任何曾动，身致升平得自娱。\n谢墅赌棋花正好，秦淮吹笛月同孤。\n王风伫听歌麟趾，公子振振见玉颅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56664,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"将赴灌阳","author":"顾璘","text":"累岁倦行役，兹晨仍灌川。\n路危缠岭脊，草盛隐人肩。\n逐客穷愁地，荒城大有年。\n不才宽罪谴，何以报皇天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56665,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"入金盆山访唐孝子 其一","author":"顾璘","text":"旧闻刲股事，今见结庐情。\n笃行关风俗，残躯效死生。\n秋原双泪苦，春草寸心倾。\n独夜悲风切，偏闻宰树声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56666,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"入金盆山访唐孝子 其二","author":"顾璘","text":"秋日观风地，青山五马庄。\n荒庐依大冢，乌鸟泣衰杨。\n孝子人伦重，高贤世绪昌。\n磨崖传故事，林壑借馀光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56667,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"至灌阳平赋作","author":"顾璘","text":"我闻黄虞民，罔识官师名。\n老翁被素发，壤歌如孩婴。\n季世广法令，民心始忡?。\n马牛急租税，鸡犬纷斗争。\n兹邑苦穷僻，曾巘纾荒城。\n谓云华胥国，颇遂桃源耕。\n咨诹逮幽隐，转痛闾阎情。\n山深吏治猛，里胥日纵横。\n执热不以濯，煎膏难及明。\n府帖增新役，赋籍何由平。\n水枯网罟乱，孰使鱼不惊。\n投笔坐长叹，泪下沾緌缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56668,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋日学宫试诸生","author":"顾璘","text":"宴坐中秋日，云晴灌水阳。\n玉麟横郭见，文笔映波长。\n隐几饶幽胜，登堂总俊良。\n英灵占萃聚，神采爱舒张。\n颇讶遗珠远，谁云古道荒。\n多闻沾柳教，妙悟近周乡。\n僻壤缘人胜，儒绅贵志强。\n嗟予牵世网，垂老觅亡羊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56669,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"学舍见紫薇花","author":"顾璘","text":"学宫古苔满阴壁，一株紫薇当户新。\n矜持幽意故远俗，点缀秋光时近人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56670,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋县署值雨 其一","author":"顾璘","text":"此夕中秋月，他乡两度圆。\n孤云生夜翳，万象失秋妍。\n雨气饶侵客，风期又隔年。\n谁能揽明镜，烂熳挂青天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56671,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋县署值雨 其二","author":"顾璘","text":"独客佳辰思，空山积雨愁。\n纵能斟绿蚁，何处望琼楼。\n岩桂萧萧落，江云冉冉浮。\n愿馀吴地影，聊破老亲忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56672,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"华山对雨寄陈鲁南索画","author":"顾璘","text":"众壑行云递有无，灌潭秋影照人孤。\n题诗寄向王摩诘，乞写华山对雨图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56673,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"灌江见夫容因忆王礼部钦佩许予作此赋未至聊寄一首","author":"顾璘","text":"两度湘江见尔开，水清沙远转悠哉。\n池头旧日西风面，正对东邻作赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56674,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻灌人云有柳子厚遗迹因策马往寻历大源塘入仙源洞不得其处而返","author":"顾璘","text":"柳侯昔放逐，颇好山水事。\n观其著文词，动以喻来世。\n逮今岁月改，陵谷莽迁异。\n我行徂灌川，闻有招隐地。\n怀贤慰遐想，吊古积幽思。\n尘馆休吏衙，秋原散游骑。\n度岭疲登顿，涉溪苦沾渍。\n空潭激哀流，古木堕馀翠。\n穷搜尽阳景，屡剔断碑字。\n岂无会心观，往往悖图志。\n兴尽且须返，聊以展同致。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56675,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寻山","author":"顾璘","text":"曲坂凌虚度七盘，仙源何处问三韩。\n溪门古木苍云湿，涧道疏花白雪寒。\n短发漫冲霜霰老，青山聊拨簿书看。\n须知野兴秋难禁，莫怪岩阴日易残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56676,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"华山舜祠","author":"顾璘","text":"隐隐苍梧映郭门，滔滔江水抱山根。\n群峰独捧重华庙，大地谁言五岳尊。\n云暗九疑迷葬地，月明孤竹见啼痕。\n长将涧藻修寅祀，愿就琴薰仰德温。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56677,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访仙源洞得道人蒋馨故栖石题","author":"顾璘","text":"水曲桃花暗，灵岩信有仙。\n虫书留古洞，鹤驾去何年。\n白犬眠金灶，苍龙饮玉泉。\n愧非嵇叔夜，来此竟空旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56678,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"小泛得黄楼诸山之胜","author":"顾璘","text":"不奈城中役，重寻水上游。\n秋光俱白舫，山翠忽黄楼。\n竹覆溪门净，云藏石洞幽。\n诛茅饶野意，留语报沙鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56679,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游通真岩与数子商作思柳亭","author":"顾璘","text":"荡舟缘西溪，风物始虚爽。\n忽得通真岩，众喜得奇赏。\n石壁倒千仞，洪涛漱中广。\n通天贯灵窍，云气恣来往。\n玉髓堕阴滴，莲花抱烟长。\n居然神仙窟，所愧系尘鞅。\n缅怀柳愚溪，千载寄幽想。\n其人虽已没，精华尚星朗。\n愿言作新亭，延此烟月党。\n今古两悠悠，江波日东响。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56680,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出灌江峡","author":"顾璘","text":"群山高束灌江流，雪浪清秋洒客舟。\n古木倒垂云上下，乱滩交泻石沈浮。\n猖狂阮籍穷途哭，浩荡王阳度坂愁。\n料乏云台酬马革，愿携霜鬓老狐邱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56681,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宿白水渡","author":"顾璘","text":"积水吞寒濑，孤舟宿暮烟。\n邀人壶蚁泛，作赋烛花悬。\n发变风波境，神惊四十年。\n壮心空感激，夜起拂龙泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56682,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"白露","author":"顾璘","text":"白露凄凄，原草具腓。\n日月于迈，载授我衣。\n北山有堂，江注其麓。\n薄言出游，以写心曲。\n山木斓斑，江云差池。\n乐以旨酒，委蛇委蛇。\n尔樵尔渔，来往无怒。\n尔农获斯，黍稷如岵。\n戋戋守臣，实蹈百愆。\n何以逭之，曰维丰年。\n丰年伊何，维民之德。\n民之颂之，天子之泽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56683,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄叶澄","author":"顾璘","text":"高士多异标，骅骝隐奇骨。\n拙匠昧玄理，纷纷写毛发。\n曹霸画马权奇高，裴公之面飘三毛。\n始知能事贵得意，耻与形相论纤毫。\n燕山叶子心目灵，少年刻意工丹青。\n闭门解衣日盘礴，兴起落笔通幽冥。\n我谒南曹大司马，五岳峥嵘走堂下。\n烟霞㸌目不敢前，熟视乃知是君写。\n一谪潇湘今几秋，思君不见增烦忧。\n绝怜山水最奇处，苦乏妙笔移沧洲。\n覆釜峰，湘江水，世传蓬壶无乃是。\n我有长绡寄向君，烦君写入茅庐里，欲访形容问吾子。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56684,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"磐石秋望","author":"顾璘","text":"信美江山映郭西，清秋羁客思凄凄。\n黑波跳雨蛟龙斗，苍峡摧云虎豹啼。\n万里辞家饶白发，一邱归卧有黄齑。\n蛮烟毒雾伤心地，马援何因到五溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56685,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬王钦佩见怀之作","author":"顾璘","text":"长忆西邻海雪庄，主人从宦日徜徉。\n穿花跨马趋东省，斸笋烹鱼上北堂。\n静室幽兰无限意，小山丛桂几回芳。\n天涯逐客归期远，岁暮怀君枉断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56686,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬陈鲁南见寄青溪看月之作","author":"顾璘","text":"青溪明月引长唫，湘浦寒云滞客心。\n归思不堪枫叶尽，故情俱向楚江深。\n荒城寂历山当户，旧叶凋零鹊绕林。\n身世与君同未达，却怜霜鬓映疏襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56687,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬刘元瑞黄州见寄之作","author":"顾璘","text":"秋风旌节过黄州，杪岁椷书到岭陬。\n交谊死生归气槩，词华今古接风流。\n江翻荆口天齐落，山转滇南地半浮。\n闻道柏台多暇日，况逢陶谢好同游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56688,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉次司马泾川张公打鱼短歌","author":"顾璘","text":"渔舟晓集澄江湾，设栅布网如重关。\n两曹分张鼓齐发，风雷簸荡波涛间。\n大鱼踉跄浮额鼻，挺叉入水喧群蛮。\n小鱼往往脱疏目，获少不怪阳侯悭。\n割鲜矠藁总民力，地利在余焉敢匿。\n载登鼎俎享群公，退食庶几无赧色。\n羡馀颇餍仆隶腹，细琐亦任渔人得。\n堪叹结绳遗祸阶，物命公然恣人食。\n南台司马初辞官，香粳细脍且加餐。\n倘闻涸辙遗枯鲋，更借西江万顷宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56689,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"对雪","author":"顾璘","text":"山郭阴沈雪片稠，冻云重叠傍城楼。\n风回乱木飞花合，夜静寒窗素月流。\n北望自谁旋气轴，南迁今始问冬裘。\n欲留蚁酒临春赏，正恐鹑衣彻夜愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56690,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谢平乐张太守惠莲花酒","author":"顾璘","text":"暮冬雪寒风飘飘，湘城冻酒甜如蜜。\n倾杯欲饮复推去，空对江山坐终日。\n漓江太守神仙人，双罂远致莲花春。\n开轩晓起试三爵，顿洗百斛胸中尘。\n高歌梁甫曲，脱却渊明巾。\n眼前万事底须问，且从烂醉陶吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56691,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"连陪诸公柳山春游 其一","author":"顾璘","text":"湘州城北古堂幽，十日春晴两度游。\n山畔数亭俱可醉，林间孤涧亦销忧。\n岩峦气色迎车发，草树风光绕郭浮。\n况与群公陪胜践，岂输山简习池头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":56692,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]