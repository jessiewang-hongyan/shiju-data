[{"title":"同黎惟敬酌陈玉叔得渠字","author":"欧大任","text":"前旌何日向淮徐，斗酒聊停使者车。\n饷事宁劳论海上，史才今已见河渠。\n几人旧赐金茎露，十载名山玉笈书。\n秋色蓟门怜去住，那能相对不踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7049,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈参知玉叔督漕事竣还淮上","author":"欧大任","text":"名高谕蜀最能文，尺一漕河借使君。\n飞渡万艘淮海粟，转输千垒塞门军。\n鹿皮荐币谁曾议，龙首疏渠久已闻。\n少府分筹尊计相，酂侯今冠汉家勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7050,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送钱侍御汝瞻按山东","author":"欧大任","text":"玉节霜飞枫叶丹，东方千骑出长安。\n岳分梁父封犹在，海入琅琊气更寒。\n问俗客能章甫颂，爰书人识惠文冠。\n齐州十二君凭轼，何限嵎夷向日看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕怀徐子与王敬美","author":"欧大任","text":"诏赐金钱客尚留，故人多向豫章游。\n城头片月凉初起，河上双星黯自愁。\n鹤控东盘缑岭夕，鸟来西望汉宫秋。\n武昌不浅胡床兴，更有湓江百尺楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答王太史绍传过寺馆小饮之作","author":"欧大任","text":"餐钱堪自老东胶，何点清斋食不肴。\n贝简夜灯僧共读，柴门秋叶客来敲。\n束书归计将招隐，执戟何心更解嘲。\n乡里永冠还此会，几人京洛念穷交。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同郭方伯黎秘书范鸿胪李明府集广济寺禅室得中字","author":"欧大任","text":"诸天振铎破溟濛，词赋谁如左辖雄。\n雨后昙花催暝色，坐来祇树起秋风。\n簪裾并合清尊外，河岳双扶片语中。\n握手忽看滇僰近，莫令岐路易西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同华鸿胪访胡学宪于慈仁寺登毗卢阁","author":"欧大任","text":"三年两见客车来，貂敝咸阳我未回。\n载酒晴光连睥睨，出城秋色郁崔嵬。\n上方台殿诸天远，大漠风烟万里开。\n作赋登高吾岂敢，逢时真羡大夫才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"蒋少翼从李临淮还自渔阳即游云中索赠赋此","author":"欧大任","text":"一骑西游剑作装，谁能雌伏论行藏。\n歌中雁落滹沱月，战后雕盘瀚海霜。\n横槊自堪陪上将，请缨还欲系名王。\n陆沉笑我金门下，结驷何年侠少场。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈士鹄入都先枉诗寄用韵奉答","author":"欧大任","text":"十载相逢已老夫，鹴裘犹问酒家胡。\n客来禁苑青云起，秋入关门紫气孤。\n海上何年成大药，天涯归思满平芜。\n君看倦似游梁后，只道长杨在汉都。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄致政周琼州","author":"欧大任","text":"一从初服谢纷华，吾道荆南几大家。\n海上谁能忘露冕，岭头应自忆梅花。\n当门令子将传笏，讲席诸生半赐麻。\n方朔金闺寻旧约，祝融何日共餐霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘子继还楚中","author":"欧大任","text":"名姓词场已策勋，锦囊归著五游文。\n经奇自许刘公干，笔札谁如谷子云。\n中散风流龙性在，平陵池馆雁行分。\n从来楚泽多芳草，何处瑶华一寄君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送刘侍御出按滇中","author":"欧大任","text":"昆明使者出西台，六传风烟此日开。\n绣斧汉庭尊直指，琳琅荆楚重时才。\n武侯营向盘江去，博望槎浮洱海来。\n自昔殊方劳讽谕，皂囊封事待君回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郭方伯赴贵竹","author":"欧大任","text":"籣矢前驱候玉珂，西南堑垒自星罗。\n阁鸦箐过金鸡驿，盘瓠溪通赤虺河。\n周日职方先岳牧，汉家乐府奏夷歌。\n履声蚤入承明谒，已听羔羊咏五紽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卢沟桥送汪子建还扬州","author":"欧大任","text":"十年颜鬓慰蹉跎，其奈关山怨别何。\n月下悲笳过督亢，霜前流水乱滹沱。\n雁飞海上乡心远，叶落淮南客路多。\n立马斯须怜去住，箜篌弹罢不堪歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周选部入都闻吴山人卧病金陵念仆极至辄报此章","author":"欧大任","text":"伏枕他乡几月瘳，秣陵萧瑟已深秋。\n应知茗艼差为适，何处逍遥不可游。\n缑岭客将骖白鹤，函关人自拜青牛。\n书来莫问华阳馆，乞取丹砂老葛侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邵侍御出按江西过家为尊人太守公八十寿","author":"欧大任","text":"使星新傍寿星辉，建节西行定省归。\n鸠杖在门垂白发，豸冠行酒映绯衣。\n邵平辞爵三秦久，石相名家两汉稀。\n他日九重思旧德，镜湖将赐钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈士鹄守腾越州","author":"欧大任","text":"符分铜虎出金闺，行为天王牧远黎。\n木阁久通华马外，麓川犹在夜郎西。\n霜前塞雁冬初到，竹下江猿昼亦啼。\n君倘召还吾已去，铁桥双杖几时携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杪秋刘子大宅同曾司马周光禄黎秘书诸公赏菊得花字","author":"欧大任","text":"旧游何但似抟沙，执戟怜予鬓已华。\n霜后谁移三径色，尊前犹醉五陵家。\n高城夕漏偏留客，锦席秋灯半照花。\n京洛群公簪弁地，明年应自忆天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送孙伯远还吴兴","author":"欧大任","text":"燕市悲歌久已无，朅来得我共酣呼。\n少年颇解骄前辈，名士谁知隐博徒。\n苕霅独游堪自远，乌程足饮更何酤。\n他时倘杖东南策，为访朱明一病夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周选部国雍张光禄元易见过得人字","author":"欧大任","text":"秋尽衡门黄叶新，频来二子转相亲。\n名从海内推词伯，游岂燕中傍酒人。\n苜蓿堪娱吾且老，茅柴能饮未辞贫。\n独怜此会今稀少，南北风烟易怆神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"刘左史相崇府二十二年矣因其子登州君奉寄","author":"欧大任","text":"高陵大老汝南翁，白发人推长者风。\n经术已如韩太傅，儒林还表鲁申公。\n五更礼自尊河洛，十赉恩将赐华嵩。\n家学今看传奕世，三鳣谁敢并关中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"伍舍人子谦朱计部子得见过得来字","author":"欧大任","text":"载酒吾惭问字来，秋风萧瑟荜门开。\n一毡木榻寒犹坐，双骑银鞍晚未回。\n炊桂颇同秦客久，纫兰谁似楚人才。\n因君细访衡湘路，兴在朱陵百尺台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周国雍索题西慕小隐图","author":"欧大任","text":"万树啼乌几曲湍，周颙隐处未摧残。\n山中气结纯钩紫，海上砂留旧灶丹。\n萝幌月来云住少，松门风急瀑飞寒。\n名高南越先贤传，玉峡西风更考槃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陆都事请告还上海","author":"欧大任","text":"台郎一疏去何如，行向江乡问隐居。\n泖上暂移张翰舫，鄮中曾睹陆云书。\n园人岁课频收橘，家老秋蒸且荐鱼。\n尚有玄成经世业，可能无意上公车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬寄代王孙若讷","author":"欧大任","text":"玉牒名高代小侯，尺书遥问鹔鹴裘。\n日摇花影开朱邸，河转波声满白楼。\n积雪空歌梁苑夕，浮云不断蓟门秋。\n汾阴只道扬雄赋，七略何人更姓刘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答唐王孙子厚见寄","author":"欧大任","text":"郁葱佳气满平台，苑邓河山划已开。\n五色鹓曾丹穴出，九花虬自内家来。\n心惟求试通亲表，代有思玄作赋才。\n莫忘燕州八行字，归人犹待雁飞回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬宋山人应元自新河以燕石集诗禅琐谈见寄","author":"欧大任","text":"名山杖笠未由同，片札能飞碣石宫。\n赵地客卿双白璧，江陵茅屋几秋风。\n书成颇忆青毡客，榻坐谁如皂帽翁。\n短鬓萧骚难会面，扁舟吾在海门东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈道襄转江西大参开府岭北","author":"欧大任","text":"十年骢马豫章城，斗下曾看剑气明。\n隃岭路当新建节，度辽人识旧谈兵。\n越裳翡翠春将贡，沧海楼船浪已平。\n客忆丹砂君莫笑，葛洪今向庾关行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"都门送梁彦国补赣州司理","author":"欧大任","text":"别尔长安乌乱啼，何如廷尉府中栖。\n到时狱市开春酒，战后军城阅水犀。\n客梦直过南斗下，使星今在大江西。\n岭头颇近梅花早，莫学扬州法署题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送左司马郢中曾公总宪留台二首 其一","author":"欧大任","text":"三楚名家有珥貂，上卿谁似策勋遥。\n七擒孟获曾宣捷，五部单于已入朝。\n执秩今行周郏鄏，先声宁数汉嫖姚。\n主恩咫尺台垣近，鸾鹤回翔在赤霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送左司马郢中曾公总宪留台二首 其二","author":"欧大任","text":"朝辞画省向鸣銮，白雪楼前一问安。\n幕府久传司马法，钟陵高照惠文冠。\n万年王气金茎直，六代江声玉树寒。\n我寄离心征雁去，秦淮东下是长干。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕立春朝回纪事时辽东大捷","author":"欧大任","text":"鸣佩从容出禁闱，六花犹满侍臣衣。\n腊前彩胜沾春色，云里青旂照曙辉。\n太史秦中迎气入，将军辽左捷书飞。\n甄家博士空相笑，为恋清时尚未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同刘观察李明府余太史访黎秘书于晋阳庵慈上人方丈得师字","author":"欧大任","text":"天寒倦鸟隐禅枝，客宿郊扉送腊时。\n山似竺乾残雪积，松高雍畤白云垂。\n移庵老学庞居士，嗜酒醒逢远法师。\n有约还乡行作伴，青春吾敢滞归期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"正月二日伍舍人朱计部谢侍御司考功见过张武库袁民部同集得东字","author":"欧大任","text":"京洛翩翩有数公，何期冠盖访墙东。\n借居开径曾非隐，登阁看山暂可同。\n尚把椒花供献岁，更移梅萼试春风。\n曲高未敢轻相和，郢客从来尽国工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕伍子谦朱子得谢叔蒙携酒见过得招字","author":"欧大任","text":"风急铜驼雪未消，凤城东北路偏遥。\n一龛供佛谁名社，几客闻灯不待招。\n系马阶前犹阒寂，行厨竹里半萧条。\n升平幸是金钱会，惟有狂歌答圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送杨肖韩补令盐城","author":"欧大任","text":"千家鱼稻待鸣弦，暂借神君此地偏。\n堤上楼高通海气，城头帆仄散湖烟。\n玄夷书似衡山日，白马牲犹瓠子年。\n闻道河渠功不细，皂囊归奏圣明前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送沈侍御转佥宪赴蜀","author":"欧大任","text":"西跃铜街马是骢，玺书擎出建章宫。\n巴江雪涨扬帆碧，秦栈花开引旆红。\n行部豸冠严执法，巡边龙节惯临戎。\n都亭一望频回首，从此双钩气更雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广渠门再别黎惟敬","author":"欧大任","text":"东都祖帐拥行辀，曾是三朝侍冕旒。\n赤管自堪留姓字，青藜谁得并风流。\n终期沧海同舟去，犹忆长安并马游。\n携手飞云成二老，万峰梅萼五城秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"思归","author":"欧大任","text":"通籍金闺已四年，遗经仅得守师传。\n息心渐已焚残草，学道何妨老一毡。\n客醉每参禅讲坐，僧贫犹乞笔耕钱。\n思归欲借缑山鹤，骑入罗浮七洞天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题冯元用先处士云洞图","author":"欧大任","text":"湾上深居傍翠峦，无心出岫学龙蟠。\n参差勾漏岩头过，缥缈朱明洞口看。\n石削綵分千树色，瀑悬軿度万峰寒。\n庞公奕世冠簪贵，沛作甘霖自不难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送茅平仲还京口因怀郭次甫陆无从四首 其一","author":"欧大任","text":"何年五月忽飞霜，君洒燕山泪数行。\n去问戴公山下客，千秋堪自识行藏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送茅平仲还京口因怀郭次甫陆无从四首 其二","author":"欧大任","text":"蓟北归人正及秋，漕河霜后一孤舟。\n尔家最与三山近，日出金银阙下游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送茅平仲还京口因怀郭次甫陆无从四首 其三","author":"欧大任","text":"焦君祠小客星孤，江上浮云肯驻无。\n不待山人招隐赋，秋来张翰已思鲈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送茅平仲还京口因怀郭次甫陆无从四首 其四","author":"欧大任","text":"江连杨子是芜城，几向西津渡口行。\n客有陆机如问讯，道余萧索蓟门情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋先一日同黄君庆顾叔震周之祯游满井过观音院逢珍公","author":"欧大任","text":"圣水庵前下马游，山亭一叶已先秋。\n已公大是谈禅客，不为茶瓜半日留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谭别驾赴永州二首 其一","author":"欧大任","text":"秋雨湘船斑竹枝，使君行乐采江篱。\n书来好寄衡阳雁，莫遣青山九处疑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谭别驾赴永州二首 其二","author":"欧大任","text":"舂陵一望更零陵，鼓柁三湘兴可乘。\n汉吏儒冠犹楚郡，津人不用报临蒸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送万治赴长芦 其一","author":"欧大任","text":"一官盐策借才贤，斥卤黄花索酒钱。\n厅事垂帘清似水，不妨闲著海王篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送万治赴长芦 其二","author":"欧大任","text":"芦台千里最宜秋，宾客南皮况雅游。\n岂但鱼盐容傲吏，宦情何处不沧洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊祀歌十首 其一","author":"欧大任","text":"禋祀初成玉册文，秉圭今见圣明君。\n天门直望郊丘路，凤辇龙旂护五云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊祀歌十首 其二","author":"欧大任","text":"天行雷动肃鸣銮，万骑骖驔曙不寒。\n白日新开蓬苑色，汉家雍畤在长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊祀歌十首 其三","author":"欧大任","text":"星屯卫士徼周庐，御幄时时诏大胥。\n天地一阳恭默待，玉箱惟载阁臣书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊祀歌十首 其四","author":"欧大任","text":"祠官鹄立泰坛扉，双引交龙绣衮衣。\n苍璧包茅供盛事，燎烟高傍綵霞飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊祀歌十首 其五","author":"欧大任","text":"金支绛节绕明庭，奏格高玄礼万灵。\n上帝居歆皇乐豫，云门鼗管满青冥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊祀歌十首 其六","author":"欧大任","text":"星辰海岳列坛尊，柴望于时礼数繁。\n祝史告成多奏嘏，高皇十叶是文孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊祀歌十首 其七","author":"欧大任","text":"驰道烟开松柏深，霓旌队里凤鸾音。\n高台不用瞻流火，已协钧天九奏心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊祀歌十首 其八","author":"欧大任","text":"鼓角中天大辂还，玉龙衔烛照西山。\n词臣纵有河东赋，不是汾阴入汉关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊祀歌十首 其九","author":"欧大任","text":"皇极殿前初建旗，鹓班胪列及蕃夷。\n庆成歌颂归东观，半似周人湛露诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊祀歌十首 其十","author":"欧大任","text":"玉检金泥表岱宗，射牛何事议登封。\n精禋独正南郊礼，万岁君王御六龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪中惺上人过访","author":"欧大任","text":"醒向大梦扣柴关，曾礼文殊代郡还。\n雪满蓟门同拥衲，清凉何似五台山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送恩公游五台 其一","author":"欧大任","text":"七宝树前金阁开，三珠泉畔木瓢来。\n岂缘热恼人间世，一锡西飞到五台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送恩公游五台 其二","author":"欧大任","text":"繁峙千峰高入云，炎天积雪太行分。\n尔今结夏山中去，莫待秋风一雁闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曹大行子韶奉使入秦因还武冈四首 其一","author":"欧大任","text":"燕京裘马少年场，玉节西驰柳万行。\n腰下并刀持赠汝，五陵秋色满咸阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曹大行子韶奉使入秦因还武冈四首 其二","author":"欧大任","text":"三峰削出百盘斜，天井窗中玉女家。\n我寄归心西岳上，看君仙掌弄莲花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曹大行子韶奉使入秦因还武冈四首 其三","author":"欧大任","text":"南行商洛略郧西，把酒家园一杖藜。\n七十峰高白云里，泠泠脩竹鹧鸪啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曹大行子韶奉使入秦因还武冈四首 其四","author":"欧大任","text":"都梁流水下三湘，路出荆南万里长。\n汉日汲生称使者，好裁封事答君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答王中丞元美郧阳见寄三首 其一","author":"欧大任","text":"征南开府最能文，春雁归时一札闻。\n纵使郢中歌是雪，风流谁更似王君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]