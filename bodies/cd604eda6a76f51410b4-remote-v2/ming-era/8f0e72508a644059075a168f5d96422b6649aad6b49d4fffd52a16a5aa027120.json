nce":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28923,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答伍国开雨中见怀之作 其三","author":"李孙宸","text":"小楼依密树，烟雾昼冥迷。\n雨叶晴时落，风枝梦里凄。\n无由恣欢赏，聊以托幽栖。\n乘兴何言远，门前有剡溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28924,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步杪何氏听潮阁赏梅同伍国开诸子分赋 其一","author":"李孙宸","text":"造园不相识，吾爱子猷狂。\n况是高人宅，招携意倍长。\n当门乱竹立，亚水几花香。\n何□罗浮梦，居然见澹妆。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28925,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"步杪何氏听潮阁赏梅同伍国开诸子分赋 其二","author":"李孙宸","text":"梅花东阁赋，仙侣武陵招。\n索笑情何剧，寻源兴不遥。\n歌喉清并倚，酒户醉相骄。\n未觉年芳晚，风流事事饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28926,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春独坐漫成","author":"李孙宸","text":"非缘耽寂寞，多病称萧閒。\n春换枝头色，年催愁里颜。\n好眠身习懒，异俗户常关。\n赖有嘤嘤鸟，长林日往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28927,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送仁伯弟西游觐省","author":"李孙宸","text":"忽动白云思，当春理彩衣。\n风烟一弟隔，鸿雁异行飞。\n问礼趋庭远，宁亲作吏微。\n江蓠芳可撷，莫忘尺书归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28928,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋伍国开同诸弟侄过集建霞楼忆先二年中秋伍俱有约不果至","author":"李孙宸","text":"有约曾三度，良宵此会难。\n月中倾小酒，物外得清欢。\n轮走云容递，香飘桂影残。\n金波浮太液，光彩忆长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28929,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜雨后月色太佳中夜起坐漫成二律 其一","author":"李孙宸","text":"有怀中夜起，凉月正当帘。\n展卷情俱懒，焚香手自拈。\n云疏桂影落，风劲竹声添。\n幽意无人解，披衣自绕檐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28930,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜雨后月色太佳中夜起坐漫成二律 其二","author":"李孙宸","text":"淋漓一雨后，片月洗逾鲜。\n懒性虽慵起，清辉耐可怜。\n酒难孤影对，茗倩小僮煎。\n谁悟尘嚣里，须眉一病禅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28931,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立冬日寓羊城黎君选何赞侯陶摇光傅贞父彭伯时戴安仲同区启图区叔永诸子携酒见过","author":"李孙宸","text":"客舍怜岑寂，多君问字情。\n秋光失落日，朔气入初更。\n对酒露狂态，论诗狎主盟。\n旧游与新好，兹会亦平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28932,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初冬黄元卿园林与黎缜之冯稚谟韩孟郁赵裕子欧子建邓伯乔诸子分赋","author":"李孙宸","text":"旧游疏散后，复此聚园林。\n落日迟秋色，空亭称远心。\n酒酣黄鸟至，坐久白云深。\n不尽兹宵赏，宁堪老病寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28933,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"客与余话出山事怅然有作","author":"李孙宸","text":"话到出山事，踟蹰思万端。\n官贫随仆少，道远挈家难。\n人面终难信，余腰不哪酸。\n黄粱炊未熟，几欲醒邯郸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28934,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"将游罗浮舟发榄海","author":"李孙宸","text":"为有登山兴，先寻荡桨游。\n烟波开积抱，景物况清秋。\n缓酌醉多适，微吟趣自由。\n兹宵如有梦，应预到丹邱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28935,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿黄龙洞早起出坐流杯石","author":"李孙宸","text":"山眠披雾起，选石出林邱。\n玉乳千秋漱，云光镇日浮。\n放歌来独鹤，争席狎群鸥。\n顿觉尘心洗，丹砂不待求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28936,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"问道出黄龙洞","author":"李孙宸","text":"罢饭辞仙洞，下山日未中。\n浓烟晴渐减，远树望成空。\n认瀑涧多似，扪萝径忽通。\n但随樵采往，何用畏途穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28937,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白莲池","author":"李孙宸","text":"麻姑仙去后，曾此驻云车。\n漾月长悬镜，澄潭不见花。\n蓬莱几清浅，古洞自年华。\n箫管商风发，犹疑下蔡家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28938,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"出增江与仁伯弟舟中夜酌","author":"李孙宸","text":"晚发增江岸，晴霞片片生。\n乱山迎棹出，孤鹤掠舟横。\n海阔月先得，天寒酒屡更。\n夜阑酬劝罢，横被到天明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28939,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日增江舟中与仁伯代骧两弟小酌","author":"李孙宸","text":"何事登高会，翻为荡桨游。\n青山曾几日，沧海正宜秋。\n落照低鸿影，空江罢钓舟。\n举杯兄弟在，不动插萸愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28940,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初冬游樵舟中同伍国开有开望新月有赋","author":"李孙宸","text":"江畔看新月，芦汀一系舟。\n蟾寒光乍减，兔小练初浮。\n未辨云山色，仍怜乌鹊愁。\n赠君不盈手，聊共对清幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28941,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚泊大富村 其一","author":"李孙宸","text":"维舟上断岸，曲径石桥斜。\n林迥衔残日，湖空宿落霞。\n往来见渔艇，三五出人家。\n向晚看潮长，桃源或有花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28942,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚泊大富村 其二","author":"李孙宸","text":"咫尺西樵路，人家别一村。\n山川淳朴处，井里凿耕存。\n有客看游艇，呼童问水源。\n潮生催解缆，江上正黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28943,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊观山市海即西樵山下 其一","author":"李孙宸","text":"五岳他年事，孤云此日情。\n幽期一以惬，尘累肯相撄。\n雁影帆前度，渔灯望里明。\n山情兼水意，应入梦魂清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28944,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊观山市海即西樵山下 其二","author":"李孙宸","text":"去年归橐解，便往访罗浮。\n此日烟霞侣，还乘樵岭秋。\n湖光双桨入，雨色片帆收。\n一夜山前水，潺湲到枕头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28945,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至云路村作","author":"李孙宸","text":"最怜幽绝处，村落数家通。\n犬吠竹声里，鸡鸣茅屋中。\n采茶山下妇，伐木荷锄翁。\n何事避秦去，居然人外踪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28946,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿云路村","author":"李孙宸","text":"舟维山下远，借宿半山扉。\n乱石堪支枕，苍苔欲上衣。\n晓吟猿狖和，晚饭鹤雏归。\n惯客儿童喜，真忘鸥鸟机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28947,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜与诸子步月","author":"李孙宸","text":"别有山家月，人间异此明。\n望崖霜乍积，照树鹊多惊。\n与客踏歌处，偏深独往情。\n清辉吾欲拾，河汉隔盈盈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28948,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"聚仙台与诸子坐月","author":"李孙宸","text":"仙是何年聚，荒台旧有铭。\n罡风璚佩响，彩雾羽衣明。\n呼吸通群帝，迢遥隔五城。\n坐来江月上，骊颔万珠瑩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28949,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒白沙先生祠 其一","author":"李孙宸","text":"衣冠留王气，昭代挺真儒。\n绝学谁应续，微言幸不孤。\n瞽宗垂俎豆，幽谷想师模。\n瞻谒徘徊久，庭前下夕乌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28950,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒白沙先生祠 其二","author":"李孙宸","text":"圣宗传主静，疑信乃犹繁。\n月旦于今定，宫墙百代尊。\n山非紫水路，俗儗白沙村。\n五世瞻遗泽，真怜未及门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28951,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发故园","author":"李孙宸","text":"卧里却忘适，出山愿始遗。\n聊同蕉鹿梦，岂负冥鸿飞。\n何物尘簪绂，抛吾旧钓矶。\n儿童填巷口，问客几时归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28952,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留别诸从弟","author":"李孙宸","text":"五年池草梦，忍别故园春。\n薄禄何关弟，长途累送人。\n云山乡思远，梅柳客怀新。\n莫数天边雁，同行万里亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28953,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊峡山寺下","author":"李孙宸","text":"入夜看山罢，怜幽未解桡。\n卧云身倍稳，醉月量偏饶。\n上界传清梵，长江咽暮潮。\n榜人休促发，吾意任萍飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28954,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"花朝怀故园花事","author":"李孙宸","text":"三春看已半，去去路逾赊。\n未厌长征棹，空怀故里花。\n风中飘柳絮，雨后长兰芽。\n兄弟传觞处，宁忘天一涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28955,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登叫岩山寺","author":"李孙宸","text":"推蓬望空翠，舍棹一扳跻。\n林密幽藏寺，峰危不受梯。\n帆飞江雨后，客到夕阳西。\n无限雍门恨，扪苔读旧题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28956,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]