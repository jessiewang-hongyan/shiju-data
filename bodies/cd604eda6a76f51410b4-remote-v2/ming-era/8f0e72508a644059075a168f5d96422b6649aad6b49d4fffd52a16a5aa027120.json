[{"title":"南还途次感怀 其四","author":"李孙宸","text":"河渡古徐州，淮阳下接流。\n宣房筑何日，瓠子决堪忧。\n漕使道傍议，冬官传舍谋。\n百万东南粟，将无虑咽喉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28889,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南还途次感怀 其五","author":"李孙宸","text":"经过徐北地，凭轼问兴亡。\n王霸千秋气，山川百战场。\n圣明开草昧，日月洗洪荒。\n卜世金瓯重，何当计彻桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28890,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南还途次感怀 其六","author":"李孙宸","text":"驿馆夜沈沈，朝来小雨侵。\n望山披爽气，凭轼动微吟。\n水近田差润，云归山半阴。\n何当一滂沛，处处足甘霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28891,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南还途次感怀 其七","author":"李孙宸","text":"经时旱太甚，一雨未为霖。\n复此淋漓下，方知天地心。\n负槔还野屋，驱犊下高岑。\n顿觉烦嚣洗，悠然惬素襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28892,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与马元伯及仁伯代骧两弟集梁明叔禅悦楼 其一","author":"李孙宸","text":"清斋三载别，下榻重踌蹰。\n壁认曾题字，床披积蠹书。\n寒花开曲沼，落叶满庭除。\n别有关幽事，篱前一径蔬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28893,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与马元伯及仁伯代骧两弟集梁明叔禅悦楼 其二","author":"李孙宸","text":"四海交游意，何如旧社怜。\n论心多往事，问业出新篇。\n奇字推扬子，清言到惠连。\n坐来幽意惬，同醉夜灯前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28894,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和马元伯韵","author":"李孙宸","text":"小雨开新霁，城头隔夕阳。\n冬花无雪意，暮色尚秋凉。\n喜洽班荆语，劳歌伐木章。\n挥杯忘潦倒，莫笑竹林狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28895,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读欧子建澹圃诗记寄示","author":"李孙宸","text":"传闻开径地，风物改新观。\n未遂剡舟访，先飞郢雪寒。\n三年怜雁字，一水忆鱼竿。\n期尔秋江上，相将共采兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28896,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郭朝谔给谏以建言谪江右幕官诗以讯之","author":"李孙宸","text":"闻上兰台疏，危言批颔鳞。\n官宁甘廓落，道岂混风尘。\n量谪君恩重，还家客思新。\n江湖逾恋阙，伫待拜徵纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28897,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙辰除夕","author":"李孙宸","text":"病废乡园久，明朝又见春。\n无闻四十老，有尽百年身。\n违俗宁关傲，微官祇益贫。\n夜阑望北斗，坐待日华新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28898,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白广文举子","author":"李孙宸","text":"谁言毡独冷，又见凤毛奇。\n绛帐谈经日，明珠入掌时。\n鳣堂惬熊梦，芹舍长兰枝。\n未论阿罗好，先传白傅诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28899,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜梦游一寺得一首醒来失记第五六句因补成之","author":"李孙宸","text":"一入空门静，泠然出世情。\n山猫眠暖日，野犬吠秋声。\n败衲将云补，疏钟杂涧鸣。\n欲儗庞居士，悠悠老未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28900,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阴雨久阻看梅因移一株植之斋头招何龙友同诸子过赏","author":"李孙宸","text":"乡落论幽事，探梅酒每赊。\n雨天常负约，冰砌特移花。\n月下新妆淡，风前冷艳斜。\n扬州如有赋，应早过山家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28901,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽赵丕振","author":"李孙宸","text":"相思隔穗石，踪迹转堪疑。\n仙去骑羊后，书传赋鵩时。\n还丹君术误，逝水我心悲。\n欲策素车去，寒江阻后期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28902,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春杂兴八首 其一","author":"李孙宸","text":"短发经霜后，春来不那梳。\n药囊閒自检，瓜地与僮锄。\n嗜酒还忧病，逋诗为懒书。\n晚天归网集，随意市江鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28903,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春杂兴八首 其二","author":"李孙宸","text":"翻怜童稚日，嬉戏入春多。\n买彩装灯胜，招群共踏歌。\n生年嗟老大，情兴与蹉跎。\n寂寞花前酒，风光又一过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28904,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春杂兴八首 其三","author":"李孙宸","text":"草阁临溪上，溪光颇自宜。\n疏林鸣翡翠，暖日晒鸬鹚。\n蓑笠还堪问，濠梁谁与期。\n倘有山阴棹，能无访戴逵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28905,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春杂兴八首 其四","author":"李孙宸","text":"乡园春事好，花柳称幽盟。\n地僻堪投老，身閒不用名。\n妇倾新酿熟，客至晚香清。\n岂敢耽佳句，行吟亦遣情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28906,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春杂兴八首 其五","author":"李孙宸","text":"隔年秋半夜，风俗验晴阴。\n岂谓灯宵月，微云无处寻。\n儿童行乐地，邻曲岁时新。\n俯仰成今昔，幽怀付醉吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28907,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春杂兴八首 其六","author":"李孙宸","text":"经旬天不雨，抱汲借溪流。\n稍便春游路，将无稼事忧。\n三年还卧病，数口可谁谋。\n但遣清尊在，酣歌万虑休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28908,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春杂兴八首 其七","author":"李孙宸","text":"去年朔气重，煖意早春多。\n酒熟花争发，帘开鸟自歌。\n懒锄从蔓草，多病称烟萝。\n一夜催花雨，朝添池上波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28909,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早春杂兴八首 其八","author":"李孙宸","text":"岭南无腊梅，爱此春还开。\n日暖欺冰影，风柔点绿苔。\n几迟仙客梦，如待驿书来。\n寄语怜芳侣，哪堪负举杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28910,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮漫兴和伍国开韵 其一","author":"李孙宸","text":"晏岁论心事，偏于淡者亲。\n阴阳双去鸟，岁月一閒人。\n幸假清时沐，何妨野老邻。\n焚香发疏磬，又过一清晨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28911,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"岁暮漫兴和伍国开韵 其二","author":"李孙宸","text":"粉墙红蕊吐，已觉春风赊。\n窗虚落迟日，山近送明霞。\n簪绂真长物，渔樵自一家。\n所关心事者，梅树渐飞花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28912,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日伍国开有开定国侄过赏五丫兰 其一","author":"李孙宸","text":"开关迎二仲，始觉秋声回。\n落日丛兰里，奇花故故开。\n无人涉湘去，有客援琴来。\n不作留连赏，零霜恐易催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28913,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日伍国开有开定国侄过赏五丫兰 其二","author":"李孙宸","text":"九畹传幽况，湘皋夙擅名。\n几闻开五颖，还得共孤茎。\n浥露金光细，摇风朵佩轻。\n美人应采撷，投赠不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28914,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王番禺奏绩 其一","author":"李孙宸","text":"羡君为宰处，彷佛昔河阳。\n帘对白云岭，琴鸣珠海傍。\n春城桃柳媚，秋郭稻粳香。\n满目含哺者，真同帝力忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28915,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王番禺奏绩 其二","author":"李孙宸","text":"抚字已三载，心劳政始敷。\n最书昨日上，循吏此时无。\n美锦辉花县，寒冰映玉壶。\n只愁朝汉去，岭外渺双凫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28916,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄讯韩绪仲先生南还兼订罗浮之约 其一","author":"李孙宸","text":"长安三载别，如隔五云间。\n此日金门客，秋风又远还。\n心情恋丘壑，性字领仙班。\n咫尺罗山路，能期杖屦攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28917,"sha256":"dc0f