[{"title":"郭子成入关诗卷 其二","author":"练子宁","text":"先人交契若云烟，最说君家外舅贤。\n我有愁心似征雁，随君千里到秦天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37670,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"柬式庵索纸","author":"练子宁","text":"通籍金闺愧不才，扁舟又自望蓬莱。\n闻君素楮光于雪，愿借文章动上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37671,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋日答曾仲和","author":"练子宁","text":"桂花凉露泻涓涓，秋满银盘月正圆。\n不是庾公无此兴，祇因病酒妒婵娟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37672,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访李彦澄不遇戏题","author":"练子宁","text":"过门不入非我心，赠言敢拟瑶华音。\n澄江八月净如练，玄晖有约来相寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37673,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"射卷","author":"练子宁","text":"新开射圃凤冈前，手挽雕弓满月圆。\n记得杨侯飞羽日，泮池杨柳叶皆穿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37674,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重午日答友人","author":"练子宁","text":"青鸟新传锦字诗，高情非是故相违。\n歌钟满坐风流客，不称山人鹤氅衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37675,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄友人胡子温重午日作","author":"练子宁","text":"海榴花里簟纹疏，五月清凉八月如。\n遥忆故人家庆处，綵衣寿酒献菖蒲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37676,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题匏庵所藏画 其一","author":"练子宁","text":"鹤羽翛翛弄月明，筼筜谷里暮寒生。\n凭谁截作参差玉，吹出伶伦嶰谷声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37677,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题匏庵所藏画 其二","author":"练子宁","text":"百尺长松石上栽，紫云深护碧崔嵬。\n绿蓑坐钓盘陀石，细雨斜风不肯回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37678,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题梅","author":"练子宁","text":"月逢三五光才满，梅遇阳回始着花。\n禅定湛然忘色相，不知疏影上袈裟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37679,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题梅四首 其二","author":"练子宁","text":"老禅心迹本来空，却与寒梅臭味同。\n昨夜苦吟清不寐，雪花开遍月明中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37680,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题梅四首 其三","author":"练子宁","text":"岁寒百卉凋残尽，自信孤芳映雪清。\n相对老僧禅坐处，一轮明月正三更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37681,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题梅四首 其四","author":"练子宁","text":"曾向孤山占早春，肯同桃李媚时人。\n暗香疏影黄昏月，应共禅心不涴尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37682,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄问小木医士陈植德","author":"练子宁","text":"玉笥之峰三十六，夫子茆庐处江麓。\n明朝骑虎来相问，白发壶公酒应熟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37683,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠吴嘉静","author":"练子宁","text":"檐花细雨广文毡，不到江城又十年。\n投笔谬曾先俊杰，横经深喜得才贤。\n乾坤一气鸢鱼外，风月无边杖屦前。\n远大相期须努力，宣尼三绝在韦编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37684,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送大将出征","author":"练子宁","text":"九重飞诏紫泥新，帝命南征遣大臣。\n宫路回传银瓮煖，江花初报锦袍春。\n蛮烟瘴雨驱车远，朔雪燕云送捷频。\n汗马功成催入觐，汾阳勋业照麒麟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37685,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题徽宗草虫","author":"练子宁","text":"虫豸薨飞异卉芳，宣和点染自君王。\n当时不省观无逸，对画令人感慨长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37686,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大一统诗","author":"练子宁","text":"圣皇御极天眷隆，四海一统车书同。\n鸿图宝历协昌运，玉京金阙观成功。\n析津自昔称天府，千里邦畿莅中土。\n叠巘盘回海岳崇，重阙列峙森貔虎。\n宸居奕奕当天中，王气五色皆成龙。\n星辰北极共环绕，万方入贡梯航通。\n庶民欢呼工效职，天心昭格人欢怿。\n瑞光扬彩绚瞳胧，宝花呈祥分的历。\n满目光辉锦绮张，庆云焕发摛天章。\n咸传圣德致斯应，颂歌载道声洋洋。\n颂声洋洋中外溢，圣德如天重谦抑。\n屡宣明诏敕群臣，共答嘉祯期尽力。\n小臣日侍金阶前，华封三祝瞻尧天。\n永祈圣寿齐天地，圣子神孙万万年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37687,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赞邑司训黄南谷像","author":"练子宁","text":"?之名儒，邑之司训。\n大道远探，木铎宏振。\n所存者恕，用罔弗臧。\n所积者善，后宜益昌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37688,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元旦","author":"程通","text":"五云佳气应昌辰，凤历新颁又一春。\n月建丙寅时正始，年登甲子运维新。\n九重天日当黄道，百辟衣冠拜紫宸。\n嘉礼庆成蒙锡宴，恩荣何幸到微臣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37689,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜宴韩同年宅","author":"程通","text":"王门更漏已沈沈，此夜相逢共醉吟。\n浩饮不辞非嗜酒，清狂时发为知心。\n诗因得趣联偏好，话到忘言意愈深。\n携手出门同一笑，春风和气蔼儒林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37690,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"敬和春景韵 其一","author":"程通","text":"东皇布德育群生，二月仁风遍海城。\n原上草青堪放马，墙头柳绿可藏莺。\n一尘不作天如洗，万景俱新日与明。\n朝退玉阶无个事，杖藜时向小桥行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37691,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"敬和春景韵 其二","author":"程通","text":"新诗同和酒同酣，三月才过十又三。\n红日腾光辽海上，白云回首大江南。\n一生心地常摅赤，八品官袍尚著蓝。\n君宠母恩俱未报，几回兴念几停骖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37692,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"敬贺千秋诗韵","author":"程通","text":"璇霄昨夜灿文星，知是吾王寿且宁。\n龙衮九章临玉座，鹓班百职拜彤庭。\n香腾晓雾浮佳气，物被春风播德馨。\n何幸小臣逢盛世，愿伸歌颂祝千龄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37693,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉使途中","author":"程通","text":"轻云将雨洗尘泥，丹诏驰飞过小溪。\n草不知名随处发，鸟如相识出林啼。\n韶光明媚诗情逸，道路崎岖客思迷。\n回首亲闱在何许，白云缥缈太行西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37694,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"爆竹","author":"程通","text":"此生循约束，烈性慎几微。\n容物非无量，通玄更有机。\n当场吐霏屑，满眼生光辉。\n平地一声起，传扬到处知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37695,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日 其一","author":"程通","text":"昨夜东风转化钧，眼前岁事又更新。\n王正肇纪庚寅月，天运重开丙子春。\n气蔼一元生品物，嵩呼万寿祝君亲。\n小臣执笔陈歌颂，深愧才华不及人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37696,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日 其二","author":"程通","text":"珊珊环佩共朝元，正是皇明大统年。\n阊阖九重深似海，君王万寿福如川。\n玉阶不是寻常地，黄道争传咫尺天。\n载拜赓歌酬盛德，诗成应愧每迟延。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37697,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日 其三","author":"程通","text":"九重颁历纪王正，宇宙今朝又一春。\n五夜仁风回草木，千年佳会庆君臣。\n海天浩浩皇图广，钟阜巍巍圣德尊。\n生遇太平无以报，惟知一饭不忘恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37698,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和朱引礼韵","author":"程通","text":"海宇清宁氛祲收，大明于赫迈虞周。\n天生圣主八千岁，春到皇家第一州。\n济济佩声臣北面，曈曈日色殿东头。\n承恩归去添诗兴，倚遍东风十二楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37699,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宵 其一","author":"程通","text":"上元佳节几时逢，知是新春正月中。\n香散梅花千点雪，舞低杨柳一帘风。\n楼头玉漏声从转，策下金吾禁已通。\n况喜君王恩似海，人歌人醉万方同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37700,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宵 其二","author":"程通","text":"金吾弛禁任更阑，巷陌游人自往还。\n灯火今宵同万国，蓬莱何处是三山。\n柳霞泼瓮春如海，梅雪沾衣夜不寒。\n一笑相逢总忘寐，不知身世在人间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37701,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"敬和元日韵","author":"程通","text":"鸿胪当殿赞朝仪，百辟衣冠拜玉墀。\n天地三阳开泰日，华夷一统大明时。\n皇皇圣主恩涵育，穆穆贤王敬缉熙。\n何幸小臣逢盛事，承筐玉帛骏奔驰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37702,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元宵","author":"程通","text":"鳌山高耸对孤棱，无处无人不赏灯。\n竹叶香浮银瓮酒，梅花清湛玉壶冰。\n乾坤月色三千界，楼阁烟光十二层。\n共乐太平知有自，万年洪福正龙兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37703,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"较猎","author":"程通","text":"赫赫王师整且齐，奋扬威武保黔黎。\n三山日驭六鳌背，百道风尘万马蹄。\n士气雄飞王气合，阵云高压塞云低。\n明朝得隽回营去，金鼓一声辽海西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37704,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"敬赓松图韵","author":"程通","text":"山林无分著盘垠，特向舆图为现真。\n琥珀长生千岁寿，龙颜不老四时春。\n金枝捧日多承荫，玉柱擎天独立身。\n大展明堂遥觐处，丹青彷佛见仪神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37705,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"万马图","author":"程通","text":"胡关汗血已成功，队队归来汉苑中。\n云散晴川芳草碧，星驰官道软尘红。\n精神摹貌一相似，文彩斌斑万不同。\n伯乐何时重展顾，始知神种有真龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37706,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"桃花马","author":"程通","text":"骅骝踏遍武陵春，带得繁英自满身。\n万点落红霞有晕，四蹄攒白玉无尘。\n自来龙种真仙种，谁识花神是枥神。\n醉倚东风归洞口，错疑游子作刘晨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37707,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"松图","author":"程通","text":"毵然苍发数株松，一夜移来堂壁中。\n老干尚存千古雪，仙花不落半岩风。\n踏枝几误寻巢鹤，跨涧多疑出海龙。\n自昔大夫荣宠后，至今华翰侈遗封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37708,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"元日","author":"程通","text":"龙飞九五定乾坤，宝历春颁又一元。\n万国欢呼供玉帛，五云缥缈启金门。\n下情忻幸遭明主，北面随班拜至尊。\n朝罢琼林还锡宴，恩波洋溢醉深樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37709,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和胡公韵 其一","author":"程通","text":"辽国天开万世基，坐临朔漠控边陲。\n君王茂对春多福，黎庶深祈岁不饥。\n鸣凤来仪丹凤阙，流霞溢美紫霞卮。\n仁风化日均舒畅，品物熙熙蔼德辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37710,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和胡公韵 其二","author":"程通","text":"一气回钧万事新，由来元旦属初旬。\n岁除癸丑年丁丑，月建壬寅日甲寅。\n春满龙颜熙日角，云屯虎旅定天垠。\n忝陪东序遥瞻拜，耿耿丹心拱北宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37711,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"敬和题宗谱韵 其一","author":"程通","text":"新安善政见攀辕，况托遗孤赵祀延。\n忠义一门原有自，云仍百代可无贤。\n簪缨不乏如云盛，文彩犹存炳日鲜。\n何幸君王为题品，共然声价倍当年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37712,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"敬和题宗谱韵 其二","author":"程通","text":"自从五马渡江陵，赐第黄墩我氏兴。\n一本万殊原滚滚，千孙亿子自绳绳。\n箕裘绍业思无坠，文献传家信有徵。\n珍重王章蒙宠锡，垂光终古照云仍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37713,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和曹先生体民韵 其一","author":"程通","text":"邂逅忽相遇，从容不忍离。\n剧谈当日事，还动故乡思。\n江左卜邻近，辽西识面迟。\n从今永为好，如发复如丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37714,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和曹先生体民韵 其二","author":"程通","text":"萍水他乡客，匆匆会复离。\n会时真可乐，别后重相思。\n天晚酒醒后，月明人睡迟。\n谁云我情绪，曾不及游丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37715,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"随猎至沙河回途","author":"程通","text":"西猎沙河曲，东归瀚海浔。\n冒寒真透骨，触景动关心。\n云树家山远，风尘旅思深。\n前邮如有酒，聊复罄囊金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37716,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"义州次曹先生体民见赠诗韵","author":"程通","text":"小子伊川后，先生魏武孙。\n家声都不坠，友道正堪论。\n杯酒城南驿，杖藜山下村。\n相看忍相别，后约在王门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37717,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宴张指挥宅座中戏答操先生观画韵","author":"程通","text":"不到故园今四载，从头点检看如何。\n东风昨夜回天地，还觉眼前生意多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37718,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"和曹先生春游韵","author":"程通","text":"载酒出城去，春山乐胜游。\n风轻云淡淡，冰泮水悠悠。\n我幸逢青眼，公无叹白头。\n抚时须尽兴，一醉两忘忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37719,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"义州回途怀项公诗","author":"程通","text":"不见先生又许时，几回梦寐重相思。\n应招弟子来从学，还向亲王去进诗。\n松耐岁寒知劲节，柳逢春煖长新枝。\n何尝了却公家事，樽酒论文会有期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37720,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次项公韵","author":"程通","text":"久客辽西苦厌尘，岁寒傲过喜逢春。\n江河二月坚冰泮，天地一元生物新。\n怀母愁添堂北草，爱君思献涧中芹。\n宦途谁是知心者，赖有斯文骨肉亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37721,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次陈奉祠留别诗韵","author":"程通","text":"有分同朝参帝子，无人不道似神仙。\n正当辽海联居日，又是滁阳建国年。\n马首云山千里远，鸟啼烟树百花妍。\n欲知此后相思处，月照西窗夜未眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37722,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次项公送别韵就别陈奉祠诸公","author":"程通","text":"百岁交情自古难，才于好处又间关。\n有诗留别知君厚，无物赠行非我悭。\n杯酒忍听三叠曲，片云知隔几重山。\n天高海阔多鸿雁，无惜音书数往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37723,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"会童谢二知事因留夜饮就次诗韵","author":"程通","text":"久别忽相逢，交情感慨中。\n才名今日胜，情况旧时同。\n阴转柳梢月，香飘花底风。\n一樽须尽醉，后夜各西东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37724,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"敬和春雪诗韵","author":"程通","text":"东风吹雪遍埏垓，晓起推窗赏看来。\n三白定占春麦熟，六花不让早梅开。\n连营旧是青毡帐，立地新成白玉台。\n谁忆长安有贫者，红炉煖阁为停杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37725,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寄故人罗宪彰","author":"程通","text":"胄馆交游已有年，新诗同和业同传。\n别来辽水东西地，望断山关咫尺天。\n塞雁阻云空问信，窗鸡叫月几忘眠。\n沈阳长史如相问，为道思君意惘然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37726,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次项公见示雪中诗韵 其一","author":"程通","text":"天娥剪水作飞琼，散乱随风片片轻。\n草木霎时春共老，乾坤入夜昼同明。\n蓝关征马千年事，剡水扁舟万古情。\n翻笑海滨游猎者，归来何处觅行营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37727,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次项公见示雪中诗韵 其二","author":"程通","text":"天雨黄金久不逢，翻成玉屑解漫空。\n都传先腊六花见，准拟明年二麦丰。\n灞上蹇驴誇孟老，池边鹅鸭袭吴宫。\n右教武子能寒奈，绝胜囊萤几倍功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37728,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次项公见示雪中诗韵 其三","author":"程通","text":"大凌河上喜初逢，洪武壬申十月冬。\n下榻有时曾共卧，行轩无处不相从。\n颠狂忍看风前絮，贞固深嘉雪后松。\n不但论交成白首，还期匡国尽丹衷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37729,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"忆甥金公允","author":"程通","text":"异乡重会喜何胜，蓦地分携倍失惊。\n三口能成妻子托，百年还是舅甥情。\n望迷关树知云隔，倚遍楼阑对月明。\n近得好音深可慰，圣恩还与旧时名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37730,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春日即景","author":"程通","text":"乾坤淑气正融和，九十韶光一半过。\n生意总归新草木，坚冰一洗旧江河。\n日笼晴霭红披锦，水著微风绿皱波。\n最喜田家得生理，村村牛背牧童歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37731,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"敬和留别诗韵 其一","author":"程通","text":"春风花萼倍辉明，可是寻常昆弟情。\n鸾驾往来知意密，龙章烜赫荷恩荣。\n辽宁两国同封守，文武千官尽送迎。\n徐水闾山高且远，愿言禧祚与渠平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37732,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"敬和留别诗韵 其二","author":"程通","text":"闾阜之山秀且高，凌河之水胜葡萄。\n水光山色堪图画，柳绿花红映锦袍。\n两府东西停鹤驾，三军先后拥氂旄。\n小臣叨在从官列，鞍马驱驰岂惮劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37733,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"敬和留别诗韵 其三","author":"程通","text":"祖道宏开毡帐高，当筵举盏醉葡萄。\n日辉棣萼霞舒锦，风捲杨花雪点袍。\n分手河梁犹驻马，驰心关树剧悬旄。\n闾山徐水无多远，来往宁辞从者劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37734,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"咏松明火","author":"程通","text":"生长山林地，风霜阅岁深。\n凭谁为倾盖，使尔竟拔心。\n梁栋那成用，轩窗赖照临。\n大夫一封宠，光彩到于今。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37735,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次徐知事韵寿曹先生","author":"程通","text":"春满乾坤万物辉，先生佳诞适斯时。\n仙花光动盈颠发，朋酒香风上寿卮。\n戏彩有人真可乐，杜门无事更何思。\n自惭碌碌尘途客，趋贺无因只寄诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":37736,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]