[{"title":"挽中立宗侯四首 其三","author":"于慎行","text":"斯人不可见，一代失风流。\n未就黄金药，先成白玉楼。\n才名留海内，宾客散池头。\n此夜朱门月，空悲兔苑游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽中立宗侯四首 其四","author":"于慎行","text":"芳草春来绿，王孙去可伤。\n凭谁传旧业，先自弃高堂。\n笙鹤浑疑幻，人琴尽欲亡。\n平生知己泪，一湿薜萝裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀寄张玉阳年丈二首 其一","author":"于慎行","text":"怊怅前年别，绵绵岁月征。\n积薪从古叹，投杼至今惊。\n春雪梁园道，秋江建业城。\n行踪何处问，愁绝雁来声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀寄张玉阳年丈二首 其二","author":"于慎行","text":"聚散年来事，茫然思不禁。\n薄游交道浅，久宦世情深。\n别日枫林梦，愁时桂树吟。\n悠悠大河水，讵尽尺书心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓟门行四首为于大夫子冲赋 其一","author":"于慎行","text":"渔阳开幕府，授钺鲁诸生。\n庙略鱼丽阵，军符骠骑营。\n悬金亲教射，画地细论兵。\n半醉歌声起，风高右北平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓟门行四首为于大夫子冲赋 其二","author":"于慎行","text":"少年多意气，仗节赴燕云。\n晓月悬弓影，春星吐剑文。\n防秋歌出塞，逐敌赋从军。\n未许平阳骑，横邀万里勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓟门行四首为于大夫子冲赋 其三","author":"于慎行","text":"九月平原猎，材官大合围。\n雪凝骄马汗，铁涩侍儿衣。\n塞雁连天起，征蓬卷地飞。\n此时都胆落，前队射雕归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"蓟门行四首为于大夫子冲赋 其四","author":"于慎行","text":"边烽传大漠，一剑夜临关。\n鸟道千重戍，龙城万仞山。\n降兵旗下出，侯骑雪中还。\n苦乐行间事，魂销壮士颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄李北山先生四首 其一","author":"于慎行","text":"当代论骚雅，公存大国风。\n源流千古见，才俊一时空。\n岁月鸳行外，江湖鹤发中。\n倚天长剑在，犹觉气成虹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄李北山先生四首 其二","author":"于慎行","text":"先朝老法从，白首卧岩阿。\n避世交游简，藏山论著多。\n醒酬渔父问，醉倚雪儿歌。\n大有餐霞秘，红颜盛若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄李北山先生四首 其三","author":"于慎行","text":"雅道何寥廓，时名易陆沉。\n不因今日论，宁见异时心。\n剪拂千金价，宫商万籁音。\n故交芜没久，亦许附词林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉寄李北山先生四首 其四","author":"于慎行","text":"龙门何日御，流想碧山隅。\n文雅从先进，声名避大巫。\n白云康乐墅，春酒步兵厨。\n早晚抽簪去，能容绛帐趋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同冯殿讲琢吾夜过东邻魏光禄见泉二首 其一","author":"于慎行","text":"一曲宫城陌，君今几卜居。\n小开蒋诩径，别作子云庐。\n花落藏书后，风生漉酒初。\n相逢殊恨晚，倾盖意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同冯殿讲琢吾夜过东邻魏光禄见泉二首 其二","author":"于慎行","text":"旧好应无厌，新知亦已欢。\n衔杯迟月上，挥麈惜灯残。\n世态閒堪见，浮踪拙自安。\n所欣东壁影，时近夜光寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日过双寺赠宝藏法师","author":"于慎行","text":"偶过城北寺，一憩宝公堂。\n午饭青精滑，新茶玉乳香。\n疏钟沉片雨，高树出斜阳。\n为叩经行地，浮杯海路长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代书答陶比部兰亭","author":"于慎行","text":"落魄佳公子，天涯可定居。\n适来江上使，传得箧中书。\n湖海名方盛，云霄事转疏。\n沉冥吾所慕，数饮态何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠人为金吾郎二首 其一","author":"于慎行","text":"侠少羽林郎，承恩直建章。\n臂鹰驰道侧，调马御楼旁。\n夜月烧灯苑，春风蹴鞠场。\n锦鞲浑未脱，十日从长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"可大邀游张常侍园二首 其一","author":"于慎行","text":"夙慕名园胜，因君载酒看。\n山容虚榭满，竹色小楼寒。\n地主更新贵，游人续旧欢。\n愁中春色过，才此一凭阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"可大邀游张常侍园二首 其二","author":"于慎行","text":"五侯开别馆，平野碧湖东。\n乳燕翻槐日，鸣鸠试麦风。\n水穷千树里，亭隐百花中。\n却忆山园路，芳菲正满丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿宝藏上人二首 其一","author":"于慎行","text":"旧检高僧传，林公胜范稀。\n安禅多宝座，印法六铢衣。\n雨落时闻梵，花开自掩扉。\n空门忘岁月，想见劫尘微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿宝藏上人二首 其二","author":"于慎行","text":"寿者原无相，何因證大龄。\n阶前双树老，阁上片山青。\n地傍苍龙阙，函开白马经。\n应怜朝市客，几日鬓毛星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送侯六参军","author":"于慎行","text":"燕城秋欲暮，疋马送君还。\n投笔书生志，鸣鞘壮士颜。\n边风吹锦带，海月落刀环。\n慷慨匡时略，何年出玉关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送妹倩李子授侯门教读","author":"于慎行","text":"天涯思弟妹，见尔帝京游。\n捧檄趋军府，弹冠传子侯。\n黄花征路晚，玄雁塞城秋。\n那值池塘恨，临风涕泗流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞四首为辽左李大将军赋 其一","author":"于慎行","text":"塞上发鸣笳，军声动地哗。\n三秋徵彀骑，七校选良家。\n晓月分弓影，秋霜吐剑花。\n主恩何以报，急为扫边沙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞四首为辽左李大将军赋 其二","author":"于慎行","text":"铜符天上至，汉将出龙城。\n云鸟图成阵，河山幕作营。\n日凝金玦色，碛冷铁衣声。\n早报匈奴灭，西京甲第成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞四首为辽左李大将军赋 其三","author":"于慎行","text":"元戎新授钺，侠少远从军。\n菟塞秋山合，龙城旧路分。\n角声吹冻雨，旗影乱浮云。\n百战城南道，方成上将勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"出塞四首为辽左李大将军赋 其四","author":"于慎行","text":"玉节君王诏，军中夜筑坛。\n金人归少府，铁骑散材官。\n远戍三秋断，严霜万里寒。\n功成多意气，歌舞入长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"怀周公瑕","author":"于慎行","text":"苦忆吴门隐，翛然一钓竿。\n烟霞双鬓老，天地五湖宽。\n阅世凭乌几，逃名著鹖冠。\n何时燕市里，重逐酒人欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"周公瑕有书见问寄答","author":"于慎行","text":"故人何所似，契阔已多年。\n旧事閒应记，新诗老更传。\n花开三径雨，门闭万峰烟。\n犹采相思树，封题到远天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日有怀东郭草堂","author":"于慎行","text":"吾庐吾所爱，虽小却宜春。\n草色常经雨，花香不受尘。\n归期何日定，旅梦此时真。\n怨杀烟皋鹤，临风待主人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阁夜","author":"于慎行","text":"隐几虚堂夜，幽怀谁与论。\n星河临九陌，钟漏彻千门。\n黯淡伤春事，踟蹰念主恩。\n蘼芜今已绿，归路滞王孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"报邬山人汝翼","author":"于慎行","text":"念子不能寐，三年阙报书。\n自缘归兴久，非是故情疏。\n南北无宁岁，江湖有索居。\n尔时吴市隐，寥落复何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"报云翠山道士许公","author":"于慎行","text":"契阔茅山侣，书来见素心。\n养砂还守灶，种树已成林。\n月出岩泉冷，花飞石洞阴。\n知君相忆久，日听晓猿吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春暮","author":"于慎行","text":"归心无可奈，先作送春归。\n细草河堤合，残花苑路飞。\n梦回双阙雨，思绕旧山薇。\n想到征轮动，薰风已上衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"卧病","author":"于慎行","text":"卧病已三月，归图犹未成。\n慰留明主意，推挽故交情。\n御路蘼芜发，春山杜若生。\n湖边小行径，处处有鱼羹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闭门","author":"于慎行","text":"闭门多所适，懒与病相宜。\n岸帻全忘沐，匡床久未移。\n酒醒微雨夜，衣减落花时。\n只忆河桥柳，应馀未折枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"告中冯用韫宫谕朱可大丞卿见过","author":"于慎行","text":"卧阁荒三径，惟容二仲过。\n借书酬寂寞，说剑慰蹉跎。\n未路交情少，他年别思多。\n东门杨柳色，执袂可如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"小阁","author":"于慎行","text":"小阁经时卧，琴书静不哗。\n丹衷犹恋主，清梦已还家。\n几对春城月，虚开杜曲花。\n一床馀丈室，还似住毗邪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"可大游摩诃庵有诗见示赋答","author":"于慎行","text":"少壮欢娱地，怜君只自游。\n一春全卧病，旧事几经秋。\n听雨花间坐，飞觞石上流。\n归心将别恨，忆此更悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"孤雁","author":"于慎行","text":"池上孤鸣雁，因风忆断行。\n凋萧形影共，蹢躅羽毛伤。\n有恨惊霜露，无心慕稻粱。\n如何笼伴鸟，噭噭主人傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"上书","author":"于慎行","text":"上书书未报，旅思且盘桓。\n天意高谁问，人情巧自看。\n味兼甘苦尽，色并笑啼难。\n耿耿孤臣志，惟馀一寸丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中遣使买舟","author":"于慎行","text":"时节忽复易，閒居事更幽。\n微风吹木杪，片雨到床头。\n未解虞卿印，先寻范蠡舟。\n行装书数卷，沾湿不无愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"乞休","author":"于慎行","text":"华发登朝列，承恩岁月深。\n病酬吴客问，思作越人吟。\n世事容萧散，时名任陆沉。\n本无匡济略，报国在抽簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"听姜生弹琴","author":"于慎行","text":"客来山水际，为我鼓鸣琴。\n月泛三湘色，松流万壑音。\n焚香消昼永，啜茗到更深。\n莫漫弹招隐，方怀桂树吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题杨梦山先生半间楼","author":"于慎行","text":"旧有沧洲兴，今成绿野游。\n桃花千树雨，月色半间楼。\n隐几山光入，开帘海气收。\n却令麟阁上，图画想风流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新城馆中夜坐","author":"于慎行","text":"独坐燕南馆，桃灯坐自深。\n还家游子路，去国迩臣心。\n落月征车动，寒霜客袂侵。\n陆沉非避世，吾道在云林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"途中书怀二首 其一","author":"于慎行","text":"圣代无高隐，行藏亦有因。\n寡交思避世，多病学全身。\n止足存微尚，安危付钜臣。\n所惭恩礼重，雪涕念君亲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"途中书怀二首 其二","author":"于慎行","text":"太息宗祊计，回天事信难。\n三年头欲白，八疏口将丹。\n璇海波能润，瑶台月正安。\n汉庭多彊项，谁敢测宸欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"单家桥","author":"于慎行","text":"十载桥边路，巾车此重过。\n秋声连渤海，寒色下滹沱。\n避地红尘远，还家华发多。\n来时道旁柳，生意稍婆娑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮抵德州城下","author":"于慎行","text":"瞥见漳河水，燕齐两界分。\n郡楼融晚雪，津柳挂残云。\n病骨寒应倦，乡音近稍闻。\n明朝看海气，遥礼泰山君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"茌平道中感怀","author":"于慎行","text":"父老迎相问，君今华发归。\n云霄身自贵，家国事多违。\n具迩差皆尽，同游既已稀。\n畏看旧门巷，先有涕沾衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"铜城望见云翠诸山","author":"于慎行","text":"归途今日惬，凭轼见吾山。\n以尔千岩翠，惭人两鬓斑。\n向来多远梦，从此闭重关。\n不似终南路，依栖慕世间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春日杨户部庐山谪官河南枉道过访","author":"于慎行","text":"轩车来远道，执手意何长。\n喜对春盘酒，愁分画省香。\n士龙名入洛，司马赋游梁。\n莫漫悲岐路，雄心在四方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕前四日送杨户部之官河南","author":"于慎行","text":"送子岁云晏，踟蹰可奈何。\n酒边生白发，雪里渡黄河。\n落魄才难尽，飞扬意故多。\n春风洛阳道，早晚听鸣珂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"抵舍承邢知吾侍御赐问裁答二首 其一","author":"于慎行","text":"海畔投簪始，伊谁问索居。\n长安千里使，济水数行书。\n世事焚鱼外，时名梦鹿馀。\n平生周柱史，避俗意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"抵舍承邢知吾侍御赐问裁答二首 其二","author":"于慎行","text":"海岳终堪隐，风尘几倦游。\n采芝随绮季，种竹待羊求。\n月迥春天树，江寒雪夜舟。\n何时芳驾至，尊酒一淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归日王兴甫文学于子冲大参来视","author":"于慎行","text":"山斋春欲尽，上客到羊求。\n对月休愁思，看山且醉游。\n蚁封知是梦，驹隙信如流。\n不见芄兰侣，辞官已白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽赵秀才竹里二首 其一","author":"于慎行","text":"别来能几日，溘已隔重泉。\n不作鹏抟海，翻成鹤上天。\n谈经溪阁月，对酒竹楼烟。\n回首东山社，伤心涕泫然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽赵秀才竹里二首 其二","author":"于慎行","text":"连年家难剧，双泪日沾缨。\n已叹无兄弟，谁堪丧友生。\n延陵荒草合，管子旧台倾。\n更甚山阳路，空闻笛里声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泰山道中","author":"于慎行","text":"地僻尘踪少，山深石路斜。\n雨中过佛院，云里见人家。\n雊雉飞春麦，啼莺绕落花。\n流亡今欲尽，几处有桑麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泰山天门禅堂逢傅柱史金沙赠别","author":"于慎行","text":"含桃花欲落，山下遇君时。\n雨过空王殿，天晴岳帝祠。\n相看芳杜色，各有白云期。\n不似风尘路，偬偬叹别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"泰山绝顶对酒","author":"于慎行","text":"茫茫今古事，欲问岱君灵。\n汉柏虚称观，秦松枉勒铭。\n此生游已倦，何地酒能醒。\n杖底千峰色，依然未了青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"下泰山游三阳观","author":"于慎行","text":"半岭通仙界，萦回岳麓西。\n已看三观迥，犹觉万峰低。\n暮雨瑶华落，春云玉洞迷。\n游情浑未减，缥缈望丹梯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮三阳观绝顶对月","author":"于慎行","text":"孤亭堪倚啸，一醉斗牛边。\n袖拍千峰月，觞飞万树烟。\n花前鸾吹度，海上鹤书传。\n借问三宫路，今当几洞天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词四首赠三阳观昝云山道士 其一","author":"于慎行","text":"寰区不足步，聊作小游仙。\n牒秘丹缯字，山藏绿玉篇。\n石梁云外挂，瑶岛月中悬。\n欲问餐桃客，蓬莱更几千。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词四首赠三阳观昝云山道士 其二","author":"于慎行","text":"五游凌碧落，彷佛见乘鸾。\n瑶水银为阙，蓬丘玉作坛。\n飞尘成大药，毁灶出神丹。\n旧遇华山博，曾将六箸看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词四首赠三阳观昝云山道士 其三","author":"于慎行","text":"由来称福地，自合有仙才。\n萧史吹笙下，栾巴噀酒回。\n云轩通紫阙，月宇逼丹台。\n谢手尘中客，年光漫自颓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游仙词四首赠三阳观昝云山道士 其四","author":"于慎行","text":"辞家慕冲举，名岳且依栖。\n辽左迟归鹤，淮南见去鸡。\n玄霜堪入药，白石总如泥。\n试访清都宴，云门路欲迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"子冲携尊方山相候因谋卜筑","author":"于慎行","text":"百里行厨至，追欢有报书。\n春城开腊蚁，别墅罩河鱼。\n白社能留客，青山可卜居。\n未须烦地主，十笏是吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":19733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]