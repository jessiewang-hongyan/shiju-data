[{"title":"送丁文远册封华阳王 其一","author":"韩日缵","text":"几年同视草，此日重分茅。\n睦族周三等，观风楚四郊。\n金函来上国，醴酒出中庖。\n羡尔浮湘去，伊予独系匏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28051,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送丁文远册封华阳王 其二","author":"韩日缵","text":"愧兹樗散质，时挹蕙兰芬。\n漫谓簪常盍，其如袂欲分。\n星槎天汉水，秋色洞庭云。\n探胜饶诗思，江鱼可遣闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28052,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孤山雪霁 其一","author":"韩日缵","text":"湖光雪初霁，林壑霭新晴。\n瘦鹤梅边影，疏松涧底声。\n寻僧到野寺，看竹过山楹。\n此景真清绝，殊深流览情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28053,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"孤山雪霁 其二","author":"韩日缵","text":"曾踏孤山雪，言探处士梅。\n今从图里见，似向宅边开。\n枝濯光逾净，花明香暗来。\n云间双白鹤，何处却飞回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28054,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望峄山","author":"韩日缵","text":"晓行当翠巘，积霭远浮空。\n派自尼丘接，枝分泰岳雄。\n秦碑留断碣，禹贡纪孤桐。\n驻马聊凭望，徘徊意不穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28055,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖上","author":"韩日缵","text":"长天连积水，落照下平芜。\n湖色晴逾白，云光淡欲无。\n寒枝凝霰净，沙鸟负暄呼。\n鹿洞苍茫里，千秋独起予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28056,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溽暑新雨 其一","author":"韩日缵","text":"满目火威赫，山榴艳欲燃。\n陂塘渴有鹭，江树噪无蝉。\n消夏偏宜酒，吹商更撮弦。\n排云看已合，细雨濯枝鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28057,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"溽暑新雨 其二","author":"韩日缵","text":"烦暑忽已失，佳气散浮空。\n晚蓧摇阶绿，早荷照水红。\n窥窗神女雨，透幌大王风。\n乾坤洗暄浊，清凉法界中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28058,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李柱可进士南还","author":"韩日缵","text":"岭徼多奇服，似君才调稀。\n连城已为剖，明月有光辉。\n秋色催行骑，霜华点客衣。\n上林花满树，携得一枝归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28059,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄郭荆麓 其一","author":"韩日缵","text":"去年今日别，把酒梅花冈。\n隔岁一书至，停云思渺茫。\n藉兰临涧曲，吹笛醉花傍。\n烟雨春江夜，同谁对举觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28060,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄郭荆麓 其二","author":"韩日缵","text":"尚忆春留赏，冯栏看牡丹。\n东风三月暮，细雨一花寒。\n草色迷遥浦，江声泻急湍。\n追欢又何日，相与话更阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28061,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄马北海使君","author":"韩日缵","text":"九河寻故道，遥望陈公堤。\n使君有佳政，名与古人齐。\n黄鸟下厅事，飞乌匝树啼。\n因风裁数字，临发转凄凄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28062,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠胡生","author":"韩日缵","text":"二胡元矫矫，浪迹寄长安。\n意自千金失，交从一日欢。\n虎头痴更绝，鸟篆古同刊。\n肯过宁论数，清尊拚夜阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28063,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得家信","author":"韩日缵","text":"隔岁无书讯，时常作越吟。\n遥传一赤素，真比万黄金。\n丛菊他乡泪，维桑子舍心。\n栖迟归未得，怅望碧山岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28064,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬钱德丕过酌斋头之作次韵","author":"韩日缵","text":"汝作朱门客，依然松桂心。\n时耽杨子赋，肯卖长卿金。\n话久杯行数，庭空暑不侵。\n相看偏忆昔，双鬓岁华深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28065,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄亮垣归省 其一","author":"韩日缵","text":"亦自希朝谒，归心底欲忙。\n但缘趋鲤对，暂尔谢鸳行。\n粤树杳何处，江云引到乡。\n金茎一滴露，携荐紫霞觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28066,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄亮垣归省 其二","author":"韩日缵","text":"风雨论文夕，招寻独有君。\n那堪白社侣，转向碧山分。\n柳折金堤晚，尊开玉液芬。\n当筵不尽醉，应为惜离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28067,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄亮垣归省 其三","author":"韩日缵","text":"无奈乡心剧，看君独著鞭。\n祇因供菽水，不为忆林泉。\n莱子斑衣日，相如负弩年。\n故山宁久卧，清庙待朱弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28068,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十七夜再集李伯襄楼上 其一","author":"韩日缵","text":"为爱清秋赏，招邀更倚栏。\n故人殊共此，圆魄未须残。\n拚醉酬良夜，惊衰怯早寒。\n楼前移几尺，频起把杯看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28069,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十七夜再集李伯襄楼上 其二","author":"韩日缵","text":"不分楼头月，无端三五过。\n梧凋空玉井，桂濯尚金波。\n客思当秋倍，豪心对酒多。\n况逢白社侣，无惜朱颜酡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28070,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日喜吴光卿孝廉至招同李伯襄太史曾元鲁比部黎有道山人小集 其一","author":"韩日缵","text":"相隔频音问，相逢是帝乡。\n风尘怜客况，词赋满书囊。\n霜叶留馀绿，篱花绽早黄。\n东山秋色好，到此可能将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28071,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日喜吴光卿孝廉至招同李伯襄太史曾元鲁比部黎有道山人小集 其二","author":"韩日缵","text":"羡尔囊中草，篇篇语可惊。\n诸公欣共赏，季子早知名。\n幸及黄花候，同寻白社盟。\n孤尊今夕意，须尽掌中倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28072,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日喜吴光卿孝廉至招同李伯襄太史曾元鲁比部黎有道山人小集 其三","author":"韩日缵","text":"木叶萧萧下，庭阶事事幽。\n自公多暇日，久客不禁秋。\n寂寞元吾分，过从得旧游。\n披襟谈夙昔，竟夕为淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28073,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日喜吴光卿孝廉至招同李伯襄太史曾元鲁比部黎有道山人小集 其四","author":"韩日缵","text":"客邸秋将莫，相过破寂寥。\n病馀诗兴在，凉入酒魂销。\n久坐衣嫌薄，高谈漏不遥。\n清狂真我辈，胜事又今宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28074,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次李伯襄韵赋得明月照积雪 其一","author":"韩日缵","text":"寒光疑欲曙，皎色远浮空。\n桂濯雰霏后，花明泛滟中。\n流辉凝砌树，散彩入房栊。\n处处瑶华满，应迷度塞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28075,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次李伯襄韵赋得明月照积雪 其二","author":"韩日缵","text":"澄辉浑似练，点缀尽成花。\n禁苑琼为圃，关山玉是砂。\n寒侵光欲湿，漏永影将斜。\n羡尔阳春调，徒令下里誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28076,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪竹 其一","author":"韩日缵","text":"一夕瑶华满，翛翛绿玉林。\n压枝花烂熳，缀叶韵萧森。\n似佐书帷静，偏宜酒盏深。\n贞姿相映彻，不负岁寒心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28077,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪竹 其二","author":"韩日缵","text":"本是琅玕质，况当雪里看。\n寒枝还茜练，冻蕊更檀栾。\n映月分辉易，摇风独立难。\n疏丛閒徙倚，寂寞似袁安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28078,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"余病羸久心源叶君授我禁方喜赋","author":"韩日缵","text":"二竖苦相迫，经年与尔俱。\n方书閒自简，药裹不时需。\n岂有长桑秘，能令病骨苏。\n君从何处授，曾饮上池无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28079,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄黄逢一 其一","author":"韩日缵","text":"故人不可见，偃息故山阴。\n忽枉新诗至，欣闻正始音。\n琴书千里隔，羁病一生侵。\n屈指当年事，幽盟许重寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28080,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄黄逢一 其二","author":"韩日缵","text":"一自仙即去，何时续胜游。\n鹏图息天末，鸡骨卧林丘。\n对此他乡月，悲君故国秋。\n支床无已过，圣主或遗忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28081,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方医士母","author":"韩日缵","text":"数世青囊在，宁知母也劬。\n藁砧中道弃，岁月一生孤。\n茹蘖心偏苦，和丸眼欲枯。\n承欢今有子，托业似淳于。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28082,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曾元鲁恤刑浙江","author":"韩日缵","text":"之子扬旌日，君王祝网年。\n九天饶雨露，越水自风烟。\n葑合桥逾古，堤明柳欲眠。\n遥知谳牍暇，应不废诗篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28083,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送关德甫恤刑江南","author":"韩日缵","text":"南国疮痍后，金鸡捧诏来。\n覆盆情自白，祝网面仍开。\n秋色吴江冷，恩光海日回。\n都门惜别地，且为促行杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28084,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜何闇然京闱得隽 其一","author":"韩日缵","text":"抱玉终须售，连城价自饶。\n忆当三献后，已是廿年遥。\n文章淹岁月，姓字傍云霄。\n扑地香尘满，秋风马欲骄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28085,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜何闇然京闱得隽 其二","author":"韩日缵","text":"下榻他乡夕，论文尔转豪。\n风尘双逸足，湖海一绨袍。\n迹自罗浮远，名悬碣石高。\n无穷今昔意，且为醉香醪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28086,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"八月菊","author":"韩日缵","text":"可是陶潜宅，偏于秋色宜。\n才当八月节，已值菊花时。\n嫩蕊人犹讶，轻香蝶未知。\n霜华浑不染，任尔自含姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28087,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄家书","author":"韩日缵","text":"空椷数行字，凭君寄所亲。\n一官频岁月，万里讯松筠。\n疏拙难逢世，文章岂救贫。\n故园风景好，愧是未归人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28088,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与余士翘连床共赋","author":"韩日缵","text":"不耐经年别，聊为竟夕谈。\n疏钟天尺五，孤枕日竿三。\n漫说黄金尽，还惊白发毵。\n酒魂清不寐，就尔叩玄探。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28089,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送苏孺子出宰新建 其一","author":"韩日缵","text":"看花辞上苑，结绶向河阳。\n竹马随征盖，江云满讼堂。\n官閒山鸟下，岁稔秫苗香。\n莫学陶元亮，高吟拟上皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28090,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送苏孺子出宰新建 其二","author":"韩日缵","text":"言从京国去，把袂此宵分。\n不识西山色，何如南浦云。\n阁中思帝子，日下借神君。\n别后能为政，佳声到处闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28091,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对雪","author":"韩日缵","text":"为爱飞花色，凄风漫捲帘。\n阁云昏冉冉，庭树冻纤纤。\n历乱从铺径，颠狂故扑檐。\n微醺当莫景，映彩入书签。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28092,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日杂咏 其一","author":"韩日缵","text":"侍直金闺暇，芸编恣讨寻。\n吟邀仙掌月，佩接禁城阴。\n砌竹寒犹韵，檐花雪屡侵。\n班联青汉上，不负白云心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28093,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日杂咏 其二","author":"韩日缵","text":"本是烟霞客，回翔翰墨林。\n疏棂穷碧篆，爽气澹幽襟。\n散帙看云起，弹冠笑陆沈。\n矢音徒有顾，潦倒愧朝簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28094,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日杂咏 其三","author":"韩日缵","text":"起草青藜閤，承恩白玉除。\n开樽山入幌，散帙鸟窥书。\n胜友清言惬，閒情世法疏。\n过从常卜夜，潇洒意何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28095,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日杂咏 其四","author":"韩日缵","text":"俗远风尘隔，门閒雪色欺。\n仙曹元寂寞，微尚讵磷淄。\n金掌朝看爽，铜瓶夜结澌。\n翛翛双白鹤，来啄玉阶墀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28096,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日杂咏 其五","author":"韩日缵","text":"雅性从书僻，孱躯赖药扶。\n文章堪覆瓿，身世似为瓠。\n鹤影阶前月，茶烟竹下厨。\n敲门时有客，半是督诗逋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28097,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日杂咏 其六","author":"韩日缵","text":"呜珂枫禁切，视草玉阶青。\n冷署从萧散，玄心豁杳冥。\n琴樽因雪胜，齿颊为诗馨。\n休沐长无事，双扉镇日扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28098,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日杂咏 其七","author":"韩日缵","text":"禁苑琼章秘，天厨法酝传。\n风云真忝窃，岁月坐空捐。\n索米仍尸素，翻经拟尚玄。\n平生迂僻意，与我自周旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28099,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日杂咏 其八","author":"韩日缵","text":"簿领元无分，良朋雅尚敦。\n帙侵芸幌冷，衣惹御炉温。\n对雪怜芳岁，看云过别轩。\n朝回山日暮，稚子喜迎门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28100,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日杂咏 其九","author":"韩日缵","text":"官暇懒偏宜，芸窗落照移。\n未能抛绂绶，且复叹栖迟。\n客况青藜在，乡心白雁知。\n诛茅曾四百，惭负岭云期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28101,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日杂咏 其十","author":"韩日缵","text":"游子他乡梦，孤灯对短檠。\n乞身曾上疏，噬指已频惊。\n冉冉浮沈外，悠悠去住情。\n主恩犹未报，不是厌承明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28102,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送曾碇曦分教澄海","author":"韩日缵","text":"且莫嗟迟暮，还看教铎扬。\n藻翻鱼浪煖，芹入燕泥香。\n碧海当官舍，青山接故乡。\n到时春色好，秾李遍成行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28103,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李建霞归高邑 其一","author":"韩日缵","text":"惜别当今夕，同人黯不胜。\n琴樽从此隔，意气转相矜。\n客路春光逼，归装雪色凌。\n元来金马署，拟是玉壶冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28104,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送李建霞归高邑 其二","author":"韩日缵","text":"去去耽云卧，悠悠竟陆沈。\n愁当一夜别，交以十年深。\n宫柳题春径，溪花酌晚林。\n英游追侍处，何日更招寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28105,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"野望","author":"韩日缵","text":"偶来人境外，古寺倚岩扉。\n潭影兼鸥静，松涛带瀑飞。\n晚岚千树合，落日一僧归。\n此境堪长往，随缘已息机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28106,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠郭给事 其一","author":"韩日缵","text":"何事催征骑，春风遽拂衣。\n碧梧辞夕省，白简抗天威。\n恋阙心仍在，抽簪顾不违。\n岭云纷冉冉，应待逐臣归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28107,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠郭给事 其二","author":"韩日缵","text":"痛哭千秋壮，安危一疏存。\n昌言扶社稷，直道任乾坤。\n金石真堪泐，升沈未可论。\n閒来披谏草，数过倍销魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28108,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠郭给事 其三","author":"韩日缵","text":"宁知抗疏日，便作去官时。\n伏马孤臣斥，批鳞圣主知。\n寸心良不负，三黜竟何辞。\n暂向美容幕，羁栖借一枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28109,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠郭给事 其四","author":"韩日缵","text":"谪宦从兹去，将无泽畔吟。\n五云丹阙迥，三径绿苔深。\n安得回天力，仍悬捧日心。\n赐环应有待，旦夕望为霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28110,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮张钟石户部安德署中 其一","author":"韩日缵","text":"地旷临风爽，亭閒透影疏。\n杯倾三伏后，簪盍两人初。\n弱柳摇虚幌，残荷覆浅渠。\n虽云官舍里，萧散似林居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28111,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮张钟石户部安德署中 其二","author":"韩日缵","text":"主人情未惬，移席小龙湫。\n龙去知何代，尊开及早秋。\n云从虚砌起，水向绮筵流。\n坐对□□暮，清言足献酬。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28112,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东阿道中遇雨 其一","author":"韩日缵","text":"伏热秋仍甚，俄惊此夕阴。\n松涛响远壑，岩溜下高岑。\n侧径人行怯，平田马度深。\n三农方待雨，未可赋愁霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28113,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东阿道中遇雨 其二","author":"韩日缵","text":"济北旱为虐，齐东节重过。\n蝗飞赤地尽，马踏白云多。\n草木秋风入，田畴晚霁和。\n久晴疏雨具，天色定如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28114,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东阿道中遇雨 其三","author":"韩日缵","text":"旅迹泥中路，苍茫野望时。\n径萝褰雨幕，岸柳罥风丝。\n日暗秋逾淡，山高云故迟。\n捕蝗今正急，辛苦向东菑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28115,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邹县道中","author":"韩日缵","text":"天地疏秋色，萧条对夕阳。\n树凋犹剥枣，岁俭尚忧蝗。\n马力冲泥怯，蜩声咽露长。\n征轺行且止，小憩峄山傍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28116,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李伯襄吉士以诗来讯兼订罗浮之约赋此奉答 其一","author":"韩日缵","text":"禁苑同游日，情亲即匪他。\n风期常自许，雪夜每相过。\n并榻芸侵幌，联镳柳拂珂。\n无涯千古意，别后竟如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28117,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李伯襄吉士以诗来讯兼订罗浮之约赋此奉答 其二","author":"韩日缵","text":"君卧碧山庐，予归帝里初。\n三年怜久客，十亩赋同车。\n室迩人仍隔，书来岁逼除。\n喜闻双玉树，云干已扶疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28118,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李伯襄吉士以诗来讯兼订罗浮之约赋此奉答 其三","author":"韩日缵","text":"探奇闻有约，已报罗浮君。\n日吐晨曦彩，峰留夕霭云。\n竹皮长似绣，梅蕊正扬芬。\n善待腾霄侣，来飞掷地文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28119,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]