[{"title":"赠陈养斋","author":"叶春及","text":"梅生去国愁吴市，三径君恩此亦饶。\n白发有时麋共往，青天无伴鹤堪招。\n惟将涕泪酬先帝，实见弓旌下圣朝。\n藜藿岂遗尧舜世，江湖容尔许由瓢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬周玉虹见示阅师之作","author":"叶春及","text":"见说周郎昨阅师，蛇矛垒垒羽林儿。\n承家斧钺今投笔，横槊江天自赋诗。\n关塞几年啼虎豹，乾坤何处不旌旗。\n冲星匣剑啾啾动，怅望云峰暮有思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别周玉虹","author":"叶春及","text":"独客深杯始为君，夏堂风砌夜论文。\n山围官舍云时入，水满江楼袂忍分。\n旧赏雨花愁树树，并飞沙鸟故群群。\n共来闽海频伤别，细作音书寄鲤闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周玉虹至江口口号","author":"叶春及","text":"欲别未别梅溪东，千山万山相映红。\n狎人鸥鸟漫多思，背日旌旗来晚风。\n世路杯酒共为客，海国音书愁远鸿。\n南天聚散只云水，莫惜醉系蒹葭中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"期访陈养斋因事不果诗以谢过兼为后期","author":"叶春及","text":"避暑期君水竹居，濠梁云静看鯈鱼。\n溪行棹拟冲鸥入，野酌瓜怜带雨锄。\n无奈冠裳羁叔夜，不缘消渴阻相如。\n高情陈榻今应下，三五休悬待望舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈太仆北上 其一","author":"叶春及","text":"两朝执法太微臣，绣斧云霄早致身。\n岭险昔年歼虎豹，阁开他日画麒麟。\n驱车晓带金陵月，到阙长依玉座春。\n调鼎宅揆真有待，须知崧岳为生申。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈太仆北上 其二","author":"叶春及","text":"周王此日思周道，伯囧还应作仆臣。\n岂为渥洼龙骥好，欲令云锦渭河新。\n长城铁骑时寻窟，西域金牌旧入秦。\n八骏久閒天厩满，燕台马骨更何人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠陈太仆北上 其三","author":"叶春及","text":"星轺北上天颜近，却忆披裘伏阙时。\n万里独怜明主惠，三湘谁为贾生悲。\n灌园讲罢还溪涧，鸣玉朝回祇梦思。\n幽侧傥承閒燕问，迂疏早已鹿门期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"打鱼","author":"叶春及","text":"榜人齐击雪花明，春水青芜白浪生。\n撇去湖心金锁直，到来几上玉梭横。\n平摧雨鬣沾沾湿，细切霜鳞冉冉轻。\n下箸当筵应甚美，独怜残溃重伤情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"藤州清明","author":"叶春及","text":"十年松柏违亲垄，此日清明又客途。\n满眼郊原倾绿蚁，侧身天地愧慈乌。\n蓼莪篇废愁仍在，林木风来静自呼。\n隔岸哀猿更呜咽，一声肠断粤山孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"第一楼秋兴 其一","author":"叶春及","text":"万石楼高切太虚，家贫还得此楼居。\n青山入户寒偏瘦，绿鬓逢秋晚渐疏。\n北郭长楸朝骋马，西邻明月夜吹竽。\n成都扬子惟清净，门外无人只著书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"第一楼秋兴 其二","author":"叶春及","text":"秦军汉将昔临关，曾闪旌旗五岭间。\n南帝殿庭随桂水，左丞坟墓满枫山。\n潮声实见迎秋早，栈道虚疑出塞难。\n万古圣朝形胜地，海滨真有虎龙蟠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"第一楼秋兴 其三","author":"叶春及","text":"罗浮山下古循州，万里风尘客倦游。\n北望九连关塞险，西闻三峡甲兵愁。\n霜高越徼凋军寨，月满祯城照戍楼。\n烽火海丰犹未息，江湖空抱杞人忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书怀","author":"叶春及","text":"燕云南望故山迷，客子思家问路溪。\n关塞绪寒春悄悄，乡园归梦草萋萋。\n黄金台没蘼芜合，碧玉楼高日月齐。\n欲访江门知不远，扁舟横过铁桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南望","author":"叶春及","text":"南望遥天隔翠微，东征消息愿多违。\n忧时藜藿空悲壮，故国蓬蒿有是非。\n莫雨几年啼野鬼，春农何日返山扉。\n锦衣最恨愈枢府，数万貔貅一夜归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梧桐山","author":"叶春及","text":"梧桐山上梧桐月，照见当年汉将营。\n旬日黄衣秋可扫，中宵白羽早还兵。\n波添淮水千家泪，驿奏燕云疋马程。\n南北迢遥无限恨，村村烟雨髑髅声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"留别二陈明府","author":"叶春及","text":"西来温水二君稀，城北城南自掩扉。\n三径云深高士别，万山天迥远帆归。\n尊移树影离筵晚，路绕秋声去马迟。\n两粤古今元接壤，并州回首共依依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆川县斋对雨呈张明府","author":"叶春及","text":"晚风吹雨送新凉，远树依微近女墙。\n云起戍楼秋黯黯，山围官舍日苍苍。\n空庭鸟字来人少，清簟螺杯引兴长。\n十载倦游君独惜，刺桐花下共徜徉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆川县谯楼晚眺呈张明府 其一","author":"叶春及","text":"雨过峰峦生夕烟，登楼秋色正堪怜。\n几家城郭苍山里，一县弦歌落照边。\n花近烽狼消古戍，叶飞云雁下平田。\n开樽取醉劳明府，无奈中原别绪牵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆川县谯楼晚眺呈张明府 其二","author":"叶春及","text":"向晚登楼望欲迷，清秋草色转萋萋。\n苍梧西上龙濠迥，翠岭南来雉堞齐。\n千顷水田经雨湿，二更山月傍人低。\n未论鸡犬孤城寂，绕树霜乌不夜啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋饮姚氏园亭","author":"叶春及","text":"名园佳节到柴扃，词客开筵集草亭。\n碧海月从今夕好，清秋人似旧年经。\n病逢金谷还杯盏，夜转银河落户庭。\n何事羽衣蟾阙上，桂团风露正泠泠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"龙山为交埤郑君赋","author":"叶春及","text":"交埤叠嶂来天地，蜒蜿龙蟠郑谷隅。\n石窦云生时作雨，海门月出夜明珠。\n风摇老桧苍鳞动，日照平田锦翼敷。\n高帽山人两蓬鬓，重阳怀古几踟蹰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿李长史","author":"叶春及","text":"董相还家绿满园，何如白首向王门。\n下帷自草春秋传，入室时窥道德言。\n战胜西湖鸦作鬓，寿称北海蚁盈尊。\n青牛紫气从来盛，况复翩翩李耳孙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题节孝卷","author":"叶春及","text":"穴中不共红颜老，堂北无如白发何。\n孤燕春来前缕在，双鱼朝进玉盘多。\n溯流舍侧泉还涌，化石江边水自波。\n彤管青编非忝窃，霍山南海郁嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惠安有三岐麦六岐稷士民赋诗赠奉答 其一","author":"叶春及","text":"几回春雨祝年丰，共说三岐陇麦同。\n千载惭吾非汉吏，七闽斯地有唐风。\n人家废井黄巾后，海岸飞沙白苇中。\n击壤自须歌帝力，满车谁敢窃天功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"惠安有三岐麦六岐稷士民赋诗赠奉答 其二","author":"叶春及","text":"敢拟河阳麦两岐，东郊嘉稷转堪疑。\n干戈闽海初宁日，水旱东南洒泪时。\n词客有情歌盛美，长安无计起疮痍。\n年来疾病思田里，惭愧河间稼猎诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题观罗台","author":"叶春及","text":"为爱罗浮四百峰，筑台江上看芙蓉。\n青苔坐扫蛟龙动，白发游怜鹤鹿从。\n云起锦屏开绝壁，雨晴素练挂疏松。\n问余石洞幽栖处，东望巑岏第几重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉送岭西王公参政湖南 其一","author":"叶春及","text":"攀车夹道走群黎，揽辔重清粤岭西。\n虎踞深山藜不采，雉飞平野麦初齐。\n藩分江汉雄三楚，笛奏烟云散五溪。\n南顾即今纾圣主，禁城春早听霜蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉送岭西王公参政湖南 其二","author":"叶春及","text":"右丞诗画右军书，家学中朝尽不如。\n彩服入门椿偃蹇，紫微分省树扶疏。\n武昌月朗延参佐，云梦天寒赋子虚。\n为政风流谁得似，洞庭清映使君车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"奉送岭西王公参政湖南 其三","author":"叶春及","text":"蒲柳空嗟犬马年，祇应松柏晚犹妍。\n漫劳一郡推麟笔，岂有三长过马迁。\n藻井夜登穿海月，桂林秋泛澹江烟。\n论文后会知何地，遥望清光北斗边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送丘南安还海康","author":"叶春及","text":"风尘先我解牛刀，万里冥鸿一羽毛。\n谁信五溪多瘴疠，古来三峡壮波涛。\n中原北望浮云尽，函谷西还紫气高。\n春雨海门寻旧隐，折腰应啸尚儿曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题江秀才莲花草庐","author":"叶春及","text":"严城东下敞书台，重镇身曾辟草莱。\n倚杖潮声三岛接，捲帘山色五公来。\n青云高并芙蓉湿，落日遥从睥睨回。\n四壁萧条君自爱，汉王元羡长卿才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫题柬徐弼卿张仲矩二国子陈巽卿洪子崇江惟城三茂才","author":"叶春及","text":"闻道中山有箧书，太行风雨复何如。\n青春愧我鸣琴后，明月投人按剑馀。\n日落阴崖窥罔两，时危沧海满樵渔。\n凌云彩笔谁无羡，早晚君王问子虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"詹侍御游匡庐折肱不果诗以讯之","author":"叶春及","text":"闻君名籍系沧洲，杖策寻仙不可留。\n九派春愁连楚泽，五峰清梦满江州。\n题诗忽动烟霞色，伏枕俄惊日月流。\n望气自怜关令尹，何时函谷度青牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮洪子崇宅率尔赋赠","author":"叶春及","text":"高堂华烛坐更阑，节序逢秋暑欲残。\n已见洪厓多道气，更怜叶县有神丹。\n金银宫阙三山迥，名利风尘两鬓斑。\n搔首望君霄汉上，铁桥夜夜梦中还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋登大武山 其一","author":"叶春及","text":"大武高盘海上浮，登临凉气满浯州。\n乘槎漫忆三秋客，濯足遥从万里流。\n地拆南溟稀过雁，天回绝壁倚牵牛。\n潮声夜落云霞净，缥缈犹疑到十洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋登大武山 其二","author":"叶春及","text":"海上芙蓉万仞开，翠含飞阁亦奇哉。\n檐前日抱扶桑上，树杪风吹碣石来。\n哀壑莫云看倚剑，高秋落叶伴登台。\n东南天柱雄今古，安得楼船下濑才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"清海台送陈山人入京得山字","author":"叶春及","text":"旧游词客又燕关，岁莫逢君一解颜。\n把酒高台县落日，题诗寒色满苍山。\n黄金宫阙行看近，白发风尘且未还。\n天上故人如见问，将携妻子鹿门间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚发临清","author":"叶春及","text":"风起蒹葭船自开，树杪孤城返照来。\n倒影楼台虚径度，鸣锣舟楫晚须催。\n鸥凫鼓柁还汀芷，河岳流云落酒杯。\n顾眄未论扶药饵，古今踪迹本蒿莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"茆屋落成詶韩甥寅仲","author":"叶春及","text":"大成庙西苏祠东，我有一宅生蒿蓬。\n茅茨过雨春不恶，火树倚槛秋能红。\n开径只合来二仲，灌园岂为辞三公。\n馆甥堂竹涓涓净，坦腹赋诗霜叶中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄和太保兄弟紫燕","author":"叶春及","text":"汝家兄弟迥无伦，毛骨森森似凤群。\n紫燕诗成还寄我，黄龙洞口更思君。\n巢当画栋逢秋色，日向青天带暮云。\n海北海南惟有路，莫将幽思问鸿钧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠真空上人","author":"叶春及","text":"袈裟共泛真何意，苦行空门似汝贤。\n蓟北传灯冰雪里，岭南持钵瘴云边。\n渊明酒伴惟须菊，慧远禅心只种莲。\n今古茫茫不胜思，江干无语草芊芊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画赠方伯滕公 其一 题嘉树长吟","author":"叶春及","text":"微垣花隐刺桐深，公暇时为抱膝吟。\n一曲瑶琴春万里，不知棠树旧成阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画赠方伯滕公 其二 题紫云高卧","author":"叶春及","text":"粤台云气郁苍苍，人在华胥白日长。\n不独南窗堪寄傲，曲肱随处是羲皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郑生学医从海上军索赠赋此","author":"叶春及","text":"为问安期枣有无，片帆南海静天吴。\n酬恩到处逢知己，夜夜双龙匣里呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张伯珍赴京 其一","author":"叶春及","text":"贾勇休誇六郡雄，提戈东望绿林空。\n可怜诸将封侯尽，白马青袍向北风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张伯珍赴京 其二","author":"叶春及","text":"百战曾经七尺躯，先登亲夺绣蝥弧。\n知君不用尚书贵，夜夜青天泣灌夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"答吕文在","author":"叶春及","text":"雨送飞觞待两姬，巴歌新制竹枝词。\n天风吹落霓裳曲，梦里相逢怨别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13826,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠玉娥 其一","author":"叶春及","text":"涉涧登台鬓半松，玉娥相对玉娥峰。\n千杯劝尽不知醉，手挹飞泉入酒钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13827,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠玉娥 其二","author":"叶春及","text":"泉声虢虢石粼粼，罗袜凌波不动尘。\n借问仙家谁得似，黍珠宫里鲍夫人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13828,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠玉娥 其三","author":"叶春及","text":"千峰斜日一枰残，月上霓裳驾鹤还。\n尔自姓王人不识，他年应比烂柯山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13829,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代玉娥答 其一","author":"叶春及","text":"妾本巫山山下女，朝朝暮暮在阳台。\n可怜遗履轩前月，长照飞凫海上来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13830,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代玉娥答 其二","author":"叶春及","text":"飞泉直下几千寻，洒落云山紫翠深。\n采得山花羞妾面，汲将泉水比侬心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13831,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代玉娥答 其三","author":"叶春及","text":"醉归忘却玉搔头，藤蔓牵衣碧涧流。\n流到门前尚呜咽，松风萝月两悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13832,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得海不扬波赠张将军 其一","author":"叶春及","text":"大舶乘风马不如，孤城落日莽萧疏。\n即今空水天连碧，买酒将船问白榆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13833,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得海不扬波赠张将军 其二","author":"叶春及","text":"积水澄波静不流，两星相对镜中浮。\n灵槎岁岁天边下，共指寻源博望侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13834,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得海不扬波赠张将军 其三","author":"叶春及","text":"大星小星坠海中，海鲸东去水涵空。\n楼头戍卒浑无事，到处投竿学钓翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13835,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋得海不扬波赠张将军 其四","author":"叶春及","text":"将军白马紫虬髯，海上青山万点尖。\n夜半高堂罢歌舞，高高山月照疏帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13836,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘去华侍御还朝去华在粤著书名百六书成而召故次首及之 其一","author":"叶春及","text":"南迁客舍寄桄榔，五岭今传五月霜。\n自是主恩深雨露，肯令韩愈到潮阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13837,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘去华侍御还朝去华在粤著书名百六书成而召故次首及之 其二","author":"叶春及","text":"独树空庭对著书，书成驰传起相如。\n名山石室非无地，紫气红光看斗墟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13838,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘去华侍御还朝去华在粤著书名百六书成而召故次首及之 其三","author":"叶春及","text":"蒲叶青青榴子红，还朝人识五花骢。\n遥知宣室将前席，一一风谣达九重。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13839,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘去华侍御还朝去华在粤著书名百六书成而召故次首及之 其四","author":"叶春及","text":"独抱瑶琴久不弹，为君一曲再三叹。\n从天玄鹤兼云下，便欲因之寄羽翰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13840,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与梁思立谭永明饮韦纯显宅 其一","author":"叶春及","text":"庭月婵娟出海楼，庭前贳酒鹔鹴裘。\n相逢那得还辞醉，二十论交今白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13841,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与梁思立谭永明饮韦纯显宅 其二","author":"叶春及","text":"酒人燕市共谭生，偕计梁韦弟与兄。\n命驾岂难千里至，今人徒见古人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13842,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与梁思立谭永明饮韦纯显宅 其三","author":"叶春及","text":"海上高悬碣石宫，谈天稷下竞称雄。\n君看莫逆者四子，满目青山一笑中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13843,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太和道士李理雄余字之守雌丏诗赠以绝句","author":"叶春及","text":"蚤向名山学息机，焚香长掩白云扉。\n雄心一片降应尽，肯逐杨花作雪飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13844,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"太和道士王思明从登紫霄峰问其泉对曰上善即老子若水者也字之子静号以若水丏诗赠之","author":"叶春及","text":"一蒲青草自年年，万叠苍山对夕烟。\n静后观心如止水，高高明月在中天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":13845,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]