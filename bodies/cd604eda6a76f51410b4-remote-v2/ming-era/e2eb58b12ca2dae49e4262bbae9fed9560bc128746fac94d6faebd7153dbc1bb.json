[{"title":"竹鹤为何太守澄作","author":"曹义","text":"森森万木荫檐楹，老鹤归来趣更清。\n晴翠晓凝朱顶湿，清阴凉拂雪毛轻。\n雨馀苔砌频留迹，月到芸窗讶听声。\n爱尔轻中潇洒客，几回吟对独含情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄门给事中李公继白予邻邑友也兹拜命知永州府事将行愧无以赠聊述五十六字送之非敢言诗庸以识别云","author":"曹义","text":"黄门簪笔几多年，太守新除宠命偏。\n象简晓辞青琐闼，朱衣香惹御炉烟。\n一尊斜日都亭酒，千里东风汉水船。\n明到好施和易政，循良有传颂蒲鞭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送何知府澄之袁州","author":"曹义","text":"鬓发萧萧间二毛，老年尤得拜官高。\n远离粉署辞丹陛，脱却青衫换锦袍。\n千里编珉资抚字，一方士俗赖甄陶。\n从来五马诸侯贵，皂盖朱轓属俊髦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王司训粹之清水朱德润之徒也","author":"曹义","text":"晓棒除书下九天，冰姿玉质正青年。\n马嘶紫陌东风外，酒尽红亭夕照边。\n云树苍茫连汉苑，关山迢递接秦川。\n从今饯别都门道，后夜相思月满天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送倪东明归茅山","author":"曹义","text":"青年襟度雪冰清，一夕飞凫到玉京。\n霞帔晓趍鹓鹭序，丹衷深荷圣皇情。\n旆回驿路秋风早，凉入关河暑雨晴。\n遥想华阳归到日，烧丹炼药学长生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽涑水令吴文昌","author":"曹义","text":"鸣琴花县几经年，一梦黄梁隔九泉。\n三径独存元亮菊，日年谁棹剡溪船。\n云迷远汉悲辽鹤，春去空山哭杜鹃。\n惟有棠阴遗爱在，碑铭会见后人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕赐观灯诗 其一","author":"曹义","text":"皇都春暖雪初晴，节遇元宵月倍明。\n万井笙歌闻禁苑，九重灯烛■蓬瀛。\n金吾禁弛恩波阔，紫陌香飘罗绮轻。\n时值太和多气象，臣民无处不欢情。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕赐观灯诗 其二","author":"曹义","text":"神山鳌载栱銮坡，宝炬花灯万树罗。\n禁漏不闻知夜□，天颜有喜觉春和。\n半空嘹亮鸣仙乐，百辟趍锵响?珂。\n共喜时清逢令节，尧阶争唱太平歌。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元夕赐观灯诗 其三","author":"曹义","text":"九重此夜放花灯，朝野熙熙乐太平。\n云接鳌峰千嶂迥，春生苔径落花斑。\n丹成药灶呼猿守，礼罢茅君伴鹤还。\n自古华阳多胜槩，烟霞泉石足怡颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题北堂卷","author":"曹义","text":"幽轩重构北溪湾，云锁衡门白昼閒。\n点易晓研花上露，推窗时看雨中山。\n捲帘树色侵书幌，绕屋泉声响佩环。\n燕处超然多雅趣，客来尊酒共怡颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王先赴古田","author":"曹义","text":"天涯久客未能归，送别都亭兴欲飞。\n鲁酒一尊江上醉，闽山数点望中微。\n晴云冉冉随征棹，凉雨霏霏洒葛衣。\n明到家山逢故旧，为言母怪寄书稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人之肇州","author":"曹义","text":"奏最才看觐玉京，南还又喜沐恩荣。\n马嘶官道槐风爽，棹过通津暑雨晴。\n万里瘴云连象郡，一江烟浪接羊城。\n行旌明到香山下，竹马悬知次第迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈同知克让同学友也","author":"曹义","text":"恩命朝承下日边，西风重上潞河船。\n行旌晓拂林梢露，短棹晴冲渡口烟。\n远汉清秋寒雁度，孤亭斜日酒旗悬。\n应知别去关山远，后夜相思月满天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送严都指挥归宁夏","author":"曹义","text":"扈跸平湖污马劳，凯还今喜脱征袍。\n九重论赏恩偏厚，万里安边策最高。\n枫陛辞时锵玉佩，柳营归去拥旌旄。\n太平从此峰烟息，公暇无忘讲六韬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"花萼轩","author":"曹义","text":"爱弟清时拜好官，难兄千里问平安。\n蓟门一见生春色，姜被同眠耐夜寒。\n池草梦回吟兴逸，乡情谈罢客怀宽。\n念均□□多和乐，荆树花开应共看。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送史州判彬赴云南赵州","author":"曹义","text":"除书晓捧下云霄，路入滇池万里遥。\n花县夙闻弦诵美，枫宸新沐宠恩饶。\n蓟门春色随行骑，杨子潮声送去桡。\n别后莫言边徼远，他时还拟听箫韶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送桃源尹知县","author":"曹义","text":"几年清誉达京畿，又喜还官出禁闱。\n路指淮南烟树迥，马嘶蓟北晚风微。\n一声秋雁随云渡，半幅征帆带雨飞。\n遥想桃源重到日，桑麻依旧蔼春晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽诗","author":"曹义","text":"八十年高雪满簪，一生泉石半清吟。\n开轩爱种篱边菊，适兴时弹膝上琴。\n辽海鹤归春梦远，楚山猿断暮云深。\n昨来游子闻哀讣，泣对斜阳戻湿襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"半村江西一诗人手卷","author":"曹义","text":"林下茅堂傍水堤，半村佳境足堪题。\n一帘山色当门断，几树莺声隔岸啼。\n囲犊暮归分远近，樵苏晓出自东西。\n幽人乐此多清趣，几度行吟不过溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过济宁登郊閒步","author":"曹义","text":"独步平原望眼赊，烟村几处有人家。\n青山茆屋疏篱短，绿柳溪桥小径斜。\n春暖桑榆含宿雨，晚晴鸥鹭浴平沙。\n吟边无限韶华好，助我诗人兴味嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和郑雍言上巳日游庆寿寺诗韵","author":"曹义","text":"宿雨初收三月天，胜游兰若意留连。\n谩从脩禊盟诗社，未拟逃禅结佛缘。\n檐卜花含林下露，黄鹂啼断树头烟。\n也知不是山阴道，风景浑如曲水边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送性初南还兼简诸故旧","author":"曹义","text":"腊日都门雪未消，送君南去路迢迢。\n马蹄晓踏卢沟月，帆势春过白下桥。\n清夜韩檠怜独对，异乡郢曲向谁调。\n金陵故旧如相问，为说新承雨露饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送同年田进士","author":"曹义","text":"多君才思冠群英，器宇昂昂属老成。\n十载鸡窗听夜雨，一朝虎榜掇香名。\n归舟载断江南梦，别酒斟残蓟北情。\n分手官亭休缱绻，拟看重会凤凰城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄家因东西南北四韵就寓怀 其一","author":"曹义","text":"朝回散步二桥东，吟就新诗兴不穷。\n雁度暮云归远浦，鸦翻落日噪西风。\n戍楼突兀青天外，宫殿嵯峨紫禁中。\n自是上林秋色好，几多霜树晚酣红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄家因东西南北四韵就寓怀 其二","author":"曹义","text":"朝回散步二桥西，景物苍凉望眼迷。\n疏树淡烟延日暮，危楼叠嶂接天齐。\n囊空客久归心切，衣薄天寒旅况悽。\n幸有一般心乐处，年来雁塔姓名题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄家因东西南北四韵就寓怀 其三","author":"曹义","text":"乡关迢递隔江南，雁足聊传书一缄。\n宠渥已从今日得，庭闱未料几时参。\n梦回五夜生乡思，目断二茅霭翠岚。\n说与亲□莫遥念，年来布褐换朝衫。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄家因东西南北四韵就寓怀 其四","author":"曹义","text":"退食闲行禁城北，平林惨淡无颜色。\n光阴荏苒秋又冬，乌兔循环朝复夕。\n上苑霜酣枫叶红，御沟月浸芦花白。\n归来默默掩重门，坐拥吟眉寒恻恻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和彭检讨显仁太液晴波韵","author":"曹义","text":"灵渊雨过浪纹微，旭日初升荡碧晖。\n烟景苍茫涵玉宇，波光潋滟映彤闱。\n衔萍白鸟时来往，戏水青凫煖不飞。\n记得当年临胜境，几随仙驭日斜归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赐为善阴骘书","author":"曹义","text":"昭代崇文礼乐彰，新颁宝训荷恩光。\n纶音涣汗风雷动，宸翰淋漓雨露香。\n总谓圣明宏制度，宁知帝德焕文章。\n周诗虞史堪媲美，世道应同日月长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送人归江西","author":"曹义","text":"旅食鲸川十载馀，春风一旦赋归欤。\n溪烟深锁江头柳，细雨斜侵担上书。\n野店鸡声催去马，官亭草色逐征车。\n故园自是风光好，松菊青青绕旧庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张思安佥宪湖广","author":"曹义","text":"封章交荐荷恩荣，共羡才华属老成。\n蓟阙喜持新宪节，荆湖重振旧威名。\n洞庭春到波涛息，衡岳云开瘴疠清。\n遥想青骢行乐处，几看黄鹤畅吟情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夜诗乡先生樊浩翁所作时宣德八年秋乡人医者钱宗浩诵于蓟北小楼因笔之戏和不免续貂之诮原倡","author":"曹义","text":"帘捲西风豆雨乾，蟾光摇动碧云端。\n仲间总是清虚府，天上谁楷白玉盘。\n江净雁拖云影瘦，楼高人立桂香寒。\n归来醉罢霓裳杳，露下天高夜巳阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和前韵","author":"曹义","text":"雨歇楼台湿未乾，一轮明月出云端。\n总誇素女开妆镜，谁识仙家露玉盘。\n影落金樽清醑滟，光摇银汉露华寒。\n年年此夜偏堪赏，听彻更筹兴未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送阳医官回南康县","author":"曹义","text":"轩岐术业世相传，荐剡春膺上九天。\n指下明分三部脉，囊中不贮一文钱。\n拜官北阙初承命，返旆南安独棹船。\n遥想乡园明到日，人人争羡锦衣旋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王文显复任","author":"曹义","text":"武清赤县近京华，抚字循良众所誇。\n芹泮夜深闻读诵，花封春暖茂桑麻。\n奏功得最天恩重，振旆回辕客路赊。\n明到正逢残腊节，狱囚应有听还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32355,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"景星","author":"曹义","text":"秋半璇霄现景星，天开泰运应休祯。\n晴光伴月辉云汉，皓彩呈祥烛太清。\n众目共瞻当午夜，万年纪瑞属时平。\n微臣何幸逢灵贶，敬作诗歌颂圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32356,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送章主簿之江宁侍郎尚文之兄也","author":"曹义","text":"青杨树底喜为邻，尊酒清谈几度春。\n诗句远宗唐律度，襟怀不减晋时人。\n一官禁阙初承命，千里关河独问津。\n晓日都亭相别处，马蹄愁踏落花尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32357,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邵通判之苏州","author":"曹义","text":"奏功秋晓上蓬莱，得最多誇治剧材。\n宫漏断时辞玉阙，骅骝嘶处出金台。\n麾旌远向吴门去，民庶欢迎召父回。\n到□寄声黄太守，交游浑不附书来。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32358,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送温知县复任","author":"曹义","text":"抚字才高众所誇，香名异政播京华。\n春深麦陇飞驯雉，昼静公庭看落花。\n百里桑麻涵雨露，几村弦诵接人家。\n年来报政膺殊渥，归拥双旌客路赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32359,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"积善堂","author":"曹义","text":"一门种德几经年，清白家声远近传。\n奕世流芳簪绂盛，诗书遗教子孙贤。\n秋风不剪临轩桂，春雨多耕负郭田。\n华扁高堂标积善，会看瓜瓞更绵绵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32360,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄金台祖饯送吏部孔员外回杭","author":"曹义","text":"送人南归载醁醅，黄金台畔暂徘徊。\n停杯试问当年事，此地曾招俊异材。\n柳外骅骝怜独去，花前弦管谩相催。\n老年共喜膺褒宠，?醉东风缓辔回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32361,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送金令尹仲经之平乡","author":"曹义","text":"尊酒相违逾十载，俄惊飞舄到金銮。\n共怜华发添双鬓，独喜清廉守一官。\n绩奏九重名姓显，化行百里吏民安。\n秪今膺最平乡去，忍向离亭醉晓寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32362,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽锦衣卫指挥李效良母夫人","author":"曹义","text":"秋深霜殒北堂萱，肠断孤儿痛莫言。\n香箧独看九胆在，寒窗空见断机存。\n遥天月冷悲辽鹤，岭海风高哭夜猿。\n懿德褒封欣有诰，恩光千古贲丘原。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32363,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽吏部张员外父","author":"曹义","text":"一生萧散乐林泉，凤敕褒封喜暮年。\n秋圃几看黄菊纵，午窗常对白云眠。\n花前忽弃游山屐，江上空遗载酒船。\n惆怅荒郊埋玉处，亭亭落日照新阡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32364,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"爱萱为林编脩赋","author":"曹义","text":"堂北幽萱晚自荣，相看几度独怡情。\n黄花浥露香偏远，翠叶含烟色更清。\n綵服戏时晴影动，板舆行处绿阴生。\n知君天性从来孝，寸草常怀爱日诚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32365,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钱郎中济民赴金陵","author":"曹义","text":"颂台迁秩向南还，玉佩晨摇别圣颜。\n行李半挑辞凤阙，征帆几日到龙湾。\n红亭人散青山晚，粉署香飘白昼闲。\n遥想吟馀应有忆，清霄飞梦绕仙班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32366,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽朱员外松江人","author":"曹义","text":"南宫拜秩羡才优，北阙承恩出帝州。\n沧海半年持使节，黄梁一梦竟仙游。\n霜寒鹤唳辽天月，风冷猿啼楚树秋。\n旅衬悬知归到日，孤儿肠断不胜愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32367,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和月泉咏金山寺诗韵四首 其一","author":"曹义","text":"中流屹立一孤峰，天设原非禹凿功。\n岩洞玲珑空翠滴，楼台高下瑞烟笼。\n翻经老衲白云里，听法神蛟碧浪中。\n记得当年临绝顶，恍疑身在水晶宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32368,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和月泉咏金山寺诗韵四首 其二","author":"曹义","text":"一山四面水云高，胜境从来夐不同。\n千古鸡园峰顶上，万年鳌极浪花中。\n海门月上初钟动，渡口僧归晚棹通。\n半点红尘飞不到，禅房花木自春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32369,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和月泉咏金山寺诗韵四首 其三","author":"曹义","text":"宝地雄蟠江渚中，巍峨楼阁势凌空。\n八窗云气连青嶂，四面波光荡绮栊。\n游览杳无车马到，登临须仗客舟通。\n中流砥柱成千古，浩劫茫茫岂有穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32370,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和月泉咏金山寺诗韵四首 其四","author":"曹义","text":"梵刹金山莽苍中，长江四面水涵空。\n玄厓琼岛霏空翠，雾阁云窗湿绛栊。\n蜃气晓凝禅榻润，鲸涛晴涨海潮通。\n惭予未遂寻幽兴，赓罢新诗恨不穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32371,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"君子轩为宋先生作绍兴人成国公书扁","author":"曹义","text":"庭前脩竹晚苍苍，庭下丛兰带露芳。\n暗度清香来枕席，晴分翠影落琴床。\n湘江雨暝吟情迥，楚畹春深客梦长。\n爱尔轩中人似玉，应知相对兴难忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32372,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送医官致仕归金华为邵郎中正赋","author":"曹义","text":"悬壶随处著芳名，共说才华过宋清。\n施药不分贫与富，酬金肯计重和轻。\n少年效职勤王事，垂老投簪荷宠荣。\n明到应知存旧业，烧丹采木学长生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32373,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送达先生之新淦","author":"曹义","text":"美秩新迁出帝州，凉生白苧值初秋。\n黄花白酒离亭兴，画鹢牙樯淦水舟。\n送晚蝉声随树噪，横空雁影逐波流。\n悬知经过金陵日，应有门生为挽留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32374,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送外甥为于中书沛作","author":"曹义","text":"几年不到渭阳城，一见春容满面生。\n宾馆正连徐孺榻，莼鲈忽动季鹰情。\n官亭别处频斟酒，客路行时独计程。\n明日故乡逢故旧，平安为我报家声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32375,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王仲章归乡时均辅在北","author":"曹义","text":"琴书收拾促归期，正值严冬雪后时。\n月冷关城鸡唱早，霜寒驿路马行迟。\n心悬蓟北思严训，梦入江南念母慈。\n此去鹏程知有日，莫同斥鴳困藩篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32376,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送指挥归绥德为赵编脩作其家忠孝","author":"曹义","text":"虎头燕颔一将军，忠孝家传远近闻。\n马上锦衣明晓日，腰间宝剑动星文。\n鹗书交荐新恩宠，鸾诰褒封旧烈勋。\n遥想麾旌明到日，狼烟不起绝妖氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32377,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送连脩撰归闽焚黄","author":"曹义","text":"晓辞金阙出神州，此去分明是昼游。\n红荔丹山闽海兴，锦衣兰棹潞河舟。\n凉生驿路消残暑，鹰度关山属早秋。\n悬想焚黄先垄日，恩随春色上松楸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32378,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送祠祭胡郎中添麒归田","author":"曹义","text":"黄甲同登二十年，鹓班每共早朝天。\n忽惊解组旋行旆，那忍分襟对别筵。\n客路西风飘冻雪，关城落木锁寒烟。\n到家旧业知何处，书屋依然枕石田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32379,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邢编脩弟","author":"曹义","text":"一门双壁世应稀，客里相逢叹别违。\n雁渚风寒怜独宿，鸰原雨霁叹分飞。\n几程驿路迷春草，半束琴书带夕晖。\n归到故乡如有问，难兄常日侍彤闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32380,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送冯智安太守之绍兴","author":"曹义","text":"英年粉署擅才名，郡守新除荷宠荣。\n环佩未辞青锁闼，欢声先动越王城。\n云开秦望山增翠，霜落曹娥江倍清。\n自古循良多有传，伫听歌颂达神京。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32381,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送袭职指挥","author":"曹义","text":"先世多知懋烈勋，清时封爵及闻孙。\n远趍北阙承恩宠，归去南滇对酒尊。\n客散蓟门分别袂，路经巫峡听啼猿。\n柳营明到应无事，豹略龙韬足讨论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":32382,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]