[{"title":"和许黄门九日述怀","author":"石宝","text":"往日看花兴，中年苦太迟。\n静开平世眼，閒对廪秋时。\n风雨催枯干，江山得几诗。\n因怀工部句，濒老释欢悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16162,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出西郊","author":"石宝","text":"久积丘园思，春深始出城。\n水添幽涧满，花发旧枝明。\n野哭闻修祭，田炊见饷耕。\n年光随眼过，几度得閒行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16163,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"故关道中","author":"石宝","text":"晓望榆关道，肩舆坐未安。\n石墙多五色，山径忽千盘。\n松柏何年树，风尘旧日冠。\n半岩有兰若，试上白云看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16164,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜起","author":"石宝","text":"鼓柝清溪夜，张帆待晓风。\n月中鸡唱早，天下犬声同。\n暂住能留迹，重来欲作翁。\n年华等流水，回首语篙工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16165,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"偶书二首 其一","author":"石宝","text":"紫阁金闺吏，秾桃郁李年。\n鸣钟朝进食，撤幄昼分筵。\n祸浅方深念，时危未稳眠。\n裂冠如可忍，寒暖付青天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16166,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"偶书二首 其二","author":"石宝","text":"笼鸟曾矜宠，阑花大逞姿。\n不因风雨夕，那识艳阳时。\n万卷将焉用，扁舟尚可为。\n从今持史论，应悔过崇卑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16167,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过清流桥北望","author":"石宝","text":"江国春多雨，偶晴图画开。\n竹边朱户启，花下美人来。\n高柳藏歌榭，新莺过吹台。\n近郊山更好，苍紫竞崔嵬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16168,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚坐","author":"石宝","text":"春色晚何在，绿杨来数鸦。\n影单犹作客，梦好转思家。\n风雨床头剑，笙歌上苑花。\n百年空健兴，惆怅日西斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16169,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"午坐","author":"石宝","text":"松韵洒寒发，清风销积怀。\n似难芟恶草，无可障狂霾。\n湖海书频滞，山林愿未谐。\n知音不相待，明月满秦淮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16170,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日寄孟贤","author":"石宝","text":"秋声惊短鬓，忽忽过中元。\n荷冷红初褪，林幽绿尚繁。\n归心梁上燕，客梦槛中猿。\n不得张公子，同来倒玉尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16171,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"宫词","author":"石宝","text":"水殿荷风软，云车草露新。\n帘垂三峡雨，香散六宫春。\n青雀黄龙舳，朱衣画裤人。\n君王浑未厌，歌吹已经旬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16172,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬夜","author":"石宝","text":"夜坐无他事，危居拥布袍。\n断编翻竹简，残火爇松膏。\n寒暑双车毂，生涯一羽毛。\n涓埃浑未报，素食愧吾曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16173,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"南庄书事","author":"石宝","text":"罢读离骚赋，悠然解独酲。\n苔痕石上绿，山色雨馀青。\n鹄立怀东观，鹏抟快北溟。\n残莺犹有意，閒向柳边听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16174,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送赵鸿胪省兄","author":"石宝","text":"春草旧多情，西风别恨生。\n高吟动池水，清梦落江城。\n密线秋辞母，崇冈晓望兄。\n鹏飞聊一息，回首又云程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16175,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送人","author":"石宝","text":"彩鹢乘风顺，名山过几州。\n地形多北共，天汉自西流。\n冠履三千客，琼瑶十二楼。\n忆归江海上，应述太平讴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16176,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"移居长安门西安福巷","author":"石宝","text":"谁言广陌好，陋巷亦清幽。\n夜月春长满，晴云昼不收。\n宫中闻报漏，门外度鸣驺。\n时复乘间兴，凭轩望五楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16177,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"道院","author":"石宝","text":"山中逢道士，尊酒坐逍遥。\n草色连天绿，云香入幔飘。\n古潭龙夜语，紫府鹤晨朝。\n应有飞仙侣，倚楼吹玉箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16178,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送别","author":"石宝","text":"我送霜台使，还歌白雪篇。\n微名曾附骥，奇骨自飞鸢。\n梦切云霄上，情忘水石边。\n临风舒一啸，惊断夕阳蝉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16179,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜晴","author":"石宝","text":"几日多风雨，新晴乍可怜。\n青山当屋角，白鸟到花前。\n扫榻袪尘梦，挥毫著短篇。\n不须登汉阁，有思欲凌烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16180,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早朝二首 其一","author":"石宝","text":"南风霏早露，筦簟觉微涵。\n宫漏犹传五，邻鸡已报三。\n冠从灯下正，笔忆殿头簪。\n跨马看城阙，彤云晓正酣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16181,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"早朝二首 其二","author":"石宝","text":"散步瑶台侧，东方尚渺茫。\n御沟惊佩落，宫雾著衣凉。\n上将金装甲，台臣皂作囊。\n景阳钟未尽，天语彻檐廊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16182,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"灯花","author":"石宝","text":"谁道春光薄，寒灯亦放花。\n粟金装宝树，文火伏丹砂。\n千里长为客，三年不见家。\n明朝有乡信，遥寄自天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16183,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"开户见残月","author":"石宝","text":"开户见残月，雕弓已下弦。\n蛾眉窥浅水，玉玦在青天。\n近寺闻清磬，趋朝握短鞭。\n不因钟鼓急，春晓正高眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16184,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"代夏先生题风木卷","author":"石宝","text":"西风吹拱木，哽咽不成音。\n树古疑翻海，人亡莫问琴。\n泪明原畔草，魂黑雨中林。\n日暮啼鸦急，应怜孝子心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16185,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"恭承诰封母赵为恭人进四品秩从家君贵也喜而有作二首 其一","author":"石宝","text":"乳乌思反哺，荏苒一春无。\n圣主推人子，重封视大夫。\n黄金新束带，翠羽旧明珠。\n未得承颜色，徘徊立送途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16186,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"恭承诰封母赵为恭人进四品秩从家君贵也喜而有作二首 其二","author":"石宝","text":"吾翁推宪法，二十五年来。\n直矢何曾曲，高槐每自栽。\n儿曹思养色，家国愧非才。\n徒藉君王宠，殷勤效老莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16187,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"冬至前二日赴朝天宫习仪","author":"石宝","text":"罢朝还走马，紫府亦丹墀。\n地拥神仙迹，人谙博士仪。\n角声鸣夜月，旗影挂朝曦。\n莫辨黄钟律，寒灰已自知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16188,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西山","author":"石宝","text":"莫道山行乐，山行愁更深。\n扰龙僧坐钵，飞燕女横金。\n酒著莓苔醉，情熏草树阴。\n夕阳人语静，无处觅巢禽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16189,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"长门怨","author":"石宝","text":"闭妾深宫里，宫门知几重。\n君恩如白日，妾命自寒蛩。\n月落银河澹，天高玉露浓。\n一般秋枕上，听得景阳钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16190,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜","author":"石宝","text":"徙倚西风外，秋声满凤池。\n何堪砧杵夜，又在月明时。\n病叶辞柯响，寒桐转漏迟。\n起看三尺剑，悲壮两难持。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16191,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"午梦","author":"石宝","text":"枕上行千里，危楼望欲登。\n有时生两翼，飞到最高层。\n栩栩随园蝶，悠悠访寺僧。\n白云看未了，莺语落青绫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16192,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过山寺","author":"石宝","text":"百里见高峰，山僧出寺逢。\n老松栖倦鹤，幽霭度疏钟。\n野阔饶风露，岩深无夏冬。\n不知天已暮，归骑尚从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16193,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送叶守","author":"石宝","text":"紫衣高盖客，谁复叹升沉。\n万里图南翼，平生拱北心。\n麦岐看入颂，牛角遇知音。\n他日檐廊上，凭君作傅霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16194,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西湖","author":"石宝","text":"城中稀暇日，取适过林泉。\n古寺排金榜，离宫枕玉泉。\n折花聊映醉，藉草亦成眠。\n不学王孙呕，平心过百年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16195,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"城北","author":"石宝","text":"怅望城东北，远风增客愁。\n生涯自流水，人世本虚舟。\n泪向清时堕，身当未老投。\n谁能齐万物，长啸忆庄周。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16196,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"哭贵闲女","author":"石宝","text":"何处能忘尔，纱窗睡起迟。\n古诗吟绝句，小学诵题辞。\n竹马朝随伴，?笙手自吹。\n有时端坐久，狼籍画双眉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16197,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过丘头寺故韩师院","author":"石宝","text":"古寺高僧去，荒林但鸟归。\n钟浮石潭月，苔满画廊衣。\n世事惊春梦，西风冷宦机。\n坐看秋叶下，惆怅昔人非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16198,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西港","author":"石宝","text":"高城舒一望，明月下银沙。\n草阁平临野，溪流半绕槎。\n树严秋尚茂，兰静晚宜花。\n不为寻真隐，谁能卧紫霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16199,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"风中花","author":"石宝","text":"春花有殊色，何事逐风流。\n欲堕还依水，频飞不过楼。\n托枝怜命薄，倾国使人愁。\n愿落帘栊里，遗香尚及秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16200,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"园中","author":"石宝","text":"思君不可见，三月正花飞。\n杨柳垂金缕，新苔胜舞衣。\n鸟来枝上语，人自水边归。\n尽日西南望，空山但落晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16201,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题都下主人壁","author":"石宝","text":"久出易春衣，田园苦未归。\n兴同花漫发，身与燕俱飞。\n古剑双明雪，残编几绝韦。\n金张虽可属，意不在光辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16202,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东昌荅郑侍御","author":"石宝","text":"劳君相问讯，别意正茫茫。\n鲁国风何古，吴山路更长。\n水平舟去稳，春暖雁飞忙。\n安得乘骢使，追随达建康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16203,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同陈宗之诸同年饮鸡鸣山凭虚閤时罗太常景鸣作倡二首 其一","author":"石宝","text":"细雨缘山到，清风待客来。\n阁凌霄汉起，门傍斗牛开。\n云树千家锦，豪华六代才。\n遗踪不可问，今古一衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16204,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同陈宗之诸同年饮鸡鸣山凭虚閤时罗太常景鸣作倡二首 其二","author":"石宝","text":"二月到金陵，秋山始一行。\n人间无此地，坐上得清卿。\n痛饮平生侣，高楼万古情。\n蓬莱在何处，缥缈暮闻笙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16205,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"咏御沟红叶","author":"石宝","text":"宫树悴清霜，泉声落建章。\n更无红叶字，犹是碧波光。\n气肃秋将老，人寒影太长。\n东流和宿恨，黯惨度年芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16206,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"得白宗伯先生书","author":"石宝","text":"北雁正南翔，书来自帝乡。\n人同秋色老，情比道涂长。\n礼乐归宗伯，文章忆大方。\n江湖无限意，延伫几斜阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16207,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋夜","author":"石宝","text":"曲槛散沉思，高斋瞻夜云。\n人闻河汉语，天示斗星文。\n有恨能销骨，无诗可赠君。\n溪风与岩露，悲哽若为分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16208,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨后奉忆家兄","author":"石宝","text":"小雪还逢雨，晴窗渐觉寒。\n南来风土异，北寄雁鱼难。\n晚稻垂霜穗，残荷捧露盘。\n塞门今夜月，禁冷立危栏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16209,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋兴","author":"石宝","text":"今年秋令早，白露已霏霏。\n巢久燕将别，草寒萤渐稀。\n多情惜亭柳，未老定渔矶。\n更与江湖伴，收荷为制衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16210,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"欲雨","author":"石宝","text":"菡萏风柔日又西，秋阴漠漠水鸦啼。\n池边别馆琴书润，云外层楼帘幕低。\n萤草不多新化火，蚁柯犹有未封泥。\n明朝欲上茅亭饮，多少诗情在绿溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16211,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻雁","author":"石宝","text":"独倚西楼送秋色，疏弦短笛亦凄清。\n书还白雁无多字，家隔青山更几程。\n急调南思洞庭水，断行高傍夕阳明。\n将身却顾鸡凫侣，不及随风一羽轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16212,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题清江捕鱼图","author":"石宝","text":"江上轻风吹短蓑，江边渔父动渔歌。\n漫将芳饵投湖渚，犹恐扁舟惊芰荷。\n凫鸭不妨随锦缆，鲂鲨须为掷金梭。\n濠梁真乐谁图画，坐觉滩声生素波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16213,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东阁奉试题长江万里图","author":"石宝","text":"谁将一带长江水，苦尽閒心画得成。\n万顷玻瓈千顷雪，吴峰烟雨楚峰晴。\n舟横赤壁浑无梦，潮到胥山觉有声。\n秖恐夜深明月下，有人乘兴欲骑鲸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16214,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和吴克温送弟还宜兴","author":"石宝","text":"夜来风雨忽思还，畏损临溪屋数间。\n兴发不烦张祖道，气豪真欲过名山。\n通宵虹采依然合，一路莺花未得閒。\n日暮鹓雏飞正疾，紫萱堂上一开颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16215,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秋日游城南张氏庄","author":"石宝","text":"斜日高城伤客怀，百年多暇此裴徊。\n燕山云树无今古，莺谷渔樵自往来。\n野水漾舟归远浦，老鵳窥兔上荒台。\n村翁惯记从前事，说罢潸然对酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16216,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送方石谢先生","author":"石宝","text":"搔首乾坤任达穷，高情谁复叹飘蓬。\n学传伊洛非无用，官比阳城更不同。\n直笔史宜留阁下，抱琴人已立堂中。\n分明六馆诸生力，夺我春来满坐风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16217,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春草","author":"石宝","text":"几夜东风入烧痕，塞垣南望接吴门。\n一川霭霭明残照，千里萋萋黯别魂。\n梦破池塘青乍晓，舞阑台榭绿犹温。\n汉宫多少芳菲地，何处偏涵雨露恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16218,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题阳和楼","author":"石宝","text":"南北襟喉此路岐，一方钲鼓控三陲。\n不妨楼观高千尺，剩为江山得几诗。\n平仲有才当锁钥，细侯无事下襜帷。\n登临几触先忧眼，廊庙江湖有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16219,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过尉佗先冢","author":"石宝","text":"高冢累累列道傍，尉佗南向越称王。\n功成七郡归西汉，事去千年留故乡。\n古树风烟巢鹳鹤，夕阳坡垄下牛羊。\n牧儿刍竖閒来往，一曲哀歌感孟尝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16220,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"望诸君墓","author":"石宝","text":"感慨重来吊望诸，一杯明水灌遗墟。\n昌黎好古心偏壮，诸葛谋王膝未舒。\n故国犹传下齐事，老儒空读报燕书。\n凭谁屈指当时士，多少纵横尽不如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16221,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"经九门城","author":"石宝","text":"废堞荒台故九门，千年汉县尚名存。\n陂陁势隐恒山脉，草树阴连董相原。\n陵变几传金盌出，土崩犹记铁车奔。\n惟应滹水波长绿，依旧渔舟下远村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16222,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谒王滹南先生祠","author":"石宝","text":"中原文献尽南车，独障颓波力有馀。\n金马已消天下望，碧山空带昔人居。\n心平陈寔能循物，头白扬雄尚著书。\n千古来寻高士躅，为公斜日几踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16223,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贞节四咏 其一 送终","author":"石宝","text":"遗言盈耳血盈颐，万里漂沦欲问谁。\n莒国恸声无地著，柏舟心事有天知。\n掩形不借偏衾足，抱子犹怜一死迟。\n遂使韶江芦荻岸，至今风雨泣孤雌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16224,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贞节四咏 其二 归柩","author":"石宝","text":"鹤驭鸾骖势已分，天南地北几劬勤。\n寸心出泪多成血，万死存孤欲露筋。\n有石未填东海水，无风可扫瘴乡云。\n片帆飘泊鱼龙窟，神鬼前呵世岂闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16225,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贞节四咏 其三 教子","author":"石宝","text":"冰霜啮尽齿将枯，不藉程婴为保孤。\n万里独归双白璧，半生惟听几慈乌。\n床头手泽书犹在，梦里风涛气未苏。\n见说亲教范滂传，有时扶杖更喑呜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16226,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"贞节四咏 其四 旌门","author":"石宝","text":"百年贞节被新旌，海若山灵恨始平。\n国士共高滂母义，路人犹指孟姜城。\n已无泪可斑湘竹，惟有心堪付史评。\n千古神游九泉下，照人肝胆正分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16227,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中山","author":"石宝","text":"西风故国水东流，野客经过雨乍收。\n塔影遥连官树渡，雁行多下靖王丘。\n春秋百战犹存地，唐宋诸贤半入州。\n阅古堂前今夜月，几人华发共先忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16228,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"翰林王公从之","author":"石宝","text":"捋须谁信虎纵横，一字千金有重轻。\n身为纲常还壁立，义形声色正霜明。\n赵人端不侵然诺，齐史曾何计死生。\n天为斯民应有意，尚留此老握机衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16229,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"处士安公敬仲","author":"石宝","text":"中州豪杰半朱轮，抱志如公有几人。\n道为续经头蚤白，诗成感兴语长真。\n封龙客散留书舍，滹水春深忆钓纶。\n千古精英游地下，定知高步接刘因。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":16230,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]