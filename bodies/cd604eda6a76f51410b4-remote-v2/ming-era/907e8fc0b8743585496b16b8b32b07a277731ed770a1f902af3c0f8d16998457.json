ror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13901,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"小仙寿意为魏二尹题","author":"谢迁","text":"王母西池启寿筵，群仙歌舞正喧阗。\n是谁来献蟠桃实，请问湖南吴小仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13902,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"葡萄为杨仲谨题","author":"谢迁","text":"瑶池秋蚤动凉风，吹落玄珠万颗同。\n拾取一枝聊把玩，只疑身在水晶宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13903,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题范以贞太守去思碑","author":"谢迁","text":"千里棠阴去后思，宛陵真续召南诗。\n流芳宁复需贞石，终古闾阎口似碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13904,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和罗峰郊坛一首","author":"谢迁","text":"万世承祧归圣哲，一时匡弼备公孤。\n嘉谟入告君无忝，尸素优游独愧吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13905,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又和罗峰郊坛一首","author":"谢迁","text":"路入青云凌紫阁，调高白雪擅骚坛。\n耄年何幸从公后，蹇步追趋更觉难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13906,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠眷弟陈一之之任南昌司训诗一首","author":"谢迁","text":"吏部传家羡太常，银台秋署倍增光。\n君今莫厌芹宫冷，一脉书香足绍芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13907,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"癣疮有感","author":"谢迁","text":"癣疮在告忆当时，问劳慇勤荷圣慈。\n畎亩老癃仍病癣，扪疮怀旧不胜悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13908,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"思母怀德二绝为孙芗作 其一","author":"谢迁","text":"乡塾髫年鼓箧游，倚门长抱涉波忧。\n石梁稳架慈闱杳，日日经行泪暗流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13909,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"思母怀德二绝为孙芗作 其二","author":"谢迁","text":"人羡孤甥亦肯堂，西溪宅相倍增光。\n当年造就伊谁力，白首铭心感渭阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13910,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初出城怀李西涯","author":"谢迁","text":"乞身归去荷温纶，当宁深仁念旧臣。\n犬马力疲徒恋主，金兰谊重更怀人。\n乡心已负青山久，客路真惭白发新。\n犹幸潞河冰未合，匆匆解䌫问前津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13911,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蚤发潞河柬何冬官","author":"谢迁","text":"千里乡心逐雁飞，晨光初动尚熹微。\n送迎深愧劳宾主，今昨何烦问是非。\n自在沙鸥眠岸迥，凋零霜叶挂林稀。\n十年京洛归来晚，犹喜淄尘未染衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13912,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟次晓起书所见","author":"谢迁","text":"清晓推篷满地霜，舟人呵手弄帆樯。\n孤村萧索炊烟鲜，高岸凌兢引䌫长。\n潦水带冰趋瀚海，寒云夹雾拥朝阳。\n平生忧国心仍在，回首神京一慨慷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13913,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与迥弟戏奕","author":"谢迁","text":"饱饭舟中漫奕棋，亏成何用置欣悲。\n平吴论协推枰日，破贼功轻折屐时。\n閒里纹楸供伴侣，老来驽马倦驱驰。\n旧时赌墅荒芜久，今日归来慰所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13914,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟中课儿诵习","author":"谢迁","text":"一经旧业本家传，盛世遭逢亦偶然。\n匡济已孤明主托，继承犹望后人贤。\n陶翁饮酒宁非达，杜甫吟诗祗自怜。\n分付尔曹勤努力，未来吾复任苍天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13915,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"梦先陇","author":"谢迁","text":"先陇睽违十二秋，梦䰟合眼到松楸。\n觉来枕席频清泪，归去帆樯足胜游。\n逸少閒情还自誓，渊明雅志复何求。\n从今不负牛屯景，烟月晴花共乐邱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13916,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蚤发临清喜晴","author":"谢迁","text":"昨宵风雪阻严程，今日前途喜复晴。\n萍水襟期成汗漫，鸿泥踪迹尚分明。\n旧游乍觉三秋远，归路真誇五两轻。\n海上閒鸥迎野老，向来尘席任谁争。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13917,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"东昌道中遇雪","author":"谢迁","text":"夜床冷彻旧青毡，蚤起推篷雪满船。\n缟带迎风轻著水，琪花拂树远连天。\n峥嵘闸溜悬冰柱，迢递村墟破晓烟。\n为语儿童寒莫讶，屡丰应复兆来年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13918,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬商茂林郎中二首 其一","author":"谢迁","text":"斯文乡曲旧通家，宦路相看几岁华。\n邂逅红亭烦驻节，慇勤青眼未生花。\n石尤风急仍留客，都水司存远建牙。\n南旺湖头重分手，碧波离思两无涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13919,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"柬商茂林郎中二首 其二","author":"谢迁","text":"当年知己辱尊翁，草野诸生揖上公。\n璞玉久惭虚重价，芝兰今喜见芳丛。\n疏星向晓芒犹北，潦水经秋势亦东。\n欲寄椒浆酹松槚，岁寒心迹后先同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13920,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"朱节妇寿诗即彦明之母","author":"谢迁","text":"瑶池绛烛蔼芳辰，青雀西来送喜频。\n欢动綵衣归上国，香生寿酒熟先春。\n闾门诏旨旌慈节，尊俎诗歌集缙绅。\n花甲才周知未艾，老天应念苦心人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13921,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答□冬官拯","author":"谢迁","text":"菲才久已成尸素，宦路真宜避俊英。\n漫向江湖寻范蠡，盛陈车马诧桓荣。\n邦家末命孤先帝，乡里斯文属后生。\n珍重通家情独厚，相逢青眼倍分明。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13922,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"谢沟闸阻风柬黄敬夫","author":"谢迁","text":"驿舟才过下沽头，竟日飘风阻谢沟。\n乱石狂沙深闭户，酒杯棋局漫添筹。\n险夷有分真随遇，行止无端可自由。\n寄语同途诸逆旅，前程何必叹淹留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13923,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"舟次彭城同年洪宪副以书来迓赋一律奉答","author":"谢迁","text":"淮扬封畛接青徐，满道风霜按节初。\n鸡黍偶成千里约，寒暄先枉一缄书。\n交情谁复如同榜，宦路吾方愧二疏。\n只恐相逢又相别，严程欲进更趑趄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13924,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吕梁阻风奉怀洪都宪年兄","author":"谢迁","text":"望中云树两驰情，风雨连朝阻客程。\n使介远烦都宪节，交期不负岁寒盟。\n吕梁自昔开天险，禹贡如今赖地平。\n明日相逢成一笑，波涛过眼未须惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13925,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次洪都宪韵怀冯佩之宪副二首 其一","author":"谢迁","text":"当年已怪冯唐老，一别于今又十年。\n洛社衣冠原有约，汝湖风月浩无边。\n衡门旧业荒三径，斗酒新欢拟百篇。\n更喜登临随意足，不劳重费买山钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13926,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次洪都宪韵怀冯佩之宪副二首 其二","author":"谢迁","text":"结社久惭违素约，归休今喜共馀年。\n悠悠世事俱身外，点点霜华渐鬓边。\n幸有赐金供客具，漫劳邮卒递诗篇。\n旧时行乐湖山在，明月清风不用钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13927,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"京口遇乡人闻得曾孙喜而有作 其一","author":"谢迁","text":"人报丹山又一雏，客途尊酒足欢娱。\n传家敢谓多阴德，对镜无烦镊白须。\n归去庭前添玉树，閒来掌上弄明珠。\n郑公事业吾惭比，旧笏惟应付阿谟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13928,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"京口遇乡人闻得曾孙喜而有作 其二","author":"谢迁","text":"偶逢乡曲话寒暄，报道兰阶雨露繁。\n林下旧游归一老，眼前新喜见曾孙。\n公卿知已惭先德，清白惟应遗后昆。\n囊底赐金供具足，閒情宁复问田园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13929,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"答冯佩之用前韵","author":"谢迁","text":"高阁小车真渴望，迎门一笑正新年。\n聚星光烛稽山下，会老堂开汝水边。\n弄月吟风偿宿债，投桃报李续残编。\n吾侪真率无兼味，却怪何曾食万钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13930,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"人日喜晴仍用前韵柬佩之","author":"谢迁","text":"岁暮还家频苦雨，今朝忽霁喜占年。\n阳回泰运开天上，风送春声到耳边。\n知己漫成怡老会，养生方学悟真篇。\n晚来聊试登山屐，踏破青苔满路钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13931,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"佩之约会牛屯山庄雨不克赴辱诗见贶依韵答之","author":"谢迁","text":"夜床欹枕到天明，客闷重随旧雨生。\n鸡黍真惭千里约，松楸未慰十年情。\n山中云满孤持赠，海上鸥閒迟结盟。\n明日携琴候萝径，已占钟鼓报新晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13932,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再次韵约佩之","author":"谢迁","text":"狂客归舟恋四明，鉴湖春水应时生。\n澄波万顷原无价，霖雨弥旬似有情。\n放浪形骸娱晚景，平分风月记前盟。\n剡溪雪棹犹乘兴，檐鹊朝来已报晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13933,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"正月廿四日会佩之于牛屯山庄次韵","author":"谢迁","text":"粗粝盘餐愧客筵，熹微晴日蚤春天。\n画屏影落前岩树，玉佩声分别涧泉。\n云载鹤还添暮景，雨催蛙动报丰年。\n杖藜无惜频来往，老去溪山转觉便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13934,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太宰屠公见过用前韵奉呈二首 其一","author":"谢迁","text":"华裾鸣佩拥芳筵，巷柳墙梅炤远天。\n檀板骤惊林外鸟，茗瓯频试竹间泉。\n山阴命驾轻千里，彭泽停云近十年。\n社会从今成旧约，沧江来往一舟便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13935,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"太宰屠公见过用前韵奉呈二首 其二","author":"谢迁","text":"湖上春风列小筵，画船轻漾水中天。\n行怜蜡屐开新径，坐爱流觞曲引泉。\n京邸离怀频入梦，江乡交谊久忘年。\n山殽野蔌休相笑，真率从来□□□。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13936,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送屠公出姚江奉和途中即事一首","author":"谢迁","text":"四望潾潾麦浪平，午风村落远鸡鸣。\n搴帷到处儿童识，负弩驱时驿吏迎。\n野水横舟人欲渡，山云触石雨还生。\n明朝同上龙泉顶，一举何妨累十觥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13937,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又和登龙泉绝顶一首","author":"谢迁","text":"迤逦蟠龙接秘图，雨中台殿昼模糊。\n神仙胜境馀三岛，狂客归舟任五湖。\n地近东冥先见日，树连南郭晚栖乌。\n高轩过处人争讶，一片冰清炤玉壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13938,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵复贾挥使","author":"谢迁","text":"韬略勋名羡世官，旌麾时复上骚坛。\n才兼文武仍专美，念及疮痍每问安。\n海岳遥连门阀壮，冰壶清映甲光寒。\n滹沱麦饭须存记，不为时平独饱餐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13939,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"三月六日过佩之雪湖山庄次韵","author":"谢迁","text":"雪湖千顷自天开，十载幽期共此杯。\n柳浪乘风轻荡桨，桂岩经雨半封苔。\n客衣香惹蘼芜动，农事忙惊布谷催。\n松下为予通一径，南冈从此破崔巍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13940,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再游牛屯山庄和联句韵答雪湖","author":"谢迁","text":"碧山归共太平年，香社风流到海边。\n春入林间无数笋，雨馀树杪几重泉。\n烟霞怡老真成趣，农圃求师不吝传。\n相隔高冈才咫尺，路通尤觉往来便。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13941,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答林待用都宪","author":"谢迁","text":"碌碌尘羁愧北山，圣慈优老许投閒。\n长孙幼子书千卷，明月清风屋数间。\n晚眺有时随鹤步，春眠无梦到鹓班。\n闽江越峤神交地，杖履何由日往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13942,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山庄杨梅熟摘奉雪湖辱诗并惠乾笋仍用林都宪韵答之","author":"谢迁","text":"每因苦笋忆家山，不为黄公强乞閒。\n玉版久嫌千里外，渭川今在两湖间。\n美专吴楚尤非昔，清绝夷齐孰与班。\n惭愧投桃真野意，慇勤琼玖荷公还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13943,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"五月十七日山庄避暑次韵答雪湖","author":"谢迁","text":"兰亭怪底不成章，兴在溪流曲引觞。\n水竹旧居还老懒，盘餐雅会任清狂。\n陶潜适俗悲尘网，王绩逃名托醉乡。\n一曲沧浪归晚棹，荷风十里送新凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13944,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"山亭新构柬雪湖","author":"谢迁","text":"小结茆亭傍涧阿，两峰前后郁嵯峨。\n看山恰彀支颐卧，问字何妨载酒过。\n甃石路回青嶂合，钩帘窗度白云多。\n登临不爽清秋约，预遣家僮扫薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":13945,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]