[{"title":"梦家","author":"孙承恩","text":"环玉溪边风日晴，千花万花相间明。\n笑侍慈闱献春酒，不知身在赣州城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37460,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"曲江舟中","author":"孙承恩","text":"昔从故国瞻梅岭，望杳天南欲断肠。\n今日曲江试回首，只将梅岭认家乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37461,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中漫兴二首 其一","author":"孙承恩","text":"平生酷有耽山癖，恨不移家住近山。\n万里兹行差慰意，看山去了看山还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37462,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中漫兴二首 其二","author":"孙承恩","text":"万里天南泛使槎，不堪乡思乱如麻。\n梦魂不为青山隔，昨夜分明又到家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37463,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中夜坐","author":"孙承恩","text":"山头斗柄挂寒芒，烟水浮空正渺茫。\n坐久不知江月落，满身风露湿衣裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37464,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"梦得家信","author":"孙承恩","text":"欲见家书苦未因，梦中昨夜寄来新。\n朦胧别语浑忘却，两字平安看最真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37465,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归次嘉兴喜儿侄来候二首 其一","author":"孙承恩","text":"无限离愁未易裁，今朝不觉笑颜开。\n春风江上孤舟近，乌帽青衫见汝来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37466,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"归次嘉兴喜儿侄来候二首 其二","author":"孙承恩","text":"何事今朝散客愁，阿咸兄弟候归舟。\n惊看忽忽无他问，白发慈亲健在不。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37467,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早春同友人閒行因过太清道院","author":"孙承恩","text":"乘閒聊复作閒人，竹杖芒鞋趁早春。\n林下水边时纵步，绝胜都市踏红尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37468,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过太清道院有感","author":"孙承恩","text":"竹楼曾为习诗章，卷里犹看墨色光。\n作者主人半零落，空馀苍翠拂云长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37469,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诸友有和复得三首 其一","author":"孙承恩","text":"天将清景付幽人，合写新诗报答春。\n残雪压梅浑有态，暖风吹草不生尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37470,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诸友有和复得三首 其二","author":"孙承恩","text":"洞口春阴长绿苔，云关斜傍竹林开。\n城中车马人如沸，谁似先生肯独来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37471,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"诸友有和复得三首 其三","author":"孙承恩","text":"续得淮南招隐章，幽怀抵死惜春光。\n经旬不出郊原步，绿草相将叶渐长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37472,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再叠三首 其一","author":"孙承恩","text":"乾坤谁是百年人，莫为閒愁枉却春。\n试看昔人行乐处，荒台无地积秋尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37473,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再叠三首 其二","author":"孙承恩","text":"烟暗园林雨没苔，春愁如织郁难开。\n不将幽意偷寻乐，容易霜华上鬓来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37474,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"再叠三首 其三","author":"孙承恩","text":"綵笔聊拈赋短章，朝来微雨洗年光。\n山花一树草堂静，啼鸟数声春意长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37475,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹亭纳凉二首 其一","author":"孙承恩","text":"茗椀炉薰枕簟清，竹阴亭子嫩凉生。\n城中滚滚红尘满，犹有忙人暴日行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37476,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"竹亭纳凉二首 其二","author":"孙承恩","text":"幽亭无地着尘嚣，纵有尘心亦自消。\n何处有声清到耳，天风吹动万琼瑶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37477,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题红梅二首 其一","author":"孙承恩","text":"冷艳清香自一家，冰肌谁与傅丹砂。\n试看标格依然在，未信人疑作杏花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37478,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题红梅二首 其二","author":"孙承恩","text":"姑射仙人朝玉皇，玉皇敕赐九霞觞。\n冰姿殢酒吹难醒，犹自风前倚绛妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37479,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又赋红梅二首 其一","author":"孙承恩","text":"独占春风领众芳，薄寒初试绛罗裳。\n东皇似是嫌清淡，故与慇勤赠艳妆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37480,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又赋红梅二首 其二","author":"孙承恩","text":"疏影横斜淡月明，珊瑚枝上晚风清。\n罗浮一觉游仙梦，吹入天台不再醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37481,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寻春","author":"孙承恩","text":"莫怪寻春意欲颠，水边林下辄留连。\n等閒别却东风去，欲识东风又隔年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37482,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题飞鸣宿食四雁图","author":"孙承恩","text":"片影横拖水国凉，一声清唳水天长。\n衡阳梦稳无矰弋，霜老菰蒲米正香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37483,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春晚游招提","author":"孙承恩","text":"寻春野寺又春回，赖有馀芳数朵开。\n错莫更教迟一日，纵能携酒亦空来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37484,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春归","author":"孙承恩","text":"中酒朝来睡起迟，残英飞尽只空枝。\n东君昨夜欺人醉，收拾春归不教知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37485,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"田家","author":"孙承恩","text":"霢霂朝来浥众芳，晚烟吹暝转微茫。\n邻家老父来相约，明日田头好莳秧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37486,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓起池上独立","author":"孙承恩","text":"露华月色满西池，睡起阑干独倚时。\n一阵荷风拂衣袂，尽收清气入诗脾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37487,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"勉友仁侄孙","author":"孙承恩","text":"入道功夫岂有涯，西飞白日苦难遮。\n一春又是联翩过，试看东园桃杏花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37488,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"风雨池上小憩","author":"孙承恩","text":"风雨来时独倚栏，绿荷池上䠞微澜。\n试看瑟瑟萧萧处，无数明珠走翠盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37489,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"纪梦","author":"孙承恩","text":"幽斋昨夜梦朝天，丹陛徐趋进讲编。\n何处钟声忽惊醒，错疑犹在御炉前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37490,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夷齐图二首 其一","author":"孙承恩","text":"炮烙烟消四海苏，文孙威德已弘敷。\n钜桥虽有陈陈粟，不济空山两饿夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37491,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夷齐图二首 其二","author":"孙承恩","text":"孤竹先生铁肺肝，采薇甘死首阳山。\n乾坤不朽君臣义，万古清风激懦顽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37492,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺杨麟山生子晬日三首 其一","author":"孙承恩","text":"眉目分明玉雪肤，只今宁止识之无。\n他时解事应无忘，汤饼筵中有老夫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37493,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺杨麟山生子晬日三首 其二","author":"孙承恩","text":"尔父藏书万卷馀，朝来为汝一掀须。\n只今已解耽文字，能读焉知不是渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37494,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"贺杨麟山生子晬日三首 其三","author":"孙承恩","text":"玉果犀钱与肆筵，兰汤初出气轩轩。\n试看拈动惊人坐，不是干戈即豆笾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37495,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"招友人赏莲二首 其一","author":"孙承恩","text":"小圃来稀怯病身，芙渠空浸一池云。\n今朝忽动看花兴，洗?池边只待君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":37496,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"招友人赏莲二首 