[{"title":"咏史 其一","author":"李贽","text":"荆卿原不识燕丹，秪为田光一死难。\n慷慨悲歌惟击筑，萧萧易水至今寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31287,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史 其二","author":"李贽","text":"夷门画策却秦兵，公子夺符出魏城。\n上客功成心遂死，千秋万岁有侯赢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31288,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏史 其三","author":"李贽","text":"晋鄙合符果自疑，挥锤运臂有屠儿。\n情知不是信陵客，刎颈迎风一送之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31289,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"却寄 其一","author":"李贽","text":"一回飞锡下江南，咫尺无由接笑谈。\n却羡婆须蜜氏女，发心犹愿见瞿昙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31290,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"却寄 其二","author":"李贽","text":"持钵来归不坐禅，遥闻高论却潸然。\n如今男子知多少，尽道官高即是仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31291,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"却寄 其三","author":"李贽","text":"盈盈细抺随风雪，点点红妆带雨梅。\n莫道门前车马富，子规今已唤春回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31292,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"却寄 其四","author":"李贽","text":"声声唤出自家身，主死如山不动尘。\n欲见观音今汝是，莲花原属似花人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31293,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜杨凤里到摄山 其一","author":"李贽","text":"十年相守似兄弟，一别三年如隔世。\n今日还从江上来，孤云野鹤在山寺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31294,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜杨凤里到摄山 其二","author":"李贽","text":"忆别龙湖才几时，天涯霜雪净须眉。\n君今复自龙湖至，鬓里有丝君自知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31295,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"山中得弱侯下第书","author":"李贽","text":"秣陵人去帝京游，可是隋珠复暗投。\n昨夜山前雷雨作，传君一字到黄州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31296,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同周子观洞龙梅","author":"李贽","text":"一枝斜倚古垣东，白首逢君出洞龙。\n莫怪花神争笑语，周郎昨夜此山中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31297,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"湖上红白梅盛开戏题","author":"李贽","text":"始知春意属闲身，红白相将入望频。\n才到开时君又去，看花不是种花人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31298,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠周山人","author":"李贽","text":"谩道男儿四海身，百钱卖卜不愁贫。\n即今欲上黄梅路，谁把十金抛与人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31299,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"牡丹时 其一","author":"李贽","text":"牡丹才记欲开时，芍药于今久离披。\n可是山中无人到，花开花谢总不知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31300,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"牡丹时 其二","author":"李贽","text":"忆昔长安看花时，牡丹独有醉西施。\n省中一树花无数，共计二百单八枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31301,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初到石湖","author":"李贽","text":"皎皎空中石，结茅俯青溪。\n鱼游新月下，人在小桥西。\n入室呼尊酒，逢春信马蹄。\n因依如可就，筇竹正堪携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31302,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春宵燕集得空字","author":"李贽","text":"高馆张灯夜，清尊兴不空。\n故交来昨日，千里动春风。\n竹影寒塘下，歌声细雨中。\n可怜新岁月，偏向旧衰翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31303,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋刘近城携酒湖上","author":"李贽","text":"举网澄潭下，凭阑看得鱼。\n谁将从事酒，一问子云庐。\n水白沙鸥净，天空木叶疏。\n中秋今夜月，尔我独踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31304,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋前约近城凤里到周子竹园 其一","author":"李贽","text":"竹径来三友，清幽半在君。\n抛书为对客，把酒好论文。\n青苔过雨后，独鹤向人群。\n携手欲同去，相看日未曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31305,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋前约近城凤里到周子竹园 其二","author":"李贽","text":"暑在人还倦，竹深风自凉。\n茶来频我酌，酒到与君尝。\n徙倚窥驯鹿，闻呼过短墙。\n沈吟秋日近，容易得相将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31306,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"环阳楼晚眺得棋字","author":"李贽","text":"不是环阳客，何来席上棋。\n推窗云亦去，俯槛月犹迟。\n水底鱼龙醒，花间鸟鹊饥。\n眼看春又半，虽老亦忘疲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31307,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重过曾家","author":"李贽","text":"冰肌仍带雪，霜鬓更逢梅。\n花是去年白，人知何日回。\n一杯临老客，三度隔墙开。\n无计就君住，明朝还复来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31308,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送郑子玄兼寄弱侯","author":"李贽","text":"我乃无归处，君胡为远游。\n穷途须痛哭，得意勿淹留。\n旅鬓迎霜日，诗囊带雨秋。\n蓟门虽落莫，应念有焦侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31309,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丘长孺生日","author":"李贽","text":"似君初度日，不敢少年看。\n百岁人间易，逢君世上难。\n三杯生瑞气，一雨送春寒。\n对客犹辞醉，尊前有老聃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31310,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒关圣祠","author":"李贽","text":"交契得如君，香烟可断云。\n既归第一义，宁复昔三分。\n金石有时敝，关张孰不闻。\n我心无所似，只是敬将军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31311,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观铸关圣提刀跃马像","author":"李贽","text":"英雄再出世，烈烈有晖光。\n火焰明初日，金精照十方。\n居然围白马，犹欲斩颜良。\n岂料人千载，又得见关王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31312,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋怀","author":"李贽","text":"白尽余生发，单存不老心。\n栖栖非学楚，切切为交深。\n远梦悲风送，秋怀落木吟。\n古来聪听者，或别有知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31313,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闲步","author":"李贽","text":"灌园看老圃，秋色似江南。\n畦沁蔬堪摘，霜黄杮未甘。\n尔非陈仲子，我岂老瞿昙。\n聊共班荆坐，凭君说两三。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31314,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春喜常融二人至 其一","author":"李贽","text":"客久岁云暮，吾衰道自尊。\n时辰催短速，晷刻变寒温。\n人贱时争席，神伤早闭门。\n新春看尔到，应念我犹存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31315,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立春喜常融二人至 其二","author":"李贽","text":"正尔逢春日，到来两足尊。\n偷生长作客，僧腊始开门。\n淡淡梅初放，如如雪可吞。\n千三四百里，又是一乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31316,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"干楼晚眺 其一","author":"李贽","text":"呼朋万里外，拍手层霄间。\n塞晚浮烟重，天空岁月闲。\n断云迷古戍，落日照西山。\n幸有声歌在，更残且未还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31317,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"干楼晚眺 其二","author":"李贽","text":"凭高一洒衣，望远此何时。\n正是中元节，兼听游女悲。\n杯干旋可酌，曲罢更题诗。\n愿将北流水，弹与钟子期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31318,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"干楼晚眺 其三","author":"李贽","text":"中丞缓定后，携我共登临。\n所喜闻谣俗，非干怀壮心。\n山云低薄暮，楼日压重阴。\n欲归犹未可，此地有知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31319,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠利西泰","author":"李贽","text":"逍遥下北溟，迤逦向南征。\n刹利标名姓，仙山纪水程。\n回头十万里，举目九重城。\n观国之光未，中天日正明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31320,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"六月访袁中夫摄山","author":"李贽","text":"怀人千佛岭，避暑碧霞颠。\n试问山中乐，何如品外泉。\n阴阴藤挂树，隐隐日为年。\n坐觉凉风至，披襟共洒然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31321,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"薜萝园宴集赠鸥江词伯","author":"李贽","text":"为有玉田饭，任从金粟过。\n名园花树早，小径求羊多。\n煮茗通玄理，焚香去染痾。\n宗侯非旷荡，若意在烟萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31322,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望东平有感","author":"李贽","text":"我来齐竟上，吊古问东平。\n雨细河鱼出，云收山鸟鸣。\n夭桃夹岸去，弱柳送春行。\n最乐谁堪比，惟君悟此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31323,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过聊城","author":"李贽","text":"谁道百夫长，胜作一书生。\n渤海新开府，中原尽点兵。\n倭夷两步卒，廊庙几公卿。\n不见鲁连子，射书救聊城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31324,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过武城 其一","author":"李贽","text":"弦歌古渡口，经过欲停舟。\n世变人何往，神伤意不留。\n文章夸海岱，礼乐在春秋。\n堪笑延陵札，同时失子游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31325,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过武城 其二","author":"李贽","text":"先师无戏论，一笑定千秋。\n白雪难同调，青云谁见收。\n春风吹细草，明月照行舟。\n鲁国多男子，几人居上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31326,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自武昌渡江宿大别","author":"李贽","text":"疏钟夜半落云房，今夕何由见武昌。\n流水有情怜我老，秋风无恙断人肠。\n千年芳草题鹦鹉，万里长江入汉阳。\n大别原非分别者，登临不用更悲伤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31327,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晓行逢征东将士却寄梅中丞","author":"李贽","text":"烽火城西百将屯，寒烟晓爨万家村。\n雄边子弟夸雕鞯，绝塞将军蚤闭门。\n傍海何年知浪静，登坛空自拜君恩。\n云中今有真颇牧，安得移来觐至尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31328,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"晚过居庸","author":"李贽","text":"重门天险设居庸，百二山河势转雄。\n关吏不闻占紫气，行人或共说非熊。\n湾环出水马蹄涩，回复穿云月露融。\n燕市即今休感慨，汉家封事已从容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31329,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日至极乐寺闻袁中郎且至因喜而赋","author":"李贽","text":"世道由来未可孤，百年端的是吾徒。\n时逢重九花应醉，人至论心病亦苏。\n老桧深枝喧暮鹊，西风落日下庭梧。\n黄金台上思千里，为报中郎速进途。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31330,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"元日极乐寺大雨雪","author":"李贽","text":"万国衣冠共一新，婆娑独占上方春。\n谁知向阙山呼日，正是飞花极乐辰。\n寂寂僧归云际寺，溶溶月照陇头人。\n年来鬓发随刀落，欲脱尘劳却惹尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31331,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨中塔寺和袁小修韵","author":"李贽","text":"无端滞落此江濒，雨湿征衫逢故人。\n但道三元犹浪迹，谁知深院有孙身。\n才倾八斗难留客，酒赋千钟不厌贫。\n自是仙郎佳况在，何妨老子倍精神。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31332,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读羊叔子劝伐吴表","author":"李贽","text":"三马同槽买邺都，转身卖与小羌胡。\n山涛不是私忧者，羊佑宁知非算无。\n天堑长江权入晋，地分左衽终输吴。\n当时王谢成何事，只好清谈对酒垆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31333,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"读刘禹锡金陵怀古","author":"李贽","text":"王浚楼船下益州，金陵怀古独称刘。\n千寻铁锁沈江底，百万龙骧上石头。\n赋就群公皆阁笔，功成二子莫为雠。\n钟山王气千年在，不见长江日夜浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31334,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"琉璃寺","author":"李贽","text":"琉璃道上日初西，马绕秋风万木低。\n僧舍不关从客主，田家有酒为谁携。\n篱边小雨催黄菊，山岫明星报晓鸡。\n自有深公为伴侣，何妨一笑过前溪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31335,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赴京留别云松上人","author":"李贽","text":"支公遁迹此山居，深院巢云愧不如。\n自借松风一高枕，始知僧舍是吾庐。\n风吹竹柏袈裟破，月满地塘钟磬虚。\n独有宿缘酬未毕，临岐策马复嚋躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31336,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望鲁台礼谒二程祠","author":"李贽","text":"日暮西风江上台，森森古木使人哀。\n楚云一夜真堪赋，鲁国何年入望来。\n千载推贤惟伯仲，百年想象见婴孩。\n孤然欲下门庭雪，知是先生爱不才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31337,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赴谪所舟发凤城驿别舒明府及诸亲","author":"林熙春","text":"凤城驿接凤凰台，凤啸台中驿路催。\n仙吏祗劳勤劝驾，故人宁用漫浮杯。\n剑过江右龙为跃，书到衡阳雁正回。\n抗疏功名原自薄，何堪闾倚望衣莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31338,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次程冈宿旧主谢茂才叔侄宅","author":"林熙春","text":"岭外驱驰频带雨，虔南投宿始占星。\n昔年已挹芳兰秀，此日重依玉树荣。\n偃蹇漫讶秦逐客，风流宁论鲁诸生。\n相逢话旧清尊满，何必溪矶叹独醒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31339,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘养旦先生诸子即讲院祀先生余谪茶陵借宿赋五言近体为谢并得流字 其一","author":"林熙春","text":"先生还有子，颉颃并吞牛。\n椿树羹墙见，荆花朝夕游。\n刀头明月在，囊内锦云流。\n郢调宁无和，燕山自有詶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31340,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘养旦先生诸子即讲院祀先生余谪茶陵借宿赋五言近体为谢并得流字 其二","author":"林熙春","text":"齐居犹负郭，逐客暂淹留。\n虎观山灵隐，驹神斗气流。\n斯文应否泰，吾道任沉浮。\n献纳诸昆事，东封且莫筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31341,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"先余册岷府曾过茶陵兹冯使君招饮即席呈谢时使君初任也","author":"林熙春","text":"皇华曾此度湘流，此日重经太乙楼。\n桐叶三年封帝子，萍踪千里晤君侯。\n风临夏屋劳前席，云拥春台解敝裘。\n圣主恩深投不远，长沙东望即瀛洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31342,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"繇茶陵过吉州张使君招饮白鹭书院时三月初十日也就此因闻倭警 其一","author":"林熙春","text":"崔嵬杰阁控名州，吴楚东南灏气收。\n排闼彩云千嶂合，捲帘纹水万溪流。\n文翁几席霏金聚，逐吏扁舟倚玉游。\n准儗拍天干象纬，翩翩白鹭凤凰楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31343,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"繇茶陵过吉州张使君招饮白鹭书院时三月初十日也就此因闻倭警 其二","author":"林熙春","text":"逢掖沧浪属草玄，使君旗鼓大江先。\n千门桃馥春过半，一阁藜光月暂员。\n自是潜心探象罔，繇来信手获鱼筌。\n冯栏忽动乡关思，东海烽传可怅然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31344,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"茶陵道中苦雨","author":"林熙春","text":"积雨山迷路，冲泥客倦游。\n惊疑犹坂折，惶恐似滩头。\n恋阙心逾郁，趋庭志稍酬。\n呼童寻旧宿，沽酒醉东楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31345,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过虔州即席呈李中丞","author":"林熙春","text":"望望关河夙露收，只从仗钺控虔州。\n□郎自昔声青琐，汉使于今正黑头。\n南去粤闽劳借箸，西来吴楚属纡筹。\n当筵莫问封疆事，一叶翩翩狎海鸥。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31346,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过隘岭","author":"林熙春","text":"驰驱磴道隘门关，尺五天高意气閒。\n鸟自云中遮马路，泉从树杪沛人间。\n凝眸瀚海三山小，回首章江八极环。\n漫道瀛州亲舍远，鄞江一脉水潺潺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31347,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"饮凤皇塔次杨苕水韵","author":"林熙春","text":"凤来栖塔海无波，一柱擎天天几何。\n万丈虹堤归玉简，千家烟火傍金坡。\n斗山在望循凤远，片石遗思畏垒多。\n相对逐臣成夜饮，不妨鼓枻听渔歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31348,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观察任公祖五月举孙官邸召赴汤饼漫贼四章志喜兼谢时海上有警次日闻大捷诗中及之 其一","author":"林熙春","text":"韩山紫气动三台，为报生申降岳来。\n幸际薰风芳玉树，欣逢瀛海出珠胎。\n兴门莫问同文事，许国应知献赋才。\n席上共惊孙是祖，金盘漫醉可论杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31349,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观察任公祖五月举孙官邸召赴汤饼漫贼四章志喜兼谢时海上有警次日闻大捷诗中及之 其二","author":"林熙春","text":"浴罢兰孙第自高，筵开汤饼兴偏豪。\n柏台已羡麟多趾，梧树新添凤一毛。\n此日头颅誇玉骨，它年睥睨建星旄。\n君家积善繇来久，馀庆能诗续水曹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31350,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观察任公祖五月举孙官邸召赴汤饼漫贼四章志喜兼谢时海上有警次日闻大捷诗中及之 其三","author":"林熙春","text":"张弧正值戈声急，持斧焦劳属壮猷。\n玉出蓝田穿笋径，珠悬明月听松楼。\n稽生有子矜青眼，汉使携孙正黑头。\n海上莫教惊客梦，宁馨咄咄已吞牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31351,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观察任公祖五月举孙官邸召赴汤饼漫贼四章志喜兼谢时海上有警次日闻大捷诗中及之 其四","author":"林熙春","text":"森枝五月倚云栽，夜集兰台醉绿醅。\n近水松萝供逸兴，傍城钟鼓促金罍。\n星河恋客偏璀璨，鱼鹤闻歌任去来。\n酒罢忽当飞战捷，锦袍端儗授龙媒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31352,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九日任公祖邀登金山次韵呈谢","author":"林熙春","text":"使节光摇粤水濆，重阳风物有馀矄。\n榻悬峰顶情无限，帽落樽前兴不群。\n词客千秋分白雪，归人三径傍卿云。\n茱萸酒罢浑天净，可但瀛城瑞色氲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31353,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月十五日任公祖登凤凰台次李韵一首时公次日初度","author":"林熙春","text":"凤皇台上凤皇游，杰阁弘开砥柱流。\n山斗霄悬呈彩笔，金银夜合作丹丘。\n波环两水沧溟外，影落长虹虎豹洲。\n为报老人星绚耀，凭轩沉醉有何愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":31354,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]