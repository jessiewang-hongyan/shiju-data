[{"title":"初赠谢山人山人时馆京山都尉","author":"王世贞","text":"斗酒谁相劳，高斋此独醒。\n暂依中禁脔，不作五侯鲭。\n下里传春雪，高天动客星。\n平生厌冠盖，对尔眼能青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日同李三比部有怀伯承明府","author":"王世贞","text":"佳日试春酒，停觞南望频。\n偶因文似者，偏及意中人。\n入夜青萍合，连云碧树新。\n空为可怜语，天际竟谁陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送彭进士谪江右","author":"王世贞","text":"何处滕王阁，遥维八月舲。\n雨飞南浦绿，云入大江青。\n忆远凭春树，占程问客星。\n待君重有赋，慎莫恨飘零。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张子训导临江","author":"王世贞","text":"有客南州彦，栖迟剧可怜。\n一官新白发，十载旧青毡。\n朔雾浓行色，春风入暮年。\n剑光何处发，玉笥倚南天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠张内翰还楚","author":"王世贞","text":"洞庭八百里，春波正渺茫。\n谁将木兰楫，君是紫微郎。\n柱识留题字，衣分旧赐香。\n毋为恋芳草，久已待长杨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周子仁淮安理刑","author":"王世贞","text":"春波沙岸青，之子独扬舲。\n淮楚开雄镇，东南候法星。\n月明乡树出，天阔暮云停。\n予亦栖栖者，骊歌未忍听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钦水部 其一","author":"王世贞","text":"岁晚轻为别，轺车冰雪遮。\n君才何水部，予咏折梅花。\n兹地衔舻集，为郎转饷赊。\n如逢讯南北，憔悴总堪嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送钦水部 其二","author":"王世贞","text":"青盖白云艭，尚书水部郎。\n吏迎花底绣，窗发镜中樯。\n不废穿林屐，时悬爱客床。\n还思蓟门饷，飞挽正相望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送徐生南还因讯陈员外","author":"王世贞","text":"挟策辞燕市，南州有令名。\n白云帆际色，黄鸟席边声。\n裘马游将倦，兵戈气未平。\n共誇能似舅，为尔忆冰清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠寄史生","author":"王世贞","text":"近来称艺苑，江夏尔为双。\n湖海风犹劲，齐梁意未降。\n汝联明月璧，予汎白云艭。\n何日探奇字，花间倒玉缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四月一日同于鳞子与诸君水头放舟六首 其一","author":"王世贞","text":"何处园池好，唯应西郭偏。\n惜当春后日，狂爱水中天。\n玳瑁涓人马，葡萄上客筵。\n那能不深醉，北望有风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9669,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四月一日同于鳞子与诸君水头放舟六首 其二","author":"王世贞","text":"朝来宽请急，醉宿亦无妨。\n舟楫青天近，林塘白日长。\n浪花鱼自起，风叶鸟难藏。\n忽有吴歌发，沧洲意欲狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9670,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四月一日同于鳞子与诸君水头放舟六首 其三","author":"王世贞","text":"繁坞疑春在，空塘得暑迟。\n长年木兰棹，游女竹枝词。\n万树声俱发，千山坐觉移。\n飞觞予不厌，促骑尔何之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9671,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四月一日同于鳞子与诸君水头放舟六首 其四","author":"王世贞","text":"走马长安陌，放舟河水滨。\n风光馀澹荡，天地此逡巡。\n住暂依芳草，行看破绿蘋。\n无妨叠鼓吹，不起汉关尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9672,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四月一日同于鳞子与诸君水头放舟六首 其五","author":"王世贞","text":"歌管能回日，轻舠自任风。\n人家渔网外，山色酒杯中。\n心事欢仍见，年光醉未穷。\n褰裳吾欲涉，菰际忽惊鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9673,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四月一日同于鳞子与诸君水头放舟六首 其六","author":"王世贞","text":"醉客双眼白，繁花一树明。\n乾坤凭去鸟，日月问骑鲸。\n悬沫星溅跃，轻飔浪熨平。\n此中龙稳卧，或恐夜珠惊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9674,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后九日重与应李诸君水头放舟 其一","author":"王世贞","text":"为有沧洲趣，重来肯厌频。\n溪鸥浑狎棹，篱犬不惊人。\n物色时能改，心期日更真。\n仆夫毋太促，吾醉欲经旬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9675,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后九日重与应李诸君水头放舟 其二","author":"王世贞","text":"韦曲看如故，高阳侣半非。\n清朝耕钓远，公事宴游稀。\n宾主忘分席，阴晴数换衣。\n夷犹竟日暮，聊与咏而归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9676,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后九日重与应李诸君水头放舟 其三","author":"王世贞","text":"此醉吾何惜，沿流亦快哉。\n山光入返棹，水气促行杯。\n岸帻天云合，酣歌海日回。\n风尘能傲吏，朋旧任微才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9677,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"后九日重与应李诸君水头放舟 其四","author":"王世贞","text":"旬日乘休沐，芳洲绿渐迷。\n菰蒲疑水落，禾黍觉天低。\n汎与心偏在，浮生众岂齐。\n看他冠盖客，斜日五陵西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9678,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集有怀谢茂秦分韵 其一","author":"王世贞","text":"故人元不乏，犹问白头翁。\n此夜漳园赋，谁当谢朓工。\n小儒矜倚马，薄俗谓雕虫。\n尔自黄初际，翩翩作者风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9679,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集有怀谢茂秦分韵 其二","author":"王世贞","text":"被发长安市，乾坤一啸歌。\n歔欷吾辈晚，跌宕世人多。\n短褐春仍在，新诗老任过。\n祇应西望处，残月满漳河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9680,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄万郎中恤刑楚中 其一","author":"王世贞","text":"似尔飞章少，看他属传同。\n星辰南纪阔，雨露帝乡公。\n蹑履衡云外，裁诗峡色中。\n苍梧去无尽，恐晚北来鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9681,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄万郎中恤刑楚中 其二","author":"王世贞","text":"闻道衡阳使，真能鉴覆盆。\n凄凉汨罗水，呜咽楚臣魂。\n一代心仍屈，千秋赋自尊。\n如堪荐兰芷，芳意信乾坤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9682,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端午 其一","author":"王世贞","text":"亦自酬佳节，何当病故侵。\n綵丝从女竞，蒲酒赖妻斟。\n时序他乡物，风尘倦客心。\n放舟吾旧侣，应向越江浔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9683,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"端午 其二","author":"王世贞","text":"抱病无端午，惊从稚子传。\n折蒲聊旧俗，续缕更流年。\n佳客频攻懒，狂夫只爱眠。\n山公使归说，箕踞柳阴前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9684,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中于鳞子与公实子相夜过 其一","author":"王世贞","text":"此日群公过，能令稚子欢。\n珠光海月动，剑色夜星寒。\n牢落千年在，浮沉万事安。\n时人归眼底，世道总眉端。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9685,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中于鳞子与公实子相夜过 其二","author":"王世贞","text":"平生语不尽，兹夕罄相逢。\n意气扶衰眼，欢呼失病容。\n公才竞班马，吾道岂夔龙。\n忽忆吴山月，云深万壑钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9686,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中承三子各以五言二律相问率尔有答酬于鳞 其一","author":"王世贞","text":"吾子篇章贵，经旬思一搜。\n长怀愧薄劣，不敢问迟留。\n白日斗文动，青天璧色流。\n野夫何剧喜，万象总深愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9687,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中承三子各以五言二律相问率尔有答酬于鳞 其二","author":"王世贞","text":"落魄吾仍在，沉冥尔若何。\n即容双眼白，转见二人多。\n燕市轲离辈，沉酣亦笑歌。\n愁还付天地，名不废江河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9688,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬子与 其一","author":"王世贞","text":"一榻专吾过，春风细讨论。\n子桑容被发，泄柳故应门。\n抱病雄心改，违时大雅存。\n诗来重嘘借，未敢对人言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬子与 其二","author":"王世贞","text":"斗酒相劳苦，清吟未寂寥。\n岂应耽落魄，或自厌扶摇。\n礼乐穷逾远，迂疏病转骄。\n子其称籍籍，吾欲付陶陶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬子相 其一","author":"王世贞","text":"美人忽相赠，佳句比南金。\n客讶山涛札，予知湖海心。\n已能苏病骨，不必问知音。\n把向中庭诵，明河秋色深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬子相 其二","author":"王世贞","text":"但使频辞病，吾生乐自偏。\n已无官长束，兼得故人怜。\n雨色残虹外，乡心过雁前。\n纵有耽诗癖，年来实怕传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴人杜惠由小侯弃官归卧好谈玄理余时避地过从甚得赋此赠之 其一","author":"王世贞","text":"何必避名姓，雅无廛市风。\n少年结剑客，中岁礼壶公。\n白石贫家事，青山静者功。\n买田从此约，俱卧五湖东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴人杜惠由小侯弃官归卧好谈玄理余时避地过从甚得赋此赠之 其二","author":"王世贞","text":"岂谓窜身地，过从意不孤。\n以君初厌武，要我亦逃儒。\n细雨蒲团坐，荒畦竹杖扶。\n自言唯一事，频累酒家胡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白河道中 其一","author":"王世贞","text":"极浦明鹅鹳，天空双橹哀。\n河流树杪出，山色雨中来。\n惊鲤超鱼网，归鸿度酒杯。\n推篷坐箕踞，乡思亦悠哉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"白河道中 其二","author":"王世贞","text":"予亦金鸡使，聊乘青雀船。\n平生托湖海，此际失风烟。\n野色纾长啸，渔歌起扣舷。\n故人谁赠我，司马壮游篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病承公实诗问率尔有酬","author":"王世贞","text":"相逢尽年少，那可问投閒。\n偶尔弹流水，知君念故山。\n青云谢腾踔，明月写潺湲。\n昨夜罗浮色，宛然眉宇间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重过张太学因赠二首 其一","author":"王世贞","text":"忆昨丁年客，听歌子夜长。\n葡萄浓不泻，琼树俨分行。\n别思花如霰，归途月似霜。\n重来但立壁，蜗迹在胡床。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重过张太学因赠二首 其二","author":"王世贞","text":"万里皇华节，殷勤委巷寻。\n向来逢一饭，兹意失千金。\n易忆穷途事，谁馀往日心。\n茫茫燕市筑，曲罢几知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"见德州李帅谈边事有感","author":"王世贞","text":"秋色大荒甚，单于吹角时。\n移营千障急，转饷九边迟。\n国事俱黄口，材官几白眉。\n向来歌舞地，回首半疮痍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"与周叔夜论诗","author":"王世贞","text":"近来称作者，屈指问知音。\n骨格谁真近，声名尔自寻。\n中天秀岳色，大海郁龙吟。\n一出无今古，时才总陆沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夕沛河汎舟 其一","author":"王世贞","text":"玉镜中天挂，金波大地流。\n河明千树色，秋满万家楼。\n迥夺鱼龙卧，平添乌鹊愁。\n故园卢女瑟，应复问刀头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"中秋夕沛河汎舟 其二","author":"王世贞","text":"万里人初半，三秋月正中。\n天清凉似水，江阔静还风。\n玉借蓬莱馆，珠悬碣石宫。\n时闻沛儿唱，犹数汉皇功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"新河道中","author":"王世贞","text":"谁遣风尘里，沧浪意不违。\n波光一雨合，秋色众山归。\n乍可渔竿老，那能马足肥。\n长歌向林薄，红叶尽翻飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将渡江泊仪真即事有感","author":"王世贞","text":"海色将秋远，潮声挟雨振。\n地严催鼓角，帆迥入星辰。\n薄禄偏为客，他乡易畏人。\n宁知一水外，日夜有垂纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丹阳","author":"王世贞","text":"垂晚丹阳道，高秋白下船。\n人因乡语狎，吾岂宦情偏。\n野酿浮橙绿，香粳入鲙鲜。\n向来看雨色，衰草蓟门天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将抵家有怀云鹄给事 其一","author":"王世贞","text":"与君终日醉，犹恨故山违。\n天欲塞鸿尽，秋先枫叶归。\n青油使者舫，白苧女郎衣。\n总是江南乐，乾坤旧侣非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将抵家有怀云鹄给事 其二","author":"王世贞","text":"地入长洲苑，天回锦绣乡。\n归来虽慰藉，朋旧实凄凉。\n万事存知己，孤臣易断肠。\n祗应青琐客，南望或停觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠张节计偕北上遂访历下生","author":"王世贞","text":"自别李生久，乾坤吾不容。\n汝才今倚马，于辨复雕龙。\n一见时名失，千年国士逢。\n当令蓟门树，不复响秋蛩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻京师诏下志喜 其一","author":"王世贞","text":"斧钺严清禁，风霜动紫霄。\n向推聊试鲧，终殛岂惭尧。\n逆党谋全折，骄兵气欲消。\n普天欣止战，吾计可渔樵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻京师诏下志喜 其二","author":"王世贞","text":"此日欃枪扫，何云落将星。\n中原无战伐，高庙有神灵。\n一代家仍赤，千秋史更青。\n当知窦车骑，勒碣尚垂铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻京师诏下志喜 其三","author":"王世贞","text":"将相须才致，时来亦偶然。\n国威推毂重，君宠解衣偏。\n白刃宁求敌，黄金自有权。\n汝曹判一死，天地正风烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"闻京师诏下志喜 其四","author":"王世贞","text":"闻道将军第，荆榛车马稀。\n交游愁姓字，部曲掩光辉。\n日月明何损，君亲计总非。\n陇西羞李氏，敢道汉恩微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画","author":"王世贞","text":"卜筑人间远，沧浪秀可餐。\n长天一鸟去，明月数鸿残。\n何处迎风奏，流音度远湍。\n匡床醉欲醒，秋色不胜寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阻风湖口 其一","author":"王世贞","text":"雨色千艘转，涛声万马驱。\n河山归惨淡，天地失须臾。\n独坐思舟楫，微官任道途。\n何堪一群雁，失侣自哀呼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"阻风湖口 其二","author":"王世贞","text":"津吏迎相挽，孤帆尽日稽。\n束云淮县小，崩浪楚山低。\n风雨千灵集，乾坤七圣迷。\n长安不可望，畏路重含悽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仲冬六日江比部来言昨君生日也予始记书此自解","author":"王世贞","text":"忽忽吾何有，纷纷强自支。\n生辰公牍过，佳节故乡知。\n窃禄难轻引，为郎敢望移。\n西京珥貂客，白发总?垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪后晨起小酌有作","author":"王世贞","text":"一夜大荒白，孤城吾眼明。\n仙人吹玉笛，飞步下瑶京。\n细酌千愁改，冥搜万象惊。\n古来得意事，岂必勋与名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过比部朱丈射陂草堂二首 其一","author":"王世贞","text":"客有孔融刺，君还徐稚床。\n著书深草色，悬璧竞湖光。\n意气寒温简，郎官岁月长。\n踟蹰醉将别，吾意未能忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过比部朱丈射陂草堂二首 其二","author":"王世贞","text":"入君宴息处，香气似禅居。\n趺坐心相语，真文手自书。\n青天裋褐素，落日巾柴车。\n不道身犹贵，山人恐未如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长至前一夕丹徒道中","author":"王世贞","text":"积朔疑无际，微阳始渐临。\n漏偏今夜永，寒自客途深。\n剑佩仙曹梦，衣裳稚子心。\n那堪更飘泊，拥被独愁吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡江即事有感","author":"王世贞","text":"吴楚一江合，风烟万里开。\n秋天鹦鹉笔，日莫凤凰台。\n流落犹惊世，英雄始忌才。\n如何对玉轸，弦绝重徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"除夕","author":"王世贞","text":"久客家能好，残年日怕归。\n鬓毛馀感慨，童稚转光辉。\n目与闽云尽，心随蓟雁飞。\n酒醒予梦破，遮莫问朝衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"北使至有感","author":"王世贞","text":"在野将成习，降心欲近禅。\n人来蓟门雨，吾醉阖闾天。\n未敢轻时事，终知短世缘。\n看他江畔柳，早晚弄云烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同诸君汎虞山下二首 其一","author":"王世贞","text":"不尽青山色，维舟雨后看。\n閒云流几上，飞瀑散林端。\n游女千花暝，狂歌万竹寒。\n未须疑酒盏，吾岂任衣冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"同诸君汎虞山下二首 其二","author":"王世贞","text":"鼓柁江南遍，兹游颇更雄。\n天疑破柱刹，山似逐推篷。\n吹笛泉声外，披襟雨色中。\n前溪正宛转，不必念途穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":9726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]