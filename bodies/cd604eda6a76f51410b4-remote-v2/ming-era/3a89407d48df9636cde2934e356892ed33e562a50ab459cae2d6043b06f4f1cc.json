[{"title":"怀远雨夕","author":"黄公仪","text":"江郡东来此要津，万山如戟斗嶙峋。\n舟航阻绝经商路，车马踌躇问驿人。\n风至烟尘常扑面，雨馀沾湿不容身。\n愁听门外桓伊笛，何用喧喧动四邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28502,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得同社欧嘉祝秋闱捷报","author":"黄公仪","text":"夙盟谁不羡藏珍，到此欣闻脱颖新。\n三献已知终售主，一鸣应自足惊人。\n唱来白雪称高调，步去青霄已绝尘。\n明日上方逢给扎，长扬羽猎更无伦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28503,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"署中梅花","author":"黄公仪","text":"小院寒梅冬著花，似迎春意到窗纱。\n淡香枝上霜疑密，疏影林间月欲斜。\n吟处何如官阁动，折来将寄陇头遐。\n閒情不作师雄梦，皤鬓偏惊对物华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28504,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登河池城看筑工","author":"黄公仪","text":"孤城一上一伤神，佚道犹难信子民。\n累土莫忧过百雉，结茅今已历三旬。\n山来粤北连多隘，地去黔西在接邻。\n近报荒蛮窥四境，正思戎马泪沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28505,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吴守戎招集寿佛阁","author":"黄公仪","text":"新筑禅林傍水隈，北城连骑快追陪。\n正逢过雨频挥麈，有约观涛复举杯。\n难向风尘嗟吏隐，便于词赋识仙才。\n须臾霁月山头见，似共慈云落上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28506,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周邑侯枉过村居","author":"黄公仪","text":"郎星行部及春和，老稚争迎睹玉珂。\n曲巷向逢仙吏寡，应门今报使君过。\n为怜折节忘轩冕，何限留馨在薜萝。\n苍赤安危劳置问，保釐谁不望恩波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28507,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初至苍梧有作","author":"黄公仪","text":"南纪遨游兴不孤，扁舟今始过苍梧。\n峡中赤水还朝夕，洞里丹砂问有无。\n百雉河山成锦绣，千帆榷酤奉征输。\n邮亭未可逢关吏，漫学终军浪弃繻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28508,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和洪启进游崆峒岩","author":"胡秉忠","text":"崆峒青漾博麻洲，削壁孤县势欲浮。\n塿埠莫遮天转阔，尘嚣不到地偏幽。\n登临好趁星霜晓，凭眺还怜海国秋。\n肯遣韶华随腊去，且将岩色隔年收。\n参玄此日留真诀，隐雾还谁卧敝裘。\n风景不殊应有待，山灵几幸使君游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28509,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春尽喜南薰","author":"梁元最","text":"浮云不可扫，落日春光老。\n过雨碎飞花，夕阳薰细草。\n蝶怨晓风忙，蝉爱浓阴好。\n东郊车马停，西园芰菱早。\n有客有客自弹琴，一曲南薰舒素抱。\n恍如江上水龙吟，乍觉游鱼浮绿藻。\n飘飘清响入云霄，仙子乘鸾羽衣皓。\n东风吹尽锦堂春，白眼青天歌浩浩。\n知音千古者云谁，我欲从之向霞岛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28510,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望匡庐","author":"梁元最","text":"飞瀑挂晴空，归帆荡晓风。\n人烟千里外，古寺万山中。\n地接荆吴杳，江连湘沅通。\n临流发长啸，心与远公同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28511,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冬日同熊伯真集诃林迟梁兆瑚不至","author":"梁元最","text":"并是倦游者，言寻物外缘。\n断鸿过别渚，疏雨暗诸天。\n遥忆梅初绽，犹怜菊尚妍。\n迟回归骑晚，钟响度林烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28512,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初至西湖","author":"梁元最","text":"一棹寒烟雪满蹊，六桥犹惹旧香泥。\n孤山亭畔无多路，山色湖光待品题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28513,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同幼宁兄李豹奴张秋姬泛舟采莲日暮始归 其一","author":"梁元最","text":"桂棹逶迤度小溪，芙蕖稠叠路偏迷。\n歌声半在花间出，属玉惊飞过水西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28514,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同幼宁兄李豹奴张秋姬泛舟采莲日暮始归 其二","author":"梁元最","text":"玉腕纤纤荡桨迟，双鬟风卷绿丝丝。\n芙蓉隔水相迎笑，妒杀佳人绝世姿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28515,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日同幼宁兄李豹奴张秋姬泛舟采莲日暮始归 其三","author":"梁元最","text":"一曲溪光一曲花，船头箫管并筝琶。\n徘徊花里无人见，不觉湖西日已斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28516,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望岱","author":"罗奕佐","text":"崔嵬乎，泰山之高高于青天，撑持东北雄吴燕。\n俯瞰青徐大野连，黄河下折飞流泉。\n七十二代同封禅，秦松汉石锁寒烟。\n中有真人检玉篇，餐芝吸露何飞仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵歌","author":"罗奕佐","text":"先皇长策鞭九区，江山蜿蜒开神都。\n江连二水成天险，地值三山控帝图。\n帝城宫阙天中起，拥骑鸣珂半朱紫。\n繁华虚想六朝馀，栉沐应须念丰芑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"日落","author":"罗奕佐","text":"日落江风起，天寒海雾迷。\n岸欹仍削壁，沙尽更斜溪。\n野草山山火，荒村处处鼙。\n感时伤暮色，沉醉任羁栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惠来晚发","author":"罗奕佐","text":"整驾出孤城，中天月尚明。\n雪花侵野白，烟树隐林平。\n山逐行人改，云从去马生。\n传言大陂口，畏路转关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漂母祠","author":"罗奕佐","text":"为访淮阴迹，犹存漂母祠。\n千秋无霸业，一饭有遗思。\n草带王孙恨，蝉馀国士悲。\n飘零吾自笑，寄食好依谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与东丈并桨南归索余鹪鹩园诗舟次鹅湖萧然无事辄以艰韵成之政得五首言之不次冀略之耳 其一","author":"罗奕佐","text":"会心不在远，人境寄幽栖。\n夹竹开丛径，穿池灌药畦。\n閒行扫石坐，得意剪桐题。\n岂但冥鸿理，还看养木鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与东丈并桨南归索余鹪鹩园诗舟次鹅湖萧然无事辄以艰韵成之政得五首言之不次冀略之耳 其二","author":"罗奕佐","text":"一区虽近市，半亩暗通江。\n高柳低城堞，流萍漾绮窗。\n窥纶鱼泼泼，饮砚鸟双双。\n不厌南邻近，从君倒玉缸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与东丈并桨南归索余鹪鹩园诗舟次鹅湖萧然无事辄以艰韵成之政得五首言之不次冀略之耳 其三","author":"罗奕佐","text":"君怀鸿鹄志，且托鹪鹩巢。\n野槿红相映，幽篁翠欲交。\n人疑张仲蔚，园近孟城坳。\n自有凌云赋，无劳作解嘲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与东丈并桨南归索余鹪鹩园诗舟次鹅湖萧然无事辄以艰韵成之政得五首言之不次冀略之耳 其四","author":"罗奕佐","text":"一丘吾未遂，三径尔宁眈。\n玄豹山中雾，苍虬江上潭。\n卷帘花气入，散帙水光涵。\n何日投云壑，相期更结庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与东丈并桨南归索余鹪鹩园诗舟次鹅湖萧然无事辄以艰韵成之政得五首言之不次冀略之耳 其五","author":"罗奕佐","text":"选地非关僻，为幽胜自添。\n短篱藏曲折，片石露锋尖。\n茶火轻摇竹，城云半压檐。\n此中心便远，何事学陶潜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中即事","author":"罗奕佐","text":"静处不知晓，晏眠人未醒。\n凉生一夜雨，洗出四山青。\n蝉影隔深竹，云光留小亭。\n寂然浑无事，起读太玄经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"逢一载酒夜过燕邸","author":"罗奕佐","text":"不是扬雄宅，谁人载酒来。\n鸣驺惊犬吠，掩户命童开。\n客计怜同调，乡心共一杯。\n帝城今少禁，车骑任迟回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀内兄潘子科","author":"罗奕佐","text":"动忆龙舟别，劳将雁字频。\n功名三寸舌，湖海一閒身。\n客思惊花露，归期及稻新。\n浮沉千古意，寄语下机人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浩溪晚泊怀客无极","author":"罗奕佐","text":"江雾远含空，川原望不穷。\n灯明烟渚外，人语水声中。\n漂泊同舟舸，交游类转蓬。\n卷帘宵不寐，吟望穗城东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"莫村驿风雨骤至","author":"罗奕佐","text":"带月开头罟客喧，江风怒号雨翻盆。\n长涛乍涌天兼合，古岸欹悬昼欲昏。\n何处郊原回独马，有时山壑啸孤猿。\n丈夫飘荡浑无着，徒倚酣歌望远村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"双忠庙","author":"罗奕佐","text":"翠华西幸拥戈兵，突兀睢阳守汉旌。\n信有刚肠支百战，不将枵腹弃孤城。\n涛声似写江淮恨，庙貌真悬旅客情。\n倚剑为君歌易水，萧萧风雨海门生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文相祠","author":"罗奕佐","text":"汴杭回首事成空，野庙萧条榛棘中。\n不为翠华勤一旅，可留丹史照孤忠。\n杯倾立马精灵在，魂逐啼鹃血泪红。\n只有五坡遗旧恨，年年秋树隐悲风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立秋日抵家","author":"罗奕佐","text":"杨柳新舒帝里过，梧桐初下返烟萝。\n堪娱老大加餐健，犹喜儿童识字多。\n燕垒经秋还傍主，柴门依旧亦张罗。\n黄金白发休相问，箕踞风前但啸歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初赴公车亲友子弟饯送江上","author":"罗奕佐","text":"汉帝徵贤日，长卿入洛年。\n祇应乘遘会，非敢薄云烟。\n万里辞亲苦，连枝恋弟偏。\n稚儿犹解别，诸友亦相牵。\n送送临江浦，迢迢望斗边。\n风尘双剑里，云树一杯前。\n兔影分行帐，鸡鸣理去船。\n寒灯投夜宿，孤桨入云穿。\n旅食凭兄在，长途仗仆怜。\n过邦非土俗，度岭异山川。\n腊去年应改，舟移月几圆。\n微名如可就，重聚小阳天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞来寺","author":"钟万芳","text":"延祚东移不复还，诸天祇在翠微间。\n冥冥倒日鼋鼍窟，曲曲穿云虎豹关。\n别院回廊深白昼，一尊流水注红颜。\n登台月上歌钟满，谁念长吟未出山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题贞山雨霁","author":"陆中田","text":"贞山云散雨初晴，踏破苍苔独自行。\n扫石竹高飞叶湿，挂衣松老落花轻。\n翠屏极目浑如洗，青鸟依人似有情。\n欲问仙踪何处是，龙池烟锁月长明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阴那山寺","author":"梁岳","text":"老树荒山半腹空，鸟啼猿啸月华重。\n游人身住蜗蝇窟，辜负弘慈午夜钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹署感事","author":"区龙贞","text":"中丞累诏援榆关，节钺长随塞外颁。\n南国十年输税尽，北庭何日羽书间。\n荒城笳落秦时月，绝岛屯高海上山。\n自听秋风铃铎响，几将封事过朝班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"南游","author":"王安舜","text":"众壑凌虚出，汪波万顷中。\n光浮星宿海，人在水晶宫。\n喷沫鱼儿浪，窥帘燕子风。\n隔江摇落早，相望采丹枫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登泰山","author":"王安舜","text":"泰山东望走群龙，直上天门第一峰。\n泉壑晴霞开罨画，长空飞雨洗芙蓉。\n残碑莫辩秦时字，断简曾埋汉武封。\n览胜欲摅天下目，不知身在古鸿濛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄士明宫詹李葵孺天部同集梁幼宁明府西园别业","author":"王安舜","text":"十亩平田一望赊，桐林叶叶散秋霞。\n因招太史先生驾，并过茆洲处士家。\n冰簟软披三径草，水晶香送六郎花。\n弄潮自有船如藕，不用虚乘贯月槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"偕刘方瀛陈虚白两明府集卢元明孝廉白云楼","author":"王安舜","text":"看竹名园过子猷，登仙今拟凤凰游。\n同时并结黄金绶，作赋齐登白雪楼。\n天爱郎星清伏日，地怜王气接丹丘。\n凭轩一睇三山路，人在方壶第几洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"济城春望","author":"王安舜","text":"二月三月倏忽过，桃花杏花参差开。\n家怜蝶梦三千里，肠断莺声十二回。\n缓颊懒谈天下事，知心惟有掌中杯。\n当门五树长条发，待我青青归去来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山寺","author":"曾道唯","text":"峭壁悬苍雪，孤亭驻半云。\n秋声随雁到，泉响共猿闻。\n倚槛江声绕，扪萝石磴分。\n何时凌绝顶，高揖紫霞君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠寺","author":"曾道唯","text":"梵宇奇檠石一拳，布金开刹自何年。\n回环四水全浮地，倒影长空小碍天。\n山翠北来供几案，海涛东簸拥楼船。\n琳宫剑垒看如此，沧海将无浅作田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋韩绪仲李伯襄二太史林元培工部过集待月","author":"曾道唯","text":"城阙微茫夜色悬，开尊秋半待婵娟。\n未看素魄流虚幌，止觉同云淡远天。\n禁漏暗惊欢会短，清光输向别时圆。\n明宵尚有南楼兴，肯信佳期动隔年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁仲玉侍御偶然堂新成志喜","author":"曾道唯","text":"离奇翠伯岁寒姿，燕雀堂前意自私。\n柱史五千垂笔地，元龙百尺卧楼时。\n交情似水池堪鉴，臣节如山石不移。\n伐木参随诸子后，嘤嘤聊和喜迁诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过潜山作","author":"黄圣期","text":"潜山翠削与云平，驻马偏饶览胜情。\n天柱日临诸岛近，石楼烟散列峰明。\n共传佐命分南岳，曾记登封礼玉清。\n何事笙歌长寂寂，松风空送晚涛声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄韩绪仲李伯襄二太史","author":"黄圣期","text":"岭云燕雪不同时，别后封书杳莫期。\n穗石天晴花送暖，御河冰泮玉流澌。\n冥冥旅雁飞沙急，哑哑栖乌绕树迟。\n知尔苑中联句好，早莺啼处使人思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春意和李葵孺","author":"黄圣期","text":"春晴二月烂烟花，花飞夹道倩春华。\n柳条春归含晚翠，洞房春起带朝霞。\n珠箔绣帏春窈窕，春暖兽炉香袅袅。\n莫道妆台无复春，梅花昨夜春多少。\n殷勤绿鸟弄春频，细蹴春霙动绛尘。\n已曳春容回锦簇，还铺春彩绽华茵。\n华茵锦簇春将待，七宝香车春满载。\n谁家游冶竞探春，探春转觉春如海。\n春色今时异往时，浅碧轻红春早知。\n不信春光能久驻，不信春心能自持。\n春去春来空暗忆，两两春禽看比翼。\n薄衾无奈可怜春，轻寒几透春消息。\n日高慵起试春衫，春妆临镜羞尘函。\n春闺何事关春梦，春江何处着春帆。\n春日怀人朝复暮，侍儿未解伤春苦。\n忙报春风到锦堂，骄春桃李开无数。\n漫凭晓閤对春晖，春晖如自媚春衣。\n春云冉冉香丛叆，春山澹澹黛烟微。\n草色经春无恙碧，春尽王孙归不归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"舟行即事","author":"黄圣期","text":"放舟出远浦，日色午仍昏。\n风起溪溪叶，云遮岸岸村。\n江鱼翻浪出，汀鸟逐沙喧。\n旅泊知何定，飘飘任海门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"紫竹洞","author":"黄圣期","text":"雅有扶筇兴，来寻紫竹幽。\n远闻孤磬出，疑是半空浮。\n扫石窥僧榻，看山倚佛楼。\n顿灰尘俗虑，应为白云留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园亭漫兴 其一","author":"黄圣期","text":"小筑傍花丘，官閒或寄留。\n稍怜尘境绝，兼爱野情幽。\n云树晓全暝，风林午近秋。\n盘桓不觉久，于此坐销忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园亭漫兴 其二","author":"黄圣期","text":"竟日未云涉，初晴一杖藜。\n石床经雨湿，藤架接云低。\n水决新渠溢，花深旧路迷。\n坐来幽兴洽，得句剪桐题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园亭漫兴 其三","author":"黄圣期","text":"阒寂一蓬门，经时独晤言。\n物情原不竞，吾道故常尊。\n养性惟栽树，谋生或灌园。\n偶来从所好，不是学逃喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"园亭漫兴 其四","author":"黄圣期","text":"简懒空成癖，劳劳愿转违。\n漫寻桑者乐，稍息丈人机。\n树密凉生早，亭空暑到微。\n午眠长自足，偃仰憺忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七星岩","author":"黄圣期","text":"何年驱石贮仙家，曲磴岧峣鸟道赊。\n玉乳低悬迷日月，碧萝高挂积烟霞。\n明河盥去星堪摘，孤掌擎看柱欲斜。\n到日瑶台秋正好，可谁同驭五云车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"严陵钓台","author":"黄圣期","text":"日暮江寒隐富春，客星曾此濯清尘。\n一竿把钓仍堪老，五月披裘未压贫。\n素业自应留水石，高名终拟傲麒麟。\n桐江系鼎丝千尺，岂为狂奴洽隐沦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石门洞","author":"黄圣期","text":"石洞龙盘一径回，偶因汗漫破苍苔。\n坐临琼岛流霞上，人自蓬壶御冷来。\n百道飞泉天外出，千岩翠色雨中开。\n醉来还弄柯亭笛，飒飒松风吹落梅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其一","author":"黄圣期","text":"朝来爽气满檀栾，坐对西山拄笏看。\n玉井远含诸壑静，碧云晴锁半峰寒。\n殿前古柏团苍盖，湖上仙舟隐翠翰。\n遥忆宸游当此地，百灵趋走护金銮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其二","author":"黄圣期","text":"帝子当离象魏悬，丽谯高望更巍然。\n黄霾倏噎三春雨，赤焰频惊四月天。\n雉堞千盘依燕雀，翚飞一炬落蜿蜒。\n村官指点营城日，圣主端居光宅年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其三","author":"黄圣期","text":"天府元称二百重，园陵北望枕居庸。\n可堪塞岭时宵猎，几处边城起夕烽。\n马市频年虚议款，虏王当日漫谈封。\n四郊自此方多垒，三辅何时竟乐农。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋怀 其四","author":"黄圣期","text":"神京壮丽象昭回，阊阖门从碧汉开。\n南海晴光连禁苑，西山翠色敞楼台。\n万方贡使天边入，三殿材官日下来。\n欲向帝城一纪胜，抽毫终愧掞天才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]