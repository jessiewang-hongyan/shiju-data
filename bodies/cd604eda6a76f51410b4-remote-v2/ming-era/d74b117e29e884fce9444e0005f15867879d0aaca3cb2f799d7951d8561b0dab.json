[{"title":"过廖子故宅","author":"王廷陈","text":"庭树留尊处，空馀覆苑云。\n驯阶旧鸟雀，落日噪纷纷。\n琴罢广陵散，匣遗封禅文。\n悲风立马际，邻笛不堪闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21534,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游仁寿寺","author":"王廷陈","text":"鹫岭回孤塔，祗林郁近城。\n幽人耽寂乐，秋日偶经行。\n岩閤萦萝细，溪庭抱竹晴。\n欣然坐禅榻，聊以憩尘缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21535,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"九日登仁寿寺后山","author":"王廷陈","text":"九日携朋出，花宫背郭开。\n藉兰坐香岫，扪棘临高台。\n雁渺川云断，林孤甸色回。\n悲秋亦楚客，作赋岂吾才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21536,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜坐郑子宅弹琴分韵得琴字","author":"王廷陈","text":"言访少谷子，呼童携素琴。\n为发丝桐趣，俱谐山水心。\n径转松篁密，堂虚风月侵。\n再弹吾不惜，此地有知音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21537,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄八厓子","author":"王廷陈","text":"吾子嗟行役，他乡感别离。\n一辞西掖路，三复北山诗。\n日下花骢出，天边旅雁悲。\n亦知复不远，明岁及瓜期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21538,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄颜许州","author":"王廷陈","text":"吾友二三辈，无如回也贤。\n惭非清庙曲，得藉朱丝弦。\n岂乏双鱼至，宁悭尺素传。\n离群今已久，望子数予愆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21539,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送龙廷重为荥府长史 其一","author":"王廷陈","text":"荥国今宗国，君材实楚材。\n周家亲鲁卫，梁苑重邹枚。\n杖屦丘园接，琴书殿阁开。\n天边倦飞鸟，霜雪早归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21540,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送龙廷重为荥府长史 其二","author":"王廷陈","text":"未谢金门籍，先谐静者私。\n桃源春泛稳，桂苑月游迟。\n洞口渔人艇，花间帝子卮。\n兹行有词赋，不必吊湘累。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21541,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"得周侍御子贤书喜作二首 其一","author":"王廷陈","text":"自尔乘骢出，令予怆别离。\n经年一书札，万里转相思。\n天隔西南域，秋怜鹰隼姿。\n霜空望系搏，莫使羽毛垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21542,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"得周侍御子贤书喜作二首 其二","author":"王廷陈","text":"去岁吾乡友，追陪良可欢。\n月吟耽夕槛，花宴簇春栏。\n岂意乖云雨，翻令隔羽翰。\n独怜松桧色，青翠耐天寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21543,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雪柬曹子","author":"王廷陈","text":"君本建安子，来游京兆天。\n时闻郢中曲，共忆剡溪船。\n庭筱暝犹白，槛萝春欲烟。\n何当载酒过，一问子云玄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21544,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠方子二首 其一","author":"王廷陈","text":"近接棠陵子，昂藏野鹤姿。\n迹留青琐地，声彻白云司。\n竟阻江湖去，翻嗟燕雀欺。\n烟霄当奋起，归觅旧栖枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21545,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赠方子二首 其二","author":"王廷陈","text":"邻并复同调，过逢数举杯。\n谢公兴不浅，庄舄吟何哀。\n霞日赤城晓，雪涛沧海回。\n何当共舟去，携客访蓬莱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21546,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"立春","author":"王廷陈","text":"春旭自堪怜，春愁旅病偏。\n暄回沙甸雪，润合柳城烟。\n坐忆江皋上，行知草树鲜。\n淹留慨时序，盘菜不须传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21547,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"天津月夜偕曹子舟坐","author":"王廷陈","text":"系月舟航偶，临流鼓吹哀。\n星樯扶岸出，霜叶洒汀回。\n鹊起南天迥，龙吟北海开。\n淹留候明发，共尔一登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21548,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"河西务别许子居","author":"王廷陈","text":"留滞金门客，追陪画省郎。\n开筵回浦溆，倚槛出帆樯。\n琴动幽兰操，诗传伐木章。\n风尘连解缆，天地一沾裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21549,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"晚泊访李仲玉","author":"王廷陈","text":"宵泛事幽寻，危岩倒月侵。\n石门面苍渚，桂楫倚丹林。\n风竹和龙笛，冰弦藉凤琴。\n酒阑各分手，天汉忽横参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21550,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"临清舟次别曹子三首 其一","author":"王廷陈","text":"忆昔同严谴，随君下琐闱。\n龙蛇寒自逝，鹓鹭晚分飞。\n棹戛城氛渺，樯翻浪月微。\n转令岐路泪，暗满逐臣衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21551,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"临清舟次别曹子三首 其二","author":"王廷陈","text":"对酒话今昔，茫然来远阴。\n逆鳞批不死，回首感何深。\n此地一分手，他乡长别心。\n所期持壮节，无复计升沈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21552,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"临清舟次别曹子三首 其三","author":"王廷陈","text":"寡合时应弃，多忧日不胜。\n汉京瞻比日，周道履如冰。\n顾已无长策，徒然负直绳。\n畏途各自爱，旧署望同升。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21553,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李沔阳自大梁经裕州因赠三首 其一","author":"王廷陈","text":"雪夜梁王宴，霜秋宋玉愁。\n回瞻嵩岳峙，去逐楚江流。\n少室三花树，沧浪一叶舟。\n南行正摇落，知尔忆林丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21554,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李沔阳自大梁经裕州因赠三首 其二","author":"王廷陈","text":"湖水回城郭，风流暇日多。\n宵追李白泛，时听越人歌。\n伐鼓惊鸥鹭，扬桡拂芰荷。\n须君为地主，独舸杪秋过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21555,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"李沔阳自大梁经裕州因赠三首 其三","author":"王廷陈","text":"爱汝今山简，为邦复水乡。\n幽怀寄鱼鸟，俭德续羔羊。\n凭几烟霞润，搴帷兰杜香。\n谁知词客兴，不下大夫堂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21556,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"斋中即事","author":"王廷陈","text":"候吏经旬少，深秋百感生。\n苍苔侵竹户，白日下枫城。\n鼓瑟焚香坐，窥园散发行。\n天边暮鸿雁，故傍客愁鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21557,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"被逮道中别舅氏归","author":"王廷陈","text":"殊方秋更苦，失路暂相将。\n身世悲江夏，轩车感渭阳。\n勿传三木惨，骤使二亲伤。\n会有生还日，心无愧彼苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21558,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"被逮发裕州夜作呈诸公","author":"王廷陈","text":"空馆秋偏寂，穷途旅易哀。\n砌虫迎夕动，塞雁预寒来。\n肱已经三折，肠应倍九回。\n愿逢吹律者，坐使积阴开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21559,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"怀故园书屋往年同伯兄讲业其中","author":"王廷陈","text":"北游深岁月，南望阻关河。\n尚想双龙卧，翻惊独雁过。\n梦劳扳径柏，春拟葺垣萝。\n回首藏修地，浮名奈尔何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21560,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"有感二首 其一","author":"王廷陈","text":"多难已如此，良朋今是谁。\n傍观纷窃笑，对泣一空悲。\n虎口几不免，人心安可知。\n古交难获睹，三复谷风诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21561,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"有感二首 其二","author":"王廷陈","text":"平生矜结客，一旦失交亲。\n掉臂不我顾，开心欲谁陈。\n转见弯弓者，那闻击筑人。\n翻思古游侠，高义亦嶙峋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21562,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出絷俟放久未获命煎郁成诗","author":"王廷陈","text":"待罪形将影，言归去复留。\n悲风怜代马，喘月愧吴牛。\n画地心犹惮，呼天泪莫收。\n强颜称不辱，俛首欲何求。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21563,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出狱董氏宅夜饮书怀兼赠董氏兄弟","author":"王廷陈","text":"多难心逾壮，高情宴独迟。\n风篁迷晚径，烟草暗春池。\n射虎还疑石，惊乌尚绕枝。\n缘君念兄弟，把诵鹡鸰诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21564,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出狱后归兴二首 其一","author":"王廷陈","text":"幸尔网能漏，依然剑尚埋。\n侧身向天地，壮志委尘埃。\n覆水今无及，怀沙古有哀。\n回思刀笔吏，疑惧转难裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21565,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"出狱后归兴二首 其二","author":"王廷陈","text":"孤愤辞梁狱，高歌望楚乡。\n烟花春沔鄂，楼阁昼潇湘。\n吊古怀增慨，寻仙事颇荒。\n何如共渔父，一笑咏沧浪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21566,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"同子言南归道中赋竹桃二物","author":"王廷陈","text":"旧潜湘浦岸，兼慕武陵源。\n独造非无兴，成蹊本不言。\n七贤应共逸，三士竟何冤。\n物态依行色，羁栖想故园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21567,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"道中憩废寺三首 其一","author":"王廷陈","text":"徙倚前朝寺，依栖旧法筵。\n狐狸啼白昼，龙象泣诸天。\n宝树萦蛛网，蜗涎绣石莲。\n给园犹寂寞，岐路倍堪怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21568,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"道中憩废寺三首 其二","author":"王廷陈","text":"解绶辞尘网，停车理石筵。\n金花何地布，宝月几时圆。\n殿古苍苔积，台空紫蔓县。\n那知临净土，烦恼障无边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21569,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"道中憩废寺三首 其三","author":"王廷陈","text":"宝地元虚寂，金仙合杳冥。\n空林沈紫翠，画壁落丹青。\n羁旅暂投迹，残僧一启扃。\n迷方随处是，含意讯山灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21570,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送人","author":"王廷陈","text":"楚地惜分手，春风怅别颜。\n王孙草新绿，帝子竹馀斑。\n干主携书去，期君扬策还。\n男儿有如此，应不滞乡关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21571,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江上言怀四首 其一","author":"王廷陈","text":"野阔风云入，天回楚蜀通。\n渚禽多白鹭，岩树半青枫。\n哀怨湘君曲，平成夏后功。\n晚来怀古意，极目送冥鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21572,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江上言怀四首 其二","author":"王廷陈","text":"岸束涛声急，轩凝野色重。\n山悬神女雨，江进楚王风。\n舟楫争先涉，闾阎急暮舂。\n平生壮游兴，潦倒对鱼龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21573,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江上言怀四首 其三","author":"王廷陈","text":"平野苍烟合，高城白鸟过。\n泽兰怀楚客，石竹隐湘娥。\n谷响归樵唱，江鸣发棹歌。\n夕阳葭菼际，将奈暮愁何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21574,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江上言怀四首 其四","author":"王廷陈","text":"月上船犹进，江寒酒自宽。\n弄珠元此夕，解佩复何滩。\n岛屿樽前动，星辰镜里看。\n渔歌中夜起，余亦饬纶竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21575,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"暮春偕二三子登定惠院亭","author":"王廷陈","text":"台榭枕黄州，春深岸帻游。\n云孤开石壁，地拔俯江楼。\n触目烟花散，伤心岁月流。\n弃捐知己矣，童冠几销忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21576,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"席上赠熊掾","author":"王廷陈","text":"吏事资儒术，秋筵接故乡。\n周官钦八议，汉法重三章。\n亭倚林峦赤，园看橘柚黄。\n卑栖勿叹息，毛质本鸾凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21577,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜简王少参舟中","author":"王廷陈","text":"薇省辞黄鹤，兰桡伴白鸥。\n岸回霜月抱，江迥雪云流。\n银汉乘宵上，金陵逼岁留。\n田租闻赐减，侧识汉皇忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21578,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"观江涨","author":"王廷陈","text":"旬月一来此，怀襄真可忧。\n龙蛇栖树杪，鸥鹭集城头。\n天接江湖混，波摇郡邑浮。\n青钱吾已办，急为买渔舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21579,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"春日书室示诸子","author":"王廷陈","text":"家声看子弟，世绪衍箕裘。\n豹隐文当变，莺鸣友可求。\n专门大戴礼，入室汝曹优。\n闾里高门在，须乘驷马游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21580,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"刘子好辩而不遇诗以赠之","author":"王廷陈","text":"美名吾久识，雄辩古难逢。\n君独谈非马，人皆好似龙。\n早于干禄拙，晚向结交慵。\n予亦栖迟者，相将学老农。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21581,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄馆中诸友","author":"王廷陈","text":"一斥嗟江国，同游忆禁林。\n如闻视草暇，犹有拔茅心。\n人事伤川逝，吾生叹陆沉。\n百年频泣玉，众口已销金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21582,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"江上赠夏明府","author":"王廷陈","text":"令尹官初试，江邦政已成。\n节如秋壁峻，心拟石潭清。\n愿契烹鲜理，无矜拔薤名。\n操刀知善割，爱助亦吾情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21583,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜廖子过访席上奉赠八首 其一","author":"王廷陈","text":"画舸经黄国，肩舆访白云。\n雪行沙草湿，风坐圃梅芬。\n轩冕非吾意，凫鸥本自群。\n无烦谈世事，杯酒但论文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21584,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜廖子过访席上奉赠八首 其二","author":"王廷陈","text":"供奉违东观，旋归侍北堂。\n衣冠照桑梓，词赋吊沅湘。\n野岸桃花发，春洲兰叶香。\n他时三径里，迟子洗壶觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21585,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜廖子过访席上奉赠八首 其三","author":"王廷陈","text":"自喜暂无拘，来从江海徒。\n寻仙憩黄鹤，谒帝向苍梧。\n泽坐舟偏系，山行杖屡扶。\n知君留滞处，高兴属春湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21586,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜廖子过访席上奉赠八首 其四","author":"王廷陈","text":"未暇泛湘水，徒然卧楚云。\n神龙那可系，野鹤故难群。\n世路谁知己，交情独有君。\n悬知今夜别，剑气斗间分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21587,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜廖子过访席上奉赠八首 其五","author":"王廷陈","text":"霄汉长怀侣，江湖已卜居。\n山人惟白鹿，学士自银鱼。\n名致诸公早，书开万卷馀。\n汉臣谁得似，词赋有相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21588,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜廖子过访席上奉赠八首 其六","author":"王廷陈","text":"地迥临江阁，天回上斗槎。\n潜行歌白石，好去羡皇华。\n登岳元无极，浮湘未有涯。\n明朝相望地，莫遣暮云遮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21589,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜廖子过访席上奉赠八首 其七","author":"王廷陈","text":"别我寒移棹，怀君暮倚枫。\n来经黄子国，去傍楚王宫。\n谷口桃千树，山中桂几丛。\n故园春定好，留醉向东风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21590,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"喜廖子过访席上奉赠八首 其八","author":"王廷陈","text":"奉使仍将母，来游荆楚天。\n江光藉日色，争绕孝廉船。\n翠竹笋新茁，银丝鲙可怜。\n帆边梅柳树，历历汉阳川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21591,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"夜宴即事","author":"王廷陈","text":"楼开芳树合，径转落花深。\n向夕香风起，当筵皓月临。\n游人争解佩，侍女拾遗簪。\n坐上绝缨者，应知贤主心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21592,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄方思道七首 其一","author":"王廷陈","text":"赤壁陪仙宴，苍江识壮颜。\n使君趋石上，候吏出花间。\n解缆欲何往，投簪及此还。\n长风解相送，一瞬万重山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21593,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄方思道七首 其二","author":"王廷陈","text":"观日临沧海，归山卧白云。\n遥寻少谷子，同谒武夷君。\n心迹能兼遂，东南美并闻。\n犹期为世用，且莫去人群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21594,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄方思道七首 其三","author":"王廷陈","text":"偃卧非关病，连章秪乞骸。\n莺花供谑浪，杯酒送诙谐。\n无用樗因免，难容匏已乖。\n因风寄同调，好去入君怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21595,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄方思道七首 其四","author":"王廷陈","text":"闻尔游华顶，令予梦彩烟。\n户庭罗峭壁，枕簟落飞泉。\n山有藏书穴，溪多送酒船。\n春江如有兴，花里到吴天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21596,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄方思道七首 其五","author":"王廷陈","text":"忆尔东归日，长为吴会吟。\n春觞临水曲，夜棹入山阴。\n结侣游能数，逃人去转深。\n兰苕如可折，莫惜寄云林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21597,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄方思道七首 其六","author":"王廷陈","text":"逢时非不达，愤世独难平。\n拔剑出门去，扬帆际海行。\n虽贪谢客赏，犹系子牟情。\n此地便高卧，无令负圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21598,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄方思道七首 其七","author":"王廷陈","text":"中朝俱属望，流辈总相推。\n予慕长卿赋，人传幼妇碑。\n七襄终莫报，九逝竟空思。\n世路风尘满，茫无见汝期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21599,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉荅富顺王殿下二首 其一","author":"王廷陈","text":"帝室分封重，王孙别馆开。\n礼于南岳敌，客比小山才。\n为善心知乐，通亲表自裁。\n雄风难可挹，何日侍兰台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21600,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉荅富顺王殿下二首 其二","author":"王廷陈","text":"国自荆藩析，书从孔壁传。\n瞻天蒙肺附，朝海切心悬。\n宾从思梁苑，精诚感洛川。\n晚来风稍劲，吹月晕生圆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21601,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"马侍御见访山中 其一","author":"王廷陈","text":"村巷传呼急，秋园报尔过。\n乌啼城日晓，鹰疾野风多。\n绣服临樵牧，花骢驻薜萝。\n霜威吾所惮，暂为假阳和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":21602,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]