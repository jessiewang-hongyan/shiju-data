[{"title":"浮邱社怀赵太史 其一","author":"梁绍裘","text":"浮邱真境久堙芜，古径重开蒋大夫。\n楼挹山光临睥睨，窗含灵气接虚无。\n中朝大雅风流远，千载高贤胜事俱。\n遂使至尊劳顾问，忍分廊庙与江湖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"浮邱社怀赵太史 其二","author":"梁绍裘","text":"白社孤楼引望频，于今学士掌丝纶。\n洞云尚带宫袍色，峰日犹悬馆阁春。\n鹤驭飙轮仙客迥，銮坡天阙帝臣亲。\n江南处处多芳树，得似甘棠覆缙绅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过梅岭","author":"梁绍裘","text":"名相当年谁伯仲，杜房姚宋若为俦。\n韶阳俎豆瞻依切，唐代仪刑感慨收。\n功在梅关标绝巘，忠垂金鉴照千秋。\n古今岭表多贤俊，请看南邦第一流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文笔峰","author":"梁绍裘","text":"毓秀分明五指连，孤高雄峙斗牛前。\n词臣视草金闺晓，学士封题紫阁年。\n述作千秋藏石室，峥嵘常日带绯烟。\n非关梦彩方能赋，赓和长依尺五天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金鸡岭","author":"梁绍裘","text":"丹梯万仞紫云横，峰号金鸡玉削成。\n似报阳乌升海岳，已知春色满蓬瀛。\n恰随威凤仪虞世，不数灵祠祀汉京。\n太史只今调玉烛，山椒还见泰阶平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马鞍冈","author":"梁绍裘","text":"岐峰联络自依依，甲第连云映翠微。\n名借玉鞍骖帝乘，势如天马巩皇畿。\n高瞻日驭朋三寿，近接房星御六飞。\n嵩岳钟灵申甫出，古今人物转相辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14548,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"文笔峰","author":"梁子寿","text":"何年彤管插云霄，域内群峰夜自朝。\n望去乍疑青玉案，坐来堪与赤霞标。\n春深雪颖流云影，日下文光烛斗杓。\n一自长卿题柱后，千秋彩色满岧峣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14549,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金鸡岭","author":"梁子寿","text":"翠削奇峰迥不伦，春深瑞色散嶙峋。\n晴瞻海外三山秀，俯挹天南万户新。\n色借金乌开晓曙，形流绛帻报佳辰。\n谁言雄峙无长夜，特立苍苍捧赤轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14550,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"马鞍冈","author":"梁子寿","text":"回壑双峦迥自幽，天开形胜自南州。\n雕鞍似据风雷起，玉辇常依阁道游。\n匹练熹微开日观，长驱躞蹀向宸旒。\n从来渥水生龙种，石垄参差瑞气浮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14551,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招隐","author":"张鸣韶","text":"北风起高陵，商声振林木。\n林木日萧疏，曦阳照空谷。\n中有避世人，抗志守幽独。\n兰芷挹其芳，萝薜裁为服。\n落叶满山岑，飞溜鸣涧曲。\n远契古人踪，近想高士躅。\n抱膝苦长吟，玄机合淳朴。\n朱绂岂不荣，苟得非所欲。\n将遂从君游，惧君不我足。\n愿得浥馀风，四顾聆芳馥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14552,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江行杂咏 其一","author":"张鸣韶","text":"崇山削千仞，江海邈已深。\n游人千里道，回雪映高岑。\n遗餐感知己，一诺重千金。\n寒鸢据高树，惊风遥长吟。\n笑我饥且拙，行迈多苦心。\n叹息自悲伤，愿托征鸿音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14553,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江行杂咏 其二","author":"张鸣韶","text":"孤松生广陌，萧瑟盘高枝。\n上垂百尺萝，下瞰长江湄。\n迢迢经岁远，郁郁凌霜姿。\n匠石去不顾，令人怀伤悲。\n感兹烈士心，游行时苦饥。\n安得为君采，持作栋梁规。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14554,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"君子有所思行","author":"张鸣韶","text":"延伫长安陌，宫阙富逶迤。\n金张侈甲第，卫霍列钟彝。\n笙歌恣游猎，佳冶艳芳姿。\n千金遑自惜，饮博相追随。\n罗绮遍衢巷，驺御满江陂。\n秀美王家子，疏豪世禄儿。\n空囊从所好，罄产亦奚辞。\n荣华有代谢，势位竟盈亏。\n回首惟尘迹，欢娱徒暂为。\n无令叹世者，啧啧动吁戏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14555,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠寺 其一","author":"张鸣韶","text":"清津开水国，天际见孤洲。\n漫指羊为石，还看蜃作楼。\n波涛元浩劫，身世亦虚舟。\n坐久忘醒醉，渔歌几唱酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14556,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠寺 其二","author":"张鸣韶","text":"四宇微茫外，中流胜可招。\n空台留海色，断口咽江潮。\n梵刹晴还湿，鱼龙晚益骄。\n长风堪破浪，应任此身遥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14557,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿飞云顶候日","author":"张鸣韶","text":"岳巘含葱郁，青摇海岱端。\n一真司佐命，万古共巑岏。\n阊阖邻朱鸟，烟霞驻彩鸾。\n日光悬景外，轮转夜须看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14558,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西樵山居杂咏","author":"张鸣韶","text":"野外频看竹，风前谩检书。\n蒿深仲蔚径，草带郑生庐。\n觅路时惊犬，沿溪想钓鱼。\n登临曾几度，抚景更端居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14559,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"采石矶","author":"张鸣韶","text":"锦石萦相带，烟花翠欲围。\n当关无戍垒，近水祇渔矶。\n王气连丹阙，江光映紫微。\n万年开泰地，曾记六龙飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14560,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金山寺 其一","author":"张鸣韶","text":"突兀中流处，孤标出上方。\n霜清江月冷，天阔陇云长。\n诗罢重怀古，情深几尽觞。\n恍疑尘世隔，终日浑微茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14561,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金山寺 其二","author":"张鸣韶","text":"天外金为岛，江中石作标。\n断崖长繫舫，虚窦暗通潮。\n窗辟千帆下，云深九派遥。\n禅关无彼岸，浮磬度青霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14562,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庾岭张文献公祠","author":"张鸣韶","text":"岭路崎岖石磴危，高台尸祝倚丰碑。\n机先蚤向胡雏辨，心事还从海燕知。\n一代直声悬帝眷，千秋风度使人思。\n相看不为登临兴，繫马松楸拜古祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14563,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白鹤峰苏文忠公祠","author":"张鸣韶","text":"名贤遗构倚江关，落日风烟几创颜。\n赐烛旧曾悬紫禁，谪居閒自老青山。\n朝云一片丰湖断，华表千秋白鹤还。\n剩有高台供伏腊，依依携手共跻攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14564,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门吊古 其一","author":"张鸣韶","text":"两厓波荡撼乾坤，龙战曾看拥至尊。\n一日未亡犹正统，普天何处不中原。\n残营尚带孤栖恨，濒海难销报国魂。\n夷夏升沉还此地，万山愁黛向黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14565,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门吊古 其二","author":"张鸣韶","text":"行宫遥指隔彤扉，烽火狼烟满翠微。\n一自舟师飞野烬，千秋陵谷锁斜晖。\n蜃楼彷佛成宫市，鲛室凄凉瘗黼衣。\n英魄九原还恋主，相将犹伴白鹇飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14566,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"厓门吊古 其三","author":"张鸣韶","text":"陆沉宇宙一征航，瘴海微茫失大荒。\n南北有天皆死所，江山无地可兴王。\n惊涛不断千秋怒，沴雨频疑六月霜。\n墨客经游堪涕泪，招魂何处问巫阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14567,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白云岩观瀑","author":"张鸣韶","text":"几向云中宿石岩，旧题苔藓未全缄。\n坐看垂瀑银成练，卧傍萦萝翠作衫。\n尘外自应忘出处，杯流那更别仙凡。\n相携此日还相赏，遥指江天问布帆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14568,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陈太守于乔","author":"张鸣韶","text":"朱轮晴拥海门烟，万卉春光映绮筵。\n老阅岁华馀甲子，高辞神武自丁年。\n棠留南国堪垂咏，书著函关又几篇。\n宅畔桃花非一度，孙枝应满綵衣前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14569,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送戚少保归东莱 其一","author":"张鸣韶","text":"几年忧国鬓成丝，涨海烟尘病不支。\n三至故应投织杼，千金何意泛鸱夷。\n生平意气怜谁在，华发勋名忆往时。\n莫以冥鸿兴远慕，鼓鼙今更重相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14570,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送戚少保归东莱 其二","author":"张鸣韶","text":"蓬莱高阁出风尘，万里犹存报国身。\n贫去祇应怜燕雀，功成宁复问麒麟。\n将军老计堪全胜，保相深恩是近臣。\n法网重伤文吏议，可堪烽火照三秦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14571,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题杨山人隐居","author":"张鸣韶","text":"栖迟晴色敞郊扉，杳霭流光接翠微。\n抱膝独高梁父咏，灌园如息汉阴机。\n林间垂薜裁为服，谷口行云曳作衣。\n试问紫芝当日事，肯输裘马故轻肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14572,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游小金山","author":"陈沂","text":"超然屹柱漾中流，地胜林深景最幽。\n寺古脱凡多客到，僧閒无事与天游。\n远山晴树千年景，活水长天一色秋。\n惟有坡翁常恋此，洞箫吹彻起江鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14573,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺","author":"李奇标","text":"维舟峡山寺，乘兴陟高岑。\n四野风烟迥，千岩古木阴。\n清泉分别涧，幽竹坐鸣琴。\n上界人稀到，惟闻钟磬音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14574,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白云洞","author":"谭清海","text":"西樵胜迹朝元洞，万丈丹梯紫翠连。\n濯雨飞虹淩白日，干云孤剑插青天。\n灵姬玉瑟秋仍响，仙客龙宫夜不眠。\n五百年来应有会，石门金简向谁传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋日赠少芝还维扬","author":"欧大章","text":"驱车重到广陵城，莫道江南尚请兵。\n遥想隋堤杨柳色，微风披拂似相迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋夜同诸子雅集城南楼因与少芝玩月分韵得东字","author":"欧大章","text":"月晓楼头起暮钟，何来今夕五城东。\n酣歌击筑心俱切，倚剑谈天气并雄。\n砧杵万家愁旅梦，鬓毛一夜感秋风。\n青衫十载惭吾拙，踪迹空怜过雁鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠李生北上","author":"欧大章","text":"征帆朝发越江边，离袂销魂倍黯然。\n后夜家乡明月里，不堪翘首白云天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊海珠寺","author":"欧大章","text":"野寺钟声接五羊，扁舟晚泊近僧堂。\n天空海阔孤鸿夜，烟暝猿啼几树霜。\n渔火乍明山月坠，征旗低拂海云长。\n飘蓬岁晚犹为客，何事天涯望故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晚由南濠出海珠","author":"欧大章","text":"山城萧瑟已深秋，旅客乘潮恣胜游。\n千里青山霞外断，半轮明月海中浮。\n蒹葭白雁迷寒渚，古木苍烟隐郡楼。\n莫向溪头问渔父，百年天地一虚舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冲虚观","author":"欧大章","text":"十载名山结梦魂，璿房云锁旧苔痕。\n猿啼处处千山暝，瀑挂泠泠百丈翻。\n野鹿衔花时自献，春禽绕树夕犹喧。\n清尊岂倦登临兴，已结松萝向给园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白鹤观","author":"欧大章","text":"白鹤岩前紫翠重，短筇飞步蹑仙踪。\n垂萝影落千寻壁，过雨风号万壑松。\n玉液已消丹灶冷，金书犹记白云封。\n淩霞一去空留舄，古木荒台自暮钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题近水园图","author":"欧大章","text":"浣花只在水云村，近水园亭不闭门。\n何处客来堪策马，一行桃柳入仙源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送叔壮安将军戍守苍梧","author":"梁以杞","text":"出戍苍梧志略雄，少年期尔奏肤功。\n江头折柳牵舟绿，峡内看花绕路红。\n报国一腔身是胆，断妖三尺气如虹。\n秋来露下氛烟靖，昼捲旌旗唱海东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"李海云先生小筑新丰同社雅集各赋","author":"梁以杞","text":"南庄小筑沛丰新，乔木堂高燕雀频。\n亭外竹松供野色，云中鸡犬隔红尘。\n樵歌归唱山坡晚，社酒传杯故旧亲。\n谩说桃源风景异，花开长见万年春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山中秋夜","author":"刘志遁","text":"洞箫声动月明初，满地清霜一草庐。\n白鹤飞来鸣夜半，不知身在紫霞居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"双忠庙","author":"刘志遁","text":"睢阳一死重山丘，庙食千年镇海陬。\n完节在天应独付，英魂随地可同游。\n萧萧落木阴风起，黯黯寒云杀气浮。\n野老日来谈往事，犹疑作客过中州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三忠新庙","author":"赵一诲","text":"双庙岧峣不可攀，新祠高起并文山。\n三仁许国原同体，十载栖神共此间。\n俨见冠裳云际落，翻疑剑佩月中还。\n沁园况有留题在，续笔何人点半斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤台凉月","author":"郑质夫","text":"练江萧洒净环城，凤去台空月自明。\n登览每乘秋日霁，咏歌常揖晚风清。\n香消篆火添云母，露湿琴书泻水晶。\n归客满身花竹影，恍疑人世是蓬瀛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曲水流杯","author":"郑质夫","text":"踏破苍苔一径幽，昔时曾有八仙游。\n山中遗迹丹砂在，石罅通泉九曲流。\n清泚一窥毛发动，流霞半酌羽觞浮。\n夕阳西岸催归骑，胜境何妨一少留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"凤台凉月","author":"黎民怀","text":"忆昔台端集凤凰，至今遗迹仰高冈。\n一轮光溢琼霜净，万籁声稀白露瀼。\n天上灵娥原有药，人间仙客祇分香。\n孤高不尽团团意，留照庭前菊愈芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曲水流杯","author":"黎民怀","text":"天悬幽涧落晴霞，几度奔流傍石斜。\n列坐不烦将绿斝，萦回长为送流霞。\n松阴满席团倾盖，风磴擎樽点落花。\n千古醉乡原此地，未须楚水问胡麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白水丹丘","author":"黎民怀","text":"物外飞泉境最赊，羽人曾此事黄芽。\n炉经劫后无馀火，鼎落岩前有旧砂。\n雨过每藏瑶草涧，云深不见赤松家。\n莫言遗世无消息，服饵年来似可誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题颜宗湖山平远图卷","author":"黄时俊","text":"隐约沙明宿雾开，依稀树断白云隈。\n水边人自陇头出，天际帆从山外来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏柳戏赠任文甫","author":"丁恒","text":"芳容濯濯出天然，每到春来却自怜。\n处士门前斜带雨，将军营里细含烟。\n柔条无力因垂地，飞絮多情欲上天。\n折赠行人离别后，不堪憔悴日三眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送文可归杭州","author":"丁恒","text":"李君才华世希有，湖海清名在人口。\n连年踪迹爱狂游，马蹄遍向天涯走。\n春风二月度鄱阳，买舟远下南斗傍。\n笔床茶灶浑无恙，犹带关前花雨香。\n我是烟霞旧时侣，鹿裘卧听山前雨。\n出门正欲问荆州，人来又道君归去。\n相逢不得叙生平，短歌欲赠难为情。\n秋风吹云浦树碧，南雁叫月江芦清。\n闻君家住孤山后，到家春色生衣袖。\n为问林逋旧隐居，至今尚有梅花否。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人归钱塘","author":"丁恒","text":"折尽长亭柳，条寒已不禁。\n凉风生海色，微雨淡秋阴。\n歧路空南北，浮生自古今。\n相逢即相别，何处写遐心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云溪","author":"丁恒","text":"闻道云溪上，乔林翠拂天。\n鸟啼萝径外，花落石潭边。\n雨歇黄精老，春深皂荚圆。\n高人高卧所，毛骨半成仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"石潨山","author":"丁恒","text":"遥望平林曙色温，淡烟新霭正纷纭。\n高低松竹阴相接，撩乱藤萝暝不分。\n谷口行人冲雾出，林间啼鸟隔溪闻。\n不知初日散空翠，惟见青山生白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春次黄恪翁韵 其一","author":"周讷","text":"谋身长以百年期，身外閒愁总不知。\n静掩重门惟听雨，旋拈秃笔谩敲诗。\n鸟啼隔树初调舌，花发当窗渐满枝。\n笑对阳春歌一曲，深杯同乐太平时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"新春次黄恪翁韵 其二","author":"周讷","text":"懒散何心与世期，春风先及野人知。\n千葩万蕊都成趣，语燕啼莺总入诗。\n风静捲帘看草色，日晴携酒醉花枝。\n恣情远逐游蜂去，浅水桥边缓步时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答何竹牖中秋见怀","author":"周讷","text":"野兴偏宜月色秋，开轩待月小迟留。\n肯教美景成虚度，正拟良朋共唱酬。\n举盏但为文字饮，新诗都付锦囊收。\n坐深细听残更报，祇隔芙蓉水外楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题波罗庙显相达奚司空像","author":"苏应机","text":"风萍浪梗总无涯，莫认归帆望眼赊。\n万国分封虽异域，一天同戴即为家。\n烟消黄木朝朝日，春好罗浮树树花。\n况荷衣冠更左衽，旅魂何必重咨嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒颜子心斋坐忘图","author":"苏应机","text":"不待披图拜下风，心香久已炷炉烘。\n一丝尧舜千年派，尽在如愚两字中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"始祖葬洋田沥失其故穴今寝庙落成同众书主感赋","author":"苏应机","text":"一到洋田怅望频，呆瞻旷野忆先人。\n乾坤更代英灵渺，风雨摧残垄宅湮。\n膏泽遗留宁有既，松楸庇护竟无因。\n通天多少曾玄罪，祠寝年来赖一新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小金山送萧昶昆玉还朝","author":"杨王休","text":"学士堂中挹斗杓，银灯火树灿春潮。\n江枫影合横孤鹤，海屿云閒彻洞箫。\n论旧一尊惊绿鬓，忧时双泪湿青苗。\n二难莫更嗟留滞，殿里金莲烛未消。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":14606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]