[{"title":"送朱少襄入京","author":"卢龙云","text":"山中十载满瑶篇，此去邮程羡着鞭。\n自许骅骝轻远道，暂令猿鹤怨飞泉。\n凉生弭棹秋如水，兴溢停觞笔似椽。\n不为观光行上国，赋成谁解识青钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送康孟担归莆中","author":"卢龙云","text":"天涯归思近何如，几夜秋声入客居。\n书断故人惟有雁，歌残长铗尚无鱼。\n盟从旧社还真率，赋岂同时负子虚。\n烟水木兰堪进棹，怀余尺素未应疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送薛侯宣民部出守南宁","author":"卢龙云","text":"几载频烦领度支，主恩南顾念荒疲。\n朱幡夹道来千骑，竹马临江导两麾。\n入境可知凰并集，分岐徒羡鹤相随。\n与君握手揶揄外，多少心期付所知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送董崇相博士之任南雍","author":"卢龙云","text":"衣冠江左集群英，南浦仙槎壮远行。\n作吏风尘归上国，得师文学擅西京。\n菁莪载育周多士，礼乐宁惭鲁两生。\n诏下石渠先论易，好陈交泰弼承明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送金友珙之罗浮便谒刘使君友珙先有作见贻","author":"卢龙云","text":"千里逢君过草堂，依刘何地系轻航。\n寒梅远望罗浮色，明月先投合浦光。\n道路霜威悬马首，江湖星象映鱼肠。\n山居寂寞无酬答，却写离怀付短章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答蔡孝廉时春试后南还","author":"卢龙云","text":"谁从鳞羽识虬鸾，喜尔翩翩汉魏坛。\n北望太行悲远道，南来禹穴得奇观。\n里中白雪歌弥寡，天上繁星色正寒。\n愧我并驱时已暮，新诗宁合更传看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄贞妇","author":"卢龙云","text":"吊影空堂夜寂寥，夫君魂杳妾魂销。\n结缡转恨乖违早，垂髡宁知岁月遥。\n使者采风旌独行，乡人评旦颂高标。\n他时嗣述应无负，更拟恩光下圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题龙起卷送何贡士","author":"卢龙云","text":"天尽东南大壑宽，伏龙深处水云寒。\n一朝雷动初开蛰，万里风长更助澜。\n头角久应为物睹，飞腾宁复限泥蟠。\n层霄有路知无极，霖雨他年合并看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送佘参知分署罗定","author":"卢龙云","text":"为语攀辕减别愁，使星仍照粤江头。\n棠连千里河同润，薇对三城地旧游。\n百雉重关新保障，万山过雨足瓯窭。\n已知凤下人争睹，旋听将雏兴自悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答郑纬文司理","author":"卢龙云","text":"雀罗幽寂掩柴荆，祗许求羊狎旧盟。\n独鹤九皋千里梦，冥鸿两地尺书情。\n篇诗已幸分玄草，杯酒何由对落英。\n世事浮沉君自见，息机羡尔早遗荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谭永明山人之康州时以州乘应沈使君之辟","author":"卢龙云","text":"旅游何地不逍遥，自爱云林隔市朝。\n刺灭独存狐史笔，路难宁羡马卿桥。\n古文鸟迹谙奇字，方椠蝇头记里谣。\n见说郡斋悬榻久，可无高士应嘉招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀沈使君二首 其一","author":"卢龙云","text":"千里牂牁溯上游，从前彫弊说西州。\n偶随一鹤来炎徼，却望三龙识沈侯。\n兴革备闻经画远，江山聊与颂声留。\n即论治行东南遍，谁擅专城第一流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄怀沈使君二首 其二","author":"卢龙云","text":"息交岑寂守茅庐，五马犹能问索居。\n穷巷闭门积雨后，焚香开卷落花馀。\n循良十郡仍高等，蹇拙当年但属车。\n杯酒别来频望远，几回梁月夜窗虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿黄别驾","author":"卢龙云","text":"天开耆社寿为朋，洛下衣冠岁月增。\n有禄岂须过邴曼，何侯不可傲东陵。\n苍松翠竹多相伴，白马青袍莫记曾。\n况是庆馀堪万石，凤毛应早见骞腾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"倪明府考绩","author":"卢龙云","text":"保障东南佐治安，汉家儒雅得倪宽。\n琴前星入同单父，花下风来似灌坛。\n异等循良推岭外，清班献纳待朝端。\n比年侍从多虚席，即拟徵书付紫鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曾泽卿侍御以东宫覃恩封其父如己官","author":"卢龙云","text":"四百峰头旧结庐，承恩初下紫泥书。\n尊传白兽添春酒，驾引青牛易鹭车。\n桓典已闻推避马，于公能自应高闾。\n祥光夜夜瞻南极，总是前星映彩馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郊居小集言怀","author":"卢龙云","text":"廿载驱驰道路难，且因泉石息风湍。\n杯前日月真怀土，镜里星霜合弃官。\n生事菟裘宁厌薄，畏途滟滪不堪看。\n人间大有安閒地，曾见红尘上钓竿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云洞饯别林别驾之槜李兼呈车使君","author":"卢龙云","text":"吴越山川纪胜游，屏星远道接清秋。\n邑缘课最荣增秩，郡以抡材裕借筹。\n展骥途看千里逸，飞云觞为片时留。\n雌堂到日应知己，共赋登高月满楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"飞云洞兰有并蒂之瑞各赋一章","author":"卢龙云","text":"胜苑名花几向阳，喜看兰蕙有奇芳。\n连枝已讶栽培异，并蒂均誇雨露长。\n丛转光风双毓瑞，阶联玉树两呈祥。\n非缘并结宜男佩，定许重沾上国香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送袁仲子赴阙","author":"卢龙云","text":"海日初腾雾欲消，似闻鲲运向层霄。\n图南羽翼三山动，直北风云万里遥。\n伯仲交游天下士，词章出入圣明朝。\n凤池旧侣今应在，赋雪吟春并可招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻五先生南园旧社答谭子玄","author":"卢龙云","text":"一代词盟旧结庐，名山何地更藏书。\n空留野露沾荆棘，无复残篇落蠹鱼。\n忆共买邻嗟世远，翻从凿壁爱光馀。\n谁令故宅更新主，萧瑟西风独怆予。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为陈勋卿题龙津藕花庄瑞莲","author":"卢龙云","text":"灼灼芙蕖澹澹风，龙津毓瑞到芳丛。\n孤标秀引澄湖绿，双萼辉迎晓日红。\n倚槛并怜娇欲语，淩波齐讶步逾工。\n閒居未尽濂溪爱，更有天香待汉宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"十三夜同康孟担熊楚伯刘觐国周方大谭子玄梁宪父待月得章字","author":"卢龙云","text":"落月常悬照屋梁，何期此夕共清光。\n已欣陶谢多奇思，况遇羊何有和章。\n残暑尽随挥麈却，高谈偏助引杯长。\n良宵几值秋将半，欲送柴门夜未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁左史还周藩","author":"卢龙云","text":"家传相业旧青箱，海内今推马季常。\n凤沼握兰辞直阙，兔园修竹羡游梁。\n名因授简称方外，心为长裾别故乡。\n到日醴尊承眷问，好陈乐善答君王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送康孟担西游访其叔郡丞","author":"卢龙云","text":"千里竹林几梦寻，西行此日惬尘襟。\n孤舟夜泊风前笛，两岸秋声月下砧。\n雾宿山光时隐现，岚飞野色半晴阴。\n柳江若过曾游地，应笑当年种柳心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答陈子成秋夕见怀二首 其一","author":"卢龙云","text":"西风摇落正悲秋，月下听鸿独上楼。\n宾馆尚悬徐孺榻，仙踪谁并李膺舟。\n解传鹦鹉惊人赋，未爱鹔鹴贳酒裘。\n乘兴若来应共醉，何须还棹剡溪头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答陈子成秋夕见怀二首 其二","author":"卢龙云","text":"草堂幽寂枉瑶篇，何处尊开白雁前。\n异地长怀人似玉，良宵几待月初弦。\n了无奇字堪相问，莫把新诗更与传。\n鞭弭中原看此日，预期金石为君镌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"秋暮陪沈郡公再登陈勋卿逍遥楼宴集","author":"卢龙云","text":"五马郊原问俗行，登台秋色倍澄清。\n倒听木叶穿林下，坐见烟光抱郭平。\n帘捲西山霞未落，窗衔东海月初生。\n不缘光禄如渑酒，飞盖何由并两旌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈孝廉父以七十犹守诸生其年家子来索寿章","author":"卢龙云","text":"经术传家旧有声，贤星久重太丘名。\n斑衣擢桂香先染，彩笔占花念未更。\n兰树阶庭偏美色，菊萸篱落好餐英。\n三朝容鬓安车日，岂逐终童更请缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答郑介繁二首 其一","author":"卢龙云","text":"忆昔河梁欲别时，魂销春草咏君诗。\n风尘墨绶思何补，山水朱弦负所知。\n吴下吕蒙惊见异，洛中张翰惜归迟。\n巡檐正值梅堪索，乘兴奚囊好复随。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20261,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答郑介繁二首 其二","author":"卢龙云","text":"虚堂阒寂掩蒿莱，对酒新诗每独裁。\n心逐冥鸿宜客傲，赋从倚马识君才。\n几回并就停云句，何似同倾问月杯。\n霜菊向残犹未落，东篱迟尔共徘徊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20262,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"许处士双寿","author":"卢龙云","text":"何处门庭道气赊，修真曾羡许君家。\n鸡鸣并戒神逾王，鹤算齐占鬓有华。\n五月桃疑千岁实，三江云似十洲霞。\n他年使者求颜阖，双白承恩到海涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20263,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惠州何使君考绩二首 其一","author":"卢龙云","text":"侍直从容忆往年，一麾犹荷主恩偏。\n名留青琐来何暮，阁近朱明地是仙。\n问俗海邦安抚字，奏成天阙重旬宣。\n君王念旧应无已，会有徵书自日边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20264,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"惠州何使君考绩二首 其二","author":"卢龙云","text":"悠悠世事卜行藏，推毂同君荷郑庄。\n异地一隅甘守黑，东方千骑称怀黄。\n河流并许沾馀润，里巷宁云汔小康。\n绩奏治平推第一，汉家公辅待循良。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20265,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿王令公","author":"卢龙云","text":"官阁梅花渐报春，康谣兼颂岳生申。\n几年栖凤留炎徼，万里飞凫候紫宸。\n天阙五云连画省，汉家三馆重平津。\n他时湛露沾清宴，此日壶觞念远人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20266,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答友人促余北上","author":"卢龙云","text":"纵横车骑奕棋看，几向羊肠叹路难。\n不为雀罗妨下榻，更随鸥队狎持竿。\n青衫往事白司马，皂帽今时管幼安。\n一出又惊尘梦远，可容年少问南冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20267,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贺梁幼宁明府生子","author":"卢龙云","text":"何处东篱酒兴宽，三城嘉瑞报徵兰。\n升从匹练空中见，照彻明珠掌上看。\n龙凤岂难追往牒，箕裘应解接儒冠。\n不缘高士重为颂，须道出关胜伯鸾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20268,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答族侄广生","author":"卢龙云","text":"九天鹏翮看扶摇，镜里朱颜总易彫。\n春草池塘思渐远，乌衣门巷聚非遥。\n倦还鸟雀投林早，争起鱼龙挟雨骄。\n期尔雄文终遇合，予将白社息烦嚣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20269,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为梁丈人送其婿黎君游太学时伯子方在计偕","author":"卢龙云","text":"紫云长护丈人峰，早识延明快似龙。\n几载菁莪歌乐泮，百年礼乐待临雍。\n行看诏下优三老，更拟书成上九重。\n指日公车同召对，泥金双达八行封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20270,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"萱芝齐茂图为周生寿其外祖母","author":"卢龙云","text":"宅相曾期应外家，且因喜燕进流霞。\n紫鸾诏待辉双翟，青鸟书传集六珈。\n萱号忘忧金作草，芝看联秀玉为花。\n由来圣善堪多祉，庆溢潘园未有涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20271,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题道州月岩和钱使君","author":"卢龙云","text":"空山圆月挂岩阿，光霁由来此地多。\n近水楼台开宝镜，广寒宫阙傍银河。\n乌啼绕树疏星晓，兔魄当杯浊酒歌。\n坐久天香云外落，玉笙几度醉嫦娥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20272,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"穆令公首荐","author":"卢龙云","text":"海隅苍赤颂神君，抚字功高帝亦闻。\n栖棘岂妨同览德，过都元易识空群。\n皂囊故启朝端誉，白简宁私柱后文。\n虚席此时需召对，郎星天畔带祥氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20273,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王倩泠自四明来访将由罗浮历武夷至雁荡而归武林赋此为别","author":"卢龙云","text":"雪夜扁舟过子猷，偶因并合散穷愁。\n鉴湖月色辞乡远，粤岭梅花伴客留。\n春酒碧霞瑶石酌，岩茶新雨幔亭游。\n永嘉山水应无尽，早向钱塘及好秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20274,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜雨偶成和邓玑伯刺史","author":"卢龙云","text":"谁遣閒愁到酒边，感时触事意相牵。\n计缘衣食家为累，梦落风波道苦邅。\n孤坐有怀徒耿耿，忧心无地不悁悁。\n夜来甘雨应沾足，且为三农庆有年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20275,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"祖德诗为姚司理作","author":"卢龙云","text":"东南佐郡有贤声，世德曾高旧旦评。\n黄绶海邦称惠尉，青云法从字升卿。\n官缘一命馀家庆，秩拟三旌荷国荣。\n大父交知同记忆，相才先习二郎名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20276,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"袁参知入贺","author":"卢龙云","text":"凤历才过三十春，瞻天此日庆逾新。\n车驱万里趋王会，鉴拟千秋效国珍。\n海宇承流波尽息，文坛司命士仍亲。\n圣恩若遂需丞弼，杼轴东南正可陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20277,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答友人西游见寄","author":"卢龙云","text":"远道何由折简呼，花前曾记伴提壶。\n书邮渐讶八行少，诗债才偿一事无。\n留客江山知信美，怀人风月隔欢娱。\n几回欲报加餐字，西岭云深雁影孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20278,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高学谕致政还江右二首 其一","author":"卢龙云","text":"二载山城雨露初，薰风远道送征车。\n拂衣未是嫌官冷，垂橐无须问禄馀。\n邹鲁泽成桃李荫，苏湖经就草茅书。\n阶前玉树凌霄发，会有青藜共石渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20279,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送高学谕致政还江右二首 其二","author":"卢龙云","text":"南来造士见功高，湖海元龙气尚豪。\n不为三鳣糜岁月，却随一鹤返林皋。\n归来满径犹松菊，别去环门自李桃。\n即拟宫衣荣彩服，何须白马恋青袍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20280,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黄用砺明府","author":"卢龙云","text":"倦游敢道息图南，白社诗篇癖自耽。\n天地风尘元易厌，渔樵生计也曾谙。\n五湖新水供垂钓，三径閒云引盍簪。\n知尔玄言今既就，问奇谁复似桓谭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20281,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与王令公喜诸生新进","author":"卢龙云","text":"文星夜灿碧云头，挟策翩翩喜见收。\n选里并为新秀士，环桥争羡小瀛洲。\n三千待奏公车牍，九万将腾海国秋。\n异日荐贤推上赏，岂惭车马锡诸侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20282,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送丁明府之西粤","author":"卢龙云","text":"两粤云山路不遥，临岐休道别魂销。\n菁莪百里河同润，桃李三城春自饶。\n暑雨闾阎需抚字，光风庭院隔招邀。\n仙凫会见凌霄起，竹马重迎荷圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20283,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题顺德双塔","author":"卢龙云","text":"城南千尺驾虹桥，桥下江声旦暮潮。\n云际何来双玉笋，雨馀忽对两霞标。\n地灵终古文成象，词客高秋赋屡招。\n倚槛天风吹万里，即看鹏翼共扶摇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20284,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答董叔远","author":"卢龙云","text":"襄野何从访具茨，白云无地不心怡。\n几年道路松荒日，一径蓬蒿鸟倦时。\n天子尚思游猎赋，硕人偏爱考槃诗。\n秋光亦自堪娱客，可负尊前菊满篱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20285,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄寿林左史九十","author":"卢龙云","text":"一自投簪逸海滨，壶山烟月自为邻。\n林泉养邃三朝硕，龟鹤龄开九十春。\n末路浮名庄叟达，初筵宾戒武公陈。\n天将遐算优遗老，况复琼枝雨露新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20286,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雄州陈司理考绩","author":"卢龙云","text":"几度梅花对法曹，岭头春雪唱逾高。\n朗陵聚后星为福，肺石清来目屡蒿。\n侍从频年虚召对，平反今日正书劳。\n趋朝便拟看花去，为问玄都观里桃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20287,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"为罗甥寿其伯典仪君","author":"卢龙云","text":"几人方外得罗含，春酒如渑傍菊潭。\n修竹念年经兔苑，德星今夕聚狐南。\n传家自美青云馆，招隐难忘白石庵。\n群从阶庭富兰玉，更容小阮共清酣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20288,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答友人九日客中见怀","author":"卢龙云","text":"九日秋光映远峰，每缘觞咏忆相逢。\n黄花节序家千里，浊酒乡心路几重。\n东道却宜山色美，西园犹记露华浓。\n问君倒屣多容接，得似陶家三径松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20289,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送周士宾春试","author":"卢龙云","text":"同学犹能忆少年，却惭天路着鞭先。\n君当礼乐千言就，我厌风尘万态捐。\n游猎正陈天子赋，抚军谁觅孝廉船。\n曲江旧事知无补，看尔登瀛望亦仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20290,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答诸叔侄劝驾二首 其一","author":"卢龙云","text":"远道迢遥忆帝城，懒从潘岳赋西征。\n自非白社皆尘境，独有青山不世情。\n客路烟波愁易倦，閒居风月喜双清。\n竹林小阮偏多兴，我亦沙鸥恋旧盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20291,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答诸叔侄劝驾二首 其二","author":"卢龙云","text":"回首风尘满凤城，朔云不断雁南征。\n游人自厌冰霜苦，倦客偏多湖海情。\n闭户已能甘寂寞，登车谁与共澄清。\n谢家群从多兰玉，次第还参上国盟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20292,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何观察入贺","author":"卢龙云","text":"海国风清岁晏如，喜持金鉴奉宸居。\n万方玉帛趋王会，五夜星辰记直庐。\n恩重紫骝辞汉阙，礼成青鸟报潘舆。\n春明莫恋斑衣里，多少蒸黎待属车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":20293,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]