[{"title":"刘公柳溪诗","author":"杨彝","text":"公庭宴坐无俗情，杨柳荫门春水生。\n绿阴满地惜春晚，飞絮扑帘疑雪声。\n解鞍树下看洗马，流杯石上听啼莺。\n当今论治用材杰，归来未许陶渊明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53131,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄邓氏养拙斋","author":"杨彝","text":"贵竹城中养拙斋，开窗树色映丹崖。\n常时有约论幽事，几岁无书慰老怀。\n身逐暝云登蜀道，梦随寒雨落秦淮。\n英才况出功臣裔，早晚除书下玉阶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53132,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送人还乡","author":"杨彝","text":"五十离乡七十归，居民城郭是耶非。\n青山自喜田园在，白发应怜故老稀。\n邻舍定携新酿酒，儿童不识旧戎衣。\n到家若有相思字，为寄明年春雁飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53133,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆弟","author":"刘叔让","text":"漂泊嗟吾老，羁栖见汝难。\n西风鸿雁急，落日鹡鸰寒。\n渭北书长绝，滇南泪不乾。\n朝思兼夜梦，怀抱几时宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53134,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜雨述怀","author":"刘叔让","text":"忆昔驱驰不自由，山林猿鹤笑无谋。\n十年世事浑如梦，一夜雨声都是愁。\n南诏羁栖伤短鬓，东湖寥落忆扁舟。\n钓矶别后知无恙，虚负同盟鹭与鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53135,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题镇南门城楼","author":"刘叔让","text":"排空雉堞接层楼，薄暮登临万古愁。\n红树一村蒲甸晚，黄云满地僰田秋。\n江通平缅蛮烟重，山耸高峰素雾收。\n极目乡关何处是，西风衰草思悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53136,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴素斋还淮安","author":"刘叔让","text":"谁识斋居托意深，翛然不受一尘侵。\n半窗晴日闲观易，满座秋风静鼓琴。\n策马已闻辞僰道，扬舲还喜到淮阴。\n刘伶台下多春色，行乐应知称素心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53137,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过杨井山","author":"杨子善","text":"雾尽寒初退，风轻雨欲晴。\n山田春饱水，农舍早趋耕。\n行李青霄近，烟波白发明。\n正愁泥路滑，林外竹鸡鸣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53138,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早起","author":"杨子善","text":"山楼早起已闻鸡，雪漏寒光月色低。\n三黜有谁怜柳下，四知徒自忆关西。\n街头灯火催车马，城上风霜急鼓鼙。\n临镜每惭多白发，校书何日对青藜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53139,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江夜","author":"杨子善","text":"江山秋意满虚舟，坐对渔灯看碧流。\n影浸星河天半落，凉生风露雨初收。\n椿庭有月乌啼夜，椒圃无人鹤怨秋。\n梦后乡关徒怅望，越吟一曲强消愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53140,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题画兰","author":"杨子善","text":"九畹香清露气寒，三湘月落泪痕乾。\n楚天空阔秋无际，谁复行吟泽畔看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53141,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"悼贞妇","author":"张洪","text":"啴啴赴行役，肃肃成谢功。\n妇女既有归，鸡犬亦相从。\n宁辞道路远，万里来黔中。\n边城尚艰食，太仓乏陈红。\n妇人在中馈，何以能尸饔。\n良人渐黧黑，惨淡筋力穷。\n常恐卧沟壑，妾身何所终。\n苟能事一饭，岂惜膏沐容。\n避人剪髻鬟，易米羞晨供。\n良人久惊讶，睹我颜色同。\n穷辞讯衷曲，裹头云鬓空。\n欷歔不下箸，泪点微沾胸。\n入怪久不出，引脰经房栊。\n仰呼不到天，洒泪不及泉。\n义当死生共，恩始夫妇全。\n亭亭朱丝绳，双悬并头莲。\n小哉匹夫谅，妄昧不足言。\n念尔贞洁姿，前后金石坚。\n一贫不改节，见义恐不前。\n妇道久不闻，良心郁未宣。\n孰知蛮貊地，超世尔独贤。\n兹吟待良史，悠悠千载传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53142,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拜谒黔宁王庙","author":"张洪","text":"曾聆玉帐肃徽音，俯仰清祠感慨深。\n客袂尚馀他日泪，羁怀不改旧时心。\n耳闻种德都成玉，眼看栽松尽作林。\n每岁骑箕滇海上，手分云液散甘霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53143,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荅俞都御史海上见寄二首 其一","author":"张洪","text":"舳舻相接恨离居，音问那堪只尺疏。\n见月思君应自切，看云忆我定何如。\n李膺舟楫神仙侣，博望星辰太史书。\n归去此怀同一洗，贺家湖上醉红蕖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53144,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"荅俞都御史海上见寄二首 其二","author":"张洪","text":"渺渺秋槎海上还，洞箫吹月过三山。\n九霄风露蓬壶里，万顷波涛衽席间。\n地尽东南开帝域，星环北极想天颜。\n夜阑五色云光近，回首扶桑不可扳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53145,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意四首 其一","author":"范宗晖","text":"茫茫宇宙间，事物皆有理。\n众理具一心，求之亦甚迩。\n微言寓群经，历历有根柢。\n致知以力行，典学念终始。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53146,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意四首 其二","author":"范宗晖","text":"人心固危殆，况乃众欲攻。\n外诱日胶固，乃蔽明与聪。\n炽然不可遏，至理或销镕。\n制之岂无术，澹泊以为宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53147,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意四首 其三","author":"范宗晖","text":"积羽可沉舟，群轻能折轴。\n巧言必诪张，利口多翻覆。\n诐淫及邪遁，害事为甚速。\n苟不塞其源，涓流蔽川谷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53148,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"古意","author":"范宗晖","text":"稂莠终乱苗，珉瑜颇相类。\n君子与小人，颜面亦不异。\n善恶本殊途，薰莸岂同器。\n辨之如不早，斯为名德累。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53149,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次喜雨诗韵","author":"范宗晖","text":"惟公镇南服，莅政诚有为。\n务农重民食，注意恒在斯。\n方春忽亢旱，恻然为悯之。\n致斋祷群祀，雨降不愆时。\n原野动生意，枯槁回芳姿。\n沟浍尽盈溢，川谷合深陂。\n天道孰云远，一念从可祈。\n老怀深有感，因之播声诗。\n手舞与足蹈，欢然不自知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53150,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢赐衣","author":"范宗晖","text":"吴蚕作茧缲车鸣，机中白苧新织成。\n高堂捧出绮丽生，光彩夺目四座倾。\n并刀裁就叠雪轻，华裙曳地稳称情。\n我歌白苧翻新声，移商换羽曲调清。\n君不见夷门嬴，三千人中身独荣。\n信陵当日倘未遇，安得千古遗芳名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53151,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"鸣凤歌","author":"范宗晖","text":"黔宁公子国之祯，远镇南服为干城。\n奇材异汇重题品，山川草木俱增荣。\n近从滇池得紫榆，锦纹玉质含霞赪。\n斲成琵琶极华丽，宝之不异金与琼。\n鹍弦犀轸龙香拨，鸦青绦绾猩红缨。\n方当下指曲未成，一座已闻鸾凤声。\n初疑秦台度箫管，复似缑岭随匏笙。\n又如昆崙断嶰竹，雌雄应律相和鸣。\n大弦铿鍧若呈瑞，喧呼杂遝声锽锽。\n又疑乔林啖竹实，天风披拂飘琮琤。\n小弦骈连如出穴，俄闻哕哕凌高冥。\n忽若相呼饮醴泉，馀音袅袅流春冰。\n大弦小弦或并作，却疑啄碎琼瑶英。\n綵云飘飘激遗响，百鸟不敢翔中庭。\n开元玉环未足数，大和忽雷空有名。\n何如公子制鸣凤，坐令六诏闻韶韺。\n请从席上赋长句，愿备乐府歌升平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53152,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题春山胜览","author":"范宗晖","text":"雄藩远控西南陲，地连六诏通诸夷。\n山川形胜土肥沃，风气颇与中国宜。\n方当青阳播晴旭，欣欣草木含华滋。\n溪毛云骨动生意，山光水色凝清晖。\n花梢日明灿晴锦，柳条风煖缲轻丝。\n鸟声嘤嘤出幽谷，物情和畅涵春熙。\n平畴水足夜来雨，家家播谷勤畬菑。\n维时统戎稍闲暇，省民问俗无遐遗。\n按辔徐行过村疃，云旌翠节光陆离。\n边氓久矣望风采，马前罗拜语嗢咿。\n劳徕慰抚殊未巳，仁声义泽沦肤肌。\n比屋欢呼歌击壤，雍雍若在唐虞时。\n缅思先王拓兹土，兵不血刃人心归。\n至今庙食重明化，代有阴骘安黔黎。\n公今更欲敷政化，非事逸豫耽游嬉。\n我今作诗诵厥美，太史观风应采之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53153,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闲情","author":"范宗晖","text":"斋居无俗尚，自爱适幽情。\n风定树阴合，雨馀泉脉清。\n枕书云伴卧，步屧鹤随行。\n曾与邻翁约，朝来共析酲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53154,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"述怀","author":"范宗晖","text":"步屧缘萝径，翛然鹤睡惊。\n竹深清露滴，树杪白云生。\n飞去谁家燕，啼来何处莺。\n今朝新酒熟，适足遂闲情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53155,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"山庄小酌","author":"范宗晖","text":"别墅花初放，叨陪绣节过。\n客如梁苑盛，地胜午桥多。\n吟好诗先就，杯深脸易酡。\n不因归骑促，洗盏更听歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"斋居","author":"范宗晖","text":"斋居习静昼初长，风暖闲庭薝卜香。\n日影到窗飞野马，云根采药斸松肪。\n年光荏苒闲方觉，学术迂疏老易忘。\n珍重使君多轸念，遍题书札到山房。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送素轩公迎总戎自交阯回","author":"范宗晖","text":"上将班师自海壖，将军迎谒出南滇。\n山河表里归中国，兄弟恩荣自九天。\n凛凛星矛明晓日，萧萧铁骑带寒烟。\n当年事业铭钟鼎，复见勋名著简编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和僧中庭韵","author":"范宗晖","text":"平公卓锡滇海南，出世有如优钵昙。\n庭前柏树曾手种，堂下玉板容我参。\n谈禅直解心即佛，从师独见青出蓝。\n随身一瓶与一钵，碧山为伴云为庵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题山水","author":"范宗晖","text":"初日照云林，寒泉落风磴。\n缅怀尘外踪，悠然动清兴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送姚临湘舜弦","author":"施敬","text":"沙头一樽酒，含悽强言笑。\n欲赋送君诗，情深不能道。\n苍茫波上日，杳渺烟中棹。\n望眼与江流，悠悠接云峤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送性泉吴文学东还","author":"施敬","text":"结欢未云久，讵尽平生语。\n执手临路隅，离觞聊一举。\n残钟草堂夕，落雁芦洲雨。\n相忆渺天涯，深悰若为处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"贫乐轩","author":"施敬","text":"长卷束牛腰，箪瓢系牛角。\n读书深树中，不知山日落。\n饮水自知味，采芝每盈握。\n经世岂无心，迂疏愧才薄。\n白云渺在望，幽兴入远壑。\n浩歌归去来，空斋有薇藿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登碧鸡山寄陆伯瞻刘子伟","author":"施敬","text":"碧鸡山顶登临处，一片苍烟迷海树。\n回首章台若个边，青天不尽山无数。\n欲倩西风吹雁书，拂云遥寄故人居。\n书中草草无多字，但道相思会面疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁山白云卷为卞千户题","author":"施敬","text":"梁山云气行如马，亲庭正在云之下。\n十年远宦隔天涯，日日瞻云泪盈把。\n白云可望亲不逢，此心每与云俱东。\n人生有亲不能养，金章压肘轻如蓬。\n白云不定飞还止，堂上慈亲念游子。\n几时路指梁山云，萱草花前奉甘旨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怪木竹石图","author":"施敬","text":"大星堕地光如日，一夜海风吹作石。\n精卫魂惊不敢窥，留待娲皇补天极。\n石傍老树枯槎枒，古藤屈曲悬脩蛇。\n鹧鸪踏翻黄竹叶，翡翠啄破苍苔花。\n千年丑怪何人识，老刚胸次真奇特。\n兴来掀倒墨池波，鬼迹神踪不能匿。\n生绡飒飒摇秋飔，古色惨淡寒无姿。\n天吴拔断蛟龙尾，月露洗出珊瑚枝。\n张公好古耽清赏，狂客题诗真技痒。\n冥驱万象入毫端，便觉箫韶画中响。\n琅玕有实石可栖，赤霄灵翮来何迟。\n按图为君三叹息，碧雨打门风捲席。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次瞿塘峡","author":"施敬","text":"凿铁开青壁，翻云泻素波。\n古今流不尽，造化意如何。\n晚策天边倚，春帆地底过。\n禹功不可问，日暮独长歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄浙江王氏得月楼","author":"施敬","text":"跨鹤仙人冰雪颜，结楼宴坐月中闲。\n笙声夜响闻天外，桂子秋香落座间。\n斜日黄来渔浦树，隔江青度海门山。\n西风满抱登临兴，携酒何时一往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送谭孟端","author":"施敬","text":"蘼芜叶齐春水生，故人欲归伤我情。\n草堂酒尽落花满，山驿马嘶残月明。\n醉中执手不忍别，路上逢人须寄声。\n明朝相望隔关塞，惟见白云天际横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"楚畹春风","author":"施敬","text":"九畹消残雪，光风汎国香。\n美人不可见，春草遍沅湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"曹溪夜泊","author":"施敬","text":"空山孤驿鼓逢逢，明月流辉满大江。\n水鸟夜寒栖不稳，一双飞影过篷窗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"渔人","author":"施敬","text":"浪迹烟波薄利名，钓舟长傍酒家横。\n白鱼青菜桃花饭，不识忧愁过一生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄南珍","author":"僧天祥","text":"上人居处僻，心与石泉清。\n道在从违俗，身閒不用名。\n空阶松子落，雨径藓花生。\n怪得稀相见，年来懒到城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题龙关水楼","author":"僧天祥","text":"此楼登眺好，终日俯平湖。\n叶尽村村树，花残岸岸芦。\n渔翁晴独钓，沙鸟晚相呼。\n何处微钟动，云藏岛寺孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵惟心见寄","author":"僧天祥","text":"世间无住著，林下且栖迟。\n映户幽光发，侵阶乱竹垂。\n老年销记性，馀习未忘诗。\n此意难为说，西峰道者知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠李生","author":"僧天祥","text":"异域无亲友，孤怀苦别离。\n雨中春尽日，湖外客归时。\n花落青山路，莺啼绿树枝。\n从今分手后，两地可相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送僧归重庆","author":"僧天祥","text":"东西千万里，来去一身轻。\n碧凤山前别，黄梅雨里行。\n江长巴子国，地入夜郎城。\n昔我经过处，因君动远情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭宋士熙","author":"僧天祥","text":"众山摇落日，那忍哭先生。\n老眼非无泪，深交最有情。\n人犹惜才调，天可厌聪明。\n书法并诗律，空留后世名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"呈同社诸友","author":"僧天祥","text":"君住峰头我水濆，相思只隔一孤云。\n夜灯影向空中见，晨磬声从树杪闻。\n咫尺谁知多役梦，寻常心似远离群。\n今朝偶过高栖处，坐接微言到夕曛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦里湖山为孙怀玉作","author":"僧天祥","text":"杭城一别已多年，梦里湖山尚宛然。\n三竺楼台晴似画，六桥杨柳晚如烟。\n青云鹤下梅边墓，白发僧谈石上缘。\n残睡惊来倍惆怅，可堪身世老南滇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长安春日作","author":"僧天祥","text":"何事长安客，春来思易迷。\n乐游原上草，无日不萋萋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"榆城听角","author":"僧天祥","text":"十年游子在天涯，一夜秋风又忆家。\n恨杀叶榆城上角，晓来吹入小梅花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春病怀","author":"僧天祥","text":"落花满地雨丝丝，九十春光又别离。\n行乐送春犹有恨，那堪多病过花时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄西山石隐","author":"释机先","text":"碧鸡山上雪，想可埋岩房。\n老僧冻不死，烧叶生微阳。\n我欲往从之，杳杳川无梁。\n日落尚延伫，心随归鸟翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"长相思","author":"释机先","text":"长相思，相思长，有美人兮在扶桑。\n手攀珊瑚酌霞气，口诵太乙朝东皇。\n鲸波摩天不可航，矫首欲渡川无梁。\n去时遗我琼瑶章，蛮笺半幅双鸳鸯。\n鸳鸯不飞墨色改，揽涕一读三断肠。\n前年寄书吴王台，西湖杨柳青如苔。\n今年东风杨柳动，鸿雁一去何当回。\n欲弹朱弦弦断绝，欲放悲歌声哽咽。\n孤鸾夜舞南山云，花渍帘前杜鹃血。\n思君不如天上月，夜夜飞从海东出。\n月明长傍美人身，美人亦近明月轮。\n褰衣把酒问明月，中宵见月如见君。\n长相思，长如许。\n千种消愁愁不消，乱丝零落多头绪。\n但将泪寄东流波，为我流入扶桑去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄仲翔外史","author":"僧机","text":"天涯又索居，岁晏近何如。\n远水苍茫外，空山寂寞馀。\n老逢诸事懒，病觉故交疏。\n想见多闲暇，应修辅教书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送别","author":"释机先","text":"天书召贾生，匹马出滇城。\n白首相逢处，青云送别情。\n山经巫峡尽，水到楚江平。\n好献治安策，殷勤答圣明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽逯光古先生","author":"释机先","text":"昨日来过我，今朝去哭君。\n那堪谈笑际，便作死生分。\n旷达陶徵士，萧条郑广文。\n犹怜埋骨处，西北有孤云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梁王阁","author":"僧机","text":"碧鸡飞去已千秋，闻说梁王曾此游。\n洞口仙桃迎凤辇，岩前官柳系龙舟。\n青山有恨人何在，白日无情水自流。\n岂识当时歌舞地，寒烟漠漠锁荒丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滇阳六景 其一 金马朝晖","author":"僧机","text":"岧峣金马在城东，黛色苍凉淡墨中。\n画角声消残月白，阳乌影动早霞红。\n梁王去国荒丘在，汉将开边古道通。\n岂料长为南窜客，朝朝相对独为翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滇阳六景 其二 碧鸡秋色","author":"僧机","text":"碧鸡西望水天虚，漠漠秋光画不如。\n翠壁烟华摇浪处，丹崖树色著霜初。\n前朝有阁今游鹿，落日何人独钓鱼。\n却讶维舟湓浦上，芙蓉九叠看匡庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滇阳六景 其三 玉案晴岚","author":"僧机","text":"山如玉案自为名，卓立天然刻画成。\n白昼浮岚浓且淡，高秋叠翠雨还晴。\n阴连太华千寻秀，影浸滇池万顷清。\n杖策何当凌绝顶，滇南一览掌中平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":53192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]