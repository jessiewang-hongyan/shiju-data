[{"title":"寿吕思斋七十","author":"王立道","text":"北望心犹壮，东风发已华。\n客盈文举座，春属老莱家。\n对酒新乌帽，传经旧绛纱。\n非熊行自卜，十载未论赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7757,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿陆颐斋七十","author":"王立道","text":"七十健逢迎，知君善养生。\n笙歌娱晚景，车马杂春声。\n鹤唳闻应惯，茶经著始成。\n汉庭方贵老，章服此时荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7758,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题惠坡","author":"王立道","text":"幽怀羡独往，茅屋住山坡。\n蜡屐看鸣鸟，浮觞坐浅莎。\n薜萝罥僧锡，麋鹿骇樵歌。\n我亦岩栖者，藏书近若何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7759,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题顾与新清溪庄和唐应德韵四首 其一","author":"王立道","text":"罢官应自好，负郭有瓜田。\n宦味陶元亮，诗才贾浪仙。\n高斋听雨枕，斜月过湖船。\n谁共幽吟者，空闻招隐篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7760,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题顾与新清溪庄和唐应德韵四首 其二","author":"王立道","text":"旧是樵渔地，投簪此卜居。\n溪閒安药硙，春至检农书。\n食笋思分竹，腰镰拟佩鱼。\n也知濠上乐，愧我未能如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7761,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题顾与新清溪庄和唐应德韵四首 其三","author":"王立道","text":"林卧堪遗俗，村居复近湖。\n应门时见鹤，鼓棹不惊凫。\n树与人俱散，溪因主亦愚。\n翻嫌太寥僻，庄外有桑榆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7762,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题顾与新清溪庄和唐应德韵四首 其四","author":"王立道","text":"知君闭关久，一径落花深。\n书癖年长在，诗盟春更寻。\n空山几两屐，远道四愁吟。\n北望休相笑，平生魏阙心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7763,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周颙分教严州","author":"王立道","text":"斯文周茂叔，清节汉严陵。\n风月还谁共，云山思独凝。\n道依家学重，教并郡贤兴。\n庭草多幽意，高台时复登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7764,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和龙冈送白洛原将命护作因得归沐","author":"王立道","text":"画省犹牵袂，征帆动渭浔。\n九重将异命，千里惬归心。\n□□□□□，幽居忘越吟。\n我亦多乡思，金门聊陆沈。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7765,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬包元达侍御见示之作兼致别意二首 其一","author":"王立道","text":"远道客情多，停桡时共过。\n綵衣沾雨露，绣服炫星河。\n时论深杯酒，乡音接棹歌。\n清江明月满，莫问夜如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7766,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬包元达侍御见示之作兼致别意二首 其二","author":"王立道","text":"吴趋投暝发，楚树带烟微。\n千里占星聚，双帆逐雁飞。\n宁亲恩诏渥，报主壮心违。\n尊酒怜同病，天涯更独归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7767,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郭允新宅中秋燕集限韵得王字二首 其一","author":"王立道","text":"圆魄临秋半，邀欢奉桂浆。\n感时俱异客，卜夜共清光。\n兔影摇鳷鹊，鸿声度建章。\n还思拟金鉴，持以奉明王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7768,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郭允新宅中秋燕集限韵得王字二首 其二","author":"王立道","text":"天街秋宇净，月露淡交光。\n对此怀千古，悠然览四荒。\n开尊浮桂影，裁句竞兰芳。\n未就登楼赋，多惭姓是王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7769,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋居五首 其一","author":"王立道","text":"和靖常携鹤，羲之本好鹅。\n山阴秋日净，湖上野烟和。\n大道机中息，虚名身后多。\n渊明真解此，诗酒一生过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7770,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋居五首 其二","author":"王立道","text":"云树秋容澹，悲歌野兴豪。\n萧兰元异种，牛骥亦同槽。\n露白芰荷尽，天清鸿雁高。\n朋游隔千里，魂梦为谁劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7771,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋居五首 其三","author":"王立道","text":"种树边茅宇，抛书满石床。\n林居惭束带，昼坐忆含香。\n土木形骸拙，江湖忧思长。\n秋来频对客，山桂挹寒浆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7772,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋居五首 其四","author":"王立道","text":"卧游真自得，日对辋川图。\n烧叶茶频煮，悬钱酒旋沽。\n大言倾宋玉，潜论学王符。\n秋至吟尤苦，临风独撚须。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7773,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋居五首 其五","author":"王立道","text":"避树营墙短，看山引坐偏。\n长松盘野鹤，疏叶度寒蝉。\n蜂坞花成蜜，蜗房露洗涎。\n村居时易姓，祇畏俗人传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7774,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"偶成","author":"王立道","text":"野外常无事，多看种树书。\n迂顽堪自笑，踯躅欲焉如。\n饮客中山酒，寻春下泽车。\n倦游频息驾，意惬即吾庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7775,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送姚友竹二首 其一","author":"王立道","text":"东风桃李满，忽向剡溪归。\n江暖知鲈美，春深爱蕨肥。\n故山麋鹿友，初服芰荷衣。\n千里还相忆，寻君旧钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7776,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送姚友竹二首 其二","author":"王立道","text":"亦知簪组累，自爱水云居。\n匹马归来早，三鳣属望虚。\n閒情任吴越，行李总图书。\n何处堪高卧，山中有草庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7777,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书观澜卷赠行涂堂主簿父二首 其一","author":"王立道","text":"旅馆忽经年，归怀感逝川。\n云来震泽薮，春去洞庭船。\n濠水思蒙吏，龙门怅马迁。\n江湖堪寄兴，莫自叹华颠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7778,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书观澜卷赠行涂堂主簿父二首 其二","author":"王立道","text":"青春白日好，千里一帆初。\n野色云俱媚，江声夜转虚。\n逢人谈惠麓，久客忆匡庐。\n好去看消息，殷勤戒子书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7779,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代作惠坡诗郑子","author":"王立道","text":"由来厌朝市，卜筑近山家。\n路入云林杳，篱侵石磴斜。\n汲泉因酿酒，扫径为看花。\n屋角清溪转，桃源那更赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7780,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夏日偶成","author":"王立道","text":"穷巷谢华轩，幽斋入断垣。\n卧游非择胜，坐锻欲辞喧。\n有客问奇字，无人知寓言。\n时来松树下，长啸似苏门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7781,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代寿曹山人六十","author":"王立道","text":"酿酒撷园蔬，为欢此度初。\n身因乌帽宠，人以白眉誉。\n旧识尚书履，今来长者车。\n早谙清净理，宁藉养生书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7782,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"义兴道中","author":"王立道","text":"倚棹水云边，溪光共杳然。\n琴尊百里道，竹树一村烟。\n山果迎秋落，汀花带晚妍。\n夜来何处宿，相逐捕鱼船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7783,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登孤山用唐人张祜韵","author":"王立道","text":"兀坐俯孤岑，翛然出世心。\n烟霞千嶂晓，桑柘半溪阴。\n鹤去亭犹古，人幽山更深。\n已看尘迹远，况复近东林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7784,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"紫阳庵","author":"王立道","text":"幽翳藏灵境，攀窥石磴寒。\n奔峰度天外，飞阁出林端。\n憩洞思探箓，疏泉学煮丹。\n重来定何日，明去欲辞官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7785,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"崇德道中","author":"王立道","text":"望望越溪幽，烟波横素秋。\n桑园多傍水，荻岸一维舟。\n落雁窥沙溆，行人指驿楼。\n棹歌中夜发，芳杜满前洲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7786,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吴廷宣父母双挽","author":"王立道","text":"鹿门栖隐处，耕织自相依。\n忽此歌狸首，初因哭少微。\n梁鸿山下宅，孟母室中机。\n寥落那堪问，空馀明月辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7787,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿苗东洲七十","author":"王立道","text":"为儒不得意，老去素风存。\n爱客多悬榻，谋身独灌园。\n柴门耽旧隐，纱帽奉明恩。\n白发春来长，怡情此一尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7788,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题文苑","author":"王立道","text":"家本诗书业，幽居总好儒。\n天龙座上客，山海壁间图。\n问字时能说，鸣琴聊自娱。\n重来解组后，不似北山逋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7789,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"茹澜堂号诗","author":"王立道","text":"灵液千年发，虚堂半岭悬。\n池喧瀑布雨，窗暝具区烟。\n长日云俱卧，幽襟俗尽捐。\n吾缨如可濯，携手弄潺湲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7790,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陆节之夫妇七十双寿","author":"王立道","text":"奕奕金章客，归来两鬓星。\n仰天窥鹤唳，闭户著茶经。\n五柳宜同传，三休已作亭。\n使君况有妇，七十共修龄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7791,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"途中送春寄诸弟","author":"王立道","text":"客行愁节换，况复是春归。\n樯燕如相讯，汀花亦尽飞。\n问程犹故国，千里更迟迟。\n遥忆高堂燕，重嗟定省违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7792,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初入都寄亲知","author":"王立道","text":"薄宦蓬应似，往来唯所飘。\n振衣聊息驾，鸣玉更趋朝。\n惯学金门隐，多惭华鬓饶。\n沧洲有故侣，松桂欲相招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7793,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"吕梁题养素轩","author":"王立道","text":"大朴元无事，幽居堪自怡。\n云依书幌静，石共药栏欹。\n白贲存吾道，玄文任俗疑。\n风尘千古意，谁识染丝悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7794,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"野望","author":"王立道","text":"水漫孤村白，花依别屿红。\n阴阴沙际日，细细午前风。\n贳酒从邻媪，呼舟学钓翁。\n一春唯寄兴，山色鸟声中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7795,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄王允宁用旧赠韵","author":"王立道","text":"忆昨趋金马，承恩共一时。\n君今卧西华，我亦恋南枝。\n永念关中使，多传别后诗。\n燕云犹自隔，吴苑倍相思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7796,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送篆文生","author":"王立道","text":"吴客偏多艺，君能解古文。\n鸿都初待诏，燕市忽离群。\n科斗舟迎字，凫鹥沙漾纹。\n相看俱得意，宁惜去来勤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7797,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿萧尹","author":"王立道","text":"吏隐不违亲，归来白发新。\n大椿宜晚岁，五柳绝风尘。\n紫诰衔恩重，斑衣献舞频。\n庭中闻凤吹，萧史是前身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7798,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"岁暮送客","author":"王立道","text":"月穷知岁晚，游子促归心。\n残雪千门曙，寒风百里阴。\n目随长路断，情寄故园深。\n日暮幽斋里，何人共越吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7799,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得家书三首 其一","author":"王立道","text":"三春候归雁，四月见家书。\n客思真无赖，亲恩自不疏。\n诗书馀旧业，水竹卜新居。\n喜极浑忘寐，千金定未如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7800,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得家书三首 其二","author":"王立道","text":"吴楚同千里，君亲自一心。\n看云遥北极，望日迟南音。\n未返王阳驭，空成越舄吟。\n春来江汉水，何似旧时深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7801,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"得家书三首 其三","author":"王立道","text":"春尽逢南雁，翻令感岁华。\n五年犹作客，一命亦为家。\n肉食愁黄竹，莼羹想白华。\n何时莱子服，谩向故人誇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7802,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送黄三峰佥宪山东","author":"王立道","text":"羡尔独怀奇，为郎已后时。\n欲观沧海日，不恋白云司。\n绣斧承秋令，丹书属夜思。\n寄车应问俗，更访峄山碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7803,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈平冈七夕韵","author":"王立道","text":"牛女何年事，犹寻此夜盟。\n多君先得巧，摇笔报诗成。\n秋兴尊前发，河流天畔明。\n兰章无以报，空自愧同声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7804,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送寿昌吴尹","author":"王立道","text":"出宰动星文，孤城百里分。\n山犹富春古，道以子陵闻。\n凫舄双看别，牛刀独树勋。\n重寻治县谱，美政接番君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7805,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送李仲西都谏节推大名","author":"王立道","text":"未厌承明直，那堪祖道看。\n象刑清禁甸，持节渡桑乾。\n朝下衣香在，焚馀谏草残。\n霜枫迎去马，似照寸心丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7806,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月七日汪维义宅对菊","author":"王立道","text":"他乡七日酒，应为菊花催。\n疏鬓风前帽，羁怀江上台。\n秋光寒拂槛，霞色暝侵杯。\n摇落易为感，酣歌日几回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7807,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和孙季泉韵二首 其一","author":"王立道","text":"圣主正垂裳，同依日月光。\n芳辰共清燕，联佩此登堂。\n座接陈君榻，衣沾荀令香。\n明时多事业，莫遣鬓毛苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7808,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和孙季泉韵二首 其二","author":"王立道","text":"高轩贵戚里，良会小春时。\n逸兴频催酒，清谈各问诗。\n鹓鸾天外集，商羽曲中移。\n聚散兴馀慨，何年更此期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7809,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会同年二首 其一","author":"王立道","text":"对酒复何疑，相惊十载期。\n鲲鹏同变化，鹓鹭数追随。\n筵敞通侯第，歌怜少女词。\n不愁归路暝，后会恐参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7810,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"会同年二首 其二","author":"王立道","text":"绮席照朱甍，侯家接凤城。\n歌钟五云近，轩盖一时倾。\n星聚惭名德，风期协友生。\n相看语不尽，特此寄同声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7811,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"左顺门问安同郭允新作","author":"王立道","text":"追趋双阙下，瞻拜五云间。\n为问君王寝，相随供奉班。\n啼鸦丹禁曙，调马玉墀闲。\n佳气葱葱合，深宫护圣颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7812,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酬欧学章见赠移居","author":"王立道","text":"六一欧居士，琴书满屋清。\n故开松菊径，应有薜萝情。\n客借陈君榻，邻惭求仲名。\n趋朝惯相逐，暗识玉珂声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7813,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"张映山书屋卷","author":"王立道","text":"君家碧山后，旧业五车书。\n欲就张衡赋，先营诸葛庐。\n下帷山桂发，隐几岭云嘘。\n勤苦无须问，行看上石渠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7814,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登镜光阁","author":"王立道","text":"梵居依凤阙，虚阁瞰龙宫。\n车马三春赏，山河四望通。\n林鲜迎佛日，磬远引皇风。\n鸟似随缘下，僧因出定逢。\n烟花迷色相，水树悟真空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7815,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠僧","author":"王立道","text":"杖锡去何迟，东林烟雨微。\n出山吟更苦，得禄意多违。\n钟鼓侈斋磬，袈裟厌客衣。\n自令身得度，僧俗尽皈依。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7816,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"黄公涧","author":"王立道","text":"积雨千峰润，飞流百道悬。\n穿林惊宿鸟，激石乱鸣蝉。\n□□□□□，□□□□□。\n□□□楚相，陵谷自依然。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7817,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"移居","author":"王立道","text":"儒宫无一亩，宦薄易为家。\n地入黄啚僻，门依紫陌斜。\n微吟对秋草，閒步拂檐花。\n未就登楼赋，端居念岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7818,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"安黄门曾祖母九十八寿诗","author":"王立道","text":"问讯日边书，高堂百岁初。\n兰孙五世满，甲子六身馀。\n地讶瑶池接，星占宝婺虚。\n宾筵秋正好，仙菊照华裾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7819,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"又柬卢浚明移居","author":"王立道","text":"葵藿心常切，移居近日华。\n门窥狭斜道，春傍上林花。\n守拙家四壁，多方书五车。\n清谈留客处，寒竹净交加。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7820,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"步虚词四首 其一","author":"王立道","text":"王母传青鸟，秦娥控紫鸾。\n相期瑶岛外，忽上綵云端。\n海水年来浅，桃花春去残。\n未能逢玉舄，那得问金丹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7821,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"步虚词四首 其二","author":"王立道","text":"海上三珠树，云中七宝车。\n空闻往来处，何地是仙家。\n洞古羊成石，林春枣似瓜。\n刀圭虽可学，岁月莫应赊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7822,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"步虚词四首 其三","author":"王立道","text":"雾幄绕霓旌，氤氲满太清。\n龙成云盖引，虎奉岳图迎。\n七圣犹同御，三天各异程。\n试求香案吏，谁是岁星精。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7823,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"步虚词四首 其四","author":"王立道","text":"历历白榆中，飘飖双玉童。\n神宫开太一，仙路接崆峒。\n子晋仍骖鹤，浮丘亦驾鸿。\n不须能缩地，万里自乘风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7824,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄题前汤庵","author":"王立道","text":"空林回夕照，清梵尚依微。\n野鹭窥僧钵，天花缀佛衣。\n经翻长日过，锡伴暮云归。\n欲托门人宿，因观静者几。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":7825,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]