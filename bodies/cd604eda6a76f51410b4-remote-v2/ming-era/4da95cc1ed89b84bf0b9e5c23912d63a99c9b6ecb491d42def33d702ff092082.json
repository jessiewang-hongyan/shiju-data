[{"title":"闻天瑞堕淮水死","author":"王云凤","text":"母立斜阳待子归，肩舆谁遣蹈危机。\n巨卿不省归来梦，沾湿游魂未得飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26432,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"阮籍墓","author":"王云凤","text":"谁遣相随入醉乡，只将杯酒送年光。\n可怜常侍坟前土，千载何人酬一觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26433,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"汤阴分司逢王茂学","author":"王云凤","text":"相逢一话即相知，日暮匆匆又别离。\n君过弼城回首处，冈头是我望君时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26434,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"西平道中送客","author":"王云凤","text":"桃红柳绿春意浓，娇风吹送雨濛濛。\n道上行人不归去，目断南来几个鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26435,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"射","author":"王云凤","text":"才买雕弓出市头，欲将骑马觅封侯。\n霜颠笑杀关门将，未识英雄一段愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26436,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"秦州看雨","author":"王云凤","text":"昼锁重门看雨卧，雾为车马风筛簸。\n恰似读书山寺时，独坐空庭松数个。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26437,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岷州画虎皮","author":"王云凤","text":"斑尾绀晴百兽逃，晓风寒月下临皋。\n皋比谁赠霜台客，独对南山万仞高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26438,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送张少参考绩","author":"王云凤","text":"岷山渭水惯同游，暂向东亭系客驺。\n万里孤鸿又南去，一樽相对灞陵秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26439,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岷山雨坐","author":"王云凤","text":"一夜云生雨有馀，庭槐夜竹共清虚。\n坐来俗客何曾到，独对青山好读书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26440,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"待隐园杂诗为邃庵先生作次韵 其一","author":"王云凤","text":"江上新园一段清，雨馀偏爱踏莎行。\n年年马上风尘表，回首天涯是此情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26441,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"待隐园杂诗为邃庵先生作次韵 其二","author":"王云凤","text":"缓步閒行手背叉，苍苔屐齿踏成花。\n小池童子开泉眼，独坐矶头弄水华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26442,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"待隐园杂诗为邃庵先生作次韵 其三","author":"王云凤","text":"买园全隔市尘侵，灌溉从人笑汉阴。\n风景别来长在眼，不须图画看山林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26443,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"待隐园杂诗为邃庵先生作次韵 其四","author":"王云凤","text":"初到林泉兴最多，菊亲料理石摩挲。\n晚来独倚长松坐，渡口微风送棹歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26444,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"过天津荅储静夫绝句见寄","author":"王云凤","text":"我舟初挂一篷新，偶遇南船便问津。\n唤我停桡过仓去，岸头閒看放罾人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26445,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"悯流民","author":"王云凤","text":"井地遗踪废自秦，人无根柢世多贫。\n可怜野火依栖处，犹是文王旧日民。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26446,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"书山阳分司壁","author":"王云凤","text":"汉江之水流潺潺，汉江之月照人寒。\n洵畅北来更奇绝，十日青山不尽看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26447,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送官汝俊","author":"王云凤","text":"君来长掖四年多，故里朝天得暂过。\n为我试寻东海上，蓬莱方丈果如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26448,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"蓉湖","author":"王云凤","text":"坐久熏风不厌多，花香水气更如何。\n欲寻仙子家何处，十里红莲映绿波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26449,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"华清宫","author":"王云凤","text":"偶来一浴浑无害，何事频游天宝年。\n爱浴不知心有垢，宫中犹赐洗儿钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26450,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"乾陵","author":"王云凤","text":"发馀陵上石纵横，陵下閒田亦尽耕。\n独有穹碑高入望，行人下马阅题名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26451,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"再到镇安考试诸生毕看泉","author":"王云凤","text":"试罢行吟别院开，惟多黄叶与苍苔。\n忽有泠泠闻树底，山泉流过短墙来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26452,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画四鸟 其一","author":"王云凤","text":"扶疏绿叶晚缤纷，似染潇湘水上云。\n何处飞来数声鸟，月明幽客梦中闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26453,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画四鸟 其二","author":"王云凤","text":"春堤何处绿丝垂，管领东风千万枝。\n小鸟也知长爱惜，碎声长似说芳时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26454,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画四鸟 其三","author":"王云凤","text":"东郊膏雨润搂犁，秃树槎牙叶正齐。\n何事省耕亡旧典，空劳此鸟一春啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26455,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画四鸟 其四","author":"王云凤","text":"山禽何以喜为名，谓向人鸣喜便生。\n自是人闻鸣便喜，民愁不是汝无声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26456,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"登骊山","author":"王云凤","text":"骊山山背路萦回，御辇曾经此地来。\n一自潼关飞羽檄，殿门长锁不曾开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26457,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"骊山次菊水胡大参韵","author":"王云凤","text":"稻塍流水是江南，阴壑悬崖午送岚。\n欲上瑶光楼上望，青松白石系征骖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26458,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奠孟仲平坟","author":"王云凤","text":"祝融祠下仲平坟，走马来寻日已曛。\n十载故人凋落尽，空山无处觅机云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26459,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送任中夫归太原","author":"王云凤","text":"旅馆相逢即故乡，别筵谁遣近垂杨。\n燕山二月春犹薄，欲赠烟丝苦不长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26460,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画 其一","author":"王云凤","text":"繁烟猛雾作阴时，江色山光晚正奇。\n莫怪断桥无渡者，幽人踪迹恐人知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26461,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"题画 其二","author":"王云凤","text":"秃树槎牙不记春，短茅新结净无尘。\n欲从何处寻幽伴，本自空山未属人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26462,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王原常用其留别诗句为题三首 其一 白云时在目","author":"杨守阯","text":"渺渺孤飞云，悠悠太行道。\n望望天一方，恻恻伤中抱。\n云兮本无心，聚散秋空杳。\n明发怀二人，触目离情搅。\n瞻云想亲舍，万里青山绕。\n不睹山中人，祗见云中鸟。\n鸟飞云与还，花落重门晓。\n怅然歌式微，别离何草草。\n寄言缙云卿，莫恋白云好。\n苍生望为霖，从龙兴枯槁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26463,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王原常用其留别诗句为题三首 其二 璧水日论心","author":"杨守阯","text":"西北有高楼，逶迤上千仞。\n回澜俯绿水，阿阁凌青云。\n中有弦歌曲，知者识其真。\n自云良家子，选择趋严宸。\n佩玉曳罗裳，欲以充下陈。\n朱颜俗不薄，燕赵多美人。\n无盐逐乡里，毛施亦逡巡。\n容华恐消歇，抚心一以矉。\n明德苟不亏，燕婉终相亲。\n芙蓉湛秋水，桃李熙阳春。\n随时爱容辉，无为长苦辛。\n赠君金琅玕，报我青玉盘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26464,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王原常用其留别诗句为题三首 其三 分歧思不禁","author":"杨守阯","text":"馥馥春兰姿，皎皎秋月辉。\n流光照我怀，馨香袭我衣。\n游子惜日暮，行人怀路歧。\n对酒未成醉，揽衣重徘徊。\n孤兽不遑食，离鸿亦呜悲。\n感之复叹息，益抱离群思。\n四海皆兄弟，白首谁相知。\n断金良不易，丽泽一以资。\n胡为远离别，各在天一涯。\n南陔有真乐，伐木多苦辞。\n怀哉复来斯，三岁以为期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26465,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"耕乐","author":"杨守阯","text":"幽居远城市，绕屋皆良畴。\n方春土膏动，夜半催饭牛。\n父从原上耕，子向田中耰。\n豚蹄祀田祖，瓯窭欣满篝。\n先期了公税，床头熟新篘。\n陶然一醉间，宁知公与侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26466,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送孔润伯归乐清","author":"杨守阯","text":"朱明在赫曦，端居困炎暑。\n行子何匆匆，移舟潞河浒。\n策马送之行，宁辞汗如雨。\n饮之碧筒杯，酌以黄封醑。\n情至发长吟，击节飞云驻。\n亲朋终日行，眷恋宁如许。\n爱人怜屋乌，思人及棠树。\n珍重宣尼孙，典刑独可睹。\n去矣不可留，临风重延伫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26467,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"赋得洞庭湖送侯公矩佥宪","author":"杨守阯","text":"我闻洞庭湖，远在巴陵道。\n含山复吞谷，洪波际天杪。\n古来题咏人，无如杜陵老。\n朝阳一凤鸣，千古喑百鸟。\n如彼黄鹤楼，题咏有崔颢。\n才如李谪仙，有景不复道。\n吾才非谪仙，少陵先压倒。\n况未临此湖，狂吟何草草。\n所志不在诗，因之寄怀抱。\n愿君胸次问，与湖同大小。\n百川尽倾输，万象皆明瞭。\n秋涛动山岳，春波润枯槁。\n浩气蒸作云，为霖施八表。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26468,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈方伯邀观惠山泉","author":"杨守阯","text":"古庙三贤在，方塘一鉴开。\n水流螭吻出，源发鹫峰来。\n树影波心见，茶香云外栽。\n竹炉有风味，醒却紫霞杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26469,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"王仪宾第赏菊","author":"杨守阯","text":"王晋卿家菊满篱，我来犹见傲霜枝。\n清芬只合秋兰并，冷艳宁教睡蝶知。\n已过重阳还对酒，为怜晚节更题诗。\n回看桃李东墙外，不及春风二月时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26470,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送人赴南京督府","author":"杨守阯","text":"驿路霜风落叶深，马蹄南去正骎骎。\n欲从虎帐提金印，巳向龙墀听玉音。\n千里旧都兵卫足，百年昌运羽书沈。\n青油幕下应无事，绿水红蕖对客吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26471,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送某通判","author":"杨守阯","text":"春秋经学旧知名，早向薇垣听鹿鸣。\n齐国几年操瑟立，吴门今日副车行。\n罗浮山上云连海，杨子江头月满城。\n万里修程初展骥，好将膏泽润苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26472,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送蒋容知州","author":"杨守阯","text":"潞河更鼓正分明，可柰风筝别调声。\n百鍊谁能为绕指，一麾聊复得专城。\n云连剑阁凌空峭，月照潼江彻底清。\n莫道遐方淹骥足，金闺仙籍待通名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26473,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和武靖侯赵公赏花诗","author":"杨守阯","text":"宿雾初收雨过檐，侯门池馆绿阴添。\n波间香饵金鳞出，叶下黐竿翠羽黏。\n谩遣易牙调异馔，不教扶朗识生盐。\n酒阑夜色清如水，露滴松稍湿老髯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26474,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵寄丹陵尹陈明远","author":"杨守阯","text":"令尹书椷手自开，犹谈祖席劝深杯。\n喜闻惠泽覃花县，赢得芳声到柏台。\n比屋弦歌明月里，数村耕稼白云隈。\n会看骥足亨衢展，久识君非百里才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26475,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"初署院印","author":"杨守阯","text":"霞明禁苑日初升，遥望龙墀虎拜兴。\n职业乍纡方寸印，官衔仍是一条冰。\n槐厅吏散清阴合，柳院莺啼淑气蒸。\n文武衣冠多旧识，贺门欢宴酒如渑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26476,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"间居漫兴","author":"杨守阯","text":"公署抽毫每隔旬，私居终日乐门身。\n满床黄卷为师友，排闼青山作主宾。\n一任漫天风絮乱，祗怜匝地雨苔新。\n日高卧听莺声巧，不唤鸡鸣待漏人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26477,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"岁馀感怀","author":"杨守阯","text":"莺花三月到南州，冰雪相看一岁周。\n天上故人多特达，周南太史尚淹留。\n海桑世事忙中变，水竹幽居梦里游。\n最忆去年当此夜，弟兄相与醉新篘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26478,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送于国用编修养病归","author":"杨守阯","text":"清朝贤俊共弹冠，抱病怜君独解官。\n圣主恩深蒙赐告，故人情厚劝加餐。\n蕲阳易得三年艾，楚泽还滋九畹兰。\n征雁飞飞南又北，凭传尺素报平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26479,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送董启之进士","author":"杨守阯","text":"柏府先翁教一经，长杨赋就献明庭。\n皇华轺传过亲舍，楚国宗藩望使星。\n万里云程初发轫，三湘秋水试扬舲。\n殷勤相赠无他语，记取金人背上铭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26480,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄从子茂元","author":"杨守阯","text":"我怀犹子在长沙，天北天南各一涯。\n为问同年外台使，不知何处郡丞衙。\n竹林风月閒来久，湘水云烟望转赊。\n圣主恩深汉文帝，赐环仍与陟清华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26481,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"清士","author":"杨守阯","text":"容仪脩饰色通明，出处曾占既济亨。\n玉乳先春资吐纳，真铅伏火抱澄泓。\n襟怀倾倒卢仝碗，风韵和鸣子晋笙。\n若遇提撕从鼎鼐，也输涓滴润苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26482,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和儒","author":"杨守阯","text":"自少相从安乐窝，冬无炉火奈伊何。\n能将蟹眼汤吞尽，不怕龙须席冷多。\n身在提撕明似拭，口当输写气犹和。\n寒宵得汝常安寝，一任人嘲春梦婆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26483,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送范吉太守","author":"杨守阯","text":"宣城太守出风尘，尽道玄晖有后身。\n紫禁莺花闻奏语，黄童竹马待回轮。\n相逢尽话沧洲趣，乐事犹怀泗水春。\n重念河汾六经在，薛收曾是受诗人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26484,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"与杨廷俊同斋","author":"杨守阯","text":"同官同姓又同阶，同作宫寮共宿斋。\n四壁寒声风刮户，一帘清影月侵阶。\n奚童秉炬烧香篆，侍史收衣护祭牌。\n坐久话阑心似水，尘氛无路入襟怀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26485,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"长至日界首阻风","author":"杨守阯","text":"云帆遥逐雁南征，屈指三旬计客程。\n路入淮扬两州界，时逢天地一阳生。\n石尤风气连云黑，甓社湖光入夜明。\n还忆往年当此日，满襟风雪上陵行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26486,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵酬翰长马良佐","author":"杨守阯","text":"东出长安第一衙，地分佳丽职清华。\n晨催玉漏犹高枕，夜对金莲不草麻。\n紫殿当头回日月，青山排闼送云霞。\n神仙洞府斯为上，我亦曾游坐判花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26487,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"释奠即事有感","author":"杨守阯","text":"垂世功高在六经，祠官八佾舞于庭。\n致斋三日从先甲，祀典千秋属上丁。\n祝版名书皇帝遣，丽牲碑勒史臣铭。\n何时义采遵尧录，帝号加封假鲁灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26488,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"到家喜入新第","author":"杨守阯","text":"曾将奏疏入金銮，敕赐围廛廿亩宽。\n苟合苟完成此室，爰居爰处咏斯干。\n墙梅蓓蕾含春意，庭柏森严耐岁寒。\n欲作休休亭自逸，君恩未报敢求安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26489,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"拜湖后张四舅墓","author":"杨守阯","text":"湖后山前度石桥，斧堂三尺众峰朝。\n行经雾霭迷榛莽，拜起岚光动树标。\n假馆曾闻庭下训，知音先识爨中焦。\n今朝一掬羊昙泪，洒向东风湿柳条。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26490,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"饮大理家兄宅时驾部弟秋官侄及君美御史时升府丞两婿皆在席醉吟一首","author":"杨守阯","text":"几年离索重相逢，笑语哄堂意气浓。\n薛氏弟兄三附凤，桓家女婿两乘龙。\n竹林更有青云器，棘寺新开绿蚁封。\n家庆合欢蒙帝德，勉图勋业佐时雍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26491,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"吴原博少宰旧有别业其从子为搆二亭其间","author":"杨守阯","text":"旧业吴门今复脩，重开小筑近西畴。\n不同往日围棋墅，已办归时命驾游。\n谢傅赏心嘉玉树，杜陵高兴付沧洲。\n为霖更望龙头在，未许安排范蠡舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26492,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"腊月十一日奉天殿进书","author":"杨守阯","text":"紫宸班列晓钟初，拜进缃编上玉除。\n禹贡九州经制法，周官六典太平书。\n重瞳日月垂明鉴，三殿云霞映卷舒。\n文武宪章应有在，致君尧舜复何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26493,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"甲子元日","author":"杨守阯","text":"去年金阙候朝参，今日瞻卬北斗南。\n新喜岁华逢甲子，早传家事付丁男。\n遮贤几许六旬九，祝圣惟呼万岁三。\n厚禄素餐无以报，伐檀歌诵不胜惭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26494,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"诏晋升吏部尚书致仕","author":"杨守阯","text":"礼年登七合投簪，况复衰颜病已侵。\n再疏陈情归待报，九重恩命愧难任。\n崇阶进蹑尚书履，厚蓄何须季子金。\n林下清风贫亦乐，不忘忧国老臣心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26495,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游东湖普恩霞屿诸寺","author":"杨守阯","text":"东游如入辋川图，野鸟沙禽共唤呼。\n碧树森罗三宝地，青山环绕万金湖。\n人逢首夏衣穿葛，节近端阳酒泛蒲。\n一宿招提扪藓壁，达摩还面九年无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26496,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"到福州城奉和家大人韵","author":"杨守阯","text":"闽越南来第一州，城中三岛列仙游。\n诸番珍舶来重译，万顷涂田种两收。\n榕巷书声灯火夜，蓼汀渔唱棹歌秋。\n道山亭在烟霞里，未得登临最上头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26497,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"应制西山胜刹","author":"杨守阯","text":"四海升平百度新，西山诸刹倚青旻。\n烟霞栈道通仙境，金碧楼台隔世尘。\n万壑松风和梵呗，千门萝月照禅身。\n旃檀满殿炉烟袅，祝我皇图亿万春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":26498,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]