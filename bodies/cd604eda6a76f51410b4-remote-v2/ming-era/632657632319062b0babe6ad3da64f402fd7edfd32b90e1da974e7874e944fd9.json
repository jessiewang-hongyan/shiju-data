y","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34517,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"删梅二首 其二","author":"黎遂球","text":"老干斜披数点香，便移顽石亚欹长。\n蓬头自是山人妇，不可无裙借薜裳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34518,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春园八首 其一","author":"黎遂球","text":"雨馀春水绿平添，一夜梨香带梦淹。\n晓起更嫌风恶甚，小亭东角下双帘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34519,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春园八首 其二","author":"黎遂球","text":"蝶雏初褪绿香胎，便学寻花隔院来。\n斜过短墙飞不住，又随红蕊浪吹回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34520,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春园八首 其三","author":"黎遂球","text":"青苔如抹笋芽肥，点径残红作地衣。\n竹岸水阑閒一立，绕人双燕傍晴归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34521,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春园八首 其四","author":"黎遂球","text":"风吹窗纸似鸣弦，小小杨枝舞外边。\n向午短衫赢一枕，竹门深寂闭香眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34522,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春园八首 其五","author":"黎遂球","text":"不禁风竹刺茅居，截去长枝学钓鱼。\n閒与鹭鹚相对坐，矶头看尽种花书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34523,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春园八首 其六","author":"黎遂球","text":"木棉花似海棠鲜，和雨和云睡半天。\n寒食过时纷自下，满城都不解相怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34524,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春园八首 其七","author":"黎遂球","text":"新种荷根满尺强，未须裁叶作衣裳。\n金鞍年少初相过，折得如杯当羽觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34525,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春园八首 其八","author":"黎遂球","text":"白玉儿郎一十三，海棠开尽每来探。\n轻罗袖底松花片，索写新词日满函。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34526,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张玉笥邑父师入觐二首 其一","author":"黎遂球","text":"五石羊亭列祖筵，神君原是玉堂仙。\n飞花满县都无税，别去何妨选大钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34527,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张玉笥邑父师入觐二首 其二","author":"黎遂球","text":"酌水沉香又一时，石仙城下拜生祠。\n于今市贩和耕妇，不暇江头祀隐之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34528,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨柳枝词四首 其一","author":"黎遂球","text":"翠压朱阑十二干，满堤杨柳一般看。\n如何苏小门边树，偏有游人系玉鞍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34529,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨柳枝词四首 其二","author":"黎遂球","text":"树树青青叶叶开，低腰宜浪舞宜台。\n莫多移到江都种，系得君王不肯回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34530,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨柳枝词四首 其三","author":"黎遂球","text":"垂柳垂杨乱著丝，行人都拟为相思。\n不知原是双双树，生长桥头惯别离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34531,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"杨柳枝词四首 其四","author":"黎遂球","text":"参差杨柳又如齐，二月雏莺上下栖。\n怪得多情青眼便，春风常笑雨常啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34532,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒榻病馀笑目前景物都无可咏因戏作天上宫词四首 其一","author":"黎遂球","text":"宫门初放凤凰鸣，掌籍随班礼太清。\n奏定人间新贵榜，案前偷觑得头名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34533,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒榻病馀笑目前景物都无可咏因戏作天上宫词四首 其二","author":"黎遂球","text":"长幡曲盖宝光连，冠却芙蓉侍两边。\n直日退馀无一事，又寻丹箓勘诸仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34534,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒榻病馀笑目前景物都无可咏因戏作天上宫词四首 其三","author":"黎遂球","text":"玉天妃子盛妆馀，环佩玎珰曳紫裾。\n昨夜宴阑新有命，紫微宫里掌文书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34535,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寒榻病馀笑目前景物都无可咏因戏作天上宫词四首 其四","author":"黎遂球","text":"太微宫内散灵符，乐托来朝古丈夫。\n班罢径同香案吏，天门东去看投壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34536,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"滕县即事","author":"黎遂球","text":"白骨成山潦水肥，平妖诸将论功归。\n诛彝未必皆无罪，莫讶歌旋赐锦衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34537,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"江姬以忤贵陷狱念其冤救之谬欲身报赋诗以遣","author":"黎遂球","text":"飞去无劳首重回，春风何力柳眉开。\n他生若作衔环鸟，莫向名花队里来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34538,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游丝曲","author":"黎遂球","text":"陌上迢迢怨别离，轻风一道罥游丝。\n东家曳却残花去，系得西邻日正迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34539,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"少年行","author":"黎遂球","text":"年少传闻十二州，报人雠尽转多雠。\n经行不用变名姓，醉卧胡姬卖酒楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34540,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖纪咏和阳羡谢山人韵三首 其一","author":"黎遂球","text":"翡翠如屏叠嶂围，碧纱笼罩晚烟霏。\n红裾玉面偏遥见，几处菱歌信棹归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34541,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖纪咏和阳羡谢山人韵三首 其二","author":"黎遂球","text":"垂柳台前半勒缰，桃花马上少年郎。\n寻欢不值还追去，绕尽新荷十里香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34542,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖纪咏和阳羡谢山人韵三首 其三","author":"黎遂球","text":"轻风吹水荡平澜，日午渔钩未上竿。\n几处洗妆流粉腻，里湖波煖外湖寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34543,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同伍国开谭元定游西山杂咏二十首 其一","author":"黎遂球","text":"都门西出马蹄骄，望望山光路不遥。\n尽是内人香火寺，月明湖上听笙箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34544,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同伍国开谭元定游西山杂咏二十首 其二","author":"黎遂球","text":"新柳风吹与浪黄，画桥东去玉泉长。\n年年三月花飞节，得入宫门泛御香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34545,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同伍国开谭元定游西山杂咏二十首 其三","author":"黎遂球","text":"贵戚庄园隔寺开，夕阳流水绕亭台。\n为留进上诸花卉，不放閒游载酒来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34546,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同伍国开谭元定游西山杂咏二十首 其四","author":"黎遂球","text":"玉泉山后数家村，亦有先朝太子园。\n不识建文坟上树，落花狼籍燕衔喧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34547,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]