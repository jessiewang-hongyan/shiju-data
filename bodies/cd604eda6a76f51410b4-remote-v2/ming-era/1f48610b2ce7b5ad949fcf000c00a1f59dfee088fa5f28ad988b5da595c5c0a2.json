[{"title":"寿姚松云翁七十次林见素韵二首 其一","author":"黄仲昭","text":"阳月如春昼不寒，稀年寿酒足为欢。\n蟠桃一实三千岁，青鸟传音约再看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿姚松云翁七十次林见素韵二首 其二","author":"黄仲昭","text":"晴曦光映舞衣斑，满面和风动笑颜。\n俯仰乾坤还自幸，百年青眼有南山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送妻弟罗元吉之任汝州司训次林大司成韵","author":"黄仲昭","text":"一铎新持教汝州，西风话别岊溪头。\n骊驹迭奏催行酒，霜柳难将绾去舟。\n飞梦不离闽岭月，作人有待郤林秋。\n清时莫叹长才屈，大手还修五凤楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"郑藏庵诣下皋访予不遇以诗见贻次韵答之","author":"黄仲昭","text":"闻君过访石田隈，自笑尘缘拨未开。\n春瓮无由酾酒候，奚囊又喜送诗来。\n待看一雨通溪舫，还约重游扫径苔。\n地僻衡门长寂寞，可堪嘉客又空回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽林文恢教授","author":"黄仲昭","text":"蔗境优游味正浓，黄梁一梦蕙帷空。\n菊松三径悲元亮，桃李诸生哭马融。\n高冢麒麟秋草里，穹碑赑屃夕阳中。\n贤郎无限思亲泪，洒向西风恨不穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次张坦斋作广化山水图","author":"黄仲昭","text":"谁写云山著此僧，王维去后让君能。\n松庭鸟下闻斋磬，萝径烟消见佛灯。\n春雨小溪流㶁㶁，夕阳孤塔影棱棱。\n看图便欲离尘俗，共结茅庵紫翠层。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙辰九月廿四日致政归寓蒜岭驿次韵二律 其一","author":"黄仲昭","text":"宦海何劳叹望洋，东篱犹有菊花黄。\n惟应鸟倦投林下，遑恤牛伤喘道傍。\n蕉鹿纷纭怜世路，莼鲈肥美正秋霜。\n济川舟楫今无数，谁问天涯野水航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丙辰九月廿四日致政归寓蒜岭驿次韵二律 其二","author":"黄仲昭","text":"食禄无才翼圣朝，挂冠奚敢谓贤劳。\n渊明只合归三径，贡禹应宜上九霄。\n满地黄云秋稻熟，连天碧海瘴烟消。\n尘踪自笑诗怀减，忽见乡山又觉豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈吉甫韵二首 其一 春草","author":"黄仲昭","text":"似与东君有夙期，阳回便觉蔼晴熙。\n幽情径路无媒处，诗思池塘入梦时。\n极浦含烟萦别恨，小窗交翠惬吾私。\n宦途未了红尘债，醉藉芳茵知是谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和陈吉甫韵二首 其二 春水","author":"黄仲昭","text":"积雨平湖水接空，混茫不复辨西东。\n长桥柳色澄深翠，断岸桃花映浅红。\n人喜兰亭流玉斝，我怀沂水浴清风。\n几回江上看湍急，直欲穷源路未通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过汾水关和高都宪韵","author":"黄仲昭","text":"不待寻看地志文，此关形势昔曾闻。\n天教闽楚从兹限，水向东西特地分。\n商旅夜酣山店月，旌旗暮捲戍楼云。\n时平四海无烽警，守险何须万灶军。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿车盘驿和陈文耀方伯韵 其一","author":"黄仲昭","text":"行尽闽山几日程，马头人见楚山迎。\n君恩未效涓埃报，垂老兹行敢为名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿车盘驿和陈文耀方伯韵 其二","author":"黄仲昭","text":"只说闽山是故山，今朝倏已出闽关。\n古今经济谁无憾，毕竟还须早丐闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题常思岭兰若二首 其一","author":"黄仲昭","text":"天风吹我上招提，回首群峰势尽低。\n过客登楼因览胜，老僧泚笔请留题。\n春云阁雨过青嶂，行潦流花入小溪。\n自笑迂疏成底事，亦驱羸马走东西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题常思岭兰若二首 其二","author":"黄仲昭","text":"蓬莱何处觅仙家，小刹闲吟兴亦赊。\n门外有山都是竹，庭前无地不栽花。\n半生牢落多行路，几度经过此啜茶。\n日暮又投山驿去，回看楼阁倚云斜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"三山林教谕先生挽诗","author":"黄仲昭","text":"蚤际风云登月窟，旋承雨露下天除。\n棘闱多士推衡鉴，芹泮诸生仰范模。\n浮世功名归一梦，朝阳文彩见三雏。\n褒封况有双鸾诰，万丈龙光照故墟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感事偶书","author":"黄仲昭","text":"壮心一片今犹昔，浮世多岐自町畦。\n巷伯谩劳伤贝锦，伏波谁与辨文犀。\n从来山水知音少，何怪雌雄过眼迷。\n赖有婵娟天际月，夜深还照小窗西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽郭州判","author":"黄仲昭","text":"佐县才华众所钦，重看佐郡慰民心。\n一时品藻归清誉，几树甘棠蔼绿阴。\n枳棘忽惊丹凤老，松楸长锁白云深。\n宦途喜有承家子，奕奕声光动士林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送道录司玄义堵崇德还京","author":"黄仲昭","text":"帝遣仙郎下玉墀，函香远祀二真祠。\n江山胜处时停骑，星斗光中夜祝釐。\n王事有期秋复暮，归舟难绾柳空垂。\n霜台自笑贫如洗，握手临岐只赠诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿进士吴浚母八十","author":"黄仲昭","text":"八帙慈亲初度晨，皇华桂子正归程。\n分将天禄供珍膳，摘取梅花荐寿觥。\n锦服暂为莱服舞，使星高傍婺星明。\n苍天福善应无极，鸾诰还看荷宠荣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和韵题露竹并菊","author":"黄仲昭","text":"湘君夜降骑青鸾，金钿落地光团团。\n化作翠筠与黄菊，空山共傲风露寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和韵题雨竹并菊","author":"黄仲昭","text":"雨过琅玕湿未乾，霜馀黄菊尚堪餐。\n他年何处偏思尔，紫陌鸡声旅梦残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿仙游彭大尹母孺人八十","author":"黄仲昭","text":"花县仙郎献绩归，故园因得寿慈闱。\n蟠桃花并宜男发，南极星连婺女辉。\n兰玉一庭春不老，星霜八帙世尤稀。\n更裁文锦三千丈，岁岁高堂换舞衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题孟浩然寻梅图二首次同年三山王廷用韵 其一","author":"黄仲昭","text":"瑶琴世路少知音，赖有梅花独可寻。\n折取一枝良不俗，小斋亦足伴清吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题孟浩然寻梅图二首次同年三山王廷用韵 其二","author":"黄仲昭","text":"盛唐风雅见遗音，千古斯人何处寻。\n幸有良工写真意，蹇驴犹似对花吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题三山施克端江湖览胜卷次张坦斋韵","author":"黄仲昭","text":"乾坤我欲遍经过，世事参商奈老何。\n梦绕洞庭秋水阔，心驰禹穴暮云多。\n晋阳谩想唐尧迹，蜀道空传李白歌。\n访古知君多历览，遗风还似昔年么。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经常思岭兰若和沈大参韵二首 其一","author":"黄仲昭","text":"白云闲伴山僧住，阅尽浮生客行路。\n老龙行雨泽人间，云自无心不飞去。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经常思岭兰若和沈大参韵二首 其二","author":"黄仲昭","text":"素心长与碧山期，垂老无缘慰所思。\n安得禅房分半榻，尘缨濯向竹间池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题林氏婿宜荣翠庭卷和杨大参韵二首 其一","author":"黄仲昭","text":"佳趣盈庭浩莫禁，春风积翠浅还深。\n理从橐籥机中悟，诗向池塘梦里寻。\n日煖浓香薰寿酒，雨馀生意契吾心。\n老予粗识濂溪意，剧论时容杖屦临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题林氏婿宜荣翠庭卷和杨大参韵二首 其二","author":"黄仲昭","text":"寸心役物苦难禁，揭扁藏修托意深。\n天地化工随处见，鸢鱼理趣个中寻。\n须酬韦相传经志，莫负侯翁择婿心。\n万里应从跬步始，青编珍重日窥临。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题亡友王世魁所藏墨菊","author":"黄仲昭","text":"昔年曾忆此逢君，花满东篱载酒频。\n今日重来花似旧，悽凉不见种花人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经俞潭宿香田庄怀一鹤公子次郑东园二绝 其一","author":"黄仲昭","text":"宦辙驱驰东复西，青山旧路十年迷。\n斜阳舣棹澄潭上，拟共林间一鹤栖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"经俞潭宿香田庄怀一鹤公子次郑东园二绝 其二","author":"黄仲昭","text":"拟共林间一鹤栖，鹤飞云路望中迷。\n相思吟倚阑干立，月上松梢影渐西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题九仙观梅崖","author":"黄仲昭","text":"老梅奇崛石崚嶒，千古风霜共结盟。\n世态炎凉少知己，不妨尊酒伴双清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"挽恭悯钟先生","author":"黄仲昭","text":"青年射策上金銮，豸服荣联玉笋班。\n抗疏从教龙准怒，捐生欲夺凤雏还。\n心同仁杰艰虞际，节与周昌伯仲间。\n此日贤郎登禁从，苍天报应未应悭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒馀干东山书院","author":"黄仲昭","text":"山连县市寂无哗，先哲遗踪更可嘉。\n鸟外风帆来客舫，云边烟树见人家。\n圣经浑灏从来正，俗学纷纭却自邪。\n安得紫阳长不死，挥毫重为黜浮华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27638,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬子二月半由金溪往安仁道中作","author":"黄仲昭","text":"半月雨声应暂息，一年春色已平分。\n煖回花坞蒸红雾，晴入林峦涨绿云。\n报国丹心空耿耿，欺人白发故纷纷。\n暂因行路心无事，明日安仁又校文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27639,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"壬子春感怀","author":"黄仲昭","text":"到官两度阅年华，无补明时祗自嗟。\n士习未全趋正学，词章犹觉尚浮誇。\n作兴深负人期望，寝食难忘帝宠嘉。\n春雨连旬农事动，梦魂无夜不还家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27640,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过匡庐山阴雨诸峰不得见用张太史韵二绝 其一","author":"黄仲昭","text":"我来欲览匡庐胜，烟雨冥濛在翣时。\n事到眼前犹不遂，前途得失底须知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27641,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过匡庐山阴雨诸峰不得见用张太史韵二绝 其二","author":"黄仲昭","text":"五老诸峰锁翠烟，瀑声依约听潺湲。\n奇观又负平生望，欲诉山灵孰为传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27642,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予到官甫二阅岁顿觉老态日增因赋二绝 其一","author":"黄仲昭","text":"镜里韶华叹易徂，眵昏双眼白头颅。\n写真欲寄儿孙看，只恐惊疑不是吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27643,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"予到官甫二阅岁顿觉老态日增因赋二绝 其二","author":"黄仲昭","text":"忆别乡园岁两徂，当年玄发尚盈颅。\n故人久别重相见，尽说今吾非故吾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27644,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑞州分司次璧间诸公留题韵二首 其一","author":"黄仲昭","text":"星轺又是瑞阳城，终岁奔驰笑此生。\n山崦孤村藏竹暝，野塘流水入田平。\n桑榆晓日千门影，弦诵春风几处声。\n俯仰乾坤惊白发，百年心事竟何成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27645,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑞州分司次璧间诸公留题韵二首 其二","author":"黄仲昭","text":"历遍西江列郡城，口宣天语示诸生。\n词章直欲回纯雅，学术深期辅治平。\n富贵片时真是梦，圣贤千古尚垂声。\n斯文揣分非模范，大器还应自铸成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27646,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自龙南往安远道中作","author":"黄仲昭","text":"闽广封疆此接连，地偏别是一风烟。\n路回忽俯千寻涧，岭峻应疑尺五天。\n亘野顽云垂幕瞑，扑衣飞霰跳珠圆。\n斯文倘可裨分寸，行役驱驰敢自怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27647,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自信丰往龙南过竹高岭作","author":"黄仲昭","text":"登登已度几嶙嶒，鸟道萦回尚未平。\n宪节双穿青霭去，轺车多傍白云行。\n山如盔甲偶然事，民习干戈遂得名。\n司牧倘能兴道化，贪泉宁浼隐之清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27648,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自瑞金往石城过鹅公崠作","author":"黄仲昭","text":"嶙嶒高崠切云霞，倦客经行思转赊。\n深径黄茅数十里，荒村绿树两三家。\n羊肠诘屈循崖转，马足凌兢怯石斜。\n世路险巇宁独此，市朝平坦更堪嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27649,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赣州南安两郡观风感怀","author":"黄仲昭","text":"赣江横浦历星槎，两郡提封数万家。\n守令几人崇道化，士民比屋事豪奢。\n尘劳未息吟无绪，心事多违鬓有华。\n莫道故园先业薄，锄荒犹足种桑麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27650,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁州道中二首 其一","author":"黄仲昭","text":"行边文牍暂停披，闲阅民风一赋诗。\n白石炼灰培䆉稏，青山锄雨种蹲鸱。\n烟村桑柘通幽径，野店杉篁护短篱。\n闻说昌黎遗爱在，千年尸祝有严祠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27651,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁州道中二首 其二","author":"黄仲昭","text":"望中烟树是宜阳，抚景尘劳觉暂忘。\n远郭诸山圆箘列，倚天群岫翠屏张。\n颇闻儒术惭邹鲁，却喜民风似魏唐。\n太守词林旧文雅，行看弦诵蔼宫墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27652,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒南安道源堂","author":"黄仲昭","text":"乾坤有此三夫子，邂逅于兹岂偶然。\n数卷图书探道妙，一襟风月悟心传。\n斯文统绪承先圣，理窟渊源启后贤。\n我欲抠衣挹温厉，德容无计起重泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27653,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"自石城往宁都道中作","author":"黄仲昭","text":"穷冬风露晓凄其，倦客何时息马蹄。\n山合忽疑前路断，峰高翻觉宿云低。\n丹枫翠竹攒幽涧，绿蔓黄茅没古蹊。\n谩说闽疆近相接，故园千里望中迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27654,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒南安道源堂再用前韵","author":"黄仲昭","text":"圣学湮沉世几迁，先生推阐复昭然。\n羲前至理探无极，轲后斯文赖有传。\n星聚奎躔开道化，天将文教付名贤。\n千年坠绪思重续，掘井何人已及泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27655,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"南安访同年张东海祠和同年张泰侍御韵","author":"黄仲昭","text":"南安大守知多少，谁复如君有此祠。\n施设总根经史学，死生均系吏民思。\n平生不负王曾志，终古难磨叔子碑。\n遗像俨然犹不死，何须更赋拟招诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27656,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次陆宪长元日即时口和四首 其一","author":"黄仲昭","text":"雨声除夕响泠泠，元日乾坤一色冰。\n欲起尧夫询世事，北方风气果南行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27657,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次陆宪长元日即时口和四首 其二","author":"黄仲昭","text":"春回已是过旬日，一雨翻成万树冰。\n何日乾坤放春色，傍花随柳一闲行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27658,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次陆宪长元日即时口和四首 其三","author":"黄仲昭","text":"残冬两度冰凝水，今日三阳水又冰。\n闻说苍生多冻馁，不知阳气几时行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27659,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"次陆宪长元日即时口和四首 其四","author":"黄仲昭","text":"易戒履霜防渐长，于今三度见坚冰。\n腐儒无识空忧叹，自有伊周赞五行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27660,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题同寅洪宪副文坛风月卷次韵 其一 次李若虚韵","author":"黄仲昭","text":"红烛清尊岂偶逢，十年同听禁垣钟。\n豪谈发处风生席，白战酣时月映松。\n应务羡君才独裕，济时愧我术偏庸。\n人生适意应为福，底用凌烟阁上封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27661,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题同寅洪宪副文坛风月卷次韵 其二 次冯佩之韵","author":"黄仲昭","text":"旂常未论百年功，且乐清尊一夕同。\n大嚼霜螯羹荐蟹，熟燔珍掌馔分熊。\n似闻大史占玄象，曾说文星烛紫宫。\n却笑世途多得失，伊谁勘破楚人弓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27662,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题同寅洪宪副文坛风月卷次韵 其三 次屠元勋韵","author":"黄仲昭","text":"高揭吟坛数仞杠，主盟骚雅树旌幢。\n风过禁籞传清漏，月转花衢吠小尨。\n已见明时无滞狱，何妨良夜倒春缸。\n惭予进退俱无补，祇合荷衣钓石矼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27663,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题同寅洪宪副文坛风月卷次韵 其四 次洪宣之韵","author":"黄仲昭","text":"十年径草笑无媒，自分馀生已矣哉。\n失计又随新宦牒，幽情常恋故山梅。\n红尘秪觉添华发，旧业惟应长绿苔。\n拭目看君上寥廓，法星光彩映三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27664,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题紫菜图","author":"黄仲昭","text":"柔丛细蹙紫罗纹，历尽冰霜亦自春。\n更有一般清绝味，嚼来满鼻散芳辛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27665,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画芹菜为李少参士元赋 其一","author":"黄仲昭","text":"何人洒墨写芳芹，眼底犹疑散苾芬。\n参看一心堪赞理，不须持此献明君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27666,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题画芹菜为李少参士元赋 其二","author":"黄仲昭","text":"神农品第列佳蔬，一种清香风味殊。\n冰蘖知君恒自励，饱餐应不羡甘腴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27667,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寿姊夫林君并姊氏七十 其一","author":"黄仲昭","text":"多君访我到洪州，白首还能赋壮游。\n自有神仙在人世，何须方外问丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":27668,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]