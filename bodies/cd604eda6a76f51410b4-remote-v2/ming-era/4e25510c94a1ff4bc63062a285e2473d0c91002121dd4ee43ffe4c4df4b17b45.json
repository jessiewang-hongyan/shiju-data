[{"title":"舟中杂咏用杜子美秦州诗韵 其十二","author":"胡俨","text":"隐隐烟中树，泠泠石下泉。\n露筋当日事，遗庙后人传。\n节挺青云上，神留绿水边。\n往来空怅望，为尔辄凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26569,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中杂咏用杜子美秦州诗韵 其十三","author":"胡俨","text":"茅屋烟村里，渔人十数家。\n矶头鱼在笱，门外鹭翘沙。\n浊酒深浮蚁，扁舟小似瓜。\n不知江月落，和醉卧芦花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26570,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中杂咏用杜子美秦州诗韵 其十四","author":"胡俨","text":"舟度淮南境，迢迢水接天。\n有怀鹓序入，不待雁书传。\n共载人如玉，相酬酒似泉。\n此时心一寸，飞坠五云边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26571,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中杂咏用杜子美秦州诗韵 其十五","author":"胡俨","text":"黄叶凋疏后，沧波窅霭间。\n天寒鸿在渚，日落鸟归山。\n桂树知何处，仙翁去不还。\n丹砂如可问，宁复鬓丝斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26572,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中杂咏用杜子美秦州诗韵 其十六","author":"胡俨","text":"湖水渺无际，霜天雁叫群。\n画船都载酒，清兴浩凌云。\n风月渔樵得，烟波鸥鹭分。\n此中有幽趣，不许俗人闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26573,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中杂咏用杜子美秦州诗韵 其十七","author":"胡俨","text":"维扬江上路，冬日好风光。\n远树犹青幄，居人多画墙。\n醉忘身是客，坐忆玉为堂。\n望望蓬莱近，毋劳纵目长。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26574,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中杂咏用杜子美秦州诗韵 其十八","author":"胡俨","text":"共驾扁舟去，相传远客归。\n江云低度影，山月净流辉。\n且傍鸥群宿，应怜蟢子飞。\n金盘泻瑶露，取醉敌霜威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26575,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中杂咏用杜子美秦州诗韵 其十九","author":"胡俨","text":"正是车书会，何曾道路难。\n月涵江影静，风落叶声干。\n玉醑春容暖，青绫夜色寒。\n吴郎诗句好，俊逸许登坛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26576,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟中杂咏用杜子美秦州诗韵 其二十","author":"胡俨","text":"白发随年长，丹心益自知。\n超宗惭凤翮，子美念熊儿。\n蒲质堪多病，神楼乏上池。\n归来对樽酒，细看菊花枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26577,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄汤得中二首 其一","author":"胡俨","text":"故人居海上，花竹绕幽栖。\n水槛晨呼鸭，风檐晚祝鸡。\n客来樽有酒，歌罢醉如泥。\n谩说书连屋，书签总懒题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26578,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄汤得中二首 其二","author":"胡俨","text":"吏隐海东头，闲情付狎鸥。\n公孙生好饮，子产谩多忧。\n扫石频题句，看山独倚楼。\n遥知相忆处，月色满神州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26579,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"望诸君墓","author":"胡俨","text":"高丘枕长坂，吊古起遐思。\n义感先王重，书存烈士悲。\n落花萦碧草，幽树语黄鹂。\n欲问当年事，卢沟有断碑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26580,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王处敬赴交址佥事","author":"胡俨","text":"拜命出朝端，重峨豸角冠。\n花骢万里去，霜鹗九秋抟。\n海雾连山湿，蛮云蓄雨寒。\n莫言风土异，须使远人安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26581,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题鉴湖图","author":"胡俨","text":"昔闻镜湖美，今向画图看。\n百里晴空映，千峰秀色攒。\n荷花明月晓，鸥鸟白云寒。\n投老寻狂客，扁舟兴未阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26582,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄士奇学士","author":"胡俨","text":"同是侍经帷，三年语笑违。\n病来归梦数，老去故人稀。\n目暗时揩眦，身癯日剪衣。\n相思意无限，都逐雁南飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26583,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡学士山居八咏 其一 芳洲春草","author":"胡俨","text":"闻说芳洲上，春来生意多。\n微风交远翠，细雨涨沧波。\n径没人稀到，泥香燕屡过。\n康成读书处，碧带晚烟和。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26584,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡学士山居八咏 其二 竹坞云林","author":"胡俨","text":"修竹藏深坞，白云生远林。\n雨晴添暖翠，月澹度秋阴。\n野老频携客，幽人独鼓琴。\n何时来扫石，相对一开襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26585,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡学士山居八咏 其三 沧江烟雨","author":"胡俨","text":"渺渺沧江上，冥冥烟雨来。\n几家茆屋掩，一个钓船回。\n岸花红欲放，沙鸟白相偎。\n薄暮明霞出，清风扫雾开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26586,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡学士山居八咏 其四 玉山泉石","author":"胡俨","text":"白石何齿齿，流泉亦涓涓。\n泉声寒作雨，石气暖生烟。\n把钓溪边去，看云窗下眠。\n鹿麋相见孰，来往草堂前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26587,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡学士山居八咏 其五 石屋晴澜","author":"胡俨","text":"幽居邻石屋，碧水涨晴澜。\n净蹙縠纹细，清同练影寒。\n文章含露藻，气势压风湍。\n几度携筇去，临流不厌看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26588,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡学士山居八咏 其六 墨潭秋月","author":"胡俨","text":"夜深潭影黑，秋净月华明。\n游女珠频弄，潜蛟卧不惊。\n苏公赤壁赋，杜老渼陂行。\n千载神交处，高吟兴共清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26589,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡学士山居八咏 其七 螺冈晚照","author":"胡俨","text":"暮色苍苍起，螺冈敛夕晖。\n树林初晻霭，彩翠忽霏微。\n川暝渔樵去，村深鸟雀归。\n谁家事机杼，灯火出柴扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26590,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"胡学士山居八咏 其八 芙蓉寒雪","author":"胡俨","text":"千迭芙蓉秀，朝来玉削成。\n风泉寒有韵，阴壑冻无声。\n学士龙团贵，仙人鹤氅轻。\n长林书屋下，课诵到天明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26591,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨雪中独坐怀杨学士士奇二首 其一","author":"胡俨","text":"独坐听春雨，萧然兴味孤。\n病多亲药裹，睡少闭茶垆。\n未了三生梦，惟存一字符。\n故人在深巷，相过畏泥涂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26592,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨雪中独坐怀杨学士士奇二首 其二","author":"胡俨","text":"雨止雪复作，珊珊听瓦鸣。\n炉存毡罽暖，冰薄砚池清。\n喜得青春至，惊添白发生。\n共传杨子宅，山药胜黄精。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26593,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄示从子旭","author":"胡俨","text":"记得分携处，夕阳明画船。\n含情望天末，洒泪别江边。\n为客嗟吾远，承家赖汝贤。\n步兵诗句苦，喜有阿咸传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26594,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"试问阶前菊五首 其一","author":"胡俨","text":"试问阶前菊，花开何太迟。\n秋容非老圃，晚兴似东篱。\n已是重阳后，那堪夕露滋。\n鹅翎与鹤顶，莫遣一时披。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26595,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"试问阶前菊五首 其二","author":"胡俨","text":"试问阶前菊，何能独傲霜。\n不随春竞秀，直到晚腾芳。\n采采衣襟润，盈盈金玉相。\n病来长废酒，对尔兴难忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26596,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"试问阶前菊五首 其三","author":"胡俨","text":"试问阶前菊，何如陶令家。\n门无五株柳，坐对一庭花。\n寂寂秋将尽，萧萧鬓已华。\n几时归故里，稚子引柴车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26597,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"试问阶前菊五首 其四","author":"胡俨","text":"试问阶前菊，南阳近若何。\n花开金布地，叶落翠浮波。\n黄发人多寿，华轩客少过。\n自怜缠末疾，安得起沉疴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26598,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"试问阶前菊五首 其五","author":"胡俨","text":"试问阶前菊，湘潭秋已残。\n灵均去不返，骚客竟谁餐。\n花老青山暮，丛疏白露漙。\n传芭还代舞，姱女不胜寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26599,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代菊荅五首 其一","author":"胡俨","text":"众卉凋零后，孤芳勿讶迟。\n托根依广砌，毓秀胜疏篱。\n秪恐严霜至，频烦细雨滋。\n岁寒无剪伐，不自叹离披。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26600,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代菊荅五首 其二","author":"胡俨","text":"日精钟秀气，故自傲风霜。\n晚节甘同固，春葩不共芳。\n每烦骚客咏，长得逸人相。\n老向轩墀下，栽培讵可忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26601,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代菊荅五首 其三","author":"胡俨","text":"昔日柴桑里，独怜征士家。\n牵衣从稚子，随处看幽花。\n把酒秋山净，餐英夕露华。\n陶然乘醉后，策杖不将车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26602,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代菊荅五首 其四","author":"胡俨","text":"有酒不畅饮，人生能几何。\n既无篯老术，空羡菊潭波。\n岁久荆榛杂，山空樵牧过。\n黄精同服饵，亦足愈寒疴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26603,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"代菊荅五首 其五","author":"胡俨","text":"洞庭风力劲，草木半摧残。\n逐客伤秋尽，初英向夕餐。\n凄凄霜未降，厌厌露先漙。\n泽畔行吟处，魂消衣袂寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26604,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"积雪 其一","author":"胡俨","text":"积雪照虚堂，尘消几席光。\n体寒添褐重，炕暖煮茶香。\n旧字无人问，新醅待客尝。\n梅花开处远，衰鬓老何郎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26605,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"积雪 其二","author":"胡俨","text":"积雪覆墙阴，天寒气转深。\n室虚瓶贮粟，药尽橐无金。\n对酒长妨饮，消愁只苦吟。\n伏生经欲授，谁解口传音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26606,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"积雪 其三","author":"胡俨","text":"积雪映窗明，浮云阴复晴。\n砚冰轻欲解，庭树冻含声。\n得食乌频下，需刍马屡鸣。\n孙康书久废，头白愧无成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26607,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"积雪 其四","author":"胡俨","text":"积雪压檐端，风飘坠药栏。\n不愁萱带折，祗恐菊根残。\n麦渍宜三白，毡寒老一官。\n病躯犹强起，肯作卧袁安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26608,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中秋思八首 其一","author":"胡俨","text":"流年如逝水，白日去堂堂。\n爽气今朝入，秋风昨夜凉。\n候鸿离紫塞，栖燕别雕梁。\n儗续闲居赋，潘郎鬓已苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26609,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中秋思八首 其二","author":"胡俨","text":"伯劳鸣未休，大火又西流。\n鸷翮抟空急，荧光傍户幽。\n仲宣长作客，宋玉独悲秋。\n抱疾不能赋，何能更倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26610,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中秋思八首 其三","author":"胡俨","text":"秋风起苹末，秋意日萧然。\n蛩泣苍苔露，蝉愁碧树烟。\n青毡遗故物，白首事陈编。\n却忆东湖上，垂杨老钓船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26611,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中秋思八首 其四","author":"胡俨","text":"已是经年疾，归休未得休。\n橐金浑有限，药饵只空投。\n向秀山阳笛，袁宏月夜舟。\n故人何处在，无复少年游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26612,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中秋思八首 其五","author":"胡俨","text":"远树金飙动，高天玉露凉。\n豆花披草径，梧叶下银床。\n野际寒烟澹，山连夕照长。\n谁家砧杵急，过雁不成行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26613,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中秋思八首 其六","author":"胡俨","text":"未及重阳节，晨兴已觉寒。\n雨侵烧药灶，风折护花栏。\n暂饱雕胡饭，长吟苜蓿盘。\n近闻禾黍熟，颇得老怀宽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26614,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中秋思八首 其七","author":"胡俨","text":"暮天摇落迥，山色有无中。\n篱槿含花紫，池莲坠粉红。\n江清波涌练，云净月流空。\n闺中倚虚幌，老病念衰翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26615,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"病中秋思八首 其八","author":"胡俨","text":"秋雨催寒早，秋霜着物残。\n天高云影澹，树老叶声干。\n白发凭谁染，黄花只独看。\n杜陵笑彭泽，却自叹儒冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26616,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨后咏怀四首 其一","author":"胡俨","text":"绝无人迹到，一室净纤尘。\n树老风梢折，阶寒露菊新。\n少陵悲旧雨，尼父叹孤邻。\n吾衰竟如此，吾道未忧贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26617,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨后咏怀四首 其二","author":"胡俨","text":"日上风檐静，蜘蛛缀网丝。\n绿垂依槛草，红落过墙葵。\n卧疾妨贤久，怀恩报国迟。\n素餐新谢绿，菰米杂粳炊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26618,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨后咏怀四首 其三","author":"胡俨","text":"秋雨一番过，秋风转觉清。\n卷帘黄叶落，倚杖白云生。\n学省虚官署，乡书计客程。\n砧声何处发，偏动老夫情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26619,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雨后咏怀四首 其四","author":"胡俨","text":"抱疾形容改，无情岁月忙。\n草深栽药圃，人老读书床。\n洲渚蒹葭白，山林橘柚黄。\n几时筇竹杖，去踏钓鱼航。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26620,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈文璧赴石首知县","author":"胡俨","text":"杪秋辞阙下，千里赴荆州。\n桃李迎潘岳，蒹葭惜夏侯。\n酒酣青雀舫，霜重黑貂裘。\n民事须勤恤，功名起壮猷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26621,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周庸节赴镇蛮通判","author":"胡俨","text":"拜命为通守，迢迢赴镇蛮。\n聪明敷政易，抚字得宜难。\n涨海春风远，山云晓日寒。\n比来多计吏，毋惜报平安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26622,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"不寐","author":"胡俨","text":"病久浑无寐，更阑气转凄。\n露寒蛩响歇，月落雁声低。\n老厌身为患，魂销梦欲迷。\n箧中袍笏冷，空自听朝鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26623,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜秋","author":"胡俨","text":"黍稷闻皆秀，鸡豚喜渐肥。\n野人能足食，游子憺忘归。\n雨后夕阳好，风前秋叶稀。\n沈郎多病久，一任减腰围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26624,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感秋","author":"胡俨","text":"雨脚疏还密，云头暝复开。\n残蝉辞夏去，一雁送秋来。\n白发人空老，青云心已灰。\n闺中刀尺冷，砧杵又相催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26625,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"昨承召命以末疾不能行感激追赋此","author":"胡俨","text":"老病新看镜，形容太瘦生。\n昨孤前席召，只益负暄情。\n白发千茎短，丹心一寸明。\n玉堂天上近，终日彩云横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26626,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"东里学士携酒肴就菊对酌赋此酬寄","author":"胡俨","text":"雨晴风正急，霜叶下纷纷。\n黄菊澹秋色，青山深暮云。\n芳樽携共酌，独客慰离群。\n临别不知醉，醒来夜已分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26627,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"题子昂枯木竹石","author":"胡俨","text":"碧海珊瑚树，晴窗彩凤翎。\n紫苔封琬琰，翠袖倚娉婷。\n秋色淡华屋，凉风生画屏。\n玉堂归老日，松雪洒余馨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26628,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲辰初度前一夕梦先妣制春衣俨奉二桃甚喜 其一","author":"胡俨","text":"三十失老亲，常逢梦里真。\n劬劳初度日，惭愧百年身。\n白苎春衣洁，红桃露颗新。\n恍然瑶岛上，相对喜津津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26629,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"甲辰初度前一夕梦先妣制春衣俨奉二桃甚喜 其二","author":"胡俨","text":"清夜梦慈闱，适临初度期。\n桃从瑶圃献，身逐彩云飞。\n无复慈乌哺，尚怜游子衣。\n平生爱少子，多病负春晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26630,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋归二首 其一","author":"胡俨","text":"谢病赋归休，官河几易舟。\n水平帆力缓，风细橹声柔。\n豹每藏山雾，狐犹念首丘。\n有怀疏傅达，不为子孙谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26631,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赋归二首 其二","author":"胡俨","text":"昔日乘传去，今年乘传还。\n从教妻子笑，落得鬓毛斑。\n读易方知损，休官始得闲。\n有怀向平达，老去入名山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26632,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过扬州","author":"胡俨","text":"千载繁华地，青山今古同。\n楼台明月在，歌舞彩云空。\n草没雷塘路，花残隋苑风。\n经过求古迹，人事苦悤悤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26633,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过南京三首 其一","author":"胡俨","text":"扈从身犹健，归来发已皤。\n山围形胜地，风涌大江波。\n昔侍金銮晏，今乘画舫过。\n孝陵松柏茂，云际郁嵯峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26634,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过南京三首 其二","author":"胡俨","text":"谬忝司成席，逡巡二十年。\n束书频北上，谢病独南还。\n一寸丹心在，千花紫诰鲜。\n长陵望益远，老泪落潸然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26635,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过南京三首 其三","author":"胡俨","text":"金水绕龙河，春风澹绿波。\n举头瞻日近，抚已受恩多。\n不负青山约，犹怀紫陌珂。\n龙盘与虎踞，卜世万年过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26636,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游白鹿洞诗三首 其一","author":"胡俨","text":"骑从金笳发，肩舆画戟开。\n路穿芳草径，山倚白云隈。\n秋色净如洗，晴岚翠作堆。\n昔贤遗教在，寻访洞中来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":26637,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]