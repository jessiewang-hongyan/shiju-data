[{"title":"出宁国","author":"钟芳","text":"出郭未百里，万山如剑门。\n险途高屈曲，怪石黑嶙峋。\n迹隐飞仙窦，谁为叱驭尊。\n停驺山下馆，烟雨近黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发胡乐巡司抵旌德 其一","author":"钟芳","text":"晨装越重峭，景色忽纷披。\n楼处负岩麓，机舂当水湄。\n落霞红入市，秀麦绿盈菑。\n吏隐谅斯在，玉壶荒是非。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓发胡乐巡司抵旌德 其二","author":"钟芳","text":"天宇碧恢恢，群峰疑与齐。\n晚桥人远近，春陇麦高低。\n土溽琴书润，囹空鸟雀栖。\n无心任鞭扑，闭阁检筌蹄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"叠嶂楼","author":"钟芳","text":"东南名胜地，独见谢公楼。\n列嶂平轩出，双溪绕廓流。\n易耨农忘倦，深藏俗厌浮。\n衣冠传五季，到此未曾休。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽瑞金尹万深战死其子万麟请","author":"钟芳","text":"四郊烽火夜，鏊战背孤城。\n陨血膏荒荠，蜚声灿列星。\n子膺身后宠，人仰在时刑。\n表异丝纶重，千年照汗青。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又叠嶂楼","author":"钟芳","text":"列岫空中落，白云阶下生。\n材疏宜事简，天迥觉神清。\n禾黍秋圩熟，挂罿晚浦明。\n朔风频北望，犹带战尘腥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"敬亭山","author":"钟芳","text":"何地堪登眺，昭亭合暮讴。\n天空驰远思，川逝涤新愁。\n客拜梅公冢，诗传谢氏楼。\n此中如传舍，未必苦相留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"翠云庵","author":"钟芳","text":"结庐直孤高，上有百鸟巢。\n征蹄踠石磴，归鬓掠松毛。\n双塔荒烟合，千峰积雪消。\n卞生持鄙吝，曾足慰民劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄友","author":"钟芳","text":"江汉双鱼断，乾坤一气交。\n宦成翻作累，行立易生嘲。\n诗思愁边杳，归魂梦后销。\n河桥杨柳色，底用斗春饶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"隺村","author":"钟芳","text":"孤冢翳荒原，悠悠不计年。\n堂封培旧圮，碑篆认初镌。\n村舍疏还朴，孙枝远更妍。\n青宵羽衣客，时与下蹁跹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"读窦巩老将吟有感","author":"钟芳","text":"结发事行陈，戈鋋自成家。\n黠胡识旗帜，战马惯风沙。\n猷壮千山震，心劳两鬓华。\n儿曹未更战，唾掌说周遮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送卢备倭英之东广","author":"钟芳","text":"列巘包南戒，雄材出上关。\n剑劘鹑尾暗，旗闪虎牙闲。\n地尽夷通夏，天低水荡山。\n烝黎有遗患，凭仗一开颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿吕道夫母","author":"钟芳","text":"一节抱坤贞，年华与寿新。\n令名完璧玉，瑞世见麒麟。\n恩重宸章丽，班清御幄亲。\n瑶觞称庆日，南极正璘璘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽许舜仁父侍御洪宥","author":"钟芳","text":"邈矣湖东叟，长嗟忆衎容。\n淳庞师邃古，隐恻逮孤穷。\n寿及龙文焕，恩连豸锦重。\n桂觞何处奠，目极瘴江峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽刑部何员外","author":"钟芳","text":"往事真成梦，浮生或似沤。\n朝随仙仗入，暮作夜台游。\n珠陨光犹媚，渊澄泽未流。\n慱兴遗爱在，烟草自春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽人母","author":"钟芳","text":"金殿承恩后，萱堂弃养初。\n哀音伤哺鸟，□索泣枯鱼。\n遗泽衣间润，游魂梦后孤。\n到家肠正断，烟月冷萧疏。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭邵均衡二首，甲戌稿 其一","author":"钟芳","text":"谊交三十载，夷险实同途。\n命薄时终蹇，人亡道益孤。\n伟材名宪识，归榇稚儿扶。\n一片伤心泪，频挥眼欲枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭邵均衡二首，甲戌稿 其二","author":"钟芳","text":"金台梅落候，分手向来宾。\n孤邸思君苦，双鱼寄客频。\n官卑名未减，行洁志堪伸。\n何意龙蛇岁，长徂不及新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过莲塘","author":"钟芳","text":"一自离乡井，于今已八春。\n归鞍过旧驿，扫壁认题痕。\n桀骜沿山寇，离披列塞军。\n荐荒生计匮，宵哭四郊闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次化州舟行沮寇复从石城路","author":"钟芳","text":"百事漫前期，阴晴自有时。\n厌劳宁得逸，欲速反成迟。\n海近风涛恶，寇多舟楫危。\n归途曾不远，幸尔未全迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洪都沮风","author":"钟芳","text":"五日江城下，江船壅不流。\n掩篷自歌啸，吹浪任萧飕。\n岸渚三分冻，烟岚一色秋。\n浊醪滋味薄，微饮亦消愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐次从学韵 其一","author":"钟芳","text":"寸丹不外照，返观祇自明。\n江山如有约，天地合同情。\n静久真源见，思微俗虑平。\n寥寥谁会此，斜月下残更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐次从学韵 其二","author":"钟芳","text":"午云添野色，花柳斗春明。\n游子故留意，东风自不情。\n天连秦苑杳，潮入蜀江平。\n北会争盟后，春秋几变更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜坐次从学韵 其三","author":"钟芳","text":"我爱桃源叟，桃花绕涧明。\n渔樵自成性，鸥鸟共忘情。\n世外乾坤隔，人间岐路平。\n渔人忽相问，醑酒话深更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送卢用中佥宪东广","author":"钟芳","text":"十载滞南曹，新荣叠旧劳。\n秋霜生剑佩，炎瘴避旌旄。\n地引沧溟阔，星回紫极高。\n纪纲不虚布，正属济时豪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送王德升教授酉阳","author":"钟芳","text":"凤阙衔恩出，踟蹰为一留。\n杯分秣陵夜，棹指锦江秋。\n心泰居忘陋，风淳化易流。\n经行多古意，合付尺囊收。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊李一清","author":"钟芳","text":"旁游得佳侣，秋色湛冰壶。\n大地高名在，寸心遗憾无。\n渊澄珠竟陨，宇旷月同孤。\n点点江头泪，频挥暗绿芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"斋居","author":"钟芳","text":"四极朱光遍，潜阴踯躅微。\n气机神自运，君德日同辉。\n京镐周文典，星坛帝舜衣。\n遥瞻云五色，正拥六龙飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"喜晴","author":"钟芳","text":"雨旸时其施，皆足慰阿侬。\n檐鹊噪新曝，廷槐交远风。\n木焚家启酿，弦奏市喧僮。\n肉食嗟何力，冥孚戴舜衷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"竹亭","author":"钟芳","text":"澄襟坐长昼，爱此虚中君。\n秩秩玉堂友，依依钟阜云。\n景融川色媚，野霁曙光分。\n遥意方丘祀，神旗瑞霭纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题九思图","author":"钟芳","text":"?彼西雍鸟，因之寄圣猷。\n丹青传妙手，羽翮见清修。\n致一斯通圣，伤多实乱谋。\n无为浪池鹜，天壤失归投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重阳","author":"钟芳","text":"九日江城望，风烟接百蛮。\n雁声低夕照，诗兴薄秋山。\n把菊欣相遗，思家迥未还。\n升沉休握粟，得酒且开颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潞河","author":"钟芳","text":"鹑火气初交，萍踪次远郊。\n旱乾舟楫滞，推挽仆夫劳。\n日暖沙鸥浴，崖高水燕巢。\n喜看原上麦，葱蔚入烟霄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"细米花","author":"钟芳","text":"叶叶间疏英，深冬树更青。\n色欺女萝嫩，香赛木犀清。\n细细抽金缕，累累缀玉缨。\n蝶蜂何处在，莫敢侦芳馨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"章涯二亲","author":"钟芳","text":"清朝神圣裔，风韵出尘嚣。\n邺架书常满，韩封乐自饶。\n仙腾骈鹤杳，哀思入江遥。\n凉院沉沉夜，疑闻堕玉箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次铜鼓寨","author":"钟芳","text":"日斜临野戍，闲蹑翠云坪。\n金鼓联双舸，江山杳一程。\n烧延虹影烂，滩浅石牙横。\n春意三农足，边陲幸寝兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次永福","author":"钟芳","text":"野戍连青嶂，烟坡尽白茆。\n山川原设险，蛇豕却为巢。\n肃气飞霜霰，军声振鼓饶。\n蠢兹如革面，未忍纵炰炰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲申夏病起","author":"钟芳","text":"齿龋惊衰早，形羸怯岁寒。\n病贻妻子累，起笑带袍宽。\n夭寿皆如寄，行藏信所安。\n早营筠菊胜，拟傍白云闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"容江遇吴太仆人豪过话","author":"钟芳","text":"邂逅逢知己，新凉得雨时。\n舟轻舷易侧，蓬漏座频移。\n糗腊行厨味，榕梧在处诗。\n日曛迟解缆，各语寄相知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈启周少参","author":"钟芳","text":"除檄来枫陛，材猷自不群。\n旌旗摩蜀道，屏翰控秦云。\n意逐凫舟动，春随客袂分。\n霏微亭外雨，应与涤尘氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽赉州居士","author":"钟芳","text":"谢事丹霞外，翛然鬓几星。\n引渠通药圃，移石护芝庭。\n瓮有陶潜酒，家传伏氏经。\n冥魂招不返，风雨撼疏棂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上高别傅侍御","author":"钟芳","text":"蹙蹙别乌台，徐徐棹未开。\n归情终似噎，病骨易为菑。\n山水闻嘉郡，追培负夙怀。\n东风幸予助，吹送吉州来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿叶氏翁颐庵","author":"钟芳","text":"小隐只都城，灵襟晚更清。\n春秋登耄耋，身世际升平。\n杖屦兴亡事，溪山去住情。\n寿堂秋宴合，兰畹入殊馨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"英利驿","author":"钟芳","text":"回毂过英利，乌飞正及晡。\n残年途次蹙，旧学客边芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朴庵","author":"钟芳","text":"结宇在都市，地嚣心自闲。\n矮窗通素月，回溜入平湾。\n晦迹羲黄上，恣情木石间。\n青黄任牺象，曾为一开颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕次林从学韵 其一","author":"钟芳","text":"元夕清堪赏，笙歌远近闻。\n引杯瞻斗柄，倚席见参文。\n岁判五更梦，春添一脉氲。\n豪吟自乘兴，何事策奇勋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夕次林从学韵 其二","author":"钟芳","text":"岁律有隆替，气机分浅深。\n点椒春酿足，焚木夜香沈。\n国正知天步，阳回见帝心。\n短材惭报称，空倚素琴吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"云麓山房次石安国太守韵","author":"钟芳","text":"结馆依山泽，登临时一来。\n万屏轩外列，一鉴席间开。\n篆古龟纹拆，琴清鹤梦回。\n户东韩庙近，雄气矗三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漳州威镇亭","author":"钟芳","text":"独跨开元顶，乾坤混一家。\n连梵钟钹应，列贩市廛斜。\n潮涨桥通楫，云归堞隐笳。\n圆山看咫尺，谁为问琵琶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"味江","author":"钟芳","text":"脉脉观澜处，滔滔意与长。\n荐来源自浚，不息用全刚。\n泽濊堪舆润，渊涵神智藏。\n会归连万派，东去沃扶桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽人父","author":"钟芳","text":"爱僻常违俗，居闲不厌贫。\n诗书擅家学，章服侈君仁。\n门掩壶山翠，胸藏梦泽春。\n游魂杳空漠，灵曜掷双轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又挽母","author":"钟芳","text":"豆荐坤仪正，纶颁帝泽宽。\n投锤终显寇，丸胆旧师韩。\n人去梨花冷，堂空燕子闲。\n韶华不相待，挥涕几时乾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恒山中丞宅夕饮次泾野韵","author":"钟芳","text":"斯文花下集，真味合清尊。\n丽泽深如兑，含章厚拟坤。\n倡酬情意洽，谈笑典刑存。\n瑞世看雏凤，高骞定出伦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又恒山中丞宅夕饮次泾野韵七言绝句二首 其一","author":"钟芳","text":"酡颜临沼映荷花，醉后狂言少僣差。\n更采花筒添醉兴，一般风味入仙家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"又恒山中丞宅夕饮次泾野韵七言绝句二首 其二","author":"钟芳","text":"沉沉深院锁重门，花在清池酒在尊。\n残照半横人已醉，更烧银烛起新论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张鸿胪为同年会即席和吕符卿韵","author":"钟芳","text":"深冬残菊尽，尊酒对孤菲。\n根老香犹在，霜寒节不违。\n伴人添晚兴，倚杖弄馀辉。\n赏爱人人醉，多情更掩扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同年饮泾野宅咏柑分韵得三字三首 其一","author":"钟芳","text":"分韵赋黄柑，同心臭味甘。\n累累金欲堕，郁郁翠相含。\n坐久更交二，情浓爵过三。\n醉翁非为酒，攒膝更清谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同年饮泾野宅咏柑分韵得三字三首 其二","author":"钟芳","text":"萍逢三十载，霜鬓各鬖鬖。\n何意秦淮夜，同看震泽柑。\n瑞香催漏急，蕃实阅冬三。\n不尽盘桓兴，寒蟾在碧岩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同年饮泾野宅咏柑分韵得三字三首 其三","author":"钟芳","text":"溅齿霜梨脆，过于玉版参。\n多君无恨意，更出一株柑。\n宾主高吟七，冰霜益友三。\n对渠还共慰，孤操卓烟岚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛卯十二月二日神乐观祈雪次李少宰蒲汀韵二首 其一 祈雪","author":"钟芳","text":"民力东南竭，宁堪岁荐荒。\n隐忧惭肉食，虔祷合鹓行。\n归路风犹劲，瞻天色更苍。\n土膏方待润，何以答民望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛卯十二月二日神乐观祈雪次李少宰蒲汀韵二首 其二 喜雪","author":"钟芳","text":"经宿玄云合，飞铅遍霎时。\n座间银海晃，天上玉龙知。\n肸蚃忱无间，菑畲稔有期。\n欢声腾万姓，欣慰岂吾私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬辰元夕祀天妃于狮山","author":"钟芳","text":"环佩肃晨仪，琳宫倚翠微。\n应期扶帝运，济险见神几。\n灯火千门夕，星河万国辉。\n他年沧海上，还拟仗馀威。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日二首次九峰韵 其一","author":"钟芳","text":"晓霁凝孤眺，凭高挹翠寒。\n任渠秋色老，且爱菊英团。\n地控舆图尽，峰攒冕黼端。\n时清惭独拙，应负旧儒冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日二首次九峰韵 其二","author":"钟芳","text":"野况撩乡思，虚舟掷岁华。\n性恬堪混俗，秋惨故宜花。\n抚景晋风在，引觞陶兴赊。\n故园今日里，农事足桑麻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"锦衣丘","author":"钟芳","text":"名阀人争羡，殊庸世有承。\n高堂过耄耋，垂白见云仍。\n大义丘山重，千金毛羽轻。\n到家称寿爵，光彩溢兰庭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"内守备晏","author":"钟芳","text":"紫极频更事，于今七十春。\n冰霜松桧狎，编简缙绅亲。\n入陕闲兵略，临淮味道真。\n屡腾归老疏，天语更谆谆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"周武学母夫人寿七十","author":"钟芳","text":"七帙逾初度，筹添岁更新。\n觞擎仙掌露，歌发玉楼春。\n懿范亲蚕绩，祯祥萃凤麟。\n东山如罨画，朝夕送青频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮易士美宅咏瑞香花分韵得春字二首 其一","author":"钟芳","text":"幽翠历冬新，娟娟似有神。\n孤根寒渍雪，微蕊静含春。\n淮曲衣冠会，萍踪棣萼亲。\n淡中清兴足，弦管厌嚣纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":257,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"饮易士美宅咏瑞香花分韵得春字二首 其二","author":"钟芳","text":"小物经霜耐，漫观知帝仁。\n根荄随定分，梅柳自争春。\n未萼先含媚，无言亦动人。\n沉沉梁苑夕，吟赏萃儒绅。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":258,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆川道中","author":"钟芳","text":"一顾一回好，到山山更长。\n春晴鸟语閧，花烂蝶魂香。\n石罅渗泉冽，峰腰攲木苍。\n个中有佳胜，惜也在穷荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":259,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和尚山","author":"钟芳","text":"异教羌番外，何年到我疆。\n冥心皆幻境，趺坐即禅房。\n日月千生劫，形骸四大忘。\n中原无着处，只合摈夷荒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":260,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]