[{"title":"桐庐道中","author":"郭谏臣","text":"扬舲江上喜初晴，两岸山光夹镜明。\n到处水流寒涧出，插天峰吐白云生。\n远洲浴鹭冲潮起，深树新蝉吸露鸣。\n前向严陵台下过，高风千古不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22728,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中上严滩","author":"郭谏臣","text":"山雨势倾盆，江流万马奔。\n阴霾迷日月，浊浪簸乾坤。\n舟楫上还下，烟林吐复吞。\n宦游濒绝险，空尔暗消魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22729,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"兰溪道中","author":"郭谏臣","text":"山雨朝来歇，江流午渐平。\n帆从天际落，人在镜中行。\n孤鸟入云没，群峰接汉清。\n扁舟时晏坐，何处棹歌声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22730,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月夜江行","author":"郭谏臣","text":"夜色侵窗曙，滩声入座喧。\n溯流临皓魄，乘兴倒芳樽。\n山敛微云尽，天从远水吞。\n满怀风月思，难与俗人言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22731,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"衢州道中","author":"郭谏臣","text":"侵晨鼓棹发三衢，南去常山百里馀。\n坐引清风生枕簟，閒消白日在图书。\n山桥旆飏催沽酒，蘋渚舟来唤买鱼。\n漫说宦游多胜赏，倦游今已类相如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22732,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"自常山抵玉山途中作","author":"郭谏臣","text":"乱山青四合，江浙路中分。\n草露沾香径，松风扫白云。\n遥趋南赣檄，深愧北山文。\n士女道旁立，相看旧使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22733,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中晚眺有感","author":"郭谏臣","text":"一路斜阳里，青山引客车。\n幽花生涧曲，修竹绕村居。\n天晚鸟飞倦，途穷马力徐。\n宦游味如此，何日遂焚鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22734,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"早发进贤过罗溪湖上","author":"郭谏臣","text":"山城侵晓发，花露湿星轺。\n日浴湖中水，虹飞堤上桥。\n柳塘风渐起，荻渚雾全消。\n传食真堪愧，何能答圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22735,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宗室以诗见赠次韵奉酬","author":"郭谏臣","text":"清朝水镜愧虚名，握节重为岭北行。\n懒性怕题鹦鹉赋，畏途时听鹧鸪声。\n十年予老淹吴会，八斗君才冠邺城。\n何日还期开蒋径，花前倒屣一相迎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22736,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"峡江舟中晚坐二首 其一","author":"郭谏臣","text":"晚凉时唤酒，雨黑似催诗。\n澄水映肌骨，微风洒鬓丝。\n高吟莲叶舫，频进桂花卮。\n醉向篷窗立，斜敧白接䍦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22737,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"峡江舟中晚坐二首 其二","author":"郭谏臣","text":"午向金川过，宵从玉峡来。\n沙边双艇泊，灯下一樽开。\n剑气凌南斗，薇垣逼上台。\n遐方时恋阙，飞梦到燕台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22738,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上闻笛","author":"郭谏臣","text":"江上浮仙棹，谁将玉笛吹。\n时闻折柳曲，更听落梅词。\n响遏行云散，声随断角悲。\n关山今夜月，应起故园思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22739,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟过白沙驿","author":"郭谏臣","text":"向晚江城霁，扬舲过白沙。\n风尘千里客，烟火万人家。\n帘捲山光入，帆随日影斜。\n重游今十载，空复惜年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22740,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"太和舟中晚眺","author":"郭谏臣","text":"坐深棋局散，落日已衔山。\n鸦散浮云外，蝉鸣深树间。\n客邀新月饮，渔趁暮涛还。\n醉后看襟袖，淋漓绿酒斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22741,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江中夜行","author":"郭谏臣","text":"夜倩渔舟引，前行路不迷。\n沙洲随岸曲，星斗向江低。\n解道身如寄，还?醉似泥。\n更阑频剪烛，水次已闻鸡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22742,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟抵赣城水西驿二首 其一","author":"郭谏臣","text":"仗节临江右，鸣驺过水西。\n貔貅当路拥，旌旆拂云齐。\n列嶂青环郭，平沙白满堤。\n倚阑时纵目，江草暮萋萋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22743,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟抵赣城水西驿二首 其二","author":"郭谏臣","text":"一棹四千里，兹晨抵赣州。\n岭云笼树暝，江水抱城流。\n鸟度烟林晚，蝉鸣幕府秋。\n苍生空属望，此意未能酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22744,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨后与徐兵宪郭参戎同往水西寺宴客","author":"郭谏臣","text":"雨过江城霁，鸣驺到法堂。\n临池开小宴，入座动微凉。\n竹送层轩色，荷生满院香。\n高朋同胜赏，尔汝意俱忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22745,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立秋日饮刘公幕府","author":"郭谏臣","text":"幕府初开宴，凭轩花竹幽。\n凉风时自至，酷暑坐来收。\n脍送银丝细，觞飞玉液流。\n夕阳宾客散，蝉噪已惊秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22746,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赣城官舍遣兴","author":"郭谏臣","text":"东山复起为苍生，一路虚传是福星。\n江郭有时云自白，公庭无事草新青。\n蝉鸣深树凉飙动，鹤唳空阶午梦醒。\n退食小斋还自愧，蒲鞭不用户常扃。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22747,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"斋中向晚即事","author":"郭谏臣","text":"炎方无事早休衙，坐盼庭柯日影斜。\n小阁傍林含宿雨，疏帘隔水映残霞。\n抛书几上看修竹，运甓阶前踏落花。\n自笑年来成吏隐，梦魂飞不到京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22748,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜起","author":"郭谏臣","text":"夜起中庭坐，秋声满树间。\n飞星渡银汉，残月落苍山。\n迢递违双阙，旬宣到百蛮。\n幽怀清不寐，凋谢镜中颜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22749,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜起坐","author":"郭谏臣","text":"忽惊秋思动凉飙，起坐幽斋夜寂寥。\n月色半窗天欲曙，秋声满院暑全消。\n虚名世上真成梦，隐士山中早见招。\n况复官閒公事少，自惭无补圣明朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22750,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送陆山人归吴中","author":"郭谏臣","text":"远送东归客，江帆挂夕晖。\n路从千嶂隔，心逐片云飞。\n社日燕还去，秋风鲈正肥。\n故乡何日返，觅取旧荷衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22751,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"舟中重送陆山人","author":"郭谏臣","text":"日暮滕王阁，归途此地分。\n江空帆度影，海阔雁离群。\n故里同明月，遐方多白云。\n一官匏系此，声迹未曾闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22752,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再寄方司训","author":"郭谏臣","text":"酷有登临兴，频随杖履游。\n杯浮觉海月，舟泛石湖秋。\n苦作笼中鸟，难同水上鸥。\n何时重会面，一写别来愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22753,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日登滕王阁","author":"郭谏臣","text":"高阁崔巍入太清，閒来登眺不胜情。\n开帘山向樽前落，俯槛云疑衣上生。\n夕照霞飞红欲敛，秋江水涨绿初平。\n乾坤纳纳堪容我，愧缚悠悠世上名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22754,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋十一夜剑江舟中","author":"郭谏臣","text":"客路秋将半，连宵月渐佳。\n星文动双剑，江色映孤槎。\n云度箫声远，风生烛影斜。\n迢迢此良夜，飞梦绕天涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22755,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"临江道中夜坐","author":"郭谏臣","text":"兰舫下萧滩，江清浸月寒。\n鹊飞沾露湿，蛩响彻更阑。\n贳酒拈杯坐，篝灯把剑看。\n宦游多涉险，底事效弹冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22756,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"新淦舟中晨起","author":"郭谏臣","text":"篷窗初睡起，旭日照金川。\n缥缈云依树，微茫水接天。\n乡心莼菜外，秋色蓼花边。\n点检登临兴，凄凉异昔年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22757,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十四夜太和舟中玩月","author":"郭谏臣","text":"江月才几望，长空银浪生。\n一轮秋未满，万里夕同明。\n影散黄金粟，光摇白玉京。\n关山当此际，多少别离情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22758,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上晚坐有怀","author":"郭谏臣","text":"薄暮凉风发，帆悬落照飞。\n天长人去远，秋到客思归。\n沙鸟群还集，樯乌隐渐微。\n坐看明月上，杯酒莫相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22759,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"十五夜万安道中玩月","author":"郭谏臣","text":"中秋佳节今宵是，远驾孤槎客里逢。\n霁景烟消秋湛湛，晴空月射水溶溶。\n白榆花浸银河冷，丹桂香浮玉露浓。\n犹记当年湖上饮，清光遥映二高峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22760,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"由万安山行回赣途中杂咏三首 其一","author":"郭谏臣","text":"南向虔中去，缘江细路斜。\n虫丝悬古树，鸟迹印晴沙。\n山背云移石，林根露泫花。\n眼前秋色好，幽兴在烟霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22761,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"由万安山行回赣途中杂咏三首 其二","author":"郭谏臣","text":"飞盖行山径，穿松过野桥。\n雾连江树暝，天接岭云遥。\n过客多随伴，居民半是樵。\n前行无传舍，借榻度今宵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22762,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"由万安山行回赣途中杂咏三首 其三","author":"郭谏臣","text":"雨足山田稔，秋高涧水清。\n路从云外绕，人在瘴中行。\n野草齐腰长，幽花照眼明。\n劳劳苦行役，端只为虚名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22763,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚过乌兜宿郭秀才家","author":"郭谏臣","text":"晚过乌兜里，时逢难弟兄。\n茶烟秋院寂，灯火夜堂清。\n缓带移时坐，开樽待月明。\n来朝人别后，门掩读书声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22764,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"蚤起","author":"郭谏臣","text":"五更鸡唱酒初醒，桂影横阶月满庭。\n门外砧敲秋露冷，堂前烛吐夜烟青。\n林含爽气生灵籁，山接长河见落星。\n宦海茫茫无定所，自怜踪迹类飘萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22765,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜与徐兵宪东轩小坐","author":"郭谏臣","text":"桂香庭院酒微醺，戍鼓迟迟夜欲分。\n对客披襟还促席，呼童煮茗更论文。\n风摇烛影当轩曙，露冷蛩声到处闻。\n此夕相过投辖饮，真成下榻为徐君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22766,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日閒登斋阁","author":"郭谏臣","text":"斋居少尘事，散帙独登楼。\n疏柳江城暮，孤云岭徼秋。\n凉风清客思，夕籁动乡愁。\n徙倚还因懒，朱帘不上钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22767,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"虔城秋暑","author":"郭谏臣","text":"地与炎荒接，秋高暑尚烦。\n纳凉开北牖，看竹敞前轩。\n幽砌蜗潜出，深林鸟自言。\n江乡鲈正美，何日返家园。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22768,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"重阳日约徐宪副同登通天岩","author":"郭谏臣","text":"破晓山行露未晞，旌旗缥缈度烟微。\n醉倾绿醑移时坐，笑对黄花竟日归。\n岭徼秋光供胜赏，洞天霞彩送斜晖。\n相逢幸有南州彦，岂向东篱羡白衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22769,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山中迟鲁源不到口占","author":"郭谏臣","text":"仙岩迟客来清晓，麋鹿成群齧瑶草。\n山堂坐久景萧然，满庭黄叶无人扫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22770,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"游忘归岩","author":"郭谏臣","text":"幽谷生灵籁，虚岩落翠微。\n行吟兴未已，日暮竟忘归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22771,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日郭参戎携酒过袁侍御园亭小坐","author":"郭谏臣","text":"柱史今何在，园亭秋气清。\n小山浮水出，孤月浸空明。\n池映寒花影，庭多落叶声。\n移樽醉山简，对景不胜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22772,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月夜水阁宴客","author":"郭谏臣","text":"良宵张宴集高朋，水绕亭台片月明。\n露下银河秋气爽，风飘金粟夜香清。\n坐中笛奏梅花落，醉后杯浮竹叶倾。\n酒散归途人已静，时闻鼓角动江城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22773,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赣城秋晚","author":"郭谏臣","text":"散衙行市里，正值暮秋时。\n露冷芙蓉老，林疏橘柚垂。\n西风鸣画角，细雨掩青旗。\n书去乡关杳，悠悠千里思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22774,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"斋居夜坐","author":"郭谏臣","text":"小斋人静后，独坐夜迢迢。\n林外砧方急，灯前酒欲消。\n砌蛩悲露切，岭雁阻天遥。\n空抱烟霞癖，无能远市朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22775,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"虔城官舍遣兴","author":"郭谏臣","text":"斋居苦离索，转觉宦情微。\n庭引蜗涎绕，风吹鸟毳飞。\n秋高乡国远，日晏吏人稀。\n向晚东楼倚，閒吟竟落晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22776,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮秋与徐兵宪郭参戎同登望江楼二首 其一","author":"郭谏臣","text":"层楼高驾大江濆，与客衔杯醉夕曛。\n地控荆瓯山四绕，台临章贡水中分。\n旌旗霞映红成绮，金鼓风飘响入云。\n回首更怜秋色晚，满城黄菊送清芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22777,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮秋与徐兵宪郭参戎同登望江楼二首 其二","author":"郭谏臣","text":"江城秋老景扶疏，极目江天思有馀。\n枫染微红霜落后，橘垂新绿雁来初。\n十年湖海牵尘鞅，万里关山畏简书。\n底事登高空怅望，故乡此日正鲈鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22778,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日姚山人自楚适岭南道经虔中过访赠别二首 其一","author":"郭谏臣","text":"夙有烟霞兴，空惭湖海游。\n怜君渡湘水，访我到虔州。\n龙剑元珍重，蠙珠岂暗投。\n大庾明月夜，相约一登楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22779,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日姚山人自楚适岭南道经虔中过访赠别二首 其二","author":"郭谏臣","text":"久向吴中卧，今为岭外行。\n风尘千里客，琴剑一书生。\n瘴海秋将尽，关山月自明。\n莫愁途路险，南越已销兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22780,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夜宿南康公馆","author":"郭谏臣","text":"停骖投传舍，独坐向黄昏。\n落叶风前舞，寒蛩露下喧。\n薄游濒瘴海，飞梦到家园。\n醒后悲身世，羝羊苦触藩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22781,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大庾道中","author":"郭谏臣","text":"驰逐空山路，萧条鬓欲星。\n溪深人病涉，桥断骑还停。\n瘴气连云黑，峰高出汉青。\n自怜尘世上，江海一浮萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22782,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚登南安公馆后楼","author":"郭谏臣","text":"夕阳烟郭万山围，暮倚危阑挹翠微。\n岭海天高人北望，江湖秋老雁南飞。\n疏帘风透还吹帽，虚槛云来欲上衣。\n兴比庾楼真不浅，坐看明月渐辉辉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22783,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"梅岭山阁晚坐","author":"郭谏臣","text":"百越南来此岭分，荒烟落木翳斜曛。\n停骖缓带临丹阁，俯槛拈杯坐白云。\n峻壁栈悬通鸟道，古碑苔长没龟文。\n沉吟不觉天光暝，归路喧传迓使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22784,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雨中自南康回赣州作","author":"郭谏臣","text":"客路通宵雨，篷窗彻晓寒。\n浓烟护林薄，新水浸沙滩。\n隔浦芦花白，经霜枫叶丹。\n买山资已办，何必恋微官。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22785,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"初冬赣城官舍思归","author":"郭谏臣","text":"春来策马向关山，岁晚萧条忆故园。\n自识牺牛终伏俎，从来野鹤怕乘轩。\n弹冠渐入垂纶景，报国空怀曝背暄。\n世事悠悠多变态，片帆归去复何言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22786,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"月夜中庭散步","author":"郭谏臣","text":"病骨终朝卧，乡心万里驰。\n朔风吹渐定，山月出何迟。\n玉宇清辉发，瑶台疏影移。\n小庭丛菊满，冉冉露华滋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22787,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东轩对菊与僚属晚坐","author":"郭谏臣","text":"南菊堪幽赏，邀宾共举杯。\n丛黄经雨绽，绉白傲霜开。\n晚景当轩聚，寒芬入座来。\n相逢宜尽兴，戍鼓莫频催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22788,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晓发赣城江行下省","author":"郭谏臣","text":"荡桨初开云水涯，江头日出照晴沙。\n波摇荻渚飞银练，霜染枫林散绮霞。\n虾菜总归渔父棹，鸭栏多近野人家。\n孤臣去国频经此，随分优游度岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22789,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚泊攸镇宅","author":"郭谏臣","text":"一官羁岭北，千里下湖西。\n叠嶂连天起，浮空去水低。\n滩高舟避石，地僻驿临堤。\n坐向黄昏后，清猿抱木啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22790,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"过皂口驿","author":"郭谏臣","text":"江雾晨开霁，舟行路渺茫。\n青山寒映水，红叶饱经霜。\n豚栅依茅屋，鱼罾挂石梁。\n客途多胜景，欲去不能忘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22791,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江上晓行即事","author":"郭谏臣","text":"江上朝来景，微茫烟水昏。\n木兰千里棹，枫叶万家村。\n树末山光绕，波心日影翻。\n幽怀元自寂，对此复何言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22792,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"冬晚舟行剑江","author":"郭谏臣","text":"朔风千里疾，画舸一帆轻。\n山带寒烟暮，江翻雪浪明。\n沉吟怜独往，驰逐系微名。\n徙倚篷窗久，悠悠无限情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22793,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮抵丰城途中偶述","author":"郭谏臣","text":"江上扬舲趁晚风，隔窗烟雾昼濛濛。\n芦花寒映平沙白，枫叶时兼落照红。\n自分疏狂成傲吏，敢言流俗笑愚公。\n终当脱却樊笼去，一棹长歌笠泽东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22794,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"暮发南浦","author":"郭谏臣","text":"薄暮雪初晴，扬帆江上行。\n帘窥寒月影，枕纳夜涛声。\n地迥鱼书杳，风高雁阵惊。\n乡心兼旅思，耿耿不能平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":22795,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]