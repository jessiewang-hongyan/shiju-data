[{"title":"次韵呈守庵叔父","author":"罗钦顺","text":"平生防意直如城，忧患无千老太平。\n闲对金昆终日款，醉看玉树几枝横。\n养鱼水缩还亲导，采药山深惯独行。\n谁道古人今不及，鹿门风景正分明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14857,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送郑司徒致仕还乡","author":"罗钦顺","text":"老至飘然谢宠荣，诏书优进地官卿。\n从知去国心犹赤，见说还山梦已清。\n驿路暂依红树宿，海邦重订白鸥盟。\n维驹不尽今朝意，仰斗徒悬后夜情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14858,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"和郑司徒留别韵","author":"罗钦顺","text":"别酒初醒月满江，暂凭方舫作吟窗。\n残棋懒用机心著，神鼎那无膂力扛。\n路出五湖人去独，风清三径鹤来双。\n閒中著述能多办，消得群儒北面降。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14859,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送邵宪副提学江西","author":"罗钦顺","text":"雨霁官河柳乍晞，仙舟乘涨去如飞。\n诸生学问存章句，夫子心胸有范围。\n白鹿洞前云漠漠，聘君亭下草菲菲。\n从来古意知多少，此日临登愿不违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14860,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"中秋夜看月有作","author":"罗钦顺","text":"月满高楼犹未知，今朝那合上楼迟。\n不须达曙殷勤望，且试停杯一问之。\n三五何能长洁白，寻常还是几盈亏。\n乐同年少心偏远，遍倚栏干有所思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14861,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"十六夜","author":"罗钦顺","text":"长空万里净无云，月色今宵满十分。\n清赏偶因严戒辍，远书频遣吉声闻。\n山连北斗疑增峻，风入南楼觉尚薰。\n办得此心如此景，人间何事漫纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14862,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉和大人送行韵上呈 其一","author":"罗钦顺","text":"可人秋月满楼光，明发谁教促去装。\n清梦尚随灵寿杖，兼金难觅返魂香。\n前周后鲁知何日，北斗南箕各一方。\n惟有训辞长在目，要看千里作寻常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14863,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉和大人送行韵上呈 其二","author":"罗钦顺","text":"奉来庭训日周旋，宦业无成浪有年。\n爱日自缘心事切，辞官非为里居便。\n陶钧妙手宁须我，蝼蚁微忱莫动天。\n离思更将秋色远，晚江孤雁落霞前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14864,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又用韵奉广大人之意 其一","author":"罗钦顺","text":"惯依黄发款年光，肯为浮名浪趋装。\n竹色不随寒暑变，花枝长伴笑谈香。\n家传宦谱非今日，道济时艰有大方。\n乌鸟私情怜未遂，诸孙歌舞亦能常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14865,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"又用韵奉广大人之意 其二","author":"罗钦顺","text":"两京仍护彩舟还，色养关心幸有年。\n三径旧开风月满，深衣新制起居便。\n讴吟体传唐家律，寤寐心悬杞国天。\n远别极知诸福在，梦魂偏泥寝门前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14866,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"瀛洲雅会次刘野亭先生韵 其一","author":"罗钦顺","text":"垣竹埤梧映碧溪，八龙名氏铄新题。\n乾坤此会今能再，江汉清流自不西。\n前席已归黄阁老，雅歌仍和北山藜。\n黄花待我浑无恙，敢向霜枝着眼低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14867,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"瀛洲雅会次刘野亭先生韵 其二","author":"罗钦顺","text":"鄙夫贪住白云溪，一鹤多惭大手题。\n几忆蓬瀛天远近，又亲谈笑席东西。\n酒行乐处兼浮白，羹味平时半著藜。\n千古斯文知未丧，晚风衰柳望中低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14868,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"瀛洲雅会次刘野亭先生韵 其三","author":"罗钦顺","text":"分曹多暇复同游，意气驩然隘九州。\n佳地称为文字饮，清樽嫌及妇人谋。\n毫端珠玉三千首，眼底衣冠第一流。\n却恐疏慵参未得，君恩交谊两难酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14869,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"瀛洲雅会次刘野亭先生韵 其四","author":"罗钦顺","text":"黄花对酒胜春游，瓮里蒲萄肯换州。\n谐谑有时成故事，行藏无处著人谋。\n病躯每忆三年艾，长楫终轻万里流。\n琼玖木瓜浑不类，向来诗句若为酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14870,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王实庵太宰致仕","author":"罗钦顺","text":"承诏归田鬓未皤，好山徐奉板舆过。\n人生盛福今如此，身外浮名更若何。\n四海均平藏妙用，三朝遭际足恩波。\n梦魂傥忆留都景，飞示新篇莫厌多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14871,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨文贞公祠成大司成冰玉先生有作次韵 其一","author":"罗钦顺","text":"霖雨当时已霈然，更馀膏馥远流传。\n元臣庙食宜千载，太守囊封契九天。\n奔走故应多士合，经营还喜后人贤。\n清时盛典那无纪，墙壁新题又几联。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14872,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"杨文贞公祠成大司成冰玉先生有作次韵 其二","author":"罗钦顺","text":"物情天意久差池，殷礼初闻赋孔时。\n公旦蒸尝侯国领，巫咸勋烈史官知。\n衣冠此日方胥庆，陵谷他年莫浪疑。\n来哲升堂浑不少，合分前席与伊谁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14873,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送王伯安入朝","author":"罗钦顺","text":"卮垆联句佛灯前，云散风流顿十年。\n曾见山东题小录，又闻瀛海遇真仙。\n一封朝奏心徒切，万里生还命有悬。\n今日仕优仍好学，独携书卷去朝天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14874,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"庆鹤次刘野亭先生韵 其一","author":"罗钦顺","text":"出尘标格价难裁，笼入南宫手自开。\n槐露乍零呼伴起，竹风微动御仙来。\n新袍有象宜为主，老凤无毛合避台。\n我欲借骑应不惜，上摩黄道访三台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14875,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"庆鹤次刘野亭先生韵 其二","author":"罗钦顺","text":"故典新仪赏讨裁，郁襟烦思若为开。\n才看种竹百竿活，又喜传书双鹤来。\n声彻钧天偕律晚，食分清俸走舆台。\n浮丘相去流传在，何似吟篇落上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14876,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"庆鹤次刘野亭先生韵 其三","author":"罗钦顺","text":"鸣皋诗好为谁裁，靡爵心同象有开。\n禁省合容山客聚，竹窗疑是故人来。\n春程玩舞时参队，静鼓瑶琴屡傍台。\n多谢扬州贪刺史，清风千古属公台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14877,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"庆鹤次刘野亭先生韵 其四","author":"罗钦顺","text":"缁素应烦玉女裁，晓风声度画堂开。\n身轻几欲凌云去，性警端能择主来。\n曾见苏公游赤壁，复随清献过琴台。\n人间俛仰江山旧，今日光华迩上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14878,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送黄太宰先生致仕","author":"罗钦顺","text":"马船横压大江湄，且对离筵赋别知。\n天上风云还似昨，古来卿相亦如斯。\n青山自是通行路，黄发何妨再起时。\n家近兰亭春正好，未应高兴减羲之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14879,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨长史之任","author":"罗钦顺","text":"璧水溶溶老翠芹，湘潭春色又平分。\n裾长稳向王门曳，调古多从宦邸闻。\n晓殿光华依大雅，晚窗消息付微醺。\n有时梦绕同寅地，莫遣缄书隔暮云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14880,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送韩大卿赴刑侍任","author":"罗钦顺","text":"宦辙周流四十年，甘棠阴在有诗传。\n匡时虑远人难识，执法官高地屡迁。\n朝下午门同辈少，赏寻韦曲晚芳妍。\n群生共此恢恢网，一道宏纲上属天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14881,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送俞少司空赴召","author":"罗钦顺","text":"莺求高树有新声，吹起残花弄晓晴。\n春水欲平桃叶渡，冬卿初别石头城。\n魏牟江上心能远，显父壶中酒正清。\n台沼百年馀武烈，秖应前席问苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14882,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送林博士赴九江贰守任","author":"罗钦顺","text":"手裁桃李尽成阴，此去应劳抚字心。\n清酒几行赊后会，朱弦三叹有遗音。\n炉峰日射香烟紫，湓浦潮添雪水深。\n解愠风行吾亦快，不妨题句满东林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14883,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"陈复清挽章","author":"罗钦顺","text":"吴水东头旧隐村，几株杨柳映柴门。\n闲中秀句多能办，身后清风凛尚存。\n药圃燕交春径迹，钓沙龙变晚潮痕。\n亦知埋骨青山久，深入泉台有湛恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14884,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵睡起答何中蒙赵元默二举人 其一","author":"罗钦顺","text":"雨中江柳乱毵毵，午枕知君未肯贪。\n万里珠还南海椟，一般青出白沙蓝。\n心游物表风斯下，坐到更深月正南。\n巾帻依然尘不染，苍头犹进晓盆泔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14885,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵睡起答何中蒙赵元默二举人 其二","author":"罗钦顺","text":"眼前真合口三缄，山有黄精忆旧镵。\n美酒如渑输客醉，翠屏当牖要人监。\n吟多未觉风光尽，梦少何妨燕语喃。\n行止分明天意在，北风长夏送归帆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14886,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"雨中过鄱阳湖望庐山不见","author":"罗钦顺","text":"那堪雨脚连山脚，寄与山灵莫浪猜。\n宇宙要开观物眼，风波方见济川才。\n卧龙庭院谁专领，跨鹤仙人傥一来。\n袖有瓣香真自惜，炉峰何日扫莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14887,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"北堂永秀为赵元默赋","author":"罗钦顺","text":"北堂坐对宜男草，游子行看永秀图。\n风渚残灯飞梦近，晓丛清露著花无。\n香浮寿酒筵初秩，影乱斑衣日未晡。\n共识王孙家法远，眼前馀庆是贞符。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14888,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"候风南浦连日苦热","author":"罗钦顺","text":"南浦逶迤绿树多，万艘环系水无波。\n喧声不觉催人老，美景其如执热何。\n河朔芳樽空往事，郢中白雪漫高歌。\n十年尘垢纷盈爪，聊就深清试刮磨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14889,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"写怀寄监中寮友","author":"罗钦顺","text":"鸡鸣山下桥门路，二十年中忆屡游。\n伴食再书新纸尾，趋庭先到旧营头。\n清时有幸归田早，白日无私照物周。\n千里故人高谊在，几回风雨梦孤舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14890,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"环山楼为陈太仆题","author":"罗钦顺","text":"元龙床上有高楼，新占淮南第一州。\n青翠入窗来不断，图书终日坐忘收。\n花香客醉酿泉酒，雨霁人争野渡舟。\n吟送夕阳芳草远，满川云锦散骅骝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14891,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"庆族叔用丹甫寿七十","author":"罗钦顺","text":"东风吹却暮云轻，南极星光彻夜明。\n细数春秋经七十，直从髫龀阅升平。\n山扶栋宇层层在，手种松篁个个成。\n寿酒一年还一度，德音长合重乡评。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14892,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"用西阜叔父韵谢守庵叔父招饮","author":"罗钦顺","text":"小楼偏得近高居，酒熟常蒙隔壁呼。\n最喜家庭多寿岂，不妨穷达有乘除。\n古人可作归元亮，实事堪陈陋子虚。\n饮到酣时情已洽，天寒何必更投壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14893,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"用韵谢诸父见过赏雪","author":"罗钦顺","text":"雪中清赏就蜗居，坐久还闻冻鸟呼。\n草率时羞惭饾饤，拜兴常礼荷开除。\n老亲饮量浑无敌，诸父诗名总不虚。\n闻说梅梢春意早，拟于花下更携壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14894,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵寄二弟并自述 其一","author":"罗钦顺","text":"同朝同气复同居，看取荆花满意舒。\n斗附北辰喉舌正，春生严棘网罗除。\n笑谈自可兼三益，变动还应玩六虚。\n饮酒饫时遥念我，磁罂无谢玉为壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14895,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵寄二弟并自述 其二","author":"罗钦顺","text":"奉亲堂上是安居，春酒杯长日自舒。\n已向园林成独乐，不知廊庙富新除。\n读残帝典孤灯在，参透禅机万象虚。\n药笼秖今多国老，閒身聊寄老翁壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14896,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵寄二弟并自述 其三","author":"罗钦顺","text":"天涯书到动经年，字满长笺又短笺。\n小日弟兄原竞爽，一时名位总光前。\n从知有道兴明哲，自信无媒合蹇连。\n身世未应容易了，古书何啻一囊钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14897,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"闻逆宦伏诛次澄江公韵","author":"罗钦顺","text":"元恶端宜具五刑，株连仍睹罢三卿。\n君臣有道终须正，天日无私本自明。\n堪笑李斯空叹犬，若为冯道尚封瀛。\n中兴合在周宣上，一揽威权万国平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14898,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵奉呈大人","author":"罗钦顺","text":"一门重叠被恩光，仰愧慈乌又趋装。\n清酒已廑先叙别，紫袍犹得自薰香。\n心期及物才非称，教熟趋庭行合方。\n闻说便途归仲子，私恩公义总天常。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14899,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答守庵叔父复官之贺","author":"罗钦顺","text":"社鼠宁容久穴居，时来群愤一朝舒。\n祖功宗德分明在，苛禁繁文次第除。\n万里渚鸿飞向北，几人蕉鹿梦成虚。\n不才也复青毡旧，贺酒亲烦载满壶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14900,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答曾雪坡","author":"罗钦顺","text":"此行疑是又疑非，赖有高人独我知。\n义重敢先东郭吊，情深难忘北山诗。\n即看俎豆桥门日，宁异箪瓢陋巷时。\n好景别来偏入梦，雪坡春水到愚池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14901,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄李敬夫用其送行韵 其一","author":"罗钦顺","text":"谪仙孙子瑩冰清，七步踉蹡五字成。\n心远独怜山水好，眼高浑看利名轻。\n存身我已惭龙蛰，縻爵谁应和鹤鸣。\n别酒半醒回首处，江风吹浪暮云平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14902,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"寄李敬夫用其送行韵 其二","author":"罗钦顺","text":"几载岩居梦亦清，手栽松竹喜初成。\n君王自合天明畏，我辈宁关世重轻。\n残卷未容资蠹食，好山重许对鸡鸣。\n却愁心学人稀讲，满耳高谈了治平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14903,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游白鹿洞 其一","author":"罗钦顺","text":"偶寻白鹿洞中春，初识庐山面目真。\n双瀑下垂深岁月，五峰高耸切星辰。\n笃生豪杰宁无继，雄镇江湖合有神。\n安得结茆当绝顶，此生长作看山人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14904,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游白鹿洞 其二","author":"罗钦顺","text":"肩舆晨发路逶迤，树老山深日上迟。\n古洞有名传白鹿，斯文无恙仰先师。\n瓣香喜遂平生愿，遗刻贪寻绝妙辞。\n指点重劳贤别驾，不妨深酌更题诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14905,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"游白鹿洞 其三","author":"罗钦顺","text":"断冈深谷少人行，逢著山花不识名。\n水满稻田群鹭下，林藏茆舍一鸡鸣。\n儒冠夹道仪俱肃，石刻临溪字半明。\n追省旧游多漫浪，斯文今日最关情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14906,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送杨晋叔京兆之任","author":"罗钦顺","text":"玉立班行忆共朝，金陵重睹旧风标。\n九天召命来何速，千古心期话未消。\n酌别盏香初压酒，过江帆趁欲归潮。\n都人合识韩京兆，佛骨端能手自烧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14907,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"辛未五月九日仲弟允迪自丹阳寄来江行五咏时久候不至遂用其末章韵作一诗答之","author":"罗钦顺","text":"绕门迎候几朝昏，飞盖飘然向大藩。\n百里江津能自画，五年心事共谁论。\n虽传谢眺新篇到，应负姜肱旧被存。\n东海莫教明月上，金樽分照欲伤魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14908,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆仲弟以六月六日上事 其一","author":"罗钦顺","text":"曾从东海溯天河，又占吴山第一坡。\n官比旧寮真特达，剑蟠深匣未销磨。\n薰风别院啼黄鸟，细雨閒阶长绿莎。\n飞盖东西休草草，要听含哺老人歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14909,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆仲弟以六月六日上事 其二","author":"罗钦顺","text":"桃花千树塞玄都，超佐薇垣帝渥殊。\n上事不妨沾暑雨，开门先合剪春芜。\n农桑遍野家应给，寮寀同心德不孤。\n须忆少年兄与弟，青灯相对讲三谟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14910,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"奉呈大人封君","author":"罗钦顺","text":"帘幕风薰酒味柔，野云垂荫晚油油。\n静观物理都成趣，閒听樵歌或点头。\n衣笥远封开孔雀，钓台新水下轻鸥。\n不才又作经时别，多负当年返哺谋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14911,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"忆季弟","author":"罗钦顺","text":"日照银台晃掖垣，五年五度沐殊恩。\n对扬闿切心无愧，裁决从容令不烦。\n草色入帘诗兴远，花香迎客酒杯存。\n谁知一片瞻云思，欲共云鹏万里鶱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14912,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"次韵答司训光郁先生时致仕归","author":"罗钦顺","text":"愁将病眼看催科，不道刚逢使者过。\n生理秖凭诗卷足，梦魂原傍陇云多。\n冰霜晚节松当径，牛女佳期鹊近河。\n不与故人留一宿，良宵争奈月明何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14913,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送少司寇戈公赴京","author":"罗钦顺","text":"早从周道骋华骖，阅历年深事事谙。\n诸老共推心德一，两都更践法司三。\n时须寿考天饶健，人惜暌违酒要酣。\n王国灵长端有赖，登仙羞听鄙夫谈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14914,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送通政冯子佩同年赴京 其一","author":"罗钦顺","text":"先朝同醉杏园春，此会南都仅七人。\n顾我官资偏耐冷，喜君恩命又更新。\n庙堂自是忧民地，青紫谁非报主身。\n高阁离筵殊草草，有怀无惜附书频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14915,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送通政冯子佩同年赴京 其二","author":"罗钦顺","text":"小弟银台久备员，长官今喜得高贤。\n日明梧竹开唐省，风度埙篪恊舜弦。\n对酒共输情似海，清黄须让笔如椽。\n因君重起连枝念，为把平安两字传。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14916,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"送都宪丁应韶入长银台","author":"罗钦顺","text":"著处圆融德称才，还因求旧领银台。\n看花莫问玄都树，把酒聊空白下杯。\n心计向来勤独运，庙谟从此属参陪。\n有时双柏轩中坐，为道顽兄一味呆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14917,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}},{"title":"壬申元夕大人用梅圣俞韵赋四章依韵奉呈并寄二弟 其一","author":"罗钦顺","text":"坎止流行到处欢，童颜无藉酒卮还。\n元宵月朗心千古，纸帐风清屋半间。\n晚爱吟诗浑入杜，早知寻乐独希颜。\n分来一派源头水，洗透诸儿梦觉关。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_4.csv","pointer":14918,"sha256":"d4c6bdc86d2bd9fcbfe4f5f3e747aedf1814e37aaa1f3848834d8e9316029b79","dynasty":"明"}}]