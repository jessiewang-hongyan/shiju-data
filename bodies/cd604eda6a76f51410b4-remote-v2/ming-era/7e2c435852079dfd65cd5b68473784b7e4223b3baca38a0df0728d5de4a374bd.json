[{"title":"忆南园八子 其八 僧智海无心无相，善论逍遥，有杯渡之风，禅藻独多","author":"欧主遇","text":"霜落菩提树，月孤诃子林。\n老僧云既灭，栖云浮以沉。\n戒律断荤酒，随缘不染心。\n禅悦超文字，解悟或长吟。\n一往问祖意，曹溪岁月深。\n依依本师侧，寂寂匡庐岑。\n玄言镌诗卷，诵法叶鸣琴。\n远公莲社约，倡和仙城南。\n踰耋形如鹤，卿相存所钦。\n一旦粤会陷，四大从相侵。\n阎浮劫灰尽，王园不可寻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"粤大饥","author":"欧主遇","text":"濯濯山上木，重重甑上尘。\n不虞垂暮节，见此大灾辰。\n岭海久縻烂，今疚更酸辛。\n肥遗谬云龙，饥兆天下沦。\n天刺神不富，曷丧号如焚。\n周周与蛩蛩，异俗各相因。\n胡乃同血气，秦越视所亲。\n救荒罕长策，望雨先作云。\n乞物思裴令，捐益欲周贫。\n庶几有秋获，比闾庆食新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送区启图入都","author":"欧主遇","text":"君不见宣王北伐振周室，自将王旅命师律。\n卿士虎臣佐中兴，文兼武事惟尹吉。\n又不见邺侯谒帝灵武时，衣袍紫白动相随。\n收复两京有长策，天下无寇早为期。\n我皇圣武雒阳起，缵绪金陵咏丰芑。\n愿得熊罴不二心，言驾六飞西北指。\n君家簪笏旧盈门，君为二邑利盘根。\n欲成国史传先业，欲请长缨灭祲氛。\n据鞍矍铄谁为右，报国世恩恩复厚。\n击楫中流先着鞭，誓吉同仇吾敢后。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"永历二年九月十五日","author":"欧主遇","text":"东西巡驻跸，南北直收京。\n盛气灵洲见，秋花锦石明。\n因风荷艾客，望月凤凰城。\n谁问升沉理，平分天际情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"得黄女倩阳春书却寄","author":"欧主遇","text":"戎马满天地，离居日月忧。\n清谭思卫乐，曲径少羊裘。\n雁字怀难寄，鸰原恨故留。\n江村重就宿，典籍任冥搜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34805,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚寅春即事","author":"欧主遇","text":"帝座传迁次，髦头见动兵。\n庙廊稀胜算，簪笏几同行。\n沼浅鱼何乐，天低雁莫征。\n不劳金窖力，贫贱一身轻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34806,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"不寐 其一","author":"欧主遇","text":"平生忧用老，此夕老逢忧。\n烽烟迷帝座，戈甲指髦头。\n吴魏争延汉，东西统附周。\n不须推甲子，吾志在春秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34807,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"不寐 其二","author":"欧主遇","text":"反侧冬之夜，东方不肯明。\n凄风轻败絮，淫雨重悬旌。\n用拙干戈世，怀忠草莽情。\n美人思独切，西去好音生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34808,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"不寐 其三","author":"欧主遇","text":"悲歌忧社稷，永夜思悠哉。\n虎豹关谁守，龙螭兆不来。\n几人沉屈水，何处凿颜坏。\n暂借卧游得，翻忘邻笛哀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34809,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"不寐 其四","author":"欧主遇","text":"陆沉人事急，旦暮望王师。\n数起头难栉，孤眠枕屡欹。\n龙鳞扳不得，鹤胫断何之。\n万里曾游此，茫茫入梦时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34810,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广再陷 其一","author":"欧主遇","text":"藉寇兵谁罪，佗城复丧军。\n绝怜儿女子，纵杀虎狼群。\n阴阳翻莫辨，水火益为殷。\n后出满囹圄，歌谣曾见闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34811,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广再陷 其二","author":"欧主遇","text":"久发临河叹，今闻隔谷歌。\n苍黎屠日甚，臣仆命如何。\n虚授将军钺，徒横义士戈。\n甲兵端欲洗，无力挽天河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34812,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"广再陷 其三","author":"欧主遇","text":"巢覆几遗卵，泥空并坏梁。\n可怜歌舞地，翻尽战争场。\n作镇非羊杜，殉城愧许张。\n不知何处所，奔走自狼忙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34813,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漫兴","author":"欧主遇","text":"淡泊来强健，颛愚息是非。\n久安容膝地，多补蔽身衣。\n衰老人何用，忘年友亦稀。\n及春浑漫兴，莺燕掠花飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34814,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和陈元孝月夜过访","author":"欧主遇","text":"老圃问孤影，美人为独知。\n带来山翠远，题就月高时。\n书阅蠹鱼尽，帆过鸿雁迟。\n五君有佳咏，终古诵延之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34815,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"望气楼怀郭宏农","author":"欧主遇","text":"斯人不可即，此地若为情。\n谶尽兴亡理，经留著作名。\n春光摇树绿，水色入楼清。\n为向今朝望，南天气倍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34816,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜梦过陈集生太史山庄求书痛饮读骚四大字起而纪之呈太史属和","author":"欧主遇","text":"草木皆秋色，离骚动美人。\n梦魂何处得，翰墨故疑神。\n谁与歌燕市，空知泣楚臣。\n餔糟非众醉，吾亦任吾真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34817,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"公宴呈何相公陈宗伯","author":"欧主遇","text":"风流江左似，并有谢安名。\n尊俎馀高论，笙簧度远声。\n笑花颜更醉，舞燕袖偏轻。\n乐奉赓歌会，无孤吐握情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34818,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经邹谒孟庙","author":"欧主遇","text":"罗罗松桧色，夫子踞长春。\n封地仍邾旧，流风与鲁邻。\n道闲忧复作，机断报如新。\n四十来游者，依然愿学身。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34819,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"经董子下帷处","author":"欧主遇","text":"昔人高可仰，其奈广川何。\n身在窥园少，忠留对策多。\n野花馀锦绣，林鸟半啼歌。\n圣世贤良诏，儒生复此过。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34820,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"漂母祠","author":"欧主遇","text":"层城依片石，古木咽寒禽。\n自有留名地，何存望报心。\n筑坛多倚仗，垂钓辨浮沉。\n我亦王孙饭，游情楚水深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34821,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"故人有巨富家落祝发为僧者","author":"欧主遇","text":"空却有家累，生将无住心。\n挥金随地没，卓锡得泉深。\n因报多相信，人天杳亦寻。\n白云堪补衲，栖老白云岑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34822,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"午门朝见","author":"文徵明","text":"祥光浮动紫烟收，禁漏初传午夜筹。\n乍见扶桑明晓仗，却瞻阊阖觐宸旒。\n一痕斜月双龙阙，百叠春云五凤楼。\n潦倒江湖今白发，可能供奉殿东头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34823,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"观驾幸文华听讲","author":"文徵明","text":"朝下銮舆幸讲堂，徐看天仗转东厢。\n翠旂拂柳宫墙绕，清跸穿云阁道长。\n千载明良真际会，九朝文物旧彝章。\n小臣漫厕夔龙后，彷佛还瞻日月光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34824,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉天殿早朝二首 其一","author":"文徵明","text":"天外鸣鞭肃禁宸，朝廷献纳有司存。\n罘罳拂曙楼台迥，象魏连云观阙尊。\n夹陛书思端万笏，上方求谏辟千门。\n宫墙树色深于染，总受天家雨露恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34825,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"奉天殿早朝二首 其二","author":"文徵明","text":"月转苍龙阙角西，建章云敛玉绳低。\n碧箫双引鸾声细，綵扇平分雉尾齐。\n老幸缀行班石陛，谬惭通籍预金闺。\n日高归院词头下，满袖天香拆紫泥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34826,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西苑","author":"欧主遇","text":"宛转瀛洲希幔坡，?蜷玉蝀历银河。\n广寒遥见空中殿，太液新添雨后波。\n云捲红妆千步障，风吹璚盖万年柯。\n泰平见说宸游庆，驰道青青长薜萝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34827,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雪后早朝","author":"文徵明","text":"月满长安雪未消，分明银海泻秋涛。\n光迷万里璚珂乱，势压双龙玉阙高。\n曙色渐分鳷鹊观，凝寒犹在鹔鹴袍。\n负薪亦有号饥者，愿得君王发汉廒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34828,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元旦朝贺","author":"欧主遇","text":"仙音缥缈叶和鸾，天上春回白王闲。\n日出鸡人初唱卯，雪消风伯为驱寒。\n万方玉帛看王会，一岁朝仪重履端。\n满目山河无限事，自惭无补直金銮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34829,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"恭候大驾还自南郊","author":"文徵明","text":"圣主回銮肃百灵，紫云团盖翼苍精。\n属车剑履星辰丽，先驾旂常日月明。\n十里春风传警跸，万方和气恊韶韺。\n白头欣睹朝元盛，愿续思文颂太平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34830,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庆成宴","author":"文徵明","text":"花映珍盘出上供，风吹韶頀落遥空。\n坐联日驭红云暖，恩湛宫壶瑞露融。\n一代礼成郊社后，百年身际太平中。\n晚酣不记归来处，彷佛春光玉殿东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34831,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"端午赐扇","author":"文徵明","text":"剡藤湘竹巧裁将，珍重瑶华出尚方。\n四海清凉初拜赐，一时怀袖总生光。\n最怜明月难捐弃，即有仁风可奉扬。\n真觉自天题处湿，墨痕狼藉露华香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34832,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赐长寿綵缕","author":"文徵明","text":"紫宸朝下锡灵丝，金水桥边拜命时。\n文绣自天腾五色，光华约臂结双螭。\n重惭潦倒随恩泽，还忝班行睹盛仪。\n愿得君王千万寿，日华常照衮衣垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34833,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"内直有感","author":"欧主遇","text":"天上楼台白玉堂，白头犹作秘书郎。\n退朝每傍花枝入，襮直遥闻刻漏长。\n铃索萧閒青琐静，词头烂熳紫坭香。\n野人不识瀛洲乐，清梦依然恋故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34834,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"受登极恩诏充贡北上","author":"欧主遇","text":"凤书遥出诏开元，龙德朝飞奉至尊。\n坐辟浮云悬日月，兴歌湛露洽乾坤。\n千金燕市多收士，三刖陵阳亦受恩。\n闻道辟雍临幸早，圜观讲幄动桥门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34835,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸未书事 其一","author":"欧主遇","text":"好诵庄周六月篇，及时千里尚迎贤。\n既归周勃安知狱，自汗萧何贱买田。\n辽蓟干戈驱北塞，荆襄寇盗动南天。\n请缨多士王师合，定拟珠厓不弃捐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34836,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸未书事 其二","author":"欧主遇","text":"年来大阅振王猷，何复封疆万里忧。\n丰水来同悬诏去，曲江春宴乍移秋。\n无端寇盗时来警，多难身名老更愁。\n闻道临轩隆将相，不知李郭孰前筹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34837,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄韩孟郁永平别驾","author":"欧主遇","text":"长天鸿雁几行鸣，知是雄飞向北平。\n翰墨泉流称独步，干戈尘静有边城。\n多酬国士登坛礼，兼得将军射石名。\n买醉别离燕市久，上林还梦听春莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34838,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黎美周会试","author":"欧主遇","text":"竹房芝阁数相从，先出长林四百峰。\n夹道看花金腰袅，群仙分露玉芙蓉。\n尊开夜月飘霜满，帆带春山点翠重。\n裁就万言书早上，不虚词赋擅雕龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34839,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"何相君闻予假馆澹园感咏见贻赋此奉答","author":"欧主遇","text":"樾可栖迟竹可编，乾坤扰扰借孤眠。\n旧来煨芋知良相，长记偷桃笑列仙。\n乱日戈矛愁酷烈，好音肝胆幸流传。\n亲人鱼鸟都相避，剩有池塘水复鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34840,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"再答何象冈相公","author":"欧主遇","text":"诗筒不断甲兵馀，日月长天照敝庐。\n齐物细推惟一马，加餐多籍有双鱼。\n径荒松下归徵士，文赉山中相隐居。\n遥望江云长弭棹，将疑门巷不容车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34841,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与王中丞谈古名臣","author":"欧主遇","text":"霜威行处振旌旗，晴望高山对坐时。\n秦殿璧完人独慕，谷城书授帝为师。\n十年作相无言稳，双陆褫裘得胜奇。\n论古情深延夜月，尊前赓咏出车诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34842,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈秋涛太史还朝","author":"欧主遇","text":"载笔中朝第一流，宫衣摇曳返瀛洲。\n气连牛斗双龙剑，手辟云霄五凤楼。\n锁闼玉堂官并美，西京东观秘全抽。\n朝昏茎露千珠重，来往仙槎八月浮。\n使命光分沧海日，宦情閒对白云秋。\n偶归径许求羊入，此去书成班马俦。\n听履早趍鸳鹭序，离筵为典鹔鹴裘。\n知君黄阁赓歌地，作相还家尚黑头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34843,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠黄逢永","author":"欧主遇","text":"每经益寿佩萸枝，上客看花对咏诗。\n公望公才推国士，不臣不友是吾师。\n弓旌小试雕虫技，皮骨劳生海鹤姿。\n七有不堪从懒性，六陈太息恨明时。\n家风早锡难兄誉，文苑多题幼妇词。\n传乘浙闽赢选胜，去官荆楚鲜馀资。\n壁藏书在重垂业，围困琴鸣且乐饥。\n好是孤居同养拙，百年盟定齿参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34844,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"林仪卿过访村居","author":"欧主遇","text":"淼茫潮海断双鱼，沉陆相逢又有初。\n明月林间孤客梦，彩云天外故人车。\n贡王同志冠犹待，侨札交酬带自舒。\n墙短低枝牵薜荔，池平新水挹芙蕖。\n尊倾夜半分邻酿，园列春深剪野蔬。\n不忘吾师诗礼学，枕中留得读残书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34845,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠张孟奇太守","author":"欧主遇","text":"东望高峰云色苍，罗浮仙侣进璚浆。\n天悬南极流新彩，人自西围纳晚凉。\n笔削瑞麟推独步，陆沉金马旧为郎。\n秋槎早见使臣节，邸吏惊传太守章。\n束带倦看车马迹，拂衣初遂芰荷裳。\n邺侯架积秘书府，范蠡船归越女妆。\n三径行吟年不倦，千金结客气犹狂。\n人情翻覆聊长啸，身隐文章半未藏。\n嵇阮林中双眼白，纪群膝下列星光。\n庭业宝树枝枝起，鼎就金丹岁岁长。\n欲赠白云蒲艾色，遥分绮席荔枝香。\n今朝笠履频增胜，自道园公醉几觞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34846,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游宝象林题花冢 其一","author":"欧主遇","text":"当筵一曲写新词，忆得便娟恨更痴。\n图画有香兰蕙好，衣裳犹纫美人贻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34847,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游宝象林题花冢 其二","author":"欧主遇","text":"销魂多为种花田，夜两长流咽管弦。\n寸土寸心君自见，采花人结后生缘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34848,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游宝象林题花冢 其三","author":"欧主遇","text":"不知洛浦与湘滨，一片湖山是锦茵。\n为尔植梅千万树，月明来作梦中人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34849,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游宝象林题花冢 其四","author":"欧主遇","text":"歌拍诗筒耐可闻，狭邪道上醉红裙。\n行云浪说当年梦，好赠空山一片云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34850,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游宝象林题花冢 其五","author":"欧主遇","text":"青蛾红粉并黄埃，独倚周郎立夜台。\n楼阁珠帘行乐地，来游多酹掌中杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34851,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游宝象林题花冢 其六","author":"欧主遇","text":"来为神女去为仙，问月穿花路渺然。\n山寺日闻钟梵响，他生闺阁亦人天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34852,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙诗 其一","author":"欧主遇","text":"梧桐窠凤凰，叶向秋风飞。\n奇龄虽过百，乐事当乘时。\n周驭不停轨，汉盘玉露滋。\n爰有容成公，发黑齿复儿。\n亦有报韩者，先后帝王师。\n圯上契幽叟，终与赤松子。\n功成能永誉，仙类良足晞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34853,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游仙诗 其二","author":"欧主遇","text":"苏耽二百年，一归号城郭。\n倾曦与颓魄，焉□□□□。\n三山故迢递，九霄何寥廓。\n委怀辟谷仙，丹砂不求获。\n推分与天游，餐和长年药。\n忽闻吹玉笙，驾来缑山鹤。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34854,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠曾祖叔经季","author":"欧主遇","text":"少年宝马驱长安，燕客酣歌惊二难。\n季子上书出锦绣，伯氏为郎见羽翰。\n官阁赋梅多和句，山川吟眺生烟雾。\n丹青染就复逃名，紫芝眉宇人争慕。\n挥手风尘几十春，花洲洲上晚垂纶。\n樵西山响来笙鹤，蘧园松影老龙鳞。\n华堂朝开云液酒，引觞起舞为君寿。\n丹诀九还授葛仙，钓隐三朝称渭叟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34855,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"自耕轩歌","author":"欧主遇","text":"朝舌耕兮暮笔耕，莫知我艰兮聊资生。\n人喜读书近浮名，我悔读书不能行。\n黄钟弃兮瓦釜鸣，季女思饥兮幽人贞。\n北风寒兮孤月明，我将荒遁兮就学苏门长啸声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34856,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖泛舟雨中分赋 其一","author":"欧主遇","text":"山容凉雨洗，湖色远天空。\n漾演送孤棹，飘飖乘好风。\n浴来鸥鸟伴，穿尽蓼花丛。\n指点伊人处，江桥几度通。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34857,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西湖泛舟雨中分赋 其二","author":"欧主遇","text":"湖船望不极，雁塔翠微中。\n三十曾游地，浮沉一醉翁。\n火云飞雨淡，晴岫夕阳红。\n几变姓名客，将无范蠡同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34858,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游湖回文和车文汇","author":"欧主遇","text":"游路堤桥六，美人同采芳。\n舟虚客度影，水漾月生光。\n鸥鹭群为熟，芰荷衣最凉。\n愁消将进酒，秋晚属怀乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34859,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三月三日社集东皋 其一","author":"欧主遇","text":"我皇九载，永和期合。\n蔼蔼时彦，晋人可作。\n东园之树，秾华未落。\n于以晤言，曲水为乐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34860,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三月三日社集东皋 其二","author":"欧主遇","text":"有鸟和鸣，茂林集止。\n春酒既载，春服以试。\n薄言采兰，于水之涘。\n歌以写心，祓禊匪戏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34861,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"三妇艳","author":"欧主遇","text":"大妇主中厨，中妇佐烹鱼。\n小妇停针绣，新火适疾徐。\n高堂问寒暖，提筐墙下俱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34862,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"上巳","author":"欧主遇","text":"芳菲淑景晚，欣赏乘时多。\n况临祓禊酒，并矢阳春歌。\n荷钱聚涧藻，雾縠开文波。\n风烟丽林际，云树长山阿。\n跂言伊雒盛，乐从溱洧过。\n佳人苟再得，分香曳绮罗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":34863,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]