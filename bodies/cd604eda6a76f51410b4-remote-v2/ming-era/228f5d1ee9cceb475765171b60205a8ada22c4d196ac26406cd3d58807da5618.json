[{"title":"悼亡二十五首 其三","author":"江源","text":"物在人亡无见期，冷猿秋雁不胜悲。\n天长地久有时尽，此恨绵绵未易衰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52689,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其四","author":"江源","text":"鸾镜佳人旧会稀，况逢寒食欲沾衣。\n桃花落尽深红色，惆怅朱颜不复归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52690,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其五","author":"江源","text":"一世生离恨有馀，白云愁色满苍梧。\n欲知此恨消难得，见尽扶桑水到枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52691,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其六","author":"江源","text":"不独人间夫与妻，几多红粉委黄泥。\n不知精爽落何处，目极伤神谁为携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52692,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其七","author":"江源","text":"苍茫罗袖满尘埃，肯信愁肠日九回。\n不见玉颜空死处，碧山明月照苍苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52693,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其八","author":"江源","text":"一寸相思一寸灰，红颜无奈落花催。\n九原莫叹三光隔，可是英灵许再来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52694,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其九","author":"江源","text":"剑逐惊波玉委尘，重泉一念一伤神。\n西楼望断芳菲节，不见当时劝酒人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52695,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其十","author":"江源","text":"死生难有再回身，更结来生未了因。\n尽日伤心人不见，海棠风外独沾巾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52696,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其十一","author":"江源","text":"清明时节雨纷纷，泪洒东风忆细君。\n艳骨已成兰麝土，梦来何处更为云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52697,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其十二","author":"江源","text":"欲将修短问乾坤，独对残灯拭泪痕。\n人面不知何处去，独留青冢尚黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52698,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其十三","author":"江源","text":"不知心事与谁论，环佩空归月夜魂。\n歌罢綵云无觅处，娟娟霜月冷侵门。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52699,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其十四","author":"江源","text":"夫容肌骨绿云鬟，雨散云飞一饷间。\n两处茫茫皆不见，柳花帘幕玉钩闲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52700,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其十五","author":"江源","text":"红颜骑竹我无缘，只住人间二十年。\n回首音尘两沉绝，每逢寒食一凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52701,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其十六","author":"江源","text":"却恨青娥误少年，忍将离恨寄哀弦。\n云飞雨散知何处，空向秋波哭逝川。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52702,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其十七","author":"江源","text":"一丘落月几啼鸦，生死恩深不到家。\n独坐郡斋寥落意，竹房不见夜呼茶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52703,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其十八","author":"江源","text":"天上人间两渺茫，离人别此倍堪伤。\n舞鸾镜匣收残黛，见此踌躇空断肠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52704,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其十九","author":"江源","text":"我怜贞白重寒芳，不把双眉斗画长。\n云雨合归何处去，海天愁思正茫茫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52705,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其二十","author":"江源","text":"旧事凄凉不可听，相思一座鬓星星。\n窗残夜月人何处，银烛秋光冷画屏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52706,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其二十一","author":"江源","text":"星河无梦夜悠悠，千里佳期一夕休。\n今日不堪回首望，芙蓉花外夕阳楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52707,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其二十二","author":"江源","text":"孟光举案与眉齐，半臂初交又解携。\n回首旧游真是梦，一声风角夕阳低。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52708,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其二十三","author":"江源","text":"无处登临不系情，百忧如草雨中生。\n鸳衾久别难成梦，斜倚薰笼坐到明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52709,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其二十四","author":"江源","text":"悠悠生死别经年，旅馆寒灯独不眠。\n心折此时无一寸，三春行乐在谁边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52710,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡二十五首 其二十五","author":"江源","text":"肠断春风为玉箫，越山无路水迢迢。\n床帷半故帘旌断，一点山瑩照寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52711,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋思四首 其一","author":"江源","text":"琪树西风枕簟秋，百年心事付东流。\n鲈鱼正美不归去，一点沙鸥胜五侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52712,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋思四首 其二","author":"江源","text":"生涯心事已蹉跎，况复新秋一雁过。\n借问道傍名利客，天涯归计欲如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52713,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋思四首 其三","author":"江源","text":"离思茫茫正值秋，寂寥灯下不胜愁。\n世间甲子须臾事，昨日少年今白头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52714,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋思四首 其四","author":"江源","text":"碧天凉冷雁来疏，此后无因寄远书。\n岐路辛勤终日有，登山临水复何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52715,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四时宫词 其一 春","author":"江源","text":"紫檀别院锁春光，万转千回懒下床。\n已托焦桐传密意，却将团扇寄回肠。\n柳摇台榭东风软，花压阑干春画长。\n蜂蝶纷纷过墙去，只疑春色在昭阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52716,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四时宫词 其二 夏","author":"江源","text":"已惊新夏燕巢梁，远目非春亦自伤。\n暗室有蝇污白璧，虚桥无雀寄流黄。\n风随玉辇笙歌迥，水滴铜龙昼漏长。\n错把黄金买词赋，静消心火梦魂凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52717,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四时宫词 其三 秋","author":"江源","text":"上阳烟树正秋风，千里南云度塞鸿。\n白玉帐寒鸳梦绝，綵云天远凤楼空。\n长疑好事皆虚事，不是愁中即病中。\n秋去秋来几恩怨，闭门疏雨落梧桐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52718,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"四时宫词 其四 冬","author":"江源","text":"寒气先侵玉女扉，君王初赐六宫衣。\n门开阊阖收金钥，尘压鸳鸯废锦机。\n玉枕夜寒鱼信断，紫阳宫远雁书稀。\n越罗冷薄金泥重，自熨寒衣减带围。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52719,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"咏王昭君","author":"江源","text":"渺渺天涯君去时，黄金何日赎蛾眉。\n谁知粉绘能相负，尚得君王不自持。\n青冢路边南雁尽，黄龙塞上北风吹。\n琵琶却解将心事，乐府皆传汉国辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52720,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"石头城怀古","author":"江源","text":"山园故国周遭在，石势参差乌鹊桥。\n一自降王归上国，已无遗老话前朝。\n诸溪近海潮皆应，折戟沉沙铁未消。\n试问繁华何处在，石头依旧打寒潮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52721,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"京中饯别张挥使郑大尹","author":"江源","text":"怜君一别一悲歌，暝入花亭见绮罗。\n白雁不闻云外过，云山况是客中过。\n壶觞须就陶彭泽，勋业终归马伏波。\n莫道两京非远别，无由缩地欲如何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52722,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送周世祥致仕还乡","author":"江源","text":"绿杨红杏满城春，又向天涯别故人。\n万里江山劳梦寐，十年京洛共风尘。\n眼前好恶那能定，梦里输赢总未真。\n携取旧书归旧隐，半溪山水绿罗新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52723,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼亡","author":"江源","text":"鹊归鸾去两悠悠，未了因缘不自由。\n去日惭多来日少，他生未卜此生休。\n生情暗结千重恨，仙鹤空成万古愁。\n只此旅魂招不得，两行清泪语前流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52724,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"遣怀寄吕敬修","author":"江源","text":"暑往寒来春复秋，细推今古事堪愁。\n汉家箫鼓空流水，晋代衣冠成古丘。\n举世尽从愁里老，何人肯向死前休。\n人生宝贵须回首，万事风波一叶舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52725,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陈存义还南都","author":"江源","text":"不知何事久离群，燕市悲歌又送君。\n才子旧称何水部，诗家今得鲍参军。\n人间后事推前事，江上晴云杂雨云。\n莫向尊前惜沉醉，世情谁是旧雷陈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52726,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春闺怨","author":"江源","text":"似共东风别有因，湿云如梦雨如尘。\n封题锦字凝新思，暗掷金钱卜远人。\n岭树重遮千里目，莺花又度一番春。\n相思相见知何日，犹隔千山与万津。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52727,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋闺怨","author":"江源","text":"伤春未已复悲秋，暗觉年光似水流。\n枫叶荻花秋瑟上，水纹珍簟思悠悠。\n愁将玉笛传遗恨，抛掷金梭织旧愁。\n倚树寻思倍惆怅，悔教夫婿觅封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52728,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠娄侍御南都提学","author":"江源","text":"策名飞步冠群贤，献纳司存雨露边。\n两地山川分节制，九流人物待陶甄。\n公车未结王生袜，壮志仍输祖逖鞭。\n闻说公乡尽南望，春风双佩好朝天。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52729,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客怀三首 其一","author":"江源","text":"宦情羁思共凄凄，久客将归失路蹊。\n人世几回伤往事，是非千载逐芳泥。\n闲过绮陌寻高寺，悔别青山忆旧溪。\n山上有山归未得，一封书寄数行啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52730,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客怀三首 其二","author":"江源","text":"为客偏惊节序催，独寻春色上高台。\n清江碧石伤心丽，紫柏红尘拂面来。\n事不关身皆是累，心从到处即成灰。\n山中旧宅无人住，风雨帷知长绿苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52731,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客怀三首 其三","author":"江源","text":"百感中来不自由，乡关迢递古交州。\n十年客路惊华发，万里风烟接素秋。\n三楚故人皆是梦，百壶芳醑岂消忧。\n尘缨未濯今如此，回首更惭江上鸥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52732,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜泊高邮","author":"江源","text":"奉使虚随八月槎，野芳虽晚不须嗟。\n十年人事空流水，半世江湖负菊花。\n日落远波惊宿雁，月临荒戍起啼鸦。\n人生岂得长无谓，恋阙那堪又忆家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52733,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客中重阳","author":"江源","text":"八月悲风九月霜，满城风雨近重阳。\n但将酩酊酬佳节，莫指云山认故乡。\n千里客游仍暮景，十年秋兴在殊方。\n茱萸插鬓花宜寿，自叹狂夫老更狂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52734,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"感怀","author":"江源","text":"三百六旬长扰扰，红颜白发递相催。\n消磨岁月书千卷，牢落生涯酒一杯。\n江上形容吾独老，眼前人事只堪哀。\n好乘范蠡扁舟兴，家住五湖归去来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52735,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早朝六首 其一","author":"江源","text":"未央朝谒正逶迤，北极长尊仰圣时。\n曙色惭分双阙下，春光欲上万年枝。\n云开五凤楼层矗，花覆千官淑景移。\n四海一家无事日，和鸣双凤喜来仪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52736,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早朝六首 其二","author":"江源","text":"万国圭璋捧赭袍，春云送色晓鸡号。\n风传漏刻星河曙，云卷珠帘剑佩高。\n金殿烟霞浮黼扆，羽林冠盖竖旌旄。\n君臣契合同尧舜，池上于今有凤毛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52737,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早朝六首 其三","author":"江源","text":"绛帻鸡人报晓筹，九重春色满龙楼。\n春生玉藻寒初落，道在金滕世不忧。\n乡月又临仙掌动，御香长傍衮龙浮。\n太平天子朝元日，万寿声长绕冕旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52738,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早朝六首 其四","author":"江源","text":"大明宫殿郁苍苍，绕仗偏随鹓鹭行。\n五夜漏声催晓箭，九重春色绚天光。\n千条弱柳垂青琐，一朵红云捧玉皇。\n应叹冯唐衰且拙，可能垂白待文王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52739,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早朝六首 其五","author":"江源","text":"未央月晓度疏钟，清跸鸣鸾出禁中。\n九陌尘埃千骑合，万方声教一时同。\n金泥照耀传中旨，玉佩成行引上公。\n朝罢香烟携满袖，却疑身在广寒宫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52740,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"早朝六首 其六","author":"江源","text":"天仗霄严建羽旄，蓬莱正殿压云鳌。\n旌旗日暖龙蛇动，黄道天开紫极高。\n瑞气迥浮青玉案，日华摇动郁金袍。\n侍臣此日沾恩赐，敷奏明时岂惮劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52741,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋思四首 其一","author":"江源","text":"十年书剑任飘蓬，故国荆扉在梦中。\n千里暮云山已黑，一川秋草恨无穷。\n那堪流落逢摇落，不是愁中即病中。\n凭寄家书问回报，斜阳江上正飞鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52742,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋思四首 其二","author":"江源","text":"十年身世各如萍，异国光阴老客情。\n鸿雁不堪愁里听，清霜先向鬓边生。\n陈琳草奏才还在，宋玉含凄梦亦惊。\n早晚粗酬身事了，五湖烟景有谁争。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52743,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋思四首 其三","author":"江源","text":"暮天新雁起汀洲，风物凄凄宿雨收。\n且尽绿醽消积恨，莫因鲈鲙涉穷秋。\n终军壮节埋黄土，潘岳闲居欲白头。\n故事悠悠不可问，且将身暂醉乡游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52744,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋思四首 其四","author":"江源","text":"秋风丹叶动荒城，无处登临不系情。\n万里山川分晓梦，千家砧杵共秋声。\n萧何只解追韩信，贾谊何须吊屈平。\n古往今来只如此，遣人怀抱薄浮生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52745,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"写怀次岳丈蒋先生集句韵二首 其一","author":"江源","text":"探尽囊中换赋金，弊裘已畏早霜侵。\n风烟并起思乡念，霄汉常悬捧日心。\n官舍已空秋草绿，空斋长掩暮云深。\n甘泉未厌杨雄赋，会待吹嘘定至音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52746,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"写怀次岳丈蒋先生集句韵二首 其二","author":"江源","text":"忍分书剑各天涯，目断楼船日又斜。\n万里江山劳梦寐，十年缟素飒风沙。\n新词未上鸳鸯扇，远信闲封豆蔻花。\n壮志未消知己在，莫嫌白发负年华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52747,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客舍感怀","author":"江源","text":"乡心迢递宦情微，老大徒伤未拂衣。\n去日渐多来日少，长年方忆少年非。\n身随远道徒悲梗，家在寒塘独掩扉。\n自是不归归便得，渚烟溪月共忘机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52748,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"客中立春感怀","author":"江源","text":"青郊迎气肇初阳，草色新年发建章。\n佳节屡从愁里过，莫年初信梦中忙。\n朝廷有道青春好，天地无私白发长。\n独对一尊问口笑，不知何处是他乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52749,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"将进酒","author":"江源","text":"将进酒，旨且多。\n劝君且停酌，挽首听我歌。\n古人造旨酒，供祭浑无他。\n燕客取合欢，养老怡天和。\n百拜酒三行，宾主两可嘉。\n威仪信不忒，言语无喧哗。\n如何沉冥徒，纵饮生过差。\n将进酒，旨且有。\n饮兮不可过乐，焉不可久。\n久乐则生悲，过饮动得咎。\n毋愆尔威仪，毋乱尔豆笾。\n执法在吾傍，御史在吾后。\n酒诰禁沈湎，卫武悔饮酒。\n君不见昏酣阮步兵，弃蔑礼法何足称。\n又不见嗜酒李谪仙，沉身采石覆可怜。\n劝君反复思，听我丁宁辞。\n古人询刍荛，勿谓余言欺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52750,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"门有车马客行","author":"江源","text":"客从故乡来，车马憩门柳。\n延客入我堂，少坐且抖擞。\n须臾问从来，故乡有书否。\n客答即欠身，封缄乃相授。\n书中何云云，道我别离久。\n大儿能读书，幼子亦学走。\n田园未荒芜，年谷屡丰阜。\n读罢心始降，离忧复句有。\n张筵具嘉殽，饮客进斗酒。\n君其少尽欢，明日复分手。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52751,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长安有狭邪行","author":"江源","text":"大都有捷径，轩盖众若云。\n佩玉摇玲珑，罗绮相鲜新。\n为问过者谁，云是诸贵人。\n杨李皆近臣，韩虢皆近亲。\n金吾避驰道，御史回车轮。\n侯门闹如市，气势薰秋旻。\n岂知终南隐，朴素先秦民。\n衡门足栖迟，义路良可遵。\n荣辱了不知，理乱亦不闻。\n穷居三十载，高卧南山春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52752,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"关山月","author":"江源","text":"胡天云净无纤瑕，一轮明月关山赊。\n青海城边笼白骨，黄龙塞上照寒沙。\n举头处处看圆缺，低头默默伤离别。\n铁骑宵征岭雾深，毡房野宿边风烈。\n一回见月一思归，故乡迢递音书违。\n家人见月亦思我，道我归期定几时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52753,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜长","author":"江源","text":"碧天如水河汉流，洞房蟋蟀鸣高秋。\n百尺枯桐挂西月，一声孤雁度南楼。\n徘徊独步愁长夜，孤妾空闺谁与俦。\n悠悠闲却双鸳枕，飕飕不煖孤衾裯。\n手寒灯下裁书劄，目断天涯无便邮。\n念君万里隔胡越，我欲从之河无舟。\n河无舟，将奈何，为君一曲弹空篌。\n鹍弦转拨相思调，不道相思更起愁。\n相思一夜头欲白，我姑酌酒聊销忧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":52754,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]