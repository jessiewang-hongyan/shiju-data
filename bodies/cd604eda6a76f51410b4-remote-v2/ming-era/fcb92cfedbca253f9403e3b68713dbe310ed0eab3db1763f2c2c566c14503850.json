[{"title":"秋兴柬杨方震掌同年","author":"苏葵","text":"芙蓉花底望青霄，老鹬横空彩凤遥。\n慵理槁梧翻旧谱，旋沽桑落试新瓢。\n江门叠浪随风滚，山外浮岚向日消。\n鹤背有人应是我，五云谁在莫招要。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54180,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日雨中","author":"苏葵","text":"寒蛩声急换秋衣，回首王孙草色非。\n龙马河边占世治，鲈鱼江上起人归。\n钟前漏在犹传点，梦里棋残未解围。\n犬马有怀消不得，柏台秋夜雨霏微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54181,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜小酌","author":"苏葵","text":"影落疏梧玉鉴明，露虫寒雁各秋声。\n蹉跎尚觉孤怀壮，吟眺惟怜病骨清。\n新酿百壶仪狄酒，旋调一味长公羹。\n眼前得失浑忘却，山鬼旁观笑不成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54182,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"悼孔林灾","author":"苏葵","text":"逃墨无人最可哀，丹青随处梵王台。\n宁知洙泗千秋水，不杀乾坤一炬灾。\n箕范庶徵留象数，杞人孤念寄烟灰。\n勉收老泪阶前立，夜看文昌与上台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54183,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"拟渔父吟","author":"苏葵","text":"鱼梁无笱看鱼过，水碧溪清映短蓑。\n仰面半笼扪虱手，放声不和饭牛歌。\n芦花月在江天迥，杨柳风来故旧多。\n莫道我无裨世教，利名喧处要詹何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54184,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"九月朔日","author":"苏葵","text":"九月朔日冲飙强，楼头金铁声锵锵。\n骚人有赋写新景，游子无衣忆故乡。\n乍冷不愁钟汗落，长吟惟厌庾尘扬。\n未应飘尽梧桐叶，留荫残枝宿凤凰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54185,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"观道命录有感","author":"苏葵","text":"淫哇声沸九韶寒，世道污隆用舍间。\n薄雾偶笼伊洛水，片云争掩武夷山。\n千秋遗训乾坤意，一代成功造化悭。\n不有上方三尺剑，付谁当日斩权奸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54186,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄邑尹友人邵廷端","author":"苏葵","text":"河阳花发簇红云，莞尔牛刀却在君。\n琴鹤自应闲白昼，苞苴谁敢候黄昏。\n故人年少留凫舄，老我时违想鹿门。\n未历山城听更鼓，篇诗凭写略温存。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54187,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游杭州报国胜果梵天诸寺三首 其一","author":"苏葵","text":"楼台矗矗阁青山，千个长松竹万竿。\n城近却能辞俗驾，云闲应为护诗坛。\n香前结愿成来业，方外留情恨有官。\n不是老坡无玉带，欲将何物换蒲团。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54188,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游杭州报国胜果梵天诸寺三首 其二","author":"苏葵","text":"一壶倾尽马蹄遥，贪看名山逐晚飙。\n处处禅房深贮月，源源泉窦暗通潮。\n三千界上闲烟雨，二百年前旧市朝。\n欲涤尘襟飞瀑少，直攀星汉借天瓢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54189,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"游杭州报国胜果梵天诸寺三首 其三","author":"苏葵","text":"越山不似吴山秀，今寺还仍古寺基。\n数里阴深松引道，一庭苍翠竹交枝。\n鹤当方丈迎人瘦，僧检楞严下榻迟。\n莫把宦情偏笑我，古来灵彻寄谁诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54190,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送娄元善正郎还信州","author":"苏葵","text":"公于山水得前缘，买断鹅湖不费钱。\n国论独高陈仲举，剑光犹恨左回天。\n人间蕉鹿谁先觉，眼底金兰自合怜。\n明对松花怀旧雨，东风何日过湖船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54191,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐用济太守来访自山寓于石亭寺值病不及拜之作二诗布谢 其一","author":"苏葵","text":"公来吾病出门难，代简敲推句却悭。\n蟋蟀阶边争鹤瘦，神羊台下守株闲。\n槁梧自合弹流水，信宿何忙忆旧山。\n此日诗坛看拜将，受降城下凯歌还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54192,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐用济太守来访自山寓于石亭寺值病不及拜之作二诗布谢 其二","author":"苏葵","text":"落霞孤鹜倚天隅，楼外秋光若画图。\n返照入林明橘柚，朔风吹水冷菰蒲。\n门前有客来题凤，江上无人忆脍鲈。\n寄谢幽求莫深笑，葛洪期我结丹炉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54193,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋日和王安陆韵","author":"苏葵","text":"百折秋江江水长，芙蓉堪集作新裳。\n连天草色终归腐，绝壑兰枯不改香。\n三窟谁真高一枕，九歌吾欲和东皇。\n霜横风急啼鸦晚，笑倚台端柏树苍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54194,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答王安陆太守二首 其一","author":"苏葵","text":"惭愧山中草莽臣，十年簪绂仅荣身。\n道将兴废诚由命，时自盈虚不属人。\n世路多歧南亦北，俳儿诸戏假如真。\n瞠然独后怜衰暮，谁在亭衢去绝尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54195,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"用韵答王安陆太守二首 其二","author":"苏葵","text":"静爇黄檀更水沈，亦谈千古亦谈今。\n耽诗不遣能成癖，爱酒争教也醉心。\n此日孤怀东观杳，几时归计北山深。\n红渠翠竹新知少，或者江崖许盍簪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54196,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"初冬漫书","author":"苏葵","text":"谬捧天章作俊良，三年心事漫周章。\n孤臣志屈苍冥远，十月愁多白日长。\n射鸭何如孟东野，斩蛟不复许旌阳。\n栖栖却愧僧林鹤，未得冲霄羽翮凉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54197,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"松月为瑞昌府镇国将军题","author":"苏葵","text":"秋夜沈沈玉宇空，苍髯疏拂桂花风。\n千年琥珀氤氲里，七宝楼台缥缈中。\n栖日枝头擎顾兔，影娥池面漾虬龙。\n分明一段诗家景，并入王孙院落东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54198,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"愁城","author":"苏葵","text":"愁城酒力不能开，阅罢南华去又来。\n晓了浮生同梦觉，如何襟度未规恢。\n五更钟漏听将彻，一夜家山梦几回。\n草色雁声非易遣，夕阳吟啸望乡台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54199,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"宿武阳驿","author":"苏葵","text":"朔风如戟撼肩舆，心事周章业半虚。\n漫有豪芒三尺剑，不多行李几箱书。\n山消晚瘴蛾眉秀，路转荒田绶带纡。\n向夜剔灯吟不寐，驿亭临水雨潇疏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54200,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"馀干行台对雪用东坡韵","author":"苏葵","text":"江梅香冷斗秾纤，白战骚坛未解严。\n四季有花隋苑树，几枝无味晋宫盐。\n鲛人巧织凭机杼，冻雀饥啼近屋檐。\n只有石台容易没，匡庐终是露苍尖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54201,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"弋阳舟中夜坐","author":"苏葵","text":"笳鼓休教聒病夫，三更犹自拨风炉。\n一灯明灭青藜火，万事沈潜太极图。\n天下靠谁波砥柱，山中还我药葫芦。\n诗成更起推窗看，雪拥梅花近舳舻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54202,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"瑞河舟中值雨","author":"苏葵","text":"春雨丝丝春草萋，近山清晓鹧鸪啼。\n扁舟逆挽有时顺，流水东驰不复西。\n浪执污隆悲世道，不妨行止任天倪。\n豪来添得奚囊句，却怪诗成未有题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54203,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆田园","author":"苏葵","text":"荒芜此日又陶园，南望愁怀共草繁。\n在禄且须粗事事，逢人岂敢尽言言。\n山中异鹤曾惊矢，道上羝羊漫触藩。\n明日杖藜丘壑好，路头偏近杏花村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54204,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"忆归","author":"苏葵","text":"倘来簪组可全抛，世路谁甘作系匏。\n风月满川人得取，鹿麛随处我投交。\n棋招黄绮横仙局，书学经生究易爻。\n无地楼台吾岂敢，欲寻深处结窝巢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54205,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭从兄弟铁峰八首 其一","author":"苏葵","text":"童稚情亲到白头，雁行欢爱鹡鸰忧。\n宁知别后膏肓疾，不预床前药石谋。\n愔老悲深非幕客，符儿梦断有诗邮。\n泪流不待书来日，蓍告逢凶已泪流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54206,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭从兄弟铁峰八首 其二","author":"苏葵","text":"夜闲历记对床言，不信云亡若尚存。\n兰蕙旧时环堵室，棠梨明日殡宫门。\n浮生已了真成了，窀穸无闻不用闻。\n诸弟想应能干蛊，莫将遗事扰英魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54207,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭从兄弟铁峰八首 其三","author":"苏葵","text":"情洽飞来忍别时，十年两度讣音驰。\n可怜世上浑驹隙，安得天涯不泪垂。\n慈孝事多虽未了，清閒日短已便宜。\n烦于彦达从容道，归老无人共酒卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54208,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭从兄弟铁峰八首 其四","author":"苏葵","text":"生前甘静厌嚣烦，悬解逍遥不可言。\n百役支援□劣在，诸郎开迪晦峰存。\n盟鸥已断寻新路，化鹤如归记旧村。\n无限哀歌吟未了，屋梁新月又黄昏。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54209,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭从兄弟铁峰八首 其五","author":"苏葵","text":"二顷潮田足养生，落花啼鸟枕前听。\n不容太占安便计，此是无常造化情。\n鹤梦已醒抛往事，牛眠有在卜新茔。\n我归欲效经营责，先检阴阳郭璞经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54210,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭从兄弟铁峰八首 其六","author":"苏葵","text":"偶逢家庆备监司，斗粟分酬恨已迟。\n只道此生同有日，不知而数是终时。\n食难下咽凭鸠杖，泪不收痕点廌衣。\n何处凄凉堪不得，薛家楼外断鸿飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54211,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭从兄弟铁峰八首 其七","author":"苏葵","text":"常言静者寿偏高，石枕藤床最不劳。\n林下已闻凋玉树，世间原未长蟠桃。\n四方上下魂何在，万物洪纤数莫逃。\n休道巫咸招不得，想无遗恨恋东皋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54212,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"哭从兄弟铁峰八首 其八","author":"苏葵","text":"古今唐肆马纷纷，闲把彭殇折半分。\n只有庄生能远此，岂徒颜子不如君。\n五旬万有八千日，十分多拚三四人。\n况在宗祧遗德下，不经微贱不经贫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54213,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"袁州道中偶书","author":"苏葵","text":"山雨不来江水澄，中流一苇晓风清。\n恐惊沙上眠鸥起，不要津头候吏迎。\n太史旧书堪送老，司徒遗铎未收声。\n春宵半作仙家梦，行遇佳山急问名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54214,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送平乐尹克龙梁公奏最之京时寓临江行台理疾以俟归命","author":"苏葵","text":"仙凫清晓拂行台，细叙离怀阁酒杯。\n万灶疮痍看抚字，六年军饷费飞推。\n如今卓令真书最，自古山公解荐才。\n展骥得恩明在信，鲤鱼应上钓竿来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54215,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送邹汝愚贬石城吏目","author":"苏葵","text":"孤忠耿耿平生学，此日苍黄就道难。\n别白是非谁直笔，萧条行李几荒山。\n九天杲日真能照，三月冰山不久寒。\n人事晦明吾默卜，子方应及潞公还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54216,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮春感兴","author":"苏葵","text":"马踏残花又暮春，路危思理病中身。\n官居吴楚春秋地，才愧苏张战国人。\n梦里蘧庐轻得失，案头糟粕隐经纶。\n梧桐樲棘知多少，无限场师认未真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54217,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"傀儡","author":"苏葵","text":"众中调笑巧如神，俊貌修容彩服新。\n恍若风流淩谢傅，宛然辞辨过苏秦。\n遥看共许鸡碑智，细辨方知木偶身。\n一物胸中无所有，虚提虚弄尽愚人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54218,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"双陆二首效元人体 其一","author":"苏葵","text":"守者何如击者劳，疏星残月照成皋。\n阴阳有数行当勇，车马无声战自鏖。\n巧弄玄机翻是拙，早图归计便为高。\n人间胜负寻常事，看破曾无直一毫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54219,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"双陆二首效元人体 其二","author":"苏葵","text":"寂寂方城半月寒，三三五五虎牙攒。\n势将犄角成功易，道阻纵横合伴难。\n一掷点筹争喝采，数行分马又更端。\n雌雄局面那能定，多算翻危少算安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54220,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书王少参朝言薰风笑我卷用韵六首 其一","author":"苏葵","text":"近鴳蓬蒿也自安，寻常波泽大鹏难。\n洪纤在物初来定，宇宙饶吾一掬宽。\n论伯论王还论帝，非扬非董亦非韩。\n等閒探取薰风意，是笑弹冠笑挂冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54221,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书王少参朝言薰风笑我卷用韵六首 其二","author":"苏葵","text":"只今海宇未全春，肉食偏惭草莽臣。\n贫定已嫌东郭履，老来惟爱华阳巾。\n暖姝敢谓真知道，委顺谁云不爱身。\n寄语薰风莫轻笑，不求富贵底求人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54222,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书王少参朝言薰风笑我卷用韵六首 其三","author":"苏葵","text":"弯弓曾挂扶桑东，白首行藏有朴忠。\n道在却惭甘画地，时违端不谬书空。\n鹤鸣声隔尘埃外，兰朽香留棘艾中。\n笑问薰风意何在，笑人穷不笑人穷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54223,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书王少参朝言薰风笑我卷用韵六首 其四","author":"苏葵","text":"蹄涔那可较天池，欲谢蹄涔未冠期。\n吟看秋山诗骨耸，醉听春雨酒杯迟。\n鸡能搏击应留距，蚕自萦缠漫吐丝。\n不分薰风苦相笑，待教年下买馀痴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54224,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书王少参朝言薰风笑我卷用韵六首 其五","author":"苏葵","text":"不信庄生是谬悠，庄书看罢倚南楼。\n胸藏沧海有馀量，气逼南山更出头。\n千古荣枯归野马，一枝安便是蒙鸠。\n何如也被薰风笑，可是人愁我不愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54225,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"书王少参朝言薰风笑我卷用韵六首 其六","author":"苏葵","text":"此日无人式怒蛙，曹蜍廉蔺径庭赊。\n尽从灞水看杨柳，只有濂溪爱藕花。\n管取寸心刚似铁，不妨多事乱如麻。\n薰风莫浪逌然笑，志士从来不顾家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54226,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"庚申入京途中漫书","author":"苏葵","text":"白头操檄入京师，万里舟航两月移。\n忠荩有怀人或会，驱驰亡倦鸟相嗤。\n薛瑩未解甘玄静，孝若从闻著抵疑。\n江客不知羁旅思，夜深横玉数声悲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54227,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"舟泊直沽夜坐偶成","author":"苏葵","text":"醉攀星斗放诗怀，吟看潮生又落涯。\n先哲结斋如画舫，病夫移舫作书斋。\n银蟾出海秋光冷，白鹤横江夜色佳。\n更忆篷莱东去近，眼昏频自望中揩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54228,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重阳雨中金舜举宪副惠酒赋以谢之","author":"苏葵","text":"绝胜王宏遣白衣，行人不把菊花枝。\n开尊满覆舒州杓，乘兴狂歌栗里诗。\n佳节可堪风雨误，雅怀全向使君披。\n明年载酒知何处，应记今年舣棹时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54229,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"漫成","author":"苏葵","text":"白首犹于计吏俱，风尘扑面笑驰驱。\n朱门素乏君卿智，清世徒怀汲黯愚。\n潇洒客途词赋窘，分排羁思酒尊虚。\n夜深爱弄江边月，怪杀浮云翳不舒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54230,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋晚潞河南望","author":"苏葵","text":"秋晚空惊世事乖，暮鸦添恶上孤怀。\n静知方好无汤咽，醉觉愁闲有力排。\n啼月雁声投楚泽，凋霜柳色接秦淮。\n行人归计浑无定，目断梅关万仞崖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54231,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和周廷瑞别驾末首反其意以为戏耳三首 其一","author":"苏葵","text":"处处江山处处楼，此心原自纵天游。\n碧桃红杏任争晓，翠竹苍松不管秋。\n大隐我从周柱史，富民君亦汉通侯。\n人间痴绝知多少，莫讶区区顾虎头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54232,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和周廷瑞别驾末首反其意以为戏耳三首 其二","author":"苏葵","text":"一区未构贮书楼，十乘相随事远游。\n大道未闻浑忘老，壮心原在绝悲秋。\n逐贫不去怜杨子，乞巧无缘负柳侯。\n世事古来何独我，利名关外展眉头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54233,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"和周廷瑞别驾末首反其意以为戏耳三首 其三","author":"苏葵","text":"悬磬萧萧当画楼，齐奴偏在五云游。\n十年仕路知无补，二顷潮田报有秋。\n不破邯郸犹在梦，仅胜户牖未封侯。\n如何懒入柴桑社，可爱腰缠天际头。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54234,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜边捷和前人韵","author":"苏葵","text":"貔貅百万拥长城，车骑嫖姚各负名。\n鹰解北扬风自竞，马无南牧草浑生。\n何人不奋乘边志，明日看输款塞诚。\n杂遝凯歌应载道，玉门关内有人听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54235,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仪真阻风二首 其一","author":"苏葵","text":"真州江口戒兰桡，五两无凭坐看潮。\n白下南观天堑迥，瓮城东去海门遥。\n驭风夜半恒占气，驱石朝来欲驾桥。\n醒面恶怀难强遣，阮孚元不吝金貂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54236,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"仪真阻风二首 其二","author":"苏葵","text":"两都形势此江分，暂阁风帆四望频。\n越梦正牵舟上客，吴歌偏快岸旁人。\n龙潭有气低连渚，潮水无声暗没津。\n闲向老渔谈往事，楼船飞渡已成尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54237,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"长江即事","author":"苏葵","text":"洞庭西注海东流，形胜南来王气浮。\n花柳六朝歌舞地，江山千古帝王州。\n缝囊未破三分固，定鼎才看一统优。\n正是越裳来往处，水平波静几千秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54238,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春日北还鄱阳湖即事","author":"苏葵","text":"锦帆春晓漾湖光，岸芷江蓠十里香。\n云气北来经华岳，雨声西去过浔阳。\n前追高士洪州近，回吊灵均楚泽长。\n清啸数声山谷应，睡龙惊起浪花强。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54239,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过康山忠臣庙追吊前烈","author":"苏葵","text":"锦旗竿上风初竞，绿水湖边日欲黄。\n一日山河定刘项，千年词宇惜关张。\n攀龙有志生何爱，扼虎成功死亦香。\n草昧相从人或误，诸君偏解识真王。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54240,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"徐河舟中值雪","author":"苏葵","text":"危樯夹橹过河干，沙岸谁将玉屑摊。\n舟子尽如披鹤氅，天孙应是剪冰纨。\n一江夜色清偏绝，十里山容画亦难。\n可恨独吟身在客，若为移得故乡看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":54241,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]