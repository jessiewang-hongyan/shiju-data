[{"title":"寄镇性禅师","author":"谢榛","text":"草庭驯鸽傍谁飞，云锁山房何日归。\n帝里宁教淹锡杖，京尘犹恐上缁衣。\n路通三晋音书杳，雨隔诸天钟磬微。\n却忆少林风雪夜，一灯相对话禅机。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14880,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠方金湖中丞","author":"谢榛","text":"今王神武重边功，镇静遥看节钺雄。\n蓟北霜连兵气外，幕南春在政声中。\n天分两地书难达，路隔千山梦易通。\n更忆楚才心独壮，何须摇落赋秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14881,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀刘念庵兵宪时执所纪梧岗二太守","author":"谢榛","text":"群才相识北游时，上苑千花春雨垂。\n帝里荣名同昼锦，宦途愁鬓各秋丝。\n归休日远桑麻计，登眺云深猿鹤期。\n月下飞觞聊遣兴，倚楼谁复叹盈亏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14882,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄李近台侍御时督学北京","author":"谢榛","text":"鳌头矶下征帆发，鱼腹书传逝水沉。\n摛赋三秋堪寄兴，定交千里见知音。\n庙廊自合经纶远，冠冕谁当雨露深。\n上应文昌燕赵地，朝端抗疏几年心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14883,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄王龙坡员外兼呈乃弟西堂少卿","author":"谢榛","text":"忆昔论交梁苑秋，晋阳春雪慰淹留。\n白衣阅世吾多感，黑发为郎尔壮游。\n阊阖南开今汉阙，河山北控古燕州。\n遥知伯仲相逢处，为说穷途阮籍愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14884,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄黄质山徵君","author":"谢榛","text":"古来词客自悲秋，江上斜阳正倚楼。\n南望战云迷越徼，北移王气绕燕州。\n几家避乱偏多苦，诸将成功各自谋。\n今日黄生须献赋，千金宁复买吴钩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14885,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄上德平王南岑","author":"谢榛","text":"别意相牵雨梦遥，白莲社冷复谁招。\n病馀较懒心犹壮，诗里多穷气不骄。\n秋草放鹰随仆从，夕阳驻马问渔樵。\n何时共赏龙山胜，醉听松风响洞箫。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14886,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋雨连绵南望洛阳因寄吴大理温中丞谢给事刘兵宪吕太守词丈","author":"谢榛","text":"白首飘蓬来自西，旧交南望感云泥。\n周南文物犹逢汉，邺下词人久别齐。\n河涨蛟龙秋怒转，雨昏乌鹊夜愁栖。\n嵩峰暗落三花树，空约登攀去路迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14887,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄怀王郡丞叔纯","author":"谢榛","text":"暂閒官署得烟霞，相对论心坐日斜。\n邺下佩刀应自壮，齐中弹剑更何嗟。\n老餐古涧青松子，君爱秋塘白藕花。\n王谢风流今北转，高堂燕子是谁家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14888,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送潘左史和甫归吴门","author":"谢榛","text":"琼筵祖饯惜君才，别后吴吟日几回。\n坐看青山帆外转，更怜黄菊客边开。\n长江日动鼋鼍窟，旧国霜飞麋鹿台。\n归去逢人说帝子，盛名却自险中来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14889,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄赠李中丞子玉","author":"谢榛","text":"节钺经年颂未能，路人争说李中丞。\n贤才几访吴枚乘，世事相论魏信陵。\n愁见黄河秋尽雨，坐怜赤子夜深灯。\n帝京尚忆逢狂客，骢马翩翩兴每乘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14890,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄梁方伯乾吉","author":"谢榛","text":"相别京华岁月遥，双林枉驾识仙标。\n隔年投刺何疏懒，抱病参禅正寂寥。\n河北剑霜嗟暮景，晋阳灯火忆春宵。\n壮心莫道非王粲，几欲从军看射雕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14891,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"渡黄河有感","author":"谢榛","text":"晚渡黄河正素秋，倚篷聊尔问阳侯。\n源从西极昆崙出，势荡中原瀚海收。\n俯仰心神齐得丧，往来身世共沉浮。\n试看九曲风涛恶，博望焉能见斗牛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14892,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"陈主簿招饮署中因谈宛陵之胜醉笔赋此","author":"谢榛","text":"官署相招慰旅情，东南形胜说宣城。\n敬亭恍接三吴势，宛水犹驰六代声。\n忆昔诗流嗟我老，隔江风景逼人清。\n至今谁继玄晖后，莫笑狂夫负此生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14893,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"谒汉光武原陵","author":"谢榛","text":"龙飞白水兆中兴，天定滹沱十月冰。\n半夜客星思汉室，千年王气感原陵。\n山灵松槚殊相护，地胜樵苏讵敢登。\n试读班彪王命论，嵩峰依旧郁峻嶒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14894,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"丁明府陈主簿同谒原陵晚酌道院有感","author":"谢榛","text":"汉陵谒罢命车行，聊憩丹房待赋成。\n绿酒黄花衰老兴，浮云落日古今情。\n狂夫欲驾蓬山鹤，道士能吹缑岭笙。\n忆昔豪华总消歇，北邙松柏起悲声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14895,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"重九前一日谢黄门仲川同酌温中丞纯甫宅赋得风字","author":"谢榛","text":"开樽预赏菊花丛，正色全归藻思中。\n旅次孤怀逢胜事，人间百感对秋风。\n水冲伊阙云根响，山抱周京地势雄。\n明日登高谁共醉，更将吴调命歌童。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14896,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"温纯甫宅同诸词丈夜集得池字","author":"谢榛","text":"为赓白雪郢中词，坐久寒生风露时。\n万菊绕筵秋不老，几人耽酒月偏迟。\n怀同旷逸山云度，道在行藏野鹤知。\n应惜衰年荐仙味，西来碧藕自瑶池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14897,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"即席次刘子礼登高韵","author":"谢榛","text":"西风吹雁下河洲，坐感颓年聚旧游。\n抚景独惭今日赋，遣怀何异故乡楼。\n尘中浪迹陪高宴，篱下黄花笑白头。\n京洛层城试登览，疏云惨澹数峰秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14898,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寄谢子厚","author":"谢榛","text":"思君逸兴感衰残，几欲登临学谢安。\n倚杖青山愁里赋，当樽黄菊病馀看。\n清辉自可藏珠玉，文彩谁应惜孔鸾。\n皎月一天人两地，茫茫秋色不胜寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14899,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"嵩岳天中阁同鲍洛阳邓登封二君对雨","author":"谢榛","text":"六十危峰佳气连，共来山阁羽觞传。\n兴高自不妨秋雨，目极何当散暝烟。\n问法少林轻外物，探奇嵩岳到中天。\n二君并着王乔舄，才思非凡骨已仙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14900,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"过周节推尚占因谈嵩岳之胜","author":"谢榛","text":"伊洛寻真竟不逢，归来对尔说仙踪。\n两游洞壑情何剧，独眺烟岚翠几重。\n庭树月招缑岭鹤，郡斋风落少林钟。\n宁言何逊观梅兴，梦到三花天外峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14901,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"洛下会王少会朝望","author":"谢榛","text":"铜台旧识叹离暌，伊洛棠阴众念齐。\n世故无端逢客话，宦情何事欲岩栖。\n天将楚雨催帆骤，风荡秦云逐马低。\n八载一迁春自感，从教黄鸟向人啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14902,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠吕都督伯仁","author":"谢榛","text":"禦寇论功忆昔年，又从扬子驾楼船。\n塞门列阵山云合，幕府听笳海月悬。\n仗剑独临龙虎地，登台长啸凤凰天。\n于今未老归诗社，祗遣儿曹办酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14903,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘太守以德之大梁予将赴潞安赋此言别","author":"谢榛","text":"西署为郎已著名，分符岁暮此专城。\n肯孤上党缄书意，为寄南州下榻情。\n长路风威嘶五马，大河日影曳双旌。\n梁园公子如相问，著述应怜老未成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14904,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"季冬法祥寺吴大理张总督温中丞谢黄门刘兵宪荀员外昌都督吕池州方东昌诸词丈饯别有赋","author":"谢榛","text":"香山遥望白云屯，九老行藏未定论。\n为客自知生事懒，感时谁更壮心存。\n河桥寒色分千里，野寺斜阳共一樽。\n黄鸟鸣春向何处，美人相忆采芳荪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14905,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"杨郡丞伯寅张别驾威仲寺中饯别周节推尚占之大梁未旋怅然赋此","author":"谢榛","text":"双林行色夕阳催，几日相逢祖席开。\n周汉两朝题不尽，河嵩独览倦方回。\n尘中老计嗟浮梗，笛里春声怨落梅。\n更念法曹征旆远，菟园何事未归来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14906,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"刘节推行可尚宝仕可出饯郭外赋此志别","author":"谢榛","text":"杯酒苍忙强自吟，江淹能赋别时心。\n绿波春草魂犹断，白首寒天感益深。\n布泽二龙周海宇，栖閒孤鹤老山林。\n谁知多病仍飘泊，雨雪愁人几暮阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14907,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"赠别武克仁","author":"谢榛","text":"八十神全步履轻，自嗟七十负平生。\n紫芝采得间中事，白鹤飞来静里声。\n多少光阴仍浪迹，古今著述总浮名。\n问君可授延年术，九转丹砂未易成。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14908,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"喜黄实甫至留酌","author":"谢榛","text":"自别梁园岁几徂，故人消息断江湖。\n相逢白鬓知多少，一醉黄金问有无。\n地接边关秋气早，树翻乌鹊月明孤。\n向来离合殊难定，犹向天涯说壮图。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14909,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"立秋先一夜同吴峻伯孙文揆徐汝思李于鳞王元美五比部登城得秋字","author":"谢榛","text":"几年词客凤城游，蓟北河山共倚楼。\n清夜桂樽聊对月，明朝蓬鬓又惊秋。\n风飘玉笛凄初断，天转银河倒欲流。\n遥忆故园砧杵动，梧桐一叶起人愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14910,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送龚侍御性之赴南都","author":"谢榛","text":"万里天风吹铁冠，三吴秋水正漫漫。\n匣中星动剑光白，帆外霜飞江色寒。\n鸿雁早传瓜步信，芙蓉还傍石城看。\n南都赋就应相忆，明月孤樽坐夜阑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14911,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"为卢楠赋呈内台比部大理诸公","author":"谢榛","text":"黎阳河水咽寒声，词客凄凉气未平。\n白首才传鹦鹉赋，青天遥望凤凰城。\n夏台久待秋云破，春雨还看枯草生。\n独有郦炎同此恨，怜才复见古人情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14912,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集吴比部鸣仲宅赋得秋月","author":"谢榛","text":"庭草惊秋白露垂，冰轮渐觉度河迟。\n光临凤阙清钟断，寒入龙庭画角悲。\n天际几看鸿雁影，山中又老桂花枝。\n共知庾亮南楼夜，曾为勋名感鬓丝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14913,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登遵化阁","author":"谢榛","text":"凌虚楼阁郁崔嵬，四望青山宿雾开。\n日上海关边色尽，天连沙漠雁声来。\n仲宣赋就千年事，张载铭成一代才。\n怀古不堪空伫立，秋风吹鬓放歌回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14914,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"登五峰山有感","author":"谢榛","text":"树杪跻攀石磴悬，手扶藜杖出风烟。\n东分辽海千重岭，北尽沙场万里天。\n秋草征夫烽堠外，夕阳归鸟戍楼边。\n时看白骨成悲感，为忆嫖姚战伐年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14915,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夹山寺","author":"谢榛","text":"黎河路转入烟霞，为访连峰衲子家。\n万古山灵开白马，三秋石窟闭青蛇。\n昙云不作空中雨，祇树还生象外花。\n欲共虚堂留此夜，灯前仍复演三车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14916,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜同刘都阃诸君登蓟州城楼","author":"谢榛","text":"新月低空照素秋，将军乘暇共登楼。\n谈兵醉后谁能事，舞剑灯前此壮游。\n孤角风从燕塞起，千山云傍蓟城流。\n应知北伐收功日，复见当年博陆侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14917,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"酌沈太守汝石宅值雨","author":"谢榛","text":"孤城有客驻征鞍，下榻今宵重鹖冠。\n叠嶂烟云当户暝，老槐风雨逼人寒。\n开樽最喜天涯合，为郡偏忧塞上难。\n自信隐侯筹策定，肯教双鬓叹凋残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14918,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"八月十六日予归自渔阳值北兵犯京时周一之在安州作此怀之","author":"谢榛","text":"易水东流朔雁飞，孤城阻绝几斜晖。\n共忧铁马书难达，应讶渔阳人未归。\n大野暝烟沉汉垒，乱山秋雨滞戎衣。\n即今世事堪杯酒，与尔江南访钓矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14919,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"暮秋柬沈参军禹文","author":"谢榛","text":"参军逸气佩吴钩，烽火惊心又暮秋。\n乱后登临仍有赋，望中风景独深愁。\n边隅树色空军垒，东北笳声断戍楼。\n应惜中原多猛士，几人相见话封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14920,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送栾进士孔原使宣大","author":"谢榛","text":"燕甸苍茫乘晓发，汉旌缥缈隔河看。\n居庸北去天霜下，碣石东临海日寒。\n八月边声驱战马，孤城秋色老材官。\n凭君一问云中将，此日方知报国难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14921,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送张户曹茂参募兵真定诸郡","author":"谢榛","text":"人辞京国黄尘外，霜落滹沱白雁前。\n驿骑先飞秋草路，使旌高捲夕阳天。\n欲招游侠倾三辅，拟见驱驰静九边。\n班固为郎宁久滞，还期北去勒燕然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14922,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送计库部允卿募兵山东","author":"谢榛","text":"京甸秋高羽檄驰，可怜万姓半疮痍。\n当朝遣使忧方切，募士防边计未迟。\n山气作寒侵道路，海风吹雪上旌旗。\n齐中还访穰苴辈，推毂论功正此时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14923,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送万少参茂卿还任山东","author":"谢榛","text":"乱后相逢复几朝，使君行色动河桥。\n宦情千里清樽尽，国计频年白发饶。\n驿道书通秋塞雁，海门帆度夕阳潮。\n鲁连意气须今日，此去齐城可更招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14924,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"秋夜有感","author":"谢榛","text":"凉宵力疾步莓苔，欲赋高秋愧楚才。\n白发祗缘人事老，黄花偏傍客愁开。\n樽前独坐星河转，灯下悲歌风雨来。\n还忆重阳离乱后，故园惆怅一登台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14925,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"夜集应员外瑞伯宅闻吴山人子充谈匡庐之胜得山字","author":"谢榛","text":"吴楚遨游鬓已斑，对人犹自说庐山。\n九江形胜来樽外，五老云霞生座间。\n古洞月明今夜梦，满天秋色几时攀。\n何如早结东林社，瀑布声中任往还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14926,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送朱参政之豫章","author":"谢榛","text":"落落才名三十年，宦途华发转堪怜。\n独辞上国星随马，四渡西江月满船。\n湘雁晚低彭蠡泽，楚云春澹豫章天。\n定知丰剑归君后，遥望长安北斗边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14927,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送毛明府伯祥之羊城","author":"谢榛","text":"君今初捧郎官檄，此去羊城道路赊。\n海上有云连蜃气，岭南无雪到梅花。\n行春策马青山近，退食鸣琴白日斜。\n回首风尘迷北望，几逢燕使问京华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14928,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"寒夜寄秦给事顺甫","author":"谢榛","text":"岁华冉冉频弹铗，秋色冥冥独倚阑。\n倦客吟成山月堕，征鸿过尽海天寒。\n燕关寄迹还东下，烽戍惊心几北看。\n闻道故园青琐客，忧时双鬓坐凋残。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14929,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送赵汝中归垣曲","author":"谢榛","text":"天涯作客空成赋，岁杪还家未拜官。\n到日音书仍北寄，别时风物重西看。\n云迷燕赵千山暮，雪满关河一骑寒。\n樽酒相期春草绿，好听鸿雁度长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14930,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"范子宣见过","author":"谢榛","text":"世情满眼殊未定，之子相逢可共论。\n自是胜游疏客计，非关浪迹久都门。\n雪中坐索梅花赋，月下还开竹叶樽。\n更约扬帆下春水，三江南去访桃源。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14931,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送王理卿归平原","author":"谢榛","text":"春来三日君即归，长安陌上车尘飞。\n沧洲有约自知晚，白雁多情相见稀。\n千里还应叹萍梗，一樽谁更采芳菲。\n平原旧侣论心处，肯向天边望少微。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14932,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"程侍御信夫至因话关中之胜","author":"谢榛","text":"为问三秦骢马使，独探形胜故迟回。\n云扶华岳中天起，地转黄河西极来。\n秋草空迷长乐苑，夕阳犹傍集灵台。\n汉家千载论封禅，应惜文园作赋才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14933,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"冬夜同宣允则集徐进士子与宅","author":"谢榛","text":"城上乌啼春雪馀，满庭寒色月来初。\n病当岁晚心方切，老向天涯计转疏。\n湖海相知今夜酒，风尘一别几年书。\n可堪京国多烽火，王粲谁怜未定居。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14934,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"雪夜集吴进士明可宅候李给事元树吴进士子修不至得楼字","author":"谢榛","text":"黄云黯澹低神州，风雪晚来殊未休。\n春色连天变老树，寒光夺月明高楼。\n初成谢赋此时兴，还听郢歌中夜留。\n二妙不来更秉烛，笛声凄断梅花愁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14935,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"人日过吴郎中峻伯第时将使豫章得西字","author":"谢榛","text":"馀寒薄暮重凄凄，城上青山望欲迷。\n人日正逢燕雪后，使星遥动楚天西。\n宁辞取醉留官舍，更约寻春过御堤。\n何限柳条萦别思，江城南去乱莺啼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14936,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送沈郎中宗周出守顺庆","author":"谢榛","text":"明星当户动征鞍，此去春光道路看。\n巴子地形天外转，嘉陵江色郡中寒。\n三秋战伐抡才急，四海诛求出牧难。\n沈约未须裁八咏，倚楼时复望长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14937,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"春夜张宪副叔载宅饯别赵宪使子后赴大梁得游字","author":"谢榛","text":"春宵残月转西楼，醉听琴声别鹤愁。\n宦迹更堪燕市别，才名不负兔园游。\n中原赤子心仍切，北塞黄云战未休。\n华发应嗟勋业晚，行看击楫大河流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14938,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送刘水部致卿出守嘉兴","author":"谢榛","text":"孤馆别怀聊对酒，双旌行色复催人。\n马嘶燕甸才芳草，帆到江城已暮春。\n作赋水曹非往日，垂衣天子念征尘。\n三吴彫弊多忧思，不待秋风白发新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14939,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送林比部章之使南海","author":"谢榛","text":"迢递炎方数驿亭，更怜天外九疑青。\n织绡欲看鲛人室，鼓瑟还逢帝子灵。\n雨过羊城春浩浩，云连鲸海夕冥冥。\n看君飞棹乘流去，多少南冠问使星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14940,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}},{"title":"送陆比部汝成使闽中","author":"谢榛","text":"醉攀杨柳禁城东，别后芳樽不可同。\n日暮乱云迷远道，天涯孤剑倚飞蓬。\n任公台瞰江流近，大姥峰连海色空。\n虞帝好生当此日，遥知闽徼待春风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_2.csv","pointer":14941,"sha256":"ed4816f919f168ab037d2a481a87ac236867458ea2f19effc11ac858978991a3","dynasty":"明"}}]