[{"title":"晦日夜集","author":"薛蕙","text":"晦日归休晚，良游惜后时。\n却判长夜饮，更赋早春诗。\n云雾窗中入，星河阁上垂。\n何须花与月，行乐始相宜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9326,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春夜过时济饮","author":"薛蕙","text":"露净开樽处，天青岸帻时。\n素云将月上，香雾任风吹。\n为乐常苦晏，含情复待谁。\n径须成一醉，莫遣酒行迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9327,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"夏日游道观","author":"薛蕙","text":"隔竹窥丹洞，临池坐碧沙。\n玉拌盛石髓，翠笼贮云芽。\n展簟来风色，吹笙上月华。\n休论河朔饮，讵似醉流霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9328,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陈真人馆中赏荷花作","author":"薛蕙","text":"别馆瀛洲丽，新花菡萏香。\n红衣迷日色，翠盖写波光。\n雨过金塘湿，风生石槛凉。\n客来修竹下，回首见潇湘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9329,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江中四咏送黄日思韵限本题同诸公作 其一 江霞","author":"薛蕙","text":"春江变气候，孤屿发云霞。\n散影摇青草，流文漾碧沙。\n红泥迷燕子，丹洞失桃花。\n水宿淹晨暮，应怜谢永嘉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9330,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江中四咏送黄日思韵限本题同诸公作 其二 江云","author":"薛蕙","text":"谢客弄春色，江皋生綵云。\n纷纷初散绮，叶叶渐成文。\n蔽日皆相映，流风乍不分。\n何因可持赠，欲以慰离群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9331,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江中四咏送黄日思韵限本题同诸公作 其三 江花","author":"薛蕙","text":"百丈牵江路，行穿夹岸花。\n时怜一水曲，远爱数峰斜。\n林下见垂钓，溪边逢浣纱。\n武陵如在眼，髣像羽人家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9332,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"江中四咏送黄日思韵限本题同诸公作 其四 江猿","author":"薛蕙","text":"舟行转江峡，处处响哀猿。\n极浦云方合，连山雨正昏。\n接条时自挂，饮水复相援。\n不待三声尽，先伤游子魂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9333,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"六月八日西阙遇雨","author":"薛蕙","text":"窈窕西清内，参差水殿连。\n归云向平乐，飞雨集甘泉。\n明月裁班女，回风唱丽娟。\n龙池初望幸，来往木兰船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9334,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谒茂陵祀孝贞太后","author":"薛蕙","text":"一弃东朝养，千秋不复归。\n夜台长寂寞，月殿少光辉。\n野露栖金盌，山风动玉衣。\n茂陵多碧草，春日自芳菲。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9335,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"负郭","author":"薛蕙","text":"负郭茆堂小，临溪竹圃斜。\n山樽携野客，鱼网晒邻家。\n荒径封残雪，疏篱透晚霞。\n预思春到日，著处种桃花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9336,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"李子西送佛头青花得自永宁王宫中盖牡丹之殊异者喜而赋诗且改名为萼绿华云","author":"薛蕙","text":"故人真好事，为我致名花。\n书寄夷门道，春来帝子家。\n玉肌明素雪，翠袖影青霞。\n合避金仙号，更名萼绿华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9337,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"山亭","author":"薛蕙","text":"西圃禁垣东，凉生暑渐空。\n小池盈宿雨，丛桂易秋风。\n独鹤窥云际，幽兰思露中。\n来游行乐地，不惜醉山公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9338,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋夜","author":"薛蕙","text":"西园秋渐好，晚眺倚山扉。\n鹤语风生竹，萤飞月满衣。\n乍怜幽意惬，翻恨赏心违。\n延伫空林下，中宵独未归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9339,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观舞","author":"薛蕙","text":"妙伎出秦中，纤腰学楚宫。\n翠帷低舞燕，锦荐踏惊鸿。\n宛转歌相似，婵娟态不同。\n无因逃酒去，懊恼白头翁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9340,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"西斋","author":"薛蕙","text":"西斋休憩地，永日卧书帷。\n燕舞随风絮，莺啼集露枝。\n病因閒自疗，春与醉相宜。\n却悔牵行役，年来忽去兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9341,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"郭外","author":"薛蕙","text":"郭外平芜迥，溪边小径斜。\n客行迷野竹，莺语隔林花。\n多景每难遇，孤游还自嗟。\n佳期竟何许，脉脉向春华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9342,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬惟乔赠巾","author":"薛蕙","text":"野巾初著日，心赏竟朝曛。\n试正行窥水，从欹卧看云。\n坐翻嫌月露，出每避尘纷。\n顾影还相笑，风流愧使君。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9343,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"酬惟乔惠鹿","author":"薛蕙","text":"怜此园中鹿，君侯赠野夫。\n涂艰常近患，物俊益妨躯。\n林薮空相忆，藩篱坐自拘。\n忍甘充玉馔，愿为束生刍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9344,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"泛溪","author":"薛蕙","text":"避暑清溪曲，舟行路不穷。\n诗成孤屿上，酒尽夕阳中。\n绿竹含秋色，红蕖送晚风。\n归来就明月，移棹水云东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9345,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"紫薇","author":"薛蕙","text":"紫薇开最久，烂漫十旬期。\n夏日逾秋序，新花续故枝。\n楚云轻掩冉，蜀锦碎参差。\n卧对山窗下，犹堪比凤池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9346,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"北狩","author":"薛蕙","text":"秦皇巡海右，汉武幸关东。\n昔怅千秋迹，今看万乘雄。\n期门陈后苑，清道出离宫。\n雾绕旄头黑，尘翻豹尾红。\n天营屯斗极，御气下云中。\n射兽阏支雪，焚山瀚海风。\n系缨驱杂虏，载笔扈群公。\n此日燕然石，长刊北狩功。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9347,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出行四图为何燕泉先生作 其一 职方奉使","author":"薛蕙","text":"西域防胡日，南宫动使星。\n旧分双赤管，新佩一青萍。\n陇月传兵候，关云结阵形。\n千金收虎士，万马蹴龙庭。\n方略随封事，文章待勒铭。\n应嗤班定远，头白迟边亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9348,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"出行四图为何燕泉先生作 其三 太卿考牧","author":"薛蕙","text":"沙苑禁城隈，天闲十二开。\n欲脩群牧令，还倚列卿才。\n照野云千色，填山锦万堆。\n铸形珍汉阙，市骨笑燕台。\n大阅军容壮，横行虏阵摧。\n始知中国富，不假大宛来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9349,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"卧病贻友人","author":"薛蕙","text":"汉代无才赋《子虚》，病来空卧茂陵居。\n终年只学五禽戏，早岁浑忘三箧书。\n林下网虫悬堕叶，墙头蔓草落寒渠。\n日日思君欲乘兴，濠梁何处好观鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9350,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访孙世其叙饮","author":"薛蕙","text":"苑内银河垂袅袅，城边暗月上微微。\n不辞怀抱今宵尽，无奈宾朋此地稀。\n万里飘零同卧病，三年邂逅一沾衣。\n燕山楚水遥相望，目断天涯鸿雁飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9351,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"春阴","author":"薛蕙","text":"春阴日日春晴少，料得春晴春已归。\n竹里雄鸠嗔独语，池边乳燕喜群飞。\n炊烟冷落侵寒食，檐溜飘萧上裌衣。\n寂寂小轩宾客散，祗馀禅榻不相违。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9352,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠继之","author":"薛蕙","text":"长安城中不可留，风尘日日使人愁。\n上书解印我将去，拔剑出门君且休。\n五岳登临几两屐，三江来往一扁舟。\n东西南北好行乐，与尔相随万里游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9353,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"人日","author":"薛蕙","text":"晖晖晴日透帘帷，冉冉和风飏鬓丝。\n野老自倾田舍酒，故人谁寄草堂诗。\n即看梅柳春含早，预想莺花景不迟。\n旋鬻园蔬办家酿，剩拚酩酊艳阳时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9354,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"睡起","author":"薛蕙","text":"午梦初醒卯酒消，不知风雪已终朝。\n客来小阁聊盘礴，鸟散空园转寂寥。\n老境时时怀故旧，宦途事事愧渔樵。\n古人坚卧非无意，未必渊明为折腰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9355,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"落花","author":"薛蕙","text":"今朝捲帘坐，时见一花飞。\n不惜芳菲尽，春风稍稍稀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9356,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"城南梅开简友人","author":"薛蕙","text":"郭外新梅树，春风吹欲残。\n未能携酒出，幸为折花看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9357,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉同王浚川海上杂歌九首 其二","author":"薛蕙","text":"天鸡啼处夜生潮，东望蓬莱翠雾消。\n紫贝高为云外阙，青龙盘作日边桥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9358,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉同王浚川海上杂歌九首 其五","author":"薛蕙","text":"石门双阙入蓬瀛，日日惟看云雾生。\n白蜃吹霓晴后见，翠虬衔月夜中行。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9359,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"奉同王浚川海上杂歌九首 其六","author":"薛蕙","text":"海上三山倒影垂，风吹波动锦涟漪。\n云中对出神仙阙，地底双开日月池。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9360,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词十二首 其一","author":"薛蕙","text":"禁围处处锁名花，步障层层簇绛纱。\n斟酌君恩似春色，牡丹枝上独繁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9361,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词十二首 其九","author":"薛蕙","text":"红袖低回拂锦茵，玉颜憔悴掩罗巾。\n空房独对婵娟月，赖是嫦娥不笑人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9362,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"宫词十二首 其十","author":"薛蕙","text":"斗帐氤氲沈水烟，蛾眉那得带愁眠。\n镜中莫倚人如玉，枕上真成夜似年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9363,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪（五绝） 其一","author":"薛蕙","text":"流风回雪满蓬莱，绣幕珠帘万户开。\n内殿平明催设宴，玉京深处翠华来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9364,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪七绝 其二","author":"薛蕙","text":"绿水初冰百子池，飞花正满万年枝。\n君王夜醉瑶台雪，侍女冬歌白苧词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9365,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪七绝 其三","author":"薛蕙","text":"永巷沈沈夜漏稀，玉阶寂寂雪花飞。\n空持纨扇歌琼树，愁对银缸襞舞衣。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9366,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪七绝 其四","author":"薛蕙","text":"玉人燕国旧倾城，对雪临风更有情。\n镜里新妆争皎洁，檐前垂手学轻盈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9367,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"雪七绝 其五","author":"薛蕙","text":"宫里仙人字丽华，弦中纤指学琵琶。\n朝来白雪当窗立，一曲弹成《玉树花》。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9368,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"皇帝行幸南京歌十首 其三","author":"薛蕙","text":"建业城西江水回，千官遥望翠华来。\n天子双鞬悬锦带，近臣争上万年杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9369,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"皇帝行幸南京歌十首 其四","author":"薛蕙","text":"翩翩翠盖覆鸣銮，诏许都人夹道看。\n乐府尽歌杨柳曲，后车多著鵔鸃冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9370,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"皇帝行幸南京歌十首 其五","author":"薛蕙","text":"忆昔高皇定鼎年，钟山龙驭已登仙。\n八叶神孙因耀武，衮衣亲得拜陵前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9371,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"皇帝行幸南京歌十首 其六","author":"薛蕙","text":"燕姬玉袖抱箜篌，马上长随翠辇游。\n春来照影秦淮水，爱杀江南云母舟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9372,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"皇帝行幸南京歌十首 其七","author":"薛蕙","text":"淮水南边是狭邪，蛾眉临水折江花。\n日暮龙舟泊何处，玉床抛在五侯家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9373,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"皇帝行幸南京歌十首 其八","author":"薛蕙","text":"玄武湖中绿水多，君王日日爱经过。\n宫女能为荡舟戏，中官学唱采莲歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9374,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"一溪","author":"薛蕙","text":"一溪云水一渔夫，一曲沧浪酒一壶。\n笑指桃花问春色，武陵得似此间无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9375,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"戏成五绝 其四","author":"薛蕙","text":"海内论诗伏两雄，一时倡和未为公。\n俊逸终怜何大复，粗豪不解李空同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9376,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题空上人山房","author":"薛蕙","text":"古寺残冬倍悄然，老僧闭户独安禅。\n冰满瓶中无滴水，香消垆畔有馀烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9377,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"战城南","author":"李濂","text":"战城南，城南白骨高嶙峋。\n胡风四边来，冥冥起黄尘。\n但闻众鬼哭，不知何方人。\n有母倚闾，有妻捣衣。\n逢人问信，不见汝归。\n年年寒食，家家悲啼。\n有梦见汝面，无处寻汝尸。\n战城南，哀复哀，乌鸦暮徘徊，啄肠向林飞。\n颅箭无人取，惟有蚋蚁围。\n嗟哉戍边人，到此莫思回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9378,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"苦寒行","author":"李濂","text":"长安列绣衢，青楼是倡家。\n重闺隐鸳鸯，暖幕霏烟霞。\n密霰岂能入，回飙无奈何。\n紫貂邯郸儿，登楼拉双娥。\n赵舞《小垂手》，吴扬秀蛾。\n酒酣呼六博，枭采明如花。\n厌厌翡翠帐，冉冉春风和。\n笑问楼上人，今年寒讵多？","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9379,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"大堤曲","author":"李濂","text":"汉江游女花艳奇，靓妆连袂江之湄。\n人生不向襄阳去，宁信春风断肠处。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9380,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陇头水","author":"李濂","text":"陇阪郁崚嶒，征人望五陵。\n哀湍触石响，阴雾傍潭升。\n马饮秦时浪，狐听汉代冰。\n若非班定远，于此泪难胜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9381,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"沔阳秩满北上汉水舟中感旧书怀却寄污郡诸寮友","author":"李濂","text":"我本山海姿，躬耕嵩少阳。\n八岁学籀篆，十岁《急就章》。\n孺小不知难，欲升钟索堂。\n波磔竟无成，临池心内伤。\n十五慕神仙，翘首蓬壶乡。\n丹炉伏龙虎，金书授琳琅。\n虚拟九转熟，白日云霄翔。\n异人不我遇，徒怀三花香。\n十八学击剑，雄雌带风霜。\n芙蓉起并舞，云日无晶光。\n世方泰阶平，屠龙谁荐扬。\n夜夜双紫气，空射斗牛旁。\n二十为时文，读书梁王台。\n花迎书院发，河绕石梁回。\n忆昔杜高李，曾此弄金罍。\n壁间旧题剥，千年我复来。\n长歌海月落，摇笔秋云开。\n三冬碧岩宿，岑寂良可哀。\n郡吏捧檄至，乡闱罗髦才。\n扬眉下台去，敝袍挟风雷。\n滥冠群英选，北上黄金阶。\n春官扫南宫，侍臣下三台。\n鸣钟放玉榜，曲江浪徘徊。\n自揣疏蹇甚，敢厕金闺游。\n春风辞汉殿，虎竹分南州。\n南州古鱼复，水石清且幽。\n苍山抱境转，碧水环城流。\n凫鸥狎几席，渔火明亭楼。\n地偏罕逢迎，讼简多夷犹。\n昨构仕学轩，虚窗俯云洲。\n前植两奇松，后栽几红榴。\n双鹤如我友，飞鸣意相求。\n轩中列图史，芸架牙签稠。\n夕阳吏人散，窅然似林丘。\n垂帘夜独寝，花气侵衾裯。\n惭无紫霞分，欣有白云讴。\n济济沔诸生，时时到厅事。\n我非草玄翁，汝奚问奇字。\n朱弦振《大雅》，绛帷演《易》义。\n绿鬟两蛮奴，焚香知客至。\n禽鸟作喜声，主人有佳思。\n五月荷花舒，锦绮张南湖。\n二三美寮友，邀我聊欢娱。\n双旌出郡府，五马嘶江郛。\n行厨逐飞盖，翩翩登画舻。\n箫鼓放中流，风流倾上都。\n攀花照绿水，恍在冰玉壶。\n酒酣挥彩毫，意气吞荆巫。\n虽为风尘宰，颇类烟霞徒。\n百姓误怀惠，四郊贼盗无。\n所嗟鸿水虐，田畴生鳖鱼。\n矫制屡发仓，蒙恩两蠲租。\n呻吟变讴颂，尽道今有襦。\n化俗景文翁，卧阁怀汲公。\n弦歌遍井巷，而回邹鲁风。\n三年郡秩满，比奏明光宫。\n留滞感岁年，书考悲无功。\n朝发七泽南，暝过三澨东。\n矶花炤玉辔，屿草留青骢。\n父老荷杖送，奔走村塾童。\n挥手谢吾民，无劳远相从。\n顾我素餐者，何裨尔疲癃。\n扬舲下汉水，遂与沔人别。\n荆门沾细雨，郢岸逢初雪。\n鲛女近有无，茜蛛远明灭。\n夜宿芦花丛，霜月半轮缺。\n征雁双双鸣，闻之五情热。\n眷念郡中友，高斋旅愁结。\n东皋红梅枝，春来为谁折。\n伤离偶感旧，薄游计良拙。\n孤怀夙自许，初志那堪说。\n我作五字谣，字字表情血。\n去住各加餐，慎勿音尘绝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9382,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"田庐暮归作","author":"李濂","text":"朝游南郭墅，薄暮小车归。\n始识闲居乐，无言夙志违。\n入村逢酒熟，近圃惜花飞。\n不尽酣歌兴，孤城下夕晖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9383,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"送张鹄举巡抚榆林","author":"李濂","text":"锁钥边城固，储胥幕府闲。\n风声先上郡，烽火绝秦关。\n紫塞铙歌发，黄云猎骑还。\n侧知铃阁夜，梦绕殿东班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9384,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"许州赠颜守木","author":"李濂","text":"汝病三辞印，吾来两驻车。\n雪堂留倡和，秋榻共琴书。\n堕泪看归雁，谋身作老渔。\n行藏惭颇似，把袂各踌躇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9385,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋晓","author":"李濂","text":"鸡唱秋窗白，萧无一榻虚。\n开门残月在，梳发晓钟余。\n未得如鸿鹄，终羞作蠹鱼。\n此生吾已矣，落魄老樵渔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9386,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"村居","author":"李濂","text":"浮名除宦籍，初服返田家。\n腊酒犹浮瓮，春风自放花。\n抱孙探雀留客剪椿芽。\n无限村居乐，逢人敢自夸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9387,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题二首 其一","author":"李濂","text":"芙蓉为面玉为肌，当日君王恨见迟。\n十二楼台留兔魄，三千粉黛妒蛾眉。\n行云易散高唐观，落叶难平太液池。\n拟办黄金求作赋，长门心事长卿知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9388,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"无题二首 其二","author":"李濂","text":"为雨为云恨几重，楚台何处觅仙踪。\n开帘懊入双双燕，伏枕愁看六六峰。\n谩唱回风雕木叶，且将团扇画芙蓉。\n瞢腾甫作西楼梦，恼杀层城五夜钟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9389,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"当朝","author":"李濂","text":"当朝艺苑烂天葩，前辈风流擅大家。\n诗律总推高太史，文章谁继宋金华。\n未能云梦吞千顷，谩说图书诵五车。\n临楮自惭才思涩，几时重梦笔生花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":9390,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]