[{"title":"访僧不遇二首 其二","author":"陶益","text":"寄迹圭峰秋正中，飘飘衣带欲乘风。\n千章古木当人翳，禅室依然概是空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古樵白云歌","author":"陶益","text":"瞻彼樵苏云，出门天未曙。\n行行至山阿，云寒衣罽絮。\n弃囊倾浊醪，兼之祛百虑。\n既醉咏而归，不觉车马庶。\n息肩呼良朋，更衣求执御。\n偶见憩云人，气盈谁与语。\n白云白云兮居何处，变化悠悠兮自来去。\n万一不如云兮，繄有情而堪恕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"睡起","author":"陶益","text":"书签药裹久忘怀，惟爱閒云秋气佳。\n一阵松涛惊午梦，却疑风雨打山斋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"林氏廓然楼和吴刺史韵","author":"陶益","text":"江边临客棹，楼上聚奎星。\n酒酌莆阳绿，灯悬胆石青。\n留题惊海怪，恣赏忌山林。\n回首风潮起，村舂响未停。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访林明府旧里次韵","author":"陶益","text":"胆海鲸波伏，沙村蜃气开。\n居从云外出，路逐柳边回。\n李贺携囊至，王弘拥盖来。\n主人归便得，知近钓鱼台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送文惟高归郁林四首 其一","author":"陶益","text":"郁林姻戚得逢君，积岁乡心此夕勤。\n泪饮离杯藏烛跋，茑萝萦月白纷纷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送文惟高归郁林四首 其二","author":"陶益","text":"千里题书赠客行，悠悠鱼雁转含情。\n梧江桂岭秋风利，早晚能无寄数声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送文惟高归郁林四首 其三","author":"陶益","text":"萍踪宦海各茫然，忠节人家见汝贤。\n葵藿绿阴留万里，更宜向日上凌烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送文惟高归郁林四首 其四","author":"陶益","text":"关河饯送且停骖，西北云深鹤唳南。\n欲采芳荪谁寄取，赖吾群从总能堪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋月下怀郁林诸侄","author":"陶益","text":"迹苦江山滞，心悬骨肉求。\n况当明月夜，又是白云秋。\n不省袁宏艇，那知庾亮楼。\n更携诸小阮，欢对一林幽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"少年行二首 其一","author":"陶益","text":"仰天遥指挽丝鞭，索饮粗豪不计钱。\n立马树阴邻市散，据床犹咏叔于田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"少年行二首 其二","author":"陶益","text":"击剑呼卢酒半醒，雕鞍斜跨剪长亭。\n欲寻世路难穷趣，蒲海葱山一片清。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"双头红蕖","author":"陶益","text":"并蒂芙蓉出水中，丹霞翠雾拥帘栊。\n夜来又见双双响，疑是东坡竹影红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白莲欢","author":"陶益","text":"越女含羞出浴难，缟衣落尽曲雕栏。\n权将团扇偷相掩，祇恐横眉隔社看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭少铉谭兵宪","author":"陶益","text":"左江绣斧出师时，霜落遥闻失故知。\n却忆丛兰成独恨，还惊宿草动深悲。\n声灵异域犹能到，杖履名山不可期。\n泪洒椒浆聊一奠，断肠空复四愁诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谭大夫挽词","author":"陶益","text":"使节催秋日，良朋哭暮年。\n功名知有待，泉石惜无缘。\n世隔鱼书绝，家藏豸服鲜。\n束刍随执拂，为尔各凄然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜酌问菊因忆方山人","author":"陶益","text":"木叶今萧瑟，霜花近若何。\n樽前留一醉，篱下拟重过。\n剪烛幽怀切，敲棋逸兴多。\n招邀不相及，高士在岷峨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦访白鹿洞道人","author":"陶益","text":"白鹿悬新梦，黄冠恋旧情。\n烟霞犹驻足，鸡犬若闻声。\n唤酒调山药，搜松煮栗羹。\n微言今不忘，独是学无生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬少龄王使君","author":"陶益","text":"缁尘荏苒忆萍逢，燕柳隋堤别恨同。\n珍重远书骞玩永，萋迷深夜梦魂通。\n相期鼓柁湾黄木，更许移家上祝融。\n何自话归归未得，几回搔首叹冥鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜泊","author":"陶益","text":"平头雀舫雨初晴，弭棹移尊待月生。\n夜半斗牛涵海气，村前山犬吠潮声。\n寥寥野火开还合，远远渔灯灭复明。\n独忆青藜高阁砚，柘黄新卷点残更。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"庚午生日","author":"陶益","text":"老病幽栖小樾林，每逢生日思难禁。\n野芹自弄清清色，寸草空含恋恋心。\n旧摘黄花随黍酿，新传白雪对梅吟。\n年过半百吾何事，祇爱吾庐与素琴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏漱泉","author":"陶益","text":"涧谷泠泠溜石音，濠梁披豁越层阴。\n祇馀晒发閒无奈，更挹山瓢一洗心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏盘石","author":"陶益","text":"凿凿粼粼翠缕多，蒹葭遥隔枕江沱。\n叶声未到垂纶上，吞影鱼龙撼白波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"放浙鱼","author":"陶益","text":"浙鱼随意放江干，东望扶桑到不难。\n莫弄凤池蘋藻月，恐教长听玉声寒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"裹钓裘","author":"陶益","text":"重将袷絮浣清澜，结网灯前仔细看。\n补缀敢辞针脚冷，有人常是服无完。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与书家夜话","author":"陶益","text":"钟繇孟頫果何居，夜话闻君学有馀。\n坐惜流萤帘外去，不曾照得近时书。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"招隐词","author":"陶益","text":"登登山路何须忙，任率相留旧草堂。\n分叶煮泉日卓午，白云幽涧松花香。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"仲冬九日友人惠菊次韵","author":"陶益","text":"隆冬逢异菊，竟日想高人。\n学泛忘忧物，从更折角巾。\n狂吟方就错，兀傲已成真。\n此意云谁解，浔阳旧有邻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古别离二首 其一","author":"陶益","text":"萧萧芦叶黄，良人戍朔方。\n冉冉岁云暮，四野肃寒螀。\n褰帏露新月，拥褐有微霜。\n感此竟不寐，信是可怜伤。\n星言望天末，晓出问河梁。\n折柳差犹在，歧路靡或忘。\n何日胡尘灭，凤兮归故乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"拟古别离二首 其二","author":"陶益","text":"风生战马鸣，貂裘冷如铁。\n天子重边陲，壮士轻离别。\n挥剑战秦城，据鞍持汉节。\n日月忽已除，江山消积雪。\n梅花不堪折，闺中怀更切。\n佔毕写柔情，一行一哽咽。\n愿得大刀头，于焉袪郁结。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早出对雪三首 其一","author":"陶益","text":"水落云霾曙色微，冈城今见六花飞。\n翛然不作寻常路，欲就袁安一启扉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早出对雪三首 其二","author":"陶益","text":"觚棱梦破怯衣单，飒飒漉漉晓更寒。\n墙外步疑东郭履，自歌黄竹俪幽兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"早出对雪三首 其三","author":"陶益","text":"朝从岁事卜春华，逗岭垂檐尽玉花。\n沟浍未知盈尺否，背驴试问旧田家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10217,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"辛未元日书事","author":"陶益","text":"迎春喜是新元日，试笔惭非白雪才。\n柏叶未随杯斝动，梅花先傍砚池开。\n从官猎猎扬鞭过，舞伎翩翩拥索来。\n绮陌尘香游冶客，尽情檀板按歌台。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10218,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆灵隐寺雪岩静室二首 其一","author":"陶益","text":"色界虚悬万木封，暮寒谁动佛前钟。\n旧传鹫岭无烟火，幽僻曾经照烛龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10219,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"忆灵隐寺雪岩静室二首 其二","author":"陶益","text":"东林弟子接殷勤，雪煮团茶惬素闻。\n复说老师行道后，诗瓢流破剡溪云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10220,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"元夜观灯戏拟都人之作","author":"陶益","text":"社鼓声连玉漏长，星桥无禁得徜徉。\n春城火树生新色，夜市烟花簇异妆。\n月满天街弦管沸，风回辇路绮罗香。\n何人不数华胥事，故国相携乐未央。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10221,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春起以兰邀客","author":"陶益","text":"淑气初回睡癖残，端居尤得育幽兰。\n一花定拟开樽酌，并叶何妨促席观。\n蝶梦独疑无用作，鸥盟频绎未应寒。\n当春预引重游兴，纫佩垂垂数共欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10222,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"草堂漫述","author":"陶益","text":"居閒成惫懒，地僻寡交亲。\n著作难辞妄，模书易失真。\n苍苍苔叠砌，肃肃鸟窥人。\n门径榛方好，能消结驷尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10223,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日遣愁","author":"陶益","text":"虚阁晴光碧树留，操觚何处遣春愁。\n风尘迥隔帘帏静，世事稀闻几席幽。\n昔续茶经归陆羽，今题竹谱爱王猷。\n可堪更读闲情赋，欲寄相思不自由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10224,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"閒行口号","author":"陶益","text":"寻幽无伴郭边还，世故茫然一笑间。\n物议非由疏懒得，任从步屐到云山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10225,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"田方老马图为聂子追和文衡山","author":"陶益","text":"力破阴山雪，蹄穿塞草烟。\n微劳如见寻，垂老不须怜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10226,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题王生画春游小景","author":"陶益","text":"辋川烟雾碧漫漫，公子行春错意看。\n十里艳花连步骑，幽香疑亦在长安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10227,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"海珠寺晚晴期与胡僧泛月","author":"陶益","text":"凭虚遥望粤王台，潋滟霞光毒雾开。\n风定果闻飞锡去，夜凉应见弄珠回。\n绀园翳翳多修竹，碧殿阴阴半劫灰。\n欲结静缘沧海上，随流乘月说如来。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10228,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"粤台怀古","author":"陶益","text":"粤秀山前白昼阴，粤王台上独登临。\n城迷睥睨云烟响，殿敛罘罳薜荔深。\n汉将岂能留甲帐，淮夷那复赂南金。\n英雄事业终难料，啸向春风任陆沉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10229,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"褊性","author":"陶益","text":"褊性由来祇爱山，烽烟愁绝落城间。\n中宵清梦独依旧，半榻白云相对閒。\n懒学人前增态度，思求谷口听绵蛮。\n何当又见亡羊路，春草萋萋客未还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10230,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"银海钓台为赵君赋","author":"陶益","text":"坐对澄江静，垂纶自觞咏。\n凉风吹白波，菰蒲相掩映。\n高士不用名，眷言迹当迸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10231,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郑社丈馆三江寄怀二首 其一","author":"陶益","text":"别时言不得，别后望空频。\n最苦三江棹，来分一社人。\n春风谁独坐，夜雨底相亲。\n累月无音耗，摇摇忆子真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10232,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郑社丈馆三江寄怀二首 其二","author":"陶益","text":"篇章难自遣，弃置不堪论。\n迹滞空城路，情通隔水村。\n故人常看竹，稚子数迎门。\n准拟闻归计，倾囊办绿樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10233,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦观灯赋诗末联由俗物败意而罢醒后足之忆录以纪异","author":"陶益","text":"龙城缓漏艳阳天，士女欢随管与弦。\n一路月华扬白苧，千枝灯影缀红莲。\n传柑学窃名方朔，斗舞宣骄号小怜。\n梦里壮游空耿忆，牢将吟咏背窗前。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10234,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和诸父老喜晴四首 其一","author":"陶益","text":"连朝烟雾失山城，魑魅窥人不可行。\n薄暮倚楼生远思，是谁箫鼓动新晴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10235,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和诸父老喜晴四首 其二","author":"陶益","text":"云敛巫山洗碧天，月凉宴集小楼前。\n葛巾皂帽寻常过，关吏曾无索酒钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10236,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和诸父老喜晴四首 其三","author":"陶益","text":"凄风苦雨总堪伤，况复抽丁戍海旁。\n此际独疑人世异，扶锄遮路说农桑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10237,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和诸父老喜晴四首 其四","author":"陶益","text":"霁色遥瞻夺晚虹，冲星宝剑有雌雄。\n西邻东老能相访，共饮藏名酒肆中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10238,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张处士归","author":"陶益","text":"果谁能脱俗，常自爱栖霞。\n下榻留难久，回车望更赊。\n清歌贤宁戚，博识老张华。\n此后相思梦，知从处士家。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10239,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西庄泛觞吟 其一","author":"陶益","text":"西庄枕江侧，颇足供钓弋。\n莺扬上苑声，柳露章台色。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10240,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西庄泛觞吟 其二","author":"陶益","text":"知道早春回，欣陪上客来。\n脱屣坐曲岸，沿流命酒杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10241,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵答白云社诸丈时有应徵而出者因并奉怀","author":"陶益","text":"烟霞摇映五羊城，解佩曾于此结盟。\n绿野追随拚白发，蒲轮轸念为苍生。\n大贤别去空留迹，真隐从来不著名。\n复恐云山难遽定，年年常似有人争。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10242,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"倦坐","author":"陶益","text":"杮叶书馀日未斜，东风犹自恋窗纱。\n閒来隐几添慵困，满眼清香柚子花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10243,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"玄通馆见海棠","author":"陶益","text":"抱瓮玄园懒易消，惟嫌屏迹负渔樵。\n仙花似解扬云宅，故遣红妆慰寂寥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10244,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郡守戴公归隐二首 其一","author":"陶益","text":"皇华曾忆度梅关，鸡舌香含霄汉间。\n正羡文翁能作郡，那堪五马入名山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10245,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郡守戴公归隐二首 其二","author":"陶益","text":"行行慷慨辞车盖，切切攀留拥路旁。\n料有小山丛桂好，鉴湖应不数知章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10246,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"夜直新草堂","author":"陶益","text":"小筑向山尖，旁村路已添。\n贤人常欲至，象纬不劳占。\n树杪云连榻，藤梢月度帘。\n自惭惟偃仰，徒尔负书签。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10247,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送熊郡博之雷州","author":"陶益","text":"香芹流影碧参差，赋代凌云觉愈奇。\n倚马才名悬上国，飞鸿宦迹寄天涯。\n图书互拥催行色，冠盖相连及饯时。\n此别定应多雨露，雷门声动莫辞迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10248,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻破虏道上有怀","author":"陶益","text":"十年曾结客，千里正飘蓬。\n露布传将及，箜篌听未终。\n当垆留去马，倚剑望征鸿。\n中酒知狂甚，无端忆次公。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10249,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日寿刘社丈七十一","author":"陶益","text":"鲤鱼风洒绿筠庄，置酒相从控寿章。\n蓬矢昔曾期此日，海筹今又祝重阳。\n青筇出国谁争长，黄菊当筵晚更强。\n况复刘郎亲手种，崇兰丛桂满庭芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10250,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄楚萧蒙泉四首 其一","author":"陶益","text":"昔年驰逐五陵间，邂逅无因忆旧颜。\n湘水岳阳谁漫浪，书崖今已并元山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10251,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄楚萧蒙泉四首 其二","author":"陶益","text":"尘路匆匆对夕天，一封谋寄楚江前。\n顾予艺苑荒凉甚，空有怀沙是旧编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10252,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄楚萧蒙泉四首 其三","author":"陶益","text":"虚舟曾触洞庭秋，往事伶俜梦未休。\n知汝解题鹦鹉赋，好将系雁到南州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10253,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄楚萧蒙泉四首 其四","author":"陶益","text":"别去音书少得闻，秋来何处不怀君。\n眷然欲插凌风翅，与借衡山礼白云。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10254,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"馆中戏笔二首 其一","author":"陶益","text":"金风扇冷子云亭，蕉叶临池未变青。\n偃蹇不知当世务，抽毫思摹蕊珠经。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10255,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"馆中戏笔二首 其二","author":"陶益","text":"独板门深少客过，馀閒无奈野狂何。\n书成一片潇湘雨，又换园丁谷子茄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":10256,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]