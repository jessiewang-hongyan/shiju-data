[{"title":"寄欧子建邓伯乔二子","author":"李孙宸","text":"十年曾共理烟萝，白社青灯夜夜过。\n花满游堤春屐冷，酒残歌席暮钟多。\n谁将小草论生事，终自冥鸿谢网罗。\n目极白云天万里，瑶华何日寄沧波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29156,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何老师册封河南二首 其一","author":"李孙宸","text":"几载词林供奉中，皇华新跃五花骢。\n小山旧赋丛生桂，一叶新秋剪旧桐。\n路指岳灵瞻绛节，筵开淇水浥清风。\n梁园岂少邹枚在，授简何如上客工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29157,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何老师册封河南二首 其二","author":"李孙宸","text":"玉检金坭五色霞，词臣六月赋皇华。\n阁中乍别仙人杖，天上先占使者槎。\n紫气定知逢令尹，玄经曾否授侯芭。\n嵩高瑶草行边拾，能念公门桃李花。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29158,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送梁永连假归","author":"李孙宸","text":"与君同藉献长杨，燕市才名起雁行。\n半载旅怀兄弟遣，三秋归梦别离长。\n西山爽气虚游屐，穗石秋风待举觞。\n莫漫乡园耽胜赏，故人京洛正相望。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29159,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠杜日章总戎","author":"李孙宸","text":"千秋曾识杜当阳，望重征南奕叶光。\n何似承家新虎略，居然束发早膺扬。\n谈兵甲第开三辅，说剑星文动七襄。\n幕府词人多载笔，功成铙吹有新章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29160,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答黎有道","author":"李孙宸","text":"岭外论文自昔时，十年踪迹各天涯。\n青山旧业应怜我，白雪新篇好和谁。\n岁月易销燕市梦，烟霞犹负秣陵期。\n道傍肯信无知己，明月投来光陆离。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29161,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲寅元旦早朝诗二首 其一","author":"李孙宸","text":"禁苑春光引直庐，日华高捧紫宸居。\n风回辇道烟光绕，天应钩陈法象舒。\n鹓佩万年瞻斗极，龙颜何日御簪裾。\n小臣接迹夔龙后，愿拟冈陵颂九如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29162,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"甲寅元旦早朝诗二首 其二","author":"李孙宸","text":"柳外珂鸣紫陌尘，班齐玉笋拜枫宸。\n芙蓉露擢金茎晓，阊阖天开玉烛新。\n朔雪渐消梅萼暖，条风初入柏尊春。\n萧韶九奏传仙乐，曲度云中听未真。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29163,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿姜翼龙年伯六十","author":"李孙宸","text":"春曹当日几批鳞，主圣能宽折槛臣。\n湖海久便鸥鸟狎，云霄今起凤雏新。\n书传宛委窥灵笈，籍在华阳纪列真。\n不但宫衣誇戏彩，新恩求旧下蒲轮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29164,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送庄允元太史以赦诏奉使还闽过枣强受室郑明府","author":"李孙宸","text":"马首垂杨拂落晖，都门握别思依依。\n金鸡诏捧皇恩渥，玉署人归彩服辉。\n禁苑暂违鹓鹭侣，临卬重见凤凰飞。\n词臣交戟遥相待，莫恋清泉茗荚肥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29165,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送麦玄中司教潮阳","author":"李孙宸","text":"才名三绝冠词场，桃李新栽海国芳。\n虎豹藏时仍雾窟，凤凰栖处一鳣堂。\n西山别酒寒蝉露，南国归人早雁霜。\n莫道官贫高马骨，千金台上待飞黄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29166,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送欧刺史谪西粤别驾","author":"李孙宸","text":"旧识搴帷刺史贤，虔刀仍向粤江边。\n潘安拙宦头从白，欧冶新硎气尚悬。\n客路星槎浮桂水，署廉山色隔青莲。\n到来杂佩如堪赠，沅芷湘兰任意搴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29167,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同樊孟泰工部吴尔达进士集韩寅仲明府寓分得朝字","author":"李孙宸","text":"西山爽气到崇朝，佳会论心不待招。\n客路相逢几乡国，故人生计复渔樵。\n秋风华发搔逾短，夜色青萍醉欲骄。\n更续兰膏谈往事，浮沈吾亦任蓬飘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29168,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈督学转秩潮阳太参捧粤檄入贺赋赠 其一","author":"李孙宸","text":"文星岭外贯三台，为是呼嵩万里来。\n合浦采时珠在掌，燕山到日骏登台。\n陈诗别奏江南俗，献寿同沾湛露杯。\n咫尺新恩隆九列，无烦津吏候江隈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29169,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陈督学转秩潮阳太参捧粤檄入贺赋赠 其二","author":"李孙宸","text":"王气从瞻牛女墟，三年造士意何如。\n閒中几见收龙种，海上新传走鳄鱼。\n万国清秋来玉佩，九霄凉月集仙裾。\n知君献纳多金鉴，肯向淩云羡子虚。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29170,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠李皞如比部谪理彰德","author":"李孙宸","text":"五羊相接古端州，近有高人宦辙留。\n郁石已无归箧载，隋珠犹讶路人投。\n调追正始回风雅，迹任时趋唤马牛。\n此去西园飞盖地，风流千古旧应刘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29171,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送吴进士出宰归安","author":"李孙宸","text":"明光献赋羡青春，一出云霄便致身。\n治行词名君并擅，离怀羁思我难论。\n风清天目琴鸣远，花发苕溪制锦新。\n卧阁正堪娱彩笔，可忘鱼素问缁尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29172,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄民部逢一南归兼寄怀其弟逢永","author":"李孙宸","text":"惜别柳门共举鹅，客怀去住总茫茫。\n经年浪迹嗟萍梗，万里归人羡雁行。\n江上黄花晴带雪，故园梅萼暖含霜。\n燕山未隔怀人梦，驿使春来倘寄将。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29173,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋夜同林水部韩太史待月曾比部宅","author":"李孙宸","text":"三五蟾光隐玉楼，朋尊犹自惬清游。\n人从久客偏怜节，月似新寒不耐秋。\n重露暗飘青桂落，微云时傍远空收。\n坐深彷佛冰壶里，肯惜酬歌永夜留。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29174,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"立春前一日韩太史绪仲何进士卜熙黎山人不回过寓赏梅","author":"李孙宸","text":"东风吹暖腊梅知，索笑巡檐得几枝。\n春色共怜京国早，芳华犹比故园迟。\n含情易入仙郎梦，赠远长违驿使期。\n浊酒清灯聊此夜，催残寒雪又花时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29175,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何进士卜熙领教镇江","author":"李孙宸","text":"淩云奏罢气翩翩，还向江南领一毡。\n岂为清吟妨簿领，自便高座少攀缘。\n南朝景物春风外，北固云山晚照前。\n马首倘过官阁地，君家词赋有新篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29176,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送顾宗伯馆师得请归省四首 其一","author":"李孙宸","text":"春卿法座映三台，诏许宁亲拥传回。\n子舍白云吴苑近，关门紫气日边来。\n江鱼暖入桃花水，寿酒春分茎露杯。\n为问老莱当日彩，可能天上赐亲裁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29177,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送顾宗伯馆师得请归省四首 其二","author":"李孙宸","text":"秩宗初贰主恩偏，十载龙楼侍讲筵。\n手诏暂容归省日，绛帷同恋授经年。\n晓钟汉殿违仙仗，昼锦吴江返画船。\n任是庭闱多乐事，肯令黄阁负徵贤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29178,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送顾宗伯馆师得请归省四首 其三","author":"李孙宸","text":"倾都冠盖送仙舟，望望吴江匹练浮。\n绿野未教猿鹤喜，青霄旋待凤凰游。\n门前桃李阴初合，笼里参苓晚见收。\n魏阙江湖心更远，能无清梦绕宸旒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29179,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送顾宗伯馆师得请归省四首 其四","author":"李孙宸","text":"玉署清深隔俗尘，几回授简得相亲。\n千秋忝窃登龙客，短步空惭附骥人。\n秘阁藜光怜乍冷，北堂萱树羡长春。\n悬知爱日欢无限，曳履还看捧日新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29180,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"除夕感怀和韩绪仲先生韵","author":"李孙宸","text":"守岁孤吟坐寂寥，条风解冻未全消。\n八千道路归何日，四十年光逼此宵。\n休论作客踪难定，且喜看花兴不遥。\n柏叶倾残灯未烬，又随鹓鹭谒清朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29181,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈翔甫奉使便道归省","author":"李孙宸","text":"飞刍二月出王畿，喜借皇华觐省归。\n画省香含兰是草，白云心切彩为衣。\n花明驿路听莺过，风便征帆背雁飞。\n金马滞留归未得，梦魂随尔到渔矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29182,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"梦卜求贤","author":"李孙宸","text":"五色卿云灿陆离，黄麻宣诏出彤墀。\n天教岩筑调商鼎，人识熊车载帝师。\n玉烛乾坤皇祚永，金瓯名姓裔夷知。\n千秋鱼水非难事，丙魏同心又一时。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29183,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得山意冲寒欲放梅","author":"李孙宸","text":"久向严寒忆旧芳，空林摇落几经霜。\n枝疑斗雪将春早，山为迎阳著意忙。\n结实未论调国鼎，含情先遣报东皇。\n上林次第阳春色，白雪谁应儗和章。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29184,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赋得秋声一雁飞","author":"李孙宸","text":"绿水晴沙两岸明，碧空如洗暮云轻。\n长天远写衡阳影，静夜孤传芦渚声。\n月冷湘灵和鼓瑟，风清缑岭叶吹笙。\n不堪久客还闻汝，欲赋悲秋拟宋生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29185,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青门祖帐","author":"李孙宸","text":"丝纶十载代龙楼，万国安危掌上筹。\n剑履暂违仙仗月，菊松初问故山秋。\n歌来羽翮飞鸿鹤，恋向沧波狎白鸥。\n回首同心还魏丙，肯从圣世傲巢由。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29186,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"阅辽左边图","author":"李孙宸","text":"边城万里开雄镇，百二关河拱帝京。\n牧马未容胡虏入，椎牛谁奋健儿情。\n天清瘴塞烽烟急，日落西山野戍横。\n正是圣明思颇牧，几人年少请长缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29187,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过白沟河","author":"李孙宸","text":"一路风光媚眼新，红亭绮陌送征轮。\n暂从紫禁宽休沐，渐识青山是故人。\n云暗白沟迷古渡，风寒易水隔遥津。\n觉来似醒邯郸梦，欲谢长安一片尘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29188,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过楚项故都","author":"李孙宸","text":"驿馆萧萧万壑中，停车千载问雄风。\n草深古戍行人少，木落荒台巢鸟空。\n烟雨尚怜迷楚渡，火云犹自恨秦宫。\n酒酣一笑俱陈迹，矫首鸿沟有断鸿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29189,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冯茂山谒五祖 其一","author":"李孙宸","text":"西来五叶法初南，遗蜕千秋尚在龛。\n心到空时真不二，教从归处更无三。\n山前香雾长疑雨，林里幽花并是昙。\n京洛悠悠成底事，何如此地一皈参。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29190,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"冯茂山谒五祖 其二","author":"李孙宸","text":"扪萝散步拾阶登，路转山庭始见僧。\n龙去尚留听偈石，台荒空长护经藤。\n雨声半入山泉泻，雾气潜消海日升。\n行役冲炎真火宅，登临聊此濯清冰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29191,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过吉水同袁文学及族叔于垣饮温尔弼明府私署","author":"李孙宸","text":"官署萧森吏亦仙，坐来真惬薜萝缘。\n筵开深径消炎署，山隔春城送晚烟。\n乡味渐偿莼鲙思，客怀欢藉竹林贤。\n更闻中夜袁郎曲，何异吴江月下船。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29192,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送何似公伍国开就省试","author":"李孙宸","text":"荒径初归秋气清，送君羽翮又南征。\n马蹄十里槐风趁，兰楫三江桂月明。\n赋就黄金生顾盼，梦中彩笔竞纵横。\n北山莫漫惊猿鹤，上国春林待早莺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29193,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初冬与仁伯代骧弟寓濠上馆有梅一株初露微蕊独一花先放娟好特甚因忆故乡梅园寄怀伍国开兄弟","author":"李孙宸","text":"嫩蕊枝枝总待时，一花何意报春姿。\n风摇隔叶浑难见，月映当帘巧自窥。\n欢赏转怜时序改，行吟犹喜弟兄私。\n故园万树今开否，应有驼山旧主知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29194,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭黎君献","author":"李孙宸","text":"艺苑风流几代兴，君才济美自家承。\n祇怜异地分雄剑，不谓垂天失大鹏。\n侠少有人传草练，酒场无客问如渑。\n诃林寂寞莲花社，邻笛听残涕满膺。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29195,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同马伯起及仁伯代骧两弟过梁明叔禅悦斋","author":"李孙宸","text":"森森萝径引纡回，三载寻盟许复来。\n篮举每从花外转，笔床多在竹间开。\n当尊客爱逃禅醉，挈弟人惭梦草才。\n对此风光那可负，分题休畏暮钟催。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29196,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭黄逢一","author":"李孙宸","text":"薄游曾共帝京尘，前后三年各乞身。\n一见岂知成永诀，相期疑是有前因。\n鹤飞尚儗归华表，龙跃何年返剑津。\n云路赏音流水绝，孤琴虽在不堪论。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29197,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乙卯冬何龙友北上卒卒未及一言为别嗣得其度岭书赋此寄之","author":"李孙宸","text":"浪迹归来恋古欢，故人天路促征鞍。\n驼山客去梅初浅，庾岭书回雪未残。\n价重千金高自许，名收片玉倚谁看。\n清时事业凭君在，饶得东山老谢安。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29198,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寻梅罢归酌伍国开白燕池亭得芬字","author":"李孙宸","text":"薄暮怜欢手重分，山含落照尽成文。\n园寻白燕当年地，沼问笼鹅旧日群。\n淡月疏钟人共倚，冷风静夜酒微醺。\n深谈真惬如兰赏，不辨山梅入座芬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29199,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"欧子建见访","author":"李孙宸","text":"衡门斜枕碧溪流，有客重停访戴舟。\n别后尺书南北泪，尊前双鬓古今愁。\n当杯黄鸟如相约，移席浓阴也解留。\n脱粟故人知不薄，交情如水十年投。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29200,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"潘澹明侍御见过江村于伍国开宅夜饮次早迹之已解缆去矣赋寄","author":"李孙宸","text":"久从门下识潘安，得及云霄接羽翰。\n夜静星辰回笑语，晓来风雨失追欢。\n三春花事幽居过，四海波涛宦计难。\n无恙江村双桨在，可能重与采芳兰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29201,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄送何卜熙同年由镇江教授之任国子","author":"李孙宸","text":"三载同看上苑花，羡君宦况带烟霞。\n东方已待金门诏，董相还披绛帐纱。\n六馆秋清悬授简，中泠雨歇忆煎茶。\n相闻敢忘弹冠意，暂借衡门傲岁华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29202,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄黄进士","author":"李孙宸","text":"捷书飞报粤江干，彩笔纵横剑气寒。\n燕馆旧惭虚市骨，南溟今见起飞翰。\n上林肯后春花赏，藜阁应分夜火看。\n共是郑庄门下士，临风能不念弹冠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29203,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和何似公登小金山妙高台见怀","author":"李孙宸","text":"问法闻登江上台，长江自度岂浮杯。\n月临初地看无色，水落潮音听转猜。\n念我肯停浮白兴，怜君犹为踏青来。\n便期出世宁容晚，共觅莲花大地开。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29204,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻毛康侯何洁卿何龙友下第寄怀","author":"李孙宸","text":"淩云虚道动君王，病渴相如复在粱。\n眉黛未能容淡扫，市门纷自倚红妆。\n正怜归雁音书渺，犹忆思鲈客计忙。\n一任道傍多按剑，握中无恙是珠光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29205,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"丙辰初秋六夕何似公伍国开有开同诸弟过集小楼","author":"李孙宸","text":"静夜凉秋欲雨时，共怀幽兴借佳期。\n未从机石窥灵匹，且喜风林待妙词。\n几处针楼人并倚，阿谁银汉独相思。\n狂来搔首青天外，曙色星河到槛垂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29206,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"七夕与国开诸子夜坐分赋","author":"李孙宸","text":"凉风七夕觉秋多，牛女佳期竟若何。\n灵媛共传先夕会，星桥曾待此宵过。\n白云天外谁骑鹤，清月楼头客放歌。\n不用更窥银汉影，溪流当户接明河。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29207,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄李秘书","author":"李孙宸","text":"都门两载各酸辛，无恙升沈信此身。\n旅况共怜官似水，交情真见德为邻。\n欣闻凤诏恩波渥，俄道皇华使节新。\n一水盈盈非远道，怀人空自采江蘋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29208,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王总戎镇粤与予未晤比解官归以书见存赋此送之","author":"李孙宸","text":"十年坐镇识轻裘，百粤安危在运筹。\n横海阵成鱼鸟夜，故园书到菊松秋。\n画麟阁自千秋见，赤舄言从四国流。\n独恨论文尊酒负，暮云天外思悠悠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29209,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送黄与东司理南宁","author":"李孙宸","text":"莲社三年隔古欢，一星遥望法为官。\n土风粤徼犹乡语，山色苍梧似画看。\n雷雨作时天欲解，阳春歌罢雪仍寒。\n汉庭治郡君家事，相府功名晚未难。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29210,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"因同年王简之任福清寄呈叶老师 其一","author":"李孙宸","text":"王言早晚代如丝，十载艰危独相时。\n遇巷不因中掖阻，回天宁遣外臣知。\n黄扉业就夔龙远，绿野人归猿鹤私。\n闻道圣明方侧席，未应长与赤松期。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29211,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"因同年王简之任福清寄呈叶老师 其二","author":"李孙宸","text":"冥鸿天外杳难攀，天上犹悬曳履班。\n共识晋公闻外国，几时安石起东山。\n形图画阁麒麟里，家在仙人烟雾间。\n云汉望来知有路，乘槎应儗客星还。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29212,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"因同年王简之任福清寄呈叶老师 其三","author":"李孙宸","text":"倾都祖道忆当时，怅望贤哉帝者师。\n任是凤翔应览德，肯教鸿渐遂为仪。\n天清阊阖云霞远，花发平章岁月移。\n蒿目时艰忧不细，知公后乐意迟迟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29213,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"因同年王简之任福清寄呈叶老师 其四","author":"李孙宸","text":"竹松三径自萧森，丞相堂开绿野阴。\n赐得鉴湖初有宅，散来酒会已无金。\n閒看倦鸟还林翼，更想归云出岫心。\n天下安危身系久，老臣那便入山深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29214,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄萧玄圃少宰学士 其一","author":"李孙宸","text":"后乐江湖岁月新，宣麻早晚出枫宸。\n千秋业自看钟鼎，一代人今仰凤麟。\n归去欲寻彭泽隐，悟来聊现宰官身。\n东山正系苍生望，未许漓江老钓纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29215,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄萧玄圃少宰学士 其二","author":"李孙宸","text":"十载论思侍禁垣，更参钧统望逾尊。\n贤劳暂许休元宰，徵诏行看起特恩。\n名自云霄惭骥尾，人从桑梓望龙门。\n卢傲那得天师遇，稽首临风乞妙言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":29216,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]