[{"title":"余桐封之役将出都门余士翘以谒选来余候命留滞士翘补官司教北流乃先余行怅然赋此","author":"韩日缵","text":"君来谒选我思归，同在金门赋式微。\n我滞剪桐秋欲老，君栽秾李雨初霏。\n北流应逐三湘远，南徙先分一雁飞。\n不是孤尊今恋别，离心直伴到亲闱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28376,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵和夏濮山侍御园亭 其一","author":"韩日缵","text":"结庐地近紫宸居，玉室雕窗碧简书。\n古柏亘连温树密，玄亭宽借御园纾。\n但将公事朝参了，不遣台倌簿领馀。\n迟日起看衣襘映，辚辚门巷过轩车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28377,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵和夏濮山侍御园亭 其二","author":"韩日缵","text":"即于闹处成幽胜，岂为忙时废赏心。\n试看官斋凉似水，不妨翰墨拥成林。\n兴来搦管呼红友，倦去移床就绿阴。\n但使清时宽主圣，从君散帙且高吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28378,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵和夏濮山侍御园亭 其三","author":"韩日缵","text":"虽云日涉能成趣，忆伏青蒲出每迟。\n北斗阑干焚草候，南薰宛转倚床时。\n经旬自曝藏书笥，几首人传即事诗。\n坐爱山容聊拄笏，朝来爽气恰心知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28379,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵和夏濮山侍御园亭 其四","author":"韩日缵","text":"薙草芳亭才数耜，垂萝曲径自何年。\n衙参放后供长日，鼙鼓喧闻忆远天。\n坐对烟鬟香共袅，醉摇霜管树还娟。\n端居亦有时移感，鸟哢莺啼唤柳眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28380,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄李斗野中丞 其一","author":"韩日缵","text":"逍遥岩上几崚嶒，历险攀跻老境能。\n山水一区幽筑好，西南半壁拥旄曾。\n身经五帝冠初挂，家有玄孙膝可凭。\n对酒不妨呼野叟，篝车共说岁年登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28381,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄李斗野中丞 其二","author":"韩日缵","text":"辞镇归来意转酣，秀眉徵寿更毵毵。\n精神比鹤应还健，世局如棋已熟谙。\n细辨蝇书临月砌，閒携鸠杖破山岚。\n独馀忧国心犹热，群盗干戈思不堪。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28382,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和罗仙翁韵","author":"韩日缵","text":"早断尘缘我丧吾，金梯飞步有修途。\n卧云自草二山记，洗砚亲摹五岳图。\n挥手虹旌宁是幻，托身石火信为愚。\n骖鸾驷鹤清霄外，看尽沧桑眼不枯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28383,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"对雪","author":"韩日缵","text":"禁殿才颁祈雪诏，忽看瑞雪入檐赊。\n压来竹坞枝枝玉，飞入芸窗字字花。\n夜色映签还对帙，涛声试火自倾茶。\n閒来预拟丰年颂，愿续繇庚与黍华。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28384,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬戌夏五予承乏乐安王封使会秦藩陈乞非例礼臣执争抗累十疏至新历已颁旧封未遣幸上意转圜于圣节前获奉俞音廷遣就道恭纪 其一","author":"韩日缵","text":"御历新颁岁欲徂，分茅四国望仍孤。\n空烦补牍臣为咈，喜见从绳帝曰都。\n日下无彊申祝颂，殿中有制已传呼。\n近臣此际辞供奉，带砺衔将玉诏敷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28385,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬戌夏五予承乏乐安王封使会秦藩陈乞非例礼臣执争抗累十疏至新历已颁旧封未遣幸上意转圜于圣节前获奉俞音廷遣就道恭纪 其二","author":"韩日缵","text":"趁班五夜候晨扃，分遣行占使者星。\n会向彤庭亲授节，且于讲幄辍横经。\n回天幸赖惟诸老，捧日从兹远御屏。\n欣值呼嵩来禹服，共瞻止辇祝尧龄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28386,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"行次安肃冒寒卧病又值騄儿痘友人赵裕子为治药饵俱获瘥赋此志谢","author":"韩日缵","text":"衔命冲寒事远征，那堪二竖苦相萦。\n病躯正欲停骖候，羁客仍馀舐犊情。\n服饵祇应需药物，梦魂空自计王程。\n客途留滞偏多感，犹幸风尘得友生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28387,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至日留安肃署中","author":"韩日缵","text":"为问朝衣夜向晨，王程留滞动经旬。\n人间添线怜贫女，天上传餐赐近臣。\n预遣荔生能应节，即防柳弱欲偷春。\n应知晴日无云物，肃望分明见北辰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28388,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题赵州柏林寺古壁画水","author":"韩日缵","text":"万顷沧波古壁深，霏霏烟雾散丛林。\n自应神物能长护，疑有蛟龙时一吟。\n澎湃即堪纾远目，清漪聊借涤尘襟。\n凭将造化丹青手，好与行云施作霖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28389,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"临洺驿","author":"韩日缵","text":"突兀雄关护帝京，新从洺洛问西征。\n朝行霜坂寒方冽，夜听风林怒未平。\n拥传一时看络绎，驱车到处有逢迎。\n不烦邮吏忧疲累，闻道齐东已罢兵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28390,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题汤阴署中竹石亭亭前竹才数竿石颇奇胜嵌空玲珑岩壑傋具北来所仅见也","author":"韩日缵","text":"暂憩孤亭翠色侵，凭栏聊欲散幽襟。\n石如称丈还堪拜，竹或成孙尚可寻。\n回互一拳能竞秀，檀栾几个自为林。\n何如把臂淇园上，坐对太行万壑阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28391,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"汴梁对雪","author":"韩日缵","text":"道傍树树是瑶华，况复新晴色转嘉。\n幸自照来梁苑月，若为看去岭头花。\n调高难拟枚乘赋，兴到聊烹学士茶。\n不忝我曹仙作吏，琪林步步伴征车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28392,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱仙庙","author":"韩日缵","text":"朱仙水庙白云埋，萧飒松杉雪满阶。\n汴水至今悲铁骑，翠华千古怨金牌。\n未论报主身难赎，但道和戎事已乖。\n异代孤忠还皎日，兴嗟遗迹思无涯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28393,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"晓行","author":"韩日缵","text":"且喜晨装值霁朝，戍楼晓角促征轺。\n冻含馀雪千门树，寒耿疏星十里桥。\n已迫腊残乡国远，乍惊霜入鬓华凋。\n那堪病骨还行役，兰桂山中早欲招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28394,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"轺中即事","author":"韩日缵","text":"今年冬日煖风饶，莫道征途太寂寥。\n竹老尚留含冻叶，柳残亦舞惹烟条。\n冲泥不避粘梅片，踏雪须防损麦苗。\n腊意争如春色好，长嘶班马亦萧萧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28395,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"途次遣怀","author":"韩日缵","text":"岁暮宁辞道路艰，雪中梅柳雾中山。\n侵晨拥节过星渚，向晚鸣驺度月湾。\n渴睡痴僮频慰劳，新瘥稚子任骄顽。\n嬴躯更值风霜厉，衰飒无嫌两鬓班。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28396,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"樊孟泰学宪客死黄梅余过之悽然有感","author":"韩日缵","text":"西泠掩涕读遗编，此日经过更惘然。\n未到三湘先赋鵩，虚占八桂有衔鳣。\n曹溪人去传衣地，鲁国经成绝笔年。\n凄断江天云漠漠，招魂拟续楚骚篇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28397,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"小岁日行从","author":"韩日缵","text":"冢家爆竹物华殷，客子驱驰不暂閒。\n道远八千逢小岁，年过四十有衰颜。\n颂椒辞腊情偏懒，踏草探春兴未悭。\n节煖故园花信早，王程何日问刀环。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28398,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"壬戌除夕与赵裕子客署守岁","author":"韩日缵","text":"艺苑当年尔擅名。\n他乡就我此宵情。\n曾辞粤徼八千里，不受秦关十五城。\n柏叶满斟消客况，兰缸共对数归程。\n星河耿耿檐楹外，欲待春还坐到明。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28399,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"正月二日憩双城驿","author":"韩日缵","text":"何来觌面是青山，才入停骖意便閒。\n驿舍元为车马地，烟岚亦到户庭间。\n南鸿北燕朝仍暮，腊意春容去复还。\n诸佛道场苍翠里，菩提无树可能攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28400,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"黄梅山行望诸佛道场","author":"韩日缵","text":"才过前山复有山，春山今尽变春颜。\n山峦太复还遭厌，春意伤繁便可删。\n任说传衣徒有著，更言无树亦空顽。\n大乘妙谛应无尽，欲叩宗门杳蔼间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28401,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸亥春日再游禺峡怀朱惟四","author":"韩日缵","text":"磴道回盘出薜萝，重来已是两年过。\n山藏古刹青无恙，水倒春林绿更多。\n野鸟窥人疑旧识，岩花照眼有新柯。\n山中人去山门寂，揽胜其如胜地何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28402,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题冯若符小像","author":"韩日缵","text":"有客丰姿疑静者，挥毫况复擅风雅。\n崛强笔势龙蛇腾，狂逸诗情溟渤泻。\n扫尽千军力更雄，才倾一盏颜如赭。\n罗浮山顶待镌铭，拉尔同眠见日下。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28403,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"佐礼南都闻命改北将发二律 其一","author":"韩日缵","text":"孤臣南国奉陵祠，忽拜新恩自玉墀。\n四入容台仍故秩，三逢圣主荷殊知。\n夷夔异代余非据，礼乐中兴今固时。\n弓剑千年遗迹在，徘徊丰芑有馀思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28404,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"佐礼南都闻命改北将发二律 其二","author":"韩日缵","text":"一官还自帝京移，岁晏濒行叹路岐。\n望阙循陔情并切，回车叱驭欲何之。\n况逢严命趋朝日，正值慈帷介寿期。\n锡类圣恩知不匮，兼程躬上紫霞卮。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28405,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿年嫂曾恭人七十又一","author":"韩日缵","text":"帘庭昼永乐依然，寿酒新开白玉筵。\n雨露九霄天锡诰，春秋七帙海添年。\n膝边兰桂和丸后，柱下风霜举案前。\n宝婺腾辉今正朗，仍如法曜彩相鲜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28406,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"陆贞姑者陆味道太守之姑也适冯早寡无子阿翁冯参知以幼女命贞姑抚焉参知以女字太守诏旌贞姑节以大守诸也为纪一律","author":"韩日缵","text":"蕙质松心阅岁年，新看棣萼露华鲜。\n歌残黄鹄怜垂白，疏叩丹墀赖阿玄。\n棹楔恩光金阙下，门楣喜气玉台前。\n高行直并秦峰峻，彤管千秋可续编。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28407,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"颜司李岭海风清册","author":"韩日缵","text":"百粤平反望抗旌，法星遥傍五羊城。\n青山坐对桁常卧，丹笔行吟草欲生。\n为李三年神与质，敷棠四野政初成。\n最闻伫看徵书下，不愧西京汉吏名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28408,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张孟奇太守余士翘何邦藻二明府谢绍程车君远二茂才携酒过二馀堂即席赋谢","author":"韩日缵","text":"炎天雨后涨新澜，佳客携尊月欲团。\n投辖几人兰佩合，绕梁一曲酒杯宽。\n清言共拟占星聚，斗伎还堪卜夜看。\n河朔兴酣犹未惬，更邀明日尽馀欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28409,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西园公非水居成招饮同泛以近体二律代柬次韵奉和 其一","author":"韩日缵","text":"榕水初晴涨合流，相将鼓棹绿蘋洲。\n采花蝶傍新枝戏，听曲鱼依浅濑游。\n老去健姿同野鹤，閒来逸性狎江鸥。\n停桡更有含情处，明月半帘人倚楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28410,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"西园公非水居成招饮同泛以近体二律代柬次韵奉和 其二","author":"韩日缵","text":"佳筵放舸傍渔矶，解佩芳洲此会稀。\n槎汎似从天汉去，兰薰疑自洛川归。\n凭将绿水开耆社，为采玄芝赠宓妃。\n欲赋閒情思不就，洋洋且与乐忘饥。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28411,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"余自秣陵奉慈讣奔归孙燕诒闵士行林茂芝诸子送我秦淮之上余既除服诸子寄秦淮折柳册至赋此志谢","author":"韩日缵","text":"尺书传到岭云陲，却忆秦淮握别时。\n霜树鸟啼声哽咽，秋江鹢退羽参差。\n钟山霞起堪裁赋，粤獥风凄久废诗。\n忽枉新篇如锦灿，六朝遗藻在今兹。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28412,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"姬命侄拉同社林六长至自秣陵赋此志喜","author":"韩日缵","text":"几年侨寓凤凰台，献赋依然被放回。\n痴叔未廑明主问，同人喜共阿玄来。\n棹移燕子矶头月，装带庾公岭上梅。\n镇日柴门无剥啄，凭君一为破莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28413,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"姬命侄送双白鹤兼五言近体四律赋谢一章","author":"韩日缵","text":"忽遗双鹤草堂前，玩鹤兼吟送鹤篇。\n警露飏时沧海阔，在阴鸣处九天传。\n未看刷羽凌霄汉，且听流声入管弦。\n鸡树凤池应待汝，繇来仙种自芝田。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28414,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"六长林丈偕犹子姬命至自秣陵枉诗为赠赋谢一律","author":"韩日缵","text":"轩轩韶举美仍都，负笈行游亦壮图。\n燕子矶头江月净，粤王台畔岭云孤。\n君来喜共阿戎语，我见频将小友呼。\n倒屣不妨时问字，门前三径未荒芜。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28415,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"双鹤 其一","author":"韩日缵","text":"尝读浮邱石室文，胎仙变化气氤氲。\n慈恩塔里曾题句，阿阁巢中亦并群。\n九转丹成鸣中律，千龄翮就举翔云。\n双飞隔雾相呼切，缥缈蓬山路不分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28416,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"双鹤 其二","author":"韩日缵","text":"仙质来从十二城，接翅联翩戏太清。\n自隔蓬瀛思旧侣，但逢云水称閒情。\n意慵不羡承轩宠，卧稳宁惊滴露声。\n竹下松间栖亦得，抟扶莫问九霄程。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28417,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"双鹤 其三","author":"韩日缵","text":"徘徊阶下去仍还，清响遥传碧落间。\n曾伴裴公栖紫阁，更从处士放孤山。\n风标玉立凝霜洁，朱顶砂明映日斑。\n刷羽非无霄汉意，幽情但爱主人閒。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28418,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"双鹤 其四","author":"韩日缵","text":"昂藏风格自翩翩，万里三山不记年。\n雪翅喜从莎径舞，霜衣偏向月阶鲜。\n音调玉轸如相叶，影入朱袍更可怜。\n仙骨肯为人近玩，直须跨去步轻烟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28419,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"咏槐示儿辈","author":"韩日缵","text":"绿槐手植间脩篁，欲待成阴故列行。\n讲业曾依博士市，诒谋应念晋公堂。\n但于叶候空偷荫，直待花来始著忙。\n敢望庭前皆玉树，清时莫遣负年芳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28420,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"乐安王招饮滕王阁赋诗见赠即席次韵","author":"韩日缵","text":"醴筵高阁月如圭，大雅河间未可齐。\n帝子奎文辉玉叶，王人荡节出金闺。\n茅分南浦周封重，露浥西山汉殿携。\n共庆新恩欢拜舞，还歌天保遍群黎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28421,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"余出山之次日江上遇韩孟郁陈治甫李烟客朱惟四曾文卿来游罗浮投诗为别奉答一章","author":"韩日缵","text":"朱明洞口卧蒿莱，几载迟君破绿苔。\n万里祇今随檄去，千岩恰值探奇来。\n我将捧日乘龙会，尔自飞云驾鹤回。\n南北临岐深惜别，留欢江上且衔杯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28422,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦雨 其一","author":"韩日缵","text":"欲消烦暑涤尘襟，昏雾那堪十日阴。\n骤洒犹将书喜雨，奔倾旋复赋愁霖。\n冯夷欲洗佳兵气，闾左翻怀及溺心。\n为问霁云无处所，青畦已没碧茸深。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28423,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"苦雨 其二","author":"韩日缵","text":"猛雨顽云气势骄，奔涛万室叹飘摇。\n霪霖已觖三农望，惊湃还虞九陌漂。\n安得电光驱黑蜧，更烦雷部扫幽妖。\n分明天意开平治，洚水还将儆帝尧。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28424,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题花源鹤算册为明府兄寿 其一","author":"韩日缵","text":"门巷依然五柳风，阶前玉树正菁葱。\n发如老鹤霜翎白，颜借蟠桃醉瓣红。\n得句诗题慈塔上，问津人是武陵中。\n卜年欲效如冈祝，笑指罗浮四百峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28425,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题花源鹤算册为明府兄寿 其二","author":"韩日缵","text":"蠹简芸编手不停，年过七十尚囊萤。\n閒随月砌寻花谱，静扫烟窗著鹤经。\n色变玄时翎更健，红如锦后叶偏青。\n千年若集玄都树，谁识胎仙旧姓丁。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28426,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题花源鹤算册为明府兄寿 其三","author":"韩日缵","text":"远携双鹤自宁馨，为到花源趋鲤庭。\n度索山头桃几熟，雷门鼓内响堪听。\n成胎端合归缑岭，结实还须问岁星。\n调鹤品花皆乐事，大年何羡楚冥灵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28427,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"雨雹","author":"韩日缵","text":"秋入南荒暑未清，乍闻雨雹拂阶声。\n岂缘阴协徵先见，漫拟阳愆气积成。\n抛掷疑从蜥蜴吐，坚凝不让水晶明。\n为祥可以熙宁岁，豫告番戎指日平。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28428,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄题林六长吸江楼","author":"韩日缵","text":"浮家非水似舟居，凭槛澄江澹碧虚。\n时有远帆来几席，分明隔浦见樵渔。\n窗中山色能深浅，波底云光亦卷舒。\n有客到门閒剥啄，多应跨鹤与骑鱼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28429,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"林六长过止园夜酌有诗见投次韵奉答","author":"韩日缵","text":"閒日还宜对酒销，荒园扫径喜相邀。\n花因娱客和烟湿，云为催诗挟雨骄。\n兴到尚能呼五白，病馀今亦饮三蕉。\n欣来白社同声侣，丛桂山中不待招。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28430,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"重九日刘令君初度赋此为寿","author":"韩日缵","text":"九秋佳节晓风清，百里弦歌喜气生。\n日月并当阳数应，黍禾恰值岁功成。\n花因辟恶簪萸蕊，酒为延年泛菊英。\n野老顾陪长久宴，弘敷寿域遍黎氓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28431,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"湖干草堂初落冯若符适至为书余园居诗于壁提墨纵体曲尽其致赋谢一章","author":"韩日缵","text":"卜筑湖壖水竹居，君来恰值落成初。\n开尊偶诵园中句，搦管因为壁上书。\n鸟迹虫文随几席，崩云垂露遍庭除。\n细披笔阵寻遗法，任尔笼鹅兴有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28432,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"张孟奇先生种梅庾岭寻畴昔之盟也余癸酉出山载之而往因为赋别","author":"韩日缵","text":"香魂处处吐芳清，独遣花神事远征。\n月下何年曾入梦，岭头此日尚寻盟。\n一时宗老应无辈，予载风流得擅名。\n问我归期堪索笑，花前绿醑许同倾。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28433,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸酉出山 其一","author":"韩日缵","text":"忽传玉诏到柴扉，簪履深恩露未晞。\n报主有心空蹇蹇，辞家无计尚依依。\n黄龙洞口催兰棹，白鹤峰前换芰衣。\n惆怅溪云秋正好，一竿閒却钓鱼矶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28434,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸酉出山 其二","author":"韩日缵","text":"野性还宜鸥鹭群，漫劳圣主下玄纁。\n倦飞却羡投林鸟，歘起虚疑出岫云。\n宵旰一人仍侧席，干戈四海未销氛。\n孤臣叱驭宁辞瘁，空愧当年誓墓文。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28435,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别罗浮","author":"韩日缵","text":"奇峰四百共朝昏，世外缔交独有君。\n把酒每邀霞岛月，摊书时和铁桥云。\n烟岩雾壑窗前见，泉籁松音枕上闻。\n已就菟裘吾且老，故山白发暂相分。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":28436,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]