[{"title":"吊达奚司空次苏应机原韵 其二","author":"陈仕俊","text":"海国东南自一涯，故乡何处梦中赊。\n祇应肠断无归路，却有游魂得到家。\n仙骨已看成槁木，世缘真信是空花。\n惟馀手植波罗树，叶叶风吹自怨嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9575,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"吊达奚司空次苏应机原韵 其三","author":"陈仕俊","text":"真成芳草落天涯，谁念王孙信息赊。\n狐首自难忘故国，猿肠空断忆还家。\n游魂缥缈随风叶，冷泪斓斑散雨花。\n千载越裳重译使，摩挲谁不为兴嗟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9576,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送陈六溪之江右皋","author":"章熙","text":"粉署含鸡舌，新恩易豸衣。\n风花春正好，樽俎重相违。\n岐路苍烟漠，江干碧草菲。\n知君滕阁上，北斗指皇畿。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9577,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"柬林间云处士","author":"章熙","text":"白云深处寄踪孤，一灶秋烟煮石蒲。\n门掩月明花自落，野亭樽酒忆林逋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9578,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"名宦吴隐之新祠","author":"章熙","text":"孤村修竹蔼芳阴，古岸新祠傍水滨。\n过客莫烦沽酒奠，使君原是饮泉人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9579,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"峡山飞来寺","author":"曾楚","text":"步上飞来乱石巅，丹崖翠壁不知年。\n云萝半捲千山定，草树遥遮一水连。\n古刹飞花来野鹤，老僧说法起啼猿。\n凭高未尽游观兴，击剑高歌思渺然。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9580,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"东山霁望","author":"卢宁","text":"霁景满崆峒，攀萝入碧空。\n霞飞平野赤，曙拂乱云红。\n似近紫薇座，还参青帝宫。\n蓬莱何处是，羽翰欲乘风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9581,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"复民部何三柳遗廷对策二首 其一","author":"卢宁","text":"一翰飞三策，东莱贶草庐。\n捧持情故故，拜喜意于于。\n花巷无司马，灯帷有仲舒。\n美人隔烟岛，秋水濯芙蕖。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9582,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"复民部何三柳遗廷对策二首 其二","author":"卢宁","text":"殿上奎章焕，轩前云阵驰。\n白栏终日对，青简万年垂。\n国士歌飞燕，司徒示梦龟。\n从今识花样，旖旎桂林枝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9583,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大林洞天","author":"卢宁","text":"云墅千章绿，萧然谢客斋。\n捲帘看烟雨，坐竹委形骸。\n柽鸟啼山谷，仙芝接海崖。\n秋高期散步，红叶藉青鞋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9584,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"邻山馆中","author":"卢宁","text":"土屋幽宜独，春山深几重。\n窗含金玉气，庭落兔猿踪。\n高步瞻星近，清歌坐荫秾。\n芳樽开晚霁，新月上长松。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9585,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"会城春游得空字","author":"卢宁","text":"迟日春台上，花枝白间红。\n彤栏回淑气，瑶草覆东风。\n丽藻悬吴市，明妆出汉宫。\n锦城三月半，樽斝莫教空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9586,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿清远飞来寺二首 其一","author":"卢宁","text":"绿净峡江浔，悬崖自俯临。\n云连山欲合，水逼昼常阴。\n飞阁羽翰戢，沉犀锁钥深。\n寂寥风雨夜，欹枕听龙吟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9587,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿清远飞来寺二首 其二","author":"卢宁","text":"三经江上寺，此度扣仙灵。\n一水中分绿，两崖相对青。\n乌栖山瘴暝，水落露华零。\n夜色犹堪恋，猿啼不忍听。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9588,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送汪仪制柏亭升南尚卿","author":"卢宁","text":"龙篆颁成命，鸿才列尚卿。\n备官惭倚玉，别意怅流萍。\n夜月秦淮水，春风建业城。\n樽空人欲去，日暮禁烟生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9589,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游云台四首 其一","author":"卢宁","text":"塞峡连朝雨，登山此日晴。\n高危偏自在，光景更分明。\n二水流珠沫，重峦巩玉城。\n恣游清俗虑，兼得问苍生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9590,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游云台四首 其二","author":"卢宁","text":"胜地多年选，芳春挟伴游。\n莺歌将绿辔，狐迹净丹丘。\n峰列少薇座，台乘太乙舟。\n欲穷穷妙处，明上上清楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9591,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游云台四首 其三","author":"卢宁","text":"望气入云端，披云得静观。\n流丹诸界丽，步玉上方寒。\n香篆拚青鸟，梵箫下紫鸾。\n呼僮携酒具，随意坐琅玕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9592,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游云台四首 其四","author":"卢宁","text":"礼拜玄皇殿，瞻言太武身。\n功传威二异，术会授三真。\n贝叶裁天女，芝盘荐帝臣。\n梓州储福地，游客好乘春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9593,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵与宗瓠川夜话有怀金台旧雅次韵五首 其一","author":"卢宁","text":"绛帻罢晨鸡，听钟紫阁西。\n烟浮金爵暝，柳拂翠绳低。\n旧学悬河泻，新诗倚马题。\n特危忠简疏，多为故人携。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9594,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵与宗瓠川夜话有怀金台旧雅次韵五首 其二","author":"卢宁","text":"昔年陈玉陛，见子侣金鱼。\n制奉阿衡简，笺呈泰畤书。\n人皆诵招隐，尔独赋閒居。\n安得飞风息，君王为破舆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9595,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵与宗瓠川夜话有怀金台旧雅次韵五首 其三","author":"卢宁","text":"钟阜对长歌，瞻天意若何。\n帝衢严露析，寝庙起云萝。\n国士时堪属，诗名忌更多。\n平原求使楚，颖脱似君那。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9596,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵与宗瓠川夜话有怀金台旧雅次韵五首 其四","author":"卢宁","text":"忆尔上金台，初酣落魄杯。\n英名通馆阁，仙制应蓬莱。\n法从天中见，旗常日下来。\n甘泉如欲赋，今有子云才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9597,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金陵与宗瓠川夜话有怀金台旧雅次韵五首 其五","author":"卢宁","text":"一别已十载，相逢惊二毛。\n西山残雪霁，南国彩云高。\n白句挥清斝，玄文擅紫毫。\n君当留此馆，无使梦思劳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9598,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠王莲渚主簿醴陵","author":"卢宁","text":"岭北名州彦，湘南判县官。\n十年劳择木，一旦见栖鸾。\n秋月看湘竹，春风歌澧兰。\n甘泉如再涌，崖谷尽含欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9599,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朝陵二首 其一","author":"卢宁","text":"钟峤烟霄里，高陵气象中。\n衣冠游凤辇，寝庙泣乌弓。\n万国尊寅正，千官走肃雍。\n翠华何处想，缥缈五云东。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9600,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朝陵二首 其二","author":"卢宁","text":"雨露桥山在，风烟隧道通。\n三元兹旦始，合敬百工同。\n王气参天外，威灵俨殿中。\n新军增羽卫，千载护巃嵷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9601,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留都元旦瞻天三首 其一","author":"卢宁","text":"星换铜龙次，官严金马仪。\n玄躬同道泰，睿泽与时熙。\n陈瑞多笺奏，颁春荷宠私。\n视朝今正始，端笏待朝曦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9602,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留都元旦瞻天三首 其二","author":"卢宁","text":"春燎明阊阖，宵衣肃建章。\n玉衡占改陆，斧扆庆乘阳。\n委佩欹宫草，熏炉袭殿鸯。\n云官离照下，遥祝圣神皇。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9603,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"留都元旦瞻天三首 其三","author":"卢宁","text":"肃肃千门晓，融融万国春。\n台瞻云五色，乐奏月重轮。\n仙仗天蓂秀，王章岁事新。\n命龙咨岳牧，次第下丝纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9604,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"四月莅部事","author":"卢宁","text":"孟月康辰正，司农载启符。\n案行承八座，财用计三都。\n营宿虚昏舍，妖氛净海嵎。\n玺书随凤历，蠲复动吴歈。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9605,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠曾源泉布衣擢两浙都阃和万史部两溪","author":"卢宁","text":"两承詹白下，一见识班生。\n北望纡筹策，东行洗甲兵。\n庙堂分外阃，吴越倚长城。\n后夜秦淮月，依稀细柳营。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9606,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"钟山高望","author":"卢宁","text":"昔年惭霸气，此日纪皇坟。\n地坼东吴月，江吞西楚云。\n帝宫悬法象，天印耀台文。\n秋霁登临好，霞光彻海濆。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9607,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮登鸡鸣山寺","author":"卢宁","text":"西曹鸡寺近，日暮亦登临。\n倒景悬秋壁，疏钟度晚林。\n树高山阁暝，路僻野云深。\n引月看僧定，因之谐静心。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9608,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谒大忠祠次韵","author":"卢宁","text":"宋室踰河日，厓门避历辰。\n委裘悬百战，殉国有三仁。\n朗节明云汉，悲风凛缙绅。\n万年瞻庙貌，谁不吊贞珉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9609,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别友","author":"卢宁","text":"与子暂言别，相携出海涯。\n浅泥青蕙草，细雨白蕖花。\n意气交双臂，文章洗百家。\n馆扃玄鹤观，留待尔江槎。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9610,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"追书张方伯封君平湖号卷二首 其一","author":"卢宁","text":"梓庭遗泽恨，姜渡野芳情。\n春晏长兰媚，风徐一鹭轻。\n恩波天上荡，光岳槛边明。\n夜半洲前笛，如闻咽濑声。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9611,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"追书张方伯封君平湖号卷二首 其二","author":"卢宁","text":"湖翁閒白昼，云榭寄清觞。\n流水琴声远，寒潭钓饵芳。\n庙堂新鹤发，玺诰旧龙章。\n对景添怀抱，扁舟系夕阳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9612,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"静轩壁上","author":"卢宁","text":"地僻人经少，台阶蚀藓斑。\n几随春梦去，兼得性天还。\n门闭花枝舞，窗虚燕子閒。\n年丰免忧国，黄发老青山。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9613,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"过渭川次韵","author":"卢宁","text":"潏渌泻天精，相形不待泾。\n浮云何处影，钓石旧时铭。\n欲造西周业，能修东海龄。\n后车人不见，停棹怅流萍。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9614,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送申我泉同年尹分宜","author":"卢宁","text":"天榜群仙侣，春城恋物华。\n银台秋夜月，琼苑汉宫花。\n星宿窗中列，风烟塞上沙。\n他时霜露白，还听咏蒹葭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9615,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送邵槐东教会昌","author":"卢宁","text":"儒秩新承檄，都门故饰轮。\n金尊行底意，红杏雨中春。\n学古心为主，忘言教是真。\n子当驰逸驾，从此养经纶。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9616,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寿刘罗阳尊公年伯","author":"卢宁","text":"两命谳台史，廿年归马翁。\n仙蒲岩畔绿，春禾日边红。\n玉斝流云液，瑶笙动景风。\n蓬莱三万里，青鸟欲凌空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9617,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送苏粤峰同年池州节推","author":"卢宁","text":"青襟同旅食，白首得心朋。\n并马春林玉，连床夜雨灯。\n谳疑新有命，委印旧称能。\n公暇齐山上，琴樽好健登。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9618,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"游卢岩道中遇雨恐有期而不至口占促之","author":"卢宁","text":"冒雨寻幽胜，芳怀太率真。\n影连衡岳晴，清涤泰寰新。\n峰展青莲面，亭芬金谷春。\n虽知勤羽盖，无以弃松筠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9619,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卢岩上次韵二首 其一","author":"卢宁","text":"法门长不二，仙洞窈藏真。\n顾影依池洁，洗心期日新。\n云明虚阁午，林霁故山春。\n幽赏兼良会，清樽酌绿筠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9620,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卢岩上次韵二首 其二","author":"卢宁","text":"福岩遥附姓，惠祖旧传真。\n宫阙风幡杳，台池色相新。\n雨帘垂永昼，斗柄酌和春。\n废景今题揭，车回舞翠筠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9621,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"与友人登齐山分得茶字","author":"卢宁","text":"挈伴寻幽境，探僧出早茶。\n绿霞拖涧水，朱鸟落山家。\n池漫长三月，峰联小九华。\n游人心会景，何用炼丹砂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9622,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"暮春遣仆归省","author":"卢宁","text":"旅愁春又晚，归计岁初分。\n林薄经红雨，家乡空白云。\n食少疑瞿貌，忧多见乱纹。\n行年过七十，银鬓自棼棼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9623,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"怀两泉诸父忠启诸弟","author":"卢宁","text":"遥知良叔季，清苦故依然。\n画粥甘长白，藏灯咏太玄。\n素怀宁自负，华发羡人怜。\n翻忆同书砚，深惭助俸钱。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9624,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱华塔成三首 其一","author":"卢宁","text":"竖塔障江涟，吾民种福田。\n孤高周石室，明远汉通天。\n金紫千家丽，仪章六代贤。\n平川成乐土，长世祝皇年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9625,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱华塔成三首 其二","author":"卢宁","text":"伏见星辰驾，崚嶒云汉梯。\n图开千地会，宝积四天齐。\n光射薇垣北，影参莲岳西。\n磨崖来俊彦，名姓雁行题。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9626,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"朱华塔成三首 其三","author":"卢宁","text":"秩晋文翁郡，台崇卓笔峰。\n炎荒金翡翠，秋宁玉芙蓉。\n化俗知无策，覃恩赖九重。\n登临惭竹使，题染别花封。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9627,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"谢节妇","author":"卢宁","text":"矢死执联巾，空闺积泪痕。\n冷添风絮夜，香溢露兰春。\n有两非初意，遗孤是后身。\n此情谁会得，霜月净随人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9628,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"赠陈石冈太守归寿尊封君","author":"卢宁","text":"巡巴旋皂盖，异气望青牛。\n鸟报山中节，人添海上筹。\n冰桃悬古涧，琅叶覆芳丘。\n每到群仙会，频瞻五马游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9629,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登潼川郡南楼","author":"卢宁","text":"郡胜经时远，台高望处疏。\n水流通楚沔，山引接岷峨。\n汉垒重闻表，唐封再戢戈。\n专城千里寄，才愧古人多。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9630,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登三台山","author":"卢宁","text":"仙台近西郭，香雾涌珠林。\n翠竹风长软，碧桃春自深。\n中天龙虎会，永夜斗星临。\n珍重王乔宴，丹筵色色金。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9631,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻兴国县建生祠 其一","author":"卢宁","text":"腊去相睽忍，秋残得报迟。\n山城循吏传，香火令公祠。\n陋迹污青简，瞿颜愧紫芝。\n况闻环野外，人各为吾私。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9632,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"闻兴国县建生祠 其二","author":"卢宁","text":"鲜我终来誉，劳民搆去思。\n有怀空隐恻，何范可光垂。\n出境滋惭负，传书起梦疑。\n甘棠歌召伯，方称后贤师。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9633,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洞门寺偶题二首 其一","author":"卢宁","text":"流水石桥路，仙凡自此分。\n洞门双掩月，山木独栖云。\n城市喧何在，衣冠会更殷。\n斋厨香国众，金马碧鸡群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9634,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"洞门寺偶题二首 其二","author":"卢宁","text":"兰若开毗域，昙光射汉分。\n门临千地水，台护五天云。\n问药客怀恶，登楼乡思殷。\n郡人称吏隐，相与鹿麋群。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9635,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"题暮松图","author":"卢宁","text":"忍望长松下，乔乔苍翠森。\n蒿莱三尺土，雨露百年心。\n幕府衔恩重，泉台饮恨深。\n圣明推赠典，光满大夫林。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9636,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"卢龙观与兴国吕子选秀才话别","author":"卢宁","text":"赤县三年爱，玄谈午夜悰。\n来詹初及夏，归计拟延冬。\n清饮秦淮月，高寻颍上封。\n再游浑熟路，金马过卢龙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9637,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"燕子矶与兴国吕子龙秀才话别","author":"卢宁","text":"遗爱惭仙宰，悬情入帝畿。\n有怀何耿耿，长路故依依。\n再宿玄湖省，高酣紫燕矶。\n大鹏风欲起，聊且伴秋归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9638,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送欧鉴斋省郎养病","author":"卢宁","text":"采药匡庐去，逢人便说休。\n案留金玉判，台纪凤凰游。\n霜浸陶潜径，风高张翰秋。\n幸毋乡土恋，征戍遍南州。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9639,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登东山","author":"卢宁","text":"卜日开青阁，携壶上翠冈。\n林栾架王气，崖谷吐春光。\n妓子污仙界，儒生小鲁疆。\n秦皇封石处，高兴已飞翔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9640,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"宿后湖读杨子","author":"卢宁","text":"玄经玄渚夜，白首白云司。\n火熄皇图府，星环仙署陂。\n官如沧水使，吏讶北山移。\n一梦新秦事，令人远注思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9641,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽庐陵胡坦翁配张孺人 其一","author":"卢宁","text":"逸老螺川上，平夷高隐心。\n平拖黄石履，高咏白头吟。\n别驾驹声咽，空庭槐影森。\n泷冈邻近处，吊古一怀音。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9642,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"挽庐陵胡坦翁配张孺人 其二","author":"卢宁","text":"籍籍荆扬彦，犹闻坦丈夫。\n义捐青玉案，恩赠执金吾。\n兰蕙春俱秀，芙蓉蒂并需。\n片云迷五老，何以慰匡庐。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":9643,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]