[{"title":"因滇中使寄方子及","author":"欧大任","text":"五载南音楚执圭，相思更在益州西。\n开边异代通华马，奉使何人祀碧鸡。\n客戴次工能共醉，蛮封么㱔请留题。\n还君鞭弭中原日，莫恨昆明听子巂。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7744,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日同金处士姚鸿胪集许奉常宅次奉常韵","author":"欧大任","text":"一轺吾尚傍风尘，江左衣冠半隐沦。\n六鹄并来昆圃客，二龙谁似汝南人。\n尊前寄赏同看竹，赋里怀归不待莼。\n为是旧游容入社，可能无意橘花春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7745,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次鸿胪韵","author":"欧大任","text":"秣陵一别十三年，许掾能开玳瑁筵。\n何限江山经六代，未应宾客让群贤。\n春声前起金罍侧，真气东来玉杖前。\n遥望昆崙山下路，同谁田者是元先。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7746,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次处士韵","author":"欧大任","text":"清卿宅近秦淮畔，春满西堂爱客过。\n交以通家论孔李，诗曾佳句逼阴何。\n披襟石上青云远，把臂林间白发多。\n谁共千觞酬胜会，醉来吹剑一高歌。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7747,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"郭次甫往游玄岳过金陵见寄用韵遥答","author":"欧大任","text":"片帆不住楚江舟，嵾岭西寻最上头。\n金涧松杉千瀑下，玉霄台殿五云流。\n书成薤叶僧能乞，杖借榔枝客共游。\n肯过茅君双白鹤，愿从人代访丹丘。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7748,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次韵酬陆无从因喜李季常归自岭外","author":"欧大任","text":"旧学君鱼转是师，竹西一赴十年期。\n法曹尚忆梅花阁，隐士多能桂树诗。\n频向江波烹鲤腹，似怜山朋妒蛾眉。\n北来渐有罗浮信，为访磨崖问叔之。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7749,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"春日集许奉常倪蕲水姚嘉州于青溪别署","author":"欧大任","text":"官桥杨柳郁青青，系马留宾浊酒瓶。\n鼎族溪东曾鹊起，词人江左半鸿冥。\n桃花不隔湘宫寺，竹格犹通骠骑亭。\n五百里中贤更聚，荀陈何事亦干星。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7750,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"铜梁张中丞自上谷入为右司马远承书问因登石头城奉寄","author":"欧大任","text":"虎踞城边雁未还，远传歌吹入燕关。\n十年出佩扶阳印，九命趋归太尉班。\n幕府重沾新雨露，鼎门能记旧河山。\n南曹已隔宾庭履，花满江头鬓渐斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7751,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白下逢王比部幼文使还吴中兼怀沈比部箕仲","author":"欧大任","text":"趋朝同听禁钟声，日出彤墀一字行。\n我自分司称散吏，君今衔命下陪京。\n青幡南布王春令，白纻东归子夜情。\n天末故人如把袂，五云回首凤凰城。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7752,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答方永叔兼怀朱子厚","author":"欧大任","text":"白下音书久未通，劳题尺牍问飘蓬。\n才人宛洛风流在，公子夷门节侠雄。\n双阙晓云笼楚树，万家春雨滞江鸿。\n东都作赋非吾事，綵笔偏能让国工。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7753,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"访廖中郎不遇酬其赠篇","author":"欧大任","text":"兴来策马不相期，病后封书报汝迟。\n故事尽传都水部，词人能诵廖公诗。\n卧游宅里图南岳，行散江头望太沩。\n棋墅酒楼应可问，绿杨西路竹参差。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7754,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄顾少参益卿","author":"欧大任","text":"斗城千雉海边开，曾是南征戡定才。\n西部兵符山越过，右军词笔永嘉来。\n波惊近寨惟吹笛，月满高楼数举杯。\n我自江东看白雁，可能传得尺书回。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7755,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"白水草堂为朱子厚题","author":"欧大任","text":"南阳贵人纨绮间，闻道王孙善闭关。\n校籍名高天禄阁，著书家近陆浑山。\n桃花水长渟为镜，竹箭流分曲似环。\n客有八公曾到否，藤枝芒屩可能攀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7756,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"太医令周一之归葬吴中王元美为铭其墓","author":"欧大任","text":"慷慨中原侠客魂，铭山犹有故人存。\n蛟龙尚护干将气，狗马谁蒙敝盖恩。\n落日啼乌悲蓟树，西风归雁过吴门。\n茔前极目千家邑，能为停舟酹一尊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7757,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬马从甫见投因怀林邦介","author":"欧大任","text":"裹粮三月下江东，漫漶曾题短刺中。\n有道出能游太学，季长名自起扶风。\n家惟白简文无害，世以青箱业更工。\n共识林尊经术贵，石渠高论几时同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7758,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"酬佘明府宗汉过金陵见赠","author":"欧大任","text":"帆落江干听暝钟，七闽词客忽过从。\n一冠书就犹为鹖，双剑函来尽是龙。\n租舫故应逢谢尚，草堂吾已愧周颙。\n不知傲吏游何处，期尔茅家第几峰。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7759,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答臧博士晋叔荆州见寄","author":"欧大任","text":"昔从法署颇经年，尚记持觞芍药前。\n南郡儒生劳绛帐，西京宾客待青毡。\n登楼赋倚荆江月，握管书题郢树烟。\n留省为郎头欲白，忆君何日奏甘泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7760,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送冯京倅致仕归华亭","author":"欧大任","text":"彬彬汉代孝廉同，纳禄书驰奏法宫。\n鸥泛未忘沧海上，鲈肥先下大江东。\n庞眉尚得迁都尉，骥足何劳荐治中。\n是处名山皆可隐，杖藜吾亦待秋风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7761,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"王仲房吴少蒙吴翁晋梅季豹过集迟周公瑕殷无美不至","author":"欧大任","text":"江左千年调转孤，祇堪长啸共吾徒。\n可能省署开文苑，未必河山邈酒垆。\n凉入蒹葭黄鹄起，酣来风雨白龙呼。\n东方且结金门客，囊粟谁曾问有无。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7762,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同方鸿胪允治集李临淮惟寅宅","author":"欧大任","text":"宅依双阙紫微垣，世阀岐阳几代孙。\n江左旌旗开幕府，信陵宾客过夷门。\n茧书龙护宸章阁，竹树鹓栖御赐园。\n闻道青溪曾拂石，南来犹得共芳樽。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7763,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"中秋郭次父陆华甫周文美陆无从胡伯昂何长卿李季常安茂卿陈从训黄白仲陈季迪梅季豹过集得长字","author":"欧大任","text":"高天月转薜萝墙，握手惊呼白发郎。\n鳷鹊观临淮水碧，鸤鸠司傍蒋山苍。\n歌翻南曲秋当半，客满西池夜正长。\n斗酒十千君但坐，莫令离索念江乡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7764,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"次夕李文仲孙齐之姚伯道罗伯符王元方程子虚汪仲嘉马从甫黄思素吴大觉过集得逢字","author":"欧大任","text":"草堂西曲白云重，尊酒宁知此夕逢。\n何限归心思息鴳，敢于词客竞雕龙。\n万家明月江城笛，千里惊飙涧寺钟。\n宋玉未应摇落恨，剑光秋已照芙蓉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7765,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答陈太守思贞见寄","author":"欧大任","text":"孟公宾客未应稀，谢病为园早息机。\n论谳有人求故府，薜萝中岁遂初衣。\n江头烹鲤封书到，洛下思鲈钓艇归。\n君记藏乌杨柳树，何能不向白门飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7766,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"和答宗侯芾斯见寄","author":"欧大任","text":"飞盖何人问病夫，八行传自孟陵奴。\n江湖已赐诸侯履，岁月先藏大国符。\n校籍西京劳子骏，著书东观召騊駼。\n报君一札头将白，天远柴门客梦孤。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7767,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送蔡祠部尔通守宁波","author":"欧大任","text":"祠官今比玉壶清，铜虎符分向四明。\n城近丹霞褰幔过，山深白鹿夹车行。\n治装资遣惟兴学，卖剑催耕不用兵。\n十郡应推循吏上，汉家何日召持衡。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7768,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"从光大邓忠父臧晋叔郑孟承钱仲美五博士典试留都秋日见过","author":"欧大任","text":"长安星散旧交稀，马首今看道路辉。\n聘赵才应收白璧，过江游更聚乌衣。\n疏狂我抱秦人策，献纳君趋汉主闱。\n暂可相从南菊醉，不堪天际北鸿飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7769,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同来何贾魏黄徐李诸省丈游燕子矶","author":"欧大任","text":"瑟瑟秋风吹落鸿，联镳登望有群公。\n星分瓯骆悬朱鸟，江合岷嶓引白虹。\n睥睨北连山树里，楼船东向海云中。\n雅歌欲答升平乐，双桨尊醪幸不空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7770,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"登弘济寺观音阁","author":"欧大任","text":"摩空佛阁郁崔巍，乘兴诸郎约不违。\n瓜步片帆江似堑，蒋州千栅石为矶。\n履曾西去无消息，马自南来有是非。\n谁共谢公风浪里，祇堪沉醉笑安归。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7771,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"九日同方鸿胪允治蒋光禄淑四游徐氏园","author":"欧大任","text":"载酒亭西曲径通，商飙一望雨冥濛。\n寒涛半落三江渡，秋草难寻六代宫。\n棋墅颇曾邀谢傅，习池能不醉山公。\n齐盟敢负京台约，翠竹黄花尚可同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7772,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送祁羡仲邓德咸何学绳邝若钦陈凤甫李季宣林开先诸子赴试南宫","author":"欧大任","text":"西风弹剑气翩翩，半似阳关送别年。\n赤羽飞龙新入蓟，黄金图骏更归燕。\n参差阁道重城里，沆漭沧波太液前。\n公等定惊相见晚，不妨同日奏甘泉。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7773,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"区用孺高正甫王永叔崔子玉赴试入都别之江上","author":"欧大任","text":"秋晚公车待诏行，词人笔札满西京。\n奏书已有三千牍，函璧宁论十五城。\n金埒柳深遥策马，玉河花簇醉听莺。\n白头转忆追趋地，何限江干送客情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7774,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"别吴叔嘉黄白仲马从甫余食其四子","author":"欧大任","text":"一时词客起弹冠，何事交深去住难。\n江阔片帆瓜步远，天高双阙秣陵寒。\n歌中白雪曾同调，醉后黄花尚可看。\n六代风烟分手地，赠君惟有碧琅玕。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7775,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同顾司勋道行张太学幼于夜饯张侍御伯大还蜀","author":"欧大任","text":"钟阜城边数骑过，离怀耿耿对星河。\n朝临楚岸鸡声早，秋入巴江雁字多。\n枫叶吹来行自听，竹枝归去和谁歌。\n天涯可道轻分手，其奈关山怨别何。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7776,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方鸿胪邀同许太常张太学饮齐园","author":"欧大任","text":"奉常典客雅称诗，才子东来不可期。\n曲宴幸同漳水会，名园况似洛阳时。\n席边月冷松犹茂，篱下霜彫菊未迟。\n我亦自扶消渴后，十千平乐醉何辞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7777,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄冢宰王公二首 其一","author":"欧大任","text":"台衡星照赤麟袍，家是王祥有佩刀。\n霄汉双飞鸿雁字，风云并起凤凰毛。\n龙门史待抽金匮，江左才应让彩毫。\n从此衣冠传盛事，驷车争看里门高。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7778,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄冢宰王公二首 其二","author":"欧大任","text":"青云射策重名儒，竞爽谁如二子殊。\n杞梓荆南千岁干，骅骝燕北五花驹。\n荀郎表里知家学，韦相传经在帝都。\n遥想曲江春醉后，应随革履阙庭趋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7779,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大司空曾公新加宫保寄贺二首 其一","author":"欧大任","text":"鹓班鸣佩掖门东，郢国于今秩最崇。\n相以司空开赤社，恩加太保侍青宫。\n阁中秘有新裁诏，橐里藏多旧赐弓。\n八座首承三命贵，一时经术独称雄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7780,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"大司空曾公新加宫保寄贺二首 其二","author":"欧大任","text":"山陵使者汉臣尊，丹陛酬功礼数繁。\n插羽琼条参鼎位，延芳珠树傍台垣。\n锡圭更绾中书印，拖玉频趋太极门。\n回首郁葱佳色里，早摅忠荩答皇恩。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7781,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答李裕德黄元光见寄","author":"欧大任","text":"家山何处望丹梯，念我频劳尺素题。\n官愧董郎栖白社，宅犹江令寄青溪。\n移文猿鹤心偏远，归梦乡关路不迷。\n傥许相随灵寿杖，大科东北铁桥西。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7782,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"至日斋宿省中值雪同诸僚作","author":"欧大任","text":"千官斋韨祝蕃釐，七日迎阳肃盛仪。\n望入汉宫双露掌，拥来江苑几琼枝。\n飞英半似花林夕，鸣玉犹随月观时。\n听得仙郎歌白雪，何人不和郢中词。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7783,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送张曹长仁甫出守淮安","author":"欧大任","text":"朅来东省共为郎，畿辅君行绾郡章。\n正借张纲平海垒，谁云汲黯卧淮阳。\n万家畚锸防河急，十道均输转饷长。\n问俗勤耕功不细，召归何以奏明光。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7784,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭黎惟敬二首 其一","author":"欧大任","text":"南北销魂已黯然，谁知掩泪向江天。\n伤心别路三千里，回首浮云五十年。\n粤隐独先持海钓，楚游曾约问泷船。\n他时纵听邻人笛，只在山阳竹树边。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7785,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"哭黎惟敬二首 其二","author":"欧大任","text":"典秘能辞侍从庐，归人为我一踌躇。\n痛深张掖门前别，诀绝梅花社里书。\n稷下旧游那可得，茂陵遗草更何如。\n望乡未把生刍去，策马西州限有馀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7786,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"癸未元日和许奉常作","author":"欧大任","text":"旧京元会傍丹霄，雪照青山玉作桥。\n双阙风云随剑舄，十年江海梦渔樵。\n长生岂但思餐柏，上寿惟能学颂椒。\n郎署冯唐头已白，自怜何补圣明朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7787,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"初春过悦上人迟恩公礼公","author":"欧大任","text":"杖藜江路雪方消，献岁初过善世桥。\n为许阮公持白马，便逢支遁论逍遥。\n山寒竹树鸣苍玉，窗暝梅花照绛绡。\n今日长干禅藻盛，风流何必减南朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7788,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送泰宁陈侯被诏驰驿还都","author":"欧大任","text":"龙骧百万寄戎机，六传飞扬北上时。\n路远风雷惊鼓角，江清鱼鸟识旌旗。\n洛师已报功宗礼，鲁颂今歌燕喜诗。\n云暖日高貂冕入，未央前殿望罘罳。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7789,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"答王百谷见寄","author":"欧大任","text":"长安携手问游梁，曾忆同时谒建章。\n开阁尔为丞相客，过江吾愧尚书郎。\n遥知羔币辞莲府，老向驺车负草堂。\n明日东归变名姓，傥逢梅福在吴阊。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7790,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送沈宪副徵甫备兵江西","author":"欧大任","text":"铨管清曹羡握兰，五花骢引绣旌干。\n论兵名蚤摽麟阁，待宪权新壮豸冠。\n章水天浮诸郡出，匡庐云落九江寒。\n卷帘不必舒长啸，秋色还能散帙看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7791,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送郑兵宪克渐赴岭西","author":"欧大任","text":"外台使者出东曹，揽辔宁知度岭劳。\n蛮府凿关临万垒，汉兵横海发千艘。\n铁冠道路清霜肃，铜柱风云白日高。\n平越威名从此盛，渔樵今已息弓刀。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7792,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"同汪主客李司封遇周计部元孚饮江上","author":"欧大任","text":"把袂何期白鹭前，行吟憔悴也堪怜。\n柳花香送吴姬酒，桃叶歌留楚客船。\n沙际鸣榔迎海汐，城头飞帆宿江烟。\n青青兰芷思公子，不是湘潭惜誓年。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7793,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"青溪馆春晚答吴翁晋见寄","author":"欧大任","text":"江上秋风送客槎，封书能寄子云家。\n病中讽咏曾焚蒳，别后星霜一折麻。\n白练飞来天目雨，紫虈开过秣陵花。\n金门傲吏抽簪晚，欲向朱明咽九霞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7794,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"方鸿胪允治吴驾部公择顾司勋道行李司封于田过集青溪馆","author":"欧大任","text":"春色鸣珂满旧京，一尊溪上薜萝情。\n尽娱山泽琴中散，谁许英雄酒步兵。\n槛俯流澌通急溜，帘开疏雨过高城。\n同时几似操觚客，何但甘泉侍从名。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7795,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"许奉常见示八十自述四首次韵奉寿 其一","author":"欧大任","text":"嘉靖中兴十四春，南宫第一奏名新。\n回翔铨省方迁秩，出入容台已乞身。\n丹穴九苞飞鸑鷟，青山十赉长松筠。\n何须禽尚相将隐，自是羲皇以上人。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7796,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"许奉常见示八十自述四首次韵奉寿 其二","author":"欧大任","text":"投闲蚤得养修龄，千丈翩跹海鹤形。\n松子旧封江上鼎，鸱夷长傍井湄瓶。\n周家礼乐卿为月，汉代烟霞客是星。\n拜老西雍鸠杖健，君王不用给芝苓。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7797,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"许奉常见示八十自述四首次韵奉寿 其三","author":"欧大任","text":"一谢时光草奏年，及门羔雁拥书筵。\n思玄请老张平子，学道辞侯葛稚川。\n关下有人能望气，海边何客更求仙。\n五龙睡法曾相授，闲向松根枕石眠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7798,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"许奉常见示八十自述四首次韵奉寿 其四","author":"欧大任","text":"钟阜崚嶒日渐高，申公八十是今朝。\n长生林里春偏茂，偃盖坛边雪不彫。\n阁贮文章皆琬琰，家传簪笏半云霄。\n称觞盛有江东客，南极星明颂圣朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7799,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金山人在衡九十有作次韵为寿 其一","author":"欧大任","text":"辞爵东陵盛代民，青门瓜地岂全贫。\n五朝世异陶元亮，十亩耕如郑子真。\n守德故应忘寂寞，居闲何用厌缁尘。\n若论江左风流事，谁似升平九十春。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7800,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金山人在衡九十有作次韵为寿 其二","author":"欧大任","text":"双鬓萧疏雪未侵，高年粟帛诏初临。\n伏生隐待求书使，居士修成出世心。\n但可敲冰餐白石，宁知炼药煮黄金。\n儿孙绕膝皆兰桂，一曲宾筵更一斟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7801,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"金山人在衡九十有作次韵为寿 其三","author":"欧大任","text":"身是神仙自不知，况逢熙皞圣人时。\n城盘龙虎山为岳，宫现金银海似池。\n洛下曾陪诸老会，淮南奚羡八公词。\n更开十帙方瞳碧，玉杖云边赋采芝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7802,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"送宋兵宪惟一赴闽中","author":"欧大任","text":"南征慷慨佩吴钩，组练三千拥上游。\n襟带七闽开大府，弦歌百越似沧洲。\n白龙尚控无诸国，铜虎犹劳案道侯。\n傥问梅花吹玉笛，故人相忆在江楼。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7803,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}},{"title":"寄致政区温州","author":"欧大任","text":"东嘉大郡解簪裾，七十衔恩赋遂初。\n肄水凫鸥迎进艇，崧台麋鹿待悬车。\n家辞句曲先生禄，山就龙门太史书。\n三凤翩翩前上寿，丈人安坐乐何如。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_3.csv","pointer":7804,"sha256":"dc0f9be95fde68d0587a89f7f11526c1b01ac96ad263e94221e979e35a2b94cc","dynasty":"明"}}]