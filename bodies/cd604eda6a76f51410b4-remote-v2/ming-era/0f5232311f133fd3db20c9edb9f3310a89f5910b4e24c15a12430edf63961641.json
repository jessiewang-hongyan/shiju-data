[{"title":"作室藏舟于瑁湖适超果住僧浚寺濠北邻薛生期复仙冢旧迹落成之日眼界一新予少读书寺中不意老而还此笑游也诗以记之","author":"顾清","text":"何处堪予泊钓舟，陆家湖尾寺滩头。\n几湾绿树迎潮入，一带红兰映水浮。\n已喜金沙清佛界，更疏玉涧绕仙洲。\n谁知白首归来客，重与溪山结胜游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54290,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"四叠纶字韵答味苓","author":"顾清","text":"閒身无复半通纶，天许三江一道分。\n拥楫有时成白醉，著书终不效玄文。\n悠哉细雨滩头钓，邈矣凌烟阁上勋。\n昨日城中传邸报，溪翁对面不曾闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54291,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五叠纶字韵","author":"顾清","text":"清潭百尺袅风纶，杨柳芙蓉四面分。\n前去桃源知有路，后来甫里亦能文。\n笔床影落天池月，茶灶铭书鼎足勋。\n一事最奇曾未有，龙吟近在枕边闻。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54292,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"叠舟字韵","author":"顾清","text":"越相鸱夷老一舟，南征新息困壶头。\n人间岐路古今在，江上烟波日夜浮。\n诗卷钓竿新谷水，石渠金马旧瀛洲。\n寺廊斜日青衿散，犹想儿童挟策游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54293,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"再叠","author":"顾清","text":"莲叶空闻太乙舟，五湖今在鹤泾头。\n行牵藻荇随桡去，卧看云山隔树浮。\n返照入帘经别浦，微风引缆又前洲。\n江乡不辨东山具，到处从人说淡游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54294,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"至夕观书有感用甲申纪梦韵","author":"顾清","text":"诗人空复恼青蝇，黑白人间本自明。\n试论当年齐景富，何如千古伯夷名。\n悠悠总到閒边熄，赫赫常于静里萌。\n斜月西楼见梅影，一枝清傍绮窗横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54295,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"南村约庵相携为北野先生八十寿自今岁一行之赋此为例十一月二十九日也","author":"顾清","text":"北野先生初八十，南山胜会恰三人。\n桑榆并照林间影，松柏争看雪后身。\n剩有风神飞藻翰，绝无尘土上冠巾。\n百龄前去知非远，岁一称觞亦未频。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54296,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"会许一庵葬","author":"顾清","text":"素车摇曳古城东，犹记题诗寿一翁。\n往事只今成晓梦，后生何地挹淳风。\n遗言了了人能诵，馀业萧萧道未穷。\n一片洞泾原上石，有谁提笔赞林宗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54297,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"立春日招味苓尝酒","author":"顾清","text":"东窗小鸟聒清晨，坐拥青绫忆古人。\n心醉六经千古事，眼看七十四回春。\n芒鞋不踏纷华地，藤杖能扶健在身。\n梅萼茶花待公久，一杯来试雪香新。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54298,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"丁亥元日拜阙罢与客言有感客去烛至叠前蝇字韵","author":"顾清","text":"误笔休看画里蝇，残书且趁夜灯明。\n高才自古难为继，匹士寻常亦顾名。\n巨浸稽天来蚁穴，乔林翳日起勾萌。\n君王圣德今尧舜，曾见庚庚卜大横。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54299,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"三人醉后书","author":"顾清","text":"醉人那可问，往事不须详。\n咄咄忧为乐，纷纷静里忙。\n攫金宁顾市，挟策亦亡羊。\n一笑堪谁语，梅花在短墙。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54300,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观书有感 其一","author":"顾清","text":"兀兀灯前千古思，古人心在不同时。\n同时只好今人笑，暮夜怀金尚畏知。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54301,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观书有感 其二","author":"顾清","text":"春蚕默默五丝成，络纬中宵百变声。\n分席孔堂谁第一，两言博约尽平生。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54302,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观书有感 其三","author":"顾清","text":"既醉凫鹥写治安，邠风七月画艰难。\n施为次第分明在，只恐尘编倒背看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54303,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观书有感 其四","author":"顾清","text":"老质功多践履艰，下探渊海上高山。\n年来此事从人意，只在从容数语间。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54304,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"观书有感 其五","author":"顾清","text":"钱谷簿书归俗吏，天人性命合时贤。\n世间尚有宫商在，敢道期亡便绝弦。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54305,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"约庵先生寿七十五偕诸公携酒为庆诗以先之二月七日也","author":"顾清","text":"南村北野递赓酬，次第宾筵接太丘。\n乐国未输清颍曲，德星今在瑁湖头。\n墙桃暗结长春果，径竹新添记海筹。\n从此酒杯公莫算，东园几日又清秋。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54306,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东园忆味苓翁","author":"顾清","text":"梅花已作鱼鳞白，樱蕊初含豆蔻红。\n诗老闭门空觅句，槐阴几日又薰风。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54307,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"薛民望号九山持卷乞诗","author":"顾清","text":"西北三江带五湖，九山清胜结吾庐。\n风烟陆瑁家相近，水石王蒙画不如。\n长日林光围几席，有时空翠落衣裾。\n鹤书未论他年事，门外时来长者车。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54308,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"二月七日寿约庵先生有园桃暗结长春果之句后十九日先生得孙诗以贺之仍用前韵","author":"顾清","text":"先生七十五春秋，始抱兰枝第一筹。\n来晚恰符园果谶，名成须著锦标头。\n家书便合添千卷，身世真堪老一丘。\n却望寿筵无几日，酒杯重叠费公酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54309,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"辰孙将赴秋山甥馆其兄有诗依依不忍离别之意予谓孙之情殆有甚焉因书此慰之勤学以立身亲贤以自辅平日之耄言多矣体而行之将来之显扬秋山且望焉而何有于一时之离阔也孙其勉之","author":"顾清","text":"庭萱入望雁行分，风木仍牵梦里魂。\n欲尽此情难亦易，夜灯时省白头言。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54310,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"禽言 其一","author":"顾清","text":"窗鸡喔喔鸣未已，更着山禽唤人起。\n鸡鸣不醒唤不应，近来铜壶有六更。\n吁嗟乎尔禽空复情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54311,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"禽言 其二","author":"顾清","text":"有客苦无酒，提壶向邻沽。\n山禽当我前，笑我提壶卢。\n壶卢壶卢我自提，尔自不提，聒聒鸣何为。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54312,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"桥亭成有作呈南村约庵诸公","author":"顾清","text":"田野歌平政，舆梁揭胜亭。\n翚飞天不尽，鳌镇物常宁。\n吉梦先经始，丰年协地灵。\n白头何幸也，还此照清泠。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54313,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"题张秋山旧扇王孟仁画","author":"顾清","text":"王郎近代丹青手，写出秋山意外清。\n遗迹宛然人不见，临风无限古今情。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54314,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"东湖钱君缥藏其母林夫人绣桃竹双鸡遗命其子国用求题识观其运思精妙王渊边文进之写生也时风下移事多苟简有愧于斯人多矣赋绝句以归之","author":"顾清","text":"周汉遗文劫火深，晋唐缃素亦烟沉。\n青缣一尺丝千缕，留与闺门作佩箴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54315,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"亭桥次尤南渠韵","author":"顾清","text":"金沙新迹古亭桥，平界青冥压翠涛。\n龙见不从神物化，翚飞还比梦中高。\n凭阑及我閒无病，题柱看君老向豪。\n为谢筇枝莫相远，晚途衔策正须操。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54316,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"前题次周北野韵","author":"顾清","text":"城中每见说三亭，城外红阑此日凭。\n多事只从春梦起，好诗今作画图称。\n金沙玉涧交旋拥，布袜青鞋稳降升。\n百年如此良不恶，陇头休问鹤书徵。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54317,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"五月一日行东园","author":"顾清","text":"忧来不知端，抚心翻自疑。\n虽惭风云气，宁复儿女痴。\n园林既成趣，书卷亦堪依。\n如何廿年意，触眼还在兹。\n瘦马愁远道，羁禽怀故枝。\n往事已如此，后来安可期。\n焉得还吾故，高眠看云飞。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54318,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"兼善赴义塾南渠有诗予亦继作八月廿四日也","author":"顾清","text":"兰堂拙馆旧游歌，屈指年光六十过。\n师席再登传父子，书香一脉会松萝。\n青灯黄卷瞻依切，时雨春风感系多。\n他日分明眼前事，庭柯落叶水回波。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54319,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九月七日东园先生寿七十三诗以祝之","author":"顾清","text":"东园此日正清秋，前去重阳只两筹。\n酒盏不随元亮后，菊花先插紫微头。\n国恩宠报延三世，家学真传自九丘。\n杖履造朝今未论，百年诗会要公酬。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54320,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"九日诸公会石桥新楼望东园作","author":"顾清","text":"东园楼外复东楼，回首园亭满目秋。\n黄菊紫萸今日会，曲街委巷少年游。\n时移物运谁能挽，地夐天高直耐愁。\n看取五陵豪俊子，金丸终日话封侯。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54321,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"约庵促予西行且有早归之约诗以答之","author":"顾清","text":"风波踪迹病中身，归卧青山荷主恩。\n砻石方思豫丘首，赐环何意复衡门。\n西风建业追游地，斜日吴江别酒尊。\n愿托馀光照衰朽，杖藜还绕陆家村。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54322,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚坐东轩睹水木山亭知为夏忠靖公赐第感旧怀贤得绝句八首 其一","author":"顾清","text":"乾坤身世五湖萍，南北风尘两鬓星。\n独坐小轩成一笑，平生到处有山亭。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54323,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚坐东轩睹水木山亭知为夏忠靖公赐第感旧怀贤得绝句八首 其二","author":"顾清","text":"紫藤苍柏间三峰，曲槛回轩面面通。\n四十年来忘不得，连甍如雾此堂空。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54324,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚坐东轩睹水木山亭知为夏忠靖公赐第感旧怀贤得绝句八首 其三","author":"顾清","text":"重到长安迹屡移，南峰小院亦崔嵬。\n梨花槛格蒲萄架，勾引乡园入梦思。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54325,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚坐东轩睹水木山亭知为夏忠靖公赐第感旧怀贤得绝句八首 其四","author":"顾清","text":"绝壁连弯秀几重，清池倒浸玉芙蓉。\n别来往事那堪记，总付西轩一笑中。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54326,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚坐东轩睹水木山亭知为夏忠靖公赐第感旧怀贤得绝句八首 其五","author":"顾清","text":"小作山林窄作池，一亭飞起桂丛西。\n长沙旧迹文皇赐，千载都人路不迷。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54327,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚坐东轩睹水木山亭知为夏忠靖公赐第感旧怀贤得绝句八首 其六","author":"顾清","text":"东墙绿水带逶迤，北户连峰涌翠眉。\n正是皇州佳丽处，草堂容我坐吟诗。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54328,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚坐东轩睹水木山亭知为夏忠靖公赐第感旧怀贤得绝句八首 其七","author":"顾清","text":"长沙厚德魏安阳，禹绩东南泽更长。\n坐挹遗踪想明盛，又从东里到文襄。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54329,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"晚坐东轩睹水木山亭知为夏忠靖公赐第感旧怀贤得绝句八首 其八","author":"顾清","text":"水土平来泽国秋，陈红相望十三州。\n于今此意从谁语，惟有江淮日夜流。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54330,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"访客江上作","author":"顾清","text":"尚忆当年别，何言此地逢。\n乾坤真浩荡，阡陌任衡纵。\n妙舞须长袖，幽寻称短筇。\n龙江今夜月，知复为谁容。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54331,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"葛布舟中风雨","author":"何士冢","text":"世路多艰涉，孤帆黑夜开。\n蒙泷芒荻岸，漂泊水天涯。\n苦海从心渡，惊波拂面来。\n自怜形影吊，谁识济时才。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54332,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朱迁镇庙二首 其一","author":"曹嘉","text":"野庙瞻遗像，英威尚出群。\n戢场没沙水，尽壁起风云。\n铁马长驱志，金兵累胜勋。\n自遭谗谮死，罪复静胡氛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54333,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"朱迁镇庙二首 其二","author":"曹嘉","text":"虎战收功近，龙威召将还。\n中原无社稷，外寇有关山。\n野鸟啼残恨，苍松凛旧颜。\n平生吊忠义，独此泪痕斑。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54334,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"谪蜀过谒双忠之祠","author":"曹嘉","text":"直谏匡前代，孤忠激后臣。\n光犹争日月，色岂变松筠。\n吊古千行泪，投荒万里身。\n回思犯颜日，斧钺在枫宸。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54335,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次答李梦阳送甥嘉之茂州次玉溪侍御韵三首 其一","author":"曹嘉","text":"两度徽官谪，孤身绝塞行。\n汉廷收堕泪，蜀道轸离情。\n玉垒蚕丛国，龙标剑阁城。\n乾坤形胜地，何处挂冠缨。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54336,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次答李梦阳送甥嘉之茂州次玉溪侍御韵三首 其二","author":"曹嘉","text":"我有龙渊物，谁云鸟道难。\n桥横江不阔，岭度雪空盘。\n感慨悲前事，威棱想旧官。\n投荒吾不恨，指佞万人看。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54337,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次答李梦阳送甥嘉之茂州次玉溪侍御韵三首 其三","author":"曹嘉","text":"障海功难就，排山力渐消。\n花心伤绣斧，鸟步习绳桥。\n郡国西羌尽，星辰北极遥。\n赐环竟何日，含泪望中朝。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54338,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"王豸使至","author":"曹嘉","text":"雨后青骢马，风前绿绮琴。\n槛纷兰菊色，林响鹿麋音。\n野鸟随人性，秋虫助客吟。\n烦襟应尽解，接屣坐松阴。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54339,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"王豸使既返东月皎升乃与李曹二子径觞吹台之巅口占柬黄子同赋","author":"曹嘉","text":"皎皎秋圆月，亭亭夜迥台。\n光随车马上，步接斗牛回。\n赋雪邹枚迹，临风李杜杯。\n犹怜朱绂客，不共坐莓苔。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54340,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"赠陈生嘉言","author":"曹嘉","text":"独坐玄洲钓，深栖仲蔚蓬。\n人呼白衣相，家有玉环童。\n泽近蛟常雨，林空鸟易风。\n蒹葭霜露里，谁采最高丛。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54341,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"中秋亭会","author":"曹嘉","text":"新亭面皎月，高宴列中秋。\n地敞蟾疑动，窗空雾自流。\n杯倾承露掌，榻下摘星楼。\n宾客梁园胜，今宵尽醉游。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54342,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"次李梦阳戊子元夕示甥嘉韵","author":"曹嘉","text":"灯光皎河汉，寒夜倍生春。\n况是繁华国，能堪吏隐人。\n千家馀凤管，九陌竞香尘。\n独和閒居咏，憎看月胜银。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54343,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻郑生死丰沛舟中二首 其一","author":"曹嘉","text":"太初仙逝早，少谷暝游深。\n讵谓方山客，同随秋草阴。\n野云飘素幔，寒日下空林。\n重念群芳歇，临风涕满襟。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54344,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"闻郑生死丰沛舟中二首 其二","author":"曹嘉","text":"已返河梁棹，难招楚泽魂。\n何人收旅衬，有客酹清樽。\n浦月沉帆影，山花没屐痕。\n梁园旧游地，风色自黄昏。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54345,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"陶君誇其分司桃花独树予往观之次其韵","author":"曹嘉","text":"独树红桃太放花，主人折赠众宾誇。\n当筵雨□□犹湿，倚槛风枯午更斜。\n剩有琴书分秀色，岂容蜂蝶乱芳华。\n英朋海内如君少，拟报琼瑶醉紫霞。","collection":"明","notice":"含缺文或待核对标记，按原文保留。","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54346,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"秋日东庄宴集","author":"曹嘉","text":"菊酿新开承露盘，浚郊出赏尽银鞍。\n风林一叶地逾静，塞雁双飞天自宽。\n亭榭傍云秋动色，旌旗夹水昼生寒。\n南州榻宴名今古，未信风流胜此欢。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54347,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"寺前秋泛限韵","author":"曹嘉","text":"湖上晴游即镜中，轻烟淡霭静浮空。\n岸回舟自蒹葭入，塔迥云从殿阁通。\n惊吹鱼龙时出没，傍筵鸥鹭晚西东。\n回桡更泛桃花水，不辨秋林返照红。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54348,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"双溪方伯夏初见过就饮石几留诗次韵","author":"曹嘉","text":"舅家石几何玲珑，瑶色金姿花树丛。\n拂玩自成今日会，扣歌真见古人风。\n苍烟野径双樽里，碧簟凉云小阁东。\n独喜馆甥重有处，百年吟卧此心同。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54349,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"禋社六章章八句","author":"李梦阳","text":"元年仲春，吉日维戊。\n天子肇修，于社式对。\n二后协于百辟，既袛既戒。\n其日丁已，三星彗彗。\n百辟至止，萃于皋门。\n三星在隅，乃辟乃阍。\n有渰其云，有零其雨。\n赤舄跄跄，于坛之所。\n八佾剡剡，百燎盈庭。\n左金右石，镛鼓孔行。\n帝命元臣，曰戎朕代。\n式虔式穆，厥维朕载。\n元臣受命，爰肃其躬。\n月出则光，三星在中。\n磬管喤喤，有万斯舞。\n爰配二辟，牺尊维俎。\n于神来格，殷殷番番。\n龙旂载杨，雷霆啍啍。\n明明对越，肃肃奔走。\n神既醉饱，锡辟之祐。\n遹皇缵业，配天于京。\n三辰允祯，曰雨曰旸。\n皇降嘉实，来牟黍杜。\n敷文戢戈，克绍冢上。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54350,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"辟雍六章章八句","author":"李梦阳","text":"天子至止，于彼群雍。\n和鸾央央，其来雍雍。\n象辂金衡，有苍其龙。\n光于庙宫，是依是崇。\n吉日维申，修我元祀。\n皇祀设乐，镛鼓万舞。\n有筐有篚，以享以祀。\n群执肃肃，秉德弗渝。\n维其观者，三氏孙子。\n其冠峨峨，来忻来止。\n翩役凤鸟，集于东林。\n绎其观者，其烂如云。\n自门徂基，辟俨若思。\n青衿济济，以辟以师。\n爰命祭酒，司业拜手。\n吁哉嘉谋，作民元后。\n帝若曰都，戎言式弘。\n匪道何程，匪猷曷承。\n载弼元理，维协乃有。\n众拜稽首，天子万寿。\n旟旐旆旆，渊渊代鼓。\n皇发辟雍，用惠下土。\n自天降休，丰年穰穰。\n蔼蔼王多吉人，四国用康。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54351,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}},{"title":"甘露八章章四句","author":"李梦阳","text":"于辟是兴，皇用锡祉。\n苞有八业，侯茂侯采。\n填填墉壑，有严庙宫。\n湛彼露斯，既沾既降。\n湛彼露斯，于松于柏。\n是塈是掇，罔匪泽泽。\n菀彼陵树，有烂其华。\n盈盈蓁蓁，光于邦家。\n荡荡上帝，降监在兹。\n维辟时格，岂曰匪时。\n其时伊何，厥阳载升。\n爰液乃濡，惠我孔明。\n其昭伊何，曰帝攸绩。\n靡滥靡僣，甘澍斯穫。\n明明昊天，是歆是臧。\n臣作诵言，告于万方。","collection":"明","notice":"","provenance":{"repo":"Werneror/Poetry","commit":"4cfe49c06858e00d15f84d192fe5294295f79689","path":"明_1.csv","pointer":54352,"sha256":"0e5ded52c96c8e34ab2eff2ca89a15a7de75b039194ad001baa98286d2e2e10d","dynasty":"明"}}]